&НаСервере
&Перед("ПриСозданииНаСервере")
Процедура БитДРЦП_ПриСозданииНаСервереПеред(Отказ, СтандартнаяОбработка)

	БитДРЦП_ДобавитьРеквизитыФормы();
	БитДРЦП_СоздатьЭлементыФормы();

КонецПроцедуры   

&НаСервере
Процедура БитДРЦП_ДобавитьРеквизитыФормы()

	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"Менеджер",
		Новый ОписаниеТипов("СправочникСсылка.Пользователи"),
		"РаспоряженияНаПоступление"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"Комментарий",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)),
		"РаспоряженияНаПоступление"));  
		
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

КонецПроцедуры

&НаСервере
Процедура БитДРЦП_СоздатьЭлементыФормы()

	Если Элементы.Найти("БитДРЦП_ОтборМенеджер") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ГруппаШапка = Элементы.ГруппаШапкаПоступления;

	ПолеОтборМенеджер = Элементы.Добавить("БитДРЦП_ОтборМенеджер", Тип("ПолеФормы"), ГруппаШапка);
	ПолеОтборМенеджер.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОтборМенеджер.ПутьКДанным = "БитДРЦП_ОтборМенеджер";
	ПолеОтборМенеджер.Заголовок = НСтр("ru = 'Менеджер'");
	ПолеОтборМенеджер.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеОтборМенеджер.Подсказка = НСтр("ru = 'Менеджер'");
	ПолеОтборМенеджер.ПодсказкаВвода = НСтр("ru = 'Выберите менеджера'");
	ПолеОтборМенеджер.АвтоМаксимальнаяШирина = Ложь;
	ПолеОтборМенеджер.МаксимальнаяШирина = 22;
	ПолеОтборМенеджер.КнопкаВыбора = Истина;
	ПолеОтборМенеджер.КнопкаОчистки = Истина;
	ПолеОтборМенеджер.УстановитьДействие("ПриИзменении", "БитДРЦП_ОтборМенеджерПриИзменении");
	Элементы.Переместить(ПолеОтборМенеджер, ГруппаШапка, Элементы.КоманднаяПанельПоступления);

	ТаблицаРаспоряжений = Элементы.РаспоряженияНаПоступление;

	ПолеМенеджер = Элементы.Добавить("БитДРЦП_РаспоряженияНаПоступлениеМенеджер", Тип("ПолеФормы"), ТаблицаРаспоряжений);
	ПолеМенеджер.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеМенеджер.ПутьКДанным = "РаспоряженияНаПоступление.Менеджер";
	ПолеМенеджер.Заголовок = НСтр("ru = 'Менеджер'");
	Элементы.Переместить(ПолеМенеджер, ТаблицаРаспоряжений, Элементы.РаспоряженияНаПоступлениеСостояниеПоступления);

	ПолеКомментарий = Элементы.Добавить("БитДРЦП_РаспоряженияНаПоступлениеКомментарий", Тип("ПолеФормы"), ТаблицаРаспоряжений);
	ПолеКомментарий.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеКомментарий.ПутьКДанным = "РаспоряженияНаПоступление.Комментарий";
	ПолеКомментарий.Заголовок = НСтр("ru = 'Комментарий'");
	Элементы.Переместить(ПолеКомментарий, ТаблицаРаспоряжений, Элементы.РаспоряженияНаПоступлениеСостояниеПоступления);

КонецПроцедуры

&НаКлиенте
Процедура БитДРЦП_ОтборМенеджерПриИзменении(Элемент)

	ЗаполнитьРаспоряженияНаПоступление();

КонецПроцедуры

&НаСервере
&После("ЗаполнитьРаспоряженияНаПоступление")
Процедура БитДРЦП_ЗаполнитьРаспоряженияНаПоступлениеПосле()

	БитДРЦП_ДополнитьРеквизитыРаспоряженийНаПоступление();
	БитДРЦП_ПрименитьОтборПоМенеджеру();

КонецПроцедуры

&НаСервере
Процедура БитДРЦП_ДополнитьРеквизитыРаспоряженийНаПоступление()

	Если РаспоряженияНаПоступление.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТаблицаРаспоряжений = РаспоряженияНаПоступление.Выгрузить(, "Распоряжение");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Распоряжения", ТаблицаРаспоряжений);
	Запрос.Текст =
	"ВЫБРАТЬ  
	|	Распоряжения.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ ВТРаспоряжения
	|ИЗ
	|	&Распоряжения КАК Распоряжения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Распоряжения.Распоряжение КАК Распоряжение,
	|	ВЫБОР
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ЗаказПоставщику
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ЗаказПоставщику).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ПриобретениеТоваровУслуг).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ПриемкаТоваровНаХранение
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ПриемкаТоваровНаХранение).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ЗаказПереработчику
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ЗаказПереработчику).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ЗаказПереработчику2_5
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ЗаказПереработчику2_5).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ПоступлениеТоваровОтХранителя
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ПоступлениеТоваровОтХранителя).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ПоступлениеОтПереработчика
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ПоступлениеОтПереработчика).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ВозвратСырьяОтПереработчика
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ВозвратСырьяОтПереработчика).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ЗаявкаНаВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ЗаявкаНаВозвратТоваровОтКлиента).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Документ.ВозвратТоваровОтКлиента).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Справочник.ДоговорыКонтрагентов
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Справочник.ДоговорыКонтрагентов).Менеджер
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Справочник.СоглашенияСПоставщиками
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Справочник.СоглашенияСПоставщиками).Менеджер
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	КОНЕЦ КАК Менеджер,
	|	ВЫБОР
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Справочник.СоглашенияСПоставщиками
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Справочник.СоглашенияСПоставщиками).Комментарий
	|		КОГДА Распоряжения.Распоряжение ССЫЛКА Справочник.ДоговорыКонтрагентов
	|			ТОГДА ВЫРАЗИТЬ(Распоряжения.Распоряжение КАК Справочник.ДоговорыКонтрагентов).Комментарий
	|		ИНАЧЕ ЕСТЬNULL(РеестрДокументов.Комментарий, """")
	|	КОНЕЦ КАК Комментарий
	|ИЗ
	|	ВТРаспоряжения КАК Распоряжения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|		ПО Распоряжения.Распоряжение = РеестрДокументов.Ссылка
	|			И (НЕ РеестрДокументов.ДополнительнаяЗапись)";

	Выборка = Запрос.Выполнить().Выбрать();	
	ДанныеРаспоряжений = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		ДанныеРаспоряжений.Вставить(
			Выборка.Распоряжение,
			Новый Структура("Менеджер, Комментарий", Выборка.Менеджер, Выборка.Комментарий));
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из РаспоряженияНаПоступление Цикл
		ДанныеСтроки = ДанныеРаспоряжений.Получить(СтрокаТаблицы.Распоряжение);
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСтроки);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура БитДРЦП_ПрименитьОтборПоМенеджеру()

	Если Не ЗначениеЗаполнено(БитДРЦП_ОтборМенеджер) Тогда
		Возврат;
	КонецЕсли;

	СтруктураОтбора = Новый Структура("Менеджер", БитДРЦП_ОтборМенеджер);
	СтрокиПоМенеджеру = РаспоряженияНаПоступление.НайтиСтроки(СтруктураОтбора);  
	ТаблицаОтбор = РаспоряженияНаПоступление.Выгрузить(СтрокиПоМенеджеру);
	РаспоряженияНаПоступление.Загрузить(ТаблицаОтбор);
	
КонецПроцедуры   

&НаСервере
&После("ПередЗагрузкойДанныхИзНастроекНаСервере")
Процедура БитДРЦП_ПередЗагрузкойДанныхИзНастроекНаСервереПосле(Настройки)

	БитДРЦП_ОтборМенеджер = Настройки.Получить("БитДРЦП_ОтборМенеджер");
	Настройки.Удалить("БитДРЦП_ОтборМенеджер");

	БитДРЦП_ПрименитьОтборПоМенеджеру();

КонецПроцедуры



