
&После("ЗаполнитьПараметрыКомпоновки")
Процедура битПлатежКалендарь_ЗаполнитьПараметрыКомпоновки(ПараметрыДанных)
	
	СписокКонтрагентов = ПодборКонтрагентовПоПризнаку();
	
	ФинансоваяОтчетностьСервер.УстановитьПараметр(ПараметрыДанных, "СписокКонтрагентов", СписокКонтрагентов, Истина);		
	
КонецПроцедуры


&После("ЗаполнитьПараметрыМакета")
Процедура битПлатежКалендарь_ЗаполнитьПараметрыМакета(ПараметрыДанных)
	                           	
	
	СписокКонтрагентов = ПодборКонтрагентовПоПризнаку();
	
	ПараметрыДанных.СписокКонтрагентов.Значение = СписокКонтрагентов;
	
	
КонецПроцедуры     




	Функция ПодборКонтрагентовПоПризнаку() Экспорт
		
		
	//ВЫБРАТЬ
	//	|	Партнеры.Ссылка КАК Ссылка
	//	|ИЗ
	//	|	Справочник.Партнеры КАК Партнеры
	//	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	//	|		ПО Партнеры.Ссылка = ПартнерыДополнительныеРеквизиты.Ссылка
	//	|			И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""СкрыватьИзПлатежногоКалендаря"")
	//	|ГДЕ
	//	|	ЕСТЬNULL(ПартнерыДополнительныеРеквизиты.Значение, ЛОЖЬ) = &Значение	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|			ПО (Партнеры.Ссылка = ПартнерыДополнительныеРеквизиты.Ссылка)
	|				И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""СкрыватьИзПлатежногоКалендаря"")
	|		ПО (Контрагенты.Партнер = Партнеры.Ссылка)
	|ГДЕ
	|	ЕСТЬNULL(ПартнерыДополнительныеРеквизиты.Значение, ЛОЖЬ) = &Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.ДополнительныеРеквизиты КАК ОрганизацииДополнительныеРеквизиты
	|		ПО (Организации.ГоловнаяОрганизация = ОрганизацииДополнительныеРеквизиты.Ссылка)
	|			И (ОрганизацииДополнительныеРеквизиты.Свойство.Имя = ""СкрыватьИзПлатежногоКалендаря"")
	|ГДЕ
	|	ЕСТЬNULL(ОрганизацииДополнительныеРеквизиты.Значение, ЛОЖЬ) = &Значение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.ДополнительныеРеквизиты КАК ФизическиеЛицаДополнительныеРеквизиты
	|		ПО ФизическиеЛица.Ссылка = ФизическиеЛицаДополнительныеРеквизиты.Ссылка
	|			И (ФизическиеЛицаДополнительныеРеквизиты.Свойство.Имя = ""СкрыватьИзПлатежногоКалендаря"")
	|ГДЕ
	|	ЕСТЬNULL(ФизическиеЛицаДополнительныеРеквизиты.Значение, ЛОЖЬ) = &Значение";
	
	
	
	РежимВыводаКонтрагентов = ЭтотОбъект.битПлатежКалендарь_РежимВыводаКонтрагентов;
	
	Если РежимВыводаКонтрагентов = "Вывод с признаком" Тогда
		
		ПараметрЗначения = Истина;
		Запрос.УстановитьПараметр("Значение", ПараметрЗначения);
		
	ИначеЕсли РежимВыводаКонтрагентов = "Вывод без признака" Тогда
		
		ПараметрЗначения = Ложь;	
		Запрос.УстановитьПараметр("Значение", ПараметрЗначения);
		
	ИначеЕсли РежимВыводаКонтрагентов = "" ИЛИ РежимВыводаКонтрагентов = "Выводить всех" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
		|			ПО (Партнеры.Ссылка = ПартнерыДополнительныеРеквизиты.Ссылка)
		|				И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""СкрыватьИзПлатежногоКалендаря"")
		|		ПО (Контрагенты.Партнер = Партнеры.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.ДополнительныеРеквизиты КАК ОрганизацииДополнительныеРеквизиты
		|		ПО (Организации.ГоловнаяОрганизация = ОрганизацииДополнительныеРеквизиты.Ссылка)
		|			И (ОрганизацииДополнительныеРеквизиты.Свойство.Имя = ""СкрыватьИзПлатежногоКалендаря"")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.ДополнительныеРеквизиты КАК ФизическиеЛицаДополнительныеРеквизиты
		|		ПО ФизическиеЛица.Ссылка = ФизическиеЛицаДополнительныеРеквизиты.Ссылка
		|			И (ФизическиеЛицаДополнительныеРеквизиты.Свойство.Имя = ""СкрыватьИзПлатежногоКалендаря"")";
		
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаКонтрагенты = РезультатЗапроса[0].Выбрать();
	ВыборкаОрганизации = РезультатЗапроса[1].Выбрать();
	ВыборкаФизЛица = РезультатЗапроса[2].Выбрать();	
	МассивПлательщиков = Новый Массив;
	
	Пока ВыборкаКонтрагенты.Следующий() Цикл
		МассивПлательщиков.Добавить(ВыборкаКонтрагенты.Ссылка);
	КонецЦикла; 
	
	Пока ВыборкаОрганизации.Следующий() Цикл
		МассивПлательщиков.Добавить(ВыборкаОрганизации.Ссылка);
	КонецЦикла;
	
	Пока ВыборкаФизЛица.Следующий() Цикл
		МассивПлательщиков.Добавить(ВыборкаФизЛица.Ссылка);
	КонецЦикла;
	
	
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	Возврат МассивПлательщиков;
	
	
	
КонецФункции // ()




