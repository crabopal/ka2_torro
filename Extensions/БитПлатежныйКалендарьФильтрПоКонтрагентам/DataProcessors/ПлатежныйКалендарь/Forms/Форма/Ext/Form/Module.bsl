
&НаСервере
&ИзменениеИКонтроль("УстановитьОтборыДинамическихСписков")
Процедура битПлатежКалендарь_УстановитьОтборыДинамическихСписков()

	ДинамическийСписок = ЭтаФорма[ИмяТекущегоСписка];

	Организации = Новый Массив;
	Для каждого ЭлементОтбора Из Объект.ОтборОрганизации Цикл
		Если ЭлементОтбора.Пометка Тогда
			Организации.Добавить(ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
	ДинамическийСписок,
	"Организация",
	Организации,
	ВидСравненияКомпоновкиДанных.ВСписке,,
	Организации.Количество());

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
	ДинамическийСписок,
	"Валюта",
	Объект.ОтборВалюта,
	ВидСравненияКомпоновкиДанных.Равно,,
	ЗначениеЗаполнено(Объект.ОтборВалюта));

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
	ДинамическийСписок,
	"ДатаПлатежа",
	ДенежныеСредстваКлиентСервер.ДатаПлатежа(Объект.ПланироватьСДаты, ДнейПланирования),
	ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
	ДинамическийСписок,
	"ОбластьПланирования",
	ОтборОбластиПланирования,
	ВидСравненияКомпоновкиДанных.ВСписке,,
	ОтборОбластиПланирования.Количество());
	#Вставка
	Обработка = РеквизитФормыВЗначение("Объект");
	СписокКонтрагентов = Обработка.ПодборКонтрагентовПоПризнаку();
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
	ДинамическийСписок,
	"ПлательщикПолучатель",
	СписокКонтрагентов,
	ВидСравненияКомпоновкиДанных.ВСписке,,
	Истина);
	
	#КонецВставки

КонецПроцедуры   



&НаСервере
&После("ПриСозданииНаСервере")
Процедура битПлатежКалендарь_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("РежимВыводаКонтрагентов", Тип("ПолеФормы"), Элементы.ГруппаОтборы);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.битПлатежКалендарь_РежимВыводаКонтрагентов";
	НовыйЭлемент.Заголовок = "Отбор контрагентов по признаку";
	НовыйЭлемент.РежимВыбораИзСписка = Истина;
	НовыйЭлемент.СписокВыбора.Добавить("Вывод с признаком");
	НовыйЭлемент.СписокВыбора.Добавить("Вывод без признака");
	НовыйЭлемент.СписокВыбора.Добавить("Выводить всех");
	
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "РежимВыводаКонтрагентовПриИзменении"); 
	Объект.битПлатежКалендарь_РежимВыводаКонтрагентов = "Вывод без признака";
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВыводаКонтрагентовПриИзменении(Элемент)

	ОбновитьСписки();	

КонецПроцедуры



