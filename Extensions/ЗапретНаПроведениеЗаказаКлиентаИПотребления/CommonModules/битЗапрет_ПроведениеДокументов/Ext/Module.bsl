
Функция ЕстьПравоЗаписиИПроведенияВнеОграничений() Экспорт
	
	ИмяРоли = "битЗапрет_ЗаписьИПроведениеВнеОграничений";
	
	Если РольНазначенаЧерезПрофильГруппыДоступа(ИмяРоли) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Для ролей, назначенных напрямую пользователю ИБ.
	//@skip-check using-isinrole
	Возврат РольДоступна(ИмяРоли);
	
КонецФункции

Функция РольНазначенаЧерезПрофильГруппыДоступа(ИмяРоли)
	
	Роль = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Роль." + ИмяРоли);
	Если Роль = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("АвторизованныйПользователь", Пользователи.АвторизованныйПользователь());
	Запрос.УстановитьПараметр("Роль", Роль);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЗначениеИстина
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
		|		ПО СоставыГруппПользователей.Пользователь = &АвторизованныйПользователь
		|			И СоставыГруппПользователей.ГруппаПользователей = ГруппыДоступаПользователи.Пользователь
		|			И СоставыГруппПользователей.Используется
		|			И НЕ ГруппыДоступаПользователи.Ссылка.ПометкаУдаления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|		ПО ГруппыДоступаПользователи.Ссылка.Профиль = ПрофилиГруппДоступаРоли.Ссылка
		|			И ПрофилиГруппДоступаРоли.Роль = &Роль
		|			И НЕ ПрофилиГруппДоступаРоли.Ссылка.ПометкаУдаления";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ТекстОшибкиОграниченияДаты(ДокументОбъект) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЕстьПравоЗаписиИПроведенияВнеОграничений() Тогда
		Возврат "";
	КонецЕсли;
	
	ТекущаяДата = ТекущаяДатаСеанса();
	НачалоСегодня = НачалоДня(ТекущаяДата);
	ДевятьУтраСегодня = НачалоСегодня + 9 * 3600;
	НачалоЗавтра = НачалоДня(ТекущаяДата + 86400);
	ДевятьУтраЗавтра = НачалоЗавтра + 9 * 3600;
	
	ДатаДокумента = ДокументОбъект.Дата;
	НачалоДняДокумента = НачалоДня(ДатаДокумента);
	НазваниеДокумента = ДокументОбъект.Метаданные().Синоним;
	
	Если ТекущаяДата < ДевятьУтраСегодня Тогда
		
		Если НачалоДняДокумента <> НачалоСегодня Тогда
			Возврат СтрШаблон(
				НСтр("ru = 'До 9:00 документ ""%1"" можно записать или провести только сегодняшним днем.'"),
				НазваниеДокумента);
		КонецЕсли;
		
	Иначе
		
		Если ДатаДокумента < ДевятьУтраЗавтра Тогда
			Возврат СтрШаблон(
				НСтр("ru = 'После 9:00 документ ""%1"" можно записать или провести только датой не ранее завтрашнего дня 9:00.'"),
				НазваниеДокумента);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ПроверитьОграничениеДатыЗаписиИПроведения(ДокументОбъект) Экспорт
	
	ТекстОшибки = ТекстОшибкиОграниченияДаты(ДокументОбъект);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры
