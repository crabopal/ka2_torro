
Функция ПоказатьОшибкуОграниченияДаты(ПараметрыЗаписи, ТекстОшибки) Экспорт
	
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Заголовок = НСтр("ru = 'Документ нельзя провести'");
	Иначе
		Заголовок = НСтр("ru = 'Документ нельзя записать'");
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстОшибки, , Заголовок);
	
	Возврат Истина;
	
КонецФункции
