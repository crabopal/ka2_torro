
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
		УстановитьУсловноеОформление();
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	СписокДокументовАналитики = ПолучитьСписокДокументовАналитики(); 
	
	УсловноеОформление.Элементы.Очистить(); 

	
	ЭлементУО 						= УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось);
	ЭлементУсловия 					= ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("СписокДокументов.АналитикаРасходов"); 
	ЭлементУсловия.ВидСравнения 	= ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементУсловия.ПравоеЗначение 	= СписокДокументовАналитики;
	ЭлементУсловия.Использование 	= Истина; 	
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокДокументовДокумент");
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокДокументовПартнер");
    ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокДокументовРаспределено");
    ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокДокументовСумма");
    ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокДокументовКоличество");

	
	
	
КонецПроцедуры


&НаСервере
Функция ПолучитьСписокДокументовАналитики()
	
	СписокПриобретенияСРаспределеннымиРасходами = Новый СписокЗначений;
	Для каждого ДокументАналитики Из СписокДокументов Цикл
		МассивДокументов = КритерииОтбора.СвязанныеДокументы.Найти(ДокументАналитики.АналитикаРасходов);
		Для каждого  СсылкаНаДокумент Из МассивДокументов Цикл
			ПроверкаДокумента = Найти(Строка(СсылкаНаДокумент), "Приобретение услуг");		
			Если  ПроверкаДокумента > 0 И СсылкаНаДокумент.Проведен = Истина И СсылкаНаДокумент.ПометкаУдаления = Ложь Тогда
				СписокПриобретенияСРаспределеннымиРасходами.Добавить(ДокументАналитики.АналитикаРасходов);
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;  
	
	Возврат СписокПриобретенияСРаспределеннымиРасходами;
	
КонецФункции


&НаКлиенте
Процедура бит_СписокДокументовПриИзмененииПосле(Элемент)
	УстановитьУсловноеОформление();
КонецПроцедуры


&НаКлиенте
&ИзменениеИКонтроль("ПеренестиВДокумент")
Процедура бит_ПеренестиВДокумент(Команда)
	Если ОсталосьРаспределить <> 0 Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Необходимо дораспределить на документы поступления'") + " " + ОсталосьРаспределить + " " + Валюта;
		Сообщение.Сообщить();
		#Вставка	
	ИначеЕсли ПолучитьСписокДокументовАналитики().Количество() > 0 Тогда 
		ДополнительныеПараметры = Ложь;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, "В списке есть документы, на которые уже распределили расход, Вы уверены, что хотите рапределить на них расходы?",
		РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Есть распределенный расход"); 
		#КонецВставки
	Иначе
		Закрыть(ПоместитьРезультатВоВременноеХранилище());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Закрыть(ПоместитьРезультатВоВременноеХранилище());
	КонецЕсли;		
	
КонецПроцедуры
