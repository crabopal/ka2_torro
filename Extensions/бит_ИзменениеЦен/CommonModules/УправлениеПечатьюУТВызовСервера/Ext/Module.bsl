&ИзменениеИКонтроль("ДанныеДляПечатиЦенниковИЭтикеток")
Функция бит_ДанныеДляПечатиЦенниковИЭтикеток(Идентификатор, ОбъектыПечати, ДополнительныеПараметры)
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОбъектыПечати[0]);
	
	СоответствиеОбъектов = ОбщегоНазначенияУТ.РазложитьМассивСсылокПоТипам(ОбъектыПечати);
	Если СоответствиеОбъектов.Количество() > 1 Тогда
		ТекстСообщения = НСтр("ru = 'Печать этикеток и ценников для нескольких видов документов не поддерживается'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	#Удаление
	Если Идентификатор = "Ценники" Тогда
		Возврат МенеджерОбъекта.ДанныеДляПечатиЦенников(ОбъектыПечати);	
	#КонецУдаления
	#Вставка
	Если Идентификатор = "Ценники" Тогда
		
		Если ДополнительныеПараметры <> Неопределено
			И ДополнительныеПараметры.Свойство("бит_ПечататьНеизмененныеЦенники")
			И ТипЗнч(ОбъектыПечати[0]) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры") Тогда
			
			Возврат Документы.УстановкаЦенНоменклатуры.бит_ДанныеДляПечатиЦенниковПоПараметрам(ОбъектыПечати, ДополнительныеПараметры);
			
		КонецЕсли;
		
		Возврат МенеджерОбъекта.ДанныеДляПечатиЦенников(ОбъектыПечати);
	#КонецВставки
	ИначеЕсли Идентификатор = "Этикетки" Тогда
		Возврат МенеджерОбъекта.ДанныеДляПечатиЭтикеток(ОбъектыПечати);
	КонецЕсли;
	
КонецФункции
// Бит Туртыгин <<<
