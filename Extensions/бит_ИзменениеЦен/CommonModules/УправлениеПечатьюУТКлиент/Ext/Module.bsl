&ИзменениеИКонтроль("ПечатьЭтикетокИЦенников")
Функция бит_ПечатьЭтикетокИЦенников(ОписаниеКоманды)

	ДополнительныеПараметры = Новый Структура("МенеджерПечати", ОписаниеКоманды.МенеджерПечати);
#Вставка
	бит_ДобавитьПараметрыПечатиЦенников(ОписаниеКоманды, ДополнительныеПараметры);
#КонецВставки
	
	АдресВХранилище =
		УправлениеПечатьюУТВызовСервера.ДанныеДляПечатиЦенниковИЭтикеток(
			ОписаниеКоманды.Идентификатор,
			ОписаниеКоманды.ОбъектыПечати,
			ДополнительныеПараметры);
	
	ОткрытьФорму(
		"Обработка.ПечатьЭтикетокИЦенников.Форма.ФормаТовары",
		Новый Структура("АдресВХранилище, НазначениеШаблона", АдресВХранилище, Неопределено),
		ОписаниеКоманды.Форма,
		Новый УникальныйИдентификатор);
	
КонецФункции

Процедура бит_ДобавитьПараметрыПечатиЦенников(ОписаниеКоманды, ДополнительныеПараметры)
	
	Если ОписаниеКоманды.Идентификатор <> "Ценники" Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОписаниеКоманды, "Форма") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОписаниеКоманды.Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ОписаниеКоманды.Форма;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "бит_ПечататьНеизмененныеЦенники") Тогда
		ДополнительныеПараметры.Вставить("бит_ПечататьНеизмененныеЦенники", Форма.бит_ПечататьНеизмененныеЦенники);
	КонецЕсли;
	
КонецПроцедуры
