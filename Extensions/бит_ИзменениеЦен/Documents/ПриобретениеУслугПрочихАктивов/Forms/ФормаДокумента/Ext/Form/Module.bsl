
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
		ДобавляемыеРеквизиты  = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы("ПоставщикАналитики", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"), "Объект.Расходы");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ЭлементыФормы = ЭтаФорма.Элементы;
	
	КонтрагентАналитикиПолеФормы = Элементы.Добавить("ПоставщикАналитики", Тип("ПолеФормы"), Элементы.Расходы);
	КонтрагентАналитикиПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
	КонтрагентАналитикиПолеФормы.Заголовок = "Поставщик аналитики";
	КонтрагентАналитикиПолеФормы.ПутьКДанным = "Объект.Расходы.ПоставщикАналитики";
	КонтрагентАналитикиПолеФормы.Доступность = Ложь;
	КонтрагентАналитикиПолеФормы.Видимость = Истина;
	
	ЭлементыФормы.Переместить(КонтрагентАналитикиПолеФормы, Элементы.Расходы, Элементы.РасходыПредставлениеОтраженияВРеглУчете);
	
	ЗаполнитьДанныеОКонтрагентеАналитики();

КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ПеренестиРезультатВТабЧасть")
Процедура бит_ПеренестиРезультатВТабЧасть(РезультатЗакрытия)

	КУдалению = Новый Массив();
	РезультатРаспределения = ПолучитьИзВременногоХранилища(РезультатЗакрытия.АдресВоВременномХранилище);
	СтруктураПересчетаСуммы = ПоляПересчетаСуммыНДСВСтрокеТЧ(ЭтаФорма);

	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");

	ОбрабатываемыеСтроки = Новый Массив;

	Для Каждого СтрокаТаблицы Из РезультатРаспределения Цикл
		МассивСтрок = Объект.Расходы.НайтиСтроки(Новый Структура("НомерСтроки",СтрокаТаблицы.НомерСтрокиДокумента));
		Если МассивСтрок.Количество() <> 1 Тогда
			СтрокаКЗаполнению = Объект.Расходы.Добавить();
			ПриДобавленииСтрокиРасходов(ЭтотОбъект, СтрокаКЗаполнению);
		Иначе
			СтрокаКЗаполнению = МассивСтрок[0];
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаКЗаполнению, СтрокаТаблицы,,"Содержание");
		Если СокрЛП(СтрокаКЗаполнению.Содержание) = "" Тогда
			СтрокаКЗаполнению.Содержание = СтрокаТаблицы.Содержание;
		КонецЕсли;

		Если СтрокаКЗаполнению.Количество <> 0 Тогда
			СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВЗакупках", Новый Структура("ИмяКоличества", "Количество"));
		Иначе
			СтруктураДействий.Удалить("ПересчитатьЦенуСкидкуПоСуммеВЗакупках");
			СтрокаКЗаполнению.Цена = СтрокаКЗаполнению.Сумма;
		КонецЕсли;
		ОбрабатываемыеСтроки.Добавить(СтрокаКЗаполнению);
	КонецЦикла;

	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокиТЧ(
	ОбрабатываемыеСтроки,
	СтруктураДействий,
	Объект.Расходы);

	КУдалению = ПолучитьИзВременногоХранилища(РезультатЗакрытия.СтрокиКУдалению);
	Для Каждого СтрокаКУдалению Из КУдалению Цикл
		Объект.Расходы.Удалить(СтрокаКУдалению.НомерСтрокиДокумента - 1);
	КонецЦикла; 
	
	#Вставка
		ЗаполнитьДанныеОКонтрагентеАналитики();
	#КонецВставки


КонецПроцедуры

&НаСервере
Процедура бит_РасходыПриИзмененииПослеНаСервере()
	ЗаполнитьДанныеОКонтрагентеАналитики();
КонецПроцедуры

&НаКлиенте
Процедура бит_РасходыПриИзмененииПосле(Элемент)
	бит_РасходыПриИзмененииПослеНаСервере();
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьДанныеОКонтрагентеАналитики()
	
	Для каждого СтрокаРасходов Из Объект.Расходы Цикл
		Если ТипЗнч(СтрокаРасходов.АналитикаРасходов) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			СтрокаРасходов.ПоставщикАналитики = СтрокаРасходов.АналитикаРасходов.Контрагент;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

