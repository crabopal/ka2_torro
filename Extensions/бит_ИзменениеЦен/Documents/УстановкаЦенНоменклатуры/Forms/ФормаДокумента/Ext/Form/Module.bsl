
&НаСервере
&После("ПриСозданииНаСервере")
Процедура бит_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		// Бит Туртыгин >>>
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы("бит_ПечататьНеизмененныеЦенники", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	бит_ПечататьНеизмененныеЦенники = Ложь;
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Элементы, "бит_ПечататьНеизмененныеЦенники") Тогда
		
		ПолеПечататьНеизмененные = Элементы.Добавить("бит_ПечататьНеизмененныеЦенники", Тип("ПолеФормы"), Элементы.ГруппаШапкаПраво);
		ПолеПечататьНеизмененные.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеПечататьНеизмененные.Заголовок = "Печатать неизмененные ценники";
		ПолеПечататьНеизмененные.ПутьКДанным = "бит_ПечататьНеизмененныеЦенники";
		
	КонецЕсли;
	// Бит Туртыгин <<<
КонецПроцедуры

