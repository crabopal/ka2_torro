
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы("бит_ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Добавляем колонки в табличную часть
	ЭлементыФормы = ЭтаФорма.Элементы;
	ТоварыЭлемент = ЭлементыФормы.Товары;
	
	// Колонка Себестоимости
	СебестоимостьПолеФормы             = Элементы.Добавить("бит_Себестоимость",Тип("ПолеФормы"),Элементы.Товары);
	СебестоимостьПолеФормы.Вид         = ВидПоляФормы.ПолеВвода;   
	СебестоимостьПолеФормы.Заголовок   = "Себестоимость";
	СебестоимостьПолеФормы.ПутьКДанным = "Объект.Товары.бит_Себестоимость";
	СебестоимостьПолеФормы.Доступность = Ложь;                                             
	
	СебестоимостьПолеФормы.УстановитьДействие("ПриИзменении", "СебестоимостьПриИзменении");
	
	// Колонка Розничной цены
	РозничнаяЦенаПолеФормы  		   = Элементы.Добавить("бит_РозничнаяЦена",Тип("ПолеФормы"),Элементы.Товары);
	РозничнаяЦенаПолеФормы.Вид         = ВидПоляФормы.ПолеВвода;   
	РозничнаяЦенаПолеФормы.Заголовок   = "Розничная цена без НДС";
	РозничнаяЦенаПолеФормы.ПутьКДанным = "Объект.Товары.бит_РозничнаяЦена"; 
	
	РозничнаяЦенаПолеФормы.УстановитьДействие("ПриИзменении", "РозничнаяЦенаПриИзменении");
	
	// Колонка Процента наценки
	ПроцентНаценкиПолеФормы             = Элементы.Добавить("бит_ПроцентНаценки",Тип("ПолеФормы"),Элементы.Товары);
	ПроцентНаценкиПолеФормы.Вид         = ВидПоляФормы.ПолеВвода;   
	ПроцентНаценкиПолеФормы.Заголовок   = "% наценки";
	ПроцентНаценкиПолеФормы.ПутьКДанным = "Объект.Товары.бит_ПроцентНаценки";
	
	ПроцентНаценкиПолеФормы.УстановитьДействие("ПриИзменении", "ПроцентНаценкиПриИзменении"); 
	
	
	
	ЭлементыФормы.Переместить(СебестоимостьПолеФормы, Элементы.Товары, Элементы.ТоварыПроцентРучнойСкидки);
	ЭлементыФормы.Переместить(ПроцентНаценкиПолеФормы, Элементы.Товары, Элементы.ТоварыПроцентРучнойСкидки);
	ЭлементыФормы.Переместить(РозничнаяЦенаПолеФормы, Элементы.Товары, Элементы.ТоварыПроцентРучнойСкидки);
		
	//ТоварыЭлемент.УстановитьДействие("ПриАктивизацииСтроки", "бит_ПриАктивизацииСтроки");
	
	
	//Создаем Команду
	КомандаОбщаяНаценка = ЭтаФорма.Команды.Добавить("бит_КнопкаОбщаяНаценка");
	КомандаОбщаяНаценка.Действие = "бит_ОбщаяНаценкаНажатие";//Имя процедуры
	КомандаОбщаяНаценка.Заголовок = "Установить общую наценку";
	//Создаем Кнопку в конце Родителя (формы)
	КнопкаОбщаяНаценка = ЭтаФорма.Элементы.Вставить("КнопкаНаценка", Тип("КнопкаФормы"), ЭтаФорма, ЭтаФорма.ПодчиненныеЭлементы[0]);
	КнопкаОбщаяНаценка.ИмяКоманды = "бит_КнопкаОбщаяНаценка"; 
	
	//Создаем Команду
	КомандаЗаписатьЦены = ЭтаФорма.Команды.Добавить("бит_КнопкаЗаписатьЦены");
	КомандаЗаписатьЦены.Действие = "бит_ЗаписатьЦеныНажатие";//Имя процедуры
	КомандаЗаписатьЦены.Заголовок = "Записать цены";
	//Создаем Кнопку в конце Родителя (формы)
	КнопкаЗаписатьЦены = ЭтаФорма.Элементы.Вставить("КнопкаЗаписьЦен", Тип("КнопкаФормы"), ЭтаФорма, ЭтаФорма.ПодчиненныеЭлементы[0]);
	КнопкаЗаписатьЦены.ИмяКоманды = "бит_КнопкаЗаписатьЦены"; 
	
	КомандаРасчитатьСебестоимость = ЭтаФорма.Команды.Добавить("бит_КнопкаРасчитатьСебестоимость");
	КомандаРасчитатьСебестоимость.Действие = "бит_РасчитатьСебестоимостьНажатие";//Имя процедуры
	КомандаРасчитатьСебестоимость.Заголовок = "Расчитать себестоимость";
	//Создаем Кнопку в конце Родителя (формы)
	КнопкаРасчитатьСебестоимость = ЭтаФорма.Элементы.Вставить("КнопкаРасчетСебестоимости", Тип("КнопкаФормы"), ЭтаФорма, ЭтаФорма.ПодчиненныеЭлементы[0]);
	КнопкаРасчитатьСебестоимость.ИмяКоманды = "бит_КнопкаРасчитатьСебестоимость";
	
	ГруппаДатаНомер = ЭтаФорма.Элементы.Добавить("ГруппаОбычная", Тип("ГруппаФормы"),ЭтаФорма);
	ГруппаДатаНомер.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаДатаНомер.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	ГруппаДатаНомер.ОтображатьЗаголовок = ЛОЖЬ; 
	ГруппаДатаНомер.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ЭлементыФормы.Переместить(ГруппаДатаНомер, ЭтаФорма, Элементы.СтрокаИсправление);
	ВидЦеныЭлементФормы = ЭтаФорма.Элементы.Добавить("бит_ВидЦены", Тип("ПолеФормы"), ГруппаДатаНомер);
	ВидЦеныЭлементФормы.ПутьКДанным = "бит_ВидЦены";
	ВидЦеныЭлементФормы.Заголовок = "Вид цены";
	ВидЦеныЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
	ВидЦеныЭлементФормы.Видимость = Ложь;
	
	ЭлементыФормы.Переместить(КнопкаРасчитатьСебестоимость, ГруппаДатаНомер);
	ЭлементыФормы.Переместить(КнопкаОбщаяНаценка, ГруппаДатаНомер);
	ЭлементыФормы.Переместить(КнопкаЗаписатьЦены, ГруппаДатаНомер);
	
	// Бит Туртыгин >>>
	Если НЕ ЗначениеЗаполнено(Объект.бит_РасчетДопРасходовПо) Тогда
		Объект.бит_РасчетДопРасходовПо = Перечисления.ТипыБазыРаспределенияРасходов.СебестоимостьТоваров;
	КонецЕсли;
	
	ПолеСуммаДопРасходов = Элементы.Добавить("бит_СуммаДопРасходов", Тип("ПолеФормы"), ГруппаДатаНомер);
	ПолеСуммаДопРасходов.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСуммаДопРасходов.Заголовок = "Сумма доп. расходов";
	ПолеСуммаДопРасходов.ПутьКДанным = "Объект.бит_СуммаДопРасходов";
	ПолеСуммаДопРасходов.УстановитьДействие("ПриИзменении", "бит_СуммаДопРасходовПриИзменении");
	Элементы.Переместить(ПолеСуммаДопРасходов, ГруппаДатаНомер);
	
	ПолеРасчетДопРасходовПо = Элементы.Добавить("бит_РасчетДопРасходовПо", Тип("ПолеФормы"), ГруппаДатаНомер);
	ПолеРасчетДопРасходовПо.Вид = ВидПоляФормы.ПолеВвода;
	ПолеРасчетДопРасходовПо.Заголовок = "Расчет по";
	ПолеРасчетДопРасходовПо.ПутьКДанным = "Объект.бит_РасчетДопРасходовПо";
	ПолеРасчетДопРасходовПо.РежимВыбораИзСписка = Истина;
	ПолеРасчетДопРасходовПо.СписокВыбора.Добавить(Перечисления.ТипыБазыРаспределенияРасходов.КоличествоТоваров, "Количеству");
	ПолеРасчетДопРасходовПо.СписокВыбора.Добавить(Перечисления.ТипыБазыРаспределенияРасходов.СебестоимостьТоваров, "Сумме");
	ПолеРасчетДопРасходовПо.УстановитьДействие("ПриИзменении", "бит_РасчетДопРасходовПоПриИзменении");
	Элементы.Переместить(ПолеРасчетДопРасходовПо, ГруппаДатаНомер);
	

	// Бит Туртыгин <<<
	
	бит_НастроитьВидимостьЭлементовУстановкиЦен();
	
	Если бит_ДоступнаУстановкаЦен() Тогда
		ЭтаФорма.бит_ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная с НДС");
		бит_ОбновитьДанныеПриОткрытии();
		бит_УстановитьУсловноеОформление();
	КонецЕсли;
	
КонецПроцедуры


// Бит Туртыгин >>>
&НаСервере
Функция бит_ЕстьРольМенеджмент()
	
	Возврат РольДоступна("бит_РольМенеджмент");
	
КонецФункции

&НаСервере
Функция бит_ЕстьРольРозница()
	
	Возврат РольДоступна("бит_РольРозница");
	
КонецФункции

&НаСервере
Функция бит_ЕстьПраваАдминистратора()
	
	Возврат РольДоступна("ПолныеПрава");
	
КонецФункции

&НаСервере
Функция бит_ДоступнаУстановкаЦен()
	
	Возврат бит_ЕстьРольМенеджмент()
		Или бит_ЕстьРольРозница()
		Или бит_ЕстьПраваАдминистратора();
	
КонецФункции

&НаСервере
Процедура бит_НастроитьВидимостьЭлементовУстановкиЦен()
	
	ДоступнаУстановкаЦен = бит_ДоступнаУстановкаЦен();
	
	Элементы.ГруппаОбычная.Видимость = ДоступнаУстановкаЦен;
	Элементы.бит_Себестоимость.Видимость = ДоступнаУстановкаЦен;
	Элементы.бит_РозничнаяЦена.Видимость = ДоступнаУстановкаЦен;
	Элементы.бит_ПроцентНаценки.Видимость = ДоступнаУстановкаЦен;
	
КонецПроцедуры

&НаСервере
Функция бит_ЕстьПраваМенеджмента()
	
	Возврат бит_ЕстьРольМенеджмент() Или бит_ЕстьПраваАдминистратора();
	
КонецФункции

&НаСервере
Функция бит_ЗаписыватьЗакупочнуюЦену()
	
	Возврат бит_ЕстьПраваМенеджмента() Или бит_ЕстьРольРозница();
	
КонецФункции

&НаСервере
Функция бит_ЗаписыватьВидЦеныЗакупная()
	
	Возврат бит_ЕстьПраваМенеджмента();
	
КонецФункции

&НаСервере
Функция бит_ЗаписыватьВнутреннююЦену()
	
	Возврат бит_ЕстьПраваМенеджмента();
	
КонецФункции
// Бит Туртыгин <<<


&НаСервере
Процедура бит_ОбновитьДанныеПриОткрытии()
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		Если НЕ СтрокаТовары.СписатьНаРасходы Тогда
			СтрокаТовары.бит_Себестоимость = бит_РассчитатьСебестоимость(СтрокаТовары);
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьДополнительныеЗатратыИзДокумента();
	бит_ЗаполнитьРозничныеЦеныПустыхСтрок();
	
КонецПроцедуры

&НаСервере
Процедура бит_ЗаполнитьРозничныеЦеныПустыхСтрок()
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		
		Если СтрокаТовары.СписатьНаРасходы Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТовары.бит_РозничнаяЦена = 0 Тогда
			ЦенаИзРегистра = бит_ПолучитьТекущуюРозничнуюЦену(СтрокаТовары);
			Если ЦенаИзРегистра > 0 Тогда
				СтрокаТовары.бит_РозничнаяЦена = бит_ОкруглитьРозничнуюЦену(ЦенаИзРегистра);
			КонецЕсли;
		КонецЕсли;
		
		бит_ПересчитатьПроцентНаценкиСтроки(СтрокаТовары);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура бит_ЗаполнитьДанныеНовыхСтрок()
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		
		Если СтрокаТовары.СписатьНаРасходы Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТовары.бит_Себестоимость = 0 Тогда
			СтрокаТовары.бит_Себестоимость = бит_РассчитатьСебестоимость(СтрокаТовары);
		КонецЕсли;
		
		Если СтрокаТовары.бит_РозничнаяЦена = 0 Тогда
			ЦенаИзРегистра = бит_ПолучитьТекущуюРозничнуюЦену(СтрокаТовары);
			Если ЦенаИзРегистра > 0 Тогда
				СтрокаТовары.бит_РозничнаяЦена = бит_ОкруглитьРозничнуюЦену(ЦенаИзРегистра);
				бит_ПересчитатьПроцентНаценкиСтроки(СтрокаТовары);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция бит_ОкруглитьРозничнуюЦену(Цена)
	
	Возврат Окр(Цена, 0, РежимОкругления.Окр15как20);
	
КонецФункции

// Обработчик изменения текущей строки  НЕОБХОДИМО?
Процедура ПриИзмененииТекущейСтроки(Элемент, НовыеДанные)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	
	// Обработка изменения розничной цены
	Если ТекущаяСтрока.бит_РозничнаяЦена <> НовыеДанные.бит_РозничнаяЦена Тогда
		Если ТекущаяСтрока.бит_Себестоимость <> 0 Тогда
			ТекущаяСтрока.бит_ПроцентНаценки = (ТекущаяСтрока.бит_РозничнаяЦена - ТекущаяСтрока.бит_Себестоимость) / ТекущаяСтрока.бит_Себестоимость * 100;
		КонецЕсли;
	КонецЕсли;
	
	// Обработка изменения процента наценки
	Если ТекущаяСтрока.бит_ПроцентНаценки <> НовыеДанные.бит_ПроцентНаценки Тогда
		ТекущаяСтрока.бит_РозничнаяЦена = бит_ОкруглитьРозничнуюЦену(ТекущаяСтрока.бит_Себестоимость * (1 + ТекущаяСтрока.бит_ПроцентНаценки / 100));
	КонецЕсли;
	
	бит_УстановитьУсловноеОформление();
	
КонецПроцедуры

// Обработчик активизации строки (для обновления данных) НЕОБХОДИМО?
Процедура бит_ПриАктивизацииСтроки(Элемент, НовыйИндекс, Направление)
	Если НовыйИндекс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Объект.Товары[НовыйИндекс];
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Обновляем себестоимость при активизации строки
	ТекущаяСтрока.бит_Себестоимость = бит_РассчитатьСебестоимость(ТекущаяСтрока);
КонецПроцедуры


&НаСервере
Функция бит_РассчитатьСебестоимость(СтрокаТовары)
	
	БазоваяЦена = СтрокаТовары.Цена;
	//ДополнительныеЗатраты = бит_ПолучитьДополнительныеЗатраты(СтрокаТовары.Номенклатура, Объект.Дата);
	//ДополнительныеЗатраты = ДополнительныеЗатратыПоСтрокеТовары(СтрокаТовары);
	Себестоимость = БазоваяЦена;
	
	Возврат Окр(Себестоимость, 2);
	
КонецФункции

&НаСервере
Функция ДополнительныеЗатратыПоСтрокеТовары(СтрокаТовары)
	
КонецФункции


&НаКлиенте
Процедура бит_СуммаДопРасходовПриИзменении(Элемент)
	
	бит_ПересчитатьСебестоимостьНаСервере(Объект.бит_СуммаДопРасходов, Объект.бит_РасчетДопРасходовПо);
	
КонецПроцедуры

&НаКлиенте
Процедура бит_РасчетДопРасходовПоПриИзменении(Элемент)
	
	бит_ПересчитатьСебестоимостьНаСервере(Объект.бит_СуммаДопРасходов, Объект.бит_РасчетДопРасходовПо);
	
КонецПроцедуры

&НаСервере
Процедура бит_ПересчитатьСебестоимостьНаСервере(Знач СуммаДопРасходов, Знач РасчетДопРасходовПо)
	
	Объект.бит_СуммаДопРасходов = СуммаДопРасходов;
	Если ЗначениеЗаполнено(РасчетДопРасходовПо) Тогда
		Объект.бит_РасчетДопРасходовПо = РасчетДопРасходовПо;
	Иначе
		Объект.бит_РасчетДопРасходовПо = Перечисления.ТипыБазыРаспределенияРасходов.СебестоимостьТоваров;
	КонецЕсли;
	
	бит_АктуализироватьСебестоимостьСтрок(Истина);
	
КонецПроцедуры

// Пересчёт себестоимости с доп. расходами.
// ПересчитыватьРозницуПоНаценке = Истина — как кнопка «Рассчитать себестоимость» (розница = себестоимость * наценка).
// Ложь — только себестоимость и % наценки, розницу не трогаем (перед записью цен).
&НаСервере
Процедура бит_АктуализироватьСебестоимостьСтрок(ПересчитыватьРозницуПоНаценке = Ложь)
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		Если НЕ СтрокаТовары.СписатьНаРасходы Тогда
			СтрокаТовары.бит_Себестоимость = бит_РассчитатьСебестоимость(СтрокаТовары);
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьДополнительныеЗатратыИзДокумента();
	
	Если ПересчитыватьРозницуПоНаценке Тогда
		бит_ПересчитатьРозничныеЦеныПоНаценкеВсехСтрок();
	Иначе
		бит_ПересчитатьПроцентНаценкиВсехСтрок();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура бит_ПересчитатьРозничныеЦеныПоНаценкеВсехСтрок()
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		бит_ПересчитатьРозничнуюЦенуПоНаценкеСтроки(СтрокаТовары);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура бит_ПересчитатьРозничнуюЦенуПоНаценкеСтроки(СтрокаТовары)
	
	СтрокаТовары.бит_РозничнаяЦена = бит_ОкруглитьРозничнуюЦену(СтрокаТовары.бит_Себестоимость * (1 + СтрокаТовары.бит_ПроцентНаценки / 100));
	
КонецПроцедуры

&НаСервере
Процедура бит_ПересчитатьПроцентНаценкиВсехСтрок()
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		бит_ПересчитатьПроцентНаценкиСтроки(СтрокаТовары);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура бит_ПересчитатьПроцентНаценкиСтроки(СтрокаТовары)
	
	Если СтрокаТовары.бит_Себестоимость <> 0 Тогда
		СтрокаТовары.бит_ПроцентНаценки = (СтрокаТовары.бит_РозничнаяЦена - СтрокаТовары.бит_Себестоимость) / СтрокаТовары.бит_Себестоимость * 100;
	Иначе
		СтрокаТовары.бит_ПроцентНаценки = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция бит_СуммаТоварныхСтрокБезРасходов(Товары)
	
	СуммаТоварныхСтрок = 0;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		Если НЕ СтрокаТовары.СписатьНаРасходы Тогда
			СуммаТоварныхСтрок = СуммаТоварныхСтрок + СтрокаТовары.СуммаСНДС;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СуммаТоварныхСтрок;
	
КонецФункции

&НаСервере
Функция бит_ДопРасходДокументаНаЕдиницу(СтрокаТовары, СуммаДопРасходов, БазаРасчета, ОбщееКоличествоТовара, СуммаТоварныхСтрок)
	
	Если СуммаДопРасходов <= 0 Или НЕ ЗначениеЗаполнено(БазаРасчета) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если БазаРасчета = Перечисления.ТипыБазыРаспределенияРасходов.КоличествоТоваров Тогда
		Если ОбщееКоличествоТовара > 0 Тогда
			Возврат СуммаДопРасходов / ОбщееКоличествоТовара;
		КонецЕсли;
	ИначеЕсли БазаРасчета = Перечисления.ТипыБазыРаспределенияРасходов.СебестоимостьТоваров Тогда
		Если СуммаТоварныхСтрок > 0 И СтрокаТовары.Количество > 0 Тогда
			Возврат СуммаДопРасходов * СтрокаТовары.СуммаСНДС / СуммаТоварныхСтрок / СтрокаТовары.Количество;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция бит_ДопРасходНаУпаковку(ДопРасходНаБазовуюЕдиницу, СтрокаТовары)
	
	// Цена и бит_Себестоимость в строке — за упаковку, доп. расход распределяется по базовым единицам (шт.)
	Возврат Окр(ДопРасходНаБазовуюЕдиницу * бит_КоэффициентУпаковкиСтроки(СтрокаТовары), 2);
	
КонецФункции


&НаКлиенте
Процедура бит_РасчитатьСебестоимостьНажатие(Команда)
	
	бит_ПересчитатьСебестоимостьНаСервере(Объект.бит_СуммаДопРасходов, Объект.бит_РасчетДопРасходовПо);
	
КонецПроцедуры


//нахожу документ приобретения услуг и активов один там или несколько, потом выбираю из табличной части по аналитике, проверяю потом
//по типу распределению, и уже на себес добавляю доп расходы
//КритерииОтбора.СвязанныеДокументы.Найти(Объект.Ссылка)

&НаСервере
Функция ВыборДопРасходовИзПриобретенияУслуг()
	
	ДопРасходПоКоличеству = 0;
	ДопРасходПоСтоимости = 0; 	
	МассивДокументов = КритерииОтбора.СвязанныеДокументы.Найти(Объект.Ссылка);
	Для каждого  СсылкаНаДокумент Из МассивДокументов Цикл
		ПроверкаДокумента = Найти(Строка(СсылкаНаДокумент), "Приобретение услуг");		//
		Если  ПроверкаДокумента > 0 И СсылкаНаДокумент.ПометкаУдаления = Ложь И СсылкаНаДокумент.Проведен = Истина Тогда
			Для каждого СтрокаРасходов Из СсылкаНаДокумент.Расходы Цикл
				Если СтрокаРасходов.АналитикаРасходов = Объект.Ссылка Тогда
					Если СтрокаРасходов.СтатьяРасходов.ПравилоРаспределенияРасходовУпр.БазаРаспределенияПоПартиям = Перечисления.ТипыБазыРаспределенияРасходов.КоличествоТоваров Тогда
					  	ДопРасходПоКоличеству = ДопРасходПоКоличеству + СтрокаРасходов.СуммаСНДС;
					ИначеЕсли СтрокаРасходов.СтатьяРасходов.ПравилоРаспределенияРасходовУпр.БазаРаспределенияПоПартиям = Перечисления.ТипыБазыРаспределенияРасходов.СебестоимостьТоваров Тогда	
					    ДопРасходПоСтоимости  = ДопРасходПоСтоимости + СтрокаРасходов.СуммаСНДС;
					КонецЕсли;
				КонецЕсли;			
			КонецЦикла;			
		КонецЕсли;	
		//
		//КонецЕсли;	                                                 	
		//
	Результат = Новый Массив();
	Результат.Добавить(ДопРасходПоСтоимости);
	Результат.Добавить(ДопРасходПоКоличеству);
	
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура РассчитатьДополнительныеЗатратыИзДокумента()
	
	// Строки расходов берём из формы (Объект.Товары), а не из проведённого документа в БД —
	// иначе на непроведённом/после правок без перепроведения доп. расходы «пропадают».
	
	ДопРасходыИзПриобретенияУслуг = ВыборДопРасходовИзПриобретенияУслуг();
	
	ВариантРаспределенияКакСебестоимость = Перечисления.ВариантыРаспределенияРасходов.НаСебестоимостьТоваров;
	ПравилоРаспределенияНаСебестоимость = Перечисления.ТипыБазыРаспределенияРасходов.СебестоимостьТоваров;
	ПравилоРаспределенияНаКоличество = Перечисления.ТипыБазыРаспределенияРасходов.КоличествоТоваров;
	
	СтрокиСРасходами = бит_СтрокиРасходовИзТабличнойЧасти();
	
	ЕстьДопРасходыИзУслуг = Ложь;
	Если ДопРасходыИзПриобретенияУслуг <> Неопределено
		И ДопРасходыИзПриобретенияУслуг.ВГраница() >= 0
		И (ДопРасходыИзПриобретенияУслуг[0] > 0 ИЛИ ДопРасходыИзПриобретенияУслуг[1] > 0) Тогда
		ЕстьДопРасходыИзУслуг = Истина;
	КонецЕсли;
	
	НуженРасчетДопЗатрат = СтрокиСРасходами.Количество() > 0
		ИЛИ ЕстьДопРасходыИзУслуг
		ИЛИ Объект.бит_СуммаДопРасходов > 0;
	
	Если НЕ НуженРасчетДопЗатрат Тогда
		Возврат;
	КонецЕсли;
	
	ТоварыИзДокумента = Объект.Товары;
	СуммаДокумента = Объект.СуммаДокумента;
	ЕстьДопРасходНаКоличество = Ложь;
	ДопРасходНаСтоимость = 0;
	ДопРасходНаКоличество = 0;
	ОбщееКоличествоТовара = 0;
	ДопРасходНаСтоимостьИзДокументаУслуг = 0;
	ДопРасходНаКоличествоИзДокументаУслуг = 0;
	
	Для Каждого СтрокаСРасходами Из СтрокиСРасходами Цикл
		Если СтрокаСРасходами.ВариантРаспределенияРасходов = ВариантРаспределенияКакСебестоимость
			И СтрокаСРасходами.ПравилоРаспределения = ПравилоРаспределенияНаСебестоимость Тогда
			ДопРасходНаСтоимость = ДопРасходНаСтоимость + СтрокаСРасходами.СуммаСНДС;
		КонецЕсли;
		Если СтрокаСРасходами.ВариантРаспределенияРасходов = ВариантРаспределенияКакСебестоимость
			И СтрокаСРасходами.ПравилоРаспределения = ПравилоРаспределенияНаКоличество Тогда
			ЕстьДопРасходНаКоличество = Истина;
			ДопРасходНаКоличество = ДопРасходНаКоличество + СтрокаСРасходами.СуммаСНДС;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьДопРасходыИзУслуг Тогда
		ЕстьДопРасходНаКоличество = Истина;
		ДопРасходНаСтоимостьИзДокументаУслуг = ДопРасходыИзПриобретенияУслуг[0];
		ДопРасходНаКоличествоИзДокументаУслуг = ДопРасходыИзПриобретенияУслуг[1];
	КонецЕсли;
	
	НужноОбщееКоличество = ЕстьДопРасходНаКоличество
		ИЛИ ДопРасходНаКоличествоИзДокументаУслуг > 0
		ИЛИ (Объект.бит_СуммаДопРасходов > 0 И Объект.бит_РасчетДопРасходовПо = ПравилоРаспределенияНаКоличество);
	
	Если НужноОбщееКоличество Тогда
		Для Каждого СтрокаСТоварами Из ТоварыИзДокумента Цикл
			Если НЕ СтрокаСТоварами.СписатьНаРасходы Тогда
				ОбщееКоличествоТовара = ОбщееКоличествоТовара + СтрокаСТоварами.Количество;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СуммаТоварныхСтрок = бит_СуммаТоварныхСтрокБезРасходов(ТоварыИзДокумента);
	
	Для Каждого СтрокаСТоварами Из ТоварыИзДокумента Цикл
		Если СтрокаСТоварами.СписатьНаРасходы Тогда
			Продолжить;
		КонецЕсли;
		
		ДопРасходыНаСебестоимостьСтоимость = 0;
		ДопРасходыНаСебестоимостьКоличество = 0;
		
		Если ДопРасходНаСтоимость > 0 Тогда
			ДопРасходыНаСебестоимостьСтоимость = СтрокаСТоварами.СуммаСНДС
				/ (СуммаДокумента - (ДопРасходНаСтоимость + ДопРасходНаКоличество))
				* ДопРасходНаСтоимость / СтрокаСТоварами.Количество;
		КонецЕсли;
		Если ДопРасходНаКоличество > 0 И ЕстьДопРасходНаКоличество И ОбщееКоличествоТовара > 0 Тогда
			ДопРасходыНаСебестоимостьКоличество = ДопРасходНаКоличество / ОбщееКоличествоТовара;
		КонецЕсли;
		
		Если ДопРасходНаСтоимостьИзДокументаУслуг > 0 Тогда
			ДопРасходыНаСебестоимостьСтоимость = ДопРасходыНаСебестоимостьСтоимость
				+ (СтрокаСТоварами.СуммаСНДС
					/ (СуммаДокумента - (ДопРасходНаСтоимость + ДопРасходНаКоличество))
					* ДопРасходНаСтоимостьИзДокументаУслуг / СтрокаСТоварами.Количество);
		КонецЕсли;
		Если ДопРасходНаКоличествоИзДокументаУслуг > 0 И ОбщееКоличествоТовара > 0 Тогда
			ДопРасходыНаСебестоимостьКоличество = ДопРасходыНаСебестоимостьКоличество
				+ (ДопРасходНаКоличествоИзДокументаУслуг / ОбщееКоличествоТовара);
		КонецЕсли;
		
		ДопРасходНаБазовуюЕдиницу = ДопРасходыНаСебестоимостьКоличество + ДопРасходыНаСебестоимостьСтоимость;
		ДопРасходНаБазовуюЕдиницу = ДопРасходНаБазовуюЕдиницу + бит_ДопРасходДокументаНаЕдиницу(
			СтрокаСТоварами,
			Объект.бит_СуммаДопРасходов,
			Объект.бит_РасчетДопРасходовПо,
			ОбщееКоличествоТовара,
			СуммаТоварныхСтрок);
		Себестоимость = СтрокаСТоварами.Цена + бит_ДопРасходНаУпаковку(ДопРасходНаБазовуюЕдиницу, СтрокаСТоварами);
		СтрокаСТоварами.бит_Себестоимость = Окр(Себестоимость, 2);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция бит_СтрокиРасходовИзТабличнойЧасти()
	
	СтрокиСРасходами = Новый Массив;
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		
		Если НЕ СтрокаТовары.СписатьНаРасходы Тогда
			Продолжить;
		КонецЕсли;
		
		ВариантРаспределения = Неопределено;
		ПравилоРаспределения = Неопределено;
		
		Если ЗначениеЗаполнено(СтрокаТовары.СтатьяРасходов) Тогда
			РеквизитыСтатьи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				СтрокаТовары.СтатьяРасходов,
				"ВариантРаспределенияРасходовУпр, ПравилоРаспределенияРасходовУпр");
			ВариантРаспределения = РеквизитыСтатьи.ВариантРаспределенияРасходовУпр;
			Если ЗначениеЗаполнено(РеквизитыСтатьи.ПравилоРаспределенияРасходовУпр) Тогда
				ПравилоРаспределения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					РеквизитыСтатьи.ПравилоРаспределенияРасходовУпр,
					"БазаРаспределенияПоПартиям");
			КонецЕсли;
		КонецЕсли;
		
		СтрокиСРасходами.Добавить(Новый Структура(
			"СуммаСНДС, ВариантРаспределенияРасходов, ПравилоРаспределения",
			СтрокаТовары.СуммаСНДС,
			ВариантРаспределения,
			ПравилоРаспределения));
		
	КонецЦикла;
	
	Возврат СтрокиСРасходами;
	
КонецФункции

// Функция получения текущей розничной цены
&НаСервере
Функция бит_КоэффициентУпаковкиСтроки(СтрокаТовары)
	
	Если НЕ ЗначениеЗаполнено(СтрокаТовары.Упаковка) Тогда
		Возврат 1;
	КонецЕсли;
	
	Коэффициент = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(СтрокаТовары.Упаковка, СтрокаТовары.Номенклатура);
	
	Если Коэффициент = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат Коэффициент;
	
КонецФункции

&НаСервере
Функция бит_ЦенаЗаЕдиницуТовара(Цена, СтрокаТовары)
	
	Возврат Окр(Цена / бит_КоэффициентУпаковкиСтроки(СтрокаТовары), 2);
	
КонецФункции

&НаСервере
Функция бит_ЦенаЗаУпаковкуСтроки(ЦенаЗаЕдиницу, СтрокаТовары)
	
	Возврат Окр(ЦенаЗаЕдиницу * бит_КоэффициентУпаковкиСтроки(СтрокаТовары), 2);
	
КонецФункции

&НаСервере
Функция бит_КлючПозицииДляЦены(СтрокаТовары)
	
	Возврат СтрЗаменить("" + СтрокаТовары.Номенклатура + СтрокаТовары.Характеристика + СтрокаТовары.Серия, " ", "");
	
КонецФункции

&НаСервере
Процедура бит_ЗаполнитьИзмеренияЦОСтроки(СтрокаТаблицы, СтрокаТовары)
	
	Если ЗначениеЗаполнено(СтрокаТовары.Характеристика) Тогда
		СтрокаТаблицы.ХарактеристикаЦО = Справочники.ХарактеристикиНоменклатурыДляЦенообразования.НайтиПоНаименованию(СтрокаТовары.Характеристика.Наименование, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТовары.Серия) Тогда
		СтрокаТаблицы.СерияЦО = Справочники.СерииНоменклатурыДляЦенообразования.НайтиПоНаименованию(СтрокаТовары.Серия.Наименование, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция бит_ПолучитьТекущуюРозничнуюЦену(СтрокаТовары)
	
	ЦенаЗаЕдиницу = бит_ПолучитьТекущуюЦенуПоВиду(СтрокаТовары, ПолучитьВидЦеныРозничнаяБезНДС());
	Если ЦенаЗаЕдиницу = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат бит_ОкруглитьРозничнуюЦену(бит_ЦенаЗаУпаковкуСтроки(ЦенаЗаЕдиницу, СтрокаТовары));
	
КонецФункции

// Текущая цена из регистра за базовую единицу (УпаковкаЦО пустая).
&НаСервере
Функция бит_ПолучитьТекущуюЦенуПоВиду(СтрокаТовары, ВидЦены)
	
	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЦеныНоменклатуры25.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры25 КАК ЦеныНоменклатуры25
	|ГДЕ
	|	ЦеныНоменклатуры25.Номенклатура = &Номенклатура
	|	И ЦеныНоменклатуры25.ВидЦены = &ВидЦены
	|	И ЦеныНоменклатуры25.ХарактеристикаЦО = &ХарактеристикаЦО
	|	И ЦеныНоменклатуры25.СерияЦО = &СерияЦО
	|	И ЦеныНоменклатуры25.УпаковкаЦО = &УпаковкаЦО
	|	И ЦеныНоменклатуры25.Период <= &ДатаДокумента
	|УПОРЯДОЧИТЬ ПО
	|	ЦеныНоменклатуры25.Период УБЫВ
	|";
	
	Запрос.УстановитьПараметр("Номенклатура", СтрокаТовары.Номенклатура);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("ДатаДокумента", Макс(Объект.Дата, ТекущаяДатаСеанса()));
	
	ХарактеристикаЦО = Справочники.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка();
	Если ЗначениеЗаполнено(СтрокаТовары.Характеристика) Тогда
		ХарактеристикаЦО = Справочники.ХарактеристикиНоменклатурыДляЦенообразования.НайтиПоНаименованию(СтрокаТовары.Характеристика.Наименование, Истина);
	КонецЕсли;
	Запрос.УстановитьПараметр("ХарактеристикаЦО", ХарактеристикаЦО);
	
	СерияЦО = Справочники.СерииНоменклатурыДляЦенообразования.ПустаяСсылка();
	Если ЗначениеЗаполнено(СтрокаТовары.Серия) Тогда
		СерияЦО = Справочники.СерииНоменклатурыДляЦенообразования.НайтиПоНаименованию(СтрокаТовары.Серия.Наименование, Истина);
	КонецЕсли;
	Запрос.УстановитьПараметр("СерияЦО", СерияЦО);
	Запрос.УстановитьПараметр("УпаковкаЦО", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Обработчик кнопки "Установить общую наценку" 
&НаКлиенте
Процедура бит_ОбщаяНаценкаНажатие(Команда)
	
	// Запрос процента наценки у пользователя
	Оповещение = Новый ОписаниеОповещения("ПослеВводаЧисла", ЭтотОбъект);
	
	ПоказатьВводЧисла(Оповещение, , "Введите наценку в %", 15, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЧисла(Число, ДополнительныеПараметры) Экспорт
	Если НЕ Число = Неопределено Тогда
		ВыделенныеСтроки = Элементы.Товары.ВыделенныеСтроки;
		Если ВыделенныеСтроки.Количество() = 0 Тогда
			Сообщить("Не выделено ни одной строки");
			Возврат;
		КонецЕсли;
		бит_АктуализироватьСебестоимостьСтрокНаСервере();
		Для Каждого ИндексСтроки Из ВыделенныеСтроки Цикл
			ТекСтр = Элементы.Товары.ДанныеСтроки(ИндексСтроки);
			ТекСтр.бит_ПроцентНаценки = Число;
			ТекСтр.бит_РозничнаяЦена = бит_ОкруглитьРозничнуюЦену(ТекСтр.бит_Себестоимость * (1 + Число / 100));
		КонецЦикла;
		Сообщить("Наценка применена к " + ВыделенныеСтроки.Количество() + " строкам");
	Иначе
		Возврат;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура бит_АктуализироватьСебестоимостьСтрокНаСервере()
	
	бит_АктуализироватьСебестоимостьСтрок(Ложь);
	
КонецПроцедуры

// Проверяет, совпадает ли бит_Себестоимость с расчётом Цена + доп. расходы.
// Данные формы не меняет (снимок → пересчёт → сравнение → откат).
&НаСервере
Функция бит_СебестоимостьНеактуальнаНаСервере()
	
	Возврат бит_СебестоимостьНеактуальна();
	
КонецФункции

&НаСервере
Функция бит_СебестоимостьНеактуальна()
	
	СнимокСебестоимости = Новый Соответствие;
	ИндексСтроки = 0;
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		СнимокСебестоимости.Вставить(ИндексСтроки, СтрокаТовары.бит_Себестоимость);
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		Если НЕ СтрокаТовары.СписатьНаРасходы Тогда
			СтрокаТовары.бит_Себестоимость = бит_РассчитатьСебестоимость(СтрокаТовары);
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьДополнительныеЗатратыИзДокумента();
	
	Неактуальна = Ложь;
	ИндексСтроки = 0;
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		Если НЕ СтрокаТовары.СписатьНаРасходы Тогда
			Было = СнимокСебестоимости.Получить(ИндексСтроки);
			Если Было = Неопределено Тогда
				Было = 0;
			КонецЕсли;
			Если Макс(СтрокаТовары.бит_Себестоимость - Было, Было - СтрокаТовары.бит_Себестоимость) > 0.009 Тогда
				Неактуальна = Истина;
			КонецЕсли;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		СтрокаТовары.бит_Себестоимость = СнимокСебестоимости.Получить(ИндексСтроки);
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Возврат Неактуальна;
	
КонецФункции

// Обработчик кнопки "Записать цены" 

//Разделить вопрос НаКлиенте Обработка НаСервере? ВОПРОС ПЕРЕВЕСТИ НА КЛИЕНТЫ

&НаКлиенте
Асинх Процедура ЗадатьВопросАсинх()
	//ЖДАТЬ НЕ РАБОТАЕТ ПРОВЕРИТЬ
	Ответ = Ждать ВопросАсинх(НСтр("ru='Некоторые позиции имеют нулевую розничную цену. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	//Результат = Ждать Ответ; // тут выполнение остановится пока пользователь не ответит на вопрос
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДокУстановкиЦен = СозданиеДокументаУстановкиЦен();
		Сообщить("Документ установки цен номенклатуры создан");
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда 
		Сообщить("Документ не будет создан");
	Иначе
		Сообщить("Документ не будет создан");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ЗаписатьЦеныНажатие(Команда)
	
	Если бит_ТребуетсяПодтверждениеПовторнойУстановкиЦенНаСервере() Тогда
		ТекстВопроса = НСтр("ru = 'Для данного документа уже устанавливались цены. Вы уверены, что хотите создать еще один документ ""Установка цен""?'");
		Оповещение = Новый ОписаниеОповещения("бит_ПодтверждениеПовторнойУстановкиЦенЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	бит_ПроверитьСебестоимостьИСоздатьДокументУстановкиЦен();
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ПодтверждениеПовторнойУстановкиЦенЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		бит_ПроверитьСебестоимостьИСоздатьДокументУстановкиЦен();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ПроверитьСебестоимостьИСоздатьДокументУстановкиЦен()
	
	Если бит_СебестоимостьНеактуальнаНаСервере() Тогда
		ТекстВопроса = НСтр("ru = 'Себестоимость не актуальна (не учтены доп. расходы или изменились цены).
|Перед записью себестоимость будет пересчитана.
|Введённые вами розничные цены НЕ изменятся — обновится только себестоимость и % наценки.
|
|Продолжить запись цен?'");
		Оповещение = Новый ОписаниеОповещения("бит_ПодтверждениеПересчетаСебестоимостиПередЗаписьюЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	бит_ВыполнитьСозданиеДокументаУстановкиЦен();
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ПодтверждениеПересчетаСебестоимостиПередЗаписьюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	бит_АктуализироватьСебестоимостьСтрокНаСервере();
	бит_УстановитьУсловноеОформление();
	бит_ВыполнитьСозданиеДокументаУстановкиЦен();
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ВыполнитьСозданиеДокументаУстановкиЦен()
	
	СсылкаДокумента = бит_СоздатьДокументУстановкиЦенНаСервере();
	
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция бит_ТребуетсяПодтверждениеПовторнойУстановкиЦенНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат бит_ЕстьНепомеченныеДокументыУстановкиЦенПоОснованию(Объект.Ссылка);
	
КонецФункции

&НаСервереБезКонтекста
Функция бит_ЕстьНепомеченныеДокументыУстановкиЦенПоОснованию(ДокументОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УстановкаЦен.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦен
	|ГДЕ
	|	УстановкаЦен.ДокументОснование = &ДокументОснование
	|	И НЕ УстановкаЦен.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция бит_СоздатьДокументУстановкиЦенНаСервере()
	
	Возврат СозданиеДокументаУстановкиЦен();
	
КонецФункции

&НаСервере
Функция СозданиеДокументаУстановкиЦен()
	
	// Бит Туртыгин >>>
	Если НЕ бит_ДоступнаУстановкаЦен() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для установки цен.'");
	КонецЕсли;
	
	// Себестоимость уже проверена/актуализирована на клиенте перед вызовом.
	// Здесь ещё раз на всякий случай, если вызывают напрямую — без пересчёта розницы.
	Если бит_СебестоимостьНеактуальна() Тогда
		бит_АктуализироватьСебестоимостьСтрок(Ложь);
	КонецЕсли;
	
	ЗаписыватьЗакупочную = бит_ЗаписыватьЗакупочнуюЦену();
	ЗаписыватьВидЦеныЗакупная = бит_ЗаписыватьВидЦеныЗакупная();
	ЗаписыватьВнутреннюю = бит_ЗаписыватьВнутреннююЦену();
	СсылкаДокумента = Документы.УстановкаЦенНоменклатуры.ПустаяСсылка();
	// Бит Туртыгин <<<
	
	//Создаем документ установки цен
	НачатьТранзакцию();
	Попытка
		ДокУстановкиЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		ДокУстановкиЦен.Дата = ТекущаяДата();
		ДокУстановкиЦен.Согласован = Истина; 
		ДокУстановкиЦен.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
		ДокУстановкиЦен.ДокументОснование = Объект.Ссылка;
		ДокУстановкиЦен.Ответственный = Пользователи.ТекущийПользователь(); 
		ДокУстановкиЦен.Комментарий = "Сформировано из документа " + Объект.Ссылка;
		//возможно переделать под выбор изменяемого вида цен
		
		// Бит Туртыгин >>>
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.бит_ВидЦены) Тогда
			ВызватьИсключение НСтр("ru = 'Не заполнен вид розничной цены.'");
		КонецЕсли;
		// Бит Туртыгин <<<
		
		СтрокаВидаЦены = ДокУстановкиЦен.ВидыЦен.Добавить();
		СтрокаВидаЦены.ВидЦены = ЭтаФорма.бит_ВидЦены;
		
		// Бит Туртыгин >>>
		ВидЦеныСебестоимости = Неопределено;
		ВидЦеныВнутренняяПродажа = Неопределено;
		
		Если ЗаписыватьЗакупочную Тогда
			ВидЦеныСебестоимости = ПолучитьВидЦеныОтСебестоимости();
			СтрокаВидаЦеныСебестоимости = ДокУстановкиЦен.ВидыЦен.Добавить();
			СтрокаВидаЦеныСебестоимости.ВидЦены = ВидЦеныСебестоимости;
		КонецЕсли;
		
		Если ЗаписыватьВнутреннюю Тогда
			ВидЦеныВнутренняяПродажа = ПолучитьВидЦеныВнутренняяПродажа();
			СтрокаВидаЦеныВнутренняя = ДокУстановкиЦен.ВидыЦен.Добавить();
			СтрокаВидаЦеныВнутренняя.ВидЦены = ВидЦеныВнутренняяПродажа;
		КонецЕсли;
		
		ВидЦеныРозничнаяБезНДС = ПолучитьВидЦеныРозничнаяБезНДС();
		СтрокаВидаЦеныРозничнаяБезНДС = ДокУстановкиЦен.ВидыЦен.Добавить();
		СтрокаВидаЦеныРозничнаяБезНДС.ВидЦены = ВидЦеныРозничнаяБезНДС;
		
		ВидЦеныЗакупная = Неопределено;
		Если ЗаписыватьВидЦеныЗакупная Тогда
			ВидЦеныЗакупная = ПолучитьВидЦеныЗакупная();
			СтрокаВидаЦеныЗакупная = ДокУстановкиЦен.ВидыЦен.Добавить();
			СтрокаВидаЦеныЗакупная.ВидЦены = ВидЦеныЗакупная;
		КонецЕсли;
		// Бит Туртыгин <<<
		//ВидЦеныСебестоимости = ПолучитьВидЦеныОтСебестоимости();
		//СтрокаВидаЦеныСебестоимости = ДокУстановкиЦен.ВидыЦен.Добавить();
		//СтрокаВидаЦеныСебестоимости.ВидЦены = ВидЦеныСебестоимости;
		
		ТаблицаТоваров = ДокУстановкиЦен.Товары2_5.Выгрузить();
		СоответствиеПозиций = Новый Соответствие;
		
		Для Каждого СтрокаТовары Из Объект.Товары Цикл
			
			Если СтрокаТовары.СписатьНаРасходы Тогда
				Продолжить;
			КонецЕсли;
			
			КлючПозиции = бит_КлючПозицииДляЦены(СтрокаТовары);
			РозничнаяЦенаЗаЕдиницу = бит_ЦенаЗаЕдиницуТовара(СтрокаТовары.бит_РозничнаяЦена, СтрокаТовары);
			СебестоимостьЗаЕдиницу = бит_ЦенаЗаЕдиницуТовара(СтрокаТовары.бит_Себестоимость, СтрокаТовары);
			ЗакупочнаяЦенаЗаЕдиницу = 0;
			Если ЗаписыватьВидЦеныЗакупная Тогда
				ЗакупочнаяЦенаЗаЕдиницу = бит_ЦенаЗаЕдиницуТовара(СтрокаТовары.Цена, СтрокаТовары);
			КонецЕсли;
			ДанныеПозиции = СоответствиеПозиций.Получить(КлючПозиции);
			
			Если ДанныеПозиции = Неопределено Тогда
				СоответствиеПозиций.Вставить(КлючПозиции, Новый Структура("СтрокаТовары, РозничнаяЦена, Себестоимость, ЗакупочнаяЦена",
					СтрокаТовары, РозничнаяЦенаЗаЕдиницу, СебестоимостьЗаЕдиницу, ЗакупочнаяЦенаЗаЕдиницу));
			Иначе
				Если РозничнаяЦенаЗаЕдиницу > ДанныеПозиции.РозничнаяЦена Тогда
					ДанныеПозиции.РозничнаяЦена = РозничнаяЦенаЗаЕдиницу;
					ДанныеПозиции.СтрокаТовары = СтрокаТовары;
				КонецЕсли;
				Если СебестоимостьЗаЕдиницу > ДанныеПозиции.Себестоимость Тогда
					ДанныеПозиции.Себестоимость = СебестоимостьЗаЕдиницу;
				КонецЕсли;
				Если ЗакупочнаяЦенаЗаЕдиницу > ДанныеПозиции.ЗакупочнаяЦена Тогда
					ДанныеПозиции.ЗакупочнаяЦена = ЗакупочнаяЦенаЗаЕдиницу;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ДанныеПозиции Из СоответствиеПозиций Цикл
			
			СтрокаТовары = ДанныеПозиции.Значение.СтрокаТовары;
			
			Если ДанныеПозиции.Значение.РозничнаяЦена > 0 Тогда
				
				СтавкаНДС = 0;
				Если ЗначениеЗаполнено(СтрокаТовары.СтавкаНДС) Тогда
					СтавкаНДС = СтрокаТовары.СтавкаНДС.Ставка;
				КонецЕсли;
				
				ЦенаБезНДС = Окр(ДанныеПозиции.Значение.РозничнаяЦена, 0, РежимОкругления.Окр15как20);
				ЦенаСНДС = Окр(ЦенаБезНДС * (СтавкаНДС / 100) + ЦенаБезНДС, 0, РежимОкругления.Окр15как20);
				
				// Не занижаем розницу с НДС: если действующая выше — оставляем её
				ДействующаяЦенаСНДС = бит_ПолучитьТекущуюЦенуПоВиду(СтрокаТовары, ЭтаФорма.бит_ВидЦены);
				Если ДействующаяЦенаСНДС > ЦенаСНДС Тогда
					ЦенаСНДС = ДействующаяЦенаСНДС;
					ДействующаяЦенаБезНДС = бит_ПолучитьТекущуюЦенуПоВиду(СтрокаТовары, ВидЦеныРозничнаяБезНДС);
					Если ДействующаяЦенаБезНДС > 0 Тогда
						ЦенаБезНДС = Окр(ДействующаяЦенаБезНДС, 0, РежимОкругления.Окр15как20);
					ИначеЕсли СтавкаНДС > 0 Тогда
						ЦенаБезНДС = Окр(ЦенаСНДС / (1 + СтавкаНДС / 100), 0, РежимОкругления.Окр15как20);
					Иначе
						ЦенаБезНДС = ЦенаСНДС;
					КонецЕсли;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаТоваров.Добавить();
				НоваяСтрока.Номенклатура = СтрокаТовары.Номенклатура;
				бит_ЗаполнитьИзмеренияЦОСтроки(НоваяСтрока, СтрокаТовары);
				НоваяСтрока.ВидЦены = ЭтаФорма.бит_ВидЦены;
				НоваяСтрока.Цена = ЦенаСНДС;
				НоваяСтрока.ЦенаИзмененаВручную = Истина;
				
				НоваяСтрока = ТаблицаТоваров.Добавить();
				НоваяСтрока.Номенклатура = СтрокаТовары.Номенклатура;
				бит_ЗаполнитьИзмеренияЦОСтроки(НоваяСтрока, СтрокаТовары);
				НоваяСтрока.ВидЦены = ВидЦеныРозничнаяБезНДС;
				НоваяСтрока.Цена = ЦенаБезНДС;
				НоваяСтрока.ЦенаИзмененаВручную = Истина;
				
			КонецЕсли;
			
			Если ЗаписыватьВидЦеныЗакупная И ДанныеПозиции.Значение.ЗакупочнаяЦена > 0 Тогда
				НоваяСтрокаЗакупочная = ТаблицаТоваров.Добавить();
				НоваяСтрокаЗакупочная.Номенклатура = СтрокаТовары.Номенклатура;
				бит_ЗаполнитьИзмеренияЦОСтроки(НоваяСтрокаЗакупочная, СтрокаТовары);
				НоваяСтрокаЗакупочная.ВидЦены = ВидЦеныЗакупная;
				НоваяСтрокаЗакупочная.Цена = ДанныеПозиции.Значение.ЗакупочнаяЦена;
				НоваяСтрокаЗакупочная.ЦенаИзмененаВручную = Истина;
			КонецЕсли;
			
			// Бит Туртыгин >>>
			Если ЗаписыватьЗакупочную И ДанныеПозиции.Значение.Себестоимость > 0 Тогда
			// Бит Туртыгин <<<
				НоваяСтрокаСебестоимость = ТаблицаТоваров.Добавить();
				НоваяСтрокаСебестоимость.Номенклатура = СтрокаТовары.Номенклатура;
				бит_ЗаполнитьИзмеренияЦОСтроки(НоваяСтрокаСебестоимость, СтрокаТовары);
				НоваяСтрокаСебестоимость.ВидЦены = ВидЦеныСебестоимости;
				НоваяСтрокаСебестоимость.Цена = ДанныеПозиции.Значение.Себестоимость;
				НоваяСтрокаСебестоимость.ЦенаИзмененаВручную = Истина;
			КонецЕсли;
			
			// Бит Туртыгин >>>
			// Внутренняя продажа = закупочная ДОП (себестоимость), без +5%
			Если ЗаписыватьВнутреннюю И ДанныеПозиции.Значение.Себестоимость > 0 Тогда
				НоваяСтрокаВнутренняя = ТаблицаТоваров.Добавить();
				НоваяСтрокаВнутренняя.Номенклатура = СтрокаТовары.Номенклатура;
				бит_ЗаполнитьИзмеренияЦОСтроки(НоваяСтрокаВнутренняя, СтрокаТовары);
				НоваяСтрокаВнутренняя.ВидЦены = ВидЦеныВнутренняяПродажа;
				НоваяСтрокаВнутренняя.Цена = ДанныеПозиции.Значение.Себестоимость;
				НоваяСтрокаВнутренняя.ЦенаИзмененаВручную = Истина;
			КонецЕсли;
			// Бит Туртыгин <<<
			
		КонецЦикла;
		
		// Бит Туртыгин >>>
		Если ТаблицаТоваров.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Нет строк для записи цен. Заполните розничные цены в табличной части.'");
		КонецЕсли;
		// Бит Туртыгин <<<
		
		ДокУстановкиЦен.Товары2_5.Загрузить(ТаблицаТоваров);
		ДокУстановкиЦен.Записать(РежимЗаписиДокумента.Запись);
		СсылкаДокумента = ДокУстановкиЦен.Ссылка;
		Сообщить(СсылкаДокумента);
		ЗафиксироватьТранзакцию();
		Сообщить("Документ установки цен номенклатуры создан");
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ОбщегоНазначения.СообщитьПользователю("Не удалось создать документ по причине: "+ТекстОшибки);	
	КонецПопытки;
	
	Возврат СсылкаДокумента;
	
КонецФункции

&НаКлиенте
&ИзменениеИКонтроль("ТоварыЦенаПриИзменении")
Процедура бит_ТоварыЦенаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	ОбновитьОтклоненияОтЗаказаВСтроке(ТекущаяСтрока, Объект.ПоступлениеПоЗаказам, Объект.ТребуетсяЗалогЗаТару);
	
	РассчитатьИтоговыеПоказателиПоступления(ЭтаФорма);
	
	Если Объект.ПоступлениеПоЗаказам Тогда
		ОбновитьНадписьОтклоненийОтЦенЗаказа();
	КонецЕсли;
	
	#Вставка
	// После пересчёта сумм — себестоимость с доп. расходами по всем строкам.
	// Розницу не трогаем, только % наценки.
	бит_АктуализироватьСебестоимостьСтрокНаСервере();
	бит_УстановитьУсловноеОформление();
	#КонецВставки
	
КонецПроцедуры

&НаСервере
Процедура бит_ТоварыПриИзмененииПослеНаСервере()
	
	бит_ЗаполнитьДанныеНовыхСтрок();
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ТоварыПриИзмененииПосле(Элемент)
	бит_ТоварыПриИзмененииПослеНаСервере();
КонецПроцедуры


&НаКлиенте
Процедура РозничнаяЦенаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ТекущаяСтрока.бит_РозничнаяЦена = бит_ОкруглитьРозничнуюЦену(ТекущаяСтрока.бит_РозничнаяЦена);
	
	Если ТекущаяСтрока.бит_Себестоимость <> 0 Тогда
		ТекущаяСтрока.бит_ПроцентНаценки = (ТекущаяСтрока.бит_РозничнаяЦена - ТекущаяСтрока.бит_Себестоимость) / ТекущаяСтрока.бит_Себестоимость * 100;
	Иначе                                                                                                   
		ТекущаяСтрока.бит_ПроцентНаценки = 0;
	КонецЕсли;
	бит_УстановитьУсловноеОформление();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроцентНаценкиПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	ТекущаяСтрока.бит_РозничнаяЦена = бит_ОкруглитьРозничнуюЦену(
		ТекущаяСтрока.бит_Себестоимость * (1 + ТекущаяСтрока.бит_ПроцентНаценки / 100));
	
КонецПроцедуры 



&НаКлиенте
Процедура СебестоимостьПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ПередаваемаяСтрока = Новый Структура();
	ПередаваемаяСтрока.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	ПередаваемаяСтрока.Вставить("Цена", ТекущаяСтрока.Цена);	
	ТекущаяСтрока.бит_Себестоимость = бит_РассчитатьСебестоимость(ПередаваемаяСтрока);
	
КонецПроцедуры 

