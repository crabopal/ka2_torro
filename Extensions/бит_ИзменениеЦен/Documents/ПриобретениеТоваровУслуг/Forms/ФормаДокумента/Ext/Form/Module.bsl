&После("УстановитьУсловноеОформление")
Процедура бит_УстановитьУсловноеОформление()
	
       	ЭлементУО 							= УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось);
	ЭлементУсловия 						= ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("Объект.Товары.бит_ПроцентНаценки");
	ЭлементУсловия.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Меньше;
	ЭлементУсловия.ПравоеЗначение 		= Число(0);
	ЭлементУсловия.Использование		= Истина;
	
	//оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("бит_ПроцентНаценки"); 

КонецПроцедуры




