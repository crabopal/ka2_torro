
&НаСервере
Процедура бит_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	бит_НастроитьКолонкуДопРасходВСпискеЗакупки();
	
КонецПроцедуры

&НаСервере
&После("НастроитьФормуПоВыбраннымОперациямИДокументам")
Процедура бит_НастроитьФормуПоВыбраннымОперациямИДокументамПосле(ТЗХозОперацииИТипыДокументов)
	
	бит_НастроитьКолонкуДопРасходВСпискеЗакупки();
	
КонецПроцедуры

&НаСервере
Процедура бит_НастроитьКолонкуДопРасходВСпискеЗакупки()
	
	бит_ДополнитьСписокДокументовЗакупкиПризнакомДопРасходов();
	бит_ДобавитьКолонкуЕстьДопРасходыНаФорму();
	
КонецПроцедуры

&НаСервере
Процедура бит_ДобавитьКолонкуЕстьДопРасходыНаФорму()
	
	ПолеЕстьДопРасходы = Элементы.Найти("бит_ЕстьДопРасходы");
	Если ПолеЕстьДопРасходы = Неопределено Тогда
		ПолеЕстьДопРасходы = Элементы.Добавить("бит_ЕстьДопРасходы", Тип("ПолеФормы"), Элементы.СписокДокументыЗакупки);
		ПолеЕстьДопРасходы.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеЕстьДопРасходы.ПутьКДанным = "СписокДокументыЗакупки.бит_ЕстьДопРасходы";
		ПолеЕстьДопРасходы.Заголовок = "Доп. расход";
		ПолеЕстьДопРасходы.ТолькоПросмотр = Истина;
		
		ЭлементОриентир = Элементы.Найти("СписокДокументыЗакупкиСуммаДокумента");
		Если ЭлементОриентир <> Неопределено Тогда
			Элементы.Переместить(ПолеЕстьДопРасходы, Элементы.СписокДокументыЗакупки, ЭлементОриентир);
		КонецЕсли;
	КонецЕсли;
	
	ПолеЕстьДопРасходы.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура бит_ДополнитьСписокДокументовЗакупкиПризнакомДопРасходов()
	
	ТекстЗапроса = СписокДокументыЗакупки.ТекстЗапроса;
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ТекстЗапроса, "бит_ЕстьДопРасходы") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПсевдонимаРеестра = бит_ИмяПсевдонимаРеестраВЗапросе(ТекстЗапроса);
	Если ПустаяСтрока(ИмяПсевдонимаРеестра) Тогда
		Возврат;
	КонецЕсли;
	
	ФрагментПоля = бит_ФрагментПоляЕстьДопРасходы(ИмяПсевдонимаРеестра);
	ЗаменяемыйТекст = ИмяПсевдонимаРеестра + ".Сумма КАК СуммаДокумента";
	Если СтрНайти(ТекстЗапроса, ЗаменяемыйТекст) = 0 Тогда
		ЗаменяемыйТекст = ИмяПсевдонимаРеестра + ".ИдентификаторЗаписи КАК ИдентификаторЗаписи";
	КонецЕсли;
	
	Если СтрНайти(ТекстЗапроса, ЗаменяемыйТекст) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовыйФрагмент = ФрагментПоля + "," + Символы.ПС + Символы.Таб + ЗаменяемыйТекст;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаменяемыйТекст, НовыйФрагмент);
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	ЗаполнитьЗначенияСвойств(СвойстваСписка, СписокДокументыЗакупки);
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокДокументыЗакупки, СвойстваСписка);
	
КонецПроцедуры

&НаСервере
Функция бит_ИмяПсевдонимаРеестраВЗапросе(ТекстЗапроса)
	
	Если СтрНайти(ТекстЗапроса, "РеестрДокументовПереопределяемый") > 0 Тогда
		Возврат "РеестрДокументовПереопределяемый";
	КонецЕсли;
	
	Если СтрНайти(ТекстЗапроса, "РеестрДокументов") > 0 Тогда
		Возврат "РеестрДокументов";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция бит_ФрагментПоляЕстьДопРасходы(ИмяПсевдонимаРеестра)
	
	Возврат "ВЫБОР
	|		КОГДА " + ИмяПсевдонимаРеестра + ".Ссылка ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			И ВЫРАЗИТЬ(" + ИмяПсевдонимаРеестра + ".Ссылка КАК Документ.ПриобретениеТоваровУслуг).бит_СуммаДопРасходов > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК бит_ЕстьДопРасходы";
	
КонецФункции
