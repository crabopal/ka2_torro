Функция ДопРеквизитЗначокНоменклатуры() Экспорт
	
	Создан = Ложь;
	
	ДопРеквизит = Маг1СИнтеграция.ДопРеквизитMag1c(Маг1СПеречисления.ДопСвойства_ЗначокНоменклатурыMag1c(),
													Неопределено,
													Создан); 
									
	Если Создан Тогда
		УстановитьПривилегированныйРежим(Истина);
		
		ЗначениеОбъект = Справочники[Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов()].СоздатьЭлемент();
		ЗначениеОбъект.Владелец           = ДопРеквизит;
		ЗначениеОбъект.Наименование       = НСтр("ru = 'Акция'");
		ЗначениеОбъект.ПолноеНаименование = ЗначениеОбъект.Наименование;
		
		ЗначениеОбъект.Записать();

		ЗначениеОбъект = Справочники[Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов()].СоздатьЭлемент();
		ЗначениеОбъект.Владелец           = ДопРеквизит;
		ЗначениеОбъект.Наименование       = НСтр("ru = 'Новинка'");
		ЗначениеОбъект.ПолноеНаименование = ЗначениеОбъект.Наименование;
		
		ЗначениеОбъект.Записать();		

		ЗначениеОбъект = Справочники[Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов()].СоздатьЭлемент();
		ЗначениеОбъект.Владелец           = ДопРеквизит;
		ЗначениеОбъект.Наименование       = НСтр("ru = 'Хит'");
		ЗначениеОбъект.ПолноеНаименование = ЗначениеОбъект.Наименование;
		
		ЗначениеОбъект.Записать();
	КонецЕсли;								
	
	Возврат ДопРеквизит; 

КонецФункции

