#Область ПрограммныйИнтерфейс

Функция ОбъектМетаданныхУчаствуетВОбмене(ПолноеИмяОМ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	Если СписокВитрин.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПолноеИмяОМ = Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолноеИмя() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого СтрокаСпискаВитрин Из СписокВитрин Цикл
		Если СтрокаСпискаВитрин.Ключ = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
			Продолжить;
		КонецЕсли;
		
		СписокИменОМ = Маг1СИнтеграцияСлужебный.ПрочитатьСписокИменОМВРеквизитахСвойств(
													СтрокаСпискаВитрин.Значение.ИдентификаторВитрины); 	
													
		Если СписокИменОМ.Найти(ПолноеИмяОМ) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ложь;
КонецФункции

Функция УзлыОбменаСВитринами() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	УзлыОбмена = Новый Массив;	
	
	Для Каждого КлючЗначение из СписокВитрин Цикл
				
		УзелОбмена = КлючЗначение.Значение.УзелОбмена;
		
		Если УзелОбмена = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(УзелОбмена) Тогда
			Продолжить;
		КонецЕсли;
		
		УзлыОбмена.Добавить(УзелОбмена);																		
		
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат УзлыОбмена;

КонецФункции

Функция ДопСвойствоРегистрацииИзменений(УзелОбмена) Экспорт

	НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(УзелОбмена);
	
	Если НастройкиВитрины = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Маг1СИнтеграция.ДопСвойствоMag1c(Маг1СПеречисления.ДопСвойства_РегистрацияИзмененийДля(),
											НастройкиВитрины);
	
КонецФункции

