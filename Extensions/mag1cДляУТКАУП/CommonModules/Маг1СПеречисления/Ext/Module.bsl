Функция СостоянияИнвайтаПредставление(Состояние) Экспорт
	Если Состояние = СостоянияИнвайта_НеПередан() Тогда
		Возврат НСтр("ru = 'Ожидается передача инвайта на витрину'");
		
	ИначеЕсли Состояние = СостоянияИнвайта_НеЗарегистрирован() Тогда
		Возврат НСтр("ru = 'Ожидается регистрация покупателя'");
		
	ИначеЕсли Состояние = СостоянияИнвайта_Зарегистрирован() Тогда
		Возврат НСтр("ru = 'Покупатель зарегистрировался'");
		
	ИначеЕсли Состояние = СостоянияИнвайта_ДоступЗапрещен() Тогда
		Возврат НСтр("ru = 'Доступ к витрине запрещен'");
		
	ИначеЕсли Состояние = СостоянияИнвайта_НеПолучен() Тогда
		Возврат НСтр("ru = 'Покупатель не загружен с витрины'");
		
	Иначе
		Возврат НСтр("ru = 'Неизвестное состояние'");
	КонецЕсли;
КонецФункции

Функция СостоянияИнвайтаПорядок() Экспорт
	
	Массив = Новый Массив();
	Массив.Добавить(СостоянияИнвайта_НеПередан());
	Массив.Добавить(СостоянияИнвайта_НеЗарегистрирован());
	Массив.Добавить(СостоянияИнвайта_Зарегистрирован());
	Массив.Добавить(СостоянияИнвайта_ДоступЗапрещен());
	Массив.Добавить(СостоянияИнвайта_НеПолучен());

	Возврат Массив;
КонецФункции

