		Возврат 7*1440;	
	ИначеЕсли СрокДействияВременнойСсылки = СрокиДействияВременныхСсылок_14Дней() Тогда
		Возврат 14*1440;	
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестное значение'");
	КонецЕсли;
	
