Функция СостоянияВитриныПредставление(Состояние) Экспорт
	Если Состояние = СостоянияВитрины_Ready() Тогда
		Возврат НСтр("ru = 'Работает'");
		
	ИначеЕсли Состояние = СостоянияВитрины_Blocked() Тогда
		Возврат НСтр("ru = 'Заблокирована'");
		
	ИначеЕсли Состояние = СостоянияВитрины_Deferred() Тогда
		Возврат НСтр("ru = 'Ожидание создания'");
		
	ИначеЕсли Состояние = СостоянияВитрины_Suspended() Тогда
		Возврат НСтр("ru = 'В архиве'");
		
	ИначеЕсли Состояние = СостоянияВитрины_Error() Тогда
		Возврат НСтр("ru = 'Ошибка'");
		
	ИначеЕсли Состояние = СостоянияВитрины_Deleted() Тогда
		Возврат НСтр("ru = 'Удалена'");
		
	Иначе
		Возврат НСтр("ru = 'Неизвестное состояние'");
	КонецЕсли;
КонецФункции

