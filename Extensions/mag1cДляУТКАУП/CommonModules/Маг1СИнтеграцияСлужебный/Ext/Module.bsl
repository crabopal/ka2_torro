	Результат.Вставить("ОграничениеТипа", Неопределено);
	Результат.Вставить("Значение",        Неопределено);
	Результат.Вставить("ПараметрыВыбора", Новый Массив);
	// Отображение поля ввода в форме мастера создания витрины.
	Результат.Вставить("Заголовок",            "");
	Результат.Вставить("РасширеннаяПодсказка", "");
	Результат.Вставить("Реквизиты", Новый Структура);
	Результат.Вставить("Соответствие", Новый Структура);

