Функция ПрочитатьНеобходимостьНовогоЗапускаОбновленияНастроекВитрин() Экспорт
	
	Если Не ПрочитатьНеобходимостьОбновленияНастроекВитрин() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ДатаВремяЗапуска = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_.ЗапущеноОбновлениеНастроекВитрин");
	
	ТекущаяУниверсальнаяДата = ТекущаяУниверсальнаяДата();
	
	Если (ТипЗнч(ДатаВремяЗапуска) = Тип("Дата")
			И ТекущаяУниверсальнаяДата - ДатаВремяЗапуска > 150) 
		Или ТипЗнч(ДатаВремяЗапуска) <> Тип("Дата") Тогда 
		
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_.ЗапущеноОбновлениеНастроекВитрин", ТекущаяУниверсальнаяДата);
		Возврат Истина;
	Иначе
		
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Функция ПрочитатьСостояниеМастераНастройкиВитрины(ИдентификаторВитрины) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	СостояниеМастера = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".НастройкиВитрины");
	Если СостояниеМастера <> Неопределено Тогда
		ИсправитьНастройки(СостояниеМастера.НастройкиВитрины);
		Обработки.Маг1СОбмен.ОбновитьНастройкиXDTOКорреспондента(СостояниеМастера.НастройкиВитрины);	
		
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СостояниеМастера;
	
КонецФункции

Функция ПрочитатьСистемныеНастройки() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	СистемныеНастройки = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_.СистемныеНастройки");
	Если СистемныеНастройки = Неопределено Тогда
		СистемныеНастройки = СтруктураСистемныхНастроек();
	КонецЕсли;
	
	СистемныеНастройки = ИсправитьСистемныеНастройки(СистемныеНастройки);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СистемныеНастройки;
КонецФункции

Функция ИсправитьСистемныеНастройки(СистемныеНастройки)
	
	Результат = Новый Структура;
	ПустаяСтруктура = СтруктураСистемныхНастроек();
	
	ЕстьИзменения = СистемныеНастройки.Количество() <> ПустаяСтруктура.Количество();
	
	Для Каждого КлючЗначение из ПустаяСтруктура Цикл
		Если Не СистемныеНастройки.Свойство(КлючЗначение.Ключ) Тогда
			Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			ЕстьИзменения = Истина;
		Иначе
			Результат.Вставить(КлючЗначение.Ключ, СистемныеНастройки[КлючЗначение.Ключ]);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Результат.ПарольСлужебногоПользователя) Тогда
		ЕстьИзменения = Истина;
		ОписаниеПользователя = СлужебныйПользовательИБ(Истина);
		Результат.ПарольСлужебногоПользователя = ОписаниеПользователя.Пароль; 
		Результат.ИмяСлужебногоПользователя    = ОписаниеПользователя.Имя;
	КонецЕсли;
	
	Если ЕстьИзменения Тогда
		ЗаписатьСистемныеНастройки(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьСистемныеНастройки(СистемныеНастройки) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_.СистемныеНастройки", СистемныеНастройки);
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции

Процедура УдалитьНастройкиВитрины(ИдентификаторВитрины = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИдентификаторВитрины <> Неопределено Тогда
		ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	Иначе
		ИдентификаторНастройки = Неопределено; 
	КонецЕсли;
	
	ВсеНастройки = МассивВсехНастроек(ИдентификаторВитрины);
	
	Для Каждого ИмяНастройки из ВсеНастройки Цикл
		Если СтрНайти(ИмяНастройки, "Маг1С_") > 0 Тогда
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ИмяНастройки);
		КонецЕсли;
	КонецЦикла;
	
	Если ИдентификаторНастройки <> Неопределено Тогда
		СписокВитрин = ПрочитатьСписокВитринБазы();
		
		Если СписокВитрин.Свойство(ИдентификаторНастройки) Тогда
			СписокВитрин.Удалить(ИдентификаторНастройки);
			ЗаписатьСписокВитринБазы(СписокВитрин);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ВерсияРасширения() Экспорт
	Возврат Метаданные.Обработки.Маг1СОбмен.РасширениеКонфигурации().Версия;
КонецФункции

#Область СлепкиДанных

Процедура СохранитьСлепокДанных(ИдентификаторВитрины, ИмяСлепка, Данные, НомерСообщенияОбмена) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	
	СтруктураХранения = Новый Структура;
	СтруктураХранения.Вставить("Данные", Данные);
	СтруктураХранения.Вставить("НомерСообщенияОбмена", НомерСообщенияОбмена);
	
	СтруктураИнформации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки) + ИмяСлепка);
	
	Если ТипЗнч(СтруктураИнформации) <> Тип("Структура")
		Или Не СтруктураИнформации.Свойство("ПодтвержденныйСлепок") Тогда
		
		СтруктураИнформации = Новый Структура; 
		СтруктураИнформации.Вставить("ПодтвержденныйСлепок", "");
		СтруктураИнформации.Вставить("НомерСообщенияОбменаА", 0);
		СтруктураИнформации.Вставить("НомерСообщенияОбменаБ", 0);
		
	КонецЕсли;
	
	
	Если СтруктураИнформации.ПодтвержденныйСлепок = "Б"
		Или СтруктураИнформации.ПодтвержденныйСлепок = "" Тогда
		ИмяСлепкаДляЗаписи = ИмяСлепка + "А";
		СтруктураИнформации.НомерСообщенияОбменаА = НомерСообщенияОбмена;
	Иначе
		ИмяСлепкаДляЗаписи = ИмяСлепка + "Б";
		СтруктураИнформации.НомерСообщенияОбменаБ = НомерСообщенияОбмена;
	КонецЕсли;
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ПрефиксИмениСлепка(ИдентификаторНастройки) + ИмяСлепкаДляЗаписи, СтруктураХранения);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки) + ИмяСлепка, СтруктураИнформации);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПодтвердитьЗагрузкуВсехСлепковДанных(ИдентификаторВитрины, НомерСообщенияОбмена) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВсеСлепки = МассивВсехНастроек(ИдентификаторВитрины, Истина);
	
	Для Каждого ИмяСлепка из ВсеСлепки Цикл
		ПодтвердитьЗагрузкуСлепкаДанных(ИдентификаторВитрины, ИмяСлепка, НомерСообщенияОбмена);
	КонецЦикла;	
	
КонецПроцедуры

Процедура ПодтвердитьЗагрузкуСлепкаДанных(ИдентификаторВитрины, ИмяСлепка, НомерСообщенияОбмена)
	
	УстановитьПривилегированныйРежим(Истина);
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 

	СтруктураИнформации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки) + ИмяСлепка);
	
	Если ТипЗнч(СтруктураИнформации) <> Тип("Структура")
		Или Не СтруктураИнформации.Свойство("ПодтвержденныйСлепок") Тогда
		
		СтруктураИнформации = Новый Структура; 
		СтруктураИнформации.Вставить("ПодтвержденныйСлепок", "");
		СтруктураИнформации.Вставить("НомерСообщенияОбменаА", 0);
		СтруктураИнформации.Вставить("НомерСообщенияОбменаБ", 0);
		
	КонецЕсли;
	
	Если СтруктураИнформации.ПодтвержденныйСлепок = "Б"
		Или СтруктураИнформации.ПодтвержденныйСлепок = "" Тогда
		
		Если СтруктураИнформации.НомерСообщенияОбменаА = НомерСообщенияОбмена Тогда
			СтруктураИнформации.ПодтвержденныйСлепок = "А";	
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли СтруктураИнформации.ПодтвержденныйСлепок = "А" Тогда
		
		Если СтруктураИнформации.НомерСообщенияОбменаБ = НомерСообщенияОбмена Тогда
			СтруктураИнформации.ПодтвержденныйСлепок = "Б";	
		Иначе
			Возврат;
		КонецЕсли;

	КонецЕсли;
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки) + ИмяСлепка, СтруктураИнформации);
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура УдалитьВсеСлепкиДанных(ИдентификаторВитрины) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ВсеСлепки = МассивВсехНастроек(ИдентификаторВитрины, Истина);
	
	Для Каждого ИмяСлепка из ВсеСлепки Цикл
		УдалитьСлепокДанных(ИдентификаторВитрины, ИмяСлепка);
	КонецЦикла;
	
КонецПроцедуры
	
Процедура УдалитьСлепокДанных(ИдентификаторВитрины, ИмяСлепка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ПрефиксИмениСлепка(ИдентификаторНастройки) + ИмяСлепка + "А");
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ПрефиксИмениСлепка(ИдентификаторНастройки) + ИмяСлепка + "Б");
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки) + ИмяСлепка);
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПрочитатьСлепокДанных(ИдентификаторВитрины, ИмяСлепка) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	СтруктураИнформации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки) + ИмяСлепка);
	
	Если ТипЗнч(СтруктураИнформации) <> Тип("Структура")
		Или Не СтруктураИнформации.Свойство("ПодтвержденныйСлепок") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтруктураИнформации.ПодтвержденныйСлепок = "А" Тогда
		ИмяСлепкаДляЧтения   = ИмяСлепка + "А";
		НомерСообщенияСлепка = СтруктураИнформации.НомерСообщенияОбменаА;
	ИначеЕсли СтруктураИнформации.ПодтвержденныйСлепок = "Б" Тогда 
		ИмяСлепкаДляЧтения   = ИмяСлепка + "Б";
		НомерСообщенияСлепка = СтруктураИнформации.НомерСообщенияОбменаБ;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураХранения = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ПрефиксИмениСлепка(ИдентификаторНастройки) + ИмяСлепкаДляЧтения);
	
	Если ТипЗнч(СтруктураХранения) <> Тип("Структура") Тогда
		Возврат Неопределено;
	ИначеЕсли НомерСообщенияСлепка <> СтруктураХранения.НомерСообщенияОбмена Тогда
		Возврат Неопределено;
	Иначе
		Возврат СтруктураХранения.Данные;
	КонецЕсли;
	
КонецФункции

Функция ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки)
	Возврат "Маг1С_" + ИдентификаторНастройки + ".ПодтвержениеСлепка.";
КонецФункции

Функция ПрефиксИмениСлепка(ИдентификаторНастройки)
	Возврат "Маг1С_" + ИдентификаторНастройки + ".Слепок.";
КонецФункции

Процедура ОбновитьХранениеСлепков(ИдентификаторВитрины)
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 

	ВсеНастройки = МассивВсехНастроек(ИдентификаторВитрины);
	
	Префикс = "Маг1С_" + ИдентификаторНастройки + ".СлепокДанных.";
	
	Для Каждого СтрМас из ВсеНастройки Цикл
		Если СтрНайти(СтрМас, Префикс) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяСлепка = СтрЗаменить(СтрМас,Префикс,"");	
		ОбновитьХранениеСлепка(ИдентификаторВитрины, ИмяСлепка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьХранениеСлепка(ИдентификаторВитрины, ИмяСлепка)
    УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	
	СтруктураИнформацииБыло = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".ПодтвержениеСлепкаДанных." + ИмяСлепка);
	СтруктураХранения = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".СлепокДанных." + ИмяСлепка);
	
	Если ТипЗнч(СтруктураИнформацииБыло) <> Тип("Структура") 
		Или Не СтруктураИнформацииБыло.Свойство("Статус")
		Или Не СтруктураИнформацииБыло.Свойство("НомерСообщенияОбмена")
		Или ТипЗнч(СтруктураХранения) <> Тип("Структура")
		Или Не СтруктураХранения.Свойство("НомерСообщенияОбмена") 
		Или СтруктураИнформацииБыло.НомерСообщенияОбмена <> СтруктураХранения.НомерСообщенияОбмена Тогда
		
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".ПодтвержениеСлепкаДанных." + ИмяСлепка);
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".СлепокДанных." + ИмяСлепка);
		
		Возврат;
	КонецЕсли;
	
	СтруктураИнформации = Новый Структура;
	Если СтруктураИнформацииБыло.Статус <> "Подтверждено" Тогда 
		СтруктураИнформации.Вставить("ПодтвержденныйСлепок", "");
	Иначе
		СтруктураИнформации.Вставить("ПодтвержденныйСлепок", "А");
	КонецЕсли;	
	
	СтруктураИнформации.Вставить("НомерСообщенияОбменаА", СтруктураИнформацииБыло.НомерСообщенияОбмена);
	СтруктураИнформации.Вставить("НомерСообщенияОбменаБ", 0);
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ПрефиксИмениСлепка(ИдентификаторНастройки) + ИмяСлепка + "А", СтруктураХранения);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки) + ИмяСлепка, СтруктураИнформации);
	
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".ПодтвержениеСлепкаДанных." + ИмяСлепка);
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".СлепокДанных." + ИмяСлепка);

КонецПроцедуры

#КонецОбласти

Функция ПрочитатьСписокВитринБазы() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	СписокВитринБазы = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_.СписокВитринБазы");
	
	ПустаяСтруктура = Маг1СИнтеграцияСлужебныйКлиентСервер.СтрокаСпискаВитрин();
	
	НужноЗаписать              = Ложь;
	СписокВитринБылИзХранилища = Неопределено;
	
	Если СписокВитринБазы = Неопределено Тогда
		Возврат Новый Структура;
	Иначе
		Для каждого КлючЗначение Из СписокВитринБазы Цикл
			НужноИсправить = Ложь;
			
			Для Каждого ПолеСтруктуры из ПустаяСтруктура Цикл
				Если Не КлючЗначение.Значение.Свойство(ПолеСтруктуры.Ключ) Тогда
					НужноИсправить = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НужноИсправить Тогда
				
				СостояниеМастераДляНастройки = Маг1СИнтеграцияСлужебный.ПрочитатьСостояниеМастераНастройкиВитрины(КлючЗначение.Значение.ИдентификаторВитрины);
				Если СостояниеМастераДляНастройки = Неопределено Тогда 
					Продолжить;
				КонецЕсли;
				НастройкиВитрины = СостояниеМастераДляНастройки.НастройкиВитрины;
				
				НоваяСтрока = Маг1СИнтеграцияСлужебныйКлиентСервер.СтрокаСпискаВитрин(НастройкиВитрины);
				
				Для Каждого ПолеСтруктуры из НоваяСтрока Цикл
					Если Не КлючЗначение.Значение.Свойство(ПолеСтруктуры.Ключ) Тогда
						КлючЗначение.Значение.Вставить(ПолеСтруктуры.Ключ, ПолеСтруктуры.Значение);
						НужноЗаписать = Истина;
					КонецЕсли;
				КонецЦикла;
				
				Если СписокВитринБылИзХранилища = Неопределено Тогда
					СписокВитринБылИзХранилища = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(КлючЗначение.Значение);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если НужноЗаписать Тогда
		ЗаписатьСписокВитринБазы(СписокВитринБазы, СписокВитринБылИзХранилища);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СписокВитринБазы;
КонецФункции

Процедура ЗаписатьСписокВитринБазы(СписокВитринБазы, СписокВитринБылИзХранилища = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если СписокВитринБылИзХранилища = Неопределено Тогда
		СписокВитринБылИзХранилища = ПрочитатьСписокВитринБазы();
	КонецЕсли;
	
	Если СписокВитринБылИзХранилища = Неопределено Тогда
		СписокВитринБыл = Новый Структура;
	Иначе
		СписокВитринБыл = СписокВитринБылИзХранилища;
	КонецЕсли;
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктурыРавны(СписокВитринБазы, СписокВитринБыл) Тогда
		Возврат;
	КонецЕсли;
	
	УдаляемыеИдентификаторыВитрин =  Новый Массив;
	
	Если СписокВитринБазы.Количество() <> СписокВитринБыл.Количество() Тогда
		ИзменилисьУзлы = Истина;
		
		Если СписокВитринБазы.Количество() > СписокВитринБыл.Количество() Тогда 
			НовыеСтроки      = Новый Соответствие;
			УдаленныеВитрины = Новый Массив;
			
			Для Каждого КлючЗначение из СписокВитринБазы Цикл 
				Если Не СписокВитринБыл.Свойство(КлючЗначение.Ключ) Тогда
					НовыеСтроки.Вставить(КлючЗначение.Значение.Организация, КлючЗначение.Значение);
				КонецЕсли;
				
				Если КлючЗначение.Значение.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c()
					И КлючЗначение.Значение.Состояние = Маг1СПеречисления.СостоянияВитрины_Deleted() Тогда
					УдаленныеВитрины.Добавить(КлючЗначение.Значение);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого СтрМас из УдаленныеВитрины Цикл
				Если НовыеСтроки.Получить(СтрМас.Организация) <> Неопределено Тогда
					СписокВитринБазы.Удалить(Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СтрМас.ИдентификаторВитрины)); 
	                УдаляемыеИдентификаторыВитрин.Добавить(СтрМас.ИдентификаторВитрины);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		ИзменилисьУзлы = Ложь;
		
		Для Каждого КлючЗначение из СписокВитринБазы Цикл
			
			Если СписокВитринБыл.Свойство(КлючЗначение.Ключ) Тогда
				Если КлючЗначение.Значение.УзелОбмена <> СписокВитринБыл[КлючЗначение.Ключ].УзелОбмена Тогда
					ИзменилисьУзлы = Истина;
					Прервать;
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(КлючЗначение.Значение.УзелОбмена) Тогда
					ИзменилисьУзлы = Истина;
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_.СписокВитринБазы", СписокВитринБазы);
	
	Для Каждого ИдентификаторВитрины из УдаляемыеИдентификаторыВитрин Цикл
		УдалитьНастройкиВитрины(ИдентификаторВитрины);	
	КонецЦикла;
	
	Если ИзменилисьУзлы Тогда
		ОбновитьПовторноИспользуемыеЗначения();	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура СохранитьВСпискеВитринБазы(НоваяСтрокаНастройки, ЗаменитьНастройкуНовой, СостояниеМастера = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПустаяСтрока(НоваяСтрокаНастройки.ИдентификаторИБ) Тогда
		ОписаниеКонфигурации = Обработки.Маг1СНастройка.ОписаниеКонфигурации();
		НоваяСтрокаНастройки.ИдентификаторИБ = ОписаниеКонфигурации.ИдентификаторИБ;
	КонецЕсли;
	
	Если ПустаяСтрока(НоваяСтрокаНастройки.ИдентификаторВитрины) Тогда
		КлючСпискаВитрин = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины();
	Иначе
		КлючСпискаВитрин = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(НоваяСтрокаНастройки.ИдентификаторВитрины);
	КонецЕсли;
	
	СписокВитринБазы = ПрочитатьСписокВитринБазы();
	СтрокаНастройки  = Неопределено;
	
	Если СписокВитринБазы.Количество() <> 0 Тогда
		СписокВитринБазы.Свойство(КлючСпискаВитрин, СтрокаНастройки);
		
		Если ЗаменитьНастройкуНовой
			И СписокВитринБазы.Свойство(Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины(), СтрокаНастройки) Тогда
			
			СписокВитринБазы.Удалить(Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины());
			
			Если СостояниеМастера <> Неопределено Тогда
															
				СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины = НоваяСтрокаНастройки.ИдентификаторВитрины;
				СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.АдресСайтаВитрины    = НоваяСтрокаНастройки.АдресСайтаВитрины;
				СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.ПолноеИмяВитрины     = НоваяСтрокаНастройки.ПолноеИмяВитрины;
			
				СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, Неопределено);
				
				ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища("Маг1С_" + Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() + ".НастройкиВитрины");
				
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;
	
	Если СтрокаНастройки = Неопределено Тогда
		ЕстьИзменения = Истина;
	Иначе	
		ЕстьИзменения = Не Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктурыРавны(СтрокаНастройки, НоваяСтрокаНастройки);
	КонецЕсли;	
	
	Если ЕстьИзменения Тогда
		СписокВитринБазы.Вставить(КлючСпискаВитрин, НоваяСтрокаНастройки);
		ЗаписатьСписокВитринБазы(СписокВитринБазы);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСвойствоЕслиПоменялось(Свойство, НовоеЗначение, ЕстьИзменения)
	Если Свойство <> НовоеЗначение Тогда
		Свойство = НовоеЗначение;
		ЕстьИзменения = Истина;
	КонецЕсли;
КонецПроцедуры

Функция КорректныйТокенАвторизации(ТокенАвторизации)
	Если ТипЗнч(ТокенАвторизации) = Тип("Структура") Тогда
		Если ТокенАвторизации.СрокДействия < ТекущаяУниверсальнаяДата() + 500 Тогда
			Возврат Неопределено 
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТокенАвторизации
КонецФункции

Функция МассивВсехНастроек(ИдентификаторВитрины, СоставитьСписокСлепковДанных = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИдентификаторВитрины <> Неопределено Тогда
		ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	Иначе
		ИдентификаторНастройки = Неопределено; 
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Если ОбщегоНазначения.РазделениеВключено() 
		И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		ИмяБезопасногоХранилищаДанных = "БезопасноеХранилищеДанныхОбластейДанных";
	Иначе
		ИмяБезопасногоХранилищаДанных = "БезопасноеХранилищеДанных";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БезопасноеХранилищеДанных.Владелец КАК Владелец
	|ИЗ
	|	РегистрСведений.ИмяБезопасногоХранилищаДанных КАК БезопасноеХранилищеДанных
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(БезопасноеХранилищеДанных.Владелец) = ТИП(СТРОКА)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяБезопасногоХранилищаДанных", ИмяБезопасногоХранилищаДанных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Префикс = ПрефиксИмениПодтвержденияСлепка(ИдентификаторНастройки);
	
	Пока Выборка.Следующий() Цикл
		Если СтрНайти(Выборка.Владелец, "Маг1С") > 0
			И (ИдентификаторНастройки = Неопределено
				Или СтрНайти(Выборка.Владелец, ИдентификаторНастройки) > 0) Тогда
				
			Если СоставитьСписокСлепковДанных Тогда
				
				Если СтрНайти(Выборка.Владелец, Префикс) = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ИмяСлепка = СтрЗаменить(Выборка.Владелец, Префикс, "");	
				Результат.Добавить(ИмяСлепка);
				
			Иначе
				Результат.Добавить(Выборка.Владелец);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция КлючПоЛогинуИПП(ЛогинИПП)
	Возврат "Л_" + СтрЗаменить( 
				   	СтрЗаменить(
				   		СтрЗаменить(Base64СтрокаИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(ЛогинИПП)), 
								"=", ""),
								"+", "00"),
								"/", "01");
КонецФункции

