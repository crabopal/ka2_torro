	Результат.Вставить("НаборДопСведений", Неопределено);
	Результат.Вставить("ИмяВидаКИ", "");
	Результат.Вставить("ПКО_Получение", "");
	Результат.Вставить("ПКО_Отправка", "");
	Результат.Вставить("ПОД_Отправка", "");

	Возврат Результат;
	
КонецФункции

