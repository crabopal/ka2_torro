Функция ПрочитатьСписокИменОМВРеквизитахСвойств(ИдентификаторВитрины) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	СписокИменОМ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".СписокИменОМВРеквизитахСвойств");
	УстановитьПривилегированныйРежим(Ложь);
	
	Если СписокИменОМ = Неопределено Тогда
		СписокИменОМ = Новый Массив;
	КонецЕсли;
	
	Возврат СписокИменОМ;
	
КонецФункции

Процедура СохранитьСписокИменОМВРеквизитахСвойств(ИдентификаторВитрины, СписокИменОМ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_" + ИдентификаторНастройки + ".СписокИменОМВРеквизитахСвойств", СписокИменОМ);
	
	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбновитьСписокИменОМВРеквизитахСвойств(НастройкиВитрины)
	ТекущийСписок = ПрочитатьСписокИменОМВРеквизитахСвойств(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
	
	НеКорректныеРеквизиты = Новый Массив;
	ЕстьИзменения         = Ложь;
	
	Добавилось = Ложь;
	
	НовыйСписок = Новый Массив;
	
	Для Каждого КлючЗначение из НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров Цикл
		
		НастройкаСвойства = КлючЗначение.Значение;
		ОписаниеСвойства = Маг1СИнтеграция.ОписаниеСвойства(КлючЗначение.Ключ);
		
		Если ОписаниеСвойства.Метаданные = Неопределено Тогда
			НеКорректныеРеквизиты.Добавить(КлючЗначение.Ключ);
			ЕстьИзменения = Истина;
		Иначе
			
			Если Не ОписаниеСвойства.ДоступноИспользованиеДляФильтра
				И НастройкаСвойства.ИспользоватьДляФильтра Тогда
				
				НастройкаСвойства.ИспользоватьДляФильтра = Ложь;
				ЕстьИзменения = Истина;
			КонецЕсли;
				
			Если ОписаниеСвойства.Метаданные <> "" Тогда
				Если НовыйСписок.Найти(ОписаниеСвойства.Метаданные.ПолноеИмя()) = Неопределено Тогда
					НовыйСписок.Добавить(ОписаниеСвойства.Метаданные.ПолноеИмя());
					
					Если ТекущийСписок.Найти(ОписаниеСвойства.Метаданные.ПолноеИмя()) = Неопределено Тогда
						Добавилось = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Для Каждого Реквизит из НеКорректныеРеквизиты Цикл
		НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров.Удалить(Реквизит);
	КонецЦикла;
	
	Если ЕстьИзменения Тогда
		Маг1СИнтеграция.ЗарегистрироватьНеобходимостьВыгрузкиОписанийСвойствТоваров(НастройкиВитрины);
	КонецЕсли;
	
	Удалилось = Ложь;
	
	Если Не Добавилось Тогда
		Если НовыйСписок.Количество() <> ТекущийСписок.Количество() Тогда
			Удалилось = Истина;
		Иначе
			Для Каждого СтрМас из ТекущийСписок Цикл
				Если НовыйСписок.Найти(СтрМас) = Неопределено Тогда
					Удалилось = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если Добавилось
		Или Удалилось Тогда
		
		СохранитьСписокИменОМВРеквизитахСвойств(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины, НовыйСписок);
		ОбновитьПовторноИспользуемыеЗначения();
		
	КонецЕсли;
	
КонецПроцедуры

