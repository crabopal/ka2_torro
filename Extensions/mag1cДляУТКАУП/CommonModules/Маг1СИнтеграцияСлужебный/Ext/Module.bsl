// Возвращаемое значение:
//   Структура:
//     * Организация - см. СтруктураЭлементаНастройкиУчетнойСистемы
//     * Склад - см. СтруктураЭлементаНастройкиУчетнойСистемы
//     * ВидЦен - см. СтруктураЭлементаНастройкиУчетнойСистемы
//     * УслугаДоставки - см. СтруктураЭлементаНастройкиУчетнойСистемы
//     * ИмяПланаОбмена - Строка
//     * ЕстьКартинкиТоваров - Булево
Функция СтруктураНастроекУчетнойСистемы() Экспорт
	
	Настройки = Новый Структура;
	
	// Общие настройки учета.
	Настройки.Вставить("Организация",    СтруктураЭлементаНастройкиУчетнойСистемы());
	Настройки.Вставить("Склад",          СтруктураЭлементаНастройкиУчетнойСистемы());
	
	Настройки.Вставить("ВидЦен",         СтруктураЭлементаНастройкиУчетнойСистемы());
	
	Настройки.Вставить("УслугаДоставки", СтруктураЭлементаНастройкиУчетнойСистемы());
	Настройки.Вставить("НастройкаСБП",   СтруктураЭлементаНастройкиУчетнойСистемы());
	Настройки.Вставить("БанковскийСчет", СтруктураЭлементаНастройкиУчетнойСистемы());
	
	Настройки.Вставить("Номенклатура", СтруктураЭлементаНастройкиУчетнойСистемы());
	
	Настройки.Номенклатура.Реквизиты.Вставить("Описание", "");
	Настройки.Номенклатура.Реквизиты.Вставить("ОсновнаяКартинка", "");
	Настройки.Номенклатура.Реквизиты.Вставить("НаименованиеПолное", "");
	Настройки.Номенклатура.Реквизиты.Вставить("НаборСвойств", "");
	Настройки.Номенклатура.Реквизиты.Вставить("ВидНоменклатуры", "");
	
	Настройки.Номенклатура.Вставить("РеквизитыВладельцаХарактеристик", Новый Структура());

	Настройки.Вставить("ВидНоменклатуры", СтруктураЭлементаНастройкиУчетнойСистемы());	
	
	ИмяСправочникаНоменклатураКартинки = "НоменклатураПрисоединенныеФайлы";
	
	Настройки.Вставить("НоменклатураКартинки", СтруктураЭлементаНастройкиУчетнойСистемы());
	Настройки.НоменклатураКартинки.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + ИмяСправочникаНоменклатураКартинки);
    Настройки.НоменклатураКартинки.Значение = Справочники[ИмяСправочникаНоменклатураКартинки].ПустаяСсылка();
	
	Настройки.Вставить("ХарактеристикиНоменклатуры", СтруктураЭлементаНастройкиУчетнойСистемы());	
 	Настройки.ХарактеристикиНоменклатуры.Реквизиты.Вставить("НаименованиеПолное", "");


