#КонецОбласти

#Область ОбработкаПереходаНаНовуюВерсию

Процедура ОбработатьПереходНаНовуюВерсию(НастройкиВитрины, ВерсияДо) Экспорт
	
	Если ВерсияДо = Неопределено
		Или ПустаяСтрока(ВерсияДо) Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиВерсии = СтрРазделить(ВерсияДо,".");
	Если ЧастиВерсии.Количество() < 4 Тогда
		Возврат;
	Иначе
		Попытка
			ВерсияЧислом = Число(ЧастиВерсии[2]);
		Исключение
			Возврат;
		КонецПопытки;
		
		НужноОбновитьНастройки = Ложь;
		
		Если ВерсияЧислом < 225 Тогда
			ОбновитьХранениеСлепков(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
		КонецЕсли;
		
		Если ВерсияЧислом < 237 Тогда
			Если ПоменятьКодУзлаОбмена(НастройкиВитрины) Тогда
				НужноОбновитьНастройки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ВерсияЧислом < 280 Тогда
			ЗарегистрироватьНоменклатуруСоЗначкамиКОбмену(НастройкиВитрины);
		КонецЕсли;
		
		Если ВерсияЧислом < 333 Тогда
			Если ИсправитьСоцСети(НастройкиВитрины) Тогда
				НужноОбновитьНастройки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ВерсияЧислом < 333 Тогда
			Если ВключитьОплатыПоСсылке(НастройкиВитрины) Тогда
				НужноОбновитьНастройки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ВерсияЧислом < 384 Тогда
			УдалитьСлепкиЦен(НастройкиВитрины);
		КонецЕсли;
		
		Если ВерсияЧислом < 386 Тогда
			ЗарегистрироватьКОбменуВсеУпаковки(НастройкиВитрины);
		КонецЕсли;
		
		Если ВерсияЧислом < 404 Тогда
			// Нужно передать налогообложение НДС
			НужноОбновитьНастройки = Истина;
		КонецЕсли;
		
		Если ВерсияЧислом < 420 Тогда
			ОбновитьНастройкуВебЧата(НастройкиВитрины);
		КонецЕсли;
		
		Маг1СИнтеграцияПереопределяемый.ПриПереходеНаНовуюВерсию(НастройкиВитрины, ВерсияДо);
		
		Если НужноОбновитьНастройки Тогда
			СостояниеМастера = ПрочитатьСостояниеМастераНастройкиВитрины(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
			СостояниеМастера.НастройкиВитрины = НастройкиВитрины;
			СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, Неопределено);
			
			Маг1СИнтеграцияСлужебный.СохранитьНеобходимостьОбновленияНастроекВитрин();
			Маг1СИнтеграцияСлужебный.ОбновитьНастройкиВитринВФоне();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьНастройкуВебЧата(НастройкиВитрины)
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторИнтеграцииСтрока = Неопределено;
	НастройкиВитрины.ОсновныеНастройки.Свойство("WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия", ИдентификаторИнтеграцииСтрока);
	
	Если ЗначениеЗаполнено(ИдентификаторИнтеграцииСтрока) И МожноПодключатьВебЧат() Тогда
		Интеграция = ПолучитьИнтеграциюНаСервереПоСтрокеИдентификатора(ИдентификаторИнтеграцииСтрока);
		Если Интеграция <> Неопределено Тогда 
			Если Интеграция.ПараметрыВнешнейСистемы["displayCollapsedState"] <> Неопределено Тогда 
				Интеграция.ПараметрыВнешнейСистемы["displayCollapsedState"] = "false";
			КонецЕсли;
			Если Интеграция.ПараметрыВнешнейСистемы["displayCollapsedState"] <> Неопределено Тогда 
				Интеграция.ПараметрыВнешнейСистемы["openChatOnNewMessage"] = "false";
			КонецЕсли;
			Интеграция.Записать();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьИнтеграциюНаСервереПоСтрокеИдентификатора(WebChat_Идентификатор)
	Если WebChat_Идентификатор = Неопределено Или WebChat_Идентификатор = "" Тогда
		Возврат Неопределено;
	Иначе
		Интеграции = СистемаВзаимодействия.ПолучитьИнтеграции();
		Для Каждого Интеграция Из Интеграции Цикл
			Если Строка(Интеграция.Идентификатор) = WebChat_Идентификатор Тогда
				Возврат Интеграция;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ПоменятьКодУзлаОбмена(НастройкиВитрины)

	Если ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки.УзелОбмена)
		И ОбщегоНазначения.СсылкаСуществует(НастройкиВитрины.ОсновныеНастройки.УзелОбмена) Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		УзелОбъект = НастройкиВитрины.ОсновныеНастройки.УзелОбмена.ПолучитьОбъект();
		Если УзелОбъект.Код <> НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины Тогда
			
			УзелОбъект.Код = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
			УзелОбъект.ОбменДанными.Загрузка = Истина;

			УзелОбъект.Записать();
			Если Метаданные.РегистрыСведений.Найти("ОбщиеНастройкиУзловИнформационныхБаз") <> Неопределено Тогда
				
				Набор = РегистрыСведений["ОбщиеНастройкиУзловИнформационныхБаз"].СоздатьНаборЗаписей();
				
				Набор.Отбор.УзелИнформационнойБазы.Установить(УзелОбъект.Ссылка);
				Набор.Прочитать();
				
				Если Набор.Количество() > 0 Тогда
					Набор[0].ПрефиксКорреспондента = "";
					Набор.Записать();
				КонецЕсли;
				
			КонецЕсли;
			
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

Процедура ЗарегистрироватьНоменклатуруСоЗначкамиКОбмену(НастройкиВитрины)
	УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	Если Не ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерОтправленного");
	
	Для Каждого Описание из НастройкиВитрины.ОсновныеНастройки.ЗначкиНоменклатуры Цикл
		Маг1СИнтеграцияСлужебный.ЗарегистрироватьКОбмену(УзелОбмена, Описание.Значок, Ложь, НомерОтправленного); 
	КонецЦикла;
	
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Маг1СИнтеграция.СформироватьВТПубликуемаяНоменклатура(МенеджерВременныхТаблиц,
														  НастройкиФильтровНоменклатуры);
	
	
	Запрос                         = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =													  
	"ВЫБРАТЬ
	|	ВТПубликуемаяНоменклатура.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|		ПО ВТПубликуемаяНоменклатура.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
	|			И (НоменклатураДополнительныеРеквизиты.Свойство = &СвойствоЗначок)
	|			И (ТИПЗНАЧЕНИЯ(НоменклатураДополнительныеРеквизиты.Значение) = ТИП(Справочник.ЗначенияСвойствОбъектов)
	|				И НоменклатураДополнительныеРеквизиты.Значение <> ЗНАЧЕНИЕ(Справочник.ЗначенияСвойствОбъектов.ПустаяСсылка))";
	Запрос.УстановитьПараметр("СвойствоЗначок", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры());
	
	НоменклатураКРегистрации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
	Если НоменклатураКРегистрации.Количество() > 0 Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, НоменклатураКРегистрации);	
	КонецЕсли;
КонецПроцедуры

Функция ИсправитьСоцСети(НастройкиВитрины)
	
	ЕстьИсправления = Ложь;
	
	ИсправитьСоцСеть(НастройкиВитрины, "TelegramМагазина", ЕстьИсправления);
	ИсправитьСоцСеть(НастройкиВитрины, "TelegramКаналМагазина", ЕстьИсправления);
	ИсправитьСоцСеть(НастройкиВитрины, "VKМагазина", ЕстьИсправления);
	ИсправитьСоцСеть(НастройкиВитрины, "InstagramМагазина", ЕстьИсправления);
	ИсправитьСоцСеть(НастройкиВитрины, "FacebookМагазина", ЕстьИсправления);

	Возврат ЕстьИсправления;

КонецФункции

Процедура ИсправитьСоцСеть(НастройкиВитрины, ИмяНастройки, ЕстьИсправления)
	
	Если Не НастройкиВитрины.ОсновныеНастройки.Свойство(ИмяНастройки) Тогда
		 НастройкиВитрины.ОсновныеНастройки.Вставить(ИмяНастройки, "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки[ИмяНастройки]) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.ИмяПользователяСоцсетиСоотвествуетПравилам(НастройкиВитрины.ОсновныеНастройки[ИмяНастройки]) Тогда
		ЕстьИсправления = Истина;
		НастройкиВитрины.ОсновныеНастройки[ИмяНастройки] = ИсправитьИмяПользователяСоцСети(НастройкиВитрины.ОсновныеНастройки[ИмяНастройки]);
	КонецЕсли;
КонецПроцедуры

Функция ВключитьОплатыПоСсылке(НастройкиВитрины)
	ЕстьЮКасса = Ложь;
	ЕстьСБП    = Ложь;
	ЕстьПереводомНаСчет = Ложь;
	
	ОсновныеНастройки = НастройкиВитрины.ОсновныеНастройки;
	
	Для Каждого СпособДоставки из Маг1СПеречисления.СпособыДоставкиПорядок() Цикл
		НастройкаДоставки = ОсновныеНастройки.НастройкиДоставки[СпособДоставки];
		
		Если НастройкаДоставки.Использование Тогда
			Если НастройкаДоставки.ВариантыОплаты.ОнЛайнЧерезЮКассу Тогда
				ЕстьЮКасса = Истина;
			КонецЕсли;
			Если НастройкаДоставки.ВариантыОплаты.ОнЛайнЧерезСБП Тогда
				ЕстьСБП = Истина;
			КонецЕсли;
			Если НастройкаДоставки.ВариантыОплаты.ПереводомНаСчет Тогда
				ЕстьПереводомНаСчет = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЕстьПереводомНаСчет = ЕстьПереводомНаСчет
			И ОсновныеНастройки.СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_АвтоматическиНаВитрине();
	
	ОсновныеНастройки.ОплатаПоСсылкеПереводомНаСчет = ЕстьПереводомНаСчет;
	ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу     = ЕстьЮКасса;
	ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП        = ЕстьСБП;
	
	Возврат ЕстьПереводомНаСчет
			Или ЕстьЮКасса
			Или ЕстьСБП; 

КонецФункции

Функция УдалитьСлепкиЦен(НастройкиВитрины)
	ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	
	ВсеИменаСлепков = Маг1СИнтеграцияСлужебный.МассивВсехНастроек(ИдентификаторВитрины, Истина);
	
	Для Каждого ИмяСлепка из ВсеИменаСлепков Цикл
		
		Если СтрНайти(ИмяСлепка, "Цены") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Маг1СИнтеграцияСлужебный.УдалитьСлепокДанных(ИдентификаторВитрины, ИмяСлепка);
		
	КонецЦикла;
КонецФункции

Процедура ЗарегистрироватьКОбменуВсеУпаковки(НастройкиВитрины)
	
	УстановитьПривилегированныйРежим(Истина);
	
	УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	
	Если Не ЗначениеЗаполнено(УзелОбмена)
		Или Не ОбщегоНазначения.СсылкаСуществует(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебный.НастройкиУчетнойСистемы();
	
	ИмяСправочникаУпаковок = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Упаковки());
	
	Если ПустаяСтрока(ИмяСправочникаУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	
	ВсеВидыЦен = Маг1СИнтеграция.ВсеИспользуемыеВидыЦен(НастройкиВитрины);
	
	ВсеУпаковки = Новый Массив;
	
	Для Каждого ВидЦены из ВсеВидыЦен Цикл
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		
		Маг1СИнтеграция.СформироватьВТЦены(МенеджерВТ,
											НастройкиФильтровНоменклатуры,
											НастройкиВитрины,
											ВидЦены);
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ; 
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТЦены.Упаковка КАК Упаковка
		|ИЗ
		|	ВТЦены КАК ВТЦены
		|ГДЕ
		|	ВТЦены.Упаковка <> НЕОПРЕДЕЛЕНО";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Упаковка) Тогда
				ВсеУпаковки.Добавить(Выборка.Упаковка);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка КАК Упаковка
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
	|ГДЕ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка ССЫЛКА Справочник.ИмяСправочникаУпаковок
	|	И ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаУпаковок", ИмяСправочникаУпаковок);
	
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", УзелОбмена);
	
	Запрос.Текст = ТекстЗапроса; 
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Упаковка) Тогда
			ВсеУпаковки.Добавить(Выборка.Упаковка);
		КонецЕсли;
	КонецЦикла;
	
	Если ВсеУпаковки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СправочникУпаковок.Ссылка КАК Упаковка
	|ИЗ
	|	Справочник.ИмяСправочникаУпаковок КАК СправочникУпаковок
	|ГДЕ
	|	СправочникУпаковок.Ссылка В(&ВсеУпаковки)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаУпаковок", ИмяСправочникаУпаковок);
	Запрос.УстановитьПараметр("ВсеУпаковки", ВсеУпаковки);
	Запрос.Текст = ТекстЗапроса; 
	ВсеУпаковки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Упаковка");
	
	Если ВсеУпаковки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерОтправленного");
	
	Если Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена("Справочник." + ИмяСправочникаУпаковок) Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ВсеУпаковки); 
	Иначе
		Маг1СИнтеграция.ЗарегистрироватьНеобходимостьВыгрузкиДополнительныхДанных(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																					Маг1СПеречисления.ИменаСправочников_Упаковки(),
																					ВсеУпаковки,
																					НомерОтправленного);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПодписокНаСобытия
 
Процедура Маг1С_ПередЗаписьюСправочников(Источник, Отказ) Экспорт
		
	Источник.ДополнительныеСвойства.Вставить("Маг1С_ОбъектИзменен", Ложь);
	Источник.ДополнительныеСвойства.Вставить("Маг1С_ЭтоНовый", Источник.ЭтоНовый());
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка 
		Или Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("Маг1с_ЭтоПолучениеДопСвойства") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
			
	УзлыОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.УзлыОбменаСВитринами();
		
	Если УзлыОбмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗнчИсточник = ТипЗнч(Источник);
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ИмяСправочникаФайлы = "СправочникОбъект." + Маг1СПеречисления.ИменаСправочников_Файлы();
	ИмяСправочникаНаборыДополнительныхРеквизитовИСведений = "СправочникОбъект." + Маг1СПеречисления.ИменаСправочников_НаборыДополнительныхРеквизитовИСведений();
	ИмяСправочникаНоменклатура = "СправочникОбъект." + Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());
	ИмяСправочникаНоменклатураКартинки   = 
		"СправочникОбъект." + Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	
	ИмяСправочникаХарактеристики = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
	
	ИмяСправочникаХарактеристикиКартинки = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	Если Не ПустаяСтрока(ИмяСправочникаХарактеристикиКартинки) Тогда
		ИмяСправочникаХарактеристикиКартинки = "СправочникОбъект." + ИмяСправочникаХарактеристикиКартинки;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип(ИмяСправочникаНаборыДополнительныхРеквизитовИСведений) Тогда
		Маг1С_ПередЗаписьюНабораДопРеквизитов(Источник, Отказ);
	ИначеЕсли ТипЗнчИсточник = Тип(ИмяСправочникаФайлы)
		Или ТипЗнчИсточник = Тип(ИмяСправочникаНоменклатураКартинки)
		Или (Не ПустаяСтрока(ИмяСправочникаХарактеристикиКартинки)
			И ТипЗнчИсточник = Тип(ИмяСправочникаХарактеристикиКартинки))Тогда
		
		Возврат;
	ИначеЕсли ТипЗнчИсточник = Тип(ИмяСправочникаНоменклатура) Тогда
		
		Маг1СИнтеграция.ПередЗаписьюНоменклатуры(Источник);
	ИначеЕсли (Не ПустаяСтрока(ИмяСправочникаХарактеристики)
              	И ТипЗнчИсточник = Тип("СправочникОбъект." + ИмяСправочникаХарактеристики)) Тогда
	Иначе
		Если Источник.ЭтоНовый() Тогда
			Возврат;
		КонецЕсли;
		
		Если Не Маг1СИнтеграцияСлужебныйПовтИсп.ОбъектМетаданныхУчаствуетВОбмене(Источник.Метаданные().ПолноеИмя()) Тогда
			Возврат;
		КонецЕсли;

		Источник.ДополнительныеСвойства.Маг1С_ОбъектИзменен =
		 	Источник.Наименование <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Наименование");
	КонецЕсли;
	
КонецПроцедуры

Процедура Маг1С_ПриЗаписиСправочников(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка
		Или Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("Маг1с_ЭтоПолучениеДопСвойства") Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	
	ТипЗнчИсточник = ТипЗнч(Источник);
		
	УзлыОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.УзлыОбменаСВитринами();
	
	Если УзлыОбмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСправочникаФайлы = "СправочникОбъект.Файлы"; 
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ИмяСправочникаНоменклатураКартинки  =  Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	ИмяСправочникаХарактеристикиКартинки = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	ИмяСправочникаНоменклатура = "СправочникОбъект." + Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());

	ИмяСправочникаХарактеристики = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
	
	ИмяСправочникаНастройкиЮКассы = "";
	
	Если Метаданные.Справочники.Найти("НастройкиОнлайнОплат") <> Неопределено Тогда
		ИмяСправочникаНастройкиЮКассы = "СправочникОбъект.НастройкиОнлайнОплат";
	ИначеЕсли Метаданные.Справочники.Найти("НастройкиЯндексКассы") <> Неопределено Тогда
	    ИмяСправочникаНастройкиЮКассы = "СправочникОбъект.НастройкиЯндексКассы";
	КонецЕсли;
		
	Если ТипЗнчИсточник = Тип(ИмяСправочникаНоменклатура) Тогда

		Маг1СИнтеграция.ПриЗаписиНоменклатуры(Источник);
		
	ИначеЕсли (Не ПустаяСтрока(ИмяСправочникаХарактеристики)
				И ТипЗнчИсточник = Тип("СправочникОбъект." + ИмяСправочникаХарактеристики)) Тогда
				
		Маг1СИнтеграция.ПриЗаписиХарактеристики(Источник);

	ИначеЕсли ТипЗнчИсточник = Тип(ИмяСправочникаФайлы) Тогда
		
		Если Источник.ДополнительныеСвойства.Маг1С_ЭтоНовый Тогда
			Возврат;	
		КонецЕсли;
	
		Если Не Маг1СИнтеграция.ЭтоКартинка(Источник.Расширение) Тогда
			Возврат;	
		КонецЕсли;
		
		ЗарегистрироватьНаУзлахСКоторымиБылОбмен(Источник.Ссылка, Источник.Ссылка, Ложь);
		
		Если Источник.ПометкаУдаления Тогда
			Маг1СИнтеграция.ОтвязатьФайлОтКатегории(Источник.Ссылка)
		КонецЕсли;
	ИначеЕсли ТипЗнчИсточник = Тип("СправочникОбъект." + ИмяСправочникаНоменклатураКартинки) Тогда
		
		Если Не Маг1СИнтеграция.ЭтоКартинка(Источник.Расширение) Тогда
			Возврат;	
		КонецЕсли;
		
		НаПланеОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена("Справочник." + ИмяСправочникаНоменклатураКартинки);
		
		Если Источник.ДополнительныеСвойства.Маг1С_ЭтоНовый Тогда
			ЗарегистрироватьНаУзлахСКоторымиБылОбмен(Источник.ВладелецФайла, Источник.Ссылка, НаПланеОбмена)	
		Иначе
			ЗарегистрироватьНаУзлахСКоторымиБылОбмен(Источник.Ссылка, Источник.Ссылка, НаПланеОбмена)	
		КонецЕсли;
		
	ИначеЕсли Не ПустаяСтрока(ИмяСправочникаХарактеристикиКартинки)
			И ТипЗнчИсточник = Тип("СправочникОбъект." + ИмяСправочникаХарактеристикиКартинки) Тогда
				
		Если Не Маг1СИнтеграция.ЭтоКартинка(Источник.Расширение) Тогда
			Возврат;	
		КонецЕсли;
		
		НаПланеОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена("Справочник." + ИмяСправочникаХарактеристикиКартинки);
		
		Если Источник.ДополнительныеСвойства.Маг1С_ЭтоНовый Тогда
			ЗарегистрироватьНаУзлахСКоторымиБылОбмен(Источник.ВладелецФайла, Источник.Ссылка, НаПланеОбмена)	
		Иначе
			ЗарегистрироватьНаУзлахСКоторымиБылОбмен(Источник.Ссылка, Источник.Ссылка, НаПланеОбмена)	
		КонецЕсли;
		
	ИначеЕсли Не ПустаяСтрока(ИмяСправочникаНастройкиЮКассы)
		И ТипЗнчИсточник = Тип(ИмяСправочникаНастройкиЮКассы) Тогда
		
		Маг1СИнтеграцияСлужебный.СохранитьНеобходимостьОбновленияНастроекВитрин();	
		Маг1СИнтеграцияСлужебный.ОбновитьНастройкиВитринВФоне();
	ИначеЕсли ТипЗнчИсточник = Тип("СправочникОбъект." + Маг1СПеречисления.ИменаСправочников_НаборыДополнительныхРеквизитовИСведений()) Тогда
		
		Маг1С_ПриЗаписиНабораДопРеквизитов(Источник, Отказ);
	Иначе
		Если Не Источник.ДополнительныеСвойства.Маг1С_ОбъектИзменен Тогда
			Возврат;
		КонецЕсли;
		ЗарегистрироватьНаУзлахСКоторымиБылОбмен(Источник.Ссылка, Источник.Ссылка, Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура Маг1С_ПВХДопРеквизитыПриЗаписи(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("Маг1с_ЭтоПолучениеДопСвойства") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокНастроекВитрин = Маг1СИнтеграция.СписокНастроекВитрин();
	
	Если СписокНастроекВитрин.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СписокНастроекВитрин Цикл
		
		Если КлючЗначение.Ключ = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиВитрины = КлючЗначение.Значение;
		
		ВыгружаемыеСвойстваТоваров = НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров;
		
		Если ВыгружаемыеСвойстваТоваров.Получить(Источник.Ссылка) <> Неопределено Тогда
			Маг1СИнтеграция.ЗарегистрироватьНеобходимостьВыгрузкиОписанийСвойствТоваров(НастройкиВитрины);
		КонецЕсли;
					
	КонецЦикла;
	
КонецПроцедуры

Процедура Маг1С_ПередЗаписьюНабораДопРеквизитов(Источник, Отказ)
	Источник.ДополнительныеСвойства.Вставить("Маг1С_ОбъектИзменен", Ложь);
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("Маг1с_ЭтоПолучениеДопСвойства") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если Источник.Родитель <> Маг1СИнтеграция.ГруппаНаборовДопРеквизитов(НастройкиУчетнойСистемы.Номенклатура.НаборДопРеквизитов) Тогда
		Если ЗначениеЗаполнено(НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.НаборДопРеквизитов) Тогда
			Если Источник.Родитель <> Маг1СИнтеграция.ГруппаНаборовДопРеквизитов(НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.НаборДопРеквизитов) Тогда
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СвойстваСтали.Свойство КАК Свойство
	|ПОМЕСТИТЬ ВТСвойстваСтали
	|ИЗ
	|	&ДополнительныеРеквизиты КАК СвойстваСтали
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Свойство КАК Свойство,
	|	СУММА(ВложенныйЗапрос.Контроль) КАК Контроль
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТСвойстваСтали.Свойство КАК Свойство,
	|		1 КАК Контроль
	|	ИЗ
	|		ВТСвойстваСтали КАК ВТСвойстваСтали
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДополнительныеРеквизиты.Свойство,
	|		-1
	|	ИЗ
	|		Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
	|	ГДЕ
	|		ДополнительныеРеквизиты.Ссылка = &Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Свойство
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.Контроль) <> 0";
	
	Запрос.УстановитьПараметр("ДополнительныеРеквизиты", Источник.ДополнительныеРеквизиты);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	ИзменененныеСвойства = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Свойство");
	
	Если ИзменененныеСвойства.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Источник.ДополнительныеСвойства.Маг1С_ОбъектИзменен = Истина;
	Источник.ДополнительныеСвойства.Вставить("Маг1С_ИзменененныеСвойства", ИзменененныеСвойства);
	
КонецПроцедуры

Процедура Маг1С_ПриЗаписиНабораДопРеквизитов(Источник, Отказ)
	Если Не Источник.ДополнительныеСвойства.Маг1С_ОбъектИзменен Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы(); 
	СписокНастроекВитрин    = Маг1СИнтеграция.СписокНастроекВитрин();
	
	Для Каждого КлючЗначение из СписокНастроекВитрин Цикл
		НастройкиВитрины = КлючЗначение.Значение;
		УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
		Если УзелОбмена = Неопределено
			Или Не ОбщегоНазначения.СсылкаСуществует(УзелОбмена) Тогда
			Продолжить;
		КонецЕсли;
		
		ИзменененныеСвойстваПоКоторымЕстьНастройки = Новый Массив;
		
		Для Каждого СтрМас из Источник.ДополнительныеСвойства.Маг1С_ИзменененныеСвойства Цикл
			
			Если НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров.Получить(СтрМас) <> Неопределено Тогда
				ИзменененныеСвойстваПоКоторымЕстьНастройки.Добавить(СтрМас);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ИзменененныеСвойстваПоКоторымЕстьНастройки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТНоменклатура
		|ИЗ
		|	Справочник.ИмяСправочникаНоменклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|ГДЕ
		|	НоменклатураДополнительныеРеквизиты.Свойство В(&ИзменененныеСвойства)";
		ИмяСправочникаНоменклатура = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаНоменклатура", ИмяСправочникаНоменклатура);
		
		Если НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.ОграничениеТипа <> Неопределено Тогда
			ТекстЗапроса = ТекстЗапроса +
			"
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ХарактеристикиДополнительныеРеквизиты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ИмяСправочникаХарактеристики.ДополнительныеРеквизиты КАК ХарактеристикиДополнительныеРеквизиты
			|ГДЕ
			|	ХарактеристикиДополнительныеРеквизиты.Свойство В(&ИзменененныеСвойства)";
			
			ИмяСправочникаХарактеристики = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаХарактеристики", ИмяСправочникаХарактеристики);
			
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса +
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка КАК Ссылка
		|ИЗ
		|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
		|ГДЕ
		|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТНоменклатура.Ссылка
		|			ИЗ
		|				ВТНоменклатура)
		|	И ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелОбмена";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ИзменененныеСвойства", ИзменененныеСвойстваПоКоторымЕстьНастройки);
		Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
		
		КРегистрации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		Если КРегистрации.Количество() > 0 Тогда 
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, КРегистрации);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Маг1С_ЗаписьДополнительныхСведенийПриЗаписи(Источник, Отказ, Замещение) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);	
	
	УзлыОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.УзлыОбменаСВитринами();
	
	Если УзлыОбмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДопСвойствоФайл      = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоФайлДляКартинкиКатегории(); // Объект - Категория
	ДопСвойствоКатегория = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоВладелецФайлаКартинкиКатегории(); // Объект - Файл
	
	ЗначениеОтбораОбъект   = Неопределено;
	ЗначениеОтбораСвойство = Неопределено;
	
	Для Каждого ЭлементОтбора из Источник.Отбор Цикл
		Если ЭлементОтбора.Имя = "Объект" Тогда
			ЗначениеОтбораОбъект = ЭлементОтбора.Значение;
		ИначеЕсли ЭлементОтбора.Имя = "Свойство" Тогда
        	ЗначениеОтбораСвойство = ЭлементОтбора.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ЭтоЗаписьКатегории = ДопСвойствоФайл = ЗначениеОтбораСвойство;
	ЭтоЗаписьФайла     = ДопСвойствоКатегория = ЗначениеОтбораСвойство; 
	
	Если Не ЗначениеЗаполнено(ЗначениеОтбораОбъект)
		Или (Не ЭтоЗаписьКатегории
			И Не ЭтоЗаписьФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьНаУзлахСКоторымиБылОбмен(ЗначениеОтбораОбъект, ЗначениеОтбораОбъект, ЭтоЗаписьКатегории);
	
	Если Источник.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаписьРегистра = Источник[0];
	
	ЗначениеЗаписи = СтрокаJSONВСсылку(ЗаписьРегистра.Значение);
	
	Если ЗначениеЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьНаУзлахСКоторымиБылОбмен(ЗначениеОтбораОбъект, ЗначениеЗаписи, ЭтоЗаписьФайла);
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ЗарегистрироватьКОбмену(УзелОбмена, РегистрируемаяСсылка, НаПланеОбмена, НомерОтправленного) Экспорт
	Если Не НаПланеОбмена
		И ТипЗнч(НомерОтправленного) <> Тип("Число") Тогда
		ВызватьИсключение НСтр("ru = 'Не передан номер отправленного'");
	КонецЕсли;
	
	Если НаПланеОбмена Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, РегистрируемаяСсылка); 	
	Иначе
		Маг1СИнтеграция.ЗарегистрироватьКОбменуЗначениеСсылочногоСвойства(УзелОбмена, 
																		РегистрируемаяСсылка,
																		НомерОтправленного);
	КонецЕсли;
КонецПроцедуры

Процедура ЗарегистрироватьНаУзлахСКоторымиБылОбмен(СсылкаОтбора, РегистрируемаяСсылка, НаПланеОбмена) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	УзлыОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.УзлыОбменаСВитринами();
	
	Если УзлыОбмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы КАК УзелИнформационнойБазы,
	|	ВЫРАЗИТЬ(ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы КАК ПланОбмена.ИмяПланаОбмена).НомерОтправленного КАК НомерОтправленного	
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
	|ГДЕ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка = &Ссылка
	|	И ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы В(&УзлыОбмена)";
	
	Если СсылкаОтбора <> РегистрируемаяСсылка Тогда
		ПолноеИмяОбъекта = СсылкаОтбора.Метаданные().ПолноеИмя();
		
		// Нужно зарегитрировать в т.ч. по тем узлам, по которым зарегистрированы изменения, но обмена
		// еще не было
		
		Если Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена(ПолноеИмяОбъекта) Тогда
			ТекстЗапроса = ТекстЗапроса + " 
			|
			| ОБЪЕДИНИТЬ
			|
			| ВЫБРАТЬ
			|	ТаблицаИзменений.Узел КАК УзелИнформационнойБазы,
			|	ВЫРАЗИТЬ(ТаблицаИзменений.Узел КАК ПланОбмена.ИмяПланаОбмена).НомерОтправленного КАК НомерОтправленного
			|ИЗ
			|	ПолноеИмяОбъекта.Изменения КАК ТаблицаИзменений
			|ГДЕ
			|	ТаблицаИзменений.Ссылка = &Ссылка
			|	И ТаблицаИзменений.Узел В(&УзлыОбмена)";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПолноеИмяОбъекта", ПолноеИмяОбъекта);  
		КонецЕсли;
	КонецЕсли;
	ИмяПланаОбмена = УзлыОбмена[0].Метаданные().Имя;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПланаОбмена", ИмяПланаОбмена);  
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", СсылкаОтбора);
	Запрос.УстановитьПараметр("УзлыОбмена", УзлыОбмена);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗарегистрироватьКОбмену(Выборка.УзелИнформационнойБазы, РегистрируемаяСсылка, НаПланеОбмена, Выборка.НомерОтправленного);
				
		Если СсылкаОтбора <> РегистрируемаяСсылка Тогда
			ВременнаяСсылкаДействуетДо = Маг1СИнтеграция.ЗначениеНужноДляВременнойСсылкиДо(Выборка.УзелИнформационнойБазы, СсылкаОтбора);
			Если ВременнаяСсылкаДействуетДо <> Неопределено  Тогда
           		Маг1СИнтеграция.ЗарегистрироватьКОбменуДляВременнойСсылки(Выборка.УзелИнформационнойБазы,
																			РегистрируемаяСсылка,
																			ВременнаяСсылкаДействуетДо,
																			НаПланеОбмена,
																			Выборка.НомерОтправленного);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

#КонецОбласти

#КонецОбласти