Процедура ИсправитьНастройки(НастройкиВитрины) Экспорт

	Если Не НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.Свойство("ВариантРасчетаСтоимости")
		Или ПустаяСтрока(НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.ВариантРасчетаСтоимости) Тогда
		
		Если НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.Свойство("СтоимостьДоставки") Тогда
			НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.Вставить("Стоимость", 
				НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.СтоимостьДоставки);
			НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.Удалить("СтоимостьДоставки");
		КонецЕсли;
		
		Если НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.Стоимость = 0 Тогда
			НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.Вставить("ВариантРасчетаСтоимости",
					Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Бесплатно());
		Иначе
			НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.Вставить("ВариантРасчетаСтоимости",
					Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Фиксированная());
		КонецЕсли;
		
	КонецЕсли;
		
	Если НастройкиВитрины.ОсновныеНастройки.Свойство("ПараметрыОбмена") Тогда
		НастройкиВитрины.ОсновныеНастройки.Вставить("УзелОбмена", НастройкиВитрины.ОсновныеНастройки.ПараметрыОбмена.УзелОбмена);
		НастройкиВитрины.ОсновныеНастройки.Удалить("ПараметрыОбмена");	
	КонецЕсли;
	
	Если Не НастройкиВитрины.ОсновныеНастройки.Свойство("РежимРегистрацииПокупателей")
		И НастройкиВитрины.ОсновныеНастройки.Свойство("РежимВитрины") Тогда
		Если НастройкиВитрины.ОсновныеНастройки.РежимВитрины = Маг1СПеречисления.РежимыВитрины_Открытый()
			Или НастройкиВитрины.ОсновныеНастройки.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
			НастройкиВитрины.ОсновныеНастройки.Вставить("РежимРегистрацииПокупателей",
				Маг1СПеречисления.РежимыРегистрацииПокупателей_ПоИнвайтамИБезИнвайтов());
		Иначе
			НастройкиВитрины.ОсновныеНастройки.Вставить("РежимРегистрацииПокупателей",
				Маг1СПеречисления.РежимыРегистрацииПокупателей_ТолькоПоИнвайтам());
		КонецЕсли;		
	КонецЕсли;
	
	ПустыеОсновныеНастройки = СтруктураОсновныхНастроекВитрины();
	ПроверитьСвойстваСтрутурыРекурссивно(ПустыеОсновныеНастройки, НастройкиВитрины.ОсновныеНастройки);
	
	ПустыеДополнительныеНастройки = СтруктураДополнительныхНастроекВитрины();
	ПроверитьСвойстваСтрутурыРекурссивно(ПустыеДополнительныеНастройки, НастройкиВитрины.ДополнительныеНастройки);
	
КонецПроцедуры

Процедура ИсправитьЗначкиНоменклатуры(ЗначкиНоменклатуры) Экспорт
	
	ВсеЗначкиНоменклатуры = ВсеЗначкиНоменклатуры();
	
	ИндексОписания  = ЗначкиНоменклатуры.Количество() - 1; 
	
	Пока ИндексОписания > -1 Цикл
		Индекс = ВсеЗначкиНоменклатуры.Найти(ЗначкиНоменклатуры[ИндексОписания].Значок);
		Если Индекс <> Неопределено Тогда 
			ВсеЗначкиНоменклатуры.Удалить(Индекс);
		Иначе
			ЗначкиНоменклатуры.Удалить(ИндексОписания);
		КонецЕсли;
		
		ИндексОписания = ИндексОписания - 1;
	КонецЦикла;
	
	Для Каждого СтрМас из ВсеЗначкиНоменклатуры Цикл
		
		ЗначкиНоменклатуры.Добавить(
			Новый Структура("Значок, ОтображатьНаНачальнойСтранице", 
							 СтрМас, Истина));
		
	КонецЦикла;

КонецПроцедуры

Функция СтруктураОписанияВТ()
	Результат = Новый Структура;
	Результат.Вставить("ТекстЗапроса");
	Результат.Вставить("ИмяПоляОтбораНоменклатура");
	Результат.Вставить("ПараметрыЗапроса", Новый Структура);
	
	Возврат Результат;
КонецФункции

Функция СтруктураПравилаОтображенияТоваров()
	Результат = Новый Структура;
	Результат.Вставить("ПубликоватьТолькоАктивныеПозиции", Ложь);
	Результат.Вставить("ОтборПоЗаказамПоставщикам", Ложь);
	Результат.Вставить("ОтборПоОстаткам", Ложь);
	Результат.Вставить("ОтборПоПродажам", Ложь);
	Результат.Вставить("ОтборПоСегменту", Ложь);
	
	Возврат Результат;
КонецФункции

Функция СостояниеАутентификацииИПП() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктураСостояниеАутентификацииИПП();
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Результат.АутентификацияИППВыполнена = Истина;
	Иначе
		Результат.АутентификацияИППВыполнена = ИнтернетПоддержкаПользователей.ЗаполненыДанныеАутентификацииПользователяИнтернетПоддержки();
		
		Если Результат.АутентификацияИППВыполнена Тогда
			Результат.ЛогинИПП = ИнтернетПоддержкаПользователей.ДанныеАутентификацииПользователяИнтернетПоддержки().Логин;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
КонецФункции

Функция ЕстьРасширениеТестирования() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	РасширениеТестирования = РасширенияКонфигурации.Получить(Новый Структура("Имя","Маг1СТестирование"));
	РасширениеАктивно = Ложь;
	
	Если РасширениеТестирования.Количество() > 0 Тогда
		Для каждого Расширение из РасширениеТестирования Цикл
			Если Расширение.Активно Тогда
				РасширениеАктивно = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РасширениеАктивно;
КонецФункции

Функция СведенияОбОрганизации(ОсновныеНастройкиОрганизация) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	СведенияОбОрганизации = СтруктураСведенийОбОрганизации();
	
	Если ТипЗнч(ОсновныеНастройкиОрганизация) = Тип("Структура") Тогда
		ОсновныеНастройки = ОсновныеНастройкиОрганизация;
	Иначе
		ПараметрыУчета = Новый Структура("Организация", ОсновныеНастройкиОрганизация);
		ОсновныеНастройки = Новый Структура("ПараметрыУчета,БанковскийСчет",
											ПараметрыУчета,Неопределено );
	КонецЕсли;
	
	Маг1СИнтеграцияПереопределяемый.ПриПолученииСведенийОбОрганизации(ОсновныеНастройки, СведенияОбОрганизации);
	
	ПустыеНастройки = СтруктураСведенийОбОрганизации();
	
	Для Каждого КлючЗначение из ПустыеНастройки Цикл
		Если КлючЗначение.Значение <> Неопределено 
			И ТипЗнч(КлючЗначение.Значение) <> ТипЗнч(СведенияОбОрганизации[КлючЗначение.Ключ]) Тогда
			СведенияОбОрганизации[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СведенияОбОрганизации;
КонецФункции

Процедура ОбновитьНастройкиВитринВФоне() Экспорт
	
	Если Не ПрочитатьНеобходимостьНовогоЗапускаОбновленияНастроекВитрин() Тогда
		Возврат;
	КонецЕсли;
	
	ЛогинИПП = "";
	СостояниеАутентификацииИПП = Маг1СИнтеграцияСлужебныйВызовСервера.СостояниеАутентификацииИПП();
		
	Если СостояниеАутентификацииИПП.АутентификацияИППВыполнена Тогда
		ЛогинИПП = СостояниеАутентификацииИПП.ЛогинИПП;
	Иначе
		Возврат;
	КонецЕсли;
     
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыОперации.Вставить("АдресПриложенияВИнтернете", "");
	ПараметрыОперации.Вставить("ЭтоИнтерактивныйЗапуск", Ложь);
	ПараметрыОперации.Вставить("СписокВитринОбновлятьВсегда", Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.КлючФоновогоЗадания = "abd6d243-418b-43c5-8a8d-96c77936c966";
	
	ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СНастройка.ПолучениеИнформацииПоПрофилюВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
		
КонецПроцедуры

Функция ВсеЗначкиНоменклатуры()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Ссылка КАК Значок
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Владелец = &ДопРеквизит
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("ДопРеквизит", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры());
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значок");

КонецФункции

Процедура ЗаполнитьНастройкиПоУмолчанию(СостояниеМастера, НастройкиУчетнойСистемы, ЛогинИПП, СтрокаСпискаВитрин) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	НастройкиВитрины = СостояниеМастера.НастройкиВитрины;
	НастройкиВитрины.ЛогинИПП = ЛогинИПП;
	
	ЗаполнитьЗначенияСвойств(НастройкиВитрины.ОсновныеНастройки, СтрокаСпискаВитрин);
	
	НастройкиВитрины.ОсновныеНастройки.ОтображаемоеПолеКодаНоменклатуры = НастройкиУчетнойСистемы.ОтображаемоеПолеКодаНоменклатуры;
	
	ЗаполнитьПараметрУчетаПоУмолчанию(НастройкиВитрины, НастройкиУчетнойСистемы, "Организация");
	ЗаполнитьПараметрУчетаПоУмолчанию(НастройкиВитрины, НастройкиУчетнойСистемы, "Склад");
	ЗаполнитьПараметрУчетаПоУмолчанию(НастройкиВитрины, НастройкиУчетнойСистемы, "ВидЦен");
	ЗаполнитьПараметрУчетаПоУмолчанию(НастройкиВитрины, НастройкиУчетнойСистемы, "УслугаДоставки");
	
	Если Не ЗначениеЗаполнено(СтрокаСпискаВитрин.РежимВитрины) Тогда
		НастройкиВитрины.ОсновныеНастройки.РежимВитрины = Маг1СПеречисления.РежимыВитрины_Открытый();
	Иначе
		НастройкиВитрины.ОсновныеНастройки.РежимВитрины = СтрокаСпискаВитрин.РежимВитрины;
	КонецЕсли;
	
	НастройкиВитрины.ОсновныеНастройки.РежимПереноса = Маг1СПеречисления.РежимПереносаПолный();
	
	НастройкиВитрины.ОсновныеНастройки.ВыгружатьИнформативныеОстатки = Истина;
	
	НастройкиВитрины.ОсновныеНастройки.ВыгружатьКартинки = Маг1СИнтеграция.ЕстьКартинкиТоваров(НастройкиУчетнойСистемы);
	
	ЮКассаПодключена  = ЮКассаПодключена(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация).Подключена;
	
	НастройкаСБП = Неопределено;
	ОплатаЧерезСБППодключена = Ложь;
	
	Если ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация)
		И НастройкиУчетнойСистемы.ПоддерживаетсяОплатаЧерезСБП Тогда
		ДоступныеНастройкиСБП = ДоступныеНастройкиСБП(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация);

		Если ДоступныеНастройкиСБП.Количество() = 1 Тогда
			НастройкаСБП = ДоступныеНастройкиСБП[0];
		КонецЕсли;
		
		ОплатаЧерезСБППодключена =  ДоступныеНастройкиСБП.Количество() > 0;
	КонецЕсли;
	
	Если НастройкаСБП <> Неопределено Тогда
		НастройкиВитрины.ОсновныеНастройки.НастройкаСБП = НастройкаСБП;
	КонецЕсли;
	  
	НастройкиДоставки = НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки;
	// Настройки самовывоза.
	НастройкиДоставки.Самовывоз.Использование = Истина;
	
	НастройкиДоставки.Самовывоз.ВариантыОплаты.НаличнымиПриПолучении = Истина;
	НастройкиДоставки.Самовывоз.ВариантыОплаты.КартойПриПолучении    = Истина;
	
	НастройкиДоставки.Самовывоз.ВариантыОплаты.ПереводомНаСчет       = Истина;
	НастройкиДоставки.Самовывоз.ВариантыОплаты.ОнЛайнЧерезЮКассу     = ЮКассаПодключена;
	НастройкиДоставки.Самовывоз.ВариантыОплаты.ОнЛайнЧерезСБП        = ОплатаЧерезСБППодключена;

	// Настройки курьерской доставки.
	НастройкиДоставки.КурьерскаяДоставка.Использование                        = Истина;
	НастройкиДоставки.КурьерскаяДоставка.ВариантыОплаты.НаличнымиПриПолучении = Истина;
	НастройкиДоставки.КурьерскаяДоставка.ВариантыОплаты.ОнЛайнЧерезЮКассу     = ЮКассаПодключена;
	НастройкиДоставки.КурьерскаяДоставка.ВариантыОплаты.ОнЛайнЧерезСБП        = ОплатаЧерезСБППодключена;
	
	// Настройки доставки транспортной компанией.
	НастройкиДоставки.ТранспортнаяКомпания.Использование                    = Истина;
	НастройкиДоставки.ТранспортнаяКомпания.ВариантыОплаты.ПереводомНаСчет   = Истина;
	НастройкиДоставки.ТранспортнаяКомпания.ВариантыОплаты.ОнЛайнЧерезЮКассу = ЮКассаПодключена;
	НастройкиДоставки.ТранспортнаяКомпания.ВариантыОплаты.ОнЛайнЧерезСБП    = ОплатаЧерезСБППодключена;
	
	НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеПереводомНаСчет        = Истина;
	НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу            = ЮКассаПодключена;
	НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП               = ОплатаЧерезСБППодключена;
	
	Для Каждого КлючЗначение из НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.Соответствие Цикл
		НастройкиВитрины.ДополнительныеНастройки.СоответствияСтатусовЗаказов.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	СостояниеМастера.ОзнакомитьсяСоСпискомЗапрещенныхМатериалов = Ложь;
	СостояниеМастера.ПринятьУсловияЛицензионногоСоглашения      = Ложь;
	СостояниеМастера.СтраницаПереходаСохраненная                = "";
	
	СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_АвтоматическиНаВитрине();
	СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.ТекстУсловийВСчетеНаОплату      = Маг1СИнтеграцияСлужебныйКлиентСервер.ТекстУсловийВСчетеНаОплату();
	
	Если СтрокаСпискаВитрин.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		СведенияОбОрганизации = СведенияОбОрганизации(НастройкиВитрины.ОсновныеНастройки);
		
		СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.НазваниеМагазина = СведенияОбОрганизации.НаименованиеРабочее;
		СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.ТелефонМагазина1 = СведенияОбОрганизации.Телефон;
		
		Если ЗначениеЗаполнено(СведенияОбОрганизации.ФактическийАдрес) Тогда
			СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.АдресМагазина = СведенияОбОрганизации.ФактическийАдрес;
		Иначе
			СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.АдресМагазина = СведенияОбОрганизации.ЮридическийАдрес;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(СведенияОбОрганизации.Логотип) Тогда
			Попытка
				ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(СведенияОбОрганизации.Логотип, Истина);
				СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.ДанныеКартинкиЛоготипа = 
					Маг1СИнтеграцияСлужебный.СжатьКартинку(ДвоичныеДанныеФайла, 400, 800).ДвоичныеДанные;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	ПриИзмененииПараметровУчета(НастройкиВитрины.ОсновныеНастройки, НастройкиУчетнойСистемы);
	
	ИсправитьНастройки(СостояниеМастера.НастройкиВитрины);
КонецПроцедуры

Процедура ЗаполнитьПараметрУчетаПоУмолчанию(НастройкиВитрины, НастройкиУчетнойСистемы, ИмяПараметраУчета)
	
	Если Не ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета[ИмяПараметраУчета]) Тогда
		НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета[ИмяПараметраУчета] = НастройкиУчетнойСистемы[ИмяПараметраУчета].Значение;
    КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСвойстваСтрутурыРекурссивно(Источник, Приемник)
	Для каждого КлючЗначение Из Источник Цикл
		Если Не Приемник.Свойство(КлючЗначение.Ключ) Тогда
			Приемник.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
			Если ТипЗнч(Приемник[КлючЗначение.Ключ]) = Тип("Структура") Тогда
				ПроверитьСвойстваСтрутурыРекурссивно(Источник[КлючЗначение.Ключ], Приемник[КлючЗначение.Ключ]);
			Иначе
				Приемник.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
            КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область РаботаСQRКодами

Функция ПолучитьКартинкуQRКода(ПараметрыКартинки, Штрихкод) Экспорт
	
	СистемныеНастройки = ПрочитатьСистемныеНастройки();
	
	Если СистемныеНастройки.ОтключитьГенерациюQRКода Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	ПараметрыШтрихкода.Вставить("Ширина",          ПараметрыКартинки.Ширина);
	ПараметрыШтрихкода.Вставить("Высота",          ПараметрыКартинки.Высота);
	ПараметрыШтрихкода.Вставить("Штрихкод",        Штрихкод);
	ПараметрыШтрихкода.Вставить("ТипКода",         16);
	ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
	
	РезультатОперации = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	Если  РезультатОперации.ДвоичныеДанные <> Неопределено Тогда
		Возврат РезультатОперации.Картинка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОбщегоНазначения

// Останавливает выполнение кода на заданное время.
//
// Параметры:
//  Секунд - Число - время ожидания в секундах.
//
Процедура Пауза(Секунд) Экспорт
	
	ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();
	
	Если ФоновоеЗадание = Неопределено Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("Маг1СИнтеграцияСлужебный.Пауза", Параметры);
	КонецЕсли;
		
	Попытка
		ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция Дней30ОтТекущейДаты() Экспорт
	Возврат ТекущаяДатаСеанса() - 2592000;		
КонецФункции

Функция СжатьКартинку(ДвоичныеДанные, МаксимальнаяВысота = 1080, МаксимальнаяШирина = 1920, Плотность = 72, Расширение = "") Экспорт
	
	ИсходнаяКартинка = Новый Картинка(ДвоичныеДанные);
	
	ИтоговыйФормат = ИсходнаяКартинка.Формат();
	
	Если ИтоговыйФормат = Неопределено
		Или ИтоговыйФормат = ФорматКартинки.НеизвестныйФормат Тогда
		// Обход ошибки во Фреше, что не определяется формат картинки svg
		Если ВРег(Расширение) = "SVG" Тогда
			ИтоговыйФормат = ФорматКартинки.SVG;
		Иначе
			ТекстИсключения = НСтр("ru = 'Неизвестный формат исходной картинки: %ИтоговыйФормат.'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИтоговыйФормат", Строка(ИтоговыйФормат));
			ВызватьИсключение НСтр(ТекстИсключения);
		КонецЕсли;
	КонецЕсли;
		
	КартинкаПреобразована = Ложь;
	
	Если ИтоговыйФормат <> ФорматКартинки.SVG
		И (Маг1СИнтеграцияСлужебный.ВерсияПлатформыПоддерживаетПреобразованиеPNG() 
			Или ИтоговыйФормат <> ФорматКартинки.PNG) Тогда
		
		КартинкаДляОбработки  = Новый ОбрабатываемаяКартинка(ИсходнаяКартинка);
		
		Если ИтоговыйФормат <> ФорматКартинки.PNG
			И ИтоговыйФормат <> ФорматКартинки.GIF
            И ИтоговыйФормат <> ФорматКартинки.JPEG Тогда
			
			КартинкаДляОбработки.УстановитьФормат(ФорматКартинки.JPEG);
			ИтоговыйФормат = ФорматКартинки.JPEG;
			КартинкаПреобразована = Истина;
			
		КонецЕсли;
		
		Если ИсходнаяКартинка.ПлотностьПоВертикали() <> Неопределено 
				И ИсходнаяКартинка.ПлотностьПоВертикали() > Плотность
			Или ИсходнаяКартинка.ПлотностьПоГоризонтали() <> Неопределено 
				И ИсходнаяКартинка.ПлотностьПоГоризонтали() > Плотность Тогда
			
			КартинкаДляОбработки.УстановитьПлотность(Плотность, Плотность);	
			КартинкаПреобразована = Истина;
			
		КонецЕсли;
		
		Если ИсходнаяКартинка.Высота() <> Неопределено 
				И ИсходнаяКартинка.Высота() > МаксимальнаяВысота
			Или ИсходнаяКартинка.Ширина() <> Неопределено 
				И ИсходнаяКартинка.Ширина() > МаксимальнаяШирина Тогда
			
			Если ИсходнаяКартинка.Высота() / МаксимальнаяВысота < ИсходнаяКартинка.Ширина() / МаксимальнаяШирина Тогда
				КартинкаДляОбработки.УстановитьРазмер(МаксимальнаяШирина,);
			Иначе
				КартинкаДляОбработки.УстановитьРазмер(,МаксимальнаяВысота);
			КонецЕсли;
			
			КартинкаПреобразована = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если КартинкаПреобразована Тогда
		ДвоичныеДанныеДляПередачи = КартинкаДляОбработки.ПолучитьКартинку().ПолучитьДвоичныеДанные();
	Иначе
		ДвоичныеДанныеДляПередачи = ДвоичныеДанные;
	КонецЕсли;
	
	Если ИтоговыйФормат = ФорматКартинки.PNG Тогда
		ТипСодержимого = "image/png";
	ИначеЕсли ИтоговыйФормат = ФорматКартинки.SVG Тогда
		ТипСодержимого = "image/svg+xml";
	ИначеЕсли ИтоговыйФормат = ФорматКартинки.GIF Тогда
		ТипСодержимого = "image/gif";
	ИначеЕсли ИтоговыйФормат = ФорматКартинки.JPEG Тогда
		ТипСодержимого = "image/jpeg";
	Иначе
		ТекстИсключения = НСтр("ru = 'Неподдерживаемый формат картинки после преобразования: %ИтоговыйФормат.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИтоговыйФормат", Строка(ИтоговыйФормат));
		ВызватьИсключение НСтр(ТекстИсключения);
	КонецЕсли;

	Возврат Новый Структура("ДвоичныеДанные,ИсходнаяКартинка,КартинкаПреобразована,ТипСодержимого",
							ДвоичныеДанныеДляПередачи,
							ИсходнаяКартинка,
							КартинкаПреобразована,
							ТипСодержимого);
	
КонецФункции

Процедура СохранитьДопСвойстваИсключитьИзПубликацииНаВебВитринеMag1c(НоменклатураИсключение, НастройкиУчетнойСистемы) Экспорт
	ДопРеквизит = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИсключитьИзПубликацииНаВебВитринеMag1c();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка КАК Ссылка,
	|	СУММА(ВложенныйЗапрос.Контроль) КАК Контроль
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		СпрНоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка,
	|		-1 КАК Контроль
	|	ИЗ
	|		Справочник.ИмяСправочникаНоменклатура.ДополнительныеРеквизиты КАК СпрНоменклатураДополнительныеРеквизиты
	|	ГДЕ
	|		СпрНоменклатураДополнительныеРеквизиты.Свойство = &Свойство
	|		И СпрНоменклатураДополнительныеРеквизиты.Значение = ИСТИНА
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СпрНоменклатура.Ссылка,
	|		1
	|	ИЗ
	|		Справочник.ИмяСправочникаНоменклатура КАК СпрНоменклатура
	|	ГДЕ
	|		СпрНоменклатура.Ссылка В (&НоменклатураИсключения)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.Контроль) <> 0";
	Запрос.УстановитьПараметр("НоменклатураИсключения", НоменклатураИсключение);
	Запрос.УстановитьПараметр("Свойство", ДопРеквизит);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
							   "ИмяСправочникаНоменклатура",
								Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоменклатураОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если Выборка.Контроль < 0 Тогда
			ДопРеквизитСтроки = НоменклатураОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ДопРеквизит));
			
			Для Каждого СтрокаРеквизита Из ДопРеквизитСтроки Цикл
				НоменклатураОбъект.ДополнительныеРеквизиты.Удалить(СтрокаРеквизита);
			КонецЦикла;
		Иначе
			ДопРеквизитЗапись = НоменклатураОбъект.ДополнительныеРеквизиты.Добавить();
			ДопРеквизитЗапись.Свойство = ДопРеквизит;
			ДопРеквизитЗапись.Значение = Истина;
		КонецЕсли;
		
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		НоменклатураОбъект.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ЭтоГруппаТоваров(Товар) Экспорт
	
	Если Не ЗначениеЗаполнено(Товар) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если ТипЗнч(НастройкиУчетнойСистемы.Номенклатура.Значение) <> ТипЗнч(Товар) Тогда
		ЭтоГруппа = Истина;
	Иначе
		ЭтоГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товар, "ЭтоГруппа");
	КонецЕсли;
	
	Возврат ЭтоГруппа;

КонецФункции

Функция КартинкиТовара(Товар, ИмяСправочникаКартинокНоменклатуры, ИмяПоляСправочникНоменклатураОсновнаяКартинка, УникальныйИдентификаторФормы) Экспорт
	
	ЭтоГруппа =  ЭтоГруппаТоваров(Товар);
	
	СписокКартинок = Новый ТаблицаЗначений;
	СписокКартинок.Колонки.Добавить("ВладелецФайла");	
	СписокКартинок.Колонки.Добавить("Ссылка");	
	СписокКартинок.Колонки.Добавить("ЭтоОсновное");	
	СписокКартинок.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"));
	
	Если ЭтоГруппа Тогда
		КартинкаКатегории = Маг1СИнтеграция.ФайлДляКартинкиКатегории(Товар);
		
		Если ЗначениеЗаполнено(КартинкаКатегории) Тогда
			
			Изображение = СписокКартинок.Добавить();
			
			Изображение.Ссылка        = КартинкаКатегории;
			Изображение.ВладелецФайла = Товар;
			Изображение.ЭтоОсновное   = Истина;
			
			ДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(Изображение.Ссылка);
			Изображение.Адрес = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификаторФормы);
			
		КонецЕсли;
		
	Иначе
		
		Если ПустаяСтрока(ИмяПоляСправочникНоменклатураОсновнаяКартинка) Тогда
			ТекстЭтоОсновное = "ЛОЖЬ"
		Иначе	
			ТекстЭтоОсновное = "		
			|	ВЫБОР
			|		КОГДА Изображения.Ссылка = Изображения.ВладелецФайла." + ИмяПоляСправочникНоменклатураОсновнаяКартинка + "
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ";
		КонецЕсли;
			
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Изображения.ВладелецФайла КАК ВладелецФайла,
		|	Изображения.Ссылка КАК Ссылка,
 		|	&ТекстЭтоОсновное КАК ЭтоОсновное
		|ИЗ
		|	Справочник.ИмяСправочникаКартинокНоменклатуры КАК Изображения
		|ГДЕ
		|	Изображения.ВладелецФайла = &ВладелецФайла
		|	И НЕ Изображения.ПометкаУдаления
		|	И Изображения.Расширение В(&ДопустимыеРасширения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Изображения.Наименование";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаКартинокНоменклатуры", ИмяСправочникаКартинокНоменклатуры);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЭтоОсновное", ТекстЭтоОсновное);
		
		Запрос.УстановитьПараметр("ВладелецФайла", Товар);
		Запрос.УстановитьПараметр("ДопустимыеРасширения", Маг1СИнтеграцияСлужебныйКлиентСервер.РасширенияИзображений());
			
		СписокКартинок = Запрос.Выполнить().Выгрузить();
		СписокКартинок.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"));
			
		ВыборкаИзображений	= Запрос.Выполнить().Выбрать();
		Для Каждого Изображение Из СписокКартинок Цикл
			ДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(Изображение.Ссылка);
			Изображение.Адрес = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификаторФормы);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокКартинок;
КонецФункции

Процедура УстановитьОсновноеИзображение(ВладелецФайла, Файл, ИмяПоляСправочникНоменклатураОсновнаяКартинка) Экспорт
	
	Если ПустаяСтрока(ИмяПоляСправочникНоменклатураОсновнаяКартинка) Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураОбъект = ВладелецФайла.ПолучитьОбъект();
	НоменклатураОбъект[ИмяПоляСправочникНоменклатураОсновнаяКартинка] = Файл;
	НоменклатураОбъект.Записать();
	
КонецПроцедуры

Функция ДоговорПоУмолчаниюПоКонтрагенту(Контрагент, НастройкиВитрины, НастройкиУчетнойСистемы) Экспорт
	
	ДоговорПоУмолчанию = Маг1СИнтеграцияПереопределяемый.ДоговорПоУмолчаниюПоКонтрагенту(Контрагент,
															НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета); 
	
	Если ЗначениеЗаполнено(ДоговорПоУмолчанию) Тогда																						
		ВидЦен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорПоУмолчанию,
															НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.ВидЦен); 																						 
		
		Если ВидЦен <> НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен Тогда
			Возврат ДоговорПоУмолчанию;
		Иначе
			Возврат НастройкиУчетнойСистемы.ДоговорКонтрагента.Значение;
		КонецЕсли;
	Иначе
		Возврат НастройкиУчетнойСистемы.ДоговорКонтрагента.Значение;
	КонецЕсли;
	
КонецФункции

Функция СтрокаBase64БезBOM(СтрокаДанных) Экспорт

	ПотокВПамяти = Новый ПотокВПамяти();
	Текст = Новый ЗаписьТекста(ПотокВПамяти, КодировкаТекста.UTF8, , Символы.ПС);
	Текст.Записать(СтрокаДанных);
	Текст.Закрыть();
	ДвоичныеДанные = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
	
	Возврат Base64СтрокаИзДвоичныхДанных(ДвоичныеДанные);
КонецФункции

Функция ПреобразоватьНомерТелефонаВСтруктуру(Знач ИзначальнаяСтрока) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТелефонМагазина1", "");
	Результат.Вставить("ТелефонМагазина1Описание", "");
	Результат.Вставить("ТелефонМагазина2", "");
	Результат.Вставить("ТелефонМагазина2Описание", "");
	Результат.Вставить("ТелефонМагазина3", "");
	Результат.Вставить("ТелефонМагазина3Описание", "");
	
	СтрокаТелефона = СокрЛП(ИзначальнаяСтрока);
	
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, "+","");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, "(","");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, ")","");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, "-","");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, ":","");
	
	Пока СтрНайти(СтрокаТелефона, "  ") > 0 Цикл
		СтрокаТелефона = СтрЗаменить(СтрокаТелефона, "  ","");
	КонецЦикла;
	
	Если ПустаяСтрока(СтрокаТелефона) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Массив1Слов = Новый Массив;
	ТекСлово   = "";
	ПредСимвол = "";
	
	Для Инд = 1 По СтрДлина(СтрокаТелефона) Цикл
		
		ТекСимвол = Сред(СтрокаТелефона, Инд, 1);
		Если Инд > 1 Тогда
			ПредСимвол = Сред(СтрокаТелефона, Инд-1, 1);
		Иначе
			ТекСлово = ТекСимвол;
			Продолжить;
		КонецЕсли;
		
		Если (ЭтоЦифры(ПредСимвол) = ЭтоЦифры(ТекСимвол) 
				Или (ЭтоЦифры(ПредСимвол)
							И ТекСимвол = " "
						Или	ЭтоЦифры(ТекСимвол)
							И ПредСимвол = " ")
					И ЭтоЦифры(ТекСлово))
			И Не ЭтоНомерТелефона(ТекСлово) Тогда
				
			Если Не (ЭтоЦифры(ПредСимвол)
					И ТекСимвол = " ") Тогда
				ТекСлово = ТекСлово + ТекСимвол;
			КонецЕсли;
		Иначе
			Массив1Слов.Добавить(ТекСлово);
			ТекСлово = ТекСимвол;
		КонецЕсли;
				
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТекСлово) Тогда
		Массив1Слов.Добавить(ТекСлово);
	КонецЕсли;
	
	Массив2Слов = Новый Массив();
	ТекСлово = "";

	Для Инд = 0 по Массив1Слов.ВГраница() Цикл
		Если ЭтоЦифры(Массив1Слов[Инд])
			И СтрДлина(Массив1Слов[Инд]) = 10 Тогда
			Массив1Слов[Инд] = "7" + Массив1Слов[Инд];
		КонецЕсли;
	КонецЦикла;
	
	ОбратныйПорядокУказанияОписаний = Не ЭтоНомерТелефона(Массив1Слов[0])
									  	И ЭтоНомерТелефона(Массив1Слов[Массив1Слов.ВГраница()]);
				
	Если ОбратныйПорядокУказанияОписаний Тогда
		Массив1Слов = ПеревернутьМассив(Массив1Слов);
	КонецЕсли;
	
	Для Инд = 0 по Массив1Слов.ВГраница() Цикл
		
		Если (Массив2Слов.Количество() = 0 
			  И Не ЭтоНомерТелефона(Массив1Слов[Инд])) Тогда
			Продолжить;
		ИначеЕсли ЭтоНомерТелефона(Массив1Слов[Инд]) Тогда
			Если Не ПустаяСтрока(ТекСлово) Тогда
				Массив2Слов.Добавить(ТекСлово);
				ТекСлово = "";
			КонецЕсли;
			Массив2Слов.Добавить(Массив1Слов[Инд]);
		Иначе 
			ТекСлово = ТекСлово + Массив1Слов[Инд];
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТекСлово) Тогда
		Массив2Слов.Добавить(ТекСлово);
	КонецЕсли;
	
	ТекТелефон = 1;
	
	МассивТелефонОписание = Новый Массив();
	
	ТелефонОписание = Новый Структура("Телефон,Описание", "","");
	
	Для Каждого ТекСлово из Массив2Слов Цикл
		
		Если ЭтоНомерТелефона(ТекСлово) Тогда
			Если Не ПустаяСтрока(ТелефонОписание.Телефон) Тогда
				МассивТелефонОписание.Добавить(ТелефонОписание);
				ТелефонОписание = Новый Структура("Телефон,Описание", "","");
			КонецЕсли; 
			ТелефонОписание.Телефон = ФорматироватьТелефон(ТекСлово);
		ИначеЕсли Не ПустаяСтрока(ТелефонОписание.Телефон) Тогда
			ТелефонОписание.Описание = ФорматироватьОписание(ТекСлово);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТелефонОписание.Телефон) Тогда
		МассивТелефонОписание.Добавить(ТелефонОписание);
	КонецЕсли;
	
	Если ОбратныйПорядокУказанияОписаний Тогда
		МассивТелефонОписание = ПеревернутьМассив(МассивТелефонОписание);
	КонецЕсли;
	
	ТекТелефон = 1;
	
	Для Каждого ТелефонОписание из МассивТелефонОписание Цикл
		Результат["ТелефонМагазина" + ТекТелефон] = ТелефонОписание.Телефон;
		Результат["ТелефонМагазина" + ТекТелефон + "Описание"] = ТелефонОписание.Описание;
		ТекТелефон = ТекТелефон + 1;
		Если ТекТелефон > 3 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
			
	Если ПустаяСтрока(Результат["ТелефонМагазина1"]) Тогда
		Результат["ТелефонМагазина1Описание"] = ИзначальнаяСтрока;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПеревернутьМассив(ИсходныйМассив)
	МассивВрем = Новый Массив;
	Инд = ИсходныйМассив.ВГраница();
	Пока Инд > -1 Цикл
		МассивВрем.Добавить(ИсходныйМассив[Инд]);
		Инд = Инд - 1;
	КонецЦикла;
	
	Возврат МассивВрем;
КонецФункции

Функция ЭтоЦифры(ТекСимвол)
	Возврат СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ТекСимвол);
КонецФункции

Функция ЭтоНомерТелефона(ТекСлово)
	Возврат ЭтоЦифры(ТекСлово)
			И СтрДлина(ТекСлово)= 11;
КонецФункции

Функция ФорматироватьТелефон(Знач СтрокаТелефона) Экспорт
	СтрокаТелефона = СокрЛП(СтрокаТелефона);
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, " ", "");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, "(", "");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, ")", "");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, ":", "");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, "-", "");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, "+", "");
	СтрокаТелефона = СтрЗаменить(СтрокаТелефона, ".", "");
	
	Если Не ЭтоЦифры(СтрокаТелефона) Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрДлина(СтрокаТелефона) = 11 Тогда
		СтрокаТелефона = Прав(СтрокаТелефона, 10);
	ИначеЕсли СтрДлина(СтрокаТелефона) <> 10 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "+7" + " (" + Сред(СтрокаТелефона, 1, 3) + ") " + Сред(СтрокаТелефона, 4, 3) + "-" + Сред(СтрокаТелефона, 7, 2) + "-" + Сред(СтрокаТелефона, 9, 2);
КонецФункции

Функция ФорматироватьОписание(Знач СтрокаОписания)
	СтрокаОписания = СокрЛП(СтрокаОписания);
	
	Если СтрДлина(СтрокаОписания) < 3 Тогда
		Возврат "";
	КонецЕсли;
	
	ПервыйСимвол = Сред(СтрокаОписания, 1, 1);
	
	Если Не СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(ПервыйСимвол)
		И Не СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(ПервыйСимвол)
		И Не ЭтоЦифры(ПервыйСимвол) Тогда
		СтрокаОписания = Прав(СтрокаОписания, СтрДлина(СтрокаОписания) - 1);
	КонецЕсли;
	
	ПоследнийСимвол = Сред(СтрокаОписания, СтрДлина(СтрокаОписания), 1);
	
	Если Не СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(ПоследнийСимвол)
		И Не СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(ПоследнийСимвол)
		И Не ЭтоЦифры(ПоследнийСимвол) Тогда
		СтрокаОписания = Лев(СтрокаОписания, СтрДлина(СтрокаОписания) - 1);
	КонецЕсли;

	СтрокаОписания = СокрЛП(СтрокаОписания);
	
	Если СтрДлина(СтрокаОписания) > 40 Тогда
		СтрокаОписания = СокрЛП(Лев(СтрокаОписания, 40));
	КонецЕсли;
	
	Возврат СтрокаОписания;
КонецФункции

Функция СтавкаНДСПоНоменклатуре(Номенклатура) Экспорт
	УстановитьПривилегированныйРежим(Истина);
    Возврат Маг1СИнтеграцияПереопределяемый.СтавкаНДСПоНоменклатуре(Номенклатура);
КонецФункции

Функция ИсправитьИмяПользователяСоцСети(ИмяПользователя) Экспорт
	
	Результат = ИмяПользователя;
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ИмяПользователяСоцсетиСоотвествуетПравилам(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = СокрЛП(ИмяПользователя);
	
	// Выделяем часть после последнего слеша
	
	ПозицияСлеша = СтрНайти(Результат, "/", НаправлениеПоиска.СКонца);
	
	Если ПозицияСлеша > 0 Тогда
		Результат = Прав(Результат, СтрДлина(Результат) - ПозицияСлеша);
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.ИмяПользователяСоцсетиСоотвествуетПравилам(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Инд = СтрДлина(Результат);
	
	Пока Инд > 0 Цикл
		ТекСимвол = Сред(Результат, Инд, 1); 
		Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.ИмяПользователяСоцсетиСоотвествуетПравилам(ТекСимвол) Тогда
			Результат = СтрЗаменить(Результат, ТекСимвол, "");
		КонецЕсли;
		
		Инд = Инд - 1;
		
		Если Инд > СтрДлина(Результат) Тогда
			Инд = СтрДлина(Результат);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ЕстьЗначениеПеречисления(ИмяПеречисления, ИмяЗначения) Экспорт
	Возврат Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления.Найти(ИмяЗначения) <> Неопределено;
КонецФункции

Функция ПолучитьИмяКонфиграцииПоСокращению(СокращенноеИмяКонфигурации)
	
	Если СокращенноеИмяКонфигурации = "ut" Тогда 
		Возврат "УправлениеТорговлей";
	ИначеЕсли СокращенноеИмяКонфигурации = "erp" Тогда 
		Возврат "УправлениеПредприятием";
	ИначеЕсли СокращенноеИмяКонфигурации = "ka" Тогда 
		Возврат "КомплекснаяАвтоматизация";
	ИначеЕсли СокращенноеИмяКонфигурации = "uherp" Тогда 
		Возврат "УправлениеХолдингомERP";
	ИначеЕсли СокращенноеИмяКонфигурации = "utcrm" Тогда 
		Возврат "УправлениеТорговлей_CRM_2";
	ИначеЕсли СокращенноеИмяКонфигурации = "acc" Тогда 
		Возврат "БухгалтерияПредприятия";
	ИначеЕсли СокращенноеИмяКонфигурации = "unf" Тогда 
		Возврат "УправлениеНебольшойФирмой";
	ИначеЕсли СокращенноеИмяКонфигурации = "rt" Тогда 
		Возврат "Розница";
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СистемаВзаимодействий

Функция МожноПодключатьУведомления() Экспорт
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Возврат ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ТехнологияСервиса.ВерсияБиблиотеки(), "2.0.0.0") >= 0
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция МожноПодключатьВебЧат() Экспорт
	МодульОбсуждений = ОбщегоНазначения.ОбщийМодуль("ОбсужденияСлужебныйКлиентСервер");
	Если МодульОбсуждений <> Неопределено Тогда 
		Возврат МодульОбсуждений.ТипыВнешнихСистем().Свойство("ВебЧат");
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция УчастникиОбсуждения(КлючОбсуждения) Экспорт

	Участники = Новый Массив;
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(КлючОбсуждения);
		УстановитьПривилегированныйРежим(Ложь);
		Если Обсуждение <> Неопределено Тогда
			
			Для каждого Участник Из ПользователиИнформационнойБазы(Обсуждение.Участники) Цикл
				Если Не ЗначениеЗаполнено(Участник.Значение) Тогда
					Продолжить;
				КонецЕсли;
				Участники.Добавить(Участник.Значение);
			КонецЦикла;
			
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_МастерСозданияВитрины(), 
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
		
	Возврат Участники;

КонецФункции

Процедура ДобавитьУчастникаОбсуждения(КлючОбсуждения, Пользователь) Экспорт
	
	Если Не ЗначениеЗаполнено(КлючОбсуждения) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка

		ПользовательСВ = ПользовательСистемыВзаимодействия(Пользователь);
		
		Если ПользовательСВ = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(КлючОбсуждения);
		Если Обсуждение <> Неопределено Тогда
			
			Если Не Обсуждение.Участники.Содержит(ПользовательСВ.Идентификатор) Тогда
				Обсуждение.Участники.Добавить(ПользовательСВ.Идентификатор);
				Обсуждение.Записать();	
			КонецЕсли;
			
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_МастерСозданияВитрины(), 
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
		
КонецПроцедуры

Функция СоздатьОбновитьОбсуждение(НастройкиВитрины, Участники, Создавать) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если НастройкиВитрины.ОсновныеНастройки.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		Заголовок = НСтр("ru='Страница mag1c %ИмяВитрины% - Уведомления'");
		Заголовок = СтрЗаменить(Заголовок, "%ИмяВитрины%", Строка(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация)); 
	Иначе
		Заголовок = НСтр("ru='Витрина %ИмяВитрины% - Уведомления'");
		Заголовок = СтрЗаменить(Заголовок, "%ИмяВитрины%", НастройкиВитрины.ОсновныеНастройки.ИмяВитрины); 
	КонецЕсли;
	
	КлючОбсуждения = НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений.ИдентификаторОбсуждения;
	
	Результат = Новый Структура();
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("Ключ", КлючОбсуждения);
	Результат.Вставить("Успешно", Ложь);
	
	Если Не СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Результат.Успешно = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючОбсуждения)
		И Не Создавать Тогда
		Результат.Успешно = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		ЗаписатьОбсуждение = Ложь;
		
		Если Не ЗначениеЗаполнено(КлючОбсуждения) Тогда
			Обсуждение = СистемаВзаимодействия.СоздатьОбсуждение();
			Обсуждение.Групповое = Истина;
			Обсуждение.Ключ = Строка(Новый УникальныйИдентификатор);
			
			ЗаписатьОбсуждение = Истина;
		Иначе
			Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(КлючОбсуждения);

			Если Обсуждение = Неопределено Тогда
				
				Если Не Создавать Тогда
					ТекстОшибки = НСтр("ru = 'Обсуждение %Ключ не найдено'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Ключ", КлючОбсуждения);
					
					ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_МастерСозданияВитрины(), 
												УровеньЖурналаРегистрации.Ошибка,
												,
												,
												ТекстОшибки);
					Результат.Успешно = Ложь;
					Возврат Результат;
				КонецЕсли;
				
				Обсуждение = СистемаВзаимодействия.СоздатьОбсуждение();
				Обсуждение.Групповое = Истина;
				Обсуждение.Ключ = Строка(Новый УникальныйИдентификатор);
				
				ЗаписатьОбсуждение = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Обсуждение.Заголовок <> Заголовок Тогда
			Обсуждение.Заголовок = Заголовок;
			ЗаписатьОбсуждение = Истина;
		КонецЕсли;
		
		Если Участники <> Неопределено Тогда
			ОбновитьУчастниковОбсуждения(Обсуждение, Результат, Участники);
			ЗаписатьОбсуждение = Истина;
		КонецЕсли;
		
		Если Результат.Ошибки.Количество() = 0
			И ЗаписатьОбсуждение Тогда
			Обсуждение.Записать();
			Результат.Успешно = Истина;
		КонецЕсли;
		
		Результат.Ключ = Обсуждение.Ключ;
		
	Исключение
		Результат.Успешно = Ложь;
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_МастерСозданияВитрины(), 
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	
	Возврат Результат;
КонецФункции

Функция ИдентификаторСлужебногоПользователяСистемыВзаимодействия() Экспорт
	
	Возврат Строка(ПользовательСистемыВзаимодействия(СлужебныйПользовательИБ(Ложь)).Идентификатор);	
	
КонецФункции

Процедура ОбновитьУчастниковОбсуждения(Знач Обсуждение, Знач Результат, Знач Участники)
	
	Обсуждение.Участники.Очистить();
	Сч = 0;
	ПользователиСВ = ПользователиСистемыВзаимодействия(Участники);
	Для каждого Участник Из Участники Цикл
		ПользовательСВ = ПользователиСВ[Участник];
		Если ПользовательСВ = Неопределено Тогда
			Результат.Ошибки.Добавить(Новый Структура("Индекс, Пользователь", Сч, Участник));
		Иначе
			Обсуждение.Участники.Добавить(ПользовательСВ.Идентификатор);
		КонецЕсли;
		Сч = Сч + 1;
	КонецЦикла;

КонецПроцедуры

// Отправляет сообщение через систему взаимодействий
//
// Параметры:
//  Текст								 - ФорматированнаяСтрока 
//  КлючОбсуждения				 		 - Строка
//  ИдентификаторСлужебногоПользователя	 - Строка
//
Процедура ОтправитьСообщениеСистемыВзаимодействий(НастройкиВитрины, Текст) Экспорт
	
	Если НастройкиВитрины = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МожноПодключатьУведомления() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУведомлений = НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений;
	
	Если Не ЗначениеЗаполнено(НастройкиУведомлений.ИдентификаторОбсуждения)
		Или Не ЗначениеЗаполнено(НастройкиУведомлений.ИдентификаторСлужебногоПользователяСистемыВзаимодействия) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(НастройкиУведомлений.ИдентификаторОбсуждения);
		Если Обсуждение <> Неопределено Тогда
			Сообщение       = СистемаВзаимодействия.СоздатьСообщение(Обсуждение.Идентификатор);
			Сообщение.Автор = Новый ИдентификаторПользователяСистемыВзаимодействия(НастройкиУведомлений.ИдентификаторСлужебногоПользователяСистемыВзаимодействия);
			Сообщение.Текст = Текст;
			Сообщение.Записать();
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОшибкаСистемыВзаимодействия(), 
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Создает нового пользователя системы взаимодействий и заполняет его данными пользователя
// информационной базы.
//
// Выбрасывает исключение, если не удалось создать нового пользователя системы Взаимодействия.
//
// Параметры:
// 	Пользователь - СправочникиСсылка.Пользователи - пользователь, для которого будет создан
//													пользователь системы взаимодействия.
// Возвращаемое значение:
// 	ПользовательСистемыВзаимодействия
//
Функция НовыйПользовательСистемыВзаимодействия(ИдентификаторПользователяИнформационнойБазы)
	ПользовательСВ = Неопределено;
	
	Попытка
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
			Новый УникальныйИдентификатор(ИдентификаторПользователяИнформационнойБазы));
		ПользовательСВ = СистемаВзаимодействия.СоздатьПользователя(ПользовательИБ);
		
		ПользовательСВ.Картинка = Новый Картинка(БиблиотекаКартинок.Маг1СЛоготип.ПолучитьДвоичныеДанные());
	    ПользовательСВ.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОшибкаСистемыВзаимодействия(), 
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат ПользовательСВ;
КонецФункции

// Формирует соответствие между идентификаторами пользователей системы взаимодействия
// и элементами справочника Пользователи.
//
// Параметры:
// 	ПользователиСистемыВзаимодействия - Массив Из ИдентификаторПользователяСистемыВзаимодействия
// 									  - КоллекцияИдентификаторовПользователейСистемыВзаимодействия 
// 
// Возвращаемое значение:
// 	Соответствие из КлючИЗначение:
// 	* Ключ - ИдентификаторПользователяСистемыВзаимодействия
// 	* Значение - см. ПользовательИнформационнойБазы
//
Функция ПользователиИнформационнойБазы(ПользователиСистемыВзаимодействия)Экспорт
	ТипыВходныхПараметров = Новый Массив;
	ТипыВходныхПараметров.Добавить(Тип("КоллекцияИдентификаторовПользователейСистемыВзаимодействия"));
	ТипыВходныхПараметров.Добавить(Тип("Массив"));
 	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр("ПользователиИнформационнойБазы",
 		"ПользователиСистемыВзаимодействия",
 		ПользователиСистемыВзаимодействия,
 		ТипыВходныхПараметров);

	Результат = Новый Соответствие;
	Ошибки = Новый Массив;
	Для каждого Идентификатор Из ПользователиСистемыВзаимодействия Цикл
		Попытка
			Результат.Вставить(Идентификатор, ПользовательИнформационнойБазы(Идентификатор));
		Исключение
			Ошибки.Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.Вставить(Идентификатор, Неопределено);
		КонецПопытки;
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		
		ЗаписьЖурналаРегистрации(ОбсужденияСобытиеЖурналаРегистрации(
			НСтр("ru='Пользователи информационной базы'")),
			УровеньЖурналаРегистрации.Ошибка,,,
			СтрСоединить(Ошибки, Символы.ПС + Символы.ПС));
	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ОбсужденияСобытиеЖурналаРегистрации(ДетализацияСобытия = "") Экспорт
 	Возврат НСтр("ru='Обсуждения'", ОбщегоНазначения.КодОсновногоЯзыка())
  					+ ?(ПустаяСтрока(ДетализацияСобытия), "", "."+ДетализацияСобытия);
КонецФункции

// Выполняет поиск элемента справочника Пользователи по идентификатору пользователя Системы Взаимодействия.
//
// Выбрасывает исключение, если пользователь не был найден.
//
// Параметры:
// 	ПользовательСистемыВзаимодействия - ИдентификаторПользователяСистемыВзаимодействия.
//
// Возвращаемое значение:
// 	СправочникСсылка.Пользователи
//
Функция ПользовательИнформационнойБазы(ПользовательСистемыВзаимодействия) 
	Результат = Неопределено;
	
	ПользовательСВ = СистемаВзаимодействия.ПолучитьПользователя(ПользовательСистемыВзаимодействия);
	Результат = Справочники[Маг1СПеречисления.ИменаСправочников_Пользователи()].НайтиПоРеквизиту("ИдентификаторПользователяИБ", ПользовательСВ.ИдентификаторПользователяИнформационнойБазы);
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		ШаблонОшибки = НСтр("ru='Не удалось получить пользователя информационной базы по идентификатору пользователя системы взаимодействия (%1)'");
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибки, Строка(ПользовательСистемыВзаимодействия));
		ВызватьИсключение ОписаниеОшибки;
		
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

// Формирует соответствие между элементами справочника Пользователи
// и идентификаторами пользователей системы взаимодействия.
//  
// Если пользователь не найден, то будет попытка создать пользователя системы взаимодействия.
// Если пользователь не найден и при создании нового пользователя было выброшено исключение,
// то возвращается Неопределено.
//
// Параметры:
// 	ПользователиИнформационнойБазы - Массив Из СправочникСсылка.Пользователи
// 
// Возвращаемое значение:
// 	Соответствие:
// 	* Ключ - СправочникСсылка.Пользователи
// 	* Значение - см. ПользовательСистемыВзаимодействия
//
Функция ПользователиСистемыВзаимодействия(ПользователиИнформационнойБазы) 
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"ПользователиСистемыВзаимодействия",
 		"ПользователиИнформационнойБазы",
 		ПользователиИнформационнойБазы,
 		Тип("Массив"));
	
	Результат = Новый Соответствие;
	Ошибки = Новый Массив;

	Для каждого Пользователь Из ПользователиИнформационнойБазы Цикл
		
		Попытка
			Результат.Вставить(Пользователь, ПользовательСистемыВзаимодействия(Пользователь));
		Исключение
			Ошибки.Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.Вставить(Пользователь, Неопределено);
		КонецПопытки;
		
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_МастерСозданияВитрины(),
			УровеньЖурналаРегистрации.Ошибка,,,
			СтрСоединить(Ошибки, Символы.ПС));
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Получает идентификатор пользователя системы взаимодействия.
// Если пользователь не найден, то будет выполнена попытка создать нового пользователя.
// 
// Выбрасывает исключение, если:
// - не удалось получить идентификатор пользователя информационной базы;
// - не удалось создать пользователя системы Взаимодействия.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
// 				 - СправочникОбъект.Пользователи
// 				 - СправочникОбъект.ПользовательИнформационнойБазы
//
// Возвращаемое значение:
// 	ПользовательСистемыВзаимодействия
//
Функция ПользовательСистемыВзаимодействия(Пользователь) 
	Результат = Неопределено;
	ИдентификаторПользователяИнформационнойБазы = "";             
	Недействителен = Ложь;
	
	УстановитьПривилегированныйРежим(Истина);
	Если ТипЗнч(Пользователь) = Тип("СправочникОбъект." + Маг1СПеречисления.ИменаСправочников_Пользователи()) Тогда
		ИдентификаторПользователяИнформационнойБазы = Пользователь.ИдентификаторПользователяИБ;
		Недействителен = Пользователь.Недействителен;
		
	ИначеЕсли ТипЗнч(Пользователь) = Тип("СправочникСсылка." + Маг1СПеречисления.ИменаСправочников_Пользователи()) Тогда
		ДанныеПользователя = 
				ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Пользователь,
														 "ИдентификаторПользователяИБ, Недействителен");
		ИдентификаторПользователяИнформационнойБазы = ДанныеПользователя.ИдентификаторПользователяИБ;
		Недействителен = ДанныеПользователя.Недействителен;
	ИначеЕсли ТипЗнч(Пользователь) = Тип("ПользовательИнформационнойБазы")
		Или ТипЗнч(Пользователь) = Тип("Структура") Тогда
		ИдентификаторПользователяИнформационнойБазы = Строка(Пользователь.УникальныйИдентификатор);	
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Недействителен Тогда
		ШаблонОшибки = НСтр("ru='Пользователь %1 недействителен'");
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонОшибки,
			Строка(Пользователь));
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторПользователяИнформационнойБазы) Тогда
		ШаблонОшибки = НСтр("ru='Не удалось получить идентификатор пользователя (%1)'");
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонОшибки,
			Строка(Пользователь));
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	ОшибкаПолучениеИдентификатораСВ = "";
			
	Попытка
		ИдентификаторПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(
			Новый УникальныйИдентификатор(ИдентификаторПользователяИнформационнойБазы));
		Результат = СистемаВзаимодействия.ПолучитьПользователя(ИдентификаторПользователяСВ);
	Исключение
		ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ОбсужденияСобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,,,
				ОписаниеОшибки);
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		
		Попытка
			УстановитьПривилегированныйРежим(Истина);
			Результат = НовыйПользовательСистемыВзаимодействия(ИдентификаторПользователяИнформационнойБазы);
			УстановитьПривилегированныйРежим(Ложь);
		Исключение
			ОшибкаПолучениеИдентификатораСВ = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(ОбсужденияСобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ОшибкаПолучениеИдентификатораСВ));
			Результат = Неопределено;
		КонецПопытки;
		
	Иначе
		// Наличие свойства заблокирован зависит от платформы
		СвойстваПользователяСВ = Новый Структура("Заблокирован", Ложь);
		ЗаполнитьЗначенияСвойств(СвойстваПользователяСВ, Результат);
		Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СвойстваПользователяСВ, "Заблокирован", Ложь) Тогда
		
			ШаблонОшибки = НСтр("ru='Пользователь %1 заблокирован в системе взаимодействий'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонОшибки,
				Строка(Пользователь));
			ЗаписьЖурналаРегистрации(ОбсужденияСобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,,,
				ОписаниеОшибки);
				
			Результат = Неопределено;
		
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СлужебныйПользовательИБ(МенятьПароль) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;
	
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяСлужебногоПользователя());
	ЭтоНовый = ПользовательИБ = Неопределено;
	
	МассивРолей = Новый Массив;
	МассивРолей.Добавить("Маг1СИспользованиеМаг1СApi");
	МассивРолей.Добавить("БазовыеПраваБСП");
	МассивРолей.Добавить("БазовыеПраваБТС");
	МассивРолей.Добавить(Маг1СИнтеграцияПереопределяемый.НаименованиеБазовыхПравПриложения());
	МассивРолей.Добавить("ВыполнениеСинхронизацииДанных");
	
	ОписаниеНовогоПользователя           = Пользователи.НовоеОписаниеПользователяИБ();
	ОписаниеНовогоПользователя.Имя       = ИмяСлужебногоПользователя();
	ОписаниеНовогоПользователя.ПолноеИмя = НСтр("ru = 'Сервис mag1c'");
	ОписаниеНовогоПользователя.АутентификацияСтандартная = Истина;
	ОписаниеНовогоПользователя.Роли  = МассивРолей;
		
	РолейНеХватает = МассивРолей.Количество();
	
	Если Не ЭтоНовый Тогда
		Для Каждого РольПользователя из ПользовательИБ.Роли Цикл
			
			Если МассивРолей.Найти(РольПользователя.Имя) <> Неопределено Тогда 
				РолейНеХватает = РолейНеХватает - 1;
			КонецЕсли;
			
		КонецЦикла;              
	КонецЕсли;
	
	Если ЭтоНовый
		Или Не ПользовательИБ.ПарольУстановлен
		Или МенятьПароль
		Или РолейНеХватает > 0 Тогда
		
		Если ЭтоНовый
			Или Не ПользовательИБ.ПарольУстановлен
			Или МенятьПароль Тогда
			
			Пароль = СоздатьПароль();
			ОписаниеНовогоПользователя.Пароль = Пароль;
			Результат.Вставить("Пароль", Пароль);
			
		КонецЕсли;
		
		ПользовательОбъект = Неопределено;
		
		Если Не ЭтоНовый Тогда
			
			Отбор = Новый Структура("ИдентификаторПользователяИБ", ПользовательИБ.УникальныйИдентификатор);
			Выборка = Справочники[Маг1СПеречисления.ИменаСправочников_Пользователи()].Выбрать(,, Отбор);
			Если Выборка.Следующий() Тогда
				ПользовательОбъект = Выборка.ПолучитьОбъект();
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПользовательОбъект = Неопределено Тогда
			ПользовательОбъект = Справочники[Маг1СПеречисления.ИменаСправочников_Пользователи()].СоздатьЭлемент();
		КонецЕсли;
		
		ОписаниеНовогоПользователя.Вставить("Действие", "Записать");
		Если Не ЭтоНовый Тогда
			ОписаниеНовогоПользователя.Вставить("УникальныйИдентификатор", ПользовательИБ.УникальныйИдентификатор);
		КонецЕсли;
		
		ПользовательОбъект.Наименование = НСтр("ru = 'Сервис mag1c'");
		ПользовательОбъект.Служебный = Истина;
		ПользовательОбъект.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеНовогоПользователя);
		ПользовательОбъект.Записать();
		
		Если ЭтоНовый Тогда
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяСлужебногоПользователя());
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("УникальныйИдентификатор", ПользовательИБ.УникальныйИдентификатор);
	Результат.Вставить("Имя", ПользовательИБ.Имя);
	
	Возврат Результат;
	
КонецФункции

