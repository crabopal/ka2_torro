#Область СлужебныеПроцедурыИФункции

#Область РаботаСHTTPСервисами

Функция СтруктураURI(URIСервиса) Экспорт
	
	Возврат ОбщегоНазначенияКлиентСервер.СтруктураURI(URIСервиса);
	
КонецФункции

Функция НовоеHTTPСоединение(СтруктураURI)
	
	Сервер   = СтруктураURI.Хост;
	Порт     = СтруктураURI.Порт;
	Протокол = СтруктураURI.Схема;
	
	ЗащищенноеСоединение = Неопределено;
	Если ВРег(Протокол) = "HTTPS" Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
	КонецЕсли;
	
	Возврат Новый HTTPСоединение(
		Сервер,
		Порт,
		,
		,
		НовыйИнтернетПрокси(Протокол),
		,
		ЗащищенноеСоединение);
	
КонецФункции

Функция НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса) Экспорт
	
	Если Не ПустаяСтрока(ПараметрыАвторизации.СтруктураURI.ПутьНаСервере) Тогда
		АдресРесурса = "/" + ПараметрыАвторизации.СтруктураURI.ПутьНаСервере + АдресРесурса;
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(АдресРесурса);
	Запрос.Заголовки.Вставить("Accept-Encoding", "identity");
	
	Если ПараметрыАвторизации.ТокенАвторизации <> Неопределено Тогда
		ОбновитьЗаголовокАвторизацииHTTPЗапроса(Запрос, ПараметрыАвторизации.ТокенАвторизации);
	КонецЕсли;
	
	ОписаниеКонфигурации = Неопределено;
	
	Если ПараметрыАвторизации.Свойство("ОписаниеКонфигурации", ОписаниеКонфигурации) Тогда
		ИмяКонфигурации = Base64СтрокаИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(ОписаниеКонфигурации.ИмяКонфигурации));
		
		Запрос.Заголовки.Вставить("X-User-Agent-Configuration-Name",    ИмяКонфигурации);
		Запрос.Заголовки.Вставить("X-User-Agent-Configuration-Version", ОписаниеКонфигурации.ВерсияКонфигурации);
		Запрос.Заголовки.Вставить("X-User-Agent-Wizard-Version",        ОписаниеКонфигурации.ВерсияРасширения);
		Запрос.Заголовки.Вставить("X-User-Agent-Infobase-Id",           ОписаниеКонфигурации.ИдентификаторИБ);
		Запрос.Заголовки.Вставить("X-User-Agent-Timezone",              ОписаниеКонфигурации.ЧасовойПоясСеанса);
		Запрос.Заголовки.Вставить("X-User-Agent-Data-Separation-Value", ОписаниеКонфигурации.ЗначениеРазделителяСеанса);
		Запрос.Заголовки.Вставить("X-User-Agent-Platform-Version",      ОписаниеКонфигурации.ВерсияПлатформы);
		
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция Base64СтрокаИзДвоичныхДанных(Данные) Экспорт
	
	Возврат СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ПС,""), Символы.ВК, "");
	
КонецФункции

Функция ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод, ИмяВыходногоФайла = "", КоличествоПопыток = 3) Экспорт
	
	НеизвестныйМетод = Ложь;
	АвторизацияОбновлена = Ложь;
	
	Соединение = НовоеHTTPСоединение(ПараметрыАвторизации.СтруктураURI);
	
	НомерПопытки = 0;
	
	Ответ = Неопределено;
	
	Пока НомерПопытки < КоличествоПопыток Цикл
		
		НомерПопытки = НомерПопытки + 1;
		
		Если Не ПустаяСтрока(ПараметрыАвторизации.ИмяПараметраОтметкиОперации) Тогда
			Запрос.Заголовки.Вставить(ПараметрыАвторизации.ИмяПараметраОтметкиОперации, Строка(Новый УникальныйИдентификатор));		
		КонецЕсли;
		
		Попытка
			Если Метод = Маг1СПеречисления.МетодыHTTP_GET() Тогда 
				
				Ответ = Соединение.Получить(Запрос, ИмяВыходногоФайла);
				
			ИначеЕсли Метод = Маг1СПеречисления.МетодыHTTP_POST() Тогда
				
				Ответ = Соединение.ОтправитьДляОбработки(Запрос, ИмяВыходногоФайла);
				
			ИначеЕсли Метод = Маг1СПеречисления.МетодыHTTP_PUT() Тогда
				
				Ответ = Соединение.Записать(Запрос);
				
			ИначеЕсли Метод = Маг1СПеречисления.МетодыHTTP_DELETE() Тогда
				
				Ответ = Соединение.Удалить(Запрос);
				
			ИначеЕсли Метод = Маг1СПеречисления.МетодыHTTP_PATCH() Тогда
				
				Ответ = Соединение.Изменить(Запрос);
				
			Иначе
				НеизвестныйМетод = Истина;
				Прервать;
			КонецЕсли;
			
			Если Ответ.КодСостояния = 401 
				Или Ответ.КодСостояния = 403
				Или Ответ.КодСостояния = 500 Тогда
				
				Если ПараметрыАвторизации.ТокенАвторизации <> Неопределено 
					И ВРег(ПараметрыАвторизации.ТокенАвторизации.ТипТокена) = "BEARER" Тогда 
					
					Обработки.Маг1СНастройка.ОбновитьТокенАвторизации(ПараметрыАвторизации, Ложь, Ответ.КодСостояния <> 403);
					ОбновитьЗаголовокАвторизацииHTTPЗапроса(Запрос, ПараметрыАвторизации.ТокенАвторизации); 											
				
					Если Не АвторизацияОбновлена Тогда
						АвторизацияОбновлена = Истина;
						НомерПопытки = НомерПопытки - 1;
					Иначе
						Возврат Ответ;
					КонецЕсли;
					
				Иначе
					Возврат Ответ;
				КонецЕсли;
					
			ИначеЕсли Ответ.КодСостояния = 404 Тогда
				
				ТелоОтвета = НРег(Ответ.ПолучитьТелоКакСтроку());
				
				Если СтрНайти(ТелоОтвета, "ошибка: приложение") > 0
					И СтрНайти(ТелоОтвета, "не найдено") > 0 Тогда
					
 					ДействиеПриСбоеОбращенияКСерверу(ПараметрыАвторизации,
													 Запрос, 
													 Метод, 
													 НомерПопытки, 
													 КоличествоПопыток,
													 Ответ);
				Иначе
					Возврат Ответ;
				КонецЕсли;
				
			ИначеЕсли Ответ.КодСостояния = 502
				Или Ответ.КодСостояния = 503
				Или Ответ.КодСостояния = 504 Тогда				
				ДействиеПриСбоеОбращенияКСерверу(ПараметрыАвторизации,
												 Запрос, 
												 Метод,
												 НомерПопытки, 
												 КоличествоПопыток,
												 Ответ);					
			Иначе
				Возврат Ответ;
			КонецЕсли;
		Исключение
			ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ДействиеПриСбоеОбращенияКСерверу(ПараметрыАвторизации,
											 Запрос, 
											 Метод, 
											 НомерПопытки, 
											 КоличествоПопыток,
											 520, 
											 ИнформацияОбОшибке);
		КонецПопытки;
			
	КонецЦикла;
	
	Если НеизвестныйМетод Тогда
		ТекстИсключения = НСтр("ru = 'Неизвестный метод http %Метод'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Метод", Метод);
		ВызватьИсключение ТекстИсключения;	
	КонецЕсли;
	
	Если Ответ = Неопределено Тогда
	
		ТекстОшибки = НСтр("ru = 'Было сделано %ТекстКоличествоПопыток выполнить обращение к сервису, но они не завершились успехом. Подробности - см. Журнал регистрации'");
		
		ТекстКоличествоПопыток = СтрокаСЧислом(НСтр("ru = ';%1 попытка; ;%1 попытки;%1 попыток;%1 попытка'"), КоличествоПопыток, ВидЧисловогоЗначения.Количественное);
		                                                     
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ТекстКоличествоПопыток", ТекстКоличествоПопыток); 
		
		ТекстОшибки = Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(ПараметрыАвторизации,
																		Запрос,
																		Метод,
																		0,
																		ТекстОшибки);
		ВызватьИсключение ТекстОшибки;	
	Иначе
		Возврат Ответ;
	КонецЕсли;

КонецФункции

Процедура ДействиеПриСбоеОбращенияКСерверу(ПараметрыАвторизации, Запрос, Метод, НомерПопытки, КоличествоПопыток, ОтветКодСостояния, Знач ОписаниеОшибки = Неопределено)
	
	Если ОписаниеОшибки = Неопределено Тогда
		Если ТипЗнч("ОтветКодСостояния") = Тип("HTTPОтвет") Тогда
			ОписаниеОшибки = ОтветКодСостояния.ПолучитьТелоКакСтроку();
		Иначе
			ОписаниеОшибки = НСтр("ru = '<Нет описания ошибки>'");
		КонецЕсли;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Номер попытки: %НомерПопытки. Ошибка: %ОписаниеОшибки'");
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерПопытки", НомерПопытки);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ОписаниеОшибки", ОписаниеОшибки);
	
	ТекстОшибки = Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(ПараметрыАвторизации,
																	Запрос,
																	Метод,
																	ОтветКодСостояния,
																	ТекстОшибки);
			
	Если НомерПопытки > КоличествоПопыток Тогда
		ВызватьИсключение ТекстОшибки;							
	Иначе
		ЗаписьЖурналаРегистрации(НСтр("ru = 'mag1c: Обращение к ресурсам через сеть'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		Маг1СИнтеграцияСлужебный.Пауза(3 * НомерПопытки);
	КонецЕсли;

КонецПроцедуры

Функция ОбновитьЗаголовокАвторизацииHTTPЗапроса(Запрос, ТокенАвторизации) Экспорт
	Если ТокенАвторизации <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Authorization", ТокенАвторизации.ТипТокена + " " + ТокенАвторизации.ИдентификаторТокена);
	КонецЕсли;
КонецФункции

Функция ОписаниеОшибкиСервиса(ПараметрыАвторизации, Запрос, Метод, ОтветКодСостояния, Знач ОписаниеОшибки = Неопределено) Экспорт
	
	Если ОписаниеОшибки = Неопределено Тогда
		ОписаниеОшибки = "";
	КонецЕсли;
	
	Если ТипЗнч(ОтветКодСостояния) = Тип("HTTPОтвет") Тогда
		ТекстИзТела = ОтветКодСостояния.ПолучитьТелоКакСтроку();
		Если Не ПустаяСтрока(ТекстИзТела) Тогда
			ОписаниеОшибки = ТекстИзТела + Символы.ВК + ОписаниеОшибки;
		КонецЕсли;
	КонецЕсли;
		
	Если ПустаяСтрока(ОписаниеОшибки) Тогда	
		ОписаниеОшибки = НСтр("ru = '<Нет описания ошибки>'")
	КонецЕсли;
	
	Если ТипЗнч(ОтветКодСостояния) = Тип("HTTPОтвет") Тогда
		КодСостояния = XMLСтрока(ОтветКодСостояния.КодСостояния);
	Иначе
		КодСостояния = XMLСтрока(ОтветКодСостояния);
	КонецЕсли;
	
	
	Если ПустаяСтрока(ПараметрыАвторизации.ИмяПараметраОтметкиОперации) Тогда
    	ТекстОшибки = НСтр("ru = 'Сервер: %ИмяСервера%
								|Адрес ресурса: %АдресРесурса%
								|Метод: %Метод%
								|Код ответа: %КодОтвета%
								|
								|Описание: %Описание%'");
	    ОтметкаОперации = "";
	Иначе
    	ТекстОшибки = НСтр("ru = 'Сервер: %ИмяСервера%
								|Адрес ресурса: %АдресРесурса%
								|Метод: %Метод%
								|Отметка операции: %ОтметкаОперации%
								|Код ответа: %КодОтвета%
								|
								|Описание: %Описание%'");
		ОтметкаОперации = Запрос.Заголовки.Получить(ПараметрыАвторизации.ИмяПараметраОтметкиОперации);
	КонецЕсли;
	
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ИмяСервера%", ПараметрыАвторизации.СтруктураURI.ИмяСервера);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%АдресРесурса%", Запрос.АдресРесурса);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Метод%", Метод);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%КодОтвета%", КодСостояния);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Описание%", ОписаниеОшибки);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ОтметкаОперации%", ОтметкаОперации);
		
	Возврат ТекстОшибки;	
КонецФункции

Функция НовыйИнтернетПрокси(Протокол)
	
	Возврат ПолучениеФайловИзИнтернета.ПолучитьПрокси(Протокол);
	
КонецФункции

Функция СтруктураВСтрокуJSON(Источник, ИмяФайла = "") Экспорт
	
	Запись = Новый ЗаписьJSON;
	Если ПустаяСтрока(ИмяФайла) Тогда
		Запись.УстановитьСтроку();
	Иначе
		Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	КонецЕсли;
	
	ЗаписатьJSON(Запись, Источник);
	
	Возврат Запись.Закрыть();
	
КонецФункции

Функция СтрокаJSONВСоответствие(Источник) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Источник);
	
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаJSONВСтруктуру(Источник) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Источник);
	
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	
	ЧтениеJSON.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция СсылкаВСтрокуJSON(Ссылка) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяСправочника", Ссылка.Метаданные().Имя);
	Результат.Вставить("Ид", Строка(Ссылка.УникальныйИдентификатор()));
	
	Возврат СтруктураВСтрокуJSON(Результат);
КонецФункции

Функция СтрокаJSONВСсылку(СтрокаJSON) Экспорт
	Если Не ЗначениеЗаполнено(СтрокаJSON)
		Или ТипЗнч(СтрокаJSON) <> Тип("Строка")
		Или ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ОписаниеСсылки = СтрокаJSONВСтруктуру(СтрокаJSON);
		Ссылка = Справочники[ОписаниеСсылки.ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(ОписаниеСсылки.Ид));
		Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			Возврат Ссылка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции
#КонецОбласти

#Область РаботаСБезопаснымХранилищем

Процедура СохранитьСведенияАутентификацииВМенеджере(ЛогинИПП, СведенияАутентификации) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если Не ПустаяСтрока(ЛогинИПП) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_.АутентификацияВМенеджере", СведенияАутентификации, КлючПоЛогинуИПП(ЛогинИПП));
	Иначе
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_.АутентификацияВМенеджере", СведенияАутентификации);
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры

Функция ПрочитатьСведенияАутентификацииВМенеджере(ЛогинИПП) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Если Не ПустаяСтрока(ЛогинИПП) Тогда
		СведенияАутентификации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_.АутентификацияВМенеджере", КлючПоЛогинуИПП(ЛогинИПП));
	Иначе
		СведенияАутентификации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_.АутентификацияВМенеджере");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СведенияАутентификации;
	
КонецФункции

Процедура СохранитьТокенАвторизацииВМенеджере(ЛогинИПП, ТокенАвторизации) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если Не ПустаяСтрока(ЛогинИПП) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_.ТокенАвторизацииВМенеджере", ТокенАвторизации, КлючПоЛогинуИПП(ЛогинИПП));
	Иначе
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_.ТокенАвторизацииВМенеджере", ТокенАвторизации);
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры

Функция ПрочитатьТокенАвторизацииВМенеджере(ЛогинИПП) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ТокенАвторизации = Неопределено;
	Если Не ПустаяСтрока(ЛогинИПП) Тогда
		ТокенАвторизации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_.ТокенАвторизацииВМенеджере", КлючПоЛогинуИПП(ЛогинИПП));
	Иначе
		ТокенАвторизации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_.ТокенАвторизацииВМенеджере");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат КорректныйТокенАвторизации(ТокенАвторизации);
	
КонецФункции

