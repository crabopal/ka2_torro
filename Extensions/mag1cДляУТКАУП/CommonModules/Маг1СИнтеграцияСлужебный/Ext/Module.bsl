	ТокенАвторизации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".ТокенАвторизацииНаВитрине");
	УстановитьПривилегированныйРежим(Ложь);

	Возврат КорректныйТокенАвторизации(ТокенАвторизации);
	
КонецФункции

Процедура СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Попытка
		Если СтрокаСпискаВитрин <> Неопределено Тогда
			ОсновныеНастройки = СостояниеМастера.НастройкиВитрины.ОсновныеНастройки;
			
			СтрокаСпискаВитрин.УзелОбмена   = ОсновныеНастройки.УзелОбмена;
			СтрокаСпискаВитрин.РежимВитрины = ОсновныеНастройки.РежимВитрины;		
			СтрокаСпискаВитрин.Организация  = ОсновныеНастройки.ПараметрыУчета.Организация;
			
			ЗаполнитьЗначенияСвойств(ОсновныеНастройки, СтрокаСпискаВитрин);
			СохранитьВСпискеВитринБазы(СтрокаСпискаВитрин, Ложь);
		КонецЕсли;
		
		СостояниеМастера.ВерсияФорматаСохраненныхНастроек = ТекущаяВерсияФорматаНастроек();
		
		ОбновитьСписокИменОМВРеквизитахСвойств(СостояниеМастера.НастройкиВитрины);
		
		ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины); 
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_" + ИдентификаторНастройки + ".НастройкиВитрины", СостояниеМастера);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		
	    ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_МастерСозданияВитрины(),
	        УровеньЖурналаРегистрации.Ошибка,
	        ,
	        ,
	        Сообщение);
			
			ВызватьИсключение Сообщение;
				
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

