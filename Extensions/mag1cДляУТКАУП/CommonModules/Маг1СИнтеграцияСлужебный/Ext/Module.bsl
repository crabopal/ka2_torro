Процедура ОбновитьРасширение(ПараметрыАвторизации) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НужноПроверитьОбновление = Истина;
	ТекущаяУниверсальнаяДата = ТекущаяУниверсальнаяДата();
	ВерсияРасширения         = ВерсияРасширения();
	ИмяМастерКонфигурации    = Метаданные.Имя;
	
	НовоеЗначение = СтруктураИнформацииОбОбновлении();
	НовоеЗначение.ДатаПредыдущейПроверки = ТекущаяУниверсальнаяДата;
	НовоеЗначение.ВерсияРасширения       = ВерсияРасширения;
	
	Попытка
		
		ПредыдущееЗначение = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИмяПараметраДатаПроверки());
		
		Если ПредыдущееЗначение <> Неопределено Тогда
			
			Если ПредыдущееЗначение.ДатаПредыдущейПроверки >= ТекущаяУниверсальнаяДата - 60*60 Тогда
				НужноПроверитьОбновление = Ложь;
				Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ПредыдущееЗначение.ВерсияРасширения, ВерсияРасширения) > 0 Тогда
					//т.е. расширение обновлено, но этот сеанс не перезапускался
					ПараметрыАвторизации.РасширениеОбновлено = Истина;
				КонецЕсли;
			КонецЕсли;
			
			НовоеЗначение.Уведомление       = ПредыдущееЗначение.Уведомление;

		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеРасширения(), 
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если Не НужноПроверитьОбновление Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ТолькоПроверка =
			ОбщегоНазначения.РазделениеВключено()
			Или Не ВерсияПлатформыПоддерживаетОбновлениеРасширений().ВерсияПодходит;

		//Обратимся к сервису в любом случае, чтобы залогировать версию конфигурации и версию расширения и получить уведомление
		ДанныеРасширения = Обработки.Маг1СНастройка.ПолучитьОбновлениеРасширения(ПараметрыАвторизации, ТолькоПроверка);
		
		Если ЗначениеЗаполнено(ДанныеРасширения.Уведомление) Тогда
			НовоеЗначение.Уведомление = ДанныеРасширения.Уведомление;
			
			НастройкиВитрин = Маг1СИнтеграция.СписокНастроекВитрин();
			
			СтрокаУведомления = ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки(ДанныеРасширения.Уведомление));
			
			СтруктураУведомления = СтрокаJSONВСтруктуру(СтрокаУведомления);
			
			МассивСтрок = Новый Массив;
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(СтруктураУведомления.Subject,Новый Шрифт(,,Истина)));
			МассивСтрок.Добавить(Символы.ПС);
			МассивСтрок.Добавить(Символы.ПС);
			МассивСтрок.Добавить(СтруктураУведомления.Text);
			
			Если ЗначениеЗаполнено(СтруктураУведомления.Hyperlink) Тогда
				
				ПредставлениеСсылки = СтруктураУведомления.Hyperlink;
				
				Если ЗначениеЗаполнено(СтруктураУведомления.HyperlinkPresentation) Тогда
					ПредставлениеСсылки = СтруктураУведомления.HyperlinkPresentation;
				КонецЕсли;
				
				СтрокаСсылки = Новый ФорматированнаяСтрока(ПредставлениеСсылки,,,,СтруктураУведомления.Hyperlink);
				
				МассивСтрок.Добавить(Символы.ПС);
				МассивСтрок.Добавить(СтрокаСсылки);
				
				
			КонецЕсли;
			
			Текст = Новый ФорматированнаяСтрока(МассивСтрок);
			
			Для Каждого КлючЗначение из НастройкиВитрин Цикл
				ОтправитьСообщениеСистемыВзаимодействий(КлючЗначение.Значение, Текст); 	
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеРасширения.ИмяМастерКонфигурации) Тогда
			ИмяМастерКонфигурации = ПолучитьИмяКонфиграцииПоСокращению(ДанныеРасширения.ИмяМастерКонфигурации);
		КонецЕсли;
		
		Если ТолькоПроверка
			Или Не ДанныеРасширения.ЕстьОбновление 
			Или ТипЗнч(ДанныеРасширения.Данные) <> Тип("ДвоичныеДанные") Тогда
			
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ИмяПараметраДатаПроверки(), НовоеЗначение);
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ИмяПараметраИмяМастерКонфигурации(), ИмяМастерКонфигурации);
			Возврат;
		КонецЕсли;

		ТекущееРасширение = Метаданные.Обработки.Маг1СНастройка.РасширениеКонфигурации();	
		ТекущееРасширение.Записать(ДанныеРасширения.Данные);

		ПараметрыАвторизации.РасширениеОбновлено = Истина;
		НовоеЗначение.ВерсияРасширения = ДанныеРасширения.ВерсияРасширения;
		
	Исключение
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеРасширения(), 
			УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ИмяПараметраДатаПроверки(), НовоеЗначение);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ИмяПараметраИмяМастерКонфигурации(), ИмяМастерКонфигурации);
	
КонецПроцедуры

Функция ВерсияПлатформыПоддерживаетОбновлениеРасширений()
	
	Результат = Новый Структура("ВерсияПодходит, РекомендуемаяВерсия", Истина, "");
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	ВерсияПлатформы = СистемнаяИнформация.ВерсияПриложения;
	
	ЧастиВерсии = СтрРазделить(ВерсияПлатформы, ".");
	
	Если Число(ЧастиВерсии[1]) > 3 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) >= 17 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) < 15 Тогда
		Результат.ВерсияПодходит      = Ложь;
		Результат.РекомендуемаяВерсия = "8.3.17.1851";
		Возврат Результат;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) = 15 Тогда
		Если Число(ЧастиВерсии[3]) >= 1859 Тогда
			Возврат Результат;
		Иначе
			Результат.ВерсияПодходит      = Ложь;
			Результат.РекомендуемаяВерсия = "8.3.15.2107";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) = 16 Тогда
		Если Число(ЧастиВерсии[3]) >= 1167 Тогда
			Возврат Результат;
		Иначе
			Результат.ВерсияПодходит      = Ложь;
			Результат.РекомендуемаяВерсия = "8.3.16.1814";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияПлатформыПоддерживаетПреобразованиеPNG() Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	ВерсияПлатформы = СистемнаяИнформация.ВерсияПриложения;
	
	ЧастиВерсии = СтрРазделить(ВерсияПлатформы, ".");
	
	Если Число(ЧастиВерсии[2]) >= 18 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) < 15 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) = 15 Тогда
		Если Число(ЧастиВерсии[3]) >= 2107 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) = 16 Тогда
		Если Число(ЧастиВерсии[3]) >= 1791 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Число(ЧастиВерсии[2]) = 17 Тогда
		Если Число(ЧастиВерсии[3]) >= 1823 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Процедура ОтключитьАвтообновление() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	НовоеЗначение = СтруктураИнформацииОбОбновлении();
	НовоеЗначение.ДатаПредыдущейПроверки = ДобавитьМесяц(ТекущаяУниверсальнаяДата(), 60);
	НовоеЗначение.ВерсияРасширения = ВерсияРасширения();
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ИмяПараметраДатаПроверки(), НовоеЗначение);	

КонецПроцедуры

Функция СтруктураИнформацииОбОбновлении()
	НовоеЗначение = Новый Структура;
	НовоеЗначение.Вставить("ДатаПредыдущейПроверки");
	НовоеЗначение.Вставить("ВерсияРасширения");
	НовоеЗначение.Вставить("Уведомление", "");
	
	Возврат НовоеЗначение;
КонецФункции

Процедура ВключитьАвтообновление() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ИмяПараметраДатаПроверки());
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ИмяПараметраДатаОбновленияСпискаВитрин());
КонецПроцедуры

#КонецОбласти

#Область ПлатежныеСистемы

Функция ЮКассаПодключена(Организация) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Подключена", Ложь);
	Результат.Вставить("ЭтоТестовыйМагазинЮКасса", Ложь);
	Результат.Вставить("ИдМагазина", 0);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НастройкиЮКасса = НастройкиЮКассы(Организация, Ложь);
	
	Если ЭтаНастройкаЮКассыПодходит(НастройкиЮКасса) Тогда
		Результат.Подключена = Истина;
		Результат.ИдМагазина = НастройкиЮКасса.ИдентификаторМагазина;
	КонецЕсли;
	
	Если Результат.Подключена Тогда
		Результат.ЭтоТестовыйМагазинЮКасса = Обработки.Маг1СНастройка.ЭтоТестовыйМагазинЮКасса(Результат.ИдМагазина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтаНастройкаЮКассыПодходит(НастройкиЮКассы)
	Если НастройкиЮКассы = Неопределено
		Или Не НастройкиЮКассы.СДоговором
		Или НастройкиЮКассы.ИдентификаторВитрины <> 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция НастройкиЮКассы(Организация, ВыдаватьИсключение = Истина) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиЮКассы = Неопределено;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если Не НастройкиУчетнойСистемы.ПоддерживаетсяОплатаЧерезЮКасса Тогда
		Возврат НастройкиЮКассы;
	КонецЕсли;
	
	ТекстЗапроса = "";
	
	Если Метаданные.Справочники.Найти("НастройкиОнлайнОплат") <> Неопределено Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиОнлайнОплат.Ссылка КАК Ссылка,
		|	НастройкиОнлайнОплат.СДоговором КАК СДоговором,
		|	НастройкиОнлайнОплат.ИдентификаторМагазина КАК ИдентификаторМагазина,
		|	НастройкиОнлайнОплат.ИдентификаторВитрины КАК ИдентификаторВитрины,
		|	НастройкиОнлайнОплат.ОтправкаЧековЧерезСервис КАК ОтправкаЧековЧерезСервис
		|ИЗ
		|	Справочник.НастройкиОнлайнОплат КАК НастройкиОнлайнОплат
		|ГДЕ
		|	НастройкиОнлайнОплат.Организация = &Организация
		|	И НЕ НастройкиОнлайнОплат.Недействительна
		|	И НЕ НастройкиОнлайнОплат.ПометкаУдаления";
				
	ИначеЕсли Метаданные.Справочники.Найти("НастройкиЯндексКассы") <> Неопределено Тогда 
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиЯндексКассы.Ссылка КАК Ссылка,
		|	НастройкиЯндексКассы.СДоговором КАК СДоговором,
		|	НастройкиЯндексКассы.ИдентификаторМагазина КАК ИдентификаторМагазина,
		|	НастройкиЯндексКассы.ИдентификаторВитрины КАК ИдентификаторВитрины,
		|	НастройкиЯндексКассы.ОтправкаЧековЧерезЯндекс КАК ОтправкаЧековЧерезСервис
		|ИЗ
		|	Справочник.НастройкиЯндексКассы КАК НастройкиЯндексКассы
		|ГДЕ
		|	НастройкиЯндексКассы.Организация = &Организация
		|	И НЕ НастройкиЯндексКассы.Недействительна
		|	И НЕ НастройкиЯндексКассы.ПометкаУдаления";
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстЗапроса) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса; 
		Запрос.УстановитьПараметр("Организация", Организация);
	
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			НастройкиЮКассы = Новый Структура;
			НастройкиЮКассы.Вставить("Ссылка");
			НастройкиЮКассы.Вставить("СДоговором");
			НастройкиЮКассы.Вставить("ИдентификаторМагазина");
			НастройкиЮКассы.Вставить("ИдентификаторВитрины");
			НастройкиЮКассы.Вставить("ОтправкаЧековЧерезСервис");
			
			ЗаполнитьЗначенияСвойств(НастройкиЮКассы, Выборка);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЭтаНастройкаЮКассыПодходит(НастройкиЮКассы) Тогда
		НастройкиЮКассы = Неопределено;
	КонецЕсли;
		
	Если ВыдаватьИсключение 
		И НастройкиЮКассы = Неопределено Тогда
		              
		ТекстИсключения = НСтр("ru = 'Для организации %Организация% Ю-Касса не настроена, обновить токен доступа к Ю-Кассе невозможно.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Организация%",Организация);
		ВызватьИсключение ТекстИсключения;
		
	КонецЕсли;
	
	Возврат НастройкиЮКассы
	
КонецФункции

Функция ПараметрыФормыНастройкиЮКасса()
	ИмяФормыНастройки = "";
	Раздел            = "";

	МетаданныеОбработки = Метаданные.Обработки.Найти("ПанельАдминистрированияБИП");
	Если МетаданныеОбработки  <> Неопределено Тогда
		Если МетаданныеОбработки.Формы.Найти("ИнтернетПоддержкаИСервисы") <> Неопределено Тогда
			ИмяФормыНастройки    = "Обработка.ПанельАдминистрированияБИП.Форма.ИнтернетПоддержкаИСервисы";
			Раздел = "ОнлайнОплаты";
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(ИмяФормыНастройки) Тогда
		Если Метаданные.Справочники.Найти("НастройкиОнлайнОплат") <> Неопределено Тогда
			ИмяФормыНастройки = "Обработка.ПанельАдминистрированияБСП.Форма.ИнтернетПоддержкаИСервисы";
			Раздел            = "ОнлайнОплаты"
		ИначеЕсли Метаданные.Справочники.Найти("НастройкиЯндексКассы") <> Неопределено Тогда
			Если Метаданные.Обработки.Найти("ПанельАдминистрированияБЭД") <> Неопределено Тогда
				ИмяФормыНастройки = "Обработка.ПанельАдминистрированияБЭД.Форма.ОбщиеНастройки";
			Иначе
				ИмяФормыНастройки = "Обработка.ПанельАдминистрированияЭДО.Форма.ОбменЭлектроннымиДокументами";
			КонецЕсли;
			Раздел            = "НастройкиЯКасса"
		КонецЕсли;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Имя", ИмяФормыНастройки);
	ПараметрыФормы.Вставить("Раздел", Раздел);
		
	Возврат ПараметрыФормы

КонецФункции

