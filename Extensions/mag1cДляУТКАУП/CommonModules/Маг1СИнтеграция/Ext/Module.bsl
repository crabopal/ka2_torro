#Область ПрограммныйИнтерфейс

#Область НастройкиВитрины

// Возвращает сохраненные настройки витрины, приведенные к текущей версии. Если нет сохраненных настроек - возвращает Неопределено
// 
// Возвращаемое значение:
// 	- Структура - настройки витрины:
//  	*ОсновныеНастройки - Структура - см. Маг1СИнтеграцияСлужебный.СтруктураПользовательскихНастроекВитрины
//	    *ДополнительныеНастройки  - Структура - см. Маг1СИнтеграцияСлужебный.СтруктураСлужебныхНастроекВитрины
//	    *НастройкиУчетнойСистемы  - Структура - см. Маг1СИнтеграцияСлужебный.НастройкиУчетнойСистемы
//
Функция НастройкиВитрины(ИдентификаторВитриныУзелОбмена) Экспорт
	
	Если ТипЗнч(ИдентификаторВитриныУзелОбмена) = Тип("Строка") Тогда
		СтрокаСпискаВитрин = СтрокаСпискаВитринПоИдентификаторуВитрины(ИдентификаторВитриныУзелОбмена);
	Иначе
		СтрокаСпискаВитрин = СтрокаСпискаВитринПоУзлуОбмена(ИдентификаторВитриныУзелОбмена);
	КонецЕсли;	
	
	Если СтрокаСпискаВитрин = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		СписокВитрин = Новый Структура(Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СтрокаСпискаВитрин.ИдентификаторВитрины),
										СтрокаСпискаВитрин);
	КонецЕсли;
	
	СостояниеМастера = Маг1СИнтеграцияСлужебный.ПрочитатьСостояниеМастераНастройкиВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины);

	Если СостояниеМастера = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СостояниеМастера.НастройкиВитрины;
	
КонецФункции

Функция СписокНастроекВитрин() Экспорт
	Результат = Новый Структура();

	СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	Если СписокВитрин.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючЗначение из СписокВитрин Цикл
	
		СостояниеМастера = Маг1СИнтеграцияСлужебный.ПрочитатьСостояниеМастераНастройкиВитрины(КлючЗначение.Значение.ИдентификаторВитрины);
	
		Если СостояниеМастера = Неопределено Тогда
			Продолжить;
		КонецЕсли;
	
		НастройкиВитрины = СостояниеМастера.НастройкиВитрины;

		Результат.Вставить(КлючЗначение.Ключ, НастройкиВитрины);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ЭтоУзелОбменаСВитриной(УзелОбмена) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Возврат ОбщегоНазначения.СсылкаСуществует(УзелОбмена)
		И ОбменДаннымиПовтИсп.ПолучитьИмяПланаОбмена(УзелОбмена) = НастройкиУчетнойСистемы.ИмяПланаОбмена
		И ОбменДаннымиСервер.СохраненныйВариантНастройкиУзлаПланаОбмена(УзелОбмена) = ИдентификаторВариантаНастройкиОбмена();
	
КонецФункции

Функция СтрокаСпискаВитринПоУзлуОбмена(УзелОбмена) Экспорт
	
	СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	Если СписокВитрин.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого КлючЗначение из СписокВитрин Цикл
		
		Если КлючЗначение.Значение.УзелОбмена = УзелОбмена Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция СтрокаСпискаВитринПоИдентификаторуВитрины(ИдентификаторВитрины) Экспорт
	
	СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	Если СписокВитрин.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины);
	
	СписокВитрин.Свойство(ИдентификаторНастройки, Результат);
	
	Возврат Результат;
		
КонецФункции

Функция ИмяСправочника(НастройкиУчетнойСистемы, ИмяПараметраНастройки) Экспорт
	
	ОграничениеТипа = НастройкиУчетнойСистемы[ИмяПараметраНастройки].ОграничениеТипа; 
	Если ОграничениеТипа <> Неопределено Тогда
		Возврат ОграничениеТипа.ПривестиЗначение().Метаданные().Имя;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция МетаданныеСправочникаПоНастройке(ИмяПараметраНастройки) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ОграничениеТипа = НастройкиУчетнойСистемы[ИмяПараметраНастройки].ОграничениеТипа; 
	Если ОграничениеТипа <> Неопределено Тогда
		Возврат ОграничениеТипа.ПривестиЗначение().Метаданные();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция УзелОбменаСеансаОбмена() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ИмяПараметрыСеансаСинхронизацииДанных = "ПараметрыСеансаСинхронизацииДанных";
		ТекущийПараметрСеанса = ПараметрыСеанса[ИмяПараметрыСеансаСинхронизацииДанных].Получить();
	Исключение
		ТекущийПараметрСеанса = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(ТекущийПараметрСеанса) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТекущийПараметрСеанса.Получить("Маг1С_УзелОбменаСеансаОбмена"); 
	
КонецФункции

Функция ИдентификаторВариантаНастройкиОбмена() Экспорт
	Возврат "ВебВитрина";
КонецФункции

Функция ПредставлениеСправочника(ИмяПараметраНастройки) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	МетаданныеСправочника = МетаданныеСправочникаПоНастройке(ИмяПараметраНастройки); 
	
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МетаданныеСправочника.ПредставлениеСписка) Тогда
		Возврат МетаданныеСправочника.ПредставлениеСписка;
	Иначе
		Возврат МетаданныеСправочника.Синоним;
	КонецЕсли;
КонецФункции

Функция ПараметрВыбораСтруктура(ИмяПоля, Значение) Экспорт
	Возврат Новый Структура("Имя,Значение", ИмяПоля, Значение)
КонецФункции

Функция ВФиксМассивПараметровВыбора(МассивСтруктур) Экспорт 
	Результат = Новый Массив();
	Для Каждого СтрМас из МассивСтруктур Цикл
		Результат.Добавить(Новый ПараметрВыбора(СтрМас.Имя, СтрМас.Значение));
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(Результат);
КонецФункции

#КонецОбласти

#Область НеобходимостьВыгрузкиДополнительныхДанных

Процедура ЗарегистрироватьНеобходимостьВыгрузкиДополнительныхДанных(ИдентификаторВитрины, КлючДанных, ПараметрДанных, НомерСообщения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	СохраненныеСведения = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".ВыгрузкаДополнительныхДанных");
	Если СохраненныеСведения = Неопределено Тогда
		СохраненныеСведения = Новый Структура;
	КонецЕсли;
	
	Если Не СохраненныеСведения.Свойство(КлючДанных) Тогда
		СохраненныеСведения.Вставить(КлючДанных, Новый Соответствие());
	КонецЕсли;
	
	Если ТипЗнч(ПараметрДанных) = Тип("Массив") Тогда
		Для Каждого СтрМас из ПараметрДанных Цикл
			СохраненныеСведения[КлючДанных].Вставить(СтрМас, НомерСообщения);
		КонецЦикла;
	Иначе
		СохраненныеСведения[КлючДанных].Вставить(ПараметрДанных, НомерСообщения);
	КонецЕсли;
	
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_" + ИдентификаторНастройки + ".ВыгрузкаДополнительныхДанных", СохраненныеСведения);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПрочитатьНеобходимостьВыгрузкиДополнительныхДанных(ИдентификаторВитрины) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины); 
	СохраненныеСведения = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Маг1С_" + ИдентификаторНастройки + ".ВыгрузкаДополнительныхДанных");
	Если СохраненныеСведения = Неопределено Тогда
		СохраненныеСведения = Новый Структура;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СохраненныеСведения;
	
КонецФункции

Процедура УдалитьРегистрациюВыгрузкиДополнительныхДанных(ИдентификаторВитрины, УдалитьНачинаяС, НомерСообщения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СохраненныеСведения = Маг1СИнтеграция.ПрочитатьНеобходимостьВыгрузкиДополнительныхДанных(ИдентификаторВитрины);
	
	Если СохраненныеСведения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючДанных из СохраненныеСведения Цикл
		
		Для Каждого КлючЗначение из КлючДанных.Значение Цикл
			
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Дата") Тогда
				Если КлючЗначение.Значение < УдалитьНачинаяС Тогда
					КлючДанных.Значение.Удалить(КлючЗначение.Ключ);	
				КонецЕсли;
			ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Число") Тогда
				Если КлючЗначение.Значение < НомерСообщения Тогда
					КлючДанных.Значение.Удалить(КлючЗначение.Ключ);	
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		Если КлючДанных.Значение.Количество() = 0 Тогда
			СохраненныеСведения.Удалить(КлючДанных.Ключ)
		КонецЕсли;
	КонецЦикла;
	ИдентификаторНастройки = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ИдентификаторВитрины);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("Маг1С_" + ИдентификаторНастройки + ".ВыгрузкаДополнительныхДанных", СохраненныеСведения);
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ЭтоПолнаяВыгрузка(ИдентификаторВитрины, НастройкиУчетнойСистемы) Экспорт
	ЭтоПолнаяВыгрузка = Ложь;

	СохраненныеСведения = ПрочитатьНеобходимостьВыгрузкиДополнительныхДанных(ИдентификаторВитрины);

	Если СохраненныеСведения.Количество() > 0 Тогда
		
		ИмяСправочникаКартинокНоменклатуры = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());

		Если СохраненныеСведения.Свойство(ИмяСправочникаКартинокНоменклатуры) Тогда
			
			ПараметрыФормирования = СохраненныеСведения[ИмяСправочникаКартинокНоменклатуры];
			
			Для Каждого КлючЗначение из ПараметрыФормирования Цикл
				Если КлючЗначение.Ключ = Маг1СПеречисления.КлючиРегистрацииКОбмену_ВсяНоменклатура() Тогда
					ЭтоПолнаяВыгрузка = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоПолнаяВыгрузка;
КонецФункции

Процедура ОтметитьЧтоЭтоПолнаяВыгрузка(ИдентификаторВитрины, НомерОтправленного)
	
	НастройкиУчетнойСистемы            = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	ИмяСправочникаКартинокНоменклатуры = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	
	ЗарегистрироватьНеобходимостьВыгрузкиДополнительныхДанных(ИдентификаторВитрины,
														  		ИмяСправочникаКартинокНоменклатуры,
														  		Маг1СПеречисления.КлючиРегистрацииКОбмену_ВсяНоменклатура(),
																НомерОтправленного);

	
КонецПроцедуры

Процедура ЗарегистрироватьНеобходимостьВыгрузкиОписанийСвойствТоваров(НастройкиВитрины) Экспорт
	
	УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	Если УзелОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(УзелОбмена)
		И Не ОбщегоНазначения.СсылкаСуществует(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	
	ВыгружаемыеСвойстваСлепок  = Маг1СИнтеграцияСлужебный.ПрочитатьСлепокВыгружаемыхСвойств(ИдентификаторВитрины);
	РегистрируемыеСвойства = Новый Массив();
	
	Если ВыгружаемыеСвойстваСлепок <> Неопределено Тогда
	
		Для Каждого КлючЗначение из ВыгружаемыеСвойстваСлепок Цикл
			РегистрируемыеСвойства.Добавить(КлючЗначение.Значение);		
		КонецЦикла;
		
	КонецЕсли;
	НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерОтправленного");
	ЗарегистрироватьНеобходимостьВыгрузкиДополнительныхДанных(
					ИдентификаторВитрины,
					Маг1СПеречисления.КлючиРегистрацииКОбмену_СвойстваТоваров(),
					РегистрируемыеСвойства,
					НомерОтправленного);

КонецПроцедуры

Процедура ЗарегистрироватьКОбменуЗначениеСсылочногоСвойства(УзелИнформационнойБазы, Ссылка, НомерОтправленного) Экспорт
	
	Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоРегистрацииИзменений(УзелИнформационнойБазы);
	
	Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(Свойство);
	
	НоваяСтрока = Набор.Добавить();
	НоваяСтрока.Объект   = Ссылка;
	НоваяСтрока.Свойство = Свойство;
	НоваяСтрока.Значение = НомерОтправленного + 1; 
	
	Набор.Записать();

КонецПроцедуры

Процедура УдалитьРегистрациюКОбменуЗначенийСсылочныхСвойств(УзелИнформационнойБазы, НомерОтправленного) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение <= &НомерОтправленного";
	
	Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоРегистрацииИзменений(УзелИнформационнойБазы);
	
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("НомерОтправленного", НомерОтправленного);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Выборка.Объект);
		Набор.Отбор.Свойство.Установить(Свойство);
		
		Набор.Записать();
    КонецЦикла;
КонецПроцедуры

Процедура СохранитьПубличныеИдентификаторыВыгруженныхСсылочныхЗначенийСвойств(УзелИнформационнойБазы, НомерОтправленного) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Ссылка
	|ПОМЕСТИТЬ ВТТаблицаВыгруженных
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение <= &НомерОтправленного
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТаблицаВыгруженных.Ссылка КАК Ссылка
	|ИЗ
	|	ВТТаблицаВыгруженных КАК ВТТаблицаВыгруженных
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
	|		ПО ВТТаблицаВыгруженных.Ссылка = ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка
	|			И (ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелОбмена)
	|ГДЕ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Идентификатор ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("УзелОбмена", УзелИнформационнойБазы); 
	
	Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоРегистрацииИзменений(УзелИнформационнойБазы);
	
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("НомерОтправленного", НомерОтправленного);
			
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("Ссылка", Выборка.Ссылка);
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзелИнформационнойБазы);
		СтруктураЗаписи.Вставить("Идентификатор", Выборка.Ссылка.УникальныйИдентификатор());
		
		ПубличныеИдентификаторыСинхронизируемыхОбъектовИмя = Маг1СПеречисления.ИменаСправочников_ПубличныеИдентификаторыСинхронизируемыхОбъектов();
		
		РегистрыСведений[ПубличныеИдентификаторыСинхронизируемыхОбъектовИмя].ДобавитьЗапись(СтруктураЗаписи, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ЗарегистрироватьКОбменуДляВременнойСсылки(УзелОбмена, Ссылка, СрокДействияСсылки, НаПланеОбмена, НомерОтправленного) Экспорт
	
	Маг1СИнтеграцияСлужебный.ЗарегистрироватьКОбмену(УзелОбмена, Ссылка, НаПланеОбмена, НомерОтправленного); 
		
	Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоДляВременныхСсылок(УзелОбмена);
	
	Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Ссылка);
	Набор.Отбор.Свойство.Установить(Свойство);
	
	НоваяСтрока = Набор.Добавить();
	НоваяСтрока.Объект   = Ссылка;
	НоваяСтрока.Свойство = Свойство;
	
	Если ТипЗнч(СрокДействияСсылки) = Тип("Дата") Тогда
		НоваяСтрока.Значение = СрокДействияСсылки;
	Иначе
		НоваяСтрока.Значение = ТекущаяУниверсальнаяДата() 
			+ 60 * Маг1СПеречисления.СрокиДействияВременныхСсылокВМинуты(СрокДействияСсылки); 
	КонецЕсли;
		
	Набор.Записать();

КонецПроцедуры

Функция ЗначениеНужноДляВременнойСсылкиДо(УзелОбмена, Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДополнительныеСведения.Объект КАК Объект,
	|   ДополнительныеСведения.Значение КАК ДатаОкончанияДействияСсылки
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект
	|	И ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение > &ТекущаяУниверсальнаяДата";
	
	Запрос.УстановитьПараметр("Объект", Ссылка); 
	Запрос.УстановитьПараметр("Свойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоДляВременныхСсылок(УзелОбмена)); 
	Запрос.УстановитьПараметр("ТекущаяУниверсальнаяДата", ТекущаяУниверсальнаяДата()); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаОкончанияДействияСсылки;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УдалитьОтметкуНужностиДляВременнойСсылки(УзелОбмена) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение <= &ТекущаяУниверсальнаяДата";
	
	Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоРегистрацииИзменений(УзелОбмена);
	
	Запрос.УстановитьПараметр("Свойство",  Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоДляВременныхСсылок(УзелОбмена));
	Запрос.УстановитьПараметр("ТекущаяУниверсальнаяДата", ТекущаяУниверсальнаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Выборка.Объект);
		Набор.Отбор.Свойство.Установить(Свойство);
		
		Набор.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьНеактуальныеОтметкиНужностиДляВременнойСсылки() Экспорт 
	
	ДатаПредыдущейОчистки = Маг1СИнтеграцияСлужебный.ПрочитатьДатуОчисткиДополнительныхСведений();
	
	Если ТекущаяУниверсальнаяДата() - ДатаПредыдущейОчистки < 86400 Тогда
		Возврат;
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебный.СохранитьДатуОчисткиДополнительныхСведений();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТСвойства
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Имя ПОДОБНО """ + Маг1СПеречисления.ДопСвойства_ПередачаВСервисДляВременныхСсылок() +"%""
	|;
	|ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Объект,
	|	ДополнительныеСведения.Свойство КАК Свойство
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство В (ВЫБРАТЬ Ссылка ИЗ ВТСвойства)
	|	И ДополнительныеСведения.Значение <= &ТекущаяУниверсальнаяДата";
	Запрос.УстановитьПараметр("ТекущаяУниверсальнаяДата", ТекущаяУниверсальнаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Выборка.Объект);
		Набор.Отбор.Свойство.Установить(Выборка.Свойство);
		
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура УдалитьНеактуальныеДополнительныеСведения() Экспорт 
	
	ДопСвойстваПоВитринам = Маг1СПеречисления.ДопСвойстваПоВитринам();
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ДопСвойстваКУдалению = Новый Соответствие;
	ПроверенныеУзлы = Новый Соответствие();
	
	Для Каждого ИмяСвойства из ДопСвойстваПоВитринам Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка,
		|	ДополнительныеРеквизитыИСведения.Имя,
		|	ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	ДополнительныеРеквизитыИСведения.Имя ПОДОБНО """ + ИмяСвойства +"%""";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
            ЭтоГуид = Ложь;
			КодУзла = СтрЗаменить(Выборка.Имя, ИмяСвойства, ""); 
			
			Если Выборка.ЭтоДополнительноеСведение Тогда
				КодУзла = СтрЗаменить(КодУзла, "_", "");
				КодУзла = Лев(КодУзла, 8)
						+ "-" + Сред(КодУзла, 9, 4)
						+ "-" + Сред(КодУзла, 13, 4)
						+ "-" + Сред(КодУзла, 17, 4)
						+ "-" + Прав(КодУзла, 12);
			КонецЕсли;
						
			Попытка
				Гуид = новый УникальныйИдентификатор(КодУзла);
				ЭтоГуид = Истина;
			Исключение
            	ЭтоГуид = Ложь;
			КонецПопытки;
			
			Если Не ЭтоГуид
				Или ПустаяСтрока(КодУзла) Тогда
				
				Продолжить;
			КонецЕсли;
			
			Если ПроверенныеУзлы.Получить(КодУзла) = Неопределено Тогда
				МенеджерПланаОбмена = ПланыОбмена[НастройкиУчетнойСистемы.ИмяПланаОбмена];
				УзелСсылка = МенеджерПланаОбмена.НайтиПоКоду(КодУзла);
				ПроверенныеУзлы.Вставить(КодУзла, ЗначениеЗаполнено(УзелСсылка));
			КонецЕсли;
			
			Если Не ПроверенныеУзлы.Получить(КодУзла) Тогда
				ДопСвойстваКУдалению.Вставить(Выборка.Ссылка, 
					Новый Структура("ЭтоДополнительноеСведение, ИмяСвойства", 
										Выборка.ЭтоДополнительноеСведение,
										ИмяСвойства));
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
	Если ДопСвойстваКУдалению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение из ДопСвойстваКУдалению Цикл
		
		Если КлючЗначение.Значение.ЭтоДополнительноеСведение Тогда
			ИмяТЧНабора = "ДополнительныеСведения";
		Иначе
			ИмяТЧНабора = "ДополнительныеРеквизиты";
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НаборыТЧ.Ссылка КАК Набор,
		|	НаборыТЧ.Свойство КАК Свойство
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ИмяТЧНабора КАК НаборыТЧ
		|ГДЕ
		|	НаборыТЧ.Свойство = &Свойство";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТЧНабора", ИмяТЧНабора);
		
		Запрос.УстановитьПараметр("Свойство", КлючЗначение.Ключ);
		Выборка = Запрос.Выполнить().Выбрать();
		
		НачатьТранзакцию();
		
		Попытка
			Пока Выборка.Следующий() Цикл
				НаборОбъект = Выборка.Набор.ПолучитьОбъект();
				НайденныеСтроки = НаборОбъект[ИмяТЧНабора].НайтиСтроки(Новый Структура("Свойство", КлючЗначение.Ключ));
				
				Для Каждого СтрТаб из НайденныеСтроки Цикл
					НаборОбъект[ИмяТЧНабора].Удалить(СтрТаб);
				КонецЦикла;
				
				НаборОбъект.Записать();
			КонецЦикла;
			
			Если Не КлючЗначение.Значение.ЭтоДополнительноеСведение Тогда
				ИмяСправочника = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы,
					Маг1СПеречисления.ДопСвойстваИмяНастройкиНабораСвойств(КлючЗначение.Значение.ИмяСвойства));
					
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ДопРеквизитыСправочника.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ИмяСправочника.ДополнительныеРеквизиты КАК ДопРеквизитыСправочника
				|ГДЕ
				|	ДопРеквизитыСправочника.Свойство = &Свойство";
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочника", ИмяСправочника);
				Запрос.УстановитьПараметр("Свойство", КлючЗначение.Ключ);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Пока Выборка.Следующий() Цикл
					СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
					НайденныеСтроки = НаборОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", КлючЗначение.Ключ));
					
					Для Каждого СтрТаб из НайденныеСтроки Цикл
						СпрОбъект.ДополнительныеРеквизиты.Удалить(СтрТаб);
					КонецЦикла;
					
					СпрОбъект.Записать();
				КонецЦикла;
			
			КонецЕсли;
			
			ДопСвойствоОбъект = КлючЗначение.Ключ.ПолучитьОбъект();
			ДопСвойствоОбъект.Удалить();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ОписаниеОшибки = ИнформацияОбОшибке();
			
			ТекстСообщения = НСтр("ru = 'Ошибка при удалении неакутального доп. свойства %ДопСвойство: %ОписаниеОшибки'");
			
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДопСвойство", КлючЗначение.Ключ); 
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки", ПодробноеПредставлениеОшибки(ОписаниеОшибки)); 
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеНастроекВитрины(),
							УровеньЖурналаРегистрации.Ошибка,
							КлючЗначение.Ключ.Метаданные(),
							КлючЗначение.Ключ,
							ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ПравилаОбмена

#Область Общее

Процедура ПередКонвертацией(КомпонентыОбмена) Экспорт
	ПараметрыКонвертации = КомпонентыОбмена.ПараметрыКонвертации;
	
	ПараметрыКонвертации.Вставить("СкладОстатков", Неопределено);
	ПараметрыКонвертации.Вставить("ВыгружатьИнформативныеОстатки", Ложь);
	ПараметрыКонвертации.Вставить("ВыгружатьКартинки", Ложь);
	ПараметрыКонвертации.Вставить("НастройкиФильтровНоменклатуры", Неопределено);
	ПараметрыКонвертации.Вставить("УслугаДоставки", Неопределено);
	ПараметрыКонвертации.Вставить("ВариантНастройки", "");
	ПараметрыКонвертации.Вставить("НастройкиВитрины", Неопределено);
	ПараметрыКонвертации.Вставить("ИдентификаторВитрины", Неопределено);
	ПараметрыКонвертации.Вставить("ЗаказыДляОтмены", Новый Массив);
	ПараметрыКонвертации.Вставить("ВидЦен", Неопределено);
	ПараметрыКонвертации.Вставить("НомерОтправленного", 0);
	
	ПараметрыКонвертации.Вставить("СозданныеПриВыгрузкеОбъекты", Новый Массив);
	
	ПараметрыКонвертации.Вставить("НастройкиЮКассы", Неопределено);
	ПараметрыКонвертации.Вставить("КешОписанийСвойствТоваров", Новый Соответствие);
	ПараметрыКонвертации.Вставить("ГруппыТоваровВладельцыФайлов", Новый Соответствие);
	
	Если Не КомпонентыОбмена.ЭтоОбменЧерезПланОбмена Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыУзла = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КомпонентыОбмена.УзелКорреспондента, "ВариантНастройки,НомерОтправленного");
	
	ПараметрыКонвертации.ВариантНастройки = РеквизитыУзла.ВариантНастройки;
	ПараметрыКонвертации.НомерОтправленного = РеквизитыУзла.НомерОтправленного;
	
	НастройкиВитрины = НастройкиВитрины(КомпонентыОбмена.УзелКорреспондента); 
	
	Если НастройкиВитрины = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки <> ИдентификаторВариантаНастройкиОбмена() Тогда
		Возврат;
	КонецЕсли;
			
	ПараметрыКонвертации.ВыгружатьИнформативныеОстатки = НастройкиВитрины.ОсновныеНастройки.ВыгружатьИнформативныеОстатки;
	ПараметрыКонвертации.ВыгружатьКартинки             = НастройкиВитрины.ОсновныеНастройки.ВыгружатьКартинки;
	
	ПараметрыКонвертации.СкладОстатков = НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Склад;
	ПараметрыКонвертации.ВидЦен        = НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен;
	ПараметрыКонвертации.НастройкиФильтровНоменклатуры = НастройкиФильтровНоменклатуры(НастройкиВитрины);
	ПараметрыКонвертации.УслугаДоставки   = НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.УслугаДоставки;
	ПараметрыКонвертации.НастройкиВитрины = НастройкиВитрины;
	ПараметрыКонвертации.ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	
	ПараметрыКонвертации.НастройкиЮКассы = Маг1СИнтеграцияСлужебный.НастройкиЮКассы(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация, Ложь);
	
	Если КомпонентыОбмена.НаправлениеОбмена = "Отправка" Тогда
		ОтменитьРегистрациюНеподдерживаемыхОбъектов(КомпонентыОбмена);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры) Экспорт
	Если Не ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяПроцедуры = "ПКО_СсылочныеЗначенияСвойств_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_СсылочныеЗначенияСвойств_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
		
	ИначеЕсли ИмяПроцедуры = "ПОД_СсылочныеЗначенияСвойств_Отправка_ПриОбработке" Тогда 
		ПОД_СсылочныеЗначенияСвойств_Отправка_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
		
	ИначеЕсли ИмяПроцедуры = "ПОД_Маг1С_КартинкиКатегорийТоваров_Отправка_ПриОбработке" Тогда 
		ПОД_Маг1С_КартинкиКатегорийТоваров_Отправка_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
			
	ИначеЕсли ИмяПроцедуры = "Маг1С_ПКО_КартинкиКатегорийТоваров_Отправка_ПриОтправкеДанных" Тогда
		Маг1С_ПКО_КартинкиКатегорийТоваров_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
		
	ИначеЕсли ИмяПроцедуры = "ПКО_Справочник_СвойстваТоваров_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Справочник_СвойстваТоваров_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
		
	ИначеЕсли ИмяПроцедуры = "ПОД_Справочник_СвойстваТоваров_Отправка_ПриОбработке" Тогда 
		ПОД_Справочник_СвойстваТоваров_Отправка_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
		
	ИначеЕсли ИмяПроцедуры = "Маг1с_ПОД_Справочник_Файлы_Получение_ПриОбработке" Тогда 
		Маг1с_ПОД_Справочник_Файлы_Получение_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
		
	ИначеЕсли ИмяПроцедуры = "Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПриКонвертацииДанныхXDTO" Тогда 
		Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПриКонвертацииДанныхXDTO(
			Параметры.ДанныеXDTO, Параметры.ПолученныеДанные, Параметры.КомпонентыОбмена);
		
	ИначеЕсли ИмяПроцедуры = "Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПередЗаписьюПолученныхДанных" Тогда 
		Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПередЗаписьюПолученныхДанных(
			Параметры.ПолученныеДанные, Параметры.ДанныеИБ, Параметры.КонвертацияСвойств, Параметры.КомпонентыОбмена);
		
	ИначеЕсли ИмяПроцедуры = "Маг1С_ПОД_Справочник_СостоянияЗаказовПокупателей_Получение_ПриОбработке" Тогда 
		Маг1С_ПОД_Справочник_СостоянияЗаказовПокупателей_Получение_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
	
	ИначеЕсли ИмяПроцедуры = "Маг1С_ПКО_Справочник_ВидыНоменклатуры_Отправка_ПриОтправкеДанных" Тогда 
		Маг1С_ПКО_Справочник_ВидыНоменклатуры_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
			
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации) Экспорт
	Если Не ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	Если НаправлениеОбмена = "Отправка" Тогда
		ДобавитьПКО_СсылочныеЗначенияСвойств_Отправка(ПравилаКонвертации);
		ДобавитьПКО_Справочник_СвойстваТоваров_Отправка(ПравилаКонвертации);
		ДобавитьПКО_Маг1С_КартинкиКатегорийТоваров_Отправка(ПравилаКонвертации);
		
		ДополнитьПКО_Справочник_Номенклатура_Отправка(ПравилаКонвертации);
	КонецЕсли;

	Если НаправлениеОбмена = "Получение" Тогда
        Маг1с_ДобавитьПКО_ЗаказыПокупателейПрисоединенныеФайлы_Получение(ПравилаКонвертации);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПравилаОбработкиДанных(НаправлениеОбмена, ПравилаОбработкиДанных) Экспорт
	Если Не ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	Если НаправлениеОбмена = "Отправка" Тогда
        ДобавитьПОД_СсылочныеЗначенияСвойств_Отправка(ПравилаОбработкиДанных);
        ДобавитьПОД_Справочник_СвойстваТоваров_Отправка(ПравилаОбработкиДанных);
		ДобавитьПОД_КартинкиКатегорий_Отправка(ПравилаОбработкиДанных);
	КонецЕсли;
	
	Если НаправлениеОбмена = "Получение" Тогда
        Маг1с_ДобавитьПОД_ЗаказыПокупателейПрисоединенныеФайлы_Получение(ПравилаОбработкиДанных);
		Маг1с_ДобавитьПОД_Справочник_СостоянияЗаказовПокупателей_Получение(ПравилаОбработкиДанных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеКонвертации(КомпонентыОбмена) Экспорт
	Если Не ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если КомпонентыОбмена.НаправлениеОбмена = "Получение" Тогда
		ОтменитьЗаказы(КомпонентыОбмена)
	КонецЕсли;
	
	Если КомпонентыОбмена.НаправлениеОбмена <> "Отправка" Тогда
		Возврат;
	КонецЕсли;
	
	Если КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ОсновныеНастройки.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		Возврат;
	КонецЕсли;
	
	НомерСообщения = КомпонентыОбмена.ПараметрыКонвертации.НомерОтправленного + 1;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ВсеВидыЦен = ВсеИспользуемыеВидыЦен(КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины);
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ИдентификаторВитрины = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	
	ЭтоПолнаяВыгрузка = ЭтоПолнаяВыгрузка(ИдентификаторВитрины, НастройкиУчетнойСистемы); 
	
	ИспользуемыеСплепкиВидовЦен = Новый Соответствие;
	
	Для Каждого СтрМас из ВсеВидыЦен Цикл
    	ИмяСлепка = ВыгрузитьЦены(КомпонентыОбмена, МенеджерВременныхТаблиц, НомерСообщения, СтрМас, ЭтоПолнаяВыгрузка);
		ИспользуемыеСплепкиВидовЦен.Вставить(ИмяСлепка, Истина);
	КонецЦикла;
	
	ВсеИменаСлепков = Маг1СИнтеграцияСлужебный.МассивВсехНастроек(ИдентификаторВитрины, Истина);
	
	Для Каждого ИмяСлепка из ВсеИменаСлепков Цикл
		
		Если СтрНайти(ИмяСлепка, "Цены") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИспользуемыеСплепкиВидовЦен.Получить(ИмяСлепка) = Неопределено Тогда
			Маг1СИнтеграцияСлужебный.УдалитьСлепокДанных(ИдентификаторВитрины, ИмяСлепка);
		КонецЕсли;
		
	КонецЦикла;
	
	ВыгрузитьОстатки(ИдентификаторВитрины, КомпонентыОбмена, МенеджерВременныхТаблиц, НомерСообщения, ЭтоПолнаяВыгрузка);
	
	ВыгрузитьОписанияСвойствТоваров(ИдентификаторВитрины, КомпонентыОбмена, ЭтоПолнаяВыгрузка); 
	
	ВыгрузитьЗначенияСсылочныхСвойствЗарегистрированныеКОбмену(ИдентификаторВитрины, КомпонентыОбмена);
	
	ВыгрузитьКартинкиТоваровЗарегистрированныеКОбмену(Маг1СПеречисления.ИменаСправочников_Файлы(), КомпонентыОбмена);	
	ВыгрузитьКартинкиТоваровЗарегистрированныеКОбмену(Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки(), КомпонентыОбмена);	
	ВыгрузитьКартинкиТоваровЗарегистрированныеКОбмену(Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки(), КомпонентыОбмена);	
	
	ВыгрузитьУпаковкиЗарегистрированныеКОбмену(ИдентификаторВитрины, КомпонентыОбмена);	
КонецПроцедуры
 
Процедура ОтменитьРегистрациюНеподдерживаемыхОбъектов(КомпонентыОбмена)
	
	НомерОтправленного = КомпонентыОбмена.ПараметрыКонвертации.НомерОтправленного;
	УзелКорреспондента = КомпонентыОбмена.УзелКорреспондента;
	НастройкиУчетнойСистемы =  Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(УзелКорреспондента, НомерОтправленного);
	
	ТипыДляОтмены              = Новый Соответствие;
	ОбъектыМетаданныхДляОтмены = Новый Массив;
	
	ОбъектыДляОтменыРегистрации = Новый Массив;
	
	ТипыДляОбменаПоПравилам = Новый Соответствие;
	
	Для Каждого ИмяТипа из НастройкиУчетнойСистемы.ИменаТиповДляОбменаПоПравилам Цикл
		ТипыДляОбменаПоПравилам.Вставить(Тип(ИмяТипа), Истина);	
	КонецЦикла;
	
	Пока ВыборкаИзменений.Следующий() Цикл
		
		Объект           = ВыборкаИзменений.Получить();
		ТипЗначения      = ТипЗнч(Объект);
		
		Если ТипЗначения = Тип("УдалениеОбъекта") Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектМетаданных = Объект.Метаданные();
		
		Если ТипыДляОбменаПоПравилам.Получить(ТипЗначения) = Неопределено Тогда
			
			Если ТипыДляОтмены.Получить(ТипЗначения) = Неопределено Тогда
				ОбъектыМетаданныхДляОтмены.Добавить(ОбъектМетаданных);
				ТипыДляОтмены.Вставить(ТипЗначения);
			КонецЕсли;
			
		ИначеЕсли КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ОсновныеНастройки.РежимВитрины
			= Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда	
			
			Если ОбщегоНазначения.ЭтоДокумент(ОбъектМетаданных)
				Или ОбщегоНазначения.ЭтоСправочник(ОбъектМетаданных)
				Или ОбщегоНазначения.ЭтоПланВидовХарактеристик(ОбъектМетаданных)
				Или ОбщегоНазначения.ЭтоПланСчетов(ОбъектМетаданных)
				Или ОбщегоНазначения.ЭтоПланВидовРасчета(ОбъектМетаданных) Тогда
				
				Если ЗначениеНужноДляВременнойСсылкиДо(УзелКорреспондента, Объект.Ссылка) = Неопределено Тогда
					ОбъектыДляОтменыРегистрации.Добавить(Объект);
				КонецЕсли;
			Иначе
				ОбъектыДляОтменыРегистрации.Добавить(Объект);
			КонецЕсли;
			
		КонецЕсли;		
			
	КонецЦикла;
	
	Для Каждого СтрМас из ОбъектыМетаданныхДляОтмены Цикл
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелКорреспондента, СтрМас);	
	КонецЦикла;
	
	Если ОбъектыДляОтменыРегистрации.Количество() > 0 Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелКорреспондента, ОбъектыДляОтменыРегистрации);	
	КонецЕсли;

КонецПроцедуры

#Область ДобавитьПКС
Функция ДобавитьПКТЧ(ПравилоКонвертации, ИмяТЧКонфигурации, ИмяТЧФормата)
    Если ПравилоКонвертации.СвойстваТабличныхЧастей.Колонки.Количество() = 0 Тогда
        ОбменДаннымиXDTOСервер.ИнициализироватьСвойстваТабличныхЧастей(ПравилоКонвертации);
    КонецЕсли;
    КонвертацияТабличнойЧасти                = ПравилоКонвертации.СвойстваТабличныхЧастей.Добавить();
    КонвертацияТабличнойЧасти.ТЧКонфигурации = ИмяТЧКонфигурации;
    КонвертацияТабличнойЧасти.ТЧФормата      = ИмяТЧФормата;
    КонвертацияТабличнойЧасти.Свойства       = ОбменДаннымиXDTOСервер.ИнициализироватьТаблицуСвойствДляПравилаКонвертации();
    Возврат КонвертацияТабличнойЧасти.Свойства;
КонецФункции

Процедура ДобавитьПКС(РодительПКС, СвойствоКонфигурации, СвойствоФормата, ИспользуетсяАлгоритмКонвертации = 0, 
                    ПравилоКонвертацииСвойства = "")
	НоваяСтрока                                 = РодительПКС.Добавить();
	НоваяСтрока.СвойствоКонфигурации            = СвойствоКонфигурации;
	НоваяСтрока.СвойствоФормата                 = СвойствоФормата;
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = ?(ИспользуетсяАлгоритмКонвертации = 0, Ложь, Истина);
	НоваяСтрока.ПравилоКонвертацииСвойства      = ПравилоКонвертацииСвойства;
КонецПроцедуры
#КонецОбласти

Функция ЭтоОбменСМаг1с(КомпонентыОбмена = Неопределено) Экспорт
	
	Если КомпонентыОбмена = Неопределено Тогда
		Возврат УзелОбменаСеансаОбмена() <> Неопределено;
	Иначе
		Возврат КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = ИдентификаторВариантаНастройкиОбмена();
	КонецЕсли;
	
КонецФункции

Процедура ВыгрузитьКартинкиТоваровЗарегистрированныеКОбмену(ИмяСправочника, КомпонентыОбмена)
	
	Если ИмяСправочника = Маг1СПеречисления.ИменаСправочников_Файлы() Тогда
		ИмяСправочникаЗнач = ИмяСправочника;
	Иначе
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		ИмяСправочникаЗнач = ИмяСправочника(НастройкиУчетнойСистемы, ИмяСправочника);
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяСправочникаЗнач) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Ссылка
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &ДопРеквизит
	|	И ДополнительныеСведения.Объект ССЫЛКА Справочник.ИмяСправочника";
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочника", ИмяСправочникаЗнач);
	
	Запрос.УстановитьПараметр("ДопРеквизит", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоРегистрацииИзменений(КомпонентыОбмена.УзелКорреспондента));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Правило = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		Если Правило = Неопределено Тогда
			Если ИмяСправочника = Маг1СПеречисления.ИменаСправочников_Файлы() Тогда
				Правило = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Маг1С_КартинкиКатегорийТоваров_Отправка", "Имя");
			Иначе
				Правило = КомпонентыОбмена.ПравилаОбработкиДанных.Найти(НастройкиУчетнойСистемы[ИмяСправочника].ПОД_Отправка, "Имя");
			КонецЕсли;
		КонецЕсли;
		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, 
			Выборка.Ссылка, 
			Правило);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьУпаковкиЗарегистрированныеКОбмену(ИдентификаторВитрины, КомпонентыОбмена)
	ЗарегистрированныеСведения = ПрочитатьНеобходимостьВыгрузкиДополнительныхДанных(ИдентификаторВитрины);
	
	ВсеУпаковки = Неопределено;
	
	ЗарегистрированныеСведения.Свойство(Маг1СПеречисления.ИменаСправочников_Упаковки(), ВсеУпаковки);
	
	Если Не ЗначениеЗаполнено(ВсеУпаковки)
		Или ТипЗнч(ВсеУпаковки) = Тип("Соответствие")
			И ВсеУпаковки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Правило = КомпонентыОбмена.ПравилаОбработкиДанных.Найти(НастройкиУчетнойСистемы[Маг1СПеречисления.ИменаСправочников_Упаковки()].ПОД_Отправка, "Имя");
	
	Для Каждого КлючЗначение из ВсеУпаковки Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Ключ) Тогда
			ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, 
				КлючЗначение.Ключ, 
				Правило);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СсылочныеЗначенияСвойств

Процедура ВыгрузитьЗначенияСсылочныхСвойствЗарегистрированныеКОбмену(ИдентификаторВитрины, КомпонентыОбмена)
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Ссылка
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &ДопРеквизит
	|	И НЕ ДополнительныеСведения.Объект ССЫЛКА Справочник.Файлы
	|	И НЕ ДополнительныеСведения.Объект ССЫЛКА Справочник.ИмяСправочникаНоменклатураКартинки";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"ИмяСправочникаНоменклатураКартинки",
		ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки()));
		
	ИмяСправочникаХарактеристикиКартинки = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	
	Если Не ПустаяСтрока(ИмяСправочникаХарактеристикиКартинки) Тогда
			
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ ДополнительныеСведения.Объект ССЫЛКА Справочник." + ИмяСправочникаХарактеристикиКартинки;
		
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ДопРеквизит", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоРегистрацииИзменений(КомпонентыОбмена.УзелКорреспондента));
	
	Правило = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("СсылочныеЗначенияСвойств_Отправка", "Имя");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, 
			Выборка.Ссылка, 
			Правило);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПОД_СсылочныеЗначенияСвойств_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "СсылочныеЗначенияСвойств_Отправка";
	ПравилоОбработки.ПриОбработке            = "ПОД_СсылочныеЗначенияСвойств_Отправка_ПриОбработке";
