Функция ТекстФильтраПоПараметрамОтбора(Запрос, ИмяПараметраНастройки, ИмяПоляВЗапросе) Экспорт
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если НастройкиУчетнойСистемы[ИмяПараметраНастройки].ПараметрыВыбора.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстыУсловий = Новый Массив;
	
	Счетчик = 0;
	
	Для Каждого ПараметрВыбора из НастройкиУчетнойСистемы[ИмяПараметраНастройки].ПараметрыВыбора Цикл
		Счетчик = Счетчик + 1;
		ИмяПараметра = ПараметрВыбора.Имя;
		ИмяПараметра = СтрЗаменить(ИмяПараметра, "Отбор.", ИмяПоляВЗапросе + ".");
		
		Если ТипЗнч(ПараметрВыбора.Значение) = Тип("Булево") Тогда
			Если Не ПараметрВыбора.Значение Тогда
				ИмяПараметра = "НЕ " + ИмяПараметра;
			КонецЕсли;
			ТекстыУсловий.Добавить(ИмяПараметра);
		ИначеЕсли ТипЗнч(ПараметрВыбора.Значение) = Тип("Массив")
			Или ТипЗнч(ПараметрВыбора.Значение) = Тип("ФиксированныйМассив") Тогда
			
			ТекстыУсловий.Добавить(ИмяПараметра + " В(&" + ИмяПараметраНастройки + Строка(Счетчик) + ")");
			Запрос.УстановитьПараметр(ИмяПараметраНастройки + Строка(Счетчик), ПараметрВыбора.Значение); 
		Иначе	
			ТекстыУсловий.Добавить(ИмяПараметра + " = &" + ИмяПараметраНастройки + Строка(Счетчик));
			Запрос.УстановитьПараметр(ИмяПараметраНастройки + Строка(Счетчик), ПараметрВыбора.Значение); 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(ТекстыУсловий, " И "); 
КонецФункции

Процедура СформироватьВТЦены(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиВитрины, ВидЦен = Неопределено) Экспорт
	
	УдалитьВТВМенеджере("ВТЦены", МенеджерВременныхТаблиц);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Запрос = ЗапросПоОписаниюВТ(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиУчетнойСистемы.ОписаниеВТЦены);
	
	Если ВидЦен = Неопределено Тогда
		Запрос.УстановитьПараметр("ВидЦен", НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен);
	Иначе
		Запрос.УстановитьПараметр("ВидЦен", ВидЦен);
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаЦен", ТекущаяДатаСеанса());
		
	Запрос.Выполнить();
	
КонецПроцедуры

