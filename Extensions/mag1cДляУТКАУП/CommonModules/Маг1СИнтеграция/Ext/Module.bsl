Функция НастройкаСБП(Знач НастройкаСБП, ИдМерчанта, Организация) Экспорт
	
	ДоступныеНастройкиСБП = Маг1СИнтеграцияСлужебный.ДоступныеНастройкиСБП(Организация);
	
	Если ЗначениеЗаполнено(НастройкаСБП) Тогда
		Если ДоступныеНастройкиСБП.Найти(НастройкаСБП) <> Неопределено Тогда
			
			ПараметрыИнтеграции = ПараметрыИнтеграцииСБП(НастройкаСБП);

			Если ПараметрыИнтеграции.ИдентификаторМерчанта <> ИдМерчанта Тогда
				НастройкаСБП = Неопределено;
			КонецЕсли;
		Иначе
			НастройкаСБП = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкаСБП) Тогда
		
		Если Метаданные.Справочники.Найти("НастройкиИнтеграцииСПлатежнымиСистемами") <> Неопределено Тогда
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	НастройкиИнтеграцииСПлатежнымиСистемами.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.НастройкиИнтеграцииСПлатежнымиСистемами КАК НастройкиИнтеграцииСПлатежнымиСистемами
			|ГДЕ
			|	НастройкиИнтеграцииСПлатежнымиСистемами.Ссылка В(&ДоступныеНастройки)
			|	И НастройкиИнтеграцииСПлатежнымиСистемами.ТорговаяТочка = &ИдентификаторМерчанта
			|	И НастройкиИнтеграцииСПлатежнымиСистемами.Используется";
		ИначеЕсли Метаданные.Справочники.Найти("НастройкиПодключенияКСистемеБыстрыхПлатежей") <> Неопределено Тогда
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	НастройкиПодключенияКСистемеБыстрыхПлатежей.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.НастройкиПодключенияКСистемеБыстрыхПлатежей КАК НастройкиПодключенияКСистемеБыстрыхПлатежей
			|ГДЕ
			|	НастройкиПодключенияКСистемеБыстрыхПлатежей.Ссылка В(&ДоступныеНастройки)
			|	И НастройкиПодключенияКСистемеБыстрыхПлатежей.ИдентификаторМерчанта = &ИдентификаторМерчанта
			|	И НастройкиПодключенияКСистемеБыстрыхПлатежей.Используется";
		Иначе
			
			ВызватьИсключение НСтр("ru = 'Необходимо адаптировать расширение под новую версию БИП'");
			
		КонецЕсли;			
			
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДоступныеНастройки", ДоступныеНастройкиСБП);
		Запрос.УстановитьПараметр("ИдентификаторМерчанта", ИдМерчанта);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			НастройкаСБП = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НастройкаСБП;
	
КонецФункции

Функция ИмяСправочникаНастройкиСБП() Экспорт
	Если Метаданные.Справочники.Найти("НастройкиИнтеграцииСПлатежнымиСистемами") <> Неопределено Тогда
		Возврат "НастройкиИнтеграцииСПлатежнымиСистемами";
	ИначеЕсли Метаданные.Справочники.Найти("НастройкиПодключенияКСистемеБыстрыхПлатежей") <> Неопределено Тогда  
		Возврат "НастройкиПодключенияКСистемеБыстрыхПлатежей";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ПараметрыИнтеграцииСБП(НастройкаСБП) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("НастройкаПодключения");                       
	Результат.Вставить("ИдентификаторУчастника");
	Результат.Вставить("ИдентификаторМерчанта");
	
	
	Если Метаданные.ОбщиеМодули.Найти("ИнтеграцияСПлатежнымиСистемамиСлужебный") <> Неопределено Тогда
	
		
		ОбщийМодульИнтеграцияСПлатежнымиСистемамиСлужебный = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияСПлатежнымиСистемамиСлужебный");
		ОбщийМодульСервисИнтеграцииССБП = ОбщегоНазначения.ОбщийМодуль("СервисИнтеграцииССБП"); 
		
		ПараметрыИнтеграцииСБП  = ОбщийМодульИнтеграцияСПлатежнымиСистемамиСлужебный.ПараметрыИнтеграции(НастройкаСБП);
		
		Результат.НастройкаПодключения   = НастройкаСБП;
		Результат.ИдентификаторМерчанта  = ПараметрыИнтеграцииСБП.ТорговаяТочка;
		Попытка
			Результат.ИдентификаторУчастника = ОбщийМодульСервисИнтеграцииССБП.ИдентификаторУчастникаСБП(ПараметрыИнтеграцииСБП.ПлатежнаяСистема);
		Исключение
			Результат.ИдентификаторУчастника = ОбщийМодульСервисИнтеграцииССБП.НастройкиТорговойТочки(НастройкаСБП,
																										ПараметрыИнтеграцииСБП.ПлатежнаяСистема).Идентификатор;
		КонецПопытки;	
	ИначеЕсли Метаданные.ОбщиеМодули.Найти("СистемаБыстрыхПлатежейСлужебный") <> Неопределено Тогда

		ОбщийМодульСистемаБыстрыхПлатежейСлужебный = ОбщегоНазначения.ОбщийМодуль("СистемаБыстрыхПлатежейСлужебный");
		
		ПараметрыИнтеграцииСБП  = ОбщийМодульСистемаБыстрыхПлатежейСлужебный.ПараметрыНастройкиПодключения(НастройкаСБП);
		Результат.НастройкаПодключения   = НастройкаСБП;
		Результат.ИдентификаторМерчанта  = ПараметрыИнтеграцииСБП.ИдентификаторМерчанта;
		Результат.ИдентификаторУчастника = ПараметрыИнтеграцииСБП.ИдентификаторУчастника;
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Необходимо адаптировать расширение под новую версию БИП'");
		
	КонецЕсли;
	
	Возврат Результат;
 КонецФункции

