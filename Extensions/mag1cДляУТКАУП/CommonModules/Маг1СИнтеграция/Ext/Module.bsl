#Область КартинкиКатегорий

Процедура ДобавитьПОД_КартинкиКатегорий_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Маг1С_КартинкиКатегорийТоваров_Отправка";
	ПравилоОбработки.ПриОбработке            = "ПОД_Маг1С_КартинкиКатегорийТоваров_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Маг1С_КартинкиКатегорийТоваров_Отправка");
КонецПроцедуры

Процедура ПОД_Маг1С_КартинкиКатегорийТоваров_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	
	Если Не Маг1СИнтеграция.ЭтоКартинка(ДанныеИБ.Расширение) Тогда
		ИспользованиеПКО.Маг1С_КартинкиКатегорийТоваров_Отправка = Ложь;
	Иначе	
		
		ВладелецФайла = КомпонентыОбмена.ПараметрыКонвертации.ГруппыТоваровВладельцыФайлов.Получить(ДанныеИБ.Ссылка);
		
		Если ВладелецФайла = Неопределено Тогда
			ВладелецФайла = ВладелецФайлаКартинкиКатегории(ДанныеИБ.Ссылка);
		    КомпонентыОбмена.ПараметрыКонвертации.ГруппыТоваровВладельцыФайлов.Вставить(ДанныеИБ.Ссылка, ВладелецФайла);
		КонецЕсли;
		
		Если ВладелецФайла = Неопределено Тогда
			ИспользованиеПКО.Маг1С_КартинкиКатегорийТоваров_Отправка = Ложь;
		Иначе
			НастройкиВитрины = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины;
			НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
			
			Если НастройкиВитрины.ДополнительныеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ВидыНоменклатуры() Тогда
				ПустаяКатегория = НастройкиУчетнойСистемы.ВидНоменклатуры.Значение;
			Иначе
				ПустаяКатегория = НастройкиУчетнойСистемы.Номенклатура.Значение;
			КонецЕсли;
			
			Если ТипЗнч(ПустаяКатегория) = ТипЗнч(ВладелецФайла) Тогда
				ИспользованиеПКО.Маг1С_КартинкиКатегорийТоваров_Отправка = Истина;
			Иначе
				ИспользованиеПКО.Маг1С_КартинкиКатегорийТоваров_Отправка = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ИспользованиеПКО.Маг1С_КартинкиКатегорийТоваров_Отправка Тогда
		ПравилоКонвертации = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Маг1С_КартинкиКатегорийТоваров_Отправка");
		ОбменДаннымиXDTOСервер.ВыгрузитьУдалениеОбъекта(КомпонентыОбмена,
														ДанныеИБ.Ссылка,
														ПравилоКонвертации);
    КонецЕсли;
	
КонецПроцедуры                                                                      

Процедура ДобавитьПКО_Маг1С_КартинкиКатегорийТоваров_Отправка(ПравилаКонвертации)
	
	УзелОбменаСеансаОбмена = Маг1СИнтеграция.УзелОбменаСеансаОбмена(); 
	
	Если УзелОбменаСеансаОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Маг1С_КартинкиКатегорийТоваров_Отправка";
	ПравилоКонвертации.ОбъектДанных      =  Метаданные.Справочники[Маг1СПеречисления.ИменаСправочников_Файлы()];
	ПравилоКонвертации.ОбъектФормата     = "Справочник.Файлы";
	ПравилоКонвертации.ПриОтправкеДанных = "Маг1С_ПКО_КартинкиКатегорийТоваров_Отправка_ПриОтправкеДанных";

	СвойстваШапки = ПравилоКонвертации.Свойства;
	
	НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(УзелОбменаСеансаОбмена);
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если НастройкиВитрины.ДополнительныеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ВидыНоменклатуры() Тогда
		ДобавитьПКС(СвойстваШапки, "", "ВладелецФайла", 1, НастройкиУчетнойСистемы.ВидНоменклатуры.ПКО_Отправка);
	Иначе
		ПравилоКонвертацииНоменклатуры = ПравилаКонвертации.Найти(НастройкиУчетнойСистемы.Номенклатура.ПКО_Отправка, "ИмяПКО");
		НайденноеПКС = ПравилоКонвертацииНоменклатуры.Свойства.НайтиСтроки(Новый Структура("СвойствоФормата", "Группа"))[0];	
		ДобавитьПКС(СвойстваШапки, "", "ВладелецФайла", 1, НайденноеПКС.ПравилоКонвертацииСвойства);
	КонецЕсли;
	
	ДобавитьПКС(СвойстваШапки, "Наименование",  "Имя");
	ДобавитьПКС(СвойстваШапки, "Описание",      "Описание");
	ДобавитьПКС(СвойстваШапки, "Расширение",    "Расширение");
	ДобавитьПКС(СвойстваШапки, "",              "ХранимыйФайл", 1);

КонецПроцедуры

Процедура Маг1С_ПКО_КартинкиКатегорийТоваров_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	ВладелецФайла = КомпонентыОбмена.ПараметрыКонвертации.ГруппыТоваровВладельцыФайлов.Получить(ДанныеИБ.Ссылка);
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		ДанныеXDTO.Вставить("ВладелецФайла", ВладелецФайла);
	Иначе
		ДанныеXDTO.КлючевыеСвойства.Вставить("ВладелецФайла", ВладелецФайла);
	КонецЕсли;
		
	// Данные файла передаются отдельно
			
КонецПроцедуры

Процедура Маг1С_ПКО_Справочник_ВидыНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если Не ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеИБ, "Код") Тогда
		ДанныеXDTO.Вставить("КодВПрограмме", "0");
	КонецЕсли;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ФайлКатегории = ФайлДляКартинкиКатегории(ДанныеИБ.Ссылка);
	
	Если ЗначениеЗаполнено(ФайлКатегории) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ГруппыТоваровВладельцыФайлов.Вставить(ФайлКатегории, ДанныеИБ.Ссылка); 

		Результат = Новый Структура("Значение, ИмяПКО", ФайлКатегории, "Маг1С_КартинкиКатегорийТоваров_Отправка");
		ДанныеXDTO.Вставить("ОсновнаяКартинка", Результат);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СвойстваТоваров

Процедура ВыгрузитьОписанияСвойствТоваров(ИдентификаторВитрины, КомпонентыОбмена, ЭтоПолнаяВыгрузка)
	
	ВыгружаемыеСвойстваТоваров = ОбщегоНазначенияКлиентСервер.СкопироватьСоответствие(
						КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров);
	
	СохраненныеСведения = ПрочитатьНеобходимостьВыгрузкиДополнительныхДанных(ИдентификаторВитрины);
	ИмяКлюча = Маг1СПеречисления.КлючиРегистрацииКОбмену_СвойстваТоваров();
	
	ЗарегистрированныеСвойства = Неопределено;
	СохраненныеСведения.Свойство(ИмяКлюча, ЗарегистрированныеСвойства);
	
	Если ЗарегистрированныеСвойства <> Неопределено Тогда
		
		Для Каждого КлючЗначение из ЗарегистрированныеСвойства Цикл
			Если ВыгружаемыеСвойстваТоваров.Получить(КлючЗначение.Ключ.СвойствоТовара) = Неопределено Тогда
				ВыгружаемыеСвойстваТоваров.Вставить(КлючЗначение.Ключ.СвойствоТовара,КлючЗначение.Ключ);	
			КонецЕсли;
		КонецЦикла;
	Иначе
		
		Возврат;
		
	КонецЕсли;				
	
	Если ВыгружаемыеСвойстваТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Правило = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Справочник_СвойстваТоваров_Отправка", "Имя");
	
	Для Каждого КлючЗначение из ВыгружаемыеСвойстваТоваров Цикл 
	
		НастройкаСвойства = КлючЗначение.Значение;

		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, 
				НастройкаСвойства, 
				Правило);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьТаблицуСвойствТоваров(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, ЭтоХарактеристики)
	ВыгружаемыеСвойстваТоваров = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров;
	
	СвойстваТовара = Новый ТаблицаЗначений;
	СвойстваТовара.Колонки.Добавить("Свойство", Новый ОписаниеТипов("Структура"));
	СвойстваТовара.Колонки.Добавить("ЗначениеБулево", Новый ОписаниеТипов("Булево"));
	СвойстваТовара.Колонки.Добавить("ЗначениеЧисло", Новый ОписаниеТипов("Число"));
	СвойстваТовара.Колонки.Добавить("ЗначениеДата", Новый ОписаниеТипов("Дата"));
	СвойстваТовара.Колонки.Добавить("ЗначениеСсылка", Новый ОписаниеТипов(Справочники.ТипВсеСсылки()));
	СвойстваТовара.Колонки.Добавить("ЗначениеСтрокаОгр", Новый ОписаниеТипов("Строка",
																					,
																					Новый КвалификаторыСтроки(1024)));
	СвойстваТовара.Колонки.Добавить("ЗначениеСтрокаНеогр", Новый ОписаниеТипов("Строка",
									 												,
																					Новый КвалификаторыСтроки(0)));

	
	СвойстваСсылки    = Новый Массив;
	СвойстваРеквизиты = Новый Массив;
	
	Для Каждого НастройкаСвойства из ВыгружаемыеСвойстваТоваров Цикл
		ОписаниеСвойства = ОписаниеСвойстваИзКеша(КомпонентыОбмена.ПараметрыКонвертации.КешОписанийСвойствТоваров,
											НастройкаСвойства.Значение.СвойствоТовара);

		Если ОписаниеСвойства.ИспользуетсяДляХарактеристик = ЭтоХарактеристики Тогда
			Если ТипЗнч(НастройкаСвойства.Значение.СвойствоТовара) = Тип("Строка") Тогда
				СвойстваРеквизиты.Добавить(НастройкаСвойства.Значение.СвойствоТовара);
			Иначе	
				СвойстваСсылки.Добавить(НастройкаСвойства.Значение.СвойствоТовара);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СвойстваСсылки.Количество() <> 0 Тогда
	
		НаборыСвойств = УправлениеСвойствамиСлужебный.ПолучитьНаборыСвойствОбъекта(ДанныеИБ, Неопределено);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НаборыДополнительныеРеквизиты.Свойство КАК Свойство
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныеРеквизиты
		|ГДЕ
		|	НаборыДополнительныеРеквизиты.Ссылка В(&НаборыСвойств)
		|	И НаборыДополнительныеРеквизиты.Свойство В(&СвойстваСсылки)";
		
		Запрос.УстановитьПараметр("НаборыСвойств", НаборыСвойств.ВыгрузитьКолонку("Набор"));
		Запрос.УстановитьПараметр("СвойстваСсылки",СвойстваСсылки);
		
		ВыборкаСвойств = Запрос.Выполнить().Выбрать();
		
		Пока ВыборкаСвойств.Следующий() Цикл
			ЗначениеСвойства = ДанныеИБ.ДополнительныеРеквизиты.Найти(ВыборкаСвойств.Свойство, "Свойство");
			ДобавитьСтрокуТаблицыСвойствТоваров(СвойстваТовара, ВыборкаСвойств.Свойство, ЗначениеСвойства, КомпонентыОбмена)
		КонецЦикла;	
	КонецЕсли;
	
	Для Каждого ИмяРеквизита из СвойстваРеквизиты Цикл
		
		ЧастиИмени = СтрРазделить(ИмяРеквизита, ".");
		ЗначениеСвойства = ДанныеИБ[ЧастиИмени[1]];
		ЗначениеСтруктура = Новый Структура("Значение,ТекстоваяСтрока", ЗначениеСвойства, ЗначениеСвойства); 
		ДобавитьСтрокуТаблицыСвойствТоваров(СвойстваТовара, ИмяРеквизита, ЗначениеСтруктура, КомпонентыОбмена)
		
	КонецЦикла;
	
	Если СвойстваТовара.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("СвойстваТаблица", СвойстваТовара);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуТаблицыСвойствТоваров(ТаблицаСвойств, СвойствоТовара, ЗначениеСвойства, КомпонентыОбмена)
	
	Если ЗначениеСвойства = Неопределено
		Или (Не ТипЗнч(ЗначениеСвойства.Значение) = Тип("Булево")
				И Не ЗначениеЗаполнено(ЗначениеСвойства.Значение)
				И Не ЗначениеЗаполнено(ЗначениеСвойства.ТекстоваяСтрока)) Тогда
		Возврат;
	КонецЕсли;
	
	ВыгружаемыеСвойстваТоваров = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров;
	
	
	ОписаниеСвойства  = ОписаниеСвойстваИзКеша(КомпонентыОбмена.ПараметрыКонвертации.КешОписанийСвойствТоваров,
												СвойствоТовара);												
	НоваяСтрокаСвойств = ТаблицаСвойств.Добавить();
	НастройкаСвойства = ВыгружаемыеСвойстваТоваров.Получить(СвойствоТовара);
	
	НоваяСтрокаСвойств.Свойство = НастройкаСвойства;
	
	Если ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_Булево() Тогда
		НоваяСтрокаСвойств.ЗначениеБулево = ЗначениеСвойства.Значение;
		
	ИначеЕсли ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_Число() Тогда
		НоваяСтрокаСвойств.ЗначениеЧисло = ЗначениеСвойства.Значение;
		
	ИначеЕсли ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_Дата() Тогда
		НоваяСтрокаСвойств.ЗначениеДата = ЗначениеСвойства.Значение;
		
	ИначеЕсли ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_СтрокаНеогр() Тогда
		НоваяСтрокаСвойств.ЗначениеСтрокаНеогр = ЗначениеСвойства.ТекстоваяСтрока;
		
	ИначеЕсли ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_СтрокаОгр() Тогда 
		НоваяСтрокаСвойств.ЗначениеСтрокаОгр = ЗначениеСвойства.Значение;
		
	ИначеЕсли ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_Ссылка() Тогда
		НоваяСтрокаСвойств.ЗначениеСсылка = ЗначениеСвойства.Значение;

	КонецЕсли;
			
КонецПроцедуры

Процедура ДобавитьПОД_Справочник_СвойстваТоваров_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_СвойстваТоваров_Отправка";
	ПравилоОбработки.ПриОбработке            = "ПОД_Справочник_СвойстваТоваров_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_СвойстваТоваров_Отправка");
КонецПроцедуры

Процедура ПОД_Справочник_СвойстваТоваров_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	
	ИспользованиеПКО.Справочник_СвойстваТоваров_Отправка = Истина;
	
КонецПроцедуры

Процедура ДобавитьПКО_Справочник_СвойстваТоваров_Отправка(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Справочник_СвойстваТоваров_Отправка";
	ПравилоКонвертации.ОбъектФормата     = "Справочник.СвойстваТоваров";
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Справочник_СвойстваТоваров_Отправка_ПриОтправкеДанных";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "", "Наименование", 1);
	ДобавитьПКС(СвойстваШапки, "", "ИдентификаторДляФормул", 1);
	ДобавитьПКС(СвойстваШапки, "", "ТипСвойства", 1);
	ДобавитьПКС(СвойстваШапки, "", "Порядок", 1);
	ДобавитьПКС(СвойстваШапки, "", "ИспользоватьДляФильтра", 1);
	ДобавитьПКС(СвойстваШапки, "", "ИспользуетсяДляХарактеристик", 1);
	ДобавитьПКС(СвойстваШапки, "", "ПометкаУдаления", 1);

КонецПроцедуры

Процедура ПКО_Справочник_СвойстваТоваров_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ВыгружаемыеСвойстваТоваров = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров;
	
	ПометкаУдаления = ВыгружаемыеСвойстваТоваров.Получить(ДанныеИБ.СвойствоТовара) = Неопределено;
		
	ОписаниеРеквизита = ОписаниеСвойстваИзКеша(КомпонентыОбмена.ПараметрыКонвертации.КешОписанийСвойствТоваров,
												ДанныеИБ.СвойствоТовара);
		
	Если СтекВыгрузки.Количество() > 1 Тогда	
		ДанныеXDTO.Вставить("ИдентификаторДляФормул", ОписаниеРеквизита.ИдентификаторДляФормул);
		ДанныеXDTO.Вставить("ТипСвойства", ОписаниеРеквизита.Тип);
	Иначе
		ДанныеXDTO.КлючевыеСвойства.Вставить("ИдентификаторДляФормул", ОписаниеРеквизита.ИдентификаторДляФормул);
		ДанныеXDTO.КлючевыеСвойства.Вставить("ТипСвойства", ОписаниеРеквизита.Тип);

		ДанныеXDTO.Вставить("Наименование", ОписаниеРеквизита.Наименование);
		ДанныеXDTO.Вставить("ИспользуетсяДляХарактеристик", ОписаниеРеквизита.ИспользуетсяДляХарактеристик);
		ДанныеXDTO.Вставить("ИспользоватьДляФильтра", ДанныеИБ.ИспользоватьДляФильтра);
		ДанныеXDTO.Вставить("Порядок", ДанныеИБ.Порядок);
		ДанныеXDTO.Вставить("ПометкаУдаления", ПометкаУдаления);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Остатки
 
Процедура ВыгрузитьОстатки(ИдентификаторВитрины, КомпонентыОбмена, МенеджерВременныхТаблиц, НомерСообщения, ЭтоПолнаяВыгрузка)
	
	Если Не КомпонентыОбмена.ПараметрыКонвертации.ВыгружатьИнформативныеОстатки Тогда
		Маг1СИнтеграцияСлужебный.УдалитьСлепокДанных(ИдентификаторВитрины, "Остатки");
		Возврат;
	КонецЕсли;
	
	ТоварыОстатков = Новый ТаблицаЗначений();
	
	Если ЭтоПолнаяВыгрузка Тогда
		ВыгрузитьВсеОстатки = Истина;	
	Иначе
		СлепокОстатков = Маг1СИнтеграцияСлужебный.ПрочитатьСлепокДанных(ИдентификаторВитрины, "Остатки");
		ВыгрузитьВсеОстатки = СлепокОстатков = Неопределено;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если ВыгрузитьВсеОстатки Тогда
		СлепокОстатков = МенеджерВременныхТаблиц.Таблицы["ВТОстатки"].ПолучитьДанные().Выгрузить();
		ТоварыОстатков = СлепокОстатков;
	Иначе
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ИмяСправочникаХарактеристик = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
		
		СчитыватьХарактеристикиИзСлепка = Не ПустаяСтрока(ИмяСправочникаХарактеристик)
			И СлепокОстатков.Колонки["Характеристика"].ТипЗначения.СодержитТип(Тип("СправочникСсылка." + ИмяСправочникаХарактеристик));
			
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
					
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СлепокОстатков.Номенклатура КАК Номенклатура,";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	СлепокОстатков.Характеристика КАК Характеристика,";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
			|	СлепокОстатков.КоличествоНаСкладе КАК КоличествоНаСкладе
			|ПОМЕСТИТЬ ВТСлепокОстатковДляЗапроса
			|ИЗ
			|	&СлепокОстатков КАК СлепокОстатков
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|
			|ВЫБРАТЬ
			|	СлепокОстатков.Номенклатура КАК Номенклатура,";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	ВЫБОР КОГДА СлепокОстатков.Характеристика = ТекстПустойХарактеристики ТОГДА НЕОПРЕДЕЛЕНО ИНАЧЕ СлепокОстатков.Характеристика КОНЕЦ КАК Характеристика,";
		Иначе
		ТекстЗапроса = ТекстЗапроса + "
			|	НЕОПРЕДЕЛЕНО КАК Характеристика,";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
			|	СлепокОстатков.КоличествоНаСкладе КАК КоличествоНаСкладе
			|ПОМЕСТИТЬ ВТСлепокОстатков
			|ИЗ
			|	ВТСлепокОстатковДляЗапроса КАК СлепокОстатков
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаНоменклатура КАК СпрНоменклатура
			|		ПО СлепокОстатков.Номенклатура = СпрНоменклатура.Ссылка";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаХарактеристик КАК СпрХарактеристики
			|		ПО СлепокОстатков.Характеристика = СпрХарактеристики.Ссылка";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ
			|	НЕ СпрНоменклатура.Ссылка ЕСТЬ NULL";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
			
		ТекстЗапроса = ТекстЗапроса + "
			|	И (СлепокОстатков.Характеристика В (НЕОПРЕДЕЛЕНО, ТекстПустойХарактеристики)
			|			ИЛИ НЕ СлепокОстатков.Характеристика В (НЕОПРЕДЕЛЕНО, ТекстПустойХарактеристики)
			|				И НЕ СпрХарактеристики.Ссылка ЕСТЬ NULL)";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|
		|УНИЧТОЖИТЬ ВТСлепокОстатковДляЗапроса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|	ВложенныйЗапрос.Характеристика КАК Характеристика,
		|	СУММА(ВложенныйЗапрос.КоличествоНаСкладе) КАК ИзменениеОстатка
		|ПОМЕСТИТЬ ВТИзменениеОстатков
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТСлепокОстатков.Номенклатура КАК Номенклатура,
		|		ВТСлепокОстатков.Характеристика КАК Характеристика,
		|		-ВТСлепокОстатков.КоличествоНаСкладе КАК КоличествоНаСкладе
		|	ИЗ
		|		ВТСлепокОстатков КАК ВТСлепокОстатков
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВТОстатки.Номенклатура,
		|		ТекстХарактеристика,
		|		ВТОстатки.КоличествоНаСкладе
		|	ИЗ
		|		ВТОстатки КАК ВТОстатки) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Характеристика,
		|	ВложенныйЗапрос.Номенклатура
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВложенныйЗапрос.КоличествоНаСкладе) <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОстатки.Номенклатура КАК Номенклатура,
		|	ТекстХарактеристика КАК Характеристика,
		|	ВТОстатки.КоличествоНаСкладе КАК КоличествоНаСкладе
		|ИЗ
		|	ВТОстатки КАК ВТОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТИзменениеОстатков КАК ВТИзменениеОстатков
		|		ПО ВТОстатки.Номенклатура = ВТИзменениеОстатков.Номенклатура
		|			И ТекстХарактеристика = ВТИзменениеОстатков.Характеристика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТИзменениеОстатков.Номенклатура,
		|	ВТИзменениеОстатков.Характеристика,
		|	0
		|ИЗ
		|	ВТИзменениеОстатков КАК ВТИзменениеОстатков
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
		|		ПО (ВТОстатки.Номенклатура = ВТИзменениеОстатков.Номенклатура)
		|			И (ТекстХарактеристика = ВТИзменениеОстатков.Характеристика)
		|ГДЕ
		|	ВТОстатки.Номенклатура ЕСТЬ NULL";

 		Если Не ПустаяСтрока(ИмяСправочникаХарактеристик) Тогда
			ТекстХарактеристика = 
			"ВЫБОР 
			|	КОГДА ВТОстатки.Характеристика = ТекстПустойХарактеристики ТОГДА
			|		НЕОПРЕДЕЛЕНО
			|	ИНАЧЕ
			|		ВТОстатки.Характеристика
			|КОНЕЦ";
			
			ТекстПустойХарактеристики = "ЗНАЧЕНИЕ(Справочник." + ИмяСправочникаХарактеристик + ".ПустаяСсылка)";
		Иначе
			ТекстХарактеристика = "НЕОПРЕДЕЛЕНО";
			ТекстПустойХарактеристики = "НЕОПРЕДЕЛЕНО";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаНоменклатура", ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаХарактеристик", ИмяСправочникаХарактеристик);
 		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекстХарактеристика", ТекстХарактеристика);
 		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекстПустойХарактеристики", ТекстПустойХарактеристики);
		
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("СлепокОстатков", СлепокОстатков);
		
		ТоварыОстатков = Запрос.Выполнить().Выгрузить();
		Если ТоварыОстатков.Количество() <> 0 Тогда
			СлепокОстатков = МенеджерВременныхТаблиц.Таблицы["ВТОстатки"].ПолучитьДанные().Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
	Если ТоварыОстатков.Количество() > 0 Тогда
		Правило = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Справочник_ИнформативныеОстатки_Отправка", "Имя");
		ДанныеИБСтруктура = Новый Структура;
		ДанныеИБСтруктура.Вставить("Товары", ТоварыОстатков);
		ДанныеИБСтруктура.Вставить("ЭтоПолнаяВыгрузка", ВыгрузитьВсеОстатки);
		
		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, 
			ДанныеИБСтруктура, 
			Правило);
		
		Маг1СИнтеграцияСлужебный.СохранитьСлепокДанных(ИдентификаторВитрины, "Остатки", СлепокОстатков, НомерСообщения); 		
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_Справочник_ИнформативныеОстатки_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки) Экспорт
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеИБ) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.КлючевыеСвойства.Вставить("Дата",  ТекущаяДатаСеанса());
	ДанныеXDTO.КлючевыеСвойства.Вставить("Склад", КомпонентыОбмена.ПараметрыКонвертации.СкладОстатков);
	ДанныеXDTO.Вставить("ЭтоПолнаяВыгрузка", ДанныеИБ.ЭтоПолнаяВыгрузка);
	ДанныеXDTO.Вставить("Товары", ДанныеИБ.Товары);
	
КонецПроцедуры

#КонецОбласти

#Область Цены

Функция ВыгрузитьЦены(КомпонентыОбмена, МенеджерВременныхТаблиц, НомерСообщения, ВидЦен, ЭтоПолнаяВыгрузка)
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы(); 
	СформироватьВТАктивнаяНоменклатура(МенеджерВременныхТаблиц,
										КомпонентыОбмена.ПараметрыКонвертации.НастройкиФильтровНоменклатуры, 
										КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины,
										Истина,
										ВидЦен);
	ИдентификаторВитрины = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
										
	ИмяСлепка = "Цены" + Строка(ВидЦен.УникальныйИдентификатор());									
		
	ТоварыЦен = Новый ТаблицаЗначений();
	
	ИмяСправочникаХарактеристик = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
	ИмяСправочникаУпаковок      = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Упаковки());
	
	Если ЭтоПолнаяВыгрузка Тогда
		ВыгрузитьВсеЦены = Истина;
	Иначе
		СлепокЦен = Маг1СИнтеграцияСлужебный.ПрочитатьСлепокДанных(ИдентификаторВитрины, ИмяСлепка);
		
		Если СлепокЦен <> Неопределено
			 И ((Не ПустаяСтрока(ИмяСправочникаХарактеристик) 
	        	  	И СлепокЦен.Колонки.Найти("Характеристика") = Неопределено)
				ИЛИ (Не ПустаяСтрока(ИмяСправочникаУпаковок)
				 		И СлепокЦен.Колонки.Найти("Упаковка") = Неопределено)) Тогда
			СлепокЦен = Неопределено;
		КонецЕсли;
		
		ВыгрузитьВсеЦены = СлепокЦен = Неопределено;
	КонецЕсли;
	
	Если ВыгрузитьВсеЦены Тогда
		СлепокЦен = МенеджерВременныхТаблиц.Таблицы["ВТАктивнаяНоменклатура"].ПолучитьДанные().Выгрузить();
		ТоварыЦен = СлепокЦен;
	Иначе
		
		СчитыватьУпаковкиИзСлепка = Не ПустаяСтрока(ИмяСправочникаУпаковок)
			И СлепокЦен.Колонки["Упаковка"].ТипЗначения.СодержитТип(Тип("СправочникСсылка." + ИмяСправочникаУпаковок));
			
		СчитыватьХарактеристикиИзСлепка = Не ПустаяСтрока(ИмяСправочникаХарактеристик)
			И СлепокЦен.Колонки["Характеристика"].ТипЗначения.СодержитТип(Тип("СправочникСсылка." + ИмяСправочникаХарактеристик));
			
		Если ПустаяСтрока(ИмяСправочникаУпаковок) Тогда
			ТекстПустойУпаковки = "НЕОПРЕДЕЛЕНО";
		Иначе
			ТекстПустойУпаковки = "ЗНАЧЕНИЕ(Справочник." + ИмяСправочникаУпаковок + ".ПустаяСсылка)";
		КонецЕсли;	
		
		Если ПустаяСтрока(ИмяСправочникаХарактеристик) Тогда
			ТекстПустойХарактеристики = "НЕОПРЕДЕЛЕНО";
		Иначе
			ТекстПустойХарактеристики = "ЗНАЧЕНИЕ(Справочник." + ИмяСправочникаХарактеристик + ".ПустаяСсылка)";
		КонецЕсли;	
		
		УдалитьВТВМенеджере("ВТСлепокЦен", МенеджерВременныхТаблиц);
		УдалитьВТВМенеджере("ВТИзменениеЦен", МенеджерВременныхТаблиц);
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
					
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СлепокЦен.Номенклатура КАК Номенклатура,";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	СлепокЦен.Характеристика КАК Характеристика,";
		КонецЕсли;
		
		Если СчитыватьУпаковкиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	СлепокЦен.Упаковка КАК Упаковка,";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
			|	СлепокЦен.Цена КАК Цена
			|ПОМЕСТИТЬ ВТСлепокЦенДляЗапроса
			|ИЗ
			|	&СлепокЦен КАК СлепокЦен
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|
			|ВЫБРАТЬ
			|	СлепокЦен.Номенклатура КАК Номенклатура,";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	ВЫБОР КОГДА СлепокЦен.Характеристика = ТекстПустойХарактеристики ТОГДА НЕОПРЕДЕЛЕНО ИНАЧЕ СлепокЦен.Характеристика КОНЕЦ КАК Характеристика,";
		Иначе
		ТекстЗапроса = ТекстЗапроса + "
			|	НЕОПРЕДЕЛЕНО КАК Характеристика,";
		КонецЕсли;
		
		Если СчитыватьУпаковкиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	ЕСТЬNULL(СпрУпаковки.Ссылка, НЕОПРЕДЕЛЕНО)  КАК Упаковка,";
		Иначе
			
		ТекстЗапроса = ТекстЗапроса + "
			|	НЕОПРЕДЕЛЕНО КАК Упаковка,";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
			|	СлепокЦен.Цена КАК Цена
			|ПОМЕСТИТЬ ВТСлепокЦен
			|ИЗ
			|	ВТСлепокЦенДляЗапроса КАК СлепокЦен
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаНоменклатура КАК СпрНоменклатура
			|		ПО СлепокЦен.Номенклатура = СпрНоменклатура.Ссылка";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаХарактеристик КАК СпрХарактеристики
			|		ПО СлепокЦен.Характеристика = СпрХарактеристики.Ссылка";
		КонецЕсли;
		
		Если СчитыватьУпаковкиИзСлепка Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаУпаковок КАК СпрУпаковки
			|		ПО СлепокЦен.Упаковка = СпрУпаковки.Ссылка";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ
			|	НЕ СпрНоменклатура.Ссылка ЕСТЬ NULL";
		
		Если СчитыватьХарактеристикиИзСлепка Тогда
			
		ТекстЗапроса = ТекстЗапроса + "
			|	И (СлепокЦен.Характеристика В (НЕОПРЕДЕЛЕНО, ТекстПустойХарактеристики)
			|			ИЛИ НЕ СлепокЦен.Характеристика В (НЕОПРЕДЕЛЕНО, ТекстПустойХарактеристики)
			|				И НЕ СпрХарактеристики.Ссылка ЕСТЬ NULL)";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|
		|УНИЧТОЖИТЬ ВТСлепокЦенДляЗапроса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЗИзменениеЦен.Номенклатура КАК Номенклатура,
		|	ВЗИзменениеЦен.Характеристика КАК Характеристика,
		|	СУММА(ВЗИзменениеЦен.Цена) КАК ИзменениеЦены,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЗИзменениеЦен.Упаковка) КАК ИзменениеУпаковки
		|ПОМЕСТИТЬ ВТИзменениеЦен
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТСлепокЦен.Номенклатура КАК Номенклатура,
		|		ВТСлепокЦен.Характеристика КАК Характеристика,
		|		ВТСлепокЦен.Упаковка КАК Упаковка,
		|		-ВТСлепокЦен.Цена КАК Цена
		|	ИЗ
		|		ВТСлепокЦен КАК ВТСлепокЦен
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВТАктивнаяНоменклатура.Номенклатура,
		|		ВТАктивнаяНоменклатура.Характеристика,
		|		ВТАктивнаяНоменклатура.Упаковка,
		|		ВТАктивнаяНоменклатура.Цена
		|	ИЗ
		|		ВТАктивнаяНоменклатура КАК ВТАктивнаяНоменклатура) КАК ВЗИзменениеЦен
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЗИзменениеЦен.Характеристика,
		|	ВЗИзменениеЦен.Номенклатура
		|
		|ИМЕЮЩИЕ
		|	(СУММА(ВЗИзменениеЦен.Цена) <> 0
		|		ИЛИ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЗИзменениеЦен.Упаковка) > 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТАктивнаяНоменклатура.Номенклатура КАК Номенклатура,
		|	ВТАктивнаяНоменклатура.Характеристика КАК Характеристика,
		|	ВТАктивнаяНоменклатура.Упаковка КАК Упаковка,
		|	ВТАктивнаяНоменклатура.Цена КАК Цена
		|ИЗ
		|	ВТАктивнаяНоменклатура КАК ВТАктивнаяНоменклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТИзменениеЦен КАК ВТИзменениеЦен
		|		ПО ВТАктивнаяНоменклатура.Номенклатура = ВТИзменениеЦен.Номенклатура
		|		   И ВТАктивнаяНоменклатура.Характеристика = ВТИзменениеЦен.Характеристика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТИзменениеЦен.Номенклатура,
		|	ВТИзменениеЦен.Характеристика,
		|	НЕОПРЕДЕЛЕНО,
		|	0
		|ИЗ
		|	ВТИзменениеЦен КАК ВТИзменениеЦен
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТАктивнаяНоменклатура КАК ВТАктивнаяНоменклатура
		|		ПО (ВТАктивнаяНоменклатура.Номенклатура = ВТИзменениеЦен.Номенклатура)
		|			И ВТАктивнаяНоменклатура.Характеристика = ВТИзменениеЦен.Характеристика
		|ГДЕ
		|	ВТАктивнаяНоменклатура.Номенклатура ЕСТЬ NULL";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаХарактеристик", ИмяСправочникаХарактеристик);
	 	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаУпаковок", ИмяСправочникаУпаковок);

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаНоменклатура", 
			Маг1СИнтеграция.ИмяСправочника(Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы(), 
											Маг1СПеречисления.ИменаСправочников_Номенклатура()));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекстПустойХарактеристики", ТекстПустойХарактеристики); 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекстПустойУпаковки", ТекстПустойУпаковки); 
				
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("СлепокЦен", СлепокЦен);
		
		ТоварыЦен = Запрос.Выполнить().Выгрузить();
		Если ТоварыЦен.Количество() <> 0 Тогда
			СлепокЦен = МенеджерВременныхТаблиц.Таблицы["ВТАктивнаяНоменклатура"].ПолучитьДанные().Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
	Если ТоварыЦен.Количество() > 0 Тогда
		Правило = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Документ_УстановкаЦенНоменклатуры_Отправка", "Имя");
		ДанныеИБСтруктура = Новый Структура;
		ДанныеИБСтруктура.Вставить("Товары", ТоварыЦен);
		ДанныеИБСтруктура.Вставить("ЭтоПолнаяВыгрузка", ВыгрузитьВсеЦены);
		
		ДанныеИБСтруктура.Вставить("Дата", ТекущаяДатаСеанса());
		ДанныеИБСтруктура.Вставить("Номер", "1");
		ДанныеИБСтруктура.Вставить("ТипЦен", ВидЦен);
		
		ДанныеИБСтруктура.Вставить("Комментарий", "");
		ДанныеИБСтруктура.Вставить("Ответственный", Неопределено);
		
		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, 
														ДанныеИБСтруктура, 
														Правило);
		Маг1СИнтеграцияСлужебный.СохранитьСлепокДанных(ИдентификаторВитрины, ИмяСлепка, СлепокЦен, НомерСообщения);
		
	КонецЕсли;
	
	Возврат ИмяСлепка;

КонецФункции

Процедура ПКО_Документ_УстановкаЦенНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки) Экспорт
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеИБ) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ТекущаяДата = ТекущаяДатаСеанса();
	
	ДанныеXDTO.КлючевыеСвойства.Вставить("Дата", ДанныеИБ.Дата);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", ДанныеИБ.Номер);
	ДанныеXDTO.Вставить("Товары", ДанныеИБ.Товары);
	ДанныеXDTO.Вставить("ЭтоПолнаяВыгрузка", ДанныеИБ.ЭтоПолнаяВыгрузка);
	
	ДанныеXDTO.Вставить("ТипЦен", ДанныеИБ.ТипЦен);

КонецПроцедуры

#КонецОбласти

#Область Номенклатура

Процедура ДополнитьПКО_Справочник_Номенклатура_Отправка(ПравилаКонвертации)
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ПравилоКонвертации = ПравилаКонвертации.Найти(НастройкиУчетнойСистемы.Номенклатура.ПКО_Отправка, "ИмяПКО");

	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "", "Значок", 1, "СсылочныеЗначенияСвойств_Отправка");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "СвойстваТаблица");
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеБулево", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеЧисло", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеДата", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеСтрокаОгр", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеСтрокаНеогр", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеСсылка", 1, "СсылочныеЗначенияСвойств_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Свойство", 1, "Справочник_СвойстваТоваров_Отправка");

КонецПроцедуры

Процедура Справочник_Номенклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки) Экспорт
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки <> ИдентификаторВариантаНастройкиОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ЗначокПояснение", "");
	ДанныеXDTO.Вставить("ЗначокДействуетДо", '00010101');
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	СтрокаЗначка = ДанныеИБ.ДополнительныеРеквизиты.Найти(Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры(), "Свойство");
	
	Если СтрокаЗначка <> Неопределено Тогда
		ДанныеXDTO.Вставить("Значок", СтрокаЗначка.Значение);
		
		СтрокаПояснения = ДанныеИБ.ДополнительныеРеквизиты.Найти(Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокПояснениеНоменклатуры(), "Свойство");
		
		Если СтрокаПояснения <> Неопределено Тогда
			ДанныеXDTO.Вставить("ЗначокПояснение", Строка(СтрокаПояснения.Значение));
		КонецЕсли;
		
		СтрокаДаты = ДанныеИБ.ДополнительныеРеквизиты.Найти(Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокДействуетДоНоменклатуры(), "Свойство");
		
		Если СтрокаДаты <> Неопределено
			И ТипЗнч(СтрокаДаты.Значение) = Тип("Дата") Тогда
			ДанныеXDTO.Вставить("ЗначокДействуетДо", СтрокаДаты.Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	ВыгрузитьТаблицуСвойствТоваров(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, Ложь);
КонецПроцедуры

#КонецОбласти

#Область ЗаказыПокупателейПрисоединенныеФайлы

Процедура Маг1с_ДобавитьПОД_ЗаказыПокупателейПрисоединенныеФайлы_Получение(ПравилаОбработкиДанных)
	
	НайденныеСтроки = ПравилаОбработкиДанных.НайтиСтроки(Новый Структура("ОбъектВыборкиФормат", "Справочник.Файлы"));
	
	Для каждого НайденнаяСтрока из НайденныеСтроки Цикл
		ПравилаОбработкиДанных.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ИмяДокументаЗаказы = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ЗаказПокупателя());
	
	Если Метаданные.Справочники.Найти(ИмяДокументаЗаказы + "ПрисоединенныеФайлы") = Неопределено Тогда	
		Возврат;
	КонецЕсли;
		
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.Файлы";
	ПравилоОбработки.ПриОбработке            = "Маг1с_ПОД_Справочник_Файлы_Получение_ПриОбработке";
	
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Маг1с_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение");

КонецПроцедуры

Процедура Маг1с_ПОД_Справочник_Файлы_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ВладелецФайла = Неопределено;
	
	ЭтоЗаказКлиента = Ложь;
		
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("ВладелецФайла", ВладелецФайла) Тогда
		Если Найти(ВладелецФайла.ТипЗначения, "ЗаказКлиента") > 0 Тогда
			
			ЭтоЗаказКлиента = Истина
					
		КонецЕсли;
	КонецЕсли;
	
	ИспользованиеПКО.Маг1с_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение = ЭтоЗаказКлиента; 
КонецПроцедуры

Процедура Маг1с_ДобавитьПКО_ЗаказыПокупателейПрисоединенныеФайлы_Получение(ПравилаКонвертации)
	
	ИмяДокументаЗаказы = ИмяСправочника(Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы(),
										Маг1СПеречисления.ИменаСправочников_ЗаказПокупателя());
	
	Если Метаданные.Справочники.Найти(ИмяДокументаЗаказы + "ПрисоединенныеФайлы") = Неопределено Тогда	
		Возврат;
	КонецЕсли;
	
	НайденныеПКО = ПравилаКонвертации.НайтиСтроки(Новый Структура("ОбъектФормата", "Документ.ЗаказКлиента"));
	
	ИмяПКОЗаказа = НайденныеПКО[0].ИмяПКО;
		
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Маг1с_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Справочники[ИмяДокументаЗаказы + "ПрисоединенныеФайлы"];
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	ПравилоКонвертации.ОбъектФормата                = "Справочник.Файлы"; //@NON-NLS-1
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Автор",            "", 1);
	ДобавитьПКС(СвойстваШапки, "ВладелецФайла",    "", 1, ИмяПКОЗаказа);
	ДобавитьПКС(СвойстваШапки, "ДатаСоздания",     "", 1);
	ДобавитьПКС(СвойстваШапки, "Наименование",     "Имя");
	ДобавитьПКС(СвойстваШапки, "Описание",         "Описание");
	ДобавитьПКС(СвойстваШапки, "Расширение",       "Расширение");
	ДобавитьПКС(СвойстваШапки, "ТипХраненияФайла", "", 1);           
	ДобавитьПКС(СвойстваШапки, "ДатаСоздания", "ДатаСоздания");
	ДобавитьПКС(СвойстваШапки, "ДатаМодификацииУниверсальная", "ДатаМодификацииУниверсальная");
	
КонецПроцедуры

Процедура Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки <> ИдентификаторВариантаНастройкиОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	ВладелецФайла = ДанныеXDTO.КлючевыеСвойства.ВладелецФайла;
	
	Если ЗначениеЗаполнено(ВладелецФайла) Тогда
		Если Найти(ВладелецФайла.ТипЗначения, "ЗаказКлиента") > 0 Тогда
			НайденныеПКО = КомпонентыОбмена.ПравилаКонвертацииОбъектов.НайтиСтроки(Новый Структура("ОбъектФормата", "Документ.ЗаказКлиента"));
			ИмяПКОЗаказа = НайденныеПКО[0].ИмяПКО;
		
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВладелецФайла", Новый Структура("Значение, ИмяПКО",
				ВладелецФайла, ИмяПКОЗаказа));
		КонецЕсли;
		
	КонецЕсли;
	
	ПолученныеДанные.ТипХраненияФайла = Перечисления["ТипыХраненияФайлов"].ВИнформационнойБазе;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ДвоичныеДанныеФайла", ДанныеXDTO.ХранимыйФайл);

КонецПроцедуры

Процедура Маг1с_ПКО_ПКО_Справочник_ЗаказыПокупателейПрисоединенныеФайлы_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки <> ИдентификаторВариантаНастройкиОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеИБ <> Неопределено Тогда
		ДанныеИБ.ДополнительныеСвойства.Вставить("ДвоичныеДанныеФайла", ПолученныеДанные.ДополнительныеСвойства.ДвоичныеДанныеФайла);
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Автор) Тогда
		ПолученныеДанные.Автор = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.ДатаСоздания) Тогда
		ПолученныеДанные.ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.ДатаМодификацииУниверсальная) Тогда
		ПолученныеДанные.ДатаМодификацииУниверсальная = ТекущаяУниверсальнаяДата();
	КонецЕсли;
	

КонецПроцедуры

#КонецОбласти

#Область СостоянияЗаказовПокупателей

Процедура Маг1С_ДобавитьПОД_Справочник_СостоянияЗаказовПокупателей_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_СостоянияЗаказовПокупателей_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.СостояниеЗаказа";
	ПравилоОбработки.ПриОбработке            = "Маг1С_ПОД_Справочник_СостоянияЗаказовПокупателей_Получение_ПриОбработке";
КонецПроцедуры

Процедура Маг1С_ПОД_Справочник_СостоянияЗаказовПокупателей_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	СостояниеЗаказа = Неопределено;
	КлючевыеСвойства = Неопределено;
	ЗаказКлиента = Неопределено;
	ДополнительнаяИнформацияСтрока = Неопределено;

	ДанныеXDTO.Свойство("СостояниеЗаказа", СостояниеЗаказа);
	ДанныеXDTO.Свойство("КлючевыеСвойства", КлючевыеСвойства);
	ДанныеXDTO.Свойство("ДополнительнаяИнформация", ДополнительнаяИнформацияСтрока);
	
	Если КлючевыеСвойства <> Неопределено Тогда 
		КлючевыеСвойства.Свойство("Заказ", ЗаказКлиента);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ПравилоКонвертацииЗаказКлиента = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,
		НастройкиУчетнойСистемы.ЗаказПокупателя.ПКО_Получение);
	
	ЗаказКлиентаСсылка = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
		КомпонентыОбмена, ЗаказКлиента, ПравилоКонвертацииЗаказКлиента, "ПолучитьСсылку").Ссылка;
		
	Если Не ЗначениеЗаполнено(ЗаказКлиентаСсылка)
			Или Не ОбщегоНазначения.СсылкаСуществует(ЗаказКлиентаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СостояниеЗаказа)
		И СостояниеЗаказа.Значение = "Отменен" Тогда
	
		КомпонентыОбмена.ПараметрыКонвертации.ЗаказыДляОтмены.Добавить(ЗаказКлиентаСсылка);
	
	КонецЕсли;

	Если ДополнительнаяИнформацияСтрока <> Неопределено
		И Не ПустаяСтрока(ДополнительнаяИнформацияСтрока) Тогда
		
		ДополнительнаяИнформация = Маг1СИнтеграцияСлужебный.СтрокаJSONВСтруктуру(ДополнительнаяИнформацияСтрока);
		
		ОбработатьДополнительнуюИнформациюПоЗаказу(ЗаказКлиентаСсылка.ПолучитьОбъект(), 
																	ДополнительнаяИнформация,
																	КомпонентыОбмена); 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПолученияДанныхОтВитрины

Процедура ПриСозданииЗаказаКлиента(КомпонентыОбмена, ЗаказКлиента) Экспорт
	
	Если ЗаказКлиента.ДополнительныеСвойства.Свойство("Маг1сЭтоНовый")
		и Не ЗаказКлиента.ДополнительныеСвойства.Маг1сЭтоНовый Тогда
		ОповеститьОЗаказе(КомпонентыОбмена, НСтр("ru = 'Изменен заказ'"), ЗаказКлиента.Ссылка);
	Иначе
		ОповеститьОЗаказе(КомпонентыОбмена, НСтр("ru = 'Новый заказ'"), ЗаказКлиента.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДополнительнуюИнформациюПоЗаказу(ЗаказКлиента, ДополнительнаяИнформация, КомпонентыОбмена)
	
	ЕстьИзменения = Ложь;
	Проводить     = Ложь;
	
	НастройкиВитрины = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины;
	
	Если ДополнительнаяИнформация.mag1c_СпособОплаты = Маг1СПеречисления.СпособыОплаты_ОнЛайнЧерезЮКассу() Тогда
		
		Если КомпонентыОбмена.ПараметрыКонвертации.НастройкиЮКассы <> Неопределено Тогда
			
			УстановитьПривилегированныйРежим(Истина);
			ИмяРегистра  = "";
			ИмяИзмерения = "";
			
			Если Метаданные.РегистрыСведений.Найти("СтатусыОнлайнОплат") <> Неопределено Тогда
				ИмяРегистра  = "СтатусыОнлайнОплат";
				ИмяИзмерения = "НастройкаОнлайнОплаты";
			ИначеЕсли Метаданные.РегистрыСведений.Найти("СтатусОбменовСЯндексКассой") <> Неопределено Тогда
				ИмяРегистра  = "СтатусОбменовСЯндексКассой";
				ИмяИзмерения = "НастройкаЯндексКассы";
			Иначе
				Возврат;
			КонецЕсли;
			
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	СтатусОбменовСЮКассой.%ИмяИзмерения% КАК %ИмяИзмерения%,
			|   СтатусОбменовСЮКассой.Организация КАК Организация,
			|	СтатусОбменовСЮКассой.ДатаПоследнегоУспешногоОбмена КАК ДатаПоследнегоУспешногоОбмена 
			|ИЗ
			|	РегистрСведений.%ИмяРегистра% КАК СтатусОбменовСЮКассой
			|ГДЕ
			|	СтатусОбменовСЮКассой.%ИмяИзмерения% = &НастройкиЮКассы";

			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяРегистра%", ИмяРегистра);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяИзмерения%", ИмяИзмерения);
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("НастройкиЮКассы", КомпонентыОбмена.ПараметрыКонвертации.НастройкиЮКассы.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Если (ЗаказКлиента.Дата - 300) < Выборка.ДатаПоследнегоУспешногоОбмена Тогда
					
					НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
					ОтборПоИзмерению = НаборЗаписей.Отбор.Найти(ИмяИзмерения);
					ОтборПоИзмерению.Установить(КомпонентыОбмена.ПараметрыКонвертации.НастройкиЮКассы.Ссылка);
					СтрокаНабора = НаборЗаписей.Добавить();
					
					ЗаполнитьЗначенияСвойств(СтрокаНабора, Выборка);
					
					СтрокаНабора.ДатаПоследнегоУспешногоОбмена = ЗаказКлиента.Дата - 300;
					
					НаборЗаписей.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ДополнительнаяИнформация.mag1c_СпособОплаты = Маг1СПеречисления.СпособыОплаты_ОнЛайнЧерезСБП() Тогда
		Если Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы().ПоддерживаетсяОплатаЧерезСБП  
            И ДополнительнаяИнформация.Свойство("mag1c_ОплатаСБП_ИдМерчанта") Тогда
			НастройкаСБП = НастройкиВитрины.ОсновныеНастройки.НастройкаСБП; 
			
			НастройкаСБП = НастройкаСБП(НастройкаСБП,
										ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдМерчанта,
										НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация);
										
			ТекстПредупреждения = НСтр("ru = 'НЕ НАЙДЕНА НАСТРОЙКА ИНТЕГРАЦИИ С СИСТЕМОЙ БЫСТРЫХ ПЛАТЕЖЕЙ!
                                        |
                                        |На витрине по заказу была инициирована оплата через СБП, информация об этом не была загружена, поэтому информация об оплате так же не будет загружена.
                                        |'");
						
			Если ЗначениеЗаполнено(НастройкаСБП) Тогда
				Если СтрНайти(ЗаказКлиента.Комментарий, ТекстПредупреждения) > 0 Тогда 
					ЗаказКлиента.Комментарий = СтрЗаменить(ЗаказКлиента.Комментарий, ТекстПредупреждения, "");	
					ЕстьИзменения = Истина;
				КонецЕсли;
				
				Маг1СИнтеграцияСлужебный.ЗаполнитьЗаказПоНастройкеСБП(ЗаказКлиента, НастройкаСБП, Проводить);
				
				Если Метаданные.РегистрыСведений.Найти("ИдентификаторыОперацийСБП") <> Неопределено Тогда
				
					ИндентификаторМенеджерЗаписи = РегистрыСведений["ИдентификаторыОперацийСБП"].СоздатьМенеджерЗаписи();
					ИндентификаторМенеджерЗаписи.ДокументОперации    = ЗаказКлиента.Ссылка;
					ИндентификаторМенеджерЗаписи.Идентификатор       = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдЗаказа;
					ИндентификаторМенеджерЗаписи.ИдентификаторОплаты = ДополнительнаяИнформация.mag1c_ОплатаСБП_QRИд;
					ИндентификаторМенеджерЗаписи.ПериодИспользования = 
						Маг1СИнтеграцияСлужебныйКлиентСервер.СтрокаВДату(ДополнительнаяИнформация.mag1c_ОплатаСБП_ДействуетДо);
					ИндентификаторМенеджерЗаписи.QRКод               = ДополнительнаяИнформация.mag1c_ПлатежнаяСсылка;
					ИндентификаторМенеджерЗаписи.ТорговаяТочка       = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдМерчанта;
					ИндентификаторМенеджерЗаписи.СтатусОперации      = ОбщегоНазначения.ОбщийМодуль("СервисИнтеграцииССБП").ИдентификаторСтатусаВПроцессе();
					ИндентификаторМенеджерЗаписи.НастройкаИнтеграции = НастройкаСБП;
					ИндентификаторМенеджерЗаписи.ОтложенноеПолучениеСтатуса = Истина;
					
					ИндентификаторМенеджерЗаписи.Записать();
				
				ИначеЕсли Метаданные.РегистрыСведений.Найти("ИдентификаторыОперацийСБПc2b") <> Неопределено Тогда
					
					ИндентификаторМенеджерЗаписи = РегистрыСведений["ИдентификаторыОперацийСБПc2b"].СоздатьМенеджерЗаписи();
					ИндентификаторМенеджерЗаписи.ДокументОперации    = ЗаказКлиента.Ссылка;
					ИндентификаторМенеджерЗаписи.Идентификатор       = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдЗаказа;
					ИндентификаторМенеджерЗаписи.ИдентификаторОплаты = ДополнительнаяИнформация.mag1c_ОплатаСБП_QRИд;
					ИндентификаторМенеджерЗаписи.ПериодИспользования = 
						Маг1СИнтеграцияСлужебныйКлиентСервер.СтрокаВДату(ДополнительнаяИнформация.mag1c_ОплатаСБП_ДействуетДо);
					ИндентификаторМенеджерЗаписи.ПлатежнаяСсылка               = ДополнительнаяИнформация.mag1c_ПлатежнаяСсылка;
					ИндентификаторМенеджерЗаписи.ИдентификаторМерчанта       = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдМерчанта;
					Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ИнтернетПоддержкаПользователейКлиентСервер.ВерсияБиблиотеки(), "2.8.3.0") >= 0 Тогда 
						ИндентификаторМенеджерЗаписи.СтатусОперации      = ОбщегоНазначения.ОбщийМодуль("НастройкиПлатежныхСистемСлужебный").ИдентификаторСтатусаВПроцессе();
					Иначе 
						ИндентификаторМенеджерЗаписи.СтатусОперации      = ОбщегоНазначения.ОбщийМодуль("СистемаБыстрыхПлатежейСлужебный").ИдентификаторСтатусаВПроцессе();
					КонецЕсли;
					ИндентификаторМенеджерЗаписи.НастройкаПодключения = НастройкаСБП;
					ИндентификаторМенеджерЗаписи.ОтложенноеПолучениеСтатуса = Истина;
					
					ИндентификаторМенеджерЗаписи.Записать();
				Иначе
					
					ВызватьИсключение НСтр("ru = 'Необходимо адаптировать расширение под новую версию БИП'");

				КонецЕсли;
					
				Если Метаданные.РегистрыСведений.Найти("ДанныеОперацийСБП") <> Неопределено Тогда
					
					ДанныеОперацийМенеджерЗаписи = РегистрыСведений["ДанныеОперацийСБП"].СоздатьМенеджерЗаписи(); 
					
					ДанныеОперацийМенеджерЗаписи.Идентификатор     = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдЗаказа;
					ДанныеОперацийМенеджерЗаписи.ДатаОперации      = ЗаказКлиента.Дата;
					ДанныеОперацийМенеджерЗаписи.СуммаОперации     = ДополнительнаяИнформация.mag1c_ОплатаСБП_Сумма;
					ДанныеОперацийМенеджерЗаписи.НазначениеПлатежа = ДополнительнаяИнформация.mag1c_ОплатаСБП_НазначениеПлатежа;
					ДанныеОперацийМенеджерЗаписи.ТорговаяТочка     = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдМерчанта;
					ДанныеОперацийМенеджерЗаписи.Оплата            = Истина;
					ДанныеОперацийМенеджерЗаписи.ДокументОперации  = ЗаказКлиента.Ссылка;
					
					ДанныеОперацийМенеджерЗаписи.Записать();
					
				ИначеЕсли Метаданные.РегистрыСведений.Найти("ДанныеОперацийСБПc2b") <> Неопределено Тогда
					ДанныеОперацийМенеджерЗаписи = РегистрыСведений["ДанныеОперацийСБПc2b"].СоздатьМенеджерЗаписи(); 
					
					ДанныеОперацийМенеджерЗаписи.Идентификатор         = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдЗаказа;
					ДанныеОперацийМенеджерЗаписи.ДатаОперации          = ЗаказКлиента.Дата;
					ДанныеОперацийМенеджерЗаписи.СуммаОперации         = ДополнительнаяИнформация.mag1c_ОплатаСБП_Сумма;
					ДанныеОперацийМенеджерЗаписи.НазначениеПлатежа     = ДополнительнаяИнформация.mag1c_ОплатаСБП_НазначениеПлатежа;
					ДанныеОперацийМенеджерЗаписи.ИдентификаторМерчанта = ДополнительнаяИнформация.mag1c_ОплатаСБП_ИдМерчанта;
					ДанныеОперацийМенеджерЗаписи.Оплата                = Истина;
					ДанныеОперацийМенеджерЗаписи.ДокументОперации      = ЗаказКлиента.Ссылка;
					
					ДанныеОперацийМенеджерЗаписи.Записать();
				Иначе
					
					ВызватьИсключение НСтр("ru = 'Необходимо адаптировать расширение под новую версию БИП'");

				КонецЕсли;
				
				
			Иначе
				Если СтрНайти(ЗаказКлиента.Комментарий, ТекстПредупреждения) = 0 Тогда 
					ЗаказКлиента.Комментарий = ТекстПредупреждения + ЗаказКлиента.Комментарий;
					ЕстьИзменения = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	
	Если Проводить Тогда
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если Проводить
		И ЗаказКлиента.Проведен Тогда
		ЗаказКлиента.Записать(РежимЗаписиДокумента.Проведение);
	ИначеЕсли ЕстьИзменения Тогда
		ЗаказКлиента.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтменитьЗаказы(КомпонентыОбмена)
	Если КомпонентыОбмена.ПараметрыКонвертации.ЗаказыДляОтмены.Количество()= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказыДляОтмены                          = КомпонентыОбмена.ПараметрыКонвертации.ЗаказыДляОтмены;
	
	КешЗначений = Новый Структура();
	
	Для Каждого Заказ Из ЗаказыДляОтмены Цикл
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Заказ) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбъектЗаказ = Заказ.ПолучитьОбъект();

			Маг1СИнтеграцияПереопределяемый.ОтменитьЗаказ(ОбъектЗаказ, КешЗначений); 

			ОбъектЗаказ.Записать(?(ОбъектЗаказ.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		Исключение
			ОбъектЗаказ   = Заказ.ПолучитьОбъект();
			ОбъектЗаказ.Комментарий = НСтр("ru = 'ЗАКАЗ ОТМЕНЕН ПОКУПАТЕЛЕМ НА ВЕБ-ВИТРИНЕ. В программе отразить отмену заказа не удалось.'",ОбщегоНазначения.КодОсновногоЯзыка())
									  + Символы.ВК
									  + ОбъектЗаказ.Комментарий;
			ОбъектЗаказ.ОбменДанными.Загрузка = Истина;						  
		    ОбъектЗаказ.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		Если ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
			ПриОтменеЗаказаКлиента(КомпонентыОбмена, ОбъектЗаказ);
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Процедура ПриОтменеЗаказаКлиента(КомпонентыОбмена, ЗаказКлиента) Экспорт
	
	ОповеститьОЗаказе(КомпонентыОбмена, НСтр("ru = 'Отмена заказа'"), ЗаказКлиента.Ссылка);
	
КонецПроцедуры

Процедура ОповеститьОЗаказе(КомпонентыОбмена, Заголовок, Ссылка)
	
	НастройкиВитрины = Неопределено;
	
	КомпонентыОбмена.ПараметрыКонвертации.Свойство("НастройкиВитрины", НастройкиВитрины);
	
	Текст = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = '%1: %2'"),
		Заголовок,
		ПолучитьНавигационнуюСсылку(Ссылка));
		
	Маг1СИнтеграцияСлужебный.ОтправитьСообщениеСистемыВзаимодействий(НастройкиВитрины, Текст);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ДопРеквизитыmag1c

Функция НаборыДополнительныхРеквизитовИСведенийПоИмени(ИмяПредопределенногоНабора) Экспорт
	Значение = Неопределено;
	
	Попытка
		Значение = ПредопределенноеЗначение("Справочник.НаборыДополнительныхРеквизитовИСведений." + ИмяПредопределенногоНабора);
	Исключение
	КонецПопытки;
	
	Если Значение = Неопределено Тогда
		Попытка
			МодульСвойств = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
			Значение = УправлениеСвойствами.НаборСвойствПоИмени(ИмяПредопределенногоНабора);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если Значение = Неопределено Тогда
		ТекстИсключения = НСтр("ru = 'Не удалось получить ссылку на предопределенный набор дополнительных реквзитов %ИмяПредопределенногоНабора%'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИмяПредопределенногоНабора%", ИмяПредопределенногоНабора);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Возврат Значение;
КонецФункции

Функция ДопРеквизитMag1c(Знач ДопСвойствоИмя, НастройкиВитрины = Неопределено, Создан = Ложь) Экспорт
	
	ТипЗначения  = Маг1СПеречисления.ДопСвойстваТипЗначения(ДопСвойствоИмя);
	Наименование = Маг1СПеречисления.ДопСвойстваПредставление(ДопСвойствоИмя); 
	ИмяРеквизита = ДопСвойствоИмя;
	
	ЭтоДопСвойствоПоВитринам = Маг1СПеречисления.ДопСвойстваПоВитринам().Найти(ДопСвойствоИмя) <> Неопределено;
	ДопСвойстваИмяНастройкиНабораСвойств = Маг1СПеречисления.ДопСвойстваИмяНастройкиНабораСвойств(ДопСвойствоИмя);
	
	Если ЭтоДопСвойствоПоВитринам
		И НастройкиВитрины = Неопределено Тогда
		ТекстИсключения = НСтр("ru = 'Ошибка встраивания mag1c: %ДопСвойствоИмя можно получить, только передав настройки витрины.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойствоИмя", ДопСвойствоИмя);
		
		ВызватьИсключение ТекстИсключения;
	ИначеЕсли Не ЭтоДопСвойствоПоВитринам
		И НастройкиВитрины <> Неопределено Тогда
		ТекстИсключения = НСтр("ru = 'Ошибка встраивания mag1c: %ДопСвойствоИмя можно получить, только в целом по базе, без настроек витрины.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойствоИмя", ДопСвойствоИмя);
		
		ВызватьИсключение ТекстИсключения;
    КонецЕсли;
		
	Если НастройкиВитрины <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины)
			Или НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
			
			ТекстИсключения = НСтр("ru = '%ДопСвойствоИмя нельзя получить по несозданной витрине.'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойствоИмя", ДопСвойствоИмя);
			
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
		
		ИмяРеквизита = ИмяРеквизита + НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
		Наименование = СтрЗаменить(Наименование, "%ИмяВитрины%", НастройкиВитрины.ОсновныеНастройки.ИмяВитрины);
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	НаборСвойств = НастройкиУчетнойСистемы[ДопСвойстваИмяНастройкиНабораСвойств].НаборДопРеквизитов;
	
	Если НаборСвойств = Неопределено Тогда
		
		ТекстИсключения = НСтр("ru = 'Ошибка встраивания mag1c: для %ДопСвойстваИмяНастройкиНабораСвойств не определен набор доп реквизитов.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойстваИмяНастройкиНабораСвойств", ДопСвойстваИмяНастройкиНабораСвойств);
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ДопРеквизитMag1c = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.Заголовок <> &Наименование КАК Переименовать,
	|	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство КАК Свойство,
	|	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.Имя КАК Имя,
	|	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.ИдентификаторДляФормул КАК ИдентификаторДляФормул
	|ИЗ
	|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты
	|ГДЕ
	|	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка = &НаборСвойств
	|	И НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.Имя = &Имя";
	
	Запрос.УстановитьПараметр("Имя",          ИмяРеквизита);
	Запрос.УстановитьПараметр("НаборСвойств", НаборСвойств);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Переименовать = Ложь;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			ДопРеквизитMag1c = Выборка.Свойство;
			Переименовать    = Выборка.Переименовать; 
		Иначе
			Пока Выборка.Следующий() Цикл
				Если Выборка.Имя = Выборка.ИдентификаторДляФормул Тогда
					ДопРеквизитMag1c = Выборка.Свойство;
					Переименовать    = Выборка.Переименовать; 
				ИначеЕсли ЗначениеЗаполнено(Выборка.ИдентификаторДляФормул) Тогда
					ДопСвойство = Выборка.Свойство.ПолучитьОбъект();
					ДопСвойство.Наименование = "Удалить_" + ДопСвойство.Наименование;
					ДопСвойство.Имя          = "Удалить_" + ДопСвойство.Имя;
					ДопСвойство.ПометкаУдаления = Истина;
					
					ДопСвойство.ОбменДанными.Загрузка = Истина;
					ДопСвойство.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
					
					ДопСвойство.Записать();
					
					НаборОбъект = НаборСвойств.ПолучитьОбъект();
					НайденныеСтроки = НаборСвойств.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство",Выборка.Свойство));
					
					Для Каждого СтрМас из НайденныеСтроки Цикл
						НаборСвойств.ДополнительныеРеквизиты.Удалить(СтрМас);
					КонецЦикла;
					
					НаборОбъект.ОбменДанными.Загрузка = Истина;
					НаборОбъект.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
					НаборОбъект.Записать();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если ДопРеквизитMag1c = Неопределено Тогда
		
		ДополнительныеРеквизитыИСведенияИмя = Маг1СПеречисления.ИменаСправочников_ДополнительныеРеквизитыИСведения();
		
		ДопСвойство = ПланыВидовХарактеристик[ДополнительныеРеквизитыИСведенияИмя].СоздатьЭлемент();
		
		НаименованиеНабора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НаборСвойств, "Наименование");
		
		ДопСвойство.ТипЗначения               = ТипЗначения;
		ДопСвойство.Имя                       = ИмяРеквизита;
		ДопСвойство.Доступен                  = Истина;
		ДопСвойство.Наименование              = Наименование + " (" + НаименованиеНабора + ")";
		ДопСвойство.Заголовок                 = Наименование;
		ДопСвойство.ЭтоДополнительноеСведение = Ложь;
		
		Если ТипЗначения.СодержитТип(Тип("Строка"))
			И (ТипЗначения.КвалификаторыСтроки.Длина = 0
				Или ТипЗначения.КвалификаторыСтроки.Длина > 100) Тогда
			ДопСвойство.МногострочноеПолеВвода = Истина;
		КонецЕсли;
		
		ДопСвойство.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
		ДопСвойство.Записать();
		ДопРеквизитMag1c = ДопСвойство.Ссылка;
		
		НаборОбъект = НаборСвойств.ПолучитьОбъект();
		НоваяСтрока = НаборОбъект.ДополнительныеРеквизиты.Добавить();
		НоваяСтрока.Свойство = ДопРеквизитMag1c;
		НаборОбъект.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
		НаборОбъект.Записать();
		
		Создан = Истина;
		
	ИначеЕсли Переименовать Тогда
		
		НаименованиеНабора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НаборСвойств, "Наименование");
		Попытка
			ДопСвойство = ДопРеквизитMag1c.ПолучитьОбъект();
			ДопСвойство.Заблокировать();
			ДопСвойство.Наименование              = Наименование + " (" + НаименованиеНабора + ")";
			ДопСвойство.Заголовок                 = Наименование;
			
			ДопСвойство.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
			ДопСвойство.Записать();
		Исключение
			ОписаниеОшибки = ИнформацияОбОшибке();
			
			ТекстСообщения = НСтр("ru = 'Ошибка при переименовании доп. свойства %ДопСвойство: %ОписаниеОшибки'");
			
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДопСвойство", ДопРеквизитMag1c); 
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки", ПодробноеПредставлениеОшибки(ОписаниеОшибки)); 
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеНастроекВитрины(),
							УровеньЖурналаРегистрации.Ошибка,
							ДопРеквизитMag1c.Метаданные(),
							ДопРеквизитMag1c,
							ТекстСообщения);

		КонецПопытки;
	КонецЕсли;
	
	Возврат ДопРеквизитMag1c;
	
КонецФункции
 
Процедура ПерепривязатьКДругомуСвойству(ИсходноеСвойство, КонечноеСвойство)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Объект,
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &ИсходноеСвойство";
	
	Запрос.УстановитьПараметр("ИсходноеСвойство", ИсходноеСвойство);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Выборка.Объект);
		Набор.Отбор.Свойство.Установить(ИсходноеСвойство);
		
		Набор.Записать();
		
		Набор.Отбор.Свойство.Установить(КонечноеСвойство);
		
		НоваяСтрока = Набор.Добавить();
		НоваяСтрока.Объект   = Выборка.Объект;
		НоваяСтрока.Свойство = КонечноеСвойство;
		НоваяСтрока.Значение = Истина;
		
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДопСвойствоMag1c(Знач ДопСвойствоИмя, НастройкиВитрины = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Наименование = Маг1СПеречисления.ДопСвойстваПредставление(ДопСвойствоИмя);
	
	НаборСвойств = Неопределено;
	
	ЭтоДопСвойствоПоВитринам = Маг1СПеречисления.ДопСвойстваПоВитринам().Найти(ДопСвойствоИмя) <> Неопределено;
	ДопСвойстваИмяНастройкиНабораСвойств = Маг1СПеречисления.ДопСвойстваИмяНастройкиНабораСвойств(ДопСвойствоИмя); 
	
	Если ЭтоДопСвойствоПоВитринам
		И НастройкиВитрины = Неопределено Тогда
		ТекстИсключения = НСтр("ru = 'Ошибка встраивания mag1c: %ДопСвойствоИмя можно получить, только передав настройки витрины.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойствоИмя", ДопСвойствоИмя);
		
		ВызватьИсключение ТекстИсключения;
	ИначеЕсли Не ЭтоДопСвойствоПоВитринам 
		И НастройкиВитрины <> Неопределено Тогда
		ТекстИсключения = НСтр("ru = 'Ошибка встраивания mag1c: %ДопСвойствоИмя можно получить, только в целом по базе, без настроек витрины.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойствоИмя", ДопСвойствоИмя);
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ИмяРеквизита = ДопСвойствоИмя;
	
	Если НастройкиВитрины <> Неопределено Тогда
		
		Если Не ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины)
			Или НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
			ТекстИсключения = НСтр("ru = '%ДопСвойствоИмя нельзя получить по несозданной витрине.'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойствоИмя", ДопСвойствоИмя);
			
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
		СтрокаУИД = СтрЗаменить(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины, "-", "");
		ИмяРеквизита = ИмяРеквизита + "_" + СтрокаУИД;
		Наименование = СтрЗаменить(Наименование, "%ИмяВитрины%", НастройкиВитрины.ОсновныеНастройки.ИмяВитрины);
		ТипЗначения  = Маг1СПеречисления.ДопСвойстваТипЗначения(ДопСвойствоИмя);
		
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		Если Не ПустаяСтрока(ДопСвойстваИмяНастройкиНабораСвойств) Тогда
			НаборСвойств = НастройкиУчетнойСистемы[ДопСвойстваИмяНастройкиНабораСвойств].НаборДопСведений;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДопСвойстваИмяНастройкиНабораСвойств)
		И НаборСвойств = Неопределено Тогда
		
		ТекстИсключения = НСтр("ru = 'Ошибка встраивания mag1c: для %ДопСвойстваИмяНастройкиНабораСвойств не определен набор доп сведений.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ДопСвойстваИмяНастройкиНабораСвойств", ДопСвойстваИмяНастройкиНабораСвойств);
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если НаборСвойств = Неопределено Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Свойство,
		|	ДополнительныеРеквизитыИСведения.Заголовок <> &Наименование КАК Переименовать
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	ДополнительныеРеквизитыИСведения.Имя = &Имя
		|
		|УПОРЯДОЧИТЬ ПО
		|	Свойство";
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Свойство.Заголовок <> &Наименование КАК Переименовать,
		|	ДополнительныеСведения.Свойство КАК Свойство,
		|	ДополнительныеСведения.НомерСтроки КАК НомерСтроки,
		|	ДополнительныеСведения.Свойство.НаборСвойств КАК НаборСвойств
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Ссылка = &НаборСвойств
		|	И ДополнительныеСведения.Свойство.Имя = &Имя
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДополнительныеСведения.НомерСтроки";
		
		Запрос.УстановитьПараметр("НаборСвойств", НаборСвойств);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Имя",          ИмяРеквизита);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Переименовать = Ложь;
	
	Свойства         = Запрос.Выполнить().Выгрузить();
	
	Если Свойства.Количество() = 0 Тогда
		ДополнительныеРеквизитыИСведенияИмя = Маг1СПеречисления.ИменаСправочников_ДополнительныеРеквизитыИСведения();
		
		ДопСвойствоОбъект = ПланыВидовХарактеристик[ДополнительныеРеквизитыИСведенияИмя].СоздатьЭлемент();
				
		ДопСвойствоОбъект.ТипЗначения               = ТипЗначения;
		ДопСвойствоОбъект.Имя                       = ИмяРеквизита;
		ДопСвойствоОбъект.НаборСвойств              = НаборСвойств;
		ДопСвойствоОбъект.Доступен                  = Истина;
		ДопСвойствоОбъект.Заголовок                 = Наименование;
		ДопСвойствоОбъект.ЭтоДополнительноеСведение = Истина;
		
		Если НаборСвойств <> Неопределено Тогда
			НаименованиеНабора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НаборСвойств, "Наименование");
			ДопСвойствоОбъект.Наименование              = Наименование + " (" + НаименованиеНабора + ")";
		Иначе
			ДопСвойствоОбъект.Наименование              = Наименование;
		КонецЕсли;
		
		ДопСвойствоОбъект.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
		ДопСвойствоОбъект.Записать();
		
		Если НаборСвойств <> Неопределено Тогда
			НаборОбъект = НаборСвойств.ПолучитьОбъект();
			НоваяСтрока = НаборОбъект.ДополнительныеСведения.Добавить();
			НоваяСтрока.Свойство = ДопСвойствоОбъект.Ссылка;
			НаборОбъект.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
			НаборОбъект.Записать();
		КонецЕсли;
		
		ДопСвойство      = ДопСвойствоОбъект.Ссылка;
	Иначе
		
		ДопСвойство = Свойства[0].Свойство;
	    Переписать  = Свойства[0].Переименовать;
		
		Если НаборСвойств <> Неопределено Тогда
			
			Если Свойства[0].НаборСвойств <> НаборСвойств Тогда
				Переписать = Истина;
			КонецЕсли;
			
			Если Свойства.Количество() > 1 Тогда
				
				НомерСтроки      = Свойства[0].НомерСтроки;
				
				НачатьТранзакцию();
				
				Попытка
					
					НаборОбъект = НаборСвойств.ПолучитьОбъект();
					
					УдаляемыеСтроки = Новый Массив();
					
					Для Каждого СтрТабл из Свойства Цикл
						
						Если СтрТабл.НомерСтроки = НомерСтроки Тогда
							Продолжить;
						КонецЕсли;
						
						Если СтрТабл.Свойство <> ДопСвойство Тогда
							ПерепривязатьКДругомуСвойству(СтрТабл.Свойство, ДопСвойство);
						КонецЕсли;
						
						УдаляемыеСтроки.Добавить(НаборОбъект.ДополнительныеСведения[СтрТабл.НомерСтроки - 1]);
					КонецЦикла;
					
					Для Каждого СтрМас из УдаляемыеСтроки Цикл
						НаборОбъект.ДополнительныеСведения.Удалить(СтрМас);	
					КонецЦикла;
					
					НаборОбъект.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
					НаборОбъект.Записать();
					
					ЗафиксироватьТранзакцию();
					
				Исключение
					
					ОтменитьТранзакцию();
					ВызватьИсключение;
					
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если Переписать Тогда
			Попытка
				ДопСвойствоОбъект = ДопСвойство.ПолучитьОбъект();
				Если НаборСвойств <> Неопределено Тогда
					НаименованиеНабора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НаборСвойств, "Наименование");
					ДопСвойствоОбъект.Наименование = Наименование + " (" + НаименованиеНабора + ")";
					ДопСвойствоОбъект.НаборСвойств = НаборСвойств;	
				Иначе
					ДопСвойствоОбъект.Наименование = Наименование;
				КонецЕсли;
				
				ДопСвойствоОбъект.Заголовок = Наименование;
				
				ДопСвойствоОбъект.ДополнительныеСвойства.Вставить("Маг1с_ЭтоПолучениеДопСвойства", Истина);
				ДопСвойствоОбъект.Записать();
			Исключение
				ОписаниеОшибки = ИнформацияОбОшибке();
				
				ТекстСообщения = НСтр("ru = 'Ошибка при переименовании доп. свойства %ДопСвойство: %ОписаниеОшибки'");
				
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДопСвойство", ДопСвойство); 
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки", ПодробноеПредставлениеОшибки(ОписаниеОшибки)); 
				
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеНастроекВитрины(),
								УровеньЖурналаРегистрации.Ошибка,
								ДопСвойство.Метаданные(),
								ДопСвойство,
								ТекстСообщения);

			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ДопСвойство;

КонецФункции

Функция ГруппаНаборовДопРеквизитов(НаборДопРеквизитов) Экспорт
	
	Если Не ЗначениеЗаполнено(НаборДопРеквизитов) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыНабора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НаборДопРеквизитов, "ЭтоГруппа,Родитель");
	
	Если РеквизитыНабора.ЭтоГруппа Тогда
		Возврат НаборДопРеквизитов;
	Иначе
		Возврат РеквизитыНабора.Родитель;
	КонецЕсли;
	
КонецФункции

Функция ПапкаФайлов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Ид = Новый УникальныйИдентификатор("a84153a2-3c93-4419-a310-6b9c3417dc18");
	
	ИмяСправочникаПапкиФайлов = "ПапкиФайлов";
	
	ПапкаСсылка = Справочники[ИмяСправочникаПапкиФайлов].ПолучитьСсылку(Ид);
	
	Если Не ОбщегоНазначения.СсылкаСуществует(ПапкаСсылка) Тогда
		ПапкаОбъект = Справочники[ИмяСправочникаПапкиФайлов].СоздатьЭлемент();
		ПапкаОбъект.УстановитьСсылкуНового(ПапкаСсылка);
		ПапкаОбъект.Наименование = НСтр("ru = 'Для веб-витрины mag1c'");
		ПапкаОбъект.Описание = НСтр("ru = 'Файлы, используемые при интеграции с веб-витринами mag1c: картинки групп товаров и др..'");
		ПапкаОбъект.Записать()
	КонецЕсли;
	
	Возврат ПапкаСсылка;
КонецФункции

#КонецОбласти

#Область Контрагенты
 
Функция ЭтоКонтрагентВитрины(Контрагент, ИдентификаторВитрины) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект
	|	И ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение = ИСТИНА";
	
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Свойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоКонтрагента(ИдентификаторВитрины));
	
	Возврат Не Запрос.Выполнить().Пустой();		
КонецФункции

Процедура СделатьКонтрагентомВитрины(Контрагент, ИдентификаторВитрины) Экспорт
	
	ТаблицаДопСвойств = Новый ТаблицаЗначений();
	ТаблицаДопСвойств.Колонки.Добавить("Свойство");
	ТаблицаДопСвойств.Колонки.Добавить("Значение");
	
	НоваяСтрока = ТаблицаДопСвойств.Добавить();
	НоваяСтрока.Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоКонтрагента(ИдентификаторВитрины);
	НоваяСтрока.Значение = Истина;
	
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Контрагент,ТаблицаДопСвойств);
	
КонецПроцедуры

Процедура СнятьОтметкуКонтрагентВитрины(Контрагент, ИдентификаторВитрины) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		
	ТаблицаДопСвойств = Новый ТаблицаЗначений();
	ТаблицаДопСвойств.Колонки.Добавить("Свойство");
	ТаблицаДопСвойств.Колонки.Добавить("Значение");
	
	ДопСвойствоКонтрагента  = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоКонтрагента(ИдентификаторВитрины);
	
	НоваяСтрока = ТаблицаДопСвойств.Добавить();
	НоваяСтрока.Свойство = ДопСвойствоКонтрагента;
	НоваяСтрока.Значение = Ложь;
	
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Контрагент,ТаблицаДопСвойств);
	
	Если Маг1СИнтеграция.ЕстьДоговорыКонтрагентов(НастройкиУчетнойСистемы) Тогда
		ДоговорСтруктура = ДоговорВидЦенВитрины(Контрагент, ИдентификаторВитрины);
		Если ДоговорСтруктура <> Неопределено Тогда
			Договор = ДоговорСтруктура.Договор;
		Иначе
			Договор = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Договор) Тогда
			
			ИзменитьОтметкуДоговорВитрины(Договор, ИдентификаторВитрины, Ложь);

		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ИндентификаторОбменаПоОбъекту(Объект, УзелОбмена) Экспорт
	Инвайт = "";
		
	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат Инвайт;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
	|ГДЕ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка = &Контрагент
	|	И ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы";
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", УзелОбмена);
	Запрос.УстановитьПараметр("Контрагент", Объект);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Инвайт = Выборка.Идентификатор;	
	Иначе
		Инвайт = Строка(Объект.УникальныйИдентификатор());	
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Инвайт; 
КонецФункции

#КонецОбласти

#Область ДоговорыКонтрагентов

Функция ЭтоДоговорРаботыСВитриной(Договор, ИдентификаторВитрины, ИмяСправочникаДоговоров = "") Экспорт
	
	ДопРеквизит = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИспользоватьДоговорДляРаботыСВебВитринойMag1c(ИдентификаторВитрины);
	
	Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Договор)) Тогда
		НайденныеСтроки = Договор.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ДопРеквизит));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Возврат Ложь;
		Иначе
			Возврат НайденныеСтроки[0].Значение = Истина;
		КонецЕсли;
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыСпрДополнительныеРеквизиты.Ссылка КАК Договор
		|ИЗ
		|	Справочник.ИмяСправочникаДоговоров.ДополнительныеРеквизиты КАК ДоговорыСпрДополнительныеРеквизиты
		|ГДЕ
		|	ДоговорыСпрДополнительныеРеквизиты.Значение = ИСТИНА
		|	И ДоговорыСпрДополнительныеРеквизиты.Ссылка = &Договор
		|	И ДоговорыСпрДополнительныеРеквизиты.Свойство = &ДопРеквизит";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаДоговоров", ИмяСправочникаДоговоров);
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДопРеквизит", ДопРеквизит);
		Запрос.УстановитьПараметр("Договор", Договор);
		
		Возврат Не Запрос.Выполнить().Пустой();
	КонецЕсли;
КонецФункции

Процедура ИзменитьОтметкуДоговорВитрины(Договор, ИдентификаторВитрины, Значение) Экспорт
	
	ТаблицаДопСвойств = Новый ТаблицаЗначений();
	ТаблицаДопСвойств.Колонки.Добавить("Свойство");
	ТаблицаДопСвойств.Колонки.Добавить("Значение");
	
	НоваяСтрока = ТаблицаДопСвойств.Добавить();
	НоваяСтрока.Свойство = 
		Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИспользоватьДоговорДляРаботыСВебВитринойMag1c(ИдентификаторВитрины);
	НоваяСтрока.Значение = Значение;
	
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Договор,ТаблицаДопСвойств);
КонецПроцедуры

Процедура ПередЗаписьюДоговора(ДоговорОбъект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗначенияДопРеквизита = Новый Массив;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	СписокНастроекВитрин = СписокНастроекВитрин();
	
	Если СписокНастроекВитрин.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение из СписокНастроекВитрин Цикл
		
		НастройкиВитрины = КлючЗначение.Значение;
		
		ДопРеквизит = 
				Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИспользоватьДоговорДляРаботыСВебВитринойMag1c(
					НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
					
		Если ДопРеквизит = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеДопРеквизитаВКеш = Новый Структура("ДопРеквизит,Значение,НастройкиВитрины,НастройкиУчетнойСистемы", ДопРеквизит, Ложь, НастройкиВитрины, НастройкиУчетнойСистемы);
		
		Если ДоговорОбъект.ЭтоНовый() Тогда
			ЗначенияДопРеквизита.Добавить(ЗначениеДопРеквизитаВКеш);
		Иначе
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	ДоговорыСпрДополнительныеРеквизиты.Значение = ИСТИНА КАК ЭтоДоговорРаботыСВитриной
			|ИЗ
			|	Справочник.ИмяСправочникаДоговоров.ДополнительныеРеквизиты КАК ДоговорыСпрДополнительныеРеквизиты
			|ГДЕ
			|	ДоговорыСпрДополнительныеРеквизиты.Ссылка = &Ссылка
			|	И ДоговорыСпрДополнительныеРеквизиты.Свойство = &ДопРеквизит";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаДоговоров", ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента()));
		
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Ссылка", ДоговорОбъект.Ссылка);
			Запрос.УстановитьПараметр("ДопРеквизит", ДопРеквизит);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ЗначениеДопРеквизитаВКеш.Значение = Выборка.ЭтоДоговорРаботыСВитриной; 
				ЗначенияДопРеквизита.Добавить(ЗначениеДопРеквизитаВКеш);
			Иначе
				ЗначенияДопРеквизита.Добавить(ЗначениеДопРеквизитаВКеш);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДоговорОбъект.ДополнительныеСвойства.Вставить("ЗначенияДопРеквзитаИспользоватьДоговорДляРаботыСВебВитринойMag1cПередЗаписью", ЗначенияДопРеквизита);
			
	Если ДоговорОбъект.ЭтоНовый() Тогда
		ДоговорОбъект.ДополнительныеСвойства.Вставить("ВидЦенПередЗаписью", Неопределено);
	Иначе
		ВидЦенБыл = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорОбъект.Ссылка, НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.ВидЦен);
		ДоговорОбъект.ДополнительныеСвойства.Вставить("ВидЦенПередЗаписью", ВидЦенБыл);
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПриЗаписиДоговора(ДоговорОбъект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗначенияДопРеквизита = Неопределено;
	ДоговорОбъект.ДополнительныеСвойства.Свойство("ЗначенияДопРеквзитаИспользоватьДоговорДляРаботыСВебВитринойMag1cПередЗаписью", ЗначенияДопРеквизита);
	
	Если ЗначенияДопРеквизита = Неопределено
		Или ЗначенияДопРеквизита.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗначениеДопРеквизитаИзКеша из ЗначенияДопРеквизита Цикл 
		
		НастройкиВитрины          = ЗначениеДопРеквизитаИзКеша.НастройкиВитрины;
		НастройкиУчетнойСистемы   = ЗначениеДопРеквизитаИзКеша.НастройкиУчетнойСистемы;
				
		ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
		
		ЭтоДоговорРаботыСВитриной = ЭтоДоговорРаботыСВитриной(ДоговорОбъект, ИдентификаторВитрины);
		
		Если (ЭтоДоговорРаботыСВитриной
				<> ЗначениеДопРеквизитаИзКеша.Значение)
			Или (ЭтоДоговорРаботыСВитриной
					И ДоговорОбъект[НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.ВидЦен]
				 	<> ДоговорОбъект.ДополнительныеСвойства.ВидЦенПередЗаписью) Тогда
					
		
			Если НастройкиВитрины = Неопределено Тогда
				Если ЭтоДоговорРаботыСВитриной Тогда
					ВызватьИсключение НСтр("ru = 'Работа с витриной не настроена. Флаг ""Использовать для работы с веб-витриной mag1c"" устанавливать нельзя'");
				КонецЕсли;	
			Иначе
				УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
				
				Если УзелОбмена = Неопределено
					И ЭтоДоговорРаботыСВитриной Тогда
					ВызватьИсключение НСтр("ru = 'Работа с витриной не настроена. Флаг ""Использовать для работы с веб-витриной mag1c"" устанавливать нельзя'");
				КонецЕсли;
									
				ЭтоКонтрагентВитрины = ЭтоКонтрагентВитрины(ДоговорОбъект[НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.Контрагент],
															ИдентификаторВитрины);

				Если Не ЭтоКонтрагентВитрины 
					И ЭтоДоговорРаботыСВитриной Тогда 
					ВызватьИсключение НСтр("ru = 'Флаг ""Использовать для работы с веб-витриной"" можно устанавливать только тогда, когда контрагент работает с витриной'");
				КонецЕсли;
				
				Если ЭтоКонтрагентВитрины
					И УзелОбмена <> Неопределено Тогда
					ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ДоговорОбъект[НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.Контрагент]);
	            КонецЕсли;
				
			КонецЕсли;	
		КонецЕсли;
					
		Если Не ЭтоДоговорРаботыСВитриной  
			Или ЗначениеДопРеквизитаИзКеша.Значение Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДоговорыСпрДополнительныеРеквизиты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИмяСправочникаДоговоров.ДополнительныеРеквизиты КАК ДоговорыСпрДополнительныеРеквизиты
		|ГДЕ
		|	ДоговорыСпрДополнительныеРеквизиты.Ссылка <> &Ссылка
		|	И ДоговорыСпрДополнительныеРеквизиты.Ссылка.ИмяПоляСправочникДоговорыКонтрагент = &Контрагент
		|	И ДоговорыСпрДополнительныеРеквизиты.Значение = ИСТИНА
		|	И ДоговорыСпрДополнительныеРеквизиты.Свойство = &ДопРеквизит";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаДоговоров", ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента()));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПоляСправочникДоговорыКонтрагент", НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.Контрагент);
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Ссылка", ДоговорОбъект.Ссылка);
		Запрос.УстановитьПараметр("Контрагент", ДоговорОбъект[НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.Контрагент]);
		Запрос.УстановитьПараметр("ДопРеквизит", ЗначениеДопРеквизитаИзКеша.ДопРеквизит);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДругойДоговорОбъект = Выборка.Ссылка.ПолучитьОбъект();	
			НайденныеСтроки = ДругойДоговорОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ЗначениеДопРеквизитаИзКеша.ДопРеквизит));
			Для Каждого СтрМас из НайденныеСтроки Цикл
				 ДругойДоговорОбъект.ДополнительныеРеквизиты.Удалить(СтрМас);		
			КонецЦикла;
			 
			ДругойДоговорОбъект.ОбменДанными.Загрузка = Истина;
			ДругойДоговорОбъект.Записать();
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВсеИспользуемыеВидыЦен(НастройкиВитрины) Экспорт
	СведенияОбОрганизации = Маг1СИнтеграцияСлужебный.СведенияОбОрганизации(НастройкиВитрины.ОсновныеНастройки);
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ВидыЦен = Новый Массив;
	
	Если Маг1СИнтеграция.ЕстьДоговорыКонтрагентов(НастройкиУчетнойСистемы) Тогда
		ДопРеквизит = 
			Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИспользоватьДоговорДляРаботыСВебВитринойMag1c(
					НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоговорыСпрДополнительныеРеквизиты.Ссылка.ИмяПоляСправочникДоговорыВидЦен КАК ВидЦен
		|ИЗ
		|	Справочник.ИмяСправочникаДоговоров.ДополнительныеРеквизиты КАК ДоговорыСпрДополнительныеРеквизиты
		|ГДЕ
		|	ДоговорыСпрДополнительныеРеквизиты.Значение = ИСТИНА
		|	И ДоговорыСпрДополнительныеРеквизиты.Свойство = &ДопРеквизит";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаДоговоров", ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента()));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПоляСправочникДоговорыВидЦен", НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.ВидЦен);
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДопРеквизит", ДопРеквизит);
		
		ВидыЦен = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидЦен");
		
		Если ВидыЦен.Найти(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен) = Неопределено Тогда
			ВидыЦен.Добавить(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен);
		КонецЕсли;
	Иначе
		ВидыЦен = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен);
	КонецЕсли;
	
	Если СведенияОбОрганизации.ЯвляетсяПлательщикомНДС Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ВидыЦен, "ЦенаВключаетНДС");
		ВидыЦенСОшибками = Новый Массив;
		Для Каждого КлючЗначение из ЗначенияРеквизитов Цикл
			Если Не КлючЗначение.Значение.ЦенаВключаетНДС Тогда
				ВидыЦенСОшибками.Добавить(Строка(КлючЗначение.Ключ));		
			КонецЕсли;
		КонецЦикла;
	
		Если ВидыЦенСОшибками.Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru = 'Следующие виды цен не включают НДС, поэтому информация об этих ценах не может быть передана на веб-витрину mag1c. Эти виды цен могут быть указаны в настройках витрины, или в договорах (соглашениях) покупателей, которые используются для витрины. Измените виды цен в настройках: %ВидыЦен'");	
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ВидыЦен", СтрСоединить(ВидыЦенСОшибками, ","));
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат ВидыЦен;
КонецФункции
 
Функция ДоговорВидЦенВитрины(Контрагент, ИдентификаторВитрины) Экспорт
		
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ДопРеквизит = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИспользоватьДоговорДляРаботыСВебВитринойMag1c(ИдентификаторВитрины);
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыСпрДополнительныеРеквизиты.Ссылка КАК Договор,
	|	ДоговорыСпрДополнительныеРеквизиты.Ссылка.ИмяПоляСправочникДоговорыВидЦен КАК ВидЦен
	|ИЗ
	|	Справочник.ИмяСправочникаДоговоров.ДополнительныеРеквизиты КАК ДоговорыСпрДополнительныеРеквизиты
	|ГДЕ
	|	ДоговорыСпрДополнительныеРеквизиты.Значение = ИСТИНА
	|	И ДоговорыСпрДополнительныеРеквизиты.Ссылка.ИмяПоляСправочникДоговорыКонтрагент = &Контрагент
	|	И ДоговорыСпрДополнительныеРеквизиты.Свойство = &ДопРеквизит";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаДоговоров", ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента()));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПоляСправочникДоговорыВидЦен", НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.ВидЦен);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПоляСправочникДоговорыКонтрагент", НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.Контрагент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДопРеквизит", ДопРеквизит);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ВидЦен) Тогда
			Возврат Новый Структура("ВидЦен,Договор",
										Выборка.ВидЦен,
										Выборка.Договор);
		Иначе
			Возврат Новый Структура("ВидЦен,Договор", 
										Неопределено,
										Выборка.Договор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
 
Функция ЕстьДоговорыКонтрагентов(НастройкиУчетнойСистемы) Экспорт
	Возврат НастройкиУчетнойСистемы.ДоговорКонтрагента.ОграничениеТипа <> Неопределено;	
КонецФункции

#КонецОбласти

#Область Номенклатура
 
Процедура СформироватьВТАктивнаяНоменклатура(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиВитрины, ФормироватьВТОстаткиДляВыгрузки, ВидЦен = Неопределено) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	СформироватьВТЦены(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиВитрины, ВидЦен);
	
	Если НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоОстаткам
		Или (НастройкиВитрины.ОсновныеНастройки.ВыгружатьИнформативныеОстатки
			 И ФормироватьВТОстаткиДляВыгрузки) Тогда
		СформироватьВТОстатки(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиВитрины);
	Иначе
		СформироватьПустуюВТ("ВТОстатки", МенеджерВременныхТаблиц);
	КонецЕсли;
	
	Если НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоПродажам Тогда
		СформироватьВТПродажи(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры);
	Иначе
		СформироватьПустуюВТ("ВТПродажи", МенеджерВременныхТаблиц);
	КонецЕсли;
	
	Если НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоЗаказамПоставщикам Тогда
		СформироватьВТЗаказыПоставщикам(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры);
	Иначе
		СформироватьПустуюВТ("ВТЗаказыПоставщикам", МенеджерВременныхТаблиц);
	КонецЕсли;

	Если НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоСегменту
		И НастройкиУчетнойСистемы.СегментНоменклатуры.ОграничениеТипа <> Неопределено Тогда
 		СформироватьВТСоставСегментаНоменклатуры(МенеджерВременныхТаблиц,
												НастройкиФильтровНоменклатуры, 
												НастройкиВитрины); 
	Иначе
		СформироватьПустуюВТ("ВТСоставСегментаНоменклатурыБезДублей", МенеджерВременныхТаблиц);
	КонецЕсли;

	УдалитьВТВМенеджере("ВТАктивнаяНоменклатура", МенеджерВременныхТаблиц);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВТЦены.Номенклатура КАК Номенклатура,
	|	&ТекстХарактеристика КАК Характеристика,
	|	&ТекстУпаковки КАК Упаковка,
	|	ВЫБОР
	|		КОГДА НЕ &ПубликоватьТолькоАктивныеПозиции
	|			ТОГДА ВТЦены.Цена
	|		КОГДА НЕ ВТОстатки.Номенклатура ЕСТЬ NULL
	|					И &ОтборПоОстаткам
	|				ИЛИ НЕ ВТПродажи.Номенклатура ЕСТЬ NULL
	|					И &ОтборПоПродажам
	|				ИЛИ НЕ ВТЗаказыПоставщикам.Номенклатура ЕСТЬ NULL
	|					И &ОтборПоЗаказамПоставщикам
	|				ИЛИ НЕ ВТСоставСегментаНоменклатурыБезДублей.Номенклатура ЕСТЬ NULL
	|					И &ОтборПоСегменту
	|			ТОГДА ВТЦены.Цена
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ ВТАктивнаяНоменклатура
	|ИЗ
	|	ВТЦены КАК ВТЦены
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ВТЦены.Номенклатура = ВТОстатки.Номенклатура
	|			И ВТЦены.Характеристика = ВТОстатки.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПродажи КАК ВТПродажи
	|		ПО ВТЦены.Номенклатура = ВТПродажи.Номенклатура
	|			И ВТЦены.Характеристика = ВТПродажи.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказыПоставщикам КАК ВТЗаказыПоставщикам
	|		ПО ВТЦены.Номенклатура = ВТЗаказыПоставщикам.Номенклатура
	|			И ВТЦены.Характеристика = ВТЗаказыПоставщикам.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСоставСегментаНоменклатурыБезДублей КАК ВТСоставСегментаНоменклатурыБезДублей
	|		ПО ВТЦены.Номенклатура = ВТСоставСегментаНоменклатурыБезДублей.Номенклатура 
	|			И (ВТСоставСегментаНоменклатурыБезДублей.Характеристика = &ПустаяХарактеристика
	|				ИЛИ ВТЦены.Характеристика = ВТСоставСегментаНоменклатурыБезДублей.Характеристика)";
	
	Запрос = Новый Запрос;
	ИмяСправочникаУпаковок = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Упаковки());
 	ИмяСправочникаХарактеристик = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());

	Если Не ПустаяСтрока(ИмяСправочникаУпаковок) Тогда
		ТекстУпаковки = 
		"ВЫБОР 
		|	КОГДА ВТЦены.Упаковка = &ПустаяУпаковка ТОГДА
		|		НЕОПРЕДЕЛЕНО
		|	ИНАЧЕ
		|		ВТЦены.Упаковка
		|КОНЕЦ";
		
		Запрос.УстановитьПараметр("ПустаяУпаковка", Справочники[ИмяСправочникаУпаковок].ПустаяСсылка());
	Иначе
		ТекстУпаковки = "НЕОПРЕДЕЛЕНО"
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяСправочникаХарактеристик) Тогда
		ТекстХарактеристика = 
		"ВЫБОР 
		|	КОГДА ВТЦены.Характеристика = &ПустаяХарактеристика ТОГДА
		|		НЕОПРЕДЕЛЕНО
		|	ИНАЧЕ
		|		ВТЦены.Характеристика
		|КОНЕЦ";
		
		Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники[ИмяСправочникаХарактеристик].ПустаяСсылка());
	Иначе
		ТекстХарактеристика = "НЕОПРЕДЕЛЕНО"
	КонецЕсли;
	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстХарактеристика", ТекстХарактеристика);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУпаковки", ТекстУпаковки);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПубликоватьТолькоАктивныеПозиции", НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ПубликоватьТолькоАктивныеПозиции);
	Запрос.УстановитьПараметр("ОтборПоОстаткам", НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоОстаткам);
	Запрос.УстановитьПараметр("ОтборПоПродажам", НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоПродажам);
	Запрос.УстановитьПараметр("ОтборПоЗаказамПоставщикам", НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоЗаказамПоставщикам);
	Запрос.УстановитьПараметр("ОтборПоСегменту", НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоСегменту);
	Запрос.УстановитьПараметр("ПустаяХарактеристика", НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.Значение);
	
	Запрос.Выполнить();
КонецПроцедуры

Функция НастройкиФильтровНоменклатуры(НастройкиВитрины) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИмяСправочникаНоменклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|ГДЕ
	|	НоменклатураДополнительныеРеквизиты.Свойство = &ДопСвойство
	|	И НоменклатураДополнительныеРеквизиты.Значение = ИСТИНА";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаНоменклатура",
		ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()));
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДопСвойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИсключитьИзПубликацииНаВебВитринеMag1c());
		
	Результат = Новый Структура();
	Результат.Вставить("ЗначенияОтборовПоНоменклатуре", НастройкиВитрины.ДополнительныеНастройки.ОтборыКаталогаТоваров);
	Результат.Вставить("ИсключаемаяНоменклатура", Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Результат.Вставить("РеквизитОтбораПоИерархии",  РеквизитОтбораПоИерархии(НастройкиВитрины, НастройкиУчетнойСистемы));
	
	Результат.Вставить("УслугаДоставки", НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.УслугаДоставки); 
	Результат.Вставить("НаборСвойств", НастройкиУчетнойСистемы.Номенклатура.Реквизиты.НаборСвойств); 
		
	Возврат Результат;
	
КонецФункции

Функция РеквизитОтбораПоИерархии(НастройкиВитрины, НастройкиУчетнойСистемы) Экспорт
	Если НастройкиВитрины.ДополнительныеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ГруппыНоменклатуры() Тогда
		Возврат "Родитель";
	Иначе
		Возврат НастройкиУчетнойСистемы.Номенклатура.Реквизиты.ВидНоменклатуры;
	КонецЕсли;
КонецФункции

Процедура ВставитьОтборПоНоменклатуреВТекстЗапроса(Запрос, ИмяПоляНоменклатура, НастройкиФильтровНоменклатуры) Экспорт
	
	ТекстыОтборов = Новый Массив();
	
	ТекстыОтборов.Добавить("НЕ &ИмяПоляНоменклатура.ПометкаУдаления");
	ДополнительныйФильтрВыгрузкиНоменклатуры = ТекстФильтраПоПараметрамОтбора(Запрос, "Номенклатура", "&ИмяПоляНоменклатура"); 
	Если Не ПустаяСтрока(ДополнительныйФильтрВыгрузкиНоменклатуры) Тогда
		ТекстыОтборов.Добавить(ДополнительныйФильтрВыгрузкиНоменклатуры);
	КонецЕсли;
	
	Если НастройкиФильтровНоменклатуры.ЗначенияОтборовПоНоменклатуре.Количество() > 0 Тогда
		ТекстыОтборов.Добавить(" &ИмяПоляНоменклатура." + НастройкиФильтровНоменклатуры.РеквизитОтбораПоИерархии + " В (&ЗначенияОтборовПоНоменклатуре)");
		Запрос.УстановитьПараметр("ЗначенияОтборовПоНоменклатуре", НастройкиФильтровНоменклатуры.ЗначенияОтборовПоНоменклатуре);
	КонецЕсли;	
	
	Если НастройкиФильтровНоменклатуры.ИсключаемаяНоменклатура.Количество() > 0 Тогда
		ТекстыОтборов.Добавить(" НЕ &ИмяПоляНоменклатура В (&ИсключаемаяНоменклатура)");
		Запрос.УстановитьПараметр("ИсключаемаяНоменклатура", НастройкиФильтровНоменклатуры.ИсключаемаяНоменклатура);
	КонецЕсли;	
	
	ТекстОтборов = СтрСоединить(ТекстыОтборов, " И ");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрНоменклатуры", "(" + ТекстОтборов + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяПоляНоменклатура", ИмяПоляНоменклатура);

КонецПроцедуры

Процедура ВставитьОтборПоВТПубликуемаяНоменклатура(Запрос, ИмяПоляНоменклатура, НастройкиФильтровНоменклатуры)
	
	СформироватьВТПубликуемаяНоменклатура(Запрос.МенеджерВременныхТаблиц,
											НастройкиФильтровНоменклатуры);
	ТекстОтбора = "(&ИмяПоляНоменклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТПубликуемаяНоменклатура))";
	ТекстОтбора = СтрЗаменить(ТекстОтбора, "&ИмяПоляНоменклатура", ИмяПоляНоменклатура);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрНоменклатуры", ТекстОтбора);	
	
КонецПроцедуры

Функция НоменклатураСоответствуетОтборам(Номенклатура, ЭтоГруппа, ПараметрыКонвертации) Экспорт
	
	Если Номенклатура = ПараметрыКонвертации.УслугаДоставки Тогда
		Возврат Истина;
	КонецЕсли;
	
	НастройкиФильтровНоменклатуры = ПараметрыКонвертации.НастройкиФильтровНоменклатуры;
	ИмяСправочникаНоменклатура    = ИмяСправочника(Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы(),
													Маг1СПеречисления.ИменаСправочников_Номенклатура());
	
	Если НастройкиФильтровНоменклатуры.ЗначенияОтборовПоНоменклатуре.Количество() = 0
		И НастройкиФильтровНоменклатуры.ИсключаемаяНоменклатура.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ЭтоГруппа Тогда
		
		Если ПараметрыКонвертации.НастройкиВитрины.ДополнительныеНастройки.ИерархияПо <> Маг1СПеречисления.ИерархияПо_ГруппыНоменклатуры() Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если НастройкиФильтровНоменклатуры.ЗначенияОтборовПоНоменклатуре.Количество() = 0 Тогда
			Возврат Истина;
		КонецЕсли;
		
		ЗначенияДляОтбораГрупп = Новый Массив;
		
		Для Каждого СтрМас из НастройкиФильтровНоменклатуры.ЗначенияОтборовПоНоменклатуре Цикл
			Если СтрМас = Номенклатура Тогда
				Возврат Истина;
			КонецЕсли;
			
			// При отборе групп нужно исключить пустую ссылку (отбор "без группы")
			Если ЗначениеЗаполнено(СтрМас) Тогда
				ЗначенияДляОтбораГрупп.Добавить(СтрМас)
			КонецЕсли;
		КонецЦикла;
		
		// Если группа не проходит фильтр, но в ней есть подчиненные группы,
		// которые фильтр проходят, то такая группа также должна выгружаться.
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СпрНоменклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИмяСправочникаНоменклатура КАК СпрНоменклатура
		|ГДЕ
		|   СпрНоменклатура.ЭтоГруппа
		|	И СпрНоменклатура.Ссылка В ИЕРАРХИИ(&Ссылка)
		| 	И СпрНоменклатура.Ссылка В (&ЗначенияОтборовПоНоменклатуре)";
		
		Запрос.УстановитьПараметр("Ссылка", Номенклатура);
		Запрос.УстановитьПараметр("ЗначенияОтборовПоНоменклатуре", ЗначенияДляОтбораГрупп);
		
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СпрНоменклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИмяСправочникаНоменклатура КАК СпрНоменклатура
		|ГДЕ
		|	СпрНоменклатура.Ссылка = &Ссылка
		|	И &ФильтрНоменклатуры";
		
		Запрос.УстановитьПараметр("Ссылка", Номенклатура);
		ВставитьОтборПоНоменклатуреВТекстЗапроса(Запрос,
												"СпрНоменклатура.Ссылка",
												ПараметрыКонвертации.НастройкиФильтровНоменклатуры);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаНоменклатура", ИмяСправочникаНоменклатура);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ЗарегистрироватьСправочникНоменклатура(НастройкиВитрины, ВыгружатьВсеТовары) Экспорт
	
 	НастройкиУчетнойСистемы       = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
			
	Получатель                 = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Получатель, "НомерОтправленного");
	
	ИмяСправочникаНоменклатура = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());
	
	ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	
	ВыгружаемыеСвойстваТекущие = НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров;
	ВыгружаемыеСвойстваСлепок  = Маг1СИнтеграцияСлужебный.ПрочитатьСлепокВыгружаемыхСвойств(ИдентификаторВитрины);
	
	ВыгружатьВсюНоменклатуру   = ВыгружатьВсеТовары;
	
	ЕстьХарактеристики = НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.ОграничениеТипа <> Неопределено;
	
	Если Не ЕстьХарактеристики Тогда
		ВыгружатьВсеХарактеристики = Истина;	
	Иначе
		ВыгружатьВсеХарактеристики = ВыгружатьВсеТовары;
	КонецЕсли;
		
	НаборыДопРеквизитовНоменклатуры  = Новый Массив();
	НаборыДопРеквизитовХарактеристик = Новый Массив();
	
	Если Не ВыгружатьВсюНоменклатуру
		Или Не ВыгружатьВсеХарактеристики Тогда 
		
		НовыеСвойства = Новый Соответствие;
	
		Если ВыгружаемыеСвойстваСлепок <> Неопределено
			И ВыгружаемыеСвойстваТекущие <> Неопределено Тогда
			
			Для Каждого КлючЗначение из ВыгружаемыеСвойстваТекущие Цикл
				
				Если ВыгружаемыеСвойстваСлепок.Получить(КлючЗначение.Ключ) = Неопределено Тогда
					НовыеСвойства.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Для Каждого КлючЗначение из НовыеСвойства Цикл
			
			ОписаниеСвойства = Маг1СИнтеграция.ОписаниеСвойства(КлючЗначение.Ключ);
			Если ОписаниеСвойства.ЭтоРеквизит Тогда
				Если ОписаниеСвойства.ИспользуетсяДляХарактеристик Тогда
					ВыгружатьВсеХарактеристики = Истина;
					НаборыДопРеквизитовХарактеристик.Очистить();
				Иначе
					ВыгружатьВсюНоменклатуру = Истина;
					НаборыДопРеквизитовНоменклатуры.Очистить();
				КонецЕсли;
			Иначе
				Если ОписаниеСвойства.ИспользуетсяДляХарактеристик Тогда
					Если ОписаниеСвойства.Наборы.Найти(НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.НаборДопРеквизитов) <> Неопределено Тогда				
						ВыгружатьВсеХарактеристики = Истина;
					    НаборыДопРеквизитовХарактеристик.Очистить();
					ИначеЕсли Не ВыгружатьВсеХарактеристики Тогда
						ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НаборыДопРеквизитовХарактеристик, ОписаниеСвойства.Наборы, Истина);
					КонецЕсли;	
				Иначе	
					Если ОписаниеСвойства.Наборы.Найти(НастройкиУчетнойСистемы.Номенклатура.НаборДопРеквизитов) <> Неопределено Тогда
						ВыгружатьВсюНоменклатуру = Истина;
						НаборыДопРеквизитовНоменклатуры.Очистить();
					ИначеЕсли Не ВыгружатьВсюНоменклатуру Тогда
						ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НаборыДопРеквизитовНоменклатуры, ОписаниеСвойства.Наборы, Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ВыгружатьВсюНоменклатуру
				И ВыгружатьВсеХарактеристики Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;
	
	Если ВыгружатьВсюНоменклатуру 
		Или НаборыДопРеквизитовНоменклатуры.Количество() > 0
		Или ЕстьХарактеристики
			И (ВыгружатьВсеХарактеристики
				Или НаборыДопРеквизитовХарактеристик.Количество() > 0) Тогда
		
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		НастройкиФильтровНоменклатуры = НастройкиФильтровНоменклатуры(НастройкиВитрины); 
		СформироватьВТПубликуемаяНоменклатура(МенеджерВТ,
												НастройкиФильтровНоменклатуры);
	КонецЕсли;

	Если ВыгружатьВсюНоменклатуру 
		Или НаборыДопРеквизитовНоменклатуры.Количество() > 0 Тогда
	
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Если ВыгружатьВсюНоменклатуру Тогда
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ВТПубликуемаяНоменклатура.Номенклатура КАК Ссылка,
			|	ВТПубликуемаяНоменклатура.Группа КАК Группа
			|ИЗ
			|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
			|ИТОГИ ПО
			|	Группа ИЕРАРХИЯ"
		Иначе
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ВложенныйЗапрос.Ссылка КАК Ссылка,
			|	ВЫРАЗИТЬ(ВложенныйЗапрос.Ссылка КАК Справочник.ИмяСправочникаНоменклатура).ИмяПоляГруппы КАК Группа,
			|	СУММА(Контроль) КАК Контроль
			|ИЗ
			|	(ВЫБРАТЬ
			|		ВТПубликуемаяНоменклатура.Номенклатура КАК Ссылка,
			|       1 КАК Контроль
			|	ИЗ
			|		ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка,
			|       -1 КАК Контроль
			|	ИЗ
			|		РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
			|	ГДЕ
			|		ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы
			|		И ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка ССЫЛКА Справочник.ИмяСправочникаНоменклатура
			|		И НЕ ВЫРАЗИТЬ(ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка КАК Справочник.ИмяСправочникаНоменклатура).ЭтоГруппа
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ВТПубликуемаяНоменклатура.Номенклатура КАК Ссылка,
			|       1 КАК Контроль
			|	ИЗ
			|		ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	        |   ГДЕ 
			|   	ВТПубликуемаяНоменклатура.НаборСвойств В (&НаборыСвойств)) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Ссылка,
			|	ВЫРАЗИТЬ(ВложенныйЗапрос.Ссылка КАК Справочник.ИмяСправочникаНоменклатура).ИмяПоляГруппы
			|ИМЕЮЩИЕ
			|	СУММА(Контроль) <> 0
			|ИТОГИ ПО
			|	Группа ИЕРАРХИЯ";
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяПоляГруппы", НастройкиФильтровНоменклатуры.РеквизитОтбораПоИерархии);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаНоменклатура", ИмяСправочникаНоменклатура);
			
			Запрос.УстановитьПараметр("УзелИнформационнойБазы", Получатель); 
			Запрос.УстановитьПараметр("НаборыСвойств", НаборыДопРеквизитовНоменклатуры); 
				
		КонецЕсли;
	
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Выборка.Ссылка);
			ИначеЕсли ЗначениеЗаполнено(Выборка.Группа) Тогда	
				ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Выборка.Группа);
			КонецЕсли;
		КонецЦикла;
	
		ЗарегистрироватьКартинкиНоменклатуры(НастройкиВитрины, НомерОтправленного, Неопределено);		
		
	КонецЕсли;	
	
	Если Не ЕстьХарактеристики Тогда
		ДействияПриОкончанииРегистрации(ВыгружатьВсеТовары, НастройкиВитрины, ВыгружаемыеСвойстваТекущие, НомерОтправленного);
		Возврат;
	КонецЕсли;

	Если ВыгружатьВсеХарактеристики
		Или НаборыДопРеквизитовХарактеристик.Количество() > 0 Тогда
		
		ТекстыВыборкиВладельцев = Новый Массив;
		
		Для Каждого КлючЗначение из НастройкиУчетнойСистемы.Номенклатура.РеквизитыВладельцаХарактеристик Цикл
			ТекстВыборкиВладельца =
			"ВЫБРАТЬ
			|	ВТПубликуемаяНоменклатура.Номенклатура#ИмяРеквизитаВладелец КАК ВладелецХарактеристик,
			|	ВТПубликуемаяНоменклатура.Номенклатура.#ИмяРеквизитаНаборСвойств КАК НаборСвойств
			|ИЗ
			|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура";
			
			Если КлючЗначение.Ключ = "Ссылка" Тогда
				ТекстВыборкиВладельца = СтрЗаменить(ТекстВыборкиВладельца, "#ИмяРеквизитаВладелец", "");
			Иначе
				ТекстВыборкиВладельца = СтрЗаменить(ТекстВыборкиВладельца, "#ИмяРеквизитаВладелец", "." + КлючЗначение.Ключ);
	        КонецЕсли;
			
			ТекстВыборкиВладельца = СтрЗаменить(ТекстВыборкиВладельца, "#ИмяРеквизитаНаборСвойств", КлючЗначение.Значение);
			
			ТекстыВыборкиВладельцев.Добавить(ТекстВыборкиВладельца);
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.ВладелецХарактеристик КАК ВладелецХарактеристик,
		|	ВложенныйЗапрос.НаборСвойств КАК НаборСвойств
		|ПОМЕСТИТЬ ВТВладельцы
		|ИЗ
		|	(#ТекстВыборкиВладельцев) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
		Если ВыгружатьВсеХарактеристики Тогда
			ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ
			|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ИмяСправочникаХарактеристики КАК ХарактеристикиНоменклатуры
			|ГДЕ
			|	ХарактеристикиНоменклатуры.Владелец В
			|			(ВЫБРАТЬ
			|				ВТВладельцы.ВладелецХарактеристик
			|			ИЗ
			|				ВТВладельцы)";
		Иначе
			ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ
			|	ВложенныйЗапрос.Ссылка КАК Ссылка,
			|	СУММА(Контроль) КАК Контроль
			|ИЗ
			|	(ВЫБРАТЬ
			|		ХарактеристикиНоменклатуры.Ссылка КАК Ссылка,
			|       1 КАК Контроль
			|ИЗ
			|	Справочник.ИмяСправочникаХарактеристики КАК ХарактеристикиНоменклатуры
			|ГДЕ
			|	ХарактеристикиНоменклатуры.Владелец В
			|			(ВЫБРАТЬ
			|				ВТВладельцы.ВладелецХарактеристик
			|			ИЗ
			|				ВТВладельцы)
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка,
			|       -1 КАК Контроль
			|	ИЗ
			|		РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
			|	ГДЕ
			|		ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы
			|		И ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка ССЫЛКА Справочник.ИмяСправочникаХарактеристики
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ХарактеристикиНоменклатуры.Ссылка КАК Ссылка,
			|       1 КАК Контроль
			|	ИЗ
			|		Справочник.ИмяСправочникаХарактеристики КАК ХарактеристикиНоменклатуры
			|	ГДЕ
			|		ХарактеристикиНоменклатуры.Владелец В
			|				(ВЫБРАТЬ
			|					ВТВладельцы.ВладелецХарактеристик
			|				ИЗ
			|					ВТВладельцы КАК ВТВладельцы
			|				ГДЕ
			|					ВТВладельцы.НаборСвойств В (&НаборыСвойств))) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Ссылка
			|ИМЕЮЩИЕ
			|	СУММА(Контроль) <> 0";
			
			Запрос.УстановитьПараметр("УзелИнформационнойБазы", Получатель);
			Запрос.УстановитьПараметр("НаборыСвойств", НаборыДопРеквизитовХарактеристик);
		КонецЕсли;
		
		ИмяСправочникаХарактеристики = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ТекстВыборкиВладельцев", СтрСоединить(ТекстыВыборкиВладельцев, " ОБЪЕДИНИТЬ ВСЕ "));
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаХарактеристики", ИмяСправочникаХарактеристики);

		Запрос.Текст = ТекстЗапроса;
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
		
		ЗарегистрироватьКартинкиХарактеристик(НастройкиВитрины, НомерОтправленного, Неопределено);
		
	КонецЕсли;
	
	ДействияПриОкончанииРегистрации(ВыгружатьВсеТовары, НастройкиВитрины, ВыгружаемыеСвойстваТекущие, НомерОтправленного);
	
КонецПроцедуры

Процедура ЗарегистрироватьТоварыПоЗаказуДляВременнойСсылки(ЗаказСсылка, СрокДействияСсылки, НастройкиВитрины) Экспорт
	            
	НастройкиУчетнойСистемы    = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	Получатель                 = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	НомерОтправленного         = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Получатель, "НомерОтправленного");
			
	ИмяСправочникаХарактеристики = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
	ИмяСправочникаНоменклатура   = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());
	ИмяДокументаЗаказ            = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ЗаказПокупателя());
	ИмяТЧТовары                  = НастройкиУчетнойСистемы.ЗаказПокупателя.Реквизиты.Товары;
	
	ЕстьХарактеристики = Не ПустаяСтрока(ИмяСправочникаХарактеристики);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ДокументТовары.Номенклатура КАК Ссылка,
	|		ДокументТовары.Номенклатура.ИмяПоляГруппы КАК Группа
	|	ИЗ
	|		Документ.ИмяДокументаЗаказ.ИмяТЧТовары КАК ДокументТовары
	|ГДЕ
	|	ДокументТовары.Ссылка = &ЗаказСсылка
	|";
	Если ЕстьХарактеристики Тогда
		Запрос.Текст = 	Запрос.Текст + " 
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ДокументТовары.Характеристика КАК Ссылка,
		|       НЕОПРЕДЕЛЕНО
		|	ИЗ
		|		Документ.ИмяДокументаЗаказ.ИмяТЧТовары КАК ДокументТовары
		|	ГДЕ
		|		ДокументТовары.Ссылка = &ЗаказСсылка
		|";
	КонецЕсли;
	Запрос.Текст = 	Запрос.Текст + " 
	|
	|ИТОГИ ПО
	|	Группа ИЕРАРХИЯ";
			
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяПоляГруппы",
					Маг1СИнтеграция.РеквизитОтбораПоИерархии(НастройкиВитрины, НастройкиУчетнойСистемы));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаНоменклатура", ИмяСправочникаНоменклатура);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаХарактеристики", ИмяСправочникаХарактеристики);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяДокументаЗаказ", ИмяДокументаЗаказ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТЧТовары", ИмяТЧТовары);
	
	Запрос.УстановитьПараметр("ЗаказСсылка", ЗаказСсылка); 

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			ЗарегистрироватьКОбменуДляВременнойСсылки(Получатель, Выборка.Ссылка, СрокДействияСсылки, Истина, Неопределено);
		ИначеЕсли ЗначениеЗаполнено(Выборка.Группа) Тогда	
			ЗарегистрироватьКОбменуДляВременнойСсылки(Получатель, Выборка.Группа, СрокДействияСсылки, Истина, Неопределено);
		КонецЕсли;
	КонецЦикла;

	ЗарегистрироватьКартинкиНоменклатуры(НастройкиВитрины, НомерОтправленного, СрокДействияСсылки);		
				
	ЗарегистрироватьКартинкиХарактеристик(НастройкиВитрины, НомерОтправленного, СрокДействияСсылки);
		
КонецПроцедуры

Процедура ДействияПриОкончанииРегистрации(ВыгружатьВсеТовары, НастройкиВитрины, ВыгружаемыеСвойстваТекущие, НомерОтправленного)
	
	Маг1СИнтеграцияСлужебный.СохранитьСлепокВыгружаемыхСвойств(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																ВыгружаемыеСвойстваТекущие);
	
	Если ВыгружатьВсеТовары Тогда
		Маг1СИнтеграцияСлужебный.УдалитьВсеСлепкиДанных(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Объект КАК Ссылка
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Свойство = &Свойство
		|	И ДополнительныеСведения.Значение > &ТекущаяУниверсальнаяДата";
		
		Запрос.УстановитьПараметр("Свойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоДляВременныхСсылок(НастройкиВитрины.ОсновныеНастройки.УзелОбмена)); 
		Запрос.УстановитьПараметр("ТекущаяУниверсальнаяДата", ТекущаяУниверсальнаяДата()); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ПолноеИмя     =  Выборка.Ссылка.Метаданные().ПолноеИмя();
			НаПланеОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена(ПолноеИмя);
			Маг1СИнтеграцияСлужебный.ЗарегистрироватьКОбмену(НастройкиВитрины.ОсновныеНастройки.УзелОбмена,
																Выборка.Ссылка,
																НаПланеОбмена, 
																НомерОтправленного); 
		КонецЦикла;
		
		ОтметитьЧтоЭтоПолнаяВыгрузка(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
										НомерОтправленного);
	КонецЕсли;
КонецПроцедуры

Процедура ЗарегистрироватьКартинкиНоменклатуры(НастройкиВитрины, НомерОтправленного, СрокДействияСсылки)
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если Не (Маг1СИнтеграция.ЕстьКартинкиТоваров(НастройкиУчетнойСистемы)
			И НастройкиВитрины.ОсновныеНастройки.ВыгружатьКартинки) Тогда
		Возврат;
	КонецЕсли;

	ИмяСправочникаНоменклатура          = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());
	ИмяСправочникаКартинокНоменклатуры  = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	Получатель                          = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	НаПланеОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена("Справочник." + ИмяСправочникаКартинокНоменклатуры);
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	НоменклатураПрисоединенныеФайлы.Расширение КАК Расширение
	|ИЗ
	|	Справочник.ИмяСправочникаКартинокНоменклатуры КАК НоменклатураПрисоединенныеФайлы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаНоменклатура.Изменения КАК НоменклатураИзменения
	|		ПО НоменклатураПрисоединенныеФайлы.ВладелецФайла = НоменклатураИзменения.Ссылка
	|ГДЕ
	|  НоменклатураИзменения.Узел = &Узел";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаНоменклатура", ИмяСправочникаНоменклатура);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаКартинокНоменклатуры", ИмяСправочникаКартинокНоменклатуры);
	Запрос.УстановитьПараметр("Узел", Получатель); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка)
			И Маг1СИнтеграция.ЭтоКартинка(Выборка.Расширение) Тогда
			Если СрокДействияСсылки = Неопределено Тогда
				Маг1СИнтеграцияСлужебный.ЗарегистрироватьКОбмену(Получатель, Выборка.Ссылка, НаПланеОбмена, НомерОтправленного);
			Иначе
				ЗарегистрироватьКОбменуДляВременнойСсылки(Получатель, Выборка.Ссылка, СрокДействияСсылки, НаПланеОбмена, НомерОтправленного);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СрокДействияСсылки <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НастройкиВитрины.ДополнительныеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ВидыНоменклатуры() Тогда
		ИмяСправочникаГрупп = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ВидНоменклатуры());
	Иначе
		ИмяСправочникаГрупп = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Объект,
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	Справочник.ИмяСправочникаГрупп.Изменения КАК ГруппыИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ПО ГруппыИзменения.Ссылка = ДополнительныеСведения.Объект
	|ГДЕ
	|	ГруппыИзменения.Узел = &Узел
	|	И ДополнительныеСведения.Свойство = &Свойство";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаГрупп", ИмяСправочникаГрупп);
	Запрос.УстановитьПараметр("Узел", Получатель); 
	Запрос.УстановитьПараметр("Свойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоФайлДляКартинкиКатегории());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ФайлСсылка = ФайлДляКартинкиКатегории(Выборка.Объект, Выборка.Значение);
		
		Если ФайлСсылка <> Неопределено Тогда
			Маг1СИнтеграцияСлужебный.ЗарегистрироватьКОбмену(Получатель, ФайлСсылка, Ложь, НомерОтправленного); 
		КонецЕсли;
	КонецЦикла;
	
КонецПроЦедуры

Процедура ЗарегистрироватьКартинкиХарактеристик(НастройкиВитрины, НомерОтправленного,  СрокДействияСсылки)
	
	Если Не НастройкиВитрины.ОсновныеНастройки.ВыгружатьКартинки Тогда
    	Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.ОграничениеТипа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСправочникаХарактеристики = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
	ИмяСправочникаХарактеристикиКартинки = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	Получатель                          = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;

	Если ПустаяСтрока(ИмяСправочникаХарактеристикиКартинки) Тогда
		Возврат;
	КонецЕсли;
	
	НаПланеОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена("Справочник." + ИмяСправочникаХарактеристикиКартинки);
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХарактеристикиПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	ХарактеристикиПрисоединенныеФайлы.Расширение КАК Расширение
	|ИЗ
	|	Справочник.ИмяСправочникаХарактеристикиКартинки КАК ХарактеристикиПрисоединенныеФайлы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаХарактеристики.Изменения КАК ХарактеристикиИзменения
	|		ПО ХарактеристикиПрисоединенныеФайлы.ВладелецФайла = ХарактеристикиИзменения.Ссылка
	|ГДЕ
	|  ХарактеристикиИзменения.Узел = &Узел";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаХарактеристикиКартинки", ИмяСправочникаХарактеристикиКартинки);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаХарактеристики", ИмяСправочникаХарактеристики);
	Запрос.УстановитьПараметр("Узел", Получатель); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка)
			И Маг1СИнтеграция.ЭтоКартинка(Выборка.Расширение) Тогда
			Если СрокДействияСсылки = Неопределено Тогда
				Маг1СИнтеграцияСлужебный.ЗарегистрироватьКОбмену(Получатель, Выборка.Ссылка, НаПланеОбмена, НомерОтправленного); 
			Иначе
				ЗарегистрироватьКОбменуДляВременнойСсылки(Получатель, Выборка.Ссылка, СрокДействияСсылки, НаПланеОбмена, НомерОтправленного);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписьюНоменклатуры(НоменклатураОбъект) Экспорт
	Если НоменклатураОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если НоменклатураОбъект.ОбменДанными.Загрузка 
		Или НоменклатураОбъект.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПроверки = Новый Структура;

	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	СписокНастроекВитрин = СписокНастроекВитрин();
	
	Если СписокНастроекВитрин.Количество() > 0 Тогда
		
		Для Каждого КлючЗначение из СписокНастроекВитрин Цикл
			НастройкиВитрины = КлючЗначение.Значение; 
			УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
			
			Если УзелОбмена <> Неопределено Тогда
				ПараметрыПроверкиТекущие = Новый Структура;
				ПараметрыПроверкиТекущие.Вставить("УслугаДоставки", НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.УслугаДоставки);
				ПараметрыПроверкиТекущие.Вставить("НастройкиФильтровНоменклатуры", НастройкиФильтровНоменклатуры(НастройкиВитрины));
				ПараметрыПроверкиТекущие.Вставить("НастройкиВитрины", НастройкиВитрины);
				ПараметрыПроверкиТекущие.Вставить("НастройкиУчетнойСистемы", НастройкиУчетнойСистемы);
				
				НоменклатураСоответствуетОтборам = Неопределено;
				Если Не НоменклатураОбъект.ЭтоНовый() Тогда
					НоменклатураСоответствуетОтборам = НоменклатураСоответствуетОтборам(НоменклатураОбъект.Ссылка,
																						НоменклатураОбъект.ЭтоГруппа,
																						ПараметрыПроверкиТекущие);  
				КонецЕсли;
				ПараметрыПроверки.Вставить(КлючЗначение.Ключ, 
					Новый Структура("ПараметрыПроверки,НоменклатураСоответствуетОтборам", ПараметрыПроверкиТекущие, НоменклатураСоответствуетОтборам))
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НоменклатураОбъект.ДополнительныеСвойства.Вставить("Маг1С_ПараметрыПроверки", ПараметрыПроверки);
	
КонецПроцедуры

Процедура ПриЗаписиНоменклатуры(НоменклатураОбъект) Экспорт
	
	Если НоменклатураОбъект.ОбменДанными.Загрузка
		Или НоменклатураОбъект.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	Если НоменклатураОбъект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПроверки = Неопределено;
	
	Если Не НоменклатураОбъект.ДополнительныеСвойства.Свойство("Маг1С_ПараметрыПроверки", ПараметрыПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПроверки = Неопределено
		Или ПараметрыПроверки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УзлыОбмена = Новый Структура;
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	ИмяСправочникаКартинокНоменклатуры = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	ЕстьСправочникКартинокВСоставеПланаОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена("Справочник." + ИмяСправочникаКартинокНоменклатуры);
	
	Для Каждого КлючЗначение из ПараметрыПроверки Цикл
		НоменклатураСоответствуетОтборамПередЗаписью = КлючЗначение.Значение.НоменклатураСоответствуетОтборам;
		ПараметрыПроверкиТекущие                     = КлючЗначение.Значение.ПараметрыПроверки;
		
		НоменклатураСоответствуетОтборам = НоменклатураСоответствуетОтборам(НоменклатураОбъект.Ссылка,
																			НоменклатураОбъект.ЭтоГруппа,
																			ПараметрыПроверкиТекущие);
																			
		Если Не НоменклатураСоответствуетОтборам
			или (НоменклатураСоответствуетОтборам
				и НоменклатураСоответствуетОтборамПередЗаписью = Истина) Тогда
			Продолжить;	
		КонецЕсли;
			  
		УзелОбмена = ПараметрыПроверкиТекущие.НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
		НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерОтправленного");
		УзлыОбмена.Вставить(КлючЗначение.Ключ, Новый Структура("УзелОбмена, НомерОтправленного",
																УзелОбмена,
																НомерОтправленного));
		
	КонецЦикла;
	
	Если УзлыОбмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	НоменклатураПрисоединенныеФайлы.Расширение КАК Расширение
	|ИЗ
	|	Справочник.ИмяСправочникаКартинокНоменклатуры КАК НоменклатураПрисоединенныеФайлы
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаКартинокНоменклатуры", ИмяСправочникаКартинокНоменклатуры);
	Запрос.УстановитьПараметр("ВладелецФайла", НоменклатураОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		Если ЭтоКартинка(РезультатЗапроса.Расширение) Тогда
			Маг1СИнтеграцияСлужебный.ЗарегистрироватьНаУзлахСКоторымиБылОбмен(НоменклатураОбъект.Ссылка,
			                                                                  РезультатЗапроса.Ссылка,
																			  ЕстьСправочникКартинокВСоставеПланаОбмена);
		КонецЕсли;
	КонецЦикла;
	
	ИмяСправочникаХарактеристик = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());

	Если ПустаяСтрока(ИмяСправочникаХарактеристик) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИмяСправочникаХарактеристик КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	&ТекстОтбораХарактеристик";
	
	ТекстОтбораХарактеристик = Новый Массив;
	
	Для Каждого КлючЗначение из НастройкиУчетнойСистемы.Номенклатура.РеквизитыВладельцаХарактеристик Цикл
		ТекстОтбораХарактеристик.Добавить("ХарактеристикиНоменклатуры.Владелец = &" + КлючЗначение.Ключ);
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, НоменклатураОбъект[КлючЗначение.Ключ]);
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаХарактеристик", ИмяСправочникаХарактеристик);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстОтбораХарактеристик", СтрСоединить(ТекстОтбораХарактеристик, " ИЛИ "));

	ХарактеристикиНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если ХарактеристикиНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ХарактеристикаСсылка из ХарактеристикиНоменклатуры Цикл
		Маг1СИнтеграцияСлужебный.ЗарегистрироватьНаУзлахСКоторымиБылОбмен(НоменклатураОбъект.Ссылка,
		                                                                  ХарактеристикаСсылка,
																			Истина);
	КонецЦикла;
	
	ИмяСправочникаХарактеристикиКартинки = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	
	Если ПустаяСтрока(ИмяСправочникаХарактеристикиКартинки) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьСправочникКартинокВСоставеПланаОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена("Справочник." + ИмяСправочникаХарактеристикиКартинки);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлы.ВладелецФайла КАК ВладелецФайла,
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлы.Расширение КАК Расширение
	|ИЗ
	|	Справочник.ИмяСправочникаХарактеристикиКартинки КАК ХарактеристикиНоменклатурыПрисоединенныеФайлы
	|ГДЕ
	|	ХарактеристикиНоменклатурыПрисоединенныеФайлы.ВладелецФайла В (&ХарактеристикиНоменклатуры)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаХарактеристикиКартинки", ИмяСправочникаХарактеристикиКартинки);
    Запрос.УстановитьПараметр("ХарактеристикиНоменклатуры", ХарактеристикиНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		Если ЭтоКартинка(РезультатЗапроса.Расширение) Тогда
			Маг1СИнтеграцияСлужебный.ЗарегистрироватьНаУзлахСКоторымиБылОбмен(РезультатЗапроса.ВладелецФайла,
			                                                                  РезультатЗапроса.Ссылка,
																			  ЕстьСправочникКартинокВСоставеПланаОбмена);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписьюХарактеристики(ХарактеристикаОбъект) Экспорт
	Если ХарактеристикаОбъект.ОбменДанными.Загрузка 
		Или ХарактеристикаОбъект.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	ХарактеристикаОбъект.ДополнительныеСвойства.Вставить("Маг1С_ЭтоНовый", ХарактеристикаОбъект.ЭтоНовый());
	
КонецПроцедуры

Процедура ПриЗаписиХарактеристики(ХарактеристикаОбъект) Экспорт
	
	Если ХарактеристикаОбъект.ОбменДанными.Загрузка 
		Или ХарактеристикаОбъект.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	УзлыОбмена = Маг1СИнтеграцияСлужебныйПовтИсп.УзлыОбменаСВитринами();
	
	Если УзлыОбмена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если ТипЗнч(ХарактеристикаОбъект.Владелец) = ТипЗнч(НастройкиУчетнойСистемы.Номенклатура.Значение) Тогда
		Маг1СИнтеграцияСлужебный.ЗарегистрироватьНаУзлахСКоторымиБылОбмен(ХарактеристикаОбъект.Владелец, 
																			ХарактеристикаОбъект.Ссылка,
																			Истина);
	Иначе
		Для Каждого УзелОбмена из УзлыОбмена Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ХарактеристикаОбъект.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ХарактеристикиНоменклатуры

Процедура ДополнитьПКО_Справочник_ХарактеристикиНоменклатуры_Отправка(ПравилоКонвертации) Экспорт
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "СвойстваТаблица");
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеБулево", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеЧисло", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеДата", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеСтрокаОгр", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеСтрокаНеогр", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеСсылка", 1, "СсылочныеЗначенияСвойств_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Свойство", 1, "Справочник_СвойстваТоваров_Отправка");
КонецПроцедуры

Процедура Справочник_ХарактеристикиНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки) Экспорт
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки <> ИдентификаторВариантаНастройкиОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
		
	ВыгрузитьТаблицуСвойствТоваров(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, Истина);
КонецПроцедуры

#КонецОбласти

#Область ЗаказПокупателя

Процедура УстановитьПрефиксНомеруЗаказа(ЗаказОбъект) Экспорт

	Если СтрДлина(СокрЛП(ЗаказОбъект.Номер)) < 11 Тогда
		лНомер = "МГ-" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ЗаказОбъект.Номер, 8, "0", "Слева");
		ЗаказОбъект.Номер = лНомер;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПриЗаписиЗаказаПокупателя(ЗаказОбъект) Экспорт
	
	Если ЗаказОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокНастроекВитрины = СписокНастроекВитрин();
	
	Если СписокНастроекВитрины.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	
	
	Для Каждого КлючЗначение из СписокНастроекВитрины Цикл
	
		НастройкиВитрины = КлючЗначение.Значение;

		Если НастройкиВитрины = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;

		Если УзелОбмена = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Не Маг1СИнтеграция.ЭтоКонтрагентВитрины(ЗаказОбъект.Контрагент,
														НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины) Тогда 
			Продолжить;
		КонецЕсли;
        
		Если Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена(ЗаказОбъект.Метаданные().ПолноеИмя()) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ЗаказОбъект.Ссылка);
		Иначе
			НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерОтправленного");
			ЗарегистрироватьНеобходимостьВыгрузкиДополнительныхДанных(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																		Маг1СПеречисления.ИменаСправочников_ЗаказПокупателя(),
																		ЗаказОбъект.Ссылка,
																		НомерОтправленного);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Возвращает соотвествие, если в ключе - состояние заказа в учетной системе, а в значении - строка статуса заказа формата обмена
// 
// Возвращаемое значение:
//  Соотвествие 
//
Функция СоответствиеСостоянияЗаказаСтатусуФорматаОбмена(КомпонентыОбмена) Экспорт
	
	НастройкиВитрины = Неопределено;
	
	Если Не КомпонентыОбмена.ПараметрыКонвертации.Свойство("НастройкиВитрины", НастройкиВитрины)
		Или НастройкиВитрины = Неопределено Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Если Не НастройкиВитрины.ДополнительныеНастройки.Свойство("СоответствияСтатусовЗаказов") Тогда
		СоответствияСтатусовЗаказов = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы().СтатусЗаказаПокупателя.Соответствие;
	Иначе
		СоответствияСтатусовЗаказов = НастройкиВитрины.ДополнительныеНастройки.СоответствияСтатусовЗаказов;
	КонецЕсли;
	
	Результат = Новый Соответствие;
	Для Каждого КлючЗначение из СоответствияСтатусовЗаказов Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого Знч из КлючЗначение.Значение Цикл
				Результат.Вставить(Знч, КлючЗначение.Ключ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат; 
	
КонецФункции

// Возвращает признак использования в конфигурации подсистемы 1С:Онлайн-заказы
// 
// Возвращаемое значение:
//  Булево 
//
Функция ДоступнаПодсистемаОнлайнЗаказов() Экспорт
	ДокументОнлайнЗаказаБИП = Метаданные.ОпределяемыеТипы.Найти("ДокументОнлайнЗаказаБИП");
	Если ДокументОнлайнЗаказаБИП <> Неопределено Тогда 
		ТипыДокументОнлайнЗаказаБИП = ДокументОнлайнЗаказаБИП.Тип.Типы();
		Если ТипыДокументОнлайнЗаказаБИП.Количество() = 1 И ТипыДокументОнлайнЗаказаБИП[0] = Тип("Строка") Тогда 
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область КартинкиТоваров

Функция ЭтоКартинка(Расширение) Экспорт	
	Возврат Маг1СИнтеграцияСлужебныйКлиентСервер.РасширенияИзображений().Найти(НРег(Расширение)) <> Неопределено;
КонецФункции

Функция ЕстьКартинкиТоваров(НастройкиУчетнойСистемы) Экспорт
	Возврат НастройкиУчетнойСистемы.НоменклатураКартинки.ОграничениеТипа <> Неопределено
		Или НастройкиУчетнойСистемы.ХарактеристикиКартинки.ОграничениеТипа <> Неопределено
КонецФункции

Функция ВладелецФайлаКартинкиКатегории(ФайлСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект
	|	И ДополнительныеСведения.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Объект", ФайлСсылка); 
	Запрос.УстановитьПараметр("Свойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоВладелецФайлаКартинкиКатегории());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	
	Если Выборка.Следующий() Тогда
		Результат = Маг1СИнтеграцияСлужебный.СтрокаJSONВСсылку(Выборка.Значение);
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить владельца файла %Файл'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Файл", Строка(ФайлСсылка));
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_РаботаСКартинкамиКатегории(),
								УровеньЖурналаРегистрации.Ошибка,
								ФайлСсылка.Метаданные(),
								ФайлСсылка,
								ТекстСообщения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФайлДляКартинкиКатегории(КатегорияСсылка, ЗначениеСвойства = Неопределено) Экспорт
	
	Результат = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеСвойства = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Объект = &Объект
		|	И ДополнительныеСведения.Свойство = &Свойство";
		Запрос.УстановитьПараметр("Объект", КатегорияСсылка); 
		Запрос.УстановитьПараметр("Свойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоФайлДляКартинкиКатегории());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ЗначениеСвойства = Выборка.Значение;
			
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЗначениеСвойства)
		И ТипЗнч(ЗначениеСвойства) = Тип("Строка")
		И Не ПустаяСтрока(ЗначениеСвойства)  Тогда

		Результат = Маг1СИнтеграцияСлужебный.СтрокаJSONВСсылку(ЗначениеСвойства);
		
		Если Результат = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить файл категории %Категория'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Категория", Строка(КатегорияСсылка));
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_РаботаСКартинкамиКатегории(),
									УровеньЖурналаРегистрации.Ошибка,
									КатегорияСсылка.Метаданные(),
									КатегорияСсылка,
									ТекстСообщения);
		ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат, "ПометкаУдаления") Тогда
			Результат = Неопределено;							
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтвязатьФайлОтКатегории(ФайлСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	НачатьТранзакцию();
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Объект = &Объект
		|	И ДополнительныеСведения.Свойство = &Свойство";
		
		Запрос.УстановитьПараметр("Объект", ФайлСсылка); 
		Запрос.УстановитьПараметр("Свойство", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоВладелецФайлаКартинкиКатегории()); 
		
		ЗначениеВладельца = Неопределено;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ЗначениеВладельца = Маг1СИнтеграцияСлужебный.СтрокаJSONВСсылку(Выборка.Значение);
			
		КонецЕсли;
		
		Если ЗначениеВладельца = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
		НаборВладелец = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		
		НаборВладелец.Отбор.Объект.Установить(ЗначениеВладельца);
		НаборВладелец.Отбор.Свойство.Установить(Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоФайлДляКартинкиКатегории());
		
		НаборВладелец.Записать();
				
		ЗафиксироватьТранзакцию();
		
		Результат = Истина;
	Исключение
		ОтменитьТранзакцию();
		
		ОписаниеОшибки = ИнформацияОбОшибке();
		
		ТекстСообщения = НСтр("ru = 'Не удалось записать отвязать файл от категории %ФайлСсылка: %ОписаниеОшибки'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ФайлСсылка", Строка(ФайлСсылка));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки", ПодробноеПредставлениеОшибки(ОписаниеОшибки));
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_РаботаСКартинкамиКатегории(),
								УровеньЖурналаРегистрации.Ошибка,
								ФайлСсылка.Метаданные(),
								ФайлСсылка,
								ТекстСообщения);
		ВызватьИсключение КраткоеПредставлениеОшибки(ОписаниеОшибки);	
	КонецПопытки;

	Возврат Результат;
КонецФункции

Функция ПривязатьФайлККатегории(КатегорияСсылка, НовыйФайлСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	НачатьТранзакцию();
	
	Попытка
		
		СтарыйФайл = ФайлДляКартинкиКатегории(КатегорияСсылка);
		
		СвойствоВладелец = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоВладелецФайлаКартинкиКатегории();
		СвойствоФайл     = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоФайлДляКартинкиКатегории();
		
		Если ЗначениеЗаполнено(СтарыйФайл) Тогда
			НаборСтарыйФайл = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
			НаборСтарыйФайл.Отбор.Объект.Установить(СтарыйФайл);
			НаборСтарыйФайл.Отбор.Свойство.Установить(СвойствоВладелец);
		    НаборСтарыйФайл.Записать();
		КонецЕсли;
		
		НаборКатегория = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
        НаборКатегория.Отбор.Объект.Установить(КатегорияСсылка);
        НаборКатегория.Отбор.Свойство.Установить(СвойствоФайл);
		
		Если ЗначениеЗаполнено(НовыйФайлСсылка) Тогда
			НаборНовыйФайл = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
			НаборНовыйФайл.Отбор.Объект.Установить(НовыйФайлСсылка);
			НаборНовыйФайл.Отбор.Свойство.Установить(СвойствоВладелец);
			
			НоваяСтрокаФайла = НаборНовыйФайл.Добавить();
			НоваяСтрокаФайла.Объект = НовыйФайлСсылка; 
			НоваяСтрокаФайла.Свойство = СвойствоВладелец;
			НоваяСтрокаФайла.Значение = Маг1СИнтеграцияСлужебный.СсылкаВСтрокуJSON(КатегорияСсылка);
			
			НаборНовыйФайл.Записать();
			
			НоваяСтрокаКатегории = НаборКатегория.Добавить();
			НоваяСтрокаКатегории.Объект = КатегорияСсылка;
			НоваяСтрокаКатегории.Свойство = СвойствоФайл;
			НоваяСтрокаКатегории.Значение = Маг1СИнтеграцияСлужебный.СсылкаВСтрокуJSON(НовыйФайлСсылка);
			
		КонецЕсли;
		
		НаборКатегория.Записать();
		
		ЗафиксироватьТранзакцию();
		
		Результат = Истина;
	Исключение
		ОтменитьТранзакцию();
		
		ОписаниеОшибки = ИнформацияОбОшибке();
		
		ТекстСообщения = НСтр("ru = 'Не удалось записать информации о файле категории товара %Категория: %ОписаниеОшибки'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Категория", Строка(КатегорияСсылка));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки", ПодробноеПредставлениеОшибки(ОписаниеОшибки));
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_РаботаСКартинкамиКатегории(),
								УровеньЖурналаРегистрации.Ошибка,
								КатегорияСсылка.Метаданные(),
								КатегорияСсылка,
								ТекстСообщения);
		ВызватьИсключение КраткоеПредставлениеОшибки(ОписаниеОшибки);	
	КонецПопытки;

	Возврат Результат;
КонецФункции

Функция ИдентификаторыОбъектовМетаданныхСправочниковКартинок() Экспорт
	ОбъектыМетаданных = Новый Массив;
	
	ИмяСправочникаКартинок = Маг1СПеречисления.ИменаСправочников_Файлы();
	
	Если Не ПустаяСтрока(ИмяСправочникаКартинок) Тогда
		ОбъектыМетаданных.Добавить(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
				Метаданные.Справочники[ИмяСправочникаКартинок]));	
	КонецЕсли;
					
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ИмяСправочникаКартинок = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	
	Если Не ПустаяСтрока(ИмяСправочникаКартинок) Тогда
		ОбъектыМетаданных.Добавить(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
				Метаданные.Справочники[ИмяСправочникаКартинок]));	
	КонецЕсли;
	
	ИмяСправочникаКартинок = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	
	Если Не ПустаяСтрока(ИмяСправочникаКартинок) Тогда
		ОбъектыМетаданных.Добавить(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
				Метаданные.Справочники[ИмяСправочникаКартинок]));	
	КонецЕсли;
			
	Возврат ОбъектыМетаданных;		
КонецФункции

#КонецОбласти

#Область КонтактанаяИнформация

Функция ВидКИMag1c(ИмяТипаКИ, ИмяНастройки, Создавать) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ИмяВидаКИ = НастройкиУчетнойСистемы[ИмяНастройки].ИмяВидаКИ;
	
	Если ПустаяСтрока(ИмяВидаКИ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РодительВидаКИ = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации." + ИмяВидаКИ);
 
	Если Не Создавать Тогда
		Возврат РодительВидаКИ;
	КонецЕсли;
	
	Если ИмяТипаКИ = Маг1СПеречисления.ТипыКИ_Телефон() Тогда
		ИдентификаторДляФормул = "ТелефонMag1c";
		Наименование = "Телефон (mag1c)";
	ИначеЕсли ИмяТипаКИ = Маг1СПеречисления.ТипыКИ_АдресЭлектроннойПочты() Тогда
		ИдентификаторДляФормул = "EmailMag1c";
		Наименование = "Email (mag1c)";
	Иначе
		ТекстИсключения = НСтр("ru = 'Неизвестный тип КИ mag1c %ИмяТипаКИ'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИмяТипаКИ", ИмяТипаКИ);
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	ИмяТипыКонтактнойИнформации = "ТипыКонтактнойИнформации";
	
	ТипКИ = Перечисления[ИмяТипыКонтактнойИнформации][ИмяТипаКИ];	
	
	Если Не ЗначениеЗаполнено(ТипКИ) Тогда
		ТекстИсключения = НСтр("ru = 'Тип КИ mag1c %ИмяТипаКИ не найден в перечислении'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИмяТипаКИ", ИмяТипаКИ);
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыКонтактнойИнформации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	ВидыКонтактнойИнформации.ИдентификаторДляФормул = &ИдентификаторДляФормул
	|	И ВидыКонтактнойИнформации.Тип = &ТипКИ";
	Запрос.УстановитьПараметр("ИдентификаторДляФормул", ИдентификаторДляФормул);
	Запрос.УстановитьПараметр("ТипКИ", ТипКИ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	ИмяВидыКонтактнойИнформации = "ВидыКонтактнойИнформации";
	
	ВидКИОбъект = Справочники[ИмяВидыКонтактнойИнформации].СоздатьЭлемент();
	ВидКИОбъект.Тип      = ТипКИ; 
	ВидКИОбъект.Родитель = РодительВидаКИ;
	ВидКИОбъект.Наименование = Наименование;
    ВидКИОбъект.ИдентификаторДляФормул = ИдентификаторДляФормул;
	ВидКИОбъект.Используется = Истина;
	ВидКИОбъект.Записать();
	
	Возврат ВидКИОбъект.Ссылка;
КонецФункции

Процедура ЗаполнитьКИMag1c(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена) Экспорт
	Если ДанныеXDTO.Свойство("КонтактнаяИнформация")
		И ЗначениеЗаполнено(ДанныеXDTO.КонтактнаяИнформация) Тогда
			
		Для Каждого СтрокаXDTO Из ДанныеXDTO.КонтактнаяИнформация Цикл
			ТекВидКИ = Неопределено;
			
			ВидКИСтрокой = СтрокаXDTO.ВидКонтактнойИнформации.Значение;
			Если Лев(СокрЛП(ВидКИСтрокой),18) = "ПользовательскаяКИ"
				И СтрНайти(СтрокаXDTO.НаименованиеКонтактнойИнформации, "mag1c") > 0 Тогда
				
				ИмяТипаКИ = СтрЗаменить(СокрЛП(ВидКИСтрокой),"ПользовательскаяКИ","");
				
				Если ИмяТипаКИ = Маг1СПеречисления.ТипыКИ_Телефон() Тогда
					ТекВидКИ = Маг1СИнтеграцияСлужебныйПовтИсп.ВидКИТелефонMag1c();
				ИначеЕсли ИмяТипаКИ = Маг1СПеречисления.ТипыКИ_АдресЭлектроннойПочты() Тогда
					ТекВидКИ = Маг1СИнтеграцияСлужебныйПовтИсп.ВидКИEmailMag1c();
				Иначе
					Продолжить;
				КонецЕсли;
				
			Иначе
				Продолжить;
			КонецЕсли;
			
			ДобавитьКонтактнуюИнформацию(ПолученныеДанные, СокрЛП(СтрокаXDTO.ЗначенияПолей), ТекВидКИ)
			
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьКонтактнуюИнформацию(СсылкаОбъект, КИ, ВидКИ) Экспорт
