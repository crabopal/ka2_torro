Процедура СформироватьВТСоставСегментаНоменклатуры(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиВитрины) 
	Если ЕстьВТВМенеджере("ВТСоставСегментаНоменклатурыБезДублей", МенеджерВременныхТаблиц) Тогда
		Возврат;
	КонецЕсли;
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Запрос = ЗапросПоОписаниюВТ(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиУчетнойСистемы.ОписаниеВТСоставСегментаНоменклатуры);
	Запрос.Текст = Запрос.Текст + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСоставСегментаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВТСоставСегментаНоменклатуры.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТСоставСегментаНоменклатурыБезДублей
	|ИЗ
	|	ВТСоставСегментаНоменклатуры КАК ВТСоставСегментаНоменклатуры
	|ГДЕ
	|	ВТСоставСегментаНоменклатуры.Характеристика = &ПустаяХарактеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставСегментаНоменклатурыСХарактеристиками.Номенклатура,
	|	СоставСегментаНоменклатурыСХарактеристиками.Характеристика
	|ИЗ
	|	ВТСоставСегментаНоменклатуры КАК СоставСегментаНоменклатурыСХарактеристиками
	|ГДЕ
	|	НЕ СоставСегментаНоменклатурыСХарактеристиками.Номенклатура В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ВТСоставСегментаНоменклатуры.Номенклатура
	|				ИЗ
	|					ВТСоставСегментаНоменклатуры КАК ВТСоставСегментаНоменклатуры
	|				ГДЕ
	|					ВТСоставСегментаНоменклатуры.Номенклатура = СоставСегментаНоменклатурыСХарактеристиками.Номенклатура
	|					И ВТСоставСегментаНоменклатуры.Характеристика = &ПустаяХарактеристика)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСоставСегментаНоменклатуры";	
	
	Запрос.УстановитьПараметр("СегментНоменклатуры", НастройкиВитрины.ДополнительныеНастройки.СегментНоменклатуры);
	Запрос.УстановитьПараметр("ПустаяХарактеристика", НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.Значение);
		
	Запрос.Выполнить();
КонецПроцедуры

Процедура СформироватьВТПубликуемаяНоменклатура(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, УсловиеВыборки = "") Экспорт
	Если ЕстьВТВМенеджере("ВТПубликуемаяНоменклатура", МенеджерВременныхТаблиц) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	СпрНоменклатура.Группа КАК Группа,
	|	СпрНоменклатура.Наименование КАК Наименование,
	|	СпрНоменклатура.Описание КАК Описание,
	|	СпрНоменклатура.Код КАК Код,	
	|	СпрНоменклатура.Артикул КАК Артикул,	
	|	СпрНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	&НаборСвойств КАК НаборСвойств	
	|ПОМЕСТИТЬ ВТПубликуемаяНоменклатура
	|ИЗ
	|	Справочник.ИмяСправочникаНоменклатура КАК СпрНоменклатура
	|ГДЕ
	|	(&ФильтрНоменклатуры
	|     ИЛИ СпрНоменклатура.Ссылка = &УслугаДоставки)
	|	И НЕ СпрНоменклатура.ЭтоГруппа
	|	И (&УсловиеВыборки)
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура";
	
	Если Не ПустаяСтрока(УсловиеВыборки) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&УсловиеВыборки",
			УсловиеВыборки);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&УсловиеВыборки",
			"ИСТИНА");
	КонецЕсли;		
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"ИмяСправочникаНоменклатура",
		ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"СпрНоменклатура.Описание",
		"СпрНоменклатура." + НастройкиУчетнойСистемы.Номенклатура.Реквизиты.Описание);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"СпрНоменклатура.Наименование",
		"СпрНоменклатура." + НастройкиУчетнойСистемы.Номенклатура.Реквизиты.НаименованиеПолное);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"СпрНоменклатура.Группа",
		"СпрНоменклатура." + НастройкиФильтровНоменклатуры.РеквизитОтбораПоИерархии);
	
	Если Не ПустаяСтрока(НастройкиФильтровНоменклатуры.НаборСвойств) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&НаборСвойств",
			"СпрНоменклатура." + НастройкиФильтровНоменклатуры.НаборСвойств);
	Иначе
		Запрос.УстановитьПараметр("НаборСвойств", НастройкиУчетнойСистемы.Номенклатура.НаборДопРеквизитов);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Маг1СИнтеграция.ВставитьОтборПоНоменклатуреВТекстЗапроса(Запрос,
		"СпрНоменклатура.Ссылка",
		НастройкиФильтровНоменклатуры);
		
	Запрос.УстановитьПараметр("УслугаДоставки", НастройкиФильтровНоменклатуры.УслугаДоставки); 
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СформироватьПустуюВТ(ИмяВТ, МенеджерВременныхТаблиц)
	Если ЕстьВТВМенеджере(ИмяВТ, МенеджерВременныхТаблиц) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК Номенклатура,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	0 КАК КоличествоНаСкладе,
	|	0 КАК Цена,
	|	ДАТАВРЕМЯ(1,1,1) КАК Период
	|ПОМЕСТИТЬ ИмяВТ
	|ГДЕ
	|	ЛОЖЬ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяВТ", ИмяВТ);
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();
КонецПроцедуры

Функция ЕстьВТВМенеджере(ИмяВТ, МенеджерВременныхТаблиц)
	Возврат МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВТ) <> Неопределено;
КонецФункции

Процедура УдалитьВТВМенеджере(ИмяВТ, МенеджерВременныхТаблиц)
	
	Если Не ЕстьВТВМенеджере(ИмяВТ, МенеджерВременныхТаблиц) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"УНИЧТОЖИТЬ " + ИмяВТ;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ДанныеПоРеквизиту(ИмяРеквизита, ОтключитьЛогирование)
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Результат = СтруктураОписаниеСвойства();
	Результат.ЭтоРеквизит            = Истина;
		
	ЧастиИмени = СтрРазделить(ИмяРеквизита, ".");
	
	Если ЧастиИмени.Количество() <> 2 Тогда
		Если Не ОтключитьЛогирование Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка описания имени реквизита %ИмяРеквизита - должно быть ИмяСправочника.ИмяРеквизита'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяРеквизита", ИмяРеквизита);
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,                                                     
									ТекстСообщения);
		КонецЕсли; 
		Возврат Результат;
	КонецЕсли;
	 
	МетаданныеСправочника = Метаданные.Справочники.Найти(ЧастиИмени[0]);
	
	Если МетаданныеСправочника = Неопределено Тогда
		Если Не ОтключитьЛогирование Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка описания имени реквизита %ИмяРеквизита - справочник %ИмяСправочника не найден'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяРеквизита", ИмяРеквизита);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяСправочника", ЧастиИмени[0]);
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,                                                     
									ТекстСообщения);
	     КонецЕсли;
		 Возврат Результат;
	КонецЕсли;
	
	МетаданныеРеквизита = МетаданныеСправочника.Реквизиты.Найти(ЧастиИмени[1]);
	
	Если МетаданныеРеквизита = Неопределено Тогда
		Для Каждого ОписаниеСтандартного из МетаданныеСправочника.СтандартныеРеквизиты Цикл
			Если ОписаниеСтандартного.Имя = ЧастиИмени[1] Тогда
				МетаданныеРеквизита = ОписаниеСтандартного;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если МетаданныеРеквизита = Неопределено Тогда
		Если Не ОтключитьЛогирование Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка описания имени реквизита %ИмяРеквизита - реквизит %ИмяРеквизита не найден'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяРеквизита", ИмяРеквизита);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяРеквизита", ЧастиИмени[1]);
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,                                                     
									ТекстСообщения);
		КонецЕсли;						
		Возврат Результат;
	КонецЕсли;
	
	Результат.Наименование           = МетаданныеРеквизита.Синоним;
	Результат.Тип                    = ОписаниеТипаВСтроку(МетаданныеРеквизита.Тип);
	Результат.Метаданные             = ОписаниеТипаВМетаданные(МетаданныеРеквизита.Тип, ОтключитьЛогирование);
	Результат.ИдентификаторДляФормул = ИмяРеквизита;
	Результат.ИспользуетсяДляХарактеристик = (ЧастиИмени[0] = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры()));
	Результат.ИспользуетсяДляНоменклатуры  = (ЧастиИмени[0] = ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()));
	
	Если Не ПустаяСтрока(МетаданныеСправочника.ПредставлениеСписка) Тогда
		Результат.ПредставлениеНаборов = МетаданныеСправочника.ПредставлениеСписка; 
	ИначеЕсли Не ПустаяСтрока(МетаданныеСправочника.ПредставлениеОбъекта) Тогда
		Результат.ПредставлениеНаборов = МетаданныеСправочника.ПредставлениеОбъекта; 
	Иначе
		Результат.ПредставлениеНаборов = МетаданныеСправочника.Синоним;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ДанныеПоДопРеквизиту(ДопРеквизит, ОтключитьЛогирование)
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Результат = СтруктураОписаниеСвойства();
	Результат.ЭтоРеквизит                  = Ложь;
	
	Попытка
		ДопРеквизитОбъект = ДопРеквизит.ПолучитьОбъект();
			
		Результат.Наименование                 = ДопРеквизитОбъект.Заголовок;
		Результат.Тип 		                   = ОписаниеТипаВСтроку(ДопРеквизитОбъект.ТипЗначения);
		Результат.Метаданные                   = ОписаниеТипаВМетаданные(ДопРеквизитОбъект.ТипЗначения, ОтключитьЛогирование);
		Результат.ИдентификаторДляФормул       = ДопРеквизитОбъект.ИдентификаторДляФормул;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НаборыДополнительныхРеквизитов.Ссылка КАК Набор,
		|	НаборыДополнительныхРеквизитов.Ссылка.Наименование КАК НаименованиеНабора,
		|	НаборыДополнительныхРеквизитов.Ссылка В ИЕРАРХИИ (&НаборХарактеристик) КАК ИспользуетсяДляХарактеристик,
		|	НаборыДополнительныхРеквизитов.Ссылка В ИЕРАРХИИ (&НаборНоменклатуры) КАК ИспользуетсяДляНоменклатуры
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитов
		|ГДЕ
		|	НаборыДополнительныхРеквизитов.Свойство = &СвойствоТовара
		|	И (НаборыДополнительныхРеквизитов.Ссылка В ИЕРАРХИИ (&НаборНоменклатуры)
		|		ИЛИ НаборыДополнительныхРеквизитов.Ссылка В ИЕРАРХИИ (&НаборХарактеристик))
		|	И НЕ НаборыДополнительныхРеквизитов.Ссылка.ЭтоГруппа 
		|
		|УПОРЯДОЧИТЬ ПО
		|	НаименованиеНабора";
		
		Запрос.УстановитьПараметр("НаборНоменклатуры", 
									Маг1СИнтеграция.ГруппаНаборовДопРеквизитов(НастройкиУчетнойСистемы.Номенклатура.НаборДопРеквизитов));
		Запрос.УстановитьПараметр("НаборХарактеристик", 
									Маг1СИнтеграция.ГруппаНаборовДопРеквизитов(НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.НаборДопРеквизитов));
		
		Запрос.УстановитьПараметр("СвойствоТовара", ДопРеквизит);
		
		МассивНаименований = Новый Массив;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.ИспользуетсяДляХарактеристик Тогда
				Результат.ИспользуетсяДляХарактеристик = Истина
			КонецЕсли;
			Если Выборка.ИспользуетсяДляНоменклатуры Тогда
				Результат.ИспользуетсяДляНоменклатуры = Истина
			КонецЕсли;
			
			МассивНаименований.Добавить(Выборка.НаименованиеНабора);
			Результат.Наборы.Добавить(Выборка.Набор);
		КонецЦикла;

		Результат.ПредставлениеНаборов = СтрСоединить(МассивНаименований, ",");
		
	Исключение	
		Если Не ОтключитьЛогирование Тогда
			ТекстСообщения = НСтр("ru = 'Невозможно получить описание свойства %ДопРеквизит': %ОписаниеОшибки");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДопРеквизит", ДопРеквизит);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки",
															ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,                                                     
									ТекстСообщения);
		КонецЕсли;							
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Функция ОписаниеТипаВМетаданные(ОписаниеТипа, ОтключитьЛогирование)
	Типы = ОписаниеТипа.Типы();		
	
	Если Типы.Количество() <> 1 Тогда
		Если Не ОтключитьЛогирование Тогда
			ТекстСообщения = НСтр("ru = 'Поддерживаются только несоставные типы для свойств %ОписаниеТипа'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеТипа", ОписаниеТипа);
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,                                                     
									ТекстСообщения);
		КонецЕсли;						
		Возврат Неопределено;
	КонецЕсли;
	
	ТипРеквизита = Типы[0];
	
	Если ТипРеквизита = Тип("Дата")
		Или ТипРеквизита = Тип("Число")
		Или ТипРеквизита = Тип("Булево")
		Или ТипРеквизита = Тип("Строка") Тогда
		Возврат "";
	Иначе
		МетаданныеРеквизита = Метаданные.НайтиПоТипу(ТипРеквизита);
		Если МетаданныеРеквизита = Неопределено Тогда
			Если Не ОтключитьЛогирование Тогда
				ТекстСообщения = НСтр("ru = 'Метаданные для типа %ТипРеквизита не найдены'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТипРеквизита", ТипРеквизита);
				
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
										УровеньЖурналаРегистрации.Ошибка,
										,
										,                                                     
										ТекстСообщения);
			КонецЕсли;
			Возврат Неопределено;
		ИначеЕсли Не ОбщегоНазначения.ЭтоСправочник(МетаданныеРеквизита) Тогда
			Если Не ОтключитьЛогирование Тогда
				ТекстСообщения = НСтр("ru = 'Поддерживаются только ссылки на элементы справочников, а %ТипРеквизита не справочник'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТипРеквизита", ТипРеквизита);
				
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
										УровеньЖурналаРегистрации.Ошибка,
										,
										,                                                     
										ТекстСообщения);
			КонецЕсли;
			Возврат Неопределено;
		ИначеЕсли СтрНайти(МетаданныеРеквизита.Имя, "Файлы") > 0 Тогда
			Если Не ОтключитьЛогирование Тогда
				ТекстСообщения = НСтр("ru = 'Перадача файлов как свойств товаров не поддерживается (%ТипРеквизита)'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТипРеквизита", ТипРеквизита);
				
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
										УровеньЖурналаРегистрации.Ошибка,
										,
										,                                                     
										ТекстСообщения);
			КонецЕсли;
			Возврат Неопределено;
		ИначеЕсли МетаданныеРеквизита.ОсновноеПредставление <> Метаданные.СвойстваОбъектов.ОсновноеПредставлениеСправочника.ВВидеНаименования Тогда
			Если Не ОтключитьЛогирование Тогда
				ТекстСообщения = НСтр("ru = 'Поддерживаются только ссылки на элементы справочников, у которых основное представление - наименование, а у %ТипРеквизита это не так'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ТипРеквизита", ТипРеквизита);
				
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
										УровеньЖурналаРегистрации.Ошибка,
										,
										,                                                     
										ТекстСообщения);
			КонецЕсли;
			Возврат Неопределено;
		Иначе
			Возврат МетаданныеРеквизита;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ОписаниеСвойства(СвойствоТовара, ОтключитьЛогирование = Ложь) Экспорт
	ОписаниеСвойства = СтруктураОписаниеСвойства();
	
	Если ТипЗнч(СвойствоТовара) = Тип("Строка") Тогда
		ОписаниеСвойства = ДанныеПоРеквизиту(СвойствоТовара, ОтключитьЛогирование);
	ИначеЕсли ТипЗнч(СвойствоТовара) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
		ОписаниеСвойства = ДанныеПоДопРеквизиту(СвойствоТовара, ОтключитьЛогирование);
	Иначе
		Если Не ОтключитьЛогирование Тогда
			ТекстСообщения = НСтр("ru = 'Тип описания свойства %Тип не поддерживается'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Тип", ТипЗнч(СвойствоТовара));
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаСвойстваТовара(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,                                                     
									ТекстСообщения);
		КонецЕсли;							
		Возврат ОписаниеСвойства;
	КонецЕсли;
	
	ДоступноИспользованиеДляФильтра = Истина;
	Если ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_СтрокаОгр()
			Или  ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_СтрокаНеогр() Тогда
			ДоступноИспользованиеДляФильтра = Ложь;
	КонецЕсли;
	
	ОписаниеСвойства.ДоступноИспользованиеДляФильтра = Не (ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_СтрокаОгр()
															Или  ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_СтрокаНеогр());
	
	Возврат ОписаниеСвойства;
КонецФункции

Функция СтруктураОписаниеСвойства()
	Результат = Новый Структура;
	
	Результат.Вставить("ЭтоРеквизит", Ложь);
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Тип", "");
	Результат.Вставить("ИдентификаторДляФормул", "");
	Результат.Вставить("Метаданные", Неопределено);
	Результат.Вставить("ИспользуетсяДляХарактеристик", Ложь);
	Результат.Вставить("ИспользуетсяДляНоменклатуры", Ложь);
	Результат.Вставить("ДоступноИспользованиеДляФильтра", Ложь);
	Результат.Вставить("ПредставлениеНаборов", "");
	Результат.Вставить("Наборы", Новый Массив);
	
	Возврат Результат;
КонецФункции

Функция ОписаниеТипаВСтроку(ОписаниеТипов)
	
	Если ОписаниеТипов.СодержитТип(Тип("Булево")) Тогда
		Возврат Маг1СПеречисления.ТипыСвойств_Булево();
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
		Возврат Маг1СПеречисления.ТипыСвойств_Число();
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
		Возврат Маг1СПеречисления.ТипыСвойств_Дата();
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		Если ОписаниеТипов.КвалификаторыСтроки.Длина = 0 Тогда
			Возврат Маг1СПеречисления.ТипыСвойств_СтрокаНеогр();
		Иначе
			Возврат Маг1СПеречисления.ТипыСвойств_СтрокаОгр();
		КонецЕсли;
	Иначе
		Возврат Маг1СПеречисления.ТипыСвойств_Ссылка();
	КонецЕсли;
	
КонецФункции

Функция ОписаниеСвойстваИзКеша(КешОписаний, СвойствоТовара)
	ОписаниеСвойства = КешОписаний.Получить(СвойствоТовара);
	
	Если ОписаниеСвойства = Неопределено Тогда
		ОписаниеСвойства = ОписаниеСвойства(СвойствоТовара);
		КешОписаний.Вставить(СвойствоТовара, ОписаниеСвойства);
	КонецЕсли;
	
	Возврат ОписаниеСвойства;
КонецФункции

Функция ЗапросПоОписаниюВТ(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, ОписаниеВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ОписаниеВТ.ТекстЗапроса;
	ВставитьОтборПоВТПубликуемаяНоменклатура(Запрос,
		ОписаниеВТ.ИмяПоляОтбораНоменклатура,
		НастройкиФильтровНоменклатуры);
		
	Для Каждого КлючЗначение из ОписаниеВТ.ПараметрыЗапроса Цикл
		
		Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
			
	КонецЦикла;
	
	Возврат Запрос;
КонецФункции

#КонецОбласти