Функция Маг1С_ВыполнитьОбменДанными(УзелИнформационнойБазы, ЭтоИнтерактивныйЗапуск = Ложь) Экспорт
	
	ПроверитьВозможностьВыполненияОбменов();
	
	ПроверитьИспользованиеОбменаДанными();
	
	ДействияПриОбменеИмя = "ДействияПриОбмене";
	
	ДействиеЗагрузка = Перечисления[ДействияПриОбменеИмя].ЗагрузкаДанных;
	ДействиеВыгрузка = Перечисления[ДействияПриОбменеИмя].ВыгрузкаДанных;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если Не Маг1СИнтеграция.ЭтоУзелОбменаСВитриной(УзелИнформационнойБазы) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Маг1СИнтеграцияСлужебный.ПрочитатьНеобходимостьОбновленияНастроекВитрин() Тогда
		Маг1СИнтеграцияСлужебный.ОбновитьНастройкиВитринВФоне();
		ТекстСообщения = НСтр("ru = 'Перед запуском обмена необходимо дождаться обновления настроек витрин.%'");			
	    ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Попытка
		ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(УзелИнформационнойБазы);
	Исключение
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,
									ПодробноеПредставлениеОшибки(Информация));
							
		Обработки.Маг1СОбмен.ОтключитьАвтоматическийОбмен(УзелИнформационнойБазы, Истина);
		ВызватьИсключение;
	КонецПопытки;
	
	Если ПараметрыАвторизации.РасширениеОбновлено Тогда
		Если ЭтоИнтерактивныйЗапуск Тогда
			Возврат Истина
		Иначе
			ВызватьИсключение НСтр("ru = 'Обновилось расширение mag1c. Сеанс обмена с витриной завершен, т.к. будет перезапущен с новой версией расширения.'");	
		КонецЕсли;	
	КонецЕсли;
	
	// Установка параметров сеанса.
	ПараметрыСеансаСинхронизацииДанных = Новый Соответствие;
	Попытка
		ПараметрыСеансаСинхронизацииДанныхИмя = "ПараметрыСеансаСинхронизацииДанных";
		ТекущийПараметрСеанса = ПараметрыСеанса[ПараметрыСеансаСинхронизацииДанныхИмя].Получить();
	Исключение
		ТекущийПараметрСеанса = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(ТекущийПараметрСеанса) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из ТекущийПараметрСеанса Цикл
			ПараметрыСеансаСинхронизацииДанных.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыСеансаСинхронизацииДанных.Вставить("Маг1С_УзелОбменаСеансаОбмена", УзелИнформационнойБазы);
	
	ПараметрыСеанса[ПараметрыСеансаСинхронизацииДанныхИмя] = Новый ХранилищеЗначения(ПараметрыСеансаСинхронизацииДанных);
	
	Обработки.Маг1СОбмен.ВыполнитьДействиеСценарияОбмена(УзелИнформационнойБазы, ДействиеЗагрузка, ПараметрыАвторизации);	
	Обработки.Маг1СОбмен.ВыполнитьДействиеСценарияОбмена(УзелИнформационнойБазы, ДействиеВыгрузка, ПараметрыАвторизации);
	
	Маг1СИнтеграция.ОчиститьНеактуальныеОтметкиНужностиДляВременнойСсылки();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ПараметрыАвторизации.РасширениеОбновлено;
КонецФункции

&Вместо("ВыполнитьОбменДаннымиПоРегламентномуЗаданию")
Процедура Маг1С_ВыполнитьОбменДаннымиПоРегламентномуЗаданию(КодСценарияОбмена)
	
	ИмяЗадания = "СинхронизацияДанных";
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания[ИмяЗадания]);
	
	ПроверитьВозможностьВыполненияОбменов();
	
	ПроверитьИспользованиеОбменаДанными();
	
	Если Не ЗначениеЗаполнено(КодСценарияОбмена) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан сценарий обмена данными.'");
	КонецЕсли;
	
	ОбработатьСтандартно = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкиВыполненияОбменаНастройкиОбмена.УзелИнформационнойБазы КАК УзелИнформационнойБазы
	|ИЗ
	|	Справочник.СценарииОбменовДанными.НастройкиОбмена КАК НастройкиВыполненияОбменаНастройкиОбмена
	|ГДЕ
	|	НастройкиВыполненияОбменаНастройкиОбмена.Ссылка.Код = &Код
	|	И НЕ НастройкиВыполненияОбменаНастройкиОбмена.Ссылка.ПометкаУдаления 
	|";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", КодСценарияОбмена);
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		УзелИнформационнойБазы = Выборка.УзелИнформационнойБазы;
		
		Если Маг1СИнтеграция.ЭтоУзелОбменаСВитриной(УзелИнформационнойБазы) Тогда
			Маг1С_ВыполнитьОбменДанными(УзелИнформационнойБазы);
			ОбработатьСтандартно = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ОбработатьСтандартно Тогда
		ПродолжитьВызов(КодСценарияОбмена);
	КонецЕсли;
КонецПроцедуры
