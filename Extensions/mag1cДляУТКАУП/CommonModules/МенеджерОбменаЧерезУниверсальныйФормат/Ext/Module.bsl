#Область Общее
 
&После("ПередКонвертациейУТКАУП")
Процедура Маг1С_ПередКонвертациейУТКАУП(КомпонентыОбмена)
	
	Маг1СИнтеграция.ПередКонвертацией(КомпонентыОбмена);
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если КомпонентыОбмена.НаправлениеОбмена <> "Отправка" Тогда
		Возврат;
	КонецЕсли;
			
	Запрос = Новый Запрос();
	Запрос.Текст =
    "ВЫБРАТЬ
	|	СостоянияЗаказовКлиентовИзменения.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовКлиентов.Изменения КАК СостоянияЗаказовКлиентовИзменения
	|ГДЕ
	|	СостоянияЗаказовКлиентовИзменения.Узел = &Узел
	|	И НЕ СостоянияЗаказовКлиентовИзменения.Заказ ССЫЛКА Документ.ЗаказКлиента
	|		ИЛИ НЕ СостоянияЗаказовКлиентовИзменения.Заказ.Проведен";
	
	Запрос.УстановитьПараметр("Узел", КомпонентыОбмена.УзелКорреспондента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СостоянияЗаказовКлиентовИмя = "СостоянияЗаказовКлиентов";
		
		Набор = РегистрыСведений[СостоянияЗаказовКлиентовИмя].СоздатьНаборЗаписей();
		Набор.Отбор.Заказ.Установить(Выборка.Заказ);
		
		ПланыОбмена.УдалитьРегистрациюИзменений(КомпонентыОбмена.УзелКорреспондента, Набор);
		
	КонецЦикла;
	
КонецПроцедуры

&После("ПослеКонвертацииУТКАУП")
Процедура Маг1С_ПослеКонвертацииУТКАУП(КомпонентыОбмена)
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Маг1СИнтеграция.ПослеКонвертации(КомпонентыОбмена);
		
КонецПроцедуры

&После("ВыполнитьПроцедуруМодуляМенеджера")
Процедура Маг1С_ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры) Экспорт
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяПроцедуры = "Маг1С_ПОД_Справочник_Контрагенты_ПриОбработке" Тогда 
		Маг1С_ПОД_Справочник_Контрагенты_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "Маг1С_ПКО_Справочник_СостояниеЗаказа_Отправка_ПриОтправкеДанных" Тогда 
		Маг1С_ПКО_Справочник_СостояниеЗаказа_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "Маг1С_ПКО_Справочник_Упаковки_ПриОтправкеДанных" Тогда 
		Маг1С_ПКО_Справочник_Упаковки_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "Маг1С_ПОД_Справочник_ВидыНоменклатуры_Отправка_ПриОбработке" Тогда 
		Маг1С_ПОД_Справочник_ВидыНоменклатуры_Отправка_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
	КонецЕсли;

	Маг1СИнтеграция.ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры);
КонецПроцедуры

&После("ЗаполнитьПравилаОбработкиДанных")
Процедура Маг1С_ЗаполнитьПравилаОбработкиДанных(НаправлениеОбмена, ПравилаОбработкиДанных) Экспорт
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	Если НаправлениеОбмена = "Отправка" Тогда
		
		Маг1С_ДобавитьПОД_Справочник_ВидыНоменклатуры_Отправка(ПравилаОбработкиДанных);
		
	КонецЕсли;
		
	Маг1СИнтеграция.ЗаполнитьПравилаОбработкиДанных(НаправлениеОбмена, ПравилаОбработкиДанных);
	
КонецПроцедуры

&После("ЗаполнитьПравилаКонвертацииОбъектов")
Процедура Маг1С_ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации) Экспорт
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	Если НаправлениеОбмена = "Отправка" Тогда
		Маг1С_ДобавитьПКО_Справочник_СостояниеЗаказа_Отправка(ПравилаКонвертации);
	КонецЕсли;
		
	Маг1С_ДобавитьПКО_Справочник_ВидыНоменклатуры(ПравилаКонвертации);
	
	Маг1СИнтеграция.ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации);
	
КонецПроцедуры

&После("ЗаполнитьПравилаКонвертацииПредопределенныхДанных")
Процедура Маг1С_ЗаполнитьПравилаКонвертацииПредопределенныхДанных(НаправлениеОбмена, ПравилаКонвертации)
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСтавкиНДС = "СтавкиНДС";
	ПравилоКонвертации           = ПравилаКонвертации.Найти("Перечисление_СтавкиНДС", "ИмяПКПД");
	
	Если Маг1СИнтеграцияСлужебный.ЕстьЗначениеПеречисления(ИмяСтавкиНДС, "НДС5") Тогда
		ПравилоКонвертации.КонвертацииЗначенийПриОтправке.Вставить(Перечисления[ИмяСтавкиНДС].НДС5, "НДС5");
		ПравилоКонвертации.КонвертацииЗначенийПриОтправке.Вставить(Перечисления[ИмяСтавкиНДС].НДС5_105, "НДС5_105");
		ПравилоКонвертации.КонвертацииЗначенийПриОтправке.Вставить(Перечисления[ИмяСтавкиНДС].НДС7, "НДС7");
		ПравилоКонвертации.КонвертацииЗначенийПриОтправке.Вставить(Перечисления[ИмяСтавкиНДС].НДС7_107, "НДС7_107");
		
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении.Вставить("НДС5", Перечисления[ИмяСтавкиНДС].НДС5);
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении.Вставить("НДС5_105", Перечисления[ИмяСтавкиНДС].НДС5_105);
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении.Вставить("НДС7", Перечисления[ИмяСтавкиНДС].НДС7);
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении.Вставить("НДС7_107", Перечисления[ИмяСтавкиНДС].НДС7_107);
	КонецЕсли;
	
	Если Маг1СИнтеграцияСлужебный.ЕстьЗначениеПеречисления(ИмяСтавкиНДС, "НДС22") Тогда
		ПравилоКонвертации.КонвертацииЗначенийПриОтправке.Вставить(Перечисления[ИмяСтавкиНДС].НДС22, "НДС22");
		ПравилоКонвертации.КонвертацииЗначенийПриОтправке.Вставить(Перечисления[ИмяСтавкиНДС].НДС22_122, "НДС22_122");
		
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении.Вставить("НДС22", Перечисления[ИмяСтавкиНДС].НДС22);
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении.Вставить("НДС22_122", Перечисления[ИмяСтавкиНДС].НДС22_122);
	КонецЕсли;
	
КонецПроцедуры

&Вместо("СтавкаНДСВСтрокуXDTO")
Функция Маг1С_СтавкаНДСВСтрокуXDTO(СтавкаНДС, НДСПоСтавкам2и4)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Результат = ПродолжитьВызов(СтавкаНДС, НДСПоСтавкам2и4);
		Возврат Результат;
	КонецЕсли;
	
	ИмяСтавкиНДС = "СтавкиНДС";
	
	Если СтавкаНДС = Справочники[ИмяСтавкиНДС].БезНДС
		Или Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		
		Возврат "БезНДС"; 
		
	КонецЕсли;  
	
	СтавкаНДСПеречисление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтавкаНДС,  "ПеречислениеСтавкаНДС");
	
	Если Не ЗначениеЗаполнено(СтавкаНДСПеречисление) Тогда
		Возврат "БезНДС"; 
	КонецЕсли;			
	
	Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(СтавкаНДСПеречисление);
	
КонецФункции

#КонецОбласти

#Область Номенклатура
 
&После("ПОД_Справочник_Номенклатура_Отправка_ПриОбработке")
Процедура Маг1С_ПОД_Справочник_Номенклатура_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если Маг1СИнтеграция.ЗначениеНужноДляВременнойСсылкиДо(КомпонентыОбмена.УзелКорреспондента, ДанныеИБ.Ссылка) = Неопределено
		 И Не Маг1СИнтеграция.НоменклатураСоответствуетОтборам(ДанныеИБ.Ссылка, 
															ДанныеИБ.ЭтоГруппа, 
															КомпонентыОбмена.ПараметрыКонвертации)  Тогда
		ИспользованиеПКО.Справочник_Номенклатура_Отправка = Ложь;
		ИспользованиеПКО.Справочник_НоменклатураГруппа    = Ложь;
		
		ПравилоКонвертации = Неопределено;
		Если ДанныеИБ.ЭтоГруппа Тогда
			ПравилоКонвертации = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_НоменклатураГруппа");
		Иначе
			ПравилоКонвертации = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Номенклатура_Отправка");
		КонецЕсли;
		
		ОбменДаннымиXDTOСервер.ВыгрузитьУдалениеОбъекта(КомпонентыОбмена, ДанныеИБ.Ссылка, ПравилоКонвертации);
	КонецЕсли;
			
КонецПроцедуры

&После("ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных")
Процедура Маг1С_ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Маг1СИнтеграция.Справочник_Номенклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Описание", ДанныеИБ.Описание);
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		
		Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
			Возврат;
		КонецЕсли;
		
		Если Не КомпонентыОбмена.ПараметрыКонвертации.ВыгружатьКартинки Тогда
			Возврат;
		КонецЕсли;
		
		РасширениеФайла = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ФайлКартинки, "Расширение");
		
		Если Маг1СИнтеграция.ЭтоКартинка(РасширениеФайла) Тогда
			
			Результат = Новый Структура("Значение, ИмяПКО", ДанныеИБ.ФайлКартинки, "НоменклатураПрисоединенныеФайлы_Отправка");
			ДанныеXDTO.Вставить("ОсновнаяКартинка", Результат);
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&Вместо("ВыгрузитьДополнительныеРеквизитыИСведения")
Процедура Маг1С_ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, ЕстьДопРеквизиты)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		ПродолжитьВызов(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, ЕстьДопРеквизиты);
	КонецЕсли;
КонецПроцедуры

&После("ДобавитьПКО_Справочник_НоменклатураГруппа")
Процедура Маг1С_ДобавитьПКО_Справочник_НоменклатураГруппа(ПравилаКонвертации)
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонвертации = ПравилаКонвертации.Найти("Справочник_НоменклатураГруппа", "ИмяПКО");
	ПравилоКонвертации.ПриОтправкеДанных = "Маг1С_ПКО_Справочник_ВидыНоменклатуры_Отправка_ПриОтправкеДанных";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "",                             "ОсновнаяКартинка", 1, "Маг1С_КартинкиКатегорийТоваров_Отправка");

КонецПроцедуры

&После("ДобавитьПКО_Справочник_Номенклатура_Отправка")
Процедура Маг1С_ДобавитьПКО_Справочник_Номенклатура_Отправка(ПравилаКонвертации)
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонвертации = ПравилаКонвертации.Найти("Справочник_Номенклатура_Отправка", "ИмяПКО");
	
	Если ПравилоКонвертации <> Неопределено Тогда
		СвойстваШапки = ПравилоКонвертации.Свойства;
		ДобавитьПКС(СвойстваШапки, "", "ОсновнаяКартинка", 1, "НоменклатураПрисоединенныеФайлы_Отправка");
		УзелОбменаСеансаОбмена =  Маг1СИнтеграция.УзелОбменаСеансаОбмена();
		
		Настройки = Маг1СИнтеграция.НастройкиВитрины(УзелОбменаСеансаОбмена);
		
		Если Настройки.ДополнительныеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ВидыНоменклатуры() Тогда
			НайденноеПКС = СвойстваШапки.НайтиСтроки(Новый Структура("СвойствоФормата", "Группа"))[0];	
			НайденноеПКС.СвойствоКонфигурации            = "ВидНоменклатуры";
			НайденноеПКС.ПравилоКонвертацииСвойства      = "Маг1С_Справочник_ВидыНоменклатуры";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ХарактеристикиНоменклатуры

&После("ДобавитьПКО_Справочник_ХарактеристикиНоменклатуры")
Процедура Маг1С_ДобавитьПКО_Справочник_ХарактеристикиНоменклатуры(ПравилаКонвертации)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;

	ПравилоКонвертации = ПравилаКонвертации.Найти("Справочник_ХарактеристикиНоменклатуры", "ИмяПКО");
	
	Если ПравилоКонвертации <> Неопределено Тогда
		Маг1СИнтеграция.ДополнитьПКО_Справочник_ХарактеристикиНоменклатуры_Отправка(ПравилоКонвертации)
	КонецЕсли;
КонецПроцедуры

&После("ПКО_Справочник_ХарактеристикиНоменклатуры_ПриОтправкеДанных")
Процедура Маг1С_ПКО_Справочник_ХарактеристикиНоменклатуры_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Маг1СИнтеграция.Справочник_ХарактеристикиНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);

КонецПроцедуры

#КонецОбласти 

#Область ВидыНоменклатуры

Процедура Маг1С_ДобавитьПОД_Справочник_ВидыНоменклатуры_Отправка(ПравилаОбработкиДанных)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	ВидыНоменклатурыИмя = "ВидыНоменклатуры";
	
	СуществующееПравило = ПравилаОбработкиДанных.Найти(Метаданные.Справочники[ВидыНоменклатурыИмя], "ОбъектВыборкиМетаданные");
	
	Если СуществующееПравило <> Неопределено Тогда
		ПравилаОбработкиДанных.Удалить(СуществующееПравило);
	КонецЕсли;
	
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_ВидыНоменклатуры_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Справочники[ВидыНоменклатурыИмя];
	ПравилоОбработки.ПриОбработке            = "Маг1С_ПОД_Справочник_ВидыНоменклатуры_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Маг1С_Справочник_ВидыНоменклатуры");
	
КонецПроцедуры

Процедура Маг1С_ПОД_Справочник_ВидыНоменклатуры_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Использовать = КомпонентыОбмена.ПараметрыКонвертации.НастройкиВитрины.ДополнительныеНастройки.ИерархияПо 
							= Маг1СПеречисления.ИерархияПо_ВидыНоменклатуры();
	ИспользованиеПКО.Маг1С_Справочник_ВидыНоменклатуры = Использовать;

КонецПроцедуры

Процедура Маг1С_ДобавитьПКО_Справочник_ВидыНоменклатуры(ПравилаКонвертации)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	ВидыНоменклатурыИмя = "ВидыНоменклатуры";
	
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Маг1С_Справочник_ВидыНоменклатуры";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Справочники[ВидыНоменклатурыИмя];
	ПравилоКонвертации.ОбъектФормата                = "Справочник.НоменклатураГруппа";
	ПравилоКонвертации.ПриОтправкеДанных            = "Маг1С_ПКО_Справочник_ВидыНоменклатуры_Отправка_ПриОтправкеДанных";
	ПравилоКонвертации.ПравилоДляГруппыСправочника  = Истина;
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "",             "КодВПрограмме");
	ДобавитьПКС(СвойстваШапки, "Наименование", "Наименование");
	ДобавитьПКС(СвойстваШапки, "Родитель",     "Группа", , "Маг1С_Справочник_ВидыНоменклатуры");
	ДобавитьПКС(СвойстваШапки, "", "ОсновнаяКартинка", 1, "Маг1С_КартинкиКатегорийТоваров_Отправка");

КонецПроцедуры

#КонецОбласти

#Область ЗаказыКлиентов
 
&Перед("ОтложеннаяОбработка_ЗаказыПоставщикуКлиента")
Процедура Маг1С_ОтложеннаяОбработка_ЗаказыПоставщикуКлиента_Перед(Объект, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДополнительныеСвойства.Вставить("Маг1С_ЭтоЗаказИзВитрины");
КонецПроцедуры

&После("ОтложеннаяОбработка_ЗаказыПоставщикуКлиента")
Процедура Маг1С_ОтложеннаяОбработка_ЗаказыПоставщикуКлиента_После(Объект, КомпонентыОбмена) 
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоЗаказПоставщику = (Объект.Метаданные().Реквизиты.Найти("ЗакупкаПодДеятельность") <> Неопределено);
	
	Если ЭтоЗаказПоставщику Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ЦенаВключаетНДС  = Истина;
	
	// Из-за условия  ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.1.1") > 0 
	// после расчета скидок на более младших версиях не заполнятся ЭтапыОплаты и заказ не проведется.
	
	ИспользоватьАвтоматическиеСкидкиВПродажахИмя = "ИспользоватьАвтоматическиеСкидкиВПродажах";
	
	Если ПолучитьФункциональнуюОпцию(ИспользоватьАвтоматическиеСкидкиВПродажахИмя)
		И ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.1.1") > 0 Тогда
		ПараметрыРасчетаСкидок = Новый Структура;
		ПараметрыРасчетаСкидок.Вставить("ПрименятьКОбъекту",                Истина);
		ПараметрыРасчетаСкидок.Вставить("ТолькоПредварительныйРасчет",      Ложь);
		ПараметрыРасчетаСкидок.Вставить("ВосстанавливатьУправляемыеСкидки", Ложь);
		СкидкиНаценкиСерверМодуль = ОбщегоНазначения.ОбщийМодуль("СкидкиНаценкиСервер");
		
		СкидкиНаценкиСерверМодуль.Рассчитать(Объект, ПараметрыРасчетаСкидок);	
	КонецЕсли;

	Объект.СкидкиРассчитаны = Истина;
	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.22.1") > 0 Тогда
			ОбработкаТабличнойЧастиКлиентСерверМодуль = ОбщегоНазначения.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиКлиентСервер");
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСерверМодуль.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
		Иначе
			ОбработкаТабличнойЧастиКлиентСерверМодуль = ОбщегоНазначения.ОбщийМодуль("ОбработкаТабличнойЧастиКлиентСервер");
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСерверМодуль.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.26.1") > 0 Тогда
			СтруктураДействий = Новый Структура();
			СтруктураДействий.Вставить(
				"ЗаполнитьСтавкуНДС", 
				Новый Структура("НалогообложениеНДСВТабличнойЧасти, НалогообложениеНДС, Дата, Организация", 
					Ложь, 
					Объект.НалогообложениеНДС, 
					Объект.Дата, 
					Объект.Организация)
			);
		Иначе
			СтруктураДействий = Новый Структура();
			СтруктураДействий.Вставить(
				"ЗаполнитьСтавкуНДС", 
				Новый Структура("НалогообложениеНДС, Дата, Организация", 
					Объект.НалогообложениеНДС, 
					Объект.Дата, 
					Объект.Организация)
			);
		КонецЕсли;
		
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС",  СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		
		Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.22.1") > 0 Тогда
			ОбработкаТабличнойЧастиСерверМодуль = ОбщегоНазначения.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиСервер");
			ОбработкаТабличнойЧастиСерверМодуль.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, Неопределено);
		Иначе
			ОбработкаТабличнойЧастиСерверМодуль = ОбщегоНазначения.ОбщийМодуль("ОбработкаТабличнойЧастиСервер");
			ОбработкаТабличнойЧастиСерверМодуль.ОбработатьСтрокуТЧ(СтрокаТаблицы, СтруктураДействий, Неопределено);
		КонецЕсли;
		
		ЭтоУслуга            = Ложь;
		СодержаниеИзКарточки = "";
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура)
			И ОбщегоНазначения.СсылкаСуществует(СтрокаТаблицы.Номенклатура) Тогда
			
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.Номенклатура, "ТипНоменклатуры, НаименованиеПолное");
			
			ТипыНоменклатурыИмя = "ТипыНоменклатуры";
			
			Если ЗначенияРеквизитов.ТипНоменклатуры = Перечисления[ТипыНоменклатурыИмя].Услуга Тогда
				ЭтоУслуга            = Истина;
				СодержаниеИзКарточки = ЗначенияРеквизитов.НаименованиеПолное;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтоУслуга
			И Не ЗначениеЗаполнено(СтрокаТаблицы.Содержание)
			И ЗначениеЗаполнено(СодержаниеИзКарточки) Тогда
			СтрокаТаблицы.Содержание = СодержаниеИзКарточки;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.1.1") > 0 Тогда
		Объект.ЭтапыГрафикаОплаты.Очистить();
		ЗаказКлиентаИмя = "ЗаказКлиента";
		
		ВзаиморасчетыСерверМодуль = ОбщегоНазначения.ОбщийМодуль("ВзаиморасчетыСервер");
		ВзаиморасчетыСерверМодуль.ПроверитьЗаполнитьЭтапыГрафикаОплаты(Объект);
	Иначе
		
	КонецЕсли;
	
	Если КомпонентыОбмена.ПараметрыКонвертации.НастройкиЮКассы <> Неопределено 
		И СтрНайти(Объект.Комментарий, "ОнЛайнЧерезЮКассу") > 0 Тогда
		
		Запрос = Новый Запрос;
		Если Метаданные.Справочники.Найти("ОбъектыРасчетов") <> Неопределено Тогда
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ОперацияПоЯндексКассе.Ссылка КАК Ссылка,
			|	ЕСТЬNULL(ОбъектыРасчетов.Ссылка, НЕОПРЕДЕЛЕНО) КАК ОбъектРасчетов
			|ИЗ
			|	Документ.ОперацияПоЯндексКассе КАК ОперацияПоЯндексКассе
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
			|		ПО ОперацияПоЯндексКассе.Ссылка = ОбъектыРасчетов.Объект
			|ГДЕ
			|	ОперацияПоЯндексКассе.ИдентификаторПлатежа = &ИдентификаторПлатежа
			|	И НЕ ОперацияПоЯндексКассе.ПометкаУдаления
			|	И НЕ ОперацияПоЯндексКассе.Проведен";
		Иначе
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ОперацияПоЯндексКассе.Ссылка КАК Ссылка,
			|	НЕОПРЕДЕЛЕНО КАК ОбъектРасчетов
			|ИЗ
			|	Документ.ОперацияПоЯндексКассе КАК ОперацияПоЯндексКассе
			|ГДЕ
			|	ОперацияПоЯндексКассе.ИдентификаторПлатежа = &ИдентификаторПлатежа
			|	И НЕ ОперацияПоЯндексКассе.ПометкаУдаления
			|	И НЕ ОперацияПоЯндексКассе.Проведен";
		КонецЕсли;	
		
		Запрос.УстановитьПараметр("ИдентификаторПлатежа", Объект.ИдентификаторПлатежа);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Пока Результат.Следующий() Цикл
			ОперацияОбъект = Результат.Ссылка.ПолучитьОбъект();
			ТекстСообщения = НСтр("ru = 'ИдентификаторТранзакции: %ИдентификаторТранзакции% - помечено на удаление при загрузке заказа-основания из mag1c'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИдентификаторТранзакции%", ОперацияОбъект.ИдентификаторТранзакции);
			ОперацияОбъект.НазначениеПлатежа = ТекстСообщения + Символы.ВК + ОперацияОбъект.НазначениеПлатежа;
			ОперацияОбъект.ИдентификаторТранзакции = 0;
			ОперацияОбъект.ПометкаУдаления = Истина;
			
			ОперацияОбъект.Записать();
			
			Если ЗначениеЗаполнено(Результат.ОбъектРасчетов) Тогда
				ОбъектРасчетовОбъект = Результат.ОбъектРасчетов.ПолучитьОбъект();
				ОбъектРасчетовОбъект.ПометкаУдаления = Истина;
				ОбъектРасчетовОбъект.ИдентификаторПлатежа = "";
				ОбъектРасчетовОбъект.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Маг1СИнтеграция.ПриСозданииЗаказаКлиента(КомпонентыОбмена, Объект);
	
КонецПроцедуры

&После("ПОД_Документ_ЗаказКлиента_Отправка_ПриОбработке")
Процедура Маг1С_ПОД_Документ_ЗаказКлиента_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИспользованиеПКО.Документ_ЗаказКлиента_Отправка Тогда
		Возврат;
	КонецЕсли;
	
	Если Маг1СИнтеграция.ЗначениеНужноДляВременнойСсылкиДо(КомпонентыОбмена.УзелКорреспондента, ДанныеИБ.Ссылка) = Неопределено
		И Не Маг1СИнтеграция.ЭтоКонтрагентВитрины(ДанныеИБ.Контрагент,
													КомпонентыОбмена.ПараметрыКонвертации.ИдентификаторВитрины) Тогда
		ИспользованиеПКО.Документ_ЗаказКлиента_Отправка = Ложь;
	КонецЕсли;	

КонецПроцедуры

&После("ПКО_Документ_ЗаказКлиента_Получение_ПриКонвертацииДанныхXDTO")
Процедура Маг1С_ПКО_Документ_ЗаказКлиента_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	// Этапы графика оплат
	Если ДанныеXDTO.Свойство("ЭтапыОплаты")
		И ЗначениеЗаполнено(ДанныеXDTO.ЭтапыОплаты) Тогда
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплаты",
			Новый Структура("Значение, ИмяПКО",  ДанныеXDTO.ЭтапыОплаты[0].ФормаОплаты, "ФормыОплаты"));
		
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("AdditionalInfo", Маг1СИнтеграцияСлужебный.СтрокаJSONВСтруктуру(ДанныеXDTO.AdditionalInfo));
	КонецЕсли;

КонецПроцедуры

&После("ДобавитьПКО_Документ_ЗаказКлиента_Получение")
Процедура Маг1С_ДобавитьПКО_Документ_ЗаказКлиента_Получение(ПравилаКонвертации)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонвертации = ПравилаКонвертации.Найти("Документ_ЗаказКлиента_Получение", "ИмяПКО");
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "ИдентификаторПлатежа", "ИдентификаторПлатежа");	
КонецПроцедуры

&Вместо("ЗаполнитьПорядокРасчетов")
Процедура Маг1С_ЗаполнитьПорядокРасчетов(Объект, Договор, Соглашение)
	Если Не Объект.ДополнительныеСвойства.Свойство("Маг1С_ЭтоЗаказИзВитрины") Тогда
		ПродолжитьВызов(Объект, Договор, Соглашение);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ПорядокРасчетов")) Тогда
		ЗаполнитьЗначенияСвойств(Объект, Договор, "ПорядокРасчетов");
	ИначеЕсли ЗначениеЗаполнено(Соглашение) И ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Соглашение, "ПорядокРасчетов")) Тогда
		ЗаполнитьЗначенияСвойств(Объект, Соглашение, "ПорядокРасчетов");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПорядокРасчетов) Тогда
		ПорядокРасчетовИмя = "ПорядокРасчетов";
		Объект.ПорядокРасчетов = Перечисления[ПорядокРасчетовИмя].ПоЗаказамНакладным;
	КонецЕсли;

КонецПроцедуры

&Перед("ПКО_Документ_ЗаказКлиента_Получение_ПередЗаписьюПолученныхДанных")
Процедура Маг1С_ПКО_Документ_ЗаказКлиента_Получение_ПередЗаписьюПолученныхДанных_Перед(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("AdditionalInfo") Тогда
		ДанныеДляЗаписиВИБ.ДополнительныеСвойства.Вставить("AdditionalInfo", ПолученныеДанные.ДополнительныеСвойства.AdditionalInfo);
	КонецЕсли;
	
КонецПроцедуры

&После("ПКО_Документ_ЗаказКлиента_Получение_ПередЗаписьюПолученныхДанных")
Процедура Маг1С_ПКО_Документ_ЗаказКлиента_Получение_ПередЗаписьюПолученныхДанных_После(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	Маг1СИнтеграция.УстановитьПрефиксНомеруЗаказа(ДанныеДляЗаписиВИБ);
	
	Если ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.Контрагент) И Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.Партнер) Тогда
		ДанныеДляЗаписиВИБ.Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеДляЗаписиВИБ.Контрагент, "Партнер");
	КонецЕсли;
	
	ДоговорВидЦен = Маг1СИнтеграция.ДоговорВидЦенВитрины(ДанныеДляЗаписиВИБ.Контрагент, КомпонентыОбмена.ПараметрыКонвертации.ИдентификаторВитрины);
	ВидЦен = КомпонентыОбмена.ПараметрыКонвертации.ВидЦен;
	
	Если ДоговорВидЦен <> Неопределено Тогда
		ДанныеДляЗаписиВИБ.Соглашение = ДоговорВидЦен.Договор;
		Если ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.Соглашение) Тогда
			ДанныеДляЗаписиВИБ.ЗаполнитьУсловияПродажПоСоглашению(Ложь);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДоговорВидЦен.ВидЦен) Тогда
			ВидЦен = ДоговорВидЦен.ВидЦен;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрТабл из ДанныеДляЗаписиВИБ.Товары Цикл
		СтрТабл.ВидЦены = ВидЦен;
	КонецЦикла;
	
	ДанныеДляЗаписиВИБ.ДополнительныеСвойства.Вставить("Маг1сЭтоНовый", ДанныеДляЗаписиВИБ.ЭтоНовый());
КонецПроцедуры

&Вместо("ЗаказОтменен")
Функция Маг1С_ЗаказОтменен(Ссылка)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат ПродолжитьВызов(Ссылка);
	КонецЕсли;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Источник.Номенклатура КАК Номенклатура,
		|	Источник.Характеристика КАК Характеристика,
		|	Источник.Упаковка КАК Упаковка
		|ИЗ
		|	&Источник КАК Источник
		|ГДЕ
		|	Источник.Ссылка = &Ссылка
		|	И НЕ Источник.Отменено";
	
	ПолноеИмяОбъекта  = Ссылка.Метаданные().ПолноеИмя();
	
	Если ПолноеИмяОбъекта = "Документ.ЗаявкаНаВозвратТоваровОтКлиента" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса , "&Источник", ПолноеИмяОбъекта + ".ЗаменяющиеТовары");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса , "&Источник", ПолноеИмяОбъекта + ".Товары");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос.Выполнить().Пустой();
КонецФункции

&Вместо("ПКО_Документ_ЗаказКлиента_Отправка_ПриОтправкеДанных")
Процедура Маг1С_ПКО_Документ_ЗаказКлиента_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		ПродолжитьВызов(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
		Возврат;
	КонецЕсли;
	
	ЗаказКлиентаИмя = "ЗаказКлиента";
	
	Если ТипЗнч(ДанныеИБ) <> Тип("ДокументОбъект." + ЗаказКлиентаИмя) Тогда
		Возврат;
	КонецЕсли;
			
	ПродолжитьВызов(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
	
	СуммаНДС = 0;
	
	Если ДанныеXDTO.Свойство("Услуги") Тогда
		Для Каждого СтрТабл из ДанныеXDTO["Услуги"] Цикл
			СуммаНДС = СуммаНДС + СтрТабл.СуммаНДС;
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Товары") Тогда
		Для Каждого СтрТабл из ДанныеXDTO["Товары"] Цикл
			СуммаНДС = СуммаНДС + СтрТабл.СуммаНДС;
		КонецЦикла;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("СуммаНДС", СуммаНДС);	

КонецПроцедуры

