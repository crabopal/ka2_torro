&После("ПКО_Справочник_Контрагенты_ПриОтправкеДанных")
Процедура Маг1С_ПКО_Справочник_Контрагенты_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если Маг1СИнтеграция.ЗначениеНужноДляВременнойСсылкиДо(КомпонентыОбмена.УзелКорреспондента, ДанныеИБ.Ссылка) = Неопределено
		И Не Маг1СИнтеграция.ЭтоКонтрагентВитрины(ДанныеИБ.Ссылка,
													КомпонентыОбмена.ПараметрыКонвертации.ИдентификаторВитрины) Тогда
		Возврат;
	КонецЕсли;
	
	ДоговорВидЦен = Маг1СИнтеграция.ДоговорВидЦенВитрины(ДанныеИБ.Ссылка,
														 КомпонентыОбмена.ПараметрыКонвертации.ИдентификаторВитрины);
	
	Если ДоговорВидЦен <> Неопределено Тогда
		ДанныеXDTO.Вставить("ТипЦен", ДоговорВидЦен.ВидЦен);
	КонецЕсли;
КонецПроцедуры

&После("ПКО_Справочник_Контрагенты_Получение_ПриКонвертацииДанныхXDTO")
Процедура Маг1С_ПКО_Справочник_Контрагенты_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Маг1СИнтеграция.ЗаполнитьКИMag1c(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена);
	
	ПолученныеДанные.НаименованиеПолное = ПолученныеДанные.Наименование;
КонецПроцедуры

&Перед("ПКО_Справочник_Контрагенты_Получение_ПередЗаписьюПолученныхДанных")
Процедура Маг1С_ПКО_Справочник_Контрагенты_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПолученныеДанные, ДанныеИБ,,"ЭтоГруппа,Родитель,Владелец,ДополнительныеРеквизиты,КонтактнаяИнформация,Наименование");

	ПолученныеДанные.ДополнительныеРеквизиты.Загрузить(ДанныеИБ.ДополнительныеРеквизиты.Выгрузить());
	
	Для Каждого СтрокаКИ из ДанныеИБ.КонтактнаяИнформация Цикл
		Если СтрокаКИ.Вид.РазрешитьВводНесколькихЗначений Тогда
			НайденныеСтроки = ПолученныеДанные.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид, Представление", СтрокаКИ.Вид, СтрокаКИ.Представление));
		Иначе
			НайденныеСтроки = ПолученныеДанные.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", СтрокаКИ.Вид));
		КонецЕсли;
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ПолученныеДанные.КонтактнаяИнформация.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКИ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&Вместо("ДобавитьПОД_Справочник_Контрагенты")
Процедура Маг1С_ДобавитьПОД_Контрагенты_Отправка(ПравилаОбработкиДанных)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		ПродолжитьВызов(ПравилаОбработкиДанных);
		Возврат;
	КонецЕсли;
	
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Контрагенты_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Справочники["Контрагенты"];
	ПравилоОбработки.ПриОбработке            = "Маг1С_ПОД_Справочник_Контрагенты_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_Контрагенты");
КонецПроцедуры
 
&Вместо("ОтложеннаяОбработка_Контрагенты")
Процедура Маг1С_ОтложеннаяОбработка_Контрагенты(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		ПродолжитьВызов(Объект, КомпонентыОбмена, ОбъектМодифицирован);
		Возврат;
	КонецЕсли;
	
	Маг1СИнтеграция.СделатьКонтрагентомВитрины(Объект.Ссылка, КомпонентыОбмена.ПараметрыКонвертации.ИдентификаторВитрины);
	
	ИспользоватьПартнеровКакКонтрагентовИмя = "ИспользоватьПартнеровКакКонтрагентов";
	
	Если Не ЗначениеЗаполнено(Объект.Партнер)
		Или Не ПолучитьФункциональнуюОпцию(ИспользоватьПартнеровКакКонтрагентовИмя) Тогда
		ПродолжитьВызов(Объект, КомпонентыОбмена, ОбъектМодифицирован);
    	Возврат;
	КонецЕсли;
	
	ПартнерОбъект = Объект.Партнер.ПолучитьОбъект();
	// Синхронизация свойств контрагента и партнера.
	
	ПартнерыИмя = "Партнеры";
	Если ПартнерОбъект = Справочники[ПартнерыИмя].НеизвестныйПартнер Тогда
		ПродолжитьВызов(Объект, КомпонентыОбмена, ОбъектМодифицирован);
    	Возврат;
	КонецЕсли;

	Для Каждого СтрокаКИКонтрагента Из Объект.КонтактнаяИнформация Цикл
		Если СтрНайти(НРег(СтрокаКИКонтрагента.Вид.ИдентификаторДляФормул), "mag1c") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВидКИПартнера = ВидКИПартнераПоВидуКИКонтрагента(СтрокаКИКонтрагента.Вид, Истина);
		Если ВидКИПартнера = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиКИПартнера = ПартнерОбъект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", ВидКИПартнера));
		Для Каждого СтрокаКИПартнера Из СтрокиКИПартнера Цикл
			ПартнерОбъект.КонтактнаяИнформация.Удалить(СтрокаКИПартнера);
		КонецЦикла;
		
		СтрокаКИПартнера = ПартнерОбъект.КонтактнаяИнформация.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКИПартнера, СтрокаКИКонтрагента);
		СтрокаКИПартнера.Вид = ВидКИПартнера;
	КонецЦикла;
			
	ПартнерОбъект.ОбменДанными.Загрузка = Истина;
	ПартнерОбъект.Записать();
			
КонецПроцедуры

Процедура Маг1С_ПОД_Справочник_Контрагенты_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	
