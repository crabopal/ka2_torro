	Маг1С_ПКО_Справочник_СостояниеЗаказа_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
КонецПроцедуры

Процедура Маг1С_ДобавитьПКО_Справочник_СостояниеЗаказа_Отправка(ПравилаКонвертации)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Справочник_СостояниеЗаказа_Отправка";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.РегистрыСведений["СостоянияЗаказовКлиентов"];
	ПравилоКонвертации.ОбъектФормата     = "Справочник.СостояниеЗаказа";
	ПравилоКонвертации.ПриОтправкеДанных = "Маг1С_ПКО_Справочник_СостояниеЗаказа_Отправка_ПриОтправкеДанных";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "", "ДатаСостояния", 1);
	ДобавитьПКС(СвойстваШапки, "", "Заказ", 1, "Документ_ЗаказКлиента_Отправка");
	ДобавитьПКС(СвойстваШапки, "", "СостояниеЗаказа", 1);
	ДобавитьПКС(СвойстваШапки, "", "СостояниеЗаказаСтрокой", 1);

КонецПроцедуры

&Вместо("ПОД_Справочник_СостоянияЗаказовКлиентов_ПриОбработке")
Процедура Маг1С_ПОД_Справочник_СостоянияЗаказовКлиентов_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		ПродолжитьВызов(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	
	Если ДанныеИБ.Количество() = 0 Тогда
		ДанныеИБ.Прочитать();
		Если ДанныеИБ.Количество() = 0 Тогда
			ИспользованиеПКО.Очистить();
			Возврат;	
		КонецЕсли;
	КонецЕсли;

	Заказ = ДанныеИБ.Отбор.Заказ.Значение;
	
	ЗаказКлиентаИмя = "ЗаказКлиента";
	
	Если ТипЗнч(Заказ) <> Тип("ДокументСсылка." + ЗаказКлиентаИмя) Тогда
		ИспользованиеПКО.Очистить();
		Возврат;	
	КонецЕсли;	

КонецПроцедуры

Процедура Маг1С_ПКО_Справочник_СостояниеЗаказа_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;

	Заказ = ДанныеИБ.Отбор.Заказ.Значение;
	ДанныеXDTO.КлючевыеСвойства.Вставить("Заказ", Заказ);
	
	ТаблицаЗаписи = ДанныеИБ.Выгрузить();
	
	Если ТаблицаЗаписи.Количество() = 0 Тогда
		ДанныеXDTO.Вставить("ДатаСостояния", ТекущаяДатаСеанса());
	Иначе
		ДанныеXDTO.Вставить("ДатаСостояния", ТаблицаЗаписи[0].ДатаСобытия);
	КонецЕсли;
	
	СостоянияЗаказовКлиентовИмя = "СостоянияЗаказовКлиентов";
	
	Если ТаблицаЗаписи.Количество() = 0
		Или Не ЗначениеЗаполнено(ТаблицаЗаписи[0].Состояние)
		Или ЗаказОтменен(Заказ) Тогда
	
		СостояниеЗаказа = "Отменен";
		СостояниеЗаказаСтрокой = "Отменен";
	
	ИначеЕсли ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ОжидаетсяСогласование Тогда
	
		СостояниеЗаказа = "Принят";
		СостояниеЗаказаСтрокой = "Принят";
	
	ИначеЕсли ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ОжидаетсяАвансДоОбеспечения
		Или ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ОжидаетсяПредоплатаДоОтгрузки Тогда
		
		СостояниеЗаказа = "Подтвержден";
		СостояниеЗаказаСтрокой = "Подтвержден";
	
	ИначеЕсли ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ГотовКОбеспечению
		Или ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ОжидаетсяОбеспечение Тогда
		
		СостояниеЗаказа = "Комплектуется";
		СостояниеЗаказаСтрокой = "Комплектуется";
		
		
	ИначеЕсли ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ГотовКОтгрузке
		Или ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ВПроцессеОтгрузки 
		Или ?(ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.23.53") >= 0, ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ОжидаетсяПереходПраваСобственности, Ложь) Тогда
		
		СостояниеЗаказа = "ГотовКВыдаче";
		СостояниеЗаказаСтрокой = "ГотовКВыдаче";
		
	ИначеЕсли ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ОжидаетсяОплатаПослеОтгрузки
		Или ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].ГотовКЗакрытию
		Или ТаблицаЗаписи[0].Состояние = Перечисления[СостоянияЗаказовКлиентовИмя].Закрыт Тогда
		
		СостояниеЗаказа = "Выполнен";
		СостояниеЗаказаСтрокой = "Выполнен";
		
	КонецЕсли;
	
	ДанныеXDTO.Вставить("СостояниеЗаказа",        СостояниеЗаказа);
	ДанныеXDTO.Вставить("СостояниеЗаказаСтрокой", СостояниеЗаказаСтрокой);
	
КонецПроцедуры

#КонецОбласти

#Область НоменклатураПрисоединенныеФайлы

&Вместо("ПКО_НоменклатураПрисоединенныеФайлы_Отправка_ПриОтправкеДанных")
Процедура Маг1С_ПКО_НоменклатураПрисоединенныеФайлы_Отправка_ПриОтправкеДанных_Вместо(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		ПродолжитьВызов(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
	КонецЕсли;
КонецПроцедуры

&Вместо("ПОД_НоменклатураПрисоединенныеФайлы_Отправка_ПриОбработке")
Процедура Маг1С_ПОД_НоменклатураПрисоединенныеФайлы_Отправка_ПриОбработке_Вместо(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		ПродолжитьВызов(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	
	ВыгрузитьУдаление = Ложь;
	
	Если ДанныеИБ.ПометкаУдаления
		Или Не Маг1СИнтеграция.ЭтоКартинка(ДанныеИБ.Расширение) Тогда
		
		ИспользованиеПКО.НоменклатураПрисоединенныеФайлы_Отправка = Ложь;
		ПравилоКонвертации = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "НоменклатураПрисоединенныеФайлы_Отправка");
		ОбменДаннымиXDTOСервер.ВыгрузитьУдалениеОбъекта(КомпонентыОбмена, ДанныеИБ.Ссылка, ПравилоКонвертации);
	Иначе
		ИспользованиеПКО.НоменклатураПрисоединенныеФайлы_Отправка = Истина;
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти 

#Область Склады

&После("ДобавитьПКО_Справочник_Склады_Отправка")
Процедура Маг1С_ДобавитьПКО_Справочник_Склады_Отправка(ПравилаКонвертации)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонвертации = ПравилаКонвертации.Найти("Справочник_Склады_Отправка", "ИмяПКО");
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "",                      "Адрес", 1);
	ДобавитьПКС(СвойстваШапки, "",                      "Телефон", 1);

КонецПроцедуры

&После("ПКО_Справочник_Склады_Отправка_ПриОтправкеДанных")
Процедура Маг1С_ПКО_Справочник_Склады_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки <> Маг1СИнтеграция.ИдентификаторВариантаНастройкиОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВидыКонтактнойИнформации = "ВидыКонтактнойИнформации";
	
	АдресСтрокой = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДанныеИБ.Ссылка,
		Справочники[ИмяВидыКонтактнойИнформации].АдресСклада,,Истина);
	Если ЗначениеЗаполнено(АдресСтрокой) Тогда
		ДанныеXDTO.Вставить("Адрес", АдресСтрокой);
	КонецЕсли;

	Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДанныеИБ.Ссылка,
		Справочники[ИмяВидыКонтактнойИнформации].ТелефонСклада,, Истина);
	Если ЗначениеЗаполнено(Телефон) Тогда
		ДанныеXDTO.Вставить("Телефон", Маг1СИнтеграцияСлужебный.ФорматироватьТелефон(Телефон));
	КонецЕсли;
	
КонецПроцедуры

