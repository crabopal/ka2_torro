#Область Упаковки

&Вместо("ПОД_Справочник_УпаковкиЕдиницыИзмерения_Отправка_ПриОбработке")
Процедура Маг1С_ПОД_Справочник_УпаковкиЕдиницыИзмерения_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с(КомпонентыОбмена) Тогда
		ПродолжитьВызов(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	
	УстановитьИспользованиеПКО(ИспользованиеПКО, Ложь);
	
	НаборыУпаковокИмя = "НаборыУпаковок";
	
	Если ДанныеИБ.Владелец = Справочники[НаборыУпаковокИмя].БазовыеЕдиницыИзмерения Тогда
		ИспользованиеПКО.Справочник_ЕдиницыИзмерения = Истина;
	Иначе
		ИспользованиеПКО.Справочник_Упаковки = Истина;	
	КонецЕсли;
КонецПроцедуры

&Вместо("ДобавитьПКО_Справочник_Упаковки")
Процедура Маг1С_ДобавитьПКО_Справочник_Упаковки(ПравилаКонвертации)
	Если Не Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		ПродолжитьВызов(ПравилаКонвертации);
		Возврат;
	КонецЕсли;
	
	УпаковкиЕдиницыИзмеренияИмя = "УпаковкиЕдиницыИзмерения";
	
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Справочник_Упаковки";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Справочники[УпаковкиЕдиницыИзмеренияИмя];
	ПравилоКонвертации.ОбъектФормата                = "Справочник.Упаковки";
	ПравилоКонвертации.ПриОтправкеДанных            = "Маг1С_ПКО_Справочник_Упаковки_ПриОтправкеДанных";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "",           "Коэффициент", 1);
	ДобавитьПКС(СвойстваШапки, "Наименование", "Наименование");
КонецПроцедуры

Процедура Маг1С_ПКО_Справочник_Упаковки_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Коэффициент = ?(ДанныеИБ.Знаменатель = 0, ДанныеИБ.Числитель, Окр(ДанныеИБ.Числитель / ДанныеИБ.Знаменатель,3));
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		ДанныеXDTO.Вставить("Коэффициент", Коэффициент);
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.КлючевыеСвойства.Вставить("Коэффициент", Коэффициент);

КонецПроцедуры

#КонецОбласти 
