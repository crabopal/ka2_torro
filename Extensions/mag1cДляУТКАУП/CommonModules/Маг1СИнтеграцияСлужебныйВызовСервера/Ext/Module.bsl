#Область СлужебныеПроцедурыИФункции

Функция ПараметрыФормыМастераУстановкиЦен(НастройкиВитрины, НастройкиУчетнойСистемы, Режим) Экспорт
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Маг1С_ВидЦен", НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен);		
	ПараметрыФормы.Вставить("Маг1С_НоменклатураДляУстановкиЦен", МассивТоваровДляУстановкиЦен(НастройкиВитрины, НастройкиУчетнойСистемы, Режим));		
	
	Маг1СИнтеграцияПереопределяемый.ПриПолучениеПараметровФормыМастераУстановкиЦен(ПараметрыФормы, НастройкиВитрины);
	
	Возврат ПараметрыФормы;
КонецФункции

Функция МассивТоваровДляУстановкиЦен(НастройкиВитрины, НастройкиУчетнойСистемы, Режим)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	НастройкиНастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);	
	
	Маг1СИнтеграция.СформироватьВТЦены(МенеджерВременныхТаблиц, НастройкиНастройкиФильтровНоменклатуры, НастройкиВитрины);
	Маг1СИнтеграция.СформироватьВТПубликуемаяНоменклатура(МенеджерВременныхТаблиц, НастройкиНастройкиФильтровНоменклатуры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 500
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.Номенклатура КАК Справочник.ИмяСправочникаНоменклатура).Наименование КАК Наименование
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТПубликуемаяНоменклатура.Номенклатура КАК Номенклатура
	|	ИЗ
	|		ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК ВТЦены
	|			ПО ВТПубликуемаяНоменклатура.Номенклатура = ВТЦены.Номенклатура
	|	ГДЕ
	|		&ТоварыБезЦен
	|		И ЕСТЬNULL(ВТЦены.Цена, 0) = 0
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТЦены.Номенклатура
	|	ИЗ
	|		ВТЦены КАК ВТЦены
	|	ГДЕ
	|		&ТоварыСоСтарымиЦенами
	|		И ВТЦены.Период < &ПериодАктуальностиЦен) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ИмяСправочникаНоменклатура",
		Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()));
	
	Запрос.УстановитьПараметр("ПериодАктуальностиЦен", Маг1СИнтеграцияСлужебный.Дней30ОтТекущейДаты());
	Запрос.УстановитьПараметр("ТоварыБезЦен", Режим = "ТоварыБезЦен");
	Запрос.УстановитьПараметр("ТоварыСоСтарымиЦенами", Режим = "ТоварыСоСтарымиЦенами");
	Запрос.УстановитьПараметр("ПериодАктуальностиЦен", Маг1СИнтеграцияСлужебный.Дней30ОтТекущейДаты());
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
КонецФункции

Функция ПараметрыОбращенияВТехПоддержку(ИдентификаторВитрины) Экспорт 
	
	Результат = Новый Структура("ОписаниеКонфигурации, ИНН, ИмяВитрины, ЛогинИПП", Неопределено, "");
	
	Результат.ОписаниеКонфигурации = Обработки.Маг1СНастройка.ОписаниеКонфигурации();

	Если ПустаяСтрока(ИдентификаторВитрины) Тогда
		Возврат Результат;
	Иначе
		НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(ИдентификаторВитрины);
	КонецЕсли;
	
	Если НастройкиВитрины <> Неопределено
		И НастройкиВитрины.Свойство("ОсновныеНастройки") Тогда
		
		Если ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация) Тогда
			
			СведенияОбОрганизации = Маг1СИнтеграцияСлужебный.СведенияОбОрганизации(НастройкиВитрины.ОсновныеНастройки);
			Результат.ИНН        = СведенияОбОрганизации.ИНН;
			
		КонецЕсли;
		
		Результат.ИмяВитрины = НастройкиВитрины.ОсновныеНастройки.ИмяВитрины;	
		Результат.ЛогинИПП   = НастройкиВитрины.ЛогинИПП;	
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СостояниеАутентификацииИПП() Экспорт
	Возврат Маг1СИнтеграцияСлужебный.СостояниеАутентификацииИПП()
КонецФункции

Функция ВыгрузитьСообщенияОбОшибкахИзЖР(ПараметрыОперации, УникальныйИдентификаторФормы) Экспорт
	
	Отбор = Новый Структура;
	ОтборПоУровню = Новый СписокЗначений();
	ОтборПоУровню.Добавить("Ошибка", "Ошибка");
	Отбор.Вставить("Уровень", ОтборПоУровню);
	
	Если ТипЗнч(ПараметрыОперации) = Тип("Структура")
		Или ТипЗнч(ПараметрыОперации) = Тип("ФиксированнаяСтруктура") Тогда
		
		Если ПараметрыОперации.Свойство("ДатаНачала") Тогда
			Отбор.Вставить("ДатаНачала", ПараметрыОперации.ДатаНачала);
		КонецЕсли;
		
		Если ПараметрыОперации.Свойство("ДатаОкончания") Тогда
			Отбор.Вставить("ДатаОкончания", ПараметрыОперации.ДатаОкончания);
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();
	
	Если Не Отбор.Свойство("ДатаНачала") Тогда
		Отбор.Вставить("ДатаНачала", ТекущаяДатаСеанса - 5*3600); 	
	КонецЕсли;
	
	Если Не Отбор.Свойство("ДатаОкончания") Тогда
		Отбор.Вставить("ДатаОкончания", ТекущаяДатаСеанса); 	
	КонецЕсли;
	
	Возврат ЖурналРегистрации.ЖурналДляТехподдержки(Отбор, 200, УникальныйИдентификаторФормы);
	
КонецФункции

Функция ПараметрыОткрытияФормыИнвайта(ПараметрКоманды) Экспорт
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	ЕстьВитрина = Ложь;
	
	Для Каждого КлючЗначение из СписокВитрин Цикл
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(КлючЗначение.Значение) Тогда
			ЕстьВитрина = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьПравоНастройкиВитрины  = ПравоДоступа("Просмотр", Метаданные.Обработки.Маг1СНастройка);
	ЕстьПравоВыполененияОбмена = Истина;
	Попытка
		ОбменДаннымиСервер.ПроверитьВозможностьВыполненияОбменов();
	Исключение
		ЕстьПравоВыполененияОбмена = Ложь;
	КонецПопытки;
	
	Контрагенты = Новый Массив();
	
	Если ЕстьПравоВыполененияОбмена Тогда
		
		Для Каждого СтрМас из ПараметрКоманды Цикл 
		
			Если ТипЗнч(СтрМас) = ТипЗнч(НастройкиУчетнойСистемы.Контрагент.Значение) Тогда
				Контрагенты.Добавить(СтрМас);
			ИначеЕсли ТипЗнч(СтрМас) = ТипЗнч(НастройкиУчетнойСистемы.ЗаказПокупателя.Значение) Тогда
		        Контрагенты.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрМас, НастройкиУчетнойСистемы.ЗаказПокупателя.Реквизиты.Контрагент));
			Иначе
				Значение = Маг1СИнтеграцияПереопределяемый.КонтрагентПоПараметруКомандыПолученияИнвайта(СтрМас);
				Если Значение <> Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Контрагенты, Значение, Ложь);
				КонецЕсли;
			КонецЕсли;
			
			Контрагенты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Контрагенты);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Новый Структура("ЕстьВитрина, ЕстьПравоНастройкиВитрины, Контрагенты, ЕстьПравоВыполененияОбмена",
							 ЕстьВитрина, ЕстьПравоНастройкиВитрины, Контрагенты, ЕстьПравоВыполененияОбмена);  
КонецФункции

Функция ПараметрыФормыПолученияСсылки(ДокументСсылка, АдресПриложенияВИнтернете) Экспорт
	
	СостояниеАутентификацииИПП = Маг1СИнтеграцияСлужебныйВызовСервера.СостояниеАутентификацииИПП();
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ЕстьПравоВыполененияОбмена = Истина;
	Попытка
		ОбменДаннымиСервер.ПроверитьВозможностьВыполненияОбменов();
	Исключение
		ЕстьПравоВыполененияОбмена = Ложь;
	КонецПопытки;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		Новый Структура("Проведен,Организация,Контрагент,СуммаВключаетНДС",
		"Проведен",
		НастройкиУчетнойСистемы.ЗаказПокупателя.Реквизиты.Организация,
		НастройкиУчетнойСистемы.ЗаказПокупателя.Реквизиты.Контрагент,
		НастройкиУчетнойСистемы.ЗаказПокупателя.Реквизиты.СуммаВключаетНДС));
		
	ЯвляетсяПлательщикомНДС = Ложь;
	
	Если ЗначениеЗаполнено(Реквизиты.Организация) Тогда				
		СведенияОбОрганизации = Маг1СИнтеграцияСлужебный.СведенияОбОрганизации(Реквизиты.Организация);
		ЯвляетсяПлательщикомНДС = СведенияОбОрганизации.ЯвляетсяПлательщикомНДС;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьПравоВыполененияОбмена", ЕстьПравоВыполененияОбмена);
	Результат.Вставить("Организация", Реквизиты.Организация);
	Результат.Вставить("Контрагент", Реквизиты.Контрагент);
	Результат.Вставить("ДокументСсылка", ДокументСсылка);
	Результат.Вставить("РежимФормы", Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки());
	Результат.Вставить("Проведен", Реквизиты.Проведен);
	Результат.Вставить("СуммаВключаетНДС", Реквизиты.СуммаВключаетНДС);
	Результат.Вставить("ЯвляетсяПлательщикомНДС", ЯвляетсяПлательщикомНДС);
	Результат.Вставить("АдресПриложенияВИнтернете", АдресПриложенияВИнтернете);
	Результат.Вставить("ЛогинИПП", СостояниеАутентификацииИПП.ЛогинИПП);
	Результат.Вставить("АутентификацияИППВыполнена", СостояниеАутентификацииИПП.АутентификацияИППВыполнена);
	Результат.Вставить("СтрокаСпискаВитрин", Неопределено); 
	Результат.Вставить("ОписаниеСсылки", Неопределено);
	Результат.Вставить("ОписаниеИнвайта", Неопределено);
	Результат.Вставить("Действие", Неопределено);
	Результат.Вставить("ЕстьПользователи", ЕстьПользователи());
	Результат.Вставить("ЕстьПодсистемаОнлайнЗаказов", Маг1СИнтеграция.ДоступнаПодсистемаОнлайнЗаказов());
	
	Возврат Результат;  
КонецФункции

Функция ПараметрыФормыПолученияИнформацииПоПрофилю(АдресПриложенияВИнтернете) Экспорт
	СостояниеАутентификацииИПП = Маг1СИнтеграцияСлужебныйВызовСервера.СостояниеАутентификацииИПП();
	
	ЕстьПравоВыполененияОбмена = Истина;
	Попытка
		ОбменДаннымиСервер.ПроверитьВозможностьВыполненияОбменов();
	Исключение
		ЕстьПравоВыполененияОбмена = Ложь;
	КонецПопытки;
	
			
	Результат = Новый Структура;
	Результат.Вставить("ЕстьПравоВыполененияОбмена", ЕстьПравоВыполененияОбмена);
	Результат.Вставить("ЕстьПравоНастройкиВитрины", ПравоДоступа("Просмотр", Метаданные.Обработки.Маг1СНастройка));
	Результат.Вставить("ЛогинИПП", СостояниеАутентификацииИПП.ЛогинИПП);
	Результат.Вставить("АутентификацияИППВыполнена", СостояниеАутентификацииИПП.АутентификацияИППВыполнена);
	Результат.Вставить("РежимФормы", Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин());
	Результат.Вставить("ПоказатьСписокДругихВитрин", Ложь);
	Результат.Вставить("АдресПриложенияВИнтернете", АдресПриложенияВИнтернете);
	Результат.Вставить("ЕстьПользователи", ЕстьПользователи());
	
	Возврат Результат;  
КонецФункции

Функция ЕстьПользователи()
	УстановитьПривилегированныйРежим(Истина);
	                                                                                  
	Возврат Не ПустаяСтрока(ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
КонецФункции

Процедура СоздатьПользователяАдминистратор() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Пользователи.СоздатьАдминистратора();
КонецПроцедуры

Функция ИмяФормыОбъекта(СправочникСсылка) Экспорт

	МетаданныеСправочника = СправочникСсылка.Метаданные();
	
	Возврат МетаданныеСправочника.ПолноеИмя() + ".ФормаОбъекта";
	
КонецФункции

Функция ЕстьПроблемаСНДСВВидеЦен(ВидЦен, Организация) Экспорт
	Если Не ЗначениеЗаполнено(ВидЦен)
		Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	СведенияОбОрганизации = Маг1СИнтеграцияСлужебный.СведенияОбОрганизации(Организация);
	
	Если Не СведенияОбОрганизации.ЯвляетсяПлательщикомНДС Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦен, "ЦенаВключаетНДС");
КонецФункции

Функция ЕстьПроблемаСНДСВВидеЦенДоговора(Договор, Организация) Экспорт
	Если Не ЗначениеЗаполнено(Договор)
		Или Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СведенияОбОрганизации = Маг1СИнтеграцияСлужебный.СведенияОбОрганизации(Организация);
	
	Если Не СведенияОбОрганизации.ЯвляетсяПлательщикомНДС Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ВидЦен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.ВидЦен);
	
	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦен, "ЦенаВключаетНДС");
КонецФункции

#КонецОбласти
