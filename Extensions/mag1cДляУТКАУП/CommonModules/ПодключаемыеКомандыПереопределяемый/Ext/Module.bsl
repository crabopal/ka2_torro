
&После("ПриОпределенииВидовПодключаемыхКоманд")
Процедура Маг1С_ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд)
	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя         = "mag1c";
	Вид.ИмяПодменю  = "Подменюmag1c";
	Вид.Заголовок   = НСтр("ru = 'mag1c'");
	Вид.Картинка    = БиблиотекаКартинок.Маг1СЛоготипПрозрачныйФон;
	Вид.Отображение = ОтображениеКнопки.Картинка;
КонецПроцедуры

&После("ПриОпределенииКомандПодключенныхКОбъекту")
Процедура Маг1С_ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды)
	
	Если Пользователи.ЭтоСеансВнешнегоПользователя() Тогда
		Возврат;
	КонецЕсли;
	
#Область ПолучениеИнвайта

	Если Команды.Найти("ПолучитьИнвайтmag1c", "Идентификатор") = Неопределено Тогда 

		ТипыОбъектов = новый Массив();
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		
		ТипыОбъектов.Добавить(ТипЗнч(НастройкиУчетнойСистемы.Контрагент.Значение));
		
		Для Каждого ДопТип из НастройкиУчетнойСистемы.ДопТипыОбъектовДляРазмещенияКомандыПолученияИнвайта Цикл
			ТипыОбъектов.Добавить(ТипЗнч(ДопТип));
		КонецЦикла;
		
		ТипПараметра = Новый ОписаниеТипов(ТипыОбъектов);
		
		Команда = Команды.Добавить();
		Команда.Вид = "mag1c";
		Команда.Идентификатор = "ПолучитьИнвайтmag1c";
		Команда.Представление = НСтр("ru = 'Получить инвайт для витрины mag1c'");
		Команда.Важность = "Важное";
		Команда.Порядок = 1;
		Команда.ОтображениеКнопки = ОтображениеКнопки.Картинка;
		Команда.Картинка = БиблиотекаКартинок.Маг1СЛоготипПрозрачныйФон;
		Команда.ТипПараметра = ТипПараметра;
		Команда.Назначение = "Обычное";
		Команда.ИзменяетВыбранныеОбъекты = Истина;
		Команда.МножественныйВыбор = Истина;
		Команда.ТолькоВоВсехДействиях = Ложь;
		Команда.РежимЗаписи = "Записывать";
		Команда.Обработчик = "Маг1СИнтеграцияСлужебныйКлиент.ОткрытьФормуПолученияИнвайта";
		
	КонецЕсли;
#КонецОбласти

#Область ПолучениеВременнойСсылки

	Если Команды.Найти("СтраницаMag1c", "Идентификатор") = Неопределено Тогда 
		
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		ПустаяСсылкаЗаказа      = НастройкиУчетнойСистемы.ЗаказПокупателя.Значение;
		
		ТипыОбъектов = Новый Массив();
		ТипыОбъектов.Добавить(ТипЗнч(ПустаяСсылкаЗаказа));
		ТипПараметра = Новый ОписаниеТипов(ТипыОбъектов);
				
		МетаданныеЗаказа = ПустаяСсылкаЗаказа.Метаданные();
		
		НазваниеДокумента = "";
		
		Если СтрНайти(НРег(МетаданныеЗаказа.Синоним), НСтр("ru = 'заказ'")) > 0 Тогда
			НазваниеДокумента = НСтр("ru = 'заказа'"); 	
		ИначеЕсли СтрНайти(НРег(МетаданныеЗаказа.Синоним), НСтр("ru = 'счет'")) > 0 Тогда
			НазваниеДокумента = НСтр("ru = 'счета'"); 	
		Иначе
			НазваниеДокумента = НСтр("ru = 'документа'"); 	
		КонецЕсли;
		
		ВидыКоманд = Неопределено;
		
		Попытка
			ВидыКоманд = ПодключаемыеКомандыПовтИсп.ВидыКоманд();
		Исключение
		КонецПопытки;
		
		Если ВидыКоманд <> Неопределено 
			И ВидыКоманд.Найти("Отправить", "Имя") <> Неопределено Тогда
			ВидКоманды = "Отправить";
			ЗаголовокКоманды = НСтр("ru = 'Ссылку на веб-страницу %НазваниеДокумента'");
		Иначе
			ВидКоманды = "Печать";
			ЗаголовокКоманды = НСтр("ru = 'Веб-страница %НазваниеДокумента'");
		КонецЕсли;
		
		ЗаголовокКоманды = СтрЗаменить(ЗаголовокКоманды, "%НазваниеДокумента", НазваниеДокумента); 
		
		Команда = Команды.Добавить();
		Команда.Вид = ВидКоманды;
		Команда.Идентификатор = "СтраницаMag1c";
		Команда.Представление = ЗаголовокКоманды;
		Команда.Важность = "Обычное";
		Команда.Порядок = 180;
		Команда.ОтображениеКнопки = ОтображениеКнопки.Картинка;
		Команда.Картинка = БиблиотекаКартинок.Маг1СЛоготипПрозрачныйФон;
		Команда.ТипПараметра = ТипПараметра;
		Команда.ИзменяетВыбранныеОбъекты = Ложь;
		Команда.МножественныйВыбор = Ложь;
		Команда.ТолькоВоВсехДействиях = Ложь;
		Команда.РежимЗаписи = "Записывать";
		Команда.Обработчик = "Маг1СИнтеграцияСлужебныйКлиент.ОткрытьФормуВременнойСсылкиОбработкаКоманды";
		
 	КонецЕсли;

#КонецОбласти
	
КонецПроцедуры
