#Область СлужебныеПроцедурыИФункции

// Сравнивает значения переданных структур по указанным свойствам
// Параметры
// 	Структура1,Структура2 - сравниваемые структуры
//	Свойства - имена свойств, по которым нужно проводить сравнение, 
//			Тип - массив строк с именами свойств, или строка (имена перечисляются через запятую)
// Возвращаемое значение - Истина, если структуры равны по значениям переданных свойств.
//
Функция СтруктурыРавны(Структура1, Структура2, Свойства = Неопределено) Экспорт
	
	ПоВсемСвойствам = Ложь;
	
	Если ТипЗнч(Свойства) = Тип("Строка") Тогда
		МассивСвойств = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Свойства);
	ИначеЕсли Свойства <> Неопределено Тогда 
		МассивСвойств = Свойства;
	Иначе
		ПоВсемСвойствам = Истина;
	КонецЕсли;
	
	Если ПоВсемСвойствам Тогда
		
		Если Структура1.Количество() <> Структура2.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Для Каждого КлючЗначение Из Структура1 Цикл
			
			Если ТипЗнч(Структура2) = Тип("Структура") 
				И Не Структура2.Свойство(КлючЗначение.Ключ) Тогда
				Возврат Ложь;
			КонецЕсли;
			
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
			Если ТипЗнч(КлючЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
#КонецЕсли
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				
				Если Не МассивыРавны(КлючЗначение.Значение, Структура2[КлючЗначение.Ключ]) Тогда
					Возврат Ложь;
				КонецЕсли;
				
			ИначеЕсли (ТипЗнч(КлючЗначение.Значение) = Тип("Структура")
					ИЛИ ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие")) Тогда
					
				Если Не СтруктурыРавны(КлючЗначение.Значение, Структура2[КлючЗначение.Ключ]) Тогда
					Возврат Ложь;
				КонецЕсли;
					
			Иначе					
								
				Если Не КлючЗначение.Значение = Структура2[КлючЗначение.Ключ] Тогда
					Возврат Ложь;
				КонецЕсли;
						
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Для Каждого СтрМас Из МассивСвойств Цикл
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
			Если ТипЗнч(Структура1[СтрМас]) = Тип("ТаблицаЗначений") Тогда
				Продолжить;
			КонецЕсли;
#КонецЕсли
			Если ТипЗнч(Структура1[СтрМас]) = Тип("Массив")
				И Не МассивыРавны(Структура1[СтрМас], Структура2[СтрМас]) Тогда
				Возврат Ложь;
			ИначеЕсли (ТипЗнч(Структура1[СтрМас]) = Тип("Структура")
					ИЛИ ТипЗнч(Структура1[СтрМас]) = Тип("Соответствие"))
				И Не СтруктурыРавны(Структура1[СтрМас], Структура2[СтрМас]) Тогда
				Возврат Ложь;
			ИначеЕсли Не (ТипЗнч(Структура1[СтрМас]) = Тип("Массив")
					ИЛИ ТипЗнч(Структура1[СтрМас]) = Тип("Структура")
					ИЛИ ТипЗнч(Структура1[СтрМас]) = Тип("Соответствие"))
					И Не Структура1[СтрМас] = Структура2[СтрМас] Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Сравнивает значения переданных массивов
//
// Параметры:
//	Массив1, Массив2 - сравниваемые массивы
//	ПорядокИмеетЗначения - Булево - если Истина, то одинаковые значения должны иметь одинаковые индексы в массиве.
//
// Возвращаемое значение:
//	Истина, если массивы равны
//
Функция МассивыРавны(Массив1, Массив2, ПорядокИмеетЗначения = Истина) Экспорт
	
	Если Не Массив1.Количество() = Массив2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПорядокИмеетЗначения Тогда
		
		Для Индекс = 0 По Массив1.Количество() - 1 Цикл
			Если Не Массив1[Индекс] = Массив2[Индекс] Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого ТекущийЭлемент Из Массив1 Цикл
			Если Массив2.Найти(ТекущийЭлемент) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СтруктураСостояниеАутентификацииИПП() Экспорт
	Возврат Новый Структура("ЛогинИПП,АутентификацияИППВыполнена", "", Ложь);
КонецФункции

Функция СтрокаСпискаВитрин(НастройкиВитрины = Неопределено) Экспорт
	
	СтрокаСпискаВитрин = Новый Структура;
	
	Если НастройкиВитрины = Неопределено Тогда
		СтрокаСпискаВитрин.Вставить("ИдентификаторВитрины", ИдентификаторНовойВитрины());
		СтрокаСпискаВитрин.Вставить("УзелОбмена", Неопределено);
		СтрокаСпискаВитрин.Вставить("АдресСайтаВитрины", "");
		СтрокаСпискаВитрин.Вставить("ПолноеИмяВитрины", "");
		СтрокаСпискаВитрин.Вставить("ДоменПользователя", "");
		СтрокаСпискаВитрин.Вставить("ТипСертификатаДоменаПользователя", Маг1СПеречисления.ТипыСертификатов_None());
		СтрокаСпискаВитрин.Вставить("РежимВитрины", "");		
		СтрокаСпискаВитрин.Вставить("Организация", Неопределено);
	Иначе
		Если ПустаяСтрока(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины) Тогда
			СтрокаСпискаВитрин.Вставить("ИдентификаторВитрины", ИдентификаторНовойВитрины());
		Иначе
			СтрокаСпискаВитрин.Вставить("ИдентификаторВитрины", НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
		КонецЕсли;
		СтрокаСпискаВитрин.Вставить("УзелОбмена", НастройкиВитрины.ОсновныеНастройки.УзелОбмена);
		СтрокаСпискаВитрин.Вставить("АдресСайтаВитрины", НастройкиВитрины.ОсновныеНастройки.АдресСайтаВитрины);
		СтрокаСпискаВитрин.Вставить("ПолноеИмяВитрины", НастройкиВитрины.ОсновныеНастройки.ПолноеИмяВитрины);
		СтрокаСпискаВитрин.Вставить("РежимВитрины", НастройкиВитрины.ОсновныеНастройки.РежимВитрины);		
		СтрокаСпискаВитрин.Вставить("Организация",  НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация);
		СтрокаСпискаВитрин.Вставить("ДоменПользователя", НастройкиВитрины.ОсновныеНастройки.ДоменПользователя);
		Если ТипСертификатаДоменаПользователяЗаполнен(НастройкиВитрины.ОсновныеНастройки.ТипСертификатаДоменаПользователя) Тогда
			СтрокаСпискаВитрин.Вставить("ТипСертификатаДоменаПользователя", НастройкиВитрины.ОсновныеНастройки.ТипСертификатаДоменаПользователя);
		КонецЕсли;	
	КонецЕсли;	
	
	СтрокаСпискаВитрин.Вставить("Состояние", "");
	СтрокаСпискаВитрин.Вставить("СостояниеДоменаПользователя", Маг1СПеречисления.СостоянияДоменаПользователя_None());
	СтрокаСпискаВитрин.Вставить("СостояниеСертификатаДоменаПользователя", Маг1СПеречисления.СостоянияСертификатаДоменаПользователя_None());
	СтрокаСпискаВитрин.Вставить("СертификатДоменаПользователяИстекаетВ", '00010101');
	СтрокаСпискаВитрин.Вставить("НастройкиДоменаПользователя", Новый Структура());
	СтрокаСпискаВитрин.Вставить("СообщениеМенеджера", "");
	СтрокаСпискаВитрин.Вставить("ИдентификаторИБ", "");
	СтрокаСпискаВитрин.Вставить("ХешОсновныхНастроек", "");
	СтрокаСпискаВитрин.Вставить("ХешДополнительныхНастроек", "");
	СтрокаСпискаВитрин.Вставить("СтатусТокенаЮКассы", Маг1СПеречисления.СтатусыТокенаПлатежныхСистем_NotNeeded());
	СтрокаСпискаВитрин.Вставить("СтатусТокенаСБП", Маг1СПеречисления.СтатусыТокенаПлатежныхСистем_NotNeeded());
	СтрокаСпискаВитрин.Вставить("ОстановленаОтправкаУведомлений", Ложь);
	СтрокаСпискаВитрин.Вставить("ОстановленаОтправкаУведомленийПоЗаказам", Ложь);
	
	Возврат СтрокаСпискаВитрин;	
КонецФункции

Функция НастройкиДоменаПользователяПредставление(НастройкиДоменаПользователя) Экспорт
	Если ТипЗнч(НастройкиДоменаПользователя) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = Новый Массив;
	
	ЕстьАЗапись              = Ложь;
	
	Для Каждого ВозможнаяНастройка Из НастройкиДоменаПользователя Цикл
		Если Не ВозможнаяНастройка.Свойство("Values") Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ЗначениеНастройки из ВозможнаяНастройка.Values Цикл
			
			Текст = НСтр("ru = 'Тип записи:%ТипЗаписи  Хост(имя записи):%Хост  Значение:%Значение'");
			Текст = СтрЗаменить(Текст, "%ТипЗаписи", ВРег(ВозможнаяНастройка.RecordType));
			Текст = СтрЗаменить(Текст, "%Хост", ВозможнаяНастройка.Name);
			Текст = СтрЗаменить(Текст, "%Значение", ЗначениеНастройки);
			Если ВРег(ВозможнаяНастройка.RecordType) = Маг1СПеречисления.ЗаписиDNS_A() Тогда
				ЕстьАЗапись = Истина;	
			КонецЕсли;
			
			Результат.Добавить(Текст);
		КонецЦикла;
	КонецЦикла;
	
	Если ЕстьАЗапись Тогда
		Текст = НСтр("ru = 'Также удалите запись AAAA'");
		Результат.Добавить(Текст);
	КонецЕсли;
			
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Функция СертификатДоменаПользователя() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Сертификат", "");
	Результат.Вставить("Ключ", "");
	Результат.Вставить("ЦепочкаСертификатов", "");
	Результат.Вставить("СертификатОднимФайлом", "");
	
	Возврат Результат;
КонецФункции

Функция СертификатДоменаПользователяЗаполнен(СертификатДоменаПользователя) Экспорт
	Возврат ТипЗнч(СертификатДоменаПользователя) = Тип("Структура")
			И (Не ПустаяСтрока(СертификатДоменаПользователя.Ключ)
			 		И Не ПустаяСтрока(СертификатДоменаПользователя.Сертификат)
					И Не ПустаяСтрока(СертификатДоменаПользователя.ЦепочкаСертификатов)
				Или Не ПустаяСтрока(СертификатДоменаПользователя.СертификатОднимФайлом));
КонецФункции 

Функция ТипСертификатаДоменаПользователяЗаполнен(ТипСертификата) Экспорт
	Возврат ТипСертификата = Маг1СПеречисления.ТипыСертификатов_Automatic()
		Или  ТипСертификата = Маг1СПеречисления.ТипыСертификатов_Manual();
КонецФункции

Функция СертификатДоменаПользователяЕстьПроблема(СтрокаСпискаВитрин) Экспорт
	Возврат СтрокаСпискаВитрин.ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual()
					И (СтрокаСпискаВитрин.СостояниеСертификатаДоменаПользователя <> Маг1СПеречисления.СостоянияСертификатаДоменаПользователя_Valid()
						И СтрокаСпискаВитрин.СостояниеСертификатаДоменаПользователя <> Маг1СПеречисления.СостоянияСертификатаДоменаПользователя_Validating()
						Или СертификатДоменаПользователяСкороИстечет(СтрокаСпискаВитрин));
КонецФункции
					
Функция СертификатДоменаПользователяСкороИстечет(СтрокаСпискаВитрин) Экспорт
	Возврат СтрокаСпискаВитрин.СертификатДоменаПользователяИстекаетВ - ТекущаяДата() < 10*24*60*60;
КонецФункции

Функция СостояниеДоменаПользователяЕстьПроблема(СостояниеДоменаПользователя) Экспорт
	Возврат Не (СостояниеДоменаПользователя = Маг1СПеречисления.СостоянияДоменаПользователя_Ready()
				Или СостояниеДоменаПользователя = Маг1СПеречисления.СостоянияДоменаПользователя_ValidatingDns()
				Или СостояниеДоменаПользователя = Маг1СПеречисления.СостоянияДоменаПользователя_ValidatingCertificate()
				Или СостояниеДоменаПользователя = Маг1СПеречисления.СостоянияДоменаПользователя_AquiringCertificate());
КонецФункции
			
