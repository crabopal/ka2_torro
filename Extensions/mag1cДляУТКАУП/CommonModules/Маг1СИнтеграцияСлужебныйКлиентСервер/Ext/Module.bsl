КонецФункции

Функция ИмяПользователяСоцсетиСоотвествуетПравилам(ИмяПользователяСоцСети) Экспорт
	
	Возврат ТолькоЛатиницаВСтроке(ИмяПользователяСоцСети, "1234567890_+.-");

КонецФункции

Функция ТолькоЛатиницаВСтроке(Знач СтрокаПроверки, ДопустимыеСимволы = "")
	
	Если ТипЗнч(СтрокаПроверки) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрДлина(СтрокаПроверки) = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	КодыДопустимыхСимволов = Новый Массив;
	
	Для Индекс = 1 По СтрДлина(ДопустимыеСимволы) Цикл
		КодыДопустимыхСимволов.Добавить(КодСимвола(Сред(ДопустимыеСимволы, Индекс, 1)));
	КонецЦикла;
	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		КодСимвола = КодСимвола(Сред(СтрокаПроверки, Индекс, 1));
		Если ((КодСимвола < 65) Или (КодСимвола > 90 И КодСимвола < 97) Или (КодСимвола > 122))
			И (КодыДопустимыхСимволов.Найти(КодСимвола) = Неопределено) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ИдентификаторНовойВитрины() Экспорт
	Возврат "ИД_Новая";
КонецФункции

Функция КлючСпискаВитрин(ИдентификаторВитрины) Экспорт
	Если ПустаяСтрока(ИдентификаторВитрины) 
		Или ИдентификаторВитрины = ИдентификаторНовойВитрины() Тогда
		Возврат ИдентификаторНовойВитрины();
	КонецЕсли;
	Возврат "ИД_" + СтрЗаменить(ИдентификаторВитрины, "-", "_");
КонецФункции

Функция МожноОбновитьНастройки(СтрокаСпискаВитрин)Экспорт
	Возврат (СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Ready()
		Или СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Blocked())	
КонецФункции

Функция НужноОтметитьАктивностьВитрины(СтрокаСпискаВитрин)Экспорт
	Возврат СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Blocked();	
КонецФункции

Функция НужноОбновитьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Экспорт
	СтатусТокена = СтатусТокенаПлатежнойСистемы(СтрокаСпискаВитрин, ПлатежнаяСистема);
	Возврат СтатусТокена = Маг1СПеречисления.СтатусыТокенаПлатежныхСистем_NeedToReceive()
			или СтатусТокена = Маг1СПеречисления.СтатусыТокенаПлатежныхСистем_NeedToRevoke();
КонецФункции

Функция НужноОбновитьТокеныДоступаКПлатежнымСистемам(СтрокаСпискаВитрин) Экспорт
	
	ПлатежныеСистемыВитрины = Маг1СПеречисления.ПлатежныеСистемыПорядок();
	
	Для каждого ПлатежнаяСистема из ПлатежныеСистемыВитрины Цикл
		Если НужноОбновитьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция НужноОтозватьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Экспорт
	СтатусТокена = СтатусТокенаПлатежнойСистемы(СтрокаСпискаВитрин, ПлатежнаяСистема);

	Возврат СтатусТокена = Маг1СПеречисления.СтатусыТокенаПлатежныхСистем_NeedToRevoke();
КонецФункции

Функция НетТокенаДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Экспорт
	СтатусТокена = СтатусТокенаПлатежнойСистемы(СтрокаСпискаВитрин, ПлатежнаяСистема);
	
	Возврат СтатусТокена = Маг1СПеречисления.СтатусыТокенаПлатежныхСистем_NotNeeded();
КонецФункции

Функция СтатусТокенаПлатежнойСистемы(СтрокаСпискаВитрин, ПлатежнаяСистема)
	Если ПлатежнаяСистема = Маг1СПеречисления.ПлатежныеСистемы_u_kassa() Тогда
		СтатусТокена = СтрокаСпискаВитрин.СтатусТокенаЮКассы;
	ИначеЕсли ПлатежнаяСистема = Маг1СПеречисления.ПлатежныеСистемы_sbp() Тогда
		СтатусТокена = СтрокаСпискаВитрин.СтатусТокенаСБП;
	Иначе
		ТекстИсключения = НСтр("ru = 'Не известный идентификатор платежной системы %ПлатежнаяСистема'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ПлатежнаяСистема", ПлатежнаяСистема);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Возврат СтатусТокена;
КонецФункции

Функция СозданиеВитриныОтложено(СтрокаСпискаВитрин) Экспорт
	Возврат СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Deferred(); 	
КонецФункции

Функция ВитринаПомещенаВАрхив(СтрокаСпискаВитрин) Экспорт

	Возврат СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Suspended();
КонецФункции

Функция ОшибкаВыполненияОперацииСВитриной(СтрокаСпискаВитрин) Экспорт
	Возврат СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Error(); 	
КонецФункции

Функция СтрокаВДату(Значение) Экспорт
	Если ПустаяСтрока(Значение) Тогда
		Возврат '00010101000000';
	КонецЕсли;
	
	Попытка
		Возврат Дата(СокрЛП(Значение));
	Исключение
		Возврат '00010101000000';
	КонецПопытки;
КонецФункции

Функция СтруктураНастройкиСвойстваТовара() Экспорт
	Результат = Новый Структура();
	Результат.Вставить("СвойствоТовара", Неопределено);
	Результат.Вставить("ИспользоватьДляФильтра", Ложь);
	Результат.Вставить("Порядок", 0);
	
	Возврат Результат;
КонецФункции

Функция ТекстУсловийВСчетеНаОплату() Экспорт
	Возврат НСтр("ru = 'Внимание! Счет действителен в течение 5-ти рабочих дней.
                      |Оплата данного счета означает согласие с условиями поставки товара.
                      |Уведомление об оплате обязательно, в противном случае не гарантируется наличие товара на складе.
                      |Товар отпускается по факту прихода денег на р/с Поставщика, самовывозом, при наличии доверенности и паспорта.'");
КонецФункции

Функция ЕдинственноеЗначение(Коллекция) Экспорт
	Если Не (ТипЗнч(Коллекция) = Тип("Массив")
		Или ТипЗнч(Коллекция) = Тип("Структура")
		Или ТипЗнч(Коллекция) = Тип("Соответствие")) Тогда
		ТекстИсключения = НСтр("ru = 'Получение единственного значения для типа %Тип не поддерживается.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Тип", Строка(ТипЗнч(Коллекция)));
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если Коллекция.Количество() <> 1 Тогда
		ВызватьИсключение НСтр("ru = 'Для получения единственного значения необходимо, чтобы в коллекции был 1 элемент'");
	КонецЕсли;
	
	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Возврат Коллекция[0];
		
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура")
		Или ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		
		Для Каждого КлючЗначение Из Коллекция Цикл
			Возврат КлючЗначение.Значение;
		КонецЦикла;
		
	КонецЕсли;
КонецФункции

Функция РасширенияИзображений() Экспорт
	
	Массив = Новый Массив();
	Массив.Добавить("bmp");
	Массив.Добавить("gif");
	Массив.Добавить("jpeg");
	Массив.Добавить("jpg");
	Массив.Добавить("ico");
	Массив.Добавить("svg");
	Массив.Добавить("png");
	Массив.Добавить("wmf");
	Массив.Добавить("tif");
	Массив.Добавить("tiff");
	
	Возврат Массив;
	
КонецФункции

Функция РасширениеИзИмениФайла(ИмяФайла) Экспорт
	
	ПозицияТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	
	Если ПозицияТочки = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Расширение = Прав(ИмяФайла, СтрДлина(ИмяФайла) - ПозицияТочки);
	
	Возврат Расширение;
КонецФункции

