#Область СлужебныеПроцедурыИФункции

Функция ФильтрФайловИзображений() Экспорт
	
	Расширения = Маг1СИнтеграцияСлужебныйКлиентСервер.РасширенияИзображений();
	
	ТекстОписания = СтрСоединить(Расширения, ";*.");
	
	ТекстФильтра = НСтр("ru = 'Все картинки (*.%ТекстОписания%)|*.%ТекстОписания%'");
	
	ТекстФильтра = СтрЗаменить(ТекстФильтра,"%ТекстОписания%", ТекстОписания);
	
	Возврат ТекстФильтра;
КонецФункции

Функция ВопросОтключениеБезопасногоРежимаРасширенияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		ПерейтиПоНавигационнойСсылке("e1cib/app/ОбщаяФорма.Расширения");
	КонецЕсли;
	
КонецФункции

Процедура ПоказатьПредупреждениеСДействиями(
		Владелец,
		ТекстПредупреждения,
		Заголовок = "",
		ОбработчикиСсылок = Неопределено,
		Оповещение = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстПредупреждения", ТекстПредупреждения);
	
	Если ЗначениеЗаполнено(Заголовок) Тогда
		ПараметрыФормы.Вставить("Заголовок", Заголовок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбработчикиСсылок) Тогда
		ПараметрыФормы.Вставить("ОбработчикиСсылок", ОбработчикиСсылок);
	КонецЕсли;
	
	Если Оповещение <> Неопределено Тогда
		ОткрытьФорму("ОбщаяФорма.ФормаПредупрежденияСДействиями",
					ПараметрыФормы,
					Владелец,
					,
					,
					,
					Оповещение);
	Иначе
		ОткрытьФорму("ОбщаяФорма.ФормаПредупрежденияСДействиями", ПараметрыФормы, Владелец);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия) Экспорт
	
	ИмяФормыЖурналаРегистрации = "Обработка.ЖурналРегистрации.Форма";
	
	Отбор = Новый Структура;
	
	Если ТипЗнч(ПараметрыСобытия) = Тип("Структура") Тогда
		Если ПараметрыСобытия.Свойство("СобытиеЖурналаРегистрации") Тогда
			Отбор.Вставить("СобытиеЖурналаРегистрации", ПараметрыСобытия.СобытиеЖурналаРегистрации);
		КонецЕсли;
		Если ПараметрыСобытия.Свойство("ДатаНачала") Тогда
			Отбор.Вставить("ДатаНачала", ПараметрыСобытия.ДатаНачала);
		КонецЕсли;
		Если ПараметрыСобытия.Свойство("ДатаОкончания") Тогда
			Отбор.Вставить("ДатаОкончания", ПараметрыСобытия.ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	
	Если Не Отбор.Свойство("ДатаНачала") Тогда
		Отбор.Вставить("ДатаНачала", НачалоДня(ТекущаяДата()));
	КонецЕсли;
	
	Если Не Отбор.Свойство("Уровень") Тогда
		Отбор.Вставить("Уровень", "Ошибка");
	КонецЕсли;
	
	ОткрытьФорму(ИмяФормыЖурналаРегистрации, Отбор, ЭтотОбъект);
	
КонецПроцедуры

Процедура ОткрытьФормуМастераУстановкиЦен(НастройкиВитрины, НастройкиУчетнойСистемы, Режим, ОповещениеОЗакрытии, ВладелецФормы) Экспорт
	ПараметрыФормы = Маг1СИнтеграцияСлужебныйВызовСервера.ПараметрыФормыМастераУстановкиЦен(НастройкиВитрины, НастройкиУчетнойСистемы, Режим);
	
	Если ПараметрыФормы.Свойство("Маг1с_ТекстОшибки") Тогда
		ПоказатьПредупреждение(, ПараметрыФормы.Маг1с_ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(НастройкиУчетнойСистемы.ИмяФормыМастераУстановкиЦен,
		         ПараметрыФормы,
				 ВладелецФормы,
				 ,
				 ,
				 ,
				 ОповещениеОЗакрытии,
				  );
	
	Если ПараметрыФормы.Маг1С_НоменклатураДляУстановкиЦен.Количество() = 500 Тогда
		ТекстПредупреждения = НСтр("ru = 'Показаны первые 500 товаров'");
		ПоказатьПредупреждение(,ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

#Область РаботаСДлительнымиОперациями

Процедура ПриНачалеВыполненияДлительнойОперации(
		Форма,
		ФоновоеЗадание,
		ОповещениеПриВыполнении,
		ОповещениеПриОшибке,
		ОповещениеОПрогрессе = Неопределено) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма",      Форма);
	ДополнительныеПараметры.Вставить("Оповещения", Новый Структура);
	
	ДополнительныеПараметры.Оповещения.Вставить("ПриВыполнении", ОповещениеПриВыполнении);
	ДополнительныеПараметры.Оповещения.Вставить("ПриОшибке",     ОповещениеПриОшибке);
	
	СлужебноеОповещениеОЗавершении = Новый ОписаниеОповещения("ПриЗавершенииВыполненияДлительнойОперации", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ФоновоеЗадание.Статус = "Выполняется" Тогда
		Форма.ИдентификаторЗадания = ФоновоеЗадание.ИдентификаторЗадания;
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		Если ОповещениеОПрогрессе <> Неопределено Тогда
			ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
			ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = ОповещениеОПрогрессе;
		КонецЕсли;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ФоновоеЗадание, СлужебноеОповещениеОЗавершении, ПараметрыОжидания);
	Иначе
		ИдентификаторЗадания = Неопределено;
		
		ВыполнитьОбработкуОповещения(СлужебноеОповещениеОЗавершении, ФоновоеЗадание);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗавершенииВыполненияДлительнойОперации(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Форма.ИдентификаторЗадания = Неопределено;
		
	Если ФоновоеЗадание = Неопределено Тогда // Отменено
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещения.ПриОшибке, ФоновоеЗадание);
	ИначеЕсли ФоновоеЗадание.Статус = "Выполнено" Тогда
		РезультатыВыполнения = ПолучитьИзВременногоХранилища(ФоновоеЗадание.АдресРезультата);
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещения.ПриВыполнении, РезультатыВыполнения);
	Иначе // Ошибка
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещения.ПриОшибке, ФоновоеЗадание);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьИнтервалОжидания(ИнтервалОжидания) Экспорт
	
	ИнтервалОжидания = Мин(30, Окр(ИнтервалОжидания * 1.4, 1));
	
КонецПроцедуры

#КонецОбласти

Процедура ПодключитьОбработчикДействияСистемыВзаимодействий() Экспорт
	Если Не СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьНажатиеНавигационнойСсылки",
													ЭтотОбъект);
													
	СистемаВзаимодействия.ПодключитьОбработчикДействияСообщения(ОписаниеОповещения);	
КонецПроцедуры

Процедура ОбработатьНажатиеНавигационнойСсылки(Сообщение, Действие, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Действие) = Тип("Структура")
		И Действие.Свойство("ЭтоСообщениеВитриныМаг1с") Тогда
		
		ПерейтиПоНавигационнойСсылке(Действие.НавигационнаяСсылка);
	КонецЕсли;
КонецПроцедуры

Процедура ПоказатьПредупреждениеОбОшибке(СообщениеОбОшибке = "", ПараметрыСобытия = Неопределено) Экспорт
	
	ТекстПредупреждения = "";
	Если Не ПустаяСтрока(СообщениеОбОшибке) Тогда
		ТекстПредупреждения = СообщениеОбОшибке;
	Иначе
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = 'При выполнении действия возникла ошибка.
			|
			|Подробности см. в <a href=""ЖурналРегистрации"">журнале регистрации</a>.'"));
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПоказатьПредупреждениеОбОшибкеЗавершение", ЭтотОбъект);
	
	ОбработчикиСсылок = Новый Структура;
	ОбработчикиСсылок.Вставить("ЖурналРегистрации", ПараметрыСобытия);
	
	ПоказатьПредупреждениеСДействиями(
		ЭтотОбъект,
		ТекстПредупреждения,
		НСтр("ru = 'Что-то пошло не так :('"),
		ОбработчикиСсылок,
		Оповещение);
	
КонецПроцедуры

Процедура ПоказатьПредупреждениеОбОшибкеЗавершение(ПараметрыСобытия, ДополнительныеПараметры) Экспорт
	
	Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);	
	
КонецПроцедуры

Процедура ОтправитьСообщениеВТехПоддержку(ИдентификаторВитрины, Знач ИмяВитрины, Знач ЛогинИПП, Тема, Текст, Вложения = Неопределено) Экспорт
	
	ПараметрыОбращенияВТехПоддержку = Маг1СИнтеграцияСлужебныйВызовСервера.ПараметрыОбращенияВТехПоддержку(ИдентификаторВитрины);
	
	Если Не ЗначениеЗаполнено(ЛогинИПП) Тогда
		ЛогинИПП = ПараметрыОбращенияВТехПоддержку.ЛогинИПП;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяВитрины) Тогда
		ИмяВитрины = ПараметрыОбращенияВТехПоддержку.ИмяВитрины;
	КонецЕсли;
	
	Текст = Текст + Символы.ПС  + Символы.ПС + НСтр("ru = '<Описание проблемы>'") + Символы.ПС  + Символы.ПС;
	
	Если Не ПустаяСтрока(ИмяВитрины) Тогда
		Текст = Текст + Символы.ПС + НСтр("ru = 'Имя веб-витрины: %ИмяВитрины'");
	КонецЕсли;	
	
	Текст = Текст + Символы.ПС + НСтр("ru = 'Версия мастера подключения к веб-витрине: %Версия'");

	Если ЗначениеЗаполнено(ПараметрыОбращенияВТехПоддержку.ИНН) Тогда
		Текст = Текст + Символы.ПС + НСтр("ru = 'ИНН: %ИНН'");
	КонецЕсли;	
	
	Если ПараметрыОбращенияВТехПоддержку.ОписаниеКонфигурации.ЗначениеРазделителяСеанса <> 0 Тогда
		Текст = Текст + Символы.ПС + НСтр("ru = 'Область данных: %ЗначениеРазделителяСеанса'");
	КонецЕсли;	
	
	Текст = Текст + Символы.ПС + НСтр("ru = 'Идентификатор информационной базы: %ИдентификаторИБ'");
	
	Текст = СтрЗаменить(Текст, "%ИмяВитрины", ИмяВитрины);
	Текст = СтрЗаменить(Текст, "%Версия", ПараметрыОбращенияВТехПоддержку.ОписаниеКонфигурации.ВерсияРасширения);
	Текст = СтрЗаменить(Текст, "%ЗначениеРазделителяСеанса", ПараметрыОбращенияВТехПоддержку.ОписаниеКонфигурации.ЗначениеРазделителяСеанса);
	Текст = СтрЗаменить(Текст, "%ИдентификаторИБ", ПараметрыОбращенияВТехПоддержку.ОписаниеКонфигурации.ИдентификаторИБ);
	Текст = СтрЗаменить(Текст, "%ИНН", ПараметрыОбращенияВТехПоддержку.ИНН);
	
	Попытка
		ОбщегоНазначенияКлиент.ОбщийМодуль("СообщенияВСлужбуТехническойПоддержкиКлиент");
		ЕстьМодульСообщенияВСлужбуТехническойПоддержкиКлиент = Истина;
	Исключение
		ЕстьМодульСообщенияВСлужбуТехническойПоддержкиКлиент = Ложь;
	КонецПопытки;
	
	Если Не ЕстьМодульСообщенияВСлужбуТехническойПоддержкиКлиент Тогда
		ОбщийМодульИнтернетПоддержкаПользователейКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтернетПоддержкаПользователейКлиент");
		
		НастройкиСоединенияССерверами = ОбщийМодульИнтернетПоддержкаПользователейКлиент.НастройкиСоединенияССерверами();
		
		ОбщийМодульИнтернетПоддержкаПользователейКлиент.ОтправитьСообщениеВТехПоддержку(
			Тема,
			Текст,
			,
			Вложения,
			Новый Структура("Логин, НастройкиСоединенияССерверами",
				ЛогинИПП,
				НастройкиСоединенияССерверами));
	Иначе
		
		ОбщийМодульСообщенияВСлужбуТехническойПоддержкиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("СообщенияВСлужбуТехническойПоддержкиКлиент");
		
		ДанныеСообщения = Новый Структура;
		ДанныеСообщения.Вставить("Тема", Тема);
		ДанныеСообщения.Вставить("Сообщение", Текст);
		ДанныеСообщения.Вставить("Получатель", "webIts");
		
		Попытка
			ОбщийМодульСообщенияВСлужбуТехническойПоддержкиКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("СообщенияВСлужбуТехническойПоддержкиКлиентСервер");
			ДанныеСообщенияШаблон = ОбщийМодульСообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения();
			ЗаполнитьЗначенияСвойств(ДанныеСообщенияШаблон,ДанныеСообщения);
			ДанныеСообщенияШаблон.ИНН = ПараметрыОбращенияВТехПоддержку.ИНН;
			ДанныеСообщения = ДанныеСообщенияШаблон;
		Исключение
		КонецПопытки;
		
		ВложенияДляОтправки = Неопределено;
		
		Если Вложения <> Неопределено
			И Вложения.Количество() > 0 Тогда
			
			Вложение = Новый Структура;
			Вложение.Вставить("Представление", Вложения[0].Представление);
			Вложение.Вставить("ВидДанных", "Адрес");
			Вложение.Вставить("Данные", Вложения[0].Адрес);
			
			ВложенияДляОтправки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);
		КонецЕсли;
		
		ОбщийМодульСообщенияВСлужбуТехническойПоддержкиКлиент.ОтправитьСообщение(ДанныеСообщения, ВложенияДляОтправки);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ОчиститьЛокальныйКешНастроек(Оповещение) Экспорт	
	
	ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = '<span style="""">После очистки настроек работа мастера будет завершена.
		|При следующем открытии мастера настройки восстановятся по данным сервера витрин.
		|Очистить локальный кеш настроек работы с витриной?</span>'"));
		
	КнопкиДиалога = Новый СписокЗначений;
	КнопкиДиалога.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Очистить'"));
	КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена);
	
	ПоказатьВопрос(Оповещение, ТекстПредупреждения, КнопкиДиалога); 
	
КонецПроцедуры

Функция АдресПриложенияВИнтернете()
	
	ПараметрыСоединения = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	
	Если Не ПараметрыСоединения.Свойство("ws") Тогда
		Возврат "";
	Иначе	
		Возврат ПараметрыСоединения.ws;
	КонецЕсли;
	
КонецФункции

#Область ОткрытьФормуПолученияИнформацииПоПрофилю

Процедура ОткрытьФормуПолученияИнформацииПоПрофилю(ПараметрыФормыПрофиля)
	
	ОткрытьФорму("Обработка.Маг1СОбмен.Форма.ПолучениеИнформацииПоПрофилю",
		ПараметрыФормыПрофиля,
		,
		,
		,
		,
		Новый ОписаниеОповещения("ОткрытьФормуНастройкиВитрины", ЭтотОбъект, ПараметрыФормыПрофиля));
		// );
		
КонецПроцедуры

Процедура ОбработкаКомандыОткрытьФормуПолученияИнформацииПоПрофилю() Экспорт

	ПараметрыФормыПрофиля = Маг1СИнтеграцияСлужебныйВызовСервера.ПараметрыФормыПолученияИнформацииПоПрофилю(АдресПриложенияВИнтернете());		
	
	Если Не ПараметрыФормыПрофиля.ЕстьПользователи Тогда	
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для создания и настройки витрины необходимо, чтобы вход в программу осуществлялся с указанием пользователя.</span>'"));
			
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Создать пользователя ""Администратор""'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Команда", Маг1СПеречисления.ПараметрыПерезапускаСистемы_Мастер());
		ДополнительныеПараметры.Вставить("Параметр", Неопределено);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтветНаВопросОСозданииПользователя", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения,ТекстПредупреждения, СписокКнопок); 
		Возврат;
	КонецЕсли;
	
	Если Не ПараметрыФормыПрофиля.ЕстьПравоНастройкиВитрины Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для создания и настройки витрины необходимо, чтобы у вас была роль ""Маг1С: Настройка витрины"". Обратитесь, пожалуйста, к администратору.</span>'"));
				
		ПоказатьПредупреждение(,ТекстПредупреждения); 
		Возврат;
	КонецЕсли;
		
	Если Не ПараметрыФормыПрофиля.ЕстьПравоВыполененияОбмена Тогда	
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для создания и настройки витрины необходимо, чтобы у вас была роль ""Выполнение синхронизации данных"". У вас такой роли нет. Обратитесь, пожалуйста, к администратору.</span>'"));
				
		ПоказатьПредупреждение(,ТекстПредупреждения); 
		Возврат;
	КонецЕсли;
	
	Если ПараметрыФормыПрофиля.АутентификацияИППВыполнена Тогда
		ОткрытьФормуПолученияИнформацииПоПрофилю(ПараметрыФормыПрофиля);	
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуПолученияИнформацииПоПрофилюПослеВводаЛогина",
													  Маг1СИнтеграцияСлужебныйКлиент,
													  ПараметрыФормыПрофиля);
		ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(ОписаниеОповещения);											  
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтветНаВопросОСозданииПользователя(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебныйВызовСервера.СоздатьПользователяАдминистратор();
	
	ПерезапуститьСистему(ДополнительныеПараметры.Команда, ДополнительныеПараметры.Параметр)

КонецПроцедуры

Процедура ОткрытьФормуПолученияИнформацииПоПрофилюПослеВводаЛогина(ЛогинИПП, ПараметрыФормыПрофиля) Экспорт
	
	Если ЛогинИПП = Неопределено
		Или (ТипЗнч(ЛогинИПП) <> Тип("Структура")
			 И ТипЗнч(ЛогинИПП) <> Тип("Строка"))Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЛогинИПП) = Тип("Структура") Тогда
		ЛогинИПП = ЛогинИПП.Логин;
	КонецЕсли;
	
	ПараметрыФормыПрофиля.АутентификацияИППВыполнена = Истина;
	ПараметрыФормыПрофиля.ЛогинИПП 					 = ЛогинИПП;
	
	ОткрытьФормуПолученияИнформацииПоПрофилю(ПараметрыФормыПрофиля);
	
КонецПроцедуры

Процедура ОткрытьФормуНастройкиВитрины(Результат, ПараметрыФормыПрофиля) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыНастройки = Новый Структура;
	ПараметрыФормыНастройки.Вставить("СтрокаСпискаВитрин", Результат.СтрокаСпискаВитрин);
	ПараметрыФормыНастройки.Вставить("ПрофильПользователя", Результат.ПрофильПользователя);
	ПараметрыФормыНастройки.Вставить("ЛогинИПП", ПараметрыФормыПрофиля.ЛогинИПП);
	ПараметрыФормыНастройки.Вставить("РежимФормы", Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин());
	
	Если Результат.СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		ОткрытьФорму("Обработка.Маг1СНастройка.Форма.МастерНастройкиВитрины",
			ПараметрыФормыНастройки,
			,
			,
			,
			,
			Новый ОписаниеОповещения("ОткрытьФормуПолученияИнформацииПоПрофилюПриЗакрытииФормыНастройки", ЭтотОбъект, ПараметрыФормыПрофиля));
	Иначе	
		ОткрытьФорму("Обработка.Маг1СОбмен.Форма.НастройкаСтраницыMag1c",
			ПараметрыФормыНастройки,
			,
			,
			,
			,
			,
			 );
    КонецЕсли;
КонецПроцедуры

Процедура ОткрытьФормуПолученияИнформацииПоПрофилюПриЗакрытииФормыНастройки(Результат, ПараметрыФормыПрофиля) Экспорт
	
	Если Результат <> Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыПрофиля.ПоказатьСписокДругихВитрин = Истина;
	ОткрытьФормуПолученияИнформацииПоПрофилю(ПараметрыФормыПрофиля);
	
КонецПроцедуры

#КонецОбласти

#Область ОткрытьФормуПолученияИнвайта 

Процедура ОткрытьФормуПолученияИнвайта(Ссылка, ПараметрыКоманды) Экспорт
	ПараметрыОткрытияФормыИнвайта = Маг1СИнтеграцияСлужебныйВызовСервера.ПараметрыОткрытияФормыИнвайта(Ссылка);
	
	Если Не ПараметрыОткрытияФормыИнвайта.ЕстьВитрина Тогда
		Если ПараметрыОткрытияФормыИнвайта.ЕстьПравоНастройкиВитрины Тогда
			ОбработкаКомандыОткрытьФормуПолученияИнформацииПоПрофилю();
		Иначе
			ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">К базе не подключена ни одна витрина mag1c. Для создания и настройки витрины необходимо, чтобы у вас была роль ""Маг1С: Настройка витрины"". Обратитесь, пожалуйста, к администратору.</span>'"));
					
			ПоказатьПредупреждение(,ТекстПредупреждения); 
		КонецЕсли;
		Возврат;
	ИначеЕсли Не ПараметрыОткрытияФормыИнвайта.ЕстьПравоВыполененияОбмена Тогда	
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для получения инвайта необходимо, чтобы у вас была роль ""Выполнение синхронизации данных"". У вас такой роли нет. Обратитесь, пожалуйста, к администратору.</span>'"));
				
		ПоказатьПредупреждение(,ТекстПредупреждения); 
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОткрытияФормыИнвайта.Контрагенты.Количество() = 0 Тогда
		
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выберите строку, по которой необходимо получить инвайт.</span>'"));
				
		ПоказатьПредупреждение(,ТекстПредупреждения); 
		Возврат;
		
	ИначеЕсли ПараметрыОткрытияФормыИнвайта.Контрагенты.Количество() = 1 Тогда
		ОткрытьФорму("Обработка.Маг1СРаботаСИнвайтами.Форма.Инвайт",
					Новый Структура("Контрагент,РежимФормы",
									ПараметрыОткрытияФормыИнвайта.Контрагенты[0], 
									Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин()),
					ПараметрыКоманды.Источник);
	Иначе
		ОткрытьФорму("Обработка.Маг1СРаботаСИнвайтами.Форма.РаботаСКонтрагентами",
					Новый Структура("Контрагенты", ПараметрыОткрытияФормыИнвайта.Контрагенты),
					ПараметрыКоманды.Источник);
	КонецЕсли;				
КонецПроцедуры

#КонецОбласти

#Область ОткрытьФормуВременнойСсылки 

Процедура ОткрытьФормуВременнойСсылки(ПараметрыФормыСсылки)
	
	ОткрытьФорму("Обработка.Маг1СОбмен.Форма.ПолучениеИнформацииПоПрофилю",
		ПараметрыФормыСсылки,
		,
		,
		,
		,
		Новый ОписаниеОповещения("ОткрытьФормуВременнойСсылкиПриЗавершении", ЭтотОбъект, ПараметрыФормыСсылки),
		 );	
		
КонецПроцедуры

Процедура ОткрытьФормуВременнойСсылкиОбработкаКоманды(Ссылка, ПараметрыКоманды) Экспорт
	
	ПараметрыФормыСсылки = Маг1СИнтеграцияСлужебныйВызовСервера.ПараметрыФормыПолученияСсылки(Ссылка, АдресПриложенияВИнтернете());
	
	Если ПараметрыФормыСсылки.ЕстьПодсистемаОнлайнЗаказов Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для формирования ссылки на заказ необходимо воспользоваться сервисом ""1С:Онлайн-заказы"". Получить подробную информацию о сервисе можно на <a href=""https://portal.1c.ru/applications/1C-Online-Orders"">странице Портала ИТС</a></span>'"));
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если Не ПараметрыФормыСсылки.ЕстьПользователи Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для создания и настройки витрины необходимо, чтобы вход в программу осуществлялся с указанием пользователя.</span>'"));
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Создать пользователя ""Администратор""'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Команда", Маг1СПеречисления.ПараметрыПерезапускаСистемы_ПолучениеСсылки());
		ДополнительныеПараметры.Вставить("Параметр", Ссылка);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтветНаВопросОСозданииПользователя", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения,ТекстПредупреждения, СписокКнопок);
		Возврат;
	КонецЕсли;
	
	Если Не ПараметрыФормыСсылки.ЕстьПравоВыполененияОбмена Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для получения ссылки необходимо, чтобы у вас была роль ""Выполнение синхронизации данных"". У вас такой роли нет. Обратитесь, пожалуйста, к администратору.</span>'"));
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если Не ПараметрыФормыСсылки.Проведен Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Перед получением ссылки документ должен быть проведен.</span>'"));
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыФормыСсылки.ЯвляетсяПлательщикомНДС
		И Не ПараметрыФормыСсылки.СуммаВключаетНДС Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Поддерживается получение ссылки только по документам, где сумма документа включает НДС.</span>'"));
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыФормыСсылки.АутентификацияИППВыполнена Тогда
		ОткрытьФормуВременнойСсылки(ПараметрыФормыСсылки);
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуВременнойСсылкиПослеВводаЛогина",
													  Маг1СИнтеграцияСлужебныйКлиент,
													  ПараметрыФормыСсылки);
		ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуВременнойСсылкиПослеВводаЛогина(ЛогинИПП, ПараметрыФормыСсылки) Экспорт
	ПараметрыФормыСсылки.АутентификацияИППВыполнена = Истина;
	
	Если ЛогинИПП = Неопределено
		Или (ТипЗнч(ЛогинИПП) <> Тип("Структура")
			 И ТипЗнч(ЛогинИПП) <> Тип("Строка"))Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЛогинИПП) = Тип("Структура") Тогда
		ЛогинИПП = ЛогинИПП.Логин;
	КонецЕсли;

	ПараметрыФормыСсылки.ЛогинИПП                   = ЛогинИПП;
	ОткрытьФормуВременнойСсылки(ПараметрыФормыСсылки);
КонецПроцедуры

Процедура ОткрытьФормуВременнойСсылкиПриЗавершении(Результат, ПараметрыФормыСсылки) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из Результат Цикл
		Если ПараметрыФормыСсылки.Свойство(КлючЗначение.Ключ) Тогда 
			ПараметрыФормыСсылки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрыФормыСсылки.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_СоздатьПриложение()Тогда 
		
		ПараметрыФормыСсылки.Вставить("РежимФормы", Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки());
		
		ОткрытьФорму("Обработка.Маг1СОбмен.Форма.НастройкаСтраницыMag1c",
			ПараметрыФормыСсылки,
			,
			,
			,
			,
			Новый ОписаниеОповещения("ОткрытьФормуВременнойСсылкиПриЗавершении", ЭтотОбъект, ПараметрыФормыСсылки),
			 );
		
	ИначеЕсли Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку()Тогда
				
		ОткрытьФорму("Обработка.Маг1СОбмен.Форма.ПолучениеСсылки",
			ПараметрыФормыСсылки,
			,
			,
			,
			,
			,
			 );
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ПерезапуститьСистему(Знач КомандаПерезапуска, Параметр = Неопределено) Экспорт
	
	Если Параметр <> Неопределено Тогда
		Ид = Строка(Параметр.УникальныйИдентификатор());
		КомандаПерезапуска = КомандаПерезапуска + "_" + Ид + "_";
	КонецЕсли;
	
	ЗавершитьРаботуСистемы(Ложь, Истина, "/C " + КомандаПерезапуска);

КонецПроцедуры

Функция ПоддержимаетсяРаботаСБуферомОбмена() Экспорт
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, "8.3.24.0") < 0 Тогда
		Возврат Ложь;
	Иначе
		// АПК:488-выкл расширение работает в безопасном режиме
		БуферОбмена = Вычислить("СредстваБуфераОбмена");
		// АПК:488-вкл
		Возврат БуферОбмена.ИспользованиеДоступно();
	КонецЕсли;
КонецФункции

Процедура ПоместитьВБуферОбмена(Текст) Экспорт
	Если Не ПоддержимаетсяРаботаСБуферомОбмена() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Работа с буфером обмена не поддерживается.'"),
										,
										,
										БиблиотекаКартинок.Маг1СПредупреждение32,
										СтатусОповещенияПользователя.Важное);
		Возврат;
	КонецЕсли;	
	// АПК:488-выкл расширение работает в безопасном режиме
	БуферОбмена         = Вычислить("СредстваБуфераОбмена");
