	Возврат Метаданные.Перечисления[ПеречислениеСтавкиНДСИмя].ЗначенияПеречисления.Найти(СтавкиНДСИмя) <> Неопределено
КонецФункции

Функция КодСистемыНалогообложения(Организация, Дата)
	УстановитьПривилегированныйРежим(Истина);
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияERP(), "2.5.5.1") >= 0 Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетнаяПолитикаОрганизацийСрезПоследних.ПрименяетсяУСН КАК ПрименяетсяУСН,
		|	НастройкиУчетаУСНСрезПоследних.ПрименяетсяУСНДоходыМинусРасходы КАК ПрименяетсяУСНДоходыМинусРасходы
		|ИЗ
		|	РегистрСведений.НастройкиСистемыНалогообложения.СрезПоследних(&Период, Организация = ВЫРАЗИТЬ (&Организация КАК Справочник.Организации).ГоловнаяОрганизация) КАК УчетнаяПолитикаОрганизацийСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаУСН.СрезПоследних(&Период, Организация = ВЫРАЗИТЬ (&Организация КАК Справочник.Организации).ГоловнаяОрганизация) КАК НастройкиУчетаУСНСрезПоследних
		|		ПО УчетнаяПолитикаОрганизацийСрезПоследних.Организация = НастройкиУчетаУСНСрезПоследних.Организация"	
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетнаяПолитикаОрганизацийСрезПоследних.ПрименяетсяУСН КАК ПрименяетсяУСН,
		|	УчетнаяПолитикаОрганизацийСрезПоследних.ПрименяетсяУСНДоходыМинусРасходы КАК ПрименяетсяУСНДоходыМинусРасходы
		|ИЗ
		|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних";
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	СтрокаУчетнойПолитики = Запрос.Выполнить().Выбрать();
	
	Если Не СтрокаУчетнойПолитики.Следующий() Тогда
		Возврат 1;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаУчетнойПолитики.ПрименяетсяУСН) <> Тип("Булево")
		Или ТипЗнч(СтрокаУчетнойПолитики.ПрименяетсяУСНДоходыМинусРасходы) <> Тип("Булево") Тогда
		Возврат 1;
	КонецЕсли;
	
	Если СтрокаУчетнойПолитики.ПрименяетсяУСН И СтрокаУчетнойПолитики.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат 3; // УСН
	ИначеЕсли СтрокаУчетнойПолитики.ПрименяетсяУСН И НЕ СтрокаУчетнойПолитики.ПрименяетсяУСНДоходыМинусРасходы Тогда	
		Возврат 2; // УСН
	ИначеЕсли НЕ СтрокаУчетнойПолитики.ПрименяетсяУСН Тогда
		Возврат 1; // ОСН
	Иначе
		Возврат 0;
	КонецЕсли;
		
КонецФункции

Функция КонтрагентПоПараметруКомандыПолученияИнвайта(ПараметрКоманды) Экспорт
	СправочникСсылкаПартнерыИмя = "СправочникСсылка.Партнеры";
	
	Если ТипЗнч(ПараметрКоманды) = Тип(СправочникСсылкаПартнерыИмя) Тогда
		ОбщийМодульПартнерыИКонтрагенты = ОбщегоНазначения.ОбщийМодуль("ПартнерыИКонтрагенты");
		Контрагент = ОбщийМодульПартнерыИКонтрагенты.ПолучитьКонтрагентаПартнераПоУмолчанию(ПараметрКоманды);
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Контрагент);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Процедура ОтменитьЗаказ(ЗаказОбъект, КешЗначений) Экспорт
	ПричинаОтмены = Неопределено;
	ИспользоватьПричиныОтменыЗаказовКлиентовИмя = "ИспользоватьПричиныОтменыЗаказовКлиентов";
	ПричиныОтменыЗаказовКлиентовИмя = "ПричиныОтменыЗаказовКлиентов";
		
	Если Не КешЗначений.Свойство("ПричинаОтмены", ПричинаОтмены) Тогда
		
		
		ИспользоватьПричиныОтменыЗаказовКлиентов = Константы[ИспользоватьПричиныОтменыЗаказовКлиентовИмя].Получить();
		
		
		ПричинаОтмены                            = Справочники[ПричиныОтменыЗаказовКлиентовИмя].ПустаяСсылка();
	
		Если ИспользоватьПричиныОтменыЗаказовКлиентов Тогда
			
			НеобходимоСоздатьЭлемент = Ложь;
			НаименованиеЭлементаПоУмолчанию = НСтр("ru = 'Заказ отменен покупателем (по умолчанию)'");
			
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2
			|	ПричиныОтменаЗаказа.Ссылка КАК Ссылка,
			|	ВЫБОР
			|		КОГДА ПричиныОтменаЗаказа.Наименование = &НаименованиеЭлементаПоУмолчанию
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ЭтоЭлементПоУмолчаниюДляОбмена
			|ИЗ
			|	Справочник.ПричиныОтменыЗаказовКлиентов КАК ПричиныОтменаЗаказа
			|ГДЕ
			|	НЕ ПричиныОтменаЗаказа.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЭтоЭлементПоУмолчаниюДляОбмена УБЫВ");
			
			Запрос.УстановитьПараметр("НаименованиеЭлементаПоУмолчанию", НаименованиеЭлементаПоУмолчанию);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Если Выборка.Количество() = 1
					Или Выборка.ЭтоЭлементПоУмолчаниюДляОбмена Тогда
					ПричинаОтмены = Выборка.Ссылка;
				Иначе
					НеобходимоСоздатьЭлемент = Истина;
				КонецЕсли;
			Иначе
				НеобходимоСоздатьЭлемент = Истина;
			КонецЕсли;
			
			Если НеобходимоСоздатьЭлемент Тогда
				
				ПричиныОтменаЗаказа = Справочники[ПричиныОтменыЗаказовКлиентовИмя].СоздатьЭлемент();
				ПричиныОтменаЗаказа.Наименование = НаименованиеЭлементаПоУмолчанию;
				
				ПричиныОтменаЗаказа.ОбменДанными.Загрузка = Истина;
				ПричиныОтменаЗаказа.Записать();
				ПричинаОтмены = ПричиныОтменаЗаказа.Ссылка;
			КонецЕсли;
		КонецЕсли;
	
		КешЗначений.Вставить("ПричинаОтмены", ПричинаОтмены)
	КонецЕсли;
	
	ЕстьИзменения = Ложь;
	СтатусыЗаказовКлиентовИмя = "СтатусыЗаказовКлиентов";
	ЗаказОбъект.Статус = Перечисления[СтатусыЗаказовКлиентовИмя].Закрыт;
	
	Для Каждого СтрокаТовары Из ЗаказОбъект.Товары Цикл
		
		Если Не СтрокаТовары.Отменено Тогда
			
			ЕстьИзменения = Истина;
			СтрокаТовары.Отменено = Истина;
			
			Если ИспользоватьПричиныОтменыЗаказовКлиентов Тогда
				СтрокаТовары.ПричинаОтмены = ПричинаОтмены;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьИзменения Тогда
		Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.1.1") > 0 Тогда
			ВзаиморасчетыСерверМодуль = ОбщегоНазначения.ОбщийМодуль("ВзаиморасчетыСервер");
			ВзаиморасчетыСерверМодуль.ПроверитьЗаполнитьЭтапыГрафикаОплаты(ЗаказОбъект);
		Иначе
			ЗаказОбъект.ЗаполнитьЭтапыГрафикаОплаты();
		КонецЕсли;
	КонецЕсли;		
	
КонецПроцедуры

Процедура ЗаполнитьДоступныеНастройкиСБП(ДоступныеНастройкиСБП, Организация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	НастройкиИнтеграцииСПлатежнымиСистемамиУТ.Интеграция КАК Интеграция
		|ИЗ
		|	РегистрСведений.НастройкиИнтеграцииСПлатежнымиСистемамиУТ КАК НастройкиИнтеграцииСПлатежнымиСистемамиУТ
		|ГДЕ
		|	НастройкиИнтеграцииСПлатежнымиСистемамиУТ.Договор.Организация = &Организация";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ДоступныеНастройкиСБП = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Интеграция");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РаботаСКаталогомТоваров

Процедура ОписаниеВТЦены(ОписаниеВТЦены)
	
	ИмяФО = "ИспользуетсяЦенообразование25";
	ИспользуетсяЦенообразование25 = Истина;
	Если Метаданные.ФункциональныеОпции.Найти(ИмяФО) = Неопределено Тогда 
		ИспользуетсяЦенообразование25 = Ложь;
	Иначе
		Если НЕ ПолучитьФункциональнуюОпцию(ИмяФО) Тогда 
			ИспользуетсяЦенообразование25 = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.6.1") > 0
		И ИспользуетсяЦенообразование25 Тогда
		
		ОписаниеВТЦены.ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Период КАК Период,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Упаковка КАК Упаковка,
		|	ЦеныНоменклатурыСрезПоследних.ХарактеристикаЦО КАК ХарактеристикаЦО,
		|	ВЫРАЗИТЬ(ЦеныНоменклатурыСрезПоследних.Цена * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) / ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 1) КАК ЧИСЛО(15, 2)) КАК Цена
		|ПОМЕСТИТЬ ВТЦеныДляЗапроса
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(
		|			&ДатаЦен,
		|			ВидЦены = &ВидЦен
		|				И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
		|				И &ФильтрНоменклатуры) КАК ЦеныНоменклатурыСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаЦен, ) КАК КурсыВалютСрезПоследних
		|		ПО ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	ХарактеристикаЦО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТЦеныДляЗапроса.Период КАК Период,
		|	ВТЦеныДляЗапроса.Номенклатура КАК Номенклатура,
		|	ВТЦеныДляЗапроса.Упаковка КАК Упаковка,
		|	ЕСТЬNULL(СпрХарактеристики.Ссылка, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
		|	ВТЦеныДляЗапроса.Цена КАК Цена
		|ПОМЕСТИТЬ ВТЦены
		|ИЗ
		|	ВТЦеныДляЗапроса КАК ВТЦеныДляЗапроса
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристики
		|		ПО (ВЫБОР
		|				КОГДА ВТЦеныДляЗапроса.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
		|						ИЛИ ВТЦеныДляЗапроса.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ПустаяСсылка)
		|					ТОГДА ЛОЖЬ
		|				КОГДА ВТЦеныДляЗапроса.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
		|					ТОГДА ВТЦеныДляЗапроса.Номенклатура.ВидНоменклатуры = СпрХарактеристики.Владелец
		|				КОГДА ВТЦеныДляЗапроса.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
		|					ТОГДА ВТЦеныДляЗапроса.Номенклатура.ВладелецХарактеристик = СпрХарактеристики.Владелец
		|				КОГДА ВТЦеныДляЗапроса.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры)
		|					ТОГДА ВТЦеныДляЗапроса.Номенклатура.Ссылка = СпрХарактеристики.Владелец
		|			КОНЕЦ)
		|			И (ВТЦеныДляЗапроса.ХарактеристикаЦО = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
		|				ИЛИ ВТЦеныДляЗапроса.ХарактеристикаЦО = СпрХарактеристики.ХарактеристикаНоменклатурыДляЦенообразования)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТЦеныДляЗапроса";
		
	Иначе
		ОписаниеВТЦены.ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Период КАК Период,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
		|	ЦеныНоменклатурыСрезПоследних.Упаковка КАК Упаковка,
		|	ВЫРАЗИТЬ(ЦеныНоменклатурыСрезПоследних.Цена * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) / ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 1) КАК ЧИСЛО(15, 2)) КАК Цена
		|ПОМЕСТИТЬ ВТЦены
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&ДатаЦен,
		|			ВидЦены = &ВидЦен
		|				И &ФильтрНоменклатуры) КАК ЦеныНоменклатурыСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаЦен, ) КАК КурсыВалютСрезПоследних
		|		ПО ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта";
	КонецЕсли;
	
	ОписаниеВТЦены.ИмяПоляОтбораНоменклатура = "Номенклатура";
	
КонецПроцедуры

Процедура ОписаниеВТПродажи(ОписаниеВТПродажи)
	ОписаниеВТПродажи.ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПродажиОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ПродажиОбороты.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&ДатаНачалаПродаж, , , &ФильтрНоменклатуры) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.КоличествоОборот > 0";
	ОписаниеВТПродажи.ИмяПоляОтбораНоменклатура = "АналитикаУчетаНоменклатуры.Номенклатура";
КонецПроцедуры

Процедура ОписаниеВТОстатки(ОписаниеВТОстатки)
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.26.1") > 0 Тогда
		ОписаниеВТОстатки.ТекстЗапроса =
		"ВЫБРАТЬ
		|	РаспределениеЗапасов.Номенклатура КАК Номенклатура,
		|	РаспределениеЗапасов.Характеристика КАК Характеристика,
		|	СУММА(РаспределениеЗапасов.Количество) КАК КоличествоНаСкладе
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ
		|	РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
		|ГДЕ
		|	РаспределениеЗапасов.СостояниеЗапаса = ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ВНаличии)
		|   И РаспределениеЗапасов.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|	И (&ПоВсемСкладам
		|			ИЛИ РаспределениеЗапасов.Склад В (&Склады))
		|	И &ФильтрНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	РаспределениеЗапасов.Характеристика,
		|	РаспределениеЗапасов.Номенклатура
		|ИМЕЮЩИЕ 
		|	СУММА(РаспределениеЗапасов.Количество) > 0";
		ОписаниеВТОстатки.ИмяПоляОтбораНоменклатура = "РаспределениеЗапасов.Номенклатура";
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Маг1СИнтеграцияУТ.ВерсияERP(), "2.5.7.1") > 0 Тогда
		ОписаниеВТОстатки.ТекстЗапроса =
		"ВЫБРАТЬ
		|	РаспределениеЗапасов.Номенклатура КАК Номенклатура,
		|	РаспределениеЗапасов.Характеристика КАК Характеристика,
		|	СУММА(РаспределениеЗапасов.Свободно) КАК КоличествоНаСкладе
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ
		|	РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
		|ГДЕ
		|	РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОстатокНаСкладе)
		|   И РаспределениеЗапасов.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|	И (&ПоВсемСкладам
		|			ИЛИ РаспределениеЗапасов.Склад В (&Склады))
		|	И &ФильтрНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	РаспределениеЗапасов.Характеристика,
		|	РаспределениеЗапасов.Номенклатура
		|ИМЕЮЩИЕ 
		|	СУММА(РаспределениеЗапасов.Свободно) > 0";
		ОписаниеВТОстатки.ИмяПоляОтбораНоменклатура = "РаспределениеЗапасов.Номенклатура";
	Иначе
		ОписаниеВТОстатки.ТекстЗапроса =
		"ВЫБРАТЬ
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	СУММА(Таблица.КоличествоНаСкладе) КАК КоличествоНаСкладе
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ
		|	(ВЫБРАТЬ
		|		Набор.Номенклатура КАК Номенклатура,
		|		Набор.Характеристика КАК Характеристика,
		|		Набор.Склад КАК Склад,
		|		СУММА(Набор.КоличествоНаСкладе) КАК КоличествоНаСкладе
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|			ОстаткиТоваров.Характеристика КАК Характеристика,
		|			ОстаткиТоваров.Склад КАК Склад,
		|			ОстаткиТоваров.ВНаличииОстаток - ОстаткиТоваров.ВРезервеСоСкладаОстаток - ОстаткиТоваров.ВРезервеПодЗаказОстаток КАК КоличествоНаСкладе
		|		ИЗ
		|			РегистрНакопления.СвободныеОстатки.Остатки(
		|					,
		|					(&ПоВсемСкладам
		|						ИЛИ Склад В (&Склады))
		|						И &ФильтрНоменклатуры) КАК ОстаткиТоваров
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			РезервыКДате.Номенклатура,
		|			РезервыКДате.Характеристика,
		|			РезервыКДате.Склад,
		|			РезервыКДате.Количество
		|		ИЗ
		|			РегистрСведений.ДоступныеОстаткиПланируемыхПоступлений КАК РезервыКДате
		|		ГДЕ
		|			&ФильтрНоменклатуры
		|			И (&ПоВсемСкладам
		|					ИЛИ РезервыКДате.Склад В (&Склады))
		|			И РезервыКДате.ДатаДоступности = ДАТАВРЕМЯ(1, 1, 1)
		|			И РезервыКДате.Количество < 0) КАК Набор
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Набор.Номенклатура,
		|		Набор.Характеристика,
		|		Набор.Склад) КАК Таблица
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.Номенклатура,
		|	Таблица.Характеристика
		|
		|ИМЕЮЩИЕ
		|	СУММА(Таблица.КоличествоНаСкладе) > 0";
		ОписаниеВТОстатки.ИмяПоляОтбораНоменклатура = "Номенклатура";
	КонецЕсли;
КонецПроцедуры

Процедура ОписаниеВТЗаказыПоставщикам(ОписаниеВТЗаказыПоставщикам)
	ОписаниеВТЗаказыПоставщикам.ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПоставщикамОстатки.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТЗаказыПоставщикам
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, &ФильтрНоменклатуры) КАК ЗаказыПоставщикамОстатки
	|ГДЕ
	|	ЗаказыПоставщикамОстатки.ЗаказаноОстаток > 0";
	ОписаниеВТЗаказыПоставщикам.ИмяПоляОтбораНоменклатура = "Номенклатура";
КонецПроцедуры

Процедура ОписаниеВТСоставСегментаНоменклатуры(ОписаниеВТСоставСегментаНоменклатуры)
	ОписаниеВТСоставСегментаНоменклатуры.ТекстЗапроса =
	"ВЫБРАТЬ
	|	НоменклатураСегмента.Номенклатура КАК Номенклатура,
	|	НоменклатураСегмента.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТСоставСегментаНоменклатуры
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
	|ГДЕ
	|	НоменклатураСегмента.Сегмент = &СегментНоменклатуры
	|	И &ФильтрНоменклатуры";

	ОписаниеВТСоставСегментаНоменклатуры.ИмяПоляОтбораНоменклатура = "НоменклатураСегмента.Номенклатура";
КонецПроцедуры

#КонецОбласти

Процедура Маг1С_ПриЗаписиСправочниковПриЗаписи(Источник, Отказ) Экспорт
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.СоглашенияСКлиентами") Тогда
		СоглашенияСКлиентами_ПриЗаписи(Источник, Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура Маг1С_ПередЗаписьюСправочниковПередЗаписью(Источник, Отказ) Экспорт
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.СоглашенияСКлиентами") Тогда
		СоглашенияСКлиентами_ПередЗаписью(Источник, Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура СоглашенияСКлиентами_ПередЗаписью(Источник, Отказ)
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() 
		И Маг1СИнтеграция.ЭтоОбменСМаг1с() Тогда
		Источник.ЦенаВключаетНДС = Истина;
	КонецЕсли;	
	
	Если Не Отказ Тогда
		Маг1СИнтеграция.ПередЗаписьюДоговора(Источник.ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Процедура СоглашенияСКлиентами_ПриЗаписи(Источник, Отказ)
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Отказ Тогда
		Маг1СИнтеграция.ПриЗаписиДоговора(Источник);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти