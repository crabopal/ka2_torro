	Настройки.ДоговорКонтрагента.Реквизиты.Контрагент  = "Контрагент";
	Настройки.ДоговорКонтрагента.Реквизиты.ВидЦен      = "ВидЦен";
	
	ИспользоватьИндивидуальныеСоглашенияСКлиентамиИмя = "ИспользоватьИндивидуальныеСоглашенияСКлиентами";
	
	Если Не ПолучитьФункциональнуюОпцию(ИспользоватьИндивидуальныеСоглашенияСКлиентамиИмя) Тогда
		Настройки.ДоговорКонтрагента.РасширеннаяПодсказка =  НСтр("ru = 'Для того, чтобы иметь возможность назначать покупателям разные виды цен, необходимо включить использование индивидуальных соглашений с клиентами в настройках программы.'");
	Иначе	
		Настройки.ДоговорКонтрагента.РасширеннаяПодсказка =  НСтр("ru = 'Если выбрано индивидуальное соглашение, то на витрине для этого покупателя будут показываться цены по виду цен, указанному в шапке этого соглашения. Уточнения видов цен и цен для отдельных ценовых групп и товаров не учитываются при выгрузке цен на витрину.
																		|Выбрать можно только соглашение, в котором указан контрагент, для котого формируется инвайт.
										                                |
																		|Если соглашение не выбрано - цены будут показаны по виду цен, указанному в настройках витрины.'");
	КонецЕсли;
	
	Настройки.ДоговорКонтрагента.НаборДопРеквизитов = Маг1СИнтеграция.НаборыДополнительныхРеквизитовИСведенийПоИмени("Справочник_СоглашенияСКлиентами");
	
	Настройки.ПрефиксЗаказаДляУИП = "ЗК";
	        
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияERP(), "2.4.12.1") >= 0 Тогда
		Настройки.ПоддерживаетсяОплатаЧерезЮКасса = Истина;
	Иначе
		Настройки.ПоддерживаетсяОплатаЧерезЮКасса = Ложь;
	КонецЕсли;
	
	ИмяСправочникаНастройкиСБП = Маг1СИнтеграция.ИмяСправочникаНастройкиСБП();
	
	Если Не ПустаяСтрока(ИмяСправочникаНастройкиСБП) Тогда
		Настройки.ПоддерживаетсяОплатаЧерезСБП = Истина;
		Настройки.НастройкаСБП.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + ИмяСправочникаНастройкиСБП);
	Иначе
		Настройки.ПоддерживаетсяОплатаЧерезСБП = Ложь;
	КонецЕсли;
	
	ЗаказКлиентаИмя = "ЗаказКлиента";
	
	Настройки.ЗаказПокупателя.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка." + ЗаказКлиентаИмя);
	Настройки.ЗаказПокупателя.Значение        = ПредопределенноеЗначение("Документ." + ЗаказКлиентаИмя + ".ПустаяСсылка");
	Настройки.ЗаказПокупателя.Реквизиты.Контрагент = "Контрагент"; 
	
	Настройки.ЗаказПокупателя.Реквизиты.Склад      = "Склад";
	Настройки.ЗаказПокупателя.Реквизиты.Товары     = "Товары";     
	Настройки.ЗаказПокупателя.Реквизиты.СуммаВключаетНДС     = "ЦенаВключаетНДС";
	Настройки.ЗаказПокупателя.ПКО_Получение        = "Документ_ЗаказКлиента_Получение";
	
	СправочникПартнерыПустаяСсылкаИмя = "Справочник.Партнеры.ПустаяСсылка";
	
	Настройки.ДопТипыОбъектовДляРазмещенияКомандыПолученияИнвайта.Добавить(ПредопределенноеЗначение(СправочникПартнерыПустаяСсылкаИмя));
	
	ИмяВидыКонтактнойИнформации = "ВидыКонтактнойИнформации";
	
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("ДокументОбъект.ЗаказКлиента");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.Номенклатура");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.ХарактеристикиНоменклатуры");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.НоменклатураПрисоединенныеФайлы");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.Файлы");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.Контрагенты");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.Партнеры");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.СоглашенияСКлиентами");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("РегистрСведенийНаборЗаписей.СостоянияЗаказовКлиентов");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.ВидыЦен");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.УпаковкиЕдиницыИзмерения");
	Настройки.ИменаТиповДляОбменаПоПравилам.Добавить("СправочникОбъект.ВидыНоменклатуры");
	
	ИмяФОСегментов = "ИспользоватьСегментыНоменклатуры";
	Если Метаданные.ФункциональныеОпции.Найти(ИмяФОСегментов) <> Неопределено
		И ПолучитьФункциональнуюОпцию(ИмяФОСегментов) Тогда
		
		СегментыНоменклатурыИмя = "СегментыНоменклатуры";
		
		Настройки.СегментНоменклатуры.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + СегментыНоменклатурыИмя);
		Настройки.СегментНоменклатуры.Значение        = ПредопределенноеЗначение("Справочник." + СегментыНоменклатурыИмя + ".ПустаяСсылка");
		
		СпособыФормированияСегментовИмя = "СпособыФормированияСегментов";
		
		СпособыФормированияСегментов = Новый Массив;
		СпособыФормированияСегментов.Добавить(ПредопределенноеЗначение("Перечисление." + СпособыФормированияСегментовИмя + ".ПериодическиОбновлять"));
		СпособыФормированияСегментов.Добавить(ПредопределенноеЗначение("Перечисление." + СпособыФормированияСегментовИмя + ".ФормироватьВручную"));
		
		Настройки.СегментНоменклатуры.ПараметрыВыбора.Добавить(Маг1СИнтеграция.ПараметрВыбораСтруктура("Отбор.СпособФормирования", 
																										Новый ФиксированныйМассив(СпособыФормированияСегментов)));
		
	Иначе
		Настройки.СегментНоменклатуры.ОграничениеТипа = Неопределено;
		Настройки.СегментНоменклатуры.Значение        = Неопределено;
	КонецЕсли;
КонецПроцедуры

// См. Маг1СИнтеграцияСВебВитринойПереопределяемый.ПриПолученииСведенийОбОрганизации
//
Процедура ПриПолученииСведенийОбОрганизации(ОсновныеНастройки, СведенияОбОрганизации) Экспорт
	Организация = ОсновныеНастройки.ПараметрыУчета.Организация;
	
	ВидыКонтактнойИнформацииИмя = "ВидыКонтактнойИнформации";
	
	СтруктураСведений = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "НаименованиеПолное, Наименование, ФайлЛоготип, ИНН, КПП, ОГРН, ЮрФизЛицо");
	ЗаполнитьЗначенияСвойств(СведенияОбОрганизации, СтруктураСведений, "НаименованиеПолное, ИНН, КПП, ОГРН");
	
	СведенияОбОрганизации.Логотип             = СтруктураСведений.ФайлЛоготип;
	СведенияОбОрганизации.НаименованиеРабочее = СтруктураСведений.Наименование;
	
	СведенияОбОрганизации.Телефон = 
		Маг1СИнтеграцияСлужебный.ФорматироватьТелефон(УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
																				Организация, 
																				Справочники[ВидыКонтактнойИнформацииИмя].ТелефонОрганизации,
																				,
																				ТекущаяДатаСеанса()));
	
	СведенияОбОрганизации.ЮридическийАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
		Организация, Справочники[ВидыКонтактнойИнформацииИмя].ЮрАдресОрганизации, , ТекущаяДатаСеанса());
		
	СведенияОбОрганизации.ФактическийАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
		Организация, Справочники[ВидыКонтактнойИнформацииИмя].ФактАдресОрганизации, , ТекущаяДатаСеанса());
		
	СведенияОбОрганизации.ЮридическоеЛицо = (СтруктураСведений.ЮрФизЛицо = Перечисления["ЮрФизЛицо"].ЮрЛицо);
	
	СведенияОбОрганизации.ЮКассаКодСистемыНалогоолажения = КодСистемыНалогообложения(Организация, ТекущаяДатаСеанса());
	
	ПараметрыУчетаОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(Организация, ТекущаяДатаСеанса());
	
	ИмяТипыНалогообложенияНДС = "ТипыНалогообложенияНДС";
	ИмяСтавкиНДС              = "СтавкиНДС";
	
	Если ПараметрыУчетаОрганизации.Свойство("СтавкаНДСПриУСН") Тогда
		
		Если ПараметрыУчетаОрганизации.ОсновноеНалогообложениеНДСПродажи = Перечисления[ИмяТипыНалогообложенияНДС].ПродажаНеОблагаетсяНДС Тогда
			СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_БезНДС();
		ИначеЕсли ПараметрыУчетаОрганизации.ОсновноеНалогообложениеНДСПродажи = Перечисления[ИмяТипыНалогообложенияНДС].ПродажаОблагаетсяНДС Тогда
			СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_НДСОбщая();
		ИначеЕсли ПараметрыУчетаОрганизации.ОсновноеНалогообложениеНДСПродажи = Перечисления[ИмяТипыНалогообложенияНДС].ЛьготноеНалогообложениеНДСНаУСН Тогда
			Если ЗначениеЗаполнено(ПараметрыУчетаОрганизации.СтавкаНДСПриУСН) Тогда
				СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыУчетаОрганизации.СтавкаНДСПриУСН, "ПеречислениеСтавкаНДС");
			Иначе
				СтавкаНДС = Неопределено;
			КонецЕсли;
			
			Если СтавкаНДС = Перечисления[ИмяСтавкиНДС].НДС5 Тогда
				СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_НДС5();
			ИначеЕсли СтавкаНДС = Перечисления[ИмяСтавкиНДС].НДС7 Тогда	
				СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_НДС7();
			Иначе
				СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_БезНДС();
			КонецЕсли;
		Иначе
			СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_НДСОбщая();
		КонецЕсли;
		
		СведенияОбОрганизации.ЯвляетсяПлательщикомНДС = СведенияОбОрганизации.Налогообложение <> Маг1СПеречисления.НалогообложениеОрганизации_БезНДС();
		
	Иначе
		СведенияОбОрганизации.ЯвляетсяПлательщикомНДС = Не (ПараметрыУчетаОрганизации.ОсновноеНалогообложениеНДСПродажи =
																Перечисления[ИмяТипыНалогообложенияНДС].ПродажаНеОблагаетсяНДС
															Или 
																ПараметрыУчетаОрганизации.ОсновноеНалогообложениеНДСПродажи =	
																	Перечисления[ИмяТипыНалогообложенияНДС].ПродажаОблагаетсяЕНВД);
		Если СведенияОбОрганизации.ЯвляетсяПлательщикомНДС Тогда
			СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_НДСОбщая();
		Иначе
			СведенияОбОрганизации.Налогообложение = Маг1СПеречисления.НалогообложениеОрганизации_БезНДС();
		КонецЕсли;
	КонецЕсли;
																
	БанковскийСчет = ОсновныеНастройки.БанковскийСчет;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		РеквизитыСчета = Новый Структура();
		РеквизитыСчета.Вставить("НаименованиеБанка", "Банк.Наименование");
		РеквизитыСчета.Вставить("БИК", "Банк.Код");
		РеквизитыСчета.Вставить("НомерСчета", "НомерСчета");
		РеквизитыСчета.Вставить("КоррСчет", "Банк.КоррСчет");
		
		ЗначенияРеквизитовСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БанковскийСчет, РеквизитыСчета);
		
		ЗаполнитьЗначенияСвойств(СведенияОбОрганизации, ЗначенияРеквизитовСчета);
	КонецЕсли;	
КонецПроцедуры

// См. Маг1СИнтеграцияСВебВитринойПереопределяемый.ПриНачалеНастройкиСведенийОбОрганизации
//
Процедура ПриНачалеНастройкиСведенийОбОрганизации(Организация, ИмяФормы, ПараметрыФормы) Экспорт
	
	ИмяФормы = "Справочник.Организации.ФормаОбъекта";
	ПараметрыФормы.Вставить("Ключ", Организация);
	
КонецПроцедуры

// См. Маг1СИнтеграцияСВебВитринойПереопределяемый.ПриИзмененииПараметровУчета
//
Процедура ПриИзмененииПараметровУчета(ОсновныеНастройки, ИмяПараметра) Экспорт
	
	ПараметрыУчета = ОсновныеНастройки.ПараметрыУчета;
	
	ВидыКонтактнойИнформацииИмя = "ВидыКонтактнойИнформации";
	
	Если ИмяПараметра = "Склад"
		И ЗначениеЗаполнено(ПараметрыУчета.Склад) Тогда
		
		Если Не ЗначениеЗаполнено(ОсновныеНастройки.АдресМагазина) Тогда
			ОсновныеНастройки.АдресМагазина = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
				ПараметрыУчета.Склад,
				Справочники[ВидыКонтактнойИнформацииИмя].АдресСклада);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОсновныеНастройки.ТелефонМагазина1) Тогда
			ОсновныеНастройки.ТелефонМагазина1 = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
				ПараметрыУчета.Склад,
				Справочники[ВидыКонтактнойИнформацииИмя].ТелефонСклада);
		КонецЕсли;
			
		Если Не ЗначениеЗаполнено(ПараметрыУчета.ВидЦен) Тогда
			РеквизитыВидаЦен = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыУчета.Склад,
				Новый Структура("РозничныйВидЦены, ЦенаВключаетНДС", "РозничныйВидЦены", "РозничныйВидЦены.ЦенаВключаетНДС"));
			Если ЗначениеЗаполнено(РеквизитыВидаЦен.РозничныйВидЦены)
				И РеквизитыВидаЦен.ЦенаВключаетНДС Тогда
				ПараметрыУчета.ВидЦен = РеквизитыВидаЦен.РозничныйВидЦены;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	Если (ИмяПараметра = "Организация"
			Или ИмяПараметра = Неопределено)
		И ЗначениеЗаполнено(ОсновныеНастройки.ПараметрыУчета.Организация)
		И Не ЗначениеЗаполнено(ОсновныеНастройки.БанковскийСчет) Тогда
		
		ОсновныеНастройки.БанковскийСчет = Справочники["БанковскиеСчетаОрганизаций"].ПолучитьБанковскийСчетОрганизацииПоУмолчанию(ОсновныеНастройки.ПараметрыУчета.Организация);
	КонецЕсли;	
КонецПроцедуры

// См. Маг1СИнтеграцияСВебВитринойПереопределяемый.ПриСозданииНастройкиОбмена
// 
Процедура ПриСозданииНастройкиОбмена(УзелОбмена, ДополнительныеПараметры) Экспорт
	
	УзелОбмена.ВерсияФорматаОбмена                  = "1.9";
	УзелОбмена.ВыгружатьАналитикуПоСкладам          = Истина;
	УзелОбмена.ВыгружатьУправленческуюОрганизацию   = Ложь;
	УзелОбмена.ДатаНачалаВыгрузкиДокументов         = '19800101';
	
	УзелОбмена.РегистрироватьИзменения              = Истина;
	УзелОбмена.ПравилаОтправкиДокументов            = "АвтоматическаяСинхронизация";
	УзелОбмена.ПравилаОтправкиСправочников          = "АвтоматическаяСинхронизация";
	УзелОбмена.РежимВыгрузкиПриНеобходимости        = Перечисления["РежимыВыгрузкиОбъектовОбмена"].ВыгружатьПриНеобходимости;
	УзелОбмена.РежимВыгрузкиДокументов              = Перечисления["РежимыВыгрузкиОбъектовОбмена"].ВыгружатьВсегда;
	УзелОбмена.РежимВыгрузкиСправочников            = Перечисления["РежимыВыгрузкиОбъектовОбмена"].ВыгружатьВсегда;
	УзелОбмена.СкладПоУмолчанию                     = ДополнительныеПараметры.ПараметрыУчета.Склад;
	УзелОбмена.УправленческаяОрганизация            = Справочники["Организации"].УправленческаяОрганизация;
	УзелОбмена.ВыгружатьЦеныНоменклатуры            = Истина;
	УзелОбмена.ПравилаСозданияДоговоровКонтрагентов = "БезРазделения";
	УзелОбмена.ИспользоватьОтборПоРазделамУчета     = Ложь;
	
	УзелОбмена.ИспользоватьОтборПоОрганизациям = Ложь;
	
	Если УзелОбмена.Метаданные().Реквизиты.Найти("ПропускатьНекорректныеОбъектыПриВыгрузке") <> Неопределено Тогда
		УзелОбмена.ПропускатьНекорректныеОбъектыПриВыгрузке = Ложь;
	КонецЕсли;
	
	СтрокаТаблицы = УзелОбмена.ВидыЦенНоменклатуры.Добавить();
	СтрокаТаблицы.ВидЦенНоменклатуры = ДополнительныеПараметры.ПараметрыУчета.ВидЦен;
	
	//Включение необходимых ФО
	
	ИспользоватьДополнительныеРеквизитыИСведенияИмя = "ИспользоватьДополнительныеРеквизитыИСведения";
	
	Если Не Константы[ИспользоватьДополнительныеРеквизитыИСведенияИмя].Получить() Тогда
		Константы[ИспользоватьДополнительныеРеквизитыИСведенияИмя].Установить(Истина);
	КонецЕсли;
	
	ИспользоватьЗаказыКлиентовИмя = "ИспользоватьЗаказыКлиентов";
	
	Если Не Константы[ИспользоватьЗаказыКлиентовИмя].Получить() Тогда
		Константы[ИспользоватьЗаказыКлиентовИмя].Установить(Истина);
	КонецЕсли;
	
	ВерсияДо = Неопределено;
	
	УзелОбмена.ДополнительныеСвойства.Свойство("Маг1С_ВерсияРасширенияДо", ВерсияДо);
	
	Если ВерсияДо = Неопределено
		Или ПустаяСтрока(ВерсияДо) Тогда
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

