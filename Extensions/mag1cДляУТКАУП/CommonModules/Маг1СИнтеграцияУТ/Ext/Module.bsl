Функция ДоговорПоУмолчаниюПоКонтрагенту(Контрагент, ПараметрыУчета) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоглашенияСКлиентами.Ссылка КАК Ссылка,
	|	СоглашенияСКлиентами.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ОрганизацияПустая
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|ГДЕ
	|	СоглашенияСКлиентами.Контрагент = &Контрагент
	|	И СоглашенияСКлиентами.Организация В (ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка), &Организация)
	|	И НЕ СоглашенияСКлиентами.ВидЦен В (ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка), &ВидЦенПоУмолчанию)
	|	И СоглашенияСКлиентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСКлиентами.Действует)
	|	И (СоглашенияСКлиентами.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ СоглашенияСКлиентами.ДатаНачалаДействия <= &ТекущаяДата)
	|	И (СоглашенияСКлиентами.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ СоглашенияСКлиентами.ДатаОкончанияДействия >= &ТекущаяДата)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацияПустая,
	|	Ссылка";
	
	Запрос.УстановитьПараметр("Организация", ПараметрыУчета.Организация);
	Запрос.УстановитьПараметр("ВидЦенПоУмолчанию", ПараметрыУчета.ВидЦен);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецЕсли;
КонецФункции

Функция ВерсияERP() Экспорт
	
	ИмяМастерКонфигурации = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Маг1СИнтеграцияСлужебный.ИмяПараметраИмяМастерКонфигурации());
	Если СтрНайти(ИмяМастерКонфигурации, "УправлениеТорговлей_CRM_2") > 0 Тогда
		
		Попытка
			ОбщийМодульОбновлениеИнформационнойБазы = ОбщегоНазначения.ОбщийМодуль("ОбновлениеИнформационнойБазы");
			ВерсииПодсистем = ОбщийМодульОбновлениеИнформационнойБазы.ВерсииПодсистем();
			Если ВерсииПодсистем.Найти("Локализация", "ИмяПодсистемы") <> Неопределено Тогда
				НайденнаяСтрока = ВерсииПодсистем.Найти("Локализация", "ИмяПодсистемы");
				Возврат НайденнаяСтрока.Версия;
			ИначеЕсли ВерсииПодсистем.Найти("УправлениеТорговлей", "ИмяПодсистемы") <> Неопределено Тогда
				НайденнаяСтрока = ВерсииПодсистем.Найти("УправлениеТорговлей", "ИмяПодсистемы");
				ВерсияМассив = СтрРазделить(НайденнаяСтрока.Версия, ".");
				ВерсияМассив[0] = "2";
				Возврат СтрСоединить(ВерсияМассив, ".");
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		ВерсияМассив = СтрРазделить(Метаданные.Версия, ".");
		Если ВерсияМассив[0] = "3" Тогда
			ТретьеЧисло = Число(ВерсияМассив[2]);
			ТретьеЧисло = ТретьеЧисло - 10;
			
			Если ВерсияМассив[1] = "0" Тогда
				Возврат "2.4" + Строка(ТретьеЧисло) + ".0";
			ИначеЕсли ВерсияМассив[1] = "1" Тогда
				Возврат "2.5" + Строка(ТретьеЧисло) + ".0";
			Иначе
				ВызватьИсключение ТекстИсключенияВерсияНеПоддерживается(Метаданные);
			КонецЕсли;
		Иначе
			ВызватьИсключение ТекстИсключенияВерсияНеПоддерживается(Метаданные);
		КонецЕсли;
		
	ИначеЕсли СтрНайти(ИмяМастерКонфигурации, "УправлениеХолдингомERP") > 0 Тогда
		
		Если СтрНайти(Метаданные.Версия, "3.0.4") Тогда
			Возврат "2.4.13.51"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.0.5") Тогда
			Возврат "2.4.14.176"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.3") Тогда
			Возврат "2.5.6.137"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.4") Тогда
			Возврат "2.5.6.195"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.5") Тогда
			Возврат "2.5.7.201"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.6") Тогда
			Возврат "2.5.7.279"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.7") Тогда
			Возврат "2.5.7.390"      
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.8") Тогда
			Возврат "2.5.8.171"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.9") Тогда
			Возврат "2.5.9.135"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.10") Тогда
			Возврат "2.5.10.1"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.11") Тогда
			Возврат "2.5.11.1"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.12") Тогда
			Возврат "2.5.12.11"
		ИначеЕсли СтрНайти(Метаданные.Версия, "3.1.13") Тогда
			Возврат "2.5.13.1"
		Иначе
			ВерсияМассив = СтрРазделить(Метаданные.Версия, ".");
			Если ВерсияМассив[0] = "3" И ВерсияМассив[1] = "2" Тогда
				Возврат "2.5." + Строка(14+Число(ВерсияМассив[2])) + ".1";
			ИначеЕсли ВерсияМассив[0] = "3" И ВерсияМассив[1] = "3" Тогда
				Возврат "2.5." + Строка(25+Число(ВерсияМассив[2])) + ".1";
			Иначе
				ВызватьИсключение ТекстИсключенияВерсияНеПоддерживается(Метаданные);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли СтрНайти(ИмяМастерКонфигурации, "УправлениеТорговлей") > 0 Тогда
		
		ВерсияМассив = СтрРазделить(Метаданные.Версия, ".");
		ВерсияМассив[0] = "2";
		Возврат СтрСоединить(ВерсияМассив, ".");
		
	Иначе
		
		Возврат Метаданные.Версия;
		
	КонецЕсли;
	
КонецФункции

Функция ТекстИсключенияВерсияНеПоддерживается(Метаданные)
	
	ТекстИсключения = НСтр("ru = 'Версия %Версия% конфигурации %Конфигурация% не поддерживается. Обратитесь в техподдержку webits-info@1c.ru'");
	ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Версия%", Метаданные.Версия); 
	ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Конфигурация%", Метаданные.Имя); 
	
	Возврат ТекстИсключения
	
КонецФункции

Функция СтавкаНДСПоНоменклатуре(Номенклатура) Экспорт
	СтавкиНДСИмя = "СтавкиНДС";
	
	ЗначенияДляОтправки = Новый Соответствие;
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].БезНДС, "БезНДС");
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС0, "НДС0");
	Если ПеречислениеСтавкиСуществует(СтавкиНДСИмя, "НДС5") Тогда 
		ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС5, "НДС5");
	КонецЕсли;
	Если ПеречислениеСтавкиСуществует(СтавкиНДСИмя, "НДС5_105") Тогда 
		ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС5_105, "НДС5_105");
	КонецЕсли;
	Если ПеречислениеСтавкиСуществует(СтавкиНДСИмя, "НДС7") Тогда 
		ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС7, "НДС7");
	КонецЕсли;
	Если ПеречислениеСтавкиСуществует(СтавкиНДСИмя, "НДС7_107") Тогда 
		ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС7_107, "НДС7_107");
	КонецЕсли;
	Если ПеречислениеСтавкиСуществует(СтавкиНДСИмя, "НДС22") Тогда 
		ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС22, "НДС22");
	КонецЕсли;
	Если ПеречислениеСтавкиСуществует(СтавкиНДСИмя, "НДС22_122") Тогда 
		ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС22_122, "НДС22_122");
	КонецЕсли;
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС10, "НДС10");
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС10_110, "НДС10_110");
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС18, "НДС18");
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС18_118, "НДС18_118");
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС20, "НДС20");
	ЗначенияДляОтправки.Вставить(Перечисления[СтавкиНДСИмя].НДС20_120, "НДС20_120");
	
	НоменклатураИмя = "Номенклатура";
	
	Если Метаданные.Справочники[НоменклатураИмя].Реквизиты.Найти("СтавкаНДС").Тип.СодержитТип(Тип("ПеречислениеСсылка."+СтавкиНДСИмя)) Тогда
		СтавкаНДС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, Новый Структура("СтавкаНДС","СтавкаНДС")).СтавкаНДС;
	Иначе
		СтавкаНДС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, Новый Структура("СтавкаНДС","СтавкаНДС.ПеречислениеСтавкаНДС")).СтавкаНДС;
	КонецЕсли;
	
	СтавкаНДССтрока = ЗначенияДляОтправки.Получить(СтавкаНДС);
	
	Если Не ЗначениеЗаполнено(СтавкаНДССтрока) Тогда
		Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
			ТекстИсключения = НСтр("ru = 'Не указана ставка НДС у номенклатуры %Номенклатура%. Откройте карточку номенклатуры и заполните ставку НДС'");
		Иначе
			ТекстИсключения = НСтр("ru = 'У номенклатуры %Номенклатура% указана ставка НДС %СтавкаНДС%. Эта ставка НДС устарела. Откройте карточку номенклатуры и заполните ставку НДС актуальным значением из списка выбора.'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%СтавкаНДС%", СтавкаНДС);	
		КонецЕсли;
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Номенклатура%", Номенклатура);
		ВызватьИсключение ТекстИсключения;	
	Иначе
		Возврат СтавкаНДССтрока;
	КонецЕсли;
	
КонецФункции

