
&НаСервере
&После("ПриСозданииНаСервере")
Процедура Маг1С_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтоВызовИзМаг1С = Параметры.Свойство("ЭтоВызовИзМаг1С");
	Если Не ЭтоВызовИзМаг1С Тогда 
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ТолькоТиповые", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ТолькоИндивидуальные", Истина);

	ТипСоглашения = "Индивидуальное";
	
	Если ЗначениеЗаполнено(Параметры.Партнер) Тогда
		ОтборПоКонтрагенту = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Параметры.Контрагент);
		ОтборПоКонтрагенту.Добавить(Справочники["Контрагенты"].ПустаяСсылка());
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Контрагент", ОтборПоКонтрагенту, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Контрагент", Параметры.Контрагент, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	КонецЕсли;
	
	ОтборПоОрганизации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Параметры.Организация);
	ОтборПоОрганизации.Добавить(Справочники["Организации"].ПустаяСсылка());
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", ОтборПоОрганизации, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
КонецПроцедуры
