&НаСервере
Процедура Маг1С_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	ЭтоВызовИзМаг1С = Параметры.Свойство("Маг1С_ВидЦен");
	Если Не ЭтоВызовИзМаг1С Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыЦенВлияющиеВидыЦен.ВлияющийВидЦен КАК ВидЦен
	|ИЗ
	|	Справочник.ВидыЦен.ВлияющиеВидыЦен КАК ВидыЦенВлияющиеВидыЦен
	|ГДЕ
	|	ВидыЦенВлияющиеВидыЦен.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВидыЦенВлияющиеВидыЦен.Ссылка
	|ИЗ
	|	Справочник.ВидыЦен.ВлияющиеВидыЦен КАК ВидыЦенВлияющиеВидыЦен
	|ГДЕ
	|	ВидыЦенВлияющиеВидыЦен.ВлияющийВидЦен = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Параметры.Маг1С_ВидЦен);
	
	МассивЦен = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидЦен");
	МассивЦен.Добавить(Параметры.Маг1С_ВидЦен);
	
	УстановкаЦенСервер.ИнициализироватьВыбранныеЦены(ЭтотОбъект, МассивЦен);
	
	Для Каждого СтрокаТЧ Из ВыбранныеЦены Цикл
		СтрокаТЧ.Выбрана = МассивЦен.Найти(СтрокаТЧ.Ссылка) <> Неопределено
		                   И Не СтрокаТЧ.ЗапрещенныйВидЦены;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "Редактировать") Тогда
			СтрокаТЧ.Редактировать = СтрокаТЧ.Выбрана;
		КонецЕсли;
	КонецЦикла;
	
	УстановкаЦенСервер.ПостроитьДеревоЦен(ЭтотОбъект);
	
	СписокНоменклатуры = Новый СписокЗначений;
	СписокНоменклатуры.ЗагрузитьЗначения(Параметры.Маг1С_НоменклатураДляУстановкиЦен);
	
	КомпоновщикНастроекОтбор.Настройки.Отбор.Элементы.Очистить();	
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		КомпоновщикНастроекОтбор.Настройки.Отбор,
		"Номенклатура",
		ВидСравненияКомпоновкиДанных.ВСписке,
		СписокНоменклатуры,
		Неопределено,
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
		
	УстановкаЦенСервер.НастроитьЗаголовокОтбора(ЭтотОбъект);
		
	ПрименитьНастройки();
КонецПроцедуры

