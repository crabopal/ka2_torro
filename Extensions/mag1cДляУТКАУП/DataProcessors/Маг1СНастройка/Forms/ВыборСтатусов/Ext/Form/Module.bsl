&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаСтатусЗаказаПокупателя = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы().СтатусЗаказаПокупателя;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	СостоянияИБ.Ссылка КАК Ссылка
		|ИЗ
		|	&ТекстИмяТаблицы КАК СостоянияИБ
		|ГДЕ
		|	СостоянияИБ.Ссылка НЕ В(&ВыбранныеСтатусыДляДругихСтрок)
		|	И &ТекстУсловия
		|
		|УПОРЯДОЧИТЬ ПО
		|	СостоянияИБ.Наименование";
	
	Запрос.УстановитьПараметр("ВыбранныеСтатусыДляДругихСтрок", Параметры.ВыбранныеСтатусыДляДругихСтрок);
	
	ИмяТаблицы = НастройкаСтатусЗаказаПокупателя.Значение.Метаданные().ПолноеИмя();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстИмяТаблицы", ИмяТаблицы);
	
	ТекстыУсловий = Новый Массив();
	ТекстыУсловий.Добавить("ИСТИНА");
	
	Для Каждого ПараметрВыбора из НастройкаСтатусЗаказаПокупателя.ПараметрыВыбора Цикл
		Если СтрНайти(ПараметрВыбора.Имя, "Отбор.") > 0 Тогда
			Имя = СтрЗаменить(ПараметрВыбора.Имя, "Отбор.", ""); 	
			ТекстыУсловий.Добавить("СостоянияИБ." + Имя + " = &" + Имя);
			Запрос.УстановитьПараметр(Имя, ПараметрВыбора.Значение); 
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУсловия", СтрСоединить(ТекстыУсловий, " И "));
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СостоянияЗаказа.Добавить(Выборка.Ссылка,
									,
									Параметры.ТекущиеВыбранныеСтатусы.Найти(Выборка.Ссылка) <> Неопределено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	Результат = Новый Массив();
	Для Каждого СтрЗнч из СостоянияЗаказа Цикл
		Если СтрЗнч.Пометка Тогда
			Результат.Добавить(СтрЗнч.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(Результат);
КонецПроцедуры


