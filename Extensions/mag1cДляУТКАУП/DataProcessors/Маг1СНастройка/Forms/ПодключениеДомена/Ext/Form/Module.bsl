#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоменПользователя                = Параметры.ДоменПользователя;
	ЛогинИПП                         = Параметры.ЛогинИПП;
	СтрокаСпискаВитрин               = Параметры.СтрокаСпискаВитрин;
	ТипСертификатаДоменаПользователя = Параметры.ТипСертификатаДоменаПользователя;
	ЗарегистрированныйДоменПользователя = Параметры.ЗарегистрированныйДоменПользователя;
	EMailДляОтправкиУведомлений         = Параметры.EMailДляОтправкиУведомлений;
	ЕстьПлатныйТариф                    = Параметры.ЕстьПлатныйТариф;
	
	Если ПустаяСтрока(ТипСертификатаДоменаПользователя)
		Или ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_None() Тогда
		ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual();
	КонецЕсли;
	
	НастройкиДоменаПользователя         = Маг1СИнтеграцияСлужебныйКлиентСервер.НастройкиДоменаПользователяПредставление(
															СтрокаСпискаВитрин.НастройкиДоменаПользователя);
															
	ДоменПользователяПрошелПроверку = ЗначениеЗаполнено(ДоменПользователя);
	
	Элементы.ДоменПользователя.АвтоОтметкаНезаполненного = Не ЗначениеЗаполнено(ЗарегистрированныйДоменПользователя);
	Элементы.Отключить.Видимость = ЗначениеЗаполнено(ЗарегистрированныйДоменПользователя);
	
	ИспользоватьТекущийСертификат = ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual();
	
	//Элементы.ТипСертификатаДоменаПользователяАвтоматический.СписокВыбора.Очистить();
	//Элементы.ТипСертификатаДоменаПользователяАвтоматический.СписокВыбора.Добавить(Маг1СПеречисления.ТипыСертификатов_Automatic(),
	//																		Маг1СПеречисления.ТипыСертификатовПредставление(Маг1СПеречисления.ТипыСертификатов_Automatic()));
	
	//Элементы.ТипСертификатаДоменаПользователяРучной.СписокВыбора.Очистить();
	//Элементы.ТипСертификатаДоменаПользователяРучной.СписокВыбора.Добавить(Маг1СПеречисления.ТипыСертификатов_Manual(),
	//																		Маг1СПеречисления.ТипыСертификатовПредставление(Маг1СПеречисления.ТипыСертификатов_Manual()));
	
	Если Не ЗначениеЗаполнено(ДоменПользователя) Тогда
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяНеВыполнялась;
	Иначе 
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяЗарегистрирован;
		
		СостояниеДоменаПользователя = СтрокаСпискаВитрин.СостояниеДоменаПользователя;
		
		ПредставлениеСостояния = Маг1СПеречисления.СостоянияДоменаПользователяПредставление(СостояниеДоменаПользователя);
		
		Элементы.ДекорацияКартинкаДоменноеИмяСтатусПодключен.Видимость = Ложь;
		Элементы.ДекорацияКартинкаДоменноеИмяСтатусОшибка.Видимость    = Ложь;
		Элементы.ДекорацияКартинкаДоменноеИмяСтатусПроверка.Видимость  = Ложь;
		
		Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.СостояниеДоменаПользователяЕстьПроблема(СостояниеДоменаПользователя) Тогда
			ТекстЗаголовка = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Состояние: %1</span>'"),
																		ПредставлениеСостояния);
																		
			Если СостояниеДоменаПользователя = Маг1СПеречисления.СостоянияДоменаПользователя_Ready() Тогда 
				Элементы.ДекорацияКартинкаДоменноеИмяСтатусПодключен.Видимость = Истина;
			Иначе
				Элементы.ДекорацияКартинкаДоменноеИмяСтатусПроверка.Видимость = Истина;
			КонецЕсли;
		Иначе
			ТекстЗаголовка = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Состояние: %1. Обратитесь, пожалуйста, <a href = ""НаписатьВТехподдержку"">в техподдержку</a>.</span>'"),
																		ПредставлениеСостояния);
																		
			Элементы.ДекорацияКартинкаДоменноеИмяСтатусОшибка.Видимость = Истина;
		КонецЕсли;
		
		Элементы.ДекорацияДоменноеИмяСтатус.Заголовок = ТекстЗаголовка;
		
		Если ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual() Тогда
			Элементы.ДекорацияКартинкаДекорацияСертификатСтатусПодключен.Видимость = Ложь;
			Элементы.ДекорацияКартинкаДекорацияСертификатСтатусОшибка.Видимость    = Ложь;
			Элементы.ДекорацияКартинкаДекорацияСертификатСтатусПроверка.Видимость  = Ложь;
			
			СостояниеСертификатаДоменаПользователя = СтрокаСпискаВитрин.СостояниеСертификатаДоменаПользователя;
			
			ПредставлениеСостояния = Маг1СПеречисления.СостоянияСертификатаДоменаПользователяПредставление(СостояниеСертификатаДоменаПользователя);
			
			Если СостояниеСертификатаДоменаПользователя = Маг1СПеречисления.СостоянияСертификатаДоменаПользователя_Valid() Тогда
				СертификатДоменаПользователяИстекаетВ = Формат(СтрокаСпискаВитрин.СертификатДоменаПользователяИстекаетВ, "ДФ=dd.MM.yyyy");
				
				Если Маг1СИнтеграцияСлужебныйКлиентСервер.СертификатДоменаПользователяСкороИстечет(СтрокаСпискаВитрин) Тогда
					ТекстЗаголовка = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = '<span style="""">%1 до %2</span>'"),
																			ПредставлениеСостояния,
																			СертификатДоменаПользователяИстекаетВ);
				Иначе
					ТекстЗаголовка = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = '<span style="""">%1 до %2</span>'"),
																			ПредставлениеСостояния,
																			СертификатДоменаПользователяИстекаетВ);
				КонецЕсли;
				
				Элементы.ДекорацияКартинкаДекорацияСертификатСтатусПодключен.Видимость = Истина;
				
			ИначеЕсли СостояниеСертификатаДоменаПользователя = Маг1СПеречисления.СостоянияСертификатаДоменаПользователя_Validating() Тогда
				ТекстЗаголовка = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = '<span style="""">%1</span>'"),
																		ПредставлениеСостояния);
																		
				Элементы.ДекорацияКартинкаДекорацияСертификатСтатусПроверка.Видимость  = Истина;
			ИначеЕсли СостояниеСертификатаДоменаПользователя = Маг1СПеречисления.СостоянияСертификатаДоменаПользователя_Expired() Тогда
				ТекстЗаголовка = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = '<span style="""">%1. Загрузите новый сертификат</span>'"),
																		ПредставлениеСостояния);
				Элементы.ДекорацияКартинкаДекорацияСертификатСтатусОшибка.Видимость    = Истина;
			Иначе
				ТекстЗаголовка = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = '<span style="""">%1. Подробная информация направлена на %2</a></span>'"),
																		ПредставлениеСостояния,
																		EMailДляОтправкиУведомлений);
				Элементы.ДекорацияКартинкаДекорацияСертификатСтатусОшибка.Видимость    = Истина;
			КонецЕсли;
			
			Элементы.ДекорацияСертификатИнформация.Заголовок = ТекстЗаголовка;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьФорму();
	
	Элементы.СкопироватьНастройкиДоменаВБуферОбмена.Видимость = Маг1СИнтеграцияСлужебныйКлиент.ПоддержимаетсяРаботаСБуферомОбмена();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияНадписьПроверкаАдресаСайтаОшибкаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПовторитьПроверкуДоменаПользователя" Тогда
		ПодключитьОбработчикОжидания("ПриНачалеПроверкиДоменаПользователя", 0.1, Истина);
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОткрытьЖурналРегистрации" Тогда	
		Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДоменПользователяПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ДоменПользователя) Тогда
		Если Не ЗначениеЗаполнено(ЗарегистрированныйДоменПользователя) Тогда 
			Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяНеВыполнялась;
		Иначе
			Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяБудетОтключен;
		КонецЕсли;
		ДоменПользователяПрошелПроверку = Истина;
		НастройкиДоменаПользователя     = "";
	ИначеЕсли ДоменПользователя = ЗарегистрированныйДоменПользователя Тогда
		ИспользоватьТекущийСертификат = Истина; 
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяЗарегистрирован;
		ДоменПользователяПрошелПроверку = Истина;
	Иначе
		ДоменПользователяПрошелПроверку = Ложь;
		ИспользоватьТекущийСертификат   = Ложь;
		ПодключитьОбработчикОжидания("ПриНачалеПроверкиДоменаПользователя", 0.1, Истина);
	КонецЕсли;
	
	НастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСертификатаДоменаПользователяПриИзменении(Элемент)
	
	НастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	
	Тема  = НСтр("ru = 'Использование mag1c. Подключение доменного имени'");
	
	Тексты = Новый Массив;
	
	Текст = НСтр("ru = 'Доменное имя: %ДоменПользователя'");
	Текст = СтрЗаменить(Текст, "%ДоменПользователя", ДоменПользователя);
	Тексты.Добавить(Текст);
	
	Текст = НСтр("ru = 'Предыдущее доменное имя: %ЗарегистрированныйДоменПользователя'");
	Текст = СтрЗаменить(Текст, "%ЗарегистрированныйДоменПользователя", ЗарегистрированныйДоменПользователя);
	Тексты.Добавить(Текст);

	Текст = НСтр("ru = 'Состояние доменного имени: %СостояниеДоменаПользователя'");
	Текст = СтрЗаменить(Текст, "%СостояниеДоменаПользователя", СтрокаСпискаВитрин.СостояниеДоменаПользователя);
	Тексты.Добавить(Текст);

	Текст = НСтр("ru = 'Тип сертификата: %ТипСертификатаДоменаПользователя'");
	Текст = СтрЗаменить(Текст, "%ТипСертификатаДоменаПользователя", ТипСертификатаДоменаПользователя);
	Тексты.Добавить(Текст);
	
	Текст = НСтр("ru = 'Состояние сертификата: %СостояниеСертификатаДоменаПользователя'");
	Текст = СтрЗаменить(Текст, "%СостояниеСертификатаДоменаПользователя", СтрокаСпискаВитрин.СостояниеСертификатаДоменаПользователя);
	Тексты.Добавить(Текст);
	
	Тексты.Добавить(Символы.ПС);
	Тексты.Добавить(Символы.ПС);

	Текст = НСтр("ru = 'При настройке использования доменного имени возникла проблема'");		
	Тексты.Добавить(Текст);
	
	Вложение = Неопределено;
		
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(СтрокаСпискаВитрин.ИдентификаторВитрины,
																	СтрокаСпискаВитрин.ПолноеИмяВитрины,
																	ЛогинИПП,
																	Тема,
																	СтрСоединить(Тексты, Символы.ПС),
																	Вложение);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияИнформацияОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "НаписатьВТехподдержку" Тогда
		НадписьОбращениеВТехническуюПоддержкуНажатие(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ГруппаЗагрузкаСертификатаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если Элементы.ГруппаЗагрузкаСертификата.ТекущаяСтраница = Элементы.ГруппаЗагрузкаСертификатаИзНесколькихФайлов Тогда
		СертификатОднимФайлом = "";
	Иначе
		Сертификат = "";
		ЦепочкаСертификатов = "";
		Ключ = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНовыйСертификат(Команда)

	ИспользоватьТекущийСертификат = Ложь;
	НастроитьФорму();

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	Отказ = Ложь;
	ТекстВопроса = "";
	ПроверятьЗаполнение = Истина;
	
	Если ЗначениеЗаполнено(ЗарегистрированныйДоменПользователя) 
		И ЗарегистрированныйДоменПользователя <> ДоменПользователя Тогда
		
		Если ЗначениеЗаполнено(ДоменПользователя) Тогда
			ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Ранее к витрине было подключено доменное имя %1. Поменять его на имя %2?</span>'"),
																		ЗарегистрированныйДоменПользователя,
																		ДоменПользователя);
		Иначе
			ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Ранее к витрине было подключено доменное имя %1. Отключить его от витрины?</span>'"),
																		ЗарегистрированныйДоменПользователя,
																		ДоменПользователя);
			ПроверятьЗаполнение = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПроверятьЗаполнение Тогда
		Если Не ЗначениеЗаполнено(ДоменПользователя) Тогда
			СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните веб-адрес'"), "ДоменПользователя", Отказ);
		ИначеЕсли Не ДоменПользователяПрошелПроверку Тогда
			СообщитьПользователюНаКлиенте(НСтр("ru = 'Введенный веб-адрес не прошл проверку. Укажите корректный веб-адрес'"), "ДоменПользователя", Отказ);
		КонецЕсли;	
		
		Если ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual()
			И Не ИспользоватьТекущийСертификат Тогда
			
			Если Элементы.ГруппаЗагрузкаСертификата.ТекущаяСтраница = Элементы.ГруппаЗагрузкаСертификатаИзНесколькихФайлов Тогда
				Если Не ЗначениеЗаполнено(Сертификат) Тогда
					СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите сертификат'"), "Сертификат", Отказ);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Сертификат) Тогда
					СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите цепочку промежуточных и корневой сертификаты'"), "ЦепочкаСертификатов", Отказ);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Сертификат) Тогда
					СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите приватный (закрытый) ключ сертификата'"), "Ключ", Отказ);
				КонецЕсли;
			Иначе
				Если Не ЗначениеЗаполнено(СертификатОднимФайлом)Тогда
					СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите сертификат'"), "СертификатОднимФайлом", Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьПродолжение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	СохранитьПродолжение(КодВозвратаДиалога.ОК, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСертификат(Команда)
	ЗагрузитьИзФайла(Элементы.Сертификат.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЦепочкуСертификатов(Команда)
	ЗагрузитьИзФайла(Элементы.ЦепочкаСертификатов.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКлюч(Команда)
	ЗагрузитьИзФайла(Элементы.Ключ.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСертификатОднимФайлом(Команда)
	ЗагрузитьИзФайла(Элементы.СертификатОднимФайлом.Имя);
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьНастройкиДоменаВБуферОбмена(Команда)
	Маг1СИнтеграцияСлужебныйКлиент.ПоместитьВБуферОбмена(НастройкиДоменаПользователя);
КонецПроцедуры

&НаКлиенте
Процедура Отключить(Команда)
	ДоменПользователя = "";
	ДоменПользователяПриИзменении(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗагрузитьИзФайла(ИмяРеквизита)

	Оповещение = Новый ОписаниеОповещения("ВыборФайлаСертификатаЗавершение", ЭтотОбъект, ИмяРеквизита);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	
	Если ИмяРеквизита = Элементы.СертификатОднимФайлом.Имя Тогда
		ЗаголовокДиалога = НСтр("ru = 'Выберите файл сертификата");	
		Расширения = "*.p12;*.pfx;*.pem;";
		ФильтрДиалога = НСтр("ru = 'Все файлы сертификатов (%Расширения%)|%Расширения%|Все файлы|*'");
		
		ФильтрДиалога = СтрЗаменить(ФильтрДиалога,"%Расширения%", Расширения);
		ПараметрыЗагрузки.Диалог.Фильтр = ФильтрДиалога;
	Иначе
		ЗаголовокРеквизита = Элементы[ИмяРеквизита].Заголовок;
		ЗаголовокДиалога = НСтр("ru = 'Выберите файл, в котором хранится %ЗаголовокРеквизита");
		ЗаголовокДиалога = СтрЗаменить(ЗаголовокДиалога, "%ЗаголовокРеквизита", ЗаголовокРеквизита); 
	КонецЕсли;
	
	ПараметрыЗагрузки.Диалог.Заголовок   = ЗаголовокДиалога;
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаСертификатаЗавершение(ПомещенныйФайл, ИмяРеквизита) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьИзФайлаПродолжение(ПомещенныйФайл, ИмяРеквизита);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзФайлаПродолжение(ПомещенныйФайл, ИмяРеквизита)
		
	Если ТипЗнч(ПомещенныйФайл) = Тип("Структура") Тогда 
		НовоеЗначение = ПомещенныйФайл.Хранение;
	Иначе
		НовоеЗначение = ПомещенныйФайл;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовоеЗначение)
		И ЭтоАдресВременногоХранилища(НовоеЗначение) Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(НовоеЗначение);
		Попытка
			ТекстовыйДокумент = Новый ТекстовыйДокумент;
			ТекстовыйДокумент.Прочитать(ДвоичныеДанные.ОткрытьПотокДляЧтения(), КодировкаТекста.UTF8);
			
			ЭтотОбъект[ИмяРеквизита] = ТекстовыйДокумент.ПолучитьТекст();
		Исключение
			ЭтотОбъект[ИмяРеквизита] = "";
			ТекстСообщения = НСтр("ru = 'Ошибка при чтении файла. Попробуйте повторить попытку загрузки. Описание ошибки: %ОписаниеОшибки%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПродолжение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт	
	Если ОтветНаВопрос <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДоменПользователя", ДоменПользователя);
	Результат.Вставить("ТипСертификатаДоменаПользователя", ТипСертификатаДоменаПользователя);
	Если ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual()
		И Не ИспользоватьТекущийСертификат Тогда
		
		СертификатДоменаПользователя = Маг1СИнтеграцияСлужебныйКлиентСервер.СертификатДоменаПользователя();
		
		Если Элементы.ГруппаЗагрузкаСертификата.ТекущаяСтраница = Элементы.ГруппаЗагрузкаСертификатаИзНесколькихФайлов Тогда
			СертификатДоменаПользователя.Сертификат 		 = Сертификат;
			СертификатДоменаПользователя.ЦепочкаСертификатов = ЦепочкаСертификатов;
			СертификатДоменаПользователя.Ключ 				 = Ключ;
		Иначе
			СертификатДоменаПользователя.СертификатОднимФайлом = СертификатОднимФайлом;
		КонецЕсли;
		
		Результат.Вставить("СертификатДоменаПользователя", СертификатДоменаПользователя);
		
	Иначе
		Результат.Вставить("СертификатДоменаПользователя", Неопределено);
	КонецЕсли;
	
	Закрыть(Результат);
КонецПроцедуры

&НаКлиенте
Процедура СообщитьПользователюНаКлиенте(ТекстСообщения, ИмяРеквизитаФормы = "", Отказ = Неопределено)
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ИмяРеквизитаФормы, , Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеПроверкиДоменаПользователя()
	
	Если Не ЗначениеЗаполнено(ДоменПользователя) Тогда
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяНеВыполнялась;
		Возврат;
	КонецЕсли;
	
	Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяОжидание;
	
	ПодключитьОбработчикОжидания("ПроверкаДоменаПользователяПродолжение", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаДоменаПользователяПродолжение()
	
	Попытка
		РезультатПроверки = ПроверитьДоменПользователя(СтрокаСпискаВитрин.ИдентификаторВитрины,
														ДоменПользователя,
														ЛогинИПП);
	Исключение
		Элементы.КомандаДалееНазваниеВитрины.Доступность = Истина;
		
		ДоменПользователяПрошелПроверку = Ложь;
		НастроитьФорму();
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяОшибка;
		Возврат;
	КонецПопытки;
	
	Если РезультатПроверки.ИмяВалидно Тогда
		ДоменПользователяПрошелПроверку = Истина;
		ИспользоватьТекущийСертификат = Ложь;
		
		НастройкиДоменаПользователя  = Маг1СИнтеграцияСлужебныйКлиентСервер.НастройкиДоменаПользователяПредставление(
															РезультатПроверки.НастройкиДоменаПользователя);
		
		Сертификат = "";
		ЦепочкаСертификатов = "";
		Ключ = "";
		
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяУспешно;
	ИначеЕсли РезультатПроверки.Отказ Тогда
		ДоменПользователяПрошелПроверку = Ложь;
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяОшибка;
		ПараметрыСобытия = РезультатПроверки.ПараметрыСобытия;
	Иначе
		ДоменПользователяПрошелПроверку = Ложь;
		Элементы.ПанельПроверкаДоменаПользователя.ТекущаяСтраница = Элементы.СтраницаПроверкаДоменаПользователяНедоступна;
		Элементы.ДекорацияНадписьПроверкаАдресаСайтаНедоступен.Заголовок = РезультатПроверки.СообщениеОбОшибке;
	КонецЕсли;
	
	НастроитьФорму();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьДоменПользователя(ИдентификаторВитрины, ДоменПользователя, ЛогинИПП)
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ДоменПользователя", ДоменПользователя);
	ПараметрыОперации.Вставить("ЛогинИПП",          ЛогинИПП);
	ПараметрыОперации.Вставить("ИдентификаторВитрины",ИдентификаторВитрины);
	
	Результат = Новый Структура;
	
	Обработки.Маг1СНастройка.ПроверитьДоменПользователяВФоновомЗадании(ПараметрыОперации, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НастроитьФорму()
	
	Если ЗначениеЗаполнено(ДоменПользователя) Тогда 
		Элементы.ГруппаТипСертификатаЗаголовок.Видимость = Истина;
	Иначе
		Элементы.ГруппаТипСертификатаЗаголовок.Видимость = Ложь;
	КонецЕсли;
	
	Если ЕстьПлатныйТариф Тогда
		Элементы.ГруппаСертификатРучнойПоля.Видимость = 
			ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual()
			И (ДоменПользователяПрошелПроверку Или ДоменПользователя = ЗарегистрированныйДоменПользователя)
			И ЗначениеЗаполнено(ДоменПользователя);
		
		Если ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Manual() Тогда 
			Элементы.ТипСертификатаДоменаПользователя.РасширеннаяПодсказка.Заголовок = 
				"Вы можете загрузить свой сертификат, соответствующий указанному домену. 
				|Когда срок действия закончится, вам нужно будет получить новый сертификат и загрузить его.";
		ИначеЕсли ТипСертификатаДоменаПользователя = Маг1СПеречисления.ТипыСертификатов_Automatic() Тогда 
			Элементы.ТипСертификатаДоменаПользователя.РасширеннаяПодсказка.Заголовок = 
				"Сертификат будет получен автоматически на определённый срок. 
				|По его истечении автоматически будет получен новый сертификат.";
		Иначе
			Элементы.ТипСертификатаДоменаПользователя.Подсказка = "";
		КонецЕсли;
		
		Элементы.ГруппаЗагрузкаСертификата.Видимость = Не ИспользоватьТекущийСертификат;
		Элементы.ГруппаИнформацияОТекущемСертификате.Видимость = ИспользоватьТекущийСертификат;
		
		Элементы.ГруппаТипСертификата.Доступность = ЗначениеЗаполнено(ДоменПользователя);
	Иначе
		Элементы.ДоменПользователя.Доступность = Ложь;
		Элементы.ГруппаТипСертификата.Доступность = Ложь;
		Элементы.ГруппаЗагрузкаСертификата.Видимость = Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти