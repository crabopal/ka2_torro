Функция ДлительнаяОперацияОбновитьНастройкиВитрины()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыОперации = Новый Структура();
	ПараметрыОперации.Вставить("СостояниеМастера", СостояниеМастера());
	ПараметрыОперации.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин);
	ПараметрыОперации.Вставить("СертификатДоменаПользователя", СертификатДоменаПользователя);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СНастройка.ОбновитьНастройкиВитриныВФоновомЗадании",
