&НаКлиенте
Процедура УстановитьТекущийШагМастераВГруппеДекорации(ТекущийШаг)
	
	ШагиМастера = Новый Структура;
	ШагиМастера.Вставить("НазваниеВитрины");
	ШагиМастера.Вставить("ОписаниеВитрины");
	ШагиМастера.Вставить("НастройкаВитрины");
	ШагиМастера.Вставить("ДопНастройкаВитрины");
	ШагиМастера.Вставить("НастройкаДоставки");
	ШагиМастера.Вставить("ПодготовкаВитрины", Не ПовторнаяНастройка);
	ШагиМастера.Вставить("ПодключениеУведомлений");
	ШагиМастера.Вставить("СоответствиеСтатусовЗаказов");
	ШагиМастера.Вставить("НастройкаВыгрузки");
	ШагиМастера.Вставить("ПравилаОтображения");
	ШагиМастера.Вставить("ПроверкаПараметровВыгрузки");
	ШагиМастера.Вставить("ВыгрузкаДанных");
	ШагиМастера.Вставить("Завершение");
	
	ТекущийШагУстановлен = Ложь;
	Для Каждого ШагМастера Из ШагиМастера Цикл
		Если ШагМастера.Ключ = ТекущийШаг Тогда
			Элементы["ПанельДекорации" + ШагМастера.Ключ].ТекущаяСтраница = Элементы["СтраницаДекорации" + ШагМастера.Ключ + "Текущая"];
			Элементы["ДекорацияНадписьШаг" + ШагМастера.Ключ].Доступность = Истина;
			ТекущийШагУстановлен = Истина;
		ИначеЕсли ТекущийШагУстановлен Тогда
			Элементы["ПанельДекорации" + ШагМастера.Ключ].ТекущаяСтраница = Элементы["СтраницаДекорации" + ШагМастера.Ключ + "Следующая"];
			Элементы["ДекорацияНадписьШаг" + ШагМастера.Ключ].Доступность = Ложь;
		Иначе
			Элементы["ПанельДекорации" + ШагМастера.Ключ].ТекущаяСтраница = Элементы["СтраницаДекорации" + ШагМастера.Ключ + "Предыдущая"];
			Элементы["ДекорацияНадписьШаг" + ШагМастера.Ключ].Доступность = Ложь;
		КонецЕсли;
		
		Если ШагМастера.Значение <> Неопределено Тогда
			Элементы["ГруппаДекорации" + ШагМастера.Ключ].Видимость = ШагМастера.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

