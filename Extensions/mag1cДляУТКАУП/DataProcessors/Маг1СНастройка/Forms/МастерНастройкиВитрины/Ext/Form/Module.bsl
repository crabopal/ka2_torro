#Область РаботаСНастройкамиВитрины

&НаСервере
Функция НастройкиВитрины()
	
	Настройки = Маг1СИнтеграцияСлужебный.СтруктураНастройкиВитрины();
	Настройки.ЛогинИПП = ЛогинИПП;
	
	ЗаполнитьЗначенияСвойств(Настройки.ОсновныеНастройки, ЭтотОбъект);
	
	Настройки.ОсновныеНастройки.Домен = Прав(ИмяДоменаДляРегистрацииВитрины, СтрДлина(ИмяДоменаДляРегистрацииВитрины) - 1);
	
	Если ЗначениеЗаполнено(АдресКартинкиЛоготипа) Тогда
		Настройки.ОсновныеНастройки.ДанныеКартинкиЛоготипа = ПолучитьИзВременногоХранилища(АдресКартинкиЛоготипа);
	КонецЕсли;
	
	НастройкиУведомлений = Настройки.ОсновныеНастройки.НастройкиУведомлений;
	ЗаполнитьЗначенияСвойств(НастройкиУведомлений, ЭтотОбъект);
	
	НастройкиДоставки = Настройки.ОсновныеНастройки.НастройкиДоставки;
	
	// Самовывоз
	Если СамовывозВариантРасчетаСтоимости <> Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Фиксированная() Тогда
		СамовывозСтоимость = 0;
	КонецЕсли;
	Если СамовывозМинимальнаяСуммаЗаказаПереключатель <> Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена() Тогда
		СамовывозМинимальнаяСуммаЗаказа = 0;
	КонецЕсли;
	
	НастройкиДоставки.Самовывоз.Использование           = ИспользоватьДоставкаСамовывоз;
	НастройкиДоставки.Самовывоз.УсловияДоставки         = СамовывозУсловия;
	НастройкиДоставки.Самовывоз.Стоимость               = СамовывозСтоимость;
	НастройкиДоставки.Самовывоз.ВариантРасчетаСтоимости = СамовывозВариантРасчетаСтоимости;
	НастройкиДоставки.Самовывоз.РежимРаботы             = РежимРаботы;
	НастройкиДоставки.Самовывоз.МинимальнаяСуммаЗаказа  = СамовывозМинимальнаяСуммаЗаказа;
	НастройкиДоставки.Самовывоз.ОтображатьЖелаемуюДату  = СамовывозОтображатьЖелаемуюДату;
	
	ЗаполнитьВариантыОплатыПриСамовывозе(НастройкиДоставки.Самовывоз.ВариантыОплаты);
	
	// КурьерскаяДоставка
	Если КурьерскаяДоставкаВариантРасчетаСтоимости <> Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Фиксированная() Тогда
		КурьерскаяДоставкаСтоимость = 0;
	КонецЕсли;
	Если КурьерскаяДоставкаМинимальнаяСуммаЗаказаПереключатель <> Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена() Тогда
		КурьерскаяДоставкаМинимальнаяСуммаЗаказа = 0;
	КонецЕсли;
	
	НастройкиДоставки.КурьерскаяДоставка.Использование           = ИспользоватьДоставкаКурьерскаяДоставка;
	НастройкиДоставки.КурьерскаяДоставка.УсловияДоставки         = КурьерскаяДоставкаУсловия;
	НастройкиДоставки.КурьерскаяДоставка.Стоимость               = КурьерскаяДоставкаСтоимость;
	НастройкиДоставки.КурьерскаяДоставка.ВариантРасчетаСтоимости = КурьерскаяДоставкаВариантРасчетаСтоимости;
	НастройкиДоставки.КурьерскаяДоставка.МинимальнаяСуммаЗаказа  = КурьерскаяДоставкаМинимальнаяСуммаЗаказа;
	НастройкиДоставки.КурьерскаяДоставка.ОтображатьЖелаемуюДату  = КурьерскаяДоставкаОтображатьЖелаемуюДату;
	
	ЗаполнитьВариантыОплатыПриКурьерскойДоставке(НастройкиДоставки.КурьерскаяДоставка.ВариантыОплаты);
	
	// ТранспортнаяКомпания
	Если ТранспортнаяКомпанияВариантРасчетаСтоимости <> Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Фиксированная() Тогда
		ТранспортнаяКомпанияСтоимость = 0;
	КонецЕсли;
	Если ТранспортнаяКомпанияМинимальнаяСуммаЗаказаПереключатель <> Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена() Тогда
		ТранспортнаяКомпанияМинимальнаяСуммаЗаказа = 0;
	КонецЕсли;
	
	НастройкиДоставки.ТранспортнаяКомпания.Использование           = ИспользоватьДоставкаТранспортнаяКомпания;
	НастройкиДоставки.ТранспортнаяКомпания.УсловияДоставки         = ТранспортнаяКомпанияУсловия;
	НастройкиДоставки.ТранспортнаяКомпания.Стоимость               = ТранспортнаяКомпанияСтоимость;
	НастройкиДоставки.ТранспортнаяКомпания.ВариантРасчетаСтоимости = ТранспортнаяКомпанияВариантРасчетаСтоимости;
	НастройкиДоставки.ТранспортнаяКомпания.МинимальнаяСуммаЗаказа  = ТранспортнаяКомпанияМинимальнаяСуммаЗаказа;
	НастройкиДоставки.ТранспортнаяКомпания.ОтображатьЖелаемуюДату  = ТранспортнаяКомпанияОтображатьЖелаемуюДату;
	
	ЗаполнитьВариантыОплатыПриДоставкеТранспортнойКомпанией(НастройкиДоставки.ТранспортнаяКомпания.ВариантыОплаты);
	
	// Служебные настройки.
	ЗаполнитьЗначенияСвойств(
		Настройки.ДополнительныеНастройки,
		ЭтотОбъект,
		"УчитыватьОстаткиТолькоПоВыбраннымСкладам,ИерархияПо,СегментНоменклатуры");
	
	ЗаполнитьЗначенияСвойств(Настройки.ОсновныеНастройки.ПараметрыУчета, ЭтотОбъект);
	ЗаполнитьЗначенияСвойств(Настройки.ДополнительныеНастройки.ПравилаОтображенияТоваров, ЭтотОбъект);
	
	ЗаполнитьОтборыКаталогаТоваров(Настройки.ДополнительныеНастройки.ОтборыКаталогаТоваров);
	ЗаполнитьСоответствияСтатусовЗаказов(Настройки.ДополнительныеНастройки.СоответствияСтатусовЗаказов);
	ЗаполнитьВыгружаемыеСвойстваТоваров(Настройки.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров);
	
	Для Каждого СтрЗнч Из СкладыОстатков Цикл
		Если СтрЗнч.Пометка Тогда
			Настройки.ДополнительныеНастройки.СкладыОстатков.Добавить(СтрЗнч.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.СохранитьВНастройкиЗначкиНоменклатуры(ЭтотОбъект, Настройки.ОсновныеНастройки);
	
	Возврат Настройки;
	
КонецФункции

&НаСервере
Процедура ВосстановитьНастройкиВитрины(ОсновныеНастройки, ДополнительныеНастройки = Неопределено)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ОсновныеНастройки);
	
	ИспользоватьМакс      = ЗначениеЗаполнено(ЧатМаксМагазина);
	ИспользоватьWhatsApp  = ЗначениеЗаполнено(WhatsAppМагазина);
	ИспользоватьViber     = ЗначениеЗаполнено(ViberМагазина);
	ИспользоватьTelegram  = ЗначениеЗаполнено(TelegramМагазина);
	ИспользоватьTelegramКанал = ЗначениеЗаполнено(TelegramКаналМагазина);
	ИспользоватьEmail     = ЗначениеЗаполнено(EmailМагазина);
	ИспользоватьVK        = ЗначениеЗаполнено(VKМагазина);
	ИспользоватьInstagram = ЗначениеЗаполнено(InstagramМагазина);
	ИспользоватьFacebook  = ЗначениеЗаполнено(FacebookМагазина);
	ИспользоватьЧатБитрикс24 = ЗначениеЗаполнено(ЧатБитрикс24ИмяПользователяМагазина);
	ИспользоватьТелефон2  = ЗначениеЗаполнено(ТелефонМагазина2);
	ИспользоватьТелефон3  = ЗначениеЗаполнено(ТелефонМагазина3);
	
	ВосстановитьНастройкиДоставки(ОсновныеНастройки.НастройкиДоставки);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОсновныеНастройки.НастройкиУведомлений);
	
	УведомленияПодключены = Не ПустаяСтрока(ИдентификаторОбсуждения);
	
	ИспользоватьУведомленияПоПочте = ЗначениеЗаполнено(EMailДляОтправкиУведомленийОЗаказах);
	
	Если ЗначениеЗаполнено(ОсновныеНастройки.ДанныеКартинкиЛоготипа) Тогда
		АдресДанных = ПоместитьВоВременноеХранилище(ОсновныеНастройки.ДанныеКартинкиЛоготипа, УникальныйИдентификатор);
		УстановитьАдресКартинкиЛоготипа(АдресКартинкиЛоготипа, АдресДанных, УникальныйИдентификатор);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(УзелОбмена) Тогда 
		НомерОтправленного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерОтправленного");
		Если ТипЗнч(НомерОтправленного) = Тип("Число")
			И РежимФормы <> Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда
			ПовторнаяНастройка = НомерОтправленного > 0 ИЛИ СтраницаПереходаСохраненная = "СтраницаЗавершение";
		Иначе
			ПовторнаяНастройка = Ложь;
		КонецЕсли;
	Иначе
		ПовторнаяНастройка = Ложь;
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого КлючЗначение из ОсновныеНастройки.ПараметрыУчета Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			ЭтотОбъект[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.ВосстановитьИзНастроекЗначкиНоменклатуры(ЭтотОбъект, ОсновныеНастройки);
	
	Если ДополнительныеНастройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДополнительныеНастройки,,"СкладыОстатков,ВыгружаемыеСвойстваТоваров");
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДополнительныеНастройки.ПравилаОтображенияТоваров);
		
		ВосстановитьОтборыКаталогаТоваров(ОсновныеНастройки, ДополнительныеНастройки);
		ВосстановитьСоответствияСтатусовЗаказов(ДополнительныеНастройки.СоответствияСтатусовЗаказов);
		ВосстановитьСкладыОстатков(ДополнительныеНастройки.СкладыОстатков);
		
		ВосстановитьВыгружаемыеСвойстваТоваров(ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьЭлементНастройкиУчетнойСистемы(ИмяПараметраУчета, ИмяЭлементаУправления = "")
	
	Настройка = НастройкиУчетнойСистемы[ИмяПараметраУчета];
	
	Если ПустаяСтрока(ИмяЭлементаУправления) Тогда
		ЭлементУправления = Элементы[ИмяПараметраУчета];
	Иначе
		ЭлементУправления = Элементы[ИмяЭлементаУправления];
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Настройка.ОграничениеТипа) Тогда
		ЭлементУправления.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ЭлементУправления.ОграничениеТипа = Настройка.ОграничениеТипа;
	ЭлементУправления.ВыбиратьТип = (Настройка.ОграничениеТипа.Типы().Количество() > 1); 
	
	Если ЗначениеЗаполнено(Настройка.ПараметрыВыбора)
		И Настройка.ПараметрыВыбора.Количество() > 0 Тогда
		
		ЭлементУправления.ПараметрыВыбора = Маг1СИнтеграция.ВФиксМассивПараметровВыбора(Настройка.ПараметрыВыбора);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.Заголовок) Тогда
		ЭлементУправления.Заголовок = Настройка.Заголовок;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.РасширеннаяПодсказка) Тогда
		ЭлементУправления.РасширеннаяПодсказка.Заголовок = Настройка.РасширеннаяПодсказка;
	КонецЕсли;
	
КонецПроцедуры                                                

&НаСервере
Процедура ВосстановитьНастройкиДоставки(Настройки)
	
	// Самовывоз
	ИспользоватьДоставкаСамовывоз = Настройки.Самовывоз.Использование;
	
	СамовывозУсловия = Настройки.Самовывоз.УсловияДоставки;
	РежимРаботы      = Настройки.Самовывоз.РежимРаботы;
	СамовывозСтоимость       = Настройки.Самовывоз.Стоимость;
	СамовывозВариантРасчетаСтоимости = Настройки.Самовывоз.ВариантРасчетаСтоимости;
	СамовывозМинимальнаяСуммаЗаказа  = Настройки.Самовывоз.МинимальнаяСуммаЗаказа;
	СамовывозОтображатьЖелаемуюДату  = Настройки.Самовывоз.ОтображатьЖелаемуюДату;
	Если СамовывозМинимальнаяСуммаЗаказа = 0 Тогда
		СамовывозМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Любая();
	Иначе
		СамовывозМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена();
	КонецЕсли;
	
	ВосстановитьВариантыОплатыПриСамовывозе(Настройки.Самовывоз.ВариантыОплаты);
	
	// КурьерскаяДоставка
	ИспользоватьДоставкаКурьерскаяДоставка = Настройки.КурьерскаяДоставка.Использование;
	
	КурьерскаяДоставкаУсловия                 = Настройки.КурьерскаяДоставка.УсловияДоставки;
	КурьерскаяДоставкаСтоимость               = Настройки.КурьерскаяДоставка.Стоимость;
	КурьерскаяДоставкаВариантРасчетаСтоимости = Настройки.КурьерскаяДоставка.ВариантРасчетаСтоимости;
	КурьерскаяДоставкаМинимальнаяСуммаЗаказа  = Настройки.КурьерскаяДоставка.МинимальнаяСуммаЗаказа;
	КурьерскаяДоставкаОтображатьЖелаемуюДату  = Настройки.КурьерскаяДоставка.ОтображатьЖелаемуюДату;
	Если КурьерскаяДоставкаМинимальнаяСуммаЗаказа = 0 Тогда
		КурьерскаяДоставкаМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Любая();
	Иначе
		КурьерскаяДоставкаМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена();
	КонецЕсли;
	
	ВосстановитьВариантыОплатыПриКурьерскойДоставке(Настройки.КурьерскаяДоставка.ВариантыОплаты);
	
	// ТранспортнаяКомпания
	ИспользоватьДоставкаТранспортнаяКомпания = Настройки.ТранспортнаяКомпания.Использование;
	
	ТранспортнаяКомпанияУсловия                 = Настройки.ТранспортнаяКомпания.УсловияДоставки;
	ТранспортнаяКомпанияСтоимость               = Настройки.ТранспортнаяКомпания.Стоимость;
	ТранспортнаяКомпанияВариантРасчетаСтоимости = Настройки.ТранспортнаяКомпания.ВариантРасчетаСтоимости;
	ТранспортнаяКомпанияМинимальнаяСуммаЗаказа  = Настройки.ТранспортнаяКомпания.МинимальнаяСуммаЗаказа;
	ТранспортнаяКомпанияОтображатьЖелаемуюДату  = Настройки.ТранспортнаяКомпания.ОтображатьЖелаемуюДату;
	Если ТранспортнаяКомпанияМинимальнаяСуммаЗаказа = 0 Тогда
		ТранспортнаяКомпанияМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Любая();
	Иначе
		ТранспортнаяКомпанияМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена();
	КонецЕсли;
	
	ВосстановитьВариантыОплатыПриДоставкеТранспортнойКомпанией(Настройки.ТранспортнаяКомпания.ВариантыОплаты);
	
КонецПроцедуры

