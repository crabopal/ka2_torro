			НСтр("ru = 'Сохранить настройки'"));
	
	УстановитьВидимостьЭлементовДоставки(ЭтотОбъект);
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция Подключаемый_СтраницаНастройкаДоставки_ПриПереходеДалее(Отказ)
	
	Если Не ИспользоватьДоставкаСамовывоз
		И Не ИспользоватьДоставкаКурьерскаяДоставка
		И Не ИспользоватьДоставкаТранспортнаяКомпания Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Выберите хотя бы один способ доставки'"), "ИспользоватьДоставкаСамовывоз", Отказ);
		
	Иначе
		
		Если ИспользоватьДоставкаСамовывоз Тогда
			
			Если Не ЗначениеЗаполнено(РежимРаботы) Тогда
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните режим работы магазина.'"), "РежимРаботы", Отказ);
			КонецЕсли;
			
			Если Не ОплатаПриСамовывозеНаличными
				И Не ОплатаПриСамовывозеКартой
				И Не ОплатаПриСамовывозеОнлайнПереводом
				И Не ОплатаПриСамовывозеПереводомНаСчет
				И Не ОплатаПриСамовывозеЮКасса
				И Не ОплатаПриСамовывозеСБП Тогда
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Выберите хотя бы один способ оплаты заказов.'"), "ОплатаПриСамовывозеНаличными", Отказ);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СамовывозУсловия) Тогда
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните условия самовывоза заказов из магазина.'"), "СамовывозУсловия", Отказ);
			КонецЕсли;
			
			Если СамовывозВариантРасчетаСтоимости = Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Фиксированная() 
				И СамовывозСтоимость = 0 Тогда
				
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите стоимость доставки'"), "СамовывозСтоимость", Отказ);
			КонецЕсли;
			
			Если СамовывозМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена()
				И СамовывозМинимальнаяСуммаЗаказа = 0 Тогда
				
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите минимальную сумму заказа'"), "СамовывозМинимальнаяСуммаЗаказа", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИспользоватьДоставкаКурьерскаяДоставка Тогда
			
			Если Не ЗначениеЗаполнено(КурьерскаяДоставкаУсловия) Тогда
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните условия курьерской доставки.'"), "КурьерскаяДоставкаУсловия", Отказ);
			КонецЕсли;
			
			Если Не ОплатаПриКурьерскойДоставкеНаличными
				И Не ОплатаПриКурьерскойДоставкеКартой
				И Не ОплатаПриКурьерскойДоставкеОнлайнПереводом
				И Не ОплатаПриКурьерскойДоставкеПереводомНаСчет
				И Не ОплатаПриКурьерскойДоставкеЮКасса
				И Не ОплатаПриКурьерскойДоставкеСБП Тогда
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Выберите хотя бы один способ оплаты заказов.'"), "ОплатаПриКурьерскойДоставкеНаличными", Отказ);
			КонецЕсли;
			
			Если КурьерскаяДоставкаВариантРасчетаСтоимости = Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Фиксированная() 
				И КурьерскаяДоставкаСтоимость = 0 Тогда
				
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите стоимость доставки'"), "КурьерскаяДоставкаСтоимость", Отказ);
			КонецЕсли;
			
			Если КурьерскаяДоставкаМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена()
				И КурьерскаяДоставкаМинимальнаяСуммаЗаказа = 0 Тогда
				
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите минимальную сумму заказа'"), "КурьерскаяДоставкаМинимальнаяСуммаЗаказа", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИспользоватьДоставкаТранспортнаяКомпания Тогда
			
			Если Не ОплатаПриДоставкеТранспортнойКомпаниейКартой
				И Не ОплатаПриДоставкеТранспортнойКомпаниейНаличными
				И Не ОплатаПриДоставкеТранспортнойКомпаниейПереводомНаСчет
				И Не ОплатаПриДоставкеТранспортнойКомпаниейЮКасса
				И Не ОплатаПриДоставкеТранспортнойКомпаниейСБП Тогда
				
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Выберите хотя бы один способ оплаты заказов.'"), "ОплатаПриДоставкеТранспортнойКомпаниейНаличными", Отказ);
			КонецЕсли;
			
			Если ТранспортнаяКомпанияВариантРасчетаСтоимости = Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Фиксированная() 
				И ТранспортнаяКомпанияСтоимость = 0 Тогда
				
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите стоимость доставки'"), "ТранспортнаяКомпанияСтоимость", Отказ);
			КонецЕсли;
			
			Если ТранспортнаяКомпанияМинимальнаяСуммаЗаказаПереключатель = Маг1СПеречисления.МинимальнаяСуммаЗаказа_Назначена()
				И ТранспортнаяКомпанияМинимальнаяСуммаЗаказа = 0 Тогда
				
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите минимальную сумму заказа'"), "ТранспортнаяКомпанияМинимальнаяСуммаЗаказа", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если (СамовывозВариантРасчетаСтоимости <> Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Бесплатно()
					И ИспользоватьДоставкаСамовывоз
				Или КурьерскаяДоставкаВариантРасчетаСтоимости <> Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Бесплатно()
					И ИспользоватьДоставкаКурьерскаяДоставка
				Или ТранспортнаяКомпанияВариантРасчетаСтоимости <> Маг1СПеречисления.ВариантыРасчетаСтоимостиДоставки_Бесплатно()
					И ИспользоватьДоставкаТранспортнаяКомпания)
			И Не ЗначениеЗаполнено(УслугаДоставки) Тогда
			
			СообщитьПользователюНаКлиенте(НСтр("ru = 'Выберите услугу по доставке заказов.'"), "УслугаДоставки", Отказ);
		КонецЕсли;
			
		Если  ЕстьОплатаСБП(ЭтотОбъект)
			И Не ЗначениеЗаполнено(НастройкаСБП) Тогда
			СообщитьПользователюНаКлиенте(НСтр("ru = 'Выберите настройку системы быстрых платежей'"), "НастройкаСБП", Отказ);
		КонецЕсли;
		
		Если ЕстьОплатаПереводомНаСчет(ЭтотОбъект)
			И (СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_АвтоматическиНаВитрине()
				Или ОплатаПоСсылкеПереводомНаСчет)
			И Не ЗначениеЗаполнено(БанковскийСчет) Тогда
			СообщитьПользователюНаКлиенте(НСтр("ru = 'Выберите банковский счет, по которому на витрине будет формироваться счет на оплату'"), "БанковскийСчет", Отказ);
		КонецЕсли;
		
		Если ЕстьОплатаПереводомНаСчет(ЭтотОбъект)
			И (СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_АвтоматическиНаВитрине()
				Или ОплатаПоСсылкеПереводомНаСчет)
			И СтрДлина(СокрЛП(ТекстУсловийВСчетеНаОплату)) < 10 Тогда
			СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните текст условий, которые будут распечатываться в счете на оплату на витрине.'"), "ТекстУсловийВСчетеНаОплату", Отказ);
		КонецЕсли;
		
		Если ЕстьОплатаПереводомНаСчет(ЭтотОбъект)
			И (СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_АвтоматическиНаВитрине()
				Или ОплатаПоСсылкеПереводомНаСчет) Тогда
			Если Не ЗначениеЗаполнено(EmailМагазина) Тогда
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите адрес электронной почты, который будет напечатан на счете на оплату'"), "EmailМагазина", Отказ);
			ИначеЕсли Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(EmailМагазина) Тогда	
				СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите корректный E-mail.'"), "EmailМагазина", Отказ);
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СохранитьСостояниеМастера();
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция Подключаемый_СтраницыСохраненияНастроекВитриныОжидание_ПриОткрытии(Отказ, ПропуститьСтраницу, Знач ЭтоПереходДалее)
	
	Заголовок = "";
	
	Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин)
		Или РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда
			
		Заголовок = НСтр("ru = 'Создание веб-витрины'");
		Элементы.ДекорацияНадписьСохранениеНастроекВитрины.Заголовок = НСтр("ru =
			|'Выполняется создание веб-витрины.
			|Пожалуйста, подождите...'");
	Иначе
		
		Заголовок = НСтр("ru = 'Обновление настроек веб-витрины'");
		Элементы.ДекорацияНадписьСохранениеНастроекВитрины.Заголовок = НСтр("ru =
			|'Выполняется обновление настроек веб-витрины.
			|Пожалуйста, подождите...'");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция Подключаемый_СтраницаПодготовкаВитриныОжидание_ДлительнаяОперация(Отказ, ПерейтиДалее)
	
	ПерейтиДалее = Ложь;
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин)
		И РежимФормы <> Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда
		
		Если Не ПовторнаяНастройка Тогда
			ПриНачалеОбновленияНастроекВитрины();
		Иначе
			Если ИзменилисьПараметрыУчета Тогда
				ПриНачалеВыгрузкиДанныхНаСайт();
			Иначе
				ПриНачалеОбновленияНастроекВитрины();
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ПриНачалеСозданияВитрины();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция Подключаемый_СтраницаПодготовкаВитриныРезультат_ПриОткрытии(Отказ, ПропуститьСтраницу, Знач ЭтоПереходДалее)
	
	Заголовок = НСтр("ru='Создание веб-витрины'");
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин)
		И ПовторнаяНастройка Тогда
		ПропуститьСтраницу = Истина;
	ИначеЕсли Маг1СИнтеграцияСлужебныйКлиентСервер.СозданиеВитриныОтложено(СтрокаСпискаВитрин) Тогда
		Элементы.ПанельПодготовкаВитриныРезультат.ТекущаяСтраница = Элементы.СтраницаПодготовкаОтложена;
		Элементы.КомандаДалееПодготовкаВитриныРезультат.Видимость = Ложь;
		
		Элементы.БаннерПодготовкаОтложенаОписание.Заголовок = НСтр("ru='Заявка на создание веб-витрины принята'");
		ЗакрытьФормуБезусловно = Истина;
	ИначеЕсли Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин) Тогда
		Элементы.ПанельПодготовкаВитриныРезультат.ТекущаяСтраница = Элементы.СтраницаВитринаПодготовлена;
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.ЭтоВариантИнтерфейса85() Тогда 
			Элементы.КартинкаПодготовкаВитриныУспешна.Видимость = Ложь;
		КонецЕсли;
		
		Если ЭтоПеренастройкаВитрины Тогда
			Элементы.БаннерВитринаПодготовленаОписание.Заголовок = НСтр("ru = 'Веб-витрина перенастроена на эту базу'");
			
			Элементы.ДекорацияНадписьСтатусВитриныСоздана.Заголовок = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = 'Адрес витрины не изменился: <a href=""%1"">%2</a> 
				|Теперь нужно перенастроить уведомления о новых заказах и перевыгрузить товары.'"),
				АдресСайтаВитрины,
				ПолноеИмяВитрины);
		Иначе
			Элементы.БаннерВитринаПодготовленаОписание.Заголовок = НСтр("ru = 'Веб-витрина создана'");
			
			Элементы.ДекорацияНадписьСтатусВитриныСоздана.Заголовок = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = 'Она расположена по адресу: <a href=""%1"">%2</a> 
				|Осталось включить уведомления о новых заказах, наполнить ее товарами и можно начинать принимать заказы
				|через интернет.'"),
				АдресСайтаВитрины,
				ПолноеИмяВитрины);
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция Подключаемый_СтраницаПодключениеУведомлений_ПриОткрытии(Отказ, ПропуститьСтраницу, Знач ЭтоПереходДалее)
	
	Заголовок = НСтр("ru='Уведомления от веб-витрины и веб-чат'");
	
	ОтобразитьEMailДляОтправкиУведомленийИНомерСчетчика();
	
	Элементы.ДекорацияПодключениеУведомленийПодсказка.Видимость = Не СистемаВзаимодействийПодключена;
	
	Если ПовторнаяНастройка
		И НЕ УведомленияПодключены Тогда
		Элементы.КомандаДалееПодключениеУведомлений.Заголовок = НСтр("ru='Включить уведомления'");
	КонецЕсли;
	
	Если ПовторнаяНастройка 
		И УведомленияПодключены 
		И СистемаВзаимодействийПодключена Тогда
		Элементы.КомандаДалееПодключениеУведомлений.Заголовок = НСтр("ru='Сохранить'");
	КонецЕсли;
	
	Если ПовторнаяНастройка Тогда
		Элементы.КомандаНазадПодключениеУведомлений.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.КомандаПропуститьПодключениеУведомлений.Видимость = Не ПовторнаяНастройка;
	
	ЗагрузитьУчастниковОбсуждения();
	WebChat_Использовать = ЗначениеЗаполнено(WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия);
	
	Элементы.ИспользоватьУведомленияЧерезСВ.Доступность = СистемаВзаимодействийПодключена;
	Элементы.WebChat_Использовать.Доступность = СистемаВзаимодействийПодключена;
	
	Элементы.ГруппаУведомленияЧерезСВ.Доступность = ИспользоватьУведомленияЧерезСВ И СистемаВзаимодействийПодключена;
	Элементы.ГруппаПодключениеЧатаНаСайте.Доступность         = WebChat_Использовать И СистемаВзаимодействийПодключена;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция Подключаемый_СтраницаПодключениеУведомлений_ПриПереходеДалее(Отказ)
	
	Если ПропущенаСтраница Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИспользоватьУведомленияЧерезСВ 
		И НЕ СистемаВзаимодействийПодключена Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru='Для получения уведомлений от веб-витрины необходимо подключить информационную базу к системе взаимодействий.'"),"ИспользоватьУведомленияЧерезСВ",Отказ);
	КонецЕсли;
	
	Если ИспользоватьУведомленияЧерезСВ
		И ПолучателиУведомлений.Количество() = 0 Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru='Выберите пользователей, которые должны получать оповещения о загруженных с витрины заказах.'"),ПолучателиУведомлений,Отказ);
	КонецЕсли;
	
	Если ПустаяСтрока(EMailДляОтправкиУведомлений) Тогда
		СообщитьПользователюНаКлиенте(
			НСтр("ru = 'Заполните email для важных сообщений о работе веб-витрины'"), 
			EMailДляОтправкиУведомлений,
			Отказ);
	ИначеЕсли Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(EMailДляОтправкиУведомлений) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Некорректный адрес электронной почты'"),EMailДляОтправкиУведомлений,Отказ);
	КонецЕсли;
		
	Если ИспользоватьУведомленияПоПочте Тогда
		Если ПустаяСтрока(EMailДляОтправкиУведомленийОЗаказах) Тогда
			СообщитьПользователюНаКлиенте(
				НСтр("ru = 'Заполните email для уведомлений о заказах'"), 
				EMailДляОтправкиУведомленийОЗаказах,
				Отказ);
		ИначеЕсли Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(EMailДляОтправкиУведомленийОЗаказах) Тогда
			СообщитьПользователюНаКлиенте(НСтр("ru = 'Некорректный адрес электронной почты'"),EMailДляОтправкиУведомленийОЗаказах,Отказ);
		КонецЕсли;	
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		Если Не ИспользоватьУведомленияЧерезСВ Тогда
			ПолучателиУведомлений.Очистить();
		КонецЕсли;
		
		Если Не ИспользоватьУведомленияПоПочте Тогда
			EMailДляОтправкиУведомленийОЗаказах = ""
		КонецЕсли;
		
		Попытка
			СоздатьОбновитьОбсуждение();
			СохранитьСостояниеМастера();
		Исключение
			Отказ = Истина;
			Маг1СИнтеграцияСлужебныйКлиент.ПоказатьПредупреждениеОбОшибке();
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

