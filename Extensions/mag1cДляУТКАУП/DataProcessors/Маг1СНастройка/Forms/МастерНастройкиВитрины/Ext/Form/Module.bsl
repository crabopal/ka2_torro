	Если ПорядковыйНомерПерехода = ТаблицаПереходов.НайтиСтроки(Новый Структура("ИмяОсновнойСтраницы", "СтраницаЗавершение"))[0].ПорядковыйНомерПерехода
		И ПовторнаяНастройка Тогда
		ВыполнитьПереходКСтранице("СтраницаЗавершение");	
	Иначе		
		ИзменитьПорядковыйНомерПерехода(-1);
	КонецЕсли;
