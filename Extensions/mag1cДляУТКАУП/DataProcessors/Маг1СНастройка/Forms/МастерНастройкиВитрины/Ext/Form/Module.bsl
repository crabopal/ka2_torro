#Область ОбработчикиСобытийЭлементовТаблицыТаблицаСоответствияСтатусовЗаказов

&НаКлиенте
Процедура ТаблицаСоответствияСтатусовЗаказовСтатусыОбъектовИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ВыбранныеСтатусыДляДругихСтрок = Новый Массив();
	ТекущиеВыбранныеСтатусы        = Новый Массив();
	
	ТекущиеДанные = Элементы.ТаблицаСоответствияСтатусовЗаказов.ТекущиеДанные;
	
	Для Каждого СтрТабл Из ТаблицаСоответствияСтатусовЗаказов Цикл
		Для Каждого СтрЗнач из СтрТабл.СтатусыОбъектовИБ Цикл
			Если СтрТабл.СтатусОбъектаФормата = ТекущиеДанные.СтатусОбъектаФормата Тогда
				ТекущиеВыбранныеСтатусы.Добавить(СтрЗнач.Значение);
			Иначе
				ВыбранныеСтатусыДляДругихСтрок.Добавить(СтрЗнач.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ОписаниеОповещния = Новый ОписаниеОповещения("ТаблицаСоответствияСтатусовЗаказовСтатусыОбъектовИБНачалоВыбораЗавершение",
												ЭтотОбъект);
	ОткрытьФорму("Обработка.Маг1СНастройка.Форма.ВыборСтатусов",
				Новый Структура("ВыбранныеСтатусыДляДругихСтрок,ТекущиеВыбранныеСтатусы", ВыбранныеСтатусыДляДругихСтрок, ТекущиеВыбранныеСтатусы),
				ЭтотОбъект,
				,
				,
				,
				ОписаниеОповещния,
				 );
				
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствияСтатусовЗаказовСтатусыОбъектовИБНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаСоответствияСтатусовЗаказов.ТекущиеДанные;
	ТекущиеДанные.СтатусыОбъектовИБ.Очистить();
	ТекущиеДанные.СтатусыОбъектовИБ.ЗагрузитьЗначения(Результат);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПоставляемыеОбработчикиПомощника

&НаКлиенте
Процедура ИзменитьПорядковыйНомерПерехода(Итератор)
	
	ОчиститьСообщения();

	Если (Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаЗавершение
		 	И Итератор > 0) Тогда 
		ВыполнитьПереходКСтранице("СтраницаЗавершение");
		Возврат;
	КонецЕсли;	
	
	УстановитьПорядковыйНомерПерехода(ПорядковыйНомерПерехода + Итератор);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПорядковыйНомерПерехода(Знач Значение)
	
	ЭтоПереходДалее = (Значение > ПорядковыйНомерПерехода);
	
	ПорядковыйНомерПерехода = Значение;
	
	Если ПорядковыйНомерПерехода < 0 Тогда
		
		ПорядковыйНомерПерехода = 0;
		
	КонецЕсли;
	
	ПорядковыйНомерПереходаПриИзменении(ЭтоПереходДалее);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядковыйНомерПереходаПриИзменении(Знач ЭтоПереходДалее)
	
	ВычислитьВидимостьПанелиШаговМастера();
	
	// Выполняем обработчики событий перехода.
	ВыполнитьОбработчикиСобытийПерехода(ЭтоПереходДалее);
	
	// Устанавливаем отображение страниц.
	СтрокиПереходаТекущие = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ПорядковыйНомерПерехода));
	
	Если СтрокиПереходаТекущие.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не определена страница для отображения.'");
	КонецЕсли;
	
	СтрокаПереходаТекущая = СтрокиПереходаТекущие[0];
	
	Элементы.ПанельОсновная.ТекущаяСтраница  = Элементы[СтрокаПереходаТекущая.ИмяОсновнойСтраницы];
	УстановитьВидимостьТекущейГруппыКоманднойПанели(Элементы[СтрокаПереходаТекущая.ИмяСтраницыНавигации].Имя);
	
	Элементы.НадписьСоздатьНовуюВитрину.Видимость = Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаШагиМастера
													И СтрокаПереходаТекущая.ИмяШага = "Завершение"
	                                                И ПовторнаяНастройка
													И ПрофильПользователя.ЕстьВозможностьСозданияНовойВитрины;
													
	Элементы.НадписьПерейтиКСпискуВитрин.Видимость = Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаШагиМастера
													И СтрокаПереходаТекущая.ИмяШага = "Завершение"
	                                                И ПовторнаяНастройка
													И ПрофильПользователя.ЕстьДругиеВитрины;
													
	Если ПрофильПользователя.ЕстьДругиеВитрины Тогда
		Элементы.КомандаОтменаНачальнаяСтраница.Заголовок = НСтр("ru = 'Вернуться к списку витрин'");
	Иначе
		Элементы.КомандаОтменаНачальнаяСтраница.Заголовок = НСтр("ru = 'Отмена'");
	КонецЕсли;
													
	Если Не ПустаяСтрока(СтрокаПереходаТекущая.ИмяСтраницыДекорации) Тогда
		
		Элементы.ПанельДекорации.ТекущаяСтраница = Элементы[СтрокаПереходаТекущая.ИмяСтраницыДекорации];
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(СтрокаПереходаТекущая.ИмяШага) Тогда
		
		УстановитьТекущийШагМастераВГруппеДекорации(СтрокаПереходаТекущая.ИмяШага);
		
	КонецЕсли;
	
	// Устанавливаем текущую кнопку по умолчанию.
	КнопкаДалее = ПолучитьКнопкуФормыПоИмениКоманды(ТекущаяГруппаКоманднойПанели(), "КомандаДалее");
	
	Если КнопкаДалее <> Неопределено
		И КнопкаДалее.Видимость Тогда
		
		КнопкаДалее.КнопкаПоУмолчанию = Истина;
		
	Иначе
		
		КнопкаГотово = ПолучитьКнопкуФормыПоИмениКоманды(ТекущаяГруппаКоманднойПанели(), "КомандаГотово");
		
		Если КнопкаГотово <> Неопределено Тогда
			
			КнопкаГотово.КнопкаПоУмолчанию = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоПереходДалее И СтрокаПереходаТекущая.ДлительнаяОперация Тогда
		
		ПодключитьОбработчикОжидания("ВыполнитьОбработчикДлительнойОперации", 0.1, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработчикиСобытийПерехода(Знач ЭтоПереходДалее)
	
	// Обработчики событий переходов.
	Если ЭтоПереходДалее Тогда
		
		СтрокиПерехода = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ПорядковыйНомерПерехода - 1));
		
		Если СтрокиПерехода.Количество() > 0 Тогда
			
			СтрокаПерехода = СтрокиПерехода[0];
			
			// Обработчик ПриПереходеДалее.
			Если Не ПустаяСтрока(СтрокаПерехода.ИмяОбработчикаПриПереходеДалее)
				И Не СтрокаПерехода.ДлительнаяОперация Тогда
				
				ИмяПроцедуры = "Подключаемый_[ИмяОбработчика](Отказ)";
				ИмяПроцедуры = СтрЗаменить(ИмяПроцедуры, "[ИмяОбработчика]", СтрокаПерехода.ИмяОбработчикаПриПереходеДалее);
				
				Отказ = Ложь;
				
				Результат = Вычислить(ИмяПроцедуры);
				
				Если Отказ Тогда
					
					ПорядковыйНомерПерехода = ПорядковыйНомерПерехода - 1;
					Возврат;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		СтрокиПерехода = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ПорядковыйНомерПерехода + 1));
		
		Если СтрокиПерехода.Количество() > 0 Тогда
			
			СтрокаПерехода = СтрокиПерехода[0];
			
			// Обработчик ПриПереходеНазад.
			Если Не ПустаяСтрока(СтрокаПерехода.ИмяОбработчикаПриПереходеНазад)
				И Не СтрокаПерехода.ДлительнаяОперация Тогда
				
				ИмяПроцедуры = "Подключаемый_[ИмяОбработчика](Отказ)";
				ИмяПроцедуры = СтрЗаменить(ИмяПроцедуры, "[ИмяОбработчика]", СтрокаПерехода.ИмяОбработчикаПриПереходеНазад);
				
				Отказ = Ложь;
				
				Результат = Вычислить(ИмяПроцедуры);
				
				Если Отказ Тогда
					
					ПорядковыйНомерПерехода = ПорядковыйНомерПерехода + 1;
					Возврат;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокиПереходаТекущие = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ПорядковыйНомерПерехода));
	
	Если СтрокиПереходаТекущие.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не определена страница для отображения.'");
	КонецЕсли;
	
	СтрокаПереходаТекущая = СтрокиПереходаТекущие[0];
	
	Если СтрокаПереходаТекущая.ДлительнаяОперация И Не ЭтоПереходДалее Тогда
		ИзменитьПорядковыйНомерПерехода(-1);
		Возврат;
	КонецЕсли;
	
	// обработчик ПриОткрытии
	Если Не ПустаяСтрока(СтрокаПереходаТекущая.ИмяОбработчикаПриОткрытии) Тогда
		
		ИмяПроцедуры = "Подключаемый_[ИмяОбработчика](Отказ, ПропуститьСтраницу, ЭтоПереходДалее)";
		ИмяПроцедуры = СтрЗаменить(ИмяПроцедуры, "[ИмяОбработчика]", СтрокаПереходаТекущая.ИмяОбработчикаПриОткрытии);
		
		Отказ = Ложь;
		ПропуститьСтраницу = Ложь;
		
		Результат = Вычислить(ИмяПроцедуры);
		
		Если Отказ Тогда
			
			ПорядковыйНомерПерехода = ПорядковыйНомерПерехода - 1;
			Возврат;
			
		ИначеЕсли ПропуститьСтраницу Тогда
			
			Если ЭтоПереходДалее Тогда
				
				ИзменитьПорядковыйНомерПерехода(1);
				Возврат;
				
			Иначе
				
				ИзменитьПорядковыйНомерПерехода(-1);
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработчикДлительнойОперации()
	
	СтрокиПереходаТекущие = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ПорядковыйНомерПерехода));
	
	Если СтрокиПереходаТекущие.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не определена страница для отображения.'");
	КонецЕсли;
	
	СтрокаПереходаТекущая = СтрокиПереходаТекущие[0];
	
	// Обработчик ОбработкаДлительнойОперации.
	Если Не ПустаяСтрока(СтрокаПереходаТекущая.ИмяОбработчикаДлительнойОперации) Тогда
		
		ИмяПроцедуры = "Подключаемый_[ИмяОбработчика](Отказ, ПерейтиДалее)";
		ИмяПроцедуры = СтрЗаменить(ИмяПроцедуры, "[ИмяОбработчика]", СтрокаПереходаТекущая.ИмяОбработчикаДлительнойОперации);
		
		Отказ = Ложь;
		ПерейтиДалее = Истина;
		
		Результат = Вычислить(ИмяПроцедуры);
		
		Если Отказ Тогда
			
			ПорядковыйНомерПерехода = ПорядковыйНомерПерехода - 1;
			Возврат;
			
		ИначеЕсли ПерейтиДалее Тогда
			
			ИзменитьПорядковыйНомерПерехода(1);
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		ИзменитьПорядковыйНомерПерехода(1);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКнопкуФормыПоИмениКоманды(ЭлементФормы, ИмяКоманды)
	
	Для Каждого Элемент Из ЭлементФормы.ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			
			ЭлементФормыПоИмениКоманды = ПолучитьКнопкуФормыПоИмениКоманды(Элемент, ИмяКоманды);
			
			Если ЭлементФормыПоИмениКоманды <> Неопределено Тогда
				
				Возврат ЭлементФормыПоИмениКоманды;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("КнопкаФормы")
			И СтрНайти(Элемент.ИмяКоманды, ИмяКоманды) > 0 Тогда
			
			Возврат Элемент;
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьТекущейГруппыКоманднойПанели(ТекущаяКоманднаяПанель)
	
	Для Каждого ГруппаКоманд Из Элементы.ПанельНавигации.ПодчиненныеЭлементы Цикл
		Если ГруппаКоманд.Имя = ТекущаяКоманднаяПанель Тогда 
			ГруппаКоманд.Видимость = Истина;
		Иначе
			ГруппаКоманд.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ТекущаяГруппаКоманднойПанели()
	
	Для Каждого ГруппаКоманд Из Элементы.ПанельНавигации.ПодчиненныеЭлементы Цикл
		Если ГруппаКоманд.Видимость Тогда 
			Возврат ГруппаКоманд;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийПереходов

&НаКлиенте
Функция Подключаемый_СтраницаПриветствиеПустая_ПриОткрытии(Отказ, ПропуститьСтраницу, Знач ЭтоПереходДалее)
	
	Заголовок = НСтр("ru='Мастер создания веб-витрины mag1c'");
	
	Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаПриветствие;
