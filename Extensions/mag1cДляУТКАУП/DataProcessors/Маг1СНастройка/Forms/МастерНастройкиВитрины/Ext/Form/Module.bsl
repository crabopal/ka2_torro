&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		ОтменитьВыполнениеДлительнойОперации(ИдентификаторЗадания);
	КонецЕсли;
	
	Если ЗакрытьБезПредупреждения Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьСостояниеМастера();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Запись_ЗначенияСвойствОбъектов" Тогда
		ОбновитьЗначкиНоменклатуры();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияНадписьПользовательскоеСоглашениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПользовательскоеСоглашение" Тогда
		СтандартнаяОбработка = Ложь;
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://portal.1c.ru/applications/92/licenseAgreement");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОплатаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;

	Если НавигационнаяСсылкаФорматированнойСтроки = "ЮKassa" Тогда         
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://portal.1c.ru/applications/1C-Yookassa");
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "СБП" Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://portal.1c.ru/applications/1C-SBP");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьСписокЗапрещенныхМатериаловОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "СписокЗапрещенныхМатериалов" Тогда
		СтандартнаяОбработка = Ложь;
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://portal.1c.ru/download/public/instruction/ProhibitedGoodsAndServices.pdf");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПодключитьОбработчикОжидания("ПриИзмененииОрганизации", 0.1, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	ПриИзмененииПараметраУчета("Склад");
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЦенПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		Возврат;
	КонецЕсли;
	
	ПриИзмененииПараметраУчета("ВидЦен");
КонецПроцедуры

&НаКлиенте
Процедура ИмяВитриныПриИзменении(Элемент)
	
	ИмяВитрины = НРег(ИмяВитрины);
	
	Если Не ИмяКорректно() Тогда
		Возврат;
	КонецЕсли;
	
	ПриИзмененииИмениВитрины();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьПроверкаАдресаСайтаОшибкаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПовторитьПроверкуИмениВитрины" Тогда
		ПодключитьОбработчикОжидания("ПриНачалеПроверкиИмениВитрины", 0.1, Истина);
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОткрытьЖурналРегистрации" Тогда	
		Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура EmailМагазинаСчетНаОплатуПриИзменении(Элемент)
	ИспользоватьEmail = ЗначениеЗаполнено(EmailМагазина);
КонецПроцедуры

&НаКлиенте
Процедура EMailДляОтправкиУведомленийНастройкиПриИзменении(Элемент)
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьУведомленияЧерезСВПриИзменении(Элемент)
	Элементы.ГруппаУведомленияЧерезСВ.Доступность = ИспользоватьУведомленияЧерезСВ И СистемаВзаимодействийПодключена;
	
	Если ИспользоватьУведомленияЧерезСВ
		И ПолучателиУведомлений.Количество() = 0 Тогда
		ПолучателиУведомлений.Добавить().Значение = ТекущийПользователь();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура WebChat_ИспользоватьПриИзменении(Элемент)
	Элементы.ГруппаПодключениеЧатаНаСайте.Доступность = WebChat_Использовать И СистемаВзаимодействийПодключена;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьНезаполненныеРеквизитыНажатие(Элемент)
	ЗаполнитьСведенияОбОрганизации();
КонецПроцедуры

&НаКлиенте
Процедура ПодключениеУведомленийИнформацияОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПодключитьУведомления(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ИнтеграцияВебЧатаИзменениеНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(WebChat_ИдентификаторИнтеграция) Тогда 
		ЗаполнитьНастройкиВебЧатаПоИдентификатору(WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия)
	КонецЕсли;
	
	Если ЗначениеЗаполнено(WebChat_ИдентификаторИнтеграция) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеИзмененияИнтеграцииСВебЧатом", ЭтотОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Тип", "WebChat");
		ПараметрыФормы.Вставить("Идентификатор", WebChat_ИдентификаторИнтеграция);
		ОбсужденияСлужебныйКлиент.ПоказатьИнформациюОбИнтеграции(ЭтотОбъект, ПараметрыФормы, Оповещение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияИнтеграцииСВебЧатом(Результат, ДополнительныеПараметры) Экспорт
	ЗаполнитьНастройкиВебЧатаПоИдентификатору(WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия)
КонецПроцедуры

&НаКлиенте
Процедура ПубликацияВебЧатаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "disconnect" Тогда
		WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия = Неопределено;
		ЗаполнитьНастройкиВебЧатаПоИдентификатору(WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия);
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "create" Тогда
		СоздатьНастройкуВебЧатаПоУмолчанию();
	КонецЕсли;
	ОтобразитьEMailДляОтправкиУведомленийИНомерСчетчика();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПодключениеУведомленийПодсказкаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "connect" Тогда
		ОповещениеПодключенияВзаимодействия = Новый ОписаниеОповещения("ПослеПодключенияВзаимодействия", ЭтотОбъект);
		ОбсужденияКлиент.ПоказатьПодключение(ОповещениеПодключенияВзаимодействия);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияВзаимодействия(Результат, ДополнительныеПараметры) Экспорт
	СистемаВзаимодействийПодключена = СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована();
	Если СистемаВзаимодействийПодключена Тогда 
		Элементы.ГруппаПодключениеУведомленийСистемаВзаимодействия.Видимость = НЕ СистемаВзаимодействийПодключена;
		
		Элементы.ИспользоватьУведомленияЧерезСВ.Доступность = СистемаВзаимодействийПодключена;
		Элементы.WebChat_Использовать.Доступность = СистемаВзаимодействийПодключена;
		
		Элементы.ГруппаУведомленияЧерезСВ.Доступность = ИспользоватьУведомленияЧерезСВ И СистемаВзаимодействийПодключена;
		Элементы.ГруппаПодключениеЧатаНаСайте.Доступность         = WebChat_Использовать И СистемаВзаимодействийПодключена;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЕстьПроблемыПередачиКартинокОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыПомощника = Новый Структура;
	ПараметрыПомощника.Вставить("НастройкиВитрины", НастройкиВитрины());
	
	ДействиеПриЗакрытии = Новый ОписаниеОповещения("УстановитьВидимостьЕстьПроблемыПередачиКартинокКлиент", ЭтотОбъект);

	ОткрытьФорму("Обработка.Маг1СОбмен.Форма.РешениеПроблемВыгрузкиКартинок",
				 ПараметрыПомощника,
				 ЭтотОбъект,
				 ,
				 ,
				 ,
				 ДействиеПриЗакрытии,
				  );
	
КонецПроцедуры

