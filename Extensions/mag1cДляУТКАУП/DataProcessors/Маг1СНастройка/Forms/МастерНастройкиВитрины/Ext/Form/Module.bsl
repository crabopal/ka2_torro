КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПриИзмененииФлажковОплатаСБП(Форма)
	ДоступныеНастройкиСБП = Новый Массив;
		
	Если ЕстьОплатаСБП(Форма) Тогда
		
		Если ЗначениеЗаполнено(Форма.Организация) Тогда
			ДоступныеНастройкиСБП = ДоступныеНастройкиСБП(Форма.Организация);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Форма.НастройкаСБП)
			И ДоступныеНастройкиСБП.Найти(Форма.НастройкаСБП) = Неопределено Тогда
			Форма.НастройкаСБП = Неопределено;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Форма.НастройкаСБП)
			И ДоступныеНастройкиСБП.Количество() = 1 Тогда
			Форма.НастройкаСБП = ДоступныеНастройкиСБП[0];
		КонецЕсли;
		
	Иначе
		
		Форма.НастройкаСБП = Неопределено;
		
	КонецЕсли;
	
	УстановитьВидимостьНастройкаСБП(Форма);
	
	Возврат ДоступныеНастройкиСБП.Количество() > 0;
КонецФункции

