&НаКлиенте
Процедура ПолучитьТекстРассылки(Команда)
	
	СтрокаТекста = НСтр("ru = 'Магазин ""%НазваниеМагазина%"" теперь и в интернете.
		|Заходите на сайт %ПолноеИмяВитрины%
		|- выбирайте товары, оформляйте заказы.
		|Быстро и удобно)'");
	СтрокаТекста = СтрЗаменить(СтрокаТекста, "%НазваниеМагазина%", НазваниеМагазина);  
	СтрокаТекста = СтрЗаменить(СтрокаТекста, "%ПолноеИмяВитрины%", ПолноеИмяВитрины);  
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьТекстРассылкиЗавершение", ЭтотОбъект);
	
	ЗаголовокДиалога = НСтр("ru = 'Скопируйте текст'");
	
	ПоказатьВводСтроки(ОписаниеОповещения, СтрокаТекста,ЗаголовокДиалога,,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВАдминзонуВитрины(Команда)
	UrlРегистрацияПоИнвайту = ПолучитьИнвайтНаСервере();
	Если ЗначениеЗаполнено(UrlРегистрацияПоИнвайту) Тогда 
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(UrlРегистрацияПоИнвайту)
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьИнвайтНаСервере()
	
	НастройкиВитрины = НастройкиВитрины();
	
	ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(ИдентификаторВитрины);
	АдресПочты = НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений.EMailДляОтправкиУведомлений;
	
	Возврат Обработки.Маг1СОбмен.ПолучитьИнвайтВАдминзону(ПараметрыАвторизации, АдресПочты);
	
КонецФункции

