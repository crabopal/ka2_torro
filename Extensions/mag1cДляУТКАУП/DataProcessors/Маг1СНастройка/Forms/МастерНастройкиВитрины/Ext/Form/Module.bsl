		Маг1СИнтеграцияСлужебныйКлиент.ПоказатьПредупреждениеОбОшибке(, РезультатыВыполнения.ПараметрыСобытия);
	КонецЕсли;
	
	ОтобразитьEMailДляОтправкиУведомленийИНомерСчетчика();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияДлительнаяОперацияОбновитьНастройкиВитриныПриОшибке(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	Закрыть = Не ВосстановитьПослеОшибки(Истина);
	
	Если Не Закрыть Тогда
		
		ОтобразитьEMailДляОтправкиУведомленийИНомерСчетчика();
		
	КонецЕсли;	
	
	Если ФоновоеЗадание = Неопределено Тогда
		ПоказатьОшибку(Новый Структура, Закрыть, "");
	Иначе
		ПоказатьОшибку(Новый Структура, Закрыть, ФоновоеЗадание.ПодробноеПредставлениеОшибки);
	КонецЕсли;
		
