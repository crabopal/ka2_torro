	Возврат СтрокаПереходов;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьОшибку(ПараметрыОшибки, Закрыть, СообщениеОбОшибке)
	
	УстановитьВидимостьТекущейГруппыКоманднойПанели(Элементы.СтраницаНавигацияОшибка.Имя);
	ПараметрыСобытия = ПараметрыОшибки;
	
	Элементы.ВернутьсяКВыполняемомуДействию.Видимость = Не Закрыть;
	Элементы.ЗавершитьРаботуСМастером.Видимость 	  = Закрыть;
	
	ЗакрытьБезПредупреждения = Закрыть;
	
	Если Не ПустаяСтрока(СообщениеОбОшибке) Тогда
		Элементы.ДекорацияТекстОшибки.Видимость = Истина;
		
		ТекстОшибки = НСтр("ru = 'Текст ошибки:
                           |
                           |%СообщениеОбОшибке%'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СообщениеОбОшибке%", СообщениеОбОшибке);  
		Элементы.ДекорацияТекстОшибки.Заголовок = ТекстОшибки;
	Иначе
		Элементы.ДекорацияТекстОшибки.Видимость = Ложь;
	КонецЕсли;
	
	Если СтрокаСпискаВитрин <> Неопределено 
		И Маг1СИнтеграцияСлужебныйКлиентСервер.ВитринаПомещенаВАрхив(СтрокаСпискаВитрин) Тогда
		Элементы.НадписьСоздатьНовуюВитрину.Видимость = Истина;
		Элементы.НадписьПерейтиКСпискуВитрин.Видимость = Истина;
		
		ТекстЗаголовка = НСтр("ru = 'Витрина %ИмяВитрины% помещена в архив'");
		ТекстЗаголовка = СтрЗаменить(ТекстЗаголовка, "%ИмяВитрины%", СтрокаСпискаВитрин.ПолноеИмяВитрины);
		
		Элементы.СостояниеВитриныСозданиеОтложено.Заголовок = ТекстЗаголовка;
		Элементы.ПанельКомпоновки.ТекущаяСтраница  = Элементы.СтраницаВитринаВАрхиве;
	Иначе
		Элементы.НадписьСоздатьНовуюВитрину.Видимость = Ложь;
		Элементы.НадписьПерейтиКСпискуВитрин.Видимость = Ложь;
		Элементы.ПанельКомпоновки.ТекущаяСтраница  = Элементы.СтраницаОшибки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтраницуПредупреждения(ТекстПредупреждения, Закрыть)
	
	УстановитьВидимостьТекущейГруппыКоманднойПанели(Элементы.СтраницаНавигацияОшибка.Имя);
	
	Элементы.ВернутьсяКВыполняемомуДействию.Видимость = Не Закрыть;
	Элементы.ЗавершитьРаботуСМастером.Видимость 	  = Закрыть;
	
	ЗакрытьБезПредупреждения = Закрыть;
	
	Элементы.ДекорацияТекстПредупреждения.Заголовок = ТекстПредупреждения;
	
	Элементы.НадписьСоздатьНовуюВитрину.Видимость = Ложь;
	Элементы.НадписьПерейтиКСпискуВитрин.Видимость = Ложь;
	Элементы.ПанельКомпоновки.ТекущаяСтраница  = Элементы.СтраницаПредупреждения;
	
КонецПроцедуры

#КонецОбласти

#Область СистемаВзаимодействия

&НаСервере
Процедура СоздатьНастройкуВебЧатаПоУмолчанию()
	
	Интеграции = СистемаВзаимодействия.ПолучитьИнтеграции();
	Если Интеграции <> Неопределено Тогда
		Для Каждого Интеграция Из Интеграции Цикл
			Если Интеграция.ТипВнешнейСистемы = "WebChat" И Интеграция.Ключ = "Веб чат на витрине "+ИмяВитрины Тогда
				WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия = Интеграция.Идентификатор;
				ЗаполнитьНастройкиВебЧатаПоИдентификатору(WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыИнтеграции = ОбсужденияСлужебный.ПараметрыИнтеграции();
	ПараметрыИнтеграции.Ключ = "Веб чат на витрине "+ИмяВитрины;
	ПараметрыИнтеграции.Тип = ОбсужденияСлужебныйКлиентСервер.ТипыВнешнихСистем().ВебЧат;
	
	ПользователиВебЧата = Новый Массив();
	ПользователиВебЧата.Добавить(ТекущийПользователь());
	ПараметрыИнтеграции.Участники = ПользователиВебЧата;
	
	ПараметрыИнтеграции.Вставить("signKey", СгенерироватьСлучайныйКлюч());
	ПараметрыИнтеграции.Вставить("titleText", "Чат с "+ИмяВитрины);
	ПараметрыИнтеграции.Вставить("titleBackColor", "#1A5296");
	ПараметрыИнтеграции.Вставить("titleTextColor", "#FFFFFF");
	ПараметрыИнтеграции.Вставить("displayUnreadMessagesMark", "true");
	ПараметрыИнтеграции.Вставить("displayCollapsedState", "false");
	ПараметрыИнтеграции.Вставить("openChatOnNewMessage", "false");
	
	Попытка
		ОписаниеИнтеграции = ОбсужденияСлужебный.СоздатьИзменитьИнтеграцию(ПараметрыИнтеграции);
		// Из-за особенностей реализации Системы взаимодействия требуется повторный вызов.
		Интеграция = СистемаВзаимодействия.ПолучитьИнтеграцию(ОписаниеИнтеграции.Идентификатор);
		
		WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия = Интеграция.Идентификатор;
		ЗаполнитьНастройкиВебЧатаПоИдентификатору(WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия);
	Исключение
		ЗаписьЖурналаРегистрации(ОбсужденияСлужебный.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СгенерироватьСлучайныйКлюч()
	
	НовыйКлюч = "";
	ГСЧ = Новый ГенераторСлучайныхЧисел(); 
	
	Для Сч = 1 По 32 Цикл
		СлучайноеЧисло = ГСЧ.СлучайноеЧисло(0, 255);
		НовыйКлюч = НовыйКлюч + ПреобразоватьDecВHex(СлучайноеЧисло);
	КонецЦикла;

	Возврат НовыйКлюч;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПреобразоватьDecВHex(Число)
	
	Словарь = "0123456789ABCDEF";
	
	Часть1 = Int(Число / 16);
	Часть2 = Число - (Часть1 * 16);
	
	Возврат Сред(Словарь, Часть1 + 1, 1) + Сред(Словарь, Часть2 + 1, 1); 
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНастройкиВебЧатаПоИдентификатору(WebChat_Идентификатор)
	Интеграция = ПолучитьИнтеграциюНаСервереПоСтрокеИдентификатора(WebChat_Идентификатор);
	Если Интеграция = Неопределено Тогда 
		WebChat_SignKey = "";
		WebChat_Представление = "";
		WebChat_НавигационнаяСсылкаТочкиПодключения = "";
		WebChat_ИдентификаторИнтеграция = Неопределено;
	Иначе
		WebChat_SignKey = Интеграция.ПараметрыВнешнейСистемы["signKey"];
		WebChat_Представление = Интеграция.Представление;
		WebChat_НавигационнаяСсылкаТочкиПодключения = Интеграция.НавигационнаяСсылкаТочкиПодключения;
		WebChat_ИдентификаторИнтеграция = Интеграция.Идентификатор;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнтеграциюНаСервереПоСтрокеИдентификатора(WebChat_Идентификатор)
	Если WebChat_Идентификатор = Неопределено Или WebChat_Идентификатор = "" Тогда
		Возврат Неопределено;
	Иначе
		Интеграции = СистемаВзаимодействия.ПолучитьИнтеграции();
		Для Каждого Интеграция Из Интеграции Цикл
			Если Строка(Интеграция.Идентификатор) = WebChat_Идентификатор Тогда
				Возврат Интеграция;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область ОбработчикиСценарияСозданияВебВитрины

#Область ПодготовкаДанныхКПереносу

&НаКлиенте
Процедура ПриНачалеПодготовкиДанныхКПереносу()
	
	ФоновоеЗадание = ДлительнаяОперацияПодготовитьДанныеКПереносу();
	
	Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
		ЭтотОбъект,
		ФоновоеЗадание,
		Новый ОписаниеОповещения("ДлительнаяОперацияПодготовитьДанныеКПереносуПриЗавершении", ЭтотОбъект),
		Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
	
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияПодготовитьДанныеКПереносу()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Маг1СИнтеграцияПереопределяемый.ПеренестиИСохранитьНастройкиВМаг1с",
		Новый Структура("Источник", ИсточникПереносаВыбранный),
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Функция ДлительнаяОперацияПодготовитьДанныеКПереносуПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	РежимПерносаТекущий = РежимПереноса;
	
	СостояниеМастера = РезультатыВыполнения.СостояниеМастера;
	
	ВосстановитьНастройкиВитрины(
			СостояниеМастера.НастройкиВитрины.ОсновныеНастройки,
			СостояниеМастера.НастройкиВитрины.ДополнительныеНастройки);
	
	РежимПереноса = РежимПерносаТекущий;
	
	ИзменитьПорядковыйНомерПерехода(1);
	
КонецФункции

#КонецОбласти

#Область ПроверкаИмениВитрины

&НаКлиенте
Процедура ПриНачалеПроверкиИмениВитрины()
	
	Если Не ЗначениеЗаполнено(ИмяВитрины) Тогда
		Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныНеВыполнялась;
		Возврат;
	КонецЕсли;
	
	Элементы.КомандаДалееНазваниеВитрины.Доступность = Ложь;
	
	Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныОжидание;
	
	ПодключитьОбработчикОжидания("ПроверкаИмениВитриныПродолжение", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаИмениВитриныПродолжение()
	
	Попытка
		РезультатПроверки = ПроверитьИмяВитрины(ИмяВитрины + ИмяДоменаДляРегистрацииВитрины, ЛогинИПП);
	Исключение
		Элементы.КомандаДалееНазваниеВитрины.Доступность = Истина;
		
		ИмяВитриныДоступноДляРегистрации = Ложь;
		Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныОшибка;
		Возврат;
	КонецПопытки;
	
	Элементы.КомандаДалееНазваниеВитрины.Доступность = РезультатПроверки.ИмяВалидно;
	
	Если РезультатПроверки.ИмяВалидно Тогда
		ИмяВитриныДоступноДляРегистрации = Истина;
		Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныУспешно;
	ИначеЕсли РезультатПроверки.Отказ Тогда
		ИмяВитриныДоступноДляРегистрации = Ложь;
		Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныОшибка;
		ПараметрыСобытия = РезультатПроверки.ПараметрыСобытия;
	Иначе
		ИмяВитриныДоступноДляРегистрации = Ложь;
		Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныНедоступна;
		Элементы.ДекорацияНадписьПроверкаАдресаСайтаНедоступен.Заголовок = РезультатПроверки.СообщениеОбОшибке;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьИмяВитрины(ПолноеИмяВитрины, ЛогинИПП)
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ПолноеИмяВитрины", ПолноеИмяВитрины);
	ПараметрыОперации.Вставить("ЛогинИПП",         ЛогинИПП);
	
	Результат = Новый Структура;
	
	Обработки.Маг1СНастройка.ПроверитьИмяВитриныВФоновомЗадании(ПараметрыОперации, Результат);
	
	Возврат Результат;
	
КонецФункции

