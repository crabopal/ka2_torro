&НаКлиенте
Процедура ПриИзмененииИмениВитрины()
	
	ЭтотОбъект.ТекущийЭлемент = Элементы.EMailДляОтправкиУведомленийНачало;
	
	Если Не ЗначениеЗаполнено(ИмяВитрины) Тогда
		Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныНеВыполнялась;
		Возврат;
	ИначеЕсли ИмяВитрины = ЗарегистрированноеИмяВитрины Тогда
		Элементы.ПанельПроверкаИмениВитрины.ТекущаяСтраница = Элементы.СтраницаПроверкаИмениВитриныЗарегистрирована;
		Элементы.КомандаДалееНазваниеВитрины.Доступность = Истина;
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПриНачалеПроверкиИмениВитрины", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПараметраУчета(ИмяПараметраУчета)
	
	НастройкиВитрины = НастройкиВитрины();
	
	Маг1СИнтеграцияСлужебный.ПриИзмененииПараметровУчета(НастройкиВитрины.ОсновныеНастройки, НастройкиУчетнойСистемы, ИмяПараметраУчета);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета);
	ОсновныеНастройки = НастройкиВитрины.ОсновныеНастройки;
		
	ВосстановитьНастройкиВитрины(ОсновныеНастройки);
	
	ИзменилисьПараметрыУчета = Истина;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьАдресКартинкиЛоготипа(ТекущееЗначение, ПомещенныйФайл, УникальныйИдентификаторФормы)
	
	Если ЗначениеЗаполнено(ТекущееЗначение)
		И ЭтоАдресВременногоХранилища(ТекущееЗначение) Тогда
		УдалитьИзВременногоХранилища(ТекущееЗначение);
	КонецЕсли;
	
	Если ТипЗнч(ПомещенныйФайл) = Тип("Структура") Тогда 
		НовоеЗначение = ПомещенныйФайл.Хранение;
		Расширение    = Маг1СИнтеграцияСлужебныйКлиентСервер.РасширениеИзИмениФайла(ПомещенныйФайл.Имя);
	Иначе
		НовоеЗначение = ПомещенныйФайл;
		Расширение    = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовоеЗначение)
		И ЭтоАдресВременногоХранилища(НовоеЗначение)
		И ЗначениеЗаполнено(Расширение) Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(НовоеЗначение);
		Попытка
			СжатыеДанные   = Маг1СИнтеграцияСлужебный.СжатьКартинку(ДвоичныеДанные, 400, 800,,Расширение);
			
			Если СжатыеДанные.КартинкаПреобразована Тогда 
				НовейшийАдрес  = ПоместитьВоВременноеХранилище(СжатыеДанные.ДвоичныеДанные, УникальныйИдентификаторФормы);
				УдалитьИзВременногоХранилища(НовоеЗначение);
				НовоеЗначение = НовейшийАдрес;
			КонецЕсли;
		Исключение
			НовоеЗначение = "";
			ТекстСообщения = НСтр("ru = 'Ошибка при обработке картинки логотипа магазина. Загрузите другой файл логотипа. Описание ошибки: %ОписаниеОшибки%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
	ТекущееЗначение = НовоеЗначение;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьАдресКартинкиШтрихкода()
	
	ТекущееЗначение = АдресКартинкиШтрихкода;
	Если ЗначениеЗаполнено(ТекущееЗначение)
		И ЭтоАдресВременногоХранилища(ТекущееЗначение) Тогда
		УдалитьИзВременногоХранилища(ТекущееЗначение);
	КонецЕсли;
	
	Картинка = Маг1СИнтеграцияСлужебный.ПолучитьКартинкуQRКода(
		Новый Структура("Ширина, Высота", 125, 125),
		АдресСайтаВитрины);
	
	Если Картинка <> Неопределено Тогда
		АдресКартинкиШтрихкода = ПоместитьВоВременноеХранилище(Картинка.ПолучитьДвоичныеДанные(), УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЛоготипаЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьАдресКартинкиЛоготипа(АдресКартинкиЛоготипа, ПомещенныйФайл, УникальныйИдентификатор);
	
	ПриИзмененииАдресаЛоготипа();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСведенияОбОрганизации()
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьСведенияОбОрганизацииОбработкаЗакрытия", ЭтотОбъект);
	
	ПараметрыФормы = ПараметрыФормыНастройкиСведенийОбОрганизации(Организация);
	
	ОткрытьФорму(ПараметрыФормы.ИмяФормы, ПараметрыФормы.Параметры, ЭтотОбъект, , , , Оповещение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыФормыНастройкиСведенийОбОрганизации(Организация)
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("Параметры", Новый Структура);
	
	Маг1СИнтеграцияПереопределяемый.ПриНачалеНастройкиСведенийОбОрганизации(
		Организация,
		Результат.ИмяФормы,
		Результат.Параметры);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСведенияОбОрганизацииОбработкаЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполнитьПроверкуСведенийОбОрганизации();
	
КонецПроцедуры

#КонецОбласти

#Область СохранениеИВосстановлениеНастроекМастера

&НаКлиенте
Процедура СохранитьСостояниеМастераПередЗакрытием()
	
	СохранитьСостояниеМастера();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСостояниеМастера()
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда
		Возврат;
	КонецЕсли;
	
	СостояниеМастера = СостояниеМастера();
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
		СостояниеМастера.СтраницаПереходаСохраненная = "СтраницаЗавершение";
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
	
КонецПроцедуры

&НаСервере
Функция СостояниеМастера()
	СостояниеМастера = Маг1СИнтеграцияСлужебный.СтруктураСостоянияМастера();	
	
	НастройкиВитрины = НастройкиВитрины();
	СостояниеМастера.НастройкиВитрины = НастройкиВитрины;
	
	// Служебные реквизиты мастера.
	СтрокиПереходов = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ПорядковыйНомерПерехода));
	Если СтрокиПереходов.Количество() > 0 Тогда
		СостояниеМастера.СтраницаПереходаСохраненная = СтрокиПереходов[0].ИмяОсновнойСтраницы;
	КонецЕсли;
	
	СостояниеМастера.ПринятьУсловияЛицензионногоСоглашения      = ПринятьУсловияЛицензионногоСоглашения;
	СостояниеМастера.ОзнакомитьсяСоСпискомЗапрещенныхМатериалов = ОзнакомитьсяСоСпискомЗапрещенныхМатериалов;
	
	Возврат СостояниеМастера; 
КонецФункции	

&НаСервере
Процедура ВосстановитьСохраненноеСостояниеМастера()
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ВитринаПомещенаВАрхив(СтрокаСпискаВитрин) Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтрокаСпискаВитрин);
		Возврат;
	КонецЕсли;
	
	СостояниеМастера = Маг1СИнтеграцияСлужебный.ПрочитатьСостояниеМастераНастройкиВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины);
	
	Если СостояниеМастера = Неопределено Тогда
		СостояниеМастера = Маг1СИнтеграцияСлужебный.СтруктураСостоянияМастера();
		Маг1СИнтеграцияСлужебный.ЗаполнитьНастройкиПоУмолчанию(СостояниеМастера,
																НастройкиУчетнойСистемы,
																ЛогинИПП,
																СтрокаСпискаВитрин);
	КонецЕсли;		
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,
								СостояниеМастера,
								"ОзнакомитьсяСоСпискомЗапрещенныхМатериалов,
								|ПринятьУсловияЛицензионногоСоглашения,
								|СтраницаПереходаСохраненная");
								
	Если РежимФормы <> Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c()
		И СтраницаПереходаСохраненная = "СтраницаНазваниеВитрины"
		И Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин)
		И ЗначениеЗаполнено(СтрокаСпискаВитрин.ИдентификаторВитрины)
		И СтрокаСпискаВитрин.ИдентификаторВитрины <> Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда 
		ЭтоПеренастройкаВитрины = Истина;
	КонецЕсли;
								
	ВосстановитьНастройкиВитрины(
			СостояниеМастера.НастройкиВитрины.ОсновныеНастройки,
			СостояниеМастера.НастройкиВитрины.ДополнительныеНастройки);
			
	ПараметрыЮКасса = ЮКассаПодключена(Организация);
	НастроитьДекорацииЮКассаТестовыйМагазин(ЭтотОбъект, ПараметрыЮКасса.ЭтоТестовыйМагазинЮКасса);
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки()
		Или РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда
		ИмяДоменаДляРегистрацииВитрины =  "." + СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.Домен;
    КонецЕсли;
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда
		ИмяВитрины = "";
		EMailДляОтправкиУведомлений = "";
	КонецЕсли;
	
КонецПроцедуры

