&НаКлиенте
Процедура ПерейтиКСтраницеЗавершение(Команда)
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
		
		Закрыть();
		
	Иначе
		
		Если ПовторнаяНастройка Тогда
			
			ВосстановитьСохраненноеСостояниеМастера();
			ВыполнитьПереходКСтранице("СтраницаЗавершение");
			
		Иначе
			
			Если ИдентификаторВитрины = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
				УдалитьНастройкиВитрины(ИдентификаторВитрины);
			КонецЕсли;
			
			ЗакрытьБезПредупреждения = Истина;
			
			Если ПрофильПользователя.ИспользуемыеРесурсы.Витрины > 0 Тогда
				Закрыть(Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин());
			Иначе
				Закрыть();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

