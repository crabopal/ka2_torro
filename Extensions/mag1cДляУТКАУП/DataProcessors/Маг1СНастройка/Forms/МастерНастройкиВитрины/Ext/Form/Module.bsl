КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияВыгрузитьДанныеНаСайт()
	
	НоменклатураИсключенияМассив = НоменклатураИсключения.Выгрузить().ВыгрузитьКолонку("Ссылка");
	Маг1СИнтеграцияСлужебный.СохранитьДопСвойстваИсключитьИзПубликацииНаВебВитринеMag1c(НоменклатураИсключенияМассив,
																						НастройкиУчетнойСистемы);
	                                              
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин);
	ПараметрыОперации.Вставить("СостояниеМастера", СостояниеМастера());
	ПараметрыОперации.Вставить("ВыгружатьВсеТовары", ВыгружатьВсеТовары);
	ПараметрыОперации.Вставить("ИзменилисьТолькоПараметрыУчета", ИзменилисьПараметрыУчета и Не ВыгружатьВсеТовары);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СНастройка.СохранитьНастройкиПодготовитьВыгрузкуВыгрузитьТоварыВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияВыгрузитьДанныеНаСайтПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	ПриОшибкеПерейтиНаСтраницуЗавершение = Ложь;
	Если РежимПереноса = Маг1СПеречисления.РежимПереносаЭкспресс() Тогда 
		ПриОшибкеПерейтиНаСтраницуЗавершение = Истина;
		ПовторнаяНастройка = Истина;
		
		РежимПереноса = Маг1СПеречисления.РежимПереносаПолный();
		
		ЗаполнитьТаблицуПереходовПоСценарию();
		СтрокиПереходаТекущие = ТаблицаПереходов.НайтиСтроки(Новый Структура("ИмяОсновнойСтраницы", "СтраницаВыгрузкаДанныхОжидание"));
		Если СтрокиПереходаТекущие.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Не определена страница для отображения.'");
		КонецЕсли;
		
		СтрокаПереходаТекущая = СтрокиПереходаТекущие[0];
		ПорядковыйНомерПерехода = СтрокаПереходаТекущая.ПорядковыйНомерПерехода-1;
	КонецЕсли;
	
	ОбновитьСтрокуСпискаВитрин(ЭтотОбъект, РезультатыВыполнения.СтрокаСпискаВитрин);
	
	УстановитьВидимостьДекорацийПроблемОбмена();
	
	Если РезультатыВыполнения.Отказ Тогда
		Если РезультатыВыполнения.ОбменУжеВыполняется Тогда
			ПоказатьСтраницуПредупреждения(РезультатыВыполнения.СообщениеОбОшибке, Ложь);
		Иначе
			Если ПриОшибкеПерейтиНаСтраницуЗавершение Тогда
				//ИзменитьПорядковыйНомерПерехода(1);
				ВыполнитьПереходКСтранице("СтраницаЗавершение");
			Иначе
				ПоказатьОшибку(РезультатыВыполнения.ПараметрыСобытия, Ложь, РезультатыВыполнения.СообщениеОбОшибке);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ВыгружатьВсеТовары = Ложь;
		ИзменилисьПараметрыУчета = Ложь;
		УзелОбмена = РезультатыВыполнения.УзелОбмена; 
		Если Не ПовторнаяНастройка Тогда
			ИзменитьПорядковыйНомерПерехода(1);
		Иначе
			Если РезультатыВыполнения.ОбменУжеВыполняется Тогда
				ПоказатьСтраницуПредупреждения(РезультатыВыполнения.СообщениеОбОшибке, Истина);
			Иначе	
				ВыполнитьПереходКСтранице("СтраницаЗавершение");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПриОшибке(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	Закрыть = Не ВосстановитьПослеОшибки(Ложь);
	
	Если ФоновоеЗадание = Неопределено Тогда // Отменено
		ПоказатьОшибку(Новый Структура, Закрыть, "");
	ИначеЕсли ТипЗнч(ФоновоеЗадание) = Тип("Структура") Тогда
		ПоказатьОшибку(Новый Структура, 
					Закрыть, 
					ФоновоеЗадание.ПодробноеПредставлениеОшибки);
	Иначе
		ПоказатьОшибку(Новый Структура, Закрыть, "");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВосстановитьПослеОшибки(ВосстанавливатьСостояниеМастера)
	ОбновитьСтрокуСпискаВитрин(ЭтотОбъект, Маг1СИнтеграция.СтрокаСпискаВитринПоИдентификаторуВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины));
	
	Если СтрокаСпискаВитрин = Неопределено Тогда
		Возврат Ложь;
	Иначе
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтрокаСпискаВитрин);
		Если ВосстанавливатьСостояниеМастера Тогда
			ВосстановитьСохраненноеСостояниеМастера();
		КонецЕсли;
		
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

