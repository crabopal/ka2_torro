&НаКлиенте
Процедура ПослеФормированияЦен(Результат, ДополнительныеПараметры) Экспорт

	СтраницаПроверкаПараметровВыгрузки_ПриОткрытии();
	
КонецПроцедуры

&НаСервере
Процедура СтраницаПроверкаПараметровВыгрузки_ПриОткрытии()
	
	//Элементы.ГруппаВыгрузкаДанныхЗаголовок.ОтображатьЗаголовок = Не ПовторнаяНастройка;
	Элементы.КомандаНазадВыгрузкаДанных.Видимость  = Не ПовторнаяНастройка;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	НастройкиВитрины = НастройкиВитрины();
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	
	Маг1СИнтеграция.СформироватьВТАктивнаяНоменклатура(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры, НастройкиВитрины, Ложь); 
	Маг1СИнтеграция.СформироватьВТПубликуемаяНоменклатура(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВТПубликуемаяНоменклатура.Номенклатура) КАК КоличествоТоваров
	|ИЗ
	|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТАктивнаяНоменклатура.Номенклатура) КАК КоличествоАктивных
	|ИЗ
	|	ВТАктивнаяНоменклатура КАК ВТАктивнаяНоменклатура
	|ГДЕ
	|	ВТАктивнаяНоменклатура.Цена > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВТЦены.Цена, 0) = 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоТоваровБезЦен,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВТЦены.Цена, 0) <> 0
	|					И ЕСТЬNULL(ВТЦены.Период, ДАТАВРЕМЯ(1, 1, 1)) < &ПериодАктуальностиЦен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоТоваровСоСтарымиЦенами
	|ИЗ
	|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦены КАК ВТЦены
	|		ПО (ВТЦены.Номенклатура = ВТПубликуемаяНоменклатура.Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(1) КАК КоличествоТоваровБезИзображений
	|ИЗ
	|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаКартинокНоменклатуры КАК КартинкиНоменклатуры
	|		ПО ВТПубликуемаяНоменклатура.Номенклатура = КартинкиНоменклатуры.ВладелецФайла
	|			И (КартинкиНоменклатуры.Расширение В (&РасширенияИзображений))
	|			И (НЕ КартинкиНоменклатуры.ПометкаУдаления)
	|ГДЕ
	|	КартинкиНоменклатуры.ВладелецФайла ЕСТЬ NULL";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаКартинокНоменклатуры", 
		Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки()));

	Запрос.УстановитьПараметр("ПериодАктуальностиЦен", Маг1СИнтеграцияСлужебный.Дней30ОтТекущейДаты());
	Запрос.УстановитьПараметр("РасширенияИзображений", Маг1СИнтеграцияСлужебныйКлиентСервер.РасширенияИзображений());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаКоличествоТоваров = Результат[0].Выбрать();
	КоличествоТоваров = 0;
	Если ВыборкаКоличествоТоваров.Следующий()
		И ТипЗнч(ВыборкаКоличествоТоваров.КоличествоТоваров) = Тип("Число") Тогда
		КоличествоТоваров = ВыборкаКоличествоТоваров.КоличествоТоваров;
	КонецЕсли;
	
	КоличествоГрупп          = НастройкиФильтровНоменклатуры.ЗначенияОтборовПоНоменклатуре.Количество();
	
	КоличествоТоваровСтрокой = Формат(КоличествоТоваров, "ЧН=0; ЧГ=0");
	
	Если КоличествоГрупп = 0 Тогда
		КоличествоТоваровНадпись = СтрокаСЧислом(
			НСтр("ru =  ';
						|%1 товар будет выгружен на витрину;
						|;
						|%1 товара будут выгружены на витрину;
						|%1 товаров будут выгружены на витрину;
						|%1 товаров будут выгружены на витрину'"),
			КоличествоТоваров,
			ВидЧисловогоЗначения.Количественное,
			"Л=ru_RU; ЧН=0; ЧГ=0");
		Элементы.ДекорацияНастройкаВыгрузкиИтоги.Заголовок = КоличествоТоваровНадпись;
	Иначе
		КоличествоТоваровНадпись = СтрокаСЧислом(
			НСтр("ru =  ';
						|%1 товар в КоличествоГрупп будет выгружен на витрину;
						|;
						|%1 товара в КоличествоГрупп будут выгружены на витрину;
						|%1 товаров в КоличествоГрупп будут выгружены на витрину;
						|%1 товаров в КоличествоГрупп будут выгружены на витрину'"),
			КоличествоТоваров,
			ВидЧисловогоЗначения.Количественное,
			"Л=ru_RU; ЧН=0; ЧГ=0");
		КоличествоГруппСтрокой = СтрокаСЧислом(
			НСтр("ru =  ';
						|%1 группе;
						|;
						|%1 группах;
						|%1 группах;
						|%1 группах'"),
			КоличествоГрупп,
			ВидЧисловогоЗначения.Количественное,
			"Л=ru_RU; ЧН=0; ЧГ=0");
			
		Элементы.ДекорацияНастройкаВыгрузкиИтоги.Заголовок =
			СтрШаблон(СтрЗаменить(КоличествоТоваровНадпись, "КоличествоГрупп", "%1"), КоличествоГруппСтрокой);
	
	КонецЕсли;
	
	// Итоги настройки отображения
	Если ПубликоватьТолькоАктивныеПозиции Тогда
		КоличествоАктивных = 0;
		ВыборкаКоличествоАктивных = Результат[1].Выбрать(); 
		Если ВыборкаКоличествоАктивных.Следующий()
			И ТипЗнч(ВыборкаКоличествоАктивных.КоличествоАктивных) = Тип("Число") Тогда
			КоличествоАктивных = ВыборкаКоличествоАктивных.КоличествоАктивных;	
		КонецЕсли;
	Иначе
		КоличествоАктивных = КоличествоТоваров;
	КонецЕсли;
	
	КоличествоАктивныхСтрокой = Формат(КоличествоАктивных, "ЧН=0; ЧГ=0");
	КоличествоВыбранныхТоваровСтрокой = СтрокаСЧислом(
		НСтр("ru =  ';
					|%1 товар из КоличествоТоваров будет показан на витрине;
					|;
					|%1 товара из КоличествоТоваров будут показаны на витрине;
					|%1 товаров из КоличествоТоваров будут показаны на витрине;
					|%1 товаров из КоличествоТоваров будут показаны на витрине'"),
		КоличествоАктивныхСтрокой,
		ВидЧисловогоЗначения.Количественное,
		"Л=ru_RU; ЧН=0; ЧГ=0");
		
	Элементы.ДекорацияНастройкаОтображенияИтоги.Заголовок =
		СтрШаблон(СТрЗаменить(КоличествоВыбранныхТоваровСтрокой, "КоличествоТоваров", "%1"), КоличествоТоваровСтрокой);
	
	КоличествоТоваровБезЦен          = 0;
	КоличествоТоваровСоСтарымиЦенами = 0;  
	ВыборкаКоличествоТоваровБезЦенСоСтарымиЦенами = Результат[2].Выбрать();
	Если ВыборкаКоличествоТоваровБезЦенСоСтарымиЦенами.Следующий()
		И ТипЗнч(ВыборкаКоличествоТоваровБезЦенСоСтарымиЦенами.КоличествоТоваровБезЦен) = Тип("Число") Тогда
		КоличествоТоваровБезЦен          = ВыборкаКоличествоТоваровБезЦенСоСтарымиЦенами.КоличествоТоваровБезЦен;
		КоличествоТоваровСоСтарымиЦенами = ВыборкаКоличествоТоваровБезЦенСоСтарымиЦенами.КоличествоТоваровСоСтарымиЦенами;
	КонецЕсли;
	
	ЭлементыЗаголовкаЦен = Новый Массив;
	
	Если КоличествоТоваровБезЦен = 0 
		И КоличествоТоваровСоСтарымиЦенами = 0 Тогда
		ЭлементыЗаголовкаЦен.Добавить(НСтр("ru = 'Цены актуальны'"));
		Элементы.ДекорацияПредупреждениеЦен.Видимость = Ложь;
	КонецЕсли;
	
	Если КоличествоТоваровБезЦен <> 0 Тогда
		Элементы.ДекорацияПредупреждениеЦен.Видимость = Истина;
		
		ЭлементыЗаголовкаЦен.Добавить(СтрокаСЧислом(
			НСтр("ru =  ';
						|%1 товар без цены.;
						|;
						|%1 товара без цены.;
						|%1 товаров без цены.;
						|%1 товаров без цены.'"),
			КоличествоТоваровБезЦен,
			ВидЧисловогоЗначения.Количественное,
			"Л=ru_RU; ЧН=0; ЧГ=0"));
			
		ЭлементыЗаголовкаЦен.Добавить(" ");
		ЭлементыЗаголовкаЦен.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Они не будут показаны на веб-витрине.'"),, ЦветаСтиля.ЦветОтрицательногоЧисла));
		
		ЭлементыЗаголовкаЦен.Добавить(" ");
		ЭлементыЗаголовкаЦен.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Установить цены'"),,,,"ТоварыБезЦен"));
	КонецЕсли;

	Если КоличествоТоваровБезЦен <> 0
		И КоличествоТоваровСоСтарымиЦенами <> 0 Тогда
		ЭлементыЗаголовкаЦен.Добавить(Символы.ПС);
	КонецЕсли;
	
	Если КоличествоТоваровСоСтарымиЦенами <> 0 Тогда
		
		Если КоличествоТоваровБезЦен <> 0 Тогда
			ЭлементыЗаголовкаЦен.Добавить(Символы.ПС);
		КонецЕсли;
		
		Элементы.ДекорацияПредупреждениеЦен.Видимость = Истина;
		ЭлементыЗаголовкаЦен.Добавить(СтрокаСЧислом(
			НСтр("ru =  ';
						|%1 товар с ценой установленной более месяца назад.;
						|;
						|%1 товара с ценой установленной более месяца назад.;
						|%1 товаров с ценой установленной более месяца назад.;
						|%1 товаров с ценой установленной более месяца назад.'"),
			КоличествоТоваровСоСтарымиЦенами,
			ВидЧисловогоЗначения.Количественное,
			"Л=ru_RU; ЧН=0; ЧГ=0"));
			
		ЭлементыЗаголовкаЦен.Добавить(" ");
		ЭлементыЗаголовкаЦен.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Обновить цены'"),,,,"ТоварыСоСтарымиЦенами"));
	КонецЕсли;
	
	Элементы.ДекорацияУстановкаЦенИтоги.Заголовок = Новый ФорматированнаяСтрока(ЭлементыЗаголовкаЦен);
	
	КоличествоТоваровБезИзображений = 0;
	ВыборкаКоличествоТоваровБезИзображений = Результат[3].Выбрать();
	Если ВыборкаКоличествоТоваровБезИзображений.Следующий()
		И ТипЗнч(ВыборкаКоличествоТоваровБезИзображений.КоличествоТоваровБезИзображений) = Тип("Число") Тогда
		КоличествоТоваровБезИзображений = ВыборкаКоличествоТоваровБезИзображений.КоличествоТоваровБезИзображений;
	КонецЕсли;

	Если КоличествоТоваровБезИзображений = 0 Тогда
		Элементы.ДекорацияУстановкаИзображенийИтоги.Заголовок =
			НСтр("ru = 'Для всех товаров установлены изображения'");
	Иначе
		КоличествоТоваровБезИзображенийСтрокой = СтрокаСЧислом(
			НСтр("ru =  ';
						|%1 товар без изображений;
						|;
						|%1 товара без изображений;
						|%1 товаров без изображений;
						|%1 товаров без изображений'"),
			КоличествоТоваровБезИзображений,
			ВидЧисловогоЗначения.Количественное,
			"Л=ru_RU; ЧН=0; ЧГ=0");
		
		Элементы.ДекорацияУстановкаИзображенийИтоги.Заголовок = КоличествоТоваровБезИзображенийСтрокой;
	КонецЕсли;	
	
	
	Элементы.ВыгрузитьВсеТовары.Видимость                   = ПовторнаяНастройка;
	Если ПовторнаяНастройка Тогда
		Элементы.КомандаДалееВыгрузитьТовары.Заголовок = НСтр("ru = 'Сохранить настройки и выгрузить новые товары'");
	Иначе
		Элементы.КомандаДалееВыгрузитьТовары.Заголовок = НСтр("ru = 'Сохранить настройки и выгрузить товары'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСКаталогомТоваров

&НаКлиенте
Процедура ПерейтиКВыгрузкеТоваров(Команда)
	ВыполнитьПереходКСтранице("СтраницаВыгрузкаДанных");
КонецПроцедуры

&НаКлиенте
Процедура СтраницаНастройкаВыгрузки_ПриПереходеДалее(Отказ)
	
	ПубликуемыеГруппы.Очистить();
	
	Если ИспользоватьФильтрНоГруппам = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементКаталога Из НоменклатураКаталога.ПолучитьЭлементы() Цикл
		
		Если ЭлементКаталога.Отметка = 1 Тогда
			ПубликуемыеГруппы.Добавить(ЭлементКаталога.Ссылка);
		КонецЕсли;
		Если ЭлементКаталога.Отметка <> 0 Тогда
			ПубликуемыеГруппыПоПодчиненнымЭлементам(ЭлементКаталога);	
		КонецЕсли;
	КонецЦикла;
	
	Если ПубликуемыеГруппы.Количество() = 0 Тогда
		СообщитьПользователюНаКлиенте(
			НСтр("ru = 'Выберите группы номенклатуры, которые будут публиковаться на веб-витрине'"),
			"ИспользоватьФильтрНоГруппам");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПубликуемыеГруппыПоПодчиненнымЭлементам(ТекущийЭлемент)
	Для Каждого ЭлементКаталога Из ТекущийЭлемент.ПолучитьЭлементы() Цикл
		Если ЭлементКаталога.Отметка = 1 Тогда
			ПубликуемыеГруппы.Добавить(ЭлементКаталога.Ссылка);
		КонецЕсли;
		Если ЭлементКаталога.Отметка <> 0 Тогда
			ПубликуемыеГруппыПоПодчиненнымЭлементам(ЭлементКаталога);	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтборыКаталогаТоваров(ОтборыКаталогаТоваров)
	
	ОтборыКаталогаТоваров = ПубликуемыеГруппы.ВыгрузитьЗначения();
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьОтборыКаталогаТоваров(ОсновныеНастройки, ДополнительныеНастройки)
	
	НастройкиВитрины = Новый Структура;
	НастройкиВитрины.Вставить("ОсновныеНастройки", ОсновныеНастройки);
	НастройкиВитрины.Вставить("ДополнительныеНастройки", ДополнительныеНастройки);
	
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	
	ПубликуемыеГруппы.ЗагрузитьЗначения(НастройкиФильтровНоменклатуры.ЗначенияОтборовПоНоменклатуре);
	
	НоменклатураИсключения.Очистить();
	Для Каждого ИсключаемаяНоменклатура Из НастройкиФильтровНоменклатуры.ИсключаемаяНоменклатура Цикл
		НоваяСтрока = НоменклатураИсключения.Добавить();
		НоваяСтрока.Ссылка = ИсключаемаяНоменклатура;
	КонецЦикла;
	НоменклатураИсключенийКоличествоСтрок = НоменклатураИсключения.Количество();
	
	ИспользоватьФильтрНоГруппам = ?(ПубликуемыеГруппы.Количество() = 0, 0, 1);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКаталогНоменклатуры()

	НоменклатураКаталога.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Если ИерархияПо = Маг1СПеречисления.ИерархияПо_ГруппыНоменклатуры() Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СпрНоменклатура.Ссылка КАК Ссылка,
			|	СпрНоменклатура.Наименование КАК Наименование,
			|	ВЫБОР
			|		КОГДА СпрНоменклатура.ПометкаУдаления
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК КартинкаГруппы,
			|	СпрНоменклатура.Родитель КАК Родитель,
			|	ВЫБОР
			|		КОГДА СпрНоменклатура.Ссылка В (&ЗначенияОтборовНоменклатуры)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Отметка
			|ИЗ
			|	Справочник.ИмяСправочникаНоменклатура КАК СпрНоменклатура
			|ГДЕ
			|	СпрНоменклатура.ЭтоГруппа";

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаНоменклатура", 
			Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()));
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СпрВидыНоменклатуры.Ссылка КАК Ссылка,
			|	СпрВидыНоменклатуры.Наименование КАК Наименование,
			|	ВЫБОР
			|		КОГДА НЕ СпрВидыНоменклатуры.ПометкаУдаления
			|			И СпрВидыНоменклатуры.ЭтоГруппа
			|			ТОГДА 0
			|		КОГДА СпрВидыНоменклатуры.ПометкаУдаления
			|			И СпрВидыНоменклатуры.ЭтоГруппа
			|			ТОГДА 1
			|		КОГДА НЕ СпрВидыНоменклатуры.ПометкаУдаления
			|			И НЕ СпрВидыНоменклатуры.ЭтоГруппа
			|			ТОГДА 2
			|		КОГДА СпрВидыНоменклатуры.ПометкаУдаления
			|			И НЕ СпрВидыНоменклатуры.ЭтоГруппа
			|			ТОГДА 3
			|	КОНЕЦ КАК КартинкаГруппы,
			|	СпрВидыНоменклатуры.Родитель КАК Родитель,
			|	ВЫБОР
			|		КОГДА СпрВидыНоменклатуры.Ссылка В (&ЗначенияОтборовНоменклатуры)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Отметка
			|ИЗ
			|	Справочник.ИмяСправочникаВидыНоменклатуры КАК СпрВидыНоменклатуры
			|ГДЕ
			|	&УсловиеОтбора
			|	ИЛИ СпрВидыНоменклатуры.ЭтоГруппа";

		
		УсловияОтбора = Маг1СИнтеграция.ТекстФильтраПоПараметрамОтбора(Запрос, "ВидНоменклатуры", "СпрВидыНоменклатуры");		
		
		Если Не ПустаяСтрока(УсловияОтбора) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", УсловияОтбора);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "ИСТИНА");
		КонецЕсли;
		
		ИмяСправочникаВидыНоменклатуры = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ВидНоменклатуры());
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаВидыНоменклатуры",ИмяСправочникаВидыНоменклатуры);
	КонецЕсли;	
	
	ЗначенияОтборовНоменклатуры =  ПубликуемыеГруппы.ВыгрузитьЗначения();
	Запрос.УстановитьПараметр("ЗначенияОтборовНоменклатуры", ЗначенияОтборовНоменклатуры);
	Результат = Запрос.Выполнить().Выгрузить();
	
	ЭлементыНулевогоУровня = НоменклатураКаталога.ПолучитьЭлементы();
	
	Если ИерархияПо = Маг1СПеречисления.ИерархияПо_ГруппыНоменклатуры() Тогда
		КорневаяГруппа = Результат.НайтиСтроки(Новый Структура("Родитель", НастройкиУчетнойСистемы.Номенклатура.Значение));
		БезГруппы = ЭлементыНулевогоУровня.Добавить();
		БезГруппы.Ссылка  = НастройкиУчетнойСистемы.Номенклатура.Значение;
		БезГруппы.Отметка = ? (ЗначенияОтборовНоменклатуры.Найти(НастройкиУчетнойСистемы.Номенклатура.Значение) <> Неопределено, 1, 0);
	Иначе
		КорневаяГруппа = Результат.НайтиСтроки(Новый Структура("Родитель", НастройкиУчетнойСистемы.ВидНоменклатуры.Значение));
	КонецЕсли;
	
	Для Каждого ЭлементВерхнегоУровня Из КорневаяГруппа Цикл
		ДобавитьОтобранныйЭлементКаталогаТоваров(ЭлементВерхнегоУровня, ЭлементыНулевогоУровня, Результат, 0);
	КонецЦикла;
	
	Если ЭлементыНулевогоУровня.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыПервогоУровня = ЭлементыНулевогоУровня[0].ПолучитьЭлементы();
	
	Если ЭлементыПервогоУровня.Количество() > 0 Тогда
		Элементы.НоменклатураКаталога.ТекущаяСтрока = ЭлементыПервогоУровня[0].ПолучитьИдентификатор()
	КонецЕсли;
	
	НоменклатураКаталогаКоличествоГрупп = 0;
	ПосчитатьКоличествоВыбранныхГрупп(ЭлементыНулевогоУровня, НоменклатураКаталогаКоличествоГрупп);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтобранныйЭлементКаталогаТоваров(Элемент, Группа, ВсеЭлементы, Уровень)
	
	НоваяСтрока = Группа.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
	
	Если НоваяСтрока.Отметка <> 0 Тогда
		РодительНовойСтроки = НоваяСтрока.ПолучитьРодителя();
		Пока РодительНовойСтроки <> Неопределено Цикл
			Если РодительНовойСтроки.Отметка <> 1 Тогда
				РодительНовойСтроки.Отметка = 2;
			КонецЕсли;
			РодительНовойСтроки = РодительНовойСтроки.ПолучитьРодителя();
		КонецЦикла;
	КонецЕсли;
	
	ЭлементыГруппы = ВсеЭлементы.НайтиСтроки(Новый Структура("Родитель", Элемент.Ссылка));
	НоваяГруппа = НоваяСтрока.ПолучитьЭлементы();
	
	Для Каждого ПодчиненныйЭлемент Из ЭлементыГруппы Цикл
		ДобавитьОтобранныйЭлементКаталогаТоваров(ПодчиненныйЭлемент, НоваяГруппа, ВсеЭлементы, Уровень + 1);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураКаталогаОтметкаПриИзменении(Элемент)
	
	ТекущаяСтрока = НоменклатураКаталога.НайтиПоИдентификатору(Элементы.НоменклатураКаталога.ТекущаяСтрока);
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.Отметка = 2 Тогда
		ТекущаяСтрока.Отметка = 0;
	КонецЕсли;
	
	ИзменитьОтметкиПодчиненных(ТекущаяСтрока);
	
	ИзменитьОтметкуРодителя(ТекущаяСтрока);
	
	НоменклатураКаталогаКоличествоГрупп = 0;
	ЭлементыДерева = НоменклатураКаталога.ПолучитьЭлементы();
	ПосчитатьКоличествоВыбранныхГрупп(ЭлементыДерева, НоменклатураКаталогаКоличествоГрупп);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтметкиПодчиненных(ТекущаяСтрока)
	
	Для Каждого ПодчиненныйЭлемент Из ТекущаяСтрока.ПолучитьЭлементы() Цикл
		ПодчиненныйЭлемент.Отметка = ТекущаяСтрока.Отметка;
		ИзменитьОтметкиПодчиненных(ПодчиненныйЭлемент);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтметкуРодителя(ТекущаяСтрока)
	
	РодительСтроки = ТекущаяСтрока.ПолучитьРодителя();
	
	Если РодительСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РодительСтроки.Отметка = 0
		И ТекущаяСтрока.Отметка <> 0 Тогда
		РодительСтроки.Отметка = 2;
	ИначеЕсли РодительСтроки.Отметка = 2
		И ТекущаяСтрока.Отметка = 0 Тогда
	
		ВсеПотомкиВыключены = Истина;
		
		Для Каждого ПодчиненныйЭлемент Из РодительСтроки.ПолучитьЭлементы() Цикл
			Если ПодчиненныйЭлемент.Отметка <> 0 Тогда
				ВсеПотомкиВыключены = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВсеПотомкиВыключены Тогда
			РодительСтроки.Отметка = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ИзменитьОтметкуРодителя(РодительСтроки);
	
