	ОписаниеОповещения = Новый ОписаниеОповещения("НастроитьОтображениеСвойствТоваровЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.Маг1СИнструментыПодготовкиКаталога.Форма.НастройкаСвойствТоваров",
				ПараметрыМастера,
				ЭтотОбъект,
				,
				,
				,
				ОписаниеОповещения
				,
				 );
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтображениеТоваровСоЗначкамиНаГлавнойСтраницеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	НастроитьОтображениеТоваровСоЗначкамиНаГлавнойСтраницеЗавершениеСервер(Результат);

КонецПроцедуры

&НаСервере
Процедура НастроитьОтображениеТоваровСоЗначкамиНаГлавнойСтраницеЗавершениеСервер(Результат)
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.ВосстановитьИзНастроекЗначкиНоменклатуры(ЭтотОбъект, Результат);

КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтображениеСвойствТоваровЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	ВыгружаемыеСвойстваТоваров.Очистить();
	
	Для Каждого КлючЗначение из Результат Цикл
		НоваяСтрока = ВыгружаемыеСвойстваТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СкопироватьИмяВитриныВБуферОбмена(Команда)
	Маг1СИнтеграцияСлужебныйКлиент.ПоместитьВБуферОбмена(АдресСайтаВитрины);
КонецПроцедуры

