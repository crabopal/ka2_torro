#Область ДоменПользователя

&НаКлиенте
Процедура НастроитьОтображениеДоменаПользователя()
	
	ЗаголовокДоменаПользователя = "";
	
	Если ЗначениеЗаполнено(ДоменПользователя) Тогда
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.СертификатДоменаПользователяЕстьПроблема(СтрокаСпискаВитрин) Тогда
				
			ЗаголовокДоменаПользователя = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
					НСтр("ru = 'Свой веб-адрес: <a href=""https://%1/"">%2</a> <span style="""">(нужно обновить сертификат)</span> <a href=""НастроитьДоменПользователя"">Настроить</a>'"),
					ДоменПользователя,
					ДоменПользователя);
		Иначе
			ПредставлениеСостояния = НРег(Маг1СПеречисления.СостоянияДоменаПользователяПредставление(СтрокаСпискаВитрин.СостояниеДоменаПользователя));
			
			Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.СостояниеДоменаПользователяЕстьПроблема(СтрокаСпискаВитрин.СостояниеДоменаПользователя) Тогда
				ЗаголовокДоменаПользователя = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
					НСтр("ru = 'Свой веб-адрес: <a href=""https://%1/"">%2</a> (%3) <a href=""НастроитьДоменПользователя"">Настроить</a>'"),
					ДоменПользователя,
					ДоменПользователя,
					ПредставлениеСостояния);
			Иначе
				ЗаголовокДоменаПользователя = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
					НСтр("ru = 'Свой веб-адрес: <a href=""https://%1/"">%2</a> <span style="""">(%3)</span> <a href=""НастроитьДоменПользователя"">Настроить</a>'"),
					ДоменПользователя,
					ДоменПользователя,
					ПредставлениеСостояния);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЗаголовокДоменаПользователя = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = 'Свой веб-адрес: <b>Не подключено</b> <a href=""НастроитьДоменПользователя"">Подключить</a>'"));
	КонецЕсли;
	
	Элементы.ДекорацияНадписьСвоеДоменноеИмя.Заголовок = ЗаголовокДоменаПользователя
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоменПользователя()
	
	Если Не ПрофильПользователя.ЕстьПлатныйТариф Тогда
		Если СтрокаСпискаВитрин.СостояниеДоменаПользователя = Маг1СПеречисления.СостоянияДоменаПользователя_None() Тогда
			Тексты = Новый Массив;
			
			Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">Для подключения своего веб-адреса необходимо приобрести один из платных тарифов сервиса mag1c.'"));
			Тексты.Добавить(Текст);
			Тексты.Добавить(Символы.ПС);
			Тексты.Добавить(Символы.ПС);
			
			Если РазделениеВключено Тогда
				Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">Получить информацию о тарифах можно на </span> <a href=""https://portal.1c.ru/applications/1C-MAG#prices"">странице Портала ИТС</a>'"));
				Тексты.Добавить(Текст);
				Тексты.Добавить(Символы.ПС);
				Тексты.Добавить(Символы.ПС);
				
				Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">Чтобы купить тариф, обратитесь, пожалуйста, к партнёру, который работает с вами в сервисе 1cfresh.'"));
				Тексты.Добавить(Текст);
			Иначе
				Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">Получить информацию о тарифах и приобрести один из них можно на </span><a href=""https://portal.1c.ru/applications/1C-MAG#prices"">странице Портала ИТС</a>'"));
				Тексты.Добавить(Текст);
			
			КонецЕсли;
			
			ПоказатьПредупреждение(, Новый ФорматированнаяСтрока(Тексты));
			
			Возврат;
		Иначе
			Тексты = Новый Массив;
			
			Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">Сейчас у вас нет действующего платного тарифа сервиса mag1c, поэтому вы можете только просмотреть информацию о подключенном веб-адресе или его отключить.'"));
			Тексты.Добавить(Текст);
			Тексты.Добавить(Символы.ПС);
			Тексты.Добавить(Символы.ПС);
			
			Если РазделениеВключено Тогда
				Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">Получить информацию о тарифах можно на </span> <a href=""https://portal.1c.ru/applications/1C-MAG#prices"">странице Портала ИТС</a>'"));
				Тексты.Добавить(Текст);
				Тексты.Добавить(Символы.ПС);
				Тексты.Добавить(Символы.ПС);
				
				Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">Чтобы купить тариф, обратитесь, пожалуйста, к партнёру, который работает с вами в сервисе 1cfresh.'"));
				Тексты.Добавить(Текст);
			Иначе
				Текст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">Получить информацию о тарифах и приобрести один из них можно на </span><a href=""https://portal.1c.ru/applications/1C-MAG#prices"">странице Портала ИТС</a>'"));
				Тексты.Добавить(Текст);
			
			КонецЕсли;
			
			
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("НастроитьДоменПользователяЗавершение", ЭтотОбъект),
									Новый ФорматированнаяСтрока(Тексты));
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	НастроитьДоменПользователяЗавершение();

КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоменПользователяЗавершение(Результат = Неопределено) Экспорт
	
	Перем ОписаниеОповещения, ПараметрыНастройки;
	
	ПараметрыНастройки = Новый Структура();
	ПараметрыНастройки.Вставить("ДоменПользователя", ДоменПользователя);
	ПараметрыНастройки.Вставить("ЕстьПлатныйТариф", ПрофильПользователя.ЕстьПлатныйТариф);
	ПараметрыНастройки.Вставить("ЗарегистрированныйДоменПользователя", ЗарегистрированныйДоменПользователя);
	ПараметрыНастройки.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыНастройки.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин);
	ПараметрыНастройки.Вставить("ТипСертификатаДоменаПользователя", ТипСертификатаДоменаПользователя);
	ПараметрыНастройки.Вставить("EMailДляОтправкиУведомлений", EMailДляОтправкиУведомлений);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаНастройкиДоменаПользователя", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.Маг1СНастройка.Форма.ПодключениеДомена",
	ПараметрыНастройки,
	ЭтотОбъект,
	,
	,
	,
	ОписаниеОповещения,
	 );

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНастройкиДоменаПользователя(Результат, ДополнительныеПараметры) Экспорт
	Если Не ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.ДоменПользователя = ЗарегистрированныйДоменПользователя
		И Результат.ТипСертификатаДоменаПользователя = ЗарегистрированныйТипСертификатаДоменаПользователя
		И Не Маг1СИнтеграцияСлужебныйКлиентСервер.СертификатДоменаПользователяЗаполнен(Результат.СертификатДоменаПользователя) Тогда
		Возврат;
	КонецЕсли;
	
	ДоменПользователя                = Результат.ДоменПользователя;
	ТипСертификатаДоменаПользователя = Результат.ТипСертификатаДоменаПользователя;
	СертификатДоменаПользователя     = Результат.СертификатДоменаПользователя;
	
	ПовторнаяНастройка = Истина;
	
	Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаПодготовкаВитриныОжидание;
	
	ПодключитьОбработчикОжидания("ПриНачалеОбновленияНастроекВитрины", 0.1, Истина);
КонецПроцедуры

#КонецОбласти

#Область ИсточникиПереноса

&НаКлиенте
Процедура ИсточникиПереноса1Нажатие(Элемент)
	ОбновитьИсточникиПереноса(1);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиПереноса2Нажатие(Элемент)
	ОбновитьИсточникиПереноса(2);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИсточникиПереноса(ВыбранныйНомерПерехода)
	Если ИсточникиПереноса.Количество() > 0 И ИсточникиПереноса.Количество() >= ВыбранныйНомерПерехода Тогда 
		ПараметрыИсточникиПереноса = ИсточникиПереноса[ВыбранныйНомерПерехода-1];
		
		ИсточникПереносаВыбранный = ПараметрыИсточникиПереноса.Источник;
		РежимПереноса = ПараметрыИсточникиПереноса.РежимПереноса;
		
		ОбновитьРамкиКартинокИсточниковПереноса(ВыбранныйНомерПерехода);
	Иначе
		ИсточникПереносаВыбранный = "Неопределено";
		РежимПереноса = Маг1СПеречисления.РежимПереносаОтсутствует();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРамкиКартинокИсточниковПереноса(ВыбранныйНомерПерехода)
	
	Для номерТипПерехода = 1 По ИсточникиПереноса.Количество() Цикл
		Если номерТипПерехода = ВыбранныйНомерПерехода Тогда
			Элементы["КартинкаТипПерехода"+номерТипПерехода].Картинка = 
				БиблиотекаКартинок[ИсточникиПереноса[номерТипПерехода-1].ПсевдонимКартинки+"_2"];
		Иначе
			Элементы["КартинкаТипПерехода"+номерТипПерехода].Картинка = 
				БиблиотекаКартинок[ИсточникиПереноса[номерТипПерехода-1].ПсевдонимКартинки];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти


