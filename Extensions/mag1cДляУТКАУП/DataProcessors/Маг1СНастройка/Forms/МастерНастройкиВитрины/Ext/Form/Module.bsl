#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.СтрокаСпискаВитрин = Неопределено  Тогда
		ВызватьИсключение НСтр("ru = 'Форма предназначена для открытия по команде НастройкаВитрины из ГКИ.'");	
	КонецЕсли;
	
	ЛогинИПП            = Параметры.ЛогинИПП;
	РежимФормы          = Параметры.РежимФормы;
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки()
		Или РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда
		ПрофильПользователя = Обработки.Маг1СНастройка.СтруктураПрофиляПользователя();
	Иначе	
		ПрофильПользователя = Параметры.ПрофильПользователя;
		ИмяДоменаДляРегистрацииВитрины = "." + ПрофильПользователя.ИмяДомена;
	КонецЕсли;
	
	ОбновитьСтрокуСпискаВитрин(ЭтотОбъект, Параметры.СтрокаСпискаВитрин);
	
	ИнициализироватьРеквизитыФормы();
	ЗаполнитьТаблицуПереходовПоСценарию();
	
	РазделениеВключено = ОбщегоНазначения.РазделениеВключено();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ВитринаПомещенаВАрхив(СтрокаСпискаВитрин) Тогда
		ПоказатьОшибку(Новый Структура, Истина, "");
		Возврат;
	КонецЕсли;
	
	Инфо = ПолучитьИнформациюЭкрановКлиента();
	
	ЕстьМаленькийЭкран = Ложь;
	
	Для Каждого Экран из Инфо Цикл
		Если Экран.Высота < 860 Тогда
			ЕстьМаленькийЭкран = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ДекорацияЗаставкаМастера.РастягиватьПоВертикали = Не Маг1СИнтеграцияСлужебныйКлиентСервер.ЭтоВариантИнтерфейса85();
	
	ВычислитьВидимостьПанелиШаговМастера();
	
	Элементы.ДекорацияЗаставкаМастера.Видимость    = Не ЕстьМаленькийЭкран;
	Элементы.ДекорацияКартинкаЗавершение.Видимость = Не ЕстьМаленькийЭкран;
	
	Элементы.СкопироватьИмяВитриныВБуферОбмена.Видимость = Маг1СИнтеграцияСлужебныйКлиент.ПоддержимаетсяРаботаСБуферомОбмена();
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
		Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаШагиМастера;
		ВыполнитьПереходКСтранице("СтраницаНастройкаДоставки");
	ИначеЕсли РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c() Тогда	
		Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаШагиМастера;
		ВыполнитьПереходКСтранице("СтраницаНазваниеВитрины");
	Иначе	
		Если Не ПустаяСтрока(СтраницаПереходаСохраненная) Тогда
			Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаШагиМастера;
			
			ВыполнитьПереходКСтранице(СтраницаПереходаСохраненная);
		Иначе
			Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаПриветствие;
			УстановитьПорядковыйНомерПерехода(1);
			ОбновитьИсточникиПереноса(1);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

