&НаКлиенте
Процедура ПодборНоменклатурыИсключений(Команда)
	
	ПараметрыФормыВыбора = Новый Структура();
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
		
	ОткрытьФорму(ИмяФормыВыбораНоменклатуры,
					ПараметрыФормыВыбора,
					Элементы.НоменклатураИсключения,
					,
					,
					,
					,
					 );
		
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураИсключенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИзмененныеЭлементы = Новый СписокЗначений;
	
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого ВыбранныйЭлементНоменклатуры Из ВыбранноеЗначение Цикл
			ДобавитьСтрокуИсключений(ВыбранныйЭлементНоменклатуры, ИзмененныеЭлементы);
		КонецЦикла;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Элементы добавлены в список'"));
	Иначе
		ДобавитьСтрокуИсключений(ВыбранноеЗначение, ИзмененныеЭлементы);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Элемент добавлен в список'"));
	КонецЕсли;
	НоменклатураИсключенийКоличествоСтрок = НоменклатураИсключения.Количество();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуИсключений(ВыбранныйЭлементНоменклатуры, ИзмененныеЭлементы)
	
	Если ТипЗнч(ВыбранныйЭлементНоменклатуры) = ТипЗнч(НастройкиУчетнойСистемы.Номенклатура.Значение)
		И НоменклатураИсключения.НайтиСтроки(Новый Структура("Ссылка", ВыбранныйЭлементНоменклатуры)).Количество() = 0 Тогда
		НоваяСтрокаИсключения = НоменклатураИсключения.Добавить();
		НоваяСтрокаИсключения.Ссылка = ВыбранныйЭлементНоменклатуры;
		ИзмененныеЭлементы.Добавить(ВыбранныйЭлементНоменклатуры);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПубликоватьТолькоАктивныеПозицииПереключательПриИзменении(Элемент)
	
	ПубликоватьТолькоАктивныеПозиции = ПубликоватьТолькоАктивныеПозицииПереключатель;
	
	Если Не ОтборПоОстаткам
		И Не ОтборПоПродажам
		И Не ОтборПоЗаказамПоставщикам
		И ПубликоватьТолькоАктивныеПозиции Тогда
		ОтборПоОстаткам = Истина;
		ОтборПоПродажам = Истина;
		ОтборПоЗаказамПоставщикам = Истина;
	КонецЕсли;
	
	Если Не ПубликоватьТолькоАктивныеПозиции Тогда
		ОтборПоОстаткам = Ложь;
		ОтборПоПродажам = Ложь;
		ОтборПоЗаказамПоставщикам = Ложь;
		ОтборПоСегменту = Ложь;
	КонецЕсли;
	
	УстановитьДоступностьФильтровАктивныхПозиций();
	НастроитьВидимостьГруппыСкладыОстатков();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьФильтровАктивныхПозиций()
	
	Элементы.ОтборПоОстаткам.Доступность = ПубликоватьТолькоАктивныеПозиции;
	Элементы.ОтборПоПродажам.Доступность = ПубликоватьТолькоАктивныеПозиции;
	Элементы.ОтборПоЗаказамПоставщикам.Доступность = ПубликоватьТолькоАктивныеПозиции;
	Элементы.ОтборПоСегменту.Доступность = ПубликоватьТолькоАктивныеПозиции;
	
	Элементы.ГруппаАктивныеПозиции.Видимость = ПубликоватьТолькоАктивныеПозиции;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураИсключенияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	НоваяСтрока = НоменклатураИсключения.Добавить();
	НоваяСтрока.Ссылка = НастройкиУчетнойСистемы.Номенклатура.Значение;
	НоменклатураИсключенийКоличествоСтрок = НоменклатураИсключения.Количество();
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураИсключенияПослеУдаления(Элемент)
	НоменклатураИсключенийКоличествоСтрок = НоменклатураИсключения.Количество();
КонецПроцедуры

&НаКлиенте
Процедура УчитыватьОстаткиТолькоПоВыбраннымСкладамПереключательПриИзменении(Элемент)
	УчитыватьОстаткиТолькоПоВыбраннымСкладам = УчитыватьОстаткиТолькоПоВыбраннымСкладамПереключатель;
	НастроитьВидимостьГруппыСкладыОстатков();
КонецПроцедуры

#КонецОбласти

