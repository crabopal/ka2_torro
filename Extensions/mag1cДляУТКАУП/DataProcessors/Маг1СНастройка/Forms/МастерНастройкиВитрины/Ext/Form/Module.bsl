&НаКлиенте
Процедура ПолучитьЛистовкуМагазина(Команда)
	
	АдресФайла = ПолучитьФайлЛистовкиМагазина();
	
	Оповещение = Новый ОписаниеОповещения("ПолучитьЛистовкуМагазинаЗавершение", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("АдресФайла", АдресФайла);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Сохранить листовку магазина'");
	ПараметрыСохранения.Диалог.Фильтр = "Документ PDF (*.pdf)|*.pdf";
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресФайла, НСтр("ru = 'Листовка магазина.pdf'"), ПараметрыСохранения);
	
