Процедура ВосстановитьНастройкиУведомлений(Настройки)
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантыОплатыПриСамовывозе(ВариантыОплаты)
	
	ВариантыОплаты.НаличнымиПриПолучении     = ОплатаПриСамовывозеНаличными;
	ВариантыОплаты.КартойПриПолучении        = ОплатаПриСамовывозеКартой;
	ВариантыОплаты.ОнлайнПереводПриПолучении = ОплатаПриСамовывозеОнлайнПереводом;
	ВариантыОплаты.ПереводомНаСчет           = ОплатаПриСамовывозеПереводомНаСчет;
	ВариантыОплаты.ОнЛайнЧерезЮКассу         = ОплатаПриСамовывозеЮКасса;
	ВариантыОплаты.ОнЛайнЧерезСБП            = ОплатаПриСамовывозеСБП;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьВариантыОплатыПриСамовывозе(ВариантыОплаты)
	
	ОплатаПриСамовывозеНаличными       = ВариантыОплаты.НаличнымиПриПолучении;
	ОплатаПриСамовывозеКартой          = ВариантыОплаты.КартойПриПолучении;
	ОплатаПриСамовывозеОнлайнПереводом = ВариантыОплаты.ОнлайнПереводПриПолучении;
	ОплатаПриСамовывозеПереводомНаСчет = ВариантыОплаты.ПереводомНаСчет;
	ОплатаПриСамовывозеЮКасса          = ВариантыОплаты.ОнЛайнЧерезЮКассу;
	ОплатаПриСамовывозеСБП             = ВариантыОплаты.ОнЛайнЧерезСБП;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантыОплатыПриКурьерскойДоставке(ВариантыОплаты)
	
	ВариантыОплаты.НаличнымиПриПолучении     = ОплатаПриКурьерскойДоставкеНаличными;
	ВариантыОплаты.КартойПриПолучении        = ОплатаПриКурьерскойДоставкеКартой;
	ВариантыОплаты.ОнлайнПереводПриПолучении = ОплатаПриКурьерскойДоставкеОнлайнПереводом;
	ВариантыОплаты.ПереводомНаСчет           = ОплатаПриКурьерскойДоставкеПереводомНаСчет;
	ВариантыОплаты.ОнЛайнЧерезЮКассу         = ОплатаПриКурьерскойДоставкеЮКасса;
	ВариантыОплаты.ОнЛайнЧерезСБП            = ОплатаПриКурьерскойДоставкеСБП;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьВариантыОплатыПриКурьерскойДоставке(ВариантыОплаты)
	
	ОплатаПриКурьерскойДоставкеНаличными       = ВариантыОплаты.НаличнымиПриПолучении;
	ОплатаПриКурьерскойДоставкеКартой          = ВариантыОплаты.КартойПриПолучении;
	ОплатаПриКурьерскойДоставкеОнлайнПереводом = ВариантыОплаты.ОнлайнПереводПриПолучении;
	ОплатаПриКурьерскойДоставкеПереводомНаСчет = ВариантыОплаты.ПереводомНаСчет;
	ОплатаПриКурьерскойДоставкеЮКасса          = ВариантыОплаты.ОнЛайнЧерезЮКассу;
	ОплатаПриКурьерскойДоставкеСБП             = ВариантыОплаты.ОнЛайнЧерезСБП;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантыОплатыПриДоставкеТранспортнойКомпанией(ВариантыОплаты)
	
	ВариантыОплаты.НаличнымиПриПолучении     = ОплатаПриДоставкеТранспортнойКомпаниейНаличными;
	ВариантыОплаты.КартойПриПолучении        = ОплатаПриДоставкеТранспортнойКомпаниейКартой;
	ВариантыОплаты.ОнлайнПереводПриПолучении = Ложь;
	ВариантыОплаты.ПереводомНаСчет           = ОплатаПриДоставкеТранспортнойКомпаниейПереводомНаСчет;
	ВариантыОплаты.ОнЛайнЧерезЮКассу         = ОплатаПриДоставкеТранспортнойКомпаниейЮКасса;
	ВариантыОплаты.ОнЛайнЧерезСБП            = ОплатаПриДоставкеТранспортнойКомпаниейСБП;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьВариантыОплатыПриДоставкеТранспортнойКомпанией(ВариантыОплаты)
	
	ОплатаПриДоставкеТранспортнойКомпаниейНаличными       = ВариантыОплаты.НаличнымиПриПолучении;
	ОплатаПриДоставкеТранспортнойКомпаниейКартой          = ВариантыОплаты.КартойПриПолучении;
	ОплатаПриДоставкеТранспортнойКомпаниейПереводомНаСчет = ВариантыОплаты.ПереводомНаСчет;
	ОплатаПриДоставкеТранспортнойКомпаниейЮКасса          = ВариантыОплаты.ОнЛайнЧерезЮКассу;
	ОплатаПриДоставкеТранспортнойКомпаниейСБП             = ВариантыОплаты.ОнЛайнЧерезСБП;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьСоответствияСтатусовЗаказов(СоответствияСтатусовЗаказов)
	
	Для Каждого КлючЗначение из НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.Соответствие Цикл
		Если Не СоответствияСтатусовЗаказов.Свойство(КлючЗначение.Ключ) Тогда
			СоответствияСтатусовЗаказов.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаСоответствияСтатусовЗаказов.Очистить();
	
	Для Каждого КлючЗначение из СоответствияСтатусовЗаказов Цикл
		НоваяСтрока = ТаблицаСоответствияСтатусовЗаказов.Добавить();
		НоваяСтрока.СтатусОбъектаФормата = КлючЗначение.Ключ;
		
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			НоваяСтрока.СтатусыОбъектовИБ.ЗагрузитьЗначения(КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВосстановитьСкладыОстатков(СкладыОстатковМассив)
	
	МетаданныеСклада    = НастройкиУчетнойСистемы.Склад.ОграничениеТипа.ПривестиЗначение().Метаданные();
	ИмяСправочникаСклад = МетаданныеСклада.Имя;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СпрСклады.Ссылка КАК Ссылка,
	|	СпрСклады.Ссылка В (&Склады) КАК Пометка
	|ИЗ
	|	Справочник.ИмяСправочникаСклад КАК СпрСклады
	|ГДЕ
	|	&ТекстУсловияПоГруппе
	|	И (СпрСклады.Ссылка В (&Склады)
	|			ИЛИ НЕ СпрСклады.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СпрСклады.Наименование";
	
	Если МетаданныеСклада.Иерархический
		И МетаданныеСклада.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстУсловияПоГруппе",  "НЕ СпрСклады.ЭтоГруппа");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстУсловияПоГруппе",  "ИСТИНА");
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаСклад", ИмяСправочникаСклад); 
	Запрос.УстановитьПараметр("Склады", СкладыОстатковМассив);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СкладыОстатков.Очистить();

	Пока Выборка.Следующий() Цикл
		СкладыОстатков.Добавить(Выборка.Ссылка,,Выборка.Пометка);	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьВыгружаемыеСвойстваТоваров(ВыгружаемыеСвойстваТоваровСоответствие)
	
	Для Каждого КлючЗначение Из ВыгружаемыеСвойстваТоваровСоответствие Цикл
		
		НоваяСтрока = ВыгружаемыеСвойстваТоваров.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КлючЗначение.Значение); 
		
	КонецЦикла;
	
	ВыгружаемыеСвойстваТоваров.Сортировать("Порядок");
	
КонецПроцедуры


Процедура ИнициализироватьЭлементыСоответствияСтатусов()
	СоответствиеСтатусовНастраивается = НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.ОграничениеТипа <> Неопределено;
	
	Если СоответствиеСтатусовНастраивается
		И НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.Соответствие.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В переопределяемой части расширения не настроено СоответствияСтатусовЗаказов'");
	КонецЕсли;
	
	Если СоответствиеСтатусовНастраивается Тогда
		Элементы.СтраницыСоответствиеСтатусовЗаказов.ТекущаяСтраница = Элементы.СтраницаСоответствиеСтатусовЗаказовНастройка;
		Элементы.ТаблицаСоответствияСтатусовЗаказов.РасширеннаяПодсказка.Заголовок = НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.РасширеннаяПодсказка;
	Иначе
		Элементы.СтраницыСоответствиеСтатусовЗаказов.ТекущаяСтраница = Элементы.СтраницаСоответствиеСтатусовЗаказовИнформация;
		Элементы.ДекорацияСоответствиеСтатусовЗаказовПоясняющийТекстИнформация.Заголовок = НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.РасширеннаяПодсказка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоответствияСтатусовЗаказов(СоответствияСтатусовЗаказов)
	Для Каждого СтрТабл из ТаблицаСоответствияСтатусовЗаказов Цикл
		СоответствияСтатусовЗаказов.Вставить(СтрТабл.СтатусОбъектаФормата, СтрТабл.СтатусыОбъектовИБ.ВыгрузитьЗначения());
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыгружаемыеСвойстваТоваров(ВыгружаемыеСвойстваТоваровСоответствие)
	Для Каждого СтрТабл из ВыгружаемыеСвойстваТоваров Цикл
		НастройкаСвойства = Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктураНастройкиСвойстваТовара();
		ЗаполнитьЗначенияСвойств(НастройкаСвойства,СтрТабл);
		
		ВыгружаемыеСвойстваТоваровСоответствие.Вставить(СтрТабл.СвойствоТовара, НастройкаСвойства);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьДекорацииЮКассаТестовыйМагазин(Форма, ЭтоТестовыйМагазинЮКасса)
	
	Элементы = Форма.Элементы;
	
	Если Не ЭтоТестовыйМагазинЮКасса Тогда
		Элементы.ДекорацияОплатаПриДоставкеТранспортнойКомпаниейЮКассаТестовыйМагазин.Видимость = Ложь;
		Элементы.ДекорацияОплатаПриСамовывозеЮКассаТестовыйМагазин.Видимость                    = Ложь;
		Элементы.ДекорацияОплатаПриКурьерскойДоставкеЮКассаТестовыйМагазин.Видимость            = Ложь;
		Элементы.ДекорацияЮКассаТестовыйМагазин.Видимость                                       = Ложь;
		Элементы.ДекорацияОплатаПоСсылкеЧерезЮКассаТестовыйМагазин.Видимость                    = Ложь;
	Иначе
		Элементы.ДекорацияОплатаПриДоставкеТранспортнойКомпаниейЮКассаТестовыйМагазин.Видимость = Форма.ОплатаПриДоставкеТранспортнойКомпаниейЮКасса;
		Элементы.ДекорацияОплатаПриСамовывозеЮКассаТестовыйМагазин.Видимость                    = Форма.ОплатаПриСамовывозеЮКасса;
		Элементы.ДекорацияОплатаПриКурьерскойДоставкеЮКассаТестовыйМагазин.Видимость            = Форма.ОплатаПриКурьерскойДоставкеЮКасса;
		Элементы.ДекорацияОплатаПоСсылкеЧерезЮКассаТестовыйМагазин.Видимость                    = Истина;
		
		Элементы.ДекорацияЮКассаТестовыйМагазин.Видимость	                                    = Форма.ОплатаПриДоставкеТранспортнойКомпаниейЮКасса
																								Или Форма.ОплатаПриСамовывозеЮКасса
																								Или Форма.ОплатаПриКурьерскойДоставкеЮКасса
																								Или Форма.ОплатаПоСсылкеЧерезЮКассу;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбщегоНазначения

&НаКлиенте
Функция ИмяКорректно()
	Результат = Истина;
	
	Если СтрокаСодержитНедопустимыеСимволы(ИмяВитрины) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Можно использовать только латинские буквы, цифры и дефис.'"), "ИмяВитрины");
		Результат = Ложь;
	КонецЕсли;
	
	Если СтрокаСодержитНедопустимыеСочетания(ИмяВитрины) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'В адресе веб-витрины нельзя использовать сочетание ""1c"".'"), "ИмяВитрины");
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВычислитьВидимостьПанелиШаговМастера()
	ВидимостьПанелиШаговМастера = Не ПовторнаяНастройка И Не ЕстьМаленькийЭкран
									И РежимПереноса <> Маг1СПеречисления.РежимПереносаЭкспресс();
	Элементы.ГруппаДекорацииОбщая.Видимость = ВидимостьПанелиШаговМастера;
КонецПроцедуры

&НаКлиенте
Функция СтрокаСодержитНедопустимыеСимволы(ПроверяемаяСтрока)
	
	Результат = Ложь;
	
	ДоступныеСимволы = "abcdefghijklmnopqrstuvwxyz1234567890-";
	
	Для Сч = 1 По СтрДлина(ПроверяемаяСтрока) Цикл
		ТекущийСимвол = НРег(Сред(ПроверяемаяСтрока, Сч, 1));
		
		Если СтрНайти(ДоступныеСимволы, ТекущийСимвол) = 0 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтрокаСодержитНедопустимыеСочетания(ПроверяемаяСтрока)
	
	Поз = СтрНайти(НРег(ПроверяемаяСтрока), "1c");
	Если Поз = 1 Тогда
		Возврат Истина;
	ИначеЕсли Поз > 1 Тогда
		ПредСимв = Сред(НРег(ПроверяемаяСтрока), Поз - 1, 1);
		Если СтрНайти("1234567890", ПредСимв) = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСтрокуСпискаВитрин(Форма, НоваяСтрокаСпискаВитрин)
	
	Если НоваяСтрокаСпискаВитрин = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма.СтрокаСпискаВитрин = НоваяСтрокаСпискаВитрин;
	
	ЗаполнитьЗначенияСвойств(Форма, Форма.СтрокаСпискаВитрин);
	
	Если ЗначениеЗаполнено(Форма.ПолноеИмяВитрины) Тогда
		Форма.ЗарегистрированноеИмяВитрины = Сред(Форма.ПолноеИмяВитрины, 1, СтрНайти(Форма.ПолноеИмяВитрины, Форма.ИмяДоменаДляРегистрацииВитрины) - 1);
	Иначе
		Форма.ЗарегистрированноеИмяВитрины = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ДоменПользователя) Тогда
		Форма.ЗарегистрированныйДоменПользователя = Форма.ДоменПользователя;
	КонецЕсли;
	
	Форма.ЗарегистрированныйТипСертификатаДоменаПользователя = Форма.ЗарегистрированныйТипСертификатаДоменаПользователя; 
	
	Если СтрДлина(Форма.СтрокаСпискаВитрин.СообщениеМенеджера) > 80
		Или СтрЧислоСтрок(Форма.СтрокаСпискаВитрин.СообщениеМенеджера) > 1 Тогда
		
		Если СтрЧислоСтрок(Форма.СтрокаСпискаВитрин.СообщениеМенеджера) > 1 Тогда
			ПерваяСтрока = СтрЗаменить(СтрПолучитьСтроку(Форма.СтрокаСпискаВитрин.СообщениеМенеджера, 1),Символы.ПС, "");
		Иначе
			ПерваяСтрока = Форма.СтрокаСпискаВитрин.СообщениеМенеджера;
		КонецЕсли;
		
		Если СтрДлина(ПерваяСтрока) > 50 Тогда
			ПерваяСтрока = Лев(ПерваяСтрока, 50);
		КонецЕсли;
		
		Форма.Элементы.ДекорацияТекстСостоянияВитрины.Заголовок = 
			СтроковыеФункцииКлиентСервер.ФорматированнаяСтрока(
				ПерваяСтрока + НСтр("ru = '... <a href = ""Подробнее"">Подробнее</a>'"));
		
	Иначе
		Форма.Элементы.ДекорацияТекстСостоянияВитрины.Заголовок = Форма.СтрокаСпискаВитрин.СообщениеМенеджера;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПереходКСтранице(ИмяСтраницы)
	
	СтрокиПереходов = ТаблицаПереходов.НайтиСтроки(Новый Структура("ИмяОсновнойСтраницы", ИмяСтраницы));
	
	Если СтрокиПереходов.Количество() = 0 Тогда
		СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неизвестное имя страницы перехода: %1'"),
			ИмяСтраницы);
		Маг1СИнтеграцияСлужебныйКлиент.ПоказатьПредупреждениеОбОшибке(СообщениеОбОшибке);
		Возврат;
	КонецЕсли;
	
	УстановитьПорядковыйНомерПерехода(СтрокиПереходов[0].ПорядковыйНомерПерехода);
	
КонецПроцедуры

