	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ИмяРеквизитаФормы, , Отказ);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеДлительнойОперации(ИдентификаторЗадания)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОбновитьОбсуждение()
	
	Если НЕ СистемаВзаимодействийПодключена Тогда
		Возврат;
	КонецЕсли;
	
	Участники = Новый Массив;
	
	Для Каждого СтрСписка из ПолучателиУведомлений Цикл
		Если ЗначениеЗаполнено(СтрСписка.Значение) Тогда
			Участники.Добавить(СтрСписка.Значение)
		КонецЕсли;
	КонецЦикла;
	
	РезультатСозданияОбсуждения = Маг1СИнтеграцияСлужебный.СоздатьОбновитьОбсуждение(
		НастройкиВитрины(),
		Участники,
		Истина);
		
	Если РезультатСозданияОбсуждения.Успешно Тогда
		
		ИдентификаторОбсуждения = РезультатСозданияОбсуждения.Ключ;
		УведомленияПодключены = Не ПустаяСтрока(ИдентификаторОбсуждения);
		Если УведомленияПодключены
			И ПустаяСтрока(ИдентификаторСлужебногоПользователяСистемыВзаимодействия) Тогда
			
			ИдентификаторСлужебногоПользователяСистемыВзаимодействия =
				Маг1СИнтеграцияСлужебный.ИдентификаторСлужебногоПользователяСистемыВзаимодействия()	
		КонецЕсли;
		
	Иначе
		
		ШаблонУведомления = НСтр("ru='Пользователь %1 не сможет получать уведомления: пользователь недействителен либо не может войти в информационную базу'");

		Для каждого Ошибка Из РезультатСозданияОбсуждения.Ошибки Цикл
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонУведомления, Ошибка.Пользователь),,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ПолучателиУведомлений[%1].Значение", Ошибка.Индекс));
		КонецЦикла;
				
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРегистрацииПокупателей(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	РегистрацияПокупателей(Неопределено);
КонецПроцедуры

