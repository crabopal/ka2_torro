									+ ".ФормаВыбора";
									
									
	УстановитьВидимостьДекорацийПроблемОбмена();
	
	Элементы.ГруппаПодключениеУведомленийСистемаВзаимодействия.Видимость = Не СистемаВзаимодействийПодключена;
	
	Элементы.БанерEMailДляОтправкиУведомлений.Видимость = СтрокаСпискаВитрин.ОстановленаОтправкаУведомлений;
	Элементы.EMailДляОтправкиУведомленийНастройки.Доступность  = Не СтрокаСпискаВитрин.ОстановленаОтправкаУведомлений;
	
	Элементы.БанерEMailДляОтправкиУведомленийОЗаказах.Видимость = СтрокаСпискаВитрин.ОстановленаОтправкаУведомленийПоЗаказам;
	Элементы.ИспользоватьУведомленияПоПочте.Доступность                 = Не СтрокаСпискаВитрин.ОстановленаОтправкаУведомленийПоЗаказам; 
	
	ПриИзмененииФлажковКонтактнойИнформацииОбработчик(ЭтотОбъект);
	УстановитьДоступностьСуммВНастройкахДоставки(ЭтотОбъект);
	
	УстановитьВидимостьЭлементовДоставки(ЭтотОбъект);
	УстановитьВидимостьСегмента(ЭтотОбъект);
	УстановитьДоступностьРежимаРегистрацииНаВитринеЗначения(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ПроблемыОбмена

&НаСервере
Процедура УстановитьВидимостьДекорацийПроблемОбмена()
	
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		Элементы.ЕстьПроблемыПередачиКартинок.Видимость = Обработки.Маг1СОбмен.ЕстьПроблемаОтправкиКартинки(УзелОбмена);
		
		СостояниеОбменаПоРасписанию = Обработки.Маг1СОбмен.СостояниеОбменаПоРасписанию(УзелОбмена);
		Элементы.НадписьАвтоматическийОбменОтключен.Видимость = ПовторнаяНастройка
																И Не СостояниеОбменаПоРасписанию.ИспользоватьРегламентноеЗадание;
		Элементы.НадписьСинхронизацияНеЗавершается.Видимость  = ПовторнаяНастройка
																И Не СостояниеОбменаПоРасписанию.СинхронизацияЗавершается;
		Элементы.ВыполнитьСинхронизациюСВитриной.Видимость    = ПовторнаяНастройка
																И (Не СостояниеОбменаПоРасписанию.ИспользоватьРегламентноеЗадание
																	ИЛИ Не СостояниеОбменаПоРасписанию.СинхронизацияЗавершается
																	ИЛИ Обработки.Маг1СОбмен.ЕстьПроблемаОтправкиКартинки(УзелОбмена));
		Элементы.СписокПриложений.Видимость                   = Ложь;
		
		Если Элементы.НадписьСинхронизацияНеЗавершается.Видимость Тогда
			Текст = СтроковыеФункции.ФорматированнаяСтрока(
						НСтр("ru = 'Синхронизация с витриной <span style="""">не завершается</span> из-за ошибки начиная с %1. Для получения более подробной информации об ошибке запустите синхронизацию вручную.'"),
						Строка(СостояниеОбменаПоРасписанию.ДатаПервойОшибкиОбмена));
			Элементы.НадписьСинхронизацияНеЗавершается.Заголовок = Текст;
			
			МодульОбменДаннымиПовтИсп = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиПовтИсп");
			МодульОбменДаннымиСервер = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиСервер");
			
			Если МодульОбменДаннымиПовтИсп = Неопределено ИЛИ МодульОбменДаннымиСервер = Неопределено Тогда 
				Возврат;
			КонецЕсли;
			
			ПланыОбменаБСП = МодульОбменДаннымиПовтИсп.ПланыОбменаБСП();
			ТаблицаМонитора = МодульОбменДаннымиСервер.ТаблицаМонитораОбменаДанными(ПланыОбменаБСП);
			СтрокиОбменаТекущегоУзла = ТаблицаМонитора.НайтиСтроки(Новый Структура("УзелИнформационнойБазы", УзелОбмена));
			Если СтрокиОбменаТекущегоУзла.Количество() > 0 Тогда 
				НоваяСтрокаНастроекОбмена = СписокПриложений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаНастроекОбмена, СтрокиОбменаТекущегоУзла[0]);
			КонецЕсли;
			
			Для Каждого СтрокаПриложение Из СписокПриложений Цикл
				
				Если СтрокаПриложение.НастройкаЗавершена Тогда
					СтруктураЗаголовков = АктуализироватьИнформациюОПроблемахСинхронизацииДанных(СтрокаПриложение.УзелИнформационнойБазы);
					СтрокаПриложение.ОтправкаПредупреждения = СтруктураЗаголовков.ЗаголовокПредупрежденийОтправки;
					СтрокаПриложение.ПолучениеПредупреждения = СтруктураЗаголовков.ЗаголовокПредупрежденийПолучении;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаПриложение.ДатаПоследнегоЗапуска) Тогда
					СтрокаПриложение.СостояниеВыгрузкиКартинка = КартинкаРезультатаВыполнения(СтрокаПриложение.РезультатПоследнейВыгрузкиДанных);
					
					Если Не СтрокаПриложение.ПолученоСообщениеДляСопоставленияДанных Тогда
						СтрокаПриложение.СостояниеЗагрузкиКартинка = КартинкаРезультатаВыполнения(СтрокаПриложение.РезультатПоследнейЗагрузкиДанных);
					КонецЕсли;
					
					ЕстьОшибкиВОбмене = СтрокаПриложение.СостояниеВыгрузкиКартинка = 2 ИЛИ СтрокаПриложение.СостояниеВыгрузкиКартинка = 3
										ИЛИ СтрокаПриложение.СостояниеЗагрузкиКартинка = 2 ИЛИ СтрокаПриложение.СостояниеЗагрузкиКартинка = 3;
					
					Если ЕстьОшибкиВОбмене Тогда 
						Элементы.СписокПриложений.Видимость = Истина;
						
						СтрокаСпискаВитрин = Маг1СИнтеграция.СтрокаСпискаВитринПоИдентификаторуВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины);
						СтрокаСпискаВитрин.СообщениеМенеджера = "Обнаружены проблемы в работе витрины: Ошибка синхронизации данных";
						ОбновитьСтрокуСпискаВитрин(ЭтотОбъект, СтрокаСпискаВитрин);
					КонецЕсли;
				Иначе
					
					// Не отображаем надпись "Никогда", если синхронизация еще ни разу не выполнялась,
					// чтобы не перегружать интерфейс.
					СтрокаПриложение.ПредставлениеДатыПоследнейУспешнойВыгрузки = "";
					СтрокаПриложение.ПредставлениеДатыПоследнейУспешнойЗагрузки = "";
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	Иначе
		Элементы.ЕстьПроблемыПередачиКартинок.Видимость       = Ложь;
		Элементы.НадписьАвтоматическийОбменОтключен.Видимость = Ложь;
		Элементы.НадписьСинхронизацияНеЗавершается.Видимость  = Ложь;
		Элементы.СписокПриложений.Видимость                   = Ложь;
		Элементы.ВыполнитьСинхронизациюСВитриной.Видимость    = Ложь;
		
		ОбновитьСтрокуСпискаВитрин(ЭтотОбъект, Маг1СИнтеграция.СтрокаСпискаВитринПоИдентификаторуВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины));
	КонецЕсли;
	
	//ОбновитьСтрокуСпискаВитрин(ЭтотОбъект, Маг1СИнтеграция.СтрокаСпискаВитринПоИдентификаторуВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины));
КонецПроцедуры

&НаСервереБезКонтекста
Функция АктуализироватьИнформациюОПроблемахСинхронизацииДанных(УзелСинхронизации)
	
	УстановитьПривилегированныйРежим(Истина);
	Если Метаданные.РегистрыСведений.Найти("РезультатыОбменаДанными") <> Неопределено Тогда
		Возврат РегистрыСведений["РезультатыОбменаДанными"].КоличествоПредупрежденийДетально(УзелСинхронизации);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция КартинкаРезультатаВыполнения(РезультатВыполнения)
	
	Если РезультатВыполнения = 2 Тогда
		Возврат 3; // выполнено с предупреждениями
	ИначеЕсли РезультатВыполнения = 1 Тогда
		Возврат 2; // ошибка
	ИначеЕсли РезультатВыполнения = 0 Тогда
		Возврат 0; // успешно
	КонецЕсли;
	
	// без статуса
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура СписокПриложенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СписокПриложений.ТекущиеДанные;
	
	Если Поле.Имя = "СписокПриложенийСостояниеВыгрузкиКартинка"
		ИЛИ Поле.Имя = "СписокПриложенийПредставлениеДатыПоследнейУспешнойВыгрузки"
		ИЛИ Поле.Имя = "СписокПриложенийОтправкаПредупреждения"
		Тогда
		
		ОткрытьРезультатыСинхронизации(ТекущиеДанные, "СобытияВыгрузки");
		
	ИначеЕсли Поле.Имя = "СписокПриложенийСостояниеЗагрузкиКартинка"
		ИЛИ Поле.Имя = "СписокПриложенийПредставлениеДатыПоследнейУспешнойЗагрузки"
		ИЛИ Поле.Имя = "СписокПриложенийПолучениеПредупреждения"
		Тогда
		
		ОткрытьРезультатыСинхронизации(ТекущиеДанные, "СобытияЗагрузки");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРезультатыСинхронизации(ДанныеТекущейСтроки = Неопределено, ИмяНабораСобытий = "")
	
	МассивУзловПланаОбмена = Новый Массив;
	Для Каждого СтрокаМонитора Из СписокПриложений Цикл
		
		МассивУзловПланаОбмена.Добавить(СтрокаМонитора.УзелИнформационнойБазы);
		
	КонецЦикла;
	
	ОтборУзловПланаОбмена = Новый Массив;
	Если ДанныеТекущейСтроки <> Неопределено Тогда
		
		ОтборУзловПланаОбмена.Добавить(ДанныеТекущейСтроки.УзелИнформационнойБазы);
		
	КонецЕсли;
	
	ОтборТипыПредупреждений = Новый Массив;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УзлыОбмена", МассивУзловПланаОбмена);
	ПараметрыФормы.Вставить("ОтборУзловОбменов", ОтборУзловПланаОбмена);
	ПараметрыФормы.Вставить("ОтборТипыПредупреждений", ОтборТипыПредупреждений);
	
	ОткрытьФорму("РегистрСведений."+ Маг1СПеречисления.ИменаРегистров_РезультатыОбменаДанными() +".Форма.ПредупрежденияСинхронизаций", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ЛистовкаМагазина

&НаСервере
Функция ПолучитьФайлЛистовкиМагазина()
	
	ИмяФайла = ПолучитьИмяВременногоФайла("pdf");
	
	Листовка = Обработки.Маг1СНастройка.СформироватьПечатнуюФормуЛистовкиМагазина(НастройкиВитрины());
	Листовка.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
	
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), УникальныйИдентификатор);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_МастерСозданияВитрины(),
			УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Возврат АдресФайла;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьЛистовкуМагазинаЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	УдалитьИзВременногоХранилища(ДополнительныеПараметры.АдресФайла);
	
	Если ПолученныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОткрытияФайла = Новый ОписаниеОповещения(
		"ФайлЛистовкиСохраненЗавершение",
		ЭтотОбъект,
		Новый Структура("ПутьКФайлу",  ПолученныеФайлы[0].ПолноеИмя));
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Файл успешно сохранен'"),
		ОповещениеОткрытияФайла,
		ПолученныеФайлы[0].ПолноеИмя,
		БиблиотекаКартинок["Информация32"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлЛистовкиСохраненЗавершение(ДополнительныеПараметры) Экспорт
	
	ФайловаяСистемаКлиент.ОткрытьФайл(ДополнительныеПараметры.ПутьКФайлу);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСПодключениемУведомлений

&НаСервере
Процедура ЗагрузитьУчастниковОбсуждения()
	
	ПолучателиУведомлений.Очистить();
	
	Если Не ПустаяСтрока(ИдентификаторОбсуждения) Тогда

		Участники = Маг1СИнтеграцияСлужебный.УчастникиОбсуждения(ИдентификаторОбсуждения);
		Для каждого Участник Из Участники Цикл
			ПолучателиУведомлений.Добавить().Значение = Участник;
		КонецЦикла;
		
	КонецЕсли;
	
	ИспользоватьУведомленияЧерезСВ = ПолучателиУведомлений.Количество() > 0;
	
КонецПроцедуры

Процедура ИнициализироватьЭлементыПодключенияУведомлений()
	
	МожноПодключатьУведомления = Маг1СИнтеграцияСлужебный.МожноПодключатьУведомления();
	
	Элементы.ГруппаДекорацииПодключениеУведомлений.Видимость = МожноПодключатьУведомления;
	Элементы.ПодключитьУведомления.Видимость = МожноПодключатьУведомления;
	
	Если МожноПодключатьУведомления Тогда
		Элементы.КомандаДалееПодготовкаВитриныРезультат.Заголовок = НСтр("ru = 'Настроить уведомления'");
	КонецЕсли;
	
	МожноПодключитьВебЧат = Маг1СИнтеграцияСлужебный.МожноПодключатьВебЧат();
	Элементы.ГруппаНастроекЧатаНаСайте.Видимость = МожноПодключитьВебЧат;
	Элементы.ГруппаВебЧатНедоступен.Видимость = Не МожноПодключитьВебЧат;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьEMailДляОтправкиУведомленийИНомерСчетчика()
	
	Если ЗначениеЗаполнено(EMailДляОтправкиУведомлений) Тогда
		Если СтрокаСпискаВитрин.ОстановленаОтправкаУведомлений Тогда
			ПредставленияEMail = НСтр("ru='<b>Отправка остановлена</b>  <a href = ""changeEmail"">Подробнее</a>'");
		Иначе
			ШаблонСтроки = НСтр("ru='<b>%1</b>  <a href = ""changeEmail"">Изменить</a>'");
			ПредставленияEMail = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонСтроки,
				EMailДляОтправкиУведомлений);
		КонецЕсли;
	Иначе
		ПредставленияEMail = НСтр("ru='<b>Не установлен</b>  <a href = ""changeEmail"">Установить</a>'");
	КонецЕсли;
	
	Элементы.ПодключениеУведомленийИнформацияEmail.Заголовок = СтроковыеФункцииКлиентСервер.ФорматированнаяСтрока(ПредставленияEMail);
	
	Если ЗначениеЗаполнено(ИдентификаторПриложенияВСервисеСбораСтатистики) Тогда
		ШаблонСтроки = НСтр("ru='<b>%1</b>  <a href = ""change"">Изменить</a>'");
		ПредставленияСчетчика = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки,
			ИдентификаторПриложенияВСервисеСбораСтатистики);
	Иначе
		ПредставленияСчетчика = НСтр("ru='<b>Не установлен</b>  <a href = ""change"">Установить</a>'");
	КонецЕсли;
		
	Если Элементы.ГруппаНастроекЧатаНаСайте.Видимость Тогда 
		Если ЗначениеЗаполнено(WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия) Тогда
			ПредставленияWebChat = НСтр("ru='<a href = ""disconnect"">Отключить</a>'");
			Элементы.ИнтеграцияВебЧатаИзменение.Видимость = Истина;
			Элементы.ИнтеграцияВебЧатаИзменение.МаксимальнаяШирина = СтрДлина(WebChat_Представление)/100*80;
		Иначе
			ПредставленияWebChat = НСтр("ru='<b>Не подключено</b> <a href = ""create"">Создать настройку</a>'");
			Элементы.ИнтеграцияВебЧатаИзменение.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.ПубликацияВебЧатаИнформация.Заголовок = СтроковыеФункцииКлиентСервер.ФорматированнаяСтрока(ПредставленияWebChat);
	КонецЕсли;
	
КонецПроцедуры

