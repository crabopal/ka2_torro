&НаКлиенте
Процедура ДлительнаяОперацияОбновитьНастройкиВитриныПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
		
	СтрокаСпискаВитрин       = РезультатыВыполнения.СтрокаСпискаВитрин;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтрокаСпискаВитрин);
	
	Если РезультатыВыполнения.Отказ Тогда
		ПоказатьОшибку(РезультатыВыполнения.ПараметрыСобытия, Ложь, РезультатыВыполнения.СообщениеОбОшибке);
	Иначе
		ЗарегистрированноеИмяВитрины = ИмяВитрины;
		ЗарегистрированныйДоменПользователя = ДоменПользователя;
		ЗарегистрированныйТипСертификатаДоменаПользователя = ТипСертификатаДоменаПользователя;
		
		Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
			Закрыть(Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки());	
		Иначе	
			Если Не ПовторнаяНастройка Тогда
				ИзменитьПорядковыйНомерПерехода(1);
			Иначе
				ВыполнитьПереходКСтранице("СтраницаЗавершение");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеАдресаЭлектроннойПочтыДляУведомлений

