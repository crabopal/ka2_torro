&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСпособФормированияСчетаНаОплату(Форма)

	Элементы = Форма.Элементы;
	
	Элементы.СпособФормированияСчетаНаОплатуГруппа.Видимость = ЕстьОплатаПереводомНаСчет(Форма);
																
	Элементы.СпособФормированияСчетаНаОплатуАвтоматическиНаВитринеГруппаРеквизиты.Видимость = Элементы.СпособФормированияСчетаНаОплатуГруппа.Видимость
										И (Форма.СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_АвтоматическиНаВитрине()
										 	Или Форма.ОплатаПоСсылкеПереводомНаСчет); 
										
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьОплатаПереводомНаСчет(Форма)
	Возврат (Форма.ИспользоватьДоставкаКурьерскаяДоставка
				И Форма.ОплатаПриКурьерскойДоставкеПереводомНаСчет)
			Или (Форма.ИспользоватьДоставкаСамовывоз
				И Форма.ОплатаПриСамовывозеПереводомНаСчет)
			Или (Форма.ИспользоватьДоставкаТранспортнаяКомпания
				И Форма.ОплатаПриДоставкеТранспортнойКомпаниейПереводомНаСчет)
			Или Форма.ОплатаПоСсылкеПереводомНаСчет;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьОплатаСБП(Форма)
	Возврат (Форма.ИспользоватьДоставкаТранспортнаяКомпания
				И Форма.ОплатаПриДоставкеТранспортнойКомпаниейСБП)
			Или (Форма.ИспользоватьДоставкаСамовывоз
				И Форма.ОплатаПриСамовывозеСБП)
			Или(Форма.ИспользоватьДоставкаКурьерскаяДоставка
			 	И Форма.ОплатаПриКурьерскойДоставкеСБП)
			Или Форма.ОплатаПоСсылкеЧерезСБП;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСегмента(Форма)
	Форма.Элементы.СегментНоменклатуры.Видимость = Форма.ОтборПоСегменту;
КонецПроцедуры

&НаКлиенте
Процедура РежимВитриныПриИзменении(Элемент)
	
	УстановитьДоступностьРежимаРегистрацииНаВитринеЗначения(ЭтотОбъект);
	
	Если РежимВитрины = Маг1СПеречисления.РежимыВитрины_Открытый() Тогда
		ТекстРасширеннойПодсказки = "Любой человек, который откроет витрину, сможет просматривать каталог, регистрироваться на витрине с подтверждением номера телефона по смс и оформлять заказ."
	ИначеЕсли РежимВитрины = Маг1СПеречисления.РежимыВитрины_Закрытый() Тогда
		ТекстРасширеннойПодсказки = "Для просмотра каталога товаров, покупателю нужно сначала зарегистрироваться на витрине. Это смогут сделать только те покупатели, которым вы передадите персональную ссылку (инвайт)."
	ИначеЕсли РежимВитрины = Маг1СПеречисления.РежимыВитрины_Ограниченный() Тогда
		ТекстРасширеннойПодсказки = "На витрине будет размещена информация о товарах, рекламирование и распространение которых ограничено действующим законодательством. Вы обязуетесь не предоставлять доступ к каталогу физлицам-конечным потребителям – только партнерам по бизнесу (b2b) по инвайту."
	КонецЕсли;
	Элемент.РасширеннаяПодсказка.Заголовок = ТекстРасширеннойПодсказки;
	
	Если РежимВитрины <> Маг1СПеречисления.РежимыВитрины_Открытый() Тогда
		РежимРегистрацииПокупателей = Маг1СПеречисления.РежимыРегистрацииПокупателей_ТолькоПоИнвайтам();
		РежимРегистрацииПокупателейПриИзменении(Элементы.РежимРегистрацииПокупателей);
	КонецЕсли;
	
	ЭтотОбъект.ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимРегистрацииПокупателейПриИзменении(Элемент)
	Если РежимРегистрацииПокупателей = Маг1СПеречисления.РежимыРегистрацииПокупателей_ПоИнвайтамИБезИнвайтов() Тогда 
		ТекстРасширеннойПодсказки = "Покупатель может открыть витрину и зарегистрироваться на ней, просто указав фамилию, имя и подтвердив с помощью СМС номер телефона.
									|Существующим в справочнике контрагентов покупателям рекомендуется выдавать ссылку для регистрации на витрине, т.к. при регистрации без ссылки (инвайта) в базе будет создан новый контргагент.";
	ИначеЕсли РежимРегистрацииПокупателей = Маг1СПеречисления.РежимыРегистрацииПокупателей_ТолькоПоИнвайтам() Тогда 
		ТекстРасширеннойПодсказки = "Зарегистрироваться на витрине можно будеть только по специальной индивидуальной ссылке (инвайту), которую вы должны будете передать каждому покупателю.";
	КонецЕсли;
	Элемент.РасширеннаяПодсказка.Заголовок = ТекстРасширеннойПодсказки;
	
	ЭтотОбъект.ОбновитьОтображениеДанных();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРежимаРегистрацииНаВитринеЗначения(Форма)
	
	Форма.Элементы.РежимРегистрацииПокупателей.Доступность = 
		Форма.РежимВитрины = Маг1СПеречисления.РежимыВитрины_Открытый();
	
КонецПроцедуры

