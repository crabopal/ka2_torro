	Если Не ПустаяСтрока(НезаполненныеРеквизитыОрганизации) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните обязательные реквизиты Организации.'"), "Организация", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресМагазина) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите местоположение магазина.'"), "АдресМагазина", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТелефонМагазина1) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Укажите телефон магазина.'"), "ТелефонМагазина1", Отказ);
	КонецЕсли;
	
	Если Не Отказ Тогда
		СохранитьСостояниеМастера();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

