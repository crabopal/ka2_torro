&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	Тема = "";
	Текст = "";
	Вложение = Неопределено;
	
	Если Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаПриветствие Тогда
		Тема  = НСтр("ru = 'Использование mag1c. Запуск мастера настройки'");
		Текст = НСтр("ru = 'При запуске мастера настройки mag1c возникла следующая проблема'");		
	ИначеЕсли Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаОшибки Тогда
		Тема  = НСтр("ru = 'Использование mag1c. Ошибка при обращении к менеджеру витрин'");
		Текст = НСтр("ru = 'При запуске мастера настройки mag1c возникла ошибка'")
				+ Символы.ВК
				+ Элементы.ДекорацияТекстОшибки.Заголовок;
		Если Элемент <> Элементы.НадписьОбращениеВТехническуюПоддержку Тогда
			Вложение = Новый Структура;
			Вложение.Вставить("Представление", "ВыгрузкаИзЖурналаРегистрации.txt");
			Вложение.Вставить("Адрес", 
				Маг1СИнтеграцияСлужебныйВызовСервера.ВыгрузитьСообщенияОбОшибкахИзЖР(ПараметрыСобытия,
																					  ЭтотОбъект.УникальныйИдентификатор));
			Вложение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);
		КонецЕсли;			
	ИначеЕсли Элементы.ПанельКомпоновки.ТекущаяСтраница = Элементы.СтраницаВитринаВАрхиве Тогда
		Тема  = НСтр("ru = 'Использование mag1c. Восстановление витрины из архива'");
		Текст = НСтр("ru = 'Просьба восстановить витрину из архива'");		
	Иначе
		Если Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаНазваниеВитрины Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Название веб-витрины'");
			Текст = НСтр("ru = 'При указании названия веб-витрины возникла следующая проблема'"); 
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаОписаниеВитрины Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Описание веб-витрины'");
			Текст = НСтр("ru = 'При вводе описания витрины возникла следующая проблема'"); 
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаНастройкаВитрины Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Сведения о магазине'");
			Текст = НСтр("ru = 'При внесении сведений о магазине для веб-витрины возникла следующая проблема'");
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаДопНастройкаВитрины Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Дополнительные сведения о магазине'");
			Текст = НСтр("ru = 'При внесении доп. сведений о магазине для веб-витрины возникла следующая проблема'");
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаНастройкаДоставки Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Создание веб-витрины''");
			Текст = НСтр("ru = 'При настройке способов доставки при настройке веб-витрины возникла следующая проблема'"); 
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаПодготовкаВитриныОжидание Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Создание веб-витрины'");
			Текст = НСтр("ru = 'Мастер настройки запустил процесс создания веб-витрины. При этом возникла следующая проблема'"); 
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаПодготовкаВитриныРезультат Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Создание веб-витрины'");
			Текст = НСтр("ru = 'Мастер завершил создание веб-витрины. При этом возникла следующая проблема'"); 
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаНастройкаВыгрузки
			Или  Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаПравилаОтображения
			Или Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаПроверкаПараметровВыгрузки Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Настройка каталога'");
			Текст = НСтр("ru = 'При настройке списка товаров, которые будут выгружаться в веб-витрину, возникла следующая проблема'");
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаВыгрузкаДанныхОжидание Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Настройка каталога'");
			Текст = НСтр("ru = 'В процессе выгрузки товаров в веб-витрину возникла следующая проблема'"); 
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаЗавершение Тогда
			Если Элементы.ПанельДействияСВитриной.ТекущаяСтраница = Элементы.СтраницаНачальнаяНастройка Тогда		
				Тема  = НСтр("ru = 'Подключение к mag1c. Завершение'");
				Текст = НСтр("ru = 'После создания веб-витрины и выгрузки товаров возникла следующая проблема'"); 
			Иначе
				Тема  = НСтр("ru = 'Использование веб-витрины mag1c'");
				Текст = НСтр("ru = 'В процессе использования веб-витрины mag1c возникла следующая проблема'"); 
			КонецЕсли;			
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаПодключениеУведомлений Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Подключение уведомлений'");
			Текст = НСтр("ru = 'В процессе настройки уведомлений возникла следующая проблема'");
		ИначеЕсли Элементы.ПанельОсновная.ТекущаяСтраница = Элементы.СтраницаСоответствиеСтатусовЗаказов Тогда
			Тема  = НСтр("ru = 'Подключение к mag1c. Статусы заказов'");
			Текст = НСтр("ru = 'При настройке соответсвий статусов заказов возникла следующая проблема");
		КонецЕсли;
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(ИдентификаторВитрины,
																	ИмяВитрины,
																	ЛогинИПП,
																	Тема,
																	Текст,
																	Вложение);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибка2ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаЮКассаПриИзменении(Элемент)
	ПараметрыЮКасса =  ЮКассаПодключена(Организация);
	
	Если ЭтотОбъект[Элемент.Имя] Тогда
		Если Не ПараметрыЮКасса.Подключена Тогда
			 ЭтотОбъект[Элемент.Имя] = Ложь;

			 ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">Для включения этого варианта оплаты, необходимо, чтобы по организации %1 была настройка интеграции с ЮKassa с вариантом использования сервиса ""С договором"".</span>'"), Строка(Организация));
						
			 КнопкиВопроса = Новый СписокЗначений();
			 КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК,
			 						СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Перейти к настройкам</span>'")));
			 КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена,
			 						СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Отмена</span>'")));
						
			 ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуНастройкиЮКассы", ЭтотОбъект);
			 
			 ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, КнопкиВопроса,,КодВозвратаДиалога.ОК); 
		Иначе
			Если Маг1СИнтеграцияСлужебныйКлиентСервер.НетТокенаДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, Маг1СПеречисления.ПлатежныеСистемы_u_kassa()) Тогда
				// Нужно перевыгрузить товары, т.к. ранее на витрине не загружалась ставка НДС
				ВыгружатьВсеТовары = Истина; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НастроитьДекорацииЮКассаТестовыйМагазин(ЭтотОбъект, ПараметрыЮКасса.ЭтоТестовыйМагазинЮКасса);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиЮКассы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыНастройки = НастройкиУчетнойСистемы.ИмяФормыНастройкиЮКасса;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Раздел", НастройкиУчетнойСистемы.РазделФормыНастройкиЮКасса);

	ОткрытьФорму(ИмяФормыНастройки,
					ПараметрыФормы,
					,
					ИмяФормыНастройки + "." + ПараметрыФормы.Раздел);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЮКассаПодключена(Организация)
	Возврат Маг1СИнтеграцияСлужебный.ЮКассаПодключена(Организация);
КонецФункции

&НаКлиенте
Процедура ОплатаСБППриИзменении(Элемент)
	
	ЕстьНастройки = ПриИзмененииФлажковОплатаСБП(ЭтотОбъект);
	
	Если ЭтотОбъект[Элемент.Имя] Тогда
		Если Не ЕстьНастройки Тогда
			ЭтотОбъект[Элемент.Имя] = Ложь;
			
			УстановитьВидимостьНастройкаСБП(ЭтотОбъект);
			
			ТекстВопроса = 
			СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Для включения этого варианта оплаты, необходимо, чтобы по организации %1 была настройка интеграции с СБП.</span>'"), 
				Строка(Организация)
			);
			
			КнопкиВопроса = Новый СписокЗначений();
			КнопкиВопроса.Добавить(
				КодВозвратаДиалога.ОК,
				СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Перейти к настройкам</span>'"))
			);
			КнопкиВопроса.Добавить(
				КодВозвратаДиалога.Отмена,
				СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Отмена</span>'"))
			);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуНастройкиСБП", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, КнопкиВопроса,,КодВозвратаДиалога.ОК); 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиСБП(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыНастройки = НастройкиУчетнойСистемы.ИмяФормыНастройкиСБП;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Раздел", НастройкиУчетнойСистемы.РазделФормыНастройкиСБП);

	ОткрытьФорму(ИмяФормыНастройки,
					ПараметрыФормы,
					,
					ИмяФормыНастройки + "." + ПараметрыФормы.Раздел);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСБППриИзменении(Элемент)
	ОчиститьСообщения();
	Если ЗначениеЗаполнено(НастройкаСБП) Тогда
		ПриИзмененииФлажковОплатаСБП(ЭтотОбъект);
		
		Если Не ЗначениеЗаполнено(НастройкаСБП) Тогда
			ТекстСообщения = НСтр("ru = 'Витрина настроена для работы от имени организации %Организация%. Выбранная настройка не может быть использована для работы с этой организацией. Выберите другую настройку.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Организация);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"НастройкаСБП");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИерархияПоПриИзменении(Элемент)
	ВыгружатьВсеТовары = Истина;
	ЗаполнитьКаталогНоменклатуры();
КонецПроцедуры

&НаКлиенте
Процедура РасчетаСтоимостиПриИзменении(Элемент)
	УстановитьДоступностьСуммВНастройкахДоставки(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СпособФормированияСчетаНаОплатуПриИзменении(Элемент)
	УстановитьВидимостьСпособФормированияСчетаНаОплату(ЭтотОбъект);
	
	Если СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_Вручную() Тогда
		ТекстРасширеннойПодсказки = "При оформлении заказа покупатель укажет адрес электронной почты. После обработки заказа менеджер сформирует счет на оплату и вышлет на указанный адрес."
	ИначеЕсли СпособФормированияСчетаНаОплату = Маг1СПеречисления.СпособыФормированияСчетаНаОплату_АвтоматическиНаВитрине() Тогда
		ТекстРасширеннойПодсказки = "После оформления заказа покупатель может скачать счет на оплату прямо с сайта веб-витрины."
	КонецЕсли;
	Элемент.РасширеннаяПодсказка.Заголовок = ТекстРасширеннойПодсказки;
КонецПроцедуры

