&НаСервере
Процедура ЗаполнитьТаблицуПереходовПоСценарию()
	
	ОпределитьВидимостьДекорацийШаговМастера();
	
	ТаблицаПереходов.Очистить();
	
	НовыйПереход = НоваяСтрокаТаблицыПереходов("СтраницаПриветствиеПустая", "СтраницаНавигацияНачало");
	НовыйПереход.ИмяОбработчикаПриОткрытии = "СтраницаПриветствиеПустая_ПриОткрытии";
	НовыйПереход.ИмяОбработчикаПриПереходеДалее = "СтраницаПриветствиеПустая_ПриПереходеДалее";
	
	Если Маг1СИнтеграцияПереопределяемый.ДоступенПереносНастроек() Тогда 
		НовыйПереход = НоваяСтрокаТаблицыПереходов("СтраницаВыборТипПерехода", "СтраницаНавигацияПеренос");
		НовыйПереход.ИмяОбработчикаПриОткрытии = "СтраницаВыборТипПерехода_ПриОткрытии";
		НовыйПереход.ИмяОбработчикаПриПереходеДалее = "СтраницаВыборТипПерехода_ПриПереходеДалее";
		
		НовыйПереход = НоваяСтрокаТаблицыПереходов("СтраницаПодготовкаПереносаВитриныОжидание", "СтраницаНавигацияОжиданиеПереносаВитрины");
		НовыйПереход.ИмяОбработчикаПриОткрытии = "СтраницаПодготовкаПереносаВитриныОжидание_ПриОткрытии";
		НовыйПереход.ДлительнаяОперация = Истина;
		НовыйПереход.ИмяОбработчикаДлительнойОперации = "СтраницаПодготовкаПереносаВитриныОжидание_ДлительнаяОперация";
	КонецЕсли;
	
	НовыйПереход = НоваяСтрокаТаблицыПереходов("СтраницаНазваниеВитрины", "СтраницаНавигацияНазваниеВитрины");
	НовыйПереход.ИмяОбработчикаПриОткрытии = "СтраницаНазваниеВитрины_ПриОткрытии";
	НовыйПереход.ИмяОбработчикаПриПереходеДалее = "СтраницаНазваниеВитрины_ПриПереходеДалее";
	НовыйПереход.ИмяШага = "НазваниеВитрины";
	
	Если РежимПереноса <> Маг1СПеречисления.РежимПереносаЭкспресс() Тогда 
		
		НовыйПереход = НоваяСтрокаТаблицыПереходов("СтраницаОписаниеВитрины", "СтраницаНавигацияОписаниеВитрины");
		НовыйПереход.ИмяОбработчикаПриОткрытии = "СтраницаОписаниеВитрины_ПриОткрытии";
		НовыйПереход.ИмяОбработчикаПриПереходеДалее = "СтраницаОписаниеВитрины_ПриПереходеДалее";
		НовыйПереход.ИмяШага = "ОписаниеВитрины";
		
