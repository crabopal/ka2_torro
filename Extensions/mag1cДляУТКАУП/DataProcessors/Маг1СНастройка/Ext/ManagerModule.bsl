	Описание["store"].Вставить("display_stock", ОсновныеНастройки.ВыгружатьИнформативныеОстатки);
	Описание["store"].Вставить("decimal_length", ОсновныеНастройки.ДлинаДесятичнойЧастиКоличестваВЗаказе);
	Описание["store"].Вставить("display_images", ОсновныеНастройки.ВыгружатьКартинки);
	Описание["store"].Вставить("showed_code_property", ОсновныеНастройки.ОтображаемоеПолеКодаНоменклатуры);
	
	// Склад
	Описание.Вставить("warehouse", Новый Структура);
	Если ЗначениеЗаполнено(ОсновныеНастройки.ПараметрыУчета.Склад) Тогда
		Описание["warehouse"].Вставить("id",   Строка(ОсновныеНастройки.ПараметрыУчета.Склад.УникальныйИдентификатор()));
		Описание["warehouse"].Вставить("name", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновныеНастройки.ПараметрыУчета.Склад, "Наименование"));
	Иначе
		Описание["warehouse"].Вставить("id",   "");
		Описание["warehouse"].Вставить("name", "");
	КонецЕсли;
	
	// Вид цен
	Описание.Вставить("price_list", Новый Структура);
	
	Если ЗначениеЗаполнено(ОсновныеНастройки.ПараметрыУчета.ВидЦен) Тогда
		Описание["price_list"].Вставить("id", Строка(ОсновныеНастройки.ПараметрыУчета.ВидЦен.УникальныйИдентификатор()));
	Иначе
		Описание["price_list"].Вставить("id", "");
	КонецЕсли;
	
	// Банковский счет
	Описание.Вставить("bank_account", Новый Структура);
	Если ЗначениеЗаполнено(ОсновныеНастройки.БанковскийСчет) Тогда
		Описание["bank_account"].Вставить("id", Строка(ОсновныеНастройки.БанковскийСчет.УникальныйИдентификатор()));
	Иначе
		Описание["bank_account"].Вставить("id", "");
