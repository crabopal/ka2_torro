Функция ЭтоТестовыйМагазинЮКасса(ИдМагазина) Экспорт
	
	Если ИдМагазина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Маг1СИнтеграцияСлужебный.ПрочитатьПризнакЭтоТестовыйМагазинЮКасса(ИдМагазина);
	                       
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Попытка
		
		ПараметрыАвторизации = ПараметрыАвторизацииЮКассы();	
		
		АдресРесурса = "/shops/%ИдМагазина%/info";
		АдресРесурса = СтрЗаменить(АдресРесурса, "%ИдМагазина%", Формат(ИдМагазина,"ЧГ="));
		Метод        = Маг1СПеречисления.МетодыHTTP_GET();
		
		Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	    Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод,,1);
		
		Если Ответ.КодСостояния = 200 Тогда
			Инфо = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
			
			Если Инфо.Получить("test") <> Неопределено Тогда
				Результат = Инфо.Получить("test");
			КонецЕсли;
			
			Маг1СИнтеграцияСлужебный.СохранитьПризнакЭтоТестовыйМагазинЮКасса(ИдМагазина, Результат);

		Иначе
			ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
			    ПараметрыАвторизации,
				Запрос,
				Метод,
				Ответ);
		КонецЕсли;
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеНастроекВитрины(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыАвторизацииЮКассы()
	
	СтруктураURI = Маг1СИнтеграцияСлужебный.СтруктураURI(Маг1СИнтеграцияСлужебный.ХостСервисаИнтеграцииСЮКасса() + АдресКомандЮКасса());	
	ПараметрыАвторизации = ПараметрыАвторизацииОбщие(СтруктураURI);
	
	ТикетАутентификации = ИнтернетПоддержкаПользователей.ТикетАутентификацииНаПорталеПоддержки(
			ИдентификаторСервисаМенеджераВитрин());
			
	Если ПустаяСтрока(ТикетАутентификации.КодОшибки) Тогда
		ПараметрыАвторизации.ТокенАвторизации.ТипТокена           = "Bearer";
		ПараметрыАвторизации.ТокенАвторизации.ИдентификаторТокена = ТикетАутентификации.Тикет;
	ИначеЕсли ОбщегоНазначения.РазделениеВключено() Тогда
		ВызватьИсключение ТикетАутентификации.ИнформацияОбОшибке;
	Иначе
		ДанныеАутентификации = ИнтернетПоддержкаПользователей.ДанныеАутентификацииПользователяИнтернетПоддержки();
		
		ПараметрыАвторизации.ТокенАвторизации.ТипТокена           = "Basic";
		ПараметрыАвторизации.ТокенАвторизации.ИдентификаторТокена = 
			Маг1СИнтеграцияСлужебный.СтрокаBase64БезBOM(ДанныеАутентификации.Логин + ":" + ДанныеАутентификации.Пароль);
	КонецЕсли;
	
	Возврат ПараметрыАвторизации;
КонецФункции

Функция АдресКомандЮКасса()
	возврат "/public/api/rest/program1c/v2";
