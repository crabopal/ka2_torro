	Описание["store"].Вставить("sbp_use_for_temp_links", ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП);
	Описание["store"].Вставить("invoice_use_for_temp_links", ОсновныеНастройки.ОплатаПоСсылкеПереводомНаСчет);
	
	ЕстьОплатаЧерезЮКассу = ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу;
	ЕстьОплатаЧерезСБП    = ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП;
	
	Если Самовывоз.Использование Тогда
		Описание["store"].Вставить("working_hours", Самовывоз.РежимРаботы);
