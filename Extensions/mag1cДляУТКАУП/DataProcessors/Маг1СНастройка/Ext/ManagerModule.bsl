			ПунктВыдачи.Вставить("address",       ОсновныеНастройки.АдресМагазина);
			ПунктВыдачи.Вставить("telephone",     ОсновныеНастройки.ТелефонМагазина1);
			ПунктВыдачи.Вставить("working_hours", Самовывоз.РежимРаботы);
			
			Описание["locations"].Добавить(ПунктВыдачи);
		КонецЕсли;
		
		УсловияДоставки = СтруктураОписанияУсловийДоставки();
		УсловияДоставки.delivery_type = "self-delivery";
		УсловияДоставки.payment_types = ОписаниеНастроекОплаты(Самовывоз.ВариантыОплаты);
		УсловияДоставки.delivery_terms = Самовывоз.УсловияДоставки;
		УсловияДоставки.cost_calculation_method = Самовывоз.ВариантРасчетаСтоимости;
		УсловияДоставки.delivery_cost = Самовывоз.Стоимость;
		УсловияДоставки.minimum_order_amount = Самовывоз.МинимальнаяСуммаЗаказа;
		УсловияДоставки.display_desired_date = Самовывоз.ОтображатьЖелаемуюДату;
		
		Описание["delivery"].Добавить(УсловияДоставки);
		
		Если УсловияДоставки.payment_types.Найти(Маг1СПеречисления.ПлатежныеСистемы_u_kassa()) <> Неопределено Тогда
			ЕстьОплатаЧерезЮКассу = Истина;
		КонецЕсли;
		Если УсловияДоставки.payment_types.Найти(Маг1СПеречисления.ПлатежныеСистемы_sbp()) <> Неопределено Тогда
			ЕстьОплатаЧерезСБП = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если КурьерскаяДоставка.Использование Тогда
		УсловияДоставки = СтруктураОписанияУсловийДоставки();
		УсловияДоставки.delivery_type = "courier-delivery";
		УсловияДоставки.payment_types = ОписаниеНастроекОплаты(КурьерскаяДоставка.ВариантыОплаты);
		УсловияДоставки.delivery_terms = КурьерскаяДоставка.УсловияДоставки;
		УсловияДоставки.cost_calculation_method = КурьерскаяДоставка.ВариантРасчетаСтоимости;
		УсловияДоставки.delivery_cost = КурьерскаяДоставка.Стоимость;
		УсловияДоставки.minimum_order_amount = КурьерскаяДоставка.МинимальнаяСуммаЗаказа;
		УсловияДоставки.display_desired_date = КурьерскаяДоставка.ОтображатьЖелаемуюДату;
		
		Описание["delivery"].Добавить(УсловияДоставки);
		
		Если УсловияДоставки.payment_types.Найти(Маг1СПеречисления.ПлатежныеСистемы_u_kassa()) <> Неопределено Тогда
			ЕстьОплатаЧерезЮКассу = Истина;
		КонецЕсли;
		Если УсловияДоставки.payment_types.Найти(Маг1СПеречисления.ПлатежныеСистемы_sbp()) <> Неопределено Тогда
			ЕстьОплатаЧерезСБП = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ТранспортнаяКомпания.Использование Тогда
		УсловияДоставки = СтруктураОписанияУсловийДоставки();
		УсловияДоставки.delivery_type = "shipping-company";
		УсловияДоставки.payment_types = ОписаниеНастроекОплаты(ТранспортнаяКомпания.ВариантыОплаты);
		УсловияДоставки.delivery_terms = ТранспортнаяКомпания.УсловияДоставки;
		УсловияДоставки.cost_calculation_method = ТранспортнаяКомпания.ВариантРасчетаСтоимости;
		УсловияДоставки.delivery_cost = ТранспортнаяКомпания.Стоимость;
		УсловияДоставки.minimum_order_amount = ТранспортнаяКомпания.МинимальнаяСуммаЗаказа;
		УсловияДоставки.display_desired_date = ТранспортнаяКомпания.ОтображатьЖелаемуюДату;
		
		Описание["delivery"].Добавить(УсловияДоставки);
		
		Если УсловияДоставки.payment_types.Найти(Маг1СПеречисления.ПлатежныеСистемы_u_kassa()) <> Неопределено Тогда
			ЕстьОплатаЧерезЮКассу = Истина;
		КонецЕсли;
		Если УсловияДоставки.payment_types.Найти(Маг1СПеречисления.ПлатежныеСистемы_sbp()) <> Неопределено Тогда
			ЕстьОплатаЧерезСБП = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьОплатаЧерезЮКассу Тогда
		НастройкиЮКассы = Маг1СИнтеграцияСлужебный.НастройкиЮКассы(ОсновныеНастройки.ПараметрыУчета.Организация);
		Описание["store"].Вставить("u_kassa_shop_id", НастройкиЮКассы.ИдентификаторМагазина);
		Описание["store"].Вставить("u_kassa_sending_receipt", НастройкиЮКассы.ОтправкаЧековЧерезСервис);
		Если НастройкиЮКассы.ИдентификаторМагазина <> 0 Тогда
			Описание["store"].Вставить("u_kassa_it_is_test_shop", ЭтоТестовыйМагазинЮКасса(НастройкиЮКассы.ИдентификаторМагазина));
		Иначе
			Описание["store"].Вставить("u_kassa_it_is_test_shop", Ложь);
		КонецЕсли;
	Иначе
		Описание["store"].Вставить("u_kassa_shop_id", 0);
		Описание["store"].Вставить("u_kassa_sending_receipt", Ложь);
		Описание["store"].Вставить("u_kassa_it_is_test_shop", Ложь);
	КонецЕсли;
	
	Если ЕстьОплатаЧерезСБП Тогда
		Описание["store"].Вставить("sbp_setting_id", Строка(ОсновныеНастройки.НастройкаСБП.УникальныйИдентификатор()));
		
		ПараметрыИнтеграции = Маг1СИнтеграция.ПараметрыИнтеграцииСБП(ОсновныеНастройки.НастройкаСБП);
		ДанныеАутентификацииСБП = ПараметрыАутентификацииСБПДляЗапросаТокена(ОсновныеНастройки.НастройкаСБП);
		Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
		Хеширование.Добавить(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ДанныеАутентификацииСБП));
		ХешДанныхАутентификации = Base64Строка(Хеширование.ХешСумма);
		
		Описание["store"].Вставить("sbp_merchant_id", ПараметрыИнтеграции.ИдентификаторМерчанта);
		Описание["store"].Вставить("islMemberId", ПараметрыИнтеграции.ИдентификаторУчастника);
		Описание["store"].Вставить("sbp_auth_hash", ХешДанныхАутентификации);
	Иначе
		Описание["store"].Вставить("sbp_setting_id", "");
		Описание["store"].Вставить("sbp_merchant_id", "");
		Описание["store"].Вставить("islMemberId", "");
		Описание["store"].Вставить("sbp_auth_hash", "");
	КонецЕсли;
	
	Описание["store"].Вставить("maps_html", ОсновныеНастройки.HtmlЯндексКарта);
	
	Описание.Вставить("creating_invoice_method", ОсновныеНастройки.СпособФормированияСчетаНаОплату);
	Описание.Вставить("invoice_disclaimer", ОсновныеНастройки.ТекстУсловийВСчетеНаОплату);
	
	// Обмен данными
	ИмяПланаОбмена = НастройкиУчетнойСистемы.ИмяПланаОбмена;
	Описание.Вставить("data_exchange", Новый Структура);
	Описание["data_exchange"].Вставить("exchange_plan", ИмяПланаОбмена);
	
	Описание["data_exchange"].Вставить("from", Строка(ОсновныеНастройки.ИдентификаторВитрины));
	Описание["data_exchange"].Вставить("to",  Обработки.Маг1СОбмен.ИдентификаторЭтогоУзла(ОсновныеНастройки.УзелОбмена,
																						  НастройкиУчетнойСистемы.ИмяПланаОбмена));
	
	Описание["data_exchange"].Вставить("login", СистемныеНастройки.ИмяСлужебногоПользователя);
	Описание["data_exchange"].Вставить("password", СистемныеНастройки.ПарольСлужебногоПользователя);
	Описание["data_exchange"].Вставить("url", СистемныеНастройки.АдресПубликацииИБ);
	Описание["data_exchange"].Вставить("is_cloud_app", ОбщегоНазначения.РазделениеВключено());
	
	// Сведения о конфигурации
	ОписаниеКонфигурации = ОписаниеКонфигурации();
	
	Описание.Вставить("user_agent", Новый Структура);
	Описание["user_agent"].Вставить("configuration_name",    ОписаниеКонфигурации.ИмяКонфигурации);
	Описание["user_agent"].Вставить("configuration_version", ОписаниеКонфигурации.ВерсияКонфигурации);
	Описание["user_agent"].Вставить("wizard_version",        ОписаниеКонфигурации.ВерсияРасширения);
	Описание["user_agent"].Вставить("infobase_id",           ОписаниеКонфигурации.ИдентификаторИБ);
	Описание["user_agent"].Вставить("timezone",              ОписаниеКонфигурации.ЧасовойПоясСеанса);
	
	// Настройки уведомлений
	Описание.Вставить("notifications", Новый Структура);
	Описание["notifications"].Вставить("email", НастройкиУведомлений.EMailДляОтправкиУведомлений);
	Описание["notifications"].Вставить("chat_key", НастройкиУведомлений.ИдентификаторОбсуждения);
	Описание["notifications"].Вставить("service_user_id", НастройкиУведомлений.ИдентификаторСлужебногоПользователяСистемыВзаимодействия);
	Описание["notifications"].Вставить("email_for_orders", НастройкиУведомлений.EMailДляОтправкиУведомленийОЗаказах);
	
	Описание.Вставить("IsTestApp", ОсновныеНастройки.ЭтоТестоваяВитрина);
	
	Описание.Вставить("TransferSource", ОсновныеНастройки.ИсточникПереноса);
		
	Описание.Вставить("WebChat", Новый Структура);
	Описание["WebChat"].Вставить("IntegrationID", ОсновныеНастройки.WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия);
	Описание["WebChat"].Вставить("NavigationLinkConnectionPoints", ОсновныеНастройки.WebChat_НавигационнаяСсылкаТочкиПодключения);
	Описание["WebChat"].Вставить("SignKey", ОсновныеНастройки.WebChat_SignKey);
	Описание["WebChat"].Вставить("Description", ОсновныеНастройки.WebChat_Представление);
	
	Описание.Вставить("GoodsBadges", Новый Массив);
	
	Для Каждого ОписаниеЗначка из ОсновныеНастройки.ЗначкиНоменклатуры Цикл
		Если ЗначениеЗаполнено(ОписаниеЗначка.Значок) Тогда 
			Описание["GoodsBadges"].Добавить(Новый Структура("Badge, DisplayOnHomePage",
												Строка(ОписаниеЗначка.Значок.УникальныйИдентификатор()),
												ОписаниеЗначка.ОтображатьНаНачальнойСтранице));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(Описание);
	
КонецФункции

Процедура НастройкиВитриныВСервисе(ПолученныеНастройки, ТекущиеНастройки, СистемныеНастройки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Самовывоз             = ТекущиеНастройки.НастройкиДоставки.Самовывоз;
	КурьерскаяДоставка    = ТекущиеНастройки.НастройкиДоставки.КурьерскаяДоставка;
	ТранспортнаяКомпания  = ТекущиеНастройки.НастройкиДоставки.ТранспортнаяКомпания;
	
	// Магазин
	СвойстваМагазина = ПолученныеНастройки["store"];
	
	// Свойства магазина
	ТекущиеНастройки.ИмяВитрины              = СвойстваМагазина["alias"];
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.11") >= 0  Тогда
		ТекущиеНастройки.Домен = ПолученныеНастройки["store"]["domain"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.35") >= 0 Тогда
		ТекущиеНастройки.ДоменПользователя = СвойстваМагазина["custom_domain"];
		ТекущиеНастройки.ТипСертификатаДоменаПользователя = СвойстваМагазина["custom_domain_certificate_type"];
	КонецЕсли;
	
	ТекущиеНастройки.НазваниеМагазина        = СвойстваМагазина["name"];
	ТекущиеНастройки.КраткоеОписаниеМагазина = СвойстваМагазина["description"];
	
	ТекущиеНастройки.АдресМагазина           = СвойстваМагазина["address"];
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.40") >= 0 Тогда
		ТекущиеНастройки.HtmlЯндексКарта          = СвойстваМагазина["maps_html"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.20") >= 0 Тогда
		ТекущиеНастройки.ТелефонМагазина1         = СвойстваМагазина["phone1"];
		ТекущиеНастройки.ТелефонМагазина1Описание = СвойстваМагазина["phone1_description"];
		ТекущиеНастройки.ТелефонМагазина2         = СвойстваМагазина["phone2"];
		ТекущиеНастройки.ТелефонМагазина2Описание = СвойстваМагазина["phone2_description"];
		ТекущиеНастройки.ТелефонМагазина3         = СвойстваМагазина["phone3"];
		ТекущиеНастройки.ТелефонМагазина3Описание = СвойстваМагазина["phone3_description"];
	Иначе
		ТелефоныСтруктура = Маг1СИнтеграцияСлужебный.ПреобразоватьНомерТелефонаВСтруктуру(СвойстваМагазина["telephone"]);
		Для Каждого КлючЗначение из ТелефоныСтруктура Цикл
			ТекущиеНастройки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.42") >= 0 Тогда
		ТекущиеНастройки.ЧатМаксМагазина     = СвойстваМагазина["messenger_max"];
	КонецЕсли;
	ТекущиеНастройки.WhatsAppМагазина        = СвойстваМагазина["whatsapp"];
	ТекущиеНастройки.ViberМагазина           = СвойстваМагазина["viber"];
	ТекущиеНастройки.TelegramМагазина        = СвойстваМагазина["telegram"];
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.29") >= 0 Тогда
		ТекущиеНастройки.TelegramКаналМагазина        = СвойстваМагазина["telegram_channel"];
	КонецЕсли;
	ТекущиеНастройки.EmailМагазина           = СвойстваМагазина["email"];
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.13") >= 0 Тогда
		ТекущиеНастройки.РасширенноеОписаниеМагазина = СвойстваМагазина["extended_description"];
		ТекущиеНастройки.РежимВитрины            = СвойстваМагазина["mode"];
		ТекущиеНастройки.VKМагазина              = СвойстваМагазина["vk"];
		ТекущиеНастройки.InstagramМагазина       = СвойстваМагазина["instagram"];
		ТекущиеНастройки.FacebookМагазина        = СвойстваМагазина["facebook"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.15") >= 0 Тогда
		Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.18") >= 0 Тогда
			ТекущиеНастройки.ЧатБитрикс24ИмяПользователяМагазина = СвойстваМагазина["bitrix24_user"];
			ТекущиеНастройки.ЧатБитрикс24НазваниеЧатаМагазина    = СвойстваМагазина["bitrix24_chat"];
		Иначе
			ТекущиеНастройки.ЧатБитрикс24ИмяПользователяМагазина = СвойстваМагазина["bitrix24"];
			ТекущиеНастройки.ЧатБитрикс24НазваниеЧатаМагазина    = СвойстваМагазина["bitrix24"];
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваМагазина["logo"]) Тогда
		ТекущиеНастройки.ДанныеКартинкиЛоготипа = ПолучитьДвоичныеДанныеИзBase64Строки(СвойстваМагазина["logo"]);
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.1") >= 0 Тогда
		ТекущиеНастройки.ВыгружатьИнформативныеОстатки = СвойстваМагазина["display_stock"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.41") >= 0 Тогда
		ТекущиеНастройки.ДлинаДесятичнойЧастиКоличестваВЗаказе = СвойстваМагазина["decimal_length"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.5") >= 0 Тогда
		ТекущиеНастройки.ВыгружатьКартинки = СвойстваМагазина["display_images"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.6") >= 0 Тогда
		ТекущиеНастройки.ОтображаемоеПолеКодаНоменклатуры = СвойстваМагазина["showed_code_property"];
	КонецЕсли;
	
	// Свойства организации
	Если НастройкиУчетнойСистемы.Организация.ОграничениеТипа <> Неопределено Тогда
		
		Значение = ЗначениеПоИдентификатору(
			СвойстваМагазина["company_id"],
			НастройкиУчетнойСистемы.Организация.ОграничениеТипа);
		
		Если Значение <> Неопределено Тогда
			ТекущиеНастройки.ПараметрыУчета.Организация = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	// Склад
	Если НастройкиУчетнойСистемы.Склад.ОграничениеТипа <> Неопределено Тогда
		Значение = ЗначениеПоИдентификатору(
			ПолученныеНастройки["warehouse"]["id"],
			НастройкиУчетнойСистемы.Склад.ОграничениеТипа);
			
		Если Значение <> Неопределено Тогда
			ТекущиеНастройки.ПараметрыУчета.Склад = Значение;
		КонецЕсли;
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.29") >= 0 Тогда
		// Банковский счет
		Если НастройкиУчетнойСистемы.БанковскийСчет.ОграничениеТипа <> Неопределено Тогда
			Значение = ЗначениеПоИдентификатору(
				ПолученныеНастройки["bank_account"]["id"],
				НастройкиУчетнойСистемы.БанковскийСчет.ОграничениеТипа);
				
			Если Значение <> Неопределено Тогда
				ТекущиеНастройки.БанковскийСчет = Значение;
			КонецЕсли;
		КонецЕсли;
		
		ТекущиеНастройки.СпособФормированияСчетаНаОплату = ПолученныеНастройки["creating_invoice_method"];
		ТекущиеНастройки.ТекстУсловийВСчетеНаОплату      = ПолученныеНастройки["invoice_disclaimer"];
	КонецЕсли;
	
	// Вид цен
	Если НастройкиУчетнойСистемы.ВидЦен.ОграничениеТипа <> Неопределено Тогда
		Значение = ЗначениеПоИдентификатору(
			ПолученныеНастройки["price_list"]["id"],
			НастройкиУчетнойСистемы.ВидЦен.ОграничениеТипа);
			
		Если Значение <> Неопределено Тогда
			ТекущиеНастройки.ПараметрыУчета.ВидЦен = Значение;
		КонецЕсли;
	КонецЕсли;
	
	// Услуга доставки
	Если ЗначениеЗаполнено(ПолученныеНастройки["delivery_service"]) Тогда
		Если НастройкиУчетнойСистемы.УслугаДоставки.ОграничениеТипа <> Неопределено Тогда
			Значение = ЗначениеПоИдентификатору(
				ПолученныеНастройки["delivery_service"]["id"],
				НастройкиУчетнойСистемы.УслугаДоставки.ОграничениеТипа);
				
			Если Значение <> Неопределено Тогда
				ТекущиеНастройки.ПараметрыУчета.УслугаДоставки = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Самовывоз.Использование            = Ложь;
	КурьерскаяДоставка.Использование   = Ложь;
	ТранспортнаяКомпания.Использование = Ложь;
	
	// Условия доставки
	Для Каждого ОписаниеДоставки Из ПолученныеНастройки["delivery"] Цикл
		
		Если ОписаниеДоставки["delivery_type"] = "self-delivery" Тогда
			Самовывоз.Использование   = Истина;
			Самовывоз.РежимРаботы     = СвойстваМагазина["working_hours"];
			Самовывоз.УсловияДоставки = ОписаниеДоставки["delivery_terms"];
			
			ЗаполнитьВариантыОплатыИзСервиса(Самовывоз.ВариантыОплаты, ОписаниеДоставки["payment_types"]);
			
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.28") >= 0 Тогда
				Самовывоз.ВариантРасчетаСтоимости = ОписаниеДоставки["cost_calculation_method"];
				Самовывоз.Стоимость               = ОписаниеДоставки["delivery_cost"]
			КонецЕсли;
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.36") >= 0 Тогда
				Самовывоз.МинимальнаяСуммаЗаказа  = ОписаниеДоставки["minimum_order_amount"]
			КонецЕсли;
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.42") >= 0 Тогда
				Самовывоз.ОтображатьЖелаемуюДату  = ОписаниеДоставки["display_desired_date"]
			КонецЕсли;
		ИначеЕсли ОписаниеДоставки["delivery_type"] = "courier-delivery" Тогда
			КурьерскаяДоставка.Использование     = Истина;
			КурьерскаяДоставка.Стоимость         = ОписаниеДоставки["delivery_cost"];
			КурьерскаяДоставка.УсловияДоставки   = ОписаниеДоставки["delivery_terms"];
			
			ЗаполнитьВариантыОплатыИзСервиса(КурьерскаяДоставка.ВариантыОплаты, ОписаниеДоставки["payment_types"]);
			
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.28") >= 0 Тогда
				КурьерскаяДоставка.ВариантРасчетаСтоимости = ОписаниеДоставки["cost_calculation_method"];
			КонецЕсли;
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.36") >= 0 Тогда
				КурьерскаяДоставка.МинимальнаяСуммаЗаказа  = ОписаниеДоставки["minimum_order_amount"]
			КонецЕсли;
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.42") >= 0 Тогда
				КурьерскаяДоставка.ОтображатьЖелаемуюДату  = ОписаниеДоставки["display_desired_date"]
			КонецЕсли;
		ИначеЕсли ОписаниеДоставки["delivery_type"] = "shipping-company" Тогда
			ТранспортнаяКомпания.Использование     = Истина;
			ТранспортнаяКомпания.УсловияДоставки   = ОписаниеДоставки["delivery_terms"];
			
			ЗаполнитьВариантыОплатыИзСервиса(ТранспортнаяКомпания.ВариантыОплаты, ОписаниеДоставки["payment_types"]);
			
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.28") >= 0 Тогда
				ТранспортнаяКомпания.ВариантРасчетаСтоимости = ОписаниеДоставки["cost_calculation_method"];
				ТранспортнаяКомпания.Стоимость               = ОписаниеДоставки["delivery_cost"]
			КонецЕсли;
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.36") >= 0 Тогда
				ТранспортнаяКомпания.МинимальнаяСуммаЗаказа  = ОписаниеДоставки["minimum_order_amount"]
			КонецЕсли;
			Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.42") >= 0 Тогда
				ТранспортнаяКомпания.ОтображатьЖелаемуюДату  = ОписаниеДоставки["display_desired_date"]
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Обмен данными
	ОписаниеОбмена = ПолученныеНастройки["data_exchange"];
	
	УзелОбмена = ПланыОбмена[НастройкиУчетнойСистемы.ИмяПланаОбмена].НайтиПоКоду(ОписаниеОбмена["from"]);
	
	Если ЗначениеЗаполнено(УзелОбмена)
		И Не Маг1СИнтеграция.ЭтоУзелОбменаСВитриной(УзелОбмена) Тогда
		УзелОбмена = Неопределено;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		ТекущиеНастройки.УзелОбмена = УзелОбмена;
	КонецЕсли;
		
	// Настройки уведомлений
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.2") >= 0  Тогда
		НастройкиУведомлений = ТекущиеНастройки.НастройкиУведомлений;
		НастройкиУведомлений.EMailДляОтправкиУведомлений                              = ПолученныеНастройки["notifications"]["email"];
		Если ЗначениеЗаполнено(УзелОбмена) Тогда
			НастройкиУведомлений.ИдентификаторОбсуждения                                  = ПолученныеНастройки["notifications"]["chat_key"];
			НастройкиУведомлений.ИдентификаторСлужебногоПользователяСистемыВзаимодействия = ПолученныеНастройки["notifications"]["service_user_id"];
		КонецЕсли;
		Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.21") >= 0  Тогда
			НастройкиУведомлений.EMailДляОтправкиУведомленийОЗаказах = ПолученныеНастройки["notifications"]["email_for_orders"];	
		КонецЕсли;
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.8") >= 0  Тогда
		ТекущиеНастройки.ЭтоТестоваяВитрина = ПолученныеНастройки["IsTestApp"];
	КонецЕсли;
		
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.23") >= 0  Тогда
		ТекущиеНастройки.ЗначкиНоменклатуры.Очистить();
		
		Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.26") >= 0 Тогда
			ЭтоИдентификатор = Истина;
		Иначе
			ЭтоИдентификатор = Ложь;
		КонецЕсли;
		
		Для Каждого ОписаниеЗначка из ПолученныеНастройки["GoodsBadges"] Цикл
			
			Если ЭтоИдентификатор Тогда
				ЗначениеСвойства = Справочники[Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов()].ПолучитьСсылку(Новый УникальныйИдентификатор(ОписаниеЗначка["Badge"]));
				Если Не ОбщегоНазначения.СсылкаСуществует(ЗначениеСвойства) Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				ЗначениеСвойства = Справочники[Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов()].НайтиПоНаименованию(
												ОписаниеЗначка["Badge"],
												Истина,
												,
												Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры());
				Если Не ЗначениеЗаполнено(ЗначениеСвойства) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ТекущиеНастройки.ЗначкиНоменклатуры.Добавить(Новый Структура("Значок, ОтображатьНаНачальнойСтранице", 
							 											ЗначениеСвойства,
																		ОписаниеЗначка["DisplayOnHomePage"]));
		КонецЦикла;
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.24") >= 0
		И НастройкиУчетнойСистемы.ПоддерживаетсяОплатаЧерезСБП
		И ЗначениеЗаполнено(ТекущиеНастройки.ПараметрыУчета.Организация) Тогда
		
		ИдНастройкиИзСерверногоКеша = ПолученныеНастройки["store"]["sbp_setting_id"]; 
		ИдМерчантаИзСерверногоКеша  = ПолученныеНастройки["store"]["sbp_merchant_id"];
		
		Если ЗначениеЗаполнено(ИдМерчантаИзСерверногоКеша) Тогда
			
			СсылкаНастройкаСБП = Неопределено;
			
			Если ЗначениеЗаполнено(ИдНастройкиИзСерверногоКеша) Тогда
				СсылкаНастройкаСБП = ЗначениеПоИдентификатору(
						ИдНастройкиИзСерверногоКеша,
						НастройкиУчетнойСистемы.НастройкаСБП.ОграничениеТипа);
	        КонецЕсли; 
			
			СсылкаНастройкаСБП = Маг1СИнтеграция.НастройкаСБП(СсылкаНастройкаСБП,
												ИдМерчантаИзСерверногоКеша,
												ТекущиеНастройки.ПараметрыУчета.Организация);
						
			Если ЗначениеЗаполнено(СсылкаНастройкаСБП) Тогда
				ТекущиеНастройки.НастройкаСБП = СсылкаНастройкаСБП;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.31") >= 0 Тогда
		ТекущиеНастройки.ОплатаПоСсылкеПереводомНаСчет = ПолученныеНастройки["store"]["invoice_use_for_temp_links"];
		ТекущиеНастройки.ОплатаПоСсылкеЧерезЮКассу = ПолученныеНастройки["store"]["u_kassa_use_for_temp_links"];
		ТекущиеНастройки.ОплатаПоСсылкеЧерезСБП = ПолученныеНастройки["store"]["sbp_use_for_temp_links"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.33") >= 0 Тогда
		ТекущиеНастройки.РежимРегистрацииПокупателей = ПолученныеНастройки["store"]["registration_mode"];
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.38") >= 0 Тогда
		ТекущиеНастройки.ОтображатьУменьшениеЦены = ПолученныеНастройки["store"]["display_price_reduction"];
	Иначе
		ТекущиеНастройки.ОтображатьУменьшениеЦены = Истина;	
	КонецЕсли;
	
	Если СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.39") >= 0  Тогда
		ТекущиеНастройки.WebChat_ИдентификаторИнтеграцииСистемыВзаимодействия = ПолученныеНастройки["WebChat"]["IntegrationID"];
		ТекущиеНастройки.WebChat_НавигационнаяСсылкаТочкиПодключения = ПолученныеНастройки["WebChat"]["NavigationLinkConnectionPoints"];
		ТекущиеНастройки.WebChat_SignKey = ПолученныеНастройки["WebChat"]["SignKey"];
		ТекущиеНастройки.WebChat_Представление = ПолученныеНастройки["WebChat"]["Description"];
	КонецЕсли;
	
	ИсправитьНастройкиОплатыСБП(ТекущиеНастройки);
	ПроверитьНастройкиЮКасса(ТекущиеНастройки);

КонецПроцедуры

Функция СтруктураОписанияУсловийДоставки()
	
	Результат = Новый Структура;
	Результат.Вставить("delivery_type"   "");
	Результат.Вставить("delivery_cost",  0);
	Результат.Вставить("minimum_order_amount",  0);
	Результат.Вставить("cost_calculation_method",  "");
	Результат.Вставить("delivery_terms", "");
	Результат.Вставить("payment_types",  Новый Массив);
	Результат.Вставить("display_desired_date",  Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеНастроекОплаты(ВариантыОплаты)
	
	Результат = Новый Массив;
	
	Если ВариантыОплаты.НаличнымиПриПолучении Тогда
		Результат.Добавить("cash");
	КонецЕсли;
	Если ВариантыОплаты.КартойПриПолучении Тогда
		Результат.Добавить("card");                
	КонецЕсли;
	Если ВариантыОплаты.ОнлайнПереводПриПолучении Тогда
		Результат.Добавить("online-transfer");
	КонецЕсли;
	Если ВариантыОплаты.ПереводомНаСчет Тогда
		Результат.Добавить("banking-transfer");
	КонецЕсли;
	
	Если ВариантыОплаты.ОнЛайнЧерезЮКассу Тогда
		Результат.Добавить(Маг1СПеречисления.ПлатежныеСистемы_u_kassa());
	КонецЕсли;
	
	Если ВариантыОплаты.ОнЛайнЧерезСБП Тогда
		Результат.Добавить(Маг1СПеречисления.ПлатежныеСистемы_sbp());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьВариантыОплатыИзСервиса(ВариантыОплаты, ОписаниеНастроекОплаты)
	
	ВариантыОплаты.НаличнымиПриПолучении     = (ОписаниеНастроекОплаты.Найти("cash") <> Неопределено);
	ВариантыОплаты.КартойПриПолучении        = (ОписаниеНастроекОплаты.Найти("card") <> Неопределено);
	ВариантыОплаты.ОнлайнПереводПриПолучении = (ОписаниеНастроекОплаты.Найти("online-transfer") <> Неопределено);
	ВариантыОплаты.ПереводомНаСчет           = (ОписаниеНастроекОплаты.Найти("banking-transfer") <> Неопределено);
	ВариантыОплаты.ОнЛайнЧерезЮКассу         = (ОписаниеНастроекОплаты.Найти("u-kassa") <> Неопределено)
												Или (ОписаниеНастроекОплаты.Найти("u_kassa") <> Неопределено);
	ВариантыОплаты.ОнЛайнЧерезСБП         	 = (ОписаниеНастроекОплаты.Найти("sbp") <> Неопределено);
	
КонецПроцедуры

Процедура ИсправитьНастройкиОплатыСБП(ОсновныеНастройки)
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ОтключитьОплатуСБП = Не НастройкиУчетнойСистемы.ПоддерживаетсяОплатаЧерезСБП
							Или Не ЗначениеЗаполнено(ОсновныеНастройки.НастройкаСБП);
							
	Если ОтключитьОплатуСБП Тогда						
		ОсновныеНастройки.НастройкиДоставки.Самовывоз.ВариантыОплаты.ОнЛайнЧерезСБП = Ложь;
		ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.ВариантыОплаты.ОнЛайнЧерезСБП  = Ложь;
		ОсновныеНастройки.НастройкиДоставки.ТранспортнаяКомпания.ВариантыОплаты.ОнЛайнЧерезСБП  = Ложь;
		ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП = Ложь;
	КонецЕсли;
	
	Если Не ОсновныеНастройки.НастройкиДоставки.Самовывоз.ВариантыОплаты.ОнЛайнЧерезСБП
		И Не ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка.ВариантыОплаты.ОнЛайнЧерезСБП
		И Не ОсновныеНастройки.НастройкиДоставки.ТранспортнаяКомпания.ВариантыОплаты.ОнЛайнЧерезСБП
		И Не ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП Тогда
		
		ОсновныеНастройки.НастройкаСБП = Неопределено;
		
	КонецЕсли;
КонецПроцедуры

Функция ОписаниеДополнительныхНастроек(ДополнительныеНастройки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Описание = Новый Структура;
	Описание.Вставить("format_version", Маг1СИнтеграцияСлужебный.ТекущаяВерсияФорматаНастроек());
	Описание.Вставить("catalog_filters", Новый Массив);
	
	Для Каждого ТекущееЗначение Из ДополнительныеНастройки.ОтборыКаталогаТоваров Цикл
		Описание["catalog_filters"].Добавить(СериализаторXDTO.XMLСтрока(ТекущееЗначение));
	КонецЦикла;
	
	Описание.Вставить("orders_statuses_map", Новый Структура);
	
	Для Каждого КлючЗначение из ДополнительныеНастройки.СоответствияСтатусовЗаказов Цикл
		ИдентификаторыСтатусов = Новый Массив();
		Для Каждого СтрМас из КлючЗначение.Значение Цикл
			ИдентификаторыСтатусов.Добавить(СериализаторXDTO.XMLСтрока(СтрМас));
		КонецЦикла;
		
		Описание["orders_statuses_map"].Вставить(КлючЗначение.Ключ, ИдентификаторыСтатусов); 
	КонецЦикла;
		
	ПравилаОтображенияТоваров = Новый Структура;
	
	ПравилаОтображенияТоваров.Вставить("only_active", ДополнительныеНастройки.ПравилаОтображенияТоваров.ПубликоватьТолькоАктивныеПозиции);	
	ПравилаОтображенияТоваров.Вставить("supplier_order", ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоЗаказамПоставщикам);	
	ПравилаОтображенияТоваров.Вставить("stock", ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоОстаткам);	
	ПравилаОтображенияТоваров.Вставить("sales", ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоПродажам);	
	ПравилаОтображенияТоваров.Вставить("segment", ДополнительныеНастройки.ПравилаОтображенияТоваров.ОтборПоСегменту);	
	
	Описание.Вставить("goods_display_rules", ПравилаОтображенияТоваров);
	
	Описание.Вставить("stock_only_for_selected_warehouses", ДополнительныеНастройки.УчитыватьОстаткиТолькоПоВыбраннымСкладам);
	
	Описание.Вставить("stock_warehouses", Новый Массив);
	Описание.Вставить("segment_value", Неопределено);
	
	Если ЗначениеЗаполнено(ДополнительныеНастройки.СегментНоменклатуры) Тогда
		Описание["segment_value"] = СериализаторXDTO.XMLСтрока(ДополнительныеНастройки.СегментНоменклатуры);
	КонецЕсли;
	
	Для Каждого СтрМас из ДополнительныеНастройки.СкладыОстатков Цикл
		Описание["stock_warehouses"].Добавить(СериализаторXDTO.XMLСтрока(СтрМас));
	КонецЦикла;

	Описание.Вставить("goods_properties", Новый Массив);
	
	Для Каждого КлючЗначение из ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров Цикл
		
		НастройкаСвойства = КлючЗначение.Значение;
		
		ОписаниеСвойства = Новый Структура();
		Если ТипЗнч(НастройкаСвойства.СвойствоТовара) = Тип("Строка") Тогда
			ОписаниеСвойства.Вставить("good_property", НастройкаСвойства.СвойствоТовара); 
		Иначе
			ОписаниеСвойства.Вставить("good_property", СериализаторXDTO.XMLСтрока(НастройкаСвойства.СвойствоТовара));
		КонецЕсли;
		
		ОписаниеСвойства.Вставить("use_for_filter", НастройкаСвойства.ИспользоватьДляФильтра); 
		ОписаниеСвойства.Вставить("order", НастройкаСвойства.Порядок); 
		
		Описание["goods_properties"].Добавить(ОписаниеСвойства);
	КонецЦикла;

	Описание.Вставить("hierarchy_by", ДополнительныеНастройки.ИерархияПо);
	
	Возврат Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(Описание);
	
КонецФункции

Процедура ДополнительныеНастройкиВСервисе(ПолученныеНастройки, ТекущиеНастройки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если ПолученныеНастройки.Свойство("format_version")
		И СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.27") >= 0 Тогда
		
		ТекущиеНастройки.ИерархияПо = ПолученныеНастройки["hierarchy_by"];
	Иначе
		ТекущиеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ГруппыНоменклатуры();
	КонецЕсли;	
	
	ОграничениеТипаНоменклатуры = Неопределено;
	
	Если ТекущиеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ГруппыНоменклатуры() Тогда
		ОграничениеТипаНоменклатуры = НастройкиУчетнойСистемы.Номенклатура.ОграничениеТипа;
	Иначе
		ОграничениеТипаНоменклатуры = НастройкиУчетнойСистемы.ВидНоменклатуры.ОграничениеТипа;
	КонецЕсли;

	Если ОграничениеТипаНоменклатуры <> Неопределено Тогда
		
		Если ПолученныеНастройки.Свойство("format_version")
			И СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.7") >= 0 Тогда
			
			Для Каждого ИдентификаторЗначения Из ПолученныеНастройки["catalog_filters"] Цикл
				Значение = ЗначениеПоИдентификатору(ИдентификаторЗначения, ОграничениеТипаНоменклатуры);
				Если Значение <> Неопределено Тогда
					ТекущиеНастройки.ОтборыКаталогаТоваров.Добавить(Значение);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Каждого ОписаниеОтбора Из ПолученныеНастройки["catalog_filters"] Цикл
				Для Каждого ИдентификаторЗначения Из ОписаниеОтбора["values"] Цикл
					Значение = ЗначениеПоИдентификатору(ИдентификаторЗначения, ОграничениеТипаНоменклатуры);
					Если Значение <> Неопределено Тогда
						ТекущиеНастройки.ОтборыКаталогаТоваров.Добавить(Значение);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.ОграничениеТипа <> Неопределено
		И ПолученныеНастройки.Свойство("format_version")
		И СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.5") >= 0 Тогда

		ТекущиеНастройки.СоответствияСтатусовЗаказов.Очистить();
		
		Для Каждого КлючЗначение из ПолученныеНастройки["orders_statuses_map"] Цикл
			СсылкиСтатусов = Новый Массив();
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				Для Каждого СтрМас из КлючЗначение.Значение Цикл
					Значение = ЗначениеПоИдентификатору(СтрМас, НастройкиУчетнойСистемы.СтатусЗаказаПокупателя.ОграничениеТипа);
					Если Значение <> Неопределено Тогда 
						СсылкиСтатусов.Добавить(Значение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ТекущиеНастройки.СоответствияСтатусовЗаказов.Вставить(КлючЗначение.Ключ, СсылкиСтатусов); 
		КонецЦикла;
	КонецЕсли;
	
	Если ПолученныеНастройки.Свойство("format_version")
		И СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.7") >= 0 Тогда
		
		ПравилаОтображенияТоваров = ПолученныеНастройки["goods_display_rules"];
		
		ТекущиеНастройки.ПравилаОтображенияТоваров.ПубликоватьТолькоАктивныеПозиции = ПравилаОтображенияТоваров["only_active"];	
		ТекущиеНастройки.ПравилаОтображенияТоваров.ОтборПоЗаказамПоставщикам = ПравилаОтображенияТоваров["supplier_order"];	
		ТекущиеНастройки.ПравилаОтображенияТоваров.ОтборПоОстаткам = ПравилаОтображенияТоваров["stock"];	
		ТекущиеНастройки.ПравилаОтображенияТоваров.ОтборПоПродажам = ПравилаОтображенияТоваров["sales"];	
		
	КонецЕсли;
	
	Если ПолученныеНастройки.Свойство("format_version")
		И СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.9") >= 0 Тогда
		
		ТекущиеНастройки.СкладыОстатков.Очистить();
		ТекущиеНастройки.УчитыватьОстаткиТолькоПоВыбраннымСкладам = ПолученныеНастройки["stock_only_for_selected_warehouses"];
		
		ОграничениеТипаСклада = НастройкиУчетнойСистемы.Склад.ОграничениеТипа;
		Для Каждого ИдентификаторЗначения Из ПолученныеНастройки["stock_warehouses"] Цикл
			Значение = ЗначениеПоИдентификатору(ИдентификаторЗначения, ОграничениеТипаСклада); 
			Если Значение <> Неопределено Тогда
				ТекущиеНастройки.СкладыОстатков.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
		
	
	Если ПолученныеНастройки.Свойство("format_version")
		И СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.26") >= 0 Тогда
		
		ТекущиеНастройки.ВыгружаемыеСвойстваТоваров.Очистить();
		
		ОграничениеПВХДопРеквизитов = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения");

		Для Каждого НастройкаСвойстваПолученная из ПолученныеНастройки["goods_properties"] Цикл
			
			НастройкаСвойства = Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктураНастройкиСвойстваТовара();	
			
			Если СтрНайти(НастройкаСвойстваПолученная["good_property"], ".") > 0 Тогда
				СвойствоТовара = НастройкаСвойстваПолученная["good_property"]; 
			Иначе
				СвойствоТовара = ЗначениеПоИдентификатору(НастройкаСвойстваПолученная["good_property"], ОграничениеПВХДопРеквизитов);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СвойствоТовара) Тогда
				Продолжить;
			КонецЕсли;
			
			ОписаниеСвойства = Маг1СИнтеграция.ОписаниеСвойства(СвойствоТовара);
			
			Если ОписаниеСвойства.Метаданные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
            НастройкаСвойства.СвойствоТовара = СвойствоТовара;
			НастройкаСвойства.ИспользоватьДляФильтра = НастройкаСвойстваПолученная["use_for_filter"];
			НастройкаСвойства.Порядок = НастройкаСвойстваПолученная["order"];
			
			Если Не ОписаниеСвойства.ДоступноИспользованиеДляФильтра
				И НастройкаСвойства.ИспользоватьДляФильтра Тогда
				
				НастройкаСвойства.ИспользоватьДляФильтра = Ложь;
			КонецЕсли;
			
			ТекущиеНастройки.ВыгружаемыеСвойстваТоваров.Вставить(СвойствоТовара, НастройкаСвойства); 
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПолученныеНастройки.Свойство("format_version")
		И СравнитьВерсииФорматаНастроек(ПолученныеНастройки["format_version"], "1.32") >= 0 Тогда
		ТекущиеНастройки.ПравилаОтображенияТоваров.ОтборПоСегменту = ПравилаОтображенияТоваров["segment"];	
		
		ОграничениеТипаСегмента = НастройкиУчетнойСистемы.СегментНоменклатуры.ОграничениеТипа;
		
		Если ОграничениеТипаСегмента <> Неопределено Тогда
			ТекущиеНастройки.СегментНоменклатуры = ЗначениеПоИдентификатору(ПолученныеНастройки["segment_value"], ОграничениеТипаСегмента); 
        КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Функция РежимВитриныВСервисе(РежимВитриныВСервисе)
	Если НРег(РежимВитриныВСервисе) = "open" Тогда
		Возврат Маг1СПеречисления.РежимыВитрины_Открытый();
		
	ИначеЕсли НРег(РежимВитриныВСервисе) = "private" Тогда
		Возврат Маг1СПеречисления.РежимыВитрины_Закрытый();
		
	ИначеЕсли НРег(РежимВитриныВСервисе) = "limited" Тогда
		Возврат Маг1СПеречисления.РежимыВитрины_Ограниченный();
		
	ИначеЕсли НРег(РежимВитриныВСервисе) = "mag1cpage" Тогда
		Возврат Маг1СПеречисления.РежимыВитрины_СтраницаMag1c();
		
	Иначе 
		ТекстИсключения = НСтр("ru = 'Неизвестный режим %РежимВитриныВСервисе'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область ОбработчикиДлительныхОпераций

Функция ПолучениеИнформацииОВременнойСсылкеПараметрыОперации() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("АдресПриложенияВИнтернете", "");	
	Результат.Вставить("ЛогинИПП", "");	
	Результат.Вставить("ДокументСсылка", Неопределено);	
	Результат.Вставить("Организация", Неопределено);	
	Результат.Вставить("Контрагент", Неопределено);	
	
	Возврат Результат;
КонецФункции
		
Процедура ВернутьРезультат(Результат, АдресРезультата)
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	Если ТипЗнч(АдресРезультата) = Тип("Строка")
		И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
		
	Иначе
		АдресРезультата = Результат;
	КонецЕсли;
КонецПроцедуры

Процедура ПолучениеИнформацииОВременнойСсылке(ПараметрыОперации, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ",             Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());

	ПараметрыИнформацииПоПрофилю = Новый Структура;
	ПараметрыИнформацииПоПрофилю.Вставить("АдресПриложенияВИнтернете", ПараметрыОперации.АдресПриложенияВИнтернете);
	ПараметрыИнформацииПоПрофилю.Вставить("ЭтоИнтерактивныйЗапуск", Истина);
	ПараметрыИнформацииПоПрофилю.Вставить("ЛогинИПП", ПараметрыОперации.ЛогинИПП);
	ПараметрыИнформацииПоПрофилю.Вставить("СписокВитринОбновлятьВсегда", Ложь);
	
	Попытка
		
		Обработки.Маг1СНастройка.ПолучениеИнформацииПоПрофилюВФоновомЗадании(ПараметрыИнформацииПоПрофилю, Результат);
		Результат.Вставить("ОписаниеСсылки", 
			Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеВременнойСсылки(Маг1СПеречисления.СостоянияВременныхСсылок_НетСсылкиНетОснования()));
		Результат.Вставить("Действие", Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_СоздатьПриложение());
		Результат.Вставить("ОписаниеИнвайта", Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеИнвайта());
				
		Если Результат.Отказ Тогда
			ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		Если Результат.РасширениеОбновлено Тогда
			Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПерезапуститьПрограмму();
			
			ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		Если Результат.ВитриныПользователя.Количество() = 0 Тогда
			Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_СоздатьПриложение();
			ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		ВсеПодходящие         = Новый Массив;
		
		СтраницыMag1cРаботают = Новый Массив;
		СтраницыMag1cУдалены  = Новый Массив;
		ВитриныРаботают       = Новый Массив;
		ВитриныЗаблокированы  = Новый Массив;
		ИдентификаторИБ       = Результат.ОписаниеКонфигурации.ИдентификаторИБ;
				
		Для каждого КлючЗначение из Результат.ВитриныПользователя Цикл
			
			Если КлючЗначение.Значение.ИдентификаторИБ = ИдентификаторИБ
				И КлючЗначение.Значение.Организация = ПараметрыОперации.Организация Тогда
								
				Если КлючЗначение.Значение.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
					
					Если КлючЗначение.Значение.Состояние = Маг1СПеречисления.СостоянияВитрины_Ready() Тогда
						ВитриныРаботают.Добавить(КлючЗначение.Значение);
						ВсеПодходящие.Добавить(КлючЗначение.Значение);

					ИначеЕсли КлючЗначение.Значение.Состояние = Маг1СПеречисления.СостоянияВитрины_Blocked() Тогда 
						ВитриныЗаблокированы.Добавить(КлючЗначение.Значение);
						ВсеПодходящие.Добавить(КлючЗначение.Значение);

					КонецЕсли;
					
				Иначе
					
					Если КлючЗначение.Значение.Состояние = Маг1СПеречисления.СостоянияВитрины_Ready() Тогда
				   		СтраницыMag1cРаботают.Добавить(КлючЗначение.Значение);
						ВсеПодходящие.Добавить(КлючЗначение.Значение);

					ИначеЕсли КлючЗначение.Значение.Состояние = Маг1СПеречисления.СостоянияВитрины_Deleted() Тогда
				   		СтраницыMag1cУдалены.Добавить(КлючЗначение.Значение);
						ВсеПодходящие.Добавить(КлючЗначение.Значение);

					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Результат.ВитриныПользователя = Новый Структура;
		
		Если ВсеПодходящие.Количество() = 0 Тогда
			Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_СоздатьПриложение();
			ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
			
		СтрокаСпискаВитрин            = Неопределено;
		ПараметрыАвторизацииНаВитрине = Неопределено; 
		
		// Проверим строки, которые подходят по организации - если ссылка по этому документу уже была ранее получена, то
		// будем использовать эту строку
		
		Для Каждого СтрокаКандидат из ВсеПодходящие Цикл
			
			Если СтрокаКандидат.Состояние <> Маг1СПеречисления.СостоянияВитрины_Ready()
				И СтрокаКандидат.Состояние <> Маг1СПеречисления.СостоянияВитрины_Blocked() Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыАвторизацииНаВитрине = ПараметрыАвторизацииНаВитрине(СтрокаКандидат.ИдентификаторВитрины);
			
			Результат.ОписаниеСсылки = Обработки.Маг1СОбмен.ПолучитьИнформациюОВременнойСсылке(ПараметрыАвторизацииНаВитрине,
																								ПараметрыОперации.ДокументСсылка);
			
			Если Результат.ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_СсылкаДействует()
				Или Результат.ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_НетСсылкиОснованиеСозданоНаВитрине() Тогда
				
				СтрокаСпискаВитрин = СтрокаКандидат;
				Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку();
				
				Прервать;
				
			КонецЕсли;
			
			ПараметрыАвторизацииНаВитрине = Неопределено; 
		КонецЦикла;
		
		Если СтрокаСпискаВитрин = Неопределено Тогда
			
			Если ВитриныРаботают.Количество() > 0
				Или ВитриныЗаблокированы.Количество() > 0 Тогда
				
				Если ВитриныРаботают.Количество() = 1 Тогда
					
					СтрокаСпискаВитрин = ВитриныРаботают[0];
					Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку();
					
				ИначеЕсли ВитриныРаботают.Количество() = 0
					И ВитриныЗаблокированы.Количество() = 1 Тогда
					
					СтрокаСпискаВитрин = ВитриныЗаблокированы[0];
					Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку();
					
				Иначе
										
					Для каждого СтрокаВитрин из ВитриныРаботают Цикл
						Результат.ВитриныПользователя.Вставить(
							Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СтрокаВитрин.ИдентификаторВитрины),
							СтрокаВитрин); 
					КонецЦикла;
					
					Для каждого СтрокаВитрин из ВитриныЗаблокированы Цикл
						Результат.ВитриныПользователя.Вставить(
							Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СтрокаВитрин.ИдентификаторВитрины),
							СтрокаВитрин); 
					КонецЦикла;
					
					Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ВыбратьПриложение();
				КонецЕсли;
				
			ИначеЕсли СтраницыMag1cРаботают.Количество() > 0 Тогда
				
				СтрокаСпискаВитрин = СтраницыMag1cРаботают[0];
				Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку();
				
			ИначеЕсли СтраницыMag1cУдалены.Количество() > 0 Тогда
				
				СтрокаСпискаВитрин = СтраницыMag1cУдалены[0];
				Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_СоздатьПриложение();
				
			КонецЕсли;
						
		КонецЕсли;
		
		Если СтрокаСпискаВитрин <> Неопределено Тогда
			Результат.ВитриныПользователя = Новый Структура(Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СтрокаСпискаВитрин.ИдентификаторВитрины),
																СтрокаСпискаВитрин);
		КонецЕсли;		
		
		Если Результат.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку()
			И СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
			
			Если ПараметрыАвторизацииНаВитрине = Неопределено Тогда
				ПараметрыАвторизацииНаВитрине = ПараметрыАвторизацииНаВитрине(СтрокаСпискаВитрин.ИдентификаторВитрины);
			КонецЕсли;	
			
			Результат.ОписаниеИнвайта = Обработки.Маг1СОбмен.ПолучитьИнформациюПроверитьПоКонтрагенту(ПараметрыАвторизацииНаВитрине,
																							ПараметрыОперации.Контрагент);
		КонецЕсли;
		
	Исключение
		Информация = ИнформацияОбОшибке();
		
		Результат.Отказ = Истина;
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПолучениеПрофиляПользователя(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									, 
									ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	ВернутьРезультат(Результат, АдресРезультата);
		
КонецПроцедуры

Процедура ПолучениеИнформацииПоПрофилюВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПрофильПользователя", СтруктураПрофиляПользователя());
	Результат.Вставить("ВитриныПользователя", Неопределено);
	Результат.Вставить("ОписаниеКонфигурации", Неопределено);
	Результат.Вставить("РасширениеОбновлено", Ложь);
	
	Результат.Вставить("Отказ",             Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	АдресПриложенияВИнтернете = ПараметрыОперации.АдресПриложенияВИнтернете;
	ЭтоИнтерактивныйЗапуск    = ПараметрыОперации.ЭтоИнтерактивныйЗапуск;
	
	Если Не ЭтоИнтерактивныйЗапуск Тогда
		// Пауза для того, чтобы завершилась транзакция записи настроек ЮКассы
		Маг1СИнтеграцияСлужебный.Пауза(1);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокВитринЭтойБазы = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	ОбновлятьСписокВитрин = ПараметрыОперации.СписокВитринОбновлятьВсегда
							Или СписокВитринЭтойБазы.Количество() = 0
						  	Или Маг1СИнтеграцияСлужебный.ПрочитатьДатуОбновленияСпискаВитрин() < ТекущаяУниверсальнаяДата() - 3600;
							
	Если Не ОбновлятьСписокВитрин Тогда
		Результат.ВитриныПользователя  = СписокВитринЭтойБазы;
		Результат.ОписаниеКонфигурации = ОписаниеКонфигурации();
		ВернутьРезультат(Результат, АдресРезультата);
		Возврат;
	КонецЕсли;

	Попытка
		
		СистемныеНастройки = Маг1СИнтеграцияСлужебный.ПрочитатьСистемныеНастройки();
		ЕстьИзменения = Ложь;
		
		Если ЭтоИнтерактивныйЗапуск 
			И Не ПустаяСтрока(АдресПриложенияВИнтернете)
			И СистемныеНастройки.АдресПубликацииИБ <> АдресПриложенияВИнтернете Тогда
			
			СистемныеНастройки.АдресПубликацииИБ = АдресПриложенияВИнтернете;
			Маг1СИнтеграцияСлужебный.ЗаписатьСистемныеНастройки(СистемныеНастройки);
			
		КонецЕсли;
				
		ПараметрыАвторизации    = ПараметрыАвторизацииВМенеджере(ПараметрыОперации.ЛогинИПП, СистемныеНастройки);
		
		Если ЭтоИнтерактивныйЗапуск 
			И ПараметрыАвторизации.РасширениеОбновлено Тогда
			Результат.РасширениеОбновлено = Истина;
			ВызватьИсключение НСтр("ru = 'Перед продолжением работы необходимо перезайти в программу.'");
		КонецЕсли;
		
		ИдентификаторИБ         = ПараметрыАвторизации.ОписаниеКонфигурации.ИдентификаторИБ;
		
		ПрофильПользователя = ПолучитьПрофильПользователя(ПараметрыАвторизации);
		ВитриныПользователя = ПолучитьСписокВитрин(ПараметрыАвторизации);
		
		Для каждого КлючЗначение из ВитриныПользователя Цикл
			ВитринаВСервисе  = КлючЗначение.Значение;
			КлючСпискаВитрин = Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(ВитринаВСервисе.ИдентификаторВитрины);
			
			Если ВитринаВСервисе.ИдентификаторИБ = ИдентификаторИБ Тогда
				
				ВосстановитьНастройкиВитрины(ВитринаВСервисе, ПараметрыАвторизации, СистемныеНастройки);	
				
				Если (Не СписокВитринЭтойБазы.Свойство(КлючСпискаВитрин)
					   Или Не Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктурыРавны(СписокВитринЭтойБазы[КлючСпискаВитрин],
					   																ВитринаВСервисе)) Тогда
					ЕстьИзменения = Истина;
					СписокВитринЭтойБазы.Вставить(КлючСпискаВитрин, ВитринаВСервисе);
					
				КонецЕсли;
				
				Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(ВитринаВСервисе)
					И ЗначениеЗаполнено(ВитринаВСервисе.УзелОбмена)
					И ОбщегоНазначения.СсылкаСуществует(ВитринаВСервисе.УзелОбмена) Тогда				
						
					Обработки.Маг1СОбмен.ОтключитьАвтоматическийОбмен(ВитринаВСервисе.УзелОбмена, Ложь);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		СтрокиКУдалению = Новый Массив;
		
		Для Каждого КлючЗначение из СписокВитринЭтойБазы Цикл
			Если КлючЗначение.Ключ = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
				ВитриныПользователя.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				
			ИначеЕсли Не ВитриныПользователя.Свойство(КлючЗначение.Ключ) Тогда 
 
				Если КлючЗначение.Значение.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
				
					Если КлючЗначение.Значение.Состояние <> Маг1СПеречисления.СостоянияВитрины_Deleted() Тогда
						КлючЗначение.Значение.Состояние = Маг1СПеречисления.СостоянияВитрины_Deleted();
						ЕстьИзменения = Истина;
					КонецЕсли;
					ВитриныПользователя.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
					
				Иначе
					СтрокиКУдалению.Добавить(КлючЗначение.Ключ);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(КлючЗначение.Значение.УзелОбмена) Тогда
					Если ОбщегоНазначения.СсылкаСуществует(КлючЗначение.Значение.УзелОбмена) Тогда
						Попытка
							ОбменДаннымиСервер.УдалитьНастройкуСинхронизации(КлючЗначение.Значение.УзелОбмена);
						Исключение
							Информация = ИнформацияОбОшибке();
							
							ТекстОшибки = НСтр("ru = 'Ошибка удаления настройки синхронизации по странице mag1c: %ОписаниеОшибки'");
							ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ОписаниеОшибки", ПодробноеПредставлениеОшибки(Информация));
																
							ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПолучениеПрофиляПользователя(),
														УровеньЖурналаРегистрации.Ошибка,
														КлючЗначение.Значение.УзелОбмена.Метаданные(),
														КлючЗначение.Значение.УзелОбмена, 
														ТекстОшибки);
						КонецПопытки;
					КонецЕсли;
					
					КлючЗначение.Значение.УзелОбмена = Неопределено;
					ЕстьИзменения = Истина;
				КонецЕсли;
				
			ИначеЕсли ВитриныПользователя[КлючЗначение.Ключ].ИдентификаторИБ <> ИдентификаторИБ Тогда
				
				СтрокиКУдалению.Добавить(КлючЗначение.Ключ);
				Маг1СИнтеграцияСлужебный.УдалитьНастройкиВитрины(КлючЗначение.Значение.ИдентификаторВитрины);
				Если ЗначениеЗаполнено(КлючЗначение.Значение.УзелОбмена)
					И ОбщегоНазначения.СсылкаСуществует(КлючЗначение.Значение.УзелОбмена) Тогда
					
					Обработки.Маг1СОбмен.ОтключитьАвтоматическийОбмен(КлючЗначение.Значение.УзелОбмена, Ложь);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрМас из СтрокиКУдалению Цикл
			ЕстьИзменения = Истина;
			СписокВитринЭтойБазы.Удалить(СтрМас);
			
		КонецЦикла;
		
		Если ЕстьИзменения Тогда
			Маг1СИнтеграцияСлужебный.ЗаписатьСписокВитринБазы(СписокВитринЭтойБазы);
			Маг1СИнтеграция.УдалитьНеактуальныеДополнительныеСведения();
		КонецЕсли;
		
		ПрофильПользователя.ЕстьДругиеВитрины = ВитриныПользователя.Количество() > 1;	
		
		Результат.ПрофильПользователя  = ПрофильПользователя;
		Результат.ВитриныПользователя  = ВитриныПользователя;
		Результат.ОписаниеКонфигурации = ПараметрыАвторизации.ОписаниеКонфигурации;
		
	Исключение
		Информация = ИнформацияОбОшибке();
		
		Результат.Отказ = Истина;
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПолучениеПрофиляПользователя(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
			
		Результат.ПрофильПользователя = СтруктураПрофиляПользователя();
		Для Каждого КлючЗначение из СписокВитринЭтойБазы Цикл
			КлючЗначение.Значение.СообщениеМенеджера = НСтр("ru = 'Не удалось получить информацию о состоянии витрины'");	
		КонецЦикла;
		
		Результат.ВитриныПользователя  = СписокВитринЭтойБазы;
		Результат.ОписаниеКонфигурации = ОписаниеКонфигурации();
		
		ВернутьРезультат(Результат, АдресРезультата);
		Возврат;
	КонецПопытки;
	
	Попытка
		
		ЕстьИзменения = Ложь;
		
		СписокНастроекВитрины = Маг1СИнтеграция.СписокНастроекВитрин();
			
		// Пройдем по всем витринам и обновим настройки
		// Если в настройках нечего обновлять - обновление не пойдет, т.к. кеш совпадет
		Для Каждого КлючЗначение из СписокНастроекВитрины Цикл
			
			Если КлючЗначение.Ключ <> Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины()
				И Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(ВитриныПользователя[КлючЗначение.Ключ]) Тогда

				СтрокаСпискаВитрин = ВитриныПользователя[КлючЗначение.Ключ];
				
				Попытка
					СтрокаСпискаВитрин = ОбновитьНастройкиВитрины(СтрокаСпискаВитрин,
																	  КлючЗначение.Значение,
																	  ПараметрыАвторизации);
																	  
					Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктурыРавны(СтрокаСпискаВитрин, КлючЗначение.Значение) Тогда																	  
						ЕстьИзменения = Истина;												  
						СписокВитринЭтойБазы.Вставить(КлючЗначение.Ключ, СтрокаСпискаВитрин);
					КонецЕсли;

				Исключение
					Информация = ИнформацияОбОшибке();
					
					Результат.Отказ = Истина;
					Результат.СообщениеОбОшибке = Результат.СообщениеОбОшибке +
					Символы.ВК + НСтр("ru = 'Ошибка обновления настроек витрины:'") + КраткоеПредставлениеОшибки(Информация);
					
					ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПолучениеПрофиляПользователя(),
						УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
						
				КонецПопытки;
				
			КонецЕсли;
				
		КонецЦикла;
		
		Если ЕстьИзменения Тогда
			Маг1СИнтеграцияСлужебный.ЗаписатьСписокВитринБазы(СписокВитринЭтойБазы);
		КонецЕсли;
		
		Если Не Результат.Отказ Тогда
			Маг1СИнтеграцияСлужебный.УдалитьНеобходимостьОбновленияНастроекВитрин();
		КонецЕсли;
		
		Маг1СИнтеграцияСлужебный.СохранитьДатуОбновленияСпискаВитрин();
	Исключение
		Информация = ИнформацияОбОшибке();
		
		Результат.Отказ = Истина;
		Результат.СообщениеОбОшибке = Результат.СообщениеОбОшибке +
		Символы.ВК + НСтр("ru = 'Сохранения списка витрин:'") + КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПолучениеПрофиляПользователя(),
		УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
		
	КонецПопытки;
			
	ВернутьРезультат(Результат, АдресРезультата);	
КонецПроцедуры

Процедура ПеренастроитьВитринуНаЭтуБазуВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("СтрокаСпискаВитрин", Неопределено);
	
	Результат.Вставить("Отказ",             Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	ИдентификаторВитрины = ПараметрыОперации.ИдентификаторВитрины;
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Попытка
		ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(ПараметрыОперации.ЛогинИПП);
		
		СтрокаСпискаВитрин = ПолучитьВитрину(ИдентификаторВитрины, ПараметрыАвторизации);
		
		СостояниеМастера = Маг1СИнтеграцияСлужебный.СтруктураСостоянияМастера();
		Маг1СИнтеграцияСлужебный.ЗаполнитьНастройкиПоУмолчанию(СостояниеМастера,
																			   НастройкиУчетнойСистемы,
																			   ПараметрыОперации.ЛогинИПП,
																			   СтрокаСпискаВитрин);
		
		ПолучитьНастройкиВитрины(СостояниеМастера.НастройкиВитрины, ПараметрыАвторизации); 
		Маг1СИнтеграцияСлужебный.ИсправитьНастройки(СостояниеМастера.НастройкиВитрины);
		
		СтрокаСпискаВитрин.ИдентификаторИБ = ПараметрыАвторизации.ОписаниеКонфигурации.ИдентификаторИБ;
		
		СостояниеМастера.СтраницаПереходаСохраненная = "СтраницаНазваниеВитрины";
		Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
		
		Результат.СтрокаСпискаВитрин = СтрокаСпискаВитрин;
		
	Исключение
		Информация = ИнформацияОбОшибке();
		
		Результат.Отказ = Истина;
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПеренастройкаВитриныНаТекущуюБазу(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
			
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Процедура ПроверитьИмяВитриныВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ИмяВалидно", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	Попытка
		ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(ПараметрыОперации.ЛогинИПП);
		
		РезультатПроверки = ПроверитьИмяВитрины(ПараметрыОперации.ПолноеИмяВитрины, ПараметрыАвторизации);
		ЗаполнитьЗначенияСвойств(Результат, РезультатПроверки); 
		
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		Результат.Отказ = Истина;
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПроверкаИмениВитрины(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	ВернутьРезультат(Результат, АдресРезультата);	
	
КонецПроцедуры

Процедура ПроверитьДоменПользователяВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ИмяВалидно", Ложь);
