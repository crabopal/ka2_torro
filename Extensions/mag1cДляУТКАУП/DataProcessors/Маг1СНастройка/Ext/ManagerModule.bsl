	Описание["bank_account"].Вставить("name", СведенияОбОрганизации.НаименованиеБанка);
	Описание["bank_account"].Вставить("account_number", СведенияОбОрганизации.НомерСчета);
	Описание["bank_account"].Вставить("bic", СведенияОбОрганизации.БИК);
	Описание["bank_account"].Вставить("correspondent_account", СведенияОбОрганизации.КоррСчет);
	
	// Услуга доставки
