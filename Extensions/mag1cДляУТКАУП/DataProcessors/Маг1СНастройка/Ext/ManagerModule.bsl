	ВернутьРезультат(Результат, АдресРезультата);	
	
КонецПроцедуры

Процедура СоздатьВитринуВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	НастройкиВитрины   = ПараметрыОперации.СостояниеМастера.НастройкиВитрины;
	ЛогинИПП           = ПараметрыОперации.СостояниеМастера.НастройкиВитрины.ЛогинИПП;
	
	Результат = Новый Структура;
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СтрокаСпискаВитрин", ПараметрыОперации.СтрокаСпискаВитрин);
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	Попытка
		ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(ЛогинИПП);
		
		Если Не ЗначениеЗаполнено(Результат.СтрокаСпискаВитрин.ИдентификаторВитрины)
			Или Результат.СтрокаСпискаВитрин.ИдентификаторВитрины = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины()
			Или Результат.СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Deleted()
			Или (ЗначениеЗаполнено(Результат.СтрокаСпискаВитрин.ИдентификаторВитрины)
				И ПараметрыОперации.РежимСоздания = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c()) Тогда 
			
			Результат.СтрокаСпискаВитрин = СоздатьВитрину(Результат.СтрокаСпискаВитрин,
															НастройкиВитрины, 
															ПараметрыАвторизации);
			Маг1СИнтеграцияСлужебный.СохранитьВСпискеВитринБазы(Результат.СтрокаСпискаВитрин, Истина, ПараметрыОперации.СостояниеМастера);
		Иначе
			ОбновитьНастройкиВитриныВФоновомЗадании(ПараметрыОперации, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		СчетчикПроверки = 0;
		
		Пока Не Маг1СИнтеграцияСлужебныйКлиентСервер.ОшибкаВыполненияОперацииСВитриной(Результат.СтрокаСпискаВитрин) 
			И Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(Результат.СтрокаСпискаВитрин)
			И Не Маг1СИнтеграцияСлужебныйКлиентСервер.СозданиеВитриныОтложено(Результат.СтрокаСпискаВитрин)
			И СчетчикПроверки < 240 Цикл
			
			Маг1СИнтеграцияСлужебный.Пауза(3);
			Результат.СтрокаСпискаВитрин = ПолучитьВитрину(Результат.СтрокаСпискаВитрин.ИдентификаторВитрины, ПараметрыАвторизации);
			СчетчикПроверки = СчетчикПроверки + 1;
			
		КонецЦикла;
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.ОшибкаВыполненияОперацииСВитриной(Результат.СтрокаСпискаВитрин) Тогда
			Результат.СообщениеОбОшибке = НСтр("ru = 'К сожалению, создание витрины не завершилось из-за ошибки. Сообщите, пожалуйста, об этом в техподдержку webits-info@1c.ru'");
			Результат.Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеВитрины(),
				УровеньЖурналаРегистрации.Ошибка, , , Результат.СообщениеОбОшибке);
		
		ИначеЕсли Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(Результат.СтрокаСпискаВитрин)
			И Не Маг1СИнтеграцияСлужебныйКлиентСервер.СозданиеВитриныОтложено(Результат.СтрокаСпискаВитрин) Тогда
				
			Результат.СообщениеОбОшибке = НСтр("ru = 'Создание витрины не завершилось за 20 минут. Запустите мастер создания витрин позднее.'");
			Результат.Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеВитрины(),
				УровеньЖурналаРегистрации.Ошибка, , , Результат.СообщениеОбОшибке);
	
		КонецЕсли;
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОбновитьТокеныДоступаКПлатежнымСистемам(Результат.СтрокаСпискаВитрин) Тогда
			Результат.СтрокаСпискаВитрин = ОбновитьТокеныДоступаКПлатежнымСистемам(Результат.СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации);
		КонецЕсли;

		Маг1СИнтеграцияСлужебный.СохранитьВСпискеВитринБазы(Результат.СтрокаСпискаВитрин, Ложь);
				
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		Результат.Отказ = Истина;
		
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеВитрины(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Функция ПараметрыСоздатьОбновитьСтраницуMag1cВФоновомЗадании() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("СтрокаСпискаВитрин", Неопределено);
	Результат.Вставить("СостояниеМастера", Неопределено);
	
	Возврат Результат;
КонецФункции

Процедура СоздатьОбновитьСтраницуMag1cВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	Если ЗначениеЗаполнено(ПараметрыОперации.СтрокаСпискаВитрин.ИдентификаторВитрины)
		И ПараметрыОперации.СтрокаСпискаВитрин.ИдентификаторВитрины <> Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины()
		И ПараметрыОперации.СтрокаСпискаВитрин.Состояние <> Маг1СПеречисления.СостоянияВитрины_Deleted() Тогда
		
		ОбновитьНастройкиВитриныВФоновомЗадании(ПараметрыОперации, АдресРезультата);
		Возврат;
	КонецЕсли;
	
	СостояниеМастера   = ПараметрыОперации.СостояниеМастера;
	НастройкиВитрины   = СостояниеМастера.НастройкиВитрины;
	ЛогинИПП           = ПараметрыОперации.СостояниеМастера.НастройкиВитрины.ЛогинИПП;
	
	Результат = Новый Структура;
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СтрокаСпискаВитрин", ПараметрыОперации.СтрокаСпискаВитрин);
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Попытка
		ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(ЛогинИПП);
		
		Результат.СтрокаСпискаВитрин = СоздатьСтраницуMag1c(НастройкиВитрины, 
														ПараметрыАвторизации);
		Маг1СИнтеграцияСлужебный.СохранитьВСпискеВитринБазы(Результат.СтрокаСпискаВитрин, Истина, ПараметрыОперации.СостояниеМастера);	
				
		СчетчикПроверки = 0;
		
		Пока Не Маг1СИнтеграцияСлужебныйКлиентСервер.ОшибкаВыполненияОперацииСВитриной(Результат.СтрокаСпискаВитрин) 
			И Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(Результат.СтрокаСпискаВитрин)
			И Не Маг1СИнтеграцияСлужебныйКлиентСервер.СозданиеВитриныОтложено(Результат.СтрокаСпискаВитрин)
			И СчетчикПроверки < 240 Цикл
			
			Маг1СИнтеграцияСлужебный.Пауза(3);
			Результат.СтрокаСпискаВитрин = ПолучитьВитрину(Результат.СтрокаСпискаВитрин.ИдентификаторВитрины, ПараметрыАвторизации);
			СчетчикПроверки = СчетчикПроверки + 1;
			
		КонецЦикла;
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.ОшибкаВыполненияОперацииСВитриной(Результат.СтрокаСпискаВитрин) Тогда
			Результат.СообщениеОбОшибке = НСтр("ru = 'К сожалению, создание страницы mag1c не завершилось из-за ошибки. Сообщите, пожалуйста, об этом в техподдержку webits-info@1c.ru'");
			Результат.Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеВитрины(),
				УровеньЖурналаРегистрации.Ошибка, , , Результат.СообщениеОбОшибке);
		    ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.СозданиеВитриныОтложено(Результат.СтрокаСпискаВитрин) Тогда
				
			Результат.СообщениеОбОшибке = НСтр("ru = 'Мы приняли заявку на создание страницы mag1c. Создадим ее как только будет техническая возможность. Вам придет уведомление на указанных адрес электронной почты. После этого  попробуйте, пожалуйста, повторить операцию.'");
			Результат.Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеВитрины(),
				УровеньЖурналаРегистрации.Ошибка, , , Результат.СообщениеОбОшибке);
			
		    ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(Результат.СтрокаСпискаВитрин) Тогда
				
			Результат.СообщениеОбОшибке = НСтр("ru = 'Создание  создание страницы mag1c не завершилось за 20 минут. Запустите мастер создания витрин позднее.'");
			Результат.Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеВитрины(),
				УровеньЖурналаРегистрации.Ошибка, , , Результат.СообщениеОбОшибке);
			
		    ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		ЧастиИмени = СтрРазделить(Результат.СтрокаСпискаВитрин.ПолноеИмяВитрины, ".");
		НастройкиВитрины.ОсновныеНастройки.ИмяВитрины = ЧастиИмени[0];
		ЧастиИмени.Удалить(0);
		НастройкиВитрины.ОсновныеНастройки.Домен      = СтрСоединить(ЧастиИмени, ".");
		
		Если СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
	
			Участники = Новый Массив;
			Участники.Добавить(Пользователи.ТекущийПользователь());
						
			РезультатСозданияОбсуждения = Маг1СИнтеграцияСлужебный.СоздатьОбновитьОбсуждение(
				НастройкиВитрины,
				Участники,
				Истина);
				
			Если РезультатСозданияОбсуждения.Успешно Тогда
				
				НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений.ИдентификаторОбсуждения = РезультатСозданияОбсуждения.Ключ;
				НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений.ИдентификаторСлужебногоПользователяСистемыВзаимодействия =
						Маг1СИнтеграцияСлужебный.ИдентификаторСлужебногоПользователяСистемыВзаимодействия();	
				
			КонецЕсли;
				
		КонецЕсли;
			
		Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, Результат.СтрокаСпискаВитрин);
		
		РезультатСоздания = Обработки.Маг1СОбмен.СоздатьНастройкуОбмена(СостояниеМастера, Результат.СтрокаСпискаВитрин);	
		
		Если РезультатСоздания.Отказ Тогда
			Результат.Отказ             = Истина;
			Результат.СообщениеОбОшибке = РезультатСоздания.СообщениеОбОшибке;
		    ВернутьРезультат(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, Результат.СтрокаСпискаВитрин);
		
		Результат.СтрокаСпискаВитрин = ОбновитьНастройкиВитрины(Результат.СтрокаСпискаВитрин,
									                             НастройкиВитрины,
																 ПараметрыАвторизации);
		
		Маг1СИнтеграцияСлужебный.СохранитьВСпискеВитринБазы(Результат.СтрокаСпискаВитрин, Ложь);
				
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		Результат.Отказ = Истина;
		
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеВитрины(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	ВернутьРезультат(Результат, АдресРезультата);
	
КонецПроцедуры

Процедура ОбновитьНастройкиВитриныВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	НастройкиВитрины   = ПараметрыОперации.СостояниеМастера.НастройкиВитрины;
	ЛогинИПП           = ПараметрыОперации.СостояниеМастера.НастройкиВитрины.ЛогинИПП;
	
	СертификатДоменаПользователя = Неопределено;
	ПараметрыОперации.Свойство("СертификатДоменаПользователя", СертификатДоменаПользователя);
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СообщениеОбОшибке",  "");
	Результат.Вставить("СтрокаСпискаВитрин", ПараметрыОперации.СтрокаСпискаВитрин); 
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	Попытка
		
		ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(ЛогинИПП);
		
		НовоеПолноеИмя = НастройкиВитрины.ОсновныеНастройки.ИмяВитрины + "." + НастройкиВитрины.ОсновныеНастройки.Домен; 
		
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		
		Если Результат.СтрокаСпискаВитрин.ПолноеИмяВитрины <> НовоеПолноеИмя Тогда
			
			Результат.СтрокаСпискаВитрин = ОбновитьИмяВитрины(Результат.СтрокаСпискаВитрин.ИдентификаторВитрины,
															  НовоеПолноеИмя,
															  ПараметрыАвторизации); 
			
			СчетчикПроверки = 0;
			
			Пока (Результат.СтрокаСпискаВитрин.Состояние <> "Ready"
				И Результат.СтрокаСпискаВитрин.Состояние <> "Blocked")
				И СчетчикПроверки < 240 Цикл
				
				Маг1СИнтеграцияСлужебный.Пауза(5);
				Результат.СтрокаСпискаВитрин = ПолучитьВитрину(Результат.СтрокаСпискаВитрин.ИдентификаторВитрины,
																ПараметрыАвторизации);
				СчетчикПроверки = СчетчикПроверки + 1;
				
			КонецЦикла;
						
			Если (Результат.СтрокаСпискаВитрин.Состояние <> "Ready"
				И Результат.СтрокаСпискаВитрин.Состояние <> "Blocked") Тогда
				
				Результат.СообщениеОбОшибке = НСтр("ru = 'Изменение имени витрины не завершилось за 20 минут. Попробуйте повторить попытку позднее.'");
				Результат.Отказ = Истина;
				
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеНастроекВитрины(),
				УровеньЖурналаРегистрации.Ошибка, , , Результат.СообщениеОбОшибке);
				
				Маг1СИнтеграцияСлужебный.СохранитьВСпискеВитринБазы(Результат.СтрокаСпискаВитрин, Ложь);
				
			Иначе
				НастройкиВитрины.ОсновныеНастройки.АдресСайтаВитрины = Результат.СтрокаСпискаВитрин.АдресСайтаВитрины; 
				НастройкиВитрины.ОсновныеНастройки.ПолноеИмяВитрины  = Результат.СтрокаСпискаВитрин.ПолноеИмяВитрины;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Результат.СтрокаСпискаВитрин.ДоменПользователя <> НастройкиВитрины.ОсновныеНастройки.ДоменПользователя
			Или (Результат.СтрокаСпискаВитрин.ТипСертификатаДоменаПользователя <> НастройкиВитрины.ОсновныеНастройки.ТипСертификатаДоменаПользователя
				И Маг1СИнтеграцияСлужебныйКлиентСервер.ТипСертификатаДоменаПользователяЗаполнен(НастройкиВитрины.ОсновныеНастройки.ТипСертификатаДоменаПользователя))
			Или Маг1СИнтеграцияСлужебныйКлиентСервер.СертификатДоменаПользователяЗаполнен(СертификатДоменаПользователя) Тогда
			
			Результат.СтрокаСпискаВитрин = ОбновитьДоменПользователя(НастройкиВитрины,
																	 СертификатДоменаПользователя,
																	 ПараметрыАвторизации);
																	 
		КонецЕсли;
		
		Если Не Результат.Отказ Тогда
			Результат.СтрокаСпискаВитрин = ОбновитьНастройкиВитрины(
				Результат.СтрокаСпискаВитрин,
				НастройкиВитрины,
				ПараметрыАвторизации);
										
			Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(ПараметрыОперации.СостояниеМастера, Результат.СтрокаСпискаВитрин);
				
		КонецЕсли;	
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		Результат.Отказ = Истина;
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеНастроекВитрины(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Процедура СохранитьНастройкиПодготовитьВыгрузкуВыгрузитьТоварыВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СообщениеОбОшибке",  "");
	Результат.Вставить("Отказ",  Ложь);
	Результат.Вставить("ОбменУжеВыполняется",  Ложь);
	Результат.Вставить("СтрокаСпискаВитрин", Неопределено);
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);

	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	СтрокаСпискаВитрин = ПараметрыОперации.СтрокаСпискаВитрин;
	НастройкиВитрины   = ПараметрыОперации.СостояниеМастера.НастройкиВитрины;
	ЛогинИПП           = НастройкиВитрины.ЛогинИПП;
	УзелОбмена         = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	
	Если Не ЗначениеЗаполнено(УзелОбмена) Тогда
		РезультатСоздания = Обработки.Маг1СОбмен.СоздатьНастройкуОбмена(ПараметрыОперации.СостояниеМастера, СтрокаСпискаВитрин);	
		
		Если РезультатСоздания.Отказ Тогда
			Результат.Отказ             = Истина;
			Результат.СообщениеОбОшибке = РезультатСоздания.СообщениеОбОшибке;
		    Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
			ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
			
		ПараметрыОперации.СтрокаСпискаВитрин = Маг1СИнтеграция.СтрокаСпискаВитринПоИдентификаторуВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины);
		
		СтрокаСпискаВитрин = ПараметрыОперации.СтрокаСпискаВитрин;
		НастройкиВитрины   = ПараметрыОперации.СостояниеМастера.НастройкиВитрины;
		УзелОбмена         = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	КонецЕсли;
	
	// Когда изменились параметры учета, нужно просто сделать обмен с витриной, чтобы выгрузились новые цены
	// - не нужно регистрировать к обмену номенклатуру - просто при обмене не будет найдет нужный слепок данных
	// и новые цены выгрузятся сами, а слепок по старому виду цен будет удален
	Если Не ПараметрыОперации.ИзменилисьТолькоПараметрыУчета 
		Или ПараметрыОперации.ВыгружатьВсеТовары Тогда
	
		РезультатПодготовкиВыгрузки = Обработки.Маг1СОбмен.ПодготовитьДанныеДляВыгрузки(НастройкиВитрины,
																						ПараметрыОперации.ВыгружатьВсеТовары);
		Результат.ОбменУжеВыполняется  = РезультатПодготовкиВыгрузки.ОбменУжеВыполняется;
		Результат.СообщениеОбОшибке    = РезультатПодготовкиВыгрузки.СообщениеОбОшибке;
		
		Если РезультатПодготовкиВыгрузки.Отказ Тогда
			Результат.Отказ = Истина;
		    Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
			ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыОперации.Вставить("ОбновитьНастройкиВитрины", Истина);
	
	РезультатОбновленияНастроек = Неопределено;
	
	ОбновитьДополнительныеНастройкиВФоновомЗадании(ПараметрыОперации, РезультатОбновленияНастроек);
	
	ЗаполнитьЗначенияСвойств(Результат, РезультатОбновленияНастроек,,"ПараметрыСобытия"); 
	
	Если Результат.Отказ Тогда
		Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = Неопределено;
	ПараметрыОперацииОбмена = Новый Структура;
	ПараметрыОперацииОбмена.Вставить("УзелОбмена", УзелОбмена);
	ПараметрыОперацииОбмена.Вставить("НастройкиВитрины", НастройкиВитрины);
	ПараметрыОперацииОбмена.Вставить("ЖдатьОкончанияТекущегоОбмена", Ложь);
	ПараметрыОперацииОбмена.Вставить("ЭтоИнтерактивныйЗапуск", Истина);
	
	Обработки.Маг1СОбмен.ВыполнитьОбменВФоновомЗадании(ПараметрыОперацииОбмена, РезультатОбмена);
	
	Результат.ОбменУжеВыполняется = РезультатОбмена.ОбменУжеВыполняется;

	Если Результат.ОбменУжеВыполняется Тогда
		Результат.СообщениеОбОшибке = НСтр("ru = 'Товары были зарегистрированы к обмену и будут выгружены на витрину автоматически после окончания идущего сейчас сеанса синхронизации.'");	
	Иначе
		Если РезультатОбмена.Отказ Тогда
			Результат.Отказ = Истина;
		КонецЕсли;
		Результат.СообщениеОбОшибке = РезультатОбмена.СообщениеОбОшибке;
	КонецЕсли;
	
	Если РезультатОбмена.СтрокаСпискаВитрин <> Неопределено Тогда
		Результат.СтрокаСпискаВитрин = РезультатОбмена.СтрокаСпискаВитрин;
	КонецЕсли;
	
	Результат.Вставить("УзелОбмена", НастройкиВитрины.ОсновныеНастройки.УзелОбмена);

	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
		
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

	
КонецПроцедуры

Процедура ОбновитьДополнительныеНастройкиВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	НастройкиВитрины   = ПараметрыОперации.СостояниеМастера.НастройкиВитрины;
	ЛогинИПП           = ПараметрыОперации.СостояниеМастера.НастройкиВитрины.ЛогинИПП;
	
	Результат = Новый Структура;
	Результат.Вставить("СообщениеОбОшибке",  "");
	Результат.Вставить("Отказ",  Ложь);
	Результат.Вставить("СтрокаСпискаВитрин", ПараметрыОперации.СтрокаСпискаВитрин);
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	НастройкиОбновлены = Ложь;
	
	Попытка		
		ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(ЛогинИПП);
		Если ПараметрыОперации.ОбновитьНастройкиВитрины Тогда
			Результат.СтрокаСпискаВитрин = ОбновитьНастройкиВитрины(Результат.СтрокаСпискаВитрин, 
														  НастройкиВитрины,
														  ПараметрыАвторизации);
		КонецЕсли;
		
		Результат.СтрокаСпискаВитрин = ОбновитьДополнительныеНастройки(Результат.СтрокаСпискаВитрин,
																	НастройкиВитрины,
																	ПараметрыАвторизации);
																	
		Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(ПараметрыОперации.СостояниеМастера, Результат.СтрокаСпискаВитрин);
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		Результат.Отказ = Истина;
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбновлениеНастроекВитрины(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	Если ТипЗнч(АдресРезультата) = Тип("Строка")
		И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	Иначе
		АдресРезультата = Результат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Печать

Функция СформироватьПечатнуюФормуЛистовкиМагазина(НастройкиВитрины) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ПолеСправа  = 2;
	ТабличныйДокумент.ПолеСлева   = 2;
	
	ОсновныеНастройки = НастройкиВитрины.ОсновныеНастройки;
	ДополнительныеНастройки        = НастройкиВитрины.ДополнительныеНастройки;
	
	МакетЛистовки = УправлениеПечатью.МакетПечатнойФормы("Обработка.Маг1СНастройка.Листовка");
	
	ОбластьШапка = Неопределено;
	Если ЗначениеЗаполнено(ОсновныеНастройки.ДанныеКартинкиЛоготипа) Тогда
		ОбластьШапка = МакетЛистовки.ПолучитьОбласть("ШапкаСЛоготипом");
		ОбластьШапка.Параметры.Заполнить(ОсновныеНастройки);
		
		КартинкаЛоготип = Новый Картинка(ОсновныеНастройки.ДанныеКартинкиЛоготипа);
		
		Рисунок = ОбластьШапка.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
		Рисунок.Картинка = КартинкаЛоготип;
		Рисунок.РазмерКартинки = РазмерКартинки.АвтоРазмер;
		Рисунок.ГраницаСверху = Ложь;
		Рисунок.ГраницаСправа = Ложь;
		Рисунок.ГраницаСнизу  = Ложь;
		Рисунок.ГраницаСлева  = Ложь;
		Рисунок.Расположить(ОбластьШапка.Область("РисунокЛоготип"));
	Иначе
		ОбластьШапка = МакетЛистовки.ПолучитьОбласть("ШапкаБезЛоготипа");
		ОбластьШапка.Параметры.Заполнить(ОсновныеНастройки);
	КонецЕсли;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьВставка = МакетЛистовки.ПолучитьОбласть("Вставка");
	ТабличныйДокумент.Вывести(ОбластьВставка);
	
	ОбластьПодвал = МакетЛистовки.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.НазваниеМагазина = ОсновныеНастройки.НазваниеМагазина;
	ОбластьПодвал.Параметры.АдресМагазина    = ОсновныеНастройки.АдресМагазина;
	ОбластьПодвал.Параметры.ТелефонМагазина  = ОсновныеНастройки.ТелефонМагазина1;
	
	ОбластьПодвал.Параметры.АдресСайта = ОсновныеНастройки.ПолноеИмяВитрины;
	
	РисунокШтрихкод = ОбластьПодвал.Рисунки.ШтрихкодПечать;
	
	ПараметрыКартинки = Новый Структура;
	ПараметрыКартинки.Вставить("Ширина", 175);
	ПараметрыКартинки.Вставить("Высота", 175);
	
	РисунокШтрихкод.Картинка = Маг1СИнтеграцияСлужебный.ПолучитьКартинкуQRКода(
		ПараметрыКартинки,
		ОсновныеНастройки.АдресСайтаВитрины);
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область Аутентификация

Функция СведенияАутентификацииВМенеджереВитрин(ПараметрыАвторизации, МожноВзятьИзКеша)
	
	Если МожноВзятьИзКеша Тогда
		Результат = Маг1СИнтеграцияСлужебный.ПрочитатьСведенияАутентификацииВМенеджере(ПараметрыАвторизации.ЛогинИПП);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТелоЗапроса = Новый Структура("token,login,password", "", "", "");
	
	ТикетАутентификации = ИнтернетПоддержкаПользователей.ТикетАутентификацииНаПорталеПоддержки(
			ИдентификаторСервисаМенеджераВитрин());
			
	Если ПустаяСтрока(ТикетАутентификации.КодОшибки) Тогда
		ТелоЗапроса.token = ТикетАутентификации.Тикет;
	ИначеЕсли ОбщегоНазначения.РазделениеВключено() Тогда
		ВызватьИсключение ТикетАутентификации.ИнформацияОбОшибке;
	Иначе
		ДанныеАутентификации = ИнтернетПоддержкаПользователей.ДанныеАутентификацииПользователяИнтернетПоддержки();
		
		ТелоЗапроса.login    = ДанныеАутентификации.Логин;
		ТелоЗапроса.password = ДанныеАутентификации.Пароль;
	КонецЕсли;
	
	АдресРесурса = "/api/v1/auth";
	Метод        = Маг1СПеречисления.МетодыHTTP_POST();
	
	ПараметрыАвторизации.ТокенАвторизации = Неопределено;
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);	
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ТелоЗапроса));
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	ПараметрыАвторизации.ТокенАвторизации = НовыйТокенАвторизации();
	
	Если Ответ.КодСостояния = 200 Тогда
		СтруктураОтвета = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		
		Результат = Новый Структура;
		Результат.Вставить("Идентификатор", СтруктураОтвета.Получить("client_id"));
		Результат.Вставить("СекретныйКлюч", СтруктураОтвета.Получить("client_secret"));
		Результат.Вставить("ДатаПолучения", ТекущаяУниверсальнаяДата());
		
		Маг1СИнтеграцияСлужебный.СохранитьСведенияАутентификацииВМенеджере(ПараметрыАвторизации.ЛогинИПП, Результат);
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияАутентификациНаВитрине(ИдентификаторВитрины, ЛогинИПП, МожноВзятьИзКеша)
	
	Если МожноВзятьИзКеша Тогда
		Результат = Маг1СИнтеграцияСлужебный.ПрочитатьСведенияАутентификацииНаВитрине(ИдентификаторВитрины);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Если Результат <> Неопределено Тогда
		Возврат Результат
	КонецЕсли;
	
	ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(ЛогинИПП);
	
	АдресРесурса = СтрШаблон("/api/v2/stores/%1/accounts", ИдентификаторВитрины);
	Метод        = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);	
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		ДанныеАутентификации = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		
		Для Каждого Элемент Из ДанныеАутентификации Цикл
			Если Элемент.Получить("type") <> "EXCHANGE" Тогда
				Продолжить;
			КонецЕсли;
			
			Результат = Новый Структура;
			Результат.Вставить("Идентификатор", Элемент.Получить("client_id"));
			Результат.Вставить("СекретныйКлюч", Элемент.Получить("client_secret"));
			Результат.Вставить("ДатаПолучения", ТекущаяУниверсальнаяДата());
			Прервать;
		КонецЦикла;
		
		Маг1СИнтеграцияСлужебный.СохранитьСведенияАутентификацииНаВитрине(ИдентификаторВитрины, Результат);
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область НастройкиСервисаМенеджераВитрин

Функция ИдентификаторСервисаМенеджераВитрин() Экспорт
	
	Возврат "1C-YOS";
	
КонецФункции

Функция ПараметрыАвторизацииОбщие(СтруктураURI)

	Результат = Новый Структура;                                  
	Результат.Вставить("СтруктураURI", СтруктураURI);
	Результат.Вставить("ТокенАвторизации",НовыйТокенАвторизации());
	Результат.Вставить("ИмяПараметраОтметкиОперации","");

	Возврат Результат;

КонецФункции

Функция НовыйТокенАвторизации()
	Возврат Новый Структура("ТипТокена,ИдентификаторТокена,СрокДействия", "Bearer", "",'00010101');
КонецФункции

Функция ПараметрыАвторизацииВМенеджере(ЛогинИПП, СистемныеНастройки = Неопределено) Экспорт

	Если СистемныеНастройки = Неопределено Тогда
		СистемныеНастройки = Маг1СИнтеграцияСлужебный.ПрочитатьСистемныеНастройки();
	КонецЕсли;
	
	СтруктураURI = Маг1СИнтеграцияСлужебный.СтруктураURI(СистемныеНастройки.АдресСервисаМенеджераВитрин);
	ПараметрыАвторизации = ПараметрыАвторизацииОбщие(СтруктураURI);
	
	ПараметрыАвторизации.Вставить("ЛогинИПП", ЛогинИПП);
	
	ПараметрыАвторизации.Вставить("ОписаниеКонфигурации", ОписаниеКонфигурации());
	ПараметрыАвторизации.Вставить("ОбновлятьРасширение", Истина);
	ПараметрыАвторизации.Вставить("РасширениеОбновлено", Ложь);
	ПараметрыАвторизации.Вставить("СистемныеНастройки", СистемныеНастройки);
	
    ОбновитьТокенАвторизации(ПараметрыАвторизации, Истина, Истина);
	
	Возврат ПараметрыАвторизации; 															
КонецФункции

Функция ПараметрыАвторизацииНаВитрине(УзелИнформационнойБазыИдентификаторВитрины) Экспорт
	
	Если ТипЗнч(УзелИнформационнойБазыИдентификаторВитрины) = Тип("Строка") Тогда
		СтрокаСпискаВитрин = Маг1СИнтеграция.СтрокаСпискаВитринПоИдентификаторуВитрины(УзелИнформационнойБазыИдентификаторВитрины);
	Иначе
		СтрокаСпискаВитрин = Маг1СИнтеграция.СтрокаСпискаВитринПоУзлуОбмена(УзелИнформационнойБазыИдентификаторВитрины);
	КонецЕсли;
	
	Если СтрокаСпискаВитрин = Неопределено Тогда
		ТекстИсключения = НСтр("ru = 'Не заданы настройки обмена с веб-витриной для узла обмена %УзелОбмена%'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%УзелОбмена%", УзелИнформационнойБазыИдентификаторВитрины);
		ВызватьИсключение ТекстИсключения;
	ИначеЕсли Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин) Тогда
		ТекстИсключения = НСтр("ru = 'Витрина %ИмяВитрины% в состоянии %Состояние% - не возможно выполнить операцию с витриной.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИмяВитрины%", СтрокаСпискаВитрин.ПолноеИмяВитрины);
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Состояние%", СтрокаСпискаВитрин.Состояние);
		ВызватьИсключение ТекстИсключения;	
	КонецЕсли;
	
	ЛогинИПП = Маг1СИнтеграцияСлужебный.СостояниеАутентификацииИПП().ЛогинИПП;
	
	СтруктураURI = Маг1СИнтеграцияСлужебный.СтруктураURI(СтрокаСпискаВитрин.АдресСайтаВитрины);
	ПараметрыАвторизации = ПараметрыАвторизацииОбщие(СтруктураURI);
	ПараметрыАвторизации.Вставить("СтруктураURI", СтруктураURI);
	ПараметрыАвторизации.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыАвторизации.Вставить("ИдентификаторВитрины", СтрокаСпискаВитрин.ИдентификаторВитрины);
	ПараметрыАвторизации.Вставить("РасширениеОбновлено", Ложь);
	ПараметрыАвторизации.Вставить("УзелОбмена", СтрокаСпискаВитрин.УзелОбмена);
	
	ОбновитьТокенАвторизации(ПараметрыАвторизации, Истина, Истина); 
													
	Возврат ПараметрыАвторизации;
КонецФункции

Процедура ОбновитьТокенАвторизации(ПараметрыАвторизации, МожноИспользоватьКеш, ИспользоватьКешКлючейДоступа) Экспорт
	Если ПараметрыАвторизации.Свойство("ИдентификаторВитрины") Тогда
		ОбновитьТокенАвторизацииНаВитрине(ПараметрыАвторизации, МожноИспользоватьКеш, ИспользоватьКешКлючейДоступа);
	Иначе
		ОбновитьТокенАвторизацииВМенеджере(ПараметрыАвторизации, МожноИспользоватьКеш, ИспользоватьКешКлючейДоступа);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбщегоНазначения

Процедура ВосстановитьНастройкиВитрины(СтрокаСпискаВитрин, ПараметрыАвторизации, СистемныеНастройки)
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	СостояниеМастера = Маг1СИнтеграцияСлужебный.ПрочитатьСостояниеМастераНастройкиВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины);
																									  
	Если СостояниеМастера <> Неопределено Тогда
		
		УзелОбмена = СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
		
		Если (ЗначениеЗаполнено(УзелОбмена)
				И Не ОбщегоНазначения.СсылкаСуществует(УзелОбмена))
			Или Не ЗначениеЗаполнено(УзелОбмена) Тогда
			
			СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.УзелОбмена = Неопределено;
			ПроверитьНастройкиЮКасса(СостояниеМастера.НастройкиВитрины.ОсновныеНастройки);
			
			Если СтрокаСпискаВитрин.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
				Обработки.Маг1СОбмен.СоздатьНастройкуОбмена(СостояниеМастера, СтрокаСпискаВитрин);	
			Иначе
				СостояниеМастера.СтраницаПереходаСохраненная = "СтраницаПроверкаПараметровВыгрузки";
				Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
			
		Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктурыРавны(СостояниеМастера.НастройкиВитрины.ОсновныеНастройки,
			                                                        СтрокаСпискаВитрин,
																	"АдресСайтаВитрины,ПолноеИмяВитрины,ИдентификаторВитрины")
			Или УзелОбмена <> СтрокаСпискаВитрин.УзелОбмена 
			Или Не ЗначениеЗаполнено(СостояниеМастера.СтраницаПереходаСохраненная) Тогда
			
			Если ЗначениеЗаполнено(УзелОбмена) Тогда
				СостояниеМастера.СтраницаПереходаСохраненная = "СтраницаЗавершение";
			ИначеЕсли СтрокаСпискаВитрин.ИдентификаторВитрины = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
				СостояниеМастера.СтраницаПереходаСохраненная = "СтраницаНазваниеВитрины";
			Иначе
				Если Маг1СИнтеграцияСлужебный.МожноПодключатьУведомления() Тогда
					СостояниеМастера.СтраницаПереходаСохраненная = "СтраницаПодключениеУведомлений";
				Иначе
					СостояниеМастера.СтраницаПереходаСохраненная = "СтраницаСоответствиеСтатусовЗаказов";
				КонецЕсли	
			КонецЕсли;
			
			ПроверитьНастройкиЮКасса(СостояниеМастера.НастройкиВитрины.ОсновныеНастройки);
			Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
			Возврат;	
		КонецЕсли;	
		
		Если ПроверитьНастройкиЮКасса(СостояниеМастера.НастройкиВитрины.ОсновныеНастройки) Тогда
			Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	СостояниеМастера = Маг1СИнтеграцияСлужебный.СтруктураСостоянияМастера();
	Маг1СИнтеграцияСлужебный.ЗаполнитьНастройкиПоУмолчанию(СостояниеМастера,
																			НастройкиУчетнойСистемы,
																			ПараметрыАвторизации.ЛогинИПП,
																			СтрокаСпискаВитрин);
		
	ОсновныеНастройкиПолучены = ПолучитьНастройкиВитрины(СостояниеМастера.НастройкиВитрины, ПараметрыАвторизации, СистемныеНастройки); 
	ДополнительныеНастройкиПолучены = Ложь;
	Если ОсновныеНастройкиПолучены Тогда
		ДополнительныеНастройкиПолучены = ПолучитьДополнительныеНастройки(СостояниеМастера.НастройкиВитрины, ПараметрыАвторизации);
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебный.ИсправитьНастройки(СостояниеМастера.НастройкиВитрины);
	
	Если ОсновныеНастройкиПолучены Тогда
		Если ДополнительныеНастройкиПолучены Тогда
			Если ЗначениеЗаполнено(СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.УзелОбмена) Тогда
				СтраницаПереходаСохраненная = "СтраницаЗавершение";
			Иначе
				Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин) Тогда
					СтраницаПереходаСохраненная = "СтраницаПроверкаПараметровВыгрузки";
				Иначе
					СтраницаПереходаСохраненная = "СтраницаПодготовкаВитриныОжидание";
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин) Тогда
				СтраницаПереходаСохраненная = "СтраницаСоответствиеСтатусовЗаказов";
			Иначе
				СтраницаПереходаСохраненная = "СтраницаПодготовкаВитриныОжидание";
			КонецЕсли;
		КонецЕсли;
	Иначе
		СтраницаПереходаСохраненная = "СтраницаНазваниеВитрины";
	КонецЕсли;
		
	// Служебные реквизиты мастера.
	СостояниеМастера.СтраницаПереходаСохраненная                = СтраницаПереходаСохраненная;
	Если СтраницаПереходаСохраненная <> "СтраницаНазваниеВитрины" Тогда
		СостояниеМастера.ПринятьУсловияЛицензионногоСоглашения      = Истина;
		СостояниеМастера.ОзнакомитьсяСоСпискомЗапрещенныхМатериалов = Истина;
	КонецЕсли;
	
	ПроверитьНастройкиЮКасса(СостояниеМастера.НастройкиВитрины.ОсновныеНастройки);
	Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
	
КонецПроцедуры

Функция ПроверитьНастройкиЮКасса(ОсновныеНастройки)
	Самовывоз            = ОсновныеНастройки.НастройкиДоставки.Самовывоз;
	КурьерскаяДоставка   = ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка;
	ТранспортнаяКомпания = ОсновныеНастройки.НастройкиДоставки.ТранспортнаяКомпания;
	
	Если (Самовывоз.Использование
			И Самовывоз.ВариантыОплаты.ОнЛайнЧерезЮКассу) 
		Или (КурьерскаяДоставка.Использование 
			И КурьерскаяДоставка.ВариантыОплаты.ОнЛайнЧерезЮКассу) 
		Или (ТранспортнаяКомпания.Использование
			И ТранспортнаяКомпания.ВариантыОплаты.ОнЛайнЧерезЮКассу)
			Или ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу Тогда
		
		Если ЗначениеЗаполнено(ОсновныеНастройки.ПараметрыУчета.Организация) Тогда
			Если Не Маг1СИнтеграцияСлужебный.ЮКассаПодключена(ОсновныеНастройки.ПараметрыУчета.Организация).Подключена Тогда
				Самовывоз.ВариантыОплаты.ОнЛайнЧерезЮКассу = Ложь;
				КурьерскаяДоставка.ВариантыОплаты.ОнЛайнЧерезЮКассу = Ложь;
				ТранспортнаяКомпания.ВариантыОплаты.ОнЛайнЧерезЮКассу = Ложь;
				ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу = Ложь;
				Возврат Истина;
			КонецЕсли;
		Иначе
			Самовывоз.ВариантыОплаты.ОнЛайнЧерезЮКассу = Ложь;
			КурьерскаяДоставка.ВариантыОплаты.ОнЛайнЧерезЮКассу = Ложь;
			ТранспортнаяКомпания.ВариантыОплаты.ОнЛайнЧерезЮКассу = Ложь;
			ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу = Ложь;
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

Функция СтруктураПрофиляПользователя() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ИмяПользователя", "");
	Результат.Вставить("ИмяДомена",       "");
	
	Результат.Вставить("ДоступныеРесурсы", Новый Структура);
	Результат.ДоступныеРесурсы.Вставить("Витрины", 0);
	
	Результат.Вставить("ИспользуемыеРесурсы", Новый Структура);
	Результат.ИспользуемыеРесурсы.Вставить("Витрины", 0);
	
	ЕстьВозможностьСозданияНовойВитрины = Результат.ДоступныеРесурсы.Витрины > Результат.ИспользуемыеРесурсы.Витрины;
	Результат.Вставить("ЕстьВозможностьСозданияНовойВитрины", Ложь);
	Результат.Вставить("ЕстьДругиеВитрины", Ложь);
	Результат.Вставить("ЕстьПлатныйТариф", Ложь);
	
	Возврат Результат;
КонецФункции

Функция СравнитьВерсииФорматаНастроек(Версия1, Версия2)
	
	Возврат ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Версия1 + ".0.0", Версия2 + ".0.0");
	
КонецФункции

Функция ЗначениеПоИдентификатору(Идентификатор, ОграничениеТипа)
	
	Результат = Неопределено;
	
	Если Не ТипЗнч(Идентификатор) = Тип("Строка")
		Или ПустаяСтрока(Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ДоступныйТип Из ОграничениеТипа.Типы() Цикл
		Если ДоступныйТип = Тип("Null") Тогда
			Продолжить;
		КонецЕсли;
		
		МетаданныеСправочника = Метаданные.НайтиПоТипу(ДоступныйТип);
		
		Если МетаданныеСправочника <> Неопределено Тогда
			Попытка
				Результат = Справочники[МетаданныеСправочника.Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			Исключение
			КонецПопытки;

			Если Результат <> Неопределено Тогда
				Если Не ОбщегоНазначения.СсылкаСуществует(Результат) Тогда
					Результат = Неопределено;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОписаниеКонфигурации

Функция ОписаниеКонфигурации() Экспорт
	
	Результат = СтруктураОписанияКонфигурации();
	Результат.ИмяКонфигурации    = Метаданные.Имя;
	Результат.ВерсияКонфигурации = Метаданные.Версия;
	Результат.ВерсияРасширения   = Маг1СИнтеграцияСлужебный.ВерсияРасширения();
	Результат.ИдентификаторИБ    = СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы();
	Результат.ЧасовойПоясСеанса  = ЧасовойПоясСеанса();
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		Результат.ЗначениеРазделителяСеанса = Формат(МодульРаботаВМоделиСервиса.ЗначениеРазделителяСеанса(),"ЧГ=0");
	КонецЕсли;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Результат.ВерсияПлатформы = СистемнаяИнформация.ВерсияПриложения; 
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураОписанияКонфигурации()
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяКонфигурации",    "");
	Результат.Вставить("ВерсияКонфигурации", "");
	Результат.Вставить("ВерсияРасширения",   "");
	Результат.Вставить("ИдентификаторИБ",    "");
	Результат.Вставить("ЧасовойПоясСеанса",  "");
	Результат.Вставить("ЗначениеРазделителяСеанса",  0);
	Результат.Вставить("ВерсияПлатформы",  "");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОперацииЮКасса

Функция ПолучитьСписокТокеновЮКассы()
	
	ПараметрыАвторизации = ПараметрыАвторизацииЮКассы();
	
	АдресРесурса = "/mag1c/tokens";
	Метод        = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
  	Запрос.Заголовки.Вставить("Content-type", "application/json;charset=utf-8");

	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Результат = Новый Массив();
	
	Если Ответ.КодСостояния = 200 Тогда
		Токены = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		
		Для каждого Токен из Токены Цикл
			ТокенСтруктура = Новый Структура();
			ТокенСтруктура.Вставить("ИдМагазина", Токен.Получить("shopId"));
			ТокенСтруктура.Вставить("ИдТокена", Токен.Получить("clientTokenId"));
			Результат.Добавить(ТокенСтруктура);
		КонецЦикла;
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
	
