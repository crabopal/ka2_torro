Функция ВитринаВСервисе(ВитринаВСервисе)
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебный.НастройкиУчетнойСистемы();
	
	Результат = Маг1СИнтеграцияСлужебныйКлиентСервер.СтрокаСпискаВитрин();
	Результат.ИдентификаторВитрины = ВитринаВСервисе.Получить("store-id");
	Результат.АдресСайтаВитрины    = ВитринаВСервисе.Получить("uri");
	Результат.ПолноеИмяВитрины     = ВитринаВСервисе.Получить("fqdn");
	Результат.ИдентификаторИБ      = ВитринаВСервисе.Получить("infobase-id");
	Результат.Состояние            = ВитринаВСервисе.Получить("status");
	Результат.СообщениеМенеджера   = ВитринаВСервисе.Получить("message");
	Результат.ХешОсновныхНастроек  = ВитринаВСервисе.Получить("settings-hash");
	Результат.ХешДополнительныхНастроек  = ВитринаВСервисе.Получить("additional-settings-hash");
	Результат.СтатусТокенаЮКассы   = ВитринаВСервисе.Получить("u-kassa-token-state");
	Результат.СтатусТокенаСБП      = ВитринаВСервисе.Получить("sbp-token-state");
	Результат.ОстановленаОтправкаУведомлений = ВитринаВСервисе.Получить("stop-email-notify");
	Результат.ОстановленаОтправкаУведомленийПоЗаказам = ВитринаВСервисе.Получить("stop-email-orders-notify");
	
	ОрганизацияИД = ВитринаВСервисе.Получить("company-id");
	
	Если ОрганизацияИД <> Неопределено
		И Не ПустаяСтрока(ОрганизацияИД) Тогда
		Результат.Организация = ЗначениеПоИдентификатору(ОрганизацияИД,
															НастройкиУчетнойСистемы.Организация.ОграничениеТипа);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Результат.УзелОбмена = ПланыОбмена[НастройкиУчетнойСистемы.ИмяПланаОбмена].НайтиПоКоду(Результат.ИдентификаторВитрины);
	
	Если ЗначениеЗаполнено(Результат.УзелОбмена)
		И Не Маг1СИнтеграция.ЭтоУзелОбменаСВитриной(Результат.УзелОбмена) Тогда
		Результат.УзелОбмена = Неопределено;
	КонецЕсли;
	
	Результат.РежимВитрины = РежимВитриныВСервисе(ВитринаВСервисе.Получить("mode"));		
	Результат.СостояниеДоменаПользователя = ВитринаВСервисе.Получить("custom-endpoint-status"); 
	Результат.СостояниеСертификатаДоменаПользователя = ВитринаВСервисе.Получить("custom-endpoint-certificate-status"); 
	
	Если Не ПустаяСтрока(ВитринаВСервисе.Получить("custom-endpoint-certificate-expires-on")) Тогда
		Результат.СертификатДоменаПользователяИстекаетВ = Дата(ВитринаВСервисе.Получить("custom-endpoint-certificate-expires-on"));	
	КонецЕсли;
	
	Результат.ДоменПользователя = ВитринаВСервисе.Получить("custom-endpoint-fqdn"); 
	Результат.ТипСертификатаДоменаПользователя = ВитринаВСервисе.Получить("custom-endpoint-certificate-type"); 
	
	НастройкиДоменаПользователя = ВитринаВСервисе.Получить("custom-endpoint-domain-validation"); 
	
	Если ЗначениеЗаполнено(НастройкиДоменаПользователя) Тогда
		Результат.НастройкиДоменаПользователя = Маг1СИнтеграцияСлужебный.СтрокаJSONВСтруктуру(НастройкиДоменаПользователя);		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураИмениВитриныДляЗапроса(ПолноеИмяВитрины)
	
	Результат = Новый Структура;
	Результат.Вставить("fqdn", ПолноеИмяВитрины);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеНастроекВитрины(НастройкиВитрины, СистемныеНастройки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Описание = Новый Структура;
	Описание.Вставить("format_version", Маг1СИнтеграцияСлужебный.ТекущаяВерсияФорматаНастроек());
	
	ОсновныеНастройки = НастройкиВитрины.ОсновныеНастройки;
	НастройкиУведомлений = ОсновныеНастройки.НастройкиУведомлений;
	
	Самовывоз            = ОсновныеНастройки.НастройкиДоставки.Самовывоз;
	КурьерскаяДоставка   = ОсновныеНастройки.НастройкиДоставки.КурьерскаяДоставка;
	ТранспортнаяКомпания = ОсновныеНастройки.НастройкиДоставки.ТранспортнаяКомпания;
	
	СведенияОбОрганизации = Маг1СИнтеграцияСлужебный.СведенияОбОрганизации(ОсновныеНастройки);
	
	// Магазин
	Описание.Вставить("store", Новый Структура);
	// Свойства магазина
	Описание["store"].Вставить("alias",         ОсновныеНастройки.ИмяВитрины);
	Описание["store"].Вставить("domain",        ОсновныеНастройки.Домен);
	Описание["store"].Вставить("custom_domain", ОсновныеНастройки.ДоменПользователя);
	Описание["store"].Вставить("custom_domain_certificate_type", ОсновныеНастройки.ТипСертификатаДоменаПользователя);
	
	Описание["store"].Вставить("name",          ОсновныеНастройки.НазваниеМагазина);
	Описание["store"].Вставить("description",   ОсновныеНастройки.КраткоеОписаниеМагазина);
	Описание["store"].Вставить("extended_description", ОсновныеНастройки.РасширенноеОписаниеМагазина);
	
	Описание["store"].Вставить("address",       ОсновныеНастройки.АдресМагазина);
	
	Описание["store"].Вставить("phone1",            ОсновныеНастройки.ТелефонМагазина1);
	Описание["store"].Вставить("phone1_description",ОсновныеНастройки.ТелефонМагазина1Описание);
	Описание["store"].Вставить("phone2",            ОсновныеНастройки.ТелефонМагазина2);
	Описание["store"].Вставить("phone2_description",ОсновныеНастройки.ТелефонМагазина2Описание);
	Описание["store"].Вставить("phone3",            ОсновныеНастройки.ТелефонМагазина3);
	Описание["store"].Вставить("phone3_description",ОсновныеНастройки.ТелефонМагазина3Описание);
	
	Описание["store"].Вставить("messenger_max", ОсновныеНастройки.ЧатМаксМагазина);
	Описание["store"].Вставить("whatsapp",      ОсновныеНастройки.WhatsAppМагазина);
	Описание["store"].Вставить("viber",         ОсновныеНастройки.ViberМагазина);
	Описание["store"].Вставить("telegram",      ОсновныеНастройки.TelegramМагазина);
	Описание["store"].Вставить("telegram_channel", ОсновныеНастройки.TelegramКаналМагазина);
	Описание["store"].Вставить("email",         ОсновныеНастройки.EmailМагазина);
	Описание["store"].Вставить("vk",            ОсновныеНастройки.VKМагазина);
	Описание["store"].Вставить("instagram",     ОсновныеНастройки.InstagramМагазина);
	Описание["store"].Вставить("facebook",      ОсновныеНастройки.FacebookМагазина);
	Описание["store"].Вставить("bitrix24_user", ОсновныеНастройки.ЧатБитрикс24ИмяПользователяМагазина);
	Описание["store"].Вставить("bitrix24_chat", ОсновныеНастройки.ЧатБитрикс24НазваниеЧатаМагазина);
	
	Описание["store"].Вставить("working_hours", "");
	
	Описание["store"].Вставить("mode", ОсновныеНастройки.РежимВитрины);
	Описание["store"].Вставить("registration_mode", ОсновныеНастройки.РежимРегистрацииПокупателей);
	Описание["store"].Вставить("order_prefix_for_uip", НастройкиУчетнойСистемы.ПрефиксЗаказаДляУИП);
	Описание["store"].Вставить("generating_algorithm_of_uip", НастройкиУчетнойСистемы.АгоритмГеренацииУИП);
	
	Если ЗначениеЗаполнено(ОсновныеНастройки.ДанныеКартинкиЛоготипа) Тогда
		Описание["store"].Вставить("logo", ПолучитьBase64СтрокуИзДвоичныхДанных(ОсновныеНастройки.ДанныеКартинкиЛоготипа));
	Иначе
		Описание["store"].Вставить("logo", "");
	КонецЕсли;
	
	// Свойства организации
	Описание["store"].Вставить("company_id",    Строка(ОсновныеНастройки.ПараметрыУчета.Организация.УникальныйИдентификатор()));
	Описание["store"].Вставить("legal_name",    СведенияОбОрганизации.НаименованиеПолное);
	Описание["store"].Вставить("legal_address", СведенияОбОрганизации.ЮридическийАдрес);
