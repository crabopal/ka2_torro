#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#Область ОперацииСервиса

Функция ПолучитьТокенАвторизации(Знач СтруктураURI, СведенияАутентификации, ГенерироватьИсключение)
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураURI);
	
	ПараметрыАвторизации = ПараметрыАвторизацииОбщие(СтруктураURI);
	
	ПараметрыАвторизации.ТокенАвторизации.ТипТокена           = "Basic";
	ПараметрыАвторизации.ТокенАвторизации.ИдентификаторТокена = 
		Маг1СИнтеграцияСлужебный.СтрокаBase64БезBOM(СведенияАутентификации.Идентификатор + ":" + СведенияАутентификации.СекретныйКлюч);
	
	Результат = Неопределено;
	
	АдресРесурса = "/sys/token";
	
	СтрОтвета = ОбновитьТокен(ПараметрыАвторизации, АдресРесурса);
	
	Если СтрОтвета.Ответ.КодСостояния <> 200 Тогда
		СтруктураURI.ПутьНаСервере = "";
		
		АдресРесурса = "/auth/oidc/token";
		СтрОтвета = ОбновитьТокен(ПараметрыАвторизации, АдресРесурса);
	КонецЕсли;
	
	Если СтрОтвета.Ответ.КодСостояния = 200 Тогда
		СтруктураОтвета = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(СтрОтвета.Ответ.ПолучитьТелоКакСтроку());
		
		Результат = НовыйТокенАвторизации();
		Результат.ТипТокена            = СтруктураОтвета["token_type"];
		Результат.ИдентификаторТокена  = СтруктураОтвета["id_token"];
		Результат.СрокДействия         = ТекущаяУниверсальнаяДата() + 3600;
		
	ИначеЕсли ГенерироватьИсключение Тогда
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
			ПараметрыАвторизации,
			СтрОтвета.Запрос,
			СтрОтвета.Метод,
			СтрОтвета.Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбновитьТокенАвторизацииВМенеджере(ПараметрыАвторизации, МожноВзятьИзКеша, ИспользоватьКешКлючейДоступа)
	
	Если МожноВзятьИзКеша Тогда
		ТокенАвторизации = Маг1СИнтеграцияСлужебный.ПрочитатьТокенАвторизацииВМенеджере(ПараметрыАвторизации.ЛогинИПП);
	Иначе
		ТокенАвторизации = Неопределено;
	КонецЕсли;
	
	Если ТокенАвторизации <> Неопределено Тогда
		ПараметрыАвторизации.ТокенАвторизации = ТокенАвторизации;
		
		Если ПараметрыАвторизации.ОбновлятьРасширение Тогда
			Маг1СИнтеграцияСлужебный.ОбновитьРасширение(ПараметрыАвторизации);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ИспользоватьКешКлючейДоступа Тогда
		СведенияАутентификации = СведенияАутентификацииВМенеджереВитрин(ПараметрыАвторизации, Истина);
		ТокенАвторизации = ПолучитьТокенАвторизации(ПараметрыАвторизации.СтруктураURI, СведенияАутентификации, Ложь);
	КонецЕсли;
	
	Если ТокенАвторизации = Неопределено Тогда
		СведенияАутентификации = СведенияАутентификацииВМенеджереВитрин(ПараметрыАвторизации, Ложь);
		
		ТокенАвторизации = ПолучитьТокенАвторизации(ПараметрыАвторизации.СтруктураURI, СведенияАутентификации, Истина);
    КонецЕсли;
	
	Маг1СИнтеграцияСлужебный.СохранитьТокенАвторизацииВМенеджере(ПараметрыАвторизации.ЛогинИПП, ТокенАвторизации);
	ПараметрыАвторизации.ТокенАвторизации = ТокенАвторизации;
	
	Если ПараметрыАвторизации.ОбновлятьРасширение Тогда
		Маг1СИнтеграцияСлужебный.ОбновитьРасширение(ПараметрыАвторизации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьТокенАвторизацииНаВитрине(ПараметрыАвторизации, МожноВзятьИзКеша, ИспользоватьКешКлючейДоступа)
	
	Если МожноВзятьИзКеша Тогда
		ТокенАвторизации = Маг1СИнтеграцияСлужебный.ПрочитатьТокенАвторизацииНаВитрине(ПараметрыАвторизации.ИдентификаторВитрины);
	Иначе
		ТокенАвторизации = Неопределено;
	КонецЕсли;
	
	Если ТокенАвторизации <> Неопределено Тогда
		ПараметрыАвторизации.ТокенАвторизации = ТокенАвторизации;
		
		// Вызов для попытки обновления расширения
		ПараметрыАвторизацииВМенеджере = ПараметрыАвторизацииВМенеджере(ПараметрыАвторизации.ЛогинИПП);
		ПараметрыАвторизации.РасширениеОбновлено = ПараметрыАвторизацииВМенеджере.РасширениеОбновлено; 
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьКешКлючейДоступа Тогда
		СведенияАутентификации = СведенияАутентификациНаВитрине(ПараметрыАвторизации.ИдентификаторВитрины,
																ПараметрыАвторизации.ЛогинИПП,
																Истина);

		ТокенАвторизации = ПолучитьТокенАвторизации(ПараметрыАвторизации.СтруктураURI,
										     СведенияАутентификации,
											 Ложь);
	КонецЕсли;	
	
	Если ТокенАвторизации <> Неопределено Тогда
		Маг1СИнтеграцияСлужебный.СохранитьТокенАвторизацииНаВитрине(ПараметрыАвторизации.ИдентификаторВитрины,
																				ТокенАвторизации);
		ПараметрыАвторизации.ТокенАвторизации = ТокенАвторизации;
		
		// Вызов для попытки обновления расширения
		ПараметрыАвторизацииВМенеджере = ПараметрыАвторизацииВМенеджере(ПараметрыАвторизации.ЛогинИПП); 
		ПараметрыАвторизации.РасширениеОбновлено = ПараметрыАвторизацииВМенеджере.РасширениеОбновлено; 
		Возврат;
	КонецЕсли;
	
	СведенияАутентификации = СведенияАутентификациНаВитрине(ПараметрыАвторизации.ИдентификаторВитрины,
															ПараметрыАвторизации.ЛогинИПП,
															Ложь);
	
	ТокенАвторизации = ПолучитьТокенАвторизации(ПараметрыАвторизации.СтруктураURI,
											    СведенияАутентификации,
											    Истина);
	
	Маг1СИнтеграцияСлужебный.СохранитьТокенАвторизацииНаВитрине(ПараметрыАвторизации.ИдентификаторВитрины,
																			ТокенАвторизации);
	ПараметрыАвторизации.ТокенАвторизации = ТокенАвторизации;
	// В этом случае пытаться обновить расширение не нужно, т.к. это было уже сделано 
	// при вызове СведенияАутентификациНаВитрине - ПараметрыАвторизацииВМенеджере - ОбновитьТокенАвтозирацииВМенеджере 
	
КонецПроцедуры

Функция ОбновитьТокен(ПараметрыАвторизации, АдресРесурса)
	
	Метод = Маг1СПеречисления.МетодыHTTP_POST();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Запрос.УстановитьТелоИзСтроки("grant_type=client_credentials");
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Запрос", Запрос);
	СтруктураОтвета.Вставить("Метод", Метод);
	СтруктураОтвета.Вставить("Ответ", Ответ);
	Возврат СтруктураОтвета;
	
КонецФункции

Функция ПолучитьПрофильПользователя(ПараметрыАвторизации)
	
	Результат = Неопределено;
	
	АдресРесурса = "/api/v2/profile";
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		СтруктураОтвет = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		
		Результат = СтруктураПрофиляПользователя();
		Результат.ИмяПользователя = СтруктураОтвет["name"];
		Результат.ИмяДомена       = СтруктураОтвет["fqdn"];
		
		Результат.ДоступныеРесурсы.Витрины    = СтруктураОтвет["available_resources"]["stores"];
		
		Результат.ИспользуемыеРесурсы.Витрины = СтруктураОтвет["used_resources"]["stores"];
		
		ЕстьВозможностьСозданияНовойВитрины = Результат.ДоступныеРесурсы.Витрины > Результат.ИспользуемыеРесурсы.Витрины;
		Результат.ЕстьВозможностьСозданияНовойВитрины = ЕстьВозможностьСозданияНовойВитрины;
		
		Результат.ЕстьПлатныйТариф =  СтруктураОтвет["is-paid-tariff"]
		
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьИмяВитрины(ПолноеИмяВитрины, ПараметрыАвторизации)
	
	Результат = Новый Структура();
	Результат.Вставить("ИмяВалидно", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	
	АдресРесурса = "/api/v2/hostnames:checkAvailability";
	Метод        = Маг1СПеречисления.МетодыHTTP_POST();
	
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Запрос.УстановитьТелоИзСтроки(
		Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(СтруктураИмениВитриныДляЗапроса(ПолноеИмяВитрины)));
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		Результат.ИмяВалидно = Истина;
	ИначеЕсли Ответ.КодСостояния = 400
		Или Ответ.КодСостояния = 409 Тогда
		Результат.ИмяВалидно = Ложь;
		Результат.СообщениеОбОшибке = Ответ.ПолучитьТелоКакСтроку();
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДоменПользователя(ИдентификаторВитрины, ДоменПользователя, ПараметрыАвторизации)
	
	Результат = Новый Структура();
	Результат.Вставить("ИмяВалидно", Ложь);
	Результат.Вставить("НастройкиДоменаПользователя", Новый Структура);
	Результат.Вставить("СообщениеОбОшибке", "");
	
	АдресРесурса = СтрШаблон("/api/v2/stores/%1/endpoints", ИдентификаторВитрины);
	Метод        = Маг1СПеречисления.МетодыHTTP_GET();
	
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Запрос.УстановитьТелоИзСтроки(
		Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(СтруктураИмениВитриныДляЗапроса(ДоменПользователя)));
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		СтруктураОтвет = Маг1СИнтеграцияСлужебный.СтрокаJSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());
		Результат.ИмяВалидно = Истина;
		Результат.НастройкиДоменаПользователя = СтруктураОтвет;
	ИначеЕсли Ответ.КодСостояния = 400
		Или Ответ.КодСостояния = 409 Тогда
		Результат.ИмяВалидно = Ложь;
		Результат.СообщениеОбОшибке = Ответ.ПолучитьТелоКакСтроку();
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокВитрин(ПараметрыАвторизации)
	
	Результат = Новый Структура;
	
	АдресРесурса = "/api/v2/stores";
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
		
	Если Ответ.КодСостояния = 200 Тогда
		КоллекцияВитрин = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		Для Каждого ОписаниеВитрины Из КоллекцияВитрин Цикл
			СтрокаСпискаВитрин = ВитринаВСервисе(ОписаниеВитрины);
			Результат.Вставить(Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СтрокаСпискаВитрин.ИдентификаторВитрины),
								СтрокаСпискаВитрин);
		КонецЦикла;
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВитрину(ИдентификаторВитрины, ПараметрыАвторизации)
	
	Результат = Неопределено;
	
	АдресРесурса = СтрШаблон("/api/v2/stores/%1", ИдентификаторВитрины);
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Запрос.Заголовки.Вставить("Accept", "application/json");
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		Описание = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		Результат = ВитринаВСервисе(Описание);
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьВитрину(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации)
	
	Результат = Неопределено;
	

	АдресРесурса = "/api/v2/stores";
	Метод = Маг1СПеречисления.МетодыHTTP_POST();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);

	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	
	ПараметрыЗапроса = СтруктураИмениВитриныДляЗапроса(НастройкиВитрины.ОсновныеНастройки.ИмяВитрины 
														+ "."
														+ НастройкиВитрины.ОсновныеНастройки.Домен);
														
	Если ЗначениеЗаполнено(СтрокаСпискаВитрин.ИдентификаторВитрины)
		И СтрокаСпискаВитрин.ИдентификаторВитрины <> Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
		ПараметрыЗапроса.Вставить("store_id", СтрокаСпискаВитрин.ИдентификаторВитрины);													
	КонецЕсли;	
															
	ПараметрыЗапроса.Вставить("Settings", ОписаниеНастроекВитрины(НастройкиВитрины, ПараметрыАвторизации.СистемныеНастройки));													
	Запрос.УстановитьТелоИзСтроки(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ПараметрыЗапроса));
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		ВитринаВСервисе = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		
		Результат = ВитринаВСервисе(ВитринаВСервисе);
		
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьСтраницуMag1c(НастройкиВитрины, ПараметрыАвторизации)
	
	Результат = Неопределено;
	
	АдресРесурса = "/api/v2/stores";
	Метод = Маг1СПеречисления.МетодыHTTP_PUT();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);

