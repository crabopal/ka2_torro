Функция ОбновитьНастройкиВитрины(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации) Экспорт
		
	Результат  = СтрокаСпискаВитрин;
	УзелОбмена = СтрокаСпискаВитрин.УзелОбмена;
	
	Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин) Тогда
		
		ТекстИсключения = НСтр("ru = 'Витрина находится в состоянии %Состояние% обновление основных настроек невозможно.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Состояние%", СтрокаСпискаВитрин.Состояние);
		ВызватьИсключение ТекстИсключения;
		
	КонецЕсли;
	
	Описание = ОписаниеНастроекВитрины(НастройкиВитрины, ПараметрыАвторизации.СистемныеНастройки);
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Описание);
	ХешОсновныхНастроек = Base64Строка(Хеширование.ХешСумма);
	
	Если СтрокаСпискаВитрин.ХешОсновныхНастроек = ХешОсновныхНастроек Тогда
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОбновитьТокеныДоступаКПлатежнымСистемам(Результат) Тогда
			Результат = ОбновитьТокеныДоступаКПлатежнымСистемам(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	АдресРесурса = СтрШаблон("/api/v2/stores/%1/settings", СтрокаСпискаВитрин.ИдентификаторВитрины);
	Метод = Маг1СПеречисления.МетодыHTTP_PUT();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	
	Запрос.Заголовки.Вставить("Content-Type", "application/json");	
	Запрос.УстановитьТелоИзСтроки(Описание);
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		Описание = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		Результат = ВитринаВСервисе(Описание);
		Результат.УзелОбмена = УзелОбмена;
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОбновитьТокеныДоступаКПлатежнымСистемам(Результат) Тогда
		Результат = ОбновитьТокеныДоступаКПлатежнымСистемам(Результат, НастройкиВитрины, ПараметрыАвторизации);
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебный.СоздатьОбновитьОбсуждение(НастройкиВитрины, Неопределено, Ложь);

	Возврат Результат;
	
КонецФункции

