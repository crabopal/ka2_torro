Функция ПолучитьСписокТокеновСБП()
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыАвторизации = ПараметрыАвторизацииСБП();
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("scrollId", "");
	ДобавитьПараметрыАвторизацииСБП(ПараметрыЗапроса);
	
	АдресРесурса = "/mag1c/tokens/search";
	Метод        = Маг1СПеречисления.МетодыHTTP_POST();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Запрос.Заголовки.Вставить("Content-type", "application/json;charset=utf-8");
	
	Запрос.УстановитьТелоИзСтроки(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ПараметрыЗапроса));

	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Результат = Новый Массив();
	
	Если Ответ.КодСостояния = 200 Тогда
		Токены = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		
		Для каждого Токен из Токены Цикл
			ТокенСтруктура = Новый Структура();
			ТокенСтруктура.Вставить("ИдУчастникаСБП", Токен.Получить("memberId"));
			ТокенСтруктура.Вставить("ИДМерчанта", Токен.Получить("merchantId"));
			ТокенСтруктура.Вставить("ИдТокена", Токен.Получить("clientTokenId"));
			ТокенСтруктура.Вставить("ДатаПолучения", Токен.Получить("requestDate"));
			Результат.Добавить(ТокенСтруктура);
		КонецЦикла;
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
	
КонецФункции

Функция ПолучитьНовыйТокенСБП(ИДМерчанта, ИДУчастникаСБП, ДанныеАутентификацииУУчастникаСПБ, ИдТокена)
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыАвторизации = ПараметрыАвторизацииСБП();
	
	АдресРесурса = "/mag1c/tokens/request";
	Метод        = Маг1СПеречисления.МетодыHTTP_POST();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Запрос.Заголовки.Вставить("Content-type", "application/json;charset=utf-8");
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("islMemberId", ИДУчастникаСБП);
	ПараметрыЗапроса.Вставить("merchantId", ИДМерчанта);     
	ПараметрыЗапроса.Вставить("clientTokenId", ИдТокена);
	
	ПараметрыЗапроса.Вставить("apiSecretObject", ДанныеАутентификацииУУчастникаСПБ);
	
	ДобавитьПараметрыАвторизацииСБП(ПараметрыЗапроса);
	
	Запрос.УстановитьТелоИзСтроки(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ПараметрыЗапроса));
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Результат = "";
	
	Если Ответ.КодСостояния = 200 Тогда
		ОтветСоответствие = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		
		Результат = ОтветСоответствие.Получить("mag1cToken");		
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыАутентификацииСБПДляЗапросаТокена(НастройкаСБП)
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеАутентификацииУУчастникаСПБ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(НастройкаСБП);
	
	Если ТипЗнч(ДанныеАутентификацииУУчастникаСПБ) = Тип("Соответствие") Тогда
		ИдентификаторУчастника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаСБП, "ИдентификаторУчастника"); 
		ДанныеАутентификацииУУчастникаСПБ = ДанныеАутентификацииУУчастникаСПБ.Получить(ИдентификаторУчастника);
	КонецЕсли;
	
	Для каждого КлючЗначение из ДанныеАутентификацииУУчастникаСПБ Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("ДвоичныеДанные") Тогда
			ДанныеАутентификацииУУчастникаСПБ[КлючЗначение.Ключ] = ПолучитьHexСтрокуИзДвоичныхДанных(КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыАутентификацииДляЗапроса = Новый Структура("userName,password,token,key", "", "", "", "" );
	ЗаполнитьЗначенияСвойств(ПараметрыАутентификацииДляЗапроса, ДанныеАутентификацииУУчастникаСПБ); 
	
	Если ДанныеАутентификацииУУчастникаСПБ.Свойство("login") Тогда
		ПараметрыАутентификацииДляЗапроса.userName = ДанныеАутентификацииУУчастникаСПБ.login;
	КонецЕсли;
	
	Возврат ПараметрыАутентификацииДляЗапроса;
КонецФункции

