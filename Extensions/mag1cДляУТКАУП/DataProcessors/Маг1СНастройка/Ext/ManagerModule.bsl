Процедура ДобавитьПараметрыАвторизацииСБП(ПараметрыЗапроса)
	
	Результат = Новый Структура("login,password,authToken", Неопределено, Неопределено, Неопределено);
				
	ТикетАутентификации = ИнтернетПоддержкаПользователей.ТикетАутентификацииНаПорталеПоддержки(
			ИдентификаторСервисаМенеджераВитрин());
			
	Если ПустаяСтрока(ТикетАутентификации.КодОшибки) Тогда
		Результат.authToken = ТикетАутентификации.Тикет;
	ИначеЕсли ОбщегоНазначения.РазделениеВключено() Тогда
		ВызватьИсключение ТикетАутентификации.ИнформацияОбОшибке;
	Иначе
		ДанныеАутентификации = ИнтернетПоддержкаПользователей.ДанныеАутентификацииПользователяИнтернетПоддержки();
		
		Результат.login           = ДанныеАутентификации.Логин;
		Результат.password        = ДанныеАутентификации.Пароль;
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("authenticationInfo", Результат);
КонецПроцедуры

Функция ПараметрыАвторизацииСБП()
	СтруктураURI = Маг1СИнтеграцияСлужебный.СтруктураURI(Маг1СИнтеграцияСлужебный.ХостСервисаИнтеграцииСБП() + АдресКомандСБП());	
	ПараметрыАвторизации = ПараметрыАвторизацииОбщие(СтруктураURI);
