Функция ПолучитьОбновлениеРасширения(ПараметрыАвторизации, ТолькоПроверка) Экспорт
	Результат = Неопределено;
	
	АдресРесурса = "/api/v2/update";
	Метод        = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Если ТолькоПроверка Тогда
		Запрос.Заголовки.Вставить("Only-Check", ТолькоПроверка);
	КонецЕсли;
	
	ПараметрыАвторизации.ОбновлятьРасширение = Ложь;
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	ПараметрыАвторизации.ОбновлятьРасширение = Истина;
		
	Результат = Новый Структура;
	Результат.Вставить("ВерсияРасширения", "");
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("ЕстьОбновление", Ложь);
	Результат.Вставить("Уведомление", "");
	Результат.Вставить("ИмяМастерКонфигурации", "");
	
	Уведомление = Ответ.Заголовки.Получить("V8-Notification");
	
	Если ТипЗнч(Уведомление) = Тип("Строка") Тогда
		Результат.Уведомление = Уведомление;
	КонецЕсли;
	
	ИмяМастерКонфигурации = Ответ.Заголовки.Получить("AnalogueName");
	Если ТипЗнч(ИмяМастерКонфигурации) = Тип("Строка") Тогда
		Результат.ИмяМастерКонфигурации = ИмяМастерКонфигурации;
	КонецЕсли;
	
	Если Ответ.КодСостояния = 200 Тогда
		Результат.ВерсияРасширения = Ответ.Заголовки.Получить("Wizard-Version");
		Если Не ТолькоПроверка Тогда
			Результат.Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
		КонецЕсли;
		Результат.ЕстьОбновление = Истина;
	ИначеЕсли Ответ.КодСостояния = 204 Тогда 	
		Результат.ЕстьОбновление = Ложь;
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

