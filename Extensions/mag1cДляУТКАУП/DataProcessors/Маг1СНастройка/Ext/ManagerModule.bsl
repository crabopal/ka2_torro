Функция ОбновитьТокеныДоступаКПлатежнымСистемам(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации)
	ПлатежныеСистемыВитрины = Маг1СПеречисления.ПлатежныеСистемыПорядок();
	УзелОбмена  = СтрокаСпискаВитрин.УзелОбмена;
	
	Для каждого ПлатежнаяСистема из ПлатежныеСистемыВитрины Цикл
		Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОбновитьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) 
				И Не Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОтозватьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин) Тогда
			
			ТекстИсключения = НСтр("ru = 'Витрина находится в состоянии %Состояние% обновление токена доступа к %ПлатежнаяСистема% невозможно.'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Состояние%", СтрокаСпискаВитрин.Состояние);
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ПлатежнаяСистема%", ПлатежнаяСистема);
			ВызватьИсключение ТекстИсключения;
			
		КонецЕсли;
		
		Счетчик = 0;
		
		Пока Счетчик < 10 
			И Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОтозватьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Цикл
			СтрокаСпискаВитрин = ПолучитьВитрину(СтрокаСпискаВитрин.ИдентификаторВитрины, ПараметрыАвторизации);
			Счетчик = Счетчик + 1;
			Маг1СИнтеграцияСлужебный.Пауза(5);	
		КонецЦикла;
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОтозватьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Тогда
			ТекстИсключения = НСтр("ru = 'Ошибка при обновлении токена доступа к %ПлатежнаяСистема%: не удалось отозвать существующий токен.'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ПлатежнаяСистема%", ПлатежнаяСистема);
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
		
		Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОбновитьТокенДоступаКПлатежнойСистеме(СтрокаСпискаВитрин, ПлатежнаяСистема) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПлатежнаяСистема = Маг1СПеречисления.ПлатежныеСистемы_u_kassa() Тогда
			СтрокаСпискаВитрин = ОбновитьТокенДоступаКЮКассе(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации);
		ИначеЕсли ПлатежнаяСистема = Маг1СПеречисления.ПлатежныеСистемы_sbp() Тогда
			СтрокаСпискаВитрин = ОбновитьТокенДоступаКСБП(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации);
		Иначе
			ТекстИсключения = НСтр("ru = 'Не известный идентификатор платежной системы %ПлатежнаяСистема'");
			ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ПлатежнаяСистема", ПлатежнаяСистема);
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;	
			
	КонецЦикла;
	
	СтрокаСпискаВитрин.УзелОбмена = УзелОбмена;
	Возврат СтрокаСпискаВитрин;
КонецФункции

Функция ОбновитьТокенДоступаКСБП(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации)
	
	Результат   = СтрокаСпискаВитрин;
	ОсновныеНастройки = НастройкиВитрины.ОсновныеНастройки; 
	
	ПараметрыИнтеграцииСБП = Маг1СИнтеграция.ПараметрыИнтеграцииСБП(ОсновныеНастройки.НастройкаСБП);
	ДанныеАутентификацииСБП = ПараметрыАутентификацииСБПДляЗапросаТокена(ОсновныеНастройки.НастройкаСБП); 
	
	Токен = ПолучитьНовыйТокенСБП(ПараметрыИнтеграцииСБП.ИдентификаторМерчанта,
								ПараметрыИнтеграцииСБП.ИдентификаторУчастника,
								ДанныеАутентификацииСБП,
                                СтрокаСпискаВитрин.ИдентификаторВитрины);
	
	АдресРесурса = СтрШаблон("/api/v2/stores/%1/receive-payment-token", СтрокаСпискаВитрин.ИдентификаторВитрины);
	Метод        = Маг1СПеречисления.МетодыHTTP_POST();	
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);	
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("Token", Токен);
	ПараметрыЗапроса.Вставить("PaymentSystem", Маг1СПеречисления.ПлатежныеСистемы_sbp());
	
	Запрос.УстановитьТелоИзСтроки(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ПараметрыЗапроса));
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		Описание = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		Результат = ВитринаВСервисе(Описание);
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ОбновитьТокенДоступаКЮКассе(СтрокаСпискаВитрин, НастройкиВитрины, ПараметрыАвторизации)
	
	Результат   = СтрокаСпискаВитрин;
	Организация = НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация;
	
	НастройкиЮКассы = Маг1СИнтеграцияСлужебный.НастройкиЮКассы(Организация);
	
	КодОбменаТокена = ПолучитьНовыйТокенЮКассы(НастройкиЮКассы.ИдентификаторМагазина, СтрокаСпискаВитрин.ИдентификаторВитрины);
	
	АдресРесурса = СтрШаблон("/api/v2/stores/%1/receive-payment-token", СтрокаСпискаВитрин.ИдентификаторВитрины);
	Метод        = Маг1СПеречисления.МетодыHTTP_POST();	
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);	
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("exchangeCode", КодОбменаТокена);
	ПараметрыЗапроса.Вставить("PaymentSystem", Маг1СПеречисления.ПлатежныеСистемы_u_kassa());
	
	Запрос.УстановитьТелоИзСтроки(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ПараметрыЗапроса));
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		Описание = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		Результат = ВитринаВСервисе(Описание);
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ОтметитьАктивностьВитрины(СтрокаСпискаВитрин) Экспорт
	
	Результат  = СтрокаСпискаВитрин;
	УзелОбмена = Результат.УзелОбмена;
	
	Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОтметитьАктивностьВитрины(СтрокаСпискаВитрин) Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	СостониеАутентификацииИПП = Маг1СИнтеграцияСлужебный.СостояниеАутентификацииИПП();
	Если Не СостониеАутентификацииИПП.АутентификацияИППВыполнена Тогда
		ВызватьИсключение НСтр("ru = 'Невозможно отметить активность витрины, т.к. не выполнена аутентификация в интернет-поддержке пользователей.'");
	КонецЕсли;
	ПараметрыАвторизации = ПараметрыАвторизацииВМенеджере(СостониеАутентификацииИПП.ЛогинИПП);
	
	АдресРесурса = СтрШаблон("/api/v2/stores/%1/activate", СтрокаСпискаВитрин.ИдентификаторВитрины);
	Метод        = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		Описание = Маг1СИнтеграцияСлужебный.СтрокаJSONВСоответствие(Ответ.ПолучитьТелоКакСтроку());
		Результат = ВитринаВСервисе(Описание);
		Результат.УзелОбмена = УзелОбмена;
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

