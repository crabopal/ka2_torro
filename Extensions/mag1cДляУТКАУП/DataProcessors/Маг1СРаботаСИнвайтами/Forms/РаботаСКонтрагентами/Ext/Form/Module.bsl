	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован();
	
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Маг1СПеречисления.СостоянияИнвайтаПредставление(Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован()));
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить(); 
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.КонтрагентыДоговорыСостояниеИнвайта.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.КонтрагентыДоговорыСостояниеИнвайтаКолонка.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КонтрагентыДоговоры.СостояниеИнвайта");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Маг1СПеречисления.СостоянияИнвайта_НеПередан();
	
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Маг1СПеречисления.СостоянияИнвайтаПредставление(Маг1СПеречисления.СостоянияИнвайта_НеПередан()));	
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить(); 
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.КонтрагентыДоговорыСостояниеИнвайта.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.КонтрагентыДоговорыСостояниеИнвайтаКолонка.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КонтрагентыДоговоры.СостояниеИнвайта");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Маг1СПеречисления.СостоянияИнвайта_НеПолучен();
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Маг1СПеречисления.СостоянияИнвайтаПредставление(Маг1СПеречисления.СостоянияИнвайта_НеПолучен()));	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКонтрагентовИДоговорыКлиент(РезультатВыполнения, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(РезультатВыполнения) <> Тип("Структура") Тогда
		УстановитьСообщениеОбОшибке(ЭтотОбъект, НСтр("ru = 'При получении информации по инвайтам произошла ошибка.'"));
		Элементы.БаннерТребуетсяСинхронизация.Видимость = Ложь;
	Иначе
		Если РезультатВыполнения.Свойство("ПараметрыАвторизации") Тогда
			ПараметрыАвторизации = РезультатВыполнения.ПараметрыАвторизации;
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("МассивИнвайтов") Тогда
			ЗаполнитьКонтрагентовИДоговорыСервер(РезультатВыполнения.МассивИнвайтов);
			Для Каждого СтрокаДерева из КонтрагентыДоговоры.ПолучитьЭлементы() Цикл
				Элементы.КонтрагентыДоговоры.Развернуть(СтрокаДерева.ПолучитьИдентификатор());
			КонецЦикла;	
		КонецЕсли;
		
		Если РезультатВыполнения.Свойство("ТребуетсяАктуализация")
				И РезультатВыполнения.ТребуетсяАктуализация Тогда
			Элементы.БаннерТребуетсяСинхронизация.Видимость = Истина;
		Иначе
			Элементы.БаннерТребуетсяСинхронизация.Видимость = Ложь;
		КонецЕсли;
		
		УстановитьСообщениеОбОшибке(ЭтотОбъект, "");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтрагентовИДоговорыСервер(МассивИнвайтов)
	
	УстановитьПривилегированныйРежим(Истина);
	
	КонтрагентыДоговорыЭлементы = КонтрагентыДоговоры.ПолучитьЭлементы();
	
	КонтрагентыДоговорыЭлементы.Очистить();
	
	СсылкиНаИнвайты = Обработки.Маг1СОбмен.МассивИнвайтовВТаблицу(МассивИнвайтов);
	
	Запрос = Новый Запрос;
	
	Если ЕстьДоговоры Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ДополнительныеСведения.Объект КАК Контрагент,
			|	ЕСТЬNULL(СпрДоговорыКонтрагентов.Ссылка, ЗНАЧЕНИЕ(Справочник.ИмяСправочникаДоговоров.ПустаяСсылка)) КАК Договор,
			|	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.ИмяСправочникаКонтрагентов).Наименование КАК КонтрагентНаименование,
			|	ЕСТЬNULL(КонтрагентыКИ.Представление, """") КАК Телефон
			|ПОМЕСТИТЬ ВТКонтрагенты
			|ИЗ
			|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаДоговоров.ДополнительныеРеквизиты КАК СпрДоговорыКонтрагентов
			|		ПО ДополнительныеСведения.Объект = СпрДоговорыКонтрагентов.Ссылка.ИмяПоляСправочникДоговорыКонтрагент
			|			И (СпрДоговорыКонтрагентов.Свойство = &ДопРеквизитДоговора
			|				И СпрДоговорыКонтрагентов.Значение = ИСТИНА)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаКонтрагентов.КонтактнаяИнформация КАК КонтрагентыКИ
			|		ПО (ДополнительныеСведения.Объект = КонтрагентыКИ.Ссылка
			|				И КонтрагентыКИ.Вид = &ВидКИТелефон)
			|ГДЕ
			|	ДополнительныеСведения.Свойство = &ДопСвойствоКонтрагента
			|	И ДополнительныеСведения.Значение = ИСТИНА
			|	И ДополнительныеСведения.Объект ССЫЛКА Справочник.ИмяСправочникаКонтрагентов
			|	И &ТекстОтборПоКонтрагентам";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаДоговоров", Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента())); 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПоляСправочникДоговорыКонтрагент", НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.Контрагент); 
		
		ДопРеквизит = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИспользоватьДоговорДляРаботыСВебВитринойMag1c(
					НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
		
		Запрос.УстановитьПараметр("ДопРеквизитДоговора", ДопРеквизит);
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ДополнительныеСведения.Объект КАК Контрагент,
			|	НЕОПРЕДЕЛЕНО КАК Договор,
			|	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.ИмяСправочникаКонтрагентов).Наименование КАК КонтрагентНаименование,
			|	ЕСТЬNULL(КонтрагентыКИ.Представление, """") КАК Телефон
			|ПОМЕСТИТЬ ВТКонтрагенты
			|ИЗ
			|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаКонтрагентов.КонтактнаяИнформация КАК КонтрагентыКИ
			|		ПО (ДополнительныеСведения.Объект = КонтрагентыКИ.Ссылка
			|				И КонтрагентыКИ.Вид = &ВидКИТелефон)
			|ГДЕ
			|	ДополнительныеСведения.Свойство = &ДопСвойствоКонтрагента
			|	И ДополнительныеСведения.Значение = ИСТИНА
			|	И ДополнительныеСведения.Объект ССЫЛКА Справочник.ИмяСправочникаКонтрагентов
			|	И &ТекстОтборПоКонтрагентам";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СсылкиДляПроверки.Ид КАК Инвайт,
		|	СсылкиДляПроверки.Статус КАК Статус
		|ПОМЕСТИТЬ СсылкиДляПроверки
		|ИЗ
		|	&СсылкиДляПроверки КАК СсылкиДляПроверки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СсылкиДляПроверки.Инвайт КАК Инвайт,
		|	СсылкиДляПроверки.Статус КАК Статус,
		|	ЕСТЬNULL(ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка, ЗНАЧЕНИЕ(Справочник.ИмяСправочникаКонтрагентов.ПустаяСсылка)) КАК Ссылка
		|ПОМЕСТИТЬ ВТИнвайтыСсылки
		|ИЗ
		|	СсылкиДляПроверки КАК СсылкиДляПроверки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
		|		ПО СсылкиДляПроверки.Инвайт = ПубличныеИдентификаторыСинхронизируемыхОбъектов.Идентификатор
		|			И (ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелОбмена)
		|;	
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТИнвайтыСсылки.Инвайт КАК Инвайт,
		|	ВТКонтрагенты.Контрагент КАК Контрагент,
		|	ВТКонтрагенты.Договор КАК Договор,
		|	ВТКонтрагенты.Телефон КАК Телефон,
		|	ВТКонтрагенты.КонтрагентНаименование КАК КонтрагентНаименование,
		|	ЕСТЬNULL(ВТИнвайтыСсылки.Статус, """ + Маг1СПеречисления.СостоянияИнвайта_НеПередан() + """) КАК СостояниеИнвайта,
		|	ВЫБОР
		|		КОГДА ВТИнвайтыСсылки.Статус ЕСТЬ NULL
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_НеПередан() + "
		|		КОГДА ВТИнвайтыСсылки.Статус = """ + Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован() + """
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован() + "
		|		КОГДА ВТИнвайтыСсылки.Статус = """ + Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() + """
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() + "
		|		КОГДА ВТИнвайтыСсылки.Статус = """ + Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() + """
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() + "
		|		ИНАЧЕ 100
		|	КОНЕЦ КАК ПорядокСостояния
		|ИЗ
		|	ВТКонтрагенты КАК ВТКонтрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИнвайтыСсылки КАК ВТИнвайтыСсылки
		|		ПО ВТКонтрагенты.Контрагент = ВТИнвайтыСсылки.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТИнвайтыСсылки.Инвайт,
		|	ВТИнвайтыСсылки.Ссылка,
		|	НЕОПРЕДЕЛЕНО,
		|	ЕСТЬNULL(КонтрагентыКИ.Представление, """"),
		|	"""",
		|	ВЫБОР 
		|		КОГДА ВТИнвайтыСсылки.Ссылка = ЗНАЧЕНИЕ(Справочник.ИмяСправочникаКонтрагентов.ПустаяСсылка)
		|			ТОГДА """ + Маг1СПеречисления.СостоянияИнвайта_НеПолучен() + """
		|		ИНАЧЕ
		|			ВТИнвайтыСсылки.Статус
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ВТИнвайтыСсылки.Ссылка = ЗНАЧЕНИЕ(Справочник.ИмяСправочникаКонтрагентов.ПустаяСсылка)
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_НеПолучен() + "
		|		КОГДА ВТИнвайтыСсылки.Статус = """ + Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован() + """
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован() + "
		|		КОГДА ВТИнвайтыСсылки.Статус = """ + Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() + """
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() + "
		|		КОГДА ВТИнвайтыСсылки.Статус = """ + Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() + """
		|			ТОГДА ТекстПорядок" + Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() + "
		|		ИНАЧЕ 100
		|	КОНЕЦ
		|ИЗ
		|	ВТИнвайтыСсылки КАК ВТИнвайтыСсылки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКонтрагенты КАК ВТКонтрагенты
		|		ПО ВТИнвайтыСсылки.Ссылка = ВТКонтрагенты.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаКонтрагентов.КонтактнаяИнформация КАК КонтрагентыКИ
		|		ПО (ВТИнвайтыСсылки.Ссылка = КонтрагентыКИ.Ссылка
		|				И КонтрагентыКИ.Вид = &ВидКИТелефон)
		|ГДЕ
		|	ВТКонтрагенты.Контрагент ЕСТЬ NULL
		|	И (&ПоказатьНеПолученных
		|		ИЛИ ВТИнвайтыСсылки.Ссылка В (&ОтборПоКонтрагентам))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокСостояния,
		|	КонтрагентНаименование
		|ИТОГИ ПО
		|	СостояниеИнвайта";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаКонтрагентов", 
								Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы,
																Маг1СПеречисления.ИменаСправочников_Контрагент())); 
	
	ПорядокСостояний = Маг1СПеречисления.СостоянияИнвайтаПорядок();
	
	Инд = 0;
	Для Каждого СтрМас из ПорядокСостояний Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекстПорядок" + СтрМас, Строка(Инд));
		
		Инд = Инд + 1;
	КонецЦикла;
	
	Если КонтрагентыПриОткрытии.Количество() = 0 Тогда
		ТекстОтборПоКонтрагентам = "ИСТИНА" 	
	Иначе
		ТекстОтборПоКонтрагентам = "ДополнительныеСведения.Объект В (&ОтборПоКонтрагентам)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстОтборПоКонтрагентам", ТекстОтборПоКонтрагентам);
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ПоказатьНеПолученных", КонтрагентыПриОткрытии.Количество() = 0);
	Запрос.УстановитьПараметр("ОтборПоКонтрагентам", КонтрагентыПриОткрытии);
	Запрос.УстановитьПараметр("ДопСвойствоКонтрагента", Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоКонтрагента(ИдентификаторВитрины));
	Запрос.УстановитьПараметр("СсылкиДляПроверки", СсылкиНаИнвайты);
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	Запрос.УстановитьПараметр("ВидКИТелефон", Маг1СИнтеграцияСлужебныйПовтИсп.ВидКИТелефонMag1c());
	
	ВыборкаПоСостояниям = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоСостояниям.Следующий() Цикл
		
		ЭлементДереваСостояние = КонтрагентыДоговорыЭлементы.Добавить();
		ЭлементДереваСостояние.СостояниеИнвайта = ВыборкаПоСостояниям.СостояниеИнвайта;
		ЭлементДереваСостояние.ЭтоГруппировка     = Истина;
		
		ВыборкаПоИнвайтам = ВыборкаПоСостояниям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ЭлементДереваСостояниеЭлементы = ЭлементДереваСостояние.ПолучитьЭлементы(); 
		Пока ВыборкаПоИнвайтам.Следующий() Цикл
			
			ЭлементДереваИнвайт = ЭлементДереваСостояниеЭлементы.Добавить();
			ЗаполнитьЗначенияСвойств(ЭлементДереваИнвайт, ВыборкаПоИнвайтам);
			
		КонецЦикла;
		
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИнформациюПоИнвайтам(Действие)
	
	ПараметрыПомощника = Новый Структура;
	ПараметрыПомощника.Вставить("НастройкиВитрины", НастройкиВитрины);
	ПараметрыПомощника.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ПараметрыПомощника.Вставить("Действие", Действие);
	ПараметрыПомощника.Вставить("ЕстьКОбмену", Действие = Маг1СПеречисления.ДействияФормыОбмена_ОбменОтменаРегистрацииСписокИнвайтов());	
	ПараметрыПомощника.Вставить("ЗакрытьПриУспехе", Истина);
	ПараметрыПомощника.Вставить("ЖдатьОкончанияТекущегоОбмена", Истина);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьКонтрагентовИДоговорыКлиент", ЭтотОбъект); 
	
	ОткрытьФорму("Обработка.Маг1СОбмен.Форма.ВыполнениеОбмена",
					ПараметрыПомощника,
					ЭтотОбъект,
					,
					,
					,
					ОписаниеОповещения,
					 );
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСинхронизацииСВитриной(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина
		И ДополнительныеПараметры.ДействиеПослеСохранения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПослеСохранения, ДополнительныеПараметры.ПараметрыДействия);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиДобавитьСтрокуСостояния(СостояниеИнвайта, КонтрагентыДоговоры)
	
	СтрокаСостояния = Неопределено;
	
	ЭлементыДерева = КонтрагентыДоговоры.ПолучитьЭлементы();
	
	ПорядокСостояний = Маг1СПеречисления.СостоянияИнвайтаПорядок();
	ПорядокИскомого = ПорядокСостояний.Найти(СостояниеИнвайта);
	
	Для Каждого ЭлементДерева из ЭлементыДерева Цикл
		Если ЭлементДерева.СостояниеИнвайта = СостояниеИнвайта Тогда
			СтрокаСостояния = ЭлементДерева;
			Прервать;
		КонецЕсли;
		
		ПорядокТекущего = ПорядокСостояний.Найти(ЭлементДерева.СостояниеИнвайта);
		Если ПорядокТекущего < ПорядокИскомого Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаСостояния = ЭлементыДерева.Вставить(ПорядокТекущего - 1);
		Прервать;
		
	КонецЦикла;
	
	Если СтрокаСостояния = Неопределено Тогда
		СтрокаСостояния = ЭлементыДерева.Добавить();
	КонецЕсли;
	
	СтрокаСостояния.СостояниеИнвайта = СостояниеИнвайта;
	СтрокаСостояния.ЭтоГруппировка     = Истина;
	
	Возврат СтрокаСостояния;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НайтиСтрокуКонтрагента(Контрагент, КонтрагентыДоговоры)
	
	ЭлементыСостояний = КонтрагентыДоговоры.ПолучитьЭлементы();
	
	Для Каждого СтрокаСостояния из ЭлементыСостояний Цикл
		
		ЭлементыКонтрагентов = СтрокаСостояния.ПолучитьЭлементы();
		
		Для Каждого СтрокаКонтрагента из ЭлементыКонтрагентов Цикл
			Если СтрокаКонтрагента.Контрагент = Контрагент Тогда
				Возврат СтрокаКонтрагента;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПереместитьУдалитьСтрокуКонтрагента(ТекущаяСтрока, КонтрагентыДоговоры, НовоеСостояниеИнвайта)
	
	Если Не ПустаяСтрока(НовоеСостояниеИнвайта) Тогда
		СтрокаНовогоСостояния = НайтиДобавитьСтрокуСостояния(НовоеСостояниеИнвайта, КонтрагентыДоговоры);
		НоваяСтрока = СтрокаНовогоСостояния.ПолучитьЭлементы().Вставить(0);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.СостояниеИнвайта = НовоеСостояниеИнвайта;
	КонецЕсли;
	
	ТекущийРодитель = ТекущаяСтрока.ПолучитьРодителя(); 
	ЭлементыТекущейСтроки = ТекущийРодитель.ПолучитьЭлементы();
	ЭлементыТекущейСтроки.Удалить(ТекущаяСтрока);
	
	Если ЭлементыТекущейСтроки.Количество() = 0 Тогда
		КонтрагентыДоговоры.ПолучитьЭлементы().Удалить(ТекущийРодитель);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуКонтрагентыДоговоры(ВыбранныйЭлементКонтрагент)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ВыбранныйЭлементКонтрагент) <> ТипЗнч(НастройкиУчетнойСистемы.Контрагент.Значение) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаКонтрагента = НайтиСтрокуКонтрагента(ВыбранныйЭлементКонтрагент, КонтрагентыДоговоры);
	
	Если СтрокаКонтрагента = Неопределено Тогда
		
		СтрокаНеПередан = НайтиДобавитьСтрокуСостояния(Маг1СПеречисления.СостоянияИнвайта_НеПередан(), КонтрагентыДоговоры);
		
		СтрокаКонтрагента = СтрокаНеПередан.ПолучитьЭлементы().Вставить(0);
		СтрокаКонтрагента.Контрагент = ВыбранныйЭлементКонтрагент;
		СтрокаКонтрагента.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан();
		СтрокаКонтрагента.Инвайт = Строка(ВыбранныйЭлементКонтрагент.УникальныйИдентификатор());
		
		Маг1СИнтеграция.СделатьКонтрагентомВитрины(СтрокаКонтрагента.Контрагент, ИдентификаторВитрины);
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ВыбранныйЭлементКонтрагент);
		
		Если ЕстьДоговоры Тогда
			СтрокаКонтрагента.Договор = Маг1СИнтеграцияСлужебный.ДоговорПоУмолчаниюПоКонтрагенту(СтрокаКонтрагента.Контрагент,
																				НастройкиВитрины,
																				НастройкиУчетнойСистемы);
																				
			Если ЗначениеЗаполнено(СтрокаКонтрагента.Договор) Тогда
				Если Маг1СИнтеграцияСлужебныйВызовСервера.ЕстьПроблемаСНДСВВидеЦенДоговора(СтрокаКонтрагента.Договор,
																							НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация) Тогда
					СтрокаКонтрагента.Договор = Неопределено;
				Иначе
					Маг1СИнтеграция.ИзменитьОтметкуДоговорВитрины(СтрокаКонтрагента.Договор,
																НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ТекстСообщения = НСтр("ru = 'Покупатель %Покупатель уже есть в списке'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,"%Покупатель", СтрокаКонтрагента.Контрагент); 
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Элементы.КонтрагентыДоговоры.ТекущаяСтрока = СтрокаКонтрагента.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИнвайтыКлиент(Результат, Контрагенты) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Отказ Тогда
		УстановитьСообщениеОбОшибке(ЭтотОбъект, Результат.СообщениеОбОшибке);
		Возврат;
	Иначе
		ЗаполнитьКонтрагентовИДоговорыКлиент(Результат);
	КонецЕсли;
	
	Если Контрагенты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьТекстыИнвайтов(Контрагенты);
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаИнвайты; 
	Элементы.ДекорацияНадписьАдресВебВитрины.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьТекстыИнвайтов(Контрагенты)
	
	ТабДокИнвайты = Обработки.Маг1СРаботаСИнвайтами.СформироватьТекстыИнвайтов(Контрагенты, НастройкиВитрины);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСохраненияПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	
	ЗакрытьФормуБезусловно = Истина;
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ИдентификаторВитриныПриИзмененииСервер()
	
	НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(ИдентификаторВитрины);
	НастройкиВитриныПриИзмененииСервер();
	
КонецПроцедуры

&НаСервере
Процедура НастройкиВитриныПриИзмененииСервер()
	
	КонтрагентыДоговоры.ПолучитьЭлементы().Очистить();
	
	ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(ИдентификаторВитрины);
	
	Если ПараметрыАвторизации.РасширениеОбновлено Тогда
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПерезапускПрограммы;
		Элементы.ДекорацияНадписьАдресВебВитрины.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	
	УстановитьУсловноеОформление();
	
	Элементы.ДекорацияНадписьАдресВебВитрины.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = 'В этом списке покупатели витрины <a href=""%1"">%2</a>'"),
		НастройкиВитрины.ОсновныеНастройки.АдресСайтаВитрины,
		НастройкиВитрины.ОсновныеНастройки.ПолноеИмяВитрины);
		
	Если НастройкиВитрины.ОсновныеНастройки.РежимВитрины = Маг1СПеречисления.РежимыВитрины_Открытый() Тогда
		Элементы.ДекорацияНачало1.Заголовок = НСтр("ru = 'Покупатели могут самостоятельно регистрироваться на витрине при оформлении заказов - тогда в справочнике будет создан новый покупатель.'");
	Иначе
		Элементы.ДекорацияНачало1.Заголовок = НСтр("ru = 'Покупатели могут регистрироваться только по инвайтам, которые получены в этой форме.'");
	КонецЕсли;
	
	УстановитьСообщениеОбОшибке(ЭтотОбъект, "");
	
КонецПроцедуры

&НаКлиенте
Процедура КВыборуВитриныКлиент(Результат = Неопределено, ДополнительныеПараметры = Неопределено)
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВыборВитрины;
	Элементы.Далее.КнопкаПоУмолчанию       = Истина;
	Элементы.Далее.Заголовок = "Далее";
	Элементы.ДекорацияНадписьАдресВебВитрины.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КОсновнойСтраницеКлиент()
	
	Для Каждого СтрМас из КонтрагентыПриОткрытии Цикл
		ДобавитьСтрокуКонтрагентыДоговоры(СтрМас);
	КонецЦикла;
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаОсновная;
	Элементы.ДекорацияНадписьАдресВебВитрины.Видимость = Истина;
	Элементы.Далее.Заголовок = "Синхронизировать данные с веб-витриной";
	
	ПолучитьИнформациюПоИнвайтам(Маг1СПеречисления.ДействияФормыОбмена_СписокИнвайтов());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьДоступЗавершение(Результат, ИдентификаторТекущейСтроки) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗапретитьДоступСервер(ИдентификаторТекущейСтроки) Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">При выполнении операции произошла ошибка</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	Иначе
		ТекстСообщения = НСтр("ru = 'Доступ запрещен'");
		Пояснение      = НСтр("ru = 'Для возобновления доступа получите и заново перейдайте покупателю инвайт для повторной регистрации на витрине.'");
		ПоказатьОповещениеПользователя(ТекстСообщения,,Пояснение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапретитьДоступСервер(ИдентификаторТекущейСтроки)
	
	УстановитьСообщениеОбОшибке(ЭтотОбъект, "");
	ТекущиеДанные = КонтрагентыДоговоры.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	НовоеСостояние = "";
	Попытка
		
		Если ТекущиеДанные.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован()
			Или ТекущиеДанные.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован() Тогда
			
			Обработки.Маг1СОбмен.ОтозватьИнвайт(ПараметрыАвторизации, ТекущиеДанные.Инвайт);
			НовоеСостояние = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен();
		КонецЕсли;
		
		Маг1СИнтеграция.СнятьОтметкуКонтрагентВитрины(ТекущиеДанные.Контрагент, ИдентификаторВитрины);
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ТекущиеДанные.Контрагент);
		ТекущиеДанные.Договор = Неопределено;
		
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		УстановитьСообщениеОбОшибке(ЭтотОбъект, КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_УправлениеИнвайтами(),
									УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
		Возврат Ложь;
	КонецПопытки;
	
	ПереместитьУдалитьСтрокуКонтрагента(ТекущиеДанные, КонтрагентыДоговоры, НовоеСостояние);
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция КонтрагентыДоговорыДоговорПриИзмененииНаСервере(Контрагент, Договор, НастройкиВитрины)
	
	Если Маг1СИнтеграцияСлужебныйВызовСервера.ЕстьПроблемаСНДСВВидеЦенДоговора(Договор, 
									НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В выбранном договоре указан вид цен, в котором настроено, что цены не включают НДС. Цены, выгружаемые на витрину должны включать НДС. Измените вид цены в договоре или очистите его.'"));
		
		Возврат Ложь;
	КонецЕсли;
	
	ИдентификаторВитрины    = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	Если Не ЗначениеЗаполнено(Договор) Тогда
		ДоговорСтруктура = Маг1СИнтеграция.ДоговорВидЦенВитрины(Контрагент, ИдентификаторВитрины);
		Если ДоговорСтруктура <> Неопределено Тогда
			Маг1СИнтеграция.ИзменитьОтметкуДоговорВитрины(ДоговорСтруктура.Договор,
				ИдентификаторВитрины,
				Ложь);
		КонецЕсли;
	Иначе
		Маг1СИнтеграция.ИзменитьОтметкуДоговорВитрины(Договор,
													ИдентификаторВитрины,
													Истина);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСообщениеОбОшибке(Форма, ТекстОшибки)
	
