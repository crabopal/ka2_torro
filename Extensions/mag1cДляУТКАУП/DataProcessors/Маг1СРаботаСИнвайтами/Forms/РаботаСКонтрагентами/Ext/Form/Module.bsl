&НаКлиенте
Перем КонтрагентПередРедактированием;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
	
	Для Каждого КлючЗначение из СписокВитрин Цикл
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(КлючЗначение.Значение) Тогда
			Элементы.ИдентификаторВитрины.СписокВыбора.Добавить(КлючЗначение.Значение.ИдентификаторВитрины,
															  КлючЗначение.Значение.ПолноеИмяВитрины);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Элементы.ИдентификаторВитрины.СписокВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.БаннерТребуетсяСинхронизация.Видимость = Ложь;
	Элементы.ДекорацияНадписьАдресВебВитрины.Видимость = Ложь;
	
	Если Параметры.НастройкиУчетнойСистемы <> Неопределено Тогда
		НастройкиУчетнойСистемы = Параметры.НастройкиУчетнойСистемы;
	Иначе
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	КонецЕсли;
	
	ЕстьДоговоры = Маг1СИнтеграция.ЕстьДоговорыКонтрагентов(НастройкиУчетнойСистемы);

	Элементы.КонтрагентыДоговорыКонтрагент.ПараметрыВыбора = 
		Маг1СИнтеграция.ВФиксМассивПараметровВыбора(НастройкиУчетнойСистемы.Контрагент.ПараметрыВыбора);
		
	ЗначениеНастройки = ОбщегоНазначения.ХранилищеНастроекДанныхФормЗагрузить("Обработка.Маг1СРаботаСИнвайтами.Форма.РаботаСКонтрагентами",
																			"ПоказатьПодсказку",
																			Неопределено);
	Если Не ТипЗнч(ЗначениеНастройки) = Тип("Булево") Тогда
		ПоказатьПодсказку = Истина;
		ОбщегоНазначения.ХранилищеНастроекДанныхФормСохранить("Обработка.Маг1СРаботаСИнвайтами.Форма.РаботаСКонтрагентами",
																			"ПоказатьПодсказку",
																			Ложь);
	Иначе
		ПоказатьПодсказку = ЗначениеНастройки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(НастройкиУчетнойСистемы.ДоговорКонтрагента.РасширеннаяПодсказка) Тогда
		Элементы.ДекорацияПродолжение.Заголовок = НастройкиУчетнойСистемы.ДоговорКонтрагента.РасширеннаяПодсказка;
	Иначе
		Элементы.ДекорацияПродолжение.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.КонтрагентыДоговорыДоговор.Видимость = ЕстьДоговоры;
	
	Если ЕстьДоговоры Тогда
		МетаданныеСправочникаДоговоры = НастройкиУчетнойСистемы.ДоговорКонтрагента.ОграничениеТипа.ПривестиЗначение().Метаданные();
		Элементы.КонтрагентыДоговорыДоговор.Заголовок = МетаданныеСправочникаДоговоры.ПредставлениеОбъекта;
		Элементы.КонтрагентыДоговорыДоговор.ОграничениеТипа = НастройкиУчетнойСистемы.ДоговорКонтрагента.ОграничениеТипа;
		Элементы.КонтрагентыДоговорыДоговор.ВыбиратьТип = Ложь;
	КонецЕсли;
	
	ИмяСправочникаКонтрагент = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы,
																Маг1СПеречисления.ИменаСправочников_Контрагент());
	Если ЕстьДоговоры Тогда
		ИмяСправочникаДоговор    = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента());
	КонецЕсли;
	
	Если Параметры.НастройкиВитрины <> Неопределено Тогда 
		
		НастройкиВитрины     = Параметры.НастройкиВитрины;
		ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
		
	ИначеЕсли Элементы.ИдентификаторВитрины.СписокВыбора.Количество() = 1 Тогда
		
		ИдентификаторВитрины = Элементы.ИдентификаторВитрины.СписокВыбора[0].Значение;
		НастройкиВитрины     = Маг1СИнтеграция.НастройкиВитрины(ИдентификаторВитрины);
		
	КонецЕсли;
		
	Если ТипЗнч(Параметры.Контрагенты) = Тип("Массив") Тогда
		КонтрагентыПриОткрытии = Новый ФиксированныйМассив(Параметры.Контрагенты);
	Иначе
		КонтрагентыПриОткрытии = Новый ФиксированныйМассив(Новый Массив());
	КонецЕсли;
	
	УстановитьСообщениеОбОшибке(ЭтотОбъект, "");
	
	Если НастройкиВитрины <> Неопределено Тогда
		НастройкиВитриныПриИзмененииСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Элементы.ИдентификаторВитрины.СписокВыбора.Количество() = 0 Тогда
		Закрыть();
		Маг1СИнтеграцияСлужебныйКлиент.ОбработкаКомандыОткрытьФормуПолученияИнформацииПоПрофилю();
		Возврат;
	КонецЕсли;
	
	Если НастройкиВитрины <> Неопределено Тогда
		КОсновнойСтраницеКлиент();
	Иначе
		КВыборуВитриныКлиент();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодборКонтрагентов(Команда)
	
	ДобавитьКонтрагента(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонтрагента(МножественныйВыбор)
	
	ПараметрыФормыВыбора = Новый Структура();
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", МножественныйВыбор);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Не МножественныйВыбор);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	
	Если НастройкиУчетнойСистемы.Контрагент.ПараметрыВыбора.Количество() > 0 Тогда
		ПараметрыФормыВыбора.Вставить("Отбор", Новый Структура);	
		Для Каждого ПараметрВыбора из НастройкиУчетнойСистемы.Контрагент.ПараметрыВыбора Цикл
			ПараметрыФормыВыбора.Отбор.Вставить(СтрЗаменить(ПараметрВыбора.Имя, "Отбор.", ""), ПараметрВыбора.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ОткрытьФорму("Справочник." + ИмяСправочникаКонтрагент + ".ФормаВыбора",
					ПараметрыФормыВыбора,
					Элементы.КонтрагентыДоговоры,
					,
					,
					,
					,
					 );
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИнвайты(Команда)
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		СтрокиОбработки = Элементы.КонтрагентыДоговоры.ПолучитьСтрокиДляОбработки();
	Иначе
		СтрокиОбработки = Элементы.КонтрагентыДоговоры.ВыделенныеСтроки;
	КонецЕсли;
	
	Если СтрокиОбработки.Количество() = 0 Тогда
		
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выберите покупателей, для которых вы хотите получить инвайты</span>'"));
			
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ЕстьКОбмену                  = Ложь;
	КОтменеРегистрации           = Новый Массив;
	КоличествоЗарегистрированные = 0;
	
	Контрагенты = Новый Массив;
	
	Для каждого СтрМас из СтрокиОбработки Цикл
		
		СтрокаТЧ = КонтрагентыДоговоры.НайтиПоИдентификатору(СтрМас);
		Если СтрокаТЧ.ЭтоГруппировка Тогда
			СтрокаТЧЭлементы = СтрокаТЧ.ПолучитьЭлементы();
		КонецЕсли;
		
		Если СтрокаТЧ.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
			ЕстьКОбмену = Истина;
		ИначеЕсли СтрокаТЧ.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
			Если СтрокаТЧ.ЭтоГруппировка Тогда
				КоличествоЗарегистрированные = КоличествоЗарегистрированные + СтрокаТЧЭлементы.Количество();
			Иначе
				КоличествоЗарегистрированные = КоличествоЗарегистрированные + 1;
			КонецЕсли;
		ИначеЕсли СтрокаТЧ.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПолучен() Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЧ.ЭтоГруппировка Тогда
			Для Каждого СтрМас из СтрокаТЧЭлементы Цикл
				Описание = Новый Структура("Контрагент,Инвайт,СостояниеИнвайта", 
														СтрМас.Контрагент,
														СтрМас.Инвайт,
														СтрМас.СостояниеИнвайта);
				Контрагенты.Добавить(Описание);
				Если СтрМас.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен()
					Или СтрМас.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
					КОтменеРегистрации.Добавить(Описание);
					Если СтрМас.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
						ЕстьКОбмену = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Описание = Новый Структура("Контрагент, Инвайт, СостояниеИнвайта",
													СтрокаТЧ.Контрагент, 
													СтрокаТЧ.Инвайт,
													СтрокаТЧ.СостояниеИнвайта);
			Контрагенты.Добавить(Описание);
			Если СтрокаТЧ.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен()
				Или СтрокаТЧ.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
				
				КОтменеРегистрации.Добавить(Описание);
				
				Если СтрокаТЧ.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
					ЕстьКОбмену = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Контрагенты", Контрагенты);
	ДополнительныеПараметры.Вставить("ЕстьКОбмену", ЕстьКОбмену);
	ДополнительныеПараметры.Вставить("КОтменеРегистрации", КОтменеРегистрации);
	
	Если КоличествоЗарегистрированные > 0 Тогда
		
		Если КоличествоЗарегистрированные = 1 Тогда
			ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Вы выделили покупателя, который уже зарегистрировался на витрине. После получения инвайта регистрация покупателя будет отменена. Для доступа к витрине ему нужно будет регистрироваться заново.</span>'"));
		Иначе
			ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Вы выделили %КоличествоЗарегистрированные, которые уже зарегистрировались на витрине. После получения инвайтов регистрация этих покупателей будет отменена. Для доступа к витрине им нужно будет регистрироваться заново.</span>'"));
			
			КоличествоЗарегистрированныеСтрокой = СтрокаСЧислом("ru = '; покупатель; ; покупателя; покупателей; покупателя'",
												КоличествоЗарегистрированные,
												ВидЧисловогоЗначения.Количественное);
			ТекстПредупреждения = СтрЗаменить(ТекстПредупреждения, "%КоличествоЗарегистрированные", КоличествоЗарегистрированныеСтрокой);
		КонецЕсли;
			
		ОписаниеОповещения = Новый ОписаниеОповещения("СинхронизироватьСВитринойИПолучитьИнвайты", ЭтотОбъект, ДополнительныеПараметры);
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Отменить регистрацию на витрине и получить инвайты'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ПоказатьВопрос(ОписаниеОповещения,ТекстПредупреждения, Кнопки,,КодВозвратаДиалога.Отмена);
		
		Возврат;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.ЕстьКОбмену
		Или ДополнительныеПараметры.КОтменеРегистрации.Количество() > 0 Тогда
		СинхронизироватьСВитринойИПолучитьИнвайты(КодВозвратаДиалога.Да, ДополнительныеПараметры);
	Иначе
		ПолучитьИнвайтыКлиент(Новый Структура("Отказ", Ложь), Контрагенты);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьСВитринойИПолучитьИнвайты(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПомощника = Новый Структура;
	ПараметрыПомощника.Вставить("НастройкиВитрины", НастройкиВитрины);
	ПараметрыПомощника.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ПараметрыПомощника.Вставить("Действие", Маг1СПеречисления.ДействияФормыОбмена_ОбменОтменаРегистрацииСписокИнвайтов());
	ПараметрыПомощника.Вставить("ЗакрытьПриУспехе", Истина);
	ПараметрыПомощника.Вставить("ЖдатьОкончанияТекущегоОбмена", Истина);
	ПараметрыПомощника.Вставить("ЕстьКОбмену", ДополнительныеПараметры.ЕстьКОбмену);
	ПараметрыПомощника.Вставить("КОтменеРегистрации", ДополнительныеПараметры.КОтменеРегистрации);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьИнвайтыКлиент", ЭтотОбъект, ДополнительныеПараметры.Контрагенты); 
	
	ОткрытьФорму("Обработка.Маг1СОбмен.Форма.ВыполнениеОбмена",
					ПараметрыПомощника,
					ЭтотОбъект,
					,
					,
					,
					ОписаниеОповещения,
					 );
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаОсновная;
	Элементы.ДекорацияНадписьАдресВебВитрины.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьДоступ(Команда)
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		СтрокиОбработки = Элементы.КонтрагентыДоговоры.ПолучитьСтрокиДляОбработки();
	Иначе
		СтрокиОбработки = Элементы.КонтрагентыДоговоры.ВыделенныеСтроки;
	КонецЕсли;
	
	Если СтрокиОбработки.Количество() = 0 Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выделите покупателя, которому нужно запретить доступ к витрине</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если СтрокиОбработки.Количество() > 1 Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выделите только одного покупателя, которому нужно запретить доступ</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если Элементы.КонтрагентыДоговоры.ТекущиеДанные.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.КонтрагентыДоговоры.ТекущиеДанные.ЭтоГруппировка Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выделите покупателя, которому нужно запретить доступ</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если Элементы.КонтрагентыДоговоры.ТекущиеДанные.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПолучен() Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Запретить доступ можно только покупателяю, информация о котором уже загружена в систему</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекущейСтроки = Элементы.КонтрагентыДоговоры.ТекущиеДанные.ПолучитьИдентификатор();
	
	Если Элементы.КонтрагентыДоговоры.ТекущиеДанные.СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
