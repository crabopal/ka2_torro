		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Покупатель уже зарегистрировался на витрине. После запрета, он не сможет использовать витрину. Если потом нужно будет разрешить доступ, то нужно будет получить инвайт, передать его покупателю, чтобы он зарегистрировался на витрине повторно.</span>'"));
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Запретить доступ'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстПредупреждения, Кнопки,,КодВозвратаДиалога.Отмена); 
		Возврат;
	КонецЕсли;
	
	ЗапретитьДоступЗавершение(КодВозвратаДиалога.Да, ИдентификаторТекущейСтроки);
	
КонецПроцедуры

