#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимФормы = Параметры.РежимФормы;
	
	Если Параметры.СтрокаСпискаВитрин = Неопределено Тогда
		
		СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
		
		Для Каждого КлючЗначение из СписокВитрин Цикл
			
			Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(КлючЗначение.Значение) Тогда
				Элементы.ИдентификаторВитрины.СписокВыбора.Добавить(КлючЗначение.Значение.ИдентификаторВитрины,
																	КлючЗначение.Значение.ПолноеИмяВитрины);
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(Параметры.СтрокаСпискаВитрин) Тогда
			Элементы.ИдентификаторВитрины.СписокВыбора.Добавить(Параметры.СтрокаСпискаВитрин.ИдентификаторВитрины,
																Параметры.СтрокаСпискаВитрин.ПолноеИмяВитрины);
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.ИдентификаторВитрины.СписокВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы  = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	ИмяСправочникаКонтрагент = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Контрагент());
	
	Если ТипЗнч(Параметры.Контрагент) = Тип("Массив") Тогда
		ПараметрыВыбораКонтрагента = НастройкиУчетнойСистемы.Контрагент.ПараметрыВыбора;
		ПараметрыВыбораКонтрагента.Добавить(Маг1СИнтеграция.ПараметрВыбораСтруктура("Отбор.Ссылка", новый ФиксированныйМассив(Параметры.Контрагент)));
		
		Элементы.Контрагент.ПараметрыВыбора = Маг1СИнтеграция.ВФиксМассивПараметровВыбора(ПараметрыВыбораКонтрагента);
		Контрагент = НастройкиУчетнойСистемы.Контрагент.Значение;
	Иначе
		Контрагент = Параметры.Контрагент;
		Элементы.Контрагент.ПараметрыВыбора = Маг1СИнтеграция.ВФиксМассивПараметровВыбора(НастройкиУчетнойСистемы.Контрагент.ПараметрыВыбора);
	КонецЕсли;
	
	ЕстьДоговоры = Маг1СИнтеграция.ЕстьДоговорыКонтрагентов(НастройкиУчетнойСистемы);
	Элементы.Договор.Видимость = ЕстьДоговоры;
	
	Если ЕстьДоговоры Тогда
		МетаданныеСправочникаДоговоры = НастройкиУчетнойСистемы.ДоговорКонтрагента.ОграничениеТипа.ПривестиЗначение().Метаданные();
		Элементы.Договор.Заголовок = МетаданныеСправочникаДоговоры.ПредставлениеОбъекта;
		ИмяСправочникаДоговор    = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента());
		Элементы.Договор.ОграничениеТипа = НастройкиУчетнойСистемы.ДоговорКонтрагента.ОграничениеТипа;
		Элементы.Договор.ВыбиратьТип = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиУчетнойСистемы.ДоговорКонтрагента.РасширеннаяПодсказка) Тогда
		Элементы.ДекорацияКонтрагентПродолжение.Заголовок = НастройкиУчетнойСистемы.ДоговорКонтрагента.РасширеннаяПодсказка;
	Иначе
		Элементы.ДекорацияКонтрагентПродолжение.Видимость = Ложь;
	КонецЕсли;
		
	Если Элементы.ИдентификаторВитрины.СписокВыбора.Количество() = 1 Тогда
		ИдентификаторВитрины = Элементы.ИдентификаторВитрины.СписокВыбора[0].Значение;
		ИдентификаторВитриныПриИзмененииСервер();
	Иначе
		НастроитьПоСостояниюИнвайта(ЭтотОбъект);
	КонецЕсли;
	
	Элементы.ДекорацияИнвайтОписание.Видимость = РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин();
	Элементы.ИдентификаторВитрины.КнопкаВыпадающегоСписка = Элементы.ИдентификаторВитрины.СписокВыбора.Количество() > 1;
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
		Заголовок = НСтр("ru = 'Получение инвайта для витрины mag1c'"); 
	Иначе
		Заголовок = НСтр("ru = 'Настройка регистрации на витрине mag1c'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Элементы.ИдентификаторВитрины.СписокВыбора.Количество() = 0 Тогда
		Закрыть();
		Маг1СИнтеграцияСлужебныйКлиент.ОбработкаКомандыОткрытьФормуПолученияИнформацииПоПрофилю();
	КонецЕсли;
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки()
		И СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
		АктивироватьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаОжидание);
		СчетчикПроверки = 0;
		ПодключитьОбработчикОжидания("ПроверитьЗагрузкуКонтрагентаНаВитрину", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗагрузкуКонтрагентаНаВитрину()
	
	Если РежимФормы <> Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
		Возврат;
	КонецЕсли;
	
	СчетчикПроверки = СчетчикПроверки + 1;
	
	КонтрагентПриИзмененииСервер();
	
	Если СостояниеИнвайта <> Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
		АктивироватьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаКонтрагент);
	ИначеЕсли СчетчикПроверки < 300 Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗагрузкуКонтрагентаНаВитрину", 5, Истина);
	Иначе
		Закрыть();
		ТекстПредупреждения = НСтр("ru = 'Почему-то обмен данными все еще не завершился. Возможно есть какая-то ошибка. Откройте настройки страницы mag1c и попробуйте запустить синхроинзацию вручную для получения расширенной информации.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьИнвайт(Команда)
	
	Если Не ЗначениеЗаполнено(ИдентификаторВитрины) Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выберите витрину</span>'"));
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выберите контрагента</span>'"));
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
		Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
			ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Покупатель зарегистрировался на витрине. После получения инвайта регистрация будет отменена. Для доступа к витрине ему нужно будет регистрироваться заново.</span>'"));
		Иначе
			ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Покупатель зарегистрировался на витрине. После выполнения операции регистрация будет отменена. Для оформления заказов покупателю нужно будет регистрироваться заново.</span>'"));
		КонецЕсли;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьИнвайтЗавершение", ЭтотОбъект);
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки,, КодВозвратаДиалога.Да);
		
		Возврат;
		
	КонецЕсли;
	
	ПолучитьИнвайтЗавершение(КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИнвайтЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоКонтрагентВитрины
		Или (ЗначениеЗаполнено(Договор)
			 И Не ЭтоДоговорВитрины) Тогда
		СохранитьСервер();
	КонецЕсли;
	
	Если СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен()
			Или СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован()
			Или СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
			
		Если СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен()
			Или СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
			
			Описание = Новый Структура("Контрагент, Инвайт, СостояниеИнвайта",
													Контрагент, 
													Инвайт,
													СостояниеИнвайта);
			
			КОтменеРегистрации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Описание);
		Иначе
			КОтменеРегистрации = Новый Массив();
		КонецЕсли;
			
		ПараметрыПомощника = Новый Структура;
		ПараметрыПомощника.Вставить("НастройкиВитрины", НастройкиВитрины);
		ПараметрыПомощника.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
		ПараметрыПомощника.Вставить("Действие", Маг1СПеречисления.ДействияФормыОбмена_ОбменОтменаРегистрацииСписокИнвайтов());
		ПараметрыПомощника.Вставить("ЗакрытьПриУспехе", Истина);
		ПараметрыПомощника.Вставить("ЖдатьОкончанияТекущегоОбмена", Истина);
		ПараметрыПомощника.Вставить("ЕстьКОбмену", СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен()
													Или СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан());
		ПараметрыПомощника.Вставить("КОтменеРегистрации", КОтменеРегистрации);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнениеОбменаЗавершение", ЭтотОбъект, Истина);
		
		ОткрытьФорму("Обработка.Маг1СОбмен.Форма.ВыполнениеОбмена",
						ПараметрыПомощника,
						ЭтотОбъект,
						,
						,
						,
						ОписаниеОповещения,
						 );
		Возврат;
		
	КонецЕсли;
	
	ПолучитьИнвайтКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьДоступ(Команда)
	
	Если СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
		Закрыть(ОписаниеИнвайта());
		Возврат;
	ИначеЕсли СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗапретитьДоступЗавершение", ЭтотОбъект);
		
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Покупатель уже зарегистрировался на витрине. После запрета, он не сможет использовать витрину. Если потом нужно будет разрешить доступ, то нужно будет получить инвайт, передать его покупателю, чтобы он зарегистрировался на витрине повторно.</span>'"));
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Запретить доступ'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	
		ПоказатьВопрос(ОписаниеОповещения, ТекстПредупреждения, Кнопки,,КодВозвратаДиалога.Отмена); 
		Возврат;
	КонецЕсли;
	
	ЗапретитьДоступЗавершение(КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьДоступЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗапретитьДоступСервер() Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">При выполнении операции произошла ошибка</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	Иначе
		Закрыть(ОписаниеИнвайта());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапретитьДоступСервер()
	
	Попытка
		
		Если СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован()
			Или СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован() Тогда
			
			Обработки.Маг1СОбмен.ОтозватьИнвайт(ПараметрыАвторизации, Инвайт);
		КонецЕсли;
		
		Маг1СИнтеграция.СнятьОтметкуКонтрагентВитрины(Контрагент, ИдентификаторВитрины);
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Контрагент);
		
		СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен()
	
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_УправлениеИнвайтами(),
									УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИдентификаторВитриныОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьВитрину();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВитрину()
	
	Если ЗначениеЗаполнено(НастройкиВитрины)
		И ЗначениеЗаполнено(НастройкиВитрины.ОсновныеНастройки.АдресСайтаВитрины) Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(НастройкиВитрины.ОсновныеНастройки.АдресСайтаВитрины);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОткрытьВитринуНажатие(Команда)
	ОткрытьВитрину();
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторВитриныПриИзменении(Элемент)
	ИдентификаторВитриныПриИзмененииСервер();
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	
	Тема  = НСтр("ru = 'Получение инвайта mag1c'");
	Текст = НСтр("ru = 'При получении инвайта mag1c возникла следующая проблема'");
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																   НастройкиВитрины.ОсновныеНастройки.ИмяВитрины,
																   НастройкиВитрины.ЛогинИПП,
																   Тема,
																   Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибка3ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПерезапуститьСистему(Маг1СПеречисления.ПараметрыПерезапускаСистемы_Пусто());
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	КонтрагентПриИзмененииСервер();
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Маг1СИнтеграцияПереопределяемыйКлиент.ДоговорНачалоВыбора(НастройкиВитрины,
																Новый Структура("Контрагент,Договор", Контрагент, Договор),
																Элемент,
																ДанныеВыбора,
																СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ДоговорОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник." + ИмяСправочникаДоговор + ".ФормаОбъекта",
					Новый Структура("Ключ", Договор),
					Элементы.Контрагент,
					,
					,
					,
					,
					 );
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	Попытка
		Если ДоговорПриИзмененииНаСервере(Истина) Тогда
			ТекстСообщения = НСтр("ru = 'Изменения сохранены'");
			ПоказатьОповещениеПользователя(ТекстСообщения);
		Иначе
			Договор = Неопределено;
		КонецЕсли;
	Исключение
		Договор = Неопределено;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияИнвайтОписаниеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыМастера = Новый Структура();
	Если НастройкиВитрины <> Неопределено Тогда
		ПараметрыМастера.Вставить("НастройкиВитрины", НастройкиВитрины);
	КонецЕсли;
	
	ПараметрыМастера.Вставить("НастройкиУчетнойСистемы", НастройкиУчетнойСистемы);
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ПараметрыМастера.Вставить("Контрагенты", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Контрагент));
	КонецЕсли;
	
	Закрыть();
	ОткрытьФорму("Обработка.Маг1СРаботаСИнвайтами.Форма.РаботаСКонтрагентами",
				ПараметрыМастера,
				ЭтотОбъект.ВладелецФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБаннерКомандаНажатие(Элемент)
	
	ПараметрыПомощника = Новый Структура;
	ПараметрыПомощника.Вставить("НастройкиВитрины", НастройкиВитрины);
	ПараметрыПомощника.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ПараметрыПомощника.Вставить("Действие", Маг1СПеречисления.ДействияФормыОбмена_ОбменОтменаРегистрацииСписокИнвайтов());
	ПараметрыПомощника.Вставить("ЗакрытьПриУспехе", Истина);
	ПараметрыПомощника.Вставить("ЖдатьОкончанияТекущегоОбмена", Истина);
	ПараметрыПомощника.Вставить("ЕстьКОбмену", ТребуетсяАктуализация);
	ПараметрыПомощника.Вставить("КОтменеРегистрации", Новый Массив());
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнениеОбменаЗавершение", ЭтотОбъект, Ложь); 
	
	ОткрытьФорму("Обработка.Маг1СОбмен.Форма.ВыполнениеОбмена",
					ПараметрыПомощника,
					ЭтотОбъект,
					,
					,
					,
					ОписаниеОповещения,
					 );
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ОписаниеИнвайта()
	
	Результат        = Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеИнвайта();
	Результат.Ид     = Инвайт;
	Результат.Статус = СостояниеИнвайта;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ИдентификаторВитриныПриИзмененииСервер();
	
	ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(ИдентификаторВитрины);
	
	Если ПараметрыАвторизации.РасширениеОбновлено Тогда
		АктивироватьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаПерезапускПрограммы);
		Возврат;
	КонецЕсли;
	
	НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(ИдентификаторВитрины);
	
	УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	Если ЕстьДоговоры Тогда
		ТекстВидЦеныПоУмолчанию = НСтр("ru = '<не указан, цены на витрине по виду цен ""%ВидЦен%"">'");
		ТекстВидЦеныПоУмолчанию = СтрЗаменить(ТекстВидЦеныПоУмолчанию, "%ВидЦен%", НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.ВидЦен);
		
		Элементы.Договор.ПодсказкаВвода = ТекстВидЦеныПоУмолчанию;
	КонецЕсли;
	
	КонтрагентПриИзмененииСервер();
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииСервер()
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ЭтоКонтрагентВитрины = Маг1СИнтеграция.ЭтоКонтрагентВитрины(Контрагент, ИдентификаторВитрины);
	Иначе
		ЭтоКонтрагентВитрины = Ложь;
	КонецЕсли;
	
	Инвайт = Маг1СИнтеграция.ИндентификаторОбменаПоОбъекту(Контрагент, УзелОбмена);
	СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан();
	
	Если Не ПустаяСтрока(Инвайт) Тогда
		ПолучитьИнформациюПоИнвайту();
	КонецЕсли;
	
	Если ЕстьДоговоры
		И СостояниеИнвайта <> Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
		
		Если ЭтоКонтрагентВитрины Тогда
			ДоговорСтруктура = Маг1СИнтеграция.ДоговорВидЦенВитрины(Контрагент, ИдентификаторВитрины);
			Если ДоговорСтруктура <> Неопределено Тогда
				Договор = ДоговорСтруктура.Договор;
			Иначе
				Договор = Неопределено;
			КонецЕсли;
		Иначе
			Договор = Неопределено;
		КонецЕсли;
		
		Если Договор = Неопределено Тогда
			Договор = НастройкиУчетнойСистемы.ДоговорКонтрагента.Значение;
		КонецЕсли;
		
		Элементы.Договор.ТолькоПросмотр = Не ЗначениеЗаполнено(Контрагент);
		
		Если ЗначениеЗаполнено(Договор) Тогда
			Если Не ДоговорПриИзмененииНаСервере(Ложь) Тогда
				Договор = Неопределено;
			КонецЕсли;
		Иначе
			ЭтоДоговорВитрины = Ложь;
		КонецЕсли;
	Иначе
		Договор = Неопределено;
	КонецЕсли;
	СохранитьСервер();
	НастроитьПоСостояниюИнвайта(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнениеОбменаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатВыполнения) <> Тип("Структура") Тогда
		ТекстСообщения = НСтр("ru = 'При выполнении операции произошла ошибка'");
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	Иначе
		ПараметрыАвторизации = РезультатВыполнения.ПараметрыАвторизации;
		Для Каждого Информация Из РезультатВыполнения.МассивИнвайтов Цикл
			Если Информация.Ид = Инвайт Тогда
				СостояниеИнвайта = Информация.Статус;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если РезультатВыполнения.Свойство("ТребуетсяАктуализация") Тогда 
			ТребуетсяАктуализация = РезультатВыполнения.ТребуетсяАктуализация;
		КонецЕсли;
		
		НастроитьПоСостояниюИнвайта(ЭтотОбъект);
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Булево")
			И ДополнительныеПараметры Тогда
			ПолучитьИнвайтКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИнвайтКлиент()
	
	Если РежимФормы <> Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
		Закрыть(ОписаниеИнвайта());
		Возврат;
	КонецЕсли;
	
	СформироватьТекстыИнвайтов();
	
	АктивироватьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаИнвайты);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьТекстыИнвайтов()
	
	ТабДокИнвайты = 
		Обработки.Маг1СРаботаСИнвайтами.СформироватьТекстыИнвайтов(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый Структура("Контрагент,Инвайт, СостояниеИнвайта",
															Контрагент,Инвайт)
														 ),
														 НастройкиВитрины);
	
КонецПроцедуры

&НаСервере
Функция ДоговорПриИзмененииНаСервере(Сообщать)
	
	Если ЗначениеЗаполнено(Договор) Тогда
		
		Если Маг1СИнтеграцияСлужебныйВызовСервера.ЕстьПроблемаСНДСВВидеЦенДоговора(Договор,
							НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация) Тогда
			Если Сообщать Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В выбранном договоре указан вид цен, в котором настроено, что цены не включают НДС. Цены, выгружаемые на витрину должны включать НДС. Измените вид цены в договоре.'"),
					 ,
					 ,
					 "Договор");
			КонецЕсли;
			
			Возврат Ложь;
		КонецЕсли;
		
		ЭтоДоговорВитрины = Маг1СИнтеграция.ЭтоДоговорРаботыСВитриной(Договор, ИдентификаторВитрины, ИмяСправочникаДоговор);
		СохранитьСервер();
	Иначе
		СнятьОтметкуДоговора();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура СохранитьСервер()
	
	ЕстьИзменения = Ложь;
	
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		
		Если ЗначениеЗаполнено(Контрагент)
			И Не ЭтоКонтрагентВитрины Тогда
			Маг1СИнтеграция.СделатьКонтрагентомВитрины(Контрагент, ИдентификаторВитрины);
			ПланыОбмена.ЗарегистрироватьИзменения(НастройкиВитрины.ОсновныеНастройки.УзелОбмена, Контрагент);
			
			ЭтоКонтрагентВитрины = Истина;
		КонецЕсли;
		
		Если ЕстьДоговоры Тогда
			Если ЗначениеЗаполнено(Договор) Тогда
				
				Если Не ЭтоДоговорВитрины Тогда
					Маг1СИнтеграция.ИзменитьОтметкуДоговорВитрины(Договор,
																  ИдентификаторВитрины,
																  Истина);
					ЭтоДоговорВитрины = Истина;
				КонецЕсли;
				
			Иначе
				
				СнятьОтметкуДоговора();
				
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьИнформациюПоИнвайту()
	
	Информация = Обработки.Маг1СОбмен.ПолучитьИнформациюПроверитьПоКонтрагенту(ПараметрыАвторизации, Контрагент);
	
	Если ТипЗнч(Информация) = Тип("Структура") Тогда
		СостояниеИнвайта      = Информация.Статус;
		ТребуетсяАктуализация = Информация.ТребуетсяАктуализация;
		Если ЭтоКонтрагентВитрины
			И СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
			
			ЭтоКонтрагентВитрины = Ложь;
			ЭтоДоговорВитрины    = Ложь;
			
		ИначеЕсли Не ЭтоКонтрагентВитрины	
			И СостояниеИнвайта <> Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
			
			ЭтоКонтрагентВитрины = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СнятьОтметкуДоговора()
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		ДоговорСтруктура = Маг1СИнтеграция.ДоговорВидЦенВитрины(Контрагент, ИдентификаторВитрины);
		Если ДоговорСтруктура <> Неопределено Тогда
			Маг1СИнтеграция.ИзменитьОтметкуДоговорВитрины(ДоговорСтруктура.Договор,
				ИдентификаторВитрины,
				Ложь);
		КонецЕсли;
		ЭтоДоговорВитрины = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьПоСостояниюИнвайта(Форма)
	
	Элементы         = Форма.Элементы;
	СостояниеИнвайта = Форма.СостояниеИнвайта;
	Контрагент       = Форма.СостояниеИнвайта;
	ТребуетсяАктуализация = Форма.ТребуетсяАктуализация;
	
	Элементы.ДекорацияСостояниеНаВитрине.Заголовок = Маг1СПеречисления.СостоянияИнвайтаПредставление(СостояниеИнвайта);
	Элементы.БаннерТребуетсяСинхронизация.Видимость = ТребуетсяАктуализация;
	
	Если СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
		
		Если Форма.РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
		
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Передать на витрину и получить инвайт'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Отмена'");
			
		Иначе
			
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Передать на витрину'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Отмена'");
			
		КонецЕсли;
		
		Элементы.ПолучитьИнвайт.Доступность  = Истина;
		Элементы.ЗапретитьДоступ.Доступность = Истина;
		Элементы.Договор.Доступность = ЗначениеЗаполнено(Контрагент);

	ИначеЕсли СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован() Тогда
		
		Если Форма.РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Получить инвайт'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Запретить доступ'");
			Элементы.ПолучитьИнвайт.Доступность  = Истина;
		Иначе
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Отменить регистрацию на витрине'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Запретить регистрацию'");
			Элементы.ПолучитьИнвайт.Доступность  = Ложь;
		КонецЕсли;
		
		Элементы.ЗапретитьДоступ.Доступность = Истина;
		Элементы.Договор.Доступность = ЗначениеЗаполнено(Контрагент);
		
	ИначеЕсли СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
		
		Если Форма.РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Отменить регистрацию на витрине и получить инвайт'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Запретить доступ'");
		Иначе
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Отменить регистрацию на витрине'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Запретить оформлять заказы'");
		КонецЕсли;
			
		Элементы.ПолучитьИнвайт.Доступность  = Истина;
		Элементы.ЗапретитьДоступ.Доступность = Истина;
		Элементы.Договор.Доступность = ЗначениеЗаполнено(Контрагент);
		
	ИначеЕсли СостояниеИнвайта = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
		
		Если Форма.РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Разрешить зарегистрироваться и получить инвайт'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Запретить доступ'");
		Иначе
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Разрешить зарегистрироваться'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Запретить оформлять заказы'");
		КонецЕсли;
		
		Элементы.Договор.Доступность = Ложь;
		Элементы.ПолучитьИнвайт.Доступность  = Истина;
		Элементы.ЗапретитьДоступ.Доступность = Ложь;
		
	Иначе
		
		Если Форма.РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Получить инвайт'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Запретить доступ'");
		Иначе
			Элементы.ПолучитьИнвайт.Заголовок    = НСтр("ru = 'Сохранить'");
			Элементы.ЗапретитьДоступ.Заголовок   = НСтр("ru = 'Отмена'");
		КонецЕсли;
		
		Элементы.Договор.Доступность = Ложь;
		Элементы.ПолучитьИнвайт.Доступность  = Ложь;
		Элементы.ЗапретитьДоступ.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура АктивироватьТекущуюСтраницу(Форма, НоваяСтраница)
	Элементы = Форма.Элементы;
	
	Элементы.СтраницыФормы.ТекущаяСтраница = НоваяСтраница;
	Если НоваяСтраница = Элементы.СтраницаКонтрагент Тогда 
		Элементы.ГруппаКомандыИнвайта.Видимость = Истина;
	Иначе
		Элементы.ГруппаКомандыИнвайта.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

