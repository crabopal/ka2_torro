Функция СформироватьТекстыИнвайтов(Контрагенты, НастройкиВитрины) Экспорт
	
	ТабДокИнвайты = Новый ТабличныйДокумент;
	Макет = Обработки.Маг1СРаботаСИнвайтами.ПолучитьМакет("СписокИнвайтов");
	ОбластьШапки  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	
	ТабДокИнвайты.Очистить();
	
	ТабДокИнвайты.Вывести(ОбластьШапки);
	
	ШаблонТекста = НСтр("ru = 'Магазин ""%НазваниеМагазина%"" теперь и в интернете.
		|Переходите по вашей уникальной ссылке, регистрируйтесь, выбирайте товары, оформляйте заказы. Быстро и удобно)
		|
		|Ссылка: %Инвайт%'");
	ШаблонИнвайта = "https://%ПолноеИмяВитрины%/applications/Store/?state=invite-%ГУИДКонтрагента%";
	
	Для Каждого Контрагент из Контрагенты Цикл 
		СтрокаИнвайта = СтрЗаменить(ШаблонИнвайта, "%ПолноеИмяВитрины%", НастройкиВитрины.ОсновныеНастройки.ПолноеИмяВитрины);  
		СтрокаИнвайта = СтрЗаменить(СтрокаИнвайта, "%ГУИДКонтрагента%", Контрагент.Инвайт);  
		
		ТекстРассылки = СтрЗаменить(ШаблонТекста, "%НазваниеМагазина%", НастройкиВитрины.ОсновныеНастройки.НазваниеМагазина);  
		ТекстРассылки = СтрЗаменить(ТекстРассылки, "%Инвайт%", СтрокаИнвайта);  
		
		ОбластьСтроки.Параметры.Контрагент    = Контрагент.Контрагент;
		ОбластьСтроки.Параметры.ТекстРассылки = ТекстРассылки;
		ОбластьСтроки.Параметры.Инвайт        = СтрокаИнвайта;
		
		ТабДокИнвайты.Вывести(ОбластьСтроки);
	КонецЦикла;
	
	ТабДокИнвайты.ТолькоПросмотр = Истина;
	
	Возврат ТабДокИнвайты;
	
КонецФункции
