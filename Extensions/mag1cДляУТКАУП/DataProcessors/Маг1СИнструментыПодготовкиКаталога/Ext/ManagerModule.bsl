Процедура НастроитьЭлементФильтрАктиности(ЭлементФильтрПоАктивности, НастройкиВитрины) Экспорт
	
	ПравилаОтображенияТоваров = НастройкиВитрины.ДополнительныеНастройки.ПравилаОтображенияТоваров; 
		
	Если ПравилаОтображенияТоваров.ПубликоватьТолькоАктивныеПозиции Тогда
		ТекстПодсказки = НСтр("ru = 'В настройках витрины указано, что нужно отображать только товары %ТекстУсловияАктивности%'");
		
		ТекстыУсловий = Новый Массив;
		
		Если ПравилаОтображенияТоваров.ОтборПоОстаткам Тогда
			ТекстыУсловий.Добавить(НСтр("ru = 'с остатками на складах'"));
		КонецЕсли;
		
		Если ПравилаОтображенияТоваров.ОтборПоПродажам Тогда
			ТекстыУсловий.Добавить(НСтр("ru = 'с продажами за последние 30 дней'"));
		КонецЕсли;
			
		Если ПравилаОтображенияТоваров.ОтборПоЗаказамПоставщикам Тогда
			ТекстыУсловий.Добавить(НСтр("ru = 'с действующими заказами поставщикам'"));
		КонецЕсли;
		
		Если ПравилаОтображенияТоваров.ОтборПоСегменту Тогда
			ТекстУсловия = НСтр("ru = 'из сегмента %СегментНоменклатуры'");
			ТекстУсловия = СтрЗаменить(ТекстУсловия, "%СегментНоменклатуры", НастройкиВитрины.ДополнительныеНастройки.СегментНоменклатуры);
			ТекстыУсловий.Добавить(ТекстУсловия);
		КонецЕсли;
		
		ТекстУсловияАктивности = "";
		
		Если ТекстыУсловий.Количество() > 0 Тогда
			
			Индекс = 1;
			
			Для каждого ТекстУсловия из ТекстыУсловий Цикл
				
				Если Индекс = 1 Тогда
					Разделитель = ""
				ИначеЕсли Индекс = ТекстыУсловий.Количество()  Тогда
					Разделитель =НСтр("ru = ' или '")
				Иначе
					Разделитель = ", "
				КонецЕсли;
				
				ТекстУсловияАктивности = ТекстУсловияАктивности + Разделитель + ТекстУсловия;
				
				Индекс = Индекс + 1;
			КонецЦикла;
			
			ТекстПодсказки = СтрЗаменить(ТекстПодсказки, "%ТекстУсловияАктивности%", ТекстУсловияАктивности); 
			
			ЭлементФильтрПоАктивности.Подсказка = ТекстПодсказки; 
		Иначе
			ЭлементФильтрПоАктивности.Видимость = Ложь;
		КонецЕсли;
		
	Иначе
		ЭлементФильтрПоАктивности.Видимость = Ложь;
	КонецЕсли;
	
	ЭлементФильтрПоАктивности.СписокВыбора.Очистить();
	
	РежимыФильтра = Маг1СПеречисления.РежимыФильтраПоАктивностиПорядок();
	
	Для Каждого СтрМас из РежимыФильтра Цикл
		ЭлементФильтрПоАктивности.СписокВыбора.Добавить(СтрМас,
			Маг1СПеречисления.РежимыФильтраПоАктивностиПредставление(СтрМас));
	КонецЦикла;
	
КонецПроцедуры

Процедура ВосстановитьИзНастроекЗначкиНоменклатуры(Форма, ОсновныеНастройки) Экспорт
	Форма.ТаблицаЗначкиНоменклатуры.Очистить();
	Для Каждого ОписаниеЗначка из ОсновныеНастройки.ЗначкиНоменклатуры Цикл
		НоваяСтрока = Форма.ТаблицаЗначкиНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОписаниеЗначка);
	КонецЦикла;
КонецПроцедуры

Процедура СохранитьВНастройкиЗначкиНоменклатуры(Форма, ОсновныеНастройки) Экспорт
	ОсновныеНастройки.ЗначкиНоменклатуры.Очистить();
	Для Каждого СтрТабл из Форма.ТаблицаЗначкиНоменклатуры Цикл
		ОсновныеНастройки.ЗначкиНоменклатуры.Добавить(Новый Структура("Значок, ОтображатьНаНачальнойСтранице", 
							 							СтрТабл.Значок, СтрТабл.ОтображатьНаНачальнойСтранице));		
		
	КонецЦикла;
КонецПроцедуры

Процедура ОбновитьЗначкиНоменклатуры(Форма, НастройкиУчетнойСистемы) Экспорт
	
	Настройки = Маг1СИнтеграцияСлужебный.СтруктураНастройкиВитрины();

	СохранитьВНастройкиЗначкиНоменклатуры(Форма, Настройки.ОсновныеНастройки);
	
	Маг1СИнтеграцияСлужебный.ИсправитьЗначкиНоменклатуры(Настройки.ОсновныеНастройки.ЗначкиНоменклатуры);
	
	ВосстановитьИзНастроекЗначкиНоменклатуры(Форма, Настройки.ОсновныеНастройки);
КонецПроцедуры

Процедура ДобавитьФильтрПоАктивности(ФильтрПоАктивности,
										ТекстЗапроса,
										МенеджерВременныхТаблиц,
										НастройкиФильтровНоменклатуры,
										НастройкиВитрины,
										НастройкиУчетнойСистемы) Экспорт
	
	Если ФильтрПоАктивности = Маг1СПеречисления.РежимыФильтраПоАктивности_ВсеТовары() Тогда
		ТекстФильтраПоАктивности = "ИСТИНА";
	Иначе
		Маг1СИнтеграция.СформироватьВТАктивнаяНоменклатура(МенеджерВременныхТаблиц,
															НастройкиФильтровНоменклатуры,
															НастройкиВитрины,
															Ложь);
		ТекстФильтраПоАктивности = "ВТПубликуемаяНоменклатура.Номенклатура В (ВЫБРАТЬ ПЕРВЫЕ 1
									|	ВТАктивнаяНоменклатура.Номенклатура
									|ИЗ
									|	ВТАктивнаяНоменклатура КАК ВТАктивнаяНоменклатура
									|ГДЕ
									|	ВТАктивнаяНоменклатура.Номенклатура = ВТПубликуемаяНоменклатура.Номенклатура
									|	И ВТАктивнаяНоменклатура.Цена > 0)";	
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстФильтраПоАктивности", ТекстФильтраПоАктивности);

КонецПроцедуры
