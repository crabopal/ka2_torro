#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьУсловноеОформление();
	
	НастройкиУчетнойСистемы       = Параметры.НастройкиУчетнойСистемы;
	НастройкиВитрины              = Параметры.НастройкиВитрины;
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	
	ФильтрПоАктивности          = Маг1СПеречисления.РежимыФильтраПоАктивности_ВсеТовары();
	ФильтрПоЗначку              = "ВсеТовары";
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.НастроитьЭлементФильтрАктиности(Элементы.ФильтрПоАктивности, НастройкиВитрины);
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры());
	
	Элементы.ОтборПоЗначку.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов());
	Элементы.ОтборПоЗначку.ПараметрыВыбора = Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрВыбора));
	
	Элементы.НоменклатураЗначкиЗначок.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов());
	Элементы.НоменклатураЗначкиЗначок.ПараметрыВыбора = Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрВыбора));
	
	ОбновитьНоменклатураЗначки();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьЭлементы();
 	НастроитьЭлементыКодаАртикула();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Модифицированность Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		ВопросСохранитьИзмененияПродолжение = Новый ОписаниеОповещения("ВопросСохранитьИзмененияПриЗакрытии", ЭтотОбъект);
		ПоказатьВопрос(
			ВопросСохранитьИзмененияПродолжение,
			НСтр("ru = 'Сохранить изменения перед закрытием?'"),
			РежимДиалогаВопрос.ДаНетОтмена,
			,
			,
			НСтр("ru = 'Маг1С'"));
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ВопросСохранитьИзмененияПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьИзмененияНаСервере();
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьСкрытьКодыИАртикулы(Команда)
	ПоказатьКодАртикул = Не ПоказатьКодАртикул;
	НастроитьЭлементыКодаАртикула();
КонецПроцедуры
 
&НаКлиенте
Процедура НазначитьЗначок(Команда)
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		СтрокиОбработки = Элементы.НоменклатураЗначки.ПолучитьСтрокиДляОбработки();
	Иначе
		СтрокиОбработки = Элементы.НоменклатураЗначки.ВыделенныеСтроки;
	КонецЕсли;
	
	Если СтрокиОбработки.Количество() = 0 Тогда
		ТекстПредупреждения = НСтр("ru = 'Выделите номенклатуру, для которой необходимо изменить значок'");
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НазначитьЗначокЗавершение",ЭтотОбъект);
	
	ОткрытьФорму("Обработка.Маг1СИнструментыПодготовкиКаталога.Форма.НазначениеРеквизитовЗначка",
				,
				,
				,
				,
				,
				ОписаниеОповещения,
				 );
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьЗначокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	ТекущийЗначок            = Результат.ТекущийЗначок;
	ТекущееЗначокПояснение   = Результат.ТекущееЗначокПояснение;
	ТекущийЗначокДействуетДо = Результат.ТекущийЗначокДействуетДо;
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		СтрокиОбработки = Элементы.НоменклатураЗначки.ПолучитьСтрокиДляОбработки();
	Иначе
		СтрокиОбработки = Элементы.НоменклатураЗначки.ВыделенныеСтроки;
	КонецЕсли;
	
	Для Каждого ИдСтроки из СтрокиОбработки Цикл
		
		ТекущиеДанные = НоменклатураЗначки.НайтиПоИдентификатору(ИдСтроки);
		СохранитьТекущуюСтроку(ТекущиеДанные);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьЗначок(Команда)
	
	Если Маг1СИнтеграцияСлужебныйКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		СтрокиОбработки = Элементы.НоменклатураЗначки.ПолучитьСтрокиДляОбработки();
	Иначе
		СтрокиОбработки = Элементы.НоменклатураЗначки.ВыделенныеСтроки;
	КонецЕсли;
	
	Если СтрокиОбработки.Количество() = 0 Тогда
		ТекстПредупреждения = НСтр("ru = 'Выделите номенклатуру, для которой необходимо сбросить значок'");
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ТекущийЗначок = Неопределено;
	
	Для Каждого ИдСтроки из СтрокиОбработки Цикл
		
		ТекущиеДанные = НоменклатураЗначки.НайтиПоИдентификатору(ИдСтроки);
		СохранитьТекущуюСтроку(ТекущиеДанные);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	
	СохранитьИзмененияНаСервере();
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Изменения сохранены'"),
		,
		,
		,
		СтатусОповещенияПользователя.Информация);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	СохранитьИзмененияНаСервере();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзменения(Команда)
	Если Не Модифицированность Тогда
		Возврат;
	Иначе
		ВопросОтменитьИзмененияПродолжение = Новый ОписаниеОповещения("ОтменитьИзмененияЗавершение", ЭтотОбъект);
		ПоказатьВопрос(
			ВопросОтменитьИзмененияПродолжение,
			НСтр("ru = 'Отменить сделанные изменения?'"),
				РежимДиалогаВопрос.ДаНет,
				,
				,
				НСтр("ru = 'Маг1С'"));
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзмененияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбновитьДеревоНоменклатурыКлиент();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТекущийЗначокПриИзменении(Элемент)
	СохранитьТекущуюСтроку();		
КонецПроцедуры

&НаКлиенте
Процедура ТекущееЗначокПояснениеПриИзменении(Элемент)
	СохранитьТекущуюСтроку();
КонецПроцедуры

&НаКлиенте
Процедура ТекущийСрокДействияПриИзменении(Элемент)
	Если ТекущийСрокДействия = "ДействуетДо" Тогда
		НастроитьЭлементы();
	Иначе
		ТекущийЗначокДействуетДо = Неопределено;
		СохранитьТекущуюСтроку();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТекущийЗначокДействуетДоПриИзменении(Элемент)
	СохранитьТекущуюСтроку();
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	
	Тема  = НСтр("ru = 'Подключение к mag1c. Редактор значков товаров'");
	Текст = НСтр("ru = 'При работе с редактором значков товаров возникла следующая проблема'");
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																			   НастройкиВитрины.ОсновныеНастройки.ИмяВитрины,
																			   НастройкиВитрины.ЛогинИПП,
																			   Тема,
																			   Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоАктивностиПриИзменении(Элемент)
	ФильтрПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоЗначкуПриИзменении(Элемент)
	ФильтрПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоЗначкуПриИзменении(Элемент)
	ФильтрПриИзменении();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыНоменклатураЗначки

&НаКлиенте
Процедура НоменклатураЗначкиПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.НоменклатураЗначки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено
		Или ТекущиеДанные.ЭтоГруппа Тогда
		
		ТекущийЗначок            = Неопределено;
		ТекущееЗначокПояснение   = Неопределено;
		ТекущийЗначокДействуетДо = Неопределено;
		
	Иначе
		
		ТекущийЗначок            = ТекущиеДанные.Значок;
		ТекущееЗначокПояснение   = ТекущиеДанные.ЗначокПояснение;
		ТекущийЗначокДействуетДо = ТекущиеДанные.ЗначокДействуетДо;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийЗначокДействуетДо) Тогда
		ТекущийСрокДействия = "Бессрочно";
	Иначе
		ТекущийСрокДействия = "ДействуетДо";
	КонецЕсли;
	
	НастроитьЭлементы();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЗначкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле <> Элементы.НоменклатураЗначкиНаименование Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЗначкиЗначокПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НоменклатураЗначки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЗначок = ТекущиеДанные.Значок;
	
	СохранитьТекущуюСтроку(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЗначкиЗначокДействуетДоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НоменклатураЗначки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЗначокДействуетДо = ТекущиеДанные.ЗначокДействуетДо;
	Если Не ЗначениеЗаполнено(ТекущийЗначокДействуетДо) Тогда
		ТекущийСрокДействия = "Бессрочно";
	Иначе
		ТекущийСрокДействия = "ДействуетДо";
	КонецЕсли;
	
	СохранитьТекущуюСтроку(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЗначкиЗначокПояснениеПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НоменклатураЗначки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееЗначокПояснение = ТекущиеДанные.ЗначокПояснение;
	
	СохранитьТекущуюСтроку(ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастроитьЭлементыКодаАртикула()
	
	Если ПоказатьКодАртикул Тогда
		Элементы.ПоказатьСкрытьКодыИАртикулы.Заголовок = НСтр("ru = 'Скрыть коды и артикулы'");
	Иначе
		Элементы.ПоказатьСкрытьКодыИАртикулы.Заголовок = НСтр("ru = 'Показать коды и артикулы'");
	КонецЕсли;
	
	Элементы.НоменклатураЗначкиГруппаКодАртикул.Видимость = ПоказатьКодАртикул;

КонецПроцедуры

Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураЗначкиНаименование.Имя);
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураЗначкиЗначок.Имя);
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураЗначкиЗначокДействуетДо.Имя);
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураЗначкиЗначокПояснение.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураЗначки.ЕстьИзменения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,Истина));
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураЗначкиЗначокДействуетДо.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураЗначки.Значок");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураЗначки.ЗначокДействуетДо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураЗначки.ЗначокДействуетДо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДатаСеанса();
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255,0,0));
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураЗначкиЗначокДействуетДо.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураЗначки.Значок");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураЗначки.ЗначокДействуетДо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураЗначки.ЗначокДействуетДо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = НачалоДня(ТекущаяДатаСеанса());
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255,0,0));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоНоменклатурыКлиент()
	
	ОбновитьНоменклатураЗначки();
	Для Каждого СтрокаДерева из НоменклатураЗначки.ПолучитьЭлементы() Цикл
		Элементы.НоменклатураЗначки.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
	НастроитьЭлементы();

КонецПроцедуры

&НаСервере
Процедура ОбновитьНоменклатураЗначки()
	СохранитьКешФильтров();	
	Модифицированность = Ложь;
	ВерхнийУровеньДерева = НоменклатураЗначки.ПолучитьЭлементы();
	ВерхнийУровеньДерева.Очистить();
	
	Если ФильтрПоЗначку = "ТолькоТоварыСоЗначком"
		И Не ЗначениеЗаполнено(ОтборПоЗначку) Тогда
	    Возврат;
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Маг1СИнтеграция.СформироватьВТПубликуемаяНоменклатура(МенеджерВременныхТаблиц,
														  НастройкиФильтровНоменклатуры);
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
														  
	ТекстЗапроса =													  
	"ВЫБРАТЬ
	|	ВТПубликуемаяНоменклатура.Номенклатура КАК Номенклатура,
	|	ВТПубликуемаяНоменклатура.Группа КАК Группа,
	|	ВТПубликуемаяНоменклатура.Наименование КАК Наименование,
	|	ВТПубликуемаяНоменклатура.Код КАК Код,	
	|	ВТПубликуемаяНоменклатура.Артикул КАК Артикул,	
	|	ЕСТЬNULL(ДопРеквизитЗначок.Значение, ЗНАЧЕНИЕ(Справочник.ЗначенияСвойствОбъектов.ПустаяСсылка)) КАК Значок,
	|	ЕСТЬNULL(ДопРеквизитЗначокДействуетДо.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗначокДействуетДо,
	|	ЕСТЬNULL(ДопРеквизитЗначокПояснение.Значение, """") КАК ЗначокПояснение
	|ИЗ
	|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРеквизитЗначок
	|		ПО ВТПубликуемаяНоменклатура.Номенклатура = ДопРеквизитЗначок.Ссылка
	|			И (ДопРеквизитЗначок.Свойство = &ДопРеквизитЗначок)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРеквизитЗначокПояснение
	|		ПО ВТПубликуемаяНоменклатура.Номенклатура = ДопРеквизитЗначокПояснение.Ссылка
	|			И (ДопРеквизитЗначокПояснение.Свойство = &ДопРеквизитЗначокПояснение)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРеквизитЗначокДействуетДо
	|		ПО ВТПубликуемаяНоменклатура.Номенклатура = ДопРеквизитЗначокДействуетДо.Ссылка
	|			И (ДопРеквизитЗначокДействуетДо.Свойство = &ДопРеквизитЗначокДействуетДо)
	|ГДЕ
	|	&ТекстФильтраПоАктивности
	|	И &ТекстФильтрПоЗначку	
	|ИТОГИ ПО
	|	Группа ИЕРАРХИЯ";
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.ДобавитьФильтрПоАктивности(ФильтрПоАктивности,
																				ТекстЗапроса,
																				МенеджерВременныхТаблиц,
																				НастройкиФильтровНоменклатуры,
																				НастройкиВитрины,
																				НастройкиУчетнойСистемы);	
	
	Если ФильтрПоЗначку = "ТолькоТоварыСоЗначком" Тогда
		
		ТекстФильтрПоЗначку = "ДопРеквизитЗначок.Значение = &ОтборПоЗначку
								|И (ДопРеквизитЗначокДействуетДо.Значение ЕСТЬ NULL
								|	ИЛИ ДопРеквизитЗначокДействуетДо.Значение = НЕОПРЕДЕЛЕНО
								|	ИЛИ ДопРеквизитЗначокДействуетДо.Значение = ДАТАВРЕМЯ(1, 1, 1)
								|	ИЛИ ДопРеквизитЗначокДействуетДо.Значение >= &ТекущаяДата)";
		
		Запрос.УстановитьПараметр("ОтборПоЗначку", ОтборПоЗначку);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		
	ИначеЕсли ФильтрПоЗначку = "ЗаполненныйЗначок" Тогда
		
		ТекстФильтрПоЗначку = "НЕ ДопРеквизитЗначок.Ссылка ЕСТЬ NULL
							   |И ДопРеквизитЗначок.Значение <> НЕОПРЕДЕЛЕНО
							   |И ДопРеквизитЗначок.Значение <> ЗНАЧЕНИЕ(Справочник.ЗначенияСвойствОбъектов.ПустаяСсылка)
							   |И (ДопРеквизитЗначокДействуетДо.Значение ЕСТЬ NULL
							   |	ИЛИ ДопРеквизитЗначокДействуетДо.Значение = НЕОПРЕДЕЛЕНО
							   |	ИЛИ ДопРеквизитЗначокДействуетДо.Значение = ДАТАВРЕМЯ(1, 1, 1)
							   |	ИЛИ ДопРеквизитЗначокДействуетДо.Значение >= &ТекущаяДата)";
		
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		
	ИначеЕсли ФильтрПоЗначку = "ЗначокНеДействует" Тогда	
		ТекстФильтрПоЗначку = "НЕ ДопРеквизитЗначок.Ссылка ЕСТЬ NULL
							   |И ДопРеквизитЗначок.Значение <> НЕОПРЕДЕЛЕНО
							   |И ДопРеквизитЗначок.Значение <> ЗНАЧЕНИЕ(Справочник.ЗначенияСвойствОбъектов.ПустаяСсылка)
							   |И НЕ (ДопРеквизитЗначокДействуетДо.Значение ЕСТЬ NULL
							   |		ИЛИ ДопРеквизитЗначокДействуетДо.Значение = НЕОПРЕДЕЛЕНО
							   |		ИЛИ ДопРеквизитЗначокДействуетДо.Значение = ДАТАВРЕМЯ(1, 1, 1)
							   |		ИЛИ ДопРеквизитЗначокДействуетДо.Значение >= &ТекущаяДата)";
		
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Иначе
		
		ТекстФильтрПоЗначку = "ИСТИНА";
		
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстФильтрПоЗначку", ТекстФильтрПоЗначку);
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ДопРеквизитЗначок", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры());
	Запрос.УстановитьПараметр("ДопРеквизитЗначокПояснение", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокПояснениеНоменклатуры());
	Запрос.УстановитьПараметр("ДопРеквизитЗначокДействуетДо", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокДействуетДоНоменклатуры());
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ДобавитьЭлементыВыборки(Выборка, ВерхнийУровеньДерева);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыВыборки(ТекущаяВыборка, ТекущийУровеньДерева)
	
	
	Пока ТекущаяВыборка.Следующий() Цикл
		НоваяСтрока = ТекущийУровеньДерева.Добавить();

		Если ТекущаяВыборка.ТипЗаписи() = ТипЗаписиЗапроса.ДетальнаяЗапись Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяВыборка);
			НоваяСтрока.Ссылка = ТекущаяВыборка.Номенклатура;
			НоваяСтрока.КартинкаСтроки = 2;
		Иначе
			
			НоваяСтрока.Ссылка       = ТекущаяВыборка.Группа;
			НоваяСтрока.ЭтоГруппа    = Истина;
			НоваяСтрока.КартинкаСтроки = 0;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.Ссылка) Тогда
				НоваяСтрока.Наименование = НСтр("ru = '<без группы>'");	
			Иначе
				НоваяСтрока.Наименование = ТекущаяВыборка.Группа;
			КонецЕсли;
			
			Если ТекущаяВыборка.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоИерархии Тогда
				Выборка = ТекущаяВыборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, ТекущаяВыборка.Группировка());
			Иначе
				Выборка = ТекущаяВыборка.Выбрать();
			КонецЕсли;
			
			ДобавитьЭлементыВыборки(Выборка, НоваяСтрока.ПолучитьЭлементы());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьТекущуюСтроку(ТекущиеДанные = Неопределено)
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекущиеДанные = Элементы.НоменклатураЗначки.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено
		Или ТекущиеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийЗначок) Тогда
		ТекущееЗначокПояснение   = Неопределено;
		ТекущийЗначокДействуетДо = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийЗначокДействуетДо) Тогда
		ТекущийСрокДействия = "Бессрочно";
	Иначе
		ТекущийСрокДействия = "ДействуетДо";
	КонецЕсли;
	
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		ТекущиеДанные.Значок               = Неопределено;
		ТекущиеДанные.ЗначокПояснение      = Неопределено;
		ТекущиеДанные.ЗначокДействуетДо    = Неопределено;
	Иначе
		ТекущиеДанные.Значок               = ТекущийЗначок;
		ТекущиеДанные.ЗначокПояснение      = ТекущееЗначокПояснение;
		ТекущиеДанные.ЗначокДействуетДо    = ТекущийЗначокДействуетДо;
		ТекущиеДанные.ЕстьИзменения        = Истина;
		Модифицированность                 = Истина;
	КонецЕсли;
	
	НастроитьЭлементы();

КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияНаСервере()

	Для Каждого СтрокаНоменклатуры Из НоменклатураЗначки.ПолучитьЭлементы() Цикл
		ЗаписатьСтроку(СтрокаНоменклатуры);
	КонецЦикла;
	
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьСтроку(СтрокаНоменклатуры)
	
	Если СтрокаНоменклатуры.ЕстьИзменения Тогда
		
		Если Не СтрокаНоменклатуры.ЭтоГруппа Тогда
			НоменклатураОбъект = СтрокаНоменклатуры.Ссылка.ПолучитьОбъект();

			УдалитьЗначениеДопРеквизита(НоменклатураОбъект, Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры());
			УдалитьЗначениеДопРеквизита(НоменклатураОбъект, Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокПояснениеНоменклатуры());
			УдалитьЗначениеДопРеквизита(НоменклатураОбъект, Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокДействуетДоНоменклатуры());
			
			Если ЗначениеЗаполнено(СтрокаНоменклатуры.Значок) Тогда
				
				НоваяСтрока = НоменклатураОбъект.ДополнительныеРеквизиты.Добавить();
				НоваяСтрока.Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры();
				НоваяСтрока.Значение = СтрокаНоменклатуры.Значок;
				
				СтрокаНоменклатуры.ЗначокПояснение = СокрЛП(СтрокаНоменклатуры.ЗначокПояснение);
				
				Если ЗначениеЗаполнено(СтрокаНоменклатуры.ЗначокПояснение) Тогда
					НоваяСтрока = НоменклатураОбъект.ДополнительныеРеквизиты.Добавить();
					НоваяСтрока.Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокПояснениеНоменклатуры();
					НоваяСтрока.Значение = СтрокаНоменклатуры.ЗначокПояснение;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаНоменклатуры.ЗначокДействуетДо) Тогда
					НоваяСтрока = НоменклатураОбъект.ДополнительныеРеквизиты.Добавить();
					НоваяСтрока.Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокДействуетДоНоменклатуры();
					НоваяСтрока.Значение = СтрокаНоменклатуры.ЗначокДействуетДо;
				КонецЕсли;
				
			КонецЕсли;
			
			НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
			НоменклатураОбъект.Записать();
		КонецЕсли;
		
		СтрокаНоменклатуры.ЕстьИзменения = Ложь;
	КонецЕсли;

	Если СтрокаНоменклатуры.ЭтоГруппа Тогда
		Для Каждого ПодчиненныйЭлемент Из СтрокаНоменклатуры.ПолучитьЭлементы() Цикл
			ЗаписатьСтроку(ПодчиненныйЭлемент);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьЗначениеДопРеквизита(НоменклатураОбъект, ДопРеквизит)
	НайденныеСтроки = НоменклатураОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ДопРеквизит));
	
	Для Каждого СтрМас из НайденныеСтроки Цикл
		НоменклатураОбъект.ДополнительныеРеквизиты.Удалить(СтрМас);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьКешФильтров()

	ЗначенияФильтров = Новый Структура("ФильтрПоЗначку,ФильтрПоАктивности,ТекущийЗначок");
	ЗаполнитьЗначенияСвойств(ЗначенияФильтров, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении()
	
	Если Модифицированность Тогда
		ВопросСохранитьИзмененияПродолжение = Новый ОписаниеОповещения("ВопросСохранитьПередЗаполнением", ЭтотОбъект);
		ПоказатьВопрос(
			ВопросСохранитьИзмененияПродолжение,
			НСтр("ru = 'Список товаров будет перезаполен. При этом будут потеряны сделанные изменения. Сохранить изменения?'"),
				РежимДиалогаВопрос.ДаНетОтмена,
				,
				,
				НСтр("ru = 'Маг1С'"));
		Возврат;	
	КонецЕсли;
	
	ОбновитьДеревоНоменклатурыКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьПередЗаполнением(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьИзмененияНаСервере();
		ОбновитьДеревоНоменклатурыКлиент();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ОбновитьДеревоНоменклатурыКлиент();
	Иначе
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияФильтров);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЭлементы()
	
	ТекущиеДанные = Элементы.НоменклатураЗначки.ТекущиеДанные;
	
	Элементы.ОтборПоЗначку.Доступность = ФильтрПоЗначку = "ТолькоТоварыСоЗначком";
	Элементы.ОтборПоЗначку.АвтоОтметкаНезаполненного = Элементы.ОтборПоЗначку.Доступность;
	
КонецПроцедуры

#КонецОбласти
