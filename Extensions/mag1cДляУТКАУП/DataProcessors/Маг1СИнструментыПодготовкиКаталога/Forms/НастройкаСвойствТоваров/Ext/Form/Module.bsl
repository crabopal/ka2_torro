#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	Элементы.ГруппаПредупреждение.Видимость = Ложь;
	
	НастройкиУчетнойСистемы       = Параметры.НастройкиУчетнойСистемы;
	НастройкиВитрины              = Параметры.НастройкиВитрины;
	
	Для Каждого КлючЗначение из НастройкиВитрины.ДополнительныеНастройки.ВыгружаемыеСвойстваТоваров Цикл
		ДобавитьСвойствоВТаблицу(КлючЗначение.Ключ, КлючЗначение.Значение.Порядок, КлючЗначение.Значение.ИспользоватьДляФильтра);
	КонецЦикла;
	
	ВыгружаемыеСвойстваТоваров.Сортировать("Порядок");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ДобавитьСвойствоВТаблицу(ВыбранноеЗначение, Неопределено, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
	ОткрытьФормуВыбораСвойств(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Соответствие;
	Для Каждого СтрТабл из ВыгружаемыеСвойстваТоваров Цикл
		НастройкаСвойства = Маг1СИнтеграцияСлужебныйКлиентСервер.СтруктураНастройкиСвойстваТовара();
		ЗаполнитьЗначенияСвойств(НастройкаСвойства,СтрТабл);
		НастройкаСвойства.Порядок = ВыгружаемыеСвойстваТоваров.Индекс(СтрТабл);
		Результат.Вставить(СтрТабл.СвойствоТовара, НастройкаСвойства);
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыВыгружаемыеСвойстваТоваров

&НаКлиенте
Процедура ВыгружаемыеСвойстваТоваровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не (Поле = Элементы.ВыгружаемыеСвойстваТоваровПредставление
			Или Поле = Элементы.ВыгружаемыеСвойстваТоваровНаборРеквизитов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Элемент.ТекущиеДанные.СвойствоТовара) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
		ОткрытьФорму("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ФормаОбъекта",
					Новый Структура("Ключ", Элемент.ТекущиеДанные.СвойствоТовара),
					,
					,
					,
					,
					,
					 );
	Иначе
		ОткрытьФорму("Обработка.Маг1СИнструментыПодготовкиКаталога.Форма.ИнформацияОРеквизите",
					Новый Структура("СвойствоТовара, НастройкиУчетнойСистемы", Элемент.ТекущиеДанные.СвойствоТовара, НастройкиУчетнойСистемы),
					,
					,
					,
					,
					,
					 );
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгружаемыеСвойстваТоваровПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	ОткрытьФормуВыбораСвойств(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыгружаемыеСвойстваТоваровПослеУдаления(Элемент)
	Элементы.ГруппаПредупреждение.Видимость = ВыгружаемыеСвойстваТоваров.НайтиСтроки(Новый Структура("ИндексКартинки", 1)).Количество() > 0;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьФормуВыбораСвойств(МножественныйВыбор)
	
	Перем ПараметрыМастера;
	
	ВыгружаемыеСвойстваТоваровПараметр = Новый Соответствие;
	
	Для Каждого СтрТабл из ВыгружаемыеСвойстваТоваров Цикл
		ВыгружаемыеСвойстваТоваровПараметр.Вставить(СтрТабл.СвойствоТовара, Истина);
	КонецЦикла;
	
	ПараметрыМастера = Новый Структура();
	ПараметрыМастера.Вставить("НастройкиВитрины", НастройкиВитрины);
	ПараметрыМастера.Вставить("НастройкиУчетнойСистемы", НастройкиУчетнойСистемы);
	ПараметрыМастера.Вставить("ЗакрыватьПриВыборе", Не МножественныйВыбор);
	ПараметрыМастера.Вставить("ВыгружаемыеСвойстваТоваров", ВыгружаемыеСвойстваТоваровПараметр);
	
	ОткрытьФорму("Обработка.Маг1СИнструментыПодготовкиКаталога.Форма.ВыборСвойствТоваров",
						ПараметрыМастера,
						ЭтотОбъект,
						,
						,
						,
						,
						 );
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСвойствоВТаблицу(ДобавляемоеСвойство, Порядок, ИспользоватьДляФильтра)
	
	Если Порядок = Неопределено
		 Или ИспользоватьДляФильтра = Неопределено Тогда 
			
		НайденныеСтроки = ВыгружаемыеСвойстваТоваров.НайтиСтроки(Новый Структура("СвойствоТовара", ДобавляемоеСвойство));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Элементы.ВыгружаемыеСвойстваТоваров.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ОписаниеСвойства = Маг1СИнтеграция.ОписаниеСвойства(ДобавляемоеСвойство);
	
	НоваяСтрока = ВыгружаемыеСвойстваТоваров.Добавить();
	НоваяСтрока.СвойствоТовара                  = ДобавляемоеСвойство;
	НоваяСтрока.Представление                   = ОписаниеСвойства.Наименование;
	НоваяСтрока.ДоступноИспользованиеДляФильтра = ОписаниеСвойства.ДоступноИспользованиеДляФильтра;
	НоваяСтрока.ИспользуетсяДляХарактеристик    = ОписаниеСвойства.ИспользуетсяДляХарактеристик;
	Если ОписаниеСвойства.ИспользуетсяДляХарактеристик
		И ОписаниеСвойства.ИспользуетсяДляНоменклатуры Тогда
		НоваяСтрока.ИндексКартинки = 1;
		Элементы.ГруппаПредупреждение.Видимость = Истина;
	КонецЕсли;
	
	Если Порядок <> Неопределено Тогда
		НоваяСтрока.Порядок = Порядок;
	КонецЕсли;
	
	Если ИспользоватьДляФильтра <> Неопределено
		И НоваяСтрока.ДоступноИспользованиеДляФильтра Тогда
		НоваяСтрока.ИспользоватьДляФильтра = ИспользоватьДляФильтра;
	КонецЕсли;
	
	НоваяСтрока.ПредставлениеНаборов = "(" + ОписаниеСвойства.ПредставлениеНаборов + ")";
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгружаемыеСвойстваТоваровИспользоватьДляФильтраПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ВыгружаемыеСвойстваТоваров.ТекущиеДанные;
	
	Если ТекущиеДанные.ИспользоватьДляФильтра
		И Не ТекущиеДанные.ДоступноИспользованиеДляФильтра Тогда
		
		ТекущиеДанные.ИспользоватьДляФильтра = Ложь;
		
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
					НСтр("ru = '<span style="""">Реквизит нельзя использовать для фильтра на витрине, потому что он строкового типа.</span>'"));
		
		ПоказатьПредупреждение(,ТекстПредупреждения);
		
	КонецЕсли;
	
КонецПроцедуры

