#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	НастройкиУчетнойСистемы       = Параметры.НастройкиУчетнойСистемы;
	НастройкиВитрины              = Параметры.НастройкиВитрины;
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	ВыгружаемыеСвойстваТоваров	  = Новый ФиксированноеСоответствие(Параметры.ВыгружаемыеСвойстваТоваров);
	
	ДопРеквизиты = ДопРеквизиты();
	
	СтрокаНоменклатуры = ДеревоСвойствТоваров.ПолучитьЭлементы().Добавить();
	ДобавитьРеквизитыИДопРеквизиты(СтрокаНоменклатуры, Маг1СПеречисления.ИменаСправочников_Номенклатура(), ДопРеквизиты.НаборыНоменклатуры);
	
	ИмяСправочникаХарактеристик = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
	Если ПустаяСтрока(ИмяСправочникаХарактеристик) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаХарактеристик = ДеревоСвойствТоваров.ПолучитьЭлементы().Добавить();
	ДобавитьРеквизитыИДопРеквизиты(СтрокаХарактеристик, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры(), ДопРеквизиты.НаборыХарактеристикНоменклатуры);
	Если СтрокаХарактеристик.ПолучитьЭлементы().Количество() = 0 Тогда
		ДеревоСвойствТоваров.ПолучитьЭлементы().Удалить(СтрокаХарактеристик);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	ТекущиеДанные = Элементы.ДеревоСвойствТоваров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СвойствоТовара) Тогда
		ОповеститьОВыборе(ТекущиеДанные.СвойствоТовара)
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьИнформацию(Команда)
	
	ТекущиеДанные = Элементы.ДеревоСвойствТоваров.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СвойствоТовара) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.СвойствоТовара) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
		ОткрытьФорму("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ФормаОбъекта",
					Новый Структура("Ключ", ТекущиеДанные.СвойствоТовара),
					,
					,
					,
					,
					,
					 );
	Иначе
		ОткрытьФорму("Обработка.Маг1СИнструментыПодготовкиКаталога.Форма.ИнформацияОРеквизите",
					Новый Структура("СвойствоТовара, НастройкиУчетнойСистемы", ТекущиеДанные.СвойствоТовара, НастройкиУчетнойСистемы),
					,
					,
					,
					,
					,
					 );
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыДеревоСвойствТоваров

&НаКлиенте
Процедура ДеревоСвойствТоваровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.СвойствоТовара) Тогда
		ОповеститьОВыборе(Элемент.ТекущиеДанные.СвойствоТовара);
		Элемент.ТекущиеДанные.Выбран = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоСвойствТоваровПредставление.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоСвойствТоваров.Выбран");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ШрифтВыделения = Новый Шрифт(,,Истина,Ложь,Ложь,Ложь,100);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтВыделения);
	//
	
КонецПроцедуры


&НаСервере
Функция ДобавитьРеквизитыИДопРеквизиты(СтрокаДерева, ИмяСправочника, НаборыСвойств)
	
	МетаданныеСправочника      = НастройкиУчетнойСистемы[ИмяСправочника].Значение.Метаданные();
	
	СтрокаДерева.Представление = Маг1СИнтеграция.ОписаниеСвойства(МетаданныеСправочника.Имя + ".Наименование",
										Истина).ПредставлениеНаборов;
	
	Для Каждого ОписаниеРеквизита из МетаданныеСправочника.Реквизиты Цикл
		Если СтрНачинаетсяС(ОписаниеРеквизита.Имя, "Удалить")
			Или НастройкиУчетнойСистемы[ИмяСправочника].Реквизиты.Свойство(ОписаниеРеквизита.Имя) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизита = МетаданныеСправочника.Имя + "." + ОписаниеРеквизита.Имя;
		ОписаниеСвойства = Маг1СИнтеграция.ОписаниеСвойства(ИмяРеквизита, Истина);
		Если ОписаниеСвойства.Метаданные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ВключеноПоФО(ОписаниеРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОписаниеСвойства.Метаданные <> Неопределено
			И ОписаниеСвойства.Метаданные <> ""
			И Не ВключеноПоФО(ОписаниеСвойства.Метаданные) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СтрокаДерева.ПолучитьЭлементы().Добавить();
		НоваяСтрока.СвойствоТовара      = ИмяРеквизита;
		НоваяСтрока.Представление       = ОписаниеСвойства.Наименование;
		НоваяСтрока.Выбран              = РеквизитВыбран(НоваяСтрока.СвойствоТовара);
	КонецЦикла;
	
	Для Каждого КлючЗначение из НаборыСвойств Цикл
		
		СтрокаНабора = Неопределено;
		
		Если КлючЗначение.Ключ = НастройкиУчетнойСистемы[ИмяСправочника].НаборДопРеквизитов Тогда
			КоллекцияЭлементов = СтрокаДерева.ПолучитьЭлементы();
		Иначе
			СтрокаНабора = СтрокаДерева.ПолучитьЭлементы().Добавить();
			СтрокаНабора.Представление = КлючЗначение.Ключ;
			
			КоллекцияЭлементов = СтрокаНабора.ПолучитьЭлементы();
		КонецЕсли;
		
		Для Каждого Свойство из КлючЗначение.Значение Цикл
			ОписаниеСвойства = Маг1СИнтеграция.ОписаниеСвойства(Свойство, Истина);
			
			Если ОписаниеСвойства.Метаданные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИсключитьИзПубликацииНаВебВитринеMag1c()
				Или Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры() 
				Или Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокПояснениеНоменклатуры() 
				Или Свойство = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокДействуетДоНоменклатуры() Тогда 
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = КоллекцияЭлементов.Добавить();
			НоваяСтрока.СвойствоТовара = Свойство;
			НоваяСтрока.Представление  = ОписаниеСвойства.Наименование;
			НоваяСтрока.Выбран         = РеквизитВыбран(НоваяСтрока.СвойствоТовара);
		КонецЦикла;
		
		Если СтрокаНабора <> Неопределено
			И СтрокаНабора.ПолучитьЭлементы().Количество() = 0 Тогда
			
			СтрокаДерева.ПолучитьЭлементы().Удалить(СтрокаНабора);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция РеквизитВыбран(СвойствоТовара)
	Возврат ВыгружаемыеСвойстваТоваров.Получить(СвойствоТовара) <> Неопределено
КонецФункции

&НаСервере
Функция ДопРеквизиты()
	
	Результат = Новый Структура;
	Результат.Вставить("НаборыНоменклатуры", Новый Соответствие);
	Результат.Вставить("НаборыХарактеристикНоменклатуры", Новый Соответствие);
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Маг1СИнтеграция.СформироватьВТПубликуемаяНоменклатура(МенеджерВременныхТаблиц, НастройкиФильтровНоменклатуры);
	
	ИмяСправочникаХарактеристик = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиНоменклатуры());
	
	Запрос = Новый Запрос;
	
	Если Не ПустаяСтрока(ИмяСправочникаХарактеристик) Тогда
		
		ТекстыВыборкиНаборовСвойств = Новый Массив();
		
		ТекстыВыборкиНаборовСвойств.Добавить(
			"ВЫБРАТЬ
			|	&ОбщийНаборНоменклатуры КАК НаборСвойств,
			|	ЛОЖЬ КАК ЭтоНаборХарактеристик,
			|	0 КАК Порядок");
		
		Если Не ПустаяСтрока(НастройкиУчетнойСистемы.Номенклатура.Реквизиты.НаборСвойств) Тогда
			ТекстыВыборкиНаборовСвойств.Добавить(
				"ВЫБРАТЬ
				|		ВТПубликуемаяНоменклатура.Номенклатура.ИмяРеквизитаНабораСвойствНоменклатуры КАК НаборСвойств,
				|		ЛОЖЬ КАК ЭтоНаборХарактеристик,
				|		1 КАК Порядок
				|	ИЗ
				|		ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура");
		КонецЕсли;
		
		Если НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.НаборДопРеквизитов <> Маг1СИнтеграция.ГруппаНаборовДопРеквизитов(НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.НаборДопРеквизитов) Тогда
			ТекстыВыборкиНаборовСвойств.Добавить(
				"ВЫБРАТЬ
				|		&ОбщийНаборХарактеристик,
				|		ИСТИНА,
				|		0");
			Запрос.УстановитьПараметр("ОбщийНаборХарактеристик", НастройкиУчетнойСистемы.ХарактеристикиНоменклатуры.НаборДопРеквизитов);	
		КонецЕсли;
		
		Для Каждого КлючЗначение из НастройкиУчетнойСистемы.Номенклатура.РеквизитыВладельцаХарактеристик Цикл
			ТекстВыборкиНабора =
				"ВЫБРАТЬ
				|	ВТПубликуемаяНоменклатура.Номенклатура.#ИмяРеквизитаНаборСвойств КАК НаборСвойств,
				|	ИСТИНА КАК ЭтоНаборХарактеристик,
				|		1 КАК Порядок
				|ИЗ
				|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура";
			
			ТекстВыборкиНабора = СтрЗаменить(ТекстВыборкиНабора, "#ИмяРеквизитаНаборСвойств",КлючЗначение.Значение);
			
			ТекстыВыборкиНаборовСвойств.Добавить(ТекстВыборкиНабора);
			
		КонецЦикла;
		
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВложенныйЗапрос.НаборСвойств КАК НаборСвойств,
			|	ВложенныйЗапрос.ЭтоНаборХарактеристик КАК ЭтоНаборХарактеристик,
			|	ВложенныйЗапрос.Порядок КАК Порядок
			|ПОМЕСТИТЬ ВТНаборыСвойств
			|ИЗ
			|	(#ТекстВыборкиНаборовСвойств) КАК ВложенныйЗапрос";
		
		Разделитель = 
			"
			|ОБЪЕДИНИТЬ ВСЕ
			|";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ТекстВыборкиНаборовСвойств", СтрСоединить(ТекстыВыборкиНаборовСвойств, Разделитель));
		
	Иначе
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	&ОбщийНаборНоменклатуры КАК НаборСвойств,
			|	ЛОЖЬ КАК ЭтоНаборХарактеристик,
			|	0 КАК Порядок
			|ПОМЕСТИТЬ ВТНаборыСвойств";
		
		Если Не ПустаяСтрока(НастройкиУчетнойСистемы.Номенклатура.Реквизиты.НаборСвойств) Тогда
			ТекстЗапроса = ТекстЗапроса + 
				"
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ВТПубликуемаяНоменклатура.Номенклатура.ИмяРеквизитаНабораСвойствНоменклатуры КАК НаборСвойств,
				|	ЛОЖЬ КАК ЭтоНаборХарактеристик,
				|	1 КАК Порядок
				|ИЗ
				|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура";
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяРеквизитаНабораСвойствНоменклатуры", НастройкиУчетнойСистемы.Номенклатура.Реквизиты.НаборСвойств);
	Запрос.УстановитьПараметр("ОбщийНаборНоменклатуры", НастройкиУчетнойСистемы.Номенклатура.НаборДопРеквизитов);	
	
	ТекстЗапроса = ТекстЗапроса +
		"
		| ;
		|";
	
	ТекстЗапроса = ТекстЗапроса +
		"ВЫБРАТЬ
		|	НаборыДополнительныхРеквизитов.Ссылка КАК НаборСвойств,
		|	НаборыДополнительныхРеквизитов.Свойство КАК Свойство,
		|	ВТНаборыСвойств.ЭтоНаборХарактеристик КАК ЭтоНаборХарактеристик
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНаборыСвойств КАК ВТНаборыСвойств
		|		ПО НаборыДополнительныхРеквизитов.Ссылка = ВТНаборыСвойств.НаборСвойств
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВТНаборыСвойств.Порядок,
		|	НаборыДополнительныхРеквизитов.Ссылка.Наименование,
		|	НаборыДополнительныхРеквизитов.Свойство.Наименование";
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоНаборХарактеристик Тогда
			ОписаниеНаборов = Результат.НаборыХарактеристикНоменклатуры;
		Иначе
			ОписаниеНаборов = Результат.НаборыНоменклатуры;
		КонецЕсли;
		
		Если ОписаниеНаборов.Получить(Выборка.НаборСвойств) = Неопределено Тогда
			ОписаниеНаборов.Вставить(Выборка.НаборСвойств, Новый Массив);
		КонецЕсли;
		
		ОписаниеНаборов[Выборка.НаборСвойств].Добавить(Выборка.Свойство);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВключеноПоФО(ОбъектМетаданных)
	
	ВходитВФО = Ложь;
	Для Каждого ОписаниеФО из Метаданные.ФункциональныеОпции Цикл
		Если ОписаниеФО.Состав.Содержит(ОбъектМетаданных) Тогда
			ВходитВФО = Истина;
			Если ПолучитьФункциональнуюОпцию(ОписаниеФО.Имя) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Не ВходитВФО;
	
КонецФункции

#КонецОбласти
