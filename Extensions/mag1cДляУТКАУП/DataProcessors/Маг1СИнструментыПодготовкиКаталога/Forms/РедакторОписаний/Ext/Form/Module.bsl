#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НастройкиУчетнойСистемы       = Параметры.НастройкиУчетнойСистемы;
	НастройкиВитрины              = Параметры.НастройкиВитрины;
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	
	ИскатьВНазвании = Истина;
	ИскатьВОписании = Истина;
	ФильтрПоАктивности           = Маг1СПеречисления.РежимыФильтраПоАктивности_ВсеТовары();
	
	МетаданныеСправочника = НастройкиУчетнойСистемы.Номенклатура.ОграничениеТипа.ПривестиЗначение().Метаданные();
	
	МетаданныеРеквизитаНаименование = МетаданныеСправочника.Реквизиты.Найти(НастройкиУчетнойСистемы.Номенклатура.Реквизиты.НаименованиеПолное);
	
	Элементы.НоменклатураУточнениеОписанийНаименование.Заголовок = МетаданныеРеквизитаНаименование.Синоним;
	Элементы.ТекстНаименования.Заголовок 						 = МетаданныеРеквизитаНаименование.Синоним;
	
	МетаданныеРеквизитаОписание = МетаданныеСправочника.Реквизиты.Найти(НастройкиУчетнойСистемы.Номенклатура.Реквизиты.Описание);
	
	Элементы.НоменклатураУточнениеОписанийОписание.Заголовок = МетаданныеРеквизитаОписание.Синоним;
	Элементы.ТекстОписания.Заголовок 						 = МетаданныеРеквизитаОписание.Синоним;
	
	Если НастройкиВитрины.ДополнительныеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ГруппыНоменклатуры() Тогда
		ЕстьКодУКатегории = Истина;
	Иначе
		МетаданныеСправочникаКатегорий = НастройкиУчетнойСистемы.ВидНоменклатуры.ОграничениеТипа.ПривестиЗначение().Метаданные();
		
		ЕстьКодУКатегории = МетаданныеСправочникаКатегорий.ДлинаКода <> 0; 
		
	КонецЕсли;
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.НастроитьЭлементФильтрАктиности(Элементы.ФильтрПоАктивности, НастройкиВитрины);
	
	ОбновитьНоменклатуруУточнениеОписаний();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьЭлементыКодаАртикула();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Модифицированность Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		ВопросСохранитьИзмененияПродолжение = Новый ОписаниеОповещения("ВопросСохранитьИзмененияПриЗакрытии", ЭтотОбъект);
		ПоказатьВопрос(
			ВопросСохранитьИзмененияПродолжение,
			НСтр("ru = 'Сохранить изменения перед закрытием?'"),
			РежимДиалогаВопрос.ДаНетОтмена,
			,
			,
			НСтр("ru = 'Маг1С'"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьСкрытьКодыИАртикулы(Команда)
	ПоказатьКодАртикул = Не ПоказатьКодАртикул;
	НастроитьЭлементыКодаАртикула();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсе(Команда)
	СтрокаПоиска = "";
	ОбновитьНоменклатуруУточнениеОписаний();
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьВсе(Команда)
	
	Если Не ИскатьВНазвании
		И Не ИскатьВОписании Тогда
		Возврат;
	КонецЕсли;
	
	ЗаменитьВсеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаОчистка(Элемент, СтандартнаяОбработка)
	НайтиСтроку(Элементы.Найти);
КонецПроцедуры

&НаКлиенте
Процедура НайтиСтроку(Команда)
	
	Если Модифицированность Тогда
		ВопросСохранитьИзмененияПродолжение = Новый ОписаниеОповещения("ВопросСохранитьИзмененияПродолжение", ЭтотОбъект);
		ПоказатьВопрос(
			ВопросСохранитьИзмененияПродолжение,
			НСтр("ru = 'Сохранить изменения?'"),
			РежимДиалогаВопрос.ДаНетОтмена,
			,
			,
			НСтр("ru = 'Маг1С'"));
	Иначе
		ОбновитьНоменклатуруУточнениеОписаний();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Заменить(Команда)
	
	Если Не ИскатьВНазвании
		И Не ИскатьВОписании Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.НоменклатураУточнениеОписаний.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		
		ЗаменитьНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	
	СохранитьИзмененияНаСервере();
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Изменения сохранены'"),
		,
		,
		,
		СтатусОповещенияПользователя.Информация);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	СохранитьИзмененияНаСервере();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)
	
	ОповещениеОкончанияЗагрузкиФайла = Новый ОписаниеОповещения("ЗагрузитьИзExcelФайлЗагружен",
																ЭтотОбъект);
																
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Заголовок = НСтр("ru = 'Выберите файл с описаниями товаров'");
	ПараметрыЗагрузки.Диалог.Фильтр = "Файл Microsoft Excel (*.xls)|*.xls";
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(ОповещениеОкончанияЗагрузкиФайла, ПараметрыЗагрузки); 
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВExcel(Команда)
	АдресФайла = ВыгрузитьВExcelНаСервере();
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьВExcelЗавершение", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("АдресФайла", АдресФайла);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Сохранить файл описания товаров'");
	ПараметрыСохранения.Диалог.Фильтр = "Файл Microsoft Excel (*.xls)|*.xls";
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресФайла, НСтр("ru = 'ОписанияТоваров.xls'"), ПараметрыСохранения);
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзменения(Команда)
	Если Не Модифицированность Тогда
		Возврат;
	Иначе
		ВопросОтменитьИзмененияПродолжение = Новый ОписаниеОповещения("ОтметитьИзмененияЗавершение", ЭтотОбъект);
		ПоказатьВопрос(
			ВопросОтменитьИзмененияПродолжение,
			НСтр("ru = 'Отметить сделанные изменения?'"),
				РежимДиалогаВопрос.ДаНет,
				,
				,
				НСтр("ru = 'Маг1С'"));
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьИзмененияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбновитьДеревоНоменклатурыКлиент();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	Тема  = НСтр("ru = 'Подключение к mag1c. Редактор описаний'");
	Текст = НСтр("ru = 'При работе с редактором описаний возникла следующая проблема'");
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																			   НастройкиВитрины.ОсновныеНастройки.ИмяВитрины,
								                                               НастройкиВитрины.ЛогинИПП,
																			   Тема,
																			   Текст);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураУточнениеОписанийПриАктивизацииСтроки(Элемент)
	
	Если Элементы.НоменклатураУточнениеОписаний.ТекущиеДанные = Неопределено Тогда
		ТекстОписания.Удалить();
		ТекстНаименования.Удалить();
		Возврат;
	КонецЕсли;
	
	НоменклатураУточнениеОписанийПриАктивизацииСтрокиНаСервере(
		Элементы.НоменклатураУточнениеОписаний.ТекущиеДанные.Наименование,
		Элементы.НоменклатураУточнениеОписаний.ТекущиеДанные.Описание,
		СтрокаПоиска);
		
КонецПроцедуры

&НаКлиенте
Процедура ТекстОписанияПриИзменении(Элемент)
	
	СохранитьОписаниеТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстНаименованияПриИзменении(Элемент)
	СохранитьОписаниеТекущейСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПоАктивностиПриИзменении(Элемент)
	
	Если Модифицированность Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		ВопросСохранитьИзмененияПродолжение = Новый ОписаниеОповещения("ВопросСохранитьПередЗаполнением", ЭтотОбъект);
		ПоказатьВопрос(
			ВопросСохранитьИзмененияПродолжение,
			НСтр("ru = 'Список товаров будет перезаполен. При этом будут потеряны сделанные изменения. Сохранить изменения?'"),
				РежимДиалогаВопрос.ДаНетОтмена,
				,
				,
				НСтр("ru = 'Маг1С'"));
		Возврат;	
	КонецЕсли;
	
	ОбновитьДеревоНоменклатурыКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыНоменклатураУточнениеОписаний

&НаКлиенте
Процедура НоменклатураУточнениеОписанийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элемент.ДанныеСтроки(ВыбраннаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураУточнениеОписанийНаименованиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НоменклатураУточнениеОписаний.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные.ЕстьИзменения = Истина;
	Модифицированность = Истина;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураУточнениеОписанийОписаниеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НоменклатураУточнениеОписаний.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ЕстьИзменения = Истина;
	Модифицированность = Истина;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастроитьЭлементыКодаАртикула()
	Если ПоказатьКодАртикул Тогда
		Элементы.ПоказатьСкрытьКодыИАртикулы.Заголовок = НСтр("ru = 'Скрыть коды и артикулы'");
	Иначе
		Элементы.ПоказатьСкрытьКодыИАртикулы.Заголовок = НСтр("ru = 'Показать коды и артикулы'");
	КонецЕсли;
	
	Элементы.НоменклатураУточнениеОписанийГруппаКодАртикул.Видимость = ПоказатьКодАртикул;

КонецПроцедуры

#Область РаботаСExcel

&НаСервере
Функция ВыгрузитьВExcelНаСервере()
	
	ТабДок = Новый ТабличныйДокумент();
	
	Макет = Обработки.Маг1СИнструментыПодготовкиКаталога.ПолучитьМакет("ВыгрузкаОписаний");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьГруппа = Макет.ПолучитьОбласть("Группа");
	ТабДок.Вывести(ОбластьШапка);
	
	ЭлементыНулевогоУровня = НоменклатураУточнениеОписаний.ПолучитьЭлементы();
	
	ТабДок.НачатьАвтогруппировкуСтрок();
	Для Каждого ЭлементТекущегоУровня из ЭлементыНулевогоУровня Цикл
		 ВывестиЭлементыВТабличныйДокумент(ЭлементТекущегоУровня, 0, ТабДок, ОбластьСтрока, ОбластьГруппа);	
	КонецЦикла;
	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xls");
	ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLS);
	
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), УникальныйИдентификатор);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Маг1С: Редактирование описаний товаров'"),
			УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Возврат АдресФайла;
	
КонецФункции

&НаСервере
Процедура ВывестиЭлементыВТабличныйДокумент(ЭлементТекущегоУровня, ТекущийУровень, ТабДок, ОбластьСтрока, ОбластьГруппа)
	
	ПредставлениеСсылки = Строка(ЭлементТекущегоУровня.Ссылка.УникальныйИдентификатор());
	
	Если ЭлементТекущегоУровня.ЭтоГруппа Тогда
		ОбластьМакета = ОбластьГруппа;
	Иначе
		ОбластьМакета = ОбластьСтрока;
	КонецЕсли;
	
	ОбластьМакета.Параметры.Заполнить(ЭлементТекущегоУровня);
	ОбластьМакета.Параметры.Ссылка = ПредставлениеСсылки;
	ТабДок.Вывести(ОбластьМакета, ТекущийУровень);
	
	Если Не ЭлементТекущегоУровня.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыСледующегоУровня = ЭлементТекущегоУровня.ПолучитьЭлементы();
	
	Для Каждого ЭлементСледующегоУровня из ЭлементыСледующегоУровня Цикл
		 ВывестиЭлементыВТабличныйДокумент(ЭлементСледующегоУровня, ТекущийУровень + 1, ТабДок, ОбластьСтрока, ОбластьГруппа);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВExcelЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	УдалитьИзВременногоХранилища(ДополнительныеПараметры.АдресФайла);
	
	Если ПолученныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОткрытияФайла = Новый ОписаниеОповещения(
		"ФайлОписанийСохраненЗавершение",
		ЭтотОбъект,
		Новый Структура("ПутьКФайлу",  ПолученныеФайлы[0].ПолноеИмя));
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Файл успешно сохранен'"),
		ОповещениеОткрытияФайла,
		ПолученныеФайлы[0].ПолноеИмя,
		БиблиотекаКартинок["Информация32"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлОписанийСохраненЗавершение(ДополнительныеПараметры) Экспорт
	
	ФайловаяСистемаКлиент.ОткрытьФайл(ДополнительныеПараметры.ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзExcelФайлЗагружен(ПомещенныйФайл, ДополнительныеПараметры) Экспорт
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьИзExcelНаСервере(ПомещенныйФайл.Хранение)
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзExcelНаСервере(АдресФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяФайла = ПолучитьИмяВременногоФайла("xls");
	ДвоичныеДанные.Записать(ИмяФайла);
	
	Попытка
		ТабДок = Новый ТабличныйДокумент();
		ТабДок.Прочитать(ИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Исключение
		УдалитьФайлы(ИмяФайла);
		Информация = ИнформацияОбОшибке();
		
		ПодробноеПредставлениеОшибки =  ПодробноеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Маг1С: Редактирование описаний товаров'"),
			УровеньЖурналаРегистрации.Ошибка, , ,ПодробноеПредставлениеОшибки);
		ТекстСообщения = НСтр("ru = 'Ошибка чтения файла на сервере:%ПодробноеПредставлениеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ПодробноеПредставлениеОшибки%", ПодробноеПредставлениеОшибки);
		ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки);
		Возврат;
	КонецПопытки;
		
	КолонкаНаименование = 1;
	КолонкаОписание     = 2;
	
	Если ТабДок.Область(1,3).Текст = "Ссылка" Тогда
		КолонкаСсылка       = 3;
	Иначе
		КолонкаСсылка       = 4;
	КонецЕсли;
	
	Если ТабДок.Область(1,3).Текст = "Артикул" Тогда
		КолонкаАртикул      = 3;
	Иначе
		КолонкаАртикул      = 0;
	КонецЕсли;

	
	Если ТабДок.ВысотаТаблицы < 2 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Файл пустой.'"));
		Возврат;
	КонецЕсли;
	
	Если ТабДок.ШиринаТаблицы < 3
		Или ТабДок.Область(1,КолонкаНаименование).Текст <> "Наименование"
		Или ТабДок.Область(1,КолонкаОписание).Текст <> "Описание"
		Или ТабДок.Область(1,КолонкаСсылка).Текст <> "Ссылка" Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Загрузить описания можно только из файла, который был получен при помощи команды ""Выгрузить в Excel"" в этом редакторе.'"));
		Возврат;
	КонецЕсли;
	
	ИмяСправочникаНоменклатура         =  Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура()); 
	ИмяСправочникаГруппыНоменклатуры   =  ИмяСправочникаНоменклатура;
	Если НастройкиВитрины.ДополнительныеНастройки.ИерархияПо = Маг1СПеречисления.ИерархияПо_ВидыНоменклатуры() Тогда
		ИмяСправочникаГруппыНоменклатуры   =  Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ВидНоменклатуры());
	КонецЕсли;
	
	ТаблицаОписанийИзФайла = Новый ТаблицаЗначений;
	ТаблицаОписанийИзФайла.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ТаблицаОписанийИзФайла.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Если КолонкаАртикул > 0 Тогда
		ТаблицаОписанийИзФайла.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	ИменаТиповСсылки = "СправочникСсылка." + ИмяСправочникаНоменклатура; 
	
	Если ИмяСправочникаНоменклатура <> ИмяСправочникаГруппыНоменклатуры
		И Не ПустаяСтрока(ИмяСправочникаГруппыНоменклатуры) Тогда
		
		ИменаТиповСсылки = ИменаТиповСсылки + ",СправочникСсылка." + ИмяСправочникаГруппыНоменклатуры;
	КонецЕсли;
	
	ТаблицаОписанийИзФайла.Колонки.Добавить("Ссылка", Новый ОписаниеТипов(ИменаТиповСсылки));
	
	Для Индекс = 2 По ТабДок.ВысотаТаблицы Цикл
		СсылкаТекст = ТабДок.Область(Индекс,КолонкаСсылка).Текст;
		
		Если Не ЗначениеЗаполнено(СсылкаТекст) Тогда
			ТекстСообщения = НСтр("ru = 'В строке %НомерСтроки% нет значения ссылки. Строка при обработке пропущена.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Строка(Индекс)); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		Попытка
			УникальныйИдентификаторСсылки = Новый УникальныйИдентификатор(СсылкаТекст);
		Исключение
			ТекстСообщения = НСтр("ru = 'В строке %НомерСтроки% нет значения ссылки. Строка при обработке пропущена.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Строка(Индекс)); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецПопытки;
		
		СсылкаЗначение = Справочники[ИмяСправочникаНоменклатура].ПолучитьСсылку(УникальныйИдентификаторСсылки);
		
		Если Не ЗначениеЗаполнено(СсылкаЗначение)
			Или Не ОбщегоНазначения.СсылкаСуществует(СсылкаЗначение) Тогда 
			
			Если ИмяСправочникаНоменклатура <> ИмяСправочникаГруппыНоменклатуры
				И Не ПустаяСтрока(ИмяСправочникаГруппыНоменклатуры) Тогда
				
				СсылкаЗначение = Справочники[ИмяСправочникаГруппыНоменклатуры].ПолучитьСсылку(УникальныйИдентификаторСсылки);
				
				Если Не ЗначениеЗаполнено(СсылкаЗначение)
					Или Не ОбщегоНазначения.СсылкаСуществует(СсылкаЗначение) Тогда 
					ТекстСообщения = НСтр("ru = 'В строке %НомерСтроки% значение по ссылке не найдено. Строка при обработке пропущена.'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Строка(Индекс)); 
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					Продолжить;
				КонецЕсли;
			Иначе	
				ТекстСообщения = НСтр("ru = 'В строке %НомерСтроки% значение по ссылке не найдено. Строка при обработке пропущена.'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Строка(Индекс)); 
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПустаяСтрока(ТабДок.Область(Индекс,КолонкаНаименование).Текст) Тогда
			ТекстСообщения = НСтр("ru = 'В строке %НомерСтроки% не указано наименование. Строка при обработке пропущена.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%НомерСтроки%", Строка(Индекс)); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОписанийИзФайла.Добавить();
		НоваяСтрока.Наименование = ТабДок.Область(Индекс,КолонкаНаименование).Текст;
		НоваяСтрока.Описание = ТабДок.Область(Индекс,КолонкаОписание).Текст;
		НоваяСтрока.Ссылка = СсылкаЗначение;
		Если КолонкаАртикул > 0 Тогда
			НоваяСтрока.Артикул = ТабДок.Область(Индекс,КолонкаАртикул).Текст;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаОписанийИзФайла.Индексы.Добавить("Ссылка");
	
	СтрокаПоиска = "";
	ОбновитьНоменклатуруУточнениеОписаний(ТаблицаОписанийИзФайла);	
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Маг1С: Редактирование описаний товаров'"),
			УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаписатьСтроку(СтрокаНоменклатуры)
	
	Если СтрокаНоменклатуры.ЕстьИзменения Тогда
		
		Если НЕ СтрокаНоменклатуры.ЭтоГруппа Тогда
			ИзмененныеРеквизиты = Новый Структура(НастройкиУчетнойСистемы.Номенклатура.Реквизиты.НаименованиеПолное,
												СтрокаНоменклатуры.Наименование);
			ИзмененныеРеквизиты.Вставить(НастройкиУчетнойСистемы.Номенклатура.Реквизиты.Описание,
											СтрокаНоменклатуры.Описание);
			ИзмененныеРеквизиты.Вставить("Артикул", СтрокаНоменклатуры.Артикул);
		Иначе
			ИзмененныеРеквизиты = Новый Структура("Наименование", СтрокаНоменклатуры.Наименование);
		КонецЕсли;
		
		ЗаписатьТовар(ИзмененныеРеквизиты, СтрокаНоменклатуры.Ссылка);
		СтрокаНоменклатуры.ЕстьИзменения = Ложь;
	КонецЕсли;

	Если СтрокаНоменклатуры.ЭтоГруппа Тогда
		Для Каждого ПодчиненныйЭлемент Из СтрокаНоменклатуры.ПолучитьЭлементы() Цикл
			ЗаписатьСтроку(ПодчиненныйЭлемент);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьИзмененияПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьИзмененияНаСервере();
		ОбновитьНоменклатуруУточнениеОписаний();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ОбновитьНоменклатуруУточнениеОписаний();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьИзмененияПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьИзмененияНаСервере();
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьПередЗаполнением(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьИзмененияНаСервере();
		ОбновитьДеревоНоменклатурыКлиент();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ОбновитьДеревоНоменклатурыКлиент();
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена Тогда
		Если ФильтрПоАктивности = Маг1СПеречисления.РежимыФильтраПоАктивности_ВсеТовары() Тогда
			ФильтрПоАктивности = Маг1СПеречисления.РежимыФильтраПоАктивности_АктивныеТовары();
		Иначе
			ФильтрПоАктивности = Маг1СПеречисления.РежимыФильтраПоАктивности_ВсеТовары();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ЗаменитьВсеНаСервере()
	
	ЕстьИзменения = Ложь;
	
	Для Каждого СтрокаНоменклатуры Из НоменклатураУточнениеОписаний.ПолучитьЭлементы() Цикл
		ИзменитьСтроку(СтрокаНоменклатуры, ЕстьИзменения);
	КонецЦикла;
	
	Если ЕстьИзменения Тогда
		Модифицированность = Истина;
		УправлениеФормой(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСтроку(СтрокаНоменклатуры, ЕстьИзменения)
	
	ИзменитьОбъект(СтрокаНоменклатуры);
	ЕстьИзменения = Макс(СтрокаНоменклатуры.ЕстьИзменения, ЕстьИзменения);
	
	Если СтрокаНоменклатуры.ЭтоГруппа Тогда
		Для Каждого ПодчиненныйЭлемент Из СтрокаНоменклатуры.ПолучитьЭлементы() Цикл
			ИзменитьСтроку(ПодчиненныйЭлемент, ЕстьИзменения);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	Форма.Элементы.СохранитьИзменения.Доступность = Форма.Модифицированность;
	Форма.Элементы.ОтменитьИзменения.Доступность = Форма.Модифицированность;
КонецПроцедуры

&НаСервере
Процедура ОбновитьНоменклатуруУточнениеОписаний(ТаблицаНовыхОписаний = Неопределено)
	
	Если ЗначениеЗаполнено(СтрокаПоиска)
		И (ИскатьВНазвании ИЛИ ИскатьВОписании) Тогда
		
		УсловияПоиска = Новый Массив;
		Если ИскатьВНазвании Тогда
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Наименование Подобно %1", """%" + СтрокаПоиска + "%"""));
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Наименование Подобно %1", """" + СтрокаПоиска + "%"""));
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Наименование Подобно %1", """%" + СтрокаПоиска + """"));
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Наименование Подобно %1", """" + СтрокаПоиска + """"));
		КонецЕсли;
		Если ИскатьВОписании Тогда
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Описание Подобно %1", """%" + СтрокаПоиска + "%"""));
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Описание Подобно %1", """" + СтрокаПоиска + "%"""));
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Описание Подобно %1", """%" + СтрокаПоиска + """"));
			УсловияПоиска.Добавить(СтрШаблон("СпрНоменклатура.Описание Подобно %1", """" + СтрокаПоиска + """"));
		КонецЕсли;
		
		Условие = СтрСоединить(УсловияПоиска, " ИЛИ ");
		
	Иначе
		
		Условие = "";
		
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Маг1СИнтеграция.СформироватьВТПубликуемаяНоменклатура(МенеджерВременныхТаблиц,
														  НастройкиФильтровНоменклатуры,
														  Условие);
														  
	ТекстЗапроса =													  
	"ВЫБРАТЬ
	|	ВТПубликуемаяНоменклатура.Номенклатура КАК Номенклатура,
	|	ВТПубликуемаяНоменклатура.Наименование КАК Наименование,
	|	ВТПубликуемаяНоменклатура.Группа КАК Группа,
	|	ВТПубликуемаяНоменклатура.Код КАК Код,	
	|	ВТПубликуемаяНоменклатура.Артикул КАК Артикул,
	|	ВТПубликуемаяНоменклатура.Описание КАК Описание	
	|ИЗ
	|	ВТПубликуемаяНоменклатура КАК ВТПубликуемаяНоменклатура
	|ГДЕ
	|	&ТекстФильтраПоАктивности
	|
	|ИТОГИ ПО
	|	Группа ИЕРАРХИЯ";
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.ДобавитьФильтрПоАктивности(ФильтрПоАктивности,
																				ТекстЗапроса,
																				МенеджерВременныхТаблиц,
																				НастройкиФильтровНоменклатуры,
																				НастройкиВитрины,
																				НастройкиУчетнойСистемы);	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	
	НайденоЭлементов   = 0;
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Модифицированность = Ложь;
	МаксимальноеКоличествоУровнейПубликуемогоКаталога = 1;
	ВерхнийУровеньДерева = НоменклатураУточнениеОписаний.ПолучитьЭлементы();
	ВерхнийУровеньДерева.Очистить();
	
	ДобавитьЭлементыВыборки(Выборка, ВерхнийУровеньДерева, НайденоЭлементов, ТаблицаНовыхОписаний);
	
	Если Не ПустаяСтрока(СтрокаПоиска) Тогда
		
		Элементы.ГруппаНоменклатура.Заголовок = СтрокаСЧислом(
			НСтр("ru = 'Найдено %1 элементов;Найден %1 элемент;Найдено %1 элемента;Найдено %1 элементов; Найдено %1 элементов;Найдено %1 элементов'"),
			НайденоЭлементов,
			ВидЧисловогоЗначения.Количественное,
			"ЧН=0; ЧГ=0");
		
	Иначе
		Элементы.ГруппаНоменклатура.Заголовок = НСтр("ru = 'Номенклатура'");
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	НайтиСледующийНаСервере(Ложь);

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыВыборки(ТекущаяВыборка, ТекущийУровеньДерева, НайденоЭлементов, ТаблицаНовыхОписаний)
	
	ЕстьКолонкаАртикул = ТаблицаНовыхОписаний <> Неопределено
						И ТаблицаНовыхОписаний.Колонки.Найти("Артикул") <> Неопределено;
	
	Пока ТекущаяВыборка.Следующий() Цикл
		НоваяСтрока = ТекущийУровеньДерева.Добавить();
		МаксимальноеКоличествоУровнейПубликуемогоКаталога = Макс(МаксимальноеКоличествоУровнейПубликуемогоКаталога,
																	ТекущаяВыборка.Уровень()); 
		Если ТекущаяВыборка.ТипЗаписи() = ТипЗаписиЗапроса.ДетальнаяЗапись Тогда
			НайденоЭлементов = НайденоЭлементов + 1;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяВыборка);
			НоваяСтрока.Ссылка = ТекущаяВыборка.Номенклатура;
			НоваяСтрока.КартинкаСтроки = 0;
			
			Если ТаблицаНовыхОписаний <> Неопределено Тогда
				НайденныеСтроки = ТаблицаНовыхОписаний.НайтиСтроки(Новый Структура("Ссылка", ТекущаяВыборка.Номенклатура));
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					Если НоваяСтрока.Наименование <> НайденныеСтроки[0].Наименование
						Или НоваяСтрока.Описание <> НайденныеСтроки[0].Описание
						Или	ЕстьКолонкаАртикул 
							И НоваяСтрока.Артикул <> НайденныеСтроки[0].Артикул Тогда
						
						НоваяСтрока.Наименование  = НайденныеСтроки[0].Наименование;
					    НоваяСтрока.Описание      = НайденныеСтроки[0].Описание;
						
						Если ЕстьКолонкаАртикул Тогда
							НоваяСтрока.Артикул = НайденныеСтроки[0].Артикул;
						КонецЕсли;
						НоваяСтрока.ЕстьИзменения = Истина;
						
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		Иначе
			
			НоваяСтрока.Ссылка       = ТекущаяВыборка.Группа;
			НоваяСтрока.ЭтоГруппа    = Истина;
			НоваяСтрока.КартинкаСтроки = 1;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.Ссылка) Тогда
				НоваяСтрока.Наименование = НСтр("ru = '<без группы>'");
			Иначе
				
				Если ЕстьКодУКатегории Тогда
					РевизитыГруппы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяВыборка.Группа, "Код,Наименование");
					
					НоваяСтрока.Наименование = РевизитыГруппы.Наименование;
					НоваяСтрока.Код = РевизитыГруппы.Код;
				Иначе
					НоваяСтрока.Наименование =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяВыборка.Группа, "Наименование");
				КонецЕсли;
				
				Если ТаблицаНовыхОписаний <> Неопределено Тогда
					НайденныеСтроки = ТаблицаНовыхОписаний.НайтиСтроки(Новый Структура("Ссылка", ТекущаяВыборка.Группа));
					Если НайденныеСтроки.Количество() > 0 Тогда
						Если НоваяСтрока.Наименование <> НайденныеСтроки[0].Наименование Тогда
							НоваяСтрока.Наименование  = НайденныеСтроки[0].Наименование;
							НоваяСтрока.ЕстьИзменения = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ТекущаяВыборка.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоИерархии Тогда
				Выборка = ТекущаяВыборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, ТекущаяВыборка.Группировка());
			Иначе
				Выборка = ТекущаяВыборка.Выбрать();
			КонецЕсли;
			
			ДобавитьЭлементыВыборки(Выборка, НоваяСтрока.ПолучитьЭлементы(), НайденоЭлементов, ТаблицаНовыхОписаний);
			
		КонецЕсли;
		
		Если НоваяСтрока.ЕстьИзменения Тогда
			Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьНаСервере()
	
	ТекущаяСтрока = Элементы.НоменклатураУточнениеОписаний.ТекущаяСтрока;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЭлементДерева = НоменклатураУточнениеОписаний.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущийЭлементДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьОбъект(ТекущийЭлементДерева);
	
	НайтиСледующийЭлементПодходящий(ТекущийЭлементДерева, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьОбъект(ТекущийЭлементДерева)
	
	Если ИскатьВНазвании
		И СтрЗаменитьБезУчетаРегистра(ТекущийЭлементДерева.Наименование, СтрокаПоиска, СтрокаЗамены) Тогда
		ТекущийЭлементДерева.ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ИскатьВОписании
		И НЕ ТекущийЭлементДерева.ЭтоГруппа
		И СтрЗаменитьБезУчетаРегистра(ТекущийЭлементДерева.Описание, СтрокаПоиска, СтрокаЗамены) Тогда
		ТекущийЭлементДерева.ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ТекущийЭлементДерева.ЕстьИзменения Тогда
		ТекущийЭлементДерева.ЕстьИзменения = Истина;
		Модифицированность = Истина;
		УправлениеФормой(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтрЗаменитьБезУчетаРегистра(ИсходнаяСтрока, СтрокаПоиска, СтрокаЗамены)
	ЕстьИзменения = Ложь;
	СтрДлинаСтрокаПоиска   = СтрДлина(СтрокаПоиска);
	СтрДлинаИсходнаяСтрока = СтрДлина(ИсходнаяСтрока);
	
	Если СтрокаПоиска = СтрокаЗамены
		Или СтрДлинаСтрокаПоиска > СтрДлинаИсходнаяСтрока
		Или ПустаяСтрока(СтрокаПоиска) 
		Или ПустаяСтрока(ИсходнаяСтрока) Тогда
		Возврат ЕстьИзменения;
	КонецЕсли;
	
	ВРегИсходнаяСтрока   = ВРег(ИсходнаяСтрока);
	ВРегСтрокаПоиска     = ВРег(СтрокаПоиска);
	
	ТекущаяПозиция    = СтрНайти(ВРегИсходнаяСтрока, ВРегСтрокаПоиска);
	Если ТекущаяПозиция = 0 Тогда
		Возврат ЕстьИзменения;
	КонецЕсли;
	
	Результат = "";
	ПредыдущаяПозиция = 1;
	
	Пока ТекущаяПозиция > 0 Цикл
		Результат = Результат 
					+ Сред(ИсходнаяСтрока, ПредыдущаяПозиция, ТекущаяПозиция - ПредыдущаяПозиция)
					+ СтрокаЗамены;
		ЕстьИзменения = Истина;
		ПредыдущаяПозиция = ТекущаяПозиция + СтрДлинаСтрокаПоиска;
		Если ПредыдущаяПозиция >= СтрДлинаИсходнаяСтрока Тогда
			Прервать;
		КонецЕсли;
		ТекущаяПозиция = СтрНайти(ВРегИсходнаяСтрока, ВРегСтрокаПоиска,,ПредыдущаяПозиция);
	КонецЦикла;
	
	Если ПредыдущаяПозиция < СтрДлинаИсходнаяСтрока Тогда
		Результат = Результат 
					+ Прав(ИсходнаяСтрока, СтрДлинаИсходнаяСтрока - ПредыдущаяПозиция + 1);
	КонецЕсли;
		
	ИсходнаяСтрока = Результат;
	
	Возврат ЕстьИзменения;
КонецФункции

&НаСервере
Функция ЗаписатьТовар(ИзменяемыеСвойства, Ссылка)
	
	НоменклатрураОбъект = Ссылка.ПолучитьОбъект();
	
	ЕстьИзменения = Ложь;
	Для Каждого ИзмененныйРеквизит Из ИзменяемыеСвойства Цикл
		Если НоменклатрураОбъект[ИзмененныйРеквизит.Ключ] <> ИзмененныйРеквизит.Значение Тогда
			ЕстьИзменения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьИзменения Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НоменклатрураОбъект, ИзменяемыеСвойства);
	НоменклатрураОбъект.ОбменДанными.Загрузка = Истина;
	НоменклатрураОбъект.Записать();
	Возврат Истина;

КонецФункции

&НаСервере
Функция НайтиСледующийНаСервере(ИсключаяТекущийЭлемент = Истина)
	
	ТекущаяСтрока = Элементы.НоменклатураУточнениеОписаний.ТекущаяСтрока;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Если НоменклатураУточнениеОписаний.ПолучитьЭлементы().Количество() = 0 Тогда
			Возврат Ложь;
		Иначе
			ТекущийЭлементДерева = НоменклатураУточнениеОписаний.ПолучитьЭлементы()[0];
			ИсключаяТекущийЭлемент = Ложь;
		КонецЕсли;
	Иначе
		ТекущийЭлементДерева = НоменклатураУточнениеОписаний.НайтиПоИдентификатору(ТекущаяСтрока);
	КонецЕсли;
	
	Если ТекущийЭлементДерева = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ НайтиСледующийЭлементПодходящий(ТекущийЭлементДерева, ИсключаяТекущийЭлемент) Тогда
		// Начнем поиск с начала списка
		Возврат НайтиСледующийЭлементПодходящий(НоменклатураУточнениеОписаний.ПолучитьЭлементы()[0], Ложь);
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция НайтиСледующийЭлементПодходящий(ТекущийЭлементДерева, ИсключаяТекущийЭлемент)
	
	ТекущийРодитель = ТекущийЭлементДерева.ПолучитьРодителя();
	
	Если ТекущийРодитель = Неопределено Тогда
		ЭлементыДерева = НоменклатураУточнениеОписаний.ПолучитьЭлементы();
	Иначе
		ЭлементыДерева = ТекущийРодитель.ПолучитьЭлементы();
	КонецЕсли;
	
	ИндексТекущейСтроки = ЭлементыДерева.Индекс(ТекущийЭлементДерева);
	
	Для ИндексСтроки = ИндексТекущейСтроки По ЭлементыДерева.Количество() - 1 Цикл
		
		ЭлементДерева = ЭлементыДерева[ИндексСтроки];
		Если НайтиСледующийЭлемент(ЭлементДерева, ИсключаяТекущийЭлемент) Тогда
			Возврат Истина;
		КонецЕсли;
		ИсключаяТекущийЭлемент = Ложь;
		
	КонецЦикла;
	
	Для СчетчикУровнейИерархии = 1 По МаксимальноеКоличествоУровнейПубликуемогоКаталога Цикл
		
		Если ТекущийРодитель = Неопределено Тогда
			Возврат Ложь;
		Иначе
			РодительРодителя = ТекущийРодитель.ПолучитьРодителя();
			
			Если РодительРодителя = Неопределено Тогда
				ЭлементыДерева = НоменклатураУточнениеОписаний.ПолучитьЭлементы();
			Иначе
				ЭлементыДерева = РодительРодителя.ПолучитьЭлементы();
			КонецЕсли;
			
			ИндексТекущейСтроки = ЭлементыДерева.Индекс(ТекущийРодитель);
			
			Для ИндексСтроки = ИндексТекущейСтроки + 1 По ЭлементыДерева.Количество() - 1 Цикл
				
				ТекущийЭлементДерева = ЭлементыДерева[ИндексСтроки];
				Если НайтиСледующийЭлемент(ТекущийЭлементДерева, Ложь) Тогда
					Возврат Истина;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		Если РодительРодителя = Неопределено Тогда
			Прервать;
		Иначе
			ТекущийРодитель = РодительРодителя.ПолучитьРодителя();
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция НайтиСледующийЭлемент(ТекущийЭлементДерева, ИсключаяТекущийЭлемент)
	
	Если Не ИсключаяТекущийЭлемент
		И ((ИскатьВНазвании
		И СтрНайти(ВРег(ТекущийЭлементДерева.Наименование), ВРег(СтрокаПоиска)) <> 0)
		ИЛИ (ИскатьВНазвании
		И СтрНайти(ВРег(ТекущийЭлементДерева.Описание), ВРег(СтрокаПоиска)) <> 0)) Тогда
			Элементы.НоменклатураУточнениеОписаний.ТекущаяСтрока = ТекущийЭлементДерева.ПолучитьИдентификатор();
			Возврат Истина;
	ИначеЕсли ТекущийЭлементДерева.ЭтоГруппа Тогда
		Для Каждого ПодчиненныйЭлементДерева Из ТекущийЭлементДерева.ПолучитьЭлементы() Цикл
			Если НайтиСледующийЭлемент(ПодчиненныйЭлементДерева, Ложь) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОткрытьНоменклатуру(ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
		И ДополнительныеПараметры.Свойство("Ссылка") Тогда
		ПоказатьЗначение(, ДополнительныеПараметры.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НоменклатураУточнениеОписанийПриАктивизацииСтрокиНаСервере(Наименование, Описание, ИскомоеСлово)
	
	Если СтрДлина(ИскомоеСлово) = 0 Тогда
		ТекстОписания.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(Описание));
		ТекстНаименования.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(Наименование));
		Возврат;
	КонецЕсли;
	
	ТекстОписания.УстановитьФорматированнуюСтроку(
		Новый ФорматированнаяСтрока(ФорматированнаяСтрокаСПодсветкойискомогоСлова(ИскомоеСлово, Описание)));
	ТекстНаименования.УстановитьФорматированнуюСтроку(
		Новый ФорматированнаяСтрока(ФорматированнаяСтрокаСПодсветкойискомогоСлова(ИскомоеСлово, Наименование)));
		
КонецПроцедуры

&НаСервере
Функция ФорматированнаяСтрокаСПодсветкойИскомогоСлова(ИскомоеСлово, Описание)
	
	ДлинаЗаменяемогоСлова = СтрДлина(ИскомоеСлово);
	
	ФорматированноеОписание = Новый Массив;
	ТекстПоиска = Описание;
	ПозицияПоиска = СтрНайти(ВРег(ТекстПоиска), ВРег(ИскомоеСлово));
	Пока ПозицияПоиска <> 0 Цикл
		ТекстДоЗамены = Лев(ТекстПоиска, ПозицияПоиска-1);
		ТекстПослеЗамены = Сред(ТекстПоиска, ПозицияПоиска + ДлинаЗаменяемогоСлова);
		ФорматированноеОписание.Добавить(ТекстДоЗамены);
		ФорматированноеОписание.Добавить(Новый ФорматированнаяСтрока(ИскомоеСлово, Новый Шрифт(,,Истина),));
		ТекстПоиска = ТекстПослеЗамены;
		ПозицияПоиска = СтрНайти(ВРег(ТекстПоиска), ВРег(ИскомоеСлово));
	КонецЦикла;
	ФорматированноеОписание.Добавить(ТекстПоиска);
	
	Возврат ФорматированноеОписание;

КонецФункции

&НаКлиенте
Процедура СохранитьОписаниеТекущейСтроки()
	
	ТекущиеДанные= Элементы.НоменклатураУточнениеОписаний.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовоеОписание = ТекстОписания.ПолучитьТекст();
	НовоеНаименование = ТекстНаименования.ПолучитьТекст();
	
	ТекущиеДанные.Описание = НовоеОписание;
	ТекущиеДанные.Наименование = НовоеНаименование;
	ТекущиеДанные.ЕстьИзменения = Истина;
	Модифицированность = Истина;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияНаСервере()

	Для Каждого СтрокаНоменклатуры Из НоменклатураУточнениеОписаний.ПолучитьЭлементы() Цикл
		ЗаписатьСтроку(СтрокаНоменклатуры);
	КонецЦикла;
	
	Модифицированность = Ложь;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоНоменклатурыКлиент()
	
	ОбновитьНоменклатуруУточнениеОписаний();
	Для Каждого СтрокаДерева из НоменклатураУточнениеОписаний.ПолучитьЭлементы() Цикл
		Элементы.НоменклатураУточнениеОписаний.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

