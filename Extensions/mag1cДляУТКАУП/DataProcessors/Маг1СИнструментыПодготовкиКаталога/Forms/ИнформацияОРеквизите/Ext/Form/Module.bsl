#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	НастройкиУчетнойСистемы = Параметры.НастройкиУчетнойСистемы;
	СвойствоТовара          = Параметры.СвойствоТовара;
	
	ОписаниеСвойства = Маг1СИнтеграция.ОписаниеСвойства(СвойствоТовара, Истина);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОписаниеСвойства);
	
	Если ОписаниеСвойства.Тип = Маг1СПеречисления.ТипыСвойств_Ссылка() Тогда
		Если ОписаниеСвойства.Метаданные <> Неопределено Тогда
			Если ЗначениеЗаполнено(ОписаниеСвойства.Метаданные.ПредставлениеСписка) Тогда
				ПредставлениеСправочника = ОписаниеСвойства.Метаданные.ПредставлениеСписка;
			Иначе
				ПредставлениеСправочника = ОписаниеСвойства.Метаданные.Синоним;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ПредставлениеСправочника.Видимость = (Тип = Маг1СПеречисления.ТипыСвойств_Ссылка());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти
