#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкиУчетнойСистемы       = Параметры.НастройкиУчетнойСистемы;
	НастройкиВитрины              = Параметры.НастройкиВитрины;
	
	ДопРеквизитЗначокНоменклатуры = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры();	
	
	Элементы.ЗначкиНоменклатурыЗначок.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов());
	
	//Обработки.Маг1СИнструментыПодготовкиКаталога.ВосстановитьИзНастроекЗначкиНоменклатуры(ЭтотОбъект, НастройкиВитрины.ОсновныеНастройки)
	Обработки.Маг1СИнструментыПодготовкиКаталога.ОбновитьЗначкиНоменклатуры(ЭтотОбъект, НастройкиУчетнойСистемы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Запись_ЗначенияСвойствОбъектов" Тогда
		ОбновитьЗначкиНоменклатуры();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	Закрыть(СохранитьВНастройкиЗначкиНоменклатуры());
КонецПроцедуры
 
&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовый(Команда)
	ОткрытьФорму("Справочник."+ Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов() +".ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", 
						Новый Структура("Владелец", ДопРеквизитЗначокНоменклатуры)),
		,
		,
		,
		,
		,
		 );
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЗначкиНоменклатуры()
	
	Обработки.Маг1СИнструментыПодготовкиКаталога.ОбновитьЗначкиНоменклатуры(ЭтотОбъект, НастройкиУчетнойСистемы);
	
КонецПроцедуры

&НаСервере
Функция СохранитьВНастройкиЗначкиНоменклатуры()
	Обработки.Маг1СИнструментыПодготовкиКаталога.СохранитьВНастройкиЗначкиНоменклатуры(ЭтотОбъект, НастройкиВитрины.ОсновныеНастройки);
	Возврат НастройкиВитрины.ОсновныеНастройки;
КонецФункции

#КонецОбласти
