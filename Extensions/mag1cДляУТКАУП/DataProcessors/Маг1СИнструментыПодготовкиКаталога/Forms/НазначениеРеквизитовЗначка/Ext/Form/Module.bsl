#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитЗначокНоменклатуры());
	
	Элементы.ТекущийЗначок.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + Маг1СПеречисления.ИменаСправочников_ЗначенияСвойствОбъектов());
	Элементы.ТекущийЗначок.ПараметрыВыбора = Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрВыбора));
	
	ТекущийСрокДействия = "Бессрочно";
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьЭлементы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	Если Не ЗначениеЗаполнено(ТекущийЗначок) Тогда
		ТекстПредупреждения = НСтр("ru = 'Выберите значок'");
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийЗначокДействуетДо)
		И ТекущийЗначокДействуетДо < ТекущаяДата() Тогда
		ТекстПредупреждения = НСтр("ru = 'Установите дату действия больше текущей'");
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТекущийЗначок", ТекущийЗначок);
	Результат.Вставить("ТекущееЗначокПояснение", ТекущееЗначокПояснение);
	Результат.Вставить("ТекущийЗначокДействуетДо",  ТекущийЗначокДействуетДо);
	
	Закрыть(Результат);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТекущийСрокДействияПриИзменении(Элемент)
	
	Если ТекущийСрокДействия = "Бессрочно" Тогда
		ТекущийЗначокДействуетДо = Неопределено;
	КонецЕсли;
	
	НастроитьЭлементы();

КонецПроцедуры

&НаКлиенте
Процедура ТекущийЗначокПриИзменении(Элемент)
	НастроитьЭлементы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастроитьЭлементы()
		
	Элементы.ТекущееЗначокПояснение.Доступность = Элементы.ТекущийЗначок.Доступность
												И ЗначениеЗаполнено(ТекущийЗначок);
												
	Элементы.ТекущийСрокДействия.Доступность    = Элементы.ТекущийЗначок.Доступность
													И ЗначениеЗаполнено(ТекущийЗначок);
													
	Элементы.ТекущийЗначокДействуетДо.Доступность = Элементы.ТекущийСрокДействия.Доступность
												    И ТекущийСрокДействия <> "Бессрочно";
												
	Элементы.ТекущийЗначокДействуетДо.АвтоОтметкаНезаполненного = Элементы.ТекущееЗначокПояснение.Доступность;
	
КонецПроцедуры

#КонецОбласти
