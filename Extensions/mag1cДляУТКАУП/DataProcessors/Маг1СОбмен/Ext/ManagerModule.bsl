#Область СлужебныйПрограммныйИнтерфейс

Функция ВыполнитьДействиеСценарияОбмена(УзелИнформационнойБазы, ДействиеПриОбмене, ПараметрыАвторизации) Экспорт
	
	ОтказЗапуска = Ложь;
	
	ПроверитьВозможностьЗапускаОбмена(УзелИнформационнойБазы, ОтказЗапуска);
	
	Если ОтказЗапуска Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗафиксироватьНачалоОбмена(УзелИнформационнойБазы, ДействиеПриОбмене);
	
	ИмяВременногоФайла    = "";
	ИмяВременногоКаталога = "";
	ИмяФайлаАрхива        = "";
	
	ЕстьВыгруженныеИлиЗагруженныеОбъекты = Ложь;
	
	Попытка
		
		ДействияПриОбменеИмя = "ДействияПриОбмене";
		
		Если ДействиеПриОбмене = Перечисления[ДействияПриОбменеИмя].ЗагрузкаДанных Тогда
		
			Результат = ПодготовитьВыгрузкуДанныхССайта(ПараметрыАвторизации); 
			
			Если Результат <> Маг1СПеречисления.РезультатыОперацииСинхронизации_НетДанныхДляЗагрузки() Тогда
			
				ИдентификаторОперации = Результат;
				
				ИмяВременногоФайла    = ПолучитьИмяВременногоФайла("zip");
				ИмяВременногоКаталога = ПолучитьИмяВременногоФайла("");
				
				ЧтениеАрхива = Неопределено;
				
				Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте();
				ВремяЗавершения = ТекущаяУниверсальнаяДата() + 5 * 60;
				
				Пауза = 3;
				
				Пока Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте()
					И ТекущаяУниверсальнаяДата() < ВремяЗавершения Цикл
					
					Маг1СИнтеграцияСлужебный.Пауза(Пауза);
					Результат = ПолучитьДанныеССайта(ПараметрыАвторизации, ИдентификаторОперации, ИмяВременногоФайла);
					
					Если Пауза < 15 Тогда
						Пауза = Пауза + 1;
					КонецЕсли;
					
				КонецЦикла;
				
				Если Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте() Тогда
					ВызватьИсключение НСтр("ru = 'Операция получения данных с сайта не завершилась за отведенное время.'");
				ИначеЕсли Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Загружено() Тогда
					
					УдалитьФайлВыгрузкиНаСайте(ПараметрыАвторизации, ИдентификаторОперации);
					
					СоздатьКаталог(ИмяВременногоКаталога);
					
					ЧтениеАрхива = Новый ЧтениеZipФайла(ИмяВременногоФайла);
					ЧтениеАрхива.ИзвлечьВсе(ИмяВременногоКаталога, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
					ЧтениеАрхива.Закрыть();
					
					ФайлыОбмена    = НайтиФайлы(ИмяВременногоКаталога, "*", Ложь);
					ИмяФайлаОбмена = "";
					Для Каждого ФайлОбмена из ФайлыОбмена Цикл
						Если ФайлОбмена.ПолучитьТолькоЧтение() Тогда
							ФайлОбмена.УстановитьТолькоЧтение(Ложь);
						КонецЕсли;
						
						Если ПустаяСтрока(ИмяФайлаОбмена)
							И ФайлОбмена.Расширение = ".xml" Тогда
							
							ИмяФайлаОбмена = ФайлОбмена.ПолноеИмя
							
						КонецЕсли;
					КонецЦикла;
						
						ЕстьВыгруженныеИлиЗагруженныеОбъекты = ЗагрузитьДанные(УзелИнформационнойБазы, ИмяФайлаОбмена);
						
						ПодтвердитьЗагрузкуДанныхССайта(ПараметрыАвторизации, ИдентификаторОперации);
						
					Попытка
						УдалитьФайлы(ИмяВременногоФайла);
						УдалитьФайлы(ИмяВременногоКаталога);
					Исключение
					КонецПопытки;
				
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ДействиеПриОбмене = Перечисления[ДействияПриОбменеИмя].ВыгрузкаДанных Тогда
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
			ИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
			
			НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
			
			ДатаНачалаОбмена = ТекущаяУниверсальнаяДата();
			
			ЭтоПолнаяВыгрузка = Маг1СИнтеграция.ЭтоПолнаяВыгрузка(ПараметрыАвторизации.ИдентификаторВитрины, НастройкиУчетнойСистемы);
			
			ЕстьВыгруженныеИлиЗагруженныеОбъекты = ВыгрузитьДанные(УзелИнформационнойБазы, ИмяВременногоФайла);
			
			Если ЕстьВыгруженныеИлиЗагруженныеОбъекты Тогда
				НомерСообщения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелИнформационнойБазы, "НомерОтправленного");
				
				ЗаписьАрхива = Новый ЗаписьZipФайла(ИмяФайлаАрхива, , , МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Оптимальный);
				ЗаписьАрхива.Добавить(ИмяВременногоФайла, РежимСохраненияПутейZIP.НеСохранятьПути);
				ЗаписьАрхива.Записать();
				
				ИдентификаторОперации = ОтправитьДанныеНаСайт(ПараметрыАвторизации, ИмяФайлаАрхива, ЭтоПолнаяВыгрузка);
			КонецЕсли;
			
			Попытка
				УдалитьФайлы(ИмяВременногоФайла);
				УдалитьФайлы(ИмяФайлаАрхива);
			Исключение
			КонецПопытки;
			
			Если ЕстьВыгруженныеИлиЗагруженныеОбъекты Тогда
				Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте();
				ВремяЗавершения = ТекущаяУниверсальнаяДата() + 24 * 60 * 60;
				
				Пауза = 3;
				
				Пока Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте()
					И ТекущаяУниверсальнаяДата() < ВремяЗавершения Цикл
					
					Маг1СИнтеграцияСлужебный.Пауза(Пауза);
					Результат = ПолучитьПодтверждениеЗагрузкиДанныхНаСайт(ПараметрыАвторизации, ИдентификаторОперации);
					
					Если Пауза < 15 Тогда
						Пауза = Пауза + 1;
					КонецЕсли;
					
				КонецЦикла;
				
				Если Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте() Тогда
					ВызватьИсключение НСтр("ru = 'Операция загрузки данных на сайте не завершилась за отведенное время.'");
				КонецЕсли;
				
				УдалитьРегистрациюИзменений(УзелИнформационнойБазы, НомерСообщения, ДатаНачалаОбмена, НастройкиУчетнойСистемы);
				
			КонецЕсли;
			
			ОтправитьКартинкиНаСайт(УзелИнформационнойБазы, ПараметрыАвторизации, НастройкиУчетнойСистемы);
			// Выгрузка идет после загрузки. Если выгрузка прошла, значит и загрузка прошла
			Маг1СИнтеграцияСлужебный.УдалитьДатуПервойОшибкиОбмена(УзелИнформационнойБазы);
			
		КонецЕсли;
	Исключение
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,
									ПодробноеПредставлениеОшибки(Информация));
		РезультатыВыполненияОбменаИмя = "РезультатыВыполненияОбмена";
		ЗафиксироватьЗавершениеОбмена(УзелИнформационнойБазы,
								ДействиеПриОбмене,
								Перечисления[РезультатыВыполненияОбменаИмя].Ошибка,
								ЕстьВыгруженныеИлиЗагруженныеОбъекты);
		
		ОтключитьАвтоматическийОбмен(УзелИнформационнойБазы, Истина);
		
		Если Не ПустаяСтрока(ИмяВременногоФайла) Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
		
		Если Не ПустаяСтрока(ИмяВременногоКаталога) Тогда
			УдалитьФайлы(ИмяВременногоКаталога);
		КонецЕсли;
		
		Если Не ПустаяСтрока(ИмяФайлаАрхива) Тогда
			УдалитьФайлы(ИмяФайлаАрхива);
		КонецЕсли;
		
		ВызватьИсключение;
	КонецПопытки;
	
	РезультатыВыполненияОбменаИмя = "РезультатыВыполненияОбмена";
	
	ЗафиксироватьЗавершениеОбмена(УзелИнформационнойБазы,
									ДействиеПриОбмене,
									Перечисления[РезультатыВыполненияОбменаИмя].Выполнено,
									ЕстьВыгруженныеИлиЗагруженныеОбъекты);
	
	Возврат Ложь;
	
КонецФункции

#Область ОперацииСервисаОбменаССайтом

Функция ПолучитьФайлСНастройкамиXDTO(ПараметрыАвторизации, ИмяФайлаДляЗаписи)
	
	Результат = Ложь;
		
	АдресРесурса = "/api/v2/operations/hello";
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса); 
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод, ИмяФайлаДляЗаписи);  
		
	Если Ответ.КодСостояния = 200 Тогда
		Результат = Истина;
	ИначеЕсли Ответ.КодСостояния >= 400 Тогда
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(ИмяФайлаДляЗаписи, "UTF-8");
		СообщениеОбОшибке = Текст.ПолучитьТекст();
		Текст = Неопределено;
		
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ,
			СообщениеОбОшибке);
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьВыгрузкуДанныхССайта(ПараметрыАвторизации) 
	
	Результат = Неопределено;
	
	АдресРесурса = "/api/v2/operations/export";

	Метод = Маг1СПеречисления.МетодыHTTP_POST();                                                      
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
                                                               
	Запрос.Заголовки.Вставить("Accept", "application/zip");
	Запрос.Заголовки.Вставить("Data-Format-Version", ВерсияФорматаОбмена());
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод,,10);
	
	Если Ответ.КодСостояния = 202 Тогда
		Результат = Ответ.ПолучитьТелоКакСтроку(); 
	ИначеЕсли Ответ.КодСостояния = 204 Тогда
		Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_НетДанныхДляЗагрузки();
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеССайта(ПараметрыАвторизации, ИдентификаторОперации, ИмяФайлаДляЗаписи)
	
	Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте();
	
	АдресРесурса = "/api/v2/operations/" + ИдентификаторОперации;
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод, ИмяФайлаДляЗаписи, 10);
	
	Если Ответ.КодСостояния = 200 Тогда
		Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Загружено();
	ИначеЕсли Ответ.КодСостояния = 202 Тогда
		Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте();
	ИначеЕсли Ответ.КодСостояния = 204 Тогда
		Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_НетДанныхДляЗагрузки();
	ИначеЕсли Ответ.КодСостояния >= 400 Тогда

		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(ИмяФайлаДляЗаписи, "UTF-8");
		СообщениеОбОшибке = Текст.ПолучитьТекст();
		Текст = Неопределено;
		
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ,
			СообщениеОбОшибке);
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УдалитьФайлВыгрузкиНаСайте(ПараметрыАвторизации, ИдентификаторОперации)
	
	Результат = Неопределено;
	
	АдресРесурса = "/api/v2/operations/release";
	Метод = Маг1СПеречисления.МетодыHTTP_POST();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);	
	Запрос.УстановитьТелоИзСтроки(ИдентификаторОперации, "UTF-8");
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод,,10);
	
	Если Ответ.КодСостояния = 202 Тогда
		Результат = Ответ.ПолучитьТелоКакСтроку();
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

