Процедура ВыполнитьОбменВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПараметрыСобытия", Новый Структура); 
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("ОбменУжеВыполняется", Ложь);
	Результат.Вставить("СтрокаСпискаВитрин", Неопределено);
	Результат.Вставить("РасширениеОбновлено", Ложь);
	
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	УзелОбмена      = ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	
	Отказ = Ложь;
	ЭтоИнтерактивныйЗапуск    = ПараметрыОперации.ЭтоИнтерактивныйЗапуск;
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		Если ПараметрыОперации.ЖдатьОкончанияТекущегоОбмена Тогда
			ПроверитьВЦиклеВозможностьЗапускаОбмена(УзелОбмена, Результат.ОбменУжеВыполняется);
		Иначе
			ПроверитьВозможностьЗапускаОбмена(УзелОбмена, Результат.ОбменУжеВыполняется);
		КонецЕсли;
		
		Если Не Результат.ОбменУжеВыполняется Тогда
			ОбновитьНастройкиXDTOКорреспондента(ПараметрыОперации.НастройкиВитрины);	
			
			Результат.РасширениеОбновлено = ОбменДаннымиСервер.Маг1С_ВыполнитьОбменДанными(УзелОбмена, Истина);
			Если Результат.РасширениеОбновлено Тогда
				Результат.Отказ = Истина;
			КонецЕсли;
		Иначе
			Результат.Отказ = Истина;																   
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	Исключение
		Результат.Отказ = Истина;
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = ПодробноеПредставлениеОшибки(Информация);
		
		Если СтрНайти(Результат.СообщениеОбОшибке, "Код ответа: 409") > 0 Тогда
			Результат.ОбменУжеВыполняется = Истина;
		КонецЕсли;
		
		Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	Если Не Результат.Отказ
		И ЭтоИнтерактивныйЗапуск Тогда 
		
		СтрокаСпискаВитрин = Маг1СИнтеграция.СтрокаСпискаВитринПоУзлуОбмена(УзелОбмена);
		
		Если Маг1СИнтеграцияСлужебныйКлиентСервер.НужноОтметитьАктивностьВитрины(СтрокаСпискаВитрин) Тогда
			Попытка
				СтрокаСпискаВитрин = Обработки.Маг1СНастройка.ОтметитьАктивностьВитрины(СтрокаСпискаВитрин);
				Маг1СИнтеграцияСлужебный.СохранитьВСпискеВитринБазы(СтрокаСпискаВитрин, Ложь);
			Исключение
				Информация = ИнформацияОбОшибке();
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
					УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
			КонецПопытки;
		КонецЕсли;
		НастроитьЗапускСинхронизацииПоРасписанию(УзелОбмена,
												Неопределено,
												Истина);
		Результат.СтрокаСпискаВитрин = СтрокаСпискаВитрин;										
	КонецЕсли;
											
	Если ТипЗнч(АдресРезультата) = Тип("Строка") Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	Иначе
		АдресРезультата = Результат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьДанныеДляВыгрузки(НастройкиВитрины, ВыгружатьВсеТовары) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ОбменУжеВыполняется", Ложь);
	Результат.Вставить("СообщениеОбОшибке",  "");
	
	Результат.Вставить("ПараметрыСобытия",  Новый Структура);
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	УстановитьПривилегированныйРежим(Истина);
	УзелОбмена              = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	
	Попытка
		ПроверитьВЦиклеВозможностьЗапускаОбмена(УзелОбмена, Результат.ОбменУжеВыполняется);
		
		Если Результат.ОбменУжеВыполняется Тогда
			Результат.Отказ = Истина;
			Результат.СообщениеОбОшибке = НСтр("ru = 'Не удалось зарегистрировать данные к обмену, т.к. сейчас выполняется другой сеанс синхронизации данных с витриной. Попробуйте повторить операцию позже.'");
		Иначе	
			НомерПринятого = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерПринятого");
			ОбменДаннымиСервер.ЗарегистрироватьДанныеДляНачальнойВыгрузки(УзелОбмена, , НомерПринятого = 0);
			Маг1СИнтеграция.ЗарегистрироватьСправочникНоменклатура(НастройкиВитрины, ВыгружатьВсеТовары);
		КонецЕсли;
		
	Исключение
		Результат.Отказ = Истина;
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	УстановитьПривилегированныйРежим(Ложь);
		
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьСписокИнвайтовВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("ПараметрыСобытия", Новый Структура); 
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("МассивИнвайтов", Новый Массив);
	Результат.Вставить("ТребуетсяАктуализация", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");

	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	Отказ = Ложь;
	
	МассивИнвайтов = Новый Массив;
	НастройкиВитрины = ПараметрыОперации.НастройкиВитрины;
	ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	ДопСвойствоКонтрагента  = Маг1СИнтеграцияСлужебныйПовтИсп.ДопСвойствоКонтрагента(ИдентификаторВитрины);
	
	УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	
	Попытка
		МассивИнвайтов = ПолучитьСписокИнвайтов(ПараметрыОперации.ПараметрыАвторизации);
		
		Если Не Результат.Отказ Тогда			
			СсылкиДляПроверки = МассивИнвайтовВТаблицу(МассивИнвайтов);
				
			ИмяСправочникаДоговоров = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента());
			ИмяСправочникаВидЦен    = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ВидЦен());
			ИмяСправочникаКонтрагентов = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Контрагент());
			
			Запрос = Новый Запрос;
			Если ПустаяСтрока(ИмяСправочникаДоговоров) Тогда
				ТекстЗапроса =
				"ВЫБРАТЬ
				|	СсылкиДляПроверки.Ид КАК Инвайт,
				|	СсылкиДляПроверки.Статус КАК Статус,
				|	СсылкиДляПроверки.ЗарегистрированКПередаче КАК ЗарегистрированКПередаче
				|ПОМЕСТИТЬ СсылкиДляПроверки
				|ИЗ
				|	&СсылкиДляПроверки КАК СсылкиДляПроверки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	СсылкиДляПроверки.Инвайт КАК Инвайт,
				|	СсылкиДляПроверки.Статус КАК Статус,
				|	СсылкиДляПроверки.ЗарегистрированКПередаче КАК ЗарегистрированКПередаче,
				|	ЕСТЬNULL(КонтрагентыИдентификаторы.Ссылка, ЗНАЧЕНИЕ(Справочник.ИмяСправочникаКонтрагентов.ПустаяСсылка)) КАК Ссылка,
				|	НЕОПРЕДЕЛЕНО КАК ВидЦен
				|ПОМЕСТИТЬ ВТИнвайтыСсылки
				|ИЗ
				|	СсылкиДляПроверки КАК СсылкиДляПроверки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК КонтрагентыИдентификаторы
				|		ПО СсылкиДляПроверки.Инвайт = КонтрагентыИдентификаторы.Идентификатор
				|			И (КонтрагентыИдентификаторы.УзелИнформационнойБазы = &УзелОбмена)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ДополнительныеСведения.Объект КАК Контрагент,
				|	НЕ КонтрагентыИзменения.Ссылка ЕСТЬ NULL КАК ЗарегистрированКПередаче,
				|	НЕОПРЕДЕЛЕНО КАК ВидЦен
				|ПОМЕСТИТЬ ВТКонтрагенты
				|ИЗ
				|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаКонтрагентов.Изменения КАК КонтрагентыИзменения
				|		ПО ДополнительныеСведения.Объект = КонтрагентыИзменения.Ссылка
				|			И (КонтрагентыИзменения.Узел = &УзелОбмена)
				|ГДЕ
				|	ДополнительныеСведения.Свойство = &ДопСвойствоКонтрагента
				|	И ДополнительныеСведения.Значение = ИСТИНА
				|	И ДополнительныеСведения.Объект ССЫЛКА Справочник.ИмяСправочникаКонтрагентов
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|";
			Иначе
				ТекстЗапроса =
				"ВЫБРАТЬ
				|	СсылкиДляПроверки.Ид КАК Инвайт,
				|	СсылкиДляПроверки.ИдВидаЦен КАК ИдВидаЦен,
				|	СсылкиДляПроверки.Статус КАК Статус,
				|	СсылкиДляПроверки.ЗарегистрированКПередаче КАК ЗарегистрированКПередаче
				|ПОМЕСТИТЬ СсылкиДляПроверки
				|ИЗ
				|	&СсылкиДляПроверки КАК СсылкиДляПроверки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	СсылкиДляПроверки.Инвайт КАК Инвайт,
				|	СсылкиДляПроверки.Статус КАК Статус,
				|	СсылкиДляПроверки.ЗарегистрированКПередаче КАК ЗарегистрированКПередаче,
				|	ЕСТЬNULL(КонтрагентыИдентификаторы.Ссылка, ЗНАЧЕНИЕ(Справочник.ИмяСправочникаКонтрагентов.ПустаяСсылка)) КАК Ссылка,
				|	ЕСТЬNULL(ВидыЦенИдентификаторы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ВидЦен
				|ПОМЕСТИТЬ ВТИнвайтыСсылки
				|ИЗ
				|	СсылкиДляПроверки КАК СсылкиДляПроверки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК КонтрагентыИдентификаторы
				|		ПО СсылкиДляПроверки.Инвайт = КонтрагентыИдентификаторы.Идентификатор
				|			И (КонтрагентыИдентификаторы.УзелИнформационнойБазы = &УзелОбмена)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ВидыЦенИдентификаторы
				|		ПО СсылкиДляПроверки.ИдВидаЦен = ВидыЦенИдентификаторы.Идентификатор
				|			И (ВидыЦенИдентификаторы.УзелИнформационнойБазы = &УзелОбмена)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ДополнительныеСведения.Объект КАК Контрагент,
				|	НЕ КонтрагентыИзменения.Ссылка ЕСТЬ NULL КАК ЗарегистрированКПередаче,
				|	ВЫБОР 
				|		КОГДА ЕСТЬNULL(СпрДоговорыКонтрагентов.Ссылка.ИмяРеквизитаВидЦен, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Справочник.ИмяСправочникаВидЦен.ПустаяСсылка) ТОГДА 
				|			НЕОПРЕДЕЛЕНО
				|		ИНАЧЕ
				|			ЕСТЬNULL(СпрДоговорыКонтрагентов.Ссылка.ИмяРеквизитаВидЦен, НЕОПРЕДЕЛЕНО) 
				|	КОНЕЦ КАК ВидЦен
				|ПОМЕСТИТЬ ВТКонтрагенты
				|ИЗ
				|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаКонтрагентов.Изменения КАК КонтрагентыИзменения
				|		ПО ДополнительныеСведения.Объект = КонтрагентыИзменения.Ссылка
				|			И (КонтрагентыИзменения.Узел = &УзелОбмена)
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИмяСправочникаДоговоров.ДополнительныеРеквизиты КАК СпрДоговорыКонтрагентов
				|		ПО ДополнительныеСведения.Объект = СпрДоговорыКонтрагентов.Ссылка.ИмяПоляСправочникДоговорыКонтрагент
				|			И (СпрДоговорыКонтрагентов.Свойство = &ДопРеквизитДоговора
				|				И СпрДоговорыКонтрагентов.Значение = ИСТИНА)
				|ГДЕ
				|	ДополнительныеСведения.Свойство = &ДопСвойствоКонтрагента
				|	И ДополнительныеСведения.Значение = ИСТИНА
				|	И ДополнительныеСведения.Объект ССЫЛКА Справочник.ИмяСправочникаКонтрагентов
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|";
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаДоговоров", ИмяСправочникаДоговоров);
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаВидЦен", ИмяСправочникаВидЦен);
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяРеквизитаВидЦен", НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.ВидЦен);
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПоляСправочникДоговорыКонтрагент", НастройкиУчетнойСистемы.ДоговорКонтрагента.Реквизиты.Контрагент); 
				ДопРеквизит = Маг1СИнтеграцияСлужебныйПовтИсп.ДопРеквизитИспользоватьДоговорДляРаботыСВебВитринойMag1c(
							НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
				
				Запрос.УстановитьПараметр("ДопРеквизитДоговора", ДопРеквизит);
			КонецЕсли;
			ТекстЗапроса = ТекстЗапроса + "
			|ВЫБРАТЬ
			|	ВТИнвайтыСсылки.Инвайт КАК Инвайт,
			|	ВТИнвайтыСсылки.Ссылка КАК Ссылка,
			|	ВТИнвайтыСсылки.Статус КАК Статус,
			|	ВТИнвайтыСсылки.ЗарегистрированКПередаче КАК ЗарегистрированКПередаче,
			|	ВТИнвайтыСсылки.Ссылка = ЗНАЧЕНИЕ(Справочник.ИмяСправочникаКонтрагентов.ПустаяСсылка) КАК НеЗагружен,
			|	ВТКонтрагенты.Контрагент ЕСТЬ NULL КАК НеОтмечен
			|ИЗ
			|	ВТИнвайтыСсылки КАК ВТИнвайтыСсылки
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКонтрагенты КАК ВТКонтрагенты
			|		ПО ВТИнвайтыСсылки.Ссылка = ВТКонтрагенты.Контрагент
			|ГДЕ
			|	ВТИнвайтыСсылки.Статус <> &СостоянияИнвайта_ДоступЗапрещен
			|	И (ВТИнвайтыСсылки.Ссылка = ЗНАЧЕНИЕ(Справочник.ИмяСправочникаКонтрагентов.ПустаяСсылка)
			|			ИЛИ ВТКонтрагенты.Контрагент ЕСТЬ NULL)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТКонтрагенты.Контрагент КАК Контрагент,
			|	ВТКонтрагенты.ЗарегистрированКПередаче КАК ЗарегистрированКПередаче
			|ИЗ
			|	ВТКонтрагенты КАК ВТКонтрагенты
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИнвайтыСсылки КАК ВТИнвайтыСсылки
			|		ПО ВТКонтрагенты.Контрагент = ВТИнвайтыСсылки.Ссылка
			|ГДЕ
			|	ВТИнвайтыСсылки.Инвайт ЕСТЬ NULL
			|   ИЛИ ЕСТЬNULL(ВТИнвайтыСсылки.ВидЦен, НЕОПРЕДЕЛЕНО) <> ВТКонтрагенты.ВидЦен
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТКонтрагенты.Контрагент КАК Контрагент,
			|	ВТКонтрагенты.ЗарегистрированКПередаче КАК ЗарегистрированКПередаче
			|ИЗ
			|	ВТИнвайтыСсылки КАК ВТИнвайтыСсылки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКонтрагенты КАК ВТКонтрагенты
			|		ПО ВТИнвайтыСсылки.Ссылка = ВТКонтрагенты.Контрагент
			|ГДЕ
			|	ВТИнвайтыСсылки.Статус = &СостоянияИнвайта_ДоступЗапрещен";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаКонтрагентов", ИмяСправочникаКонтрагентов);
			Запрос.Текст = ТекстЗапроса;
			МенеджерВТ = Новый МенеджерВременныхТаблиц;
			
			Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
			Запрос.УстановитьПараметр("СсылкиДляПроверки", СсылкиДляПроверки);
			Запрос.УстановитьПараметр("ДопСвойствоКонтрагента", ДопСвойствоКонтрагента);
			Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
			Запрос.УстановитьПараметр("СостоянияИнвайта_ДоступЗапрещен", Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен());
			
			РезультатыЗапроса = Запрос.ВыполнитьПакет(); 
			
			НенайденныеСсылки = РезультатыЗапроса[3].Выбрать();
			
			Пока НенайденныеСсылки.Следующий() Цикл
				Если НенайденныеСсылки.НеЗагружен Тогда
					
					Результат.ТребуетсяАктуализация = Истина;
					
					Если Не НенайденныеСсылки.ЗарегистрированКПередаче Тогда 
						ОтметитьПокупателяНаВитринеКОбмену(ПараметрыОперации.ПараметрыАвторизации,
							НенайденныеСсылки.Инвайт);
					КонецЕсли;
						
				ИначеЕсли НенайденныеСсылки.НеОтмечен Тогда
					
					Маг1СИнтеграция.СделатьКонтрагентомВитрины(НенайденныеСсылки.Ссылка, ИдентификаторВитрины);
					
				КонецЕсли;
				
			КонецЦикла;
			
			НеВыгруженныеКонтрагенты = РезультатыЗапроса[4].Выбрать();
			
			Пока НеВыгруженныеКонтрагенты.Следующий() Цикл
				Результат.ТребуетсяАктуализация = Истина;
				
				Если Не НеВыгруженныеКонтрагенты.ЗарегистрированКПередаче Тогда
					ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, НеВыгруженныеКонтрагенты.Контрагент);
				КонецЕсли;
			КонецЦикла;
			
			СнятьОтметкуКонтрагентВитрины = РезультатыЗапроса[5].Выбрать();
			
			Пока СнятьОтметкуКонтрагентВитрины.Следующий() Цикл
				Маг1СИнтеграция.СнятьОтметкуКонтрагентВитрины(СнятьОтметкуКонтрагентВитрины.Контрагент, ИдентификаторВитрины);

				Если СнятьОтметкуКонтрагентВитрины.ЗарегистрированКПередаче Тогда
					ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, СнятьОтметкуКонтрагентВитрины.Контрагент);
				КонецЕсли;
			КонецЦикла;
			
			Результат.МассивИнвайтов = МассивИнвайтов;			
		КонецЕсли;
	Исключение
		Результат.Отказ = Истина;
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_УправлениеИнвайтами(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
		
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	Результат.Вставить("ПараметрыАвторизации", ПараметрыОперации.ПараметрыАвторизации);
	
	Если ТипЗнч(АдресРезультата) = Тип("Строка") Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	Иначе
		АдресРезультата = Результат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИнформациюПроверитьПоКонтрагенту(ПараметрыАвторизации, Контрагент) Экспорт
	
	Инвайт = Маг1СИнтеграция.ИндентификаторОбменаПоОбъекту(Контрагент, ПараметрыАвторизации.УзелОбмена);

	ОписаниеИнвайта = ПолучитьИнформациюПоИнвайту(ПараметрыАвторизации, Инвайт);
	ОписаниеИнвайта.Вставить("ТребуетсяАктуализация", Ложь);
	
	ЭтоКонтрагентВитрины = Маг1СИнтеграция.ЭтоКонтрагентВитрины(Контрагент, ПараметрыАвторизации.ИдентификаторВитрины);
	
	Если ОписаниеИнвайта.Статус = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
		Если ЭтоКонтрагентВитрины Тогда
			Маг1СИнтеграция.СнятьОтметкуКонтрагентВитрины(Контрагент, ПараметрыАвторизации.ИдентификаторВитрины);
			ПланыОбмена.УдалитьРегистрациюИзменений(ПараметрыАвторизации.УзелОбмена, Контрагент);
		КонецЕсли;
	ИначеЕсли ОписаниеИнвайта.Статус <> Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
		
		Если Не ЭтоКонтрагентВитрины Тогда
			Маг1СИнтеграция.СделатьКонтрагентомВитрины(Контрагент, ПараметрыАвторизации.ИдентификаторВитрины);
			ПланыОбмена.ЗарегистрироватьИзменения(ПараметрыАвторизации.УзелОбмена, Контрагент);
			
			ОписаниеИнвайта.ТребуетсяАктуализация = Истина;
		КонецЕсли;
		
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		ИмяСправочникаДоговоров = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ДоговорКонтрагента());
		
		Если Не ПустаяСтрока(ИмяСправочникаДоговоров) Тогда 
			ДоговорВидЦен = Маг1СИнтеграция.ДоговорВидЦенВитрины(Контрагент, ПараметрыАвторизации.ИдентификаторВитрины);
			
			ВидЦен = Неопределено;
			
			Если ДоговорВидЦен <> Неопределено
				И ЗначениеЗаполнено(ДоговорВидЦен.ВидЦен) Тогда
				ВидЦен = ДоговорВидЦен.ВидЦен;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВидЦен)
					И ПустаяСтрока(ОписаниеИнвайта.ИдВидаЦен)
				 Или Не ЗначениеЗаполнено(ВидЦен)
				 	И Не ПустаяСтрока(ОписаниеИнвайта.ИдВидаЦен) Тогда	
					
				ПланыОбмена.ЗарегистрироватьИзменения(ПараметрыАвторизации.УзелОбмена, Контрагент);
				ОписаниеИнвайта.ТребуетсяАктуализация = Истина;
				
			ИначеЕсли ЗначениеЗаполнено(ВидЦен)
					И Не ПустаяСтрока(ОписаниеИнвайта.ИдВидаЦен) Тогда
					
				ИдОбменаВидаЦены = Маг1СИнтеграция.ИндентификаторОбменаПоОбъекту(ВидЦен, ПараметрыАвторизации.УзелОбмена);
				
				Если ИдОбменаВидаЦены <> ОписаниеИнвайта.ИдВидаЦен Тогда
					ПланыОбмена.ЗарегистрироватьИзменения(ПараметрыАвторизации.УзелОбмена, Контрагент);
					ОписаниеИнвайта.ТребуетсяАктуализация = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОписаниеИнвайта;
	
КонецФункции

Процедура СброситьРегистрациюПоИнвайтамВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПараметрыСобытия", Новый Структура); 
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");

	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	ИдентификаторВитрины    = ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
	
	Попытка
		Для Каждого СтрокаОписанния из ПараметрыОперации.КОтменеРегистрации Цикл
			
			СброситьРегистрациюПоИнвайту(ПараметрыОперации.ПараметрыАвторизации, СтрокаОписанния.Инвайт);
			
			Если Не Маг1СИнтеграция.ЭтоКонтрагентВитрины(СтрокаОписанния.Контрагент,
															ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины) Тогда
				
				Маг1СИнтеграция.СделатьКонтрагентомВитрины(СтрокаОписанния.Контрагент, ИдентификаторВитрины);
				ПланыОбмена.ЗарегистрироватьИзменения(ПараметрыОперации.УзелОбмена, СтрокаОписанния.Контрагент);
				
			КонецЕсли;
			
			Маг1СИнтеграция.ДобавитьКонтактнуюИнформацию(СтрокаОписанния.Контрагент,
																"",
																Маг1СИнтеграцияСлужебныйПовтИсп.ВидКИТелефонMag1c());
			
		КонецЦикла;
	Исключение
		Результат.Отказ = Истина;
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_УправлениеИнвайтами(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	Результат.Вставить("ПараметрыАвторизации", ПараметрыОперации.ПараметрыАвторизации);
	
	Если ТипЗнч(АдресРезультата) = Тип("Строка") Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	Иначе
		АдресРезультата = Результат;
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыПередатьДокументПолучитьВременнуюСсылкуВФоновомЗадании() Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("НастройкиВитрины", Неопределено);
	Результат.Вставить("ДокументСсылка", Неопределено);
	Результат.Вставить("СрокДействия", "");
	Результат.Вставить("Контрагент", Неопределено);
	
	Возврат Результат;
КонецФункции

Процедура ПередатьДокументПолучитьВременнуюСсылкуВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ПараметрыСобытия", Новый Структура); 
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("ОписаниеСсылки", Неопределено);
	Результат.Вставить("ОписаниеИнвайта", Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеИнвайта());
	Результат.Вставить("ОбменУжеВыполняется", Ложь);
	Результат.Вставить("РасширениеОбновлено", Ложь);
	
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	УзелОбмена = ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(УзелОбмена);
		
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();

		РежимВитрины = ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.РежимВитрины;
		
		Результат.ОписаниеСсылки = ПолучитьИнформациюОВременнойСсылке(ПараметрыАвторизации,
															ПараметрыОперации.ДокументСсылка);
															
		СостояниеСсылки = Результат.ОписаниеСсылки.Состояние;													
		
		Если СостояниеСсылки = Маг1СПеречисления.СостоянияВременныхСсылок_НетСсылкиНетОснования()
			Или (СостояниеСсылки = Маг1СПеречисления.СостоянияВременныхСсылок_НетСсылкиЕстьОснование()
					И (РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c()
						Или (РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c()  
							И Не Маг1СИнтеграция.ЭтоКонтрагентВитрины(ПараметрыОперации.Контрагент, 
																	  ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины)))) Тогда
			
			Маг1СИнтеграция.ЗарегистрироватьТоварыПоЗаказуДляВременнойСсылки(ПараметрыОперации.ДокументСсылка,
																				ПараметрыОперации.СрокДействия,
																				ПараметрыОперации.НастройкиВитрины);
			
			Маг1СИнтеграция.ЗарегистрироватьКОбменуДляВременнойСсылки(УзелОбмена,
																		ПараметрыОперации.ДокументСсылка,
																		ПараметрыОперации.СрокДействия,
																		Истина,
																		Неопределено); 																	
			
			
			Маг1СИнтеграция.ЗарегистрироватьКОбменуДляВременнойСсылки(УзелОбмена,
																		ПараметрыОперации.Контрагент,
																		ПараметрыОперации.СрокДействия,
																		Истина,
																		Неопределено); 																	
																		
			ПараметрыОперации.Вставить("ЭтоИнтерактивныйЗапуск", Истина);
			ПараметрыОперации.Вставить("ЖдатьОкончанияТекущегоОбмена", Истина);
			
			ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
			ПараметрыВыполнения.КлючФоновогоЗадания = ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
			ПараметрыВыполнения.ЗапуститьВФоне = Истина;
			
			ДлительныеОперации.ВыполнитьВФоне(
				"Обработки.Маг1СОбмен.ВыполнитьОбменВФоновомЗадании",
				ПараметрыОперации,
				ПараметрыВыполнения); 
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений.ИдентификаторОбсуждения) Тогда
			Маг1СИнтеграцияСлужебный.ДобавитьУчастникаОбсуждения(ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений.ИдентификаторОбсуждения,
																	Пользователи.ТекущийПользователь());
		КонецЕсли;
																
		Если СостояниеСсылки <> Маг1СПеречисления.СостоянияВременныхСсылок_СсылкаДействует()
			И СостояниеСсылки <> Маг1СПеречисления.СостоянияВременныхСсылок_ЕстьСсылкаНетОснования() Тогда
			
			Результат.ОписаниеСсылки = ПолучитьНовуюВременнуюСсылку(ПараметрыАвторизации, 
																	ПараметрыОперации.ДокументСсылка,
																	Маг1СПеречисления.СрокиДействияВременныхСсылокВМинуты(ПараметрыОперации.СрокДействия));
		КонецЕсли;
																
		Если ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
			Инвайт       = Маг1СИнтеграция.ИндентификаторОбменаПоОбъекту(ПараметрыОперации.Контрагент, УзелОбмена);
			Результат.ОписаниеИнвайта = ПолучитьИнформациюПоИнвайту(ПараметрыАвторизации, Инвайт);	
		КонецЕсли;															
	Исключение
		Результат.Отказ = Истина;
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПолучениеВременнойСсылки(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

Процедура ОтозватьВременнуюСсылкуВФоновомЗадании(ПараметрыОперации, АдресРезультата) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ПараметрыСобытия", Новый Структура); 
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("РасширениеОбновлено", Ложь);
	Результат.Вставить("ОписаниеСсылки", Неопределено);
	
	Результат.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	
	УзелОбмена = ПараметрыОперации.НастройкиВитрины.ОсновныеНастройки.УзелОбмена;

	Попытка
		ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(УзелОбмена);
		ОтозватьВременнуюСсылку(ПараметрыАвторизации, 
								ПараметрыОперации.ДокументСсылка);
								
		Результат.ОписаниеСсылки = ПолучитьИнформациюОВременнойСсылке(ПараметрыАвторизации, 
																ПараметрыОперации.ДокументСсылка);
	Исключение
		Результат.Отказ = Истина;
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ПолучениеВременнойСсылки(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	
	Результат.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДатаСеанса());
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедурыКонвертации

Процедура ДобавитьВыгруженныеОбъектыВРегистрПубличныеИдентификаторы(УзелОбмена, НомерСообщения, ДатаНачалаОбмена, НастройкиВитрины, НастройкиУчетнойСистемы)
	
	ТекстЗапроса =
	"ВЫБРАТЬ 
	|	Изменения.Ссылка
	|ИЗ 
	|	#ТаблицаИзменения КАК Изменения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторы 
	|		ПО ПубличныеИдентификаторы.Ссылка = Изменения.Ссылка
	|			И ПубличныеИдентификаторы.УзелИнформационнойБазы = Изменения.Узел
	|ГДЕ
	|	Изменения.Узел = &УзелОбмена
	|	И Изменения.НомерСообщения <= &НомерСообщения
	|	И ПубличныеИдентификаторы.Идентификатор ЕСТЬ NULL";
	
	ПубличныеИдентификаторыСинхронизируемыхОбъектовИмя = Маг1СПеречисления.ИменаСправочников_ПубличныеИдентификаторыСинхронизируемыхОбъектов();
	
	Для Каждого ИмяТипа Из НастройкиУчетнойСистемы.ИменаТиповДляОбменаПоПравилам Цикл
		
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(Тип(ИмяТипа));
		
		Если Не ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
		
		Если Не Маг1СИнтеграцияСлужебныйПовтИсп.ЕстьВСоставеПланаОбмена(ПолноеИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#ТаблицаИзменения", ПолноеИмяОбъекта + ".Изменения");
		Запрос.УстановитьПараметр("УзелОбмена",     УзелОбмена);
		Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураЗаписи = Новый Структура;
			СтруктураЗаписи.Вставить("Ссылка", Выборка.Ссылка);
			СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзелОбмена);
			СтруктураЗаписи.Вставить("Идентификатор", Выборка.Ссылка.УникальныйИдентификатор());
			

			РегистрыСведений[ПубличныеИдентификаторыСинхронизируемыхОбъектовИмя].ДобавитьЗапись(СтруктураЗаписи, Истина);
		КонецЦикла;
	КонецЦикла;
	
	ДобавитьДополнительныеДанныеВРегистрПубличныеИдентификаторы(УзелОбмена, НомерСообщения, ДатаНачалаОбмена, НастройкиВитрины);
	
	ИмяСправочникаНоменклатура = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_Номенклатура());
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Изменения.Ссылка
	|ИЗ 
	|	Справочник.ИмяСправочникаНоменклатура.Изменения КАК Изменения
	|ГДЕ
	|	Изменения.Узел = &УзелОбмена
	|	И Изменения.НомерСообщения <= &НомерСообщения";
	Запрос.УстановитьПараметр("УзелОбмена",     УзелОбмена);
	Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаНоменклатура", ИмяСправочникаНоменклатура);
	
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПубличныеИдентификаторы.Ссылка КАК Ссылка,
	|	ПубличныеИдентификаторы.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторы
	|ГДЕ
	|	ПубличныеИдентификаторы.УзелИнформационнойБазы = &УзелОбмена
	|	И ПубличныеИдентификаторы.Ссылка ССЫЛКА Справочник.ИмяСправочникаНоменклатура
	|	И НЕ ВЫРАЗИТЬ(ПубличныеИдентификаторы.Ссылка КАК Справочник.ИмяСправочникаНоменклатура).ЭтоГруппа
	|   И НЕ (&ФильтрНоменклатуры)";	
	Запрос.УстановитьПараметр("УзелОбмена",     УзелОбмена);
	
	НастройкиФильтровНоменклатуры = Маг1СИнтеграция.НастройкиФильтровНоменклатуры(НастройкиВитрины);
	
	Маг1СИнтеграция.ВставитьОтборПоНоменклатуреВТекстЗапроса(Запрос,
															"ВЫРАЗИТЬ(ПубличныеИдентификаторы.Ссылка КАК Справочник.ИмяСправочникаНоменклатура)",
                                                             НастройкиФильтровНоменклатуры);
																		 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочникаНоменклатура", ИмяСправочникаНоменклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("Ссылка", Выборка.Ссылка);
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзелОбмена);
		СтруктураЗаписи.Вставить("Идентификатор", Выборка.Идентификатор);
		
		РегистрыСведений[ПубличныеИдентификаторыСинхронизируемыхОбъектовИмя].УдалитьЗапись(СтруктураЗаписи, Истина);
	КонецЦикла;
		
КонецПроцедуры

Процедура ДобавитьДополнительныеДанныеВРегистрПубличныеИдентификаторы(УзелОбмена, НомерСообщения, ДатаНачалаОбмена, НастройкиВитрины)
	
	ДополнительныеДанные = Маг1СИнтеграция.ПрочитатьНеобходимостьВыгрузкиДополнительныхДанных(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
	
	Если ДополнительныеДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыгруженныеДанные        = Новый Соответствие;
	ВыгруженныеДанныеМассив  = Новый Массив;
	
	Для Каждого КлючДанных из ДополнительныеДанные Цикл
		
		Для Каждого КлючЗначение из КлючДанных.Значение Цикл
			Если Не ЗначениеЗаполнено(КлючЗначение.Ключ)
				Или Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(КлючЗначение.Ключ)) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Дата") Тогда
				Если КлючЗначение.Значение >= ДатаНачалаОбмена Тогда
					Продолжить;	
				КонецЕсли;
			ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Число") Тогда
				Если КлючЗначение.Значение >= НомерСообщения Тогда
					Продолжить;	
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;	
			
			ВыгруженныеДанные.Вставить(КлючЗначение.Ключ);
			ВыгруженныеДанныеМассив.Добавить(КлючЗначение.Ключ);
			
		КонецЦикла;
		
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПубличныеИдентификаторы.Ссылка КАК Ссылка,
	|	ПубличныеИдентификаторы.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторы
	|ГДЕ
	|	ПубличныеИдентификаторы.УзелИнформационнойБазы = &УзелОбмена
	|	И ПубличныеИдентификаторы.Ссылка В (&ВыгруженныеДанныеМассив)";	
	Запрос.УстановитьПараметр("УзелОбмена",     УзелОбмена);
	Запрос.УстановитьПараметр("ВыгруженныеДанныеМассив",ВыгруженныеДанныеМассив);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ВыгруженныеДанные.Удалить(Выборка.Ссылка);	
	КонецЦикла;
	
	Для Каждого КлючЗначение из ВыгруженныеДанные Цикл
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("Ссылка", КлючЗначение.Ключ);
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзелОбмена);
		СтруктураЗаписи.Вставить("Идентификатор", КлючЗначение.Ключ.УникальныйИдентификатор());
		
		ПубличныеИдентификаторыСинхронизируемыхОбъектовИмя = Маг1СПеречисления.ИменаСправочников_ПубличныеИдентификаторыСинхронизируемыхОбъектов();
		
		РегистрыСведений[ПубличныеИдентификаторыСинхронизируемыхОбъектовИмя].ДобавитьЗапись(СтруктураЗаписи, Истина);
	КонецЦикла;

КонецПроцедуры

Функция РезультатВыполненияОбменаВыполнено(РезультатВыполненияОбмена)
	РезультатыВыполненияОбменаИмя = "РезультатыВыполненияОбмена";
	
	Возврат РезультатВыполненияОбмена = Неопределено
		Или РезультатВыполненияОбмена = Перечисления[РезультатыВыполненияОбменаИмя].Выполнено
		Или РезультатВыполненияОбмена = Перечисления[РезультатыВыполненияОбменаИмя].ВыполненоСПредупреждениями;
	
КонецФункции
	
Функция ОбработкаОбменаДаннымиДляВыгрузки(УзелОбмена)
	
	ОбработкаОбменаДанными = Обработки["КонвертацияОбъектовXDTO"].Создать();
	
	ОбработкаОбменаДанными.РежимОбмена   = "Выгрузка";
	ОбработкаОбменаДанными.УзелДляОбмена = УзелОбмена;
	
	ДействияПриОбменеИмя = "ДействияПриОбмене";
	
	УстановитьОбщиеПараметрыДляОбработкиОбменаДанными(
		ОбработкаОбменаДанными, УзелОбмена, Перечисления[ДействияПриОбменеИмя].ЗагрузкаДанных);
	
	Возврат ОбработкаОбменаДанными;
	
КонецФункции

Функция ОбработкаОбменаДаннымиДляЗагрузки(УзелОбмена)
	
	ОбработкаОбменаДанными = Обработки["КонвертацияОбъектовXDTO"].Создать();
	
	ОбработкаОбменаДанными.РежимОбмена = "Загрузка";
	ОбработкаОбменаДанными.УзелОбменаЗагрузкаДанных = УзелОбмена;
	
	ДействияПриОбменеИмя = "ДействияПриОбмене";
	
	УстановитьОбщиеПараметрыДляОбработкиОбменаДанными(
		ОбработкаОбменаДанными, УзелОбмена, Перечисления[ДействияПриОбменеИмя].ЗагрузкаДанных);
	
	Возврат ОбработкаОбменаДанными;
	
КонецФункции

Процедура УстановитьОбщиеПараметрыДляОбработкиОбменаДанными(ОбработкаОбменаДанными, УзелОбмена, ДействиеПриОбмене)
	
	ОбработкаОбменаДанными.ДописыватьДанныеВПротоколОбмена = Ложь;
	ОбработкаОбменаДанными.ВыгружатьТолькоРазрешенные      = Ложь;
	
	ОбработкаОбменаДанными.ИспользоватьТранзакции         = Ложь;
	ОбработкаОбменаДанными.КоличествоОбъектовНаТранзакцию = 1;
	
	ОбработкаОбменаДанными.КлючСообщенияЖурналаРегистрации = КлючСообщенияЖурналаРегистрацииОбменаДанными(УзелОбмена, ДействиеПриОбмене);
	
КонецПроцедуры
	
Функция КлючСообщенияЖурналаРегистрацииОбменаДанными(УзелОбмена, ДействиеПриОбмене)
	
	Возврат ОбменДаннымиСервер.КлючСообщенияЖурналаРегистрации(УзелОбмена, ДействиеПриОбмене);
	
КонецФункции

Процедура ЗафиксироватьНачалоОбмена(УзелОбмена, ДействиеПриОбмене) Экспорт
	
	СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Начало процесса обмена данными для узла %1'", КодОсновногоЯзыка()),
		УзелОбмена);
	
	ЗаписьЖурналаРегистрации(КлючСообщенияЖурналаРегистрацииОбменаДанными(УзелОбмена, ДействиеПриОбмене), 
		УровеньЖурналаРегистрации.Информация,
		УзелОбмена.Метаданные(),
		УзелОбмена,
		СтрокаСообщения);
	
	ЗафиксироватьНачалоОбменаВРегистреСведений(УзелОбмена, ДействиеПриОбмене);
	
КонецПроцедуры

Процедура ЗафиксироватьНачалоОбменаВРегистреСведений(УзелОбмена, ДействиеПриОбмене)
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("УзелИнформационнойБазы", УзелОбмена);
	СтруктураЗаписи.Вставить("ДействиеПриОбмене",      ДействиеПриОбмене);
	СтруктураЗаписи.Вставить("ДатаНачала",             ТекущаяДатаСеанса());
	
	РегистрыСведений["СостоянияОбменовДанными"].ОбновитьЗапись(СтруктураЗаписи);
	
КонецПроцедуры

Процедура ЗафиксироватьЗавершениеОбмена(УзелОбмена, ДействиеПриОбмене, РезультатВыполненияОбмена, ЕстьОбработанныеОбъекты) Экспорт
	
	// Статус "Неопределено" в конце обмена свидетельствует об успешном выполнении обмена.
	РезультатыВыполненияОбменаИмя = "РезультатыВыполненияОбмена";
	Если РезультатВыполненияОбмена = Неопределено Тогда
		РезультатВыполненияОбмена = Перечисления[РезультатыВыполненияОбменаИмя].Выполнено;
	КонецЕсли;
	
	СтрокаСообщения = 
		?(ЕстьОбработанныеОбъекты,НСтр("ru = 'Есть обработанные объекты'", КодОсновногоЯзыка()),НСтр("ru = 'Нет обработанных объектов'", КодОсновногоЯзыка()));
		
	ЗаписьЖурналаРегистрации(КлючСообщенияЖурналаРегистрацииОбменаДанными(УзелОбмена, ДействиеПриОбмене), 
		УровеньЖурналаРегистрации.Информация,
		УзелОбмена.Метаданные(),
		УзелОбмена,
		СтрокаСообщения);
		
	ЗафиксироватьЗавершениеОбменаВРегистреСведений(УзелОбмена, ДействиеПриОбмене, РезультатВыполненияОбмена);
	
	Если РезультатВыполненияОбменаВыполнено(РезультатВыполненияОбмена) Тогда
		РегистрыСведений["ОбщиеНастройкиУзловИнформационныхБаз"].СнятьПризнакОтправкиДанных(УзелОбмена);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьЗавершениеОбменаВРегистреСведений(УзелОбмена, ДействиеПриОбмене, РезультатВыполнения)
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("УзелИнформационнойБазы",    УзелОбмена);
	СтруктураЗаписи.Вставить("ДействиеПриОбмене",         ДействиеПриОбмене);
	СтруктураЗаписи.Вставить("ДатаОкончания",             ТекущаяДатаСеанса());
	СтруктураЗаписи.Вставить("РезультатВыполненияОбмена", РезультатВыполнения);
	
	РегистрыСведений["СостоянияОбменовДанными"].ОбновитьЗапись(СтруктураЗаписи);
	
	Если РезультатВыполненияОбменаВыполнено(РезультатВыполнения) Тогда
		РегистрыСведений["СостоянияУспешныхОбменовДанными"].ДобавитьЗапись(СтруктураЗаписи);
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьВыгруженныеОбъекты(ИмяФайлаДляВыгрузки)
	
	ЕстьВыгруженныеОбъекты = Ложь;
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайлаДляВыгрузки);
	
	Чтение.Прочитать(); // Message
	
	Чтение.Прочитать(); // Header
	Чтение.Пропустить();
	
	Чтение.Прочитать(); // Body
	Если Чтение.ЛокальноеИмя = "Body" Тогда
		Пока Чтение.Прочитать()
			И Чтение.ЛокальноеИмя <> "Body" Цикл
			ЕстьВыгруженныеОбъекты = Истина;
			Чтение.Пропустить();
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Чтение.Закрыть();
	
	Возврат ЕстьВыгруженныеОбъекты;
	
КонецФункции

Функция МассивИнвайтовВТаблицу(МассивИнвайтов) Экспорт
	СсылкиДляПроверки = Новый ТаблицаЗначений;
	СсылкиДляПроверки.Колонки.Добавить("Ид",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150,ДопустимаяДлина.Переменная)));
	СсылкиДляПроверки.Колонки.Добавить("ИдВидаЦен",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150,ДопустимаяДлина.Переменная)));
	СсылкиДляПроверки.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150,ДопустимаяДлина.Переменная)));
	СсылкиДляПроверки.Колонки.Добавить("ЗарегистрированКПередаче", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрМас из МассивИнвайтов Цикл
		
		НоваяСтрока = СсылкиДляПроверки.Добавить();
		НоваяСтрока.Ид = СтрМас.Ид;	
		НоваяСтрока.ИдВидаЦен = СтрМас.ВидЦен;	
		НоваяСтрока.Статус = СтрМас.Статус;	
		НоваяСтрока.ЗарегистрированКПередаче = СтрМас.ЗарегистрированКПередаче;	
		
	КонецЦикла;
	
	Возврат СсылкиДляПроверки;
КонецФункции

