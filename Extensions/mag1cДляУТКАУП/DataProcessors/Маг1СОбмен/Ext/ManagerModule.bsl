Функция ПолучитьИнформациюОВременнойСсылке(ПараметрыАвторизации, Основание) Экспорт
	
	АдресРесурса = "/api/v2/operations/templink";
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	УстановитьТелоПоОснованиюВременнойСсылки(Запрос, Основание);
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод); 
	
	Результат = Неопределено;
	
	Если Ответ.КодСостояния = 200
		Или Ответ.КодСостояния = 201 Тогда
		
		Если Ответ.КодСостояния = 200 Тогда
			Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_СсылкаДействует();
		Иначе
			Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_ЕстьСсылкаНетОснования();
		КонецЕсли;
		
		СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();
		Результат = ВременнаяСсылкаВСервисе(Маг1СИнтеграцияСлужебный.СтрокаJSONВСтруктуру(СтрокаОтвета),
											Состояние);
		
	ИначеЕсли Ответ.КодСостояния = 410 Тогда
		Результат = Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеВременнойСсылки(Маг1СПеречисления.СостоянияВременныхСсылок_НетСсылкиЕстьОснование());
		
	ИначеЕсли Ответ.КодСостояния = 422 Тогда
		Результат = Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеВременнойСсылки(Маг1СПеречисления.СостоянияВременныхСсылок_НетСсылкиНетОснования());
		
	ИначеЕсли Ответ.КодСостояния = 426 Тогда
		Результат = Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеВременнойСсылки(Маг1СПеречисления.СостоянияВременныхСсылок_НетСсылкиОснованиеСозданоНаВитрине());
		
	Иначе	
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьНовуюВременнуюСсылку(ПараметрыАвторизации, Основание, СрокДействияМинут) Экспорт
	
	АдресРесурса = "/api/v2/operations/templink";
	
