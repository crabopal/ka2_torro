КонецФункции

Функция ОтправитьДанныеНаСайт(ПараметрыАвторизации, ИмяФайлаДляОтправки, ЭтоПолнаяВыгрузка)
	
	Результат = Неопределено;
	
	АдресРесурса = "/api/v2/operations/import";
	Метод        = Маг1СПеречисления.МетодыHTTP_POST();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	
	Файл = Новый Файл(ИмяФайлаДляОтправки);
	Запрос.Заголовки.Вставить("Content-Length",  Формат(Файл.Размер(),"ЧГ=0"));
	Запрос.Заголовки.Вставить("Content-Type",  "application/zip");
	Запрос.Заголовки.Вставить("Transfer-Encoding", Неопределено);
	Если ЭтоПолнаяВыгрузка Тогда
		Запрос.Заголовки.Вставить("It-Is-Full-Data", Истина);
	КонецЕсли;
	
	Запрос.Заголовки.Вставить("Data-Format-Version", ВерсияФорматаОбмена());
	
	Запрос.УстановитьИмяФайлаТела(ИмяФайлаДляОтправки);
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод,,10);
	
	Если Ответ.КодСостояния = 202 Тогда
		Результат = Ответ.ПолучитьТелоКакСтроку();
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПодтверждениеЗагрузкиДанныхНаСайт(ПараметрыАвторизации, ИдентификаторОперации)
	
	Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте();
		
	АдресРесурса = "/api/v2/operations/" + ИдентификаторОперации;
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод,,10);
	
	Если Ответ.КодСостояния = 200 Тогда
		Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Загружено();
	ИначеЕсли Ответ.КодСостояния = 202 Тогда	
		Результат = Маг1СПеречисления.РезультатыОперацииСинхронизации_Ожидайте();
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокФайловОжидаемыхНаСайте(ПараметрыАвторизации)
	
	АдресРесурса = "/api/v2/operations/import/files/update-list";
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	Запрос.Заголовки.Вставить("Data-Format-Version", ВерсияФорматаОбмена());
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 204 Тогда
		// Сервер не ожидает никаких файлов
		Возврат Новый Массив;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда	
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
	СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();
	
	МассивОписанийСсылок = Маг1СИнтеграцияСлужебный.СтрокаJSONВСтруктуру(СтрокаОтвета);
	
	Возврат МассивОписанийСсылок;
	
КонецФункции

Процедура ОтправитьКартинкиНаСайт(УзелИнформационнойБазы, ПараметрыАвторизации, НастройкиУчетнойСистемы)
	
	Попытка
		МассивОписанийСсылок = ПолучитьСписокФайловОжидаемыхНаСайте(ПараметрыАвторизации);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,
									ПодробноеПредставлениеОшибки(Информация));
		ВызватьИсключение;
	КонецПопытки;
	
	Если МассивОписанийСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСправочинкаКартинокНоменклатуры  = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	ИмяСправочинкаКартинокХарактеристик = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	
	Для Каждого ОписаниеСсылки из МассивОписанийСсылок Цикл
		
		ИмяСправочинкаКартинок = "";
		Если ОписаниеСсылки.ТипСсылки = Маг1СПеречисления.ТипыСсылок_Номенклатура() Тогда
			ИмяСправочинкаКартинок = ИмяСправочинкаКартинокНоменклатуры;
			
		ИначеЕсли ОписаниеСсылки.ТипСсылки = Маг1СПеречисления.ТипыСсылок_ХарактеристикиНоменклатуры() Тогда
			ИмяСправочинкаКартинок = ИмяСправочинкаКартинокХарактеристик;
			
		ИначеЕсли ОписаниеСсылки.ТипСсылки = Маг1СПеречисления.ТипыСсылок_КатегорииНоменклатуры() Тогда
			ИмяСправочинкаКартинок = Маг1СПеречисления.ИменаСправочников_Файлы();
			
		КонецЕсли;
		
		Если ПустаяСтрока(ИмяСправочинкаКартинок) Тогда
			ОтменитьОжиданиеФайлаНаСайте(УзелИнформационнойБазы,
										ОписаниеСсылки,
										Неопределено,
										ПараметрыАвторизации);
			Продолжить;
		КонецЕсли;
		
		СсылкаНаФайл = Справочники[ИмяСправочинкаКартинок].ПолучитьСсылку(
								Новый УникальныйИдентификатор(СокрЛП(ОписаниеСсылки.Ид)));
		Если Не ОбщегоНазначения.СсылкаСуществует(СсылкаНаФайл) Тогда
			ОтменитьОжиданиеФайлаНаСайте(УзелИнформационнойБазы,
										ОписаниеСсылки,
										Неопределено,
										ПараметрыАвторизации);
			Продолжить;
		КонецЕсли;
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаФайл, "ПометкаУдаления") Тогда
			ОтменитьОжиданиеФайлаНаСайте(УзелИнформационнойБазы,
										ОписаниеСсылки,
										СсылкаНаФайл,
										ПараметрыАвторизации);
			Продолжить;
		ИначеЕсли ЕстьПроблемаОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОтправитьКартинкуНаСайт(УзелИнформационнойБазы,
									ОписаниеСсылки,
									СсылкаНаФайл,
									ПараметрыАвторизации);		
		Исключение
			Информация = ИнформацияОбОшибке();
			ЗарегистрироватьПроблемуОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл, Информация.Описание);
			
			Продолжить;
		КонецПопытки;		
			
	КонецЦикла;
		
КонецПроцедуры

Функция ОтправитьКартинкуНаСайт(УзелИнформационнойБазы, ОписаниеСсылки, СсылкаНаФайл, ПараметрыАвторизации) Экспорт

	Если ПараметрыАвторизации = Неопределено Тогда
		ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(УзелИнформационнойБазы);
	КонецЕсли;
	
	ДвоичныеДанныеФайла = Неопределено;								
	Попытка
		ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(СсылкаНаФайл, Истина);
	Исключение
		Информация = ИнформацияОбОшибке();
		Причина = НСтр("ru = 'Получении данных файла картинки. Попробуйте обновить из файла на диске. Текст ошибки: ""%ОписаниеОшибки%""'",ОбщегоНазначения.КодОсновногоЯзыка());
		Причина = СтрЗаменить(Причина, "%ОписаниеОшибки%", Информация.Описание);
		ЗарегистрироватьПроблемуОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл, Причина);
		Возврат Ложь;
	КонецПопытки;
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Расширение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаФайл, "Расширение");
		РезультатСжатия = Маг1СИнтеграцияСлужебный.СжатьКартинку(ДвоичныеДанныеФайла,,,,Расширение);
	Исключение
		Информация = ИнформацияОбОшибке();
		
		Причина = НСтр("ru = 'Ошибка при сжатии файла картинки. Попробуйте обновить из файла на диске. Текст ошибки: ""%ОписаниеОшибки%""'",ОбщегоНазначения.КодОсновногоЯзыка());
		Причина = СтрЗаменить(Причина, "%ОписаниеОшибки%", Информация.Описание);
		
		ЗарегистрироватьПроблемуОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл, Причина);
		Возврат Ложь;
	КонецПопытки;

	ДвоичныеДанныеДляПередачи = РезультатСжатия.ДвоичныеДанные;
	
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеДанных.Добавить(ДвоичныеДанныеДляПередачи);
	Хеш = СтрЗаменить(СтрЗаменить(Base64Строка(ХешированиеДанных.ХешСумма), Символы.ПС,""), Символы.ВК, "");
	
	АдресРесурса = "/api/v2/operations/import/files";
	Метод = Маг1СПеречисления.МетодыHTTP_GET();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
	УстановитьТелоОписаниюСсылки(Запрос, ОписаниеСсылки);
	
	Запрос.Заголовки.Вставить("Content-MD5",  Хеш);
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод,,1);
	
	Если Ответ.КодСостояния = 304 Тогда
		ОтметитьРешениеПроблемыОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл);
		// Файл с таким хешем уже есть на сервере
		Возврат Истина;
	ИначеЕсли Ответ.КодСостояния <> 302 Тогда
		Причина = Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
		ЗарегистрироватьПроблемуОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл, Причина);
		Возврат Ложь;
	КонецЕсли;
	
	Запрос.АдресРесурса = Запрос.АдресРесурса + "/" + Ответ.Заголовки.Получить("Location");
	
	Запрос.Заголовки.Вставить("Content-Type",  РезультатСжатия.ТипСодержимого);	
	Запрос.Заголовки.Вставить("File-Id",  Строка(СсылкаНаФайл.УникальныйИдентификатор()));
	Запрос.Заголовки.Вставить("Content-Length",  Формат(ДвоичныеДанныеДляПередачи.Размер(),"ЧГ=0"));
	
	Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеДляПередачи);
	
	Метод = Маг1СПеречисления.МетодыHTTP_POST();
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод,,1);
	
	Если Ответ.КодСостояния = 200 Тогда
		ОтметитьРешениеПроблемыОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл);
		Возврат Истина;
	Иначе
		Причина = Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
		ЗарегистрироватьПроблемуОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл, Причина);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОтменитьОжиданиеФайлаНаСайте(УзелИнформационнойБазы, ОписаниеСсылки, СсылкаНаФайл, ПараметрыАвторизации) Экспорт
	Если ПараметрыАвторизации = Неопределено Тогда
		ПараметрыАвторизации = Обработки.Маг1СНастройка.ПараметрыАвторизацииНаВитрине(УзелИнформационнойБазы);
	КонецЕсли;
		
	АдресРесурса = "/api/v2/operations/import/files";
	Метод = Маг1СПеречисления.МетодыHTTP_DELETE();
	
	Запрос = Маг1СИнтеграцияСлужебный.НовыйHTTPЗапрос(ПараметрыАвторизации, АдресРесурса);
    УстановитьТелоОписаниюСсылки(Запрос, ОписаниеСсылки);
	
	Ответ = Маг1СИнтеграцияСлужебный.ВыполнитьHTTPЗапрос(ПараметрыАвторизации, Запрос, Метод);
	
	Если Ответ.КодСостояния = 200 Тогда
		Если СсылкаНаФайл <> Неопределено Тогда
			ОтметитьРешениеПроблемыОтправкиКартинки(УзелИнформационнойБазы, СсылкаНаФайл);
		КонецЕсли;
		Возврат;
	Иначе
		ВызватьИсключение Маг1СИнтеграцияСлужебный.ОписаниеОшибкиСервиса(
		    ПараметрыАвторизации,
			Запрос,
			Метод,
			Ответ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтметитьРешениеПроблемыОтправкиКартинки(Узел, СсылкаНаОбъект)
	
	Если Не ЕстьПроблемаОтправкиКартинки(Узел, СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРезультатыОбменаДанными = "РезультатыОбменаДанными";
	
	Набор = РегистрыСведений[ИмяРезультатыОбменаДанными].СоздатьНаборЗаписей();
	Набор.Отбор.ТипПроблемы.Установить(ТипПроблемОбменаДанными());
	Набор.Отбор.УзелИнформационнойБазы.Установить(Узел);
	Набор.Отбор.ОбъектМетаданных.Установить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СсылкаНаОбъект.Метаданные()));
	Набор.Отбор.ПроблемныйОбъект.Установить(СсылкаНаОбъект);
	Набор.Записать(Истина);
	
КонецПроцедуры

Процедура ЗарегистрироватьПроблемуОтправкиКартинки(Узел, СсылкаНаОбъект, Причина)
	
	МетаданныеОбъекта  = СсылкаНаОбъект.Метаданные();
	
	ОбъектМетаданных   = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеОбъекта);
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "ПометкаУдаления,Наименование,ВладелецФайла");
		
	ИмяРезультатыОбменаДанными = "РезультатыОбменаДанными";
	
	Набор = РегистрыСведений[ИмяРезультатыОбменаДанными].СоздатьНаборЗаписей();
	Набор.Отбор.ТипПроблемы.Установить(ТипПроблемОбменаДанными());
	Набор.Отбор.УзелИнформационнойБазы.Установить(Узел);
	Набор.Отбор.ОбъектМетаданных.Установить(ОбъектМетаданных);
	Набор.Отбор.ПроблемныйОбъект.Установить(СсылкаНаОбъект);
	
	НоваяСтрока = Набор.Добавить();
	НоваяСтрока.ТипПроблемы = ТипПроблемОбменаДанными();
	НоваяСтрока.УзелИнформационнойБазы = Узел;
	НоваяСтрока.ОбъектМетаданных = ОбъектМетаданных;
	НоваяСтрока.ПроблемныйОбъект = СсылкаНаОбъект;
	НоваяСтрока.ДатаВозникновения = ТекущаяДатаСеанса();
	НоваяСтрока.Причина = Причина;
	НоваяСтрока.ПредставлениеОбъекта = Строка(СсылкаНаОбъект);
	НоваяСтрока.ПометкаУдаления = ЗначенияРеквизитов.ПометкаУдаления;
	
	Набор.Записать(Истина);
	
	ТекстСообщения = НСтр("ru = 'Ошибка при отправке картинки на витрину. Имя файла: %ИмяФайла%. Владелец файла: %ВладелецФайла%. Информация об ошибке: %ИнформацияОбОшибке%'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИмяФайла%", ЗначенияРеквизитов.Наименование);
	
	Если МетаданныеОбъекта.Имя = Маг1СПеречисления.ИменаСправочников_Файлы() Тогда
		ВладелецФайла = Маг1СИнтеграция.ВладелецФайлаКартинкиКатегории(СсылкаНаОбъект);	
	Иначе
		ВладелецФайла = ЗначенияРеквизитов.ВладелецФайла;
	КонецЕсли;
		
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ВладелецФайла%", ВладелецФайла);
	
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИнформацияОбОшибке%", Причина);
	
	ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
								УровеньЖурналаРегистрации.Ошибка,
								МетаданныеОбъекта,
								СсылкаНаОбъект,
								ТекстСообщения);
	
КонецПроцедуры

Функция ЕстьПроблемаОтправкиКартинки(Узел, СсылкаНаОбъект = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РезультатыОбменаДанными.ПроблемныйОбъект КАК ПроблемныйОбъект
	|ИЗ
	|	РегистрСведений.РезультатыОбменаДанными КАК РезультатыОбменаДанными
	|ГДЕ
	|	РезультатыОбменаДанными.ТипПроблемы = &ТипПроблемы
	|	И РезультатыОбменаДанными.УзелИнформационнойБазы = &УзелИнформационнойБазы
	|	И РезультатыОбменаДанными.ОбъектМетаданных В (&ОбъектыМетаданных)
	|	И (&ПроблемныйОбъект = НЕОПРЕДЕЛЕНО
	|			ИЛИ РезультатыОбменаДанными.ПроблемныйОбъект = &ПроблемныйОбъект)";
	
	Запрос.УстановитьПараметр("ТипПроблемы", ТипПроблемОбменаДанными());
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", Узел);
	Запрос.УстановитьПараметр("ПроблемныйОбъект", СсылкаНаОбъект);
	Если СсылкаНаОбъект = Неопределено Тогда
		Запрос.УстановитьПараметр("ОбъектыМетаданных", 
			Маг1СИнтеграция.ИдентификаторыОбъектовМетаданныхСправочниковКартинок());
	Иначе
		Запрос.УстановитьПараметр("ОбъектыМетаданных", 
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
				ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СсылкаНаОбъект.Метаданные())));
	КонецЕсли;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

