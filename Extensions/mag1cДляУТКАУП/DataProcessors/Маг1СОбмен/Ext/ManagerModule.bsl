Функция ОписаниеСсылки() Экспорт
	ОписаниеСсылки = Новый Структура;
	ОписаниеСсылки.Вставить("Ид", ""); 
	ОписаниеСсылки.Вставить("ТипСсылки", ""); 
	ОписаниеСсылки.Вставить("Представление", "");
	
	Возврат ОписаниеСсылки; 
КонецФункции

Функция УстановитьТелоПоОснованиюВременнойСсылки(Запрос, Основание)
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	Если ТипЗнч(Основание) <> ТипЗнч(НастройкиУчетнойСистемы.ЗаказПокупателя.Значение) Тогда
		ТекстИсключения = НСтр("ru = 'Тип %Тип% не поддерживается для получения временных ссылок в сервисе mag1c'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Тип%", Строка(ТипЗнч(Основание)));
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;

	ОписаниеСсылки = ОписаниеСсылки();
	ОписаниеСсылки.Ид = Строка(Основание.УникальныйИдентификатор()); 
	ОписаниеСсылки.ТипСсылки = Маг1СПеречисления.ТипыСсылок_ЗаказыКлиентов(); 
	ОписаниеСсылки.Представление = Строка(Основание); 
	
	УстановитьТелоОписаниюСсылки(Запрос, ОписаниеСсылки);

КонецФункции

Функция УстановитьТелоОписаниюСсылки(Запрос, ОписаниеСсылки)
	
	Запрос.Заголовки.Вставить("Data-Format-Version", ВерсияФорматаОбмена());
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(Маг1СИнтеграцияСлужебный.СтруктураВСтрокуJSON(ОписаниеСсылки));

КонецФункции


Функция ВременнаяСсылкаВСервисе(ОписаниеВСервисе, Состояние)
	
	Результат = Маг1СИнтеграцияСлужебныйКлиентСервер.ОписаниеВременнойСсылки(Состояние);
	Результат.Ссылка      = ОписаниеВСервисе.Link;
	Если Не ПустаяСтрока(ОписаниеВСервисе.ValidUntil) Тогда
		Результат.ДействуетДо = Дата(ОписаниеВСервисе.ValidUntil);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область КонвертацияДанных

Функция ЗагрузитьДанные(УзелОбмена, ИмяФайлаДляЗагрузки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДействияПриОбменеИмя = "ДействияПриОбмене";
	
	ДействиеПриОбмене = Перечисления[ДействияПриОбменеИмя].ЗагрузкаДанных;
	
	НомерПринятого = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "НомерПринятого");
	
	ЕстьЗагруженные = Ложь;
	Попытка
 		ОбработкаКонвертацииXDTO = ОбработкаОбменаДаннымиДляЗагрузки(УзелОбмена);
		ОбработкаКонвертацииXDTO.ИмяФайлаОбмена = ИмяФайлаДляЗагрузки;
		
		ПараметрыЗагрузки = Новый Структура;
		ПараметрыЗагрузки.Вставить("ОбменДаннымиСВнешнейСистемой", Ложь);
		
		ОбработкаКонвертацииXDTO.ВыполнитьЗагрузкуДанных(ПараметрыЗагрузки);
		
		Если РезультатВыполненияОбменаВыполнено(ОбработкаКонвертацииXDTO.РезультатВыполненияОбмена()) Тогда
			УзелОбменаОбъект = УзелОбмена.ПолучитьОбъект();
			УзелОбменаОбъект.НомерПринятого = НомерПринятого + 1;
			УзелОбменаОбъект.ДополнительныеСвойства.Вставить("ПолучениеСообщенияОбмена");
			УзелОбменаОбъект.Записать();
			
			ЕстьЗагруженные = ОбработкаКонвертацииXDTO.СчетчикЗагруженныхОбъектов() > 0;
		Иначе
			ВызватьИсключение ОбработкаКонвертацииXDTO.СтрокаСообщенияОбОшибке();
		КонецЕсли;
		
	Исключение
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,
									ПодробноеПредставлениеОшибки(Информация));
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ЕстьЗагруженные;
	
КонецФункции

Функция ВыгрузитьДанные(УзелОбмена, ИмяФайлаДляВыгрузки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДействияПриОбменеИмя = "ДействияПриОбмене";
	
	ДействиеПриОбмене = Перечисления[ДействияПриОбменеИмя].ВыгрузкаДанных;
		
	ЕстьВыгруженныеОбъекты = Ложь;
	Попытка
		ОбработкаКонвертацииXDTO = ОбработкаОбменаДаннымиДляВыгрузки(УзелОбмена);
		ОбработкаКонвертацииXDTO.ИмяФайлаОбмена = ИмяФайлаДляВыгрузки;
		
		ОбработкаКонвертацииXDTO.ВыполнитьВыгрузкуДанных();
		
		// Нужно повторно заблокировать узел, т.к. в ОбработкаКонвертацииXDTO он по ошибке разблокируется 
		ПроверитьВозможностьЗапускаОбмена(УзелОбмена, Ложь);
		
		Если РезультатВыполненияОбменаВыполнено(ОбработкаКонвертацииXDTO.РезультатВыполненияОбмена()) Тогда
			ЕстьВыгруженныеОбъекты = ЕстьВыгруженныеОбъекты(ИмяФайлаДляВыгрузки);
		Иначе
			ВызватьИсключение ОбработкаКонвертацииXDTO.СтрокаСообщенияОбОшибке();
		КонецЕсли;
		
	Исключение
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,
									ПодробноеПредставлениеОшибки(Информация));

		ВызватьИсключение;
	КонецПопытки;
		
	Возврат ЕстьВыгруженныеОбъекты;
	
КонецФункции

Процедура УдалитьРегистрациюИзменений(УзелОбмена, НомерСообщения, ДатаНачалаОбмена, НастройкиУчетнойСистемы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	Попытка
		НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(УзелОбмена);
		ИдентификаторВитрины = НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины;
		
		Маг1СИнтеграцияСлужебный.ПодтвердитьЗагрузкуВсехСлепковДанных(ИдентификаторВитрины, НомерСообщения);
		
		// Добавляем публичные идентификаторы для ссылочных объектов, о получении которых отчитался узел-корреспондент.
		ДобавитьВыгруженныеОбъектыВРегистрПубличныеИдентификаторы(УзелОбмена, НомерСообщения, ДатаНачалаОбмена, НастройкиВитрины, НастройкиУчетнойСистемы);
		
		// Удаляем регистрацию изменений, о получении которых отчитался узел-корреспондент.
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, НомерСообщения);
		
		Маг1СИнтеграция.УдалитьРегистрациюВыгрузкиДополнительныхДанных(ИдентификаторВитрины, ДатаНачалаОбмена, НомерСообщения);
		
		// Снимаем признак начальной выгрузки данных.
		РегистрыСведений["ОбщиеНастройкиУзловИнформационныхБаз"].СнятьПризнакНачальнойВыгрузкиДанных(УзелОбмена, НомерСообщения);
		
		Маг1СИнтеграция.СохранитьПубличныеИдентификаторыВыгруженныхСсылочныхЗначенийСвойств(УзелОбмена, НомерСообщения);
		
		Маг1СИнтеграция.УдалитьРегистрациюКОбменуЗначенийСсылочныхСвойств(УзелОбмена, НомерСообщения);		
		Маг1СИнтеграция.УдалитьОтметкуНужностиДляВременнойСсылки(УзелОбмена); 		
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Информация = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,
									ПодробноеПредставлениеОшибки(Информация));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПроверитьВЦиклеВозможностьЗапускаОбмена(УзелОбмена, ОтказЗапуска)
	
	ПроверитьВозможностьЗапускаОбмена(УзелОбмена, ОтказЗапуска);
	
	ВремяЗавершения = ТекущаяДатаСеанса() + 5 * 60;
	
	Пауза = 3;
	
	Пока ОтказЗапуска
		И ТекущаяДатаСеанса() < ВремяЗавершения Цикл
		Маг1СИнтеграцияСлужебный.Пауза(Пауза);
		
		Если Пауза < 30 Тогда
			Пауза = Пауза + 3;
		КонецЕсли;
		
		ОтказЗапуска = Ложь;
		
		ПроверитьВозможностьЗапускаОбмена(УзелОбмена, ОтказЗапуска);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьВозможностьЗапускаОбмена(УзелОбмена, Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ЗаблокироватьДанныеДляРедактирования(УзелОбмена);
	Исключение
		Отказ = Истина;
		
		СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось выполнить обмен данными с %1.
			|Обмен данными уже выполняется. Повторите попытку позже.'"),
			УзелОбмена);
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ОбменСВитриной(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			СообщениеОбОшибке);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеНастройкамиОбмена

// Сохраняет настройки подключения для обмена с внешней системой через EnterpriseData. 
//
// Параметры:
//  ОписаниеНастройки - Структура - описание настройки обмена:
//    * ИмяПланаОбмена - Строка - имя плана обмена, на котором создается узел.
//    * ИдентификаторНастройки - Строка - идентификатор варианта настройки,
//                               как он указан в модуле менеджера плана обмена.
//    * НаименованиеКорреспондента - Строка, Неопределено - название корреспондента, как он будет отображаться
//                                   в списке настроенных синхронизаций.
//    * НастройкиТранспорта - Структура - описание параметров транспорта:
//      ** ВидТранспорта - ПеречислениеСсылка.ВидыТранспортаСообщенийОбмена
//      ** ПараметрыТранспорта - Структура - состав полей определяется видом транспорта.
//    * РасписаниеСинхронизации - РасписаниеРегламентногоЗадания, Неопределено - расписание запуска синхронизации.
//    * ИспользоватьРегламентноеЗадание - Булево - Истина, если расписание активно.
//    * НастройкиXDTO - Структура - структура настроек XDTO корреспондента:
//      ** ПоддерживаемыеВерсии - Массив из Строка - перечень поддерживаемых корреспондентом версий формата.
//      ** ПоддерживаемыеОбъекты - ТаблицаЗначений - см. ОбменДаннымиXDTOСервер.ПоддерживаемыеОбъектыФормата                                 
//
//  Возвращаемое значение:
//    ПланОбменаСсылка - узел обмена.
//
Функция СоздатьНастройкуОбмена(СостояниеМастера, СтрокаСпискаВитрин) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаСпискаВитрин.ИдентификаторВитрины)
		Или СтрокаСпискаВитрин.ИдентификаторВитрины = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
		ВызватьИсключение НСтр("ru = 'Не задан идентификатор витрины, создать настройку обмена невозможно.'");
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	
	ОсновныеНастройки           = СостояниеМастера.НастройкиВитрины.ОсновныеНастройки;
	НастройкиУчетнойСистемы     = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
																		
	ВерсияФорматаОбмена = "1.9";
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	Попытка
		ОбменДаннымиСервер.ПроверитьИспользованиеОбменаДанными(Истина);
		
		МенеджерПланаОбмена = ПланыОбмена[НастройкиУчетнойСистемы.ИмяПланаОбмена];
		
		УзелОбмена = МенеджерПланаОбмена.НайтиПоКоду(СтрокаСпискаВитрин.ИдентификаторВитрины);
		
		Если Не ЗначениеЗаполнено(УзелОбмена) Тогда
			УзелОбменаОбъект = МенеджерПланаОбмена.СоздатьУзел();
			УзелОбменаОбъект.Код          = СтрокаСпискаВитрин.ИдентификаторВитрины;
		Иначе
			УзелОбменаОбъект = УзелОбмена.ПолучитьОбъект();
		КонецЕсли;
		
		УзелОбменаОбъект.Наименование = ОсновныеНастройки.НазваниеМагазина;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВариантНастройки", Метаданные.ПланыОбмена[НастройкиУчетнойСистемы.ИмяПланаОбмена]) Тогда
			УзелОбменаОбъект.ВариантНастройки = Маг1СИнтеграция.ИдентификаторВариантаНастройкиОбмена();
		КонецЕсли;
		
		УзелОбменаОбъект.ВерсияФорматаОбмена = ВерсияФорматаОбмена;
		
		УзелОбменаОбъект.Заполнить(Неопределено);
		
		Маг1СИнтеграцияПереопределяемый.ПриСохраненииНастроекОбмена(УзелОбменаОбъект, ОсновныеНастройки);
		
		Если ОбщегоНазначения.РазделениеВключено()
			И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных()
			И ЭтоРазделенныйПланОбменаБСП(НастройкиУчетнойСистемы.ИмяПланаОбмена) Тогда
			
			УзелОбменаОбъект.РегистрироватьИзменения = Истина;
			
		КонецЕсли;
		
		УзелОбменаОбъект.ОбменДанными.Загрузка = Истина;
		УзелОбменаОбъект.Записать();
			
		УзелОбмена = УзелОбменаОбъект.Ссылка;
		
		Если Не ОбщегоНазначения.РазделениеВключено() Тогда
			ОбменДаннымиСервер.ВыполнитьОбновлениеПравилДляОбменаДанными();
		КонецЕсли;
		
		ТаблицаОбъектыБазы = ОбменДаннымиXDTOСервер.ПоддерживаемыеОбъектыФормата(НастройкиУчетнойСистемы.ИмяПланаОбмена,
																				 "ОтправкаПолучение",
																					УзелОбмена);
		
		МенеджерНастройкиXDTO = ОбщегоНазначения.ОбщийМодуль("РегистрыСведений.НастройкиОбменаДаннымиXDTO");
		МенеджерНастройкиXDTO.ОбновитьНастройки(УзелОбмена, "ПоддерживаемыеОбъекты", ТаблицаОбъектыБазы);
		
		НастройкиXDTOКорреспондента = НастройкиXDTOКорреспондента(УзелОбмена,
																	НастройкиУчетнойСистемы.ИмяПланаОбмена, 
																	СтрокаСпискаВитрин.ИдентификаторВитрины);
			
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы",       УзелОбмена);
		СтруктураЗаписи.Вставить("ИмяПланаОбменаКорреспондента", НастройкиУчетнойСистемы.ИмяПланаОбмена);
		
		ОбновитьЗаписьВРегистрСведений(СтруктураЗаписи, "НастройкиОбменаДаннымиXDTO");
		
		МенеджерНастройкиXDTO = ОбщегоНазначения.ОбщийМодуль("РегистрыСведений.НастройкиОбменаДаннымиXDTO");
		МенеджерНастройкиXDTO.ОбновитьНастройкиКорреспондента(УзелОбмена, "ПоддерживаемыеОбъекты", НастройкиXDTOКорреспондента.ПоддерживаемыеОбъекты);
															  
		ОсновныеНастройки.УзелОбмена    = УзелОбмена;
		
		Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
		
		Если Не ОбменДаннымиСервер.НастройкаСинхронизацииЗавершена(УзелОбмена) Тогда
			ОбменДаннымиСервер.ЗавершитьНастройкуСинхронизацииДанных(УзелОбмена);
		КонецЕсли;
		
		НастроитьЗапускСинхронизацииПоРасписанию(УзелОбмена, РасписаниеСинхронизацииПоУмолчанию(), Ложь);	
			
		ЗафиксироватьТранзакцию();
	
	Исключение
		ОтменитьТранзакцию();
		
		Информация = ИнформацияОбОшибке();
		Результат.СообщениеОбОшибке = КраткоеПредставлениеОшибки(Информация);
		Результат.Отказ = Истина;
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_СозданиеНастройкиОбмена(),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Информация));
			
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ОтключитьАвтоматическийОбмен(УзелОбмена, ПроверятьДатуОшибкиОбмена) Экспорт
	
	НужноОтключить = ОбщегоНазначения.РазделениеВключено();
	
	Если Не НужноОтключить
		И ПроверятьДатуОшибкиОбмена Тогда
		
		СохраненнаяДата = Маг1СИнтеграцияСлужебный.ПрочитатьДатуПервойОшибкиОбмена(УзелОбмена);
		Если СохраненнаяДата = Неопределено Тогда
			Маг1СИнтеграцияСлужебный.СохранитьДатуПервойОшибкиОбмена(УзелОбмена);
			Возврат;
		КонецЕсли;
		
		Если СохраненнаяДата > ТекущаяДата() - 7*24*3600  Тогда
			Возврат;
		КонецЕсли;
		
		НужноОтключить = Истина;
		
	КонецЕсли;
	
	Если НужноОтключить Тогда
		НастроитьЗапускСинхронизацииПоРасписанию(УзелОбмена, Неопределено, Ложь);
	КонецЕсли;
		
КонецПроцедуры

Функция СостояниеОбменаПоРасписанию(УзелОбмена) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СинхронизацияЗавершается", Истина);
	Результат.Вставить("ИспользоватьРегламентноеЗадание", Ложь);
	Результат.Вставить("ДатаПервойОшибкиОбмена", '00010101');
	
	Если Не ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДатаПервойОшибкиОбмена = Маг1СИнтеграцияСлужебный.ПрочитатьДатуПервойОшибкиОбмена(УзелОбмена);
	ИспользоватьРегламентноеЗадание = Ложь;
	
	СценарииОбменовДаннымиИмя = Маг1СПеречисления.ИменаСправочников_СценарииОбменовДанными();
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		ИспользоватьРегламентноеЗадание = Истина;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СценарииНастройкиОбмена.Ссылка.РегламентноеЗаданиеGUID КАК РегламентноеЗаданиеGUID
		|ИЗ
		|	Справочник.СценарииОбменовДанными.НастройкиОбмена КАК СценарииНастройкиОбмена
		|ГДЕ
		|	СценарииНастройкиОбмена.УзелИнформационнойБазы = &УзелИнформационнойБазы";
		Запрос.УстановитьПараметр("УзелИнформационнойБазы", УзелОбмена);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			РегламентноеЗаданиеGUID = Выборка.РегламентноеЗаданиеGUID;
				
			РегламентноеЗаданиеОбъект = Справочники[СценарииОбменовДаннымиИмя].РегламентноеЗаданиеПоИдентификатору(РегламентноеЗаданиеGUID);
			
			Если РегламентноеЗаданиеОбъект <> Неопределено 
				И РегламентноеЗаданиеОбъект.Использование Тогда
				
				ИспользоватьРегламентноеЗадание = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
			
	КонецЕсли;	
	
	Результат.СинхронизацияЗавершается       = Не ЗначениеЗаполнено(ДатаПервойОшибкиОбмена);
	Если ЗначениеЗаполнено(ДатаПервойОшибкиОбмена) Тогда
		Результат.ДатаПервойОшибкиОбмена = ДатаПервойОшибкиОбмена;
	КонецЕсли;

	Результат.ИспользоватьРегламентноеЗадание  = ИспользоватьРегламентноеЗадание;
	
	Возврат Результат;
	
КонецФункции

Процедура НастроитьЗапускСинхронизацииПоРасписанию(Корреспондент, РасписаниеСинхронизации, ИспользоватьРегламентноеЗадание)
	
	СценарииОбменовДаннымиИмя = Маг1СПеречисления.ИменаСправочников_СценарииОбменовДанными();
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяСлужебногоПользователя = Маг1СИнтеграцияСлужебный.СлужебныйПользовательИБ(Ложь).Имя;
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		
		КлючЗадания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Корреспондент, "Код");
		
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("ОбластьДанных", РаботаВМоделиСервиса.ЗначениеРазделителяСеанса());
		ПараметрыЗадания.Вставить("ИмяМетода",     "ОбменДаннымиСервер.ВыполнитьОбменДаннымиДляУзлаИнформационнойБазы");
		ПараметрыЗадания.Вставить("Ключ",          КлючЗадания);
		
		ТаблицаЗадания = ОчередьЗаданий.ПолучитьЗадания(ПараметрыЗадания);
		
		Для Каждого СтрТаб из ТаблицаЗадания Цикл
			ОчередьЗаданий.УдалитьЗадание(СтрТаб.Идентификатор);
		КонецЦикла;
		
	Иначе
		СоздатьНовыйСценарий = Истина;
		
		ЭтаВерсияВышеБСД_1_0_4_1 = БСД_ДоступнаТребуемаяВерсия("1.0.4.1");
		Если ЭтаВерсияВышеБСД_1_0_4_1 Тогда 
			МодульТранспортСообщенийОбмена = ОбщегоНазначения.ОбщийМодуль("ТранспортСообщенийОбмена");
			МодульТранспортСообщенийОбмена.СохранитьНастройкиТранспорта(Корреспондент, "WS", Новый Структура, Истина);
		Иначе
			Структура = Новый Структура(
				"Корреспондент, ВидТранспортаСообщенийОбменаПоУмолчанию", 
				Корреспондент, 
				Перечисления["ВидыТранспортаСообщенийОбмена"].WS);
			
			МенеджерНастроекТранспорта = ОбщегоНазначения.ОбщийМодуль("РегистрыСведений.НастройкиТранспортаОбменаДанными");
			МенеджерНастроекТранспорта.ОбновитьЗапись(Структура);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СценарииНастройкиОбмена.Ссылка КАК Сценарий,
			|	СценарииНастройкиОбмена.Ссылка.ИспользоватьРегламентноеЗадание КАК ИспользоватьРегламентноеЗадание,
			|	СценарииНастройкиОбмена.Ссылка.РегламентноеЗаданиеGUID КАК РегламентноеЗаданиеGUID
			|ИЗ
			|	Справочник.СценарииОбменовДанными.НастройкиОбмена КАК СценарииНастройкиОбмена
			|ГДЕ
			|	СценарииНастройкиОбмена.УзелИнформационнойБазы = &УзелИнформационнойБазы";
		Запрос.УстановитьПараметр("УзелИнформационнойБазы", Корреспондент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			РегламентноеЗаданиеОбъект = Справочники[СценарииОбменовДаннымиИмя].РегламентноеЗаданиеПоИдентификатору(Выборка.РегламентноеЗаданиеGUID);
				
			Если РегламентноеЗаданиеОбъект = Неопределено
				Или РегламентноеЗаданиеОбъект.Использование <> ИспользоватьРегламентноеЗадание
				Или Выборка.ИспользоватьРегламентноеЗадание <> ИспользоватьРегламентноеЗадание
				Или РасписаниеСинхронизации <> Неопределено Тогда
				
				СценарийОбменаДанными = Выборка.Сценарий.ПолучитьОбъект();
				СценарийОбменаДанными.ИспользоватьРегламентноеЗадание = ИспользоватьРегламентноеЗадание;
				
				Отказ = Ложь;
				Справочники[СценарииОбменовДаннымиИмя].ОбновитьДанныеРегламентногоЗадания(
					Отказ,
					РасписаниеСинхронизации,
					СценарийОбменаДанными);
				
				СценарийОбменаДанными.Записать();
				
				РегламентноеЗаданиеGUID = СценарийОбменаДанными.РегламентноеЗаданиеGUID; 
			Иначе
				РегламентноеЗаданиеGUID = Выборка.РегламентноеЗаданиеGUID;
			КонецЕсли;
			
			РегламентноеЗаданиеОбъект = Справочники[СценарииОбменовДаннымиИмя].РегламентноеЗаданиеПоИдентификатору(РегламентноеЗаданиеGUID);
			
			Если РегламентноеЗаданиеОбъект.ИмяПользователя <> ИмяСлужебногоПользователя
				Или РегламентноеЗаданиеОбъект.Использование <> ИспользоватьРегламентноеЗадание Тогда
				
				РегламентноеЗаданиеОбъект.Использование = ИспользоватьРегламентноеЗадание;
				РегламентноеЗаданиеОбъект.ИмяПользователя = ИмяСлужебногоПользователя;
				РегламентноеЗаданиеОбъект.Записать();
			КонецЕсли;
				
			СоздатьНовыйСценарий = Ложь;
		КонецЦикла;
		
		Если СоздатьНовыйСценарий
			И РасписаниеСинхронизации <> Неопределено Тогда
			Справочники[СценарииОбменовДаннымиИмя].СоздатьСценарий(
				Корреспондент,
				РасписаниеСинхронизации,
				ИспользоватьРегламентноеЗадание);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция НастройкиXDTOКорреспондента(УзелОбмена, ИмяПланаОбмена, ИдентификаторВитрины)
	
	Результат = Неопределено;
	
	ТекстНастройкиXDTOКорреспондента = НастройкиОбмена();
	ТекстНастройкиXDTOКорреспондента = СтрЗаменить(ТекстНастройкиXDTOКорреспондента, "%ИмяПланаОбмена%", ИмяПланаОбмена); 
	ТекстНастройкиXDTOКорреспондента = СтрЗаменить(ТекстНастройкиXDTOКорреспондента, "%ИдентификаторВитрины%", ИдентификаторВитрины); 
	ТекстНастройкиXDTOКорреспондента = СтрЗаменить(ТекстНастройкиXDTOКорреспондента, "%ИдентификаторЭтогоУзла%", Обработки.Маг1СОбмен.ИдентификаторЭтогоУзла(УзелОбмена,
																																							 ИмяПланаОбмена)); 
	
	НастройкиXDTOКорреспондента = НастройкиXDTOКорреспондентаИзXML(ТекстНастройкиXDTOКорреспондента,
																	ПланыОбмена[ИмяПланаОбмена].ПустаяСсылка());
	
	Возврат НастройкиXDTOКорреспондента;
	
КонецФункции

Функция НастройкиXDTOКорреспондентаИзXML(ТекстНастройкиXDTOКорреспондента, ПланОбменаПустаяСсылка)
	
	Если Метаданные.ОбщиеМодули.Найти("ТранспортСообщенийОбмена") <> Неопределено Тогда

		МодульОбменДаннымиXDTOСервер = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиXDTOСервер");
		НастройкиПодключенияИзXML = 
				МодульОбменДаннымиXDTOСервер.СообщениеОбменаВНастройкиПодключения(ТекстНастройкиXDTOКорреспондента);
			
		НастройкиXDTOКорреспондента = Новый Структура;
		НастройкиXDTOКорреспондента.Вставить("ИдентификаторОтправителя", НастройкиПодключенияИзXML.КодНовогоУзлаВторойБазы);
		НастройкиXDTOКорреспондента.Вставить("Формат", НастройкиПодключенияИзXML.ФорматОбмена);
		НастройкиXDTOКорреспондента.Вставить("ПоддерживаемыеВерсии", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НастройкиПодключенияИзXML.ВерсияФорматаОбмена));
		НастройкиXDTOКорреспондента.Вставить("ПоддерживаемыеОбъекты", НастройкиПодключенияИзXML.ПоддерживаемыеОбъектыФорматаКорреспондента.Получить());
		
	Иначе
	  	МодульПомощникНастройки = ОбменДаннымиСервер.МодульПомощникСозданияОбменаДанными();

		НастройкиXDTOКорреспондента = МодульПомощникНастройки.НастройкиXDTOКорреспондентаИзXML(ТекстНастройкиXDTOКорреспондента,
																								Ложь, 
																								ПланОбменаПустаяСсылка);	
    КонецЕсли;
	
	Возврат НастройкиXDTOКорреспондента;
	
КонецФункции

Процедура ОбновитьНастройкиXDTOКорреспондента(НастройкиВитрины) Экспорт
	
	ОсновныеНастройки = НастройкиВитрины.ОсновныеНастройки;
	
	Если ОсновныеНастройки.УзелОбмена = Неопределено
		Или Не ОбщегоНазначения.СсылкаСуществует(ОсновныеНастройки.УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	УзелОбъект = НужноОбновитьУзел(ОсновныеНастройки.УзелОбмена);
	
	Если УзелОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	НастройкиXDTOКорреспондента = НастройкиXDTOКорреспондента(ОсновныеНастройки.УзелОбмена,
													          НастройкиУчетнойСистемы.ИмяПланаОбмена,
															  НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины);
	
	МаксимальнаяОбщаяВерсия   = ОбменДаннымиXDTOСервер.МаксимальнаяОбщаяВерсияФормата(НастройкиУчетнойСистемы.ИмяПланаОбмена, 
																					НастройкиXDTOКорреспондента.ПоддерживаемыеВерсии);
	
	НачатьТранзакцию();
	Попытка
		УзелОбъект.ВерсияФорматаОбмена = МаксимальнаяОбщаяВерсия;
		
		Маг1СИнтеграцияПереопределяемый.ПриСохраненииНастроекОбмена(УзелОбъект, НастройкиВитрины.ОсновныеНастройки);
		
		УзелОбъект.ОбменДанными.Загрузка = Истина;
		УзелОбъект.Записать();
			
		РегистрыСведений["НастройкиОбменаДаннымиXDTO"].ОбновитьНастройкиКорреспондента(
			ОсновныеНастройки.УзелОбмена,
			"ПоддерживаемыеОбъекты",
			НастройкиXDTOКорреспондента.ПоддерживаемыеОбъекты);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	ВерсияДо = Неопределено;
	УзелОбъект.ДополнительныеСвойства.Свойство("Маг1С_ВерсияРасширенияДо", ВерсияДо);
	
	Маг1СИнтеграцияСлужебный.ОбработатьПереходНаНовуюВерсию(НастройкиВитрины, ВерсияДо);
	
КонецПроцедуры

Функция НужноОбновитьУзел(УзелОбмена)
	
	НаименованиеУзла = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УзелОбмена, "Наименование");
	
	ПоложениеНачала = СтрНайти(НаименованиеУзла, "<#");
	ПоложениеКонца = СтрНайти(НаименованиеУзла, "#>");
	
	ТекущаяВерсияРасширения = Маг1СИнтеграцияСлужебный.ВерсияРасширения();
	
	Если ПоложениеНачала = 0
		Или ПоложениеКонца = 0 Тогда
		УзелОбъект = УзелОбмена.ПолучитьОбъект();
		УзелОбъект.Наименование = СокрЛП(УзелОбъект.Наименование) + " <#" + ТекущаяВерсияРасширения + "#>";
		Возврат УзелОбъект;
	КонецЕсли;
	
	Версия = Сред(НаименованиеУзла, ПоложениеНачала+2, ПоложениеКонца - ПоложениеНачала - 2);
	НужноОбновлять = Ложь;
	
	Попытка
		НужноОбновлять = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Версия, ТекущаяВерсияРасширения) < 0;
	Исключение
		УзелОбъект = УзелОбмена.ПолучитьОбъект();
		УзелОбъект.Наименование = СтрЗаменить(УзелОбъект.Наименование, "<#", "");
		УзелОбъект.Наименование = СтрЗаменить(УзелОбъект.Наименование, "#>", "");
		УзелОбъект.Наименование = СокрЛП(УзелОбъект.Наименование) + " <#" + ТекущаяВерсияРасширения + "#>";
		Возврат УзелОбъект;
	КонецПопытки;	
	
	Если Не НужноОбновлять Тогда
		Возврат Неопределено;
	Иначе
		УзелОбъект = УзелОбмена.ПолучитьОбъект();
		УзелОбъект.Наименование = СтрЗаменить(УзелОбъект.Наименование,
												"<#" + Версия + "#>",
		                                        "<#" + ТекущаяВерсияРасширения + "#>");
		УзелОбъект.ДополнительныеСвойства.Вставить("Маг1С_ВерсияРасширенияДо", Версия); 
		Возврат УзелОбъект;
	КонецЕсли;
	
КонецФункции

Функция РасписаниеСинхронизацииПоУмолчанию() 
	РасписаниеСинхронизации = Новый РасписаниеРегламентногоЗадания;
	РасписаниеСинхронизации.ПериодНедель = 1;
	РасписаниеСинхронизации.ПериодПовтораДней = 1;
	РасписаниеСинхронизации.ПериодПовтораВТечениеДня = 5 * 60;
	
	Возврат РасписаниеСинхронизации;
КонецФункции

Процедура ОбновитьЗаписьВРегистрСведений(СтруктураЗаписи, ИмяРегистра)
	
	ВерсияБСП311 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(СтандартныеПодсистемыСервер.ВерсияБиблиотеки(), "3.1.1.1") >= 0;
	
	МодульОбменДанными = Неопределено;
	
	Если ВерсияБСП311 Тогда
		МодульОбменДанными = ОбменДаннымиСлужебный;
	Иначе
		МодульОбменДанными = ОбменДаннымиСервер;
	КонецЕсли;
	
	МодульОбменДанными.ОбновитьЗаписьВРегистрСведений(СтруктураЗаписи, ИмяРегистра);
	
КонецПроцедуры

Функция ЭтоРазделенныйПланОбменаБСП(ИмяПланаОбмена)
	
	Возврат ОбменДаннымиСервер.ЭтоРазделенныйПланОбменаБСП(ИмяПланаОбмена);
	
КонецФункции

#КонецОбласти

#КонецОбласти

