#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.ЛогинИПП = Неопределено  Тогда
		ВызватьИсключение НСтр("ru = 'Форма не предназначена непосредственного открытия.'");
	КонецЕсли;
	
	ТекущееРасширение = Метаданные.Обработки.Маг1СНастройка.РасширениеКонфигурации();
	
	БезопасныйРежимРасширения = ТекущееРасширение.БезопасныйРежим;
	СинонимРасширения         = ТекущееРасширение.Синоним;
	
	ВерсияПлатформыПодходит   = Маг1СИнтеграцияСлужебный.ВерсияПлатформыПодходит();
	
	Если БезопасныйРежимРасширения
		Или Не ВерсияПлатформыПодходит.ВерсияПодходит Тогда
		Возврат;
	КонецЕсли;
	
	ЛогинИПП                   = Параметры.ЛогинИПП;
	АдресПриложенияВИнтернете  = Параметры.АдресПриложенияВИнтернете;
	ПоказатьСписокДругихВитрин = Параметры.ПоказатьСписокДругихВитрин;
	ДокументСсылка             = Параметры.ДокументСсылка;
	Организация                = Параметры.Организация;
	Контрагент                 = Параметры.Контрагент;
	РежимФормы                 = Параметры.РежимФормы;
	
	Элементы.ДекорацияТекстОшибки1.Видимость = Ложь;
	Элементы.ДекорацияТекстОшибки2.Видимость = Ложь;
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
		Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
			ВызватьИсключение НСтр("ru = 'Не передан документ для которого нужно получить ссылку.'");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Организация) Тогда
			ВызватьИсключение НСтр("ru = 'Не указана организация.'");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			ВызватьИсключение НСтр("ru = 'Не указан контрагент.'");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если БезопасныйРежимРасширения Тогда
		Отказ = Истина;
		
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для работы с сервисом нужно отключить использование безопасного режима расширения ""%1"".</span>'"),
			СинонимРасширения);
			
		Оповещение = Новый ОписаниеОповещения("ВопросОтключениеБезопасногоРежимаРасширенияЗавершение", Маг1СИнтеграцияСлужебныйКлиент);
		
		КнопкиДиалога = Новый СписокЗначений;
		КнопкиДиалога.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Открыть настройки расширений'"));
		КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена);
		
		ПоказатьВопрос(Оповещение, ТекстПредупреждения, КнопкиДиалога); 
		Возврат;
	КонецЕсли;
	
	Если Не ВерсияПлатформыПодходит.ВерсияПодходит Тогда
		Отказ = Истина;
		
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для работы с веб-витриной необходимо обновить версию платформы 1С:Предприятие до версии %1 или старше.</span>'"),
			ВерсияПлатформыПодходит.РекомендуемаяВерсия);
			
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
		
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ЗапуститьПолучениеИнформации", "0.1", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьНовуюВитрину(Команда)
	
	Если ПрофильПользователя = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ПрофильПользователя.ЕстьВозможностьСозданияНовойВитрины Тогда
		ВернутьРезультат();
		Возврат;
	Иначе
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаОграниченияПрофиля;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛокальныйКешНастроек(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОчиститьЛокальныйКешНастроекЗавершение", ЭтотОбъект);
	
	Маг1СИнтеграцияСлужебныйКлиент.ОчиститьЛокальныйКешНастроек(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНачальнаяСтраницаНажатие(Элемент)
	Тема  = НСтр("ru = 'Использование к mag1c. Получение информации по профилю'");
	Текст = НСтр("ru = 'При попытке открыть мастер работы с витриной возникла следующая проблема'");
	Вложение = Неопределено;
	
	Если Витрины <> Неопределено
		И Витрины.Количество() > 0 Тогда
		
		Для Каждого КлючЗначение из Витрины Цикл
			ИдентификаторВитрины = КлючЗначение.Значение.ИдентификаторВитрины;
			ИмяВитрины           = КлючЗначение.Значение.ПолноеИмяВитрины;
			Прервать;
		КонецЦикла;
	Иначе
		ИдентификаторВитрины = "";
		ИмяВитрины           = ИмяВитрины;
	КонецЕсли;
	
	Если Элемент <> Элементы.ФормаОбращениеВТехническуюПоддержку Тогда
		Вложение = Новый Структура;
		Вложение.Вставить("Представление", "ВыгрузкаИзЖурналаРегистрации.txt");
		Вложение.Вставить("Адрес", 
			Маг1СИнтеграцияСлужебныйВызовСервера.ВыгрузитьСообщенияОбОшибкахИзЖР(ПараметрыСобытия,
																				  ЭтотОбъект.УникальныйИдентификатор));
		Вложение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);
	КонецЕсли;
	
	Если Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаПолучениеИнформацииПоПрофилюОшибка Тогда
		Текст = Текст	
				+ Символы.ВК
				+ Элементы.ДекорацияТекстОшибки1.Заголовок;
		
	ИначеЕсли Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаПереподключениеВитриныОшибка Тогда	
		Текст = Текст	
				+ Символы.ВК
				+ Элементы.ДекорацияТекстОшибки2.Заголовок;
		
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(ИдентификаторВитрины,
																	ИмяВитрины,
																	ЛогинИПП,
																	Тема,
																	Текст,
																	Вложение);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	НадписьОбращениеВТехническуюПоддержкуНачальнаяСтраницаНажатие(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НадписьВитринаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ИдентификаторНастройки = СтрЗаменить(Элемент.Имя, "Витрина_", "");
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПерейтиКНастройкам" Тогда
		Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
			Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку();
		КонецЕсли;
		ВернутьРезультат(Витрины[ИдентификаторНастройки]);
		Возврат;
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ПеренастроитьНаЭтуБазу" Тогда
		ЗапуститьПеренастройкуВитрины(Витрины[ИдентификаторНастройки].ИдентификаторВитрины);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибка2ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибка3ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
		Маг1СИнтеграцияСлужебныйКлиент.ПерезапуститьСистему(Маг1СПеречисления.ПараметрыПерезапускаСистемы_Мастер());
	Иначе
		Маг1СИнтеграцияСлужебныйКлиент.ПерезапуститьСистему(Маг1СПеречисления.ПараметрыПерезапускаСистемы_ПолучениеСсылки(), 
															ДокументСсылка);
	КонецЕсли;		

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапуститьПолучениеИнформации()
	
	Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненияОперацииОжидание;
	Элементы.ДекорацияОперацияВыполняется.Заголовок = НСтр("ru = 'Выполняется проверка профиля пользователя Портала 1С:ИТС.
                                                           |Пожалуйста, подождите...'");
	
	Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
		ФоновоеЗадание = ДлительнаяОперацияЗапуститьПолучениеИнформации();
		
		Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
			ЭтотОбъект,
			ФоновоеЗадание,
			Новый ОписаниеОповещения("ДлительнаяОперацияЗапуститьПолучениеИнформацииПриЗавершении", ЭтотОбъект),
			Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
	Иначе
		ФоновоеЗадание = ДлительнаяОперацияПолучениеИнформацииПоСтраницеMag1c();
		
		Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
			ЭтотОбъект,
			ФоновоеЗадание,
			Новый ОписаниеОповещения("ДлительнаяОперацияПолучениеИнформацииПоСтраницеMag1cПриЗавершении", ЭтотОбъект),
			Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
		КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияЗапуститьПолучениеИнформации()
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыОперации.Вставить("АдресПриложенияВИнтернете", АдресПриложенияВИнтернете);
	ПараметрыОперации.Вставить("ЭтоИнтерактивныйЗапуск", Истина);
	ПараметрыОперации.Вставить("СписокВитринОбновлятьВсегда", 
									РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин());
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СНастройка.ПолучениеИнформацииПоПрофилюВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияЗапуститьПолучениеИнформацииПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	ОбработатьРезультатДлительнойОперации(РезультатыВыполнения);
	
	КоличествоВитринКЭтойБазе = 0;
	ВитринаКЭтойБазе          = Неопределено;
	
	Если РезультатыВыполнения.РасширениеОбновлено Тогда
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаПерезапускПрограммы;
		Возврат;
	КонецЕсли;
	
	Если Не РезультатыВыполнения.Отказ Тогда
		Если Витрины.Количество() = 0 Тогда
			СоздатьНовуюВитрину(Неопределено);
			Возврат;
		Иначе
			Для Каждого КлючЗначение из Витрины Цикл
				Если (РезультатыВыполнения.ВитриныПользователя.Количество() = 1
						И КлючЗначение.Значение.ИдентификаторИБ = ИдентификаторИБ)
					Или КлючЗначение.Ключ = Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины() Тогда
					
					ВернутьРезультат(КлючЗначение.Значение);
					Возврат;
				ИначеЕсли КлючЗначение.Значение.ИдентификаторИБ = ИдентификаторИБ Тогда
					КоличествоВитринКЭтойБазе = КоличествоВитринКЭтойБазе + 1;
					ВитринаКЭтойБазе          = КлючЗначение.Значение;
				КонецЕсли;
			КонецЦикла;
			
			Если КоличествоВитринКЭтойБазе = 1
				И ВитринаКЭтойБазе <> Неопределено
				И Не ПоказатьСписокДругихВитрин Тогда
				
				ВернутьРезультат(ВитринаКЭтойБазе);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.СоздатьНовуюВитрину.Видимость = ПрофильПользователя.ЕстьВозможностьСозданияНовойВитрины;
	
	Если РезультатыВыполнения.Отказ Тогда 
		ПоказатьОшибку(РезультатыВыполнения.ПараметрыСобытия,
					   РезультатыВыполнения.СообщениеОбОшибке,
					   Элементы.СтраницаПолучениеИнформацииПоПрофилюОшибка);
	КонецЕсли;
	
	РазместитьВитриныНаФорме(РезультатыВыполнения.Отказ);
	
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияПолучениеИнформацииПоСтраницеMag1c()
	
	ПараметрыОперации = Обработки.Маг1СНастройка.ПолучениеИнформацииОВременнойСсылкеПараметрыОперации();
	ПараметрыОперации.ЛогинИПП = ЛогинИПП;
	ПараметрыОперации.АдресПриложенияВИнтернете = АдресПриложенияВИнтернете;
	ПараметрыОперации.ДокументСсылка            = ДокументСсылка;
	ПараметрыОперации.Организация               = Организация;
	ПараметрыОперации.Контрагент                = Контрагент;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СНастройка.ПолучениеИнформацииОВременнойСсылке",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияПолучениеИнформацииПоСтраницеMag1cПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	ОбработатьРезультатДлительнойОперации(РезультатыВыполнения);
	Если РезультатыВыполнения.РасширениеОбновлено Тогда
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаПерезапускПрограммы;
		Возврат;
	КонецЕсли;
	
	Элементы.СоздатьНовуюВитрину.Видимость = Ложь;
	
	Если РезультатыВыполнения.Отказ Тогда 
		ПоказатьОшибку(РезультатыВыполнения.ПараметрыСобытия,
					   РезультатыВыполнения.СообщениеОбОшибке,
					   Элементы.СтраницаПолучениеИнформацииПоПрофилюОшибка);
		Возврат;
	КонецЕсли;
	
	Если РезультатыВыполнения.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_СоздатьПриложение() Тогда
		
		Если РезультатыВыполнения.ВитриныПользователя.Количество() = 0 Тогда
			ВернутьРезультат();
		Иначе
			ВернутьРезультат(Маг1СИнтеграцияСлужебныйКлиентСервер.ЕдинственноеЗначение(РезультатыВыполнения.ВитриныПользователя));	
		КонецЕсли;
		
	ИначеЕсли РезультатыВыполнения.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку()Тогда
		
		ВернутьРезультат(Маг1СИнтеграцияСлужебныйКлиентСервер.ЕдинственноеЗначение(РезультатыВыполнения.ВитриныПользователя));	
		
	ИначеЕсли РезультатыВыполнения.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ВыбратьПриложение() Тогда
		
		РазместитьВитриныНаФорме(Ложь);
		
	ИначеЕсли РезультатыВыполнения.Действие = Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПерезапуститьПрограмму() Тогда
		
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаПерезапускПрограммы;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатДлительнойОперации(Знач РезультатыВыполнения)
	
	Если РезультатыВыполнения.Свойство("ВитриныПользователя") Тогда
		Витрины             = РезультатыВыполнения.ВитриныПользователя;
	КонецЕсли;
	
	Если Не РезультатыВыполнения.Свойство("ПараметрыСобытия") Тогда
		РезультатыВыполнения.Вставить("ПараметрыСобытия", Новый Структура);
		РезультатыВыполнения.ПараметрыСобытия.Вставить("ДатаНачала", ТекущаяДата() - 600);
		РезультатыВыполнения.ПараметрыСобытия.Вставить("ДатаОкончания", ТекущаяДата());
	КонецЕсли;
	
	Если РезультатыВыполнения.Свойство("ОписаниеКонфигурации") Тогда
		ИдентификаторИБ = РезультатыВыполнения.ОписаниеКонфигурации.ИдентификаторИБ;
	КонецЕсли;
	
	Если РезультатыВыполнения.Свойство("ОписаниеСсылки") Тогда
		ОписаниеСсылки = РезультатыВыполнения.ОписаниеСсылки;
	КонецЕсли;
	
	Если РезультатыВыполнения.Свойство("Действие") Тогда
		Действие = РезультатыВыполнения.Действие;
	КонецЕсли;
	
	Если РезультатыВыполнения.Свойство("ОписаниеИнвайта") Тогда
		ОписаниеИнвайта = РезультатыВыполнения.ОписаниеИнвайта;
	КонецЕсли;
	
	Если Не РезультатыВыполнения.Свойство("РасширениеОбновлено") Тогда
		РезультатыВыполнения.Вставить("РасширениеОбновлено", Ложь);
	КонецЕсли;
		
	Если Не РезультатыВыполнения.Свойство("Отказ") Тогда
		РезультатыВыполнения.Вставить("Отказ", Истина);
	КонецЕсли;
	
	Если Не РезультатыВыполнения.Свойство("СообщениеОбОшибке") Тогда
		РезультатыВыполнения.Вставить("СообщениеОбОшибке", "");
	КонецЕсли;
		
 	Если РезультатыВыполнения.Свойство("ПрофильПользователя") Тогда
		ПрофильПользователя = РезультатыВыполнения.ПрофильПользователя;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПеренастройкуВитрины(ИдентификаторВитрины)
	
	Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненияОперацииОжидание;
	Элементы.ДекорацияОперацияВыполняется.Заголовок = НСтр("ru = 'Выполняется получение настроек витрины.
                                                           |Пожалуйста, подождите...'");
	
	ФоновоеЗадание = ДлительнаяОперацияЗапуститьПеренастройкуВитрины(ИдентификаторВитрины);
	
	Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
		ЭтотОбъект,
		ФоновоеЗадание,
		Новый ОписаниеОповещения("ДлительнаяОперацияЗапуститьПеренастройкуВитриныПриЗавершении", ЭтотОбъект),
		Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
	
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияЗапуститьПеренастройкуВитрины(ИдентификаторВитрины)
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыОперации.Вставить("ИдентификаторВитрины", ИдентификаторВитрины);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СНастройка.ПеренастроитьВитринуНаЭтуБазуВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияЗапуститьПеренастройкуВитриныПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатыВыполнения.Отказ Тогда
		ВернутьРезультат(РезультатыВыполнения.СтрокаСпискаВитрин);
		Возврат;
	Иначе
		ПоказатьОшибку(РезультатыВыполнения.ПараметрыСобытия,
					   РезультатыВыполнения.СообщениеОбОшибке,
					   Элементы.СтраницаПереподключениеВитриныОшибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПриОшибке(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	Если ФоновоеЗадание = Неопределено Тогда // Отменено
		ПоказатьПредупреждение(, НСтр("ru = 'Задание было отменено администратором.'"));
	Иначе
		ПоказатьОшибку(Неопределено,
					   ФоновоеЗадание.ПодробноеПредставлениеОшибки,
					   Элементы.СтраницаПолучениеИнформацииПоПрофилюОшибка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛокальныйКешНастроекЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьЛокальныйКешНастроекНаСервере();
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьЛокальныйКешНастроекНаСервере()
	Маг1СИнтеграцияСлужебный.УдалитьНастройкиВитрины();
КонецПроцедуры

&НаКлиенте
Процедура ВернутьРезультат(СтрокаСпискаВитрин = Неопределено)
	
	Если СтрокаСпискаВитрин = Неопределено Тогда
		СтрокаСпискаВитрин = Маг1СИнтеграцияСлужебныйКлиентСервер.СтрокаСпискаВитрин();
		Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки() Тогда
			СтрокаСпискаВитрин.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c();		
			СтрокаСпискаВитрин.Организация  = Организация;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин); 
	Результат.Вставить("ПрофильПользователя", ПрофильПользователя);
	Результат.Вставить("ОписаниеСсылки", ОписаниеСсылки);
	Результат.Вставить("ОписаниеИнвайта", ОписаниеИнвайта);
	Результат.Вставить("Действие", Действие);
	
	Закрыть(Результат);

КонецПроцедуры

&НаСервере
Процедура ДобавитьКонтролВитрины(СтрокаСпискаВитрин, ГруппаФормы, ЭтоВитринаЭтойБазы)
	
	Декорация = Элементы.Добавить("Витрина_" + Маг1СИнтеграцияСлужебныйКлиентСервер.КлючСпискаВитрин(СтрокаСпискаВитрин.ИдентификаторВитрины),
								  Тип("ДекорацияФормы"),
								  ГруппаФормы);
	Декорация.Вид       = ВидДекорацииФормы.Надпись;
	
	ЧастиЗаголовка = Новый Массив;
	
	Если ЭтоВитринаЭтойБазы Тогда
		
		Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
			Если СтрокаСпискаВитрин.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
				ЗаголовокПерехода = НСтр("ru = 'Перейти к настройкам/Создать витрину'");
			Иначе
				ЗаголовокПерехода = НСтр("ru = 'Перейти к настройкам'");
			КонецЕсли;
		Иначе
			ЗаголовокПерехода = НСтр("ru = 'Выбрать'");
		КонецЕсли;
		
		Если СтрокаСпискаВитрин.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
			ЗаголовокВитрины = Строка(СтрокаСпискаВитрин.Организация);
		Иначе
			ЗаголовокВитрины = Строка(СтрокаСпискаВитрин.ПолноеИмяВитрины);
		КонецЕсли;
			
		ЧастиЗаголовка.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = '<span>%1 <a href=""ПерейтиКНастройкам"">%2</a></span>'"),
				ЗаголовокВитрины,
				ЗаголовокПерехода));
				
		Если СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
			ЧастиЗаголовка.Добавить(Символы.ПС);
			ЧастиЗаголовка.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">%1, состояние: %2</span>'"),
							Строка(СтрокаСпискаВитрин.Организация),
							Маг1СПеречисления.СостоянияВитриныПредставление(СтрокаСпискаВитрин.Состояние)));
			
			Если ЗначениеЗаполнено(СтрокаСпискаВитрин.ДоменПользователя) Тогда
				ЧастиЗаголовка.Добавить(Символы.ПС);
				Если Маг1СИнтеграцияСлужебныйКлиентСервер.СертификатДоменаПользователяЕстьПроблема(СтрокаСпискаВитрин) Тогда
						
					ЧастиЗаголовка.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">%1, состояние: нужно обновить сертификат</span>'"),
							СтрокаСпискаВитрин.ДоменПользователя));
				Иначе
					ПредставлениеСостояния = НРег(Маг1СПеречисления.СостоянияДоменаПользователяПредставление(СтрокаСпискаВитрин.СостояниеДоменаПользователя));
					
					Если Не Маг1СИнтеграцияСлужебныйКлиентСервер.СостояниеДоменаПользователяЕстьПроблема(СтрокаСпискаВитрин.СостояниеДоменаПользователя) Тогда
						ЧастиЗаголовка.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">%1, состояние: %2</span>'"),
							СтрокаСпискаВитрин.ДоменПользователя,
							ПредставлениеСостояния));
					Иначе
						ЧастиЗаголовка.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
							НСтр("ru = '<span style="""">%1, состояние: %2</span>'"),
							СтрокаСпискаВитрин.ДоменПользователя,
							ПредставлениеСостояния));
					КонецЕсли;					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЧастиЗаголовка.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = '<span>%1 <a href=""ПеренастроитьНаЭтуБазу"">Перенастроить на эту базу</a></span>'"),
				СтрокаСпискаВитрин.ПолноеИмяВитрины));
		Если СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
			ЧастиЗаголовка.Добавить(Символы.ПС);
			ЧастиЗаголовка.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">состояние: %1</span>'"),
							Маг1СПеречисления.СостоянияВитриныПредставление(СтрокаСпискаВитрин.Состояние)));
		КонецЕсли;
	КонецЕсли;
	
	Декорация.Заголовок = Новый ФорматированнаяСтрока(ЧастиЗаголовка);
	
	Декорация.УстановитьДействие("ОбработкаНавигационнойСсылки", "Подключаемый_НадписьВитринаОбработкаНавигационнойСсылки");
	
КонецПроцедуры

&НаСервере
Процедура РазместитьВитриныНаФорме(ОшибкаПриПолученииПрофиля)
	
	Если Не ОшибкаПриПолученииПрофиля Тогда
		
		Для Каждого КлючЗначение из Витрины Цикл
			
			Если КлючЗначение.Значение.ИдентификаторИБ = ИдентификаторИБ Тогда
				Если КлючЗначение.Значение.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
					ДобавитьКонтролВитрины(КлючЗначение.Значение, Элементы.ГруппаВитриныЭтойБазыСписок1, Истина);
				Иначе
					ДобавитьКонтролВитрины(КлючЗначение.Значение, Элементы.ГруппаСтраницыMag1cСписок, Истина);
				КонецЕсли;
			ИначеЕсли РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин()
				И КлючЗначение.Значение.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
				ДобавитьКонтролВитрины(КлючЗначение.Значение, Элементы.ГруппаВитриныДругихБазСписок, Ложь);
			КонецЕсли;
			
		КонецЦикла;
		
		Если РежимФормы = Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин() Тогда
			Элементы.ГруппаВитриныЭтойБазы.Заголовок = НСтр("ru = 'Витрины, подключенные к этой базе'");
		Иначе
			Элементы.ГруппаВитриныЭтойБазы.Заголовок = НСтр("ru = 'Выберите витрину, для отображения ссылки'");
		КонецЕсли;
		
		Элементы.СтраницыОсновное.ТекущаяСтраница     = Элементы.СтраницаВыборВитрины;
		Элементы.СоздатьНовуюВитрину.Видимость        = Истина;
		
		Элементы.ГруппаВитриныДругихБаз.Видимость     = Элементы.ГруппаВитриныДругихБазСписок.ПодчиненныеЭлементы.Количество() > 0;
		Элементы.ДекорацияНетВитринЭтойБазы.Видимость = Элементы.ГруппаВитриныЭтойБазыСписок1.ПодчиненныеЭлементы.Количество() = 0;
		Элементы.ГруппаСтраницыMag1c.Видимость        = Элементы.ГруппаСтраницыMag1cСписок.ПодчиненныеЭлементы.Количество() > 0;
		
	Иначе
		Для Каждого КлючЗначение из Витрины Цикл
			
			Если КлючЗначение.Значение.ИдентификаторИБ <> ИдентификаторИБ Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьКонтролВитрины(КлючЗначение.Значение, Элементы.ГруппаВитриныЭтойБазыСписок2, Истина);
			
		КонецЦикла;
		
		Элементы.ДекорацияНетВитринЭтойБазы2.Видимость = Элементы.ГруппаВитриныЭтойБазыСписок2.ПодчиненныеЭлементы.Количество() = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибку(ПараметрыОшибки, СообщениеОбОшибке, СтраницаОшибки)
	
	Элементы.СтраницыОсновное.ТекущаяСтраница = СтраницаОшибки;
	
	Если СтраницаОшибки = Элементы.СтраницаПолучениеИнформацииПоПрофилюОшибка Тогда
		ДекорацияТекстОшибки = Элементы.ДекорацияТекстОшибки1;
	ИначеЕсли СтраницаОшибки = Элементы.СтраницаПереподключениеВитриныОшибка Тогда 
		ДекорацияТекстОшибки = Элементы.ДекорацияТекстОшибки2;
	КонецЕсли;
	
	ПараметрыСобытия = ПараметрыОшибки;
	
	Если Не ПустаяСтрока(СообщениеОбОшибке) Тогда
		ДекорацияТекстОшибки.Видимость = Истина;
		
		ТекстОшибки = НСтр("
			|ru = 'Текст ошибки:
			|
			|%СообщениеОбОшибке%'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СообщениеОбОшибке%", СообщениеОбОшибке);  
		ДекорацияТекстОшибки.Заголовок = ТекстОшибки;
	Иначе
		ДекорацияТекстОшибки.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ДекорацияНетВитринЭтойБазы2.Видимость = Элементы.ГруппаВитриныЭтойБазыСписок2.ПодчиненныеЭлементы.Количество() = 0;
	
КонецПроцедуры

#КонецОбласти
