#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Действие = Параметры.Действие;
	
	Если Не ЗначениеЗаполнено(Действие) Тогда
		Действие = Маг1СПеречисления.ДействияФормыОбмена_Обмен();
	КонецЕсли;
	
	Если Действие = Маг1СПеречисления.ДействияФормыОбмена_Обмен() Тогда
		
		УзелОбмена = Параметры.УзелОбмена;
		
		Если Не ЗначениеЗаполнено(УзелОбмена) Тогда
			ВызватьИсключение НСтр("ru = 'Форма не предназначена непосредственного открытия.'");	
		КонецЕсли;
		
		// Настройки не передаются из вызывающей формы, чтобы алгоритм 
		// обмена сам получал настройки, так же, как при обмене по расписанию - по узлу 
		НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(УзелОбмена);
		
	ИначеЕсли Действие = Маг1СПеречисления.ДействияФормыОбмена_СписокИнвайтов()
			Или Действие = Маг1СПеречисления.ДействияФормыОбмена_ОбменОтменаРегистрацииСписокИнвайтов() Тогда
			
		ПараметрыАвторизации = Параметры.ПараметрыАвторизации;
		НастройкиВитрины     = Параметры.НастройкиВитрины;
		УзелОбмена           = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
		ЕстьКОбмену          = Параметры.ЕстьКОбмену;
		Если ТипЗнч(Параметры.КОтменеРегистрации) = Тип("Массив") Тогда
			КОтменеРегистрации = Новый ФиксированныйМассив(Параметры.КОтменеРегистрации);
		Иначе
			КОтменеРегистрации = Новый ФиксированныйМассив(Новый Массив);
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Неизвестное действие формы.'");
		
	КонецЕсли;
	
	ЗакрытьПриУспехе             = Параметры.ЗакрытьПриУспехе;
	ЖдатьОкончанияТекущегоОбмена = Параметры.ЖдатьОкончанияТекущегоОбмена;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Действие = Маг1СПеречисления.ДействияФормыОбмена_Обмен() Тогда 
		ПодключитьОбработчикОжидания("ЗапуститьОбмен", 0.1, Истина);
	ИначеЕсли Действие = Маг1СПеречисления.ДействияФормыОбмена_ОбменОтменаРегистрацииСписокИнвайтов() Тогда
		Если КОтменеРегистрации.Количество() > 0 Тогда
			ПодключитьОбработчикОжидания("ЗапуститьОтменуРегистрацииПоИнвайтам", 0.1, Истина);
		ИначеЕсли ЕстьКОбмену Тогда
			ПодключитьОбработчикОжидания("ЗапуститьОбмен", 0.1, Истина);
		Иначе
			ПодключитьОбработчикОжидания("ЗапроситьСостояниеПоИнвайтам", 0.1, Истина);
		КонецЕсли;
	ИначеЕсли Действие = Маг1СПеречисления.ДействияФормыОбмена_СписокИнвайтов()Тогда
		ПодключитьОбработчикОжидания("ЗапроситьСостояниеПоИнвайтам", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапуститьОбмен()
	
	Элементы.ДекорацияНадписьВыполняется.Заголовок = НСтр("ru = 'Выполняется синхронизация...'");
	
	ФоновоеЗадание = ДлительнаяОперацияВыполнитьОбмен();
	
	Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
		ЭтотОбъект,
		ФоновоеЗадание,
		Новый ОписаниеОповещения("ДлительнаяОперацияВыполнитьОбменПриЗавершении", ЭтотОбъект),
		Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияВыполнитьОбмен()
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("УзелОбмена", УзелОбмена);
	ПараметрыОперации.Вставить("ЖдатьОкончанияТекущегоОбмена", ЖдатьОкончанияТекущегоОбмена);
	ПараметрыОперации.Вставить("НастройкиВитрины", НастройкиВитрины);
	ПараметрыОперации.Вставить("ЭтоИнтерактивныйЗапуск", Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СОбмен.ВыполнитьОбменВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияВыполнитьОбменПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатыВыполнения.Отказ
		Или (РезультатыВыполнения.ОбменУжеВыполняется
		И Действие = Маг1СПеречисления.ДействияФормыОбмена_Обмен()) Тогда
		
		Если Действие = Маг1СПеречисления.ДействияФормыОбмена_Обмен() Тогда
			
			Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненоУспех;
			
			Если РезультатыВыполнения.ОбменУжеВыполняется Тогда
				Элементы.ДекорацияНадписьУспех.Заголовок = НСтр("ru = 'Синхронизация уже выполняется, новая не запускалась'");
			КонецЕсли;
			
			Если ЗакрытьПриУспехе Тогда
				Закрыть(Истина);
			КонецЕсли;
			
		ИначеЕсли Действие = Маг1СПеречисления.ДействияФормыОбмена_ОбменОтменаРегистрацииСписокИнвайтов() Тогда
			ЗапроситьСостояниеПоИнвайтам();
		Иначе
			ВызватьИсключение НСтр("ru = 'Неизвестное действие формы.'");
		КонецЕсли;
		
	ИначеЕсли РезультатыВыполнения.РасширениеОбновлено Тогда
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаПерезапускПрограммы;
	Иначе
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненоОшибка;
		ПараметрыСобытия = РезультатыВыполнения.ПараметрыСобытия;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибкаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	Тема  = НСтр("ru = 'Синхронизации с mag1c'");
	Текст = НСтр("ru = 'При запуске вручную синхронизации с витриной возникла следующая проблема'");
	Вложение = Неопределено;
	
	Если Элемент <> Элементы.ФормаСоздатьОбращениеВТехническуюПоддержку Тогда
		Вложение = Новый Структура;
		Вложение.Вставить("Представление", "ВыгрузкаИзЖурналаРегистрации.txt");
		Вложение.Вставить("Адрес", 
			Маг1СИнтеграцияСлужебныйВызовСервера.ВыгрузитьСообщенияОбОшибкахИзЖР(ПараметрыСобытия,
																				  ЭтотОбъект.УникальныйИдентификатор));
		Вложение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);
	КонецЕсли;
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																   НастройкиВитрины.ОсновныеНастройки.ИмяВитрины,
																   НастройкиВитрины.ЛогинИПП,
																   Тема,
																   Текст,
																   Вложение);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибка3ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПерезапуститьСистему(Маг1СПеречисления.ПараметрыПерезапускаСистемы_Пусто());
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОтменуРегистрацииПоИнвайтам()
	Элементы.ДекорацияНадписьВыполняется.Заголовок = НСтр("ru = 'Отменяется регистрация по инвайтам...'");
	
	ФоновоеЗадание = ДлительнаяОперацияОтменаРегистрацииПоИнвайтам();
	
	Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
		ЭтотОбъект,
		ФоновоеЗадание,
		Новый ОписаниеОповещения("ДлительнаяОперацияОтменаРегистрацииПоИнвайтамПриЗавершении", ЭтотОбъект),
		Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияОтменаРегистрацииПоИнвайтам()
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ПараметрыОперации.Вставить("КОтменеРегистрации", КОтменеРегистрации);
	ПараметрыОперации.Вставить("УзелОбмена", УзелОбмена);
	ПараметрыОперации.Вставить("НастройкиВитрины", НастройкиВитрины);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СОбмен.СброситьРегистрациюПоИнвайтамВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияОтменаРегистрацииПоИнвайтамПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	ПараметрыАвторизации = РезультатыВыполнения.ПараметрыАвторизации;
	
	Если Не РезультатыВыполнения.Отказ Тогда
		Если ЕстьКОбмену Тогда
			ЗапуститьОбмен();
		Иначе
			ЗапроситьСостояниеПоИнвайтам();
		КонецЕсли;
	Иначе
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненоОшибка;
		ПараметрыСобытия = РезультатыВыполнения.ПараметрыСобытия;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьСостояниеПоИнвайтам()
	Элементы.ДекорацияНадписьВыполняется.Заголовок = НСтр("ru = 'Получается информация по инвайтам...'");
	
	ФоновоеЗадание = ДлительнаяОперацияЗапроситьСостояниеПоИнвайтам();
	
	Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
		ЭтотОбъект,
		ФоновоеЗадание,
		Новый ОписаниеОповещения("ДлительнаяОперацияЗапроситьСостояниеПоИнвайтамПриЗавершении", ЭтотОбъект),
		Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияЗапроситьСостояниеПоИнвайтам()
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ПараметрыОперации.Вставить("НастройкиВитрины", НастройкиВитрины);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СОбмен.ПолучитьСписокИнвайтовВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияЗапроситьСостояниеПоИнвайтамПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	ПараметрыАвторизации = РезультатыВыполнения.ПараметрыАвторизации;
	
	Если Не РезультатыВыполнения.Отказ Тогда
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненоУспех;
		
		Если ЗакрытьПриУспехе Тогда
			Закрыть(РезультатыВыполнения);
		КонецЕсли;
	Иначе
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненоОшибка;
		ПараметрыСобытия = РезультатыВыполнения.ПараметрыСобытия;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПриОшибке(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	Если ФоновоеЗадание = Неопределено Тогда // Отменено
		ПоказатьПредупреждение(, НСтр("ru = 'Задание было отменено администратором.'"));
	Иначе
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаВыполненоОшибка;
		ПараметрыСобытия = Новый Структура;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
