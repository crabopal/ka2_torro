#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.НастройкиВитрины = Неопределено
		Или Параметры.НастройкиВитрины.ОсновныеНастройки.УзелОбмена = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Форма предназначена для открытия только из мастера настройки веб-витрины.'");
	КонецЕсли;
	
	НастройкиВитрины = Параметры.НастройкиВитрины;
	УзелОбмена       = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ЗаполнитьНаСервере(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьИзФайлаНаДиске(Команда)
	
	ТекущиеДанные = Элементы.ФайлыСПроблемамиОтправки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выберите файл, с который нужно обновить с диска.</span>'"));
			
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайла(ТекущиеДанные.Файл);
	
	ПараметрыВыполнения = Новый Структура();
	ПараметрыВыполнения.Вставить("СсылкаНаФайл", ТекущиеДанные.Файл); 
	ПараметрыВыполнения.Вставить("ТипВладельца", ТекущиеДанные.ТипВладельца); 
	
	Обработчик = Новый ОписаниеОповещения("ОбновитьИзФайлаНаДискеЗавершение", ЭтотОбъект, ПараметрыВыполнения);
	ДанныеФайла.Вставить("Маг1С_ЭтоДобавлениеВерсииКартинки", Истина);
	РаботаСФайламиСлужебныйКлиент.ОбновитьИзФайлаНаДискеСОповещением(Обработчик, ДанныеФайла, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдаление(Команда)
	
	ТекущиеДанные = Элементы.ФайлыСПроблемамиОтправки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выберите файл, отправку которого нужно отменить.</span>'"));
			
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ПометитьНаУдалениеСервер(ТекущиеДанные.Файл, ТекущиеДанные.ТипВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПовторитьОтправку(Команда)
	
	ТекущиеДанные = Элементы.ФайлыСПроблемамиОтправки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Выберите файл, отправку которого нужно повторить.</span>'"));
			
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	ОтправитьФайлНаСайт(ТекущиеДанные.Файл, ТекущиеДанные.ТипВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	СтандартнаяОбработка = Ложь;
	Тема  = НСтр("ru = 'Работа с mag1c. Проблемы выгрузки картинок'");
	Текст = НСтр("ru = '<Описание проблемы>'");
	
	ИнформацияОФайлах = "";
	
	Для Каждого СтрТабл из ФайлыСПроблемамиОтправки Цикл
		ИнформацияОФайлах = ИнформацияОФайлах +
			СтрТабл.ФайлПредставление + Разделитель() + СтрТабл.ВладелецФайла + Разделитель() + СтрТабл.ДатаВозникновения + Разделитель() + СтрТабл.Причина
			+ Символы.ВК;
	КонецЦикла;
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины,
																			   НастройкиВитрины.ОсновныеНастройки.ИмяВитрины,
																			   НастройкиВитрины.ЛогинИПП,
																			   Тема,
																			   Текст + Символы.ВК + Символы.ВК + ИнформацияОФайлах);
КонецПроцедуры

&НаКлиенте
Функция Разделитель()
	Возврат "|";
КонецФункции

&НаКлиенте
Процедура ФайлыПроблемамиОтправкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ФайлыСПроблемамиОтправки.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	ИначеЕсли Поле = Элементы.ФайлыПроблемамиОтправкиФайл Тогда
		ПоказатьЗначение(,ТекущиеДанные.Файл);
	ИначеЕсли Поле = Элементы.ФайлыПроблемамиОтправкиВладелецФайла Тогда
		ПоказатьЗначение(,ТекущиеДанные.ВладелецФайла);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере(СсылкаНаФайл = Неопределено)
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА РезультатыОбменаДанными.ПроблемныйОбъект ССЫЛКА Справочник.ИмяСправочникаКартинкиНоменклатуры ТОГДА
		|			ВЫРАЗИТЬ(РезультатыОбменаДанными.ПроблемныйОбъект КАК Справочник.ИмяСправочникаКартинкиНоменклатуры).ВладелецФайла
		|		КОГДА РезультатыОбменаДанными.ПроблемныйОбъект ССЫЛКА Справочник.ИмяСправочникаКартинкиХарактеристик ТОГДА
		|			ВЫРАЗИТЬ(РезультатыОбменаДанными.ПроблемныйОбъект КАК Справочник.ИмяСправочникаКартинкиХарактеристик).ВладелецФайла
		|		ИНАЧЕ
		|			НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ВладелецФайла,
		|	РезультатыОбменаДанными.ПроблемныйОбъект КАК Файл,
		|	РезультатыОбменаДанными.ДатаВозникновения КАК ДатаВозникновения,
		|	РезультатыОбменаДанными.Причина КАК Причина,
		|	РезультатыОбменаДанными.ПредставлениеОбъекта КАК ФайлПредставление
		|ИЗ
		|	РегистрСведений.РезультатыОбменаДанными КАК РезультатыОбменаДанными
		|ГДЕ
		|	РезультатыОбменаДанными.ТипПроблемы = &ТипПроблемы
		|	И РезультатыОбменаДанными.УзелИнформационнойБазы = &УзелИнформационнойБазы
		|	И РезультатыОбменаДанными.ОбъектМетаданных В (&ОбъектыМетаданных)
		|	И (&СсылкаНаФайл = НЕОПРЕДЕЛЕНО
		|		ИЛИ РезультатыОбменаДанными.ПроблемныйОбъект = &СсылкаНаФайл)
		|УПОРЯДОЧИТЬ ПО
		|	РезультатыОбменаДанными.ДатаВозникновения УБЫВ,
		|	ВЫРАЗИТЬ(РезультатыОбменаДанными.ПредставлениеОбъекта КАК СТРОКА(100))";
	
	ИмяСправочникаКартинокНоменклатуры = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_НоменклатураКартинки());
	
	Если НастройкиУчетнойСистемы.ХарактеристикиКартинки.ОграничениеТипа <> Неопределено Тогда
		ИмяСправочникаКартинокХарактеристик = Маг1СИнтеграция.ИмяСправочника(НастройкиУчетнойСистемы, Маг1СПеречисления.ИменаСправочников_ХарактеристикиКартинки());
	Иначе
		ИмяСправочникаКартинокХарактеристик = ИмяСправочникаКартинокНоменклатуры;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаКартинкиНоменклатуры", ИмяСправочникаКартинокНоменклатуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаКартинкиХарактеристик", ИмяСправочникаКартинокХарактеристик);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТипПроблемы", Обработки.Маг1СОбмен.ТипПроблемОбменаДанными());
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", УзелОбмена);
	
	Если СсылкаНаФайл = Неопределено Тогда
		ОбъектыМетаданных = Маг1СИнтеграция.ИдентификаторыОбъектовМетаданныхСправочниковКартинок();
	Иначе
		ОбъектыМетаданных = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СсылкаНаФайл.Метаданные()));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СсылкаНаФайл", СсылкаНаФайл);
	Запрос.УстановитьПараметр("ОбъектыМетаданных", ОбъектыМетаданных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если СсылкаНаФайл = Неопределено Тогда
		ФайлыСПроблемамиОтправки.Очистить();
		Пока Выборка.Следующий() Цикл
			
			ВладелецФайла = Неопределено;
			
			Если ТипЗнч(Выборка.Файл) = ТипЗнч(НастройкиУчетнойСистемы.НоменклатураКартинки.Значение) Тогда
				ТипВладельца = Маг1СПеречисления.ТипыСсылок_Номенклатура();
			ИначеЕсли ТипЗнч(Выборка.Файл) = ТипЗнч(НастройкиУчетнойСистемы.ХарактеристикиКартинки.Значение) Тогда
				ТипВладельца = Маг1СПеречисления.ТипыСсылок_ХарактеристикиНоменклатуры();
			ИначеЕсли ТипЗнч(Выборка.Файл) = ТипЗнч(Справочники[Маг1СПеречисления.ИменаСправочников_Файлы()].ПустаяСсылка()) Тогда
				ТипВладельца = Маг1СПеречисления.ТипыСсылок_КатегорииНоменклатуры();
				ВладелецФайла = Маг1СИнтеграция.ВладелецФайлаКартинкиКатегории(Выборка.Файл);
			Иначе
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ФайлыСПроблемамиОтправки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.ТипВладельца = ТипВладельца;
			
			Если ТипВладельца = Маг1СПеречисления.ТипыСсылок_КатегорииНоменклатуры() Тогда
				НоваяСтрока.ВладелецФайла = ВладелецФайла;
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		НайденныеСтроки = ФайлыСПроблемамиОтправки.НайтиСтроки(Новый Структура("Файл", СсылкаНаФайл));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТипВладельца = НайденныеСтроки[0].ТипВладельца;
		ВладелецФайла = НайденныеСтроки[0].ВладелецФайла;
		
		Если Выборка.Следующий() Тогда
			Для Каждого СтрМас из НайденныеСтроки Цикл
				ЗаполнитьЗначенияСвойств(СтрМас, Выборка);
				СтрМас.ТипВладельца = ТипВладельца;
				СтрМас.ВладелецФайла = ВладелецФайла;
			КонецЦикла;
		Иначе
			Для Каждого СтрМас из НайденныеСтроки Цикл
				ФайлыСПроблемамиОтправки.Удалить(СтрМас);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзФайлаНаДискеЗавершение(Результат, ПараметрыВыполнения) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Булево")
		Или Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийФайл = ПараметрыВыполнения;
	ОтправитьФайлНаСайт(ПараметрыВыполнения.СсылкаНаФайл, ПараметрыВыполнения.ТипВладельца);
	ОповеститьОбИзменении(ТекущийФайл);
	Оповестить("Запись_Файл", Новый Структура, ТекущийФайл);
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьФайлНаСайт(СсылкаНаФайл, ТипВладельца)
	
	ОписаниеСсылки = Обработки.Маг1СОбмен.ОписаниеСсылки();
	ОписаниеСсылки.Ид = Строка(СсылкаНаФайл.УникальныйИдентификатор());
	ОписаниеСсылки.ТипСсылки = ТипВладельца;
	
	Если Обработки.Маг1СОбмен.ОтправитьКартинкуНаСайт(УзелОбмена,ОписаниеСсылки , СсылкаНаФайл, Неопределено) Тогда 
		УдалитьСтроку(СсылкаНаФайл);
	Иначе
		ЗаполнитьНаСервере(СсылкаНаФайл);
		ВызватьИсключение НСтр("ru = 'При отправке файла произошла ошибка. Подробная информация - см. колонку ""Причина"".'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПометитьНаУдалениеСервер(СсылкаНаФайл, ТипВладельца)

	ФайлОбъект = СсылкаНаФайл.ПолучитьОбъект();
	ФайлОбъект.УстановитьПометкуУдаления(Истина);
	
	ОписаниеСсылки = Обработки.Маг1СОбмен.ОписаниеСсылки();
	ОписаниеСсылки.Ид = Строка(СсылкаНаФайл.УникальныйИдентификатор());
	ОписаниеСсылки.ТипСсылки = ТипВладельца;
	
	Обработки.Маг1СОбмен.ОтменитьОжиданиеФайлаНаСайте(УзелОбмена, ОписаниеСсылки, СсылкаНаФайл, Неопределено); 
	УдалитьСтроку(СсылкаНаФайл);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтроку(СсылкаНаФайл)
	
	НайденныеСтроки = ФайлыСПроблемамиОтправки.НайтиСтроки(Новый Структура("Файл", СсылкаНаФайл));
	
	Для Каждого СтрМас из НайденныеСтроки Цикл
		ФайлыСПроблемамиОтправки.Удалить(СтрМас);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
