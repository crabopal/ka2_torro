	ПараметрыПомощника.Вставить("НастройкиВитрины", СостояниеМастера().НастройкиВитрины);
	
	ДействиеПриЗакрытии = Новый ОписаниеОповещения("ОбновитьИнформациюОПроблемахСинхронизацииКлиент", ЭтотОбъект);

	ОткрытьФорму("Обработка.Маг1СОбмен.Форма.РешениеПроблемВыгрузкиКартинок",
				 ПараметрыПомощника,
				 ЭтотОбъект,
				 ,
				 ,
				 ,
				 ДействиеПриЗакрытии,
				  );
	
КонецПроцедуры

