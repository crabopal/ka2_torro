#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда) 
	
	ОчиститьСообщения();
	
	Отказ = Ложь;

#Область ПроверкаЗаполнения
	Если Не ПустаяСтрока(НезаполненныеРеквизитыОрганизации) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните обязательные реквизиты организации.'"), "Организация", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НазваниеМагазина) Тогда
		СообщитьПользователюНаКлиенте(НСтр("ru = 'Заполните название компании'"), "НазваниеМагазина", Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТелефонМагазина1) Тогда
