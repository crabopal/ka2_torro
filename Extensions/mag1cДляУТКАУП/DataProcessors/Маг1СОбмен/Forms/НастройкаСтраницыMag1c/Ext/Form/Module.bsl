&НаСервереБезКонтекста
Функция ПараметрыФормыНастройкиСведенийОбОрганизации(Организация)
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("Параметры", Новый Структура);
	
	Маг1СИнтеграцияПереопределяемый.ПриНачалеНастройкиСведенийОбОрганизации(
		Организация,
		Результат.ИмяФормы,
		Результат.Параметры);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ВыполнитьПроверкуСведенийОбОрганизации()
	
	Реквизиты = Новый Массив;
	
	Если Не Элементы.Организация.Видимость
		Или ЗначениеЗаполнено(Организация) Тогда
		
		Настройки = Маг1СИнтеграцияСлужебный.СтруктураНастройкиВитрины();
		Настройки.ОсновныеНастройки.ПараметрыУчета.Организация = Организация; 
		
		СведенияОбОрганизации = Маг1СИнтеграцияСлужебный.СведенияОбОрганизации(Настройки.ОсновныеНастройки);
		
		Если Не ЗначениеЗаполнено(СведенияОбОрганизации.ИНН) Тогда
			Реквизиты.Добавить(НСтр("ru = 'ИНН'"));
		КонецЕсли;
		
		Если СведенияОбОрганизации.ЮридическоеЛицо
			И Не ЗначениеЗаполнено(СведенияОбОрганизации.КПП) Тогда
			Реквизиты.Добавить(НСтр("ru = 'КПП'"));
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СведенияОбОрганизации.ОГРН) Тогда
			Если СведенияОбОрганизации.ЮридическоеЛицо Тогда
				Реквизиты.Добавить(НСтр("ru = 'ОГРН'"));
			Иначе
				Реквизиты.Добавить(НСтр("ru = 'ОГРНИП'"));
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СведенияОбОрганизации.НаименованиеПолное) Тогда
			Реквизиты.Добавить(НСтр("ru = 'Полное наименование'"));
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СведенияОбОрганизации.ЮридическийАдрес)
			И Не ЗначениеЗаполнено(СведенияОбОрганизации.ФактическийАдрес) Тогда
			Реквизиты.Добавить(НСтр("ru = 'Юридический или фактический адрес'"));
		КонецЕсли;
	КонецЕсли;
	
	НезаполненныеРеквизитыОрганизации = СтрСоединить(Реквизиты, ", ");
	
	Если ПустаяСтрока(НезаполненныеРеквизитыОрганизации) Тогда
		Элементы.ДекорацияНадписьНезаполненныеРеквизиты.Видимость = Ложь;
	Иначе
		Элементы.ДекорацияНадписьНезаполненныеРеквизиты.Видимость = Истина;
		
		Элементы.ДекорацияНадписьНезаполненныеРеквизиты.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = 'Заполните обязательные реквизиты: %1'"),
			НезаполненныеРеквизитыОрганизации);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьАдресКартинкиЛоготипа(ТекущееЗначение, ПомещенныйФайл, УникальныйИдентификаторФормы)
	
	Если ЗначениеЗаполнено(ТекущееЗначение)
		И ЭтоАдресВременногоХранилища(ТекущееЗначение) Тогда
		УдалитьИзВременногоХранилища(ТекущееЗначение);
	КонецЕсли;
	
	
	Если ТипЗнч(ПомещенныйФайл) = Тип("Структура") Тогда 
		НовоеЗначение = ПомещенныйФайл.Хранение;
		Расширение    = Маг1СИнтеграцияСлужебныйКлиентСервер.РасширениеИзИмениФайла(ПомещенныйФайл.Имя);
	Иначе
		НовоеЗначение = ПомещенныйФайл;
		Расширение    = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовоеЗначение)
		И ЭтоАдресВременногоХранилища(НовоеЗначение)
		И ЗначениеЗаполнено(Расширение) Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(НовоеЗначение);
		
		Попытка
			СжатыеДанные   = Маг1СИнтеграцияСлужебный.СжатьКартинку(ДвоичныеДанные, 400, 800,, Расширение);
			
			Если СжатыеДанные.КартинкаПреобразована Тогда 
				НовейшийАдрес  = ПоместитьВоВременноеХранилище(СжатыеДанные.ДвоичныеДанные, УникальныйИдентификаторФормы);
				УдалитьИзВременногоХранилища(НовоеЗначение);
				НовоеЗначение = НовейшийАдрес;
			КонецЕсли;
		Исключение
			НовоеЗначение = "";
			ТекстСообщения = НСтр("ru = 'Ошибка при обработке картинки логотипа магазина. Загрузите другой файл логотипа. Описание ошибки: %ОписаниеОшибки%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
	ТекущееЗначение = НовоеЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЛоготипаЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьАдресКартинкиЛоготипа(АдресКартинкиЛоготипа, ПомещенныйФайл, УникальныйИдентификатор);
	
	ПриИзмененииАдресаЛоготипа();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииАдресаЛоготипа()
	
	Элементы.ОчиститьЛоготип.Доступность = ЗначениеЗаполнено(АдресКартинкиЛоготипа);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьЭлементНастройкиУчетнойСистемы(ИмяПараметраУчета, ИмяЭлементаУправления = "")
	
	Настройка = НастройкиУчетнойСистемы[ИмяПараметраУчета];
	
	Если ПустаяСтрока(ИмяЭлементаУправления) Тогда
		ЭлементУправления = Элементы[ИмяПараметраУчета];
	Иначе
		ЭлементУправления = Элементы[ИмяЭлементаУправления];
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Настройка.ОграничениеТипа) Тогда
		ЭлементУправления.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	ЭлементУправления.ОграничениеТипа = Настройка.ОграничениеТипа;
	ЭлементУправления.ВыбиратьТип = (Настройка.ОграничениеТипа.Типы().Количество() > 1); 
	
	Если ЗначениеЗаполнено(Настройка.ПараметрыВыбора)
		И Настройка.ПараметрыВыбора.Количество() > 0 Тогда
		
		ЭлементУправления.ПараметрыВыбора = Маг1СИнтеграция.ВФиксМассивПараметровВыбора(Настройка.ПараметрыВыбора);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.Заголовок) Тогда
		ЭлементУправления.Заголовок = Настройка.Заголовок;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройка.РасширеннаяПодсказка) Тогда
		ЭлементУправления.РасширеннаяПодсказка.Заголовок = Настройка.РасширеннаяПодсказка;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ОчиститьЛокальныйКешНастроекНаСервере()
	Маг1СИнтеграцияСлужебный.УдалитьНастройкиВитрины();
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиВитрины()
	СостояниеМастера = Маг1СИнтеграцияСлужебный.ПрочитатьСостояниеМастераНастройкиВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины);
	
	Если СостояниеМастера = Неопределено Тогда
		СостояниеМастера = Маг1СИнтеграцияСлужебный.СтруктураСостоянияМастера();
		СостояниеМастера.НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Организация = Организация;
		
		Маг1СИнтеграцияСлужебный.ЗаполнитьНастройкиПоУмолчанию(СостояниеМастера,
																НастройкиУчетнойСистемы,
																ЛогинИПП,
																СтрокаСпискаВитрин);
	КонецЕсли;		
	
	ОсновныеНастройки = СостояниеМастера.НастройкиВитрины.ОсновныеНастройки;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОсновныеНастройки);
		
	Если ЗначениеЗаполнено(ОсновныеНастройки.ДанныеКартинкиЛоготипа) Тогда
		АдресДанных = ПоместитьВоВременноеХранилище(ОсновныеНастройки.ДанныеКартинкиЛоготипа, УникальныйИдентификатор);
		УстановитьАдресКартинкиЛоготипа(АдресКартинкиЛоготипа, АдресДанных, УникальныйИдентификатор);
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);
	Если Не (ЗначениеЗаполнено(УзелОбмена)
			И ОбщегоНазначения.СсылкаСуществует(УзелОбмена)
			И СтрокаСпискаВитрин.Состояние <> Маг1СПеречисления.СостоянияВитрины_Deleted()) Тогда 
		УзелОбмена = Неопределено;
	КонецЕсли;
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого КлючЗначение из ОсновныеНастройки.ПараметрыУчета Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение)
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, КлючЗначение.Ключ) Тогда 
			
			ЭтотОбъект[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
			
	ПараметрыЮКасса = ЮКассаПодключена();
	НастроитьДекорацииЮКассаТестовыйМагазин(ЭтотОбъект, ПараметрыЮКасса.ЭтоТестовыйМагазинЮКасса);
	
	ИспользоватьWhatsApp  = ЗначениеЗаполнено(WhatsAppМагазина);
	ИспользоватьViber     = ЗначениеЗаполнено(ViberМагазина);
	ИспользоватьTelegram  = ЗначениеЗаполнено(TelegramМагазина);
	ИспользоватьTelegramКанал = ЗначениеЗаполнено(TelegramКаналМагазина);
	ИспользоватьVK        = ЗначениеЗаполнено(VKМагазина);
	ИспользоватьInstagram = ЗначениеЗаполнено(InstagramМагазина);
	ИспользоватьFacebook  = ЗначениеЗаполнено(FacebookМагазина);
	ИспользоватьЧатБитрикс24 = ЗначениеЗаполнено(ЧатБитрикс24ИмяПользователяМагазина);
	ИспользоватьТелефон2  = ЗначениеЗаполнено(ТелефонМагазина2);
	ИспользоватьТелефон3  = ЗначениеЗаполнено(ТелефонМагазина3);

КонецПроцедуры

&НаКлиенте
Процедура СообщитьПользователюНаКлиенте(ТекстСообщения, ИмяРеквизитаФормы = "", Отказ = Неопределено)
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , ИмяРеквизитаФормы, , Отказ);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииФлажковКонтактнойИнформацииОбработчик(Форма)
	Элементы = Форма.Элементы;
	
	Элементы.WhatsAppМагазина.Доступность = Форма.ИспользоватьWhatsApp;
	Элементы.WhatsAppМагазина.АвтоОтметкаНезаполненного = Форма.ИспользоватьWhatsApp;
	
	Элементы.ViberМагазина.Доступность    = Форма.ИспользоватьViber;
	Элементы.ViberМагазина.АвтоОтметкаНезаполненного    = Форма.ИспользоватьViber;
	
	Элементы.TelegramМагазина.Доступность = Форма.ИспользоватьTelegram;
	Элементы.TelegramМагазина.АвтоОтметкаНезаполненного = Форма.ИспользоватьTelegram;
	
	Элементы.TelegramКаналМагазина.Доступность = Форма.ИспользоватьTelegramКанал;
	Элементы.TelegramКаналМагазина.АвтоОтметкаНезаполненного = Форма.ИспользоватьTelegramКанал;
	
	Элементы.VKМагазина.Доступность               = Форма.ИспользоватьVK;
	Элементы.VKМагазина.АвтоОтметкаНезаполненного = Форма.ИспользоватьVK;

	Элементы.InstagramМагазина.Доступность               = Форма.ИспользоватьInstagram;
	Элементы.InstagramМагазина.АвтоОтметкаНезаполненного = Форма.ИспользоватьInstagram;
	
	Элементы.FacebookМагазина.Доступность                = Форма.ИспользоватьFacebook;
	Элементы.FacebookМагазина.АвтоОтметкаНезаполненного  = Форма.ИспользоватьFacebook;
	
	Элементы.ЧатБитрикс24ИмяПользователяМагазина.Доступность               = Форма.ИспользоватьЧатБитрикс24;
	Элементы.ЧатБитрикс24ИмяПользователяМагазина.АвтоОтметкаНезаполненного = Форма.ИспользоватьЧатБитрикс24;
	
	Элементы.ЧатБитрикс24НазваниеЧатаМагазина.Доступность               = Форма.ИспользоватьЧатБитрикс24;
	Элементы.ЧатБитрикс24НазваниеЧатаМагазина.АвтоОтметкаНезаполненного = Форма.ИспользоватьЧатБитрикс24;
	
	Элементы.ТелефонМагазина2.Доступность               = Форма.ИспользоватьТелефон2;
	Элементы.ТелефонМагазина2.АвтоОтметкаНезаполненного = Форма.ИспользоватьТелефон2;
	Элементы.ТелефонМагазина2Описание.Доступность       = Форма.ИспользоватьТелефон2;
	
	Элементы.ТелефонМагазина3.Доступность               = Форма.ИспользоватьТелефон3;
	Элементы.ТелефонМагазина3.АвтоОтметкаНезаполненного = Форма.ИспользоватьТелефон3;
	Элементы.ТелефонМагазина3Описание.Доступность       = Форма.ИспользоватьТелефон3;
	
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияСохранитьНастройки()
	
	ПараметрыОперации = Обработки.Маг1СНастройка.ПараметрыСоздатьОбновитьСтраницуMag1cВФоновомЗадании();
	ПараметрыОперации.СостояниеМастера    = СостояниеМастера();
	ПараметрыОперации.СтрокаСпискаВитрин  = СтрокаСпискаВитрин;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СНастройка.СоздатьОбновитьСтраницуMag1cВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияСохранитьНастройкиПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	СтрокаСпискаВитрин = РезультатыВыполнения.СтрокаСпискаВитрин; 
	
	Если Не РезультатыВыполнения.Отказ Тогда
		Результат = Новый Структура();
		Результат.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин); 
		Результат.Вставить("Действие", Маг1СПеречисления.ПолучитьИнформациюОВременнойСсылкеДействия_ПолучитьСсылку());
		
		Закрыть(Результат);
	Иначе
		ВосстановитьНастройкиВитрины();
		ПоказатьОшибку(РезультатыВыполнения.ПараметрыСобытия, РезультатыВыполнения.СообщениеОбОшибке);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПриОшибке(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	Если ФоновоеЗадание = Неопределено Тогда // Отменено
		ПоказатьПредупреждение(, НСтр("ru = 'Задание было отменено администратором.'"));
	ИначеЕсли ТипЗнч(ФоновоеЗадание) = Тип("Структура") Тогда
		ПоказатьОшибку(Новый Структура, 
					ФоновоеЗадание.ПодробноеПредставлениеОшибки);
	Иначе
		ПоказатьОшибку(Новый Структура, "");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибку(НовыеПараметрыСобытия, СообщениеОбОшибке) Экспорт
	
	Если Не ПустаяСтрока(СообщениеОбОшибке) Тогда
		Элементы.ДекорацияТекстОшибки.Видимость = Истина;
		
		ТекстОшибки = НСтр("ru = 'Текст ошибки:
                           |
                           |%СообщениеОбОшибке%'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СообщениеОбОшибке%", СообщениеОбОшибке);  
		Элементы.ДекорацияТекстОшибки.Заголовок = ТекстОшибки;
	Иначе
		Элементы.ДекорацияТекстОшибки.Видимость = Ложь;
	КонецЕсли;
	
	ПараметрыСобытия                       = НовыеПараметрыСобытия;
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаОшибки;
	Элементы.Назад.Видимость               = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСостояниеМастера()
	
	СостояниеМастера = СостояниеМастера();
	
	Маг1СИнтеграцияСлужебный.СохранитьСостояниеМастераНастройкиВитрины(СостояниеМастера, СтрокаСпискаВитрин);
	
КонецПроцедуры

&НаСервере
Функция СостояниеМастера()
	
	НастройкиВитрины = Маг1СИнтеграцияСлужебный.СтруктураНастройкиВитрины();
	НастройкиВитрины.ЛогинИПП = ЛогинИПП;
	
	ЗаполнитьЗначенияСвойств(НастройкиВитрины.ОсновныеНастройки, ЭтотОбъект);
		
	Если ЗначениеЗаполнено(АдресКартинкиЛоготипа) Тогда
		НастройкиВитрины.ОсновныеНастройки.ДанныеКартинкиЛоготипа = ПолучитьИзВременногоХранилища(АдресКартинкиЛоготипа);
	КонецЕсли;
	
	НастройкиУведомлений = НастройкиВитрины.ОсновныеНастройки.НастройкиУведомлений;
	ЗаполнитьЗначенияСвойств(НастройкиУведомлений, ЭтотОбъект);
	
	НастройкиДоставки = НастройкиВитрины.ОсновныеНастройки.НастройкиДоставки;
		
	НастройкиДоставки.Самовывоз.Использование           = Истина;
	
	ВариантыОплаты = НастройкиДоставки.Самовывоз.ВариантыОплаты;
	
	ВариантыОплаты.ПереводомНаСчет           = ОплатаПоСсылкеПереводомНаСчет;
	ВариантыОплаты.ОнЛайнЧерезЮКассу         = ОплатаПоСсылкеЧерезЮКассу;
	ВариантыОплаты.ОнЛайнЧерезСБП            = ОплатаПоСсылкеЧерезСБП;
			
	ЗаполнитьЗначенияСвойств(НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета, ЭтотОбъект);
	
	СостояниеМастера = Маг1СИнтеграцияСлужебный.СтруктураСостоянияМастера();	
	СостояниеМастера.НастройкиВитрины = НастройкиВитрины;
		
	Возврат СостояниеМастера; 
КонецФункции

&НаКлиенте
Процедура ОбновитьИнформациюОПроблемахСинхронизацииКлиент(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	Если Не Элементы.ГруппаПроблемыСинхронизации.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьИнформациюОПроблемахСинхронизации();
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюОПроблемахСинхронизации()
	Если Не Элементы.ГруппаПроблемыСинхронизации.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ЕстьПроблемыПередачиКартинок.Видимость = Обработки.Маг1СОбмен.ЕстьПроблемаОтправкиКартинки(УзелОбмена); 											
	
	СостояниеОбменаПоРасписанию = Обработки.Маг1СОбмен.СостояниеОбменаПоРасписанию(УзелОбмена);
	Элементы.НадписьАвтоматическийОбменОтключен.Видимость = Не СостояниеОбменаПоРасписанию.ИспользоватьРегламентноеЗадание;
	Элементы.НадписьСинхронизацияНеЗавершается.Видимость  = Не СостояниеОбменаПоРасписанию.СинхронизацияЗавершается;
															
	Если Элементы.НадписьСинхронизацияНеЗавершается.Видимость Тогда														
		Текст = СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = 'Синхронизация с со страницей mag1c <span style="""">не завершается</span> из-за ошибки начиная с %1. Для получения более подробной информации об ошибке <a href=""ЗапуститьСинхронизацию"">запустите синхронизацию вручную</a>.'"),
					Строка(СостояниеОбменаПоРасписанию.ДатаПервойОшибкиОбмена));		
		Элементы.НадписьСинхронизацияНеЗавершается.Заголовок = Текст;			
	КонецЕсли;	
КонецПроцедуры

