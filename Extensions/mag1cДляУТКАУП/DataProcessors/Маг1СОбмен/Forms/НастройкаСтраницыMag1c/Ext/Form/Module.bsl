#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтрокаСпискаВитрин = Параметры.СтрокаСпискаВитрин;
	ЛогинИПП           = Параметры.ЛогинИПП;
	РежимФормы         = Параметры.РежимФормы;
	
	Организация        = СтрокаСпискаВитрин.Организация;
	
	НастройкиУчетнойСистемы  = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	ЕстьПравоНастройкиВитрины = ПравоДоступа("Просмотр", Метаданные.Обработки.Маг1СНастройка);
		
	ВосстановитьНастройкиВитрины();

	Элементы.ГруппаЮКасса.Видимость = НастройкиУчетнойСистемы.ПоддерживаетсяОплатаЧерезЮКасса;
	
	Элементы.ГруппаСБП.Видимость    = НастройкиУчетнойСистемы.ПоддерживаетсяОплатаЧерезСБП;
		
	Если НастройкиУчетнойСистемы.ПоддерживаетсяОплатаЧерезСБП Тогда
		ИнициализироватьЭлементНастройкиУчетнойСистемы("НастройкаСБП");
	КонецЕсли;
	
	ИнициализироватьЭлементНастройкиУчетнойСистемы("БанковскийСчет");
	
	УстановитьВидимостьБанковскийСчет(ЭтотОбъект);
	УстановитьВидимостьНастройкаСБП(ЭтотОбъект);
	ПриИзмененииФлажковКонтактнойИнформацииОбработчик(ЭтотОбъект);
	
	ВыполнитьПроверкуСведенийОбОрганизации();
	
	Если ИспользоватьWhatsApp
		Или ИспользоватьViber
		Или ИспользоватьTelegram
		Или ИспользоватьTelegramКанал
		Или ИспользоватьVK
		Или ИспользоватьInstagram
		Или ИспользоватьFacebook
		Или ИспользоватьЧатБитрикс24
		Или ИспользоватьТелефон2
		Или ИспользоватьТелефон3 Тогда
		
		Элементы.ГруппаДругиеКонтакты.Показать();
		
	КонецЕсли;
	
	Элементы.Назад.Видимость                = Ложь;
	
	Если РежимФормы <> Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_НастройкаВитрин()
		И Не Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин) Тогда
		
		Если СтрокаСпискаВитрин.Состояние = Маг1СПеречисления.СостоянияВитрины_Deleted() Тогда
			Элементы.ДекорацияПерваяСсылка.Видимость           = Ложь;
			Элементы.ДекорацияУдаленнаяСтраницаmag1c.Видимость = Истина;
		Иначе
			Элементы.ДекорацияПерваяСсылка.Видимость           = Истина;
			Элементы.ДекорацияУдаленнаяСтраницаmag1c.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.ГруппаРекламаmag1cСодержимое.Видимость = Ложь;
		Элементы.ГруппаПолучениеПервойСсылки.Видимость  = Истина;
	Иначе
		Элементы.ГруппаРекламаmag1cСодержимое.Видимость = Истина;
		Элементы.ГруппаПолучениеПервойСсылки.Видимость = Ложь;

		СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
		
		ЕстьВитрины = Ложь;
		
		Для Каждого КлючЗначение из СписокВитрин Цикл
			
			Если КлючЗначение.Значение.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c()
				И Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(КлючЗначение.Значение) Тогда
				ЕстьВитрины = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Элементы.ДекорацияРекламаДругиеВитрины.Видимость = ЕстьВитрины;
		Элементы.ДекорацияРекламаПерваяВитрина.Видимость = Не ЕстьВитрины;
		
	КонецЕсли;
	
	Элементы.ГруппаПроблемыСинхронизации.Видимость = Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(СтрокаСпискаВитрин)
													И ЗначениеЗаполнено(СтрокаСпискаВитрин.ИдентификаторВитрины)
													И СтрокаСпискаВитрин.ИдентификаторВитрины <> Маг1СИнтеграцияСлужебныйКлиентСервер.ИдентификаторНовойВитрины();
	
	ОбновитьИнформациюОПроблемахСинхронизации();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОплатаПриСамовывозеЮКассаПриИзменении(Элемент)
	ПараметрыЮКасса =  ЮКассаПодключена();
	
	Если ЭтотОбъект.ОплатаПоСсылкеЧерезЮКассу Тогда
		Если Не ПараметрыЮКасса.Подключена Тогда
			 ЭтотОбъект.ОплатаПоСсылкеЧерезЮКассу = Ложь;

			 ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">Для включения этого варианта оплаты, необходимо, чтобы по организации %1 была настройка интеграции с ЮKassa с вариантом использования сервиса ""С договором"".</span>'"), Строка(Организация));
						
			 КнопкиВопроса = Новый СписокЗначений();
			 КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК,
			 						СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Перейти к настройкам</span>'")));
			 КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена,
			 						СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Отмена</span>'")));
						
			 ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуНастройкиЮКассы", ЭтотОбъект);
			 
			 ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, КнопкиВопроса,,КодВозвратаДиалога.ОК); 
		КонецЕсли;
	КонецЕсли;
	
	НастроитьДекорацииЮКассаТестовыйМагазин(ЭтотОбъект, ПараметрыЮКасса.ЭтоТестовыйМагазинЮКасса);
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПриСамовывозеСБППриИзменении(Элемент)
	ЕстьНастройки = ПриИзмененииФлажковОплатаСБП(ЭтотОбъект);
	
	Если ЭтотОбъект.ОплатаПоСсылкеЧерезСБП Тогда
		Если Не ЕстьНастройки Тогда
			 ЭтотОбъект.ОплатаПоСсылкеЧерезСБП = Ложь;
			 УстановитьВидимостьНастройкаСБП(ЭтотОбъект);

			 ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">Для включения этого варианта оплаты, необходимо, чтобы по организации %1 была настройка интеграции с СБП.</span>'"), Строка(Организация));
						
			 КнопкиВопроса = Новый СписокЗначений();
			 КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК,
			 						СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Перейти к настройкам</span>'")));
			 КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена,
			 						СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Отмена</span>'")));
						
			 ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуНастройкиСБП", ЭтотОбъект);
			 
			 ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, КнопкиВопроса,,КодВозвратаДиалога.ОК); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиЮКассы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыНастройки = НастройкиУчетнойСистемы.ИмяФормыНастройкиЮКасса;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Раздел", НастройкиУчетнойСистемы.РазделФормыНастройкиЮКасса);

	ОткрытьФорму(ИмяФормыНастройки,
					ПараметрыФормы,
					,
					ИмяФормыНастройки + "." + ПараметрыФормы.Раздел);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиСБП(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыНастройки = НастройкиУчетнойСистемы.ИмяФормыНастройкиСБП;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Раздел", НастройкиУчетнойСистемы.РазделФормыНастройкиСБП);

	ОткрытьФорму(ИмяФормыНастройки,
					ПараметрыФормы,
					,
					ИмяФормыНастройки + "." + ПараметрыФормы.Раздел);
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПоСсылкеПереводомНаСчетПриИзменении(Элемент)
	УстановитьВидимостьБанковскийСчет(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСБППриИзменении(Элемент)
	ОчиститьСообщения();
	Если ЗначениеЗаполнено(НастройкаСБП) Тогда
		ПриИзмененииФлажковОплатаСБП(ЭтотОбъект);
		
		Если Не ЗначениеЗаполнено(НастройкаСБП) Тогда
			ТекстСообщения = НСтр("ru = 'Страница mag1c настроена для работы от имени организации %Организация%. Выбранная настройка не может быть использована для работы с этой организацией. Выберите другую настройку.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Организация%", Организация);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"НастройкаСБП");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьНезаполненныеРеквизитыНажатие(Элемент)
	ЗаполнитьСведенияОбОрганизации();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьСведенияОбОрганизацииОбработкаЗакрытия", ЭтотОбъект);
	
	ПараметрыФормы = ПараметрыФормыНастройкиСведенийОбОрганизации(Организация);
	
	ОткрытьФорму(ПараметрыФормы.ИмяФормы, ПараметрыФормы.Параметры, ЭтотОбъект, , , , Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСведенияОбОрганизацииОбработкаЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполнитьПроверкуСведенийОбОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	Тема =  НСтр("ru = 'Настройка получения ссылки на страницу mag1c.'");
	Текст = НСтр("ru = 'При настройке получения ссылки на страницу mag1c возникла следующая проблема'");
	Вложение = Неопределено;
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(ИдентификаторВитрины,
																	ИмяВитрины,
																	ЛогинИПП,
																	Тема,
																	Текст,
																	Вложение);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииФлажковКонтактнойИнформации(Элемент)
	
	ПриИзмененииФлажковКонтактнойИнформацииОбработчик(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибка2ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);	
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияРекламаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	Если НавигационнаяСсылкаФорматированнойСтроки <> "СоздатьВебВитрину" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЕстьПравоНастройкиВитрины Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для создания веб-витрины, чтобы у вас была роль ""Маг1С: Настройка витрины"". У вас такой роли нет. Обратитесь, пожалуйста, к администратору.</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения); 
		Возврат;
	КонецЕсли;
	Закрыть();

	ПараметрыФормыНастроек = Новый Структура();
	
	ПараметрыФормыНастроек.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыФормыНастроек.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин);
	
	ПараметрыФормыНастроек.Вставить("РежимФормы", Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c());
	ОткрытьФорму("Обработка.Маг1СНастройка.Форма.МастерНастройкиВитрины",
		ПараметрыФормыНастроек,
		,
		,
		,
		,
		,
		 );
		
КонецПроцедуры

&НаКлиенте
Процедура ЕстьПроблемыПередачиКартинокОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
