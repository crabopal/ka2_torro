#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтрокаСпискаВитрин = Параметры.СтрокаСпискаВитрин;
	ОписаниеСсылки     = Параметры.ОписаниеСсылки;
	ОписаниеИнвайта    = Параметры.ОписаниеИнвайта;
	ДокументСсылка     = Параметры.ДокументСсылка;
	ЛогинИПП           = Параметры.ЛогинИПП;
	Контрагент         = Параметры.Контрагент;
	
	ЕстьПравоНастройкиВитрины = ПравоДоступа("Просмотр", Метаданные.Обработки.Маг1СНастройка);
	
	Если СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		Элементы.ОткрытьНастройкиРезультат.Видимость = ЕстьПравоНастройкиВитрины;
		Элементы.ОткрытьНастройки.Видимость  = ЕстьПравоНастройкиВитрины;
	КонецЕсли;
	
	Элементы.ГруппаРекламаmag1c.Видимость = Ложь;
	
	ИнициализироватьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.СкопироватьВБуферОбмена.Видимость = Маг1СИнтеграцияСлужебныйКлиент.ПоддержимаетсяРаботаСБуферомОбмена();
	
	Если НастройкиВитрины = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Не определены настройки страницы mag1c'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания)
		И Не ЗавершениеРаботы Тогда
		ОтменитьВыполнениеДлительнойОперации(ИдентификаторЗадания);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
 
&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент)
	Тема =  НСтр("ru = 'Получение ссылки на страницу mag1c.'");
	Текст = НСтр("ru = 'При получении ссылки на страницу mag1c возникла следующая проблема'");
	Вложение = Неопределено;
	
	Маг1СИнтеграцияСлужебныйКлиент.ОтправитьСообщениеВТехПоддержку(СтрокаСпискаВитрин.ИдентификаторВитрины,
																	ИмяВитрины,
																	ЛогинИПП,
																	Тема,
																	Текст,
																	Вложение);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибка3ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПерезапуститьСистему(Маг1СПеречисления.ПараметрыПерезапускаСистемы_ПолучениеСсылки(), ДокументСсылка);
КонецПроцедуры

&НаКлиенте
Процедура НадписьОбращениеВТехническуюПоддержкуОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	НадписьОбращениеВТехническуюПоддержкуНажатие(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНеЗаполненАдресСкладаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(СкладДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОткрытияСклада", ЭтотОбъект);
	
	ИмяФормыСклада = Маг1СИнтеграцияСлужебныйВызовСервера.ИмяФормыОбъекта(СкладДокумента);
	
	ОткрытьФорму(ИмяФормыСклада,
				Новый Структура("Ключ",СкладДокумента),
				ЭтотОбъект,
				,
				,
				,
				ОписаниеОповещения,
				 );
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытияСклада(Результат, ДополнительноеЗначение) Экспорт
	ПроверитьАдресСклада();
КонецПроцедуры

&НаКлиенте
Процедура ВременнаяСсылкаОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ВременнаяСсылка);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияРекламаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки <> "СоздатьВебВитрину" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЕстьПравоНастройкиВитрины Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Для создания веб-витрины, чтобы у вас была роль ""Маг1С: Настройка витрины"". У вас такой роли нет. Обратитесь, пожалуйста, к администратору.</span>'"));
		ПоказатьПредупреждение(,ТекстПредупреждения); 
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыНастроек = Новый Структура();
	
	ПараметрыФормыНастроек.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыФормыНастроек.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин);
	
	ПараметрыФормыНастроек.Вставить("РежимФормы", Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_СозданиеВитриныИзСтраницыMag1c());
	ОткрытьФорму("Обработка.Маг1СНастройка.Форма.МастерНастройкиВитрины",
		ПараметрыФормыНастроек,
		,
		,
		,
		,
		Новый ОписаниеОповещения("ОткрытьНастройкиПриЗавершении", ЭтотОбъект),
		 );
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЛогоMag1cНажатие(Элемент)
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://v8.1c.ru/its/services/mag1c/");
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияИнвайтИнформацияОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "НастроитьИнвайт" Тогда
		ОткрытьФорму("Обработка.Маг1СРаботаСИнвайтами.Форма.Инвайт",
					Новый Структура("Контрагент,РежимФормы,СтрокаСпискаВитрин", 
									Контрагент,
									Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки(),
									СтрокаСпискаВитрин),
					ЭтотОбъект,
					,
					,
					,
					Новый ОписаниеОповещения("ДекорацияИнвайтИнформацияОбработкаНавигационнойСсылкиЗавершение", ЭтотОбъект),
					 );
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "СостояниеВитрины" Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
						НСтр("ru = '<span style="""">%1'"), СтрокаСпискаВитрин.СообщениеМенеджера);
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияИнвайтИнформацияОбработкаНавигационнойСсылкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеИнвайта = Результат;
	ОтобразитьИнформациюПоСсылке();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОчиститьЛокальныйКешНастроек(Команда)
	Оповещение = Новый ОписаниеОповещения("ОчиститьЛокальныйКешНастроекЗавершение", ЭтотОбъект);
	Маг1СИнтеграцияСлужебныйКлиент.ОчиститьЛокальныйКешНастроек(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛокальныйКешНастроекЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьЛокальныйКешНастроекНаСервере();
	ЗакрытьБезПредупреждения = Истина;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Получить(Команда)
	
	ОчиститьСообщения();
	Отказ = Ложь;
	ПроверитьВариантыОплаты(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаОжидание);
	
	ПодключитьОбработчикОжидания("ПолучитьПриЗавершении", "0.1", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПриЗавершении()
	
	ФоновоеЗадание = ДлительнаяОперацияПолучитьСсылку();
	
	Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
			ЭтотОбъект,
			ФоновоеЗадание,
			Новый ОписаниеОповещения("ДлительнаяОперацияПолучитьСсылкуПриЗавершении", ЭтотОбъект),
			Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура Отозвать(Команда)
	
	ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Отозвать ссылку?</span>'"));
	
	КнопкиВопроса = Новый СписокЗначений();
	КнопкиВопроса.Добавить(КодВозвратаДиалога.ОК,
	СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Да</span>'")));
	КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена,
	СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр("ru = '<span style="""">Отмена</span>'")));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтозватьПриЗавершении", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, КнопкиВопроса,,КодВозвратаДиалога.Отмена); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьПриЗавершении(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаОжидание);
	
	ПодключитьОбработчикОжидания("ОтозватьПриЗавершенииОбработчик", "0.1", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьПриЗавершенииОбработчик()
	
	ФоновоеЗадание = ДлительнаяОперацияОтозватьСсылку();
	
	Маг1СИнтеграцияСлужебныйКлиент.ПриНачалеВыполненияДлительнойОперации(
		ЭтотОбъект,
		ФоновоеЗадание,
		Новый ОписаниеОповещения("ДлительнаяОперацияОтозватьСсылкуПриЗавершении", ЭтотОбъект),
		Новый ОписаниеОповещения("ДлительнаяОперацияПриОшибке", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	
	ПараметрыФормыНастроек = Новый Структура();
	
	ПараметрыФормыНастроек.Вставить("ЛогинИПП", ЛогинИПП);
	ПараметрыФормыНастроек.Вставить("СтрокаСпискаВитрин", СтрокаСпискаВитрин);
	ПараметрыФормыНастроек.Вставить("РежимФормы", Маг1СПеречисления.РежимыПолученияИнформацииПоПрофилю_ПолучениеСсылки());
	
	Если СтрокаСпискаВитрин.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		ОткрытьФорму("Обработка.Маг1СОбмен.Форма.НастройкаСтраницыMag1c",
			ПараметрыФормыНастроек,
			,
			,
			,
			,
			Новый ОписаниеОповещения("ОткрытьНастройкиПриЗавершении", ЭтотОбъект),
			 );	
	Иначе
		ОткрытьФорму("Обработка.Маг1СНастройка.Форма.МастерНастройкиВитрины",
			ПараметрыФормыНастроек,
			,
			,
			,
			,
			Новый ОписаниеОповещения("ОткрытьНастройкиПриЗавершении", ЭтотОбъект),
			 );
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиПриЗавершении(Результат, ДополнительныеПараметры) Экспорт
	
	ИнициализироватьФорму();
	
	Если НастройкиВитрины = Неопределено Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВременнаяСсылкаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ВременнаяСсылка);
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьВБуферОбмена(Команда)
	Маг1СИнтеграцияСлужебныйКлиент.ПоместитьВБуферОбмена(ВременнаяСсылка);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОчиститьЛокальныйКешНастроекНаСервере()
	Маг1СИнтеграцияСлужебный.УдалитьНастройкиВитрины();
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФорму()
	
	НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(СтрокаСпискаВитрин.ИдентификаторВитрины);
	
	Если НастройкиВитрины = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзменилсяРежим = Ложь;
	
	Если НастройкиВитрины.ОсновныеНастройки.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c()
		И СтрокаСпискаВитрин.РежимВитрины = Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		
		ОписаниеСсылки.Ссылка = СтрЗаменить(ОписаниеСсылки.Ссылка,
											СтрокаСпискаВитрин.АдресСайтаВитрины,
											НастройкиВитрины.ОсновныеНастройки.АдресСайтаВитрины);
		ЗаполнитьЗначенияСвойств(СтрокаСпискаВитрин, НастройкиВитрины.ОсновныеНастройки);
	КонецЕсли;
	
	Если Элементы.СрокДействияСсылки.СписокВыбора.Количество() = 0 Тогда	
		Для Каждого СтрМас из Маг1СПеречисления.СрокиДействияВременныхСсылокПорядок() Цикл
			
			Элементы.СрокДействияСсылки.СписокВыбора.Добавить(СтрМас,
			Маг1СПеречисления.СрокиДействияВременныхСсылокПредставление(СтрМас)); 
			
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СрокДействияСсылки) Тогда
		СрокДействияСсылки = Маг1СПеречисления.СрокиДействияВременныхСсылок_7Дней();
	КонецЕсли;
	
	ОтобразитьПодключенныеСпособыОплаты();
	
	Если ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_СсылкаДействует()
		Или ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_ЕстьСсылкаНетОснования() Тогда
		УстановитьТекущуюСтраницу(ЭтотОбъект,  Элементы.СтраницаИнформация);
	Иначе
		УстановитьТекущуюСтраницу(ЭтотОбъект,  Элементы.СтраницаНастройка);
	КонецЕсли;
	
	ОтобразитьИнформациюПоСсылке();
	
	ПроверитьАдресСклада();
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьИнформациюПоСсылке()
	
	Если ЗначениеЗаполнено(ОписаниеСсылки.ДействуетДо) Тогда
		Элементы.ДекорацияСсылкаДействуетДо.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = '<span style="""">действует до %1</span>'"),
		Формат(ОписаниеСсылки.ДействуетДо,"ДФ='dd.MM.yyyy ""г."" HH:mm'"));
	Иначе
		Элементы.ДекорацияСсылкаДействуетДо.Заголовок = "";
	КонецЕсли;
	
	ВременнаяСсылка = ОписаниеСсылки.Ссылка;
	ВременнаяСсылкаОтображение = ВременнаяСсылка;
	
	ЗаголовокИнвайта = "";
	Если СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		Если СтрокаСпискаВитрин.Состояние <> Маг1СПеречисления.СостоянияВитрины_Ready() Тогда
			ЗаголовокИнвайта = СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = '<span style="""">Витрина заблокирована и поэтому покупатели не могут на ней оформлять заказы. <a href = ""СостояниеВитрины"">Подробнее о причинах блокировки...</a></span>'"));
		Иначе	
			ЕстьДоговоры = Маг1СИнтеграция.ЕстьДоговорыКонтрагентов(Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы());
			
			Если ОписаниеИнвайта.Статус = Маг1СПеречисления.СостоянияИнвайта_НеЗарегистрирован()
				Или ОписаниеИнвайта.Статус = Маг1СПеречисления.СостоянияИнвайта_НеПередан() Тогда
				ЗаголовокИнвайта = СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Используя эту ссылку, покупатель также может зарегистрироваться на витрине (<a href = ""НастроитьИнвайт"">запретить регистрацию%1</a>)</span>'"),
				?(ЕстьДоговоры, НСтр("ru = '/настроить цены'"),""));
			ИначеЕсли ОписаниеИнвайта.Статус = Маг1СПеречисления.СостоянияИнвайта_Зарегистрирован() Тогда
				ЗаголовокИнвайта = СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Покупатель зарегистрирован на витрине и может оформлять заказы (<a href = ""НастроитьИнвайт"">отменить регистрацию%1</a>)</span>'"),
				?(ЕстьДоговоры, НСтр("ru = '/настроить цены'"),""));
			ИначеЕсли ОписаниеИнвайта.Статус = Маг1СПеречисления.СостоянияИнвайта_ДоступЗапрещен() Тогда
				ЗаголовокИнвайта = СтроковыеФункции.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Покупатель, может отрыть эту ссылку, но ему запрещена регистрация на витрине и оформление заказов (<a href = ""НастроитьИнвайт"">разрешить регистрацию</a>)</span>'"));
			КонецЕсли;
		КонецЕсли
	КонецЕсли;
	Элементы.ДекорацияИнвайтИнформация.Заголовок = ЗаголовокИнвайта;
	
	Если Элементы.СтраницыФормы.ТекущаяСтраница <> Элементы.СтраницаИнформация
		Или СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c() Тогда
		Элементы.ГруппаРекламаmag1c.Видимость = Ложь;
	Иначе
		Элементы.ГруппаРекламаmag1c.Видимость = Истина;
		
		СписокВитрин = Маг1СИнтеграцияСлужебный.ПрочитатьСписокВитринБазы();
		
		ЕстьВитрины = Ложь;
		
		Для Каждого КлючЗначение из СписокВитрин Цикл
			
			Если КлючЗначение.Значение.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c()
				И Маг1СИнтеграцияСлужебныйКлиентСервер.МожноОбновитьНастройки(КлючЗначение.Значение) Тогда
				ЕстьВитрины = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Элементы.ГруппаРекламаДругиеВитрины.Видимость = ЕстьВитрины;
		Элементы.ГруппаРекламаПерваяВитрина.Видимость = Не ЕстьВитрины;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьПодключенныеСпособыОплаты()
	
	ЧастиСтроки = Новый Массив();
	
	Если НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу Тогда
		ЧастиСтроки.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = '<span style="""">Оплата через ЮKassa (подключен)</span>'")));
	Иначе
		ЧастиСтроки.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = '<span style="""">Оплата через ЮKassa (не подключен)</span>'")));
	КонецЕсли;
	
	ЧастиСтроки.Добавить(Символы.ПС);
	
	Если НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП Тогда
		ЧастиСтроки.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = '<span style="""">Оплата через СБП (подключен)</span>'")));
	Иначе
		ЧастиСтроки.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = '<span style="""">Оплата через СБП (не подключен)</span>'")));
	КонецЕсли;
	
	ЧастиСтроки.Добавить(Символы.ПС);
	
	Если НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеПереводомНаСчет Тогда
		ЧастиСтроки.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = '<span style="""">Получение счета на оплату (подключен)</span>'")));
	Иначе
		ЧастиСтроки.Добавить(СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru = '<span style="""">Получение счета на оплату (не подключен)</span>'")));
	КонецЕсли;
	
	Если НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеПереводомНаСчет Тогда
		Если Не (НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеПереводомНаСчет
				Или НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП) Тогда
			Элементы.ГруппаВременнаяСсылка.Заголовок = НСтр("ru = 'По этой ссылке можно просмотреть заказ и скачать счет'");
			Элементы.ГруппаСсылкаНастройка.Заголовок = НСтр("ru = 'По ссылке можно будет просмотреть заказ и скачать счет в течение'");
		Иначе
			Элементы.ГруппаВременнаяСсылка.Заголовок = НСтр("ru = 'По этой ссылке можно просмотреть и оплатить заказ, скачать счет'");
			Элементы.ГруппаСсылкаНастройка.Заголовок = НСтр("ru = 'По ссылке можно будет просмотреть и оплатить заказ, скачать счет в течение'");
		КонецЕсли;
	Иначе
		Элементы.ГруппаВременнаяСсылка.Заголовок = НСтр("ru = 'По этой ссылке можно просмотреть и оплатить заказ'");
		Элементы.ГруппаСсылкаНастройка.Заголовок = НСтр("ru = 'По ссылке можно будет просмотреть и оплатить заказ в течение'");
	КонецЕсли;
	
	Элементы.ДекорацияПодключенныеСпособыОплатыНастройка.Заголовок = Новый ФорматированнаяСтрока(ЧастиСтроки);
	Элементы.ДекорацияПодключенныеСпособыОплатыИнформация.Заголовок = Новый ФорматированнаяСтрока(ЧастиСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВариантыОплаты(Отказ)
	
	Если Не НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеПереводомНаСчет
		И Не НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеЧерезСБП
		И Не НастройкиВитрины.ОсновныеНастройки.ОплатаПоСсылкеЧерезЮКассу Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите хотя бы один способ онлайн оплаты (через СБП или ЮKassa) или влючите возможность получения счета на оплату.'"),,,,Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьАдресСклада()
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
	
	ВидКИАдресСклада = Маг1СИнтеграцияСлужебныйПовтИсп.ВидКИАдресСклада();
	
	Если Не ЗначениеЗаполнено(ВидКИАдресСклада) Тогда
		Элементы.ГруппаНеЗаполненАдресСклада.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкладДокумента) Тогда
		СкладДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка,
							НастройкиУчетнойСистемы.ЗаказПокупателя.Реквизиты.Склад);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкладДокумента) Тогда
		Элементы.ГруппаНеЗаполненАдресСклада.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Если СтрокаСпискаВитрин.РежимВитрины <> Маг1СПеречисления.РежимыВитрины_СтраницаMag1c()
		И СкладДокумента = НастройкиВитрины.ОсновныеНастройки.ПараметрыУчета.Склад Тогда
		Элементы.ГруппаНеЗаполненАдресСклада.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	МетаданныеСправочника = СкладДокумента.Метаданные();
	
	Если МетаданныеСправочника.Иерархический
		И МетаданныеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СкладДокумента, "ЭтоГруппа") Тогда
		Элементы.ГруппаНеЗаполненАдресСклада.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	АдресСтрокой = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(СкладДокумента,
		ВидКИАдресСклада,,Истина);
		
	Элементы.ГруппаНеЗаполненАдресСклада.Видимость = ПустаяСтрока(АдресСтрокой);
	
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияПолучитьСсылку()
	
	ПараметрыОперации = Обработки.Маг1СОбмен.ПараметрыПередатьДокументПолучитьВременнуюСсылкуВФоновомЗадании();
	ПараметрыОперации.НастройкиВитрины = НастройкиВитрины;
	ПараметрыОперации.ДокументСсылка   = ДокументСсылка;
	ПараметрыОперации.СрокДействия     = СрокДействияСсылки;
	ПараметрыОперации.Контрагент       = Контрагент;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СОбмен.ПередатьДокументПолучитьВременнуюСсылкуВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияПолучитьСсылкуПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатыВыполнения.Отказ Тогда
		
		ОписаниеСсылки  = РезультатыВыполнения.ОписаниеСсылки;
		ОписаниеИнвайта = РезультатыВыполнения.ОписаниеИнвайта;
		
		Если ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_СсылкаДействует()
			Или ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_ЕстьСсылкаНетОснования() Тогда
			УстановитьТекущуюСтраницу(ЭтотОбъект,  Элементы.СтраницаИнформация);
		Иначе
			ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Не удалось получить ссылку((( Попробуйте повторить операцию.</span>'"));
			ПоказатьПредупреждение(,ТекстПредупреждения);
			УстановитьТекущуюСтраницу(ЭтотОбъект,  Элементы.СтраницаНастройка);
		КонецЕсли;
		
		ОтобразитьИнформациюПоСсылке();
		
	ИначеЕсли РезультатыВыполнения.РасширениеОбновлено Тогда
		УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаПерезапускПрограммы);
	Иначе
		УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаОшибка);
		ПараметрыСобытия = РезультатыВыполнения.ПараметрыСобытия;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПриОшибке(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	Если ФоновоеЗадание = Неопределено Тогда // Отменено
		ПоказатьПредупреждение(, НСтр("ru = 'Задание было отменено администратором.'"));
	Иначе
		УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаОшибка);
		ПараметрыСобытия = Новый Структура;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНадписьОшибкаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Маг1СИнтеграцияСлужебныйКлиент.ПоказатьФормуЖурналаРегистрации(ПараметрыСобытия);	
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияОтозватьСсылку()
	
	ПараметрыОперации = Обработки.Маг1СОбмен.ПараметрыПередатьДокументПолучитьВременнуюСсылкуВФоновомЗадании();
	ПараметрыОперации.НастройкиВитрины = НастройкиВитрины;
	ПараметрыОперации.ДокументСсылка   = ДокументСсылка;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СОбмен.ОтозватьВременнуюСсылкуВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияОтозватьСсылкуПриЗавершении(РезультатыВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатыВыполнения.Отказ Тогда
		
		ОписаниеСсылки = РезультатыВыполнения.ОписаниеСсылки;
		
		Если ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_СсылкаДействует()
			Или ОписаниеСсылки.Состояние = Маг1СПеречисления.СостоянияВременныхСсылок_ЕстьСсылкаНетОснования() Тогда
			ТекстПредупреждения = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = '<span style="""">Не удалось отозвать ссылку((( Попробуйте повторить операцию.</span>'"));
			ПоказатьПредупреждение(,ТекстПредупреждения);
			УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаИнформация);
		Иначе
			УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаНастройка);
		КонецЕсли;
		
		ОтобразитьИнформациюПоСсылке();
		
	ИначеЕсли РезультатыВыполнения.РасширениеОбновлено Тогда
		УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаПерезапускПрограммы);
	Иначе
		УстановитьТекущуюСтраницу(ЭтотОбъект, Элементы.СтраницаОшибка);
		ПараметрыСобытия = РезультатыВыполнения.ПараметрыСобытия;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеДлительнойОперации(ИдентификаторЗадания)
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
КонецПроцедуры

&НаКлиенте
Процедура ВременнаяСсылкаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВременнаяСсылкаОтображение = ВременнаяСсылка;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекущуюСтраницу(Форма, НоваяСтраница)
	
	СтраницыФормы = Форма.Элементы.СтраницыФормы;
	СтраницыФормы.ТекущаяСтраница = НоваяСтраница;
	
	Для Каждого СтраницаФормы из СтраницыФормы.ПодчиненныеЭлементы Цикл
		СтраницаФормы.Видимость = СтраницаФормы = НоваяСтраница; 
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти