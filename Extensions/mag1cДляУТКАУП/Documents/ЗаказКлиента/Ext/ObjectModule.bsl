&Перед("ПередЗаписью")
Процедура Маг1С_ПередЗаписьюПеред(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка
		Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("Маг1С_ПередЗаписьюИдентификаторПлатежа", ЭтотОбъект["ИдентификаторПлатежа"]);
КонецПроцедуры


&После("ПередЗаписью")
Процедура Маг1С_ПередЗаписьюПосле(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка
		Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторБыл = Неопределено;
	
	ДополнительныеСвойства.Свойство("Маг1С_ПередЗаписьюИдентификаторПлатежа", ИдентификаторБыл);
	
	Если Не ЗначениеЗаполнено(ИдентификаторБыл)
		Или ИдентификаторБыл = ЭтотОбъект["ИдентификаторПлатежа"] Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебный.НастройкиУчетнойСистемы();
	
	СписокНастроекВитрин = Маг1СИнтеграция.СписокНастроекВитрин();
	
	ДополнительныеСвойства.Вставить("Маг1С_СписокНастроекВитрин", СписокНастроекВитрин);
	ДополнительныеСвойства.Вставить("Маг1С_НастройкиУчетнойСистемы", НастройкиУчетнойСистемы);
	
	Если СписокНастроекВитрин.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоЗаказКонтрагентаВитрины = Ложь;
	
	Для Каждого КлючЗначение из СписокНастроекВитрин Цикл
		НастройкиВитрины = КлючЗначение.Значение;
		
		Если Маг1СИнтеграция.ЭтоКонтрагентВитрины(ЭтотОбъект["Контрагент"],
													НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины) Тогда
			ЭтоЗаказКонтрагентаВитрины = Истина;	
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭтоЗаказКонтрагентаВитрины Тогда
		
		ИдентификаторПлатежа = ИдентификаторБыл; 	
		
	КонецЕсли;
КонецПроцедуры

&После("ПриЗаписи")
Процедура Маг1С_ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка
		Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект["Контрагент"]) Тогда
		Возврат;
	КонецЕсли;
	
	Если Проведен Тогда
		Для Каждого СтрТабл Из ЭтотОбъект["Товары"] Цикл
			Если Не СтрТабл.Отменено Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("Маг1С_СписокНастроекВитрин") Тогда
		СписокНастроекВитрин    = ДополнительныеСвойства.Маг1С_СписокНастроекВитрин;
		НастройкиУчетнойСистемы = ДополнительныеСвойства.Маг1С_НастройкиУчетнойСистемы;
	Иначе
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебный.НастройкиУчетнойСистемы();
		СписокНастроекВитрин    = Маг1СИнтеграция.СписокНастроекВитрин();
	КонецЕсли;
	
	Если СписокНастроекВитрин.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СостоянияЗаказовКлиентовИмя = "СостоянияЗаказовКлиентов";
	
	НаборЗаписей = РегистрыСведений[СостоянияЗаказовКлиентовИмя].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заказ.Установить(Ссылка);
		
	Для Каждого КлючЗначение из СписокНастроекВитрин Цикл
		
		НастройкиВитрины = КлючЗначение.Значение;
		
		УзелОбмена = НастройкиВитрины.ОсновныеНастройки.УзелОбмена;
			
		Если УзелОбмена = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Маг1СИнтеграция.ЭтоКонтрагентВитрины(ЭтотОбъект["Контрагент"],
				НастройкиВитрины.ОсновныеНастройки.ИдентификаторВитрины) Тогда 
			Продолжить;
		КонецЕсли;
		
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, НаборЗаписей);
	
	КонецЦикла;
КонецПроцедуры
