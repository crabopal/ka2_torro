Функция StartExchangePOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(202);
	ИдУзла = Запрос.ПараметрыURL.Получить("IDNode");
	
	Если ИдУзла = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не передан ИД узла обмена с витриной'");
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ЗапускОбменаЧерезСервис(),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки(ТекстСообщения);
		Возврат Ответ; 
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Маг1СИнтеграцияСлужебный.ПрочитатьНеобходимостьОбновленияНастроекВитрин() Тогда
		Маг1СИнтеграцияСлужебный.ОбновитьНастройкиВитринВФоне();
		ТекстСообщения = НСтр("ru = 'Перед запуском обмена необходимо дождаться обновления настроек витрин.%'");			
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ЗапускОбменаЧерезСервис(),
								УровеньЖурналаРегистрации.Ошибка,
								,
								,                                                     
								ТекстСообщения);
		Ответ.КодСостояния = 520;
		Ответ.УстановитьТелоИзСтроки(ТекстСообщения);
		Возврат Ответ; 
	КонецЕсли;
	
	Попытка
				
		НастройкиУчетнойСистемы = Маг1СИнтеграцияСлужебныйПовтИсп.НастройкиУчетнойСистемы();
		УзелОбмена = ПланыОбмена[НастройкиУчетнойСистемы.ИмяПланаОбмена].НайтиПоКоду(ИДУзла);
		
		Если Не ЗначениеЗаполнено(УзелОбмена) 
			Или Не Маг1СИнтеграция.ЭтоУзелОбменаСВитриной(УзелОбмена) Тогда
			ТекстСообщения = НСтр("ru = 'Узел %ИДУзла% не является узлом обмена с веб-витриной'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИДУзла%", ИДУзла);
			
			ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ЗапускОбменаЧерезСервис(),
									УровеньЖурналаРегистрации.Ошибка,
									,
									,                                                     
									ТекстСообщения);
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки(ТекстСообщения);
			Возврат Ответ; 
		Иначе
			НастройкиВитрины = Маг1СИнтеграция.НастройкиВитрины(УзелОбмена);
			
			Если НастройкиВитрины = Неопределено Тогда
				ТекстСообщения = НСтр("ru = 'Ошибка при получении настроек витрины из кеша по узлу %ИДУзла%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ИДУзла%", ИДУзла);
				
				ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ЗапускОбменаЧерезСервис(),
										УровеньЖурналаРегистрации.Ошибка,
										,
										,                                                     
										ТекстСообщения);
				Ответ.КодСостояния = 500;
				Ответ.УстановитьТелоИзСтроки(ТекстСообщения);
				Возврат Ответ; 
			КонецЕсли;
			
		КонецЕсли;
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ЗапускОбменаЧерезСервис(),
								 УровеньЖурналаРегистрации.Ошибка,
								 ,
								 ,
								 ТекстСообщения);
		Ответ.КодСостояния = 520;
		Ответ.УстановитьТелоИзСтроки(ТекстСообщения);
		Возврат Ответ; 
	КонецПопытки;	
	
	Если Маг1СИнтеграцияСлужебный.ПрочитатьНеобходимостьОбновленияНастроекВитрин() Тогда
		Маг1СИнтеграцияСлужебный.ОбновитьНастройкиВитринВФоне();
		ТекстСообщения = НСтр("ru = 'Перед запуском обмена необходимо дождаться обновления настроек витрин.%'");			
		
		ЗаписьЖурналаРегистрации(Маг1СПеречисления.СобытияЖР_ЗапускОбменаЧерезСервис(),
								УровеньЖурналаРегистрации.Ошибка,
								,
								,                                                     
								ТекстСообщения);
		Ответ.КодСостояния = 520;
		Ответ.УстановитьТелоИзСтроки(ТекстСообщения);
		Возврат Ответ; 
	КонецЕсли;	
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("УзелОбмена", УзелОбмена);
	ПараметрыОперации.Вставить("ЖдатьОкончанияТекущегоОбмена", Ложь);
	ПараметрыОперации.Вставить("НастройкиВитрины", НастройкиВитрины);
	ПараметрыОперации.Вставить("ЭтоИнтерактивныйЗапуск", Ложь);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	
	ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.Маг1СОбмен.ВыполнитьОбменВФоновомЗадании",
		ПараметрыОперации,
		ПараметрыВыполнения);
		
	Ответ.УстановитьТелоИзСтроки("OK");
	Возврат Ответ;
КонецФункции