
&НаСервере
Функция СоздатьЗаписиНаСервере()
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение "Не заполнена организация.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		ВызватьИсключение "Не заполнена номенклатура.";
	КонецЕсли;
	
	МассивВидовНоменклатуры = ПолучитьМассивВидовНоменклатурыИзСписка();
	Если МассивВидовНоменклатуры.Количество() = 0 Тогда
		ВызватьИсключение "Не заполнен список видов номенклатуры.";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	битОСУ_СоответствиеВидовНоменклатурыСуммовогоУчета.ВидНомеклатуры КАК ВидНомеклатуры
		|ИЗ
		|	РегистрСведений.битОСУ_СоответствиеВидовНоменклатурыСуммовогоУчета КАК битОСУ_СоответствиеВидовНоменклатурыСуммовогоУчета
		|ГДЕ
		|	битОСУ_СоответствиеВидовНоменклатурыСуммовогоУчета.Организация = &Организация
		|	И битОСУ_СоответствиеВидовНоменклатурыСуммовогоУчета.Номенклатура = &Номенклатура
		|	И битОСУ_СоответствиеВидовНоменклатурыСуммовогоУчета.ВидНомеклатуры В (&МассивВидовНоменклатуры)";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("МассивВидовНоменклатуры", МассивВидовНоменклатуры);
	
	СуществующиеВиды = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = РегистрыСведений.битОСУ_СоответствиеВидовНоменклатурыСуммовогоУчета.СоздатьНаборЗаписей();
	КоличествоСозданных = 0;
	КоличествоПропущенных = 0;
	
	Для Каждого ВидНоменклатуры Из МассивВидовНоменклатуры Цикл
		
		НайденныеСтроки = СуществующиеВиды.НайтиСтроки(Новый Структура("ВидНомеклатуры", ВидНоменклатуры));
		Если НайденныеСтроки.Количество() > 0 Тогда
			КоличествоПропущенных = КоличествоПропущенных + 1;
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Организация = Организация;
		НоваяЗапись.Номенклатура = Номенклатура;
		НоваяЗапись.ВидНомеклатуры = ВидНоменклатуры;
		КоличествоСозданных = КоличествоСозданных + 1;
		
	КонецЦикла;
	
	Если КоличествоСозданных > 0 Тогда
		НаборЗаписей.Записать(РежимЗамещения.Слияние);
	КонецЕсли;
	
	Возврат Новый Структура("КоличествоСозданных,КоличествоПропущенных", КоличествоСозданных, КоличествоПропущенных);
	
КонецФункции

&НаСервере
Функция ПолучитьМассивВидовНоменклатурыИзСписка()
	
	МассивВидовНоменклатуры = Новый Массив;
	
	Для Каждого ЭлементСписка Из СписокВидовНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивВидовНоменклатуры.Найти(ЭлементСписка.Значение) = Неопределено Тогда
			МассивВидовНоменклатуры.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивВидовНоменклатуры;
	
КонецФункции

&НаКлиенте
Процедура СоздатьЗаписи(Команда)
	РезультатСоздания = СоздатьЗаписиНаСервере();
	
	ТекстСообщения = СтрШаблон(
		"Создание завершено. Создано записей: %1. Пропущено существующих: %2.",
		РезультатСоздания.КоличествоСозданных,
		РезультатСоздания.КоличествоПропущенных);
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
	Закрыть();
КонецПроцедуры
