
&НаСервере
Процедура битОСУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	НовыйЭлемент = Элементы.Добавить("бит_ЭтоУПД",Тип("ПолеФормы"),Элементы.ГруппаПараметрыПраво);	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.Заголовок = "Это УПД (БИТ)";
	НовыйЭлемент.ПутьКДанным = "Объект.битОСУ_ЭтоУПД";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.ВидФлажка = ВидФлажка.Выключатель;

КонецПроцедуры
