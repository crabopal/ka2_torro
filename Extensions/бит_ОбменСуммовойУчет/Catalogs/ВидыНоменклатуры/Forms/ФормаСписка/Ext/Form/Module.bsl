&НаСервере
Процедура ДобавитьДанныеВДинамическийСписок()
	
	ТекстЗапроса = ПолучитьТекстЗапросаДинамическогоСписка();	  
	Список.ПроизвольныйЗапрос = Истина;
	Список.ТекстЗапроса = ТекстЗапроса;
	ДобавитьПолеСпискаОбработкиОСУ();
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьПолеСпискаОбработкиОСУ()
	
	Если Элементы.Найти("битОСУ_ЕстьВСуммовомУчете") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеОбработкиОСУ = Элементы.Добавить("битОСУ_ЕстьВСуммовомУчете", Тип("ПолеФормы"), Элементы.Список);
	ПолеОбработкиОСУ.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеОбработкиОСУ.ПутьКДанным = "Список.битОСУ_ЕстьВСуммовомУчете";
	ПолеОбработкиОСУ.Заголовок = НСтр("ru = 'Есть в ОСУ'");
	ПолеОбработкиОСУ.ТолькоПросмотр = Истина;
	
КонецПроцедуры

