&НаСервере
Процедура битОСУ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	ДобавляемыеРеквизиты = Новый Массив; 

	НовыйРеквизит = Новый РеквизитФормы("бит_ГУИД",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50))); 
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);

	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты); 
	
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("бит_ГУИД", Тип("ПолеФормы"),Элементы.ГруппаРеквизиты);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "бит_ГУИД";     
	НовыйЭлемент.Заголовок = "ГУИД (БИТ)"; 
		
	ЭтаФорма.бит_ГУИД = Объект.Ссылка.УникальныйИдентификатор();
	
КонецПроцедуры

