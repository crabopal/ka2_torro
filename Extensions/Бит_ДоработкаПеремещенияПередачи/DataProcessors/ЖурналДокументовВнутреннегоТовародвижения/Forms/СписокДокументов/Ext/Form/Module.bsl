
&НаСервере
Процедура битДПП_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка) 
	
	Если битДПП_ДополнитьЗапросЖурналаВнутреннегоТовародвижения() Тогда
		битДПП_УстановитьУсловноеОформлениеСпискаПеремещений(СписокДокументыВнутреннегоТовародвижения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция битДПП_ДополнитьЗапросЖурналаВнутреннегоТовародвижения()
	
	Если СтрНайти(СписокДокументыВнутреннегоТовародвижения.ТекстЗапроса, "битДПП_ВидПеремещения") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстЯкорьПолей = "РеестрДокументовПереопределяемый.ИдентификаторЗаписи КАК ИдентификаторЗаписи";
	ТекстЯкорьСоединения = "РегистрСведений.РеестрДокументов КАК РеестрДокументовПереопределяемый";
	
	Если Не СтрНайти(СписокДокументыВнутреннегоТовародвижения.ТекстЗапроса, ТекстЯкорьПолей) 
		Или Не СтрНайти(СписокДокументыВнутреннегоТовародвижения.ТекстЗапроса, ТекстЯкорьСоединения) Тогда
		Сообщить("Расширение Бит_ДоработкаПеремещенияПередачи неактивно, изменился код формы основной конфигурации");
		Возврат Ложь;
	КонецЕсли;
	
	ТекстПолей =
	",
	|	ПеремещениеТоваровБитДПП.битДПП_ВидПеремещения КАК битДПП_ВидПеремещения,
	|	ПеремещениеТоваровБитДПП.битДПП_ПередачаМеждуОрганизациями КАК битДПП_ПередачаМеждуОрганизациями";
	
	ТекстСоединения =
	"РегистрСведений.РеестрДокументов КАК РеестрДокументовПереопределяемый
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПеремещениеТоваров КАК ПеремещениеТоваровБитДПП
	|		ПО РеестрДокументовПереопределяемый.Ссылка = ПеремещениеТоваровБитДПП.Ссылка";
	
	СписокДокументыВнутреннегоТовародвижения.ТекстЗапроса = СтрЗаменить(
		СписокДокументыВнутреннегоТовародвижения.ТекстЗапроса,
		ТекстЯкорьПолей,
		ТекстЯкорьПолей + ТекстПолей);
	
	СписокДокументыВнутреннегоТовародвижения.ТекстЗапроса = СтрЗаменить(
		СписокДокументыВнутреннегоТовародвижения.ТекстЗапроса,
		ТекстЯкорьСоединения,
		ТекстСоединения);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура битДПП_УстановитьУсловноеОформлениеСпискаПеремещений(СписокФормы)
	
	ВидМеждуОрганизациями = Перечисления.битДПП_ВидПеремещения.МеждуОрганизациями;
	
	Элемент = СписокФормы.УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("битДПП_ВидПеремещения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = ВидМеждуОрганизациями;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("битДПП_ПередачаМеждуОрганизациями");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
КонецПроцедуры
