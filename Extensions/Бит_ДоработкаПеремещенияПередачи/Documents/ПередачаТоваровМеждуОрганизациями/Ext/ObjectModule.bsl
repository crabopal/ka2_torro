#Область ОбработчикиСобытий

&После("ОбработкаЗаполнения")
Процедура битДПП_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
		
		битДПП_ДокументОснование = битДПП_ДокументОснованиеПеремещения(ДанныеЗаполнения);
		
		Если Не ЗначениеЗаполнено(битДПП_ДокументОснование) Тогда
			Возврат;
		КонецЕсли;  
		
		ЗаполнитьПоПеремещениюТоваров(битДПП_ДокументОснование, ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура битДПП_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ПометкаУдаления Тогда  	
		Возврат;    	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(битДПП_ДокументОснование) Тогда
		
		ПеремещениеОбъект = битДПП_ДокументОснование.ПолучитьОбъект(); 
		
		//Если Не ОбщегоНазначения.КоллекцииИдентичны(
		//	ПеремещениеОбъект.Товары.Выгрузить(, "Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Количество"),
		//	ЭтотОбъект.Товары.Выгрузить(, "Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Количество")) Тогда	
		//	Отказ = Истина;
		//	ОбщегоНазначения.СообщитьПользователю( "Список передаваемых товаров не соответствует документу Перемещение товаров", ЭтотОбъект, 
		//	"Товары", "Объект", Отказ);			
		//	Возврат  	
		//КонецЕсли;
		
		СуществующаяПередача = битДПП_СуществующаяПередачаПоПеремещению(битДПП_ДокументОснование, ЭтотОбъект.Ссылка);
		
		Если Не СуществующаяПередача.Пустая() Тогда 	
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Для выбранного перемещения уже существует передача между организациями", ЭтотОбъект,
			"битДПП_ДокументОснование", "Объект", Отказ);			
			Возврат;      	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&После("ПриЗаписи") 
Процедура битДПП_ПриЗаписи(Отказ)   
	
	Если Отказ Тогда   	
		Возврат; 		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(битДПП_ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПометкаУдаления Тогда 	
		битДПП_ОчиститьСвязьСПеремещением();
		Возврат;  	
	КонецЕсли;  
	
	ПеремещениеОбъект = битДПП_ДокументОснование.ПолучитьОбъект();
	
	Если ПеремещениеОбъект.битДПП_ПередачаМеждуОрганизациями <> Ссылка Тогда
		ПеремещениеОбъект.битДПП_ПередачаМеждуОрганизациями = Ссылка;
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	битДПП_ПеренестиРезультатыПроверкиИзПеремещения(битДПП_ДокументОснование, Ссылка);	
	
КонецПроцедуры	 

#КонецОбласти

&Перед("ЗаполнитьПоПеремещениюТоваров")
Процедура битДПП_ЗаполнитьПоПеремещениюТоваров(Знач ДокументОснование, ДанныеЗаполнения)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		битДПП_ДокументОснование = ДокументОснование;
		битДПП_ПеренестиШтрихкодыИзПеремещения(битДПП_ДокументОснование);
	КонецЕсли;  
	
КонецПроцедуры

Процедура битДПП_ПеренестиШтрихкодыИзПеремещения(ДокументПеремещения)
	
	Если ТипЗнч(ДокументПеремещения) <> Тип("ДокументСсылка.ПеремещениеТоваров")
		Или Не ЗначениеЗаполнено(ДокументПеремещения) Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковок.ШтрихкодУпаковки КАК ШтрихкодУпаковки
	|ИЗ
	|	Документ.ПеремещениеТоваров.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
	|ГДЕ
	|	ШтрихкодыУпаковок.Ссылка = &ДокументПеремещения";
	Запрос.УстановитьПараметр("ДокументПеремещения", ДокументПеремещения);
	
	ЭтотОбъект.ШтрихкодыУпаковок.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура битДПП_ПеренестиРезультатыПроверкиИзПеремещения(ДокументПеремещения, ДокументПередачи)
	
	Если ТипЗнч(ДокументПеремещения) <> Тип("ДокументСсылка.ПеремещениеТоваров") 
		Или Не ЗначениеЗаполнено(ДокументПеремещения) 
		Или Не ЗначениеЗаполнено(ДокументПередачи) Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиИПодбораДокументовИС КАК СтатусыПроверки
	|ГДЕ
	|	СтатусыПроверки.Документ = &ДокументПередачи";
	
	Запрос.УстановитьПараметр("ДокументПередачи", ДокументПередачи);
	
	Если Не Запрос.Выполнить().Пустой() Тогда 
		Возврат; 
	КонецЕсли;
	
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	СтатусыПроверки.ВидМаркируемойПродукции КАК ВидМаркируемойПродукции,
	|	СтатусыПроверки.Сценарий КАК Сценарий,
	|	СтатусыПроверки.СтатусПроверкиИПодбора КАК СтатусПроверкиИПодбора,
	|	СтатусыПроверки.ДанныеПроверкиИПодбора КАК ДанныеПроверкиИПодбора,
	|	СтатусыПроверки.ТребуемоеДействиеЭДО КАК ТребуемоеДействиеЭДО
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиИПодбораДокументовИС КАК СтатусыПроверки
	|ГДЕ
	|	СтатусыПроверки.Документ = &ДокументПеремещения
	|	И СтатусыПроверки.СтатусПроверкиИПодбора <> ЗНАЧЕНИЕ(Перечисление.СтатусыПроверкиИПодбораИС.НеВыполнялось)";
	
	Запрос.УстановитьПараметр("ДокументПеремещения", ДокументПеремещения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда	 
		Возврат;	 
	КонецЕсли;
	
	ПривилегированныйРежимБылВключен = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		Выборка = РезультатЗапроса.Выбрать();
		
		НаборЗаписей = РегистрыСведений.СтатусыПроверкиИПодбораДокументовИС.СоздатьНаборЗаписей(); 
		НаборЗаписей.Отбор.Документ.Установить(ДокументПередачи); 
		
		Пока Выборка.Следующий() Цикл
			
			НоваяЗапись = НаборЗаписей.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка); 
			НоваяЗапись.Документ = ДокументПередачи;
			
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
	Исключение
		УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);
		ВызватьИсключение;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(ПривилегированныйРежимБылВключен);
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция битДПП_ДокументОснованиеПеремещения(ДанныеЗаполнения)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Возврат ДанныеЗаполнения;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ДокументОснование")
		И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Возврат ДанныеЗаполнения.ДокументОснование;
	КонецЕсли;
	
	Возврат Документы.ПеремещениеТоваров.ПустаяСсылка();
	
КонецФункции     

Функция битДПП_СуществующаяПередачаПоПеремещению(ДокументПеремещения, ТекущаяПередача)
	
	Если Не ЗначениеЗаполнено(ДокументПеремещения) Тогда
		Возврат Документы.ПередачаТоваровМеждуОрганизациями.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Передача.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПередачаТоваровМеждуОрганизациями КАК Передача
	|ГДЕ
	|	Передача.битДПП_ДокументОснование = &ДокументПеремещения
	|	И Передача.Ссылка <> &ТекущаяПередача
	|	И НЕ Передача.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументПеремещения", ДокументПеремещения);
	Запрос.УстановитьПараметр("ТекущаяПередача", ТекущаяПередача);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Документы.ПередачаТоваровМеждуОрганизациями.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Процедура битДПП_ОчиститьСвязьСПеремещением()
	
	ПеремещениеОбъект = битДПП_ДокументОснование.ПолучитьОбъект();
	
	Если ПеремещениеОбъект.битДПП_ПередачаМеждуОрганизациями <> Ссылка Тогда
		Возврат;
	КонецЕсли;
	
	ПеремещениеОбъект.битДПП_ПередачаМеждуОрганизациями = Документы.ПередачаТоваровМеждуОрганизациями.ПустаяСсылка();
	ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры 

#КонецОбласти
