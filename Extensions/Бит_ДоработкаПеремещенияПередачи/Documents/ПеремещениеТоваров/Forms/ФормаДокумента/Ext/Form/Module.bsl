
&НаСервере 
&После("ПриСозданииНаСервере")
Процедура битДПП_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	битДПП_СоздатьЭлементыФормыПередачи();
	битДПП_УстановитьВидимостьЭлементовПередачи();
	
КонецПроцедуры

&После("ПриЧтенииНаСервере")
Процедура битДПП_ПриЧтенииНаСервере(ТекущийОбъект)
	
	битДПП_УстановитьВидимостьЭлементовПередачи();
	
КонецПроцедуры

 &НаСервере
 Процедура битДПП_СоздатьЭлементыФормыПередачи()  
	 
	 Если Элементы.Найти("битДПП_ВидПеремещения") <> Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ЭлементКомментарий = Элементы.Найти("Комментарий");
	
	Если ЭлементКомментарий = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	РодительГруппы = ЭлементКомментарий.Родитель;
	
	ГруппаПередачи = Элементы.Добавить("битДПП_ГруппаПередачи", Тип("ГруппаФормы"), РодительГруппы);
	ГруппаПередачи.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПередачи.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаПередачи.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаПередачи.ОтображатьЗаголовок = Ложь;
	Элементы.Переместить(ГруппаПередачи, РодительГруппы, ЭлементКомментарий);

    ПолеВидПеремещения = Элементы.Добавить("битДПП_ВидПеремещения", Тип("ПолеФормы"), ГруппаПередачи);
	ПолеВидПеремещения.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВидПеремещения.ПутьКДанным = "Объект.битДПП_ВидПеремещения";
	ПолеВидПеремещения.Заголовок = НСтр("ru = 'Вид перемещения'");
	ПолеВидПеремещения.АвтоМаксимальнаяШирина = Ложь;
	ПолеВидПеремещения.РастягиватьПоГоризонтали = Ложь;
	ПолеВидПеремещения.Ширина = 25;
	ПолеВидПеремещения.УстановитьДействие("ПриИзменении", "битДПП_ВидПеремещенияПриИзменении");


	ПолеПередача = Элементы.Добавить("битДПП_ПередачаМеждуОрганизациями", Тип("ПолеФормы"), ГруппаПередачи);
	ПолеПередача.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеПередача.ПутьКДанным = "Объект.битДПП_ПередачаМеждуОрганизациями";
	ПолеПередача.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеПередача.Гиперссылка = Истина; 
	ПолеПередача.РастягиватьПоГоризонтали = Истина;
	ПолеПередача.УстановитьДействие("Нажатие", "битДПП_ПередачаМеждуОрганизациямиНажатие");
	
	
	КомандаСоздать = Команды.Добавить("битДПП_СоздатьПередачу");
	КомандаСоздать.Заголовок = НСтр("ru = 'Создать передачу'");
	КомандаСоздать.Действие = "битДПП_СоздатьПередачу";
		
	
	КнопкаСоздать = Элементы.Добавить("битДПП_СоздатьПередачу", Тип("КнопкаФормы"), ГруппаПередачи);
	КнопкаСоздать.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаСоздать.Заголовок = НСтр("ru = 'Создать передачу'"); 
	КнопкаСоздать.РастягиватьПоГоризонтали = Ложь;
	КнопкаСоздать.ИмяКоманды = "битДПП_СоздатьПередачу";
			
	
КонецПроцедуры

&НаСервере
Процедура битДПП_УстановитьВидимостьЭлементовПередачи() 
	
	Если Элементы.Найти("битДПП_ВидПеремещения") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидПеремещения = Объект.битДПП_ВидПеремещения;
	ЕстьПередача = ЗначениеЗаполнено(Объект.битДПП_ПередачаМеждуОрганизациями);
	ЭтоПередачаМеждуОрганизациями = ВидПеремещения = Перечисления.битДПП_ВидПеремещения.МеждуОрганизациями;
	
	Элементы.битДПП_ВидПеремещения.ТолькоПросмотр = Ложь;
	Элементы.битДПП_СоздатьПередачу.Видимость = Ложь;
	Элементы.битДПП_ПередачаМеждуОрганизациями.Видимость = Ложь;
	
	Если ЭтоПередачаМеждуОрганизациями Тогда
		
		Если ЕстьПередача Тогда
			Элементы.битДПП_ПередачаМеждуОрганизациями.Видимость = Истина;
		Иначе
			Элементы.битДПП_СоздатьПередачу.Видимость = Истина;
		КонецЕсли;   
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура битДПП_ВидПеремещенияПриИзменении(Элемент)
	
	битДПП_УстановитьВидимостьЭлементовПередачи();
	
КонецПроцедуры

&НаКлиенте
Процедура битДПП_СоздатьПередачу(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Перед созданием передачи необходимо записать документ перемещения.'"));
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура("ДокументОснование", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("Основание", ДанныеЗаполнения);
	Оповещение = Новый ОписаниеОповещения("битДПП_ОбновитьДанныеПередачиПослеЗакрытия", ЭтотОбъект);
	ОткрытьФорму("Документ.ПередачаТоваровМеждуОрганизациями.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект, , , , Оповещение);
	
КонецПроцедуры    

&НаКлиенте
Процедура битДПП_ОбновитьДанныеПередачиПослеЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	
	битДПП_ОбновитьДанныеПередачиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура битДПП_ОбновитьДанныеПередачиНаСервере()	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.битДПП_ПередачаМеждуОрганизациями = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Объект.Ссылка, "битДПП_ПередачаМеждуОрганизациями");
	битДПП_УстановитьВидимостьЭлементовПередачи();
	
КонецПроцедуры

&НаКлиенте
Процедура битДПП_ПередачаМеждуОрганизациямиНажатие(Элемент, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.битДПП_ПередачаМеждуОрганизациями) Тогда
		ПоказатьЗначение(, Объект.битДПП_ПередачаМеждуОрганизациями);
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры
