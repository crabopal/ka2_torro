           
&После("ПриСозданииНаСервере")
Процедура битДПП_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если битДПП_ДополнитьЗапросСпискаПеремещений() Тогда
		битДПП_УстановитьУсловноеОформлениеСпискаПеремещений(Список);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция битДПП_ДополнитьЗапросСпискаПеремещений()
	
	Если СтрНайти(Список.ТекстЗапроса, "битДПП_ВидПеремещения") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстЯкорь = "ДокументПеремещениеТоваров.Автор";
	
	Если Не СтрНайти(Список.ТекстЗапроса, ТекстЯкорь) Тогда
		Сообщить("Расширение Бит_ДоработкаПеремещенияПередачи неактивно, изменился код формы основной конфигурации");
		Возврат Ложь;
	КонецЕсли;	
	
	ТекстПолей = ",
	|	ДокументПеремещениеТоваров.битДПП_ВидПеремещения,
	|	ДокументПеремещениеТоваров.битДПП_ПередачаМеждуОрганизациями";
	
	Список.ТекстЗапроса = СтрЗаменить(
		Список.ТекстЗапроса,
		ТекстЯкорь,
		ТекстЯкорь + ТекстПолей);

	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура битДПП_УстановитьУсловноеОформлениеСпискаПеремещений(СписокФормы)
	
	ВидМеждуОрганизациями = Перечисления.битДПП_ВидПеремещения.МеждуОрганизациями;
	
	Элемент = СписокФормы.УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("битДПП_ВидПеремещения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = ВидМеждуОрганизациями;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("битДПП_ПередачаМеждуОрганизациями");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
КонецПроцедуры
