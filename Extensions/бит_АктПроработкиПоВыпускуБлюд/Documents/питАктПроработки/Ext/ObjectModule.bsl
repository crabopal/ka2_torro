
&После("ОбработкаЗаполнения")
Процедура битАППВБ_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питВыпускБлюд") Тогда   
		
		ПроверитьВозможностьСозданияАктаПоВыпуску(ДанныеЗаполнения);
		Документы.питАктПроработки.ЗаполнитьДокументНаОснованииВыпускаБлюд(ЭтотОбъект, ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры      

Процедура ПроверитьВозможностьСозданияАктаПоВыпуску(ДокументОснование)
	
	РеквизитыВыпуска = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
	ДокументОснование,
	"ХозяйственнаяОперация, ПометкаУдаления");
	
	Если РеквизитыВыпуска.ПометкаУдаления Тогда
		ВызватьИсключение НСтр("ru = 'Нельзя создать акт проработки по помеченному на удаление документу выпуска блюд.'");
	КонецЕсли;
	
	Если РеквизитыВыпуска.ХозяйственнаяОперация <> Перечисления.питХозяйственныеОперации.ВыпускПродукцииСоСписанием Тогда
		ВызватьИсключение НСтр("ru = 'Акт проработки можно создать только на основании выпуска блюд с операцией ""Выпуск продукции со списанием"".'");
	КонецЕсли;
	
	ЗапросБлюда = Новый Запрос;
	ЗапросБлюда.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика
	|ИЗ
	|	Документ.питВыпускБлюд.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика";
	ЗапросБлюда.УстановитьПараметр("Ссылка", ДокументОснование);
	
	ТаблицаБлюд = ЗапросБлюда.Выполнить().Выгрузить();
	
	Если ТаблицаБлюд.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В документе выпуска блюд не заполнена табличная часть ""Товары"".'");
	КонецЕсли;
	
	Если ТаблицаБлюд.Количество() > 1 Тогда
		ВызватьИсключение НСтр("ru = 'По одному выпуску блюд для проработки может быть списано только одно блюдо.'");
	КонецЕсли;
	
	ЗапросАкт = Новый Запрос;
	ЗапросАкт.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питАктПроработки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питАктПроработки КАК питАктПроработки
	|ГДЕ
	|	питАктПроработки.ДокументОснование = &ДокументОснование
	|	И НЕ питАктПроработки.ПометкаУдаления";
	ЗапросАкт.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Если НЕ ЗапросАкт.Выполнить().Пустой() Тогда
		ВызватьИсключение НСтр("ru = 'По данному выпуску блюд акт проработки уже создан.'");
	КонецЕсли;
	
КонецПроцедуры

