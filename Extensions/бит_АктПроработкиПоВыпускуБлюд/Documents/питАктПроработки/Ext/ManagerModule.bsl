
Процедура ЗаполнитьДокументНаОснованииВыпускаБлюд(ДокументОбъект, ДокументОснование) Экспорт
	
	ДанныеВыпуска = ПолучитьДанныеВыпускаДляАкта(ДокументОснование);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеВыпуска);
	ДокументОбъект.ДокументОснование  = ДокументОснование;
	ДокументОбъект.Комментарий = "Создан на основании документа: <"+ДанныеВыпуска.Представление+">";
	
	ТаблицаИнгредиентов = ПолучитьТаблицуИнгредиентовСУчетомЗамен(ДокументОснование);
	
	КэшированныеЗначенияУпаковок = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого СтрокаИнгредиента Из ТаблицаИнгредиентов Цикл
		
		НоваяСтрока = ДокументОбъект.Ингредиенты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИнгредиента);
		
		Документы.питАктПроработки.РассчитатьПроработку(НоваяСтрока, Неопределено, КэшированныеЗначенияУпаковок);
		
	КонецЦикла;
	
КонецПроцедуры


#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДанныеВыпускаДляАкта(ДокументОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыВыпуска.Ссылка.Организация КАК Организация,
	|	ТоварыВыпуска.Ссылка.Подразделение КАК Подразделение,
	|	ТоварыВыпуска.Номенклатура КАК Номенклатура,
	|	ТоварыВыпуска.Характеристика КАК Характеристика,
	|	ТоварыВыпуска.Упаковка КАК Упаковка,
	|	ТоварыВыпуска.Количество КАК Количество,
	|	ТоварыВыпуска.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ТоварыВыпуска.Ссылка.Представление КАК Представление
	|ИЗ
	|	Документ.питВыпускБлюд.Товары КАК ТоварыВыпуска
	|ГДЕ
	|	ТоварыВыпуска.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыВыпуска.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось получить данные первой строки табличной части ""Товары"" документа выпуска блюд.'");
	КонецЕсли;
	
	Возврат Выборка;
	
КонецФункции

Функция ПолучитьТаблицуИнгредиентовСУчетомЗамен(ДокументОснование)
	
	Запрос = Новый Запрос;
Запрос.Текст =
	"ВЫБРАТЬ 
	|	Замены.ИнгредиентИсходный КАК ИнгредиентИсходный,
	|	Замены.ХарактеристикаИнгредиентаИсходного КАК ХарактеристикаИсходного,
	|	Замены.УпаковкаИнгредиентаИсходный КАК УпаковкаИсходного
	|ПОМЕСТИТЬ ВтИсходникиСЗаменой
	|ИЗ
	|	Документ.питВыпускБлюд.Замены КАК Замены
	|ГДЕ
	|	Замены.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ингредиенты.Ингредиент КАК Номенклатура,
	|	Ингредиенты.Характеристика КАК Характеристика,
	|	Ингредиенты.УпаковкаИнгредиента КАК Упаковка,
	|	ВЫБОР
	|		КОГДА НЕ ИсходникиСЗаменой.ИнгредиентИсходный ЕСТЬ NULL
	|			ТОГДА Ингредиенты.КоличествоУпаковокИнгредиентаФакт
	|		КОГДА Ингредиенты.КоличествоУпаковокИнгредиентаФакт <> 0
	|			ТОГДА Ингредиенты.КоличествоУпаковокИнгредиентаФакт
	|		ИНАЧЕ Ингредиенты.КоличествоУпаковокИнгредиентаНорма
	|	КОНЕЦ КАК КоличествоУпаковокБрутто,
	|	ВЫБОР
	|		КОГДА НЕ ИсходникиСЗаменой.ИнгредиентИсходный ЕСТЬ NULL
	|			ТОГДА Ингредиенты.КоличествоИнгредиентаФакт
	|		КОГДА Ингредиенты.КоличествоИнгредиентаФакт <> 0
	|			ТОГДА Ингредиенты.КоличествоИнгредиентаФакт
	|		ИНАЧЕ Ингредиенты.КоличествоИнгредиентаНорма
	|	КОНЕЦ КАК КоличествоБрутто
	|ПОМЕСТИТЬ ВтСостав
	|ИЗ
	|	Документ.питВыпускБлюд.Ингредиенты КАК Ингредиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтИсходникиСЗаменой КАК ИсходникиСЗаменой
	|		ПО Ингредиенты.Ингредиент = ИсходникиСЗаменой.ИнгредиентИсходный
	|			И Ингредиенты.Характеристика = ИсходникиСЗаменой.ХарактеристикаИсходного
	|			И Ингредиенты.УпаковкаИнгредиента = ИсходникиСЗаменой.УпаковкаИсходного
	|ГДЕ
	|	Ингредиенты.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Замены.ИнгредиентЗамена,
	|	Замены.ХарактеристикаИнгредиентаЗамена,
	|	Замены.УпаковкаИнгредиентаЗамена,
	|	Замены.КоличествоУпаковокИнгредиентаЗамена,
	|	Замены.КоличествоИнгредиентаЗамена
	|ИЗ
	|	Документ.питВыпускБлюд.Замены КАК Замены
	|ГДЕ
	|	Замены.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСостав.Номенклатура КАК Номенклатура,
	|	ВТСостав.Характеристика КАК Характеристика,
	|	ВТСостав.Упаковка КАК Упаковка,
	|	СУММА(ВТСостав.КоличествоУпаковокБрутто) КАК КоличествоУпаковокБрутто,
	|	СУММА(ВТСостав.КоличествоБрутто) КАК КоличествоБрутто
	|ИЗ
	|	ВтСостав КАК ВТСостав
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСостав.Номенклатура,
	|	ВТСостав.Характеристика,
	|	ВТСостав.Упаковка
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВТСостав.КоличествоУпаковокБрутто) > 0
	|		ИЛИ СУММА(ВТСостав.КоличествоБрутто) > 0)";
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	ТаблицаИнгредиентов = Запрос.Выполнить().Выгрузить();
		
	Возврат ТаблицаИнгредиентов;
	
КонецФункции
#КонецОбласти