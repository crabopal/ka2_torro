// Выгрузка иерархии групп номенклатуры в прайс Offline / Frontol 6.
// Типовая запись файла АТОЛ уже умеет группы (поля 16/17) — здесь только наполняем прайс.

#Область СлужебныеПроцедурыИФункции

&После("ЗаполнитьПрайсЛистККМ")
Процедура Расш1_ЗаполнитьПрайсЛистККМПосле(ОфлайнОборудование, ПрайсЛист, ПолнаяВыгрузка)
	
	Расш1_ДополнитьПрайсЛистГруппамиНоменклатуры(ОфлайнОборудование, ПрайсЛист);
	
КонецПроцедуры

&После("ЗаполнитьПрайсЛистККМПоШтрихкоду")
Процедура Расш1_ЗаполнитьПрайсЛистККМПоШтрихкодуПосле(ОфлайнОборудование, ПрайсЛист, Штрихкод)
	
	Расш1_ДополнитьПрайсЛистГруппамиНоменклатуры(ОфлайнОборудование, ПрайсЛист);
	
КонецПроцедуры

Процедура Расш1_ДополнитьПрайсЛистГруппамиНоменклатуры(ОфлайнОборудование, ПрайсЛист)
	
	Если ПрайсЛист = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПрайсЛист.Свойство("Товары") Или ПрайсЛист.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Параметры = Неопределено;
	ПолучитьПараметрыУстройства(Параметры, ОфлайнОборудование);
	
	Если Параметры = Неопределено Или НЕ ЗначениеЗаполнено(Параметры.ПравилоОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	МассивНоменклатуры = Расш1_НоменклатураИзПрайсЛиста(ПрайсЛист);
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаГрупп = Расш1_ТаблицаГруппДляВыгрузки(МассивНоменклатуры);
	Если ТаблицаГрупп.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КодыГрупп = Расш1_ОбеспечитьКодыГрупп(Параметры.ПравилоОбмена, ТаблицаГрупп);
	
	ПрайсЛист.ГруппыТоваров.Очистить();
	
	Для Каждого СтрокаГруппы Из ТаблицаГрупп Цикл
		
		КодГруппы = КодыГрупп.Получить(СтрокаГруппы.Ссылка);
		Если КодГруппы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьГруппы = МенеджерОфлайнОборудования.ЗаписьГруппыТоваровПрайсЛиста();
		ЗаписьГруппы.Код = Формат(КодГруппы, "ЧН=0; ЧГ=0");
		ЗаписьГруппы.Наименование = СтрокаГруппы.Наименование;
		ЗаписьГруппы.УникальныйИдентификатор = СтрокаГруппы.Ссылка.УникальныйИдентификатор();
		ЗаписьГруппы.СсылкаГруппы = СтрокаГруппы.Ссылка;
		
		Если ЗначениеЗаполнено(СтрокаГруппы.Родитель) Тогда
			КодРодителя = КодыГрупп.Получить(СтрокаГруппы.Родитель);
			Если КодРодителя <> Неопределено Тогда
				ЗаписьГруппы.КодГруппы = Формат(КодРодителя, "ЧН=0; ЧГ=0");
				ЗаписьГруппы.УникальныйИдентификаторГруппы = СтрокаГруппы.Родитель.УникальныйИдентификатор();
			КонецЕсли;
		КонецЕсли;
		
		ПрайсЛист.ГруппыТоваров.Добавить(ЗаписьГруппы);
		
	КонецЦикла;
	
	Расш1_ПроставитьКодыРодителейТоварам(ПрайсЛист, КодыГрупп);
	
КонецПроцедуры

Функция Расш1_НоменклатураИзПрайсЛиста(ПрайсЛист)
	
	Результат = Новый Массив;
	
	Для Каждого ЗаписьТовара Из ПрайсЛист.Товары Цикл
		
		Если ЗаписьТовара.Свойство("СсылкаНоменклатура") И ЗначениеЗаполнено(ЗаписьТовара.СсылкаНоменклатура) Тогда
			Если Результат.Найти(ЗаписьТовара.СсылкаНоменклатура) = Неопределено Тогда
				Результат.Добавить(ЗаписьТовара.СсылкаНоменклатура);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	МассивКодов = Новый Массив;
	Для Каждого ЗаписьТовара Из ПрайсЛист.Товары Цикл
		Если ЗначениеЗаполнено(ЗаписьТовара.Код) Тогда
			Попытка
				МассивКодов.Добавить(Число(ЗаписьТовара.Код));
			Исключение
				// пропускаем нечисловой код
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивКодов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Коды.Номенклатура КАК Ссылка
	|ИЗ
	|	РегистрСведений.КодыТоваровПодключаемогоОборудованияOffline КАК Коды
	|ГДЕ
	|	Коды.Код В (&Коды)
	|	И Коды.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И НЕ Коды.Номенклатура.ЭтоГруппа";
	Запрос.УстановитьПараметр("Коды", МассивКодов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Найти(Выборка.Ссылка) = Неопределено Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Расш1_ТаблицаГруппДляВыгрузки(МассивНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Родители.Ссылка КАК Ссылка,
	|	Родители.Наименование КАК Наименование,
	|	Родители.Родитель КАК Родитель
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Родители
	|		ПО Товары.Ссылка В ИЕРАРХИИ (Родители.Ссылка)
	|ГДЕ
	|	Товары.Ссылка В (&Номенклатура)
	|	И Родители.ЭтоГруппа
	|	И НЕ Родители.ПометкаУдаления
	|	И Товары.Ссылка <> Родители.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Родители.Ссылка ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция Расш1_ОбеспечитьКодыГрупп(ПравилоОбмена, ТаблицаГрупп)
	
	КодыГрупп = Новый Соответствие;
	
	МассивГрупп = ТаблицаГрупп.ВыгрузитьКолонку("Ссылка");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Коды.Номенклатура КАК Номенклатура,
	|	Коды.Код КАК Код
	|ИЗ
	|	РегистрСведений.КодыТоваровПодключаемогоОборудованияOffline КАК Коды
	|ГДЕ
	|	Коды.ПравилоОбмена = &ПравилоОбмена
	|	И Коды.Номенклатура В (&Группы)";
	Запрос.УстановитьПараметр("ПравилоОбмена", ПравилоОбмена);
	Запрос.УстановитьПараметр("Группы", МассивГрупп);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодыГрупп.Вставить(Выборка.Номенклатура, Выборка.Код);
	КонецЦикла;
	
	МаксимальныйКод = Расш1_МаксимальныйКодПравила(ПравилоОбмена);
	
	Для Каждого СтрокаГруппы Из ТаблицаГрупп Цикл
		
		Если КодыГрупп.Получить(СтрокаГруппы.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МаксимальныйКод = МаксимальныйКод + 1;
		
		МенеджерЗаписи = РегистрыСведений.КодыТоваровПодключаемогоОборудованияOffline.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПравилоОбмена = ПравилоОбмена;
		МенеджерЗаписи.Код = МаксимальныйКод;
		МенеджерЗаписи.Номенклатура = СтрокаГруппы.Ссылка;
		МенеджерЗаписи.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		МенеджерЗаписи.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		МенеджерЗаписи.Используется = Ложь;
		МенеджерЗаписи.Записать();
		
		КодыГрупп.Вставить(СтрокаГруппы.Ссылка, МаксимальныйКод);
		
	КонецЦикла;
	
	Возврат КодыГрупп;
	
КонецФункции

Функция Расш1_МаксимальныйКодПравила(ПравилоОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Коды.Код), 0) КАК Код
	|ИЗ
	|	РегистрСведений.КодыТоваровПодключаемогоОборудованияOffline КАК Коды
	|ГДЕ
	|	Коды.ПравилоОбмена = &ПравилоОбмена";
	Запрос.УстановитьПараметр("ПравилоОбмена", ПравилоОбмена);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Код;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура Расш1_ПроставитьКодыРодителейТоварам(ПрайсЛист, КодыГрупп)
	
	МассивКодов = Новый Массив;
	Для Каждого ЗаписьТовара Из ПрайсЛист.Товары Цикл
		Если ЗначениеЗаполнено(ЗаписьТовара.Код) Тогда
			Попытка
				МассивКодов.Добавить(Число(ЗаписьТовара.Код));
			Исключение
				// пропускаем
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивКодов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Коды.Код КАК Код,
	|	Коды.Номенклатура.Родитель КАК Родитель
	|ИЗ
	|	РегистрСведений.КодыТоваровПодключаемогоОборудованияOffline КАК Коды
	|ГДЕ
	|	Коды.Код В (&Коды)
	|	И Коды.Номенклатура.Родитель <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Коды", МассивКодов);
	
	СоответствиеКодТовараРодитель = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеКодТовараРодитель.Вставить(Выборка.Код, Выборка.Родитель);
	КонецЦикла;
	
	Для Каждого ЗаписьТовара Из ПрайсЛист.Товары Цикл
		
		Попытка
			КодЧисло = Число(ЗаписьТовара.Код);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Родитель = СоответствиеКодТовараРодитель.Получить(КодЧисло);
		Если НЕ ЗначениеЗаполнено(Родитель) Тогда
			Продолжить;
		КонецЕсли;
		
		КодРодителя = КодыГрупп.Получить(Родитель);
		Если КодРодителя = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьТовара.КодГруппы = Формат(КодРодителя, "ЧН=0; ЧГ=0");
		ЗаписьТовара.УникальныйИдентификаторГруппы = Родитель.УникальныйИдентификатор();
		ЗаписьТовара.СсылкаГруппаТоваров = Родитель;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

