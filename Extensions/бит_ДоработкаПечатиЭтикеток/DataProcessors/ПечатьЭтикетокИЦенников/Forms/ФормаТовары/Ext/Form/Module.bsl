
// Автозаполнение шаблона «Тест» и количества 1 — только при печати из РТУ.

&НаСервере
&После("ЗаполнитьТаблицуТоваровНаСервере")
Процедура битДПЭ_ЗаполнитьТаблицуТоваровНаСервереПосле(СохранятьШаблоныИКоличество, ОбновлениеДанныхПоВыбраннымТоварам = Ложь)
	
	битДПЭ_ЗаполнитьЭтикеткиДляРеализации();
	
КонецПроцедуры

&НаСервере
Процедура битДПЭ_ЗаполнитьЭтикеткиДляРеализации()
	
	Если Не ПечатьИзДокумента
		Или Не битДПЭ_ЭтоПечатьИзРеализации() Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонЭтикетки = битДПЭ_ПолучитьШаблонЭтикетки();
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		
		Если ЗначениеЗаполнено(ШаблонЭтикетки) Тогда
			СтрокаТЧ.ШаблонЭтикетки = ШаблонЭтикетки;
		КонецЕсли;
		
		СтрокаТЧ.КоличествоЭтикеток = 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция битДПЭ_ЭтоПечатьИзРеализации()
	
	СтруктураДанных = битДПЭ_СтруктураДанныхИзПараметровФормы(Параметры);
	Если СтруктураДанных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ДокументыПечати") Тогда
		
		Если СтруктураДанных.ДокументыПечати.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Для Каждого ДокументСсылка Из СтруктураДанных.ДокументыПечати Цикл
			Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция битДПЭ_ПолучитьШаблонЭтикетки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ШаблоныЭтикетокИЦенников.Ссылка КАК ШаблонЭтикетки
		|ИЗ
		|	Справочник.ШаблоныЭтикетокИЦенников КАК ШаблоныЭтикетокИЦенников
		|ГДЕ
		|	ШаблоныЭтикетокИЦенников.Наименование = &Наименование
		|	И ШаблоныЭтикетокИЦенников.Назначение = &Назначение
		|	И НЕ ШаблоныЭтикетокИЦенников.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", "ТЕСТ Я");
	Запрос.УстановитьПараметр("Назначение", Перечисления.НазначенияШаблоновЭтикетокИЦенников.ЭтикеткаДляТоваров);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ШаблонЭтикетки;
	КонецЕсли;
	
	Возврат Справочники.ШаблоныЭтикетокИЦенников.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция битДПЭ_СтруктураДанныхИзПараметровФормы(ПараметрыФормы)
	
	Если ПараметрыФормы.Свойство("АдресВХранилище")
		И ЭтоАдресВременногоХранилища(ПараметрыФормы.АдресВХранилище) Тогда
		Возврат ПолучитьИзВременногоХранилища(ПараметрыФормы.АдресВХранилище);
	КонецЕсли;
	
	Если ПараметрыФормы.Свойство("ПараметрыЗаполнения") Тогда
		Возврат ПараметрыФормы.ПараметрыЗаполнения;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
