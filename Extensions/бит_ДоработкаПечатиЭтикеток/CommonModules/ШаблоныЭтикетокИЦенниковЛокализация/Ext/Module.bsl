&После("ПриЗаполненииДоступныхПолейКомпоновкиДанных")
Процедура битДПЭ_ПриЗаполненииДоступныхПолейКомпоновкиДанных(ИменаПолей, Назначение)
	
	Если НЕ битДПЭ_ЭтоНазначениеШаблонаТоваров(Назначение) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = ПечатьЭтикетокИЦенниковЛокализация.битДПЭ_ИмяПоляКодВесовогоТовара();
	Если ИменаПолей.Найти(ИмяПоля) = Неопределено Тогда
		ИменаПолей.Добавить(ИмяПоля);
	КонецЕсли;
	
КонецПроцедуры

&После("ПриИзмененииНазначенияШаблонаВСправочникеШаблонов")
Процедура битДПЭ_ПриИзмененииНазначенияШаблонаВСправочникеШаблонов(Форма, ОчищатьНазначение, МассивТипов)
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект")
		Или НЕ битДПЭ_ЭтоНазначениеШаблонаТоваров(Форма.Объект.Назначение) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ДоступныеПоляКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = ПечатьЭтикетокИЦенниковЛокализация.битДПЭ_ИмяПоляКодВесовогоТовара();
	ПредставлениеПоля = ПечатьЭтикетокИЦенниковЛокализация.битДПЭ_ПредставлениеПоляКодВесовогоТовара();
	
	Если битДПЭ_ЕстьПолеВДереве(Форма.ДоступныеПоляКомпоновкиДанных, ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = РаботаСФормулами.НоваяСтрокаДереваОперанда(Форма.ДоступныеПоляКомпоновкиДанных);
	НоваяСтрока.Идентификатор = ИмяПоля;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "ПолныйИдентификаторСтроки") Тогда
		НоваяСтрока.ПолныйИдентификаторСтроки = ИмяПоля;
	КонецЕсли;
	НоваяСтрока.Представление = ПредставлениеПоля;
	НоваяСтрока.ТипЭлементаДерева = РаботаСФормулами.ТипыЭлементовДереваОперандов().Реквизит;
	НоваяСтрока.РазрешаетсяВыборОперанда = Истина;
	НоваяСтрока.ВключаетсяВИдентификатор = Истина;
	НоваяСтрока.РазворачиватьДоРеквизитов = Ложь;
	НоваяСтрока.ТипЗначения = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(25));
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "ПолноеПредставлениеСтроки") Тогда
		НоваяСтрока.ПолноеПредставлениеСтроки = ПредставлениеПоля;
	КонецЕсли;
	
	ЭталонСтрока = битДПЭ_НайтиПолеВДереве(Форма.ДоступныеПоляКомпоновкиДанных, "Штрихкод");
	Если ЭталонСтрока = Неопределено Тогда
		ЭталонСтрока = битДПЭ_НайтиПолеВДереве(Форма.ДоступныеПоляКомпоновкиДанных, "Цена");
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрока, "КодКартинки") Тогда
		Если ЭталонСтрока <> Неопределено
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭталонСтрока, "КодКартинки") Тогда
			НоваяСтрока.КодКартинки = ЭталонСтрока.КодКартинки;
		Иначе
			НоваяСтрока.КодКартинки = 10;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция битДПЭ_ЭтоНазначениеШаблонаТоваров(Назначение)
	
	Возврат Назначение = Перечисления.НазначенияШаблоновЭтикетокИЦенников.ЭтикеткаДляТоваров
		Или Назначение = Перечисления.НазначенияШаблоновЭтикетокИЦенников.ЦенникДляТоваров;
	
КонецФункции

Функция битДПЭ_ЕстьПолеВДереве(УзелДерева, ИдентификаторПоля)
	
	КоллекцияСтрок = битДПЭ_КоллекцияСтрокДерева(УзелДерева);
	Если КоллекцияСтрок = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из КоллекцияСтрок Цикл
		Если СтрокаДерева.Идентификатор = ИдентификаторПоля Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если битДПЭ_ЕстьПолеВДереве(СтрокаДерева, ИдентификаторПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция битДПЭ_НайтиПолеВДереве(УзелДерева, ИдентификаторПоля)
	
	КоллекцияСтрок = битДПЭ_КоллекцияСтрокДерева(УзелДерева);
	Если КоллекцияСтрок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из КоллекцияСтрок Цикл
		Если СтрокаДерева.Идентификатор = ИдентификаторПоля Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
		
		НайденнаяСтрока = битДПЭ_НайтиПолеВДереве(СтрокаДерева, ИдентификаторПоля);
		Если НайденнаяСтрока <> Неопределено Тогда
			Возврат НайденнаяСтрока;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция битДПЭ_КоллекцияСтрокДерева(УзелДерева)
	
	Если ТипЗнч(УзелДерева) = Тип("ДеревоЗначений")
		Или ТипЗнч(УзелДерева) = Тип("СтрокаДереваЗначений") Тогда
		Возврат УзелДерева.Строки;
	ИначеЕсли ТипЗнч(УзелДерева) = Тип("ДанныеФормыДерево")
		Или ТипЗнч(УзелДерева) = Тип("ДанныеФормыЭлементДерева") Тогда
		Возврат УзелДерева.ПолучитьЭлементы();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции
