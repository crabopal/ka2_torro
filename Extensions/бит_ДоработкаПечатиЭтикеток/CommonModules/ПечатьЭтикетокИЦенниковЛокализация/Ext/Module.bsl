#Область ПрограммныйИнтерфейс

Функция битДПЭ_ИмяПоляКодВесовогоТовара() Экспорт
	Возврат "КодВесовогоТовара";
КонецФункции

Функция битДПЭ_ПредставлениеПоляКодВесовогоТовара() Экспорт
	Возврат "Код весового товара (БИТ)";
КонецФункции

// Вычисляет код весового товара по штрихкоду номенклатуры.
//
// Параметры:
//  Штрихкод - Строка - штрихкод номенклатуры, например "2_0048100000_".
//
// Возвращаемое значение:
//  Строка - код весового товара, например "481".
//
Функция битДПЭ_КодВесовогоТовараПоШтрихкоду(Штрихкод) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат "";
	КонецЕсли;
	
	ПервыеСемьСимволов = Лев(Строка(Штрихкод), 7);
	Если СтрДлина(ПервыеСемьСимволов) < 3 Тогда
		Возврат "";
	КонецЕсли;
	
	Фрагмент = Сред(ПервыеСемьСимволов, 3);
	
	ТолькоЦифры = "";
	Для Индекс = 1 По СтрДлина(Фрагмент) Цикл
		Символ = Сред(Фрагмент, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		Иначе
			ТолькоЦифры = ТолькоЦифры + "0";
		КонецЕсли;
	КонецЦикла;
	
	Пока СтрДлина(ТолькоЦифры) > 1 И Лев(ТолькоЦифры, 1) = "0" Цикл
		ТолькоЦифры = Сред(ТолькоЦифры, 2);
	КонецЦикла;
	
	Возврат ТолькоЦифры;
	
КонецФункции

// Дополняет текст запроса и схему компоновки данных полем "КодВесовогоТовара"
// только для макета печати "ПоляШаблонаПечатьТовары".
//
Функция битДПЭ_ДополнитьТекстЗапросаПечатиТоваров(Режим, СхемаКомпоновкиДанных, ТекстЗапроса) Экспорт
	
	Если Режим <> "Товары" Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	МаркерМакетаПечати = """Штрихкод""                                 КАК Штрихкод,";
	Если СтрНайти(ТекстЗапроса, МаркерМакетаПечати) = 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	ИмяПоля = битДПЭ_ИмяПоляКодВесовогоТовара();
	ЗаглушкаПоля = """" + ИмяПоля + """";
	
	Если СтрНайти(ТекстЗапроса, ЗаглушкаПоля) = 0 Тогда
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			МаркерМакетаПечати,
			МаркерМакетаПечати + Символы.ПС
			+ "	""" + ИмяПоля + """                          КАК " + ИмяПоля + ",");
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"ИсходныеДанныеПоследнийЗапрос.Штрихкод КАК Штрихкод,",
			"ИсходныеДанныеПоследнийЗапрос.Штрихкод КАК Штрихкод," + Символы.ПС
			+ "	ИсходныеДанныеПоследнийЗапрос." + ИмяПоля + " КАК " + ИмяПоля + ",");
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"	Штрихкод," + Символы.ПС,
			"	Штрихкод," + Символы.ПС + "	" + ИмяПоля + "," + Символы.ПС);
		
	КонецЕсли;
	
	Если СтрНайти(ТекстЗапроса, ЗаглушкаПоля) > 0
		И СхемаКомпоновкиДанных <> Неопределено
		И СхемаКомпоновкиДанных.НаборыДанных.НаборДанных.Поля.Найти(ИмяПоля) = Неопределено Тогда
		
		ФинансоваяОтчетностьСервер.НовоеПолеНабора(
			СхемаКомпоновкиДанных.НаборыДанных.НаборДанных,
			ИмяПоля,
			ИмяПоля,
			битДПЭ_ПредставлениеПоляКодВесовогоТовара(),
			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(25)));
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура битДПЭ_ЗаполнитьКолонкуКодВесовогоТовараВИсходныхДанных(ИсходныеДанные)
	
	Если ИсходныеДанные = Неопределено
		Или ТипЗнч(ИсходныеДанные) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = битДПЭ_ИмяПоляКодВесовогоТовара();
	
	Если ИсходныеДанные.Колонки.Найти(ИмяПоля) = Неопределено Тогда
		ИсходныеДанные.Колонки.Добавить(ИмяПоля, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(25)));
	КонецЕсли;
	
	ЕстьКолонкаШтрихкод = ИсходныеДанные.Колонки.Найти("Штрихкод") <> Неопределено;
	Для Каждого СтрокаДанных Из ИсходныеДанные Цикл
		Если ЕстьКолонкаШтрихкод Тогда
			СтрокаДанных[ИмяПоля] = битДПЭ_КодВесовогоТовараПоШтрихкоду(СтрокаДанных.Штрихкод);
		Иначе
			СтрокаДанных[ИмяПоля] = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура битДПЭ_ОбеспечитьКолонкуСерияВИсходныхДанных(ИсходныеДанные)
	
	Если ИсходныеДанные = Неопределено
		Или ТипЗнч(ИсходныеДанные) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ИсходныеДанные.Колонки.Найти("Серия") = Неопределено Тогда
		ИсходныеДанные.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&После("ПриПодготовкеСтруктурыДанныхДляПечати")
Процедура битДПЭ_ПриПодготовкеСтруктурыДанныхДляПечати(СтруктураНастроек, Режим, Запрос, ИсходныеДанные)
	
	Если Режим <> "Товары" Тогда
		Возврат;
	КонецЕсли;
	
	битДПЭ_ОбеспечитьКолонкуСерияВИсходныхДанных(ИсходныеДанные);
	битДПЭ_ЗаполнитьКолонкуКодВесовогоТовараВИсходныхДанных(ИсходныеДанные);
	
	Если Запрос = Неопределено Или ИсходныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = битДПЭ_ИмяПоляКодВесовогоТовара();
	ЗаглушкаПоля = """" + ИмяПоля + """";
	
	Если СтрНайти(Запрос.Текст, ЗаглушкаПоля) > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ЗаглушкаПоля, "ИсходныеДанные." + ИмяПоля);
	КонецЕсли;
	
КонецПроцедуры
