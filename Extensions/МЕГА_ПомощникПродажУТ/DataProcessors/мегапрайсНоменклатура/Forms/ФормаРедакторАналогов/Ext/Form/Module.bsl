
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура = Параметры.Номенклатура;   
		ОписаниеАналогов = Номенклатура.МегапрайсЕстьАналоги;
	КонецЕсли;
	
	УстановитьОтбор();

	ПолучитьАналогиНоменклатуры();
	
КонецПроцедуры


&НаКлиенте
Процедура ОписаниеАналоговПриИзменении(Элемент)
	
	ПолучитьАналогиНоменклатуры();
	
КонецПроцедуры


&НаСервере
Процедура УстановитьОтбор()
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ТекущиеАналогиРегистр, "Номенклатура", "", ВидСравненияКомпоновкиДанных.Равно, , Ложь);
		Возврат;
	КонецЕсли;
	
	ОтборНоменклатура = Номенклатура;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ТекущиеАналогиРегистр, "Номенклатура", Номенклатура, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	
КонецПроцедуры


&НаСервере
Процедура ПолучитьАналогиНоменклатуры()   
	
	Объект.ТаблицаАналогов.Очистить();
								
	ВремОписаниеАналогов = СокрЛП(ОписаниеАналогов);
	Если НЕ ЗначениеЗаполнено(ВремОписаниеАналогов) Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрокСвойств = СтрРазделить(ВремОписаниеАналогов, " ", Ложь);
	КоличествоСтрок = МассивСтрокСвойств.Количество();
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл  
		Строка = МассивСтрокСвойств.Получить(НомерСтроки-1);
		
		НоваяСтрокаСвойств = Объект.ТаблицаАналогов.Добавить();
		НоваяСтрокаСвойств.Артикул = Строка;    	
	КонецЦикла; 	
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаАналогов.Артикул КАК Артикул,
	|	ТаблицаАналогов.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаАртикулов
	|ИЗ
	|	&ТаблицаАналогов КАК ТаблицаАналогов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаАртикулов.Артикул КАК Артикул,
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	СпрНоменклатура.Код КАК Код,
	|	СпрНоменклатура.Производитель КАК Производитель
	|ИЗ
	|	ТаблицаАртикулов КАК ТаблицаАртикулов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО (СпрНоменклатура.Артикул = ТаблицаАртикулов.Артикул)";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаАналогов", Объект.ТаблицаАналогов.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	Объект.ТаблицаАналогов.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры     


&НаКлиенте
Процедура ВыполнитьОбработку(Команда) 
	
	ВыполнитьОбработкуНаСервере(); 
	
	Закрыть();
	
КонецПроцедуры


&НаСервере
Процедура ВыполнитьОбработкуНаСервере() 
	
	ПолучитьОбъект = Номенклатура.ПолучитьОбъект();	
	ПолучитьОбъект.МегапрайсЕстьАналоги = ОписаниеАналогов;
	ПолучитьОбъект.Записать(); 
	
	Для Каждого ВыборкаСтрока ИЗ Объект.ТаблицаАналогов Цикл 
		Если НЕ ЗначениеЗаполнено(ВыборкаСтрока.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолучитьОбъект = ВыборкаСтрока.Номенклатура.ПолучитьОбъект();	
		ПолучитьОбъект.МегапрайсЕстьАналоги = ОписаниеАналогов;
		ПолучитьОбъект.Записать(); 
	КонецЦикла;	  
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьАртикулНоменклатуры(Номенклатура) 
	
	Возврат Номенклатура.Артикул;    
	
КонецФункции



&НаКлиенте
Процедура ТекущиеАналогиПриАктивизацииСтроки(Элемент)  
	
	ТекущиеДанные = Элементы.ТаблицаАналогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяНоменклатура = ТекущиеДанные.Номенклатура; 
	
КонецПроцедуры


&НаКлиенте
Процедура ТекущиеАналогиНоменклатураПриИзменении(Элемент)   
	
	ТекущиеДанные = Элементы.ТаблицаАналогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные.Артикул = ПолучитьАртикулНоменклатуры(ТекущиеДанные.Номенклатура); 
	
КонецПроцедуры


&НаСервере
Функция ПолучитьНоменклатуруПоАртикулу(Артикул)  
	
	НоменклатураПоиск = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул = &Артикул";
	
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
			
	Возврат НоменклатураПоиск;
	
КонецФункции


&НаКлиенте
Процедура ТекущиеАналогиАртикулПриИзменении(Элемент) 
	
	ТекущиеДанные = Элементы.ТаблицаАналогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные.Номенклатура = ПолучитьНоменклатуруПоАртикулу(ТекущиеДанные.Артикул); 

	
КонецПроцедуры 


&НаСервере
Функция СгенерироватьОписаниеАналогов()
	
	ОписаниеАналогов = ""; 
	Счетчик = 0;
	Для Каждого ВыборкаСтрока ИЗ Объект.ТаблицаАналогов Цикл 
		Счетчик = Счетчик + 1;
		
		Если Счетчик = 1 Тогда
			ОписаниеАналогов = ВыборкаСтрока.Артикул; 
		Иначе   
			ОписаниеАналогов = ОписаниеАналогов + " " + ВыборкаСтрока.Артикул;
		КонецЕсли;
	КонецЦикла;	  
	
	Если СтрНайти(ОписаниеАналогов, Номенклатура.Артикул) = 0 Тогда  
		ОписаниеАналогов = Номенклатура.Артикул + " " + ОписаниеАналогов;		
	КонецЕсли;
	
	Возврат ОписаниеАналогов;
	
КонецФункции


&НаКлиенте
Процедура ТекущиеАналогиПриИзменении(Элемент)

	СгенерироватьОписаниеАналогов();
	
КонецПроцедуры


&НаСервере
Процедура ТекущиеАналогиПередУдалениемСервер(ТекущаяНоменклатура)
	
	Если НЕ ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда  
		Возврат;
	КонецЕсли;
	
	ПолучитьОбъект = ТекущаяНоменклатура.ПолучитьОбъект();	
	ПолучитьОбъект.МегапрайсЕстьАналоги = "";
	ПолучитьОбъект.Записать();  
	
КонецПроцедуры


&НаКлиенте
Процедура ТекущиеАналогиПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ТаблицаАналогов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда  
		Возврат;
	КонецЕсли;
	
	ТекущиеАналогиПередУдалениемСервер(ТекущаяНоменклатура);  
	
КонецПроцедуры




&НаКлиенте
Процедура ПеренестиАналоги(Команда)  
	
	ПеренестиАналогиНаСервере(); 
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиАналогиНаСервере() 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	мегапрайсВзаимозаменяемостьНоменклатуры.Номенклатура КАК Номенклатура,
		|	мегапрайсВзаимозаменяемостьНоменклатуры.НоменклатураАналог КАК НоменклатураАналог
		|ИЗ
		|	РегистрСведений.мегапрайсВзаимозаменяемостьНоменклатуры КАК мегапрайсВзаимозаменяемостьНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	мегапрайсВзаимозаменяемостьНоменклатуры.Номенклатура,
		|	мегапрайсВзаимозаменяемостьНоменклатуры.НоменклатураАналог
		|ИТОГИ ПО
		|	Номенклатура,
		|	НоменклатураАналог";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Номенклатура");	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Вставить обработку выборки ВыборкаДетальныеЗаписи   
		
		ВыбНоменклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		ОписаниеАналогов = ""; 
		Счетчик = 0;
		
		Выборка2 = ВыборкаДетальныеЗаписи.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"НоменклатураАналог");
		Пока Выборка2.Следующий() Цикл   
			
			//Если ЗначениеЗаполнено(Выборка2.НоменклатураАналог.МегапрайсЕстьАналоги) Тогда    
			//	Продолжить;
			//КонецЕсли;
			
			ВыборкаАртикул = Выборка2.НоменклатураАналог.Артикул;
			Если НЕ ЗначениеЗаполнено(ВыборкаАртикул) Тогда
				Продолжить;
			КОнецЕсли;
			
			Счетчик = Счетчик + 1;
			
			Если Счетчик = 1 Тогда
				ОписаниеАналогов = ВыборкаАртикул; 
			Иначе   
				ОписаниеАналогов = ОписаниеАналогов + " " + ВыборкаАртикул;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрНайти(ОписаниеАналогов, ВыбНоменклатура.Артикул) = 0 Тогда  
			ОписаниеАналогов = ВыбНоменклатура.Артикул + " " + ОписаниеАналогов;		
		КонецЕсли;
		
		ПолучитьОбъект = ВыбНоменклатура.ПолучитьОбъект();	
		ПолучитьОбъект.МегапрайсЕстьАналоги = ОписаниеАналогов;
		ПолучитьОбъект.Записать();  
		
		Выборка2 = ВыборкаДетальныеЗаписи.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"НоменклатураАналог");
		Пока Выборка2.Следующий() Цикл   
			
			ПолучитьОбъект = Выборка2.НоменклатураАналог.ПолучитьОбъект();	
			ПолучитьОбъект.МегапрайсЕстьАналоги = ОписаниеАналогов;
			ПолучитьОбъект.Записать();  
			
		КонецЦикла;

			
	КонецЦикла;
		
	
КонецПроцедуры








