&НаКлиенте
Процедура ДобавитьКартинки(Команда)
	
	ТекущиеДанные = Элементы.СписокНоменклатура.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда	
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВладелецФайла", ТекущиеДанные.Ссылка);

	ОткрытьФорму("Обработка.РаботаСФайлами.Форма.ПрисоединенныеФайлы", ПараметрыФормы, , ЭтаФорма.УникальныйИдентификатор);

КонецПроцедуры


