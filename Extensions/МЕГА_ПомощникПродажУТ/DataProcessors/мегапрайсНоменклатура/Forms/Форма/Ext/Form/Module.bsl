&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Номенклатура") Тогда 
		Объект.Номенклатура = Параметры.Номенклатура; 
		
		//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"Ссылка",Параметры.Номенклатура,ВидСравненияКомпоновкиДанных.Равно,,Истина);
	КонецЕсли;    
	
	Если Параметры.Свойство("СписокОтборНоменклатуры") Тогда 
		СписокОтборНоменклатуры.ЗагрузитьЗначения(Параметры.СписокОтборНоменклатуры.ВыгрузитьЗначения()); 		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВариантНавигации = "По Иерархии";
	ИспользоватьНавигацию = Ложь;
	Элементы.Навигация.Видимость = ИспользоватьНавигацию;
	
	ПоказыватьКартинки = Ложь;
	ПоказыватьКартинки();
	
	Попытка
		Элементы.СписокНоменклатура.ТекущаяСтрока = Объект.Номенклатура; 
	Исключение
	КонецПопытки;
	
	
	Если СписокОтборНоменклатуры.Количество() > 0 Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"Ссылка",СписокОтборНоменклатуры,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	Иначе              
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"Ссылка",Неопределено,ВидСравненияКомпоновкиДанных.Равно,,Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Мегапрайс_НайтиНоменклатуру" Тогда
		
		Объект.Номенклатура = Параметр.Номенклатура; 
		
		Попытка
			Элементы.СписокНоменклатура.ТекущаяСтрока = Объект.Номенклатура; 
		Исключение
		КонецПопытки;
		
	КонецЕсли;	
	
КонецПроцедуры


//============================================================================
//

&НаКлиенте
Процедура ПанельНавигацииПоказатьСкрыть(Команда)
	
	Элементы.Навигация.Видимость = ИспользоватьНавигацию;  
	ВариантыНавигацииПриСменеСтраницы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтбораПриИзменении()
	
	// Удаление всех наложенных отборов.
	СписокНоменклатура.Отбор.Элементы.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантыНавигацииПриСменеСтраницы()
	
	ВариантОтбораПриИзменении();
	
	Если НЕ ИспользоватьНавигацию Тогда
		Возврат;
	КонецЕсли;
	
	Если ВариантНавигации = "По Иерархии" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияИерархияНоменклатуры; 
		
	ИначеЕсли ВариантНавигации = "Производители" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияПроизводители;
		
	ИначеЕсли ВариантНавигации = "Виды номенклатуры" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияВидыНоменклатуры;
		
	ИначеЕсли ВариантНавигации = "Ценовые группы" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияЦеновыеГруппы;				
		
	КонецЕсли;

	ТекущаяСтраницаНавигации = Элементы.ВариантыНавигации.ТекущаяСтраница;	
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияПриАктивизацииСтроки(Элемент)
	
	Если НЕ ИспользоватьНавигацию Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтраницаНавигации = Элементы.ВариантыНавигации.ТекущаяСтраница;
	
	Если ТекущаяСтраницаНавигации = Элементы.НавигацияИерархияНоменклатуры Тогда
		
		ТекущиеДанные = Элементы.ИерархияНоменклатуры.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда  
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"Родитель",Неопределено,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"Родитель",Ложь);
		Иначе
			СписокОтбора = Новый СписокЗначений;
			ВыделенныеСтроки = Элементы.ИерархияНоменклатуры.ВыделенныеСтроки;	
			Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
				ДанныеСтроки = Элементы.ИерархияНоменклатуры.ДанныеСтроки(СтрВыд);	  
				Если ДанныеСтроки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
			КонецЦикла;
			
			ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"Родитель",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"Родитель",ИспользоватьПодбор);
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияВидыНоменклатуры Тогда		
		
		СписокОтбора = Новый СписокЗначений;
		ВыделенныеСтроки = Элементы.ВидыНоменклатуры.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ВидыНоменклатуры.ДанныеСтроки(СтрВыд);	 
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;
		
		ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"ВидНоменклатуры",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"ВидНоменклатуры",ИспользоватьПодбор);    
		
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияЦеновыеГруппы Тогда		
		
		СписокОтбора = Новый СписокЗначений;
		ВыделенныеСтроки = Элементы.ЦеновыеГруппы.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ЦеновыеГруппы.ДанныеСтроки(СтрВыд);	 
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;
		
		ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"ЦеноваяГруппа",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"ЦеноваяГруппа",ИспользоватьПодбор);
	
																			
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияПроизводители Тогда		
		
		СписокОтбора = Новый СписокЗначений;
		ВыделенныеСтроки = Элементы.ПроизводителиНоменклатуры.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ПроизводителиНоменклатуры.ДанныеСтроки(СтрВыд);	
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;
		
		ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,"Производитель",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"Производитель",ИспользоватьПодбор);																																							
		      
	КонецЕсли;   
	
КонецПроцедуры




&НаСервере
Функция ПолучитьОписаниеНоменклатуры(Номенклатура)
	
	ОписаниеНоменклатуры = Номенклатура.Описание;
	ОписаниеПросмотр.УстановитьHTML(ОписаниеНоменклатуры, Новый Структура);
	
	Возврат ОписаниеНоменклатуры;
	
КонецФункции



&НаСервере
Процедура ПоказатьПрисоединенныеФайлы(ВыбНоменклатура)
	
	Попытка              
		ВыбНоменклатура = ВыбНоменклатура.Номенклатура;
	Исключение
	КонецПопытки;
		
	ДетализацияПрисоединенныеФайлы.Очистить();
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлы.ВладелецФайла КАК Владелец,
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК ПрисоединенныйФайл,
	|	НоменклатураПрисоединенныеФайлы.ДатаСоздания КАК ДатаСоздания,
	|	НоменклатураПрисоединенныеФайлы.ДатаМодификацииУниверсальная КАК ДатаМодификацииУниверсальная,
	|	НоменклатураПрисоединенныеФайлы.Размер КАК Размер,
	|	НоменклатураПрисоединенныеФайлы.Описание КАК Описание,
	|	НоменклатураПрисоединенныеФайлы.ИндексКартинки КАК ИндексКартинки,
	|	НоменклатураПрисоединенныеФайлы.ТипХраненияФайла КАК ТипХраненияФайла,
	|	НоменклатураПрисоединенныеФайлы.ПутьКФайлу КАК ПутьКФайлу
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ТекНоменклатура";	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекНоменклатура",ВыбНоменклатура);
	Запрос.Текст = ТекстЗапроса;
	
	ДетализацияПрисоединенныеФайлы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры



&НаКлиенте
Процедура ПоказатьВсеКартинкиТекущегоТовара(ВыбНоменклатура)
	
	Для Ном = 1 По 5 Цикл
		ИмяРеквизита = "КартинкаТовара"+Ном;
		
		ЭтаФорма[ИмяРеквизита] = "";
	КонецЦикла;
	
	МассивКартинок = МегапрайсРасшифровкиСервер.ПолучитьВсеКартинкиТекущегоТовараСервер(ВыбНоменклатура);
	
	НомерКартинки = 0;
	Для Каждого ВыборкаКартинка Из МассивКартинок Цикл		
		НомерКартинки = НомерКартинки + 1;
		ИмяРеквизита = "КартинкаТовара"+НомерКартинки;		
		ЭтотОбъект[ИмяРеквизита] = МегапрайсРасшифровкиСервер.ПолучитьНавигационнуюСсылкуКартинки(,ВыборкаКартинка, УникальныйИдентификатор);
		
		Если НомерКартинки = 5 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;		
	
КонецПроцедуры



&НаСервере
Процедура РасшифровкиПолучитьСвойстваНоменклатуры(ПараметрыЗапроса)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.Свойство КАК Свойство,
	|	СпрНоменклатура.Свойство.ЭтоДополнительноеСведение КАК ЭтоДополнительноеСведение,
	|	СпрНоменклатура.Значение КАК Значение
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК СпрНоменклатура,
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	СпрНоменклатура.Ссылка = &ВыбНоменклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДополнительныеСведения.Свойство,
	|	ДополнительныеСведения.Свойство.ЭтоДополнительноеСведение,
	|	ДополнительныеСведения.Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &ВыбНоменклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Свойство";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВыбНоменклатура", ПараметрыЗапроса.Номенклатура);    
	Запрос.УстановитьПараметр("ВыбВидНоменклатуры", ПараметрыЗапроса.ВидНоменклатуры);
	
	СвойстваНоменклатуры.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РасшифровкиПолучитьРеквизитыНоменклатуры(Ссылка)
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("ВидНоменклатуры", Ссылка.ВидНоменклатуры);
	СтруктураПараметров.Вставить("Производитель", Ссылка.Производитель);
	СтруктураПараметров.Вставить("Марка", Ссылка.Марка);
	СтруктураПараметров.Вставить("КоллекцияНоменклатуры", Ссылка.КоллекцияНоменклатуры);
	СтруктураПараметров.Вставить("ТоварнаяКатегория", Ссылка.ТоварнаяКатегория);
	СтруктураПараметров.Вставить("СезоннаяГруппа", Ссылка.СезоннаяГруппа);
	СтруктураПараметров.Вставить("РейтингПродаж", Ссылка.РейтингПродаж);
	СтруктураПараметров.Вставить("ЦеноваяГруппа", Ссылка.ЦеноваяГруппа);
	
	Возврат СтруктураПараметров;
	
КонецФункции


&НаКлиенте
Процедура ОбновитьТекущуюИнформацию()
	
	СвойстваНоменклатуры.Очистить();
	ДетализацияПрисоединенныеФайлы.Очистить();

	ВидНоменклатуры = "";
	КартинкаНоменклатуры = "";
	ОписаниеНоменклатуры = "";
	ОписаниеПросмотр = "";
	
	Производитель = "";
	Марка = "";
	КоллекцияНоменклатуры = "";
	ТоварнаяКатегория = "";
	СезоннаяГруппа = "";
	РейтингПродаж = "";
	ЦеноваяГруппа = "";

	ТекущиеДанныеНоменклатура = Элементы.СписокНоменклатура.ТекущиеДанные;	
	Если ТекущиеДанныеНоменклатура = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Номенклатура", ТекущиеДанныеНоменклатура.Ссылка); 
	ПараметрыЗапроса.Вставить("ВидНоменклатуры", ТекущиеДанныеНоменклатура.ВидНоменклатуры);

	ПоказыватьКартинки();
	
	Если Элементы.ДопИнформация.ТекущаяСтраница = Элементы.СтраницаРеквизиты Тогда
		
		//Если Элементы.СписокНоменклатура.ВыделенныеСтроки.Количество() > 1 Тогда
		//	Возврат;
		//КонецЕсли;

		СтруктураПараметров = РасшифровкиПолучитьРеквизитыНоменклатуры(ТекущиеДанныеНоменклатура.Ссылка);
		
		ВидНоменклатуры = СтруктураПараметров.ВидНоменклатуры;
		Производитель = СтруктураПараметров.Производитель;
		Марка = СтруктураПараметров.Марка;
		КоллекцияНоменклатуры = СтруктураПараметров.КоллекцияНоменклатуры;
		ТоварнаяКатегория = СтруктураПараметров.ТоварнаяКатегория;
		СезоннаяГруппа = СтруктураПараметров.СезоннаяГруппа;
		РейтингПродаж = СтруктураПараметров.РейтингПродаж;
		ЦеноваяГруппа = СтруктураПараметров.ЦеноваяГруппа;
		
	ИначеЕсли Элементы.ДопИнформация.ТекущаяСтраница = Элементы.СтраницаОписаниеТовара Тогда
		
		ОписаниеНоменклатуры = ПолучитьОписаниеНоменклатуры(ТекущиеДанныеНоменклатура.Ссылка);		
				
	ИначеЕсли Элементы.ДопИнформация.ТекущаяСтраница = Элементы.СтраницаКартинкиСписком Тогда
		
		ПоказатьПрисоединенныеФайлы(ТекущиеДанныеНоменклатура.Ссылка);	
		
	ИначеЕсли Элементы.ДопИнформация.ТекущаяСтраница = Элементы.СтраницаСвойстваНоменклатуры Тогда
		
		РасшифровкиПолучитьСвойстваНоменклатуры(ПараметрыЗапроса);		
		
