&НаКлиенте
Процедура ОчиститьЗначенияРеквизитов(Команда)
	
	Производитель = "";
	Марка = "";
	КоллекцияНоменклатуры = "";
	ТоварнаяКатегория = "";
	СезоннаяГруппа = "";
	РейтингПродаж = "";
	ЦеноваяГруппа = "";

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыКоманда(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ИзменитьРеквизитыЗавершение", ЭтотОбъект), НСтр("ru = 'Вы уверены?'"), РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные = Элементы.СписокНоменклатура.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда	
		Возврат;
	КонецЕсли;	
	
	СписокНоменклатуры = Новый СписокЗначений;
	Для Каждого СтрВыд Из Элементы.СписокНоменклатура.ВыделенныеСтроки Цикл 
		ДанныеСтроки = Элементы.СписокНоменклатура.ДанныеСтроки(СтрВыд);	 
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокНоменклатуры.Добавить(ДанныеСтроки.Ссылка);
	КонецЦикла;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокНоменклатуры",СписокНоменклатуры.ВыгрузитьЗначения());
	
	ИзменитьРеквизитыНаСервере(СтруктураПараметров);
	Элементы.СписокНоменклатура.Обновить();
	
КонецПроцедуры
 

&НаСервере
Процедура ИзменитьРеквизитыНаСервере(СтруктураПараметров)
	
	СписокНоменклатуры = СтруктураПараметров.СписокНоменклатуры;
	
	Для Каждого ВыборкаНоменклатура Из СписокНоменклатуры Цикл
		НоменклатураОбъект = ВыборкаНоменклатура.ПолучитьОбъект();	
		Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
			НоменклатураОбъект.ВидНоменклатуры = ВидНоменклатуры;
			Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(НоменклатураОбъект);
		КонецЕсли;
		Если ЗначениеЗаполнено(Производитель) Тогда
			НоменклатураОбъект.Производитель = Производитель;
		КонецЕсли;
		Если ЗначениеЗаполнено(Марка) Тогда
			НоменклатураОбъект.Марка = Марка;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТоварнаяКатегория) Тогда
			НоменклатураОбъект.ТоварнаяКатегория = ТоварнаяКатегория;
		КонецЕсли;
		Если ЗначениеЗаполнено(КоллекцияНоменклатуры) Тогда
			НоменклатураОбъект.КоллекцияНоменклатуры = КоллекцияНоменклатуры;
		КонецЕсли;
		Если ЗначениеЗаполнено(СезоннаяГруппа) Тогда
			НоменклатураОбъект.СезоннаяГруппа = СезоннаяГруппа;
		КонецЕсли;
		Если ЗначениеЗаполнено(РейтингПродаж) Тогда
			НоменклатураОбъект.РейтингПродаж = РейтингПродаж;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЦеноваяГруппа) Тогда
			НоменклатураОбъект.ЦеноваяГруппа = ЦеноваяГруппа;
		КонецЕсли;
        НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		НоменклатураОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

