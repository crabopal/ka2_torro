&НаСервере
Функция ЭтоСсылка(Тип) Экспорт
	
	Возврат Тип <> Тип("Неопределено") 
		И (Справочники.ТипВсеСсылки().СодержитТип(Тип)
		//ИЛИ Документы.ТипВсеСсылки().СодержитТип(Тип)
		//ИЛИ Перечисления.ТипВсеСсылки().СодержитТип(Тип)
		//ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(Тип)
		ИЛИ ПланыСчетов.ТипВсеСсылки().СодержитТип(Тип)
		ИЛИ ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(Тип)
		ИЛИ БизнесПроцессы.ТипВсеСсылки().СодержитТип(Тип)
		ИЛИ БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().СодержитТип(Тип)
		ИЛИ Задачи.ТипВсеСсылки().СодержитТип(Тип)
		ИЛИ ПланыОбмена.ТипВсеСсылки().СодержитТип(Тип));
	
КонецФункции

&НаСервере
Функция ЗначениеСсылочногоТипа(Значение) Экспорт
	
	Возврат ЭтоСсылка(ТипЗнч(Значение));
	
КонецФункции

&НаСервере
Процедура КомандаУдалитьНоменклатуруНаСервере()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Ссылка,
	|	СпрНоменклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.ЭтоГруппа = ЛОЖЬ
	|	И СпрНоменклатура.мегапрайсДатаРегистрации = &ДатаРегистрации";	
	
	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаРегистрации", Мегадата);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокСсылок = Новый Массив();
	Для Каждого СтрВыборка Из Результат Цикл
		ПолучитьОбъект = СтрВыборка.Ссылка.ПолучитьОбъект();
		ПолучитьОбъект.УстановитьПометкуУдаления(Истина,Истина);
		Сообщить ("Помечен на удаление " + СтрВыборка.Наименование);
		
		СписокСсылок.Добавить(СтрВыборка.Ссылка);
	КонецЦикла;
	
	ТаблицаСсылок = НайтиПоСсылкам(СписокСсылок);
	ТаблицаСсылок.Колонки[0].Имя = "ИсходнаяСсылка";
	ТаблицаСсылок.Колонки[1].Имя = "ОбнаруженныйСсылка";
	ТаблицаСсылок.Колонки[2].Имя = "ОбнаруженныйМетаданные";

	НачатьТранзакцию();
	Попытка		
		Для Каждого Ссылка из ТаблицаСсылок Цикл
			Если ЗначениеСсылочногоТипа(Ссылка[1]) Тогда				
				Ссылка[1].ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
				Сообщить ("Помечен на удаление связанный элемент " + СокрЛП(Ссылка[0]) + "  " + СокрЛП(Ссылка[1]));
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьНоменклатуру(Команда)
	
	КомандаУдалитьНоменклатуруНаСервере();
	
КонецПроцедуры


&НаКлиенте
Процедура ПоказыватьКартинки()
	
	Элементы.СтраницаКартинкиНоменклатуры.Видимость = ПоказыватьКартинки;
	
	Если ПоказыватьКартинки Тогда   
		ТекущиеДанныеНоменклатура = Элементы.СписокНоменклатура.ТекущиеДанные;	
		Если ТекущиеДанныеНоменклатура = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПоказатьВсеКартинкиТекущегоТовара(ТекущиеДанныеНоменклатура.Ссылка);	   
	КонецЕсли;
	
КонецПроцедуры



