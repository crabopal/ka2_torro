	Для Каждого СтрВыд Из Элементы.СписокНоменклатура.ВыделенныеСтроки Цикл 
		ДанныеСтроки = Элементы.СписокНоменклатура.ДанныеСтроки(СтрВыд);	 
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокНоменклатуры.Добавить(ДанныеСтроки.Ссылка);
	КонецЦикла;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокНоменклатуры",СписокНоменклатуры.ВыгрузитьЗначения());

	ИзменитьСвойстваНаСервере(СтруктураПараметров);
	Элементы.СписокНоменклатура.Обновить();

КонецПроцедуры

&НаСервере
Процедура ИзменитьСвойстваНаСервере(СтруктураПараметров)
	
	СписокНоменклатуры = СтруктураПараметров.СписокНоменклатуры;
	
	Для Каждого ВыборкаНоменклатура Из СписокНоменклатуры Цикл 
		
		НоменклатураОбъект = ВыборкаНоменклатура.ПолучитьОбъект();
		ДопРеквизиты = НоменклатураОбъект.ДополнительныеРеквизиты;			
		Для Каждого ВыборкаСтрока Из СвойстваНоменклатуры Цикл
			Если НЕ ВыборкаСтрока.Пометка Тогда
				Продолжить;
			КонецЕсли;
			Строка = ДопРеквизиты.Найти(ВыборкаСтрока.Свойство,"Свойство");
			Если Строка = Неопределено Тогда
				Строка = ДопРеквизиты.Добавить();
			КонецЕсли;
			Строка.Свойство = ВыборкаСтрока.Свойство;
			Строка.Значение = ВыборкаСтрока.Значение;	
		КонецЦикла;		
		НоменклатураОбъект.Записать();  
		
	КонецЦикла;

КонецПроцедуры

