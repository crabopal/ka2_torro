Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	//ОбновитьИнформациюСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОпций(Элемент)
	
	УстановитьВидимостьЭлементовФормы();
	ОбновитьИнформациюСервер();
	
КонецПроцедуры


&НаСервере
Процедура ОбновитьИнформациюСервер()
	
	ПолучитьДанныеНоменклатуры();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформацию(Команда)
	
	ОбновитьИнформациюСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
		
	ИзменитьТекущуюНоменклатуру();   
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	ИзменитьТекущуюНоменклатуру(); 
	
КонецПроцедуры


&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	ОбновитьИнформациюСервер();
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьТекущуюНоменклатуру()
	
	НоменклатураОбъект = Объект.Номенклатура.ПолучитьОбъект();
	
	НоменклатураОбъект.Производитель = Производитель;
	НоменклатураОбъект.Марка = Марка;
	НоменклатураОбъект.ТоварнаяКатегория = ТоварнаяКатегория;
	НоменклатураОбъект.КоллекцияНоменклатуры = КоллекцияНоменклатуры;
	НоменклатураОбъект.СезоннаяГруппа = СезоннаяГруппа;
	НоменклатураОбъект.РейтингПродаж = РейтингПродаж;
	НоменклатураОбъект.ЦеноваяГруппа = ЦеноваяГруппа;
	НоменклатураОбъект.Качество = Качество;  
	НоменклатураОбъект.Описание = ОписаниеНоменклатуры;
	
	ДопРеквизиты = НоменклатураОбъект.ДополнительныеРеквизиты;	
	Для Каждого ВыборкаСтрока Из СвойстваНоменклатуры Цикл
		Строка = ДопРеквизиты.Найти(ВыборкаСтрока.Свойство,"Свойство");
		Если Строка = Неопределено Тогда
			Строка = ДопРеквизиты.Добавить();
		КонецЕсли;
		Строка.Свойство = ВыборкаСтрока.Свойство;
		Строка.Значение = ВыборкаСтрока.Значение;	
	КонецЦикла;
	
	НоменклатураОбъект.Записать();  
	
КонецПроцедуры


