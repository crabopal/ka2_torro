&НаСервере
Функция ПолучитьОписаниеНоменклатуры(Номенклатура)
	
	ОписаниеНоменклатуры = Номенклатура.Описание;
	ОписаниеПросмотр.УстановитьHTML(ОписаниеНоменклатуры, Новый Структура);
	
	Возврат ОписаниеНоменклатуры;
	
КонецФункции

&НаСервере
Функция ПолучитьНавигационнуюСсылкуКартинки(ФайлКартинки, ИдентификаторФормы)
	
	ДанныеФайла = Неопределено;
	Попытка
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлКартинки, ИдентификаторФормы).СсылкаНаДвоичныеДанныеФайла;
	Исключение
		//Выполнить("ДанныеФайла = ПрисоединенныеФайлы.ПолучитьДанныеФайла(ФайлКартинки).СсылкаНаДвоичныеДанныеФайла");
	КонецПопытки;
	
	Возврат ДанныеФайла;
	
КонецФункции

&НаСервере
Функция ПолучитьОсновноеИзображение(Ссылка)
	
	КартинкаНоменклатуры = "";
	
	ПодборКартинкаНоменклатуры = Ссылка.ФайлКартинки;		
	Если ЗначениеЗаполнено(ПодборКартинкаНоменклатуры) Тогда
		КартинкаНоменклатуры = ПолучитьНавигационнуюСсылкуКартинки(ПодборКартинкаНоменклатуры, УникальныйИдентификатор)
	Конецесли;
	
КонецФункции

&НаСервере
Процедура ПолучитьКартинкиТекущегоЭлементаСервер(Ссылка)
	
	Для Ном = 1 По 6 Цикл
		ИмяРеквизита = "КартинкаТовара"+Ном;	
		ЭтаФорма[ИмяРеквизита] = ""; 
		Элементы.Найти(ИмяРеквизита).Видимость = Ложь;
	КонецЦикла;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК ПрисоединенныйФайл,
	|	НоменклатураПрисоединенныеФайлы.ИндексКартинки КАК ИндексКартинки
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ТекНоменклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИндексКартинки";	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекНоменклатура",Ссылка);
	Запрос.Текст = ТекстЗапроса;
	
	СписокКартинокТовара = Запрос.Выполнить().Выгрузить();
	
	НомерКартинки = 0;
	Для Каждого Выборка Из СписокКартинокТовара Цикл		
		НомерКартинки = НомерКартинки + 1;
		ИмяРеквизита = "КартинкаТовара"+НомерКартинки;
		
		ПолучитьЗначение = ПолучитьНавигационнуюСсылкуКартинки(Выборка.ПрисоединенныйФайл, УникальныйИдентификатор);
		ЭтотОбъект[ИмяРеквизита] = ПолучитьЗначение;
		Элементы.Найти(ИмяРеквизита).Видимость = Истина;
		
		Если НомерКартинки = 6 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;	 
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьПрисоединенныеФайлы(Ссылка)
	
	ДетализацияПрисоединенныеФайлы.Очистить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК ПрисоединенныйФайл,
	|	НоменклатураПрисоединенныеФайлы.ДатаСоздания КАК ДатаСоздания,
	|	НоменклатураПрисоединенныеФайлы.ДатаМодификацииУниверсальная КАК ДатаМодификацииУниверсальная,
	|	НоменклатураПрисоединенныеФайлы.Размер КАК Размер,
	|	НоменклатураПрисоединенныеФайлы.Описание КАК Описание,
	|	НоменклатураПрисоединенныеФайлы.ИндексКартинки КАК ИндексКартинки,
	|	НоменклатураПрисоединенныеФайлы.ТипХраненияФайла КАК ТипХраненияФайла,
	|	НоменклатураПрисоединенныеФайлы.ПутьКФайлу КАК ПутьКФайлу
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ТекНоменклатура";	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекНоменклатура",Ссылка);
	Запрос.Текст = ТекстЗапроса;
	
	ДетализацияПрисоединенныеФайлы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ПолучитьКартинкиТекущегоЭлементаСервер(Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкиПолучитьСвойстваНоменклатуры(Ссылка)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СпрНоменклатура.Свойство КАК Свойство,
	|	СпрНоменклатура.Значение КАК Значение
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка = &ВыбНоменклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	СпрНоменклатура.Свойство.Наименование
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВыбНоменклатура", Объект.Номенклатура);    
	Запрос.УстановитьПараметр("ВыбВидНоменклатуры", Объект.ВидНоменклатуры);
	
	СвойстваНоменклатуры.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура РасшифровкиПолучитьРеквизитыНоменклатуры(Ссылка)
	
	Производитель = Ссылка.Производитель;
	Марка = Ссылка.Марка;
	КоллекцияНоменклатуры = Ссылка.КоллекцияНоменклатуры;
	ТоварнаяКатегория = Ссылка.ТоварнаяКатегория;
	СезоннаяГруппа = Ссылка.СезоннаяГруппа;
	РейтингПродаж = Ссылка.РейтингПродаж;
	ЦеноваяГруппа = Ссылка.ЦеноваяГруппа;
	Качество = Ссылка.Качество;	
	Мегадата = Ссылка.мегапрайсДатаРегистрации;    
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеНоменклатуры()
		
	Объект.ВидНоменклатуры = Объект.Номенклатура.ВидНоменклатуры;  
	ЕстьАналоги = Объект.Номенклатура.мегапрайсЕстьАналоги; 
	КартинкаНоменклатуры = "";	
	ПолучитьОсновноеИзображение(Объект.Номенклатура);
	
	ОписаниеНоменклатуры = ПолучитьОписаниеНоменклатуры(Объект.Номенклатура);	
	
	ПоказатьПрисоединенныеФайлы(Объект.Номенклатура);	
	РасшифровкиПолучитьСвойстваНоменклатуры(Объект.Номенклатура);		
	РасшифровкиПолучитьРеквизитыНоменклатуры(Объект.Номенклатура);			
	
КонецПроцедуры



