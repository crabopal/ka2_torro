// ПАНЕЛЬ ИНФОРМАЦИИ




&НаСервере
Процедура ОписаниеНоменклатурыПриИзмененииНаСервере()
	
	ОписаниеПросмотр.УстановитьHTML(ОписаниеНоменклатуры, Новый Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеНоменклатурыПриИзменении(Элемент)
	
	ОписаниеНоменклатурыПриИзмененииНаСервере();
	
КонецПроцедуры



&НаКлиенте
Процедура КартинкиДобавить(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВладелецФайла",  Объект.Номенклатура);
	
	ОткрытьФорму("Обработка.РаботаСФайлами.Форма.ПрисоединенныеФайлы",ПараметрыФормы, , ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкиУстановитьГлавную(Команда)
	
	Ответ = Вопрос("Вы уверены ?", РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет, "Дополнительный вопрос");		
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СписокКартинкиТекущиеДанные = Элементы.ДетализацияПрисоединенныеФайлы.ТекущиеДанные;
	ТекущаяКартинка = СписокКартинкиТекущиеДанные.ПрисоединенныйФайл;
	
	ТекущиеДанныеСтроки = Новый Структура;
	ТекущиеДанныеСтроки.Вставить("ТекНоменклатура",Объект.Номенклатура);
	ТекущиеДанныеСтроки.Вставить("ТекКартинка",ТекущаяКартинка);
	
	КартинкиУстановитьГлавнуюСервер(ТекущиеДанныеСтроки);
	
	КартинкаНоменклатуры = "";	
	ПолучитьОсновноеИзображение(Объект.Номенклатура);
	
КонецПроцедуры

&НаСервере
Процедура КартинкиУстановитьГлавнуюСервер(ТекущиеДанныеСтроки)
	
	ТекКартинка = ТекущиеДанныеСтроки.ТекКартинка;
	
	ОбъектНоменклатура = Объект.Номенклатура.ПолучитьОбъект(); 
	ОбъектНоменклатура.ФайлКартинки = ТекКартинка;
	ОбъектНоменклатура.Записать();  
	
	КартинкаНоменклатуры = "";	
	ПолучитьОсновноеИзображение(Объект.Номенклатура);
	
КонецПроцедуры


&НаСервере
Процедура КартинкиОчиститьГлавнуюСервер(ТекНоменклатура)
	
	ОбъектНоменклатура = ТекНоменклатура.ПолучитьОбъект(); 
	ОбъектНоменклатура.ФайлКартинки = "";
	ОбъектНоменклатура.Записать();  
	
	ПолучитьОсновноеИзображение(ТекНоменклатура);
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкиОчиститьГлавную(Команда)
	
	Ответ = Вопрос("Вы уверены ?", РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет, "Дополнительный вопрос");		
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	КартинкиОчиститьГлавнуюСервер(Объект.Номенклатура);
	
КонецПроцедуры


&НаСервере
Процедура КартинкиУдалитьСервер(ТекНоменклатура)
	
	ОбъектНоменклатура = ТекНоменклатура.ПолучитьОбъект(); 
	ОбъектНоменклатура.ФайлКартинки = "";
	ОбъектНоменклатура.Записать();  
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	НоменклатураПрисоединенныеФайлы.ДатаСоздания КАК ДатаСоздания,
	|	НоменклатураПрисоединенныеФайлы.ДатаМодификацииУниверсальная КАК ДатаМодификацииУниверсальная,
	|	НоменклатураПрисоединенныеФайлы.Размер КАК Размер,
	|	НоменклатураПрисоединенныеФайлы.Описание КАК Описание
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ТекНоменклатура";	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекНоменклатура",ТекНоменклатура);
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектНоменклатура = Выборка.Ссылка.ПолучитьОбъект(); 
		ОбъектНоменклатура.Удалить();  
	КонецЦикла;
	
	ПоказатьПрисоединенныеФайлы(ТекНоменклатура);
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкиУдалить(Команда)
	
	Ответ = Вопрос("Вы уверены ?", РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет, "Дополнительный вопрос");		
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	КартинкиУдалитьСервер(Объект.Номенклатура);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИзображениеПрисоединенногоФайла(ФайлСсылка)
		
	Если ЗначениеЗаполнено(ФайлСсылка) Тогда
		КартинкаНоменклатуры = ПолучитьНавигационнуюСсылкуКартинки(ФайлСсылка, УникальныйИдентификатор)
	Иначе
		КартинкаНоменклатуры = "";
	Конецесли;
		
КонецФункции

&НаКлиенте
Процедура ДетализацияПрисоединенныеФайлыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДетализацияПрисоединенныеФайлы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолучитьИзображениеПрисоединенногоФайла(ТекущиеДанные.ПрисоединенныйФайл);

КонецПроцедуры










