	   
Перем МассивНоменклатуры;	   
	   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СписокПоискНоменклатуры") Тогда
		СписокПоискНоменклатуры.ЗагрузитьЗначения(Параметры.СписокПоискНоменклатуры);   
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьПоказ();

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьНавигационнуюСсылкуКартинки(ФайлКартинки, ИдентификаторФормы)
	
	ДанныеФайла = Неопределено;
	Попытка
		ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ПолучитьДанныеФайла(ФайлКартинки).СсылкаНаДвоичныеДанныеФайла;
	Исключение
		//Выполнить("ДанныеФайла = ПрисоединенныеФайлы.ПолучитьДанныеФайла(ФайлКартинки).СсылкаНаДвоичныеДанныеФайла");
	КонецПопытки;
	
	Возврат ДанныеФайла;
	
КонецФункции




&НаСервере
Процедура ПоказатьВсеКартинкиТекущегоТовара(ВыборкаНоменклатура, НомерТовара)
	
	МассивФорматов = Новый Массив();
	МассивФорматов.Добавить("jpg");   
	МассивФорматов.Добавить("jpeg");
	МассивФорматов.Добавить("gif");
	МассивФорматов.Добавить("png");   
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НоменклатураПрисоединенныеФайлы.Ссылка КАК ПрисоединенныйФайл,
	|	НоменклатураПрисоединенныеФайлы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	|ГДЕ
	|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ТекНоменклатура
	|	И НоменклатураПрисоединенныеФайлы.ПометкаУдаления = ЛОЖЬ
	|	И НоменклатураПрисоединенныеФайлы.Расширение В(&МассивФорматов)";	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекНоменклатура", ВыборкаНоменклатура);  
	Запрос.УстановитьПараметр("МассивФорматов", МассивФорматов);
	Запрос.Текст = ТекстЗапроса;
	
	СписокКартинокТовара = Запрос.Выполнить().Выгрузить();
	
	
	ИмяРеквизитаТовар = "Товар"+НомерТовара;
	НоваяСтраница = Элементы.Добавить(ИмяРеквизитаТовар, Тип("ГруппаФормы"),Элементы.КартинкиНоменклатуры);
	НоваяСтраница.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяСтраница.Заголовок = ВыборкаНоменклатура;

	НомерКартинки = 0;
	Для Каждого Выборка Из СписокКартинокТовара Цикл	
		
		НомерКартинки = НомерКартинки + 1;
		ИмяРеквизита = ИмяРеквизитаТовар+"_КартинкаТовара"+НомерКартинки;
		
		ДобавляемыеРеквизиты = Новый Массив;
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		Реквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов(МассивТипов), , , Истина);
		ДобавляемыеРеквизиты.Добавить(Реквизит);
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);		
			
		НоваяКартинка = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"),НоваяСтраница);
		НоваяКартинка.ПутьКДанным = ИмяРеквизита;
		НоваяКартинка.Вид = ВидПоляФормы.ПолеКартинки;
		НоваяКартинка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет; 
		НоваяКартинка.УстановитьДействие("Нажатие", "КартинкаОбработкаРасшифровки");
		Элементы[ИмяРеквизита].РазмерКартинки = РазмерКартинки.Пропорционально;
				
		ЭтотОбъект[ИмяРеквизита] = ПолучитьНавигационнуюСсылкуКартинки(Выборка.ПрисоединенныйФайл, УникальныйИдентификатор);
	КонецЦикла;		
	
КонецПроцедуры






&НаСервере
Процедура ВыполнитьПоказ()
	
	НомерТовара = 0;
	НомерКартинки = 0;
	
	Для Каждого ВыборкаНоменклатура Из СписокПоискНоменклатуры Цикл   
		
		НомерТовара = НомерТовара + 1;
		
		ПоказатьВсеКартинкиТекущегоТовара(ВыборкаНоменклатура.Значение, НомерТовара);		        
		
	КонецЦикла;

КонецПроцедуры





