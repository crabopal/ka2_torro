 &НаКлиенте
Перем КэшированныеЗначения;
		  
&НаСервере
Процедура ЗаполнитьСписокХарактеристик(ВыбНоменклатура)
	
	ПодборХарактеристик.Очистить();
	
	ТекстЗапроса =      
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
	|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	|	ХарактеристикиНоменклатуры.Наименование КАК Наименование
	|ПОМЕСТИТЬ ТаблицаХарактеристики
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	(ХарактеристикиНоменклатуры.Владелец = &ВыбНоменклатура
	|			ИЛИ ХарактеристикиНоменклатуры.Владелец = &ВидНоменклатуры)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РаспределениеЗапасов.Номенклатура КАК Номенклатура,
	|	РаспределениеЗапасов.Характеристика КАК Характеристика,
	|	СУММА(РаспределениеЗапасов.ВНаличииОстаток) - СУММА(РаспределениеЗапасов.РезервироватьНаСкладеОстаток) КАК СвободноОстаток
	|ПОМЕСТИТЬ ТаблицаОстатки
	|ИЗ
	|	РегистрНакопления.ЗапасыИПотребности.Остатки(, ) КАК РаспределениеЗапасов
	|ГДЕ
	|	РаспределениеЗапасов.Номенклатура = &ВыбНоменклатура
	|	И РаспределениеЗапасов.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|{ГДЕ
	|	РаспределениеЗапасов.Склад.* КАК Склад}
	|
	|СГРУППИРОВАТЬ ПО
	|	РаспределениеЗапасов.Номенклатура,
	|	РаспределениеЗапасов.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатуры.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ЦеныНоменклатуры.Цена) КАК Цена
	|ПОМЕСТИТЬ ТаблицаЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ВидЦены = &ВыбВидЦены
	|				И Номенклатура = &ВыбНоменклатура) КАК ЦеныНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныНоменклатуры.Номенклатура,
	|	ЦеныНоменклатуры.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаХарактеристики.Номенклатура КАК Номенклатура,
	|	ТаблицаХарактеристики.Характеристика КАК Характеристика,
	|	ТаблицаОстатки.СвободноОстаток КАК СвободноОстаток,
	|	ТаблицаЦены.Цена КАК Цена
	|ИЗ
	|	ТаблицаХарактеристики КАК ТаблицаХарактеристики
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОстатки КАК ТаблицаОстатки
	|		ПО ТаблицаХарактеристики.Номенклатура = ТаблицаОстатки.Номенклатура
	|			И ТаблицаХарактеристики.Характеристика = ТаблицаОстатки.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЦены КАК ТаблицаЦены
	|		ПО ТаблицаХарактеристики.Номенклатура = ТаблицаЦены.Номенклатура
	|			И ТаблицаХарактеристики.Характеристика = ТаблицаЦены.Характеристика";
	
	//ИспользуетсяЦенообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25(ТекущаяДата());  
	//Если ИспользуетсяЦенообразование25 = Истина Тогда 
	//	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РегистрСведений.ЦеныНоменклатуры","РегистрСведений.ЦеныНоменклатуры25");  
	//КонецЕсли;

	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ТекстЗапроса;	
	
	ПостроительОтчета.Параметры.Вставить("ВыбНоменклатура",ВыбНоменклатура);  
	ПостроительОтчета.Параметры.Вставить("ВидНоменклатуры", ВыбНоменклатура.ВидНоменклатуры);  
	ПостроительОтчета.Параметры.Вставить("ВыбВидЦены", ВидЦены);  
	
	Отборы = ПостроительОтчета.Отбор;
	Если ЗначениеЗаполнено(Склад) Тогда 
		Отборы.Добавить("Склад","Склад");
		Отборы["Склад"].Использование = Истина;
		Отборы["Склад"].ВидСравнения = ВидСравнения.Равно;
		Отборы["Склад"].Значение = Склад;
	КонецЕсли; 
	
	ПостроительОтчета.Выполнить();
	РезультатЗапроса = ПостроительОтчета.Результат;
	
	ПодборХарактеристик.Загрузить(РезультатЗапроса.Выгрузить());	

КонецПроцедуры     

&НаСервере
Процедура ЗаполнитьСписокСерийНоменклатуры(ВыбНоменклатура)
	
	ПодборСерийНоменклатуры.Очистить();
	
	ТекстЗапроса =      
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладах.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладах.Склад КАК Склад,
	|	ТоварыНаСкладах.Серия КАК Серия,
	|	СУММА(ТоварыНаСкладах.ВНаличииОстаток) КАК ВНаличииОстаток
	|ПОМЕСТИТЬ ТаблицаОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, ) КАК ТоварыНаСкладах
	|ГДЕ
	|	ТоварыНаСкладах.Номенклатура = &ВыбНоменклатура
	|{ГДЕ
	|	ТоварыНаСкладах.Склад.* КАК Склад}
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладах.Номенклатура,
	|	ТоварыНаСкладах.Склад,
	|	ТоварыНаСкладах.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыКОтгрузке.Номенклатура КАК Номенклатура,
	|	ТоварыКОтгрузке.Склад КАК Склад,
	|	ТоварыКОтгрузке.Серия КАК Серия,
	|	СУММА(ТоварыКОтгрузке.ВРезервеОстаток) КАК ВРезерве,
	|	СУММА(ТоварыКОтгрузке.КОтгрузкеОстаток) КАК КОтгрузке
	|ПОМЕСТИТЬ ТаблицаТоварыОтгрузка
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(, ) КАК ТоварыКОтгрузке
	|ГДЕ
	|	ТоварыКОтгрузке.Номенклатура = &ВыбНоменклатура
	|{ГДЕ
	|	ТоварыКОтгрузке.Склад.* КАК Склад}
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОтгрузке.Номенклатура,
	|	ТоварыКОтгрузке.Склад,
	|	ТоварыКОтгрузке.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ЦеныНоменклатуры.Цена) КАК Цена
	|ПОМЕСТИТЬ ТаблицаЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ВидЦены = &ВыбВидЦены
	|				И Номенклатура = &ВыбНоменклатура) КАК ЦеныНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныНоменклатуры.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОстатки.Серия КАК СерияНоменклатуры,
	|	ТаблицаОстатки.Склад КАК Склад,
	|	СУММА(ТаблицаОстатки.ВНаличииОстаток) КАК ВНаличииОстаток,
	|	СУММА(ТаблицаОстатки.ВНаличииОстаток) - СУММА(ЕСТЬNULL(ТаблицаТоварыОтгрузка.ВРезерве, 0)) - СУММА(ЕСТЬNULL(ТаблицаТоварыОтгрузка.КОтгрузке, 0)) КАК СвободноОстаток,
	|	СУММА(ТаблицаТоварыОтгрузка.ВРезерве) КАК ВРезерве,
	|	СУММА(ТаблицаТоварыОтгрузка.КОтгрузке) КАК КОтгрузке,
	|	МАКСИМУМ(ТаблицаЦены.Цена) КАК Цена
	|ИЗ
	|	ТаблицаОстатки КАК ТаблицаОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаТоварыОтгрузка КАК ТаблицаТоварыОтгрузка
	|		ПО ТаблицаОстатки.Номенклатура = ТаблицаТоварыОтгрузка.Номенклатура
	|			И ТаблицаОстатки.Склад = ТаблицаТоварыОтгрузка.Склад
	|			И ТаблицаОстатки.Серия = ТаблицаТоварыОтгрузка.Серия
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЦены КАК ТаблицаЦены
	|		ПО ТаблицаОстатки.Номенклатура = ТаблицаЦены.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОстатки.Склад,
	|	ТаблицаОстатки.Серия";
	
	ИспользуетсяЦенообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25(ТекущаяДата());  
	Если ИспользуетсяЦенообразование25 = Истина Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РегистрСведений.ЦеныНоменклатуры","РегистрСведений.ЦеныНоменклатуры25");  
	КонецЕсли;

	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ТекстЗапроса;	
	
	ПостроительОтчета.Параметры.Вставить("ВыбНоменклатура",ВыбНоменклатура);  
	ПостроительОтчета.Параметры.Вставить("ВидНоменклатуры", ВыбНоменклатура.ВидНоменклатуры);  
	ПостроительОтчета.Параметры.Вставить("ВыбВидЦены", ВидЦены);  
	
	Отборы = ПостроительОтчета.Отбор;
	Если ЗначениеЗаполнено(Склад) Тогда 
		Отборы.Добавить("Склад","Склад");
		Отборы["Склад"].Использование = Истина;
		Отборы["Склад"].ВидСравнения = ВидСравнения.Равно;
		Отборы["Склад"].Значение = Склад;
	КонецЕсли; 
	
	ПостроительОтчета.Выполнить();
	РезультатЗапроса = ПостроительОтчета.Результат;
	
	ПодборСерийНоменклатуры.Загрузить(РезультатЗапроса.Выгрузить());	

КонецПроцедуры     


&НаКлиенте
Процедура ПодборХарактеристикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;	
	Характеристика = Элементы.ПодборХарактеристик.ТекущиеДанные.Характеристика;	
	
	Если РежимПростойПодбор Тогда 
		КоличествоПриИзменении();
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура ПодборСерийНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)     
	
	СтандартнаяОбработка = Ложь;	
	СерияНоменклатуры = Элементы.ПодборСерийНоменклатуры.ТекущиеДанные.СерияНоменклатуры;	
	
	Если РежимПростойПодбор Тогда 
		КоличествоПриИзменении();
	КонецЕсли;

КонецПроцедуры




&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользованиеХарактеристик = Константы.ИспользоватьХарактеристикиНоменклатуры.Получить(); 
	ИспользованиеСерий = Константы.ИспользоватьСерииНоменклатуры.Получить();

	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();  

	Если Параметры.Свойство("Адрес") Тогда 
		
		Партнер = Параметры.Партнер;  
		ВидЦены = Параметры.ВидЦены;    
		ИспользоватьПравилаПродажПоВидамЦен = Параметры.ИспользоватьПравилаПродажПоВидамЦен;

		СтруктураПараметров = ПолучитьИзВременногоХранилища(Параметры.Адрес);
		
		ВременнаяКорзина.Очистить();  
					
		Для Каждого Строка Из СтруктураПараметров.ВременнаяКорзина Цикл
			Номенклатура = Строка.Номенклатура;  
			
			ИспользованиеХарактеристик = Номенклатура.ВидНоменклатуры.ИспользоватьХарактеристики; 
			ИспользованиеСерий = Номенклатура.ВидНоменклатуры.ИспользоватьСерии;
			
			ВариантОбеспечения = Строка.ВариантОбеспечения; 
			Характеристика = Строка.Характеристика;    
			Упаковка = Строка.Упаковка;  
			Склад = Строка.Склад;  
			Количество = ?(Строка.Количество = 0, 1, Строка.Количество);  
			Цена = Строка.Цена;
			
			НоваяСтрока = ВременнаяКорзина.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество; 
			НоваяСтрока.Цена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика, НоваяСтрока.ВидЦены, Валюта);
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;  
			
			МегапрайсПрименитьПравилаПродажСервер(НоваяСтрока);
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц"); 
			СтруктураДействий.Вставить("ПересчитатьСумму");
			СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки", Новый Структура("Очищать", Ложь));
			СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Истина));    
			
			Попытка
				ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено); 
			Исключение
			КонецПопытки;
		КонецЦикла; 
	КонецЕсли;  
	ИтогоКоличество = ВременнаяКорзина.Итог("КоличествоУпаковок"); 
	ИтогоСумма = ВременнаяКорзина.Итог("Сумма");
	
	//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПравилаПродаж,"Партнер",Партнер,ВидСравненияКомпоновкиДанных.Равно,"Партнер" ,Истина);

КонецПроцедуры    

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ВременнаяКорзина.Количество() = 1 Тогда  
		РежимПростойПодбор = Истина;
		Элементы.ПростойПодбор.Видимость = Истина;
		Элементы.ТаблицаТоваров.Видимость = Ложь;
		Элементы.УправлениеПравилаПродаж.Видимость = Ложь; 
		Элементы.Таблицы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;   
		
		РасшифровкиПолучитьСвойстваНоменклатуры(); 
	Иначе             
		РежимПростойПодбор = Ложь;
		Элементы.ПростойПодбор.Видимость = Ложь;
		Элементы.ТаблицаТоваров.Видимость = Истина;
		Элементы.УправлениеПравилаПродаж.Видимость = Истина;   
		Элементы.Таблицы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	КонецЕсли;   
	
	ОбновитьВидимостьЭлементовФормы();
	
	ИспользованиеХарактеристикВидимость();  
	ИспользованиеСерийВидимость();   
	
	КартинкаНоменклатуры = ""; 
	КартинкаНоменклатурыДоп = "";
	Если ЗначениеЗаполнено(Номенклатура) Тогда           
		Адрес = МегапрайсРасшифровкиСервер.ПолучитьНавигационнуюСсылкуКартинки(Номенклатура,, УникальныйИдентификатор);
		КартинкаНоменклатуры = Адрес;
	Конецесли;      
	
КонецПроцедуры   

&НаСервере
Процедура РасшифровкиПолучитьСвойстваНоменклатуры()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СпрНоменклатура.Свойство КАК Свойство,
	|	СпрНоменклатура.Значение КАК Значение
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка = &ВыбНоменклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	СпрНоменклатура.Свойство.Наименование
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВыбНоменклатура", Номенклатура);    
	
	СвойстваНоменклатуры.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьВидимостьЭлементовФормы()   
	
	Элементы.ПодборСерийНоменклатурыСклад.Видимость = ?(ЗначениеЗаполнено(Склад),Ложь,Истина);  
	
КонецПроцедуры         


&НаКлиенте
Процедура ИспользованиеХарактеристикВидимость()   
	
	Элементы.ПодборХарактеристик.Видимость = ИспользованиеХарактеристик;  
	Элементы.Характеристика.Видимость = ИспользованиеХарактеристик;   
	Элементы.СписокХарактеристик.Видимость = ИспользованиеХарактеристик; 
	
	Если ИспользованиеХарактеристик Тогда
		ЗаполнитьСписокХарактеристик(Номенклатура);      
	КонецЕсли;
	
КонецПроцедуры         

&НаКлиенте
Процедура ИспользованиеСерийВидимость()   
	
	Элементы.СписокСерий.Видимость = ИспользованиеСерий;  
	
	Если ИспользованиеСерий Тогда
		ЗаполнитьСписокСерийНоменклатуры(Номенклатура);      
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СкладПриИзменении(Элемент)  
	
	ОбновитьВидимостьЭлементовФормы();
	
	ИспользованиеХарактеристикВидимость(); 
	
	Если ИспользованиеСерий Тогда
		ЗаполнитьСписокСерийНоменклатуры(Номенклатура);      
	КонецЕсли;

КонецПроцедуры






&НаКлиенте
Функция ВыгрузитьВременнуюКорзину()
		
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВременнаяКорзина",ВременнаяКорзина);

	Адрес = ПоместитьВоВременноеХранилище(СтруктураПараметров, Новый УникальныйИдентификатор);

	Возврат Адрес;
	
КонецФункции


&НаКлиенте
Процедура КоличествоПриИзменении()
	
	Для Каждого ТекущаяСтрока Из ВременнаяКорзина Цикл	
		ТекущаяСтрока.ВариантОбеспечения = ВариантОбеспечения; 
		ТекущаяСтрока.Характеристика = Характеристика;   
		ТекущаяСтрока.Серия = СерияНоменклатуры;
		ТекущаяСтрока.КоличествоУпаковок = Количество; 
		
		ТекущаяСтрока.ВидЦены = ВидЦены;   
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			ТекущаяСтрока.Цена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика, ВидЦены, Валюта);
		Иначе
			ТекущаяСтрока.Цена = Цена;
		КонецЕсли;
		
		МегапрайсПрименитьПравилаПродаж(ТекущаяСтрока);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц"); 
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Истина));
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);	
	КонецЦикла;   
	
	ИтогоКоличество = ВременнаяКорзина.Итог("КоличествоУпаковок"); 
	ИтогоСумма = ВременнаяКорзина.Итог("Сумма");
	
КонецПроцедуры   

&НаКлиенте
Процедура ЦенаПриИзменении(Элемент)  
	
	ВидЦены = ""; 
	КоличествоПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПодбор()
	
	Отказ = Ложь;
	ОчиститьСообщения();	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;   
	
	Если РежимПростойПодбор Тогда 
		КоличествоПриИзменении();
	КонецЕсли;

	Адрес = ВыгрузитьВременнуюКорзину();
	
	СтруктураПараметров = Новый Структура;     
	СтруктураПараметров.Вставить("ИспользоватьПравилаПродажПоВидамЦен", ИспользоватьПравилаПродажПоВидамЦен);     
	СтруктураПараметров.Вставить("ДобавитьЗаметку", ДобавитьЗаметку);
	СтруктураПараметров.Вставить("Адрес",Адрес);

	Закрыть(СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция МегапрайсАвтоматическиеПравилаПродажи(СтруктураПодбора)
	
	СтруктураПравилаПродаж = Новый Структура();
	НоменклатураПодбор = СтруктураПодбора.Номенклатура;
	УпаковкаПодбор = СтруктураПодбора.Упаковка.ЕдиницаИзмерения;
	Если НЕ ЗначениеЗаполнено(УпаковкаПодбор) Тогда
		УпаковкаПодбор = СтруктураПодбора.Упаковка.Ссылка;
	КонецЕсли;
	СкладПодбор = СтруктураПодбора.Склад;
	КоличествоПодбор = СтруктураПодбора.Количество;

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	мегапрайсПравилаПродажПоВидамЦен.Партнер КАК Партнер,
	|	мегапрайсПравилаПродажПоВидамЦен.Склад КАК Склад,         
	|	мегапрайсПравилаПродажПоВидамЦен.Номенклатура КАК Номенклатура,
	|	мегапрайсПравилаПродажПоВидамЦен.ВидНоменклатуры КАК ВидНоменклатуры,
	|	мегапрайсПравилаПродажПоВидамЦен.ГруппаНоменклатуры КАК ГруппаНоменклатуры,
	|	мегапрайсПравилаПродажПоВидамЦен.Производитель КАК Производитель,
	|	мегапрайсПравилаПродажПоВидамЦен.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	мегапрайсПравилаПродажПоВидамЦен.УстановитьВидЦены КАК УстановитьВидЦены,
	|	мегапрайсПравилаПродажПоВидамЦен.Количество КАК Количество,
	|	мегапрайсПравилаПродажПоВидамЦен.НаценкаСкидка КАК НаценкаСкидка,
	|	мегапрайсПравилаПродажПоВидамЦен.Приоритет КАК Приоритет
	|ИЗ
	|	РегистрСведений.мегапрайсПравилаПродажПоВидамЦен КАК мегапрайсПравилаПродажПоВидамЦен
	|{ГДЕ
	|	мегапрайсПравилаПродажПоВидамЦен.Партнер.*,
	|	мегапрайсПравилаПродажПоВидамЦен.ГруппаНоменклатуры.*,
	|	мегапрайсПравилаПродажПоВидамЦен.Производитель.*,
	|	мегапрайсПравилаПродажПоВидамЦен.ЕдиницаИзмерения.*,
	|	мегапрайсПравилаПродажПоВидамЦен.ВидНоменклатуры.*}
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Количество";	
	
	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ТекстЗапроса;							
	
	Отборы = ПостроительОтчета.Отбор;
	Если ЗначениеЗаполнено(СтруктураПодбора.Партнер) Тогда 
		Отборы.Добавить("Партнер","Партнер");
		Отборы["Партнер"].Использование = Истина;
		Отборы["Партнер"].ВидСравнения = ВидСравнения.Равно;
		Отборы["Партнер"].Значение = СтруктураПодбора.Партнер;
	КонецЕсли;
	//Если ЗначениеЗаполнено(НоменклатураПодбор.ВидНоменклатуры) Тогда 
	//	Отборы.Добавить("ВидНоменклатуры","ВидНоменклатуры");
	//	Отборы["ВидНоменклатуры"].Использование = Истина;
	//	Отборы["ВидНоменклатуры"].ВидСравнения = ВидСравнения.Равно;
	//	Отборы["ВидНоменклатуры"].Значение = НоменклатураПодбор.ВидНоменклатуры;
	//КонецЕсли;
	//Если ЗначениеЗаполнено(НоменклатураПодбор.Производитель) Тогда 
	//	Отборы.Добавить("Производитель","Производитель");
	//	Отборы["Производитель"].Использование = Истина;
	//	Отборы["Производитель"].ВидСравнения = ВидСравнения.Равно;
	//	Отборы["Производитель"].Значение = НоменклатураПодбор.Производитель;
	//КонецЕсли;
	//Если ЗначениеЗаполнено(НоменклатураПодбор.ЕдиницаИзмерения) Тогда 
	//	Отборы.Добавить("ЕдиницаИзмерения","ЕдиницаИзмерения");
	//	Отборы["ЕдиницаИзмерения"].Использование = Истина;
	//	Отборы["ЕдиницаИзмерения"].ВидСравнения = ВидСравнения.Равно;
	//	Отборы["ЕдиницаИзмерения"].Значение = НоменклатураПодбор.ЕдиницаИзмерения;
	//КонецЕсли;

	ПостроительОтчета.Выполнить();
	РезультатЗапроса = ПостроительОтчета.Результат;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаПравило = РезультатЗапроса.Выбрать();
		Пока ВыборкаПравило.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаПравило.Склад) Тогда
				Если НЕ СкладПодбор = ВыборкаПравило.Склад Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаПравило.Номенклатура) Тогда
				Если НЕ НоменклатураПодбор = ВыборкаПравило.Номенклатура Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;	  
			
			Если ЗначениеЗаполнено(ВыборкаПравило.ГруппаНоменклатуры) Тогда
				Если НоменклатураПодбор.ПринадлежитЭлементу(ВыборкаПравило.ГруппаНоменклатуры) = Ложь Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;		
			
			Если ЗначениеЗаполнено(ВыборкаПравило.Производитель) Тогда
				Если НЕ НоменклатураПодбор.Производитель = ВыборкаПравило.Производитель Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаПравило.ЕдиницаИзмерения) Тогда
				Если НЕ УпаковкаПодбор = ВыборкаПравило.ЕдиницаИзмерения Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
						
			Если ЗначениеЗаполнено(ВыборкаПравило.Количество) Тогда
				Если КоличествоПодбор < ВыборкаПравило.Количество Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтруктураПравилаПродаж.Вставить("ПравилоЦеныВидЦены",ВыборкаПравило.УстановитьВидЦены);
			СтруктураПравилаПродаж.Вставить("ПравилоЦеныНаценкаСкидка",ВыборкаПравило.НаценкаСкидка);
		КонецЦикла;	
	КонецЕсли;
	
	Возврат СтруктураПравилаПродаж;

КонецФункции

&НаКлиенте
Процедура МегапрайсПрименитьПравилаПродаж(СтрокаКорзины) Экспорт
	
	Если НЕ ИспользоватьПравилаПродажПоВидамЦен Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = СтрокаКорзины.Номенклатура;
	ХарактеристикаНоменклатуры = СтрокаКорзины.Характеристика;
	
	СтруктураПодбора = Новый Структура;                 
	СтруктураПодбора.Вставить("Партнер",Партнер);
	СтруктураПодбора.Вставить("Номенклатура",СтрокаКорзины.Номенклатура);
	СтруктураПодбора.Вставить("Упаковка",СтрокаКорзины.Упаковка);
	СтруктураПодбора.Вставить("Склад",СтрокаКорзины.Склад);
	СтруктураПодбора.Вставить("Количество",СтрокаКорзины.КоличествоУпаковок);
	СтруктураПравилаПродаж = МегапрайсАвтоматическиеПравилаПродажи(СтруктураПодбора);
	Если СтруктураПравилаПродаж.Количество() > 0 Тогда
		СтрокаКорзины.ВидЦены = СтруктураПравилаПродаж.ПравилоЦеныВидЦены;		
		СтрокаКорзины.Цена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(СтрокаКорзины.Номенклатура, СтрокаКорзины.Характеристика, СтрокаКорзины.ВидЦены, Валюта);
		
		Если СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка > 0 Тогда 
			НоваяЦенаПродажи = СтрокаКорзины.Цена * (1 + СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка/100);
			СтрокаКорзины.Цена = НоваяЦенаПродажи;
		Иначе
			СтрокаКорзины.ПроцентРучнойСкидки = - СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура МегапрайсПрименитьПравилаПродажСервер(СтрокаКорзины) Экспорт
	
	Если НЕ ИспользоватьПравилаПродажПоВидамЦен Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = СтрокаКорзины.Номенклатура;
	ХарактеристикаНоменклатуры = СтрокаКорзины.Характеристика;
	
	СтруктураПодбора = Новый Структура;                 
	СтруктураПодбора.Вставить("Партнер",Партнер);
	СтруктураПодбора.Вставить("Номенклатура",СтрокаКорзины.Номенклатура);
	СтруктураПодбора.Вставить("Упаковка",СтрокаКорзины.Упаковка);
	СтруктураПодбора.Вставить("Склад",СтрокаКорзины.Склад);
	СтруктураПодбора.Вставить("Количество",СтрокаКорзины.КоличествоУпаковок);
	СтруктураПравилаПродаж = МегапрайсАвтоматическиеПравилаПродажи(СтруктураПодбора);
	Если СтруктураПравилаПродаж.Количество() > 0 Тогда
		СтрокаКорзины.ВидЦены = СтруктураПравилаПродаж.ПравилоЦеныВидЦены;		
		СтрокаКорзины.Цена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(СтрокаКорзины.Номенклатура, СтрокаКорзины.Характеристика, СтрокаКорзины.ВидЦены, Валюта);
		
		Если СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка > 0 Тогда 
			НоваяЦенаПродажи = СтрокаКорзины.Цена * (1 + СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка/100);
			СтрокаКорзины.Цена = НоваяЦенаПродажи;
		Иначе
			СтрокаКорзины.ПроцентРучнойСкидки = - СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 



&НаКлиенте
Процедура ВременнаяКорзинаУпаковкаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ВременнаяКорзина.ТекущиеДанные;
	
	МегапрайсПрименитьПравилаПродаж(ТекущаяСтрока);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	//СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);
	
	ТекущаяСтрока = Элементы.ВременнаяКорзина.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	
	Если ТекущаяСтрока.Количество > 0 Тогда
		СтруктураДействий.Вставить("ПересчитатьЦенуЗаУпаковку", ТекущаяСтрока.Количество);
	ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.ВидЦены) Тогда	
		СтруктураЗаполненияЦены = Новый Структура;
		СтруктураЗаполненияЦены.Вставить("Дата",   ТекущаяДата());
		СтруктураЗаполненияЦены.Вставить("Валюта", Валюта);
		
		СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", СтруктураЗаполненияЦены);
	КонецЕсли;
	
	СтруктураДействий.Вставить("ПересчитатьСумму");
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);   
	
