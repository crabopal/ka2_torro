&НаСервере
Процедура ИзменитьОписаниеНаСервере(СтруктураПараметров)
	
	
	СписокНоменклатуры = СтруктураПараметров.СписокНоменклатуры;
	
	Для Каждого ВыборкаНоменклатура Из СписокНоменклатуры Цикл
		НоменклатураОбъект = ВыборкаНоменклатура.ПолучитьОбъект();
		НоменклатураОбъект.Описание = ОписаниеНоменклатуры;
		НоменклатураОбъект.Записать();  
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОписаниеНоменклатурыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПодборТаблицаНоменклатура.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда	
		Возврат;
	КонецЕсли;	

	СписокНоменклатуры = Новый СписокЗначений;
	Для Каждого СтрВыд Из Элементы.ПодборТаблицаНоменклатура.ВыделенныеСтроки Цикл 
		ДанныеСтроки = Элементы.ПодборТаблицаНоменклатура.ДанныеСтроки(СтрВыд);	 
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокНоменклатуры.Добавить(ДанныеСтроки.Ссылка);
	КонецЦикла;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокНоменклатуры",СписокНоменклатуры.ВыгрузитьЗначения());

	ИзменитьОписаниеНаСервере(СтруктураПараметров);

КонецПроцедуры


&НаКлиенте
Процедура ПоказатьВсеКартинкиТекущегоТовара(ТекущиеДанные)
	
	Для Ном = 1 По 5 Цикл
		ИмяРеквизита = "КартинкаТовара"+Ном;		
		ЭтотОбъект[ИмяРеквизита] = ""; 
		Элементы.Найти(ИмяРеквизита).Видимость = Ложь;
	КонецЦикла;

	МассивКартинок = МегапрайсРасшифровкиСервер.ПолучитьВсеКартинкиТекущегоТовараСервер(ТекущиеДанные);
	
	НомерКартинки = 0;
	Для Каждого ВыборкаКартинка Из МассивКартинок Цикл		
		НомерКартинки = НомерКартинки + 1;
		ИмяРеквизита = "КартинкаТовара"+НомерКартинки;		
		ЭтотОбъект[ИмяРеквизита] = МегапрайсРасшифровкиСервер.ПолучитьНавигационнуюСсылкуКартинки(,ВыборкаКартинка, УникальныйИдентификатор);
		Элементы.Найти(ИмяРеквизита).Видимость = Истина;
		
		Если НомерКартинки = 5 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;		
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкиПолучитьКартинкуНоменклатуры(ВыбНоменклатура)
	
	КартинкаНоменклатуры = ""; 
	КартинкаНоменклатурыДоп = "";
	
	Если НЕ ИспользоватьНавигацию Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПодборТекущаяНоменклатура) Тогда           
		Адрес = МегапрайсРасшифровкиСервер.ПолучитьНавигационнуюСсылкуКартинки(ПодборТекущаяНоменклатура,, УникальныйИдентификатор);
		КартинкаНоменклатуры = Адрес;
	Конецесли;       
	
	ВидимостьКартинкиДоп = ЗначениеЗаполнено(ВыбНоменклатура); 
	
	Если ПодборТекущаяНоменклатура = ВыбНоменклатура Тогда  
		ВидимостьКартинкиДоп = Ложь;
	КонецЕсли;
	
	Если ВидимостьКартинкиДоп Тогда 		
		Адрес = МегапрайсРасшифровкиСервер.ПолучитьНавигационнуюСсылкуКартинки(ВыбНоменклатура,, УникальныйИдентификатор);
		КартинкаНоменклатурыДоп = Адрес;
	Конецесли;
	
	Элементы.КартинкаНоменклатурыДоп.Видимость = ВидимостьКартинкиДоп;
	
КонецПроцедуры




