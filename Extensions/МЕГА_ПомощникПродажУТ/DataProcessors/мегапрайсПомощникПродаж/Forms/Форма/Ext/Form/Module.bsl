&НаКлиенте
Процедура СформироватьОтчетПоЦенам()
	
	Если СписокОтборНоменклатуры.Количество() = 0 Тогда                 
		Возврат;
	КонецЕсли;    
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса = ПолучитьПараметрыДетальногоЗапроса(ПараметрыЗапроса);
	МегапрайсРасшифровкиСервер.СформироватьОтчетПоЦенам(ТаблицаЦеныНоменклатуры,ПараметрыЗапроса);  
	
КонецПроцедуры


&НаКлиенте
Процедура Расшифровки_Настройка(Команда)

	ОписаниеОповещение = Новый ОписаниеОповещения("Расшифровки_Настройка_Завершение", ЭтаФорма);  
	
	ПараметрыФормы = Новый Структура(); 		        
	ПараметрыФормы.Вставить("НачалоПериода", Объект.НачалоПериода);   
	ПараметрыФормы.Вставить("КонецПериода", Объект.КонецПериода);   
	
	ПараметрыФормы.Вставить("ПоказатьРасшифровки", ПоказатьРасшифровки);       
	
	ПараметрыФормы.Вставить("ОтчетБуфер1", ОтчетБуфер1);      
	ПараметрыФормы.Вставить("ОтчетБуфер2", ОтчетБуфер2);  
	ПараметрыФормы.Вставить("ОтчетБуфер3", ОтчетБуфер3);    
	
	ПараметрыФормы.Вставить("ОтчетБуферНазвание1", ОтчетБуферНазвание1);      
	ПараметрыФормы.Вставить("ОтчетБуферНазвание2", ОтчетБуферНазвание2);  
	ПараметрыФормы.Вставить("ОтчетБуферНазвание3", ОтчетБуферНазвание3); 

	ОткрытьФорму("Обработка.мегапрайсПомощникПродаж.Форма.ФормаНастройкаРасшифровки",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОповещение);   

КонецПроцедуры

&НаКлиенте
Процедура Расшифровки_Настройка_Завершение(РезультатЗакрытия,Параметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Объект.НачалоПериода = РезультатЗакрытия.НачалоПериода; 
	Объект.КонецПериода = РезультатЗакрытия.КонецПериода; 
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда 
		Объект.НачалоПериода = НачалоГода(ТекущаяДата());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.КонецПериода) Тогда 
		Объект.КонецПериода = КонецДня(ТекущаяДата());
	КонецЕсли;

	ПоказатьРасшифровки = РезультатЗакрытия.ПоказатьРасшифровки;     
	
	ОтчетБуфер1 = РезультатЗакрытия.ОтчетБуфер1;     
	ОтчетБуфер2 = РезультатЗакрытия.ОтчетБуфер2; 
	ОтчетБуфер3 = РезультатЗакрытия.ОтчетБуфер3;     
	
	ОтчетБуферНазвание1 = РезультатЗакрытия.ОтчетБуферНазвание1;     
	ОтчетБуферНазвание2 = РезультатЗакрытия.ОтчетБуферНазвание2; 
	ОтчетБуферНазвание3 = РезультатЗакрытия.ОтчетБуферНазвание3; 
	
	УстановитьВидимостьЭлементовФормы(); 
	
	ПанельВнизу_ОбновитьДанные();
		
КонецПроцедуры 






