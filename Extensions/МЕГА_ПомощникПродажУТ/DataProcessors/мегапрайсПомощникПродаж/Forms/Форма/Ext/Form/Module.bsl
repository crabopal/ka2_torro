&НаКлиенте
Процедура ПоискВставка(Команда)
	
	СтруктураПараметров = Новый Структура;	
	ОписаниеОповещение = Новый ОписаниеОповещения("ПоискВставка_Результат", ЭтаФорма, СтруктураПараметров);
	
	Попытка
		ОткрытьФорму("Обработка.мегапрайсПомощникПродаж.Форма.ФормаЗагрузкаБуфер",СтруктураПараметров,ЭтаФорма,,,,ОписаниеОповещение); 
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
		
КонецПроцедуры   

&НаСервере
Процедура ПоискВставка_Результат(РезультатЗакрытия,Параметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокПоискНоменклатуры.Очистить(); 
	
	СтруктураВозврата = ПолучитьИзВременногоХранилища(РезультатЗакрытия); 	
	УдалитьИзВременногоХранилища(РезультатЗакрытия);
	ТаблицаБуфер = СтруктураВозврата.ТаблицаБуфер;  
	
	Для НомерСтроки = 1 По ТаблицаБуфер.ВысотаТаблицы Цикл	
		
		НомерСтрокиЧГ = Формат(НомерСтроки,"ЧГ=");
		
		Для ИндексКолонки = 1 По ТаблицаБуфер.ШиринаТаблицы Цикл    
			
			ОбластьЗначения = ТаблицаБуфер.Область(НомерСтрокиЧГ,ИндексКолонки,НомерСтрокиЧГ,ИндексКолонки);
			ТекстСодержание = ОбластьЗначения.Текст;   
			
			Если НЕ ЗначениеЗаполнено(ТекстСодержание) Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос();
			Запрос.Текст = 
			"ВЫБРАТЬ 
			|	СпрНоменклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК СпрНоменклатура
			|ГДЕ
			|	СпрНоменклатура.Артикул = &Поле_Артикул
			|	И СпрНоменклатура.ЭтоГруппа = ЛОЖЬ
			|	И СпрНоменклатура.ПометкаУдаления = ЛОЖЬ";
			
			Запрос.УстановитьПараметр("Поле_Артикул", ТекстСодержание);
			РезультатЗапроса = Запрос.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Пока Выборка.Следующий() Цикл         
					СписокПоискНоменклатуры.Добавить(Выборка.Ссылка);				
				КонецЦикла;
			КонецЕсли;   	

			
			
			ТекстСодержание = СтрЗаменить(ТекстСодержание, Символы.ВК + Символы.ПС," ");
			ТекстСодержание = СтрЗаменить(ТекстСодержание, Символы.ПС, " "); 
			ТекстСодержание = СтрЗаменить(ТекстСодержание, "  ", " ");
			ТекстСодержание = СтрЗаменить(ТекстСодержание, ",", " ");   
			ТекстСодержание = СтрЗаменить(ТекстСодержание, ",", " ");
			
			МассивСлов = СтрРазделить(ТекстСодержание," ");		
			Для Каждого ВыборкаЗначение Из МассивСлов Цикл   
				Если НЕ ЗначениеЗаполнено(ВыборкаЗначение) Тогда
					Продолжить;
				КонецЕсли;
				
				Запрос = Новый Запрос();
				Запрос.Текст = 
				"ВЫБРАТЬ 
				|	СпрНоменклатура.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Номенклатура КАК СпрНоменклатура
				|ГДЕ
				|	СпрНоменклатура.Артикул = &Поле_Артикул
				|	И СпрНоменклатура.ЭтоГруппа = ЛОЖЬ
				|	И СпрНоменклатура.ПометкаУдаления = ЛОЖЬ";
				
				Запрос.УстановитьПараметр("Поле_Артикул", ТекстСодержание);
				РезультатЗапроса = Запрос.Выполнить();
				
				Если НЕ РезультатЗапроса.Пустой() Тогда
					Выборка = РезультатЗапроса.Выбрать();
					Пока Выборка.Следующий() Цикл         
						СписокПоискНоменклатуры.Добавить(Выборка.Ссылка);
					КонецЦикла;
				КонецЕсли;   					
			КонецЦикла;	  

			
		КонецЦикла;
		
	КонецЦикла;   
	
	Если СписокПоискНоменклатуры.Количество() > 0 Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Ссылка",СписокПоискНоменклатуры,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	Иначе              
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Ссылка",Неопределено,ВидСравненияКомпоновкиДанных.Равно,,Ложь);
	КонецЕсли;

КонецПроцедуры   








РезультатПоиска = Истина;
	
Подсветка_КешСтрок = Новый Соответствие;



ВыполняетсяЗакрытие = Ложь;






































