&НаКлиенте
Процедура ТаблицаПодборПоСкладамОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	
	//------------------------------------------------------------------------
	
	ТекущаяОбласть = ТаблицаПодборПоСкладам.ТекущаяОбласть;
	ИмяОбласти = ТекущаяОбласть.Имя;
		
	//Сообщить(ИмяОбласти);
	
	Если ИмяОбласти = "T" Тогда  
		ИмяОбласти = "R1C1:R"+ТаблицаПодборПоСкладам.ВысотаТаблицы+"С"+ТаблицаПодборПоСкладам.ШиринаТаблицы;
	КонецЕсли;
	
	Разделитель = Найти(ИмяОбласти,":");  
	НомерНачСтолбца = 0;  
	НомерНачСтроки = 0; 
	НомерКонСтолбца = 0; 
	НомерКонСтроки = 0;
		  
	Если Разделитель = 0 Тогда 
		НомерНачСтолбца = Сред(ИмяОбласти,Найти(ИмяОбласти,"C")+1);  
		НомерНачСтроки = Сред(ИмяОбласти,Найти(ИмяОбласти,"R")+1,Найти(ИмяОбласти,"C")-Найти(ИмяОбласти,"R")-1); 
		НомерКонСтолбца = 0; 
		НомерКонСтроки = 0;
	Иначе     
		ОбластьНачало = Лев(ИмяОбласти,Разделитель-1);
		НомерНачСтолбца = Сред(ОбластьНачало,Найти(ОбластьНачало,"C")+1);  
		НомерНачСтроки = Сред(ОбластьНачало,Найти(ОбластьНачало,"R")+1,Найти(ОбластьНачало,"C")-Найти(ОбластьНачало,"R")-1); 
		
		ОбластьКонец = Сред(ИмяОбласти,Разделитель+1);	
		НомерКонСтолбца = Сред(ОбластьКонец,Найти(ОбластьКонец,"C")+1);  
		НомерКонСтроки = Сред(ОбластьКонец,Найти(ОбластьКонец,"R")+1,Найти(ОбластьКонец,"C")-Найти(ОбластьКонец,"R")-1); 
	КонецЕсли;    
	
	//Сообщить(ИмяОбласти+"  / Столбцы "+НомерНачСтолбца+"-"+НомерКонСтолбца+"  / Строки "+НомерНачСтроки+"-"+НомерКонСтроки); 
	
	Попытка
		НомерНачСтроки = Число(НомерНачСтроки);  
	Исключение 
		НомерНачСтроки = 1;
	КонецПопытки;  
	Попытка
		НомерКонСтроки = Число(НомерКонСтроки);  
	Исключение    
		НомерКонСтроки = ТаблицаПодборПоСкладам.ВысотаТаблицы;  
	КонецПопытки;
	Попытка
		НомерНачКолонки = Число(НомерНачСтолбца);   
	Исключение  
		НомерНачКолонки = 4;
	КонецПопытки;
	Попытка
		НомерКонКолонки = Число(НомерКонСтолбца);
	Исключение  
		НомерКонКолонки = ТаблицаПодборПоСкладам.ШиринаТаблицы;
	КонецПопытки; 
	
	//------------------------------------------------------------------------
		
	ВременнаяКорзина.Очистить();

	Если Разделитель = 0 Тогда     
		
		ОбластьВыборки = ТаблицаПодборПоСкладам.Область("R"+НомерНачСтроки+"C2");
		ЗначениеНоменклатуры = ОбластьВыборки.Расшифровка;  
		ОбластьВыборки = ТаблицаПодборПоСкладам.Область("R"+НомерНачСтроки+"C3");
		ХарактеристикаНоменклатуры = ОбластьВыборки.Расшифровка;    
		ОбластьШапки = ТаблицаПодборПоСкладам.Область("R1"+"C"+НомерНачКолонки); 
		ЗначениеСклада = ОбластьШапки.Расшифровка;  
		
		ЗначениеЗаголовкаШапки = ТаблицаПодборПоСкладам.Область("R2"+"C"+НомерНачКолонки).Текст;
		Если ЗначениеЗаголовкаШапки = "Заказано" Тогда                    
			ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления"); 
		ИначеЕсли ЗначениеЗаголовкаШапки = "Поступит" Тогда                    
			ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления");	
		Иначе	
			ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
		КонецЕсли;      
		
		ОбластьВыборки = ТаблицаПодборПоСкладам.Область("R"+НомерНачСтроки+"C"+НомерНачКолонки); 
		ЗначениеКоличества = 0;
		Попытка                    
			ЗначениеКоличества = Число(ОбластьВыборки.Значение); 
		Исключение
		КонецПопытки;
		
		Если ЗначениеКоличества = 0 Тогда
			ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.КОбеспечению");
		КонецЕсли;

		НоваяСтрока = ВременнаяКорзина.Добавить();  
		НоваяСтрока.ВариантОбеспечения = ВариантОбеспечения;
		НоваяСтрока.Номенклатура = ЗначениеНоменклатуры;
		НоваяСтрока.Характеристика = ХарактеристикаНоменклатуры;
		//НоваяСтрока.Упаковка = ПодборТекущаяУпаковка;
		НоваяСтрока.Склад = ЗначениеСклада;
		НоваяСтрока.Количество = ЗначениеКоличества;
		НоваяСтрока.ВидЦены = Объект.ВидЦен;
		НоваяСтрока.Цена = 0;
		НоваяСтрока.ДатаОтгрузки = ТекущаяДата();
		
	Иначе       
		Для Ном = НомерНачСтроки По НомерКонСтроки Цикл  
			ОбластьВыборки = ТаблицаПодборПоСкладам.Область("R"+Ном+"C2");
			ЗначениеНоменклатуры = ОбластьВыборки.Расшифровка; 
			ОбластьВыборки = ТаблицаПодборПоСкладам.Область("R"+Ном+"C3");
			ХарактеристикаНоменклатуры = ОбластьВыборки.Расшифровка;   
						
			Для НомКолонки = НомерНачКолонки По НомерКонКолонки Цикл   
				
				ОбластьШапки = ТаблицаПодборПоСкладам.Область("R1"+"C"+НомКолонки); 
				ЗначениеСклада = ОбластьШапки.Расшифровка;   
				
				ЗначениеЗаголовкаШапки = ТаблицаПодборПоСкладам.Область("R2"+"C"+НомерНачКолонки).Текст; 
				Если ЗначениеЗаголовкаШапки = "Заказано" Тогда                    
					ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления"); 
				ИначеЕсли ЗначениеЗаголовкаШапки = "Поступит" Тогда                    
					ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления");	
				Иначе	
					ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
				КонецЕсли;     

				ОбластьВыборки = ТаблицаПодборПоСкладам.Область("R"+Ном+"C"+НомКолонки); 
				ЗначениеКоличества = 0;
				Попытка                    
					ЗначениеКоличества = Число(ОбластьВыборки.Значение); 
				Исключение
				КонецПопытки;
				
				Если ЗначениеКоличества = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ВременнаяКорзина.Добавить();  
				НоваяСтрока.ВариантОбеспечения = ВариантОбеспечения;
				НоваяСтрока.Номенклатура = ЗначениеНоменклатуры;
				НоваяСтрока.Характеристика = ХарактеристикаНоменклатуры;
				//НоваяСтрока.Упаковка = ПодборТекущаяУпаковка;
				НоваяСтрока.Склад = ЗначениеСклада;
				НоваяСтрока.Количество = ЗначениеКоличества;
				НоваяСтрока.ВидЦены = Объект.ВидЦен;
				НоваяСтрока.Цена = 0;
				НоваяСтрока.ДатаОтгрузки = ТекущаяДата();    
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;   
			
				
		
	ОткрытьФормуВременнойКорзины();	
	
КонецПроцедуры

&НаКлиенте
