//============================================================================
// ЦЕНЫ НОМЕНКЛАТУРЫ

&НаСервереБезКонтекста
Функция МегапрайсАвтоматическиеПравилаПродажи(СтруктураПодбора)
	
	СтруктураПравилаПродаж = Новый Структура();  
	
	НоменклатураПодбор = СтруктураПодбора.Номенклатура;
	УпаковкаПодбор = СтруктураПодбора.Упаковка.ЕдиницаИзмерения;
	Если НЕ ЗначениеЗаполнено(УпаковкаПодбор) Тогда
		УпаковкаПодбор = СтруктураПодбора.Упаковка.Ссылка;
	КонецЕсли;
	СкладПодбор = СтруктураПодбора.Склад;
	КоличествоПодбор = СтруктураПодбора.Количество;

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	мегапрайсПравилаПродаж.Партнер КАК Партнер,
	|	мегапрайсПравилаПродаж.Склад КАК Склад,
	|	мегапрайсПравилаПродаж.ВидНоменклатуры КАК ВидНоменклатуры,
	|	мегапрайсПравилаПродаж.ГруппаНоменклатуры КАК ГруппаНоменклатуры,
	|	мегапрайсПравилаПродаж.Производитель КАК Производитель,
	|	мегапрайсПравилаПродаж.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	мегапрайсПравилаПродаж.УстановитьВидЦены КАК УстановитьВидЦены,
	|	мегапрайсПравилаПродаж.Количество КАК Количество,
	|	мегапрайсПравилаПродаж.НаценкаСкидка КАК НаценкаСкидка,
	|	мегапрайсПравилаПродаж.Приоритет КАК Приоритет,
	|	мегапрайсПравилаПродаж.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.мегапрайсПравилаПродажПоВидамЦен КАК мегапрайсПравилаПродаж
	|{ГДЕ
	|	мегапрайсПравилаПродаж.Партнер.*,
	|	мегапрайсПравилаПродаж.ГруппаНоменклатуры.*,
	|	мегапрайсПравилаПродаж.Производитель.*,
	|	мегапрайсПравилаПродаж.ЕдиницаИзмерения.*,
	|	мегапрайсПравилаПродаж.ВидНоменклатуры.*}
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Количество";	
	
	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ТекстЗапроса;							
	
	Отборы = ПостроительОтчета.Отбор;
	Если ЗначениеЗаполнено(СтруктураПодбора.Партнер) Тогда 
		Отборы.Добавить("Партнер","Партнер");
		Отборы["Партнер"].Использование = Истина;
		Отборы["Партнер"].ВидСравнения = ВидСравнения.Равно;
		Отборы["Партнер"].Значение = СтруктураПодбора.Партнер;
	КонецЕсли;
	//Если ЗначениеЗаполнено(НоменклатураПодбор.ВидНоменклатуры) Тогда 
	//	Отборы.Добавить("ВидНоменклатуры","ВидНоменклатуры");
	//	Отборы["ВидНоменклатуры"].Использование = Истина;
	//	Отборы["ВидНоменклатуры"].ВидСравнения = ВидСравнения.Равно;
	//	Отборы["ВидНоменклатуры"].Значение = НоменклатураПодбор.ВидНоменклатуры;
	//КонецЕсли;
	//Если ЗначениеЗаполнено(НоменклатураПодбор.Производитель) Тогда 
	//	Отборы.Добавить("Производитель","Производитель");
	//	Отборы["Производитель"].Использование = Истина;
	//	Отборы["Производитель"].ВидСравнения = ВидСравнения.Равно;
	//	Отборы["Производитель"].Значение = НоменклатураПодбор.Производитель;
	//КонецЕсли;
	//Если ЗначениеЗаполнено(НоменклатураПодбор.ЕдиницаИзмерения) Тогда 
	//	Отборы.Добавить("ЕдиницаИзмерения","ЕдиницаИзмерения");
	//	Отборы["ЕдиницаИзмерения"].Использование = Истина;
	//	Отборы["ЕдиницаИзмерения"].ВидСравнения = ВидСравнения.Равно;
	//	Отборы["ЕдиницаИзмерения"].Значение = НоменклатураПодбор.ЕдиницаИзмерения;
	//КонецЕсли;

	ПостроительОтчета.Выполнить();
	РезультатЗапроса = ПостроительОтчета.Результат;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаПравило = РезультатЗапроса.Выбрать();
		Пока ВыборкаПравило.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаПравило.Склад) Тогда
				Если НЕ СкладПодбор = ВыборкаПравило.Склад Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаПравило.Номенклатура) Тогда
				Если НЕ НоменклатураПодбор = ВыборкаПравило.Номенклатура Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаПравило.ГруппаНоменклатуры) Тогда
				Если НоменклатураПодбор.ПринадлежитЭлементу(ВыборкаПравило.ГруппаНоменклатуры) = Ложь Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;		
			
			Если ЗначениеЗаполнено(ВыборкаПравило.Производитель) Тогда
				Если НЕ НоменклатураПодбор.Производитель = ВыборкаПравило.Производитель Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаПравило.ЕдиницаИзмерения) Тогда
				Если НЕ УпаковкаПодбор = ВыборкаПравило.ЕдиницаИзмерения Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
						
			Если ЗначениеЗаполнено(ВыборкаПравило.Количество) Тогда
				Если КоличествоПодбор < ВыборкаПравило.Количество Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтруктураПравилаПродаж.Вставить("ПравилоЦеныВидЦены",ВыборкаПравило.УстановитьВидЦены);
			СтруктураПравилаПродаж.Вставить("ПравилоЦеныНаценкаСкидка",ВыборкаПравило.НаценкаСкидка);
		КонецЦикла;	
	КонецЕсли;
	
	Возврат СтруктураПравилаПродаж;

КонецФункции

&НаКлиенте
Процедура МегапрайсПрименитьПравилаПродаж(СтрокаКорзины) Экспорт
	
	Если НЕ Объект.ИспользоватьПравилаПродажПоВидамЦен Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатура = СтрокаКорзины.Номенклатура;
	ХарактеристикаНоменклатуры = СтрокаКорзины.Характеристика;
	
	Если Объект.ИспользоватьПравилаПродажПоВидамЦен Тогда
		СтруктураПодбора = Новый Структура;                 
		СтруктураПодбора.Вставить("Партнер",Объект.Партнер);
		СтруктураПодбора.Вставить("Номенклатура",СтрокаКорзины.Номенклатура);
		СтруктураПодбора.Вставить("Упаковка",СтрокаКорзины.Упаковка);
		СтруктураПодбора.Вставить("Склад",СтрокаКорзины.Склад);
		СтруктураПодбора.Вставить("Количество",СтрокаКорзины.КоличествоУпаковок);
		СтруктураПравилаПродаж = МегапрайсАвтоматическиеПравилаПродажи(СтруктураПодбора);  
		
		Если СтруктураПравилаПродаж.Количество() > 0 Тогда
			СтрокаКорзины.ВидЦены = СтруктураПравилаПродаж.ПравилоЦеныВидЦены;		
			СтрокаКорзины.Цена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(СтрокаКорзины.Номенклатура, СтрокаКорзины.Характеристика, СтрокаКорзины.ВидЦены, Объект.Валюта);
			
			Если СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка > 0 Тогда 
				НоваяЦенаПродажи = СтрокаКорзины.Цена * (1 + СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка/100);
				СтрокаКорзины.Цена = НоваяЦенаПродажи;
			Иначе
				СтрокаКорзины.ПроцентРучнойСкидки = - СтруктураПравилаПродаж.ПравилоЦеныНаценкаСкидка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 
 






&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, Объект)
	
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВПродажахВТЧ(Объект);	
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	//СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
	
	СтруктураДействий.Вставить("ЗаполнитьВесУпаковки",Новый Структура("Номенклатура, Упаковка", "ВесУпаковки"));
	СтруктураДействий.Вставить("ЗаполнитьОбъемУпаковки",Новый Структура("Номенклатура, Упаковка", "ОбъемУпаковки"));
	СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияВеса",Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияВеса"));
	СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияОбъема",Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияОбъема"));
	СтруктураДействий.Вставить("ПересчитатьВесОбъем");
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборТаблицаНоменклатураВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
				
	СтандартнаяОбработка = Ложь;      
	
	Если Поле = Элементы.ПодборТаблицаЕстьАналоги Тогда 
		РедакторАналоговНоменклатуры();
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ПодборТаблицаДатаВвода Тогда  
		Попытка
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Номенклатура",  ПодборТекущаяНоменклатура);
			ОткрытьФорму("Обработка.мегапрайсРедакторНоменклатуры.Форма.ФормаЭлемента",СтруктураПараметров); 
		Исключение
			ФормаДока = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Новый Структура("Ключ", ПодборТекущаяНоменклатура)); 
			ФормаДока.Открыть();
		КонецПопытки;	  
		Возврат;
	КонецЕсли;      
	
	Если Поле = Элементы.ПодборТаблицаЗаказаноОстаток ИЛИ Поле = Элементы.ПодборТаблицаПоступитОстаток 
		ИЛИ Поле = Элементы.ПодборТаблицаРезервПриход Тогда  
		ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.РезервироватьПоМереПоступления");  
	ИначеЕсли Поле = Элементы.ПодборТаблицаКОбеспечениюОстаток ИЛИ Поле = Элементы.ПодборТаблицаМегапрайсОстатки Тогда  
		ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.КОбеспечению");		
	Иначе
		ВариантОбеспечения = Объект.ВариантОбеспечения; //ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
	КонецЕсли;
		
	ВременнаяКорзина.Очистить();
	
	ТекущиеДанныеНоменклатура = Элементы.ПодборТаблицаНоменклатура.ТекущиеДанные;	
	Если ТекущиеДанныеНоменклатура = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	ПодборОстаткиПоСкладуПодбора = ТекущиеДанныеНоменклатура.Свободно;

	ВыделенныеСтроки = Элементы.ПодборТаблицаНоменклатура.ВыделенныеСтроки;	
	Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
		ДанныеСтроки = Элементы.ПодборТаблицаНоменклатура.ДанныеСтроки(СтрВыд);	  
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;     
		ВыбНоменклатура = ДанныеСтроки.Ссылка;
		ВыбХарактеристика = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		ВыбУпаковка = ДанныеСтроки.ЕдиницаИзмерения;  
		ВыбСклад = Объект.Склад;  
		
		ВыбКоличество = 1;
		//Если Поле = Элементы.ПодборТаблицаПоступитОстаток ИЛИ Поле = Элементы.ПодборТаблицаРезервПриход Тогда  
		//	ВыбКоличество = ДанныеСтроки.ПоступитОстаток;  
		//ИначеЕсли Поле = Элементы.ПодборТаблицаКОбеспечениюОстаток ИЛИ Поле = Элементы.ПодборТаблицаМегапрайсОстатки Тогда  
		//	ВыбКоличество = ДанныеСтроки.ОстаткиПоставщиков;		
		//ИначеЕсли Поле = Элементы.ПодборТаблицаСвободно Тогда
		//	ВыбКоличество = ДанныеСтроки.Свободно;
		//КонецЕсли;

		НоваяСтрока = ВременнаяКорзина.Добавить();     
		НоваяСтрока.ВариантОбеспечения = ВариантОбеспечения;
		НоваяСтрока.Номенклатура = ВыбНоменклатура;
		НоваяСтрока.Характеристика = ВыбХарактеристика;
		НоваяСтрока.Упаковка = ВыбУпаковка;
		НоваяСтрока.Склад = ВыбСклад;
		НоваяСтрока.Количество = ВыбКоличество;
		НоваяСтрока.ВидЦены = Объект.ВидЦен;
		НоваяСтрока.Цена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика, Объект.ВидЦен, Объект.Валюта);
		НоваяСтрока.ДатаОтгрузки = ТекущаяДата();
	КонецЦикла; 
				
	ОткрытьФормуВременнойКорзины();
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДетальныйПодборОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)    
	
	СтандартнаяОбработка = Ложь;  
	
	//------------------------------------------------------------------------
	
	ТекущаяОбласть = ТаблицаДетальныйПодбор.ТекущаяОбласть;
	ИмяОбласти = ТекущаяОбласть.Имя;
		
	//Сообщить(ИмяОбласти);
	
	Если ИмяОбласти = "T" Тогда  
		ИмяОбласти = "R1C1:R"+ТаблицаДетальныйПодбор.ВысотаТаблицы+"С"+ТаблицаПодборПоСкладам.ШиринаТаблицы;
	КонецЕсли;
	
	Разделитель = Найти(ИмяОбласти,":");  
	НомерНачСтолбца = 0;  
	НомерНачСтроки = 0; 
	НомерКонСтолбца = 0; 
	НомерКонСтроки = 0;
		  
	Если Разделитель = 0 Тогда 
		НомерНачСтолбца = Сред(ИмяОбласти,Найти(ИмяОбласти,"C")+1);  
		НомерНачСтроки = Сред(ИмяОбласти,Найти(ИмяОбласти,"R")+1,Найти(ИмяОбласти,"C")-Найти(ИмяОбласти,"R")-1); 
		НомерКонСтолбца = 0; 
		НомерКонСтроки = 0;
	Иначе     
		ОбластьНачало = Лев(ИмяОбласти,Разделитель-1);
		НомерНачСтолбца = Сред(ОбластьНачало,Найти(ОбластьНачало,"C")+1);  
		НомерНачСтроки = Сред(ОбластьНачало,Найти(ОбластьНачало,"R")+1,Найти(ОбластьНачало,"C")-Найти(ОбластьНачало,"R")-1); 
		
		ОбластьКонец = Сред(ИмяОбласти,Разделитель+1);	
		НомерКонСтолбца = Сред(ОбластьКонец,Найти(ОбластьКонец,"C")+1);  
		НомерКонСтроки = Сред(ОбластьКонец,Найти(ОбластьКонец,"R")+1,Найти(ОбластьКонец,"C")-Найти(ОбластьКонец,"R")-1); 
	КонецЕсли;    
	
	//Сообщить(ИмяОбласти+"  / Столбцы "+НомерНачСтолбца+"-"+НомерКонСтолбца+"  / Строки "+НомерНачСтроки+"-"+НомерКонСтроки); 
	
	Попытка
		НомерНачСтроки = Число(НомерНачСтроки);  
	Исключение 
		НомерНачСтроки = 1;
	КонецПопытки;  
	Попытка
		НомерКонСтроки = Число(НомерКонСтроки);  
	Исключение    
		НомерКонСтроки = ТаблицаДетальныйПодбор.ВысотаТаблицы;  
	КонецПопытки;
	Попытка
		НомерНачКолонки = Число(НомерНачСтолбца);   
	Исключение  
		НомерНачКолонки = 5;
	КонецПопытки;
	Попытка
		НомерКонКолонки = Число(НомерКонСтолбца);
	Исключение  
		НомерКонКолонки = ТаблицаДетальныйПодбор.ШиринаТаблицы;
	КонецПопытки; 
	
	//------------------------------------------------------------------------
		
	ВременнаяКорзина.Очистить();

	Если Разделитель = 0 Тогда  
		ОбластьВыборки = ТаблицаДетальныйПодбор.Область("R"+НомерНачСтроки+"C1");
		ЗначениеНоменклатуры = ОбластьВыборки.Расшифровка;    
		
		ОбластьВыборки = ТаблицаДетальныйПодбор.Область("R"+НомерНачСтроки+"C3");
		ХарактеристикаНоменклатуры = ОбластьВыборки.Расшифровка; 
		
		ОбластьВыборки = ТаблицаДетальныйПодбор.Область("R"+НомерНачСтроки+"C2"); 
		ЗначениеСклада = ОбластьВыборки.Расшифровка; 
		
		НоваяСтрока = ВременнаяКорзина.Добавить();  
		Если ЗначениеЗаполнено(ЗначениеСклада) Тогда    
			НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
		Иначе	
			НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.КОбеспечению");
		КонецЕсли;
		НоваяСтрока.Номенклатура = ЗначениеНоменклатуры;
		НоваяСтрока.Характеристика = ХарактеристикаНоменклатуры;
		//НоваяСтрока.Упаковка = ПодборТекущаяУпаковка;
		НоваяСтрока.Склад = ЗначениеСклада;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.ВидЦены = Объект.ВидЦен;
		НоваяСтрока.Цена = 0;
		НоваяСтрока.ДатаОтгрузки = ТекущаяДата();
		
	Иначе       
		Для Ном = НомерНачСтроки По НомерКонСтроки Цикл  
			ОбластьВыборки = ТаблицаДетальныйПодбор.Область("R"+Ном+"C1");
			ЗначениеНоменклатуры = ОбластьВыборки.Расшифровка; 
			
			ОбластьВыборки = ТаблицаДетальныйПодбор.Область("R"+Ном+"C3");
			ХарактеристикаНоменклатуры = ОбластьВыборки.Расшифровка;   
			
			ОбластьВыборки = ТаблицаДетальныйПодбор.Область("R"+Ном+"C2"); 
			ЗначениеСклада = ОбластьВыборки.Расшифровка;
		
			Для НомКолонки = НомерНачКолонки По НомерКонКолонки Цикл   
				ОбластьВыборки = ТаблицаДетальныйПодбор.Область("R"+Ном+"C4"); 

				ЗначениеКоличества = 0;
				Попытка                    
					ЗначениеКоличества = Число(ОбластьВыборки.Значение); 
				Исключение    
					Продолжить;
				КонецПопытки;
				
				Если ЗначениеКоличества = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ВременнаяКорзина.Добавить();  
				Если ЗначениеЗаполнено(ЗначениеСклада) Тогда    
					НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада");
				Иначе	
					НоваяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.КОбеспечению");
				КонецЕсли;
				НоваяСтрока.Номенклатура = ЗначениеНоменклатуры;
				НоваяСтрока.Характеристика = ХарактеристикаНоменклатуры;
				//НоваяСтрока.Упаковка = ПодборТекущаяУпаковка;
				НоваяСтрока.Склад = ЗначениеСклада;
				НоваяСтрока.Количество = ЗначениеКоличества;
				НоваяСтрока.ВидЦены = Объект.ВидЦен;
				НоваяСтрока.Цена = 0;
				НоваяСтрока.ДатаОтгрузки = ТекущаяДата();    
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;   
				
	ОткрытьФормуВременнойКорзины();	

	
КонецПроцедуры



&НаКлиенте
Процедура ДобавитьВКорзинуНаСервере(СтруктураПараметров)
	
	Если ВременнаяКорзина.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ДобавитьЗаметку = СтруктураПараметров.ДобавитьЗаметку;
	
	Если ДобавитьЗаметку Тогда    
		
		Для Каждого ВыборкаСтрока Из ВременнаяКорзина Цикл 
			ТекущаяСтрока = Объект.Заметки.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ВыборкаСтрока);	
		КонецЦикла;
		
	Иначе
		
		Для Каждого ВыборкаСтрока Из ВременнаяКорзина Цикл
			Отбор = Новый Структура;                               
			Отбор.Вставить("ВариантОбеспечения", ВыборкаСтрока.ВариантОбеспечения);
			Отбор.Вставить("Номенклатура", ВыборкаСтрока.Номенклатура);
			Отбор.Вставить("Характеристика", ВыборкаСтрока.Характеристика);   
			Отбор.Вставить("Серия", ВыборкаСтрока.Серия);
			Отбор.Вставить("Упаковка", ВыборкаСтрока.Упаковка);
			//Отбор.Вставить("ВидЦены", ВыборкаСтрока.ВидЦены);
			Отбор.Вставить("Склад", ВыборкаСтрока.Склад);
			
			РезультатПоискаСтрок = Объект.Товары.НайтиСтроки(Отбор);
			Если РезультатПоискаСтрок.Количество() = 0 Тогда		
				ТекущаяСтрока = Объект.Товары.Добавить();
				ТекущаяСтрока.ВариантОбеспечения = ВыборкаСтрока.ВариантОбеспечения;
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ВыборкаСтрока);			
			Иначе			
				ТекущаяСтрока = РезультатПоискаСтрок[0];        
				ТекущаяСтрока.КоличествоУпаковок = ТекущаяСтрока.КоличествоУпаковок + ВыборкаСтрока.КоличествоУпаковок;
			КонецЕсли;
			
			ТекущаяСтрока.ВидЦены = ВыборкаСтрока.ВидЦены;  
			Если ЗначениеЗаполнено(ВыборкаСтрока.ВидЦены) Тогда
				ПодборЦена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика, ТекущаяСтрока.ВидЦены, Объект.Валюта);  
			Иначе 
				ПодборЦена = ВыборкаСтрока.Цена; 
			КонецЕсли;
			ТекущаяСтрока.Цена = ПодборЦена;
			ТекущаяСтрока.Сумма = ТекущаяСтрока.КоличествоУпаковок*ТекущаяСтрока.Цена;
			ТекущаяСтрока.ПроцентРучнойСкидки = ВыборкаСтрока.ПроцентРучнойСкидки;    
			
			МегапрайсПрименитьПравилаПродаж(ТекущаяСтрока);
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
			СтруктураДействий.Вставить("ПересчитатьСумму");
			СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
			СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
			СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
			
			ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);
		КонецЦикла; 
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Функция ВыгрузитьВременнуюКорзину()
		
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВременнаяКорзина",ВременнаяКорзина);

	Адрес = ПоместитьВоВременноеХранилище(СтруктураПараметров, Новый УникальныйИдентификатор);

	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВременнойКорзины()        
			
	СтруктураПараметров = Новый Структура;     
	СтруктураПараметров.Вставить("Партнер",Объект.Партнер);
	СтруктураПараметров.Вставить("ВидЦены",Объект.ВидЦен);    
	СтруктураПараметров.Вставить("ИспользоватьПравилаПродажПоВидамЦен",Объект.ИспользоватьПравилаПродажПоВидамЦен);
	
	Адрес = ВыгрузитьВременнуюКорзину();
	СтруктураПараметров.Вставить("Адрес",Адрес);   

	ОписаниеОповещение = Новый ОписаниеОповещения("ОткрытьФормуВременнойКорзины_Результат", ЭтаФорма, СтруктураПараметров);
	Попытка
		МассивСтруктур = ОткрытьФорму("ВнешняяОбработка.мегапрайсПомощникПродаж.Форма.ПодборКоличества", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещение);
	Исключение
		МассивСтруктур = ОткрытьФорму("Обработка.мегапрайсПомощникПродаж.Форма.ПодборКоличества", СтруктураПараметров, ЭтаФорма,,,,ОписаниеОповещение);
	КонецПопытки;	
		
КонецПроцедуры  

&НаКлиенте
Процедура ОткрытьФормуВременнойКорзины_Результат(РезультатЗакрытия,Параметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВременнаяКорзина.Очистить();   
	
	Объект.ИспользоватьПравилаПродажПоВидамЦен = РезультатЗакрытия.ИспользоватьПравилаПродажПоВидамЦен;
	СтруктураПараметров = ПолучитьИзВременногоХранилища(РезультатЗакрытия.Адрес);
		
	Для Каждого ЭлементМассива Из СтруктураПараметров.ВременнаяКорзина Цикл				
		НоваяСтрока = ВременнаяКорзина.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементМассива);				
	КонецЦикла;	
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ДобавитьЗаметку", РезультатЗакрытия.ДобавитьЗаметку);
	
	ДобавитьВКорзинуНаСервере(СтруктураПараметров);
	
	//ЭтаФорма.ТекущийЭлемент = Элементы.ПодборТаблицаНоменклатура;  
	
	Если РезультатЗакрытия.ДобавитьЗаметку Тогда   
		Элементы.МегаПанельРасшифровок.ТекущаяСтраница = Элементы.МегаПанельРасшифровок.ПодчиненныеЭлементы.ДопЗаметки; 
	Иначе
		Элементы.МегаПанельРасшифровок.ТекущаяСтраница = Элементы.МегаПанельРасшифровок.ПодчиненныеЭлементы.ТоварыГруппа;   
	КонецЕсли; 
	
	Если ПослеДобавленияПереходитьВПоиск Тогда 
		ЭтаФорма.ТекущийЭлемент = Элементы.СтрокаПоиска;
	КонецЕсли;
	
КонецПроцедуры 





&НаКлиенте
Процедура КорзинаНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу",    ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
	Если ЗначениеЗаполнено(Объект.Соглашение) Тогда
		
		СтруктураЗаполненияЦены = Новый Структура;
		СтруктураЗаполненияЦены.Вставить("Дата",       ТекущаяДата());
		СтруктураЗаполненияЦены.Вставить("Валюта",     Объект.Валюта);
		СтруктураЗаполненияЦены.Вставить("Соглашение", Объект.Соглашение);
		СтруктураЗаполненияЦены.Вставить("Ссылка",     Неопределено);
		
		СтруктураДействий.Вставить("ЗаполнитьУсловияПродаж", СтруктураЗаполненияЦены);
	Иначе
		
		СтруктураЗаполненияЦены = Новый Структура;
		СтруктураЗаполненияЦены.Вставить("Дата",   ТекущаяДата());
		СтруктураЗаполненияЦены.Вставить("Валюта", Объект.Валюта);
		
		СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", СтруктураЗаполненияЦены);
	КонецЕсли;
	
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий,Объект);
