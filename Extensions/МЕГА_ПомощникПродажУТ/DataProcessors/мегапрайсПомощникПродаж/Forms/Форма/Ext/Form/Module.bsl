&НаКлиенте
Процедура УстановитьВидимостьЭлементовФормы()	
	
	Элементы.ПодборТаблицаЕстьАналоги.Видимость = ВключитьАналогиНоменклатуры;
	Элементы.ДетализацияПоСкладам.Видимость = РежимДетальныйПодбор;  
		
	Если ПоказатьРасшифровки Тогда                                                              
		Элементы.ГлавнаяПанель.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху; 
		Элементы.МегаПанельРасшифровок.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;   
	Иначе                       
        Элементы.МегаПанельРасшифровок.ТекущаяСтраница = Элементы.МегаПанельРасшифровок.ПодчиненныеЭлементы.ТоварыГруппа;
		Элементы.ГлавнаяПанель.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.МегаПанельРасшифровок.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;

	Элементы.ПодборТаблицаКод.Видимость = КолонкаКод;    
	Элементы.ПодборТаблицаЕдиницаИзмерения.Видимость = КолонкаЕдиница;       
	
	Элементы.ПодборТаблицаЗаказаноОстаток.Видимость = ВидимостьЗаказыПоставщикам;  
	Элементы.ПодборТаблицаПоступитОстаток.Видимость = ВидимостьЗаказыПоставщикам; 
	Элементы.ПодборТаблицаРезервыОстаток.Видимость = ВидимостьРезервы;    
	Элементы.ПодборТаблицаРезервПриход.Видимость = ВидимостьРезервы; 
	Элементы.ПодборТаблицаКОбеспечениюОстаток.Видимость = ВидимостьОбеспечениеЗаказов;   
	Элементы.ПодборТаблицаМинимальныйОстаток.Видимость = ВидимостьМинМакс;   
	Элементы.ПодборТаблицаМаксимальныйОстаток.Видимость = ВидимостьМинМакс;  
	
	Попытка
		Элементы.ПодборТаблицаКомиссияОстатки.Видимость = ВидимостьКомиссия;
		Элементы.ПодборТаблицаКомиссияОстатки.Формат = "ЧДЦ="+ФорматЧисел;   
	Исключение
	КонецПопытки;
					
	ВидимостьПоСкладам = ?(Объект.ТаблицаСкладов.Количество() = 0, Ложь, Истина);
	
	Если РежимДетальныйПодбор Тогда
		ПодборТаблицаНоменклатураПриАктивизацииСтроки();  
	КонецЕсли;  
	
	Элементы.ПодборТаблицаСвободно.Формат = "ЧДЦ="+ФорматЧисел;
	Элементы.ПодборТаблицаВНаличииВсего.Формат = "ЧДЦ="+ФорматЧисел;
	Элементы.ПодборТаблицаЗаказаноОстаток.Формат = "ЧДЦ="+ФорматЧисел;
	
	Элементы.ПодборТаблицаПоступитОстаток.Формат = "ЧДЦ="+ФорматЧисел;
	Элементы.ПодборТаблицаРезервыОстаток.Формат = "ЧДЦ="+ФорматЧисел;
	Элементы.ПодборТаблицаРезервПриход.Формат = "ЧДЦ="+ФорматЧисел;
	Элементы.ПодборТаблицаКОбеспечениюОстаток.Формат = "ЧДЦ="+ФорматЧисел;
	Элементы.ПодборТаблицаМегапрайсОстатки.Формат = "ЧДЦ="+ФорматЧисел;      
	
	Элементы.ПодборТаблицаМинимальныйОстаток.Формат = "ЧДЦ="+ФорматЧисел;
	Элементы.ПодборТаблицаМаксимальныйОстаток.Формат = "ЧДЦ="+ФорматЧисел;  
	
	Элементы.ДопЛюбойОтчет1.Заголовок = ?(ЗначениеЗаполнено(ОтчетБуферНазвание1), ОтчетБуферНазвание1, "Буфер 1");    
	Элементы.ДопЛюбойОтчет2.Заголовок = ?(ЗначениеЗаполнено(ОтчетБуферНазвание2), ОтчетБуферНазвание2, "Буфер 2");
    Элементы.ДопЛюбойОтчет3.Заголовок = ?(ЗначениеЗаполнено(ОтчетБуферНазвание3), ОтчетБуферНазвание3, "Буфер 3");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	
	ВариантНавигации = "По Иерархии";
	ИспользоватьНавигацию = Ложь;  
	Элементы.Навигация.Видимость = ИспользоватьНавигацию;
	НоваяСтрока = НавигацияПоисковыеСлова.Вставить(0);
	НоваяСтрока.ЗначениеОтбора = "[Вся номенклатура]";
	
	Элементы.ПодборТаблицаКод.Видимость = КолонкаКод;
		
	//Элементы.ПодборТаблицаКод.Видимость = Ложь; 
	//Элементы.ПодборТаблицаМарка.Видимость = Ложь; 
	//Элементы.ПодборТаблицаРейтингПродаж.Видимость = Ложь; 
	
	УстановитьВидимостьЭлементовФормы();
	
	Объект.НачалоПериода = НачалоГода(ТекущаяДата());
	Объект.КонецПериода = КонецДня(ТекущаяДата()); 
	
	ПравилоПродажПриИзменении();
	
КонецПроцедуры


