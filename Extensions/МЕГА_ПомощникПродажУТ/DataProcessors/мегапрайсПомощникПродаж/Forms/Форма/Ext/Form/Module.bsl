	ИмяЭлемента = ЭтаФорма.ТекущийЭлемент.Имя;
	
	Попытка
		ТаблицаОтчета = ЭтотОбъект[ИмяЭлемента]; 
	Исключение   
		Возврат;
	КонецПопытки;    
	
	ПодсветкаТекущейСтроки_ДопТаб(ИмяЭлемента); 

КонецПроцедуры




//============================================================================
//ОТЧЕТ-БУФЕР   


&НаКлиенте
Процедура ОтчетБуфер_СделатьОтчет()
	
	АктивныйОтчетБуфер = "";
	
	ТекСтраница = Элементы.МегаПанельРасшифровок.ТекущаяСтраница;
	Если ТекСтраница = Элементы.ДопЛюбойОтчет1 Тогда
		АктивныйОтчетБуфер = ОтчетБуфер1;      
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет2 Тогда 
		АктивныйОтчетБуфер = ОтчетБуфер2;      
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет3 Тогда 
		АктивныйОтчетБуфер = ОтчетБуфер3;     
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АктивныйОтчетБуфер) Тогда  
		Возврат;
	КонецЕсли;
			
	ПараметрыЗапроса = Новый Структура;                 
	ПараметрыЗапроса.Вставить("УникальныйИдентификатор", ЭтотОбъект.УникальныйИдентификатор);
	ПараметрыЗапроса.Вставить("АктивныйОтчетБуфер", АктивныйОтчетБуфер);      
	
	ПараметрыЗапроса = ПолучитьПараметрыДетальногоЗапроса(ПараметрыЗапроса);
	
	Если ЗначениеЗаполнено(ОтчетДанныеРасшифровки) И ЭтоАдресВременногоХранилища(ОтчетДанныеРасшифровки) Тогда
		УдалитьИзВременногоХранилища(ОтчетДанныеРасшифровки);
	КонецЕсли;

	Если ТекСтраница = Элементы.ДопЛюбойОтчет1 Тогда    
		ТаблицаБуфер1 = МегапрайсРасшифровкиСервер.ОтчетБуфер_СформироватьОтчетСервер(ПараметрыЗапроса, ОтчетДанныеРасшифровки);  
		Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаБуфер1, "ТаблицаБуфер1");  
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет2 Тогда   
		ТаблицаБуфер2 = МегапрайсРасшифровкиСервер.ОтчетБуфер_СформироватьОтчетСервер(ПараметрыЗапроса, ОтчетДанныеРасшифровки);   
		Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаБуфер2, "ТаблицаБуфер2"); 
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет3 Тогда  
		ТаблицаБуфер3 = МегапрайсРасшифровкиСервер.ОтчетБуфер_СформироватьОтчетСервер(ПараметрыЗапроса, ОтчетДанныеРасшифровки);  
		Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаБуфер3, "ТаблицаБуфер3"); 
	КонецЕсли;  	  

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаБуферОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)  
	
    СтандартнаяОбработка = Ложь;
    ПоказатьЗначение(,ПолучитьРасшифровку(ОтчетДанныеРасшифровки, Расшифровка)); 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРасшифровку(АдресРасшифровки, Расшифровка)    
	
    ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровки);
    ЗначениеРасшифровки = ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля().Получить(0).Значение;
    Возврат значениеРасшифровки;   
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоказКартинок(Команда)
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры = СписокПоискНоменклатуры.ВыгрузитьЗначения();     
	
	Если МассивНоменклатуры.Количество() = 0 Тогда 
		ВыделенныеСтроки = Элементы.ПодборТаблицаНоменклатура.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ПодборТаблицаНоменклатура.ДанныеСтроки(СтрВыд);	  
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;   
			МассивНоменклатуры.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;   
	КонецЕсли;
	
	Попытка  
		ПараметрыФормы = Новый Структура();  
		ПараметрыФормы.Вставить("СписокПоискНоменклатуры", МассивНоменклатуры);	
		ОткрытьФорму("Обработка.мегапрайсПомощникПродаж.Форма.ФормаПросмотрКартинок", ПараметрыФормы ,ЭтотОбъект , , , ,); 
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;   

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;		
	
	РасшифровкиПолучитьКартинкуНоменклатуры(ТекущиеДанные.Номенклатура);	

КонецПроцедуры






//============================================================================
// УПРАВЛЕНИЕ РАСШИФРОВКАМИ

&НаКлиенте
Процедура НоменклатураОбновитьДанныеПриАктивацииСтроки()	
	
	ТекущиеДанные = Элементы.ПодборТаблицаНоменклатура.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ПодборТекущаяНоменклатура = ТекущиеДанные.Ссылка; 	
	
	Если РежимДетальныйПодбор Тогда
		ПараметрыЗапроса = ПолучитьПараметрыПодбора();	
		МегаПомощникПродажСервер.ЗаполнитьПодборПоСкладам(ТаблицаДетальныйПодбор, ПараметрыЗапроса);  
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПанельВнизу_ОбновитьДанные", 0.2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборТаблицаНоменклатураПриАктивизацииСтроки()	
	
	ТекущиеДанные = Элементы.ПодборТаблицаНоменклатура.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ПодборТекущаяНоменклатура = ТекущиеДанные.Ссылка; 
	ГруппаНоменклатуры = ТекущиеДанные.Родитель;
	
	НоменклатураОбновитьДанныеПриАктивацииСтроки(); 
		
КонецПроцедуры 

&НаКлиенте
Процедура ГлавнаяПанельПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекСтраницаФормы = Элементы.ГлавнаяПанель.ТекущаяСтраница;    
	
	ОбработатьПолучениеДанныхТекущегоЭлемента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельВнизу_ОбновитьДанные()
		
	РасшифровкиПолучитьКартинкуНоменклатуры(ПодборТекущаяНоменклатура);	
	
	Если НЕ ПоказатьРасшифровки Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтраницаФормы = Элементы.МегаПанельРасшифровок.ТекущаяСтраница; 
	Если ТекСтраницаФормы = Элементы.ТоварыГруппа Тогда
		Возврат;
	КонецЕсли;   
	
	Если НЕ ЗначениеЗаполнено(ПодборТекущаяНоменклатура) Тогда
		Возврат;
	КонецЕсли;
                                                                                 	
	ОбработатьПолучениеДанныхТекущегоЭлемента();
	
КонецПроцедуры

&НаКлиенте
Процедура ДопИнформацияПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ПанельВнизу_ОбновитьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПолучениеДанныхТекущегоЭлемента()
	
	ПараметрыЗапроса = ПолучитьПараметрыПодбора();

	Попытка	
		Если ТекСтраницаФормы = Элементы.ВкладкаПродажиКонтрагенту Тогда  	
			Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаПродажиПоПартнеру, "ТаблицаПродажиПоПартнеру");
		КонецЕсли; 	
	Исключение
	КонецПопытки;
	
	Попытка	
		Если ТекСтраницаФормы = Элементы.ДопРаспределениеЗапасов Тогда  	
			Расшифровки_ПолучитьСостояниеЗапасов();    
		КонецЕсли; 	
	Исключение
	КонецПопытки;

	Попытка 
		Если ТекСтраницаФормы = Элементы.СтраницаПодборПоСправочнику Тогда     
			ЗаполнитьПодборПоСправочнику(); 
			НоменклатураОбновитьДанныеПриАктивацииСтроки();
		КонецЕсли;         
	Исключение
	КонецПопытки;     
	
	Попытка 
		Если ТекСтраницаФормы = Элементы.СтраницаАналоги Тогда     
			ПолучитьСписокАналоговНоменклатуры();
		КонецЕсли;         
	Исключение
	КонецПопытки;   
	
	Попытка 
		Если ТекСтраницаФормы = Элементы.СтраницаИсторияПродажТовара Тогда     
			Расшифровки_ИсторияПродаж();  		
		КонецЕсли;         
	Исключение
	КонецПопытки;    
	
	Попытка 
		Если ТекСтраницаФормы = Элементы.СтраницаИсторияЗакупок Тогда     
			ТаблицаИсторияЗакупок = МегапрайсРасшифровкиСервер.Расшифровки_ИсторияЗакупокРегистр(ПараметрыЗапроса);
		КонецЕсли;         
	Исключение
	КонецПопытки;
	
	Попытка 
		Если ТекСтраницаФормы = Элементы.МегаИсторияЗаказовПоставщикам Тогда     
			ТаблицаЗаказыПоставщикам = МегапрайсРасшифровкиСервер.Расшифровка_ИсторияЗаказовПоставщикам(ПараметрыЗапроса);  
		КонецЕсли;         
	Исключение
	КонецПопытки;    
	
	Попытка 
		Если ТекСтраницаФормы = Элементы.МегаИсторияЗаказовПокупателей Тогда      
			Расшифровки_ИсторияЗаказовПокупателей(); 
		КонецЕсли;         
	Исключение
	КонецПопытки;   
		
	//////////////////////////////////////////////////////////////////  
	
	Попытка 
		Если ТекСтраницаФормы = Элементы.ВкладкаЦеныНоменклатуры Тогда     
			СформироватьОтчетПоЦенам();  
			Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаЦеныНоменклатуры, "ТаблицаЦеныНоменклатуры");  
		КонецЕсли;         
	Исключение
	КонецПопытки;            
	
	Попытка 
		Если ТекСтраницаФормы = Элементы.ВкладкаПодборПоПрайсам Тогда  
			//Если РезультатПоиска = Истина Тогда
				ТаблицаПоставщикиПрайсы = МегапрайсРасшифровкиСервер.Мегапрайс_ПрайсыПоставщиков(ПараметрыЗапроса); 
			//КонецЕсли;
		КонецЕсли;         
	Исключение 
		//Сообщить(ОписаниеОшибки());
	КонецПопытки;     
		
	Попытка 
		Если ТекСтраницаФормы = Элементы.МегаСвойстваТоваров Тогда     			
			ПолучитьПараметрыДетальногоЗапроса(ПараметрыЗапроса);  
			ТаблицаСвойств = МегапрайсРасшифровкиСервер.Расшифровки_СвойстваНоменклатуры(ПараметрыЗапроса);
			Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаСвойств, "ТаблицаСвойств");    
		КонецЕсли;         
	Исключение
	КонецПопытки;
		
	Попытка 
		Если ТекСтраницаФормы = Элементы.СтраницаКартинки Тогда   
			ОписаниеНоменклатуры = Расшифровки_ОписаниеНоменклатуры(ПодборТекущаяНоменклатура);
			ПоказатьВсеКартинкиТекущегоТовара(ПараметрыЗапроса);		
		КонецЕсли;         
	Исключение
	КонецПопытки;	
	
	Попытка	
		Если ТекСтраницаФормы = Элементы.ДопЛюбойОтчет1 
			ИЛИ ТекСтраницаФормы = Элементы.ДопЛюбойОтчет2
			ИЛИ ТекСтраницаФормы = Элементы.ДопЛюбойОтчет3 Тогда  
			ОтчетБуфер_СделатьОтчет();
			//НайтиСтрокуПроизвольногоОтчета();    
		КонецЕсли; 	
	Исключение
	КонецПопытки;

		
КонецПроцедуры    

