&НаСервере
Процедура ИнициализироватьСклады()
	
	Объект.ТаблицаСкладов.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Склады.Ссылка КАК Склад,
	|	Склады.Наименование КАК Наименование,
	|	Склады.Родитель КАК Родитель
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.ЭтоГруппа = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ВыборкаСтрока Из Таблица Цикл		
		НоваяСтрока = Объект.ТаблицаСкладов.Добавить();  
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаСтрока);
		НоваяСтрока.Пометка = Истина;
	КонецЦикла; 
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСклады(Команда)
	
	ИнициализироватьСклады();  
	ПриУстановкеИзмененииСклада();
	
КонецПроцедуры


