КонецПроцедуры


&НаКлиенте
Процедура ОткрытьНовое(Команда)
	
	Результат = Ложь;
	
	Попытка
		ОткрытьФорму("ВнешняяОбработка.мегапрайсПомощникПродаж.Форма.Форма",,,Истина); 
		Результат = Истина;
	Исключение
	КОнецПопытки;
	
	Если Результат = Ложь Тогда
		Попытка
			ОткрытьФорму("Обработка.мегапрайсПомощникПродаж.Форма.Форма",,,Истина); 
			Результат = Истина;
		Исключение 
		КОнецПопытки;
	КонецЕсли;
	
	Если Результат = Ложь Тогда
		Сообщить("Данная разработка отсутствует или не подключена");
	Конецесли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Попытка 
		Константы.мегапрайсИспользоватьВиртуальныеОстатки.Получить();
		Объект.ИспользоватьМегапрайс = Истина;
		Объект.ИспользоватьПравилаПродажПоВидамЦен = Истина;
	Исключение
		Объект.ИспользоватьМегапрайс = Ложь;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(НоваяВидНоменклатуры) Тогда
		НоваяВидНоменклатуры = Справочники.ВидыНоменклатуры.ВидНоменклатурыПоУмолчанию();
	КонецЕсли;
	
	НачалоПериода = НачалоМесяца(НачалоМесяца(ТекущаяДата())-1);
	НачалоПериода = НачалоМесяца(НачалоПериода-1);
	Объект.НачалоПериода = НачалоМесяца(НачалоПериода-1);
	Объект.КонецПериода = КонецДня(ТекущаяДата());
	
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ИспользоватьУпаковкиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры");
	
	Объект.ВидДокумента = "Заказ покупателя";

	Объект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Объект.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;	
	Объект.Менеджер = Пользователи.ТекущийПользователь();
	Объект.ДатаОтгрузки = КонецДня(ТекущаяДата());   
	
	ИспользуетсяЦенообразование25 = ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25(ТекущаяДата());  
	Если ИспользуетсяЦенообразование25 = Истина Тогда
		ТекстЗапроса = ПодборТаблицаНоменклатура.ТекстЗапроса;    
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РегистрСведений.ЦеныНоменклатуры","РегистрСведений.ЦеныНоменклатуры25");  
		//ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РегОстаткиПоставщиков.Количество КАК ОстаткиПоставщиков","300 КАК ОстаткиПоставщиков"); 
		
		СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
		СвойстваСписка.ОсновнаяТаблица = "Справочник.Номенклатура";
		СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
		СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.ПодборТаблицаНоменклатура,СвойстваСписка);
	КонецЕсли;     
	
	
	Если Параметры.Свойство("Адрес") Тогда
		СтруктураПараметров = ПолучитьИзВременногоХранилища(Параметры.Адрес);		
		Попытка
			Объект.Партнер = СтруктураПараметров.Партнер;      
			Объект.Соглашение = СтруктураПараметров.Соглашение; 
		Исключение
		КонецПопытки;     
		
		Объект.Товары.Очистить();     
		Объект.Заметки.Очистить();
		Для Каждого ВыборкаСтрока Из СтруктураПараметров.ТабличнаяЧасть Цикл  
			НоваяСтрока = Объект.Товары.Добавить();  
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаСтрока);
			НоваяСтрока.КоличествоУпаковок = ВыборкаСтрока.Поле_Количество; 
			
			НоваяСтрока.ВидЦены = Объект.ВидЦен;
			НоваяСтрока.Цена = МегаПомощникПродажСервер.ПолучитьЦенуПоВидуЦены(НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика, Объект.ВидЦен, Объект.Валюта);
			НоваяСтрока.ДатаОтгрузки = ТекущаяДата();    
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
			СтруктураДействий.Вставить("ПересчитатьСумму");
			СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
			СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
			СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
			
			ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		КонецЦикла;		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	УстановитьУсловноеОформлениеСтрок();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ВыполняетсяЗакрытие И НЕ ЗавершениеРаботы Тогда		
		Отказ = Истина;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		ТекстВопроса       = НСтр("ru = 'Работа помощника будет завершена, все введенные данные будут потеряны. Закрыть помощник?'");
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("Закрыть",     НСтр("ru = 'Закрыть'"));
		СписокКнопок.Добавить("НеЗакрывать", НСтр("ru = 'Не закрывать'"));
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ОтветНаВопрос = РезультатВопроса;
	
	Если ОтветНаВопрос = "Закрыть" Тогда
		ВыполняетсяЗакрытие = Истина;		
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура МегапрайсСохранитьПравилоПродаж()
	
	Если НЕ ЗначениеЗаполнено(Объект.ПравилоПродаж) Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоОбъект = Объект.ПравилоПродаж.ПолучитьОбъект();
	ПравилоОбъект.ВидДокумента = Объект.ВидДокумента;
	ПравилоОбъект.Организация = Объект.Организация;
	
	ПравилоОбъект.Склад = Объект.Склад;                
	ПравилоОбъект.ВариантОбеспечения = Объект.ВариантОбеспечения;
	
	ПравилоОбъект.Партнер = Объект.Партнер;   
	ПравилоОбъект.Соглашение = Объект.Соглашение;    
	ПравилоОбъект.Контрагент = Объект.Контрагент;   
	ПравилоОбъект.Договор = Объект.Договор;
	ПравилоОбъект.ВидЦен = Объект.ВидЦен;  
	ПравилоОбъект.Валюта = Объект.Валюта;
	
	ПравилоОбъект.НаборНоменклатуры = Объект.НаборНоменклатуры;
		
	ПравилоОбъект.ТаблицаСкладов.Загрузить(Объект.ТаблицаСкладов.Выгрузить());	
	ПравилоОбъект.ТаблицаПокупателей.Загрузить(Объект.ТаблицаПокупателей.Выгрузить());
	
	ПравилоОбъект.Записать();
	
КонецПроцедуры

&НаСервере
Процедура МегапрайсЗаполнитьПравилоПродаж()
	
	Если НЕ ЗначениеЗаполнено(Объект.ПравилоПродаж) Тогда
		Возврат;
	КонецЕсли;
		
	НайденоПравило = Объект.ПравилоПродаж; 
	
	Объект.ВидДокумента = НайденоПравило.ВидДокумента;
	Если НЕ ЗначениеЗаполнено(Объект.ВидДокумента) Тогда 
		Объект.ВидДокумента = "Заказ покупателя";
	КонецЕсли;
	Объект.Организация = НайденоПравило.Организация;    
	
	Если ЗначениеЗаполнено(НайденоПравило.ВариантОбеспечения) Тогда
		Объект.Склад = НайденоПравило.Склад; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденоПравило.ВариантОбеспечения) Тогда
		Объект.ВариантОбеспечения = НайденоПравило.ВариантОбеспечения; 
	КонецЕсли;    
	
	Если ЗначениеЗаполнено(НайденоПравило.ВидЦен) Тогда
		Объект.ВидЦен = НайденоПравило.ВидЦен; 
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(НайденоПравило.Валюта) Тогда
		Объект.Валюта = НайденоПравило.Валюта; 
	КонецЕсли; 

	Объект.Партнер = НайденоПравило.Партнер;   
	Объект.Соглашение = НайденоПравило.Соглашение; 
	Объект.Контрагент = НайденоПравило.Контрагент;   
	Объект.Договор = НайденоПравило.Договор;
	Объект.Валюта = НайденоПравило.Валюта;
	
	Если ЗначениеЗаполнено(НайденоПравило.НаборНоменклатуры) Тогда
		Объект.НаборНоменклатуры = НайденоПравило.НаборНоменклатуры; 
	КонецЕсли;
		
	Если НайденоПравило.ТаблицаСкладов.Количество() > 0 Тогда
		Объект.ТаблицаСкладов.Очистить();
		Объект.ТаблицаСкладов.Загрузить(НайденоПравило.ТаблицаСкладов.Выгрузить());	
	КонецЕсли;
	Если НайденоПравило.ТаблицаПокупателей.Количество() > 0 Тогда         
		Объект.ТаблицаПокупателей.Очистить();
		Объект.ТаблицаПокупателей.Загрузить(НайденоПравило.ТаблицаПокупателей.Выгрузить());	
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьЗаголовокОкна()  
	
	Если ЗначениеЗаполнено(Объект.Партнер) Тогда  
		ЭтаФорма.Заголовок = Объект.Партнер;
	Иначе  
		ЭтаФорма.Заголовок = "Помощник продаж: <не выбран>";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилоПродажПриИзменении()
	
	МегапрайсЗаполнитьПравилоПродаж();  
	
	ПриУстановкеИзмененииВидаЦен();
	ПриУстановкеИзмененииСклада();
	ПриУстановкеИзмененииВалюты();  
	
	УстановитьЗаголовокОкна();
	
