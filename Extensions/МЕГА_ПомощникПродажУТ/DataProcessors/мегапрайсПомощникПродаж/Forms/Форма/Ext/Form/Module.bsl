&НаСервере
Процедура СоздатьЗаполнитьДокументНаСервере(ПараметрыЗапроса)
	
	УстановитьПривилегированныйРежим(Истина);   
	
	Если ЗначениеЗаполнено(Объект.Документ) Тогда
		ДокументОбъект = Объект.Документ.ПолучитьОбъект();
	Иначе
		Если Объект.ВидДокумента = "Заказ покупателя" Тогда
			ДокументОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
		ИначеЕсли Объект.ВидДокумента = "Коммерческое предложение" Тогда
			ДокументОбъект = Документы.КоммерческоеПредложениеКлиенту.СоздатьДокумент();
		Иначе 
			ДокументОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		КонецЕсли;

		ДокументОбъект.Дата = ТекущаяДата();  
		
		Попытка
			ДокументОбъект.Партнер = Объект.Партнер;
		Исключение
		КонецПопытки;   
		
		ИспользоватьСоглашение = Ложь;
		Попытка           
			Если ЗначениеЗаполнено(Объект.Соглашение) Тогда 
				ИспользоватьСоглашение = Истина; 
				ДокументОбъект.Соглашение = Объект.Соглашение; 	
			КонецЕсли;
		Исключение   
		КонецПопытки;  
		Попытка
			ДокументОбъект.Контрагент = Объект.Контрагент;
		Исключение
		КонецПопытки;  
		Попытка
			ДокументОбъект.Договор = Объект.Договор;  
		Исключение
		КонецПопытки; 
		Попытка
			ДокументОбъект.Клиент = Объект.Партнер;
		Исключение
		КонецПопытки; 
		
		Если ИспользоватьСоглашение Тогда 
			ДокументОбъект.Заполнить(Объект.Соглашение); 
		Иначе
			ДокументОбъект.Заполнить(Объект.Партнер);  
		КонецЕсли;
		
		Попытка
			ДокументОбъект.Склад = Объект.Склад;
		Исключение
		КонецПопытки;   
		
		ДокументОбъект.Комментарий = ПараметрыЗапроса.Комментарий;

		ДокументОбъект.Записать();
		Объект.Документ = ДокументОбъект.Ссылка;
	КонецЕсли;

	ДокументОбъект.Товары.Очистить();
	
	Для Каждого Стр из Объект.Товары Цикл					
		СтрокаТЧ = ДокументОбъект.Товары.Добавить();
		
		Попытка
			СТрокаТЧ.ВариантОбеспечения = Стр.ВариантОбеспечения;
		Исключение
		КонецПопытки;
		СтрокаТЧ.Номенклатура = Стр.Номенклатура;
		СтрокаТЧ.Характеристика = Стр.Характеристика;
		
		Попытка
			СтрокаТЧ.Серия = Стр.Серия;
		Исключение
		КонецПопытки;

		СтрокаТЧ.Количество = Стр.Количество;
		
		Попытка
			СтрокаТЧ.Упаковка = Стр.Упаковка;
			СтрокаТЧ.КоличествоУпаковок = Стр.Количество;
		Исключение
		КонецПопытки;
		
		СтрокаТЧ.ВидЦены = Стр.ВидЦены;
		СтрокаТЧ.Цена = Стр.Цена;
		СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
		СтрокаТЧ.СтавкаНДС = Стр.Номенклатура.СтавкаНДС;
		
		Попытка
			СтрокаТЧ.Склад = Стр.Склад;
		Исключение
		КонецПопытки;
		Попытка
			СтрокаТЧ.СрокПоставки = 1;
			СтрокаТЧ.ДатаОтгрузки = Объект.ДатаОтгрузки;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
	СтруктураДействий = Новый Структура;
	
	Если Объект.ВидДокумента = "Коммерческое предложение" Тогда     
	Иначе
		НалогообложениеНДС = ДокументОбъект.НалогообложениеНДС;
	КонецЕсли;
	
	//СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", МегапрайсВременныйКлиентСервер.ПараметрыЗаполненияСтавкиНДС(ДокументОбъект));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать, ИмяКоличества", Истина, "Количество"));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать, ИмяКоличества", Истина, "Количество"));
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокументОбъект.Товары, СтруктураДействий);
	
	ДокументОбъект.Записать();   
		
КонецПроцедуры

&НаСервере
Процедура СоздатьВиртуальныйЗаказНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);   
	
	ДокументОбъект = Документы.мегапрайсВиртуальныйЗаказ.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДата();	     
	ДокументОбъект.Статус = Перечисления.СтатусыЗаказовПоставщикам.НеСогласован;
	ДокументОбъект.Менеджер = Пользователи.ТекущийПользователь();
	ДокументОбъект.Комментарий = "Помощник продаж - подбор.";
		
	ДокументОбъект.ВидОтбораПоПоставщику = "По регистрации цен";
	ДокументОбъект.ОтборПоставщиковПоТоварам = Истина;
	
	Для Каждого ВыборкаСтрока Из Объект.Товары Цикл  
		
		ТекущиеДанные = ДокументОбъект.ТаблицаПотребностей.Добавить();
		ТекущиеДанные.Номенклатура = ВыборкаСтрока.Номенклатура;
		ТекущиеДанные.Характеристика = ВыборкаСтрока.Характеристика;
		ТекущиеДанные.Поле_Артикул = ВыборкаСтрока.Номенклатура.Артикул;
		ТекущиеДанные.Поле_Наименование = ВыборкаСтрока.Номенклатура;
		ТекущиеДанные.РекомендуетсяЗаказать = ВыборкаСтрока.Количество;     
		ТекущиеДанные.Заказать = ВыборкаСтрока.Количество;     
		ТекущиеДанные.ЦенаПродажи = ВыборкаСтрока.Цена;
		ТекущиеДанные.НоменклатураИсточник = ВыборкаСтрока.Номенклатура;
		ТекущиеДанные.КоличествоЗаказатьИсходное = ВыборкаСтрока.Количество;	
		
		ТекущиеДанные.Производитель = ВыборкаСтрока.Номенклатура.Производитель;
	КонецЦикла;  
	
	ДокументОбъект.Записать();  
	Объект.Документ = ДокументОбъект.Ссылка;
		
КонецПроцедуры


&НаСервере
Функция СоздатьЗаметкуНаСервере() 
	
	Если Объект.Заметки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);   
	
	ФорматированныйДокумент = Новый ФорматированныйДокумент;    
	ТекстоваяСтрока = "";

	НоваяЗаметка = Справочники.Заметки.СоздатьЭлемент();  
	НоваяЗаметка.ДатаИзменения = ТекущаяДата();   
	НоваяЗаметка.Автор = ПараметрыСеанса.ТекущийПользователь; 
	
	Если ЗначениеЗаполнено(Объект.Документ) Тогда 
		НоваяЗаметка.Предмет = Объект.Документ;   
		НоваяЗаметка.ПредставлениеПредмета = ОбщегоНазначения.ПредметСтрокой(НоваяЗаметка.Предмет);
		НоваяЗаметка.ТекстСодержания = Объект.Документ; 
		ТекстоваяСтрока = "С привязкой к заказу..." + Символы.ПС;;
	Иначе  
		НоваяЗаметка.Предмет = Объект.Партнер;      
		НоваяЗаметка.ПредставлениеПредмета = ОбщегоНазначения.ПредметСтрокой(НоваяЗаметка.Предмет);
		НоваяЗаметка.ТекстСодержания = Объект.Партнер;   
		ТекстоваяСтрока = "Документ заказа не был создан..." + Символы.ПС;;
	КонецЕсли;
	
	Для Каждого ВыборкаСтрока из Объект.Заметки Цикл	
		
		ТекстоваяСтрока = ТекстоваяСтрока + ВыборкаСтрока.Номенклатура   
		    + " " + ВыборкаСтрока.Количество   
            + " " + ВыборкаСтрока.Цена             
            + Символы.ПС;    

		Попытка
			ТекущаяСтрока = НоваяЗаметка.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ВыборкаСтрока);	
		Исключение
		КонецПопытки;    
	КонецЦикла;
	
	Вложения = Новый Структура;
	ФорматированныйДокумент.УстановитьHTML(ТекстоваяСтрока, Вложения);
	НоваяЗаметка.Содержание = Новый ХранилищеЗначения(ФорматированныйДокумент, Новый СжатиеДанных(9));
	
	ТекстHTML = "";
	Вложения = Новый Структура;
	ФорматированныйДокумент.ПолучитьHTML(ТекстHTML, Вложения);	
	НоваяЗаметка.ТекстСодержания = СтроковыеФункцииКлиентСервер.ИзвлечьТекстИзHTML(ТекстHTML);

	НоваяЗаметка.Записать();
	
	Возврат НоваяЗаметка.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура КомандаЗаполнитьДокумент(Команда)
	
	ПараметрыФормы = Новый Структура(); 		               
	ПараметрыФормы.Вставить("Партнер", Объект.Партнер); 
	ПараметрыФормы.Вставить("Соглашение", Объект.Соглашение);
	ПараметрыФормы.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыФормы.Вставить("Договор", Объект.Договор);
	ПараметрыФормы.Вставить("ДатаОтгрузки", Объект.ДатаОтгрузки);
	
	ОписаниеОповещение = Новый ОписаниеОповещения("КомандаЗаполнитьДокумент_Завершение", ЭтаФорма);    
		
	ОткрытьФорму("Обработка.мегапрайсПомощникПродаж.Форма.ФормаПодтвержденияЗаказа", ПараметрыФормы, ЭтотОбъект ,,,,ОписаниеОповещение); 
		
КонецПроцедуры 


&НаКлиенте
Процедура КомандаЗаполнитьДокумент_Завершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;      
	
	Объект.Партнер = РезультатЗакрытия.Партнер;
	Объект.Соглашение = РезультатЗакрытия.Соглашение;
	Объект.Контрагент = РезультатЗакрытия.Контрагент; 
	Объект.Договор = РезультатЗакрытия.Договор;   
	Объект.ДатаОтгрузки = РезультатЗакрытия.ДатаОтгрузки; 

	Если Объект.ВидДокумента = "Виртуальный заказ" Тогда  
		СоздатьВиртуальныйЗаказНаСервере(); 
	Иначе
		СоздатьЗаполнитьДокументНаСервере(РезультатЗакрытия); 
	КонецЕсли;
	
	//ОткрытьЗначение(Объект.Документ);
	ПоказатьЗначение( , Объект.Документ);
	
	ЗаметкаСсылка = СоздатьЗаметкуНаСервере();
	Если НЕ ЗаметкаСсылка = Ложь Тогда 
		ПоказатьЗначение( , ЗаметкаСсылка);
	КонецЕсли;
	
КонецПроцедуры



&НаСервере
Функция мУстановкаЦенНоменклатуры()
	
	МассивДокументов = Новый Массив;

	НовыйДокумент = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	НовыйДокумент.Дата        = ТекущаяДата();
	НовыйДокумент.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокумент.Комментарий = "";
	НовыйДокумент.Согласован = Истина;
	НовыйДокумент.Статус     = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
	
	СтрокаТЧ = НовыйДокумент.ВидыЦен.Добавить();
	СтрокаТЧ.ВидЦены = Объект.ВидЦен;	
	
	Для Каждого Стр Из Объект.Товары Цикл
		
		СтрокаТЧ = НовыйДокумент.Товары.Добавить();
		СтрокаТЧ.Номенклатура     = Стр.Номенклатура;
		СтрокаТЧ.Характеристика   = Стр.Характеристика;
		СтрокаТЧ.ВидЦены          = Объект.ВидЦен;
		СтрокаТЧ.Цена             = Стр.Цена;	
		СтрокаТЧ.ЦенаИзмененаВручную = Истина;
		
	КонецЦикла;
	
	НовыйДокумент.Записать();
	МассивДокументов.Добавить(НовыйДокумент.Ссылка);

	
	Возврат МассивДокументов;
	
КонецФункции




