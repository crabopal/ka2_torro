&НаСервере
Процедура ПриУстановкеИзмененииСкладаСервер()  
		
	Если ОтборВсеСклады Тогда    
		ТекстЗапроса = ПодборТаблицаНоменклатура.ТекстЗапроса;    
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад = &СкладОтбор","Склад В (&СкладОтбор)");   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад В ИЕРАРХИИ(&СкладОтбор)","Склад В (&СкладОтбор)");        
	Иначе                 
		Если Объект.Склад.ЭтоГруппа Тогда       
			ТекстЗапроса = ПодборТаблицаНоменклатура.ТекстЗапроса;    
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад В (&СкладОтбор)", "Склад В ИЕРАРХИИ(&СкладОтбор)");   
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад = &СкладОтбор", "Склад В ИЕРАРХИИ(&СкладОтбор)"); 
			ПодборТаблицаНоменклатура.ТекстЗапроса = ТекстЗапроса;  
		Иначе
			ТекстЗапроса = ПодборТаблицаНоменклатура.ТекстЗапроса;    
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад В (&СкладОтбор)", "Склад = &СкладОтбор"); 
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад В ИЕРАРХИИ(&СкладОтбор)","Склад = &СкладОтбор");  
		КонецЕсли;
	КонецЕсли;    
	
	//ПодборТаблицаНоменклатура.ТекстЗапроса = ТекстЗапроса;  
		
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "Справочник.Номенклатура";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.ПодборТаблицаНоменклатура,СвойстваСписка);
	
	//Элементы.ПодборТаблицаНоменклатура.Обновить();   
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтборВсеСкладыПриИзменении(Элемент) 
	
	ПриУстановкеИзмененииСкладаСервер();   
	
	ПриУстановкеИзмененииСклада(); 
		
	Элементы.ПодборТаблицаНоменклатура.Обновить();
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриУстановкеИзмененииСклада()
		
	СписокОтборСклады.Очистить();  
	Для Каждого ВыборкаСклад Из Объект.ТаблицаСкладов Цикл  
		Если НЕ ВыборкаСклад.Пометка Тогда   
			Продолжить; 
		КонецЕсли;			
		СписокОтборСклады.Добавить(ВыборкаСклад.Склад);   
	КонецЦикла;  
		
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		СписокОтборСклады.Добавить(Объект.Склад); 
	КонецЕсли;    
	
	МассивСкладов = СписокОтборСклады.ВыгрузитьЗначения();	
	
	Если ОтборВсеСклады Тогда    
		Если СписокОтборСклады.Количество() > 0 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"СкладОтбор", МассивСкладов, Истина);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"СкладОтбор", Неопределено, Истина);
		КонецЕсли;      
	Иначе     
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"СкладОтбор", Объект.Склад, Истина);
	КонецЕсли;
	
	НоменклатураОбновитьДанныеПриАктивацииСтроки();      
	
КонецПроцедуры

&НаКлиенте
Процедура ПриУстановкеИзмененииВалюты()
	
	Если ЗначениеЗаполнено(Объект.Валюта) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"Валюта", Объект.Валюта, Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"Валюта", Неопределено, Истина);
	КонецЕсли;
	
КонецПроцедуры


