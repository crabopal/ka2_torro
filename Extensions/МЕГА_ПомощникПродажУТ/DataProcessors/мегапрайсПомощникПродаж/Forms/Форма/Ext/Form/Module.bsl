&НаКлиенте
Процедура НовыйПодбор(Команда)

	ВыборЗначение = Объект.Партнер; 
		
	ОписаниеОповещения = Новый ОписаниеОповещения("НовыйПодбор_Завершение", ЭтотОбъект);
	ПоказатьВводЗначения(ОписаниеОповещения, ВыборЗначение, "Выберите элемент", Тип("СправочникСсылка.Партнеры"));	 
		
КонецПроцедуры   

&НаКлиенте
Процедура НовыйПодбор_Завершение(ВыборЗначение, ДопПараметры) Экспорт
	
	Если ВыборЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Партнер = ВыборЗначение;	
	ПартнерПриИзменении();  
	
	ЭтаФорма.ТекущийЭлемент = Элементы.ВкладкаДокумент;

КонецПроцедуры 

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
 
	Объект.Документ = "";

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоДокументу()
	
	Если НЕ ЗначениеЗаполнено(Объект.Документ) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Организация = Объект.Документ.Организация;
	Объект.Валюта = Объект.Документ.Валюта;	
	
	Попытка
		Объект.Менеджер = Объект.Документ.Менеджер;
	Исключение
	КонецПопытки; 
	
	Попытка
		Объект.ДатаОтгрузки = Объект.Документ.ДатаОтгрузки;
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.Партнер = Объект.Документ.Партнер;
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.Партнер = Объект.Документ.Клиент;
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.Соглашение = Объект.Документ.Соглашение;	
		Объект.ВидЦен = Объект.Соглашение.ВидЦен;
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.Склад = Объект.Документ.Склад;
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.ВидЦен = Объект.Документ.ВидЦены;
	Исключение
	КонецПопытки;  
	
	Объект.Товары.Загрузить(Объект.Документ.Товары.Выгрузить());
		
КонецПроцедуры

&НаКлиенте
Процедура ДокументПриИзменении(Элемент)
	
	Объект.Товары.Очистить();
	Объект.Партнер = "";
	Объект.Соглашение = "";
	
	ЗаполнитьДанныеПоДокументу();
	
	ПриУстановкеИзмененииВидаЦен();
	ПриУстановкеИзмененииСклада();
	ПриУстановкеИзмененииВалюты();
	
КонецПроцедуры


&НаСервере
Процедура ПриИзмененииПартнераСервер()
		
	Если ЗначениеЗаполнено(Объект.Партнер) Тогда		
		УсловияПродажПоУмолчанию = ПродажиСервер.ПолучитьУсловияПродажПоУмолчанию(Объект.Партнер);	
		Если УсловияПродажПоУмолчанию <> Неопределено Тогда
			Объект.Соглашение = УсловияПродажПоУмолчанию.Соглашение;
			Объект.ВидЦен = Объект.Соглашение.ВидЦен;  
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПартнерПриИзменении()
		
	Объект.Документ = "";
	Объект.Соглашение = "";  
	Объект.Контрагент = "";
    Объект.Договор = "";

	Объект.Заметки.Очистить();
	
	ПриИзмененииПартнераСервер();
	ПриУстановкеИзмененииВидаЦен();
	
	УстановитьЗаголовокОкна();   
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПартнерПриИзменении_Завершение", ЭтотОбъект), НСтр("ru = 'Очистить корзину ?'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры 


