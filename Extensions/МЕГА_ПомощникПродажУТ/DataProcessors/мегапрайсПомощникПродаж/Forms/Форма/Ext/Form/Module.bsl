&НаКлиенте
Функция ПолучитьПараметрыПодбора() 
	
	ПараметрыЗапроса = Новый Структура;  
	
	ТекущиеДанные = Элементы.ПодборТаблицаНоменклатура.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат ПараметрыЗапроса;
	КонецЕсли;
	
	СписокОтборНоменклатуры.Очистить();
		                            
	ПараметрыЗапроса.Вставить("ПравилоПродаж", Объект.ПравилоПродаж);
	ПараметрыЗапроса.Вставить("ИспользоватьМегапрайс", Объект.ИспользоватьМегапрайс);
	ПараметрыЗапроса.Вставить("Валюта", Объект.Валюта);
	ПараметрыЗапроса.Вставить("Номенклатура", ПодборТекущаяНоменклатура);
	ПараметрыЗапроса.Вставить("ХарактеристикаНоменклатуры", ПодборТекущаяХарактеристика);
	ПараметрыЗапроса.Вставить("ВидЦенНоменклатуры", Объект.ВидЦен);
	ПараметрыЗапроса.Вставить("ОсновнойСклад", Объект.Склад);
	ПараметрыЗапроса.Вставить("НачалоПериода", Объект.НачалоПериода);
	ПараметрыЗапроса.Вставить("КонецПериода", Объект.КонецПериода);  
	 
	ПараметрыЗапроса.Вставить("ВключитьАналогиНоменклатуры", ВключитьАналогиНоменклатуры); 
	ПараметрыЗапроса.Вставить("ВключитьСовместноПродаваемые", ВключитьСовместноПродаваемые);
	ПараметрыЗапроса.Вставить("ВидЦен", Объект.ВидЦен);  
	ПараметрыЗапроса.Вставить("ЦенаПродажи", ТекущиеДанные.Цена); 
	
	ПараметрыЗапроса.Вставить("Валюта", Объект.Валюта); 
	ПараметрыЗапроса.Вставить("СписокОтборСклады", СписокОтборСклады);
	
	СписокОтборНоменклатуры.Добавить(ПодборТекущаяНоменклатура,,Истина);
	ВыделенныеСтроки = Элементы.ПодборТаблицаНоменклатура.ВыделенныеСтроки;	
	Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
		ДанныеСтроки = Элементы.ПодборТаблицаНоменклатура.ДанныеСтроки(СтрВыд);	  
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;   
		Если ДанныеСтроки.Ссылка = ПодборТекущаяНоменклатура Тогда
			Продолжить;
		КонецЕсли;
		СписокОтборНоменклатуры.Добавить(ДанныеСтроки.Ссылка,,Истина);
	КонецЦикла;   
	МегаПомощникПродажСервер.ДополнитьСписокОтборНоменклатуры(СписокОтборНоменклатуры,ПараметрыЗапроса);
	ПараметрыЗапроса.Вставить("СписокОтборНоменклатуры", СписокОтборНоменклатуры);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции


