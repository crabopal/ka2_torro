&НаКлиенте
Процедура СформироватьОтчетПродажиПоПартнеру()
	
	Если НЕ ЗначениеЗаполнено(ВариантОтчетаПродажи) Тогда
		ВариантОтчетаПродажи = "Номенклатура";
	КонецЕсли;

	ПараметрыЗапроса = Новый Структура; 
	ПараметрыЗапроса.Вставить("НачалоПериода",НачалоДня(Объект.НачалоПериода));
	ПараметрыЗапроса.Вставить("КонецПериода",КонецДня(Объект.КонецПериода));  
	
	ПараметрыЗапроса.Вставить("Партнер",Объект.Партнер);
	
	Если НЕ ЗначениеЗаполнено(Периодичность) Тогда   
		Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал");
	КонецЕсли;  	
	ПараметрыЗапроса.Вставить("Периодичность",Периодичность);    
	
	ПараметрыЗапроса.Вставить("ВариантОтчетаПродажи", ВариантОтчетаПродажи);
	
	Если НЕ Расшифровка_ГодовойОтчет Тогда
		МегаПомощникПродажСервер.Расшифровка_ОтчетПродажиПоПартнеруСервер(ТаблицаПродажиПоПартнеру,ПараметрыЗапроса);  
	Иначе
		МегаПомощникПродажСервер.Расшифровка_ОтчетПродажиПоПартнеруСерверДашбоард(ТаблицаПродажиПоПартнеру,ПараметрыЗапроса);  
	КонецЕсли;
	
КонецПроцедуры
  

&НаКлиенте
Процедура ПоследниеПродажиПартнеруУстановитьОтборПоТоварам(Команда)
		
	СписокПоискНоменклатуры.Очистить();
	
	НомерКонСтроки = ТаблицаПродажиПоПартнеру.ВысотаТаблицы;   
	
	Если НомерКонСтроки > 200 Тогда        
		Сообщить("В таблице больше 200 позиций. Слишком много.");
		Возврат;
	КонецЕсли;

	Для Ном = 3 По НомерКонСтроки Цикл  
		ОбластьВыборки = ТаблицаПродажиПоПартнеру.Область("R"+Ном+"C1");
		ЗначениеНоменклатуры = ОбластьВыборки.Расшифровка; 
		СписокПоискНоменклатуры.Добавить(ЗначениеНоменклатуры);
	КонецЦикла;
	
	Если СписокПоискНоменклатуры.Количество() > 0 Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Ссылка",СписокПоискНоменклатуры,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	Иначе              
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Ссылка",Неопределено,ВидСравненияКомпоновкиДанных.Равно,,Ложь);
	КонецЕсли;
	
	ЭтаФорма.ТекущийЭлемент = Элементы.СтраницаПодборПоСправочнику;
	
КонецПроцедуры



