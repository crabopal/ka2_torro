&НаКлиенте
Функция ПолучитьПараметрыДетальногоЗапроса(ПараметрыЗапроса)
		                            
	ПараметрыЗапроса.Вставить("ИспользоватьМегапрайс",Объект.ИспользоватьМегапрайс);
	
	ПараметрыЗапроса.Вставить("НачалоПериода",НачалоДня(Объект.НачалоПериода));
	ПараметрыЗапроса.Вставить("КонецПериода",КонецДня(Объект.КонецПериода));  
	
	ПараметрыЗапроса.Вставить("Партнер",Объект.Партнер); 
	ПараметрыЗапроса.Вставить("ВидЦенНоменклатуры",Объект.ВидЦен);
	
	ПараметрыЗапроса.Вставить("ОсновнойСклад", Объект.Склад);   
	ПараметрыЗапроса.Вставить("СписокОтборСклады",СписокОтборСклады);    
		
	Если НЕ ЗначениеЗаполнено(Периодичность) Тогда   
		Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал");
	КонецЕсли;  	
	ПараметрыЗапроса.Вставить("Периодичность",Периодичность);
	
	Если СписокОтборВидыЦен.Количество() > 0 Тогда                 
	  	ПараметрыЗапроса.Вставить("СписокОтборВидыЦен",СписокОтборВидыЦен);  
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("Номенклатура", ПодборТекущаяНоменклатура);    
	ПараметрыЗапроса.Вставить("ГруппаНоменклатуры", ГруппаНоменклатуры);   
	Если СписокОтборНоменклатуры.Количество() > 0 Тогда                 
	  	ПараметрыЗапроса.Вставить("СписокОтборНоменклатуры",СписокОтборНоменклатуры);  
	КонецЕсли;    
	 	
	Возврат ПараметрыЗапроса; 
	
КонецФункции


