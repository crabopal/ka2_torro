&НаКлиенте
Процедура ПанельНавигацииПоказатьСкрыть(Команда)
		
	Элементы.Навигация.Видимость = ИспользоватьНавигацию;  
	ВариантыНавигацииПриСменеСтраницы();

КонецПроцедуры


&НаКлиенте
Процедура ВариантОтбораПриИзменении()
	
	// Удаление всех наложенных отборов.
	ПодборТаблицаНоменклатура.Отбор.Элементы.Очистить();
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"ВидЦеныНоменклатуры", Объект.ВидЦен, Истина);
		
	ЗаполнитьПодборПоСправочнику(); 
	
	Элементы.ВидыНоменклатуры.ТекущаяСтрока = Неопределено;
	Элементы.ИерархияНоменклатуры.ТекущаяСтрока = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВсеОтборыСервер()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Родитель",Неопределено,ВидСравненияКомпоновкиДанных.ВИерархии, ,Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"ВидНоменклатуры",Неопределено,ВидСравненияКомпоновкиДанных.Равно, ,Ложь);	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Производитель",Неопределено,ВидСравненияКомпоновкиДанных.Равно, ,Ложь);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантыНавигацииПриСменеСтраницы()
	
	ОбновитьВсеОтборыСервер();
	
	Если НЕ ИспользоватьНавигацию Тогда
		Возврат;
	КонецЕсли;
	
	Если ВариантНавигации = "По Иерархии" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияИерархияНоменклатуры; 
		
	ИначеЕсли ВариантНавигации = "Производители" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияПроизводители;
		
	ИначеЕсли ВариантНавигации = "Виды номенклатуры" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияВидыНоменклатуры;
		
	ИначеЕсли ВариантНавигации = "Ценовые группы" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияЦеновыеГруппы;		
		
	ИначеЕсли ВариантНавигации = "Поисковые слова" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияСлова;	 
		
	ИначеЕсли ВариантНавигации = "Прайсы" Тогда
		
		Элементы.ВариантыНавигации.ТекущаяСтраница = Элементы.НавигацияПрайсы;		
		
	КонецЕсли;

	ВариантОтбораПриИзменении();
	
	ТекущаяСтраницаНавигации = Элементы.ВариантыНавигации.ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияПриАктивизацииСтроки(Элемент)
	
	//Если ЭтаФорма.ТекущийЭлемент = Элементы.ПодборТаблицаНоменклатура Тогда
	//	Возврат
	//КонецЕсли;
	
	Если НЕ ИспользоватьНавигацию Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтраницаНавигации = Элементы.ВариантыНавигации.ТекущаяСтраница;
	
	Если ТекущаяСтраницаНавигации = Элементы.НавигацияИерархияНоменклатуры Тогда
		
		ТекущиеДанные = Элементы.ИерархияНоменклатуры.ТекущиеДанные; 
		
		Если ТекущиеДанные = Неопределено Тогда  
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Родитель",Неопределено,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"Родитель",Ложь);
		Иначе          
			ГруппаНоменклатуры = ТекущиеДанные.Ссылка;
			
			СписокОтбора = Новый СписокЗначений;
			ВыделенныеСтроки = Элементы.ИерархияНоменклатуры.ВыделенныеСтроки;	
			Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
				ДанныеСтроки = Элементы.ИерархияНоменклатуры.ДанныеСтроки(СтрВыд);	  
				Если ДанныеСтроки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
			КонецЦикла;
			
			ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Родитель",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"Родитель",ИспользоватьПодбор);
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияВидыНоменклатуры Тогда		
		
		СписокОтбора = Новый СписокЗначений;
		ВыделенныеСтроки = Элементы.ВидыНоменклатуры.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ВидыНоменклатуры.ДанныеСтроки(СтрВыд);	 
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;
		
		ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"ВидНоменклатуры",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"ВидНоменклатуры",ИспользоватьПодбор);    
		
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияЦеновыеГруппы Тогда		
		
		СписокОтбора = Новый СписокЗначений;
		ВыделенныеСтроки = Элементы.ЦеновыеГруппы.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ЦеновыеГруппы.ДанныеСтроки(СтрВыд);	 
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;
		
		ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"ЦеноваяГруппа",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"ЦеноваяГруппа",ИспользоватьПодбор);
	
																			
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияПроизводители Тогда		
		
		СписокОтбора = Новый СписокЗначений;
		ВыделенныеСтроки = Элементы.ПроизводителиНоменклатуры.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ПроизводителиНоменклатуры.ДанныеСтроки(СтрВыд);	
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;
		
		ИспользоватьПодбор = ?(СписокОтбора.Количество() > 0, Истина, Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Производитель",СписокОтбора,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,"Производитель",ИспользоватьПодбор);																																							
		
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияСлова Тогда		
				
		ТекущиеДанные = Элементы.НавигацияПоисковыеСлова.ТекущиеДанные; 
		Если ТекущиеДанные = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		Если ТекущиеДанные.ЗначениеОтбора = "[Вся номенклатура]" Тогда      
			СтрокаПоиска = ""; 
			СтрокаПоискаОчистка();     
		Иначе
			Если СтрокаПоиска <> ТекущиеДанные.ЗначениеОтбора Тогда 
				СтрокаПоиска = ТекущиеДанные.ЗначениеОтбора; 
				СтрокаПоискаПриИзменении();     
			КонецЕсли;
		КонецЕсли;       
		
	ИначеЕсли ТекущаяСтраницаНавигации = Элементы.НавигацияПрайсы Тогда		
				
		СписокОтбора = Новый Массив;
		ВыделенныеСтроки = Элементы.ПрайсыПоставщиков.ВыделенныеСтроки;	
		Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
			ДанныеСтроки = Элементы.ПрайсыПоставщиков.ДанныеСтроки(СтрВыд);	
			Если ДанныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокОтбора.Добавить(ДанныеСтроки.Ссылка);
		КонецЦикла;
		
		ОтборВНаличииУПоставщиков = ?(СписокОтбора.Количество() > 0, Истина, Ложь);          
		
		Если ОтборВНаличииУПоставщиков Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"ПрайсПартнераОтбор", СписокОтбора, Истина);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПодборТаблицаНоменклатура,"ПрайсПартнераОтбор", СписокОтбора, Ложь);
		КонецЕсли;    
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"ОстаткиПоставщиков",0,ВидСравненияКомпоновкиДанных.Больше,"ОстаткиПоставщиков",ОтборВНаличииУПоставщиков); 
		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборТолькоВНаличииПриИзменении(Элемент)	
		
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,,"ОстаткиНоменклатуры");

	ГруппаОтбораОстатки = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
	ОбщегоНазначенияУТКлиентСервер.ПолучитьОтборДинамическогоСписка(ПодборТаблицаНоменклатура).Элементы,
	"ОстаткиНоменклатуры",
	ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"ВНаличииОстаток",0,ВидСравненияКомпоновкиДанных.Больше,"ВНаличииОстаток",ОтборТолькоВНаличии);	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"Свободно",0,ВидСравненияКомпоновкиДанных.Больше,"Свободно",ОтборТолькоСвободно);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"ОстаткиПоставщиков",0,ВидСравненияКомпоновкиДанных.Больше,"ОстаткиПоставщиков",ОтборВНаличииУПоставщиков);  
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"ЗаказаноОстаток",0,ВидСравненияКомпоновкиДанных.Больше,"ЗаказаноОстаток",ОтборЗаказаноПоставщикам); 
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"ПоступитОстаток",0,ВидСравненияКомпоновкиДанных.Больше,"ПоступитОстаток",ОтборЗаказаноПоставщикам);  
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"КомиссияОстатки",0,ВидСравненияКомпоновкиДанных.Больше,"КомиссияОстатки",ОтборКомиссия);
    ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"РезервыОстаток",0,ВидСравненияКомпоновкиДанных.Больше,"РезервыОстаток",ОтборРезервы);   
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"РезервПриход",0,ВидСравненияКомпоновкиДанных.Больше,"РезервПриход",ОтборРезервы);
    ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораОстатки,"КОбеспечениюОстаток",0,ВидСравненияКомпоновкиДанных.Больше,"КОбеспечениюОстаток",ОтборОбеспечить);     
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Мегадата",МегадатаНовинок,ВидСравненияКомпоновкиДанных.БольшеИлиРавно,"Мегадата",ЗначениеЗаполнено(МегадатаНовинок));
	
КонецПроцедуры




//============================================================================
// ПОДБОР ПО СПРАВОЧНИКУ

&НаСервереБезКонтекста
Процедура ПоискПоПодстрокеНаСервере(СписокПоискНоменклатуры,СтруктураПараметров)
	
	МегаПомощникПродажСервер.ПоискПоПодстрокеНаСервере(СписокПоискНоменклатуры,СтруктураПараметров);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодборПоСправочнику()
			
	Если ЗначениеЗаполнено(СтрокаПоиска) И СписокПоискНоменклатуры.Количество() > 0 Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Ссылка",СписокПоискНоменклатуры,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
		ЭтаФорма.ТекущийЭлемент = Элементы.ПодборТаблицаНоменклатура;
	Иначе              
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Ссылка",Неопределено,ВидСравненияКомпоновкиДанных.Равно,,Ложь);
	КонецЕсли;	
	
КонецПроцедуры     


&НаКлиенте
Процедура СтрокаПоискаОчистка()
	
	РезультатПоиска = Истина;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПодборТаблицаНоменклатура,"Ссылка",Неопределено,ВидСравненияКомпоновкиДанных.Равно,,Ложь);
	
	СписокПоискНоменклатуры.Очистить();	 
	
	Элементы.СтрокаПоиска.ЦветФона = Новый Цвет();
	Элементы.СтрокаПоиска.ЦветТекста = Новый Цвет();
	Элементы.СтрокаПоиска.Шрифт = Новый Шрифт(,,Ложь);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСловатьАвтозаменСлов(Строка) Экспорт
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат "";
	КонецЕсли;
	
	МассивСлов = СтрРазделить(Строка," "); 
	НовыйМассив = Новый Массив;
	
	Для Каждого Стр Из МассивСлов Цикл	
		
		НайденаНоменклатура = Новый Структура;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	мегапрайсСловарьАвтозамен.ЧтоЗаменить КАК ЧтоЗаменить,
		|	мегапрайсСловарьАвтозамен.ЗначениеЗамены КАК ЗначениеЗамены
		|ИЗ
		|	РегистрСведений.мегапрайсСловарьАвтозамен КАК мегапрайсСловарьАвтозамен
		|ГДЕ
		|	мегапрайсСловарьАвтозамен.ЧтоЗаменить = &ЧтоЗаменить";
		
		Запрос.УстановитьПараметр("ЧтоЗаменить", Стр);		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = Выборка.ЗначениеЗамены;
		КонецЦикла;
		
		НовыйМассив.Добавить(Стр);
	КонецЦикла;
	
	Строка = СтрСоединить(НовыйМассив," "); 
	Возврат Строка;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИнформацияСоответствияСтроки_Отчет(ТаблицаОтчета, ПараметрыЗапроса, Очищать = Истина)
	
	МегапоискСервер.Суперпоиск_ВывестиДетальноОтчет(ТаблицаОтчета, ПараметрыЗапроса, Очищать);      
	
	ПараметрыЗапроса.Вставить("ВиртуальнаяНоменклатура", Истина);
	СтруктураИнформации = МегапоискСервер.ВыполнитьПоискСоответствий_МегапрайсРегистр(ПараметрыЗапроса);	
	МегапоискСервер.Суперпоиск_ВывестиДетальноОтчет(ТаблицаОтчета, СтруктураИнформации, Ложь);

КонецПроцедуры

&НаКлиенте
Функция СтрокаПоискаПриИзмененииВыполнить()
	
	РезультатПоиска = Истина;
	
	Если Объект.ИспользоватьМегапрайс Тогда
		СтрокаПоиска = ПроверитьСловатьАвтозаменСлов(СтрокаПоиска);
	КонецЕсли;  
	
	Если ПоискУбратьМусор Тогда
		СтрокаПоиска = СтрЗаменить(СтрокаПоиска,"-"," ");
		СтрокаПоиска = СтрЗаменить(СтрокаПоиска,"/"," ");
		СтрокаПоиска = СтрЗаменить(СтрокаПоиска,"("," ");
		СтрокаПоиска = СтрЗаменить(СтрокаПоиска,")"," ");
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИспользоватьМегапрайс", Объект.ИспользоватьМегапрайс);
	СтруктураПараметров.Вставить("ВключитьАналогиНоменклатуры", ВключитьАналогиНоменклатуры);  
	СтруктураПараметров.Вставить("ВключитьСовместноПродаваемые", ВключитьСовместноПродаваемые);

	СтруктураПараметров.Вставить("СтрокаПоиска", СтрокаПоиска);
	СтруктураПараметров.Вставить("ПоискУсловиеИЛИ", ПоискУсловиеИЛИ);  
	СтруктураПараметров.Вставить("ПоискПрерыватьЕслиНайдено", ПоискПрерыватьЕслиНайдено);

	СтруктураПараметров.Вставить("ПоискПоКоду", ПоискПоКоду);
	СтруктураПараметров.Вставить("ПоискПоАртикулу", ПоискПоАртикулу);
	СтруктураПараметров.Вставить("ПоискВНаименовании", ПоискВНаименовании);
	СтруктураПараметров.Вставить("ПоискВПолномНаименовании", ПоискВПолномНаименовании);
	СтруктураПараметров.Вставить("ПоискПоОписанию", ПоискПоОписанию);
	СтруктураПараметров.Вставить("ПоискПоШтрихкоду", ПоискПоШтрихкоду);
	СтруктураПараметров.Вставить("ПоискПоСвойству", ПоискПоСвойству);
	СтруктураПараметров.Вставить("ВидСвойства", ВидСвойства);     
	
	ПоискПоПодстрокеНаСервере(СписокПоискНоменклатуры,СтруктураПараметров);	
	
	КоличествоНайдено = СписокПоискНоменклатуры.Количество(); 
		
	ЗаполнитьПодборПоСправочнику();	       
	
	Если КоличествоНайдено > 0 Тогда
		ПараметрыОтбора = Новый Структура();
		ПараметрыОтбора.Вставить("ЗначениеОтбора",СтрокаПоиска); 
		Строки = НавигацияПоисковыеСлова.НайтиСтроки(ПараметрыОтбора);
		Если Строки.Количество() = 0 Тогда  
			НоваяФраза = НавигацияПоисковыеСлова.Добавить();  
			НоваяФраза.ЗначениеОтбора = СтрокаПоиска;  
			НоваяФраза.Количество = КоличествоНайдено;    
			Попытка      
				Элементы.НавигацияПоисковыеСлова.ТекущаяСтрока = НоваяФраза.ПолучитьИдентификатор();
			Исключение
			КонецПопытки;   
		Иначе
			Попытка      
				Элементы.НавигацияПоисковыеСлова.ТекущаяСтрока = Строки[0].ПолучитьИдентификатор();
				Строки[0].Количество = КоличествоНайдено;
			Исключение
			КонецПопытки;                                                           
		КонецЕсли;                 
		Элементы.СтрокаПоиска.ЦветФона = WebЦвета.СветлоЗеленый; 
		Элементы.СтрокаПоиска.ЦветТекста = WebЦвета.Зеленый; 
		Элементы.СтрокаПоиска.Шрифт = Новый Шрифт(,,Истина);     
		
		СпискиВыбораКлиентСервер.ОбновитьСписокВыбора(Элементы.СтрокаПоиска.СписокВыбора, СтрокаПоиска, 21);
	Иначе                                                  
		Элементы.СтрокаПоиска.ЦветФона = WebЦвета.СветлоРозовый; 
		Элементы.СтрокаПоиска.ЦветТекста = WebЦвета.Красный; 
		Элементы.СтрокаПоиска.Шрифт = Новый Шрифт(,,Истина);
		РезультатПоиска = Ложь;
	КонецЕсли;    
	
	Возврат РезультатПоиска;
			
КонецФункции    

&НаКлиенте
Процедура СтрокаПоискаПриИзменении()
	
	СписокПоискНоменклатуры.Очистить();   
	
	Если НЕ ЗначениеЗаполнено(СтрокаПоиска) Тогда  
		Возврат;
	КонецЕсли;
	
	РезультатПоиска = СтрокаПоискаПриИзмененииВыполнить(); 
	
	Если РезультатПоиска = Ложь Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.СтрокаПоиска;     
		
		//ПараметрыЗапроса = ПолучитьПараметрыПодбора();   
		//ПараметрыЗапроса.Вставить("ПоисковаяСтрока", СтрокаПоиска);
		//ТаблицаПоставщикиПрайсы = МегапрайсРасшифровкиСервер.Мегапрайс_ПрайсыПоставщиков(ПараметрыЗапроса); 
		//ЭтаФорма.ТекущийЭлемент = Элементы.ВкладкаПодборПоПрайсам;
	КонецЕсли;

КонецПроцедуры    


&НаКлиенте
Процедура АктивироватьПоиск(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПоискПоАртикулу", ПоискПоАртикулу);
	СтруктураПараметров.Вставить("ПоискВНаименовании", ПоискВНаименовании);
	СтруктураПараметров.Вставить("ПоискВПолномНаименовании", ПоискВПолномНаименовании);	
	
	Попытка
		СтруктураВозврата = ОткрытьФормуМодально("ВнешняяОбработка.мегапрайсПомощникПродаж.Форма.ФормаПоисковаяСтрока",СтруктураПараметров,ЭтаФорма); 
	Исключение
		СтруктураВозврата = ОткрытьФормуМодально("Обработка.мегапрайсПомощникПродаж.Форма.ФормаПоисковаяСтрока",СтруктураПараметров,ЭтаФорма); 
	КонецПопытки;
	
	Если СтруктураВозврата <> Неопределено Тогда
		СтрокаПоиска = СтруктураВозврата.СтрокаПоиска;
		ПоискПоАртикулу = СтруктураВозврата.ПоискПоАртикулу;
		ПоискВНаименовании = СтруктураВозврата.ПоискВНаименовании;
		ПоискВПолномНаименовании = СтруктураВозврата.ПоискВПолномНаименовании;	
		
		ЗаполнитьПодборПоСправочнику();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоиск(Команда)
	
	СтрокаПоиска = ""; 
	
	ЗаполнитьПодборПоСправочнику();
	
КонецПроцедуры




