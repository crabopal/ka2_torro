
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	
	Объект.НачалоПериода = Параметры.НачалоПериода; 
	Объект.КонецПериода = Параметры.КонецПериода;  
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Объект.НачалоПериода = НачалоГода(ТекущаяДата());
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.КонецПериода) Тогда
		Объект.КонецПериода = КонецДня(ТекущаяДата());
	КонецЕсли;
	
	ПоказатьРасшифровки = Параметры.ПоказатьРасшифровки; 	
	
	Если Параметры.Свойство("ОтчетБуфер1") Тогда
		ОтчетБуфер1 = Параметры.ОтчетБуфер1; 
		ОтчетБуфер2 = Параметры.ОтчетБуфер2;  
		ОтчетБуфер3 = Параметры.ОтчетБуфер3;    
	КонецЕсли;        
	
	Если Параметры.Свойство("ОтчетБуферНазвание1") Тогда
		ОтчетБуферНазвание1 = Параметры.ОтчетБуферНазвание1; 
		ОтчетБуферНазвание2 = Параметры.ОтчетБуферНазвание2;  
		ОтчетБуферНазвание3 = Параметры.ОтчетБуферНазвание3;
	КонецЕсли;


КонецПроцедуры


&НаКлиенте
Процедура Применить(Команда)
	
	СтруктураПараметров = Новый Структура;                 
	СтруктураПараметров.Вставить("НачалоПериода",Объект.НачалоПериода);  
	СтруктураПараметров.Вставить("КонецПериода",Объект.КонецПериода);   
	
	СтруктураПараметров.Вставить("ПоказатьРасшифровки",ПоказатьРасшифровки);    
	
	СтруктураПараметров.Вставить("ОтчетБуфер1",ОтчетБуфер1); 
	СтруктураПараметров.Вставить("ОтчетБуфер2",ОтчетБуфер2);  
	СтруктураПараметров.Вставить("ОтчетБуфер3",ОтчетБуфер3);    
	
	СтруктураПараметров.Вставить("ОтчетБуферНазвание1",ОтчетБуферНазвание1); 
	СтруктураПараметров.Вставить("ОтчетБуферНазвание2",ОтчетБуферНазвание2);  
	СтруктураПараметров.Вставить("ОтчетБуферНазвание3",ОтчетБуферНазвание3);  


	Закрыть(СтруктураПараметров);
	
КонецПроцедуры


//============================================================================
//ПАРАМЕТРЫ ОТЧЕТОВ

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ПараметрыВыбора = Новый Структура("НачалоПериода,КонецПериода", Объект.НачалоПериода, Объект.КонецПериода);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыВыбора, Элементы.ВыбратьПериод, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора, "НачалоПериода,КонецПериода");
	
КонецПроцедуры

