

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Склад = Параметры.Склад;  
	Менеджер = Параметры.Менеджер;  
	БизнесРегион = Параметры.БизнесРегион; 
	Номенклатура = Параметры.Номенклатура;

КонецПроцедуры


&НаКлиенте
Процедура Сформировать(Команда)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("БизнесРегион", БизнесРегион);
	ПараметрыФормы.Вставить("Склад", Склад);  	
	ПараметрыФормы.Вставить("Менеджер", Менеджер);   
	ПараметрыФормы.Вставить("Номенклатура", Номенклатура);       	
	
	Закрыть(ПараметрыФормы);

КонецПроцедуры

