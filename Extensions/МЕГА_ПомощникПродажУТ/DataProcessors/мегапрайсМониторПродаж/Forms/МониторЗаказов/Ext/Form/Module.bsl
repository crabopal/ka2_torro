&НаКлиенте
Перем Подсветка_КешСтрок;   




&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантНавигации = "Партнеры"; 
	
	Если НЕ ЗначениеЗаполнено(Сортировка) Тогда
		Сортировка = "Дата документа";
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура();  
	ПараметрыЗапроса.Вставить("Менеджер", Менеджер); 
	ПараметрыЗапроса.Вставить("Склад", Склад);

	ОбновитьМониторЗаказов(ПараметрыЗапроса);
	ОбновитьНавигацию_ЗаполнитьДаннымиСервер();
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗаметкиСписок,"Предмет", ТекущийЗаказДокумент, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ВыводитьИерархию = 1;
	
	Объект.НачалоПериода = НачалоМесяца(ТекущаяДата());
	Объект.КонецПериода  = КонецДня(ТекущаяДата());
	
КонецПроцедуры



//============================================================================
// ЖУРНАЛ ЗАКАЗОВ


&НаКлиенте
Процедура ВариантНавигацииПриИзменении()
	
	НавигацияТаблица.Очистить();
	НавигацияОтборСписок.Очистить();

	ОбновитьНавигацию_ЗаполнитьДанными();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьМониторЗаказов(ПараметрыЗапроса)
	
	ТаблицаЗаказовСтатусы.Очистить();
	КанбанТаблица.Очистить();
	
	МегапрайсМониторыЗаказов.СформироватьКанбанЗаказовПокупателей(ТаблицаЗаказовСтатусы, КанбанТаблица, ПараметрыЗапроса);
	ТаблицаОтгрузкаПоДатам = МегапрайсМониторыЗаказов.СформироватьГрафикЗаказовПокупателей(ПараметрыЗапроса); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНавигацию_ЗаполнитьДанными()
	
	ОбновитьНавигацию_ЗаполнитьДаннымиСервер();
		
КонецПроцедуры  

&НаСервере
Процедура ОбновитьНавигацию_ЗаполнитьДаннымиСервер()
	
	ПараметрыЗапроса = Новый Структура(); 
	ПараметрыЗапроса.Вставить("ВидДокумента", "ЗаказПокупателя");
    ПараметрыЗапроса.Вставить("Менеджер", Менеджер);  
	ПараметрыЗапроса.Вставить("ВариантНавигации", ВариантНавигации);
	
	МегапрайсМониторыЗаказов.ОбновитьНавигацию_ЗаполнитьДаннымиСервер(НавигацияТаблица, ПараметрыЗапроса); 
	
КонецПроцедуры



&НаКлиенте
Процедура КомандаОбновитьМониторЗаказов()
		
	ПараметрыЗапроса = Новый Структура();  
	ПараметрыЗапроса.Вставить("Менеджер", Менеджер);   
	ПараметрыЗапроса.Вставить("Склад", Склад);       
	ПараметрыЗапроса.Вставить("Номенклатура", Номенклатура);  
	ПараметрыЗапроса.Вставить("БизнесРегион", БизнесРегион);
	
	ОписаниеОповещение = Новый ОписаниеОповещения("КомандаОбновитьМониторЗаказов_Завершение", ЭтаФорма, ПараметрыЗапроса);  

	ОткрытьФорму("Обработка.мегапрайсМониторПродаж.Форма.ФормаСформировать",ПараметрыЗапроса,ЭтотОбъект,,,,ОписаниеОповещение);   

КонецПроцедуры   

&НаКлиенте
Процедура КомандаОбновитьМониторЗаказов_Завершение(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	Менеджер = РезультатЗакрытия.Менеджер;  
	Склад = РезультатЗакрытия.Склад;   
	Номенклатура = РезультатЗакрытия.Номенклатура;
	БизнесРегион = РезультатЗакрытия.БизнесРегион;
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("Сортировка", Сортировка);
	ПараметрыЗапроса.Вставить("Менеджер", Менеджер);   
	ПараметрыЗапроса.Вставить("Склад", Склад);  
	ПараметрыЗапроса.Вставить("Номенклатура", Номенклатура); 
	ПараметрыЗапроса.Вставить("БизнесРегион", БизнесРегион);
	
	ОбновитьНавигацию_ЗаполнитьДанными();
	ОбновитьМониторЗаказов(ПараметрыЗапроса); 
	
КонецПроцедуры



//============================================================================
// 

&НаКлиенте
Процедура НавигацияЗаказовПриАктивизацииСтроки(Элемент)
	
	Если НЕ ЭтаФорма.ТекущийЭлемент = Элементы.НавигацияТаблица Тогда  
		Возврат;
	КонецЕсли;   
	
	ПараметрыЗапроса = Новый Структура();  
	ПараметрыЗапроса.Вставить("Менеджер", Менеджер); 
	ПараметрыЗапроса.Вставить("ВариантНавигации", ВариантНавигации);	
	ПараметрыЗапроса.Вставить("НавигацияОтборСписок", Неопределено);

	ТекущиеДанные = Элементы.НавигацияТаблица.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;     
	
	НавигацияОтборСписок.Очистить();
	ВыделенныеСтроки = Элементы.НавигацияТаблица.ВыделенныеСтроки;	
	Для Каждого СтрВыд Из ВыделенныеСтроки Цикл       
		ДанныеСтроки = Элементы.НавигацияТаблица.ДанныеСтроки(СтрВыд);	  
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;     
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ЗначениеОтбора) Тогда
			Продолжить;
		КонецЕсли;
		НавигацияОтборСписок.Добавить(ДанныеСтроки.ЗначениеОтбора);
	КонецЦикла;      	

	ИспользоватьОтбор = ?(НавигацияОтборСписок.Количество() > 0, Истина, Ложь);
	Если ИспользоватьОтбор Тогда
		ПараметрыЗапроса.Вставить("НавигацияОтборСписок", НавигацияОтборСписок);  
	КонецЕсли;
	
	ОбновитьМониторЗаказов(ПараметрыЗапроса);   
	
КонецПроцедуры


&НаКлиенте
Процедура ОткрытьПомощникПродаж(Команда)

	ОткрытьФорму("Обработка.мегапрайсПомощникПродаж.Форма.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗапросПоставщикам(Команда) 
	
	ОткрытьФорму("Документ.мегапрайсВиртуальныйЗаказ.Форма.ФормаСписка");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурналЗаказов(Команда)
	
	ОткрытьФорму("Документ.ЗаказКлиента.Форма.ФормаСпискаДокументов");

КонецПроцедуры



