&НаКлиенте
Процедура ОтчетБуфер_СделатьОтчет(ПараметрыЗапроса)
	
	
	АктивныйОтчетБуфер = "";
	
	ТекСтраница = Элементы.МегаПанельРасшифровок.ТекущаяСтраница;
	Если ТекСтраница = Элементы.ДопЛюбойОтчет1 Тогда
		АктивныйОтчетБуфер = ОтчетБуфер1;      
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет2 Тогда 
		АктивныйОтчетБуфер = ОтчетБуфер2;      
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет3 Тогда 
		АктивныйОтчетБуфер = ОтчетБуфер3;     
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АктивныйОтчетБуфер) Тогда  
		Возврат;
	КонецЕсли;
			
	ПараметрыЗапроса.Вставить("УникальныйИдентификатор", ЭтотОбъект.УникальныйИдентификатор);
	ПараметрыЗапроса.Вставить("АктивныйОтчетБуфер", АктивныйОтчетБуфер);    
	
	Если ЗначениеЗаполнено(ОтчетДанныеРасшифровки) И ЭтоАдресВременногоХранилища(ОтчетДанныеРасшифровки) Тогда
		УдалитьИзВременногоХранилища(ОтчетДанныеРасшифровки);
	КонецЕсли;

	Если ТекСтраница = Элементы.ДопЛюбойОтчет1 Тогда    
		ТаблицаБуфер1 = МегапрайсМониторыЗаказов.ОтчетБуфер_СформироватьОтчетСервер(ПараметрыЗапроса, ОтчетДанныеРасшифровки);  
		//Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаБуфер1, "ТаблицаБуфер1");  
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет2 Тогда   
		ТаблицаБуфер2 = МегапрайсМониторыЗаказов.ОтчетБуфер_СформироватьОтчетСервер(ПараметрыЗапроса, ОтчетДанныеРасшифровки);   
		//Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаБуфер2, "ТаблицаБуфер2"); 
	ИначеЕсли ТекСтраница = Элементы.ДопЛюбойОтчет3 Тогда  
		ТаблицаБуфер3 = МегапрайсМониторыЗаказов.ОтчетБуфер_СформироватьОтчетСервер(ПараметрыЗапроса, ОтчетДанныеРасшифровки);  
		//Расшифровки_НайтиНоменклатуруВОтчетах(ТаблицаБуфер3, "ТаблицаБуфер3"); 
	КонецЕсли;  	     

КонецПроцедуры



&НаКлиенте
Процедура ПодсветкаТекущейСтроки_ДопТаб(ИмяТаблицы)     
	
	Попытка
		ТаблицаОтчета = ЭтотОбъект[ИмяТаблицы]; 
	Исключение   
		Возврат;
	КонецПопытки;
	
	Попытка
		ВысотаТаблицы = ТаблицаОтчета.ВысотаТаблицы;   
		Если ВысотаТаблицы = 0 Тогда
			Возврат;
		КонецЕсли;    
	Исключение   
		Возврат;
	КонецПопытки;   
	
	ИмяОбласти = ТаблицаОтчета.ТекущаяОбласть.Имя; 
	Если ИмяОбласти = "T" Тогда
		Возврат;
	КонецЕсли;
	Разделитель = Найти(ИмяОбласти,":");  
	Если Разделитель > 0 Тогда
		Возврат;
	КонецЕсли;

	НомерСтрокиТаб = ТаблицаОтчета.ТекущаяОбласть.Верх;    
	НомерКолонкиТаб = ТаблицаОтчета.ТекущаяОбласть.Лево; 
	//Сообщить(НомерСтрокиТаб);                 	
		
	Если НомерСтрокиТаб = "" ИЛИ НомерСтрокиТаб < 2 Тогда
		Возврат;
	КонецЕсли;
	
	ВысотаТаблицы = ТаблицаОтчета.ВысотаТаблицы;   
	Если НомерСтрокиТаб > ВысотаТаблицы Тогда
		Возврат;
	КонецЕсли;    
			
	ШиринаТаблицы = ТаблицаОтчета.ШиринаТаблицы;   
	
	ЛинияДнойная = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.БольшойПунктир,2); 
	ЛинияОбычная = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Точечная); 
	ЛинияУбрать = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	
	НомерСтрокиДо = Подсветка_КешСтрок.Получить(ИмяТаблицы);
	Если НЕ НомерСтрокиДо = Неопределено  Тогда  
		ИзменяемаяОбласть = ТаблицаОтчета.Область(НомерСтрокиДо,1,НомерСтрокиДо,ШиринаТаблицы);
		ИзменяемаяОбласть.ГраницаСверху = ЛинияУбрать;  
		ИзменяемаяОбласть.ГраницаСнизу = ЛинияОбычная; 
		ИзменяемаяОбласть.ЦветРамки = WebЦвета.ТемноСерый;   
	КонецЕсли;    
	
	Подсветка_КешСтрок.Вставить(ИмяТаблицы,НомерСтрокиТаб);
	ИзменяемаяОбласть = ТаблицаОтчета.Область(НомерСтрокиТаб,1,НомерСтрокиТаб,ШиринаТаблицы);  
	ИзменяемаяОбласть.ГраницаСверху = ЛинияДнойная;  
	ИзменяемаяОбласть.ГраницаСнизу = ЛинияДнойная; 
	ИзменяемаяОбласть.ЦветРамки = WebЦвета.НейтральноСерый;    	

КонецПроцедуры





Подсветка_КешСтрок = Новый Соответствие;








