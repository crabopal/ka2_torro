&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ПараметрыВыбора = Новый Структура("НачалоПериода,КонецПериода", Объект.НачалоПериода, Объект.КонецПериода);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериода", ПараметрыВыбора, Элементы.ВыбратьПериод, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора, "НачалоПериода,КонецПериода");  
	
	Если КонецДня(Объект.КонецПериода) > КонецДня(ТекущаяДата()) Тогда
		Объект.КонецПериода = КонецДня(ТекущаяДата()); 
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Функция ПолучитьПараметрыДетальногоЗапроса(ПараметрыЗапроса = Неопределено)
	
	Если ПараметрыЗапроса = Неопределено Тогда       
		ПараметрыЗапроса = Новый Структура();
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("НачалоПериода", Объект.НачалоПериода);
	ПараметрыЗапроса.Вставить("КонецПериода", Объект.КонецПериода);
	ПараметрыЗапроса.Вставить("Сортировка", Сортировка);  
	
	ПараметрыЗапроса.Вставить("ВидЦеныНоменклатуры", ВидЦеныНоменклатуры);   
	ПараметрыЗапроса.Вставить("ВыводитьИерархию", ВыводитьИерархию);  
	ПараметрыЗапроса.Вставить("ОтмененныеПозиции", ОтмененныеПозиции); 
	
	ПараметрыЗапроса.Вставить("Партнер", ТекущийПартнер);  
	ПараметрыЗапроса.Вставить("РасшифровкаДокумент", ТекущийЗаказДокумент); 

	ПараметрыЗапроса.Вставить("ВидДокумента", "ЗаказПокупателя");  
    ПараметрыЗапроса.Вставить("ДокументыОтборСписок", ДокументыОтборСписок);
	
	Возврат ПараметрыЗапроса; 
	
КонецФункции


&НаКлиенте
Процедура МегаДетализацияПриСменеСтраницыПосле(Элемент, ТекущаяСтраница)

	ПодключитьОбработчикОжидания("МегаПолучитьРасшифровки",0.2,Истина);

КонецПроцедуры


&НаКлиенте
Процедура МегаПолучитьРасшифровки()
		
	ПараметрыЗапроса = ПолучитьПараметрыДетальногоЗапроса();
	
	ТекСтраницаРасшифровка = Элементы.МегаПанельРасшифровок.ТекущаяСтраница;
	
	Если ТекСтраницаРасшифровка = Элементы.СоставЗаказа Тогда 
		
		ТаблицаНоменклатуры = МегапрайсМониторыЗаказов.РасшифровкиСоставЗаказаКлиента(ПараметрыЗапроса);
		
	ИначеЕсли ТекСтраницаРасшифровка = Элементы.ПоставщикиЦены Тогда    
		
		ТаблицаПоставщикиПоПрайсЛистам = МегапрайсМониторыЗаказов.ИнформацияРасшифровкаЦеныПоставщиков(ПараметрыЗапроса);
		
	ИначеЕсли ТекСтраницаРасшифровка = Элементы.ДопРасчеты Тогда    
		
		Если ЗначениеЗаполнено(ВариантОтчетаВзаиморасчеты) Тогда                  
			ПараметрыЗапроса.Вставить("УникальныйИдентификатор", ЭтотОбъект.УникальныйИдентификатор);
			ПараметрыЗапроса.Вставить("АктивныйОтчетБуфер", ВариантОтчетаВзаиморасчеты); 
			
			ТаблицаКарточкаРасчетов = МегапрайсМониторыЗаказов.ОтчетБуфер_СформироватьОтчетСервер(ПараметрыЗапроса); 
		Иначе  
			ТаблицаКарточкаРасчетов = МегапрайсМониторыЗаказов.Расшифрока_КарточкаРасчетовКлиент(ПараметрыЗапроса); 
		КонецЕсли;      
				
	ИначеЕсли ТекСтраницаРасшифровка = Элементы.МегаСравнениеЗаказов Тогда    
		
		ТаблицаСравнениеЗаказов = МегапрайсМониторыЗаказов.МегаЗаказыСравнениеЗаказов(ПараметрыЗапроса); 	
		
	ИначеЕсли ТекСтраницаРасшифровка = Элементы.СостояниеВыполнения Тогда    
		
		СформироватьСостояниеЗаказаСервер(ДокументыОтборСписок, ТаблицаСостояниеВыполнения);
		
	ИначеЕсли ТекСтраницаРасшифровка = Элементы.ИнфоЗаказ Тогда    
		
		Комментарий = Расшифровки_КомментарийЗаказа(ТекущийЗаказДокумент); 
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЗаметкиСписок,"Предмет", ТекущийЗаказДокумент, Истина);
		
	ИначеЕсли ТекСтраницаРасшифровка = Элементы.ДопЛюбойОтчет1 
		ИЛИ ТекСтраницаРасшифровка = Элементы.ДопЛюбойОтчет2
		ИЛИ ТекСтраницаРасшифровка = Элементы.ДопЛюбойОтчет3 Тогда  
		
		ОтчетБуфер_СделатьОтчет(ПараметрыЗапроса);
	
	КонецЕсли;		
	
КонецПроцедуры  


&НаСервереБезКонтекста
Процедура СформироватьСостояниеЗаказаСервер(ДокументыОтборСписок, ТаблицаСостояниеВыполнения)
	
	ТаблицаСостояниеВыполнения.Очистить();
	Отчеты.СостояниеВыполненияДокументов.СформироватьОтчетСостояниеВыполненияДокументов(ДокументыОтборСписок, ТаблицаСостояниеВыполнения);
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаСостояниеЗаказаВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Область.Расшифровка) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураПараметров = Область.Расшифровка;
	
	Если СтруктураПараметров.Действие = "ОткрытьСостояниеОбеспечения" Тогда
		
		ПараметрыФормы = ОбеспечениеВДокументахКлиент.ПараметрыФормыСостояниеОбеспеченияЗаказов("ЗАКАЗ");
		ПараметрыФормы.Заказ = СтруктураПараметров.Заказ;
		ПараметрыФормы.ТолькоПросмотр = Истина;
		ОткрытьФорму("Обработка.СостояниеОбеспеченияЗаказов.Форма",
			ПараметрыФормы,
			ЭтаФорма,
			УникальныйИдентификатор);
		
	ИначеЕсли СтруктураПараметров.Действие = "ОткрытьЗначение" Тогда
		ПоказатьЗначение(,СтруктураПараметров.Заказ);
	КонецЕсли;

КонецПроцедуры


&НаСервереБезКонтекста
Функция Расшифровки_КомментарийЗаказа(Заказ)
	
	Комментарий = Заказ.Комментарий;
	
	Возврат Комментарий;
	
КонецФункции   


&НаСервереБезКонтекста
Процедура ЗаписатьЗаказСервер(Заказ, Комментарий)  
	
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	ЗаказОбъект.Комментарий = Комментарий;  
	ЗаказОбъект.Записать();

КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьЗаказ(Команда)   
	
	ЗаписатьЗаказСервер(ТекущийЗаказДокумент, Комментарий);

КонецПроцедуры


&НаКлиенте
Процедура ЗаметкиСписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Параметр = Новый Структура("Предмет", ТекущийЗаказДокумент); 
	ОткрытьФорму("Справочник.Заметки.Форма.ФормаЭлемента", Параметр, ЭтаФорма,,,,);
	
КонецПроцедуры


//============================================================================
//ОТЧЕТЫ

&НаКлиенте
Процедура КанбанТаблицаПриАктивизации(Элемент)
	
	ИмяОбласти = Элемент.ТекущаяОбласть.Имя;  
	Если ИмяОбласти = "T" Тогда
		Возврат;
	КонецЕсли;
	Разделитель = Найти(ИмяОбласти,":"); 
	
	//Если НЕ ПоказатьРасшифровки Тогда
	//	Возврат;
	//КонецЕсли;   
	
	//Если НЕ Найти(ИмяОбласти,"R") Тогда
	//	Возврат;
	//КонецЕсли;   
	
	Попытка
		ТаблицаОтчета = ЭтотОбъект[Элемент.Имя]; 
	Исключение   
		Возврат;
	КонецПопытки;

	НомерНачСтолбца = 0;  
	НомерНачСтроки = 0; 
	НомерКонСтолбца = 0; 
	НомерКонСтроки = 0;
	
	Если Разделитель = 0 Тогда 
		НомерНачСтолбца = Сред(ИмяОбласти,Найти(ИмяОбласти,"C")+1);  
		НомерНачСтроки = Сред(ИмяОбласти,Найти(ИмяОбласти,"R")+1,Найти(ИмяОбласти,"C")-Найти(ИмяОбласти,"R")-1); 
		НомерКонСтолбца = НомерНачСтолбца; 
		НомерКонСтроки = НомерНачСтроки;      
		Если СтрНайти(ИмяОбласти, "C") = 0 Тогда     
			НомерНачСтолбца = 1;  
			НомерКонСтолбца = ТаблицаОтчета.ШиринаТаблицы; 
		ИначеЕсли СтрНайти(ИмяОбласти, "R") = 0 Тогда  
			НомерНачСтроки = 1; 
			НомерКонСтроки = ТаблицаОтчета.ВысотаТаблицы;  
		КонецЕсли;
	Иначе     
		ОбластьНачало = Лев(ИмяОбласти,Разделитель-1);
		НомерНачСтолбца = Сред(ОбластьНачало,Найти(ОбластьНачало,"C")+1);  
		НомерНачСтроки = Сред(ОбластьНачало,Найти(ОбластьНачало,"R")+1,Найти(ОбластьНачало,"C")-Найти(ОбластьНачало,"R")-1); 
		
		ОбластьКонец = Сред(ИмяОбласти,Разделитель+1);	
		НомерКонСтолбца = Сред(ОбластьКонец,Найти(ОбластьКонец,"C")+1);  
		НомерКонСтроки = Сред(ОбластьКонец,Найти(ОбластьКонец,"R")+1,Найти(ОбластьКонец,"C")-Найти(ОбластьКонец,"R")-1); 
	КонецЕсли;    
	
	//Сообщить(ИмяОбласти+"  / Столбцы "+НомерНачСтолбца+"-"+НомерКонСтолбца+"  / Строки "+НомерНачСтроки+"-"+НомерКонСтроки); 
	
	Если НомерНачСтроки = "" Тогда
		Возврат;
