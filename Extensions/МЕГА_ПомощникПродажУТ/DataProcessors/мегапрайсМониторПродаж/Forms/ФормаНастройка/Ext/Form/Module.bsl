	
	
	   	   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПолучениеМакетов(); 
	
КонецПроцедуры


&НаСервере
Процедура ПолучениеМакетов()   
	
	Попытка                               
		МакетКанбан = МегапрайсМониторыЗаказов.ЗапросМакетаМониторПродажКанбан();
	Исключение
		СтандартныйМакетКанбанНаСервере();
	КонецПопытки;     
	
	Попытка        
		МакетГрафик = МегапрайсМониторыЗаказов.ЗапросМакетаМониторПродажГрафик();
	Исключение
		СтандартныйМакетГрафикНаСервере();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СтандартныйМакетКанбан(Команда) 
	
	СтандартныйМакетКанбанНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СтандартныйМакетКанбанНаСервере() 
	
    МакетКанбан = Обработки.мегапрайсМониторПродаж.ПолучитьМакет("МакетКанбан");
	
КонецПроцедуры

&НаКлиенте
Процедура СтандартныйМакетГрафик(Команда)  
	
	СтандартныйМакетГрафикНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СтандартныйМакетГрафикНаСервере()
	
	МакетГрафик = Обработки.мегапрайсМониторПродаж.ПолучитьМакет("МакетГрафикЗаказов");
	
КонецПроцедуры


//============================================================================
//МАКЕТ КАНБАН

&НаКлиенте
Процедура ЗаписатьЗакрыть(Команда)  
	
	ЗаписатьЗакрытьНаСервере(); 
	
	Закрыть();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗакрытьНаСервере()      
	
	ИмяОбъектаМетаданныхМакета = "мегапрайсМониторПродаж"; 
	
	Запись = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	Запись.Объект = ИмяОбъектаМетаданныхМакета;
	Запись.ИмяМакета = "МегапрайсМониторПродажМакетКанбан";
	Запись.Использование = Истина;
	Запись.Макет = Новый ХранилищеЗначения(МакетКанбан, Новый СжатиеДанных(9));
	Запись.Записать();   

	
	Запись = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	Запись.Объект = ИмяОбъектаМетаданныхМакета;
	Запись.ИмяМакета = "МегапрайсМониторПродажМакетГрафик";
	Запись.Использование = Истина;
	Запись.Макет = Новый ХранилищеЗначения(МакетГрафик, Новый СжатиеДанных(9));
	Запись.Записать();   
		
КонецПроцедуры  


