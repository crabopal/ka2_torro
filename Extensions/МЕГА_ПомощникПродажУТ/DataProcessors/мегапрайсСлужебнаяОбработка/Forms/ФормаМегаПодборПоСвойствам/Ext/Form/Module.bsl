&НаКлиенте
Процедура ОчиститьПодбор()
	
	ТаблицаНоменклатура = Новый ТабличныйДокумент;	
	ТаблицаОтбора.Очистить();
	ОбновитьЭлементыТаблицыСвойств();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыТаблицыСвойств()  
	
	Для Каждого ВыборкаСтрока Из ТаблицаСвойств Цикл  
		ВыборкаСтрока.Пометка = Ложь;
	КонецЦикла;
	
	Для Каждого ВыборкаСтрока Из ТаблицаОтбора Цикл  
		ПараметрыОтбора = Новый Структура("Ссылка", ВыборкаСтрока.Свойство);
		МассивСтрок = ТаблицаСвойств.НайтиСтроки(ПараметрыОтбора); 
		
		Для Каждого Строка Из МассивСтрок Цикл
			Строка.Пометка = Истина;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры 

		 				 

&НаСервере
Процедура ПолучитьСписокЗначенийСвойства(ПараметрыЗапроса)
			
	ТаблицаЗначений.Загрузить(МегаЗагрузкаСвойств.ПолучитьСписокЗначенийСвойства(ПараметрыЗапроса));

КонецПроцедуры


&НаКлиенте
Процедура ТаблицаСвойствПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаСвойств.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееСвойство = ТекущиеДанные.Ссылка;
	
	ПараметрыЗапроса = Новый Структура();                           
	ПараметрыЗапроса.Вставить("ТаблицаОтбора", ТаблицаОтбора);  
	ПараметрыЗапроса.Вставить("ТекущееСвойство", ТекущееСвойство);		
	ПолучитьСписокЗначенийСвойства(ПараметрыЗапроса);
	
	Расшифровки_НайтиСвойствоОтчет(ТекущиеДанные.Заголовок);   
	
	Для Каждого ВыборкаСтрока Из ТаблицаОтбора Цикл  
		ПараметрыОтбора = Новый Структура("Свойство, Значение", ВыборкаСтрока.Свойство,ВыборкаСтрока.Значение);
		МассивСтрок = ТаблицаЗначений.НайтиСтроки(ПараметрыОтбора); //.Очистить();
		
		Для Каждого Строка Из МассивСтрок Цикл
			Строка.Пометка = Истина;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Расшифровки_НайтиСвойствоОтчет(ПоисковаяСтрока = "");   
		
	ВысотаТаблицы = ТаблицаНоменклатура.ВысотаТаблицы;
	ШиринаТаблицы = ТаблицаНоменклатура.ШиринаТаблицы;
	
	Если ВысотаТаблицы = 0 Тогда   
		Возврат;
	КонецЕсли; 
	
	ТекущаяОбласть = ТаблицаНоменклатура.НайтиТекст(ПоисковаяСтрока);    
	Если ТекущаяОбласть = Неопределено Тогда 
		Возврат;
	КонецЕсли; 
		
	Элементы.ТаблицаНоменклатура.ТекущаяОбласть = ТекущаяОбласть; 	
	
	Попытка              
		МассивОбластей = Новый Массив();
		ЯчейкаСтрока = ТаблицаНоменклатура.Область("C"+Формат(ТекущаяОбласть.Лево,"ЧГ=0"));
		МассивОбластей.Добавить(ЯчейкаСтрока);
		Элементы.ТаблицаНоменклатура.УстановитьВыделенныеОбласти(МассивОбластей);
	Исключение
	КонецПопытки;
	
КонецПроцедуры


&НаСервереБезКонтекста
Процедура РасшифровкаНоменклатура(ТаблицаОтчета, ПараметрыЗапроса) Экспорт
		
	ТаблицаОтчета.Очистить();   
	
	Если ПараметрыЗапроса.ТаблицаОтбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	ДатаНоменклатуры = ПараметрыЗапроса.ДатаНоменклатуры;   
	Производитель = ПараметрыЗапроса.Производитель;

	
	ЗапросТекст = 
	"ВЫБРАТЬ
	|	ТаблицаОтбора.Свойство КАК Свойство,    
	|	ТаблицаОтбора.Значение КАК Значение
	|ПОМЕСТИТЬ ВремТаблицаОтбора
	|ИЗ
	|	&ТаблицаОтбора КАК ТаблицаОтбора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИтоговаяТаблица.Номенклатура КАК Номенклатура,
	|	СУММА(ИтоговаяТаблица.СчетчикСвойств) КАК СчетчикСвойств
	|ИЗ
	|	(ВЫБРАТЬ
	|		СпрНоменклатура.Ссылка КАК Номенклатура,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СпрНоменклатура.Свойство) КАК СчетчикСвойств
	|	ИЗ
	|		Справочник.Номенклатура.ДополнительныеРеквизиты КАК СпрНоменклатура
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТаблицаОтбора КАК ВремТаблицаОтбора
	|			ПО СпрНоменклатура.Свойство = ВремТаблицаОтбора.Свойство
	|				И СпрНоменклатура.Значение = ВремТаблицаОтбора.Значение";
	Если ЗначениеЗаполнено(ДатаНоменклатуры) Тогда
		ЗапросТекст = ЗапросТекст + " И СпрНоменклатура.Ссылка.мегапрайсДатаРегистрации >= &ДатаНоменклатуры ";    
	КонецЕсли;     
	Если ЗначениеЗаполнено(Производитель) Тогда
		ЗапросТекст = ЗапросТекст + " И СпрНоменклатура.Ссылка.Производитель = &Производитель ";    
	КонецЕсли;
	ЗапросТекст = ЗапросТекст + "	
	|	СГРУППИРОВАТЬ ПО
	|		СпрНоменклатура.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РегДополнительныеСведения.Объект,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РегДополнительныеСведения.Свойство)
	|	ИЗ
	|		РегистрСведений.ДополнительныеСведения КАК РегДополнительныеСведения
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТаблицаОтбора КАК ВремТаблицаОтбора
	|			ПО РегДополнительныеСведения.Свойство = ВремТаблицаОтбора.Свойство
	|				И РегДополнительныеСведения.Значение = ВремТаблицаОтбора.Значение";
	Если ЗначениеЗаполнено(ДатаНоменклатуры) Тогда
		ЗапросТекст = ЗапросТекст + " И РегДополнительныеСведения.Объект.мегапрайсДатаРегистрации >= &ДатаНоменклатуры ";    
	КонецЕсли;     
	Если ЗначениеЗаполнено(Производитель) Тогда
		ЗапросТекст = ЗапросТекст + " И РегДополнительныеСведения.Объект.Производитель = &Производитель ";    
	КонецЕсли;
	ЗапросТекст = ЗапросТекст + "
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РегДополнительныеСведения.Объект) КАК ИтоговаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтоговаяТаблица.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(ИтоговаяТаблица.СчетчикСвойств) = &УникальностьСвойств";

	
	Запрос = Новый Запрос;  
	Запрос.Текст = ЗапросТекст;                                             
	Запрос.УстановитьПараметр("ТаблицаОтбора", ПараметрыЗапроса.ТаблицаОтбора.Выгрузить());  
	Запрос.УстановитьПараметр("ДатаНоменклатуры", ДатаНоменклатуры);   
	Запрос.УстановитьПараметр("Производитель", Производитель);
	
	ВремТаблица = ПараметрыЗапроса.ТаблицаОтбора.Выгрузить();
	ВремТаблица.Свернуть("Свойство");
	Запрос.УстановитьПараметр("УникальностьСвойств", ВремТаблица.Количество());

	РезультатЗапроса = Запрос.Выполнить();         		
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
	//Сообщить(Список.Количество());
	
	ПараметрыЗапроса = Новый Структура();                           
	ПараметрыЗапроса.Вставить("СписокОтборНоменклатуры", Список);
	
	ТаблицаОтчета = МегапрайсРасшифровкиСервер.Расшифровки_СвойстваНоменклатуры(ПараметрыЗапроса);
	
	
	ВысотаТаблицы = ТаблицаОтчета.ВысотаТаблицы;
	ШиринаТаблицы = ТаблицаОтчета.ШиринаТаблицы;
	
	Если ВысотаТаблицы = 0 Тогда   
		Возврат;
	КонецЕсли; 
	
	Для Каждого ВыборкаСтрока Из ВремТаблица Цикл  
				
		ТекущаяОбласть = ТаблицаОтчета.НайтиТекст(ВыборкаСтрока.Свойство.Заголовок);    
		Если ТекущаяОбласть = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		НомерКолонкиТаб = ТекущаяОбласть.Лево; 
		
		ИзменяемаяОбласть = ТаблицаОтчета.Область(2,НомерКолонкиТаб,ВысотаТаблицы,НомерКолонкиТаб);
		ИзменяемаяОбласть.ЦветТекста = WebЦвета.Синий;     
		ИзменяемаяОбласть.ЦветФона = WebЦвета.АкварельноСиний;  
	КонецЦикла;	
	
	//Построитель = Новый ПостроительОтчета;
	//Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(РезультатЗапроса);       
	//Построитель.Вывести(ТаблицаОтчета);  
	
	ЗапросТекст = 
	"ВЫБРАТЬ
	|	ТаблицаОтбора.Свойство КАК Свойство,
	|	ТаблицаОтбора.Значение КАК Значение
	|ПОМЕСТИТЬ ВремТаблицаОтбора
	|ИЗ
	|	&ТаблицаОтбора КАК ТаблицаОтбора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИтоговаяТаблица.Номенклатура КАК Номенклатура,
	|	СУММА(ИтоговаяТаблица.СчетчикСвойств) КАК СчетчикСвойств
	|ИЗ
	|	(ВЫБРАТЬ
	|		СпрНоменклатура.Ссылка КАК Номенклатура,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СпрНоменклатура.Свойство) КАК СчетчикСвойств
	|	ИЗ
	|		Справочник.Номенклатура.ДополнительныеРеквизиты КАК СпрНоменклатура
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТаблицаОтбора КАК ВремТаблицаОтбора
	|			ПО СпрНоменклатура.Свойство = ВремТаблицаОтбора.Свойство
	|				И СпрНоменклатура.Значение = ВремТаблицаОтбора.Значение
	|				И (СпрНоменклатура.Ссылка.мегапрайсДатаРегистрации >= &ДатаНоменклатуры)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		СпрНоменклатура.Ссылка) КАК ИтоговаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ИтоговаяТаблица.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(ИтоговаяТаблица.СчетчикСвойств) = &УникальностьСвойств";

КонецПроцедуры



&НаКлиенте
Процедура ВыполнитьПодбор(Команда)
	
	МассивНоменклатуры = Новый Массив;
	Для Ном = 2 По ТаблицаНоменклатура.ВысотаТаблицы Цикл
  
		Номенклатура = ТаблицаНоменклатура.Область(Ном,1,Ном,1).Расшифровка;  
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		МассивНоменклатуры.Добавить(Номенклатура);   
		
	КонецЦикла;  
	
	Закрыть(МассивНоменклатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗначенийПриОкончанииРедактирования()
	
	ПараметрыОтбора = Новый Структура("Свойство", ТекущееСвойство);
	МассивСтрок = ТаблицаОтбора.НайтиСтроки(ПараметрыОтбора); //.Очистить();
	
	Для Каждого Строка Из МассивСтрок Цикл
		ТаблицаОтбора.Удалить(Строка);
	КонецЦикла;
	
	Для Каждого ВыборкаСтрока Из ТаблицаЗначений Цикл  
		Если НЕ ВыборкаСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОтбора.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСтрока); 
	КонецЦикла;
	
	ОбновитьЭлементыТаблицыСвойств();
	
	ПанельВнизу_ОбновитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ЗначенияВыделитьВсе(Команда)
	
	ПараметрыОтбора = Новый Структура("Свойство", ТекущееСвойство);
	МассивСтрок = ТаблицаОтбора.НайтиСтроки(ПараметрыОтбора); //.Очистить();
	
	Для Каждого Строка Из МассивСтрок Цикл
		ТаблицаОтбора.Удалить(Строка);
	КонецЦикла;

	Для Каждого ВыборкаСтрока Из ТаблицаЗначений Цикл  
		ВыборкаСтрока.Пометка = Истина;  
		
		НоваяСтрока = ТаблицаОтбора.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСтрока); 
	КонецЦикла;
	
	ОбновитьЭлементыТаблицыСвойств(); 
	
	ПанельВнизу_ОбновитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ЗначенияСнятьВсе(Команда) 
	
	ПараметрыОтбора = Новый Структура("Свойство", ТекущееСвойство);
	МассивСтрок = ТаблицаОтбора.НайтиСтроки(ПараметрыОтбора); //.Очистить();
	
	Для Каждого Строка Из МассивСтрок Цикл
		ТаблицаОтбора.Удалить(Строка);
	КонецЦикла;

	Для Каждого ВыборкаСтрока Из ТаблицаЗначений Цикл  
		ВыборкаСтрока.Пометка = Ложь;
	КонецЦикла;
	
	ОбновитьЭлементыТаблицыСвойств();
	
	ПанельВнизу_ОбновитьДанные();
	
КонецПроцедуры



&НаКлиенте
Процедура ПанельВнизу_ОбновитьДанные()
	
	ПараметрыЗапроса = Новый Структура();                           
	ПараметрыЗапроса.Вставить("ТаблицаОтбора", ТаблицаОтбора);  
	ПараметрыЗапроса.Вставить("ДатаНоменклатуры", ДатаНоменклатуры);     
	ПараметрыЗапроса.Вставить("Производитель", Производитель);
	ПараметрыЗапроса.Вставить("ТекущееСвойство", ТекущееСвойство);
	
	
	Если Элементы.НижняяПанель.ТекущаяСтраница = Элементы.СтраницаНоменклатура Тогда
		
		РасшифровкаНоменклатура(ТаблицаНоменклатура, ПараметрыЗапроса);
		
	ИначеЕсли Элементы.НижняяПанель.ТекущаяСтраница = Элементы.СтраницаОстаткиНаСкладах Тогда
		
		ТекСтраницаФормы = Элементы.НижняяПанель.ТекущаяСтраница; 
		Если ТекСтраницаФормы = Элементы.СтраницаОстаткиНаСкладах Тогда   
			
			ТаблицаПодборПоСкладам = Новый ТабличныйДокумент;
			
			СписокОтборНоменклатуры.Очистить();
			Для Ном = 2 По ТаблицаНоменклатура.ВысотаТаблицы Цикл
				Номенклатура = ТаблицаНоменклатура.Область(Ном,1,Ном,1).Расшифровка;  
				Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
					Продолжить;
				КонецЕсли;
				СписокОтборНоменклатуры.Добавить(Номенклатура);   			
			КонецЦикла;  
			
			Если СписокОтборНоменклатуры.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
			
			ПараметрыЗапроса = Новый Структура;  
			ПараметрыЗапроса.Вставить("СписокОтборНоменклатуры",СписокОтборНоменклатуры);   
			МегаПомощникПродажСервер.СформироватьТаблицаОстаткиПоСкладам(ТаблицаПодборПоСкладам,ПараметрыЗапроса); 
			
		КонецЕсли; 
		
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура НижняяПанельПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ПанельВнизу_ОбновитьДанные();
	
КонецПроцедуры






