		 
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьТаблицуСвойств();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСвойств()
	
	ТаблицаСвойств.Очистить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.Свойство КАК Ссылка,
	|	ВложенныйЗапрос.Свойство.Наименование КАК Наименование,
	|	ВложенныйЗапрос.НаборВладелец КАК НаборВладелец
	|ИЗ
	|	(ВЫБРАТЬ
	|		НаборыДополнительныхРеквизитовИСведений.Ссылка КАК НаборВладелец,
	|		НаборыДополнительныхРеквизитовИСведений.Свойство КАК Свойство
	|	ИЗ
	|		Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитовИСведений
	|			ПО ВидыНоменклатуры.НаборСвойств = НаборыДополнительныхРеквизитовИСведений.Ссылка
	|	ГДЕ
	|		НЕ НаборыДополнительныхРеквизитовИСведений.Ссылка.ПометкаУдаления
	|	{ГДЕ
	|		НаборыДополнительныхРеквизитовИСведений.Ссылка.* КАК НаборСвойств}
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НаборыДополнительныхРеквизитовИСведений.Ссылка,
	|		НаборыДополнительныхРеквизитовИСведений.Свойство
	|	ИЗ
	|		Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК НаборыДополнительныхРеквизитовИСведений
	|			ПО ВидыНоменклатуры.НаборСвойств = НаборыДополнительныхРеквизитовИСведений.Ссылка
	|	ГДЕ
	|		НЕ НаборыДополнительныхРеквизитовИСведений.Ссылка.ПометкаУдаления
	|	{ГДЕ
	|		НаборыДополнительныхРеквизитовИСведений.Ссылка.* КАК НаборСвойств}
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОбщиеДопРеквизитыСведения.Ссылка,
	|		ОбщиеДопРеквизитыСведения.Свойство
	|	ИЗ
	|		Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ОбщиеДопРеквизитыСведения
	|	ГДЕ
	|		ОбщиеДопРеквизитыСведения.Ссылка.ИмяПредопределенногоНабора = ""Справочник_Номенклатура_Общие""
	|		И НЕ ОбщиеДопРеквизитыСведения.Ссылка.ПометкаУдаления
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОбщиеДопРеквизитыСведения.Ссылка,
	|		ОбщиеДопРеквизитыСведения.Свойство
	|	ИЗ
	|		Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК ОбщиеДопРеквизитыСведения
	|	ГДЕ
	|		ОбщиеДопРеквизитыСведения.Ссылка.ИмяПредопределенногоНабора = ""Справочник_Номенклатура_Общие""
	|		И НЕ ОбщиеДопРеквизитыСведения.Ссылка.ПометкаУдаления) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ТекстЗапроса;		
	
	ПараметрыПостроителя = ПостроительОтчета.Параметры;
	
	//Отборы = ПостроительОтчета.Отбор;
	//Если СписокНаборовСвойств.Количество() > 0 Тогда
	//	Отборы.Добавить("НаборСвойств","НаборСвойств");
	//	Отборы["НаборСвойств"].Использование = Истина;
	//	Отборы["НаборСвойств"].ВидСравнения = ВидСравнения.ВСписке;
	//	Отборы["НаборСвойств"].Значение = СписокНаборовСвойств;
	//КонецЕсли;
	
	ПостроительОтчета.Выполнить();
	РезультатЗапроса = ПостроительОтчета.Результат;
	//
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
			
		НовСтр2 = ТаблицаСвойств.Добавить();
		НовСтр2.Пометка = Истина;    
		НовСтр2.НаборВладелец = Выборка.НаборВладелец;
		НовСтр2.Ссылка = Выборка.Ссылка;
		НовСтр2.Заголовок = Выборка.Наименование;	
				
	КонецЦикла;	

КонецПроцедуры



&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьНаборыСвойствНоменклатуры();
	
КонецПроцедуры

//============================================================================
// 

&НаКлиенте
Процедура ОбновитьНаборыСвойствНоменклатуры()
	
	//////////////////////////////////////////////
	
	НаборыСвойствРеквизитов.Очистить();
	
	СоответствияНаборов = Новый Соответствие();
	
	Для Каждого ВыборкаОписание Из ТаблицаСвойств Цикл 			
		ВыборкаЗначение = ВыборкаОписание.НаборВладелец;
		
		КоличествоВхождений = СоответствияНаборов.Получить(ВыборкаЗначение);
		Если КоличествоВхождений = Неопределено Тогда     
			СоответствияНаборов.Вставить(ВыборкаЗначение, 1); 
		Иначе
			СоответствияНаборов.Вставить(ВыборкаЗначение, КоличествоВхождений+1); 
		КонецЕсли; 
	КонецЦикла;
	
	Для Каждого ВыборкаСтрока Из СоответствияНаборов Цикл 
		НоваяСтрокаСвойств = НаборыСвойствРеквизитов.Добавить();
		НоваяСтрокаСвойств.Наименование = ВыборкаСтрока.Ключ;
		НоваяСтрокаСвойств.НаборВладелец = ВыборкаСтрока.Ключ;
		НоваяСтрокаСвойств.Количество = ВыборкаСтрока.Значение;
	КонецЦикла; 

	НаборыСвойствРеквизитов.Сортировать("Наименование");	
	НоваяСтрока = НаборыСвойствРеквизитов.Вставить(0);
	НоваяСтрока.Наименование = "[Все наборы]";
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияНаборыСвойствРеквизитыПриАктивизацииСтроки(Элемент)

	ОчиститьПодбор();
	
	ТекущиеДанные = Элементы.НаборыСвойствРеквизитов.ТекущиеДанные; 
	Если ТекущиеДанные = Неопределено Тогда  
		Элементы.ТаблицаСвойств.ОтборСтрок = Неопределено;	
		Возврат;
	КонецЕсли;   
	
	ТекущийНабор = ТекущиеДанные.Наименование;
	Если ТекущийНабор = "[Все наборы]" Тогда
		Элементы.ТаблицаСвойств.ОтборСтрок = Неопределено;	
		Возврат;
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ТекущийНабор) Тогда
		Элементы.ТаблицаСвойств.ОтборСтрок = Новый ФиксированнаяСтруктура("НаборВладелец", ТекущиеДанные.НаборВладелец);
	Иначе
		Элементы.ТаблицаСвойств.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

