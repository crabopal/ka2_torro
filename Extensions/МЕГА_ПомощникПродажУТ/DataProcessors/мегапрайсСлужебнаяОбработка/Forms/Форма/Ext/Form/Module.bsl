&НаКлиенте
Процедура SubSysПерейтиНаСайтРазработчика(Команда)
	
	ЗапуститьПриложение("https://subsystems.ru/");
	
КонецПроцедуры

//============================================================================
// 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
КонецПроцедуры

&НаСервере
Процедура ПолучитьТаблицуНоменклатурыСервер() Экспорт
		
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПолучитьТаблицуНоменклатуры();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТаблицуНоменклатуры(Команда)
	
	ПолучитьТаблицуНоменклатурыСервер();
	
	Элементы.ТаблицаНоменклатуры.Видимость = Истина;

КонецПроцедуры


&НаСервере
Процедура ЗаписатьНоменклатуруНаСервере()
	
	Для Каждого Выборка Из Объект.ТаблицаНоменклатуры Цикл  
		
		НоменклатураОбъект = Выборка.Номенклатура.ПолучитьОбъект();	
		НоменклатураОбъект.мегапрайсДатаРегистрации = Выборка.Дата;
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;  
		
		НоменклатураОбъект.Записать();   
		
	КонецЦикла;            
	
	Для Каждого Выборка Из Объект.ТаблицаПроизводителей Цикл  
		
		НоменклатураОбъект = Выборка.Производитель.ПолучитьОбъект();	
		НоменклатураОбъект.мегапрайсДатаРегистрации = Выборка.Дата;
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;  
		
		НоменклатураОбъект.Записать();   
		
	КонецЦикла;


КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьНоменклатуру(Команда) 
	
	ЗаписатьНоменклатуруНаСервере(); 
	
КонецПроцедуры


&НаКлиенте
Процедура Очистить(Команда)
	
	Для Каждого Выборка Из Объект.ТаблицаНоменклатуры Цикл
		Выборка.Дата = "";	
	КонецЦикла;
	
КонецПроцедуры




