&НаКлиенте
Функция ПроверитьАлгоритмНеТрогатьСловаСЦифрами(ТекстСлова) Экспорт
		
	ПравильныеСимволы = "№0123456789-./ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	ЕстьЦифра = Ложь;
	
	Для Сч = 1 по СтрДлина(ТекстСлова) Цикл	
		ТекСимв = Сред(ТекстСлова, Сч, 1);
		
		Если ЕстьЦифра = Ложь Тогда
			Если Найти(ПравильныеСимволы, ТекСимв) > 0 Тогда
				ЕстьЦифра = Истина;  
				Возврат ЕстьЦифра; 
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ЕстьЦифра; 
	
КонецФункции 


&НаКлиенте
Функция ОбработатьКлючевыеСловаАртикулы(НаименованиеДляПоиска) Экспорт
	
	Значение = НаименованиеДляПоиска; 
	
	ПравильныеСимволы = "0123456789-";
	//ПравильныеСимволыБуквы = "QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnmЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю";
	ПравильныеСимволыБуквы = "QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm";
	
	МассивКлючевыхСлов = СтрРазделить(Значение," ");
	КоличествоСлов = МассивКлючевыхСлов.Количество();
	
	Значение = "";
	
	КоличествоКлючевыхСлов = 0;
	Для инд = 0 По КоличествоСлов - 1 Цикл	
		СтрКлючевоеСлово = МассивКлючевыхСлов[инд];

		Если СтрНачинаетсяС(СтрКлючевоеСлово,"(") Тогда
			СтрКлючевоеСлово = СтрЗаменить(СтрКлючевоеСлово,"("," ");
		КонецЕсли; 
		Если СтрЗаканчиваетсяНа(СтрКлючевоеСлово,")") Тогда
			СтрКлючевоеСлово = СтрЗаменить(СтрКлючевоеСлово,")"," ");
		КонецЕсли;
		Если СтрЗаканчиваетсяНа(СтрКлючевоеСлово,",") Тогда
			СтрКлючевоеСлово = СтрЗаменить(СтрКлючевоеСлово,",","");
		КонецЕсли;   
		
		СтрКлючевоеСлово = СокрЛП(СтрКлючевоеСлово);

		Если СтрДлина(СтрКлючевоеСлово) < 5 Тогда
			Продолжить;
		КонецЕсли;

		ЕстьБуква = 0;
		ЕстьЦифра = 0;
		
		Для Сч = 1 по СтрДлина(СтрКлючевоеСлово) Цикл	
			ТекСимв = Сред(СтрКлючевоеСлово, Сч, 1);
			
			Если Найти(ПравильныеСимволы, ТекСимв) > 0 Тогда
				ЕстьЦифра = ЕстьЦифра + 1;   
			КонецЕсли;
			
			Если Найти(ПравильныеСимволыБуквы, ТекСимв) > 0 Тогда
				ЕстьБуква = ЕстьБуква + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьЦифра = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьБуква + ЕстьЦифра < СтрДлина(СтрКлючевоеСлово) Тогда
			Продолжить;
		КонецЕсли;
		Значение = Значение+" "+СтрКлючевоеСлово;		
	КонецЦикла;
	
	Возврат Значение; 

КонецФункции      

