&НаКлиенте
Функция глСтрокаПолучитьЧисло(Строка1, БезТочек = Ложь) Экспорт 
	
	НовСтрока = "";
	
	Если БезТочек Тогда
		ПравильныеСимволы = "0123456789,.";
	Иначе
		ПравильныеСимволы = "0123456789";
	КонецЕсли;
	
	Для Сч = 1 по СтрДлина(Строка1) Цикл
		
		ТекСимв = Сред(Строка1, Сч, 1);
		
		Если Найти(ПравильныеСимволы, ТекСимв) = 0 Тогда
			НовСтрока = НовСтрока + ТекСимв;
		КонецЕсли;
		
		Если Сч = СтрДлина(Строка1) Тогда
			Если ТекСимв = "." Тогда
				НовСтрока = НовСтрока + ТекСимв;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НовСтрока;	
	
КонецФункции 



&НаКлиенте
Процедура НайтиВСтрокеСловоИзБуквИЦифр(Значение) Экспорт 
	
	ПравильныеСимволы = "0123456789";
	//ПравильныеСимволыБуквы = "QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnmЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю";
	ПравильныеСимволыБуквы = "QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm";
	
	
	МассивКлючевыхСлов = СтрРазделить(Значение," ");
	КоличествоСлов = МассивКлючевыхСлов.Количество();
	
	Значение = "";
	
	КоличествоКлючевыхСлов = 0;
	Для инд = 0 По КоличествоСлов - 1 Цикл
		КоличествоКлючевыхСлов = КоличествоКлючевыхСлов + 1;
		
		СтрКлючевоеСлово = СокрЛП(МассивКлючевыхСлов[инд]);
		
		ЕстьБуква = 0;
		ЕстьЦифра = 0;
		
		Для Сч = 1 по СтрДлина(СтрКлючевоеСлово) Цикл	
			ТекСимв = Сред(СтрКлючевоеСлово, Сч, 1);
			
			Если ЕстьЦифра = 0 Тогда
				Если Найти(ПравильныеСимволы, ТекСимв) > 0 Тогда
					ЕстьЦифра = 1;
				КонецЕсли;
			КонецЕсли;
			
			Если ЕстьБуква = 0 Тогда
				Если Найти(ПравильныеСимволыБуквы, ТекСимв) > 0 Тогда
					ЕстьБуква = 1;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		Если ЕстьБуква = 1 И ЕстьЦифра = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = Значение+" "+СтрКлючевоеСлово;
	КонецЦикла;
	
	
КонецПроцедуры   

&НаКлиенте
Функция ПолучитьМассивСтрокой(МассивРезультат) Экспорт
	
	Результат = "";
	Кол = 0;
	
	Для Каждого Строка Из МассивРезультат Цикл	
		Если Кол = 0 Тогда
			Результат = Строка; 
		Иначе	
			Результат = Результат+" "+Строка; 
		КонецЕсли;
		Кол = Кол+1;
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Функция РазложитьСтрокуНаКлючевыеСлова(Строка, ИсключитьДлина = 1)
	
	МассивРезультат = Новый Массив;	
	МассивКлючевыхСлов = СтрРазделить(Строка," ");
	
	Для Каждого ВыборкаСтрока Из МассивКлючевыхСлов Цикл
		Если СтрДлина(ВыборкаСтрока) <= ИсключитьДлина Тогда
			Продолжить;
		КонецЕсли;
		
		МассивРезультат.Добавить(ВыборкаСтрока);
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции



&НаКлиенте
Функция ВыполнитьПолучитьСловаСтроки(НаименованиеДляПоиска, ПараметрыЗапроса) Экспорт
	
	
	Попытка
		АлгоритмКлючевыеСловаАртикулы = ПараметрыЗапроса.АлгоритмКлючевыеСловаАртикулы; 
	Исключение    
		АлгоритмКлючевыеСловаАртикулы = Ложь;
	КонецПопытки; 
	
	Попытка
		АлгоритмыКлючевыхСлов = ПараметрыЗапроса.АлгоритмыКлючевыхСлов; 
	Исключение    
		АлгоритмыКлючевыхСлов = "";
	КонецПопытки;         
	
	Попытка
		АлгоритмУбиратьМусор = ПараметрыЗапроса.АлгоритмУбиратьМусор;
	Исключение    
		АлгоритмУбиратьМусор = Ложь;
	КонецПопытки;          
	
	Попытка
		АлгоритмУбратьПредлоги = ПараметрыЗапроса.АлгоритмУбратьПредлоги;
	Исключение    
		АлгоритмУбратьПредлоги = Ложь;
	КонецПопытки;      
	
	Попытка
		АлгоритмУбратьИзмерения = ПараметрыЗапроса.АлгоритмУбратьИзмерения;
	Исключение    
		АлгоритмУбратьИзмерения = Ложь;
	КонецПопытки;      
	
	Попытка
		АлгоритмУбратьОкончанияСлов = ПараметрыЗапроса.АлгоритмУбратьОкончанияСлов;
	Исключение    
		АлгоритмУбратьОкончанияСлов = 0;
	КонецПопытки;
	
	Попытка
		АлгоритмМинимальнаяДлинаСлова = ПараметрыЗапроса.АлгоритмМинимальнаяДлинаСлова;
	Исключение    
		АлгоритмМинимальнаяДлинаСлова = 0;
	КонецПопытки;    
	
	Попытка
		АлгоритмКоличествоСлов = ПараметрыЗапроса.АлгоритмКоличествоСлов;
	Исключение    
		АлгоритмКоличествоСлов = 0;
	КонецПопытки;          
			
	НаименованиеДляПоиска = ВРег(СокрЛП(НаименованиеДляПоиска));    
		
	Если АлгоритмУбиратьМусор Тогда
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,"(",""); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,")","");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,", "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,". "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,"; "," ");  
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," - "," ");  
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," % "," ");    
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," = "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,"""","");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,"«",""); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,"»","");  
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска,"№","");
	КонецЕсли;     
	
	Если АлгоритмУбратьПредлоги Тогда                        
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," В "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," И "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ИЛИ "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," С "," ");    
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," СО "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ПО "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ДО "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ИЗ "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," МЕЖДУ "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ПОД "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," НАД "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," НА "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," О "," ");  
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ОТ "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ДЛЯ "," ");  
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," НА "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," К "," ");
	КонецЕсли;   
	
	Если АлгоритмУбратьИзмерения Тогда
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," СМ "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," МЛ "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," Л "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," Г "," ");
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," М "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," ММ "," "); 
		НаименованиеДляПоиска = СтрЗаменить(НаименованиеДляПоиска," КГ "," ");
	КонецЕсли;  
	
	Если АлгоритмМинимальнаяДлинаСлова > 0 Тогда
		МассивКлючевыхСлов = СтрРазделить(НаименованиеДляПоиска," ");
		КоличествоСлов     = МассивКлючевыхСлов.Количество();
		
		НаименованиеДляПоиска = "";
		Для инд = 0 По КоличествоСлов - 1 Цикл
			СтрКлючевоеСлово = СокрЛП(МассивКлючевыхСлов[инд]);    
			Если ПроверитьАлгоритмНеТрогатьСловаСЦифрами(СтрКлючевоеСлово) Тогда    
				НаименованиеДляПоиска = НаименованиеДляПоиска+" "+СтрКлючевоеСлово;
			Иначе
				Если СтрДлина(СтрКлючевоеСлово) < АлгоритмМинимальнаяДлинаСлова Тогда	
					Продолжить;
				КонецЕсли;				
				НаименованиеДляПоиска = НаименованиеДляПоиска+" "+СтрКлючевоеСлово; 
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;    

	Если АлгоритмУбратьОкончанияСлов > 0 Тогда                               
		МассивКлючевыхСлов = СтрРазделить(НаименованиеДляПоиска," ");
		КоличествоСлов = МассивКлючевыхСлов.Количество();
		
		НаименованиеДляПоиска = "";
		
		КоличествоКлючевыхСлов = 0;
		Для инд = 0 По КоличествоСлов - 1 Цикл
			КоличествоКлючевыхСлов = КоличествоКлючевыхСлов + 1;
			
			СтрКлючевоеСлово = СокрЛП(МассивКлючевыхСлов[инд]); 
			Если СтрДлина(СтрКлючевоеСлово) > 5 Тогда 
				ВремСлово = Лев(СтрКлючевоеСлово,СтрДлина(СтрКлючевоеСлово)-АлгоритмУбратьОкончанияСлов);   
				Если СтрДлина(ВремСлово) <= 5 Тогда 
					ВремСлово = Лев(СтрКлючевоеСлово,5);
				КонецЕсли; 
				СтрКлючевоеСлово = ВремСлово; 
			КонецЕсли;
			НаименованиеДляПоиска = НаименованиеДляПоиска+" "+СтрКлючевоеСлово;	
		КонецЦикла;
	КонецЕсли;
		
	Если АлгоритмКлючевыеСловаАртикулы Тогда
		НаименованиеДляПоиска = ОбработатьКлючевыеСловаАртикулы2(НаименованиеДляПоиска);
	КонецЕсли;  
	
	Если АлгоритмКоличествоСлов > 0 Тогда
		МассивКлючевыхСлов = СтрРазделить(НаименованиеДляПоиска," ");
		КоличествоСлов = МассивКлючевыхСлов.Количество();	
		НаименованиеДляПоиска = "";
		СчетчикСлов = 0 ;
		Для инд = 0 По КоличествоСлов - 1 Цикл
			СчетчикСлов = СчетчикСлов + 1;
			СтрКлючевоеСлово = СокрЛП(МассивКлючевыхСлов[инд]);
			Если ПроверитьАлгоритмНеТрогатьСловаСЦифрами(СтрКлючевоеСлово) Тогда    
				НаименованиеДляПоиска = НаименованиеДляПоиска+" "+СтрКлючевоеСлово;
			Иначе        
				Если СчетчикСлов > АлгоритмКоличествоСлов Тогда	
					Продолжить;
				КонецЕсли;	
				НаименованиеДляПоиска = НаименованиеДляПоиска+" "+СтрКлючевоеСлово;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(НаименованиеДляПоиска) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АлгоритмыКлючевыхСлов) Тогда
		НаименованиеДляПоиска = МегапоискСервер.ВыполнитьОбработкуАлгоритмыКлючевыхСлов(АлгоритмыКлючевыхСлов, НаименованиеДляПоиска);	
	КонецЕсли;
	
	МассивКлючевыхСлов = РазложитьСтрокуНаКлючевыеСлова(НаименованиеДляПоиска); 	
	Возврат ПолучитьМассивСтрокой(МассивКлючевыхСлов);		
	
КонецФункции
