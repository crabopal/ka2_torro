

&НаКлиенте
Процедура ОткрытьРегистрИстории(Команда)

	ОткрытьФорму("РегистрСведений.мегапрайсИсторияИзмененияЦен.ФормаСписка");	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурналПоступлений(Команда)
	
	ОткрытьФорму("РегистрСведений.РаспределениеЗапасов.Форма.ФормаСписка");
	
КонецПроцедуры




&НаКлиенте
Процедура ПоискСоответствий(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПрайсПартнера", ТекущиеДанные.ПрайсПартнера);
	
	ОткрытьФорму("Обработка.мегапрайсПоискСоответствий.Форма.Форма",СтруктураПараметров,ЭтаФорма);		
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискСоответствийПоПрайсам(Команда)  
	   
	ОткрытьФорму("Обработка.мегапрайсПоискСоответствийПоПрайсам.Форма.Форма",,ЭтаФорма);	
	
КонецПроцедуры
