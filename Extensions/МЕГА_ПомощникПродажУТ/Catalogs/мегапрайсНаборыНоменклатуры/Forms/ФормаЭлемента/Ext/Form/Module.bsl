//ОФОРМЛЕНИЕ СТРОК ЦВЕТАМИ

&НаСервере
Процедура УстановитьУсловноеОформлениеСтрок()
	
	УсловныеОформления = Новый Массив();
	
	Для Каждого Оформление Из ЭтаФорма.УсловноеОформление.Элементы Цикл
		Если Оформление.Представление = "СозданоПрограммно" Тогда
			УсловныеОформления.Добавить(Оформление);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Оформление Из УсловныеОформления Цикл
		УсловноеОформление.Элементы.Удалить(Оформление);
	КонецЦикла;		 
	
	Для Каждого Стр Из Объект.ОформлениеСтрок Цикл	
		Если НЕ ЗначениеЗаполнено(Стр.ЦветСтроки) И НЕ ЗначениеЗаполнено(Стр.ШрифтСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ЦветСтроки) Тогда
			Попытка
				ВыбранныйЦвет = ОформлениеИзСтроки(Стр.ЦветСтроки);
			Исключение
				Сообщить(ОписаниеОшибки());
				Прервать;
			КонецПопытки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ЦветТекста) Тогда
			Попытка
				ВыбранныйЦветТекста = ОформлениеИзСтроки(Стр.ЦветТекста);
			Исключение
				Сообщить(ОписаниеОшибки());
				Прервать;
			КонецПопытки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ШрифтСтроки) Тогда
			Попытка
				ВыбранныйШрифт = ОформлениеИзСтроки(Стр.ШрифтСтроки);
			Исключение
				Сообщить(ОписаниеОшибки());
				Прервать;
			КонецПопытки;
		КонецЕсли;
		
		// Условное оформление 
		НовыйЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = "ОформлениеСтрок_"+Стр.НомерСтроки;
		НовыйЭлементУсловногоОформления.Представление = "СозданоПрограммно";
		НовыйЭлементУсловногоОформления.Использование = Истина;
		
		ЭлементОтбора = НовыйЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.Использование = Истина;		
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОформлениеСтрок.ЦветСтроки");
		ЭлементОтбора.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Стр.ЦветСтроки;
		
		НовоеПоле = НовыйЭлементУсловногоОформления.Поля.Элементы.Добавить();
		НовоеПоле.Использование = Истина;
		НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОформлениеСтрок");		
		Если ЗначениеЗаполнено(Стр.ЦветСтроки) Тогда
			НовыйЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ВыбранныйЦвет);
			НовыйЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Белый);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ЦветТекста) Тогда
			НовыйЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ВыбранныйЦветТекста);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ШрифтСтроки) Тогда
			НовыйЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ВыбранныйШрифт);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры


&НаСервере
Функция ОформлениеВСтроку(Значение)
	Результат = ЗначениеВСтрокуВнутр(Значение);
	Возврат Результат;  
КонецФункции

&НаСервере
Функция ОформлениеИзСтроки(Значение)
	Результат = ЗначениеИзСтрокиВнутр(Значение);
	Возврат Результат;  
КонецФункции

&НаКлиенте
Процедура ОформлениеСтрокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОформлениеСтрок.ТекущиеДанные;	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.ОформлениеСтрокЦветСтроки Тогда
		СтандартнаяОбработка = Ложь;
		Модифицированность = Истина;
		
		Диалог = Новый ДиалогВыбораЦвета;
		Если ЗначениеЗаполнено(ТекущиеДанные.ЦветСтроки) Тогда
			Попытка
				ВыбранноеЗначение = ОформлениеИзСтроки(ТекущиеДанные.ЦветСтроки);
				Диалог.Цвет = ВыбранноеЗначение;
			Исключение
			КонецПопытки;
		КонецЕсли;	
		Оповещение = Новый ОписаниеОповещения("ВыборЦветаСтрокиЗавершение",ЭтотОбъект);
		Диалог.Показать(Оповещение);
		
	ИначеЕсли Поле = Элементы.ОформлениеСтрокЦветТекста Тогда
		СтандартнаяОбработка = Ложь;
		Модифицированность = Истина;
				
		Диалог = Новый ДиалогВыбораЦвета;
		Если ЗначениеЗаполнено(ТекущиеДанные.ЦветТекста) Тогда
			Попытка
				ВыбранноеЗначение = ОформлениеИзСтроки(ТекущиеДанные.ЦветТекста);
				Диалог.Цвет = ВыбранноеЗначение;
			Исключение
			КонецПопытки;
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ВыборЦветаТекстаЗавершение",ЭтотОбъект);
		Диалог.Показать(Оповещение);

	ИначеЕсли Поле = Элементы.ОформлениеСтрокШрифтСтроки Тогда		
		СтандартнаяОбработка = Ложь;
		Модифицированность = Истина;
				
		Диалог = Новый ДиалогВыбораШрифта;
		Если ЗначениеЗаполнено(ТекущиеДанные.ШрифтСтроки) Тогда
			Попытка
				ВыбранноеЗначение = ОформлениеИзСтроки(ТекущиеДанные.ШрифтСтроки);
				Диалог.Шрифт = ВыбранноеЗначение;
			Исключение
			КонецПопытки;
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ВыборШтрифтСтрокиЗавершение",ЭтотОбъект);
		Диалог.Показать(Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВыборЦветаСтрокиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеСтрока = ОформлениеВСтроку(Результат);  
	Для Каждого СтрВыд Из Элементы.ОформлениеСтрок.ВыделенныеСтроки Цикл 
		ДанныеСтроки = Элементы.ОформлениеСтрок.ДанныеСтроки(СтрВыд);	 
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ДанныеСтроки.ЦветСтроки = ЗначениеСтрока;  
	КонецЦикла;
	
	УстановитьУсловноеОформлениеСтрок();

КонецПроцедуры

