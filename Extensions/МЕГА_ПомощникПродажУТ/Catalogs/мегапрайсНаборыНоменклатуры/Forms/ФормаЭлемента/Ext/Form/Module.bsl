
&НаСервере
Процедура Инициализировать()
	
	Объект.СписокРеквизитов.Очистить();
	
	НовСтр = Объект.СписокРеквизитов.Добавить();
	НовСтр.Наименование = "ГруппаНоменклатуры";
	НовСтр.Представление = "Группа номенклатуры";
	НовСтр.Пометка = Ложь;
	
	НовСтр = Объект.СписокРеквизитов.Добавить();
	НовСтр.Наименование = "ЦеноваяГруппа";
	НовСтр.Представление = "Ценовая группа";
	НовСтр.Пометка = Истина;
	
	НовСтр = Объект.СписокРеквизитов.Добавить();
	НовСтр.Наименование = "ТоварнаяКатегория";
	НовСтр.Представление = "Товарная категория";
	НовСтр.Пометка = Ложь;

	НовСтр = Объект.СписокРеквизитов.Добавить();
	НовСтр.Наименование = "Производитель";
	НовСтр.Представление = "Производитель";
	НовСтр.Пометка = Ложь;

	НовСтр = Объект.СписокРеквизитов.Добавить();
	НовСтр.Наименование = "РейтингПродаж";
	НовСтр.Представление = "Рейтинг продаж";
	НовСтр.Пометка = Ложь;

	НовСтр = Объект.СписокРеквизитов.Добавить();
	НовСтр.Наименование = "ДатаНоменклатуры";
	НовСтр.Представление = "Дата номенклатуры";
	НовСтр.Пометка = Истина;
	 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Для Каждого Выборка Из Объект.СписокРеквизитов Цикл		
		Попытка
			КолонкаСписка = Элементы["ОформлениеСтрок"+Выборка.Наименование];
			Если НЕ КолонкаСписка = Неопределено Тогда
				КолонкаСписка.Видимость = Выборка.Пометка;
			КонецЕсли;
		Исключение
		КонецПопытки;		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.СписокРеквизитов.Количество() = 0 Тогда
		Инициализировать();
	КонецЕсли;
	
	УстановитьУсловноеОформлениеСтрок();
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Мегапрайс_ИзменениеНабораЦветов");
	
КонецПроцедуры





&НаКлиенте
Процедура ОбновитьСписокРеквизитов(Команда)
	
	Инициализировать();
	УстановитьВидимостьЭлементов();

КонецПроцедуры

&НаКлиенте
Процедура СписокРеквизитовПометкаПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

