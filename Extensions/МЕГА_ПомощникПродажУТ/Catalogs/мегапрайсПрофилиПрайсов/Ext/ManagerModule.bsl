		
		
		
		
Функция ПолучитьДополнительныйПараметр(ПрофильПрайса, Параметр) Экспорт      
	
	ЗначениеПараметра = "";  
		
	//УправлениеСвойствами.ПолучитьЗначенияСвойств();   
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДополнительныеПараметры.Ссылка КАК ПрофильПрайса,
	|	ДополнительныеПараметры.Параметр КАК Параметр,
	|	ДополнительныеПараметры.ЗначениеПараметра КАК ЗначениеПараметра
	|ИЗ
	|	Справочник.мегапрайсПрофилиПрайсов.ДополнительныеПараметры КАК ДополнительныеПараметры
	|ГДЕ
	|	ДополнительныеПараметры.Ссылка = &ПрофильПрайса
	|	И ДополнительныеПараметры.Параметр = &Параметр";
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("ПрофильПрайса", ПрофильПрайса);
	Запрос.Параметры.Вставить("Параметр", Параметр);
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ЗначениеПараметра) Тогда
			ЗначениеПараметра = Выборка.ЗначениеПараметра;
		Иначе
			ЗначениеПараметра = "";
		КонецЕсли;
	Иначе
		ЗначениеПараметра = "";
	КонецЕсли;

	Возврат ЗначениеПараметра;
	
КонецФункции

Процедура ЗаписатьДополнительныйПараметр(ПрофильПрайса, Параметр, ЗначениеПараметра, ХранилищеПараметра = "") Экспорт      
	
	//НачатьТранзакцию();
	
	Попытка
		ВладелецПараметра = ПрофильПрайса.ПолучитьОбъект();
		
		МассивСтрок = ПрофильПрайса.ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", Параметр));
		Если МассивСтрок.Количество() Тогда
			СтрокаСвойства = МассивСтрок[0];
		Иначе
			СтрокаСвойства = ВладелецПараметра.ДополнительныеПараметры.Добавить();
		КонецЕсли;                                 
		СтрокаСвойства.Параметр = Параметр; 
		СтрокаСвойства.ЗначениеПараметра = ЗначениеПараметра;  
		
		ВладелецПараметра.Записать(); 
	Исключение
		//ОтменитьТранзакцию();
	КонецПопытки;
	
	//ЗафиксироватьТранзакцию();

КонецПроцедуры
