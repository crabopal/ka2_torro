#Область ПрограммныйИнтерфейс

// Возвращает массив единиц измерения для отбора выгрузки на весы.
// Если ТЧ заполнена — берём её; иначе — родное поле ЕдиницаИзмеренияВеса.
//
Функция ЕдиницыИзмеренияДляВыгрузки(ПравилоОбмена) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ПравилоОбмена) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ПравилоОбмена) = Тип("СправочникОбъект.ПравилаОбменаСПодключаемымОборудованиемOffline") Тогда
		ОбъектПравила = ПравилоОбмена;
	Иначе
		ОбъектПравила = ПравилоОбмена.ПолучитьОбъект();
		Если ОбъектПравила = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из ОбъектПравила.битВШТВ_ЕдиницыИзмерения Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаИзмерения)
			И Результат.Найти(СтрокаТЧ.ЕдиницаИзмерения) = Неопределено Тогда
			Результат.Добавить(СтрокаТЧ.ЕдиницаИзмерения);
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Количество() = 0 И ЗначениеЗаполнено(ОбъектПравила.ЕдиницаИзмеренияВеса) Тогда
		Результат.Добавить(ОбъектПравила.ЕдиницаИзмеренияВеса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает параметр СКД ЕдиницыИзмеренияВеса (список).
//
Процедура УстановитьПараметрЕдиницИзмерения(МакетКомпоновки, ПравилоОбмена) Экспорт
	
	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("ЕдиницыИзмеренияВеса");
	Если Параметр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Параметр.Значение = ЕдиницыИзмеренияДляВыгрузки(ПравилоОбмена);
	
КонецПроцедуры

// Если в ТЧ есть единицы — подставляет в родное поле первую весовую (тип Вес), иначе первую из списка.
//
Процедура АвтозаполнитьЕдиницуИзмеренияВеса(ОбъектПравила) Экспорт
	
	Если ОбъектПравила.битВШТВ_ЕдиницыИзмерения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВесоваяЕдиница = Неопределено;
	ПерваяЕдиница = Неопределено;
	
	Для Каждого СтрокаТЧ Из ОбъектПравила.битВШТВ_ЕдиницыИзмерения Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаИзмерения) Тогда
			Продолжить;
		КонецЕсли;
		Если ПерваяЕдиница = Неопределено Тогда
			ПерваяЕдиница = СтрокаТЧ.ЕдиницаИзмерения;
		КонецЕсли;
		ТипВеличины = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.ЕдиницаИзмерения, "ТипИзмеряемойВеличины");
		Если ТипВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес Тогда
			ВесоваяЕдиница = СтрокаТЧ.ЕдиницаИзмерения;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ВесоваяЕдиница) Тогда
		ОбъектПравила.ЕдиницаИзмеренияВеса = ВесоваяЕдиница;
	ИначеЕсли ЗначениеЗаполнено(ПерваяЕдиница) Тогда
		ОбъектПравила.ЕдиницаИзмеренияВеса = ПерваяЕдиница;
	КонецЕсли;
	
КонецПроцедуры

// Если ТЧ пуста, а родное поле заполнено — добавляет его в список (удобный старт).
//
Процедура ЗаполнитьСписокИзРоднойЕдиницыЕслиПусто(ОбъектПравила) Экспорт
	
	Если ОбъектПравила.битВШТВ_ЕдиницыИзмерения.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОбъектПравила.ЕдиницаИзмеренияВеса) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ОбъектПравила.битВШТВ_ЕдиницыИзмерения.Добавить();
	НоваяСтрока.ЕдиницаИзмерения = ОбъектПравила.ЕдиницаИзмеренияВеса;
	
КонецПроцедуры

#КонецОбласти
