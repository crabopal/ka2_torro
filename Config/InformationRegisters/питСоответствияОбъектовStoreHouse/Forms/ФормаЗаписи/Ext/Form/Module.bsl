
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
	
		МетаданныеСсылки = Метаданные.НайтиПоТипу(Параметры.Ключ.ТипОбъекта.ТипЗначения.Типы()[0]);
		Попытка
			ПредставлениеОбъекта = МетаданныеСсылки.ПредставлениеОбъекта;
		Исключение
			ПредставлениеОбъекта = МетаданныеСсылки.Синоним;
		КонецПопытки;

		Элементы.Ссылка1С.Заголовок = ПредставлениеОбъекта;
		Элементы.Ссылка1С.ОграничениеТипа = Параметры.Ключ.ТипОбъекта.ТипЗначения;
		
		ЭтаФорма.Заголовок = "Соответствие объекта <"+ПредставлениеОбъекта+"> элементу в StoreHouse HeadOffice";
		ЭтаФорма.АвтоЗаголовок=Ложь;
		
		Попытка
			Элементы.ЭтоГруппа.Видимость = МетаданныеСсылки.Иерархический;
		Исключение
			Элементы.ЭтоГруппа.Видимость = ложь;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
