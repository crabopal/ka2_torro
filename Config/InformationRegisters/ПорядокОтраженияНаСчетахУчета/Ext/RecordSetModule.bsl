#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из ЭтотОбъект Цикл
		Если Стр.МестоУчета <> Неопределено И Стр.МестоУчета.Пустая() Тогда
			Стр.МестоУчета = Неопределено;
		КонецЕсли;
	КонецЦикла;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если Отказ ИЛИ ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПорядокОтражения.Период,
	|	ПорядокОтражения.ВидСчета,
	|	ПорядокОтражения.Организация,
	|	ПорядокОтражения.АналитикаУчета,
	|	ПорядокОтражения.МестоУчета,
	|	ПорядокОтражения.СчетУчета
	|ПОМЕСТИТЬ НовыеНастройкиОтражения
	|ИЗ
	|	&ТаблицаНовыхДанных КАК ПорядокОтражения";
	Запрос.УстановитьПараметр("ТаблицаНовыхДанных", Выгрузить());
	Запрос.Выполнить();
	РегистрыСведений.СчетаРеглУчетаТребующиеНастройки.ОчиститьПриЗаписиРегистра(Запрос.МенеджерВременныхТаблиц);
	
	Если Не ЗначениеЗаполнено(Отбор.Период.Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Если Количество() Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&Период КАК Месяц,
		|	Неопределено КАК Документ,
		|	ОтраженныеДокументы.Организация КАК Организация,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииЗакрытияМесяца.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета) КАК Операция
		|ИЗ
		|	НовыеНастройкиОтражения КАК ПорядокОтражения
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПредыдущиеНастройки
		|	ПО ПорядокОтражения.ВидСчета = ПредыдущиеНастройки.ВидСчета
		|		И ПорядокОтражения.АналитикаУчета = ПредыдущиеНастройки.АналитикаУчета
		|		И ПорядокОтражения.Период >= ПредыдущиеНастройки.Период
		|		И ПорядокОтражения.СчетУчета <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовВРеглУчете.СрезПоследних(ДОБАВИТЬКДАТЕ(&Период, СЕКУНДА, -1), Организация = &Организация) КАК ОтраженныеДокументы
		|	ПО ОтраженныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВРеглУчете)
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияКЗакрытиюМесяца КАК Задания
		|	ПО ОтраженныеДокументы.Организация = Задания.Организация
		|		И НАЧАЛОПЕРИОДА(Задания.Месяц, МЕСЯЦ) = &Период
		|		И Задания.Операция = ЗНАЧЕНИЕ(Справочник.ОперацииЗакрытияМесяца.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета)
		|ГДЕ
		|	Задания.Операция ЕСТЬ NULL";
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&Период КАК Месяц,
		|	Неопределено КАК Документ,
		|	ОтраженныеДокументы.Организация КАК Организация,
		|	ЗНАЧЕНИЕ(Справочник.ОперацииЗакрытияМесяца.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета) КАК Операция
		|ИЗ
		|	РегистрСведений.ОтражениеДокументовВРеглУчете.СрезПоследних(ДОБАВИТЬКДАТЕ(&Период, СЕКУНДА, -1), Организация = &Организация) КАК ОтраженныеДокументы
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияКЗакрытиюМесяца КАК Задания
		|	ПО ОтраженныеДокументы.Организация = Задания.Организация
		|		И НАЧАЛОПЕРИОДА(Задания.Месяц, МЕСЯЦ) = &Период
		|		И Задания.Операция = ЗНАЧЕНИЕ(Справочник.ОперацииЗакрытияМесяца.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета)
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегламентнаяОперация КАК ДокументыПереносаСальдо
		|	ПО НАЧАЛОПЕРИОДА(ДокументыПереносаСальдо.Дата, МЕСЯЦ) = &Период И ДокументыПереносаСальдо.Проведен
		|		И ДокументыПереносаСальдо.Организация = ОтраженныеДокументы.Организация
		|		И ДокументыПереносаСальдо.ТипОперации = ЗНАЧЕНИЕ(Перечисление.ТипыРегламентныхОпераций.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета)
		|ГДЕ
		|	ОтраженныеДокументы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВРеглУчете)
		|	И Задания.Операция ЕСТЬ NULL И НЕ ДокументыПереносаСальдо.Ссылка ЕСТЬ NULL";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", Отбор.Период.Значение);
	Если ЗначениеЗаполнено(Отбор.Организация.Значение) Тогда
		Запрос.УстановитьПараметр("Организация", Отбор.Организация.Значение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Организация", "ИСТИНА");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьЗаписиРегистраПоДаннымВыборки(Выборка);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ВидыСчетовТребующиеУказанияСтатейДоходов = Новый Массив;
	ВидыСчетовТребующиеУказанияСтатейДоходов.Добавить(Перечисления.ВидыСчетовРеглУчета.ВыручкаОтПродаж);
	ВидыСчетовТребующиеУказанияСтатейДоходов.Добавить(Перечисления.ВидыСчетовРеглУчета.СебестоимостьПродаж);
	ВидыСчетовТребующиеУказанияСтатейДоходов.Добавить(Перечисления.ВидыСчетовРеглУчета.НДСПриПродаже);
	ВидыСчетовТребующиеУказанияСтатейДоходов.Добавить(Перечисления.ВидыСчетовРеглУчета.НДСПриОтгрузкеБезПереходаПраваСобственности);
	ВидыСчетовТребующиеУказанияСтатейДоходов.Добавить(Перечисления.ВидыСчетовРеглУчета.ЗатратыНаПриобретениеТМЦ);
	ВидыСчетовТребующиеУказанияСтатейДоходов.Добавить(Перечисления.ВидыСчетовРеглУчета.ВыручкаОтПродажЕНВД);
	ВидыСчетовТребующиеУказанияСтатейДоходов.Добавить(Перечисления.ВидыСчетовРеглУчета.СебестоимостьПродажЕНВД);
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если ВидыСчетовТребующиеУказанияСтатейДоходов.Найти(Запись.ВидСчета) <> Неопределено Тогда
			ЭтоСчетПрочиеДоходы = БухгалтерскийУчетВызовСервераПовтИсп.ЭтоСчетПрочиеДоходы(Запись.СчетУчета);
			Если ЭтоСчетПрочиеДоходы И Не ЗначениеЗаполнено(Запись.Субконто) Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Организация = Неопределено;
	ДанныеЗаполнения.Свойство("Организация", Организация);
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") И Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли