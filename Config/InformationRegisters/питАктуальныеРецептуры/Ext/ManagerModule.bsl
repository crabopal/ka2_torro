
#Область ПрограммныйИнтерфейс

// Функция удаляет записи в регистре "питАктуальныеРецептуры" с отбором по рецептуре.
//
// Параметры:
//  Рецептура	 - ДокументСсылка.Рецептура - Ссылка на рецептуру
//  ТекстОшибки	 - Строка - Текст ошибки
// 
// Возвращаемое значение:
//  Булево - Истина, когда удаление выполнено и Ложь, когда произошла ошибка.
//
Функция УдалитьЗаписиПоРецептуре(Рецептура, ТекстОшибки = "") Экспорт
	
	Результат = Ложь;
	
	// Поиск записей в физ таблице с отбором по рецептуре.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питАктуальныеРецептуры.Период КАК Период,
	|	питАктуальныеРецептуры.Номенклатура КАК Номенклатура,
	|	питАктуальныеРецептуры.Характеристика КАК Характеристика,
	|	питАктуальныеРецептуры.Организация КАК Организация,
	|	питАктуальныеРецептуры.Подразделение КАК Подразделение,
	|	питАктуальныеРецептуры.Рецептура КАК Рецептура,
	|	питАктуальныеРецептуры.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	РегистрСведений.питАктуальныеРецептуры КАК питАктуальныеРецептуры
	|ГДЕ
	|	питАктуальныеРецептуры.Рецептура = &Рецептура";
	Запрос.УстановитьПараметр("Рецептура", Рецептура);
	РезультатЗапроса = Запрос.Выполнить();
	
	// Если записи найдены.
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			// Удаление каждой найденной записи через менеджер записи.
			МенеджерЗаписиУдалить = РегистрыСведений.питАктуальныеРецептуры.СоздатьМенеджерЗаписи();
			МенеджерЗаписиУдалить.Период			= ВыборкаДетальныеЗаписи.Период;
			МенеджерЗаписиУдалить.Номенклатура		= ВыборкаДетальныеЗаписи.Номенклатура;
			МенеджерЗаписиУдалить.Характеристика	= ВыборкаДетальныеЗаписи.Характеристика;
			МенеджерЗаписиУдалить.Организация		= ВыборкаДетальныеЗаписи.Организация;
			МенеджерЗаписиУдалить.Подразделение		= ВыборкаДетальныеЗаписи.Подразделение;
			
			Попытка
				МенеджерЗаписиУдалить.Удалить();
			Исключение
				ТекстОшибки = ТекстОшибки + "Ошибка удаления записей по рецептуре по причине :
				|"+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				Возврат Результат;
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
	
	// Все хорошо.
	Результат = Истина;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
