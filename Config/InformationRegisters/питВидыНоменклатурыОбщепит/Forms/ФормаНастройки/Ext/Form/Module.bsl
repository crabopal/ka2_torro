#Область ОбработчикиСобытийФормы

// Обработчик события формы "ПриСоданииНаСервере"
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ОбновитьДеревоВидовНоменклатуры();
	
	
КонецПроцедуры

// Обработчик события формы "ПриОткрытии"
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РазвернутьВсе(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ВидыНоменклатурыРеквизитыОбщепитаПриИзменении(Элемент)
	ТекДанные = Элементы.ВидыНоменклатуры.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		УстановитьВидНоменклатурыПоИдентификаторуСтроки(Элементы.ВидыНоменклатуры.ТекущаяСтрока, ТекДанные.РеквизитыОбщепита); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидыНоменклатурыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВидыНоменклатурыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

// Функция отмечает группы в дереве, если все элементы внутри группы отмечены, 
//  то отмечена и вся группа, иначе не отмечаем.
//
// Параметры:
//  ЭлементыДерева	 - Текущая коллекция элементов дерева
// 
// Возвращаемое значение:
//  Булево - Отметили или не отметили все переданные элементы.
//
&НаСервере
Функция ДеревоВидовНоменклатурыОтметитьГруппы(ЭлементыДерева)
	
	Отметить = Истина;
	
	Для каждого ТекЭлементДерева Из ЭлементыДерева Цикл
		Если ТекЭлементДерева.ЭтоГруппа Тогда
			Отметить = ДеревоВидовНоменклатурыОтметитьГруппы(ТекЭлементДерева.ПолучитьЭлементы());
			ТекЭлементДерева.РеквизитыОбщепита = Отметить;
		ИначеЕсли НЕ ТекЭлементДерева.РеквизитыОбщепита Тогда
			Отметить = Ложь;
			Возврат Отметить;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Отметить;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДерево(Команда)
	ОбновитьДеревоВидовНоменклатуры();
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВыбранных(Команда)
	УстановитьВидНоменклатурыПоИдентификаторуСтроки(Элементы.ВидыНоменклатуры.ВыделенныеСтроки, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыбранные(Команда)
	УстановитьВидНоменклатурыПоИдентификаторуСтроки(Элементы.ВидыНоменклатуры.ВыделенныеСтроки, Истина);
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	Для каждого ТекСтрокаДерева Из ВидыНоменклатуры.ПолучитьЭлементы() Цикл
		Элементы.ВидыНоменклатуры.Развернуть(ТекСтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	Для каждого ТекСтрокаДерева Из ВидыНоменклатуры.ПолучитьЭлементы() Цикл
		Элементы.ВидыНоменклатуры.Свернуть(ТекСтрокаДерева.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура обновляет дерево видом номенклатуры данными из регистра.
//
&НаСервере
Процедура ОбновитьДеревоВидовНоменклатуры()
	
	Перем Дерево, Запрос, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры,
	|	ВидыНоменклатуры.ЭтоГруппа КАК ЭтоГруппа,
	|	ВидыНоменклатуры.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА питВидыНоменклатурыОбщепит.ВидНоменклатуры ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК РеквизитыОбщепита,
	|	ВЫБОР
	|		КОГДА ВидыНоменклатуры.ЭтоГруппа
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Картинка,
	|	"""" КАК ПустаяКолонка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питВидыНоменклатурыОбщепит КАК питВидыНоменклатурыОбщепит
	|		ПО (питВидыНоменклатурыОбщепит.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыНоменклатуры.ЭтоГруппа ИЕРАРХИЯ,
	|	ВидыНоменклатуры.Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	Дерево = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(Дерево, "ВидыНоменклатуры");
	
	ДеревоВидовНоменклатурыОтметитьГруппы(ВидыНоменклатуры.ПолучитьЭлементы());
	
КонецПроцедуры

// Процедура устанавливает вид номенкалуты как общепитный или наоборот по переданному идентификатору строки дерева.
//  Если передан массив, то отмечает все элементы в цикле.
//
// Параметры:
//  ИдентификаторТекСтроки	 - Число, Массив - Идентификатор строки дерева.
//  Отметить				 - Булево - Отметить или снять отметку.
//
&НаСервере
Процедура УстановитьВидНоменклатурыПоИдентификаторуСтроки(Знач ИдентификаторТекСтроки, Отметить)
	Если ТипЗнч(ИдентификаторТекСтроки) = Тип("Массив") Тогда
		Для каждого ТекИД Из ИдентификаторТекСтроки Цикл
			ТекСтрокаДерево = ВидыНоменклатуры.НайтиПоИдентификатору(ТекИД);
			УстановитьВидНоменклатурыОбщепит(ТекСтрокаДерево, Отметить);
		КонецЦикла;
	Иначе
		ТекСтрокаДерево = ВидыНоменклатуры.НайтиПоИдентификатору(ИдентификаторТекСтроки);
		УстановитьВидНоменклатурыОбщепит(ТекСтрокаДерево, Отметить);
	КонецЕсли;
КонецПроцедуры

// Рекурсивная процедура установки вида номенклатуры общепит, также обновляет данные регистра.
//
// Параметры:
//  ТекСтрокаДерево	 - Текущая строка дерева.
//  Отметить		 - Булево - Отметить или снять отметку.
//
&НаСервере
Процедура УстановитьВидНоменклатурыОбщепит(ТекСтрокаДерево, Отметить)
	
	// Отметка текущего элемента.
	ТекСтрокаДерево.РеквизитыОбщепита = Отметить;
	Если ТекСтрокаДерево.ЭтоГруппа Тогда
		
		// Для групп делаем рекурсивный вызов для каждого из потомков.
		Для каждого ТекЭлементГруппы Из ТекСтрокаДерево.ПолучитьЭлементы() Цикл
			УстановитьВидНоменклатурыОбщепит(ТекЭлементГруппы, Отметить);
		КонецЦикла;
		
	Иначе
		
		// Обновление регистра.
		МенеджерЗаписи = РегистрыСведений.питВидыНоменклатурыОбщепит.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВидНоменклатуры = ТекСтрокаДерево.ВидНоменклатуры;
		Попытка
			Если Отметить Тогда
				МенеджерЗаписи.Записать();
			Иначе
				МенеджерЗаписи.Удалить();
			КонецЕсли;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось установить вид номенклатуры общепит <"+ТекСтрокаДерево.Наименование+"> по причине:
			|	" + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


