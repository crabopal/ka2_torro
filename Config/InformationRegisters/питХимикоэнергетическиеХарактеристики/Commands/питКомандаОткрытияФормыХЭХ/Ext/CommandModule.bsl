
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура("Номенклатура", ПараметрКоманды);
	ОбъектНоменклатура = ПараметрыВыполненияКоманды.Источник.Объект;
	ПараметрыФормы.Вставить("питКоличествоНоменклатуры",           ?(ОбъектНоменклатура.питКоличествоНоменклатуры = 0, 1, ОбъектНоменклатура.питКоличествоНоменклатуры));
	ПараметрыФормы.Вставить("питКоэффициентЕдиницыИзмеренияДляХЭХ",ОбъектНоменклатура.питКоэффициентЕдиницыИзмеренияДляХЭХ);
	ПараметрыФормы.Вставить("питЕдиницаИзмеренияДляХЭХ",           ОбъектНоменклатура.питЕдиницаИзмеренияДляХЭХ);
	ПараметрыФормы.Вставить("питСпособРасчетаКалорийности",        ОбъектНоменклатура.питСпособРасчетаКалорийности);
	ПараметрыФормы.Вставить("питФормулаРасчетаКалорийности",       ОбъектНоменклатура.питФормулаРасчетаКалорийности);
	
	ПараметрыФормы.Вставить("НоменклатураВладелецУникальныйИдентификатор", ПараметрыВыполненияКоманды.Источник.УникальныйИдентификатор);
	ПараметрыФормы.Вставить("НоменклатураВладелецНавигационнаяСсылка ",    ПараметрыВыполненияКоманды.Окно.ПолучитьНавигационнуюСсылку());
	
	ОткрытьФорму("РегистрСведений.питХимикоэнергетическиеХарактеристики.Форма.питФормаХЭХ", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно);
	
КонецПроцедуры

#КонецОбласти
