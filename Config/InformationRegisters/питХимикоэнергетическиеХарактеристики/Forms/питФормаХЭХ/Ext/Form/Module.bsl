&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиИзГруппыРецептураФрагмент(Знач ТекРецептура)
	
	Перем ВыбраннаяГруппа;
	
	ОткрытьФорму("Справочник.питГруппыХЭХ.ФормаВыбора",,,,,, Новый ОписаниеОповещения("АвтозаполнениеХарактеристикамиИзГруппыРецептураФрагментЗавершение", ЭтотОбъект, Новый Структура("ТекРецептура", ТекРецептура)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

//  Функция - Не пустая таб часть.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция НеПустаяТабЧасть(ТекРецептура)
	
	СтруктураПоиска	= Новый Структура("Рецептура", ТекРецептура);
	МассивСтрок		= СоставХЭХ.НайтиСтроки(СтруктураПоиска);
	
	Возврат МассивСтрок.Количество() > 0;
	
КонецФункции

//  Процедура - Автозаполнение общими характеристиками рецептура фрагмент.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
&НаКлиенте
Процедура АвтозаполнениеОбщимиХарактеристикамиРецептураФрагмент(Знач ТекРецептура)
	
	АвтозаполнениеОбщимиХарактеристикамиСервер(ТекРецептура);
	ОбновитьТаблицыХЭХ();
	
КонецПроцедуры

//  Процедура - Автозаполнение общими характеристиками сервер.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
&НаСервере
Процедура АвтозаполнениеОбщимиХарактеристикамиСервер(ТекРецептура)
	ОчиститьХЭХТекущейРецептуры(ТекРецептура);
	
	СтруктураПоиска = Новый Структура("Рецептура", Документы.питРецептура.ПустаяСсылка());
	ОбщиеХЭХ = СоставХЭХ.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаХЭХ Из ОбщиеХЭХ Цикл
		НоваяСтрока = СоставХЭХ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаХЭХ);
		НоваяСтрока.ЗначениеИзменено  = Истина;
		НоваяСтрока.Рецептура = ТекРецептура;
		Модифицированность = Истина;
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Формула расчета калорийности при изменении на сервере.
//
&НаСервере
Процедура ФормулаРасчетаКалорийностиПриИзмененииНаСервере()
	КорректнаФормулаКалорийности = питДиетпитание.КорректнаФормулаКалорийности(ФормулаРасчетаКалорийности);
	РассчитатьКалорийность();
КонецПроцедуры

//  Процедура - Количество номенклатуры при изменении фрагмент.
//
&НаКлиенте
Процедура КоличествоНоменклатурыПриИзмененииФрагмент()
	
	предКоличествоНоменклатуры = КоличествоНоменклатуры;
	
КонецПроцедуры

