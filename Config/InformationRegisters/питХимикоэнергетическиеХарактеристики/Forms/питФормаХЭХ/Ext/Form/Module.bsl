
#Область ОписаниеПеременных
// Модуль формы обработки

&НаСервере
Перем ХЭХВРазрезе;								// Признак отображения ХЭХ товара в разрезе рецептур
&НаКлиенте
Перем ВысотаТаблицы;							// Начальная высота таблицы ХЭХ
&НаКлиенте
Перем предКоличествоНоменклатуры;				// Старое значение количества номенклатуры
&НаКлиенте
Перем предЕдиницаИзмеренияДляХЭХ;				// Старое значение единицы измерения для ХЭХ номенклатуры

#КонецОбласти


#Область ПрограммныйИнтерфейс

//  Процедура - При закрытии завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПриЗакрытииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаписатьИзменения();
	КонецЕсли;
	
	ПриЗакрытииФрагмент();

КонецПроцедуры

//  Процедура - Автозаполнение основными характеристиками завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеОсновнымиХарактеристикамиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли; 
	
	АвтозаполнениеОсновнымиХарактеристикамиФрагмент(ТекРецептура);
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками для печати завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиДляПечатиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	АвтозаполнениеХарактеристикамиДляПечатиФрагмент(ТекРецептура);
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками для печати фрагмент завершение.
//
// Параметры:
//  ВыбранныйЭлемент - Произвольный - Выбранный элемент.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиДляПечатиФрагментЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	
	ВыбранныйМакет = ВыбранныйЭлемент;
	Если ВыбранныйМакет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыбранныйМакет = ВыбранныйМакет.Значение;
	
	АвтозаполнениеХарактеристикамиДляПечатиСервер(ТекРецептура, ВыбранныйМакет);
	ОбновитьТаблицыХЭХ();

КонецПроцедуры

//  Процедура - Автозаполнение характеристиками из группы завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиИзГруппыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		АвтозаполнениеХарактеристикамиИзГруппыФрагмент(ТекРецептура);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками из группы фрагмент завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиИзГруппыФрагментЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	
	ВыбраннаяГруппа = Результат;
	Если ВыбраннаяГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АвтозаполнениеХарактеристикамиИзГруппыСервер(ТекРецептура, ВыбраннаяГруппа);
	ОбновитьТаблицыХЭХ();

КонецПроцедуры

//  Процедура - Автозаполнение основными характеристиками рецептура завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеОсновнымиХарактеристикамиРецептураЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		АвтозаполнениеОсновнымиХарактеристикамиРецептураФрагмент(ТекРецептура);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками для печати рецептура завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиДляПечатиРецептураЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		АвтозаполнениеХарактеристикамиДляПечатиРецептураФрагмент(ТекРецептура);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками для печати рецептура фрагмент завершение.
//
// Параметры:
//  ВыбранныйЭлемент - Произвольный - Выбранный элемент.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиДляПечатиРецептураФрагмент_Завершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	
	ВыбранныйМакет = ВыбранныйЭлемент;
	Если ВыбранныйМакет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыбранныйМакет = ВыбранныйМакет.Значение;
	
	АвтозаполнениеХарактеристикамиДляПечатиСервер(ТекРецептура, ВыбранныйМакет);
	ОбновитьТаблицыХЭХ();

КонецПроцедуры

//  Процедура - Автозаполнение характеристиками из группы рецептура завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиИзГруппыРецептураЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		АвтозаполнениеХарактеристикамиИзГруппыРецептураФрагмент(ТекРецептура);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками из группы рецептура фрагмент завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиИзГруппыРецептураФрагментЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	ВыбраннаяГруппа = Результат;
	
	Если ВыбраннаяГруппа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	АвтозаполнениеХарактеристикамиИзГруппыСервер(ТекРецептура, ВыбраннаяГруппа);
	ОбновитьТаблицыХЭХ();

КонецПроцедуры

//  Процедура - Автозаполнение общими характеристиками рецептура завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура АвтозаполнениеОбщимиХарактеристикамиРецептураЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекРецептура = ДополнительныеПараметры.ТекРецептура;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		АвтозаполнениеОбщимиХарактеристикамиРецептураФрагмент(ТекРецептура);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Предупруждение что не заполнена единица измерения завершение.
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПредупруждениеЧтоНеЗаполненаЕдиницаИзмеренияЗавершение(ДополнительныеПараметры) Экспорт
	
	Элемент = ДополнительныеПараметры.Элемент;
	
	
	ПараметрыФормы = ПолучитьПараметрыОткрытияФормыЕдиниц();
	ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	
	ВыбранныяЕдИзм = Неопределено;
	ОткрытьФорму("Справочник.Номенклатура.Форма.питФормаЕдиницИзмерения", ПараметрыФормы,Элемент,,,, Новый ОписаниеОповещения("ВыборЕдИзмЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

//  Процедура - Выбор ед изм завершение.
//
// Параметры:
//  ВыбранныяЕдИзм - Произвольный - Выбранныя ед изм.
//  ДополнительныеПараметры1 - Произвольный - Дополнительные параметры 1.
//
&НаКлиенте
Процедура ВыборЕдИзмЗавершение(ВыбранныяЕдИзм, ДополнительныеПараметры1) Экспорт
	
	
	Если ВыбранныяЕдИзм = Неопределено Тогда
		ПоказатьПредупреждение(Неопределено, "Не заполнена единица измерения номенклатуры!");
		Возврат;
	Иначе
		Попытка
			ЕдиницаИзмеренияДляХЭХ = ВыбранныяЕдИзм["ЕдиницаПоКлассификатору"];	
			Если Не ЗначениеЗаполнено(КоличествоНоменклатуры) Тогда
				// Установим значение по умолчанию
				КоличествоНоменклатуры = 1;
			КонецЕсли;
			Элементы.СоставХЭХОбщие.ДобавитьСтроку();
		Исключение КонецПопытки;
	КонецЕсли;
	предЕдиницаИзмеренияДляХЭХ			= ЕдиницаИзмеренияДляХЭХ;

КонецПроцедуры

//  Процедура - Вопрос об изменении рецептурной хэх завершение.
//
// Параметры:
//  Ответ - Произвольный - Ответ.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВопросОбИзмененииРецептурнойХЭХ_Завершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	Элемент = ДополнительныеПараметры.Элемент;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока.ЗначениеИзменено = Истина;
	Элемент.ИзменитьСтроку();
	
КонецПроцедуры

//  Процедура - Вопрос озамене формулы расчета калорийности завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВопросОзаменеФормулыРасчетаКалорийностиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекФормула = ДополнительныеПараметры.ТекФормула;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ФормулаРасчетаКалорийности = ТекФормула;
		ФормулаРасчетаКалорийностиПриИзменении(Неопределено);
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

//  Процедура - Количество номенклатуры при изменении завершение.
//
// Параметры:
//  Ответ - Произвольный - Ответ.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура КоличествоНоменклатурыПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		КоэффициентПересчета = КоличествоНоменклатуры / ?(предКоличествоНоменклатуры = 0, 1, предКоличествоНоменклатуры);
		Для Каждого ТекСтрока Из СоставХЭХ Цикл
			ТекСтрока.КоличествоХарактеристики = ТекСтрока.КоличествоХарактеристики * КоэффициентПересчета;
		КонецЦикла;
	КонецЕсли; 
	
	КоличествоНоменклатурыПриИзмененииФрагмент();
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ВладелецФормы=Неопределено Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, "Форма не предназначена для самостоятельного использования");
		Возврат;
	КонецЕсли;
	// Видимость элементов
	
	предКоличествоНоменклатуры      = КоличествоНоменклатуры;
	предЕдиницаИзмеренияДляХЭХ = ЕдиницаИзмеренияДляХЭХ;
	
	
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Элементы.СпособРасчетаКалорийности.СписокВыбора.Очистить();
	
	Элементы.СпособРасчетаКалорийности.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.питСпособыРасчетаКалорийности.ПустаяСсылка"), "<По константе>");
	Элементы.СпособРасчетаКалорийности.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.питСпособыРасчетаКалорийности.ПоФормуле"),      "По формуле");
	Элементы.СпособРасчетаКалорийности.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.питСпособыРасчетаКалорийности.Суммированием"),  "Суммированием");
	
	Если Параметры.Свойство("Номенклатура") Тогда
		ТекущаяНоменклатура = Параметры.Номенклатура;
	КонецЕсли;
	Если Параметры.Свойство("питКоличествоНоменклатуры") Тогда
		КоличествоНоменклатуры = Параметры.питКоличествоНоменклатуры;
	КонецЕсли;
	Если Параметры.Свойство("питЕдиницаИзмеренияДляХЭХ") Тогда
		ЕдиницаИзмеренияДляХЭХ = Параметры.питЕдиницаИзмеренияДляХЭХ;
	КонецЕсли;
	Если Параметры.Свойство("питКоэффициентЕдиницыИзмеренияДляХЭХ") Тогда
		КоэффициентЕдиницыИзмеренияДляХЭХ = Параметры.питКоэффициентЕдиницыИзмеренияДляХЭХ;
	КонецЕсли;
	Если Параметры.Свойство("питСпособРасчетаКалорийности") Тогда
		СпособРасчетаКалорийности = Параметры.питСпособРасчетаКалорийности;
	КонецЕсли;
	Если Параметры.Свойство("питФормулаРасчетаКалорийности") Тогда
		ФормулаРасчетаКалорийности = Параметры.питФормулаРасчетаКалорийности;
		КорректнаФормулаКалорийности	= питДиетпитание.КорректнаФормулаКалорийности(ФормулаРасчетаКалорийности);
	КонецЕсли;
	
	
	Если ТекущаяНоменклатура.Пустая() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущаяНоменклатура.ЭтоГруппа Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если (ТекущаяНоменклатура.питВидНоменклатуры <> Перечисления.питВидыНоменклатуры.Товар) И (ТекущаяНоменклатура.питВидНоменклатуры <> Перечисления.питВидыНоменклатуры.Блюдо) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектНоменклатуры.Ссылка) Тогда
		ТекНоменклатура = ОбъектНоменклатуры;
	Иначе
		ТекНоменклатура = ТекущаяНоменклатура;
	КонецЕсли;
	
	// Заполнение единицы и количества произойдет при редактировании состава ХЭХ.
	// Для товара будем искать единицу "грамм", если единица не заполнена
	УстановитьОтборыСтрок();
	
	ОтобразитьХЭХНоменклатуры();
	ОбработатьИзменениеТекущейНоменклатуры();
	
	Заголовок = "ХЭХ " + ТекущаяНоменклатура;
	
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(ТекущаяНоменклатура, Элементы.ЕдиницаИзмеренияДляХЭХ);
	
КонецПроцедуры


//  Процедура - При закрытии.
//
&НаКлиенте
Процедура ПриЗакрытии()
	// Произвести запись данных по результату вопроса к пользователю
	Если (Модифицированность) и (Не ЭтаФорма.ТолькоПросмотр) Тогда
		ТекстВопроса = "Состав химикоэнергетических характеристик номенклатуры <" + СокрЛП(ТекущаяНоменклатура) + "> был изменен.
		|Выполнить запись?";
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПриЗакрытииЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;
	
	ПриЗакрытииФрагмент();
КонецПроцедуры

//  Процедура - Перед закрытием.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Модифицированность Тогда
		Отказ = НЕ РеквизитыЗаполнены();
		Отказ = Отказ ИЛИ ПроверитьДубли();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов
 
//  Процедура - Рецептуры при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РецептурыПриАктивизацииСтроки(Элемент)
	
	Если Элементы.Рецептуры.ТекущаяСтрока = Неопределено Тогда
		ТекущаяРецептура = Неопределено;
	ИначеЕсли Элементы.Рецептуры.ТекущаяСтрока = ТекущаяРецептура Тогда
		Возврат;
	Иначе
		ТекущаяРецептура = Элементы.Рецептуры.ТекущаяСтрока;
		ПодключитьОбработчикОжидания("РецептурыПриАктивизацииСтрокиФрагмент", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Состав хэх при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура СоставХЭХПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если ТипЗнч(Элемент) <> Тип("ТаблицаФормы") ИЛИ ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.ЗначениеИзменено = Истина;
		РассчитатьКалорийность();
	КонецЕсли;
	
	
КонецПроцедуры

//  Процедура - Рецептуры перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//
&НаКлиенте
Процедура РецептурыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	
	ЗначенияЗаполнения = Новый Структура("Номенклатура", ТекущаяНоменклатура);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения",ЗначенияЗаполнения);
	ОткрытьФорму("Документ.питРецептура.ФормаОбъекта", ПараметрыФормы)

КонецПроцедуры

//  Процедура - Состав хэх при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура СоставХЭХПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если ТипЗнч(Элемент) <> Тип("ТаблицаФормы") Тогда
		Возврат;
	КонецЕсли;
	Если НоваяСтрока Тогда
		ТекРецептура = Элемент.ОтборСтрок.Рецептура;
		ТекХЭХ = Элемент.ТекущиеДанные;
		ТекХЭХ.Рецептура = ТекРецептура;
		ТекХЭХ.ЗначениеИзменено = Истина;
	КонецЕсли;	
КонецПроцедуры

//  Процедура - Состав хэх перед началом изменения.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура СоставХЭХПередНачаломИзменения(Элемент, Отказ)
	Если ТипЗнч(Элемент) <> Тип("ТаблицаФормы") Тогда
		Возврат;
	КонецЕсли;
	ТекСтрока = Элемент.ТекущиеДанные;
	Если НЕ ТекСтрока.ЗначениеИзменено Тогда
		Отказ = Истина;
		
		Ответ = Неопределено;
		ПоказатьВопрос(Новый ОписаниеОповещения("ВопросОбИзмененииРецептурнойХЭХ_Завершение", ЭтотОбъект, Новый Структура("ТекСтрока, Элемент" , ТекСтрока, Элемент)), "Данная строка рассчитана по рецептуре! Изменить?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - Формула расчета калорийности при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ФормулаРасчетаКалорийностиПриИзменении(Элемент)
	ФормулаРасчетаКалорийностиПриИзмененииНаСервере();
КонецПроцедуры

//  Процедура - Формула расчета калорийности начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ФормулаРасчетаКалорийностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Формула", ФормулаРасчетаКалорийности);
	ОткрытьФорму("Обработка.питФормулаРасчетаКалорийности.Форма", ПараметрыФормы, Элемент,,,, Неопределено, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

//  Процедура - Способ расчета калорийности при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпособРасчетаКалорийностиПриИзменении(Элемент)
	// Определим видимость и доступность реквизитов, связанных с расчетом калорийности
	ВидимаяФормула = (СпособРасчетаКалорийности = ПредопределенноеЗначение("Перечисление.питСпособыРасчетаКалорийности.ПоФормуле"));
	Элементы.ФормулаРасчетаКалорийности.Доступность      = ВидимаяФормула;
	Элементы.ФормулаРасчетаКалорийности.Видимость        = ВидимаяФормула;
	Элементы.ИспользуемаяФормула.Видимость               = НЕ ВидимаяФормула;
	
	Если СпособРасчетаКалорийности = ПредопределенноеЗначение("Перечисление.питСпособыРасчетаКалорийности.ПоФормуле") Тогда
		Если ПустаяСтрока(ФормулаРасчетаКалорийности) Тогда
			// Поищем, откуда брать формулу
			ТекФормула = ВернутьКонстанту("питФормулаРасчетаКалорийности");
			Если ПустаяСтрока(ТекФормула) Тогда
				ТекФормула = "4 * [Белки] + 9 * [Жиры] + 4 * [Углеводы] + 7 * [Алкоголь]";
			КонецЕсли;
			ФормулаРасчетаКалорийности = ТекФормула;
			ФормулаРасчетаКалорийностиПриИзмененииНаСервере();
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	РассчитатьКалорийность();
КонецПроцедуры

//  Процедура - Формула расчета калорийности открытие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ФормулаРасчетаКалорийностиОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	// Поищем, откуда брать формулу
	ТекФормула	= ВернутьКонстанту("питФормулаРасчетаКалорийности");
	Источник	= "из константы";
	Если ПустаяСтрока(ТекФормула) Тогда
		ТекФормула = "4 * [Белки] + 9 * [Жиры] + 4 * [Углеводы] + 7 * [Алкоголь]";
		Источник = "по умолчанию";
	КонецЕсли;
	Если ПустаяСтрока(ФормулаРасчетаКалорийности) Тогда
		// Если формулы не было - сразу подставим
		ФормулаРасчетаКалорийности = ТекФормула;
		ФормулаРасчетаКалорийностиПриИзменении(Неопределено);
		Модифицированность = Истина;
	Иначе
		// Если формула была - спросим, хотят ли новую
		ТекстВопроса = "Формула расчета калорийности не пустая! Заменить ее" + Символы.ПС + "на формулу " + Источник + " (" + ТекФормула + ")?";
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ВопросОзаменеФормулыРасчетаКалорийностиЗавершение", ЭтотОбъект, Новый Структура("ТекФормула", ТекФормула)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - Количество номенклатуры при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КоличествоНоменклатурыПриИзменении(Элемент)
	Если (КоличествоНоменклатуры <> предКоличествоНоменклатуры) И (предКоличествоНоменклатуры <> 0) И (СоставХЭХ.Количество() > 0) Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("КоличествоНоменклатурыПриИзмененииЗавершение", ЭтотОбъект), "Количество номенклатуры изменилось! Пересчитать количество ХЭХ?", РежимДиалогаВопрос.ДаНет);
		Возврат; 
		
	КонецЕсли;
	КоличествоНоменклатурыПриИзмененииФрагмент();
КонецПроцедуры


//  Процедура - Состав хэх общие химикоэнергетическая характеристика при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СоставХЭХОбщиеХимикоэнергетическаяХарактеристикаПриИзменении(Элемент)
	ТекущаяСтрока	= Элементы.СоставХЭХОбщие.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.ХимикоэнергетическаяХарактеристика) Тогда
			ТекущаяСтрока.ЕдиницаИзмерения = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ХимикоэнергетическаяХарактеристика, "ЕдиницаИзмерения")
		Иначе
			ТекущаяСтрока.ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры


//  Процедура - Состав хэх рецептуры химикоэнергетическая характеристика при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СоставХЭХРецептурыХимикоэнергетическаяХарактеристикаПриИзменении(Элемент)
	ТекущаяСтрока	= Элементы.СоставХЭХРецептуры.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.ХимикоэнергетическаяХарактеристика) Тогда
			ТекущаяСтрока.ЕдиницаИзмерения = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ХимикоэнергетическаяХарактеристика, "ЕдиницаИзмерения")
		Иначе
			ТекущаяСтрока.ЕдиницаИзмерения = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

//  Процедура - Состав хэх рецептуры после удаления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СоставХЭХРецептурыПослеУдаления(Элемент)
	РассчитатьКалорийность();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

//  Процедура - Записать.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Записать(Команда)
	Если Модифицированность Тогда
		
		Заполнено = РеквизитыЗаполнены();
		НетДублей = НЕ ПроверитьДубли();
		
		Если Заполнено И НетДублей Тогда
			ЗаписатьИзменения();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Автозаполнение основными характеристиками.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура АвтозаполнениеОсновнымиХарактеристиками(Команда)
	// Если ЕдиницаИзмеренияДляХЭХ.Пустая() Тогда
	// 	ПоказатьПредупреждение(Неопределено,"Не заполнена единица измерения номенклатуры!");
	// 	Возврат;
	// КонецЕсли;
	
	ТекРецептура = ПредопределенноеЗначение("Документ.питРецептура.ПустаяСсылка");
	
	Если НеПустаяТабЧасть(ТекРецептура) Тогда
		ТекстВопроса = "Перед заполнением предопределенными химикоэнергетическими характеристиками" +
		Символы.ПС + "табличная часть будет очищена. Выполнить заполнение?";
		
		ПоказатьВопрос(Новый ОписаниеОповещения("АвтозаполнениеОсновнымиХарактеристикамиЗавершение", ЭтотОбъект, Новый Структура("ТекРецептура", ТекРецептура)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат; 
	КонецЕсли;
	
	АвтозаполнениеОсновнымиХарактеристикамиФрагмент(ТекРецептура);
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками для печати.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиДляПечати(Команда)
	// Если ЕдиницаИзмеренияДляХЭХ.Пустая() Тогда
	// 	ПоказатьПредупреждение(Неопределено,"Не заполнена единица измерения номенклатуры!");
	// 	Возврат;
	// КонецЕсли;
	
