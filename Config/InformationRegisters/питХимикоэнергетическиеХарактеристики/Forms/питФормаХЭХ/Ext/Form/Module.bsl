// Управление отображением формы.
//
&НаСервере
Процедура ОбработатьИзменениеТекущейНоменклатуры()
	// Имеем ли право показывать для товара рецептуры
	ХЭХВРазрезе = ХЭХТовараВРазрезеРецептур;
	
	// Для группы отображать ничего не нужно.
	Если ТекущаяНоменклатура.ЭтоГруппа Тогда
		Элементы.ГруппаХЭХ.Видимость                         = Ложь;
		Элементы.КоличествоНоменклатуры.Видимость            = Ложь;
		Элементы.ЕдиницаИзмеренияДляХЭХ.Видимость            = Ложь;
		Элементы.ФормулаРасчетаКалорийности.Видимость        = Ложь;
		Элементы.Калорийность.Видимость                      = Ложь;
		Элементы.ИспользуемаяФормула.Видимость               = Ложь;
		Элементы.СпособРасчетаКалорийности.Видимость  = Ложь;
		Элементы.Записать.Доступность = Ложь;
		ОтобразитьПанели();
	Иначе
		Если ТекущаяНоменклатура.питВидНоменклатуры<>Перечисления.питВидыНоменклатуры.Товар Тогда
			Если ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
				Элементы.ГруппаХЭХ.Видимость                         = Истина;
				Элементы.КоличествоНоменклатуры.Видимость            = Истина;
				Элементы.ЕдиницаИзмеренияДляХЭХ.Видимость            = Истина;
				Элементы.ФормулаРасчетаКалорийности.Видимость        = Истина;
				Элементы.Калорийность.Видимость                      = Истина;
				Элементы.СпособРасчетаКалорийности.Видимость  		 = Истина;
				Элементы.КоличествоНоменклатуры.ТолькоПросмотр       = Ложь;
				Элементы.ЕдиницаИзмеренияДляХЭХ.ТолькоПросмотр       = Ложь;
				Элементы.Записать.Доступность = Истина;
				ОтобразитьПанели();
			Иначе
				Элементы.ГруппаХЭХ.Видимость                         = Ложь;
				Элементы.КоличествоНоменклатуры.Видимость            = Ложь;
				Элементы.ЕдиницаИзмеренияДляХЭХ.Видимость            = Ложь;
				Элементы.ФормулаРасчетаКалорийности.Видимость        = Ложь;
				Элементы.Калорийность.Видимость                      = Ложь;
				Элементы.ИспользуемаяФормула.Видимость               = Ложь;
				Элементы.СпособРасчетаКалорийности.Видимость         = Ложь;
				Элементы.Записать.Доступность = Ложь;
				ОтобразитьПанели();
			КонецЕсли;
		Иначе	
			Элементы.ГруппаХЭХ.Видимость                         = Истина;
			Элементы.КоличествоНоменклатуры.Видимость            = Истина;
			Элементы.ЕдиницаИзмеренияДляХЭХ.Видимость            = Истина;
			Элементы.ФормулаРасчетаКалорийности.Видимость        = Истина;
			Элементы.Калорийность.Видимость                      = Истина;
			Элементы.СпособРасчетаКалорийности.Видимость   = Истина;
			Элементы.КоличествоНоменклатуры.ТолькоПросмотр   = Ложь;
			Элементы.ЕдиницаИзмеренияДляХЭХ.ТолькоПросмотр   = Ложь;
			Элементы.Записать.Доступность = Истина;
			ОтобразитьПанели();
		КонецЕсли;	
	КонецЕсли;
	
	// Определим видимость и доступность реквизитов, связанных с расчетом калорийности
	ВидимаяФормула = (СпособРасчетаКалорийности = Перечисления.питСпособыРасчетаКалорийности.ПоФормуле);
	Элементы.ФормулаРасчетаКалорийности.Видимость = ВидимаяФормула;
	Элементы.ИспользуемаяФормула.Видимость        = НЕ ВидимаяФормула;
	
КонецПроцедуры // ОбработатьИзменениеТекущейНоменклатуры() 

//  Функция - Получить реквизит объекта.
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  Реквизит - Произвольный - Реквизит.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьРеквизитОбъекта(ЭтотОбъект, Реквизит)
	Возврат ЭтотОбъект[Реквизит];
КонецФункции

// Управление отображением панели рецептур
//
&НаСервере
Процедура ОтобразитьПанели()
	Элементы.ГруппаОбщиеХЭХ.Видимость     = Истина;
	Если ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар Тогда
		Элементы.ГруппаРецептуры.Видимость    = ХЭХВРазрезе;
		Элементы.ГруппаХЭХРецептуры.Видимость = ХЭХВРазрезе;
	Иначе
		Элементы.ГруппаРецептуры.Видимость    = Истина;
		Элементы.ГруппаХЭХРецептуры.Видимость = Истина;
//   ВидимостьПоАктуальнойРецептуре = Константы.питСпособРасчетаРецептур.Получить() =
// Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре;.
		ВидимостьПоАктуальнойРецептуре = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур") = Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре;
		Элементы.РецептурыОсновная.Видимость   = Не ВидимостьПоАктуальнойРецептуре;
		Элементы.РецептурыДатаНачала.Видимость = ВидимостьПоАктуальнойРецептуре;
		Элементы.РецептурыДатаКонца.Видимость  = ВидимостьПоАктуальнойРецептуре;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Очистить хэх рецептуры.
//
// Параметры:
//  Рецептура - Произвольный - Рецептура.
//  ТолькоНеизменяемые - Произвольный - Только неизменяемые.
//
&НаКлиенте
Процедура ОчиститьХЭХРецептуры(Рецептура, ТолькоНеизменяемые = Ложь)
	СтруктураПоиска = Новый Структура("Рецептура", Рецептура);
	Если ТолькоНеизменяемые Тогда
		СтруктураПоиска.Вставить("ЗначениеИзменено", Ложь);
	КонецЕсли;
	ОчищаемыеСтроки	= СоставХЭХ.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаДляОчистки Из ОчищаемыеСтроки Цикл
		СоставХЭХ.Удалить(СтрокаДляОчистки);
	КонецЦикла;
КонецПроцедуры

//  Процедура - Очистить хэх текущей рецептуры.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
&НаСервере
Процедура ОчиститьХЭХТекущейРецептуры(ТекРецептура)
	СтруктураПоиска	= Новый Структура("Рецептура", ТекРецептура);
	МассивСтрок		= СоставХЭХ.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаМассива Из МассивСтрок Цикл
		СоставХЭХ.Удалить(СтрокаМассива);
	КонецЦикла;
КонецПроцедуры

// Отображает химикоэнергетические характеристики для номенклатуры
//
&НаСервере
Процедура ОтобразитьХЭХНоменклатуры()
	// Очищаем все ХЭХ
	СоставХЭХ.Очистить();
	
	// Общие ХЭХ (есть и у товара, и у блюда)
	СформироватьТаблицуХЭХ(Документы.питРецептура.ПустаяСсылка(), Истина);
	
	Если ЗначениеЗаполнено(ОбъектНоменклатуры.Ссылка) Тогда
		ТекНоменклатура = ОбъектНоменклатуры;
	Иначе
		ТекНоменклатура = ТекущаяНоменклатура;
	КонецЕсли;
	
	Если ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
		// СпособПодбораОсновнойРецептуры	= Константы.питСпособРасчетаРецептур.Получить();	// "СпособПодбораОсновнойРецептуры"
		СпособПодбораОсновнойРецептуры = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
		ОсновнаяРецептура				= питПроизводство.ВернутьОсновнуюРецептуру(ТекущаяНоменклатура,, Перечисления.питХозяйственныеОперации.РецептураПриготовление, ТекущаяДата());
		Если НЕ ЗначениеЗаполнено(ТекНоменклатура.питЕдиницаИзмеренияДляХЭХ) Тогда
			ЕдиницаИзмеренияДляХЭХ = ОсновнаяРецептура.Упаковка;
		Иначе
			ЕдиницаИзмеренияДляХЭХ = ТекНоменклатура.питЕдиницаИзмеренияДляХЭХ;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекНоменклатура.питКоличествоНоменклатуры) Тогда
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияДляХЭХ) Тогда
				КоличествоНоменклатуры = 1;
				Модифицированность	   = Истина;	// При закрытии формы необходимо записать изменение
			Иначе
				// Будет сохранено после явных изменений пользователя.
			КонецЕсли;
		Иначе
			КоличествоНоменклатуры = ТекНоменклатура.питКоличествоНоменклатуры;
		КонецЕсли;
		предКоличествоНоменклатуры = КоличествоНоменклатуры;
		предЕдиницаИзмеренияДляХЭХ = ЕдиницаИзмеренияДляХЭХ;
	КонецЕсли;	
КонецПроцедуры

//  Процедура - Сформировать таблицу хэх.
//
// Параметры:
//  Рецептура - Произвольный - Рецептура.
//  ОбщиеХЭХ - Произвольный - Общие хэх.
//  СтруктураПоиска - Структура - Структура поиска.
//
&НаСервере
Процедура СформироватьТаблицуХЭХ(Рецептура = Неопределено, ОбщиеХЭХ = Ложь, СтруктураПоиска = Неопределено)
	
	ТекРецептура = ?(Рецептура = Неопределено, Документы.питРецептура.ПустаяСсылка(), Рецептура);
	Если (ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар) ИЛИ ОбщиеХЭХ Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		|	ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика,
		|	ХимикоэнергетическиеХарактеристики.КоличествоХарактеристики,
		|	ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ИСТИНА КАК ЗначениеИзменено,
		|	&Рецептура
		|ИЗ
		|	РегистрСведений.питХимикоэнергетическиеХарактеристики КАК ХимикоэнергетическиеХарактеристики
		|ГДЕ
		|	ХимикоэнергетическиеХарактеристики.Номенклатура = &Номенклатура
		|	И ХимикоэнергетическиеХарактеристики.Рецептура = &Рецептура";
		
		Запрос.УстановитьПараметр("Рецептура",    ТекРецептура);
		Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			// Если ХЭХ не получены, вернем пустую таблицу
			ТаблицаХЭХ = Новый ТаблицаЗначений;
		Иначе
			ТаблицаХЭХ = Результат.Выгрузить();
		КонецЕсли;
		
	ИначеЕсли ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
		
		ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекущаяНоменклатура, ЕдиницаИзмеренияДляХЭХ);
		ТаблицаХЭХ = питДиетпитание.ПолучитьСоставХЭХ(ТекущаяНоменклатура, , ТекРецептура, КоличествоНоменклатуры * ТекКоэффициент,КоличествоНоменклатуры , , , Истина, Перечисления.питСпособыРасчетаКалорийности.Суммированием);
		Если ТаблицаХЭХ = Неопределено Тогда
			// Если ХЭХ не получены, вернем пустую таблицу
			ТаблицаХЭХ = Новый ТаблицаЗначений;
		Иначе
			Счетчик = ТаблицаХЭХ.Количество() - 1;
			// Установим признак редактируемости ("ЗначениеИзменено")
			ТаблицаХЭХ.Колонки.Добавить("ЗначениеИзменено",  Новый ОписаниеТипов("Булево"));
			ТаблицаХЭХ.Колонки.Добавить("Рецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"));
			ТаблицаХЭХ.ЗаполнитьЗначения(ТекРецептура, "Рецептура");
			Пока Счетчик >= 0 Цикл
				ТаблицаХЭХ[Счетчик].ЗначениеИзменено = НЕ ТаблицаХЭХ[Счетчик].Вычислено;
				Счетчик = Счетчик - 1;
			КонецЦикла;
			ТаблицаХЭХ.Колонки.Удалить("Вычислено");
		КонецЕсли;
	Иначе
		// Вернем пустую таблицу
		ТаблицаХЭХ = Новый ТаблицаЗначений;
	КонецЕсли;
	
	// Заполним таблицу
	Для Каждого ТекСтрока Из ТаблицаХЭХ Цикл
		Если СтруктураПоиска = Неопределено Тогда
			НоваяСтрока = СоставХЭХ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		Иначе
			СтруктураПоиска.ХимикоэнергетическаяХарактеристика = ТекСтрока.ХимикоэнергетическаяХарактеристика;
			Если СоставХЭХ.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
				НоваяСтрока = СоставХЭХ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Упорядочим ХЭХ
	СоставХЭХ.Сортировать("Рецептура,ХимикоэнергетическаяХарактеристика");
	
	РассчитатьКалорийность();
КонецПроцедуры

//  Функция - Реквизиты заполнены.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция РеквизитыЗаполнены()
	Перем Рез;
	Рез = Истина;
	
	Если ТекущаяНоменклатура.ЭтоГруппа Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "По группе нельзя записать ХЭХ!";
		Сообщение.Сообщить();
		Рез = Ложь;
	КонецЕсли;
	
	Если КоличествоНоменклатуры <= 0 Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнено количество номенклатуры в параметрах ХЭХ!";
		Сообщение.Сообщить();
		Рез = Ложь;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции


// Производит запись внесенных изменений в регистр сведений "Химикоэнергетические характеристики".
//
&НаСервере
Процедура ЗаписатьИзменения()
	Если ЗначениеЗаполнено(ОбъектНоменклатуры.Ссылка) Тогда
		// Пропускаем
	Иначе
		// Выполняем запись изменений.
		
		// Выполняем запись изменений.
		НачатьТранзакцию();
		
		ОбъектСправочник = ТекущаяНоменклатура.ПолучитьОбъект();
		ОбъектСправочник.питКоличествоНоменклатуры     = КоличествоНоменклатуры;
		ОбъектСправочник.питЕдиницаИзмеренияДляХЭХ     = ЕдиницаИзмеренияДляХЭХ;
		ОбъектСправочник.питФормулаРасчетаКалорийности = ФормулаРасчетаКалорийности;
		ОбъектСправочник.питСпособРасчетаКалорийности  = СпособРасчетаКалорийности;
		Попытка
			ОбъектСправочник.Записать();
		Исключение
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
		
		НаборЗаписей								= РегистрыСведений.питХимикоэнергетическиеХарактеристики.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(ТекущаяНоменклатура);
		
		Для каждого ТекСтрока Из СоставХЭХ Цикл
			Если Не ЗначениеЗаполнено(ТекСтрока.ХимикоэнергетическаяХарактеристика) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Присутствует строка с незаполненной химико-энергетической характеристикой. Запись будет отменена.");
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли;
			// С нулевым количеством ХЭХ не записываем в регистр
			Если (ТекСтрока.КоличествоХарактеристики > 0) И ТекСтрока.ЗначениеИзменено Тогда
				НоваяЗапись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекСтрока);
				НоваяЗапись.Номенклатура = ТекущаяНоменклатура;
			КонецЕсли;	
		КонецЦикла;	
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	Модифицированность = Ложь;
	
КонецПроцедуры // ЗаписатьИзменения() 

// Производит проверку на повторяющиеся записи в таблице ХЭХ
//
// Возвращаемое значение:
//   Булево - Есть ли дубли ХЭХ
&НаСервере
Функция ПроверитьДубли()
	Результат = Ложь;
	ТаблицаДляПроверки = СоставХЭХ.Выгрузить(, "ХимикоэнергетическаяХарактеристика,Рецептура");
	Если ТаблицаДляПроверки.Количество() > 1 Тогда
		ТаблицаДляПроверки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		ТаблицаДляПроверки.ЗаполнитьЗначения(1, "Количество");
		ТаблицаДляПроверки.Свернуть("ХимикоэнергетическаяХарактеристика,Рецептура", "Количество");
		ТаблицаДляПроверки.Сортировать("Количество УБЫВ");
		ПерваяСтрока = ТаблицаДляПроверки[0];
		Если ПерваяСтрока.Количество > 1 Тогда
			Результат = Истина;
			СтрокаБлюда = "";
			Если ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
				СтрокаБлюда = "для рецептуры <" + ?(ЗначениеЗаполнено(ПерваяСтрока.Рецептура), ПерваяСтрока.Рецептура, "Все рецептуры") + "> "
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Характеристика <" + СокрЛП(ПерваяСтрока.ХимикоэнергетическаяХарактеристика) + "> " + СтрокаБлюда + "встречается более одного раза!");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Производит запись внесенных изменений в регистр сведений "Химикоэнергетические характеристики".
//
// Возвращаемое значение:
//   НЕТ
&НаСервере
Функция РассчитатьКалорийность()
	Если Не ЗначениеЗаполнено(СпособРасчетаКалорийности) Тогда
		СпособРасчетаКалорийности	= Перечисления.питСпособыРасчетаКалорийности.ПустаяСсылка();
	КонецЕсли;
	
	Калорийность = 0;
	// Определим текущую рецептуру
	Если ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
		ТекСтрока = Элементы.Рецептуры.ТекущаяСтрока;
		ТекРецептура = ?(ТекСтрока = Неопределено, Документы.питРецептура.ПустаяСсылка(), ТекСтрока);
	Иначе	
		ТекРецептура = Документы.питРецептура.ПустаяСсылка();
	КонецЕсли;
	СтруктураПоиска = Новый Структура("Рецептура", ТекРецептура);
	
	// Способ "<По константе>" или "<По рецептуре>"
	Если СпособРасчетаКалорийности = Перечисления.питСпособыРасчетаКалорийности.ПустаяСсылка() Тогда
		ВремТабл = СоставХЭХ.Выгрузить(СтруктураПоиска, "ХимикоэнергетическаяХарактеристика,КоличествоХарактеристики");
		
		Калорийность = питДиетпитание.РассчитатьКалорийность(ВремТабл, "", ТекРецептура);
		
		// Определим, откуда взялась формула
		ТекФормула = "";
		Если ЗначениеЗаполнено(ТекРецептура.ФормулаРасчетаКалорийности) И (ТекРецептура.СпособРасчетаКалорийности = Перечисления.питСпособыРасчетаКалорийности.ПоФормуле) Тогда
			ТекФормула = ТекРецептура.ФормулаРасчетаКалорийности;
		КонецЕсли;
		Если ПустаяСтрока(ТекФормула) И (Константы.питСпособРасчетаКалорийности.Получить() = Перечисления.питСпособыРасчетаКалорийности.ПоФормуле) Тогда
			ТекФормула = Константы.питФормулаРасчетаКалорийности.Получить();
		КонецЕсли;
		ИспользуемаяФормула = ?(ПустаяСтрока(ТекФормула), "Значение из таблицы", ТекФормула);
		
		// Способ "По формуле"
	ИначеЕсли СпособРасчетаКалорийности = Перечисления.питСпособыРасчетаКалорийности.ПоФормуле Тогда
		Если ПустаяСтрока(ФормулаРасчетаКалорийности) ИЛИ (НЕ КорректнаФормулаКалорийности) Тогда
			Калорийность = 0;
			Возврат Ложь;
		КонецЕсли;
		ВремТабл = СоставХЭХ.Выгрузить(СтруктураПоиска, "ХимикоэнергетическаяХарактеристика,КоличествоХарактеристики");
		
		Калорийность = питДиетпитание.РассчитатьКалорийность(ВремТабл, ФормулаРасчетаКалорийности, , , Истина);
		
		
		// Способ "Суммированием"
	ИначеЕсли СпособРасчетаКалорийности = Перечисления.питСпособыРасчетаКалорийности.Суммированием Тогда
		СтруктураПоиска.Вставить("ХимикоэнергетическаяХарактеристика", Справочники.питХимикоэнергетическиеХарактеристики.Калорийность);
		НайденныеСтроки	= СоставХЭХ.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0  Тогда
			Калорийность= НайденныеСтроки[0].КоличествоХарактеристики;
		Иначе
			// Поищем в общих ХЭХ
			СтруктураПоиска.Рецептура = Документы.питРецептура.ПустаяСсылка();
			НайденныеСтроки = СоставХЭХ.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0  Тогда
				Калорийность = НайденныеСтроки[0].КоличествоХарактеристики;
			КонецЕсли;
		КонецЕсли;
		ИспользуемаяФормула = "Значение из таблицы";
		
	КонецЕсли;	
	Возврат Истина
КонецФункции

//  Функция - Вернуть константу.
//
// Параметры:
//  Константа - Произвольный - Константа.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ВернутьКонстанту(Константа)
	Возврат Константы[Константа].Получить();
КонецФункции

//  Функция - Получить параметры открытия формы единиц.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьПараметрыОткрытияФормыЕдиниц()
	НоменклатурнаяГруппа = ТекущаяНоменклатура.НоменклатурнаяГруппа;
	питИспользованиеЕдиницИзмерения = НоменклатурнаяГруппа.питИспользованиеЕдиницИзмерения;
	ВладелецЕдиницы			= ?(питИспользованиеЕдиницИзмерения = 1, НоменклатурнаяГруппа, ТекущаяНоменклатура);
	
	ПараметрыФормы = Новый Структура("ВладелецЕдиницы, ТекущаяНоменклатура", ВладелецЕдиницы, ТекущаяНоменклатура);
	
	Возврат ПараметрыФормы;
КонецФункции

//  Процедура - Установить отборы строк.
//
&НаСервере
Процедура УстановитьОтборыСтрок()
	
	// Установим отбор рецептур по номенклатуре
	Если Элементы.ГруппаРецептуры.Видимость Тогда
		Элемент = Рецептуры.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура");
		Если ТекущаяНоменклатура.питВидНоменклатуры =  Перечисления.питВидыНоменклатуры.Товар Тогда
			Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный
		КонецЕсли;
		
		Если ТекущаяНоменклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
			Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Элемент.Использование = Истина;
			Элемент.ПравоеЗначение = ТекущаяНоменклатура;
		Иначе
			Элемент.Использование = Ложь;
			Элемент.ПравоеЗначение = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
		КонецЕсли;
		Элементы.Рецептуры.Обновить();
	КонецЕсли;
	
    СтрОтбора = Новый ФиксированнаяСтруктура("Рецептура", ПредопределенноеЗначение("Документ.питРецептура.ПустаяСсылка"));
    Элементы.СоставХЭХОбщие.ОтборСтрок     = СтрОтбора;
	Элементы.СоставХЭХОбщие.Обновить();
КонецПроцедуры

//  Процедура - Обновить таблицы хэх.
//
&НаКлиенте
Процедура ОбновитьТаблицыХЭХ()
	
	ТекСтрока = Элементы.Рецептуры.ТекущаяСтрока;
	СтрОтбора = Новый ФиксированнаяСтруктура("Рецептура", ТекСтрока);
	Элементы.СоставХЭХРецептуры.ОтборСтрок     = СтрОтбора;
	Элементы.СоставХЭХРецептуры.Обновить();

	
	
    СтрОтбора = Новый ФиксированнаяСтруктура("Рецептура", ПредопределенноеЗначение("Документ.питРецептура.ПустаяСсылка"));
    Элементы.СоставХЭХОбщие.ОтборСтрок     = СтрОтбора;
	Элементы.СоставХЭХОбщие.Обновить();
	
	РассчитатьКалорийность();
	
КонецПроцедуры

//  Процедура - Рецептуры при активизации строки фрагмент.
//
&НаКлиенте
Процедура РецептурыПриАктивизацииСтрокиФрагмент()
	
	ТекСтрока = Элементы.Рецептуры.ТекущаяСтрока;
	Если ТекСтрока = Неопределено Тогда
		Элементы.СпособРасчетаКалорийности.СписокВыбора[0].Представление = "<По константе>";
		РассчитатьКалорийность();
		Возврат;
	КонецЕсли;
	
	// Перечитаем записи регистра
	ОчиститьХЭХРецептуры(ТекСтрока, Истина);
	СтруктураПоиска = Новый Структура("Рецептура", ТекСтрока);
	СтруктураПоиска.Вставить("ХимикоэнергетическаяХарактеристика", ПредопределенноеЗначение("Справочник.питХимикоэнергетическиеХарактеристики.ПустаяСсылка"));
	
	СформироватьТаблицуХЭХ(ТекСтрока, Ложь, СтруктураПоиска);
	
	
	СтрОтбора = Новый ФиксированнаяСтруктура("Рецептура", ТекСтрока);
	Элементы.СоставХЭХРецептуры.ОтборСтрок     = СтрОтбора;
	Элементы.СоставХЭХРецептуры.Обновить();
	
	// Выясним способ расчета калорийности, если она не задана в номенклатуре
	Если Элементы.СпособРасчетаКалорийности.СписокВыбора.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(ТекСтрока) И (ПолучитьРеквизитОбъекта(ТекСтрока,"СпособРасчетаКалорийности") = ПредопределенноеЗначение("Перечисление.питСпособыРасчетаКалорийности.ПоФормуле")) Тогда
			Элементы.СпособРасчетаКалорийности.СписокВыбора[0].Представление = "<По рецептуре>";
		Иначе	
			Элементы.СпособРасчетаКалорийности.СписокВыбора[0].Представление = "<По константе>";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - При закрытии фрагмент.
//
&НаКлиенте
Процедура ПриЗакрытииФрагмент()
	
	ТекущаяНоменклатура = Неопределено;
	
КонецПроцедуры

//  Процедура - Автозаполнение основными характеристиками фрагмент.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
&НаКлиенте
Процедура АвтозаполнениеОсновнымиХарактеристикамиФрагмент(Знач ТекРецептура)
	
	АвтозаполнениеОсновнымиХарактеристикамиСервер(ТекРецептура);
	ОбновитьТаблицыХЭХ();
	
КонецПроцедуры

//  Процедура - Автозаполнение основными характеристиками сервер.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
&НаСервере
Процедура АвтозаполнениеОсновнымиХарактеристикамиСервер(ТекРецептура)
	ОчиститьХЭХТекущейРецептуры(ТекРецептура);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Номенклатура КАК Номенклатура,
	|	ХимикоэнергетическиеХарактеристики.Ссылка КАК ХимикоэнергетическаяХарактеристика,
	|	ХимикоэнергетическиеХарактеристики.ЕдиницаИзмерения
	|ИЗ
	|	Справочник.питХимикоэнергетическиеХарактеристики КАК ХимикоэнергетическиеХарактеристики
	|ГДЕ
	|	ХимикоэнергетическиеХарактеристики.Предопределенный
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХимикоэнергетическиеХарактеристики.Наименование";
	Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока				= СоставХЭХ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ЗначениеИзменено	= Истина;
		НоваяСтрока.Рецептура	= ТекРецептура;
		Модифицированность		= Истина;
	КонецЦикла;
	
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками для печати фрагмент.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиДляПечатиФрагмент(Знач ТекРецептура)
	
	Перем ВыбранныйМакет, СписокМакетов;
	
	СписокМакетов = ПолучитьСписокМакетов();
	СписокМакетов.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("АвтозаполнениеХарактеристикамиДляПечатиФрагментЗавершение", ЭтотОбъект, Новый Структура("ТекРецептура", ТекРецептура)), "Выберите макет ПФ с ХЭХ");

КонецПроцедуры

//  Функция - Получить список макетов.
//
// Возвращаемое значение:
//  СписокЗначений - Результат обработки.
//
&НаСервереБезКонтекста
Функция ПолучитьСписокМакетов()
	// Попросим выбрать макет ХЭХ
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	ВидыМакетовХЭХ.Ссылка
	|ИЗ
	|	Перечисление.питВидыМакетовХЭХ КАК ВидыМакетовХЭХ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыМакетовХЭХ.Порядок";
	
	Выборка = Запрос.Выполнить().Выбрать();
	СписокМакетов = Новый СписокЗначений();
	Пока Выборка.Следующий() Цикл
		НовыйМакет = СписокМакетов.Добавить(Выборка.Ссылка);
		НовыйМакет.Представление = СокрЛП(НовыйМакет.Значение);
	КонецЦикла;
	
	Возврат СписокМакетов;
КонецФункции

//  Процедура - Автозаполнение характеристиками для печати сервер.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//  ВыбранныйМакет - Произвольный - Выбранный макет.
//
&НаСервере
Процедура АвтозаполнениеХарактеристикамиДляПечатиСервер(ТекРецептура, ВыбранныйМакет)
	ОчиститьХЭХТекущейРецептуры(ТекРецептура);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Номенклатура КАК Номенклатура,
	|	ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика,
	|	ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.питХЭХДляПечати КАК ХимикоэнергетическиеХарактеристики
	|ГДЕ
	|	ХимикоэнергетическиеХарактеристики.Макет = &Макет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХимикоэнергетическиеХарактеристики.Приоритет";
	
	Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
	Запрос.УстановитьПараметр("Макет", ВыбранныйМакет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СоставХЭХ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
		НоваяСтрока.ЗначениеИзменено  = Истина;
		НоваяСтрока.Рецептура = ТекРецептура;
		Модифицированность = Истина;
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Автозаполнение характеристиками из группы фрагмент.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//
&НаКлиенте
Процедура АвтозаполнениеХарактеристикамиИзГруппыФрагмент(Знач ТекРецептура)
	
	Перем ВыбраннаяГруппа;
	
	ОткрытьФорму("Справочник.питГруппыХЭХ.ФормаВыбора",,,,,, Новый ОписаниеОповещения("АвтозаполнениеХарактеристикамиИзГруппыФрагментЗавершение", ЭтотОбъект, Новый Структура("ТекРецептура", ТекРецептура)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

//  Процедура - Автозаполнение характеристиками из группы сервер.
//
// Параметры:
//  ТекРецептура - Произвольный - Тек рецептура.
//  ВыбраннаяГруппа - Произвольный - Выбранная группа.
//
&НаСервере
Процедура АвтозаполнениеХарактеристикамиИзГруппыСервер(ТекРецептура, ВыбраннаяГруппа)
	ОчиститьХЭХТекущейРецептуры(ТекРецептура);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Номенклатура КАК Номенклатура,
	|	ХимикоэнергетическиеХарактеристики.Ссылка КАК ХимикоэнергетическаяХарактеристика,
	|	ХимикоэнергетическиеХарактеристики.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.питХимикоэнергетическиеХарактеристики КАК ХимикоэнергетическиеХарактеристики
	|ГДЕ
	|	ХимикоэнергетическиеХарактеристики.ГруппаХЭХ = &ВыбраннаяГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХимикоэнергетическиеХарактеристики.Наименование";
	
	Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
	Запрос.УстановитьПараметр("ВыбраннаяГруппа", ВыбраннаяГруппа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СоставХЭХ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
		НоваяСтрока.ЗначениеИзменено  = Истина;
		НоваяСтрока.Рецептура = ТекРецептура;
		Модифицированность = Истина;
	КонецЦикла;
	
	
	
КонецПроцедуры

//  Процедура - Автозаполнение основными характеристиками рецептура фрагмент.
//
// Параметры:
