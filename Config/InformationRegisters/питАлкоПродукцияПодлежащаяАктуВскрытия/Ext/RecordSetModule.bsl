#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Обработчик события "ПриЗаписи"
//
Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если (Количество() > 0) Тогда
		
		// Зарегистрируем всю номенклатуру по всем узлам
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	УдаленныеКассы.Ссылка
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы КАК УдаленныеКассы
		|ГДЕ
		|	НЕ УдаленныеКассы.ПометкаУдаления
		|	И УдаленныеКассы.Ссылка <> &ЭтотУзел";
		
		Запрос.УстановитьПараметр("ЭтотУзел",ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
		РезультатЗапроса = Запрос.Выполнить();
				
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			МассивУзлов = Новый Массив;
			Пока Выборка.Следующий() Цикл
				МассивУзлов.Добавить(Выборка.Ссылка);
			КонецЦикла;
			
			Для Каждого Запись ИЗ ЭтотОбъект Цикл
				Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
					// На всякий случай зарегистрируем доп-но номенклатуру для отправки в этот узел
					питОбменДанными.ДопРегистрацияСправочника(МассивУзлов, Запись.Номенклатура, Истина);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
		
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
