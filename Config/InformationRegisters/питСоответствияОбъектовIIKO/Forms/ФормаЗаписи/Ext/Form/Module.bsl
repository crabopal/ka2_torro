
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
	
		МетаданныеСсылки = Метаданные.НайтиПоТипу(Параметры.Ключ.ТипОбъекта.ТипЗначения.Типы()[0]);
		Попытка
			ПредставлениеОбъекта = МетаданныеСсылки.ПредставлениеОбъекта;
		Исключение
			ПредставлениеОбъекта = МетаданныеСсылки.Синоним;
		КонецПопытки;

		Элементы.Ссылка1С.Заголовок = ПредставлениеОбъекта;
		Элементы.Ссылка1С.ОграничениеТипа = Параметры.Ключ.ТипОбъекта.ТипЗначения;
		
		ЭтаФорма.Заголовок = "Соответствие объекта <"+ПредставлениеОбъекта+"> элементу в iiko";
		ЭтаФорма.АвтоЗаголовок=Ложь;
		
		Попытка
			Элементы.ЭтоГруппа.Видимость = МетаданныеСсылки.Иерархический;
		Исключение
			Элементы.ЭтоГруппа.Видимость = ложь;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура Ссылка1СПриИзменении(Элемент)
	Ссылка1СПриИзмененииНасервере();
КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Ссылка1СПриИзмененииНасервере()
	Если ЗначениеЗаполнено(Запись.Ссылка1С) И Запись.ТипОбъекта = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	питВидыНоменклатурыОбщепит.ВидимостьКоманд КАК ВидимостьКоманд
		               |ИЗ
		               |	РегистрСведений.питВидыНоменклатурыОбщепит КАК питВидыНоменклатурыОбщепит
		               |ГДЕ
		               |	питВидыНоменклатурыОбщепит.ВидНоменклатуры = &ВидНоменклатуры";
		Запрос.УстановитьПараметр("ВидНоменклатуры",Запись.Ссылка1С);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не (Выборка.Следующий() И Выборка.ВидимостьКоманд) Тогда
			ОбщегоНазначения.СообщитьПользователю("Выбранное значение не является Видом номенклатуры Общепита. Воспользуйтесь обработкой ""Виды номенклатуры общепит""");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
