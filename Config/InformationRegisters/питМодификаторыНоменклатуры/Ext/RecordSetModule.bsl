#Область ОбработчикиСобытий

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Обработчик события "ПриЗаписи"
//
Процедура ПриЗаписи(Отказ, Замещение)
	
	Если (Количество() = 0) Тогда
		Возврат;
	КонецЕсли;	
	
	МассивУзловПолучателей = питОбменДаннымиПовтИсп.ПолучитьМассивУзловДляВыгрузкиМодификаторов();
	Если (МассивУзловПолучателей.Количество() = 0) Тогда
		Возврат;
	КонецЕсли;	
		
		
	Для Каждого Запись ИЗ ЭтотОбъект Цикл
		
		Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
			// На всякий случай зарегистрируем доп-но номенклатуру для отправки в этот узел
			питОбменДанными.ДопРегистрацияСправочника(МассивУзловПолучателей, Запись.Номенклатура, Истина);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.Модификатор) Тогда
			// На всякий случай зарегистрируем доп-но модификатор
			питОбменДанными.ДопРегистрацияСправочника(МассивУзловПолучателей, Запись.Модификатор, Истина);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.ГруппаМодификатора) Тогда
			// На всякий случай зарегистрируем доп-но группу модификаторов
			питОбменДанными.ДопРегистрацияСправочника(МассивУзловПолучателей, Запись.ГруппаМодификатора, Ложь);
			// И всех модификаторов из его ТЧ
			Если Запись.ГруппаМодификатора.Модификаторы.Количество() > 0 Тогда
				Для Каждого СтрТЧ ИЗ Запись.ГруппаМодификатора.Модификаторы Цикл
					Если ЗначениеЗаполнено(СтрТЧ.Модификатор) Тогда
						питОбменДанными.ДопРегистрацияСправочника(МассивУзловПолучателей, СтрТЧ.Модификатор, Истина);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
#КонецЕсли

#КонецЕсли

#КонецОбласти

#КонецЕсли
