#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Структура сведений по контракту ГОЗ.
// 
// Возвращаемое значение:
//  Структура - Структура сведений по контракту ГОЗ:
// * Период - Дата - Дата сведений
// * НаправлениеДеятельности - СправочникСсылка.НаправленияДеятельности - Направление деятельности контракта
// * ПлановаяДатаЗавершения  - Дата
// * ОбъемФинансированияКонтракта - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * СуммаНДС - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ЗатратыНаМатериалы - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ЗатратыНаОплатуТруда - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ПрочиеПроизводственныеЗатраты - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ОбщепроизводственныеЗатраты - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ОбщехозяйственныеЗатраты - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * Затраты - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная - Сумма параметров ЗатратыНаМатериалы, 
// 				ЗатратыНаОплатуТруда, ПрочиеПроизводственныеЗатраты, ОбщехозяйственныеЗатраты.
// * КоммерческиеРасходы - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ПрибыльКонтракта - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * УправленческиеРасходы - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ОбъемКредитования - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ПроцентыПоКредитам - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * ГосударственныйКонтракт - СправочникСсылка.ГосударственныеКонтракты
// * НомерКонтракта - Строка
// * ДатаЗаключенияКонтракта - Дата
// * НомерОтдельногоСчета - Строка
// * ФактическаяДатаЗавершения - Дата
// * СуммаВозмещаемыхРасходов - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная
// * СписаниеДенежныхСредствСОтдельногоСчета - ОпределяемыйТип.ДенежнаяСуммаНеотрицательная - 
// 											Сумма параметров СуммаВозмещаемыхРасходов, ПрибыльКонтракта.
//
Функция СтруктураСведенийПоКонтракту() Экспорт
	
	СтруктураСведений = Новый Структура;
	
	СтруктураСведений.Вставить("Период", Дата(1,1,1));
	СтруктураСведений.Вставить("НаправлениеДеятельности", Справочники.НаправленияДеятельности.ПустаяСсылка());
	
	СтруктураСведений.Вставить("ПлановаяДатаЗавершения", Дата(1,1,1));
	СтруктураСведений.Вставить("ОбъемФинансированияКонтракта", 0);
	СтруктураСведений.Вставить("СуммаНДС", 0);
	
	СтруктураСведений.Вставить("ЗатратыНаМатериалы", 0);
	СтруктураСведений.Вставить("ЗатратыНаОплатуТруда", 0);
	СтруктураСведений.Вставить("ПрочиеПроизводственныеЗатраты", 0);
	СтруктураСведений.Вставить("ОбщепроизводственныеЗатраты", 0);
	СтруктураСведений.Вставить("ОбщехозяйственныеЗатраты", 0);
	СтруктураСведений.Вставить("Затраты", 0);
	
	СтруктураСведений.Вставить("КоммерческиеРасходы", 0);
	СтруктураСведений.Вставить("ПрибыльКонтракта", 0);
	СтруктураСведений.Вставить("УправленческиеРасходы", 0);
	СтруктураСведений.Вставить("ОбъемКредитования", 0);
	СтруктураСведений.Вставить("ПроцентыПоКредитам", 0);
	
	СтруктураСведений.Вставить("ГосударственныйКонтракт", Справочники.ГосударственныеКонтракты.ПустаяСсылка());
	СтруктураСведений.Вставить("НомерКонтракта", "");
	СтруктураСведений.Вставить("ДатаЗаключенияКонтракта", Дата(1,1,1));
	СтруктураСведений.Вставить("НомерОтдельногоСчета", "");
	
	СтруктураСведений.Вставить("ФактическаяДатаЗавершения", Дата(1,1,1));
	СтруктураСведений.Вставить("СуммаВозмещаемыхРасходов", 0);
	
	СтруктураСведений.Вставить("СписаниеДенежныхСредствСОтдельногоСчета", 0);

	Возврат СтруктураСведений;
	
КонецФункции

// Возвращает целевые параметры контракта ГОЗ
//
// Параметры:
// 	НаправлениеДеятельности - СправочникСсылка.НаправленияДеятельности - Направление деятельности контракта ГОЗ
// 	Дата - Дата, Неопределено - Дата сведений (если Неопределено, то сведения получаются на текущую дату)
// 
// Возвращаемое значение:
// 	см. СтруктураСведенийПоКонтракту
Функция СведенияПоКонтрактуГОЗ(НаправлениеДеятельности, Дата = Неопределено) Экспорт
	
	Результат = СтруктураСведенийПоКонтракту();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияПоКонтрактамГОЗ.Период КАК Период,
	|	СведенияПоКонтрактамГОЗ.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	СведенияПоКонтрактамГОЗ.НаправлениеДеятельности.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	|	СведенияПоКонтрактамГОЗ.ПлановаяДатаЗавершения КАК ПлановаяДатаЗавершения,
	|	СведенияПоКонтрактамГОЗ.ОбъемФинансированияКонтракта КАК ОбъемФинансированияКонтракта,
	|	СведенияПоКонтрактамГОЗ.СуммаНДС КАК СуммаНДС,
	|	СведенияПоКонтрактамГОЗ.ЗатратыНаМатериалы КАК ЗатратыНаМатериалы,
	|	СведенияПоКонтрактамГОЗ.ЗатратыНаОплатуТруда КАК ЗатратыНаОплатуТруда,
	|	СведенияПоКонтрактамГОЗ.ПрочиеПроизводственныеЗатраты КАК ПрочиеПроизводственныеЗатраты,
	|	СведенияПоКонтрактамГОЗ.ОбщепроизводственныеЗатраты КАК ОбщепроизводственныеЗатраты,
	|	СведенияПоКонтрактамГОЗ.ОбщехозяйственныеЗатраты КАК ОбщехозяйственныеЗатраты,
	|	СведенияПоКонтрактамГОЗ.КоммерческиеРасходы КАК КоммерческиеРасходы,
	|	СведенияПоКонтрактамГОЗ.ПрибыльКонтракта КАК ПрибыльКонтракта,
	|	СведенияПоКонтрактамГОЗ.УправленческиеРасходы КАК УправленческиеРасходы,
	|	СведенияПоКонтрактамГОЗ.ОбъемКредитования КАК ОбъемКредитования,
	|	СведенияПоКонтрактамГОЗ.ПроцентыПоКредитам КАК ПроцентыПоКредитам,
	|	СведенияПоКонтрактамГОЗ.НомерКонтракта КАК НомерКонтракта,
	|	СведенияПоКонтрактамГОЗ.ДатаЗаключенияКонтракта КАК ДатаЗаключенияКонтракта,
	|	СведенияПоКонтрактамГОЗ.НомерОтдельногоСчета КАК НомерОтдельногоСчета,
	|	СведенияПоКонтрактамГОЗ.ФактическаяДатаЗавершения КАК ФактическаяДатаЗавершения,
	|	СведенияПоКонтрактамГОЗ.СуммаВозмещаемыхРасходов КАК СуммаВозмещаемыхРасходов
	|ИЗ
	|	РегистрСведений.СведенияПоКонтрактамГОЗ.СрезПоследних(&Дата, НаправлениеДеятельности = &НаправлениеДеятельности) КАК
	|		СведенияПоКонтрактамГОЗ";
	Запрос.УстановитьПараметр("Дата", ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Запрос.УстановитьПараметр("НаправлениеДеятельности", НаправлениеДеятельности);
	
	Выборка  = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Результат.Затраты = 
			Результат.ЗатратыНаМатериалы 
			+ Результат.ЗатратыНаОплатуТруда
			+ Результат.ПрочиеПроизводственныеЗатраты
			+ Результат.ОбщепроизводственныеЗатраты
			+ Результат.ОбщехозяйственныеЗатраты;
		
	Результат.СписаниеДенежныхСредствСОтдельногоСчета = 
			Результат.СуммаВозмещаемыхРасходов
			+ Результат.ПрибыльКонтракта;
	
	Если ЗначениеЗаполнено(Результат.ПлановаяДатаЗавершения) Тогда
		Результат.ПлановаяДатаЗавершения = КонецДня(Результат.ПлановаяДатаЗавершения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РегистрыСведений.СведенияПоКонтрактамГОЗ.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.27.26";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("0333bb7f-f4fb-4722-aae7-6e32e45c2441");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыСведений.СведенияПоКонтрактамГОЗ.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Некритичный;
	Обработчик.Комментарий = НСтр("ru = 'Заполняет новый регистр ""Сведения по контрактам ГОЗ"" по данным справочника ""Направления деятельности"".'");
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Справочники.НаправленияДеятельности.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.РегистрыСведений.СведенияПоКонтрактамГОЗ.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Блокируемые.Добавить(Метаданные.РегистрыСведений.СведенияПоКонтрактамГОЗ.ПолноеИмя());
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");
	
	Обработчик.ПриоритетыВыполнения = ОбновлениеИнформационнойБазы.ПриоритетыВыполненияОбработчика();
	
КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	ПолноеИмяРегистра = СоздатьНаборЗаписей().Метаданные().ПолноеИмя();

	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаРегистров = ПолноеИмяРегистра;
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиИзмеренияНезависимогоРегистраСведений();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.Вставить("ЭтоНезависимыйРегистрСведений", Истина);
	ДополнительныеПараметры.Вставить("ПолноеИмяРегистра", ПолноеИмяРегистра);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НаправленияДеятельности.Ссылка КАК НаправлениеДеятельности
	|ИЗ
	|	Справочник.НаправленияДеятельности КАК НаправленияДеятельности
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияПоКонтрактамГОЗ КАК СведенияПоКонтрактамГОЗ
	|	ПО СведенияПоКонтрактамГОЗ.НаправлениеДеятельности = НаправленияДеятельности.Ссылка
	|ГДЕ
	|	НаправленияДеятельности.УдалитьТипНаправленияДеятельности = ЗНАЧЕНИЕ(Перечисление.УдалитьТипыНаправленийДеятельности.КонтрактГОЗ)
	|	И СведенияПоКонтрактамГОЗ.НаправлениеДеятельности ЕСТЬ NULL";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить(), ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяРегистра = СоздатьНаборЗаписей().Метаданные().ПолноеИмя();
	ПолноеИмяСправочника = Метаданные.Справочники.НаправленияДеятельности.ПолноеИмя();
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ПолноеИмяРегистра);
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из ОбновляемыеДанные Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяСправочника);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СтрокаТаблицы.НаправлениеДеятельности);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
			
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяРегистра);
			ЭлементБлокировки.УстановитьЗначение("НаправлениеДеятельности", СтрокаТаблицы.НаправлениеДеятельности);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			РеквизитыСправочника = Новый Структура;
			РеквизитыСправочника.Вставить("Период", "УдалитьДатаЗаключенияКонтракта");
			
			РеквизитыСправочника.Вставить("НаправлениеДеятельности", "Ссылка");
			
			РеквизитыСправочника.Вставить("ПлановаяДатаЗавершения", "УдалитьПлановаяДатаЗавершения");
			РеквизитыСправочника.Вставить("ОбъемФинансированияКонтракта", "УдалитьОбъемФинансированияКонтракта");
			РеквизитыСправочника.Вставить("СуммаНДС", "УдалитьСуммаНДС");
			РеквизитыСправочника.Вставить("ЗатратыНаМатериалы", "УдалитьЗатратыНаМатериалы");
			РеквизитыСправочника.Вставить("ЗатратыНаОплатуТруда", "УдалитьЗатратыНаОплатуТруда");
			РеквизитыСправочника.Вставить("ПрочиеПроизводственныеЗатраты", "УдалитьПрочиеПроизводственныеЗатраты");
			РеквизитыСправочника.Вставить("ОбщепроизводственныеЗатраты", "УдалитьОбщепроизводственныеЗатраты");
			РеквизитыСправочника.Вставить("ОбщехозяйственныеЗатраты", "УдалитьОбщехозяйственныеЗатраты");
			РеквизитыСправочника.Вставить("КоммерческиеРасходы", "УдалитьКоммерческиеРасходы");
			РеквизитыСправочника.Вставить("ПрибыльКонтракта", "УдалитьПрибыльКонтракта");
			РеквизитыСправочника.Вставить("УправленческиеРасходы", "УдалитьУправленческиеРасходы");
			РеквизитыСправочника.Вставить("ОбъемКредитования", "УдалитьОбъемКредитования");
			РеквизитыСправочника.Вставить("ПроцентыПоКредитам", "УдалитьПроцентыПоКредитам");
			РеквизитыСправочника.Вставить("НомерКонтракта", "УдалитьНомерКонтракта");
			РеквизитыСправочника.Вставить("ДатаЗаключенияКонтракта", "УдалитьДатаЗаключенияКонтракта");
			РеквизитыСправочника.Вставить("НомерОтдельногоСчета", "УдалитьНомерОтдельногоСчета");
			РеквизитыСправочника.Вставить("ФактическаяДатаЗавершения", "УдалитьФактическаяДатаЗавершения");
			РеквизитыСправочника.Вставить("СуммаВозмещаемыхРасходов", "УдалитьСуммаВозмещаемыхРасходов");
			
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.НаправлениеДеятельности, РеквизитыСправочника);
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НаправлениеДеятельности.Установить(СтрокаТаблицы.НаправлениеДеятельности);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ЗначенияРеквизитов);
				Если Не ЗначениеЗаполнено(НоваяЗапись.Период) Тогда
					// Период обязательно должен быть заполнен.
					НоваяЗапись.Период = Дата(1980, 1, 1);
				КонецЕсли;
			КонецЕсли;
	
			Если НаборЗаписей.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(НаборЗаписей);
			КонецЕсли;
				
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось создать запись сведений по направлению деятельности: %Объект% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", СтрокаТаблицы.НаправлениеДеятельности);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОписаниеОшибки());
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
									УровеньЖурналаРегистрации.Предупреждение,
									НаборЗаписей.Метаданные(),
									СтрокаТаблицы.НаправлениеДеятельности,
									ТекстСообщения);
			
		КонецПопытки;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяРегистра);

КонецПроцедуры

