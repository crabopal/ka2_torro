

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.питУдаленныеКассыЛогированиеНастройки КАК УдаленныеКассыЛогированиеНастройки";
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Запись.ДлительностьХраненияЗаписей) Тогда
		Запись.ДлительностьХраненияЗаписей = 1;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	Закрыть();
КонецПроцедуры


&НаКлиенте
Процедура ПосмотретьЛог(Команда)
	
	ОткрытьФорму("РегистрСведений.питУдаленныеКассыЛогирование.Форма.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНаСервере()
	НоваяЗапись = РегистрыСведений.питУдаленныеКассыЛогированиеНастройки.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, Запись);
	НоваяЗапись.Записать(Истина);
	
	питОбщегоНазначения.ИзменитьРегламентноеЗадание("питУдаленныеКассыЛогированиеОчистка", Запись.ЛогированиеВключено);
	
КонецПроцедуры

