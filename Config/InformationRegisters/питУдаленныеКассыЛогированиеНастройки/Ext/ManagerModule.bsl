//  Функция - Настройки логирования.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НастройкиЛогирования() Экспорт
	
	Результат = Новый Структура;
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.ЛогированиеВключено КАК ЛогированиеВключено,
	|	Настройки.ДлительностьХраненияЗаписей КАК ДлительностьХраненияЗаписей,
	|	Настройки.УровеньЛогирования КАК УровеньЛогирования
	|ИЗ
	|	РегистрСведений.питУдаленныеКассыЛогированиеНастройки КАК Настройки";
	Запрос.Текст = ТекстЗапроса;

	РезультатЗапроса = Запрос.Выполнить();
	Результат = питОбщегоНазначения.ПустаяСтруктураПоРезультатуЗапроса(РезультатЗапроса);
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Результат.ЛогированиеВключено = Результат.ЛогированиеВключено = Истина;
	Если НЕ ЗначениеЗаполнено(Результат.ДлительностьХраненияЗаписей) Тогда
		Результат.ДлительностьХраненияЗаписей = 1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//  Функция - Логировать метод по уровню.
//
// Параметры:
//  МетодСобытия - Произвольный - Метод события.
//  УровеньЛогирования - Произвольный - Уровень логирования.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ЛогироватьМетодПоУровню(МетодСобытия, УровеньЛогирования = Неопределено) Экспорт
	
	// Уровни логирования:
	// 0 - Только Загрузка и выгрузка.
	// 1 - Полный лог.
	
	Результат = Истина;
	Если УровеньЛогирования = Неопределено Тогда
		ТекНастройки = НастройкиЛогирования();
		Если ТекНастройки.ЛогированиеВключено Тогда
			Результат = Ложь;
			Возврат Результат;
		КонецЕсли;
		УровеньЛогирования = ТекНастройки.УровеньЛогирования;
	КонецЕсли;
	
	Если УровеньЛогирования = 0
		// И НЕ (МетодСобытия = питОбменДаннымиHTTP.Метод_ВыгрузитьСообщениеВБэк()
		// ИЛИ МетодСобытия = питОбменДаннымиHTTP.Метод_ЗапроситьСообщениеИзБэка()
		// ИЛИ МетодСобытия = питОбменДаннымиHTTP.Метод_ПолучитьСтатусГотовностиВыгрузки())
		Тогда
		
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
		
