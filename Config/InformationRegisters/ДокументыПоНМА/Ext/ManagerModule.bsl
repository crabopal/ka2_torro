#Область ОбновлениеИнформационнойБазы

// см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РегистрыСведений.ДокументыПоНМА.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.27.30";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("2242cd40-de88-467e-b44d-8c0e6b1e56b3");
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыСведений.ДокументыПоНМА.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Некритичный;
	Обработчик.Комментарий = НСтр("ru = 'Обновляет регистр ""Документы по НМА"" по данным исходных документов.
	|Пока работа обработчика не завершена, журнал документов по НМА может работать некорректно.'");
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.ВводОстатковВнеоборотныхАктивов2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ВнутреннееПотребление.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ИзменениеПараметровНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ИнвентаризацияНМА.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.КорректировкаСтоимостиИАмортизацииНМА.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПеремещениеНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПодготовкаКПередачеНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПринятиеКУчетуНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПриобретениеТоваровУслуг.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПриобретениеУслугПрочихАктивов.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.РеализацияУслугПрочихАктивов.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.СписаниеНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.УлучшениеНМА.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.РегистрыСведений.ДокументыПоНМА.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Блокируемые.Добавить(Метаданные.РегистрыСведений.ДокументыПоНМА.ПолноеИмя());
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");
	
КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.ДокументыПоНМА";
	ИмяРегистра = "ДокументыПоНМА";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.Вставить("ЭтоНезависимыйРегистрСведений", Истина);
	ДополнительныеПараметры.Вставить("ПолноеИмяРегистра", "РегистрСведений.ДокументыПоНМА");

	#Область Произвольная
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеДокумента.Ссылка
	|	ИЗ
	|		Документ.ИнвентаризацияНМА КАК ДанныеДокумента
	|
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыПоНМА КАК ДокументыПоНМА
	|			ПО ДокументыПоНМА.Ссылка = ДанныеДокумента.Ссылка
	|
	|	ГДЕ
	|		НЕ ДанныеДокумента.ОтражатьВУпрУчете
	|			И НЕ ДанныеДокумента.ОтражатьВРеглУчете
	|			И НЕ ДанныеДокумента.ОтражатьВБУ
	|			И НЕ ДанныеДокумента.ОтражатьВНУ
	|		ИЛИ ДанныеДокумента.ОтражатьВУпрУчете <> ЕСТЬNULL(ДокументыПоНМА.ОтражатьВУпрУчете, ЛОЖЬ)
	|		ИЛИ ДанныеДокумента.ОтражатьВБУ <> ЕСТЬNULL(ДокументыПоНМА.ОтражатьВРеглУчете, ЛОЖЬ)
	|		ИЛИ ДанныеДокумента.ОтражатьВНУ <> ЕСТЬNULL(ДокументыПоНМА.ОтражатьВНУ, ЛОЖЬ)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТаблицаНМА.Ссылка
	|	ИЗ
	|		Документ.ВнутреннееПотребление.Товары КАК ТаблицаНМА
	|
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыПоНМА КАК ДокументыПоНМА
	|			ПО ДокументыПоНМА.Ссылка = ТаблицаНМА.Ссылка
	|				И ДокументыПоНМА.НомерЗаписи = 0
	|
	|	ГДЕ
	|		(ДокументыПоНМА.Ссылка ЕСТЬ NULL
	|			ИЛИ НЕ ЕСТЬNULL(ДокументыПоНМА.ОтражатьВНУ, ЛОЖЬ))
	|
	|		И (ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ИЛИ ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ИЛИ ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы))
	|
	|		И ТаблицаНМА.АналитикаРасходов <> НЕОПРЕДЕЛЕНО
	|		И ТаблицаНМА.АналитикаРасходов ССЫЛКА Справочник.НематериальныеАктивы
	|		И ТаблицаНМА.АналитикаРасходов <> ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТаблицаНМА.Ссылка
	|	ИЗ
	|		Документ.ПриобретениеУслугПрочихАктивов.Расходы КАК ТаблицаНМА
	|
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыПоНМА КАК ДокументыПоНМА
	|			ПО ДокументыПоНМА.Ссылка = ТаблицаНМА.Ссылка
	|				И ДокументыПоНМА.НомерЗаписи = 0
	|
	|	ГДЕ
	|		(ДокументыПоНМА.Ссылка ЕСТЬ NULL
	|			ИЛИ НЕ ЕСТЬNULL(ДокументыПоНМА.ОтражатьВНУ, ЛОЖЬ))
	|
	|		И (ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ИЛИ ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ИЛИ ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы))
	|
	|		И ТаблицаНМА.АналитикаРасходов <> НЕОПРЕДЕЛЕНО
	|		И ТаблицаНМА.АналитикаРасходов ССЫЛКА Справочник.НематериальныеАктивы
	|		И ТаблицаНМА.АналитикаРасходов <> ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ТаблицаНМА.Ссылка
	|	ИЗ
	|		Документ.ПриобретениеТоваровУслуг.Товары КАК ТаблицаНМА
	|
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыПоНМА КАК ДокументыПоНМА
	|			ПО ДокументыПоНМА.Ссылка = ТаблицаНМА.Ссылка
	|				И ДокументыПоНМА.НомерЗаписи = 0
	|
	|	ГДЕ
	|		ДокументыПоНМА.Ссылка ЕСТЬ NULL
	|
	|		И ТаблицаНМА.СписатьНаРасходы
	|
	|		И (ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ИЛИ ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы)
	|			ИЛИ ТаблицаНМА.СтатьяРасходов.ВариантРаспределенияРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаВнеоборотныеАктивы))
	|
	|		И ТаблицаНМА.АналитикаРасходов <> НЕОПРЕДЕЛЕНО
	|		И ТаблицаНМА.АналитикаРасходов ССЫЛКА Справочник.НематериальныеАктивы
	|		И ТаблицаНМА.АналитикаРасходов <> ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка)
	|
	|	) КАК СписокДокументов
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);

	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить(), ДополнительныеПараметры);
	
	#КонецОбласти
	
	#Область АдаптированныйТекстЗапросаДвиженийПоРегистру
	
	СписокДокументов = Новый Массив;
	СписокДокументов.Добавить("Документ.ВводОстатковВнеоборотныхАктивов2_4");
	СписокДокументов.Добавить("Документ.ИзменениеПараметровНМА2_4");
	СписокДокументов.Добавить("Документ.КорректировкаСтоимостиИАмортизацииНМА");
	СписокДокументов.Добавить("Документ.ПеремещениеНМА2_4");
	СписокДокументов.Добавить("Документ.ПодготовкаКПередачеНМА2_4");
	СписокДокументов.Добавить("Документ.ПринятиеКУчетуНМА2_4");
	СписокДокументов.Добавить("Документ.РеализацияУслугПрочихАктивов");
	СписокДокументов.Добавить("Документ.СписаниеНМА2_4");
	СписокДокументов.Добавить("Документ.УлучшениеНМА");

	Для каждого ПолноеИмяДокумента Из СписокДокументов Цикл
		ИмяДокумента = СтрРазделить(ПолноеИмяДокумента, ".")[1];
		ТекстЗапросаМеханизмаПроведения = Документы[ИмяДокумента].АдаптированныйТекстЗапросаДвиженийПоРегистру(ИмяРегистра);
		Регистраторы = ОбновлениеИнформационнойБазыУТ.ДанныеНезависимогоРегистраДляПерепроведения(
								ТекстЗапросаМеханизмаПроведения,
								ПолноеИмяРегистра,
								ПолноеИмяДокумента);
								
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Регистраторы, ДополнительныеПараметры);
	КонецЦикла; 
	
	#КонецОбласти
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.ВводОстатковВнеоборотныхАктивов2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ВнутреннееПотребление.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ИзменениеПараметровНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ИнвентаризацияНМА.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.КорректировкаСтоимостиИАмортизацииНМА.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПеремещениеНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПодготовкаКПередачеНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПринятиеКУчетуНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПриобретениеТоваровУслуг.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.ПриобретениеУслугПрочихАктивов.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.РеализацияУслугПрочихАктивов.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.СписаниеНМА2_4.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Документы.УлучшениеНМА.ПолноеИмя());

	Для Каждого ПолноеИмя Из Читаемые Цикл
		
		Если ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, ПолноеИмя) Тогда
			Параметры.ОбработкаЗавершена = Ложь;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;

	ДополнительныеПараметры = ОбновлениеИнформационнойБазыУТ.ДополнительныеПараметрыПерезаписиДвиженийИзОчереди();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ИмяИзмеренияДляОтбора = "Ссылка";
	ДополнительныеПараметры.НужнаДополнительнаяОбработкаЗаписей = Истина;
	
	ПоляУпорядочивания = Новый Массив;
	ПоляУпорядочивания.Добавить("Ссылка.Дата УБЫВ");
	ДополнительныеПараметры.ПоляУпорядочивания = ПоляУпорядочивания;
	
	ОбработкаЗавершена = ОбновлениеИнформационнойБазыУТ.ПерезаписатьДвиженияИзОчереди(
							Неопределено,
							"РегистрСведений.ДокументыПоНМА",
							Параметры.Очередь,
							ДополнительныеПараметры);
	
	Параметры.ОбработкаЗавершена = ОбработкаЗавершена;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
