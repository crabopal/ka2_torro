
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// открываем из регистра номенклатуры
	
	Если Параметры.Свойство("ЗначенияЗаполнения") И Параметры.ЗначенияЗаполнения.Свойство("НоменклатураСкладская") Тогда 
		Элементы.НоменклатураСкладская.ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли; 
	//Создаем/открываем из АРМа
	Если Параметры.Свойство("ЭтоАрмНоменклатураПроизводственная") Тогда
		Если НЕ ЗначениеЗаполнено(Запись.НоменклатураПроизводственная) Тогда
			Запись.НоменклатураПроизводственная = Параметры.ЭтоАрмНоменклатураПроизводственная;
			Элементы.НоменклатураПроизводственная.ТолькоПросмотр = Истина;
		КонецЕсли; 
	КонецЕсли;
	СформироватьЗаголовки(3);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская.Представление КАК НоменклатураСкладскаяПредставление,
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная.Представление КАК НоменклатураПроизводственнаяПредставление
	|ИЗ
	|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
	|ГДЕ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская = &НоменклатураСкладская
	|	И питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная <> &НоменклатураПроизводственная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская.Представление КАК НоменклатураСкладскаяПредставление,
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная.Представление КАК НоменклатураПроизводственнаяПредставление,
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская КАК НоменклатураСкладская,
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная КАК НоменклатураПроизводственная
	|ИЗ
	|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
	|ГДЕ
	|	(питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская = &НоменклатураПроизводственная
	|			ИЛИ питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная = &НоменклатураСкладская)";
	
	Запрос.УстановитьПараметр("НоменклатураСкладская", Запись.НоменклатураСкладская);
	Запрос.УстановитьПараметр("НоменклатураПроизводственная", Запись.НоменклатураПроизводственная);
	
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	
	РезультатЗапроса = РезультатЗапросаПакет[0];
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю("Для складской номенклатуры <"+ВыборкаДетальныеЗаписи.НоменклатураСкладскаяПредставление+"> уже выбрана производственная номенклатура <" + ВыборкаДетальныеЗаписи.НоменклатураПроизводственнаяПредставление + ">");
		Отказ = Истина;
	КонецЦикла;
	
	РезультатЗапроса = РезультатЗапросаПакет[1];
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.НоменклатураСкладская = Запись.НоменклатураПроизводственная Тогда
			ТекстСообщения = "Производственная номенклатура <"+ВыборкаДетальныеЗаписи.НоменклатураСкладскаяПредставление + "> уже выбрана как складская для номенклатуры <" + ВыборкаДетальныеЗаписи.НоменклатураПроизводственнаяПредставление + ">";
		Иначе
			ТекстСообщения = "Складская номенклатура <"+ВыборкаДетальныеЗаписи.НоменклатураПроизводственнаяПредставление + "> уже выбрана как производственная для номенклатуры <" + ВыборкаДетальныеЗаписи.НоменклатураСкладскаяПредставление + ">";
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецЦикла;
	
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю("Запись не возможна");
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура НоменклатураПроизводственнаяПриИзменении(Элемент)
	ПриИзмененииНоменклатурыНаСервере(2);
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураСкладскаяПриИзменении(Элемент)
	ПриИзмененииНоменклатурыНаСервере(1);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Авто(Команда)
	Запись.Приоритет = ПриоритетАвтоНаСервере(Запись.НоменклатураПроизводственная, Запись.НоменклатураСкладская);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиСобытийЭлементов

&НаСервере
Процедура ПриИзмененииНоменклатурыНаСервере(ТипЗаголовков)

	Если ЗначениеЗаполнено(Запись.НоменклатураПроизводственная) 
		И ЗначениеЗаполнено(Запись.НоменклатураСкладская)
		И Запись.Приоритет = 0 Тогда
		Запись.Приоритет = ПриоритетАвтоНаСервере(Запись.НоменклатураПроизводственная, Запись.НоменклатураСкладская);
	КонецЕсли; 
	
	СформироватьЗаголовки(ТипЗаголовков);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПриоритетАвтоНаСервере(НоменклатураПроизводственная, НоменклатураСкладская)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	питСоответствиеНоменклатурыСкладаПроизводства.Приоритет КАК Приоритет
		|ИЗ
		|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
		|ГДЕ
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная = &НоменклатураПроизводственная
		|	И питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская <> &НоменклатураСкладская
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет УБЫВ";
	
	Запрос.УстановитьПараметр("НоменклатураПроизводственная", НоменклатураПроизводственная);
	Запрос.УстановитьПараметр("НоменклатураСкладская", НоменклатураСкладская);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Возврат ВыборкаДетальныеЗаписи.Приоритет + 1;
		КонецЦикла;
	КонецЕсли; 
	
КонецФункции

&НаСервере
Процедура СформироватьЗаголовки(ТипЗаголовков)

	Если ТипЗаголовков = 1 Тогда 
		Элементы.Декорация1.Заголовок = "В 1 " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.НоменклатураСкладская,"ЕдиницаИзмерения.Наименование", Ложь);
	иначеЕсли ТипЗаголовков = 2 тогда
		Элементы.Декорация3.Заголовок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.НоменклатураПроизводственная,"ЕдиницаИзмерения.Наименование", Ложь);
	Иначе
		Элементы.Декорация1.Заголовок = "В 1 " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.НоменклатураСкладская,"ЕдиницаИзмерения.Наименование", Ложь);
		Элементы.Декорация3.Заголовок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.НоменклатураПроизводственная,"ЕдиницаИзмерения.Наименование", Ложь);
	КонецЕсли; 


КонецПроцедуры

#КонецОбласти
