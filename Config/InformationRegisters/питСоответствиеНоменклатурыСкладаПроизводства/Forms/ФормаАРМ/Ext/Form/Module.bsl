
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная КАК Номенклатура
		|ИЗ
		|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
		|
		|СГРУППИРОВАТЬ ПО
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная";
	
	НоменклатураПроизводства.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЭлементОтбора = НоменклатураСкладская.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НоменклатураПроизводственная");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Неопределено;  
	
	ЕстьПраваНаРедактирование = РольДоступна("ПолныеПрава") ИЛИ РольДоступна("питДобавлениеСоответствияНоменклатурыПроизводства")
		ИЛИ РольДоступна("питОбщепитПолныеПрава");
	Элементы.НоменклатураПроизводстваДобавить.Видимость = ЕстьПраваНаРедактирование;
	Элементы.Удалить.Видимость = ЕстьПраваНаРедактирование;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура НоменклатураПроизводстваПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.НоменклатураПроизводства.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		
		Номенклатура = ТекДанные.Номенклатура;
		/// Отбор создается пр исоздании на сервере
		ЭлементОтбора = НоменклатураСкладская.Отбор.Элементы.Получить(0);
		
		ЭлементОтбора.ПравоеЗначение = Номенклатура;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПроизводстваПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.НоменклатураПроизводства.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Отказ = НЕ НоменклатураПроизводстваПередУдалениемНаСервере(ТекДанные.Номенклатура, ЕстьПраваНаРедактирование);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураСкладскаяПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	// Вставить содержимое обработчика.
	отказ = истина;
	
	ТекДанные = Элементы.НоменклатураПроизводства.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("ЭтоАрмНоменклатураПроизводственная", ТекДанные.Номенклатура);
		
		ОткрытьФорму("РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства.ФормаЗаписи", ПараметрыФормы );
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураСкладскаяПередНачаломИзменения(Элемент, Отказ)
	отказ = истина;
	
	ТекДанные = Элементы.НоменклатураПроизводства.ТекущиеДанные;
	ТекДанныеСкладская = Элементы.НоменклатураСкладская.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПередаваемыеПараметры = Новый Структура;
		ПередаваемыеПараметры.Вставить("НоменклатураПроизводственная",ТекДанные.Номенклатура);
		ПередаваемыеПараметры.Вставить("НоменклатураСкладская",ТекДанныеСкладская.НоменклатураСкладская);
		ПараметрыМассив = Новый Массив;
		ПараметрыМассив.Добавить(ПередаваемыеПараметры); // помещаем структуру в массив
		КлючЗаписиРегистра = Новый("РегистрСведенийКлючЗаписи.питСоответствиеНоменклатурыСкладаПроизводства", ПараметрыМассив); //с помощью массива со структурой создаем ключ записи
		ПараметрыФормы = Новый Структура("ЭтоАрмНоменклатураПроизводственная, Ключ", ТекДанные.Номенклатура, КлючЗаписиРегистра);
		ОткрытьФорму("РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства.ФормаЗаписи", ПараметрыФормы );
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура НоменклатураПроизводстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = НЕ ЕстьПраваНаРедактирование;
КонецПроцедуры



#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПовыситьПриоритет(Команда)
	ТекДанные = Элементы.НоменклатураСкладская.ТекущиеДанные;
	ПовыситьПриоритетНаСервере(ТекДанные.НоменклатураСкладская, ТекДанные.НоменклатураПроизводственная, ТекДанные.Приоритет);
КонецПроцедуры

&НаКлиенте
Процедура ПонизитьПриоритет(Команда)
	ТекДанные = Элементы.НоменклатураСкладская.ТекущиеДанные;
	ПонизитьПриоритетНаСервере(ТекДанные.НоменклатураСкладская, ТекДанные.НоменклатураПроизводственная, ТекДанные.Приоритет);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПовыситьПриоритетНаСервере(НоменклатураСкладская, НоменклатураПроизводственная, Приоритет)
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	питСоответствиеНоменклатурыСкладаПроизводства.Приоритет - 1 КАК Приоритет
		|ИЗ
		|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
		|ГДЕ
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная = &НоменклатураПроизводственная
		|	И питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская <> &НоменклатураСкладская
		|	И питСоответствиеНоменклатурыСкладаПроизводства.Приоритет <= &Приоритет
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет УБЫВ";
	
	Запрос.УстановитьПараметр("НоменклатураПроизводственная", НоменклатураПроизводственная);
	Запрос.УстановитьПараметр("НоменклатураСкладская", НоменклатураСкладская);
	Запрос.УстановитьПараметр("Приоритет", Приоритет);
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Приоритет - 1;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		результат = ВыборкаДетальныеЗаписи.Приоритет;
	КонецЕсли; 
	
	Если Результат < 0 Тогда
		Результат = 0
	КонецЕсли; 
	
	МЗ = РегистрыСведений.питСоответствиеНоменклатурыСкладаПроизводства.СоздатьМенеджерЗаписи();
	МЗ.НоменклатураПроизводственная = НоменклатураПроизводственная;
	МЗ.НоменклатураСкладская = НоменклатураСкладская;
	МЗ.Прочитать();
	Если МЗ.Выбран() Тогда
		МЗ.Приоритет = Результат;
	КонецЕсли; 
	МЗ.Записать();
	Элементы.НоменклатураСкладская.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ПонизитьПриоритетНаСервере(НоменклатураСкладская, НоменклатураПроизводственная, Приоритет)
	Результат = 0;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	питСоответствиеНоменклатурыСкладаПроизводства.Приоритет + 1 КАК Приоритет
		|ИЗ
		|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
		|ГДЕ
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная = &НоменклатураПроизводственная
		|	И питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская <> &НоменклатураСкладская
		|	И питСоответствиеНоменклатурыСкладаПроизводства.Приоритет >= &Приоритет
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	
	Запрос.УстановитьПараметр("НоменклатураПроизводственная", НоменклатураПроизводственная);
	Запрос.УстановитьПараметр("НоменклатураСкладская", НоменклатураСкладская);
	Запрос.УстановитьПараметр("Приоритет", Приоритет);
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Приоритет + 1;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		результат = ВыборкаДетальныеЗаписи.Приоритет;
	КонецЕсли; 
	
	МЗ = РегистрыСведений.питСоответствиеНоменклатурыСкладаПроизводства.СоздатьМенеджерЗаписи();
	МЗ.НоменклатураПроизводственная = НоменклатураПроизводственная;
	МЗ.НоменклатураСкладская = НоменклатураСкладская;
	МЗ.Прочитать();
	Если МЗ.Выбран() Тогда
		МЗ.Приоритет = Результат;
	КонецЕсли; 
	МЗ.Записать();
	
	Элементы.НоменклатураСкладская.Обновить();
	
КонецПроцедуры //ПонизитьПриоритетНаСервере

&НаСервереБезКонтекста
Функция НоменклатураПроизводстваПередУдалениемНаСервере(ПроизводственнаяНоменклатура, ЕстьПраваНаРедактирование)
	Если НЕ ЕстьПраваНаРедактирование Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НЗ = РегистрыСведений.питСоответствиеНоменклатурыСкладаПроизводства.СоздатьНаборЗаписей();
	НЗ.Отбор.НоменклатураПроизводственная.Установить(ПроизводственнаяНоменклатура);
	НЗ.Записать(Истина);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
