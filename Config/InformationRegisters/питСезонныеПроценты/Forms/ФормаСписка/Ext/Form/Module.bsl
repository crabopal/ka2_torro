
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	Если Параметры.Отбор.Свойство("Номенклатура") И ЗначениеЗаполнено(Параметры.Отбор.Номенклатура) Тогда
	
		Элементы.Номенклатура.Видимость = Ложь;
		ЭтаФорма.Заголовок = "Сезоные проценты для """+Параметры.Отбор.Номенклатура+"""";
		ЭтаФорма.АвтоЗаголовок = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
