
#Область ОписаниеПеременных
&НаКлиенте
Перем СоответствиеДней;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Заполним список месяцев
	СписокМесяцев = ПолучитьМесяцы();
	
	// Заполним соответствие максимального количества дней
	СоответствиеДней = Новый Соответствие();
	СоответствиеДней.Вставить(1,31);
	СоответствиеДней.Вставить(2,29);
	СоответствиеДней.Вставить(3,31);
	СоответствиеДней.Вставить(4,30);
	СоответствиеДней.Вставить(5,31);
	СоответствиеДней.Вставить(6,30);
	СоответствиеДней.Вставить(7,31);
	СоответствиеДней.Вставить(8,31);
	СоответствиеДней.Вставить(9,30);
	СоответствиеДней.Вставить(10,31);
	СоответствиеДней.Вставить(11,30);
	СоответствиеДней.Вставить(12,31);
	
	Элементы.МесяцНачалаГодовой.СписокВыбора.ЗагрузитьЗначения(СписокМесяцев.ВыгрузитьЗначения());
	Элементы.МесяцНачалаЕжегодный.СписокВыбора.ЗагрузитьЗначения(СписокМесяцев.ВыгрузитьЗначения());
	Элементы.МесяцКонцаГодовой.СписокВыбора.ЗагрузитьЗначения(СписокМесяцев.ВыгрузитьЗначения());
	Элементы.МесяцКонцаЕжегодный.СписокВыбора.ЗагрузитьЗначения(СписокМесяцев.ВыгрузитьЗначения());
	
	СписокЛет = Новый СписокЗначений();
	Для ПеременнаяЦикла = 2000 По 2030 Цикл
		СписокЛет.Добавить(ПеременнаяЦикла,Формат(ПеременнаяЦикла, "ЧГ="));
	КонецЦикла;
	Элементы.ГодНачала.СписокВыбора.ЗагрузитьЗначения(СписокЛет.ВыгрузитьЗначения());
	Элементы.ГодКонца.СписокВыбора.ЗагрузитьЗначения(СписокЛет.ВыгрузитьЗначения());
	
	Если НЕ ЗначениеЗаполнено(Запись.НачалоСезона) ИЛИ НЕ ЗначениеЗаполнено(Запись.КонецСезона) Тогда
		// По умолчанию с начала года по конец года
		ГодНачала = Год(ТекущаяДата());
		МесяцНачала = 1;
		ЧислоНачала = 1;
		ГодКонца = Год(ТекущаяДата());
		МесяцКонца = 12;
		ЧислоКонца = 31;
		
		СтруктураРедактируемогоСезона = Неопределено;
	Иначе
		// Разберем строки НачалоСезона и КонецСезона
		Если Запись.ИспользоватьГод Тогда
			ГодНачала = Год(Запись.НачалоСезона);
			МесяцНачала = Месяц(Запись.НачалоСезона);
			ЧислоНачала = День(Запись.НачалоСезона);
			ГодКонца = Год(Запись.КонецСезона);
			МесяцКонца = Месяц(Запись.КонецСезона);
			ЧислоКонца = День(Запись.КонецСезона);
		Иначе
			ГодНачала = Год(ТекущаяДата());
			МесяцНачала = Число(Прав(Запись.НачалоСезона,2));
			ЧислоНачала = Число(Лев(Запись.НачалоСезона,2));
			ГодКонца = Год(ТекущаяДата());
			МесяцКонца = Число(Прав(Запись.КонецСезона,2));
			ЧислоКонца = Число(Лев(Запись.КонецСезона,2));
		КонецЕсли;
		
		СтруктураРедактируемогоСезона = Новый Структура("Номенклатура,НачалоСезона,КонецСезона,ИспользоватьГод,Процент",Запись.Номенклатура,Запись.НачалоСезона,Запись.КонецСезона,Запись.ИспользоватьГод,Запись.Процент);
	КонецЕсли;
	
	Если Запись.ИспользоватьГод Тогда
		Элементы.ГруппаСтраницыСезоны.ТекущаяСтраница = Элементы.ГруппаГодовойСезон;
	Иначе
		Элементы.ГруппаСтраницыСезоны.ТекущаяСтраница = Элементы.ГруппаЕжегодныйСезон;
	КонецЕсли;
	Модифицированность = Ложь;
	
	УстановитьМаксимальноеЗначениеЧисла(0)
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// Составим интервал сезона
	Если ТекущийОбъект.ИспользоватьГод Тогда
		// Представление в виде даты.
		ТекущийОбъект.НачалоСезона = Дата(Формат(ГодНачала, "ЧГ=") + Формат(МесяцНачала, "ЧЦ=2; ЧВН=; ЧГ=") + Формат(ЧислоНачала, "ЧЦ=2; ЧВН=; ЧГ="));
		ТекущийОбъект.КонецСезона = Дата(Формат(ГодКонца, "ЧГ=") + Формат(МесяцКонца, "ЧЦ=2; ЧВН=; ЧГ=") + Формат(ЧислоКонца, "ЧЦ=2; ЧВН=; ЧГ="));
	Иначе
		// Представление в виде строки = <два символа день месяца> + <два символа номер месяца>. Пример: "0105".
		ТекущийОбъект.НачалоСезона = Прав("0"+Строка(ЧислоНачала),2)+ Прав("0"+Строка(МесяцНачала),2);
		ТекущийОбъект.КонецСезона = Прав("0"+Строка(ЧислоКонца),2)+ Прав("0"+Строка(МесяцКонца),2);
	КонецЕсли;
	
	ТаблицаПересекающихсяИнтервалов = Новый ТаблицаЗначений;
	ТаблицаПересекающихсяИнтервалов.Колонки.Добавить("НачалоСезона");
	ТаблицаПересекающихсяИнтервалов.Колонки.Добавить("КонецСезона");
	ТаблицаПересекающихсяИнтервалов.Колонки.Добавить("ИспользоватьГод");
	ТаблицаПересекающихсяИнтервалов.Колонки.Добавить("Процент");
	
	// Проверим интервал на пересечение
	Если ТекущийОбъект.ИспользоватьГод Тогда
		Запрос = Новый Запрос;
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СезонныеПроценты.НачалоСезона,
		|	СезонныеПроценты.КонецСезона,
		|	СезонныеПроценты.Процент
		|ИЗ
		|	РегистрСведений.питСезонныеПроценты КАК СезонныеПроценты
		|ГДЕ
		|	СезонныеПроценты.Номенклатура = &Номенклатура
		|	И СезонныеПроценты.ИспользоватьГод";
		
		Если СтруктураРедактируемогоСезона <> Неопределено И СтруктураРедактируемогоСезона.ИспользоватьГод Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	И НЕ (СезонныеПроценты.Номенклатура = &НоменклатураПредыдущая
			|		И СезонныеПроценты.НачалоСезона = &НачалоСезона
			|		И СезонныеПроценты.КонецСезона = &КонецСезона
			|		И СезонныеПроценты.Процент = &Процент)";
			
			Запрос.УстановитьПараметр("НоменклатураПредыдущая", СтруктураРедактируемогоСезона.Номенклатура);
			Запрос.УстановитьПараметр("НачалоСезона", СтруктураРедактируемогоСезона.НачалоСезона);
			Запрос.УстановитьПараметр("КонецСезона", СтруктураРедактируемогоСезона.КонецСезона);
			Запрос.УстановитьПараметр("Процент", СтруктураРедактируемогоСезона.Процент);
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Номенклатура", ТекущийОбъект.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Пересечение = Истина;
			
			Если ТекущийОбъект.НачалоСезона > ТекущийОбъект.КонецСезона ИЛИ Выборка.НачалоСезона > Выборка.КонецСезона Тогда
				// Неправильные интервалы игнорируем.
				Пересечение = Ложь;
			Иначе
				Если (ТекущийОбъект.КонецСезона < Выборка.НачалоСезона) ИЛИ (Выборка.КонецСезона < ТекущийОбъект.НачалоСезона) Тогда
					Пересечение = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если Пересечение Тогда
				Отказ = Истина;
				
				СтрокаИнтервала = ТаблицаПересекающихсяИнтервалов.Добавить();
				СтрокаИнтервала.НачалоСезона = Выборка.НачалоСезона;
				СтрокаИнтервала.КонецСезона = Выборка.КонецСезона;
				СтрокаИнтервала.ИспользоватьГод = Истина;
				СтрокаИнтервала.Процент = Выборка.Процент;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		// Сформируем представление в формате "ММДД", т.е. сначала месяц потом день.
		НачалоУстанавливаемогоИнтервала = Прав(ТекущийОбъект.НачалоСезона,2) + Лев(ТекущийОбъект.НачалоСезона,2);
		КонецУстанавливаемогоИнтервала  = Прав(ТекущийОбъект.КонецСезона,2)  + Лев(ТекущийОбъект.КонецСезона,2);
		
		// Получим Интервалы для номенклатуры, без использования года
		Запрос = Новый Запрос;
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СезонныеПроценты.НачалоСезона,
		|	СезонныеПроценты.КонецСезона,
		|	СезонныеПроценты.Процент
		|ИЗ
		|	РегистрСведений.питСезонныеПроценты КАК СезонныеПроценты
		|ГДЕ
		|	СезонныеПроценты.Номенклатура = &Номенклатура
		|	И (НЕ СезонныеПроценты.ИспользоватьГод)";
		
		Если СтруктураРедактируемогоСезона <> Неопределено И НЕ СтруктураРедактируемогоСезона.ИспользоватьГод Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	И НЕ (СезонныеПроценты.Номенклатура = &НоменклатураПредыдущая
			|		И СезонныеПроценты.НачалоСезона = &НачалоСезона
			|		И СезонныеПроценты.КонецСезона = &КонецСезона
			|		И СезонныеПроценты.Процент = &Процент)";
			
			Запрос.УстановитьПараметр("НоменклатураПредыдущая", СтруктураРедактируемогоСезона.Номенклатура);
			Запрос.УстановитьПараметр("НачалоСезона", СтруктураРедактируемогоСезона.НачалоСезона);
			Запрос.УстановитьПараметр("КонецСезона", СтруктураРедактируемогоСезона.КонецСезона);
			Запрос.УстановитьПараметр("Процент", СтруктураРедактируемогоСезона.Процент);
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Номенклатура", ТекущийОбъект.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			// Сформируем представление в формате "ММДД", т.е. сначала месяц потом день.
			НачалоПроверяемогоИнтервала = Прав(Выборка.НачалоСезона,2) + Лев(Выборка.НачалоСезона,2);
			КонецПроверяемогоИнтервала  = Прав(Выборка.КонецСезона,2)  + Лев(Выборка.КонецСезона,2);
			
			// Проверим интервалы на пересечение
			// Если в интервале начало > конца, значит интервал идет через конец года на следующий год.
			// Этот интервал представляем как два интервала: 
			// с начала года до конца интервала и с начала интервала до конца года.
			
			Пересечение = Ложь;
			Если НачалоУстанавливаемогоИнтервала > КонецУстанавливаемогоИнтервала И НачалоПроверяемогоИнтервала > КонецПроверяемогоИнтервала Тогда
				// Оба интервала включают в себя конец года.
				Пересечение = Истина;
			ИначеЕсли НачалоУстанавливаемогоИнтервала > КонецУстанавливаемогоИнтервала ИЛИ НачалоПроверяемогоИнтервала > КонецПроверяемогоИнтервала Тогда
				// Один из двух интервалов идет через конец года.
				Если НачалоУстанавливаемогоИнтервала <= КонецПроверяемогоИнтервала ИЛИ НачалоПроверяемогоИнтервала <= КонецУстанавливаемогоИнтервала Тогда
					Пересечение = Истина;
				КонецЕсли;
			Иначе
				// Оба интервала в пределах одного года.
				Если НачалоУстанавливаемогоИнтервала <= КонецПроверяемогоИнтервала И НачалоПроверяемогоИнтервала <= КонецУстанавливаемогоИнтервала Тогда
					Пересечение = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если Пересечение Тогда
				Отказ = Истина;
				
				СтрокаИнтервала = ТаблицаПересекающихсяИнтервалов.Добавить();
				СтрокаИнтервала.НачалоСезона = Выборка.НачалоСезона;
				СтрокаИнтервала.КонецСезона = Выборка.КонецСезона;
				СтрокаИнтервала.ИспользоватьГод = Ложь;
				СтрокаИнтервала.Процент = Выборка.Процент;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Отказ Тогда
		ПредставлениеСезона = "Сезон " + ПолучитьПредставлениеСезона(ТекущийОбъект.ИспользоватьГод,ТекущийОбъект.НачалоСезона,ТекущийОбъект.КонецСезона);
		ПредставлениеСезона = ПредставлениеСезона + ", с процентом: " + ТекущийОбъект.Процент + ". Пересекается с" + ?(ТаблицаПересекающихсяИнтервалов.Количество()>1," сезонами", " сезоном") + ":";
		
		Для Каждого ТекущийСезон Из ТаблицаПересекающихсяИнтервалов Цикл
			ПредставлениеСезона = ПредставлениеСезона + Символы.ПС;
			ПредставлениеСезона = ПредставлениеСезона + "- "+ПолучитьПредставлениеСезона(ТекущийСезон.ИспользоватьГод,ТекущийСезон.НачалоСезона,ТекущийСезон.КонецСезона)+", с процентом: "+ТекущийСезон.Процент;
		КонецЦикла;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ПредставлениеСезона;
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ГруппаСтраницыСезоныПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если МесяцНачала > МесяцКонца Тогда
		ГодНачала = ГодКонца - 1;
	ИначеЕсли МесяцНачала = МесяцКонца Тогда
		Если ЧислоНачала > ЧислоКонца Тогда
			ГодНачала = ГодКонца - 1;
		Иначе
			ГодНачала = ГодКонца;
		КонецЕсли;
	Иначе
		ГодНачала = ГодКонца;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьГодПриИзменении(Элемент)
	Если Запись.ИспользоватьГод Тогда
		Элементы.ГруппаСтраницыСезоны.ТекущаяСтраница = Элементы.ГруппаГодовойСезон;
	Иначе
		Элементы.ГруппаСтраницыСезоны.ТекущаяСтраница = Элементы.ГруппаЕжегодныйСезон;
	КонецЕсли;
	УстановитьМаксимальноеЗначениеЧисла(0);
КонецПроцедуры

&НаКлиенте
Процедура МесяцНачалаПриИзменении(Элемент)
	УстановитьМаксимальноеЗначениеЧисла(1);
КонецПроцедуры

&НаКлиенте
Процедура МесяцКонцаПриИзменении(Элемент)
	УстановитьМаксимальноеЗначениеЧисла(2);
КонецПроцедуры

&НаКлиенте
Процедура ГодНачалаПриИзменении(Элемент)
	УстановитьМаксимальноеЗначениеЧисла(1);
КонецПроцедуры

&НаКлиенте
Процедура ГодКонцаПриИзменении(Элемент)
	УстановитьМаксимальноеЗначениеЧисла(2);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ ЭЛЕМЕНТОВ УПРАВЛЕНИЯ ФОРМЫ


&НаКлиенте
Процедура УстановитьСезонВесна(Команда)
	ЧислоНачала = 1;
	МесяцНачала = 3;
	ЧислоКонца = 31;
	МесяцКонца = 5;
	УстановитьГодВСезоне();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСезонЗима(Команда)
	ЧислоНачала = 1;
	МесяцНачала = 12;
	ЧислоКонца = 29;
	МесяцКонца = 2;
	УстановитьГодВСезоне("Зима");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСезонЛето(Команда)
	ЧислоНачала = 1;
	МесяцНачала = 6;
	ЧислоКонца = 31;
	МесяцКонца = 8;
	УстановитьГодВСезоне();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСезонОсень(Команда)
	ЧислоНачала = 1;
	МесяцНачала = 9;
	ЧислоКонца = 30;
	МесяцКонца = 11;
	УстановитьГодВСезоне();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
////////////////////////////////////////////////////////////////////////////////
