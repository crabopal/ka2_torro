&НаСервере
// Возвращает соответствие наименований и номеров месяцев.
Функция ПолучитьМесяцы(СклонятьМесяц = Ложь)
	Если СклонятьМесяц Тогда
		СписокМесяцев = Новый СписокЗначений();
		СписокМесяцев.Добавить(1,"Января");
		СписокМесяцев.Добавить(2,"Февраля");
		СписокМесяцев.Добавить(3,"Марта");
		СписокМесяцев.Добавить(4,"Апреля");
		СписокМесяцев.Добавить(5,"Мая");
		СписокМесяцев.Добавить(6,"Июня");
		СписокМесяцев.Добавить(7,"Июля");
		СписокМесяцев.Добавить(8,"Августа");
		СписокМесяцев.Добавить(9,"Сентября");
		СписокМесяцев.Добавить(10,"Октября");
		СписокМесяцев.Добавить(11,"Ноября");
		СписокМесяцев.Добавить(12,"Декабря");
	Иначе
		СписокМесяцев = Новый СписокЗначений();
		СписокМесяцев.Добавить(1,"Январь");
		СписокМесяцев.Добавить(2,"Февраль");
		СписокМесяцев.Добавить(3,"Март");
		СписокМесяцев.Добавить(4,"Апрель");
		СписокМесяцев.Добавить(5,"Май");
		СписокМесяцев.Добавить(6,"Июнь");
		СписокМесяцев.Добавить(7,"Июль");
		СписокМесяцев.Добавить(8,"Август");
		СписокМесяцев.Добавить(9,"Сентябрь");
		СписокМесяцев.Добавить(10,"Октябрь");
		СписокМесяцев.Добавить(11,"Ноябрь");
		СписокМесяцев.Добавить(12,"Декабрь");
	КонецЕсли;
	
	Возврат СписокМесяцев;
КонецФункции


&НаКлиенте
// Процедура по установленным значениям месяцев устанавливает ограничение числа.
Процедура УстановитьМаксимальноеЗначениеЧисла(Режим=0)
	Если Режим=0 ИЛИ Режим=1 Тогда
		// Начало сезона
		МаксимальноеЧисло = СоответствиеДней.Получить(МесяцНачала);
		Элементы.ЧислоНачалаГодовой.МаксимальноеЗначение = МаксимальноеЧисло;
		Если Запись.ИспользоватьГод И МесяцНачала = 2 И ГодНачала/4-Цел(ГодНачала/4) <> 0 Тогда
			// В феврале, не високосного года 28 дней
			Элементы.ЧислоНачалаЕжегодный.МаксимальноеЗначение = 28;
		Иначе
			Элементы.ЧислоНачалаЕжегодный.МаксимальноеЗначение = МаксимальноеЧисло;
		КонецЕсли;
	КонецЕсли;
	Если Режим=0 ИЛИ Режим=2 Тогда
		// Конец сезона
		МаксимальноеЧисло = СоответствиеДней.Получить(МесяцКонца);
		Элементы.ЧислоКонцаГодовой.МаксимальноеЗначение = МаксимальноеЧисло;
		Если Запись.ИспользоватьГод И МесяцКонца = 2 И ГодКонца/4-Цел(ГодКонца/4) <> 0 Тогда
			// В феврале, не високосного года 28 дней
			Элементы.ЧислоКонцаЕжегодный.МаксимальноеЗначение = 28;
			ЧислоКонца = 28;
		Иначе
			Элементы.ЧислоКонцаЕжегодный.МаксимальноеЗначение = МаксимальноеЧисло;
			Если Режим=2 Тогда
				ЧислоКонца = МаксимальноеЧисло;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьПредставлениеСезона(ИспользоватьГод,НачалоСезона,КонецСезона)
	СписокМесяцев = ПолучитьМесяцы(Истина);
	
	ПредставлениеСезона = "с ";
	Если ИспользоватьГод Тогда
		Элемент = СписокМесяцев.НайтиПоЗначению(Месяц(НачалоСезона));
		ПредставлениеСезона = ПредставлениеСезона + День(НачалоСезона) + " " + Элемент.Представление + " " + Формат(Год(НачалоСезона), "ЧГ=") + " г." + " по ";
		
		Элемент = СписокМесяцев.НайтиПоЗначению(Месяц(КонецСезона));
		ПредставлениеСезона = ПредставлениеСезона + День(КонецСезона) + " " + Элемент.Представление + " " + Формат(Год(КонецСезона), "ЧГ=") + " г.";
	Иначе
		// Начало сезона
		Число = Число(Лев(НачалоСезона, 2));
		Элемент = СписокМесяцев.НайтиПоЗначению(Число(Прав(НачалоСезона, 2)));
		Если НЕ Элемент = Неопределено И Не Число = 0 Тогда
			ПредставлениеСезона = ПредставлениеСезона + Строка(Число) + " " + Элемент.Представление;
		КонецЕсли;	
		ПредставлениеСезона = ПредставлениеСезона + " по ";
		
		// Конец сезона
		Число   = Число(Лев(КонецСезона, 2));
		Элемент = СписокМесяцев.НайтиПоЗначению(Число(Прав(КонецСезона, 2)));
		Если НЕ Элемент = Неопределено И Не Число = 0 Тогда
			ПредставлениеСезона = ПредставлениеСезона + Строка(Число)+" "+Элемент.Представление;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПредставлениеСезона;
КонецФункции

&НаКлиенте
Процедура УстановитьГодВСезоне(Сезон = "")
	Если Запись.ИспользоватьГод Тогда
		ТекущийГод = Год(ТекущаяДата());
		Если Сезон = "Зима" Тогда
			ГодНачала = ТекущийГод-1;
		Иначе
			ГодНачала = ТекущийГод;
		КонецЕсли;
		ГодКонца = ТекущийГод;
		Если МесяцКонца = 2 И ТекущийГод/4-Цел(ТекущийГод/4) <> 0 Тогда
			ЧислоКонца = 28;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
