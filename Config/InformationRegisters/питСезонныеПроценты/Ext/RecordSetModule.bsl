#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗаписьНабора Из ЭтотОбъект Цикл
		// Проверим заполнение
		Если Не ЗначениеЗаполнено(ЗаписьНабора.Номенклатура) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не указана номенклатура!";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		Если ЗаписьНабора.Процент = 0 Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не указан процент!";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		Если ЗаписьНабора.ИспользоватьГод Тогда 
			Если ЗаписьНабора.НачалоСезона > ЗаписьНабора.КонецСезона Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Неправильно указан период (начало и конец сезона)!";
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
		Иначе
			// Возможен переход на следующий год, поэтому здесь начало может быть больше конца, например, сезон Зима.
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

