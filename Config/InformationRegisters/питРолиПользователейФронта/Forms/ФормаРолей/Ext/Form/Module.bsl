////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

#Область ПрограммныйИнтерфейс

// Функция ищет карточки пользователя с признаком "Авторизация".
//
// Параметры:
//  Пользователь - Произвольный - Пользователь.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ЕстьКарточкаАвторизации(Пользователь) Экспорт
	
	Если Пользователь.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Карточки.Ссылка,
	|	Карточки.ДанныеКарты
	|ИЗ
	|	Справочник.питКарточки КАК Карточки
	|ГДЕ
	|	Карточки.Пользователь = &Пользователь
	|	И Карточки.Авторизация";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции


//  Процедура - Команда записать завершение.
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура КомандаЗаписатьЗавершение(ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Закрыть();
		ВладелецФормы.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Если Параметры.Свойство("Пользователь") И НЕ Параметры.Пользователь = Неопределено Тогда
	
		Пользователь = Параметры.Пользователь;
		ЭтаФорма.Заголовок = "Роли пользователя <"+Пользователь+"> во фронт-офисе";
	Иначе
		Пользователь = Неопределено;
		ЭтаФорма.Заголовок = "Роли пользователей фронт-офиса";
	КонецЕсли;
	
	Элементы.ДеревоРолей.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	ДеревоРолей.ПолучитьЭлементы().Очистить();
	
	Корень = ДеревоРолей.ПолучитьЭлементы().Добавить();
	Корень.Группировка = "Пользователи";
	Корень.Картинка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Пользователи.питПарольФронтОфиса КАК Пароль,
	|	питРолиПользователейФронта.РольФронта,
	|	питРолиПользователейФронта.Пользователь КАК Пользователь,
	|	0 КАК Изменен
	|ПОМЕСТИТЬ втДанные
	|ИЗ
	|	РегистрСведений.питРолиПользователейФронта КАК питРолиПользователейФронта
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО питРолиПользователейФронта.Пользователь = Пользователи.Ссылка
	|"+?(ЗначениеЗаполнено(Пользователь),"ГДЕ питРолиПользователейФронта.Пользователь = &Пользователь","")+"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанные.Пароль,
	|	втДанные.РольФронта,
	|	втДанные.Пользователь,
	|	втДанные.Изменен
	|ИЗ
	|	втДанные КАК втДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанные.Пароль,
	|	втДанные.РольФронта,
	|	втДанные.Пользователь КАК Пользователь
	|ИЗ
	|	втДанные КАК втДанные
	|
	|УПОРЯДОЧИТЬ ПО
	|	втДанные.Пользователь.Наименование
	|ИТОГИ ПО
	|	Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаРолей.Загрузить(РезультатЗапроса[1].Выгрузить());
	Если НЕ ТаблицаРолей.Количество() И ЗначениеЗаполнено(Пользователь) Тогда
		НовыйПользователь = Корень.ПолучитьЭлементы().Добавить();
		НовыйПользователь.Группировка = Пользователь;
		НовыйПользователь.Картинка = Истина;
	КонецЕсли;
	
	ВыборкаПользователи = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПользователи.Следующий() Цикл
		
		НовыйПользователь = Корень.ПолучитьЭлементы().Добавить();
		НовыйПользователь.Группировка = ВыборкаПользователи.Пользователь;
		НовыйПользователь.Картинка = Истина;
		
		ВыборкаДетально = ВыборкаПользователи.Выбрать();
		Пока ВыборкаДетально.Следующий() Цикл
			
			НовыйПользователь.Пароль = ВыборкаДетально.Пароль;
			НовыйДетальная = НовыйПользователь.ПолучитьЭлементы().Добавить();
			НовыйДетальная.Группировка = ВыборкаДетально.РольФронта;
			НовыйДетальная.Картинка = Ложь;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Пользователи") Тогда
		
		Если Элементы.ДеревоРолей.ТекущиеДанные = Неопределено Тогда
			Родитель = ДеревоРолей.ПолучитьЭлементы()[0];
		Иначе
			Родитель = ДеревоРолей.НайтиПоИдентификатору(Элементы.ДеревоРолей.ТекущиеДанные.ПолучитьИдентификатор());
		КонецЕсли;
		
		Если НЕ Родитель = Неопределено Тогда
			
			Если ЕстьПотомок(Родитель, ВыбранноеЗначение) Тогда
				Возврат;
			КонецЕсли;
			
			НовПользователь = Родитель.ПолучитьЭлементы().Добавить();
			НовПользователь.Картинка = Истина;
			НовПользователь.Группировка = ВыбранноеЗначение;
		КонецЕсли;
		
		Модифицированность = Истина;
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.питРолиПользователейФронта") 
		И НЕ Элементы.ДеревоРолей.ТекущиеДанные = Неопределено Тогда
		
		Родитель = ДеревоРолей.НайтиПоИдентификатору(Элементы.ДеревоРолей.ТекущиеДанные.ПолучитьИдентификатор());
		
		Если НЕ Родитель = Неопределено Тогда
			
			Если ЕстьПотомок(Родитель, ВыбранноеЗначение) Тогда
				Возврат;
			КонецЕсли;
			
			НовПользователь = Родитель.ПолучитьЭлементы().Добавить();
			НовПользователь.Картинка = Ложь;
			НовПользователь.Группировка = ВыбранноеЗначение;
			
			НайдСтроки = ТаблицаРолей.НайтиСтроки(Новый Структура("Пользователь", Родитель.Группировка));
			МассивДляУдаления = Новый Массив;
			Для каждого СтрокаТЗ Из НайдСтроки Цикл
				Если СтрокаТЗ.Изменен = 0 Тогда 
					СтрокаТЗ.Изменен = 1;
				ИначеЕсли СтрокаТЗ.Изменен = 2 Тогда
					МассивДляУдаления.Добавить(СтрокаТЗ);
				КонецЕсли;
			КонецЦикла;
			
			Для каждого ТекУдСтр Из МассивДляУдаления Цикл
				ТаблицаРолей.Удалить(ТекУдСтр);
			КонецЦикла;
			
			НайдСтроки = ТаблицаРолей.НайтиСтроки(Новый Структура("Пользователь, РольФронта", Родитель.Группировка, ВыбранноеЗначение));
			Если НайдСтроки.Количество() Тогда
				СтрокаТЗ = НайдСтроки[0];
			Иначе
				СтрокаТЗ = ТаблицаРолей.Добавить();
			КонецЕсли;
			
			СтрокаТЗ.Пользователь = Родитель.Группировка;
			СтрокаТЗ.РольФронта = ВыбранноеЗначение;
			СтрокаТЗ.Пароль = Родитель.Пароль;
			СтрокаТЗ.Изменен = 1;
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Дерево ролей перед началом изменения.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоРолейПередНачаломИзменения(Элемент, Отказ)
	
	// Изменять можем только поле "Пароль", да и то только в строке, где в качестве группировки - "Пользователь".
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Если Элемент.ТекущийЭлемент = Элементы.ДеревоРолейПароль Тогда
			
			ТекущаяСтрокаДерева = ДеревоРолей.НайтиПоИдентификатору(Элемент.ТекущиеДанные.ПолучитьИдентификатор());
			Если НЕ ТекущаяСтрокаДерева = Неопределено
				И НЕ ТекущаяСтрокаДерева.ПолучитьРодителя() = Неопределено 
				И ТекущаяСтрокаДерева.ПолучитьРодителя().ПолучитьРодителя() = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Отказ = Истина;
	
КонецПроцедуры

//  Процедура - Дерево ролей перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ДеревоРолейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	// Открываем нужную форму выбора, в зависимости от того, из какой строки вызвали "Добавить".
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		
		// По умолчанию открываем форму пользователей.
		ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
		ФормаВыбора = ПолучитьФорму("Справочник.Пользователи.ФормаВыбора",ПараметрыВыбора,ЭтаФорма);
		ФормаВыбора.Открыть();
		
	Иначе
		
		ТекущаяСтрокаДерева = ДеревоРолей.НайтиПоИдентификатору(Элемент.ТекущиеДанные.ПолучитьИдентификатор());
		
		Если НЕ ТекущаяСтрокаДерева = Неопределено Тогда
			Если ТипЗнч(ТекущаяСтрокаДерева.Группировка) = Тип("Строка") 
				И НЕ ЗначениеЗаполнено(Пользователь) Тогда
				
				ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
				ФормаВыбора = ПолучитьФорму("Справочник.Пользователи.ФормаВыбора",ПараметрыВыбора,ЭтаФорма);
				ФормаВыбора.Открыть();
				
			ИначеЕсли ТипЗнч(ТекущаяСтрокаДерева.Группировка) = Тип("СправочникСсылка.Пользователи") Тогда
				
				ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
				ФормаВыбора = ПолучитьФорму("Справочник.питРолиПользователейФронта.ФормаВыбора", ПараметрыВыбора, ЭтаФорма);
				ФормаВыбора.Открыть();
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Отказ = Истина;
	
КонецПроцедуры

//  Процедура - Дерево ролей перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоРолейПередУдалением(Элемент, Отказ)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		ТекущаяСтрокаДерева = ДеревоРолей.НайтиПоИдентификатору(Элемент.ТекущиеДанные.ПолучитьИдентификатор());
		Если НЕ ТекущаяСтрокаДерева = Неопределено Тогда
			Если ТипЗнч(ТекущаяСтрокаДерева.Группировка) = Тип("Строка") Тогда
				// Для группировки с типом строка(что является корнем дерева) ничего не делаем.
				Отказ = Истина;
				Возврат;
			ИначеЕсли ТипЗнч(ТекущаяСтрокаДерева.Группировка) = Тип("СправочникСсылка.Пользователи") 
				И НЕ ЗначениеЗаполнено(Пользователь) Тогда
				// Если удаляем пользователя, то установим статус "2" всем строкам таблицы ролей с этим пользователем.
				НайденныеСтроки = ТаблицаРолей.НайтиСтроки(Новый Структура("Пользователь", ТекущаяСтрокаДерева.Группировка));
				Для каждого ТекСтрока Из НайденныеСтроки Цикл
					ТекСтрока.Изменен = 2;
				КонецЦикла;
			ИначеЕсли ТипЗнч(ТекущаяСтрокаДерева.Группировка) = Тип("СправочникСсылка.питРолиПользователейФронта") Тогда
				// Если удаляем ролль пользователя, то установим статус "2" 
				// для строки таблицы ролей с тек. ролью и пользователем, для которого она установлена.
				НайденныеСтроки = ТаблицаРолей.НайтиСтроки(Новый Структура("Пользователь, РольФронта", ТекущаяСтрокаДерева.ПолучитьРодителя().Группировка, ТекущаяСтрокаДерева.Группировка));
				Для каждого ТекСтрока Из НайденныеСтроки Цикл
					ТекСтрока.Изменен = 2;
				КонецЦикла;
			КонецЕсли;
			
			// взводим флаг модифицировнанности
			Модифицированность = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Дерево ролей при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура ДеревоРолейПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		ТекущаяСтрокаДерева = ДеревоРолей.НайтиПоИдентификатору(Элемент.ТекущиеДанные.ПолучитьИдентификатор());
		Если НЕ ТекущаяСтрокаДерева = Неопределено
			И ТипЗнч(ТекущаяСтрокаДерева.Группировка) = Тип("СправочникСсылка.Пользователи") Тогда
			
			НайдСтроки = ТаблицаРолей.НайтиСтроки(Новый Структура("Пользователь", ТекущаяСтрокаДерева.Группировка));
			Для каждого ТекСтрока Из НайдСтроки Цикл
				ТекСтрока.Пароль = ТекущаяСтрокаДерева.Пароль;
				ТекСтрока.Изменен = 1;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

//  Процедура - Дерево ролей выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоРолейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ ТипЗнч(ТекДанные.Группировка) = Тип("Строка")
		И НЕ Элемент.ТекущийЭлемент = Неопределено 
		И Элемент.ТекущийЭлемент = Элементы.ДеревоРолейГруппировка Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Группировка);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

//  Процедура - Записать.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Записать(Команда)
	
	ТекстОшибки = "";
	Если НЕ ПроверитьКорректность(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если НЕ ЗаписатьНаСервере(ТекстОшибки) Тогда
		
		// Не удалось записать, "плюемся" текстом ошибки.
		ПоказатьПредупреждение(,"ОШИБКА ЗАПИСИ! " + ТекстОшибки);
		
	Иначе
		
		// Записалось успешно, всем строкам таблицы ролей ставим статус 0
		Модифицированность = Ложь;
		Для каждого ТекСтрока Из ТаблицаРолей Цикл
			ТекСтрока.Изменен = 0;
		КонецЦикла;
		
		// Говорим, что все ок.
		ПоказатьПредупреждение(Новый ОписаниеОповещения("КомандаЗаписатьЗавершение", ЭтотОбъект),"Роли пользователей фронта установлены успешно!");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция ищет у переданного элемента значение среди его непосредственных потомков.
//
// Параметры:
//  Родитель - Произвольный - Родитель.
//  ИскомыйПотомок - Произвольный - Искомый потомок.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ЕстьПотомок(Родитель, ИскомыйПотомок)
	
	Для каждого ТекПотомок Из Родитель.ПолучитьЭлементы() Цикл
		Если ТекПотомок.Группировка = ИскомыйПотомок Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Функция проверяет корректность таблицы ролей на наличие пароля либо карточки авторизации
//
// Параметры:
//  ТекстОшибки - Строка - В случае ошибки сюда записывается ее описание.
//
// Возвращаемое значение:
//  Булево - Таблица заполнена корректно или нет?
&НаСервере
Функция ПроверитьКорректность(ТекстОшибки = "")
	
	// Сворачиваем таблицу по пользователям и паролям.
	ТаблицаПользователей = ТаблицаРолей.Выгрузить(,"Пользователь, Пароль");
	ТаблицаПользователей.Свернуть("Пользователь, Пароль");
	Для каждого ТекПользователь Из ТаблицаПользователей Цикл
		
		// Если нет карточки и не заполнен пароль
		Если НЕ ЗначениеЗаполнено(ТекПользователь.Пароль) 
			И НЕ ЕстьКарточкаАвторизации(ТекПользователь.Пользователь) Тогда
			
			ТекстОшибки = "Ошибка записи! У пользователя <"+ТекПользователь.Пользователь+"> нет карточки авторизации и для него не указан пароль фронт-офиса";
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

//  Функция - Записать на сервере.
//
// Параметры:
//  ТекстОшибки - Строка - Текст ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЗаписатьНаСервере(ТекстОшибки = "")
	
	НаборЗап = Неопределено;
	
	// Выбираем данные из таблицы ролей с итогами по пользователям.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Данные.Пользователь,
	|	Данные.Пароль,
	|	Данные.РольФронта,
	|	Данные.Изменен
	|ПОМЕСТИТЬ втДанные
	|ИЗ
	|	&Данные КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанные.Пользователь КАК Пользователь,
	|	втДанные.Пароль КАК Пароль,
	|	втДанные.РольФронта,
	|	втДанные.Изменен КАК Изменен
	|ИЗ
	|	втДанные КАК втДанные
	|ГДЕ
	|	втДанные.Изменен > 0
	|ИТОГИ
	|	МАКСИМУМ(Пароль),
	|	МАКСИМУМ(Изменен)
	|ПО
	|	Пользователь";
	
	Запрос.УстановитьПараметр("Данные", ТаблицаРолей.Выгрузить());
	
	// Пишем все в транзакции.
	НачатьТранзакцию();
	
	ВыборкаОбщая = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Обход выборки по пользователям
	Пока ВыборкаОбщая.Следующий() Цикл
		
		// Получаем спр. объект "Пользователи" по текущему пользователю,
		// пишем ему флаг "Пользователь фронта" и поле "Пароль" и перезаписываем.
		ПользовательОбъект = ВыборкаОбщая.Пользователь.ПолучитьОбъект();
		ПользовательОбъект.питПользовательФронтОфиса = ?(ВыборкаОбщая.Изменен = 1, Истина, Ложь);
		ПользовательОбъект.питПарольФронтОфиса = ВыборкаОбщая.Пароль;
		
		
		НайденнаяСсылка = Справочники.Пользователи.НайтиПоРеквизиту("питПарольФронтОфиса", ВыборкаОбщая.Пароль);
		
		Если (ЗначениеЗаполнено(НайденнаяСсылка)) И (НайденнаяСсылка<>ПользовательОбъект.Ссылка) Тогда
			ТекстОшибки = "Реквизит """+"Пароль фронт-офиса"+""" не уникален !";
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("пит. Состав пользователей фронта",
			УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;
			
		Попытка
			ПользовательОбъект.Записать();
		Исключение
			ОтменитьТранзакцию();
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации("пит. Состав пользователей фронта",
				УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Возврат Ложь;
		КонецПопытки;
		
		// Дальше надо сделать запись в регистре "питРолиПользователейФронта".
		НаборЗап = РегистрыСведений.питРолиПользователейФронта.СоздатьНаборЗаписей();
		НаборЗап.Отбор.Пользователь.Значение = ВыборкаОбщая.Пользователь;
		НаборЗап.Отбор.Пользователь.Использование = Истина;
		
		// Если по данному пользователю уже были записи в регистре, то чистим их.
		НаборЗап.Прочитать();
		НаборЗап.Очистить();
		
		// Детальная выборка(по ролям пользователей), заполняем данные регистра.
		ВыборкаДетальная = ВыборкаОбщая.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			Если ВыборкаДетальная.Изменен = 1 Тогда
				НовСтрока = НаборЗап.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ВыборкаДетальная);
			КонецЕсли;
		КонецЦикла;
		
		// Пробуем писать в базу.
		Попытка
			НаборЗап.Записать(Истина);
		Исключение
			ОтменитьТранзакцию();
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации("пит. Состав пользователей фронта",
			УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Возврат Ложь;
		КонецПопытки;
		
	КонецЦикла;
	
	// Если дошли сюда, то все хорошо, можно фиксировать транзакцию.
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти





