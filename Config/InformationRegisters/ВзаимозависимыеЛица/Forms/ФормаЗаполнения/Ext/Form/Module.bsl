#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
  	Если Параметры.Свойство("АвтоТест") Тогда
   		Возврат;
  	КонецЕсли;
	
	Если Не Параметры.Свойство("Организация", ЗаполняемаяОрганизация) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ГодЗаполнения") Тогда
		ГодЗаполнения = Параметры.ГодЗаполнения;
	Иначе
		ГодЗаполнения = Год(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ЭтаФорма.Заголовок = ЗаголовокФормы(ЗаполняемаяОрганизация, Организация);
	Элементы.Организация.СписокВыбора.ЗагрузитьЗначения(КонтролируемыеСделки.СписокОрганизацийИсключаяУказанную(ЗаполняемаяОрганизация));
	ЗаполнитьТаблицуВзаимозависимыхЛицОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ИзменениеОрганизацииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Отказ = Ложь;
	ОчиститьСообщения();
	ЗаполнитьНаСервере(Отказ);
	
	Если НЕ Отказ Тогда
		
		Оповестить("ВзаимозависимыеЛица_Записан");
		ЗаполнитьТаблицуВзаимозависимыхЛицОрганизации();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	ЗаполнитьОтметки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	ЗаполнитьОтметки(Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере(Отказ)
	
	ПроверитьНаличиеДублейКонтрагентов(Отказ);
	
	Если НЕ Отказ Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("Использование", Истина);
		
		ТаблицаВыбранныхНастроек = ТаблицаВзаимозависимыхЛицОрганизации.Выгрузить(Отбор);
		Отказ = НЕ (ТаблицаВыбранныхНастроек.Количество() > 0);
		Если НЕ Отказ Тогда
			ЗаполнитьДанные(ТаблицаВыбранныхНастроек, ЗаполняемаяОрганизация, ГодЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаличиеДублейКонтрагентов(Отказ)
	
	ТаблицаПроверки = ТаблицаВзаимозависимыхЛицОрганизации.Выгрузить(, "Контрагент, Использование");
	ТаблицаПроверки.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	
	СчетчикСтрок = 0;
	Для Каждого ТекущаяСтрока Из ТаблицаПроверки Цикл
		
		СчетчикСтрок = СчетчикСтрок + 1;
		ТекущаяСтрока.НомерСтроки = СчетчикСтрок;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПроверки", ТаблицаПроверки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПроверки.НомерСтроки КАК НомерСтроки,
	|	ТаблицаПроверки.Использование КАК Использование,
	|	ТаблицаПроверки.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ТаблицаПроверки
	|ИЗ
	|	&ТаблицаПроверки КАК ТаблицаПроверки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ТаблицаПроверки.НомерСтроки) КАК НомерСтроки,
	|	ТаблицаПроверки.Контрагент КАК Контрагент,
	|	КОЛИЧЕСТВО(1) КАК КоличествоДублей
	|ПОМЕСТИТЬ ДублирующиесяСтроки
	|ИЗ
	|	ТаблицаПроверки КАК ТаблицаПроверки
	|ГДЕ
	|	ТаблицаПроверки.Использование
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПроверки.Контрагент
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(1) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПроверки.НомерСтроки КАК НомерСтроки,
	|	ДублирующиесяСтроки.НомерСтроки КАК ПерваяСтрока,
	|	ТаблицаПроверки.Контрагент КАК Контрагент
	|ИЗ
	|	ТаблицаПроверки КАК ТаблицаПроверки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДублирующиесяСтроки КАК ДублирующиесяСтроки
	|		ПО ТаблицаПроверки.НомерСтроки <> ДублирующиесяСтроки.НомерСтроки
	|			И ТаблицаПроверки.Контрагент = ДублирующиесяСтроки.Контрагент
	|			И (ТаблицаПроверки.Использование)"; 
	
	ШаблонСообщения = НСтр("ru = 'В строке %НомерСтроки% по сравнению со строкой %ПерваяСтрока% повторяется значение контрагента.'");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%НомерСтроки%", Выборка.НомерСтроки);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ПерваяСтрока%", Выборка.ПерваяСтрока);
		
		НомерСтроки = Выборка.НомерСтроки; // Число
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
			"ТаблицаВзаимозависимыхЛицОрганизации",
			НомерСтроки,
			"Контрагент");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, Поле,, Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИзменениеОрганизацииНаСервере()
	ЭтаФорма.Заголовок = ЗаголовокФормы(ЗаполняемаяОрганизация, Организация);
	Элементы.ТаблицаВзаимозависимыхЛицОрганизацииОрганизация.Видимость = Не ЗначениеЗаполнено(Организация);
	ЗаполнитьТаблицуВзаимозависимыхЛицОрганизации();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокФормы(ОрганизацияЗаполняемая, ОрганизацияИсточник)
	
	Если ЗначениеЗаполнено(ОрганизацияИсточник) Тогда
		Заголовок = НСтр("ru = 'Заполнение организации ""%ОрганизацияПриемник%"" данными по взаимозависимым лицам организации ""%ОрганизацияИсточник%""'");
		Заголовок = СтрЗаменить(Заголовок, "%ОрганизацияИсточник%", ОрганизацияИсточник);
	Иначе
		Заголовок = НСтр("ru = 'Заполнение организации ""%ОрганизацияПриемник%"" данными по взаимозависимым лицам организаций'");
	КонецЕсли;
	Заголовок = СтрЗаменить(Заголовок, "%ОрганизацияПриемник%", ОрганизацияЗаполняемая);
	
	Возврат Заголовок;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуВзаимозависимыхЛицОрганизации()
	
	МассивКонтрагентов = Новый Массив; // Массив из СправочникСсылка.Контрагенты
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзаимозависимыеЛицаСрезПоследних.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.ВзаимозависимыеЛица.СрезПоследних(, Организация = &ОрганизацияДляОтбора) КАК ВзаимозависимыеЛицаСрезПоследних";
	Запрос.УстановитьПараметр("ОрганизацияДляОтбора", ЗаполняемаяОрганизация);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		МассивКонтрагентов = Результат.Выгрузить().ВыгрузитьКолонку("Контрагент");
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВзаимозависимыеЛицаСрезПоследних.Организация,
	                      |	ВзаимозависимыеЛицаСрезПоследних.Контрагент,
	                      |	ВзаимозависимыеЛицаСрезПоследних.ТипВзаимозависимости,
	                      |	ЛОЖЬ КАК Использование
	                      |ИЗ
	                      |	РегистрСведений.ВзаимозависимыеЛица.СрезПоследних(
	                      |			&Период,
	                      |			ВЫБОР
	                      |				КОГДА &ОрганизацияДляОтбора = Значение(Справочник.Организации.ПустаяСсылка)
	                      |					ТОГДА НЕ Организация = &ИсключающаясяОрганизация
	                      |				ИНАЧЕ Организация = &ОрганизацияДляОтбора
	                      |			КОНЕЦ
	                      |			И НЕ Контрагент В (&МассивКонтрагентов)) КАК ВзаимозависимыеЛицаСрезПоследних");
	Запрос.УстановитьПараметр("ИсключающаясяОрганизация", ЗаполняемаяОрганизация);
	Запрос.УстановитьПараметр("ОрганизацияДляОтбора", Организация);
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	ТаблицаВзаимозависимыхЛицОрганизации.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтметки(ЗначениеОтметки)
	
	ТаблицаЗаполняемыхЗначений = ТаблицаВзаимозависимыхЛицОрганизации.Выгрузить();
	ТаблицаЗаполняемыхЗначений.ЗаполнитьЗначения(ЗначениеОтметки, "Использование");
	ТаблицаВзаимозависимыхЛицОрганизации.Загрузить(ТаблицаЗаполняемыхЗначений);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьДанные(ТаблицаВыбранныхНастроек, Организация, ГодЗаполнения)
	
	МассивКонтрагентов = ТаблицаВыбранныхНастроек.ВыгрузитьКолонку("Контрагент");
	МассивОрганизаций = ТаблицаВыбранныхНастроек.ВыгрузитьКолонку("Организация");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	&ПериодЗаписи КАК Период,
	                      |	ВзаимозависимыеЛицаСрезПоследних.Контрагент,
	                      |	ВзаимозависимыеЛицаСрезПоследних.ТипВзаимозависимости,
	                      |	ВзаимозависимыеЛицаСрезПоследних.Организация КАК Организация
	                      |ИЗ
	                      |	РегистрСведений.ВзаимозависимыеЛица.СрезПоследних(
	                      |			&Период,
	                      |			Организация В (&Организации)
	                      |				И Контрагент В (&Контрагенты)) КАК ВзаимозависимыеЛицаСрезПоследних");
	
	Запрос.УстановитьПараметр("ПериодЗаписи", Дата(ГодЗаполнения, 1, 1));
	Запрос.УстановитьПараметр("Контрагенты", МассивКонтрагентов);
	Запрос.УстановитьПараметр("Организации", МассивОрганизаций);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		НовыйНаборЗаписей = РегистрыСведений.ВзаимозависимыеЛица.СоздатьНаборЗаписей();
		НовыйНаборЗаписей.Отбор.Организация.Установить(Организация);
		НовыйНаборЗаписей.Прочитать();
		
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
		Отбор.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
		ВыполнятьЗапись = Ложь;
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(Отбор, Выборка);
			
			Если ТаблицаВыбранныхНастроек.НайтиСтроки(Отбор).Количество() > 0 Тогда
				
				ВыполнятьЗапись = Истина;
				НоваяЗапись = НовыйНаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
				НоваяЗапись.Организация = Организация;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВыполнятьЗапись Тогда
			НовыйНаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти