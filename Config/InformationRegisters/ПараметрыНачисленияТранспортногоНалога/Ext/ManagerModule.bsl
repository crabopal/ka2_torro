// См. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РегистрыСведений.ПараметрыНачисленияТранспортногоНалога.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.27.49";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("80d1b4e3-e88c-4e5b-9163-8df82e528e12");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыСведений.ПараметрыНачисленияТранспортногоНалога.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Обычный;
	
	Обработчик.Комментарий = НСтр("ru = 'Заполняет справочник оснований льгот по имущественным налогам
										| по данным регистра ""Параметры начисления транспортного налога"" 
										|и заполняет виды транспортных средств и льготы в регистре
										|""Параметры начисления транспортного налога"" и его документах регистраторах.
										|Регистрация транспортных средств, а также выполнение регламентной операции 
										|расчета транспортного налога могут быть ограничены.'");
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.РегистрыСведений.ПараметрыНачисленияТранспортногоНалога.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.РегистрыСведений.ПараметрыНачисленияТранспортногоНалога.ПолноеИмя());
	Изменяемые.Добавить(Метаданные.Документы.ВводПервоначальныхСведенийДляРасчетаТранспортногоНалога.ПолноеИмя());
	Изменяемые.Добавить(Метаданные.Документы.ПараметрыНачисленияТранспортногоНалога.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");
	
КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	
	ПолныеИменаОбъектов  = Новый Массив;
	ПолныеИменаОбъектов.Добавить(Метаданные.Документы.ПараметрыНачисленияТранспортногоНалога.ПолноеИмя());
	ПолныеИменаОбъектов.Добавить(Метаданные.Документы.ВводПервоначальныхСведенийДляРасчетаТранспортногоНалога.ПолноеИмя());
	ПолныеИменаОбъектов.Добавить(Метаданные.Документы.СнятиеСРегистрацииТранспортныхСредств.ПолноеИмя());
	
	ПолныеИменаОбъектовСтрокой = СтрСоединить(ПолныеИменаОбъектов, ",");

	ПараметрыВыборки.ПолныеИменаОбъектов = ПолныеИменаОбъектовСтрокой;
	
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Дата УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Дата УБЫВ");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	
	// Выбререм все регистраторы по записям регистра, где заполнено старое поле Кода вида транспортного средства и 
	// не заполнено новое поле Вида транспортного средства.
	// А также все регистраторы, где указан код льготы по транспортному налогу и не указано основание льготы.
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПараметрыНачисленияТранспортногоНалога.Регистратор КАК Ссылка
	|ИЗ
	|	РегистрСведений.ПараметрыНачисленияТранспортногоНалога КАК ПараметрыНачисленияТранспортногоНалога
	|ГДЕ
	|	(ПараметрыНачисленияТранспортногоНалога.ВидТранспортногоСредства = ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСредств.ПустаяСсылка)
	|				И ПараметрыНачисленияТранспортногоНалога.КодВидаТранспортногоСредстваДо2020 В (&КодыВидовТранспортныхСредствДо2020)
	|
	|			ИЛИ
	|
	|		ПараметрыНачисленияТранспортногоНалога.ОснованиеЛьготы = ЗНАЧЕНИЕ(Справочник.ОснованияЛьготПоИмущественнымНалогам.ПустаяСсылка)
	|				И НЕ ПараметрыНачисленияТранспортногоНалога.НалоговаяЛьготаДо2020 В (ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоТранспортномуНалогуДо2020.ПустаяСсылка), 
	|																						ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоТранспортномуНалогуДо2020.НеПрименяется))
	|
	|			ИЛИ
	|
	|		ПараметрыНачисленияТранспортногоНалога.УдалитьЭкологическийКласс <> """"
	|				И ПараметрыНачисленияТранспортногоНалога.ЭкологическийКласс = """")";

	// Получим соответствие старых кодов видов ТС и новых видов ТС.
	КодыВидовИКатегорииТранспортныхСредств = РасчетИмущественныхНалогов.КодыВидовИКатегорииТранспортныхСредств();
 	СтандартныеКодыВидовТС = КодыВидовИКатегорииТранспортныхСредств.ВыгрузитьКолонку("КодВида");
	Запрос.УстановитьПараметр("КодыВидовТранспортныхСредствДо2020", СтандартныеКодыВидовТС);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Результат.Выгрузить().ВыгрузитьКолонку("Ссылка"));

КонецПроцедуры

// Обработчик обновления
// 
// Параметры:
// 	Параметры - См. ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляМногопоточнойОбработки 
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// В прежней структуре регистра вид транспортного средства определялся через ресурс КодВидаТранспортногоСредства[До2020].
	// Для данных кодов ТС было установлено соответствие с категориями ТС, на основании которых установлены ставки налога.
	// Соответствие хранилось в макете КодыВидовИКатегорииТС[До2020].
	// Теперь используется новая классификация на основе ресурса ВидТранспортногоСредства (перечисление). Для заполнения
	// данного ресурса в прежний макет добавлены ссылки на новое перечисление.
	// 
	// В прежней структуре регистра льгота задавалась ресурсом НалоговаяЛьгота[До2020] (перечисление), а ресурсы
	// КодНалоговойЛьготы[До2020], РегиональныйКодЛьготы[До2020] и ПроцентУменьшения[До2020] уточняли параметры льготы.
	// Теперь эта функция перешла к ОснованиеЛьготы (справочник). Процент уменьшения (суммы налога) - это фиксированный
	// атрибут конкретной льготы (в конкретном пункте местного закона указан процент уменьшения), поэтому показатель в
	// регистре больше не требуется.
	// В обработчике обновления для каждого значения прежнего перечисления ищется/создается льгота с определенным кодом.

	Параметры.ОбработкаЗавершена = Ложь;

	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = (ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Неопределено,
											Метаданные.Документы.ВводПервоначальныхСведенийДляРасчетаТранспортногоНалога.ПолноеИмя())
										И ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Неопределено,
											Метаданные.Документы.ПараметрыНачисленияТранспортногоНалога.ПолноеИмя()));
		Возврат;
	КонецЕсли; 
	
	// Кэшируем в параметрах соответствие старых кодов видов ТС и новых видов ТС.
	Если Параметры.Свойство("СоответствиеКодовВидовИВидовТС") Тогда
		СоответствиеКодовВидовИВидовТС = Параметры.СоответствиеКодовВидовИВидовТС;
	Иначе
		// Получим соответствие старых кодов видов ТС и новых видов ТС.
		КодыВидовИКатегорииТранспортныхСредств = РасчетИмущественныхНалогов.КодыВидовИКатегорииТранспортныхСредств();
		СоответствиеКодовВидовИВидовТС = Новый Соответствие;
		Для Каждого СтрокаМакета Из КодыВидовИКатегорииТранспортныхСредств Цикл
			СоответствиеКодовВидовИВидовТС.Вставить(СтрокаМакета.КодВида, Перечисления.ВидыТранспортныхСредств[СтрокаМакета.Вид]);
		КонецЦикла;
		Параметры.Вставить("СоответствиеКодовВидовИВидовТС", СоответствиеКодовВидовИВидовТС);
	КонецЕсли;

	// Созданные элементы справочника льгот кэшируем в виде таблицы в параметрах
	Если Параметры.Свойство("ЛьготыПоТранспортномуНалогу") Тогда
		ЛьготыПоТранспортномуНалогу = Параметры.ЛьготыПоТранспортномуНалогу;
	Иначе
		ЛьготыПоТранспортномуНалогу = Новый ТаблицаЗначений;
		ЛьготыПоТранспортномуНалогу.Колонки.Добавить("ОснованиеЛьготы", Новый ОписаниеТипов("СправочникСсылка.ОснованияЛьготПоИмущественнымНалогам"));
		ЛьготыПоТранспортномуНалогу.Колонки.Добавить("КодЛьготы", ОбщегоНазначения.ОписаниеТипаСтрока(7));
		ЛьготыПоТранспортномуНалогу.Колонки.Добавить("ВидЛьготы", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЛьготПоИмущественнымНалогам"));
		ЛьготыПоТранспортномуНалогу.Колонки.Добавить("ПроцентУменьшения", ОбщегоНазначения.ОписаниеТипаЧисло(5, 2, ДопустимыйЗнак.Неотрицательный));
		ЛьготыПоТранспортномуНалогу.Колонки.Добавить("КодРегиона", ОбщегоНазначения.ОписаниеТипаЧисло(2, 0, ДопустимыйЗнак.Неотрицательный));
		ЛьготыПоТранспортномуНалогу.Колонки.Добавить("УстановленаМестнымНормативнымАктом", Новый ОписаниеТипов("Булево"));
		ЛьготыПоТранспортномуНалогу.Колонки.Добавить("ОснованиеМестнойЛьготы", ОбщегоНазначения.ОписаниеТипаСтрока(24));
		
		Параметры.Вставить("ЛьготыПоТранспортномуНалогу", ЛьготыПоТранспортномуНалогу);
	КонецЕсли;
	
	// Также кэшируем в параметрах данные, полученные из регистраций в налоговых органах
	Если Параметры.Свойство("КэшКодовРегионов") Тогда
		КэшКодовРегионов = Параметры.КэшКодовРегионов;
	Иначе
		КэшКодовРегионов = Новый ТаблицаЗначений;
		Параметры.Вставить("КэшКодовРегионов", КэшКодовРегионов);
	КонецЕсли;
	
	// Также кэшируем коды оснований региональных льгот
	Если Параметры.Свойство("КэшОснованийРегиональныхЛьгот") Тогда
		КэшОснованийРегиональныхЛьгот = Параметры.КэшОснованийРегиональныхЛьгот;
	Иначе
		КэшОснованийРегиональныхЛьгот = Новый Соответствие;
		Параметры.Вставить("КэшОснованийРегиональныхЛьгот", КэшОснованийРегиональныхЛьгот);
	КонецЕсли;
	
	Для Каждого СтрокаОбновляемыхДанных  Из ОбновляемыеДанные Цикл
		
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ПолноеИмяОбъекта = СтрокаОбновляемыхДанных.Ссылка.Метаданные().ПолноеИмя();
			Блокировка.Добавить(ПолноеИмяОбъекта).УстановитьЗначение("Ссылка", СтрокаОбновляемыхДанных.Ссылка);
			Блокировка.Заблокировать();
			
			Обновляемыйдокумент = СтрокаОбновляемыхДанных.Ссылка.ПолучитьОбъект();
			
			// Заполним в документе вид транспортного средства по коду вида транспортного средства
			// и информацию о льготе.
			Если ТипЗнч(Обновляемыйдокумент) = Тип("ДокументОбъект.ПараметрыНачисленияТранспортногоНалога") Тогда
				// В документах параметров начисления налога параметры налога в шапке, основные средства в табличной части.
				// Один документ по нескольким однотипным основным средствам.
				Обновляемыйдокумент.ВидТранспортногоСредства = СоответствиеКодовВидовИВидовТС.Получить(Обновляемыйдокумент.КодВидаТранспортногоСредстваДо2020);
				Обновляемыйдокумент.ЭкологическийКласс  = Обновляемыйдокумент.УдалитьЭкологическийКласс;
				
				//@skip-check query-in-loop
				КодРегиона = ПолучитьКодРегиона(Обновляемыйдокумент.Организация,
													Обновляемыйдокумент.Дата,
													Обновляемыйдокумент.НачалоДействия,
													Обновляемыйдокумент.ПостановкаНаУчетВНалоговомОргане,
													Обновляемыйдокумент.НалоговыйОрган,
													КэшКодовРегионов);
				
				ЕстьЛьгота = Ложь;
				Если Не ЗначениеЗаполнено(Обновляемыйдокумент.ОснованиеЛьготы)
					И ЗначениеЗаполнено(Обновляемыйдокумент.НалоговаяЛьготаДо2020)
					И Обновляемыйдокумент.НалоговаяЛьготаДо2020 <> Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогуДо2020.НеПрименяется Тогда
					ЕстьЛьгота = Истина;
					ПоискЛьготы = СтруктураПоискаЛьготы(Обновляемыйдокумент, КодРегиона, КэшОснованийРегиональныхЛьгот);
				КонецЕсли;
				
				Если ЕстьЛьгота Тогда
					Обновляемыйдокумент.ОснованиеЛьготы = ЛьготыПоИмущественнымНалогам.НайтиИлиСоздатьЛьготу(
					Перечисления.ВидыИмущественныхНалогов.ТранспортныйНалог,
					ПоискЛьготы,
					ЛьготыПоТранспортномуНалогу);
				КонецЕсли;
				
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(Обновляемыйдокумент);
				
				БлокировкаДанныхРегистра = Новый БлокировкаДанных;
				ЭлементБлокировкиДанных = БлокировкаДанныхРегистра.Добавить("РегистрСведений.ПараметрыНачисленияТранспортногоНалога.НаборЗаписей");
				ЭлементБлокировкиДанных.УстановитьЗначение("Регистратор", Обновляемыйдокумент.Ссылка);
				БлокировкаДанныхРегистра.Заблокировать();
				
				// Обновим данные в регистре сведений Параметры начисления транспортного налога.
				НаборЗаписейДокумента = РегистрыСведений.ПараметрыНачисленияТранспортногоНалога.СоздатьНаборЗаписей();
				НаборЗаписейДокумента.Отбор.Регистратор.Установить(Обновляемыйдокумент.Ссылка);
				НаборЗаписейДокумента.Прочитать();
				
				Для Каждого СтрокаНабораЗаписей Из НаборЗаписейДокумента Цикл
					СтрокаНабораЗаписей.ВидТранспортногоСредства = Обновляемыйдокумент.ВидТранспортногоСредства;
					СтрокаНабораЗаписей.ОснованиеЛьготы = Обновляемыйдокумент.ОснованиеЛьготы;
					СтрокаНабораЗаписей.ЭкологическийКласс  = Обновляемыйдокумент.ЭкологическийКласс;
				КонецЦикла;
				
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписейДокумента);

			ИначеЕсли ТипЗнч(Обновляемыйдокумент) = Тип("ДокументОбъект.ВводПервоначальныхСведенийДляРасчетаТранспортногоНалога") 
						Или ТипЗнч(Обновляемыйдокумент) = Тип("ДокументОбъект.СнятиеСРегистрацииТранспортныхСредств") Тогда
				// 1) В документах ввода первоначальных сведений параметры начисления налога в одной табличной части,
				// а данные о регистрации в налоговом органе в другой. 
				// Количество записей в этих табличных частях может быть различным.
				// Один документ ввода первоначальных сведений по одному ОС.
				// 2) В снятии с регистрации ТС нет параметров начисления налога в реквизитах документа, он есть записи в регистре сведений.
				// Один документ снятия с регистрации может быть по нескольким ОС.
				
				// Сначала обновим регистр сведений.
				БлокировкаДанныхРегистра = Новый БлокировкаДанных;
				ЭлементБлокировкиДанных = БлокировкаДанныхРегистра.Добавить("РегистрСведений.ПараметрыНачисленияТранспортногоНалога.НаборЗаписей");
				ЭлементБлокировкиДанных.УстановитьЗначение("Регистратор", Обновляемыйдокумент.Ссылка);
				БлокировкаДанныхРегистра.Заблокировать();

				НаборЗаписейДокумента = РегистрыСведений.ПараметрыНачисленияТранспортногоНалога.СоздатьНаборЗаписей();
				НаборЗаписейДокумента.Отбор.Регистратор.Установить(Обновляемыйдокумент.Ссылка);
				НаборЗаписейДокумента.Прочитать();
				
				Для Каждого СтрокаНабораЗаписей Из НаборЗаписейДокумента Цикл
					
					СтрокаНабораЗаписей.ВидТранспортногоСредства = СоответствиеКодовВидовИВидовТС.Получить(СтрокаНабораЗаписей.КодВидаТранспортногоСредстваДо2020);
					СтрокаНабораЗаписей.ЭкологическийКласс = СтрокаНабораЗаписей.УдалитьЭкологическийКласс;
					
					//@skip-check query-in-loop
					КодРегиона = ПолучитьКодРегиона(СтрокаНабораЗаписей.Организация,
													СтрокаНабораЗаписей.Период,
													Дата(1, 1, 1),
													СтрокаНабораЗаписей.ПостановкаНаУчетВНалоговомОргане,
													СтрокаНабораЗаписей.НалоговыйОрган,
													КэшКодовРегионов);
					ЕстьЛьгота = Ложь;
					
					Если Не ЗначениеЗаполнено(СтрокаНабораЗаписей.ОснованиеЛьготы)
						И ЗначениеЗаполнено(СтрокаНабораЗаписей.НалоговаяЛьготаДо2020)
						И СтрокаНабораЗаписей.НалоговаяЛьготаДо2020 <> Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогуДо2020.НеПрименяется Тогда
						ЕстьЛьгота = Истина;
						ПоискЛьготы = СтруктураПоискаЛьготы(СтрокаНабораЗаписей, КодРегиона, КэшОснованийРегиональныхЛьгот);
					КонецЕсли;
					
					Если ЕстьЛьгота Тогда
						СтрокаНабораЗаписей.ОснованиеЛьготы = ЛьготыПоИмущественнымНалогам.НайтиИлиСоздатьЛьготу(
																	Перечисления.ВидыИмущественныхНалогов.ТранспортныйНалог,
																	ПоискЛьготы,
																	ЛьготыПоТранспортномуНалогу);
					КонецЕсли;
				КонецЦикла;
				
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписейДокумента);
				
				Если ТипЗнч(Обновляемыйдокумент) = Тип("ДокументОбъект.ВводПервоначальныхСведенийДляРасчетаТранспортногоНалога") Тогда
				
				// Затем по данным регистра сведений обновим табличную часть документа ввода первоначальных сведений.
					Для Каждого СтрокаНабораЗаписей Из НаборЗаписейДокумента Цикл
						ИзменяемыеСтрокиДокумента = Обновляемыйдокумент.ПараметрыНалога.НайтиСтроки(
							Новый Структура("ДатаПараметров", СтрокаНабораЗаписей.Период));

						Если ИзменяемыеСтрокиДокумента.Количество() <> 0 Тогда
							Для Каждого СтрокаДокумента Из ИзменяемыеСтрокиДокумента Цикл
								СтрокаДокумента.ВидТранспортногоСредства = СтрокаНабораЗаписей.ВидТранспортногоСредства;
								СтрокаДокумента.ЭкологическийКласс = СтрокаНабораЗаписей.ЭкологическийКласс;
								СтрокаДокумента.ОснованиеЛьготы = СтрокаНабораЗаписей.ОснованиеЛьготы;
							КонецЦикла;
						КонецЕсли;
					КонецЦикла;

					ОбновлениеИнформационнойБазы.ЗаписатьДанные(Обновляемыйдокумент);
				КонецЕсли;
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), СтрокаОбновляемыхДанных.Ссылка);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена =
			(ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Неопределено,
																	Метаданные.Документы.ВводПервоначальныхСведенийДляРасчетаТранспортногоНалога.ПолноеИмя())
			И
			ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Неопределено,
																	Метаданные.Документы.ПараметрыНачисленияТранспортногоНалога.ПолноеИмя()));

КонецПроцедуры

Функция ПолучитьКодРегиона(Организация, Дата, НачалоДействия, ПостановкаНаУчетВНалоговомОргане, НалоговыйОрган, КэшКодовРегионов)
	Если НачалоДействия <> Дата(1, 1, 1) Тогда
		// Для документов-исправлений.
		ДатаПолученияРегистрации = НачалоДня(НачалоДействия);
	Иначе
		ДатаПолученияРегистрации = НачалоДня(Дата);
	КонецЕсли;
	
	РегистрацияВДругомНалоговомОргане = Ложь;
	
	Если ПостановкаНаУчетВНалоговомОргане = ПредопределенноеЗначение("Перечисление.ПостановкаНаУчетВНалоговомОргане.ВДругомНалоговомОргане")
			И ЗначениеЗаполнено(НалоговыйОрган) Тогда
		 РегистрацияВДругомНалоговомОргане = Истина;
	ИначеЕсли ПостановкаНаУчетВНалоговомОргане = ПредопределенноеЗначение("Перечисление.ПостановкаНаУчетВНалоговомОргане.ВДругомНалоговомОргане")
			И Не ЗначениеЗаполнено(НалоговыйОрган)Тогда
			РегистрацияВДругомНалоговомОргане = Ложь;
	КонецЕсли;
	
	Если КэшКодовРегионов.Колонки.Количество() <> 0 Тогда
		// Сначала ищем в кэше.
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Организация", Организация);
		СтруктураПоиска.Вставить("Дата", ДатаПолученияРегистрации);
		СтруктураПоиска.Вставить("РегистрацияВДругомНалоговомОргане", РегистрацияВДругомНалоговомОргане);
		СтруктураПоиска.Вставить("НалоговыйОрган", НалоговыйОрган);
		
		НайденоВКэше =  КэшКодовРегионов.НайтиСтроки(СтруктураПоиска);
		
		Если НайденоВКэше.Количество() > 0 Тогда
			Для Каждого СтрокаКэша Из НайденоВКэше Цикл
				Возврат СтрокаКэша.КодРегиона;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	// Если в кэше не найдено берем из истории регистрации в ФНС для основной регистрации,
	// и из справочника регистраций в ФНС для явно указанных регистраций в другом налоговом органе.
	// Полученные данные кэшируем.
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Организация КАК Организация,
	|	&ДатаРегистрации КАК Дата,
	|	&РегистрацияВДругомНалоговомОргане КАК РегистрацияВДругомНалоговомОргане,
	|	&НалоговыйОрган КАК НалоговыйОрган,
	|	РегистрацииВНалоговомОрганеСрезПоследних.РегистрацияВНалоговомОргане.КодРегиона КАК КодРегиона
	|ИЗ
	|	РегистрСведений.РегистрацииВНалоговомОргане.СрезПоследних(
	|			&ДатаРегистрации,
	|			Организация = &Организация
	|				И Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК РегистрацииВНалоговомОрганеСрезПоследних
	|ГДЕ
	|	НЕ &РегистрацияВДругомНалоговомОргане
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Организация КАК Организация,
	|	&ДатаРегистрации КАК Дата,
	|	&РегистрацияВДругомНалоговомОргане КАК РегистрацияВДругомНалоговомОргане,
	|	&НалоговыйОрган  КАК НалоговыйОрган,
	|	РегистрацииВНалоговомОргане.КодРегиона  КАК КодРегиона
	|ИЗ
	|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|ГДЕ
	|	РегистрацииВНалоговомОргане.Ссылка = &НалоговыйОрган
	|	И &РегистрацияВДругомНалоговомОргане";
	
	Запрос.УстановитьПараметр("ДатаРегистрации", ДатаПолученияРегистрации);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("РегистрацияВДругомНалоговомОргане", РегистрацияВДругомНалоговомОргане);
	Запрос.УстановитьПараметр("НалоговыйОрган", НалоговыйОрган);
	
	Результат = Запрос.Выполнить();
	Если результат.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если КэшКодовРегионов.Колонки.Количество() = 0 Тогда
			// Первые данные для кэширования.
			КэшКодовРегионов = Результат.Выгрузить();
		Иначе
			// Дополняем существующий кэш.
			НоваяСтрокаКэша = КэшКодовРегионов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаКэша, Выборка);
		КонецЕсли;
		
		Возврат Выборка.КодРегиона;
	КонецЦикла;

КонецФункции

Функция СтруктураПоискаЛьготы(Данные, КодРегиона, КэшОснованийРегиональныхЛьгот)
	
	ПоискЛьготы = Новый Структура;
	РегиональнаяЛьгота = СтрНачинаетсяС(Данные.КодНалоговойЛьготыДо2020, "2");
	ОснованиеМестнойЛьготы = "";
	
	Если РегиональнаяЛьгота Тогда
		ПоискЛьготы.Вставить("КодРегиона", КодРегиона);
		ПоискЛьготы.Вставить("УстановленаМестнымНормативнымАктом", Истина);
		Если ЗначениеЗаполнено(Данные.РегиональныйКодЛьготыДо2020) Тогда
			ОснованиеМестнойЛьготы = КэшОснованийРегиональныхЛьгот.Получить(Данные.РегиональныйКодЛьготыДо2020);
			Если ОснованиеМестнойЛьготы = Неопределено Тогда
				ОснованиеМестнойЛьготы = ЛьготыПоИмущественнымНалогамКлиентСервер.ПолныйКодОснованияЛьготы(
					Данные.РегиональныйКодЛьготыДо2020);
				КэшОснованийРегиональныхЛьгот.Вставить(Данные.РегиональныйКодЛьготыДо2020, ОснованиеМестнойЛьготы);
			КонецЕсли;
			ПоискЛьготы.Вставить("ОснованиеМестнойЛьготы", ОснованиеМестнойЛьготы);
		КонецЕсли;
	КонецЕсли;
	
	Если Данные.НалоговаяЛьготаДо2020 =
		Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогуДо2020.ОсвобождениеОтНалогообложения Тогда
	 			
		Если РегиональнаяЛьгота Тогда
			// В прежних настройках можно было выбрать группу "20200", хотя код должен быть строго "20210"
			ПоискЛьготы.Вставить("КодЛьготы", "20210");
		Иначе
			ПоискЛьготы.Вставить("КодЛьготы", Данные.КодНалоговойЛьготыДо2020);
		КонецЕсли;
		
		ПоискЛьготы.Вставить("ВидЛьготы", Перечисления.ВидыЛьготПоИмущественнымНалогам.Освобождение);

	ИначеЕсли Данные.НалоговаяЛьготаДо2020 =
		Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогуДо2020.СнижениеНалоговойСтавки Тогда
		
		// Это местная льгота в виде снижения ставки. Код 20230.
