
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Обработчик события "ПриЗаписи"
//
Процедура ПриЗаписи(Отказ, Замещение)
	
	Если Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Отбор.КассовыйУзел.Значение) Тогда
		МассивУзловПолучателей = питОбменДаннымиПовтИсп.ПолучитьМассивУзловПоЗаданномуПравилуПередачиМаршрутизации(2);
	Иначе
		МассивУзловПолучателей = питОбменДаннымиПовтИсп.ПолучитьМассивУзловПоЗаданномуПравилуПередачиМаршрутизации(1);
	КонецЕсли;
	
	// Для правильной работы механизма маршрутизации необходимо сохранять уникальность записей в разрезе 
	// Номенклатура/ВидМеню/Зал.
	СохраненноеЗначение = Отбор.МестоПечати.Использование;
	Отбор.МестоПечати.Использование = Ложь;
	Прочитать();
	
	Если Количество() > 1 Тогда
		// Уже есть записи с таким набором Номенклатура/ВидМеню/Зал.
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Записи регистра должны быть уникальны в разрезе Номенклатура/Вид меню/Зал!";
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Отбор.МестоПечати.Использование = СохраненноеЗначение;
	Прочитать();
	
	Для Каждого Запись ИЗ ЭтотОбъект Цикл
		Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
				
			// На всякий случай зарегистрируем доп-но номенклатуру для отправки в этот узел
			питОбменДанными.ДопРегистрацияСправочника(МассивУзловПолучателей, Запись.Номенклатура, Истина);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли

