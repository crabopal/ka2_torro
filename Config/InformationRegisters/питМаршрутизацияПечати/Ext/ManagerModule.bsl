
#Область ПрограммныйИнтерфейс

// Процедура регистрирует/отменяет регистрацию записи регитсра "Маршрутизация печати"
//  в переданный кассовый узел в соответствии с правилом маршрутизации.
//
// Параметры:
//  ПравилоМаршрутизации - Число						 - Принимает следующие значения:
//  						0 - Правила маршрутизации печати задаются только на стороне кассового узла (по обменам не передаются).
//  						1 - Общие правила маршрутизации для всех кассовых узлов (настраиваются только в бэке).
//  						2 - Правила маршрутизации для данного кассового узла.
//  КассовыйУзел		 - ПланОбменаСсылка.питУдаленныеКассы	 - Ссылка на КУ, в который регистрируем.
//
Процедура ЗарегистрироватьМаршрутизациюПечатиПоПравилу(ПравилоМаршрутизации, КассовыйУзел) Экспорт
	
	Если ПравилоМаршрутизации = 0 Тогда
		
		// Правила маршрутизации печати задаются только на стороне кассового узла (по обменам не передаются).
		// Поэтому удаляем всю регистрацию.
		ПланыОбмена.УдалитьРегистрациюИзменений(КассовыйУзел, Метаданные.РегистрыСведений.питМаршрутизацияПечати);
		
	ИначеЕсли ПравилоМаршрутизации = 1 ИЛИ ПравилоМаршрутизации = 2 Тогда
		
		// Если ПравилоМаршрутизации = 1 то это общие правила маршрутизации для всех кассовых узлов (настраиваются только в бэке).
		// Значит регистрируем для отправки в КУ все правила, у которых не установлен кассовый узел.
		// Если ПравилоМаршрутизации = 2 то правила маршрутизации для данного кассового узла.
		// Значит регистрируем для отправки в КУ все правила, у которых установлен кассовый узел и равен текущему.
		
		ТекстЗапроса = "ВЫБРАТЬ
		|	МаршрутизацияПечати.Номенклатура,
		|	МаршрутизацияПечати.ВидМеню,
		|	МаршрутизацияПечати.Зал,
		|	МаршрутизацияПечати.МестоПечати,
		|	МаршрутизацияПечати.КассовыйУзел
		|ИЗ
		|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
		|ГДЕ
		|	МаршрутизацияПечати.КассовыйУзел = "+?(ПравилоМаршрутизации = 1,"ЗНАЧЕНИЕ(ПланОбмена.питУдаленныеКассы.ПустаяСсылка)","&КассовыйУзел")+"";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
		Если ПравилоМаршрутизации = 2 Тогда
			Запрос.УстановитьПараметр("КассовыйУзел", КассовыйУзел);
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				НаборЗаписей = РегистрыСведений.питМаршрутизацияПечати.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.КассовыйУзел.Установить(Выборка.КассовыйУзел, Истина);
				НаборЗаписей.Отбор.Номенклатура.Установить(Выборка.Номенклатура, Истина);
				НаборЗаписей.Отбор.ВидМеню.Установить(Выборка.ВидМеню, Истина);
				НаборЗаписей.Отбор.Зал.Установить(Выборка.Зал, Истина);
				НаборЗаписей.Отбор.МестоПечати.Установить(Выборка.МестоПечати, Истина);
				// Зарегистрируем изменения.
				ПланыОбмена.ЗарегистрироватьИзменения(КассовыйУзел, НаборЗаписей);
				НаборЗаписей = Неопределено;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		Возврат; // Неподдерживаемое правило маршрутизации.
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

