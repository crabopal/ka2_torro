#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Запрос = Новый Запрос();
	Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таблица.ДатаОстатков КАК ДатаОстатков,
	|	Таблица.ПоказательБюджетов КАК ПоказательБюджетов,
	|	Таблица.Сценарий КАК Сценарий,
	|	Таблица.Организация КАК Организация,
	|	Таблица.Подразделение КАК Подразделение,
	|	&ТекстТаблицаНабораАналитики,
	|	Таблица.Валюта КАК Валюта
	|ПОМЕСТИТЬ ТаблицаНабора
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков КАК ДатаОстатков,
	|	НачальныеОстаткиРасчетныхПоказателей.Регистратор КАК Регистратор,
	|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов КАК ПоказательБюджетов,
	|	НачальныеОстаткиРасчетныхПоказателей.Сценарий КАК Сценарий,
	|	НачальныеОстаткиРасчетныхПоказателей.Организация КАК Организация,
	|	НачальныеОстаткиРасчетныхПоказателей.Подразделение КАК Подразделение,
	|	&ТекстТаблицаРегистраАналитики,
	|	НачальныеОстаткиРасчетныхПоказателей.Валюта КАК Валюта
	|ПОМЕСТИТЬ ТаблицаРегистра
	|ИЗ
	|	РегистрСведений.НачальныеОстаткиРасчетныхПоказателей КАК НачальныеОстаткиРасчетныхПоказателей
	|ГДЕ
	|	НачальныеОстаткиРасчетныхПоказателей.Регистратор <> &Регистратор
	|	И (НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков,
	|		НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов,
	|		НачальныеОстаткиРасчетныхПоказателей.Сценарий,
	|		НачальныеОстаткиРасчетныхПоказателей.Организация,
	|		НачальныеОстаткиРасчетныхПоказателей.Подразделение,
	|		&ТекстТаблицаРегистраУсловияАналитики,
	|		НачальныеОстаткиРасчетныхПоказателей.Валюта) В
	|		(ВЫБРАТЬ
	|			ТаблицаНабора.ДатаОстатков,
	|			ТаблицаНабора.ПоказательБюджетов,
	|			ТаблицаНабора.Сценарий,
	|			ТаблицаНабора.Организация,
	|			ТаблицаНабора.Подразделение,
	|			&ТекстТаблицаРегистраПодзапросАналитики,
	|			ТаблицаНабора.Валюта
	|		ИЗ
	|			ТаблицаНабора)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков КАК ДатаОстатков,
	|	НачальныеОстаткиРасчетныхПоказателей.Регистратор КАК Регистратор,
	|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов КАК ПоказательБюджетов,
	|	ПРЕДСТАВЛЕНИЕ(НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов) КАК ПоказательБюджетовПредставление,
	|	ПРЕДСТАВЛЕНИЕ(НачальныеОстаткиРасчетныхПоказателей.Регистратор) КАК РегистраторПредставление
	|ИЗ
	|	ТаблицаРегистра КАК НачальныеОстаткиРасчетныхПоказателей";
	
	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	ТекстТаблицаНабораАналитики = "";
	ТекстТаблицаРегистраАналитики = "";
	ТекстТаблицаРегистраУсловияАналитики = "";
	ТекстТаблицаРегистраПодзапросАналитики = "";
	Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
		ТекстТаблицаНабораАналитики = ТекстТаблицаНабораАналитики + ?(ТекстТаблицаНабораАналитики = "", "", ","
			+ Символы.ПС + Символы.Таб) + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Таблица.Аналитика%1 КАК Аналитика%1", НомерАналитики);
		
		ТекстТаблицаРегистраАналитики = ТекстТаблицаРегистраАналитики + ?(ТекстТаблицаРегистраАналитики = "", "", ","
			+ Символы.ПС + Символы.Таб) + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"НачальныеОстаткиРасчетныхПоказателей.Аналитика%1 КАК Аналитика%1", НомерАналитики);
		
		ТекстТаблицаРегистраУсловияАналитики = ТекстТаблицаРегистраУсловияАналитики + ?(
			ТекстТаблицаРегистраУсловияАналитики = "", "", "," + Символы.ПС + Символы.Таб)
			+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("НачальныеОстаткиРасчетныхПоказателей.Аналитика%1",
			НомерАналитики);
		
		ТекстТаблицаРегистраПодзапросАналитики = ТекстТаблицаРегистраПодзапросАналитики + ?(
			ТекстТаблицаРегистраПодзапросАналитики = "", "", "," + Символы.ПС + Символы.Таб)
			+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ТаблицаНабора.Аналитика%1", НомерАналитики);
	КонецЦикла;
	Текст = СтрЗаменить(Текст, "&ТекстТаблицаНабораАналитики", ТекстТаблицаНабораАналитики);
	Текст = СтрЗаменить(Текст, "&ТекстТаблицаРегистраАналитики", ТекстТаблицаРегистраАналитики);
	Текст = СтрЗаменить(Текст, "&ТекстТаблицаРегистраУсловияАналитики", ТекстТаблицаРегистраУсловияАналитики);
	Текст = СтрЗаменить(Текст, "&ТекстТаблицаРегистраПодзапросАналитики", ТекстТаблицаРегистраПодзапросАналитики);
	
	Запрос.Текст = Текст;
	
	Запрос.УстановитьПараметр("Таблица", Выгрузить());
	Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
	ТаблицаДублей = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДублей.Индексы.Добавить("ПоказательБюджетов");
	ТаблицаДублей.Индексы.Добавить("ПоказательБюджетов, Регистратор");
	
	МассивРасчетныхПоказателей = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивРасчетныхПоказателей, ТаблицаДублей.ВыгрузитьКолонку(
		"ПоказательБюджетов"), Истина);
	Ошибки = Неопределено;
	Для Каждого РасчетныйПоказатель Из МассивРасчетныхПоказателей Цикл
		ПредставлениеРасчетногоПоказателя = ТаблицаДублей.Найти(РасчетныйПоказатель,
			"ПоказательБюджетов").ПоказательБюджетовПредставление;
		ТекстСообщения = НСтр("ru = 'Для расчетного показателя ""%1"" на даты %2 значения уже установлены документом ""%3""'");
		
		МассивРегистраторов = Новый Массив;
		РегистраторыПоПоказателю = ТаблицаДублей.Скопировать(Новый Структура("ПоказательБюджетов", РасчетныйПоказатель));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивРегистраторов, РегистраторыПоПоказателю.ВыгрузитьКолонку(
			"Регистратор"), Истина);
		
		Для Каждого Регистратор Из МассивРегистраторов Цикл
			
			МассивДат = Новый Массив;
			ДатыПоПоказателю = ТаблицаДублей.Скопировать(Новый Структура("ПоказательБюджетов, Регистратор",
				РасчетныйПоказатель, Регистратор));
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивДат, ДатыПоПоказателю.ВыгрузитьКолонку("ДатаОстатков"),
				Истина);
			МассивСвертки = Новый Массив;
			Для Каждого Значение Из МассивДат Цикл
				МассивСвертки.Добавить(Формат(Значение, "ДЛФ=D"));
			КонецЦикла;
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				ПредставлениеРасчетногоПоказателя, СтрСоединить(МассивСвертки, ", "),
				ДатыПоПоказателю[0].РегистраторПредставление);
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, Неопределено, ТекстСообщения, "");
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли