
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// Параметры:
//  Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	( Сценарий = Значение(Справочник.Сценарии.ПустаяСсылка)
	|	ИЛИ ЗначениеРазрешено(Сценарий)
	|	) И ( Организация = Значение(Справочник.Организации.ПустаяСсылка)
	|	ИЛИ ЗначениеРазрешено(Организация)
	|	) И ( Подразделение = Значение(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|	ИЛИ ЗначениеРазрешено(Подразделение)
	|	) И ЗначениеРазрешено(ПоказательБюджетов)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ТекстыЗапросовАктуальныеДатыОстатковПоСценариям(УстановленОтбор, УстановленОтборКомпоновкиДанных, ОстаткиНаКонкретнуюДату) Экспорт
	
	ТекстыЗапросов = Новый Массив;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сценарии.Ссылка КАК Сценарий
	|ПОМЕСТИТЬ Сценарии
	|{ВЫБРАТЬ
	|	Сценарий.*}
	|ИЗ
	|	Справочник.Сценарии КАК Сценарии
	|ГДЕ
	|	Сценарии.Ссылка <> ЗНАЧЕНИЕ(Справочник.Сценарии.ФактическиеДанные)
	|	И НЕ Сценарии.ЭтоГруппа
	|	И &УсловиеСценарий";
	ТекстУсловия = "";
	Если УстановленОтбор Тогда
		ТекстУсловия = "Сценарии.Ссылка = &Сценарий"; // @query-part
	КонецЕсли;
	Если УстановленОтборКомпоновкиДанных Тогда
		ТекстУсловия = ?(ТекстУсловия = "", "ИСТИНА", ТекстУсловия + Символы.ПС + Символы.Таб) + 
		"{ГДЕ
		|	Сценарии.Ссылка.* КАК Сценарий}"; // @query-part
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстУсловия) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСценарий", ТекстУсловия);
	КонецЕсли;
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	Если ОстаткиНаКонкретнуюДату Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов КАК ПоказательБюджетов,
		|	НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков КАК ДатаОстатков
		|ПОМЕСТИТЬ АктуальныеДатыОстатков
		|ИЗ
		|	РегистрСведений.НачальныеОстаткиРасчетныхПоказателей КАК НачальныеОстаткиРасчетныхПоказателей
		|ГДЕ
		|	НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков = &НачальнаяДатаОстатков
		|	И &УсловиеПоказательБюджетов
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДатаОстатков,
		|	ПоказательБюджетов";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов КАК ПоказательБюджетов,
		|	МАКСИМУМ(НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков) КАК ДатаОстатков
		|ПОМЕСТИТЬ АктуальныеДатыОстатков
		|ИЗ
		|	РегистрСведений.НачальныеОстаткиРасчетныхПоказателей КАК НачальныеОстаткиРасчетныхПоказателей
		|ГДЕ
		|	НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков МЕЖДУ &НачальнаяДатаОстатков И &КонечнаяДатаОстатков
		|	И &УсловиеПоказательБюджетов
		|
		|СГРУППИРОВАТЬ ПО
		|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДатаОстатков,
		|	ПоказательБюджетов";
	КонецЕсли;
	ТекстУсловия = "";
	Если УстановленОтбор Тогда
		ТекстУсловия = "НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов = &ПоказательБюджетов"; // @query-part
	КонецЕсли;
	Если УстановленОтборКомпоновкиДанных Тогда
		ТекстУсловия = ?(ТекстУсловия = "", "ИСТИНА", ТекстУсловия + Символы.ПС + Символы.Таб) + 
		"{ГДЕ
		|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов.* КАК ПоказательБюджетов}"; // @query-part
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстУсловия) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоказательБюджетов", ТекстУсловия);
	КонецЕсли;
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов КАК ПоказательБюджетов,
	|	НачальныеОстаткиРасчетныхПоказателей.Сценарий КАК Сценарий,
	|	НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков КАК ДатаОстатков
	|ПОМЕСТИТЬ АктуальныеДатыОстатковПоСценариям
	|ИЗ
	|	РегистрСведений.НачальныеОстаткиРасчетныхПоказателей КАК НачальныеОстаткиРасчетныхПоказателей
	|ГДЕ
	|	&УсловиеПоДатеОстатков
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				АктуальныеДатыОстатков
	|			ГДЕ
	|				АктуальныеДатыОстатков.ДатаОстатков = НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков
	|				И АктуальныеДатыОстатков.ПоказательБюджетов = НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов)
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				Сценарии
	|			ГДЕ
	|				НачальныеОстаткиРасчетныхПоказателей.Сценарий = Сценарии.Сценарий)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаОстатков,
	|	ПоказательБюджетов,
	|	Сценарий";
	Если ОстаткиНаКонкретнуюДату Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДатеОстатков", "НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков = &НачальнаяДатаОстатков");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДатеОстатков", "ИСТИНА");
	КонецЕсли;
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	Возврат ТекстыЗапросов;
	
КонецФункции

Процедура СформироватьВременныеТаблицы_АктуальныеНачальныеОстаткиРасчетныхПоказателей(МенеджерВременныхТаблиц, Параметры) Экспорт
	
	ТекстыЗапросов = ТекстыЗапросовАктуальныеДатыОстатковПоСценариям(Параметры.УстановленОтбор,
		Параметры.УстановленОтборКомпоновкиДанных, Параметры.ОстаткиНаКонкретнуюДату);
	
	МассивПодзапросов = Новый Массив;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов КАК ПоказательБюджетов,
	|	НачальныеОстаткиРасчетныхПоказателей.Сценарий КАК Сценарий,
	|	&ТекстПоляОрганизация,
	|	&ТекстПоляПодразделение,
	|	&ТекстПолейАналитик,
	|	НачальныеОстаткиРасчетныхПоказателей.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА НачальныеОстаткиРасчетныхПоказателей.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.Валюта
	|		ИНАЧЕ &ВалютаУпр
	|	КОНЕЦ КАК ВалютаХранения,
	|	НачальныеОстаткиРасчетныхПоказателей.Количество КАК Количество,
	|	НачальныеОстаткиРасчетныхПоказателей.СуммаВВалюте КАК СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА НачальныеОстаткиРасчетныхПоказателей.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.СуммаВВалюте
	|		ИНАЧЕ НачальныеОстаткиРасчетныхПоказателей.СуммаУпр
	|	КОНЕЦ КАК СуммаВВалютеХранения,
	|	НачальныеОстаткиРасчетныхПоказателей.СуммаУпр КАК СуммаУпр,
	|	НачальныеОстаткиРасчетныхПоказателей.СуммаРегл КАК СуммаРегл,
	|	ВЫБОР
	|		КОГДА &ФункциональнаяВалюта = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаВФункциональнойВалюте.ВВалютеРегл)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.СуммаРегл
	|		КОГДА &ФункциональнаяВалюта = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаВФункциональнойВалюте.ВВалютеУпр)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.СуммаУпр
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаВФункциональнойВалюте,
	|	0 КАК Сумма,
	|	&ПериодКурса КАК ПериодКурса
	|ПОМЕСТИТЬ ОстаткиПоРасчетнымПоказателям
	|ИЗ
	|	РегистрСведений.НачальныеОстаткиРасчетныхПоказателей КАК НачальныеОстаткиРасчетныхПоказателей
	|ГДЕ
	|	&УсловиеПоДатеОстатков
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				АктуальныеДатыОстатковПоСценариям
	|			ГДЕ
	|				НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков = АктуальныеДатыОстатковПоСценариям.ДатаОстатков
	|				И НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов = АктуальныеДатыОстатковПоСценариям.ПоказательБюджетов
	|				И НачальныеОстаткиРасчетныхПоказателей.Сценарий = АктуальныеДатыОстатковПоСценариям.Сценарий)";
	МассивПодзапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов,
	|	Сценарии.Сценарий,
	|	&ТекстПоляОрганизация,
	|	&ТекстПоляПодразделение,
	|	&ТекстПолейАналитик,
	|	НачальныеОстаткиРасчетныхПоказателей.Валюта,
	|	ВЫБОР
	|		КОГДА НачальныеОстаткиРасчетныхПоказателей.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.Валюта
	|		ИНАЧЕ &ВалютаУпр
	|	КОНЕЦ,
	|	НачальныеОстаткиРасчетныхПоказателей.Количество,
	|	НачальныеОстаткиРасчетныхПоказателей.СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА НачальныеОстаткиРасчетныхПоказателей.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.СуммаВВалюте
	|		ИНАЧЕ НачальныеОстаткиРасчетныхПоказателей.СуммаУпр
	|	КОНЕЦ,
	|	НачальныеОстаткиРасчетныхПоказателей.СуммаУпр,
	|	НачальныеОстаткиРасчетныхПоказателей.СуммаРегл,
	|	ВЫБОР
	|		КОГДА &ФункциональнаяВалюта = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаВФункциональнойВалюте.ВВалютеРегл)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.СуммаРегл
	|		КОГДА &ФункциональнаяВалюта = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаВФункциональнойВалюте.ВВалютеУпр)
	|			ТОГДА НачальныеОстаткиРасчетныхПоказателей.СуммаУпр
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	0,
	|	&ПериодКурса
	|ИЗ
	|	РегистрСведений.НачальныеОстаткиРасчетныхПоказателей КАК НачальныеОстаткиРасчетныхПоказателей
	|		ЛЕВОЕ СОЕДИНЕНИЕ Сценарии КАК Сценарии
	|		ПО (Сценарии.Сценарий <> ЗНАЧЕНИЕ(Справочник.Сценарии.ИсполнениеБюджета))
	|ГДЕ
	|	&УсловиеПоДатеОстатков
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				АктуальныеДатыОстатков
	|			ГДЕ
	|				НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков = АктуальныеДатыОстатков.ДатаОстатков
	|				И НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов = АктуальныеДатыОстатков.ПоказательБюджетов)
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					АктуальныеДатыОстатковПоСценариям
	|				ГДЕ
	|					НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков = АктуальныеДатыОстатковПоСценариям.ДатаОстатков
	|					И НачальныеОстаткиРасчетныхПоказателей.ПоказательБюджетов = АктуальныеДатыОстатковПоСценариям.ПоказательБюджетов
	|					И АктуальныеДатыОстатковПоСценариям.Сценарий = Сценарии.Сценарий)
	|	И НачальныеОстаткиРасчетныхПоказателей.Сценарий = ЗНАЧЕНИЕ(Справочник.Сценарии.ПустаяСсылка)";
	МассивПодзапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = СтрСоединить(МассивПодзапросов, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());
	Если Параметры.ПоОрганизациям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПоляОрганизация",
			"НачальныеОстаткиРасчетныхПоказателей.Организация КАК Организация");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПоляОрганизация,", "");
	КонецЕсли;
	
	Если Параметры.ПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПоляПодразделение",
			"НачальныеОстаткиРасчетныхПоказателей.Подразделение КАК Подразделение");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПоляПодразделение,", "");
	КонецЕсли;
	Если Параметры.ОстаткиНаКонкретнуюДату Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДатеОстатков", "НачальныеОстаткиРасчетныхПоказателей.ДатаОстатков = &НачальнаяДатаОстатков");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДатеОстатков", "ИСТИНА");
	КонецЕсли;
	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	МассивПолейАналитик = Новый Массив;
	Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
		МассивПолейАналитик.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"НачальныеОстаткиРасчетныхПоказателей.Аналитика%1 КАК Аналитика%1", НомерАналитики));
	КонецЦикла;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПолейАналитик", СтрСоединить(МассивПолейАналитик, "," + Символы.ПС
		+ Символы.Таб));
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Если Параметры.УстановленОтбор Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
	Иначе
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ОстаткиПоРасчетнымПоказателям", ""); //@query-part
		СхемаКомпоновкиДанных = КомпоновкаДанныхСервер.СхемаКомпоновкиДанныхПоТекстуЗапроса(ТекстЗапроса);
	
		Настройки = Новый НастройкиКомпоновкиДанных;
		КомпоновкаДанныхКлиентСервер.ДобавитьГруппировку(Настройки);
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "ПоказательБюджетов");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "Сценарий");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "Организация");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "Подразделение");
		Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
			КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Аналитика%1", НомерАналитики));
		КонецЦикла;
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "Валюта");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "ВалютаХранения");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "Количество");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "СуммаВВалюте");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "СуммаВВалютеХранения");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "СуммаВФункциональнойВалюте");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "СуммаУпр");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "СуммаРегл");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "Сумма");
		КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(Настройки, "ПериодКурса");
		КомпоновкаДанныхКлиентСервер.СкопироватьОтборКомпоновкиДанных(СхемаКомпоновкиДанных, Настройки,
			Параметры.НастройкиОтчета);
		Запрос = КомпоновкаДанныхСервер.ПолучитьЗапросИзМакетаКомпоновки(КомпоновкаДанныхСервер.ПолучитьМакетКомпоновки(
			СхемаКомпоновкиДанных, Настройки), СхемаКомпоновкиДанных.НаборыДанных[0].Имя);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПериодКурса КАК ПериодКурса", "&ПериодКурса КАК ПериодКурса" + Символы.ПС
			+ "ПОМЕСТИТЬ ОстаткиПоРасчетнымПоказателям"); //@query-part
		
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ПериодКурса", Параметры.ДатаОстатков);
	Если Параметры.ОстаткиНаКонкретнуюДату Тогда
		Запрос.УстановитьПараметр("НачальнаяДатаОстатков", Параметры.ДатаОстатков);
	Иначе
		Запрос.УстановитьПараметр("НачальнаяДатаОстатков", НачалоГода(Параметры.ДатаОстатков-1));
		Запрос.УстановитьПараметр("КонечнаяДатаОстатков", НачалоДня(Параметры.ДатаОстатков-1));
	КонецЕсли;
	Запрос.УстановитьПараметр("ПоОрганизациям", Параметры.ПоОрганизациям);
	Запрос.УстановитьПараметр("ПоПодразделениям", Параметры.ПоПодразделениям);
	Если Параметры.УстановленОтбор Тогда
		ЭлементОтбора = ФинансоваяОтчетностьСервер.НайтиЭлементОтбора(Параметры.НастройкиОтчета.Отбор, "ПоказательБюджетов");
		Запрос.УстановитьПараметр("ПоказательБюджетов", ЭлементОтбора.ПравоеЗначение);
		ЭлементОтбора = ФинансоваяОтчетностьСервер.НайтиЭлементОтбора(Параметры.НастройкиОтчета.Отбор, "Сценарий");
		Запрос.УстановитьПараметр("Сценарий", ЭлементОтбора.ПравоеЗначение);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВалютаУпр", ЗначениеНастроекПовтИсп.ВалютаУправленческогоУчета());
	Запрос.УстановитьПараметр("ФункциональнаяВалюта", Параметры.ФункциональнаяВалюта);
	
	Запрос.Выполнить();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
