//  Функция - Это целевой документ.
//
// Параметры:
//  ДокументПриемник - Произвольный - Документ приемник.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ЭтоЦелевойДокумент(ДокументПриемник) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетДанныхПродаж.КассовыйУзел КАК КассовыйУзел
	|ИЗ
	|	РегистрСведений.питУчетДанныхПродаж КАК УчетДанныхПродаж
	|ГДЕ
	|	УчетДанныхПродаж.ДокументПриемник = &ДокументПриемник";
	Запрос.УстановитьПараметр("ДокументПриемник", ДокументПриемник);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Результат = НЕ РезультатЗапроса.Пустой();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

