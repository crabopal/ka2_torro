#Область ОбработчикиСобытийФормы

// Обработчик события формы "ПриСоданииНаСервере"
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ОбновитьДеревоВидовПланов();
	
	
КонецПроцедуры

// Обработчик события формы "ПриОткрытии"
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РазвернутьВсе(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ВидыПлановРеквизитыОбщепитаПриИзменении(Элемент)
	ТекДанные = Элементы.ВидыПланов.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		УстановитьВидПланаПоИдентификаторуСтроки(Элементы.ВидыПланов.ТекущаяСтрока, ТекДанные.РеквизитыОбщепита); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидыПлановПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВидыПлановПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

// Функция отмечает группы в дереве, если все элементы внутри группы отмечены, 
//  то отмечена и вся группа, иначе не отмечаем.
//
// Параметры:
//  ЭлементыДерева	 - Текущая коллекция элементов дерева
// 
// Возвращаемое значение:
//  Булево - Отметили или не отметили все переданные элементы.
//
&НаСервере
Функция ДеревоВидовПлановОтметитьГруппы(ЭлементыДерева)
	
	Отметить = Истина;
	
	Для каждого ТекЭлементДерева Из ЭлементыДерева Цикл
		Если ТекЭлементДерева.ЭтоГруппа Тогда
			Отметить = ДеревоВидовПлановОтметитьГруппы(ТекЭлементДерева.ПолучитьЭлементы());
			ТекЭлементДерева.РеквизитыОбщепита = Отметить;
		ИначеЕсли НЕ ТекЭлементДерева.РеквизитыОбщепита Тогда
			Отметить = Ложь;
			Возврат Отметить;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Отметить;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДерево(Команда)
	ОбновитьДеревоВидовПланов();
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВыбранных(Команда)
	УстановитьВидПланаПоИдентификаторуСтроки(Элементы.ВидыПланов.ВыделенныеСтроки, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыбранные(Команда)
	УстановитьВидПланаПоИдентификаторуСтроки(Элементы.ВидыПланов.ВыделенныеСтроки, Истина);
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	Для каждого ТекСтрокаДерева Из ВидыПланов.ПолучитьЭлементы() Цикл
		Элементы.ВидыПланов.Развернуть(ТекСтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	Для каждого ТекСтрокаДерева Из ВидыПланов.ПолучитьЭлементы() Цикл
		Элементы.ВидыПланов.Свернуть(ТекСтрокаДерева.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура обновляет дерево видом плана данными из регистра.
//
&НаСервере
Процедура ОбновитьДеревоВидовПланов()
	
	Перем Дерево, Запрос, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыПланов.Ссылка КАК ВидПлана,
	|	ВидыПланов.ЭтоГруппа КАК ЭтоГруппа,
	|	ВидыПланов.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА питВидыПлановОбщепит.ВидПлана ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК РеквизитыОбщепита,
	|	ВЫБОР
	|		КОГДА ВидыПланов.ЭтоГруппа
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Картинка,
	|	"""" КАК ПустаяКолонка
	|ИЗ
	|	Справочник.ВидыПланов КАК ВидыПланов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питВидыПлановОбщепит КАК питВидыПлановОбщепит
	|		ПО (питВидыПлановОбщепит.ВидПлана = ВидыПланов.Ссылка)
	|ГДЕ
	|	ВидыПланов.ТипПлана = &ТипПлана
	|	И НЕ ВидыПланов.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыПланов.ЭтоГруппа ИЕРАРХИЯ,
	|	ВидыПланов.Наименование";
	Запрос.УстановитьПараметр("ТипПлана", Перечисления.ТипыПланов.ПланПроизводства);
	
	РезультатЗапроса = Запрос.Выполнить();
	Дерево = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(Дерево, "ВидыПланов");
	
	ДеревоВидовПлановОтметитьГруппы(ВидыПланов.ПолучитьЭлементы());
	
КонецПроцедуры

// Процедура устанавливает вид номенкалуты как общепитный или наоборот по переданному идентификатору строки дерева.
//  Если передан массив, то отмечает все элементы в цикле.
//
// Параметры:
//  ИдентификаторТекСтроки	 - Число, Массив - Идентификатор строки дерева.
//  Отметить				 - Булево - Отметить или снять отметку.
//
&НаСервере
Процедура УстановитьВидПланаПоИдентификаторуСтроки(Знач ИдентификаторТекСтроки, Отметить)
	Если ТипЗнч(ИдентификаторТекСтроки) = Тип("Массив") Тогда
		Для каждого ТекИД Из ИдентификаторТекСтроки Цикл
			ТекСтрокаДерево = ВидыПланов.НайтиПоИдентификатору(ТекИД);
			УстановитьВидПланаОбщепит(ТекСтрокаДерево, Отметить);
		КонецЦикла;
	Иначе
		ТекСтрокаДерево = ВидыПланов.НайтиПоИдентификатору(ИдентификаторТекСтроки);
		УстановитьВидПланаОбщепит(ТекСтрокаДерево, Отметить);
	КонецЕсли;
КонецПроцедуры

// Рекурсивная процедура установки вида плана общепит, также обновляет данные регистра.
//
// Параметры:
//  ТекСтрокаДерево	 - Текущая строка дерева.
//  Отметить		 - Булево - Отметить или снять отметку.
//
&НаСервере
Процедура УстановитьВидПланаОбщепит(ТекСтрокаДерево, Отметить)
	
	// Отметка текущего элемента.
	ТекСтрокаДерево.РеквизитыОбщепита = Отметить;
	Если ТекСтрокаДерево.ЭтоГруппа Тогда
		
		// Для групп делаем рекурсивный вызов для каждого из потомков.
		Для каждого ТекЭлементГруппы Из ТекСтрокаДерево.ПолучитьЭлементы() Цикл
			УстановитьВидПланаОбщепит(ТекЭлементГруппы, Отметить);
		КонецЦикла;
		
	Иначе
		
		// Обновление регистра.
		МенеджерЗаписи = РегистрыСведений.питВидыПлановОбщепит.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВидПлана = ТекСтрокаДерево.ВидПлана;
		Попытка
			Если Отметить Тогда
				МенеджерЗаписи.Записать();
			Иначе
				МенеджерЗаписи.Удалить();
			КонецЕсли;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось установить вид плана общепит <"+ТекСтрокаДерево.Наименование+"> по причине:
			|	" + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


