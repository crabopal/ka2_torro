
#Область ПрограммныйИнтерфейс

// Функция проверяет, является ли переданный вид плана видом плана общепита
//  (по регистру "питВидыПлановОбщепит").
//
// Параметры:
//  ВидПлана - СправочникСсылка.ВидыПланов - Вид плана на проверку.
// 
// Возвращаемое значение:
//  Булево - Результат работы функции.
//
Функция ЭтоВидПланаОбщепит(ВидПлана) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питВидыПлановОбщепит.ВидПлана КАК ВидПлана
	|ИЗ
	|	РегистрСведений.питВидыПлановОбщепит КАК питВидыПлановОбщепит
	|ГДЕ
	|	питВидыПлановОбщепит.ВидПлана = &ВидПлана";
	Запрос.УстановитьПараметр("ВидПлана", ВидПлана);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

// Функция возвращает все виды планов общепит.
// 
// Возвращаемое значение:
//  Массив - Виды планов общепит.
//
Функция ВсеВидыПлановОбщепит() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питВидыПлановОбщепит.ВидПлана КАК ВидПлана
		|ИЗ
		|	РегистрСведений.питВидыПлановОбщепит КАК питВидыПлановОбщепит";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидПлана");
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

#КонецОбласти
