
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ДатаРецептур") Тогда
		ДатаРецептур = Параметры.ДатаРецептур;
	Иначе
		ДатаРецептур = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Параметры.Свойство("ПодразделениеРецептур") Тогда
		ПодразделениеРецептур = Параметры.ПодразделениеРецептур;
	Иначе
		ПодразделениеРецептур = Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)
	
	 ПараметрыЗакрытия = Новый Структура("ДатаРецептур, ПодразделениеРецептур", 
	                                      ДатаРецептур, ПодразделениеРецептур);
	
	 Закрыть(ПараметрыЗакрытия)                                                    
	
КонецПроцедуры // Применить()  

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	Закрыть();
	
КонецПроцедуры // ЗакрытьФорму()   

#КонецОбласти
