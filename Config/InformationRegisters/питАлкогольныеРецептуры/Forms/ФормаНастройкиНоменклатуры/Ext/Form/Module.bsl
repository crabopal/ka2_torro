&НаКлиенте
Процедура ОбработатьВыборМаркированногоАналога(НовоеЗначениеГруппы)
	
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
	
	ПредыдущаяГруппаАналогов = ГруппаАналогов;
	
	ГруппаАналогов = НовоеЗначениеГруппы;
	ТекДанные.ГруппаАналогов = НовоеЗначениеГруппы;
	
	ЗаполнитьСоставМаркированныхНаборов(ТекДанные.КлючСвязи, ПредыдущаяГруппаАналогов);
	ОтобразитьМаркированныеАналоги();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСоставГруппАналогов()
	
	НовыйСоставГруппАналогов = Новый ТаблицаЗначений;
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.питМаркированныеАналоги"));
	МассивТипов.Добавить(Тип("Число"));
	
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(НовыйСоставГруппАналогов,
		"ГруппаАналогов", МассивТипов);
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(НовыйСоставГруппАналогов,
		"Номенклатура", Тип("СправочникСсылка.Номенклатура"));
	
	СчетчикНовыйГрупп = 1;
	КлючиАналогов = Новый Соответствие;
	Для Каждого ТекСтрока Из АналогиИнгредиентов Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекГруппа = ТекСтрока.ГруппаАналогов;
		Если НЕ ЗначениеЗаполнено(ТекГруппа) Тогда
			ТекГруппа = КлючиАналогов[ТекСтрока.КлючСвязиАналога];
			Если ТекГруппа = Неопределено Тогда
				ТекГруппа = СчетчикНовыйГрупп;
				СчетчикНовыйГрупп = СчетчикНовыйГрупп + 1;
				КлючиАналогов[ТекСтрока.КлючСвязиАналога] = ТекГруппа;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока = НовыйСоставГруппАналогов.Добавить();
		НоваяСтрока.ГруппаАналогов = ТекГруппа;
		НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
		
	КонецЦикла;
	
	ГруппыАналогов = Новый Массив;
	Для Каждого ТекСтрока Из СвязанныеИнгредиенты Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Ингредиент) Тогда
			Продолжить;
		КонецЕсли;
		
		ГруппыАналогов.Добавить(ТекСтрока.ГруппаАналогов);
		
	КонецЦикла;
	
	НовыйСоставГруппАналогов.Свернуть("ГруппаАналогов, Номенклатура");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НовыйСостав.ГруппаАналогов КАК ГруппаАналогов,
	|	НовыйСостав.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_НовыйСостав
	|ИЗ
	|	&НовыйСостав КАК НовыйСостав
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МаркированныеАналогиСостав.Ссылка КАК ГруппаАналогов,
	|	МаркированныеАналогиСостав.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_СохраненныйСостав
	|ИЗ
	|	Справочник.питМаркированныеАналоги.Состав КАК МаркированныеАналогиСостав
	|ГДЕ
	|	МаркированныеАналогиСостав.Ссылка В(&ГруппыАналогов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СохраненныйСостав.ГруппаАналогов КАК ГруппаАналогов
	|ПОМЕСТИТЬ ИзмененныеГруппы
	|ИЗ
	|	ВТ_СохраненныйСостав КАК ВТ_СохраненныйСостав
	|ГДЕ
	|	НЕ (ВТ_СохраненныйСостав.ГруппаАналогов, ВТ_СохраненныйСостав.Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТ_НовыйСостав.ГруппаАналогов КАК ГруппаАналогов,
	|					ВТ_НовыйСостав.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТ_НовыйСостав КАК ВТ_НовыйСостав)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СохраненныйСостав.ГруппаАналогов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_НовыйСостав.ГруппаАналогов
	|ИЗ
	|	ВТ_НовыйСостав КАК ВТ_НовыйСостав
	|ГДЕ
	|	НЕ (ВТ_НовыйСостав.ГруппаАналогов, ВТ_НовыйСостав.Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТ_СохраненныйСостав.ГруппаАналогов КАК ГруппаАналогов,
	|					ВТ_СохраненныйСостав.Номенклатура КАК Номенклатура
	|				ИЗ
	|					ВТ_СохраненныйСостав КАК ВТ_СохраненныйСостав)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_НовыйСостав.ГруппаАналогов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзмененныеГруппы.ГруппаАналогов КАК ГруппаАналогов
	|ИЗ
	|	ИзмененныеГруппы КАК ИзмененныеГруппы
	|
	|СГРУППИРОВАТЬ ПО
	|	ИзмененныеГруппы.ГруппаАналогов";
	Запрос.УстановитьПараметр("НовыйСостав", НовыйСоставГруппАналогов);
	Запрос.УстановитьПараметр("ГруппыАналогов", ГруппыАналогов);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ГруппаАналогов");
	СозданныеГруппыПоКлючам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		СтруктураПоиска.ГруппаАналогов = Выборка.ГруппаАналогов;
		МассивСостава = НовыйСоставГруппАналогов.НайтиСтроки(СтруктураПоиска);
		
		Если ТипЗнч(Выборка.ГруппаАналогов) = Тип("СправочникСсылка.питМаркированныеАналоги") Тогда
			СпрОбъект = Выборка.ГруппаАналогов.ПолучитьОбъект();
		Иначе
			СпрОбъект = Справочники.питМаркированныеАналоги.СоздатьЭлемент();
		КонецЕсли;
		
		СпрОбъект.Состав.Очистить();
		Для Каждого ТекСтрока Из МассивСостава Цикл
			НоваяСтрока = СпрОбъект.Состав.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		
		СпрОбъект.ПометкаУдаления = НЕ ЗначениеЗаполнено(СпрОбъект.Состав);
		
		СпрОбъект.Записать();
		
		Если ТипЗнч(Выборка.ГруппаАналогов) = Тип("СправочникСсылка.питМаркированныеАналоги") Тогда
			Продолжить;
		КонецЕсли;
		
		СозданныеГруппыПоКлючам[Выборка.ГруппаАналогов] = СпрОбъект.Ссылка;
		
	КонецЦикла;
	
	Для Каждого ТекСтрока Из СвязанныеИнгредиенты Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ГруппаАналогов) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекГруппа = КлючиАналогов[ТекСтрока.КлючСвязи];
		Если ТекГруппа = Неопределено Тогда
			// Значит нет замен у ингредиента.
			Продолжить;
		КонецЕсли;
		
		ТекСтрока.ГруппаАналогов = СозданныеГруппыПоКлючам[ТекГруппа];
	КонецЦикла;
	
	Для Каждого ТекСтрока Из АналогиИнгредиентов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ГруппаАналогов) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекГруппа = КлючиАналогов[ТекСтрока.КлючСвязиАналога];
		Если ТекГруппа = Неопределено Тогда
			// Значит нет замен у ингредиента.
			Продолжить;
		КонецЕсли;
		
		ТекСтрока.ГруппаАналогов = СозданныеГруппыПоКлючам[ТекГруппа];
		ТекСтрока.КлючСвязиАналога = 0;
	КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииИнгредиента()
	
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
	
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если ТекДанные = Неопределено Тогда
		СброситьМаркированныеАналоги(ЭтотОбъект, ГруппаАналогов, ТекущийКлючСвязи);
		ГруппаАналогов = Неопределено;
		ОтобразитьМаркированныеАналоги();
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.Ингредиент = ТекущийИнгредиент Тогда
		УправлениеДоступностьюАналогов();
		Возврат;
	КонецЕсли;
	
	Если НЕ ИнгредиентДоступенДляВыбора(ТекДанные.Ингредиент) Тогда
		ТекДанные.Ингредиент = Неопределено;
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru='Ингредиент не доступен для выбора. Доступные виды продукции: %1'"),
			НРег(ДоступныеВидыПродукцииСтрокой)));
		Возврат;
	КонецЕсли;
	
	ТекущийИнгредиент = ТекДанные.Ингредиент;
	
	СброситьМаркированныеАналоги(ЭтотОбъект, ТекДанные.ГруппаАналогов, ТекДанные.КлючСвязи);
	
	ТекДанные.ГруппаАналогов = Неопределено;
	ГруппаАналогов = Неопределено;
	ОтобразитьМаркированныеАналоги();

КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьМаркированныеАналоги()
	
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если ТекДанные = Неопределено Тогда
		ТекущийИнгредиент = Неопределено;
		ТекущийКлючСвязи = Неопределено;
		ГруппаАналогов = Неопределено;
		УправлениеДоступностьюАналогов();
		Возврат;
	КонецЕсли;
	
	ТекущийИнгредиент = ТекДанные.Ингредиент;
	ТекущийКлючСвязи = ТекДанные.КлючСвязи;
	ГруппаАналогов = ТекДанные.ГруппаАналогов;
	
	КлючСвязи = ТекДанные.КлючСвязи;
	
	СтруктураПоиска = Новый Структура;
	Если ЗначениеЗаполнено(ТекДанные.ГруппаАналогов) Тогда
		СтруктураПоиска.Вставить("ГруппаАналогов", ГруппаАналогов);
	Иначе
		СтруктураПоиска.Вставить("КлючСвязиАналога", КлючСвязи);
	КонецЕсли;
	
	Элементы.АналогиИнгредиента.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПоиска);
	УправлениеДоступностьюАналогов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоставМаркированныхНаборов(КлючСвязи = Неопределено, ПредыдущаяГруппаАналогов = Неопределено)
	
	Если ЗначениеЗаполнено(КлючСвязи) Тогда
		СброситьМаркированныеАналоги(ЭтотОбъект, ПредыдущаяГруппаАналогов, КлючСвязи);
	Иначе
		АналогиИнгредиентов.Очистить();
	КонецЕсли;
	
	МассивОсновныхСтрок = СвязанныеИнгредиенты;
	Если ЗначениеЗаполнено(КлючСвязи) Тогда
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("КлючСвязи", КлючСвязи);
		МассивОсновныхСтрок = СвязанныеИнгредиенты.НайтиСтроки(СтруктураПоиска);
	КонецЕсли;
	
	МассивАналоговыхГрупп = Новый Массив;
	Для Каждого ТекСтрока Из МассивОсновныхСтрок Цикл
		МассивАналоговыхГрупп.Добавить(ТекСтрока.ГруппаАналогов);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	МаркированныеАналоги.Ссылка КАК ГруппаАналогов,
	|	МаркированныеАналоги.Номенклатура КАК Номенклатура
	|ИЗ
	|	Справочник.питМаркированныеАналоги.Состав КАК МаркированныеАналоги
	|ГДЕ
	|	МаркированныеАналоги.Ссылка В(&МассивАналоговыхГрупп)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаАналогов,
	|	МаркированныеАналоги.НомерСтроки";
	Запрос.УстановитьПараметр("МассивАналоговыхГрупп", МассивАналоговыхГрупп);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = АналогиИнгредиентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если СвязанныеИнгредиенты.Количество() = 1 Тогда
			НоваяСтрока.КлючСвязиАналога = СвязанныеИнгредиенты[0].КлючСвязи;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СброситьМаркированныеАналоги(Форма, ГруппаАналогов, КлючСвязи, УдалятьСтроки = Истина)
	
	СвязанныеИнгредиенты = Форма.СвязанныеИнгредиенты;
	АналогиИнгредиентов = Форма.АналогиИнгредиентов;
	
	СтруктураПоиска = Новый Структура;
	Если НЕ ЗначениеЗаполнено(ГруппаАналогов) Тогда
		СтруктураПоиска.Вставить("КлючСвязиАналога", КлючСвязи);
		МассивСтрокАналогов = АналогиИнгредиентов.НайтиСтроки(СтруктураПоиска);
		УдалитьСтрокиИзТаблицы(АналогиИнгредиентов, МассивСтрокАналогов);
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска.Вставить("ГруппаАналогов", ГруппаАналогов);
	МассивСтрокИнгредиентов = СвязанныеИнгредиенты.НайтиСтроки(СтруктураПоиска);
	МассивСтрокАналогов = АналогиИнгредиентов.НайтиСтроки(СтруктураПоиска);

	Если МассивСтрокИнгредиентов.Количество() > 1 Тогда
		ВременныеАналоги = Новый Массив;
		Для Каждого ТекСтрока Из МассивСтрокАналогов Цикл
			НоваяСтрока = АналогиИнгредиентов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.ГруппаАналогов = Неопределено;
			НоваяСтрока.КлючСвязиАналога = КлючСвязи;
			ВременныеАналоги.Добавить(НоваяСтрока)
		КонецЦикла;
	ИначеЕсли Не УдалятьСтроки Тогда
		Для Каждого ТекСтрока Из МассивСтрокАналогов Цикл
			ТекСтрока.ГруппаАналогов = Неопределено;
			ТекСтрока.КлючСвязиАналога = КлючСвязи;
		КонецЦикла;
	КонецЕсли;
	
	Если УдалятьСтроки Тогда
		УдалитьСтрокиИзТаблицы(АналогиИнгредиентов, МассивСтрокАналогов);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ДанныеТекущейСтрокиИнгредиентов()
	Результат = ?(ПродаетсяВРозлив, СвязанныеИнгредиенты[0], Элементы.СвязанныеИнгредиенты.ТекущиеДанные);
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКлючСвязиИнгредиентов(Форма, НоваяСтрока = Неопределено)
	
	Если НЕ НоваяСтрока = Неопределено Тогда
		НоваяСтрока.КлючСвязи = НоваяСтрока.ПолучитьИдентификатор() + 1;
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Форма.СвязанныеИнгредиенты Цикл
		ТекСтрока.КлючСвязи = ТекСтрока.ПолучитьИдентификатор() + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеДоступностьюАналогов()
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	ГруппаВыбрана = НЕ ТекДанные = Неопределено 
		И ЗначениеЗаполнено(ТекДанные.ГруппаАналогов);
	Элементы.ГруппаАналоги.Доступность = НЕ ТекДанные = Неопределено И ЗначениеЗаполнено(ТекДанные.Ингредиент);
	Элементы.АналогиИнгредиентаЗаменитьГруппу.Заголовок = ?(ГруппаВыбрана, НСтр("ru='Заменить'"), НСтр("ru='Выбрать'"));
	Элементы.АналогиИнгредиентаИзменитьГруппу.Видимость = ГруппаВыбрана;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоступныеВидыПродукции()
	
	ДоступныеВидыПродукции = питИнтеграцияИСМП.ВидыПродукцииДоступныеДляОтраженияОстатковИС();
	ДоступныеВидыПродукцииСтрокой = СтрСоединить(ДоступныеВидыПродукции, ", ");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнгредиентДоступенДляВыбора(Номенклатура)
	
	РеквизитыНоменклатуры = питИнтеграцияИСМП.СвойстваМаркированнойПродукции(Номенклатура);
	Результат = питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииДоступныйДляОтраженияОстатковИС(
		РеквизитыНоменклатуры.КлючВидаПродукцииИС);
	Возврат Результат;
	
КонецФункции



&НаСервере
Процедура ЗаполнитьПоЗаменамНаСервере(ТекСтрока)
	
ТекДанныеОсн = СвязанныеИнгредиенты[ТекСтрока];
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питЗаменыИнгредиентовСрезПоследних.Заменитель КАК Заменитель
		|ИЗ
		|	РегистрСведений.питЗаменыИнгредиентов.СрезПоследних(&Период, Заменяемое = &Заменяемое) КАК питЗаменыИнгредиентовСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	питЗаменыИнгредиентовСрезПоследних.Заменитель";
	
	Запрос.УстановитьПараметр("Заменяемое", ТекДанныеОсн.Ингредиент);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	СтрукПоиска = новый Структура;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтрукПоиска.Вставить("Номенклатура", ВыборкаДетальныеЗаписи.Заменитель);
		Если АналогиИнгредиентов.НайтиСтроки(СтрукПоиска).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекДанные = АналогиИнгредиентов.Добавить();
		
		ТекДанные.Номенклатура = ВыборкаДетальныеЗаписи.Заменитель;
		ТекДанные.ГруппаАналогов = ТекДанныеОсн.ГруппаАналогов;
		ТекДанные.КлючСвязиАналога = ?(ЗначениеЗаполнено(ТекДанныеОсн.ГруппаАналогов), 0, ТекДанныеОсн.КлючСвязи);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЗаменам(Команда)
	
	ТекущаяСтрока = Элементы.СвязанныеИнгредиенты.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоЗаменамНаСервере(ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти
