
#Область ПрограммныйИнтерфейс

// Процедура - ПослеВыбораПараметровРецептуры.
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры.
//
&НаКлиенте
Процедура ПослеВыбораПараметровРецептуры(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт

	Если РезультатОткрытияФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РезультатОткрытияФормы.ПодразделениеРецептур) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоРецептуреНаСервере(РезультатОткрытияФормы.ДатаРецептур,
		РезультатОткрытияФормы.ПодразделениеРецептур);
	
	
	
КонецПроцедуры

// Процедура - ПослеВыбораГруппыАналогов.
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры.
//
&НаКлиенте
Процедура ПослеВыбораГруппыАналогов(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	ОбработатьВыборМаркированногоАналога(РезультатОткрытияФормы);
КонецПроцедуры

// Процедура - Удалить строки из таблицы.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - Таблица данных.
//  МассивУдаляемыхСтрок - Массив - Массив удаляемых строк.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УдалитьСтрокиИзТаблицы(ТаблицаДанных, МассивУдаляемыхСтрок) Экспорт
	Для Каждого ТекСтрока Из МассивУдаляемыхСтрок Цикл
		ТаблицаДанных.Удалить(ТекСтрока);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти



#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура = Параметры.Номенклатура;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПредставлениеНоменклатуры = Номенклатура;
	Если Параметры.Свойство("Наименование") Тогда
		ПредставлениеНоменклатуры = Параметры.Наименование;
	КонецЕсли;
	
	Заголовок = СтрШаблон(НСтр("ru='Алкогольный состав %1'"), ПредставлениеНоменклатуры);
	
	Если Параметры.Свойство("ПродаетсяВРозлив") Тогда
		ПродаетсяВРозлив = Параметры.ПродаетсяВРозлив;
	КонецЕсли;
	
	Если Параметры.Свойство("ЕдиницаИзмерения") Тогда
		ЕдиницаИзмерения = Параметры.ЕдиницаИзмерения;
	КонецЕсли;
	
	Если Параметры.Свойство("ТолькоПросмотр") Тогда
		ТолькоПросмотр = Параметры.ТолькоПросмотр;
	КонецЕсли;
	
	ЗаполнитьДоступныеВидыПродукции();
	
	ЗаполнитьПоДаннымРегистра();
	УправлениеДоступностью(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОтобразитьМаркированныеАналоги();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		ПроверитьДоступностьЗакрытия();
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область СвязанныеИнгредиенты

&НаКлиенте
Процедура СвязанныеИнгредиентыПриАктивизацииСтроки(Элемент)
	
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если НЕ ТекДанные = Неопределено 
		И НЕ ЗначениеЗаполнено(ТекДанные.КлючСвязи) Тогда
		ЗаполнитьКлючСвязиИнгредиентов(ЭтотОбъект, ТекДанные);
	КонецЕсли;
	
	ОтобразитьМаркированныеАналоги();
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеИнгредиентыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекДанные.КлючСвязи) Тогда
		ЗаполнитьКлючСвязиИнгредиентов(ЭтотОбъект, ТекДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеИнгредиентыИнгредиентПриИзменении(Элемент)
	ПриИзмененииИнгредиента();
КонецПроцедуры

#КонецОбласти

#Область АналогиИгредиента

&НаКлиенте
Процедура АналогиИгредиентаПриИзменении(Элемент)
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура АналогиИгредиентаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанныеОсн = ДанныеТекущейСтрокиИнгредиентов();
	
	Если ТекДанныеОсн = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.АналогиИнгредиента.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ГруппаАналогов = ТекДанныеОсн.ГруппаАналогов;
	ТекДанные.КлючСвязиАналога = ?(ЗначениеЗаполнено(ТекДанныеОсн.ГруппаАналогов), 0, ТекДанныеОсн.КлючСвязи);
	
КонецПроцедуры

&НаКлиенте
Процедура АналогиИгредиентаНоменклатураПриИзменении(Элемент)
	
	ТекДанные = Элементы.АналогиИнгредиента.ТекущиеДанные;
	Если ТекДанные = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("КлючСвязиАналога", ТекДанные.КлючСвязиАналога);
	СтруктураПоиска.Вставить("ГруппаАналогов", ТекДанные.ГруппаАналогов);
	СтруктураПоиска.Вставить("Номенклатура", ТекДанные.Номенклатура);
	
	МассивАналогов = АналогиИнгредиентов.НайтиСтроки(СтруктураПоиска);
	
	Если МассивАналогов.Количество() > 1 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru='Номенклатура %1 уже добавлена в список замен'"), 
			ТекДанные.Номенклатура));
		ТекДанные.Номенклатура = Неопределено;
	КонецЕсли;
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПродаетсяВРозливПриИзменении(Элемент)
	ТекущийИнгредиент = Неопределено;
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
	УправлениеДоступностью(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура КоличествоБлюдаПриИзменении(Элемент)
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ИнгредиентПриИзменении(Элемент)
	ПриИзмененииИнгредиента();
КонецПроцедуры

&НаКлиенте
Процедура КоличествоИнгредиентаПриИзменении(Элемент)
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеИнгредиентыПриИзменении(Элемент)
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#Область ОбработчикиСобытийЭлементов


&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Результат = СохранитьДанныеВРегистр();
	Если НЕ Результат Тогда
		ОтобразитьМаркированныеАналоги();
		ТекстСообщения = НСтр("ru='Ошибка сохранения записей. Подробнее в журнале регистрации'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ВыходныеПараметры = Новый Структура;
	ВыходныеПараметры.Вставить("ПродаетсяВРозлив", ПродаетсяВРозлив);
	ВыходныеПараметры.Вставить("Модифицированность", Истина);
	
	Модифицированность = Ложь;
	Закрыть(ВыходныеПараметры);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ИзменитьГруппу(Команда)
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекДанные.ГруппаАналогов) Тогда
		Возврат;
	КонецЕсли;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ПослеИзмененияГруппыАналогов", ЭтотОбъект);
	
	ВходныеПараметры = Новый Структура;
	ВходныеПараметры.Вставить("Ключ", ТекДанные.ГруппаАналогов);
	
	ОткрытьФорму("Справочник.питМаркированныеАналоги.Форма.ФормаЭлемента", ВходныеПараметры, 
		ЭтотОбъект,,,, 
		ОбработчикОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПрограммныйИнтерфейс

// Процедура - ПослеИзмененияГруппыАналогов.
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры.
//
&НаКлиенте
Асинх Процедура ПослеИзмененияГруппыАналогов(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	
	УправлениеДоступностьюАналогов();
	
	ТекстВопроса = НСтр("ru='Обновить состав замен?'");
	ОтветПользователя = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если НЕ ОтветПользователя = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОбработатьВыборМаркированногоАналога(ГруппаАналогов);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Асинх Процедура ЗаполнитьПоРецептуре(Команда)
	
	Если ЗначениеЗаполнено(СвязанныеИнгредиенты) Тогда
		
		ТекстВопроса = НСтр("ru='Алкогольный состав заполнен и будет сброшен. Продолжить?'");
		ОтветПользователя = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если НЕ ОтветПользователя = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		СвязанныеИнгредиенты.Очистить();
		АналогиИнгредиентов.Очистить();
		
	КонецЕсли;
	
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ПослеВыбораПараметровРецептуры", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.питАлкогольныеРецептуры.Форма.ФормаПодбораРецептурыПоПараметрам",, ЭтотОбъект,,,, ОбработчикОповещения,
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаменитьГруппу(Команда)
	
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
	
	Если ЗначениеЗаполнено(ТекДанные.ГруппаАналогов) Тогда
		
		ТекстВопроса = НСтр("ru='Указанный набор замен будет сброшен. Продолжить?'");
		ОтветПользователя = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если НЕ ОтветПользователя = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		СброситьМаркированныеАналоги(ЭтотОбъект, ТекДанные.ГруппаАналогов, ТекДанные.КлючСвязи);
		ТекДанные.ГруппаАналогов = Неопределено;
		ОтобразитьМаркированныеАналоги();
	КонецЕсли;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ПослеВыбораГруппыАналогов", ЭтотОбъект);
	ОткрытьФорму("Справочник.питМаркированныеАналоги.ФормаВыбора",, Элементы.СвязанныеИнгредиенты,,,,ОбработчикОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СброситьГруппу(Команда)
	
	ТекДанные = ДанныеТекущейСтрокиИнгредиентов();
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьИзменениеЭлемента(ЭтотОбъект);
	
	Если ЗначениеЗаполнено(ТекДанные.ГруппаАналогов) Тогда
		ТекстВопроса = НСтр("ru='Указанный набор замен будет сброшен. Продолжить?'");
	Иначе
		ТекстВопроса = НСтр("ru='Очистить текущий набор замен?'");
	КонецЕсли;
	
	ОтветПользователя = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если НЕ ОтветПользователя = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СброситьМаркированныеАналоги(ЭтотОбъект, 
		ТекДанные.ГруппаАналогов,
		ТекДанные.КлючСвязи,
		НЕ ЗначениеЗаполнено(ТекДанные.ГруппаАналогов));
	
	ТекДанные.ГруппаАналогов = Неопределено;
	ГруппаАналогов = Неопределено;
	ОтобразитьМаркированныеАналоги();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымРегистра()
	
	СвязанныеИнгредиенты.Очистить();
	АналогиИнгредиентов.Очистить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АлкогольныеРецептуры.Ингредиент КАК Ингредиент,
	|	АлкогольныеРецептуры.КоличествоБлюда КАК КоличествоБлюда,
	|	АлкогольныеРецептуры.КоличествоИнгредиента КАК КоличествоИнгредиента,
	|	АлкогольныеРецептуры.ГруппаАналогов КАК ГруппаАналогов
	|ИЗ
	|	РегистрСведений.питАлкогольныеРецептуры КАК АлкогольныеРецептуры
	|ГДЕ
	|	АлкогольныеРецептуры.Блюдо = &Блюдо";
	Запрос.УстановитьПараметр("Блюдо", Номенклатура);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		НоваяСтрока = СвязанныеИнгредиенты.Добавить();
		ЗаполнитьКлючСвязиИнгредиентов(ЭтотОбъект, НоваяСтрока);
		Возврат;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СвязанныеИнгредиенты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если НЕ ЗначениеЗаполнено(КоличествоБлюда) Тогда
			КоличествоБлюда = Выборка.КоличествоБлюда;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьКлючСвязиИнгредиентов(ЭтотОбъект);
	ЗаполнитьСоставМаркированныхНаборов();
	
КонецПроцедуры


&НаСервере
Функция СохранитьДанныеВРегистр()
	
	Результат = Истина;
	
	ОбновитьСоставГруппАналогов();
	
	НовыйНабор = РегистрыСведений.питАлкогольныеРецептуры.СоздатьНаборЗаписей();
	НовыйНабор.Отбор.Блюдо.Установить(Номенклатура);
	
	Для Каждого ТекСтрока Из СвязанныеИнгредиенты Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Ингредиент) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НовыйНабор.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.Блюдо = Номенклатура;
		НоваяСтрока.КоличествоБлюда = КоличествоБлюда;
		
		Если ПродаетсяВРозлив Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеНоменклатуры = питИнтеграцияИСМПКлиентСервер.ИнициализацияОписанияНоменклатурыИС(Номенклатура);
	ОписаниеНоменклатуры.Номенклатура = Номенклатура;
	Если ЗначениеЗаполнено(СвязанныеИнгредиенты) Тогда
		ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке = КоличествоБлюда;
		// ОписаниеНоменклатуры.ВариантЧастичногоВыбытия = Перечисления.ВариантыУчетаЧастичногоВыбытияИС.питСвязаннымиИнгредиентами;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		НовыйНабор.Записать(Истина);
		
		РегистрыСведений.ОписаниеНоменклатурыИС.УстановитьОписание(ОписаниеНоменклатуры);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = "СвязанныеИнгредиенты";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеДоступностью(Форма)
	
	Элементы = Форма.Элементы;
	Элементы.ОдинИнгредиент.Видимость = Форма.ПродаетсяВРозлив;
	Элементы.НесколькоИнгредиентов.Видимость = НЕ Форма.ПродаетсяВРозлив;
	Если Форма.ПродаетсяВРозлив
		И НЕ ЗначениеЗаполнено(Форма.СвязанныеИнгредиенты) Тогда
		НоваяСтрока = Форма.СвязанныеИнгредиенты.Добавить();
		ЗаполнитьКлючСвязиИнгредиентов(Форма, НоваяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗафиксироватьИзменениеЭлемента(Форма)
	Форма.Модифицированность = Истина;
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьПоРецептуреНаСервере(ДатаРецептуры, СтруктурнаяЕдиница)
	
	ОсновнаяРецептура = питПроизводство.ВернутьОсновнуюРецептуру(Номенклатура,,
		Перечисления.питХозяйственныеОперации.РецептураПриготовление, 
		ДатаРецептуры,,,,,,
		СтруктурнаяЕдиница);
	Если Не ЗначениеЗаполнено(ОсновнаяРецептура) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыСпецификации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнаяРецептура,
		"Количество");
	КоличествоБлюда = РеквизитыСпецификации.Количество;
	
	// Заполнение таблицы производства.
	ТаблицаПроизводства = питПроизводство.ПолучитьИнгредиентыПоРецептуре(ОсновнаяРецептура,,,,"Номенклатура, Характеристика, ЕдиницаИзмерения");
	
	Если НЕ ЗначениеЗаполнено(ТаблицаПроизводства) Тогда
		Возврат;
	КонецЕсли;
	
	СвязанныеИнгредиенты.Очистить();
	АналогиИнгредиентов.Очистить();
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого ТекСтрока Из ТаблицаПроизводства Цикл
		МассивНоменклатуры.Добавить(ТекСтрока.Номенклатура);
	КонецЦикла;
	
	КэшРасчетов = Неопределено;
	РеквизитыИнгредиентов = питИнтеграцияИСМП.СвойстваМаркированнойПродукции(МассивНоменклатуры);
	Для Каждого ТекСтрока Из ТаблицаПроизводства Цикл
		ТекРеквизиты = РеквизитыИнгредиентов[ТекСтрока.Номенклатура];
		Если ТекРеквизиты = Неопределено
			ИЛИ НЕ (питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииДоступныйДляОтраженияОстатковИС(ТекРеквизиты.ВидПродукцииИС)) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВМЛ = питОбщегоНазначения.ПеревестиОбъемВМиллилитры(ТекСтрока.Номенклатура,
			ТекСтрока.ЕдиницаИзмерения,
			ТекСтрока.КоличествоУпаковок);
		
		НоваяСтрока = СвязанныеИнгредиенты.Добавить();
		НоваяСтрока.Ингредиент = ТекСтрока.Номенклатура;
		НоваяСтрока.КоличествоИнгредиента = КоличествоВМЛ;
	КонецЦикла;
	
	СвернутыеИнгредиенты = питОбщегоНазначения.СвернутьТаблицуЗначений(СвязанныеИнгредиенты.Выгрузить(),
		"Ингредиент", "КоличествоИнгредиента");
	СвязанныеИнгредиенты.Очистить();
	Для Каждого ТекСтрока Из СвернутыеИнгредиенты Цикл
		НоваяСтрока = СвязанныеИнгредиенты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
	ЗаполнитьКлючСвязиИнгредиентов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПроверитьДоступностьЗакрытия()
	ТекстВопроса = НСтр("ru='Данные были изменены. Сохранить изменения?'");
	ОтветПользователя = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если ОтветПользователя = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть(Неопределено);
	Иначе
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
КонецПроцедуры

