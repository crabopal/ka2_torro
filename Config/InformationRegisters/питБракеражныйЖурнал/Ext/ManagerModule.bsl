
#Область ПрограммныйИнтерфейс

// Функция удаляет записи в регистре "питБракеражныйЖурнал" с отбором по документу.
//
// Параметры:
//  Документ	 - ДокументСсылка.питБракеражПродукции - Ссылка на документ.
//  ТекстОшибки	 - Строка - Текст ошибки
// 
// Возвращаемое значение:
//  Булево - Истина, когда удаление выполнено и Ложь, когда произошла ошибка.
//
Функция УдалитьЗаписиПоДокументу(Документ, ТекстОшибки = "") Экспорт
	
	Результат = Ложь;
	
	// Удаление записей с отбором по документу.
	НаборЗаписейУдалить = РегистрыСведений.питБракеражныйЖурнал.СоздатьНаборЗаписей();
	НаборЗаписейУдалить.Отбор.Документ.Установить(Документ);
	
	Попытка
		НаборЗаписейУдалить.ДополнительныеСвойства.Вставить("РазрешитьЗапись", Истина);
		НаборЗаписейУдалить.Записать(Истина);
	Исключение
		ТекстОшибки = ТекстОшибки + "Ошибка удаления записей по документу по причине :
		|"+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	// Все хорошо.
	Результат = Истина;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
