
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	РазрешитьЗапись = Ложь;
	Если ДополнительныеСвойства.Свойство("РазрешитьЗапись") Тогда
		РазрешитьЗапись = ДополнительныеСвойства.РазрешитьЗапись;
	КонецЕсли;
	
	Если НЕ РазрешитьЗапись Тогда
		ТекстСообщения = "Прямая запись в регистр запрещена, используйте документ ""Бракераж продукции""";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
