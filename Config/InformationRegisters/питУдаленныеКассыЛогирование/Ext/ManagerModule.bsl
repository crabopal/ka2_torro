#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда  
	
#Область ПрограммныйИнтерфейс

//  Процедура - Зафиксировать событие.
//
// Параметры:
//  ПараметрыОбработки - Произвольный - Параметры обработки.
//  Действие - Произвольный - Действие.
//
Процедура ЗафиксироватьСобытие(ПараметрыОбработки, Действие) Экспорт
	
	Если НЕ ПараметрыОбработки.Свойство("НастройкиЛогирования") Тогда
		НастройкиЛогирования = РегистрыСведений.питУдаленныеКассыЛогированиеНастройки.НастройкиЛогирования();
		ПараметрыОбработки.Вставить("НастройкиЛогирования", НастройкиЛогирования);
	КонецЕсли;
	
	Если НЕ ПараметрыОбработки.НастройкиЛогирования.ЛогированиеВключено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РегистрыСведений.питУдаленныеКассыЛогированиеНастройки.ЛогироватьМетодПоУровню(ПараметрыОбработки.ИмяКоманды,
				ПараметрыОбработки.НастройкиЛогирования.УровеньЛогирования) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработкиДляСохранения = ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыОбработки);
	ЗапросHTTP = Неопределено;
	Если ПараметрыОбработкиДляСохранения.Свойство("ЗапросHTTP") Тогда
		ЗапросHTTP = ПараметрыОбработкиДляСохранения.ЗапросHTTP;
		ПараметрыОбработкиДляСохранения.Удалить("ЗапросHTTP");
	КонецЕсли;
	
	ОтветHTTP = Неопределено;
	Если ПараметрыОбработкиДляСохранения.Свойство("ОтветHTTP") Тогда
		ОтветHTTP = ПараметрыОбработкиДляСохранения.ОтветHTTP;
		ПараметрыОбработкиДляСохранения.Удалить("ОтветHTTP");
	КонецЕсли;
	
	ПараметрыОбмена = питОбменДаннымиHTTP.СформироватьТекстСообщенияJSON(ПараметрыОбработкиДляСохранения);
	СообщениеОбмена = ПараметрыОбработки.ТекстОтвета;
	
	ТипСообщенияОбмена = "";
	Если ПараметрыОбработки.Свойство("ContentType") Тогда
		ТипСообщенияОбмена = ПараметрыОбработки.ContentType;
	ИначеЕсли ПараметрыОбработки.Свойство("Content_Type") Тогда
		ТипСообщенияОбмена = ПараметрыОбработки.Content_Type;
	КонецЕсли;
	
	Если Действие = Перечисления.питУдаленныеКассыЛогированиеДействия.НачалоОбработки
		И НЕ ЗапросHTTP = Неопределено
		И ЗначениеЗаполнено(ТипСообщенияОбмена) Тогда
		Если ТипСообщенияОбмена = "application/zip" Тогда
			СообщениеОбмена = ЗапросHTTP.ПолучитьТелоКакДвоичныеДанные();
		Иначе
			СообщениеОбмена = ЗапросHTTP.ПолучитьТелоКакСтроку("UTF-8");
		КонецЕсли;
	КонецЕсли;
	
	ТекДата = ТекущаяДатаСеанса();
	НоваяЗапись = СоздатьМенеджерЗаписи();
	НоваяЗапись.ДатаСобытия = НачалоДня(ТекДата);
	НоваяЗапись.ИдентификаторЗаписи = Новый УникальныйИдентификатор;
	НоваяЗапись.Дата = ТекДата;
	НоваяЗапись.СообщениеОбмена = Новый ХранилищеЗначения(СообщениеОбмена, Новый СжатиеДанных(3));
	НоваяЗапись.ПараметрыОбмена = Новый ХранилищеЗначения(ПараметрыОбмена, Новый СжатиеДанных(3));
	НоваяЗапись.КассовыйУзел = ПараметрыОбработки.КассовыйУзел;
	НоваяЗапись.Действие = Действие;
	НоваяЗапись.Метод = ПараметрыОбработки.ИмяКоманды;
	НоваяЗапись.Порядок = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		НоваяЗапись.Записать(Ложь);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = ИмяСобытияЖР();
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	
КонецПроцедуры

//  Процедура - Очистить устаревшие записи.
//
Процедура ОчиститьУстаревшиеЗаписи() Экспорт
	
	НастройкиЛогирования = РегистрыСведений.питУдаленныеКассыЛогированиеНастройки.НастройкиЛогирования();
	
	МаксимальнаяДатаСобытия = ТекущаяДатаСеанса() - НастройкиЛогирования.ДлительностьХраненияЗаписей*86400;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УдаленныеКассыЛогирование.ДатаСобытия КАК ДатаСобытия
	|ИЗ
	|	РегистрСведений.питУдаленныеКассыЛогирование КАК УдаленныеКассыЛогирование
	|ГДЕ
	|	УдаленныеКассыЛогирование.Дата < &МаксимальнаяДата
	|
	|СГРУППИРОВАТЬ ПО
	|	УдаленныеКассыЛогирование.ДатаСобытия";
	Запрос.УстановитьПараметр("МаксимальнаяДата", МаксимальнаяДатаСобытия);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ДатаСобытия.Установить(Выборка.ДатаСобытия);
			НаборЗаписей.Записать();
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Функция - Имя события жр.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ИмяСобытияЖР()
	Результат = НСтр("ru='УдаленныеКассы'");
	Возврат Результат;
КонецФункции

#КонецОбласти
		
#КонецЕсли


