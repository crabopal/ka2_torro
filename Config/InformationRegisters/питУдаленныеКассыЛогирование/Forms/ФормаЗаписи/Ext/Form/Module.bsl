
  
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ТекСообщениеОбмена = ТекущийОбъект.СообщениеОбмена.Получить();
	Если ТекСообщениеОбмена = Неопределено Тогда
		ТекстСообщения = НСтр("ru='<Не указано>'");
	ИначеЕсли ТипЗнч(ТекСообщениеОбмена) = Тип("Строка") Тогда
		ТекстСообщения = ТекСообщениеОбмена;
	Иначе
		ТекстСообщения= СтрШаблон(НСтр("ru='<%1>'"), ТипЗнч(ТекСообщениеОбмена));
	КонецЕсли;
	
	Если ТипЗнч(ТекСообщениеОбмена) = Тип("ДвоичныеДанные") Тогда
		АдресСообщения = ПоместитьВоВременноеХранилище(ТекСообщениеОбмена, УникальныйИдентификатор);
	Иначе
		Элементы.СохранитьСообщение.Видимость = Ложь;
	КонецЕсли;
	
	
	ТекПараметрыОбмена = ТекущийОбъект.ПараметрыОбмена.Получить();
	Если ТекПараметрыОбмена = Неопределено Тогда
		ПараметрыЗапроса = НСтр("ru='<Не указано>'");
	ИначеЕсли ТипЗнч(ТекПараметрыОбмена) = Тип("Строка") Тогда
		ПараметрыЗапроса = ТекПараметрыОбмена;
	Иначе
		ПараметрыЗапроса= СтрШаблон(НСтр("ru='<%1>'"), ТипЗнч(ТекПараметрыОбмена));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьСообщение(Команда)
	ФайловаяСистемаКлиент.СохранитьФайл(,АдресСообщения, НСтр("ru='АрхивСообщения.zip'"));
КонецПроцедуры

#КонецОбласти
