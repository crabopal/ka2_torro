#Область ТаблицаНоменклатуры

&НаСервере
Процедура ТаблицаНоменклатурыПриИзмененииНаСервере(ИдентификаторСтроки)
	
	// Может быть передан идентификатор строки, а может быть сама строка.
	Если ТипЗнч(ИдентификаторСтроки) = Тип("Число") Тогда
		ТекущиеДанные = ТаблицаНоменклатуры.НайтиПоИдентификатору(ИдентификаторСтроки);
	Иначе
		ТекущиеДанные = ИдентификаторСтроки;
	КонецЕсли;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИзмениласьНоменклатура = ТекущиеДанные.Номенклатура <> ТекущиеДанные.НоменклатураПред;
	ИзмениласьХарактеристика = ТекущиеДанные.Характеристика <> ТекущиеДанные.ХарактеристикаПред;
	
	Если ИзмениласьНоменклатура ИЛИ ИзмениласьХарактеристика Тогда
		
		НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", ТекущиеДанные.Номенклатура, ТекущиеДанные.Характеристика));
		Если НайденныеСтроки.Количество() > 1 Тогда
			// Изменили на номенклатуру, которая уже есть в списке, ничего не делаем, выдаем сообщение.
			ОбщегоНазначения.СообщитьПользователю("Номенклатура <" + ТекущиеДанные.Номенклатура + "; " + ТекущиеДанные.Характеристика + "> уже добавлена");
			ТекущиеДанные.Номенклатура = ТекущиеДанные.НоменклатураПред;
			ТекущиеДанные.Характеристика = ТекущиеДанные.ХарактеристикаПред;
		Иначе
			// Удаление данных по старой номенклатуре из регистра.
			Если ЗначениеЗаполнено(ТекущиеДанные.НоменклатураПред) Тогда
				УдалитьДанныеВРегистре(ТекущиеДанные.НоменклатураПред, ТекущиеДанные.ХарактеристикаПред, Склад);
			КонецЕсли;
			// Добавление данных по новой номенклатуре в регистр.
			Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
				ДобавитьДанныеВРегистр(ТекущиеДанные.Номенклатура, ТекущиеДанные.Характеристика, Склад, ТекущиеДанные.Приоритет);
			КонецЕсли;
			ТекущиеДанные.НоменклатураПред = ТекущиеДанные.Номенклатура;
			ТекущиеДанные.ХарактеристикаПред = ТекущиеДанные.Характеристика;
		КонецЕсли;
		
	КонецЕсли;
	
	// Изменение приоритета
	НаборЗаписей = РегистрыСведений.питПриоритетыПриготовления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Склад.Установить(Склад);
	ИзмененныеСтроки = Новый Массив;
	Индекс = 0;
	Для каждого ТекСтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
		Если ЗначениеЗаполнено(ТекСтрокаНоменклатуры.Номенклатура)
			И ТекСтрокаНоменклатуры.Приоритет <> Индекс Тогда
			ТекСтрокаНоменклатуры.Приоритет = Индекс;
			ИзмененныеСтроки.Добавить(ТекСтрокаНоменклатуры);
		КонецЕсли;
		НовСтрокаНабора = НаборЗаписей.Добавить();
		НовСтрокаНабора.Склад = Склад;
		ЗаполнитьЗначенияСвойств(НовСтрокаНабора, ТекСтрокаНоменклатуры);
		Индекс = Индекс + 1;
	КонецЦикла;
	Если ИзмененныеСтроки.Количество() > 10 Тогда
		// Если изменилось много записей, то записываем через набор записей.
		НаборЗаписей.Записать();
	Иначе
		// Если изменилось немного записей, то используем менеджер записей.
		Для каждого ИзмененнаяСтрока Из ИзмененныеСтроки Цикл
			НовыйМенеджер = РегистрыСведений.питПриоритетыПриготовления.СоздатьМенеджерЗаписи();
			НовыйМенеджер.Склад = Склад;
			ЗаполнитьЗначенияСвойств(НовыйМенеджер, ИзмененнаяСтрока);
			НовыйМенеджер.Записать();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаНоменклатурыПередУдалениемНаСервере(ИдентификаторСтроки)
	СтрокаТаблицы = ТаблицаНоменклатуры.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Удаление соответствующих данных в регистре.
	Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		УдалитьДанныеВРегистре(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Характеристика, Склад);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ТаблицаНоменклатурыОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Номенклатура") 
		И НЕ ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", ВыбранноеЗначение, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка())).Количество() Тогда
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		НоваяСтрока.Номенклатура = ВыбранноеЗначение;
		НоваяСтрока.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КоличествоСтрок = ТаблицаНоменклатуры.Количество();
		Если КоличествоСтрок > 1 Тогда
			НоваяСтрока.Приоритет = ТаблицаНоменклатуры[ТаблицаНоменклатуры.Количество() - 2].Приоритет + 1;
		Иначе
			НоваяСтрока.Приоритет = 0;
		КонецЕсли;
		ТаблицаНоменклатурыПриИзмененииНаСервере(НоваяСтрока);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура СкладПриИзмененииНаСервере()
	// Заполнение таблицы номенклатуры.
	ЗаполнитьТаблицуНоменклатуры();
	// Служебные реквизиты для характеристик.
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаполнитьТаблицуНоменклатуры()
	
	ТаблицаНоменклатуры.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питПриоритетыПриготовления.Номенклатура КАК Номенклатура,
	|	питПриоритетыПриготовления.Характеристика КАК Характеристика,
	|	питПриоритетыПриготовления.Номенклатура КАК НоменклатураПред,
	|	питПриоритетыПриготовления.Характеристика КАК ХарактеристикаПред,
	|	питПриоритетыПриготовления.Приоритет КАК Приоритет
	|ИЗ
	|	РегистрСведений.питПриоритетыПриготовления КАК питПриоритетыПриготовления
	|ГДЕ
	|	питПриоритетыПриготовления.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Склад", Склад);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьДанныеВРегистре(Номенклатура, Характеристика, Склад)
	
	НаборЗаписей = РегистрыСведений.питПриоритетыПриготовления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
	НаборЗаписей.Отбор.Характеристика.Установить(Характеристика);
	НаборЗаписей.Отбор.Склад.Установить(?(Склад = Неопределено, Справочники.Склады.ПустаяСсылка(), Склад));
	НаборЗаписей.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьДанныеВРегистр(Номенклатура, Характеристика, Склад, Приоритет)
	
	МенеджерЗаписи = РегистрыСведений.питПриоритетыПриготовления.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.Характеристика = Характеристика;
	МенеджерЗаписи.Склад = ?(Склад = Неопределено, Справочники.Склады.ПустаяСсылка(), Склад);
	МенеджерЗаписи.Приоритет = Приоритет;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ТЗ = ТаблицаНоменклатуры.Выгрузить();
	ТЗ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(ТЗ, ПараметрыЗаполненияРеквизитов);
	ТЗ.Колонки.Удалить("НомерСтроки");
	ТаблицаНоменклатуры.Загрузить(ТЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНоменклатураПриИзменении(ИмяТЧ)
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	ТекущаяСтрока.ХарактеристикиИспользуются = питОбщегоНазначения.ХарактеристикиИспользуются(ТекущаяСтрока.Номенклатура);
КонецПроцедуры

#КонецОбласти
