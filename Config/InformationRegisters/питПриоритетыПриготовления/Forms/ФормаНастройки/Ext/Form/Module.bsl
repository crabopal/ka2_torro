&НаКлиенте
Процедура НоменклатураПодбор(Команда)
	ПараметрыВыбора = Новый Структура("РежимВыбора,ЗакрыватьПриВыборе", Истина, Ложь);
	ФормаВыбора = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора, Элементы.ТаблицаНоменклатуры);
	ФормаВыбора.Открыть();
КонецПроцедуры

#КонецОбласти

