#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма отчета.
//  КлючВарианта - Произвольный - Ключ варианта.
//  Настройки - Произвольный - Настройки.
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	
	// Добавление группы отбора по дням недели.
	МассивДобавляемыхРеквизитов = Новый Массив;
	Для Сч=1 По 7 Цикл
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ФлДень" + Сч, Новый ОписаниеТипов("Булево")));
	КонецЦикла;
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	ГруппаФлДень = ЭтаФорма.Элементы.Вставить("ГруппаФлДень" + Сч, Тип("ГруппаФормы"), ЭтаФорма, ЭтаФорма.Элементы.КомандыИПоказатели);
	ГруппаФлДень.Заголовок = "";
	ГруппаФлДень.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаФлДень.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаФлДень.Отображение = ОтображениеОбычнойГруппы.Нет;
	СекундВДне = 24*60*60;
	НоваяДата = ТекущаяДата();
	Пока ДеньНедели(НоваяДата) <> 1 Цикл
		НоваяДата = НоваяДата + СекундВДне;
	КонецЦикла;
	Для Сч=1 По 7 Цикл
		ТекущаяДата = НоваяДата + СекундВДне * (Сч-1);
		ГруппаФлКонкретныйДень = ЭтаФорма.Элементы.Добавить("ГруппаФлДень" + Сч, Тип("ГруппаФормы"), ГруппаФлДень);
		ГруппаФлКонкретныйДень.Заголовок = Формат(ТекущаяДата, "ДФ=ддд");
		ГруппаФлКонкретныйДень.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаФлКонкретныйДень.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		НовыйЭлементФормы = ЭтаФорма.Элементы.Добавить("ФлДень" + Сч, Тип("ПолеФормы"), ГруппаФлКонкретныйДень);
		НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлементФормы.Заголовок = "";
		НовыйЭлементФормы.ПутьКДанным = "ФлДень"+ Сч;
		НовыйЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Если ДеньНедели(ТекущаяДата) = 6 ИЛИ ДеньНедели(ТекущаяДата) = 7 Тогда
			ГруппаФлКонкретныйДень.ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Процедура - При компоновке результата.
//
// Параметры:
//  ДокументРезультат - Произвольный - Документ результат.
//  ДанныеРасшифровки - Произвольный - Данные расшифровки.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	питЦентрМониторинга.ЗаписатьОперацииБизнесСтатистики(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область Инициализация
#Область СлужебныеПроцедурыИФункции
#КонецОбласти
#КонецОбласти

#КонецЕсли




