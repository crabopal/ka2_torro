ГДЕ
	ОборотыПоОплатам.ВидОперацииЧислом = 1

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	NULL,
	ОборотыПоОплатам.ВидОплаты,
	0,
	ОборотыПоОплатам.СуммаОборот,
	ОборотыПоОплатам.Регистратор,
	ОборотыПоОплатам.Период,
