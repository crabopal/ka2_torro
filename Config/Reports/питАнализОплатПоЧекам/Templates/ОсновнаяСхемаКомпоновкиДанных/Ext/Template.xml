		<query>ВЫБРАТЬ
	ОбщепитОплатыПоЧекам.Сумма КАК СуммаОборот,
	ОбщепитОплатыПоЧекам.ВидОплаты,
	ОбщепитОплатыПоЧекам.Документ КАК Регистратор,
	ВЫБОР
		КОГДА ОбщепитОплатыПоЧекам.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа)
			ТОГДА 1
		ИНАЧЕ ВЫБОР
				КОГДА ОбщепитОплатыПоЧекам.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат)
					ТОГДА 2
				ИНАЧЕ 3
			КОНЕЦ
	КОНЕЦ КАК ВидОперацииЧислом,
	ОбщепитОплатыПоЧекам.Дата КАК Период,
	ОбщепитОплатыПоЧекам.Кассир,
	ОбщепитОплатыПоЧекам.Подразделение,
	ОбщепитОплатыПоЧекам.КассаККМ,
	ОбщепитОплатыПоЧекам.НомерСмены,
	ОбщепитОплатыПоЧекам.Организация,
	ВЫБОР
		КОГДА ЧАС(ОбщепитОплатыПоЧекам.Дата) &lt; 6
			ТОГДА 4
		ИНАЧЕ ВЫБОР
				КОГДА ЧАС(ОбщепитОплатыПоЧекам.Дата) &lt; 12
					ТОГДА 1
				ИНАЧЕ ВЫБОР
						КОГДА ЧАС(ОбщепитОплатыПоЧекам.Дата) &lt; 18
							ТОГДА 2
						ИНАЧЕ 3
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК ВремяСуток,
	ДЕНЬНЕДЕЛИ(ОбщепитОплатыПоЧекам.Дата) КАК ДеньНедели,
	ОбщепитОплатыПоЧекам.ДисконтнаяКарта
ПОМЕСТИТЬ ОборотыПоОплатам
ИЗ
	РегистрСведений.питОплатыПоЧекам КАК ОбщепитОплатыПоЧекам
ГДЕ
	ОбщепитОплатыПоЧекам.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
{ГДЕ
	(ОбщепитОплатыПоЧекам.Организация = &amp;Организация),
	(ОбщепитОплатыПоЧекам.Подразделение В (&amp;СписокПодразделений)),
	(ПОДСТРОКА(&amp;ДниНедели, ДЕНЬНЕДЕЛИ(ОбщепитОплатыПоЧекам.Дата), 1) = "1"),
	(ОбщепитОплатыПоЧекам.КассаККМ В (&amp;СписокКассККМ)),
	(ОбщепитОплатыПоЧекам.НомерСмены = &amp;НомерСмены)}
;

