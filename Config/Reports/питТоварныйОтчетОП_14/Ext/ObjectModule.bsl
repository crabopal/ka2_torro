#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НомерОтчета = НомерОтчета + 1;
	
	ДокументРезультат.Вывести(СформироватьОтчет(
		ДатаНачала,
		ДатаОкончания,
		Склад,
		Организация,
		НомерОтчета));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьОтчет(ДатаНачала, ДатаОкончания, Склад, Организация, НомерОтчета)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация"	, Организация);
	ПараметрыОтчета.Вставить("Склад"			, Склад);
	ПараметрыОтчета.Вставить("НомерОтчета"	, НомерОтчета);
	ПараметрыОтчета.Вставить("ДатаНачала"		, ДатаНачала);
	ПараметрыОтчета.Вставить("ДатаОкончания"	, ДатаОкончания);
	Если ЗначениеЗаполнено(Склад) Тогда
		ПараметрыОтчета.Вставить("ВидЦены"		, Склад.УчетныйВидЦены);
	Иначе
		ПараметрыОтчета.Вставить("ВидЦены"		, питОбщегоНазначения.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит"));
	КонецЕсли;
	ПараметрыОтчета.Вставить("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	ПараметрыОтчета.Вставить("ДатаОкончания"	, ДатаОкончания);
	ПараметрыОтчета.Вставить("ВыводитьСуммуДокументаИДельту"	, ВыводитьСуммуДокументаИДельту);
	
	ПроверитьПараметрыОтчета(ПараметрыОтчета);
	
	// Формируем структуру итогов
	ИтогиТаблицы = Новый Структура("Товар, Специи, Тара, Стекло");
	ИтогиТаблицы.Товар	= Новый Структура ("Приход, Расход");
	ИтогиТаблицы.Специи	= Новый Структура ("Приход, Расход");	
	ИтогиТаблицы.Тара	= Новый Структура ("Приход, Расход");
	ИтогиТаблицы.Стекло	= Новый Структура ("Приход, Расход");
	
	// Получаем макет
	Результат = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	
	// Выводим части документа 
	
	// 0. Шапка
	ОбластьШапки = ВывестиШапку(Результат, Макет, ПараметрыОтчета);
	ПовторятьПриПечатиОбластьШапки = Результат.Область(1 + ОбластьШапки.ВысотаТаблицы, ,2 + ОбластьШапки.ВысотаТаблицы);
	
	// Получаем структуру ОстаткиИОбороты
	ОстаткиИОбороты = ПолучитьОстаткиИОбороты(ПараметрыОтчета);
	
	// 1. Начальный остаток
	ВывестиОстатки(Результат, ОстаткиИОбороты, Макет, ПараметрыОтчета, Истина, ИтогиТаблицы);
	
	// 2. Приход
	Результат.Вывести(Макет.ПолучитьОбласть("Приход"));
	ВывестиСтроки(Результат, ОстаткиИОбороты, Макет, ПараметрыОтчета,Истина, ИтогиТаблицы);
	
	Результат.ВывестиГоризонтальныйРазделительСтраниц();
	
	// 3. Расход
	Результат.Вывести(Макет.ПолучитьОбласть("Расход"));
	ВывестиСтроки(Результат, ОстаткиИОбороты, Макет, ПараметрыОтчета, Ложь, ИтогиТаблицы);
		
	// 4. Конечный остаток
	ВывестиОстатки(Результат, ОстаткиИОбороты, Макет, ПараметрыОтчета, Ложь, ИтогиТаблицы);
	
	// 5. Инвентаризация
	ВывестиИнвентаризацию(Результат, ОстаткиИОбороты, Макет, ПараметрыОтчета, ИтогиТаблицы);
	
	// 6. Подвал
	ВывестиПодвал(Результат, ОстаткиИОбороты, Макет, ПараметрыОтчета);
	
	Результат.ПовторятьПриПечатиСтроки = ПовторятьПриПечатиОбластьШапки;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьПараметрыОтчета(ПараметрыОтчета)
	
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.ВидЦены) Тогда
		ВызватьИсключение НСтр("ru = 'Для склада не установлен учетный вид цены(в складе, а если таковой не задан, то в общих настройках подсистемы общепит).';
																|en = 'Price type is not specified for the warehouse.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.ВидЦены.ВалютаЦены) Тогда
		ВызватьИсключение НСтр("ru = 'Не установлена валюта вида цены.';
																|en = 'Price type is not specified.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.ВалютаРегламентированногоУчета) Тогда
		ВызватьИсключение НСтр("ru = 'В настройках системы не задано значение валюты регламентированного учета.';
								|en = 'Value of the compliance accounting currency is not specified in the application settings.'");
	КонецЕсли;
	
КонецПроцедуры

Функция ВывестиШапку(Знач Результат, Знач Макет, Знач ПараметрыОтчета)
	
	СведенияОПокупателе = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ПараметрыОтчета.Организация, ПараметрыОтчета.ДатаОкончания);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.ОрганизацияПредставление = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПокупателе);
	ОбластьМакета.Параметры.СкладПредставление = ПараметрыОтчета.Склад.Наименование;
	ОбластьМакета.Параметры.ДатаСоставления =  Формат(ТекущаяДата(), "ДЛФ=Д");
	ОбластьМакета.Параметры.ОрганизацияПоОКПО = СведенияОПокупателе.КодПоОКПО;
	МОЛНаименование = ПараметрыОтчета.Склад.ТекущийОтветственный.Наименование;
	ОбластьМакета.Параметры.МОЛ = ?(ЗначениеЗаполнено(МОЛНаименование), МОЛНаименование, "");
	
	Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Сотрудники.Код КАК МОЛТабельныйНомер
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.ФизическоеЛицо = &ФизЛицо");
	Иначе
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Сотрудники.Код КАК МОЛТабельныйНомер
		|ИЗ
		|	Справочник.ФизическиеЛица КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Ссылка = &ФизЛицо");
	КонецЕсли;
	Запрос.УстановитьПараметр("Физлицо", ПараметрыОтчета.Склад.ТекущийОтветственный);
	ВыборкаРезультатаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаРезультатаЗапроса.Следующий() Тогда
		ОбластьМакета.Параметры.МОЛТабельныйНомер = ?(ЗначениеЗаполнено(ВыборкаРезультатаЗапроса.МОЛТабельныйНомер), ВыборкаРезультатаЗапроса.МОЛТабельныйНомер, "");
	КонецЕсли;
	
	ОбластьМакета.Параметры.Номер = ПараметрыОтчета.НомерОтчета;
	
	Результат.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	Результат.Вывести(ОбластьМакета);
	
	Возврат ОбластьМакета;

КонецФункции

Функция ПолучитьОстаткиИОбороты(ПараметрыОтчета)
	
	// Описываем массив перемещения
	МассивПеремещение = Новый Массив();
	
	// Описываем массив который не надо учитывать
	МассивВыпуска = Новый Массив();
	//МассивВыпуска.Добавить(Перечисления.ХозяйственныеОперации.питВыпускПродукции);
	//МассивВыпуска.Добавить(Перечисления.ХозяйственныеОперации.питВыпускПродукцииСоСписанием);
	//МассивВыпуска.Добавить(Перечисления.ХозяйственныеОперации.питВыпускПродукцииСПеремещением);
	//МассивВыпуска.Добавить(Перечисления.ХозяйственныеОперации.питВыпускПродукцииСРеализацией);
	//МассивВыпуска.Добавить(Перечисления.ХозяйственныеОперации.питВыпускПродукцииСРозничнойРеализацией);
	Если ПараметрыОтчета.Склад = Справочники.Склады.ПустаяСсылка() Тогда 
		//МассивВыпуска.Добавить(Перечисления.ХозяйственныеОперации.ПеремещениеТоваров);
	Иначе
		//МассивПеремещение.Добавить(Перечисления.ХозяйственныеОперации.ПеремещениеТоваров);	
	КонецЕсли;
	
	// Получение исходных данных для формирования отчета из похожего отчета "ТОРГ29"
	ИсходныеДанные = СформироватьОтчетТОРГ29_ПолучитьТаблицуИсходныхДанных(ПараметрыОтчета);
	Если ИсходныеДанные.Количество() = 0 Тогда
		НачОст = 0;
		КонОст = 0;
	Иначе
		Если ИсходныеДанные.Количество() > 1 Тогда
			Если ИсходныеДанные[0].Регистратор = Неопределено И ИсходныеДанные[1].Регистратор <> Неопределено Тогда
				НачОст = ИсходныеДанные[1].СуммаНачальныйОстаток;
			Иначе
				НачОст = ИсходныеДанные[0].СуммаНачальныйОстаток;
			КонецЕсли;
		Иначе
			НачОст = ИсходныеДанные[0].СуммаНачальныйОстаток;
		КонецЕсли;
		КонОст = ИсходныеДанные[ИсходныеДанные.Количество()-1].СуммаКонечныйОстаток;
	КонецЕсли;
	
	// Преобразуем полученные данные как нам требуется.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	0 КАК КоличествоОстаток,
	|	&НачОст КАК СуммаОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	0 КАК КоличествоОстаток,
	|	&КонОст КАК СуммаОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Регистратор КАК Регистратор,
	|	ЕСТЬNULL(Таблица.СуммаНачальныйОстаток, 0) КАК НачОст,
	|	ЕСТЬNULL(Таблица.СуммаПриход, 0) КАК Приход,
	|	ЕСТЬNULL(Таблица.СуммаРасход, 0) КАК Расход,
	|	ЕСТЬNULL(Таблица.СуммаКонечныйОстаток, 0) КАК КонОст
	|ПОМЕСТИТЬ ТаблицаДокументов
	|ИЗ
	|	&ИсходныеДанные КАК Таблица
	|ГДЕ
	|	Таблица.Регистратор <> НЕОПРЕДЕЛЕНО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокументов.Регистратор КАК Документ,
	|	ЕСТЬNULL(ТаблицаДокументов.Регистратор.ХозяйственнаяОперация, ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка)) КАК ХозяйственнаяОперация,
	|	ТаблицаДокументов.Регистратор.Номер КАК НомерДок,
	|	ТаблицаДокументов.Регистратор.Дата КАК ДатаДок,
	|	ЕСТЬNULL(ТаблицаДокументов.Регистратор.СуммаДокумента, 0) КАК РегистраторСумма,
	|	0 КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаДокументов.КонОст - ТаблицаДокументов.НачОст > 0
	|			ТОГДА ТаблицаДокументов.КонОст - ТаблицаДокументов.НачОст
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ТаблицаПриход
	|ИЗ
	|	ТаблицаДокументов КАК ТаблицаДокументов
	|ГДЕ
	|	ТаблицаДокументов.КонОст > ТаблицаДокументов.НачОст
	|	И НЕ ТаблицаДокументов.Приход = ТаблицаДокументов.Расход
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокументов.Регистратор КАК Документ,
	|	ЕСТЬNULL(ТаблицаДокументов.Регистратор.ХозяйственнаяОперация, ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка)) КАК ХозяйственнаяОперация,
	|	ТаблицаДокументов.Регистратор.Номер КАК НомерДок,
	|	ТаблицаДокументов.Регистратор.Дата КАК ДатаДок,
	|	ТаблицаДокументов.Регистратор.СуммаДокумента КАК РегистраторСумма,
	|	0 КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаДокументов.КонОст - ТаблицаДокументов.НачОст > 0
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаДокументов.НачОст - ТаблицаДокументов.КонОст
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ ТаблицаРасход
	|ИЗ
	|	ТаблицаДокументов КАК ТаблицаДокументов
	|ГДЕ
	|	ТаблицаДокументов.НачОст > ТаблицаДокументов.КонОст
	|	И НЕ ТаблицаДокументов.Приход = ТаблицаДокументов.Расход
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПриход.Документ КАК Документ,
	|	ТаблицаПриход.НомерДок КАК НомерДок,
	|	ТаблицаПриход.ДатаДок КАК ДатаДок,
	|	ТаблицаПриход.РегистраторСумма КАК РегистраторСумма,
	|	СУММА(ТаблицаПриход.Количество) КАК Количество,
	|	СУММА(ТаблицаПриход.Сумма) КАК Сумма
	|ИЗ
	|	ТаблицаПриход КАК ТаблицаПриход
	|ГДЕ
	|	НЕ (ТаблицаПриход.Документ ССЫЛКА Документ.ПересортицаТоваров
	|	ИЛИ ТаблицаПриход.Документ ССЫЛКА Документ.ОприходованиеИзлишковТоваров
	|	ИЛИ ТаблицаПриход.Документ ССЫЛКА Документ.СписаниеНедостачТоваров)
	|	И НЕ ТаблицаПриход.ХозяйственнаяОперация В (&МассивВыпуска)
	|	И НЕ ТаблицаПриход.ХозяйственнаяОперация В (&МассивПеремещение)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПриход.Документ,
	|	ТаблицаПриход.НомерДок,
	|	ТаблицаПриход.ДатаДок,
	|	ТаблицаПриход.РегистраторСумма
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДок,
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРасход.Документ КАК Документ,
	|	ТаблицаРасход.НомерДок КАК НомерДок,
	|	ТаблицаРасход.ДатаДок КАК ДатаДок,
	|	ТаблицаРасход.РегистраторСумма КАК РегистраторСумма,
	|	СУММА(ТаблицаРасход.Количество) КАК Количество,
	|	СУММА(ТаблицаРасход.Сумма) КАК Сумма
	|ИЗ
	|	ТаблицаРасход КАК ТаблицаРасход
	|ГДЕ
	|	НЕ (ТаблицаРасход.Документ ССЫЛКА Документ.ПересортицаТоваров
	|	ИЛИ ТаблицаРасход.Документ ССЫЛКА Документ.ОприходованиеИзлишковТоваров
	|	ИЛИ ТаблицаРасход.Документ ССЫЛКА Документ.СписаниеНедостачТоваров)
	|	И НЕ ТаблицаРасход.ХозяйственнаяОперация В (&МассивВыпуска)
	|	И НЕ ТаблицаРасход.ХозяйственнаяОперация В (&МассивПеремещение)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаРасход.Документ,
	|	ТаблицаРасход.НомерДок,
	|	ТаблицаРасход.ДатаДок,
	|	ТаблицаРасход.РегистраторСумма
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДок,
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ТаблицаПриход.Количество, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(ТаблицаПриход.Сумма, 0)) КАК Сумма
	|ИЗ
	|	ТаблицаПриход КАК ТаблицаПриход
	|ГДЕ
	|	(ТаблицаПриход.Документ ССЫЛКА Документ.ПересортицаТоваров
	|	ИЛИ ТаблицаПриход.Документ ССЫЛКА Документ.ОприходованиеИзлишковТоваров
	|	ИЛИ ТаблицаПриход.Документ ССЫЛКА Документ.СписаниеНедостачТоваров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ТаблицаРасход.Количество, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(ТаблицаРасход.Сумма, 0)) КАК Сумма
	|ИЗ
	|	ТаблицаРасход КАК ТаблицаРасход
	|ГДЕ
	|	(ТаблицаРасход.Документ ССЫЛКА Документ.ПересортицаТоваров
	|	ИЛИ ТаблицаРасход.Документ ССЫЛКА Документ.ОприходованиеИзлишковТоваров
	|	ИЛИ ТаблицаРасход.Документ ССЫЛКА Документ.СписаниеНедостачТоваров)";
	Запрос.УстановитьПараметр("ИсходныеДанные"	, ИсходныеДанные);
	Запрос.УстановитьПараметр("НачОст"			, НачОст);
	Запрос.УстановитьПараметр("КонОст"			, КонОст);
	Запрос.УстановитьПараметр("МассивПеремещение",	МассивПеремещение);
	Запрос.УстановитьПараметр("МассивВыпуска",		МассивВыпуска);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// Выгружаем результат
	КонечнаяСтруктура = Новый Структура ();
	КонечнаяСтруктура.Вставить("НачальныеОстататки", 	РезультатЗапроса[0].Выбрать());
	КонечнаяСтруктура.Вставить("КонечныеОстатки", 		РезультатЗапроса[1].Выбрать());
	КонечнаяСтруктура.Вставить("ДвиженияПриход", 		РезультатЗапроса[5].Выбрать());
	КонечнаяСтруктура.Вставить("ДвиженияРасход", 		РезультатЗапроса[6].Выбрать());
	КонечнаяСтруктура.Вставить("ИнвентаризацияПриход", 	РезультатЗапроса[7].Выбрать());
	КонечнаяСтруктура.Вставить("ИнвентаризацияРасход", 	РезультатЗапроса[8].Выбрать());
	Возврат КонечнаяСтруктура;

КонецФункции

// %ИзЕРП% Отчеты.ТоварныйОтчетТОРГ29.МодульОбъекта.СформироватьОтчетТОРГ29 
//  (часть по получению таблицы исходных данных).
//
Функция СформироватьОтчетТОРГ29_ПолучитьТаблицуИсходныхДанных(ПараметрыОтчета)
	
	ВидЦены = ПараметрыОтчета.ВидЦены;
	
	// +%ИзЕРП%
	
	СхемаКомпоновкиДанных = Отчеты.ВедомостьПоТоварамОрганизацийВЦенахНоменклатуры.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	НаборДанных25 = СхемаКомпоновкиДанных.НаборыДанных.Найти("Запрос2_5");
	Если ЦенообразованиеВызовСервера.ИспользуетсяЦенообразование25() Тогда
		НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("Запрос");
		НаборДанных.Запрос = НаборДанных25.Запрос;
	КонецЕсли;
	СхемаКомпоновкиДанных.НаборыДанных.Удалить(НаборДанных25);
	
	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		
		ТекстЗамены = 
		"ВЫБОР
		|		КОГДА ЦеныНоменклатурыА.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				ИЛИ ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки1, 0) = 0
		|			ТОГДА ЦеныНоменклатурыА.Цена
		|		ИНАЧЕ ЦеныНоменклатурыА.Цена / &ТекстЗапросаКоэффициентУпаковки1
		|	КОНЕЦ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&АктуальнаяЦена", ТекстЗамены);
		
		ТекстЗамены = 
		"ВЫБОР
		|		КОГДА ЦеныНоменклатурыБ.Цена ЕСТЬ NULL 
		|			ТОГДА 0
		|		КОГДА ЦеныНоменклатурыБ.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				ИЛИ ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки2, 0) = 0
		|			ТОГДА ЦеныНоменклатурыБ.Цена
		|		ИНАЧЕ ЦеныНоменклатурыБ.Цена / &ТекстЗапросаКоэффициентУпаковки2
		|	КОНЕЦ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтараяЦена", ТекстЗамены);
		
		ТекстЗамены = 
		"ВЫБОР
		|		КОГДА ЦеныНоменклатурыА.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				ИЛИ ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки1, 0) = 0
		|			ТОГДА ЦеныНоменклатурыА.Цена
		|		ИНАЧЕ ЦеныНоменклатурыА.Цена / &ТекстЗапросаКоэффициентУпаковки1
		|	КОНЕЦ - ВЫБОР
		|		КОГДА ЦеныНоменклатурыБ.Цена ЕСТЬ NULL 
		|			ТОГДА 0
		|		КОГДА ЦеныНоменклатурыБ.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				ИЛИ ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки2, 0) = 0
		|			ТОГДА ЦеныНоменклатурыБ.Цена
		|		ИНАЧЕ ЦеныНоменклатурыБ.Цена / &ТекстЗапросаКоэффициентУпаковки2
		|	КОНЕЦ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Дельта", ТекстЗамены);
		
	Иначе
		
		ТекстЗамены = 
		"ЦеныНоменклатурыА.Цена";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&АктуальнаяЦена", ТекстЗамены);
		
		ТекстЗамены = 
		"ВЫБОР
		|		КОГДА
		|			ЦеныНоменклатурыБ.Цена ЕСТЬ NULL
		|		ТОГДА
		|			0
		|		ИНАЧЕ
		|			ЦеныНоменклатурыБ.Цена
		|	КОНЕЦ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтараяЦена", ТекстЗамены);
		
		ТекстЗамены = 
		"ЦеныНоменклатурыА.Цена
		|		- ВЫБОР
		|			КОГДА
		|				ЦеныНоменклатурыБ.Цена ЕСТЬ NULL
		|			ТОГДА
		|				0
		|			ИНАЧЕ
		|				ЦеныНоменклатурыБ.Цена
		|		КОНЕЦ";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Дельта", ТекстЗамены);
		
	КонецЕсли;
	
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = ТекстЗапроса;	
	
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = СтрЗаменить(СхемаКомпоновкиДанных.НаборыДанных[0].Запрос, "&ТекстЗапросаКоэффициентУпаковки1",
	Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
	"ЦеныНоменклатурыА.Упаковка",
	"ЦеныНоменклатурыА.Номенклатура"));
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = СтрЗаменить(СхемаКомпоновкиДанных.НаборыДанных[0].Запрос, "&ТекстЗапросаКоэффициентУпаковки2",
	Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
	"ЦеныНоменклатурыБ.Упаковка",
	"ЦеныНоменклатурыБ.Номенклатура"));
	// Подготовка компоновщика макета компоновки данных.
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	Компоновщик.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	// Выбранные поля.
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("Регистратор");
	ОбязательныеПоля.Добавить("СуммаНачальныйОстаток");
	ОбязательныеПоля.Добавить("СуммаПриход");
	ОбязательныеПоля.Добавить("СуммаРасход");
	ОбязательныеПоля.Добавить("СуммаКонечныйОстаток");
	Компоновщик.Настройки.Выбор.Элементы.Очистить();
	Для Каждого ОбязательноеПоле Из ОбязательныеПоля Цикл
		ПолеСКД = КомпоновкаДанныхСервер.НайтиПолеСКДПоПолномуИмени(Компоновщик.Настройки.Выбор.ДоступныеПоляВыбора.Элементы, ОбязательноеПоле);
		Если ПолеСКД <> Неопределено Тогда
			ВыбранноеПоле = Компоновщик.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Поле = ПолеСКД.Поле;
		КонецЕсли;
	КонецЦикла;
	
	// Добавление группировок.
	Компоновщик.Настройки.Структура.Очистить();
	КомпоновкаДанныхКлиентСервер.ДобавитьГруппировку(Компоновщик, "Регистратор");
	//КомпоновкаДанныхКлиентСервер.ДобавитьГруппировку(Компоновщик, "ЦенаУстановлена");
	
	// Установка отборов.
	Если ЗначениеЗаполнено(Склад) Тогда
		КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Компоновщик, "Склад",       Склад);
	КонецЕсли;
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(Компоновщик, "Организация", Организация);
	
	// Установка параметра "Вид цены"
	ПараметрВидЦены = Новый ПараметрКомпоновкиДанных("ВидЦены");
	ЗначениеПараметраВидЦены = Компоновщик.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрВидЦены);
	Если ЗначениеПараметраВидЦены <> Неопределено Тогда
		ЗначениеПараметраВидЦены.Значение = ВидЦены;
		ЗначениеПараметраВидЦены.Использование = Истина;
	КонецЕсли;
	
	Период = Новый СтандартныйПериод;
	Период.ДатаНачала    = НачалоДня(ДатаНачала);
	Период.ДатаОкончания = КонецДня(ДатаОкончания);
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(Компоновщик.Настройки, "ПериодОтчета", Период);
	
	// Компоновка макета компоновки данных.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Компоновщик.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	// Построение таблицы значений.
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновкиДанных, , , Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	ИсходныеДанные = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ИсходныеДанные);
	ПроцессорВывода.Вывести(Процессор);
	
	// -%ИзЕРП%
	
	ВалютаСклада = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦены, "ВалютаЦены");
	ВалютаРеглУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Организация);
	
	// Пересчет в валюту регл учета
	Для каждого ТекСтрокаДанных Из ИсходныеДанные Цикл
		ТекСтрокаДанных.СуммаНачальныйОстаток = ТекСтрокаДанных.СуммаНачальныйОстаток * РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(ВалютаСклада, ВалютаРеглУчета, Неопределено, ВалютаРеглУчета);
		ТекСтрокаДанных.СуммаКонечныйОстаток = ТекСтрокаДанных.СуммаКонечныйОстаток * РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(ВалютаСклада, ВалютаРеглУчета, Неопределено, ВалютаРеглУчета);
		ТекСтрокаДанных.СуммаПриход = ТекСтрокаДанных.СуммаПриход * РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(ВалютаСклада, ВалютаРеглУчета, Неопределено, ВалютаРеглУчета);
		ТекСтрокаДанных.СуммаРасход = ТекСтрокаДанных.СуммаРасход * РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(ВалютаСклада, ВалютаРеглУчета, Неопределено, ВалютаРеглУчета);
	КонецЦикла;
	
	Возврат ИсходныеДанные;
	
КонецФункции


Процедура ВывестиОстатки(Результат, ТаблицаОстаткиИОбороты, Макет, ПараметрыОтчета, НачалоПериода = Истина, ИтогиТаблицы)
	
	Если НачалоПериода Тогда
		ОбластьОстаток = Макет.ПолучитьОбласть("ОстатокНачала");
		ОбластьОстаток.Параметры.Дата = СтрШаблон(НСтр("ru = '%1'"), Формат(ПараметрыОтчета.ДатаНачала, "ДЛФ=Д"));
		ТаблицаОстаткиИОбороты.НачальныеОстататки.Следующий();
		РасчетныйОстатокТовара =  ТаблицаОстаткиИОбороты.НачальныеОстататки.СуммаОстаток; 
	Иначе
		// Расчетный остаток, он может отличатся от фактического
		// ТаблицаОстаткиИОбороты.КонечныеОстатки - отображает фактический остаток
		ОбластьОстаток = Макет.ПолучитьОбласть("ОстатокКонец");
		ОбластьОстаток.Параметры.Дата = СтрШаблон(НСтр("ru = '%1'"), Формат(ПараметрыОтчета.ДатаОкончания, "ДЛФ=Д"));
		
		НачОстТовара = ТаблицаОстаткиИОбороты.НачальныеОстататки.СуммаОстаток;
		ПриходТовара = ИтогиТаблицы.Товар.Приход;
		РасходТовара = ИтогиТаблицы.Товар.Расход; 
		
		РасчетныйОстатокТовара = НачОстТовара + ПриходТовара - РасходТовара; 
	КонецЕсли;

	ЗаполнитьОбласть(ОбластьОстаток.Параметры, РасчетныйОстатокТовара); 
	Результат.Вывести(ОбластьОстаток);
	
КонецПроцедуры

Процедура ВывестиСтроки(Знач Результат, Знач ТаблицаОстаткиИОбороты, Знач Макет, Знач ПараметрыОтчета, ЭтоПриход = Истина, ИтогиТаблицы)

	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
	ИтогПродажи = 0; 
	ИтогТовара = 0;
	ИтогСпеции = 0;
	ИтогТары   = 0;
	ИтогСтекло = 0;
	
	Если ЭтоПриход ТОгда
		ТаблицаЗнач = ТаблицаОстаткиИОбороты.ДвиженияПриход;
	Иначе	
		ТаблицаЗнач = ТаблицаОстаткиИОбороты.ДвиженияРасход;
	КонецЕсли;
	
	
	
	Пока ТаблицаЗнач.Следующий() Цикл
		РегистраторСумма = ?(ТаблицаЗнач.РегистраторСумма = NULL, 0, ТаблицаЗнач.РегистраторСумма);
		
		ОбластьСтрока.Параметры.Докум = ТаблицаЗнач.Документ;
		ОбластьСтрока.Параметры.ДатаДокумента = Формат(ТаблицаЗнач.ДатаДок, "ДЛФ=Д");
		ОбластьСтрока.Параметры.НомерДокумента = Формат(ТаблицаЗнач.НомерДок,"ЧЦ=11; ЧВН=; ЧГ=0");
		ЗаполнитьОбласть(ОбластьСтрока.Параметры, ТаблицаЗнач.Сумма);
		
		
		ИтогТовара = ИтогТовара + ТаблицаЗнач.Сумма;
		
		Если ЭтоПриход ТОгда
			ОбластьСтрока.Параметры.Продажа		= "X";	
		Иначе	
		   ОбластьСтрока.Параметры.Продажа		= РегистраторСумма;
		   ИтогПродажи = ИтогПродажи + РегистраторСумма;
		КонецЕсли;
			
		 

		Если ТипЗнч(ТаблицаЗнач.Документ) = Тип("Строка") Тогда
			ОбластьСтрока.Параметры.Расшифровка = Новый Структура("Документ, Дата, Сумма", ТаблицаЗнач.Документ, ТаблицаЗнач.ДатаДок, ТаблицаЗнач.Приход);
		Иначе
			ОбластьСтрока.Параметры.Расшифровка = ТаблицаЗнач.Документ;
		КонецЕсли;

		Если ПараметрыОтчета.ВыводитьСуммуДокументаИДельту Тогда
			ОбластьСтрока.Параметры.РегистраторСумма = ФорматированнаяСумма(РегистраторСумма);
			ОбластьСтрока.Параметры.ДельтаСуммы = ФорматированнаяСумма(ТаблицаЗнач.Сумма - РегистраторСумма);
		Иначе
			ОбластьСтрока.Параметры.РегистраторСумма = "";
			ОбластьСтрока.Параметры.ДельтаСуммы = "";
		КонецЕсли;
		
		Результат.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	Если  ЭтоПриход ТОгда
		ОбластьИтог = Макет.ПолучитьОбласть("ИтогоПриход");
		ИтогиТаблицы.Товар.Приход = ИтогТовара;
	Иначе
		ОбластьИтог = Макет.ПолучитьОбласть("ИтогоРасход");
		ОбластьИтог.Параметры.Продажа = ИтогПродажи;
		ИтогиТаблицы.Товар.Расход = ИтогТовара; 
	КонецЕсли;
	
	ЗаполнитьОбласть(ОбластьИтог.Параметры, ИтогТовара );
	
	Результат.Вывести(ОбластьИтог);
	
	Если  ЭтоПриход ТОгда
		ОбластьИтог = Макет.ПолучитьОбласть("ВсегоПриход");
		ТаблицаОстаткиИОбороты.НачальныеОстататки.Следующий();
		ОбластьИтог.Параметры.СуммаТовара = ИтогТовара + ТаблицаОстаткиИОбороты.НачальныеОстататки.СуммаОстаток;
		Результат.Вывести(ОбластьИтог);
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиИнвентаризацию(Результат, ТаблицаОстаткиИОбороты, Макет, ПараметрыОтчета, ИтогиТаблицы)
		
	// Фактический остаток
	ОбластьФактическийОстаток = Макет.ПолучитьОбласть("ФактическийОстаток");
	ТаблицаОстаткиИОбороты.КонечныеОстатки.Следующий();
	СуммаТовара = ТаблицаОстаткиИОбороты.КонечныеОстатки.СуммаОстаток;
	ЗаполнитьОбласть(ОбластьФактическийОстаток.Параметры, СуммаТовара);	
	Результат.Вывести(ОбластьФактическийОстаток);
		
	// Излишки
	ОбластьИзлишки = Макет.ПолучитьОбласть("Излишки");

	
	Если  ТаблицаОстаткиИОбороты.ИнвентаризацияПриход.Следующий() Тогда 
		СуммаТовара = ? (ЗначениеЗаполнено(ТаблицаОстаткиИОбороты.ИнвентаризацияПриход.Сумма),
						ТаблицаОстаткиИОбороты.ИнвентаризацияПриход.Сумма,
						0);
	Иначе
		СуммаТовара = 0;
	КонецЕсли;
	
	ЗаполнитьОбласть(ОбластьИзлишки.Параметры, СуммаТовара);
	Результат.Вывести(ОбластьИзлишки);
	
	// Недостача
	ОбластьНедостача = Макет.ПолучитьОбласть("Недостача");
	
	Если ТаблицаОстаткиИОбороты.ИнвентаризацияРасход.Следующий() Тогда 
		СуммаТовара = ? (ЗначениеЗаполнено(ТаблицаОстаткиИОбороты.ИнвентаризацияРасход.Сумма),
						ТаблицаОстаткиИОбороты.ИнвентаризацияРасход.Сумма,
						0);
	Иначе
		СуммаТовара = 0;
	КонецЕсли;

	ЗаполнитьОбласть(ОбластьНедостача.Параметры, СуммаТовара);
	Результат.Вывести(ОбластьНедостача);
		
КонецПроцедуры

Процедура ВывестиПодвал(Результат, ТаблицаОстаткиИОбороты, Макет, ПараметрыОтчета)
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОтветственныеЛица = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(ПараметрыОтчета.Организация, ПараметрыОтчета.ДатаОкончания);
	
	ОбластьПодвал.Параметры.РуководительПредставление 	= ОтветственныеЛица.РуководительНаименование; 
	ОбластьПодвал.Параметры.РуководительДолжность		= ОтветственныеЛица.РуководительДолжность; 
	
	ИтогоДокументов = ТаблицаОстаткиИОбороты.ДвиженияПриход.Количество() + ТаблицаОстаткиИОбороты.ДвиженияРасход.Количество(); 
	ФормСтрока = "Л = ru_RU";
	ПараметрыПредмета = "документ, документа, документов, м, , , , м, 0";
	
	ОбластьПодвал.Параметры.ИтогоДок = ЧислоПрописью(ИтогоДокументов, ФормСтрока, ПараметрыПредмета); 	
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Функция ФорматированнаяСумма(Знач Сумма)
	
	Возврат Формат(Сумма, "ЧЦ=15; ЧДЦ=2");
	
КонецФункции

// Функция используется для получения значения в столбце итого
// Параметры:
// 1 - Параметр 		- структура - "Строка" таблицы
// 2 - СписокСтолбцов	- массив	- список строк которые необходимо просуммировать  
Процедура ЗаполнитьОбласть (Параметры, СуммаТовара = 0, Специи = 0 , СуммаТары = 0)
	Параметры.СуммаТовара	= ФорматированнаяСумма(СуммаТовара);
	Параметры.Специи		= ФорматированнаяСумма(Специи);
	Параметры.СуммаТары		= ФорматированнаяСумма(СуммаТары);
	
	Итого					= Число(СуммаТовара + Специи + СуммаТары);
	Параметры.Итого 		= ФорматированнаяСумма(Итого);
КонецПроцедуры


