		Иначе
			Параметр = СтрШаблон("ОтборИсключаемыеКорНаправленияДеятельности_%1_%2_%3_%4", КодПоказателя, Графа, ИсточникДанных, ИндексОборота);
			ОтборИсключаемыеКорНаправленияДеятельности = СтрШаблон("НЕ ЕСТЬNULL(ХозрасчетныйОбороты.КорНаправлениеДеятельности, ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) В (&%1)", Параметр);
			ТекстОборот = СтрЗаменить(ТекстОборот, "&ОтборИсключаемыеКорНаправленияДеятельности", ОтборИсключаемыеКорНаправленияДеятельности);
			Запрос.УстановитьПараметр(Параметр, Оборот.Значение.ИсключаемыеКорНаправленияДеятельности);
 		КонецЕсли;

		Если Не ЗначениеЗаполнено(Оборот.Значение.ИсключаемыеНаправленияДеятельности) Тогда
			ТекстОборот = СтрЗаменить(ТекстОборот, "&ОтборИсключаемыеНаправленияДеятельности", "ИСТИНА // ИсключаемыеНаправленияДеятельности");
