Процедура ЗаполнитьПравилаДанныхЦенаКонтракта(ПериодыДетализацииУчета, ПараметрыОтчета, НовоеПравило, РасшифровкаДоОборотов)
		
	Если ПериодыДетализацииУчета.ИспользуетсяДетализация Тогда
		Если ПериодыДетализацииУчета.ДанныеСДетализацией Тогда
			
			ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
			ОтборОборотовБухгалтерскогоУчета.Счет = РеглУчетВыборкиСерверПовтИсп.СчетаВыручка();
			ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
			ОтборОборотовБухгалтерскогоУчета.НачалоПериодаДействияПравила = Макс(ПараметрыОтчета.НачалоПериода, ПериодыДетализацииУчета.НачалоПериодаДанныеСДетализацией);
			ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
		
		КонецЕсли;
		
		Если ПериодыДетализацииУчета.ДанныеБезДетализации Тогда
			
			КонецПериода = Мин(ПараметрыОтчета.КонецПериода, ПериодыДетализацииУчета.КонецПериодаБезДетализации);			
			ЗаполнитьПравилаДанныхЦенаКонтракта_БезДетализации(НовоеПравило, ПараметрыОтчета, РасшифровкаДоОборотов, КонецПериода);

		КонецЕсли;		
	Иначе
		
		ЗаполнитьПравилаДанныхЦенаКонтракта_БезДетализации(НовоеПравило, ПараметрыОтчета, РасшифровкаДоОборотов);

	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПравилаДанныхЦенаКонтракта_БезДетализации(НовоеПравило, ПараметрыОтчета, РасшифровкаДоОборотов, КонецПериода = Неопределено)

	ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
	ОтборОборотовБухгалтерскогоУчета.Счет = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД);
	ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	Если КонецПериода <> Неопределено Тогда
		ОтборОборотовБухгалтерскогоУчета.КонецПериодаДействияПравила = КонецПериода;
	КонецЕсли;
	ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	
	ИспользуетсяРаздельныйУчет = РаздельныйУчетПоНалогуНаПрибыль.ИспользуетсяРаздельныйУчет(
		ПараметрыОтчета.Организация,
		ПараметрыОтчета.КонецПериода);
	
	Если ИспользуетсяРаздельныйУчет Тогда
		ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
		ОтборОборотовБухгалтерскогоУчета.Счет = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыСчетов.Хозрасчетный.ВыручкаРаздельныйНУ);
		ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
		Если КонецПериода <> Неопределено Тогда
			ОтборОборотовБухгалтерскогоУчета.КонецПериодаДействияПравила = КонецПериода;
		КонецЕсли;
		ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	КонецЕсли;
	
КонецПроцедуры

