		ОтборОборотовБухгалтерскогоУчета.КорСчет = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Счет);
		ОтборОборотовБухгалтерскогоУчета.КорНаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.НаправленияДеятельности.ПустаяСсылка());
		Если ЗначениеЗаполнено(КонецПериода) Тогда
			ОтборОборотовБухгалтерскогоУчета.КонецПериодаДействияПравила = КонецПериода;
		КонецЕсли;
		
		Если ОтборОборотовБухгалтерскогоУчета.Субконто2.Количество() > 0 Тогда
			ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

