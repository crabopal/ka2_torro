			ОтборИсключаемыеНаправленияДеятельности = СтрШаблон("НЕ ЕСТЬNULL(ХозрасчетныйОбороты.НаправлениеДеятельности, ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) В (&%1)", Параметр);
			ТекстОборот = СтрЗаменить(ТекстОборот, "&ОтборИсключаемыеНаправленияДеятельности", ОтборИсключаемыеНаправленияДеятельности);
			Запрос.УстановитьПараметр(Параметр, Оборот.Значение.ИсключаемыеНаправленияДеятельности);
 		КонецЕсли;

		Если ЗначениеЗаполнено(Оборот.Значение.НачалоПериодаДействияПравила) Тогда
			Параметр = СтрШаблон("ОтборНачалоПериода_%1_%2_%3_%4", КодПоказателя, Графа, ИсточникДанных, ИндексОборота);
			ОтборНачалоПериода = СтрШаблон("ХозрасчетныйОбороты.Период >= &%1", Параметр);
			ТекстОборот = СтрЗаменить(ТекстОборот, "&ОтборНачалоПериода", ОтборНачалоПериода);
			Запрос.УстановитьПараметр(Параметр, Оборот.Значение.НачалоПериодаДействияПравила);
		Иначе
			ТекстОборот = СтрЗаменить(ТекстОборот, "&ОтборНачалоПериода", "ИСТИНА");
		КонецЕсли;

		Если ЗначениеЗаполнено(Оборот.Значение.КонецПериодаДействияПравила) Тогда
			Параметр = СтрШаблон("ОтборКонецПериода_%1_%2_%3_%4", КодПоказателя, Графа, ИсточникДанных, ИндексОборота);
			ОтборКонецПериода = СтрШаблон("ХозрасчетныйОбороты.Период <= &%1", Параметр);
			ТекстОборот = СтрЗаменить(ТекстОборот, "&ОтборКонецПериода", ОтборКонецПериода);
			Запрос.УстановитьПараметр(Параметр, Оборот.Значение.КонецПериодаДействияПравила);
		Иначе
			ТекстОборот = СтрЗаменить(ТекстОборот, "&ОтборКонецПериода", "ИСТИНА");
		КонецЕсли;
		
		Если Оборот.Значение.Субконто2ВидыРаботСотрудников Тогда
			ТекстОборот = СтрЗаменить(ТекстОборот, "&Отбор_Субконто2ВидыРаботСотрудников", "ТИПЗНАЧЕНИЯ(ХозрасчетныйОбороты.Субконто2) = ТИП(Справочник.ВидыРаботСотрудников)");
		Иначе
			ТекстОборот = СтрЗаменить(ТекстОборот, "&Отбор_Субконто2ВидыРаботСотрудников", "ИСТИНА");
		КонецЕсли;
		
		Если Оборот.Значение.ЭтоРабота = Неопределено Тогда
			ТекстОборот = СтрЗаменить(ТекстОборот, "&Отбор_ЭтоРабота", "ИСТИНА");
		Иначе
			Параметр = СтрШаблон("Отбор_ЭтоРабота_%1_%2_%3_%4", КодПоказателя, Графа, ИсточникДанных, ИндексОборота);
