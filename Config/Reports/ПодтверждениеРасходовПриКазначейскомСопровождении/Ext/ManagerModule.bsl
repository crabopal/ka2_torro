Процедура ЗаполнитьПравилаДанныхНДС(ПериодыДетализацииУчета, ПараметрыОтчета, НовоеПравило, ПараметрыПравилаНДС)
	
	СтавкиНДС = ПараметрыПравилаНДС.СтавкиНДС;
	НачалоПериода = ПараметрыПравилаНДС.НачалоПериода;
	КонецПериода = ПараметрыПравилаНДС.КонецПериода;
	РасшифровкаДоОборотов = ПараметрыПравилаНДС.РасшифровкаДоОборотов;
	
	Если ПериодыДетализацииУчета.ИспользуетсяДетализация Тогда
		Если ПериодыДетализацииУчета.ДанныеСДетализацией Тогда
			
			ПараметрыПравилаНДССДетализацией = ПараметрыПравилаНДС();
			ПараметрыПравилаНДССДетализацией.СтавкиНДС = СтавкиНДС;			
			ПараметрыПравилаНДССДетализацией.РасшифровкаДоОборотов = РасшифровкаДоОборотов;
			ПараметрыПравилаНДССДетализацией.НачалоПериода = Макс(НачалоПериода, ПериодыДетализацииУчета.НачалоПериодаДанныеСДетализацией);
			ПараметрыПравилаНДССДетализацией.КонецПериода = КонецПериода;
			
			ЗаполнитьПравилаДанныхНДС_СДетализацией(НовоеПравило, ПараметрыОтчета, ПараметрыПравилаНДССДетализацией);
		КонецЕсли;
		Если ПериодыДетализацииУчета.ДанныеБезДетализации Тогда
			
			ПараметрыПравилаНДСБезДетализации = ПараметрыПравилаНДС();
			ПараметрыПравилаНДСБезДетализации.СтавкиНДС = СтавкиНДС;
			ПараметрыПравилаНДСБезДетализации.РасшифровкаДоОборотов = РасшифровкаДоОборотов;
			ПараметрыПравилаНДСБезДетализации.НачалоПериода = НачалоПериода;
			
			Если ЗначениеЗаполнено(КонецПериода) Тогда
				ПараметрыПравилаНДСБезДетализации.КонецПериода = Мин(КонецПериода, ПериодыДетализацииУчета.КонецПериодаБезДетализации);
			Иначе
				ПараметрыПравилаНДСБезДетализации.КонецПериода = ПериодыДетализацииУчета.КонецПериодаБезДетализации;
			КонецЕсли;
			
			ЗаполнитьПравилаДанныхНДС_СДетализацией_УстаревшиеСчета(НовоеПравило, ПараметрыОтчета, ПараметрыПравилаНДСБезДетализации);

		КонецЕсли;		
	Иначе
		
		ЗаполнитьПравилаДанныхНДС_БезДетализации(НовоеПравило, ПараметрыОтчета, ПараметрыПравилаНДС);

	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыПравилаНДС()
	
	ПараметрыПравилаНДС = Новый Структура;
	ПараметрыПравилаНДС.Вставить("СтавкиНДС", Новый Массив);
	ПараметрыПравилаНДС.Вставить("НачалоПериода", Дата(1, 1, 1));
	ПараметрыПравилаНДС.Вставить("КонецПериода", Дата(1, 1, 1));
	ПараметрыПравилаНДС.Вставить("РасшифровкаДоОборотов", Ложь);
	
	Возврат ПараметрыПравилаНДС;
	
КонецФункции

Процедура ЗаполнитьПравилаДанныхНДС_БезДетализации(НовоеПравило, ПараметрыОтчета, ПараметрыПравилаНДС)

	СтавкиНДС = ПараметрыПравилаНДС.СтавкиНДС;
	НачалоПериода = ПараметрыПравилаНДС.НачалоПериода;
	КонецПериода = ПараметрыПравилаНДС.КонецПериода;
	РасшифровкаДоОборотов = ПараметрыПравилаНДС.РасшифровкаДоОборотов;
	
	ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
	ОтборОборотовБухгалтерскогоУчета.Счет = ПланыСчетов.Хозрасчетный.Продажи_НДС;
	ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	ОтборОборотовБухгалтерскогоУчета.Субконто2 = СтавкиНДС;
	ОтборОборотовБухгалтерскогоУчета.ТипИтогов = Перечисления.ТипыИтогов.ОборотДт;

	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		ОтборОборотовБухгалтерскогоУчета.НачалоПериодаДействияПравила = НачалоПериода;
	КонецЕсли;

	Если ЗначениеЗаполнено(КонецПериода) Тогда
		ОтборОборотовБухгалтерскогоУчета.КонецПериодаДействияПравила = КонецПериода;
	КонецЕсли;
	
	ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	
КонецПроцедуры

Процедура ЗаполнитьПравилаДанныхНДС_СДетализацией(НовоеПравило, ПараметрыОтчета, ПараметрыПравилаНДС)
		
	СтавкиНДС = ПараметрыПравилаНДС.СтавкиНДС;
	НачалоПериода = ПараметрыПравилаНДС.НачалоПериода;
	КонецПериода = ПараметрыПравилаНДС.КонецПериода;
	РасшифровкаДоОборотов = ПараметрыПравилаНДС.РасшифровкаДоОборотов;
		
	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода) 
		И НачалоПериода >= КонецПериода Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияСтавокНДС = Новый Массив;
	
	Для Каждого СтавкаНДС Из СтавкиНДС Цикл
		ЗначениеСтавкиНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(СтавкаНДС);
		
		Если ЗначениеЗаполнено(ЗначениеСтавкиНДС) Тогда
			ЗначенияСтавокНДС.Добавить(ЗначениеСтавкиНДС);
		КонецЕсли;
	КонецЦикла;
	
	НалогообложенияРеализацийПоСтавкамНДС = Справочники.ВариантыНалогообложенияРеализации.ВариантыНалогообложенияПоСтавкамНДС(ЗначенияСтавокНДС);
	
	ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
	ОтборОборотовБухгалтерскогоУчета.Счет = РеглУчетВыборкиСерверПовтИсп.СчетаПродажи_НДС();
	ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	ОтборОборотовБухгалтерскогоУчета.Субконто2 = НалогообложенияРеализацийПоСтавкамНДС;
	ОтборОборотовБухгалтерскогоУчета.ТипИтогов = Перечисления.ТипыИтогов.ОборотДт;
	ОтборОборотовБухгалтерскогоУчета.НачалоПериодаДействияПравила = НачалоПериода;
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		ОтборОборотовБухгалтерскогоУчета.КонецПериодаДействияПравила = КонецПериода;
	КонецЕсли;
	
	Если НалогообложенияРеализацийПоСтавкамНДС.Количество() > 0 Тогда
		ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПравилаДанныхНДС_СДетализацией_УстаревшиеСчета(НовоеПравило, ПараметрыОтчета, ПараметрыПравилаНДС)
	
	СтавкиНДС = ПараметрыПравилаНДС.СтавкиНДС;
	НачалоПериода = ПараметрыПравилаНДС.НачалоПериода;
	КонецПериода = ПараметрыПравилаНДС.КонецПериода;
	РасшифровкаДоОборотов = ПараметрыПравилаНДС.РасшифровкаДоОборотов;

	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода) 
		И НачалоПериода >= КонецПериода Тогда
		Возврат;
	КонецЕсли;

	ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
	ОтборОборотовБухгалтерскогоУчета.Счет = РеглУчетВыборкиСерверПовтИсп.УстаревшиеСчетаПродажи_НДС();
	ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	ОтборОборотовБухгалтерскогоУчета.Субконто2 = СтавкиНДС;
	ОтборОборотовБухгалтерскогоУчета.ТипИтогов = Перечисления.ТипыИтогов.ОборотДт;
	ОтборОборотовБухгалтерскогоУчета.КонецПериодаДействияПравила = КонецПериода;

	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		ОтборОборотовБухгалтерскогоУчета.НачалоПериодаДействияПравила = НачалоПериода;
	КонецЕсли;

	ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	
КонецПроцедуры

