	ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	
КонецПроцедуры

#КонецОбласти

#Область ИныеВыплаты

Процедура ЗаполнитьПравилаДанныхИныеВыплаты(ПериодыДетализацииУчета, ПараметрыОтчета, НовоеПравило, РасшифровкаДоОборотов)
		
	Если ПериодыДетализацииУчета.ИспользуетсяДетализация Тогда
		Если ПериодыДетализацииУчета.ДанныеСДетализацией Тогда
			
			СчетаПроизводства = Новый Массив;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаПроизводства, 
				РеглУчетВыборкиСерверПовтИсп.СчетаРасходыОсновногоПроизводстваКРаспределению());
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаПроизводства, 
				РеглУчетВыборкиСерверПовтИсп.СчетаРасходыВспомогательныхПроизводствКРаспределению());

			ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
			ОтборОборотовБухгалтерскогоУчета.ТипИтогов = Перечисления.ТипыИтогов.ОборотДт;
			ОтборОборотовБухгалтерскогоУчета.Счет = СчетаПроизводства;
			ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
			ОтборОборотовБухгалтерскогоУчета.Субконто1 = СтатьиРасходовСтатьяКалькуляцииУчитываетсяГОЗ();
			ОтборОборотовБухгалтерскогоУчета.ВыводитьСубконтовВПредставление = Ложь;
			ОтборОборотовБухгалтерскогоУчета.КорСчет = ПланыСчетов.Хозрасчетный.РасчетыСПодотчетнымиЛицами_;
			ОтборОборотовБухгалтерскогоУчета.КорНаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.НаправленияДеятельности.ПустаяСсылка());
			ОтборОборотовБухгалтерскогоУчета.НачалоПериодаДействияПравила = Макс(ПараметрыОтчета.НачалоПериода, ПериодыДетализацииУчета.НачалоПериодаДанныеСДетализацией);
			Если ОтборОборотовБухгалтерскогоУчета.Субконто1.Количество() > 0 Тогда
				ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
			КонецЕсли;
		КонецЕсли;

		Если ПериодыДетализацииУчета.ДанныеБезДетализации Тогда
			СчетаПроизводства = Новый Массив;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаПроизводства, 
				РеглУчетВыборкиСерверПовтИсп.УстаревшиеСчетаОсновноеПроизводство());
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаПроизводства, 
				РеглУчетВыборкиСерверПовтИсп.УстаревшиеСчетаВспомогательныеПроизводства());
			
			ПараметрыПравила = ПараметрыПравилаЗатратыПроизводства();
			ПараметрыПравила.СчетаПроизводства = СчетаПроизводства;
			ПараметрыПравила.РасшифровкаДоОборотов = РасшифровкаДоОборотов;
			ПараметрыПравила.КонецПериода = Мин(ПараметрыОтчета.КонецПериода, ПериодыДетализацииУчета.КонецПериодаБезДетализации);
			
			ЗаполнитьПравилаДанныхИныеВыплатыБезДетализации(ПараметрыПравила, ПараметрыОтчета, НовоеПравило);
		КонецЕсли;
		
		ПараметрыПравила = ПараметрыПравилаЗатратыПроизводства();
		ПараметрыПравила.СчетаПроизводства = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыСчетов.Хозрасчетный.ОбслуживающиеПроизводства);
		ПараметрыПравила.РасшифровкаДоОборотов = РасшифровкаДоОборотов;
		
		ЗаполнитьПравилаДанныхИныеВыплатыБезДетализации(ПараметрыПравила, ПараметрыОтчета, НовоеПравило);
		
	Иначе
	
		СчетаПроизводства = Новый Массив;
		СчетаПроизводства.Добавить(ПланыСчетов.Хозрасчетный.ОсновноеПроизводство);
		СчетаПроизводства.Добавить(ПланыСчетов.Хозрасчетный.ВспомогательныеПроизводства);
		СчетаПроизводства.Добавить(ПланыСчетов.Хозрасчетный.ОбслуживающиеПроизводства);
		
		ПараметрыПравила = ПараметрыПравилаЗатратыПроизводства();
		ПараметрыПравила.СчетаПроизводства = СчетаПроизводства;
		ПараметрыПравила.РасшифровкаДоОборотов = РасшифровкаДоОборотов;
		
		ЗаполнитьПравилаДанныхИныеВыплатыБезДетализации(ПараметрыПравила, ПараметрыОтчета, НовоеПравило);
		
	КонецЕсли;

	КоррСчета = СчетаРасчетовСПоставщиками();

	ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
	ОтборОборотовБухгалтерскогоУчета.ТипИтогов = Перечисления.ТипыИтогов.ОборотДт;
	ОтборОборотовБухгалтерскогоУчета.Счет = ПланыСчетов.Хозрасчетный.ПрочиеРасходы;
	ОтборОборотовБухгалтерскогоУчета.Субконто1 = СтатьиРасходовУчитываетсяГОЗ();
	ОтборОборотовБухгалтерскогоУчета.ВыводитьСубконтовВПредставление = Ложь;
	ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	ОтборОборотовБухгалтерскогоУчета.КорСчет = КоррСчета;
	ОтборОборотовБухгалтерскогоУчета.КорНаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	Если ОтборОборотовБухгалтерскогоУчета.Субконто1.Количество() > 0 Тогда
		ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	КонецЕсли;

	ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
	ОтборОборотовБухгалтерскогоУчета.ТипИтогов = Перечисления.ТипыИтогов.ОборотДт;
	ОтборОборотовБухгалтерскогоУчета.Счет = ПланыСчетов.Хозрасчетный.ПрочиеРасходы;
	ОтборОборотовБухгалтерскогоУчета.Субконто1 = СтатьиРасходовУчитываетсяГОЗ();
	ОтборОборотовБухгалтерскогоУчета.ВыводитьСубконтовВПредставление = Ложь;
	ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	ОтборОборотовБухгалтерскогоУчета.КорСчет = КоррСчета;
	ОтборОборотовБухгалтерскогоУчета.КорНаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.НаправленияДеятельности.ПустаяСсылка());
	Если ОтборОборотовБухгалтерскогоУчета.Субконто1.Количество() > 0 Тогда
		ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПравилаДанныхИныеВыплатыБезДетализации(ПараметрыПравила, ПараметрыОтчета, НовоеПравило)
	
	СчетаПроизводства = ПараметрыПравила.СчетаПроизводства;
	РасшифровкаДоОборотов = ПараметрыПравила.РасшифровкаДоОборотов;
	КонецПериода = ПараметрыПравила.КонецПериода;
	
	ОтборОборотовБухгалтерскогоУчета = ОтборОборотовБухгалтерскогоУчета();
	ОтборОборотовБухгалтерскогоУчета.ТипИтогов = Перечисления.ТипыИтогов.ОборотДт;
	ОтборОборотовБухгалтерскогоУчета.Счет = СчетаПроизводства;
	ОтборОборотовБухгалтерскогоУчета.НаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОтчета.НаправлениеДеятельности);
	ОтборОборотовБухгалтерскогоУчета.Субконто2 = СтатьиРасходовСтатьяКалькуляцииУчитываетсяГОЗ();
	ОтборОборотовБухгалтерскогоУчета.ВыводитьСубконтовВПредставление = Ложь;
	ОтборОборотовБухгалтерскогоУчета.КорСчет = ПланыСчетов.Хозрасчетный.РасчетыСПодотчетнымиЛицами_;
	ОтборОборотовБухгалтерскогоУчета.КорНаправлениеДеятельности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.НаправленияДеятельности.ПустаяСсылка());
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		ОтборОборотовБухгалтерскогоУчета.КонецПериодаДействияПравила = КонецПериода;
	КонецЕсли;

	Если ОтборОборотовБухгалтерскогоУчета.Субконто2.Количество() > 0 Тогда
		ДобавитьОборотыБухгалтерскогоУчета(НовоеПравило, ОтборОборотовБухгалтерскогоУчета, РасшифровкаДоОборотов);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЗакупкаАктивовМатериалов

Процедура ЗаполнитьПравилаДанныхЗакупкаАктивовМатериалов(ПериодыДетализацииУчета, ПараметрыОтчета, НовоеПравило, РасшифровкаДоОборотов)
			
	СчетаАктивов = СчетаАктивов();
	СчетаАктивовИГотовойПродукции = СчетаАктивовИГотовойПродукции();
	СчетаРасчетовСПоставщиками = СчетаРасчетовСПоставщиками();
	СчетаМатериаловТоваровГотовойПродукции = СчетаМатериаловТоваровГотовойПродукции();
	
	Если ПериодыДетализацииУчета.ИспользуетсяДетализация Тогда
		Если ПериодыДетализацииУчета.ДанныеСДетализацией Тогда
			
			//Дт 20.01 (23.01) НД Кт 07, 08.04.1, 10.01 – 10.06, 10.08 - 10.10, 21, 41, 43 Без НД
			Счета = Новый Массив;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Счета, 
				РеглУчетВыборкиСерверПовтИсп.СчетаМатериалыПодрядныеРаботыОсновногоПроизводстваКИспользованию());
