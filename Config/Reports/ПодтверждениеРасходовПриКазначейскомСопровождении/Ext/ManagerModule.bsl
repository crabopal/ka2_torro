	НовоеПравило.Заголовок = НСтр("ru = 'Цена государственного (муниципального) контракта, договора (соглашения), контракта (договора)'");
	НовоеПравило.ЭтоГруппа = Истина;

	НовоеПравило = ПравилаРасчетаПоказателей.Добавить(); 
