#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//  Форма - УправляемаяФорма - Форма отчета.
//  КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//  Настройки - Произвольный - Настройки.
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере = Истина;
	
КонецПроцедуры

// Вызывается в одноименном обработчике формы отчета после выполнения кода формы.
//  Подробнее - см. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  НовыеНастройкиКД - Произвольный - Новые настройки кд.
//
Процедура ПередЗагрузкойВариантаНаСервере(ЭтаФорма, НовыеНастройкиКД) Экспорт
	
	Отчет = ЭтаФорма.Отчет;
	КомпоновщикНастроекФормы = Отчет.КомпоновщикНастроек;
	
	// Изменение настроек по функциональным опциям
	НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы);
	
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	
	// +пит
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// -пит
	
	КомпоновщикНастроекФормы = ЭтаФорма.Отчет.КомпоновщикНастроек;
	Параметры = ЭтаФорма.Параметры;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Процедура - При компоновке результата.
//
// Параметры:
//  ДокументРезультат - Произвольный - Документ результат.
//  ДанныеРасшифровки - Произвольный - Данные расшифровки.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПользовательскиеНастройкиМодифицированы = Ложь;
	
	УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы);
	
	// Стандартная компоновка отчета.
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	// +пит
	// Получение таблицы периодов с дополнением
	ТекущаяСхемаКомпоновкиДанных = ПолучитьМакет("ОстаткиСДополнением");
	
	ТекущийКомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	ТекущийКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ТекущаяСхемаКомпоновкиДанных));
	ТекущийКомпоновщикНастроек.ЗагрузитьНастройки(ТекущаяСхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	ТекущиеНастройки = ТекущийКомпоновщикНастроек.Настройки;
	
	// Установка параметров из основной СКД.
	ТекущиеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("Склады",			КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Склады").Значение);
	ТекущиеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода",	КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПериодОтчета").Значение.ДатаНачала);
	ТекущиеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода",	КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПериодОтчета").Значение.ДатаОкончания);
	
	// Перенос отбора по номенклатуре.
	ОтборПольз = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти("39c0e302-b661-49a2-beb7-ddb2b6d1baae");
	Если НЕ ОтборПольз = Неопределено Тогда
		Для каждого ТекОтбор Из ТекущиеНастройки.Отбор.Элементы Цикл
			Если ТекОтбор.ИдентификаторПользовательскойНастройки = "2446e31a-0532-44e2-8817-616ba3ab21f1" Тогда
				ТекОтбор.Использование  = ОтборПольз.Использование;
				ТекОтбор.ВидСравнения   = ОтборПольз.ВидСравнения;
				ТекОтбор.ПравоеЗначение = ОтборПольз.ПравоеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТекущиеДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	ТекущийКомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ТекущийМакетКомпоновки   = ТекущийКомпоновщикМакета.Выполнить(ТекущаяСхемаКомпоновкиДанных, ТекущиеНастройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ТекущийПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ТекущийПроцессорКомпоновки.Инициализировать(ТекущийМакетКомпоновки, , ТекущиеДанныеРасшифровки, Истина);
	
	ТекущийРезультат = Новый ТаблицаЗначений;
	ТекущийПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТекущийПроцессорВывода.УстановитьОбъект(ТекущийРезультат);
	ТекущийПроцессорВывода.Вывести(ТекущийПроцессорКомпоновки);
	
	// Удаление строк группировки верхнего уровня.
	СтрокиУдалить = ТекущийРезультат.НайтиСтроки(Новый Структура("Период", Неопределено));
	Для каждого ТекСтрокаУдалить Из СтрокиУдалить Цикл
		ТекущийРезультат.Удалить(ТекСтрокаУдалить);
	КонецЦикла;
	
// 
// 	// ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////.
//   Получаем текст запроса из служебной СКД и подменяем в нем получение остатков на таблицу, полученную на предыдущем
// шаге.
	
	ОбъектЗапрос = Новый Запрос;
	
	ТекущаяСхемаКомпоновкиДанных = ПолучитьМакет("СхемаКомпоновкиДанных");
	ТекущийТекстЗапроса = ТекущаяСхемаКомпоновкиДанных.НаборыДанных.Основной.Запрос;
	
	// Удаляем текст запроса
	ПакетыЗапросаМассив = СтрРазделить(ТекущийТекстЗапроса, ";");
	ТекущиеСтрокиПоискаУдалить = Новый Массив;
	ТекущиеСтрокиПоискаУдалить.Добавить("ПОМЕСТИТЬ втНоменклатура");
	ТекущиеСтрокиПоискаУдалить.Добавить("ПОМЕСТИТЬ втКлючи");
	ТекущиеСтрокиПоискаУдалить.Добавить("УНИЧТОЖИТЬ втНоменклатура");
	ТекущиеСтрокиПоискаУдалить.Добавить("ПОМЕСТИТЬ втОстатки");
	Для каждого ТекущаяСтрокаПоиска Из ТекущиеСтрокиПоискаУдалить Цикл
		ТекущийИндекс = 0;
		Для каждого ТекущийТекстПакета Из ПакетыЗапросаМассив Цикл
			Если СтрНайти(ТекущийТекстПакета, ТекущаяСтрокаПоиска) Тогда
				ПакетыЗапросаМассив.Удалить(ТекущийИндекс);
				Прервать;
			КонецЕсли;
			ТекущийИндекс = ТекущийИндекс + 1;
		КонецЦикла;
	КонецЦикла;
	// Новый текст запроса
	НовыйТекстПакета = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СебестоимостьТоваровОстаткиИОбороты.Период КАК Период,
		|	СебестоимостьТоваровОстаткиИОбороты.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	СебестоимостьТоваровОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		|	СебестоимостьТоваровОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
		|ПОМЕСТИТЬ втОстатки
		|ИЗ
		|	&тзОстатки КАК СебестоимостьТоваровОстаткиИОбороты
		|";
	ПакетыЗапросаМассив.Вставить(0, НовыйТекстПакета);
	НовыйТекстПакета = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КлючиАналитикиУчетаНоменклатуры.Ссылка КАК АналитикаУчетаНоменклатуры,
		|	КлючиАналитикиУчетаНоменклатуры.МестоХранения КАК Склад,
		|	КлючиАналитикиУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	КлючиАналитикиУчетаНоменклатуры.Характеристика КАК Характеристика,
		|	КлючиАналитикиУчетаНоменклатуры.Назначение КАК Назначение,
		|	КлючиАналитикиУчетаНоменклатуры.Серия КАК Серия,
		|	КлючиАналитикиУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	КлючиАналитикиУчетаНоменклатуры.Номенклатура.ЕдиницаДляОтчетов КАК ЕдиницаДляОтчетов,
		|	КлючиАналитикиУчетаНоменклатуры.Номенклатура.КоэффициентЕдиницыДляОтчетов КАК КоэффициентЕдиницыДляОтчетов
		|ПОМЕСТИТЬ втКлючи
		|ИЗ
		|	Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
		|ГДЕ
		|	КлючиАналитикиУчетаНоменклатуры.Ссылка В
		|			(ВЫБРАТЬ
		|				втОстатки.АналитикаУчетаНоменклатуры
		|			ИЗ
		|				втОстатки КАК втОстатки)
		|	И КлючиАналитикиУчетаНоменклатуры.МестоХранения В(&Склады)
		|";
	ПакетыЗапросаМассив.Вставить(1, НовыйТекстПакета);
	
	// +Цены номенклатуры
	ПериодЦен = ТекущаяДата();
	Для каждого ПараметрыДанныхСКД Из НастройкиОтчета.ПараметрыДанных.Элементы Цикл
		Если ПараметрыДанныхСКД.Использование И ПараметрыДанныхСКД.Параметр = Новый ПараметрКомпоновкиДанных("ПериодОтчета") Тогда
			ПериодЦен = ПараметрыДанныхСКД.Значение.ДатаОкончания;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапросаЦеныКомплексныйОтбор = питЦеныНоменклатуры.ПреобразоватьТекстКомплексногоОтбора(
		ПериодЦен,
		"(Номенклатура, Характеристика) В
		|					(ВЫБРАТЬ
		|						втКлючи.Номенклатура,
		|						втКлючи.Характеристика
		|					ИЗ
		|						втКлючиОрганизацииБезЦен КАК втКлючи)");
	ТекстЗапросаЦены = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ПериодЦен, 
		"втЦеныНоменклатуры", "", "", "", "НормативныйВидЦен", ТекстЗапросаЦеныКомплексныйОтбор, Истина);
	
	ТекущийИндекс = 0;
	Для ТекущийИндекс = 0 По ПакетыЗапросаМассив.Количество() - 1 Цикл
		ПакетыЗапросаМассив[ТекущийИндекс] = СтрЗаменить(ПакетыЗапросаМассив[ТекущийИндекс],
			"втКлючиОрганизации.Характеристика = ЦеныНоменклатуры.Характеристика",
			питЦеныНоменклатуры.УсловиеСоединенияХарактеристика(ПериодЦен, 
				"втКлючиОрганизации", "Характеристика", "ЦеныНоменклатуры"));
	КонецЦикла;
	ТекущаяСтрокаПоиска = "ПОМЕСТИТЬ втКлючиОрганизацииБезЦенСПериодом";
	Для ТекущийИндекс = 0 По ПакетыЗапросаМассив.Количество() - 1 Цикл
		ТекущийТекстПакета = ПакетыЗапросаМассив[ТекущийИндекс];
		Если СтрНайти(ТекущийТекстПакета, ТекущаяСтрокаПоиска) Тогда
			ПакетыЗапросаМассив.Вставить(ТекущийИндекс, ТекстЗапросаЦены);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// -Цены номенклатуры
	
	ТекущийТекстЗапроса = СтрСоединить(ПакетыЗапросаМассив, ";");
	
	ТекущийТекстЗапроса = СтрЗаменить(ТекущийТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковки1",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
		"ЦеныНоменклатуры.Упаковка",
		"ЦеныНоменклатуры.Номенклатура"));
	
	ОбъектЗапрос.Текст = ТекущийТекстЗапроса;
	ОбъектЗапрос.УстановитьПараметр("тзОстатки", ТекущийРезультат);
	Для каждого ТекНастройкаОтчета Из НастройкиОтчета.ПараметрыДанных.Элементы Цикл
		ТекИмяПараметра = Строка(ТекНастройкаОтчета.Параметр);
		Если ТекИмяПараметра = "ПериодОтчета" Тогда
			ОбъектЗапрос.УстановитьПараметр("НачалоПериода", ТекНастройкаОтчета.Значение.ДатаНачала);
			ОбъектЗапрос.УстановитьПараметр("КонецПериода", ТекНастройкаОтчета.Значение.ДатаОкончания);
		КонецЕсли;
		ОбъектЗапрос.УстановитьПараметр(ТекИмяПараметра, ТекНастройкаОтчета.Значение);
	КонецЦикла;
	ТаблицаРезультат = ОбъектЗапрос.Выполнить().Выгрузить();
	// -пит
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
	
	КомпоновкаДанныхСервер.УстановитьЗаголовкиМакетаКомпоновки(СтруктураЗаголовковПолейЕдиницИзмерений(), МакетКомпоновки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Новый Структура("ТаблицаРезультат", ТаблицаРезультат), ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	КомпоновкаДанныхСервер.СкрытьВспомогательныеПараметрыОтчета(СхемаКомпоновкиДанных, КомпоновщикНастроек, ДокументРезультат, ВспомогательныеПараметрыОтчета());
	
	// Сообщим форме отчета, что настройки модифицированы
	Если ПользовательскиеНастройкиМодифицированы Тогда
		КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПользовательскиеНастройкиМодифицированы", Истина);
	КонецЕсли;
	
	питЦентрМониторинга.ЗаписатьОперацииБизнесСтатистики(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
// Процедура - Установить обязательные настройки.
//
// Параметры:
//  ПользовательскиеНастройкиМодифицированы - Произвольный - Пользовательские настройки модифицированы.
//
Процедура УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы)
	
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НормативныйВидЦен", питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит"));
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
	
КонецПроцедуры

// Функция - Вспомогательные параметры отчета.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВспомогательныеПараметрыОтчета()
	
	ВспомогательныеПараметры = Новый Массив;
	
	ВспомогательныеПараметры.Добавить("КоличественныеИтогиПоЕдИзм");
	
	КомпоновкаДанныхСервер.ДобавитьВспомогательныеПараметрыОтчетаПоФункциональнымОпциям(ВспомогательныеПараметры);
	
	Возврат ВспомогательныеПараметры;

КонецФункции

// Функция - Структура заголовков полей единиц измерений.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция СтруктураЗаголовковПолейЕдиницИзмерений()
	
	Возврат КомпоновкаДанныхСервер.ЗаголовкиПолейЕдиницИзмерений(КомпоновщикНастроек);
	
КонецФункции

// Процедура - Настроить параметры отборы по функциональным опциям.
//
// Параметры:
//  КомпоновщикНастроекФормы - Произвольный - Компоновщик настроек формы.
//
Процедура НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЕдиницыИзмеренияДляОтчетов") Тогда
		КомпоновкаДанныхСервер.УдалитьПараметрИзПользовательскихНастроекОтчета(КомпоновщикНастроекФормы, "ЕдиницыКоличества");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли




