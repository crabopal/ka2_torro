#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//  Форма - УправляемаяФорма - Форма отчета.
//  КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//  Настройки - Произвольный - Настройки.
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере = Истина;
	
КонецПроцедуры

// Вызывается в одноименном обработчике формы отчета после выполнения кода формы.
//  Подробнее - см. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  НовыеНастройкиКД - Произвольный - Новые настройки кд.
//
Процедура ПередЗагрузкойВариантаНаСервере(ЭтаФорма, НовыеНастройкиКД) Экспорт
	
	Отчет = ЭтаФорма.Отчет;
	КомпоновщикНастроекФормы = Отчет.КомпоновщикНастроек;
	
	// Изменение настроек по функциональным опциям
	НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы);
	
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	
	// +пит
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// -пит
	
	КомпоновщикНастроекФормы = ЭтаФорма.Отчет.КомпоновщикНастроек;
	Параметры = ЭтаФорма.Параметры;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Процедура - При компоновке результата.
//
// Параметры:
//  ДокументРезультат - Произвольный - Документ результат.
//  ДанныеРасшифровки - Произвольный - Данные расшифровки.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПользовательскиеНастройкиМодифицированы = Ложь;
	
	УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы);
	
	// Стандартная компоновка отчета.
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных.Основной.Запрос;
	
	СхемаКомпоновкиДанных.НаборыДанных.Основной.Запрос = ТекстЗапроса;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	// +пит
	ВывестиДерево = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ВывестиДерево").Значение;
	Если ВывестиДерево Тогда
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
	Иначе
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	КонецЕсли;
	// -пит
	
	КомпоновкаДанныхСервер.УстановитьЗаголовкиМакетаКомпоновки(СтруктураЗаголовковПолейЕдиницИзмерений(), МакетКомпоновки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	// +пит
	Если ВывестиДерево Тогда
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Иначе
		ПараметрыОтчета = ПодготовитьПараметрыОтчета(ДокументРезультат);
		
		// В качестве результата получим дерево значений
		Результат = Новый ДеревоЗначений;
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(Результат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
		ВывестиОтчет(ПараметрыОтчета, КомпоновщикНастроек, Результат);
	КонецЕсли;
	// -пит
	
	КомпоновкаДанныхСервер.СкрытьВспомогательныеПараметрыОтчета(СхемаКомпоновкиДанных, КомпоновщикНастроек, ДокументРезультат, ВспомогательныеПараметрыОтчета());
	
	// Сообщим форме отчета, что настройки модифицированы
	Если ПользовательскиеНастройкиМодифицированы Тогда
		КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПользовательскиеНастройкиМодифицированы", Истина);
	КонецЕсли;
	
	питЦентрМониторинга.ЗаписатьОперацииБизнесСтатистики(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
// Процедура - Установить обязательные настройки.
//
// Параметры:
//  ПользовательскиеНастройкиМодифицированы - Произвольный - Пользовательские настройки модифицированы.
//
Процедура УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы)
	
КонецПроцедуры

// Функция - Вспомогательные параметры отчета.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВспомогательныеПараметрыОтчета()
	
	ВспомогательныеПараметры = Новый Массив;
	
	ВспомогательныеПараметры.Добавить("КоличественныеИтогиПоЕдИзм");
	
	КомпоновкаДанныхСервер.ДобавитьВспомогательныеПараметрыОтчетаПоФункциональнымОпциям(ВспомогательныеПараметры);
	
	Возврат ВспомогательныеПараметры;

КонецФункции

// Функция - Структура заголовков полей единиц измерений.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция СтруктураЗаголовковПолейЕдиницИзмерений()
	
	Возврат КомпоновкаДанныхСервер.ЗаголовкиПолейЕдиницИзмерений(КомпоновщикНастроек);
	
КонецФункции

// Процедура - Настроить параметры отборы по функциональным опциям.
//
// Параметры:
//  КомпоновщикНастроекФормы - Произвольный - Компоновщик настроек формы.
//
Процедура НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЕдиницыИзмеренияДляОтчетов") Тогда
		КомпоновкаДанныхСервер.УдалитьПараметрИзПользовательскихНастроекОтчета(КомпоновщикНастроекФормы, "ЕдиницыКоличества");
	КонецЕсли;
	
КонецПроцедуры

// +пит
//  Процедура выводит результат в унифицированную форму "ОП6"
//
// Параметры:
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//  КомпоновщикНастроек - Произвольный - Компоновщик настроек.
//  ДеревоРезультата - ДеревоЗначений - Дерево результата.
//
Процедура ВывестиОтчет(ПараметрыОтчета,КомпоновщикНастроек,ДеревоРезультата)
	
	ПроизведенРасчетСебестоимости = питОтчеты.ПроизведенРасчетСебестоимостиПоДатеОрганизации(ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.Организация);
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДокументРезультат = ПараметрыОтчета.ДокументРезультат;
	// Получим макеты для результата и оформления
	МакетОтчета = ПолучитьМакет("ОП6");
	
	ДокументРезультат.Очистить();
	
	// Вывод заголовка отчета
	ОбластьЗаголовка = СформироватьЗаголовок(ПараметрыОтчета);
	ВысотаЗаголовка = ОбластьЗаголовка.ВысотаТаблицы;
	ДокументРезультат.Вывести(ОбластьЗаголовка, 1);
	
	// Готовим области
	ОбластьЗаголовок = МакетОтчета.ПолучитьОбласть("ЗаголовокТаблицы");
	ОбластьШапка = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока = МакетОтчета.ПолучитьОбласть("Строка");
	ОбластьИтог = МакетОтчета.ПолучитьОбласть("Итог");
	ОбластьОборот = МакетОтчета.ПолучитьОбласть("Оборот");
	ОбластьПодвал = МакетОтчета.ПолучитьОбласть("Подвал");
	
	Отпустил = "";
	ОтпустилДолжность = "";
	Принял = "";
	ПринялДолжность = "";
	МОЛ = "";
	МОЛДолжность = "";
	
	Если  НЕ ЗначениеЗаполнено(ПараметрыОтчета.Организация) Тогда
		ВыводитьЗаголовок = Истина;
	Иначе
		// Выводим заголовок
		ОбластьЗаголовок.Параметры.НомерДок = ПараметрыОтчета.НомерОтчета;
		ОбластьЗаголовок.Параметры.ДатаДок = ПолучитьОперативнуюОтметкуВремени();
		СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ПараметрыОтчета.Организация, ОбластьЗаголовок.Параметры.ДатаДок);
		ТекстОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,");
		Если ПустаяСтрока(ТекстОрганизации) Тогда
			ТекстОрганизации = СведенияОбОрганизации.Представление;
		КонецЕсли;
		ОбластьЗаголовок.Параметры.Организация=ТекстОрганизации;
		ОбластьЗаголовок.Параметры.КодПоОКПО = ПараметрыОтчета.Организация.КодПоОКПО;
		// Чтение значения для директора
		Руководители = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(ПараметрыОтчета.Организация, КонецДня(ПараметрыОтчета.НачалоПериода));
		ОбластьЗаголовок.Параметры.Бухгалтер = Руководители.ГлавныйБухгалтерНаименование;
		ОбластьЗаголовок.Параметры.Руководитель = Руководители.РуководительНаименование;
		ОбластьЗаголовок.Параметры.Должность = Руководители.РуководительДолжность;
		// запоним склады
		ОбластьЗаголовок.Параметры.Склад=ПараметрыОтчета.СкладОтправитель;
		ОбластьЗаголовок.Параметры.СкладПолучатель=ПараметрыОтчета.СкладПолучатель;
		// получим МОЛ
		Если ЗначениеЗаполнено(ПараметрыОтчета.СкладОтправитель) Тогда
			ВыбМОЛ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.СкладОтправитель, "ТекущийОтветственный");
		Иначе
			ВыбМОЛ = Справочники.ФизическиеЛица.ПустаяСсылка();
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыбМОЛ) Тогда
			ОбластьЗаголовок.Параметры.МОЛ = ВыбМОЛ;
			ОбластьЗаголовок.Параметры.МОЛДолжность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.СкладОтправитель, "ТекущаяДолжностьОтветственного");
		КонецЕсли;
		ДокументРезультат.Вывести(ОбластьЗаголовок);
		ВыводитьЗаголовок = Ложь;
	КонецЕсли;
	
	// Создадим структуру таблиц
	ТаблицаПеремещений = Новый ТаблицаЗначений;
	ТаблицаВозвратов = Новый ТаблицаЗначений;
	ИнициализацияТаблиц(ТаблицаПеремещений,ТаблицаВозвратов);
	ТаблицаПериодов = ПолучитьТаблицуПериодов(ДеревоРезультата);
	// В качестве результата имеем дерево значений.
	// Обходим строки дерева значений.
	Для Каждого СтрокаОрганизации Из  ДеревоРезультата.Строки Цикл
		Попытка
			текОрганизация = СтрокаОрганизации.Организация;
		Исключение
			текОрганизация = ПараметрыОтчета.Организация;
		КонецПопытки;
		
		Если  текОрганизация = Неопределено Тогда
			Продолжить;
		Иначе
			Для Каждого СтрокаНоменклатурыХарактеристики Из СтрокаОрганизации.Строки Цикл
				Для Каждого СтрокаНоменклатуры Из СтрокаНоменклатурыХарактеристики.Строки Цикл
					МассивПериода = ТаблицаПериодов.ВыгрузитьКолонку("Период");
					Для Каждого СтрокаПериода Из СтрокаНоменклатуры.Строки Цикл
						СтрокаВТаблицеПериода = ТаблицаПериодов.Найти(СтрокаПериода.ПериодМинуты,"Период");
						// Если не возврат, добавим в перемещения
						СтрокаПеремещений = ТаблицаПеремещений.Добавить();
						Попытка
							СтрокаПеремещений.Организация = СтрокаПериода.Организация;
						Исключение
							СтрокаПеремещений.Организация = ПараметрыОтчета.Организация;
						КонецПопытки;
						СтрокаПеремещений.Номенклатура = СтрокаПериода.Номенклатура;
						СтрокаПеремещений.Характеристика = СтрокаПериода.Характеристика;
						СтрокаПеремещений.Время = СтрокаПериода.ПериодМинуты;
						СтрокаПеремещений.Возврат = (СтрокаПериода.Возврат = 1);
						Количество = ?(СтрокаПериода.Количество = NULL, 0, СтрокаПериода.Количество);
						СтрокаПеремещений.Количество = Количество;
						
						ТекущаяЕдиницаИзмерения = ?(ПараметрыОтчета.ЕдиницыКоличества, СтрокаПериода.ЕдиницаДляОтчетов, СтрокаПериода.ЕдиницаХранения);
						Если НЕ ПроизведенРасчетСебестоимости Тогда
							ЦенаНорм		= питПроизводство.ПолучитьСтоимостьИнгредиента(СтрокаПериода.Номенклатура, ПараметрыОтчета.ВидЦенНорм, ПараметрыОтчета.НачалоПериода, ВалютаРегламентированногоУчета , ,,,, ТекущаяЕдиницаИзмерения, СтрокаПериода.Характеристика);
							СтрокаПеремещений.Сумма = ЦенаНорм * СтрокаПеремещений.Количество;
						Иначе
							СтрокаПеремещений.Сумма = СтрокаПериода.Сумма;
						КонецЕсли;
						
						ЦенаРозн = питПроизводство.ПолучитьСтоимостьИнгредиента(СтрокаПериода.Номенклатура, ПараметрыОтчета.ВидЦенРозн, ПараметрыОтчета.НачалоПериода, ВалютаРегламентированногоУчета , ,,,, ТекущаяЕдиницаИзмерения, СтрокаПериода.Характеристика);
						СтрокаПеремещений.СуммаРозн = ЦенаРозн*Количество;
						СтрокаПеремещений.ИндексСтраницы = СтрокаВТаблицеПериода.Страница;
						СтрокаПеремещений.ИндексКолонки = СтрокаВТаблицеПериода.Колонка;
						
						Для Каждого СтрокаВозврата Из СтрокаПериода.Строки Цикл
							// Добавим в возвраты
							Если СтрокаВозврата.Возврат = 1 Тогда
								СтрокаВозврат = ТаблицаВозвратов.Добавить();
								Попытка
									СтрокаВозврат.Организация = СтрокаВозврата.Организация;
								Исключение
									СтрокаВозврат.Организация = ПараметрыОтчета.Организация;
								КонецПопытки;
								СтрокаВозврат.Номенклатура = СтрокаВозврата.Номенклатура;
								СтрокаВозврат.Характеристика = СтрокаВозврата.Характеристика;
								// 1440 = 60*24, такого времени быть не может, поэтому при сортировке будет в конце.
								СтрокаВозврат.Время = 60*24;
								СтрокаВозврат.Возврат = Истина;
								Количество = ?(СтрокаВозврата.Количество = NULL, 0, СтрокаВозврата.Количество);
								СтрокаВозврат.Количество = -Количество; // Меняем знак, так как в запросе оно отрицательное.
								
								ТекущаяЕдиницаИзмерения = ?(ПараметрыОтчета.ЕдиницыКоличества, СтрокаВозврата.ЕдиницаДляОтчетов, СтрокаВозврата.ЕдиницаХранения);
								Если НЕ ПроизведенРасчетСебестоимости Тогда
									ЦенаНорм		= питПроизводство.ПолучитьСтоимостьИнгредиента(СтрокаВозврата.Номенклатура, ПараметрыОтчета.ВидЦенНорм, ПараметрыОтчета.НачалоПериода, ВалютаРегламентированногоУчета , ,,,, ТекущаяЕдиницаИзмерения, СтрокаВозврата.Характеристика);
									СтрокаВозврат.Сумма = ЦенаНорм * -СтрокаВозврат.Количество;
								Иначе
									СтрокаВозврат.Сумма = -СтрокаВозврата.Сумма;
								КонецЕсли;
								
								ЦенаРозн = питПроизводство.ПолучитьСтоимостьИнгредиента(СтрокаВозврата.Номенклатура, ПараметрыОтчета.ВидЦенРозн, ПараметрыОтчета.НачалоПериода, ВалютаРегламентированногоУчета , ,,,, ТекущаяЕдиницаИзмерения, СтрокаВозврата.Характеристика);
								СтрокаВозврат.СуммаРозн = -ЦенаРозн*Количество;
								СтрокаВозврат.ИндексСтраницы = СтрокаВТаблицеПериода.Страница;
								СтрокаВозврат.ИндексКолонки = 0;
							КонецЕсли;
						КонецЦикла;
						МассивПериода.Удалить(МассивПериода.Найти(СтрокаПериода.ПериодМинуты));
					КонецЦикла;
					
					// Дополним имеющимися периодами
					Для Каждого Период Из МассивПериода Цикл
						СтрокаВТаблицеПериода = ТаблицаПериодов.Найти(Период,"Период");
						СтрокаПеремещений = ТаблицаПеремещений.Добавить();
						Попытка
							СтрокаПеремещений.Организация = СтрокаПериода.Организация;
						Исключение
							СтрокаПеремещений.Организация = ПараметрыОтчета.Организация;
						КонецПопытки;
						СтрокаПеремещений.Номенклатура = СтрокаПериода.Номенклатура;
						СтрокаПеремещений.Характеристика = СтрокаПериода.Характеристика;
						СтрокаПеремещений.Время = Период;
						СтрокаПеремещений.Возврат = 0;
						СтрокаПеремещений.Количество = 0;
						СтрокаПеремещений.Сумма = 0;
						СтрокаПеремещений.СуммаРозн = 0;
						СтрокаПеремещений.ИндексСтраницы = СтрокаВТаблицеПериода.Страница;
						СтрокаПеремещений.ИндексКолонки = СтрокаВТаблицеПериода.Колонка;
					КонецЦикла;
					
					ТекСтраница = 0;
					Для каждого ТекСтрокаПеремещение Из ТаблицаПеремещений Цикл
						ТекСтраница = Макс(ТекСтраница, ТекСтрокаПеремещение.ИндексСтраницы);
					КонецЦикла;
					СчВремени = ТаблицаПеремещений.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, ИндексСтраницы",СтрокаПериода.Номенклатура, СтрокаПериода.Характеристика, ТекСтраница)).Количество();
					// Дополним записи до 6
					Для Сч = СчВремени+1 По 6 Цикл
						СтрокаПеремещений = ТаблицаПеремещений.Добавить();
						Попытка
							СтрокаПеремещений.Организация = СтрокаНоменклатуры.Организация;
						Исключение
							СтрокаПеремещений.Организация = ПараметрыОтчета.Организация;
						КонецПопытки;
						СтрокаПеремещений.Номенклатура = СтрокаНоменклатуры.Номенклатура;
						СтрокаПеремещений.Характеристика = СтрокаНоменклатуры.Характеристика;
						// 1440 = 60*24, такого времени быть не может, поэтому при сортировке будет в конце.
						СтрокаПеремещений.Время = 60*24;
						СтрокаПеремещений.Возврат = Ложь;
						СтрокаПеремещений.Количество = 0;
						СтрокаПеремещений.Сумма = 0;
						СтрокаПеремещений.СуммаРозн = 0;
						СтрокаПеремещений.ИндексСтраницы = ТекСтраница;
						СтрокаПеремещений.ИндексКолонки = Сч;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;

	
	Если (ТаблицаПеремещений.Количество() = 0) И (ТаблицаВозвратов.Количество() = 0) Тогда
		ОбщегоНазначенияклиентСервер.СообщитьПользователю("Перемещения за данный период отсутствуют!",, "Отчет.Результат", , Ложь);
	КонецЕсли;
	
	// Подготовим вспомогательные таблицы
	ТаблицаПеремещений.Сортировать("ИндексСтраницы,Организация,Номенклатура,Характеристика,ИндексКолонки,Время");
	ТаблицаВремени = ТаблицаПеремещений.Скопировать();
	ТаблицаВремени.Свернуть("ИндексСтраницы,ИндексКолонки,Время,Организация");
	ТаблицаВремени.Сортировать("ИндексСтраницы,Организация,ИндексКолонки,Время");
	ТаблицаСтраниц = ТаблицаВремени.Скопировать();
	ТаблицаСтраниц.Свернуть("ИндексСтраницы,Организация");
	ТаблицаСтраниц.Сортировать("ИндексСтраницы,Организация");
	ТаблицаНоменклатуры = ТаблицаПеремещений.Скопировать();
	ТаблицаНоменклатуры.Свернуть("ИндексСтраницы,Организация,Номенклатура,Характеристика");
	ТаблицаНоменклатуры.Сортировать("ИндексСтраницы,Организация,Номенклатура,Характеристика");
	
	ТаблицаВозвратов.Свернуть("ИндексСтраницы,Организация,Номенклатура,Характеристика","Количество,Сумма,СуммаРозн");
	
	ПечататьАртикул = (Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить() = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул);
	
	МассивОбщихИтогов = Новый Массив(6);
	МассивИтогов = Новый Массив(6);
	ОбнулитьМассив(МассивОбщихИтогов);
	ИтогоСумма = 0;
	ИтогоСуммаРозн = 0;
	ИтогоВозвращено = 0;
	ИтогоОтпущено = 0;
	// Выводим
	// Идем для начала по страницам
	Для Каждого Страница Из ТаблицаСтраниц Цикл
		Если ВыводитьЗаголовок  Тогда
			// Выводим заголовок
			ОбластьЗаголовок.Параметры.НомерДок = ПараметрыОтчета.НомерОтчета;
			ОбластьЗаголовок.Параметры.ДатаДок = ПолучитьОперативнуюОтметкуВремени();
			СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Страница.Организация, ОбластьЗаголовок.Параметры.ДатаДок);
			ТекстОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,");
			Если ПустаяСтрока(ТекстОрганизации) Тогда
				ТекстОрганизации = СведенияОбОрганизации.Представление;
			КонецЕсли;
			ОбластьЗаголовок.Параметры.Организация=ТекстОрганизации;
			ОбластьЗаголовок.Параметры.КодПоОКПО = Страница.Организация.КодПоОКПО;
			// Чтение значения для директора
			Руководители = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Страница.Организация, конецДня(ПараметрыОтчета.НачалоПериода));
			ОбластьЗаголовок.Параметры.Бухгалтер = Руководители.ГлавныйБухгалтерНаименование;
			ОбластьЗаголовок.Параметры.Руководитель = Руководители.РуководительНаименование;
			ОбластьЗаголовок.Параметры.Должность = Руководители.РуководительДолжность;
			// запоним склады
			ОбластьЗаголовок.Параметры.Склад=ПараметрыОтчета.СкладОтправитель;
			ОбластьЗаголовок.Параметры.СкладПолучатель=ПараметрыОтчета.СкладПолучатель;
			
			// получим МОЛ
			Если ЗначениеЗаполнено(ПараметрыОтчета.СкладОтправитель) Тогда
				ВыбМОЛ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.СкладОтправитель, "ТекущийОтветственный");
			Иначе
				ВыбМОЛ = Справочники.ФизическиеЛица.ПустаяСсылка();
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыбМОЛ) Тогда
				ОбластьЗаголовок.Параметры.МОЛ = ВыбМОЛ;
				ОбластьЗаголовок.Параметры.МОЛДолжность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.СкладОтправитель, "ТекущаяДолжностьОтветственного");
			КонецЕсли;
			ДокументРезультат.Вывести(ОбластьЗаголовок);
		КонецЕсли;
		
		СтрокиВремя = ТаблицаВремени.НайтиСтроки(Новый Структура("ИндексСтраницы,Организация",Страница.ИндексСтраницы,Страница.Организация));
		// Если первая страница, выводим заголовок
		Если Страница.ИндексСтраницы = 1 Тогда
			ДокументРезультат.Вывести(ОбластьЗаголовка);
		Иначе // Иначе оборот
			ДокументРезультат.Вывести(ОбластьОборот);
		КонецЕсли;
		// Шапка
		ОбластьШапки = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
		Для Сч = 0 По СтрокиВремя.Количество() - 1 Цикл
			// Подготовим время в нужном формате
			чВремя = СтрокиВремя[Сч].Время;
			Если чВремя = 1440 Тогда
				Время = "-";
			Иначе
				Время = Формат(Цел(чВремя/60),"ЧЦ=2; ЧН=; ЧВН=") + ":" + Формат(чВремя - Цел(чВремя/60)*60,"ЧЦ=2; ЧН=; ЧВН=");
			КонецЕсли;
			ОбластьШапки.Параметры["Время"+(Сч+1)] = Время;
		КонецЦикла;
		ДокументРезультат.Вывести(ОбластьШапки);
		// Выберем строки товаров по странице
		СтрокиСтраница = ТаблицаПеремещений.НайтиСтроки(Новый Структура("ИндексСтраницы, Организация",Страница.ИндексСтраницы,Страница.Организация));
		// Выберем все товары на странице
		СтрокиНоменклатура = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("ИндексСтраницы, Организация",Страница.ИндексСтраницы,Страница.Организация));
		ОбнулитьМассив(МассивИтогов);
		ИтогоСуммаПоСтранице = 0;
		ИтогоСуммаРознПоСтранице = 0;
		ИтогоВозвращеноПоСтранице = 0;
		ИтогоОтпущеноПоСтранице = 0;
		// По номенклатуре
		Для НомерНоменклатуры = 0 По СтрокиНоменклатура.Количество()-1 Цикл
			// Кратно 6
			Номенклатура = СтрокиСтраница[НомерНоменклатуры*6].Номенклатура;
			Характеристика = СтрокиСтраница[НомерНоменклатуры*6].Характеристика;
			ОбластьСтрока.Параметры.Номенклатура = Номенклатура;
			ОбластьСтрока.Параметры.НоменклатураПредставление = СокрЛП(Номенклатура.НаименованиеПолное)+ "" + ?(ЗначениеЗаполнено(Характеристика)," / " + СокрЛП(Характеристика.НаименованиеПолное),"");
			ОбластьСтрока.Параметры.Код = ?(ПечататьАртикул, Номенклатура.Артикул, Номенклатура.Код);
			ОбластьСтрока.Параметры.Единица = Номенклатура.ЕдиницаИзмерения;
			ОбластьСтрока.Параметры.КодЕдиницы = Номенклатура.ЕдиницаИзмерения.Код;
			ИтогоСуммаПоСтроке = 0;
			ИтогоСуммаРознПоСтроке = 0;
			ИтогоОтпущеноПоСтроке = 0;
			// По минутам
			Для Сч = 0 По СтрокиВремя.Количество() - 1 Цикл
				Отпущено = СтрокиСтраница[НомерНоменклатуры*6+Сч].Количество;
				ОбластьСтрока.Параметры["Отпущено"+(Сч+1)] = Отпущено;
				МассивИтогов[Сч] = МассивИтогов[Сч] + Отпущено;
				МассивОбщихИтогов[Сч] = МассивОбщихИтогов[Сч] + Отпущено;
				ИтогоОтпущеноПоСтроке = ИтогоОтпущеноПоСтроке + Отпущено;
				ИтогоСуммаПоСтроке = ИтогоСуммаПоСтроке + СтрокиСтраница[НомерНоменклатуры*6+Сч].Сумма;
				ИтогоСуммаРознПоСтроке = ИтогоСуммаРознПоСтроке + СтрокиСтраница[НомерНоменклатуры*6+Сч].СуммаРозн;
			КонецЦикла;
			// Если все нулевые, то строку не выводим
			Если ИтогоОтпущеноПоСтроке = 0 Тогда
				Продолжить;
			КонецЕсли;
			// Ищем возврат по странице и номенклатуре
			СтрокиВозвратов = ТаблицаВозвратов.НайтиСтроки(Новый Структура("ИндексСтраницы,Организация,Номенклатура,Характеристика",Страница.ИндексСтраницы,Страница.Организация,Номенклатура,Характеристика));
			Если СтрокиВозвратов.Количество() = 0 Тогда
				Возвращено = 0;
			Иначе
				Возвращено = СтрокиВозвратов[0].Количество;
				ИтогоВозвращеноПоСтранице = ИтогоВозвращеноПоСтранице + Возвращено;
				ИтогоВозвращено = ИтогоВозвращено + Возвращено;
			КонецЕсли;
			ОбластьСтрока.Параметры.Возвращено = Возвращено;
			// Итоги по строке
			ИтогоСуммаПоСтранице = ИтогоСуммаПоСтранице + ИтогоСуммаПоСтроке;
			ИтогоСуммаРознПоСтранице = ИтогоСуммаРознПоСтранице + ИтогоСуммаРознПоСтроке;
			ИтогоСумма = ИтогоСумма + ИтогоСуммаПоСтроке;
			ИтогоСуммаРозн = ИтогоСуммаРозн + ИтогоСуммаРознПоСтроке;
			ИтогоОтпущеноПоСтранице = ИтогоОтпущеноПоСтранице + ИтогоОтпущеноПоСтроке;
			ИтогоОтпущено = ИтогоОтпущено + ИтогоОтпущеноПоСтроке;
			ОбластьСтрока.Параметры.ИтогоОтпущено = ИтогоОтпущеноПоСтроке;
			ОбластьСтрока.Параметры.СуммаУчетная = ИтогоСуммаПоСтроке;
			ОбластьСтрока.Параметры.СуммаПродажи = ИтогоСуммаРознПоСтроке;
			ОбластьСтрока.Параметры.ЦенаУчетная = ?(ИтогоСуммаПоСтроке = 0, 0, ИтогоСуммаПоСтроке/ИтогоОтпущеноПоСтроке);
			ОбластьСтрока.Параметры.ЦенаПродажи = ?(ИтогоСуммаРознПоСтроке = 0, 0, ИтогоСуммаРознПоСтроке/ИтогоОтпущеноПоСтроке);
			ДокументРезультат.Вывести(ОбластьСтрока);
		КонецЦикла;
		// Итоги по странице
		Для Сч = 0 По СтрокиВремя.Количество() - 1 Цикл
			Отпущено = МассивИтогов[Сч];
			ОбластьИтог.Параметры["Отпущено"+(Сч+1)] = Отпущено;
		КонецЦикла;
		ОбластьИтог.Параметры.Возвращено = ИтогоВозвращеноПоСтранице;
		ОбластьИтог.Параметры.СуммаУчетная = ИтогоСуммаПоСтранице;
		ОбластьИтог.Параметры.СуммаПродажи = ИтогоСуммаРознПоСтранице;
		ОбластьИтог.Параметры.ИтогоОтпущено = ИтогоОтпущеноПоСтранице;
		ДокументРезультат.Вывести(ОбластьИтог);
		ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЦикла;
	
	
	// Итоги по документу
	Для Сч = 0 По 5 Цикл
		Отпущено = МассивОбщихИтогов[Сч];
		ОбластьПодвал.Параметры["Отпущено"+(Сч+1)] = Отпущено;
	КонецЦикла;
	ОбластьПодвал.Параметры.Возвращено = ИтогоВозвращено;
	ОбластьПодвал.Параметры.СуммаУчетная = ИтогоСумма;
	ОбластьПодвал.Параметры.СуммаПродажи = ИтогоСуммаРозн;
	ОбластьПодвал.Параметры.СуммаУчетнаяПрописью = ЧислоПрописью(ИтогоСумма) + " " + Константы.ВалютаРегламентированногоУчета.Получить();
	ОбластьПодвал.Параметры.ИтогоОтпущено = ИтогоОтпущено;
	ОбластьПодвал.Параметры.ВсегоОтпущеноПоДок = ЧислоПрописью(ИтогоОтпущено);
	ОбластьПодвал.Параметры.Отпустил = Отпустил;
	ОбластьПодвал.Параметры.ОтпустилДолжность = ОтпустилДолжность;
	ОбластьПодвал.Параметры.Принял = Принял;
	ОбластьПодвал.Параметры.ПринялДолжность = ПринялДолжность;
	ДокументРезультат.Вывести(ОбластьПодвал);
	
	
	// Зафиксируем заголовок отчета
	ДокументРезультат.ФиксацияСверху = ВысотаЗаголовка;
	// Первую колонку не печатаем
	ДокументРезультат.ОбластьПечати = ДокументРезультат.Область(1,2,ДокументРезультат.ВысотаТаблицы,ДокументРезультат.ШиринаТаблицы);
	
КонецПроцедуры

// Функция - Подготовить параметры отчета.
//
// Параметры:
//  ДокументРезультат - Произвольный - Документ результат.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПодготовитьПараметрыОтчета(ДокументРезультат)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация"                           , КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Организация").Значение);
	ПараметрыОтчета.Вставить("НачалоПериода"                         , НачалоДня(КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "День").Значение));
	ПараметрыОтчета.Вставить("КонецПериода"                          , КонецДня(КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "День").Значение));
	ПараметрыОтчета.Вставить("СкладПолучатель"                       , КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "СкладПолучатель").Значение);
	ПараметрыОтчета.Вставить("СкладОтправитель"                      , КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "СкладОтправитель").Значение);
	ПараметрыОтчета.Вставить("ЕдиницыКоличества"                     , КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ЕдиницыКоличества").Значение);
	ПараметрыОтчета.Вставить("ПоказательКоличество"                  , Истина);
	ПараметрыОтчета.Вставить("ПоказательСумма"                       , Истина);
	ПараметрыОтчета.Вставить("ВидЦенНорм"                            , КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ВидЦенНорм").Значение);
	ПараметрыОтчета.Вставить("ВидЦенРозн"                            , КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ВидЦенРозн").Значение);
	ПараметрыОтчета.Вставить("РежимРасшифровки"                      , Истина);
	ПараметрыОтчета.Вставить("НомерОтчета"                           , КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "НомерОтчета").Значение);
	ПараметрыОтчета.Вставить("ДокументРезультат"                     , ДокументРезультат);
	ПараметрыОтчета.Вставить("ВыводитьЗаголовок"                     , Истина);
	ПараметрыОтчета.Вставить("ВыводитьПодвал"                        , Истина);
	
	Возврат ПараметрыОтчета;
	
КонецФункции

// Выводит шапку отчета
//
// Параметры:
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//
// Возвращаемое значение:
// 	ОбластьЯчеекТабличногоДокумента, Шапка для отчета
Функция СформироватьЗаголовок(ПараметрыОтчета)
	
	// Вывод заголовка, описателя периода и фильтров и шапки
	ОписаниеПериода     = ОтчетыУТКлиентСервер.ПолучитьПредставлениеПериода(ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.НачалоПериода);
	
	МакетОтчета = ПолучитьМакет("ОП6");
	
	ЗаголовокОтчета = МакетОтчета.ПолучитьОбласть("Заголовок");
	
	СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ПараметрыОтчета.Организация, ПараметрыОтчета.НачалоПериода);
	ТекстОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,");
	Если ПустаяСтрока(ТекстОрганизации) Тогда
		ТекстОрганизации = СведенияОбОрганизации.Представление;
	КонецЕсли;
	ЗаголовокОтчета.Параметры.НазваниеОрганизации=ТекстОрганизации;
	
	ЗаголовокОтчета.Параметры.ОписаниеПериода = ОписаниеПериода;
	
	ЗаголовокОтчета.Параметры.Заголовок = "Заборный лист";
	
	Возврат(ЗаголовокОтчета);
	
КонецФункции // СформироватьЗаголовок()

// Создадим структуры временных таблиц
//
// Параметры:
//  ТаблицаПеремещений - ТаблицаЗначений - Таблица перемещений.
//  ТаблицаВозвратов - ТаблицаЗначений - Таблица возвратов.
//
Процедура ИнициализацияТаблиц(ТаблицаПеремещений,ТаблицаВозвратов)
	// Создадим временные таблицы
	МассивТипов=Новый Массив(1);
	МассивТипов[0]=Тип("СправочникСсылка.Номенклатура"); 
	ТаблицаПеремещений.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаПеремещений.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	МассивТипов[0]=Тип("Число"); 
	ТаблицаПеремещений.Колонки.Добавить("Время",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("ИндексСтраницы",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("ИндексКолонки",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("Количество",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("Цена",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("Сумма",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("ЦенаРозн",Новый ОписаниеТипов(МассивТипов));
	ТаблицаПеремещений.Колонки.Добавить("СуммаРозн",Новый ОписаниеТипов(МассивТипов));
	МассивТипов[0]=Тип("Булево"); 
	ТаблицаПеремещений.Колонки.Добавить("Возврат",Новый ОписаниеТипов(МассивТипов));
	
	ТаблицаВозвратов = ТаблицаПеремещений.Скопировать();
КонецПроцедуры

// Функция - Получить таблицу периодов.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - Дерево данных.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуПериодов(ДеревоДанных)
	
	ТаблицаПериодов = Новый ТаблицаЗначений;
	ТаблицаПериодов.Колонки.Добавить("Период");
	Для Каждого СтрокаОрганизации Из ДеревоДанных.Строки Цикл
		Для Каждого СтрокаНомеклатурыХарактеристики Из СтрокаОрганизации.Строки Цикл
			Для Каждого СтрокаНомеклатуры Из СтрокаНомеклатурыХарактеристики.Строки Цикл
				Для Каждого СтрокаПериода Из СтрокаНомеклатуры.Строки цикл
					СтрокаПериод = ТаблицаПериодов.Добавить();
					СтрокаПериод.Период = СтрокаПериода.ПериодМинуты;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ТаблицаПериодов.Свернуть("Период");
	ТаблицаПериодов.Колонки.Добавить("Страница");
	ТаблицаПериодов.Колонки.Добавить("Колонка");
	
	Страница = 0;
	Колонка = 0;
	Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл 
		Если Колонка = 6 Тогда
			Страница = Страница + 1;
			Колонка = 0;
		КонецЕсли;
		СтрокаПериода.Страница = Страница;
		СтрокаПериода.Колонка = Колонка;
		Колонка = Колонка + 1;
	КонецЦикла;
	
	Возврат ТаблицаПериодов;
	
КонецФункции

// Процедура выполняет обнуление элементов массива
//
// Параметры:
//  пМассив - Массив - п массив.
//
Процедура ОбнулитьМассив(пМассив)
	Для Сч = 0 По пМассив.Количество()-1 Цикл
		пМассив[Сч] = 0;
	КонецЦикла;
КонецПроцедуры

