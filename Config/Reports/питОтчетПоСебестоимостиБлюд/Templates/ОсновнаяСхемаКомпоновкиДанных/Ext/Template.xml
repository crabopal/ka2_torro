	<calculatedField>
		<dataPath>НаценкаАбсолютная</dataPath>
		<expression>ВЫБОР 
	КОГДА Уровень = 0  
	ТОГДА 
		(ЦенаПродажи - (ВЫБОР 
			КОГДА КоличествоУпаковокБлюда = 0
			ТОГДА 0
			ИНАЧЕ Сумма 
			КОНЕЦ))
	ИНАЧЕ 0
КОНЕЦ</expression>
