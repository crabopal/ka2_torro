	<calculatedField>
		<dataPath>Номенклатура</dataPath>
		<expression>ВЫБОР 
КОГДА Ингредиент = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
ТОГДА Блюдо 
