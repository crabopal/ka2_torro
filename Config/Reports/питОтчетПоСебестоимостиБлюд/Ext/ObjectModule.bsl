#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//  Форма - УправляемаяФорма - Форма отчета.
//  КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//  Настройки - Произвольный - Настройки.
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере = Истина;
	
КонецПроцедуры

// Вызывается в одноименном обработчике формы отчета после выполнения кода формы.
//  Подробнее - см. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма отчета.
//  НовыеНастройкиКД - Произвольный - см. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере.
//
Процедура ПередЗагрузкойВариантаНаСервере(ЭтаФорма, НовыеНастройкиКД) Экспорт
	
	Отчет = ЭтаФорма.Отчет;
	КомпоновщикНастроекФормы = Отчет.КомпоновщикНастроек;
	
	// Изменение настроек по функциональным опциям
	НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы);
	
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма отчета.
//  Отказ - Булево - Передается из параметров обработчика "как есть".
//  СтандартнаяОбработка - Булево - Передается из параметров обработчика "как есть".
//
Процедура ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка) Экспорт
	
	// +пит
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// -пит
	
	КомпоновщикНастроекФормы = ЭтаФорма.Отчет.КомпоновщикНастроек;
	Параметры = ЭтаФорма.Параметры;
	
КонецПроцедуры

// Процедура - Сформировать массив отборов рекурсивно.
//
// Параметры:
//  Запрос - Произвольный - Запрос.
//  МассивОтборов - Массив - Массив отборов.
//  ПоляОтбора - Произвольный - Поля отбора.
//  ТипГруппы - Произвольный - Тип группы.
//  НомерПараметра - Произвольный - Номер параметра.
//  ПолеПоиска - Произвольный - Поле поиска.
//  ПервыйЭлементГруппы - Произвольный - Первый элемент группы.
//  ОтключатьНайденныйЭлемент - Произвольный - Отключать найденный элемент.
//  ПустойЭлемент - Произвольный - Пустой элемент.
//
Процедура СформироватьМассивОтборовРекурсивно(Запрос,
		МассивОтборов, 
		ПоляОтбора, 
		ТипГруппы, 
		НомерПараметра,
		ПолеПоиска,
		ПервыйЭлементГруппы = Истина,
		ОтключатьНайденныйЭлемент = Ложь,
		ПустойЭлемент = Неопределено) Экспорт
		
	Для Каждого ТекСтрока Из ПоляОтбора Цикл
		
		Если НЕ ТекСтрока.Использование 
			ИЛИ НЕ (ТипЗнч(ТекСтрока) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")
			ИЛИ (ТекСтрока.ЛевоеЗначение = ПолеПоиска)) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПервыйЭлементГруппы Тогда
			Если ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ Тогда
				МассивОтборов.Добавить(" И ");
			ИначеЕсли ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли Тогда
				МассивОтборов.Добавить(" ИЛИ ");
			ИначеЕсли ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда
				МассивОтборов.Добавить(" ИЛИ ");
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			ПервыйЭлементГруппы = Ложь;
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			Если ТекСтрока.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ Тогда
				МассивОтборов.Добавить(" (");
			ИначеЕсли ТекСтрока.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли Тогда
				МассивОтборов.Добавить(" (");
			ИначеЕсли ТекСтрока.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда
				МассивОтборов.Добавить(" НЕ (");
			Иначе
				Продолжить;
			КонецЕсли;
			СформироватьМассивОтборовРекурсивно(Запрос,МассивОтборов, ТекСтрока.Элементы, ТекСтрока.ТипГруппы,
				НомерПараметра,ПолеПоиска);
			МассивОтборов.Добавить(") ");
			Продолжить;
		ИначеЕсли НЕ (ТекСтрока.ЛевоеЗначение = ПолеПоиска) Тогда
			Продолжить;
		КонецЕсли;
		
		ПризнакНе = "";
		ЗначениеПараметра = ТекСтрока.ПравоеЗначение;
		Если ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			ЗнакОтбора = "=";
		ИначеЕсли ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
			ЗнакОтбора = "=";
			ПризнакНе = "НЕ";
		ИначеЕсли ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
			ЗнакОтбора = "В";
		ИначеЕсли ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
			ЗнакОтбора = "В";
			ПризнакНе = "НЕ";
		ИначеЕсли ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
			ЗнакОтбора = "=";
			ЗначениеПараметра = Справочники.Номенклатура.ПустаяСсылка();
		ИначеЕсли ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			ЗнакОтбора = "=";
			ЗначениеПараметра = ПустойЭлемент;
			ПризнакНе = "НЕ";
		ИначеЕсли ЭтоОтборПоИерархии(ТекСтрока.ВидСравнения) Тогда
			
			Если ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии
				ИЛИ ТекСтрока.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				ПризнакНе = "НЕ";
			КонецЕсли;
			
			ЗнакОтбора = "В";
			Если ЗначениеПараметра = Неопределено 
				ИЛИ ТипЗнч(ЗначениеПараметра) = Тип("Массив") Тогда
				МассивЭлементовИерархии = ЗначениеПараметра;
			ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("СписокЗначений") Тогда
				МассивЭлементовИерархии = Новый Массив;
				Для Каждого ТекЗначениеСписка Из ЗначениеПараметра Цикл
					МассивЭлементовИерархии.Добавить(ТекЗначениеСписка.Значение);
				КонецЦикла;
			Иначе
				МассивЭлементовИерархии = Новый Массив;
				МассивЭлементовИерархии.Добавить(ЗначениеПараметра);
			КонецЕсли;
			ЗначениеПараметра = питОбщегоНазначения.ПолучитьВложенныеЭлементыСправочника(МассивЭлементовИерархии, Истина);
		Иначе
			ЗнакОтбора = "В";
		КонецЕсли;
		
		
		ИмяПараметра = СтрШаблон("ЗначениеПараметра%1",Формат(НомерПараметра,"ЧН=0; ЧГ="));
		МассивОтборов.Добавить(СтрШаблон("%3 ТекСправочник.Ссылка %1 (&%2)", ЗнакОтбора, ИмяПараметра, ПризнакНе));
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПараметра);
		НомерПараметра = НомерПараметра + 1;
		
		Если ОтключатьНайденныйЭлемент Тогда
			ТекСтрока.Использование = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Процедура - При компоновке результата.
//
// Параметры:
//  ДокументРезультат - Произвольный - Документ результат.
//  ДанныеРасшифровки - Произвольный - Данные расшифровки.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПользовательскиеНастройкиМодифицированы = Ложь;
	
	УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы);
	
	// Стандартная компоновка отчета.
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	// +Логика отчета
	СтруктураНастроек = НастройкиОтчетаВСтруктуру(НастройкиОтчета);
	ТаблицаРезультат = ПодготовитьТаблицуДанных(СтруктураНастроек);
	// -Логика отчета
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
	
	КомпоновкаДанныхСервер.УстановитьЗаголовкиМакетаКомпоновки(СтруктураЗаголовковПолейЕдиницИзмерений(),
		МакетКомпоновки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Новый Структура("ТаблицаДанных", ТаблицаРезультат),
		ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	КомпоновкаДанныхСервер.СкрытьВспомогательныеПараметрыОтчета(СхемаКомпоновкиДанных, КомпоновщикНастроек,
		ДокументРезультат, ВспомогательныеПараметрыОтчета());
	
	// Сообщим форме отчета, что настройки модифицированы
	Если ПользовательскиеНастройкиМодифицированы Тогда
		КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
			"ПользовательскиеНастройкиМодифицированы", Истина);
	КонецЕсли;
	
	питЦентрМониторинга.ЗаписатьОперацииБизнесСтатистики(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Настройки отчета в структуру.
//
// Параметры:
//  НастройкиОтчета - Произвольный - Настройки отчета.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция НастройкиОтчетаВСтруктуру(НастройкиОтчета)
	
	СтруктураНастроек = Новый Структура;
	Для каждого ПараметрДанных Из НастройкиОтчета.ПараметрыДанных.Элементы Цикл
		Если НЕ ПараметрДанных.Использование Тогда
			Продолжить;
		КонецЕсли;
		СтруктураНастроек.Вставить(Строка(ПараметрДанных.Параметр), ПараметрДанных.Значение);
	КонецЦикла;
	СтруктураНастроек.Вставить("НастройкиКомпоновкиДанных", НастройкиОтчета);
	
	Возврат СтруктураНастроек;
	
КонецФункции

// Функция - Подготовить таблицу данных.
//
// Параметры:
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПодготовитьТаблицуДанных(ПараметрыОтчета)
	
	ВходныеПараметры = Новый Структура;
	ВходныеПараметры.Вставить("КлючСвязиСквозной",1);
	ВходныеПараметры.Вставить("НаУказанноеКоличество", (ПараметрыОтчета.ВариантНормативногоКоличества = 1));
	ВходныеПараметры.Вставить("УказанноеКоличество", ?((ПараметрыОтчета.ВариантНормативногоКоличества = 1),
		ПараметрыОтчета.НормативноеКоличество,
		0));
	ВходныеПараметры.Вставить("ЕдиницаИзмеренияПоРецептуре", ПараметрыОтчета.РецептурнаяЕдиница = 0);
	ВходныеПараметры.Вставить("ЕдиницаИзмеренияПоРецептуреБлюда", ПараметрыОтчета.РецептурнаяЕдиницаБлюда = 0);
	ВходныеПараметры.Вставить("ИспользоватьСезонныеПроценты", ПараметрыОтчета.ИспользоватьСезонныеПроценты);
	
	// Инициализация первичной таблицы блюд.
	МассивТаблицДанных = Новый Массив;
	
	// Если пришел отбор по блюду, то сначала выполним отбор по номенклатуре.
	ТаблицаБлюд = ПодготовитьИсходнуюТаблицуБлюдПоОтборам(ПараметрыОтчета, ВходныеПараметры);
	
	Если НЕ ЗначениеЗаполнено(ТаблицаБлюд) Тогда
		Возврат ТаблицаБлюд;
	КонецЕсли;
	
	МассивТаблицДанных.Добавить(ТаблицаБлюд);
	
	// Пройдем в состав ингредиентов и рассчитаем показатели количества.
	ВыполнитьПрямойПроход(МассивТаблицДанных, ВходныеПараметры, ПараметрыОтчета);
	
	// Рассчитаем суммовые показатели.
	ВыполнитьОбратныйПроход(МассивТаблицДанных);
	
	ДозаполнитьНачальныйУровень(МассивТаблицДанных[0], ПараметрыОтчета);
	
	ВходныеПараметры.КлючСвязиСквозной = ВходныеПараметры.КлючСвязиСквозной +1;
	
	// Объединим все таблицы.
	ИтоговаяТаблицаДанных = ОбъединитьТаблицыДанных(МассивТаблицДанных, ПараметрыОтчета, ВходныеПараметры);
	
	Если ПараметрыОтчета.СпособФормирования = 1 Тогда
		ЗавершитьПодготовкуТаблицыДанных(ИтоговаяТаблицаДанных, ПараметрыОтчета);
	КонецЕсли;
	
	Возврат ИтоговаяТаблицаДанных;
КонецФункции

// Функция - Объединить таблицы данных.
//
// Параметры:
//  МассивТаблицДанных - Массив - Массив таблиц данных.
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//  ВходныеПараметры - Произвольный - Входные параметры.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ОбъединитьТаблицыДанных(МассивТаблицДанных, ПараметрыОтчета, ВходныеПараметры)
	
	ИтоговаяТаблицаДанных = ТаблицаДанныхПустая();
	Для Каждого ТекТаблица Из МассивТаблицДанных Цикл
		
		Для Каждого ТекСтрока Из ТекТаблица Цикл
			КлючПриемника = ТекСтрока.КлючПриемника;
			Если ПараметрыОтчета.СпособФормирования = 1
				И ТекСтрока.Уровень > 0 Тогда
				Если ЗначениеЗаполнено(ТекСтрока.РецептураБлюда) Тогда
					Продолжить;
				КонецЕсли;
				КлючПриемника = ТекСтрока.КлючИсходногоБлюда;
				ТекСтрока.Уровень = 1;
				ТекСтрока.РецептураРодителя = Неопределено;
				ТекСтрока.Блюдо = ТекСтрока.ИсходноеБлюдо;
				ТекСтрока.КлючИсточника = ВходныеПараметры.КлючСвязиСквозной;
				Если ЗначениеЗаполнено(ТекСтрока.Ингредиент) Тогда
					ТекСтрока.КоличествоБлюда = 0;
				КонецЕсли;
			КонецЕсли;
			НоваяСтрока = ИтоговаяТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КлючПриемника = КлючПриемника;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ИтоговаяТаблицаДанных;
	
КонецФункции

// Функция - Это отбор по иерархии.
//
// Параметры:
//  ВидСравнения - Произвольный - Вид сравнения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЭтоОтборПоИерархии(ВидСравнения)
	
	Возврат ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии
			ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
			ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии
			ИЛИ ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии;
	
КонецФункции


// Функция подготавливает исходную таблицу блюд по отборам.
//
// Параметры:
//  ПараметрыОтчета - Структура - Структура параметров отчета.
//  ВходныеПараметры - Произвольный - Входные параметры.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Формат см. в ТаблицаДанныхПустая()
Функция ПодготовитьИсходнуюТаблицуБлюдПоОтборам(ПараметрыОтчета, ВходныеПараметры)
	
	ТаблицаБлюд = ТаблицаДанныхПустая();
	
	Запрос = Новый Запрос;
	// Сформируем отборы по блюдам.
	МассивОтборов= Новый Массив;
	НомерПараметра = 1;
	СформироватьМассивОтборовРекурсивно(Запрос,
		МассивОтборов, 
		ПараметрыОтчета.НастройкиКомпоновкиДанных.Отбор.Элементы,
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ, 
		НомерПараметра,
		Новый ПолеКомпоновкиДанных("ИсходноеБлюдо"),
		Ложь,,Справочники.Номенклатура.ПустаяСсылка());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТекСправочник.Ссылка КАК Ссылка,
	|	АВТОНОМЕРЗАПИСИ() КАК ВременныйКлючСтроки,
	|	ТекСправочник.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ВТ_ИсходныеДанные
	|ИЗ
	|	Справочник.Номенклатура КАК ТекСправочник
	|ГДЕ
	|	НЕ ТекСправочник.ПометкаУдаления
	|	И &ДополнительныеОтборы
	|	И ТекСправочник.питВидНоменклатуры = &питВидНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИсходныеДанные.Ссылка КАК Ссылка,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	ВТ_ИсходныеДанные.ВременныйКлючСтроки КАК ВременныйКлючСтроки,
	|	1 КАК Приоритет,
	|	ВТ_ИсходныеДанные.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ВТ_БлюдаСМодификаторами
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ИсходныеДанные.Ссылка,
	|	ХарактеристикиНоменклатуры.Ссылка,
	|	ВТ_ИсходныеДанные.ВременныйКлючСтроки,
	|	2,
	|	ВТ_ИсходныеДанные.ЕдиницаИзмерения
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|		ПО ВТ_ИсходныеДанные.Ссылка = ХарактеристикиНоменклатуры.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_БлюдаСМодификаторами.Ссылка КАК Ссылка,
	|	ВТ_БлюдаСМодификаторами.Характеристика КАК Характеристика,
	|	ВТ_БлюдаСМодификаторами.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	ВТ_БлюдаСМодификаторами КАК ВТ_БлюдаСМодификаторами
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_БлюдаСМодификаторами.ВременныйКлючСтроки,
	|	ВТ_БлюдаСМодификаторами.Приоритет";
	ТекстОтборов = СтрСоединить(МассивОтборов, Символы.ПС);
	Запрос.УстановитьПараметр("питВидНоменклатуры", Перечисления.питВидыНоменклатуры.Блюдо);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &ДополнительныеОтборы", ТекстОтборов);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Вернем пустую таблицу.
		Возврат ТаблицаБлюд;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаБлюд.Добавить();
		НоваяСтрока.Блюдо = Выборка.Ссылка;
		НоваяСтрока.ИсходноеБлюдо = Выборка.Ссылка;
		НоваяСтрока.ХарактеристикаБлюда = Выборка.Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
		НоваяСтрока.Уровень = 0;
		НоваяСтрока.КлючИсточника = ВходныеПараметры.КлючСвязиСквозной;
		НоваяСтрока.КлючИсходногоБлюда = НоваяСтрока.КлючИсточника;
		ВходныеПараметры.КлючСвязиСквозной = ВходныеПараметры.КлючСвязиСквозной + 1;
		
	КонецЦикла;
	
	Возврат ТаблицаБлюд;
	
КонецФункции

// Функция - Получить актуальные рецептуры.
//
// Параметры:
//  МассивНоменклатуры - Массив - Массив номенклатуры.
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьАктуальныеРецептуры(МассивНоменклатуры, ПараметрыОтчета)
										
	ТаблицаРецептур = питПроизводство.ВернутьТаблицуОсновныхРецептур(МассивНоменклатуры,
		?(ПараметрыОтчета.Период = Неопределено, ТекущаяДатаСеанса(), ПараметрыОтчета.Период.Дата),
		ПараметрыОтчета.Подразделение,
		ПараметрыОтчета.Организация);
	
	Возврат ТаблицаРецептур;
	
КонецФункции

// Функция - Таблица данных пустая.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ТаблицаДанныхПустая()
	
	ОписаниеТиповНоменклатура = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	ОписаниеТиповХарактеристика = Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры");
	ОписаниеТипаРецептуры = Новый ОписаниеТипов("ДокументСсылка.питРецептура");
	ОписаниеТипаЕИ = Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения");
	ОписаниеТипаКоличество = ОбщегоНазначения.ОписаниеТипаЧисло(15,3);
	ОписаниеТипаСумма = ОбщегоНазначения.ОписаниеТипаЧисло(15,2);
	ОписаниеТипаКлюч = ОбщегоНазначения.ОписаниеТипаЧисло(5);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Блюдо", ОписаниеТиповНоменклатура);
	ТаблицаДанных.Колонки.Добавить("ИсходноеБлюдо", ОписаниеТиповНоменклатура);
	ТаблицаДанных.Колонки.Добавить("Ингредиент", ОписаниеТиповНоменклатура);
	ТаблицаДанных.Колонки.Добавить("ХарактеристикаБлюда", ОписаниеТиповХарактеристика);
	ТаблицаДанных.Колонки.Добавить("ХарактеристикаИсходногоБлюда", ОписаниеТиповХарактеристика);
	ТаблицаДанных.Колонки.Добавить("ХарактеристикаИнгредиента", ОписаниеТиповХарактеристика);
	ТаблицаДанных.Колонки.Добавить("РецептураБлюда", ОписаниеТипаРецептуры);
	ТаблицаДанных.Колонки.Добавить("РецептураРодителя", ОписаниеТипаРецептуры);
	ТаблицаДанных.Колонки.Добавить("КоличествоБлюда", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("КоличествоУпаковокБлюда", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("КоличествоИнгредиента", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("КоличествоУпаковокИнгредиента", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("КоличествоИнгредиентаНетто", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("КоличествоУпаковокИнгредиентаНетто", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("КоличествоИнгредиентаВыход", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("КоличествоУпаковокИнгредиентаВыход", ОписаниеТипаКоличество);
	ТаблицаДанных.Колонки.Добавить("Сумма", ОписаниеТипаСумма);
	ТаблицаДанных.Колонки.Добавить("КлючИсточника", ОписаниеТипаКлюч);
	ТаблицаДанных.Колонки.Добавить("КлючПриемника", ОписаниеТипаКлюч);
	ТаблицаДанных.Колонки.Добавить("КлючИсходногоБлюда", ОписаниеТипаКлюч);
	ТаблицаДанных.Колонки.Добавить("Уровень", ОписаниеТипаКлюч);
	ТаблицаДанных.Колонки.Добавить("Выход", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаДанных.Колонки.Добавить("Цена", ОписаниеТипаСумма);
	ТаблицаДанных.Колонки.Добавить("ЦенаНормативная", ОписаниеТипаСумма);
	ТаблицаДанных.Колонки.Добавить("ЦенаПродажи", ОписаниеТипаСумма);
	ТаблицаДанных.Колонки.Добавить("ЕдиницаИзмерения", ОписаниеТипаЕИ);
	ТаблицаДанных.Колонки.Добавить("ЕдиницаИзмеренияИнгредиента", ОписаниеТипаЕИ);
	Возврат ТаблицаДанных;
КонецФункции

// Процедура - Выполнить прямой проход.
//
// Параметры:
//  МассивТаблицДанных - Массив - Массив таблиц данных.
//  ВходныеПараметры - Произвольный - Входные параметры.
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//
Процедура ВыполнитьПрямойПроход(МассивТаблицДанных, ВходныеПараметры, ПараметрыОтчета)
	
	// Начнем обход с исходной таблицы блюд.
	ТаблицаБлюд = МассивТаблицДанных[0];
	
	УровеньВложенности = 1;
	МаксимальныйУровеньВложенности = 100;
	
	ВременнаяТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ВременнаяТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ВременнаяТаблицаНоменклатуры.Колонки.Добавить("Характеристика", 
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	// Получим таблицу Номенклатура/Рецептура.
	Пока Истина Цикл
		
		Если УровеньВложенности > МаксимальныйУровеньВложенности Тогда
			// В среднем уровень вложенности не будет превышать 7.
			// Возможно возникла рекурсия данных, поэтому принудительно завершим проход.
			Прервать;
		КонецЕсли;
		
		// Получим массив номенклатуры для которой нужно получить рецептуры.
		МассивНоменклатуры = Новый Массив;
		ВременнаяТаблицаНоменклатуры.Очистить();
		
		Для Каждого ТекСтрока Из ТаблицаБлюд Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Ингредиент) Тогда
				Номенклатура = ТекСтрока.Ингредиент;
				Характеристика = ТекСтрока.ХарактеристикаИнгредиента;
			ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Блюдо) Тогда
				Номенклатура = ТекСтрока.Блюдо;
				Характеристика = ТекСтрока.ХарактеристикаБлюда;
			Иначе
				Продолжить;
			КонецЕсли;
			
			МассивНоменклатуры.Добавить(Номенклатура);
			
			НоваяСтрока = ВременнаяТаблицаНоменклатуры.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.Характеристика = Характеристика;
			
		КонецЦикла;
		
		Если ВходныеПараметры.Свойство("ТаблицаРецептурПолная") Тогда
			ТаблицаРецептур = ВходныеПараметры.ТаблицаРецептурПолная;
			ВходныеПараметры.Удалить("ТаблицаРецептурПолная");
		Иначе
			ТаблицаРецептур = ПолучитьАктуальныеРецептуры(ВременнаяТаблицаНоменклатуры, ПараметрыОтчета);
		КонецЕсли;
		
		Если ПараметрыОтчета.ИспользоватьСезонныеПроценты 
			И УровеньВложенности > 1 Тогда
			СезонныеКоэффициенты = питЛицензированиеСервер.ПолучитьСезонныеКоэффициентыСпискаНоменклатуры(
				МассивНоменклатуры,
				ПараметрыОтчета.Период.Дата); 
		Иначе
			СезонныеКоэффициенты = Новый Соответствие;
		КонецЕсли;
		
		ТаблицаЦенИнгредиентов = ПолучитьТаблицуЦенИнгредиентов(ВременнаяТаблицаНоменклатуры,
			ПараметрыОтчета,
			УровеньВложенности - 1);
		ВходныеПараметры.Вставить("ТаблицаРецептур", ТаблицаРецептур);
		ВходныеПараметры.Вставить("ТаблицаЦен", ТаблицаЦенИнгредиентов);
		ВходныеПараметры.Вставить("СезонныеКоэффициенты", СезонныеКоэффициенты);
		
		// Соединим таблицу блюд с рецептурой и получим новую таблицу ингредиентов.
		ТаблицаИнгредиентов = ЗаполнитьТаблицыСвязаннымиДанными(ТаблицаБлюд, 
			ВходныеПараметры, 
			УровеньВложенности);
		Если НЕ ЗначениеЗаполнено(ТаблицаИнгредиентов) Тогда
			Прервать;
		КонецЕсли;
		
		// Зафиксируем таблицу ингредиентов.
		МассивТаблицДанных.Добавить(ТаблицаИнгредиентов);
		
		// Увеличим уровень вложенности.
		УровеньВложенности = УровеньВложенности + 1;
		
		ТаблицаБлюд = ТаблицаИнгредиентов;
	КонецЦикла;
КонецПроцедуры

// Функция - Заполнить таблицы связанными данными.
//
// Параметры:
//  ТаблицаБлюд - ТаблицаЗначений - Таблица блюд.
//  ВходныеПараметры - Произвольный - Входные параметры.
//  УровеньВложенности - Произвольный - Уровень вложенности.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ЗаполнитьТаблицыСвязаннымиДанными(ТаблицаБлюд, ВходныеПараметры, УровеньВложенности)
	
	Если НЕ ТаблицаБлюд.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущийУровень = ТаблицаБлюд[0].Уровень;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = ПоместитьСвязанныеТаблицыВЗапрос(Запрос, 
		ТаблицаБлюд, ВходныеПараметры.ТаблицаРецептур, ВходныеПараметры.ТаблицаЦен,
		"ВТ_ТаблицаБлюд", "ВТ_Рецептуры", "ВТ_ТаблицаЦен");
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВТ_ТаблицаБлюд.Блюдо КАК Блюдо,
	|	ВТ_ТаблицаБлюд.ИсходноеБлюдо КАК ИсходноеБлюдо,
	|	ВТ_ТаблицаБлюд.Ингредиент КАК Ингредиент,
	|	ВТ_ТаблицаБлюд.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
	|	ВТ_ТаблицаБлюд.ХарактеристикаИсходногоБлюда КАК ХарактеристикаИсходногоБлюда,
	|	ВТ_ТаблицаБлюд.ХарактеристикаИнгредиента КАК ХарактеристикаИнгредиента,
	|	ЕстьNULL(ВТ_Рецептуры.Рецептура, ЗНАЧЕНИЕ(Документ.питРецептура.ПустаяСсылка)) КАК РецептураБлюда,
	|	ВТ_ТаблицаБлюд.РецептураРодителя КАК РецептураРодителя,
	|	ВТ_ТаблицаБлюд.КоличествоБлюда КАК КоличествоБлюда,
	|	ВТ_ТаблицаБлюд.КоличествоУпаковокБлюда КАК КоличествоУпаковокБлюда,
	|	ВТ_ТаблицаБлюд.КоличествоИнгредиента КАК КоличествоИнгредиента,
	|	ВТ_ТаблицаБлюд.КоличествоИнгредиентаНетто КАК КоличествоИнгредиентаНетто,
	|	ВТ_ТаблицаБлюд.КоличествоИнгредиентаВыход КАК КоличествоИнгредиентаВыход,
	|	ВТ_ТаблицаБлюд.КоличествоУпаковокИнгредиента КАК КоличествоУпаковокИнгредиента,
	|	ВТ_ТаблицаБлюд.КоличествоУпаковокИнгредиентаНетто КАК КоличествоУпаковокИнгредиентаНетто,
	|	ВТ_ТаблицаБлюд.КоличествоУпаковокИнгредиентаВыход КАК КоличествоУпаковокИнгредиентаВыход,
	|	ВТ_ТаблицаБлюд.КлючИсточника КАК КлючИсточника,
	|	ВТ_ТаблицаБлюд.КлючПриемника КАК КлючПриемника,
	|	ВТ_ТаблицаБлюд.КлючИсходногоБлюда КАК КлючИсходногоБлюда,
