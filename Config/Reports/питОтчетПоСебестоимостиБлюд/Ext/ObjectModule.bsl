	|	ВТ_ДанныеПоБлюдам.Уровень,
	|	ВЫБОР КОГДА ВТ_ДанныеПоБлюдам.Уровень = 0 
	|		ТОГДА ВТ_ДанныеПоБлюдам.ЕдиницаИзмерения 
	|		ИНАЧЕ ВТ_ДанныеПоБлюдам.ЕдиницаИзмеренияИнгредиента 
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ЕдиницаИзмеренияПоРецептуре
	|			ТОГДА ОбщепитРецептураТовары.Упаковка
	|		ИНАЧЕ ОбщепитРецептураТовары.Номенклатура.ЕдиницаИзмерения
	|	КОНЕЦ,
	|	ВЫБОР 
	|		КОГДА ВТ_ДанныеПоБлюдам.Уровень = 0 
	|		ТОГДА ВТ_ДанныеПоБлюдам.КоличествоБлюда 
	|		ИНАЧЕ ВТ_ДанныеПоБлюдам.КоличествоИнгредиента 
	|	КОНЕЦ,
	|	ВЫБОР 
	|		КОГДА ВТ_ДанныеПоБлюдам.Уровень = 0 
	|		ТОГДА ВТ_ДанныеПоБлюдам.КоличествоУпаковокБлюда 
	|		ИНАЧЕ ВТ_ДанныеПоБлюдам.КоличествоУпаковокИнгредиента 
	|	КОНЕЦ,
	|	ВТ_ДанныеПоБлюдам.Цена";
	
	Запрос.УстановитьПараметр("РецептураПустаяСсылка", Документы.питРецептура.ПустаяСсылка());
	Запрос.УстановитьПараметр("УказанноеКоличество", ВходныеПараметры.УказанноеКоличество);
	Запрос.УстановитьПараметр("НаУказанноеКоличество", ВходныеПараметры.НаУказанноеКоличество);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияПоРецептуре", ВходныеПараметры.ЕдиницаИзмеренияПоРецептуре);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияПоРецептуреБлюда", ВходныеПараметры.ЕдиницаИзмеренияПоРецептуреБлюда);
	
	ТекстЗапросаКоэффициентУпаковкиБлюда = Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
		"ВТ_ДанныеПоБлюдам.ЕдиницаИзмерения",
		"ВТ_ДанныеПоБлюдам.Номенклатура");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
								"&ТекстЗапросаКоэффициентУпаковкиБлюда",
								ТекстЗапросаКоэффициентУпаковкиБлюда);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатЗапроса[2].Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаБлюд.Очистить();
	Выборка = РезультатЗапроса[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаБлюд.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		Если ВходныеПараметры.ИспользоватьСезонныеПроценты Тогда
			СезонныеПотери = ВходныеПараметры.СезонныеКоэффициенты[НоваяСтрока.Ингредиент];
			Если НЕ СезонныеПотери = Неопределено Тогда
				НоваяСтрока.КоличествоИнгредиента = НоваяСтрока.КоличествоИнгредиента 
					* СезонныеПотери;
				НоваяСтрока.КоличествоУпаковокИнгредиента = НоваяСтрока.КоличествоУпаковокИнгредиента 
					* СезонныеПотери;
				НоваяСтрока.Сумма       = НоваяСтрока.Сумма
					* СезонныеПотери;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если РезультатЗапроса[3].Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаИнгредиентов = ТаблицаДанныхПустая();
	Выборка = РезультатЗапроса[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаИнгредиентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		НоваяСтрока.Уровень = УровеньВложенности;
		НоваяСтрока.КлючИсточника = ВходныеПараметры.КлючСвязиСквозной;
		ВходныеПараметры.КлючСвязиСквозной = ВходныеПараметры.КлючСвязиСквозной + 1;
		
	КонецЦикла;
	
	Возврат ТаблицаИнгредиентов;
КонецФункции

// Функция - Поместить связанные таблицы в запрос.
//
// Параметры:
//  Запрос - Произвольный - Запрос.
//  ТаблицаБлюд - ТаблицаЗначений - Таблица блюд.
//  ТаблицаРецептур - ТаблицаЗначений - Таблица рецептур.
//  ТаблицаЦен - ТаблицаЗначений - Таблица цен.
//  ИмяТаблицаБлюд - ТаблицаЗначений - Имя таблица блюд.
//  ИмяТаблицаРецептур - ТаблицаЗначений - Имя таблица рецептур.
//  ИмяТаблицаЦен - ТаблицаЗначений - Имя таблица цен.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
Функция ПоместитьСвязанныеТаблицыВЗапрос(Запрос, ТаблицаБлюд, ТаблицаРецептур, ТаблицаЦен,
	ИмяТаблицаБлюд, ИмяТаблицаРецептур, ИмяТаблицаЦен)
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТаблицаБлюд.Уровень = 0
	|			ТОГДА ТаблицаБлюд.Блюдо
	|		ИНАЧЕ ТаблицаБлюд.Ингредиент
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ТаблицаБлюд.Уровень = 0
	|			ТОГДА ТаблицаБлюд.ХарактеристикаБлюда
	|		ИНАЧЕ ТаблицаБлюд.ХарактеристикаИнгредиента
	|	КОНЕЦ КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ТаблицаБлюд.Ингредиент = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ТаблицаБлюд.КоличествоБлюда
	|		ИНАЧЕ ТаблицаБлюд.КоличествоИнгредиента
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаБлюд.Ингредиент = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ТаблицаБлюд.КоличествоУпаковокБлюда
	|		ИНАЧЕ ТаблицаБлюд.КоличествоУпаковокИнгредиента
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ТаблицаБлюд.Блюдо КАК Блюдо,
	|	ТаблицаБлюд.ИсходноеБлюдо КАК ИсходноеБлюдо,
	|	ТаблицаБлюд.Ингредиент КАК Ингредиент,
	|	ТаблицаБлюд.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
	|	ТаблицаБлюд.ХарактеристикаИсходногоБлюда КАК ХарактеристикаИсходногоБлюда,
	|	ТаблицаБлюд.ХарактеристикаИнгредиента КАК ХарактеристикаИнгредиента,
	|	ТаблицаБлюд.РецептураБлюда КАК РецептураБлюда,
	|	ТаблицаБлюд.РецептураРодителя КАК РецептураРодителя,
	|	ТаблицаБлюд.КоличествоБлюда КАК КоличествоБлюда,
	|	ТаблицаБлюд.КоличествоУпаковокБлюда КАК КоличествоУпаковокБлюда,
	|	ТаблицаБлюд.КоличествоИнгредиента КАК КоличествоИнгредиента,
	|	ТаблицаБлюд.КоличествоИнгредиентаНетто КАК КоличествоИнгредиентаНетто,
	|	ТаблицаБлюд.КоличествоИнгредиентаВыход КАК КоличествоИнгредиентаВыход,
	|	ТаблицаБлюд.КоличествоУпаковокИнгредиента КАК КоличествоУпаковокИнгредиента,
	|	ТаблицаБлюд.КоличествоУпаковокИнгредиентаНетто КАК КоличествоУпаковокИнгредиентаНетто,
	|	ТаблицаБлюд.КоличествоУпаковокИнгредиентаВыход КАК КоличествоУпаковокИнгредиентаВыход,
	|	ТаблицаБлюд.КлючИсточника КАК КлючИсточника,
	|	ТаблицаБлюд.КлючПриемника КАК КлючПриемника,
	|	ТаблицаБлюд.КлючИсходногоБлюда КАК КлючИсходногоБлюда,
	|	ТаблицаБлюд.Уровень КАК Уровень,
	|	ТаблицаБлюд.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаБлюд.ЕдиницаИзмеренияИнгредиента КАК ЕдиницаИзмеренияИнгредиента
	// 	Сумма
	// 	Выход
	// 	Цена
	// 	ЦенаНормативная
	// 	ЦенаПродажи
	|ПОМЕСТИТЬ ВТ_ТаблицаБлюд
	|ИЗ
	|	&ТаблицаБлюд КАК ТаблицаБлюд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.Характеристика КАК Характеристика,
	|	ТаблицаДанных.Рецептура КАК Рецептура
	|ПОМЕСТИТЬ ВТ_Рецептуры
	|ИЗ
	|	&ТаблицаРецептур КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.Характеристика КАК Характеристика,
	|	ТаблицаДанных.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_ТаблицаЦен
	|ИЗ
	|	&ТаблицаЦен КАК ТаблицаДанных
	|";
	Запрос.УстановитьПараметр("ТаблицаБлюд", ТаблицаБлюд);
	Запрос.УстановитьПараметр("ТаблицаРецептур", ТаблицаРецептур);
	Запрос.УстановитьПараметр("ТаблицаЦен", ТаблицаЦен);
	Запрос.Выполнить();
	Возврат Запрос;
	
КонецФункции


// Процедура - Выполнить обратный проход.
//
// Параметры:
//  МассивТаблицДанных - Массив - Массив таблиц данных.
//
Процедура ВыполнитьОбратныйПроход(МассивТаблицДанных)
	
	КоличествоТаблиц = МассивТаблицДанных.ВГраница();
	
	Для Счет = 0 По КоличествоТаблиц Цикл
		
		Если КоличествоТаблиц - Счет < 1 Тогда
			Прервать;
		КонецЕсли; 
		
		ТаблицаДляГруппировки = МассивТаблицДанных[КоличествоТаблиц - Счет];
		ТаблицаДляСохранения = МассивТаблицДанных[КоличествоТаблиц - Счет - 1];
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДанных.Сумма КАК Сумма,
		|	ТаблицаДанных.КлючПриемника КАК КлючПриемника
		|ПОМЕСТИТЬ ВТ_ТаблицаДляГруппировки
		|ИЗ
		|	&ТаблицаГруппировки КАК ТаблицаДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДанных.Блюдо КАК Блюдо,
		|	ТаблицаДанных.ИсходноеБлюдо КАК ИсходноеБлюдо,
		|	ТаблицаДанных.Ингредиент КАК Ингредиент,
		|	ТаблицаДанных.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
		|	ТаблицаДанных.ХарактеристикаИсходногоБлюда КАК ХарактеристикаИсходногоБлюда,
		|	ТаблицаДанных.ХарактеристикаИнгредиента КАК ХарактеристикаИнгредиента,
		|	ТаблицаДанных.РецептураБлюда КАК РецептураБлюда,
		|	ТаблицаДанных.РецептураРодителя КАК РецептураРодителя,
		|	ТаблицаДанных.КоличествоБлюда КАК КоличествоБлюда,
		|	ТаблицаДанных.КоличествоУпаковокБлюда КАК КоличествоУпаковокБлюда,
		|	ТаблицаДанных.КоличествоИнгредиента КАК КоличествоИнгредиента,
		|	ТаблицаДанных.КоличествоУпаковокИнгредиента КАК КоличествоУпаковокИнгредиента,
		|	ТаблицаДанных.Сумма КАК Сумма,
		|	ТаблицаДанных.КлючИсточника КАК КлючИсточника,
		|	ТаблицаДанных.КлючПриемника КАК КлючПриемника,
		|	ТаблицаДанных.КлючИсходногоБлюда КАК КлючИсходногоБлюда,
		|	ТаблицаДанных.Уровень КАК Уровень,
		|	ТаблицаДанных.Выход КАК Выход,
		|	ТаблицаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТаблицаДанных.ЕдиницаИзмеренияИнгредиента КАК ЕдиницаИзмеренияИнгредиента,
		|	ТаблицаДанных.Цена КАК Цена,
		|	ТаблицаДанных.ЦенаПродажи КАК ЦенаПродажи
		|ПОМЕСТИТЬ ВТ_ТаблицаДляСохранения
		|ИЗ
		|	&ТаблицаДляСохранения КАК ТаблицаДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВТ_ТаблицаДляГруппировки.Сумма) КАК Сумма,
		|	ВТ_ТаблицаДляГруппировки.КлючПриемника КАК КлючПриемника
		|ПОМЕСТИТЬ ВТ_ТаблицаСГруппировкой
		|ИЗ
		|	ВТ_ТаблицаДляГруппировки КАК ВТ_ТаблицаДляГруппировки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТаблицаДляГруппировки.КлючПриемника
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаДляСохранения.Блюдо КАК Блюдо,
		|	ВТ_ТаблицаДляСохранения.ИсходноеБлюдо КАК ИсходноеБлюдо,
		|	ВТ_ТаблицаДляСохранения.Ингредиент КАК Ингредиент,
		|	ВТ_ТаблицаДляСохранения.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
		|	ВТ_ТаблицаДляСохранения.ХарактеристикаИсходногоБлюда КАК ХарактеристикаИсходногоБлюда,
		|	ВТ_ТаблицаДляСохранения.ХарактеристикаИнгредиента КАК ХарактеристикаИнгредиента,
		|	ВТ_ТаблицаДляСохранения.РецептураБлюда КАК РецептураБлюда,
		|	ВТ_ТаблицаДляСохранения.РецептураРодителя КАК РецептураРодителя,
		|	ВТ_ТаблицаДляСохранения.КоличествоБлюда КАК КоличествоБлюда,
		|	ВТ_ТаблицаДляСохранения.КоличествоУпаковокБлюда КАК КоличествоУпаковокБлюда,
		|	ВТ_ТаблицаДляСохранения.КоличествоИнгредиента КАК КоличествоИнгредиента,
		|	ВТ_ТаблицаДляСохранения.КоличествоУпаковокИнгредиента КАК КоличествоУпаковокИнгредиента,
		|	ВТ_ТаблицаДляСохранения.КлючИсточника КАК КлючИсточника,
		|	ВТ_ТаблицаДляСохранения.КлючПриемника КАК КлючПриемника,
		|	ВТ_ТаблицаДляСохранения.КлючИсходногоБлюда КАК КлючИсходногоБлюда,
		|	ВТ_ТаблицаДляСохранения.Уровень КАК Уровень,
		|	ВТ_ТаблицаДляСохранения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ_ТаблицаДляСохранения.ЕдиницаИзмеренияИнгредиента КАК ЕдиницаИзмеренияИнгредиента,
		|	ВТ_ТаблицаДляСохранения.Цена КАК Цена,
		|	ВТ_ТаблицаДляСохранения.ЦенаПродажи КАК ЦенаПродажи,
		|	ВТ_ТаблицаДляСохранения.Выход КАК Выход,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаДляСохранения.РецептураБлюда = &РецептураПустаяСсылка
		|			ТОГДА ВТ_ТаблицаДляСохранения.Сумма
		|		ИНАЧЕ ЕСТЬNULL(ВТ_ТаблицаСГруппировкой.Сумма, 0)
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	ВТ_ТаблицаДляСохранения КАК ВТ_ТаблицаДляСохранения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаСГруппировкой КАК ВТ_ТаблицаСГруппировкой
		|		ПО ВТ_ТаблицаДляСохранения.КлючИсточника = ВТ_ТаблицаСГруппировкой.КлючПриемника";
		Запрос.УстановитьПараметр("ТаблицаГруппировки", ТаблицаДляГруппировки);
		Запрос.УстановитьПараметр("ТаблицаДляСохранения", ТаблицаДляСохранения);
		Запрос.УстановитьПараметр("РецептураПустаяСсылка", Документы.питРецептура.ПустаяСсылка());
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаДляСохранения.Очистить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаДляСохранения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Процедура - Дозаполнить начальный уровень.
//
// Параметры:
//  ТаблицаИсходныхБлюд - ТаблицаЗначений - Таблица исходных блюд.
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//
Процедура ДозаполнитьНачальныйУровень(ТаблицаИсходныхБлюд, ПараметрыОтчета)
	
	Запрос = Новый Запрос;
	ТекстЗапроса1 = 
	"ВЫБРАТЬ
	|	ТаблицаДанных.Блюдо КАК Блюдо,
	|	ТаблицаДанных.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
	|	ТаблицаДанных.РецептураБлюда КАК РецептураБлюда,
	|	ТаблицаДанных.КоличествоУпаковокБлюда КАК КоличествоУпаковокБлюда,
	|	ТаблицаДанных.КоличествоБлюда КАК КоличествоБлюда,
	|	&ВсеПоляТаблицы КАК ВсеПоляТаблицы
	|ПОМЕСТИТЬ ВТ_ТаблицаИсходная
	|ИЗ
	|	&ТаблицаИсходныхБлюд КАК ТаблицаДанных
	|";
	
	ТекстЗапросаСебестоимостьПоследнегоВыпуска = ТекстЗапросаСебестоимостьПоследнегоВыпуска("ВТ_ТаблицаИсходная");
	
	ТекстЗапроса2 = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &ЕдиницаИзмеренияПоРецептуре
	|				И НЕ ОбщепитРецептура.Упаковка ЕСТЬ NULL И НЕ ОбщепитРецептура.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ОбщепитРецептура.Упаковка
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ТаблицаДанных.Блюдо КАК Блюдо,
	|	ТаблицаДанных.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
	|	ТаблицаДанных.РецептураБлюда КАК РецептураБлюда,
	|	ЕСТЬNULL(ВТ_ЦенаПродажи.Цена, 0) * ТаблицаДанных.КоличествоБлюда * ЕСТЬNULL(&ТекстЗапросаКоэффициентЦены1, 1) КАК Цена,
	|	ЕСТЬNULL(ВТ_ЦенаНормативная.Цена, 0) КАК ЦенаНормативнаяПоРегистру,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(резТаблицаСебестоимости.Сумма, 0) = 0
	|			ТОГДА ЕСТЬNULL(ВТ_ЦенаНормативная.Цена, 0) * ЕСТЬNULL(&ТекстЗапросаКоэффициентЦены2, 1)
	|		ИНАЧЕ ЕСТЬNULL(резТаблицаСебестоимости.Сумма, 0) / ВЫБОР
	|				КОГДА ЕСТЬNULL(резТаблицаСебестоимости.Количество, 0) = 0
	|					ТОГДА 1
	|				ИНАЧЕ ЕСТЬNULL(резТаблицаСебестоимости.Количество, 0)
	|			КОНЕЦ
	|	КОНЕЦ * ТаблицаДанных.КоличествоБлюда КАК ЦенаНормативная,
	|	&ВсеПоляТаблицы КАК ВсеПоляТаблицы
	|ИЗ
	|	ВТ_ТаблицаИсходная КАК ТаблицаДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питРецептура КАК ОбщепитРецептура
	|		ПО ТаблицаДанных.РецептураБлюда = ОбщепитРецептура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТаблицаДанных.Блюдо = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦенаПродажи КАК ВТ_ЦенаПродажи
	|		ПО ТаблицаДанных.Блюдо = ВТ_ЦенаПродажи.Номенклатура
	|			И ТаблицаДанных.ХарактеристикаБлюда = ВТ_ЦенаПродажи.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦенаНормативная КАК ВТ_ЦенаНормативная
	|		ПО ТаблицаДанных.Блюдо = ВТ_ЦенаНормативная.Номенклатура
	|			И ТаблицаДанных.ХарактеристикаБлюда = ВТ_ЦенаНормативная.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ резТаблицаСебестоимости КАК резТаблицаСебестоимости
	|		ПО ТаблицаДанных.Блюдо = резТаблицаСебестоимости.Номенклатура
	|			И ТаблицаДанных.ХарактеристикаБлюда = резТаблицаСебестоимости.Характеристика
	|
	|УПОРЯДОЧИТЬ ПО
	|	СпрНоменклатура.Наименование";
	
	// +пит
	ТекстЗапросаШаблон = 
	"%1
	|;
	|%2
	|
	|%3
	|;
	|%4
	|;
	|%5
	|";
	ТекстЦеныКомплексныйОтбор = 
		питЦеныНоменклатуры.ПреобразоватьТекстКомплексногоОтбора(ПараметрыОтчета.Период.Дата, 
		"(Номенклатура, Характеристика) В
		|					(ВЫБРАТЬ
		|						ВТ_ТаблицаИсходная.Блюдо КАК Блюдо,
		|						ВТ_ТаблицаИсходная.ХарактеристикаБлюда КАК Характеристика
		|					ИЗ
		|						ВТ_ТаблицаИсходная КАК ВТ_ТаблицаИсходная)");
	ИмяПараметраДатаФормирования = "ДатаФормирования";
	ТекстЗапросаЦены1 = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ПараметрыОтчета.Период.Дата, 
	"ВТ_ЦенаПродажи", ИмяПараметраДатаФормирования, "", "", "ТипЦен", ТекстЦеныКомплексныйОтбор);
	ТекстЗапросаЦены2 = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ПараметрыОтчета.Период.Дата, 
	"ВТ_ЦенаНормативная", ИмяПараметраДатаФормирования, "", "", "НормативныйВидЦен", ТекстЦеныКомплексныйОтбор);
	УсловиеСоединенияХарактеристика = питЦеныНоменклатуры.УсловиеСоединенияХарактеристика(ПараметрыОтчета.Период.Дата, 
		"ТаблицаДанных", "ХарактеристикаБлюда", "ВТ_ЦенаПродажи");
	ТекстЗапроса2 = СтрЗаменить(ТекстЗапроса2,
		"ТаблицаДанных.ХарактеристикаБлюда = ВТ_ЦенаПродажи.Характеристика",
		УсловиеСоединенияХарактеристика);
	УсловиеСоединенияХарактеристика = питЦеныНоменклатуры.УсловиеСоединенияХарактеристика(ПараметрыОтчета.Период.Дата, 
		"ТаблицаДанных", "ХарактеристикаБлюда", "ВТ_ЦенаНормативная");
	ТекстЗапроса2 = СтрЗаменить(ТекстЗапроса2,
		"ТаблицаДанных.ХарактеристикаБлюда = ВТ_ЦенаНормативная.Характеристика",
		УсловиеСоединенияХарактеристика);
	Запрос.Текст = СтрШаблон(ТекстЗапросаШаблон, 
		ТекстЗапроса1, 
		ТекстЗапросаСебестоимостьПоследнегоВыпуска, 
		ТекстЗапросаЦены1, 
		ТекстЗапросаЦены2, 
		ТекстЗапроса2);
		
	ТекстЗапросаКоэффициентЦены1 = Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"ВТ_ЦенаПродажи.Упаковка",
			"ВТ_ЦенаПродажи.Номенклатура");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ТекстЗапросаКоэффициентЦены1",
		ТекстЗапросаКоэффициентЦены1);
	ТекстЗапросаКоэффициентЦены2 = Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"ВТ_ЦенаНормативная.Упаковка",
			"ВТ_ЦенаНормативная.Номенклатура");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ТекстЗапросаКоэффициентЦены2",
		ТекстЗапросаКоэффициентЦены2);
	
	// -пит
	
	// Параметры поиска выпусков блюд
	// &ОтборПоДатеВыпусков И &ОтборПоОрганизацииВыпусков И &ОтборПоПодразделениюВыпусков И &ОтборПоСкладуВыпусков
	Если ЗначениеЗаполнено(ПараметрыОтчета.Период.Дата) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоДатеВыпусков", СтрШаблон("питВыпускБлюд.Дата <= &%1", ИмяПараметраДатаФормирования));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоДатеВыпусков", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоОрганизацииВыпусков", "питВыпускБлюд.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоОрганизацииВыпусков", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.Подразделение) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоПодразделениюВыпусков", "питВыпускБлюд.Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение", ПараметрыОтчета.Подразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоПодразделениюВыпусков", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.Склад) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСкладуВыпусков", "питВыпускБлюд.Склад = &Склад");
		Запрос.УстановитьПараметр("Склад", ПараметрыОтчета.Склад);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоСкладуВыпусков", "ИСТИНА");
	КонецЕсли;
	
	
	Запрос.УстановитьПараметр("ТаблицаИсходныхБлюд", ТаблицаИсходныхБлюд);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияПоРецептуре", ПараметрыОтчета.РецептурнаяЕдиницаБлюда=0);
	Запрос.УстановитьПараметр("ТипЦен", ПараметрыОтчета.РозничныйТипЦен);
	Запрос.УстановитьПараметр(ИмяПараметраДатаФормирования, КонецДня(ПараметрыОтчета.Период.Дата));
	Запрос.УстановитьПараметр("НормативныйВидЦен", ПараметрыОтчета.НормативныйТипЦен);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ВсеПоляТаблицы КАК ВсеПоляТаблицы", "ТаблицаДанных.*");
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Такого быть не должно.
		Возврат;
	КонецЕсли;
	ТаблицаИсходныхБлюд.Очистить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаИсходныхБлюд.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ЦенаПродажи = НоваяСтрока.Цена;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - Текст запроса себестоимость последнего выпуска.
//
// Параметры:
//  ИмяВТТаблицаИсходная - ТаблицаЗначений - Имя вт таблица исходная.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстЗапросаСебестоимостьПоследнегоВыпуска(ИмяВТТаблицаИсходная)
	
	ТекстЗапросаВТВыпускиПродукции = "ВЫБРАТЬ
	|	МАКСИМУМ(питВыпускБлюд.Ссылка) КАК ВыпускБлюд,
	|	МАКСИМУМ(питВыпускБлюд.Дата) КАК ВыпускБлюдДата,
	|	питВыпускБлюдБлюда.Номенклатура КАК Номенклатура,
	|	питВыпускБлюдБлюда.Характеристика КАК Характеристика,
	|	питВыпускБлюдБлюда.Рецептура КАК Рецептура
	|ПОМЕСТИТЬ втДатыВыпусков
	|ИЗ
	|	Документ.питВыпускБлюд.Блюда КАК питВыпускБлюдБлюда
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд КАК питВыпускБлюд
	|		ПО питВыпускБлюдБлюда.Ссылка = питВыпускБлюд.Ссылка
	|ГДЕ
	|	&ОтборПоДатеВыпусков И &ОтборПоОрганизацииВыпусков И &ОтборПоПодразделениюВыпусков И &ОтборПоСкладуВыпусков И
	|	(питВыпускБлюдБлюда.Номенклатура, питВыпускБлюдБлюда.Характеристика, питВыпускБлюдБлюда.Рецептура) В
	|			(ВЫБРАТЬ
	|				ТаблицаДанных.Блюдо КАК Номенклатура,
	|				ТаблицаДанных.ХарактеристикаБлюда КАК Характеристика,
	|				ТаблицаДанных.РецептураБлюда КАК Рецептура
	|			ИЗ
	|				ВТ_ТаблицаИсходная КАК ТаблицаДанных)
	|	И питВыпускБлюд.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдБлюда.Номенклатура,
	|	питВыпускБлюдБлюда.Характеристика,
	|	питВыпускБлюдБлюда.Рецептура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДатыВыпусков.Номенклатура КАК Номенклатура,
	|	втДатыВыпусков.Характеристика КАК Характеристика,
	|	втДатыВыпусков.Рецептура КАК Рецептура,
	|	питВыпускБлюдБлюда.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	питВыпускБлюдБлюда.КоличествоУпаковокНоменклатуры КАК КоличествоУпаковокНоменклатуры,
	|	питВыпускБлюдБлюда.УпаковкаНоменклатуры КАК УпаковкаНоменклатуры,
	|	питВыпускБлюдБлюда.Ссылка КАК ВыпускБлюд
	|ПОМЕСТИТЬ втВыпускиБлюд
	|ИЗ
	|	втДатыВыпусков КАК втДатыВыпусков
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд.Блюда КАК питВыпускБлюдБлюда
	|		ПО втДатыВыпусков.ВыпускБлюдДата = питВыпускБлюдБлюда.Ссылка.Дата
	|			И втДатыВыпусков.ВыпускБлюд = питВыпускБлюдБлюда.Ссылка
	|			И втДатыВыпусков.Номенклатура = питВыпускБлюдБлюда.Номенклатура
	|			И втДатыВыпусков.Характеристика = питВыпускБлюдБлюда.Характеристика
	|			И втДатыВыпусков.Рецептура = питВыпускБлюдБлюда.Рецептура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питТиповыеДокументы.ДокументОбщепит КАК ВыпускБлюд,
	|	МАКСИМУМ(ВЫРАЗИТЬ(питТиповыеДокументы.ТиповойДокумент КАК Документ.ПроизводствоБезЗаказа).Ссылка) КАК ВыпускПродукции,
	|	МАКСИМУМ(ВЫРАЗИТЬ(питТиповыеДокументы.ТиповойДокумент КАК Документ.ПроизводствоБезЗаказа).Дата) КАК ВыпускПродукцииДата
	|ПОМЕСТИТЬ втДатыПроизводств
	|ИЗ
	|	РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|ГДЕ
	|	питТиповыеДокументы.ТиповойДокумент ССЫЛКА Документ.ПроизводствоБезЗаказа
	|	И питТиповыеДокументы.Синхронизирован
	|	И ВЫРАЗИТЬ(питТиповыеДокументы.ТиповойДокумент КАК Документ.ПроизводствоБезЗаказа).Проведен
	|	И питТиповыеДокументы.ДокументОбщепит В
	|			(ВЫБРАТЬ
	|				ВТВыпуски.ВыпускБлюд КАК ДокументОбщепит
	|			ИЗ
	|				втВыпускиБлюд КАК ВТВыпуски)
	|
	|СГРУППИРОВАТЬ ПО
	|	питТиповыеДокументы.ДокументОбщепит
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДатыПроизводств.ВыпускБлюд КАК ВыпускБлюд,
	|	ПроизводствоБезЗаказа.Ссылка КАК ВыпускПродукции
	|ПОМЕСТИТЬ ВТВыпускиПродукции
	|ИЗ
	|	втДатыПроизводств КАК втДатыПроизводств
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПроизводствоБезЗаказа КАК ПроизводствоБезЗаказа
	|		ПО втДатыПроизводств.ВыпускПродукцииДата = ПроизводствоБезЗаказа.Дата
	|			И втДатыПроизводств.ВыпускПродукции = ПроизводствоБезЗаказа.Ссылка
	|;
	|
	|";
	
	ТекстЗапроса = СтрШаблон("%1 %2",
		ТекстЗапросаВТВыпускиПродукции,
		питОтчеты.ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов22("ВТВыпускиПродукции", Истина, Истина));
		
	Возврат ТекстЗапроса;
	
	
КонецФункции


// Процедура - Завершить подготовку таблицы данных.
//
// Параметры:
//  ТаблицаИсходныхБлюд - ТаблицаЗначений - Таблица исходных блюд.
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//
Процедура ЗавершитьПодготовкуТаблицыДанных(ТаблицаИсходныхБлюд, ПараметрыОтчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДанных.Блюдо КАК Блюдо,
	|	ТаблицаДанных.ИсходноеБлюдо КАК ИсходноеБлюдо,
	|	ТаблицаДанных.Ингредиент КАК Ингредиент,
	|	ТаблицаДанных.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
	|	ТаблицаДанных.ХарактеристикаИсходногоБлюда КАК ХарактеристикаИсходногоБлюда,
	|	ТаблицаДанных.ХарактеристикаИнгредиента КАК ХарактеристикаИнгредиента,
	|	ТаблицаДанных.РецептураБлюда КАК РецептураБлюда,
	|	ТаблицаДанных.РецептураРодителя КАК РецептураРодителя,
	|	ТаблицаДанных.КоличествоБлюда КАК КоличествоБлюда,
	|	ТаблицаДанных.КоличествоУпаковокБлюда КАК КоличествоУпаковокБлюда,
	|	ТаблицаДанных.КоличествоИнгредиента КАК КоличествоИнгредиента,
	|	ТаблицаДанных.КоличествоУпаковокИнгредиента КАК КоличествоУпаковокИнгредиента,
	|	ТаблицаДанных.Сумма КАК Сумма,
	|	ТаблицаДанных.КлючИсточника КАК КлючИсточника,
	|	ТаблицаДанных.КлючПриемника КАК КлючПриемника,
	|	ТаблицаДанных.КлючИсходногоБлюда КАК КлючИсходногоБлюда,
	|	ТаблицаДанных.Уровень КАК Уровень,
	|	ТаблицаДанных.Выход КАК Выход,
	|	ТаблицаДанных.Цена КАК Цена,
	|	ТаблицаДанных.ЦенаНормативная КАК ЦенаНормативная,
	|	ТаблицаДанных.ЦенаПродажи КАК ЦенаПродажи,
	|	ТаблицаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаДанных.ЕдиницаИзмеренияИнгредиента КАК ЕдиницаИзмеренияИнгредиента
	|ПОМЕСТИТЬ ВТ_ТаблицаИсходная
	|ИЗ
	|	&ТаблицаИсходныхБлюд КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаИсходная.Блюдо КАК Блюдо,
	|	ВТ_ТаблицаИсходная.ИсходноеБлюдо КАК ИсходноеБлюдо,
	|	ВТ_ТаблицаИсходная.Ингредиент КАК Ингредиент,
	|	ВТ_ТаблицаИсходная.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
	|	ВТ_ТаблицаИсходная.ХарактеристикаИсходногоБлюда КАК ХарактеристикаИсходногоБлюда,
	|	ВТ_ТаблицаИсходная.ХарактеристикаИнгредиента КАК ХарактеристикаИнгредиента,
	|	ВТ_ТаблицаИсходная.РецептураБлюда КАК РецептураБлюда,
	|	ВТ_ТаблицаИсходная.РецептураРодителя КАК РецептураРодителя,
	|	ВТ_ТаблицаИсходная.КоличествоБлюда КАК КоличествоБлюда,
	|	ВТ_ТаблицаИсходная.КоличествоУпаковокБлюда КАК КоличествоУпаковокБлюда,
	|	СУММА(ВТ_ТаблицаИсходная.КоличествоИнгредиента) КАК КоличествоИнгредиента,
	|	СУММА(ВТ_ТаблицаИсходная.КоличествоУпаковокИнгредиента) КАК КоличествоУпаковокИнгредиента,
	|	СУММА(ВТ_ТаблицаИсходная.Сумма) КАК Сумма,
	|	ВТ_ТаблицаИсходная.КлючИсточника КАК КлючИсточника,
	|	ВТ_ТаблицаИсходная.КлючПриемника КАК КлючПриемника,
	|	ВТ_ТаблицаИсходная.КлючИсходногоБлюда КАК КлючИсходногоБлюда,
	|	ВТ_ТаблицаИсходная.Уровень КАК Уровень,
	|	ВТ_ТаблицаИсходная.Выход КАК Выход,
	|	ВТ_ТаблицаИсходная.Цена КАК Цена,
	|	ВТ_ТаблицаИсходная.ЦенаНормативная КАК ЦенаНормативная,
	|	ВТ_ТаблицаИсходная.ЦенаПродажи КАК ЦенаПродажи,
	|	ВТ_ТаблицаИсходная.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_ТаблицаИсходная.ЕдиницаИзмеренияИнгредиента КАК ЕдиницаИзмеренияИнгредиента
	|ИЗ
	|	ВТ_ТаблицаИсходная КАК ВТ_ТаблицаИсходная
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицаИсходная.Блюдо,
	|	ВТ_ТаблицаИсходная.ИсходноеБлюдо,
	|	ВТ_ТаблицаИсходная.Ингредиент,
	|	ВТ_ТаблицаИсходная.ХарактеристикаБлюда,
	|	ВТ_ТаблицаИсходная.ХарактеристикаИсходногоБлюда,
	|	ВТ_ТаблицаИсходная.ХарактеристикаИнгредиента,
	|	ВТ_ТаблицаИсходная.РецептураБлюда,
	|	ВТ_ТаблицаИсходная.РецептураРодителя,
	|	ВТ_ТаблицаИсходная.КоличествоБлюда,
	|	ВТ_ТаблицаИсходная.КоличествоУпаковокБлюда,
	|	ВТ_ТаблицаИсходная.КлючИсточника,
	|	ВТ_ТаблицаИсходная.КлючПриемника,
	|	ВТ_ТаблицаИсходная.КлючИсходногоБлюда,
	|	ВТ_ТаблицаИсходная.Уровень,
	|	ВТ_ТаблицаИсходная.Выход,
	|	ВТ_ТаблицаИсходная.Цена,
	|	ВТ_ТаблицаИсходная.ЦенаНормативная,
	|	ВТ_ТаблицаИсходная.ЦенаПродажи,
	|	ВТ_ТаблицаИсходная.ЕдиницаИзмерения,
	|	ВТ_ТаблицаИсходная.ЕдиницаИзмеренияИнгредиента";
	Запрос.УстановитьПараметр("ТаблицаИсходныхБлюд", ТаблицаИсходныхБлюд);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Такого быть не должно.
		Возврат;
	КонецЕсли;
	
	ТаблицаИсходныхБлюд.Очистить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаИсходныхБлюд.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Функция - Получить таблицу цен ингредиентов.
//
// Параметры:
//  ТаблицаНоменклатуры - ТаблицаЗначений - Таблица номенклатуры.
//  ПараметрыОтчета - Произвольный - Параметры отчета.
//  УровеньВложенности - Произвольный - Уровень вложенности.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуЦенИнгредиентов(ТаблицаНоменклатуры, ПараметрыОтчета, УровеньВложенности)
	
	ТаблицаЦен = Новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЦен.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаЦен.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	
	Если УровеньВложенности = 0 
		ИЛИ НЕ ЗначениеЗаполнено(ТаблицаНоменклатуры) Тогда
		Возврат ТаблицаЦен;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МассивПакетов = Новый Массив;
	МассивПакетов.Добавить("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаНоменклатуры.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТаблицаНоменклатуры
	|ИЗ
	|	&ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|");
	
	// +пит
	ТекстЦеныКомплексныйОтбор = 
		питЦеныНоменклатуры.ПреобразоватьТекстКомплексногоОтбора(ПараметрыОтчета.Период.Дата, 
		"(Номенклатура, Характеристика) В
		|					(ВЫБРАТЬ
		|						ВТ_ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
		|						ВТ_ТаблицаНоменклатуры.Характеристика КАК Характеристика
		|					ИЗ
		|						ВТ_ТаблицаНоменклатуры КАК ВТ_ТаблицаНоменклатуры)");
	ИмяПараметраДатаФормирования = "ДатаФормирования";
	ТекстЗапросаЦены = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ПараметрыОтчета.Период.Дата, 
	"ВТ_ЦеныНоменклатуры", ИмяПараметраДатаФормирования, "", "", "НормативныйВидЦен", ТекстЦеныКомплексныйОтбор);
	МассивПакетов.Добавить(ТекстЗапросаЦены);
	// -пит
	
	МассивПакетов.Добавить("ВЫБРАТЬ
	|	ВТ_ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаНоменклатуры.Характеристика КАК Характеристика,
	|	ЕстьNULL(ВТ_ЦеныНоменклатуры.Цена, 0) / ЕСТЬNULL(&ТекстЗапросаКоэфффиент, 1) КАК Цена
	|ИЗ
	|	ВТ_ТаблицаНоменклатуры КАК ВТ_ТаблицаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныНоменклатуры КАК ВТ_ЦеныНоменклатуры
	|		ПО ВТ_ТаблицаНоменклатуры.Номенклатура = ВТ_ЦеныНоменклатуры.Номенклатура
	|			И ВТ_ТаблицаНоменклатуры.Характеристика = ВТ_ЦеныНоменклатуры.Характеристика");
	
	Запрос.Текст = СтрСоединить(МассивПакетов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	УсловиеСоединенияХарактеристика = питЦеныНоменклатуры.УсловиеСоединенияХарактеристика(ПараметрыОтчета.Период.Дата, 
			"ВТ_ТаблицаНоменклатуры", "Характеристика", "ВТ_ЦеныНоменклатуры");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"ВТ_ТаблицаНоменклатуры.Характеристика = ВТ_ЦеныНоменклатуры.Характеристика",
		УсловиеСоединенияХарактеристика);
		
	ТекстЗапросаКоэфффиент = Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"ВТ_ЦеныНоменклатуры.Упаковка",
			"ВТ_ЦеныНоменклатуры.Номенклатура");
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ТекстЗапросаКоэфффиент",
		ТекстЗапросаКоэфффиент);
	
	Запрос.УстановитьПараметр("НормативныйВидЦен", ПараметрыОтчета.НормативныйТипЦен);
	Запрос.УстановитьПараметр(ИмяПараметраДатаФормирования, ПараметрыОтчета.Период.Дата);
	Запрос.УстановитьПараметр("ТаблицаНоменклатуры", ТаблицаНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ТаблицаЦен;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаЦен.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаЦен;
КонецФункции


// Процедура - Установить обязательные настройки
//
// Параметры:
//  ПользовательскиеНастройкиМодифицированы	 - Произвольный	 - Пользовательские настройки модифицированы.
//
Процедура УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы)
	
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек,
		"НормативныйТипЦен", питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит"));
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(КомпоновщикНастроек,
		"Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
	
КонецПроцедуры

// Функция - Вспомогательные параметры отчета.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВспомогательныеПараметрыОтчета()
	
	ВспомогательныеПараметры = Новый Массив;
	
	ВспомогательныеПараметры.Добавить("КоличественныеИтогиПоЕдИзм");
	
	КомпоновкаДанныхСервер.ДобавитьВспомогательныеПараметрыОтчетаПоФункциональнымОпциям(ВспомогательныеПараметры);
	
	Возврат ВспомогательныеПараметры;

КонецФункции

// Функция - Структура заголовков полей единиц измерений.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция СтруктураЗаголовковПолейЕдиницИзмерений()
	
	Возврат КомпоновкаДанныхСервер.ЗаголовкиПолейЕдиницИзмерений(КомпоновщикНастроек);
	
КонецФункции

// Процедура - Настроить параметры отборы по функциональным опциям.
//
// Параметры:
//  КомпоновщикНастроекФормы - Произвольный - Компоновщик настроек формы.
//
Процедура НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЕдиницыИзмеренияДляОтчетов") Тогда
		КомпоновкаДанныхСервер.УдалитьПараметрИзПользовательскихНастроекОтчета(КомпоновщикНастроекФормы, "ЕдиницыКоличества");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли




