////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Определяет режим ввода формулы (вводится ли число или что-то другое)
//
Процедура ОпределитьТекущийРежимВвода()
	ВводЧисла = Ложь;
	ЕстьТочка = Ложь;
	Если ПустаяСтрока(Формула) Тогда
		Возврат;
	КонецЕсли;
	ПослСимвол = Прав(Формула, 1);
	// Число заканчивается на цифру или (что нежелательно) на разделитель
	Если Найти("0123456789,", ПослСимвол) > 0 Тогда
		ВводЧисла = Истина;
		// Теперь узнаем, есть ли разделитель в числе
		Счетчик = СтрДлина(Формула);
		Пока Сред(Формула, Счетчик, 1) <> " " Цикл
			Если Сред(Формула, Счетчик, 1) = "," Тогда
				ЕстьТочка = Истина;
				Возврат;
			КонецЕсли;
			Счетчик = Счетчик - 1;
			Если Счетчик < 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

//  Функция - Вернуть константу.
//
// Параметры:
//  ИмяКонстанты - Произвольный - Имя константы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ВернутьКонстанту(ИмяКонстанты)
	Возврат Константы[ИмяКонстанты].Получить()
КонецФункции

//  Функция - Проверить корректность формулы.
//
// Параметры:
//  СообщенияОбОшибке - Произвольный - Сообщения об ошибке.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПроверитьКорректностьФормулы(СообщенияОбОшибке)
	Возврат питДиетпитание.СинтаксическийКонтрольФормулыКалорийности(Формула, СообщенияОбОшибке)
КонецФункции

//  Функция - Вернуть имя хэх.
//
// Параметры:
//  ХЭХ - Произвольный - Хэх.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ВернутьИмяХЭХ(ХЭХ)
	ИмяХЭХ = Справочники.питХимикоэнергетическиеХарактеристики.ПолучитьИмяПредопределенного(ХЭХ);
	Если ИмяХЭХ = "" Тогда
		ИмяХЭХ = "'" + ХЭХ.Наименование + "'";
	КонецЕсли;
	Возврат ИмяХЭХ;
КонецФункции

//  Функция - Вернуть заголовок команды.
//
// Параметры:
//  ИмяКоманды - Произвольный - Имя команды.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ВернутьЗаголовокКоманды(ИмяКоманды)
	Возврат Элементы[ИмяКоманды].Заголовок;
КонецФункции

#КонецОбласти




