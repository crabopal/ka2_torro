

#Область ПрограммныйИнтерфейс

//  Процедура - Формула открытие завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ФормулаОткрытиеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекФормула = ДополнительныеПараметры.ТекФормула;
	
	
	// Если формула была - спросим, хотят ли новую
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Формула = ТекФормула;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВводЧисла = Ложь;
	ЕстьТочка = Ложь;
	Если (СтрДлина(Формула) > 0) И (Лев(Формула,1) <> " ") Тогда
		Формула = " " + Формула;
	КонецЕсли;
	ОпределитьТекущийРежимВвода();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

//  Процедура - Формула открытие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ФормулаОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка= Ложь;
	// Поищем, откуда брать формулу
	ТекФормула			= ВернутьКонстанту("питФормулаРасчетаКалорийности");
	Источник			= "из константы";
	Если ПустаяСтрока(ТекФормула) Тогда
		ТекФормула = "4 * [Белки] + 9 * [Жиры] + 4 * [Углеводы] + 7 * [Алкоголь]";
		Источник = "по умолчанию";
	КонецЕсли;
	Если ПустаяСтрока(Формула) Тогда
		// Если формулы не было - сразу подставим
		Формула = ТекФормула;
	Иначе
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ФормулаОткрытиеЗавершение", ЭтотОбъект, Новый Структура("ТекФормула", ТекФормула)), "Формула расчета калорийности не пустая! Заменить ее" + Символы.ПС + "на формулу " + Источник + " (" + ТекФормула + ")?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Список хэх выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура СписокХЭХВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ИмяХЭХ = ВернутьИмяХЭХ(ВыбраннаяСтрока);
	ВводЧисла = Ложь;
	ЕстьТочка = Ложь;
	Если (СтрДлина(Формула) > 0) И (Прав(Формула,1) = ",") Тогда
		Формула = Формула + "0";
	КонецЕсли;
	Формула = Формула + " [" + ИмяХЭХ + "]";
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ФОРМЫ ДОКУМЕНТА


//  Процедура - Закрыть с сохранением.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗакрытьССохранением(Команда)
	СообщенияОбОшибке = "";
	Если НЕ ПроверитьКорректностьФормулы(СообщенияОбОшибке) Тогда
		СообщенияОбОшибке = "При проверке корректности формулы калорийности обнаружена ошибка!" + Символы.ПС + СообщенияОбОшибке;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СообщенияОбОшибке;
		Сообщение.Сообщить();
		ПоказатьПредупреждение(Неопределено, "Формула некорректна!");
		Возврат;
	КонецЕсли;
	ОповеститьОВыборе(Формула);
КонецПроцедуры

//  Процедура - Нажатие цифры.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеЦифры(Команда)
	Если Не ВводЧисла Тогда
		ВводЧисла = Истина;
		ЕстьТочка = Ложь;
		Формула = Формула + " ";
	КонецЕсли;
	Формула = Формула + ВернутьЗаголовокКоманды(Команда.Имя);
КонецПроцедуры

//  Процедура - Нажатие знака.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеЗнака(Команда)
	ВводЧисла = Ложь;
	ЕстьТочка = Ложь;
	Если (СтрДлина(Формула) > 0) И (Прав(Формула,1) = ",") Тогда
		Формула = Формула + "0";
	КонецЕсли;
	Формула = Формула + " " + ВернутьЗаголовокКоманды(Команда.Имя);
КонецПроцедуры

//  Процедура - Нажатие точки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеТочки(Команда)
	Если ЕстьТочка ИЛИ (НЕ ВводЧисла)Тогда
		Возврат;
	КонецЕсли;
	ЕстьТочка = Истина;
	Формула = Формула + ",";
КонецПроцедуры

//  Процедура - Нажатие забой.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеЗабой(Команда)
	Если ПустаяСтрока(Формула) Тогда
		Возврат;
	КонецЕсли;
	// Выясним, что мы вводили до этого
	ОпределитьТекущийРежимВвода();
	Если ВводЧисла Тогда
		// Для числа удалим символ
		ЕстьТочка = НЕ Прав(Формула, 1) = ",";
		Формула = Сред(Формула, 1, СтрДлина(Формула) - 1);
		// Может, мы удалили уже всё число
		Если Прав(Формула, 1) = " " Тогда
			Формула = Сред(Формула, 1, СтрДлина(Формула) - 1);
			ВводЧисла = Ложь;
			ЕстьТочка = Ложь;
		КонецЕсли;
		Возврат;
	ИначеЕсли Прав(Формула, 1) = "]" Тогда
		// Удаляем ХЭХ
		Счетчик = СтрДлина(Формула) - 1;
		Пока Сред(Формула, Счетчик, 1) <> "[" Цикл
			Счетчик = Счетчик - 1;
		КонецЦикла;
		// Очищаем ХЭХ (вместе с лидирующим пробелом)
		Формула = Сред(Формула, 1, Счетчик - 2);
		Возврат;
	ИначеЕсли Найти("+-*/", Прав(Формула, 1)) > 0 Тогда
		// Знак операции
		// Удалим вместе с пробелом
		Формула = Сред(Формула, 1, СтрДлина(Формула) - 2);
	ИначеЕсли Найти("(", Прав(Формула, 1)) > 0 Тогда
		// Скобка открывающая
		// Удалим вместе с пробелом
		Формула = Сред(Формула, 1, СтрДлина(Формула) - 2);
	ИначеЕсли Найти(")", Прав(Формула, 1)) > 0 Тогда
		// Скобка закрывающая
		// Удалим 
		Формула = Сред(Формула, 1, СтрДлина(Формула) - 1);
	КонецЕсли;
	ОпределитьТекущийРежимВвода();
	
КонецПроцедуры

//  Процедура - Нажатие стереть.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеСтереть(Команда)
	Формула = "";
	ВводЧисла = Ложь;
	ЕстьТочка = Ложь;
КонецПроцедуры

//  Процедура - Нажатие откр скобка.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеОткрСкобка(Команда)
	ВводЧисла = Ложь;
	ЕстьТочка = Ложь;
	Если (СтрДлина(Формула) > 0) И (Прав(Формула,1) = ",") Тогда
		Формула = Формула + "0";
	КонецЕсли;
	Формула = Формула + " (";
КонецПроцедуры

//  Процедура - Нажатие закр скобка.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеЗакрСкобка(Команда)
	ВводЧисла = Ложь;
	ЕстьТочка = Ложь;
	Если (СтрДлина(Формула) > 0) И (Прав(Формула,1) = ",") Тогда
		Формула = Формула + "0";
	КонецЕсли;
	Формула = Формула + ")";
КонецПроцедуры

#КонецОбласти

