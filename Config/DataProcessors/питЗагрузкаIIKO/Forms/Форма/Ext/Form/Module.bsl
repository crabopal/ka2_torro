 
 
#Область ПрограммныйИнтерфейс
 
#Область РежимНаКлиенте

// Процедура - Асинхрон начать подключение расширения работы с файлами завершение
//
// Параметры:
//  РасширениеПодключено	 - Произвольный - Расширение подключено. 
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура Асинхрон_НачатьПодключениеРасширенияРаботыСФайлами_Завершение(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	Если НЕ РасширениеПодключено Тогда
		// Расширение не установлено, пробуем установить
		Оповещение = Новый ОписаниеОповещения("Асинхрон_НачатьУстановкуРасширенияРаботыСФайламиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ТекстСообщения = НСтр("ru='Для продолжении работы необходимо установить расширение для веб-клиента ""1С:Предприятие"". Установить?'");
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет); 
	Иначе
		Если ДополнительныеПараметры.ЭтоВыборКаталога Тогда
			// Создание объекта
			ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
			ДиалогВыбора.Каталог   = Объект.КаталогЗагрузки;
			ДиалогВыбора.Заголовок = "Выберите каталог с файлами загрузки IIKO...";
			
			// Вызов диалога выбора
			ДиалогВыбора.Показать(Новый ОписаниеОповещения("Асинхрон_ВыбКаталогНачалоВыбора_Завершение", ЭтотОбъект, Новый Структура("ДиалогВыбора", ДиалогВыбора)));
		Иначе
			ДополнительныеПараметры.Вставить("КаталогЗагрузки", Объект.КаталогЗагрузки);
			НачатьПоискФайлов(Новый ОписаниеОповещения("Асинхрон_НачатьПоискФайлов_Завершение", ЭтотОбъект, ДополнительныеПараметры),Объект.КаталогЗагрузки,"\*.csv");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура - Асинхрон начать поиск файлов завершение
//
// Параметры:
//  НайденыеФайлы			 - Произвольный	- Найденые Файлы.
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура Асинхрон_НачатьПоискФайлов_Завершение(НайденыеФайлы, ДополнительныеПараметры) Экспорт
	МассивПередаваемых = Новый Массив;
	Для Каждого Файл Из НайденыеФайлы Цикл
		МассивПередаваемых.Добавить(Новый ОписаниеПередаваемогоФайла(Файл.ПолноеИмя,""));
	КонецЦикла;
	Если МассивПередаваемых.Количество() Тогда
		НачатьПомещениеФайлов(
			Новый ОписаниеОповещения("Асинхрон_НачатьПомещениеФайловЗавершение", ЭтотОбъект, ДополнительныеПараметры), 
			МассивПередаваемых,, Ложь, УникальныйИдентификатор);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не найдены файлы для обработки в каталоге %1", ДополнительныеПараметры.КаталогЗагрузки));
	КонецЕсли;
КонецПроцедуры

// Процедура - Асинхрон начать помещение файлов завершение
//
// Параметры:
//  ПомещенныеФайлы			 - Произвольный	- Помещенные Файлы. 
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура Асинхрон_НачатьПомещениеФайловЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	ВызватьВыполнить(ДополнительныеПараметры.ИмяМетодаНаСервере, ПомещенныеФайлы);
КонецПроцедуры

// Процедура - Асинхрон начать установку расширения работы с файлами завершение
//
// Параметры:
//  Результат				 - Произвольный - Результат.
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура Асинхрон_НачатьУстановкуРасширенияРаботыСФайламиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		НачатьУстановкуРасширенияРаботыСФайлами();
	КонецЕсли;
КонецПроцедуры

// Процедура - Асинхрон выб каталог начало выбора завершение
//
// Параметры:
//  ВыбранныеФайлы			 - Произвольный - Выбранные Файлы.
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура Асинхрон_ВыбКаталогНачалоВыбора_Завершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	ДиалогВыбора = ДополнительныеПараметры.ДиалогВыбора;
	Если (ВыбранныеФайлы <> Неопределено) Тогда
		// Запоминаем выбранный каталог
		Объект.КаталогЗагрузки = ДиалогВыбора.Каталог;
	КонецЕсли;
	УстановитьДоступностьКнопок();
КонецПроцедуры

// Процедура - Выполнить после закрытия вопроса
//
// Параметры:
//  Существует				 - Произвольный	- Существует.
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура ВыполнитьПослеЗакрытияВопроса(Существует, ДополнительныеПараметры) Экспорт
	
   	Если Существует Тогда
		ТекстЗаголовка = СтрШаблон(НСтр("ru='Подключение установлено <%1>'", "ru"),Объект.УчетнаяЗапись);
		ЦветТекста = WebЦвета.Зеленый;
	Иначе
		ТекстЗаголовка = НСтр("ru='Подключение не установлено'", "ru");
		ЦветТекста = WebЦвета.Серый;
	КонецЕсли;
	Элементы.Подключение.ЦветТекста = ЦветТекста;
	Элементы.Подключение.Заголовок = ТекстЗаголовка;
  
КонецПроцедуры

#КонецОбласти

// Процедура - При выборе учетной записи
//
// Параметры:
//  Результат				 - Произвольный - Результат.
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура ПриВыбореУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	Если ДополнительныеПараметры = "Выбор" Тогда
		Объект.УчетнаяЗапись = Результат;
	КонецЕсли;
	
	ПолучитьНастройкиНаСервере();
	ИзменитьРежимОбработки(Объект.ЭтоКлиент);
	
	ИндикацияПараметровПодключенияНаКлиенте();
	ИнициализацияПараметровЗагрузкиНаСервере();
КонецПроцедуры

// Процедура - Выбор команды подключения
//
// Параметры:
//  Результат				 - Произвольный - Результат.
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура ВыборКомандыПодключения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Значение = "Открыть" Тогда
		ОткрытьФорму("Справочник.питУчетныеЗаписиIIKO.ФормаОбъекта", Новый Структура("Ключ",Объект.УчетнаяЗапись),ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ПриВыбореУчетнойЗаписи", ЭтотОбъект, "Открытие"));	
	ИначеЕсли Результат.Значение = "Выбрать" Тогда
		ОткрытьФорму("Справочник.питУчетныеЗаписиIIKO.ФормаВыбора", Новый Структура("РежимВыбора", Истина),ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ПриВыбореУчетнойЗаписи", ЭтотОбъект, "Выбор"));	
	КонецЕсли;
КонецПроцедуры

// Возвращает таблицу соответствий УИД и имени объекта по таблице продаж
//
// Параметры:
//  ТаблицаПродаж		 - Произвольный	 - Таблица продаж.
//  ТаблицаМодификаторов - Произвольный	 - Таблица модификаторов.
//  ТаблицаВидовОплаты	 - Произвольный	 - Таблица видов оплаты.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки. 
//
Функция ПолучитьТаблицуСоответствий(ТаблицаПродаж, ТаблицаМодификаторов, ТаблицаВидовОплаты) Экспорт
	
	Если ТаблицаПродаж = Неопределено ИЛИ ТаблицаПродаж.Количество() = 0 Тогда
		ТаблицаСоответствий = Новый ТаблицаЗначений;
		Возврат ТаблицаСоответствий;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.Номенклатура,
	               |	Продажи.НоменклатураКод,
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.КассаУИД,
	               |	Продажи.КассаКод,
	               |	Продажи.Касса,
	               |	Продажи.ДатаСмены,
	               |	Продажи.НомерСмены,
	               |	Продажи.Ресторан,
	               |	Продажи.РесторанКод,
	               |	Продажи.РесторанУИД,
	               |	Продажи.ХозОперация,
	               |	Продажи.ПричинаОтменСписаний,
	               |	Продажи.ПричинаОтменСписанийКод,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.ЧекУИД,
	               |	Продажи.ЧекНомер,
				   |	Продажи.ТипНоменклатуры,
				   |	Продажи.ТипНоменклатурыУИД,
				   |	Продажи.МестоПечати,
				   |	Продажи.МестоПечатиУИД
	               |ПОМЕСТИТЬ Продажи
	               |ИЗ
	               |	&Продажи КАК Продажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПродажиМодификаторов.Модификатор,
	               |	ПродажиМодификаторов.МодификаторКод,
	               |	ПродажиМодификаторов.МодификаторУИД
	               |ПОМЕСТИТЬ ПродажиМодификаторов
	               |ИЗ
	               |	&ПродажиМодификаторов КАК ПродажиМодификаторов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВидыОплат.ВидОплаты,
	               |	ВидыОплат.ВидОплатыКод,
	               |	ВидыОплат.ВидОплатыУИД
	               |ПОМЕСТИТЬ ВидыОплат
	               |ИЗ
	               |	&ВидыОплат КАК ВидыОплат
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	""питДанныеПродажФронта"" КАК ИмяМетаданных,
	               |	"""" КАК Наименование,
	               |	Продажи.ЧекНомер КАК Код,
	               |	ЛОЖЬ КАК ПометкаУдаления,
	               |	Продажи.ЧекУИД КАК УИД
	               |ПОМЕСТИТЬ Соответствия
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""Номенклатура"",
	               |	Продажи.Номенклатура,
	               |	Продажи.НоменклатураКод,
	               |	ЛОЖЬ,
	               |	Продажи.НоменклатураУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""питМестаПечати"",
	               |	Продажи.МестоПечати,
	               |	Продажи.МестоПечатиУИД,
	               |	ЛОЖЬ,
	               |	Продажи.МестоПечатиУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""ВидыНоменклатуры"",
	               |	Продажи.ТипНоменклатуры,
	               |	Продажи.ТипНоменклатурыУИД,
	               |	ЛОЖЬ,
	               |	Продажи.ТипНоменклатурыУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""питМодификаторы"",
	               |	ПродажиМодификаторов.Модификатор,
	               |	ПродажиМодификаторов.МодификаторКод,
	               |	ЛОЖЬ,
	               |	ПродажиМодификаторов.МодификаторУИД
	               |ИЗ
	               |	ПродажиМодификаторов КАК ПродажиМодификаторов
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""ПодразделенияОрганизаций"",
	               |	Продажи.Ресторан,
	               |	Продажи.РесторанКод,
	               |	ЛОЖЬ,
	               |	Продажи.РесторанУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""питВидыОплатОрганизаций"",
	               |	ВидыОплат.ВидОплаты,
	               |	ВидыОплат.ВидОплатыКод,
	               |	ЛОЖЬ,
	               |	ВидыОплат.ВидОплатыУИД
	               |ИЗ
	               |	ВидыОплат КАК ВидыОплат
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""КассыККМ"",
	               |	Продажи.Касса,
	               |	Продажи.КассаКод,
	               |	ЛОЖЬ,
	               |	Продажи.КассаУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""питПричиныОтменИСписаний"",
	               |	Продажи.ПричинаОтменСписаний,
	               |	Продажи.ПричинаОтменСписанийКод,
	               |	ЛОЖЬ,
	               |	Продажи.ПричинаОтменСписанийУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Соответствия.ИмяМетаданных,
	               |	Соответствия.Наименование,
	               |	Соответствия.Код,
	               |	Соответствия.ПометкаУдаления,
	               |	Соответствия.УИД
	               |ИЗ
	               |	Соответствия КАК Соответствия
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Соответствия.ИмяМетаданных,
	               |	Соответствия.Наименование,
	               |	Соответствия.Код,
	               |	Соответствия.ПометкаУдаления,
	               |	Соответствия.УИД";
	Запрос.УстановитьПараметр("Продажи", ТаблицаПродаж);
	Запрос.УстановитьПараметр("ПродажиМодификаторов", ТаблицаМодификаторов);
	Запрос.УстановитьПараметр("ВидыОплат", ТаблицаВидовОплаты);
	мТаблицаСоответствияИмяУИД = Запрос.Выполнить().Выгрузить();
	мТаблицаСоответствияИмяУИД.Колонки.Добавить("Ссылка1С");
	
	Возврат мТаблицаСоответствияИмяУИД;
	
КонецФункции

// Процедура - Отбор касс ККМПо подразделеним завершение
//
// Параметры:
//  Результат	 - Произвольный	 - Результат. 
//  ДопПараметры - Произвольный	 - Дополнительные параметры.
//
&НаКлиенте
Процедура ОтборКассККМПоПодразделенимЗавершение(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтборКассККМПоПодразделенимНаСервере(Результат, ДопПараметры);
КонецПроцедуры


// Процедура - ОбработкаОповещения_ОткрытьПараметры
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный	 - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура	 - ДополнительныеПараметры
//
&НаКлиенте
Процедура ОбработкаОповещения_ОткрытьПараметры(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	
	Если РезультатОткрытияФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект,ДополнительныеПараметры);
	ИнициализацияПараметровЗагрузкиНаСервере();
	ПолучитьНастройкиНаСервере();
	
КонецПроцедуры //ОбработкаОповещения_ОткрытьПараметры

// Процедура - Параметры загрузки служебный каталог начало выбора завершение
//
// Параметры:
//  Результат				 - Произвольный - Результат.
//  ДополнительныеПараметры	 - Произвольный - Дополнительные параметры. 
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	текСтрока = ДополнительныеПараметры.текСтрока;
	Если Результат <> Неопределено Тогда
