Процедура ПолучитьПричиныОтменИСписанийПоАктамНаСервере(НазваниеАкта = "")
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Статья расходов(код)", "SIFR",Истина);
	СписокКолонок.Добавить("Статья расходов", "NAME");
	ТаблицаПричинОтмен = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\Акт "+НазваниеАкта+".csv", СписокКолонок);
	Если ТаблицаПричинОтмен = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТаблицаПричинОтмен.Свернуть("SIFR,NAME");
	//Для Каждого СтрПричин Из ТаблицаПричинОтмен Цикл
	//	СтрПричин.SIFR = СтрЗаменить(СтрПричин.SIFR,".","");
	//КонецЦикла;
	МассивЭлементовIIKO = ТаблицаПричинОтмен.ВыгрузитьКолонку("Sifr");
	СписокIIKO = Новый СписокЗначений;
	СписокIIKO.ЗагрузитьЗначения(МассивЭлементовIIKO);
	ТаблицаПричинОтмен.Колонки.Добавить("CODE");
	ТаблицаПричинОтмен.ЗагрузитьКолонку(МассивЭлементовIIKO, "CODE");
	
