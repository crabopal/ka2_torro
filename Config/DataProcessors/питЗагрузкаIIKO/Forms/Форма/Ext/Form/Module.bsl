		РеквизитыСлужебнойНоменклатуры.НоменклатураУИД = РеквизитыСлужебнойНоменклатуры.НоменклатураКод;
	КонецЕсли;
	
	Для Каждого СтрТабл Из ТаблицаИзФайла Цикл
		ТекущаяДатаСмены = ДатаСменыИзСтроки(СтрТабл.ДатаСмены);
		Если НРЕГ(СтрТабл.ТипНоменклатуры) = "модификатор" Тогда
			Продолжить;
		ИначеЕсли ЗначениеЗаполнено(Объект.ДатаНачала) И ТекущаяДатаСмены<НачалоДня(Объект.ДатаНачала)
				ИЛИ ЗначениеЗаполнено(Объект.ДатаКонца) И ТекущаяДатаСмены>КонецДня(Объект.ДатаКонца) Тогда
			Продолжить;
		ИначеЕсли (ВыбранныеКассы.Количество()>0) И ВыбранныеКассы.НайтиПоЗначению(СтрТабл.Касса)=Неопределено Тогда
			Продолжить;
		ИначеЕсли СостояниеЧека <> 0 И СостояниеЧека <> СтрТабл.ХозОперация Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = ТаблицаПродаж.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТабл);
		НовСтр.ЧекУИД = СтрЗаменить(Строка(СтрТабл.НомерСмены * 10000 + СтрТабл.КассаКод *100 + СтрТабл.ХозОперация),Символы.НПП,"");
		НовСтр.ЧекДата = СтрТабл.ДатаСмены;
	КонецЦикла;
	
	// +АктОказанияУслуг
	ТаблицаУслугИзФайла = ПолучитьТаблицуУслугИзФайла();
	Для Каждого СтрТабл Из ТаблицаУслугИзФайла Цикл
		ТекущаяДатаСмены = ДатаСменыИзСтроки(СтрТабл.ДатаСмены);
		Если ЗначениеЗаполнено(Объект.ДатаНачала) И ТекущаяДатаСмены<НачалоДня(Объект.ДатаНачала)
				ИЛИ ЗначениеЗаполнено(Объект.ДатаКонца) И ТекущаяДатаСмены>КонецДня(Объект.ДатаКонца) Тогда
			Продолжить;
		ИначеЕсли (ВыбранныеКассы.Количество()>0) И ВыбранныеКассы.НайтиПоЗначению(СтрТабл.Касса)=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = ТаблицаПродаж.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТабл);
		НовСтр.ХозОперация = 1;
		НовСтр.ЧекУИД = СтрЗаменить(Строка(СтрТабл.НомерСмены * 10000 + СтрТабл.КассаКод *100 + НовСтр.ХозОперация),Символы.НПП,"");
		НовСтр.ЧекДата = СтрТабл.ДатаСмены;
	КонецЦикла;
	// -АктОказанияУслуг
	
	Возврат ТаблицаПродаж;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДатаСменыИзСтроки(ДатаСмены)
	
	ДатаСменыМассив = СтрРазделить(ДатаСмены, " .:");
	ДатаСменыФорматированная = "00010101";
	Если ДатаСменыМассив.Количество() >= 5 Тогда
		ДатаСменыФорматированная = СтрШаблон("%1%2%3%4%5", 
			ДатаСменыМассив[2], ДатаСменыМассив[1] ,ДатаСменыМассив[0] ,ДатаСменыМассив[3] ,ДатаСменыМассив[4]);
	КонецЕсли;
	Возврат Дата(ДатаСменыФорматированная);
	
КонецФункции


