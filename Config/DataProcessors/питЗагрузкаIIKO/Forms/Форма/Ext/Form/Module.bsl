// Процедура начальной инициализации параметров
&НаСервере
Процедура Инициализация()
	Если ЗаполнятьНастройкиПоУмолчанию Тогда
		Объект.ВыводитьОтчет = Истина;
		Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта = Ложь;
		Объект.ЗагружатьСПустымиЦенами = Истина;
		ВидОтображенияПолей = 1;
		ОтображениеСвязейОплат = 1;
		Объект.ПроверятьЗаполненностьСоответствий = Истина;
		Объект.СоздаватьОбъектыПриЗаполненииСоответствий = Ложь;
		Объект.ПроверятьЗаполненностьСоответствий = Истина;
	КонецЕсли;
	
	//ИнициализацияОтбора();
	
	// Получим список касс IIKO
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовIIKO.Ссылка1С
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовIIKO КАК СоответствияОбъектовIIKO
	               |ГДЕ
	               |	СоответствияОбъектовIIKO.ТипОбъекта = &ТипОбъектаКасса
	               |	И НЕ СоответствияОбъектовIIKO.Ссылка1С ЕСТЬ NULL
	               |	И СоответствияОбъектовIIKO.Ссылка1С <> НЕОПРЕДЕЛЕНО
	               |	И СоответствияОбъектовIIKO.Ссылка1С <> ЗНАЧЕНИЕ(Справочник.КассыККМ.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ТипОбъектаКасса", ПланыВидовХарактеристик.питТипыОбъектовIIKO.КассыККМ);
	МассивКасс = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка1С");
	
	ИнициализацияПараметровЗагрузкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПометитьКнопку(Кнопка, Кнопки)
	Для Каждого текКнопка Из Кнопки Цикл
		Если ТипЗнч(текКнопка) = Тип("КнопкаФормы") Тогда
			текКнопка.Пометка = текКнопка = Кнопка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИндикацияПараметровПодключенияНаКлиенте()
	
	Результат = Ложь;
	Если Объект.ЭтоКлиент 
		И ЗначениеЗаполнено(Объект.УчетнаяЗапись)
		И ЗначениеЗаполнено(Объект.КаталогЗагрузки) Тогда
		ПроверкаФайла = Новый Файл(Объект.КаталогЗагрузки);
		Если Ждать ПроверкаФайла.СуществуетАсинх() Тогда
			Результат = Истина;
		КонецЕсли;
		
	ПроверкаФайла.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияВопроса", ЭтотОбъект));
	ИначеЕсли НЕ Объект.ЭтоКлиент 
		И ЗначениеЗаполнено(Объект.УчетнаяЗапись)
		И ЗначениеЗаполнено(Объект.КаталогЗагрузки) Тогда
		Результат = ПроверитьПодключениеНаСервере(Объект.КаталогЗагрузки);
	КонецЕсли;
	
	Если Результат Тогда
		ТекстЗаголовка = СтрШаблон(НСтр("ru='Подключение установлено <%1>'", "ru"),Объект.УчетнаяЗапись);
		ЦветТекста = WebЦвета.Зеленый;
	Иначе
		ТекстЗаголовка = НСтр("ru='Подключение не установлено'", "ru");
		ЦветТекста = WebЦвета.Серый;
	КонецЕсли;
	Элементы.Подключение.ЦветТекста = ЦветТекста;
	Элементы.Подключение.Заголовок = ТекстЗаголовка;
КонецПроцедуры  


&НаСервереБезКонтекста
Функция ПроверитьПодключениеНаСервере(КаталогЗагрузки)
	
	Результат = Ложь;
	ПроверкаФайла = Новый Файл(КаталогЗагрузки);
	Если ПроверкаФайла.Существует() Тогда
		Результат = Истина;
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ИзменитьРежимОбработки(РежимРаботы)
	ГруппаРежима = Элементы.КоманднаяПанельФормы.ПодчиненныеЭлементы.РежимОбработки.ПодчиненныеЭлементы;
	ГруппаРежима.ФормаНаКлиенте.Пометка = РежимРаботы;
	ГруппаРежима.ФормаНаСервере.Пометка = Не РежимРаботы;
	
	Элементы.КоманднаяПанельФормы.ПодчиненныеЭлементы.РежимОбработки.Заголовок = 
	?(РежимРаботы, НСтр("ru = 'Режим работы (на клиенте)'"), НСтр("ru = 'Режим работы (на сервере)'"));
КонецПроцедуры

Функция зфДобавитьНедостающиеСтрокиСоответствия(ТаблицаЭлементов, ТипОбъекта, СтрокаНастроек = Неопределено) 
	
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовIIKO.СоздатьНаборЗаписей();
	
	ТипЗначения = ТипОбъекта.ТипЗначения;
	ДоступныеТипы = ТипЗначения.Типы();
	Тип = ДоступныеТипы.Получить(0);
	МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
	
	Попытка
		Если МетаданныеТипа.Имя = "питРецептура" Тогда
			МенеджерДанных = Документы[МетаданныеТипа.Имя];
		Иначе
			МенеджерДанных = Справочники[МетаданныеТипа.Имя];
		КонецЕсли;
	Исключение
		МенеджерДанных = Перечисления[МетаданныеТипа.Имя];
	КонецПопытки;
	
	ЕстьРодитель = ТаблицаЭлементов.Колонки.Найти("Parent") <> Неопределено;
	
	Если ТаблицаЭлементов.Колонки.Найти("Ссылка1С") = Неопределено Тогда
		ТаблицаЭлементов.Колонки.Добавить("Ссылка1С");
	КонецЕсли;
	
	НаборЗаписей.Отбор.ТипОбъекта.Значение = ТипОбъекта;
	НаборЗаписей.Отбор.ТипОбъекта.Использование = Истина;
	
	Для Каждого СтрокаЭлемента Из ТаблицаЭлементов Цикл
		
		СсылкаIIKO = СтрокаЭлемента.Code;
		
		НаборЗаписей.Отбор.СсылкаIIKO.Значение = СсылкаIIKO;
		НаборЗаписей.Отбор.СсылкаIIKO.Использование = Истина;
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ТипОбъекта = ТипОбъекта;
			НоваяЗапись.СсылкаIIKO = СсылкаIIKO;
		Иначе
			НоваяЗапись = НаборЗаписей[0];
		КонецЕсли;
		
		НоваяЗапись.ИмяIIKO = СтрокаЭлемента.Name;
		НоваяЗапись.КодIIKO = СсылкаIIKO;
		
		Если ЕстьРодитель Тогда
			НоваяЗапись.РодительIIKO = СтрокаЭлемента.Parent;
			НоваяЗапись.ИмяРодителяIIKO = СтрокаЭлемента.ParentName;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаЭлемента.Ссылка1С) Тогда
			НоваяЗапись.Ссылка1С = СтрокаЭлемента.Ссылка1С;
		Иначе
			НоваяЗапись.Ссылка1С = МенеджерДанных.ПустаяСсылка();
		КонецЕсли;
		Попытка
			НаборЗаписей.Записать(Истина);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецФункции

Процедура ПолучитьВсеКассыККМНаСервере()
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Номер кассы", "SIFR",Истина);
	ТаблицаКассККМ = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\Прием кассовой выручки.csv", СписокКолонок);
	Если ТаблицаКассККМ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТаблицаКассККМ.Свернуть("SIFR");
	МассивЭлементовIIKO = ТаблицаКассККМ.ВыгрузитьКолонку("SIFR");
	
	ТаблицаКассККМ.Колонки.Добавить("CODE");
	ТаблицаКассККМ.Колонки.Добавить("NAME");
	ТаблицаКассККМ.ЗагрузитьКолонку(МассивЭлементовIIKO,"CODE");
	Для Каждого СтрТЗ Из ТаблицаКассККМ Цикл
		СтрТЗ.NAME = "ККМ №"+СтрТЗ.CODE;
	КонецЦикла;
	
	СписокIIKO = Новый СписокЗначений;
	СписокIIKO.ЗагрузитьЗначения(МассивЭлементовIIKO);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовIIKO.КассыККМ));
	Если СтрокиНастроек.Количество() > 0 Тогда
		зфДобавитьНедостающиеСтрокиСоответствия(ТаблицаКассККМ, ПланыВидовХарактеристик.питТипыОбъектовIIKO.КассыККМ, СтрокиНастроек[0]);
	Иначе
		зфДобавитьНедостающиеСтрокиСоответствия(ТаблицаКассККМ, ПланыВидовХарактеристик.питТипыОбъектовIIKO.КассыККМ);
	КонецЕсли;
	// установим отбор по полученной номенклатуре
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияКассыККМ.Отбор,"СсылкаIIKO",СписокIIKO,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияКассыККМ.Отбор,"Ссылка1С",Справочники.КассыККМ.ПустаяСсылка(),ВидСравненияКомпоновкиДанных.НеРавно);
КонецПроцедуры

