Процедура ПолучитьВсеВидыНоменклатурыНаСервере()
	
	
	ОбщаяТаблицаВидовНоменклатуры = Новый ТаблицаЗначений;
	ОбщаяТаблицаВидовНоменклатуры.Колонки.Добавить("Name");
	ОбщаяТаблицаВидовНоменклатуры.Колонки.Добавить("Code");
	
	ТипыНоменклатурыIIKO = Новый Соответствие;
	ТипыНоменклатурыIIKO.Вставить("Товар","товар");
	ТипыНоменклатурыIIKO.Вставить("Блюдо","блюдо");
	ТипыНоменклатурыIIKO.Вставить("Заготовка","заготовка");
	ТипыНоменклатурыIIKO.Вставить("Услуга","услуга");
	ТипыНоменклатурыIIKO.Вставить("Модификатор","модификатор");

	
	Для Каждого ТипНоменклатурыIIKO Из ТипыНоменклатурыIIKO Цикл 
		НоваяСтрока = ОбщаяТаблицаВидовНоменклатуры.Добавить();
		НоваяСтрока.Name = ТипНоменклатурыIIKO.Ключ;
		НоваяСтрока.Code = ТипНоменклатурыIIKO.Значение;
	КонецЦикла;
		
	МассивЭлементовIIKO = ОбщаяТаблицаВидовНоменклатуры.ВыгрузитьКолонку("Code");
	СписокIIKO = Новый СписокЗначений;
	СписокIIKO.ЗагрузитьЗначения(МассивЭлементовIIKO);

	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры));
	Если СтрокиНастроек.Количество() > 0 Тогда
		зфДобавитьНедостающиеСтрокиСоответствия(ОбщаяТаблицаВидовНоменклатуры, ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры, СтрокиНастроек[0]);
	Иначе
		зфДобавитьНедостающиеСтрокиСоответствия(ОбщаяТаблицаВидовНоменклатуры, ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры);
	КонецЕсли;
	
	// установим отбор по полученной номенклатуре
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияВидыНоменклатуры.Отбор,"СсылкаIIKO",СписокIIKO,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

