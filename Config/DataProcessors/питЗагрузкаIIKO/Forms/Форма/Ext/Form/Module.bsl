&НаСервере
Процедура СохранитьПараметрыЗагрузкиНаСервере()
	Для Каждого СтрокаТипа Из Объект.ПараметрыЗагрузки Цикл
		ТипОбъектаОбъект = СтрокаТипа.ТипОбъекта.ПолучитьОбъект();
		ТипОбъектаОбъект.Обновлять = СтрокаТипа.Обновлять;
		ТипОбъектаОбъект.Создавать = СтрокаТипа.Создавать;
		ТипОбъектаОбъект.СлужебныйКаталог = СтрокаТипа.СлужебныйКаталог;
		ТипОбъектаОбъект.ОбработкаОшибок = СтрокаТипа.ОбработкаОшибок;
		
		Попытка
			ТипОбъектаОбъект.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьПараметрыМодификаторовНоменклатуры(текСтрока)
	текДанные = Объект.Продажи.НайтиПоИдентификатору(текСтрока);
	СтрокиМодификаторов = ОБъект.Модификаторы.НайтиСтроки(Новый Структура("ЧекУИД, НоменклатураУИД", текДанные.ЧекУИД, текДанные.НоменклатураУИД));
	МодификаторыНоменклатуры = Объект.Модификаторы.Выгрузить(СтрокиМодификаторов);
	АдресМодификаторов = ПоместитьВоВременноеХранилище(МодификаторыНоменклатуры);
