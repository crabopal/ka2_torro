&НаКлиенте
Процедура СоответствияКассыККМВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "СоответствияКассыККМОтбор" Тогда
		СтандартнаяОбработка = Ложь;
		текСтрока = Элементы.СоответствияКассыККМ.ТекущиеДанные;
		Если Не ЗначениеЗаполнено(текСтрока.СсылкаIIKO) Тогда
			Возврат;
		КонецЕсли;
		текЗначение = ВыбранныеКассы.НайтиПоЗначению(текСтрока.СсылкаIIKO);
		Если текЗначение = Неопределено Тогда
			ВыбранныеКассы.Добавить(текСтрока.СсылкаIIKO);
		Иначе
			ВыбранныеКассы.Удалить(текЗначение);
		КонецЕсли;
		СоответствияКассыККМ.Параметры.УстановитьЗначениеПараметра("ВыбранныеКассы", ВыбранныеКассы.ВыгрузитьЗначения());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	текСтрока = Элементы.ПараметрыЗагрузки.ТекущаяСтрока;
	СтандартнаяОбработка = Ложь;
	ИмяМетаданных = ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока);
	Если ИмяМетаданных = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для данного типа объекта не ведется иерархия");
		Возврат;
	Иначе
		ПараметрыФормы = новый Структура("РежимВыбора",Истина);
		ОткрытьФорму("Справочник."+ИмяМетаданных+".ФормаВыбораГруппы",ПараметрыФормы,,,,, Новый ОписаниеОповещения("ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("текСтрока", текСтрока)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

