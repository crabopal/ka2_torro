// Возвращает текстовый параметр для запроса по переданному виду сравнения.
//
// Параметры:
//	Сравнение - ВидСравнения - Вид сравнения, для которого получается представление
//
// Возвращаемое значение:
//	Структура - Текстовое описание сравнения
//
Функция зфПолучитьПредставлениеИнтервала(Сравнение)
	Результат = Новый Структура("Тип, Представление");
	Если      Сравнение         = ВидСравненияКомпоновкиДанных.Больше Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " > ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " >=";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Меньше Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " < ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " <=";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеРавно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " <> ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Равно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " = ";
	//ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Интервал Тогда
	//	Результат.Тип           = "Интервал";
	//	Результат.Представление = " >   <  ";
	//ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ИнтервалВключаяГраницы Тогда
	//	Результат.Тип           = "ИнтервалОбе";
	//	Результат.Представление = " МЕЖДУ ";
	//ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ИнтервалВключаяНачало Тогда
	//	Результат.Тип           = "ИнтервалНачало";
	//	Результат.Представление = " >=  <  ";
	//ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ИнтервалВключаяОкончание Тогда
	//	Результат.Тип           = "ИнтервалОкончание";
	//	Результат.Представление = " >   <= ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Содержит Тогда
		Результат.Тип           = "Содержит";
		Результат.Представление = " ПОДОБНО ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
		Результат.Тип           = "Содержит";
		Результат.Представление = " НЕ ПОДОБНО ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ВСписке Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " В ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " НЕ В ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ВИерархии Тогда    
		Результат.Тип           = "Список";
		Результат.Представление = " В ИЕРАРХИИ ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда    
		Результат.Тип           = "Список";
		Результат.Представление = " НЕ В ИЕРАРХИИ ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " В ИЕРАРХИИ ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " НЕ В ИЕРАРХИИ ";

	Иначе
		Возврат Неопределено
	КонецЕсли;

	Возврат Результат;
КонецФункции // обПолучитьПредставлениеИнтервала()

Функция зфНайтиПоСинонимомуЗначениеПеречисления(ИмяПеречисления, ИмяСинонима, ТочноеСоответствие = Истина)    
	РезультФункции = Перечисления[ИмяПеречисления].ПустаяСсылка();

	КолекцияЗначенийПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления;
	Для каждого ЗначПерем из КолекцияЗначенийПеречисления Цикл
		Если ТочноеСоответствие Тогда
			ЗначениеНайдено = СокрЛП(СтрЗаменить(ИмяСинонима, " ", "")) = СокрЛП(СтрЗаменить(ЗначПерем.Синоним, " ", ""));
		Иначе
			ЗначениеНайдено = Найти(СокрЛП(СтрЗаменить(ИмяСинонима, " ", "")), СокрЛП(СтрЗаменить(ЗначПерем.Синоним, " ", ""))) <> 0 ИЛИ
							Найти(СокрЛП(СтрЗаменить(ЗначПерем.Синоним, " ", "")), СокрЛП(СтрЗаменить(ИмяСинонима, " ", ""))) <> 0
		КонецЕсли;
		
		Если ЗначениеНайдено Тогда
			РезультФункции = Перечисления[ИмяПеречисления][ЗначПерем.Имя];
			Прервать;
		КонецЕсли; 
	КонецЦикла;

	Возврат РезультФункции;
КонецФункции

//Испольлзуется для полнотекстового поиска строки в одном объекте метаданных
//Используется не только в R-кипере!
Функция зфВыполнитьНечеткийПоиск(НаименованиеIIKO, МетаданныеОбъекта, ПроцентСовпаденияСоответствия) 
	МассивПоиска = Новый Массив;
	МассивПоиска.Добавить(МетаданныеОбъекта);
	
	СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(НаименованиеIIKO, 10); // первый параметр строка поиска, второй размер списка
	СписокПоиска.ОбластьПоиска = МассивПоиска;
	СписокПоиска.ПолучатьОписание = Ложь;
	
	ПоказыватьОписания = Истина;
	СписокПоиска.ПорогНечеткости = 100 - ПроцентСовпаденияСоответствия; //процент нечеткости для слова из 4 букв, одна может быть неправильной
	
	
	СписокПоиска.СтрокаПоиска = НаименованиеIIKO;
	СписокПоиска.РазмерПорции = 1;
	
	Попытка
		СписокПоиска.ПерваяЧасть();
	Исключение
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Для наименования <"+НаименованиеIIKO+"> найдено слишком много результатов! Увеличьте процент схожести для получения результата.";
		Сообщение.Сообщить();
	КонецПопытки;
	Если СписокПоиска.ПолноеКоличество() <> 0 Тогда
		Возврат СписокПоиска[0].Представление;
	Иначе
		Если СписокПоиска.СлишкомМногоРезультатов() Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Для наименования <"+НаименованиеIIKO+"> найдено слишком много результатов!";
			Сообщение.Сообщить();
		КонецЕсли;
		Возврат "";
	КонецЕсли;
КонецФункции

//Установка соответствия для элементов
Процедура зфПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ОтборСоответствий, ИспользоватьИерархию = Ложь, ПроцентСовпаденияСоответствия = 75, СоздаватьОбъектыПриЗаполненииСоответствий = Ложь, Ошибки = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(Объект.ОрганизацияЗагрузки) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнена организация загрузки.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.СкладДляЗагрузкиКасс) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнен склад для загрузки касс.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	СвойстваОбъекта = Неопределено;
	
	СоответствиеГрупп = Новый Соответствие;
	
	// Попытаемся найти для справочника
	Попытка
		МетаданныеМенеджер = Справочники[ИмяМетаданных];
		ИмяМенеджера = "Справочник";
		МетаданныеОбъекта = Метаданные.Справочники[ИмяМетаданных];
	Исключение
		МетаданныеМенеджер = Перечисления[ИмяМетаданных];
		ИмяМенеджера = "Перечисление";
		МетаданныеОбъекта = Метаданные.Перечисления[ИмяМетаданных];
	КонецПопытки;
		

	// Создадим набор записей с соответствующим отбором
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовIIKO.СоздатьНаборЗаписей();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовIIKO.ТипОбъекта,
	               |	СоответствияОбъектовIIKO.СсылкаIIKO,
	               |	СоответствияОбъектовIIKO.Ссылка1С,
	               |	СоответствияОбъектовIIKO.ИмяIIKO,
	               |	СоответствияОбъектовIIKO.КодIIKO,
	               |	СоответствияОбъектовIIKO.РодительIIKO,
	               |	СоответствияОбъектовIIKO.ИмяРодителяIIKO,
	               |	СоответствияОбъектовIIKO.ЭтоГруппа
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовIIKO КАК СоответствияОбъектовIIKO";
	ТекстОтбора = "";
	Для Каждого СтрокаОтбора Из НаборЗаписей.Отбор Цикл
		ЭлементыОтбора = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ОтборСоответствий,СтрокаОтбора.Имя);
		Если ЭлементыОтбора.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЭлементОтбора = ЭлементыОтбора[0];
		
		ИспользованиеОтбора = ЭлементОтбора.Использование;
		ЗначениеОтбора = ЭлементОтбора.ПравоеЗначение;
		Если ИспользованиеОтбора И ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			ТипСравнения = зфПолучитьПредставлениеИнтервала( ЭлементОтбора.ВидСравнения);
			Запрос.УстановитьПараметр(СтрокаОтбора.Имя, ЗначениеОтбора);
			ТекстОтбора = ТекстОтбора + "И СоответствияОбъектовIIKO."+ СтрокаОтбора.Имя + " " + ТипСравнения.Представление + "(&"+ СтрокаОтбора.Имя + ")" +Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + ?(ТекстОтбора = "","",Символы.ПС + "ГДЕ" + Символы.ПС + Сред(ТекстОтбора,2));
	Результат = Запрос.Выполнить();
	Соответствие = Результат.Выбрать();
	
	ПерезаполнитьСоответствия = ЭтаФорма["ОбновлятьОбъектыПриЗаполненииСоответствий"];
	
	// Составим запрос
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	"+ИмяМетаданных+".Ссылка
	   	|ИЗ
	   	|	"+ИмяМенеджера+"."+ИмяМетаданных+" КАК "+ИмяМетаданных+"
	   	|ГДЕ
		|";
		
	Если ИмяМенеджера = "Справочник" И МетаданныеОбъекта.Иерархический Тогда
		ТекстЗапроса = ТекстЗапроса + ИмяМетаданных+".ЭтоГруппа = &ЭтоГруппа И
		|";
	КонецЕсли;
	Если ИмяМенеджера = "Справочник" Тогда
		ТекстЗапроса = ТекстЗапроса + "НЕ "+ ИмяМетаданных+".ПометкаУдаления И
		|";
	КонецЕсли;
	Если ИмяМетаданных = "питВидыОплатОрганизаций" Тогда
		СписокКолонок = Новый СписокЗначений;
		СписокКолонок.Добавить("Вид оплаты(код)","SIFR",Истина);
		СписокКолонок.Добавить("Вид оплаты(наименование)", "NAME");
		ТаблицаИзФайла = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\Прием кассовой выручки.csv", СписокКолонок);
		//Если ТаблицаИзФайла пустая, значит делать нам ниже нечего.
		Если ТаблицаИзФайла = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ИмяМетаданных = "питМодификаторы" Тогда 
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	питСоответствияОбъектовIIKO.Ссылка1С КАК Ссылка1С
		               |ИЗ
		               |	РегистрСведений.питСоответствияОбъектовIIKO КАК питСоответствияОбъектовIIKO
		               |ГДЕ
		               |	питСоответствияОбъектовIIKO.ИмяIIKO = &ИмяIIKO
		               |	И питСоответствияОбъектовIIKO.ТипОбъекта = &ТипОбъекта";
		Запрос.УстановитьПараметр("ИмяIIKO","модификатор");
		Запрос.УстановитьПараметр("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры);
		ВидМодификатор = Запрос.Выполнить().Выбрать();
		Если ВидМодификатор.Следующий() Тогда
			СвойстваОбъекта = Новый Структура;
			СвойстваОбъекта.Вставить("ВидНоменклатуры",ВидМодификатор.Ссылка1С);
		КонецЕсли;
		
	ИначеЕсли ИмяМетаданных = "Номенклатура" Тогда
		
		ТаблицаИзФайла = Новый ТаблицаЗначений;
		//ТаблицаИзФайла.Колонки.Добавить("SIFR",ОбщегоНазначения.ОписаниеТипаСтрока(38));
		ТаблицаИзФайла.Колонки.Добавить("CODE",ОбщегоНазначения.ОписаниеТипаСтрока(38));
		ТаблицаИзФайла.Колонки.Добавить("NAME", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(200)));
		ТаблицаИзФайла.Колонки.Добавить("TYPE",ОбщегоНазначения.ОписаниеТипаСтрока(38));
		ТаблицаИзФайла.Колонки.Добавить("TYPENAME",ОбщегоНазначения.ОписаниеТипаСтрока(100));
		ТаблицаИзФайла.Колонки.Добавить("ENERGY",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));
		ТаблицаИзФайла.Колонки.Добавить("FIBER",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));
		ТаблицаИзФайла.Колонки.Добавить("FAT",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));
		ТаблицаИзФайла.Колонки.Добавить("CARBOHYDRATE",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));
		ТаблицаИзФайла.Колонки.Добавить("NDS",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));
		ТаблицаИзФайла.Колонки.Добавить("EDIZM",ОбщегоНазначения.ОписаниеТипаСтрока(38));
		
		СписокКолонок = Новый СписокЗначений;
		//СписокКолонок.Добавить("Номенклатура (код)", "SIFR", Истина);
		СписокКолонок.Добавить("Номенклатура (код)", "CODE", Истина);
		СписокКолонок.Добавить("Номенклатура (наименование)", "NAME"); 
		СписокКолонок.Добавить("Тип номенклатуры (название)", "TYPE", Истина); //Вид ном.
		СписокКолонок.Добавить("Ставка НДС с продаж", "NDS");
		СписокКолонок.Добавить("Единица измерения (название)", "EDIZM");
		
		МассивФайлов = Новый Массив;
		МассивФайлов.Добавить("\Акт реализации.csv");
		МассивФайлов.Добавить("\Акты оказания услуг.csv");
		МассивФайлов.Добавить("\Приходная накладная.csv");
		МассивФайлов.Добавить("\Расходная накладная.csv");
		МассивФайлов.Добавить("\Акт списания.csv");

		ЗаполненыХЭХи = Ложь;
		
		Для каждого ИмяФайла из МассивФайлов Цикл
			ТаблицаЗначений = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+ИмяФайла, СписокКолонок);
			Если ТаблицаЗначений<>Неопределено Тогда
				Для Каждого СтрТЗ Из ТаблицаЗначений Цикл
					СтруктураЭлементаIIKO = Обработки.питЗагрузкаIIKO.ПолучитьТипНоменклатурыIIKO(СтрТЗ.TYPE);
					НовСтрИзФайла = ТаблицаИзФайла.Добавить();
					НовСтрИзФайла.TYPENAME = СтруктураЭлементаIIKO.Name;
					НовСтрИзФайла.TYPE = СтруктураЭлементаIIKO.Code;
					ЗаполнитьЗначенияСвойств(НовСтрИзФайла, СтрТЗ,,"TYPE");
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		// ПОЛУЧАЕМ номенклатуру из goods.csv, используется в Рецептурах, 
		СписокКолонок = Новый СписокЗначений;
		//СписокКолонок.Добавить("NUM", "SIFR", Истина);
		СписокКолонок.Добавить("NUM", "CODE", Истина);
		СписокКолонок.Добавить("NAME", "NAME");
		СписокКолонок.Добавить("TYPE", "TYPE");
		СписокКолонок.Добавить("ENERGY", "ENERGY");
		СписокКолонок.Добавить("FIBER", "FIBER");
		СписокКолонок.Добавить("FAT", "FAT");
		СписокКолонок.Добавить("CARBOHYDRATE", "CARBOHYDRATE");
		СписокКолонок.Добавить("MEASURE_UNIT", "EDIZM");
		ТаблицаЗначений = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\goods.csv", СписокКолонок, "UTF8");
		Если ТаблицаЗначений<>Неопределено Тогда
			Для Каждого СтрТЗ Из ТаблицаЗначений Цикл
				Если СтрТЗ.TYPE = "GROUP" Тогда 
					Продолжить
				КонецЕсли;
				СтруктураТипаIIKO = Обработки.питЗагрузкаIIKO.ПолучитьТипНоменклатурыIIKO(СтрТЗ.TYPE);
				НовСтрТ = ТаблицаИзФайла.Добавить();
				НовСтрТ.TYPE = СтруктураТипаIIKO.Code;
				НовСтрТ.TYPENAME = СтруктураТипаIIKO.Name;
				ЗаполнитьЗначенияСвойств(НовСтрТ, СтрТЗ,,"TYPE");
			КонецЦикла;
			ЗаполненыХЭХи = Истина;
		КонецЕсли;
		
		Если СоздаватьОбъектыПриЗаполненииСоответствий Тогда
		
			//Получим возможные соответствия Видов номенклатуры и УИД
			//Виды из питСоответствияОбъектовIIKO
			ТипПВХВидыНоменклатуры = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры;
			//Запрос = Новый Запрос;
			//Запрос.Текст = "ВЫБРАТЬ
			//               |	питСоответствияОбъектовIIKO.СсылкаIIKO КАК TYPE
			//               |ИЗ
			//               |	РегистрСведений.питСоответствияОбъектовIIKO КАК питСоответствияОбъектовIIKO
			//               |ГДЕ
			//               |	питСоответствияОбъектовIIKO.ТипОбъекта = &ТипОбъекта";
			//Запрос.УстановитьПараметр("ТипОбъекта",ТипПВХВидыНоменклатуры);
			//ВидыНоменклатурыИзСоответствий = Запрос.Выполнить().Выгрузить();
			
			//Виды из загружаемых чеков 
			ВидыНоменклатуры = ТаблицаИзФайла.Скопировать(,"TYPE,TYPENAME");
			
			//Для Каждого ВидИзСоответствий Из ВидыНоменклатурыИзСоответствий Цикл
			//	Вид = ВидыНоменклатуры.Добавить();
			//	ЗаполнитьЗначенияСвойств(Вид,ВидИзСоответствий);
			//КонецЦикла;
			
			ВидыНоменклатуры.Свернуть("TYPE,TYPENAME");
			
			//Получим виды номенклатуры без соответствий
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ВсеВидыНоменклатуры.TYPE КАК Code,
			               |	ВсеВидыНоменклатуры.TYPENAME КАК Name
			               |ПОМЕСТИТЬ ВТ_ВсеВидыНоменклатуры
			               |ИЗ
			               |	&ВсеВидыНоменклатуры КАК ВсеВидыНоменклатуры
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	питСоответствияОбъектовIIKO.СсылкаIIKO КАК СсылкаIIKO
			               |ПОМЕСТИТЬ ВТ_СтрокиРегистра
			               |ИЗ
			               |	РегистрСведений.питСоответствияОбъектовIIKO КАК питСоответствияОбъектовIIKO
			               |ГДЕ
			               |	питСоответствияОбъектовIIKO.ТипОбъекта = &ТипОбъекта
			               |	И (питСоответствияОбъектовIIKO.Ссылка1С = НЕОПРЕДЕЛЕНО
			               |			ИЛИ питСоответствияОбъектовIIKO.Ссылка1С = &СправочникНоменклатураПустаяСсылка)
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВТ_ВсеВидыНоменклатуры.Name КАК Name,
			               |	ВТ_ВсеВидыНоменклатуры.Code КАК Code
			               |ИЗ
			               |	ВТ_ВсеВидыНоменклатуры КАК ВТ_ВсеВидыНоменклатуры
			               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтрокиРегистра КАК ВТ_СтрокиРегистра
			               |		ПО ВТ_ВсеВидыНоменклатуры.Code = ВТ_СтрокиРегистра.СсылкаIIKO";
			Запрос.УстановитьПараметр("ВсеВидыНоменклатуры",ВидыНоменклатуры);
			Запрос.УстановитьПараметр("ТипОбъекта",ТипПВХВидыНоменклатуры);
			Запрос.УстановитьПараметр("СправочникНоменклатураПустаяСсылка",Справочники.Номенклатура.ПустаяСсылка());
			ВидыБезСоответствий = Запрос.Выполнить().Выгрузить();
			Если ВидыБезСоответствий.Количество() Тогда 
				Если ТипПВХВидыНоменклатуры.Создавать И СоздаватьОбъектыПриЗаполненииСоответствий Тогда 
					//Если есть виды без соответствий и в настройках установлено "Создавать" - Создаем виды и устанавливаем соответствия
					ВидыБезСоответствий.Колонки.Добавить("Ссылка1С");
					Для Каждого Вид Из ВидыБезСоответствий Цикл 
						СтруктураЭлементаIIKO = Обработки.питЗагрузкаIIKO.ПолучитьТипНоменклатурыIIKO(Вид.Code);
						СтруктураЭлементаIIKO.Вставить("Ссылка1С", Неопределено);
						Вид.Ссылка1С = Обработки.питЗагрузкаIIKO.СоздатьОбъектСоответствия(СтруктураЭлементаIIKO,
							"ВидыНоменклатуры", Объект.ОрганизацияЗагрузки,Объект.СкладДляЗагрузкиКасс);
					КонецЦикла;
					зфДобавитьНедостающиеСтрокиСоответствия(ВидыБезСоответствий, ТипПВХВидыНоменклатуры);
				Иначе
					//Если есть виды без соответствий - выводим список, добавляем поля в регистр и прерываем процедуру
					ТекстОшибки = "Для следующих видов номенклатуры не установлены соответсвия: ";
					Для Каждого Вид Из ВидыБезСоответствий Цикл 
						ТекстОшибки = ТекстОшибки + Вид.Code + ", ";
					КонецЦикла; 
					
					зфДобавитьНедостающиеСтрокиСоответствия(ВидыБезСоответствий, ТипПВХВидыНоменклатуры);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Если ТаблицаИзФайла пустая, значит делать нам ниже нечего.
		Если ТаблицаИзФайла = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗаполненыХЭХи Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ТаблицаИзФайлов.CODE КАК CODE,
				|	ТаблицаИзФайлов.NAME КАК NAME,
				|	ТаблицаИзФайлов.TYPE КАК TYPE,
				|	ТаблицаИзФайлов.ENERGY КАК ENERGY,
				|	ТаблицаИзФайлов.FIBER КАК FIBER,
				|	ТаблицаИзФайлов.FAT КАК FAT,
				|	ТаблицаИзФайлов.CARBOHYDRATE КАК CARBOHYDRATE,
				|	ТаблицаИзФайлов.EDIZM КАК EDIZM,
				|	ТаблицаИзФайлов.NDS КАК NDS
				|ПОМЕСТИТЬ ТаблицаИзФайлов
				|ИЗ
				|	&ТаблицаИзФайлов КАК ТаблицаИзФайлов
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	МАКСИМУМ(ТаблицаИзФайлов.CODE) КАК CODE,
				|	ТаблицаИзФайлов.NAME КАК NAME,
				|	МАКСИМУМ(ТаблицаИзФайлов.TYPE) КАК TYPE,
				|	МАКСИМУМ(ТаблицаИзФайлов.ENERGY) КАК ENERGY,
				|	МАКСИМУМ(ТаблицаИзФайлов.FIBER) КАК FIBER,
				|	МАКСИМУМ(ТаблицаИзФайлов.FAT) КАК FAT,
				|	МАКСИМУМ(ТаблицаИзФайлов.CARBOHYDRATE) КАК CARBOHYDRATE,
				|	МАКСИМУМ(ТаблицаИзФайлов.EDIZM) КАК EDIZM,
				|	МАКСИМУМ(ТаблицаИзФайлов.NDS) КАК NDS
				|ИЗ
				|	ТаблицаИзФайлов КАК ТаблицаИзФайлов
				|
				|СГРУППИРОВАТЬ ПО
				|	ТаблицаИзФайлов.NAME";
			Запрос.УстановитьПараметр("ТаблицаИзФайлов",ТаблицаИзФайла);
			ТаблицаИзФайла = Запрос.Выполнить().Выгрузить();
		Иначе 
			ТаблицаИзФайла.Свернуть("CODE, NAME, TYPE, TYPENAME, NDS, EDIZM","ENERGY, FIBER, FAT ,CARBOHYDRATE");
		КонецЕсли;
		
		ТаблицаИзФайла.Индексы.Добавить("CODE");
		ТаблицаИзФайла.Индексы.Добавить("NAME");
		
	КонецЕсли;
	
	
	Пока Соответствие.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Соответствие.Ссылка1С) тогда
			Если Соответствие.ЭтоГруппа Тогда
				СоответствиеГрупп.Вставить(Соответствие.СсылкаIIKO, Соответствие.Ссылка1С);
			КонецЕсли;
			Если НЕ ПерезаполнитьСоответствия Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		РодительЭлемента = Неопределено;
		Если ИспользоватьИерархию И НЕ ПустаяСтрока(Соответствие.РодительКипера) Тогда
			РодительЭлемента = СоответствиеГрупп.Получить(Соответствие.РодительКипера);
			Если РодительЭлемента = Неопределено Тогда
				РодительЭлемента = МетаданныеМенеджер.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		
		УсловиеЗапроса = "";
		Если ЗначениеЗаполнено(Соответствие.Ссылка1С) тогда
			СсылкаСоответствия = Соответствие.Ссылка1С;
			Запрос = Неопределено;
		ИначеЕсли Режим = 1 Тогда
			Если ИмяМенеджера = "Справочник" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Наименование = &Наименование";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Ссылка = &Наименование";
			КонецЕсли;
			Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
			Запрос.УстановитьПараметр("ЭтоГруппа", Соответствие.ЭтоГруппа);
			Если ИмяМенеджера = "Справочник" Тогда
				Запрос.УстановитьПараметр("Наименование", Соответствие.ИмяIIKO);
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				СоответствиеПеречисления = зфНайтиПоСинонимомуЗначениеПеречисления(ИмяМетаданных,Соответствие.ИмяIIKO);
				Запрос.УстановитьПараметр("Наименование", СоответствиеПеречисления);
			КонецЕсли;
			
			Если РодительЭлемента <> Неопределено Тогда
				Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
			КонецЕсли;
			
		ИначеЕсли Режим = 2 Тогда
			НечеткоеНаименование = зфВыполнитьНечеткийПоиск(Соответствие.ИмяIIKO, МетаданныеОбъекта, ПроцентСовпаденияСоответствия);
			Если ИмяМенеджера = "Справочник" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Наименование ПОДОБНО &Наименование";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Ссылка = &Наименование";
			КонецЕсли;
			
			Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
			Запрос.УстановитьПараметр("ЭтоГруппа", Соответствие.ЭтоГруппа);
			Если ИмяМенеджера = "Справочник" Тогда
				Запрос.УстановитьПараметр("Наименование", ?(НечеткоеНаименование = "",Соответствие.ИмяIIKO + "%",НечеткоеНаименование));
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				СоответствиеПеречисления = зфНайтиПоСинонимомуЗначениеПеречисления(ИмяМетаданных,?(НечеткоеНаименование = "",Соответствие.ИмяIIKO,НечеткоеНаименование), Ложь);
				Запрос.УстановитьПараметр("Наименование", СоответствиеПеречисления);
			КонецЕсли;
			
			Если РодительЭлемента <> Неопределено Тогда
				Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
			КонецЕсли;
			
		ИначеЕсли Режим = 3 Тогда
			УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Код = &Код";
			Если РодительЭлемента <> Неопределено Тогда
				УсловиеЗапроса = УсловиеЗапроса + "
				|И "+ИмяМетаданных+".Родитель = &Родитель";
			КонецЕсли;
			Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
			Запрос.УстановитьПараметр("ЭтоГруппа", Соответствие.ЭтоГруппа);
			Запрос.УстановитьПараметр("Код", Сред(Соответствие.СсылкаIIKO, 3));
			Если РодительЭлемента <> Неопределено Тогда
				Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
			КонецЕсли;
		Иначе
			//по совпадению кода IIKO и кода 1C
			Если Соответствие.ЭтоГруппа Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Наименование = &Наименование";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
				Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
				
				Запрос.УстановитьПараметр("ЭтоГруппа", Истина);
				Запрос.УстановитьПараметр("Наименование", Соответствие.ИмяIIKO);
				Если РодительЭлемента <> Неопределено Тогда
					Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
				КонецЕсли;
			Иначе
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Код = &Код";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
				Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
				Запрос.УстановитьПараметр("ЭтоГруппа", Ложь);
				Запрос.УстановитьПараметр("Код", Строка(Соответствие.КодIIKO));
				Если РодительЭлемента <> Неопределено Тогда
					Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		СсылкаСоответствия = Неопределено;
		Если НЕ Запрос = Неопределено Тогда
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СсылкаСоответствия = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		СоздатьОбновитьОбъект = НЕ СсылкаСоответствия = Неопределено И ПерезаполнитьСоответствия
			ИЛИ СсылкаСоответствия = Неопределено 
				И СоздаватьОбъектыПриЗаполненииСоответствий И ИмяМенеджера = "Справочник";
		Если СоздатьОбновитьОбъект Тогда
			СсылкаСоответствия = Обработки.питЗагрузкаIIKO.СоздатьОбъектСоответствия(Соответствие,
				ИмяМетаданных, 
				Объект.ОрганизацияЗагрузки, 
				Объект.СкладДляЗагрузкиКасс, 
				ТаблицаИзФайла,
				СвойстваОбъекта,Объект.ЗагружатьХЭХ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СсылкаСоответствия) Тогда
			НаборЗаписей.Отбор.СсылкаIIKO.Установить(Соответствие.СсылкаIIKO);
			НаборЗаписей.Отбор.ТипОбъекта.Установить(Соответствие.ТипОбъекта);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				ЗаписьНабора = НаборЗаписей[0];
				ЗаписьНабора.Ссылка1С = СсылкаСоответствия;
				Попытка
					НаборЗаписей.Записать();
				Исключение
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,,"Не удалось установить соответствия для "+МетаданныеМенеджер+"");
				КонецПопытки;
			КонецЕсли;
			Если ИмяМенеджера = "Справочник" И СсылкаСоответствия.ЭтоГруппа Тогда
				СоответствиеГрупп.Вставить(Соответствие.СсылкаIIKO, СсылкаСоответствия);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
//Установка соответствия для элементов
Процедура ПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ИспользоватьИерархию = Ложь)
	// Предупредим, если нечеткий поиск и не актуальный индекс
	Если Режим = 2 И Не ПолнотекстовыйПоиск.ИндексАктуален() Тогда
		ПолнотекстовыйПоиск.ОбновитьИндекс();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поисковый индекс обновлен.");
	КонецЕсли;
	
	ОтборСоответствий = ЭтотОбъект["Соответствия"+ИмяМетаданных].Отбор;
	Ошибки = Неопределено;
	зфПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ОтборСоответствий, ИспользоватьИерархию, 100, Объект.СоздаватьОбъектыПриЗаполненииСоответствий, Ошибки);
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	Элементы["Соответствия"+ИмяМетаданных].Обновить();
КонецПроцедуры

Процедура СледующееПустоеСоответствие(ИмяТаблицы, Направление = 1)
	ТаблицаСоответствия = ЭтаФорма[ИмяТаблицы];
	текСтрока =Элементы[ИмяТаблицы].ТекущаяСтрока; 
	Если текСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипОбъекта = текСтрока.ТипОбъекта;
	
	Тип = ТипОбъекта.ТипЗначения.Типы()[0];
	МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовIIKO.ТипОбъекта,
	               |	СоответствияОбъектовIIKO.ИмяIIKO,
	               |	СоответствияОбъектовIIKO.СсылкаIIKO
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовIIKO КАК СоответствияОбъектовIIKO 
				   |ГДЕ 
				   |	(СоответствияОбъектовIIKO.Ссылка1С = ЗНАЧЕНИЕ(Справочник."+МетаданныеТипа.Имя+".ПустаяСсылка) ИЛИ
				   |	СоответствияОбъектовIIKO.Ссылка1С Есть NULL ИЛИ 
				   |	СоответствияОбъектовIIKO.Ссылка1С = НЕОПРЕДЕЛЕНО ИЛИ
				   |	СоответствияОбъектовIIKO.СсылкаIIKO = &СсылкаIIKO)";
	Запрос.УстановитьПараметр("СсылкаIIKO", текСтрока.СсылкаIIKO);
	ТекстОтбора = "";
	Для Каждого СтрокаОтбора Из ТаблицаСоответствия.Отбор.Элементы Цикл
		ИспользованиеОтбора = СтрокаОтбора.Использование ;
		ЗначениеОтбора = СтрокаОтбора.ПравоеЗначение;
		Если ИспользованиеОтбора И ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			ТипСравнения = зфПолучитьПредставлениеИнтервала(СтрокаОтбора.ВидСравнения);

			Запрос.УстановитьПараметр(СтрокаОтбора.Имя, ЗначениеОтбора);
			ТекстОтбора = ТекстОтбора + "И СоответствияОбъектовIIKO."+ СтрокаОтбора.Имя + " " + ТипСравнения.Представление + "(&"+ СтрокаОтбора.Имя + ")" +Символы.ПС;
		КонецЕсли;
					   
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + ТекстОтбора;
	
	ТекстПорядка = "";
	// Порядок
	Для Каждого СтрокаПорядка Из ТаблицаСоответствия.Порядок Цикл
		ТекстПорядка = ТекстПорядка + " СоответствияОбъектовIIKO."+ СтрокаПорядка.Имя + ", ";
	КонецЦикла;
	Если ТекстПорядка <> "" Тогда
		ТекстПорядка = "УПОРЯДОЧИТЬ ПО" + Лев(ТекстПорядка,СтрДлина(ТекстПорядка)-2);
		Запрос.Текст = Запрос.Текст + ТекстПорядка;
	КонецЕсли;
	
	ТаблицаПустыхЗначений = Запрос.Выполнить().Выгрузить();
	ТекущаяСтрока = ТаблицаПустыхЗначений.Найти(текСтрока.СсылкаIIKO, "СсылкаIIKO");
	
	ПеременнаяЦикла = ТаблицаПустыхЗначений.Индекс(ТекущаяСтрока)+Направление;
	Если Направление = 1 И ПеременнаяЦикла >= ТаблицаПустыхЗначений.Количество() Тогда
		ПеременнаяЦикла = 0;
	ИначеЕсли Направление = -1 И ПеременнаяЦикла < 0 Тогда
		ПеременнаяЦикла = ТаблицаПустыхЗначений.Количество()-1;
	КонецЕсли;

	Ключ = РегистрыСведений.питСоответствияОбъектовIIKO.СоздатьКлючЗаписи(Новый Структура("ТипОбъекта,СсылкаIIKO",ТипОбъекта,ТаблицаПустыхЗначений[ПеременнаяЦикла].СсылкаIIKO));
	Элементы[ИмяТаблицы].ТекущаяСтрока = Ключ;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоответствияРецептурСервер()
	
	ПолучитьРецептурыНаСервере(Истина);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДатуИзСтроки(СтрокаСДатой)
	Год = Прав(СтрокаСДатой,4);
	Месяц = Сред(СтрокаСДатой,4,2);
	День = Лев(СтрокаСДатой,2);
	Возврат Дата(Год+Месяц+День);
КонецФункции

&НаСервере
Процедура ПолучитьРецептурыНаСервере(Грузить = Ложь)
	//Рецептуры
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("PRODUCT_CODE",, Истина);
	СписокКолонок.Добавить("ITEM_CODE",, Истина);
	СписокКолонок.Добавить("ITEM_GROSS_WEIGHT");
	СписокКолонок.Добавить("ITEM_NET_WEIGHT");
	СписокКолонок.Добавить("ITEM_OUT_WEIGHT");
	СписокКолонок.Добавить("TECHNOLOGY");
	СписокКолонок.Добавить("AMOUNT");
	СписокКолонок.Добавить("DATE_FROM");
	ТаблицаРецептур = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\assemblyCharts.csv", СписокКолонок, "UTF8");
	//Номенклатура
	ТаблицаНоменклатуры = ПолучитьВсюНоменклатуруНаСервере("Вся", Грузить);
	Если Грузить Тогда
		Объект.СоздаватьОбъектыПриЗаполненииСоответствий = Истина;
		ПроставитьСоответствияЭлементов(1,"Номенклатура");
	КонецЕсли;
	//И наконец заполняем соответсвия
	ТаблицаСоответствийРецептур = Новый ТаблицаЗначений;
	ТаблицаСоответствийРецептур.Колонки.Добавить("Name");
	ТаблицаСоответствийРецептур.Колонки.Добавить("Code");
	ТаблицаСоответствийРецептур.Колонки.Добавить("Sifr");
	ТаблицаСоответствийРецептур.Колонки.Добавить("Ссылка1С");
	Если ТаблицаРецептур = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТаблицаРецептур.Количество() <> 0 И ТаблицаНоменклатуры.Количество() <> 0 Тогда
		Если Грузить Тогда
			НачатьТранзакцию();
		КонецЕсли;
		ТаблицаБлюд = ТаблицаРецептур.Скопировать(,"PRODUCT_CODE,DATE_FROM");
		ТаблицаБлюд.Свернуть("PRODUCT_CODE,DATE_FROM");
		//Формируем наименование рецептур
		Для Каждого СтрБлюдо Из ТаблицаБлюд Цикл
			СтрокаНоменклатуры = ТаблицаНоменклатуры.Найти(СтрБлюдо.PRODUCT_CODE, "CODE");
			Если СтрокаНоменклатуры = Неопределено Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Не удалось загрузить рецептуру блюда с кодом "+СтрБлюдо.PRODUCT_CODE+Символы.ПС+"по причине отсутствия блюда в файле goods.csv";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			НовСоотвБлюд = ТаблицаСоответствийРецептур.Добавить();
			НовСоотвБлюд.Name = "Рецептура по "+СтрокаНоменклатуры.NAME+" от "+СтрБлюдо.DATE_FROM;
			НовСоотвБлюд.Code = СтрБлюдо.PRODUCT_CODE+СтрЗаменить(СтрБлюдо.DATE_FROM,".","");
			НовСоотвБлюд.Sifr = НовСоотвБлюд.Code;
			Если Грузить Тогда
				СтрутураЭлементаIIKO = Новый Структура;
				СтрутураЭлементаIIKO.Вставить("УИД");
				СтрутураЭлементаIIKO.УИД = НовСоотвБлюд.Code;
				Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO, "питРецептура",ПланыВидовХарактеристик.питТипыОбъектовIIKO.Рецептуры);
				БылоПрерываениеТЧ = Ложь;
				Если НЕ ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
					Рецептура = Документы.питРецептура.СоздатьДокумент();
					Рецептура.УстановитьНовыйНомер();
				Иначе
					Рецептура = СтрутураЭлементаIIKO.Ссылка1С.ПолучитьОбъект();
					Рецептура.Ингредиенты.Очистить();
				КонецЕсли;
				СтрокиИнгридиентов = ТаблицаРецептур.НайтиСтроки(Новый Структура("PRODUCT_CODE",СтрБлюдо.PRODUCT_CODE));
				СтрутураЭлементаIIKO = Новый Структура;
				СтрутураЭлементаIIKO.Вставить("УИД");
				СтрутураЭлементаIIKO.УИД = СтрБлюдо.PRODUCT_CODE;
				Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO, "Номенклатура",ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура);
				
				Рецептура.Ответственный = ПараметрыСеанса.ТекущийПользователь;
				Рецептура.Организация = Объект.ОрганизацияЗагрузки;
				Рецептура.Подразделение = Объект.ПодразделениеЗагрузки;
				Рецептура.Номенклатура = СтрутураЭлементаIIKO.Ссылка1С;
				Рецептура.Упаковка = Рецептура.Номенклатура.ЕдиницаИзмерения;
				Рецептура.Количество = Число(СтрокиИнгридиентов[0].AMOUNT);
				Рецептура.КоличествоУпаковок = Рецептура.Количество;
				Рецептура.Основная = Истина;
				Рецептура.ДатаНачала = ПолучитьДатуИзСтроки(СтрБлюдо.DATE_FROM);
				Рецептура.Дата = Рецептура.ДатаНачала;
				Рецептура.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
				Рецептура.ТехнологияПриготовления = СтрокиИнгридиентов[0].TECHNOLOGY;
				Рецептура.СтатьяКалькуляции = Константы.питСтатьяКалькуляцииПоУмолчанию.Получить();
				Рецептура.Наименование = Документы.питРецептура.СформироватьНаименованиеРецептуры(Рецептура.Номенклатура,Рецептура.Характеристика, Рецептура.ДатаНачала, Рецептура.ДатаКонца);
				
				СтрРазрешенныеПодразделения = Рецептура.РазрешенныеПодразделения.Добавить();
				СтрРазрешенныеПодразделения.Подразделение = Объект.ПодразделениеЗагрузки;
				СтрРазрешенныеПодразделения.ВключаяПодчиненные = Истина;
				
				Для Каждого СтрокаИнгридиента Из СтрокиИнгридиентов Цикл
					СтрокаНоменклатуры = ТаблицаНоменклатуры.Найти(СтрокаИнгридиента.ITEM_CODE, "CODE");
					Если СтрокаНоменклатуры = Неопределено Тогда
						Сообщение = Новый СообщениеПользователю();
						Сообщение.Текст = "Не удалось загрузить рецептуру блюда с кодом "+СтрБлюдо.PRODUCT_CODE+Символы.ПС+"по причине отсутствия ингридиента с кодом "+СтрокаИнгридиента.ITEM_CODE+" в файле goods.csv";
						Сообщение.Сообщить();
						БылоПрерываениеТЧ = Истина;
						Прервать;
					КонецЕсли;
					НовСтрокаТовары = Рецептура.Ингредиенты.Добавить();
					СтрутураЭлементаIIKO = Новый Структура;
					СтрутураЭлементаIIKO.Вставить("УИД");
					СтрутураЭлементаIIKO.УИД = СтрокаИнгридиента.ITEM_CODE;
					Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO, "Номенклатура",ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура);
					НовСтрокаТовары.Номенклатура = СтрутураЭлементаIIKO.Ссылка1С;
					НовСтрокаТовары.Упаковка = НовСтрокаТовары.Номенклатура.ЕдиницаИзмерения;
					НовСтрокаТовары.КоличествоБрутто = СтрокаИнгридиента.ITEM_GROSS_WEIGHT;
					НовСтрокаТовары.КоличествоНетто = СтрокаИнгридиента.ITEM_NET_WEIGHT;
					НовСтрокаТовары.КоличествоВыход = СтрокаИнгридиента.ITEM_OUT_WEIGHT;
					НовСтрокаТовары.КоличествоУпаковокБрутто = СтрокаИнгридиента.ITEM_GROSS_WEIGHT;
					НовСтрокаТовары.КоличествоУпаковокНетто = СтрокаИнгридиента.ITEM_NET_WEIGHT;
					НовСтрокаТовары.КоличествоУпаковокВыход = СтрокаИнгридиента.ITEM_OUT_WEIGHT;
					НовСтрокаТовары.ПроцентПотерьПриХолоднойОбработке = ?(НовСтрокаТовары.КоличествоБрутто = 0, 0, (НовСтрокаТовары.КоличествоБрутто - НовСтрокаТовары.КоличествоНетто) * 100 / НовСтрокаТовары.КоличествоБрутто);
					НовСтрокаТовары.ПроцентПотерьПриГорячейОбработке  = ?(НовСтрокаТовары.КоличествоНетто = 0, 0, (НовСтрокаТовары.КоличествоНетто - НовСтрокаТовары.КоличествоВыход) * 100 / НовСтрокаТовары.КоличествоНетто);
				КонецЦикла;
				Если БылоПрерываениеТЧ Тогда
					Продолжить;
				КонецЕсли;
				Рецептура.Выход = Рецептура.Ингредиенты.Итог("КоличествоВыход");
				Рецептура.ОбменДанными.Загрузка = Истина;
				Рецептура.Записать(РежимЗаписиДокумента.Запись);
				Рецептура = Рецептура.Ссылка;
				
				НовСоотвБлюд.Ссылка1С = Рецептура;
			КонецЕсли;
		КонецЦикла;
		Если Грузить Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	ТаблицаСоответствийРецептур.Свернуть("Name, Code, Sifr, Ссылка1С");
	
	МассивЭлементовIIKO = ТаблицаСоответствийРецептур.ВыгрузитьКолонку("Sifr");
	СписокIIKO = Новый СписокЗначений;
	СписокIIKO.ЗагрузитьЗначения(МассивЭлементовIIKO);
	
	зфДобавитьНедостающиеСтрокиСоответствия(ТаблицаСоответствийРецептур, ПланыВидовХарактеристик.питТипыОбъектовIIKO.Рецептуры);
	// установим отбор по полученным рецептурам
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияпитРецептура.Отбор,"СсылкаIIKO",СписокIIKO,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

КонецПроцедуры

&НаСервере
Функция ПолучитьВсюНоменклатуруНаСервере(Откуда = "Вся", ЗагружатьНоменклатуру = Ложь)

	ОбщаяТаблицаНоменклатуры = Новый ТаблицаЗначений;
//	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("SIFR");
	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("CODE",ОбщегоНазначения.ОписаниеТипаСтрока(38));
	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("NAME",ОбщегоНазначения.ОписаниеТипаСтрока(256));
	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("TYPE");
	
	СписокКолонок = Новый СписокЗначений;
//	СписокКолонок.Добавить("Номенклатура (код)", "SIFR",Истина);
	СписокКолонок.Добавить("Номенклатура (код)", "CODE", Истина);
	СписокКолонок.Добавить("Номенклатура (наименование)", "NAME");
	СписокКолонок.Добавить("Тип номенклатуры (название)", "TYPE");
//	СписокКолонок.Добавить("Проданное блюдо (код)", "SIFRMOD", Истина);
	СписокКолонок.Добавить("Проданное блюдо (код)", "CODEMOD", Истина);
	СписокКолонок.Добавить("Проданное блюдо (название)", "NAMEMOD");
	
	МассивФайлов = Новый Массив;
	Если Откуда = "Вся" Тогда 
		МассивФайлов.Добавить("\Расходная накладная.csv");
		МассивФайлов.Добавить("\Приходная накладная.csv");
		МассивФайлов.Добавить("\Акт списания.csv");
		МассивФайлов.Добавить("\Акт реализации.csv");
		МассивФайлов.Добавить("\Акты оказания услуг.csv");
	ИначеЕсли Откуда = "РН" Тогда 
		МассивФайлов.Добавить("\Расходная накладная.csv");
	ИначеЕсли Откуда = "ПН" Тогда 
		МассивФайлов.Добавить("\Приходная накладная.csv");
	ИначеЕсли Откуда = "АС" Тогда 
		МассивФайлов.Добавить("\Акт списания.csv");
	ИначеЕсли Откуда = "АР" Тогда 
		МассивФайлов.Добавить("\Акт реализации.csv");
	ИначеЕсли Откуда = "АУ" Тогда
		МассивФайлов.Добавить("\Акты оказания услуг.csv");
	КонецЕсли;
	
	Для каждого ИмяФайла из МассивФайлов Цикл
		Таблица = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+ИмяФайла, СписокКолонок);
		Если Таблица<>Неопределено Тогда
			ЕстьКолонкаПроданноеБлюдо = НЕ (Таблица.Колонки.Найти("NAMEMOD") = Неопределено);
			Для Каждого СтрТ Из Таблица Цикл
				Если НРЕГ(СтрТ.TYPE) = "модификатор" Тогда
					Если ЕстьКолонкаПроданноеБлюдо Тогда
						Если ЗначениеЗаполнено(СтрТ.NAMEMOD) Тогда
							СтрТ.CODE = СтрТ.CODEMOD; //Модификатор заменяется основной позицией модификатора
//							СтрТ.SIFR = СтрТ.SIFRMOD;
							СтрТ.NAME = СтрТ.NAMEMOD;
						КонецЕсли;
					Иначе
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				НовСтрТ = ОбщаяТаблицаНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрТ, СтрТ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ДобавленыХЕХи = Ложь;
	Если Откуда = "Вся" Тогда
		//Пробуем получить из goods.csv
		СписокКолонок = Новый СписокЗначений;
//		СписокКолонок.Добавить("NUM", "SIFR", Истина);
		СписокКолонок.Добавить("NUM", "CODE", Истина);
		СписокКолонок.Добавить("NAME", "NAME");
		СписокКолонок.Добавить("TYPE", "TYPE");
		СписокКолонок.Добавить("ENERGY", "ENERGY");
		СписокКолонок.Добавить("FIBER", "FIBER");
		СписокКолонок.Добавить("FAT", "FAT");
		СписокКолонок.Добавить("CARBOHYDRATE", "CARBOHYDRATE");
		Таблица = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\goods.csv", СписокКолонок, "UTF8");
		Если Таблица<>Неопределено Тогда
			ОбщаяТаблицаНоменклатуры.Колонки.Добавить("ENERGY");
			ОбщаяТаблицаНоменклатуры.Колонки.Добавить("FIBER");
			ОбщаяТаблицаНоменклатуры.Колонки.Добавить("FAT");
			ОбщаяТаблицаНоменклатуры.Колонки.Добавить("CARBOHYDRATE");
			ДобавленыХЕХи = Истина;
//			ЕстьКолонкаПроданноеБлюдо = НЕ (Таблица.Колонки.Найти("NAMEMOD") = Неопределено);
//			Для Каждого СтрТ Из Таблица Цикл
//				Если СтрТ.TYPE = "GROUP" Тогда 
//					Продолжить
//				КонецЕсли;
//				Если ВРЕГ(СтрТ.TYPE) = "MODIFIER" Тогда
//					Если ЕстьКолонкаПроданноеБлюдо Тогда
//						Если ЗначениеЗаполнено(СтрТ.NAMEMOD) Тогда
//							СтрТ.CODE = СтрТ.CODEMOD;
////							СтрТ.SIFR = СтрТ.SIFRMOD;
//							СтрТ.NAME = СтрТ.NAMEMOD;
//						КонецЕсли;
//					Иначе
//						Продолжить;
//					КонецЕсли;
//				КонецЕсли;
//				НовСтрТ = ОбщаяТаблицаНоменклатуры.Добавить();
//				ЗаполнитьЗначенияСвойств(НовСтрТ, СтрТ);
//			КонецЦикла;
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ОбщаяТаблицаНоменклатуры.CODE КАК CODE,
				|	ОбщаяТаблицаНоменклатуры.NAME КАК NAME
				|ПОМЕСТИТЬ ОбщаяТаблицаНоменклатуры
				|ИЗ
				|	&ОбщаяТаблицаНоменклатуры КАК ОбщаяТаблицаНоменклатуры
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	Goods.CODE КАК CODE,
				|	Goods.NAME КАК NAME,
				|	Goods.ENERGY КАК ENERGY,
				|	Goods.FIBER КАК FIBER,
				|	Goods.FAT КАК FAT,
				|	Goods.CARBOHYDRATE КАК CARBOHYDRATE,
				|	Goods.TYPE КАК TYPE
				|ПОМЕСТИТЬ Goods
				|ИЗ
				|	&Goods КАК Goods
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ОбщаяТаблицаНоменклатуры.CODE КАК CODE,
				|	ОбщаяТаблицаНоменклатуры.NAME КАК NAME,
				|	0 КАК ENERGY,
				|	0 КАК FIBER,
				|	0 КАК FAT,
				|	0 КАК CARBOHYDRATE
				|ПОМЕСТИТЬ ВсеТовары
				|ИЗ
				|	ОбщаяТаблицаНоменклатуры КАК ОбщаяТаблицаНоменклатуры
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	Goods.CODE,
				|	Goods.NAME,
				|	Goods.ENERGY,
				|	Goods.FIBER,
				|	Goods.FAT,
				|	Goods.CARBOHYDRATE
				|ИЗ
				|	Goods КАК Goods
				|ГДЕ
				|	НЕ Goods.TYPE = ""GROUP""
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	МАКСИМУМ(ВсеТовары.CODE) КАК CODE,
				|	ВсеТовары.NAME КАК NAME,
				|	МАКСИМУМ(ВсеТовары.ENERGY) КАК ENERGY,
				|	МАКСИМУМ(ВсеТовары.FIBER) КАК FIBER,
				|	МАКСИМУМ(ВсеТовары.FAT) КАК FAT,
				|	МАКСИМУМ(ВсеТовары.CARBOHYDRATE) КАК CARBOHYDRATE
				|ИЗ
				|	ВсеТовары КАК ВсеТовары
				|
				|СГРУППИРОВАТЬ ПО
				|	ВсеТовары.NAME";
			Запрос.УстановитьПараметр("ОбщаяТаблицаНоменклатуры",ОбщаяТаблицаНоменклатуры.Скопировать(,"CODE,NAME"));
			Запрос.УстановитьПараметр("Goods",Таблица);
			ОбщаяТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
	Таблица = Неопределено;
	
	Если ОбщаяТаблицаНоменклатуры = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если ДобавленыХЕХи Тогда 
		СписокКолонок = "CODE, NAME, ENERGY, FIBER, FAT, CARBOHYDRATE";
	Иначе
		СписокКолонок = "CODE, NAME";
		ОбщаяТаблицаНоменклатуры.Свернуть(СписокКолонок);
	КонецЕсли;
	
	МассивЭлементовIIKO = ОбщаяТаблицаНоменклатуры.ВыгрузитьКолонку("CODE");
	СписокIIKO = Новый СписокЗначений;
	СписокIIKO.ЗагрузитьЗначения(МассивЭлементовIIKO);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура));
	Если СтрокиНастроек.Количество() > 0 Тогда
		зфДобавитьНедостающиеСтрокиСоответствия(ОбщаяТаблицаНоменклатуры, ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура, СтрокиНастроек[0]);
	Иначе
		зфДобавитьНедостающиеСтрокиСоответствия(ОбщаяТаблицаНоменклатуры, ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура);
	КонецЕсли;
	
	// установим отбор по полученной номенклатуре
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияНоменклатура.Отбор,
		"СсылкаIIKO",СписокIIKO,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	Возврат ОбщаяТаблицаНоменклатуры;
	
КонецФункции

