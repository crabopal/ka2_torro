&НаКлиенте
Асинх Процедура  ПроверитьСопоставлениеВидовНоменклатуры(Режим, ИмяМетаданных)
	Отказ = Ложь;
	
	Если Не Объект.СоздаватьОбъектыПриЗаполненииСоответствий Тогда 
		Возврат
	КонецЕсли;
		
	ЕстьНезаполненныеВидыНоменклатуры = ЕстьНезаполненныеВидыНоменклатуры();
	Если ЕстьНезаполненныеВидыНоменклатуры Тогда

		Ответ = Ждать ВопросАсинх("Не заполнены соответствия видов номенклатуры.
		|При необходимости они создадутся автоматически.
		|Продолжить выполнение операции?", РежимДиалогаВопрос.ДаНет);
		
		Отказ = (Ответ = КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
	Если ЕстьНезаполненныеВидыНоменклатуры = 1 И Не Отказ Тогда
		ПолучитьВсеВидыНоменклатуры(Неопределено);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПроставитьСоответствияЭлементов(Режим, ИмяМетаданных)
	КонецЕсли;
	
КонецПроцедуры




//Проверяем наличие записей в регистре с типом ВидыНоменклатуры
//Проверяем сопоставлнение имеющихся записей 
// 
Функция ЕстьНезаполненныеВидыНоменклатуры()
	
	//1 -  проверяем наличие записей в регистре с типом ВидыНоменклатуры
	//2 -  проверяем наличие незаполненных записей
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(питСоответствияОбъектовIIKO.СсылкаIIKO) КАК КоличествоЗаписей
		|ИЗ
		|	РегистрСведений.питСоответствияОбъектовIIKO КАК питСоответствияОбъектовIIKO
		|ГДЕ
		|	питСоответствияОбъектовIIKO.ТипОбъекта = &ПланВидовХарактеристикПитТипыОбъектовIIKOВидыНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(питСоответствияОбъектовIIKO.СсылкаIIKO) КАК КоличествоНезаполненныхЗаписей
		|ИЗ
		|	РегистрСведений.питСоответствияОбъектовIIKO КАК питСоответствияОбъектовIIKO
		|ГДЕ
		|	питСоответствияОбъектовIIKO.ТипОбъекта = &ПланВидовХарактеристикПитТипыОбъектовIIKOВидыНоменклатуры
		|	И (питСоответствияОбъектовIIKO.Ссылка1С = НЕОПРЕДЕЛЕНО
		|			ИЛИ питСоответствияОбъектовIIKO.Ссылка1С = &СправочникВидыНоменклатурыПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ПланВидовХарактеристикПитТипыОбъектовIIKOВидыНоменклатуры", ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры);
	Запрос.УстановитьПараметр("СправочникВидыНоменклатурыПустаяСсылка", Справочники.ВидыНоменклатуры.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если Не Булево(РезультатЗапроса[0].Выгрузить()[0].КоличествоЗаписей) Тогда
		//нет записей с типом ВидыНоменклатуры
		Результат = 1;
	ИначеЕсли Булево(РезультатЗапроса[1].Выгрузить()[0].КоличествоНезаполненныхЗаписей) Тогда
		//есть незаполненные записи с типом ВидыНоменклатуры
		Результат = 2;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

