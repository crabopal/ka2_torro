Процедура ВосстановитьНастройкиФормы()
	
	// Восстанавливаем настройки
	
	НастройкиПоУмолчанию = НастройкиФормыПоУмолчанию();
	Для Каждого ТекНастройка Из НастройкиПоУмолчанию Цикл
		
		ТекЗначение = ХранилищеОбщихНастроек.Загрузить("питЗагрузкаIIKO", ТекНастройка.Ключ);
		Если НЕ ТекЗначение = Неопределено Тогда
			Если ТекНастройка.Ключ = "ОбновлятьОбъектыПриЗаполненииСоответствий" Тогда
				ЭтаФорма[ТекНастройка.Ключ] = ТекЗначение;
			Иначе
				Объект[ТекНастройка.Ключ] = ТекЗначение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиФормы()
	
	НастройкиПоУмолчанию = НастройкиФормыПоУмолчанию();
	Для Каждого ТекНастройка Из НастройкиПоУмолчанию Цикл
		Если ТекНастройка.Ключ = "ОбновлятьОбъектыПриЗаполненииСоответствий" Тогда
			ХранилищеОбщихНастроек.Сохранить("питЗагрузкаIIKO",ТекНастройка.Ключ, ЭтаФорма[ТекНастройка.Ключ]);
		Иначе
			ХранилищеОбщихНастроек.Сохранить("питЗагрузкаIIKO",ТекНастройка.Ключ, Объект[ТекНастройка.Ключ]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

