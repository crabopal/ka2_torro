&НаСервере
Процедура ПолучитьВсеВидыОплатОрганизацийНаСервере()
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Вид оплаты(код)", "SIFR",Истина);
	СписокКолонок.Добавить("Вид оплаты(наименование)", "NAME");
	ТаблицаВидовОплат = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\Прием кассовой выручки.csv", СписокКолонок);
	Если ТаблицаВидовОплат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТаблицаВидовОплат.Колонки.Добавить("CODE");
	МассивЭлементовIIKO = ТаблицаВидовОплат.ВыгрузитьКолонку("SIFR");
	ТаблицаВидовОплат.ЗагрузитьКолонку(МассивЭлементовIIKO, "CODE");
	СписокIIKO = Новый СписокЗначений;
	СписокIIKO.ЗагрузитьЗначения(МассивЭлементовIIKO);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыОплатОрганизаций));
	Если СтрокиНастроек.Количество() > 0 Тогда
		зфДобавитьНедостающиеСтрокиСоответствия(ТаблицаВидовОплат, ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыОплатОрганизаций, СтрокиНастроек[0]);
	Иначе
		зфДобавитьНедостающиеСтрокиСоответствия(ТаблицаВидовОплат, ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыОплатОрганизаций);
	КонецЕсли;
	// установим отбор по полученной номенклатуре
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияПитВидыОплатОрганизаций.Отбор,"СсылкаIIKO",СписокIIKO,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

&НаКлиенте
Асинх Процедура КомандаСоздатьДокументыДПФ(МассивСозданныхДокументов,СтруктураОбработанныхДПФ,ПрерываниеЗагрузки)
	
	Если Объект.ДатаКонца < Объект.ДатаНачала Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Внимание! Введен некорректный период отбора продаж";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Объект.Продажи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПоПродажам = Неопределено; //ПолучитьРезультатПоПродажам();
	СоздаватьДокументыДПФ = Истина;
	Если Объект.ПроверятьЗаполненностьСоответствий Тогда
		СоздаватьДокументыДПФ = Ложь;
		ТекстВопроса = ПодготовитьДокументыДПФНаСервере(ПрерываниеЗагрузки);//,РезультатПоПродажам);
		Если НЕ ЗначениеЗаполнено(ТекстВопроса) ИЛИ Ждать СообщитьОЗаполненностиСоответствий(ТекстВопроса) Тогда
			СоздаватьДокументыДПФ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если СоздаватьДокументыДПФ = Истина Тогда
		МассивСозданныхДокументов = СоздатьДокументыДПФНаСервере(ПрерываниеЗагрузки);//,РезультатПоПродажам);
		Если Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта И МассивСозданныхДокументов.Количество() > 0 И НЕ ПрерываниеЗагрузки Тогда
			СтруктураОбработанныхДПФ = ВыполнитьЗагрузкуИзДанныхПродаж(МассивСозданныхДокументов);
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Операция создания чеков прекращена.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Функция СообщитьОЗаполненностиСоответствий(ТекстВопроса)
	Результат = Ложь; 
	
	ОтветНаВопрос = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если  ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции


Функция ВыполнитьЗагрузкуИзДанныхПродаж(МассивОбъектов)
	// отбор по дате
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаНачала", Объект.ДатаНачала);
	СтруктураПараметров.Вставить("ДатаКонца", Объект.ДатаКонца);
	СтруктураПараметров.Вставить("ВыводитьОтчет", Объект.ВыводитьОтчет);
	
	// по соответствиям найдем кассы ккм
	СтрокиКассККМ = Объект.ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных","КассыККМ"));
	ТаблицаКассККМ = Объект.ТаблицаСоответствияИмяУИД.Выгрузить(СтрокиКассККМ,"Ссылка1С");
	ТаблицаКассККМ.Свернуть("Ссылка1С");
	МассивКассыККМ = Новый СписокЗначений;
	Для Каждого СтрокаКасс Из ТаблицаКассККМ Цикл
		Если ЗначениеЗаполнено(СтрокаКасс.Ссылка1С) Тогда
			МассивКассыККМ.Добавить(СтрокаКасс.Ссылка1С);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Обработки.питЗагрузкаIIKO.ВыполнитьЗагрузкуИзДанныхПродаж(МассивКассыККМ,МассивОбъектов,СтруктураПараметров);
КонецФункции

// Загружает данные по продажам и формирует вопрос о продолжении загрузки.
Функция ПодготовитьДокументыДПФНаСервере(ПрерываниеЗагрузки)//РезультатПоПродажам=Неопределено)
	//Результат = Новый Структура("ТекстВопроса, СтруктураНезаполненныхРеквизитов");
	ТекстВопроса = "";
	//Если РезультатПоПродажам = Неопределено Тогда
		РезультатПоПродажам = ПолучитьРезультатПоПродажам();
	//КонецЕсли;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СтруктураНезаполненныхРеквизитов = ОбработкаОбъект.ПолучитьНезаполненныеСоответствия(РезультатПоПродажам);
	
	ТекстВопроса = "Имеются незаполненные соответствия в разделах: ";
	
	ЕстьНезаполненныеСоответствия = Ложь;
	
	СоответствияЭлементовСтруктуры = Новый Соответствие;
	СоответствияЭлементовСтруктуры.Вставить("КассыККМ","Кассы ККМ");
	СоответствияЭлементовСтруктуры.Вставить("Номенклатура","Номенклатура");
	СоответствияЭлементовСтруктуры.Вставить("питВидыОплатОрганизаций", "Виды оплат");
	СоответствияЭлементовСтруктуры.Вставить("питМодификаторы", "Модификаторы");
	СоответствияЭлементовСтруктуры.Вставить("питПричиныОтменИСписаний", "Причины отмен и списаний");
	СоответствияЭлементовСтруктуры.Вставить("питМестаПечати", "Места печати");

	
	Для Каждого ЭлементСтруктуры Из СтруктураНезаполненныхРеквизитов Цикл
		Если ЭлементСтруктуры.Значение.Количество() > 0 Тогда
			ТекстВопроса = ТекстВопроса + СоответствияЭлементовСтруктуры.Получить(ЭлементСтруктуры.Ключ) + ", ";
			ЕстьНезаполненныеСоответствия = Истина;
		КонецЕсли;
	КонецЦикла;
	ТекстВопроса = Лев(ТекстВопроса, СтрДлина(ТекстВопроса)-2);
	Если ЕстьНезаполненныеСоответствия Тогда
		Результат = ТекстВопроса + ". Продолжить выполнение загрузки?";
		//Результат.СтруктураНезаполненныхРеквизитов = СтруктураНезаполненныхРеквизитов;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

