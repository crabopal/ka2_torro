		НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("Асинхрон_НачатьПодключениеРасширенияРаботыСФайлами_Завершение", ЭтаФорма, Новый Структура("ЭтоВыборКаталога, ИмяМетодаНаСервере", Ложь, ИмяМетодаНаСервере)));
	Иначе
		ВызватьВыполнить(ИмяМетодаНаСервере);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВызватьВыполнить(ИмяСерверногоМетода, МассивПереданныхФайлов = Неопределено)
	Если МассивПереданныхФайлов<>Неопределено Тогда
		ВремКаталогЗагрузки = Объект.КаталогЗагрузки;
		Объект.КаталогЗагрузки = КаталогВременныхФайлов();
		//Объект.КаталогВременныхФайловНаСеревере = КаталогВременныхФайлов();
		Для Каждого ПереданныйФайл Из МассивПереданныхФайлов Цикл
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПереданныйФайл.Хранение);
			СоставныеПути = СтрРазделить(ПереданныйФайл.Имя, "\");
			АдресНаСервере = Объект.КаталогЗагрузки+СоставныеПути[СоставныеПути.Количество()-1];
			ДвоичныеДанные.Записать(АдресНаСервере);
		КонецЦикла;
	КонецЕсли;
	Выполнить(ИмяСерверногоМетода);
	Если МассивПереданныхФайлов<>Неопределено Тогда
		Объект.КаталогЗагрузки = ВремКаталогЗагрузки;
	КонецЕсли;
КонецПроцедуры

