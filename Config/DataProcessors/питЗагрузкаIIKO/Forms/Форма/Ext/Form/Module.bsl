&НаСервере
Функция ПолучитьТаблицуПродажМодификаторов(СостояниеЧека)
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Проведен ли документ", "Пометка");
	СписокКолонок.Добавить("Проданное блюдо (код)", "НоменклатураМодификатораУИД",Истина);
	СписокКолонок.Добавить("Проданное блюдо (название)", "НоменклатураМодификатора");
	СписокКолонок.Добавить("Номенклатура (код)", "МодификаторКод",Истина);
	СписокКолонок.Добавить("Номенклатура (код)", "МодификаторУИД",Истина);
	СписокКолонок.Добавить("Номенклатура (наименование)", "Модификатор");
	СписокКолонок.Добавить("Тип номенклатуры (название)", "ТипНоменклатурыНазвание");
	СписокКолонок.Добавить("Цена продажи с НДС", "Цена");
	СписокКолонок.Добавить("Сумма продажи с НДС", "Сумма");
//	СписокКолонок.Добавить("Номер", "ЧекУИД",Истина);
	СписокКолонок.Добавить("Количество","Количество");
	СписокКолонок.Добавить("Операция", "ХозОперация");
	СписокКолонок.Добавить("Номер смены", "НомерСмены");
	СписокКолонок.Добавить("Номер кассы", "КассаКод",Истина);
	
	ТаблицаИзФайла = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\Акт реализации.csv", СписокКолонок);
	
	Если ТаблицаИзФайла =Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаПродажМодификаторов = Новый ТаблицаЗначений;
	ТипЧисло = Новый ОписаниеТипов("Число");
	ТипСтрока = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100));
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипДата = Новый ОписаниеТипов("Дата");
	ТаблицаПродажМодификаторов.Колонки.Добавить("Пометка", ТипБулево);
	ТаблицаПродажМодификаторов.Колонки.Добавить("Модификатор", ТипСтрока);
	ТаблицаПродажМодификаторов.Колонки.Добавить("МодификаторКод", ТипСтрока);
	ТаблицаПродажМодификаторов.Колонки.Добавить("МодификаторУИД", ТипСтрока);
	ТаблицаПродажМодификаторов.Колонки.Добавить("НоменклатураМодификатора", ТипСтрока);
	ТаблицаПродажМодификаторов.Колонки.Добавить("НоменклатураМодификатораУИД", ТипСтрока);
	ТаблицаПродажМодификаторов.Колонки.Добавить("ЧекУИД", ТипСтрока);
	ТаблицаПродажМодификаторов.Колонки.Добавить("ХозОперация", ТипЧисло);
	ТаблицаПродажМодификаторов.Колонки.Добавить("Количество", ТипЧисло);
	ТаблицаПродажМодификаторов.Колонки.Добавить("Цена", ТипЧисло);
	ТаблицаПродажМодификаторов.Колонки.Добавить("Сумма", ТипЧисло);
	
	СлужебнаяНоменклатураМодификатора = Константы.питСлужебнаяНоменклатураМодификатора.Получить();
	
	РеквизитыСлужебнойНоменклатуры = Новый Структура("НоменклатураМодификатора,НоменклатураМодификатораУИД");
	Если ЗначениеЗаполнено(СлужебнаяНоменклатураМодификатора) Тогда
		РеквизитыСлужебнойНоменклатуры.НоменклатураМодификатора = СлужебнаяНоменклатураМодификатора.Наименование;
		РеквизитыСлужебнойНоменклатуры.НоменклатураМодификатораУИД = СлужебнаяНоменклатураМодификатора.Код;
	КонецЕсли;
	
	Для Каждого СтрТабл Из ТаблицаИзФайла Цикл
		Если НРег(СтрТабл.ТипНоменклатурыНазвание) <> "модификатор" Тогда
			Продолжить;
		ИначеЕсли СостояниеЧека = 0 Тогда
		ИначеЕсли СостояниеЧека <> СтрТабл.ХозОперация Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтр = ТаблицаПродажМодификаторов.Добавить();
		Если НЕ ЗначениеЗаполнено(СтрТабл.Модификатор) Тогда
			СтрТабл.Модификатор = "Модификатор iiko без названия";
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрТабл.НоменклатураМодификатора) Тогда
			ЗаполнитьЗначенияСвойств(СтрТабл,РеквизитыСлужебнойНоменклатуры);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТабл);
		НовСтр.Пометка = (НовСтр.Пометка="True");
		НовСтр.ЧекУИД = СтрЗаменить(Строка(СтрТабл.НомерСмены * 10000 + СтрТабл.КассаКод *100 + СтрТабл.ХозОперация),Символы.НПП,"");
		
	КонецЦикла;
	Возврат ТаблицаПродажМодификаторов;
	
КонецФункции

&НаСервере
Функция ПолучитьТаблицуВидовОплаты()
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Вид оплаты(наименование)", "ВидОплаты");//ВидОплаты
	СписокКолонок.Добавить("Вид оплаты(код)", "ВидОплатыКод",Истина);//ВидОплаты
	СписокКолонок.Добавить("Вид оплаты(код)", "ВидОплатыУИД",Истина);//ВидОплаты
	
	ТаблицаИзФайла = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(Объект.КаталогЗагрузки+"\Прием кассовой выручки.csv", СписокКолонок);
	Если ТаблицаИзФайла = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаВидовОплат = Новый ТаблицаЗначений;
	ТипСтрока = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100));
	ТаблицаВидовОплат.Колонки.Добавить("ВидОплаты", ТипСтрока);
	ТаблицаВидовОплат.Колонки.Добавить("ВидОплатыКод", ТипСтрока);
	ТаблицаВидовОплат.Колонки.Добавить("ВидОплатыУИД", ТипСтрока);

	Для Каждого СтрТабл Из ТаблицаИзФайла Цикл
		НовСтр = ТаблицаВидовОплат.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТабл);
	КонецЦикла;
	Возврат ТаблицаВидовОплат;
КонецФункции

&НаСервере
// Производит загрузку табличной части Продажи из данных ВИД с учетом установленных отборов
Функция ПолучитьСтруктуруТаблицПродаж(СостояниеЧека)
	СтруктураТаблицПродаж = Новый Структура("ТаблицаПродаж, ТаблицаМодификаторов");
	
	ТаблицаПродаж = ПолучитьТаблицуПродаж(СостояниеЧека);
	
	Если ТаблицаПродаж = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтруктураТаблицПродаж.Вставить("ТаблицаПродаж", ТаблицаПродаж);
	
	ТаблицаПродажМодификаторы = ПолучитьТаблицуПродажМодификаторов(СостояниеЧека);
	СтруктураТаблицПродаж.Вставить("ТаблицаПродажМодификаторы", ТаблицаПродажМодификаторы);
	
	Если ТаблицаПродажМодификаторы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаВидовОплаты = ПолучитьТаблицуВидовОплаты();
	Если ТаблицаВидовОплаты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтруктураТаблицПродаж.Вставить("ТаблицаВидовОплаты", ТаблицаВидовОплаты);
	
	СтруктураТаблицПродаж.Вставить("ТаблицаСоответствияИмяУИД", ПолучитьТаблицуСоответствий(ТаблицаПродаж, ТаблицаПродажМодификаторы,ТаблицаВидовОплаты));
	// Заполним таблицу соответствий
	Возврат СтруктураТаблицПродаж;
КонецФункции

&НаСервере
Процедура ЗагрузитьПродажиУдаленияНаСервере(СостояниеЧека = 0)
	Если Объект.ДатаКонца < Объект.ДатаНачала Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Введен некорректный период отбора продаж");
		Возврат;
	КонецЕсли;
	
	СтруктураПродаж = ПолучитьСтруктуруТаблицПродаж(СостояниеЧека);
	Если СтруктураПродаж = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураПродаж.ТаблицаПродажМодификаторы <> Неопределено Тогда
		Объект.Продажи.Загрузить(ТаблицаПродажСоСлужебнымиРеквизитами(СтруктураПродаж.ТаблицаПродаж,
																	СтруктураПродаж.ТаблицаПродажМодификаторы));
	Иначе
		Объект.Продажи.Загрузить(СтруктураПродаж.ТаблицаПродаж);
	КонецЕсли;
	
	Объект.Модификаторы.Загрузить(СтруктураПродаж.ТаблицаПродажМодификаторы);
	Объект.ТаблицаСоответствияИмяУИД.Загрузить(СтруктураПродаж.ТаблицаСоответствияИмяУИД);

КонецПроцедуры

Функция ТаблицаПродажСоСлужебнымиРеквизитами(ТаблицаПродаж,ТаблицаПродажМодификаторы)
	Модификаторы = ТаблицаПродажМодификаторы.СкопироватьКолонки("НоменклатураМодификатораУИД, ЧекУИД");
	Модификаторы.Свернуть("НоменклатураМодификатораУИД, ЧекУИД");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модификаторы",Модификаторы);
	Запрос.УстановитьПараметр("Продажи", ТаблицаПродаж);
	Запрос.Текст = "ВЫБРАТЬ 
	               |	Модификаторы.НоменклатураМодификатораУИД КАК НоменклатураУИД,
	               |	Модификаторы.ЧекУИД КАК ЧекУИД
	               |ПОМЕСТИТЬ МодификаторыПродаж
	               |ИЗ
	               |	&Модификаторы КАК Модификаторы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
