
#Область ПрограммныйИнтерфейс

//  Процедура - Параметры загрузки служебный каталог начало выбора завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	текСтрока = ДополнительныеПараметры.текСтрока;
	Если Результат <> Неопределено Тогда
		текДанные = Объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
		текДанные.СлужебныйКаталог = Результат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.УчетнаяЗапись = Параметры.УчетнаяЗапись;
	Обработки.питЗагрузкаIIKO.ИнициализацияПараметровЗагрузки(Объект.ПараметрыЗагрузки);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

//  Процедура - Параметры загрузки служебный каталог начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	текСтрока = Элементы.ПараметрыЗагрузки.ТекущаяСтрока;
	СтандартнаяОбработка = Ложь;
	ИмяМетаданных = ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока);
	Если ИмяМетаданных = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для данного типа объекта не ведется иерархия");
		Возврат;
	Иначе
		ПараметрыФормы = новый Структура("РежимВыбора",Истина);
		ОткрытьФорму("Справочник."+ИмяМетаданных+".ФормаВыбораГруппы",ПараметрыФормы,,,,, Новый ОписаниеОповещения("ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("текСтрока", текСтрока)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

//  Процедура - Получить настройки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПолучитьНастройки(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнена учетная запись для получения настроек по умолчанию.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ПолучитьНастройкиНаСервере();
	Сообщение = Новый СообщениеПользователю();
	Сообщение.Текст = "Настройки получены.";
	Сообщение.Сообщить();
КонецПроцедуры

//  Процедура - Сохранить настройки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СохранитьНастройки(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнена учетная запись для сохранения настроек по умолчанию.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	СохранитьНастройкиНаСервере();
	
	ДополнительныеПараметры = Новый Структура("УчетнаяЗапись, ОрганизацияЗагрузки, СкладДляЗагрузкиКасс,ВидЗагрузкиУдалений,ВыводитьОтчет,
	|ПроверятьЗаполненностьСоответствий,ЗагружатьСПустымиЦенами,ВыполнятьЗагрузкуИзДанныхПродажФронта");

	ЗаполнитьЗначенияСвойств(ДополнительныеПараметры,Объект);
	Закрыть(ДополнительныеПараметры);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
//  Процедура - Получить настройки на сервере.
//
&НаСервере
Процедура ПолучитьНастройкиНаСервере()
	Объект.ОрганизацияЗагрузки = Объект.УчетнаяЗапись.ОрганизацияЗагрузки;
	Объект.СкладДляЗагрузкиКасс = Объект.УчетнаяЗапись.СкладДляЗагрузкиКасс;
	
	
	ДополнительныеПараметры = Новый Структура("ОрганизацияЗагрузки,СкладДляЗагрузкиКасс,ПроверятьЗаполненностьСоответствий,ЗагружатьСПустымиЦенами,ВыводитьОтчет,ВидЗагрузкиУдалений, ВыполнятьЗагрузкуИзДанныхПродажФронта");
	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.УчетнаяЗапись,ДополнительныеПараметры, Истина);
		ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
		ТЧПараметрыЗагрузки = Объект.УчетнаяЗапись.ПараметрыЗагрузки;
		
		Если ТЧПараметрыЗагрузки.Количество() > 0 Тогда
			Объект.ПараметрыЗагрузки.Очистить();
			Для Каждого ТекСтрока Из ТЧПараметрыЗагрузки Цикл
				НоваяСтрока = Объект.ПараметрыЗагрузки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры

//  Процедура - Сохранить настройки на сервере.
//
&НаСервере
Процедура СохранитьНастройкиНаСервере()
	
	Попытка
		ОбъектУчетнаяЗапись = Объект.УчетнаяЗапись.ПолучитьОбъект();
		ОбъектУчетнаяЗапись.ОрганизацияЗагрузки = Объект.ОрганизацияЗагрузки;
		ОбъектУчетнаяЗапись.СкладДляЗагрузкиКасс = Объект.СкладДляЗагрузкиКасс;
		ОбъектУчетнаяЗапись.ПроверятьЗаполненностьСоответствий = Объект.ПроверятьЗаполненностьСоответствий;
		ОбъектУчетнаяЗапись.ЗагружатьСПустымиЦенами = Объект.ЗагружатьСПустымиЦенами;
		ОбъектУчетнаяЗапись.ВыводитьОтчет = Объект.ВыводитьОтчет;
		ОбъектУчетнаяЗапись.ВидЗагрузкиУдалений = Объект.ВидЗагрузкиУдалений;
		ОбъектУчетнаяЗапись.ВыполнятьЗагрузкуИзДанныхПродажФронта = Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта;
		
		ТЧПараметрыЗагрузки = Объект.ПараметрыЗагрузки;
		
		Если ТЧПараметрыЗагрузки.Количество() Тогда
			ОбъектУчетнаяЗапись.ПараметрыЗагрузки.Очистить();
			Для Каждого ТекСтрока Из ТЧПараметрыЗагрузки Цикл
				НоваяСтрока = ОбъектУчетнаяЗапись.ПараметрыЗагрузки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
		КонецЕсли;
		ОбъектУчетнаяЗапись.Записать();
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""СохранитьНастройкиНаСервере"": " + ТекстОшибки;
		Событие = "питЗагрузкаIIKO";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Отказ = Истина;
	КонецПопытки;
	
	
	
	СохранитьПараметрыЗагрузкиНаСервере();
	
КонецПроцедуры

//  Процедура - Сохранить параметры загрузки на сервере.
//
&НаСервере
Процедура СохранитьПараметрыЗагрузкиНаСервере()
	Для Каждого СтрокаТипа Из Объект.ПараметрыЗагрузки Цикл
		ТипОбъектаОбъект = СтрокаТипа.ТипОбъекта.ПолучитьОбъект();
		ТипОбъектаОбъект.Обновлять = СтрокаТипа.Обновлять;
		ТипОбъектаОбъект.Создавать = СтрокаТипа.Создавать;
		ТипОбъектаОбъект.СлужебныйКаталог = СтрокаТипа.СлужебныйКаталог;
		ТипОбъектаОбъект.ОбработкаОшибок = СтрокаТипа.ОбработкаОшибок;
		
		Попытка
			ТипОбъектаОбъект.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

//  Функция - Получить имя метаданных строки параметров.
//
// Параметры:
//  текСтрока - Строка - тек строка.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервере
Функция ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока)
	текДанные = объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
	
	ЕстьИерархия = Ложь;
	ТипЗначения = текДанные.ТипОбъекта.ТипЗначения;
	Для Каждого Тип Из ТипЗначения.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если МетаданныеТипа.Иерархический Тогда
			ЕстьИерархия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьИерархия Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МетаданныеТипа.Имя;
КонецФункции

#КонецОбласти



