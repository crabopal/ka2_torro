
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтрокиСоответствия = Объект.ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных, УИД", "Номенклатура", Параметры.НоменклатураУИД));
	Если СтрокиСоответствия.Количество() > 0 Тогда
		Номенклатура = СтрокиСоответствия[0].Наименование;
	Иначе
		Номенклатура = Параметры.НоменклатураКипер;
	КонецЕсли;
	
	МодификаторыСтроки = ПолучитьИзВременногоХранилища(Параметры.АдресМодификаторов);
	ОБъект.Модификаторы.Загрузить(МодификаторыСтроки);
КонецПроцедуры

#КонецОбласти
