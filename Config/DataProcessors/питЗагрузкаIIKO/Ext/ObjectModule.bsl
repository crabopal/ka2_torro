// Функция производит преобразование из X системы счисления в Y
//
// Параметры:
//  ЧислоXСистемы - Число - Число x системы.
//  ШаблонXСистемы - Произвольный - Знач шаблон x системы.
//  ШаблонYСистемы - Произвольный - Знач шаблон y системы.
//
// Возвращаемое значение:
//  Число - преобразованное число в системе счислений Y.
Функция ПреобразоватьВСистемуСчисления(ЧислоXСистемы, Знач ШаблонXСистемы, Знач ШаблонYСистемы) Экспорт
	
	ШаблонXСистемы = ВРег(ШаблонXСистемы);
	ШаблонYСистемы = ВРег(ШаблонYСистемы);
	
	// Вначале определим разрядность основания
	ОснованиеXСистемы = СтрДлина(ШаблонXСистемы);
	ОснованиеYСистемы = СтрДлина(ШаблонYСистемы);
	
	Если ОснованиеXСистемы = 10 Тогда
		ЧислоYРешение = "";
		ЦелаяЧасть = ЧислоXСистемы;
		
		Остаток = ЦелаяЧасть % ОснованиеYСистемы;
		ЦелаяЧасть = Цел(ЦелаяЧасть / ОснованиеYСистемы);
		
		ЧислоYРешение = Сред(ШаблонYСистемы,Остаток+1,1) + ЧислоYРешение;
		Пока Остаток > 0 Или ЦелаяЧасть > 0 Цикл

			Остаток = ЦелаяЧасть % ОснованиеYСистемы;
			ЦелаяЧасть = Цел(ЦелаяЧасть / ОснованиеYСистемы);
			
			ЧислоYРешение = Сред(ШаблонYСистемы,Остаток+1,1) + ЧислоYРешение;
		КонецЦикла;
		
		Возврат ЧислоYРешение;
	ИначеЕсли ОснованиеYСистемы = 10 Тогда
		ЧислоYРешение = 0;
		НомерРазряда = 0;
		Пока НомерРазряда < СтрДлина(ЧислоXСистемы) Цикл
			НомерРазряда = НомерРазряда + 1;
			// Найдем символ в шаблон
			Множитель = Макс(Найти(ШаблонXСистемы, Сред(Строка(ЧислоXСистемы),НомерРазряда,1))-1,0);
			
			ЧислоYРешение = ЧислоYРешение + Множитель * Pow(ОснованиеXСистемы,СтрДлина(ЧислоXСистемы)-НомерРазряда);
			
		КонецЦикла;
		Возврат ЧислоYРешение;
	Иначе
		// Вначале преобразуем в десятиричную
		ЧислоВДесятичнойСистеме = ПреобразоватьВСистемуСчисления(ЧислоXСистемы, ШаблонXСистемы, "0123456789");
		ЧислоВДесятичнойСистеме = Число(ЧислоВДесятичнойСистеме);
		Возврат ПреобразоватьВСистемуСчисления(ЧислоВДесятичнойСистеме, "0123456789", ШаблонYСистемы);
	КонецЕсли;
	
	
КонецФункции

// Первоначальная инициализация отбора
//
Процедура ИнициализацияОтбора() Экспорт
	ДоступныеПоляОтбора = Отбор.ПолучитьДоступныеПоля();
	ДоступныеПоляОтбора.Очистить();
	
	// Установим настройки отбора
	ПолеНастройки=ДоступныеПоляОтбора.Добавить("Подразделение","Подразделение",Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
	ПолеНастройки.Отбор=Истина;
	ПолеНастройки=ДоступныеПоляОтбора.Добавить("КассаККМ","Касса ККМ",Новый ОписаниеТипов("Число"));
	ПолеНастройки.Отбор=Истина;
	Отбор.УстановитьДоступныеПоля(ДоступныеПоляОтбора);
	НовыйОтбор = Отбор.Добавить("Подразделение", "Подразделение", "Подразделение");
	НовыйОтбор.Использование = Ложь;
	НовыйОтбор.ВидСравнения = ВидСравнения.ВСписке;
	НовыйОтбор = Отбор.Добавить("КассаККМ", "КассаККМ", "Касса ККМ");
	НовыйОтбор.Использование = Ложь;
	НовыйОтбор.ВидСравнения = ВидСравнения.ВСписке;
КонецПроцедуры

// Создает документы ДПФ по таблице продаж и возвращает массив созданных документов
//
// Параметры:
//  РезультатПоПродажам - Произвольный - Результат по продажам.
//  МассивСозданныхЦелевыхДокументов - Массив - Массив созданных целевых документов.
//  МассивУдаленныхЦелевыхдокументов - Массив - Массив удаленных целевыхдокументов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьДокументыДПФ(РезультатПоПродажам, МассивСозданныхЦелевыхДокументов = Неопределено, МассивУдаленныхЦелевыхдокументов = Неопределено) Экспорт
	
	МассивОбъектов = Новый Массив;
	
	// Если Продажи.Количество() = 0 Тогда
	// 	ЗагрузитьТаблицуПродаж();
	// КонецЕсли;
	
	Если Продажи.Количество() = 0 Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	Выборка = РезультатПоПродажам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	СлужебнаяНоменклатураМодификатора = Константы.питСлужебнаяНоменклатураМодификатора.Получить();
	РеквизитыСлужебнойНоменклатуры = Новый Структура("Наименование,Код,УИД");
	Если ЗначениеЗаполнено(СлужебнаяНоменклатураМодификатора) Тогда
		РеквизитыСлужебнойНоменклатуры.Наименование = СлужебнаяНоменклатураМодификатора.Наименование;
		РеквизитыСлужебнойНоменклатуры.Код = СлужебнаяНоменклатураМодификатора.Код;
		РеквизитыСлужебнойНоменклатуры.УИД = РеквизитыСлужебнойНоменклатуры.Код;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РеквизитыСлужебнойНоменклатуры",РеквизитыСлужебнойНоменклатуры);
	ДополнительныеПараметры.Вставить("ПрерватьЗагрузку", Ложь);
	
	// Получим все оплаты за период
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Номер смены", "НомерСмены");
	СписокКолонок.Добавить("Вид оплаты(код)", "ВидОплатыУИД",Истина);//ВидОплаты
	СписокКолонок.Добавить("Вид оплаты(наименование)", "ВидОплаты");//ВидОплаты
	СписокКолонок.Добавить("Номер кассы", "КассаНомер");
	СписокКолонок.Добавить("Сумма", "СуммаОплаты");//СуммаОплаты
	ТаблицаВидовОплат = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(КаталогЗагрузки+"\Прием кассовой выручки.csv", СписокКолонок);
	Если ТаблицаВидовОплат = Неопределено Тогда
		ТаблицаВидовОплат = Новый ТаблицаЗначений;
		Для Каждого ТекКолонка Из СписокКолонок Цикл
			ТаблицаВидовОплат.Колонки.Добавить(ТекКолонка.Представление);
		КонецЦикла;
	Иначе 
		ТаблицаВидовОплат.Свернуть("НомерСмены,ВидОплатыУИД,ВидОплаты","СуммаОплаты");
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ТаблицаВидовОплат",ТаблицаВидовОплат);
	
	ПрерватьЗагрузку = Ложь;
	ОбходРезультатЗапроса(Выборка,ДополнительныеПараметры);
	
	Возврат МассивОбъектов;
КонецФункции

// Функция - Получить результат по продажам.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьРезультатПоПродажам() Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаВсего,
	               |	Продажи.СуммаСкидки,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.НДС,
	               |	Продажи.СуммаНДС,
	               |	Продажи.ТипОплатыУид,
	               |	Продажи.КассаУИД,
	               |	Продажи.НомерСмены,
	               |	Продажи.ДатаСмены,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.РесторанУИД,
	               |	ВЫБОР
	               |		КОГДА Продажи.ХозОперация = 1
	               |			ТОГДА ""Продажа""
	               |		КОГДА Продажи.ХозОперация = 0
	               |				И &ВидЗагрузкиУдалений = 0
	               |			ТОГДА ""Отмена""
	               |		КОГДА Продажи.ХозОперация = 0
	               |				И &ВидЗагрузкиУдалений = 1
	               |			ТОГДА ""Возврат""
	               |		ИНАЧЕ ""Неопределено""
	               |	КОНЕЦ КАК ХозОперация,
	               |	Продажи.ДатаОтмены,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.НастройкиПричинОтменСписаний,
	               |	Продажи.ЧекНомер,
	               |	Продажи.ЧекДата,
	               |	Продажи.ЧекУИД,
	               |	Продажи.УдалениеУИД,
				   |	Продажи.ТипНоменклатурыУИД
	               |ПОМЕСТИТЬ Продажи
	               |ИЗ
	               |	&Продажи КАК Продажи
	               |ГДЕ
	               |	Продажи.Пометка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
				   |
	               |ВЫБРАТЬ
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаВсего,
	               |	Продажи.СуммаСкидки,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.НДС,
	               |	Продажи.СуммаНДС,
	               |	Продажи.ТипОплатыУид,
	               |	Продажи.КассаУИД КАК КассаУИД,
	               |	Продажи.НомерСмены КАК НомерСмены,
	               |	Продажи.ДатаСмены КАК ДатаСмены,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.РесторанУИД КАК РесторанУИД,
	               |	Продажи.ХозОперация КАК ХозОперация,
	               |	Продажи.ДатаОтмены,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.НастройкиПричинОтменСписаний,
	               |	Продажи.ЧекНомер,
	               |	Продажи.ЧекДата КАК ЧекДата,
	               |	Продажи.ЧекУИД КАК ЧекУИД,
	               |	Продажи.УдалениеУИД КАК УдалениеУИД,
				   |	Продажи.ТипНоменклатурыУИД КАК ТипНоменклатурыУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВЫБОР
	               |		КОГДА Продажи.ЧекДата <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Продажи.ЧекДата <> NULL
	               |				И Продажи.ЧекДата <> НЕОПРЕДЕЛЕНО
	               |			ТОГДА Продажи.ЧекДата
	               |		КОГДА Продажи.ХозОперация <> 1
	               |				И Продажи.ДатаСмены <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Продажи.ДатаСмены <> NULL
	               |				И Продажи.ДатаСмены <> НЕОПРЕДЕЛЕНО
	               |			ТОГДА Продажи.ДатаСмены
	               |		ИНАЧЕ &ТекущаяДата
	               |	КОНЕЦ
	               |ИТОГИ ПО
	               |	ЧекУИД,
	               |	УдалениеУИД,
	               |	РесторанУИД,
	               |	ХозОперация,
	               |	КассаУИД,
	               |	ЧекДата,
	               |	ДатаСмены,
	               |	НомерСмены";
	Запрос.УстановитьПараметр("Продажи", Продажи.Выгрузить());
	Запрос.УстановитьПараметр("ВидЗагрузкиУдалений", ВидЗагрузкиУдалений);
	Результат = Запрос.Выполнить();
	
	Возврат Результат;
	
КонецФункции


// Получает объект ИБ по его идентификатору
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ЭтоГруппа - Произвольный - Это группа.
//  СоздаватьОбъект - Произвольный - Создавать объект.
//
// Возвращаемое значение:
// 	Массив - Массив родителей всех уровней.	
Функция ПолучитьОбъектПоИД(Знач ИДСтрокой, МенеджерОбъекта, ЭтоГруппа, СоздаватьОбъект = Истина) Экспорт
	
	ОбъектСсылка = ПолучитьСсылкуПоИД(ИДСтрокой, МенеджерОбъекта);
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	// Попытка получения объекта
	ОбъектБазыДанных = ОбъектСсылка.ПолучитьОбъект();
	Если ОбъектБазыДанных=Неопределено Тогда
		Если СоздаватьОбъект Тогда
			// Создание объекта в базе...
			Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка)) Тогда
				Объект = МенеджерОбъекта.СоздатьДокумент();
			ИначеЕсли ЭтоГруппа Тогда
				Объект = МенеджерОбъекта.СоздатьГруппу();
			Иначе
				Объект = МенеджерОбъекта.СоздатьЭлемент();
			КонецЕсли; 
			// ... с заданной ссылкой
			Объект.УстановитьСсылкуНового(ОбъектСсылка);
		Иначе
			Объект = ОбъектБазыДанных;
		КонецЕсли; 
	Иначе
		// Объект уже есть в базе
		Объект = ОбъектБазыДанных;
	КонецЕсли;
	
	Возврат Объект;
		
КонецФункции // ПолучитьОбъектПоИД

// Получает ссылку по ее идентификатору
//
// Параметры:
//  ИсхИДСтрокой - Произвольный - Знач исх ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ПроверитьНаличие - Произвольный - Проверить наличие.
//
// Возвращаемое значение:
// 	Ссылка - Искомая ссылка.	
Функция ПолучитьСсылкуПоИД(Знач ИсхИДСтрокой, МенеджерОбъекта, ПроверитьНаличие = Ложь) Экспорт
	
	Результат = МенеджерОбъекта.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИсхИДСтрокой) Тогда
		
		// Преобразуем в корректное значение ID
		ИДСтрокой = ПолучитьИДПоСтроке(ИсхИДСтрокой);
		// Получение ИД из строки
		ИД = Новый УникальныйИдентификатор(ИДСтрокой);
		// Получение ссылки по ИД
		Результат = МенеджерОбъекта.ПолучитьСсылку(ИД);
        // Проверяем есть объект в нашей БД
		Если ПроверитьНаличие Тогда
			Если ПустаяСтрока(Результат.ВерсияДанных) Тогда
				// Такого объекта в базе нет
				Результат = МенеджерОбъекта.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;

	// Возврат ссылки (без проверки не исключается что "битая")
	Возврат Результат;
		
КонецФункции // ПолучитьСсылкуПоИД

// Получает ссылку объекта ИБ по его идентификатору
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//
// Возвращаемое значение:
// 	Ссылка - Ссылка объекта ИБ.	
Функция ПолучитьИДПоСтроке(Знач ИДСтрокой) Экспорт 
	
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "{", "");
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "}", "");

	Возврат ИДСтрокой;
	
КонецФункции // ПолучитьИДПоСтроке()

// Получаем все незаполненные реквизиты соответствий
//
// Параметры:
//  РезультатПоПродажам - Произвольный - Результат по продажам.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьНезаполненныеСоответствия(РезультатПоПродажам) Экспорт
	СтруктураНезаполненныхСоответствий = Новый Структура;
	СтруктураНезаполненныхСоответствий.Вставить("КассыККМ", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("Номенклатура", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("питМодификаторы", Новый Массив);
	// СтруктураНезаполненныхСоответствий.Вставить("ТипыОплат", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("питВидыОплатОрганизаций", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("питПричиныОтменИСписаний", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("питМестаПечати", Новый Массив);
	
	// Если Продажи.Количество() = 0 Тогда
	// 	ЗагрузитьТаблицуПродаж();
	// КонецЕсли;
	
	Если Продажи.Количество() = 0 Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	Выборка = РезультатПоПродажам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ОбходРезультатЗапросаПроверка(Выборка, СтруктураНезаполненныхСоответствий);
	
	Возврат  СтруктураНезаполненныхСоответствий;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Происходит обход выборки из таблицы продаж IIKO и создание документов ДПФ
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура ОбходРезультатЗапроса(Выборка,ДополнительныеПараметры)
	Пока Выборка.Следующий() Цикл
		Если ПрерватьЗагрузку Тогда
			Прервать;
		КонецЕсли;
		
		Если Выборка.Группировка() = "НомерСмены" Тогда
			
			Если ЗначениеЗаполнено(ДатаНачала) И Дата(Выборка.ЧекДата)<НачалоДня(ДатаНачала)
				ИЛИ ЗначениеЗаполнено(ДатаКонца) И Дата(Выборка.ЧекДата)>КонецДня(ДатаКонца) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат = СоздатьДокументДПФ(Выборка,ДополнительныеПараметры);
			Если Результат = 2 Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Загрузка документов остановлена";
				Сообщение.Сообщить();
				ПрерватьЗагрузку = Истина;
			КонецЕсли;
			#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
			#КонецЕсли
		Иначе
			Выборка1 =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
			ОбходРезультатЗапроса(Выборка1,ДополнительныеПараметры);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Функция - Получить установить соответствие документа.
//
// Параметры:
//  ЧекУИД - Произвольный - Чек уид.
//  ОбъектЧек - Произвольный - Объект чек.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
Функция ПолучитьУстановитьСоответствиеДокумента(ЧекУИД, ОбъектЧек = Неопределено)
	
	ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовIIKO.Чек;// ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПолучитьОбъектПоМетаданным("питДанныеПродажФронта");
	
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовIIKO.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СсылкаIIKO.Установить(ЧекУИД);
	НаборЗаписей.Отбор.ТипОбъекта.Установить(ТипПВХ);
	НаборЗаписей.Прочитать();
	
	Если ОбъектЧек = Неопределено Тогда
		Если НаборЗаписей.Количество() = 1 Тогда
			Возврат НаборЗаписей[0].Ссылка1С;
		КонецЕсли;
	Иначе
		ДанныеИзменены = Ложь;
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись =  НаборЗаписей.Добавить();
		Иначе
			НоваяЗапись =  НаборЗаписей[0];
		КонецЕсли;
		НоваяЗапись.СсылкаIIKO = ЧекУИД;
		НоваяЗапись.ТипОбъекта = ТипПВХ;
		НоваяЗапись.Ссылка1С = ОбъектЧек.Ссылка;
		
		НаборЗаписей.Записать(Истина);
		
	КонецЕсли;
	
КонецФункции

// Возвращает результат записи документа ДПФ по переданной выборке из таблицы продаж
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьДокументДПФ(Выборка, ДополнительныеПараметры) //Выборка - ВыборкаНомерСмены
	
	УпаковкиКэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Результат = 0;
	
	СтрутураЭлементаIIKO = Новый Структура;
	СтрутураЭлементаIIKO.Вставить("УИД");
	СтрутураЭлементаIIKO.Вставить("Наименование");
	СтрутураЭлементаIIKO.Вставить("Код");
	
	МенеджерОбъекта = Документы.питДанныеПродажФронта;
	
	ДПФОбъект = ПолучитьУстановитьСоответствиеДокумента(Выборка.ЧекУИД+Выборка.ХозОперация);
	
	Если ДПФОбъект = Неопределено ИЛИ ДПФОбъект.ПометкаУдаления Тогда
		// Если ДПФ не был найден или найден, но с пометкой на удаление, тогда создадим новый.
		ДПФОбъект = Документы.питДанныеПродажФронта.СоздатьДокумент();
	Иначе
		ДПФОбъект = ДПФОбъект.ПолучитьОбъект();
	КонецЕсли;
	
	// По таблице соответствия найдем параметры
	Если ЗначениеЗаполнено(Выборка.ЧекУИД) Тогда
		// СтрокиСоответствия = ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных, УИД",
		// "питДанныеПродажФронта", Выборка.ЧекУИД));
		// Если СтрокиСоответствия.Количество() > 0 Тогда
		// 	ДПФОбъект.НомерЧека = СтрокиСоответствия[0].Код;
		// КонецЕсли;
		ДПФОбъект.НомерЧека = Выборка.ЧекУИД;
	КонецЕсли;
	
	// Запишем в комментарий все чеки iiko связанные с данным Чеком Общепита
	МассивНомераЧеков = Новый Массив;
	СтрокиСоответствия = ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных, УИД", "питДанныеПродажФронта", Выборка.ЧекУИД));
	Для Каждого СтрокаСоответствия Из СтрокиСоответствия Цикл
		МассивНомераЧеков.Добавить(СтрЗаменить(Строка(СтрокаСоответствия.Код),Символы.НПП,""));
	КонецЦикла;
	ДПФОбъект.Комментарий = "Номера чеков iiko:" + СтрСоединить(МассивНомераЧеков,",");
	
	// Если есть, получим УИД документа продажи
	Если Выборка.ХозОперация <> "Продажа" И ЗначениеЗаполнено(Выборка.ЧекУИД) Тогда
		УИДЧекаПродажи = ПривестиКСтандартамУИД(Выборка.ЧекУИД);
		// Закомментировано так как приводит к битой ссылке на форме документа
		// ДПФОбъект.ИДПродажи = СокрЛП(Новый УникальныйИдентификатор); 
		ДПФОбъект.ДатаЧека = Дата(Выборка.ЧекДата);
	КонецЕсли;
	
	ДПФОбъект.Товары.Очистить();
	ДПФОбъект.Оплаты.Очистить();
	ДПФОбъект.Модификаторы.Очистить();
	
	// предопределенные значения
	ДПФОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Если Выборка.ХозОперация = "Продажа" Тогда
		ДПФОбъект.Дата = Дата(Выборка.ЧекДата);
		ДПФОбъект.ДатаЧека = Дата(Выборка.ЧекДата);
	Иначе
		Если ЗначениеЗаполнено(Выборка.ЧекДата) Тогда
			ДПФОбъект.Дата = Дата(Выборка.ЧекДата);
		Иначе
			ДПФОбъект.Дата = Дата(Выборка.ДатаСмены);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДПФОбъект.Дата) Тогда
		ДПФОбъект.Дата = ТекущаяДата();
	КонецЕсли;
	СтрутураЭлементаIIKO.Вставить("Дата",ДПФОбъект.Дата); 
	
	Если ДПФОбъект.ЭтоНовый() Или Не ЗначениеЗаполнено(ДПФОбъект.Номер) Тогда
		ДПФОбъект.УстановитьНовыйНомер();
	КонецЕсли; 
	
	// Тип цен
	ДПФОбъект.ТипЦен = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнойТипЦенПродажи");
	
	ДПФОбъект.СуммаВключаетНДС = Истина;
	
	// Касса
	СтрутураЭлементаIIKO.УИД = Выборка.КассаУИД;
	Результат = Макс(ЗаполнитьПолеПоСоответствию(ДПФОбъект.КассаККМ,СтрутураЭлементаIIKO, 0 ),Результат);
	ДПФОбъект.КассовыйУзел = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДПФОбъект.КассаККМ,"питКассовыйУзел");
	
	// организация, подразделение
	Если НЕ ЗначениеЗаполнено(ДПФОбъект.Организация) Тогда
		ДПФОбъект.Организация = ОрганизацияЗагрузки;
	КонецЕсли;
	ДПФОбъект.Подразделение = ?(ЗначениеЗаполнено(ДПФОбъект.КассаККМ.Подразделение),ДПФОбъект.КассаККМ.Подразделение
		,питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации"));
	
	СтрутураЭлементаIIKO.Вставить("Подразделение",ДПФОбъект.Подразделение); 
	СтрутураЭлементаIIKO.Вставить("Организация",ДПФОбъект.Организация); 

	// Валюта
	ДПФОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	ДПФОбъект.КурсДокумента   = 1;
	Попытка
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаРегламентированногоУчета.Получить(), ДПФОбъект.Дата);
		ДПФОбъект.КурсДокумента = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
	Исключение
	КонецПопытки;
	
	СтрутураЭлементаIIKO.Вставить("Валюта",ДПФОбъект.ВалютаДокумента); 
	
	// НомерСмены
	СтрутураЭлементаIIKO.Вставить("Значение", Выборка.НомерСмены);
	Результат =  Макс(ЗаполнитьПолеПоСоответствию(ДПФОбъект.НомерСмены,СтрутураЭлементаIIKO, 3 ), Результат);
	
	// Дата смены
	СтрутураЭлементаIIKO.Вставить("Значение", Выборка.ДатаСмены);
	Результат =  Макс(ЗаполнитьПолеПоСоответствию(ДПФОбъект.ДатаСмены,СтрутураЭлементаIIKO, 3 ), Результат);
	
	// хоз операция
	СтрутураЭлементаIIKO.УИД = "";
	СтрутураЭлементаIIKO.Наименование = Выборка.ХозОперация;
	Если Выборка.ХозОперация = "Продажа" Тогда
		ДПФОбъект.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаПродажа;
	ИначеЕсли ВидЗагрузкиУдалений = 0 Тогда
		ДПФОбъект.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаОтмена;
	Иначе
		ДПФОбъект.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаВозврат;
	КонецЕсли;
	
	// Получим все оплаты за период
	ТаблицаВидовОплат = ДополнительныеПараметры.ТаблицаВидовОплат;
	Если ТаблицаВидовОплат = Неопределено Тогда
		// Получим все оплаты за период
		СписокКолонок = Новый СписокЗначений;
		СписокКолонок.Добавить("Номер смены", "НомерСмены");
		СписокКолонок.Добавить("Вид оплаты(код)", "ВидОплатыУИД",Истина);//ВидОплаты
		СписокКолонок.Добавить("Вид оплаты(наименование)", "ВидОплаты");//ВидОплаты
		СписокКолонок.Добавить("Номер кассы", "КассаНомер");
		СписокКолонок.Добавить("Сумма", "СуммаОплаты");//СуммаОплаты
		ТаблицаВидовОплат = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(КаталогЗагрузки+"\Прием кассовой выручки.csv", СписокКолонок);
		ТаблицаВидовОплат.Свернуть("НомерСмены,ВидОплатыУИД,КассаНомер,ВидОплаты","СуммаОплаты");
		Если ТаблицаВидовОплат = Неопределено Тогда
			ТаблицаВидовОплат = Новый ТаблицаЗначений;
			Для Каждого ТекКолонка Из СписокКолонок Цикл
				ТаблицаВидовОплат.Колонки.Добавить(ТекКолонка.Представление);
			КонецЦикла;
		КонецЕсли;
		ДополнительныеПараметры.Вставить("ТаблицаВидовОплат",ТаблицаВидовОплат);
	КонецЕсли;
	
	ДобавленныеОплаты = Новый Массив;
	ДобавленныеМодификаторы = Новый Массив;
	
	ЗагружатьПустыеЦеныНоменклатуры = Истина;
	Если НЕ ЗагружатьСПустымиЦенами И (Выборка.ХозОперация = "Продажа") Тогда
		 ЗагружатьПустыеЦеныНоменклатуры = Ложь;
	КонецЕсли;
	
	КэшированныеЗначенияУпаковок = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ВыборкаНоменклатура = Выборка.Выбрать();
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		// бывает, что приходит пустой УИД номенклатуры
		НоменклатураУИД = ВыборкаНоменклатура.НоменклатураУИД;
		Если Не ЗначениеЗаполнено(ВыборкаНоменклатура.НоменклатураУИД) Тогда
			Если НЕ ЗначениеЗаполнено(ДополнительныеПараметры.РеквизитыСлужебнойНоменклатуры.УИД) Тогда
				Продолжить;
			Иначе
				НоменклатураУИД = ДополнительныеПараметры.РеквизитыСлужебнойНоменклатуры.УИД;
			КонецЕсли; 
		КонецЕсли;
		
		СтрутураЭлементаIIKO.Вставить("ЕдиницаИзмерения", (Обработки.питЗагрузкаIIKO.НайтиПоНаименованиюКодуИСоздать("УпаковкиЕдиницыИзмерения","",ВыборкаНоменклатура.ЕдиницаИзмерения)));
		
		Если ЗначениеЗаполнено(ВыборкаНоменклатура.НДС) Тогда
			Попытка
				СтавкаЧислом = Число(ВыборкаНоменклатура.НДС);
			Исключение
				ТекущаяДата = ТекущаяДатаСеанса();
				Если ТекущаяДата >= '20190101' Тогда
					СтавкаЧислом = 20;
				ИначеЕсли ТекущаяДата >= '20260101' Тогда
					СтавкаЧислом = 22;
				КонецЕсли;
			КонецПопытки;
			СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(СтавкаЧислом);
		Иначе
			СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу();
		КонецЕсли;
		СтрутураЭлементаIIKO.Вставить("СтавкаНДС", СтавкаНДС);
		
		Цена = ?(ВыборкаНоменклатура.Количество = 0, 0, ВыборкаНоменклатура.СуммаВсего / ВыборкаНоменклатура.Количество); 
		
		Если ЗагружатьПустыеЦеныНоменклатуры ИЛИ НЕ (Окр(Цена,2) = 0) Тогда
			
			НоваяСтрокаТовары = ДПФОбъект.Товары.Добавить();
			
			// Номенклатура
			СтрутураЭлементаIIKO.УИД = НоменклатураУИД;
			СтрутураЭлементаIIKO.Код = НоменклатураУИД;
			Если ЗначениеЗаполнено(ВыборкаНоменклатура.ТипНоменклатурыУИД) Тогда
				СтрутураЭлементаIIKO.Вставить("ВидНоменклатурыУИД",ВыборкаНоменклатура.ТипНоменклатурыУИД);
			КонецЕсли;
			
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.Номенклатура,СтрутураЭлементаIIKO, 0 ), Результат); 
			// ДПФОбъект.ОбработкаРеквизита("Товары.Номенклатура",НоваяСтрокаТовары);
			
			// Коэффициент
			НоваяСтрокаТовары.Коэффициент = 1;
			
			// Единица
			НоваяСтрокаТовары.Упаковка = НоваяСтрокаТовары.Номенклатура.ЕдиницаИзмерения;
			
			// Количество
			НоваяСтрокаТовары.Количество = ВыборкаНоменклатура.Количество;
			НоваяСтрокаТовары.КоличествоУпаковок = ВыборкаНоменклатура.Количество * 
				питОбщегоНазначения.ПолучитьКоэффициентУпаковки(НоваяСтрокаТовары.Номенклатура, НоваяСтрокаТовары.Упаковка, КэшированныеЗначенияУпаковок);
			
			// Сумма
			НоваяСтрокаТовары.Сумма = ВыборкаНоменклатура.СуммаВсего;
			
			// Цена
			НоваяСтрокаТовары.Цена = Цена;
			
			// Дата отмены
			НоваяСтрокаТовары.ДатаОтмены = ВыборкаНоменклатура.ДатаОтмены;
			
			// место печати
			Если ЗаполнениеМестПечатиВЧеках = 0 тогда  // 1 - заполние по чекам, по умолчанию
				СтрутураЭлементаIIKO.УИД = ВыборкаНоменклатура.МестоПечатиУИД;
				Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO, "питМестаПечати",ПланыВидовХарактеристик.питТипыОбъектовIIKO.питМестаПечати);
				НоваяСтрокаТовары.МестоПечати = СтрутураЭлементаIIKO.Ссылка1С;
			ИначеЕсли ЗаполнениеМестПечатиВЧеках = 1 тогда   // 2 - песто печати вычисляется
				Если ЗначениеЗаполнено(ДПФОбъект.КассаККМ) Тогда
					УзелОбмена =ДПФОбъект.КассаККМ.питКассовыйУзел;
					МестоПечати = ПолучитьМестоПечатиДляНоменклатуры(НоваяСтрокаТовары.Номенклатура, УзелОбмена);
				КонецЕсли;
			КонецЕсли;
			НоваяСтрокаТовары.МестоПечати = МестоПечати;
			
			// НДС
			НоваяСтрокаТовары.СтавкаНДС = СтавкаНДС;
			
			// Сумма НДС
			// Пересчитаем Сумму НДС, т.к. возможно ставка ндс изменялась.
			НоваяСтрокаТовары.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС((НоваяСтрокаТовары.Сумма - НоваяСтрокаТовары.СуммаСкидки),
				НоваяСтрокаТовары.СтавкаНДС, Истина);
			
			// Флаг со списанием
			// Если ЗначениеЗаполнено(ВыборкаНоменклатура.НастройкиПричинОтменСписаний) Тогда
			// 	НоваяСтрокаТовары.СоСписанием = 1;
			// КонецЕсли;
			
			Если Выборка.ХозОперация <> "Продажа" Тогда
				// причина отмены
				СтрутураЭлементаIIKO.УИД = ВыборкаНоменклатура.ПричинаОтменСписанийУИД;
				Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.ПричинаОтмены,СтрутураЭлементаIIKO, 0 ), Результат); 
				НоваяСтрокаТовары.СоСписанием = НоваяСтрокаТовары.ПричинаОтмены.СоСписанием;
					
//  				Сообщение = Новый СообщениеПользователю();
//    				Сообщение.Текст = "Стр("ru='Настройка <Со списанием> в данных продаж отлична от соответствующей настройки в
// справочн";.
//  				Сообщение.Сообщить();
// причин списаний. Для синхронизации данных установить соответствующий флаг в параметрах загрузки объектов';"));.
			КонецЕсли;
		КонецЕсли;
		
		Если ДобавленныеМодификаторы.Найти(ВыборкаНоменклатура.ЧекУИД)=Неопределено Тогда
			// МОДИФИКАТОРЫ
			МодификаторыНоменклатуры = Модификаторы.НайтиСтроки(Новый Структура("ЧекУИД", ВыборкаНоменклатура.ЧекУИД));
			Для Каждого СтрокаМодификатора Из МодификаторыНоменклатуры Цикл
				Если ЗначениеЗаполнено(СтрокаМодификатора.МодификаторУИД) Тогда
					НоваяСтрокаМодификаторов = ДПФОбъект.Модификаторы.Добавить();
					СтрутураЭлементаIIKO.Вставить("ЦенаМодификатора", ?(СтрокаМодификатора.Количество = 0,0,СтрокаМодификатора.Сумма / СтрокаМодификатора.Количество));
					// модификатор
					СтрутураЭлементаIIKO.УИД = СтрокаМодификатора.МодификаторУИД;
					СтрутураЭлементаIIKO.Код = СтрокаМодификатора.МодификаторУИД;
					Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.Модификатор,СтрутураЭлементаIIKO, 0 ), Результат); 
					
					НоваяСтрокаМодификаторов.Номенклатура = НоваяСтрокаМодификаторов.Модификатор.ДопНоменклатура;
					НоваяСтрокаМодификаторов.УпаковкаНоменклатуры = НоваяСтрокаМодификаторов.Модификатор.ЕдиницаИзмеренияНоменклатуры;
					// Подставляем цену модификатора
					НоваяСтрокаМодификаторов.Цена = СтрокаМодификатора.Цена;
					НоваяСтрокаМодификаторов.Сумма = СтрокаМодификатора.Сумма;
					
					НоваяСтрокаМодификаторов.Коэффициент = 1;
					
					// основная номенклатура
					Если ЗначениеЗаполнено(СтрокаМодификатора.НоменклатураУИД) Тогда
						СтрутураЭлементаIIKO.УИД = СтрокаМодификатора.НоменклатураУИД;
						Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.НоменклатураОсновнойПозиции,СтрутураЭлементаIIKO, 0 ), Результат); 
					КонецЕсли;
					
					// Количество
					СтрутураЭлементаIIKO.Вставить("Значение", СтрокаМодификатора.Количество);
					Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.Количество,СтрутураЭлементаIIKO, 3 ), Результат);
					
					СтрутураЭлементаIIKO.Вставить("Значение", НоваяСтрокаМодификаторов.Количество * НоваяСтрокаМодификаторов.Модификатор.КоличествоНоменклатуры);
					Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.КоличествоНоменклатуры,СтрутураЭлементаIIKO, 3 ), Результат);
					
					КоэффициентНоменклатуры = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(
						НоваяСтрокаМодификаторов.Номенклатура, 
						НоваяСтрокаМодификаторов.УпаковкаНоменклатуры, 
						УпаковкиКэшированныеЗначения);
					НоваяСтрокаМодификаторов.КоличествоУпаковокНоменклатуры = 
						НоваяСтрокаМодификаторов.КоличествоНоменклатуры / КоэффициентНоменклатуры;
					
					Если НЕ ЗначениеЗаполнено(НоваяСтрокаМодификаторов.НоменклатураОсновнойПозиции) Тогда
						Если ЗначениеЗаполнено(СтрокаМодификатора.НоменклатураМодификатораУИД) Тогда
							СтрутураЭлементаIIKO.УИД = СтрокаМодификатора.НоменклатураМодификатораУИД;
							СтрутураЭлементаIIKO.Код = СтрокаМодификатора.НоменклатураМодификатораУИД;
							СтрутураЭлементаIIKO.Наименование = СтрокаМодификатора.НоменклатураМодификатора;
						Иначе
							ЗаполнитьЗначенияСвойств(СтрутураЭлементаIIKO, ДополнительныеПараметры.РеквизитыСлужебнойНоменклатуры);
						КонецЕсли;
						Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.НоменклатураОсновнойПозиции,СтрутураЭлементаIIKO, 0 ), Результат); 
					КонецЕсли;
					// Сумма
					// СтрутураЭлементаIIKO.Вставить("Значение", СтрокаМодификатора.Сумма);
//   Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.Сумма,СтрутураЭлементаIIKO, 3 ),
// Результат);.
				КонецЕсли;
			КонецЦикла;
			ДобавленныеМодификаторы.Добавить(ВыборкаНоменклатура.ЧекУИД);
		КонецЕсли;
		
		Если Выборка.ХозОперация = "Продажа" Тогда
			Если ДобавленныеОплаты.Найти(ВыборкаНоменклатура.НомерСмены)=Неопределено Тогда
				СтрокиОплат = ТаблицаВидовОплат.НайтиСтроки(Новый Структура("НомерСмены", ВыборкаНоменклатура.НомерСмены));
				Если СтрокиОплат.Количество()>0 Тогда
					Для Каждого СтрокаОплаты Из СтрокиОплат Цикл
						
						// ОПЛАТЫ
						НоваяСтрокаОплаты = ДПФОбъект.Оплаты.Добавить();
						
						// вид оплаты
						СтрутураЭлементаIIKO.УИД = СтрокаОплаты.ВидОплатыУИД;
						Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаОплаты.ВидОплаты,СтрутураЭлементаIIKO, 0 ), Результат); 
						НоваяСтрокаОплаты.Фискальный = НоваяСтрокаОплаты.ВидОплаты.питФискальный;
						
						// сумма оплаты
						НоваяСтрокаОплаты.СуммаОплаты = СтрокаОплаты.СуммаОплаты;
						
					КонецЦикла;
				КонецЕсли;
				ДобавленныеОплаты.Добавить(ВыборкаНоменклатура.НомерСмены);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	// Свернем таблицы оплат и товаров
	ДПФОбъект.Оплаты.Свернуть("ВидОплаты, Фискальный, Карточка","СуммаОплаты, Сдача");
	ДПФОбъект.Товары.Свернуть("Номенклатура,Упаковка,Коэффициент,
	|СтавкаНДС,МестоПечати,ДатаОтмены,СоСписанием,ПричинаОтмены, Цена",
	"Количество,КоличествоУпаковок,Сумма,СуммаНДС");
	ДПФОбъект.Модификаторы.Свернуть("Модификатор,Коэффициент,НоменклатураОсновнойПозиции,Номенклатура,УпаковкаНоменклатуры,Цена",
	"Количество,КоличествоНоменклатуры,КоличествоУпаковокНоменклатуры,Сумма");
	
	// Рассчитаем суммы
	ДПФОбъект.РасчетСуммДокумента();
	
	Если Результат = 1 ИЛИ Результат = 2 Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Загрузка <" + ДПФОбъект + "> отменена";
		Сообщение.Сообщить();
	Иначе 
		ВыполнитьЗаписьОбъекта(ДПФОбъект, Новый Структура);
		ПолучитьУстановитьСоответствиеДокумента(Выборка.ЧекУИД+Выборка.ХозОперация, ДПФОбъект);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Выполняет запись полученного при чтении объекта
//
// Параметры:
//  ЭлементДанных - Произвольный - Элемент данных.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция  ВыполнитьЗаписьОбъекта(ЭлементДанных, ДопПараметры)
		
	Попытка
		
		ЭлементДанных.ОбменДанными.Загрузка = ИСТИНА;
		Попытка
			ЭлементДанных.ОбменДанными.Отправитель = ДопПараметры.Отправитель;
		Исключение КонецПопытки;
		
		Попытка
			Если ЭлементДанных.Предопределенный И ЭлементДанных.ПометкаУдаления Тогда
				ЭлементДанных.ПометкаУдаления = Ложь;
			КонецЕсли; 
		Исключение КонецПопытки;
		
		// Проверка регистрации
		
		ЭлементДанных.Записать();
		
		// только сейчас имеем право сказать, что объект получен
		ЭлементДанныхЗаписан = Неопределено;
		ЭлементДанных.ДополнительныеСвойства.Свойство("ЭлементДанныхЗаписан", ЭлементДанныхЗаписан);
		Если ЭлементДанныхЗаписан <> Истина Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Объект получен: " + ЭлементДанных;
			Сообщение.Сообщить();
			
			ЭлементДанных.ДополнительныеСвойства.Вставить("ЭлементДанныхЗаписан", Истина);
			
			МассивОбъектов.Добавить(ЭлементДанных.Ссылка);
		КонецЕсли; 
		
	Исключение
		
		// Необходимо приостановить обмен с ошибкой,
		// иначе произойдет увеличение номера сообщения обмена и при отправке ответа
		// данные с ошибкой больше в данный узел отправлены не будут
		ТекстОшибки = "Ошибка получения объекта: " + ЭлементДанных + ": " + ОписаниеОшибки();
				
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "екстОшибк";
		Сообщение.Сообщить();
		
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
КонецФункции // ВыполнитьЗаписьОбъекта()

// Функция - Привести к стандартам уид.
//
// Параметры:
//  Знач УидЧека - Произвольный - Знач уид чека.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПривестиКСтандартамУИД(Знач УидЧека)
	ШаблонУИД = Строка(Новый УникальныйИдентификатор);
	
	УидСтрока = УидЧека;
	УидСтрока = СтрЗаменить(УидСтрока, "-", "");
	УидСтрока = СтрЗаменить(УидСтрока, "{", "");
	УидСтрока = СтрЗаменить(УидСтрока, "}", "");
	
	УидИзмененный = "";
	
	Для КолЗн = 0 По 4 Цикл
		НомерСимволаШаблон = Найти(ШаблонУИД,"-");
		Если НомерСимволаШаблон = 0 Тогда
			НомерСимволаШаблон = СтрДлина(ШаблонУИД)+1;
		КонецЕсли;
		
		ЧастьУИД = Лев(УидСтрока, НомерСимволаШаблон-1);
		
		ДлинаЧастиУИД = СтрДлина(ЧастьУИД);
		Для Инд = 1 По (НомерСимволаШаблон - ДлинаЧастиУИД - 1) Цикл
			ЧастьУИД = ЧастьУИД + "0";
		КонецЦикла;
		
		ШаблонУИД = Сред(ШаблонУИД, НомерСимволаШаблон + 1);
		УидСтрока = Сред(УидСтрока, НомерСимволаШаблон);
		
		УидИзмененный = УидИзмененный + ЧастьУИД + "-";
	КонецЦикла;
	
	
	УидИзмененный = "{" + Лев(УидИзмененный, СтрДлина(УидИзмененный)-1)  + "}";
	Возврат УидИзмененный;
КонецФункции

// Функция осуществляет поиск в Кэше маршрутизации печати ближайшего унаследованного
//  места печати для номенклатуры для заданного зала.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  КассовыйУзел - Произвольный - Кассовый узел.
//  Зал - Произвольный - Зал.
//  ВидМеню - Произвольный - Вид меню.
//
// Возвращаемое значение:
//  Строка - Полученнное место печати.
Функция ПолучитьМестоПечатиДляНоменклатуры(Номенклатура, КассовыйУзел, Зал = Неопределено, ВидМеню = Неопределено)
	
	Если ТаблицаНоменклатурныхПриоритетов = Неопределено Тогда
		// ДЛя определения места продажи проинициализируем таблицу номенклатурных приоритетов
		ТаблицаНоменклатурныхПриоритетов = ПолучитьТаблицуНоменклатурныхПриоритетов();
	КонецЕсли;

	УнаследованноеМестоПечати = Справочники.питМестаПечати.ПустаяСсылка();
	
	// Номенклатуру необходимо преобразовать в список, куда войдет она сама и все ее родители.
	тмпНоменклатура = Номенклатура;
	СписокНоменклатура = Новый СписокЗначений;
	Пока тмпНоменклатура <> Справочники.Номенклатура.ПустаяСсылка() Цикл
		СписокНоменклатура.Добавить(тмпНоменклатура);
		тмпНоменклатура = тмпНоменклатура.Родитель;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНоменклатурныхПриоритетов.Ссылка,
	|	ТаблицаНоменклатурныхПриоритетов.Приоритет
	|ПОМЕСТИТЬ ТЗНомПриоритетов
	|ИЗ
	|	&ТаблицаНоменклатурныхПриоритетов КАК ТаблицаНоменклатурныхПриоритетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОпределениеПриоритетов.Принтер,
	|	ОпределениеПриоритетов.ПриоритетНоменклатура + ОпределениеПриоритетов.ПриоритетВидМеню + ОпределениеПриоритетов.ПриоритетЗал КАК ПриоритетСумма,
	|	ОпределениеПриоритетов.ПриоритетНоменклатура КАК ПриоритетНоменклатура,
	|	ОпределениеПриоритетов.ПриоритетВидМеню КАК ПриоритетВидМеню,
	|	ОпределениеПриоритетов.ПриоритетЗал КАК ПриоритетЗал
	|ИЗ
	|	(ВЫБРАТЬ
	|		МаршрутизацияПечати.Номенклатура КАК Номенклатура,
	|		МаршрутизацияПечати.МестоПечати КАК Принтер,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.Номенклатура.ЭтоГруппа
	|				ТОГДА ТЗНомПриоритетов.Приоритет
	|			ИНАЧЕ ТЗНомПриоритетов.Приоритет + 1
	|		КОНЕЦ КАК ПриоритетНоменклатура,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.ВидМеню = &ПустойВидМеню
	|				ТОГДА 1
	|			ИНАЧЕ 2
	|		КОНЕЦ КАК ПриоритетВидМеню,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.Зал = &ПустойЗал
	|				ТОГДА 1
	|			ИНАЧЕ 2
	|		КОНЕЦ КАК ПриоритетЗал
	|	ИЗ
	|		РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
	|			ЛЕВОЕ СОЕДИНЕНИЕ ТЗНомПриоритетов КАК ТЗНомПриоритетов
	|			ПО (ВЫБОР
	|					КОГДА МаршрутизацияПечати.Номенклатура.ЭтоГруппа
	|						ТОГДА МаршрутизацияПечати.Номенклатура = ТЗНомПриоритетов.Ссылка
	|					ИНАЧЕ МаршрутизацияПечати.Номенклатура.Родитель = ТЗНомПриоритетов.Ссылка
	|				КОНЕЦ)
	|	ГДЕ
	|		(МаршрутизацияПечати.Номенклатура В (&Номенклатура)
	|				ИЛИ МаршрутизацияПечати.Номенклатура = &ПустаяНоменклатура)
	|		И (МаршрутизацияПечати.ВидМеню = &ВидМеню ИЛИ &ВидМеню = НЕОПРЕДЕЛЕНО
	|				ИЛИ МаршрутизацияПечати.ВидМеню = &ПустойВидМеню)
	|		И (МаршрутизацияПечати.Зал = &Зал ИЛИ &Зал = НЕОПРЕДЕЛЕНО
	|				ИЛИ МаршрутизацияПечати.Зал = &ПустойЗал)
	|		И МаршрутизацияПечати.КассовыйУзел = &Узел) КАК ОпределениеПриоритетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетСумма УБЫВ,
	|	ПриоритетНоменклатура УБЫВ,
	|	ПриоритетВидМеню УБЫВ,
	|	ПриоритетЗал УБЫВ";
	
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатура);
	Запрос.УстановитьПараметр("ВидМеню", ВидМеню);
	Запрос.УстановитьПараметр("Зал", Зал);
	Запрос.УстановитьПараметр("Узел", КассовыйУзел);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойВидМеню", Справочники.питВидыМеню.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойЗал", Справочники.питЗалы.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТаблицаНоменклатурныхПриоритетов",ТаблицаНоменклатурныхПриоритетов);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		УнаследованноеМестоПечати = Выборка.Принтер;
	КонецЕсли;
	
	Возврат УнаследованноеМестоПечати;
	
КонецФункции 

// ПолучитьУнаследованноеМестоПечатиДляНоменклатуры()
//  Функция - Получить таблицу номенклатурных приоритетов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуНоменклатурныхПриоритетов()
	
	// Получение всех номенклатурных групп.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	0 КАК Приоритет
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа";
	
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
	
	ТекСтрока = ТаблицаЗначений.Добавить();
	ТекСтрока.Ссылка    = Справочники.Номенклатура.ПустаяСсылка();
	ТекСтрока.Приоритет = 0;
	
	Для Каждого ТекСтрока Из ТаблицаЗначений Цикл
		
		тмпПриоритет    = 1;
		тмпНоменклатура = ТекСтрока.Ссылка;
		
		Пока тмпНоменклатура <> Справочники.Номенклатура.ПустаяСсылка() Цикл
			тмпНоменклатура = тмпНоменклатура.Родитель;
			тмпПриоритет    = тмпПриоритет + 1;
		КонецЦикла;
		
		ТекСтрока.Приоритет = тмпПриоритет;
		
	КонецЦикла;
	
	Возврат ТаблицаЗначений;
	
КонецФункции

// СОЗДАНИЕ И ЗАПОЛНЕНИЕ ОБЪЕКТНЫХ СУЩНОСТЕЙ

// Возвращает созданный / обновленный объект дерева метаданных по переданным параметрам
//
// Параметры:
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  СтрутураЭлементаIIKO - Произвольный - Струтура элемента iiko.
//  Настройки - Произвольный - Настройки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьОбновитьОбъект(ИмяМетаданных, СтрутураЭлементаIIKO, Настройки)
	// Попробуем найти по наименованию	
	Если СтрутураЭлементаIIKO.Свойство("Ссылка1С") И ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
		СправочникСсылка = СтрутураЭлементаIIKO.Ссылка1С;
	Иначе
		Попытка
			СправочникСсылка = Справочники[ИмяМетаданных].НайтиПоНаименованию(СтрутураЭлементаIIKO.Наименование, Истина);
			// СправочникСсылка = Справочники[ИмяМетаданных].ПустаяСсылка();
		Исключение
			СправочникСсылка = Перечисления[ИмяМетаданных].ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	
	Если (СправочникСсылка.Пустая() И Настройки.Создавать) Или НЕ СправочникСсылка.Пустая() И Настройки.Обновлять Тогда
		// Если есть такой же удаленный, тогда изменим в нем имя
		Если НЕ СправочникСсылка.Пустая() И СправочникСсылка.ПометкаУдаления Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	"+ИмяМетаданных+".Наименование КАК Наименование
			|ИЗ
			|	Справочник."+ИмяМетаданных+" КАК "+ИмяМетаданных+"
			|ГДЕ
			|	"+ИмяМетаданных+".ПометкаУдаления = ИСТИНА
			|	И "+ИмяМетаданных+".Наименование ПОДОБНО &Наименование";
			ШаблонИмени = СправочникСсылка.Наименование + " (удаленный%)";
			Запрос.УстановитьПараметр("Наименование", ШаблонИмени);
			Выборка = Запрос.Выполнить().Выбрать();
			НомерУдаленногоОбъекта = Выборка.Количество() + 1; 
			СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
			СправочникОбъект.Наименование = СправочникОбъект.Наименование + " (удаленный "+НомерУдаленногоОбъекта+")";
			Попытка
				СправочникОбъект.Записать();
			Исключение
			КонецПопытки;
			
			СтрутураЭлементаIIKO.Вставить("Код","");
			СправочникСсылка = Справочники[ИмяМетаданных].ПустаяСсылка();
		КонецЕсли;
		
		// Создаем элемент
		Если СправочникСсылка.Пустая() Тогда
			СправочникОбъект = Справочники[ИмяМетаданных].СоздатьЭлемент();
		Иначе
			СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
		КонецЕсли;
		Обработки.питЗагрузкаIIKO.УстановитьОбщиеРеквизиты(СправочникОбъект, СтрутураЭлементаIIKO, Настройки);
		
		Если ИмяМетаданных = "Номенклатура" Тогда
			
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектНоменклатура(СправочникОбъект, СтрутураЭлементаIIKO);
			Если СправочникОбъект.СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка() Тогда
				ТекСтавкаНДС = СтрутураЭлементаIIKO.СтавкаНДС;
				СправочникОбъект.СтавкаНДС = ТекСтавкаНДС;
			КонецЕсли;
		ИначеЕсли ИмяМетаданных = "питМодификаторы" Тогда
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектМодификаторы(СправочникОбъект, СтрутураЭлементаIIKO, ОрганизацияЗагрузки);
		ИначеЕсли ИмяМетаданных = "Подразделения" Тогда
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектПодразделения(СправочникОбъект, СтрутураЭлементаIIKO);
		ИначеЕсли ИмяМетаданных = "Организации" Тогда
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектОрганизации(СправочникОбъект, СтрутураЭлементаIIKO);
		ИначеЕсли ИмяМетаданных = "питВидыОплатОрганизаций" Тогда
			СтрокаОплаты = СправочникОбъект.Наименование;
			Если СтрокаОплаты = Неопределено Тогда
				ТипОплаты = Перечисления.питТипыОплат.ПлатежнаяКарта;
			ИначеЕсли Найти(НРЕГ(СтрокаОплаты),"наличные") >0  Тогда
				ТипОплаты = Перечисления.питТипыОплат.Наличные;
			ИначеЕсли Найти(НРЕГ(СтрокаОплаты),"подарочный сертификат") >0  Тогда
				ТипОплаты = Перечисления.питТипыОплат.ПодарочныйСертификатСобственный;
			ИначеЕсли Найти(НРЕГ(СтрокаОплаты),"кредит") >0  Тогда
				ТипОплаты = Перечисления.питТипыОплат.БанковскийКредит;
			Иначе
				ТипОплаты = Перечисления.питТипыОплат.ПлатежнаяКарта;
			КонецЕсли;
			СтрутураЭлементаIIKO.Вставить("ТипОплаты", ТипОплаты);
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектВидыОплат(СправочникОбъект, СтрутураЭлементаIIKO);
		ИначеЕсли ИмяМетаданных = "КассыККМ" Тогда
			Возврат СправочникСсылка;
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектКассыККМ(СправочникОбъект, СтрутураЭлементаIIKO);
		// ИначеЕсли ИмяМетаданных = "ХозОперации" Тогда
		// 	Обработки.ЗагрузкаIIKO.ПрочитатьОбъектХозоперации(СправочникОбъект, СтрутураЭлементаIIKO);
		ИначеЕсли ИмяМетаданных = "Валюты" Тогда
			Возврат СправочникСсылка;
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектВалюты(СправочникОбъект, СтрутураЭлементаIIKO);
		ИначеЕсли ИмяМетаданных = "УпаковкиЕдиницыИзмерения" Тогда
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектЕдиницыИзмерения(СправочникОбъект, СтрутураЭлементаIIKO);
		ИначеЕсли ИмяМетаданных = "СкладыКомпании" Тогда
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектСкладыКомпании(СправочникОбъект, СтрутураЭлементаIIKO);
		ИначеЕсли ИмяМетаданных = "питПричиныОтменИСписаний" Тогда
			Обработки.питЗагрузкаIIKO.ПрочитатьОбъектПричиныОтменИСписаний(СправочникОбъект, СтрутураЭлементаIIKO, Настройки);
		КонецЕсли;
		
		Попытка
			СправочникОбъект.Записать();
		Исключение
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "писаниеОшибки(";
			Сообщение.Сообщить();
		КонецПопытки;
		СправочникСсылка = СправочникОбъект.Ссылка;
		
		// После записи элемента
		Если ИмяМетаданных = "Номенклатура" Тогда
			Обработки.питЗагрузкаIIKO.НоменклатураПослеЗаписи(СправочникСсылка, СтрутураЭлементаIIKO,, ОрганизацияЗагрузки);
		КонецЕсли;
		
	КонецЕсли;
	
	// Добавим строку соответствия
	Если ЗначениеЗаполнено(СправочникСсылка) Тогда

		ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
		
		НаборЗаписей = РегистрыСведений.питСоответствияОбъектовIIKO.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СсылкаIIKO.Установить(СтрутураЭлементаIIKO.УИД);
		НаборЗаписей.Отбор.ТипОбъекта.Установить(ТипПВХ);
		НаборЗаписей.Прочитать();
		
		ДанныеИзменены = Ложь;
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись =  НаборЗаписей.Добавить();
		Иначе
			НоваяЗапись =  НаборЗаписей[0];
		КонецЕсли;
		НоваяЗапись.СсылкаIIKO = СтрутураЭлементаIIKO.УИД;
		НоваяЗапись.ТипОбъекта = ТипПВХ;
		НоваяЗапись.Ссылка1С = СправочникСсылка;
		
		НоваяЗапись.ИмяIIKO = СтрутураЭлементаIIKO.Наименование;
		НоваяЗапись.КодIIKO = СтрутураЭлементаIIKO.Код;
		
		Если СтрутураЭлементаIIKO.Свойство("Родитель") Тогда
			НоваяЗапись.РодительIIKO = СтрутураЭлементаIIKO.Родитель;
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	
	// возвращаем созданный элемент
	Возврат СправочникСсылка;
КонецФункции


// Заполняет переданный реквизит по одному из указанных алгоритмов заполнения
//
// Параметры:
//  Реквизит - Произвольный - Реквизит.
//  СтрутураЭлементаIIKO - Произвольный - Струтура элемента iiko.
//  ВидПоиска - Произвольный - Вид поиска.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьПолеПоСоответствию(Реквизит,СтрутураЭлементаIIKO,ВидПоиска)
	Если НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Реквизит)) Тогда
		Реквизит = СтрутураЭлементаIIKO.Значение;
		
		Возврат 0;
	Иначе
		ИмяМетаданных = Реквизит.Метаданные().Имя; 
		
		ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
		СтрокаНастроек = ПараметрыЗагрузки.Найти(ТипПВХ,"ТипОбъекта");
		Если СтрокаНастроек = Неопределено Тогда
			СтрокаНастроек = ТипПВХ;
		КонецЕсли;
		
		// Установим текущий режим обработки ошибок
		РежимОшибкиЗагрузки = СтрокаНастроек.ОбработкаОшибок;
		
		// По регистру соответствий
		Если ВидПоиска = 0 И НЕ ТипПВХ.Пустая() Тогда
			
			// По таблице соответствия найдем наименование и код
			Если ЗначениеЗаполнено(СтрутураЭлементаIIKO.УИД) Тогда
				СтрокиСоответствия = ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных, УИД", ИмяМетаданных, СтрутураЭлементаIIKO.УИД));
				Если СтрокиСоответствия.Количество() > 0 Тогда
					Если ИмяМетаданных = "КассыККМ" Тогда
						СтрутураЭлементаIIKO.Наименование = "ККМ №"+СтрокиСоответствия[0].Наименование;
					Иначе
						СтрутураЭлементаIIKO.Наименование = СтрокиСоответствия[0].Наименование;
					КонецЕсли;
					СтрутураЭлементаIIKO.Код = СтрокиСоответствия[0].Код;
				КонецЕсли;
			Иначе
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Для <"+ СтрутураЭлементаIIKO.Наименование + "> (тип объекта - <"+ТипПВХ.Наименование+">) не задано значение идентификатора";
				Сообщение.Сообщить();
				Возврат РежимОшибкиЗагрузки;
			КонецЕсли;
			
			Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO, ИмяМетаданных);
			Реквизит = СоздатьОбновитьОбъект(ИмяМетаданных,СтрутураЭлементаIIKO, СтрокаНастроек);
			
			// Если Нашли реквизит, добавм его в строку соответствия
			Если СтрокиСоответствия.Количество() > 0 И ЗначениеЗаполнено(Реквизит) Тогда
				СтрокиСоответствия[0].Ссылка1С = Реквизит;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Реквизит) И ЗначениеЗаполнено(СтрутураЭлементаIIKO.УИД) Тогда
				Если РежимОшибкиЗагрузки > 0 Тогда
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Реквизит " + Реквизит.Метаданные().Синоним + " не смог быть получен";
					Сообщение.Сообщить();
				КонецЕсли;
				Возврат РежимОшибкиЗагрузки;
			Иначе
				Возврат 0;
			КонецЕсли;
		// По наименованию
		ИначеЕсли ВидПоиска = 1 Тогда
			Реквизит = Справочники[ИмяМетаданных].НайтиПоНаименованию(СтрутураЭлементаIIKO.Наименование, Истина);
			Если Не ЗначениеЗаполнено(Реквизит) И ЗначениеЗаполнено(СтрутураЭлементаIIKO.Наименование) Тогда
				Если РежимОшибкиЗагрузки > 0 Тогда
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Реквизит " + Реквизит.Метаданные().Синоним + " не смог быть получен";
					Сообщение.Сообщить();
				КонецЕсли;
				Возврат РежимОшибкиЗагрузки;
			Иначе
				Возврат 0;
			КонецЕсли;
		// По коду
		ИначеЕсли ВидПоиска = 2 Тогда
			Реквизит = Справочники[ИмяМетаданных].НайтиПоКоду(СтрутураЭлементаIIKO.Код);
			Если Не ЗначениеЗаполнено(Реквизит) И ЗначениеЗаполнено(СтрутураЭлементаIIKO.Код) Тогда
				Если РежимОшибкиЗагрузки > 0 Тогда
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Реквизит " + Реквизит.Метаданные().Синоним + " не смог быть получен";
					Сообщение.Сообщить();
				КонецЕсли;
				Возврат РежимОшибкиЗагрузки;
			Иначе
				Возврат 0;
			КонецЕсли;
		// Непосредственное значение
		Иначе
			Реквизит = СтрутураЭлементаIIKO.Значение;
			
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Процедура - Получить незаполненные соответствия выборки.
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  СтруктураНезаполненныхСоответствий - Структура - Структура незаполненных соответствий.
//
Процедура ПолучитьНезаполненныеСоответствияВыборки(Выборка, СтруктураНезаполненныхСоответствий)
	СтрутураЭлементаIIKO = Новый Структура;
	СтрутураЭлементаIIKO.Вставить("УИД");
	
	// Кассы ККМ
	СтрутураЭлементаIIKO.УИД = Выборка.КассаУИД;
	Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"КассыККМ",ПланыВидовХарактеристик.питТипыОбъектовIIKO.КассыККМ);
	Если Не ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
		СтруктураНезаполненныхСоответствий.КассыККМ.Добавить(СтрутураЭлементаIIKO.УИД);
	КонецЕсли;
	
	// Получим все оплаты
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Номер смены", "НомерСмены");
	СписокКолонок.Добавить("Вид оплаты(код)", "ВидОплатыУИД",Истина);//ВидОплаты
	СписокКолонок.Добавить("Вид оплаты(наименование)", "ВидОплаты");//ВидОплаты
	СписокКолонок.Добавить("Сумма", "СуммаОплаты");//СуммаОплаты
	ТаблицаВидовОплат = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(КаталогЗагрузки+"\Прием кассовой выручки.csv", СписокКолонок);
	Если ТаблицаВидовОплат = Неопределено Тогда
		ТаблицаВидовОплат = Новый ТаблицаЗначений;
		Для Каждого ТекКолонка Из СписокКолонок Цикл
			ТаблицаВидовОплат.Колонки.Добавить(ТекКолонка.Представление);
		КонецЦикла;
	КонецЕсли;
	
	ДобавленныеОплаты = Новый Массив;
	
	ВыборкаНоменклатура = Выборка.Выбрать();
	Пока ВыборкаНоменклатура.Следующий() Цикл
		// бывает, что приходит пустой УИД номенклатуры
		Если Не ЗначениеЗаполнено(ВыборкаНоменклатура.НоменклатураУИД) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрутураЭлементаIIKO.УИД = ВыборкаНоменклатура.НоменклатураУИД;
		Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"Номенклатура",ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура);
		Если Не ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
			СтруктураНезаполненныхСоответствий.Номенклатура.Добавить(СтрутураЭлементаIIKO.УИД);
		КонецЕсли;
		
		// Место печати по чеку
		Если ВыборкаНоменклатура.МестоПечати <> "" Тогда 
			СтрутураЭлементаIIKO.УИД = ВыборкаНоменклатура.МестоПечатиУИД;
			Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"питМестаПечати",ПланыВидовХарактеристик.питТипыОбъектовIIKO.питМестаПечати);
			Если Не ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
				СтруктураНезаполненныхСоответствий.питМестаПечати.Добавить(СтрутураЭлементаIIKO.УИД);
			КонецЕсли;
		КонецЕсли;
		
		Если Выборка.ХозОперация <> "Продажа" Тогда
			// причина отмены
			СтрутураЭлементаIIKO.УИД = ВыборкаНоменклатура.ПричинаОтменСписанийУИД;
			Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"питПричиныОтменИСписаний",ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПричиныОтменИСписаний);
			Если Не ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
				СтруктураНезаполненныхСоответствий.питПричиныОтменИСписаний.Добавить(СтрутураЭлементаIIKO.УИД);
			КонецЕсли;
		КонецЕсли;
		
		// МОДИФИКАТОРЫ
		МодификаторыНоменклатуры = Модификаторы.НайтиСтроки(Новый Структура("МодификаторУИД, ЧекУИД",ВыборкаНоменклатура.НоменклатураУИД, ВыборкаНоменклатура.ЧекУИД));
		Для Каждого СтрокаМодификатора Из МодификаторыНоменклатуры Цикл
			// модификатор
			СтрутураЭлементаIIKO.УИД = СтрокаМодификатора.МодификаторУИД;
			Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"питМодификаторы",ПланыВидовХарактеристик.питТипыОбъектовIIKO.Модификаторы);
			Если Не ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
				СтруктураНезаполненныхСоответствий.питМодификаторы.Добавить(СтрутураЭлементаIIKO.УИД);
			КонецЕсли;
		КонецЦикла;
		
		Если Выборка.ХозОперация = "Продажа" Тогда
			// Для Типа оплаты определим Вид оплаты
			Если ДобавленныеОплаты.Найти(ВыборкаНоменклатура.НомерСмены)=Неопределено Тогда
				СтрокиОплат = ТаблицаВидовОплат.НайтиСтроки(Новый Структура("НомерСмены", ВыборкаНоменклатура.НомерСмены));
				Если СтрокиОплат.Количество()>0 Тогда
					Для Каждого СтрокаОплаты Из СтрокиОплат Цикл
						СтрутураЭлементаIIKO.УИД = СтрокаОплаты.ВидОплатыУИД;
						Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"питВидыОплатОрганизаций",ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыОплатОрганизаций);
						Если Не ЗначениеЗаполнено(СтрутураЭлементаIIKO.Ссылка1С) Тогда
							СтруктураНезаполненныхСоответствий.питВидыОплатОрганизаций.Добавить(СтрутураЭлементаIIKO.УИД);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				ДобавленныеОплаты.Добавить(ВыборкаНоменклатура.НомерСмены);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


// Происходит обход выборки из таблицы продаж IIKO и создание документов ДПФ
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  СтруктураНезаполненныхСоответствий - Структура - Структура незаполненных соответствий.
//
Процедура ОбходРезультатЗапросаПроверка(Выборка, СтруктураНезаполненныхСоответствий)
	Пока Выборка.Следующий() Цикл
		Если Выборка.Группировка() = "НомерСмены" Тогда
			ПолучитьНезаполненныеСоответствияВыборки(Выборка, СтруктураНезаполненныхСоответствий);
			#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
			#КонецЕсли
		Иначе
			ВложеннаяВыборка =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
			ОбходРезультатЗапросаПроверка(ВложеннаяВыборка, СтруктураНезаполненныхСоответствий);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Инициализация

РежимОшибкиЗагрузки = 0;

#КонецОбласти

#КонецЕсли
