// Установка реквизитов для объекта Причины отмены
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  Настройки - Произвольный - Настройки.
//
Процедура ПрочитатьОбъектПричиныОтменИСписаний(СправочникОбъект, СвойстваОбъекта, Настройки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СправочникОбъект.СтатьяДоходовИРасходов) Тогда
		СправочникОбъект.СтатьяДоходовИРасходов = ПланыВидовХарактеристик.СтатьиРасходов.РазницыСтоимостиВозвратаИФактическойСтоимостиТоваров;
	КонецЕсли;
	
	Если СвойстваОбъекта.Свойство("СоСписанием") Тогда
		СправочникОбъект.СоСписанием = СвойстваОбъекта.СоСписанием;
	КонецЕсли;
КонецПроцедуры

// ЗАПОЛНЕНИЕ СВЯЗАННЫХ ТАБЛИЦ

// Заполнение связанных таблиц для объекта Номенклатура
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//  СтрутураЭлементаIIKO - Произвольный - Струтура элемента iiko.
//  ТолькоЕдИзм - Произвольный - Только ед изм.
//  ОрганизацияЗагрузки - Произвольный - Организация загрузки.
//  СтруктураХЭХ - Структура - Структура хэх.
//
Процедура НоменклатураПослеЗаписи(Ссылка, СтрутураЭлементаIIKO, ТолькоЕдИзм = Ложь, ОрганизацияЗагрузки, СтруктураХЭХ = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Или Ссылка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СтруктураХЭХ = Неопределено Тогда 
		
		НаборЗаписей = РегистрыСведений.питХимикоэнергетическиеХарактеристики.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(Ссылка);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Номенклатура = Ссылка;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Белки;
		НоваяЗапись.КоличествоХарактеристики = СтруктураХЭХ.Белки;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Номенклатура = Ссылка;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Жиры;
		НоваяЗапись.КоличествоХарактеристики = СтруктураХЭХ.Жиры;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Номенклатура = Ссылка;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Углеводы;
		НоваяЗапись.КоличествоХарактеристики = СтруктураХЭХ.Углеводы;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Номенклатура = Ссылка;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Калорийность;
		НоваяЗапись.КоличествоХарактеристики = СтруктураХЭХ.Калорийность;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
		
	Если ТолькоЕдИзм Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры



// Формирует печатные формы
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать.
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//   (выходные.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документ.
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//   представление - имя области в которой был выведен объект.
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
		МодульУправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"РезультатРаботы", НСтр("ru = 'Чеки'"),
				ПечатьРезультатРаботы(ПараметрыПечати.МассивДокументов, ПараметрыПечати.ПрерываниеЗагрузки),
				,
				"Обработка.питЗагрузкаIIKO.РезультатРаботы");
	КонецЕсли;
	
КонецПроцедуры

// Функция - Печать результат работы.
//
// Параметры:
//  МассивДокументов - Массив - Массив документов.
//  ПрерываниеЗагрузки - Произвольный - Прерывание загрузки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПечатьРезультатРаботы(МассивДокументов, ПрерываниеЗагрузки = Ложь) Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ПолеСверху          = 0;
	ТабДок.ПолеСлева           = 0;
	ТабДок.ПолеСнизу           = 0;
	ТабДок.ПолеСправа          = 0;
	ТабДок.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьЗаголовки	= ЛОЖЬ;
	ТабДок.ОтображатьСетку     = ЛОЖЬ;
	ТабДок.Защита              = Истина;
	ТабДок.ТолькоПросмотр      = Истина;
	ТабДок.ПолеСлева           = 9;
	ТабДок.ПолеСправа          = 6;
	
	Макет = Обработки.питЗагрузкаIIKO.ПолучитьМакет("РезультатРаботы");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.ВидДокументов = "Чеки";
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаСозданныеДокументы");
	Для Каждого СозданныйДокумент Из МассивДокументов Цикл
		ОбластьМакета.Параметры.Документ = СозданныйДокумент;
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	Если ПрерываниеЗагрузки Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ОбластьМакета.Параметры.Комментарий = "Произошло прерывание загрузки";
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли;
	
	Возврат ТабДок;
КонецФункции


// МОДУЛЬ ЗАГРУЗКИ ИЗ ДПФ
//
// Параметры:
//  МассивКассыККМ - Массив - Массив кассы ккм.
//  МассивДокументов - Массив - Массив документов.
//  СтруктураПараметров - Структура - Структура параметров.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВыполнитьЗагрузкуИзДанныхПродаж(МассивКассыККМ,МассивДокументов,СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = Новый Структура;
	КонецЕсли;
	
	ТекстСообщения = "Загрузка из чеков...";
	ЗаписьЖурналаРегистрации("ЗагрузкаИзДанныхПродаж", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	// Инициализация обработки
	
	// Общие реквизиты
	ОбработкаЗагрузки = Обработки.питЗагрузкаИзДанныхПродажФронта.Создать();
	
	Если СтруктураПараметров.Свойство("ДатаНачала") Тогда
		ОбработкаЗагрузки.ДатаНачалаОтбора 			= СтруктураПараметров.ДатаНачала;
	Иначе
		ОбработкаЗагрузки.ДатаНачалаОтбора 			= '00010101';
	КонецЕсли;
	Если СтруктураПараметров.Свойство("ДатаКонца") Тогда
		ОбработкаЗагрузки.ДатаКонцаОтбора 			= КонецДня(СтруктураПараметров.ДатаКонца);
	Иначе
		ОбработкаЗагрузки.ДатаКонцаОтбора 			= КонецДня(ТекущаяДата());
	КонецЕсли;
	
	// Заполнение параметров касс по соответствующим реквизитам кассовых узлов
	ОбработкаЗагрузки.ЗагрузитьПараметрыКассККМ(МассивКассыККМ);
	
	// Создание целевых документов
	Если МассивДокументов <> Неопределено Тогда
		ОбработкаЗагрузки.СписокОбрабатываемыхДокументов = Новый СписокЗначений;
		ОбработкаЗагрузки.СписокОбрабатываемыхДокументов.ЗагрузитьЗначения(МассивДокументов);
	КонецЕсли;		
	СтруктураОбработанныхДокументов = ОбработкаЗагрузки.ВыполнитьЗагрузкуДанных();
	
	ТекстСообщения = "Завершена загрузка из чеков.";
	ЗаписьЖурналаРегистрации("ЗагрузкаИзДанныхПродаж", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	Возврат СтруктураОбработанныхДокументов;
	

	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Из строки в массив.
//
// Параметры:
//  Стрр - Произвольный - Стрр.
//
// Возвращаемое значение:
//  Массив - Результат обработки.
Функция ИзСтрокиВМассив(Стрр)
	
	Списс = Новый Массив; 
	Стрр2 = СтрЗаменить(Стрр,";",Символы.ПС);
	
	Для ии = 1  по СтрЧислоСтрок(Стрр2) цикл
		Списс.Добавить(СтрПолучитьСтроку(Стрр2,ии));
	КонецЦикла;
	
	Возврат Списс;
	
КонецФункции

// Функция - Получить ставку ндс по представлению.
//
// Параметры:
//  ПредставлениеСтавкиНДС - Произвольный - Представление ставки ндс.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьСтавкуНДСПоПредставлению(ПредставлениеСтавкиНДС)
	
	ЗначениеНДС = Неопределено;
	Если СтрНайти(ВРЕГ(ПредставлениеСтавкиНДС), "БЕЗ НДС") > 0 Тогда
		ЗначениеНДС = питОбщегоНазначения.СтавкаНДСПоЧислу();
	ИначеЕсли ПредставлениеСтавкиНДС = "0" ИЛИ ПредставлениеСтавкиНДС = "0%" Тогда
		ЗначениеНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(0);
	ИначеЕсли СтрНайти(ПредставлениеСтавкиНДС, "10") > 0 Тогда
		ЗначениеНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(10);
	ИначеЕсли СтрНайти(ПредставлениеСтавкиНДС, "20") > 0 Тогда
		ЗначениеНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(20);
	ИначеЕсли СтрНайти(ПредставлениеСтавкиНДС, "18") > 0 Тогда
		ЗначениеНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(18);
	ИначеЕсли СтрНайти(ПредставлениеСтавкиНДС, "22") > 0 Тогда
		ЗначениеНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(22);
	Иначе
		Попытка
			СтавкаЧислом = Число(ПредставлениеСтавкиНДС);
			ЗначениеНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(СтавкаЧислом);
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат ЗначениеНДС;
	
КонецФункции

// Установка реквизитов для объекта ВидНоменклатуры
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  Настройки - Произвольный - Настройки.
//
Процедура ПрочитатьОбъектМестоПечати(СправочникОбъект,СвойстваОбъекта, Настройки);
	
	СправочникОбъект.СпособПечати = Перечисления.питСпособыПечатиЗаказа.Параллельно;
	Если СвойстваОбъекта.Свойство("СкладДляЗагрузки") тогда 
		СправочникОбъект.СкладПриготовления = СвойстваОбъекта.СкладДляЗагрузки;
	КонецЕсли;

КонецПроцедуры
	
// Установка реквизитов для объекта ВидНоменклатуры
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  Настройки - Произвольный - Настройки.
//
Процедура ПрочитатьОбъектВидНоменклатуры(СправочникОбъект,СвойстваОбъекта, Настройки);

	СправочникОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	СправочникОбъект.ГруппаДоступа = Справочники.ГруппыДоступаНоменклатуры.НайтиПоНаименованию("Прочее");
	СправочникОбъект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	СправочникОбъект.ТоварныеКатегорииОбщиеСДругимВидомНоменклатуры = Ложь;
	
	Если СвойстваОбъекта.Свойство("ТипНоменклатуры") Тогда
		СправочникОбъект.ТипНоменклатуры = СвойстваОбъекта.ТипНоменклатуры;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - После записи вида номенклатуры.
//
// Параметры:
//  ВидНоменклатуры - Произвольный - Вид номенклатуры.
//
Процедура ПослеЗаписиВидаНоменклатуры(ВидНоменклатуры)
	НоваяЗаписьВРегистр = РегистрыСведений.питВидыНоменклатурыОбщепит.СоздатьМенеджерЗаписи();
	НоваяЗаписьВРегистр.ВидНоменклатуры = ВидНоменклатуры;
	НоваяЗаписьВРегистр.ВидимостьКоманд = Истина;
	НоваяЗаписьВРегистр.Записать(Истина);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
