#Область ПрограммныйИнтерфейс

// Функция - Получить тип номенклатуры iiko.
//
// Параметры:
//  СсылкаIIKO - Произвольный - Ссылка iiko.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьТипНоменклатурыIIKO(СсылкаIIKO) Экспорт
	
	Если СсылкаIIKO = "товар" Или СсылкаIIKO = "GOODS" Или СсылкаIIKO = "OUTER" Или СсылкаIIKO = "PETROL" Тогда
		Результат = Новый Структура("Name,Code","Товар","товар")
	ИначеЕсли СсылкаIIKO = "блюдо" Или СсылкаIIKO = "DISH" Тогда 
		Результат = Новый Структура("Name,Code","Блюдо","блюдо")
	ИначеЕсли СсылкаIIKO = "заготовка" Или СсылкаIIKO = "PREPARED" Тогда 
		Результат = Новый Структура("Name,Code","Заготовка","заготовка")
	ИначеЕсли СсылкаIIKO = "услуга" Или СсылкаIIKO = "сервис" Или СсылкаIIKO = "SERVICE" Или СсылкаIIKO = "RATE" Тогда
		Результат = Новый Структура("Name,Code","Услуга","услуга")
	ИначеЕсли СсылкаIIKO = "модификатор" Или СсылкаIIKO = "MODIFIER" Тогда 
		Результат = Новый Структура("Name,Code","Модификатор","модификатор")
	Иначе
		Результат = Новый Структура("Name,Code");
	КонецЕсли;
	
	Результат.Вставить("ИмяIIKO",Результат.Name);
	Результат.Вставить("КодIIKO",Результат.Code);
	Возврат Результат
	
КонецФункции

// Функция - Получить таблицу.
//
// Параметры:
//  ПутьКТаблице - Произвольный - Путь к таблице.
//  СписокКолонок - СписокЗначений - Список колонок.
//  Кодировка - Строка - Кодировка.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицу(ПутьКТаблице, СписокКолонок, Знач Кодировка=Неопределено) Экспорт
	
	Файл = Новый Файл(ПутьКТаблице);
	Если НЕ Файл.Существует() Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "В каталоге отсутствует файл "+ПутьКТаблице+"";
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ТаблицаВыгрузки = Новый ТаблицаЗначений;
		Если Кодировка = "UTF8" Тогда
			Кодировка = КодировкаТекста.UTF8;
		КонецЕсли;
		Текст = Новый ЧтениеТекста(ПутьКТаблице, Кодировка);
		Стр1 = Текст.ПрочитатьСтроку();//Первая строка - имена колонок
		СписокКолонокИзФайла = ИзСтрокиВМассив(Стр1);
		НеобходимыеКолонки = Новый Массив;
		КолонкиУИД = Новый Массив;
		ТипСтрокаУИД = ОбщегоНазначения.ОписаниеТипаСтрока(38);
		Для ии = 0 По СписокКолонок.Количество()-1 Цикл
			индекс = СписокКолонокИзФайла.Найти(СписокКолонок[ии].Значение);
			Если индекс <> Неопределено Тогда
				НеобходимыеКолонки.Добавить(Индекс);
				Если СписокКолонок[ии].Пометка тогда  //Пометка означает что колонка сожержит УИД
					ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии],ТипСтрокаУИД);
					КолонкиУИД.Добавить(Индекс);
				ИначеЕсли СтрНайти(СписокКолонок[ии],"NAME") ИЛИ СтрНайти(СписокКолонок[ии],"TYPE") Тогда
						ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии],ОбщегоНазначения.ОписаниеТипаСтрока(200));
				ИначеЕсли СтрНайти(СписокКолонок[ии], "ENERGY") Тогда
					ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии],Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(10, 3)));
				ИначеЕсли СтрНайти(СписокКолонок[ии], "FIBER") Тогда
					ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии],Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(10, 3)));
				ИначеЕсли СтрНайти(СписокКолонок[ии], "FAT") Тогда
					ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии],Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(10, 3)));
				ИначеЕсли СтрНайти(СписокКолонок[ии], "CARBOHYDRATE") Тогда
					ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии],Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(10, 3)));
				ИначеЕсли СтрНайти(СписокКолонок[ии], "MEASURE") Тогда
					ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии],ОбщегоНазначения.ОписаниеТипаСтрока(200));
				Иначе
					ТаблицаВыгрузки.Колонки.Добавить(СписокКолонок[ии]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Стр = Текст.ПрочитатьСтроку();
		Пока Стр <> Неопределено Цикл
			МассивСтроки = ИзСтрокиВМассив(Стр);
			СтрТЗ = ТаблицаВыгрузки.Добавить();
			Для кк = 0 По НеобходимыеКолонки.Количество()-1 Цикл
				Попытка 
					Если КолонкиУИД.Найти(НеобходимыеКолонки[кк]) <> Неопределено Тогда 
						ЗначениеИзФайла = СокрЛП(СтрЗаменить(МассивСтроки[НеобходимыеКолонки[кк]],Символы.НПП,""));
					Иначе
						ЗначениеИзФайла = Число(СтрЗаменить(МассивСтроки[НеобходимыеКолонки[кк]], ",", "."));
					КонецЕсли;
				Исключение
					ЗначениеИзФайла = МассивСтроки[НеобходимыеКолонки[кк]];
				КонецПопытки;
				СтрТЗ.Установить(кк, ЗначениеИзФайла);
			КонецЦикла;
			Стр = Текст.ПрочитатьСтроку();
		КонецЦикла;
	Исключение
		Отказ = Истина;
		ТаблицаВыгрузки = Неопределено;
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "При выполнении функции <Обработка.ЗагрузкаIIKO.ПолучитьТаблицу> возникла ошибка. " + ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		
		Событие = "ЗагрузкаIIKO";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При чтении файла <" + ПутьКТаблице +"> возникла ошибка.");
	КонецПопытки;
		
		Возврат ТаблицаВыгрузки;
		
КонецФункции


// Заполнение параметров загрузки для каждого типа объекта из ПВХ <Типы объектов IIKO>
//
// Параметры:
//  ПараметрыЗагрузки - Произвольный - Параметры загрузки.
//
Процедура ИнициализацияПараметровЗагрузки(ПараметрыЗагрузки) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТипыОбъектовIIKO.Ссылка КАК ТипОбъекта,
	                      |	ТипыОбъектовIIKO.Создавать КАК Создавать,
	                      |	ТипыОбъектовIIKO.Обновлять КАК Обновлять,
	                      |	ТипыОбъектовIIKO.СлужебныйКаталог,
	                      |	ТипыОбъектовIIKO.ОбработкаОшибок
	                      |ИЗ
	                      |	ПланВидовХарактеристик.питТипыОбъектовIIKO КАК ТипыОбъектовIIKO
	                      |ГДЕ
	                      |	ТипыОбъектовIIKO.Предопределенный
	                      |	И НЕ ТипыОбъектовIIKO.Ссылка В (&ЗапрещенныеТипы)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТипыОбъектовIIKO.Код");
	ЗапрещенныеТипы = Новый СписокЗначений;
	ЗапрещенныеТипы.Добавить(ПланыВидовХарактеристик.питТипыОбъектовIIKO.ТипыОплат);
	ЗапрещенныеТипы.Добавить(ПланыВидовХарактеристик.питТипыОбъектовIIKO.КассыККМ);
	ЗапрещенныеТипы.Добавить(ПланыВидовХарактеристик.питТипыОбъектовIIKO.Чек);
	ЗапрещенныеТипы.Добавить(ПланыВидовХарактеристик.питТипыОбъектовIIKO.Рецептуры);
	
	Запрос.УстановитьПараметр("ЗапрещенныеТипы",ЗапрещенныеТипы);
	ПараметрыЗагрузки.Загрузить(Запрос.Выполнить().Выгрузить());
	
	
	
КонецПроцедуры

// Процедура - Заполнить ссылку 1 с по соответствию.
//
// Параметры:
//  СтрутураЭлементаIIKO - Произвольный - Струтура элемента iiko.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  ТипПВХ - Произвольный - Тип пвх.
//
Процедура ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO, ИмяМетаданных, ТипПВХ = Неопределено) Экспорт
	
	Если ТипПВХ = Неопределено Тогда 
		ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
	КонецЕсли;
	
	// Найдем или создадим ссылку в 1с по соответствию
	УИД = СокрЛП(СтрЗаменить(Строка(СтрутураЭлементаIIKO.УИД),Символы.НПП,""));
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовIIKO.Ссылка1С
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовIIKO КАК СоответствияОбъектовIIKO
	               |ГДЕ
	               |	СоответствияОбъектовIIKO.ТипОбъекта = &ТипОбъекта
	               |	И СоответствияОбъектовIIKO.СсылкаIIKO = &СсылкаIIKO";
	Запрос.УстановитьПараметр("ТипОбъекта",ТипПВХ);
	Запрос.УстановитьПараметр("СсылкаIIKO",УИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка1С) Тогда
		СтрутураЭлементаIIKO.Вставить("Ссылка1С",Выборка.Ссылка1С);
	Иначе
		Попытка
			Если ИмяМетаданных = "питРецептура" Тогда
				СтрутураЭлементаIIKO.Вставить("Ссылка1С",Документы[ИмяМетаданных].ПустаяСсылка());
			Иначе
				СтрутураЭлементаIIKO.Вставить("Ссылка1С",Справочники[ИмяМетаданных].ПустаяСсылка());
			КонецЕсли;
		Исключение
			СтрутураЭлементаIIKO.Вставить("Ссылка1С",Перечисления[ИмяМетаданных].ПустаяСсылка());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// ПОЛУЧЕНИЕ ТАБЛИЦ БД
//  Функция возвращает таблицу номенклатуры
//
// Параметры:
//  Колонки - Произвольный - Колонки.
//  Откуда - Произвольный - Откуда.
//  КаталогЗагрузки - Произвольный - Каталог загрузки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуНоменклатуры(Колонки,Откуда = "Вся",КаталогЗагрузки) Экспорт
	
	ОбщаяТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("SIFR");
	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("CODE");
	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("NAME");
	ОбщаяТаблицаНоменклатуры.Колонки.Добавить("TYPE");
	
	СписокКолонок = Новый СписокЗначений;
	СписокКолонок.Добавить("Номенклатура (код)", "SIFR",Истина);
	СписокКолонок.Добавить("Номенклатура (код)", "CODE", Истина);
	СписокКолонок.Добавить("Номенклатура (наименование)", "NAME");
	СписокКолонок.Добавить("Тип номенклатуры (название)", "TYPE");
	СписокКолонок.Добавить("Проданное блюдо (код)", "SIFRMOD", Истина);
	СписокКолонок.Добавить("Проданное блюдо (код)", "CODEMOD", Истина);
	СписокКолонок.Добавить("Проданное блюдо (название)", "NAMEMOD");
	
	МассивФайлов = Новый Массив;
	Если Откуда = "Вся" Тогда 
		МассивФайлов.Добавить("\Расходная накладная.csv");
		МассивФайлов.Добавить("\Приходная накладная.csv");
		МассивФайлов.Добавить("\Акт списания.csv");
		МассивФайлов.Добавить("\Акт реализации.csv");
	ИначеЕсли Откуда = "РН" Тогда 
		МассивФайлов.Добавить("\Расходная накладная.csv");
	ИначеЕсли Откуда = "ПН" Тогда 
		МассивФайлов.Добавить("\Приходная накладная.csv");
	ИначеЕсли Откуда = "АС" Тогда 
		МассивФайлов.Добавить("\Акт списания.csv");
	ИначеЕсли Откуда = "АР" Тогда 
		МассивФайлов.Добавить("\Акт реализации.csv");
	КонецЕсли;
	Для каждого ИмяФайла из МассивФайлов Цикл
		Таблица = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(КаталогЗагрузки+ИмяФайла, СписокКолонок);
		Если Таблица<>Неопределено Тогда
			ЕстьКолонкаБлюд = НЕ (Таблица.Колонки.Найти("NAMEMOD") = Неопределено);
			Для Каждого СтрТ Из Таблица Цикл
				Если НРЕГ(СтрТ.TYPE) = "модификатор" Тогда
					Если ЕстьКолонкаБлюд Тогда
						Если ЗначениеЗаполнено(СтрТ.NAMEMOD) Тогда
							СтрТ.CODE = СтрТ.CODEMOD;
							СтрТ.SIFR = СтрТ.SIFRMOD;
							СтрТ.NAME = СтрТ.NAMEMOD;
						КонецЕсли;
					Иначе
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				НовСтрТ = ОбщаяТаблицаНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрТ, СтрТ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если Откуда = "Вся" Тогда
		// Пробуем получить из goods.csv
		СписокКолонок = Новый СписокЗначений;
		СписокКолонок.Добавить("NUM", "SIFR", Истина);
		СписокКолонок.Добавить("NUM", "CODE", Истина);
		СписокКолонок.Добавить("NAME", "NAME");
		СписокКолонок.Добавить("TYPE", "TYPE");
		Таблица = Обработки.питЗагрузкаIIKO.ПолучитьТаблицу(КаталогЗагрузки+"\goods.csv", СписокКолонок, "UTF8");
		Если Таблица<>Неопределено Тогда
			ЕстьКолонкаМодификаторов = НЕ (Таблица.Колонки.Найти("NAMEMOD") = Неопределено);
			Для Каждого СтрТ Из Таблица Цикл
				Если НРЕГ(СтрТ.TYPE) = "MODIFIER" Тогда
					Если ЕстьКолонкаМодификаторов Тогда
						Если ЗначениеЗаполнено(СтрТ.NAMEMOD) Тогда
							СтрТ.CODE = СтрТ.CODEMOD;
							СтрТ.SIFR = СтрТ.SIFRMOD;
							СтрТ.NAME = СтрТ.NAMEMOD;
						КонецЕсли;
					Иначе
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				НовСтрТ = ОбщаяТаблицаНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрТ, СтрТ);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Таблица = Неопределено;
	
	Если ОбщаяТаблицаНоменклатуры = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ОбщаяТаблицаНоменклатуры.Свернуть(Колонки);
	
	Возврат ОбщаяТаблицаНоменклатуры;
	
КонецФункции

// Функция - Найти по наименованию коду и создать.
//
// Параметры:
//  ИмяМенеджера - Произвольный - Имя менеджера.
//  Код - Строка - Код.
//  Наименование - Строка - Наименование.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиПоНаименованиюКодуИСоздать(ИмяМенеджера, Код = "", Наименование = "") Экспорт
	
	Ссылка = Справочники[ИмяМенеджера].ПустаяСсылка();
	Если ЗначениеЗаполнено(Наименование) Тогда
		Ссылка = Справочники[ИмяМенеджера].НайтиПоНаименованию(Наименование, Истина);
	КонецЕсли;
	Если Ссылка = Справочники[ИмяМенеджера].ПустаяСсылка() И ЗначениеЗаполнено(Код) Тогда
		Ссылка = Справочники[ИмяМенеджера].НайтиПоКоду(Код);
		Если Ссылка = Справочники[ИмяМенеджера].ПустаяСсылка() Тогда 
			Ссылка = Справочники[ИмяМенеджера].НайтиПоКоду(Число(Код));
		КонецЕсли;
	КонецЕсли;
	
	Если Ссылка = Справочники[ИмяМенеджера].ПустаяСсылка() Тогда
		СправочникОбъект = Справочники[ИмяМенеджера].СоздатьЭлемент();
		СправочникОбъект.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
		СправочникОбъект.Наименование = Наименование;
		Если ЗначениеЗаполнено(Код) Тогда
			СправочникОбъект.Код = Код;
		Иначе
			СправочникОбъект.УстановитьНовыйКод("ii");
		КонецЕсли;
		СправочникОбъект.ОбменДанными.Загрузка = Истина;
		СправочникОбъект.Записать();
		Ссылка = СправочникОбъект.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

// Функция - Создать объект соответствия.
//
// Параметры:
//  Соответствие - Соответствие - Соответствие.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  ОрганизацияЗагрузки - Произвольный - Организация загрузки.
//  СкладДляЗагрузки - Произвольный - Склад для загрузки.
//  ТаблицаИзФайла - ТаблицаЗначений - Таблица из файла.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  ЗагружатьХЭХ - Произвольный - Загружать хэх.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьОбъектСоответствия(Соответствие, ИмяМетаданных, ОрганизацияЗагрузки, СкладДляЗагрузки, ТаблицаИзФайла = Неопределено,СвойстваОбъекта = Неопределено, ЗагружатьХЭХ = Ложь) Экспорт
	
	// Для касс ККМ не создаем.
	// Если ИмяМетаданных = "КассыККМ" Тогда
	// 	Возврат Справочники.КассыККМ.ПустаяСсылка();
	// КонецЕсли;
	//
	Если ЗначениеЗаполнено(Соответствие.Ссылка1С) тогда
		СправочникСсылка = Соответствие.Ссылка1С;
	Иначе
		СправочникСсылка = Справочники[ИмяМетаданных].НайтиПоНаименованию(Соответствие.ИмяIIKO);
	КонецЕсли;
	Если НЕ СправочникСсылка.Пустая() И СправочникСсылка.ПометкаУдаления Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	"+ИмяМетаданных+".Наименование КАК Наименование
		|ИЗ
		|	Справочник."+ИмяМетаданных+" КАК "+ИмяМетаданных+"
		|ГДЕ
		|	"+ИмяМетаданных+".ПометкаУдаления = ИСТИНА
		|	И "+ИмяМетаданных+".Наименование ПОДОБНО &Наименование";
		ШаблонИмени = СправочникСсылка.Наименование + " (удаленный%)";
		Запрос.УстановитьПараметр("Наименование", ШаблонИмени);
		Выборка = Запрос.Выполнить().Выбрать();
		НомерУдаленногоОбъекта = Выборка.Количество() + 1; 
		СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
		СправочникОбъект.Наименование = СправочникОбъект.Наименование + " (удаленный "+НомерУдаленногоОбъекта+")";
		Попытка
			СправочникОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Создан = Ложь;
	
	Если СправочникСсылка.Пустая() ИЛИ (НЕ СправочникСсылка.Пустая() И СправочникСсылка.ПометкаУдаления ) Тогда
		// Если объект был не найден или был найден, но с пометкой на удаления, то создаем новый объект.
		СправочникОбъект = Справочники[ИмяМетаданных].СоздатьЭлемент();
		Создан = Истина;
	Иначе
		СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	СправочникОбъект.Наименование = Соответствие.ИмяIIKO;
	
	Если Создан И ЗначениеЗаполнено(Соответствие.КодIIKO) Тогда
		СуществующийОбъект = Справочники[ИмяМетаданных].НайтиПоКоду(Строка(Соответствие.КодIIKO));
		Если Не ЗначениеЗаполнено(СуществующийОбъект) Тогда
			Попытка
				СправочникОбъект.Код = Соответствие.КодIIKO;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(СправочникОбъект.Код) Тогда
		СправочникОбъект.УстановитьНовыйКод("ii");
	КонецЕсли;
	
	
	Настройки = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
	Если Метаданные.Справочники[ИмяМетаданных].Иерархический Тогда
		Если ЗначениеЗаполнено(Настройки.СлужебныйКаталог) Тогда
			СправочникОбъект.Родитель = Настройки.СлужебныйКаталог;
		КонецЕсли;
	КонецЕсли;
	Если СвойстваОбъекта = Неопределено Тогда
		СвойстваОбъекта = Новый Структура;
	КонецЕсли;
	СвойстваОбъекта.Вставить("Организация", ОрганизацияЗагрузки);
	
	Если ИмяМетаданных = "КассыККМ" Тогда
		ПодразделениеПравПользователя = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации");
		Если ПодразделениеПравПользователя<>Неопределено Тогда
			СвойстваОбъекта.Вставить("Подразделение", ПодразделениеПравПользователя);
		КонецЕсли;
		СвойстваОбъекта.Вставить("Склад", СкладДляЗагрузки);
		ПрочитатьОбъектКассыККМ(СправочникОбъект, СвойстваОбъекта);
		
	ИначеЕсли ИмяМетаданных = "питВидыОплатОрганизаций" Тогда
		СтрокаОплаты = ТаблицаИзФайла.Найти(Число(Соответствие.СсылкаIIKO),"SIFR");
		Если СтрокаОплаты = Неопределено Тогда
			ТипОплаты = Перечисления.питТипыОплат.ПлатежнаяКарта;
		ИначеЕсли Найти(НРЕГ(СтрокаОплаты.NAME),"наличные") >0  Тогда
			ТипОплаты = Перечисления.питТипыОплат.Наличные;
		ИначеЕсли Найти(НРЕГ(СтрокаОплаты.NAME),"подарочный сертификат") >0  Тогда
			ТипОплаты = Перечисления.питТипыОплат.ПодарочныйСертификатСобственный;
		ИначеЕсли Найти(НРЕГ(СтрокаОплаты.NAME),"кредит") >0  Тогда
			ТипОплаты = Перечисления.питТипыОплат.БанковскийКредит;
		Иначе
			ТипОплаты = Перечисления.питТипыОплат.ПлатежнаяКарта;
		КонецЕсли;
		СвойстваОбъекта.Вставить("ТипОплаты",ТипОплаты);
		ПрочитатьОбъектВидыОплат(СправочникОбъект, СвойстваОбъекта);
		
	ИначеЕсли ИмяМетаданных = "Номенклатура" Тогда
		
		// СвойстваОбъекта.Вставить("Услуга", Найти(НРЕГ(СправочникОбъект.Наименование), "услуга")>0);
		
		СтрокаНоменклатуры = ТаблицаИзФайла.Найти(Соответствие.СсылкаIIKO,"CODE");
		
		// Если Код в файлах отличается от указанного в соответствиях, то пробуем найти по имени.
		Если СтрокаНоменклатуры = Неопределено Тогда
			СтрокаНоменклатуры = ТаблицаИзФайла.Найти(Соответствие.ИмяIIKO,"NAME");
		КонецЕсли;
		
		// Если регистр сведений содержит товар который не используется в текущей загрузке, пропустим
		Если СтрокаНоменклатуры = Неопределено Тогда
			Возврат Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
		
		// Определим питВидНоменклатуры
		TYPE = НРег(СтрокаНоменклатуры.TYPE);
		Если Найти(TYPE,"товар")>0 Тогда
			питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар;
		ИначеЕсли Найти(TYPE,"заготовка")>0 Тогда
			питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо;
		ИначеЕсли Найти(TYPE,"модификатор")>0 Тогда
			питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар;
		ИначеЕсли Найти(TYPE,"сервис")>0 ИЛИ Найти(TYPE,"услуга")>0 Тогда
			питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Услуга;
		ИначеЕсли Найти(TYPE,"блюдо")>0 Тогда
			питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо;
		ИначеЕсли Найти(TYPE,"набор")>0 Тогда
			питВидНоменклатуры = Перечисления.питВидыНоменклатуры.БизнесЛанч;
		Иначе
			питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар;
		КонецЕсли;
		СвойстваОбъекта.Вставить("питВидНоменклатуры", питВидНоменклатуры);
		
		// Определим ВидНоменклатуры по TYPE
		Если Не СвойстваОбъекта.Свойство("ВидНоменклатуры") Тогда 
			СтрутураЭлементаIIKO = Новый Структура;
			СтрутураЭлементаIIKO.Вставить("УИД",СтрокаНоменклатуры.TYPE);
			ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"ВидыНоменклатуры",ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры);
			СвойстваОбъекта.Вставить("ВидНоменклатуры",СтрутураЭлементаIIKO.Ссылка1С);
		КонецЕсли;
		
		// ЕдиницаИзмерения
		СвойстваОбъекта.Вставить("ЕдиницаИзмерения", НайтиПоНаименованиюКодуИСоздать("УпаковкиЕдиницыИзмерения","",СтрокаНоменклатуры.EDIZM));
		
		// СтавкаНДС
		Если ЗначениеЗаполнено(СтрокаНоменклатуры.NDS) Тогда
			Попытка
				СвойстваОбъекта.Вставить("СтавкаНДС", ПолучитьСтавкуНДСПоПредставлению(Строка(СтрокаНоменклатуры.NDS)));
			Исключение
			КонецПопытки;
		Иначе
			СвойстваОбъекта.Вставить("СтавкаНДС", питОбщегоНазначения.СтавкаНДСПоЧислу());
		КонецЕсли;
		
		Если ЗагружатьХЭХ 
			И (СтрокаНоменклатуры.FIBER > 0 
			Или СтрокаНоменклатуры.FAT > 0 
			Или СтрокаНоменклатуры.CARBOHYDRATE > 0 
			Или СтрокаНоменклатуры.ENERGY > 0) Тогда 
			
			СтруктураХЭХ = Новый Структура;
			СтруктураХЭХ.Вставить("Белки",СтрокаНоменклатуры.FIBER);
			СтруктураХЭХ.Вставить("Жиры",СтрокаНоменклатуры.FAT);
			СтруктураХЭХ.Вставить("Углеводы",СтрокаНоменклатуры.CARBOHYDRATE);
			СтруктураХЭХ.Вставить("Калорийность",СтрокаНоменклатуры.ENERGY);
		Иначе
			СтруктураХЭХ = Неопределено
		КонецЕсли;
		
		ПрочитатьОбъектНоменклатура(СправочникОбъект, СвойстваОбъекта);
		
	ИначеЕсли ИмяМетаданных = "питМодификаторы" Тогда
//   СвойстваОбъекта.Вставить("ВидНоменклатуры", Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Модификатор",
// Истина));.
		ПрочитатьОбъектМодификаторы(СправочникОбъект,СвойстваОбъекта, ОрганизацияЗагрузки);
		
	ИначеЕсли ИмяМетаданных = "питПричиныОтменИСписаний" Тогда
		СвойстваОбъекта.Вставить("Наименование", Соответствие.ИмяIIKO);
		Если Найти(НРЕГ(Соответствие.ИмяIIKO),"со списанием")>0 Тогда
			СправочникОбъект.СоСписанием = Истина;
		КонецЕсли;
		ПрочитатьОбъектПричиныОтменИСписаний(СправочникОбъект, СвойстваОбъекта, Настройки);
		
	ИначеЕсли ИмяМетаданных = "ВидыНоменклатуры" Тогда
		
		TYPE = НРег(Соответствие.КодIIKO);
		Если Найти(TYPE,"товар")>0 
			ИЛИ Найти(TYPE,"заготовка")>0 
			ИЛИ Найти(TYPE,"модификатор")>0 
			ИЛИ Найти(TYPE,"блюдо")>0 Тогда
			ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
		ИначеЕсли Найти(TYPE,"сервис")>0 ИЛИ Найти(TYPE,"услуга")>0 Тогда
			ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
		ИначеЕсли Найти(TYPE,"набор")>0 Тогда
			ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор;
		Иначе
			ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
		КонецЕсли;
		СвойстваОбъекта.Вставить("ТипНоменклатуры", ТипНоменклатуры);
		
		ПрочитатьОбъектВидНоменклатуры(СправочникОбъект,СвойстваОбъекта, Настройки);
		
	ИначеЕсли ИмяМетаданных = "питМестаПечати" Тогда
		
		СвойстваОбъекта.Вставить("СкладДляЗагрузки",СкладДляЗагрузки);
		ПрочитатьОбъектМестоПечати(СправочникОбъект,СвойстваОбъекта, Настройки);
		
	КонецЕсли;
	
	Попытка
		СправочникОбъект.Записать();
		Если ИмяМетаданных = "Номенклатура" Тогда
			НоменклатураПослеЗаписи(СправочникОбъект.Ссылка, Новый Структура(), Истина, ОрганизацияЗагрузки, СтруктураХЭХ); //После записи можно создать ЕИ
		КонецЕсли;
		
		Если ИмяМетаданных = "ВидыНоменклатуры" Тогда
			ПослеЗаписиВидаНоменклатуры(СправочникОбъект.Ссылка);
		КонецЕсли;
		
		Если Создан Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан элемент <"+СправочникОбъект.Наименование+">");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Найден элемент <"+СправочникОбъект.Наименование+">");
		КонецЕслИ;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат СправочникОбъект.Ссылка;
КонецФункции

// Установка общих реквизитов для всех объектов
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  Настройки - Произвольный - Настройки.
//
Процедура УстановитьОбщиеРеквизиты(Объект, СвойстваОбъекта, Настройки) Экспорт
	
	// Определение - группа или элемент
	Если Объект.ЭтоНовый() И ЗначениеЗаполнено(Настройки.СлужебныйКаталог) Тогда
		Объект.Родитель = Настройки.СлужебныйКаталог;
	КонецЕсли;
	
	Если СвойстваОбъекта.Свойство("ЭтоГруппа") Тогда
		Объект.ЭтоГруппа = СвойстваОбъекта.ЭтоГруппа;
	КонецЕсли;
	
	// Код
	Если Объект.ЭтоНовый() И СвойстваОбъекта.Свойство("Код") И ЗначениеЗаполнено(СвойстваОбъекта.Код) Тогда
		СуществующийОбъект = Справочники[Объект.Метаданные().Имя].НайтиПоКоду(СвойстваОбъекта.Код);
		Если Не ЗначениеЗаполнено(СуществующийОбъект) Тогда
			Код = Неопределено;
			СвойстваОбъекта.Свойство("Код", Код);
			Попытка
				Объект.Код = СокрЛП(Код);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// Наименование
	Наименование = Неопределено;
	СвойстваОбъекта.Свойство("Наименование", Наименование);
	Объект.Наименование = СокрЛП(Наименование);
	
	// ПометкаУдаления
	ПометкаУдаления = Неопределено;
	СвойстваОбъекта.Свойство("Активный", ПометкаУдаления);
	Если ПометкаУдаления <> Неопределено Тогда
		Объект.ПометкаУдаления = ПометкаУдаления;
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Код) Тогда
		Объект.УстановитьНовыйКод("ii");
	КонецЕсли;
	//
	// Попытаемся получить и установить какие то обязательные реквизиты
	Попытка
		ОбязательныеРеквизиты = Объект.ПолучитьОбязательныеРеквизиты();
	Исключение
		ОбязательныеРеквизиты = Новый Структура;
	КонецПопытки;
	Для Каждого СтрокаСтруктуры Из ОбязательныеРеквизиты Цикл
		Если ТипЗнч(СтрокаСтруктуры.Ключ) = Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если СвойстваОбъекта.Свойство(СтрокаСтруктуры.Ключ) И (СтрокаСтруктуры.Значение = 1 Или СтрокаСтруктуры.Значение = 3) И НЕ ЗначениеЗаполнено(Объект[СтрокаСтруктуры.Ключ]) Тогда
			Объект[СтрокаСтруктуры.Ключ] = СвойстваОбъекта[СтрокаСтруктуры.Ключ];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Установка реквизитов для объекта Номенклатура
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектНоменклатура(Объект, СвойстваОбъекта) Экспорт
	
	Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	
	// Установка ссылки, кода, наименования справочника
	МенеджерОбъекта = Справочники.Номенклатура;
	
	// Только для элементов
	Если НЕ Объект.ЭтоГруппа Тогда
		
		Наименование = Неопределено;
		Если СвойстваОбъекта.Свойство("НаименованиеПолное") Тогда
			Объект.НаименованиеПолное = СвойстваОбъекта.НаименованиеПолное;
		Иначе
			Объект.НаименованиеПолное = СокрЛП(Объект.Наименование);
		КонецЕсли;
	
		Если СвойстваОбъекта.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СвойстваОбъекта.СтавкаНДС) Тогда
			Объект.СтавкаНДС = СвойстваОбъекта.СтавкаНДС;
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
			Объект.СтавкаНДС = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяСтавкаНДС",Пользователь);
			Если Объект.СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка() Тогда
				Если ТипЗнч(Пользователь.ИдентификаторПользователяИБ) = Тип("УникальныйИдентификатор") Тогда
					текПользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
				ИначеЕсли ТипЗнч(Пользователь.ИдентификаторПользователяИБ) = Тип("Строка") Тогда
					текПользователь = ПользователиИнформационнойБазы.НайтиПоИмени(Пользователь.ИдентификаторПользователяИБ);
				Иначе
					текПользователь = Неопределено;
				КонецЕсли;
				Если текПользователь <> Неопределено Тогда
					текПользователь = текПользователь.Имя;
				КонецЕсли;
				Объект.СтавкаНДС = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяСтавкаНДС", текПользователь);
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
			ТекущаяДата = ТекущаяДатаСеанса();
			Если ТекущаяДата >= '20190101' Тогда
				ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(20);
			ИначеЕсли ТекущаяДата >= '20260101' Тогда
				ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(22);
			КонецЕсли;
			Объект.СтавкаНДС = ТекСтавкаНДС;
		КонецЕсли;
		
		// Все номенклатура из IIKO Нового качества
		Объект.Качество = Перечисления.ГрадацииКачества.Новый;
		
		// питВидНоменклатуры
		Если СвойстваОбъекта.Свойство("питВидНоменклатуры") Тогда
			Объект.питВидНоменклатуры = СвойстваОбъекта.питВидНоменклатуры;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.питВидНоменклатуры) Тогда
			Объект.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо;
		КонецЕсли;
		
		// ВидНоменклатуры
		Если СвойстваОбъекта.Свойство("ВидНоменклатуры") Тогда
			Объект.ВидНоменклатуры = СвойстваОбъекта.ВидНоменклатуры;
		КонецЕсли;
		
		// Если известен УИД Вида Номенклатуры получим соответствие 
		Если СвойстваОбъекта.Свойство("ВидНоменклатурыУИД") И Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
			СтрутураЭлементаIIKO = Новый Структура;
			СтрутураЭлементаIIKO.Вставить("УИД",СвойстваОбъекта.ВидНоменклатурыУИД);
			Обработки.питЗагрузкаIIKO.ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаIIKO,"ВидыНоменклатуры", ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры);
			Объект.ВидНоменклатуры = СтрутураЭлементаIIKO.Ссылка1С;
			
			// Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда 
			// 	СтрутураЭлементаIIKO = Обработки.питЗагрузкаIIKO.ПолучитьТипНоменклатурыIIKO(СвойстваОбъекта.ВидНоменклатурыУИД);
			// 	СтрутураЭлементаIIKO.Вставить("",);
			// 	СтрутураЭлементаIIKO.Вставить("",);
			// 	СтрутураЭлементаIIKO.Вставить("",);
			// 	СтрутураЭлементаIIKO.Вставить("",);
			// 	СтрутураЭлементаIIKO.Вставить("",);
			// 	СтрутураЭлементаIIKO.Вставить("",);
			// 	Объект.ВидНоменклатуры = Обработки.питЗагрузкаIIKO.СоздатьОбъектСоответствия(СтрутураЭлементаIIKO,
			// 																			ИмяМетаданных, 
			// 																			Неопределено, 
			// 																			Неопределено, 
			// 																			ТаблицаИзФайла,
			// 																			СвойстваОбъекта);
			// КонецЕсли;
		КонецЕсли;

		Объект.ИспользованиеХарактеристик = Объект.ВидНоменклатуры.ИспользованиеХарактеристик;
		Объект.ВариантОформленияПродажи   = Объект.ВидНоменклатуры.ВариантОформленияПродажи;
		Если НЕ ЗначениеЗаполнено(Объект.ГруппаДоступа) И ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
			Объект.ГруппаДоступа = Объект.ВидНоменклатуры.ГруппаДоступа;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ТипНоменклатуры) И ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
			Объект.ТипНоменклатуры = Объект.ВидНоменклатуры.ТипНоменклатуры;
		КонецЕсли;
		
		// Найдем единицу
		Если СвойстваОбъекта.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(СвойстваОбъекта.ЕдиницаИзмерения) И Не ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СвойстваОбъекта.ЕдиницаИзмерения)
		ИначеЕсли Не ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("кг");
		КонецЕсли;
		
		НастройкиНоменклатура = ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура;//ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПолучитьОбъектПоМетаданным("Номенклатура");
		Если ЗначениеЗаполнено(НастройкиНоменклатура.СлужебныйКаталог) Тогда
			Объект.Родитель = НастройкиНоменклатура.СлужебныйКаталог;
		КонецЕсли;
		
		Объект.питОсновнаяЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
		
	КонецЕсли;
	
КонецПроцедуры

// Установка реквизитов для объекта Модификатор
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  ОрганизацияЗагрузки - Произвольный - Организация загрузки.
//
Процедура ПрочитатьОбъектМодификаторы(Объект, СвойстваОбъекта, ОрганизацияЗагрузки) Экспорт
	
	// номенклатура модификатора
	ДопНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(Объект.Наименование, Истина);
	Если ДопНоменклатура.Пустая() Тогда
		СтрокаНастроек = ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура;//ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПолучитьОбъектПоМетаданным("Номенклатура");
		Если СтрокаНастроек.Создавать Тогда
			ДопНоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
			ДопНоменклатураОбъект.Наименование = Объект.Наименование;
			ДопНоменклатураОбъект.УстановитьНовыйКод("ii");
			
			СвойстваОбъекта.Вставить("питВидНоменклатуры", Перечисления.питВидыНоменклатуры.Блюдо);
			
			ПрочитатьОбъектНоменклатура(ДопНоменклатураОбъект, СвойстваОбъекта);
			
			Попытка
				ДопНоменклатураОбъект.Записать();
			Исключение
				Сообщение = новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось создать номенклатуру модификатора: "+ Объект.Наименование;
			КонецПопытки;
			ДопНоменклатура = ДопНоменклатураОбъект.Ссылка;
			
			НоменклатураПослеЗаписи(ДопНоменклатура, СвойстваОбъекта,, ОрганизацияЗагрузки);
		КонецЕсли;
	КонецЕсли;
	
	Объект.ДопНоменклатура = ДопНоменклатура;
	Объект.ЕдиницаИзмеренияНоменклатуры = ДопНоменклатура.питОсновнаяЕдиницаИзмерения;
	Объект.ЕдиницаИзмеренияМодификатора = ДопНоменклатура.ЕдиницаИзмерения;
	Объект.КоличествоНоменклатуры = 1;
	Если СвойстваОбъекта.Свойство("ЦенаМодификатора") Тогда
		Объект.Цена = СвойстваОбъекта.ЦенаМодификатора;
	КонецЕсли;
КонецПроцедуры

// Установка реквизитов для объекта Подразделение
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектПодразделения(СправочникОбъект, СвойстваОбъекта) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(СправочникОбъект.Владелец) Тогда
		Если СвойстваОбъекта.Свойство("Организация") Тогда
			СправочникОбъект.Владелец = СвойстваОбъекта.Организация;
		Иначе
			СправочникОбъект.Владелец = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация", ТекПользователь);;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Установка реквизитов для объекта Организация
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектОрганизации(СправочникОбъект, СвойстваОбъекта) Экспорт
	// Если НЕ ЗначениеЗаполнено(СправочникОбъект.ФормаСобственности) Тогда
	// 	СправочникОбъект.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;
	// КонецЕсли;
КонецПроцедуры

// Установка реквизитов для объекта Тип оплаты
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектВидыОплат(СправочникОбъект, СвойстваОбъекта) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(СправочникОбъект.ТипОплаты) Тогда
		Если СвойстваОбъекта.Свойство("ТипОплаты") И ЗначениеЗаполнено(СвойстваОбъекта.ТипОплаты) Тогда
			СправочникОбъект.ТипОплаты = СвойстваОбъекта.ТипОплаты;
		Иначе
			СправочникОбъект.ТипОплаты = Перечисления.питТипыОплат.Наличные;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СправочникОбъект.питВидОперации) Тогда
		Если СвойстваОбъекта.Свойство("ВидОперации") И ЗначениеЗаполнено(СвойстваОбъекта.ВидОперации) Тогда
			СправочникОбъект.питВидОперации = СвойстваОбъекта.ВидОперации;
		Иначе
			СправочникОбъект.питВидОперации = Перечисления.питВидыОперацийПоЗагрузкеДанныхПродаж;
		КонецЕсли;
	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(СправочникОбъект.питВидОперации) Тогда
		СправочникОбъект.питВидОперации = Перечисления.питВидыОперацийПоЗагрузкеДанныхПродаж.Реализация;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.СчетУчетаРасчетов) 
		И НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		СправочникОбъект.СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПрочиеДоходыИРасходы;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Организация) Тогда
		Если СвойстваОбъекта.Свойство("Организация") Тогда
			СправочникОбъект.Организация = СвойстваОбъекта.Организация;
		Иначе
			СправочникОбъект.Организация = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация", ТекПользователь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Установка реквизитов для объекта Касса ККМ
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектКассыККМ(СправочникОбъект, СвойстваОбъекта) Экспорт
	Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(СправочникОбъект.ВалютаДенежныхСредств) Тогда
		Если СвойстваОбъекта.Свойство("Валюта") Тогда
			СправочникОбъект.ВалютаДенежныхСредств = СвойстваОбъекта.Валюта;
		Иначе
			СправочникОбъект.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.ТипКассы) Тогда
		Если СвойстваОбъекта.Свойство("ТипКассы") Тогда
			СправочникОбъект.ТипКассы = СвойстваОбъекта.ТипКассы;
		Иначе
			СправочникОбъект.ТипКассы = Перечисления.ТипыКассККМ.ФискальныйРегистратор;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Склад) Тогда
		Если СвойстваОбъекта.Свойство("Склад") Тогда
			СправочникОбъект.Склад = СвойстваОбъекта.Склад;
		Иначе
			СправочникОбъект.Склад = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеСклад", Пользователь);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Подразделение) Тогда
		Если СвойстваОбъекта.Свойство("Подразделение") Тогда
			СправочникОбъект.Подразделение = СвойстваОбъекта.Подразделение;
		Иначе
			СправочникОбъект.Подразделение = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации", Пользователь);
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СправочникОбъект.Владелец) Тогда
		Если СвойстваОбъекта.Свойство("Организация") Тогда
			СправочникОбъект.Владелец = СвойстваОбъекта.Организация;
		Иначе
			СправочникОбъект.Владелец = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация", Пользователь);
			Если СправочникОбъект.Владелец = Справочники.Организации.ПустаяСсылка() Тогда
			Если ТипЗнч(Пользователь.ИдентификаторПользователяИБ) = Тип("УникальныйИдентификатор") Тогда
				текПользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
			ИначеЕсли ТипЗнч(Пользователь.ИдентификаторПользователяИБ) = Тип("Строка") Тогда
				текПользователь = ПользователиИнформационнойБазы.НайтиПоИмени(Пользователь.ИдентификаторПользователяИБ);
			Иначе
				текПользователь = Неопределено;
			КонецЕсли;
			Если текПользователь <> Неопределено Тогда
				текПользователь = текПользователь.Имя;
			КонецЕсли;
				СправочникОбъект.Владелец = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация", текПользователь);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

