//
&НаКлиенте
Процедура ИерархияНоменклатурыПриАктивизацииСтроки(Элемент)
	
	
	ОтборПоИерархииНоменклатуры = Элементы.ИерархияНоменклатуры.ТекущаяСтрока;
	
	ИмяПоля = "Родитель";
	Использование  = ОтборПоИерархииНоменклатуры <> Неопределено;
	ПравоеЗначение = ОтборПоИерархииНоменклатуры;
	ВидСравненияДляСписка = ВидСравненияКомпоновкиДанных.Равно;

	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(
	СписокНоменклатура.КомпоновщикНастроек.Настройки.Отбор, 
	ИмяПоля);
	Если Использование Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		СписокНоменклатура.КомпоновщикНастроек.Настройки.Отбор,
		ИмяПоля,
		ПравоеЗначение,
		ВидСравненияДляСписка,
		,
		Использование);
	КонецЕсли;
	 

	
	// ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатура,
	// 																		"Родитель",
