#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Функция возвращает заполненную количеством к приготовлению таблицу производства из АРМ производства.
//
// Параметры:
//  ТаблицаПроизводства - ТаблицаЗначений - Знач таблица производства.
//  СкладПроизводства - Произвольный - Склад производства.
//
// Возвращаемое значение:
//  ТаблицаЗначений - С дозаполненными колонками КоличествоМожноПриготовить.
Функция ЗаполнитьГотовностьКПриготовлению(Знач ТаблицаПроизводства, СкладПроизводства) Экспорт
	
	// 0. На входе будет ТаблицаПроизводства из АРМ "Производство".
	Если НЕ ТаблицаПроизводства.Количество() Тогда
		Возврат ТаблицаПроизводства;
	КонецЕсли;
	ПланыМеню = ТаблицаПроизводства.Скопировать(,"ПланМеню");
	ПланыМеню.Свернуть("ПланМеню");
	ПланыМеню = ПланыМеню.ВыгрузитьКолонку("ПланМеню");
	
	// 1. Получение производственной таблицы для всех планов-меню.
	ТаблицаПроизводстваДокумента = питПроизводство.ПолучитьТаблицуПроизводстваПоВыпускуБлюд(ПланыМеню, Истина);
	Если НЕ ТаблицаПроизводстваДокумента.Количество() Тогда
		Для каждого СтрокаАРМПроизводства Из ТаблицаПроизводства Цикл
			СтрокаАРМПроизводства.КоличествоМожноПриготовить = 0;
			СтрокаАРМПроизводства.КоличествоУпаковокМожноПриготовить = 0;
		КонецЦикла;
		Возврат ТаблицаПроизводства;
	КонецЕсли;
	
	// 2. Конвертация производственной таблицы, развертка полуфабрикатов приготовляемых в процессее до ингредиентов.
	// 2.1 Индексация таблицы производства.
	ТаблицаПроизводстваДокумента.Индексы.Добавить(КлючевыеПоляСтрокой());
	// 2.2 Копирование структуры таблицы производства в результирующую.
	РезультирующаяТаблица = ТаблицаПроизводстваДокумента.Скопировать(Новый Массив);
	// 2.3 Поиск в таблице производства строк, соответствующих блюдам верхнего уровня.
	СтрокиВерхнегоУровня = ТаблицаПроизводстваДокумента.НайтиСтроки(Новый Структура("Автопередел", Ложь));
	Для каждого ТекСтрокаВерхнегоУровня Из СтрокиВерхнегоУровня Цикл
		// 2.4 Анализ состава блюд верхнего уровня...
		// 2.4.1 Фильтр только по блюдам, которые есть в АРМ "Производство".
		Если НЕ ТаблицаПроизводства.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", ТекСтрокаВерхнегоУровня.Номенклатура, ТекСтрокаВерхнегоУровня.Характеристика)).Количество() Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТекСтрокаВерхнегоУровня.ИзАвтопеределов Тогда
			// 2.4.2 Это ингредиент для блюда верхнего уровня, добавляем в результат.
			НоваяРезультирующаяСтрока = РезультирующаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяРезультирующаяСтрока, ТекСтрокаВерхнегоУровня);
		Иначе
			// 2.4.3 Это полуфабрикат, производимый в процессе, его необходимо разузловать.
			ЗаполнитьИнгредиентамиРекурсивно(ТекСтрокаВерхнегоУровня, ТекСтрокаВерхнегоУровня, РезультирующаяТаблица, ТаблицаПроизводстваДокумента, ТекСтрокаВерхнегоУровня.КоличествоИнгредиентаФакт, ТекСтрокаВерхнегоУровня.КоличествоУпаковокИнгредиентаФакт);
		КонецЕсли;
	КонецЦикла;
	
	// 3. Получение остатков по ингредиентам.
	ТекстЗапросаИнгредиентовВНаличии = питОбщегоНазначенияСервер.ПолучитьТекстЗапросаСвободныеОстатки("втИнгредиенты", "втОстаткиИнгредиентов", Ложь, Ложь); 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ втПроизводство ИЗ &ТаблицаПроизводстваРазузлованная КАК ТаблицаПроизводстваРазузлованная;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втПроизводство.Ингредиент КАК Номенклатура,
	|	втПроизводство.ХарактеристикаИнгредиента КАК Характеристика,
	|	втПроизводство.НазначениеИнгредиента КАК Назначение,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия
	|ПОМЕСТИТЬ втИнгредиенты
	|ИЗ
	|	втПроизводство КАК втПроизводство
	|;
	|
	|" + ТекстЗапросаИнгредиентовВНаличии + "
	|;
	|ВЫБРАТЬ
	|	втОстаткиИнгредиентов.Номенклатура КАК Номенклатура,
	|	втОстаткиИнгредиентов.Характеристика КАК Характеристика,
	|	СУММА(втОстаткиИнгредиентов.Количество) КАК Количество
	|ИЗ
	|	втОстаткиИнгредиентов КАК втОстаткиИнгредиентов
	|СГРУППИРОВАТЬ ПО
	|	втОстаткиИнгредиентов.Номенклатура,
	|	втОстаткиИнгредиентов.Характеристика
	|ИМЕЮЩИЕ
	|	СУММА(втОстаткиИнгредиентов.Количество) > 0
	|";
	Запрос.УстановитьПараметр("ТаблицаПроизводстваРазузлованная", РезультирующаяТаблица);
	Запрос.УстановитьПараметр("Склад", СкладПроизводства);
	Запрос.УстановитьПараметр("НаДату", КонецДня(ТекущаяДата()));
	ОстаткиИнгредиентов = Запрос.Выполнить().Выгрузить();
	ОстаткиИнгредиентов.Индексы.Добавить("Номенклатура, Характеристика");
	
	// 4. Заполняем, сколько можно приготовить каждого блюда в АРМе исходя из остатков ингредиентов.
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	РезультирующаяТаблица.Свернуть("ДокументСсылка, Номенклатура, Характеристика, ЕдиницаИзмеренияНоменклатуры, Ингредиент, ХарактеристикаИнгредиента, ЕдиницаИзмеренияИнгредиента", "КоличествоНоменклатуры, КоличествоУпаковокНоменклатуры, КоличествоИнгредиентаФакт, КоличествоУпаковокИнгредиентаФакт");
	Для каждого СтрокаАРМПроизводства Из ТаблицаПроизводства Цикл
		НайденныеИнгредиенты = РезультирующаяТаблица.НайтиСтроки(Новый Структура("ДокументСсылка, Номенклатура, Характеристика", СтрокаАРМПроизводства.ПланМеню, СтрокаАРМПроизводства.Номенклатура, СтрокаАРМПроизводства.Характеристика));
		
		// Вычисление, сколько можно приготовить при текщих остатках ингредиентов.
		// МожноПриготовить = СтрокаАРМПроизводства.КоличествоОсталось;
		МожноПриготовить = Макс(0, СтрокаАРМПроизводства.КоличествоНужноПоПМ - СтрокаАРМПроизводства.КоличествоПроизвели);
		Для каждого НайденныйИнгредиент Из НайденныеИнгредиенты Цикл
			НайденныеОстатки = ОстаткиИнгредиентов.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", НайденныйИнгредиент.Ингредиент, НайденныйИнгредиент.ХарактеристикаИнгредиента));
			Если НЕ НайденныеОстатки.Количество() Тогда
				МожноПриготовить = 0;
				Прервать;
			КонецЕсли;
			НайденныйОстаток = НайденныеОстатки[0];
			МожноПриготовить = Мин(МожноПриготовить, 
				НайденныйИнгредиент.КоличествоНоменклатуры * 
					?(НайденныйИнгредиент.КоличествоИнгредиентаФакт = 0, 0, 
						(Мин(НайденныйИнгредиент.КоличествоИнгредиентаФакт, НайденныйОстаток.Количество) /
						НайденныйИнгредиент.КоличествоИнгредиентаФакт)));
		КонецЦикла;
		МожноПриготовить = Окр(МожноПриготовить, 3);
		МожноПриготовитьУпаковок = Окр(МожноПриготовить / питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаАРМПроизводства.Номенклатура, СтрокаАРМПроизводства.Упаковка, КэшированныеЗначения), 3);
		СтрокаАРМПроизводства.КоличествоМожноПриготовить = МожноПриготовить;
		СтрокаАРМПроизводства.КоличествоУпаковокМожноПриготовить = МожноПриготовитьУпаковок;
		
		Если МожноПриготовить = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Уменьшение остатка в таблице остатков
		Для каждого НайденныйИнгредиент Из НайденныеИнгредиенты Цикл
			НайденныеОстатки = ОстаткиИнгредиентов.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", НайденныйИнгредиент.Ингредиент, НайденныйИнгредиент.ХарактеристикаИнгредиента));
			Если НЕ НайденныеОстатки.Количество() Тогда
				Продолжить;
			КонецЕсли;
			НайденныйОстаток = НайденныеОстатки[0];
			НайденныйОстаток.Количество = НайденныйОстаток.Количество - ?(НайденныйИнгредиент.КоличествоНоменклатуры = 0, 0, Окр(НайденныйИнгредиент.КоличествоИнгредиентаФакт / НайденныйИнгредиент.КоличествоНоменклатуры * МожноПриготовить, 3));
			Если НайденныйОстаток.Количество <= 0 Тогда
				ОстаткиИнгредиентов.Удалить(НайденныйОстаток);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаПроизводства;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура выполняет разузловку строки производства, соответстующей полуфабрикату,
//  производимому в процессе до ингредиентов.
//
// Параметры:
//  ТекСтрокаВерхнегоБлюда - СтрокаТаблицыЗначений - Текущая строка таблицы производства блюда верхнего уровня с
//   полуаброикатом в составе.
//  ТекСтрокаПолуфабриката - СтрокаТаблицыЗначений - Текущая строка таблицы производства полуфабриката, который
//   разузловываем.
//  РезультирующаяТаблица - ТаблицаЗначений - Таблица, в которую добавляем ингредиенты.
//  ТаблицаПроизводстваДокумента - ТаблицаЗначений - Исходная таблица производства.
//  НаКоличествоПередела - Число - Количество полуфабриката, которое учавствует в текущем блюде.
//  НаКоличествоУпаковокПередела - Число - Количество упаковок полуфабриката, которое учавствует в текущем блюде.
//
Процедура ЗаполнитьИнгредиентамиРекурсивно(ТекСтрокаВерхнегоБлюда, ТекСтрокаПолуфабриката, РезультирующаяТаблица, ТаблицаПроизводстваДокумента, НаКоличествоПередела, НаКоличествоУпаковокПередела)
	
	// Структура поиска строк в таблице производства, соответствующих текущему п.ф.
	КлючевыеПоляСоответствие = КлючевыеПоляСоответствие();
	СтруктураПоиска = Новый Структура();
	Для каждого СтрокаСоответствия Из КлючевыеПоляСоответствие Цикл
		СтруктураПоиска.Вставить(СтрокаСоответствия.Ключ, ТекСтрокаПолуфабриката[СтрокаСоответствия.Значение]);
	КонецЦикла;
	СтруктураПоиска.Вставить("Автопередел", Истина);
	
	// Поиск сток в таблице производства, соответствующих текущему п.ф.
	НайденныеПотомки = ТаблицаПроизводстваДокумента.НайтиСтроки(СтруктураПоиска);
	Для каждого НайденныйПотомок  Из НайденныеПотомки Цикл
		
		// Количество ингредиента/п.ф. вычислим по коэффициенту (для случая, когда один ингредиент входит в несколько п.ф.)
		Если НайденныйПотомок.КоличествоНоменклатуры <> 0 ИЛИ НайденныйПотомок.КоличествоУпаковокНоменклатуры <> 0 Тогда
			Коэффициент = (НаКоличествоПередела / НайденныйПотомок.КоличествоНоменклатуры);
			КоэффициентУпаковок = (НаКоличествоУпаковокПередела / НайденныйПотомок.КоличествоУпаковокНоменклатуры);
		Иначе
			Коэффициент = 0;
			КоэффициентУпаковок = 0;
		КонецЕсли;
		
		НовоеКоличествоФакт = Окр(НайденныйПотомок.КоличествоИнгредиентаФакт * Коэффициент, 3);
		НовоеКоличествоУпаковокФакт = Окр(НайденныйПотомок.КоличествоУпаковокИнгредиентаФакт * КоэффициентУпаковок, 3);
		
		Если НЕ НайденныйПотомок.ИзАвтопеределов Тогда
			// В составе нашли ингредиент, добавляем ег в результируюую таблицу
			
			// Добавление в результат, 
			// все колонки заполняем по строке блюда верхнего уровня кроме ингредиентных колонок - их берем из найденной строки.
			НоваяРезультирующаяСтрока = РезультирующаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяРезультирующаяСтрока, ТекСтрокаВерхнегоБлюда);
			Для каждого СтрокаСоответствия Из КлючевыеПоляСоответствие Цикл
				НоваяРезультирующаяСтрока[СтрокаСоответствия.Значение] = НайденныйПотомок[СтрокаСоответствия.Значение];
			КонецЦикла;
			
			// Вычисляем количество факт, домножая его на коэффициент.
			НоваяРезультирующаяСтрока.КоличествоИнгредиентаФакт = НовоеКоличествоФакт;
			НоваяРезультирующаяСтрока.КоличествоУпаковокИнгредиентаФакт = НовоеКоличествоУпаковокФакт;
			
		Иначе
			// Это вложенный п.ф., делаем рекурсивный вызов.
			ЗаполнитьИнгредиентамиРекурсивно(ТекСтрокаВерхнегоБлюда, НайденныйПотомок, РезультирующаяТаблица, ТаблицаПроизводстваДокумента, НовоеКоличествоФакт, НовоеКоличествоУпаковокФакт);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция - Ключевые поля строкой.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
Функция КлючевыеПоляСтрокой()
	
	Возврат "ДокументСсылка, Номенклатура, Характеристика, Назначение, ЕдиницаИзмеренияНоменклатуры, Рецептура, Автопередел";
	
КонецФункции

// Функция - Ключевые поля соответствие.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
Функция КлючевыеПоляСоответствие()
	
	Результат = Новый Соответствие;
	Результат.Вставить("ДокументСсылка", "ДокументСсылка");
	Результат.Вставить("Номенклатура", "Ингредиент");
	Результат.Вставить("Характеристика", "ХарактеристикаИнгредиента");
	Результат.Вставить("Назначение", "НазначениеИнгредиента");
	Результат.Вставить("ЕдиницаИзмеренияНоменклатуры", "ЕдиницаИзмеренияИнгредиента");
	Результат.Вставить("Рецептура", "РецептураАвтопередела");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
