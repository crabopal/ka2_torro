

#Область ПрограммныйИнтерфейс

//  Процедура - После закрытия формы настроек.
//
// Параметры:
//  Рез - Произвольный - Рез.
//  ДопПарам - Произвольный - Доп парам.
//
&НаКлиенте
Процедура ПослеЗакрытияФормыНастроек(Рез, ДопПарам) Экспорт
	
	Если Рез = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Рез.Свойство("УчитыватьОстаткиНаСкладе") Тогда
		Объект.УчитыватьОстаткиНаСкладе = Рез.УчитыватьОстаткиНаСкладе;	
	КонецЕсли;
	
	Если Рез.Свойство("ОтображатьПриготовленные") Тогда
		Объект.ОтображатьПриготовленные = Рез.ОтображатьПриготовленные;	
	КонецЕсли;
	
	Если Рез.Свойство("ОтображатьКолонкуИзготовить") Тогда
		Объект.ОтображатьКолонкуИзготовить = Рез.ОтображатьКолонкуИзготовить;	
	КонецЕсли;
	
	Если Рез.Свойство("ОтображатьКолонкуНаправление") Тогда
		Объект.ОтображатьКолонкуНаправление = Рез.ОтображатьКолонкуНаправление;	
	КонецЕсли;
	
	Если Рез.Свойство("ОтображатьКолонкуОсталось") Тогда
		Объект.ОтображатьКолонкуОсталось = Рез.ОтображатьКолонкуОсталось;	
	КонецЕсли;
	
	Если Рез.Свойство("ОтображатьКолонкуРецептура") Тогда
		Объект.ОтображатьКолонкуРецептура = Рез.ОтображатьКолонкуРецептура;	
	КонецЕсли;
	
	ОбновитьОформлениеКолонокКлиент();
	
	ПослеЗакрытияНастроекСервер();
	
	ОбновитьОтображениеДанных();	
	
КонецПроцедуры

//  Процедура - Надпись выбранная дата нажатие завершение.
//
// Параметры:
//  Дата - Дата - Дата.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура НадписьВыбраннаяДатаНажатиеЗавершение(Дата, ДополнительныеПараметры) Экспорт
	Если ЗначениеЗаполнено(Дата) Тогда
		СекундВДне = 24 * 60 * 60;
		ДатаПроизводства = Дата;
		ДатаНачалаКнопок = Дата - Окр(КоличествоКнопок / 2) * СекундВДне;
		НадписьВыбраннаяДатаНажатиеНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// заполним место производства
	МестоПроизводства = Справочники.Склады.НайтиПоНаименованию("Кухня-цех");
	Элементы.ДекорацияМестоПроизводства.Заголовок = МестоПроизводства.Наименование + " (место производства)";
	
	// заполним начальные настройки
	Объект.УчитыватьОстаткиНаСкладе = Истина;
	Объект.ОтображатьПриготовленные = Истина;
	Объект.ОтображатьКолонкуИзготовить = Истина;
	Объект.ОтображатьКолонкуНаправление = Истина;
	Объект.ОтображатьКолонкуОсталось = Истина;
	Объект.ОтображатьКолонкуРецептура = Истина;
	
	// если есть сохраненные настройки, вернем их
	ВосстановитьНастройкиНаСервере();
	
	// заполнение ТЧ
	ДатаПроизводства = НачалоДня(ТекущаяДата());
	Элементы.НадписьВыбраннаяДата.Заголовок = ВернутьЗаголовокКнопкиДаты(ДатаПроизводства, истина);
	
	ПостроитьТаблицуПроизводстваНаДату(ДатаПроизводства);
	
	// определяем экран
	МассивЭкран = ПолучитьИнформациюЭкрановКлиента(); 
	Если МассивЭкран.Количество() >0 Тогда
		ШиринаЭкрана = МассивЭкран[0].Ширина;
	КонецЕсли;
	
	КоличествоКнопок = Цел(ШиринаЭкрана/150)-1;
	Если КоличествоКнопок<= 0 Тогда 
		КоличествоКнопок = 1;	
	КонецЕсли;
	
	ДатаНачалаКнопок = НачалоДня(ТекущаяДата());
	// КоличествоКнопок = 8;
	СоздатьКнопкиДат(КоличествоКнопок);
	ОбновитьКнопкиДат();
	
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.Склады.Форма.ФормаВыбора" Тогда 
		
		МестоПроизводства = ВыбранноеЗначение;
		Элементы.ДекорацияМестоПроизводства.Заголовок = Строка(ВыбранноеЗначение) + " (место производства)";
		
		// +надо будет обновлять кнопки дат когда вернем зеленый цвет и количество в скобках
		ПостроитьТаблицуПроизводстваНаДату(ДатаПроизводства);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ПостроитьТаблицуПроизводстваНаДатуКлиент", 60);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

//  Процедура - Декорация место производства нажатие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДекорацияМестоПроизводстваНажатие(Элемент)
	
	ОткрытьФорму("Справочник.Склады.ФормаВыбора",  , ЭтаФорма);		
	
КонецПроцедуры

//  Процедура - Таблица производства количество приготовлено при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаПроизводстваКоличествоПриготовленоПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаПроизводства.ТекущиеДанные;
	Если Не ТекДанные = Неопределено Тогда
		
		// Коэффициент упаковки.
		ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекДанные.Номенклатура,ТекДанные.Упаковка);
		
		// Значение до изменения.
		КоличествоУпПриготовленоПред = ТекДанные.КоличествоПриготовлено / ТекКоэффициент;
		
		// Дельта между новым значением и старым.
		КоличествоУпПриготовленоДельта = ТекДанные.КоличествоУпПриготовлено - КоличествоУпПриготовленоПред;
		
		// Обновляем "Осталось приготовить".
		ТекДанные.КоличествоУпОсталось = ТекДанные.КоличествоУпОсталось - КоличествоУпПриготовленоДельта;	
		
		// Обновляем количества в базовых единицах измерения.
		ТекДанные.КоличествоПриготовлено 	= ТекДанные.КоличествоУпПриготовлено * ТекКоэффициент;
		ТекДанные.КоличествоОсталось 		= ТекДанные.КоличествоУпОсталось * ТекКоэффициент;
		
	КонецЕсли;
		
КонецПроцедуры

//  Процедура - Таблица производства выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаПроизводстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ТаблицаПроизводства.ТекущиеДанные;
	Если Не ТекДанные = Неопределено Тогда
		
		Если Поле.Имя = "ТаблицаПроизводстваНадписьРецептура" Тогда
			
			#Если МобильныйКлиент ТОгда
				// чтобы не открывалась вторая форма для строки
				СтандартнаяОбработка = Ложь;	
			#КонецЕсли
			
			Если НЕ ТекДанные.НадписьРецептура = "" Тогда
		
				ТекРецептура = ТекДанные.Рецептура;
				Если ЗначениеЗаполнено(ТекРецептура) Тогда
					ПоказатьЗначение(,ТекРецептура);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли Поле.Имя = "ТаблицаПроизводстваКоличествоПриготовлено" Тогда
			
			#Если МобильныйКлиент ТОгда
				
				СтандартнаяОбработка = Ложь;
				ВЗнач	= Неопределено;
				
				ОписаниеОповещения = Новый ОписаниеОповещения ("ВводЗначенияЗавершение",ЭтаФорма);
				ПоказатьВводЗначения(ОписаниеОповещения, ВЗнач,,Тип("Число"));
				//Если ВвестиЗначение(ВЗнач, "Приготовлено:", Тип("Число")) Тогда
				//	
				//	ТекДанные.КоличествоУпПриготовлено	= ВЗнач;
				//	
				//	ТекДанные.КоличествоУпОсталось = ТекДанные.КоличествоУпОсталось - ТекДанные.КоличествоУпПриготовлено;	
				//	
				//	ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекДанные.Номенклатура,ТекДанные.Упаковка);
				//	
				//	ТекДанные.КоличествоПриготовлено 	= ТекДанные.КоличествоУпПриготовлено * ТекКоэффициент;
				//	ТекДанные.КоличествоОсталось 		= ТекДанные.КоличествоУпОсталось * ТекКоэффициент;
				//	
				//КонецЕсли;
				
			#КонецЕсли
			
		Иначе
			
			// в случае с мобильным клиентов в противном случае всегда открываем рецептуру
			#Если МобильныйКлиент ТОгда
				
				СтандартнаяОбработка = Ложь;	
			
				Если НЕ ТекДанные.НадписьРецептура = "" Тогда
			
					ТекРецептура = ТекДанные.Рецептура;
					Если ЗначениеЗаполнено(ТекРецептура) Тогда
						ПоказатьЗначение(,ТекРецептура);
					КонецЕсли;
					
				КонецЕсли;
				
			#КонецЕсли
			
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры

//  Процедура - Ввод значения завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ВводЗначенияЗавершение(Результат, Параметры)
	
	Если НЕ Результат = Неопределено Тогда
		
		ТекДанные = Элементы.ТаблицаПроизводства.ТекущиеДанные;

		ТекДанные.КоличествоУпПриготовлено	= Результат;
		
		ТекДанные.КоличествоУпОсталось = ТекДанные.КоличествоУпОсталось - ТекДанные.КоличествоУпПриготовлено;	
		
		ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекДанные.Номенклатура,ТекДанные.Упаковка);
		
		ТекДанные.КоличествоПриготовлено 	= ТекДанные.КоличествоУпПриготовлено * ТекКоэффициент;
		ТекДанные.КоличествоОсталось 		= ТекДанные.КоличествоУпОсталось * ТекКоэффициент;
		
	КонецЕсли;
	
	
КонецПроцедуры

//  Процедура - Html size документ сформирован.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура HTMLSizeДокументСформирован(Элемент)
	ИзменитьШирину(Элемент);
КонецПроцедуры

//  Процедура - Html size при нажатии.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеСобытия - Произвольный - Данные события.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура HTMLSizeПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	ИзменитьШирину(Элемент);
КонецПроцедуры

//  Процедура - Изменить ширину.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ИзменитьШирину(Элемент)
	
	Элемент.Видимость = True;

	ШиринаЭкрана = Элемент.Document.Body.clientWidth;///(Show_NY + Show_Q1 + Show_Q3 + Show_Q2 + Show_Q4)/8.75-1;

	Элемент.Видимость = False;
	
КонецПроцедуры

//  Процедура - Надпись выбранная дата нажатие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура НадписьВыбраннаяДатаНажатие(Элемент)
	ПоказатьВводДаты(Новый ОписаниеОповещения("НадписьВыбраннаяДатаНажатиеЗавершение", ЭтотОбъект, Новый Структура), ДатаПроизводства,,ЧастиДаты.Дата);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

//  Процедура - Открыть форму отборов.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ОткрытьФормуОтборов(Команда)
	
	ОповещениеПослеЗакрытияФормыНастроек = Новый ОписаниеОповещения("ПослеЗакрытияФормыНастроек", ЭтотОбъект, );
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("УчитыватьОстаткиНаСкладе", Объект.УчитыватьОстаткиНаСкладе);
	СтруктураНастроек.Вставить("ОтображатьПриготовленные", Объект.ОтображатьПриготовленные);
	СтруктураНастроек.Вставить("ОтображатьКолонкуИзготовить", Объект.ОтображатьКолонкуИзготовить);
	СтруктураНастроек.Вставить("ОтображатьКолонкуНаправление", Объект.ОтображатьКолонкуНаправление);
	СтруктураНастроек.Вставить("ОтображатьКолонкуОсталось", Объект.ОтображатьКолонкуОсталось);
	СтруктураНастроек.Вставить("ОтображатьКолонкуРецептура", Объект.ОтображатьКолонкуРецептура);
	
	ОткрытьФорму("Обработка.питАРМПроизводства.Форма.ФормаНастроек", СтруктураНастроек, ЭтотОбъект,,,,ОповещениеПослеЗакрытияФормыНастроек);
	
КонецПроцедуры

//  Процедура - Сдвиг дат влево.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СдвигДатВлево(Команда)
	
	ДатаНачалаКнопок = НачалоДня(НачалоДня(ДатаНачалаКнопок) - 1);
	ОбновитьКнопкиДат();
	
КонецПроцедуры

//  Процедура - Сдвиг дат вправо.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СдвигДатВправо(Команда)
	
	ДатаНачалаКнопок = НачалоДня(КонецДня(ДатаНачалаКнопок) + 1);
	ОбновитьКнопкиДат();
	
КонецПроцедуры

//  Процедура - Нажатие на кнопку даты.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НажатиеНаКнопкуДаты(Команда)

	ИмяКоманды = Команда.Имя;
	НайдСтроки = КнопкиДат.НайтиСтроки(Новый Структура("ИмяКоманды", ИмяКоманды));
	Если НайдСтроки.Количество() > 0 тогда
		СтрокаСДатой = НайдСтроки[0];
		ДатаПроизводства = СтрокаСДатой.ДатаКнопки;
		
		Элементы.НадписьВыбраннаяДата.Заголовок = ВернутьЗаголовокКнопкиДаты(ДатаПроизводства, истина);

		ПостроитьТаблицуПроизводстваНаДату(ДатаПроизводства);
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось определить дату";
		Сообщение.Сообщить();
	КонецЕсли;
		
КонецПроцедуры

//  Процедура - Провести документы.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПровестиДокументы(Команда)
	ПровестиДокументыНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Процедура - После закрытия настроек сервер.
//
&НаСервере
Процедура ПослеЗакрытияНастроекСервер()
	
	ПостроитьТаблицуПроизводстваНаДату(ДатаПроизводства);
	
	СохранитьНастройкиНаСервере();

КонецПроцедуры	

//  Процедура - Сохранить настройки на сервере.
//
&НаСервере
Процедура СохранитьНастройкиНаСервере()

	// Подготовка структуры настроек для сохранения
	НастройкиОбработки = Новый Структура();
	НастройкиОбработки.Вставить("УчитыватьОстаткиНаСкладе",			Объект.УчитыватьОстаткиНаСкладе);
	НастройкиОбработки.Вставить("ОтображатьКолонкуИзготовить",		Объект.ОтображатьКолонкуИзготовить);
	НастройкиОбработки.Вставить("ОтображатьКолонкуНаправление",		Объект.ОтображатьКолонкуНаправление);	
	НастройкиОбработки.Вставить("ОтображатьКолонкуОсталось",		Объект.ОтображатьКолонкуОсталось);
	НастройкиОбработки.Вставить("ОтображатьКолонкуРецептура",		Объект.ОтображатьКолонкуРецептура);	
	НастройкиОбработки.Вставить("ОтображатьПриготовленные",			Объект.ОтображатьПриготовленные);	
		
	// Сохранение настроек в хранилище
	ХранилищеНастроекДанныхФорм.Сохранить("Обработка_питАРМПроизводства", "НастройкиЗаполнения", НастройкиОбработки);
	
КонецПроцедуры

//  Процедура - Восстановить настройки на сервере.
//
&НаСервере
Процедура ВосстановитьНастройкиНаСервере()

	НастройкиОбработки = ХранилищеНастроекДанныхФорм.Загрузить("Обработка_питАРМПроизводства", "НастройкиЗаполнения");
	
	Если НастройкиОбработки = Неопределено Тогда 
		Возврат; // Нет сохраненных настроек
	КонецЕсли;
	
	// Восстановление настроек из хранилища
	Объект.УчитыватьОстаткиНаСкладе		= НастройкиОбработки.УчитыватьОстаткиНаСкладе;
	Объект.ОтображатьКолонкуИзготовить	= НастройкиОбработки.ОтображатьКолонкуИзготовить;
	Объект.ОтображатьКолонкуНаправление	= НастройкиОбработки.ОтображатьКолонкуНаправление;
	Объект.ОтображатьКолонкуОсталось	= НастройкиОбработки.ОтображатьКолонкуОсталось;
	Объект.ОтображатьКолонкуРецептура	= НастройкиОбработки.ОтображатьКолонкуРецептура;
	Объект.ОтображатьПриготовленные		= НастройкиОбработки.ОтображатьПриготовленные;
	
КонецПроцедуры
//  Процедура - Обновить оформление колонок клиент.
//
&НаКлиенте
Процедура ОбновитьОформлениеКолонокКлиент()
	
	Элементы.ТаблицаПроизводстваКоличествоИзготовить.Видимость = Объект.ОтображатьКолонкуИзготовить;
	Элементы.ТаблицаПроизводстваКоличествоОсталось.Видимость = Объект.ОтображатьКолонкуОсталось;
	Элементы.ТаблицаПроизводстваНадписьРецептура.Видимость = Объект.ОтображатьКолонкуРецептура;
	Элементы.ТаблицаПроизводстваСкладРеализации.Видимость = Объект.ОтображатьКолонкуНаправление;
	
КонецПроцедуры

//  Процедура - Создать кнопки дат.
//
// Параметры:
//  КоличествоКнопок - Произвольный - Количество кнопок.
//
&НаСервере
Процедура СоздатьКнопкиДат(КоличествоКнопок)
	
	ТекДатаКнопки = НачалоДня(ТекущаяДата());
	
	Для сч = 1 по КоличествоКнопок Цикл
		
		ИмяКоманды	= "ВыборДаты_" + сч;
		
		НоваяКоманда = Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "НажатиеНаКнопкуДаты";
			
		// создаем кнопку на форме
		ИмяКнопкиНаФорме = "btn" + ИмяКоманды;
		ЗаголовокКнопкиНаФорме = ВернутьЗаголовокКнопкиДаты(ТекДатаКнопки); 
		КнопкаДляКоманды = Элементы.Добавить(ИмяКнопкиНаФорме, тип("КнопкаФормы"), Элементы.ГруппаДат);
		КнопкаДляКоманды.Заголовок		= ЗаголовокКнопкиНаФорме;
		КнопкаДляКоманды.ИмяКоманды	= ИмяКоманды;
		
		// оформление кнопки
		КнопкаДляКоманды.Высота = 2;
		КнопкаДляКоманды.ЦветРамки = ЦветаСтиля.ЦветФонаФормы;
		КнопкаДляКоманды.Ширина = 15;
		КнопкаДляКоманды.АвтоМаксимальнаяШирина = ложь;
		КнопкаДляКоманды.РастягиватьПоГоризонтали = истина;
		
		// добавляем кнопку в ТЗ кнопок
		НовСтрокаТЗ = КнопкиДат.Добавить();
		НовСтрокаТЗ.ИмяКнопкиНаФорме = ИмяКнопкиНаФорме;
		НовСтрокаТЗ.ИмяКоманды = ИмяКоманды;
		НовСтрокаТЗ.ДатаКнопки = ТекДатаКнопки;
		НовСтрокаТЗ.ЗаголовокКнопкиНаФорме = ЗаголовокКнопкиНаФорме;
		
		ТекДатаКнопки = НачалоДня(КонецДня(ТекДатаКнопки) + 1);
		
	КонецЦикла;
	
	
КонецПроцедуры

//  Процедура - Обновить кнопки дат.
//
&НаСервере
Процедура ОбновитьКнопкиДат()
	
	// пока закомментим до доработки запроса
	// ТаблицаДатыСПланамиПроизводств = ВернутьТаблицуДатСПланамиПроизводств();
	
	ТекДатаКнопки = ДатаНачалаКнопок;
	
	Для каждого СтрокаКнопокДат из КнопкиДат Цикл
				
		// обновим кнопку на форме
		ЗаголовокКнопкиНаФорме = ВернутьЗаголовокКнопкиДаты(ТекДатаКнопки);
				
		ЭлементСКнопкой = Элементы.Найти(СтрокаКнопокДат.ИмяКнопкиНаФорме);
		
		// пока закомментим до доработки запроса
		НайдСтрокаСДатойПоПроизводству =  Неопределено;//ТаблицаДатыСПланамиПроизводств.Найти(ТекДатаКнопки, "Дата");
		Если НайдСтрокаСДатойПоПроизводству <> Неопределено Тогда
			ЗаголовокКнопкиНаФорме = ЗаголовокКнопкиНаФорме + " (" + НайдСтрокаСДатойПоПроизводству.КоличествоПозиций + ")";	
			Если НЕ ЭлементСКнопкой = Неопределено Тогда
				ЭлементСКнопкой.ЦветТекста = ЦветаСтиля.ЦветАкцента;	
			Иначе
				ЭлементСКнопкой.ЦветТекста = Новый Цвет(77, 77, 77);	
			КонецЕсли;
		Иначе
			ЭлементСКнопкой.ЦветТекста = Новый Цвет(77, 77, 77);
		КонецЕсли;
		
		Если НЕ ЭлементСКнопкой = Неопределено Тогда
			ЭлементСКнопкой.Заголовок		= ЗаголовокКнопкиНаФорме;
		КонецЕсли;
		
		// исправляем кнопку в ТЗ кнопок
		СтрокаКнопокДат.ДатаКнопки = ТекДатаКнопки;
		СтрокаКнопокДат.ЗаголовокКнопкиНаФорме = ЗаголовокКнопкиНаФорме;
		
		ТекДатаКнопки = НачалоДня(КонецДня(ТекДатаКнопки) + 1);
		
	КонецЦикла;
	
КонецПроцедуры

//  Функция - Вернуть заголовок кнопки даты.
//
// Параметры:
//  ДатаВКнопке - Дата - Дата в кнопке.
//  Полный - Произвольный - Полный.
//
// Возвращаемое значение:
//  Дата - Результат обработки.
//
&НаСервере
Функция ВернутьЗаголовокКнопкиДаты(ДатаВКнопке, Полный = Ложь)
			
	Если ДатаВКнопке = НачалоДня(ТекущаяДата()) тогда
		// сегодня
		Если Полный Тогда
			Возврат "Сегодня, " + СтрЗаменить(Формат(ДатаВКнопке, "ДФ = dd*MMMM"), "*", " ") + ", " + Формат(ДатаВКнопке, "ДФ = dddd");
		Иначе
			Возврат Формат(ДатаВКнопке, "ДФ=dd.MM") + ", " + "сегодня";
		КонецЕсли;
		
	ИначеЕсли ДатаВКнопке = НачалоДня(НачалоДня(ТекущаяДата()) - 1) Тогда
		// вчера	
		Если Полный Тогда
			Возврат "Вчера, " + СтрЗаменить(Формат(ДатаВКнопке, "ДФ = dd*MMMM"), "*", " ") + ", " + Формат(ДатаВКнопке, "ДФ = dddd");
		Иначе
			Возврат Формат(ДатаВКнопке, "ДФ=dd.MM") + ", " + "вчера";
		КонецЕсли;
	ИначеЕсли ДатаВКнопке = НачалоДня(КонецДня(ТекущаяДата()) + 1) Тогда
		// завтра
		Если Полный Тогда
			Возврат "Завтра, " + СтрЗаменить(Формат(ДатаВКнопке, "ДФ = dd*MMMM"), "*", " ") + ", " + Формат(ДатаВКнопке, "ДФ = dddd");
		Иначе
			Возврат Формат(ДатаВКнопке, "ДФ=dd.MM") + ", " + "завтра";
		КонецЕсли;
	Иначе	
		Если Полный Тогда
			Возврат СтрЗаменить(Формат(ДатаВКнопке, "ДФ = dd*MMMM"), "*", " ") + ", " + Формат(ДатаВКнопке, "ДФ = dddd");
		Иначе
			Возврат Формат(ДатаВКнопке, "ДФ=dd.MM") + ", " + Формат(ДатаВКнопке, "ДФ = ddd");
		КонецЕсли;
	КонецЕсли;
	
	
КонецФункции

//  Процедура - Построить таблицу производства на дату.
//
// Параметры:
//  ВыбраннаяДата - Дата - Выбранная дата.
//
&НаСервере
Процедура ПостроитьТаблицуПроизводстваНаДату(ВыбраннаяДата)
	
	ТаблицаПроизводства.Очистить();
	ДеревоПроизводства.ПолучитьЭлементы().Очистить();
	
	Если Объект.УчитыватьОстаткиНаСкладе Тогда
		
		ТексЗапросаПроизвели = питОбщегоНазначенияСервер.ПолучитьТекстЗапросаСвободныеОстатки("ВТ_ТребуетсяСГруппировкой","ВТ_Произвели", Истина, Ложь); 
		
	Иначе
		
		ТексЗапросаПроизвели = 
		"////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	питВыпускБлюдТовары.Номенклатура КАК Номенклатура,
		|	питВыпускБлюдТовары.Характеристика КАК Характеристика,
		|	СУММА(питВыпускБлюдТовары.Количество) КАК Количество,
		|	питВыпускБлюд.Ссылка КАК ДокВыпуска,
		|	питВыпускБлюд.СкладПолучатель КАК Склад,
		|	ВТ_ТребуетсяПроизвести.ПланМеню КАК ПланМеню
		|ПОМЕСТИТЬ ВТ_Произвели
		|ИЗ
		|	Документ.питВыпускБлюд.Товары КАК питВыпускБлюдТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд КАК питВыпускБлюд
		|		ПО питВыпускБлюдТовары.Ссылка = питВыпускБлюд.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТребуетсяПроизвести КАК ВТ_ТребуетсяПроизвести
		|		ПО питВыпускБлюдТовары.Номенклатура = ВТ_ТребуетсяПроизвести.Номенклатура
		|			И питВыпускБлюдТовары.Характеристика = ВТ_ТребуетсяПроизвести.Характеристика
		|			И питВыпускБлюдТовары.Ссылка.ДокументОснование = ВТ_ТребуетсяПроизвести.ПланМеню
		|ГДЕ
		|	питВыпускБлюд.Проведен
		|	И НЕ питВыпускБлюд.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	питВыпускБлюд.Ссылка,
		|	питВыпускБлюдТовары.Номенклатура,
		|	питВыпускБлюдТовары.Характеристика,
		|	ВТ_ТребуетсяПроизвести.ПланМеню
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика,
		|	ДокВыпуска,
		|	ПланМеню
		|	";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	питПланМеню.Ссылка КАК ПланМеню,
	|	питПланМеню.СкладРеализации КАК СкладРеализации
	|ПОМЕСТИТЬ ВТ_ДокиМенюКПроизводству
	|ИЗ
	|	Документ.питПланМеню КАК питПланМеню
	|ГДЕ
	|	питПланМеню.ЦеховаяКладовая = &Склад
	|	И НАЧАЛОПЕРИОДА(питПланМеню.ДатаПлан, ДЕНЬ) = &ДатаПроизводства
	|	И питПланМеню.Проведен
	|	И НЕ питПланМеню.ПометкаУдаления
	|	И питПланМеню.Статус = &Статус
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПланМеню
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питПланМенюТовары.Номенклатура КАК Номенклатура,
	|	питПланМенюТовары.Характеристика КАК Характеристика,
	|	МАКСИМУМ(питПланМенюТовары.Упаковка) КАК Упаковка,
	|	СУММА(питПланМенюТовары.Количество) КАК Количество,
	|	питПланМенюТовары.Рецептура КАК Рецептура,
	|	ВТ_ДокиМенюКПроизводству.СкладРеализации КАК СкладРеализации,
	|	ВТ_ДокиМенюКПроизводству.ПланМеню КАК ПланМеню,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Серия
	|ПОМЕСТИТЬ ВТ_ТребуетсяПроизвести
	|ИЗ
	|	Документ.питПланМеню.Товары КАК питПланМенюТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокиМенюКПроизводству КАК ВТ_ДокиМенюКПроизводству
	|		ПО питПланМенюТовары.Ссылка = ВТ_ДокиМенюКПроизводству.ПланМеню
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДокиМенюКПроизводству.ПланМеню,
	|	питПланМенюТовары.Рецептура,
	|	питПланМенюТовары.Характеристика,
	|	ВТ_ДокиМенюКПроизводству.СкладРеализации,
	|	питПланМенюТовары.Номенклатура 
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	ПланМеню
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТребуетсяПроизвести.Номенклатура КАК Номенклатура,
	|	ВТ_ТребуетсяПроизвести.Характеристика КАК Характеристика,
	|	ВТ_ТребуетсяПроизвести.Упаковка КАК Упаковка,
	|	ВТ_ТребуетсяПроизвести.СкладРеализации КАК Склад,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Серия,
	|	СУММА(ВТ_ТребуетсяПроизвести.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_ТребуетсяСГруппировкой
	|ИЗ
	|	ВТ_ТребуетсяПроизвести КАК ВТ_ТребуетсяПроизвести
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТребуетсяПроизвести.Характеристика,
	|	ВТ_ТребуетсяПроизвести.Упаковка,
	|	ВТ_ТребуетсяПроизвести.Номенклатура,
	|	ВТ_ТребуетсяПроизвести.СкладРеализации
	|;
	|
	|"+ТексЗапросаПроизвели+"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокиМенюКПроизводству.ПланМеню КАК ПланМеню,
	|	МАКСИМУМ(ЕСТЬNULL(питВыпускБлюд.Ссылка, ЗНАЧЕНИЕ(Документ.питВыпускБлюд.ПустаяСсылка))) КАК МаксВыпуск
	|ПОМЕСТИТЬ втМаксВыпуски
	|ИЗ
	|	ВТ_ДокиМенюКПроизводству КАК ВТ_ДокиМенюКПроизводству
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд КАК питВыпускБлюд
	|		ПО (ВТ_ДокиМенюКПроизводству.ПланМеню = питВыпускБлюд.ДокументОснование)
	|ГДЕ
	|	НЕ питВыпускБлюд.ПометкаУдаления
	|	И питВыпускБлюд.Проведен
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДокиМенюКПроизводству.ПланМеню
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТребуетсяПроизвести.ПланМеню КАК ПланМеню,
	|	ВТ_ТребуетсяПроизвести.СкладРеализации КАК СкладРеализации,
	|	ВТ_ТребуетсяПроизвести.Номенклатура КАК Номенклатура,
	|	ВТ_ТребуетсяПроизвести.Характеристика КАК Характеристика,
	|	ВТ_ТребуетсяПроизвести.Рецептура КАК Рецептура,
	|	ЕСТЬNULL(ВТ_Произвели.Количество, 0) КАК КоличествоПроизвели,
	|"+ ?(Объект.УчитыватьОстаткиНаСкладе, "", "ЕСТЬNULL(ВТ_Произвели.ДокВыпуска, ЗНАЧЕНИЕ(Документ.питВыпускБлюд.ПустаяСсылка)) КАК ВыпускБлюд,")+"
	|	ВТ_ТребуетсяСГруппировкой.Упаковка КАК Упаковка,
	|	ВТ_ТребуетсяСГруппировкой.Количество КАК КоличествоНужноВсего,
	|	ВТ_ТребуетсяПроизвести.Количество КАК КоличествоНужноПоПМ,
	|	0 КАК КоличествоМожноПриготовить,
	|	0 КАК КоличествоУпаковокМожноПриготовить
	|ПОМЕСТИТЬ втРезультат
	|ИЗ
	|	ВТ_ТребуетсяПроизвести КАК ВТ_ТребуетсяПроизвести
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Произвели КАК ВТ_Произвели
	|		ПО ВТ_ТребуетсяПроизвести.Номенклатура = ВТ_Произвели.Номенклатура
	|			И ВТ_ТребуетсяПроизвести.Характеристика = ВТ_Произвели.Характеристика
	|"+ ?(Объект.УчитыватьОстаткиНаСкладе, "И ВТ_ТребуетсяПроизвести.СкладРеализации = ВТ_Произвели.Склад", "")+"
	|"+ ?(Объект.УчитыватьОстаткиНаСкладе, "", "И ВТ_ТребуетсяПроизвести.ПланМеню = ВТ_Произвели.ПланМеню")+"
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТребуетсяСГруппировкой КАК ВТ_ТребуетсяСГруппировкой
	|		ПО ВТ_ТребуетсяПроизвести.Номенклатура = ВТ_ТребуетсяСГруппировкой.Номенклатура
	|			И ВТ_ТребуетсяПроизвести.Характеристика = ВТ_ТребуетсяСГруппировкой.Характеристика
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втРезультат.ПланМеню КАК ПланМеню,
	|	втРезультат.СкладРеализации КАК СкладРеализации,
	|	втРезультат.Номенклатура КАК Номенклатура,
	|	втРезультат.Характеристика КАК Характеристика,
	|	втРезультат.Рецептура КАК Рецептура,
	|	втРезультат.КоличествоПроизвели КАК КоличествоПроизвели,
	|"+ ?(НЕ Объект.УчитыватьОстаткиНаСкладе, "ВЫБОР
	|		КОГДА втРезультат.ВыпускБлюд = ЗНАЧЕНИЕ(Документ.питВыпускБлюд.ПустаяСсылка)
	|			ТОГДА ЕстьNULL(втМаксВыпуски.МаксВыпуск, ЗНАЧЕНИЕ(Документ.питВыпускБлюд.ПустаяСсылка))
	|		ИНАЧЕ втРезультат.ВыпускБлюд
	|	КОНЕЦ", "ЕстьNULL(втМаксВыпуски.МаксВыпуск, ЗНАЧЕНИЕ(Документ.питВыпускБлюд.ПустаяСсылка))")+" КАК ВыпускБлюд,
	|	втРезультат.Упаковка КАК Упаковка,
	|	втРезультат.КоличествоНужноВсего КАК КоличествоНужноВсего,
	|	втРезультат.КоличествоНужноПоПМ КАК КоличествоНужноПоПМ,
	|	втРезультат.КоличествоМожноПриготовить КАК КоличествоМожноПриготовить,
	|	втРезультат.КоличествоУпаковокМожноПриготовить КАК КоличествоУпаковокМожноПриготовить
	|ИЗ
	|	втРезультат КАК втРезультат
	|		ЛЕВОЕ СОЕДИНЕНИЕ втМаксВыпуски КАК втМаксВыпуски
	|		ПО (втРезультат.ПланМеню = втМаксВыпуски.ПланМеню)";
	
	Запрос.УстановитьПараметр("Склад", МестоПроизводства);
	Запрос.УстановитьПараметр("НаДату", КонецДня(ВыбраннаяДата)); // ДатаПроизводства
	Запрос.УстановитьПараметр("ДатаПроизводства", ВыбраннаяДата);
	Запрос.УстановитьПараметр("Статус", Перечисления.питСтатусыПлановМеню.КПроизводству);
	
	ТаблицаПроизводстваНеСгруппированная = Запрос.Выполнить().Выгрузить();
	// +питПриоритетыПриготовления
	ТаблицаПроизводстваНеСгруппированная = питПриоритетыПриготовления.СортироватьТаблицуПоПриоритетуПриготовленияСУчетомСвязанныхПланов(ТаблицаПроизводстваНеСгруппированная, МестоПроизводства, Истина);
	// -питПриоритетыПриготовления
	
	// +питСтатусыПриготовления
	ТаблицаПроизводстваНеСгруппированная = Обработки.питАРМПроизводства.ЗаполнитьГотовностьКПриготовлению(ТаблицаПроизводстваНеСгруппированная, МестоПроизводства);
	// -питСтатусыПриготовления
	
	// Перевод сортированной таблицы в дерево.
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ втТаблицаПроизводства ИЗ &ТаблицаПроизводстваНеСгруппированная КАК ТаблицаПроизводстваНеСгруппированная;
	|ВЫБРАТЬ
	|	втТаблицаПроизводства.ПланМеню КАК ПланМеню,
	|	втТаблицаПроизводства.СкладРеализации КАК СкладРеализации,
	|	втТаблицаПроизводства.Номенклатура КАК Номенклатура,
	|	втТаблицаПроизводства.Характеристика КАК Характеристика,
	|	втТаблицаПроизводства.Рецептура КАК Рецептура,
	|	втТаблицаПроизводства.КоличествоПроизвели КАК КоличествоПроизвели,
	|	втТаблицаПроизводства.ВыпускБлюд КАК ВыпускБлюд,
	|	втТаблицаПроизводства.Упаковка КАК Упаковка,
	|	втТаблицаПроизводства.КоличествоНужноВсего КАК КоличествоНужноВсего,
	|	втТаблицаПроизводства.КоличествоНужноПоПМ КАК КоличествоНужноПоПМ,
	|	втТаблицаПроизводства.КоличествоМожноПриготовить КАК КоличествоМожноПриготовить,
	|	втТаблицаПроизводства.КоличествоУпаковокМожноПриготовить КАК КоличествоУпаковокМожноПриготовить,
	|	ВЫБОР КОГДА втТаблицаПроизводства.КоличествоПроизвели >= втТаблицаПроизводства.КоличествоНужноПоПМ ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК ПолеСортировки
	|ИЗ
	|	втТаблицаПроизводства КАК втТаблицаПроизводства
	|УПОРЯДОЧИТЬ ПО
	|	ПолеСортировки,
	|	ДатаПланБлюда,
	|	ПриоритетБлюдаПустойСклад,
	|	ПриоритетБлюда,
	|	ДатаПлан,
	|	ПриоритетПустойСклад,
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(СкладРеализации),
	|	МАКСИМУМ(Рецептура),
	|"+ ?(НЕ Объект.УчитыватьОстаткиНаСкладе, "	СУММА(КоличествоПроизвели)","	МАКСИМУМ(КоличествоПроизвели)")+",
	|	СУММА(КоличествоМожноПриготовить),
	|	СУММА(КоличествоУпаковокМожноПриготовить),
	|	МАКСИМУМ(Упаковка),
	|	МАКСИМУМ(КоличествоНужноВсего),
	|	МАКСИМУМ(КоличествоНужноПоПМ)
	|ПО
	|	Номенклатура,
	|	Характеристика,
	|	ПланМеню";
	Запрос.УстановитьПараметр("ТаблицаПроизводстваНеСгруппированная", ТаблицаПроизводстваНеСгруппированная);
	
	ВыборкаДеревоУровеньНом = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДеревоУровеньНом.Следующий() Цикл
				
		ВыборкаУрХарактеристики = ВыборкаДеревоУровеньНом.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаУрХарактеристики.Следующий() Цикл
			
			НовыйКлюч = Новый УникальныйИдентификатор();
			
			НСтрокаДерева = ДеревоПроизводства.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НСтрокаДерева, ВыборкаУрХарактеристики);
			
			// подсчитаем количество в упаковках
			ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(НСтрокаДерева.Номенклатура,НСтрокаДерева.Упаковка);
			
			НСтрокаДерева.КоличествоУпаковокНужноВсего 	= НСтрокаДерева.КоличествоНужноВсего / ТекКоэффициент;
			НСтрокаДерева.КоличествоУпаковокНужноПоПМ 	= НСтрокаДерева.КоличествоНужноПоПМ / ТекКоэффициент;
			НСтрокаДерева.КоличествоУпаковокПроизвели 	= НСтрокаДерева.КоличествоПроизвели / ТекКоэффициент;
			
			НСтрокаДерева.КлючСвязи = НовыйКлюч;
			
			// с вехрнего уровня дерева заполняем видимую таблицу производства
			Если НЕ Объект.ОтображатьПриготовленные И НСтрокаДерева.КоличествоНужноВсего = НСтрокаДерева.КоличествоПроизвели Тогда 
				// не выводим такую строку
			Иначе
				НСтрока = ТаблицаПроизводства.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока, ВыборкаУрХарактеристики);
				
				Если ЗначениеЗаполнено(НСтрока.Рецептура) Тогда
					НСтрока.НадписьРецептура = "Рецептура";
				КонецЕсли;
				
				// требуется
				НСтрока.КоличествоУпИзготовить 	= НСтрокаДерева.КоличествоУпаковокНужноВсего;
				НСтрока.КоличествоИзготовить 	= НСтрокаДерева.КоличествоНужноВсего;
				
				// приготовили
				ПриготовилиУп 	= НСтрокаДерева.КоличествоУпаковокПроизвели;
				Приготовили 	= НСтрокаДерева.КоличествоПроизвели;
				
				// осталось
				НСтрока.КоличествоУпОсталось 	= НСтрока.КоличествоУпИзготовить - ПриготовилиУп;
				НСтрока.КоличествоОсталось 		= НСтрока.КоличествоИзготовить - Приготовили;
				
				// можно произвести
				НСтрока.КоличествоМожноПриготовить			= НСтрока.КоличествоМожноПриготовить;
				НСтрока.КоличествоУпаковокМожноПриготовить	= НСтрока.КоличествоУпаковокМожноПриготовить;
				
				НСтрока.КлючСвязи = НовыйКлюч;
			КонецЕсли;
			
			ВыборкаУРПланМеню = ВыборкаУрХарактеристики.выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаУРПланМеню.Следующий() Цикл
				
				НСтрокаДереваПМ = НСтрокаДерева.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НСтрокаДереваПМ, ВыборкаУРПланМеню);
				
				// подсчитаем количество в упаковках
				НСтрокаДереваПМ.КоличествоУпаковокНужноВсего 	= НСтрокаДереваПМ.КоличествоНужноВсего / ТекКоэффициент;
				НСтрокаДереваПМ.КоличествоУпаковокНужноПоПМ 	= НСтрокаДереваПМ.КоличествоНужноПоПМ / ТекКоэффициент;
				НСтрокаДереваПМ.КоличествоУпаковокПроизвели 	= НСтрокаДереваПМ.КоличествоПроизвели / ТекКоэффициент;
				
				ВыюоркаВыпуски = ВыборкаУРПланМеню.выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыюоркаВыпуски.Следующий() Цикл
					
					НСтрокаДереваВып = НСтрокаДереваПМ.ПолучитьЭлементы().Добавить();
					ЗаполнитьЗначенияСвойств(НСтрокаДереваВып, ВыюоркаВыпуски);
					
					// подсчитаем количество в упаковках
					НСтрокаДереваВып.КоличествоУпаковокНужноВсего 	= НСтрокаДереваВып.КоличествоНужноВсего / ТекКоэффициент;
					НСтрокаДереваВып.КоличествоУпаковокНужноПоПМ 	= НСтрокаДереваВып.КоличествоНужноПоПМ / ТекКоэффициент;
					НСтрокаДереваВып.КоличествоУпаковокПроизвели 	= НСтрокаДереваВып.КоличествоПроизвели / ТекКоэффициент;
					
				КонецЦикла;
				
			КонецЦикла;
					
		КонецЦикла;
		
	КонецЦикла;
КонецПроцедуры

//  Процедура - Провести документы на сервере.
//
&НаСервере
Процедура ПровестиДокументыНаСервере()
	
	Для каждого СтрокаСПрозведеннымиПФ Из ТаблицаПроизводства Цикл
		
		ПриготовилиУпПоСтроке = СтрокаСПрозведеннымиПФ.КоличествоУпПриготовлено;
		ОсталосьРаспределитьУп = Макс(ПриготовилиУпПоСтроке, -ПриготовилиУпПоСтроке);
		
		ПриготовилиПоСтроке = СтрокаСПрозведеннымиПФ.КоличествоПриготовлено;
		ОсталосьРаспределить = Макс(ПриготовилиПоСтроке, -ПриготовилиПоСтроке);
		
		ОтрицательноеРаспределение = (ПриготовилиУпПоСтроке < 0);
		
		Если Не ЗначениеЗаполнено(ПриготовилиПоСтроке) Тогда
			Продолжить;
		КонецЕсли;
		
		// ищем соотв строку в дереве
		КлючСвязи = СтрокаСПрозведеннымиПФ.КлючСвязи;
		
		ВерхнийУровеньДерева = ДеревоПроизводства.ПолучитьЭлементы();
		
		Для каждого СтрокаНомХаракт Из ВерхнийУровеньДерева Цикл
			
			Если СтрокаНомХаракт.КлючСвязи <> КлючСвязи Тогда
				Продолжить;
			КонецЕсли;
			
			// нашли
			СтрокиПланМеню = СтрокаНомХаракт.ПолучитьЭлементы();
			
			КоличествоПланов = СтрокиПланМеню.Количество();
			ТекущийНомерПлана = 1;
			
			Для каждого СтрокасДокомПМ Из СтрокиПланМеню Цикл
				
				Если ОсталосьРаспределить <=0 Тогда
					Продолжить;
				КонецЕсли;
				
				НужноУпаковокПоПланМеню = СтрокасДокомПМ.КоличествоУпаковокНужноПоПМ - СтрокасДокомПМ.КоличествоУпаковокПроизвели;
				НужноПоПланМеню = СтрокасДокомПМ.КоличествоНужноПоПМ - СтрокасДокомПМ.КоличествоПроизвели;
				
				Если КоличествоПланов = ТекущийНомерПлана Тогда
					ОбеспечимВЭтомПланМеню = ОсталосьРаспределить;
					ОбеспечимУпаковокВЭтомПланМеню = ОсталосьРаспределитьУп;
				Иначе	
					ОбеспечимВЭтомПланМеню = мин(НужноПоПланМеню, ОсталосьРаспределить);
					ОбеспечимУпаковокВЭтомПланМеню = мин(НужноУпаковокПоПланМеню, ОсталосьРаспределитьУп);
				КонецЕсли;
				
				Если ОбеспечимВЭтомПланМеню = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				УровеньВыпусков = СтрокасДокомПМ.ПолучитьЭлементы();
				
				ЭтоНовыйДок = Ложь;
				
				Если УровеньВыпусков.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(УровеньВыпусков[0].ВыпускБлюд) Тогда
					// создаем новый выпуск
					ДокументВыпуска = Документы.питВыпускБлюд.СоздатьДокумент();
					ДокументВыпуска.Заполнить(СтрокасДокомПМ.ПланМеню);
					ДокументВыпуска.Товары.Очистить();
					// ДокументВыпуска.
					ЭтоНовыйДок = Истина;
				Иначе
					// берем первый имеющийся
					ДокументВыпуска = УровеньВыпусков[0].ВыпускБлюд.ПолучитьОбъект();
				КонецЕсли;
				
				// корректируем товары
				ПарамОтбора = Новый Структура("Номенклатура, Характеристика", СтрокаСПрозведеннымиПФ.Номенклатура , СтрокаСПрозведеннымиПФ.Характеристика);
				НайдСтрокиСНом = ДокументВыпуска.Товары.НайтиСтроки(ПарамОтбора);
				Если НайдСтрокиСНом.Количество() = 0 Тогда
					КорректСтрока = ДокументВыпуска.Товары.Добавить();
					КорректСтрока.Номенклатура = СтрокаСПрозведеннымиПФ.Номенклатура;
					КорректСтрока.Характеристика = СтрокаСПрозведеннымиПФ.Характеристика;
					КорректСтрока.Упаковка = СтрокаСПрозведеннымиПФ.Упаковка;
					КорректСтрока.Рецептура = СтрокаСПрозведеннымиПФ.Рецептура;
					
					КорректСтрока.КоличествоУпаковок = ?(ОтрицательноеРаспределение, -ОбеспечимУпаковокВЭтомПланМеню, ОбеспечимУпаковокВЭтомПланМеню);
					КорректСтрока.Количество = ?(ОтрицательноеРаспределение, -ОбеспечимВЭтомПланМеню, ОбеспечимВЭтомПланМеню);;
				Иначе
					КорректСтрока = НайдСтрокиСНом[0];
					
					Если ЭтоНовыйДок Тогда
						// поскольку в новом перенесется полное количество в тч, мы его подправим
						КорректСтрока.КоличествоУпаковок = ?(ОтрицательноеРаспределение, -ОбеспечимУпаковокВЭтомПланМеню, ОбеспечимУпаковокВЭтомПланМеню);
						КорректСтрока.Количество = ?(ОтрицательноеРаспределение, -ОбеспечимВЭтомПланМеню, ОбеспечимВЭтомПланМеню);
					Иначе
						КорректСтрока.КоличествоУпаковок = КорректСтрока.КоличествоУпаковок + ?(ОтрицательноеРаспределение, -ОбеспечимУпаковокВЭтомПланМеню, ОбеспечимУпаковокВЭтомПланМеню);
						КорректСтрока.Количество = КорректСтрока.Количество + ?(ОтрицательноеРаспределение, -ОбеспечимВЭтомПланМеню, ОбеспечимВЭтомПланМеню);
					КонецЕсли;
				КонецЕсли;
				
				// КорректСтрока.КоличествоУпаковок = ОбеспечимУпаковокВЭтомПланМеню;
				// КорректСтрока.Количество = ОбеспечимВЭтомПланМеню;
				
				ВыпускПровелся = Истина;
				Попытка
					// +питПриоритетыПриготовления
					ДокументВыпуска.ДополнительныеСвойства.Вставить("питСортироватьПоПриоритетуПриготовления");
					// -питПриоритетыПриготовления
					ДокументВыпуска.Записать(РежимЗаписиДокумента.Проведение);
					ОбщегоНазначения.СообщитьПользователю("Сформирован/обновлен фактический документ <" + ДокументВыпуска + ">");
				Исключение
					ВыпускПровелся = Ложь;
					ОписаниеОшибкиПроведения = ОписаниеОшибки();
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Не удалось провести выпуск блюд по плану-меню <" + СтрокасДокомПМ.ПланМеню + ">, причина в сообщении выше.";
					Сообщение.Сообщить();
				КонецПопытки;
				
				Если ЭтоНовыйДок И ВыпускПровелся Тогда
					ЗаполнитьВыпускВПланахМеню(СтрокасДокомПМ.ПланМеню, ДокументВыпуска.Ссылка);
				КонецЕсли;
				
				ОсталосьРаспределить = ОсталосьРаспределить - ОбеспечимВЭтомПланМеню;
				ОсталосьРаспределитьУп = ОсталосьРаспределитьУп - ОбеспечимУпаковокВЭтомПланМеню;
				
				ТекущийНомерПлана = ТекущийНомерПлана + 1;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// перестроим таблицу
	
	ПостроитьТаблицуПроизводстваНаДату(ДатаПроизводства);

	
КонецПроцедуры

//  Функция - Заполнить выпуск в планах меню.
//
// Параметры:
//  ПланМеню - Произвольный - План меню.
//  ВыпускБлюд - Произвольный - Выпуск блюд.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЗаполнитьВыпускВПланахМеню(ПланМеню, ВыпускБлюд)
	
	ВерхнийУровеньДерева = ДеревоПроизводства.ПолучитьЭлементы();
	Для каждого СтрокаНомХаракт Из ВерхнийУровеньДерева Цикл
		СтрокиПланМеню = СтрокаНомХаракт.ПолучитьЭлементы();
		Для каждого СтрокасДокомПМ Из СтрокиПланМеню Цикл
			Если НЕ СтрокасДокомПМ.ПланМеню = ПланМеню Тогда
				Продолжить;
			КонецЕсли;
			
			УровеньВыпусков = СтрокасДокомПМ.ПолучитьЭлементы();
			ВыпускНайден = Ложь;
			Если УровеньВыпусков.Количество() = 1 И НЕ ЗначениеЗаполнено(УровеньВыпусков[0].ВыпускБлюд) Тогда
				УровеньВыпусков[0].ВыпускБлюд = ВыпускБлюд;
				ВыпускНайден = Истина;
			Иначе
				Для каждого СтрокаВыпусков Из УровеньВыпусков Цикл
					Если СтрокаВыпусков.ВыпускБлюд = ВыпускБлюд Тогда
						ВыпускНайден = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если НЕ ВыпускНайден Тогда
				НоваяСтрокаВыпусков = УровеньВыпусков.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаВыпусков, СтрокасДокомПМ);
				НоваяСтрокаВыпусков.ВыпускБлюд = ВыпускБлюд;
				НоваяСтрокаВыпусков.КоличествоУпаковокПроизвели 	= 0;
				НоваяСтрокаВыпусков.КоличествоПроизвели = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

//  Процедура - Построить таблицу производства на дату клиент.
//
&НаКлиенте
Процедура ПостроитьТаблицуПроизводстваНаДатуКлиент()
	Если ТаблицаПроизводства.Итог("КоличествоУпПриготовлено") = 0 Тогда
		ПостроитьТаблицуПроизводстваНаДату(ДатаПроизводства);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Надпись выбранная дата нажатие на сервере.
//
&НаСервере
Процедура НадписьВыбраннаяДатаНажатиеНаСервере()
	ПостроитьТаблицуПроизводстваНаДату(ДатаПроизводства);
	Элементы.НадписьВыбраннаяДата.Заголовок = ВернутьЗаголовокКнопкиДаты(ДатаПроизводства, истина);
	ОбновитьКнопкиДат();
КонецПроцедуры


