
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Если НЕ МобильныйКлиент Тогда
		Элементы.УчитыватьОстаткиНаСкладе.ВидФлажка = ВидФлажка.Выключатель;
		Элементы.ОтображатьПриготовленные.ВидФлажка = ВидФлажка.Выключатель;
		Элементы.ОтображатьКолонкуИзготовить.ВидФлажка = ВидФлажка.Выключатель;
		Элементы.ОтображатьКолонкуНаправление.ВидФлажка = ВидФлажка.Выключатель;
		Элементы.ОтображатьКолонкуОсталось.ВидФлажка = ВидФлажка.Выключатель;
		Элементы.ОтображатьКолонкуРецептура.ВидФлажка = ВидФлажка.Выключатель;
	#КонецЕсли
	
	Параметры.Свойство("УчитыватьОстаткиНаСкладе", Объект.УчитыватьОстаткиНаСкладе);
	Параметры.Свойство("ОтображатьПриготовленные", Объект.ОтображатьПриготовленные);
	Параметры.Свойство("ОтображатьКолонкуИзготовить", Объект.ОтображатьКолонкуИзготовить);
	Параметры.Свойство("ОтображатьКолонкуНаправление", Объект.ОтображатьКолонкуНаправление);
	Параметры.Свойство("ОтображатьКолонкуОсталось", Объект.ОтображатьКолонкуОсталось);
	Параметры.Свойство("ОтображатьКолонкуРецептура", Объект.ОтображатьКолонкуРецептура);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрименитьНастройки(Команда)
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("УчитыватьОстаткиНаСкладе", Объект.УчитыватьОстаткиНаСкладе);
	СтруктураНастроек.Вставить("ОтображатьПриготовленные", Объект.ОтображатьПриготовленные);
	СтруктураНастроек.Вставить("ОтображатьКолонкуИзготовить", Объект.ОтображатьКолонкуИзготовить);
	СтруктураНастроек.Вставить("ОтображатьКолонкуНаправление", Объект.ОтображатьКолонкуНаправление);
	СтруктураНастроек.Вставить("ОтображатьКолонкуОсталось", Объект.ОтображатьКолонкуОсталось);
	СтруктураНастроек.Вставить("ОтображатьКолонкуРецептура", Объект.ОтображатьКолонкуРецептура);
	
	Закрыть(СтруктураНастроек);
	
КонецПроцедуры

#КонецОбласти
