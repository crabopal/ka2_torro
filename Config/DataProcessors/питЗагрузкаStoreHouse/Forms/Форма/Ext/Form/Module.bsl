//  Процедура - Показать только незаполненную номенклатуру.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПоказатьТолькоНезаполненнуюНоменклатуру(Команда)
	Элементы.ПоказатьТолькоНезаполненнуюНоменклатуру.Пометка = Не Элементы.ПоказатьТолькоНезаполненнуюНоменклатуру.Пометка;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияНоменклатура.Отбор,"Ссылка1С",ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"),ВидСравненияКомпоновкиДанных.Равно,,Элементы.ПоказатьТолькоНезаполненнуюНоменклатуру.Пометка,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
