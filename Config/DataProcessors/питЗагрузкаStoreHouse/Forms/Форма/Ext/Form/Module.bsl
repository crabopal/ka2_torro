//  Процедура - Выбор команды подключения.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВыборКомандыПодключения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Значение = "Открыть" Тогда
		ОткрытьФорму("Справочник.питУчетныеЗаписиStoreHouse.ФормаОбъекта", Новый Структура("Ключ",Объект.УчетнаяЗапись),ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ПриИзмененииУчетнойЗаписи", ЭтотОбъект));	
	ИначеЕсли Результат.Значение = "Выбрать" Тогда
		ОткрытьФорму("Справочник.питУчетныеЗаписиStoreHouse.ФормаВыбора", Новый Структура("РежимВыбора", Истина),ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ПриВыбореУчетнойЗаписи", ЭтотОбъект));	
	КонецЕсли;
КонецПроцедуры

//  Процедура - При изменении учетной записи.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПриИзмененииУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	ПриИзмененииУчетнойЗаписиНаСервере();
КонецПроцедуры

//  Процедура - Обработчик после создания учетной записи.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработчикПослеСозданияУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	Объект.УчетнаяЗапись = ПолучитьНовуюУчетнуюЗапись();
	
	// Объект.УчетнаяЗапись = Результат;
	ПриИзмененииУчетнойЗаписиНаСервере();
КонецПроцедуры

//  Процедура - При выборе учетной записи.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПриВыбореУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	Объект.УчетнаяЗапись = Результат;
	ПриВыбореУчетнойЗаписиНаСервере();
КонецПроцедуры

//  Процедура - При выборе учетной записи на сервере.
//
Процедура ПриВыбореУчетнойЗаписиНаСервере() Экспорт
	// Подготовим данные для работы с корректным нам источником.
	СтарыйФорматОбмена = Объект.ФорматОбмена;
	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Объект.ФорматОбмена = Объект.УчетнаяЗапись.ФорматОбмена;
	КонецЕсли;
	
	Обработки.питЗагрузкаStoreHouse.ОтключитьсяОтВнешнегоИсточникаДанных(СтарыйФорматОбмена);
	Обработки.питЗагрузкаStoreHouse.ПодключитьсяКВнешнемуИсточникуДанных(Объект.УчетнаяЗапись);
	
	ИндикацияПараметровПодключения(Объект.УчетнаяЗапись);
КонецПроцедуры

//  Процедура - Параметры загрузки служебный каталог начало выбора завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	текСтрока = ДополнительныеПараметры.текСтрока;
	Если Результат <> Неопределено Тогда
		текДанные = Объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
		текДанные.СлужебныйКаталог = Результат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	Запрос = НОвый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	питУчетныеЗаписиStoreHouse.Сервер,
	|	питУчетныеЗаписиStoreHouse.База,
	|	питУчетныеЗаписиStoreHouse.НачалоУчета,
	|	питУчетныеЗаписиStoreHouse.Ссылка,
	|	питУчетныеЗаписиStoreHouse.ФорматОбмена
	|ИЗ
	|	Справочник.питУчетныеЗаписиStoreHouse КАК питУчетныеЗаписиStoreHouse
	|ГДЕ
	|	НЕ питУчетныеЗаписиStoreHouse.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СерверRK = Выборка.Сервер;
		БазаRK = Выборка.База;
		
		Объект.УчетнаяЗапись = Выборка.Ссылка;
		Объект.ФорматОбмена = Выборка.ФорматОбмена;
	КонецЕсли;
	
	// Если (ЗначениеЗаполнено(СерверRK) И ЗначениеЗаполнено(БазаRK)) Тогда
	// 	Обработки.питЗагрузкаStoreHouse.ПодключитьсяКВнешнемуИсточникуДанных(Объект.УчетнаяЗапись);
	// КонецЕсли;
	
	// Вычислим имя внешнего источника
	Если Объект.ФорматОбмена = 1 Тогда
		ИмяИсточника = "питStoreHouse4";
	Иначе
		ИмяИсточника = "питStoreHouse";
	КонецЕсли;
	
	
	// отборы
	УстановитьОтборыСоответствий();
	Обработки.питЗагрузкаStoreHouse.ИнициализацияПараметровЗагрузки(Объект.ПараметрыЗагрузки);
	ПараметрыЗагрузкиИзменены = Ложь;
	
	// инициализация
	Инициализация();
	
	ИндикацияПараметровПодключения(Объект.УчетнаяЗапись);
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) И (Элементы.Подключение.Заголовок = "Подключение не настроено" Или Элементы.Подключение.Заголовок = "Подключение не установлено" Или Элементы.Подключение.Заголовок = "Подключение: ....") Тогда
		ПараметрыФормы = Новый Структура("Ключ", Объект.УчетнаяЗапись);
		Оповещение = Новый ОписаниеОповещения("ОбработчикПослеСозданияУчетнойЗаписи", ЭтотОбъект);
		ОткрытьФорму("Справочник.питУчетныеЗаписиStoreHouse.ФормаОбъекта",ПараметрыФормы,ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
//   ПоказатьВопрос(Оповещение, "Обнаружен первый запуск обмена. Открыть настройку учетной записи?", 
// РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет, "ВНИМАНИЕ!");.
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

//  Процедура - Подключение нажатие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПодключениеНажатие(Элемент)
	Если Объект.УчетнаяЗапись.Пустая() Тогда
		ОткрытьФорму("Справочник.питУчетныеЗаписиStoreHouse.ФормаВыбора", Новый Структура("РежимВыбора", Истина),ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ПриВыбореУчетнойЗаписи", ЭтотОбъект));	
	Иначе
		СписокКоманд = Новый СписокЗначений;
		СписокКоманд.Добавить("Открыть", "Открыть учетную запись для редактирования");
		СписокКоманд.Добавить("Выбрать", "Выбрать другую учетную запись");
		
		ПоказатьВыборИзМеню(Новый ОписаниеОповещения("ВыборКомандыПодключения", ЭтотОбъект),СписокКоманд, Элементы.Подключение);
	КонецЕсли;
КонецПроцедуры

