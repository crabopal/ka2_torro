//  Процедура - Загрузить рецептуры.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗагрузитьРецептуры(Команда)
	ТекстОшибки = "";
	Если НЕ ЗначениеЗаполнено(Объект.ДатаЗагрузкиРецептур) Тогда
		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки),"Не указана дата загрузки для подстановки в рецептуры.", Символы.ПС+"Не указана дата загрузки для подстановки в рецептуры.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ОрганизацияДляЗагрузки) Тогда
		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки),"Не указана организация для подстановки в рецептуры.", Символы.ПС+"Не указана организация для подстановки в рецептуры.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.СтатьяКалькуляции) Тогда
		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки),"Не указана статья калькуляции для подстановки в рецептуры.", Символы.ПС+"Не указана статья калькуляции для подстановки в рецептуры.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ПодразделениеЗагрузки) Тогда
		ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки),"Не указано подразделение для подстановки в рецептуры.", Символы.ПС+"Не указано подразделение для подстановки в рецептуры.");
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	МассивСозданныхДокументов = ЗагрузитьРецептурыСервер();
	Если Объект.ВыводитьОтчет И МассивСозданныхДокументов.Количество() > 0 Тогда
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("МассивДокументов", МассивСозданныхДокументов);
		ПараметрыПечати.Вставить("ПрерываниеЗагрузки", Ложь);
		
		Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
			МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
			МодульУправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.питЗагрузкаStoreHouse", "РезультатРаботы", 
				МассивСозданныхДокументов, ЭтотОбъект, ПараметрыПечати);
		КонецЕсли;
	КонецЕсли;
	Элементы.СоответствияРецептуры.Обновить();
КонецПроцедуры

