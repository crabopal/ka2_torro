// Установка соответствия для элементов
//
// Параметры:
//  Режим - Произвольный - Режим.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  ИспользоватьИерархию - Произвольный - Использовать иерархию.
//
&НаСервере
Процедура ПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ИспользоватьИерархию = Ложь)
	Если ИмяМетаданных = "Номенклатура" И НЕ ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнен вид номенклатуры для загрузки номенклатуры.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	// Предупредим, если нечеткий поиск и не актуальный индекс
	Если Режим = 2 И Не ПолнотекстовыйПоиск.ИндексАктуален() Тогда
		ПолнотекстовыйПоиск.ОбновитьИндекс();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поисковый индекс обновлен.");
	КонецЕсли;
	
	ОтборСоответствий = ЭтотОбъект["Соответствия"+ИмяМетаданных].Отбор;
	Ошибки = Неопределено;
	питStoreHouse.ПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ОтборСоответствий, ИспользоватьИерархию, Объект.ПроцентСовпаденияСоответствия, Объект.СоздаватьОбъектыПриЗаполненииСоответствий, Ошибки, Объект.ВидНоменклатуры, Объект.ФорматОбмена, Объект.ЗагружатьИерархиюНоменклатуры, Объект.ВесовыеИОбъемные.Выгрузить());
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	Элементы["Соответствия"+ИмяМетаданных].Обновить();
КонецПроцедуры

