//  Функция - Получить имя метаданных строки параметров.
//
// Параметры:
//  текСтрока - Строка - тек строка.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
Функция ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока)
	текДанные = объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
	
	ЕстьИерархия = Ложь;
	ТипЗначения = текДанные.ТипОбъекта.ТипЗначения;
	Для Каждого Тип Из ТипЗначения.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если МетаданныеТипа.Иерархический Тогда
			Если МетаданныеТипа.Имя = "СтруктураПредприятия" Тогда
				Прервать; //Отключена иерархия
			Иначе
				ЕстьИерархия = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьИерархия Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МетаданныеТипа.Имя;
КонецФункции

//  Процедура - Сохранить параметры загрузки на сервере.
//
&НаСервере
Процедура СохранитьПараметрыЗагрузкиНаСервере()
	Для Каждого СтрокаТипа Из Объект.ПараметрыЗагрузки Цикл
		ТипОбъектаОбъект = СтрокаТипа.ТипОбъекта.ПолучитьОбъект();
		ТипОбъектаОбъект.Обновлять = СтрокаТипа.Обновлять;
		ТипОбъектаОбъект.Создавать = СтрокаТипа.Создавать;
		ТипОбъектаОбъект.СлужебныйКаталог = СтрокаТипа.СлужебныйКаталог;
		ТипОбъектаОбъект.ОбработкаОшибок = СтрокаТипа.ОбработкаОшибок;
		
		Попытка
			ТипОбъектаОбъект.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

//  Функция - Загрузить рецептуры сервер.
//
// Параметры:
//  Грузить - Произвольный - Грузить.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЗагрузитьРецептурыСервер(Грузить = Истина)
	ЕстьНезаполненные = ЕстьНезаполненныеСоответствия();
	Если ЕстьНезаполненные Тогда
		Если Объект.ПроверятьЗаполненностьСоответствий Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Перед загрузкой необходимо установить соответствия номенклатуры и структуры предприятия.";
			Сообщение.Сообщить();
			Возврат Новый Массив;
		Иначе
			Объект.СоздаватьОбъектыПриЗаполненииСоответствий = Истина;
			ПолучитьВсюНоменклатуруНаСервере();
			ПроставитьСоответствияЭлементов(1,"Номенклатура");
			ПолучитьВсеПодразделенияНаСервере();
			ПроставитьСоответствияЭлементов(1,"СтруктураПредприятия", Истина);
		КонецЕсли;
	КонецЕсли;
	
	// Вычислим имя внешнего источника
	Если Объект.ФорматОбмена = 1 Тогда
		ИмяИсточника = "питStoreHouse4";
	Иначе
		ИмяИсточника = "питStoreHouse";
	КонецЕсли;

	
	// Загрузим основные рецептуры
	Таблица = Обработки.питЗагрузкаStoreHouse.ПолучитьНоменклатуруСРецептурами(ИмяИсточника);
	СписокОсновныхРецептур = Обработки.питЗагрузкаStoreHouse.ЗагрузитьРецептурыНаСервере(Таблица, Объект.ОрганизацияДляЗагрузки, Объект.СтатьяКалькуляции, Объект.ПодразделениеЗагрузки, Объект.СкладЗагрузки, Объект.ДатаЗагрузкиРецептур, Истина, Грузить, ИмяИсточника, Объект.ВесовыеИОбъемные.Выгрузить());
	// Загрузим рецептуры по подразделениям
	Соответствие	= Обработки.питЗагрузкаStoreHouse.ПолучитьСоответствияGODECM(ИмяИсточника);
	СписокРецептурПоПодразделениям = Обработки.питЗагрузкаStoreHouse.ЗагрузитьРецептурыНаСервере(Соответствие, Объект.ОрганизацияДляЗагрузки, Объект.СтатьяКалькуляции, Объект.ПодразделениеЗагрузки, Объект.СкладЗагрузки, Объект.ДатаЗагрузкиРецептур, Ложь, Грузить, ИмяИсточника, Объект.ВесовыеИОбъемные.Выгрузить());
		
	Если Грузить Тогда
		// Заполним состав
		Для Каждого стр Из СписокОсновныхРецептур Цикл 
			СоставРецептуры	= Обработки.питЗагрузкаStoreHouse.ПолучитьСоставКомплекта(стр.стрРецRID, ИмяИсточника);
			Обработки.питЗагрузкаStoreHouse.ЗагрузитьРецептуру_Состав(стр.СсылкаРецептуры, СоставРецептуры,ИмяИсточника);
		КонецЦикла;
		
		Для Каждого Стр Из СписокРецептурПоПодразделениям Цикл
			СоставРецептуры	= Обработки.питЗагрузкаStoreHouse.ПолучитьСоставКомплекта(стр.стрРецRID, ИмяИсточника);
			Обработки.питЗагрузкаStoreHouse.ЗагрузитьРецептуру_Состав(стр.СсылкаРецептуры, СоставРецептуры,ИмяИсточника);
			НовСтр = СписокОсновныхРецептур.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		КонецЦикла;
	КонецЕсли;

	Возврат СписокОсновныхРецептур.ВыгрузитьКолонку("СсылкаРецептуры");
КонецФункции

//  Функция - Есть незаполненные соответствия.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЕстьНезаполненныеСоответствия()
	
	// Проверм на наличие хоть каких то соотвествий
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	питСоответствияОбъектовStoreHouse.Ссылка1С
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовStoreHouse КАК питСоответствияОбъектовStoreHouse";
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Истина;
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	питСоответствияОбъектовStoreHouse.Ссылка1С,
		               |	питСоответствияОбъектовStoreHouse.ТипОбъекта
		               |ИЗ
		               |	РегистрСведений.питСоответствияОбъектовStoreHouse КАК питСоответствияОбъектовStoreHouse
		               |ГДЕ
		               |	(питСоответствияОбъектовStoreHouse.Ссылка1С = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		               |			ИЛИ питСоответствияОбъектовStoreHouse.Ссылка1С = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
		               |	И питСоответствияОбъектовStoreHouse.ТипОбъекта <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.питТипыОбъектовStoreHouse.Рецептура)
		               |	И питСоответствияОбъектовStoreHouse.ТипОбъекта <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.питТипыОбъектовStoreHouse.Контрагенты)
		               |	И питСоответствияОбъектовStoreHouse.ТипОбъекта <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.питТипыОбъектовStoreHouse.СтруктураПредприятия)";
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
КонецФункции

//  Процедура - Получить настройки на сервере.
//
&НаСервере
Процедура ПолучитьНастройкиНаСервере()
	Объект.ВидНоменклатуры = Объект.УчетнаяЗапись.ВидНоменклатуры;
	Объект.СкладЗагрузки = Объект.УчетнаяЗапись.СкладЗагрузки;
	Объект.ДатаЗагрузкиРецептур = Объект.УчетнаяЗапись.ДатаЗагрузкиРецептур;
	Объект.ПодразделениеЗагрузки = Объект.УчетнаяЗапись.ПодразделениеЗагрузки;
	Объект.СтатьяКалькуляции = Объект.УчетнаяЗапись.СтатьяКалькуляции;
	Объект.ОрганизацияДляЗагрузки = Объект.УчетнаяЗапись.ОрганизацияДляЗагрузки;
	Объект.ПроверятьЗаполненностьСоответствий = Объект.УчетнаяЗапись.ПроверятьЗаполненностьСоответствий;
	Объект.ЗагружатьИерархиюНоменклатуры = Объект.УчетнаяЗапись.ЗагружатьИерархиюНоменклатуры;
	
	ТЧПараметрыЗагрузки = Объект.УчетнаяЗапись.ПараметрыЗагрузки;
	
	Объект.ПараметрыЗагрузки.Очистить();
	Для Каждого ТекСтрока Из ТЧПараметрыЗагрузки Цикл
		НоваяСтрока = Объект.ПараметрыЗагрузки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
КонецПроцедуры

//  Процедура - Сохранить настройки на сервере.
//
&НаСервере
Процедура СохранитьНастройкиНаСервере()
	Попытка
		
		ОбъектУчетнаяЗапись = Объект.УчетнаяЗапись.ПолучитьОбъект();
		ОбъектУчетнаяЗапись.ВидНоменклатуры = Объект.ВидНоменклатуры;
		ОбъектУчетнаяЗапись.СкладЗагрузки = Объект.СкладЗагрузки;
		ОбъектУчетнаяЗапись.ДатаЗагрузкиРецептур = Объект.ДатаЗагрузкиРецептур;
		ОбъектУчетнаяЗапись.ПодразделениеЗагрузки = Объект.ПодразделениеЗагрузки;
		ОбъектУчетнаяЗапись.СтатьяКалькуляции = Объект.СтатьяКалькуляции;
		ОбъектУчетнаяЗапись.ОрганизацияДляЗагрузки = Объект.ОрганизацияДляЗагрузки;
		ОбъектУчетнаяЗапись.ПроверятьЗаполненностьСоответствий = Объект.ПроверятьЗаполненностьСоответствий;
		ОбъектУчетнаяЗапись.ЗагружатьИерархиюНоменклатуры = Объект.ЗагружатьИерархиюНоменклатуры;
		ТЧПараметрыЗагрузки = Объект.ПараметрыЗагрузки;
		ОбъектУчетнаяЗапись.ПараметрыЗагрузки.Очистить();
		Для Каждого ТекСтрока Из ТЧПараметрыЗагрузки Цикл
			НоваяСтрока = ОбъектУчетнаяЗапись.ПараметрыЗагрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		ОбъектУчетнаяЗапись.Записать();
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""СохранитьНастройкиНаСервере"": " + ТекстОшибки;
		Событие = "питЗагрузкаStoreHouse";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

