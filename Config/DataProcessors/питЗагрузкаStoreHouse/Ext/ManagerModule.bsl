// Функция - Проверить наличие рецептуры.
//
// Параметры:
//  RID - Произвольный - Rid.
//  ИмяИсточника - Строка - Имя источника.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПроверитьНаличиеРецептуры(RID, ИмяИсточника = "питStoreHouse")
	// Смотрим основные
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ  ПЕРВЫЕ 1
	|	GOODS.RID КАК CODE,
	|	GOODS.GOODSTREE_REF,
	|	GOODS.NAME,
	|	GOODS.USE_COMP,
	|	GOODS.CMBASE_REF
	|ИЗ
	|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_GOODS КАК GOODS
	|ГДЕ
	|	GOODS.RID = &RID И
	|	НЕ GOODS.CMBASE_REF ЕСТЬ NULL";
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
	Запрос.УстановитьПараметр("RID", RID);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	Иначе
		// Смотрим по подразделениям
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	DEP_GOODSPARAMS.GOODS_REF AS CODE,
		|	DEP_GOODSPARAMS.DEPART_REF,
		|	DEP_GOODSPARAMS.CMBASE_REF,
		|	DEP_GOODSPARAMS.WOTAX_OUT
		|ИЗ
		|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_DEP_GOODSPARAMS КАК DEP_GOODSPARAMS
		|ГДЕ
		|	DEP_GOODSPARAMS.GOODS_REF.RID = &RID И
		|	НЕ DEP_GOODSPARAMS.CMBASE_REF ЕСТЬ NULL";
		Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
КонецФункции

// КОНЕЦ БЛОКА РЕЦЕПТУР


// Функция - Получить номенклатуру по двум таблицам.
//
// Параметры:
//  ФорматОбмена - Произвольный - Формат обмена.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьНоменклатуруПоДвумТаблицам(ФорматОбмена)
	Если ФорматОбмена = 1 Тогда
		ИсточникДанных= ВнешниеИсточникиДанных.питStoreHouse4;
		ИмяИсточника = "питStoreHouse4";
	Иначе
		ИмяИсточника = "питStoreHouse";
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse;
	КонецЕсли;
	
	Если ИсточникДанных.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Отключен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Отсутствует подключение к базе данных StoreHouse HeadOffice.");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПРЕДСТАВЛЕНИЕ(CMBASEDOUBLE.CODE) КАК CODE,
	               |	ПРЕДСТАВЛЕНИЕ(CMBASEDOUBLE.SIFR) КАК SIFR,
	               |	CMBASEDOUBLE.NAME КАК NAME,
	               |	CMBASEDOUBLE.PARENT КАК PARENT
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		CMBASEMINUSGOODS.CODE КАК CODE,
	               |		CMBASEMINUSGOODS.SIFR КАК SIFR,
	               |		CMBASEMINUSGOODS.NAME КАК NAME,
	               |		CMBASEMINUSGOODS.PARENT КАК PARENT
	               |	ИЗ
	               |		(ВЫБРАТЬ
	               |			dbo_CMBASE.RID КАК CODE,
	               |			dbo_CMBASE.RID КАК SIFR,
	               |			dbo_CMBASE.NAME КАК NAME,
	               |			dbo_CMBASE.CMTREE_REF КАК PARENT
	               |		ИЗ
	               |			ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_CMBASE КАК dbo_CMBASE
	               |				ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_GOODS КАК dbo_GOODS
	               |				ПО (dbo_GOODS.CMBASE_REF = dbo_CMBASE.Ссылка)
	               |		ГДЕ
	               |			dbo_GOODS.CMBASE_REF ЕСТЬ NULL) КАК CMBASEMINUSGOODS
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_DEP_GOODSPARAMS КАК dbo_DEP_GOODSPARAMS
	               |			ПО CMBASEMINUSGOODS.CODE = dbo_DEP_GOODSPARAMS.CMBASE_REF.RID
	               |	ГДЕ
	               |		dbo_DEP_GOODSPARAMS.CMBASE_REF ЕСТЬ NULL) КАК CMBASEDOUBLE
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	dbo_GOODS.RID,
	               |	dbo_GOODS.RID,
	               |	dbo_GOODS.NAME,
	               |	dbo_GOODS.GOODSTREE_REF
	               |ИЗ
	               |	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_GOODS КАК dbo_GOODS";



	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%ИмяИсточника%",ИмяИсточника);
	ТаблицаВыгрузки = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаВыгрузки;
	
КонецФункции

// Функция - Найти создать еи.
//
// Параметры:
//  СтрокаЕИ - Строка - Строка еи.
//  Владелец - Произвольный - Владелец.
//  Базовая - Произвольный - Базовая.
//  Весовая - Произвольный - Весовая.
//  Объемная - Произвольный - Объемная.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиСоздатьЕИ(СтрокаЕИ, Владелец, Базовая = Ложь, Весовая = Ложь, Объемная = Ложь)
	
	// У базовых единиц владелец всегда предопределенный элемент "Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения".
	Если Базовая Тогда
		ЕдиИзмСсылка = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СтрокаЕИ.NAME, Истина,, Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	Иначе
		ЕдиИзмСсылка = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СтрокаЕИ.NAME, Истина,, Владелец.Ссылка);
	КонецЕсли;
	
	Если ЕдиИзмСсылка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() Тогда
		ЕдИзм = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
		ЕдИзм.УстановитьНовыйКод("SH");
		ЕдИзм.Наименование = СтрокаЕИ.NAME;
		
		// У базовых единиц владелец всегда предопределенный элемент "Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения".
		Если Базовая Тогда
			ЕдИзм.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
		Иначе
			ЕдИзм.Владелец = Владелец.Ссылка;
		КонецЕсли;
		
		Если НЕ СтрокаЕИ.BASED Тогда
			ЕдИзм.ЕдиницаИзмерения = Владелец.ЕдиницаИзмерения; //Относительно неё ставим коэфф
		КонецЕсли;
		ЕдИзм.Числитель		= СтрокаЕИ.CF;
		ЕдИзм.Знаменатель	= 1;
		
		// Базовая(!) ЕИ может быть весовой или объемной, иначе это количество штук;
		// НЕ Базовая(!) ЕИ может быть только "Упаковка".
		Если Базовая Тогда
			Если Весовая Тогда
				ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес;
			ИначеЕсли Объемная Тогда
				ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Объем;
			Иначе
				ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
			КонецЕсли;
		Иначе
			ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Упаковка;
		КонецЕсли;
		
		ЕдИзм.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная;
		ЕдИзм.ОбменДанными.Загрузка = Истина;
		Справочники.УпаковкиЕдиницыИзмерения.ОтработатьЛогикуСвязиРеквизитов(ЕдИзм);
		ЕдИзм.Записать();
		ЕдиИзмСсылка = ЕдИзм.Ссылка;
	КонецЕсли;
	Возврат ЕдиИзмСсылка;
КонецФункции

#КонецОбласти

#КонецЕсли
