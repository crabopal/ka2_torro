// Функция - Найти группу по наименованию.
//
// Параметры:
//  Наименование - Произвольный - Наименование.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиГруппуПоНаименованию(Наименование) Экспорт
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Номенклатура.Ссылка
		               |ИЗ
		               |	Справочник.Номенклатура КАК Номенклатура
		               |ГДЕ
		               |	Номенклатура.ЭтоГруппа
		               |	И Номенклатура.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", Наименование);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		Иначе 
			Возврат Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
КонецФункции

// Функция - Создать объект соответствия.
//
// Параметры:
//  Соответствие - Соответствие - Соответствие.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  РодительЭлемента - Произвольный - Родитель элемента.
//  ВидНоменклатуры - Произвольный - Вид номенклатуры.
//  ИмяИсточника - Произвольный - Имя источника.
//  ВесовыеИОбъемные - Произвольный - Весовые и объемные.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьОбъектСоответствия(Соответствие, ИмяМетаданных, РодительЭлемента, ВидНоменклатуры, ИмяИсточника, ВесовыеИОбъемные = Неопределено) Экспорт

	СправочникОбъект = Справочники[ИмяМетаданных].НайтиПоНаименованию(Соответствие.ИмяStoreHouse);
	Если НЕ СправочникОбъект.Пустая() И СправочникОбъект.ПометкаУдаления Тогда
		СправочникОбъект = СправочникОбъект.ПолучитьОбъект();
		СправочникОбъект.Наименование = СправочникОбъект.Наименование + " (удаленный)";
		Попытка
			СправочникОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если ИмяМетаданных = "Контрагенты" И ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровКакКонтрагентов") Тогда
		СправочникОбъект = Справочники["Партнеры"].СоздатьЭлемент();
	Иначе
		СправочникОбъект = Справочники[ИмяМетаданных].СоздатьЭлемент();
	КонецЕсли;
	СправочникОбъект.Наименование = Соответствие.ИмяStoreHouse;
	СправочникОбъект.УстановитьНовыйКод("SH");
	Настройки = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
	Если Метаданные.Справочники[ИмяМетаданных].Иерархический Тогда
		Если ИмяМетаданных = "Номенклатура" Тогда //Для номенклатуры создаем иерархию
			Если НЕ ЗначениеЗаполнено(Соответствие.ИмяРодителяStoreHouse) Тогда
				Если ЗначениеЗаполнено(Настройки.СлужебныйКаталог) Тогда //Кидаем в служебный
					СправочникОбъект.Родитель = Настройки.СлужебныйКаталог;
				КонецЕсли;
			Иначе
				СправочникОбъект.Родитель = НайтиГруппуПоНаименованию(Соответствие.ИмяРодителяStoreHouse);
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Настройки.СлужебныйКаталог) Тогда
				СправочникОбъект.Родитель = Настройки.СлужебныйКаталог;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяМетаданных = "Номенклатура" Тогда
		ЕдиницыИзЗапроса = ПолучитьСписокЕИ(Соответствие.КодStoreHouse, ИмяИсточника);
		ЕдИзмБазовая = ЕдиницыИзЗапроса.Найти(1,"BASED");
		СвойстваОбъекта = Новый Структура;
		Если ЕдИзмБазовая <> Неопределено Тогда
			// Проверим есть ли у номенклатуры рецептура если нет то ставим товар
			ЕстьРецептура = ПроверитьНаличиеРецептуры(Соответствие.КодStoreHouse, ИмяИсточника);
			Если ЕстьРецептура Тогда
				СправочникОбъект.ВидНоменклатуры = ВидНоменклатуры;
			Иначе
				СправочникОбъект.ВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар;
				СвойстваОбъекта.Вставить("ВидНоменклатуры", Перечисления.питВидыНоменклатуры.Товар);
			КонецЕсли;
			СправочникОбъект.Записать();
			
//   Единица может быть весовая либо объемная. При ее создании это необходимо будет указать в реквизите
// "ТипИзмеряемойВеличины".
			СтрокаВНастройках = ВесовыеИОбъемные.Найти(ЕдИзмБазовая.NAME, "NAME");
			ТекВесовой = Ложь;
			ТекОбъемный = Ложь;
			Если СтрокаВНастройках.Весовой Тогда
				ТекВесовой = Истина;
			ИначеЕсли СтрокаВНастройках.Объемный Тогда
				ТекОбъемный = Истина;
			КонецЕсли;
			СвойстваОбъекта.Вставить("ЕдиницаИзмерения", НайтиСоздатьЕИ(ЕдИзмБазовая, СправочникОбъект.Ссылка, Истина, ТекВесовой, ТекОбъемный));
		КонецЕсли;
		
		Если ЕдиницыИзЗапроса.Количество()>1 Тогда
			ИспользоватьУпаковки = Истина;
			Для Каждого Единица Из ЕдиницыИзЗапроса Цикл
				СтрокаВНастройках = ВесовыеИОбъемные.Найти(Единица.NAME, "NAME");
				Если СтрокаВНастройках.Весовой Тогда
					ИспользоватьУпаковки = Ложь;
					Если СвойстваОбъекта.ЕдиницаИзмерения.Наименование = Единица.NAME Тогда
						СвойстваОбъекта.Вставить("Весовой", Истина);
					КонецЕсли;
					Прервать;
				ИначеЕсли СтрокаВНастройках.Объемный Тогда
					ИспользоватьУпаковки = Ложь;
					Если СвойстваОбъекта.ЕдиницаИзмерения.Наименование = Единица.NAME Тогда
						СвойстваОбъекта.Вставить("Объемный", Истина);
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			СвойстваОбъекта.Вставить("ИспользоватьУпаковки", ИспользоватьУпаковки);
		КонецЕсли;
		ПрочитатьОбъектНоменклатура(СправочникОбъект, СвойстваОбъекта, ВидНоменклатуры, ВесовыеИОбъемные);
	ИначеЕсли ИмяМетаданных = "Склады" Тогда
		ПрочитатьОбъектСкладыКомпании(СправочникОбъект, Новый Структура);
	ИначеЕсли ИмяМетаданных = "Контрагенты" Тогда
		ПрочитатьОбъектКонтрагенты(СправочникОбъект, Новый Структура);
	ИначеЕсли ИмяМетаданных = "СтруктураПредприятия" Тогда
		ПрочитатьОбъектПодразделения(СправочникОбъект, Новый Структура("Родитель", РодительЭлемента));
	КонецЕсли;
	ЕстьОшибка = Ложь;
	Попытка
		СправочникОбъект.Записать();
		Если ИмяМетаданных = "Номенклатура" Тогда
			НоменклатураПослеЗаписи(СправочникОбъект.Ссылка, Новый Структура(), Истина); //После записи можно создать ЕИ
		КонецЕсли;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Создан элемент <"+СправочникОбъект.Наименование+">";
		Сообщение.Сообщить();
	Исключение
		ЕстьОшибка = Истина;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "писаниеОшибки(";
		Сообщение.Сообщить();
	КонецПопытки;
	Если ИмяМетаданных = "Номенклатура" И ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		// Загрузим елиницы измерения
		Если НЕ ЕстьОшибка Тогда
			Для Каждого Единица Из ЕдиницыИзЗапроса Цикл
				
				Если СокрЛП(Единица.NAME)=СокрЛП(СправочникОбъект.ЕдиницаИзмерения.Наименование) Тогда
					Продолжить; //Не загружаем единицу для отчетов в упаковки
				КонецЕсли;
				
//   Единица может быть весовая либо объемная. При ее создании это необходимо будет указать в реквизите
// "ТипИзмеряемойВеличины".
				СтрокаВНастройках = ВесовыеИОбъемные.Найти(Единица.NAME, "NAME");
				ТекВесовой = Ложь;
				ТекОбъемный = Ложь;
				Если СтрокаВНастройках.Весовой Тогда
					ТекВесовой = Истина;
				ИначеЕсли СтрокаВНастройках.Объемный Тогда
					ТекОбъемный = Истина;
				КонецЕсли;
				НайтиСоздатьЕИ(Единица, СправочникОбъект, Единица.BASED = 1, ТекВесовой, ТекОбъемный);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СправочникОбъект.Ссылка;
КонецФункции

// Установка общих реквизитов для всех объектов
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  Настройки - Произвольный - Настройки.
//
Процедура УстановитьОбщиеРеквизиты(Объект, СвойстваОбъекта, Настройки) Экспорт
	
	// Определение - группа или элемент
	Если Объект.ЭтоНовый() И ЗначениеЗаполнено(Настройки.СлужебныйКаталог) Тогда
		Объект.Родитель = Настройки.СлужебныйКаталог;
	КонецЕсли;
	
	Если СвойстваОбъекта.Свойство("ЭтоГруппа") Тогда
		Объект.ЭтоГруппа = СвойстваОбъекта.ЭтоГруппа;
	КонецЕсли;
	
	// Код
	Если Объект.ЭтоНовый() И СвойстваОбъекта.Свойство("Код") И ЗначениеЗаполнено(СвойстваОбъекта.Код) Тогда
		СуществующийОбъект = Справочники[Объект.Метаданные().Имя].НайтиПоКоду(СвойстваОбъекта.Код);
		Если Не ЗначениеЗаполнено(СуществующийОбъект) Тогда
			Код = Неопределено;
			СвойстваОбъекта.Свойство("Код", Код);
			Попытка
				Объект.Код = СокрЛП(Код);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// Наименование
	Наименование = Неопределено;
	СвойстваОбъекта.Свойство("Наименование", Наименование);
	Объект.Наименование = СокрЛП(Наименование);
	
	// ПометкаУдаления
	ПометкаУдаления = Неопределено;
	СвойстваОбъекта.Свойство("Активный", ПометкаУдаления);
	Если ПометкаУдаления <> Неопределено Тогда
		Объект.ПометкаУдаления = ПометкаУдаления;
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Код) Тогда
		Объект.УстановитьНовыйКод("SH");
	КонецЕсли;
	//
	// Попытаемся получить и установить какие то обязательные реквизиты
	Попытка
		ОбязательныеРеквизиты = Объект.ПолучитьОбязательныеРеквизиты();
	Исключение
		ОбязательныеРеквизиты = Новый Структура;
	КонецПопытки;
	Для Каждого СтрокаСтруктуры Из ОбязательныеРеквизиты Цикл
		Если ТипЗнч(СтрокаСтруктуры.Ключ) = Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если СвойстваОбъекта.Свойство(СтрокаСтруктуры.Ключ) И (СтрокаСтруктуры.Значение = 1 Или СтрокаСтруктуры.Значение = 3) И НЕ ЗначениеЗаполнено(Объект[СтрокаСтруктуры.Ключ]) Тогда
			Объект[СтрокаСтруктуры.Ключ] = СвойстваОбъекта[СтрокаСтруктуры.Ключ];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Установка реквизитов для объекта Номенклатура
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  ВидНоменклатуры - Произвольный - Вид номенклатуры.
//  ВесовыеИОбъемные - Произвольный - Весовые и объемные.
//
Процедура ПрочитатьОбъектНоменклатура(Объект, СвойстваОбъекта, ВидНоменклатуры, ВесовыеИОбъемные) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	// Установка ссылки, кода, наименования справочника
	МенеджерОбъекта = Справочники.Номенклатура;
	
	Если НЕ Объект.ЭтоГруппа Тогда
		
		Наименование = Неопределено;
		Если СвойстваОбъекта.Свойство("НаименованиеПолное") Тогда
			Объект.НаименованиеПолное = СвойстваОбъекта.НаименованиеПолное;
		Иначе
			Объект.НаименованиеПолное = СокрЛП(Объект.Наименование);
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") И  СвойстваОбъекта.Свойство("ИспользоватьУпаковки") И СвойстваОбъекта.ИспользоватьУпаковки Тогда
			Объект.ИспользоватьУпаковки = Истина;
			Объект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры;
		Иначе
			Объект.НаборУпаковок = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
		КонецЕсли;
	КонецЕсли; 
	//
	
	Если СвойстваОбъекта.Свойство("СтавкаНДС") Тогда
		Объект.СтавкаНДС = СвойстваОбъекта.СтавкаНДС;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		Объект.СтавкаНДС = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию(ТекПользователь, "ОсновнаяСтавкаНДС");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		ТекущаяДата = ТекущаяДатаСеанса();
		Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
			Если ТекущаяДата >= '20190101' Тогда
				ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС20);
			ИначеЕсли ТекущаяДата >= '20260101' Тогда
				ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС22);
			КонецЕсли;
		Иначе
			Если ТекущаяДата >= '20190101' Тогда
				ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(20);
			ИначеЕсли ТекущаяДата >= '20260101' Тогда
				ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(22);
			КонецЕсли;
		КонецЕсли;
		Объект.СтавкаНДС = ТекСтавкаНДС;
	КонецЕсли;
	
	Если СвойстваОбъекта.Свойство("ВидНоменклатуры") Тогда
		Объект.питВидНоменклатуры = СвойстваОбъекта.ВидНоменклатуры;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.питВидНоменклатуры) Тогда
		Объект.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо;
	КонецЕсли;
	Объект.ВидНоменклатуры = ВидНоменклатуры;
	Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
		Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ВидНоменклатурыПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
		Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоРеквизиту("ТипНоменклатуры",Перечисления.ТипыНоменклатуры.Товар);
		// Тип номенклатуры то нужно установить
		Если ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
			Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
		КонецЕсли;
	КонецЕсли;
	Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);

	// Только для элементов
	Если НЕ Объект.ЭтоГруппа Тогда
		// Найдем единицу
		Если СвойстваОбъекта.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(СвойстваОбъекта.ЕдиницаИзмерения) И ((ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) И Объект.ЕдиницаИзмерения.ПолучитьОбъект() = Неопределено) ИЛИ НЕ ЗначениеЗаполнено(Объект.ЕдиницаИзмерения)) Тогда
			Объект.ЕдиницаИзмерения = СвойстваОбъекта.ЕдиницаИзмерения;
			Если СвойстваОбъекта.Свойство("Весовой") Тогда
				Объект.ВесИспользовать = Истина;
				Объект.ВесЗнаменатель = 1;
				Объект.ВесЧислитель = 1;
				Объект.ВесЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
			ИначеЕсли СвойстваОбъекта.Свойство("Объемный") Тогда
				Объект.ОбъемИспользовать = Истина;
				Объект.ОбъемЗнаменатель = 1;
				Объект.ОбъемЧислитель = 1;
				Объект.ОбъемЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) И Объект.ЕдиницаИзмерения.ПолучитьОбъект() = Неопределено Тогда
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("кг",,,Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.Качество) Тогда
			Объект.Качество = Перечисления.ГрадацииКачества.Новый;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Установка реквизитов для объекта Подразделение
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектПодразделения(СправочникОбъект, СвойстваОбъекта) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Если НЕ СправочникОбъект.ЭтоГруппа И НЕ ЗначениеЗаполнено(СправочникОбъект.Родитель) Тогда
		СправочникОбъект.Родитель = СвойстваОбъекта.Родитель;
	КонецЕсли;
	Если НЕ СправочникОбъект.ЭтоГруппа Тогда
		СправочникОбъект.ПроизводствоБезЗаказов = Истина;
		СправочникОбъект.ВариантОбособленногоУчетаТоваров = Перечисления.ВариантыОбособленногоУчетаТоваров.НеВедется;
	КонецЕсли;
	// СправочникОбъект.ОбменДанными.Загрузка = Истина; // До выяснения почему организация не подходит
КонецПроцедуры

// Установка реквизитов для объекта Организация
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектКонтрагенты(СправочникОбъект, СвойстваОбъекта) Экспорт
	Если НЕ СправочникОбъект.ЭтоГруппа Тогда
		Если ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровКакКонтрагентов") Тогда
			// Грузим в справочник Партнеры
			СправочникОбъект.ПрочиеОтношения = Истина;
			СправочникОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
			СправочникОбъект.ГруппаДоступа = Справочники.ГруппыДоступаПартнеров.НайтиПоНаименованию("Прочие", Истина);
			Если ПустаяСтрока(СправочникОбъект.НаименованиеПолное) Тогда
				СправочникОбъект.НаименованиеПолное = СправочникОбъект.Наименование;
			КонецЕсли;
		Иначе
			ОсновнойПартнер = Справочники.Партнеры.НайтиПоНаименованию("Партнер StoreHouse HeadOffice", Истина);
			Если ОсновнойПартнер = Справочники.Партнеры.ПустаяСсылка() Тогда
				ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
				ПартнерОбъект.Наименование = "Партнер StoreHouse HeadOffice";
				ПартнерОбъект.НаименованиеПолное = ПартнерОбъект.Наименование;
				ПартнерОбъект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
				ПартнерОбъект.ПрочиеОтношения = Истина;
				ПартнерОбъект.УстановитьНовыйКод("SH");
				ПартнерОбъект.ОбменДанными.Загрузка = Истина;
				ПартнерОбъект.Записать();
				ОсновнойПартнер = ПартнерОбъект.Ссылка;
			КонецЕсли;
			СправочникОбъект.Партнер = ОсновнойПартнер;
			СправочникОбъект.ЮридическоеФизическоеЛицо	= Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
			СправочникОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			Если ПустаяСтрока(СправочникОбъект.НаименованиеПолное) Тогда
				СправочникОбъект.НаименованиеПолное = СправочникОбъект.Наименование;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Установка реквизитов для объекта Склад
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектСкладыКомпании(СправочникОбъект, СвойстваОбъекта) Экспорт
	СправочникОбъект.ДополнительныеСвойства.Вставить("ПропуститьОбновлениеФлагаКонтроляОперативныхОстатков",Истина);
	Если НЕ СправочникОбъект.ЭтоГруппа Тогда
		СправочникОбъект.ИсточникИнформацииОЦенахДляПечати = Перечисления.ИсточникиИнформацииОЦенахДляПечати.ПоСебестоимости;
	КонецЕсли;
КонецПроцедуры

// ЗАПОЛНЕНИЕ СВЯЗАННЫХ ТАБЛИЦ

// Заполнение связанных таблиц для объекта Номенклатура
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//  СтрутураЭлементаStoreHouse - Произвольный - Струтура элемента store house.
//  ТолькоЕдИзм - Произвольный - Только ед изм.
//
Процедура НоменклатураПослеЗаписи(Ссылка, СтрутураЭлементаStoreHouse, ТолькоЕдИзм = Ложь) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Или Ссылка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ТолькоЕдИзм Тогда
		Возврат;
	КонецЕсли;
	 
	// Попытаемся найти рецептуру
	Рецептура = Документы.питРецептура.НайтиПоРеквизиту("Номенклатура", Ссылка);
	Если Рецептура.Пустая() И Ссылка.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
		Рецептура = Документы.питРецептура.СоздатьДокумент();
		Рецептура.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
		Рецептура.Упаковка = Ссылка.ЕдиницаИзмерения;

		Рецептура.Номенклатура = Ссылка;
//   Рецептура.Коэффициент =
// ОбщепитДокументы.ПолучитьКоэффициентЕдиницыИзмерения(Рецептура.Номенклатура,Рецептура.ЕдиницаИзмерения);.
		
		// Рассчитаем флаг Основная
		// РезультатЗапроса = Рецептура.ВыполнитьЗапросПоРецептурам();
		// Рецептура.Основная = Истина;
		Рецептура.Количество = 1;
		// Рецептура.Автор = ПараметрыСеанса.Пользователь;
		Если СтрутураЭлементаStoreHouse.Свойство("Дата") Тогда
			Рецептура.Дата = СтрутураЭлементаStoreHouse.Дата;
		Иначе
			Рецептура.Дата = ТекущаяДата();
		КонецЕсли;
		Рецептура.ДатаНачала = Рецептура.Дата;
		
		Рецептура.УстановитьНовыйНомер();
		
		// СтрутураЭлементаStoreHouse.Свойство("Валюта", Рецептура.ВалютаДокумента);
		// СтруктураКурса = МодульВалютногоУчета.ПолучитьКурсВалюты(Рецептура.ВалютаДокумента, ТекущаяДата());
		// Рецептура.КурсДокумента = ?(СтруктураКурса.Курс = 0,1,СтруктураКурса.Курс);
		
		СтрутураЭлементаStoreHouse.Свойство("Организация", Рецептура.Организация);
		// СтрутураЭлементаStoreHouse.Свойство("Подразделение", Рецептура.ПодразделениеКомпании);
		
		Попытка
			Рецептура.Записать();
		Исключение
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "писаниеОшибки(";
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры


// УПРАВЛЕНИЕ СОЕДИНЕНИЯМИ

// Производится подключение к ВИД по строке соединения
//
// Параметры:
//  УчетнаяЗапись - Произвольный - Учетная запись.
//  СтрокаСоединения - Строка - Строка соединения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодключитьсяКВнешнемуИсточникуДанных(УчетнаяЗапись, СтрокаСоединения = "") Экспорт
	// Проверим какой внешний источник данных нам следует использовать.
	Если УчетнаяЗапись.ФорматОбмена = 1 Тогда
		// Будем использовать новый формат (с префиксом).
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse4;
	Иначе
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse;
	КонецЕсли;
	
	
	Если ИсточникДанных.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен Тогда
		ОтключитьсяОтВнешнегоИсточникаДанных(УчетнаяЗапись.ФорматОбмена);
	КонецЕсли;
	
	ПараметрыСоединения = ИсточникДанных.ПолучитьОбщиеПараметрыСоединения();
	ПараметрыСоединения.АутентификацияСтандартная = Истина;
	ПараметрыСоединения.ИмяПользователя = УчетнаяЗапись.ИмяАдминистратора;
	ПараметрыСоединения.Пароль = УчетнаяЗапись.ПарольАдминистратора;
	
	СерверRK = УчетнаяЗапись.Сервер;
	БазаRK = УчетнаяЗапись.База;
	
	Если СтрокаСоединения = "" Тогда
		ПараметрыСоединения.СтрокаСоединения = "DRIVER={SQL Server};SERVER="+НРег(СерверRK)+";DATABASE="+БазаRK+";LANGUAGE=русский";
	Иначе
		ПараметрыСоединения.СтрокаСоединения = СтрокаСоединения;
	КонецЕсли;
	ПараметрыСоединения.СУБД = "MSSQLServer";
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИсточникДанных.УстановитьОбщиеПараметрыСоединения(ПараметрыСоединения);
	ИсточникДанных.УстановитьПараметрыСоединенияПользователя(ПользователиИнформационнойБазы.ТекущийПользователь().Имя,ПараметрыСоединения);
	ИсточникДанных.УстановитьПараметрыСоединенияСеанса(ПараметрыСоединения);
	Попытка
		ИсточникДанных.УстановитьСоединение();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
КонецФункции

// Производится отключение от ВИД
//
// Параметры:
//  ФорматОбмена - Число - В зависимости от формата обмена, будем использовать различный источник.
//
Процедура ОтключитьсяОтВнешнегоИсточникаДанных(ФорматОбмена = 0) Экспорт
	// Проверим какой внешний источник данных нам следует использовать.
	Если ФорматОбмена = 1 Тогда
		// Будем использовать новый формат (с префиксом).
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse4;
	Иначе
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse;
	КонецЕсли;
	
	Если ИсточникДанных.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен Тогда
		ИсточникДанных.РазорватьСоединение()
	КонецЕсли;
КонецПроцедуры

// Функция - Подключение активно
//
// Параметры:
//  ФорматОбмена - Число - В зависимости от формата обмена, будем использовать различный источник.
//
// Возвращаемое значение:
//  Булево - Признак подключенного состояния.
Функция ПодключениеАктивно(ФорматОбмена = 0) Экспорт
	// Проверим какой внешний источник данных нам следует использовать.
	Если ФорматОбмена = 1 Тогда
		// Будем использовать новый формат (с префиксом).
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse4;
	Иначе
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse;
	КонецЕсли;
	
	Возврат ИсточникДанных.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен;
КонецФункции

// Формирует печатные формы
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать.
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//   (выходные.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документ.
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//   представление - имя области в которой был выведен объект.
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
		МодульУправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"РезультатРаботы", НСтр("ru = 'Данные продаж фронта'"),
				ПечатьРезультатРаботы(ПараметрыПечати.МассивДокументов, ПараметрыПечати.ПрерываниеЗагрузки),
				,
				"Обработка.питЗагрузкаStoreHouse.РезультатРаботы");
	КонецЕсли;
	
КонецПроцедуры

// Функция - Печать результат работы.
//
// Параметры:
//  МассивДокументов - Массив - Массив документов.
//  ПрерываниеЗагрузки - Произвольный - Прерывание загрузки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПечатьРезультатРаботы(МассивДокументов, ПрерываниеЗагрузки = Ложь) Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ПолеСверху          = 0;
	ТабДок.ПолеСлева           = 0;
	ТабДок.ПолеСнизу           = 0;
	ТабДок.ПолеСправа          = 0;
	ТабДок.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьЗаголовки	= ЛОЖЬ;
	ТабДок.ОтображатьСетку     = ЛОЖЬ;
	ТабДок.Защита              = Истина;
	ТабДок.ТолькоПросмотр      = Истина;
	ТабДок.ПолеСлева           = 9;
	ТабДок.ПолеСправа          = 6;
	
	Макет = Обработки.питЗагрузкаStoreHouse.ПолучитьМакет("РезультатРаботы");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.ВидДокументов = "Рецептуры";
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаСозданныеДокументы");
	Для Каждого СозданныйДокумент Из МассивДокументов Цикл
		ОбластьМакета.Параметры.Документ = СозданныйДокумент;
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	Если ПрерываниеЗагрузки Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ОбластьМакета.Параметры.Комментарий = "Произошло прерывание загрузки";
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли;
	
	Возврат ТабДок;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// БЛОК ЗАГРУЗКИ РЕЦЕПТУР

// Функция Привести номер
// Параметры:
//  Номер - Произвольный - Знач номер.
//  Префикс - Произвольный - Знач префикс.
//  ДлинаНомера - Произвольный - Длина номера.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПривестиНомер(Знач Номер,Знач Префикс, ДлинаНомера=11)
	текНомер	= Формат(Номер,"ЧГ=");
	Если ТипЗнч(Префикс) = ТипЗнч(Число(12)) Тогда 
		текПрефикс		= Формат(Префикс,"ЧГ=");
	Иначе
		текПрефикс		= Префикс;
	КонецЕсли;
	НовыйНомер = ""+текПрефикс+текНомер;
	Пока СтрДлина(НовыйНомер) < ДлинаНомера Цикл
		текПрефикс = ""+текПрефикс+"0";
		НовыйНомер = текПрефикс+текНомер;
	КонецЦикла;
	Возврат НовыйНомер;
КонецФункции

// Функция - Загрузить рецептуру шапка.
//
// Параметры:
//  НомерРецептуры - Произвольный - Номер рецептуры.
//  Номенклатура - Произвольный - Номенклатура.
//  Шапка - Произвольный - Шапка.
//  Атрибуты - Произвольный - Атрибуты.
//  ОрганизацияЗагрузки - Произвольный - Организация загрузки.
//  СтатьяКалькуляции - Произвольный - Статья калькуляции.
//  ПодразделениеЗагрузки - Произвольный - Подразделение загрузки.
//  СкладЗагрузки - Произвольный - Склад загрузки.
//  ДатаЗагрузки - Дата - Дата загрузки.
//  СтрокаНоменклатуры - Строка - Строка номенклатуры.
//  Основная - Произвольный - Основная.
//  Грузить - Произвольный - Грузить.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗагрузитьРецептуру_Шапка(НомерРецептуры, Номенклатура, Шапка, Атрибуты, ОрганизацияЗагрузки, СтатьяКалькуляции, ПодразделениеЗагрузки, СкладЗагрузки, ДатаЗагрузки, СтрокаНоменклатуры, Основная, Грузить)
	Если Грузить Тогда
		Рецептура = ЗаполнитьСсылку1СПоСоответствию(НомерРецептуры, "питРецептура");
		Если НЕ Рецептура = Документы.питРецептура.ПустаяСсылка() Тогда
			Возврат Рецептура;
		Иначе
			Рецептура = Документы.питРецептура.СоздатьДокумент();
			Рецептура.Номер	= НомерРецептуры;
		КонецЕсли;
		Рецептура.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
		Если НЕ Основная Тогда //Есть возможность получить подразделение
			Рецептура.Подразделение = ЗаполнитьСсылку1СПоСоответствию(Строка(СтрокаНоменклатуры.DEPART_REF), "СтруктураПредприятия");
		КонецЕсли;
		Если Рецептура.Подразделение.Пустая() Тогда
			Рецептура.Подразделение = ПодразделениеЗагрузки;
		КонецЕсли;
		
		Рецептура.Организация = ОрганизацияЗагрузки;
		Рецептура.СтатьяКалькуляции = СтатьяКалькуляции;
		Рецептура.Номенклатура = Номенклатура;
		Рецептура.Основная = Основная;
		Рецептура.Упаковка = Номенклатура.ЕдиницаИзмерения;
		Рецептура.Количество = Шапка.NORM;
		Рецептура.КоличествоУпаковок = Шапка.NORM;
		Рецептура.ДатаНачала = ДатаЗагрузки;
		Рецептура.Дата = ДатаЗагрузки;
		Если Атрибуты.Количество()=1 Тогда
			СтрокаATTRS_REF = Строка(Атрибуты[0]["ATTRS_REF"]);
			Если НЕ ПустаяСтрока(СтрокаATTRS_REF) И Число(СтрокаATTRS_REF)=23 Тогда
				Рецептура.Выход = Атрибуты[0]["VAL_STRING"];
			КонецЕсли;
		КонецЕсли;
		Рецептура.ТехнологияПриготовления = Шапка.TECHNOLOGY;
		Рецептура.ЦеховаяКладовая = СкладЗагрузки;
		Попытка
			Рецептура.ОбменДанными.Загрузка = Истина;

			// +РазрешенныеПодразделения
			НайденныеПодразделения = Рецептура.РазрешенныеПодразделения.НайтиСтроки(Новый Структура("Подразделение", Рецептура.Подразделение));
			ПодразделениеЦехНайдено = Ложь;
			Для каждого ТекНайденноеПодразделение Из НайденныеПодразделения Цикл
				Если ТекНайденноеПодразделение.ЦеховаяКладовая = Справочники.Склады.ПустаяСсылка() 
					ИЛИ ТекНайденноеПодразделение.ЦеховаяКладовая = Рецептура.ЦеховаяКладовая Тогда
					ПодразделениеЦехНайдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ПодразделениеЦехНайдено Тогда
				НовПодразделение = Рецептура.РазрешенныеПодразделения.Добавить();
				НовПодразделение.Подразделение		= Рецептура.Подразделение;
				НовПодразделение.ЦеховаяКладовая	= Рецептура.ЦеховаяКладовая;
				НовПодразделение.ВключаяПодчиненные	= Истина;
			КонецЕсли;
			// -РазрешенныеПодразделения
			
			Рецептура.Записать(РежимЗаписиДокумента.Запись);
			СтавитьСоответствие = Истина;
		Исключение
			СтавитьСоответствие = Ложь;
		КонецПопытки;
		Если СтавитьСоответствие Тогда
			СозданныеРецептуры	= Новый ТаблицаЗначений;
			СозданныеРецептуры.Колонки.Добавить("Sifr");
			СозданныеРецептуры.Колонки.Добавить("NAME");
			СозданныеРецептуры.Колонки.Добавить("CODE");
			СозданныеРецептуры.Колонки.Добавить("Ссылка");
			НовСтрока = СозданныеРецептуры.Добавить();
			НовСтрока.Sifr = НомерРецептуры;
			НовСтрока.Ссылка = Рецептура.Ссылка;
			НовСтрока.NAME = "Рецептура №"+НомерРецептуры+?(Основная," основная ", " не основная ")+"по "+Рецептура.Номенклатура;
			НовСтрока.CODE = НомерРецептуры;
			
			// Установим соотвествия рецептур
			питStoreHouse.ДобавитьНедостающиеСтрокиСоответствия(СозданныеРецептуры, ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Рецептура);
		КонецЕсли;
	Иначе
		Рецептура = ЗаполнитьСсылку1СПоСоответствию(НомерРецептуры, "питРецептура");
		Если НЕ Рецептура = Документы.питРецептура.ПустаяСсылка() Тогда
			Возврат Рецептура;
		КонецЕсли;

		СозданныеРецептуры	= Новый ТаблицаЗначений;
		СозданныеРецептуры.Колонки.Добавить("Sifr");
		СозданныеРецептуры.Колонки.Добавить("NAME");
		СозданныеРецептуры.Колонки.Добавить("CODE");
		СозданныеРецептуры.Колонки.Добавить("Ссылка");
		НовСтрока = СозданныеРецептуры.Добавить();
		НовСтрока.Sifr = НомерРецептуры;
		НовСтрока.Ссылка = Документы.питРецептура.ПустаяСсылка();
		НовСтрока.NAME = "Рецептура №"+НомерРецептуры+?(Основная," основная ", " не основная ")+"по "+Номенклатура;
		НовСтрока.CODE = НомерРецептуры;
		
		// Установим соотвествия рецептур
		питStoreHouse.ДобавитьНедостающиеСтрокиСоответствия(СозданныеРецептуры, ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Рецептура);
	КонецЕсли;
	Возврат Рецептура.Ссылка;
	
КонецФункции

// Функция - Получить еи.
//
// Параметры:
//  MUNITS_REF - Произвольный - Munits ref.
//  ИмяИсточника - Строка - Имя источника.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьЕИ(MUNITS_REF, ИмяИсточника = "питStoreHouse")
	// Подготовим таблицу результата.
	ТаблицаРезультата = Новый  ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("RID");
	ТаблицаРезультата.Колонки.Добавить("BASED");
	ТаблицаРезультата.Колонки.Добавить("CF");
	ТаблицаРезультата.Колонки.Добавить("NAME");
	ТаблицаРезультата.Колонки.Добавить("MGROUP_REF");
	ТаблицаРезультата.Колонки.Добавить("DELETED");

	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	MUNITS.RID,
	|	MUNITS.BASED,
	|	MUNITS.CF,
	|	MUNITS.NAME,
	|	MUNITS.MGROUP_REF,
	|	MUNITS.DELETED
	|ИЗ
	|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_MUNITS КАК MUNITS
	|ГДЕ
	|	MUNITS.Ссылка = &MUNITS_REF";
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);

	Запрос.УстановитьПараметр("MUNITS_REF", MUNITS_REF);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(ТекСтрока,Выборка);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ТекстОшибки = НСтр("ru = 'Ошибка получения единицы измерения.'");
		ЗаписьЖурналаРегистрации("Загрузка из StoreHouse HeadOffice",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ТаблицаРезультата;
КонецФункции


