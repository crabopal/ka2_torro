#Область ПрограммныйИнтерфейс

// Заполнение параметров загрузки для каждого типа объекта из ПВХ <Типы объектов StoreHouse>
//
// Параметры:
//  ПараметрыЗагрузки - Произвольный - Параметры загрузки.
//
Процедура ИнициализацияПараметровЗагрузки(ПараметрыЗагрузки) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТипыОбъектовStoreHouse.Ссылка КАК ТипОбъекта,
	                      |	ТипыОбъектовStoreHouse.Создавать КАК Создавать,
	                      |	ТипыОбъектовStoreHouse.Обновлять КАК Обновлять,
	                      |	ТипыОбъектовStoreHouse.СлужебныйКаталог,
	                      |	ТипыОбъектовStoreHouse.ОбработкаОшибок
	                      |ИЗ
	                      |	ПланВидовХарактеристик.питТипыОбъектовStoreHouse КАК ТипыОбъектовStoreHouse
	                      |ГДЕ
	                      |	ТипыОбъектовStoreHouse.Предопределенный
	                      |	И ТипыОбъектовStoreHouse.Ссылка <> &Рецептуры
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТипыОбъектовStoreHouse.Код");
	Запрос.УстановитьПараметр("Рецептуры", ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Рецептура);
	ПараметрыЗагрузки.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

// Функция - Заполнить ссылку 1 с по соответствию.
//
// Параметры:
//  УИД - Произвольный - Уид.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьСсылку1СПоСоответствию(УИД, ИмяМетаданных) Экспорт
	ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
	// Найдем или создадим ссылку в 1с по соответствию
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовStoreHouse.Ссылка1С
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовStoreHouse КАК СоответствияОбъектовStoreHouse
	               |ГДЕ
	               |	СоответствияОбъектовStoreHouse.ТипОбъекта = &ТипОбъекта
	               |	И СоответствияОбъектовStoreHouse.СсылкаStoreHouse = &СсылкаStoreHouse";
	Запрос.УстановитьПараметр("ТипОбъекта", ТипПВХ);
	Запрос.УстановитьПараметр("СсылкаStoreHouse", Число(УИД));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка1С) Тогда
		Возврат Выборка.Ссылка1С;
	Иначе
		Попытка
			Возврат Справочники[ИмяМетаданных].ПустаяСсылка();
		Исключение
			Возврат Документы[ИмяМетаданных].ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
КонецФункции


// Функция - Получить состав комплекта.
//
// Параметры:
//  Комплект - Произвольный - Комплект.
//  ИмяИсточника - Строка - Имя источника.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьСоставКомплекта(Комплект,ИмяИсточника = "питStoreHouse") Экспорт 
	
	// Подготовим таблицу результата.
	ТаблицаРезультата = Новый  ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("RID");
	ТаблицаРезультата.Колонки.Добавить("REC_ORDER");
	ТаблицаРезультата.Колонки.Добавить("ITEM_REF");
	ТаблицаРезультата.Колонки.Добавить("ITEM_TYPE");
	ТаблицаРезультата.Колонки.Добавить("MUNITS_REF");
	ТаблицаРезультата.Колонки.Добавить("BRUTTO");
	ТаблицаРезультата.Колонки.Добавить("PERC1");
	ТаблицаРезультата.Колонки.Добавить("PERC2");
	ТаблицаРезультата.Колонки.Добавить("DELETED");
	ТаблицаРезультата.Колонки.Добавить("CMBASE_REF");
	ТаблицаРезультата.Колонки.Добавить("RIDGOODS");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	CMITEMS.RID КАК RID,
	               |	CMITEMS.REC_ORDER КАК REC_ORDER,
	               |	CMITEMS.ITEM_REF КАК ITEM_REF,
	               |	CMITEMS.ITEM_TYPE КАК ITEM_TYPE,
	               |	CMITEMS.MUNITS_REF КАК MUNITS_REF,
	               |	CMITEMS.BRUTTO КАК BRUTTO,
	               |	CMITEMS.PERC1 КАК PERC1,
	               |	CMITEMS.PERC2 КАК PERC2,
	               |	CMITEMS.DELETED КАК DELETED,
	               |	dbo_CMBASE.RID КАК RIDCMBASE
	               |ИЗ
	               |	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_CMITEMS КАК CMITEMS
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_CMBASE КАК dbo_CMBASE
	               |		ПО CMITEMS.ITEM_REF = dbo_CMBASE.RID
	               |ГДЕ
	               |	CMITEMS.CMHEADERS_REF = &Комплект";
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
	
	Запрос.УстановитьПараметр("Комплект", Комплект);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.ITEM_TYPE = 1 Тогда
					ТекСтрока = ТаблицаРезультата.Добавить();
					ЗаполнитьЗначенияСвойств(ТекСтрока,Выборка);
					// Надо сделать дополнительную проверку на наличие связи между GOODS И CMBASE чтобы определить какой код брать
					
					Если Выборка.RIDCMBASE <> Null Тогда //Вдруг такая строчка была удалена из CMBASE а код в CMITEMS остался
						ТекстЗапроса = "ВЫБРАТЬ
						               |	dbo_GOODS.RID КАК RIDGOODS
						               |ИЗ
						               |	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_GOODS КАК dbo_GOODS
						               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_CMBASE КАК dbo_CMBASE
						               |		ПО dbo_GOODS.CMBASE_REF = dbo_CMBASE.Ссылка
						               |ГДЕ
						               |	dbo_CMBASE.RID = &RID";
						Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
						Запрос.УстановитьПараметр("RID", Выборка.RIDCMBASE);
						РезультатПроверки = Запрос.Выполнить();
						Если РезультатПроверки.Пустой() Тогда
							// Связи нет проверяем на наличие в GOODSPARAMS и если там есть такое то берем ссылку на GOODS
							// иначе берем с отрицательным знаком
							ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
							               |	dbo_DEP_GOODSPARAMS.GOODS_REF.RID КАК GOODS_REFRID
							               |ИЗ
							               |	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_DEP_GOODSPARAMS КАК dbo_DEP_GOODSPARAMS
							               |ГДЕ
							               |	dbo_DEP_GOODSPARAMS.CMBASE_REF.RID = &RID";
							Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
							Запрос.УстановитьПараметр("RID", Выборка.RIDCMBASE);
							РезультатПроверки = Запрос.Выполнить();
							Если РезультатПроверки.Пустой() Тогда
								ТекСтрока.ITEM_REF = -Выборка.RIDCMBASE;
							Иначе
								ВыборкаПроверки = РезультатПроверки.Выбрать();
								ВыборкаПроверки.Следующий();
								ТекСтрока.ITEM_REF = ВыборкаПроверки.GOODS_REFRID;
							КонецЕсли;
						Иначе
							// Связь есть подменяем КОД на код из GOODS
							ВыборкаПроверки = РезультатПроверки.Выбрать();
							ВыборкаПроверки.Следующий();
							ТекСтрока.ITEM_REF = ВыборкаПроверки.RIDGOODS;
						КонецЕсли;
					КонецЕсли;
				Иначе
					ТекСтрока = ТаблицаРезультата.Добавить();
					ЗаполнитьЗначенияСвойств(ТекСтрока,Выборка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		ТекстОшибки = НСтр("ru = 'Ошибка получения состава комплекта <'") + Строка(Комплект) + ">.";
		ЗаписьЖурналаРегистрации("Загрузка из StoreHouse HeadOffice",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

// Процедура - Получить список всех еи.
//
// Параметры:
//  ИмяИсточника - Строка - Имя источника.
//  ТаблицаРезультата - ТаблицаЗначений - Таблица результата.
//
Процедура ПолучитьСписокВсехЕИ(ИмяИсточника = "питStoreHouse", ТаблицаРезультата) Экспорт
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	MUNITS.NAME
	|ИЗ
	|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_GOODSMUNITS КАК GOODSMUNITS
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_MUNITS КАК MUNITS
	|	ПО GOODSMUNITS.MUNITS_REF = MUNITS.Ссылка";
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ТаблицаРезультата.Найти(Выборка.NAME,"NAME") = Неопределено Тогда
					ТекСтрока = ТаблицаРезультата.Добавить();
					ЗаполнитьЗначенияСвойств(ТекСтрока,Выборка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		ТекстОшибки = НСтр("ru = 'Ошибка получения списика всех единиц измерения.'");
		ЗаписьЖурналаРегистрации("Загрузка из StoreHouse HeadOffice",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Процедура - Загрузить рецептуру состав.
//
// Параметры:
//  РецептураСсылка - Произвольный - Рецептура ссылка.
//  Состав - Произвольный - Состав.
//  ИмяИсточника - Строка - Имя источника.
//
Процедура ЗагрузитьРецептуру_Состав(РецептураСсылка, Состав, ИмяИсточника = "питStoreHouse") Экспорт
	Рецептура	= РецептураСсылка.ПолучитьОбъект();
	Рецептура.Ингредиенты.Очистить();
	ИспользоватьУпаковки = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры");
	Для Каждого стр из Состав Цикл
		// Если ПустаяСтрока(стр.ITEM_REF) Тогда
		// 	Продолжить;
		// КонецЕсли;
		// Тут надо проанализировать поле TYPE и получить CODE в зависимости от него
		Ингредиент = ЗаполнитьСсылку1СПоСоответствию(стр.ITEM_REF, "Номенклатура");
		Если НЕ ЗначениеЗаполнено(Ингредиент) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не найдена номенклатура с номером: "+стр.ITEM_REF+"	Рецепура №"+Рецептура.Номер;
			Сообщение.Сообщить();
			
			Продолжить;
		КонецЕсли;
		СтрокаРецептуры = Рецептура.Ингредиенты.Добавить();
		СтрокаРецептуры.Номенклатура	= Ингредиент;
		СтрокаРецептуры.КоличествоБрутто= стр.BRUTTO;
		СтрокаРецептуры.КоличествоНетто = стр.BRUTTO * (1 - стр.PERC1/100);
		СтрокаРецептуры.КоличествоВыход = стр.BRUTTO * (1 - стр.PERC2/100);
		СтрокаРецептуры.КоличествоУпаковокБрутто= СтрокаРецептуры.КоличествоБрутто;
		СтрокаРецептуры.КоличествоУпаковокНетто = СтрокаРецептуры.КоличествоНетто;
		СтрокаРецептуры.КоличествоУпаковокВыход = СтрокаРецептуры.КоличествоВыход;
		СтрокаРецептуры.ПроцентПотерьПриХолоднойОбработке = ?(СтрокаРецептуры.КоличествоБрутто <> 0, (СтрокаРецептуры.КоличествоБрутто - СтрокаРецептуры.КоличествоНетто)*100/СтрокаРецептуры.КоличествоБрутто, 0);
		СтрокаРецептуры.ПроцентПотерьПриГорячейОбработке = ?(СтрокаРецептуры.КоличествоНетто <> 0, (СтрокаРецептуры.КоличествоНетто - СтрокаРецептуры.КоличествоВыход)*100/СтрокаРецептуры.КоличествоНетто, 0);
		
		ЕдиницаИзЗапроса = ПолучитьЕИ(стр.MUNITS_REF, ИмяИсточника);
		Если ИспользоватьУпаковки И Ингредиент.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
			Если ЕдиницаИзЗапроса[0].BASED Тогда
				ЕдИзм = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(ЕдиницаИзЗапроса[0].NAME, Истина,, Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
			Иначе
				ЕдИзм = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(ЕдиницаИзЗапроса[0].NAME, Истина,, Ингредиент);
			КонецЕсли;
		Иначе
			ЕдИзм = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(ЕдиницаИзЗапроса[0].NAME, Истина,,Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
		КонецЕсли;
		Если НЕ ЕдИзм.Пустая() Тогда
			ЕдИзм = ЕдИзм.ПолучитьОбъект();
		Иначе
			ЕдИзм = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
			Если ИспользоватьУпаковки И Ингредиент.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда
				Если ЕдиницаИзЗапроса[0].BASED Тогда
					ЕдИзм.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
				Иначе
					ЕдИзм.Владелец = Ингредиент;
				КонецЕсли;
			КонецЕсли;
			ЕдИзм.УстановитьНовыйКод();
			
			Если НЕ ЕдиницаИзЗапроса[0].BASED Тогда
				ЕдИзм.ЕдиницаИзмерения = Ингредиент.ЕдиницаИзмерения; //Относительно неё ставим коэфф
			КонецЕсли;
			ЕдИзм.Числитель		= ЕдиницаИзЗапроса[0].CF;
			ЕдИзм.Знаменатель	= 1;
			
			ЕдИзм.Наименование = ЕдиницаИзЗапроса[0].NAME;
			Если ЕдиницаИзЗапроса[0].BASED Тогда
				ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
			Иначе
				ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Упаковка;
			КонецЕсли;
			ЕдИзм.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная;
			ЕдИзм.ОбменДанными.Загрузка = Истина;
			Справочники.УпаковкиЕдиницыИзмерения.ОтработатьЛогикуСвязиРеквизитов(ЕдИзм);
			ЕдИзм.Записать();
		КонецЕсли;
		
		СтрокаРецептуры.Упаковка = ЕдИзм.Ссылка;
	КонецЦикла;
	Попытка
		Рецептура.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		// Сообщение = Новый СообщениеПользователю();
		// Сообщение.Текст = "писаниеОшибки(),СтатусСообщения.ОченьВажно";
		// Сообщение.Сообщить();
		// печалька
	КонецПопытки;
КонецПроцедуры

// Функция - Получить соответствия godecm.
//
// Параметры:
//  ИмяИсточника - Строка - Имя источника.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьСоответствияGODECM(ИмяИсточника = "питStoreHouse") Экспорт 
	// Подготовим таблицу результата.
	ТаблицаРезультата = Новый  ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("CODE");
	ТаблицаРезультата.Колонки.Добавить("DEPART_REF");
	ТаблицаРезультата.Колонки.Добавить("CMBASE_REF");
	ТаблицаРезультата.Колонки.Добавить("WOTAX_OUT");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	DEP_GOODSPARAMS.GOODS_REF AS CODE,
	|	DEP_GOODSPARAMS.DEPART_REF,
	|	DEP_GOODSPARAMS.CMBASE_REF,
	|	DEP_GOODSPARAMS.WOTAX_OUT
	|ИЗ
	|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_DEP_GOODSPARAMS КАК DEP_GOODSPARAMS
	|ГДЕ
	|	НЕ DEP_GOODSPARAMS.CMBASE_REF ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	DEP_GOODSPARAMS.GOODS_REF";
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
	
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(ТекСтрока,Выборка);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ТекстОшибки = НСтр("ru = 'Ошибка получения соответствия.'");
		ЗаписьЖурналаРегистрации("Загрузка из StoreHouse HeadOffice",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

// Функция - Получить номенклатуру с рецептурами.
//
// Параметры:
//  ИмяИсточника - Строка - Имя источника.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьНоменклатуруСРецептурами(ИмяИсточника = "питStoreHouse") Экспорт
	// Подготовим таблицу результата.
	ТаблицаРезультата = Новый  ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("CODE");
	ТаблицаРезультата.Колонки.Добавить("GOODSTREE_REF");
	ТаблицаРезультата.Колонки.Добавить("NAME");
	ТаблицаРезультата.Колонки.Добавить("USE_COMP");
	ТаблицаРезультата.Колонки.Добавить("CMBASE_REF");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	GOODS.RID КАК CODE,
	|	GOODS.GOODSTREE_REF,
	|	GOODS.NAME,
	|	GOODS.USE_COMP,
	|	GOODS.CMBASE_REF
	|ИЗ
	|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.dbo_GOODS КАК GOODS
	|ГДЕ
	|	НЕ GOODS.CMBASE_REF ЕСТЬ NULL";
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекСтрока = ТаблицаРезультата.Добавить();
				ЗаполнитьЗначенияСвойств(ТекСтрока,Выборка);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ТекстОшибки = НСтр("ru = 'Ошибка получения номенклатуры с рецептурами.'");
		ЗаписьЖурналаРегистрации("Загрузка из StoreHouse HeadOffice",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ТаблицаРезультата;
КонецФункции

// Функция - Загрузить рецептуры на сервере.
//
// Параметры:
//  ТаблицаОбхода - ТаблицаЗначений - Таблица обхода.
//  ОрганизацияЗагрузки - Произвольный - Организация загрузки.
//  СтатьяКалькуляции - Произвольный - Статья калькуляции.
//  ПодразделениеЗагрузки - Произвольный - Подразделение загрузки.
//  СкладЗагрузки - Произвольный - Склад загрузки.
//  ДатаЗагрузки - Дата - Дата загрузки.
//  Основная - Произвольный - Основная.
//  Грузить - Произвольный - Грузить.
//  ИмяИсточника - Строка - Имя источника.
//  ВесовыеИОбъемные - Произвольный - Весовые и объемные.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗагрузитьРецептурыНаСервере(ТаблицаОбхода, ОрганизацияЗагрузки, СтатьяКалькуляции, ПодразделениеЗагрузки, СкладЗагрузки, ДатаЗагрузки, Основная, Грузить, ИмяИсточника = "питStoreHouse", ВесовыеИОбъемные = Неопределено) Экспорт
	табСписокРецептур	= Новый ТаблицаЗначений;
	табСписокРецептур.Колонки.Добавить("стрРецRID");
	табСписокРецептур.Колонки.Добавить("НомерРецептуры");
	табСписокРецептур.Колонки.Добавить("СсылкаНоменклатуры");
	табСписокРецептур.Колонки.Добавить("СсылкаРецептуры");
	табСписокРецептур.Колонки.Добавить("АтрибутыРецептуры");

	СозданныеРецептуры	= Новый Массив;
	
	Для Каждого СтрокаНоменклатуры Из ТаблицаОбхода Цикл
		КодРецептуры		= СтрокаНоменклатуры.CMBASE_REF;
		ПрефиксРецептуры	= СтрокаНоменклатуры.CODE;
		НомерРецептуры	= ПривестиНомер(КодРецептуры,ПрефиксРецептуры,10);
		СсылкаНоменклатуры = ЗаполнитьСсылку1СПоСоответствию(СокрЛП(СтрокаНоменклатуры.CODE), "Номенклатура");
		Если НЕ ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
			Если ТипЗнч(СтрокаНоменклатуры.CODE) = Тип("Число") Тогда
				Соответствие = Новый Структура("ИмяStoreHouse,КодStoreHouse",СтрокаНоменклатуры.NAME,СтрокаНоменклатуры.CODE);
				РодительНоменкатуры = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаНоменклатуры.GOODSTREE_REF.NAME, Истина);
			Иначе
				Соответствие = Новый Структура("ИмяStoreHouse,КодStoreHouse",СтрокаНоменклатуры.CODE.NAME,СокрЛП(СтрокаНоменклатуры.CODE));
				РодительНоменкатуры = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаНоменклатуры.CODE.GOODSTREE_REF.NAME, Истина);
			КонецЕсли;
			СсылкаНоменклатуры = СоздатьОбъектСоответствия(Соответствие, "Номенклатура", РодительНоменкатуры, Перечисления.питВидыНоменклатуры.Блюдо,ИмяИсточника, ВесовыеИОбъемные);
		КонецЕсли;
		СписокРецептур	= ПолучитьШапкуКомплекта(СтрокаНоменклатуры.CMBASE_REF, ИмяИсточника);
		Для Каждого стрРец Из СписокРецептур Цикл
			АтрибутыРецептуры = ПолучитьАтрибутыРецептуры(стрРец.RID, ИмяИсточника);
			СсылкаРецептуры	= ЗагрузитьРецептуру_Шапка(НомерРецептуры, СсылкаНоменклатуры, стрРец, АтрибутыРецептуры, ОрганизацияЗагрузки, СтатьяКалькуляции, ПодразделениеЗагрузки, СкладЗагрузки, ДатаЗагрузки, СтрокаНоменклатуры, Основная, Грузить);
			Если СсылкаРецептуры.Номенклатура = СсылкаНоменклатуры Тогда
				стр	= табСписокРецептур.Добавить();
				стр.стрРецRID			= стрРец.RID;
				стр.НомерРецептуры		= НомерРецептуры;
				стр.СсылкаНоменклатуры	= СсылкаНоменклатуры;
				стр.СсылкаРецептуры		= СсылкаРецептуры;
				стр.АтрибутыРецептуры	= АтрибутыРецептуры;
			ИначеЕсли Грузить Тогда
				Если Найти(СсылкаНоменклатуры.Наименование,"(Дубль)") = 0 Тогда 
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Рецептура составлена на другую номенклатуру 
					|	номенклатура дубль "+СсылкаНоменклатуры;
					Сообщение.Сообщить();    
					ОбъектНоменклатуры	= СсылкаНоменклатуры.ПолучитьОбъект();
					ОбъектНоменклатуры.Наименование	= ОбъектНоменклатуры.Наименование + " (Дубль)";
					ОбъектНоменклатуры.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат табСписокРецептур;
КонецФункции

// Функция возвращает таблицу номенклатуры
//
// Параметры:
//  ФорматОбмена - Произвольный - Формат обмена.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуНоменклатуры(ФорматОбмена = 0) Экспорт
	Таблица = ПолучитьНоменклатуруПоДвумТаблицам(ФорматОбмена);
	Таблица.Колонки.Добавить("PARENTNAME");
	
	ТаблицаГрупп = питStoreHouse.ПолучитьБазовыеПоляТаблицы("GOODSTREE",,,ФорматОбмена);
	ТаблицаГруппCM = питStoreHouse.ПолучитьБазовыеПоляТаблицы("CMTREE",,,ФорматОбмена);
	Для Каждого текСтрока Из Таблица Цикл
		КодГруппы=СокрЛП(текСтрока.PARENT);
		Если КодГруппы = "" Тогда
			КодГруппы = -1;
		Иначе
			КодГруппы = Число(КодГруппы);
		КонецЕсли;
		Если ТипЗнч(текСтрока.CODE) = Тип("Строка") Тогда // Это добавочная номенклатура из CMBASE её делаем отрицательной
			СтрокаГруппыСМ = ТаблицаГруппCM.Найти(КодГруппы, "CODE");
			Если СтрокаГруппыСМ <> Неопределено Тогда
				текСтрока.PARENTNAME = СтрокаГруппыСМ.Name;
			КонецЕсли;
			текСтрока.CODE = -Число(текСтрока.CODE);
			текСтрока.SIFR = -Число(текСтрока.SIFR);
		Иначе
			СтрокаГруппы = ТаблицаГрупп.Найти(КодГруппы, "CODE");
			Если СтрокаГруппы <> Неопределено Тогда
				текСтрока.PARENTNAME = СтрокаГруппы.Name;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Таблица;
КонецФункции

// Функция возвращает таблицу складов
//
// Параметры:
//  ФорматОбмена - Произвольный - Формат обмена.
