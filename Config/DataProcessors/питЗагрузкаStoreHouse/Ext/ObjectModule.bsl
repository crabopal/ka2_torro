// СОЗДАНИЕ И ЗАПОЛНЕНИЕ ОБЪЕКТНЫХ СУЩНОСТЕЙ

// Процедура - Заполнить ссылку 1 с по соответствию.
//
// Параметры:
//  СтрутураЭлементаStoreHouse - Произвольный - Струтура элемента store house.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//
Процедура ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаStoreHouse,ИмяМетаданных)
	ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
	// Найдем или создадим ссылку в 1с по соответствию
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовStoreHouse.Ссылка1С
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовStoreHouse КАК СоответствияОбъектовStoreHouse
	               |ГДЕ
	               |	СоответствияОбъектовStoreHouse.ТипОбъекта = &ТипОбъекта
	               |	И СоответствияОбъектовStoreHouse.СсылкаStoreHouse = &СсылкаStoreHouse";
	Запрос.УстановитьПараметр("ТипОбъекта",ТипПВХ);
	Запрос.УстановитьПараметр("СсылкаStoreHouse",СтрутураЭлементаStoreHouse.УИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка1С) Тогда
		СтрутураЭлементаStoreHouse.Вставить("Ссылка1С",Выборка.Ссылка1С);
	Иначе
		Попытка
			СтрутураЭлементаStoreHouse.Вставить("Ссылка1С",Справочники[ИмяМетаданных].ПустаяСсылка());
		Исключение
			СтрутураЭлементаStoreHouse.Вставить("Ссылка1С",Перечисления[ИмяМетаданных].ПустаяСсылка());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Процедура - Получить незаполненные соответствия выборки.
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  СтруктураНезаполненныхСоответствий - Структура - Структура незаполненных соответствий.
//
Процедура ПолучитьНезаполненныеСоответствияВыборки(Выборка, СтруктураНезаполненныхСоответствий)
	СтрутураЭлементаStoreHouse = Новый Структура;
	СтрутураЭлементаStoreHouse.Вставить("УИД");
	
	// Кассы ККМ
	СтрутураЭлементаStoreHouse.УИД = Выборка.КассаУИД;
	ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаStoreHouse,"КассыККМ");
	Если Не ЗначениеЗаполнено(СтрутураЭлементаStoreHouse.Ссылка1С) Тогда
		СтруктураНезаполненныхСоответствий.КассыККМ.Добавить(СтрутураЭлементаStoreHouse.УИД);
	КонецЕсли;
	
	ВыборкаНоменклатура = Выборка.Выбрать();
	Пока ВыборкаНоменклатура.Следующий() Цикл
		// бывает, что приходит пустой УИД номенклатуры
		Если Не ЗначениеЗаполнено(ВыборкаНоменклатура.НоменклатураУИД) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрутураЭлементаStoreHouse.УИД = ВыборкаНоменклатура.НоменклатураУИД;
		ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаStoreHouse,"Номенклатура");
		Если Не ЗначениеЗаполнено(СтрутураЭлементаStoreHouse.Ссылка1С) Тогда
			СтруктураНезаполненныхСоответствий.Номенклатура.Добавить(СтрутураЭлементаStoreHouse.УИД);
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

// Происходит обход выборки из таблицы продаж StoreHouse и создание документов ДПФ
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  СтруктураНезаполненныхСоответствий - Структура - Структура незаполненных соответствий.
//
Процедура ОбходРезультатЗапросаПроверка(Выборка, СтруктураНезаполненныхСоответствий)
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Группировка() = "НомерСмены" Тогда
			ПолучитьНезаполненныеСоответствияВыборки(Выборка, СтруктураНезаполненныхСоответствий);
			#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
			#КонецЕсли
		Иначе
			Выборка1 =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
			ОбходРезультатЗапросаПроверка(Выборка1, СтруктураНезаполненныхСоответствий);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


