

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.питВидыМеню.Количество() = 0 И Объект.питТипДрайвера = 1 Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Необходимо заполнить табличную часть <Виды меню>'", "ru"));
	КонецЕсли;
КонецПроцедуры

// Обработчик выбора формы.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если НЕ ТипЗнч(ИсточникВыбора) = Тип("ФормаКлиентскогоПриложения") Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначенияВыбора = ТипЗнч(ВыбранноеЗначение);
	Если ТипЗначенияВыбора = Тип("СправочникСсылка.питВидыМеню") Тогда		
		НайденныеСтроки = Объект.питВидыМеню.НайтиСтроки(Новый Структура("ВидМеню", ВыбранноеЗначение));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ПоказатьПредупреждение(Неопределено, "Вид меню <" + СокрЛП(ВыбранноеЗначение) + "> уже есть в табличной части", , "Ошибка");
			Возврат;
		КонецЕсли;		
		НоваяСтрока = Объект.питВидыМеню.Добавить();
		НоваяСтрока.ВидМеню = ВыбранноеЗначение;
		//НоваяСтрока.ТипЦен = Объект.ТипЦен;

		ЭтотОбъект.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//+РарусЭвотор.
	Если НЕ ОбменСРарусЭвоторДоступен 
		И НЕ Элементы.ТипОбмена.СписокВыбора.НайтиПоЗначению(2) = Неопределено Тогда
		Элементы.ТипОбмена.СписокВыбора.Удалить(2);
	КонецЕсли;
	//-РарусЭвотор
	
	ОбновитьВидимость();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ОбщегоНазначения.РежимОтладки() Тогда
		СписокВыбора = Элементы.ТипОбмена.СписокВыбора;
		СписокВыбора.Добавить(2, НСтр("ru='1С:Эвотор'", "ru"));
	КонецЕсли;
	
	ОбменСРарусЭвоторДоступен = питОбменДаннымиЭвотор.ПроверитьДоступностьОбменаСРарусЭвотор();
	Элементы.ЗагрузкаДанных.Видимость = питОбменДаннымиЭвотор.ПроверитьДоступностьОбменаСЭвотор();
	Элементы.ВыгрузкаДанных.Видимость = питОбменДаннымиЭвотор.ПроверитьДоступностьОбменаСЭвотор();
	Элементы.НадписьПерейтиВКУ.Видимость = ОбменСРарусЭвоторДоступен;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ОбщепитВидыМенюПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	ВидыМенюДобавить(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ТипОбменаПриИзменении(Элемент)
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура НадписьПерейтиВКУНажатие(Элемент)
	
	Если Объект.Ссылка.Пустая() 
		ИЛИ Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Необходимо записать объект'", "ru"));
		Возврат;
	КонецЕсли;
	

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", питОбменДаннымиЭвотор.ПолучитьКассовыйУзелТерминала(Объект.Ссылка));
	ПараметрыФормы.Вставить("Наименование", Объект.Наименование);
	ПараметрыФормы.Вставить("Префикс", Объект.питПрефикс);
	ПараметрыФормы.Вставить("УзелТерминала", Объект.Ссылка);
	
	Если Объект.питТипДрайвера = 3 Тогда
		ТипУзла = 3;
	ИначеЕсли Объект.питТипДрайвера = 4 Тогда
		ТипУзла = 8;
	Иначе
		ТипУзла = 7;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Наименование", Объект.Наименование);
	ЗначенияЗаполнения.Вставить("Префикс", Объект.питПрефикс);
	ЗначенияЗаполнения.Вставить("Код", Объект.питПрефикс);
	ЗначенияЗаполнения.Вставить("УзелТерминала", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("ТипКассовогоУзла", ТипУзла);
	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("ПланОбмена.питУдаленныеКассы.Форма.ФормаУзла", ПараметрыФормы, ЭтотОбъект, , , , );
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщепитПриобрестиПриложениеОбщепитЭвоторНажатие(Элемент)
	
	АдресПриложения = "https://market.evotor.ru/store/apps/3c242479-2812-4487-88c8-cd8ba02f5aa3";
	ПерейтиКПокупкеПриложенияОбменСЭвоторРаруса(АдресПриложения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщепитПриобрестиПриложениеОбщепитРарусФастфудНажатие(Элемент)
	
	АдресПриложения = "https://market.evotor.ru/store/apps/652c1123-0d24-4721-b3a1-8b0389858b97";
	ПерейтиКПокупкеПриложенияОбменСЭвоторРаруса(АдресПриложения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщепитПриобрестиПриложениеОбщепитРарусРесторанНажатие(Элемент)
	
	АдресПриложения = "https://market.evotor.ru/store/apps/b0cad067-d726-4c3c-80d3-e990812b7110";
	ПерейтиКПокупкеПриложенияОбменСЭвоторРаруса(АдресПриложения);
	
КонецПроцедуры



#КонецОбласти

#Область ОбработчикиКомандФормы
// Обработчик команды "Виды меню добавить"
//
&НаКлиенте
Процедура ВидыМенюДобавить(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("Справочник.питВидыМеню.ФормаВыбора",ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьВидимость()
	ОбменОбщепита = Объект.питТипДрайвера = 1;
	Элементы.ОбщепитТипЦен.Доступность = ОбменОбщепита;
	Элементы.ЗагрузкаДанных.Доступность = ОбменОбщепита;
	Элементы.ВыгрузкаДанных.Доступность = ОбменОбщепита;
	
	Элементы.ОбщепитТипЦен.АвтоОтметкаНезаполненного= ОбменОбщепита;
	Элементы.ОбщепитВидыМеню.АвтоОтметкаНезаполненного = ОбменОбщепита;
	
	// В зависимости от режима установим нужную ссылку.
	Если Объект.питТипДрайвера = 3 Тогда
		ТекСтраницаМагазинаЭвотор = Элементы.СтраницаОбменОбщепитСРарусФастфуд;
	ИначеЕсли Объект.питТипДрайвера = 4 Тогда
		ТекСтраницаМагазинаЭвотор = Элементы.СтраницаОбменОбщепитСРарусРесторан;
	ИначеЕсли Объект.питТипДрайвера = 2 Тогда
		ТекСтраницаМагазинаЭвотор = Элементы.СтраницаОбменБПСЭвотор;
	Иначе
		ТекСтраницаМагазинаЭвотор = Элементы.СтраницаОбменОбщепитСЭвотор;
	КонецЕсли;
	Элементы.СтраницыГиперссылокНаМагазинПриложенийЭвотор.ТекущаяСтраница = ТекСтраницаМагазинаЭвотор;
	
КонецПроцедуры


&НаКлиенте
Процедура ПерейтиКПокупкеПриложенияОбменСЭвоторРаруса(АдресЗагрузки)
	
	питОбщегоНазначенияКлиент.ОткрытьНавигационнуюСсылку(АдресЗагрузки);
	
КонецПроцедуры

