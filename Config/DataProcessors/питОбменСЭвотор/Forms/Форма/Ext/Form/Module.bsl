Функция ВыполнитьВыгрузкуДанных(ДополнительныеПараметры)
	РезультатОбмена = Истина;
	МассивСтрок = ДополнительныеПараметры.МассивСтрок;
	
	ДополнительныеПараметры.Вставить("КоличествоОжидаемыхСтрок", МассивСтрок.Количество());
	
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		ОбработкаПрерыванияПользователя();
		
		Если ТекущаяСтрока.УзелОбмена.Пустая() ИЛИ ТекущаяСтрока.Оборудование.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаВОчереди = ОчередьОбмена.Добавить();
		НоваяСтрокаВОчереди.УзелОбмена = ТекущаяСтрока.УзелОбмена;
		НоваяСтрокаВОчереди.НомерОбмена = НомерПоследнегоОбмена;
		НоваяСтрокаВОчереди.НачалоОперацииОбмена = ТекущаяДата();
		ДополнительныеПараметры.Вставить("КлючСвязиВОчереди", НоваяСтрокаВОчереди.ПолучитьИдентификатор());
		ДополнительныеПараметры.Вставить("КлючСвязи", ТекущаяСтрока.КлючСвязи);
		ДополнительныеПараметры.Вставить("НомерОбмена", НомерПоследнегоОбмена);
		
		ОбработчикОповещения = Новый ОписаниеОповещения("ОбработчикОповещения_ВыполненияРаботыДрайвера", ЭтотОбъект, ДополнительныеПараметры);
		
		Если ТекущаяСтрока.ТипДрайвера = 1 
			ИЛИ ТекущаяСтрока.ТипДрайвера = 2 Тогда
			БПВыгрузитьДанные(ТекущаяСтрока.Оборудование, ОбработчикОповещения);
		ИначеЕсли ТекущаяСтрока.ТипДрайвера = 3
			ИЛИ ТекущаяСтрока.ТипДрайвера = 4 Тогда
			УдаленныеКассыВыгрузитьДанные(ТекущаяСтрока.КассовыйУзел, ТекущаяСтрока.НастройкаОбмена,ДополнительныеПараметры.ТипКоманды, ОбработчикОповещения);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатОбмена;
КонецФункции

