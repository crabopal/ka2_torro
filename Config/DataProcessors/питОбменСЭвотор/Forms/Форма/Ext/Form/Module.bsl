&НаКлиенте
Процедура БПВыгрузитьДанные(Оборудование,ОбработчикОповещения)
	
	// ОбработчикОповещения - по умолчанию в БП Неопределено.
	МенеджерОфлайнОборудованияКлиент.НачатьВыгрузкуДанныхНаККМ(Оборудование, УникальныйИдентификатор, ОбработчикОповещения, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура БПЗагрузитьДанные(Оборудование,ОбработчикОповещения)
	
	Результат = Истина;
	Если ТипОтбораПоПериоду > 0 Тогда
		БПУстановитьПараметрыУстройства(Оборудование, Результат);
	КонецЕсли;
	
	Если Результат Тогда
		// ОбработчикОповещения - по умолчанию Неопределено.
		МенеджерОфлайнОборудованияКлиент.НачатьЗагрузкуДанныхИзККМ(Оборудование, УникальныйИдентификатор, ОбработчикОповещения,Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура БПОчиститьПрайсЛист(Оборудование,ОбработчикОповещения)
	
	// ОбработчикОповещения - по умолчанию Неопределено.
	МенеджерОфлайнОборудованияКлиент.НачатьОчисткуПрайсЛистаНаККМ(Оборудование, УникальныйИдентификатор, ОбработчикОповещения,Ложь);
	
КонецПроцедуры

&НаСервере
Процедура БПУстановитьПараметрыУстройства(ИдентификаторУстройства, Результат)
	
	Результат = Неопределено;
	УстановитьПривилегированныйРежим(Истина);
	ДанныеУстройства = МенеджерОфлайнОборудованияВызовСервера.ДанныеУстройства(ИдентификаторУстройства);
	Если Не ДанныеУстройства.Параметры.Свойство("ДатаНачала") ИЛИ Не ДанныеУстройства.Параметры.Свойство("ДатаОкончания") Тогда
		// Не будем возвращать ошибку, а просто подготовим требуемую структуру.
		ДанныеУстройства.Параметры.Вставить("ДатаНачала");
		ДанныеУстройства.Параметры.Вставить("ДатаОкончания");
		ДанныеУстройства.Параметры.Вставить("ЭтоПерваяЗагрузка");
		ДанныеУстройства.Параметры.Вставить("ПериодИзмененВручную");
	КонецЕсли;
	ДанныеУстройства.Параметры.ДатаНачала           = ДатаНачала;
	ДанныеУстройства.Параметры.ДатаОкончания        = ДатаОкончания;
	ДанныеУстройства.Параметры.ЭтоПерваяЗагрузка    = Истина;
	
	НаборЗаписей = РегистрыСведений.ДатаЗагрузкиОтчетовКассЭвотор.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КассаЭвотор.Значение = ИдентификаторУстройства;
	НаборЗаписей.Отбор.КассаЭвотор.Использование = Истина;
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		Запись             = НаборЗаписей.Добавить();
		Запись.КассаЭвотор = ИдентификаторУстройства;
		Запись.ДатаПоследнейЗакрытойКассовойСмены = ДатаНачала;
		НаборЗаписей.Записать();
	КонецЕсли;
	
	ДанныеУстройства.Параметры.ПериодИзмененВручную = Истина;
	РезультатЗавершения = МенеджерОфлайнОборудованияВызовСервера.СохранитьПараметрыУстройства(ИдентификаторУстройства, ДанныеУстройства.Параметры);
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗавершения Тогда
		Результат = РезультатЗавершения;
		ОбновитьПовторноИспользуемыеЗначения();
	Иначе
		Результат = Ложь;
		СообщениеОбОшибке = НСтр("ru='Не удалось сохранить параметры устройства.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбменСУдаленнымиКассами

&НаКлиенте
Процедура УдаленныеКассыВыгрузитьДанные(ТекУзелОбмена, ТекНастройкаДоставки, ТекКоманда, ОбработчикОповещения)
	
	ПарамРезультат = УдаленныеКассыВыполнитьВыгрузкуСервер(ТекУзелОбмена,ТекНастройкаДоставки, ТекКоманда);
	
	ВыполнитьОбработкуОповещения(ОбработчикОповещения, ПарамРезультат);
	
КонецПроцедуры

// Функция вызова серверного процесса выгрузки данных.
//
&НаСервере
Функция УдаленныеКассыВыполнитьВыгрузкуСервер(ТекУзелОбмена,ТекНастройкаДоставки, ТекКоманда)
	
	ПолученныйОбъект = Обработки.питОбменСУдаленнымиКассами.Создать();
	ПолученныйОбъект.УзелОбмена = ТекУзелОбмена;
	ПолученныйОбъект.НастройкаОбмена = ТекНастройкаДоставки;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Результат", Истина);
	ДополнительныеПараметры.Вставить("ОписаниеОшибки", "");

	
	НачальныйОбраз = ТекКоманда = 5;
	ПолнаяРегистрация = ТекКоманда = 6; 
	ДополнительныеПараметры.Результат = ПолученныйОбъект.ВыполнитьВыгрузку(НачальныйОбраз, ДополнительныеПараметры.ОписаниеОшибки, ПолнаяРегистрация).Результат;
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Процедура УдаленныеКассыЗагрузитьДанные(ТекУзелОбмена,ТекНастройкаДоставки, ОбработчикОповещения)
	
	ПарамРезультат = УдаленныеКассыВыполнитьЗагрузкуСервер(ТекУзелОбмена,ТекНастройкаДоставки);
	
	ВыполнитьОбработкуОповещения(ОбработчикОповещения, ПарамРезультат);
	
КонецПроцедуры

// Функция вызова серверного процесса выгрузки данных.
//
&НаСервере
Функция УдаленныеКассыВыполнитьЗагрузкуСервер(ТекУзелОбмена,ТекНастройкаДоставки)
	
	ПолученныйОбъект = Обработки.питОбменСУдаленнымиКассами.Создать();
	ПолученныйОбъект.УзелОбмена = ТекУзелОбмена;
	ПолученныйОбъект.НастройкаОбмена = ТекНастройкаДоставки;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Результат", Истина);
	ДополнительныеПараметры.Вставить("ОписаниеОшибки", "");
	
	ДополнительныеПараметры.Результат = ПолученныйОбъект.ВыполнитьЗагрузку(ДополнительныеПараметры.ОписаниеОшибки, Истина);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

// Функция вызова серверного процесса выгрузки данных.
//
&НаСервере
Функция УдаленныеКассыВыполнитьПолнуюРегистрациюСервер(ТекУзелОбмена)
	
	ПолученныйОбъект = Обработки.питОбменСУдаленнымиКассами.Создать();
	ПолученныйОбъект.УзелОбмена = ТекУзелОбмена;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Результат", Истина);
	ДополнительныеПараметры.Вставить("ОписаниеОшибки", "");
	
	ДополнительныеПараметры.Результат = ПолученныйОбъект.ВыполнитьПолнуюРегистрацию(ДополнительныеПараметры.ОписаниеОшибки);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

#КонецОбласти

&НаСервере
Процедура ПередЗакрытиемНаСервере()
	СохранитьНастройки();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокУзловНаСервере()
	
	// Получим список всех узлов, при этом сохранив текущие флажки использования.
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СписокУзлов.Пометка КАК Пометка,
	|	СписокУзлов.УзелОбмена КАК УзелОбмена
	|ПОМЕСТИТЬ ТЗ_СписокУзловСПометками
	|ИЗ
	|	&СписокУзлов КАК СписокУзлов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_СписокУзловСПометками.Пометка) КАК Пометка,
	|	ВТ_СписокУзловСПометками.УзелОбмена КАК УзелОбмена
	|ПОМЕСТИТЬ ВТ_СписокУзловСПометками
	|ИЗ
	|	ТЗ_СписокУзловСПометками КАК ВТ_СписокУзловСПометками
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СписокУзловСПометками.УзелОбмена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборудованиеПоОрганизациям.Ссылка КАК Оборудование,
	|	ОборудованиеПоОрганизациям.УзелИнформационнойБазы КАК УзелОбмена,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питТипДрайвера, 0) КАК ТипДрайвера,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питПрефикс, """") КАК Префикс,
	|	ОборудованиеПоОрганизациям.Организация КАК Организация,
	|	ЕСТЬNULL(питУдаленныеКассы.Ссылка, ЗНАЧЕНИЕ(ПланОбмена.питУдаленныеКассы.ПустаяСсылка)) КАК КассовыйУзел,
	|	питУдаленныеКассы.НастройкаДоставкиПоУмолчанию КАК НастройкаОбмена,
	|	ЕСТЬNULL(питУдаленныеКассы.НомерОтправленного, 0) КАК НомерОтправленного,
	|	ЕСТЬNULL(СостоянияОбменовДаннымиВыгрузка.ДатаОкончания,ОбменСПодключаемымОборудованиемOffline.ДатаЗагрузки) КАК ДатаЗагрузка,
	|	ЕСТЬNULL(СостоянияОбменовДаннымиЗагрузка.ДатаОкончания,ОбменСПодключаемымОборудованиемOffline.ДатаВыгрузки) КАК ДатаВыгрузка
	|ПОМЕСТИТЬ ВТ_ОборудованияСУзлами
	|ИЗ
	|	ПланОбмена.ОбменСПодключаемымОборудованиемOffline КАК ОбменСПодключаемымОборудованиемOffline
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОфлайнОборудование КАК ОборудованиеПоОрганизациям
	|		ПО ОбменСПодключаемымОборудованиемOffline.Ссылка = ОборудованиеПоОрганизациям.УзелИнформационнойБазы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.[СостоянияОбменовДанными] КАК СостоянияОбменовДаннымиВыгрузка
	|			ПО питУдаленныеКассы.Ссылка = СостоянияОбменовДаннымиВыгрузка.УзелИнформационнойБазы
	|				И СостоянияОбменовДаннымиВыгрузка.ДействиеПриОбмене = &ДействиеВыгрузка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.[СостоянияОбменовДанными] КАК СостоянияОбменовДаннымиЗагрузка
	|			ПО питУдаленныеКассы.Ссылка = СостоянияОбменовДаннымиЗагрузка.УзелИнформационнойБазы
	|				И СостоянияОбменовДаннымиЗагрузка.ДействиеПриОбмене = &ДействиеЗагрузка
	|		ПО ОбменСПодключаемымОборудованиемOffline.Ссылка = питУдаленныеКассы.УзелТерминала
	|ГДЕ
	|	НЕ ОбменСПодключаемымОборудованиемOffline.Ссылка = &ЭтотУзел
	|	И НЕ ОбменСПодключаемымОборудованиемOffline.питТипДрайвера = 0
	|	И НЕ ОбменСПодключаемымОборудованиемOffline.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОборудованияСУзлами.УзелОбмена КАК УзелОбмена,
	|	ЛОЖЬ КАК Пометка,
	|	ВТ_ОборудованияСУзлами.ДатаВыгрузка КАК ДатаВыгрузка,
	|	ВТ_ОборудованияСУзлами.ДатаЗагрузка КАК ДатаЗагрузка,
	|	ВТ_ОборудованияСУзлами.ТипДрайвера КАК ТипДрайвера,
	|	ВТ_ОборудованияСУзлами.Префикс КАК Префикс,
	|	ВТ_ОборудованияСУзлами.Оборудование КАК Оборудование,
	|	ВТ_ОборудованияСУзлами.Организация КАК Организация,
	|	ВТ_ОборудованияСУзлами.КассовыйУзел КАК КассовыйУзел,
	|	ВТ_ОборудованияСУзлами.НастройкаОбмена КАК НастройкаОбмена,
	|	ВТ_ОборудованияСУзлами.НомерОтправленного КАК НомерОтправленного
	|ПОМЕСТИТЬ СписокВсехУзлов
	|ИЗ
	|	ВТ_ОборудованияСУзлами КАК ВТ_ОборудованияСУзлами
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокВсехУзлов.УзелОбмена КАК УзелОбмена,
	|	СписокВсехУзлов.ДатаВыгрузка КАК ДатаВыгрузка,
	|	СписокВсехУзлов.ДатаЗагрузка КАК ДатаЗагрузка,
	|	СписокВсехУзлов.ТипДрайвера КАК ТипДрайвера,
	|	СписокВсехУзлов.Префикс КАК Префикс,
	|	СписокВсехУзлов.Оборудование КАК Оборудование,
	|	ЕСТЬNULL(ВТ_СписокУзловСПометками.Пометка, ЛОЖЬ) КАК Пометка,
	|	СписокВсехУзлов.Организация КАК Организация,
	|	СписокВсехУзлов.КассовыйУзел КАК КассовыйУзел,
	|	СписокВсехУзлов.НастройкаОбмена КАК НастройкаОбмена,
	|	СписокВсехУзлов.НомерОтправленного КАК НомерОтправленного
	|ИЗ
	|	СписокВсехУзлов КАК СписокВсехУзлов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СписокУзловСПометками КАК ВТ_СписокУзловСПометками
	|		ПО СписокВсехУзлов.УзелОбмена = ВТ_СписокУзловСПометками.УзелОбмена";
	
	Если питОбменДанными.РазделениеВключено() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[СостоянияОбменовДанными]", "СостоянияОбменовДаннымиОбластейДанных");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[СостоянияОбменовДанными]", "СостоянияОбменовДанными");
	КонецЕсли;
	Запрос.УстановитьПараметр("ДействиеВыгрузка", Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	Запрос.УстановитьПараметр("ДействиеЗагрузка", Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	
	Запрос.УстановитьПараметр("СписокУзлов", СписокУзлов.Выгрузить());
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменСПодключаемымОборудованиемOffline.ЭтотУзел());
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	СписокУзлов.Очистить();
		
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			// Заполним полный список терминалов.
			НоваяСтрока = СписокУзлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Если НЕ ЗначениеЗаполнено(Выборка.ДатаВыгрузка) Тогда
				НоваяСтрока.ПоследняяВыгрузка = НСтр("ru='Не производилась'", "ru");
			Иначе
				НоваяСтрока.ПоследняяВыгрузка = СтрШаблон(НСтр("ru='Дата выгрузки:  %1'", "ru"), Формат(Выборка.ДатаВыгрузка));
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Выборка.ДатаЗагрузка) Тогда
				НоваяСтрока.ПоследняяЗагрузка = "Не производилась";
			Иначе
				НоваяСтрока.ПоследняяЗагрузка = СтрШаблон(НСтр("ru='Дата загрузки: %1'", "ru"), Формат(Выборка.ДатаЗагрузка));
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоСпискуУзлов()
	
	ДополнительныеПараметры = Новый Структура;
	Если ЗначениеЗаполнено(УзелОтбор) Тогда
		ДополнительныеПараметры.Вставить("УзелОбмена",УзелОтбор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОрганизацияОтбор) Тогда
		ДополнительныеПараметры.Вставить("Организация",ОрганизацияОтбор);
	КонецЕсли;
	
	Если ДополнительныеПараметры.Количество() Тогда
		СтруктураОтбора = Новый ФиксированнаяСтруктура(ДополнительныеПараметры);
	Иначе
		СтруктураОтбора = Неопределено;
	КонецЕсли;
	
	Элементы.СписокУзлов.ОтборСтрок = СтруктураОтбора;
	
КонецПроцедуры //УстановитьОтборПоСпискуУзлов

&НаКлиенте
Процедура ИзменитьВсеФлажки(Установить)
	Для Каждого ТекУзел Из СписокУзлов Цикл
		ТекУзел.Пометка = Установить;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОбменСТерминалами(ТипКоманды)
	// Сформируем массив терминалов для выгрузки.
	МассивСтрок = СписокУзлов.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны терминалы!", , "СписокУзлов");
		Возврат;
	КонецЕсли;
	
	// Очистим временную таблицу для проверок.
	ВТУзлыОбмена.Очистить();
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		НоваяСтрока = ВТУзлыОбмена.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
		НоваяСтрока.КлючСвязи = ТекСтрока.ПолучитьИдентификатор();
	КонецЦикла;
	
	// Подготовим структуру с параметрами.
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПроверкаУспешна",Истина);
	ДополнительныеПараметры.Вставить("ТипКоманды", ТипКоманды);
	ДополнительныеПараметры.Вставить("МассивСтрок",Новый Массив);
	ДополнительныеПараметры.Вставить("ТекущаяСтрока");

	// Начнем проверку.
	ПроверитьВременныеУзлыОбменаВЦикле(ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВременныеУзлыОбменаВЦикле(ДополнительныеПараметры)
	Если ВТУзлыОбмена.Количество() > 0 Тогда
		// Если еще остались строки на проверку, то очистим из них с пустыми ссылками узлов.
		ТекущаяСтрока = ВТУзлыОбмена[0];
		Если ТекущаяСтрока.УзелОбмена.Пустая() Тогда
			ВТУзлыОбмена.Удалить(0);
			ПроверитьВременныеУзлыОбменаВЦикле(ДополнительныеПараметры);
		Иначе
			// Зафиксируем текущую строку.
			ДополнительныеПараметры.ТекущаяСтрока = ТекущаяСтрока;
			
			Если ТекущаяСтрока.НомерОтправленного > 0 И ДополнительныеПараметры.ТипКоманды = 5 Тогда
				ТекстВопроса = "В узел """ + СокрЛП(ТекущаяСтрока.УзелОбмена) +  "" + " уже отправлено сообщений: " + СокрЛП(ТекущаяСтрока.НомерОтправленного) 
				+ ".
				|    ПРЕДУПРЕЖДЕНИЕ! При выгрузке начального образа в кассовом узле будет произведена полная перезаливка его базы.
				|Если какие-то данные не были получены и загружены в базу БЭК-офиса, то они могут быть БЕЗВОЗВРАТНО ПОТЕРЯНЫ!!! 
				|   Желаете продолжить данную операцию?";
				ОписаниеОповещения = Новый ОписаниеОповещения("ОповещениеПоВыгрузкеВНачальныйУзел",ЭтотОбъект,ДополнительныеПараметры);
				ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет,25, КодВозвратаДиалога.Нет);
			Иначе
				ОповещениеПоВыгрузкеВНачальныйУзел(КодВозвратаДиалога.Да,ДополнительныеПараметры);
			КонецЕсли;
		КонецЕсли;
	Иначе
		// Иначе пойдем дальше.
		ЗавершитьПроверкуВременныхУзловОбмена(ДополнительныеПараметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПроверкуВременныхУзловОбмена(ДополнительныеПараметры)
	МассивСтрок = ДополнительныеПараметры.МассивСтрок;
	
	ДополнительныеПараметры.Вставить("ТекстСообщения","");
	ДополнительныеПараметры.Вставить("ВыводитьСообщения", Ложь);
	
	ПроверятьВыгрузку = (ДополнительныеПараметры.ТипКоманды = 1) ИЛИ (ДополнительныеПараметры.ТипКоманды = 3) ИЛИ (ДополнительныеПараметры.ТипКоманды = 5);
	ПроверятьЗагрузку = (ДополнительныеПараметры.ТипКоманды = 2) ИЛИ (ДополнительныеПараметры.ТипКоманды = 3);
	
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		
		Если ТекущаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПроверитьНастройкиУзланаКлиенте(ТекущаяСтрока, ПроверятьВыгрузку, ПроверятьЗагрузку,ДополнительныеПараметры) Тогда
			ДополнительныеПараметры.ПроверкаУспешна = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ДополнительныеПараметры.ПроверкаУспешна Тогда
		Если ЗначениеЗаполнено(ДополнительныеПараметры.ТекстСообщения) Тогда
			ТекстДиалога = ДополнительныеПараметры.ТекстСообщения + "Из-за обнаруженых ошибок операция обмена отменяется!";
			ПоказатьПредупреждение(Неопределено,ТекстДиалога);
		КонецЕсли;
		Возврат; 
	КонецЕсли;
	
	ОповещениеПроверкиНастроекУзла(Неопределено, ДополнительныеПараметры);
КонецПроцедуры

// Функция проверки настроек узла и отображения сообщения пользователю.
//
&НаКлиенте
Функция ПроверитьНастройкиУзланаКлиенте(ТекущаяСтрока, ПроверятьВажныеДляВыгрузки = Истина, ПроверятьВажныеДляЗагрузки = Истина, ДополнительныеПараметры)
	
	ПроверяемыйУзел = ТекущаяСтрока.УзелОбмена;
	ПроверяемыйКассовыйУзел = ТекущаяСтрока.КассовыйУзел;
	ПроверяемаяНастройкаДоставки = ТекущаяСтрока.НастройкаОбмена;
	ОбнаруженыКритическиеОшибки = Ложь;
	СообщениеООшибках = "";
	СообщениеОКритическихОшибках = "";
	
	
	// Каталог на клиенте. Проверка способа доставки.
	ДанныеНастройкиОбмена = питОбменДанными.ПолучитьДанныеНастройкиОбмена(ПроверяемаяНастройкаДоставки);
	Если ЗначениеЗаполнено(ПроверяемыйКассовыйУзел) И НЕ ЗначениеЗаполнено(ПроверяемаяНастройкаДоставки) Тогда
		СообщениеООшибках = "Настройка доставки не указана, необходимо выбрать настройку доставки.";
	КонецЕсли;
	
	Если НЕ (ТекущаяСтрока.ТипДрайвера = 3 ИЛИ ТекущаяСтрока.ТипДрайвера = 4) 
		И ТипОтбораПоПериоду > 0 Тогда
		Если ЗначениеЗаполнено(ДатаОкончания) И ДатаНачала > ДатаОкончания Тогда
			ОбнаруженыКритическиеОшибки = Истина;
			СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + НСтр("ru='Неправильно задан период. Начало периода не может быть больше конца периода'", "ru") + Символы.ПС;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
			ОбнаруженыКритическиеОшибки = Истина;
			СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + НСтр("ru='Неправильно задан период. Начало периода не может быть пустой'", "ru") + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ОбнаруженыКритическиеОшибки Тогда
		ПроверитьНастройкиУзлаНаСервере(ТекущаяСтрока.ТипДрайвера,ПроверяемыйУзел, ПроверяемыйКассовыйУзел, ПроверятьВажныеДляВыгрузки, ПроверятьВажныеДляЗагрузки, Ложь, ОбнаруженыКритическиеОшибки, СообщениеООшибках, СообщениеОКритическихОшибках, ДополнительныеПараметры.ТипКоманды);
	КонецЕсли;
	
	Если ОбнаруженыКритическиеОшибки Тогда
		// Определим режим диалога сообщения. Если были критические ошибки, то просто сообщим о них.
		// Если же были только простые ошибки, то спросим пользователя продолжать или нет.
		
		СообщениеОКритическихОшибках = ?(ОбнаруженыКритическиеОшибки, "Критические:" + СообщениеОКритическихОшибках + Символы.ПС + Символы.ПС, "");
		
		ПостфиксСообщения = ?(ОбнаруженыКритическиеОшибки, "Из-за обнаруженых ошибок операция обмена отменяется!", "Продолжить?");
		
		// Соберем сообщение
		ТекстДиалога = "При проверке узла <" + Строка(ПроверяемыйУзел) + "> обнаружены ошибки." + Символы.ПС
		+ СообщениеОКритическихОшибках
		+ СообщениеООшибках;
		
		Если ДополнительныеПараметры.Свойство("ВыводитьСообщения") И ДополнительныеПараметры.ВыводитьСообщения Тогда
			ТекстДиалога = ТекстДиалога + ПостфиксСообщения;
			ПоказатьПредупреждение(Неопределено,ТекстДиалога);
		Иначе
			ДополнительныеПараметры.ТекстСообщения = ДополнительныеПараметры.ТекстСообщения + ТекстДиалога + Символы.ПС;
		КонецЕсли;
		
		Возврат Ложь;
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// Функция проверки настроек узла.
//
&НаСервере
Функция ПроверитьНастройкиУзлаНаСервере(ТипДрайвера,ПроверяемыйУзел, ПроверяемыйКассовыйУзел,ПроверятьВажныеДляВыгрузки, ПроверятьВажныеДляЗагрузки, ОбнаруженыОшибки, ОбнаруженыКритическиеОшибки, СообщениеООшибках, СообщениеОКритическихОшибках, ТипКоманды)
	Если НЕ (ТипДрайвера = 3 ИЛИ ТипДрайвера = 4) Тогда
		ПроверитьНастройкиУзла(ПроверяемыйУзел, ПроверятьВажныеДляВыгрузки, ПроверятьВажныеДляЗагрузки , ОбнаруженыОшибки, ОбнаруженыКритическиеОшибки, СообщениеООшибках, СообщениеОКритическихОшибках);
	Иначе
		Обработки.питОбменСУдаленнымиКассами.ПроверитьНастройкиУзла(ПроверяемыйКассовыйУзел, ПроверятьВажныеДляВыгрузки, ПроверятьВажныеДляЗагрузки, Истина, ОбнаруженыОшибки, ОбнаруженыКритическиеОшибки, СообщениеООшибках, СообщениеОКритическихОшибках);
	КонецЕсли;
КонецФункции

