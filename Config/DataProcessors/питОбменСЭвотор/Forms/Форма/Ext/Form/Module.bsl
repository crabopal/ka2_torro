&НаКлиенте
Процедура ОбработатОбменЗавершение(МассивСтрокОчереди, ДополнительныеПараметры)
	// Подготовим параметры для вывода.
	ОписаниеОшибок = "";
	РезультатОбмена = Истина;
	ВыводитьИнформациюПоОбмену = Истина;
	МассивСтрокОчередиФиксации = Новый Массив;
	
	// Соберем результаты по всем строкам при этом параллельно очищая их из списка.
	Для Каждого ТекСтрока Из МассивСтрокОчереди Цикл
		Если НЕ ТекСтрока.Результат Тогда
			РезультатОбмена = Ложь;
			Если ЗначениеЗаполнено(ТекСтрока.ОписаниеОшибки) Тогда
				ОписаниеОшибок =  СтрШаблон("%1- <%2>: %3%4",ОписаниеОшибок, ТекСтрока.УзелОбмена, ТекСтрока.ОписаниеОшибки, Символы.ПС);
			КонецЕсли;
		КонецЕсли;
		СтрокаОчереди = Новый Структура("УзелОбмена,Результат, НачалоОперацииОбмена, ТипКоманды");
		ЗаполнитьЗначенияСвойств(СтрокаОчереди,ТекСтрока);
		Если ДополнительныеПараметры.ТипКоманды = 3 Тогда
			СтрокаОчереди.ТипКоманды = 2;
			МассивСтрокОчередиФиксации.Добавить(СтрокаОчереди);
			СтрокаОчереди.ТипКоманды = 1;
			МассивСтрокОчередиФиксации.Добавить(СтрокаОчереди);
			СтрокаОчереди.ТипКоманды = 2;
			МассивСтрокОчередиФиксации.Добавить(СтрокаОчереди);
		Иначе
			СтрокаОчереди.ТипКоманды = ДополнительныеПараметры.ТипКоманды;
			МассивСтрокОчередиФиксации.Добавить(СтрокаОчереди);
		КонецЕсли;
		ОчередьОбмена.Удалить(ТекСтрока);
	КонецЦикла;
	
	// Если общий результат итерации успешный, но обмен не завершен, то перейдем к следующей итерации.
	Если РезультатОбмена Тогда
		Если (ДополнительныеПараметры.НомерТекущейИтерации < ДополнительныеПараметры.КоличествоИтераций) Тогда
			ВыводитьИнформациюПоОбмену = Ложь;
			
			ДополнительныеПараметры.НомерТекущейИтерации = ДополнительныеПараметры.НомерТекущейИтерации + 1;
			Если ДополнительныеПараметры.ТипКоманды = 3 Тогда
				Если ДополнительныеПараметры.НомерТекущейИтерации = 2 Тогда
					ВыполнитьВыгрузкуДанных(ДополнительныеПараметры);
				ИначеЕсли ДополнительныеПараметры.НомерТекущейИтерации = 3 Тогда
					ВыполнитьЗагрузкуДанных(ДополнительныеПараметры);
				КонецЕсли;
			КонецЕсли;
		Иначе
			
			// Если требуется сформировать целевые, то выполним формирование.
			Если (ДополнительныеПараметры.ТипКоманды = 2 ИЛИ ДополнительныеПараметры.ТипКоманды = 3) И СоздаватьЦелевые Тогда
				ФормированиеЦелевыхДокументовНаСервере();
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ВыводитьИнформациюПоОбмену Тогда
		СтруктураВыводимогоТекста = ПолучитьСтруктуруВыводимогоТекста(ДополнительныеПараметры.ТипКоманды);

		Если РезультатОбмена Тогда
			ТекстСообщения = СтруктураВыводимогоТекста.ТекстСообщенияУспеха;
		Иначе
			ТекстСообщения = СтруктураВыводимогоТекста.ТекстСообщенияСОшибкой;
			Если ЗначениеЗаполнено(ОписаниеОшибок) Тогда
				ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибок;
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьРезультатНаСервере(РезультатОбмена,ТекстСообщения, МассивСтрокОчередиФиксации);
		
		ПоказатьПредупреждение(Неопределено, ТекстСообщения,,СтруктураВыводимогоТекста.ЗаголовокСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтруктуруВыводимогоТекста(ТипКоманды)
	Результат = Новый Структура("ЗаголовокСообщения, ТекстСообщенияУспеха, ТекстСообщенияСОшибкой","","","");
	Если ТипКоманды = 1 Тогда
		Результат.ЗаголовокСообщения = НСтр("ru='Итог выгрузки'", "ru");
		Результат.ТекстСообщенияУспеха = НСтр("ru='Выгрузка сообщения обмена успешно завершена!'", "ru");
		Результат.ТекстСообщенияСОшибкой = НСтр("ru='Выгрузка сообщения обмена закончилось с ошибками!'", "ru");
	ИначеЕсли ТипКоманды = 2 Тогда
		Результат.ЗаголовокСообщения = НСтр("ru='Итог загрузки'", "ru");
		Результат.ТекстСообщенияУспеха = НСтр("ru='Загрузка сообщения обмена завершена!'", "ru");
		Результат.ТекстСообщенияСОшибкой = НСтр("ru='Загрузка сообщения обмена закончилось с ошибками!'", "ru");
	ИначеЕсли ТипКоманды = 3 Тогда
		Результат.ЗаголовокСообщения = НСтр("ru='Итог обмена'", "ru");
		Результат.ТекстСообщенияУспеха = НСтр("ru='Обмен успешно завершен!'", "ru");
		Результат.ТекстСообщенияСОшибкой = НСтр("ru='Обмен закончился с ошибками!'", "ru");
	ИначеЕсли ТипКоманды = 4 Тогда
		Результат.ЗаголовокСообщения = НСтр("ru='Итог очистки'", "ru");
		Результат.ТекстСообщенияУспеха = НСтр("ru='Очистка данных успешно завершена!'", "ru");
		Результат.ТекстСообщенияСОшибкой = НСтр("ru='Очистка данных закончилась с ошибками!'", "ru");
	ИначеЕсли ТипКоманды = 5 Тогда
		Результат.ЗаголовокСообщения = НСтр("ru='Итог выгрузки начального образа'", "ru");
		Результат.ТекстСообщенияУспеха = НСтр("ru='Выгрузка начального образа успешно завершена!'", "ru");
		Результат.ТекстСообщенияСОшибкой = НСтр("ru='Выгрузка начального образа закончилось с ошибками!'", "ru");
	ИначеЕсли ТипКоманды = 6 Тогда
		Результат.ЗаголовокСообщения = НСтр("ru='Результат операции'", "ru");
		Результат.ТекстСообщенияУспеха = НСтр("ru='Регистрация данных успешно завершена!'", "ru");
		Результат.ТекстСообщенияСОшибкой = НСтр("ru='Регистрация данных закончилась с ошибками!'", "ru");
	Иначе
		Результат.ЗаголовокСообщения = НСтр("ru='Итог обмена'", "ru");
		Результат.ТекстСообщенияУспеха = НСтр("ru='Обмен успешно завершен!'", "ru");
		Результат.ТекстСообщенияСОшибкой = НСтр("ru='Обмен закончился с ошибками!'", "ru");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура СохранитьНастройки()
	ХранилищеОбщихНастроек.Сохранить("питОбменСЭвотор_СписокУзлов", , СписокУзлов.Выгрузить());
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройки()
	// Восстанавливаем настройки.
	питОбменСЭвотор_СписокУзлов = ХранилищеОбщихНастроек.Загрузить("питОбменСЭвотор_СписокУзлов");
	Если питОбменСЭвотор_СписокУзлов <> Неопределено Тогда
		СписокУзлов.Очистить();
		Для Каждого ТекСтрока Из питОбменСЭвотор_СписокУзлов Цикл
			НоваяСтрока = СписокУзлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьРезультатНаСервере(РезультатОбмена,ТекстСообщения, МассивОчереди)
	Если Не РезультатОбмена Тогда
		// Зафиксируем в журнале регистрации.
		питОбменДанными.ЗафиксироватьСобытие("ОбменСЭвотор",ТекстСообщения,,УровеньЖурналаРегистрации.Ошибка);
	КонецЕсли;
	
	СоответствиеТипКоманды = Новый Соответствие;
	СоответствиеТипКоманды.Вставить(1,Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	СоответствиеТипКоманды.Вставить(2,Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	Для Каждого ТекСтрока Из МассивОчереди Цикл
		ДействиеПриОбмене = СоответствиеТипКоманды.Получить(ТекСтрока.ТипКоманды);
		Если ДействиеПриОбмене = Неопределено Тогда
			ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
		КонецЕсли;

		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы",ТекСтрока.УзелОбмена);
		СтруктураЗаписи.Вставить("ДействиеПриОбмене",ДействиеПриОбмене);
		СтруктураЗаписи.Вставить("РезультатВыполненияОбмена",?(ТекСтрока.Результат, Перечисления.РезультатыВыполненияОбмена.Выполнено, Перечисления.РезультатыВыполненияОбмена.Ошибка));
		СтруктураЗаписи.Вставить("ДатаНачала",ТекСтрока.НачалоОперацииОбмена);
		СтруктураЗаписи.Вставить("ДатаОкончания",ТекущаяДата());
		
		РегистрыСведений.СостоянияОбменовДанными.ДобавитьЗапись(СтруктураЗаписи);
		
	КонецЦикла;
	
	ОбновитьСписокУзловНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИсключениеОшибки(ОбработчикОповещения)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Результат", Ложь);
	ДополнительныеПараметры.Вставить("ОписаниеОшибки", НСтр("ru='Команда не поддерживается'", "ru"));
	
	ВыполнитьОбработкуОповещения(ОбработчикОповещения, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПериод()
	
	ПериодДоступен = Ложь;
	Если ТипОтбораПоПериоду = 0 Тогда
		ДатаНачала = Дата('00010101');
		ДатаОкончания = Дата('00010101');
	ИначеЕсли ТипОтбораПоПериоду = 1 Тогда
		ДатаНачала = НачалоДня(ТекущаяДата());
		ДатаОкончания = КонецДня(ТекущаяДата());
	ИначеЕсли ТипОтбораПоПериоду = 2 Тогда
		ДатаНачала = НачалоДня(НачалоДня(ТекущаяДата())-1);
		ДатаОкончания = НачалоДня(ТекущаяДата())-1;
	ИначеЕсли ТипОтбораПоПериоду = 3 Тогда
		ПериодДоступен = Истина;
	КонецЕсли;
	
	Элементы.ГруппаПериодОтбора.Доступность = ПериодДоступен;
	Элементы.ДатаНачала.АвтоОтметкаНезаполненного = ПериодДоступен;
	Элементы.ДатаОкончания.АвтоОтметкаНезаполненного = ПериодДоступен;
	
КонецПроцедуры

&НаСервере
Процедура ФормированиеЦелевыхДокументовНаСервере()
	
	КассовыеУзлы = Новый ТаблицаЗначений;
	КассовыеУзлы.Колонки.Добавить("УзелОбмена");
	
	Для Каждого ТекСтрока Из СписокУзлов Цикл
		Если НЕ ТекСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.КассовыйУзел) Тогда
			НоваяСтрока = КассовыеУзлы.Добавить();
			НоваяСтрока.УзелОбмена = ТекСтрока.КассовыйУзел;
		КонецЕсли;
	КонецЦикла;
	
	Если КассовыеУзлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("КассовыеУзлы", КассовыеУзлы);
	питОбменДанными.ЗагрузкаИзДанныхПродажФронта(СтруктураПараметров);
КонецПроцедуры

