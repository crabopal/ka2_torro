

#Область ПрограммныйИнтерфейс
// Процедура - ОповещениеПоВыгрузкеВНачальныйУзел.
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры.
//
&НаКлиенте
Процедура ОповещениеПоВыгрузкеВНачальныйУзел(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	Если РезультатОткрытияФормы = КодВозвратаДиалога.Да Тогда
		ДополнительныеПараметры.МассивСтрок.Добавить(ДополнительныеПараметры.ТекущаяСтрока);
	КонецЕсли;
	
	// Если строки еще остались, то удалим первую, т.к. брали ее же для проверок.
	Если ВТУзлыОбмена.Количество() > 0 Тогда
		ВТУзлыОбмена.Удалить(0);
	КонецЕсли;
	
	ПроверитьВременныеУзлыОбменаВЦикле(ДополнительныеПараметры);
КонецПроцедуры //ОповещениеПоВыгрузкеВНачальныйУзел.

// Процедура - Оповещение проверки настроек узла
//
// Параметры:
//  РезультатФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры
//
&НаКлиенте
Процедура ОповещениеПроверкиНастроекУзла(РезультатФормы, ДополнительныеПараметры) Экспорт
	
	Если РезультатФормы = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	НомерПоследнегоОбмена = НомерПоследнегоОбмена + 1;
	
	ДополнительныеПараметры.Вставить("КоличествоИтераций",1);
	ДополнительныеПараметры.Вставить("НомерТекущейИтерации",1);
	Если ДополнительныеПараметры.ТипКоманды = 1  Тогда
		ВыполнитьВыгрузкуДанных(ДополнительныеПараметры);
	ИначеЕсли ДополнительныеПараметры.ТипКоманды = 2 Тогда
		ВыполнитьЗагрузкуДанных(ДополнительныеПараметры);
	ИначеЕсли ДополнительныеПараметры.ТипКоманды = 3 Тогда
		// Дальнейшая выгрузка и повторная загрузка будет после обработки асинхронного вызова.
		ВыполнитьЗагрузкуДанных(ДополнительныеПараметры);
	ИначеЕсли ДополнительныеПараметры.ТипКоманды = 4 Тогда
		ВыполнитьОчисткуДанных(ДополнительныеПараметры);
	ИначеЕсли ДополнительныеПараметры.ТипКоманды = 5 Тогда
		ВыполнитьВыгрузкуДанных(ДополнительныеПараметры);
	ИначеЕсли ДополнительныеПараметры.ТипКоманды = 6 Тогда
		ВыполнитьВыгрузкуДанных(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - ОбработчикОповещения_ВыполненияРаботыДрайвера
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры
//
&НаКлиенте
Процедура ОбработчикОповещения_ВыполненияРаботыДрайвера(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	
	Если РезультатОткрытияФормы = Неопределено ИЛИ ДополнительныеПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получим строку из очереди по ключу.
	СтрокаВОчереди = ОчередьОбмена.НайтиПоИдентификатору(ДополнительныеПараметры.КлючСвязиВОчереди);
	Если СтрокаВОчереди = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим пришел ли результат обмена.
	РезультатОбмена = Ложь;
	Если РезультатОткрытияФормы.Свойство("Результат") Тогда
		РезультатОбмена = РезультатОткрытияФормы.Результат;
	КонецЕсли;
	
	// Проверим пришел ли текст ошибки.
	ОписаниеОшибки = "";
	Если РезультатОткрытияФормы.Свойство("ОписаниеОшибки") Тогда
		ОписаниеОшибки = РезультатОткрытияФормы.ОписаниеОшибки;
	КонецЕсли;
	
	// Обновим значения в строке очереди.
	СтрокаВОчереди.Результат = РезультатОбмена;
	СтрокаВОчереди.ОписаниеОшибки = ОписаниеОшибки;
	
	// Проверим прошел ли обмен на всех устройствах.
	МассивСтрокОчереди = ОчередьОбмена.НайтиСтроки(Новый Структура("НомерОбмена", ДополнительныеПараметры.НомерОбмена));
	Если МассивСтрокОчереди.Количество() = ДополнительныеПараметры.КоличествоОжидаемыхСтрок Тогда
		// Если количество ответов от терминалов совпадает с количество ожидаемых строк, то завершим итерацию обмена. 
		ОбработатОбменЗавершение(МассивСтрокОчереди,ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры //ОбработчикОповещения_ВыполненияРаботыДрайвера

