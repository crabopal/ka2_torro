Процедура СписокУзловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.СписокУзлов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияОЗакрытииФормы = Новый ОписаниеОповещения("ОбработчикОповещения_ОбновитьФорму", ЭтотОбъект);
	
	// Отобразим форму узла.
	ОткрытьФорму("Обработка.питОбменСЭвотор.Форма.ФормаУзла", Новый Структура("Ключ", ТекДанные.УзелОбмена), ЭтаФорма,,,,ОписаниеОповещенияОЗакрытииФормы);

