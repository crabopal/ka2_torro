#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс


// Функция проверяет правильность настроек узла обмена. При групповом обмене вызывать для каждого узла.
//  отдельно.
//
// Параметры:
//  ПроверяемыйУзел - ПланОбменаУдаленныеКассы.Узел - узел, для которого следует провести проверку настроек.
//  ПроверятьВажныеДляВыгрузки - Булево - Истина - проверяются настройки, важные только для выгрузки.
//  ПроверятьВажныеДляЗагрузки - Произвольный - Проверять важные для загрузки.
//  СозданиеНачальногоОбраза - Произвольный - Создание начального образа.
//  ОбнаруженыОшибки - Произвольный - Обнаружены ошибки.
//  ОбнаруженыКритическиеОшибки - Произвольный - Обнаружены критические ошибки.
//  СообщениеООшибках - Произвольный - Сообщение о ошибках.
//  СообщениеОКритическихОшибках - Произвольный - Сообщение о критических ошибках.
//
// Возвращаемое значение:
//  Булево       - Истина - ошибок не обнаружено. 
&НаСервере
Функция ПроверитьНастройкиУзла(ПроверяемыйУзел, ПроверятьВажныеДляВыгрузки = Истина, ПроверятьВажныеДляЗагрузки = Истина, СозданиеНачальногоОбраза = Ложь, ОбнаруженыОшибки = Ложь, ОбнаруженыКритическиеОшибки = Ложь, СообщениеООшибках = "", СообщениеОКритическихОшибках = "") Экспорт
	ОбнаруженыОшибки = Ложь;
	ОбнаруженыКритическиеОшибки = Ложь;
	СообщениеООшибках = "";
	СообщениеОКритическихОшибках = "";
	
	// НАСТРОЙКИ, ПРОВЕРЯЕМЫЕ В ЛЮБОМ СЛУЧАЕ
	
	// Настройки обмена.
	Если НЕ ЗначениеЗаполнено(ПроверяемыйУзел.НастройкаДоставкиПоУмолчанию) Тогда
		ОбнаруженыКритическиеОшибки = Истина;
		СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - не заполнена настройка <Настройка доставки по умолчанию>";
	Иначе
		Если НЕ ПроверяемыйУзел.НастройкаДоставкиПоУмолчанию.КаталогНаКлиенте И НЕ питОбменДанными.ПроверитьДоставкуСообщения(ПроверяемыйУзел.НастройкаДоставкиПоУмолчанию) Тогда
			ОбнаруженыКритическиеОшибки = Истина;
			СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - настройка доставки по умолчанию некорректна (не проходит проверку)";
		КонецЕсли;
	КонецЕсли;
	
	// Префикс
	Если НЕ ЗначениеЗаполнено(ПроверяемыйУзел.Префикс) Тогда
		ОбнаруженыКритическиеОшибки = Истина;
		СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - не заполнена настройка <Префикс>";
	КонецЕсли;
	
	// Организация
	Если НЕ ЗначениеЗаполнено(ПроверяемыйУзел.Организация) Тогда
		ОбнаруженыКритическиеОшибки = Истина;
		СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - не заполнена настройка <Организация>";
	КонецЕсли;
	
	// НАСТРОЙКИ, ПРОВЕРЯЕМЫЕ ПРИ ЗАГРУЗКЕ
	Если ПроверятьВажныеДляЗагрузки Тогда
		
		// Проверим, были ли выгружены какие-нибудь сообщения этому узлу.
		Если ПроверяемыйУзел.НомерОтправленного < 1 Тогда
			ОбнаруженыКритическиеОшибки = Истина;
			СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - нет сообщений, выгруженных в проверяемый узел";
		КонецЕсли;
		
	КонецЕсли;
	
	// НАСТРОЙКИ, ПРОВЕРЯЕМЫЕ ПРИ ВЫГРУЗКЕ
	Если ПроверятьВажныеДляВыгрузки Тогда
		
		Для Каждого ТекСтрока Из ПроверяемыйУзел.ВидыМеню Цикл
			// Проверка вида меню.
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ВидМеню) Тогда
				ОбнаруженыКритическиеОшибки = Истина;
				СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - не заполнен <Вид меню> в строке №" + ТекСтрока.НомерСтроки + " табличной части <Виды меню>";
			КонецЕсли;
			// Проверка типа цен
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ТипЦен) Тогда
				ОбнаруженыКритическиеОшибки = Истина;
				СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - не заполнен <Тип цен> в строке №" + ТекСтрока.НомерСтроки + " табличной части <Виды меню>";
			КонецЕсли;
		КонецЦикла;
		
		// Запрос, который получит таблицу цен для всех комбинаций ВидМеню, Номенклатура, ТипЦен, Цена.
		Запрос = Новый Запрос;
		Если ПроверяемыйУзел.ВидыМеню.Количество() > 0 Тогда
			
			ТекстЗапроса1 =
			"ВЫБРАТЬ
			|	УдаленныеКассыВидыМеню.ВидМеню,
			|	УдаленныеКассыВидыМеню.ТипЦен
			|ПОМЕСТИТЬ ВидыМенюУзла
			|ИЗ
			|	ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
			|ГДЕ
			|	УдаленныеКассыВидыМеню.Ссылка = &УзелИБ
			|	И УдаленныеКассыВидыМеню.ВидМеню <> &ПустойВидМеню
			|	И УдаленныеКассыВидыМеню.ТипЦен <> &ПустойТипЦен
			|";
			ТекстЗапроса2 = "
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВложенныйЗапрос.ВидМеню,
			|	ВложенныйЗапрос.Номенклатура,
			|	ВложенныйЗапрос.ТипЦен,
			|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена
			|ИЗ
			|	(ВЫБРАТЬ
			|		УдаленныеКассыВидыМеню.ВидМеню КАК ВидМеню,
			|		УдаленныеКассыВидыМеню.ТипЦен КАК ТипЦен,
			|		питМеню.Номенклатура КАК Номенклатура
			|	ИЗ
			|		Справочник.питМеню КАК питМеню
			|			ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
			|			ПО питМеню.Владелец = УдаленныеКассыВидыМеню.ВидМеню
			|	ГДЕ
			|		УдаленныеКассыВидыМеню.ВидМеню <> &ПустойВидМеню
			|		И УдаленныеКассыВидыМеню.ТипЦен <> &ПустойТипЦен
			|		И питМеню.Владелец В
			|				(ВЫБРАТЬ
			|					ВидыМенюУзла.ВидМеню
			|				ИЗ
			|					ВидыМенюУзла КАК ВидыМенюУзла)
			|		И НЕ питМеню.Номенклатура.ЭтоГруппа
			|		И УдаленныеКассыВидыМеню.Ссылка = &УзелИБ) КАК ВложенныйЗапрос
			|		ЛЕВОЕ СОЕДИНЕНИЕ втЦеныНоменклатуры КАК ЦеныНоменклатурыСрезПоследних
			|		ПО ВложенныйЗапрос.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
			|			И ВложенныйЗапрос.ТипЦен = ЦеныНоменклатурыСрезПоследних.ВидЦены";
			
			
			// +пит
			ТекстЗапросаШаблон = 
				"%1
				|;
				|%2
				|;
				|%3";
			ТекстЦеныОтборНоменклатура = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|							ПрайсЛист.Номенклатура
			|						ИЗ
			|							Справочник.питМеню КАК ПрайсЛист
			|						ГДЕ
			|							ПрайсЛист.Владелец В
			|								(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|									ВидыМенюУзла.ВидМеню КАК ВидМеню
			|								ИЗ
			|									ВидыМенюУзла КАК ВидыМенюУзла)
			|							И ПрайсЛист.Номенклатура.ЭтоГруппа = ЛОЖЬ";
			ТекстЦеныОтборВидыЦен = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|							ВидыМенюУзла.ТипЦен
			|						ИЗ
			|							ВидыМенюУзла КАК ВидыМенюУзла";
			ТекстЗапросаЦены = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ТекущаяДата(), 
				"втЦеныНоменклатуры", "", ТекстЦеныОтборНоменклатура, "ХарактеристикаЦен", ТекстЦеныОтборВидыЦен);
			Запрос.Текст = СтрШаблон(ТекстЗапросаШаблон, ТекстЗапроса1, ТекстЗапросаЦены, ТекстЗапроса2);
			Запрос.УстановитьПараметр("ХарактеристикаЦен", 
				питЦеныНоменклатуры.ПреобразоватьОтборПоХарактеристикеЦен(ТекущаяДата(), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
			// -пит
			
			Запрос.УстановитьПараметр("ПустойВидМеню", Справочники.питВидыМеню.ПустаяСсылка());
			Запрос.УстановитьПараметр("ПустойТипЦен", Справочники.ВидыЦен.ПустаяСсылка());
			Запрос.УстановитьПараметр("УзелИБ", ПроверяемыйУзел);
			
		Иначе
			
			ТекстЗапроса1 =
			"ВЫБРАТЬ
			|	питВидыМеню.Ссылка КАК ВидМеню,
			|	питМеню.Номенклатура,
			|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.ВидЦены, ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)) КАК ТипЦен,
			|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена
			|ИЗ
			|	Справочник.питМеню КАК питМеню
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питВидыМеню КАК питВидыМеню
			|		ПО питМеню.Владелец = питВидыМеню.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ втЦеныНоменклатуры КАК ЦеныНоменклатурыСрезПоследних
			|		ПО питМеню.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
			|ГДЕ
			|	НЕ питВидыМеню.ЭтоГруппа
			|	И НЕ питМеню.ЭтоГруппа";
			// Если нет видов меню в таблице, то по идее берем все виды меню и все типы цен.
			// Запрос.УстановитьПараметр("ТипЦен", ПроверяемыйУзел.ТипЦен);
			
			// +пит
			ТекстЗапросаШаблон = 
				"%1
				|;
				|%2
				|";
			ТекстЗапросаЦены = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ТекущаяДата(), 
				"втЦеныНоменклатуры", "", "", "ХарактеристикаЦен", "");
			Запрос.Текст = СтрШаблон(ТекстЗапросаШаблон, ТекстЗапросаЦены, ТекстЗапроса1);
			Запрос.УстановитьПараметр("ХарактеристикаЦен", 
				питЦеныНоменклатуры.ПреобразоватьОтборПоХарактеристикеЦен(ТекущаяДата(), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
			// -пит
			
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Цена = 0 Тогда
				ОбнаруженыОшибки = Истина;
				СообщениеООшибках = СообщениеООшибках + Символы.ПС + "  - не задана цена для номенклатуры <" + Выборка.Номенклатура + "> (Вид меню: <" + Выборка.ВидМеню + ">; Тип цен: <" + Выборка.ТипЦен + ">)";
			КонецЕсли;
		КонецЦикла;
		
		// Запросом ко всей ТЧ проверим, есть ли доступные виды меню.
		Если ПроверяемыйУзел.ВидыМеню.Количество() > 0 Тогда
			ЗапросПоМеню = Новый Запрос();
			ЗапросПоМеню.Текст =
			"ВЫБРАТЬ
			|	УдаленныеКассыВидыМеню.ВидМеню
			|ИЗ
			|	ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
			|ГДЕ
			|	УдаленныеКассыВидыМеню.ВидМеню В(&ВидыМеню)
			|	И УдаленныеКассыВидыМеню.Ссылка = &УзелОбмена";
			ЗапросПоМеню.УстановитьПараметр("ВидыМеню", питОбменДанными.ПолучитьТаблицуДоступныхВидовМеню().ВыгрузитьКолонку("Ссылка"));
			ЗапросПоМеню.УстановитьПараметр("УзелОбмена", ПроверяемыйУзел);
			РезультатПоМеню = ЗапросПоМеню.Выполнить();
			Если РезультатПоМеню.Пустой() Тогда
				ОбнаруженыОшибки = Истина;
				СообщениеООшибках = СообщениеООшибках + Символы.ПС + "  - отсутствуют действующие виды меню в табличной части <Виды меню>";
			КонецЕсли;
		КонецЕсли;
		
		// Если ПроверяемыйУзел.ИндивидуальныйСписокВидовМенюИНоменклатуры И ПроверяемыйУзел.ВидыМеню.Количество() = 0 Тогда
		// 	ОбнаруженыОшибки = Истина;
		// 	СообщениеООшибках = СообщениеООшибках + Символы.ПС + "  - не заполнена табличная часть <Виды меню>";
		// КонецЕсли;
		
		// Должен быть хотя бы 1 пользователь был с ролью "Администратор" при выгрузке начального образа.
		Если СозданиеНачальногоОбраза Тогда
			
			ТекРоль = Перечисления.питРолиПользователяВоФронте.Администратор;
			МетаданныеРоли = ТекРоль.Метаданные();
			ИндексЗначения = Перечисления[МетаданныеРоли.Имя].Индекс(ТекРоль);
			ИмяРоли = МетаданныеРоли.ЗначенияПеречисления[ИндексЗначения].Имя;
			РольПользователяФронтаАдминистратор = питОбменДанными.ПолучитьСсылкуПоИД(МетаданныеРоли.ЗначенияПеречисления[ИндексЗначения].Комментарий, Справочники.питРолиПользователейФронта);
			
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ПользователипитРолиПользователейФронта.РольФронта
			|ИЗ
			|	РегистрСведений.питРолиПользователейФронта КАК ПользователипитРолиПользователейФронта
			|ГДЕ
			|	ПользователипитРолиПользователейФронта.РольФронта = &РольПользователяФронта
			|	И ПользователипитРолиПользователейФронта.Пользователь.питПользовательФронтОфиса";
			Запрос.УстановитьПараметр("РольПользователяФронта", РольПользователяФронтаАдминистратор);
			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				// Т.к. пользователь с ролью администратор не найден, то выполняется проверка на существование роли администратора
				АдминистраторСсылка = Справочники.питРолиПользователейФронта.ПолучитьРольПользователяФронтаАдминистратор();
				АдминистраторОбъект = АдминистраторСсылка.ПолучитьОбъект();
				Попытка
					Справочники.питРолиПользователейФронта.ДобавитьПраваАдминистратору(АдминистраторОбъект);
					АдминистраторОбъект.Записать();
				Исключение
					ИнфОбОшибке = ИнформацияОбОшибке();
					ТекстОшибки = ИнфОбОшибке.Описание;
					Пока ИнфОбОшибке.Причина <> Неопределено Цикл
						ИнфОбОшибке = ИнфОбОшибке.Причина;
						ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
					КонецЦикла;
					ТекстОшибки = "Ошибка добавление прав роли Администратор - " + ТекстОшибки;
					ЗаписьЖурналаРегистрации("Обмен", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
					
				КонецПопытки;
				ОбнаруженыКритическиеОшибки = Истина;
				СообщениеОКритическихОшибках = СообщениеОКритическихОшибках + Символы.ПС + "  - для узла нет пользователей " 
				+ " с ролью пользователей фронта ""Администратор""." 
				+ Символы.ПС + "Необходимо хотя бы одному из пользователей добавить роль пользователя фронта ""Администратор""";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НЕ ОбнаруженыКритическиеОшибки;
	
КонецФункции

#КонецОбласти

#КонецЕсли


