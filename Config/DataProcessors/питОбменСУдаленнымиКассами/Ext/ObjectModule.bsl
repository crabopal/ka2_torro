//// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Выполняет загрузку сообщения обмена для указанного узла
//  по определенной настройке доставке (локальная сеть, FTP, почта)
//
// Параметры:
//  СтрОшибки - Строка - описание произошедших ошибок.
//  ВыгружатьТолькоПодтверждениеПриема - Произвольный - Выгружать только подтверждение приема.
//
// Возвращаемое значение:
//   Булево - Флаг успешного завершения загрузки сообщения
Функция ВыполнитьЗагрузку(СтрОшибки = "", ВыгружатьТолькоПодтверждениеПриема =  Ложь) Экспорт
	Параметры =  Новый Структура;
	ЗаполнитьПараметры(Параметры);
	Параметры.Вставить("ЭтоЗагрузка", Истина);
	Если ВыгружатьТолькоПодтверждениеПриема Тогда
		Параметры.Вставить("ВыгружатьТолькоПодтверждениеПриема", Истина);	
	КонецЕсли;
	
	питОбменДанными.ВыполнитьЗагрузкуДанных(Параметры);
	
	СтрОшибки = Параметры.Ошибка;
	Возврат Параметры.Результат;
КонецФункции

// Выполняет выгрузку сообщения обмена для указанного узла
//  по определенной настройке доставке (локальная сеть, FTP, почта)
//
// Параметры:
//  СозданиеНачальногоОбраза - Булево - признак выгрузки нач. образа.
//  СтрОшибки - Строка - описание произошедших ошибок.
//  ПолнаяРегистрация - Произвольный - Полная регистрация.
//
// Возвращаемое значение:
//   Булево - Флаг успешного завершения выгрузки сообщения
Функция ВыполнитьВыгрузку(СозданиеНачальногоОбраза = Ложь, СтрОшибки = "", ПолнаяРегистрация = Ложь) Экспорт
	
	Если СозданиеНачальногоОбраза И УзелОбмена.НомерОтправленного > 0 Тогда
		УзелОбменаОбъект = УзелОбмена.ПолучитьОбъект();
		УзелОбменаОбъект.НомерПринятого 	= 0;
		УзелОбменаОбъект.НомерОтправленного = 0;
		УзелОбменаОбъект.ВерсияФронтОфиса   = "";
		УзелОбменаОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
		Попытка
			УзелОбменаОбъект.Записать();
		Исключение КонецПопытки;
		
		НаборЗаписей = РегистрыСведений.СостоянияОбменовДанными.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(УзелОбмена);
		НаборЗаписей.Записать();
	КонецЕсли; 
	
	Параметры = Новый Структура;
	ЗаполнитьПараметры(Параметры);
	Если СозданиеНачальногоОбраза Тогда
		Параметры.Вставить("СозданиеНачальногоОбраза", Истина);
	КонецЕсли;
	
	Если ПолнаяРегистрация Тогда
		Параметры.Вставить("ПолнаяРегистрация", Истина);
	КонецЕсли;
	
	питОбменДанными.ВыполнитьВыгрузкуДанных(Параметры);
	СтрОшибки = Параметры.Ошибка;
	Возврат Параметры;
КонецФункции

// Выполняет полную регистрацию данных для указанного узла
//
// Параметры:
//  СтрОшибки - Строка - описание произошедших ошибок.
//
// Возвращаемое значение:
//   Булево - Флаг успешного завершения операции
Функция ВыполнитьПолнуюРегистрацию(СтрОшибки = "") Экспорт
	
	Попытка
		питОбменДанными.ЗарегистрироватьИзмененияДляВыгрузкиНО(УзелОбмена);
		Результат = Истина;
	Исключение
		СтрОшибки = ИнформацияОбОшибке().Описание;
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//////////////////////////////////////////////////////////////////////////////////
//// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура предназначена для заполнения структуры параметров.
//
// Параметры:
//  Параметры - Структура - Заполняемая структура.
//
Процедура ЗаполнитьПараметры(Параметры)
	
	Параметры.Вставить("УзелОбмена", УзелОбмена);
	Параметры.Вставить("Префикс",	СокрЛП(УзелОбмена.Префикс));
	Параметры.Вставить("НастройкаОбмена", НастройкаОбмена);
	Параметры.Вставить("Комментировать", Комментировать);
	Если ФиксироватьПоОбъекту Тогда
		Параметры.Вставить("ФиксироватьПоОбъекту", Истина);
	КонецЕсли;
	Параметры.Вставить("КоличествоЭлементовВТранзакции", КоличествоЭлементовВТранзакции);
	Параметры.Вставить("ВестиЖурналРегистрации", ВестиЖурналРегистрации);
	Параметры.Вставить("ЗагружатьОтменыБезСписания", УзелОбмена.ЗагружатьОтменыБезСписания);
	
	Параметры.Вставить("ИмяФайлаСообщения", "");
	Параметры.Вставить("НачалоОперацииОбмена", ТекущаяДата());
	Параметры.Вставить("ТипУдалениеОбъекта", Тип("УдалениеОбъекта"));
	
	Параметры.Вставить("Ошибка", "");
	
	ПрефиксЛога = "ОбменКасса." + ?(УзелОбмена.Пустая(),"","Узел_" + СокрЛП(УзелОбмена.Префикс) + ".");
	Параметры.Вставить("ПрефиксЛога", ПрефиксЛога);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
