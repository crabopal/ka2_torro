// Процедура заполнения таблицы кассовых узлов.
//
&НаСервере
Процедура ОбновитьТаблицуКассовыхУзлов()
	
	УзлыОбмена.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдаленныеКассы.Ссылка КАК УзелОбмена,
	|	УдаленныеКассы.НастройкаДоставкиПоУмолчанию КАК НастройкаОбмена,
	|	УдаленныеКассы.ВерсияФронтОфиса КАК ВерсияФронтОфиса,
	|	УдаленныеКассы.Префикс КАК Префикс,
	|	УдаленныеКассы.НомерОтправленного КАК НомерОтправленного,
	|	ЕСТЬNULL(СостоянияОбменовДаннымиВыгрузка.РезультатВыполненияОбмена, ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Выполнено)) КАК РезультатВыгрузка,
	|	ЕСТЬNULL(СостоянияОбменовДаннымиВыгрузка.ДатаОкончания, """") КАК ДатаВыгрузка,
	|	ЕСТЬNULL(СостоянияОбменовДаннымиЗагрузка.РезультатВыполненияОбмена, ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Выполнено)) КАК РезультатЗагрузка,
	|	ЕСТЬNULL(СостоянияОбменовДаннымиЗагрузка.ДатаОкончания, """") КАК ДатаЗагрузка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК УдаленныеКассы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОбменовДанными КАК СостоянияОбменовДаннымиВыгрузка
	|		ПО УдаленныеКассы.Ссылка = СостоянияОбменовДаннымиВыгрузка.УзелИнформационнойБазы
	|			И (СостоянияОбменовДаннымиВыгрузка.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОбменовДанными КАК СостоянияОбменовДаннымиЗагрузка
	|		ПО УдаленныеКассы.Ссылка = СостоянияОбменовДаннымиЗагрузка.УзелИнформационнойБазы
	|			И (СостоянияОбменовДаннымиЗагрузка.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
	|ГДЕ
	|	УдаленныеКассы.Ссылка <> &ЭтотУзел
	|
	|УПОРЯДОЧИТЬ ПО
	|	УдаленныеКассы.Префикс";
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайденныеСтроки = УзлыОбмена.НайтиСтроки(Новый Структура("УзелОбмена", Выборка.УзелОбмена));
		
		ТекущаяСтрока = УзлыОбмена.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Выборка);
		
		Если НЕ ЗначениеЗаполнено(Выборка.ДатаВыгрузка) Тогда
			ТекущаяСтрока.РезультатВыгрузки = Истина;
			ТекущаяСтрока.ПоследняяВыгрузка = "Не производилась";
		ИначеЕсли Выборка.РезультатВыгрузка = Перечисления.РезультатыВыполненияОбмена.Выполнено Тогда
			ТекущаяСтрока.РезультатВыгрузки = Истина;
			ТекущаяСтрока.ПоследняяВыгрузка = "ОК. Дата выгрузки:" + Формат(Выборка.ДатаВыгрузка, "");
		Иначе
			ТекущаяСтрока.РезультатВыгрузки = Ложь;
			ТекущаяСтрока.ПоследняяВыгрузка = "Ошибка. Дата выгрузки:" + Формат(Выборка.ДатаВыгрузка, "");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ДатаЗагрузка) Тогда
			ТекущаяСтрока.РезультатЗагрузки = Истина;
			ТекущаяСтрока.ПоследняяЗагрузка = "Не производилась";
		ИначеЕсли Выборка.РезультатЗагрузка = Перечисления.РезультатыВыполненияОбмена.Выполнено Тогда
			ТекущаяСтрока.РезультатЗагрузки = Истина;
			ТекущаяСтрока.ПоследняяЗагрузка = "ОК. Дата загрузки:" + Формат(Выборка.ДатаЗагрузка, "");
		Иначе
			ТекущаяСтрока.РезультатЗагрузки = Ложь;
			ТекущаяСтрока.ПоследняяЗагрузка = "Ошибка. Дата загрузки:" + Формат(Выборка.ДатаЗагрузка, "");
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

// Процедура перезаписи реквизита НастройкаДоставкиПоУмолчанию для указаного узла.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  НастройкаОбмена - Произвольный - Настройка обмена.
//
&НаСервере
Процедура УстановитьНовуюНастройкуДоставки(УзелОбмена, НастройкаОбмена)
	УзелОбъект = УзелОбмена.ПолучитьОбъект();
	УзелОбъект.НастройкаДоставкиПоУмолчанию = НастройкаОбмена;
	УзелОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
	Попытка
		УзелОбъект.Записать();
	Исключение КонецПопытки;                 
КонецПроцедуры

// Функция вызова серверного процесса выгрузки данных.
//
// Параметры:
//  НачальныйОбраз - Произвольный - Начальный образ.
//  СтрОшибки - Произвольный - Стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ВыполнитьВыгрузкуСервер(НачальныйОбраз, СтрОшибки)
	ПолученныйОбъект = РеквизитФормыВЗначение("Объект");
	ПарамРезультат =  ПолученныйОбъект.ВыполнитьВыгрузку(НачальныйОбраз, СтрОшибки);
	
	// Каталог на клиенте. Помещаем во временное хранилище файл на сервере, потом на клиенте его считаем.
	Если ПарамРезультат.Результат Тогда
		Попытка
			Если ПолученныйОбъект.НастройкаОбмена.КаталогНаКлиенте И ПолученныйОбъект.НастройкаОбмена.СпособОбмена = 0 Тогда
				
				АдресФайлаТС = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПарамРезультат.ИмяОтправляемогоФайла), УникальныйИдентификатор);
				
				// ОбратныйВызов = Новый ОписаниеОповещения("УдалитьЗавершение", ЭтотОбъект );
				// НачатьУдалениеФайлов(ОбратныйВызов, ПарамРезультат.ИмяОтправляемогоФайла );
	
				УдалитьФайлы(ПарамРезультат.ИмяОтправляемогоФайла);
				
				ПолноеИмяФайлаОбменаПриемник = ПарамРезультат.ПолноеИмяФайлаОбменаПриемник;  
				АдресФайлаТС = АдресФайлаТС;
				КаталогНаКлиенте = Истина;
				
			Иначе
				
				ПолноеИмяФайлаОбменаПриемник = "";  
				АдресФайлаТС = "";
				КаталогНаКлиенте = Ложь;
				
			КонецЕсли;
			
		Исключение
			ТекстОшибки = "Ошибка получения файла выгрузки с сервера для копирования в каталог на клиенте!";
			ЗаписьЖурналаРегистрации("Выгрузка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			ПарамРезультат.Результат = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Возврат ПарамРезультат.Результат;

КонецФункции

// Функция вызова серверного процесса загрузки данных.
//
// Параметры:
//  СтрОшибки - Произвольный - Стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ВыполнитьЗагрузкуСервер(СтрОшибки)
	// Каталог на клиенте. Читаем файл из временного хранилища, помещаем на сервер в каталог временных файлов.
	Если Объект.НастройкаОбмена.КаталогНаКлиенте И Объект.НастройкаОбмена.СпособОбмена = 0 Тогда
		
		Попытка
			ФайлОбмена = ПолучитьИзВременногоХранилища(АдресФайлаТС);
			ФайлОбмена.Записать(КаталогВременныхФайлов() + ИмяФайлаДляЗагрузки);
			
		Исключение
			ТекстОшибки = "Ошибка копирования файла выгрузки в каталог на клиенте!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;

	ПолученныйОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ПолученныйОбъект.ВыполнитьЗагрузку(СтрОшибки);
КонецФункции

// Функция проверки настроек узла.
//
// Параметры:
//  ПроверяемыйУзел - Произвольный - Проверяемый узел.
//  ПроверятьВажныеДляВыгрузки - Произвольный - Проверять важные для выгрузки.
//  ПроверятьВажныеДляЗагрузки - Произвольный - Проверять важные для загрузки.
//  СозданиеНачальногоОбраза - Произвольный - Создание начального образа.
//  ОбнаруженыОшибки - Произвольный - Обнаружены ошибки.
//  ОбнаруженыКритическиеОшибки - Произвольный - Обнаружены критические ошибки.
//  СообщениеООшибках - Произвольный - Сообщение о ошибках.
//  СообщениеОКритическихОшибках - Произвольный - Сообщение о критических ошибках.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПроверитьНастройкиУзлаНаСервере(ПроверяемыйУзел, ПроверятьВажныеДляВыгрузки, ПроверятьВажныеДляЗагрузки, СозданиеНачальногоОбраза, ОбнаруженыОшибки, ОбнаруженыКритическиеОшибки, СообщениеООшибках, СообщениеОКритическихОшибках)
	Обработки.питОбменСУдаленнымиКассами.ПроверитьНастройкиУзла(ПроверяемыйУзел, ПроверятьВажныеДляВыгрузки, ПроверятьВажныеДляЗагрузки, СозданиеНачальногоОбраза, ОбнаруженыОшибки, ОбнаруженыКритическиеОшибки, СообщениеООшибках, СообщениеОКритическихОшибках);
КонецФункции

// Проверяет доставку файла по указанной настройке.
//  Параметры
//
// Параметры:
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  стрОшибки - Произвольный - стр ошибки.
//
// Возвращаемое значение:
//   Булево. Флаг успешной доставки сообщения.
&НаКлиенте
Асинх Функция ПроверитьДоставкуСообщенияНаКлиенте(НастройкаДоставки, стрОшибки = "")
	
	стрОшибки = "";
	ЛокКаталог_ = НастройкаДоставки.КаталогОбменов;
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	
	ИмяТестовогоФайла = "test_exch_" + Формат(ТекущаяДата(), "ДФ = ддММгггг") + ".tmp";
	Если СпособОбмена = 0 Тогда
		
		РезультатПроверки = Ждать ПроверитьДоставкуСообщенияЛокКаталогНаКлиенте(НастройкаДоставки, стрОшибки);
		
		Возврат РезультатПроверки;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

// Функция проверки настройки доставки сообщения через локальный каталог.
//
// Параметры:
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  стрОшибки - Произвольный - стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Асинх Функция ПроверитьДоставкуСообщенияЛокКаталогНаКлиенте(НастройкаДоставки, стрОшибки)
	
	стрОшибки = "";
	ЛокКаталог_ = НастройкаДоставки.КаталогОбменов;
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	ИмяТестовогоФайла = "test_exch_" + Формат(ТекущаяДата(), "ДФ = ддММгггг") + ".tmp";
	
	Попытка
		Если НастройкаДоставки.ИспользоватьВременныйКаталог Тогда
			ТемпКаталог = ?(Прав(ЛокКаталог_,1)="\" ИЛИ Прав(ЛокКаталог_,1)="/",ЛокКаталог_,ЛокКаталог_ + Слеш) + "TEMP\"; 
			Результат  = Ждать НайтиФайлыАсинх(ТемпКаталог);
			Если Результат.Количество() = 0 Тогда
				СоздатьКаталогАсинх(ТемпКаталог);
			КонецЕсли;
		Иначе
			ТемпКаталог = КаталогВременныхФайлов();
		КонецЕсли;
	Исключение
		стрОшибки = стрОшибки + "Ошибка при создании каталога:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	ПолноеИмяТестовогоФайла = ТемпКаталог + ИмяТестовогоФайла;
	
	// Можем проверить только запись в локальный каталог
	ТекстДок = Новый ТекстовыйДокумент;
	Попытка
		ТекстДок.Записать(ПолноеИмяТестовогоФайла);
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
	Исключение
		стрОшибки = стрОшибки + "Ошибка при создании тестового файла:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	// ЛОКАЛЬНЫЙ КАТАЛОГ
	Если НайтиФайлы(ЛокКаталог_).Количество() = 0 Тогда
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
		|Каталог не обнаружен";
		Возврат Ложь;	
	КонецЕсли;
	
	ПолноеИмяТестовогоФайлаПриемник = ?(Прав(ЛокКаталог_,1)="\" ИЛИ Прав(ЛокКаталог_,1)="/",
	НастройкаДоставки.КаталогОбменов,ЛокКаталог_ + Слеш) + ИмяТестовогоФайла;
	Попытка
		Результат = Ждать КопироватьФайлАсинх(ПолноеИмяТестовогоФайла, ПолноеИмяТестовогоФайлаПриемник);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
		|" + ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Результат = Ждать КопироватьФайлАсинх(ПолноеИмяТестовогоФайлаПриемник, ПолноеИмяТестовогоФайла);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при получении тестового файла из каталога обмена:
		|" + ОписаниеОшибки();
		
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Результат = Ждать УдалитьФайлыАсинх(ПолноеИмяТестовогоФайлаПриемник);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при удалении тестового файла из каталога обмена:
		|" + ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

//  Процедура - Обработка завершения копирования.
//
// Параметры:
//  Файл - Произвольный - Файл.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработкаЗавершенияКопирования(Файл, ДополнительныеПараметры) Экспорт
	
	Сообщение = Новый СообщениеПользователю();
    Сообщение.Текст = "Скопирован файл: "+Файл;
    Сообщение.Сообщить();	

КонецПроцедуры

// Функция проверки настроек узла и отображения сообщения пользователю.
//
// Параметры:
//  ПроверяемыйУзел - Произвольный - Проверяемый узел.
//  ПроверятьВажныеДляВыгрузки - Произвольный - Проверять важные для выгрузки.
//  ПроверятьВажныеДляЗагрузки - Произвольный - Проверять важные для загрузки.
//  СозданиеНачальногоОбраза - Произвольный - Создание начального образа.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Асинх Функция ПроверитьНастройкиУзланаКлиенте(ПроверяемыйУзел, ПроверятьВажныеДляВыгрузки = Истина, ПроверятьВажныеДляЗагрузки = Истина, СозданиеНачальногоОбраза = Ложь)
	
	ОбнаруженыОшибки = Ложь;
	ОбнаруженыКритическиеОшибки = Ложь;
	СообщениеООшибках = "";
	СообщениеОКритическихОшибках = "";
	
	// Каталог на клиенте. Проверка способа доставки.
	ДанныеНастройкиОбмена = питОбменДанными.ПолучитьДанныеНастройкиОбмена(Объект.НастройкаОбмена);
	Если НЕ ЗначениеЗаполнено(Объект.НастройкаОбмена) Тогда
		ТекстСообщения = "Настройка доставки не указана, необходимо выбрать настройку доставки.";
	ИначеЕсли (ДанныеНастройкиОбмена.СпособОбмена = 0 И ДанныеНастройкиОбмена.КаталогНаКлиенте) Тогда 
		ОбнаруженыКритическиеОшибки = НЕ Ждать ПроверитьДоставкуСообщенияНаКлиенте(ДанныеНастройкиОбмена, СообщениеОКритическихОшибках);
	Иначе
		ТекстСообщения = "Способ доставки указанный в выбранной настройке доставки сообщений не поддерживается ПО кассового узла.
		|Укажите другую настройку доставки, либо измените способ доставки в текущей выбранной настройке доставки.";
	КонецЕсли;
	
	Если НЕ(ОбнаруженыКритическиеОшибки ИЛИ ОбнаруженыОшибки) Тогда
		ПроверитьНастройкиУзлаНаСервере(ПроверяемыйУзел, ПроверятьВажныеДляВыгрузки, ПроверятьВажныеДляЗагрузки, СозданиеНачальногоОбраза, ОбнаруженыОшибки, ОбнаруженыКритическиеОшибки, СообщениеООшибках, СообщениеОКритическихОшибках);
	КонецЕсли;
	
	Если ОбнаруженыКритическиеОшибки ИЛИ ОбнаруженыОшибки Тогда
		// Определим режим диалога сообщения. Если были критические ошибки, то просто сообщим о них.
		// Если же были только простые ошибки, то спросим пользователя продолжать или нет.
		РежимСообщения = ?(ОбнаруженыКритическиеОшибки, РежимДиалогаВопрос.ОК, РежимДиалогаВопрос.ДаНет);
		КнопкаПоУмолчанию = ?(ОбнаруженыКритическиеОшибки, КодВозвратаДиалога.ОК, КодВозвратаДиалога.Нет);
		
		СообщениеОКритическихОшибках = ?(ОбнаруженыКритическиеОшибки, "КРИТИЧЕСКИЕ:" + СообщениеОКритическихОшибках + Символы.ПС + Символы.ПС, "");
		
		СообщениеООшибках = ?(ОбнаруженыОшибки, "НЕ КРИТИЧЕСКИЕ" + СообщениеООшибках + Символы.ПС + Символы.ПС, "");
		
		ПостфиксСообщения = ?(ОбнаруженыКритическиеОшибки, "Из-за обнаруженых ошибок операция обмена отменяется!", "Продолжить?");
		
		// Соберем сообщение
		ТекстДиалога = "При проверке узла <" + Строка(ПроверяемыйУзел) + "> обнаружены ошибки:" + Символы.ПС
		+ СообщениеОКритическихОшибках
		+ СообщениеООшибках + ПостфиксСообщения;
		
		Результат = Ждать ВопросАсинх(ТекстДиалога, РежимСообщения,,КнопкаПоУмолчанию, "Обнаружены ошибки");
		// Ответ = Вопрос(ТекстДиалога, РежимСообщения, , КнопкаПоУмолчанию, "Обнаружены ошибки");
		// Если Ответ = КодВозвратаДиалога.Да Тогда
		// 	Возврат Истина;
		// Иначе
		// 	Возврат Ложь;
		// КонецЕсли;
		
		Если Результат = КодВозвратаДиалога.Да Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;

		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции
		

// Процедура выгрузки данных.
//
// Параметры:
//  НачальныйОбраз - Произвольный - Начальный образ.
//
&НаКлиенте
Асинх Процедура ВыполнитьВыгрузку(НачальныйОбраз)
	
	МассивСтрок = УзлыОбмена.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		Если НачальныйОбраз Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны кассовые узлы для выгрузки начального образа!", , "УзлыОбмена");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны кассовые узлы для выгрузки!", , "УзлыОбмена");
		КонецЕсли; 
		Возврат;
	КонецЕсли; 
	
	ПроверкаУспешна = Истина;
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		
		Объект.УзелОбмена      = ТекущаяСтрока.УзелОбмена;
		Объект.НастройкаОбмена = ТекущаяСтрока.НастройкаОбмена;
		
		Если Объект.УзелОбмена.Пустая() ИЛИ Объект.НастройкаОбмена.Пустая() Тогда
			Продолжить;
		КонецЕсли;
			
		Если ТекущаяСтрока.НомерОтправленного > 0 И НачальныйОбраз Тогда
			ТекстВопроса = "В узел """ + СокрЛП(ТекущаяСтрока.УзелОбмена) +  "" + " уже отправлено сообщений: " + СокрЛП(ТекущаяСтрока.НомерОтправленного) 
			+ ".
			|    ПРЕДУПРЕЖДЕНИЕ! При выгрузке начального образа в кассовом узле будет произведена полная перезаливка его базы.
			|Если какие-то данные не были получены и загружены в базу БЭК-офиса, то они могут быть БЕЗВОЗВРАТНО ПОТЕРЯНЫ!!! 
			|   Желаете продолжить данную операцию?";
			Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 25);
			Если Результат = КодВозвратаДиалога.Нет Тогда
				ТекущаяСтрока.Пометка = Ложь;
				Продолжить;
			КонецЕсли; 
		КонецЕсли; 
		
		Если НЕ Ждать ПроверитьНастройкиУзланаКлиенте(ТекущаяСтрока.УзелОбмена, Истина, Ложь, НачальныйОбраз) Тогда
			ПроверкаУспешна = Ложь;
		КонецЕсли;

	КонецЦикла;
	
	Если НЕ ПроверкаУспешна Тогда 
		Возврат; 
	КонецЕсли;
	
	МассивСтрок = УзлыОбмена.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	РезультатОбмена = Истина;
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		ОбработкаПрерыванияПользователя();
		
		Объект.УзелОбмена      = ТекущаяСтрока.УзелОбмена;
		Объект.НастройкаОбмена = ТекущаяСтрока.НастройкаОбмена;
		
		Если Объект.УзелОбмена.Пустая() ИЛИ Объект.НастройкаОбмена.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		СтрОшибки = "";
		ТекущаяСтрока.РезультатВыгрузки = ВыполнитьВыгрузкуСервер(НачальныйОбраз, СтрОшибки);
		
		Если ТекущаяСтрока.РезультатВыгрузки Тогда
			ТекущаяСтрока.ПоследняяВыгрузка = "ОК: Сообщение обмена успешно выгружено";
			// Каталог на клиенте.Получаем файл из временного хранилища и пишем в каталог на клиенте. 
			Если КаталогНаКлиенте Тогда
				Попытка
					ПолучитьФайл(АдресФайлаТС, ПолноеИмяФайлаОбменаПриемник, Ложь);
				Исключение
					ТекстОшибки = "Ошибка копирования файла выгрузки в каталог на клиенте!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				КонецПопытки;
			КонецЕсли;
		Иначе
			ТекущаяСтрока.ПоследняяВыгрузка = "Ошибка: " + СтрОшибки;
			РезультатОбмена = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если РезультатОбмена Тогда
		ПоказатьПредупреждение(Неопределено, "Выгрузка сообщения обмена успешно завершена!",,"Итог выгрузки");
	Иначе	
		ПоказатьПредупреждение(Неопределено, "Выгрузка сообщения обмена закончилось с ошибками!",,"Итог выгрузки");
	КонецЕсли;
	
КонецПроцедуры

// Процедура полной регистрации данных
//
// Параметры:
//  СтрОшибки - Произвольный - Стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолнаяРегистрацияНаСервере(СтрОшибки)
	
	ПолученныйОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ПолученныйОбъект.ВыполнитьПолнуюРегистрацию(СтрОшибки);
	
КонецФункции

// Процедура загрузки данных.
//
&НаКлиенте
Асинх Процедура ВыполнитьЗагрузку()
	
	МассивСтрок = УзлыОбмена.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, "Не выбраны кассовые узлы для загрузки!", 15);
		Возврат;
	КонецЕсли;
	
	ПроверкаУспешна = Истина;
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		
		Объект.УзелОбмена      = ТекущаяСтрока.УзелОбмена;
		Объект.НастройкаОбмена = ТекущаяСтрока.НастройкаОбмена;
		
		Если Объект.УзелОбмена.Пустая() ИЛИ Объект.НастройкаОбмена.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Ждать ПроверитьНастройкиУзланаКлиенте(ТекущаяСтрока.УзелОбмена, Ложь, Истина, Ложь) Тогда
			ПроверкаУспешна = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ПроверкаУспешна Тогда 
		Возврат; 
	КонецЕсли;
	
	РезультатОбмена = Истина;
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		ОбработкаПрерыванияПользователя();
		
		Объект.УзелОбмена      = ТекущаяСтрока.УзелОбмена;
		Объект.НастройкаОбмена = ТекущаяСтрока.НастройкаОбмена;
		
		Если Объект.УзелОбмена.Пустая() ИЛИ Объект.НастройкаОбмена.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		СтрОшибки = "";
		РезультатЗагрузкиСКлиента = Истина;
		
		// Каталог на клиенте. Помещаем файл из клиентского каталога во временное хранилище для дальнейшего 
		// считывания на сервере.
		ДанныеНастройкиОбмена = питОбменДанными.ПолучитьДанныеНастройкиОбмена(Объект.НастройкаОбмена);
		Если ЗначениеЗаполнено(ТекущаяСтрока.НастройкаОбмена) И ДанныеНастройкиОбмена.СпособОбмена = 0 И ДанныеНастройкиОбмена.КаталогНаКлиенте Тогда
			
			РезультатЗагрузкиСКлиента = Ждать ПолучитьФайл_ЛокСеть();
			Если РезультатЗагрузкиСКлиента И ЗначениеЗаполнено(ПолноеИмяФайлаОбменаПриемник) Тогда
				Попытка
					АдресФайлаТС = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаОбменаПриемник), УникальныйИдентификатор);
					КаталогНаКлиенте = Истина;
					ОбратныйВызов = Новый ОписаниеОповещения("УдалитьЗавершение", ЭтотОбъект );
					НачатьУдалениеФайлов(ОбратныйВызов, ПолноеИмяФайлаОбменаПриемник );

					// УдалитьФайлы(ПолноеИмяФайлаОбменаПриемник);
				Исключение
					СтрОшибки = "Помещение файла выгрузки на сервер для выполнения операции загрузки не выполнено";
					РезультатЗагрузкиСКлиента = Ложь;
				КонецПопытки;
			Иначе
				РезультатЗагрузкиСКлиента = Ложь;
				СтрОшибки = "Не было получено сообщений из узла";
			КонецЕсли;
		КонецЕсли;
		Если РезультатЗагрузкиСКлиента Тогда
			ТекущаяСтрока.РезультатЗагрузки = ВыполнитьЗагрузкуСервер(СтрОшибки);
			Если ТекущаяСтрока.РезультатЗагрузки Тогда
				ТекущаяСтрока.ПоследняяЗагрузка = ?(ПустаяСтрока(СтрОшибки), "ОК: Сообщение обмена успешно загружено", СтрОшибки);
			Иначе
				ТекущаяСтрока.ПоследняяЗагрузка = "Ошибка: " + СтрОшибки;
				РезультатОбмена = Ложь;
			КонецЕсли;
		Иначе
			ТекущаяСтрока.РезультатЗагрузки = Ложь;
			ТекущаяСтрока.ПоследняяЗагрузка = "Ошибка: " + СтрОшибки;
			РезультатОбмена = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если РезультатОбмена Тогда
		ПоказатьПредупреждение(Неопределено, "Загрузка сообщения обмена завершена!",,"Итог загрузки");
	Иначе	
		ПоказатьПредупреждение(Неопределено, "Загрузка сообщения обмена закончилось с ошибками!",,"Итог загрузки");
	КонецЕсли; 
	
КонецПроцедуры

// Процедура обмена данными.
//
&НаКлиенте
Асинх Процедура ВыполнитьОбмен()
	
	МассивСтрок = УзлыОбмена.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, "Не выбраны кассовые узлы для обмена данными!", 15);
		Возврат;
	КонецЕсли;
	
	ПроверкаУспешна = Истина;
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		
		Если ТекущаяСтрока.УзелОбмена.Пустая() ИЛИ ТекущаяСтрока.НастройкаОбмена.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Ждать ПроверитьНастройкиУзланаКлиенте(ТекущаяСтрока.УзелОбмена, Истина, Истина, Ложь) Тогда
			ПроверкаУспешна = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ПроверкаУспешна Тогда 
		Возврат; 
	КонецЕсли;
	
	РезультатОбмена = Истина;
	
	РезультатОбмена = Ждать ПрочитатьСообщенияПриОбменеСоВсеми(МассивСтрок) И РезультатОбмена;
	
	РезультатОбмена = ЗаписатьСообщенияПриОбменеСоВсеми(МассивСтрок) И РезультатОбмена;
	
	РезультатОбмена = Ждать ПрочитатьСообщенияПриОбменеСоВсеми(МассивСтрок) И РезультатОбмена;
	
	Если РезультатОбмена Тогда
		ПоказатьПредупреждение(Неопределено, "Обмен успешно завершен!",,"Итог обмена");
	Иначе	
		ПоказатьПредупреждение(Неопределено, "Обмен закончился с ошибками!",,"Итог обмена");
	КонецЕсли;
	
КонецПроцедуры

// Чтение сообщения обмена из узлов при обмене со всеми.
//
// Параметры:
//  МассивПомеченных - Массив - Массив помеченных.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Асинх Функция ПрочитатьСообщенияПриОбменеСоВсеми(МассивПомеченных)
	
	РезультатОбмена = Истина;
	
	Для Каждого ТекущаяСтрока Из МассивПомеченных Цикл
		РезультатОбмена = Ждать ПрочитатьСообщениеДляУзлаПриОбменеСоВсеми(ТекущаяСтрока) И РезультатОбмена;
	КонецЦикла;
	
	Возврат РезультатОбмена;
	
КонецФункции

// Запись сообщения обмена из узлов при обмене со всеми.
//
// Параметры:
//  МассивПомеченных - Массив - Массив помеченных.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ЗаписатьСообщенияПриОбменеСоВсеми(МассивПомеченных)
	
	РезультатОбмена = Истина;
	
	Для Каждого ТекущаяСтрока Из МассивПомеченных Цикл
		РезультатОбмена = ЗаписатьСообщениеДляУзлаПриОбменеСоВсеми(ТекущаяСтрока) И РезультатОбмена;
	КонецЦикла;
	
	Возврат РезультатОбмена;
	
КонецФункции

// Чтение сообщения из узла при обмене со всеми.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Асинх Функция ПрочитатьСообщениеДляУзлаПриОбменеСоВсеми(ТекущаяСтрока)
	
	РезультатОбмена = Истина;
	
	ОбработкаПрерыванияПользователя();
	
	Объект.УзелОбмена = ТекущаяСтрока.УзелОбмена;
	Объект.НастройкаОбмена = ТекущаяСтрока.НастройкаОбмена;
	
	Если Объект.УзелОбмена.Пустая() ИЛИ Объект.НастройкаОбмена.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Каталог на клиенте. Помещаем файл из клиентского каталога во временное хранилище для дальнейшего 
	// считывания на сервере.
	ДанныеНастройкиОбмена = питОбменДанными.ПолучитьДанныеНастройкиОбмена(Объект.НастройкаОбмена);
	Если ЗначениеЗаполнено(ТекущаяСтрока.НастройкаОбмена) И ДанныеНастройкиОбмена.СпособОбмена = 0 И ДанныеНастройкиОбмена.КаталогНаКлиенте Тогда
		ТекущаяСтрока.РезультатЗагрузки = Ждать ПолучитьФайл_ЛокСеть();
		Попытка
			АдресФайлаТС = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаОбменаПриемник), УникальныйИдентификатор);
			КаталогНаКлиенте = Истина;
			ОбратныйВызов = Новый ОписаниеОповещения("УдалитьЗавершение", ЭтотОбъект );
			НачатьУдалениеФайлов(ОбратныйВызов, ПолноеИмяФайлаОбменаПриемник );
			// УдалитьФайлы(ПолноеИмяФайлаОбменаПриемник);
		Исключение
			ТекстОшибки = "Ошибка помещения файла выгрузки на сервер для выполнения операции загрузки!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			ТекущаяСтрока.РезультатЗагрузки = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	СтрокаОшибкиЗагрузка = "";
	ТекущаяСтрока.РезультатЗагрузки = ВыполнитьЗагрузкуСервер(СтрокаОшибкиЗагрузка);
	
	Если ТекущаяСтрока.РезультатЗагрузки Тогда
		ТекущаяСтрока.ПоследняяЗагрузка = ?(ПустаяСтрока(СтрокаОшибкиЗагрузка), "ОК: Сообщение обмена успешно загружено", СтрокаОшибкиЗагрузка);
	Иначе
		ТекущаяСтрока.ПоследняяЗагрузка = "Ошибка: " + СтрокаОшибкиЗагрузка;
		РезультатОбмена = Ложь;
	КонецЕсли;
	
	Возврат РезультатОбмена;
	
КонецФункции

// Запись сообщения из узла при обмене со всеми.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ЗаписатьСообщениеДляУзлаПриОбменеСоВсеми(ТекущаяСтрока)
	
	РезультатОбмена = Истина;
	
	ОбработкаПрерыванияПользователя();
	
	// Поместим текущие данные строки в реквизиты обработки.
	Объект.УзелОбмена = ТекущаяСтрока.УзелОбмена;
	Объект.НастройкаОбмена = ТекущаяСтрока.НастройкаОбмена;
	
	Если Объект.УзелОбмена.Пустая() ИЛИ Объект.НастройкаОбмена.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаОшибкиВыгрузка = "";
	ТекущаяСтрока.РезультатВыгрузки = ВыполнитьВыгрузкуСервер(Ложь, СтрокаОшибкиВыгрузка);
	
	Если ТекущаяСтрока.РезультатВыгрузки Тогда
		ТекущаяСтрока.ПоследняяВыгрузка = ?(ПустаяСтрока(СтрокаОшибкиВыгрузка), "ОК: Сообщение обмена успешно выгружено", СтрокаОшибкиВыгрузка);
	Иначе
		ТекущаяСтрока.ПоследняяВыгрузка = "Ошибка: " + СтрокаОшибкиВыгрузка;
		РезультатОбмена = Ложь;
	КонецЕсли;
	
	Возврат РезультатОбмена;
	
КонецФункции


// Функция для проверки корректности выбранного значение в реквизиты формы
//
// Параметры:
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  ТекстСообщения - Произвольный - Текст сообщения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервереБезКонтекста
Функция ПроверитьНастройкуДоставкиНаСервере(НастройкаДоставки, ТекстСообщения = "")
	Результат = Ложь;
	
	Если НЕ ЗначениеЗаполнено(НастройкаДоставки) Тогда
		ТекстСообщения = "Настройка доставки не указана, необходимо выбрать настройку доставки.";
	ИначеЕсли (НастройкаДоставки.СпособОбмена = 0) 
		ИЛИ (НастройкаДоставки.СпособОбмена = 3)
		ИЛИ (НастройкаДоставки.СпособОбмена = 4) Тогда 
		Результат = питОбменДанными.ПроверитьДоставкуСообщения(НастройкаДоставки, ТекстСообщения);
	Иначе
		ТекстСообщения = "Способ доставки указанный в выбранной настройке доставки сообщений не поддерживается ПО кассового узла.
						|Укажите другую настройку доставки, либо измените способ доставки в текущей выбранной настройке доставки.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура заполнения пометок.
//
&НаКлиенте
Процедура ЗапомнитьПометки()
	Пометки.Очистить();
	НайденныеСтроки = УзлыОбмена.НайтиСтроки(Новый Структура("Пометка", Истина));
	Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
		НоваяСтрока = Пометки.Добавить();
		НоваяСтрока.УзелОбмена = ТекущаяСтрока.УзелОбмена;
	КонецЦикла;
КонецПроцедуры

// Проверят наличие указанного в параметре каталога.
//  Если отсутствует, то пытается создать новый.
//  Добавляет заключительный знак "\" к переданному пути
//
// Параметры:
//  Путь - Произвольный - Путь.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
// Возвращаемое значение:
// 	-	Булево - Истина, если каталог есть (или был создан). 
&НаКлиенте
Асинх Функция ЕстьКаталогКлиент(Путь,ТекстОшибки="")
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ (ТипЗнч(Путь) <> Тип("Строка")) Тогда
		ТекстОшибки = "Ошибка: Неверный параметр";
		Возврат Ложь;
	КонецЕсли;
	Если Прав(Путь,1) <> "\" И Прав(Путь,1) <> "/" Тогда
		Путь = Путь + Слеш;
	КонецЕсли;
	Попытка
		ПроверкаКаталога = Новый Файл(Путь);
		РезультатАсинх  = Ждать ПроверкаКаталога.СуществуетАсинх();
		Если НЕ РезультатАсинх Тогда
			СоздатьКаталог(Путь);
			ТекстОшибки = "Создан каталог: " + Путь;
			ПроверкаКаталога = Новый Файл(Путь);
		КонецЕсли;
		
		РезультатАсинх  = Ждать ПроверкаКаталога.СуществуетАсинх();
		Если РезультатАсинх Тогда
			
			РезультатАсинх  = Ждать ПроверкаКаталога.ЭтоКаталогАсинх();
			Если РезультатАсинх Тогда
				Результат = Истина;
			Иначе
				ТекстОшибки = "Ошибка: заданный путь <"+Путь+"> не является каталогом (возможно это файл?)";
				Результат = Ложь;
			КонецЕсли;
		Иначе
			ТекстОшибки = "Ошибка: не удалось создать каталог: <"+Путь+">";
			Результат = Ложь;
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Результат = Ложь;
	КонецПопытки;
	// Возвращаем то, что у нас получилось.
	Возврат Результат;
КонецФункции // ЕстьКаталог



// Функция получения файла с новым сообщением обмена
//  В указанный файл ищет и копирует  файл с последним сообщением обмена
//
// Параметры:
//  ИмяПолученногоФайла - Произвольный -  файл, в который будет произведено копирование 
//   файла с сообщением обмена.
//
// Возвращаемое значение:
//  Булево - Истина, если файл с сообщением обмена получен, Ложь, в противном случае.
//
&НаКлиенте
Асинх Функция ПолучитьФайл_ЛокСеть(ИмяПолученногоФайла = "")
	
	НастройкаДоставки = питОбменДанными.ПолучитьДанныеНастройкиОбмена(Объект.НастройкаОбмена);
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	КорневойКаталог="";
	КаталогТемпФайлов="";
	КаталогФайловСообщений="";
	КаталогОбработанныхСообщений="";
	КаталогОтправленныхСообщений="";
	
	Если ПустаяСтрока(КорневойКаталог) Тогда
		КорневойКаталог = НастройкаДоставки.КаталогОбменов;
	КонецЕсли; 
	Если Прав(КорневойКаталог,1) <> "\" И Прав(КорневойКаталог,1) <> "/" Тогда
		КорневойКаталог = КорневойКаталог + Слеш;
	КонецЕсли;
	
	СтрОшибка = "";
	Результат = Ждать ЕстьКаталогКлиент(КорневойКаталог, СтрОшибка);
	Если НЕ Результат Тогда
		//?? Ошибка. Параметры формы доступны только для чтения.
		//?? Параметры.Вставить("Ошибка", СтрОшибка);
		Возврат Ложь;
	КонецЕсли;
	
	КаталогФайловСообщений = КорневойКаталог;
	
	Если НастройкаДоставки.ИспользоватьВременныйКаталог Тогда
		КаталогТемпФайлов = НастройкаДоставки.КаталогВременныхФайлов;
		Если ПустаяСтрока(КаталогТемпФайлов) Тогда
			КаталогТемпФайлов = КаталогВременныхФайлов();
		КонецЕсли; 
	Иначе
		КаталогТемпФайлов = КаталогВременныхФайлов();
	КонецЕсли;
	
	Если НастройкаДоставки.СохранятьОтправленные Тогда
		КаталогОтправленныхСообщений = НастройкаДоставки.КаталогОтправленныхСообщений;
		Если ПустаяСтрока(КаталогОтправленныхСообщений) Тогда
			КаталогОтправленныхСообщений = "";
		КонецЕсли; 
	Иначе
		КаталогОтправленныхСообщений = "";
	КонецЕсли;
	
	Если НастройкаДоставки.СохранятьПолученные Тогда
		КаталогОбработанныхСообщений = НастройкаДоставки.КаталогПолученныхСообщений;
		Если ПустаяСтрока(КаталогОбработанныхСообщений) Тогда
			КаталогОбработанныхСообщений = "";
		КонецЕсли;
	Иначе
		КаталогОбработанныхСообщений = "";
	КонецЕсли;
	
	Если НЕ Ждать ЕстьКаталогКлиент(КаталогТемпФайлов) Тогда
		КаталогТемпФайлов = "";
	КонецЕсли;
	
	Если НЕ Ждать ЕстьКаталогКлиент(КаталогОтправленныхСообщений) Тогда
		КаталогОтправленныхСообщений = "";
	КонецЕсли;
	
	Если НЕ Ждать ЕстьКаталогКлиент(КаталогОбработанныхСообщений) Тогда
		КаталогОбработанныхСообщений = "";
	КонецЕсли;
	
	// Получаем маску для поиска файлов с сообщениями обмена
	МаскаФайловИсточник = питОбменДанными.ИмяФайлаДоставки(Объект.УзелОбмена, Ложь, "*", "*"); 
	
	// получим ожидаемое имя файла для приема
	ОжидаемоеИмяФайла = питОбменДанными.ИмяФайлаДоставки(Объект.УзелОбмена,Ложь,Неопределено,"*", ,Ложь);
	ОжидаемоеИмяФайла = Лев(ОжидаемоеИмяФайла,Найти(ОжидаемоеИмяФайла,".")-1);
	ОжидаемоеИмяФайлаСРасширением = ОжидаемоеИмяФайла + ".xml";
	
	#Если Клиент Тогда
		Состояние("Ждите. Идет получение файла обмена ...");
	#КонецЕсли
	ПолноеИмяФайлаОбменаИсточник = "";
	ИмяФайлаОбменаИсточник = "";
	ИмяСМаксНомером = "";
	ТемпФайлыДляУдаления ="";
	
	// Отбираем файл с максимальным номером в имени в каталоге-источнике.
	// Файлы = НайтиФайлы(КаталогФайловСообщений, МаскаФайловИсточник);
	Файлы = Ждать НайтиФайлыАсинх(КаталогФайловСообщений, МаскаФайловИсточник);
	Для Каждого Файл Из Файлы Цикл
		
		ТекНомерСообщения = ВыделитьНомерСообщенияКлиент(Файл.ИмяБезРасширения);
		ОжидаемыйНомерСообщения = ВыделитьНомерСообщенияКлиент(ОжидаемоеИмяФайла);
		МаксНомерСообщения = ВыделитьНомерСообщенияКлиент(ИмяСМаксНомером);
		
		Если ВРег(Файл.Расширение) <> ".XML" И ВРег(Файл.Расширение) <> ".ZIP" Тогда
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> имеет некорректное расширение (" + СокрЛП(ВРег(Файл.Расширение))
			+ ") и будет удален.";
			
			Продолжить;
			
		КонецЕсли; 
		
		Если ТекНомерСообщения < ОжидаемыйНомерСообщения Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. "
			+ "Ожидаемый файл - <" + ОжидаемоеИмяФайлаСРасширением + ">.";
			
			Продолжить;
		КонецЕсли;
		
		Если (МаксНомерСообщения > 0) И (ТекНомерСообщения < МаксНомерСообщения) Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. "
			+ "Актуальный файл - <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ПолноеИмяФайлаОбменаИсточник) + ">.";
			
			Продолжить;
		КонецЕсли;
		
		Если ТекНомерСообщения > МаксНомерСообщения Тогда
			// Не успели его прочитать как оно уже устарело (прислали с еще бОльшим номером).
			Если НЕ ПустаяСтрока(ПолноеИмяФайлаОбменаИсточник) Тогда
				ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ПолноеИмяФайлаОбменаИсточник; // Предыдущего кандидата переносим в черный список
				
				СтрСообщения = "Файл обмена <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ПолноеИмяФайлаОбменаИсточник) 
				+ "> устарел и будет удален. Актуальный файл - <" + Файл.Имя + ">.";
				
			КонецЕсли;
			ПолноеИмяФайлаОбменаИсточник = Файл.ПолноеИмя;	// Здесь теперь запоминаем нового кандидата
			ИмяСМаксНомером = Файл.ИмяБезРасширения;		// Номер изменим для следующих сравнений
		КонецЕсли;
		
	КонецЦикла;
	
	Рез = Ложь;
	
	ПолноеИмяФайлаОбменаПриемник = ПолноеИмяФайлаОбменаИсточник; // это один и тот же файл
	Если ПустаяСтрока(ПолноеИмяФайлаОбменаИсточник) Тогда
		СтрСообщения = "Не найдено сообщение обмена в локальном каталоге <" + КаталогФайловСообщений + ">";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСообщения);
		Возврат Истина; // Сообщение не найдено
	КонецЕсли;
	
	
	ФайлСообщения = Новый Файл(ПолноеИмяФайлаОбменаПриемник); 
	РезультатФайлСуществует = Ждать ФайлСообщения.СуществуетАсинх();
	РезультатЭтоФайл = Ждать ФайлСообщения.ЭтоФайлАсинх();

	Если НЕ (РезультатФайлСуществует И РезультатЭтоФайл ) Тогда
		СтрСообщения = "Не найдено сообщение обмена: " + ПолноеИмяФайлаОбменаПриемник + " в локальном каталоге <" + КаталогФайловСообщений + ">";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСообщения);
		Возврат Истина;
	КонецЕсли;
	
	Если НРег(Прав(ПолноеИмяФайлаОбменаПриемник, 3)) = "zip" Тогда
		Рез = Ждать РаспаковатьПолученныйФайл(ФайлСообщения, КаталогТемпФайлов, НастройкаДоставки);
		Если Рез = Ложь Тогда
			Возврат Рез;
		КонецЕсли;
		ПолноеИмяФайлаОбменаПриемник = ФайлСообщения.ПолноеИмя; // Теперь это xml вместо zip
	КонецЕсли;
	
	ПутьФайла=ВРЕГ(ФайлСообщения.Путь);
	Если Прав(ПутьФайла,1) <> "\" И Прав(ПутьФайла,1) <> "/" Тогда
		ПутьФайла = ПутьФайла + Слеш;
	КонецЕсли;
	
	Рез = Истина; 
	ИмяПолученногоФайла = ФайлСообщения.ПолноеИмя;
	
	ИмяФайлаДляЗагрузки = ФайлСообщения.Имя;
	
	СтрСообщения = "Конец получения файла сообщения <" + ФайлСообщения.ПолноеИмя + "> из локального каталога <" + КаталогФайловСообщений + ">";
	
	Возврат Рез;
	
КонецФункции // ПолучитьФайлОбмена(ИмяФайла)
#КонецОбласти




