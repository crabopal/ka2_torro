// СОБЫТИЯ ФОРМЫ

// Обработчик события "При создании на сервере"
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	Объект.Комментировать = Истина;
	
	Объект.ФиксироватьПоОбъекту = Ложь;
	Объект.КоличествоЭлементовВТранзакции = 100;
	Объект.ВестиЖурналРегистрации = Истина;
	
	ОбновитьТаблицуКассовыхУзлов();
	
	МожноВыгружатьНО = РольДоступна("питИспользованиеОбменаСУдаленнымиКассамиВыгрузкаНО") ИЛИ РольДоступна("питОбщепитПолныеПрава") ИЛИ РольДоступна("ПолныеПрава");
	Элементы.ФормаВыгрузкаНачальногоОбраза.Видимость = МожноВыгружатьНО;
	
КонецПроцедуры

// Обработчик события формы "При открытии"
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для Каждого ТекущаяСтрока Из Пометки Цикл
		НайденныеСтроки = УзлыОбмена.НайтиСтроки(Новый Структура("УзелОбмена", ТекущаяСтрока.УзелОбмена));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Пометка = Истина;
		КонецЦикла;
	КонецЦикла;
	ЗапомнитьПометки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

// Обработчик события "Перед началом добавления"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//
&НаКлиенте
Процедура УзлыОбменаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
КонецПроцедуры

// Обработчик события "Перед удалением"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура УзлыОбменаПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

// Обработчик изменения реквизита "Настройка обмена"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Асинх Процедура УзлыОбменаНастройкаОбменаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.УзлыОбмена.ТекущиеДанные;
	// Каталог на клиенте. Проверка способа доставки.
	ТекстОшибки = "";  
	ДанныеНастройкиОбмена = питОбменДанными.ПолучитьДанныеНастройкиОбмена(ТекущаяСтрока.НастройкаОбмена);
	Если (ДанныеНастройкиОбмена.СпособОбмена = 0 И ДанныеНастройкиОбмена.КаталогНаКлиенте) Тогда
		
		ОбнаруженыКритическиеОшибки = НЕ Ждать ПроверитьДоставкуСообщенияНаКлиенте(ДанныеНастройкиОбмена, ТекстОшибки);
	ИначеЕсли НЕ ДанныеНастройкиОбмена.КаталогНаКлиенте Тогда
		ОбнаруженыКритическиеОшибки = НЕ Ждать ПроверитьНастройкуДоставкиНаСервере(ТекущаяСтрока.НастройкаОбмена, ТекстОшибки);
	КонецЕсли;
	Если ОбнаруженыКритическиеОшибки Тогда
		ШаблонСообщения = НСтр("ru = 'Настройка доставки не прошла проверку:
		|%1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "НастройкаОбмена", "УзлыОбмена");
		Возврат; 
	КонецЕсли;
	
	УстановитьНовуюНастройкуДоставки(ТекущаяСтрока.УзелОбмена, ТекущаяСтрока.НастройкаОбмена);
КонецПроцедуры

// Обработчик изменения флага "Пометка".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура УзлыОбменаПометкаПриИзменении(Элемент)
	ЗапомнитьПометки();
КонецПроцедуры

// Обработчик события выбора строки таблицы узлов обмена.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура УзлыОбменаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	
	Если Поле = Элементы.УзлыОбменаУзелОбмена Тогда		
		ОткрытьФорму("ПланОбмена.питУдаленныеКассы.ФормаОбъекта", Новый Структура("Ключ", УзлыОбмена.Получить(ВыбраннаяСтрока).УзелОбмена), ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Процедура полной регистрации данных
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПолнаяРегистрация(Команда)
	
	МассивСтрок = УзлыОбмена.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны кассовые узлы для выполнения полной регистрации данных!", , "УзлыОбмена");
		Возврат;
	КонецЕсли; 
	
	МассивСтрок = УзлыОбмена.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	РезультатОбмена = Истина;
	Для Каждого ТекущаяСтрока Из МассивСтрок Цикл
		ОбработкаПрерыванияПользователя();
		
		Объект.УзелОбмена      = ТекущаяСтрока.УзелОбмена;
		
		Если Объект.УзелОбмена.Пустая() Тогда
			Продолжить;
		КонецЕсли;
				
		СтрОшибки = "";
		ТекущаяСтрока.РезультатВыгрузки = ПолнаяРегистрацияНаСервере(СтрОшибки);
		
		Если ТекущаяСтрока.РезультатВыгрузки Тогда
			ТекущаяСтрока.ПоследняяВыгрузка = "Данные зарегистрированы, можно выгружать";
		Иначе
			ТекущаяСтрока.ПоследняяВыгрузка = "Ошибка: " + СтрОшибки;
			РезультатОбмена = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если РезультатОбмена Тогда
		ПоказатьПредупреждение(Неопределено, "Регистрация данных успешно выполнена!",,"Результат операции");
	Иначе	
		ПоказатьПредупреждение(Неопределено, "Регистрация данных закончилась с ошибками!",,"Результат операции");
	КонецЕсли;
	
	
КонецПроцедуры

// Обработчик команды "Выгрузка"
