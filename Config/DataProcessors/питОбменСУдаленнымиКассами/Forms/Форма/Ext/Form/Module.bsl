
#Область ПрограммныйИнтерфейс

// Выполняет распаковку файла сообщения
//  Параметры
//
// Параметры:
//  ФайлСообщения - Произвольный - Файл сообщения.
//  КаталогТемпФайлов - Произвольный - Каталог темп файлов.
//  НастройкаДоставки - Произвольный - Настройка доставки.
//
// Возвращаемое значение:
//   Булево - Флаг успешного завершения распаковки
&НаКлиенте
Асинх Функция РаспаковатьПолученныйФайл(ФайлСообщения, КаталогТемпФайлов, НастройкаДоставки) Экспорт
	Рез = Ложь;
	// Почистим временный каталог от прошлых попыток распаковки
	СтарыеФайлы = НайтиФайлы(КаталогТемпФайлов + ФайлСообщения.ИмяБезРасширения + ".xml");
	Для Каждого СтарыйФайл Из СтарыеФайлы Цикл
		УдалитьФайлы(СтарыйФайл.ПолноеИмя);
	КонецЦикла;
	Попытка // Попытка распаковать
		ФайлZIP = Новый ЧтениеZipФайла(ФайлСообщения.ПолноеИмя,НастройкаДоставки.ПарольАрхивации);
		#Если Клиент Тогда
			Состояние("Распаковка ZIP-архива...");
		#КонецЕсли
		ФайлZIP.ИзвлечьВсе(КаталогТемпФайлов);
		ФайлZIP.Закрыть();
		#Если Клиент Тогда
			Состояние("Распаковка ZIP-архива - ОК");
		#КонецЕсли
	Исключение
		СтрСообщения = "Не удалось распаковать файл <" + ФайлСообщения.ПолноеИмя + "> в каталог <" + КаталогТемпФайлов + "> " + ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	// Попробуем найти результат
	ФайлСообщения = Новый Файл(КаталогТемпФайлов + ФайлСообщения.ИмяБезРасширения + ".xml");
	РезультатФайлСуществует = Ждать ФайлСообщения.СуществуетАсинх();
	РезультатЭтоФайл = Ждать ФайлСообщения.ЭтоФайлАсинх();

	Если НЕ (РезультатФайлСуществует И РезультатЭтоФайл ) Тогда
		СтрСообщения = "Не удалось распаковать файл обмена  <" + ФайлСообщения.ПолноеИмя + ">";
		Возврат Ложь;
	Иначе
		Рез = Истина;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции // РаспаковатьФайлСообщения()

// Получает номер сообщения обмена по имени файла
//  Параметры
//
// Параметры:
//  ИмяФайла - Произвольный - Имя файла.
//  Тип - Произвольный - Тип.
//
// Возвращаемое значение:
// 	Число. Номер сообщения обмена
&НаКлиенте
Функция ВыделитьНомерСообщенияКлиент(ИмяФайла, Тип = "Число") Экспорт
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		НомерСообщения = 0;
		Возврат НомерСообщения;
	КонецЕсли; 
	
	Колво = СтрДлина(ИмяФайла);
	НомерСообщения = "";
	ФлагНачалосьВыделение = Ложь;
	
	Для НомерСимвола = 0 По Колво - 1 Цикл
		
		ТекСимвол = Сред(ИмяФайла, Колво - НомерСимвола, 1);
		
		Если Найти("0123456789", ТекСимвол) > 0 Тогда
			ФлагНачалосьВыделение = Истина;
			НомерСообщения = ТекСимвол + НомерСообщения;
			
		ИначеЕсли ФлагНачалосьВыделение Тогда
			// цифры закончились
			Прервать;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если Тип = "Число" Тогда 
		Возврат Число(НомерСообщения);
	ИначеЕсли Тип = "Строка" Тогда 
		Возврат НомерСообщения;
	КонецЕсли;
	
КонецФункции // ВыделитьНомерСообщения()

//  Процедура - Выполнить после закрытия вопроса.
//
// Параметры:
//  Существует - Произвольный - Существует.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВыполнитьПослеЗакрытияВопроса(Существует, ДополнительныеПараметры) Экспорт

	Путь = ДополнительныеПараметры.Путь;
	Если НЕ Существует Тогда
		ОбратныйВызов = Новый ОписаниеОповещения("ОбработкаЗавершенияСозданияКаталога", ЭтотОбъект);
		НачатьСозданиеКаталога(ОбратныйВызов, Путь);
		// СоздатьКаталог(Путь);
		ТекстОшибки = "Создан каталог: " + Путь;
		ПроверкаКаталога = Новый Файл(Путь);
		
	Иначе
		ПроверкаКаталога = ДополнительныеПараметры.ПроверкаКаталога;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПроверкаКаталога", ПроверкаКаталога); 
	ДополнительныеПараметры.Вставить("Путь", Путь);
	ПроверкаКаталога.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ВыполнитьПроверкуФайлаПовторно", ЭтотОбъект), ДополнительныеПараметры);
	
КонецПроцедуры

//  Процедура - Обработка завершения создания каталога.
//
// Параметры:
//  ИмяКаталога - Произвольный - Имя каталога.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработкаЗавершенияСозданияКаталога(ИмяКаталога, ДополнительныеПараметры) Экспорт
	Сообщение = Новый СообщениеПользователю();
    Сообщение.Текст = "Каталог создан: " + ИмяКаталога;
    Сообщение.Сообщить();
КонецПроцедуры

//  Процедура - Обработка завершения поиска каталог файлов сообщений.
//
// Параметры:
//  НайденныеФайлы - Произвольный - Найденные файлы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработкаЗавершенияПоискаКаталогФайловСообщений(НайденныеФайлы, ДополнительныеПараметры) Экспорт
 

	Для Каждого Файл Из НайденныеФайлы Цикл
		
		ТекНомерСообщения = ВыделитьНомерСообщенияКлиент(Файл.ИмяБезРасширения);
		ОжидаемыйНомерСообщения = ВыделитьНомерСообщенияКлиент(ДополнительныеПараметры.ОжидаемоеИмяФайла);
		МаксНомерСообщения = ВыделитьНомерСообщенияКлиент(ДополнительныеПараметры.ИмяСМаксНомером);
		
		Если ВРег(Файл.Расширение) <> ".XML" И ВРег(Файл.Расширение) <> ".ZIP" Тогда
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> имеет некорректное расширение (" + СокрЛП(ВРег(Файл.Расширение))
			+ ") и будет удален.";
			
			Продолжить;
			
		КонецЕсли; 
		
		Если ТекНомерСообщения < ОжидаемыйНомерСообщения Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. "
			+ "Ожидаемый файл - <" + ДополнительныеПараметры.ОжидаемоеИмяФайлаСРасширением + ">.";
			
			Продолжить;
		КонецЕсли;
		
		Если (МаксНомерСообщения > 0) И (ТекНомерСообщения < МаксНомерСообщения) Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. "
			+ "Актуальный файл - <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ДополнительныеПараметры.ПолноеИмяФайлаОбменаИсточник) + ">.";
			
			Продолжить;
		КонецЕсли;
		
		Если ТекНомерСообщения > МаксНомерСообщения Тогда
			// Не успели его прочитать как оно уже устарело (прислали с еще бОльшим номером).
			Если НЕ ПустаяСтрока(ДополнительныеПараметры.ПолноеИмяФайлаОбменаИсточник) Тогда
				ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ДополнительныеПараметры.ПолноеИмяФайлаОбменаИсточник; // Предыдущего кандидата переносим в черный список
				
				СтрСообщения = "Файл обмена <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ДополнительныеПараметры.ПолноеИмяФайлаОбменаИсточник) 
				+ "> устарел и будет удален. Актуальный файл - <" + Файл.Имя + ">.";
				
			КонецЕсли;
			ПолноеИмяФайлаОбменаИсточник = Файл.ПолноеИмя;	// Здесь теперь запоминаем нового кандидата
			ИмяСМаксНомером = Файл.ИмяБезРасширения;		// Номер изменим для следующих сравнений
		КонецЕсли;
		
	КонецЦикла;

 
КонецПроцедуры

//  Процедура - Обработка завершения поиска.
//
// Параметры:
//  НайденныеФайлы - Произвольный - Найденные файлы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработкаЗавершенияПоиска(НайденныеФайлы, ДополнительныеПараметры) Экспорт
 
	Если НайденныеФайлы.Количество() = 0 Тогда
        ОтветНаВопрос = Ложь;
	Иначе 
		ОтветНаВопрос = Истина;
	КонецЕсли;	
 
КонецПроцедуры


//  Процедура - Поиск старых файлов.
//
// Параметры:
//  НайденныеФайлы - Произвольный - Найденные файлы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Асинх Процедура ПоискСтарыхФайлов(НайденныеФайлы, ДополнительныеПараметры) Экспорт

	Если НайденныеФайлы.Количество() = 0 Тогда
        ОтветНаВопрос = Ложь;
	Иначе 
		ОтветНаВопрос = Истина;
	КонецЕсли;

	Для Каждого СтарыйФайл Из НайденныеФайлы Цикл
		Результат = Ждать УдалитьФайлыАсинх(СтарыйФайл.ПолноеИмя);
		 // УдалитьФайлы(СтарыйФайл.ПолноеИмя);
	КонецЦикла;
	Попытка // Попытка распаковать
		ФайлZIP = Новый ЧтениеZipФайла(ДополнительныеПараметры.ФайлСообщенияПолноеИмя, ДополнительныеПараметры.НастройкаДоставкиПарольАрхивации);
		#Если Клиент Тогда
			Состояние("Распаковка ZIP-архива...");
		#КонецЕсли
		ФайлZIP.ИзвлечьВсе(ДополнительныеПараметры.КаталогТемпФайлов);
		ФайлZIP.Закрыть();
		#Если Клиент Тогда
			Состояние("Распаковка ZIP-архива - ОК");
		#КонецЕсли
	Исключение
		СтрСообщения = "Не удалось распаковать файл <" +ДополнительныеПараметры.ФайлСообщенияПолноеИмя + "> в каталог <" + ДополнительныеПараметры.КаталогТемпФайлов + "> " + ОписаниеОшибки();
		ОтветНаВопрос = Ложь;
	КонецПопытки;	
 
КонецПроцедуры

//  Процедура - Обработка ошибки.
//
// Параметры:
//  ИнформацияОбОшибке - Произвольный - Информация об ошибке.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработкаОшибки(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт
	
    Сообщение = Новый СообщениеПользователю();
    Сообщение.Текст = "Ошибка поиска файлов: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
    Сообщение.Сообщить();	
 
КонецПроцедуры 

//  Процедура - Выполнить проверку файла повторно.
//
// Параметры:
//  Существует - Произвольный - Существует.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВыполнитьПроверкуФайлаПовторно(Существует, ДополнительныеПараметры) Экспорт
	
	Если Существует Тогда
		Если ДополнительныеПараметры.ПроверкаКаталога.ЭтоКаталог() Тогда
			ОтветНаВопрос = Истина;
		Иначе
			ТекстОшибки = "Ошибка: заданный путь <"+ДополнительныеПараметры.Путь+"> не является каталогом (возможно это файл?)";
			ОтветНаВопрос = Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "Ошибка: не удалось создать каталог: <"+ДополнительныеПараметры.Путь+">";
		ОтветНаВопрос = Ложь;
	КонецЕсли;
	
	
КонецПроцедуры

//  Процедура - Выполнить проверку файла.
//
// Параметры:
//  Существует - Произвольный - Существует.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВыполнитьПроверкуФайла(Существует, ДополнительныеПараметры) Экспорт
	
	ОтветНаВопрос = Существует;	
	
КонецПроцедуры

// Процедура - Удалить завершение
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура УдалитьЗавершение(ДополнительныеПараметры) Экспорт
	Сообщение = Новый СообщениеПользователю();
    Сообщение.Текст = "Удаление успешно завершено";
    Сообщение.Сообщить();
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийФормы

