
#Область ОписаниеПеременных

#Область ПеременныеМодуля
&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем ФормаДлительнойОперации;

#КонецОбласти

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Процедура - Оповещение о не заполненном периоде при обновлении списка
//
// Параметры:
//  Результат - КодВозвратаДиалога - Ответ пользователя.
//  ДополнительныеПараметры - Структура - Параметры процедуры родителя.
//
&НаКлиенте
Процедура ОповещениеОНеЗаполненномПериодеПриОбновленииСписка(Результат,ДополнительныеПараметры) Экспорт 
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСписокДокументов(Неопределено, ДополнительныеПараметры.ВыполнятьПроверки, Ложь);
	
КонецПроцедуры

//  Функция - Задание еще выполняется.
//
// Параметры:
//  ИдентификаторЗадания - Произвольный - Идентификатор задания.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЗаданиеЕщеВыполняется(ИдентификаторЗадания) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	Возврат Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно;
	
КонецФункции



#Область ЗакрытиеМесяца
// Читает сообщение от фонового задания и обновляет индикатор у составной длительной операции.
//
// Параметры:
//  Форма - УправляемаяФорма - форма с прогресс-баром.
//
// Возвращаемое значение:
//   Неопределено - если фоновое задание не найдено.
//   Булево      - Истина, если сообщение от фонового задания было; иначе Ложь.
&НаКлиенте
Функция ВыполненШагДлительнойОперации(Форма) Экспорт
	
	ИдентификаторЗадания = Форма.ИдентификаторЗадания;
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Получаем долю (число от 0 до 1) шагов, которые сделаны.
	Прогресс = ПрочитатьПрогресс(ИдентификаторЗадания);
	
	ВыполненШаг = Неопределено;
	Если Прогресс.ЗаданиеВыполнено Тогда
		
		// фоновое задание не найдено
		
	ИначеЕсли Прогресс.Свойство("ДополнительныеПараметры")
		И ТипЗнч(Прогресс.ДополнительныеПараметры) = Тип("Структура") Тогда // Отражаем информацию о выполнении части операции
		
		ТекстСообщения = ?(Прогресс.Свойство("Текст"), Прогресс.Текст, "");
		
		Форма.ОбновитьСостояниеВыполнения(Прогресс.ДополнительныеПараметры, ТекстСообщения);

		ВыполненШаг = Истина;
		
	Иначе // немного продвигаем индикатор на один из условных этапов внутри шага
		
		Форма.ПродвинутьПрогрессБезСобытия();
		ВыполненШаг = Ложь;
		
	КонецЕсли;
	
	Возврат ВыполненШаг;
	
КонецФункции


// Заполняет структуру параметров новыми расчетными значениями.
//
// Параметры:
//  ПараметрыОбработчикаОжидания - Структура - заполняется расчетными значениями.
//
&НаКлиенте
Процедура ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания) Экспорт
	
	ПараметрыОбработчикаОжидания.ТекущийИнтервал = Макс(ПараметрыОбработчикаОжидания.МинимальныйИнтервал, ПараметрыОбработчикаОжидания.ТекущийИнтервал / 2);
	
КонецПроцедуры

// Читает сообщение от длительной операции о ее текущем состоянии.
//
// Параметры:
//  Знач ИдентификаторЗадания - Произвольный - Знач идентификатор задания.
//
// Возвращаемое значение:
//   Структура   - всегда содержит ключ ЗаданиеВыполнено. Ложь, если существует фоновое задание с ИдентификаторЗадания.
//                 Иные ключи структуры см. ДлительныеОперации.СообщитьПрогресс()
&НаСервере
Функция ПрочитатьПрогресс(Знач ИдентификаторЗадания) Экспорт
	
	ПрогрессЗадания = ДлительныеОперации.ПрочитатьПрогресс(ИдентификаторЗадания);
	
	// Добавляем флаг "ЗаданиеВыполнено", чтобы различать случаи: когда отсутствуют сообщения и когда завершено задание.
	Если ПрогрессЗадания = Неопределено
	 Или ТипЗнч(ПрогрессЗадания) <> Тип("Структура") Тогда // или нет задания, или нет сообщений
		ПрогрессЗадания = Новый Структура;
	КонецЕсли;
	ПрогрессЗадания.Вставить("ЗаданиеВыполнено", ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания));
	
	Возврат ПрогрессЗадания;
	
КонецФункции


//  Процедура - Закрытие отчета оповещение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ЗакрытиеОтчетаОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	ДатаОкончанияАктуализации   = Неопределено;
	ОрганизацияОтчета           = Неопределено;
	
КонецПроцедуры

#КонецОбласти


#КонецОбласти

#Область ОбработчикиСобытийФормы

//  Процедура - При сохранении данных в настройках на сервере.
//
// Параметры:
//  Настройки - Произвольный - Настройки.
//
&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	СохранитьНастройки();
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Инициализация();
	
	// восстанавливаем настройки, сохраненные при последнем закрытии формы
	ВосстановитьНастройки();

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

//  Процедура - Таблица документов при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаДокументовПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Исправим показатель и родительской таблице.
	СтрокаБезОтборов = ТаблицаДокументовБезОтборов.НайтиПоИдентификатору(ТекущаяСтрока.КлючСвязи);
	Если НЕ СтрокаБезОтборов = Неопределено  Тогда
		СтрокаБезОтборов.Использовать = ТекущаяСтрока.Использовать;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Таблица документов использовать при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаДокументовИспользоватьПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Принудительно установим в отрицание флаг использования.
	Если НЕ ПерепроводитьДокументы И ТекущаяСтрока.Проведен Тогда
		ТекущаяСтрока.Использовать = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

//  Процедура - Только непроведенные.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТолькоНепроведенные(Команда)
	ТолькоНеПроведенные = НЕ Элементы.ТаблицаДокументовТолькоНепроведенные.Пометка;
	Элементы.ТаблицаДокументовТолькоНепроведенные.Пометка = ТолькоНеПроведенные;
	
	// Установим отбор.
	ОбновитьСписокДокументов(Неопределено, Ложь);
КонецПроцедуры

//  Процедура - Обновить список документов.
//
// Параметры:
//  Команда - Произвольный - Команда.
//  ВыполнятьПроверки - Произвольный - Выполнять проверки.
//  ПредупреждатьОНезаполненномПериоде - Произвольный - Предупреждать о незаполненном периоде.
//
&НаКлиенте
Процедура ОбновитьСписокДокументов(Команда,ВыполнятьПроверки = Истина, ПредупреждатьОНезаполненномПериоде = Истина)
	
	Если ВыполнятьПроверки Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ДатаНачалаОтбора) И ПредупреждатьОНезаполненномПериоде Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ВыполнятьПроверки",ВыполнятьПроверки);
			
			РезультатОповещения = Новый ОписаниеОповещения("ОповещениеОНеЗаполненномПериодеПриОбновленииСписка", ЭтотОбъект,ДополнительныеПараметры);
			ПоказатьВопрос(РезультатОповещения,НСтр("ru='Значение периода не заполнено. Продолжить?'", "ru"),РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет,НСтр("ru='Внимание'", "ru"));
			Возврат;
		КонецЕсли;
		
		Если НЕ МожноВыполнятьКомандыФормы(Ложь, Истина, Ложь) Тогда
			Возврат;
		КонецЕсли;
		
		ОбновитьСписокДокументовНаСервере();
	КонецЕсли;
	
	// Получим список данных с отборами.
	Если Элементы.ТаблицаДокументовТолькоНепроведенные.Пометка Тогда
		СписокДокументов = ТаблицаДокументовБезОтборов.НайтиСтроки(Новый Структура("Проведен", Ложь));
	Иначе
		СписокДокументов = ТаблицаДокументовБезОтборов;
	КонецЕсли;
	
	Объект.ТаблицаДокументов.Очистить();
	
	// Заполним табличную часть формы.
	Для Каждого Документ Из СписокДокументов Цикл
		ТекСтрока = Объект.ТаблицаДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(ТекСтрока, Документ);
		ТекСтрока.КлючСвязи = Документ.ПолучитьИдентификатор();
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Кнопка выполнить проведение.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура КнопкаВыполнитьПроведение(Команда)
	
	// Выполним первичные проверки.
	Если НЕ МожноВыполнятьКомандыФормы(Истина, Ложь, Истина) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ЗапуститьПроведениеЧеков(Неопределено);
	
	Если Результат <> Неопределено Тогда
		
		// Закроем форму регламентной операции, если она открыта.
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		
		// При необходимости выведем отчет.
		Если Результат.Свойство("МассивОбработанныхДокументов") 
			И ВыводитьОтчетОСохраненныхДокументах 
			И ((Результат.МассивОбработанныхДокументов.Количество()) > 0) Тогда
			
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("МассивОбработанныхДокументов", Результат.МассивОбработанныхДокументов);
			
			Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
				МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
				МодульУправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.питПроведениеЧековОбщепита", "СозданныеДокументы", 
				Результат.МассивОбработанныхДокументов, ЭтотОбъект, ПараметрыПечати);
			КонецЕсли;
		КонецЕсли;
		
		// Обновим список документов.
		ОбновитьСписокДокументов(Неопределено,Ложь,Ложь);

	ИначеЕсли ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		
		// Результата еще нет, но есть шансы дождаться
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьЗавершениеДлительнойОперации", 1, Истина);
		
		// Если вызывается после группового перепроведения, то форма может уже быть на экране.
		НадоОткрытьФорму = Истина;
		
		Если ТипЗнч(ФормаДлительнойОперации) = Тип("УправляемаяФорма") Тогда
			Если ФормаДлительнойОперации.Открыта() Тогда
				НадоОткрытьФорму = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если НадоОткрытьФорму Тогда
			
			ОписаниеПроцесса = питПроведениеЧековКлиентСервер.ОписаниеПроцессаДлительнойОперации();
			ОписаниеПроцесса.ИспользоватьПроведениеДокументов = Истина;
			
			ФормаДлительнойОперации = ОткрытьФормуДлительнойОперации(ИдентификаторЗадания, ОписаниеПроцесса);
			
		Иначе
			
			ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания;
			
			ПараметрыФормыИндикации = питПроведениеЧековКлиентСервер.НовыеПараметрыСообщенийПрогресса();
			ПараметрыФормыИндикации.КонтрольРанееЗапущенных = Истина;
			
			ФормаДлительнойОперации.ОбновитьСостояниеВыполнения(ПараметрыФормыИндикации, "");
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - Таблица документов установить все флажки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТаблицаДокументовУстановитьВсеФлажки(Команда)
	УстановитьСнятьФлажкиВТаблицеДокументов(Истина);
КонецПроцедуры

//  Процедура - Таблица документов снять все флажки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТаблицаДокументовСнятьВсеФлажки(Команда)
	УстановитьСнятьФлажкиВТаблицеДокументов(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПрограммныйИнтерфейс

// Процедура - Подключаемый проверить завершение длительной операции
//
&НаКлиенте
Процедура Подключаемый_ПроверитьЗавершениеДлительнойОперации()

	ПроверитьЗавершениеДлительнойОперации("Подключаемый_ПроверитьЗавершениеДлительнойОперации", Истина, Истина);

КонецПроцедуры

#КонецОбласти

// Открывает форму индикации хода длительной операции.
//
// Параметры:
//  Знач ИдентификаторЗадания - Произвольный - Знач идентификатор задания.
//  ОписаниеПроцесса - Структура - см. ОписаниеПроцессаДлительнойОперации(.
//
// Возвращаемое значение:
//  УправляемаяФорма     - ссылка на открытую форму.
&НаКлиенте
Функция ОткрытьФормуДлительнойОперации(Знач ИдентификаторЗадания, ОписаниеПроцесса)
	
	ПараметрыФормыИндикации = Новый Структура;
	ПараметрыФормыИндикации.Вставить("ИдентификаторЗадания", ИдентификаторЗадания);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыФормыИндикации, ОписаниеПроцесса, Ложь);
	
	ФормаДлительнойОперации = ОткрытьФорму("Обработка.питПроведениеЧековОбщепита.Форма.ИндикацияХодаПроцесса", ПараметрыФормыИндикации, ЭтотОбъект);
	
	Возврат ФормаДлительнойОперации;
	
КонецФункции

//  Процедура - Обновить список документов на сервере.
//
&НаСервере
Процедура ОбновитьСписокДокументовНаСервере()
	
	ТаблицаДокументов = Объект.ТаблицаДокументов; 
	// Получим список непроведенных документов.
	ТаблицаРезультата = Обработки.питПроведениеЧековОбщепита.ПолучитьСписокДокументов(Объект.ДатаНачалаОтбора, Объект.ДатаКонцаОтбора, ТаблицаДокументов.Выгрузить(), Объект.Организация, Объект.Подразделение);
	
	// Очистим текующую таблицу.
	ТаблицаДокументовБезОтборов.Очистить();
	
	// Заполним исходную таблицу.
	Для Каждого ТекСтрока Из ТаблицаРезультата Цикл
		НоваяСтрока = ТаблицаДокументовБезОтборов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

//  Функция - Можно выполнять команды формы.
//
// Параметры:
//  ПроверятьКоличество - Произвольный - Проверять количество.
//  ПроверятьПериод - Произвольный - Проверять период.
//  ПроверятьКонстантуВозможностиПроведения - Произвольный - Проверять константу возможности проведения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция МожноВыполнятьКомандыФормы(ПроверятьКоличество = Ложь, ПроверятьПериод = Ложь, ПроверятьКонстантуВозможностиПроведения = Ложь)
	Если ПроверятьПериод Тогда
		Если НЕ (ЗначениеЗаполнено(Объект.ДатаКонцаОтбора)) Тогда
			
			ПоказатьПредупреждение(, НСтр("ru = 'Дата конца отбора не заполнена'"));
			Возврат Ложь;
			
		ИначеЕсли Объект.ДатаНачалаОтбора > Объект.ДатаКонцаОтбора Тогда
			
			ПоказатьПредупреждение(, НСтр("ru = 'Дата начала превышает конечную дату'"));
			Возврат Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверятьКонстантуВозможностиПроведения И НЕ ПолучитьЗначениеКонстантыВозможностиПроведения() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо включить константу <Выполнять проведение чеков Общепита>'"));
		Возврат Ложь;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Использовать", Истина);
	Если НЕ ПерепроводитьДокументы Тогда
		Отбор.Вставить("Проведен", Ложь);
	КонецЕсли;
	Если ПроверятьКоличество И (Объект.ТаблицаДокументов.НайтиСтроки(Отбор).Количество() = 0) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Нет выбранных или непроведенных документов'"));
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

//  Функция - Получить значение константы возможности проведения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ПолучитьЗначениеКонстантыВозможностиПроведения()
	Возврат Константы.питВыполнятьПроведениеЧековОбщепита.Получить();
КонецФункции


//  Функция - Запустить проведение чеков.
//
// Параметры:
//  ИдентификаторФинишнойОперации - Произвольный - Идентификатор финишной операции.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЗапуститьПроведениеЧеков(ИдентификаторФинишнойОперации)
	
	// Возможно, что фоновое задание было запущено раньше, 
	// пользователь дал команду его отменить, однако задание не отменено.
	// В таком случае не следует запускать задание повторно - следует дождаться его выполнения.
	// Мы можем отследить ситуацию только, если все это происходит в одной форме.
	// Потому что подсистема ДлительныеОперации не умеет устанавливать ключ фонового задания.
	Если ЗаданиеЕщеВыполняется(ИдентификаторЗадания) Тогда
		// Надо ждать
		Возврат Неопределено;
	КонецЕсли;
	
	
	Отбор = Новый Структура;
	Отбор.Вставить("Использовать", Истина);
	Если НЕ ПерепроводитьДокументы Тогда
		Отбор.Вставить("Проведен", Ложь);
	КонецЕсли;
	МассивВыбранныхЧеков= Объект.ТаблицаДокументов.Выгрузить(Отбор).ВыгрузитьКолонку("Ссылка");
	
	// Параметры обернем в структуру для их передачи 
	// через механизм ДлительныеОперации.
	ПараметрыФункции = Новый Структура();
	ПараметрыФункции.Вставить("МассивВыбранныхЧеков",               МассивВыбранныхЧеков);
	ПараметрыФункции.Вставить("СообщатьПрогрессВыполнения",         Истина);
	
	НаименованиеФоновогоЗадания = НСтр("ru = 'Проведение чеков общепита'");
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор, 
		"Обработки.питПроведениеЧековОбщепита.ПровестиЧекиОбщепита", 
		ПараметрыФункции, 
		НаименованиеФоновогоЗадания);
		
	АдресХранилища       = Результат.АдресХранилища;
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	
	Если Не Результат.ЗаданиеВыполнено Тогда
		// Надо ждать
		Возврат Неопределено;
	КонецЕсли;
	
	// Задание выполнено.
	// Результат выполнения возвращен через хранилище значения.
	
	// Загрузим результат в форму и передадим данные на клиент.
	Возврат ОбновитьДанныеОперацийПоРезультатуДлительнойОперации(Истина);
	
КонецФункции

//  Функция - Обновить данные операций по результату длительной операции.
//
// Параметры:
//  ВыводитьСообщенияПользователю - Произвольный - Выводить сообщения пользователю.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ОбновитьДанныеОперацийПоРезультатуДлительнойОперации(ВыводитьСообщенияПользователю)
	
	// Результат закрытия подготовлен в 
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Приведем результаты длительной операции к одинаковому формату
	ТекстПредупреждения = Неопределено;

	
	РезультатДляКлиента	= Новый Структура;
	
	Выполнено = Ложь;
	
	Если Результат.Свойство("Выполнено") Тогда
		
		Если Результат.Выполнено Тогда
			Выполнено = Истина;
		Иначе
			ТекстПредупреждения = НСтр("ru = 'Проведение всех документов не выполнено: выявлены ошибки'");
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат.Свойство("МассивОбработанныхДокументов") Тогда
		МассивОбработанныхДокументов = Результат.МассивОбработанныхДокументов;
	КонецЕсли;
	
	РезультатДляКлиента.Вставить("МассивОбработанныхДокументов", МассивОбработанныхДокументов);
	
	РезультатДляКлиента.Вставить("Выполнено", Выполнено);
	
	ОбновитьСписокДокументовНаСервере();
	
	Если ПолучитьСообщенияПользователю().Количество() = 0 И ЗначениеЗаполнено(ТекстПредупреждения) Тогда
		РезультатДляКлиента.Вставить("ПоказатьПредупреждение", ТекстПредупреждения);
	КонецЕсли;
	
	Возврат РезультатДляКлиента;
	
КонецФункции

//  Процедура - Проверить завершение длительной операции.
//
// Параметры:
//  ИмяОбработчикаОжидания - Произвольный - Имя обработчика ожидания.
//  ВыводитьСообщенияПользователю - Произвольный - Выводить сообщения пользователю.
//  ЗакрытьФормуДлительнойОперации - Произвольный - Закрыть форму длительной операции.
//
&НаКлиенте
Процедура ПроверитьЗавершениеДлительнойОперации(ИмяОбработчикаОжидания, ВыводитьСообщенияПользователю, ЗакрытьФормуДлительнойОперации)
	
	Попытка
		ЕстьПрогрессОперации = ВыполненШагДлительнойОперации(ФормаДлительнойОперации);
		
		Если ЕстьПрогрессОперации = Неопределено Тогда
			
			Результат = ОбновитьДанныеОперацийПоРезультатуДлительнойОперации(ВыводитьСообщенияПользователю);
			
			Если Результат.Свойство("ПоказатьПредупреждение") Тогда
				ПоказатьПредупреждение(, Результат.ПоказатьПредупреждение);
			КонецЕсли;
			
			Если Результат.Свойство("Выполнено") Тогда
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			КонецЕсли;
			
			Если Результат.Свойство("МассивОбработанныхДокументов") 
				И ВыводитьОтчетОСохраненныхДокументах 
				И ((Результат.МассивОбработанныхДокументов.Количество()) > 0) Тогда
				
				ПараметрыПечати = Новый Структура;
				ПараметрыПечати.Вставить("МассивОбработанныхДокументов", Результат.МассивОбработанныхДокументов);
				
				Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
					МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
					МодульУправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.питПроведениеЧековОбщепита", "СозданныеДокументы", 
					Результат.МассивОбработанныхДокументов, ЭтотОбъект, ПараметрыПечати);
				КонецЕсли;
			КонецЕсли;
			
			// Обновим список документов.
			ОбновитьСписокДокументов(Неопределено,Ложь,Ложь);
		Иначе
			
			Если ЕстьПрогрессОперации Тогда
				ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			КонецЕсли;
			
			ПодключитьОбработчикОжидания(
				ИмяОбработчикаОжидания,
				ПараметрыОбработчикаОжидания.ТекущийИнтервал,
				Истина);
		КонецЕсли;
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

//  Процедура - Установить снять флажки в таблице документов.
//
// Параметры:
//  Установить - Произвольный - Установить.
//
&НаКлиенте
Процедура УстановитьСнятьФлажкиВТаблицеДокументов(Установить = Истина)
	
	ТЧТаблицаДокументов = Объект.ТаблицаДокументов;
	Для Каждого ТекСтрока Из ТЧТаблицаДокументов Цикл
		Если НЕ ПерепроводитьДокументы И ТекСтрока.Проведен Тогда
			ТекСтрока.Использовать = Ложь;
		Иначе
			ТекСтрока.Использовать = Установить;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСтрока Из ТаблицаДокументовБезОтборов Цикл
		Если НЕ ПерепроводитьДокументы И ТекСтрока.Проведен Тогда
			ТекСтрока.Использовать = Ложь;
		Иначе
			ТекСтрока.Использовать = Установить;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

//  Процедура - Сохранить настройки.
//
&НаСервере
Процедура СохранитьНастройки()
	
	ХранилищеОбщихНастроек.Сохранить("ОбщепитПроведениеЧековОбщепита_Организация", , Объект.Организация);
	ХранилищеОбщихНастроек.Сохранить("ОбщепитПроведениеЧековОбщепита_Подразделение", , Объект.Подразделение);
	ХранилищеОбщихНастроек.Сохранить("ОбщепитПроведениеЧековОбщепита_ВыводитьОтчетОСохраненныхДокументах", , ВыводитьОтчетОСохраненныхДокументах);
	ХранилищеОбщихНастроек.Сохранить("ОбщепитПроведениеЧековОбщепита_ПерепроводитьДокументы", , ПерепроводитьДокументы);
	
КонецПроцедуры

//  Процедура - Восстановить настройки.
//
&НаСервере
Процедура ВосстановитьНастройки()
	
	// восстанавливаем настройки
	ОбщепитПроведениеЧековОбщепита_Организация = ХранилищеОбщихНастроек.Загрузить("ОбщепитПроведениеЧековОбщепита_Организация");
	Если ОбщепитПроведениеЧековОбщепита_Организация <> Неопределено Тогда
		Объект.Организация = ОбщепитПроведениеЧековОбщепита_Организация;
	КонецЕсли;
	
	ОбщепитПроведениеЧековОбщепита_Подразделение = ХранилищеОбщихНастроек.Загрузить("ОбщепитПроведениеЧековОбщепита_Подразделение");
	Если ОбщепитПроведениеЧековОбщепита_Подразделение <> Неопределено Тогда
		Объект.Подразделение = ОбщепитПроведениеЧековОбщепита_Подразделение;
	КонецЕсли;
	
	ОбщепитПроведениеЧековОбщепита_ВыводитьОтчетОСохраненныхДокументах = ХранилищеОбщихНастроек.Загрузить("ОбщепитПроведениеЧековОбщепита_ВыводитьОтчетОСохраненныхДокументах");
	Если ОбщепитПроведениеЧековОбщепита_ВыводитьОтчетОСохраненныхДокументах <> Неопределено Тогда
		ВыводитьОтчетОСохраненныхДокументах = ОбщепитПроведениеЧековОбщепита_ВыводитьОтчетОСохраненныхДокументах;
	КонецЕсли;
	
	ОбщепитПроведениеЧековОбщепита_ПерепроводитьДокументы = ХранилищеОбщихНастроек.Загрузить("ОбщепитПроведениеЧековОбщепита_ПерепроводитьДокументы");
	Если ОбщепитПроведениеЧековОбщепита_ПерепроводитьДокументы <> Неопределено Тогда
		ПерепроводитьДокументы = ОбщепитПроведениеЧековОбщепита_ПерепроводитьДокументы;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Инициализация.
//
&НаСервере
Процедура Инициализация()
	
	ВыводитьОтчетОСохраненныхДокументах = Истина;
	Объект.ДатаКонцаОтбора = КонецДня(ТекущаяДата());
	Объект.Организация = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	Элементы.ТаблицаДокументовТолькоНепроведенные.Пометка = Истина;
	
КонецПроцедуры

#КонецОбласти


