#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс


//  Процедура - Провести чеки общепита.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//  АдресХранилища - Произвольный - Адрес хранилища.
//
Процедура ПровестиЧекиОбщепита(Параметры, АдресХранилища) Экспорт
	
	// Параметры и результат обернуты в структуру для их передачи через механизм ДлительныеОперации.
	// Состав параметров:
	// - Период
	// - Организация
	// - СтатусЗакрытияМесяца
	// - ФинишнаяОперация
	// - ТолькоОперацииОбособленногоПодразделения
	// - ПропуститьПроверкуСтатусаПредыдущих
	// Состав результата:
	// - Выполнено
	// - Операции
	
	Если Параметры.Свойство("СообщатьПрогрессВыполнения") Тогда
		СообщатьПрогрессВыполнения = Параметры.СообщатьПрогрессВыполнения;
	Иначе
		СообщатьПрогрессВыполнения = Истина;
	КонецЕсли;
	
	Результат = ВыполнитьПроведениеЧеков(Параметры.МассивВыбранныхЧеков,СообщатьПрогрессВыполнения);
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	
КонецПроцедуры

// Функция - Получить список документов
//
// Параметры:
//  НачалоПериода - Дата - Начало период.
//  КонецПериода - Дата - Конец период.
//  ТаблицаДокументов - ТаблицаЗначений - Таблица документов.
//  Организация - Ссылка - Организаци.
//  Подразделение - Ссылка - Подразделение.
//
// Возвращаемое значение:
//  ТаблицаЗначений - список документов.
Функция ПолучитьСписокДокументов(НачалоПериода, КонецПериода, ТаблицаДокументов = Неопределено, Организация = Неопределено, Подразделение = Неопределено) Экспорт
	// Подготовим параметры.
	ТекстОтборов = "";
	Запрос = Новый Запрос;
	
	Если ТаблицаДокументов = Неопределено Тогда
		// Сформируем временную таблицу для результатов.
		ТаблицаДокументов = Новый ТаблицаЗначений;
		ТаблицаДокументов.Колонки.Добавить("Ссылка");
		ТаблицаДокументов.Колонки.Добавить("Представление");
		ТаблицаДокументов.Колонки.Добавить("Использовать");
		ТаблицаДокументов.Колонки.Добавить("ВидОперации");
		ТаблицаДокументов.Колонки.Добавить("Проведен");
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ТаблицаДокументов.Ссылка КАК Ссылка,
	|	ТаблицаДокументов.Использовать КАК Использовать
	|ПОМЕСТИТЬ ВТ_ТаблицаДокументов
	|ИЗ
	|	&ТаблицаДокументов КАК ТаблицаДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбщепитДанныеПродажФронта.Ссылка КАК Ссылка,
	|	ОбщепитДанныеПродажФронта.Представление КАК Представление,
	|	ВЫБОР
	|		КОГДА ОбщепитДанныеПродажФронта.Проведен
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ТаблицаДокументов.Использовать, ИСТИНА)
	|	КОНЕЦ КАК Использовать,
	|	ОбщепитДанныеПродажФронта.Проведен КАК Проведен,
	|	ОбщепитДанныеПродажФронта.ВидОперации КАК ВидОперации
	|ИЗ
	|	Документ.питДанныеПродажФронта КАК ОбщепитДанныеПродажФронта
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаДокументов КАК ВТ_ТаблицаДокументов
	|		ПО ОбщепитДанныеПродажФронта.Ссылка = ВТ_ТаблицаДокументов.Ссылка
	|ГДЕ
	|	ОбщепитДанныеПродажФронта.Дата >= &НачалоПериода
	|	И ОбщепитДанныеПродажФронта.Дата <= &КонецПериода
	|	И НЕ ОбщепитДанныеПродажФронта.ПометкаУдаления
	|	%Отборы%
	|
	|УПОРЯДОЧИТЬ ПО
	|	Проведен,
	|	ОбщепитДанныеПродажФронта.Дата УБЫВ
	|	";
	
	// Сформируем отборы.
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстОтборов = ТекстОтборов + "И ОбщепитДанныеПродажФронта.Организация = &Организация
		|";
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ТекстОтборов = ТекстОтборов + "И ОбщепитДанныеПродажФронта.Подразделение = &Подразделение
		|";
		Запрос.УстановитьПараметр("Подразделение", Подразделение);
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%Отборы%", ТекстОтборов);
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ТаблицаДокументов", ТаблицаДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаДокументов.Очистить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаДокументов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
	КонецЕсли;
	Возврат ТаблицаДокументов;
КонецФункции

// Формирует печатные формы
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать.
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//   (выходные.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документ.
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//   представление - имя области в которой был выведен объект.
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
		МодульУправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"СозданныеДокументы", НСтр("ru = 'Чеки общепита'"),
		ПечатьРезультатРаботы(МассивОбъектов, ПараметрыПечати),
		,
		"Обработка.ОбщепитЗагрузкаRKeeper7.СозданныеДокументы");
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Печать результат работы.
//
// Параметры:
//  МассивСохраненныхДокументов - Массив - Массив сохраненных документов.
//  СтруктураОбработанныхДокументов - Структура - Структура обработанных документов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПечатьРезультатРаботы(МассивСохраненныхДокументов, СтруктураОбработанныхДокументов) Экспорт
	
	
	ТабДокумент	= Новый ТабличныйДокумент;
	ТабДокумент.Очистить();
	Макет = Обработки.питПроведениеЧековОбщепита.ПолучитьМакет("СозданныеДокументы");
	
	// Получим области
	ОбластьШапка=Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока=Макет.ПолучитьОбласть("Строка");
	
	// Шапка
	ТабДокумент.Вывести(ОбластьШапка);
	// Список документов сохраненных
	Для Каждого ЦелевойДокумент Из МассивСохраненныхДокументов Цикл
		ОбластьСтрока.Параметры.ЦелевойДокумент = ЦелевойДокумент;
		ОбластьСтрока.Параметры.СостояниеВБазе = ?(ЦелевойДокумент.Проведен, "Проведен", "Не проведен");
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	
	// Зададим параметры макета
	ТабДокумент.ПолеСверху          = 0;
	ТабДокумент.ПолеСлева           = 9;
	ТабДокумент.ПолеСправа          = 6;
	ТабДокумент.ПолеСнизу           = 0;
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДокумент.ОтображатьЗаголовки	= Ложь;
	ТабДокумент.ОтображатьСетку     = Ложь;
	ТабДокумент.Защита              = Истина;
	ТабДокумент.ТолькоПросмотр      = Истина;
	
	Возврат ТабДокумент;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


//  Функция - Выполнить проведение чеков.
//
// Параметры:
//  МассивВыбранныхЧеков - Массив - Массив выбранных чеков.
//  СообщатьПрогрессВыполнения - Произвольный - Сообщать прогресс выполнения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ВыполнитьПроведениеЧеков(МассивВыбранныхЧеков, СообщатьПрогрессВыполнения = Истина)
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("МассивВыбранныхЧеков",  МассивВыбранныхЧеков);
	
	// Найдем диапазон операций, которые следует выполнить
	ИндексФинишногоЧека  = МассивВыбранныхЧеков.Количество();
	
	// Инициализируем параметры для отмены ненужных рег.операций.
	// ПараметрыОтменыРегОпераций = Документы.РегламентнаяОперация.НовыеПараметрыОтменыОперации();
	
	// Подсчитываем, сколько операций предстоит выполнить.
	Если СообщатьПрогрессВыполнения Тогда
		
		ПараметрыСообщенийПрогресса = питПроведениеЧековКлиентСервер.НовыеПараметрыСообщенийПрогресса();
		ПараметрыСообщенийПрогресса.НачальноеЗначение   = 0;
		ПараметрыСообщенийПрогресса.КонечноеЗначение    = ИндексФинишногоЧека;
		ПараметрыСообщенийПрогресса.ДостигнутоеЗначение = 0;
		
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого Документ Из МассивВыбранныхЧеков Цикл
			
			ДокументОбъект = Документ.ПолучитьОбъект();
			ДокументОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
			ДокументОбъект.ДополнительныеСвойства.Вставить("АвтоПроведение", Истина);
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЦикла;
		
		ЗафиксироватьИзмененияДокументов(МассивВыбранныхЧеков);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Результат.Вставить("Отказ",     Истина);
		Результат.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = "ЧекиОбщепита";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Результат.Вставить("МассивОбработанныхДокументов", МассивВыбранныхЧеков);
	
	Если СообщатьПрогрессВыполнения Тогда
		ПараметрыСообщенийПрогресса.ДостигнутоеЗначение = ИндексФинишногоЧека;
		ДлительныеОперации.СообщитьПрогресс(100, "Проведение выполнено", ПараметрыСообщенийПрогресса);
	КонецЕсли;
	
	Результат.Вставить("Выполнено", Истина);
	
	Возврат Результат;
	
КонецФункции

//  Процедура - Зафиксировать изменения документов.
//
// Параметры:
//  МассивЧеков - Массив - Массив чеков.
//
Процедура ЗафиксироватьИзмененияДокументов(МассивЧеков)
	
	ТаблицаЧеков = Новый ТаблицаЗначений;
	ТаблицаЧеков.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.питДанныеПродажФронта"));
	Для Каждого ТекЧек Из МассивЧеков Цикл
		НоваяСтрока = ТаблицаЧеков.Добавить();
		НоваяСтрока.Документ = ТекЧек;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЧеков.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	&ТаблицаЧеков КАК ТаблицаЧеков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиПоЧекам.Документ КАК Документ
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.питПродажиПоЧекам КАК ПродажиПоЧекам
	|		ПО ВТ_Документы.Документ = ПродажиПоЧекам.Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиПоЧекам.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиМодификаторовПоЧекам.Документ КАК Документ
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.питПродажиМодификаторовПоЧекам КАК ПродажиМодификаторовПоЧекам
	|		ПО ВТ_Документы.Документ = ПродажиМодификаторовПоЧекам.Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиМодификаторовПоЧекам.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОплатыПоЧекам.Документ КАК Документ
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.питОплатыПоЧекам КАК ОплатыПоЧекам
	|		ПО ВТ_Документы.Документ = ОплатыПоЧекам.Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	ОплатыПоЧекам.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПродажФронта.Дата КАК Дата,
	|	ВТ_Документы.Документ КАК Документ,
	|	ДанныеПродажФронта.Организация КАК Организация,
	|	ДанныеПродажФронта.Подразделение КАК Подразделение,
	|	ДанныеПродажФронта.КассаККМ КАК КассаККМ,
	|	ДанныеПродажФронта.НомерСмены КАК НомерСмены,
	|	ДанныеПродажФронта.ВидОперации КАК ВидОперации,
	|	ДанныеПродажФронта.Ответственный КАК Ответственный,
	|	ДанныеПродажФронта.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ПОМЕСТИТЬ ВТ_РеквизитыШапки
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.питДанныеПродажФронта КАК ДанныеПродажФронта
	|		ПО ВТ_Документы.Документ = ДанныеПродажФронта.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РеквизитыШапки.Дата КАК Дата,
	|	ВТ_РеквизитыШапки.Документ КАК Документ,
	|	ВТ_РеквизитыШапки.Организация КАК Организация,
	|	ВТ_РеквизитыШапки.Подразделение КАК Подразделение,
	|	ВТ_РеквизитыШапки.КассаККМ КАК КассаККМ,
	|	ВТ_РеквизитыШапки.НомерСмены КАК НомерСмены,
	|	ВТ_РеквизитыШапки.ВидОперации КАК ВидОперации,
	|	ВТ_РеквизитыШапки.Ответственный КАК Кассир,
	|	ТЧТовары.ПричинаОтмены КАК ПричинаОтмены,
	|	ТЧТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ТЧТовары.Количество) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_РеквизитыШапки.СуммаВключаетНДС
	|				ТОГДА ТЧТовары.Сумма
	|			ИНАЧЕ ТЧТовары.Сумма + ТЧТовары.СуммаНДС
	|		КОНЕЦ) КАК Сумма,
	|	СУММА(ТЧТовары.СуммаНДС) КАК СуммаНДС,
	|	СУММА(ТЧТовары.СуммаСкидкиСтроки + ТЧТовары.СуммаСкидки) КАК СуммаСкидки
	|ИЗ
	|	ВТ_РеквизитыШапки КАК ВТ_РеквизитыШапки
