Функция КартинкаИнформация()

	Возврат 2;	

КонецФункции

Функция КартинкаГотово()

	Возврат 0;	

КонецФункции

Функция КартинкаТребуетсяВнимание()

	Возврат 1;

КонецФункции

Функция КартинкаНеИспользуется()

	Возврат 3;	

