Функция ШагУчетТМЦВЭксплуатацииДатаПоследнегоДокумента()
	
	Дата = Дата(1, 1, 1); 
	
	Запрос = Новый Запрос(ШагУчетТМЦВЭксплуатацииТекстЗапросаДатаПоследнегоДокумента());
	Запрос.УстановитьПараметр("НачалоУчета", РеглУчетКлиентСервер.НачалоПримененияФСБУ5_2019());

	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПеремещениеВЭксплуатации.ПолноеИмя()));
	Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.СписаниеИзЭксплуатации.ПолноеИмя()));
	Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ОприходованиеТМЦВЭксплуатации.ПолноеИмя()));
	Запрос.УстановитьПараметр("ДокументыТМЦ", Идентификаторы);
	
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ВнутреннееПотребление.ПолноеИмя()));
	Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПрочееОприходованиеТоваров.ПолноеИмя()));
	Запрос.УстановитьПараметр("ДокументыОбщие", Идентификаторы);

	ХозяйственныеОперации = Новый Массив;
	ХозяйственныеОперации.Добавить(Перечисления.ХозяйственныеОперации.ПередачаВЭксплуатацию);
	ХозяйственныеОперации.Добавить(Перечисления.ХозяйственныеОперации.ВозвратИзЭксплуатации);
	Запрос.УстановитьПараметр("ХозяйственныеОперации", ХозяйственныеОперации);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Дата = Выборка.ДатаДокумента;
	КонецЕсли;
	
	Возврат Дата;

КонецФункции

Функция ШагУчетТМЦВЭксплуатацииТекстЗапросаДатаПоследнегоДокумента()

	Возврат 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(РеестрДокументов.ДатаДокумента), ДАТАВРЕМЯ(1,1,1)) КАК ДатаДокумента
	|
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(РеестрДокументов.ДатаДокументаИБ) КАК ДатаДокумента
	|	ИЗ
	|		РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|	ГДЕ
	|		РеестрДокументов.Проведен
	|		И РеестрДокументов.ТипСсылки В (&ДокументыТМЦ)
	|		И РеестрДокументов.ДатаДокументаИБ < &НачалоУчета
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		МАКСИМУМ(РеестрДокументов.ДатаДокументаИБ) КАК ДатаДокумента
	|	ИЗ
	|		РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|	ГДЕ
	|		РеестрДокументов.Проведен
	|		И РеестрДокументов.ТипСсылки В (&ДокументыОбщие)
	|		И РеестрДокументов.ХозяйственнаяОперация В (&ХозяйственныеОперации)
	|		И РеестрДокументов.ДатаДокументаИБ < &НачалоУчета
	|
	|	) КАК РеестрДокументов
	|";

КонецФункции

