Функция ШагУчетТМЦВЭксплуатацииМожноПереходить()
	
	МожноПереходить = Истина;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.НастройкаПереходаНаФСБУ5 КАК НастройкаПерехода
	|ГДЕ
	|	НастройкаПерехода.ГодСписанияСтоимости > &ТекущийГод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ЗаданияКПогашениюСтоимостиТМЦВЭксплуатации КАК Задания
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаПереходаНаФСБУ5 КАК НастройкаПерехода
	|		ПО НастройкаПерехода.Организация = Задания.Организация
	|ГДЕ
	|	ГОД(Задания.Месяц) <= ЕСТЬNULL(НастройкаПерехода.ГодСписанияСтоимости, &ГодСписанияСтоимости)
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТекущийГод", Год(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ГодСписанияСтоимости", Год(РеглУчетКлиентСервер.НачалоПримененияФСБУ5_2019()-1));

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		МожноПереходить = Ложь;
	КонецЕсли;
	
	Возврат МожноПереходить;

КонецФункции

