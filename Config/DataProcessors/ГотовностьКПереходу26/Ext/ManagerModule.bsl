	Строка = Таблица.Добавить();
	Строка.Идентификатор = ШагПереработкаНаСторонеИдентификатор();
	Строка.УстаревшаяФункциональность = НСтр("ru = 'Производство (переработка) на стороне версия 2.4'");
	Строка.НоваяФункциональность = НСтр("ru = 'Производство (переработка) на стороне версия 2.5'");
	Строка.РекомендацияТребующаяДействий = Истина;
	Строка.РежимДействия = РежимДействияПереходВСписокДокументов();
	
	Строка.ТребуетсяРассчитатьСостояние = НЕ РассчитыватьСостояние;
	Если РассчитыватьСостояние Тогда
	
		Строка.ИспользуетсяУстаревшаяФункциональность = ШагПереработкаНаСторонеИспользуетсяУстаревшаяФункциональность();
		Строка.ИспользуетсяНоваяФункциональность = ШагПереработкаНаСторонеИспользуетсяНоваяФункциональность();
		Строка.ДатаДокумента = ШагПереработкаНаСторонеДатаПоследнегоДокумента();
		Строка.ЕстьДанныеПоУстаревшейФункциональности = ЗначениеЗаполнено(Строка.ДатаДокумента);
	
	КонецЕсли;
	
	Строка.Рекомендация = НСтр("ru = 'Для перехода на функциональность ""Производство (переработка) на стороне версия 2.5"" необходимо выполнить следующие шаги:
		|1. Включить функциональность Производство на стороне (версия 2.5), не отключая 2.4. Начиная с этого шага новые заказы переработчикам можно будет делать только версии 2.5. Ранее созданные заказы переработчикам версии 2.4 продолжат нормально функционировать, что позволит их завершить в плановом порядке.
		|2. Актуальные договоры с целью ""Передача в переработку (2.4)"" продублировать в новые с целью ""Передача в переработку"".
		|3. Завершить выполнение заказов переработчиками 2.4.
		|4. По всем оставшимся у переработчиков материалам, которые должны оставаться у переработчика для дальнейшей обработки новыми заказами, оформить возвраты сырья от переработчиков версии 2.4 и последующую передачу сырья переработчикам уже в функциональности версии 2.5.
		|5. Отключить функциональность ""Производство на стороне (версия 2.4)"".'");
	
	ЗаполнитьДанныеВСтроке(Строка);

