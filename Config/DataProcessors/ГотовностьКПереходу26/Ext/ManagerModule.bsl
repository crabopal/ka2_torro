Функция ШагУчетВнеоборотныхАктивовДатаПоследнегоДокумента()
	
	Дата = Дата(1, 1, 1);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВнеоборотныеАктивы2_2") Тогда
	
		Запрос = Новый Запрос(ШагУчетВнеоборотныхАктивовТекстЗапросаДатаПоследнегоДокумента());
		Запрос.УстановитьПараметр("НачалоУчета", Константы.ДатаНачалаУчетаВнеоборотныхАктивов2_4.Получить());

		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ВводОстатковВнеоборотныхАктивов.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ИзменениеПараметровНМА.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ИзменениеПараметровОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ИзменениеСостоянияОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.МодернизацияОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПередачаОСВАренду.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПеремещениеОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПереоценкаНМА.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПереоценкаОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПодготовкаКПередачеНМА.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПодготовкаКПередачеОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПоступлениеАрендованныхОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПринятиеКУчетуНМА.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПринятиеКУчетуОС.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.СписаниеНМА.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.СписаниеОС.ПолноеИмя()));
		Запрос.УстановитьПараметр("Документы22", Идентификаторы);
		
		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ВозвратОСИзАренды.ПолноеИмя()));
		Идентификаторы.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ВыбытиеАрендованныхОС.ПолноеИмя()));
		Запрос.УстановитьПараметр("ДокументыОбщие", Идентификаторы);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Дата = Выборка.ДатаДокумента;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Дата;

КонецФункции

Функция ШагУчетВнеоборотныхАктивовТекстЗапросаДатаПоследнегоДокумента()

	Возврат 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(РеестрДокументов.ДатаДокумента), ДАТАВРЕМЯ(1,1,1)) КАК ДатаДокумента
	|
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(РеестрДокументов.ДатаДокументаИБ) КАК ДатаДокумента
	|	ИЗ
	|		РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|	ГДЕ
	|		РеестрДокументов.Проведен
	|		И РеестрДокументов.ТипСсылки В (&Документы22)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		МАКСИМУМ(РеестрДокументов.ДатаДокументаИБ) КАК ДатаДокумента
	|	ИЗ
	|		РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|	ГДЕ
	|		РеестрДокументов.Проведен
	|		И РеестрДокументов.ТипСсылки В (&ДокументыОбщие)
	|		И (РеестрДокументов.ДатаДокументаИБ < &НачалоУчета
	|			ИЛИ &НачалоУчета = ДАТАВРЕМЯ(1,1,1))
	|
	|	) КАК РеестрДокументов
	|";

