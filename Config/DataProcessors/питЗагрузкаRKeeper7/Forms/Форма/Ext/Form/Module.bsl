	ДопПараметры = ПодготовитьДопПараметры(ЭтаФорма);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питТипыОплат));
	Если СтрокиНастроек.Количество() > 0 Тогда
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаТиповОплат, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питТипыОплат, ДопПараметры, СтрокиНастроек[0]);
