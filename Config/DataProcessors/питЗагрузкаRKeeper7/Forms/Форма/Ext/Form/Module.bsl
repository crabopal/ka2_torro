

#Область ПрограммныйИнтерфейс

//  Процедура - Выбор команды подключения.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВыборКомандыПодключения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Значение = "Открыть" Тогда
		ОткрытьФорму("Справочник.питУчетныеЗаписиRKeeper.ФормаОбъекта", Новый Структура("Ключ",Объект.УчетнаяЗапись),ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ПриИзмененииУчетнойЗаписи", ЭтотОбъект));	
	ИначеЕсли Результат.Значение = "Выбрать" Тогда
		ОткрытьФорму("Справочник.питУчетныеЗаписиRKeeper.ФормаВыбора", Новый Структура("РежимВыбора", Истина),ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ПриВыбореУчетнойЗаписи", ЭтотОбъект));	
	КонецЕсли;
КонецПроцедуры

//  Процедура - При изменении учетной записи.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПриИзмененииУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	ПриИзмененииУчетнойЗаписиНаСервере();
КонецПроцедуры

//  Процедура - Обработчик после создания учетной записи.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработчикПослеСозданияУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	Объект.УчетнаяЗапись = ПолучитьНовуюУчетнуюЗапись();
	
	// Объект.УчетнаяЗапись = Результат;
	ПриИзмененииУчетнойЗаписиНаСервере();
КонецПроцедуры

//  Процедура - При выборе учетной записи.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПриВыбореУчетнойЗаписи(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.УчетнаяЗапись = Результат;
	ПриВыбореУчетнойЗаписиНаСервере();
КонецПроцедуры

//  Процедура - При выборе учетной записи на сервере.
//
Процедура ПриВыбореУчетнойЗаписиНаСервере() Экспорт
	
	// Отбор по учетной записи
	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Объект.ТипСоответствий = Объект.УчетнаяЗапись.ТипСоответствий;
	КонецЕсли;
	
	Обработки.питЗагрузкаRKeeper7.ОтключитьсяОтВнешнегоИсточникаДанных();
	Обработки.питЗагрузкаRKeeper7.ПодключитьсяКВнешнемуИсточникуДанных(Объект.УчетнаяЗапись);
	
	ИндикацияПараметровПодключения(Объект.УчетнаяЗапись);
	
	УстановитьОтборыСоответствий();
КонецПроцедуры

//  Функция - Получить результат по продажам.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьРезультатПоПродажам() Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаВсего,
	               |	Продажи.СуммаСкидки,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.НДС,
	               |	Продажи.СуммаНДС,
	               |	Продажи.ТипОплатыУид,
	               |	Продажи.КассаУИД,
	               |	Продажи.НомерСмены,
	               |	Продажи.ДатаСмены,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.РесторанУИД,
	               |	ВЫБОР
	               |		КОГДА Продажи.ХозОперация = 6
	               |			ТОГДА ""Продажа""
	               |		КОГДА Продажи.ХозОперация = 7
	               |				И &ВидЗагрузкиУдалений = 0
	               |			ТОГДА ""Отмена""
	               |		КОГДА Продажи.ХозОперация = 7
	               |				И &ВидЗагрузкиУдалений = 1
	               |			ТОГДА ""Возврат""
	               |		ИНАЧЕ ""Неопределено""
	               |	КОНЕЦ КАК ХозОперация,
	               |	Продажи.ДатаОтмены,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.НастройкиПричинОтменСписаний,
	               |	Продажи.ЧекНомер,
	               |	Продажи.ЧекДата,
	               |	Продажи.ЧекУИД,
				   |	Продажи.ЭтоКомбоБлюдо,
	               |	Продажи.УдалениеУИД
	               |ПОМЕСТИТЬ Продажи
	               |ИЗ
	               |	&Продажи КАК Продажи
	               |ГДЕ
	               |	Продажи.Пометка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
				   |
	               |ВЫБРАТЬ
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаВсего,
	               |	Продажи.СуммаСкидки,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.НДС,
	               |	Продажи.СуммаНДС,
	               |	Продажи.ТипОплатыУид,
	               |	Продажи.КассаУИД КАК КассаУИД,
	               |	Продажи.НомерСмены КАК НомерСмены,
	               |	Продажи.ДатаСмены КАК ДатаСмены,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.РесторанУИД КАК РесторанУИД,
	               |	Продажи.ХозОперация КАК ХозОперация,
	               |	Продажи.ДатаОтмены,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.НастройкиПричинОтменСписаний,
	               |	Продажи.ЧекНомер,
	               |	Продажи.ЧекДата КАК ЧекДата,
	               |	Продажи.ЧекУИД КАК ЧекУИД,
				   |	Продажи.ЭтоКомбоБлюдо,
	               |	Продажи.УдалениеУИД КАК УдалениеУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВЫБОР
	               |		КОГДА Продажи.ЧекДата <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Продажи.ЧекДата <> NULL
	               |				И Продажи.ЧекДата <> НЕОПРЕДЕЛЕНО
	               |			ТОГДА Продажи.ЧекДата
	               |		КОГДА Продажи.ХозОперация <> 6
	               |				И Продажи.ДатаСмены <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Продажи.ДатаСмены <> NULL
	               |				И Продажи.ДатаСмены <> НЕОПРЕДЕЛЕНО
	               |			ТОГДА Продажи.ДатаСмены
	               |		ИНАЧЕ &ТекущаяДата
	               |	КОНЕЦ
	               |ИТОГИ ПО
	               |	ЧекУИД,
	               |	УдалениеУИД,
	               |	РесторанУИД,
	               |	ХозОперация,
	               |	КассаУИД,
	               |	ЧекДата,
	               |	ДатаСмены,
	               |	НомерСмены";
	Запрос.УстановитьПараметр("Продажи", Объект.Продажи.Выгрузить());
	Запрос.УстановитьПараметр("ВидЗагрузкиУдалений", Объект.ВидЗагрузкиУдалений);
	Результат = Запрос.Выполнить();
	
	Возврат Результат;
	
КонецФункции

//  Процедура - Параметры загрузки служебный каталог начало выбора завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	текСтрока = ДополнительныеПараметры.текСтрока;
	Если Результат <> Неопределено Тогда
		текДанные = Объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
		текДанные.СлужебныйКаталог = Результат;
	КонецЕсли;

КонецПроцедуры

//  Процедура - Отбор касс ккм по подразделеним на сервере.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДопПараметры - Произвольный - Доп параметры.
//
&НаСервере
Процедура ОтборКассККМПоПодразделенимНаСервере(Результат, ДопПараметры) Экспорт
	
	// Отбор по учетной записи
	УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
	Если Объект.ТипСоответствий = 1 Тогда
		УчетнаяЗаписьОтбор = Объект.УчетнаяЗапись;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СоответствияОбъектовRKeeper.СсылкаRKeeper
	|ИЗ
	|	РегистрСведений.питСоответствияОбъектовRKeeper КАК СоответствияОбъектовRKeeper
	|ГДЕ
	|	СоответствияОбъектовRKeeper.УчетнаяЗапись = &УчетнаяЗаписьОтбор
	|	И СоответствияОбъектовRKeeper.ТипОбъекта = &ТипОбъекта
	|	И СоответствияОбъектовRKeeper.Ссылка1С.Подразделение В ИЕРАРХИИ(&Подразделения) ";

	// Отбор по учетной записи
	Запрос.УстановитьПараметр("УчетнаяЗаписьОтбор", УчетнаяЗаписьОтбор);
	
	Запрос.УстановитьПараметр("ТипОбъекта", ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ);
	Запрос.УстановитьПараметр("Подразделения", Результат);
	ВыбранныеКассы.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СсылкаRKeeper"));
	
	СоответствияКассыККМ.Параметры.УстановитьЗначениеПараметра("ВыбранныеКассы", ВыбранныеКассы.ВыгрузитьЗначения());
	Элементы.СоответствияКассыККМ.Обновить();
КонецПроцедуры

//  Процедура - Изменить расписание завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ИзменитьРасписаниеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("РасписаниеРегламентногоЗадания") Тогда
		
		ТекстОшибки = "";
		ВсеОк = УстановитьНовоеРасписаниеОбменаСКипером(Результат, ТекстОшибки);
		Если ВсеОк Тогда
			//
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// Отбор по учетной записи
	Объект.ТипСоответствий = 0;
	
	Запрос = НОвый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	питУчетныеЗаписиRKeeper.ТипСоответствий,
	|	питУчетныеЗаписиRKeeper.Сервер,
	|	питУчетныеЗаписиRKeeper.База,
	|	питУчетныеЗаписиRKeeper.НачалоУчета,
	|	питУчетныеЗаписиRKeeper.Ссылка
	|ИЗ
	|	Справочник.питУчетныеЗаписиRKeeper КАК питУчетныеЗаписиRKeeper
	|ГДЕ
	|	НЕ питУчетныеЗаписиRKeeper.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СерверRK = Выборка.Сервер;
		БазаRK = Выборка.База;
		Объект.ТипСоответствий = Выборка.ТипСоответствий;
		// Отбор по учетной записи
		Объект.УчетнаяЗапись = Выборка.Ссылка;
	КонецЕсли;
	
	Если (ЗначениеЗаполнено(СерверRK) И ЗначениеЗаполнено(БазаRK)) Тогда
		Обработки.питЗагрузкаRKeeper7.ПодключитьсяКВнешнемуИсточникуДанных(Объект.УчетнаяЗапись);
	КонецЕсли;
	
	
	// отборы
	УстановитьОтборыСоответствий();
	Обработки.питЗагрузкаRKeeper7.ИнициализацияПараметровЗагрузки(Объект.ПараметрыЗагрузки);
	ПараметрыЗагрузкиИзменены = Ложь;
	
	// инициализация
	Инициализация();
	ВосстановитьНастройкиФормы();
	
	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) ИЛИ (ЗначениеЗаполнено(СерверRK) И ЗначениеЗаполнено(БазаRK)) Тогда
		Обработки.питЗагрузкаRKeeper7.ПодключитьсяКВнешнемуИсточникуДанных(Объект.УчетнаяЗапись);
	КонецЕсли;
	
	ИндикацияПараметровПодключения(Объект.УчетнаяЗапись);
	
// 
// КоманднаяПанельПродажиИзменениеВидимостиКолонокПродаж(ЭлементыФормы.КоманднаяПанельПродажи.Кнопки.ВидимостьКолонок.Кнопки.ОтображатьТолькоНазванияRKeeper);.
// 
// КоманднаяПанельСоответствияВидовОплатИзменениеВидимостиСвязей(ЭлементыФормы.КоманднаяПанельСоответствияВидовОплат.Кнопки.ВыделениеТиповОплат.Кнопки.ПоказыватьСвязьВRKeeper);.
	
	// По умолчанию покажем только незаполненные
	Элементы.ПоказатьТолькоЗаполненныеКассыККМ.Пометка = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияКассыККМ.Отбор,"Ссылка1С",Справочники.КассыККМ.ПустаяСсылка(),ВидСравненияКомпоновкиДанных.НеРавно,,Элементы.ПоказатьТолькоЗаполненныеКассыККМ.Пометка,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	// ЭлементыФормы.КоманднаяПанельСоответствияНоменклатуры.Кнопки.ПоказатьТолькоНезаполненные.Пометка = Истина;
	// ЭлементыФормы.КоманднаяПанельСоответствияМодификаторов.Кнопки.ПоказатьТолькоНезаполненные.Пометка = Истина;
//   УстановитьОтборЗаполненияСсылки1С(СоответствияНоменклатура.Отбор,
// ЭлементыФормы.КоманднаяПанельСоответствияНоменклатуры.Кнопки.ПоказатьТолькоНезаполненные.Пометка,
// Справочники.Номенклатура.ПустаяСсылка());.
//   УстановитьОтборЗаполненияСсылки1С(СоответствияМодификаторы.Отбор,
// ЭлементыФормы.КоманднаяПанельСоответствияМодификаторов.Кнопки.ПоказатьТолькоНезаполненные.Пометка,
// Справочники.Модификаторы.ПустаяСсылка());.
	// по умолчанию установим отбор по всем кассам
// 
// КоманднаяПанельСоответствияКассУстановитьВсеОтборы(ЭлементыФормы.КоманднаяПанельСоответствияКасс.Кнопки.УстановитьОтбор.Кнопки.УстановитьВсеОтборы);.
	
	// Видимость колонок
	// УправлениеВидимостью();
	
	СоответствияКассыККМ.Параметры.УстановитьЗначениеПараметра("ВыбранныеКассы", ВыбранныеКассы.ВыгрузитьЗначения());
	УстановитьУсловноеОформлениеТиповВидовОплат();
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) И Элементы.Подключение.Заголовок = "Подключение не настроено" Или Элементы.Подключение.Заголовок = "Подключение не установлено" Или Элементы.Подключение.Заголовок = "Подключение: ...." Тогда
		ПараметрыФормы = Новый Структура("Ключ", Объект.УчетнаяЗапись);
		ОткрытьФорму("Справочник.питУчетныеЗаписиRKeeper.ФормаОбъекта",ПараметрыФормы,ЭтотОбъект,,,, Новый ОписаниеОповещения("ОбработчикПослеСозданияУчетнойЗаписи", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
КонецПроцедуры

