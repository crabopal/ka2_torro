//  Функция - Выполнить загрузку из данных продаж.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ВыполнитьЗагрузкуИзДанныхПродаж(МассивОбъектов)
	// отбор по дате
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаНачала", Объект.ДатаНачала);
	СтруктураПараметров.Вставить("ДатаКонца", Объект.ДатаКонца);
	СтруктураПараметров.Вставить("ВыводитьОтчет", Объект.ВыводитьОтчет);
	
	// по соответствиям найдем кассы ккм
	СтрокиКассККМ = Объект.ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных","КассыККМ"));
	ТаблицаКассККМ = Объект.ТаблицаСоответствияИмяУИД.Выгрузить(СтрокиКассККМ,"Ссылка1С");
	ТаблицаКассККМ.Свернуть("Ссылка1С");
	МассивКассыККМ = Новый СписокЗначений;
	Для Каждого СтрокаКасс Из ТаблицаКассККМ Цикл
		Если ЗначениеЗаполнено(СтрокаКасс.Ссылка1С) Тогда
			МассивКассыККМ.Добавить(СтрокаКасс.Ссылка1С);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Обработки.питЗагрузкаRKeeper7.ВыполнитьЗагрузкуИзДанныхПродаж(МассивКассыККМ,МассивОбъектов,СтруктураПараметров);
КонецФункции

