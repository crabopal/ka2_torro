	питЗагрузкаRKeeper7_ЗагружатьСПустымиЦенами = ХранилищеОбщихНастроек.Загрузить("питЗагрузкаRKeeper7_ЗагружатьСПустымиЦенами");
	Если питЗагрузкаRKeeper7_ЗагружатьСПустымиЦенами <> Неопределено Тогда
		Объект.ЗагружатьСПустымиЦенами = питЗагрузкаRKeeper7_ЗагружатьСПустымиЦенами;
	КонецЕсли;
	питЗагрузкаRKeeper7_ВыводитьОтчет = ХранилищеОбщихНастроек.Загрузить("питЗагрузкаRKeeper7_ВыводитьОтчет");
	Если питЗагрузкаRKeeper7_ВыводитьОтчет <> Неопределено Тогда
		Объект.ВыводитьОтчет = питЗагрузкаRKeeper7_ВыводитьОтчет;
	КонецЕсли;
	питЗагрузкаRKeeper7_ВидЗагрузкиУдалений = ХранилищеОбщихНастроек.Загрузить("питЗагрузкаRKeeper7_ВидЗагрузкиУдалений");
	Если питЗагрузкаRKeeper7_ВидЗагрузкиУдалений <> Неопределено Тогда
		Объект.ВидЗагрузкиУдалений = питЗагрузкаRKeeper7_ВидЗагрузкиУдалений;
	КонецЕсли;
КонецПроцедуры

// Отбор по учетной записи
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьДопПараметры(Форма)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("УчетнаяЗапись", Форма.Объект.УчетнаяЗапись);
	ДопПараметры.Вставить("ТипСоответствий", Форма.Объект.ТипСоответствий);
	Возврат ДопПараметры;
	
КонецФункции

