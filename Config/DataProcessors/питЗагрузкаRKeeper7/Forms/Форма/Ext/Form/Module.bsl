	               |	КОНЕЦ КАК Модификаторы
	               |ИЗ
	               |	Продажи КАК Продажи";
	Объект.Продажи.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

// Возвращает структуру отборов
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
Функция ПолучитьОтборыТаблицыПродажПоРеквизитам()
	Отборы = Новый Структура;
	Отборы.Вставить("ДатаНачала", Объект.ДатаНачала);
	Отборы.Вставить("ДатаКонца", Объект.ДатаКонца);
	Отборы.Вставить("ЗагружатьСПустымиЦенами", Объект.ЗагружатьСПустымиЦенами);
	Отборы.Вставить("ВидЗагрузкиУдалений", Объект.ВидЗагрузкиУдалений);
	
	// Отборы по кассам ККМ
	Если ВыбранныеКассы.Количество() > 0 Тогда
		Отборы.Вставить("СписокКассККМ", ВыбранныеКассы.ВыгрузитьЗначения());
	КонецЕсли;
	Возврат Отборы;
КонецФункции


//  Процедура - Колучить кассы ккм продаж на сервере.
//
&НаСервере
Процедура КолучитьКассыККМПродажНаСервере()
	Отборы = ПолучитьОтборыТаблицыПродажПоРеквизитам();
	
	Если Объект.Продажи.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Кассы ККМ были получены из базы документов R-Keeper по текущим настройкам отбора";
		Сообщение.Сообщить();
	КонецЕсли;
	
	ТаблицаПродаж = Обработки.питЗагрузкаRKeeper7.ПолучитьТаблицуПродаж(Отборы);
	ПолучитьСоответствияКассККМПоПродажам(ТаблицаПродаж);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияКассыККМ.Отбор,"Ссылка1С",Справочники.КассыККМ.ПустаяСсылка(),ВидСравненияКомпоновкиДанных.НеРавно,,Элементы.ПоказатьТолькоЗаполненныеКассыККМ.Пометка,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры


// РАБОТА С СООТВЕТСТВИЯМИ


// Процедура устанавливает отборы на таблицы соответствий элементов
//
Процедура УстановитьОтборыСоответствий()
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияНоменклатура.Отбор,"ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.Номенклатура,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияПитТипыОплат.Отбор,"ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питТипыОплат,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияПитВидыОплатОрганизаций.Отбор,"ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питВидыОплатОрганизаций,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияПитМодификаторы.Отбор,"ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питМодификаторы,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияКассыККМ.Отбор,"ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияПитПричиныОтменИСписаний.Отбор,"ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питПричиныОтменИСписаний,ВидСравненияКомпоновкиДанных.Равно,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	УстановитьОтборПоУчетнойЗаписи(СоответствияНоменклатура.Отбор);
	УстановитьОтборПоУчетнойЗаписи(СоответствияПитТипыОплат.Отбор);
	УстановитьОтборПоУчетнойЗаписи(СоответствияПитВидыОплатОрганизаций.Отбор);
	УстановитьОтборПоУчетнойЗаписи(СоответствияПитМодификаторы.Отбор);
	УстановитьОтборПоУчетнойЗаписи(СоответствияКассыККМ.Отбор);
	УстановитьОтборПоУчетнойЗаписи(СоответствияПитПричиныОтменИСписаний.Отбор);
	
КонецПроцедуры

//  Процедура - Установить отбор по учетной записи.
//
// Параметры:
//  Список - СписокЗначений - Список.
//
Процедура УстановитьОтборПоУчетнойЗаписи(Список)
	
	УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
	Если Объект.ТипСоответствий = 1 Тогда
		УчетнаяЗаписьОтбор = Объект.УчетнаяЗапись;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список,"УчетнаяЗапись",
		УчетнаяЗаписьОтбор,
		ВидСравненияКомпоновкиДанных.Равно,,
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
КонецПроцедуры



// Установка соответствия для элементов
//
// Параметры:
//  Режим - Произвольный - Режим.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  ИспользоватьИерархию - Произвольный - Использовать иерархию.
//
&НаСервере
Процедура ПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ИспользоватьИерархию = Ложь)
	// Предупредим, если нечеткий поиск и не актуальный индекс
	Если Режим = 2 И Не ПолнотекстовыйПоиск.ИндексАктуален() Тогда
		ПолнотекстовыйПоиск.ОбновитьИндекс();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поисковый индекс обновлен.");
	КонецЕсли;
	
	// Отбор по учетной записи
	ДопПараметры = ПодготовитьДопПараметры(ЭтаФорма);
	
	ОтборСоответствий = ЭтотОбъект["Соответствия"+ИмяМетаданных].Отбор;
	Ошибки = Неопределено;
	питRKeeper7.ПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ОтборСоответствий, ДопПараметры, ИспользоватьИерархию, Объект.ПроцентСовпаденияСоответствия, Объект.СоздаватьОбъектыПриЗаполненииСоответствий, Ошибки, Объект.Склад);
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	Элементы["Соответствия"+ИмяМетаданных].Обновить();
КонецПроцедуры

// Загружает соответствия номенклатур по таблице продаж
//
// Параметры:
//  ТаблицаПродаж - ТаблицаЗначений - Таблица продаж.
//
Процедура ПолучитьСоответствияНоменклатурыПоПродажам(ТаблицаПродаж)
	Если ТаблицаПродаж.Количество() = 0 Тогда
		ТаблицаНоменклатуры = Новый ТаблицаЗначений;
		ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура");
		ТаблицаНоменклатуры.Колонки.Добавить("НоменклатураКод");
		ТаблицаНоменклатуры.Колонки.Добавить("НоменклатураУИД");
	Иначе
		ТаблицаНоменклатуры = ТаблицаПродаж.Скопировать(,"Номенклатура, НоменклатураКод, НоменклатураУИД");
	КонецЕсли;
	ТаблицаНоменклатуры.Свернуть("Номенклатура, НоменклатураКод, НоменклатураУИД");
	
	ТаблицаНоменклатуры.Колонки.Номенклатура.Имя = "Name";
	ТаблицаНоменклатуры.Колонки.НоменклатураКод.Имя = "Code";
	ТаблицаНоменклатуры.Колонки.НоменклатураУИД.Имя = "Sifr";
	
	МассивЭлементовRKeeper = ТаблицаНоменклатуры.ВыгрузитьКолонку("Sifr");
	СписокRKeeper = Новый СписокЗначений;
	СписокRKeeper.ЗагрузитьЗначения(МассивЭлементовRKeeper);
	
	// Отбор по учетной записи
	ДопПараметры = ПодготовитьДопПараметры(ЭтаФорма);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.Номенклатура));
	Если СтрокиНастроек.Количество() > 0 Тогда
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаНоменклатуры, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.Номенклатура, ДопПараметры, СтрокиНастроек[0]);
	Иначе
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаНоменклатуры, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.Номенклатура, ДопПараметры);
	КонецЕсли;
	// установим отбор по полученной номенклатуре
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияНоменклатура.Отбор,"СсылкаRKeeper",СписокRKeeper,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

// Загружает соответствия модификаторов по таблице продаж
//
// Параметры:
//  ТаблицаПродаж - ТаблицаЗначений - Таблица продаж.
//
Процедура ПолучитьСоответствияМодификаторовПоПродажам(ТаблицаПродаж)
	Если ТаблицаПродаж.Количество() = 0 Тогда
		ТаблицаМодификаторов = Новый ТаблицаЗначений;
