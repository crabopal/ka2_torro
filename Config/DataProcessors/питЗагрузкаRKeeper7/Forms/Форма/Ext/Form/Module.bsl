КонецПроцедуры

//  Процедура - Следующее пустое соответствие.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//  Направление - Число - Направление.
//
Процедура СледующееПустоеСоответствие(ИмяТаблицы, Направление = 1)
	ТаблицаСоответствия = ЭтаФорма[ИмяТаблицы];
	текСтрока =Элементы[ИмяТаблицы].ТекущаяСтрока; 
	Если текСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипОбъекта = текСтрока.ТипОбъекта;
	
	Тип = ТипОбъекта.ТипЗначения.Типы()[0];
	МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
	
	// Отбор по учетной записи
	УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
	Если Объект.ТипСоответствий = 1 Тогда
		УчетнаяЗаписьОтбор = Объект.УчетнаяЗапись;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СоответствияОбъектовRKeeper.ТипОбъекта,
	|	СоответствияОбъектовRKeeper.ИмяRKeeper,
	|	СоответствияОбъектовRKeeper.СсылкаRKeeper
	|ИЗ
	|	РегистрСведений.питСоответствияОбъектовRKeeper КАК СоответствияОбъектовRKeeper 
	|ГДЕ 
	|	СоответствияОбъектовRKeeper.УчетнаяЗапись = &УчетнаяЗаписьОтбор
	|	И (СоответствияОбъектовRKeeper.Ссылка1С = ЗНАЧЕНИЕ(Справочник."+МетаданныеТипа.Имя+".ПустаяСсылка) ИЛИ
	|	СоответствияОбъектовRKeeper.Ссылка1С Есть NULL ИЛИ 
	|	СоответствияОбъектовRKeeper.Ссылка1С = НЕОПРЕДЕЛЕНО ИЛИ
	|	СоответствияОбъектовRKeeper.СсылкаRKeeper = &СсылкаKeeper)";
	
	// Отбор по учетной записи
	Запрос.УстановитьПараметр("УчетнаяЗаписьОтбор", УчетнаяЗаписьОтбор);
	
	Запрос.УстановитьПараметр("СсылкаKeeper", текСтрока.СсылкаRKeeper);
	ТекстОтбора = "";
	Для Каждого СтрокаОтбора Из ТаблицаСоответствия.Отбор.Элементы Цикл
		ИспользованиеОтбора = СтрокаОтбора.Использование ;
		ЗначениеОтбора = СтрокаОтбора.ПравоеЗначение;
		Если ИспользованиеОтбора И ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			ТипСравнения = питRKeeper7.ПолучитьПредставлениеИнтервала(СтрокаОтбора.ВидСравнения);

			Запрос.УстановитьПараметр(СтрокаОтбора.Имя, ЗначениеОтбора);
			ТекстОтбора = ТекстОтбора + "И СоответствияОбъектовRKeeper."+ СтрокаОтбора.Имя + " " + ТипСравнения.Представление + "(&"+ СтрокаОтбора.Имя + ")" +Символы.ПС;
		КонецЕсли;
					   
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + ТекстОтбора;
	
	ТекстПорядка = "";
	// Порядок
	Для Каждого СтрокаПорядка Из ТаблицаСоответствия.Порядок Цикл
		ТекстПорядка = ТекстПорядка + " СоответствияОбъектовRKeeper."+ СтрокаПорядка.Имя + ", ";
	КонецЦикла;
	Если ТекстПорядка <> "" Тогда
		ТекстПорядка = "УПОРЯДОЧИТЬ ПО" + Лев(ТекстПорядка,СтрДлина(ТекстПорядка)-2);
		Запрос.Текст = Запрос.Текст + ТекстПорядка;
	КонецЕсли;
	
	ТаблицаПустыхЗначений = Запрос.Выполнить().Выгрузить();
	ТекущаяСтрока = ТаблицаПустыхЗначений.Найти(текСтрока.СсылкаRKeeper, "СсылкаRKeeper");
	
	ПеременнаяЦикла = ТаблицаПустыхЗначений.Индекс(ТекущаяСтрока)+Направление;
	Если Направление = 1 И ПеременнаяЦикла >= ТаблицаПустыхЗначений.Количество() Тогда
		ПеременнаяЦикла = 0;
	ИначеЕсли Направление = -1 И ПеременнаяЦикла < 0 Тогда
		ПеременнаяЦикла = ТаблицаПустыхЗначений.Количество()-1;
	КонецЕсли;

	Ключ = РегистрыСведений.питСоответствияОбъектовRKeeper.СоздатьКлючЗаписи(Новый Структура("ТипОбъекта,УчетнаяЗапись,СсылкаRKeeper",ТипОбъекта,УчетнаяЗаписьОтбор,ТаблицаПустыхЗначений[ПеременнаяЦикла].СсылкаRKeeper));
	Элементы[ИмяТаблицы].ТекущаяСтрока = Ключ;

КонецПроцедуры

