//  Процедура - Создать документы дпф.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СоздатьДокументыДПФ(Команда)
	Если Объект.ДатаКонца < Объект.ДатаНачала Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Внимание! Введен некорректный период отбора продаж";
		Сообщение.Сообщить();
	КонецЕсли;
	
	Если Объект.Продажи.Количество() = 0 Тогда
		// ТекстВопроса = "Таблица данных продаж R-Keeper не заполнена. Какие данные необходимо записать?";
		// СписокОтветов = Новый СписокЗначений;
		// СписокОтветов.Добавить("ПродажиУдаления", "Продажи и удаления");
		// СписокОтветов.Добавить("Продажи", "Продажи");
		// СписокОтветов.Добавить("Удаления", "Удаления");
		//
		// Ответ = Вопрос(ТекстВопроса, СписокОтветов,10,"ПродажиУдаления","Укажите вид загружаемых данных");
		// Если Ответ = "Продажи" Тогда
		// 	Отборы = ПолучитьОтборыТаблицыПродажПоРеквизитам();
		// 	Отборы.Вставить("СостояниеЧека", 6);
		// ИначеЕсли Ответ = "Удаления" Тогда
		// 	Отборы = ПолучитьОтборыТаблицыПродажПоРеквизитам();
		// 	Отборы.Вставить("СостояниеЧека", 7);
		// Иначе
		// 	Отборы = ПолучитьОтборыТаблицыПродажПоРеквизитам();
		// КонецЕсли;
		// ЗагрузитьТаблицуПродаж(Отборы);
		
		Возврат;
	КонецЕсли;
	ПрерываниеЗагрузки = Ложь;
	МассивСозданныхДокументов = СоздатьДокументыДПФНаСервере(ПрерываниеЗагрузки);
	Если Объект.ВыводитьОтчет И МассивСозданныхДокументов.Количество() > 0 Тогда
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("МассивДокументов", МассивСозданныхДокументов);
		ПараметрыПечати.Вставить("ПрерываниеЗагрузки", ПрерываниеЗагрузки);
		
		Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
			МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
			МодульУправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.питЗагрузкаRKeeper7", "РезультатРаботы", 
				МассивСозданныхДокументов, ЭтотОбъект, ПараметрыПечати);
		КонецЕсли;
	КонецЕсли;
	
	// СОЗДАНИЕ ЦЕЛЕВЫХ ДОКУМЕНТОВ
	Если Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта И МассивСозданныхДокументов.Количество() > 0 И НЕ ПрерываниеЗагрузки Тогда
		// если уже какая то пачка была прогружена, то ее не надо делить
		ЧекиНаСозданиеЦелевых = ДополнитьЧекиСвязаннымиПоЦелевым(МассивСозданныхДокументов);
		
		СтруктураОбработанныхДПФ = ВыполнитьЗагрузкуИзДанныхПродаж(ЧекиНаСозданиеЦелевых);
		
		Если Объект.ВыводитьОтчет И (СтруктураОбработанныхДПФ.МассивСохраненныхДокументов.Количество() + СтруктураОбработанныхДПФ.МассивУдаленныхДокументов.Количество()) > 0 Тогда
				
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("МассивСохраненныхДокументов", СтруктураОбработанныхДПФ.МассивСохраненныхДокументов);
			ПараметрыПечати.Вставить("МассивУдаленныхДокументов",СтруктураОбработанныхДПФ. МассивУдаленныхДокументов);
			
			
			Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
				МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
				МодульУправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.питЗагрузкаИзДанныхПродажФронта", "РезультатРаботы", 
					СтруктураОбработанныхДПФ.МассивСохраненныхДокументов, ЭтотОбъект, ПараметрыПечати);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


