Процедура СледующееПустоеСоответствиеКассыККМ(Команда)
	СледующееПустоеСоответствие("СоответствияКассыККМ",1);
КонецПроцедуры

//  Процедура - Расписание.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Расписание(Команда)
	
	РасписаниеЗадания = ПолучитьТекущееРасписание();
	Если РасписаниеЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("Модифицированность", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьРасписаниеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ДиалогРасписания = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеЗадания);
	ДиалогРасписания.Показать(ОписаниеОповещения);
	
КонецПроцедуры

//  Процедура - Получить настройки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПолучитьНастройки(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнена учетная запись для получения настроек по умолчанию.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ПолучитьНастройкиНаСервере();
	Сообщение = Новый СообщениеПользователю();
	Сообщение.Текст = "Настройки получены.";
	Сообщение.Сообщить();
КонецПроцедуры

//  Процедура - Сохранить настройки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СохранитьНастройки(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнена учетная запись для сохранения настроек по умолчанию.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Отказ = Ложь;
	СохранитьНастройкиНаСервере(Отказ);
	Если НЕ Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Настройки сохранены.'", "ru"));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='При сохранении настроек возникла ошибка.'", "ru"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Процедура начальной инициализации параметров
//
Процедура Инициализация()
	
	// Отбор по учетной записи
	УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
	Если Объект.ТипСоответствий = 1 Тогда
		УчетнаяЗаписьОтбор = Объект.УчетнаяЗапись;
	КонецЕсли;
	
	Если ЗаполнятьНастройкиПоУмолчанию Тогда
		Объект.ВыводитьОтчет = Истина;
		Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта = Ложь;
		Объект.ЗагружатьСПустымиЦенами = Истина;
		Объект.ПроцентСовпаденияСоответствия = 75;
		ВидОтображенияПолей = 1;
		ОтображениеСвязейОплат = 1;
		Объект.ПроверятьЗаполненностьСоответствий = Истина;
		Объект.СоздаватьОбъектыПриЗаполненииСоответствий = Ложь;
		Объект.ПроверятьЗаполненностьСоответствий = Истина;
	КонецЕсли;
	
	// ИнициализацияОтбора();
	
	// Получим список касс RKeeper
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовRKeeper.Ссылка1С
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовRKeeper КАК СоответствияОбъектовRKeeper
	               |ГДЕ
	               |	СоответствияОбъектовRKeeper.ТипОбъекта = &ТипОбъектаКасса
	               |	И СоответствияОбъектовRKeeper.УчетнаяЗапись = &УчетнаяЗаписьОтбор 
	               |	И НЕ СоответствияОбъектовRKeeper.Ссылка1С ЕСТЬ NULL 
	               |	И СоответствияОбъектовRKeeper.Ссылка1С <> НЕОПРЕДЕЛЕНО
	               |	И СоответствияОбъектовRKeeper.Ссылка1С <> ЗНАЧЕНИЕ(Справочник.КассыККМ.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ТипОбъектаКасса", ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ);
	
	// Отбор по учетной записи
	Запрос.УстановитьПараметр("УчетнаяЗаписьОтбор", УчетнаяЗаписьОтбор);
	
	МассивКасс = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка1С");
	
	// Получим дату последнего загруженного документа
	НачалоУчета = Объект.УчетнаяЗапись.НачалоУчета;
	Запрос = Новый Запрос;   
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ДанныеПродажФронта.Дата КАК Дата
	               |ИЗ
	               |	Документ.питДанныеПродажФронта КАК ДанныеПродажФронта
	               |ГДЕ
	               |	ДанныеПродажФронта.КассаККМ В(&КассыККМ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";
	Запрос.УстановитьПараметр("КассыККМ", МассивКасс);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ДатаНачала = КонецДня(Выборка.Дата)+1;
	Иначе
		Объект.ДатаНачала = НачалоУчета;
	КонецЕсли;

	Объект.ДатаКонца = КонецДня(Объект.ДатаНачала);
	
КонецПроцедуры

//  Процедура - Пометить кнопку.
//
// Параметры:
//  Кнопка - Произвольный - Кнопка.
//  Кнопки - Произвольный - Кнопки.
//
&НаКлиенте
Процедура ПометитьКнопку(Кнопка, Кнопки)
	Для Каждого текКнопка Из Кнопки Цикл
		Если ТипЗнч(текКнопка) = Тип("КнопкаФормы") Тогда
			текКнопка.Пометка = текКнопка = Кнопка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

//  Процедура - Индикация параметров подключения.
//
// Параметры:
//  УчетнаяЗапись - Произвольный - Учетная запись.
//
&НаСервере
Процедура ИндикацияПараметровПодключения(УчетнаяЗапись)
	СерверКипер = УчетнаяЗапись.Сервер;
	БазаКипер = УчетнаяЗапись.База;
	Если Не ЗначениеЗаполнено(СерверКипер) Или Не ЗначениеЗаполнено(БазаКипер) Тогда
		Если НЕ Обработки.питЗагрузкаRKeeper7.ПодключениеАктивно() Тогда
			Элементы.Подключение.Заголовок = "Подключение не настроено";
			Элементы.Подключение.ЦветТекста = WebЦвета.Красный;
		Иначе
			Элементы.Подключение.Заголовок = "Подключение установлено";
			Элементы.Подключение.ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;
	Иначе
		// Выполним подключение к БД
		Обработки.питЗагрузкаRKeeper7.ПодключитьсяКВнешнемуИсточникуДанных(Объект.УчетнаяЗапись);
		
		Если НЕ Обработки.питЗагрузкаRKeeper7.ПодключениеАктивно() Тогда
			Элементы.Подключение.Заголовок = "Подключение не установлено";
			Элементы.Подключение.ЦветТекста = WebЦвета.Серый;
		Иначе
			Элементы.Подключение.Заголовок = "Подключение установлено; учетная запись " + УчетнаяЗапись.Наименование;
			Элементы.Подключение.ЦветТекста = WebЦвета.Зеленый;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - Получить все кассы ккм на сервере.
//
Процедура ПолучитьВсеКассыККМНаСервере()
	ТаблицаКассККМ = питRKeeper7.ПолучитьТаблицуКассККМ();
	
	МассивЭлементовRKeeper = ТаблицаКассККМ.ВыгрузитьКолонку("Sifr");
	СписокRKeeper = Новый СписокЗначений;
	СписокRKeeper.ЗагрузитьЗначения(МассивЭлементовRKeeper);
	
	// Отбор по учетной записи
	ДопПараметры = ПодготовитьДопПараметры(ЭтаФорма);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ));
	Если СтрокиНастроек.Количество() > 0 Тогда
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаКассККМ, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ, ДопПараметры, СтрокиНастроек[0]);
	Иначе
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаКассККМ, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ, ДопПараметры);
	КонецЕсли;
	// установим отбор по полученной номенклатуре
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияКассыККМ.Отбор,"СсылкаRKeeper",СписокRKeeper,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
// 
// ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияКассыККМ.Отбор,"Ссылка1С",Справочники.КассыККМ.ПустаяСсылка(),ВидСравненияКомпоновкиДанных.НеРавно);.
КонецПроцедуры

//  Процедура - При изменении учетной записи на сервере.
//
&НаСервере
Процедура ПриИзмененииУчетнойЗаписиНаСервере()
	
	// Отбор по учетной записи
	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		Объект.ТипСоответствий = Объект.УчетнаяЗапись.ТипСоответствий;
	КонецЕсли;
	
	Обработки.питЗагрузкаRKeeper7.ОтключитьсяОтВнешнегоИсточникаДанных();
	Обработки.питЗагрузкаRKeeper7.ПодключитьсяКВнешнемуИсточникуДанных(Объект.УчетнаяЗапись);
	
	ИндикацияПараметровПодключения(Объект.УчетнаяЗапись);
	
	УстановитьОтборыСоответствий();
КонецПроцедуры

//  Функция - Получить новую учетную запись.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьНовуюУчетнуюЗапись()
	Результат = Неопределено;
	Запрос = НОвый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	питУчетныеЗаписиRKeeper.Сервер,
	|	питУчетныеЗаписиRKeeper.База,
	|	питУчетныеЗаписиRKeeper.НачалоУчета,
	|	питУчетныеЗаписиRKeeper.Ссылка
	|ИЗ
	|	Справочник.питУчетныеЗаписиRKeeper КАК питУчетныеЗаписиRKeeper
	|ГДЕ
	|	НЕ питУчетныеЗаписиRKeeper.ПометкаУдаления";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат = Выборка.Ссылка;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

//  Процедура - Загрузить продажи удаления на сервере.
//
// Параметры:
//  СостояниеЧека - Число - Состояние чека.
//
&НаСервере
Процедура ЗагрузитьПродажиУдаленияНаСервере(СостояниеЧека = 0)
	Если Объект.ДатаКонца < Объект.ДатаНачала Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Введен некорректный период отбора продаж");
		Возврат;
	КонецЕсли;
	Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Отключен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлено ни одного соединения с базой данных R-Keeper");
		Возврат;
	КонецЕсли;
	Отборы = ПолучитьОтборыТаблицыПродажПоРеквизитам();
	Если СостояниеЧека <> 0 Тогда
		Отборы.Вставить("СостояниеЧека", СостояниеЧека);
	КонецЕсли;
	
	СтруктураПродаж = Обработки.питЗагрузкаRKeeper7.ПолучитьСтруктуруТаблицПродаж(Отборы);
	Объект.Продажи.Загрузить(СтруктураПродаж.ТаблицаПродаж);
	Объект.Модификаторы.Загрузить(СтруктураПродаж.ТаблицаПродажМодификаторы);
	Объект.ТаблицаСоответствияИмяУИД.Загрузить(СтруктураПродаж.ТаблицаСоответствияИмяУИД);
	ЗаполнитьСлужебныеРеквизитыПродаж();
КонецПроцедуры

//  Процедура - Заполнить служебные реквизиты продаж.
//
Процедура ЗаполнитьСлужебныеРеквизитыПродаж()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модификаторы", Объект.Модификаторы.Выгрузить(,"НоменклатураУИД, ЧекУИД"));
	Запрос.УстановитьПараметр("Продажи", Объект.Продажи.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	Модификаторы.НоменклатураУИД,
	               |	Модификаторы.ЧекУИД
	               |ПОМЕСТИТЬ МодификаторыПродаж
	               |ИЗ
	               |	&Модификаторы КАК Модификаторы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Продажи.Пометка,
	               |	Продажи.Номенклатура,
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.ТипОплаты,
	               |	Продажи.ТипОплатыУИД,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.Касса,
	               |	Продажи.КассаУИД,
	               |	Продажи.ДатаСмены,
	               |	Продажи.НомерСмены,
	               |	Продажи.Ресторан,
	               |	Продажи.РесторанУИД,
	               |	Продажи.ХозОперация,
	               |	Продажи.ПричинаОтменСписаний,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.ЧекДата,
	               |	Продажи.ЧекУИД,
