	ТаблицаМодификаторов.Колонки.МодификаторУИД.Имя = "Sifr";
	
	МассивЭлементовRKeeper = ТаблицаМодификаторов.ВыгрузитьКолонку("Sifr");
	СписокRKeeper = Новый СписокЗначений;
	СписокRKeeper.ЗагрузитьЗначения(МассивЭлементовRKeeper);
	
	// Отбор по учетной записи
	ДопПараметры = ПодготовитьДопПараметры(ЭтаФорма);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питМодификаторы));
	Если СтрокиНастроек.Количество() > 0 Тогда
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаМодификаторов, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питМодификаторы, ДопПараметры, СтрокиНастроек[0]);
	Иначе
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаМодификаторов, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питМодификаторы, ДопПараметры);
	КонецЕсли;
	// установим отбор по полученной номенклатуре
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоответствияПитМодификаторы.Отбор,"СсылкаRKeeper",СписокRKeeper,ВидСравненияКомпоновкиДанных.ВСписке,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

// Загружает соответствия видов оплат по таблице продаж
//
// Параметры:
//  ТаблицаПродаж - ТаблицаЗначений - Таблица продаж.
//
Процедура ПолучитьСоответствияВидовОплатОрганизацийПоПродажам(ТаблицаПродаж)
	Если ТаблицаПродаж.Количество() = 0 Тогда
		ТаблицаВидовОплат = Новый ТаблицаЗначений;
		ТаблицаВидовОплат.Колонки.Добавить("ВидОплаты");
		ТаблицаВидовОплат.Колонки.Добавить("ВидОплатыКод");
		ТаблицаВидовОплат.Колонки.Добавить("ВидОплатыУИД");
		ТаблицаВидовОплат.Колонки.Добавить("ТипОплатыУИД");
	Иначе
		ТаблицаВидовОплат = ТаблицаПродаж.Скопировать(,"ВидОплаты, ВидОплатыКод, ВидОплатыУИД, ТипОплатыУИД");
	КонецЕсли;
	
	ТаблицаВидовОплат.Свернуть("ВидОплаты, ВидОплатыКод, ВидОплатыУИД, ТипОплатыУИД");
	
	ТаблицаВидовОплат.Колонки.ВидОплаты.Имя = "Name";
	ТаблицаВидовОплат.Колонки.ВидОплатыКод.Имя = "Code";
	ТаблицаВидовОплат.Колонки.ВидОплатыУИД.Имя = "Sifr";
	ТаблицаВидовОплат.Колонки.ТипОплатыУИД.Имя = "Parent";
	
	МассивЭлементовRKeeper = ТаблицаВидовОплат.ВыгрузитьКолонку("Sifr");
	СписокRKeeper = Новый СписокЗначений;
	СписокRKeeper.ЗагрузитьЗначения(МассивЭлементовRKeeper);
	
	// Отбор по учетной записи
	ДопПараметры = ПодготовитьДопПараметры(ЭтаФорма);
	
	СтрокиНастроек = Объект.ПараметрыЗагрузки.НайтиСтроки(Новый Структура("ТипОбъекта",ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питВидыОплатОрганизаций));
	Если СтрокиНастроек.Количество() > 0 Тогда
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаВидовОплат, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питВидыОплатОрганизаций, ДопПараметры, СтрокиНастроек[0]);
	Иначе
		питRKeeper7.ДобавитьНедостающиеСтрокиСоответствия(ТаблицаВидовОплат, ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питВидыОплатОрганизаций, ДопПараметры);
	КонецЕсли;
