//  Функция - Получить имя метаданных строки параметров.
//
// Параметры:
//  текСтрока - Строка - тек строка.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
Функция ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока)
	текДанные = объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
	
	ЕстьИерархия = Ложь;
	ТипЗначения = текДанные.ТипОбъекта.ТипЗначения;
	Для Каждого Тип Из ТипЗначения.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если МетаданныеТипа.Иерархический Тогда
			ЕстьИерархия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьИерархия Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МетаданныеТипа.Имя;
КонецФункции

//  Процедура - Сохранить параметры загрузки на сервере.
//
&НаСервере
Процедура СохранитьПараметрыЗагрузкиНаСервере()
	Для Каждого СтрокаТипа Из Объект.ПараметрыЗагрузки Цикл
		ТипОбъектаОбъект = СтрокаТипа.ТипОбъекта.ПолучитьОбъект();
		ТипОбъектаОбъект.Обновлять = СтрокаТипа.Обновлять;
		ТипОбъектаОбъект.Создавать = СтрокаТипа.Создавать;
		ТипОбъектаОбъект.СлужебныйКаталог = СтрокаТипа.СлужебныйКаталог;
		ТипОбъектаОбъект.ОбработкаОшибок = СтрокаТипа.ОбработкаОшибок;
		
		Попытка
			ТипОбъектаОбъект.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

//  Процедура - Очистить кассы ккм на сервере.
//
&НаСервере
Процедура ОчиститьКассыККМНаСервере()
	
	// Отбор по учетной записи
	УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
	Если Объект.ТипСоответствий = 1 Тогда
		УчетнаяЗаписьОтбор = Объект.УчетнаяЗапись;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовRKeeper.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТипОбъекта.Установить(ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ);
	
	// Отбор по учетной записи
	НаборЗаписей.Отбор.УчетнаяЗапись.Установить(УчетнаяЗаписьОтбор);
	
	НаборЗаписей.Прочитать();
	
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
КонецПроцедуры

//  Функция - Получить параметры модификаторов номенклатуры.
//
// Параметры:
//  текСтрока - Строка - тек строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьПараметрыМодификаторовНоменклатуры(текСтрока)
	текДанные = Объект.Продажи.НайтиПоИдентификатору(текСтрока);
	СтрокиМодификаторов = ОБъект.Модификаторы.НайтиСтроки(Новый Структура("ЧекУИД, НоменклатураУИД", текДанные.ЧекУИД, текДанные.НоменклатураУИД));
	МодификаторыНоменклатуры = Объект.Модификаторы.Выгрузить(СтрокиМодификаторов);
	АдресМодификаторов = ПоместитьВоВременноеХранилище(МодификаторыНоменклатуры);
	ПараметрыФормы = Новый Структура("НоменклатураУИД, АдресМодификаторов, НоменклатураКипер", текДанные.НоменклатураУИД, АдресМодификаторов, текДанные.Номенклатура);
	Возврат ПараметрыФормы;
КонецФункции                 
//  Процедура - Установить условное оформление типов видов оплат.
//
&НаСервере
Процедура УстановитьУсловноеОформлениеТиповВидовОплат()
	Для каждого ЭлементУО Из УсловноеОформление.Элементы Цикл
		Если ЭлементУО.Представление = "Связь типа и вида оплат через RKeeper" Тогда
			ЭлементУО.Использование = Элементы.ПоказыватьСвязьТипаВидаОплатВКипер.Пометка;
		КонецЕсли;
		Если ЭлементУО.Представление = "Связь типа и вида оплат через 1С" Тогда
			ЭлементУО.Использование = Элементы.ПоказыватьСвязьТипаВидаОплатВ1С.Пометка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


//  Функция - Получить текущее расписание.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьТекущееРасписание()
	
	РегламентноеЗаданиеОбмен = ПолучитьРегламентноеЗаданиеОбменаСКипером();
	Если РегламентноеЗаданиеОбмен = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РегламентноеЗаданиеОбмен.Расписание;
	
КонецФункции

//  Функция - Получить регламентное задание обмена с кипером.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьРегламентноеЗаданиеОбменаСКипером()
	
	// Найдем регламентные задания
	Попытка
		РегламентноеЗаданиеОбмен = РегламентныеЗадания.НайтиПредопределенное("питЗагрузкаRKeeper");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат РегламентноеЗаданиеОбмен;
	
КонецФункции

//  Функция - Установить новое расписание обмена с кипером.
//
// Параметры:
//  Расписание - Произвольный - Расписание.
//  ТекстОшибки - Строка - Текст ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция УстановитьНовоеРасписаниеОбменаСКипером(Расписание, ТекстОшибки = "")
	
	РегламентноеЗаданиеОбмен = ПолучитьРегламентноеЗаданиеОбменаСКипером();
	
	// Зададим параметры
	Если РегламентноеЗаданиеОбмен = Неопределено Тогда
		ТекстОшибки = "Регламентное задание обмена с R-Keeper не найдено в системе!";
		Возврат Ложь;
	КонецЕсли;
	
	РегламентноеЗаданиеОбмен.Расписание = Расписание;
	
	РегламентноеЗаданиеОбмен.Ключ = "Структура";
	РегламентноеЗаданиеОбмен.Параметры.Очистить();
	СтруктураПараметров = Новый Структура;
	МсвПараметры = Новый Массив;
	МсвПараметры.Добавить(СтруктураПараметров);
	РегламентноеЗаданиеОбмен.Параметры = МсвПараметры;
	Попытка
		РегламентноеЗаданиеОбмен.Записать();
	Исключение
		ТекстОшибки = "Ошибка записи расписания регламентного задания с R-Keeper по причине: " + ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

//  Процедура - Получить настройки на сервере.
//
&НаСервере
Процедура ПолучитьНастройкиНаСервере()
	ДополнительныеПараметры = Новый Структура("ВидНоменклатуры,Склад,ПроверятьЗаполненностьСоответствий,ЗагружатьСПустымиЦенами,ВыводитьОтчет,ВидЗагрузкиУдалений, ВыполнятьЗагрузкуИзДанныхПродажФронта");
	Если ЗначениеЗаполнено(Объект.УчетнаяЗапись) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.УчетнаяЗапись,ДополнительныеПараметры, Истина);
		ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
		ТЧПараметрыЗагрузки = Объект.УчетнаяЗапись.ПараметрыЗагрузки;
		
		Объект.ПараметрыЗагрузки.Очистить();
		Для Каждого ТекСтрока Из ТЧПараметрыЗагрузки Цикл
			НоваяСтрока = Объект.ПараметрыЗагрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Сохранить настройки на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаСервере
Процедура СохранитьНастройкиНаСервере(Отказ = Ложь)
	Попытка
		ОбъектУчетнаяЗапись = Объект.УчетнаяЗапись.ПолучитьОбъект();
		ОбъектУчетнаяЗапись.ВидНоменклатуры = Объект.ВидНоменклатуры;
		ОбъектУчетнаяЗапись.Склад = Объект.Склад;
		ОбъектУчетнаяЗапись.ПроверятьЗаполненностьСоответствий = Объект.ПроверятьЗаполненностьСоответствий;
		ОбъектУчетнаяЗапись.ЗагружатьСПустымиЦенами = Объект.ЗагружатьСПустымиЦенами;
		ОбъектУчетнаяЗапись.ВыводитьОтчет = Объект.ВыводитьОтчет;
		ОбъектУчетнаяЗапись.ВидЗагрузкиУдалений = Объект.ВидЗагрузкиУдалений;
		ОбъектУчетнаяЗапись.ВыполнятьЗагрузкуИзДанныхПродажФронта = Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта;
		
		ТЧПараметрыЗагрузки = Объект.ПараметрыЗагрузки;
		ОбъектУчетнаяЗапись.ПараметрыЗагрузки.Очистить();
		Для Каждого ТекСтрока Из ТЧПараметрыЗагрузки Цикл
			НоваяСтрока = ОбъектУчетнаяЗапись.ПараметрыЗагрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		ОбъектУчетнаяЗапись.Записать();
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""СохранитьНастройкиНаСервере"": " + ТекстОшибки;
		Событие = "питЗагрузкаIIKO";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Отказ = Истина;
	КонецПопытки;
КонецПроцедуры


//  Процедура - Сохранить настройки формы.
//
&НаСервере
Процедура СохранитьНастройкиФормы()
	
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_УчетнаяЗапись", , Объект.УчетнаяЗапись);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ПроцентСовпаденияСоответствия", , Объект.ПроцентСовпаденияСоответствия);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_СоздаватьОбъектыПриЗаполненииСоответствий", , Объект.СоздаватьОбъектыПриЗаполненииСоответствий);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ДатаНачала", , Объект.ДатаНачала);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ДатаКонца", , Объект.ДатаКонца);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ВыполнятьЗагрузкуИзДанныхПродажФронта", , Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ПроверятьЗаполненностьСоответствий", , Объект.ПроверятьЗаполненностьСоответствий);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ЗагружатьСПустымиЦенами", , Объект.ЗагружатьСПустымиЦенами);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ВыводитьОтчет", , Объект.ВыводитьОтчет);
	ХранилищеОбщихНастроек.Сохранить("питЗагрузкаRKeeper7_ВидЗагрузкиУдалений", , Объект.ВидЗагрузкиУдалений);
	
КонецПроцедуры

//  Процедура - Восстановить настройки формы.
//
&НаСервере
Процедура ВосстановитьНастройкиФормы()
	
	// восстанавливаем настройки
