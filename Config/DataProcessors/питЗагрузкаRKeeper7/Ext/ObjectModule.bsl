#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем Права Экспорт; // Переменная объекта - ссылка на коллекцию прав, настроек и переменных окружения
Перем ПрерватьЗагрузку Экспорт; // Переменная прервать загрузку.
Перем МассивОбъектов;
Перем РежимОшибкиЗагрузки;
Перем ТаблицаНоменклатурныхПриоритетов;
Перем КэшированныеЗначения;
Перем КэшТаблицаПВХ;
Перем МассивОбъектовНаРегистрацию;
Перем ТаблицаЧековОбщепита;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Функция производит преобразование из X системы счисления в Y
//
// Параметры:
//  ЧислоXСистемы - Число - Число x системы.
//  ШаблонXСистемы - Произвольный - Знач шаблон x системы.
//  ШаблонYСистемы - Произвольный - Знач шаблон y системы.
//
// Возвращаемое значение:
//  Число - преобразованное число в системе счислений Y.
Функция ПреобразоватьВСистемуСчисления(ЧислоXСистемы, Знач ШаблонXСистемы, Знач ШаблонYСистемы) Экспорт
	
	ШаблонXСистемы = ВРег(ШаблонXСистемы);
	ШаблонYСистемы = ВРег(ШаблонYСистемы);
	
	// Вначале определим разрядность основания
	ОснованиеXСистемы = СтрДлина(ШаблонXСистемы);
	ОснованиеYСистемы = СтрДлина(ШаблонYСистемы);
	
	Если ОснованиеXСистемы = 10 Тогда
		ЧислоYРешение = "";
		ЦелаяЧасть = ЧислоXСистемы;
		
		Остаток = ЦелаяЧасть % ОснованиеYСистемы;
		ЦелаяЧасть = Цел(ЦелаяЧасть / ОснованиеYСистемы);
		
		ЧислоYРешение = Сред(ШаблонYСистемы,Остаток+1,1) + ЧислоYРешение;
		Пока Остаток > 0 Или ЦелаяЧасть > 0 Цикл

			Остаток = ЦелаяЧасть % ОснованиеYСистемы;
			ЦелаяЧасть = Цел(ЦелаяЧасть / ОснованиеYСистемы);
			
			ЧислоYРешение = Сред(ШаблонYСистемы,Остаток+1,1) + ЧислоYРешение;
		КонецЦикла;
		
		Возврат ЧислоYРешение;
	ИначеЕсли ОснованиеYСистемы = 10 Тогда
		ЧислоYРешение = 0;
		НомерРазряда = 0;
		Пока НомерРазряда < СтрДлина(ЧислоXСистемы) Цикл
			НомерРазряда = НомерРазряда + 1;
			// Найдем символ в шаблон
			Множитель = Макс(Найти(ШаблонXСистемы, Сред(Строка(ЧислоXСистемы),НомерРазряда,1))-1,0);
			
			ЧислоYРешение = ЧислоYРешение + Множитель * Pow(ОснованиеXСистемы,СтрДлина(ЧислоXСистемы)-НомерРазряда);
			
		КонецЦикла;
		Возврат ЧислоYРешение;
	Иначе
		// Вначале преобразуем в десятиричную
		ЧислоВДесятичнойСистеме = ПреобразоватьВСистемуСчисления(ЧислоXСистемы, ШаблонXСистемы, "0123456789");
		ЧислоВДесятичнойСистеме = Число(ЧислоВДесятичнойСистеме);
		Возврат ПреобразоватьВСистемуСчисления(ЧислоВДесятичнойСистеме, "0123456789", ШаблонYСистемы);
	КонецЕсли;
	
	
КонецФункции

// Первоначальная инициализация отбора
//
Процедура ИнициализацияОтбора() Экспорт
	ДоступныеПоляОтбора = Отбор.ПолучитьДоступныеПоля();
	ДоступныеПоляОтбора.Очистить();
	
	// Установим настройки отбора
	ПолеНастройки=ДоступныеПоляОтбора.Добавить("Подразделение","Подразделение",Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
	ПолеНастройки.Отбор=Истина;
	ПолеНастройки=ДоступныеПоляОтбора.Добавить("КассаККМ","Касса ККМ",Новый ОписаниеТипов("Число"));
	ПолеНастройки.Отбор=Истина;
	Отбор.УстановитьДоступныеПоля(ДоступныеПоляОтбора);
	НовыйОтбор = Отбор.Добавить("Подразделение", "Подразделение", "Подразделение");
	НовыйОтбор.Использование = Ложь;
	НовыйОтбор.ВидСравнения = ВидСравнения.ВСписке;
	НовыйОтбор = Отбор.Добавить("КассаККМ", "КассаККМ", "Касса ККМ");
	НовыйОтбор.Использование = Ложь;
	НовыйОтбор.ВидСравнения = ВидСравнения.ВСписке;
КонецПроцедуры

// Создает документы ДПФ по таблице продаж и возвращает массив созданных документов
//
// Параметры:
//  РезультатПоПродажам - Произвольный - Результат по продажам.
//  МассивСозданныхЦелевыхДокументов - Массив - Массив созданных целевых документов.
//  МассивУдаленныхЦелевыхдокументов - Массив - Массив удаленных целевыхдокументов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьДокументыДПФ(РезультатПоПродажам, МассивСозданныхЦелевыхДокументов = Неопределено, МассивУдаленныхЦелевыхдокументов = Неопределено) Экспорт
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	МассивОбъектов = Новый Массив;
	
	Если Не ПроверкаКорректностиЗаполнения() Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	Если Продажи.Количество() = 0 Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	ИнициализироватьТаблицуЧековОбщепита();
	
	
	Выборка = РезультатПоПродажам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ПрерватьЗагрузку = Ложь;
	ОбходРезультатЗапроса(Выборка);
	
	Если НЕ ПрерватьЗагрузку И ЗначениеЗаполнено(ТаблицаЧековОбщепита) Тогда
		
		ТаблицаРазличныхДат = ТаблицаЧековОбщепита.Скопировать(,"ДатаДокумента");
		ТаблицаРазличныхДат.Свернуть("ДатаДокумента");
		
		
		// Разделем таблицу документов на несколько таблиц значений (в зависимости от количества различных дат).
		Для Каждого ТекДата Из ТаблицаРазличныхДат Цикл 
			
			Если ПрерватьЗагрузку Тогда
				Прервать;
			КонецЕсли;
			
			// Найдем все строки в таблице по дате
			ПараметрыОтбора = Новый Структура("ДатаДокумента", ТекДата.ДатаДокумента);
			ТаблицаДокументовПоДате = ТаблицаЧековОбщепита.Скопировать(ПараметрыОтбора);
			
			Если ТаблицаДокументовПоДате.Количество() > 0 Тогда
				
				МассивОбъектовНаРегистрацию = Новый Массив;
				НачатьТранзакцию();
				
				Для Каждого ТекСтрока Из ТаблицаДокументовПоДате Цикл
					
					Если ТекСтрока.ДокументОбъект = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ТекСтрока.ДокументОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
					
					Результат = ВыполнитьЗаписьОбъекта(ТекСтрока.ДокументОбъект, Новый Структура);
					Если НЕ Результат Тогда
						ПрерватьЗагрузку = Истина;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если ПрерватьЗагрузку Тогда
					ОтменитьТранзакцию();
					Прервать;
				КонецЕсли;
				
				// Выполним обработку документов
				Попытка
					
					Если ЗначениеЗаполнено(МассивОбъектовНаРегистрацию) Тогда
						// Выполним обработку документов
						ТекстОшибки = "";
						Обработки.питЗагрузкаИзДанныхПродажФронта.ЗарегистрироватьИзмененияДанныхПродажФронта(МассивОбъектовНаРегистрацию, ТекстОшибки);
						Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
							ОтменитьТранзакцию();
							ВызватьИсключение ТекстОшибки;
						КонецЕсли;
					КонецЕсли;
					ЗафиксироватьТранзакцию();
					
				Исключение
					
					ПрерватьЗагрузку = Истина;
					Если ТранзакцияАктивна() Тогда
						ОтменитьТранзакцию();
					КонецЕсли;
					ИнфОбОшибке = ИнформацияОбОшибке();
					ТекстОшибки = ИнфОбОшибке.Описание;
					Пока ИнфОбОшибке.Причина <> Неопределено Цикл
						ИнфОбОшибке = ИнфОбОшибке.Причина;
						ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
					КонецЦикла;
					ТекстВывести = "Не удалось записать данные о продажах в регистр по причине:" + Символы.ПС + ТекстОшибки;
					ЗаписьЖурналаРегистрации("питЗагрузкаRKeeper7.РегистрацияВЦелевые", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
					
				КонецПопытки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Создание записей о данных продаж в регистре
	Если НЕ ПрерватьЗагрузку И Константы.питВыполнятьПроведениеЧековОбщепита.Получить() И МассивОбъектов.Количество() > 0 Тогда
		
		// Параметры обернем в структуру для их передачи 
		// через механизм ДлительныеОперации.
		ПараметрыФункции = Новый Структура();
		ПараметрыФункции.Вставить("МассивВыбранныхЧеков",               МассивОбъектов);
		ПараметрыФункции.Вставить("СообщатьПрогрессВыполнения",               Ложь);

		НаименованиеФоновогоЗадания = НСтр("ru = 'Проведение чеков общепита'");
		
		ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		(Новый УникальныйИдентификатор), 
		"Обработки.питПроведениеЧековОбщепита.ПровестиЧекиОбщепита", 
		ПараметрыФункции, 
		НаименованиеФоновогоЗадания);
		
	КонецЕсли;

	
	Возврат МассивОбъектов;
КонецФункции

// Функция - Получить результат по продажам.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьРезультатПоПродажам() Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаВсего,
	               |	Продажи.СуммаСкидки,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.НДС,
	               |	Продажи.СуммаНДС,
	               |	Продажи.ТипОплатыУид,
	               |	Продажи.КассаУИД,
	               |	Продажи.НомерСмены,
	               |	Продажи.ДатаСмены,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.РесторанУИД,
	               |	ВЫБОР
	               |		КОГДА Продажи.ХозОперация = 6
	               |			ТОГДА ""Продажа""
	               |		КОГДА Продажи.ХозОперация = 7
	               |				И &ВидЗагрузкиУдалений = 0
	               |			ТОГДА ""Отмена""
	               |		КОГДА Продажи.ХозОперация = 7
	               |				И &ВидЗагрузкиУдалений = 1
	               |			ТОГДА ""Возврат""
	               |		ИНАЧЕ ""Неопределено""
	               |	КОНЕЦ КАК ХозОперация,
	               |	Продажи.ДатаОтмены,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.НастройкиПричинОтменСписаний,
	               |	Продажи.ЧекНомер,
	               |	Продажи.ЧекДата,
	               |	Продажи.ЧекУИД,
	               |	Продажи.ЭтоКомбоБлюдо,
	               |	Продажи.УдалениеУИД
	               |ПОМЕСТИТЬ Продажи
	               |ИЗ
	               |	&Продажи КАК Продажи
	               |ГДЕ
	               |	Продажи.Пометка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
				   |
	               |ВЫБРАТЬ
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаВсего,
	               |	Продажи.СуммаСкидки,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.НДС,
	               |	Продажи.СуммаНДС,
	               |	Продажи.ТипОплатыУид,
	               |	Продажи.КассаУИД КАК КассаУИД,
	               |	Продажи.НомерСмены КАК НомерСмены,
	               |	Продажи.ДатаСмены КАК ДатаСмены,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.РесторанУИД КАК РесторанУИД,
	               |	Продажи.ХозОперация КАК ХозОперация,
	               |	Продажи.ДатаОтмены,
	               |	Продажи.ПричинаОтменСписанийУИД,
	               |	Продажи.НастройкиПричинОтменСписаний,
	               |	Продажи.ЧекНомер,
	               |	Продажи.ЧекДата КАК ЧекДата,
	               |	Продажи.ЧекУИД КАК ЧекУИД,
	               |	Продажи.ЭтоКомбоБлюдо,
	               |	Продажи.УдалениеУИД КАК УдалениеУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВЫБОР
	               |		КОГДА Продажи.ЧекДата <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Продажи.ЧекДата <> NULL
	               |				И Продажи.ЧекДата <> НЕОПРЕДЕЛЕНО
	               |			ТОГДА Продажи.ЧекДата
	               |		КОГДА Продажи.ХозОперация <> 6
	               |				И Продажи.ДатаСмены <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Продажи.ДатаСмены <> NULL
	               |				И Продажи.ДатаСмены <> НЕОПРЕДЕЛЕНО
	               |			ТОГДА Продажи.ДатаСмены
	               |		ИНАЧЕ &ТекущаяДата
	               |	КОНЕЦ
	               |ИТОГИ ПО
	               |	ЧекУИД,
	               |	УдалениеУИД,
	               |	РесторанУИД,
	               |	ХозОперация,
	               |	КассаУИД,
	               |	ЧекДата,
	               |	ДатаСмены,
	               |	НомерСмены";
	Запрос.УстановитьПараметр("Продажи", Продажи.Выгрузить());
	Запрос.УстановитьПараметр("ВидЗагрузкиУдалений", ВидЗагрузкиУдалений);
	Результат = Запрос.Выполнить();
	
	Возврат Результат;
	
КонецФункции


// Получает объект ИБ по его идентификатору
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ЭтоГруппа - Произвольный - Это группа.
//  СоздаватьОбъект - Произвольный - Создавать объект.
//
// Возвращаемое значение:
// 	Массив - Массив родителей всех уровней	
Функция ПолучитьОбъектПоИД(Знач ИДСтрокой, МенеджерОбъекта, ЭтоГруппа, СоздаватьОбъект = Истина) Экспорт
	
	ОбъектСсылка = ПолучитьСсылкуПоИД(ИДСтрокой, МенеджерОбъекта);
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	// Попытка получения объекта
	ОбъектБазыДанных = ОбъектСсылка.ПолучитьОбъект();
	Если ОбъектБазыДанных=Неопределено Тогда
		Если СоздаватьОбъект Тогда
			// Создание объекта в базе...
			Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка)) Тогда
				Объект = МенеджерОбъекта.СоздатьДокумент();
			ИначеЕсли ЭтоГруппа Тогда
				Объект = МенеджерОбъекта.СоздатьГруппу();
			Иначе
				Объект = МенеджерОбъекта.СоздатьЭлемент();
			КонецЕсли; 
			// ... с заданной ссылкой
			Объект.УстановитьСсылкуНового(ОбъектСсылка);
		Иначе
			Объект = ОбъектБазыДанных;
		КонецЕсли; 
	Иначе
		// Объект уже есть в базе
		Объект = ОбъектБазыДанных;
	КонецЕсли;
	
	Возврат Объект;
		
КонецФункции // ПолучитьОбъектПоИД

// Получает ссылку по ее идентификатору
//
// Параметры:
//  ИсхИДСтрокой - Произвольный - Знач исх ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ПроверитьНаличие - Произвольный - Проверить наличие.
//
// Возвращаемое значение:
//  Произвольный - Искомая ссылка.	
Функция ПолучитьСсылкуПоИД(Знач ИсхИДСтрокой, МенеджерОбъекта, ПроверитьНаличие = Ложь) Экспорт
	
	Результат = МенеджерОбъекта.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИсхИДСтрокой) Тогда
		
		// Преобразуем в корректное значение ID
		ИДСтрокой = ПолучитьИДПоСтроке(ИсхИДСтрокой);
		// Получение ИД из строки
		ИД = Новый УникальныйИдентификатор(ИДСтрокой);
		// Получение ссылки по ИД
		Результат = МенеджерОбъекта.ПолучитьСсылку(ИД);
        // Проверяем есть объект в нашей БД
		Если ПроверитьНаличие Тогда
			Если ПустаяСтрока(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат, "ВерсияДанных")) Тогда
				// Такого объекта в базе нет
				Результат = МенеджерОбъекта.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;

	// Возврат ссылки (без проверки не исключается что "битая")
	Возврат Результат;
		
КонецФункции // ПолучитьСсылкуПоИД

// Получает ссылку объекта ИБ по его идентификатору
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//
// Возвращаемое значение:
// 	Произвольный - Ссылка объекта ИБ.	
Функция ПолучитьИДПоСтроке(Знач ИДСтрокой) Экспорт 
	
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "{", "");
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "}", "");

	Возврат ИДСтрокой;
	
КонецФункции // ПолучитьИДПоСтроке()

// Возвращает структуру отборов
//
// Параметры:
//  МассивКасс - Массив - Массив касс.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьОтборыТаблицыПродажПоРеквизитам(МассивКасс) Экспорт
	Отборы = Новый Структура;
	Отборы.Вставить("ДатаНачала", ДатаНачала);
	Если ЗначениеЗаполнено(ДатаКонца) Тогда
		Отборы.Вставить("ДатаКонца", ДатаКонца);
	КонецЕсли;
	Отборы.Вставить("ЗагружатьСПустымиЦенами", ЗагружатьСПустымиЦенами);
	Отборы.Вставить("ВидЗагрузкиУдалений", ВидЗагрузкиУдалений);
	
	// Отборы по кассам ККМ
	Если МассивКасс.Количество() > 0 Тогда
		Отборы.Вставить("СписокКассККМ", МассивКасс);
	КонецЕсли;
	Возврат Отборы;
КонецФункции

// Производит загрузку табличной части Продажи из данных ВИД с учетом установленных отборов
//
// Параметры:
//  Отборы - Произвольный - Отборы.
//  МассивКасс - Массив - Массив касс.
//
Процедура ЗагрузитьТаблицуПродаж(Отборы = Неопределено, МассивКасс) Экспорт
	Если Отборы = Неопределено Тогда
		Отборы = ПолучитьОтборыТаблицыПродажПоРеквизитам(МассивКасс);
	КонецЕсли;
	
	ТаблицаПродаж = Обработки.питЗагрузкаRKeeper7.ПолучитьТаблицуПродаж(Отборы);
	Продажи.Загрузить(ТаблицаПродаж);

	ТаблицаПродажМодификаторы = Обработки.питЗагрузкаRKeeper7.ПолучитьТаблицуПродажМодификаторов(Отборы);
	Модификаторы.Загрузить(ТаблицаПродажМодификаторы);
	
	// ТаблицаШК = Обработки.питЗагрузкаRKeeper7.ПолучитьТаблицуШК(Продажи.ВыгрузитьКолонку("НоменклатураУИД"));
	// ШтрихКоды.Загрузить(ТаблицаШК);
	
	// Заполним таблицу соответствий
	тмпТаблицаСоответствияИмяУИД = Обработки.питЗагрузкаRKeeper7.ПолучитьТаблицуСоответствий(ТаблицаПродаж, ТаблицаПродажМодификаторы);
	
	ТаблицаСоответствияИмяУИД.Загрузить(тмпТаблицаСоответствияИмяУИД);
	
КонецПроцедуры

// Получаем все незаполненные реквизиты соответствий
//
// Параметры:
//  РезультатПоПродажам - Произвольный - Результат по продажам.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьНезаполненныеСоответствия(РезультатПоПродажам) Экспорт
	СтруктураНезаполненныхСоответствий = Новый Структура;
	СтруктураНезаполненныхСоответствий.Вставить("КассыККМ", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("Номенклатура", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("Модификаторы", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("ТипыОплат", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("ВидыОплат", Новый Массив);
	СтруктураНезаполненныхСоответствий.Вставить("ПричиныОтменИСписаний", Новый Массив);
	
	Если Не ПроверкаКорректностиЗаполнения() Тогда
		Возврат СтруктураНезаполненныхСоответствий;
	КонецЕсли;
	
	// Если Продажи.Количество() = 0 Тогда
	// 	ЗагрузитьТаблицуПродаж();
	// КонецЕсли;
	
	Если Продажи.Количество() = 0 Тогда
		Возврат СтруктураНезаполненныхСоответствий;
	КонецЕсли;
	
	Выборка = РезультатПоПродажам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ОбходРезультатЗапросаПроверка(Выборка, СтруктураНезаполненныхСоответствий);
	
	Возврат СтруктураНезаполненныхСоответствий;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция проверяет корректность заполнения данных для загрузки
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПроверкаКорректностиЗаполнения()
	Результат = Истина;
	
	// Если Не ЗначениеЗаполнено(УчетнаяЗапись.НачалоУчета) Тогда
	// 	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена дата начала ведения учета R-Keeper.");
	// 	Результат = Ложь;
	// КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Происходит обход выборки из таблицы продаж RKeeper и создание документов ДПФ
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//
Процедура ОбходРезультатЗапроса(Выборка)
	Пока Выборка.Следующий() Цикл
		Если ПрерватьЗагрузку Тогда
			Прервать;
		КонецЕсли;
		
		Если Выборка.Группировка() = "НомерСмены" Тогда
			Результат = СоздатьДокументДПФ(Выборка, Выборка.ХозОперация);
			Если Результат = 2 Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Загрузка документов остановлена";
				Сообщение.Сообщить();
				ПрерватьЗагрузку = Истина;
			КонецЕсли;
			#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
			#КонецЕсли
		Иначе
			Выборка1 =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	        ОбходРезультатЗапроса(Выборка1);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Возвращает результат записи документа ДПФ по переданной выборке из таблицы продаж
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  ХозОПерация - Произвольный - Хоз о перация.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьДокументДПФ(Выборка, ХозОПерация)
	
	МенеджерОбъекта = Документы.питДанныеПродажФронта;
	
	// Если Выборка.ХозОперация = "Продажа" Тогда
		УИДЧека = ПривестиКСтандартамУИД(Выборка.ЧекУИД);
	// Иначе
	// 	УИДЧека = ПривестиКСтандартамУИД(Выборка.УдалениеУИД);
	// КонецЕсли;
	
	Попытка
		ДПФОбъект = ПолучитьОбъектПоИД(УИДЧека, МенеджерОбъекта, Ложь, Истина);
	Исключение
		Возврат 0;
	КонецПопытки;
	Если ДПФОбъект = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Чек № "+ Выборка.ЧекНомер + " от " + Выборка.ЧекДата + " не может быть загружен из-за отсутствия поля GUID";
		Сообщение.Сообщить();
		Возврат 0;
	КонецЕсли;
	Результат = ЗаполнитьДокументДПФ(Выборка, ДПФОбъект, ХозОПерация);
	
	
	// Если есть, получим УИд документа продажи
	Если Выборка.ХозОперация <> "Продажа" И ЗначениеЗаполнено(Выборка.ЧекУИД) И Результат = 0 Тогда
		Если ЗначениеЗаполнено(ДПФОбъект.ИДПродажи) Тогда
			УИДЧекаПродажи = ПривестиКСтандартамУИД(ДПФОбъект.ИДПродажи);
		Иначе
			УИДЧекаПродажи = ПривестиКСтандартамУИД(Строка(Новый УникальныйИдентификатор));
		КонецЕсли;
		ДПФОбъектПродажи = ПолучитьОбъектПоИД(УИДЧекаПродажи, МенеджерОбъекта, Ложь, Истина);
		Результат = Макс(ЗаполнитьДокументДПФ(Выборка, ДПФОбъектПродажи, "Продажа"), Результат);
		ДПФОбъект.ИДПродажи = Сред(УИДЧекаПродажи,2,36);
		
		Если Результат = 0 Тогда
			ЗафиксироватьЧекОбщепита(ДПФОбъектПродажи);
			// ВыполнитьЗаписьОбъекта(ДПФОбъектПродажи, Новый Структура);
		КонецЕсли;
		
	КонецЕсли;
	Если Результат = 1 ИЛИ Результат = 2 Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Загрузка < " + ДПФОбъект + "> отменена";
		Сообщение.Сообщить();
	Иначе 
		ЗафиксироватьЧекОбщепита(ДПФОбъект);
		// ВыполнитьЗаписьОбъекта(ДПФОбъект, Новый Структура);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Функция - Заполнить документ дпф.
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  ДПФОбъект - Произвольный - Дпф объект.
//  ХозОПерация - Произвольный - Хоз о перация.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьДокументДПФ(Выборка, ДПФОбъект, ХозОПерация)
	СтрутураЭлементаRKeeper = Новый Структура;
	СтрутураЭлементаRKeeper.Вставить("УИД");
	СтрутураЭлементаRKeeper.Вставить("Наименование");
	СтрутураЭлементаRKeeper.Вставить("Код");
	
	Результат = 0;
	
	// По таблице соответствия найдем параметры
	Если ЗначениеЗаполнено(Выборка.ЧекУИД) Тогда
		СтрокиСоответствия = ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных, УИД", "пиДанныеПродажФронта", Выборка.ЧекУИД));
		Если СтрокиСоответствия.Количество() > 0 Тогда
			Если ХозОперация = "Продажа" Тогда
				ДПФОбъект.ПометкаУдаления = НЕ (СтрокиСоответствия[0].ПометкаУдаления=0);
			КонецЕсли;
			// Номер чека
			ДПФОбъект.НомерЧека = СтрокиСоответствия[0].Код;
		КонецЕсли;
	КонецЕсли;
	
	// Если есть, получим УИд документа продажи
	Если ХозОперация <> "Продажа" И ЗначениеЗаполнено(Выборка.ЧекУИД) Тогда
		ДПФОбъект.ДатаЧека = Дата(Выборка.ЧекДата);
	КонецЕсли;
	
	ДПФОбъект.Товары.Очистить();
	ДПФОбъект.Оплаты.Очистить();
	ДПФОбъект.Модификаторы.Очистить();
	
	// предопределенные значения
	ДПФОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Если ХозОперация = "Продажа" Тогда
		ДПФОбъект.Дата = Дата(Выборка.ЧекДата);
		ДПФОбъект.ДатаЧека = Дата(Выборка.ЧекДата);
	Иначе
		Если ЗначениеЗаполнено(Выборка.ЧекДата) И Выборка.ЧекДата >= '19000101' Тогда
			ДПФОбъект.Дата = Дата(Выборка.ЧекДата);
		Иначе
			ДПФОбъект.Дата = Дата(Выборка.ДатаСмены);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДПФОбъект.Дата) Тогда
		ДПФОбъект.Дата = ТекущаяДата();
	КонецЕсли;
	СтрутураЭлементаRKeeper.Вставить("Дата",ДПФОбъект.Дата); 
	
	Если ДПФОбъект.ЭтоНовый() Или Не ЗначениеЗаполнено(ДПФОбъект.Номер) Тогда
		ДПФОбъект.УстановитьНовыйНомер();
	КонецЕсли; 
	
	// Тип цен
	ДПФОбъект.ТипЦен = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнойТипЦенПродажи");
	
	// Чеки Ркипера всегда включают НДС
	ДПФОбъект.СуммаВключаетНДС = Истина;

	// Касса
	СтрутураЭлементаRKeeper.УИД = Выборка.КассаУИД;
	Результат = Макс(ЗаполнитьПолеПоСоответствию(ДПФОбъект.КассаККМ,СтрутураЭлементаRKeeper, 0 ),Результат);
	
	// организация, подразделение
	РеквизитыКассыККМ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДПФОбъект.КассаККМ, "питКассовыйУзел, Владелец, Подразделение");
	ДПФОбъект.КассовыйУзел = РеквизитыКассыККМ.питКассовыйУзел;
	ДПФОбъект.Организация = ?(Не ЗначениеЗаполнено(РеквизитыКассыККМ.Владелец), питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация"), РеквизитыКассыККМ.Владелец);
	ДПФОбъект.Подразделение = ?(Не ЗначениеЗаполнено(РеквизитыКассыККМ.Подразделение),питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации"), РеквизитыКассыККМ.Подразделение);
	
	СтрутураЭлементаRKeeper.Вставить("Подразделение",ДПФОбъект.Подразделение); 
	СтрутураЭлементаRKeeper.Вставить("Организация",ДПФОбъект.Организация); 

	// Валюта
	СтрутураЭлементаRKeeper.Вставить("Значение", Константы.ВалютаРегламентированногоУчета.Получить());
	Результат = Макс(ЗаполнитьПолеПоСоответствию(ДПФОбъект.ВалютаДокумента,СтрутураЭлементаRKeeper, 3 ), Результат);
	ДПФОбъект.КурсДокумента   = 1;
	Попытка
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаРегламентированногоУчета.Получить(), ДПФОбъект.Дата);
		ДПФОбъект.КурсДокумента = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
	Исключение
	КонецПопытки;
	
	СтрутураЭлементаRKeeper.Вставить("Валюта",ДПФОбъект.ВалютаДокумента); 
	
	
	// НомерСмены
	СтрутураЭлементаRKeeper.Вставить("Значение", Выборка.НомерСмены);
	Результат =  Макс(ЗаполнитьПолеПоСоответствию(ДПФОбъект.НомерСмены,СтрутураЭлементаRKeeper, 3 ), Результат);
	
	// Дата смены
	СтрутураЭлементаRKeeper.Вставить("Значение", Выборка.ДатаСмены);
	Результат =  Макс(ЗаполнитьПолеПоСоответствию(ДПФОбъект.ДатаСмены,СтрутураЭлементаRKeeper, 3 ), Результат);
	
	// хоз операция
	СтрутураЭлементаRKeeper.УИД = "";
	СтрутураЭлементаRKeeper.Наименование = ХозОперация;
	Если ХозОперация = "Продажа" Тогда
		ДПФОбъект.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаПродажа;
	ИначеЕсли ВидЗагрузкиУдалений = 0 Тогда
		ДПФОбъект.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаОтмена;
	Иначе
		ДПФОбъект.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаВозврат;
	КонецЕсли;
	
	ВыборкаНоменклатура = Выборка.Выбрать();
	Пока ВыборкаНоменклатура.Следующий() Цикл
		СтрутураЭлементаRKeeper.Вставить("ЕдиницаИзмерения", ВыборкаНоменклатура.ЕдиницаИзмерения);
		Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
			Если ЗначениеЗаполнено(ВыборкаНоменклатура.НДС) Тогда
				Попытка
					СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС["НДС"+ВыборкаНоменклатура.НДС]);
				Исключение
					ТекущаяДата = ТекущаяДатаСеанса();
					Если ТекущаяДата >= '20190101' Тогда
						СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС20);
					ИначеЕсли ТекущаяДата >= '20260101' Тогда
						СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС22);
					КонецЕсли;
				КонецПопытки;
				
			Иначе
				СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.БезНДС);
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(ВыборкаНоменклатура.НДС) Тогда
				Попытка
					СтавкаЧислом = Число(ВыборкаНоменклатура.НДС);
				Исключение
					ТекущаяДата = ТекущаяДатаСеанса();
					Если ТекущаяДата >= '20190101' Тогда
						СтавкаЧислом = 20;
					ИначеЕсли ТекущаяДата >= '20260101' Тогда
						СтавкаЧислом = 22;
					КонецЕсли;
				КонецПопытки;
				СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(СтавкаЧислом);
			Иначе
				СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу();
			КонецЕсли;
		КонецЕсли;
		СтрутураЭлементаRKeeper.Вставить("СтавкаНДС", СтавкаНДС);
		
		// бывает, что приходит пустой УИД номенклатуры
		Если Не ЗначениеЗаполнено(ВыборкаНоменклатура.НоменклатураУИД) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаТовары = ДПФОбъект.Товары.Добавить();
		// Номенклатура
		
		Если ВыборкаНоменклатура.ЭтоКомбоБлюдо Тогда
			СтрутураЭлементаRKeeper.Вставить("ВидНоменклатуры", Перечисления.питВидыНоменклатуры.БизнесЛанч);
			
		КонецЕсли;
		СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.НоменклатураУИД;
		Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.Номенклатура,СтрутураЭлементаRKeeper, 0 ), Результат); 
		// ДПФОбъект.ОбработкаРеквизита("Товары.Номенклатура",НоваяСтрокаТовары);
		
		// Коэффициент
		СтрутураЭлементаRKeeper.Вставить("Значение", 1);
		Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.Коэффициент,СтрутураЭлементаRKeeper, 3 ), Результат); 
		
		// Единица
		НоваяСтрокаТовары.Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрокаТовары.Номенклатура, "ЕдиницаИзмерения"); 
		
		// Количество
		СтрутураЭлементаRKeeper.Вставить("Значение", ВыборкаНоменклатура.Количество);
		Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.КоличествоУпаковок,СтрутураЭлементаRKeeper, 3 ), Результат);
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "");
		НоваяСтрокаТоварыСтруктура = Новый Структура("Номенклатура, Упаковка, Количество, КоличествоУпаковок");
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТоварыСтруктура, НоваяСтрокаТовары);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрокаТоварыСтруктура, СтруктураДействий, КэшированныеЗначения);
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары, НоваяСтрокаТоварыСтруктура);
		
		// Сумма
		СтрутураЭлементаRKeeper.Вставить("Значение", ВыборкаНоменклатура.СуммаВсего+ВыборкаНоменклатура.СуммаСкидки);
		Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.Сумма,СтрутураЭлементаRKeeper, 3 ), Результат);
		НоваяСтрокаТовары.Цена = ?(НоваяСтрокаТовары.Количество = 0,0,НоваяСтрокаТовары.Сумма / НоваяСтрокаТовары.Количество);
		
		// Сумма скидки
		СтрутураЭлементаRKeeper.Вставить("Значение", ВыборкаНоменклатура.СуммаСкидки);
		Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.СуммаСкидки,СтрутураЭлементаRKeeper, 3 ), Результат);
		НоваяСтрокаТовары.ПроцентСкидки = ?(НоваяСтрокаТовары.Сумма=0, 0, Окр(НоваяСтрокаТовары.СуммаСкидки * 100 / НоваяСтрокаТовары.Сумма, 2));
		
		
		// Дата отмены
		СтрутураЭлементаRKeeper.Вставить("Значение", ВыборкаНоменклатура.ДатаОтмены);
		Результат =  Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.ДатаОтмены,СтрутураЭлементаRKeeper, 3 ), Результат);
		
		// место печати
		Если ЗначениеЗаполнено(ДПФОбъект.КассаККМ) Тогда
			УзелОбмена = РеквизитыКассыККМ.питКассовыйУзел;
			
			МестоПечати = ПолучитьМестоПечатиДляНоменклатуры(НоваяСтрокаТовары.Номенклатура, УзелОбмена);
			
			Если ЗначениеЗаполнено(МестоПечати) Тогда
				СтрутураЭлементаRKeeper.Вставить("Значение", МестоПечати);
				Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.МестоПечати, СтрутураЭлементаRKeeper, 3 ), Результат);
			КонецЕсли;
		КонецЕсли;
		
		// НДС
		СтрутураЭлементаRKeeper.Вставить("Значение", СтавкаНДС);
		Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.СтавкаНДС, СтрутураЭлементаRKeeper, 3 ), Результат);
		
		// ДПФОбъект.ОбработкаРеквизита("Товары.СтавкаНДС",НоваяСтрокаТовары);
		// Сумма НДС
		СтрутураЭлементаRKeeper.Вставить("Значение", ВыборкаНоменклатура.СуммаНДС);
		Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.СуммаНДС,СтрутураЭлементаRKeeper, 3 ), Результат);
		
		// Пересчитаем Сумму НДС, т.к. возможно ставка ндс изменялась.
		НоваяСтрокаТовары.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС((НоваяСтрокаТовары.Сумма - НоваяСтрокаТовары.СуммаСкидки),
			НоваяСтрокаТовары.СтавкаНДС, Истина);
		
		
		
		// Флаг со списанием
		Если ЗначениеЗаполнено(ВыборкаНоменклатура.НастройкиПричинОтменСписаний) Тогда
			БитоваяНастройка = питОбщегоНазначения.ПреобразоватьВСистемуСчисления(ВыборкаНоменклатура.НастройкиПричинОтменСписаний,"0123456789","01");
			// Бит 1 - отвечает за флаг "со списанием"
			ЗначениеБита1 = Сред(БитоваяНастройка,СтрДлина(БитоваяНастройка),1);
			СтрутураЭлементаRKeeper.Вставить("Значение", ЗначениеБита1 = "1");
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.СоСписанием,СтрутураЭлементаRKeeper, 3 ), Результат);
			
			
			ЗначениеБита2 = Сред(БитоваяНастройка,СтрДлина(БитоваяНастройка)-2,1);
		КонецЕсли;
		СтрутураЭлементаRKeeper.Вставить("СоСписанием", НоваяСтрокаТовары.СоСписанием);
		
		Если ХозОперация <> "Продажа" Тогда
			// причина отмены
			СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.ПричинаОтменСписанийУИД;
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.ПричинаОтмены,СтрутураЭлементаRKeeper, 0 ), Результат); 
			
			ЗначениеСоСписанием = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрокаТовары.ПричинаОтмены, "СоСписанием");
			Если НоваяСтрокаТовары.СоСписанием <> ЗначениеСоСписанием Тогда
				СтрутураЭлементаRKeeper.Вставить("Значение", ЗначениеСоСписанием);
				Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаТовары.СоСписанием,СтрутураЭлементаRKeeper, 3 ), Результат);
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Настройка <Со списанием> в данных продаж отлична от соответствующей настройки в справочнике причин списаний. Для синхронизации данных установить соответствующий флаг в параметрах загрузки объектов";
				Сообщение.Сообщить();
			КонецЕсли;
		КонецЕсли;
		
		// МОДИФИКАТОРЫ
		МодификаторыНоменклатуры = Модификаторы.НайтиСтроки(Новый Структура("НоменклатураУИД, ЧекУИД",ВыборкаНоменклатура.НоменклатураУИД, ВыборкаНоменклатура.ЧекУИД));
		Для Каждого СтрокаМодификатора Из МодификаторыНоменклатуры Цикл
			
			НоваяСтрокаМодификаторов = ДПФОбъект.Модификаторы.Добавить();
			
			СтрутураЭлементаRKeeper.Вставить("ЦенаМодификатора", ?(СтрокаМодификатора.Количество = 0,0,СтрокаМодификатора.Сумма / СтрокаМодификатора.Количество));
			// модификатор
			СтрутураЭлементаRKeeper.УИД = СтрокаМодификатора.МодификаторУИД;
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.Модификатор,СтрутураЭлементаRKeeper, 0 ), Результат); 
			
			НоваяСтрокаМодификаторов.Номенклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрокаМодификаторов.Модификатор, "ДопНоменклатура");
			НоваяСтрокаМодификаторов.УпаковкаНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрокаМодификаторов.Модификатор, "ЕдиницаИзмеренияНоменклатуры");
			// Подставляем цену модификатора
			НоваяСтрокаМодификаторов.Цена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрокаМодификаторов.Модификатор, "Цена");
			// Если в карточке модификатора цена не указана, тогда берем ее из регистра сведений Цены
			// для дополнительной номенклатуры модификатора и пересчитываем
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаМодификаторов.Цена) Тогда
					// Заполнение цены зависит от розничности операции.
//   ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПродажиТабЧасти(НоваяСтрокаМодификаторов, ДПФОбъект,"Модификаторы",
// ДПФОбъект.Метаданные()); .
			КонецЕсли;
			НоваяСтрокаМодификаторов.Коэффициент                  = 1;
			
			
			// основная номенклатура
			СтрутураЭлементаRKeeper.УИД = СтрокаМодификатора.НоменклатураУИД;
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.НоменклатураОсновнойПозиции,СтрутураЭлементаRKeeper, 0 ), Результат); 
			
			// Количество модификатора
			СтрутураЭлементаRKeeper.Вставить("Значение", СтрокаМодификатора.Количество);
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.Количество,СтрутураЭлементаRKeeper, 3 ), Результат);
			
			// Количество и количество упаковок номенклатуры
			НоваяСтрокаМодификаторов.КоличествоНоменклатуры			= НоваяСтрокаМодификаторов.Количество * НоваяСтрокаМодификаторов.Модификатор.КоличествоНоменклатуры;
			НоваяСтрокаМодификаторов.КоличествоУпаковокНоменклатуры	= НоваяСтрокаМодификаторов.Количество * НоваяСтрокаМодификаторов.Модификатор.КоличествоУпаковокНоменклатуры;
			
			// Сумма
			СтрутураЭлементаRKeeper.Вставить("Значение", СтрокаМодификатора.Сумма);
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаМодификаторов.Сумма,СтрутураЭлементаRKeeper, 3 ), Результат);
			
		КонецЦикла;
		
		// Если ХозОперация = "Продажа" Тогда
			// ОПЛАТЫ
			НоваяСтрокаОплаты = ДПФОбъект.Оплаты.Добавить();
			
			// для Вида оплаты определим тип оплаты
			СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.ТипОплатыУИД;
			ТипОплаты = Перечисления.питТипыОплат.ПустаяСсылка();
			ЗаполнитьПолеПоСоответствию(ТипОплаты,СтрутураЭлементаRKeeper, 0 );
			СтрутураЭлементаRKeeper.Вставить("ТипОплаты", ТипОплаты);

			// вид оплаты
			СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.ВидОплатыУИД;
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаОплаты.ВидОплаты,СтрутураЭлементаRKeeper, 0 ), Результат); 
			НоваяСтрокаОплаты.Фискальный = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрокаОплаты.ВидОплаты, "питФискальный");
			
			// сумма оплаты
			СтрутураЭлементаRKeeper.Вставить("Значение", ВыборкаНоменклатура.СуммаОплаты);
			Результат = Макс(ЗаполнитьПолеПоСоответствию(НоваяСтрокаОплаты.СуммаОплаты,СтрутураЭлементаRKeeper, 3 ), Результат);
		// КонецЕсли;
		
	КонецЦикла;
	// Свернем таблицы оплат и товаров
	ДПФОбъект.Оплаты.Свернуть("ВидОплаты, Фискальный, Карточка","СуммаОплаты, Сдача");
	ДПФОбъект.Товары.Свернуть("Номенклатура,Упаковка,Коэффициент,
	|СтавкаНДС,МестоПечати,ДатаОтмены,СоСписанием,ПричинаОтмены, Цена",
	"Количество,КоличествоУпаковок,Сумма,СуммаСкидки,СуммаНДС");
	ДПФОбъект.Модификаторы.Свернуть("Модификатор,Коэффициент,НоменклатураОсновнойПозиции,Номенклатура,УпаковкаНоменклатуры,Цена",
	"Количество,КоличествоУпаковокНоменклатуры,КоличествоНоменклатуры,Сумма");
	
	// Рассчитаем суммы
	ДПФОбъект.РасчетСуммДокумента();
	
	Возврат Результат;
КонецФункции

// Выполняет запись полученного при чтении объекта
//  Параметры
//
// Параметры:
//  ЭлементДанных - Произвольный - Элемент данных.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВыполнитьЗаписьОбъекта(ЭлементДанных, ДопПараметры)
		
	Попытка
		
		ЭлементДанных.ОбменДанными.Загрузка = ИСТИНА;
		Попытка
			ЭлементДанных.ОбменДанными.Отправитель = ДопПараметры.Отправитель;
		Исключение КонецПопытки;
		
		Попытка
			Если ЭлементДанных.Предопределенный И ЭлементДанных.ПометкаУдаления Тогда
				ЭлементДанных.ПометкаУдаления = Ложь;
			КонецЕсли; 
		Исключение КонецПопытки;
		
		// Проверка регистрации
		ЭлементДанных.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		ЭлементДанных.ДополнительныеСвойства.Вставить("Загрузка", Истина);
		ЭлементДанных.Записать();
		
		// только сейчас имеем право сказать, что объект получен
		ЭлементДанныхЗаписан = Неопределено;
		ЭлементДанных.ДополнительныеСвойства.Свойство("ЭлементДанныхЗаписан", ЭлементДанныхЗаписан);
		Если ЭлементДанныхЗаписан <> Истина Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Объект получен: " + ЭлементДанных;
			Сообщение.Сообщить();
			
			ЭлементДанных.ДополнительныеСвойства.Вставить("ЭлементДанныхЗаписан", Истина);
			
			МассивОбъектов.Добавить(ЭлементДанных.Ссылка);
			МассивОбъектовНаРегистрацию.Добавить(ЭлементДанных.Ссылка);
			
		КонецЕсли; 
		
	Исключение
		
		// Необходимо приостановить обмен с ошибкой,
		// иначе произойдет увеличение номера сообщения обмена и при отправке ответа
		// данные с ошибкой больше в данный узел отправлены не будут.
		ТекстОшибки = "Ошибка получения объекта: " + ЭлементДанных + ": " + ОписаниеОшибки();
				
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "екстОшибк";
		Сообщение.Сообщить();
		
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
КонецФункции // ВыполнитьЗаписьОбъекта()

// Функция - Привести к стандартам уид.
//
// Параметры:
//  Знач УидЧека - Произвольный - Знач уид чека.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПривестиКСтандартамУИД(Знач УидЧека)
	ШаблонУИД = Строка(Новый УникальныйИдентификатор);
	
	УидСтрока = УидЧека;
	УидСтрока = СтрЗаменить(УидСтрока, "-", "");
	УидСтрока = СтрЗаменить(УидСтрока, "{", "");
	УидСтрока = СтрЗаменить(УидСтрока, "}", "");
	
	УидИзмененный = "";
	
	Для КолЗн = 0 По 4 Цикл
		НомерСимволаШаблон = Найти(ШаблонУИД,"-");
		Если НомерСимволаШаблон = 0 Тогда
			НомерСимволаШаблон = СтрДлина(ШаблонУИД)+1;
		КонецЕсли;
		
		ЧастьУИД = Лев(УидСтрока, НомерСимволаШаблон-1);
		
		ДлинаЧастиУИД = СтрДлина(ЧастьУИД);
		Для Инд = 1 По (НомерСимволаШаблон - ДлинаЧастиУИД - 1) Цикл
			ЧастьУИД = ЧастьУИД + "0";
		КонецЦикла;
		
		ШаблонУИД = Сред(ШаблонУИД, НомерСимволаШаблон + 1);
		УидСтрока = Сред(УидСтрока, НомерСимволаШаблон);
		
		УидИзмененный = УидИзмененный + ЧастьУИД + "-";
	КонецЦикла;
	
	
	УидИзмененный = "{" + Лев(УидИзмененный, СтрДлина(УидИзмененный)-1)  + "}";
	Возврат УидИзмененный;
КонецФункции

// Функция осуществляет поиск в Кэше маршрутизации печати ближайшего унаследованного
//  места печати для номенклатуры для заданного зала.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  КассовыйУзел - Произвольный - Кассовый узел.
//  Зал - Произвольный - Зал.
//  ВидМеню - Произвольный - Вид меню.
//
// Возвращаемое значение:
//  УнаследованноеМестоПечати - Строка. Полученнное место печати.
Функция ПолучитьМестоПечатиДляНоменклатуры(Номенклатура, КассовыйУзел, Зал = Неопределено, ВидМеню = Неопределено)
	
	Если ТаблицаНоменклатурныхПриоритетов = Неопределено Тогда
		// ДЛя определения места продажи проинициализируем таблицу номенклатурных приоритетов
		ТаблицаНоменклатурныхПриоритетов = ПолучитьТаблицуНоменклатурныхПриоритетов();
	КонецЕсли;

	УнаследованноеМестоПечати = Справочники.питМестаПечати.ПустаяСсылка();
	
	// Номенклатуру необходимо преобразовать в список, куда войдет она сама и все ее родители.
	тмпНоменклатура = Номенклатура;
	СписокНоменклатура = Новый СписокЗначений;
	Пока тмпНоменклатура <> Справочники.Номенклатура.ПустаяСсылка() Цикл
		СписокНоменклатура.Добавить(тмпНоменклатура);
		тмпНоменклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(тмпНоменклатура, "Родитель");
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНоменклатурныхПриоритетов.Ссылка,
	|	ТаблицаНоменклатурныхПриоритетов.Приоритет
	|ПОМЕСТИТЬ ТЗНомПриоритетов
	|ИЗ
	|	&ТаблицаНоменклатурныхПриоритетов КАК ТаблицаНоменклатурныхПриоритетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОпределениеПриоритетов.Принтер,
	|	ОпределениеПриоритетов.ПриоритетНоменклатура + ОпределениеПриоритетов.ПриоритетВидМеню + ОпределениеПриоритетов.ПриоритетЗал КАК ПриоритетСумма,
	|	ОпределениеПриоритетов.ПриоритетНоменклатура КАК ПриоритетНоменклатура,
	|	ОпределениеПриоритетов.ПриоритетВидМеню КАК ПриоритетВидМеню,
	|	ОпределениеПриоритетов.ПриоритетЗал КАК ПриоритетЗал
	|ИЗ
	|	(ВЫБРАТЬ
	|		МаршрутизацияПечати.Номенклатура КАК Номенклатура,
	|		МаршрутизацияПечати.МестоПечати КАК Принтер,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.Номенклатура.ЭтоГруппа
	|				ТОГДА ТЗНомПриоритетов.Приоритет
	|			ИНАЧЕ ТЗНомПриоритетов.Приоритет + 1
	|		КОНЕЦ КАК ПриоритетНоменклатура,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.ВидМеню = &ПустойВидМеню
	|				ТОГДА 1
	|			ИНАЧЕ 2
	|		КОНЕЦ КАК ПриоритетВидМеню,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.Зал = &ПустойЗал
	|				ТОГДА 1
	|			ИНАЧЕ 2
	|		КОНЕЦ КАК ПриоритетЗал
	|	ИЗ
	|		РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
	|			ЛЕВОЕ СОЕДИНЕНИЕ ТЗНомПриоритетов КАК ТЗНомПриоритетов
	|			ПО (ВЫБОР
	|					КОГДА МаршрутизацияПечати.Номенклатура.ЭтоГруппа
	|						ТОГДА МаршрутизацияПечати.Номенклатура = ТЗНомПриоритетов.Ссылка
	|					ИНАЧЕ МаршрутизацияПечати.Номенклатура.Родитель = ТЗНомПриоритетов.Ссылка
	|				КОНЕЦ)
	|	ГДЕ
	|		(МаршрутизацияПечати.Номенклатура В (&Номенклатура)
	|				ИЛИ МаршрутизацияПечати.Номенклатура = &ПустаяНоменклатура)
	|		И (МаршрутизацияПечати.ВидМеню = &ВидМеню ИЛИ &ВидМеню = НЕОПРЕДЕЛЕНО
	|				ИЛИ МаршрутизацияПечати.ВидМеню = &ПустойВидМеню)
	|		И (МаршрутизацияПечати.Зал = &Зал ИЛИ &Зал = НЕОПРЕДЕЛЕНО
	|				ИЛИ МаршрутизацияПечати.Зал = &ПустойЗал)
	|		И МаршрутизацияПечати.КассовыйУзел = &Узел) КАК ОпределениеПриоритетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетСумма УБЫВ,
	|	ПриоритетНоменклатура УБЫВ,
	|	ПриоритетВидМеню УБЫВ,
	|	ПриоритетЗал УБЫВ";
	
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатура);
	Запрос.УстановитьПараметр("ВидМеню", ВидМеню);
	Запрос.УстановитьПараметр("Зал", Зал);
	Запрос.УстановитьПараметр("Узел", КассовыйУзел);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойВидМеню", Справочники.питВидыМеню.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойЗал", Справочники.питЗалы.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТаблицаНоменклатурныхПриоритетов",ТаблицаНоменклатурныхПриоритетов);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		УнаследованноеМестоПечати = Выборка.Принтер;
	КонецЕсли;
	
	Возврат УнаследованноеМестоПечати;
	
КонецФункции // ПолучитьУнаследованноеМестоПечатиДляНоменклатуры()

// Функция - Получить таблицу номенклатурных приоритетов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуНоменклатурныхПриоритетов()
	
	// Получение всех номенклатурных групп.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	0 КАК Приоритет
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа";
	
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
	
	ТекСтрока = ТаблицаЗначений.Добавить();
	ТекСтрока.Ссылка    = Справочники.Номенклатура.ПустаяСсылка();
	ТекСтрока.Приоритет = 0;
	
	Для Каждого ТекСтрока Из ТаблицаЗначений Цикл
		
		тмпПриоритет    = 1;
		тмпНоменклатура = ТекСтрока.Ссылка;
		
		Пока тмпНоменклатура <> Справочники.Номенклатура.ПустаяСсылка() Цикл
			тмпНоменклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(тмпНоменклатура, "Родитель");
			тмпПриоритет    = тмпПриоритет + 1;
		КонецЦикла;
		
		ТекСтрока.Приоритет = тмпПриоритет;
		
	КонецЦикла;
	
	Возврат ТаблицаЗначений;
	
КонецФункции

// СОЗДАНИЕ И ЗАПОЛНЕНИЕ ОБЪЕКТНЫХ СУЩНОСТЕЙ

// Возвращает созданный / обновленный объект дерева метаданных по переданным параметрам
//
// Параметры:
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  СтрутураЭлементаRKeeper - Произвольный - Струтура элемента r keeper.
//  Настройки - Произвольный - Настройки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьОбновитьОбъект(ИмяМетаданных, СтрутураЭлементаRKeeper, Настройки)
	// Попробуем найти по наименованию
	Если СтрутураЭлементаRKeeper.Свойство("Ссылка1С") И ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Ссылка1С) Тогда
		СправочникСсылка = СтрутураЭлементаRKeeper.Ссылка1С;
	Иначе
		Попытка
			СправочникСсылка = Справочники[ИмяМетаданных].НайтиПоНаименованию(СтрутураЭлементаRKeeper.Наименование, Истина);
			// СправочникСсылка = Справочники[ИмяМетаданных].ПустаяСсылка();
		Исключение
			СправочникСсылка = Перечисления[ИмяМетаданных].ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	
	Если (СправочникСсылка.Пустая() И Настройки.Создавать) Или НЕ СправочникСсылка.Пустая() И Настройки.Обновлять Тогда
		// Если есть такой же удаленный, тогда изменим в нем имя
		Если НЕ СправочникСсылка.Пустая() И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СправочникСсылка, "ПометкаУдаления") Тогда
			СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
			СправочникОбъект.Наименование = СправочникОбъект.Наименование + " (удаленный)";
			Попытка
				СправочникОбъект.Записать();
			Исключение
			КонецПопытки;
			
			СтрутураЭлементаRKeeper.Вставить("Код","");
			СправочникСсылка = Справочники[ИмяМетаданных].ПустаяСсылка();
		КонецЕсли;
		
		// Создаем элемент
		Если СправочникСсылка.Пустая() Тогда
			СправочникОбъект = Справочники[ИмяМетаданных].СоздатьЭлемент();
		Иначе
			СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
		КонецЕсли;
		Обработки.питЗагрузкаRKeeper7.УстановитьОбщиеРеквизиты(СправочникОбъект, СтрутураЭлементаRKeeper, Настройки);
		
		Если ИмяМетаданных = "Номенклатура" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектНоменклатура(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "питМодификаторы" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектМодификаторы(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "ПодразделенияОрганизаций" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектПодразделения(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "Организации" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектОрганизации(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "питВидыОплатОрганизаций" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектВидыОплат(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "КассыККМ" Тогда
			Возврат СправочникСсылка;
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектКассыККМ(СправочникОбъект, СтрутураЭлементаRKeeper);
		// ИначеЕсли ИмяМетаданных = "ХозОперации" Тогда
		// 	Обработки.ЗагрузкаRKeeper7.ПрочитатьОбъектХозоперации(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "Валюты" Тогда
			Возврат СправочникСсылка;
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектВалюты(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "КлассификаторЕдиницИзмерения" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектЕдиницыИзмерения(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "СкладыКомпании" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектСкладыКомпании(СправочникОбъект, СтрутураЭлементаRKeeper);
		ИначеЕсли ИмяМетаданных = "питПричиныОтменИСписаний" Тогда
			Обработки.питЗагрузкаRKeeper7.ПрочитатьОбъектПричиныОтменИСписаний(СправочникОбъект, СтрутураЭлементаRKeeper, Настройки);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		
		Попытка
			СправочникОбъект.Записать();
		Исключение
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "писаниеОшибки(";
			Сообщение.Сообщить();
		КонецПопытки;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		СправочникСсылка = СправочникОбъект.Ссылка;
		
		// После записи элемента
		Если ИмяМетаданных = "Номенклатура" Тогда
			Обработки.питЗагрузкаRKeeper7.НоменклатураПослеЗаписи(СправочникСсылка, СтрутураЭлементаRKeeper);
		КонецЕсли;
		
	КонецЕсли;
	
	// Добавим строку соответствия
	Если ЗначениеЗаполнено(СправочникСсылка) Тогда
		ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовRKeeper.ПолучитьОбъектПоМетаданным(ИмяМетаданных, КэшТаблицаПВХ);
		
		// Отбор по учетной записи
		УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
		Если ТипСоответствий = 1 Тогда
			УчетнаяЗаписьОтбор = УчетнаяЗапись;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.питСоответствияОбъектовRKeeper.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СсылкаRKeeper.Установить(СтрутураЭлементаRKeeper.УИД);
		НаборЗаписей.Отбор.ТипОбъекта.Установить(ТипПВХ);
		
		// Отбор по учетной записи
		НаборЗаписей.Отбор.УчетнаяЗапись.Установить(УчетнаяЗаписьОтбор);
		
		НаборЗаписей.Прочитать();
		
		ДанныеИзменены = Ложь;
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись =  НаборЗаписей.Добавить();
		Иначе
			НоваяЗапись =  НаборЗаписей[0];
		КонецЕсли;
		
		// Отбор по учетной записи
		НоваяЗапись.УчетнаяЗапись = УчетнаяЗаписьОтбор;
		
		НоваяЗапись.СсылкаRKeeper = СтрутураЭлементаRKeeper.УИД;
		НоваяЗапись.ТипОбъекта = ТипПВХ;
		НоваяЗапись.Ссылка1С = СправочникСсылка;
		
		НоваяЗапись.ИмяRKeeper = СтрутураЭлементаRKeeper.Наименование;
		НоваяЗапись.КодRKeeper = СтрутураЭлементаRKeeper.Код;
		
		Если СтрутураЭлементаRKeeper.Свойство("Родитель") Тогда
			НоваяЗапись.РодительRKeeper = СтрутураЭлементаRKeeper.Родитель;
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	
	// возвращаем созданный элемент
	Возврат СправочникСсылка;
КонецФункции

// Заполняет переданный реквизит по одному из указанных алгоритмов заполнения
//
// Параметры:
//  Реквизит - Произвольный - Реквизит.
//  СтрутураЭлементаRKeeper - Произвольный - Струтура элемента r keeper.
//  ВидПоиска - Произвольный - Вид поиска.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьПолеПоСоответствию(Реквизит,СтрутураЭлементаRKeeper,ВидПоиска)
	Если НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Реквизит)) Тогда
		Реквизит = СтрутураЭлементаRKeeper.Значение;
		
		Возврат 0;
	Иначе
		ИмяМетаданных = Реквизит.Метаданные().Имя; 
		
		ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовRKeeper.ПолучитьОбъектПоМетаданным(ИмяМетаданных, КэшТаблицаПВХ);
		СтрокаНастроек = ПараметрыЗагрузки.Найти(ТипПВХ,"ТипОбъекта");
		Если СтрокаНастроек = Неопределено Тогда
			СтрокаНастроек = ТипПВХ;
		КонецЕсли;
		
		// Установим текущий режим обработки ошибок
		РежимОшибкиЗагрузки = СтрокаНастроек.ОбработкаОшибок;
		
		// По регистру соответствий
		Если ВидПоиска = 0 И НЕ ТипПВХ.Пустая() Тогда
			
			// По таблице соответствия найдем наименование и код
			Если ЗначениеЗаполнено(СтрутураЭлементаRKeeper.УИД) Тогда
				СтрокиСоответствия = ТаблицаСоответствияИмяУИД.НайтиСтроки(Новый Структура("ИмяМетаданных, УИД", ИмяМетаданных, СтрутураЭлементаRKeeper.УИД));
				Если СтрокиСоответствия.Количество() > 0 Тогда
					СтрутураЭлементаRKeeper.Наименование = СтрокиСоответствия[0].Наименование;
					СтрутураЭлементаRKeeper.Код = СтрокиСоответствия[0].Код;
				КонецЕсли;
			Иначе
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Для <"+ СтрутураЭлементаRKeeper.Наименование + "> (тип объекта - <"+ТипПВХ.Наименование+">) не задано занчение идентификатора";
				Сообщение.Сообщить();
				Возврат РежимОшибкиЗагрузки;
			КонецЕсли;
			
			ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper, ИмяМетаданных);
			Реквизит = СоздатьОбновитьОбъект(ИмяМетаданных,СтрутураЭлементаRKeeper, СтрокаНастроек);
			
			// Если Нашли реквизит, добавм его в строку соответствия
			Если СтрокиСоответствия.Количество() > 0 И ЗначениеЗаполнено(Реквизит) Тогда
				СтрокиСоответствия[0].Ссылка1С = Реквизит;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Реквизит) И ЗначениеЗаполнено(СтрутураЭлементаRKeeper.УИД) Тогда
				Если РежимОшибкиЗагрузки > 0 Тогда
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Реквизит " + Реквизит.Метаданные().Синоним + " не смог быть получен";
					Сообщение.Сообщить();
				КонецЕсли;
				Возврат РежимОшибкиЗагрузки;
			Иначе
				Возврат 0;
			КонецЕсли;
		// По наименованию
		ИначеЕсли ВидПоиска = 1 Тогда
			Реквизит = Справочники[ИмяМетаданных].НайтиПоНаименованию(СтрутураЭлементаRKeeper.Наименование, Истина);
			Если Не ЗначениеЗаполнено(Реквизит) И ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Наименование) Тогда
				Если РежимОшибкиЗагрузки > 0 Тогда
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Реквизит " + Реквизит.Метаданные().Синоним + " не смог быть получен";
					Сообщение.Сообщить();
				КонецЕсли;
				Возврат РежимОшибкиЗагрузки;
			Иначе
				Возврат 0;
			КонецЕсли;
		// По коду
		ИначеЕсли ВидПоиска = 2 Тогда
			Реквизит = Справочники[ИмяМетаданных].НайтиПоКоду(СтрутураЭлементаRKeeper.Код);
			Если Не ЗначениеЗаполнено(Реквизит) И ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Код) Тогда
				Если РежимОшибкиЗагрузки > 0 Тогда
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Реквизит " + Реквизит.Метаданные().Синоним + " не смог быть получен";
					Сообщение.Сообщить();
				КонецЕсли;
				Возврат РежимОшибкиЗагрузки;
			Иначе
				Возврат 0;
			КонецЕсли;
		// Непосредственное значение
		Иначе
			Реквизит = СтрутураЭлементаRKeeper.Значение;
			
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Процедура - Заполнить ссылку 1 с по соответствию.
//
// Параметры:
//  СтрутураЭлементаRKeeper - Произвольный - Струтура элемента r keeper.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//
Процедура ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper,ИмяМетаданных)
	ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовRKeeper.ПолучитьОбъектПоМетаданным(ИмяМетаданных, КэшТаблицаПВХ);
	
	// Отбор по учетной записи
	УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
	Если ТипСоответствий = 1 Тогда
		УчетнаяЗаписьОтбор = УчетнаяЗапись;
	КонецЕсли;
	
	// Найдем или создадим ссылку в 1с по соответствию
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СоответствияОбъектовRKeeper.Ссылка1С
	|ИЗ
	|	РегистрСведений.питСоответствияОбъектовRKeeper КАК СоответствияОбъектовRKeeper
	|ГДЕ
	|	СоответствияОбъектовRKeeper.ТипОбъекта = &ТипОбъекта
	|	И СоответствияОбъектовRKeeper.УчетнаяЗапись = &УчетнаяЗаписьОтбор
	|	И СоответствияОбъектовRKeeper.СсылкаRKeeper = &СсылкаRKeeper";
	Запрос.УстановитьПараметр("ТипОбъекта",ТипПВХ);
	
	// Отбор по учетной записи
	Запрос.УстановитьПараметр("УчетнаяЗаписьОтбор",УчетнаяЗаписьОтбор);
	
	Запрос.УстановитьПараметр("СсылкаRKeeper",СтрутураЭлементаRKeeper.УИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка1С) Тогда
		СтрутураЭлементаRKeeper.Вставить("Ссылка1С",Выборка.Ссылка1С);
	Иначе
		Попытка
			СтрутураЭлементаRKeeper.Вставить("Ссылка1С",Справочники[ИмяМетаданных].ПустаяСсылка());
		Исключение
			СтрутураЭлементаRKeeper.Вставить("Ссылка1С",Перечисления[ИмяМетаданных].ПустаяСсылка());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Процедура - Получить незаполненные соответствия выборки.
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  СтруктураНезаполненныхСоответствий - Структура - Структура незаполненных соответствий.
//
Процедура ПолучитьНезаполненныеСоответствияВыборки(Выборка, СтруктураНезаполненныхСоответствий)
	СтрутураЭлементаRKeeper = Новый Структура;
	СтрутураЭлементаRKeeper.Вставить("УИД");
	
	// Кассы ККМ
	СтрутураЭлементаRKeeper.УИД = Выборка.КассаУИД;
	ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper,"КассыККМ");
	Если Не ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Ссылка1С) Тогда
		СтруктураНезаполненныхСоответствий.КассыККМ.Добавить(СтрутураЭлементаRKeeper.УИД);
	КонецЕсли;
	
	ВыборкаНоменклатура = Выборка.Выбрать();
	Пока ВыборкаНоменклатура.Следующий() Цикл
		// бывает, что приходит пустой УИД номенклатуры
		Если Не ЗначениеЗаполнено(ВыборкаНоменклатура.НоменклатураУИД) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.НоменклатураУИД;
		ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper,"Номенклатура");
		Если Не ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Ссылка1С) Тогда
			СтруктураНезаполненныхСоответствий.Номенклатура.Добавить(СтрутураЭлементаRKeeper.УИД);
		КонецЕсли;
		
		Если Выборка.ХозОперация <> "Продажа" Тогда
			// причина отмены
			СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.ПричинаОтменСписанийУИД;
			ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper,"питПричиныОтменИСписаний");
			Если Не ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Ссылка1С) Тогда
				СтруктураНезаполненныхСоответствий.ПричиныОтменИСписаний.Добавить(СтрутураЭлементаRKeeper.УИД);
			КонецЕсли;
		КонецЕсли;
		
		// МОДИФИКАТОРЫ
		МодификаторыНоменклатуры = Модификаторы.НайтиСтроки(Новый Структура("НоменклатураУИД, ЧекУИД",ВыборкаНоменклатура.НоменклатураУИД, ВыборкаНоменклатура.ЧекУИД));
		Для Каждого СтрокаМодификатора Из МодификаторыНоменклатуры Цикл
			// модификатор
			СтрутураЭлементаRKeeper.УИД = СтрокаМодификатора.МодификаторУИД;
			ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper,"питМодификаторы");
			Если Не ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Ссылка1С) Тогда
				СтруктураНезаполненныхСоответствий.Модификаторы.Добавить(СтрутураЭлементаRKeeper.УИД);
			КонецЕсли;
		КонецЦикла;
		
		Если Выборка.ХозОперация = "Продажа" Тогда
			// для типа оплаты определим вид оплаты
			СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.ВидОплатыУИД;
			ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper,"питВидыОплат");
			Если Не ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Ссылка1С) Тогда
				СтруктураНезаполненныхСоответствий.ВидыОплат.Добавить(СтрутураЭлементаRKeeper.УИД);
			КонецЕсли;
			
			// тип оплаты
			СтрутураЭлементаRKeeper.УИД = ВыборкаНоменклатура.ТипОплатыУИД;
			ЗаполнитьСсылку1СПоСоответствию(СтрутураЭлементаRKeeper,"питТипыОплат");
			Если Не ЗначениеЗаполнено(СтрутураЭлементаRKeeper.Ссылка1С) Тогда
				СтруктураНезаполненныхСоответствий.ТипыОплат.Добавить(СтрутураЭлементаRKeeper.УИД);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

// Происходит обход выборки из таблицы продаж RKeeper и создание документов ДПФ
//
// Параметры:
//  Выборка - Произвольный - Выборка.
//  СтруктураНезаполненныхСоответствий - Структура - Структура незаполненных соответствий.
//
Процедура ОбходРезультатЗапросаПроверка(Выборка, СтруктураНезаполненныхСоответствий)
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Группировка() = "НомерСмены" Тогда
			ПолучитьНезаполненныеСоответствияВыборки(Выборка, СтруктураНезаполненныхСоответствий);
			#Если Клиент Тогда
			ОбработкаПрерыванияПользователя();
			#КонецЕсли
		Иначе
			Выборка1 =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	        ОбходРезультатЗапросаПроверка(Выборка1, СтруктураНезаполненныхСоответствий);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура - Инициализировать таблицу чеков общепита.
//
Процедура ИнициализироватьТаблицуЧековОбщепита()
	
	ТаблицаЧековОбщепита = Новый ТаблицаЗначений;
	ТаблицаЧековОбщепита.Колонки.Добавить("ДатаДокумента", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаЧековОбщепита.Колонки.Добавить("ДокументОбъект");
	
КонецПроцедуры

// Процедура - Зафиксировать чек общепита.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//
Процедура ЗафиксироватьЧекОбщепита(ДокументОбъект)
	
	НоваяСтрока = ТаблицаЧековОбщепита.Добавить();
	НоваяСтрока.ДатаДокумента = ДокументОбъект.Дата;
	НоваяСтрока.ДокументОбъект = ДокументОбъект;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

РежимОшибкиЗагрузки = 0;

КэшТаблицаПВХ = Новый ТаблицаЗначений;
КэшТаблицаПВХ.Колонки.Добавить("ИмяМетаданных");
КэшТаблицаПВХ.Колонки.Добавить("СсылкаНаПВХ");

#КонецОбласти

#КонецЕсли
