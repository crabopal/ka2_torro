// Заполнение параметров загрузки для каждого типа объекта из ПВХ <Типы объектов RKeeper>
//
// Параметры:
//  ПараметрыЗагрузки - Произвольный - Параметры загрузки.
//
Процедура ИнициализацияПараметровЗагрузки(ПараметрыЗагрузки) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТипыОбъектовRKeeper.Ссылка КАК ТипОбъекта,
	                      |	ТипыОбъектовRKeeper.Создавать КАК Создавать,
	                      |	ТипыОбъектовRKeeper.Обновлять КАК Обновлять,
	                      |	ТипыОбъектовRKeeper.СлужебныйКаталог,
	                      |	ТипыОбъектовRKeeper.ОбработкаОшибок
	                      |ИЗ
	                      |	ПланВидовХарактеристик.питТипыОбъектовRKeeper КАК ТипыОбъектовRKeeper
	                      |ГДЕ
	                      |	ТипыОбъектовRKeeper.Предопределенный
	                      |	И НЕ ТипыОбъектовRKeeper.Ссылка В (&ЗапрещенныеТипы)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ТипыОбъектовRKeeper.Код");
	ЗапрещенныеТипы = Новый СписокЗначений;
	ЗапрещенныеТипы.Добавить(ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питТипыОплат);
	ЗапрещенныеТипы.Добавить(ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ);
	
	Запрос.УстановитьПараметр("ЗапрещенныеТипы",ЗапрещенныеТипы);
	ПараметрыЗагрузки.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры


