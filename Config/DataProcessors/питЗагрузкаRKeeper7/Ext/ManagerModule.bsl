// Установка реквизитов для объекта Тип оплаты
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектВидыОплат(СправочникОбъект, СвойстваОбъекта) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(СправочникОбъект.ТипОплаты) Тогда
		Если СвойстваОбъекта.Свойство("ТипОплаты") И ЗначениеЗаполнено(СвойстваОбъекта.ТипОплаты) Тогда
			СправочникОбъект.ТипОплаты = СвойстваОбъекта.ТипОплаты;
		Иначе
			СправочникОбъект.ТипОплаты = Перечисления.питТипыОплат.Наличные;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СправочникОбъект.питВидОперации) Тогда
		СправочникОбъект.питВидОперации = Перечисления.питВидыОперацийПоЗагрузкеДанныхПродаж.Реализация;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.СчетУчетаРасчетов) 
		И НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		СправочникОбъект.СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПрочиеДоходыИРасходы;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Организация) Тогда
		Если СвойстваОбъекта.Свойство("Организация") Тогда
			СправочникОбъект.Организация = СвойстваОбъекта.Организация;
		Иначе
			СправочникОбъект.Организация = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация", ТекПользователь);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Организация) Тогда
		СправочникОбъект.Организация = Справочники.Организации.УправленческаяОрганизация;
	КонецЕсли;
КонецПроцедуры

// Установка реквизитов для объекта Касса ККМ
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектКассыККМ(СправочникОбъект, СвойстваОбъекта) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();

	Если Не ЗначениеЗаполнено(СправочникОбъект.ВалютаДенежныхСредств) Тогда
		Если СвойстваОбъекта.Свойство("Валюта") Тогда
			СправочникОбъект.ВалютаДенежныхСредств = СвойстваОбъекта.Валюта;
		Иначе
			СправочникОбъект.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Склад) Тогда
		Если СвойстваОбъекта.Свойство("Склад") Тогда
			СправочникОбъект.Склад = СвойстваОбъекта.Склад;
		Иначе
			СправочникОбъект.Склад = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питRKeeperСклад");
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Склад) Тогда
		СправочникОбъект.Склад = ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию();
	КонецЕсли;
	
    Если НЕ ЗначениеЗаполнено(СправочникОбъект.ТипКассы) Тогда
		СправочникОбъект.ТипКассы = Перечисления.ТипыКассККМ.ФискальныйРегистратор;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Подразделение) Тогда
		Если СвойстваОбъекта.Свойство("Подразделение") Тогда
			СправочникОбъект.Подразделение = СвойстваОбъекта.Подразделение;
		Иначе
			СправочникОбъект.Подразделение = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации", текПользователь);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Владелец) Тогда
		Если СвойстваОбъекта.Свойство("Организация") Тогда
			СправочникОбъект.Владелец = СвойстваОбъекта.Организация;
		Иначе
			СправочникОбъект.Владелец = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация", текПользователь);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СправочникОбъект.Владелец) Тогда
		СправочникОбъект.Владелец = Справочники.Организации.УправленческаяОрганизация;
	КонецЕсли;
КонецПроцедуры

