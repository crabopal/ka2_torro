//  ТолькоЕдИзм - Произвольный - Только ед изм.
//
Процедура НоменклатураПослеЗаписи(Ссылка, СтрутураЭлементаRKeeper, ТолькоЕдИзм = Ложь) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Или Ссылка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ТолькоЕдИзм Тогда
		Возврат;
	КонецЕсли;
	 
	// Попытаемся найти рецептуру
	Рецептура = Документы.питРецептура.НайтиПоРеквизиту("Номенклатура", Ссылка);
	Если Рецептура.Пустая() И Ссылка.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
		Рецептура = Документы.питРецептура.СоздатьДокумент();
		Рецептура.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
		Рецептура.Упаковка = Ссылка.ЕдиницаИзмерения;

		Рецептура.Номенклатура = Ссылка;
//   Рецептура.Коэффициент =
// ОбщепитДокументы.ПолучитьКоэффициентЕдиницыИзмерения(Рецептура.Номенклатура,Рецептура.ЕдиницаИзмерения);.
		
		// Рассчитаем флаг Основная
		// РезультатЗапроса = Рецептура.ВыполнитьЗапросПоРецептурам();
		// Рецептура.Основная = Истина;
		Рецептура.Количество = 1;
		// Рецептура.Автор = ПараметрыСеанса.Пользователь;
		Если СтрутураЭлементаRKeeper.Свойство("Дата") Тогда
			Рецептура.Дата = СтрутураЭлементаRKeeper.Дата;
		Иначе
			Рецептура.Дата = ТекущаяДата();
		КонецЕсли;
		Рецептура.ДатаНачала = Рецептура.Дата;
		
		Рецептура.УстановитьНовыйНомер();
		
		// СтрутураЭлементаRKeeper.Свойство("Валюта", Рецептура.ВалютаДокумента);
		// СтруктураКурса = МодульВалютногоУчета.ПолучитьКурсВалюты(Рецептура.ВалютаДокумента, ТекущаяДата());
		// Рецептура.КурсДокумента = ?(СтруктураКурса.Курс = 0,1,СтруктураКурса.Курс);
		
		СтрутураЭлементаRKeeper.Свойство("Организация", Рецептура.Организация);
		// СтрутураЭлементаRKeeper.Свойство("Подразделение", Рецептура.ПодразделениеКомпании);
		
		Попытка
			Рецептура.Записать();
		Исключение
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "писаниеОшибки(";
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры


// УПРАВЛЕНИЕ СОЕДИНЕНИЯМИ

// Производится подключение к ВИД по строке соединения
//
// Параметры:
//  УчетнаяЗапись - Произвольный - Учетная запись.
//  СтрокаСоединения - Строка - Строка соединения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодключитьсяКВнешнемуИсточникуДанных(УчетнаяЗапись, СтрокаСоединения = "") Экспорт
	Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен Тогда
		ОтключитьсяОтВнешнегоИсточникаДанных();
	КонецЕсли;
	
	ПараметрыСоединения = ВнешниеИсточникиДанных.питRKeeper7.ПолучитьОбщиеПараметрыСоединения();
	ПараметрыСоединения.АутентификацияСтандартная = Истина;
	ПараметрыСоединения.ИмяПользователя = УчетнаяЗапись.ИмяАдминистратора;
	ПараметрыСоединения.Пароль = УчетнаяЗапись.ПарольАдминистратора;
	
	СерверRK = УчетнаяЗапись.Сервер;
	БазаRK = УчетнаяЗапись.База;
	
	Если СтрокаСоединения = "" Тогда
		ПараметрыСоединения.СтрокаСоединения = "DRIVER={SQL Server};SERVER="+НРег(СерверRK)+";DATABASE="+БазаRK+";LANGUAGE=русский";
	Иначе
		ПараметрыСоединения.СтрокаСоединения = СтрокаСоединения;
	КонецЕсли;
	ПараметрыСоединения.СУБД = "MSSQLServer";
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВнешниеИсточникиДанных.питRKeeper7.УстановитьОбщиеПараметрыСоединения(ПараметрыСоединения);
	ВнешниеИсточникиДанных.питRKeeper7.УстановитьПараметрыСоединенияПользователя(ПользователиИнформационнойБазы.ТекущийПользователь().Имя,ПараметрыСоединения);
	ВнешниеИсточникиДанных.питRKeeper7.УстановитьПараметрыСоединенияСеанса(ПараметрыСоединения);
	Попытка
		ВнешниеИсточникиДанных.питRKeeper7.УстановитьСоединение();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
КонецФункции

// Производится отключение от ВИД
//
Процедура ОтключитьсяОтВнешнегоИсточникаДанных() Экспорт
	Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен Тогда
		ВнешниеИсточникиДанных.питRKeeper7.РазорватьСоединение()
	
	КонецЕсли;
КонецПроцедуры

// Функция - Подключение активно.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодключениеАктивно() Экспорт
	Возврат ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен;
КонецФункции

// Формирует печатные формы
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать.
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//   (выходные.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документ.
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//   представление - имя области в которой был выведен объект.
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
		МодульУправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
				КоллекцияПечатныхФорм,
				"РезультатРаботы", НСтр("ru = 'Чеки Общепита'"),
				ПечатьРезультатРаботы(ПараметрыПечати.МассивДокументов, ПараметрыПечати.ПрерываниеЗагрузки),
				,
				"Обработка.питЗагрузкаRKeeper7.РезультатРаботы");
	КонецЕсли;
	
КонецПроцедуры

// /  Функция - Печать результат работы.
//
// Параметры:
//  МассивДокументов - Массив - Массив документов.
//  ПрерываниеЗагрузки - Произвольный - Прерывание загрузки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПечатьРезультатРаботы(МассивДокументов, ПрерываниеЗагрузки = Ложь) Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ПолеСверху          = 0;
	ТабДок.ПолеСлева           = 0;
	ТабДок.ПолеСнизу           = 0;
	ТабДок.ПолеСправа          = 0;
	ТабДок.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьЗаголовки	= ЛОЖЬ;
	ТабДок.ОтображатьСетку     = ЛОЖЬ;
	ТабДок.Защита              = Истина;
	ТабДок.ТолькоПросмотр      = Истина;
	ТабДок.ПолеСлева           = 9;
	ТабДок.ПолеСправа          = 6;
	
	Макет = Обработки.питЗагрузкаRKeeper7.ПолучитьМакет("РезультатРаботы");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.ВидДокументов = "Чеки Общепита";
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаСозданныеДокументы");
	Для Каждого СозданныйДокумент Из МассивДокументов Цикл
		ОбластьМакета.Параметры.Документ = СозданныйДокумент;
		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	Если ПрерываниеЗагрузки Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ОбластьМакета.Параметры.Комментарий = "Произошло прерывание загрузки";
		ТабДок.Вывести(ОбластьМакета);
	КонецЕсли;
	
	Возврат ТабДок;
КонецФункции
 
// МОДУЛЬ ЗАГРУЗКИ ИЗ ДПФ
//
// Параметры:
//  МассивКассыККМ - Массив - Массив кассы ккм.
//  МассивДокументов - Массив - Массив документов.
//  СтруктураПараметров - Структура - Структура параметров.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВыполнитьЗагрузкуИзДанныхПродаж(МассивКассыККМ,МассивДокументов,СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = Новый Структура;
	КонецЕсли;
	
	ТекстСообщения = "Загрузка из данных продаж фронта...";
	ЗаписьЖурналаРегистрации("ЗагрузкаИзДанныхПродаж", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	// Инициализация обработки
	
	// Общие реквизиты
	ОбработкаЗагрузки = Обработки.питЗагрузкаИзДанныхПродажФронта.Создать();
	
	Если СтруктураПараметров.Свойство("ДатаНачала") Тогда
		ОбработкаЗагрузки.ДатаНачалаОтбора 			= СтруктураПараметров.ДатаНачала;
	Иначе
		ОбработкаЗагрузки.ДатаНачалаОтбора 			= '00010101';
	КонецЕсли;
	Если СтруктураПараметров.Свойство("ДатаКонца") Тогда
		ОбработкаЗагрузки.ДатаКонцаОтбора 			= КонецДня(СтруктураПараметров.ДатаКонца);
	Иначе
		ОбработкаЗагрузки.ДатаКонцаОтбора 			= КонецДня(ТекущаяДата());
	КонецЕсли;
	
	// Заполнение параметров касс по соответствующим реквизитам кассовых узлов
	ОбработкаЗагрузки.ЗагрузитьПараметрыКассККМ(МассивКассыККМ);
	
	// Создание целевых документов
	Если МассивДокументов <> Неопределено Тогда
		ОбработкаЗагрузки.СписокОбрабатываемыхДокументов = Новый СписокЗначений;
		ОбработкаЗагрузки.СписокОбрабатываемыхДокументов.ЗагрузитьЗначения(МассивДокументов);
	КонецЕсли;
	
	// На каждую смену и кассу свой документ.
	ОбработкаЗагрузки.ГруппироватьПоНомеруСмены = Истина;
	
	СтруктураОбработанныхДокументов = ОбработкаЗагрузки.ВыполнитьЗагрузкуДанных();
	
	ТекстСообщения = "Завершена загрузка из данных продаж фронта.";
	ЗаписьЖурналаРегистрации("ЗагрузкаИзДанныхПродаж", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	Возврат СтруктураОбработанныхДокументов;
	

	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Получить текст отборов.
//
// Параметры:
//  Отборы - Произвольный - Отборы.
//  Запрос - Произвольный - Запрос.
//  Таблица - ТаблицаЗначений - Таблица.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьТекстОтборов(Отборы = Неопределено, Запрос, Таблица)
	// Настроим отборы
	СтрокаОтбора = "";
	
	Если Отборы.Свойство("ДатаНачала") Тогда
		СтрокаОтбора = СтрокаОтбора + Символы.ПС + "	И PrintChecks00.CLOSEDATETIME >= &ДатаНач";
		Запрос.УстановитьПараметр("ДатаНач", Отборы.ДатаНачала);
	КонецЕсли;
	
	Если Отборы.Свойство("ДатаКонца") Тогда
		СтрокаОтбора = СтрокаОтбора + Символы.ПС + "	И PrintChecks00.CLOSEDATETIME <= &ДатаКон";
		Запрос.УстановитьПараметр("ДатаКон", ?(ЗначениеЗаполнено(Отборы.ДатаКонца),КонецДня(Отборы.ДатаКонца),ТекущаяДата()));
	КонецЕсли;
	
	Если Отборы.Свойство("ЗагружатьСПустымиЦенами") И Таблица = "Товары" Тогда
		Если НЕ Отборы.ЗагружатьСПустымиЦенами Тогда
			СтрокаОтбора = СтрокаОтбора + Символы.ПС + "	И PAYBINDINGS00.PRICESUM <> 0";
		КонецЕсли;
	КонецЕсли;
	
	// Если Таблица = "Товары" Или Таблица = "Удаления" Тогда
	// 		СтрокаОтбора = СтрокаОтбора + Символы.ПС + "	И SESSIONDISHES00.IsComboComp <> 1";
	// КонецЕсли;
	
	Если Отборы.Свойство("СписокКассККМ") Тогда
		СтрокаОтбора = СтрокаОтбора + Символы.ПС + "	И CASHES00.SIFR В (&СписокКассККМ)";
		Если Отборы.СписокКассККМ.Количество() > 0 И ТипЗнч(Отборы.СписокКассККМ[0]) = Тип("СправочникСсылка.КассыККМ") Тогда
//   Если Отборы.СписокКассККМ.Количество() > 0 И ТипЗнч(Отборы.СписокКассККМ[0].Значение) =
// Тип("СправочникСсылка.КассыККМ") Тогда.
			ЗапросКасс = Новый Запрос;
			ЗапросКасс.УстановитьПараметр("Кассы",Отборы.СписокКассККМ);
			ЗапросКасс.Текст = "ВЫБРАТЬ
			               |	СоответствияОбъектовRKeeper.СсылкаRKeeper
			               |ИЗ
			               |	РегистрСведений.питСоответствияОбъектовRKeeper КАК СоответствияОбъектовRKeeper
			               |ГДЕ
			               |	СоответствияОбъектовRKeeper.ТипОбъекта = ЗНАЧЕНИЕ(ПланВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ)
			               |	И СоответствияОбъектовRKeeper.Ссылка1С В(&Кассы)";
			СписокШифровКасс = ЗапросКасс.Выполнить().Выгрузить().ВыгрузитьКолонку("СсылкаRKeeper");
			Запрос.УстановитьПараметр("СписокКассККМ", СписокШифровКасс);
		Иначе
			Запрос.УстановитьПараметр("СписокКассККМ", Отборы.СписокКассККМ);
		КонецЕсли;
	КонецЕсли;
	
	Если Отборы.Свойство("СостояниеЧека") Тогда
		СтрокаОтбора = СтрокаОтбора + Символы.ПС + "	И PRINTCHECKS00.STATE = " + Отборы.СостояниеЧека;
	Иначе
		СтрокаОтбора = СтрокаОтбора + Символы.ПС + "	И (PRINTCHECKS00.STATE = 6 ИЛИ PRINTCHECKS00.STATE = 7)";
	КонецЕсли;
	
	СтрокаОтбора = "ГДЕ " + Символы.ПС + Сред(СтрокаОтбора,4);
	
	Возврат СтрокаОтбора;
КонецФункции

// Функция - Получить текст запроса продаж.
//
// Параметры:
//  Отборы - Произвольный - Отборы.
//  Запрос - Произвольный - Запрос.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьТекстЗапросаПродаж(Отборы, Запрос)
	Возврат "ВЫБРАТЬ
       |	ИСТИНА КАК Пометка,
       |	RESTAURANTS00.SIFR КАК РесторанУИД,
       |	RESTAURANTS00.CODE КАК РесторанКод,
       |	RESTAURANTS00.NAME КАК Ресторан,
       |	GLOBALSHIFTS00.SHIFTDATE КАК ДатаСмены,
       |	GLOBALSHIFTS00.SHIFTNUM КАК НомерСмены,
       |	GLOBALSHIFTS00.GUIDSTRING КАК СменаУИД,
       |	CASHES00.SIFR КАК КассаУИД,
       |	CASHES00.CODE КАК КассаКод,
       |	CASHES00.NAME КАК Касса,
	   |	"""" КАК КассаУдаления,
       |	CURRENCIES00.NAME КАК ВидОплаты,
       |	CURRENCIES00.CODE КАК ВидОплатыКод,
       |	CURRENCIES00.SIFR КАК ВидОплатыУИД,
	   |	PrintChecks00.CHECKNUM КАК ЧекНомер,
	   |	PrintChecks00.CLOSEDATETIME КАК ЧекДата,
	   |	PrintChecks00.GUIDSTRING КАК ЧекУИД,
	   |	PrintChecks00.DELETED КАК ЧекПометкаУдаления,
       |	PrintChecks00.STATE КАК ХозОперация,
       |	"""" КАК УдалениеУИД,
       |	MENUITEMS00.NAME КАК Номенклатура,
       |	MENUITEMS00.CODE КАК НоменклатураКод,
       |	MENUITEMS00.SIFR КАК НоменклатураУИД,
       |	MENUITEMS00.PORTIONNAME КАК ЕдиницаИзмерения,
