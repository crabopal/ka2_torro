// Функция возвращает таблицу продаж по чекам
//
// Параметры:
//  Отборы - Произвольный - Отборы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуПродаж(Отборы = Неопределено) Экспорт
	Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Отключен Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Внимание! Отсутствует подключение к базе данных R-Keeper.";
		Сообщение.Сообщить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПродаж(Отборы, Запрос);
	// Если Отборы.Свойство("СостояниеЧека") Тогда
	// 	Если Отборы.СостояниеЧека = 7 Тогда
	// 		Запрос.Текст = ПолучитьТекстЗапросаУдалений(Отборы, Запрос);
	// 	ИначеЕсли Отборы.СостояниеЧека = 6 Тогда
	// 		Запрос.Текст = ПолучитьТекстЗапросаПродаж(Отборы, Запрос);
	// 	Иначе
	// 		Запрос.Текст = ПолучитьТекстЗапросаПродаж(Отборы, Запрос) + Символы.ПС +
	// 					   "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + ПолучитьТекстЗапросаУдалений(Отборы, Запрос);
	// 	КонецЕсли;
	// Иначе
	// 	Запрос.Текст = ПолучитьТекстЗапросаПродаж(Отборы, Запрос) + Символы.ПС +
	// 				   "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + ПолучитьТекстЗапросаУдалений(Отборы, Запрос);
	// КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|УПОРЯДОЧИТЬ ПО
	|PrintChecks00.CLOSEDATETIME ВОЗР";

				   
	
	Попытка
		
		// Создаем результирующую таблицу значений, НО без выгрузки результата запросачерез "Выгрузить()".
		ТаблицаПродаж = Новый ТаблицаЗначений;
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Для каждого ТекКолонкаРезультат Из РезультатЗапроса.Колонки Цикл
				ТаблицаПродаж.Колонки.Добавить(ТекКолонкаРезультат.Имя, ТекКолонкаРезультат.ТипЗначения); 
			КонецЦикла;
			ВыборкаРезультат = РезультатЗапроса.Выбрать();
			Пока ВыборкаРезультат.Следующий() Цикл
				НовСтрокаТаблицаПродаж = ТаблицаПродаж.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаТаблицаПродаж, ВыборкаРезультат);
			КонецЦикла;
		КонецЕсли;
		
	Исключение
		Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "писаниеОшибки(";
			Сообщение.Сообщить();
		Иначе
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Отсутствует подключение к внешней базе данных R-Keeper v.7";
			Сообщение.Сообщить();
		КонецЕсли;
		ТаблицаПродаж = Новый ТаблицаЗначений;
	КонецПопытки;
	
	Возврат ТаблицаПродаж; 				   
КонецФункции

// Функция - Получить таблицу продаж модификаторов.
//
// Параметры:
//  Отборы - Произвольный - Отборы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуПродажМодификаторов(Отборы = Неопределено) Экспорт
	Запрос = Новый Запрос;
	
	СтрокаОтбора = ПолучитьТекстОтборов(Отборы, Запрос, "Модификаторы");
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Modifiers00.Name КАК Модификатор,
	               |	Modifiers00.Code КАК МодификаторКод,
	               |	Modifiers00.SIFR КАК МодификаторУИД,
	               |	MENUITEMS00.Sifr КАК НоменклатураУИД,
	               |	MENUITEMS00.NAME КАК Номенклатура,
	               // |	СУММА(DISHMODIFIERS.PRListSum) КАК Сумма,
				   |	СУММА(DISHMODIFIERS.Pieces) КАК Количество,
				   |	DISHMODIFIERS.Price КАК Цена,
				   |	0 КАК Сумма,
	               |	PRINTCHECKS00.GUIDSTRING КАК ЧекУид
	               |ИЗ
	               |	ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_DISHMODIFIERS КАК DISHMODIFIERS
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_Modifiers КАК Modifiers00
	               |		ПО (Modifiers00.SIFR = DISHMODIFIERS.Sifr)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_Orders КАК Orders00
	               |		ПО (Orders00.Visit = DISHMODIFIERS.Visit)
	               |			И (Orders00.MidServer = DISHMODIFIERS.MidServer)
	               |			И (Orders00.IdentInVisit = DISHMODIFIERS.OrderIdent)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_GlobalShifts КАК GlobalShifts00
	               |		ПО (GlobalShifts00.MidServer = Orders00.MidServer)
	               |			И (GlobalShifts00.ShiftNum = Orders00.iCommonShift)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_CashGroups КАК CashGroups00
	               |		ПО (CashGroups00.SIFR = DISHMODIFIERS.MidServer)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_SESSIONDISHES КАК SESSIONDISHES00
	               |		ПО (SESSIONDISHES00.UNI = DISHMODIFIERS.DISHUNI) И (SESSIONDISHES00.VISIT=DishModifiers.VISIT) И (SESSIONDISHES00.Midserver=DishModifiers.Midserver)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_MENUITEMS КАК MENUITEMS00
	               |		ПО (SESSIONDISHES00.Sifr = MENUITEMS00.SIFR)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_PRINTCHECKS КАК PRINTCHECKS00
	               |		ПО (PRINTCHECKS00.ORDERIDENT = Orders00.IdentInVisit)
	               |			И (PRINTCHECKS00.MIDSERVER = Orders00.MidServer)
	               |			И (PRINTCHECKS00.VISIT = Orders00.Visit)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_CASHES КАК CASHES00
	               |		ПО (CASHES00.SIFR = PrintChecks00.ICLOSESTATION)
	               |"+СтрокаОтбора+"
	               |	И DISHMODIFIERS.Pieces МЕЖДУ 0.001 И 999991
	               |	И DISHMODIFIERS.combodishuni = 0
				   // |	И PRINTCHECKS00.STATE = 6
	               |    
	               |СГРУППИРОВАТЬ ПО
	               |	Modifiers00.Code,
	               |	Modifiers00.Name,
	               |	Modifiers00.SIFR,
	               |	MENUITEMS00.Sifr,
	               |	MENUITEMS00.NAME,
				   |	DISHMODIFIERS.Price,
	               |	PRINTCHECKS00.GUIDSTRING
				   |
				   |ОБЪЕДИНИТЬ ВСЕ
				   |
				   |ВЫБРАТЬ
				   |
				   |	MENUITEMS00.NAME КАК Модификатор,
				   |	MENUITEMS00.CODE КАК МодификаторКод,
				   |	MENUITEMS00.SIFR КАК МодификаторУИД,
				   |	MENUITEMS01.SIFR AS НоменклатураУИД,
				   |	MENUITEMS01.NAME AS Номенклатура,
				   // |	"""" AS НоменклатураУИД,
				   // |	"""" AS Номенклатура,
				   |	СУММА(PAYBINDINGS00.QUANTITY) КАК Количество,
   				   |	ВЫБОР КОГДА PAYBINDINGS00.QUANTITY = 0 ТОГДА 0 ИНАЧЕ PAYBINDINGS00.PRICESUM/PAYBINDINGS00.QUANTITY КОНЕЦ КАК Цена,
				   // |	СУММА(PAYBINDINGS00.PRICESUM) КАК Сумма,
				   |	0 КАК Сумма,
				   |	PrintChecks00.GUIDSTRING КАК ЧекУИД
				   |
				   |ИЗ
				   |	ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_PAYBINDINGS КАК PAYBINDINGS00
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_CURRLINES КАК CurrLines00
				   |		ПО (CurrLines00.VISIT = PAYBINDINGS00.VISIT)
				   |			И (CurrLines00.MIDSERVER = PAYBINDINGS00.MIDSERVER)
				   |			И (CurrLines00.UNI = PAYBINDINGS00.CURRUNI)
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_PRINTCHECKS КАК PrintChecks00
				   |		ПО (PrintChecks00.VISIT = CurrLines00.VISIT)
				   |			И (PrintChecks00.MIDSERVER = CurrLines00.MIDSERVER)
				   |			И (PrintChecks00.UNI = CurrLines00.CHECKUNI)
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_ORDERS КАК Orders00
				   |		ПО (Orders00.VISIT = PAYBINDINGS00.VISIT)
				   |			И (Orders00.MIDSERVER = PAYBINDINGS00.MIDSERVER)
				   |			И (Orders00.IDENTINVISIT = PAYBINDINGS00.ORDERIDENT)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_GLOBALSHIFTS КАК GLOBALSHIFTS00
				   |		ПО (GLOBALSHIFTS00.MIDSERVER = Orders00.MIDSERVER)
				   |			И (GLOBALSHIFTS00.SHIFTNUM = Orders00.ICOMMONSHIFT)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_SESSIONDISHES КАК SessionDishes00
				   |		ПО (SessionDishes00.VISIT = PAYBINDINGS00.VISIT)
				   |			И (SessionDishes00.MIDSERVER = PAYBINDINGS00.MIDSERVER)
				   |			И (SessionDishes00.UNI = PAYBINDINGS00.DISHUNI) 
				   
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_SESSIONDISHES КАК SessionDishes01
				   |		ПО (SessionDishes01.VISIT = SessionDishes00.VISIT)
				   |			И (SessionDishes01.MIDSERVER = SessionDishes00.MIDSERVER)
				   |			И (SessionDishes01.UNI = SessionDishes00.ComboDishUNI) 
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_MENUITEMS КАК MENUITEMS01
				   |		ПО (MENUITEMS01.SIFR = SessionDishes01.SIFR)
				   
				   |			
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_MENUITEMS КАК MENUITEMS00
				   |		ПО (MENUITEMS00.SIFR = SessionDishes00.SIFR)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_CASHES КАК CASHES00
				   |		ПО (CASHES00.SIFR = PrintChecks00.ICLOSESTATION)
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.питRKeeper7.Таблица.dbo_DISHVOIDS КАК DishVoids00
				   |		ПО (SessionDishes00.VISIT = DishVoids00.VISIT)
				   |			И (SessionDishes00.MIDSERVER = DishVoids00.MIDSERVER)
				   |			И (SessionDishes00.UNI = DishVoids00.DISHUNI)
				   |
				   |"+СтрокаОтбора+" 
				   // |	И PrintChecks00.STATE = 6
				   |    И CASHES00.STATUS <> 0 И SessionDishes00.IsComboComp = 1
				   |
				   |СГРУППИРОВАТЬ ПО
				   |	ВЫБОР КОГДА PAYBINDINGS00.QUANTITY = 0 ТОГДА 0 ИНАЧЕ PAYBINDINGS00.PRICESUM/PAYBINDINGS00.QUANTITY КОНЕЦ,
				   |	PrintChecks00.GUIDSTRING,
				   |	MENUITEMS01.SIFR,
				   |	MENUITEMS01.NAME,
				   |	MENUITEMS00.NAME,
				   |	MENUITEMS00.CODE,
				   |	MENUITEMS00.SIFR,
				   |	MENUITEMS00.PORTIONNAME
				   |
				   |
				   |";
	Попытка
		
		// Создаем результирующую таблицу значений, НО без выгрузки результата запросачерез "Выгрузить()".
		ТаблицаПродажМодификаторы = Новый ТаблицаЗначений;
		РезультатЗапроса = Запрос.Выполнить();
		// Если НЕ РезультатЗапроса.Пустой() Тогда
			Для каждого ТекКолонкаРезультат Из РезультатЗапроса.Колонки Цикл
				ТаблицаПродажМодификаторы.Колонки.Добавить(ТекКолонкаРезультат.Имя, ТекКолонкаРезультат.ТипЗначения); 
			КонецЦикла;
			ВыборкаРезультат = РезультатЗапроса.Выбрать();
			Пока ВыборкаРезультат.Следующий() Цикл
				НовСтрокаТаблицаПродажМодификаторы = ТаблицаПродажМодификаторы.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаТаблицаПродажМодификаторы, ВыборкаРезультат);
			КонецЦикла;
		// КонецЕсли;
		
	Исключение
		Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Подключен Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "писаниеОшибки(";
			Сообщение.Сообщить();
		Иначе
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Отсутствует подключение к внешней базе данных R-Keeper v.7";
			Сообщение.Сообщить();
		КонецЕсли;
		ТаблицаПродажМодификаторы = Новый ТаблицаЗначений;
	КонецПопытки;
	
	
	Возврат ТаблицаПродажМодификаторы; 				   
				   
КонецФункции

