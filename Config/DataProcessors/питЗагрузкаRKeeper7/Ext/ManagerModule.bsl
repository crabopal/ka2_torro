// Функция возвращает таблицу валют
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуВидовОплат() Экспорт
	ДопПоля = Новый Массив;
	ДопПоля.Добавить("PARENT");
	Возврат питRKeeper7.ПолучитьБазовыеПоляТаблицы("CURRENCIES", ДопПоля);
КонецФункции

// Функция - Получить таблицу причин и отмен.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуПричинИОтмен() Экспорт
	ДопПоля = Новый Массив;
	ДопПоля.Добавить("FLAGS");
	Возврат питRKeeper7.ПолучитьБазовыеПоляТаблицы("ORDERVOIDS",ДопПоля);
КонецФункции

// Функция - Создать объект соответствия.
//
// Параметры:
//  Соответствие - Соответствие - Соответствие.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  ДопПараметры - Произвольный - Доп параметры.
//  СкладДляЗагрузки - Произвольный - Склад для загрузки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьОбъектСоответствия(Соответствие, ИмяМетаданных, ДопПараметры, СкладДляЗагрузки = Неопределено) Экспорт

	СправочникОбъект = Справочники[ИмяМетаданных].НайтиПоНаименованию(Соответствие.ИмяRKeeper);
	Если НЕ СправочникОбъект.Пустая() И СправочникОбъект.ПометкаУдаления Тогда
		СправочникОбъект = СправочникОбъект.ПолучитьОбъект();
		СправочникОбъект.Наименование = СправочникОбъект.Наименование + " (удаленный)";
		Попытка
			СправочникОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Отбор по учетной записи
	ТипСоответствий = 0;
	Если ДопПараметры.Свойство("ТипСоответствий") Тогда
		ТипСоответствий = ДопПараметры.ТипСоответствий;
	КонецЕсли;
	УчетнаяЗаписьОтбор = Справочники.питУчетныеЗаписиRKeeper.ПустаяСсылка();
	Если ТипСоответствий = 1 Тогда
		УчетнаяЗаписьОтбор = ДопПараметры.УчетнаяЗапись;
	КонецЕсли;
	
	СправочникОбъект = Справочники[ИмяМетаданных].СоздатьЭлемент();
	СправочникОбъект.Наименование =  Соответствие.ИмяRKeeper;
//   Если ЗначениеЗаполнено(Соответствие.КодRKeeper) И
// Справочники[ИмяМетаданных].НайтиПоКоду(Соответствие.КодRKeeper).Пустая()  Тогда.
	// 	СправочникОбъект.Код = Соответствие.КодRKeeper;
	// Иначе 
		СправочникОбъект.УстановитьНовыйКод("RK");
	// КонецЕсли;
	Настройки = ПланыВидовХарактеристик.питТипыОбъектовRKeeper.ПолучитьОбъектПоМетаданным(ИмяМетаданных);
	Если Метаданные.Справочники[ИмяМетаданных].Иерархический Тогда
		Если ЗначениеЗаполнено(Настройки.СлужебныйКаталог) Тогда
			СправочникОбъект.Родитель = Настройки.СлужебныйКаталог;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяМетаданных = "КассыККМ" Тогда
		СвойстваОбъекта = Новый Структура;
		Если СкладДляЗагрузки<>Неопределено Тогда
			СвойстваОбъекта.Вставить("Склад", СкладДляЗагрузки);
		КонецЕсли;
		ПрочитатьОбъектКассыККМ(СправочникОбъект, СвойстваОбъекта);
	ИначеЕсли ИмяМетаданных = "питВидыОплатОрганизаций" Тогда
		ДопПоля = Новый Массив;
		ДопПоля.Добавить("PARENT");
		ТаблицаОплат = питRKeeper7.ПолучитьБазовыеПоляТаблицы("CURRENCIES", ДопПоля);
		СтрокаОплаты = ТаблицаОплат.Найти(Число(Соответствие.СсылкаRKeeper),"SIFR");
		
		Если СтрокаОплаты = Неопределено Тогда
			ТипОплаты = Перечисления.питТипыОплат.Наличные;
		Иначе
			НаборЗаписей = РегистрыСведений.питСоответствияОбъектовRKeeper.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ТипОбъекта.Установить(ПланыВидовХарактеристик.питТипыОбъектовRKeeper.питТипыОплат);
			
			// Отбор по учетной записи
			НаборЗаписей.Отбор.УчетнаяЗапись.Установить(УчетнаяЗаписьОтбор);
			
			НаборЗаписей.Отбор.СсылкаRKeeper.Установить(СтрокаОплаты.Parent);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 И ЗначениеЗаполнено(НаборЗаписей[0].Ссылка1С) Тогда
				ТипОплаты = НаборЗаписей[0].Ссылка1С;
			Иначе
				ТипОплаты = Перечисления.питТипыОплат.Наличные;
			КонецЕсли;
		КонецЕсли;
		ПрочитатьОбъектВидыОплат(СправочникОбъект, новый Структура("ТипОплаты",ТипОплаты));
	ИначеЕсли ИмяМетаданных = "Номенклатура" Тогда
		ПрочитатьОбъектНоменклатура(СправочникОбъект, Новый Структура);
	ИначеЕсли ИмяМетаданных = "питМодификаторы" Тогда
		СвойстваОбъекта = Новый Структура;
		ПрочитатьОбъектМодификаторы(СправочникОбъект,СвойстваОбъекта);
	ИначеЕсли ИмяМетаданных = "питПричиныОтменИСписаний" Тогда
		СвойстваОбъекта = Новый Структура;
		СвойстваОбъекта.Вставить("Наименование", Соответствие.ИмяRKeeper);
		ПрочитатьОбъектПричиныОтменИСписаний(СправочникОбъект, СвойстваОбъекта, Настройки);
	КонецЕсли;
	
	Попытка
		СправочникОбъект.Записать();
		Если ИмяМетаданных = "Номенклатура" Тогда
			НоменклатураПослеЗаписи(СправочникОбъект.Ссылка, Новый Структура(), Истина); //После записи можно создать ЕИ
		КонецЕсли;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Создан элемент <"+СправочникОбъект.Наименование+">";
		Сообщение.Сообщить();
	Исключение
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "писаниеОшибки(";
		Сообщение.Сообщить();
	КонецПопытки;
	
	Возврат СправочникОбъект.Ссылка;
КонецФункции

// Производит загрузку табличной части Продажи из данных ВИД с учетом установленных отборов
//
// Параметры:
//  Отборы - Произвольный - Отборы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьСтруктуруТаблицПродаж(Отборы) Экспорт
	СтрукруаТаблицПродаж = Новый Структура("ТаблицаПродаж, ТаблицаМодификаторов");
	
	ТаблицаПродаж = ПолучитьТаблицуПродаж(Отборы);
	СтрукруаТаблицПродаж.Вставить("ТаблицаПродаж", ТаблицаПродаж);

	ТаблицаПродажМодификаторы = ПолучитьТаблицуПродажМодификаторов(Отборы);
	СтрукруаТаблицПродаж.Вставить("ТаблицаПродажМодификаторы", ТаблицаПродажМодификаторы);
	
	СтрукруаТаблицПродаж.Вставить("ТаблицаСоответствияИмяУИД", ПолучитьТаблицуСоответствий(ТаблицаПродаж, ТаблицаПродажМодификаторы));
	// Заполним таблицу соответствий
	Возврат СтрукруаТаблицПродаж;
КонецФункции

// Возвращает таблицу соответствий УИД и имени объекта по таблице продаж
//
// Параметры:
//  ТаблицаПродаж - ТаблицаЗначений - Таблица продаж.
//  ТаблицаМодификаторов - ТаблицаЗначений - Таблица модификаторов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуСоответствий(ТаблицаПродаж, ТаблицаМодификаторов) Экспорт
	Если ТаблицаПродаж.Количество() = 0 Тогда
		ТаблицаСоответствий = Новый ТаблицаЗначений;
		Возврат ТаблицаСоответствий;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.Номенклатура,
	               |	Продажи.НоменклатураКод,
	               |	Продажи.НоменклатураУИД,
	               |	Продажи.ЕдиницаИзмерения,
	               |	Продажи.Количество,
	               |	Продажи.Сумма,
	               |	Продажи.СуммаОплаты,
	               |	Продажи.ТипОплатыУИД,
	               |	Продажи.ТипОплатыКод,
	               |	Продажи.ТипОплаты,
	               |	Продажи.КассаУИД,
	               |	Продажи.КассаКод,
	               |	Продажи.Касса,
	               |	Продажи.ДатаСмены,
	               |	Продажи.НомерСмены,
	               |	Продажи.ВидОплаты,
	               |	Продажи.ВидОплатыКод,
	               |	Продажи.ВидОплатыУИД,
	               |	Продажи.Ресторан,
	               |	Продажи.РесторанКод,
	               |	Продажи.РесторанУИД,
	               |	Продажи.ХозОперация,
	               |	Продажи.ПричинаОтменСписаний,
	               |	Продажи.ПричинаОтменСписанийКод,
	               |	Продажи.ПричинаОтменСписанийУИД,
				   // |	Продажи.НомерПозицииЧека,
	               |	Продажи.ЧекУИД,
	               |	Продажи.ЧекНомер,
	               |	Продажи.ЧекПометкаУдаления
	               |ПОМЕСТИТЬ Продажи
	               |ИЗ
	               |	&Продажи КАК Продажи
	               |ГДЕ
	               |	Продажи.Пометка
	               |;
				   |ВЫБРАТЬ
				   |	ПродажиМодификаторов.Модификатор,
				   |	ПродажиМодификаторов.МодификаторКод,
				   |	ПродажиМодификаторов.МодификаторУИД
				   |ПОМЕСТИТЬ ПродажиМодификаторов
				   |ИЗ
				   |	&ПродажиМодификаторов КАК ПродажиМодификаторов  
				   |;
				   |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	""питДанныеПродажФронта"" КАК ИмяМетаданных,
	               |	"""" КАК Наименование,
	               |	Продажи.ЧекНомер КАК Код,
	               |	Продажи.ЧекПометкаУдаления КАК ПометкаУдаления,
	               |	Продажи.ЧекУИД КАК УИД
	               |ПОМЕСТИТЬ Соответствия
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""Номенклатура"" КАК ИмяМетаданных,
	               |	Продажи.Номенклатура КАК Наименование,
	               |	Продажи.НоменклатураКод КАК Код,
	               |	ЛОЖЬ КАК ПометкаУдаления,
	               |	Продажи.НоменклатураУИД КАК УИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
				   |ОБЪЕДИНИТЬ ВСЕ
				   |
				   |ВЫБРАТЬ
				   |	""питМодификаторы"" КАК ИмяМетаданных,
				   |	ПродажиМодификаторов.Модификатор КАК Наименование,
				   |	ПродажиМодификаторов.МодификаторКод КАК Код,
				   |	ЛОЖЬ КАК ПометкаУдаления,
				   |	ПродажиМодификаторов.МодификаторУИД КАК УИД
				   |ИЗ
				   |	ПродажиМодификаторов КАК ПродажиМодификаторов
				   |
				   |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""питТипыОплат"",
	               |	Продажи.ТипОплаты,
	               |	"""",
	               |	ЛОЖЬ,
	               |	Продажи.ТипОплатыУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""питВидыОплатОрганизаций"",
	               |	Продажи.ВидОплаты,
	               |	Продажи.ВидОплатыКод,
	               |	ЛОЖЬ,
	               |	Продажи.ВидОплатыУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""ПодразделенияОрганизаций"",
	               |	Продажи.Ресторан,
	               |	Продажи.РесторанКод,
	               |	ЛОЖЬ,
	               |	Продажи.РесторанУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""КассыККМ"",
	               |	Продажи.Касса,
	               |	Продажи.КассаКод,
	               |	ЛОЖЬ,
	               |	Продажи.КассаУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""питПричиныОтменИСписаний"",
	               |	Продажи.ПричинаОтменСписаний,
	               |	Продажи.ПричинаОтменСписанийКод,
	               |	ЛОЖЬ,
	               |	Продажи.ПричинаОтменСписанийУИД
	               |ИЗ
	               |	Продажи КАК Продажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Соответствия.ИмяМетаданных,
	               |	Соответствия.Наименование,
	               |	Соответствия.Код,
	               |	Соответствия.ПометкаУдаления,
	               |	Соответствия.УИД
	               |ИЗ
	               |	Соответствия КАК Соответствия
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Соответствия.ИмяМетаданных,
	               |	Соответствия.Наименование,
	               |	Соответствия.Код,
	               |	Соответствия.ПометкаУдаления,
	               |	Соответствия.УИД";
	Запрос.УстановитьПараметр("Продажи", ТаблицаПродаж);
	Запрос.УстановитьПараметр("ПродажиМодификаторов", ТаблицаМодификаторов);
	
	ТаблицаСоответствияИмяУИД = Запрос.Выполнить().Выгрузить();
	ТаблицаСоответствияИмяУИД.Колонки.Добавить("Ссылка1С");
	
	Возврат ТаблицаСоответствияИмяУИД;
КонецФункции

// Установка общих реквизитов для всех объектов
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  Настройки - Произвольный - Настройки.
//
Процедура УстановитьОбщиеРеквизиты(Объект, СвойстваОбъекта, Настройки) Экспорт
	
	// Определение - группа или элемент
	Если Объект.ЭтоНовый() И ЗначениеЗаполнено(Настройки.СлужебныйКаталог) Тогда
		Объект.Родитель = Настройки.СлужебныйКаталог;
	КонецЕсли;
	
	Если СвойстваОбъекта.Свойство("ЭтоГруппа") Тогда
		Объект.ЭтоГруппа = СвойстваОбъекта.ЭтоГруппа;
	КонецЕсли;
	
	// Код
	Если Объект.ЭтоНовый() И СвойстваОбъекта.Свойство("Код") И ЗначениеЗаполнено(СвойстваОбъекта.Код) Тогда
		СуществующийОбъект = Справочники[Объект.Метаданные().Имя].НайтиПоКоду(СвойстваОбъекта.Код);
		Если Не ЗначениеЗаполнено(СуществующийОбъект) Тогда
			Код = Неопределено;
			СвойстваОбъекта.Свойство("Код", Код);
			Попытка
				Объект.Код = СокрЛП(Код);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// Наименование
	Наименование = Неопределено;
	СвойстваОбъекта.Свойство("Наименование", Наименование);
	Объект.Наименование = СокрЛП(Наименование);
	
	// ПометкаУдаления
	ПометкаУдаления = Неопределено;
	СвойстваОбъекта.Свойство("Активный", ПометкаУдаления);
	Если ПометкаУдаления <> Неопределено Тогда
		Объект.ПометкаУдаления = ПометкаУдаления;
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Код) Тогда
		Объект.УстановитьНовыйКод("RK");
	КонецЕсли;
	//
	// Попытаемся получить и установить какие то обязательные реквизиты
	Попытка
		ОбязательныеРеквизиты = Объект.ПолучитьОбязательныеРеквизиты();
	Исключение
		ОбязательныеРеквизиты = Новый Структура;
	КонецПопытки;
	Для Каждого СтрокаСтруктуры Из ОбязательныеРеквизиты Цикл
		Если ТипЗнч(СтрокаСтруктуры.Ключ) = Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если СвойстваОбъекта.Свойство(СтрокаСтруктуры.Ключ) И (СтрокаСтруктуры.Значение = 1 Или СтрокаСтруктуры.Значение = 3) И НЕ ЗначениеЗаполнено(Объект[СтрокаСтруктуры.Ключ]) Тогда
			Объект[СтрокаСтруктуры.Ключ] = СвойстваОбъекта[СтрокаСтруктуры.Ключ];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Установка реквизитов для объекта Номенклатура
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектНоменклатура(Объект, СвойстваОбъекта) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	// Установка ссылки, кода, наименования справочника
	МенеджерОбъекта = Справочники.Номенклатура;
	
	Если НЕ Объект.ЭтоГруппа Тогда
		
		Наименование = Неопределено;
		Если СвойстваОбъекта.Свойство("НаименованиеПолное") Тогда
			Объект.НаименованиеПолное = СвойстваОбъекта.НаименованиеПолное;
		Иначе
			Объект.НаименованиеПолное = СокрЛП(Объект.Наименование);
		КонецЕсли;

	КонецЕсли; 
	//
	
	Если СвойстваОбъекта.Свойство("СтавкаНДС") Тогда
		Объект.СтавкаНДС = СвойстваОбъекта.СтавкаНДС;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		Объект.СтавкаНДС = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию(ТекПользователь, "ОсновнаяСтавкаНДС");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		ТекущаяДата = ТекущаяДатаСеанса();
		Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
			Если ТекущаяДата >= '20190101' Тогда
				ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС20);
			ИначеЕсли ТекущаяДата >= '20260101' Тогда
				ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС22);
			КонецЕсли;
		Иначе
			Если ТекущаяДата >= '20190101' Тогда
				ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(20);
			ИначеЕсли ТекущаяДата >= '20260101' Тогда
				ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(22);
			КонецЕсли;
		КонецЕсли;
		Объект.СтавкаНДС = ТекСтавкаНДС;
	КонецЕсли;
	
	Если СвойстваОбъекта.Свойство("ВидНоменклатуры") Тогда
		Объект.питВидНоменклатуры = СвойстваОбъекта.ВидНоменклатуры;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.питВидНоменклатуры) Тогда
		Объект.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо;
	КонецЕсли;
	Объект.ВидНоменклатуры = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питRKeeperВидНоменклатуры");
	Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
		Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ВидНоменклатурыПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
		Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоРеквизиту("ТипНоменклатуры",Перечисления.ТипыНоменклатуры.Товар);
		// Тип номенклатуры то нужно установить
		Если ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
			Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
		КонецЕсли;
	КонецЕсли;
	Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект);

	// Только для элементов
	Если НЕ Объект.ЭтоГруппа Тогда
		
		// Найдем единицу
		Если СвойстваОбъекта.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(СвойстваОбъекта.ЕдиницаИзмерения) И Не ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию(СвойстваОбъекта.ЕдиницаИзмерения)
		ИначеЕсли Не ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("кг");
		КонецЕсли;
		
		Объект.ЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
	Иначе
		Объект.питВыгружатьВРБК = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Установка реквизитов для объекта Модификатор
//
// Параметры:
//  Объект - Произвольный - Объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектМодификаторы(Объект, СвойстваОбъекта) Экспорт
	СтрокаНастроек = ПланыВидовХарактеристик.питТипыОбъектовRKeeper.ПолучитьОбъектПоМетаданным("Номенклатура");
	// номенклатура модификатора
	ДопНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(Объект.Наименование, Истина);
	Если ДопНоменклатура.Пустая() Тогда
		Если СтрокаНастроек.Создавать Тогда
			ДопНоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
			ДопНоменклатураОбъект.Наименование = Объект.Наименование;
			ДопНоменклатураОбъект.УстановитьНовыйКод("RK");
			
			СвойстваОбъекта.Вставить("ВидНоменклатуры", Перечисления.питВидыНоменклатуры.Товар);
			СвойстваОбъекта.Вставить("НаименованиеПолное", "");
			
			ПрочитатьОбъектНоменклатура(ДопНоменклатураОбъект, СвойстваОбъекта);
			
			Если ЗначениеЗаполнено(СтрокаНастроек.СлужебныйКаталог) Тогда
				ДопНоменклатураОбъект.Родитель = СтрокаНастроек.СлужебныйКаталог;
			КонецЕсли;
			
			Попытка
				ДопНоменклатураОбъект.Записать();
			Исключение
			КонецПопытки;
			ДопНоменклатура = ДопНоменклатураОбъект.Ссылка;
			
			НоменклатураПослеЗаписи(ДопНоменклатура, СвойстваОбъекта);
		КонецЕсли;
	КонецЕсли;
	
	Если ДопНоменклатура.Родитель.Пустая() И ЗначениеЗаполнено(СтрокаНастроек.СлужебныйКаталог) Тогда
		ДопНоменклатураОбъект =  ДопНоменклатура.ПолучитьОбъект();
		ДопНоменклатураОбъект.Родитель = СтрокаНастроек.СлужебныйКаталог;
		Попытка
			ДопНоменклатураОбъект.Записать();
		Исключение
		КонецПопытки;
		ДопНоменклатура = ДопНоменклатураОбъект.Ссылка;
	КонецЕсли;
	
	Объект.ДопНоменклатура = ДопНоменклатура;
	Объект.ЕдиницаИзмеренияНоменклатуры = ДопНоменклатура.ЕдиницаИзмерения;
	Объект.ЕдиницаИзмеренияМодификатора = ДопНоменклатура.ЕдиницаИзмерения;
	// Объект.Коэффициент = 1;
	Объект.КоличествоНоменклатуры = 1;
	Объект.КоличествоУпаковокНоменклатуры = 1;
	Если СвойстваОбъекта.Свойство("ЦенаМодификатора") Тогда
		Объект.Цена = СвойстваОбъекта.ЦенаМодификатора;
	КонецЕсли;
КонецПроцедуры

// Установка реквизитов для объекта Подразделение
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектПодразделения(СправочникОбъект, СвойстваОбъекта) Экспорт
	текПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(СправочникОбъект.Владелец) Тогда
		Если СвойстваОбъекта.Свойство("Организация") Тогда
			СправочникОбъект.Владелец = СвойстваОбъекта.Организация;
		Иначе
			СправочникОбъект.Владелец = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация", ТекПользователь);;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Установка реквизитов для объекта Организация
//
// Параметры:
//  СправочникОбъект - Произвольный - Справочник объект.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//
Процедура ПрочитатьОбъектОрганизации(СправочникОбъект, СвойстваОбъекта) Экспорт
	// Если НЕ ЗначениеЗаполнено(СправочникОбъект.ФормаСобственности) Тогда
