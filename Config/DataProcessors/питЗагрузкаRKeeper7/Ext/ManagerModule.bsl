		СтрокаГруппы = ТаблицаГрупп.Найти(текСтрока.PARENT,"SIFR");
		Если СтрокаГруппы <> Неопределено Тогда
			ТаблицаНоменклатуры.PARENTNAME = СтрокаГруппы.Name;
		КонецЕсли;
		// НаборЗаписей.Отбор.СсылкаRKeeper.Установить(ОформлениеСтроки.ДанныеСтроки.СсылкаRKeeper);
		// НаборЗаписей.Прочитать();
		//
		// Попытка
		// 	РодительУИД = Число(НаборЗаписей[0].РодительRKeeper);
		// Исключение
		// 	Продолжить;
		// КонецПопытки;
		// СсылкаВИД = ВнешниеИсточникиДанных.RKeeper7.Таблицы.dbo_CATEGLIST.НайтиПоПолю("SIFR", РодительУИД);
		// Если НЕ обЗначениеНеЗаполнено(СсылкаВИД) Тогда
		// 	ОформлениеСтроки.Ячейки.Родитель.Значение = СсылкаВИД.NAME;
		// КонецЕсли;
		
	КонецЦикла;
	
	
	
	Возврат ТаблицаНоменклатуры;
КонецФункции

// Функция возвращает таблицу номенклатуры
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуМодификаторов() Экспорт
	ДопПоля = Новый Массив;
	ДопПоля.Добавить("PARENT");
	
	Возврат питRKeeper7.ПолучитьБазовыеПоляТаблицы("MODIFIERS", ДопПоля);
КонецФункции

