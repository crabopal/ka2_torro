

#Область ПрограммныйИнтерфейс

//  Процедура - Перед закрытием завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Записать();
		Модифицированность = Ложь;
		ЭтотОбъект.Закрыть();
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда 
		Модифицированность = Ложь;
		ЭтотОбъект.Закрыть();
	КонецЕсли;
	// Иначе нажади отмену
	
КонецПроцедуры

//  Процедура - Удаление хэх завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура УдалениеХЭХЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	СтрокаДерева = ДополнительныеПараметры.СтрокаДерева;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Родитель			= ПолучитьРодителя(СтрокаДерева);
		СтрокиДерева = Родитель.ПолучитьЭлементы();
		СтрокиДерева.Удалить(СтрокаДерева);
		Модифицированность	= Истина;
		// Принудительно выставим модифицированность, так как программное удаление ее не взводит.
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Удаление всех хэх макета завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура УдалениеВсехХЭХМакетаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	СтрокаДерева = ДополнительныеПараметры.СтрокаДерева;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СтрокиДерева = СтрокаДерева.ПолучитьЭлементы();
		СтрокиДерева.Очистить();
		// Принудительно выставим модифицированность, так как программное удаление ее не взводит.
		Модифицированность	= Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ


//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	ОбновитьДеревоИзРегистра();
	
КонецПроцедуры

//  Процедура - Перед закрытием.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), "Данные были изменены. Сохранить?", РежимДиалогаВопрос.ДаНетОтмена);	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов


//  Процедура - Дерево хэх перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//
&НаКлиенте
Процедура ДеревоХЭХПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДерева							= Элементы.ДеревоХЭХ.ТекущиеДанные;
	// Получим макет, в который нужно добавить ХЭХ
	Родитель								= ПолучитьРодителя(СтрокаДерева);
	СтрокиРодителя = Родитель.ПолучитьЭлементы();
	// Добавим ХЭХ
	
	НоваяСтрока								= СтрокиРодителя.Добавить();
	НоваяСтрока.МакетХЭХ					= ПустаяХарактеристика();
	НоваяСтрока.ФормироватьГруппы			= Родитель.ФормироватьГруппы;
	НоваяСтрока.ВидМакета					= Родитель.МакетХЭХ;
	// Установим режим редактирования для нового элемента ХЭХ
	Элементы.ДеревоХЭХ.ТекущаяСтрока	= НоваяСтрока.ПолучитьИдентификатор();
	Элементы.ДеревоХЭХ.ТекущийЭлемент	= Элементы.ДеревоХЭХМакетХЭХ;
	Элементы.ДеревоХЭХ.ИзменитьСтроку();
КонецПроцедуры

//  Процедура - Дерево хэх перед началом изменения.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоХЭХПередНачаломИзменения(Элемент, Отказ)
	ТекСтрока	= Элементы.ДеревоХЭХ.ТекущиеДанные;
	ТекЭлемент = Элементы.ДеревоХЭХ.ТекущийЭлемент;
	// Изменить можно только ХЭХ
	Если ТекЭлемент.Имя = "ДеревоХЭХМакетХЭХ" И ЭтоМакет(ТекСтрока) Тогда
		Отказ = Истина;
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - Дерево хэх перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоХЭХПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	
	СтрокаДерева	= Элементы.ДеревоХЭХ.ТекущиеДанные;
	Если ЭтоМакет(СтрокаДерева) Тогда
		// Если текущая строка - макет, то предложим удалить все ХЭХ макета
		ТекстВопроса = "Удалить все ХЭХ макета <" + СокрЛП(СтрокаДерева.МакетХЭХ) + ">?";
		ПоказатьВопрос(Новый ОписаниеОповещения("УдалениеВсехХЭХМакетаЗавершение", ЭтотОбъект, Новый Структура("СтрокаДерева", СтрокаДерева)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);	
	Иначе	
		// Если же ХЭХ, то предложим удалить конкретную ХЭХ
		ТекстВопроса = "Удалить <" + СокрЛП(СтрокаДерева.МакетХЭХ) + ">?";
		ПоказатьВопрос(Новый ОписаниеОповещения("УдалениеХЭХЗавершение", ЭтотОбъект, Новый Структура("СтрокаДерева", СтрокаДерева)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Дерево хэх перед окончанием редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоХЭХПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	ТекСтрока	= Элементы.ДеревоХЭХ.ТекущиеДанные;
	
	Родитель	= ПолучитьРодителя(ТекСтрока);
	СтрокиРодителя = Родитель.ПолучитьЭлементы();
	
	// Так как дубли недопустимы, а присутствовать могут уже все ХЭХ, то пустую ХЭХ удалим.
	Если ТекСтрока.МакетХЭХ.Пустая() Тогда
		Отказ = Истина;
		ТекстСообщения = "Удалено пустое значение в макете """+Родитель.МакетХЭХ+""".";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		СтрокиРодителя.Удалить(ТекСтрока);
		Возврат;
	КонецЕсли;
	
	Если ЭтоДубльМакета(ТекСтрока.МакетХЭХ, СтрокиРодителя) Тогда
		Отказ = Истина;
		ТекстСообщения = "Выбранное значение """+ТекСтрока.МакетХЭХ+""" уже есть в макете """+Родитель.МакетХЭХ+""".";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		// Установим режим редактирования для нового элемента ХЭХ
		Элементы.ДеревоХЭХ.ТекущаяСтрока	= ТекСтрока.ПолучитьИдентификатор();
		Элементы.ДеревоХЭХ.ТекущийЭлемент	= Элементы.ДеревоХЭХМакетХЭХ;
		Элементы.ДеревоХЭХ.ИзменитьСтроку();
		Возврат;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Дерево хэх проверка перетаскивания.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ПараметрыПеретаскивания - Произвольный - Параметры перетаскивания.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//  Строка - Строка - Строка.
//  Поле - Произвольный - Поле.
//
&НаКлиенте
Процедура ДеревоХЭХПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

//  Процедура - Дерево хэх перетаскивание.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ПараметрыПеретаскивания - Произвольный - Параметры перетаскивания.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//  Строка - Строка - Строка.
//  Поле - Произвольный - Поле.
//
&НаКлиенте
Процедура ДеревоХЭХПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	// Запретим перетаскивание из "ниоткуда" и в "никуда"
	Если (Строка = Неопределено) ИЛИ (ПараметрыПеретаскивания.Значение = Неопределено) Тогда
		Возврат;
	КонецЕсли;
	РодительИсточника = ПолучитьРодителя(ПараметрыПеретаскивания.Значение);
	РодительПриемника = ПолучитьРодителя(Строка);
	// 1) Перетаскивается макет - добавляем в приемник все ХЭХ источника
	Если ПараметрыПеретаскивания.Значение = РодительИсточника Тогда
		Для Каждого СтрокаХЭХ Из РодительИсточника.ПолучитьЭлементы() Цикл
			Если РодительПриемника.Строки.Найти(СтрокаХЭХ.МакетХЭХ, "МакетХЭХ") = Неопределено Тогда
				НоваяСтрока						= РодительПриемника.Строки.Добавить();
				НоваяСтрока.МакетХЭХ			= СтрокаХЭХ.МакетХЭХ;
				НоваяСтрока.ФормироватьГруппы	= РодительПриемника.ФормироватьГруппы;
				НоваяСтрока.ВидМакета			= РодительПриемника.МакетХЭХ;
				Модифицированность				= Истина;
			КонецЕсли;	
		КонецЦикла;	
		// 2) Перетаскивание внутри макета - меняем порядок ХЭХ	
	ИначеЕсли РодительИсточника = РодительПриемника Тогда
		Если Строка <> РодительПриемника Тогда
			Смещение							= РодительИсточника.Строки.Индекс(Строка) - РодительИсточника.Строки.Индекс(ПараметрыПеретаскивания.Значение); 
			РодительИсточника.Строки.Сдвинуть(ПараметрыПеретаскивания.Значение, Смещение);
			Модифицированность					= Истина;
		КонецЕсли;
		// 3) Перетаскивание ХЭХ из одного макета в другой	
	Иначе
		Если РодительПриемника.Строки.Найти(ПараметрыПеретаскивания.Значение.МакетХЭХ, "МакетХЭХ") <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		НоваяСтрока								= РодительПриемника.Строки.Добавить();
		НоваяСтрока.МакетХЭХ					= ПараметрыПеретаскивания.Значение.МакетХЭХ;
		НоваяСтрока.ФормироватьГруппы			= РодительПриемника.ФормироватьГруппы;
		НоваяСтрока.ВидМакета					= РодительПриемника.МакетХЭХ;
		Модифицированность						= Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

//  Процедура - Сохранить.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Сохранить(Команда)
	Записать();
	Модифицированность	= Ложь;
КонецПроцедуры

//  Процедура - Дерево хэх переместить вверх.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ДеревоХЭХПереместитьВверх(Команда)
	ТекСтрока = Элементы.ДеревоХЭХ.ТекущиеДанные;
	// Переместить можно только ХЭХ
	Если ЭтоМакет(ТекСтрока) Тогда
		Возврат;
	КонецЕсли;
	Родитель = ПолучитьРодителя(ТекСтрока);
	СтрокиРодителя = Родитель.ПолучитьЭлементы();
	ИндексСтроки = СтрокиРодителя.Индекс(ТекСтрока);
	// Если ХЭХ - первая, то вверх не перемещаем
	Если ИндексСтроки <= 0 Тогда
		Возврат;
	КонецЕсли;
	СтрокиРодителя.Сдвинуть(ИндексСтроки, -1);
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Дерево хэх переместить вниз.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ДеревоХЭХПереместитьВниз(Команда)
	ТекСтрока = Элементы.ДеревоХЭХ.ТекущиеДанные;
	// Переместить можно только ХЭХ
	Если ЭтоМакет(ТекСтрока) Тогда
		Возврат;
	КонецЕсли;
	Родитель = ПолучитьРодителя(ТекСтрока);
	СтрокиРодителя = Родитель.ПолучитьЭлементы();
	ИндексСтроки = СтрокиРодителя.Индекс(ТекСтрока);
	// Если ХЭХ - последняя, то вниз не перемещаем
	Если ИндексСтроки >= СтрокиРодителя.Количество() - 1 Тогда
		Возврат;
	КонецЕсли;
	СтрокиРодителя.Сдвинуть(ИндексСтроки, 1);
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Модуль формы обработки "пит ХЭХ для печати"

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Функция возвращает текущую строку дерева ХЭХ и определяет ее тип (макет или ХЭХ).
//
// Параметры:
//  ТекСтрока - Строка - Тек строка.
//
// Возвращаемое значение:
// 	Текущая строка дерева ХЭХ
&НаКлиенте
Функция ЭтоМакет(ТекСтрока)
	ЭтоМакет	= (ТипЗнч(ТекСтрока.МакетХЭХ) = Тип("ПеречислениеСсылка.питВидыМакетовХЭХ"));
	Возврат ЭтоМакет;
КонецФункции

// Функция получает строку дерева ХЭХ, содержащую макет, к которому относится текущая строка.
//
// Параметры:
//  ТекСтрока - СтрокаДереваЗначений - Текущая строка дерева ХЭ.
//
// Возвращаемое значение:
// 	СтрокаДереваЗначений - Макет, к которому относится текущая строка
&НаКлиенте
Функция ПолучитьРодителя(ТекСтрока)
	Если ТипЗнч(ТекСтрока.МакетХЭХ) = Тип("ПеречислениеСсылка.питВидыМакетовХЭХ") Тогда
		Родитель	= ТекСтрока;
	Иначе
		Родитель	= ТекСтрока.ПолучитьРодителя();
	КонецЕсли;
	Возврат Родитель;
КонецФункции

// Процедура получает записи из регистра сведений "ХЭХ для печати" и выводит их в виде дерева,
//  узлами которого являются макеты печатных форм, содержащие ХЭХ, а листьями - ХЭХ, выводимые для
//  соответствующего макета.
//
&НаСервере
Процедура ОбновитьДеревоИзРегистра()
	Запрос = Новый Запрос();
	
	Запрос.Текст =  "ВЫБРАТЬ
	|	ХЭХДляПечати.ХимикоэнергетическаяХарактеристика,
	|	ВЫБОР 
	|		КОГДА ВидыМакетовХЭХ.Ссылка=ЗНАЧЕНИЕ(Перечисление.питВидыМакетовХЭХ.ВсеМакеты) ТОГДА
	|		  0
	|		КОГДА ВидыМакетовХЭХ.Ссылка=ЗНАЧЕНИЕ(Перечисление.питВидыМакетовХЭХ.ТехникоТехнологическаяКарта) ТОГДА
	|		  1
	|		КОГДА ВидыМакетовХЭХ.Ссылка=ЗНАЧЕНИЕ(Перечисление.питВидыМакетовХЭХ.Меню) ТОГДА
	|		  2
	|		КОГДА ВидыМакетовХЭХ.Ссылка=ЗНАЧЕНИЕ(Перечисление.питВидыМакетовХЭХ.РасширенноеМеню) ТОГДА
	|		  3
	|	КОНЕЦ КАК ПорядокМакетов,
	|	ВидыМакетовХЭХ.Ссылка КАК Макет,
	|	ХЭХДляПечати.Приоритет КАК Приоритет,
	|	ХЭХДляПечати.ФормироватьГруппыПриВыводе
	|ИЗ
	|	Перечисление.питВидыМакетовХЭХ КАК ВидыМакетовХЭХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питХЭХДляПечати КАК ХЭХДляПечати
	|		ПО ВидыМакетовХЭХ.Ссылка = ХЭХДляПечати.Макет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокМакетов,
	|	Приоритет";
	
	
	ТаблицаХЭХ	= Запрос.Выполнить().Выгрузить();
	СтрокиДерева = ДеревоХЭХ.ПолучитьЭлементы();
	СтрокиДерева.Очистить();
	Родитель	= Неопределено;
	Для Каждого СтрокаТаблицы Из ТаблицаХЭХ Цикл
		// При смене макета (или для первого макета) происходит добавление узла дерева
		Если (Родитель = Неопределено) ИЛИ (Родитель.МакетХЭХ <> СтрокаТаблицы.Макет) Тогда
			Родитель			= СтрокиДерева.Добавить();
			Родитель.МакетХЭХ	= СтрокаТаблицы.Макет;
		КонецЕсли;
		// Добавление ХЭХ в текущий макет
		Если ЗначениеЗаполнено(СтрокаТаблицы.ХимикоэнергетическаяХарактеристика) Тогда
			СтрокиРодителя = Родитель.ПолучитьЭлементы();
			СтрокаХЭХ					= СтрокиРодителя.Добавить();
			СтрокаХЭХ.МакетХЭХ			= СтрокаТаблицы.ХимикоэнергетическаяХарактеристика;
			СтрокаХЭХ.ФормироватьГруппы	= СтрокаТаблицы.ФормироватьГруппыПриВыводе;
			СтрокаХЭХ.ВидМакета	= Родитель.МакетХЭХ;
			Если СтрокаХЭХ.ФормироватьГруппы Тогда
				Родитель.ФормироватьГруппы = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

// Процедура производит запись в регистр сведений "ХЭХ для печати" на основании структуры
//  и параметров дерева ХЭХ.
//
&НаСервере
Процедура Записать()
	МенеджерНабораЗаписей = РегистрыСведений.питХЭХДляПечати.СоздатьНаборЗаписей();
	МенеджерНабораЗаписей.Записать();
	СтрокиДерева = ДеревоХЭХ.ПолучитьЭлементы();
	Для Каждого Макет Из СтрокиДерева Цикл
		// Для каждого макета приоритеты нумеруются с самого начала
		ТекПриоритет	= 0;
		СтрокиМакета = Макет.ПолучитьЭлементы();
		Для Каждого ХЭХ Из СтрокиМакета Цикл
			НоваяЗапись				= МенеджерНабораЗаписей.Добавить();
			НоваяЗапись.Макет		= Макет.МакетХЭХ;
			НоваяЗапись.ХимикоэнергетическаяХарактеристика	= ХЭХ.МакетХЭХ;
			НоваяЗапись.ФормироватьГруппыПриВыводе			= ХЭХ.ФормироватьГруппы;
			НоваяЗапись.Приоритет	= ТекПриоритет;
			ТекПриоритет			= ТекПриоритет + 1;
		КонецЦикла;
	КонецЦикла;
	МенеджерНабораЗаписей.Записать();
КонецПроцедуры

//  Функция - Пустая характеристика.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПустаяХарактеристика()
	Возврат Справочники.питХимикоэнергетическиеХарактеристики.ПустаяСсылка();
КонецФункции

//  Функция - Это дубль макета.
//
// Параметры:
//  МакетХЭХ - Произвольный - Макет хэх.
//  СтрокиРодителя - Произвольный - Строки родителя.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ЭтоДубльМакета(МакетХЭХ, СтрокиРодителя)
	// Проверим дубли
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("МакетХЭХ", МакетХЭХ);
	
	
	// Если есть дубль, не разрешим окончить редактирование
	КоличествоСтрок = 0;
	ПолучитьКоличествоСтрокДереваПоЗначениюПоля("МакетХЭХ", СтрокиРодителя, МакетХЭХ, КоличествоСтрок);
	Возврат КоличествоСтрок > 1;
КонецФункции



//  Процедура - Получить количество строк дерева по значению поля.
//
// Параметры:
//  ИмяПоля - Произвольный - Имя поля.
//  КоллекцияЭлементовДерева - Произвольный - Коллекция элементов дерева.
//  КлючСтроки - Произвольный - Ключ строки.
//  КоличествоСтрок - Произвольный - Количество строк.
//
&НаКлиенте
Процедура ПолучитьКоличествоСтрокДереваПоЗначениюПоля(ИмяПоля, КоллекцияЭлементовДерева, КлючСтроки, КоличествоСтрок)
	
	Для Каждого СтрокаДерева ИЗ КоллекцияЭлементовДерева Цикл        
		Если СтрокаДерева[ИмяПоля] = КлючСтроки Тогда
			КоличествоСтрок = КоличествоСтрок + 1;
		КонецЕсли;
		
		КоллекцияЭлементов = СтрокаДерева.ПолучитьЭлементы();
		Если КоллекцияЭлементов.Количество() > 0 Тогда
			ПолучитьКоличествоСтрокДереваПоЗначениюПоля(ИмяПоля, КоллекцияЭлементовДерева, КлючСтроки, КоличествоСтрок);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти



