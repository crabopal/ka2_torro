//
&НаКлиенте
Процедура ПодборТаблицаХЭХ(Команда)
	
	ТекДанныеИнгредиенты = Элементы.ТаблицаИнгредиенты.ТекущиеДанные;
	Если ТекДанныеИнгредиенты = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен ингредиент в таблице ингредиентов!");
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Ложь);
	ФормаВыбора = ПолучитьФорму("Справочник.питХимикоэнергетическиеХарактеристики.ФормаВыбора",ПараметрыВыбора,Элементы.ТаблицаХЭХ);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

// Обработчик команды смены режима обработки
//
&НаКлиенте
Процедура ОтВидовОбработки(Команда)
	
	// Смена режима
	РежимОтВидовОбработки = НЕ РежимОтВидовОбработки;
	
	// Действия на сервере
	ОтВидовОбработкиСервер();
	
	// Принудительный вызов обработчика активации строки для заполнения детальных таблиц в зависимости от режима.
	Если РежимОтВидовОбработки Тогда
		ВидыОбработкиСписокПриАктивизацииСтроки(Элементы.ВидыОбработкиСписок);
	Иначе
		ИнгредиентыСписокПриАктивизацииСтроки(Элементы.ИнгредиентыСписок);
	КонецЕсли;
	
	// Управление формой
	УправлениеФормой();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РежимОтИнгредиентов

#Область ОбработчикиСобытийТаблицаХЭХПоИнгредиентам


// Процедура добавляет в регистр запись по переданным значениям измерений, если таковой еще нет в базе.
//
// Параметры:
//  ХЭХ			 - СправочникСсылка.питХимикоэнергетическиеХарактеристики - Ссылка на добавляемый ХЭХ.
//  Ингредиент	 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки - СправочникСсылка.питВидыОбработкиСырья - Ссылка вид обработки.
//
&НаСервере
Процедура ДобавитьХЭХПоИнгредиентуСервер(ХЭХ, Ингредиент, ВидОбработки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питОбработкаСырья.Ингредиент
	|ИЗ
	|	РегистрСведений.питОбработкаСырья КАК питОбработкаСырья
	|ГДЕ
	|	питОбработкаСырья.Ингредиент = &Ингредиент
	|	И питОбработкаСырья.ВидОбработкиСырья = &ВидОбработки
	|	И питОбработкаСырья.ХимикоэнергетическаяХарактеристика = &ХЭХ";
	
	Запрос.УстановитьПараметр("ВидОбработки", ВидОбработки);
	Запрос.УстановитьПараметр("Ингредиент", Ингредиент);
	Запрос.УстановитьПараметр("ХЭХ", ХЭХ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда	
		НовЗаписьМенеджер = РегистрыСведений.питОбработкаСырья.СоздатьМенеджерЗаписи();
		НовЗаписьМенеджер.ВидОбработкиСырья = ВидОбработки;
		НовЗаписьМенеджер.Ингредиент = Ингредиент;
		НовЗаписьМенеджер.ХимикоэнергетическаяХарактеристика = ХЭХ;
		Попытка
			НовЗаписьМенеджер.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка добавления ХЭХ в регистр ""Обработка сырья"" по причине: "
			+ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	// Перезаполнение детальных таблиц для режима "По ингредиентам".
	ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент);
	
КонецПроцедуры

// Процедура удаляет запись из регистра по переданным значениям измерений.
//
// Параметры:
//  ХЭХ			 - СправочникСсылка.питХимикоэнергетическиеХарактеристики - Ссылка на добавляемый ХЭХ.
//  Ингредиент	 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки - СправочникСсылка.питВидыОбработкиСырья - Ссылка вид обработки.
//
&НаСервере
Процедура УдалитьХЭХПоВидуИнгредиентуСервер(ХЭХ, Ингредиент, ВидОбработки)
	
	НаборЗаписей = РегистрыСведений.питОбработкаСырья.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ингредиент.Установить(Ингредиент);
	НаборЗаписей.Отбор.ВидОбработкиСырья.Установить(ВидОбработки);
	НаборЗаписей.Отбор.ХимикоэнергетическаяХарактеристика.Установить(ХЭХ);
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка удаления ХЭХ из регистра ""Обработка сырья"" по причине: "
		+ОписаниеОшибки());
	КонецПопытки;
	
	// Перезаполнение детальных таблиц для режима "По ингредиентам".
	ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийДеревоИнгредиентов

// Процедура добавляет запись в регистр по переданным значениям измерений и обновляет данные в детальных таблицах.
//
// Параметры:
//  Ингредиент				 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки			 - СправочникСсылка.питВидыОбработкиСырья - Ссылка на добавляемый вид обработки.
//
&НаСервере
Процедура ДобавитьВидОбработкиПоИнгредиентуСервер(ВидОбработки, Ингредиент)
	
	// Добавление записей.
	ДобавитьЗаписьИнгредиентВидОбработкиВРегистр(Ингредиент, ВидОбработки, Истина);
	
	// Обновление данных.
	ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент);
	
КонецПроцедуры

// Процедура удаляет запись из регистра по переданным значениям измерений и обновляет данные в детальных таблицах.
//
// Параметры:
//  ВидОбработки			 - СправочникСсылка.питВидыОбработкиСырья - Ссылка на добавляемый вид обработки.
//  Ингредиент				 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//
&НаСервере
Процедура УдалитьВидОбработкиПоИнгредиентуСервер(ВидОбработки, Ингредиент)
	
	НаборЗаписей = РегистрыСведений.питОбработкаСырья.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ингредиент.Установить(Ингредиент);
	НаборЗаписей.Отбор.ВидОбработкиСырья.Установить(ВидОбработки);
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка удаления вида обработки из регистра ""Обработка сырья"" по причине: "
		+ОписаниеОшибки());
	КонецПопытки;
	
	ДобавитьИнгредиентВСписокНаСервере(Ингредиент, Ложь);
	
	ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийСписокИнгредиентов

// Процедура удаляет все записи из регистра по переданному ингредиенту.
//
// Параметры:
//  Ингредиент	 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//
&НаСервере
Процедура УдалитьИнгредиентИзСпискаНаСервере(Ингредиент)
	
	НаборЗаписей = РегистрыСведений.питОбработкаСырья.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ингредиент.Установить(Ингредиент);
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка удаления ингредиента из регистра ""Обработка сырья"" по причине: "
		+ОписаниеОшибки());
	КонецПопытки;
	
	// Обновление динамического списка.
	Элементы.ИнгредиентыСписок.Обновить();
	
КонецПроцедуры

// Процедура добавляет запись по переданному ингредиенту в регистр. В качестве вида обработки используется служебный элемент.
//
// Параметры:
//  Ингредиент		 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ОбновлятьСписок	 - Булево - Признак обновления списка после добавления.
//
&НаСервере
Процедура ДобавитьИнгредиентВСписокНаСервере(Ингредиент, ОбновлятьСписок = Истина)
	
	Обработки.питПотериПриОбработкеСырья.ДобавитьСлужебнуюЗаписьПоИнгредиенту(Ингредиент);
	
	Если ОбновлятьСписок Тогда
		Элементы.ИнгредиентыСписок.Обновить();
	КонецЕсли;
	
КонецПроцедуры

// Удаление выделенного в списке ингредиента из регистра.
//
&НаКлиенте
Процедура ИнгредиентыСписокУдаление()
	
	ТекДанные = Элементы.ИнгредиентыСписок.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		УдалитьИнгредиентИзСпискаНаСервере(ТекДанные.Ингредиент);
		ЗаполнитьДанныеПоИнгредиентуКлиент();
	КонецЕсли;
	
КонецПроцедуры

// Начало добавления ингредиента в список.
//
&НаКлиенте
Процедура ИнгредиентыСписокНачалоДобавления()
	
	// Открытие формы выбора
	ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
	ФормаВыбора = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора,Элементы.ИнгредиентыСписок);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

#КонецОбласти

// Процедура заполнения детальных таблиц по ингредиенту.
//
&НаКлиенте
Процедура ЗаполнитьДанныеПоИнгредиентуКлиент()
	
	ТекДанные = Элементы.ИнгредиентыСписок.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьДетальныеТаблицыПоИнгредиенту(ТекДанные.Ингредиент);
		ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
		ОбновитьТаблицыРежимИнгредиентов();
	КонецЕсли;
	
КонецПроцедуры

// Процедура заполнения детальных таблиц по ингредиенту (на сервере).
//
&НаСервере
Процедура ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент)
	
	// Процедура из модуля менеджера, также вызывается в формах строки и видов обработки рецептуры.
	Обработки.питПотериПриОбработкеСырья.ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент, 
		ДеревоИнгредиентыВидыОбработки, ТаблицаХЭХ, ТипОбработкиХолодная, ТипОбработкиГорячая);
	
	// Калорийность.
	Элементы.НадписьИнгредиентыКалорийностьОбщая.Заголовок = "";
	Элементы.НадписьИнгредиентыКалорийностьПоВидуОбработки.Заголовок = "";
	ОбновитьКалорийностиНаФорме(Ингредиент);
	
КонецПроцедуры

// Процедура с действиями обновления детальных таблиц на клиенте.
//
&НаКлиенте
Процедура ОбновитьТаблицыРежимИнгредиентов()
	
	Элементы.ДеревоИнгредиентыВидыОбработки.Развернуть(ТипОбработкиХолодная);
	Элементы.ДеревоИнгредиентыВидыОбработки.Развернуть(ТипОбработкиГорячая);
	
КонецПроцедуры

#КонецОбласти

#Область РежимОтВидовОбработки

#Область ОбработчикиСобытийТаблицаИнгредиентовПоВидамОбработки

// Процедура добавляет запись по переданному ингредиенту и виду обработки в регистр.
//
// Параметры:
//  Ингредиент		 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки	 - СправочникСсылка.питВидыОбработкиСырья - Ссылка на вид обработки.
//  ТипОбработки	 - ПеречислениеСсылка.питТипыОбработкиСырья - Ссылка на тип обработки.
//
&НаСервере
Процедура ДобавитьИнгредиентПоВидуОбработкиСервер(Ингредиент, ВидОбработки, ТипОбработки)
	
	// Добавление записи в регистр.
	ДобавитьЗаписьИнгредиентВидОбработкиВРегистр(Ингредиент, ВидОбработки, Истина);
	
	// Заполнение детальных таблиц.
	ЗаполнитьДетальныеТаблицыПоВидуОбработки(ВидОбработки, ТипОбработки);
	
	// Установка текущей строки.
	НайденныеСтроки = ТаблицаИнгредиентыВидыОбработки.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки", Ингредиент, ВидОбработки));
	Если НайденныеСтроки.Количество() Тогда
		Элементы.ТаблицаИнгредиенты.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

// Процедура удаляет записи из регистра по переданным ингредиенту и виду обработки.
//
// Параметры:
//  Ингредиент	 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки - СправочникСсылка.питВидыОбработкиСырья - Ссылка на вид обработки.
//  ТипОбработки - ПеречислениеСсылка.питТипыОбработкиСырья - Ссылка на тип обработки.
//
&НаСервере
Процедура УдалитьИнгредиентПоВидуОбработкиСервер(Ингредиент, ВидОбработки, ТипОбработки)
	
	НаборЗаписей = РегистрыСведений.питОбработкаСырья.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ингредиент.Установить(Ингредиент);
	НаборЗаписей.Отбор.ВидОбработкиСырья.Установить(ВидОбработки);
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка удаления ингредиента из регистра ""Обработка сырья"" по причине: "
		+ОписаниеОшибки());
	КонецПопытки;
	
	ЗаполнитьДетальныеТаблицыПоВидуОбработки(ВидОбработки, ТипОбработки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицаХЭХПоВидамОбработки

// Процедура добавляет записи в регистр по переданным значениям измерений.
//
// Параметры:
//  ХЭХ			 - СправочникСсылка.питХимикоэнергетическиеХарактеристики - Ссылка на ХЭХ
//  Ингредиент	 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки - СправочникСсылка.питВидыОбработкиСырья - Ссылка на вид обработки.
//  ТипОбработки - ПеречислениеСсылка.питТипыОбработкиСырья - Ссылка на тип обработки.
//
&НаСервере
Процедура ДобавитьХЭХПоВидуОбработкиСервер(ХЭХ, Ингредиент, ВидОбработки, ТипОбработки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питОбработкаСырья.Ингредиент
	|ИЗ
	|	РегистрСведений.питОбработкаСырья КАК питОбработкаСырья
	|ГДЕ
	|	питОбработкаСырья.Ингредиент = &Ингредиент
	|	И питОбработкаСырья.ВидОбработкиСырья = &ВидОбработки
	|	И питОбработкаСырья.ХимикоэнергетическаяХарактеристика = &ХЭХ";
	
	Запрос.УстановитьПараметр("ВидОбработки", ВидОбработки);
	Запрос.УстановитьПараметр("Ингредиент", Ингредиент);
	Запрос.УстановитьПараметр("ХЭХ", ХЭХ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда	
		НовЗаписьМенеджер = РегистрыСведений.питОбработкаСырья.СоздатьМенеджерЗаписи();
		НовЗаписьМенеджер.ВидОбработкиСырья = ВидОбработки;
		НовЗаписьМенеджер.Ингредиент = Ингредиент;
		НовЗаписьМенеджер.ХимикоэнергетическаяХарактеристика = ХЭХ;
		Попытка
			НовЗаписьМенеджер.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка добавления ингредиента в регистра ""Обработка сырья"" по причине: "
			+ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	ЗаполнитьДетальныеТаблицыПоВидуОбработки(ВидОбработки, ТипОбработки);
	
КонецПроцедуры

// Процедура удаляет записи из регистра по переданным значениям измерений.
//
// Параметры:
//  ХЭХ			 - СправочникСсылка.питХимикоэнергетическиеХарактеристики - Ссылка на ХЭХ
//  Ингредиент	 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки - СправочникСсылка.питВидыОбработкиСырья - Ссылка на вид обработки.
//  ТипОбработки - ПеречислениеСсылка.питТипыОбработкиСырья - Ссылка на тип обработки.
//
&НаСервере
Процедура УдалитьХЭХПоВидуОбработкиСервер(ХЭХ, Ингредиент, ВидОбработки, ТипОбработки)
	
	НаборЗаписей = РегистрыСведений.питОбработкаСырья.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ингредиент.Установить(Ингредиент);
	НаборЗаписей.Отбор.ВидОбработкиСырья.Установить(ВидОбработки);
	НаборЗаписей.Отбор.ХимикоэнергетическаяХарактеристика.Установить(ХЭХ);
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка удаления ХЭХ из регистра ""Обработка сырья"" по причине: "
		+ОписаниеОшибки());
	КонецПопытки;
	
	ЗаполнитьДетальныеТаблицыПоВидуОбработки(ВидОбработки, ТипОбработки);
	
КонецПроцедуры

#КонецОбласти

// Процедура заполнения детальных таблиц по виду обработки.
//
&НаКлиенте
Процедура ЗаполнитьДанныеПоВидуОбработкиКлиент()
	
	ТекДанные = Элементы.ВидыОбработкиСписок.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено И ТекДанные.Свойство("ГруппировкаСтроки") Тогда
		ТекДанные = Неопределено;
		ТаблицаИнгредиентыВидыОбработки.Очистить();
		ТаблицаХЭХ.Очистить();
	КонецЕсли;
	
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьДетальныеТаблицыПоВидуОбработки(ТекДанные.Ссылка, ТекДанные.ТипОбработкиСырья);
		
		// Установка тек. строки в таблице ингредиентов, если ингредиенты есть, то текущей строкой выберем самую первую.
		Если ТаблицаИнгредиентыВидыОбработки.Количество() Тогда
			Элементы.ТаблицаИнгредиенты.ТекущаяСтрока = ТаблицаИнгредиентыВидыОбработки[0].ПолучитьИдентификатор();
		КонецЕсли;
		
		ОбновитьОтборСтрокТаблицыХЭХ();
	КонецЕсли;
	
КонецПроцедуры


// Процедура заполнения детальных таблиц по виду обработки (на сервере).
//
&НаСервере
Процедура ЗаполнитьДетальныеТаблицыПоВидуОбработки(ВидОбработки, ТипОбработки)
	
	ТаблицаИнгредиентыВидыОбработки.Очистить();
	ТаблицаХЭХ.Очистить();
	
	ГруппаХЭХПоУмолчанию = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питГруппаХЭХПоУмолчанию");
	ГруппаХЭХЗадана = ЗначениеЗаполнено(ГруппаХЭХПоУмолчанию);
	
	// Запрос, получающий данные регистра для заполнения таблиц формы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питОбработкаСырья.Ингредиент КАК Ингредиент,
	|	питОбработкаСырья.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика,
	|	питОбработкаСырья.ПроцентПотерь КАК ПроцентПотерь,
	|	ВЫБОР
	|		КОГДА питОбработкаСырья.ХимикоэнергетическаяХарактеристика = ЗНАЧЕНИЕ(Справочник.питХимикоэнергетическиеХарактеристики.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоХЭХ
	|ПОМЕСТИТЬ втДанные
	|ИЗ
	|	РегистрСведений.питОбработкаСырья КАК питОбработкаСырья
	|ГДЕ
	|	питОбработкаСырья.ВидОбработкиСырья = &ВидОбработки
	|;
	|";
	Если ГруппаХЭХЗадана Тогда
		Запрос.Текст = Запрос.Текст +"
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	питХимикоэнергетическиеХарактеристики.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ втХЭХ
		|ИЗ
		|	Справочник.питХимикоэнергетическиеХарактеристики КАК питХимикоэнергетическиеХарактеристики
		|ГДЕ
		|	питХимикоэнергетическиеХарактеристики.ГруппаХЭХ = &ГруппаХЭХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанные.Ингредиент КАК Ингредиент
		|ПОМЕСТИТЬ втДляХЭХ
		|ИЗ
		|	втДанные КАК втДанные
		|
		|СГРУППИРОВАТЬ ПО
		|	втДанные.Ингредиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДляХЭХ.Ингредиент КАК Ингредиент,
		|	0 КАК ПроцентПотерь,
		|	ИСТИНА КАК ЭтоХЭХ,
		|	втХЭХ.Ссылка КАК ХимикоэнергетическаяХарактеристика
		|ПОМЕСТИТЬ втДанныеОбъединенные
		|ИЗ
		|	втДляХЭХ КАК втДляХЭХ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втХЭХ КАК втХЭХ
		|		ПО (ИСТИНА)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	втДанные.Ингредиент,
		|	втДанные.ПроцентПотерь,
		|	втДанные.ЭтоХЭХ,
		|	втДанные.ХимикоэнергетическаяХарактеристика
		|ИЗ
		|	втДанные КАК втДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанныеОбъединенные.Ингредиент КАК Ингредиент,
		|	СУММА(втДанныеОбъединенные.ПроцентПотерь) КАК ПроцентПотерь,
		|	втДанныеОбъединенные.ЭтоХЭХ КАК ЭтоХЭХ,
		|	втДанныеОбъединенные.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика
		|ПОМЕСТИТЬ втДанныеСгруппированные
		|ИЗ
		|	втДанныеОбъединенные КАК втДанныеОбъединенные
		|
		|СГРУППИРОВАТЬ ПО
		|	втДанныеОбъединенные.Ингредиент,
		|	втДанныеОбъединенные.ЭтоХЭХ,
		|	втДанныеОбъединенные.ХимикоэнергетическаяХарактеристика
		|;
		|";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст +"
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанные.Ингредиент КАК Ингредиент,
	|	втДанные.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика,
	|	втДанные.ПроцентПотерь КАК ПроцентПотерь,
	|	втДанные.ЭтоХЭХ КАК ЭтоХЭХ
	|ИЗ
	|	"+?(ГруппаХЭХЗадана,"втДанныеСгруппированные","втДанные")+" КАК втДанные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ингредиент,
	|	ЭтоХЭХ,
	|	ХимикоэнергетическаяХарактеристика
	|ИТОГИ ПО
	|	Ингредиент
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ВидОбработки", ВидОбработки);
	Запрос.УстановитьПараметр("ГруппаХЭХ", ГруппаХЭХПоУмолчанию);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИнгредиент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИнгредиент.Следующий() Цикл
		
		// ВЫБОРКА ПО ИНГРЕДИЕНТАМ
		
		ВыборкаДетальныеЗаписи = ВыборкаИнгредиент.Выбрать();
		
		// Запоминаем, сколько строк по комбинации ингредиент + вид обработки.
		КоличествоЭлементовПоВидуОбработки = ВыборкаДетальныеЗаписи.Количество();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			// ДЕТАЛЬНАЯ ВЫБОРКА
			
			Если ВыборкаДетальныеЗаписи.ЭтоХЭХ Тогда
				
				// Запись для ХЭХ
				
				// Заполнение таблицы ХЭХ
				НовСтрокаХЭХ = ТаблицаХЭХ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаХЭХ, ВыборкаДетальныеЗаписи);
				НовСтрокаХЭХ.ВидОбработки = ВидОбработки;
				
				// Если запись для ХЭХ единственная и для вида обработки в целом ничего не задано,
				// все равно необходимо добавить строку в таблицу ингредиентов/видов обработки и в дерево 
				// видов обработок с пустым процентом потерь для корректного отбора по строкам.
				Если КоличествоЭлементовПоВидуОбработки = 1 Тогда
					
					// Заполнение таблицы ингредиентов/видов обработки
					НовСтрокаИнгрВидыОбработкиДляХЭХ = ТаблицаИнгредиентыВидыОбработки.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрокаИнгрВидыОбработкиДляХЭХ, ВыборкаДетальныеЗаписи,,"ПроцентПотерь");
					НовСтрокаИнгрВидыОбработкиДляХЭХ.ВидОбработки = ВидОбработки;
					НовСтрокаИнгрВидыОбработкиДляХЭХ.ТипОбработки = ТипОбработки;
					
				КонецЕсли;
				
			Иначе
				
				// Это запись для вида обработки, не для ХЭХ
				
				// Заполнение таблицы ингредиентов/видов обработки
				НовСтрокаИнгрВидыОбработки = ТаблицаИнгредиентыВидыОбработки.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаИнгрВидыОбработки, ВыборкаДетальныеЗаписи);
				НовСтрокаИнгрВидыОбработки.ВидОбработки = ВидОбработки;
				НовСтрокаИнгрВидыОбработки.ТипОбработки = ТипОбработки;
				
			КонецЕсли; // ЭтоХЭХ
			
		КонецЦикла; // Детальная выборка
		
	КонецЦикла; // Выборка по ингредиентам
	
КонецПроцедуры

#КонецОбласти

#Область РасчетКалорийности

// Функция формирует таблицу значений с ХЭХ и их количеством, используемых в переданной номенклатуре.
//
// Параметры:
//  ТекущаяНоменклатура	 - СправочникСсылка.Номенклатура - Ссылка на номенклутуру, для которой получаем ХЭХ.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Содержит колонки: ХимикоэнергетическаяХарактеристика, 
//   КоличествоХарактеристикиИсходное, КоличествоХарактеристики, ЕдиницаИзмерения.
//
&НаСервере
Функция СформироватьТаблицуСоставХЭХ(ТекущаяНоменклатура)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика,
	|	ХимикоэнергетическиеХарактеристики.КоличествоХарактеристики КАК КоличествоХарактеристикиИсходное,
	|	ХимикоэнергетическиеХарактеристики.КоличествоХарактеристики КАК КоличествоХарактеристики,
	|	питХимикоэнергетическиеХарактеристики.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.питХимикоэнергетическиеХарактеристики КАК ХимикоэнергетическиеХарактеристики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питХимикоэнергетическиеХарактеристики КАК питХимикоэнергетическиеХарактеристики
	|		ПО ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика = питХимикоэнергетическиеХарактеристики.Ссылка
	|ГДЕ
	|	ХимикоэнергетическиеХарактеристики.Номенклатура = &Номенклатура
	|	И ХимикоэнергетическиеХарактеристики.Рецептура = &Рецептура";
	
	Запрос.УстановитьПараметр("Номенклатура", ТекущаяНоменклатура);
	Запрос.УстановитьПараметр("Рецептура", Документы.питРецептура.ПустаяСсылка());
	Результат = Запрос.Выполнить();
	СоставХЭХ = СформироватьПустуюТаблицуХЭХ();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			НовСтрокаТаблицы = СоставХЭХ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаТаблицы, Выборка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СоставХЭХ;
	
КонецФункции

// Функция возвращает пустую таблицу для ХЭХ.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Содержит колонки: ХимикоэнергетическаяХарактеристика, 
//   КоличествоХарактеристикиИсходное, КоличествоХарактеристики, ЕдиницаИзмерения.
//
&НаСервере
Функция СформироватьПустуюТаблицуХЭХ()
	
	СоставХЭХ = Новый ТаблицаЗначений;
	МассивТипов = Новый Массив(1);
	МассивТипов[0] = (Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(МассивТипов);
	СоставХЭХ.Колонки.Добавить("ХимикоэнергетическаяХарактеристика", Новый ОписаниеТипов("СправочникСсылка.питХимикоэнергетическиеХарактеристики"));
	СоставХЭХ.Колонки.Добавить("КоличествоХарактеристикиИсходное", ОписаниеТиповЧ);
	СоставХЭХ.Колонки.Добавить("КоличествоХарактеристики", ОписаниеТиповЧ);
	СоставХЭХ.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	
	Возврат СоставХЭХ;
	
КонецФункции

// Функция получает калорийность переданного ингредиента с возможность учесть потерь при видах обработки.
//
// Параметры:
//  Ингредиент					 - СправочникСсылка.Номенклатура - Ссылка на ингредиент, для которого считаем калорийность.
//  СУчетомПотерь				 - Булево - С учетом потерь или без.
//  ВидОбработки				 - СправочникСсылка.питВидыОбработкиСырья - Вид обработки, по которому считаем потери
//   Если не задан, то считаем для всех видов обработки.
//  ПроцентПотерьВидаОбработки	 - Число - Процент потерь переданного вида обработки.
// 
// Возвращаемое значение:
//  Число - Значение калорийности в ккал.
//
&НаСервере
Функция ПолучитьКалорийностьИнгредиента(Ингредиент, СУчетомПотерь = Истина, ВидОбработки = Неопределено, ПроцентПотерьВидаОбработки = 0)
	
	СоставХЭХ		= СформироватьТаблицуСоставХЭХ(Ингредиент);
	
	Если СУчетомПотерь Тогда
		
		Если ВидОбработки = Неопределено Тогда // С учетом всех видов потерь.
			
			// Обход дерева ингредиентов и пересчет для каждого из видов обработки.
			Для каждого ТекВетка Из ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы() Цикл
				Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
					ПересчитатьКоличествоХЭХДляВидаОбработки(СоставХЭХ, Ингредиент, ТекЭлементВетки.Группировка, ТекЭлементВетки.ПроцентПотерь);
				КонецЦикла;
			КонецЦикла;
			
		Иначе // Для конкретного вида обработки.
			ПересчитатьКоличествоХЭХДляВидаОбработки(СоставХЭХ, Ингредиент, ВидОбработки, ПроцентПотерьВидаОбработки);
		КонецЕсли;
		
	КонецЕсли;
	
	// Подсчет калорийности.
	ТекКалорийность	= питДиетпитание.РассчитатьКалорийность(СоставХЭХ, ФормулаРасчетаКалорийности, , , Истина);
	
	Возврат ТекКалорийность;
	
КонецФункции

// Процедура пересчитывает количества ХЭХ с учетом потерь переданного вида обработки и потерь ХЭХ для переданного вида обработки.
//
// Параметры:
//  СоставХЭХ 					 - ТаблицаЗначений - Таблица состава ХЭХ.
//  Ингредиент					 - СправочникСсылка.Номенклатура - Ссылка на ингредиент, для которого считаем калорийность.
//  ВидОбработки				 - СправочникСсылка.питВидыОбработкиСырья - Вид обработки, по которому считаем потери
//   Если не задан, то считаем для всех видов обработки.
//  ПроцентПотерьВидаОбработки	 - Число - Процент потерь переданного вида обработки.
//
&НаСервере
Процедура ПересчитатьКоличествоХЭХДляВидаОбработки(СоставХЭХ, Ингредиент, ВидОбработки, ПроцентПотерьВидаОбработки)
	
	Для каждого ТекСтрокаСостава Из СоставХЭХ Цикл
		
		// Общий процент для вида обработки в целом
		ТекКоэффициентПотери = (100 - ПроцентПотерьВидаОбработки)/100;
		ТекКоличествоХарактеристики = ТекСтрокаСостава.КоличествоХарактеристики;
		ТекКоличествоХарактеристики = ТекКоличествоХарактеристики * ТекКоэффициентПотери;
		
		// Потери ХЭХ.
		НайденныеСтрокиТаблицаХЭХ = ТаблицаХЭХ.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки, ХимикоэнергетическаяХарактеристика", Ингредиент, ВидОбработки, ТекСтрокаСостава.ХимикоэнергетическаяХарактеристика));
		Если НайденныеСтрокиТаблицаХЭХ.Количество() Тогда
			
			ПотериХЭХ = НайденныеСтрокиТаблицаХЭХ[0];
			ТекКоэффициентПотери = (100 - ПотериХЭХ.ПроцентПотерь)/100;
			ТекКоличествоХарактеристики = ТекКоличествоХарактеристики * ТекКоэффициентПотери;
			
		КонецЕсли;
		
		ТекСтрокаСостава.КоличествоХарактеристики = ТекКоличествоХарактеристики;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедурасчитает калорийность переданного ингредиента и выводит информацию на форму в зависимости от вида обработки.
//
// Параметры:
//  Ингредиент					 - СправочникСсылка.Номенклатура - Ссылка на ингредиент, для которого считаем калорийность.
//  СУчетомПотерь				 - Булево - С учетом потерь или без.
//  ВидОбработки				 - СправочникСсылка.питВидыОбработкиСырья - Вид обработки, по которому считаем потери
//   Если не задан, то считаем для всех видов обработки.
//  ПроцентПотерьВидаОбработки	 - Число - Процент потерь переданного вида обработки.
//
&НаСервере
Процедура ОбновитьКалорийностиНаФорме(Ингредиент, СУчетомПотерь = Истина, ВидОбработки = Неопределено, ПроцентПотерьВидаОбработки = Неопределено)
	
	Если СчитатьКалорийность Тогда
		
		Калорийность		= Окр(ПолучитьКалорийностьИнгредиента(Ингредиент, СУчетомПотерь, ВидОбработки, ПроцентПотерьВидаОбработки),3);
		ДанныеНоменклатуры	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ингредиент,"питЕдиницаИзмеренияДляХЭХ, питКоличествоНоменклатуры");
		
		Если РежимОтВидовОбработки Тогда
			Если ВидОбработки = Неопределено Тогда
			Иначе
				Элементы.НадписьВидыОбработкиКалорийностьПоВидуОбработки.Заголовок = "Калорийность после обработки <"+ВидОбработки+"> (на "+ДанныеНоменклатуры.питКоличествоНоменклатуры
				+" "+ДанныеНоменклатуры.питЕдиницаИзмеренияДляХЭХ+" ингредиента): <"+Калорийность+"> ккал.";
			КонецЕсли;
		Иначе
			Если ВидОбработки = Неопределено Тогда
				Элементы.НадписьИнгредиентыКалорийностьОбщая.Заголовок = "Общая калорийность (на "+ДанныеНоменклатуры.питКоличествоНоменклатуры
				+" "+ДанныеНоменклатуры.питЕдиницаИзмеренияДляХЭХ+" ингредиента): <"+Калорийность+"> ккал.";
			Иначе
				Элементы.НадписьИнгредиентыКалорийностьПоВидуОбработки.Заголовок = "Калорийность после обработки <"+ВидОбработки+"> (на "+ДанныеНоменклатуры.питКоличествоНоменклатуры
				+" "+ДанныеНоменклатуры.питЕдиницаИзмеренияДляХЭХ+" ингредиента): <"+Калорийность+"> ккал.";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Обработчик команды смены режима обработки (сервер).
//
&НаСервере
Процедура ОтВидовОбработкиСервер()
	
	// Очистка таблиц
	ОчиститьНеиспользуемыеТаблицы();
	
КонецПроцедуры

// Процедура очищает не использующиеся в текущем режиме таблицы.
//
&НаСервере
Процедура ОчиститьНеиспользуемыеТаблицы()
	
	Если РежимОтВидовОбработки Тогда
		// Очистка ветвей дерева видов обработки.
		Для каждого ТекВетка Из ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы() Цикл
			ТекВетка.ПолучитьЭлементы().Очистить();
		КонецЦикла;
	Иначе
		// Очистка таблицы ингредиентов/видов обрабоки
		ТаблицаИнгредиентыВидыОбработки.Очистить();
	КонецЕсли;
	
	// Таблицу ХЭХ чистим в любом случае, она будет перезаполнена
	ТаблицаХЭХ.Очистить();
	
КонецПроцедуры

// Процедура начального заполнения данных формы (сервер).
//
&НаСервере
Процедура ЗаполнитьДанныеСервер()
	
	// Очистка данных
	ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы().Очистить();
	ТаблицаИнгредиентыВидыОбработки.Очистить();
	ТаблицаХЭХ.Очистить();
	
	// Создание ветки холодной обработки
	ВеткаХолоднаяОбработка = ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы().Добавить();
	ВеткаХолоднаяОбработка.Группировка = Перечисления.питТипыОбработкиСырья.Холодная;
	ВеткаХолоднаяОбработка.ТипОбработки = Перечисления.питТипыОбработкиСырья.Холодная;
	ВеткаХолоднаяОбработка.ЭтоГруппировка = Истина;
	ТипОбработкиХолодная = ВеткаХолоднаяОбработка.ПолучитьИдентификатор();
	
	// Создание ветки горячей обработки
	ВеткаГорячаяОбработка = ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы().Добавить();
	ВеткаГорячаяОбработка.Группировка = Перечисления.питТипыОбработкиСырья.Горячая;
	ВеткаГорячаяОбработка.ТипОбработки = Перечисления.питТипыОбработкиСырья.Горячая;
	ВеткаГорячаяОбработка.ЭтоГруппировка = Истина;
	ТипОбработкиГорячая = ВеткаГорячаяОбработка.ПолучитьИдентификатор();
	
	// Калорийность по фиксированной формуле.
	ФормулаРасчетаКалорийности = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питФормулаРасчетаКалорийности");
	Элементы.НадписьИнгредиентыКалорийностьПоВидуОбработки.Подсказка = "Калорийность с учетом потерь от выбранного вида обработки и потерь хэх, рассчитанная по формуле: """+ФормулаРасчетаКалорийности+"""";
	Элементы.НадписьВидыОбработкиКалорийностьПоВидуОбработки.Подсказка = "Калорийность с учетом потерь от выбранного вида обработки и потерь хэх, рассчитанная по формуле: """+ФормулаРасчетаКалорийности+"""";
	Элементы.НадписьИнгредиентыКалорийностьОбщая.Подсказка = "Калорийность с учетом потерь от всех видов обработок и потерь хэх, рассчитанная по формуле: """+ФормулаРасчетаКалорийности+"""";
	СчитатьКалорийность = Истина;
	
КонецПроцедуры

// Процедура управления элементами формы на клиенте.
//
&НаКлиенте
Процедура УправлениеФормой()
	
	Если РежимОтВидовОбработки Тогда
		Элементы.ФормаОтВидовОбработкиИнгредиенты.Заголовок	= "В режим от ингредиентов   ";
		Элементы.ФормаОтВидовОбработки.Заголовок			= "В режим от ингредиентов   ";
		
		ЭтаФорма.Заголовок = "Потери при обработке сырья (Режим от видов обработки)";
		
		// Смена страницы.
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОтВидовОбработки;
		
	Иначе
		Элементы.ФормаОтВидовОбработкиИнгредиенты.Заголовок	= "В режим от видов обработки";
		Элементы.ФормаОтВидовОбработки.Заголовок			= "В режим от видов обработки";
		
		ЭтаФорма.Заголовок = "Потери при обработке сырья (Режим от ингредиентов)";
		
		// Смена страницы.
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОтИнгредиентов;
		
	КонецЕсли;
	
	Если СчитатьКалорийность Тогда
		
		Элементы.НадписьВидыОбработкиКалорийностьПоВидуОбработки.Видимость = Истина;
		Элементы.НадписьИнгредиентыКалорийностьОбщая.Видимость = Истина;
		Элементы.НадписьИнгредиентыКалорийностьПоВидуОбработки.Видимость = Истина;
		
	Иначе
		
		Элементы.НадписьВидыОбработкиКалорийностьПоВидуОбработки.Видимость = Ложь;
		Элементы.НадписьИнгредиентыКалорийностьОбщая.Видимость = Ложь;
		Элементы.НадписьИнгредиентыКалорийностьПоВидуОбработки.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура обновления отбора строк в таблице формы "ТаблицаХЭХ".
//
&НаКлиенте
Процедура ОбновитьОтборСтрокТаблицыХЭХ()
	
	ТекДанные = Элементы.ТаблицаИнгредиенты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Элементы.ТаблицаХЭХ.ОтборСтрок = Новый ФиксированнаяСтруктура("Ингредиент,ВидОбработки", "ххх", "ххх"); // Скрыть все
	Иначе
		Элементы.ТаблицаХЭХ.ОтборСтрок = Новый ФиксированнаяСтруктура("Ингредиент,ВидОбработки", ТекДанные.Ингредиент, ТекДанные.ВидОбработки);
	КонецЕсли;
	
КонецПроцедуры

// Процедура обновления отбора строк в таблице формы "ТаблицаХЭХИнгредиенты".
//
&НаКлиенте
Процедура ОбновитьОтборСтрокТаблицыХЭХИнгредиенты()
	
	ТекДанные = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если ТекДанные = Неопределено ИЛИ ТипЗнч(ТекДанные.Группировка) = Тип("ПеречислениеСсылка.питТипыОбработкиСырья") Тогда
		Элементы.ТаблицаХЭХИнгредиенты.ОтборСтрок = Новый ФиксированнаяСтруктура("Ингредиент,ВидОбработки", "ххх", "ххх"); // Скрыть все
	Иначе
		Элементы.ТаблицаХЭХИнгредиенты.ОтборСтрок = Новый ФиксированнаяСтруктура("Ингредиент,ВидОбработки", ТекДанные.Ингредиент, ТекДанные.Группировка);
	КонецЕсли;
	
КонецПроцедуры

// Процедура добавляет запись в регистр "питОбработкаСырья" по переданным значениям измерений,
//  а также удаляет служебную запись из регистра, которая необходима в момент, когда пользователь добавил ингредиент,
//  но еще не указал его виды обработки. При этом сам ингредиент отображается в динамическом списке именно благодаря 
//  служебной записи.
//
// Параметры:
//  Ингредиент				 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки			 - СправочникСсылка.питВидыОбработкиСырья - Ссылка на добавляемый вид обработки.
//  УдалятьСлужебныйЭлемент	 - Булево - Флаг удаления служебной записи.
//
&НаСервереБезКонтекста
Процедура ДобавитьЗаписьИнгредиентВидОбработкиВРегистр(Ингредиент, ВидОбработки, УдалятьСлужебныйЭлемент)
	
	Обработки.питПотериПриОбработкеСырья.ДобавитьЗаписьИнгредиентВидОбработкиВРегистр(Ингредиент, ВидОбработки, УдалятьСлужебныйЭлемент);
	
КонецПроцедуры

// Функция обновляет запись РС "питВидыОбработки" по переданным значениям измерений и ресурса "ПроцентПотерь".
//
// Параметры:
//  Ингредиент		 - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки	 - СправочникСсылка.питВидыОбработкиСырья - Ссылка на добавляемый вид обработки.
//  ХЭХ				 - СправочникСсылка.питХимикоэнергетическиеХарактеристики - Ссылка на добавляемый ХЭХ.
//  ПроцентПотерь	 - Число - Новое значение процента потерь.
//
&НаСервере
Процедура ОбновитьПроцентПотерьСервер(Ингредиент, ВидОбработки, ХЭХ = Неопределено, ПроцентПотерь)
	
	Обработки.питПотериПриОбработкеСырья.ОбновитьПроцентПотерьСервер(Ингредиент, ВидОбработки, ХЭХ , ПроцентПотерь);
	
	////////////////
	// Калорийность.
	Если НЕ РежимОтВидовОбработки Тогда
		ОбновитьКалорийностиНаФорме(Ингредиент);
	КонецЕсли;
	
	// Установка процента потерь тек. вида обработки.
	ПроцентПотерьВидаОбработки = 0;
	Если ХЭХ = Неопределено Тогда
		// Процент потерь для вида обработки передан напрямую, ничего не ищем
		ПроцентПотерьВидаОбработки = ПроцентПотерь;
	Иначе
		// Переданный процент - это процент потерь ХЭХ, ищем процент потерь для вида обработки.
		Если РежимОтВидовОбработки Тогда
			// В режиме от видов обработки ищем в таблице ингредиентов-видов обработки
			СтрокиИнгредиентыВидыОбработки = ТаблицаИнгредиентыВидыОбработки.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки", Ингредиент, ВидОбработки));
			Если СтрокиИнгредиентыВидыОбработки.Количество() Тогда
				ПроцентПотерьВидаОбработки = СтрокиИнгредиентыВидыОбработки[0].ПроцентПотерь;
			КонецЕсли;
		Иначе
			// В режиме от ингредиентов ищем в дереве видов обработки
			Для каждого ТекВетка Из ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы() Цикл
				Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
					Если ТекЭлементВетки.Группировка = ВидОбработки И ТекЭлементВетки.Ингредиент = Ингредиент Тогда
						ПроцентПотерьВидаОбработки = ТекЭлементВетки.ПроцентПотерь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	////////////////
	
	ОбновитьКалорийностиНаФорме(Ингредиент,,ВидОбработки, ПроцентПотерьВидаОбработки);
	
КонецПроцедуры


