// Обработчик события "ПередНачаломДобавления" таблицы формы "ТаблицаХЭХ".
//
&НаКлиенте
Процедура ТаблицаХЭХПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанныеИнгредиенты = Элементы.ТаблицаИнгредиенты.ТекущиеДанные;
	Если ТекДанныеИнгредиенты = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен ингредиент в таблице ингредиентов!");
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
	ФормаВыбора = ПолучитьФорму("Справочник.питХимикоэнергетическиеХарактеристики.ФормаВыбора",ПараметрыВыбора,Элемент);
	ФормаВыбора.Открыть();
	
