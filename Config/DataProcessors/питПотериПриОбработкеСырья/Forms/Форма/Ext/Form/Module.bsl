// Обработчик события "ПриАктивизацииСтроки" таблицы формы "ВидыОбработкиСписок".
//
&НаКлиенте
Процедура ВидыОбработкиСписокПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ВидыОбработкиСписок.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено И ТекДанные.Свойство("ГруппировкаСтроки") Тогда
		ТекДанные = Неопределено;
		ТаблицаИнгредиентыВидыОбработки.Очистить();
		ТаблицаХЭХ.Очистить();
	КонецЕсли;
	
	Если ТекДанные = Неопределено Тогда
		ТекущийВидОбработки = Неопределено;
	ИначеЕсли ТекДанные.Ссылка = ТекущийВидОбработки Тогда
		Возврат;
	Иначе
		ТекущийВидОбработки = ТекДанные.Ссылка;
		ПодключитьОбработчикОжидания("ЗаполнитьДанныеПоВидуОбработкиКлиент", 0.5, Истина);
	КонецЕсли;
	
КонецПроцедуры

