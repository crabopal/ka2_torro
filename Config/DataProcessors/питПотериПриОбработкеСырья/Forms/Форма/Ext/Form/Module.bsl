// Обработчик события "Выбор" таблицы формы "ТаблицаИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаИнгредиентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.ТаблицаИнгредиентыИнгредиент Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Ингредиент);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Обработчик события "ПередНачаломДобавления" таблицы формы "ТаблицаИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаИнгредиентыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	// Должен быть установлен вид обработки.
	ТекДанныеВидыОбработки = Элементы.ВидыОбработкиСписок.ТекущиеДанные;
	Если НЕ ТекДанныеВидыОбработки = Неопределено И ТекДанныеВидыОбработки.Свойство("ГруппировкаСтроки") Тогда
		ТекДанныеВидыОбработки = Неопределено;
	КонецЕсли;
	Если ТекДанныеВидыОбработки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в списке видов обработки!");
		Возврат;
	КонецЕсли;
	
	// Открытие формы выбора.
	ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
	ФормаВыбора = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора,Элемент);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

// Обработчик события "ОбработкаВыбора" таблицы формы "ТаблицаИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаИнгредиентыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Должен быть установлен вид обработки.
	ТекДанныеВидыОбработки = Элементы.ВидыОбработкиСписок.ТекущиеДанные;
	Если НЕ ТекДанныеВидыОбработки = Неопределено И ТекДанныеВидыОбработки.Свойство("ГруппировкаСтроки") Тогда
		ТекДанныеВидыОбработки = Неопределено;
	КонецЕсли;
	Если ТекДанныеВидыОбработки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в списке видов обработки!");
		Возврат;
	КонецЕсли;
	
	ТекВидОбработки = ТекДанныеВидыОбработки.Ссылка;
	ТекТипОбработки = ТекДанныеВидыОбработки.ТипОбработкиСырья;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		// Добавление записи по выбранному виду обработки в регистр.
		ДобавитьИнгредиентПоВидуОбработкиСервер(ВыбранноеЗначение, ТекВидОбработки, ТекТипОбработки);
		
		ОбновитьОтборСтрокТаблицыХЭХ();
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПередУдалением" таблицы формы "ТаблицаИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаИнгредиентыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		УдалитьИнгредиентПоВидуОбработкиСервер(ТекДанные.Ингредиент, ТекДанные.ВидОбработки, ТекДанные.ТипОбработки);
	КонецЕсли;
КонецПроцедуры

// Обработчик события "ПриАктивизацииСтроки" таблицы формы "ТаблицаИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаИнгредиентыПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийИнгредиентТаблица = Неопределено;
		Элементы.НадписьВидыОбработкиКалорийностьПоВидуОбработки.Заголовок = "";
	ИначеЕсли ТекДанные.Ингредиент = ТекущийИнгредиентТаблица Тогда
		Возврат;
	Иначе
		ТекущийИнгредиентТаблица = ТекДанные.Ингредиент;
		
		ОбновитьОтборСтрокТаблицыХЭХ();
		
		// Калорийность.
		ТекДанные = Элементы.ТаблицаИнгредиенты.ТекущиеДанные;
		ОбновитьКалорийностиНаФорме(ТекДанные.Ингредиент,,ТекДанные.ВидОбработки,ТекДанные.ПроцентПотерь);
		
	КонецЕсли;
	
КонецПроцедуры

