// Обработчик события "ОбработкаВыбора" таблицы формы "ТаблицаХЭХ".
//
&НаКлиенте
Процедура ТаблицаХЭХОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанныеИнгредиенты = Элементы.ТаблицаИнгредиенты.ТекущиеДанные;
	Если ТекДанныеИнгредиенты = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен ингредиент в таблице ингредиентов!");
		Возврат;
	КонецЕсли;
	
	ТекВидОбработки = ТекДанныеИнгредиенты.ВидОбработки;
	ТекТипОбработки = ТекДанныеИнгредиенты.ТипОбработки;
	ТекИнгредиент = ТекДанныеИнгредиенты.Ингредиент;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.питХимикоэнергетическиеХарактеристики") Тогда
		
		ДобавитьХЭХПоВидуОбработкиСервер(ВыбранноеЗначение, ТекИнгредиент, ТекВидОбработки, ТекТипОбработки);
		
		НайденныеСтроки = ТаблицаИнгредиентыВидыОбработки.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки", ТекИнгредиент, ТекВидОбработки));
		Если НайденныеСтроки.Количество() Тогда
			Элементы.ТаблицаИнгредиенты.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаХЭХ.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки, ХимикоэнергетическаяХарактеристика", ТекИнгредиент, ТекВидОбработки, ВыбранноеЗначение));
		Если НайденныеСтроки.Количество() Тогда
			Элементы.ТаблицаХЭХ.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;
		
		ОбновитьОтборСтрокТаблицыХЭХ();
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПередУдалением" таблицы формы "ТаблицаХЭХ".
//
&НаКлиенте
Процедура ТаблицаХЭХПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	
	ТекДанныеИнгредиенты = Элементы.ТаблицаИнгредиенты.ТекущиеДанные;
	Если ТекДанныеИнгредиенты = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен ингредиент в таблице ингредиентов!");
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		УдалитьХЭХПоВидуОбработкиСервер(ТекДанные.ХимикоэнергетическаяХарактеристика, ТекДанные.Ингредиент, ТекДанные.ВидОбработки, ТекДанныеИнгредиенты.ТипОбработки);
		
		НайденныеСтроки = ТаблицаИнгредиентыВидыОбработки.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки", ТекДанные.Ингредиент, ТекДанные.ВидОбработки));
		Если НайденныеСтроки.Количество() Тогда
			Элементы.ТаблицаИнгредиенты.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаХЭХ.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки, ХимикоэнергетическаяХарактеристика", ТекДанные.Ингредиент, ТекДанные.ВидОбработки, ТекДанные.Ингредиент, ТекДанные.ХимикоэнергетическаяХарактеристика));
		Если НайденныеСтроки.Количество() Тогда
			Элементы.ТаблицаХЭХ.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

// Обработчик события "Выбор" таблицы формы "ТаблицаХЭХ".
