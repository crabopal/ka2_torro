Процедура ПодборИнгредиентыСписок(Команда)
	
	// Открытие формы выбора
	ПараметрыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Ложь);
	ФормаВыбора = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора,Элементы.ИнгредиентыСписок);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

// Обработчик команды "ИнгредиентыСписокУдалить".
//
&НаКлиенте
Процедура ИнгредиентыСписокУдалить(Команда)
	ИнгредиентыСписокУдаление();
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область РежимОтВидовОбработки

#Область ОбработчикиСобытийТаблицаИнгредиентовПоВидамОбработки

// Обработчик команды "ПодборТаблицаИнгредиенты".
//
&НаКлиенте
Процедура ПодборТаблицаИнгредиенты(Команда)
	
	ТекДанныеВидыОбработки = Элементы.ВидыОбработкиСписок.ТекущиеДанные;
	Если НЕ ТекДанныеВидыОбработки = Неопределено И ТекДанныеВидыОбработки.Свойство("ГруппировкаСтроки") Тогда
		ТекДанныеВидыОбработки = Неопределено;
	КонецЕсли;
	
	Если ТекДанныеВидыОбработки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в списке видов обработки!");
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбора = Новый Структура("РежимВыбора,ЗакрыватьПриВыборе", Истина, Ложь);
	ФормаВыбора = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора,Элементы.ТаблицаИнгредиенты);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицаХЭХПоВидамОбработки

