#Область ОбработчикиСобытийФормы

// Обработчик события формы "ПриСоданииНаСервере"
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Если Параметры.Свойство("АвтоТест") Тогда
	
		Возврат;
	КонецЕсли;
	
	// При старте обработки режим устанавливается в "От видов обработки"
	РежимОтВидовОбработки = Истина;
	
	// Первоначальное заполнение
	ЗаполнитьДанныеСервер();
	
КонецПроцедуры

// Обработчик события формы "ПриОткрытии"
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Управления формой (пользовательская видимость и т.д.).
	УправлениеФормой();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область РежимОтИнгредиентов

#Область ОбработчикиСобытийТаблицаХЭХПоИнгредиентам

// Обработчик события "ПередНачаломДобавления" таблицы формы "ТаблицаХЭХИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат; // Копирование запрещено.
	КонецЕсли;
	
	ТекДанныеДерево = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если НЕ ТекДанныеДерево = Неопределено И ТипЗнч(ТекДанныеДерево.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		
		// Открытие формы выбора.
		ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
		ФормаВыбора = ПолучитьФорму("Справочник.питХимикоэнергетическиеХарактеристики.ФормаВыбора",ПараметрыВыбора,Элемент);
		ФормаВыбора.Открыть();
		
	Иначе // Необходимо, чтобы был установлен вид обработки в дереве, иначе не понятно, для кого ХЭХ.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в дереве видов обработки!");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "Выбор" таблицы формы "ТаблицаХЭХИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.ТаблицаХЭХИнгредиентыХимикоэнергетическаяХарактеристика Тогда
		
		// Если фокус на колонке "ХЭХ", то открываем значение.
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.ХимикоэнергетическаяХарактеристика);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ОбработкаВыбора" таблицы формы "ТаблицаХЭХИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанныеДерево = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если НЕ ТекДанныеДерево = Неопределено И ТипЗнч(ТекДанныеДерево.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		
		ТекВидОбработки = ТекДанныеДерево.Группировка;
		ТекТипОбработки = ТекДанныеДерево.ТипОбработки;
		ТекИнгредиент = ТекДанныеДерево.Ингредиент;
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.питХимикоэнергетическиеХарактеристики") Тогда
			
			// Добавляем запись по выбранному ХЭХ в регистр.
			ДобавитьХЭХПоИнгредиентуСервер(ВыбранноеЗначение, ТекИнгредиент, ТекВидОбработки);
			
			// Установка текущей строки для дерева видов обработок и таблицы хэх.
			Если ТекТипОбработки = ПредопределенноеЗначение("Перечисление.питТипыОбработкиСырья.Горячая") Тогда
				ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиГорячая);
			Иначе
				ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиХолодная);
			КонецЕсли;
			Если НЕ ТекВетка = Неопределено Тогда
				Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
					Если ТекЭлементВетки.Группировка = ТекВидОбработки И ТекЭлементВетки.Ингредиент = ТекИнгредиент Тогда
						Элементы.ДеревоИнгредиентыВидыОбработки.ТекущаяСтрока = ТекЭлементВетки.ПолучитьИдентификатор();
					КонецЕсли;
				КонецЦикла;
				НайденныеСтроки = ТаблицаХЭХ.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки, ХимикоэнергетическаяХарактеристика", ТекИнгредиент, ТекВидОбработки, ВыбранноеЗначение));
				Если НайденныеСтроки.Количество() Тогда
					Элементы.ТаблицаХЭХИнгредиенты.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
				КонецЕсли;
			КонецЕсли;
			
			// Обновление отбора строк.
			ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
			
		КонецЕсли;
		
	Иначе // Необходимо, чтобы был установлен вид обработки в дереве, иначе не понятно, для кого ХЭХ.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в дереве видов обработки!");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПередУдалением" таблицы формы "ТаблицаХЭХИнгредиенты".
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекДанныеДерево = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если НЕ ТекДанныеДерево = Неопределено И ТипЗнч(ТекДанныеДерево.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		
		ТекДанные = Элемент.ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда
			
			// Удаление записей из регистра.
			УдалитьХЭХПоВидуИнгредиентуСервер(ТекДанные.ХимикоэнергетическаяХарактеристика, ТекДанные.Ингредиент, ТекДанные.ВидОбработки);
			
			// Установка текущей строки
			Для каждого ТекВетка Из ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы() Цикл
				Если НЕ ТекВетка = Неопределено Тогда
					Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
						Если ТекЭлементВетки.Группировка = ТекДанные.ВидОбработки И ТекЭлементВетки.Ингредиент = ТекДанные.Ингредиент Тогда
							Элементы.ДеревоИнгредиентыВидыОбработки.ТекущаяСтрока = ТекЭлементВетки.ПолучитьИдентификатор();
						КонецЕсли;
					КонецЦикла;
					НайденныеСтроки = ТаблицаХЭХ.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки, ХимикоэнергетическаяХарактеристика",  ТекДанные.Ингредиент, ТекДанные.ВидОбработки, ТекДанные.ХимикоэнергетическаяХарактеристика));
					Если НайденныеСтроки.Количество() Тогда
						Элементы.ТаблицаХЭХИнгредиенты.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в дереве видов обработки!");
		Возврат;
	КонецЕсли;
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийДеревоИнгредиентов

// Обработчик события "Выбор" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено 
		И Элемент.ТекущийЭлемент = Элементы.ДеревоИнгредиентыВидыОбработкиГруппировка Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Группировка);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПриАктивизацииСтроки" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиПриАктивизацииСтроки(Элемент)
	
	// Обновление отбора в таблице ХЭХ
	ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
	
	// Калорийность.
	ТекДанные = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если ТекДанные = Неопределено ИЛИ ТипЗнч(ТекДанные.Группировка) = Тип("ПеречислениеСсылка.питТипыОбработкиСырья") Тогда
		Элементы.НадписьИнгредиентыКалорийностьПоВидуОбработки.Заголовок = "";
	Иначе
		ОбновитьКалорийностиНаФорме(ТекДанные.Ингредиент,,ТекДанные.Группировка,ТекДанные.ПроцентПотерь);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПередНачаломДобавления" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат; // Копирование запрещено.
	КонецЕсли;
	
	// Проверка установленности ингредиента в списке ингредиентов.
	ТекДанныеИнгредиенты = Элементы.ИнгредиентыСписок.ТекущиеДанные;
	Если ТекДанныеИнгредиенты = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен ингредиент в списке ингредиентов!");
		Возврат;
	КонецЕсли;
	
	// Открытие формы выбора.
	ПараметрыВыбора = Новый Структура("РежимВыбора, ЭтоФормаВидовОбработки", Истина, Истина);
	ФормаВыбора = ПолучитьФорму("Справочник.питВидыОбработкиСырья.ФормаВыбора",ПараметрыВыбора,Элемент);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

// Обработчик события "ОбработкаВыбора" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Проверка установленности ингредиента в списке ингредиентов.
	ТекДанныеИнгредиенты = Элементы.ИнгредиентыСписок.ТекущиеДанные;
	Если ТекДанныеИнгредиенты = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен ингредиент в списке ингредиентов!");
		Возврат;
	КонецЕсли;
	
	ТекИнгредиент = ТекДанныеИнгредиенты.Ингредиент;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		// Обработка структуры с видом и типом обработки, пришедшей из формы выбора.
		
		ТекВидОбработки = Неопределено;
		ТекТипОбработки = Неопределено;
		Если ВыбранноеЗначение.Свойство("ВидОбработки",ТекВидОбработки) Тогда
			Если ВыбранноеЗначение.Свойство("ТипОбработки",ТекТипОбработки) Тогда
				
				// Добавление запись по выбранному виду обработки в регистр.
				ДобавитьВидОбработкиПоИнгредиентуСервер(ТекВидОбработки, ТекИнгредиент);
				
				ОбновитьТаблицыРежимИнгредиентов();
				
				// Обновление текущей строки.
				Если ТекТипОбработки = ПредопределенноеЗначение("Перечисление.питТипыОбработкиСырья.Горячая") Тогда
					ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиГорячая);
				Иначе
					ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиХолодная);
				КонецЕсли;
				Если НЕ ТекВетка = Неопределено Тогда
					Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
						Если ТекЭлементВетки.Группировка = ТекВидОбработки И ТекЭлементВетки.Ингредиент = ТекИнгредиент Тогда
							Элементы.ДеревоИнгредиентыВидыОбработки.ТекущаяСтрока = ТекЭлементВетки.ПолучитьИдентификатор();
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У выбираемого вида обработки должен быть задан тип!");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПередУдалением" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено И ТипЗнч(ТекДанные.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		// Только для видов обработки.
		
		УдалитьВидОбработкиПоИнгредиентуСервер(ТекДанные.Группировка, ТекДанные.Ингредиент);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийСписокИнгредиентов

// Обработчик события "Выбор" таблицы формы "ИнгредиентыСписок".
//
&НаКлиенте
Процедура ИнгредиентыСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Ингредиент);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Обработчик события "ОбработкаВыбора" таблицы формы "ИнгредиентыСписок".
//
&НаКлиенте
Процедура ИнгредиентыСписокОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Добавить запись в регистр.
	ДобавитьИнгредиентВСписокНаСервере(ВыбранноеЗначение);
	
	// Установка текущей строки в динамическом списке
	ТекСтр = Неопределено;
	Счетчик = 0;
	Пока Истина Цикл
		Счетчик = Счетчик + 1;
		ТекДанные=Элементы.ИнгредиентыСписок.ДанныеСтроки(Счетчик);
		Если ТекДанные = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ТекДанные.Ингредиент = ВыбранноеЗначение Тогда
			ТекСтр = Счетчик;
			Прервать;
		КонецЕсли; 
	КонецЦикла; 
	Если Не ТекСтр = Неопределено Тогда
		Элементы.ИнгредиентыСписок.ТекущаяСтрока = ТекСтр;
	КонецЕсли;
	
	ОбновитьТаблицыРежимИнгредиентов();
	
КонецПроцедуры

// Обработчик события "ПриАктивизацииСтроки" таблицы формы "ИнгредиентыСписок".
//
&НаКлиенте
Процедура ИнгредиентыСписокПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ИнгредиентыСписок.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено И ТекДанные.ЭтоГруппа Тогда
		
		ТекДанные = Неопределено;
		Для каждого ТекВетка Из ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы() Цикл
			ТекВетка.ПолучитьЭлементы().Очистить();
		КонецЦикла;
		ТаблицаХЭХ.Очистить();
		
		// Калорийность.
		Элементы.НадписьИнгредиентыКалорийностьОбщая.Заголовок = "";
		
	КонецЕсли;
	
	// Защита от бесконечных вызовов "При активизации строки"(из-за обращения на сервер).
	Если ТекДанные = Неопределено Тогда
		ТекущийИнгредиент = Неопределено;
		ОбновитьТаблицыРежимИнгредиентов();
	ИначеЕсли ТекДанные.Ингредиент = ТекущийИнгредиент Тогда
		Возврат;
	Иначе
		ТекущийИнгредиент = ТекДанные.Ингредиент;
		// Вызываем заполнение детальных таблиц и прочего по обработчику ожидания.
		ПодключитьОбработчикОжидания("ЗаполнитьДанныеПоИнгредиентуКлиент", 0.5, Истина);
	КонецЕсли;
	
КонецПроцедуры

