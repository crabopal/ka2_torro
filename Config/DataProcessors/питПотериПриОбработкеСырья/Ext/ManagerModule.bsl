#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Процедура заполнения детальных таблиц по ингредиенту.
//
// Параметры:
//  Ингредиент - Произвольный - Ингредиент.
//  ДеревоИнгредиентыВидыОбработки - ДеревоЗначений - Дерево ингредиенты виды обработки.
//  ТаблицаХЭХ - ТаблицаЗначений - Таблица хэх.
//  ТипОбработкиХолодная - Произвольный - Тип обработки холодная.
//  ТипОбработкиГорячая - Произвольный - Тип обработки горячая.
//
Процедура ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент, ДеревоИнгредиентыВидыОбработки, ТаблицаХЭХ, ТипОбработкиХолодная, ТипОбработкиГорячая) Экспорт
	
	// Очистка данных.
	ВеткаХолоднаяОбработка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиХолодная);
	Если ВеткаХолоднаяОбработка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВеткаГорячаяОбработка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиГорячая);
	Если ВеткаГорячаяОбработка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВеткаХолоднаяОбработка.ПолучитьЭлементы().Очистить();
	ВеткаГорячаяОбработка.ПолучитьЭлементы().Очистить();
	ТаблицаХЭХ.Очистить();
	
	ГруппаХЭХПоУмолчанию = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питГруппаХЭХПоУмолчанию");
	ГруппаХЭХЗадана = ЗначениеЗаполнено(ГруппаХЭХПоУмолчанию);
	
	// Запрос, получающий данные регистра для заполнения таблиц формы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питОбработкаСырья.ВидОбработкиСырья КАК ВидОбработкиСырья,
	|	питОбработкаСырья.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика,
	|	питОбработкаСырья.ПроцентПотерь КАК ПроцентПотерь,
	|	питВидыОбработкиСырья.ТипОбработкиСырья КАК ТипОбработки,
	|	ВЫБОР
	|		КОГДА питОбработкаСырья.ХимикоэнергетическаяХарактеристика = ЗНАЧЕНИЕ(Справочник.питХимикоэнергетическиеХарактеристики.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоХЭХ
	|ПОМЕСТИТЬ втДанные
	|ИЗ
	|	РегистрСведений.питОбработкаСырья КАК питОбработкаСырья
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питВидыОбработкиСырья КАК питВидыОбработкиСырья
	|		ПО питОбработкаСырья.ВидОбработкиСырья = питВидыОбработкиСырья.Ссылка
	|ГДЕ
	|	питОбработкаСырья.Ингредиент = &Ингредиент
	|	И питОбработкаСырья.ВидОбработкиСырья <> ЗНАЧЕНИЕ(Справочник.питвидыобработкисырья.ПустаяСсылка)
	|;
	|";
	Если ГруппаХЭХЗадана Тогда
		Запрос.Текст = Запрос.Текст +"
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	питХимикоэнергетическиеХарактеристики.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ втХЭХ
		|ИЗ
		|	Справочник.питХимикоэнергетическиеХарактеристики КАК питХимикоэнергетическиеХарактеристики
		|ГДЕ
		|	питХимикоэнергетическиеХарактеристики.ГруппаХЭХ = &ГруппаХЭХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанные.ВидОбработкиСырья КАК ВидОбработкиСырья,
		|	втДанные.ТипОбработки КАК ТипОбработки
		|ПОМЕСТИТЬ втДляХЭХ
		|ИЗ
		|	втДанные КАК втДанные
		|
		|СГРУППИРОВАТЬ ПО
		|	втДанные.ВидОбработкиСырья,
		|	втДанные.ТипОбработки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанные.ВидОбработкиСырья КАК ВидОбработкиСырья,
		|	втДанные.ПроцентПотерь КАК ПроцентПотерь,
		|	втДанные.ТипОбработки КАК ТипОбработки,
		|	втДанные.ЭтоХЭХ КАК ЭтоХЭХ,
		|	втДанные.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика
		|ПОМЕСТИТЬ втДанныеОбъединенные
		|ИЗ
		|	втДанные КАК втДанные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	втДляХЭХ.ВидОбработкиСырья,
		|	0,
		|	втДляХЭХ.ТипОбработки,
		|	ИСТИНА,
		|	втХЭХ.Ссылка
		|ИЗ
		|	втДляХЭХ КАК втДляХЭХ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втХЭХ КАК втХЭХ
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанныеОбъединенные.ВидОбработкиСырья КАК ВидОбработкиСырья,
		|	СУММА(втДанныеОбъединенные.ПроцентПотерь) КАК ПроцентПотерь,
		|	втДанныеОбъединенные.ТипОбработки КАК ТипОбработки,
		|	втДанныеОбъединенные.ЭтоХЭХ КАК ЭтоХЭХ,
		|	втДанныеОбъединенные.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика
		|ПОМЕСТИТЬ втДанныеСгруппированные
		|ИЗ
		|	втДанныеОбъединенные КАК втДанныеОбъединенные
		|
		|СГРУППИРОВАТЬ ПО
		|	втДанныеОбъединенные.ВидОбработкиСырья,
		|	втДанныеОбъединенные.ТипОбработки,
		|	втДанныеОбъединенные.ЭтоХЭХ,
		|	втДанныеОбъединенные.ХимикоэнергетическаяХарактеристика
		|;
		|";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст +"
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанныеСгруппированные.ВидОбработкиСырья КАК ВидОбработки,
	|	втДанныеСгруппированные.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика,
	|	втДанныеСгруппированные.ПроцентПотерь КАК ПроцентПотерь,
	|	втДанныеСгруппированные.ТипОбработки КАК ТипОбработки,
	|	втДанныеСгруппированные.ЭтоХЭХ КАК ЭтоХЭХ
	|ИЗ
	|	"+?(ГруппаХЭХЗадана,"втДанныеСгруппированные","втДанные")+" КАК втДанныеСгруппированные
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоХЭХ,
	|	ХимикоэнергетическаяХарактеристика
	|ИТОГИ ПО
	|	ВидОбработки
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Ингредиент", Ингредиент);
	Запрос.УстановитьПараметр("ГруппаХЭХ", ГруппаХЭХПоУмолчанию);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВидОбработки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидОбработки.Следующий() Цикл
		
		// ВЫБОРКА ПО ВИДАМ ОБРАБОТКИ
		
		ВыборкаДетальныеЗаписи = ВыборкаВидОбработки.Выбрать();
		
		// Запоминаем, сколько строк по комбинации ингредиент + вид обработки.
		КоличествоЭлементовПоВидуОбработки = ВыборкаДетальныеЗаписи.Количество();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			// ДЕТАЛЬНАЯ ВЫБОРКА
			
			Если ВыборкаДетальныеЗаписи.ЭтоХЭХ Тогда
				
				// Запись для ХЭХ
				
				// Заполнение таблицы ХЭХ
				НовСтрокаХЭХ = ТаблицаХЭХ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаХЭХ, ВыборкаДетальныеЗаписи);
				НовСтрокаХЭХ.Ингредиент = Ингредиент;
				
				// Если запись для ХЭХ единственная и для вида обработки в целом ничего не задано,
				// все равно необходимо добавить строку в таблицу ингредиентов/видов обработки и в дерево 
				// видов обработок с пустым процентом потерь для корректного отбора по строкам.
				Если КоличествоЭлементовПоВидуОбработки = 1 Тогда
					
					// Заполнение дерева видов обработки
					Если ВыборкаДетальныеЗаписи.ТипОбработки = Перечисления.питТипыОбработкиСырья.Холодная Тогда
						НовСтрокаДеревоДляХЭХ = ВеткаХолоднаяОбработка.ПолучитьЭлементы().Добавить();
					Иначе
						НовСтрокаДеревоДляХЭХ = ВеткаГорячаяОбработка.ПолучитьЭлементы().Добавить();
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(НовСтрокаДеревоДляХЭХ, ВыборкаДетальныеЗаписи,,"ПроцентПотерь");
					НовСтрокаДеревоДляХЭХ.Группировка = ВыборкаДетальныеЗаписи.ВидОбработки;
					НовСтрокаДеревоДляХЭХ.Ингредиент = Ингредиент;
					
				КонецЕсли;
				
			Иначе
				
				// Это запись для вида обработки, не для ХЭХ
				
				// Заполнение дерева видов обработки
				Если ВыборкаДетальныеЗаписи.ТипОбработки = Перечисления.питТипыОбработкиСырья.Холодная Тогда
					НовСтрокаДерева = ВеткаХолоднаяОбработка.ПолучитьЭлементы().Добавить();
				Иначе
					НовСтрокаДерева = ВеткаГорячаяОбработка.ПолучитьЭлементы().Добавить();
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НовСтрокаДерева, ВыборкаДетальныеЗаписи);
				НовСтрокаДерева.Группировка = ВыборкаДетальныеЗаписи.ВидОбработки;
				НовСтрокаДерева.Ингредиент = Ингредиент;
				
			КонецЕсли; // ЭтоХЭХ
			
		КонецЦикла; // Детальная выборка
		
	КонецЦикла; // Выборка по видам обработки
	
КонецПроцедуры

// Процедура добавляет запись в регистр "питОбработкаСырья" по переданным значениям измерений,
//  а также удаляет служебную запись из регистра, которая необходима в момент, когда пользователь добавил ингредиент,
//  но еще не указал его виды обработки. При этом сам ингредиент отображается в динамическом списке именно благодаря
//  служебной записи.
//
// Параметры:
//  Ингредиент - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки - СправочникСсылка.питВидыОбработкиСырья - Ссылка на добавляемый вид обработки.
//  УдалятьСлужебныйЭлемент - Булево - Флаг удаления служебной записи.
//
Процедура ДобавитьЗаписьИнгредиентВидОбработкиВРегистр(Ингредиент, ВидОбработки, УдалятьСлужебныйЭлемент) Экспорт
	
	// Проверяем, а есть ли уже в регистре записи с таким значением измрений.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питОбработкаСырья.Ингредиент
	|ИЗ
	|	РегистрСведений.питОбработкаСырья КАК питОбработкаСырья
	|ГДЕ
	|	питОбработкаСырья.Ингредиент = &Ингредиент
	|	И питОбработкаСырья.ВидОбработкиСырья = &ВидОбработки";
	
	Запрос.УстановитьПараметр("ВидОбработки", ВидОбработки);
	Запрос.УстановитьПараметр("Ингредиент", Ингредиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда	
		
		// Таких записей нет, добавляем.
		
		НовЗаписьМенеджер = РегистрыСведений.питОбработкаСырья.СоздатьМенеджерЗаписи();
		НовЗаписьМенеджер.ВидОбработкиСырья = ВидОбработки;
		НовЗаписьМенеджер.Ингредиент = Ингредиент;
		НовЗаписьМенеджер.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.ПустаяСсылка();
		Попытка
			НовЗаписьМенеджер.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка добавления ингредиента в регистр ""Обработка сырья"" по причине: "
			+ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
	// Удаление служебной записи.
	Если УдалятьСлужебныйЭлемент Тогда
		НаборСлужебный = РегистрыСведений.питОбработкаСырья.СоздатьНаборЗаписей();
		НаборСлужебный.Отбор.Ингредиент.Установить(Ингредиент);
		НаборСлужебный.Отбор.ВидОбработкиСырья.Установить(Справочники.питВидыОбработкиСырья.ПустаяСсылка());
		Попытка
			НаборСлужебный.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка добавления ингредиента в регистр ""Обработка сырья"" по причине: "
			+ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Процедура добавляет СЛУЖЕБНУЮ запись по переданному ингредиенту в регистр.
//
// Параметры:
//  Ингредиент - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//
Процедура ДобавитьСлужебнуюЗаписьПоИнгредиенту(Ингредиент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	питОбработкаСырья.Ингредиент
		|ИЗ
		|	РегистрСведений.питОбработкаСырья КАК питОбработкаСырья
		|ГДЕ
		|	питОбработкаСырья.Ингредиент = &Ингредиент";
	
	Запрос.УстановитьПараметр("Ингредиент", Ингредиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		НовИнгр = РегистрыСведений.питОбработкаСырья.СоздатьМенеджерЗаписи();
		НовИнгр.Ингредиент = Ингредиент;
		НовИнгр.ВидОбработкиСырья = Справочники.питВидыОбработкиСырья.ПустаяСсылка();
		НовИнгр.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.ПустаяСсылка();
		Попытка
			НовИнгр.Записать(Истина);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка записи ингредиента в регистр ""Обработка сырья"" по причине: "
			+ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Функция обновляет запись РС "питВидыОбработки" по переданным значениям измерений и ресурса "ПроцентПотерь".
//
// Параметры:
//  Ингредиент - СправочникСсылка.Номенклатура - Ссылка на ингредиент.
//  ВидОбработки - СправочникСсылка.питВидыОбработкиСырья - Ссылка на добавляемый вид обработки.
//  ХЭХ - СправочникСсылка.питХимикоэнергетическиеХарактеристики - Ссылка на добавляемый ХЭХ.
//  ПроцентПотерь - Число - Новое значение процента потерь.
//
Процедура ОбновитьПроцентПотерьСервер(Ингредиент, ВидОбработки, ХЭХ = Неопределено, ПроцентПотерь) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.питОбработкаСырья.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Ингредиент 								= Ингредиент;
	МенеджерЗаписи.ВидОбработкиСырья						= ВидОбработки;
	Если ХЭХ <> Неопределено Тогда
		МенеджерЗаписи.ХимикоэнергетическаяХарактеристика	= ХЭХ;
	Иначе
		МенеджерЗаписи.ХимикоэнергетическаяХарактеристика	= Справочники.питХимикоэнергетическиеХарактеристики.ПустаяСсылка();
	КонецЕсли;
	МенеджерЗаписи.ПроцентПотерь						= ПроцентПотерь;
	Попытка
		Если НЕ ХЭХ = Неопределено И ПроцентПотерь = 0 Тогда
			МенеджерЗаписи.Удалить();
		Иначе
			МенеджерЗаписи.Записать();
		КонецЕсли;
	Исключение
