// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	
	Методы.Вставить("ВыполнитьИзмененияВПланеСчетов", Истина);
	Методы.Вставить("ВыполнитьИзменениеНастроекСчетовУчета", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьИзмененияНастроекСчетовУчета(СоответствиеСчетов, Дата)
	СчетаУчета = Новый Массив;

	Для Каждого КлючИЗначение Из СоответствиеСчетов Цикл
		СчетаУчета.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&Дата КАК Период,
	|	ПорядокОтраженияНаСчетахУчета.Организация КАК Организация,
	|	ПорядокОтраженияНаСчетахУчета.АналитикаУчета КАК АналитикаУчета,
	|	ПорядокОтраженияНаСчетахУчета.МестоУчета КАК МестоУчета,
	|	ПорядокОтраженияНаСчетахУчета.ВидСчета КАК ВидСчета,
	|	ПорядокОтраженияНаСчетахУчета.Долгосрочный КАК Долгосрочный,
	|	ПорядокОтраженияНаСчетахУчета.СчетУчета КАК СчетУчета,
	|	ПорядокОтраженияНаСчетахУчета.СчетУчета.Код КАК КодСчета,
	|	ПорядокОтраженияНаСчетахУчета.Субконто КАК Субконто,
	|	ПорядокОтраженияНаСчетахУчета.ОтноситсяКМалоценнымТМЦ КАК СчетУОтноситсяКМалоценнымТМЦ	
	|ИЗ
	|	РегистрСведений.ПорядокОтраженияНаСчетахУчета.СрезПоследних(&Дата, СчетУчета В (&СчетаУчета)) КАК ПорядокОтраженияНаСчетахУчета
	|ГДЕ
	|	&ДатаЗаполнена 
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПорядокОтраженияНаСчетахУчета.Период КАК Период,
	|	ПорядокОтраженияНаСчетахУчета.Организация КАК Организация,
	|	ПорядокОтраженияНаСчетахУчета.АналитикаУчета КАК АналитикаУчета,
	|	ПорядокОтраженияНаСчетахУчета.МестоУчета КАК МестоУчета,
	|	ПорядокОтраженияНаСчетахУчета.ВидСчета КАК ВидСчета,
	|	ПорядокОтраженияНаСчетахУчета.Долгосрочный КАК Долгосрочный,
	|	ПорядокОтраженияНаСчетахУчета.СчетУчета КАК СчетУчета,
	|	ПорядокОтраженияНаСчетахУчета.СчетУчета.Код КАК КодСчета,
	|	ПорядокОтраженияНаСчетахУчета.Субконто КАК Субконто,
	|	ПорядокОтраженияНаСчетахУчета.ОтноситсяКМалоценнымТМЦ КАК СчетУОтноситсяКМалоценнымТМЦ
	|ИЗ
	|	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокОтраженияНаСчетахУчета
	|ГДЕ
	|	ПорядокОтраженияНаСчетахУчета.СчетУчета В (&СчетаУчета)	
	|	И (НЕ &ДатаЗаполнена ИЛИ ПорядокОтраженияНаСчетахУчета.Период > &Дата) 
	|";
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ДатаЗаполнена", ЗначениеЗаполнено(Дата));

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПорядокОтраженияНаСчетахУчета");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Организация", "Организация");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("АналитикаУчета", "АналитикаУчета");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("МестоУчета", "МестоУчета");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ВидСчета", "ВидСчета");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Долгосрочный", "Долгосрочный");
	Блокировка.Заблокировать();
	
	Пока Выборка.Следующий() Цикл		
		
		ПериодПустой = Не ЗначениеЗаполнено(Выборка.Период);
		
		МенеджерЗаписи = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Заполнить(Неопределено);
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		Если ПериодПустой Тогда
			МенеджерЗаписи.Период = Дата('19800101'); 
		КонецЕсли;
		СчетЗамены = СоответствиеСчетов[МенеджерЗаписи.СчетУчета];
		Если ТипЗнч(СчетЗамены) = Тип("Соответствие") Тогда
			СчетЗамены = СчетЗамены[Выборка.ВидСчета];
			Если СчетЗамены = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		МенеджерЗаписи.СчетУчета = СчетЗамены;
		МенеджерЗаписи.Записать(); 
		
		Если ПериодПустой Тогда
			МенеджерЗаписи = РегистрыСведений.ПорядокОтраженияНаСчетахУчета.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьНеобходимостьНастройкиСчетов(СоответвиеСчетов)
	СчетаУчета = Новый Массив;
	Для Каждого КлючИЗначение Из СоответвиеСчетов Цикл
		СчетаУчета.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокОтраженияНаСчетахУчета
	|ГДЕ
	|	ПорядокОтраженияНаСчетахУчета.СчетУчета В(&СчетаУчета)
	|	И ПорядокОтраженияНаСчетахУчета.СчетУчета.Код ПОДОБНО ""%У%""";
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
КонецФункции

Функция ПроверитьБлокировкуИзмененийДанныхВЗакрытииМесяца(Организации, Дата, ОписаниеОшибок)
	ЕстьБлокировка = Ложь;
	Если НЕ РегистрыСведений.НастройкаБлокировкиОтИзменений.ИспользоватьМеханизмБлокировкиОтИзменений() Тогда
		Возврат ЕстьБлокировка;
	КонецЕсли;
	ДатыПоОрганизациям = РегистрыСведений.НастройкаБлокировкиОтИзменений.ДатыБлокировкиПоОрганизациям(Организации);

	Для Каждого Организация Из Организации Цикл
		ЗаблокироватьПо = ДатыПоОрганизациям.Получить(Организация);
		Если ЗначениеЗаполнено(ЗаблокироватьПо) И НачалоМесяца(Дата) <= ЗаблокироватьПо Тогда
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Невозможно добавить запись в регистр %1 по организации %2 в периоде %3: установлена блокировка от изменения до периода %4'", ОбщегоНазначения.КодОсновногоЯзыка()),
				Метаданные.РегистрыСведений.ЗаданияКЗакрытиюМесяца.Представление(),
				Организация,
				ЗакрытиеМесяцаКлиентСервер.ПредставлениеПериодаМесяцГод(Дата),
				ЗакрытиеМесяцаКлиентСервер.ПредставлениеПериодаМесяцГод(КонецМесяца(ЗаблокироватьПо) + 1));
			ОписаниеОшибок.Добавить(ОписаниеОшибки);
			ЕстьБлокировка = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьБлокировка;
КонецФункции

Процедура СформироватьЗаданияКРасчетуСебестоимости(ДатаНачалаУчета) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДатаНачалаУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Остатки.Организация КАК Организация
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Остатки(&НачалоПериода) КАК Остатки
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Обороты.Организация КАК Организация
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Обороты(&НачалоПериода, &КонецПериода) КАК Обороты";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДатаНачалаУчета));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ДатаНачалаУчета));
	
	НачалоМесяцаДаты = НачалоМесяца(ДатаНачалаУчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрыСведений.ЗаданияКРасчетуСебестоимости.СоздатьЗаписьРегистра(НачалоМесяцаДаты, , Выборка.Организация);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
