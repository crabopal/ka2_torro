// Возвращает соответствие счетов учета для настройки детализации 
// регламентированного учета.
// 
// Возвращаемое значение:
//  Структура - Соответствие счетов учета:
//   * СоответствиеСчетовПроизводства - Соответствие из КлючИЗначение:
//     ** Ключ - ПланСчетовСсылка.Хозрасчетный -
//     ** Значение - ПланСчетовСсылка.Хозрасчетный -
//   * СоответствиеСчетовПродаж - Соответствие из КлючИЗначение:
//     ** Ключ - ПланСчетовСсылка.Хозрасчетный -
//     ** Значение - ПланСчетовСсылка.Хозрасчетный -
//   * НеобходимаНастройкаСчетовПроизводства - Булево - 
//   * НеобходимаНастройкаСчетовПродаж - Булево - 
Функция СоответствиеСчетовУчета() Экспорт
	СоответствиеСчетов = Новый Структура;
	СоответствиеСчетовПроизводства = Новый Соответствие;
	СоответствиеСчетовПродаж = Новый Соответствие;
	Если Константы.РеглУчетНЗППоПартиямПроизводства.Получить() Тогда
		СоответствиеСчетов14 = Новый Соответствие;
		СоответствиеСчетов14.Вставить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеМатериаловВПодразделении, ПланыСчетов.Хозрасчетный.НайтиПоКоду("14.08"));
		СоответствиеСчетов14.Вставить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеНезавершенногоПроизводства, ПланыСчетов.Хозрасчетный.НайтиПоКоду("14.04"));

		СоответствиеСчетов20 = Новый Соответствие;
		СоответствиеСчетов20.Вставить(Перечисления.ВидыСчетовРеглУчета.МатериалыИРаботыВПодразделении, ПланыСчетов.Хозрасчетный.НайтиПоКоду("20.01"));
		СоответствиеСчетов20.Вставить(Перечисления.ВидыСчетовРеглУчета.РасходыКРаспределению, ПланыСчетов.Хозрасчетный.НайтиПоКоду("20.02"));
		СоответствиеСчетов20.Вставить(Перечисления.ВидыСчетовРеглУчета.НезавершенноеПроизводство, ПланыСчетов.Хозрасчетный.НайтиПоКоду("20.03"));
		
		СоответствиеСчетов23 = Новый Соответствие;
		СоответствиеСчетов23.Вставить(Перечисления.ВидыСчетовРеглУчета.МатериалыИРаботыВПодразделении, ПланыСчетов.Хозрасчетный.НайтиПоКоду("23.01"));
		СоответствиеСчетов23.Вставить(Перечисления.ВидыСчетовРеглУчета.РасходыКРаспределению, ПланыСчетов.Хозрасчетный.НайтиПоКоду("23.02"));
		СоответствиеСчетов23.Вставить(Перечисления.ВидыСчетовРеглУчета.НезавершенноеПроизводство, ПланыСчетов.Хозрасчетный.НайтиПоКоду("23.03"));
		
		СоответствиеСчетовПроизводства.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("14.04.У"), СоответствиеСчетов14);
		СоответствиеСчетовПроизводства.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("20.У"), СоответствиеСчетов20); 
		СоответствиеСчетовПроизводства.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("23.У"), СоответствиеСчетов23);
		
	КонецЕсли;
	
	Если Константы.РеглУчетПродажПоПартиямРеализованнойНоменклатуры.Получить() Тогда 
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1"));
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1"));
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03.1"));
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.04.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.04.1"));
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.05.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.05.1"));
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.07.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.07.1"));
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.08.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.08.1"));
		СоответствиеСчетовПродаж.Вставить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.09.У"), ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.09.1"));
	КонецЕсли;
	
	СоответствиеСчетов.Вставить("СоответствиеСчетовПроизводства", СоответствиеСчетовПроизводства);
	СоответствиеСчетов.Вставить("СоответствиеСчетовПродаж", СоответствиеСчетовПродаж); 
	СоответствиеСчетов.Вставить("НеобходимаНастройкаСчетовПроизводства", ПроверитьНеобходимостьНастройкиСчетов(СоответствиеСчетовПроизводства));
	СоответствиеСчетов.Вставить("НеобходимаНастройкаСчетовПродаж", ПроверитьНеобходимостьНастройкиСчетов(СоответствиеСчетовПродаж));
	Возврат СоответствиеСчетов;
КонецФункции

