#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс    

// Выполняет изменения в плане счетов при включении детализации регламентированного учета:
// Параметры:
//	Параметры - Структура
//	АдресХранилища - Строка
//
Процедура ВыполнитьИзмененияВПланеСчетов(Параметры, АдресХранилища) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;  
	Результат.Вставить("Статус", "Выполняется");
	Результат.Вставить("ПротоколОшибок", Новый Массив);

	МассивОрганизаций = Справочники.Организации.ДоступныеОрганизации();
	ЭлементУправленческаяОрганизация = МассивОрганизаций.Найти(Справочники.Организации.УправленческаяОрганизация);
	Если ЭлементУправленческаяОрганизация <> Неопределено Тогда
		МассивОрганизаций.Удалить(ЭлементУправленческаяОрганизация);
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных();
	ЭлементБлокировки = Блокировка.Добавить("ПланСчетов.Хозрасчетный");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
#Область РеглУчетТоваровИМатериаловПоПартиямПриобретения
	// Изменения для функциональной опции РеглУчетТоваровИМатериаловПоПартиямПриобретения
	ТекстСообщения = "";
	Отказ = Ложь;
	Если Параметры.РеглУчетТоваровИМатериаловПоПартиямПриобретения 
		И Не Константы.РеглУчетТоваровИМатериаловПоПартиямПриобретения.Получить() Тогда 
		НачатьТранзакцию();
		Попытка
			Блокировка.Заблокировать();
			ОбрабатываемыеСчета = Новый Массив;
			
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.Материалы);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.СырьеИМатериалы);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ПокупныеПолуфабрикатыИКомплектующие);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.Топливо);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.Тара);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ЗапасныеЧасти);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеМатериалы);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.МатериалыПереданныеВПереработку);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.СтроительныеМатериалы);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ИнвентарьИХозяйственныеПринадлежности);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.СпецоснасткаИСпецодеждаНаСкладе);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ТоварыНаСкладах);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ТараПодТоваромИПорожняя);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ПокупныеИзделия);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ПокупныеТоварыОтгруженные);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ПрочиеТоварыОтгруженные);
			
			ВидПартииНоменклатуры = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПартииНоменклатуры;
			
			Для Каждого Счет Из ОбрабатываемыеСчета Цикл
				СчетОбъект = Счет.ПолучитьОбъект();
				Субконто      = СчетОбъект.ВидыСубконто.Найти(ВидПартииНоменклатуры, "ВидСубконто");
				НетСубконто = (Субконто = Неопределено);
				ВсегоСубконто = СчетОбъект.ВидыСубконто.Количество();
				Если НетСубконто И ВсегоСубконто < 3 Тогда
					
					НовыйВид = СчетОбъект.ВидыСубконто.Добавить();
					НовыйВид.ВидСубконто = ВидПартииНоменклатуры;
					НовыйВид.Суммовой = Истина;
					НовыйВид.Количественный = Истина;
					
					СчетОбъект.Записать();
				Иначе
					Если Не НетСубконто Тогда
						ТекстСообщения = НСтр("ru = 'У счета %1 уже есть субконто ""Партии номенклатуры""'", ОбщегоНазначения.КодОсновногоЯзыка());
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Счет.Код);
					ИначеЕсли ВсегоСубконто = 3 Тогда 
						ТекстСообщения = НСтр("ru = 'У счета %1 максимально возможное количество субконто""'", ОбщегоНазначения.КодОсновногоЯзыка());
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Счет.Код);
						Отказ = Истина;
					КонецЕсли;
					Результат.ПротоколОшибок.Добавить(ТекстСообщения);
				КонецЕсли;
			КонецЦикла;
			ДанныеДляПроверки = ДатыЗапретаИзменения.ШаблонДанныхДляПроверки();
			Для Каждого Организация Из МассивОрганизаций Цикл
				НоваяСтрока = ДанныеДляПроверки.Добавить();
				НоваяСтрока.Дата   = Параметры.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения;
				НоваяСтрока.Объект = Организация;
				НоваяСтрока.Раздел = "БухгалтерскийУчет";
			КонецЦикла;
			ОписаниеОшибокБлокировок = Новый Массив;
			ЕстьБлокировкаИзмененияДанныхВЗакрытииМесяца = ПроверитьБлокировкуИзмененийДанныхВЗакрытииМесяца(МассивОрганизаций, 
							Параметры.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения,
							ОписаниеОшибокБлокировок);
			ОписаниеОшибки = "";
			ОписаниеДанных = Новый Структура("НоваяВерсия, Данные", Истина, РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьНаборЗаписей());

			ЕстьЗапретИзмененияДанных = ДатыЗапретаИзменения.НайденЗапретИзмененияДанных(ДанныеДляПроверки, ОписаниеДанных, ОписаниеОшибки);
			Если Не ЕстьЗапретИзмененияДанных 
				И Не ЕстьБлокировкаИзмененияДанныхВЗакрытииМесяца Тогда 
				Если ЗначениеЗаполнено(Параметры.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения) Тогда
					РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьЗаписьРегистра(Параметры.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения,
					,
					,
					Справочники.ОперацииЗакрытияМесяца.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета);
				КонецЕсли;
			Иначе
				Отказ = Истина;
				Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
					Результат.ПротоколОшибок.Добавить(ОписаниеОшибки);
				КонецЕсли;
				Если ОписаниеОшибокБлокировок.Количество() > 0 Тогда
					ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.ПротоколОшибок, ОписаниеОшибокБлокировок, Истина);
				КонецЕсли;
			КонецЕсли;
	
			Если Отказ Тогда
				ТекстСообщения = НСтр("ru = 'Функциональная опция ""учет товаров и материалов по партиям приобретения не была включена""'");
				ВызватьИсключение ТекстСообщения;
			Иначе
				Константы.РеглУчетТоваровИМатериаловПоПартиямПриобретения.Установить(Истина);
				Константы.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения.Установить(Параметры.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение     
			
			ОтменитьТранзакцию();
			Результат.Вставить("Статус", "Ошибка");
			ТекстОшибки = НСтр("ru = 'Ошибка включения опции ""Учет товаров и материалов по партиям приобретения""'");
			Результат.ПротоколОшибок.Добавить(ТекстОшибки);
			Если ПустаяСтрока(ТекстСообщения) Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось выполнить настройку детализации регламентированного учета по причине: %1'"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Настройка детализации регламентированного учета.'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			
		КонецПопытки;
	КонецЕсли;
#КонецОбласти
		
#Область РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска
	// Изменения для функциональной опции РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска
	ТекстСообщения = "";
	Отказ = Ложь;
	Если Параметры.РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска 
		И Не Константы.РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска.Получить() Тогда 
		НачатьТранзакцию();
		Попытка
			Блокировка.Заблокировать();
			ОбрабатываемыеСчета = Новый Массив;
			
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.Полуфабрикаты);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукция);
			ОбрабатываемыеСчета.Добавить(ПланыСчетов.Хозрасчетный.ГотоваяПродукцияОтгруженная);
			
			ВидПартииНоменклатуры = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПартииНоменклатуры;
			
			Для Каждого Счет Из ОбрабатываемыеСчета Цикл
				СчетОбъект = Счет.ПолучитьОбъект();
				Субконто      = СчетОбъект.ВидыСубконто.Найти(ВидПартииНоменклатуры, "ВидСубконто");
				НетСубконто = (Субконто = Неопределено);
				ВсегоСубконто = СчетОбъект.ВидыСубконто.Количество();
				Если НетСубконто И ВсегоСубконто < 3 Тогда
					
					НовыйВид = СчетОбъект.ВидыСубконто.Добавить();
					НовыйВид.ВидСубконто = ВидПартииНоменклатуры;
					НовыйВид.Суммовой = Истина;
					НовыйВид.Количественный = Истина;
					
					СчетОбъект.Записать();
				Иначе
					Если Не НетСубконто Тогда
						ТекстСообщения = НСтр("ru = 'У счета %1 уже есть субконто ""Партии номенклатуры""'", ОбщегоНазначения.КодОсновногоЯзыка());
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Счет.Код);
					ИначеЕсли ВсегоСубконто = 3 Тогда 
						ТекстСообщения = НСтр("ru = 'У счета %1 максимально возможное количество субконто""'", ОбщегоНазначения.КодОсновногоЯзыка());
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Счет.Код);
						Отказ = Истина;
					КонецЕсли;
					Результат.ПротоколОшибок.Добавить(ТекстСообщения);
				КонецЕсли;
			КонецЦикла;
			ДанныеДляПроверки = ДатыЗапретаИзменения.ШаблонДанныхДляПроверки();
			Для Каждого Организация Из МассивОрганизаций Цикл
				НоваяСтрока = ДанныеДляПроверки.Добавить();
				НоваяСтрока.Дата   = Параметры.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска;
				НоваяСтрока.Объект = Организация;
				НоваяСтрока.Раздел = "БухгалтерскийУчет";
			КонецЦикла;
			ОписаниеОшибокБлокировок = Новый Массив;
			ЕстьБлокировкаИзмененияДанныхВЗакрытииМесяца = ПроверитьБлокировкуИзмененийДанныхВЗакрытииМесяца(МассивОрганизаций, 
							Параметры.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска,
							ОписаниеОшибокБлокировок);
			ОписаниеОшибки = "";
			ОписаниеДанных = Новый Структура("НоваяВерсия, Данные", Истина, РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьНаборЗаписей());

			ЕстьЗапретИзмененияДанных = ДатыЗапретаИзменения.НайденЗапретИзмененияДанных(ДанныеДляПроверки, ОписаниеДанных, ОписаниеОшибки);
			Если Не ЕстьЗапретИзмененияДанных 
				И Не ЕстьБлокировкаИзмененияДанныхВЗакрытииМесяца Тогда 
				Если ЗначениеЗаполнено(Параметры.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска) Тогда
					РегистрыСведений.ЗаданияКЗакрытиюМесяца.СоздатьЗаписьРегистра(
						Параметры.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска,
						,
						,
						Справочники.ОперацииЗакрытияМесяца.ПереносСальдоПриИзмененииНастроекСчетовРеглУчета);
				КонецЕсли;
			Иначе
				Отказ = Истина;
				Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
					Результат.ПротоколОшибок.Добавить(ОписаниеОшибки);
				КонецЕсли;
				Если ОписаниеОшибокБлокировок.Количество() > 0 Тогда
					ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.ПротоколОшибок, ОписаниеОшибокБлокировок, Истина);
				КонецЕсли;
			КонецЕсли;
	
			Если Отказ Тогда
				ТекстСообщения = НСтр("ru = 'Функциональная опция ""учет товаров и материалов по партиям выпуска не была включена""'");
				ВызватьИсключение ТекстСообщения;
			Иначе
				Константы.РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска.Установить(Истина);
				Константы.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска.Установить(Параметры.ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение     
			
			ОтменитьТранзакцию();
			Результат.Вставить("Статус", "Ошибка");
			ТекстОшибки = НСтр("ru = 'Ошибка включения опции ""Учет продукции и полуфабрикатов по партиям выпуска""'");
			Результат.ПротоколОшибок.Добавить(ТекстОшибки);
			Если ПустаяСтрока(ТекстСообщения) Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось выполнить настройку детализации регламентированного учета по причине: %1'"),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Настройка детализации регламентированного учета.'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			
		КонецПопытки;
	КонецЕсли;
#КонецОбласти

#Область РеглУчетНЗППоПартиямПроизводства
	// Изменения для функциональной опции РеглУчетНЗППоПартиямПроизводства
	ТекстСообщения = "";
	Отказ = Ложь;
	Если Параметры.РеглУчетНЗППоПартиямПроизводства 
		И Не Константы.РеглУчетНЗППоПартиямПроизводства.Получить() Тогда
		Если Не ПланыСчетов.Хозрасчетный.НайтиПоКоду("14.04.У") = ПланыСчетов.Хозрасчетный.ПустаяСсылка() Тогда
			ТекстСообщения = НСтр("ru = 'Счет ""14.04.У"" уже существует.'");
			Результат.ПротоколОшибок.Добавить(ТекстСообщения);
            Отказ = Истина;
		КонецЕсли;
		Если Не ПланыСчетов.Хозрасчетный.НайтиПоКоду("14.08") = ПланыСчетов.Хозрасчетный.ПустаяСсылка() Тогда
			ТекстСообщения = НСтр("ru = 'Счет ""14.08"" уже существует.'");
			Результат.ПротоколОшибок.Добавить(ТекстСообщения);
            Отказ = Истина;
