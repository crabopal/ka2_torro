#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаИзменитьНастройки(Команда)
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаНастройкаПланаСчетов Тогда
		Если Модифицированность Тогда
			ТекстВопроса = НСтр("ru = 'План счетов будет изменен. Продолжить?'");     
			РезультатПроверки = ПроверитьВозможностьВключенияРасширеннойДетализации();
			ОшибкиПроверки = РезультатПроверки.Ошибки;
			КонтрольнаяДата = РезультатПроверки.КонтрольнаяДата;
			ФорматнаяСтрока = СтрШаблон("ДЛФ=; ДП=%1;", НСтр("ru = 'начала учета'"));
			ПредставлениеДаты = Формат(КонтрольнаяДата, ФорматнаяСтрока);
			Если ОшибкиПроверки.Количество() Тогда
				МассивСтрок = Новый Массив;
				СообщениеПользователю = НСтр("ru = 'Для повышения детальности все организации с %1 должны использовать метод
											|оценки стоимости ""ФИФО"" и не должны использовать выпуск по плановой стоимости.'");
				МассивСтрок.Добавить(СтрШаблон(СообщениеПользователю, ПредставлениеДаты));
				Для Каждого Ошибка Из ОшибкиПроверки Цикл
					МассивСтрок.Добавить(Ошибка);
				КонецЦикла;
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрСоединить(МассивСтрок, Символы.ПС));
				ВызватьИсключение НСтр("ru = 'Повышение детальности не может быть выполнено при действующих параметрах учетных политик.'");
			КонецЕсли;
			ПоказатьВопрос(Новый ОписаниеОповещения("ИзменитьНастройкиПланаСчетов", ЭтотОбъект), 
				ТекстВопроса, 
				РежимДиалогаВопрос.ДаНет
				,
				,
				,
				НСтр("ru = 'Изменение настроек детализации регламентированного учета'"));
		Иначе 
			ПерейтиНаСледующийШаг();
		КонецЕсли;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаИзменениеНастроекСчетовУчета Тогда 
		Если НужноИзменениеНастроекСчетовУчетаПродаж Или НужноИзменениеНастроекСчетовУчетаПроизводства Тогда
			ИзменитьНастройкиСчетовУчета();	
		КонецЕсли;
		ПерейтиНаСледующийШаг();
	Иначе
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции 

&НаСервере
Функция ПроверитьВозможностьВключенияРасширеннойДетализации()
	ДатаВключенияДетализации = Дата(2999,1,1);
	Если РеглУчетНЗППоПартиямПроизводства Тогда
		ДатаВключенияДетализации = ДатаНачалаРеглУчетаНЗППоПартиямПроизводства;
	КонецЕсли;
	Если РеглУчетПродажПоПартиямРеализованнойНоменклатуры 
		И ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры < ДатаВключенияДетализации Тогда
		ДатаВключенияДетализации = ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры;
	КонецЕсли;
	Если РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска 
		И ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска < ДатаВключенияДетализации Тогда
		ДатаВключенияДетализации = ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска;
	КонецЕсли;
	Если РеглУчетТоваровИМатериаловПоПартиямПриобретения 
		И ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения < ДатаВключенияДетализации Тогда
		ДатаВключенияДетализации = ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения;
	КонецЕсли;           
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&ДатаВключенияДетализации КАК Период,
	|	УчетнаяПолитика.Организация КАК Организация,
	|	УчетнаяПолитика.МетодОценкиСтоимостиТоваров КАК МетодОценкиСтоимости,
	|	УчетнаяПолитика.УчетГотовойПродукцииПоПлановойСтоимости КАК ПоПлановойСтоимости
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаФинансовогоУчета.СрезПоследних(&ДатаВключенияДетализации,
	|		Организация.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОрганизацийПодразделений.Действует)
	|			И НЕ Организация.ПометкаУдаления) КАК УчетнаяПолитика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ 
	|	УчетнаяПолитика.Период КАК Период,
	|	УчетнаяПолитика.Организация КАК Организация,
	|	УчетнаяПолитика.МетодОценкиСтоимостиТоваров КАК МетодОценкиСтоимости,
	|	УчетнаяПолитика.УчетГотовойПродукцииПоПлановойСтоимости КАК ПоПлановойСтоимости
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаФинансовогоУчета КАК УчетнаяПолитика
	|ГДЕ
	|	УчетнаяПолитика.Период > &ДатаВключенияДетализации
	|	И УчетнаяПолитика.Организация.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОрганизацийПодразделений.Действует)
	|	И НЕ УчетнаяПолитика.Организация.ПометкаУдаления
	|		И (УчетнаяПолитика.МетодОценкиСтоимостиТоваров В (&МетодыОценкиСтоимости)
	|			ИЛИ УчетнаяПолитика.УчетГотовойПродукцииПоПлановойСтоимости)";
	Запрос.УстановитьПараметр("ДатаВключенияДетализации", ДатаВключенияДетализации);
	
	МетодыОценкиСтоимости = Новый Массив;
	МетодыОценкиСтоимости.Добавить(Перечисления.МетодыОценкиСтоимостиТоваров.СредняяЗаМесяц);
	МетодыОценкиСтоимости.Добавить(Перечисления.МетодыОценкиСтоимостиТоваров.Среднескользящая);
	Запрос.УстановитьПараметр("МетодыОценкиСтоимости", МетодыОценкиСтоимости);
	Выборка = Запрос.Выполнить().Выбрать();
 	Результат = Новый Структура("КонтрольнаяДата, Ошибки");
	Ошибки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить("КонтрольнаяДата", ДатаВключенияДетализации);
		Если МетодыОценкиСтоимости.Найти(Выборка.МетодОценкиСтоимости) <> Неопределено Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'на дату %1 Организация ""%2"" использует метод оценки ""%3""' "),
								Формат(Выборка.Период, "ДЛФ=D"),
								Выборка.Организация,
								Выборка.МетодОценкиСтоимости);
			Ошибки.Добавить(ТекстОшибки);
		КонецЕсли;
		Если Выборка.ПоПлановойСтоимости Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'на дату %1 Организация ""%2"" использует выпуск готовой продукции по плановой стоимости'"),
								Формат(Выборка.Период, "ДЛФ=D"),
								Выборка.Организация);
			Ошибки.Добавить(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Ошибки", Ошибки);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПриИзмененииРеквизита(Элемент);
	Модифицированность = ФормаМодифицирована();
	УстановитьДоступность(Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкиПланаСчетов(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда

		ПараметрыОбработки = Новый Структура;
		ПараметрыОбработки.Вставить("РеглУчетНЗППоПартиямПроизводства", РеглУчетНЗППоПартиямПроизводства);
		ПараметрыОбработки.Вставить("РеглУчетПродажПоПартиямРеализованнойНоменклатуры", РеглУчетПродажПоПартиямРеализованнойНоменклатуры);
		ПараметрыОбработки.Вставить("РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска", РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска);
		ПараметрыОбработки.Вставить("РеглУчетТоваровИМатериаловПоПартиямПриобретения", РеглУчетТоваровИМатериаловПоПартиямПриобретения);
		
		ПараметрыОбработки.Вставить("ДатаНачалаРеглУчетаНЗППоПартиямПроизводства", ДатаНачалаРеглУчетаНЗППоПартиямПроизводства);
		ПараметрыОбработки.Вставить("ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры", ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры);
		ПараметрыОбработки.Вставить("ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска", ДатаНачалаРеглУчетаПродукцииИПолуфабрикатовПоПартиямВыпуска);
		ПараметрыОбработки.Вставить("ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения", ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения);

		Результат = ЗапуститьОбработкуИзмененияПланаСчетов(УникальныйИдентификатор, ПараметрыОбработки);
		Если Результат.Статус = "Выполняется" Тогда
		
			ПараметрыДлительнойОперации = Новый Структура;
			ПараметрыДлительнойОперации.Вставить("ИдентификаторЗадания",       Результат.ИдентификаторЗадания);
			ПараметрыДлительнойОперации.Вставить("АдресРезультата",            Результат.АдресРезультата);
			ПараметрыДлительнойОперации.Вставить("ВыводитьОкноОжидания",       Истина);
			ПараметрыДлительнойОперации.Вставить("ВыводитьПрогрессВыполнения", Истина);
			ПараметрыДлительнойОперации.Вставить("ВыводитьСообщения",          Истина);
			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения("НастройкаДетализацииРеглУчетаЗавершена", ЭтотОбъект, ДополнительныеПараметры);
			
			ОткрытьФорму("ОбщаяФорма.ДлительнаяОперация", ПараметрыДлительнойОперации, ЭтотОбъект, , , , ОповещениеОЗакрытии);
		Иначе
			
			НастройкаДетализацииРеглУчетаЗавершена(Результат, ДополнительныеПараметры);
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкиСчетовУчета()
	
	ПараметрыОбработки = Новый Структура;

	ПараметрыОбработки.Вставить("ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры", ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры);
	ПараметрыОбработки.Вставить("ДатаНачалаРеглУчетаНЗППоПартиямПроизводства", ДатаНачалаРеглУчетаНЗППоПартиямПроизводства);
	
	Результат = ЗапуститьОбработкуИзмененияНастроекСчетовУчета(УникальныйИдентификатор, ПараметрыОбработки);
	Если Результат.Статус = "Выполняется" Тогда
		
		ПараметрыДлительнойОперации = Новый Структура;
		ПараметрыДлительнойОперации.Вставить("ИдентификаторЗадания",       Результат.ИдентификаторЗадания);
		ПараметрыДлительнойОперации.Вставить("АдресРезультата",            Результат.АдресРезультата);
		ПараметрыДлительнойОперации.Вставить("ВыводитьОкноОжидания",       Истина);
		ПараметрыДлительнойОперации.Вставить("ВыводитьПрогрессВыполнения", Истина);
		ПараметрыДлительнойОперации.Вставить("ВыводитьСообщения",          Истина);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("НастройкаДетализацииРеглУчетаЗавершена", ЭтотОбъект);
		
		ОткрытьФорму("ОбщаяФорма.ДлительнаяОперация", ПараметрыДлительнойОперации, ЭтотОбъект, , , , ОповещениеОЗакрытии);
	Иначе
		
		РезультатВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		НастройкаДетализацииРеглУчетаЗавершена(РезультатВыполнения, Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьФорму()
	Прочитать();
	Исключения = Новый Массив;
	Исключения.Добавить("НаборКонстант");
	Исключения.Добавить("КэшСостоянийРеквизитов");
	Исключения.Добавить("СоответствиеСчетов");
	Исключения.Добавить("НужноИзменениеНастроекСчетовУчетаПродаж");
	Исключения.Добавить("НужноИзменениеНастроекСчетовУчетаПроизводства");
	Исключения.Добавить("ИзмененияПланаСчетовВыполнены");
	Исключения.Добавить("ИзмененияНастроекСчетовВыполнены");
	
	Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
		Если Исключения.Найти(Реквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЭтотОбъект[Реквизит.Имя] = НаборКонстант[Реквизит.Имя];
	КонецЦикла;

	// Обновление состояния элементов
	УстановитьДоступность();
	ОбновитьКэшСостоянийРеквизитов();
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность(ИмяЭлемента = "")
	
	РеквизитыКонстант = Новый Массив;
	Если ИмяЭлемента <> "" Тогда
		РеквизитыКонстант.Добавить(ИмяЭлемента);
	Иначе
		Исключения = Новый Массив;
		Исключения.Добавить("НаборКонстант");
		Исключения.Добавить("КэшСостоянийРеквизитов");
		Исключения.Добавить("СоответствиеСчетов");
		Исключения.Добавить("НужноИзменениеНастроекСчетовУчетаПродаж");
		Исключения.Добавить("НужноИзменениеНастроекСчетовУчетаПроизводства");
		Исключения.Добавить("ИзмененияПланаСчетовВыполнены");
		Исключения.Добавить("ИзмененияНастроекСчетовВыполнены");
		Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
			Если Исключения.Найти(Реквизит.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИмяРеквизита = Реквизит.Имя;
			Если ТипЗнч(ЭтотОбъект[ИмяРеквизита]) = Тип("Булево")  Тогда
				РеквизитыКонстант.Добавить(ИмяРеквизита);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	
	КоличествоЗавершенныхНастроек = 0;
	Для Каждого ИмяРеквизита Из РеквизитыКонстант Цикл
		Если ИмяЭлемента = "" Тогда
			ИмяГруппы = "Группа" + ИмяРеквизита + "Горизонтальная";
			Элементы[ИмяГруппы].Доступность = Не ЭтотОбъект[ИмяРеквизита];
			Если Не Элементы[ИмяГруппы].Доступность Тогда
				КоличествоЗавершенныхНастроек = КоличествоЗавершенныхНастроек + 1;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(ЭтотОбъект[ИмяРеквизита]) = Тип("Булево")  Тогда
			ИмяРеквизитаДатаНачалаУчета = СтрЗаменить(ИмяРеквизита, "РеглУчет", "ДатаНачалаРеглУчета");
			ЭлементДатаНачалаУчета = Элементы[ИмяРеквизитаДатаНачалаУчета];
			ЭлементДатаНачалаУчета.Доступность = ЭтотОбъект[ИмяРеквизита];
		Иначе
			ИмяРеквизитаДатаНачалаУчета = ИмяРеквизита;
			ЭлементДатаНачалаУчета = Элементы[ИмяРеквизитаДатаНачалаУчета];
		КонецЕсли;
	КонецЦикла;
	ИзмененияПланаСчетовВыполнены = КоличествоЗавершенныхНастроек = РеквизитыКонстант.Количество();
	ПроверитьНебходимостьНастройкиСчетов();
КонецПроцедуры

&НаСервере
Процедура ПроверитьНебходимостьНастройкиСчетов()
	СоответствияСчетов = Обработки.НастройкаДетализацииРеглУчета.СоответствиеСчетовУчета();
	НужноИзменениеНастроекСчетовУчетаПродаж = СоответствияСчетов.НеобходимаНастройкаСчетовПродаж;
	НужноИзменениеНастроекСчетовУчетаПроизводства = СоответствияСчетов.НеобходимаНастройкаСчетовПроизводства;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапуститьОбработкуИзмененияПланаСчетов(УникальныйИдентификатор, ПараметрыОбработки)
	
	ПараметрыФоновогоЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыФоновогоЗадания.НаименованиеФоновогоЗадания = НСтр("ru = 'Обработка изменения плана счетов'");
	ПараметрыФоновогоЗадания.КлючФоновогоЗадания = "ОбработкаИзмененияПланаСчетов";
	ПараметрыФоновогоЗадания.ОжидатьЗавершение = 1;

	РезультатФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.НастройкаДетализацииРеглУчета.ВыполнитьИзмененияВПланеСчетов", 
		ПараметрыОбработки, 
		ПараметрыФоновогоЗадания);
	
	Возврат РезультатФоновогоЗадания;

КонецФункции 

&НаСервереБезКонтекста
Функция ЗапуститьОбработкуИзмененияНастроекСчетовУчета(УникальныйИдентификатор, ПараметрыОбработки)
	
	ПараметрыФоновогоЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыФоновогоЗадания.НаименованиеФоновогоЗадания = НСтр("ru = 'Обработка изменения настроек счетов учета'");
	ПараметрыФоновогоЗадания.КлючФоновогоЗадания = "ОбработкаИзмененияНастроекСчетовУчета";
	ПараметрыФоновогоЗадания.ОжидатьЗавершение = 1;

	РезультатФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.НастройкаДетализацииРеглУчета.ВыполнитьИзменениеНастроекСчетовУчета", 
		ПараметрыОбработки, 
		ПараметрыФоновогоЗадания);
	
	Возврат РезультатФоновогоЗадания;

КонецФункции 

&НаКлиенте
Процедура НастройкаДетализацииРеглУчетаЗавершена(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Модифицированность = Ложь;
		Если Результат.Свойство("АдресРезультата") И ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда
 			РезультатФоновогоЗадания = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		Иначе
			РезультатФоновогоЗадания = Результат;
		КонецЕсли;
		Если Не РезультатФоновогоЗадания.ПротоколОшибок.Количество() Тогда
			
			ОбновитьФорму();
			ПерейтиНаСледующийШаг();
			Возврат;
			
		Иначе
			
			ПоказатьПредупреждение(, 
				НСтр("ru = 'Обработка завершилась с ошибкой. Подробную информацию см. в журнале регистрации.'"),
				, 
				НСтр("ru = 'Обработка настройки детализации регл. учета'"));
			
		КонецЕсли;
		Если РезультатФоновогоЗадания.ПротоколОшибок.Количество() Тогда
			Для Каждого ТекстСообщения Из РезультатФоновогоЗадания.ПротоколОшибок Цикл
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	ОбновитьФорму();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКэшСостоянийРеквизитов()
	КэшСостоянийРеквизитов.Очистить();
	НоваяСтрока = КэшСостоянийРеквизитов.Добавить();
	НоваяСтрока.ИмяРеквизита = "РеглУчетТоваровИМатериаловПоПартиямПриобретения";
	НоваяСтрока.Значение = РеглУчетТоваровИМатериаловПоПартиямПриобретения;

	НоваяСтрока = КэшСостоянийРеквизитов.Добавить();
	НоваяСтрока.ИмяРеквизита = "РеглУчетНЗППоПартиямПроизводства";
	НоваяСтрока.Значение = РеглУчетНЗППоПартиямПроизводства;

	НоваяСтрока = КэшСостоянийРеквизитов.Добавить();
	НоваяСтрока.ИмяРеквизита = "РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска";
	НоваяСтрока.Значение = РеглУчетПродукцииИПолуфабрикатовПоПартиямВыпуска;

	НоваяСтрока = КэшСостоянийРеквизитов.Добавить();
	НоваяСтрока.ИмяРеквизита = "РеглУчетПродажПоПартиямРеализованнойНоменклатуры";
	НоваяСтрока.Значение = РеглУчетПродажПоПартиямРеализованнойНоменклатуры;

КонецПроцедуры

&НаКлиенте
Функция ФормаМодифицирована()
	Для Каждого СтрокаКэша Из КэшСостоянийРеквизитов Цикл
		Если Не СтрокаКэша.Значение = ЭтотОбъект[СтрокаКэша.ИмяРеквизита] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ПерейтиНаСледующийШаг()
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаНастройкаПланаСчетов Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаИзменениеНастроекСчетовУчета;
		
		СоответствияСчетов = Обработки.НастройкаДетализацииРеглУчета.СоответствиеСчетовУчета();
		Элементы.ГруппаИзменениеНастроекСчетовУчетаПроизводства.Доступность = СоответствияСчетов.НеобходимаНастройкаСчетовПроизводства;
		Элементы.ГруппаИзменениеНастроекСчетовУчетаПродаж.Доступность = СоответствияСчетов.НеобходимаНастройкаСчетовПродаж;
		
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаВыполнение;
		Элементы.КомандаИзменитьНастройки.Заголовок = НСтр("ru = 'Закрыть'");
	КонецЕсли;
	ОбновитьКэшСостоянийРеквизитов();
КонецПроцедуры

#КонецОбласти
