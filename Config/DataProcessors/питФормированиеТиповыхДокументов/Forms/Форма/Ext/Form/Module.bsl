#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// Инициализация реквизитов, отвечающих за изменение значений констант.
	
	АвтоформированиеТиповыхДокументов	= Константы.питФормироватьТиповыеДокументыПриЗаписиДокументапит.Получить();
	ФормироватьСпецификацииПоРецептурам	= Константы.питФормироватьСпецификацииПоРецептурам.Получить();
	ФормироватьДокументыПроизводства22	= Константы.питФормироватьДокументыПроизводства22.Получить();
	ФормироватьРазрешенияНаЗаменуПоРегистрациямЗамен = Константы.питФормироватьРазрешенияНаЗаменуПоРегистрациямЗамен.Получить();
	
	// Установка конечной даты формирования.
	УстановитьДатуФормированияТиповыхДокументов(ОтборОрганизация);
	
	// По умолчанию показываем только те документы, которые необходимо синхронизировать.
	ПоказатьТолькоНеобхСинхр = Истина;
	
	// Заполнение дерева типовых документов.
	ЗаполнитьДеревоДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Разворачивание верхнего уровня дерева документов.
	РазвернутьДеревоДокументов();
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТаблицаСозданныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Попытка
		Если Колонка.Имя = "ТаблицаСозданныеДокументыДокументпит" Тогда
			ПоказатьЗначение(, Элементы.ТаблицаСозданныеДокументы.ТекущиеДанные.ДокументОбщепит);
		Иначе
			ПоказатьЗначение(, Элементы.ТаблицаСозданныеДокументы.ТекущиеДанные.ТиповойДокумент);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСозданныеДокументыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСозданныеДокументыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено И НЕ ТипЗнч(ТекДанные.Группировка) = Тип("Строка") Тогда
		Попытка
			ПоказатьЗначение(, Элементы.ДеревоДокументов.ТекущиеДанные.Группировка);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТолькоНеобхСинхрПриИзменении(Элемент)
	
	// Установка конечной даты формирования.
	////УстановитьДатуФормированияТиповыхДокументов(ОтборОрганизация);
	
	ОбновитьРазвернутьДеревоДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ФормироватьПоПриИзменении(Элемент)
	
	ОбщееОписаниеПодсказки = "Предельная дата документов ""Общепит"", по которым осуществляется формирование документов ""1С:ERP"". 
	|";
	СодержимоеЗаголовкаПодсказки = Новый Массив;
	СодержимоеЗаголовкаПодсказки.Добавить(ОбщееОписаниеПодсказки);
	СодержимоеЗаголовкаПодсказки.Добавить("Установлена пользователем вручную.");
	
	Элементы.ФормироватьПоРасширеннаяПодсказка.Заголовок = Новый ФорматированнаяСтрока(СодержимоеЗаголовкаПодсказки);
	
	
	ОбновитьРазвернутьДеревоДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	// Установка конечной даты формирования.
	////УстановитьДатуФормированияТиповыхДокументов(ОтборОрганизация);
	
	ОбновитьРазвернутьДеревоДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ФормироватьПоРасширеннаяПодсказкаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Попытка
		ПоказатьЗначение(, ПоследнийНесинхрДокументОбщепит);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура АвтоформированиеТиповыхДокументовПриИзменении(Элемент)
	АвтоформированиеТиповыхДокументовПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФормироватьСпецификацииПоРецептурамПриИзменении(Элемент)
	ФормироватьСпецификацииПоРецептурамПриИзмененииНаСервере();
	ОбновитьРазвернутьДеревоДокументов();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	ТекстОшибки = "";
	РежимПроизводстваРазрешен = РежимПроизводстваРазрешен(, ТекстОшибки);
	Если НЕ РежимПроизводстваРазрешен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	// Очистка таблицы созданных документов.
	ТаблицаСозданныеДокументы.Очистить();
	
	// Выполнение обработки "План меню".
	Состояние("Выполняется обработка документов ""План меню"" ...");
	ОбработкаПлановМеню();
	
	// Выполнение обработки "Выпуск блюд".
	Состояние("Выполняется обработка документов ""Выпуск блюд"" ...");
	ОбработкаВыпускаБлюд();
	
		// Выполнение обработки "Разделка".
	Состояние("Выполняется обработка документов ""Разделка"" ...");
	ОбработкаРазделка();
	
	Если ФормироватьСпецификацииПоРецептурам Тогда
		
		// Выполнение обработки "Рецептура".
		Состояние("Выполняется обработка документов ""Рецептура"" ...");
		ОбработкаРецептура();
		
	КонецЕсли;
	
	// Выполнение обработки "Регистрация замен".
	Состояние("Выполняется обработка документов ""Регистрация замен"" ...");
	ОбработкаРегистрацияЗамен();
	
	// Выполнение обработки "Разделка".
	Состояние("Выполняется обработка документов ""Инвенаризация товаров общепита"" ...");
	ОбработкаИнвентаризация();
	
	// Выполнение обработки "Разделка".
	Состояние("Выполняется обработка документов ""Перемещение номенклатуры склада и производства"" ...");
	ОбработкаПеремещениеНоменклатурыСкладаПроизводства();
	
	ПоказатьПредупреждение(,"Обработка документов ""Общепит"" завершена!");
	
	// Установка конечной даты формирования.
	//УстановитьДатуФормированияТиповыхДокументов(ОтборОрганизация);
	
	ОбновитьРазвернутьДеревоДокументов();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаТиповыеДокументы;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоДокументов(Команда)
	
	// Установка конечной даты формирования.
	//УстановитьДатуФормированияТиповыхДокументов(ОтборОрганизация);
	
	ОбновитьРазвернутьДеревоДокументов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОбновитьРазвернутьДеревоДокументов()
	
	Перем ТекГруппировка, ТекДанные;
	
	ТекДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		ТекГруппировка = ТекДанные.Группировка;
	КонецЕсли;
	
	ЗаполнитьДеревоДокументов();
	РазвернутьДеревоДокументов();
	
	УстановитьТекущуюСтрокуДереваДокументов(ТекГруппировка,ДеревоДокументов);
	
КонецПроцедуры

&НаСервере
Процедура АвтоформированиеТиповыхДокументовПриИзмененииНаСервере()
	Константы.питФормироватьТиповыеДокументыПриЗаписиДокументапит.Установить(АвтоформированиеТиповыхДокументов);
КонецПроцедуры

&НаСервере
Процедура ФормироватьСпецификацииПоРецептурамПриИзмененииНаСервере()
	Константы.питФормироватьСпецификацииПоРецептурам.Установить(ФормироватьСпецификацииПоРецептурам);
КонецПроцедуры

#КонецОбласти

// Разворачивает верхний уровень дерева документов.
//
&НаКлиенте
Процедура РазвернутьДеревоДокументов()
	
	Для Каждого ТекСтрока Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоДокументов.Развернуть(ТекСтрока.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

// Получение таблицы документов "Общепит" по заданным отборам,
//
// Параметры:
//  ТаблицаВыборкиЗапросапит - ТаблицаЗначений	 - Результирующая таблица.
//  СтруктураПараметров			 - Структура		 - Сруктура параметров
//
&НаСервере
Процедура ПолучитьТаблицуДокументовпит(ТаблицаВыборкиЗапросапит, СтруктураПараметров) 
	
	мНазваниеДокумента = Метаданные.НайтиПоТипу(Тип(СтруктураПараметров.ДокументОбщепит)).Имя;
	
	// Делаем запрос по всем документам пит с отборами
	Запрос	= Новый Запрос();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Документпит.Ссылка КАК ДокументОбщепит,
	|	Документпит.Дата
	|ПОМЕСТИТЬ втВсеДокументыпит";
	ТекстЗапроса = СокрЛП(ТекстЗапроса) + "
	|ИЗ
	|	Документ." + СокрЛП(мНазваниеДокумента) + " КАК Документпит
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ФормироватьПо = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ Документпит.Дата < &ФормироватьПо
	|	КОНЕЦ 
	|";
	
	//Если в отборе указана Организация, включаем фильтр по организации
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ТекстЗапроса = ТекстЗапроса + 
		" И Документпит.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация",ОтборОрганизация);
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втВсеДокументыпит.ДокументОбщепит КАК ДокументОбщепит,
	|	втВсеДокументыпит.Дата КАК Дата
	|ИЗ
	|	втВсеДокументыпит КАК втВсеДокументыпит
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|		ПО втВсеДокументыпит.ДокументОбщепит = питТиповыеДокументы.ДокументОбщепит
	|ГДЕ
	|	ЕСТЬNULL(питТиповыеДокументы.Синхронизирован, ЛОЖЬ) = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	втВсеДокументыпит.Дата
	|";
	
	Запрос.Текст=ТекстЗапроса;
	Запрос.УстановитьПараметр("ФормироватьПо",КонецДня(ФормироватьПо));
	
	// Результат.
	ТаблицаВыборкиЗапросапит = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

// Формирование типовых документов по переданной таблице документов "Общепит".
//
// Параметры:
//  ТаблицаВыборкиЗапросапит - ТаблицаЗначений	 - Таблица выбранных документов "Общепит".
//  СтруктураПараметров			 - Структура		 - Структура параметров.
//  ТекстОшибки					 - Строка			 - Текст ошибки в случае неудачного выполнения.
// 
// Возвращаемое значение:
//  Истина - Выполнение функции завершено успешно.
//  Ложь - При выполнении функции возникли ошибки.
//
&НаСервере
Функция ФормированиеДокументов(ТаблицаВыборкиЗапросапит, СтруктураПараметров, ТекстОшибки = "") 
	
	ВсеОк = Истина;
	
	тблСозданныеДокументы = Неопределено;
	
	// Обход таблицы.
	Для Каждого ТекСтрока Из ТаблицаВыборкиЗапросапит Цикл
		
		// НАЧАЛО ТРАНЗАКЦИИ
		НачатьТранзакцию();
		
		мДокументпит = ТекСтрока.ДокументОбщепит;
		
		// Формирование ТД для текуего документа "пит".
		ВсеОк = питТиповыеДокументы.СформироватьТиповыеДокументы(мДокументпит, СтруктураПараметров, тблСозданныеДокументы, ТекстОшибки);
		
		Если НЕ ВсеОк Тогда
			ОтменитьТранзакцию();
			Возврат ВсеОк;
		КонецЕсли;
		
		// Обновление таблицы созданных документов.
		Если НЕ тблСозданныеДокументы = Неопределено Тогда
			Для Каждого ТекСтрокаСозданныйДокумент Из тблСозданныеДокументы Цикл
				НоваяСтрокаСозд = ТаблицаСозданныеДокументы.Добавить();
				НоваяСтрокаСозд.ДокументОбщепит = ТекСтрокаСозданныйДокумент.ДокументОбщепит;
				НоваяСтрокаСозд.ТиповойДокумент = ТекСтрокаСозданныйДокумент.ТиповойДокумент;
			КонецЦикла;
			тблСозданныеДокументы.Очистить();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
	Возврат ВсеОк;
	
КонецФункции

// Процедура запускает формирование типовых документов по документам "Выпуск блюд",
// выбранных в соответствии с отборами.
//
&НаСервере
Процедура ОбработкаВыпускаБлюд()
	
	Перем ТаблицаВыборкиЗапросапит;
	
	ВсеОк = Истина;
	
	// Задание структуры параметров.
	СтруктураПараметров = Новый Структура("ДокументОбщепит, ФормироватьТолькоНовые, ФормироватьВыпускПродукции, РежимЗаписи, РежимПроизводстваРазрешен");
	СтруктураПараметров.ДокументОбщепит = Документы.питВыпускБлюд;
	СтруктураПараметров.РежимПроизводстваРазрешен = РежимПроизводстваРазрешен;
	СтруктураПараметров.Вставить("ФормироватьДокументыПроизводства22", ФормироватьДокументыПроизводства22);
	// Будем проводить типовые документы на секунду позже. 
	// Это необходимо для правильного контроля остатков при перепроведении документа "пит".
	СтруктураПараметров.Вставить("ДатаСмещение", 1);
	
	//СтруктураПараметров.РежимЗаписи = РежимЗаписиДокумента.Проведение; // {debug}
	
	// Получение таблицы
	ПолучитьТаблицуДокументовпит(ТаблицаВыборкиЗапросапит, СтруктураПараметров);
	ТекстОшибки = "";
	
	// Непосредственное формирование документов.
	ВсеОк = ФормированиеДокументов(ТаблицаВыборкиЗапросапит, СтруктураПараметров, ТекстОшибки);
	
	// Анализ результата.
	Если НЕ ВсеОк Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура запускает формирование типовых документов по документам "Выпуск блюд",
// выбранных в соответствии с отборами.
//
&НаСервере
Процедура ОбработкаПлановМеню()
	
	Перем ТаблицаВыборкиЗапросапит;
	
	ВсеОк = Истина;
	
