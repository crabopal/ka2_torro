// Процедура заполняет дерево документов.
//
&НаСервере
Процедура ЗаполнитьДеревоДокументов()
	
	ДеревоДокументов_ = РеквизитФормыВЗначение("ДеревоДокументов");
	ДеревоДокументов_.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	питВыпускБлюд.Ссылка КАК ДокументОбщепит,
	|	питВыпускБлюд.Дата,
	|	питВыпускБлюд.ПометкаУдаления
	|ПОМЕСТИТЬ втВсеДокументыпит
	|ИЗ
	|	Документ.питВыпускБлюд КАК питВыпускБлюд
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Дата = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ питВыпускБлюд.Дата < &Дата
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ питВыпускБлюд.Организация = &Организация
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питПланМеню.Ссылка,
	|	питПланМеню.Дата,
	|	питПланМеню.ПометкаУдаления
	|ИЗ
	|	Документ.питПланМеню КАК питПланМеню
	|ГДЕ
	|	питПланМеню.Дата < &Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питРазделка.Ссылка,
	|	питРазделка.Дата,
	|	питРазделка.ПометкаУдаления
	|ИЗ
	|	Документ.питРазделка КАК питРазделка
	|ГДЕ
	|	питРазделка.Дата < &Дата
	|";
	Если ФормироватьСпецификацииПоРецептурам Тогда
		Запрос.Текст = Запрос.Текст + "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	питРецептура.Ссылка,
		|	питРецептура.Дата,
		|	питРецептура.ПометкаУдаления
		|ИЗ
		|	Документ.питРецептура КАК питРецептура
		|ГДЕ
		|	питРецептура.Дата < &Дата
		|	И питРецептура.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.РецептураПриготовление)
		|";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питРегистрацияЗамен.Ссылка,
	|	питРегистрацияЗамен.Дата,
	|	питРегистрацияЗамен.ПометкаУдаления
	|ИЗ
	|	Документ.питРегистрацияЗамен КАК питРегистрацияЗамен
	|ГДЕ
	|	питРегистрацияЗамен.Дата < &Дата
	|";
	Запрос.Текст = Запрос.Текст + "
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питРегистрацияЗамен.Ссылка,
	|	питРегистрацияЗамен.Дата,
	|	питРегистрацияЗамен.ПометкаУдаления
	|ИЗ
	|	Документ.питИнвентаризацияТоваров КАК питРегистрацияЗамен
	|ГДЕ
	|	питРегистрацияЗамен.Дата < &Дата
	|";
	Запрос.Текст = Запрос.Текст + "
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питПеремещениеНоменклатурыСкладаПроизводства.Ссылка,
	|	питПеремещениеНоменклатурыСкладаПроизводства.Дата,
	|	питПеремещениеНоменклатурыСкладаПроизводства.ПометкаУдаления
	|ИЗ
	|	Документ.питПеремещениеНоменклатурыСкладаПроизводства КАК питПеремещениеНоменклатурыСкладаПроизводства
	|ГДЕ
	|	питПеремещениеНоменклатурыСкладаПроизводства.Дата < &Дата
	|";
	Запрос.Текст = Запрос.Текст + "
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питДокументТест.Ссылка,
	|	питДокументТест.Дата,
	|	питДокументТест.ПометкаУдаления
	|ИЗ
	|	Документ.питДокументТест КАК питДокументТест
	|ГДЕ
	|	питДокументТест.Дата < &Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втВсеДокументыпит.ДокументОбщепит КАК ДокументОбщепит,
	|	ВЫБОР
	|		КОГДА втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питВыпускБлюд
	|			ТОГДА ""Документы """"Выпуск блюд""""""
	|		КОГДА втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питПланМеню
	|			ТОГДА ""Документы """"План меню""""""
	|		КОГДА втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питРазделка
	|			ТОГДА ""Документы """"Разделка""""""";
	Если ФормироватьСпецификацииПоРецептурам Тогда
		Запрос.Текст = Запрос.Текст + "
		|	КОГДА втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питРецептура
		|		ТОГДА ""Документы """"Рецептура""""""";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|	КОГДА втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питРегистрацияЗамен
	|		ТОГДА ""Документы """"Регистрация замен""""""";
	Запрос.Текст = Запрос.Текст + "
	|	КОГДА втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питИнвентаризацияТоваров
	|		ТОГДА ""Документы """"Инвентаризация товаров""""""";
	Запрос.Текст = Запрос.Текст + "
	|	КОГДА втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питПеремещениеНоменклатурыСкладаПроизводства
	|		ТОГДА ""Документы """"Перемещение номенклатуры склада и производства""""""";
	Запрос.Текст = Запрос.Текст + "
	|		ИНАЧЕ ""ПРОЧИЕ документы """"Общепит""""""
	|	КОНЕЦ КАК ПредставлениеТипаДокументовпит,
	|	ЕСТЬNULL(питТиповыеДокументы.ТиповойДокумент, ЗНАЧЕНИЕ(Документ.ВыпускПродукции.ПустаяСсылка)) КАК ТиповойДокумент,
	|	ЕСТЬNULL(питТиповыеДокументы.Синхронизирован, ЛОЖЬ) КАК Синхронизирован
	|ИЗ
	|	втВсеДокументыпит КАК втВсеДокументыпит
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|		ПО втВсеДокументыпит.ДокументОбщепит = питТиповыеДокументы.ДокументОбщепит
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ТолькоНеСинхр = ИСТИНА
	|				ТОГДА ЕСТЬNULL(питТиповыеДокументы.Синхронизирован, ЛОЖЬ) = ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ("+?(ФормироватьСпецификацииПоРецептурам, "втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питРецептура ИЛИ","")+" втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питРегистрацияЗамен ИЛИ "+ " втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питИнвентаризацияТоваров ИЛИ "+ " втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питПеремещениеНоменклатурыСкладаПроизводства ИЛИ "+ " втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питРазделка ИЛИ втВсеДокументыпит.ДокументОбщепит ССЫЛКА Документ.питВыпускБлюд)
	|					И НЕ втВсеДокументыпит.ПометкаУдаления
	|				ТОГДА НЕ питТиповыеДокументы.ТиповойДокумент.ПометкаУдаления
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	втВсеДокументыпит.Дата
	|ИТОГИ
	|	МИНИМУМ(Синхронизирован)
	|ПО
	|	ПредставлениеТипаДокументовпит,
	|	ДокументОбщепит";
	
	Запрос.УстановитьПараметр("Организация"		,ОтборОрганизация);
	Запрос.УстановитьПараметр("Дата"			,КонецДня(ФормироватьПо));
	Запрос.УстановитьПараметр("ТолькоНеСинхр"	,ПоказатьТолькоНеобхСинхр);
	
	ВыборкаТипыДокументов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТипыДокументов.Следующий() Цикл
		
		СтрокаТипа = ДеревоДокументов_.Строки.Добавить();
		СтрокаТипа.Группировка		= ВыборкаТипыДокументов.ПредставлениеТипаДокументовпит;
		СтрокаТипа.Синхронизирован	= ВыборкаТипыДокументов.Синхронизирован;
		СтрокаТипа.Картинка			= 0;
		
		ВыборкаДокументыпит = ВыборкаТипыДокументов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Количествопит = ВыборкаДокументыпит.Количество();
		КоличествопитСинхр = 0;
		Пока ВыборкаДокументыпит.Следующий() Цикл
			
			Строкапит = СтрокаТипа.Строки.Добавить();
			Строкапит.Группировка		= ВыборкаДокументыпит.ДокументОбщепит;
			Строкапит.Синхронизирован	= ВыборкаДокументыпит.Синхронизирован;
			Строкапит.Картинка			= 0;
			
			Если ВыборкаДокументыпит.Синхронизирован Тогда
				СтрокаТипа.Картинка = 2;
				КоличествопитСинхр = КоличествопитСинхр + 1;
			КонецЕсли;
			
			ВыборкаТиповыеДокументы = ВыборкаДокументыпит.Выбрать();
			КоличествоТиповые = ВыборкаТиповыеДокументы.Количество();
			КоличествоТиповыеСинхр = 0;
			Пока ВыборкаТиповыеДокументы.Следующий() Цикл
				
				Если НЕ ЗначениеЗаполнено(ВыборкаТиповыеДокументы.ТиповойДокумент) Тогда
					Прервать;
				КонецЕсли;
				
				СтрокаТиповые = Строкапит.Строки.Добавить();
				СтрокаТиповые.Группировка		= ВыборкаТиповыеДокументы.ТиповойДокумент;
				СтрокаТиповые.Синхронизирован	= ВыборкаТиповыеДокументы.Синхронизирован;
				СтрокаТиповые.Картинка			= ?(СтрокаТиповые.Синхронизирован,1,0);
				
				Если СтрокаТиповые.Синхронизирован Тогда
					Строкапит.Картинка = 2;
					КоличествоТиповыеСинхр = КоличествоТиповыеСинхр + 1;
				КонецЕсли;
				
			КонецЦикла;
			
			Если КоличествоТиповые = КоличествоТиповыеСинхр Тогда
				Строкапит.Картинка = 1;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Количествопит = КоличествопитСинхр Тогда
			СтрокаТипа.Картинка = 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоДокументов_, "ДеревоДокументов");
	
КонецПроцедуры

// Функция ищет максимальную дату документа "пит", для которого еще
//  не созданы типовые документы либо флаг "Синхронизирован" - Ложь.
//
// Параметры:
//  Организация	 - СправочникСсылка.Организации	 - Отбор по организации.
// 
// Возвращаемое значение:
//  Дата - Найденная дата формирования.
//
&НаСервере
Процедура УстановитьДатуФормированияТиповыхДокументов(Организация = Неопределено)
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	ДатаФормированияТиповых = Дата("00010101");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	питДок.Ссылка КАК ДокументОбщепит,
	|	питДок.Дата
	|ПОМЕСТИТЬ втВсеДокументыпит
	|ИЗ
	|	Документ.питВыпускБлюд КАК питДок
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ питДок.Организация = &Организация
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питДок.Ссылка,
	|	питДок.Дата
	|ИЗ
	|	Документ.питПланМеню КАК питДок
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ питДок.Организация = &Организация
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питДок.Ссылка,
	|	питДок.Дата
	|ИЗ
	|	Документ.питРазделка КАК питДок
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ питДок.Организация = &Организация
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питДок.Ссылка,
	|	питДок.Дата
	|ИЗ
	|	Документ.питРецептура КАК питДок
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ питДок.Организация = &Организация
	|		КОНЕЦ
	|	И питДок.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.РецептураПриготовление)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питДокументТест.Ссылка,
	|	питДокументТест.Дата
	|ИЗ
	|	Документ.питДокументТест КАК питДокументТест
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втВсеДокументыпит.Дата КАК Дата,
	|	втВсеДокументыпит.ДокументОбщепит
	|ИЗ
	|	втВсеДокументыпит КАК втВсеДокументыпит
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|		ПО втВсеДокументыпит.ДокументОбщепит = питТиповыеДокументы.ДокументОбщепит
	|ГДЕ
	|	ЕСТЬNULL(питТиповыеДокументы.Синхронизирован, ЛОЖЬ) = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Организация",Организация);
	
	ОбщееОписаниеПодсказки = "Предельная дата документов ""Общепит"", по которым осуществляется формирование документов ""1С:ERP"". 
	|";
	СодержимоеЗаголовкаПодсказки = Новый Массив;
	СодержимоеЗаголовкаПодсказки.Добавить(ОбщееОписаниеПодсказки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ФормироватьПо = ?(Выборка.Дата = NULL, ТекущаяДата(), Выборка.Дата);
		ПоследнийНесинхрДокументОбщепит = Выборка.ДокументОбщепит;
		СодержимоеЗаголовкаПодсказки.Добавить("Вычислена автоматически как конец дня от максимальной даты ");
		СодержимоеЗаголовкаПодсказки.Добавить(Новый ФорматированнаяСтрока("документа ""Общепит""",,,,"Документпит"));
		СодержимоеЗаголовкаПодсказки.Добавить(", по которому еще не сформированы "+Символы.ПС+"типовые документы либо сформированные документы не синхронизированы.");
	Иначе
		ФормироватьПо = ТекущаяДата();
		ПоследнийНесинхрДокументОбщепит = Документы.питВыпускБлюд.ПустаяСсылка();
		СодержимоеЗаголовкаПодсказки.Добавить("Вычислена автоматически как конец дня от текущей даты, т.к. по выбранной организации не найдено документов, 
		|которые необходимо синхронизировать.");
	КонецЕсли;
	
	Элементы.ФормироватьПоРасширеннаяПодсказка.Заголовок = Новый ФорматированнаяСтрока(СодержимоеЗаголовкаПодсказки);
	
КонецПроцедуры

// Процедура устанавливает текущую строку дерева документов по переданному
//  значению колонки "Группировка".
//
// Параметры:
//  ТекГруппировка	 - Строка, ДокументСсылка.<Документпит/Типовой> - Значение группировки.
//  ТекВеткаДерева	 - ДеревоДанныеФормы - Очередная ветка дерева
//
&НаКлиенте
Процедура УстановитьТекущуюСтрокуДереваДокументов(ТекГруппировка,ТекВеткаДерева)
	
	Для каждого ТекЭлемент1 Из ТекВеткаДерева.ПолучитьЭлементы() Цикл
		Если ТекЭлемент1.Группировка = ТекГруппировка Тогда
			Элементы.ДеревоДокументов.ТекущаяСтрока = ТекЭлемент1.ПолучитьИдентификатор();
		Иначе
			УстановитьТекущуюСтрокуДереваДокументов(ТекГруппировка,ТекЭлемент1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РежимПроизводстваРазрешен(ФормироватьДокументыПроизводства22 = Неопределено, ТекстОшибки = "")
	
	Если ФормироватьДокументыПроизводства22 = Неопределено Тогда
		ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	КонецЕсли;
	
	ВсеОк = НЕ питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22, ТекстОшибки);
	Возврат ВсеОк;
	
КонецФункции

#КонецОбласти


