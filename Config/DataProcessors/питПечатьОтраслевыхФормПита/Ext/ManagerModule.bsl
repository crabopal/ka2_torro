			// 	Перечисления.СпособыОценкиТоваровВРознице.ПоПродажнойСтоимости);
			УчетПоПродажнойСтоимости = Ложь; 
			// ***--- См выше.Нет ни такоф функции ни перечисления
			
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			// Запомним номер строки, с которой начали выводить текущий документ.
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			// Выводим шапку накладной
			СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Шапка.Организация, Шапка.ДатаДокумента);
			
			ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
			ОбластьМакета.Параметры.Заполнить(Шапка);
			ОбластьМакета.Параметры.ПредставлениеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации);
			ОбластьМакета.Параметры.КодПоОКПО   = СведенияОбОрганизации.КодПоОКПО;
			ОбластьМакета.Параметры.Час         = Формат(Шапка.ДатаДокумента, "ДФ = ЧЧ");
			ОбластьМакета.Параметры.Минут       = Формат(Шапка.ДатаДокумента, "ДФ = мм");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			НомерСтраницы = 1;
			
			// Выводим заголовок таблицы
			ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
			ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы;
			ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
			
			КоличествоСтрок = ВыборкаСтрокТовары.Количество();
			
			// Инициализация итогов по странице
			ИтогКоличествоПоСтранице = 0;
			ИтогСуммаПоСтранице      = 0;
			ИтогСуммаУчетПоСтранице  = 0;
			
			// Инициализация итогов по документу
			ИтогКоличество = 0;
			ИтогСумма      = 0;
			ИтогСуммаУчет  = 0;
			ВыборкаСтрокТоварыСумма = 0;
			
			Ном = 0;
			
			// Выводим многострочную часть документа
			ОбластьИтоговПоСтранице = Макет.ПолучитьОбласть("ИтогиПоСтранице");
			ОбластьМакетаВсего = Макет.ПолучитьОбласть("Всего");
			ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
			ОбластьМакета = Макет.ПолучитьОбласть("Строка");
			
			Пока ВыборкаСтрокТовары.Следующий() Цикл
				
				Ном = Ном + 1;
				
				ОбластьМакета.Параметры.Заполнить(ВыборкаСтрокТовары);
				ОбластьМакета.Параметры.НомерСтроки = Ном;
				ОбластьМакета.Параметры.ТоварНаименование = ВыборкаСтрокТовары.НоменклатураНаименование 
					+ ?(ЗначениеЗаполнено(ВыборкаСтрокТовары.ХарактеристикаНаименование), "/" + ВыборкаСтрокТовары.ХарактеристикаНаименование, "");
				ОбластьМакета.Параметры.ТоварНаименование = ?(ВыборкаСтрокТовары.ID = 3, СокрЛП(ОбластьМакета.Параметры.ТоварНаименование) 
					+ " (возвратная тара)", ОбластьМакета.Параметры.ТоварНаименование);
					
					
					
				
					
				Если ВыборкаСтрокТовары.ID = 1 И УчетПоПродажнойСтоимости 
					И (Шапка.ТипСкладаПолучателя <> Перечисления.ТипыСкладов.ОптовыйСклад
					ИЛИ Шапка.ТипСкладаОтправителя <> Перечисления.ТипыСкладов.ОптовыйСклад) Тогда
//   РозничнаяЦена                 = Ценообразование.ПолучитьЦенуНоменклатуры(ВыборкаСтрокТовары.Номенклатура,
// Шапка.ТипЦенРозничнойТорговлиСкладаПолучателя, Шапка.ДатаДокумента, ВалютаПечати, 1, 1);.
					// РозничнаяЦена                 = РозничнаяЦена * ВыборкаСтрокТовары.Коэффициент;
					///***---ТипыЦенУпрощенно
					РозничнаяЦена = питПроизводство.ПолучитьСтоимостьИнгредиента(ВыборкаСтрокТовары.Номенклатура, Шапка.ТипЦенРозничнойТорговлиСкладаПолучателя,  Шапка.ДатаДокумента, ВалютаПечати,,,,, ВыборкаСтрокТовары.Упаковка);
					РозничнаяСумма                = РозничнаяЦена * ВыборкаСтрокТовары.Количество;
					ОбластьМакета.Параметры.Цена  = РозничнаяЦена;
					ОбластьМакета.Параметры.Сумма = РозничнаяСумма;
					ВыборкаСтрокТоварыСумма       = ВыборкаСтрокТоварыСумма + РозничнаяСумма;
				Иначе
					РозничнаяСумма = 0;
				КонецЕсли;
				
				СтруктураПоиска.Вставить("Регистратор",  Шапка.Ссылка);
				СтруктураПоиска.Вставить("Номенклатура", ВыборкаСтрокТовары.Номенклатура);
				НайденныеСтроки = ТаблицаСуммСписанияПоДокументам.НайтиСтроки(СтруктураПоиска);
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					ЦенаПеремещения = 0;
					Сумма = 0;
				Иначе
					КоэффициентУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ВыборкаСтрокТовары.Номенклатура,ВыборкаСтрокТовары.УпаковкаСсылка);
					СтрокаСуммСписания = НайденныеСтроки[0];
					ЦенаПеремещения = ?(СтрокаСуммСписания.Количество = 0, 0, СтрокаСуммСписания.Сумма / СтрокаСуммСписания.Количество) * КоэффициентУпаковки;
					Сумма           = Окр(ЦенаПеремещения * ВыборкаСтрокТовары.Количество, 2, 1);
				КонецЕсли;
				
				Если Шапка.ТипСкладаПолучателя = Перечисления.ТипыСкладов.ОптовыйСклад Тогда
					ВыборкаСтрокТоварыСумма = ВыборкаСтрокТоварыСумма + Сумма;
				КонецЕсли;	
				
				ОбластьМакета.Параметры.ЦенаУчет  = ЦенаПеремещения;
				ОбластьМакета.Параметры.СуммаУчет = Сумма;
				
				// Проверим вывод
				СтрокаСПодвалом = Новый Массив;
				СтрокаСПодвалом.Добавить(ОбластьМакета);
				СтрокаСПодвалом.Добавить(ОбластьИтоговПоСтранице);
				Если Ном = КоличествоСтрок Тогда                   // Если последняя строка, должен
					СтрокаСПодвалом.Добавить(ОбластьМакетаВсего);  // помещаться и подвал документа
					СтрокаСПодвалом.Добавить(ОбластьМакетаПодвал);
				КонецЕсли;
				
				Если НЕ питОбщегоНазначенияСервер.ПроверитьВыводТабличногоДокумента(ТабличныйДокумент, СтрокаСПодвалом) Тогда
					
					Если КоличествоСтрок > 1 Тогда
						
						ОбластьИтоговПоСтранице.Параметры.ИтогКоличествоПоСтранице = ИтогКоличествоПоСтранице;
						ОбластьИтоговПоСтранице.Параметры.ИтогСуммаПоСтранице      = ИтогСуммаПоСтранице;
						ОбластьИтоговПоСтранице.Параметры.ИтогСуммаУчетПоСтранице  = ИтогСуммаУчетПоСтранице;
						
						ТабличныйДокумент.Вывести(ОбластьИтоговПоСтранице);
						ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						
						// Инициализация итогов по странице
						ИтогКоличествоПоСтранице = 0;
						ИтогСуммаПоСтранице      = 0;
						ИтогСуммаУчетПоСтранице  = 0;
						
						НомерСтраницы = НомерСтраницы + 1;
						ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы;
						ТабличныйДокумент.Вывести(ЗаголовокТаблицы);
					КонецЕсли;
					
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				// Обновим итоги по странице
				ИтогКоличествоПоСтранице = ИтогКоличествоПоСтранице + ВыборкаСтрокТовары.Количество;
				Если НЕ Шапка.ТипСкладаПолучателя = Перечисления.ТипыСкладов.ОптовыйСклад Тогда
					ИтогСуммаПоСтранице  = ИтогСуммаПоСтранице + РозничнаяСумма;
				КонецЕсли;
				ИтогСуммаУчетПоСтранице  = ИтогСуммаУчетПоСтранице + Сумма;
				
				// Обновим итоги по документу
				ИтогКоличество = ИтогКоличество + ВыборкаСтрокТовары.Количество;
				Если НЕ Шапка.ТипСкладаПолучателя = Перечисления.ТипыСкладов.ОптовыйСклад Тогда
					ИтогСумма  = ИтогСумма + РозничнаяСумма;
				КонецЕсли;
				ИтогСуммаУчет  = ИтогСуммаУчет + Сумма;
				
			КонецЦикла;
			
			ОбластьИтоговПоСтранице.Параметры.ИтогКоличествоПоСтранице = ИтогКоличествоПоСтранице;
			ОбластьИтоговПоСтранице.Параметры.ИтогСуммаПоСтранице      = ИтогСуммаПоСтранице;
			ОбластьИтоговПоСтранице.Параметры.ИтогСуммаУчетПоСтранице  = ИтогСуммаУчетПоСтранице;
			
			ТабличныйДокумент.Вывести(ОбластьИтоговПоСтранице);
			
			// Выводим итоги по документу в целом
			ОбластьМакетаВсего.Параметры.ИтогКоличество = ИтогКоличество;
			ОбластьМакетаВсего.Параметры.ИтогСумма      = ИтогСумма;
			ОбластьМакетаВсего.Параметры.ИтогСуммаУчет  = ИтогСуммаУчет;
			
			ТабличныйДокумент.Вывести(ОбластьМакетаВсего);
			
			// Вывести подвал
			ОбластьМакетаПодвал.Параметры.Сумма         = ВыборкаСтрокТоварыСумма;
			ОбластьМакетаПодвал.Параметры.СуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ВыборкаСтрокТоварыСумма, ВалютаПечати);
			
			// Получаем руководителей
			Руководители = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Шапка.Организация, Шапка.ДатаДокумента);
			ОбластьМакетаПодвал.Параметры.ДолжностьРуководителя     = Руководители.РуководительДолжность;
			ОбластьМакетаПодвал.Параметры.Руководитель              = Руководители.РуководительНаименование;
			Если Руководители.Свойство("питЗаведующийПроизводством") Тогда
				ОбластьМакетаПодвал.Параметры.ДолжностьЗаведующийПроизводством = Руководители.питЗаведующийПроизводствомДолжность;
				ОбластьМакетаПодвал.Параметры.ЗаведующийПроизводством          = Руководители.питЗаведующийПроизводствомНаименование;
			КонецЕсли; 
			
			ОбластьМакетаПодвал.Параметры.ДолжностьОтправителя =  Шапка.ДолжностьКладовщикаОтправителя;
			ОбластьМакетаПодвал.Параметры.ФИООтправителя = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(Шапка.КладовщикОтправитель, Шапка.ДатаДокумента);;
			ОбластьМакетаПодвал.Параметры.ДолжностьПолучателя =  Шапка.ДолжностьКладовщикаПолучателя;
			ОбластьМакетаПодвал.Параметры.ФИОПолучателя = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(Шапка.КладовщикПолучатель, Шапка.ДатаДокумента);;
			
			ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
			
			// В табличном документе зададим имя области, в которую был 
			// выведен объект. Нужно для возможности печати покомплектно.
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
				НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьОП4()

#КонецОбласти

#КонецЕсли



