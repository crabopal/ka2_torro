Процедура ОсновныеДействияФормыПродолжить(Команда)
		
	Результат = ПодтверждениеБулево;
	
	Если Результат = Истина Тогда
		ЗаписатьПодтверждениеСогласияСПользовательскимСоглашением();
	КонецЕсли;
	
	Закрыть(Результат);
	
