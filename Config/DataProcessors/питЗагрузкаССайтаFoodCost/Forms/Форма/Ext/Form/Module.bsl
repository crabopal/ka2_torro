&НаСервере
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);
КонецФункции // ЗначениеРеквизитаОбъекта()

// Функция - Получить текст.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолучитьТекст()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ПолучитьМакет("Макет").ПолучитьТекст();
КонецФункции

// Процедура - Отметить все подчиненные элементы.
//
// Параметры:
//  ТекСтроки - Произвольный - Тек строки.
//  Значение - Число - Значение.
//  ИмяДерева - Строка - Имя дерева.
//
&НаКлиенте
Процедура ОтметитьВсеПодчиненныеЭлементы(ТекСтроки, Значение=0, ИмяДерева = "")

	Если ТекСтроки.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	Для каждого стр Из ТекСтроки Цикл
		стр.Отметка=Значение;
		стр.Галочка=Значение;
		
		Если (ИмяДерева = "ДеревоГотовойПродукции") И Стр.ЭтоИнгредиент = 1 Тогда
			// Отметим соответствующие в дереве ингредиентов.
			Индекс = "";
			НайтиРеквизитВДереве(Объект.ДеревоИнгредиентов.ПолучитьЭлементы(), Стр.fc_id, Индекс);
			Если Индекс <> "" Тогда
				ЭлементКоллекции = объект.ДеревоИнгредиентов.НайтиПоИдентификатору(Индекс);
				ЭлементКоллекции.Галочка = Значение;
				ЭлементКоллекции.Отметка = Значение;
				РасстановкаГалочекУРодителей(ЭлементКоллекции.ПолучитьРодителя());
			КонецЕсли;
			
		КонецЕсли;
		
		ОтметитьВсеПодчиненныеЭлементы(стр.ПолучитьЭлементы(), Значение);
	КонецЦикла;

КонецПроцедуры // ОтметитьВсеПодчиненныеЭлементы()

// Процедура - Расстановка галочек у родителей.
//
// Параметры:
//  Родитель - Произвольный - Родитель.
//
&НаКлиенте
Процедура РасстановкаГалочекУРодителей(Родитель)

	Если Родитель=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// нужно пробежаться по подчиненным строкам (на 1 уровень)
	ВсеОтмечены = Истина;
	ВсеСняты    = Истина;
	
	Для каждого стр Из Родитель.ПолучитьЭлементы() Цикл 		
		ТекОтметка = стр.Отметка;
		Если ТекОтметка=0 или ТекОтметка=2 Тогда
			ВсеОтмечены = Ложь;
		КонецЕсли;
		
		Если ТекОтметка=1 или ТекОтметка=2 Тогда
			ВсеСняты = Ложь;
		КонецЕсли; 			
	КонецЦикла;
	
	Если ВсеОтмечены Тогда
		Родитель.Отметка = 1;
	ИначеЕсли ВсеСняты Тогда
		Родитель.Отметка = 0;
	Иначе
		Родитель.Отметка = 2;
	КонецЕсли;
	Родитель.Галочка = Родитель.Отметка;
	
	РасстановкаГалочекУРодителей(Родитель.ПолучитьРодителя());	
КонецПроцедуры // РасстановкаГалочекУРодителей()



// Процедура - Найти реквизит в дереве.
//
// Параметры:
//  КоллекцияСтрокДереваОдногоУровня - Произвольный - Коллекция строк дерева одного уровня.
//  ИскомыйКод - Произвольный - Искомый код.
//  Индекс - Произвольный - Индекс.
//
&НаКлиенте
Процедура НайтиРеквизитВДереве(КоллекцияСтрокДереваОдногоУровня, ИскомыйКод, Индекс)
	
	Для Каждого Стр1 Из КоллекцияСтрокДереваОдногоУровня Цикл
		Если Стр1.fc_id = ИскомыйКод Тогда
			Индекс = Стр1.ПолучитьИдентификатор();
		Иначе
			НайтиРеквизитВДереве(Стр1.ПолучитьЭлементы(), ИскомыйКод, Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Сохранить настройки.
//
&НаСервере
Процедура СохранитьНастройки()
	
	Константы.питФудКостПроцентСхожести.Установить(ФудКостПроцентСхожести);
	
	ХранилищеНастроекДанныхФорм.Сохранить(ЭтаФорма.ИмяФормы,"ФормаЗагрузкаССайтаFoodCost_ГруппаПоУмолчанию", ГруппаПоУмолчанию);
	ХранилищеНастроекДанныхФорм.Сохранить(ЭтаФорма.ИмяФормы,"ФормаЗагрузкаССайтаFoodCost_СпособЦелевойГруппы", СпособЦелевойГруппы);
	
	ХранилищеНастроекДанныхФорм.Сохранить(ЭтаФорма.ИмяФормы,"ФормаЗагрузкаССайтаFoodCost_НоменклатурнаяГруппаГотоваяПродукция", объект.НоменклатурнаяГруппаГотоваяПродукция);
	ХранилищеНастроекДанныхФорм.Сохранить(ЭтаФорма.ИмяФормы,"ФормаЗагрузкаССайтаFoodCost_НоменклатурнаяГруппаИнгредиенты", объект.НоменклатурнаяГруппаИнгредиенты);
	
	ХранилищеНастроекДанныхФорм.Сохранить(ЭтаФорма.ИмяФормы,"ФормаЗагрузкаССайтаFoodCost_РецептурыОбновлятьСуществующие", РецептурыОбновлятьСуществующие);
	ХранилищеНастроекДанныхФорм.Сохранить(ЭтаФорма.ИмяФормы,"ФормаЗагрузкаССайтаFoodCost_РецептурыСоздавать", РецептурыСоздавать);
	
	ХранилищеНастроекДанныхФорм.Сохранить(ЭтаФорма.ИмяФормы,"ФормаЗагрузкаССайтаFoodCost_ОбновлятьСуществующиеХЭХи", ОбновлятьСуществующиеХЭХи);
	
КонецПроцедуры

// Получает файл с сайта и обрабатывает ошибку если есть.
//  Строка запроса уже сформирована.
//
// Параметры:
//  Адрес - Произвольный - Адрес.
//  ЗапросХТТП - Произвольный - Запрос хттп.
//  ИмяФайла - Произвольный - Имя файла.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолучитьФайлССайта(Адрес,ЗапросХТТП, ИмяФайла)
	Рез = Истина; 
	Соединение = Новый HTTPСоединение(Адрес,,,,,,Новый ЗащищенноеСоединениеOpenSSL(),Ложь);
	Попытка	
		Соединение.Получить(ЗапросХТТП, ИмяФайла);
	Исключение
		ТекстОшибки = ИнформацияОбОшибке();
		Если ТекстОшибки.Причина = Неопределено Тогда
			ТекстОшибки = ТекстОшибки.Описание;
		Иначе
			ТекстОшибки = ТекстОшибки.Причина.Описание;
		КонецЕсли;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
		Элементы.ДействияФормыПараметрыАвторизации.Заголовок = "Ошибка подключения к сайту. Обратитесь в службу поддержки...";
		Элементы.ДействияФормыПараметрыАвторизации.ЦветТекста = WebЦвета.Красный;
		Рез = Ложь;
	КонецПопытки;
	
	Возврат Рез;
	
КонецФункции


// Получает ключ сессии с сайта в первый раз когда его еще нет.
//  Помещает его в константу и реквизит обработки
//
// Параметры:
//  ДеревоТоваров - ДеревоЗначений - Дерево товаров.
//  ФайлРезультата - Произвольный - Файл результата.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолучитьСессиюССайта(ДеревоТоваров, ФайлРезультата)
	
	Если НЕ ПолучитьФайлССайта(Объект.АдресСервера,"?LOGIN="+Объект.ИмяПользователя+"&PASSWORD="+Объект.Пароль+"&KEY="+Объект.КлючИнтеграции+"&file=ingredients&v=2",  ФайлРезультата) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДеревоТоваров.Строки.Очистить();
	Рез = ЗагрузитьXML(ФайлРезультата, ДеревоТоваров, "Ингредиенты");
	
	Возврат Рез;
КонецФункции

// Процедура - Установить цвет кнопки настройки параметров подключения.
//
&НаСервере
Процедура УстановитьЦветКнопкиНастройкиПараметровПодключения()
	
	Объект.ИмяПользователя = Константы.питФудКостИмяПользователя.Получить();
	Объект.Пароль = Константы.питФудКостПароль.Получить();
	Объект.КлючИнтеграции = Константы.питФудКостКлючИнтеграции.Получить();
	Объект.ДемоДоступ = Константы.питФудКостДемоДоступ.Получить();
	
	
	Если НЕ ((ЗначениеЗаполнено(Объект.ИмяПользователя) И ЗначениеЗаполнено(Объект.Пароль) И ЗначениеЗаполнено(Объект.КлючИнтеграции)) ИЛИ Объект.ДемоДоступ) Тогда
		ЗаголовокКнопки = НСтр("ru='Не заполнены параметры подключения к серверу'", "ru");
		ЦветТекстаКнопки = WebЦвета.Красный;
	Иначе
		ЗаголовокКнопки = НСтр("ru='Параметры подключения ...'", "ru");
		ЦветТекстаКнопки = Новый Цвет(28,85,174);
	КонецЕсли;
	
	Элементы.ДействияФормыПараметрыАвторизации.Заголовок = ЗаголовокКнопки;
	Элементы.ДействияФормыПараметрыАвторизации.ЦветТекста = ЦветТекстаКнопки;

КонецПроцедуры


// Процедура - Получить данные на сервере.
//
&НаСервере
Процедура ПолучитьДанныеНаСервере()
	
	ПОЛУЧАТЬДАННЫЕИЗФАЙЛОВ = Ложь;
	
	Объект.ИмяПользователя = Константы.питФудКостИмяПользователя.Получить();
	Объект.Пароль = Константы.питФудКостПароль.Получить();
	Объект.КлючИнтеграции = Константы.питФудКостКлючИнтеграции.Получить();
	Объект.КлючСессии = Константы.питФудКостКлючСессии.Получить();
	Объект.ДемоДоступ = Константы.питФудКостДемоДоступ.Получить();
	Объект.АдресСервераДемо = "foodcost.pro/personal/exchange/demo/v.2/";
	Объект.АдресСервера = "foodcost.pro/personal/exchange/";
	
	СоздатьЗапросГотовогоСоответствияНаСервере();
	
	
	Если (НЕ ЗначениеЗаполнено(Объект.ИмяПользователя) или НЕ ЗначениеЗаполнено(Объект.Пароль) или НЕ ЗначениеЗаполнено(Объект.КлючИнтеграции)) и Не Объект.ДемоДоступ Тогда
			Элементы.ДействияФормыПараметрыАвторизации.Заголовок = "Ошибка подключения к сайту. Обратитесь в службу поддержки...";
			Элементы.ДействияФормыПараметрыАвторизации.ЦветТекста = WebЦвета.Красный;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите имя пользователя, пароль и ключ интеграции или выберите демонстрационный режим загрузки по кнопке 'Параметры авторизации'!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ДИ = РеквизитФормыВЗначение("Объект.ДеревоИнгредиентов");
	ДИ.Строки.Очистить();
	ДеревоТоваров = ДИ.Скопировать();
	
	
	Если ПОЛУЧАТЬДАННЫЕИЗФАЙЛОВ Тогда
		ФайлРезультата = "d:\RUBTAL\FoodCost\v8_80F5_ИнгрДемо.xml";
	Иначе
		
		ФайлРезультата = ПолучитьимяВременногоФайла("xml");
		
		Если Объект.ДемоДоступ Тогда
			// Получаем демо ингредиенты.
			Если НЕ ПолучитьФайлССайта(Объект.АдресСервераДемо,"products.xml",  ФайлРезультата) Тогда
				Возврат;
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеЗаполнено(Объект.КлючСессии) Тогда
				НашлиКлючСессии = ПолучитьСессиюССайта(ДеревоТоваров, ФайлРезультата);
			Иначе
				НашлиКлючСессии = Истина;
			КонецЕсли;
			// Получаем собственно ингредиенты.
			Если НЕ ПолучитьФайлССайта(Объект.АдресСервера,"?LOGIN="+Объект.ИмяПользователя+
				"&PASSWORD="+Объект.Пароль+
				"&KEY="+Объект.КлючИнтеграции+
				"&KEY_SESSION="+Объект.КлючСессии +
				"&file=ingredients&v=2", ФайлРезультата) Тогда
				Возврат
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДеревоТоваров.Строки.Очистить();
	
	НашлиКлючСессии = ЗагрузитьXML(ФайлРезультата, ДеревоТоваров, "Ингредиенты");
	Если НЕ НашлиКлючСессии и НЕ Объект.ДемоДоступ Тогда
		// Возможно сессия сброшена, а в константе осталась старая. Попробуем получить новую.
		Объект.КлючСессии = "";
		НашлиКлючСессии = ПолучитьСессиюССайта(ДеревоТоваров, ФайлРезультата);
		Если НашлиКлючСессии Тогда
			// ПОЛУЧИМ ингредиенты еще раз с новой сессией
			Если НЕ ПолучитьФайлССайта(Объект.АдресСервера,"?LOGIN="+Объект.ИмяПользователя+
				"&PASSWORD="+Объект.Пароль+
				"&KEY="+Объект.КлючИнтеграции+
				"&KEY_SESSION="+Объект.КлючСессии+
				"&file=ingredients&v=2", ФайлРезультата) Тогда
				Возврат
			КонецЕсли;
		иначе
			Элементы.ДействияФормыПараметрыАвторизации.Заголовок = "Ошибка подключения к сайту. Обратитесь в службу поддержки...";
			Элементы.ДействияФормыПараметрыАвторизации.ЦветТекста = WebЦвета.Красный;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
		
	ДеревоТоваров.Строки.Очистить();
	НашлиКлючСессии = ЗагрузитьXML(ФайлРезультата, ДеревоТоваров, "Ингредиенты");
	
	Если НЕ НашлиКлючСессии и НЕ Объект.ДемоДоступ Тогда
		Элементы.ДействияФормыПараметрыАвторизации.Заголовок = "Ошибка подключения к сайту. Обратитесь в службу поддержки...";
		Элементы.ДействияФормыПараметрыАвторизации.ЦветТекста = WebЦвета.Красный;
		Возврат;
	КонецЕсли;
	
	
	МассивСтрок = ДеревоТоваров.Строки.НайтиСтроки(Новый Структура("parent_id", "0")); // 1413
	Для Каждого Стр из МассивСтрок Цикл
		НоваяСтрока = ДИ.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,,"Родитель");
		
		НоваяСтрока.НоменклатураБазы = ПолучитьСоответствиеИзРегистра(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура, СокрЛП(стр.fc_id));
		
		СкопироватьСтроки(НоваяСтрока, Стр, ДеревоТоваров, 3);
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДИ,"Объект.ДеревоИнгредиентов");
	
	Если ПОЛУЧАТЬДАННЫЕИЗФАЙЛОВ Тогда
		ФайлРезультата = "d:\RUBTAL\FoodCost\v8_80F5_БлюдаДемо.xml";
	иначе
		
		Если Объект.ДемоДоступ Тогда
			Если НЕ ПолучитьФайлССайта(Объект.АдресСервераДемо,"dish.xml", ФайлРезультата) Тогда //"foodcost.ru/support/dev/"
				Возврат;
			КонецЕсли;
		Иначе
			Если НЕ ПолучитьФайлССайта(Объект.АдресСервера,"?LOGIN="+Объект.ИмяПользователя+
				"&PASSWORD="+Объект.Пароль+
				"&KEY="+Объект.КлючИнтеграции+
				?(ЗначениеЗаполнено(Объект.КлючСессии), "&KEY_SESSION="+Объект.КлючСессии, "")+
				"&file=dish&v=2", ФайлРезультата) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДГП = РеквизитФормыВЗначение("Объект.ДеревоГотовойПродукции");
	ДГП.Строки.Очистить();
	ДеревоБлюд = ДГП.Скопировать();
	
	НашлиКлючСессии = ЗагрузитьXML(ФайлРезультата, ДеревоБлюд, "ГотоваяПродукция");
	Если НЕ НашлиКлючСессии и НЕ Объект.ДемоДоступ Тогда
		Элементы.ДействияФормыПараметрыАвторизации.Заголовок = "Ошибка подключения к сайту. Обратитесь в службу поддержки...";
		Элементы.ДействияФормыПараметрыАвторизации.ЦветТекста = WebЦвета.Красный;
		Возврат;
	КонецЕсли;
	
	// Поищем Блюда С Совпадающими Названиями
	таблИмена =  новый ТаблицаЗначений;
	таблИмена.Колонки.Добавить("Назв");
	таблИмена.Колонки.Добавить("Кол");
	Для Каждого стр из ДеревоБлюд.строки Цикл
		новСтр = таблИмена.Добавить();
		новСтр.Назв = Стр.name;
		новСтр.Кол = 1;
	КонецЦикла;
	таблИмена.Свернуть("Назв", "Кол");
	МассУдал = таблИмена.НайтиСтроки(Новый Структура("Кол", 1 )); 
	Для Каждого Стр из  МассУдал Цикл
		таблИмена.Удалить(стр);
	КонецЦикла;
	таблИмена.Колонки.Добавить("Ном");
	таблИмена.ЗаполнитьЗначения(1,"Ном"); 
	// Таблица "таблИмена" - таблица названий блюд которых пришло с сайта больше 1.
	// Колонка "ном" используется как счетчик для имен тима "Имя 1" "Имя 2".
	
	///***---999
	МассивСтрок = ДеревоБлюд.Строки.НайтиСтроки(Новый Структура("parent_id", "0")); // 886
	Для Каждого Стр из МассивСтрок Цикл
		НоваяСтрока = ДГП.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,,"Родитель");
		
		НоваяСтрока.НоменклатураБазы = ПолучитьСоответствиеИзРегистра(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура, стр.fc_id);		
		
		СкопироватьСтроки(НоваяСтрока, Стр, ДеревоБлюд, 2);
	КонецЦикла;
	
	///***---888 Блюда с совпадающими названиями
	МассивБлюд = ДеревоТоваров.Строки.НайтиСтроки(Новый Структура("ПризнакГруппы", Ложь), Истина);
	Для Каждого Стр из МассивБлюд  Цикл
		ТекСтр = таблИмена.Найти(Стр.Name);
		Если ТекСтр <> Неопределено Тогда
			Стр.Постфикс = ТекСтр.Ном;
			ТекСтр.ном = ТекСтр.ном + 1;
		КонецЕсли;
	КонецЦикла;
	///***---999 
	
	// Визуализируем рецепуры
	ТабСтрокиРецептур = ДанныеФормыВЗначение(ЭтаФорма.СтрокиРецептур, тип("ТаблицаЗначений"));
	МассивСтрок = ДГП.Строки.НайтиСтроки(Новый Структура("ПризнакГруппы", Ложь), Истина);
	Для Каждого Стр из МассивСтрок Цикл
		Если ЗначениеЗаполнено(стр.recipe) Тогда
			СписокСтрокРецептуры = ЗначениеИзСтрокиВнутр(стр.recipe);
			Для Каждого СтрокаСписка из СписокСтрокРецептуры Цикл
				СтрокаРецептуры = ТабСтрокиРецептур.Найти(СтрокаСписка, "fc_id");
				Если не СтрокаРецептуры = Неопределено Тогда
					СтрокаИнгредиента = ДИ.Строки.Найти(СтрокаРецептуры.ingredient, "fc_id", Истина);
					Если СтрокаИнгредиента = Неопределено Тогда
						СтрокаИнгредиента = ДГП.Строки.Найти(СтрокаРецептуры.ingredient, "fc_id", Истина);
						Если СтрокаИнгредиента = Неопределено Тогда
							// Нет так нет. здесь ничего не сообщать не надо.
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					НоваяСтрока = Стр.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИнгредиента);
					НоваяСтрока.ЭтоИнгредиент = 1;
					НоваяСтрока.ИндексКартинки = 3;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	
	ЗначениеВРеквизитФормы(ДГП, "Объект.ДеревоГотовойПродукции");
	
	Если НЕ ПОЛУЧАТЬДАННЫЕИЗФАЙЛОВ Тогда
		УдалитьФайлы(ФайлРезультата);
	КонецЕсли;
	
	
КонецПроцедуры

// Процедура - Скопировать строки.
//
// Параметры:
//  Куда - Произвольный - Куда.
//  Откуда - Произвольный - Откуда.
//  ДеревоОткуда - ДеревоЗначений - Дерево откуда.
//  ИндексКартинкиЭлемента - Произвольный - Индекс картинки элемента.
//
&НаСервере
Процедура СкопироватьСтроки(Куда, Откуда, ДеревоОткуда, ИндексКартинкиЭлемента)
	НовыйМассивСтрок = ДеревоОткуда.Строки.НайтиСтроки(Новый Структура("parent_id", Откуда.fc_id));
	Если НЕ НовыйМассивСтрок.Количество() = 0 Тогда
		Для Каждого Стр из НовыйМассивСтрок Цикл
			НоваяСтрока = Куда.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,,"Родитель");
			НоваяСтрока.НоменклатураБазы = ПолучитьСоответствиеИзРегистра(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура, стр.fc_id);
			Если НоваяСтрока.ПризнакГруппы Тогда
				НоваяСтрока.ИндексКартинки = 1;
			Иначе
				НоваяСтрока.ИндексКартинки = ИндексКартинкиЭлемента;
			КонецЕсли;
			СкопироватьСтроки(НоваяСтрока, Стр, ДеревоОткуда,ИндексКартинкиЭлемента);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Функция - Загрузить xml.
//
// Параметры:
//  ПутьКФайлу - Произвольный - Путь к файлу.
//  ДеревоДляЗагрузки - ДеревоЗначений - Дерево для загрузки.
//  ТипДерева - Строка - Тип дерева.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ЗагрузитьXML(ПутьКФайлу, ДеревоДляЗагрузки, ТипДерева="Ингредиенты")
	ФайлХМЛ = Новый ЧтениеXML;
	ФайлХМЛ.ОткрытьФайл(ПутьКФайлу);
	НашлиКлючСессии = Ложь;
	ЭтоСтрокиРецептуры = Ложь;
	ИзАтрибута = Ложь;
	ЗаполнениеТЗ = Ложь;
	ЭтоХЭХ = Ложь;
	ЭтоКомментарийСайта = Ложь;
	ИмяТЗ = Неопределено;
	Пока ФайлХМЛ.Прочитать() Цикл
		Если ФайлХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Пока ФайлХМЛ.Прочитать() Цикл
				Если ФайлХМЛ.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					Если ФайлХМЛ.Имя = "element" или ФайлХМЛ.Имя = "section" Тогда
						НоваяСтрока = ДеревоДляЗагрузки.Строки.Добавить();
						НоваяСтрока.ПризнакГруппы = ?(ФайлХМЛ.Имя = "element", Ложь, Истина);
						НоваяСтрока.ВидНоменклатуры = ?(ТипДерева = "Ингредиенты", Перечисления.питВидыНоменклатуры.Товар, Перечисления.питВидыНоменклатуры.Блюдо);
						НоваяСтрока.Отметка = "0";
					ИначеЕсли ФайлХМЛ.Имя = "properties" или ФайлХМЛ.Имя = "recipes" Тогда
						ЗаполнениеТЗ = Истина;
					ИначеЕсли ФайлХМЛ.Имя = "recipe" Тогда
						Если ЗаполнениеТЗ Тогда
							НоваяСтрока = ЭтаФорма.СтрокиРецептур.Добавить();
						Иначе
							МассивСтрокРецептуры = Новый Массив;
							ЭтоСтрокиРецептуры = Истина;
						КонецЕсли;
					ИначеЕсли ФайлХМЛ.Имя = "best_before" или ФайлХМЛ.Имя = "organoleptic" или ФайлХМЛ.Имя = "sale" или ФайлХМЛ.Имя = "serve" Тогда
						Если НЕ ЗаполнениеТЗ Тогда
							ИзАтрибута = Истина;
							НаименованиеКолонки = ФайлХМЛ.Имя;
						Иначе
							ИмяТЗ = ?(ФайлХМЛ.Имя = "best_before", ЭтаФорма.СрокиИУсловияХранения, ?(ФайлХМЛ.Имя = "organoleptic", ЭтаФорма.ОрганолептическиеПоказатели, ?(ФайлХМЛ.Имя = "sale", ЭтаФорма.УсловияРеализации, ЭтаФорма.ПравилаПодачи)));
						КонецЕсли;
					ИначеЕсли ФайлХМЛ.Имя = "nutrition" и ТипДерева = "ГотоваяПродукция" Тогда
						ЭтоХЭХ = Истина;
					ИначеЕсли (ФайлХМЛ.Имя = "proteins" или ФайлХМЛ.Имя = "fat" или ФайлХМЛ.Имя = "carbohydrates" или ФайлХМЛ.Имя = "alcohol" или ФайлХМЛ.Имя = "caloric") и ЭтоХЭХ Тогда
						НаименованиеКолонки = "nutrition_" + ФайлХМЛ.Имя;
					ИначеЕсли ФайлХМЛ.Имя = "item" Тогда
						Если ЭтоСтрокиРецептуры Тогда
							МассивСтрокРецептуры.Добавить(ФайлХМЛ.ПолучитьАтрибут(0));
						ИначеЕсли ИзАтрибута Тогда
							НоваяСтрока[НаименованиеКолонки] = ФайлХМЛ.ПолучитьАтрибут(0);
						ИначеЕсли ЗаполнениеТЗ Тогда
							Если НЕ ИмяТЗ = Неопределено Тогда
								НоваяСтрока = ИмяТЗ.Добавить();
							КонецЕсли;
						КонецЕсли;	
					ИначеЕсли ФайлХМЛ.Имя = "session_id" Тогда
						КоличествоАтрибутов = ФайлХМЛ.КоличествоАтрибутов();
						Для НомАтр = 0 По КоличествоАтрибутов-1 Цикл
							Если  ФайлХМЛ.ЛокальноеИмяАтрибута(НомАтр) = "value" Тогда
								Объект.КлючСессии = ФайлХМЛ.ПолучитьАтрибут(НомАтр);
								НашлиКлючСессии = Истина;
								
								Константы.питФудКостКлючСессии.Установить(Объект.КлючСессии);
								
								СохранитьНастройки();
							КонецЕсли;
						КонецЦикла;
					ИначеЕсли ФайлХМЛ.Имя = "comments" Тогда
						ЭтоКомментарийСайта = Истина;
					Иначе
						НаименованиеКолонки = ФайлХМЛ.Имя;
					КонецЕсли;
				ИначеЕсли ФайлХМЛ.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
					Если ФайлХМЛ.Имя = "recipe" и НЕ ЗаполнениеТЗ Тогда
						НоваяСтрока.recipe = ЗначениеВСтрокуВнутр(МассивСтрокРецептуры);
						ЭтоСтрокиРецептуры = Ложь;
					ИначеЕсли ФайлХМЛ.Имя = "properties" или ФайлХМЛ.Имя = "recipes" Тогда
						ЗаполнениеТЗ = Ложь;
					ИначеЕсли ФайлХМЛ.Имя = "best_before" или ФайлХМЛ.Имя = "organoleptic" или ФайлХМЛ.Имя = "sale" или ФайлХМЛ.Имя = "serve" Тогда
						ИзАтрибута = Ложь;
						ИмяТЗ = Неопределено;
					ИначеЕсли ФайлХМЛ.Имя = "nutrition" и ТипДерева = "ГотоваяПродукция" Тогда
						ЭтоХЭХ = Ложь;
					ИначеЕсли ФайлХМЛ.Имя = "comments" Тогда
						ЭтоКомментарийСайта = Ложь;
					КонецЕсли;
				ИначеЕсли ФайлХМЛ.ТипУзла = ТипУзлаXML.Текст Тогда
					Если ЭтоКомментарийСайта Тогда
						ЭтаФорма.КомментарийСайта = ФайлХМЛ.Значение;
					КонецЕсли;
					Попытка
						НоваяСтрока[НаименованиеКолонки] = ФайлХМЛ.Значение;
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		Конецесли;
	КонецЦикла;
	
	Возврат НашлиКлючСессии;
	
КонецФункции

// Функция - Загрузить на сервере.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ЗагрузитьНаСервере()
	ДИ = РеквизитФормыВЗначение("Объект.ДеревоИнгредиентов");
	ДГП = РеквизитФормыВЗначение("Объект.ДеревоГотовойПродукции");
	СР = ДанныеФормыВЗначение(ЭтаФорма.СтрокиРецептур, Тип("ТаблицаЗначений"));
	
	ЗаполнитьЕдиницыИзмерения(Истина);
	
	УдачноДИ = Загрузить(ДИ, Ложь);
	УдачноДГП = Загрузить(ДГП, Истина);
	
	УдачнаяЗагрузка = УдачноДГП и УдачноДИ; 
	
	ЗначениеВРеквизитФормы(ДИ, "Объект.ДеревоИнгредиентов");
	ЗначениеВРеквизитФормы(ДГП, "Объект.ДеревоГотовойПродукции");
	
	Возврат УдачнаяЗагрузка;
КонецФункции

// Функция - Получить базовую единицу измерения.
//
// Параметры:
//  СтрокаЕИ - Строка - Строка еи.
//  Создавать - Произвольный - Создавать.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолучитьБазовуюЕдиницуИзмерения(СтрокаЕИ, Создавать = Истина)
	
	ЕдИз = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(СтрокаЕИ.Код,,,Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	Если ЕдИз=Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка() И Создавать Тогда
		
		РезультатСоответствиеКодовЕИ = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора(СтрокаЕИ.Код);
		ЕдИз = РезультатСоответствиеКодовЕИ.Получить(СтрокаЕИ.Код);
		
		Если ЕдИз = Неопределено Тогда
			// Придется создать
			ЕдИз = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
			ЕдИз.Код = СтрокаЕИ.Код;
			ЕдИз.Наименование       = СокрЛП(СтрокаЕИ.Наименование);
			ЕдИз.НаименованиеПолное = СокрЛП(СтрокаЕИ.Наименование);
			ЕдИз.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
			ЕдИз.Записать();
			ЕдИз = ЕдИз.Ссылка;
		КонецЕсли;
	КонецЕсли; 
	
	Возврат ЕдИз;

КонецФункции

// ПолучитьБазовуюЕдиницуИзмерения()
//
// Параметры:
//  КоличествоИсх - Произвольный - Количество исх.
//  КоличествоОбработанное - Произвольный - Количество обработанное.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция РассчитатьПроцентПотерьОбработки(КоличествоИсх, КоличествоОбработанное)
	Если КоличествоИсх = 0 Тогда
		Возврат 0;
	Иначе
		Возврат Окр((КоличествоИсх - КоличествоОбработанное) * 100 / КоличествоИсх, 2);
	КонецЕсли;
КонецФункции

// Функция - Создать рецептуру.
//
// Параметры:
//  Стр - Произвольный - Стр.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция СоздатьРецептуру(Стр)
	
	// Для начала поищем основную рецептуру
	ТекРецептура = питПроизводство.ВернутьОсновнуюРецептуру(стр.НоменклатураБазы,, Перечисления.питХозяйственныеОперации.РецептураПриготовление,Объект.ДатаЗагрузкиРецептур,Константы.питСпособРасчетаРецептур.Получить(),, Объект.Организация,,,Объект.Подразделение);
	ЭтоОбновлениеСуществующей = Ложь;
	Если Не ТекРецептура.Пустая() Тогда
		Если РецептурыОбновлятьСуществующие Тогда
			ЭтоОбновлениеСуществующей = Истина;
			
			ДокОбъект = ТекРецептура.получитьОбъект();
			
			ДокОбъект.Ингредиенты.Очистить();
			ДокОбъект.РазрешенныеПодразделения.Очистить();
		Иначе
			Возврат ТекРецептура.Ссылка;
		КонецЕсли;
	Иначе
		Если РецептурыСоздавать Тогда
			ДокОбъект = Документы.питРецептура.СоздатьДокумент();
			ДокОбъект.УстановитьНовыйНомер();
		Иначе
			Возврат Документы.питРецептура.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	// Создаем документ
	 
	ДокОбъект.Дата  = Объект.ДатаЗагрузкиРецептур;
	ДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	ДокОбъект.Организация   = Объект.Организация;
	ДокОбъект.Номенклатура  = стр.НоменклатураБазы;
	
	
	СтрПодразделений					= ДокОбъект.РазрешенныеПодразделения.Добавить();
	ДокОбъект.Подразделение				= Объект.Подразделение;
	СтрПодразделений.Подразделение		= Объект.Подразделение;
	СтрПодразделений.ВключаяПодчиненные	= Объект.ВключаяПодчиненные;
	
	// Ед Изм в шапке рецептуры
	ДокОбъект.Упаковка			    = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОбъект.Номенклатура, "ЕдиницаИзмерения");
	
	ДокОбъект.КоличествоУпаковок	= 1;
	ДокОбъект.Количество			= 1;
	// ДокОбъект.НомерРецептуры        = НомерРецептуры;
	ДокОбъект.Основная              = Истина;
	ДокОбъект.ДатаНачала            = Объект.ДатаЗагрузкиРецептур;
	ДокОбъект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
	ДокОбъект.Выход                 = ?(ЗначениеЗаполнено(стр.out_main), стр.out_main + ?(ЗначениеЗаполнено(стр.out_garnir),"/"+стр.out_garnir,"") + ?(ЗначениеЗаполнено(стр.out_sous),"/"+стр.out_sous,""), стр.out);
	ДокОбъект.ТехнологияПриготовления = УдалитьЛишниеСимволы(стр.technology);
	ДокОбъект.ОбластьПрименения = "Настоящая технико-технологическая карта разработана в соответствие с ГОСТ Р 53105-2008 и распространяется на фирменное блюдо " + стр.name + ", вырабатываемое " + Объект.Организация.НаименованиеПолное;
	ДокОбъект.СтатьяКалькуляции = Константы.питСтатьяКалькуляцииПоУмолчанию.Получить();
	Если ЗначениеЗаполнено(стр.organoleptic) Тогда
		СтрокаПоказателей = ОрганолептическиеПоказатели.НайтиСтроки(Новый Структура("id",стр.organoleptic));
		Если СтрокаПоказателей.Количество() > 0 Тогда
			СтрокаПоказателей = СтрокаПоказателей[0];
			
			ДокОбъект.ВнешнийВид   = УдалитьЛишниеСимволы(СтрокаПоказателей.productview);
			ДокОбъект.Цвет         = УдалитьЛишниеСимволы(СтрокаПоказателей.color);
			ДокОбъект.Консистенция = УдалитьЛишниеСимволы(СтрокаПоказателей.consistency);
			ДокОбъект.ВкусИЗапах   = УдалитьЛишниеСимволы(СтрокаПоказателей.taste);
		КонецЕсли;
	КонецЕсли;
	ДокОбъект.ТребованияКОформлению = УдалитьЛишниеСимволы(стр.requirements);
	Если ЗначениеЗаполнено(стр.sale) Тогда
		СтрокаУсловийРеализации = УсловияРеализации.НайтиСтроки(Новый Структура("id", стр.sale));
		Если СтрокаУсловийРеализации.Количество() > 0 Тогда
			
			ДокОбъект.ТребованияКОформлению = ДокОбъект.ТребованияКОформлению + ?(ДокОбъект.ТребованияКОформлению = "", "", Символы.ПС) + УдалитьЛишниеСимволы(СтрокаУсловийРеализации[0].text);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(стр.serve) Тогда
		СтрокаПравилПодачи = ПравилаПодачи.НайтиСтроки(Новый Структура("id", стр.serve));
		Если СтрокаПравилПодачи.Количество() > 0 Тогда
			СтрокаПравилПодачи = СтрокаПравилПодачи[0];
			ДокОбъект.ТребованияКОформлению = ДокОбъект.ТребованияКОформлению + ?(ДокОбъект.ТребованияКОформлению = "", "", Символы.ПС) 
				+ "Допустимый срок хранения блюда " + стр.name + " до реализации, согласно СанПиН 2.3.6.1079-01, составляет " + СтрокаПравилПодачи.time + " " + СтрокаПравилПодачи.unit + " при температуре хранения " + СтрокаПравилПодачи.temp + ".";
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(стр.best_before) Тогда
		СтрокаУсловийХранения = СрокиИУсловияХранения.НайтиСтроки(Новый Структура("id",стр.best_before));
		Если СтрокаУсловийХранения.Количество() > 0 Тогда
			СтрокаУсловийХранения = СтрокаУсловийХранения[0];
			
			ДокОбъект.ТребованияКОформлению = ДокОбъект.ТребованияКОформлению + ?(ДокОбъект.ТребованияКОформлению = "", "", Символы.ПС) 
				+ "Срок годности блюда " + стр.name + " согласно СанПиН 2.3.2.1324-03 составляет " + СтрокаУсловийХранения.time + " " + СтрокаУсловийХранения.unit + " при температуре хранения " + СтрокаУсловийХранения.temp + ".";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стр.recipe) Тогда
		СписокСтрокРецептуры = ЗначениеИзСтрокиВнутр(стр.recipe);
		Для Каждого СтрокаСписка из СписокСтрокРецептуры Цикл
			
			СтрокаРецептуры = СР.Найти(СтрокаСписка, "fc_id");
			Если не СтрокаРецептуры = Неопределено Тогда
				НоваяСтрока = ДокОбъект.Ингредиенты.Добавить();
				СтрокаИнгредиента = ДИ.Строки.Найти(СтрокаРецептуры.ingredient, "fc_id", Истина);
				Если СтрокаИнгредиента = Неопределено Тогда
					СтрукПоиска = Новый Структура("fc_id,ЭтоИнгредиент" ,СтрокаРецептуры.ingredient, 0 );
					
					МассивСтрокИнгредиента = ДГП.Строки.НайтиСтроки(СтрукПоиска, Истина);
					Если МассивСтрокИнгредиента.Количество() = 0 Тогда
						Сообщение = Новый СообщениеПользователю;
						Сообщение.Текст = "В рецептуре блюда " + ДокОбъект.Номенклатура + " не найден ингредиент с кодом " + СтрокаРецептуры.ingredient;
						Сообщение.Сообщить();
						Продолжить;
					Иначе
						СтрокаИнгредиента = МассивСтрокИнгредиента[0];
					КонецЕсли;
				КонецЕсли;
				Ингредиент = ЗагрузитьПозициюНоменклатуры(СтрокаИнгредиента);
				НоваяСтрока.Номенклатура = Ингредиент;
				// Ингредиенты в строках всегда в граммах
				НоваяСтрока.Упаковка = Грамм;
				
				НоваяСтрока.КоличествоУпаковокБрутто = Число(СтрокаРецептуры.brutto);
				НоваяСтрока.КоличествоУпаковокНетто  = Число(СтрокаРецептуры.netto);
				Если СокрЛП(СтрокаРецептуры.output) = "" Тогда
					НоваяСтрока.КоличествоУпаковокВыход = НоваяСтрока.КоличествоУпаковокНетто;
				КонецЕсли; 
				
				// Расчет базового количества.
				НоваяСтрока.КоличествоБрутто	= НоваяСтрока.КоличествоУпаковокБрутто * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(НоваяСтрока.Номенклатура, НоваяСтрока.Упаковка, КэшированныеЗначения);
				НоваяСтрока.КоличествоНетто	= НоваяСтрока.КоличествоУпаковокНетто * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(НоваяСтрока.Номенклатура, НоваяСтрока.Упаковка, КэшированныеЗначения);
				НоваяСтрока.КоличествоВыход	= НоваяСтрока.КоличествоУпаковокВыход * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(НоваяСтрока.Номенклатура, НоваяСтрока.Упаковка, КэшированныеЗначения);
				
				НоваяСтрока.ПроцентПотерьПриХолоднойОбработке = РассчитатьПроцентПотерьОбработки(НоваяСтрока.КоличествоУпаковокБрутто, НоваяСтрока.КоличествоУпаковокНетто);
				НоваяСтрока.ПроцентПотерьПриГорячейОбработке  = РассчитатьПроцентПотерьОбработки(НоваяСтрока.КоличествоУпаковокНетто, НоваяСтрока.КоличествоУпаковокВыход);
				
				Если НоваяСтрока.КоличествоУпаковокБрутто = 0 Тогда 
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "В рецептуре " + ДокОбъект.Номенклатура + " для ингредиента " + НоваяСтрока.Номенклатура + " не задано количество брутто!";
					Сообщение.Сообщить();
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		ДокОбъект.ОбменДанными.Загрузка = Ложь;
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ОбщегоНазначения.СообщитьПользователю("Ошибка записи рецептуры <" + Строка(ДокОбъект.Наименование) + "> для блюда <" + строка(ДокОбъект.Номенклатура)+"> " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецПопытки; 
	
	Если ЭтоОбновлениеСуществующей Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Обновлена рецептура <" + Строка(ДокОбъект)+ "> для номенклатуры <"+ДокОбъект.Номенклатура+">";
		Сообщение.Сообщить();
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Создана рецептура <" + Строка(ДокОбъект)+ "> для номенклатуры <"+ДокОбъект.Номенклатура+">";
		Сообщение.Сообщить();
	КонецЕсли;
	
	
	Возврат ДокОбъект.Ссылка;
	
КонецФункции

// Функция удаляет лишние переводы строки и преобразует HTML-ные символы в нормальный текст.
//
// Параметры:
//  Стр - Произвольный - Знач стр.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция УдалитьЛишниеСимволы(Знач Стр)
	Перем Рез;
	
	Рез = СтрЗаменить(Стр, Символы.ПС, " ");
	Рез = СтрЗаменить(Рез, "&#8212;", "-");
	Рез = СтрЗаменить(Рез, "&mdash;", "-");
	
	Рез = СтрЗаменить(Рез, "   ", " ");
	Рез = СтрЗаменить(Рез, "  ", " ");
	
	Возврат Рез;
	
КонецФункции
 


// Функция - Загрузить позицию номенклатуры.
// Параметры:
//  Стр - Произвольный - Стр.
//  ЭтоБлюдо - Произвольный - Это блюдо.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ЗагрузитьПозициюНоменклатуры(Стр, ЭтоБлюдо = Ложь)
	
	Если стр=Неопределено Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	
	
	ПризнакГруппы = стр.ПризнакГруппы;
	Уровень       = стр.Уровень();
	
	// Создаем
	Если ПризнакГруппы Тогда
		
		Если стр.НоменклатураБазы<>Справочники.Номенклатура.ПустаяСсылка() Тогда
			Если СпособЦелевойГруппы = 2 Тогда
				Если стр.НоменклатураБазы.ПринадлежитЭлементу(ГруппаПоУмолчанию) Тогда
					Возврат стр.НоменклатураБазы;
				КонецЕсли;
			Иначе
				Возврат стр.НоменклатураБазы;
			КонецЕсли;
		КонецЕсли;
		
		// Теперь поищем по наименованию
		Родитель = ЗагрузитьПозициюНоменклатуры(стр.Родитель, ЭтоБлюдо);
		
		// Если родитель вернулся пустой, то проверим в настройке не надо ли складывать все в одну папку.
		Если НЕ ЗначениеЗаполнено(Родитель) И СпособЦелевойГруппы = 2 Тогда
			Родитель = ГруппаПоУмолчанию;
		КонецЕсли;
		
		СоздатьЗапросПоНаименованиюНаСервере(Истина);
		ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("ЦелеваяГруппа", ГруппаПоУмолчанию);
		ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("Наименование", стр.name);
		ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("ЭтоГруппа"   , Истина);
		Выборка = ЗапросПоискПоНаименованиюТочно.Выполнить().Выбрать();
		
		
		
		
		Если Выборка.Следующий() Тогда
			
			стр.НоменклатураБазы = Выборка.Ссылка1С;
			Возврат стр.НоменклатураБазы;
			
		КонецЕсли;
		
		Группа = Справочники.Номенклатура.СоздатьГруппу();
		Группа.УстановитьНовыйКод();			
		Группа.Наименование = Стр.name;
		Группа.Родитель     = Родитель;
		Группа.Записать();
		ЭтаФорма.СостояниеЗагрузки = "Загрузка номенклатуры: " + стр.name; 
		
		стр.НоменклатураБазы = Группа.Ссылка;			
		Возврат стр.НоменклатураБазы;			
	Иначе
		Если стр.НоменклатураБазы = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Если СпособЦелевойГруппы = 0 Тогда
				Родитель = ГруппаПоУмолчанию;
			Иначе
				Родитель = ЗагрузитьПозициюНоменклатуры(стр.Родитель);
			КонецЕсли;
			
			// Создаем элемент
			Элемент = Справочники.Номенклатура.СоздатьЭлемент();
			Элемент.УстановитьНовыйКод();
			
			
			
			Попытка // только для дерева номенклатур
				Если ЗначениеЗаполнено(Стр.Постфикс) и Стр.Постфикс > 0 Тогда
					ПостфиксДляОдинаковыхИмен = " " + Стр.Постфикс;
				Иначе
					ПостфиксДляОдинаковыхИмен = "";
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			Элемент.Наименование       = Стр.name + ПостфиксДляОдинаковыхИмен;
			Элемент.НаименованиеПолное = Стр.name + ПостфиксДляОдинаковыхИмен;
			
			Элемент.Родитель    = Родитель;
			
			// ВИД НОМЕНКЛАТУРЫ
			Элемент.питВидНоменклатуры = стр.ВидНоменклатуры;
			Если стр.ВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар Тогда
				Элемент.ВидНоменклатуры = Объект.НоменклатурнаяГруппаИнгредиенты;
			Иначе
				Элемент.ВидНоменклатуры = Объект.НоменклатурнаяГруппаГотоваяПродукция;
			КонецЕсли;
			Если ЗначениеЗаполнено(Элемент.ВидНоменклатуры) Тогда
				Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Элемент);
			КонецЕсли;
			
			// СТАВКА НДС
			// не указана, поэтому устанавливаем 18% или 20%
			ТекущаяДата = ТекущаяДатаСеанса();
			Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
				Если ТекущаяДата >= '20190101' Тогда
					ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС20);
				ИначеЕсли ТекущаяДата >= '20260101' Тогда
					ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС22);
				КонецЕсли;
			Иначе
				Если ТекущаяДата >= '20190101' Тогда
					ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(20);
				ИначеЕсли ТекущаяДата >= '20260101' Тогда
					ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(22);
				КонецЕсли;
			КонецЕсли;
			Элемент.СтавкаНДС = ТекСтавкаНДС;
			
			// ЕДИНИЦЫ ИЗМЕРЕНИЯ
			// БАЗОВАЯ ЕДИНИЦА ИЗМЕРЕНИЯ  
			
			ЕдиницаХранения = ПолучитьБазовуюЕдиницуИзмерения(ЕдиницыИзмерения.Найти(стр.storage_unit, "Код"));
			Элемент.ЕдиницаИзмерения = ЕдиницаХранения;
			Элемент.ЕдиницаДляОтчетов = ЕдиницаХранения;
			// Базовая единица для фуд коста всегда грамм, вес порции указан в граммах
			Попытка
				Если Число(стр.weight_units) <> 0 Тогда
					Элемент.ВесИспользовать = Истина;
					Элемент.ВесЗнаменатель = 1;
					Элемент.ВесЧислитель = Число(стр.weight_units);
					Элемент.ВесЕдиницаИзмерения = Грамм;
				КонецЕсли;
			Исключение
				Если Элемент.ЕдиницаИзмерения = Килограмм Тогда
					Элемент.ВесИспользовать = Истина;
					Элемент.ВесЗнаменатель = 1;
					Элемент.ВесЧислитель = 1000;
					Элемент.ВесЕдиницаИзмерения = Грамм;
				ИначеЕсли Элемент.ЕдиницаИзмерения = Литр Тогда 
					Элемент.ОбъемИспользовать = Истина;
				КонецЕсли;
			КонецПопытки;
			
			// ...РЕЦЕПРУРНАЯ И ХЭХ ЕДИНИЦА
			Элемент.питРецептурнаяУпаковка = ЕдиницаХранения;
			Элемент.питЕдиницаИзмеренияДляХЭХ = Грамм;
			Элемент.питКоличествоНоменклатуры = 100;
			
			Элемент.Качество = Перечисления.ГрадацииКачества.Новый;
			
			Элемент.Записать();
			Элемент = Элемент.Ссылка;
			
			стр.НоменклатураБазы = Элемент.Ссылка;
			УстановитьСоответствиеВРегистреНаСервере(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура, стр.fc_id, стр.НоменклатураБазы);
			// Запишем новый ингредиент везде где он встречается
			ИзменитьВсеИнгредиентыВДеревьях(Стр.fc_id, Стр.НоменклатураБазы, Ложь);
			
			// теперь рецептуры, если нужно
			Если Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
				ТекРецептура = СоздатьРецептуру(стр);	
			Иначе
				ТекРецептура = Документы.питРецептура.ПустаяСсылка();
			КонецЕсли;
			
			ОбновитьСоздатьХЭХ(Элемент, Стр);
			
		Иначе //стр.НоменклатураБазы=Справочники.Номенклатура.ПустаяСсылка()
			Попытка
				
				Если ОбновлятьСуществующиеХЭХи Тогда
					ОбновитьСоздатьХЭХ(стр.НоменклатураБазы, Стр);
				КонецЕсли;
				
				Если Стр.ЭтоИнгредиент <> 1 Тогда
					Если  стр.НоменклатураБазы.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
						ТекРецептура = СоздатьРецептуру(стр);
					КонецЕсли;
				КонецЕсли;
				
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Возврат стр.НоменклатураБазы;
		
	КонецЕсли;
	
КонецФункции // ЗагрузитьПозициюНоменклатуры()

// Функция - Загрузить.
//
// Параметры:
//  Дерево - ДеревоЗначений - Дерево.
//  ЭтоДеревоБлюд - ДеревоЗначений - Это дерево блюд.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция Загрузить(Дерево, ЭтоДеревоБлюд = ложь)
	// ФайлЛога = Новый ТекстовыйДокумент;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ПризнакГруппы", Ложь);
	СтруктураОтбора.Вставить("Отметка", 1);
	
	Если ЭтоДеревоБлюд Тогда
		СтруктураОтбора.Вставить("ЭтоИнгредиент", 0);
	КонецЕсли;
	
	МассивСтрок = Дерево.Строки.НайтиСтроки(СтруктураОтбора, Истина);
	Если НЕ МассивСтрок.Количество()=0 Тогда
		Для НомерСтроки = 0 По МассивСтрок.Количество() - 1 Цикл 
			стр = МассивСтрок[НомерСтроки];
			Если стр.Отметка=1 или стр.Отметка=2 Тогда
				стр.НоменклатураБазы = ЗагрузитьПозициюНоменклатуры(стр, ЭтоДеревоБлюд);
				// ФайлЛога.ДобавитьСтроку(Стр.name + "  " + Стр.ВидНоменклатуры);
				// ФайлЛога.Записать("d:\log.txt");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
КонецФункции


// Получает соотвтствие установленное ранее
//
// Параметры:
//  ТипОбъекта - Произвольный - Тип объекта.
//  КодФудКост - Произвольный - Код фуд кост.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
&НаСервере
Функция ПолучитьСоответствиеИзРегистра(ТипОбъекта, КодФудКост)
	Рез = Неопределено;
	
	ЗапросГотовогоСоответствия.УстановитьПараметр("ТипОбъекта",ТипОбъекта);
	ЗапросГотовогоСоответствия.УстановитьПараметр("СсылкаFoodCOST",СокрЛП(КодФудКост) );
	
	Выборка = ЗапросГотовогоСоответствия.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Рез = Выборка.Ссылка1С;
	КонецЕсли;
	
	Возврат рез;
	
КонецФункции

// Устанавливает в регистре соответствия между объектом Фудкоста и существующим объектом базы данных.
//
// Параметры:
//  ТипОбъекта - Произвольный - Тип объекта.
//  КодФудКост - Произвольный - Код фуд кост.
//  СсылкаНаОбъект1С - Произвольный - Ссылка на объект 1 с.
//
&НаСервере
Процедура УстановитьСоответствиеВРегистреНаСервере(ТипОбъекта, КодФудКост, СсылкаНаОбъект1С) 
	
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовFoodCOST.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТипОбъекта.Установить(ТипОбъекта);
	НаборЗаписей.Отбор.СсылкаFoodCOST.Установить(КодФудКост);
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект1С) Тогда
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Ссылка1С = СсылкаНаОбъект1С;
		
		НоваяЗапись.ТипОбъекта = ТипОбъекта;
		НоваяЗапись.СсылкаFoodCOST = КодФудКост;
	
	КонецЕсли;
	
	НаборЗаписей.Записать(); 
	
	
КонецПроцедуры




// Ищет полное соответствие наименования для данной строки.
//  Работает для обоих деревьев на форме
//  Строка - Строка одного из деревьев
//
// Параметры:
//  Строка - Строка - Строка.
//
&НаСервере
Процедура УстановитьНоменнклатуруБазыПоПолномуСоответствиюНаименования(Строка)
	
	Если (СпособЦелевойГруппы = 0) и Строка.ПризнакГруппы Тогда Возврат КонецЕсли; // Для групп не надо искать соответствия.
	Если ЗначениеЗаполнено(Строка.НоменклатураБазы)       Тогда Возврат КонецЕсли; // Уже заполнено, ничего не делаем.
	
	
	ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("Наименование", Строка.name);
	ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("ЭтоГруппа", Строка.ПризнакГруппы);
	
	Результат = ЗапросПоискПоНаименованиюТочно.Выполнить();
	
	Выборка = Результат.Выбрать();
	Если выборка.Следующий() Тогда
		строка.НоменклатураБазы = Выборка.Ссылка1С;
		УстановитьСоответствиеВРегистреНаСервере(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура,
									Строка.fc_id,
									Строка.НоменклатураБазы);
		
	КонецЕсли;
	
КонецПроцедуры

// Ищет точное соответствие кода фудкоста и артикула номенклатуры.
//
// Параметры:
//  Строка - Строка - Строка.
//
&НаСервере
Процедура УстановитьНоменнклатуруБазыПоАртикулу(Строка)
	
	Если (СпособЦелевойГруппы = 0) и Строка.ПризнакГруппы Тогда Возврат КонецЕсли; // Для групп не надо искать соответствия.
	Если ЗначениеЗаполнено(Строка.НоменклатураБазы)        Тогда Возврат КонецЕсли; // Уже заполнено, ничего не делаем.
	
	
	ЗапросПоискПоАртикулу.УстановитьПараметр("КодФудкост", Строка.fc_id);
	ЗапросПоискПоАртикулу.УстановитьПараметр("ЭтоГруппа", Строка.ПризнакГруппы);
	
	Результат = ЗапросПоискПоАртикулу.Выполнить();
	
	Выборка = Результат.Выбрать();
	Если выборка.Следующий() Тогда
		строка.НоменклатураБазы = Выборка.Ссылка1С;
		УстановитьСоответствиеВРегистреНаСервере(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура,
									Строка.fc_id,
									Строка.НоменклатураБазы);
	КонецЕсли;
	
КонецПроцедуры

// Ищет полное соответствмие для данной строки и всех подчиненных строк по наименованию.
//
// Параметры:
//  Строка - Строка - Строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьПодстрокиПоПолномуСоответствиюНаименования(Строка)
	
	Для Каждого Стр из Строка.Строки Цикл
		УстановитьНоменнклатуруБазыПоПолномуСоответствиюНаименования(Стр);
		ЗаполнитьПодстрокиПоПолномуСоответствиюНаименования(Стр);
	КонецЦикла;
	
КонецФункции

// Ищет полное соответствмие для данной строки и всех подчиненных строк по артикулу и фудкост коду.
//
// Параметры:
//  Строка - Строка - Строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьПодстрокиПоАртикулу(Строка)
	
	Для Каждого Стр из Строка.Строки Цикл
		УстановитьНоменнклатуруБазыПоАртикулу(Стр);
		ЗаполнитьПодстрокиПоАртикулу(Стр);
	КонецЦикла;
	
КонецФункции

// Процедура - Создать запрос готового соответствия на сервере.
//
&НаСервере
Процедура СоздатьЗапросГотовогоСоответствияНаСервере()
	
	ЗапросГотовогоСоответствия = Новый Запрос;
	ЗапросГотовогоСоответствия.Текст = "ВЫБРАТЬ СоответствияОбъектовFoodCOST.Ссылка1С
	|ИЗ
	|	РегистрСведений.питСоответствияОбъектовFoodCOST КАК СоответствияОбъектовFoodCOST
	|ГДЕ
	|	СоответствияОбъектовFoodCOST.ТипОбъекта = &ТипОбъекта
	|	И
	|	СоответствияОбъектовFoodCOST.СсылкаFoodCOST = &СсылкаFoodCOST";
	
	
	
КонецПроцедуры

// Процедура - Создать запрос по наименованию на сервере.
//
// Параметры:
//  ГруппаВИерархииЦелевой - Произвольный - Группа в иерархии целевой.
//
&НаСервере
Процедура СоздатьЗапросПоНаименованиюНаСервере(ГруппаВИерархииЦелевой = Ложь)
	
	
	ЗапросПоискПоНаименованиюТочно = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка1С
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование
	|	И Номенклатура.ЭтоГруппа = &ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";
	
	Если ГруппаВИерархииЦелевой И СпособЦелевойГруппы = 2 Тогда
		// Надо не просто найти совпадение, нои совпадение которое находится в нужной группе
		ТекстЗапроса = ТекстЗапроса + " И Номенклатура.Ссылка В ИЕРАРХИИ(&ЦелеваяГруппа) ";
	КонецЕсли;
	
	ЗапросПоискПоНаименованиюТочно.Текст = ТекстЗапроса;
	
КонецПроцедуры

// Процедура - Создать запрос по артикулу.
//
Процедура СоздатьЗапросПоАртикулу()
	
	ЗапросПоискПоАртикулу = Новый запрос;
	
	ЗапросПоискПоАртикулу.Текст = "ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка1С
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &КодФудкост
	|	И Номенклатура.ЭтоГруппа = &ЭтоГруппа";
	
КонецПроцедуры


// Устанавливает во всех ингредиентах с ИД, номенклатуру установленную руками.
//  Один ингредиент может встречатся в разных местах дерева блюд.
//  Изменив в одном месте надо обновить во всех других и в дереве ингредиентов.
//
// Параметры:
//  ИД - Произвольный - Ид.
//  Номенклатура - Произвольный - Номенклатура.
//  НеИспГлобДеревья - Произвольный - Не исп глоб деревья.
//
&НаСервере
Процедура ИзменитьВсеИнгредиентыВДеревьях(ИД, Номенклатура, НеИспГлобДеревья = Истина)
	
	
	Если НеИспГлобДеревья Тогда
		ДГП = ДанныеФормыВЗначение(Объект.ДеревоГотовойПродукции, тип("ДеревоЗначений"));
		ДИ = ДанныеФормыВЗначение(Объект.ДеревоИнгредиентов, тип("ДеревоЗначений"));
	КонецЕсли;
	
	
	МассивСтрок = ДГП.Строки.НайтиСтроки(Новый Структура("fc_id",ИД ), Истина);
	Для Каждого Стр из МассивСтрок Цикл
		Стр.НоменклатураБазы = Номенклатура;
	КонецЦикла;
	
	Если НеИспГлобДеревья Тогда
		ЗначениеВДанныеФормы(ДГП, Объект.ДеревоГотовойПродукции);
	КонецЕсли;
	
	
	МассивСтрок = ДИ.Строки.НайтиСтроки(Новый Структура("fc_id",ИД ), Истина);
	Для Каждого Стр из МассивСтрок Цикл
		Стр.НоменклатураБазы = Номенклатура;
	КонецЦикла;
	Если НеИспГлобДеревья Тогда
		ЗначениеВДанныеФормы(ДИ, Объект.ДеревоИнгредиентов);
	КонецЕсли;
	
КонецПроцедуры


// Процедура - Проставить по частичному совпадению наименований на сервере.
//
&НаСервере
Процедура ПроставитьПоЧастичномуСовпадениюНаименованийНаСервере()
	
	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Запретить Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Поиск соответствия по частичному наименованию невозможен, так как использование полнотекстового поиска отключено.");
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("ПризнакГруппы", Ложь);
	
	// Сначала обрабатываем строки с элементами
	
	ТаблСоответствий = новый ТаблицаЗначений; // Для вывода сообщения результаты нечеткого поиска 
												// пользователю надо тщательно проверить вручную.
	ТаблСоответствий.Колонки.Добавить("ИмяФК");
	ТаблСоответствий.Колонки.Добавить("КодФК");
	ТаблСоответствий.Колонки.Добавить("ИмяБазе");
	ТаблСоответствий.Колонки.Добавить("КодБазе");
	
	СоздатьЗапросПоНаименованиюНаСервере();
	
	ДГП = ДанныеФормыВЗначение(Объект.ДеревоГотовойПродукции, тип("ДеревоЗначений"));
	ДИ = ДанныеФормыВЗначение(Объект.ДеревоИнгредиентов, тип("ДеревоЗначений"));
	
	МассивСтрок = ДГП.Строки.НайтиСтроки(СтруктураПоиска, Истина);
	
	Для Каждого Стр из МассивСтрок Цикл
		Если (СпособЦелевойГруппы = 0) и Стр.ПризнакГруппы Тогда Продолжить КонецЕсли; // Для групп не надо искать соответствия.
		Если ЗначениеЗаполнено(Стр.НоменклатураБазы) Тогда 
			Продолжить;
		КонецЕсли;
		
		НечеткоеНаименование = Обработки.питЗагрузкаССайтаFoodCost.ВыполнитьНечеткийПоиск(Стр.name, Метаданные.Справочники.Номенклатура , ФудКостПроцентСхожести);
		
		Если НечеткоеНаименование <> "" Тогда
			
			ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("Наименование", НечеткоеНаименование);
			ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("ЭтоГруппа", Ложь);
			
			Результат = ЗапросПоискПоНаименованиюТочно.Выполнить();
			
			Выборка = Результат.Выбрать();
			Если выборка.Следующий() Тогда
				Стр.НоменклатураБазы = Выборка.Ссылка1С;
				УстановитьСоответствиеВРегистреНаСервере(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура,
										Стр.fc_id,
										Стр.НоменклатураБазы);
										
				///***---Если Стр.ЭтоИнгредиент = 1 Тогда
				ИзменитьВсеИнгредиентыВДеревьях(Стр.fc_id, Стр.НоменклатураБазы, Ложь);
				///***---КонецЕсли;
				
				НовСтрока = ТаблСоответствий.Добавить();// Для вывода сообщения
				НовСтрока.ИмяФК = Стр.name;
				НовСтрока.КодФК = Стр.fc_id;
				НовСтрока.ИмяБазе = Стр.НоменклатураБазы;
				НовСтрока.КодБазе = Стр.НоменклатураБазы.Код;
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	МассивСтрок = ДИ.Строки.НайтиСтроки(СтруктураПоиска, Истина);
	Для Каждого Стр из МассивСтрок Цикл
		Если (СпособЦелевойГруппы <> 1) и Стр.ПризнакГруппы Тогда 
			Продолжить;
		КонецЕсли; // Для групп не надо искать соответствия.
		Если ЗначениеЗаполнено(Стр.НоменклатураБазы) Тогда 
			Продолжить;
		КонецЕсли;
		
		НечеткоеНаименование = Обработки.питЗагрузкаССайтаFoodCost.ВыполнитьНечеткийПоиск(Стр.name, Метаданные.Справочники.Номенклатура , ФудКостПроцентСхожести);
		
		Если НечеткоеНаименование <> "" Тогда
			
			ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("Наименование", НечеткоеНаименование);
			ЗапросПоискПоНаименованиюТочно.УстановитьПараметр("ЭтоГруппа", Ложь);
			
			Результат = ЗапросПоискПоНаименованиюТочно.Выполнить();
			
			Выборка = Результат.Выбрать();
			Если выборка.Следующий() Тогда
				Стр.НоменклатураБазы = Выборка.Ссылка1С;
				УстановитьСоответствиеВРегистреНаСервере(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура,
										Стр.fc_id,
										Стр.НоменклатураБазы);
										
				ИзменитьВсеИнгредиентыВДеревьях(Стр.fc_id, Стр.НоменклатураБазы, Ложь);
				 
				НовСтрока = ТаблСоответствий.Добавить();
				НовСтрока.ИмяФК = Стр.name;
				НовСтрока.КодФК = Стр.fc_id;
				НовСтрока.ИмяБазе = Стр.НоменклатураБазы;
				НовСтрока.КодБазе = Стр.НоменклатураБазы.Код;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	///***---
	ТаблСоответствий.Свернуть("ИмяФК,КодФК,ИмяБазе,КодБазе");
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Соответствия по не полному соответствию наименования при проценте схожести:" + ФудКостПроцентСхожести;
	Сообщение.Сообщить();
	Для Каждого Стр из ТаблСоответствий Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Стр.ИмяФК+"/"+Стр.КодФК+"  -  "+Стр.ИмяБазе+"/"+Стр.КодБазе;
		Сообщение.Сообщить();
	КонецЦикла;
	
	ЗначениеВДанныеФормы(ДГП, объект.ДеревоГотовойПродукции);
	ЗначениеВДанныеФормы(ДИ, объект.ДеревоИнгредиентов);
	
	
КонецПроцедуры

// Функция - Полнотекстовый поиск индекс актуален.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолнотекстовыйПоискИндексАктуален()
	Попытка
		Возврат ПолнотекстовыйПоиск.ИндексАктуален()
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Процедура - Полнотекстовый поиск обновить индекс.
//
&НаСервере
Процедура ПолнотекстовыйПоискОбновитьИндекс()
	Попытка
		ПолнотекстовыйПоиск.ОбновитьИндекс();
	Исключение
		ЗаписьЖурналаРегистрации("Загрузка с сайта FoodCOST", УровеньЖурналаРегистрации.Предупреждение,,,"Попытка обновить индекс полнотекстового поиска при том что он отключен");
	КонецПопытки;
КонецПроцедуры

// Процедура - Совпадение по частичному совпадению наименований фрагмент.
//
&НаКлиенте
Процедура СовпадениеПоЧастичномуСовпадениюНаименованийФрагмент()
	
	Перем МассивРаскрытыхБлюд, МассивРаскрытыхИнгредиентов, НадоТекущееБлюдо, НадоТекущийИнгредиент, струкЗапомнимТекущийБлюдо, струкЗапомнимТекущийИнгредиент, ТекСтр, ТекСтрокаДГП, ТекСтрокаДИ;
	
	// Запоминаем состояние
	МассивРаскрытыхБлюд = новый Массив;
	ЗаполнитьМассивРаскрытыхБлюд(МассивРаскрытыхБлюд, объект.ДеревоГотовойПродукции);
	ТекСтрокаДГП = Элементы.ДеревоГотовойПродукции.ТекущиеДанные;
	НадоТекущееБлюдо = (ТекСтрокаДГП <> неопределено И ТекСтрокаДГП.ПолучитьРодителя() <> Неопределено);
	Если НадоТекущееБлюдо Тогда
		струкЗапомнимТекущийБлюдо = Новый Структура("parent_id,fc_id",ТекСтрокаДГП.ПолучитьРодителя().fc_id,ТекСтрокаДГП.fc_id );
	КонецЕсли;
	
	МассивРаскрытыхИнгредиентов = новый Массив;
	ЗаполнитьМассивРаскрытыхИнгредиентов(МассивРаскрытыхИнгредиентов, объект.ДеревоИнгредиентов);
	ТекСтрокаДИ = Элементы.ДеревоИнгредиентов.ТекущиеДанные;
	НадоТекущийИнгредиент = (ТекСтрокаДИ <> неопределено И ТекСтрокаДИ.ПолучитьРодителя() <> Неопределено);
	Если НадоТекущийИнгредиент Тогда
		струкЗапомнимТекущийИнгредиент = Новый Структура("parent_id,fc_id",ТекСтрокаДИ.ПолучитьРодителя().fc_id,ТекСтрокаДИ.fc_id );
	КонецЕсли;
	
	
	ПроставитьПоЧастичномуСовпадениюНаименованийНаСервере();
	
	
	// Восстанавливаем состояние
	ВосстановитьРаскрытостьпоМассиву(МассивРаскрытыхБлюд, Объект.ДеревоГотовойПродукции, Элементы.ДеревоГотовойПродукции);
	Если НадоТекущееБлюдо Тогда
		ТекСтр = ПолучитьИдентификаторПоЗначению(Объект.ДеревоГотовойПродукции, струкЗапомнимТекущийБлюдо);
		Элементы.ДеревоГотовойПродукции.ТекущаяСтрока = ТекСтр;
	КонецЕсли;
	
	ВосстановитьРаскрытостьпоМассиву(МассивРаскрытыхИнгредиентов, Объект.ДеревоИнгредиентов, Элементы.ДеревоИнгредиентов);
	Если НадоТекущийИнгредиент Тогда
		ТекСтр = ПолучитьИдентификаторПоЗначению(Объект.ДеревоИнгредиентов, струкЗапомнимТекущийИнгредиент);
		Элементы.ДеревоИнгредиентов.ТекущаяСтрока = ТекСтр;
	КонецЕсли;
	
КонецПроцедуры


// Функция - Дерево ингредиентов ссылка при изменении на сервере.
//
// Параметры:
//  ТекСтрокаНоменклатураБазы - Строка - Тек строка номенклатура базы.
//  ТекСтрокаПризнакГруппы - Строка - Тек строка признак группы.
//  ТекСтрокаfc_id - Строка - Тек строкаfc id.
//
// Возвращаемое значение:
//  ДеревоЗначений - Результат обработки.
&НаСервере
Функция ДеревоИнгредиентовСсылкаПриИзмененииНаСервере(ТекСтрокаНоменклатураБазы,ТекСтрокаПризнакГруппы,ТекСтрокаfc_id)
	Перем Рез;
	Рез = "";
	
	ЗаполнитьЕдиницыИзмерения(Ложь);
	
	Если ТекСтрокаНоменклатураБазы.Этогруппа <> ТекСтрокаПризнакГруппы Тогда
		Если ТекСтрокаПризнакГруппы Тогда
			Рез = "Элемент не может соотсетствовать группе.Надо выбрать группу.";
		Иначе 
			Рез = "Группа не может соответствовать элементу. Надо выбрать элемент, а не группу.";
		КонецЕсли;
		ТекСтрокаНоменклатураБазы = Справочники.Номенклатура.ПустаяСсылка();
		Возврат Рез;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекСтрокаНоменклатураБазы) Тогда
		МассивЕдИзм = ПолучитьСписокЕдиницИзмерения(ТекСтрокаНоменклатураБазы);
		Если МассивЕдИзм.найти(Грамм) = Неопределено Тогда
			Рез = "Для загрузки у ингредиента должна быть единица измерения Грамм";
			Возврат РЕЗ;
		КонецЕсли; 
	КонецЕсли;
	УстановитьСоответствиеВРегистреНаСервере(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура,
									ТекСтрокаfc_id,
									ТекСтрокаНоменклатураБазы);
	ИзменитьВсеИнгредиентыВДеревьях(ТекСтрокаfc_id,ТекСтрокаНоменклатураБазы);
	
	Возврат Рез;
КонецФункции 


// Процедура - Вопрос о создании гр или кг фрагмент.
//
// Параметры:
//  Знач МассивРаскрытых - Массив - Знач массив раскрытых.
//  Знач Рез - Произвольный - Знач рез.
//  Знач струкЗапомнимТекущий - Произвольный - Знач струк запомним текущий.
//  Знач ТекСтрока - Строка - Знач тек строка.
//
&НаКлиенте
Процедура ВопросОСозданииГрИлиКГ_Фрагмент(Знач МассивРаскрытых, Знач Рез, Знач струкЗапомнимТекущий, Знач ТекСтрока)
	
	Перем ТекСтр;
	
	Если НЕ Рез.Успех Тогда
		ТекСтрока.НоменклатураБазы = Рез.НоменклатураБазы;
		ПоказатьПредупреждение(,Рез.СообщениеОбОшибке,60);
	КонецЕсли;
	
	ТекСтр = ПолучитьИдентификаторПоЗначению(Объект.ДеревоГотовойПродукции, струкЗапомнимТекущий);
	Элементы.ДеревоГотовойПродукции.ТекущаяСтрока = ТекСтр;
	
	УстановкаСоответствияНаСервере(ТекСтрока.fc_id, ТекСтрока.НоменклатураБазы);
	
	ВосстановитьРаскрытостьпоМассиву(МассивРаскрытых, Объект.ДеревоГотовойПродукции, Элементы.ДеревоГотовойПродукции);
	
КонецПроцедуры
// Установка соответствия на сервере
//
// Параметры:
//  ТекСтрока_fc_id				 - Строка	 - Тек строка fc id.
//  ТекСтрока_НоменклатураБазы	 - Строка	 - Тек строка номенклатура базы.
//
&НаСервере
Процедура УстановкаСоответствияНаСервере(ТекСтрока_fc_id, ТекСтрока_НоменклатураБазы)
	
	УстановитьСоответствиеВРегистреНаСервере(ПланыВидовХарактеристик.питТипыОбъектовФудКост.Номенклатура,
	ТекСтрока_fc_id,
	ТекСтрока_НоменклатураБазы);
	ИзменитьВсеИнгредиентыВДеревьях(ТекСтрока_fc_id,ТекСтрока_НоменклатураБазы);
	
	
КонецПроцедуры // УстановкаСоответствияНаСервере()

// Если все впорядке возвращает пустую строку, если нет , текст ошибки.
//
// Параметры:
//  ТекСтрока_fc_id - Строка - Тек строка fc id.
//  ТекСтрока_НоменклатураБазы - Строка - Тек строка номенклатура базы.
//  ТекСтрока_ПризнакГруппы - Строка - Тек строка признак группы.
//  ТекСтрока_ВидНоменклатуры - Строка - Тек строка вид номенклатуры.
//  ТекСтрока_ЭтоИнгредиент - Строка - Тек строка это ингредиент.
//  ТолькоПроверить - Произвольный - Только проверить.
//
// Возвращаемое значение:
//  ДеревоЗначений - Результат обработки.
&НаСервере
Функция ДеревоГотовойПродукцииСсылкаПриИзмененииНаСервереПроверки(ТекСтрока_fc_id ,ТекСтрока_НоменклатураБазы,ТекСтрока_ПризнакГруппы,ТекСтрока_ВидНоменклатуры,ТекСтрока_ЭтоИнгредиент, ТолькоПроверить = Ложь)
	Перем Рез;
	
	ЗаполнитьЕдиницыИзмерения(Ложь);
	
	Рез = Новый Структура("Успех,НоменклатураБазы,СообщениеОбОшибке, СообщениеВопрос,ЗадатьВопрос, ЧтоДобавляем",Ложь,Справочники.Номенклатура.ПустаяСсылка(),"","",Ложь );
	
	Если ТекСтрока_НоменклатураБазы.Этогруппа <> ТекСтрока_ПризнакГруппы Тогда
		
		Если ТекСтрока_ПризнакГруппы Тогда
			Рез.СообщениеОбОшибке = "Элемент не может соответствовать группе.Надо выбрать группу.";
		Иначе 
			Рез.СообщениеОбОшибке = "Группа не может соответствовать элементу. Надо выбрать элемент, а не группу.";
		КонецЕсли;
		
		Возврат РЕЗ;
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(ТекСтрока_НоменклатураБазы) Тогда
		МассивЕдИзм = ПолучитьСписокЕдиницИзмерения(ТекСтрока_НоменклатураБазы);
		ТекКилограмм = МассивЕдИзм.найти(Килограмм);
		ТекГрамм     = МассивЕдИзм.найти(Грамм);
		
		Если ТекСтрока_ВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо
			И (ТекГрамм = Неопределено ИЛИ ТекКилограмм = Неопределено) Тогда
			Рез.СообщениеОбОшибке = "Для загрузки у блюда должна быть единица измерения килограмм и грамм";
			Возврат РЕЗ;
		КонецЕсли;
		
		Если ТекСтрока_ЭтоИнгредиент
			И (ТекГрамм = Неопределено ИЛИ ТекКилограмм = Неопределено) Тогда
			Рез.СообщениеОбОшибке = "Для загрузки у ингредиента должна быть единица измерения Грамм";
			Возврат РЕЗ;
		КонецЕсли;
	КонецЕсли;
	
	Рез.Успех = Истина;
	
	Возврат РЕЗ;
	
КонецФункции

// Функция - Группа по умолчанию это группа.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ГруппаПоУмолчаниюЭтоГруппа()
	Возврат ГруппаПоУмолчанию.ЭтоГруппа;
КонецФункции

// Процедура - Очистить соответствия в дереве.
//
// Параметры:
//  Дерево - ДеревоЗначений - Дерево.
//
&НаСервере
Процедура ОчиститьСоответствияВДереве(Дерево)
	
	Строки = Дерево.получитьЭлементы();
	Для Каждого Стр из Строки Цикл
		Стр.НоменклатураБазы = Справочники.Номенклатура.ПустаяСсылка();
		ОчиститьСоответствияВДереве(Стр);
	КонецЦикла;
	
КонецПроцедуры
 

// Процедура - Команда очистить соответствия на сервере.
//
&НаСервере
Процедура КомандаОчиститьСоответствияНаСервере()
	
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовFoodCOST.СоздатьНаборЗаписей();
	НаборЗаписей.Записать();
	ОчиститьСоответствияВДереве(Объект.ДеревоГотовойПродукции);
	ОчиститьСоответствияВДереве(Объект.ДеревоИнгредиентов);
	
КонецПроцедуры

// Функция - Номенклатурная группа использовать характеристики на сервере.
//
// Параметры:
//  НоменклатурнаяГруппа - Произвольный - Номенклатурная группа.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервереБезКонтекста
Функция НоменклатурнаяГруппаИспользоватьХарактеристикиНаСервере(НоменклатурнаяГруппа)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатурнаяГруппа,"ИспользоватьХарактеристики");
КонецФункции

// Процедура - Заполнить единицы измерения.
//
// Параметры:
//  Создавать - Произвольный - Создавать.
//
&НаСервере
Процедура ЗаполнитьЕдиницыИзмерения(Создавать)
	
	// ОКЕИ
	ЕдиницыИзмерения = Новый ТаблицаЗначений;
	ЕдиницыИзмерения.Колонки.Добавить("Код");
	ЕдиницыИзмерения.Колонки.Добавить("Наименование");
	ЕдиницыИзмерения.Колонки.Добавить("НаименованиеПолное");
	ЕдиницыИзмерения.Колонки.Добавить("УсловноеОбозначениеМеждународное");

	НоваяСтрока = ЕдиницыИзмерения.Добавить();
	НоваяСтрока.Код = "166";
	НоваяСтрока.Наименование = "кг";
	НоваяСтрока.НаименованиеПолное = "килограмм";
	НоваяСтрока.УсловноеОбозначениеМеждународное = "KGM";
	

	НоваяСтрока = ЕдиницыИзмерения.Добавить();
	НоваяСтрока.Код = "112";
	НоваяСтрока.Наименование = "л/дм3";
	НоваяСтрока.НаименованиеПолное = "Литр/Кубический дециметр";
	НоваяСтрока.УсловноеОбозначениеМеждународное = "LTR";

	НоваяСтрока = ЕдиницыИзмерения.Добавить();
	НоваяСтрока.Код = "1868";
	НоваяСтрока.Наименование = "порц";
	НоваяСтрока.НаименованиеПолное = "порция";

	НоваяСтрока = ЕдиницыИзмерения.Добавить();
	НоваяСтрока.Код = "163";
	НоваяСтрока.Наименование = "г";
	НоваяСтрока.НаименованиеПолное = "грамм";
	НоваяСтрока.УсловноеОбозначениеМеждународное = "GRM";
	
	НоваяСтрока = ЕдиницыИзмерения.Добавить();
	НоваяСтрока.Код = "111";
	НоваяСтрока.Наименование = "см3 (мл)";
	НоваяСтрока.НаименованиеПолное = "Кубический сантиметр (Миллилитр)";

	НоваяСтрока = ЕдиницыИзмерения.Добавить();
	НоваяСтрока.Код = "796";
	НоваяСтрока.Наименование = "шт";
	НоваяСтрока.НаименованиеПолное = "штука";
	
	НоваяСтрока = ЕдиницыИзмерения.Добавить();
	НоваяСтрока.Код = "0";
	НоваяСтрока.Наименование = "Не найдено";
	НоваяСтрока.НаименованиеПолное = "Загрузка с сайта FoodCost без ед. изм.";


	Грамм      = ПолучитьБазовуюЕдиницуИзмерения(ЕдиницыИзмерения.Найти("г", "Наименование"), Создавать);
	Килограмм  = ПолучитьБазовуюЕдиницуИзмерения(ЕдиницыИзмерения.Найти("кг", "Наименование"), Создавать);
	Литр       = ПолучитьБазовуюЕдиницуИзмерения(ЕдиницыИзмерения.Найти("л/дм3", "Наименование"), Создавать);
	
КонецПроцедуры

// Функция - Получить список единиц измерения.
//
// Параметры:
//  ТекСтрокаНоменклатураБазы - Строка - Тек строка номенклатура базы.
//
// Возвращаемое значение:
//  СписокЗначений - Результат обработки.
&НаСервере
Функция ПолучитьСписокЕдиницИзмерения(ТекСтрокаНоменклатураБазы)
	
	МассивНоменклатура = Новый Массив;
	МассивНоменклатура.Добавить(ТекСтрокаНоменклатураБазы);
	Результат = питИнвентаризацияВызовСервера.ТаблицаУпаковокНоменклатуры(МассивНоменклатура, Неопределено, Истина, Истина, Истина);
	Результат = Результат.ВыгрузитьКолонку("Упаковка");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти





