// Функция - Получить идентификатор по значению.
//
// Параметры:
//  ДереВо - Произвольный - Дере во.
//  СтрукЗначений - Произвольный - Струк значений.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ПолучитьИдентификаторПоЗначению(ДереВо, СтрукЗначений)
	Перем Рез;
	ТекущаяКоллекция = ДереВо.ПолучитьЭлементы();
	Для Каждого Стр из ТекущаяКоллекция Цикл
		Родитель = Стр.ПолучитьРодителя();
		Если Родитель <> Неопределено Тогда
			Если Родитель.fc_id = СтрукЗначений.parent_id И Стр.fc_id = СтрукЗначений.fc_id Тогда
				Возврат Стр.ПолучитьИдентификатор();
			КонецЕсли;
			Рез = ПолучитьИдентификаторПоЗначению(Стр, СтрукЗначений);
			Если Рез <> 0 Тогда
				Возврат Рез
			КонецЕсли;
		иначе
			Рез = ПолучитьИдентификаторПоЗначению(Стр, СтрукЗначений);
			Возврат Рез;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

// Процедура - Заполнить массив раскрытых блюд.
//
// Параметры:
//  МассивРаскрытых - Массив - Массив раскрытых.
//  Дерево - ДеревоЗначений - Дерево.
//
&НаКлиенте
Процедура ЗаполнитьМассивРаскрытыхБлюд(МассивРаскрытых,Дерево)
	
	ТекущаяКоллекция = ДереВо.ПолучитьЭлементы();
	Для Каждого Стр из ТекущаяКоллекция Цикл
		Если Стр.ЭтоИнгредиент <> 1 Тогда
			Если Элементы.ДеревоГотовойПродукции.Развернут(Стр.получитьИдентификатор()) Тогда
				МассивРаскрытых.добавить(Стр.fc_id);
				ЗаполнитьМассивРаскрытыхБлюд(МассивРаскрытых, Стр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
// Процедура - Заполнить массив раскрытых ингредиентов.
//
// Параметры:
//  МассивРаскрытых - Массив - Массив раскрытых.
//  Дерево - ДеревоЗначений - Дерево.
//
&НаКлиенте
Процедура ЗаполнитьМассивРаскрытыхИнгредиентов(МассивРаскрытых,Дерево)
	
	ТекущаяКоллекция = ДереВо.ПолучитьЭлементы();
	Для Каждого Стр из ТекущаяКоллекция Цикл
		Если Стр.ПризнакГруппы Тогда
			Если Элементы.ДеревоИнгредиентов.Развернут(Стр.получитьИдентификатор()) Тогда
				МассивРаскрытых.добавить(Стр.fc_id);
				ЗаполнитьМассивРаскрытыхИнгредиентов(МассивРаскрытых, Стр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Восстановить раскрытостьпо массиву.
//
// Параметры:
//  МассивРаскрытых - Массив - Массив раскрытых.
//  Дерево - ДеревоЗначений - Дерево.
//  ЭлементФормы - Произвольный - Элемент формы.
//
&НаКлиенте
Процедура ВосстановитьРаскрытостьпоМассиву(МассивРаскрытых, Дерево, ЭлементФормы);
	ТекущаяКоллекция = ДереВо.ПолучитьЭлементы();
	Для Каждого Стр из ТекущаяКоллекция Цикл
		Если МассивРаскрытых.найти(Стр.fc_id) <> Неопределено Тогда
			ЭлементФормы.Развернуть(Стр.ПолучитьИдентификатор(), Ложь);
		КонецЕсли;
		ВосстановитьРаскрытостьпоМассиву(МассивРаскрытых, Стр, ЭлементФормы);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

// Обращение к типовой функции на сервере
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//  ИмяРеквизита - Произвольный - Имя реквизита.
//
// Возвращаемое значение:
