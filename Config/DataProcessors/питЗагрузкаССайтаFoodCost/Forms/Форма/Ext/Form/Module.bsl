			ФК.ПолеХТМЛ = СтрЗаменить(ТекстHTMLМакет, "КомментарийСайта", ЭтаФорма.КомментарийСайта);
			ФК.Открыть();
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Загрузка прошла успешно!!!";
			Сообщение.Сообщить();
		КонецЕсли;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при загрузке";
		Сообщение.Сообщить();
	КонецЕСли;
КонецПроцедуры

// Процедура - Командная панель дерева готовой продукции выбрать все.
