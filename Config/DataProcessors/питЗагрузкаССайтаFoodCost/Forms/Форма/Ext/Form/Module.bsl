// Процедура - Кнопка загрузить нажатие.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура КнопкаЗагрузитьНажатие(Команда)
	
	ОтказПродолжать = Ложь;
	
	Если (СпособЦелевойГруппы = 0) и ГруппаПоУмолчанию = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Не заполнена группа по умолчанию!'"), ,
				"ГруппаПоУмолчанию",
				"Объект");
			ОтказПродолжать = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.НоменклатурнаяГруппаГотоваяПродукция) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Не заполнено поле вид номенклатуры для блюд.'"), ,
				"НоменклатурнаяГруппаГотоваяПродукция",
				"Объект");
		ОтказПродолжать = Истина;
	Иначе
		ТипНоменклатуры = ЗначениеРеквизитаОбъекта(Объект.НоменклатурнаяГруппаГотоваяПродукция, "ТипНоменклатуры");
		Если НЕ ЗначениеЗаполнено(ТипНоменклатуры) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не заполнено поле тип номенклатуры для вида номенклатуры блюд.'"), ,
			"НоменклатурнаяГруппаГотоваяПродукция",
			"Объект");
			ОтказПродолжать = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.НоменклатурнаяГруппаИнгредиенты) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		НСтр("ru = 'Не заполнено поле вид номенклатуры для ингредиентов.'"), ,
		"НоменклатурнаяГруппаИнгредиенты",
		"Объект");
		ОтказПродолжать = Истина;
	Иначе
		ТипНоменклатуры = ЗначениеРеквизитаОбъекта(Объект.НоменклатурнаяГруппаИнгредиенты, "ТипНоменклатуры");
		Если НЕ ЗначениеЗаполнено(ТипНоменклатуры) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не заполнено поле тип номенклатуры для вида номенклатуры ингредиентов.'"), ,
			"НоменклатурнаяГруппаИнгредиенты",
			"Объект");
			ОтказПродолжать = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Не заполнено поле организации.'"), ,
				"Организация",
				"Объект");
		ОтказПродолжать = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ДатаЗагрузкиРецептур) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		НСтр("ru = 'Не заполнено поле даты загрузки рецептур.'"), ,
		"ДатаЗагрузкиРецептур",
		"Объект");
		ОтказПродолжать = Истина;
	КонецЕсли;
	
	Если ОтказПродолжать Тогда
		Возврат
	КонецЕсли;
	
	Состояние("Подождите... Идет загрузка данных!");
	
	Если ЗагрузитьНаСервере() Тогда
		Если ЗначениеЗаполнено(ЭтаФорма.КомментарийСайта) Тогда
			ФК = ПолучитьФорму("Обработка.питЗагрузкаССайтаFoodCost.Форма.КомментарийСайта",,ЭтаФорма);
			ФК.Заголовок = "Загрузка прошла успешно!!!";
			ФК.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
			ТекстHTMLМакет = ПолучитьТекст();
