// Процедура - ОбработчикОповещенияУстановкиПараметров
//
// Параметры:
//  РезультатОткрытияФормы - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры - Структура - ДополнительныеПараметр.
//
&НаКлиенте
Процедура ОбработчикОповещенияУстановкиПараметров(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	УстановитьЦветКнопкиНастройкиПараметровПодключения();
КонецПроцедуры //ОбработчикОповещенияУстановкиПараметров

// Проставляет во всем дереве
//
// Параметры:
//  Реж - Произвольный - Реж.
//
&НаСервере
Процедура ПроставитьСоответствияЭлементовНаСервере(Реж) Экспорт
	
	ДГП = ДанныеФормыВЗначение(Объект.ДеревоГотовойПродукции, тип("ДеревоЗначений"));
	ДИ = ДанныеФормыВЗначение(Объект.ДеревоИнгредиентов     , тип("ДеревоЗначений"));
	
	Если Реж = 1 Тогда //По точному совпадению наименований
		СоздатьЗапросПоНаименованиюНаСервере();
		Для Каждого Стр из ДГП.Строки Цикл
			УстановитьНоменнклатуруБазыПоПолномуСоответствиюНаименования(Стр);
			ЗаполнитьПодстрокиПоПолномуСоответствиюНаименования(Стр);
		КонецЦикла;
		
		Для Каждого Стр из ДИ.Строки Цикл
			УстановитьНоменнклатуруБазыПоПолномуСоответствиюНаименования(Стр);
			ЗаполнитьПодстрокиПоПолномуСоответствиюНаименования(Стр);
		КонецЦикла;
		
	ИначеЕсли Реж = 2 Тогда // По совпадению артикулов
		СоздатьЗапросПоАртикулу();
		Для Каждого Стр из ДГП.Строки Цикл
			УстановитьНоменнклатуруБазыПоАртикулу(Стр);
			ЗаполнитьПодстрокиПоАртикулу(Стр);
		КонецЦикла;
		
		Для Каждого Стр из ДИ.Строки Цикл
			УстановитьНоменнклатуруБазыПоАртикулу(Стр);
			ЗаполнитьПодстрокиПоАртикулу(Стр);
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВДанныеФормы(ДГП, объект.ДеревоГотовойПродукции);
	ЗначениеВДанныеФормы(ДИ, Объект.ДеревоИнгредиентов);
	
КонецПроцедуры

// Процедура - Совпадение по частичному совпадению наименований завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СовпадениеПоЧастичномуСовпадениюНаименований_Завершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПолнотекстовыйПоискОбновитьИндекс();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Поисковый индекс обновлен.";
		Сообщение.Сообщить();
	КонецЕсли;
	
	СовпадениеПоЧастичномуСовпадениюНаименованийФрагмент();
	
КонецПроцедуры

// Процедура - Команда очистить соответствия завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура КомандаОчиститьСоответствия_Завершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да  Тогда
		КомандаОчиститьСоответствияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьПользовательскоеСоглашение() Экспорт
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ПослеОткрытияПользовательскогоСоглашения", ЭтотОбъект);
	ОткрытьФорму("Обработка.питЗагрузкаССайтаFoodCost.Форма.ЛицензионноеСоглашение",,,,,,ОбработчикОповещения);
	
КонецПроцедуры

// Процедура - ПослеОткрытияПользовательскогоСоглашения.
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры.
//
&НаКлиенте
Процедура ПослеОткрытияПользовательскогоСоглашения(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Истина Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийФормы

// Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Объект.ДатаЗагрузкиРецептур = ТекущаяДата();
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Объект.Подразделение = ПараметрыСеанса.ТекущийПользователь.Подразделение;;
	КонецЕсли;
	
	ГруппаПоУмолчанию = ХранилищеНастроекДанныхФорм.Загрузить(ЭтаФорма.ИмяФормы, "ФормаЗагрузкаССайтаFoodCost_ГруппаПоУмолчанию");
	СпособЦелевойГруппы = ХранилищеНастроекДанныхФорм.Загрузить(ЭтаФорма.ИмяФормы, "ФормаЗагрузкаССайтаFoodCost_СпособЦелевойГруппы");
	Элементы.ГруппаПоУмолчанию.Доступность = (1 <> СпособЦелевойГруппы);
	
	объект.НоменклатурнаяГруппаГотоваяПродукция = ХранилищеНастроекДанныхФорм.Загрузить(ЭтаФорма.ИмяФормы, "ФормаЗагрузкаССайтаFoodCost_НоменклатурнаяГруппаГотоваяПродукция");
	объект.НоменклатурнаяГруппаИнгредиенты = ХранилищеНастроекДанныхФорм.Загрузить(ЭтаФорма.ИмяФормы, "ФормаЗагрузкаССайтаFoodCost_НоменклатурнаяГруппаИнгредиенты");
	
	РецептурыОбновлятьСуществующие = ХранилищеНастроекДанныхФорм.Загрузить(ЭтаФорма.ИмяФормы, "ФормаЗагрузкаССайтаFoodCost_РецептурыОбновлятьСуществующие");
	РецептурыСоздавать = ХранилищеНастроекДанныхФорм.Загрузить(ЭтаФорма.ИмяФормы, "ФормаЗагрузкаССайтаFoodCost_РецептурыСоздавать");
	
	ОбновлятьСуществующиеХЭХи = ХранилищеНастроекДанныхФорм.Загрузить(ЭтаФорма.ИмяФормы, "ФормаЗагрузкаССайтаFoodCost_ОбновлятьСуществующиеХЭХи");
	
	ФудКостПроцентСхожести = 95;
	
	УстановитьЦветКнопкиНастройкиПараметровПодключения();
	
	ЕстьСогласиеСПользовательскимСоглашением = Константы.питФудКостСогласиеНаИспользование.Получить();
	
КонецПроцедуры

// Процедура - При закрытии.
//
&НаКлиенте
Процедура ПриЗакрытии()
	СохранитьНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЕстьСогласиеСПользовательскимСоглашением Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОткрытьПользовательскоеСоглашение", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

// Процедура - Дерево номенклатуры галочка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоНоменклатурыГалочкаПриИзменении(Элемент)
	ИмяДерева = Элемент.Родитель.Имя;
	 
	
	ИДТекущейСтроки = Элементы[ИмяДерева].ТекущаяСтрока;
	
	Если ИДТекущейСтроки <> Неопределено Тогда
		
		ЭлементКоллекции = Объект[Элемент.Родитель.Имя].НайтиПоИдентификатору(ИДТекущейСтроки);
		Если ИмяДерева = "ДеревоГотовойПродукции" И ЭлементКоллекции.ЭтоИнгредиент = 1 Тогда
			ЭлементКоллекции.Галочка = ЭлементКоллекции.Отметка;
			Возврат;
		КонецЕсли;
		
		Если ЭлементКоллекции.Галочка = 2 Тогда
			ЭлементКоллекции.Галочка = 0;
		КонецЕсли;
		
		ЭлементКоллекции.Отметка=ЭлементКоллекции.Галочка;
		ОтметитьВсеПодчиненныеЭлементы(ЭлементКоллекции.ПолучитьЭлементы(), ЭлементКоллекции.Галочка, ИмяДерева);
		РасстановкаГалочекУРодителей(ЭлементКоллекции.ПолучитьРодителя());
		
	КонецЕсли;
КонецПроцедуры

// Процедура - Обновить создать хэх.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Стр - Произвольный - Стр.
//
&НаСервере
Процедура ОбновитьСоздатьХЭХ(Элемент, Стр)
	
	// ХИМИКО-ЭНЕРГЕТИЧЕСКИЕ ХАРАКТЕРИСТИКИ
	Белки = ?(Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо, стр.nutrition_proteins, стр.proteins);
	Если ЗначениеЗаполнено(Белки) Тогда
		ХЭХ = РегистрыСведений.питХимикоэнергетическиеХарактеристики.СоздатьНаборЗаписей();
		ХЭХ.Отбор.Номенклатура.Установить(Элемент);
		ХЭХ.Отбор.ХимикоЭнергетическаяХарактеристика.Установить(Справочники.питХимикоэнергетическиеХарактеристики.Белки);
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	ХЭХ.Отбор.Рецептура.Установить(ТекРецептура);
		// КонецЕсли;
		НоваяЗапись = ХЭХ.Добавить();
		НоваяЗапись.Номенклатура = Элемент;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Белки;
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	НоваяЗапись.Рецептура = ТекРецептура;
		// КонецЕсли;
		НоваяЗапись.КоличествоХарактеристики = Белки;
		ХЭХ.Записать();
	КонецЕсли;
	
	Жиры = ?(Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо, стр.nutrition_fat, стр.fats);
	Если ЗначениеЗаполнено(Жиры) Тогда
		ХЭХ = РегистрыСведений.питХимикоэнергетическиеХарактеристики.СоздатьНаборЗаписей();
		ХЭХ.Отбор.Номенклатура.Установить(Элемент);
		ХЭХ.Отбор.ХимикоЭнергетическаяХарактеристика.Установить(Справочники.питХимикоэнергетическиеХарактеристики.Жиры);
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	ХЭХ.Отбор.Рецептура.Установить(ТекРецептура);
		// КонецЕсли;
		НоваяЗапись = ХЭХ.Добавить();
		НоваяЗапись.Номенклатура = Элемент;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Жиры;
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	НоваяЗапись.Рецептура = ТекРецептура;
		// КонецЕсли;
		НоваяЗапись.КоличествоХарактеристики = Жиры;
		ХЭХ.Записать();
	КонецЕсли;
	
	Углеводы = ?(Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо, стр.nutrition_carbohydrates, стр.carbohydrates);
	Если ЗначениеЗаполнено(Углеводы) Тогда
		ХЭХ = РегистрыСведений.питХимикоэнергетическиеХарактеристики.СоздатьНаборЗаписей();
		ХЭХ.Отбор.Номенклатура.Установить(Элемент);
		ХЭХ.Отбор.ХимикоЭнергетическаяХарактеристика.Установить(Справочники.питХимикоэнергетическиеХарактеристики.Углеводы);
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	ХЭХ.Отбор.Рецептура.Установить(ТекРецептура);
		// КонецЕсли;
		НоваяЗапись = ХЭХ.Добавить();
		НоваяЗапись.Номенклатура = Элемент;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Углеводы;
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	НоваяЗапись.Рецептура = ТекРецептура;
		// КонецЕсли;
		НоваяЗапись.КоличествоХарактеристики = Углеводы;
		ХЭХ.Записать();
	КонецЕсли;
	
	Алкоголь = ?(Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо, стр.nutrition_alcohol, стр.alcohol);
	Если ЗначениеЗаполнено(Алкоголь) Тогда
		ХЭХ = РегистрыСведений.питХимикоэнергетическиеХарактеристики.СоздатьНаборЗаписей();
		ХЭХ.Отбор.Номенклатура.Установить(Элемент);
		ХЭХ.Отбор.ХимикоЭнергетическаяХарактеристика.Установить(Справочники.питХимикоэнергетическиеХарактеристики.Алкоголь);
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	ХЭХ.Отбор.Рецептура.Установить(ТекРецептура);
		// КонецЕсли;
		НоваяЗапись = ХЭХ.Добавить();
		НоваяЗапись.Номенклатура = Элемент;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Алкоголь;
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	НоваяЗапись.Рецептура = ТекРецептура;
		// КонецЕсли;
		НоваяЗапись.КоличествоХарактеристики = Алкоголь;
		ХЭХ.Записать();
	КонецЕсли;
	
	Если (Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо и ЗначениеЗаполнено(стр.nutrition_caloric)) или (Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар и ЗначениеЗаполнено(стр.nutrition)) Тогда
		ХЭХ = РегистрыСведений.питХимикоэнергетическиеХарактеристики.СоздатьНаборЗаписей();
		ХЭХ.Отбор.Номенклатура.Установить(Элемент);
		ХЭХ.Отбор.ХимикоЭнергетическаяХарактеристика.Установить(Справочники.питХимикоэнергетическиеХарактеристики.Калорийность);
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	ХЭХ.Отбор.Рецептура.Установить(ТекРецептура);
		// КонецЕсли;
		НоваяЗапись = ХЭХ.Добавить();
		НоваяЗапись.Номенклатура = Элемент;
		НоваяЗапись.ХимикоэнергетическаяХарактеристика = Справочники.питХимикоэнергетическиеХарактеристики.Калорийность;
		// Если ЗначениеЗаполнено(ТекРецептура) Тогда
		// 	НоваяЗапись.Рецептура = ТекРецептура;
		// КонецЕсли;
		НоваяЗапись.КоличествоХарактеристики = ?(Элемент.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо, стр.nutrition_caloric, стр.nutrition);
		ХЭХ.Записать();
	КонецЕсли;
	
	
КонецПроцедуры

// Процедура - Дерево готовой продукции ссылка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоГотовойПродукцииСсылкаПриИзменении(Элемент)
	
	Перем МассивРаскрытых;
	
	МассивРаскрытых = новый Массив;
	ЗаполнитьМассивРаскрытыхБлюд(МассивРаскрытых, объект.ДеревоГотовойПродукции);
	
	ТекСтрока = Элементы.ДеревоГотовойПродукции.ТекущиеДанные;
	струкЗапомнимТекущий = Новый Структура("parent_id,fc_id",ТекСтрока.ПолучитьРодителя().fc_id,ТекСтрока.fc_id );
	
	//
	Рез = ДеревоГотовойПродукцииСсылкаПриИзмененииНаСервереПроверки(ТекСтрока.fc_id ,ТекСтрока.НоменклатураБазы,ТекСтрока.ПризнакГруппы,ТекСтрока.ВидНоменклатуры,ТекСтрока.ЭтоИнгредиент, Истина);
	
	ВопросОСозданииГрИлиКГ_Фрагмент(МассивРаскрытых, Рез, струкЗапомнимТекущий, ТекСтрока);
	
КонецПроцедуры

// Процедура - Дерево ингредиентов ссылка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоИнгредиентовСсылкаПриИзменении(Элемент)
	
	МассивРаскрытых = новый Массив;
	ЗаполнитьМассивРаскрытыхИнгредиентов(МассивРаскрытых, объект.ДеревоИнгредиентов);
	
	ТекСтрока = Элементы.ДеревоИнгредиентов.ТекущиеДанные;
	струкЗапомнимТекущий = Новый Структура("parent_id,fc_id",ТекСтрока.ПолучитьРодителя().fc_id,ТекСтрока.fc_id );
	
	РЕЗ = ДеревоИнгредиентовСсылкаПриИзмененииНаСервере(ТекСтрока.НоменклатураБазы,ТекСтрока.ПризнакГруппы,ТекСтрока.fc_id);
	Если РЕЗ <> "" Тогда
		ТекСтрока.НоменклатураБазы = Неопределено;
		ПоказатьПредупреждение(,рез,60);
	КонецЕсли;
	
	
	ВосстановитьРаскрытостьпоМассиву(МассивРаскрытых, Объект.ДеревоИнгредиентов, Элементы.ДеревоИнгредиентов);
	ТекСтр = ПолучитьИдентификаторПоЗначению(Объект.ДеревоИнгредиентов, струкЗапомнимТекущий);
	Элементы.ДеревоИнгредиентов.ТекущаяСтрока = ТекСтр;
	
КонецПроцедуры
// Процедура - Группа по умолчанию при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ГруппаПоУмолчаниюПриИзменении(Элемент)
	Если НЕ ГруппаПоУмолчаниюЭтоГруппа() Тогда
		ГруппаПоУмолчанию = "";
		ПоказатьПредупреждение(,"Надо выбрать группу.",60);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Способ целевой группы при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпособЦелевойГруппыПриИзменении(Элемент)
	элементы.ГруппаПоУмолчанию.Доступность = (1 <> СпособЦелевойГруппы);
КонецПроцедуры

