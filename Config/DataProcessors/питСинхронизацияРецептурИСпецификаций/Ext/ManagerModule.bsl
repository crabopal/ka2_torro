#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область КомандныйИнтерфейс

// Процедура выполнения длительной операции синхронизации отмеченных рецептур и спецификаций.
//
// Параметры:
//  Параметры		 - Структура - Параметры длительной операции.
//  АдресРезультата	 - Строка - адрес, куда будет помещен результат в хранилище.
//
Процедура СинхронизироватьОтмеченныеРецептурыСпецификации(Параметры, АдресРезультата) Экспорт
	
	// Будем использовать функцию "СформироватьТиповыеДокументы", для этого сначала подготовим данные для ее вызова.
	ТекстОшибки = "";
	СтруктураПараметров = Новый Структура;
	// Проверка режима производства.
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22, ТекстОшибки);
	Если НЕ РежимПроизводстваРазрешен Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	// Структура параметров.
	СтруктураПараметров.Вставить("ДатаСмещение", 0);
	СтруктураПараметров.Вставить("РежимПроизводстваРазрешен", РежимПроизводстваРазрешен);
	СтруктураПараметров.Вставить("ФормироватьДокументыПроизводства22", ФормироватьДокументыПроизводства22);
	СтруктураПараметров.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);
	СтруктураПараметров.Вставить("ЭтоРежимСинхронизации", Истина);
	
	// Массив строк для удаления.
	СтрокиУдалить = Новый Массив;
	
	// Поиск строк в таблице рецептур спецификаций, для которых требуется выполнить синхронизацию.
	НайденныеСтроки = Параметры.ТаблицаРецептурСпецификаций.НайтиСтроки(Новый Структура("ВыполнитьСинхронизацию", Истина));
	
	// Для вывода прогресса длительной операции.
	НомерПоПорядку = 0;
	ВсегоОбъектов = НайденныеСтроки.Количество();
	ТекПроцентВыполнения = 0;
	
	// Обход строк к синхронизации.
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		
		// Вывод прогресса длительной операции каждый раз, когда меняется процент выполнения.
		НомерПоПорядку = НомерПоПорядку + 1;
		НовПроцентВыполнения = Окр(100 * НомерПоПорядку / ВсегоОбъектов);
		Если ТекПроцентВыполнения <> НовПроцентВыполнения Тогда
			ТекПроцентВыполнения = НовПроцентВыполнения;
			ДлительныеОперации.СообщитьПрогресс(ТекПроцентВыполнения, "Обработано рецептур <"+НомерПоПорядку+"> из <"+ВсегоОбъектов+">");
		КонецЕсли;
		
		// Синхронизация рецептуры и спецификации.
		Отказ = НЕ питТиповыеДокументы.СформироватьТиповыеДокументы(ТекСтрока.Рецептура,СтруктураПараметров,,ТекстОшибки);
		Если Отказ Тогда
			// Ошибка синхронизации, запишем это в журнал регистрации и вызовем исключение.
			ИмяСобытияЖурнала = НСтр("ru = 'Формирование специфицкаций по рецептурам'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
			// Перед вызовом исключения удалим строки к удалению и поместим результат в хранилище.
			Для каждого ТекСтока Из СтрокиУдалить Цикл
				Параметры.ТаблицаРецептурСпецификаций.Удалить(ТекСтока);
			КонецЦикла;
			ПоместитьВоВременноеХранилище(Параметры.ТаблицаРецептурСпецификаций, АдресРезультата);
			
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		// Обновление флагов синхронизации.
		ТекСтрока.ВыполнитьСинхронизацию = Ложь;
		ТекСтрока.Синхронизирован = 1;
		Если Параметры.ОтображениеСпецификаций = 0 Тогда
			СтрокиУдалить.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	// Финальные действия, удаление строк к удалению и помещение результата.
	Для каждого ТекСтока Из СтрокиУдалить Цикл
		Параметры.ТаблицаРецептурСпецификаций.Удалить(ТекСтока);
	КонецЦикла;
	ПоместитьВоВременноеХранилище(Параметры.ТаблицаРецептурСпецификаций, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
