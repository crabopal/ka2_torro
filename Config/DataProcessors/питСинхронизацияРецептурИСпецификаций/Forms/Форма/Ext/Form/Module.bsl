
#Область ПрограммныйИнтерфейс

#Область СинронизацияОтмеченных

// Процедура завершения длительной операции синхронизации клиент.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СинхронизироватьОтмеченныеРецептурыСпецификацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
	Иначе
		СинхронизироватьОтмеченныеРецептурыСпецификацииЗавершениеНаСервере(Результат.АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Завершение обработчика команды "Синхронизировать отмеченные".
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СинхронизироватьОтмеченныеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		// Пользователь ответил положительно, приступаем к синхронизации.
		СинхронизироватьОтмеченныеВФонеКлиент();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Обработчик события "ПриСозданииНаСервере".
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// Восстановление настроек пользователя.
	
	ВосстановитьНастройки();
	
	// Обновление таблицы синхронизации по установленным отборам.
	ОбновитьТаблицуРецептурСпецификаций();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

// Обработчик события нажатия на гиперссылку "Свернуть".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СвернутьОтборыНажатие(Элемент)
	СвернутьРазвернутьНастройки();
КонецПроцедуры

// Обработчик события нажатия на гиперссылку "Развернуть".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДекорацияРазвернутьНажатие(Элемент)
	СвернутьРазвернутьНастройки();
КонецПроцедуры

// Обработчик события выбора в таблице "ТаблицаРецептурСпецификаций".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаРецептурСпецификацийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ИмяПоказать = "";
		Если Элемент.ТекущийЭлемент = Элементы.ТаблицаРецептурСпецификацийРецептура Тогда
			ИмяПоказать = "Рецептура";
		ИначеЕсли Элемент.ТекущийЭлемент = Элементы.ТаблицаРецептурСпецификацийНоменклатура Тогда
			ИмяПоказать = "Номенклатура";
		ИначеЕсли Элемент.ТекущийЭлемент = Элементы.ТаблицаРецептурСпецификацийНаименованиеСпецификации Тогда
			ИмяПоказать = "Спецификация";
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяПоказать) Тогда
			Попытка
				ПоказатьЗначение(, ТекДанные[ИмяПоказать]);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область КомандыПодбора

// Обработка выбора команды подбора номенклатуры.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ОтборНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	// Обработка выбора из подбора номенклатуры.
	СтандартнаяОбработка = Ложь;
	// Поиск подобранного значения в таблице.
	ЗначениеНайдено = Ложь;
	Для каждого ТекСтрока Из ОтборНоменклатура Цикл
		Если ТекСтрока.Номенклатура = ВыбранноеЗначение Тогда
			ЗначениеНайдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗначениеНайдено Тогда
		// Если значение не найдено, добавление значения в таблицу.
		НовСтрока = ОтборНоменклатура.Добавить();
		НовСтрока.Номенклатура = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры

// Обработка выбора команды подбора подразделений.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ОтборПодразделениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	// Обработка выбора из подбора номенклатуры.
	СтандартнаяОбработка = Ложь;
	// Поиск подобранного значения в таблице.
	ЗначениеНайдено = Ложь;
	Для каждого ТекСтрока Из ОтборПодразделение Цикл
		Если ТекСтрока.Подразделение = ВыбранноеЗначение Тогда
			ЗначениеНайдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗначениеНайдено Тогда
		// Если значение не найдено, добавление значения в таблицу.
		НовСтрока = ОтборПодразделение.Добавить();
		НовСтрока.Подразделение = ВыбранноеЗначение;
		НовСтрока.ВключаяПодчиненные = Истина;
	КонецЕсли;
КонецПроцедуры

// Обработка выбора подбора видов номенклатуры.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ОтборВидНоменклатурыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	// Обработка выбора из подбора номенклатуры.
	СтандартнаяОбработка = Ложь;
	// Поиск подобранного значения в таблице.
	ЗначениеНайдено = Ложь;
	Для каждого ТекСтрока Из ОтборВидНоменклатуры Цикл
		Если ТекСтрока.ВидНоменклатуры = ВыбранноеЗначение Тогда
			ЗначениеНайдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗначениеНайдено Тогда
		// Если значение не найдено, добавление значения в таблицу.
		НовСтрока = ОтборВидНоменклатуры.Добавить();
		НовСтрока.ВидНоменклатуры = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область КомандыПодбора

// Обработчик команды подбора номенклатуры.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборНоменклатура(Команда)
	
	// Открытие формы выбора для подбора значений.
	ПараметрыВыбора = Новый Структура("РежимВыбора,ЗакрыватьПриВыборе,ВыборГруппИЭлементов", Истина, Ложь, ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	ФормаВыбора = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора,Элементы.ОтборНоменклатура);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

// Обработчик команды подбора подразделений.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборПодразделения(Команда)
	// Открытие формы выбора для подбора значений.
	ПараметрыВыбора = Новый Структура("РежимВыбора,ЗакрыватьПриВыборе", Истина, Ложь);
	ФормаВыбора = ПолучитьФорму("Справочник.СтруктураПредприятия.ФормаВыбора",ПараметрыВыбора,Элементы.ОтборПодразделение);
	ФормаВыбора.Открыть();
КонецПроцедуры

// Обработчик команды подбора видов номенклатуры.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборВидыНоменклатуры(Команда)
	// Открытие формы выбора для подбора значений.
	ПараметрыВыбора = Новый Структура("РежимВыбора,ЗакрыватьПриВыборе,ВыборГруппИЭлементов", Истина, Ложь, ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	ФормаВыбора = ПолучитьФорму("Справочник.ВидыНоменклатуры.ФормаВыбора",ПараметрыВыбора,Элементы.ОтборВидНоменклатуры);
	ФормаВыбора.Открыть();
КонецПроцедуры

#КонецОбласти

// Обработчик команды сохранения настроек отбора.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СохранитьНастройкиОбработки(Команда)
	СохранитьНастройки();
КонецПроцедуры

// Обработчик команды восстановления настроек отбора по умолчанию.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВосстановитьНастройкиПоУмолчанию(Команда)
	УстановитьНастройкиПоУмолчанию();
	СохранитьНастройки();
КонецПроцедуры

// Обработчик команды обновления таблицы спецификаций по отбору.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Сформировать(Команда)
	
	// Запоминаем данные текущей строки, чтобы после обновления таблицы поставить на ней фокус.
	ТекДанные = Элементы.ТаблицаРецептурСпецификаций.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		СтруктураТекСтоки = Новый Структура("Рецептура,Спецификация");
		ЗаполнитьЗначенияСвойств(СтруктураТекСтоки, ТекДанные);
	КонецЕсли;
	
	ОбновитьТаблицуРецептурСпецификаций();
	
	// Установка фокуса на ту строку, на которой находился пользователь до применения отбора.
	Если НЕ ТекДанные = Неопределено Тогда
		СтрокиТаблицы = ТаблицаРецептурСпецификаций.НайтиСтроки(СтруктураТекСтоки);
		Если СтрокиТаблицы.Количество() Тогда
			СтрокаТаблицы = СтрокиТаблицы[0];
			Элементы.ТаблицаРецептурСпецификаций.ТекущаяСтрока = СтрокаТаблицы.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик команды "Выбрать все".
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТаблицаРецептурВыбратьВсе(Команда)
	Для каждого ТекСтрока Из ТаблицаРецептурСпецификаций Цикл
		ТекСтрока.ВыполнитьСинхронизацию = Истина;
	КонецЦикла;
КонецПроцедуры

// Обработчик команды "Снять выбор".
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТаблицаРецептурСнятьВыбор(Команда)
	Для каждого ТекСтрока Из ТаблицаРецептурСпецификаций Цикл
		ТекСтрока.ВыполнитьСинхронизацию = Ложь;
	КонецЦикла;
КонецПроцедуры

// Обработчик команды "Синхронизировать отмеченные".
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СинхронизироватьОтмеченные(Команда)
	
	// Проверка, есть ли дубли строк в табличных частях синхронизируемых спецификаций.
	ЕстьДубли = ЕстьДублиСтрокВСпецификациях();
	Если НЕ ПустаяСтрока(ЕстьДубли) Тогда
		// Есть дубли, задаем пользователю вопрос о продолжении.
		ПоказатьВопрос(Новый ОписаниеОповещения("СинхронизироватьОтмеченныеЗавершение", ЭтотОбъект), ЕстьДубли, РежимДиалогаВопрос.ДаНет);
	Иначе
		// Нет дублей, сразу приступаем к синхронизации.
		СинхронизироватьОтмеченныеВФонеКлиент();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СинронизацияОтмеченных

// Процедура запуска длительной операции синхронизации клиент.
//
&НаКлиенте
Процедура СинхронизироватьОтмеченныеВФонеКлиент()
	
	ДлительнаяОперация = СинхронизироватьОтмеченныеНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтаФорма);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
	Новый ОписаниеОповещения("СинхронизироватьОтмеченныеРецептурыСпецификацииЗавершение", ЭтаФорма),
	ПараметрыОжидания);
	
КонецПроцедуры

// Функция запуска длительной операции синхронизации клиент.
//
// Возвращаемое значение:
//  См. "ДлительныеОперации.ВыполнитьВФоне"
&НаСервере
Функция СинхронизироватьОтмеченныеНаСервере()
	
	ПараметрыПроцедуры = Новый Структура("ТаблицаРецептурСпецификаций,ОтображениеСпецификаций", ТаблицаРецептурСпецификаций.Выгрузить(),ОтображениеСпецификаций);
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Синхронизация ресурсных спецификаций'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.питСинхронизацияРецептурИСпецификаций.СинхронизироватьОтмеченныеРецептурыСпецификации",
	ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

// Процедура завершения длительной операции синхронизации сервер.
//
// Параметры:
//  АдресРезультата - Произвольный - Адрес результата.
//
&НаСервере
Процедура СинхронизироватьОтмеченныеРецептурыСпецификацииЗавершениеНаСервере(АдресРезультата)
	ОбновитьТаблицуРецептурСпецификаций();
КонецПроцедуры

#КонецОбласти

// Процедура обновляет таблицу рецептур спецификаций в соответствии с отбором.
//
&НаСервере
Процедура ОбновитьТаблицуРецептурСпецификаций()
	
	// Очистка таблицы рецептур.
	ТаблицаРецептурСпецификаций.Очистить();
	
	// Запрос на получение таблицы рецептур и их спецификаций.
	Запрос = Новый Запрос;
	Запрос.Текст = "";
	
	// Выполняется отбор, только если соответствующие таблицы заполнены пользователем. Иначе без отбора.
	ЕстьОтборПоВидамНоменклатуры	= ОтборВидНоменклатуры.Количество();
	ЕстьОтборПономенклатуре			= ОтборНоменклатура.Количество();
	ЕстьОтборПоПодразделениям		= ОтборПодразделение.Количество();
	
	// Для соединения строк не через конкатенацию, а через функцию СтрСоединить.
	СоединитьДвеСтрокиМассив = Новый Массив(2);
	
	Если ЕстьОтборПоВидамНоменклатуры Тогда
		
		// Выборка видов номенклатуры с учетом иерархии.
		
		ТекстЗапросаТаблицаВидовНоменклатуры = "ВЫБРАТЬ
		|	втВидыНоменклатуры.ВидНоменклатуры КАК ВидНоменклатуры
		|ПОМЕСТИТЬ втВидыНоменклатурыВсе
		|ИЗ
		|	&втВидыНоменклатуры КАК втВидыНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втВидыНоменклатурыВсе.ВидНоменклатуры КАК ВидНоменклатуры,
		|	СпрВидыНоменклатуры.ЭтоГруппа КАК ЭтоГруппа
		|ПОМЕСТИТЬ втВидыНоменклатурыСГруппой
		|ИЗ
		|	втВидыНоменклатурыВсе КАК втВидыНоменклатурыВсе
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК СпрВидыНоменклатуры
		|		ПО втВидыНоменклатурыВсе.ВидНоменклатуры = СпрВидыНоменклатуры.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втВидыНоменклатурыСГруппой.ВидНоменклатуры КАК ВидНоменклатуры
		|ПОМЕСТИТЬ втВидыНоменклатуры
		|ИЗ
		|	втВидыНоменклатурыСГруппой КАК втВидыНоменклатурыСГруппой
		|ГДЕ
		|	НЕ втВидыНоменклатурыСГруппой.ЭтоГруппа
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрВидыНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК СпрВидыНоменклатуры
		|ГДЕ
		|	СпрВидыНоменклатуры.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				втВидыНоменклатурыСГруппой.ВидНоменклатуры
		|			ИЗ
		|				втВидыНоменклатурыСГруппой КАК втВидыНоменклатурыСГруппой
		|			ГДЕ
		|				втВидыНоменклатурыСГруппой.ЭтоГруппа)
		|;";
		
		СоединитьДвеСтрокиМассив[0] = Запрос.Текст;
		СоединитьДвеСтрокиМассив[1] = ТекстЗапросаТаблицаВидовНоменклатуры;
		Запрос.Текст = СтрСоединить(СоединитьДвеСтрокиМассив);
		
		Запрос.УстановитьПараметр("втВидыНоменклатуры", ОтборВидНоменклатуры.Выгрузить());
		
	КонецЕсли;
	
	Если ЕстьОтборПономенклатуре Тогда
		
		// Выборка номенклатуры с учетом иерархии, а также если был отбор по видам номенклатуры - по видам номенклатуры.
		
		ТекстЗапросаТаблицаНоменклатуры = "ВЫБРАТЬ
		|	втНоменклатура.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ втНоменклатураВся
		|ИЗ
		|	&втНоменклатура КАК втНоменклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втНоменклатураВся.Номенклатура КАК Номенклатура,
		|	СпрНоменклатура.ЭтоГруппа КАК ЭтоГруппа
		|ПОМЕСТИТЬ втНоменклатураСГруппой
		|ИЗ
		|	втНоменклатураВся КАК втНоменклатураВся
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО втНоменклатураВся.Номенклатура = СпрНоменклатура.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втНоменклатураСГруппой.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ %ИмяТаблицыНоменклатуры%
		|ИЗ
		|	втНоменклатураСГруппой КАК втНоменклатураСГруппой
		|ГДЕ
		|	НЕ втНоменклатураСГруппой.ЭтоГруппа
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрНоменклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
		|ГДЕ
		|	СпрНоменклатура.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				втНоменклатураСГруппой.Номенклатура
		|			ИЗ
		|				втНоменклатураСГруппой КАК втНоменклатураСГруппой
		|			ГДЕ
		|				втНоменклатураСГруппой.ЭтоГруппа)
		|;";
		
		Если ЕстьОтборПоВидамНоменклатуры Тогда
			
			// Если был отбор по видам номенклатуры, то дополнительно фильтруем по ним.
			//  И в дальнейшем отбор по виду уже не будем нигде использовать, т.к. он отработает тут.
			ТекстЗапросаТаблицаНоменклатуры = СтрЗаменить(ТекстЗапросаТаблицаНоменклатуры, "%ИмяТаблицыНоменклатуры%", "втНоменклатураБезФильтраПоВидам");
			ТекстЗапросаДополнительныйОтборПоВидамНоменклатуры = "
			|ВЫБРАТЬ
			|	втНоменклатураБезФильтраПоВидам.Номенклатура
			|ПОМЕСТИТЬ
			|	втНоменклатура
			|ИЗ
			|	втНоменклатураБезФильтраПоВидам КАК втНоменклатураБезФильтраПоВидам
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
			|		ПО втНоменклатураБезФильтраПоВидам.Номенклатура = СпрНоменклатура.Ссылка
			|ГДЕ
			|	СпрНоменклатура.ВидНоменклатуры В 
			|			(ВЫБРАТЬ
			|				втВидыНоменклатуры.ВидНоменклатуры
			|			ИЗ
			|				втВидыНоменклатуры КАК втВидыНоменклатуры)
			|;";
			СоединитьДвеСтрокиМассив[0] = ТекстЗапросаТаблицаНоменклатуры;
			СоединитьДвеСтрокиМассив[1] = ТекстЗапросаДополнительныйОтборПоВидамНоменклатуры;
			ТекстЗапросаТаблицаНоменклатуры = СтрСоединить(СоединитьДвеСтрокиМассив);
			
		Иначе
			ТекстЗапросаТаблицаНоменклатуры = СтрЗаменить(ТекстЗапросаТаблицаНоменклатуры, "%ИмяТаблицыНоменклатуры%", "втНоменклатура");
		КонецЕсли;
		
		СоединитьДвеСтрокиМассив[0] = Запрос.Текст;
		СоединитьДвеСтрокиМассив[1] = ТекстЗапросаТаблицаНоменклатуры;
		Запрос.Текст = СтрСоединить(СоединитьДвеСтрокиМассив);
		
		Запрос.УстановитьПараметр("втНоменклатура", ОтборНоменклатура.Выгрузить());
		
	КонецЕсли;
	
	Если ЕстьОтборПоПодразделениям Тогда
		
		ТекстЗапросаТаблицаПодразделений = "ВЫБРАТЬ
		|	втПодразделения.Подразделение КАК Подразделение,
		|	втПодразделения.ВключаяПодчиненные КАК ВключаяПодчиненные
		|ПОМЕСТИТЬ втПодразделенияВсе
		|ИЗ
		|	&втПодразделения КАК втПодразделения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втПодразделенияВсе.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ втПодразделения
		|ИЗ
		|	втПодразделенияВсе КАК втПодразделенияВсе
		|ГДЕ
		|	НЕ втПодразделенияВсе.ВключаяПодчиненные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрПодразделения.Ссылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СпрПодразделения
		|ГДЕ
		|	СпрПодразделения.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				втПодразделенияВсе.Подразделение
		|			ИЗ
		|				втПодразделенияВсе КАК втПодразделенияВсе
		|			ГДЕ
		|				втПодразделенияВсе.ВключаяПодчиненные)
		|;";
		
		СоединитьДвеСтрокиМассив[0] = Запрос.Текст;
		СоединитьДвеСтрокиМассив[1] = ТекстЗапросаТаблицаПодразделений;
		Запрос.Текст = СтрСоединить(СоединитьДвеСтрокиМассив);
		
		Запрос.УстановитьПараметр("втПодразделения", ОтборПодразделение.Выгрузить());
		
	КонецЕсли;
	
	// втРецептуры
	Если ОтображениеРецептур = 0 Тогда
		// Показывать только актуальные рецептуры
		//  значит можно делать запрос к виртуальной таблице "Срез последних".
		ТекстЗапросаАктуальныеРецептуры = "ВЫБРАТЬ
		|	питАктуальныеРецептурыСрезПоследних.Рецептура КАК Рецептура,
		|	питАктуальныеРецептурыСрезПоследних.Период КАК ДатаДействияС,
		|	питАктуальныеРецептурыСрезПоследних.ДатаОкончания КАК ДатаДействияПо,
		|	питАктуальныеРецептурыСрезПоследних.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ
		|	втРецептуры
		|ИЗ
		|	РегистрСведений.питАктуальныеРецептуры.СрезПоследних(
		|			,
		|				%ОтборПоПодразделениям%
		|				%ОтборПоНоменклатуре%
		|				%ОтборВидНоменклатуры%) КАК питАктуальныеРецептурыСрезПоследних
		|СГРУППИРОВАТЬ ПО
		|	питАктуальныеРецептурыСрезПоследних.Рецептура,
		|	питАктуальныеРецептурыСрезПоследних.Период,
		|	питАктуальныеРецептурыСрезПоследних.ДатаОкончания,
		|	питАктуальныеРецептурыСрезПоследних.Номенклатура
		|;";
	Иначе
		// Показывать все рецептуры, запрос к физ таблице регистра.
		ТекстЗапросаАктуальныеРецептуры = "ВЫБРАТЬ
		|	питАктуальныеРецептурыСрезПоследних.Рецептура КАК Рецептура,
		|	питАктуальныеРецептурыСрезПоследних.Период КАК ДатаДействияС,
		|	питАктуальныеРецептурыСрезПоследних.ДатаОкончания КАК ДатаДействияПо,
		|	питАктуальныеРецептурыСрезПоследних.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ
		|	втРецептуры
		|ИЗ
		|	РегистрСведений.питАктуальныеРецептуры КАК питАктуальныеРецептурыСрезПоследних
		|%ГДЕ%
		|	%ОтборПоПодразделениям%
		|	%ОтборПоНоменклатуре%
		|	%ОтборВидНоменклатуры%
		|СГРУППИРОВАТЬ ПО
		|	питАктуальныеРецептурыСрезПоследних.Рецептура,
		|	питАктуальныеРецептурыСрезПоследних.Период,
		|	питАктуальныеРецептурыСрезПоследних.ДатаОкончания,
		|	питАктуальныеРецептурыСрезПоследних.Номенклатура
		|;";
		Если ЕстьОтборПоВидамНоменклатуры ИЛИ ЕстьОтборПономенклатуре ИЛИ ЕстьОтборПоПодразделениям Тогда
			ТекстЗапросаАктуальныеРецептуры = СтрЗаменить(ТекстЗапросаАктуальныеРецептуры, "%ГДЕ%", "ГДЕ");
		Иначе
			ТекстЗапросаАктуальныеРецептуры = СтрЗаменить(ТекстЗапросаАктуальныеРецептуры, "%ГДЕ%", "");
		КонецЕсли;
	КонецЕсли;
	СчетчикОтборов = 0;
	
	Если ЕстьОтборПоПодразделениям Тогда
		ТекстЗапросаОтбор = ?(СчетчикОтборов > 0, " И ", "");
		ТекстЗапросаОтбор = ТекстЗапросаОтбор + "
		|				Подразделение В
		|					(ВЫБРАТЬ
		|						втПодразделения.Подразделение
		|					ИЗ
		|						втПодразделения КАК втПодразделения) ";
		СчетчикОтборов = СчетчикОтборов + 1;
	Иначе
		ТекстЗапросаОтбор = "";
	КонецЕсли;
	ТекстЗапросаАктуальныеРецептуры = СтрЗаменить(ТекстЗапросаАктуальныеРецептуры, "%ОтборПоПодразделениям%", ТекстЗапросаОтбор);
	
	Если ЕстьОтборПономенклатуре Тогда
		ТекстЗапросаОтбор = ?(СчетчикОтборов > 0, " И ", "");
		ТекстЗапросаОтбор = ТекстЗапросаОтбор + "
		|				Номенклатура В
		|					(ВЫБРАТЬ
		|						втНоменклатура.Номенклатура
		|					ИЗ
		|						втНоменклатура КАК втНоменклатура) ";
		СчетчикОтборов = СчетчикОтборов + 1;
	Иначе
		ТекстЗапросаОтбор = "";
	КонецЕсли;
	ТекстЗапросаАктуальныеРецептуры = СтрЗаменить(ТекстЗапросаАктуальныеРецептуры, "%ОтборПоНоменклатуре%", ТекстЗапросаОтбор);
	
	Если НЕ ЕстьОтборПономенклатуре И ЕстьОтборПоВидамНоменклатуры Тогда
		ТекстЗапросаОтбор = ?(СчетчикОтборов > 0, " И ", "");
		ТекстЗапросаОтбор = ТекстЗапросаОтбор + "
		|				Номенклатура.ВидНоменклатуры В
		|					(ВЫБРАТЬ
		|						втВидыНоменклатуры.ВидНоменклатуры
		|					ИЗ
		|						втВидыНоменклатуры КАК втВидыНоменклатуры) ";
		СчетчикОтборов = СчетчикОтборов + 1;
	Иначе
		ТекстЗапросаОтбор = "";
	КонецЕсли;
	ТекстЗапросаАктуальныеРецептуры = СтрЗаменить(ТекстЗапросаАктуальныеРецептуры, "%ОтборВидНоменклатуры%", ТекстЗапросаОтбор);
	
	СоединитьДвеСтрокиМассив[0] = Запрос.Текст;
	СоединитьДвеСтрокиМассив[1] = ТекстЗапросаАктуальныеРецептуры;
	Запрос.Текст = СтрСоединить(СоединитьДвеСтрокиМассив);
	
	// втСпецификации
	ТекстЗапросаСпецификации = "ВЫБРАТЬ
	|	ВЫРАЗИТЬ(питТиповыеДокументы.ТиповойДокумент КАК Справочник.РесурсныеСпецификации) КАК Спецификация,
	|	ВЫРАЗИТЬ(питТиповыеДокументы.ДокументОбщепит КАК Документ.питРецептура) КАК Рецептура,
	|	ВЫБОР
	|		КОГДА питТиповыеДокументы.Синхронизирован
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Синхронизирован
	|ПОМЕСТИТЬ втСпецификации
	|ИЗ
	|	РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|ГДЕ
	|	питТиповыеДокументы.ДокументОбщепит ССЫЛКА Документ.питРецептура
	|	И питТиповыеДокументы.ТиповойДокумент ССЫЛКА Справочник.РесурсныеСпецификации
	|	И ВЫРАЗИТЬ(питТиповыеДокументы.ДокументОбщепит КАК Документ.питРецептура) В
	|			(ВЫБРАТЬ
	|				втРецептуры.Рецептура
	|			ИЗ
	|				втРецептуры КАК втРецептуры)
	|;";
	СоединитьДвеСтрокиМассив[0] = Запрос.Текст;
	СоединитьДвеСтрокиМассив[1] = ТекстЗапросаСпецификации;
	Запрос.Текст = СтрСоединить(СоединитьДвеСтрокиМассив);
	
	// Результат
	ТекстЗапросаРезультат = "ВЫБРАТЬ
	|	втРецептуры.Рецептура КАК Рецептура,
	|	втРецептуры.ДатаДействияС КАК ДатаДействияС,
	|	втРецептуры.ДатаДействияПо КАК ДатаДействияПо,
	|	втРецептуры.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(втСпецификации.Спецификация, ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)) КАК Спецификация,
	|	ЕСТЬNULL(втСпецификации.Синхронизирован, 0) КАК Синхронизирован,
	|	ВЫБОР
	|		КОГДА втСпецификации.Спецификация ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.ПустаяСсылка)
	|		ИНАЧЕ втСпецификации.Спецификация.Статус
	|	КОНЕЦ КАК СтатусСпецификации,
	|	ВЫБОР
	|		КОГДА втСпецификации.Спецификация ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ втСпецификации.Спецификация.Наименование
	|	КОНЕЦ КАК НаименованиеСпецификации,
	|	ВЫБОР
	|		КОГДА втСпецификации.Синхронизирован ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ВЫБОР
	|				КОГДА втСпецификации.Синхронизирован = 0
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ КАК ВыполнитьСинхронизацию
	|ИЗ
	|	втРецептуры КАК втРецептуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСпецификации КАК втСпецификации
	|		ПО втРецептуры.Рецептура = втСпецификации.Рецептура
	|ГДЕ
	|	втРецептуры.Рецептура.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.РецептураПриготовление)
	|%ОтборОтображениеСпецификаций%
	|УПОРЯДОЧИТЬ ПО
	|	втРецептуры.Рецептура.Дата";
	Если ОтображениеСпецификаций = 0 Тогда
		// Только требующие синхронизации
		ТекстЗапросаОтбор = " И ISNULL(втСпецификации.Синхронизирован, 0) = 0 ";
	Иначе
		// Все
		ТекстЗапросаОтбор = "";
	КонецЕсли;
	ТекстЗапросаРезультат = СтрЗаменить(ТекстЗапросаРезультат, "%ОтборОтображениеСпецификаций%", ТекстЗапросаОтбор);
	СоединитьДвеСтрокиМассив[0] = Запрос.Текст;
	СоединитьДвеСтрокиМассив[1] = ТекстЗапросаРезультат;
	Запрос.Текст = СтрСоединить(СоединитьДвеСтрокиМассив);
	
	ТаблицаРецептурСпецификаций.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

// Функция проверяет есть дубли строк в табличных частях синхронизируемых спецификаций.
//
// Возвращаемое значение:
//  Строка - Если дублей нет, вернется пустая стоке, если есть - строка с сообщением.
&НаСервере
Функция ЕстьДублиСтрокВСпецификациях()
	
	Результат = "";
	
	// Запрос по поиску дублей.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура КАК Номенклатура,
	|	РесурсныеСпецификацииМатериалыИУслуги.Характеристика КАК Характеристика,
	|	РесурсныеСпецификацииМатериалыИУслуги.Упаковка КАК Упаковка,
	|	РесурсныеСпецификацииМатериалыИУслуги.Ссылка.Представление КАК Представление,
	|	СУММА(1) КАК Дубли,
	|	РесурсныеСпецификацииМатериалыИУслуги.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втМатериалы
	|ИЗ
	|	Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК РесурсныеСпецификацииМатериалыИУслуги
	|ГДЕ
	|	РесурсныеСпецификацииМатериалыИУслуги.Ссылка В(&МассивСпецификаций)
	|
	|СГРУППИРОВАТЬ ПО
	|	РесурсныеСпецификацииМатериалыИУслуги.Упаковка,
	|	РесурсныеСпецификацииМатериалыИУслуги.Номенклатура,
	|	РесурсныеСпецификацииМатериалыИУслуги.Характеристика,
	|	РесурсныеСпецификацииМатериалыИУслуги.Ссылка.Представление,
	|	РесурсныеСпецификацииМатериалыИУслуги.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РесурсныеСпецификацииТрудозатраты.ВидРабот КАК ВидРабот,
	|	РесурсныеСпецификацииТрудозатраты.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	РесурсныеСпецификацииТрудозатраты.Ссылка.Представление КАК Представление,
	|	СУММА(1) КАК Дубли,
	|	РесурсныеСпецификацииТрудозатраты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втТрудозатраты
	|ИЗ
	|	Справочник.РесурсныеСпецификации.Трудозатраты КАК РесурсныеСпецификацииТрудозатраты
	|ГДЕ
	|	РесурсныеСпецификацииТрудозатраты.Ссылка В(&МассивСпецификаций)
	|
	|СГРУППИРОВАТЬ ПО
	|	РесурсныеСпецификацииТрудозатраты.ВидРабот,
	|	РесурсныеСпецификацииТрудозатраты.СтатьяКалькуляции,
	|	РесурсныеСпецификацииТрудозатраты.Ссылка.Представление,
	|	РесурсныеСпецификацииТрудозатраты.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РесурсныеСпецификацииВозвратныеОтходы.Номенклатура КАК Номенклатура,
	|	РесурсныеСпецификацииВозвратныеОтходы.Характеристика КАК Характеристика,
	|	РесурсныеСпецификацииВозвратныеОтходы.Упаковка КАК Упаковка,
	|	СУММА(1) КАК Дубли,
	|	РесурсныеСпецификацииВозвратныеОтходы.Ссылка.Представление КАК Представление,
	|	РесурсныеСпецификацииВозвратныеОтходы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втПобочные
	|ИЗ
	|	Справочник.РесурсныеСпецификации.ВозвратныеОтходы КАК РесурсныеСпецификацииВозвратныеОтходы
	|ГДЕ
	|	РесурсныеСпецификацииВозвратныеОтходы.Ссылка В(&МассивСпецификаций)
	|
	|СГРУППИРОВАТЬ ПО
	|	РесурсныеСпецификацииВозвратныеОтходы.Характеристика,
	|	РесурсныеСпецификацииВозвратныеОтходы.Упаковка,
	|	РесурсныеСпецификацииВозвратныеОтходы.Номенклатура,
	|	РесурсныеСпецификацииВозвратныеОтходы.Ссылка.Представление,
	|	РесурсныеСпецификацииВозвратныеОтходы.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втМатериалы.Представление КАК Представление,
	|	втМатериалы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втРезультат
	|ИЗ
	|	втМатериалы КАК втМатериалы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втТрудозатраты.Представление,
	|	втТрудозатраты.Ссылка
	|ИЗ
	|	втТрудозатраты КАК втТрудозатраты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втПобочные.Представление,
	|	втПобочные.Ссылка
	|ИЗ
	|	втПобочные КАК втПобочные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втРезультат.Представление КАК Представление,
	|	втРезультат.Ссылка КАК Ссылка
	|ИЗ
	|	втРезультат КАК втРезультат
	|
	|СГРУППИРОВАТЬ ПО
	|	втРезультат.Представление,
	|	втРезультат.Ссылка";
	
	// Массив спецификаций, в котором ищем дубли.
	МассивСпецификаций = Новый Массив;
	НайденныеСтроки = ТаблицаРецептурСпецификаций.НайтиСтроки(Новый Структура("ВыполнитьСинхронизацию", Истина));
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		МассивСпецификаций.Добавить(ТекСтрока.Спецификация);
	КонецЦикла;
	Запрос.УстановитьПараметр("МассивСпецификаций", МассивСпецификаций);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		// Дубли найдены. Заполнение сообщения с результатом.
		Результат = Результат + "
		| Для следующих спецификаций существуют дубли строк в таблицах. При синхронизации дубли, отсутствующие в рецептуре будут удалены. Продолжить?";
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Результат = Результат + "
			| <"+ВыборкаДетальныеЗаписи.Представление+">";
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура сворачивает или разворачивает панель отборов.
//
&НаКлиенте
Процедура СвернутьРазвернутьНастройки()
	НовоеЗначениеВидимость = НЕ Элементы.ГруппаНастройки.Видимость;
	Элементы.ГруппаНастройки.Видимость	= НовоеЗначениеВидимость;
	Элементы.ГруппаРазделитель.Видимость = Не НовоеЗначениеВидимость;
	Элементы.ГруппаНастройки.Ширина = ?(НовоеЗначениеВидимость, 23, 0);	
КонецПроцедуры

// Процедура сохранения настроек отборов.
//
&НаСервере
Процедура СохранитьНастройки()
	
	Настройки = Новый Структура("ОтображениеРецептур, ОтображениеСпецификаций, ОтборВидНоменклатуры, ОтборНоменклатура, ОтборПодразделение");
	Настройки.ОтображениеРецептур		= ОтображениеРецептур;
	Настройки.ОтображениеСпецификаций	= ОтображениеСпецификаций;
	Настройки.ОтборВидНоменклатуры		= ОтборВидНоменклатуры.Выгрузить();
	Настройки.ОтборНоменклатура			= ОтборНоменклатура.Выгрузить();
	Настройки.ОтборПодразделение		= ОтборПодразделение.Выгрузить();
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("Обработка.питСинхронизацияРецептурИСпецификаций", "Основная", Настройки);
	
КонецПроцедуры

// Процедура восстановления настроек отборов.
//
&НаСервере
Процедура ВосстановитьНастройки()
	
	ЗначениеНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Обработка.питСинхронизацияРецептурИСпецификаций", "Основная");
	
	Если ТипЗнч(ЗначениеНастроек) = Тип("Структура") Тогда
		
		ЭтаФорма.ОтображениеРецептур		= ЗначениеНастроек.ОтображениеРецептур;
		ЭтаФорма.ОтображениеСпецификаций	= ЗначениеНастроек.ОтображениеСпецификаций;
		ЭтаФорма.ОтборВидНоменклатуры.Загрузить(ЗначениеНастроек.ОтборВидНоменклатуры);
		ЭтаФорма.ОтборНоменклатура.Загрузить(ЗначениеНастроек.ОтборНоменклатура);
		ЭтаФорма.ОтборПодразделение.Загрузить(ЗначениеНастроек.ОтборПодразделение);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура установки отборов по умолчанию.
//
&НаСервере
Процедура УстановитьНастройкиПоУмолчанию()
	
	ЭтаФорма.ОтображениеРецептур		= 0;
	ЭтаФорма.ОтображениеСпецификаций	= 0;
	ЭтаФорма.ОтборВидНоменклатуры.Очистить();
	ЭтаФорма.ОтборНоменклатура.Очистить();
	ЭтаФорма.ОтборПодразделение.Очистить();
	
КонецПроцедуры

#КонецОбласти




