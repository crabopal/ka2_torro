// Функция - Доступные типы обеспечения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДоступныеТипыОбеспечения(КлючНазначенияИспользования) Экспорт
	
	Результат = Обработки.ОбеспечениеПотребностей.ДоступныеТипыОбеспечения(КлючНазначенияИспользования);
	
	Если НЕ Результат = Неопределено Тогда
		
		ЕстьОграничения = Ложь;
		
		Результат.Очистить();
		
		ЕстьДоступПроизводство = ПравоДоступа("Добавление", Метаданные.Документы.питПланМеню)
		И ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2");
		Если ЕстьДоступПроизводство Тогда
			Результат.Добавить(Перечисления.ТипыОбеспечения.Производство);
		Иначе
			ЕстьОграничения = Истина;
		КонецЕсли;
		
		Если НЕ ЕстьОграничения Тогда
			Результат = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// %ИзЕРП%
//  Обработки.ОбеспечениеПотребностей.ПоляТаблицыЗаказы
//  Возвращает структуру с описанием полей таблицы потребностей по заказам.
//
// Параметры:
//  Секции - Строка - Определяет блоки полей, возможные значения: "СвойстваПотребности", "РеквизитыЗаказаКОбеспечению.
//
// Возвращаемое значение:
//  Структура - свойство структуры - имя поля, значение свойства - тип поля.
Функция ПоляТаблицыЗаказы(Секции) Экспорт
	
	Поля = Обработки.ОбеспечениеПотребностей.ПоляТаблицыЗаказы(Секции);
	
	Если СтрНайти(Секции, "питРеквизиты") Тогда
		
		Если НЕ Поля.Свойство("Номенклатура") Тогда
			Поля.Вставить("Номенклатура",      Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("Характеристика") Тогда
			Поля.Вставить("Характеристика",      Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("Склад") Тогда
			Поля.Вставить("Склад",      Новый ОписаниеТипов("СправочникСсылка.Склады"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("Организация") Тогда
			Поля.Вставить("Организация",      Новый ОписаниеТипов("СправочникСсылка.Организации"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("Подразделение") Тогда
			Поля.Вставить("Подразделение",      Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("ЦеховаяКладовая") Тогда
			Поля.Вставить("ЦеховаяКладовая",      Новый ОписаниеТипов("СправочникСсылка.Склады"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("СкладМатериалов") Тогда
			Поля.Вставить("СкладМатериалов",      Новый ОписаниеТипов("СправочникСсылка.Склады"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("Назначение") Тогда
			Поля.Вставить("Назначение",      Новый ОписаниеТипов("СправочникСсылка.Назначения"));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("ДатаПоставки") Тогда
			Поля.Вставить("ДатаПоставки",      ОбщегоНазначенияУТ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
		КонецЕсли;
		
		Если НЕ Поля.Свойство("ЕдиницаИзмерения") Тогда
			Поля.Вставить("ЕдиницаИзмерения",      Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
		КонецЕсли;
		
		Если Поля.Свойство("Заказ") Тогда
			
			// Расширяем тип поля "Заказ".
			Массив = Новый Массив;
			Массив.Добавить(Тип("ДокументСсылка.питПланМеню"));
			Поля.Заказ = Новый ОписаниеТипов(Поля.Заказ, Массив);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Поля
	
КонецФункции

