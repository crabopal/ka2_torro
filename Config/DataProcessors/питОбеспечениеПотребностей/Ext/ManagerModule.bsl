// %ИзЕРП
//  Обработки.ОбеспечениеПотребностей.ПолучитьДокумент
//  Заполняет и проводит документ созданный обработкой.
//
// Параметры:
//  МенеджерДокументов - ДокументМенеджер - программный объект, менеджер документа.
//  ДанныеЗаполнения - Структура - Структура содержащая значения реквизитов и табличные части для заполнения документа,
//   Статус - ПеречислениеСсылка.СтатусыВнутреннмихЗаказов, ПеречислениеСсылка.СтатусыЗаказовНаПеремещение,
//   ПеречислениеСсылка.СтатусыЗаказовПоставщикам - статус, в котором необходимо провести докумен.
//  Статус - Произвольный - Статус.
//
// Возвращаемое значение:
//   ДокументОбъект.ЗаказПоставщику     - Проведенный заказ, созданный обработкой.
//   ДокументОбъект.ЗаказНаСборку       - Проведенный заказ, созданный обработкой.
//   ДокументОбъект.ЗаказНаПеремещение  - Проведенный заказ, созданный обработкой.
Функция ПолучитьДокумент(МенеджерДокументов, ДанныеЗаполнения, Статус = Неопределено) Экспорт
	
	ДокументОбъект = МенеджерДокументов.СоздатьДокумент();
	ДанныеЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());
	
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	Возврат ДокументОбъект;
	
КонецФункции

// %ИзЕРП
//  Обработки.ОбеспечениеПотребностей.ТаблицаЗаказыНаПроизводство2_2КОформлению
//  Функция выбирает данные для создания документов "План-меню".
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
&НаСервере
Функция ТаблицаПланыМенюКОформлению() Экспорт
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Т.питОрганизация                          КАК Организация,
		|	Т.питПодразделение                        КАК Подразделение,
		|	Т.питЦеховаяКладовая                      КАК ЦеховаяКладовая,
		|	Т.ДатаПоставки                            КАК ДатаПлан,
		|	Т.питСкладМатериалов                      КАК Склад,
		|	Т.Склад                                   КАК СкладРеализации,
		|	Т.Номенклатура                            КАК Номенклатура,
		|	Т.питЕдиницаИзмерения                     КАК Упаковка,
		|	Т.Характеристика                          КАК Характеристика,
		|	Т.Назначение                              КАК Назначение,
		|	Т.питЗаказ                                КАК Заказ,
		|	СУММА(Т.Количество)                       КАК КоличествоУпаковок,
		|	СУММА(Т.Количество)                       КАК Количество
		|ИЗ
		|	ВтДанныеЗаполнения КАК Т
		|ГДЕ
		|	Т.ТипОбеспечения = ЗНАЧЕНИЕ(Перечисление.ТипыОбеспечения.питПроизводство)
		// +питКА
		|	%ОтборЗаказДавальца%
		// -питКА
		|СГРУППИРОВАТЬ ПО
		|	Т.питОрганизация, Т.питПодразделение, Т.питЦеховаяКладовая, Т.питСкладМатериалов,
		|	 Т.ДатаПоставки,
		|	Т.Назначение, Т.питЗаказ, Т.Номенклатура, Т.Характеристика, Т.Склад, Т.питЕдиницаИзмерения
		|УПОРЯДОЧИТЬ ПО
		|	Организация, Подразделение, ДатаПлан, // порядок обхода заказов
		|	Назначение, Номенклатура, Характеристика  // порядок строк в заказе
		|;
		|
		|/////////////////////////////////////////////////////////
		|";
		
	// +питКА
	Если питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "УправлениеПредприятием" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборЗаказДавальца%", "И (НЕ Т.Заказ ССЫЛКА Документ.ЗаказДавальца И &УправлениеПроизводством2_2)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборЗаказДавальца%", "");
	КонецЕсли;
	// -питКА
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

// +пит

//  Процедура дополняет таблицу потребностей отраслевыми колонками
//
// Параметры:
//  ТаблицаПотребностей - ТаблицаЗначений - Типовая таблица потребностей, сформированная методо.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ДополнитьТаблицуПотребностей(ТаблицаПотребностей) Экспорт
	
	// +пит
	ДополнитьТипыКолонокТаблицыПотребностей(ТаблицаПотребностей);
	// -пит
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ *
	|ПОМЕСТИТЬ втТаблицаПотребностей
	|ИЗ
	|	&втПотребности КАК втПотребности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблицаПотребностей.*,
	|	втТаблицаПотребностей.Склад КАК Склад1,
	|	втТаблицаПотребностей.ДатаПоставки КАК ДатаПоставки1,
	|	СпособыОбеспеченияПотребностей.Организация,
	|	СпособыОбеспеченияПотребностей.Подразделение,
	|	СпособыОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей КАК ЦеховаяКладовая,
	|	СпособыОбеспеченияПотребностей.Организация КАК Организация1,
	|	СпособыОбеспеченияПотребностей.Подразделение КАК Подразделение1,
	|	СпособыОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей КАК ЦеховаяКладовая1,
	|	СпособыОбеспеченияПотребностей.питСкладМатериалов КАК СкладМатериалов,
	|	СпособыОбеспеченияПотребностей.питСкладМатериалов КАК СкладМатериалов1,
	|	СпособыОбеспеченияПотребностей.СрокИсполненияЗаказа КАК питСрокИсполненияПланаМеню
	|ИЗ
	|	втТаблицаПотребностей КАК втТаблицаПотребностей
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыОбеспеченияПотребностей КАК СпособыОбеспеченияПотребностей
	|		ПО втТаблицаПотребностей.СпособОбеспечения = СпособыОбеспеченияПотребностей.Ссылка";
	
	Запрос.УстановитьПараметр("втПотребности", ТаблицаПотребностей);
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	// Добавим колонку "ИдентификаторСтроки"
	КС = Новый КвалификаторыСтроки(36);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	ТаблицаРезультат.Колонки.Добавить("ИдентификаторСтроки", ОписаниеТиповС);
	
	Рецептура = Неопределено;
	Для каждого ТекСтрокаТаблицы Из ТаблицаРезультат Цикл
		
		// По умолчанию планы-меню создаются на завтра.
		Если НЕ ЗначениеЗаполнено(ТекСтрокаТаблицы.ДатаПоставки) Тогда
			ТекСтрокаТаблицы.ДатаПоставки = КонецДня(ТекущаяДата()) + 1;
		Иначе
			// Из вычисленной даты поставки вычитаем срок производства, чтобы успеть вовремя приготовить блюда.
			ТекСтрокаТаблицы.ДатаПоставки = Макс(НачалоДня(ТекущаяДата()), ТекСтрокаТаблицы.ДатаПоставки - 86400 * ТекСтрокаТаблицы.питСрокИсполненияПланаМеню);
		КонецЕсли;
		
		// Если цеховая кладовая не определена в способе обеспечения, попытаемся найти ее из рецептуры
		Если НЕ ЗначениеЗаполнено(ТекСтрокаТаблицы.ЦеховаяКладовая) Тогда
			
			Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекСтрокаТаблицы.Номенклатура,ТекСтрокаТаблицы.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
			?(ЗначениеЗаполнено(ТекСтрокаТаблицы.ДатаПоставки), ТекСтрокаТаблицы.ДатаПоставки, Неопределено), , , ТекСтрокаТаблицы.Организация,,,ТекСтрокаТаблицы.Подразделение);
			
			Если ЗначениеЗаполнено(Рецептура) Тогда
				ТекСтрокаТаблицы.ЦеховаяКладовая = питОбщегоНазначения.ЗначениеРеквизитаОбъекта(Рецептура,"ЦеховаяКладовая");
				ТекСтрокаТаблицы.ЦеховаяКладовая1 = ТекСтрокаТаблицы.ЦеховаяКладовая;
				Рецептура = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		ТекСтрокаТаблицы.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
	
КонецФункции
// -пит

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// +пит

// Процедура - Дополнить типы колонок таблицы потребностей
//
// Параметры:
//  ТаблицаПотребностей	 - ТаблицаЗначений	 - Таблица потребностей.
//
Процедура ДополнитьТипыКолонокТаблицыПотребностей(ТаблицаПотребностей)
	
	ТипыКолонок = Новый Соответствие;
	ТипыКолонок.Вставить("Отметка", Новый ОписаниеТипов("Булево"));
	ТипыКолонок.Вставить("КЗаказу", Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("ДатаЗаказаНаступила", Новый ОписаниеТипов("Булево"));
	ТипыКолонок.Вставить("ОтгрузкаВнутриПериода", Новый ОписаниеТипов("Булево"));
	Для каждого ТипКолонкиСоответствие Из ТипыКолонок Цикл
		
		ТекКолонка = ТаблицаПотребностей.Колонки.Найти(ТипКолонкиСоответствие.Ключ);
		Если ТекКолонка = Неопределено Тогда
			//ОбщегоНазначения.СообщитьПользователю("Не найдена колонка """ + ТипКолонкиСоответствие.Ключ + """ таблицы потребностей");
			Продолжить;
		КонецЕсли;
		
		// Новый тип колонки.
		ТипКолонки = ТипКолонкиСоответствие.Значение;
		
		// Запоминаем параметры колонки.
		ИмяКолонки = ТекКолонка.Имя;
		ЗаголовокКолонки = ТекКолонка.Заголовок;
		
		// Удаление старой колонки.
		ЗначенияКолонки = ТаблицаПотребностей.ВыгрузитьКолонку(ТекКолонка.Имя);
		ТаблицаПотребностей.Колонки.Удалить(ТекКолонка);
		
		// Добавление новой колонки.
		НоваяКолонка = ТаблицаПотребностей.Колонки.Добавить(ИмяКолонки, ТипКолонки, ЗаголовокКолонки);
		ТаблицаПотребностей.ЗагрузитьКолонку(ЗначенияКолонки, НоваяКолонка);
		
	КонецЦикла;
	
КонецПроцедуры
// -пит

#КонецОбласти

#КонецЕсли
