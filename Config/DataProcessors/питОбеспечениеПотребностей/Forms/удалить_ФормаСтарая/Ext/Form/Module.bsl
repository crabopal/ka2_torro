	КонецЕсли;

	Поставка.ДатаПоставки = '00010101';

	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Истина);

