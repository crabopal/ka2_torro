&НаКлиенте
Процедура ИсточникОбеспеченияЗаказыПриИзменении(Элемент)
	
	// +пит Необходимо актуализировать связанные данные
	питЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область Общепит

// Дерево "ДеревоЗаказыКОбеспечению" отображает данные в 2 уровня:
// на верхнем уровне планы-меню, которые будут оформлены;
// на нижнем - строки заказов, которые попадут в планы-меню.
// Данное дерево синхронизируется с ТЗ "ЗаказыКОбеспечению"
// по которой далее и происходит формирование планов меню.
#Область ДеревоЗаказыКОбеспечению

#Область ДеревоЗаказыКОбеспечениюСлужебныеПроцедурыИФункции

// Процедура актуализирует связанные с ТЧ "ЗаказыКОбеспечению" данные при изменении ее измерений.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент)
	
	// Текущие данные.
	Поставка = Элементы.ДеревоЗаказыКОбеспечению.ТекущиеДанные;
	
	// Текущий идентификатор строки. Может измениться, если строка будет перенесена.
	ТекИдентификатор = Поставка.ПолучитьИдентификатор();
	
	Если НЕ Поставка = Неопределено Тогда
		
		Если ПустаяСтрока(Поставка.Группировка) Тогда
			// Если это строка заказов.
			
			// Имена колонок группировок.
			ИменаКолонокГруппировки = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0);
			ИменаКолонокРесурсы = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(2);
			ИменаКолонокГруппировкаСтрокой = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
			КлючиГруппировкиСтруктура = Новый Структура(ИменаКолонокГруппировкаСтрокой);
			ЗаполнитьЗначенияСвойств(КлючиГруппировкиСтруктура, Поставка);
			
			ИмяКолонкиДереваЗначений = СтрЗаменить(Элемент.Имя,"ДеревоЗаказыКОбеспечению","");
			Если НЕ ИменаКолонокГруппировки.Найти(ИмяКолонкиДереваЗначений) = Неопределено 
				И Поставка[ИмяКолонкиДереваЗначений] <> Поставка[ИмяКолонкиДереваЗначений+"1"] Тогда
				// Если было изменено значение колонки, и эта колонка входит в колонки группировки, то
				// такая строка будет перенесена в другую группировку с соответствующими значениями колонок.
				
				// Актуализируем значение дублирующей колонки.
				Поставка[ИмяКолонкиДереваЗначений+"1"] = Поставка[ИмяКолонкиДереваЗначений];
				
				// Поиск нового родителя.
				НоваяСтрокаГруппировки = Неопределено;
				Для каждого ТекГруппировкаДерева Из ДеревоЗаказыКОбеспечению.ПолучитьЭлементы() Цикл
					СтрокаГруппировкиНайдена = Истина;
					Для каждого ТекИмяКолонкиТовары Из ИменаКолонокГруппировки Цикл
						Если ТекГруппировкаДерева[ТекИмяКолонкиТовары] <> Поставка[ТекИмяКолонкиТовары] Тогда
							СтрокаГруппировкиНайдена = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если СтрокаГруппировкиНайдена Тогда
						НоваяСтрокаГруппировки = ТекГруппировкаДерева;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				// Добавляем новую строку группировки, если она не была найдена.
				Если НоваяСтрокаГруппировки = Неопределено Тогда
					НоваяСтрокаГруппировки = ДеревоЗаказыКОбеспечению.ПолучитьЭлементы().Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаГруппировки, Поставка, ИменаКолонокГруппировкаСтрокой);
					НоваяСтрокаГруппировки.КартинкаПриоритета = 1;
					НоваяСтрокаГруппировки.Группировка = питПолучитьПредставлениеГруппировкиДереваДокументов(КлючиГруппировкиСтруктура, ТекстНеЗаполнено, питМаксНомерПлана);
				КонецЕсли;
				
				// Добавляем новую строку заказа, переносим в нее все данные из старой строки.
				НоваяСтрокаТоваров = НоваяСтрокаГруппировки.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, Поставка);
				
				// Актуализируем значение идентификатора строки.
				ТекИдентификатор = НоваяСтрокаТоваров.ПолучитьИдентификатор();
				
				// Пересчет ресурсов новой строки группировки.
				Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
					НоваяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = 0;
				КонецЦикла;
				Для каждого ТекСтрокаНовойГруппировки Из НоваяСтрокаГруппировки.ПолучитьЭлементы() Цикл
					Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
						НоваяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = НоваяСтрокаГруппировки[ТекИмяКолонкиРесурсы] + ТекСтрокаНовойГруппировки[ТекИмяКолонкиРесурсы];
					КонецЦикла;
				КонецЦикла;
				
				// Удаление старой строки заказа.
				СтараяСтрокаТоваров = ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(Поставка.ПолучитьИдентификатор());
				СтараяСтрокаГруппировки = СтараяСтрокаТоваров.ПолучитьРодителя();
				СтараяСтрокаГруппировки.ПолучитьЭлементы().Удалить(СтараяСтрокаТоваров);
				// Если в верхней группировке не осталось элементов - удаляем верхнюю группировку.
				Если НЕ СтараяСтрокаГруппировки.ПолучитьЭлементы().Количество() Тогда
					ДеревоЗаказыКОбеспечению.ПолучитьЭлементы().Удалить(СтараяСтрокаГруппировки);
				Иначе // Пересчитаем ресурсы старой группировки.
					// Пересчет ресурсов новой строки группировки.
					Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
						СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = 0;
					КонецЦикла;
					Для каждого ТекСтрокаСтаройГруппировки Из СтараяСтрокаГруппировки.ПолучитьЭлементы() Цикл
						Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
							Если ТекИмяКолонкиРесурсы = "КЗаказу" И НЕ ТекСтрокаСтаройГруппировки.Отметка Тогда
								Продолжить;
							КонецЕсли;
							СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] + ТекСтрокаСтаройГруппировки[ТекИмяКолонкиРесурсы];
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;
				
				// Развернуть группировку после всех изменений.
				Элементы.ДеревоЗаказыКОбеспечению.Развернуть(НоваяСтрокаГруппировки.ПолучитьИдентификатор());
				
			Иначе // Изменение не повлияло на группировки
				
				// Пересчитаем ресурсы старой группировки.
				СтараяСтрокаТоваров = ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ТекИдентификатор);
				Если НЕ СтараяСтрокаТоваров = Неопределено Тогда
					СтараяСтрокаГруппировки = СтараяСтрокаТоваров.ПолучитьРодителя();
					// Пересчет ресурсов новой строки группировки.
					Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
						СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = 0;
					КонецЦикла;
					Для каждого ТекСтрокаСтаройГруппировки Из СтараяСтрокаГруппировки.ПолучитьЭлементы() Цикл
						Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
							Если ТекИмяКолонкиРесурсы = "КЗаказу" И НЕ ТекСтрокаСтаройГруппировки.Отметка Тогда
								Продолжить;
							КонецЕсли;
							СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] + ТекСтрокаСтаройГруппировки[ТекИмяКолонкиРесурсы];
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
			
			// Актуализировать исходную таблицу "ЗаказыКОформлению".
			питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(ТекИдентификатор);
			
		Иначе // Изменили что-то на верхнем уровене(план-меню).
			
			// Перенесем изменение на уровень ниже.
			СтараяСтрокаГруппировки = ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ТекИдентификатор);
			Если НЕ СтараяСтрокаГруппировки = Неопределено Тогда
				
				ИменаКолонокГруппировка			= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
				ИменаКолонокГруппировкаМассив	= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0);
				СтарыеСтрокиТоваров = СтараяСтрокаГруппировки.ПолучитьЭлементы();
				Для каждого ТекСтараяСтрокаТоваров Из СтарыеСтрокиТоваров Цикл
					ЗаполнитьЗначенияСвойств(ТекСтараяСтрокаТоваров, СтараяСтрокаГруппировки, ИменаКолонокГруппировка);
					Для каждого ТекИмяКолонкиГруппировки Из ИменаКолонокГруппировкаМассив Цикл
						ТекСтараяСтрокаТоваров[ТекИмяКолонкиГруппировки+"1"] = ТекСтараяСтрокаТоваров[ТекИмяКолонкиГруппировки];
					КонецЦикла;
					
					// Актуализировать исходную таблицу "ЗаказыКОформлению".
					питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(ТекСтараяСтрокаТоваров.ПолучитьИдентификатор());
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Меянем фокус текущей строки после всех изменений.
	Элементы.ДеревоЗаказыКОбеспечению.ТекущаяСтрока = ТекИдентификатор;
	
КонецПроцедуры

#КонецОбласти

#Область ДеревоЗаказыКОбеспечениюПеретаскивание

// Процедура осуществляет действия с деревом заказов после окончания перетаскивания.
//
// Параметры:
//  Элемент - ТаблицаФормы - Таблица формы.
//  ПараметрыПеретаскивания - ПараметрыПеретаскивания - Параметры перетаскивания.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	СтрокиГруппировки = ДеревоЗаказыКОбеспечению.ПолучитьЭлементы();
	
	// Пересчет ресурсов дерева.
	питДеревоЗаказыКОбеспечениюПересчитатьРесурсы();
	
	// Удаление пустых строк планов-меню.
	питДеревоЗаказыКОбеспечениюУдалитьПустыеСтрокиПлановМеню();
	
	// Актуализация связанной строки ТЧ "ЗаказыКОбеспечению".
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") 
		И ПараметрыПеретаскивания.Значение.Количество() Тогда
		
		ПеренесенныеСтроки = ПараметрыПеретаскивания.Значение;
		
		// Получение новой строки дерева значений из параметров перетаскивания.
		Для каждого ПеренесеннаяСтрока Из ПеренесенныеСтроки Цикл
			
			// Получение этой же строки в дереве значений.
			ЭлементВДереве = Неопределено;
			Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
				Для каждого СтрокаТоваров Из СтрокаГруппировки.ПолучитьЭлементы() Цикл
					Если СтрокаТоваров.ИдентификаторСтроки = ПеренесеннаяСтрока.ИдентификаторСтроки Тогда
						ЭлементВДереве = СтрокаТоваров;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ ЭлементВДереве = Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЭлементВДереве = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Актуализировать исходную таблицу "ЗаказыКОформлению".
			питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(СтрокаТоваров.ПолучитьИдентификатор());
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура осуществляет действия по перетаскиванию строки дерева заказов.
//
// Параметры:
//  Элемент - ТаблицаФормы - Таблица формы.
//  ПараметрыПеретаскивания - ПараметрыПеретаскивания - Параметры перетаскивания.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//  Строка - Строка - Идентификатор строки нового родителя.
//  Поле - ПолеФормы - Поле, с которым связана данная колонка таблицы, над которой находится объект.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	// Текущие данные.
	ТекДанные = Элемент.ТекущиеДанные;
	
	// Для множественного переноса.
	ВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	
	СтрокиДляУдаления = Новый Массив;
	
	// Если текущие данные найдены.
	Если НЕ ТекДанные = Неопределено Тогда
		
		// Перетаскивать будем вручную, без стандартной обработки, т.к. она не предусматривает множественное перетаскивание.
		СтандартнаяОбработка = Ложь;
		
		Для каждого ТекВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			
			// Идентификатор строки, которую перетаскиваем.
			ТекИдентификатор = ТекВыделеннаяСтрока;
			
			// Строка, которую перетаскиваем.
			ТекСтрока					= ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ТекИдентификатор);
			
			// Строка, в которую перетаскиваем.
			НовыйРодитель				= ?(Строка = Неопределено, Неопределено, ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(Строка));
			
			// Строка, из которой перетаскиваем.
			СтарыйРодитель				= ?(ТекСтрока = Неопределено, Неопределено, ТекСтрока.ПолучитьРодителя());
			
			// Имена неизменяемых колонок верхнего уровня.
			ИменаНеИзменяемыхКолонок	= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(4);
			СообщениеОбОшибке = "";
			ЕстьРазличияВНеизменяемыхКолонках = Ложь;
			Если НЕ НовыйРодитель = Неопределено И НЕ СтарыйРодитель = Неопределено Тогда
				Для каждого ТекНеИзмКолонка Из ИменаНеИзменяемыхКолонок Цикл
					Если НовыйРодитель[ТекНеИзмКолонка] <> СтарыйРодитель[ТекНеИзмКолонка] Тогда
						ЕстьРазличияВНеизменяемыхКолонках = Истина;
						СообщениеОбОшибке = "Не удалось перенести строку по причине:
						| Колонка """+ТекНеИзмКолонка+""" для "+СтарыйРодитель.Группировка+" имеет значение "+СтарыйРодитель[ТекНеИзмКолонка]+",
						| а для "+НовыйРодитель.Группировка+" имеет значение "+НовыйРодитель[ТекНеИзмКолонка]+" ! ";
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Определим, расрешено ли перетаскивание.
			СтарыйРодительЭтоКорень		= СтарыйРодитель = Неопределено;
			НовыйРодительЭтоЗаказ		= ?(НовыйРодитель = Неопределено, Неопределено, ПустаяСтрока(НовыйРодитель.Группировка));
			Если НовыйРодительЭтоЗаказ = Истина Тогда
				НовыйРодитель = НовыйРодитель.ПолучитьРодителя();
				НовыйРодительЭтоЗаказ		= ?(НовыйРодитель = Неопределено, Неопределено, ПустаяСтрока(НовыйРодитель.Группировка));
				Если НЕ НовыйРодитель = Неопределено Тогда
					Строка = НовыйРодитель.ПолучитьИдентификатор();
				КонецЕсли;
			КонецЕсли;
			
			ТекСтрокаЭтоПланМеню		= ?(ТекСтрока = Неопределено, Неопределено, НЕ ПустаяСтрока(ТекСтрока.Группировка));
			
			ПеретаскиваниеЗапрещено = СтарыйРодительЭтоКорень 
			ИЛИ НЕ(НовыйРодительЭтоЗаказ = Ложь) 
			ИЛИ НЕ(ТекСтрокаЭтоПланМеню = Ложь) 
			ИЛИ ЕстьРазличияВНеизменяемыхКолонках;
			
			Если ЕстьРазличияВНеизменяемыхКолонках Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке);
			КонецЕсли;
			
			// Запрет перетаскивания
			Если ПеретаскиваниеЗапрещено Тогда
				Продолжить;
			КонецЕсли;
			
			// Имена колонок, которые необходимо перезаполнить.
			ИменаКолонокГруппировка		= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
			// Имена колонок массивом.
			ИменаКолонокГруппировкаМассив		= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0);
			
			Если НЕ ТекСтрока = Неопределено И НЕ НовыйРодитель = Неопределено Тогда
				
				// !!!
				// У текущей строки меняем поля группировки на те, что у нового родителя.
				ЗаполнитьЗначенияСвойств(ТекСтрока, НовыйРодитель, ИменаКолонокГруппировка);
				Для каждого ТекИмяКолонкиГруппровки Из ИменаКолонокГруппировкаМассив Цикл
					ТекСтрока[ТекИмяКолонкиГруппровки+"1"] = ТекСтрока[ТекИмяКолонкиГруппровки];
				КонецЦикла;
				
				НовСтрока = НовыйРодитель.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
				
				Если НЕ СтарыйРодитель = Неопределено Тогда
					Попытка
						СтрокиДляУдаления.Добавить(ТекСтрока);
					Исключение
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого ТекСтрокаДляУдаления Из СтрокиДляУдаления Цикл
			ТекСтрокаДляУдаления.ПолучитьРодителя().ПолучитьЭлементы().Удалить(ТекСтрокаДляУдаления);
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ДеревоЗаказыКОбеспечениюСобытияЭлементов

//  Процедура - Дерево заказы к обеспечению перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению к заказу при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюКЗаказуПриИзменении(Элемент)
	
	БылиИзменения = Ложь;
	
	Поставка = Элементы.ДеревоЗаказыКОбеспечению.ТекущиеДанные;
	
	Если НЕ Поставка = Неопределено Тогда
		
		СтараяОтметка = Поставка.Отметка;
		
		Если ПустаяСтрока(Поставка.Группировка) Тогда
			
			Если Элемент = Элементы.ДеревоЗаказыКОбеспечениюКЗаказу Тогда
				Поставка.Отметка = Поставка.КЗаказу > 0;
			КонецЕсли;
			
			Поставка.Округлено	= Поставка.КЗаказу;
			ТекИдентификатор	= Поставка.ПолучитьИдентификатор();
			
		КонецЕсли;
		
		БылиИзменения = Истина;
		
	КонецЕсли;
	
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
	
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	Если БылиИзменения И (СтараяОтметка <> Поставка.Отметка ИЛИ Элемент = Элементы.ДеревоЗаказыКОбеспечениюОтметка) И ФильтрОтметкаЗаказы Тогда
		питОтборДеревоЗаказы();
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению дата поставки очистка.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюДатаПоставкиОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению дата поставки обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюДатаПоставкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Установим выбранное значение.
	Поставка = Элементы.ДеревоЗаказыКОбеспечению.ТекущиеДанные;
	Если НЕ Поставка = Неопределено Тогда
		Поставка.ДатаПоставки = ВыбранноеЗначение;
	КонецЕсли;
	
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
	
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	Если ЗначениеЗаполнено(ФильтрКЗаказуНеПозднее) ИЛИ ЗначениеЗаполнено(ФильтрКОтгрузкеНеПозднее) Тогда
		питОтборДеревоЗаказы();
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению дата поставки при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюДатаПоставкиПриИзменении(Элемент)
	
	// Текущие данные.
	Поставка = Элементы.ДеревоЗаказыКОбеспечению.ТекущиеДанные;
	Если НЕ Поставка = Неопределено Тогда
		Если Поставка[СтрЗаменить(Элемент.Имя,"ДеревоЗаказыКОбеспечению","")] <> Поставка[СтрЗаменить(Элемент.Имя,"ДеревоЗаказыКОбеспечению","")+"1"] Тогда
			
			// Обновить связанные данные.
			питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
			
			// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
			Если ЗначениеЗаполнено(ФильтрКЗаказуНеПозднее) ИЛИ ЗначениеЗаполнено(ФильтрКОтгрузкеНеПозднее) Тогда
				питОтборДеревоЗаказы();
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению цеховая кладовая при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюЦеховаяКладоваяПриИзменении(Элемент)
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению склад материалов при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюСкладМатериаловПриИзменении(Элемент)
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению подразделение при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПодразделениеПриИзменении(Элемент)
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению организация при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюОрганизацияПриИзменении(Элемент)
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено Тогда
		
		РедактируемыеКолонки = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(3);
		ИмяКолонкиДерева = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ДеревоЗаказыКОбеспечению","");
		Если ИмяКолонкиДерева = "Группировка" Тогда
			ИмяКолонкиДерева = "Заказ";
		КонецЕсли;
		
		// Верхний уровень дерева, заказ не запонен.
		Если ИмяКолонкиДерева = "Заказ" И НЕ ПустаяСтрока(ТекДанные.Группировка) Тогда
			Возврат;
		КонецЕсли;
		
		Если РедактируемыеКолонки.Найти(ИмяКолонкиДерева) = Неопределено Тогда
			СтандартнаяОбработка = Ложь;
			Попытка
				ПоказатьЗначение(, ТекДанные[ИмяКолонкиДерева]);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - пит фильтр отметка заказы при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питФильтрОтметкаЗаказыПриИзменении(Элемент)
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	питОтборДеревоЗаказы();
КонецПроцедуры

//  Процедура - пит фильтр приоритет при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питФильтрПриоритетПриИзменении(Элемент)
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	питОтборДеревоЗаказы();
КонецПроцедуры

//  Процедура - пит фильтр план не ранее при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питФильтрПланНеРанееПриИзменении(Элемент)
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	питОтборДеревоЗаказы();
КонецПроцедуры

//  Процедура - пит фильтр план не ранее обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура питФильтрПланНеРанееОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ПроверитьКорректностьЗаполненияФильтраКОтгрузкеНеРанее(ВыбранноеЗначение, СтандартнаяОбработка);
КонецПроцедуры

//  Процедура - пит фильтр план не ранее окончание ввода текста.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Текст - Произвольный - Текст.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  ПараметрыПолученияДанных - Произвольный - Параметры получения данных.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура питФильтрПланНеРанееОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ПроверитьКорректностьЗаполненияФильтраКОтгрузкеНеРанее(СтрокаВДату(Текст), СтандартнаяОбработка);
КонецПроцедуры

//  Процедура - пит фильтр план не позднее при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питФильтрПланНеПозднееПриИзменении(Элемент)
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	питОтборДеревоЗаказы();
КонецПроцедуры

//  Процедура - пит фильтр план не позднее обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура питФильтрПланНеПозднееОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ПроверитьКорректностьЗаполненияФильтраКОтгрузкеНеПозднее(ВыбранноеЗначение, СтандартнаяОбработка);
КонецПроцедуры

//  Процедура - пит фильтр план не позднее окончание ввода текста.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Текст - Произвольный - Текст.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  ПараметрыПолученияДанных - Произвольный - Параметры получения данных.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура питФильтрПланНеПозднееОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ПроверитьКорректностьЗаполненияФильтраКОтгрузкеНеПозднее(СтрокаВДату(Текст), СтандартнаяОбработка);
КонецПроцедуры

//  Процедура - пит фильтр необеспеченные при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питФильтрНеобеспеченныеПриИзменении(Элемент)
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	питОтборДеревоЗаказы();
КонецПроцедуры

#КонецОбласти

#КонецОбласти

// Процедура актуализирует связанные с ТЧ "ЗаказыКОбеспечению" данные при изменении ее измерений.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент)
	
	// Текущие данные.
	Поставка = Элементы.ЗаказыКОбеспечению.ТекущиеДанные;
	
	// Если текеущие данные отмечены к заказу, то сначала обнуляем связанные данные, а потом добавляем их заново.
	Если Поставка.Отметка Тогда
		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Истина);
	КонецЕсли;
	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Истина);
	ЗаказыКОбеспечениюПриАктивизацииСтроки(Неопределено);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Способы обеспечения выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура СпособыОбеспеченияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.СпособыОбеспеченияСпособОбеспечения Тогда
		
		СтандартнаяОбработка = Ложь;
		ИмяФормыОткрываемойФормы = "Справочник.СпособыОбеспеченияПотребностей.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", Элементы.СпособыОбеспечения.ТекущиеДанные.СпособОбеспечения);
		ОткрытьФорму(ИмяФормыОткрываемойФормы, ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Способы обеспечения перед окончанием редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура СпособыОбеспеченияПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	СтрокаТаблицы = Элементы.СпособыОбеспечения.ТекущиеДанные;
	РедактируемоеПоле = Элементы.СпособыОбеспечения.ТекущийЭлемент;
	Если РедактируемоеПоле = Элементы.СпособыОбеспеченияДатаПоставки Тогда
		
		Если ПрошедшаяДата(СтрокаТаблицы.НомерСтроки - 1,
			СтрокаТаблицы.ДатаПоставки, "ДатаПоставки", НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса())) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	ИначеЕсли РедактируемоеПоле = Элементы.СпособыОбеспеченияДатаСледующейПоставки Тогда
		
		Если ПрошедшаяДата(СтрокаТаблицы.НомерСтроки - 1,
			СтрокаТаблицы.ДатаСледующейПоставки, "ДатаСледующейПоставки", НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса())) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Способы обеспечения дата поставки при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпособыОбеспеченияДатаПоставкиПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.СпособыОбеспечения.ТекущиеДанные;
	СтрокаТаблицы.НетДатыПоставкиПоКалендарю = Ложь;

КонецПроцедуры

//  Процедура - Запасы выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ЗапасыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Форма.Элемент.Запасы.Выбор");
	
	Если Элемент.ТекущийЭлемент = Элементы.МетодОбеспечения Тогда

		СтандартнаяОбработка = Ложь;
		ОткрытьМетодОбеспечения("Запасы");
		
	ИначеЕсли Поле = Элементы.НоменклатураЗапасы Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.Номенклатура);
	ИначеЕсли Поле = Элементы.СкладЗапасы Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.Склад);
	КонецЕсли;

КонецПроцедуры

//  Процедура - Запасы при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗапасыПриАктивизацииСтроки(Элемент)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Элемент.Запасы.ПриАктивизацииСтроки");
	
	Если Элементы.СтраницыТаблицаПотребностей.ТекущаяСтраница = Элементы.СтраницаТаблицаЗапасы Тогда
		ПодключитьОбработчикОжидания("ЗапасыПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

//  Процедура - Запасы при активизации ячейки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗапасыПриАктивизацииЯчейки(Элемент)
	
	СтрокаЗапасы = Элементы.Запасы.ТекущиеДанные;
	Если Элемент.ТекущийЭлемент = Элементы.СпособОбеспеченияЗапасы И СтрокаЗапасы <> Неопределено Тогда
		
		Если СтрокаЗапасы.ПеремещениеРазрешено Тогда
			ДоступныеТипыОбеспеченияДляВыбора = ДоступныеТипыОбеспеченияСПеремещением;
		Иначе
			ДоступныеТипыОбеспеченияДляВыбора = ДоступныеТипыОбеспеченияБезПеремещения;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Отметка запасы при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОтметкаЗапасыПриИзменении(Элемент)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Элемент.ОтметкаЗапасы.ПриИзменении");
	
	Поставка = Элементы.Запасы.ТекущиеДанные;
	
	СоответствиеСтрок = ПересчитатьОкруглениеКлиент(Поставка, Истина);
	
	ОтобразитьРасчитанноеОкругление(Поставка, Истина);
	
	ОтразитьСвязанныеПоставкиВКорзине(СоответствиеСтрок);
	
КонецПроцедуры

//  Процедура - К заказу запасы при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КЗаказуЗапасыПриИзменении(Элемент)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Элемент.КЗаказуЗапасы.ПриИзменении");
	
	Поставка = Элементы.Запасы.ТекущиеДанные;
	Поставка.Отметка = Поставка.КЗаказу > 0;
	
	СоответствиеСтрок = ПересчитатьОкруглениеКлиент(Поставка, Истина);
	
	ОтобразитьРасчитанноеОкругление(Поставка, Истина);
	
	ОтразитьСвязанныеПоставкиВКорзине(СоответствиеСтрок);

КонецПроцедуры

//  Процедура - Способ обеспечения запасы при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпособОбеспеченияЗапасыПриИзменении(Элемент)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Элемент.СпособОбеспеченияЗапасы.ПриИзменении");
	
	Поставка = Элементы.Запасы.ТекущиеДанные;
	
	РассчитатьСтрокуТаблицыЗапасыНаКлиенте(Поставка.СпособОбеспечения);
	
	СоответствиеСтрок = ПересчитатьОкруглениеКлиент(Поставка, Истина);
	
	ОтобразитьРасчитанноеОкругление(Поставка, Истина);
	
	ОтразитьСвязанныеПоставкиВКорзине(СоответствиеСтрок);

КонецПроцедуры

//  Процедура - Способ обеспечения запасы очистка.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура СпособОбеспеченияЗапасыОчистка(Элемент, СтандартнаяОбработка)

	Поставка = Элементы.Запасы.ТекущиеДанные;
	Поставка.Отметка = Ложь;
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

КонецПроцедуры

//  Процедура - Способ обеспечения запасы обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура СпособОбеспеченияЗапасыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	Поставка = Элементы.Запасы.ТекущиеДанные;
	Поставка.Отметка = Ложь;
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

КонецПроцедуры

//  Процедура - Способ обеспечения запасы окончание ввода текста.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Текст - Произвольный - Текст.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  Параметры - Произвольный - Параметры.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура СпособОбеспеченияЗапасыОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Текст = "" Тогда

		Поставка = Элементы.Запасы.ТекущиеДанные;

		Если Поставка.Отметка Тогда

			питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

		КонецЕсли;

		ОчиститьУсловияЗакупок(Поставка);

		Поставка.ИсточникОбеспечения = ТекстНеЗаполнено;
		Поставка.СпособОбеспечения = ПредопределенноеЗначение("Справочник.СпособыОбеспеченияПотребностей.ПустаяСсылка");

		КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Ложь);

	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Источник обеспечения запасы начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ИсточникОбеспеченияЗапасыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Форма.Элемент.ИсточникОбеспеченияЗапасы.НачалоВыбора");
	
	Поставка = Элементы.Запасы.ТекущиеДанные;

	ПараметрыФормы = Новый Структура("Склад, Номенклатура, Характеристика, ЭтоРабота, ТипОбеспечения");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Поставка);
	ПараметрыФормы.ЭтоРабота = Ложь;

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Обработка.ОбеспечениеПотребностей.Форма.ФормаВыбораИсточникаОбеспечения", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);

КонецПроцедуры

//  Процедура - Источник обеспечения запасы очистка.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ИсточникОбеспеченияЗапасыОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поставка = Элементы.Запасы.ТекущиеДанные;

	Если Поставка.Отметка Тогда

		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

	КонецЕсли;

	Поставка.ИсточникОбеспечения = ТекстНеЗаполнено;

	ОчиститьУсловияЗакупок(Поставка);

	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Ложь);

КонецПроцедуры

//  Процедура - Источник обеспечения запасы обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ИсточникОбеспеченияЗапасыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Поставка = Элементы.Запасы.ТекущиеДанные;

	Если Поставка.Отметка Тогда

		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

	КонецЕсли;

	ОчиститьУсловияЗакупок(Поставка);

	Поставка.ИсточникОбеспечения = ОбработатьПустойИсточникОбеспечения(ВыбранноеЗначение, ТекстНеЗаполнено);
	
	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Ложь);

КонецПроцедуры

//  Процедура - Источник обеспечения запасы окончание ввода текста.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Текст - Произвольный - Текст.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  ПараметрыПолученияДанных - Произвольный - Параметры получения данных.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ИсточникОбеспеченияЗапасыОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	Если Текст = "" Тогда

		Поставка = Элементы.Запасы.ТекущиеДанные;

		Если Поставка.Отметка Тогда

			питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

		КонецЕсли;

		ОчиститьУсловияЗакупок(Поставка);

		Поставка.ИсточникОбеспечения = ТекстНеЗаполнено;

		КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Ложь);

	КонецЕсли;

КонецПроцедуры

//  Процедура - Дата поставки запасы очистка.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДатаПоставкиЗапасыОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поставка = Элементы.Запасы.ТекущиеДанные;

	Если Поставка.Отметка Тогда

		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

	КонецЕсли;

	Поставка.ДатаПоставки = '00010101';

	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Ложь);

КонецПроцедуры

//  Процедура - Дата поставки запасы обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДатаПоставкиЗапасыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Поставка = Элементы.Запасы.ТекущиеДанные;

	Если Поставка.Отметка Тогда

		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);

	КонецЕсли;

	Поставка.ДатаПоставки = ВыбранноеЗначение;
	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Ложь);
	
КонецПроцедуры

//  Процедура - Дата поставки запасы окончание ввода текста.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Текст - Произвольный - Текст.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  Параметры - Произвольный - Параметры.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДатаПоставкиЗапасыОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	ДатаПоставкиДоИзменения = Элементы.Запасы.ТекущиеДанные.ДатаПоставки;
	
КонецПроцедуры

//  Процедура - Дата поставки запасы при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДатаПоставкиЗапасыПриИзменении(Элемент)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Элемент.ДатаПоставкиЗапасы.ПриИзменении");
	
	Поставка = Элементы.Запасы.ТекущиеДанные;

	Если Поставка.Отметка Тогда

		НоваяДатаПоставки = Поставка.ДатаПоставки;
		Поставка.ДатаПоставки = ДатаПоставкиДоИзменения;
		питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, 0, Ложь);
		Поставка.ДатаПоставки = НоваяДатаПоставки;

	КонецЕсли;

	КоличествоКЗаказу = Поставка.Округлено * ?(Поставка.Отметка, 1, 0);
	питОтразитьПоставкуВКорзинеИДеревеДокументов(ЭтаФорма, Поставка, КоличествоКЗаказу, Ложь);
	
КонецПроцедуры

//  Процедура - Заказы к обеспечению при активизации ячейки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗаказыКОбеспечениюПриАктивизацииЯчейки(Элемент)
	
	СтрокаЗаказы = Элементы.ЗаказыКобеспечению.ТекущиеДанные;
	Если Элемент.ТекущийЭлемент = Элементы.СпособОбеспеченияЗаказы И СтрокаЗаказы <> Неопределено Тогда
		
		Если СтрокаЗаказы.ЭтоРабота Тогда
			ДоступныеТипыОбеспеченияДляВыбора = ДоступныеТипыОбеспеченияРабот;
		ИначеЕсли СтрокаЗаказы.ПеремещениеРазрешено Тогда
			ДоступныеТипыОбеспеченияДляВыбора = ДоступныеТипыОбеспеченияСПеремещением;
		Иначе
			ДоступныеТипыОбеспеченияДляВыбора = ДоступныеТипыОбеспеченияБезПеремещения;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заказы к обеспечению выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ЗаказыКОбеспечениюВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.Заказ Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.Заказ);
	ИначеЕсли Поле = Элементы.НоменклатураЗаказы Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.Номенклатура);
