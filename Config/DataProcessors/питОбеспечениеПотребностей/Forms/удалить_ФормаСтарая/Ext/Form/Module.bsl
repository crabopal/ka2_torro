	ИндексыПоискаТаблицаСортировки.Очистить();
	
	Для Каждого Ветвь Из ВетвиКорня Цикл
		Строка = ?(Ветвь.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Ветвь.ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Ветвь.ИДСтроки));
		
		СтрокаСортировки = ИндексыПоискаТаблицаСортировки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСортировки, Ветвь);
		СтрокаСортировки.ДатаПоставки = Строка.ДатаПоставки;
	КонецЦикла;
	
	ИндексыПоискаТаблицаСортировки.Сортировать("ДатаПоставки");
	
	Соответствие = Новый Соответствие();
	
	Для Каждого СтрокаСортировки Из ИндексыПоискаТаблицаСортировки Цикл
		Строка = ?(СтрокаСортировки.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(СтрокаСортировки.ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(СтрокаСортировки.ИДСтроки));
		
		Соответствие.Вставить(Строка, СтрокаСортировки.ТаблицаЗапасы);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

//  Функция - Округлить соответствие строк.
//
// Параметры:
//  СоответствиеСтрок - Соответствие - Соответствие строк.
//  ИспользоватьУпаковки - Произвольный - Использовать упаковки.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ОкруглитьСоответствиеСтрок(СоответствиеСтрок, ИспользоватьУпаковки)
	
	ОстатокОкругления = 0;
	ОкругленоИтог = 0;
	КЗаказуИтог = 0;
	
	КЗаказуИтогЗапасы = 0;
	КЗаказуИтогЗаказы = 0;
	
	Для Каждого КлючЗначение Из СоответствиеСтрок Цикл
		
		Строка = КлючЗначение.Ключ;
		
		Округлено = 0;
		
		Если Строка <> Неопределено Тогда
			Если Строка.Отметка Тогда
				
				Если ИспользоватьУпаковки Тогда
					Если ОстатокОкругления >= Строка.КЗаказу Тогда
						ОстатокОкругления = ОстатокОкругления - Строка.КЗаказу;
						Округлено = 0; // ОстатокОкругления списывается полностью или частично. Эта строка обеспечена полностью
					Иначе
						КЗаказу = Строка.КЗаказу - ОстатокОкругления; // ОстатокОкругления списывается полностью в счет количества КЗаказу
						Округлено = Округлить(КЗаказу, ?(Строка.ЧислительУпаковки = 0 Или Строка.ЗнаменательУпаковки = 0, 1, Строка.ЧислительУпаковки / Строка.ЗнаменательУпаковки),
						Строка.ТипЕдиницыИзмерения);
						ОстатокОкругления = Округлено - КЗаказу;
					КонецЕсли;
				Иначе
					Округлено = Строка.КЗаказу;
				КонецЕсли;
				
				Строка.Округлено = Округлено;
				ОкругленоИтог = ОкругленоИтог + Округлено;
				
				КЗаказуИтог = КЗаказуИтог + Строка.КЗаказу;
				
				// Если истина - накапливается итог по таблице запасов, иначе - заказов
				Если КлючЗначение.Значение Тогда
					КЗаказуИтогЗапасы = КЗаказуИтогЗапасы + Строка.КЗаказу;
				Иначе
					КЗаказуИтогЗаказы = КЗаказуИтогЗаказы + Строка.КЗаказу;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Структура = Новый Структура();
	Структура.Вставить("ОкругленоИтог", 	ОкругленоИтог);
	Структура.Вставить("КЗаказуИтог", 		КЗаказуИтог);
	Структура.Вставить("КЗаказуИтогЗапасы", КЗаказуИтогЗапасы);
	Структура.Вставить("КЗаказуИтогЗаказы", КЗаказуИтогЗаказы);
	
	Возврат Структура;
	
КонецФункции

//  Функция - Округлить.
//
// Параметры:
//  Количество - Произвольный - Количество.
//  Кратность - Произвольный - Кратность.
//  ТипЕдиницыИзмерения - Произвольный - Тип единицы измерения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция Округлить(Количество, Кратность, ТипЕдиницыИзмерения)
	
	Если Кратность <> 1
		Или ТипЕдиницыИзмерения = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук") Тогда
		Если Количество % Кратность <> 0 Тогда
			Остаток = Цел(Количество / Кратность) + 1;
			Возврат Остаток * Кратность;
		Иначе
			Возврат Количество;
		КонецЕсли;
	Иначе 
		Возврат Количество;
	КонецЕсли;
	
КонецФункции

//  Процедура - Отобразить расчитанное округление.
//
// Параметры:
//  Строка - Строка - Строка.
//  Запасы - Произвольный - Запасы.
//
&НаКлиенте
Процедура ОтобразитьРасчитанноеОкругление(Строка, Запасы)
	
	Если Строка = Неопределено Тогда
		Итоги = ПараметрыИнформационнойСтроки();
		СформироватьИнформационнуюСтроку(Неопределено, Итоги, Запасы);
		Возврат;
	КонецЕсли;
	
	ИДИндекса = Строка.ИДИндекса;
	
	Корень = ИндексыПоиска.НайтиПоИдентификатору(ИДИндекса);
	ВетвиКорня = Корень.ПолучитьЭлементы();
	
	ОкругленоИтог = 0;
	КЗаказуИтог = 0;
	
	КЗаказуИтогЗапасы = 0;
	КЗаказуИтогЗаказы = 0;
	
	СуммаИтог = 0;
	ЕстьСтрокаСПустойЦеной = Ложь;
	
	Для Каждого Ветвь Из ВетвиКорня Цикл
		Округлено = 0;
		СтрокаПоДереву = ?(Ветвь.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Ветвь.ИДСтроки), 
		Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Ветвь.ИДСтроки));
		
		Если СтрокаПоДереву <> Неопределено Тогда
			Если СтрокаПоДереву.Отметка Тогда
				
				Округлено = СтрокаПоДереву.Округлено;
				ОкругленоИтог = ОкругленоИтог + Округлено;
				КЗаказуИтог = КЗаказуИтог + СтрокаПоДереву.КЗаказу;
				СуммаИтог = СуммаИтог + (Округлено * СтрокаПоДереву.ЦенаВВалютеУправленческогоУчета);
				
				Если СтрокаПоДереву.ЦенаВВалютеУправленческогоУчета = 0 Тогда
					
					ЕстьСтрокаСПустойЦеной = Истина;
					
				КонецЕсли;
				
				Если Ветвь.ТаблицаЗапасы Тогда
					КЗаказуИтогЗапасы = КЗаказуИтогЗапасы + СтрокаПоДереву.КЗаказу;
				Иначе
					КЗаказуИтогЗаказы = КЗаказуИтогЗаказы + СтрокаПоДереву.КЗаказу;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Итоги = ПараметрыИнформационнойСтроки();
	Итоги.ОкругленоИтог = 			ОкругленоИтог;
	Итоги.КЗаказуИтог = 			КЗаказуИтог;
	Итоги.КЗаказуИтогЗапасы = 		КЗаказуИтогЗапасы;
	Итоги.КЗаказуИтогЗаказы = 		КЗаказуИтогЗаказы;
	Итоги.СуммаИтог = 				СуммаИтог;
	Итоги.ЕстьСтрокаСПустойЦеной = 	ЕстьСтрокаСПустойЦеной;
	
	СформироватьИнформационнуюСтроку(Строка, Итоги, Запасы);
	
КонецПроцедуры

// Обновляет реквизит формы ИнформационнаяСтрока
//
// Параметры:
//  Строка - ДанныеФормыКоллекция - источник данных для формирования информационной строк.
//  Итоги - Структура - содержит следующие данные.
//  Запасы - Число - итогое значение по количеству к заказу таблицы Запас.
//
&НаКлиенте
Процедура СформироватьИнформационнуюСтроку(Строка, Итоги, Запасы)

	ОкругленоИтог = 			Итоги.ОкругленоИтог;
	КЗаказуИтог = 				Итоги.КЗаказуИтог;
	КЗаказуИтогЗапасы = 		Итоги.КЗаказуИтогЗапасы;
	КЗаказуИтогЗаказы = 		Итоги.КЗаказуИтогЗаказы;
	СуммаИтог = 				Итоги.СуммаИтог;
	ЕстьСтрокаСПустойЦеной = 	Итоги.ЕстьСтрокаСПустойЦеной;
	
	Шрифт = Элементы.ИнформационнаяСтрока.Шрифт;
	ШрифтЖирный = Новый Шрифт(Шрифт, , , Истина);
	ШрифтКурсив = Новый Шрифт(Шрифт, , , , Истина);
	
	ИнформационнаяСтрокаМассив = Новый Массив();
	
	Если Строка = Неопределено Тогда
		ИнформационнаяСтрокаМассив.Добавить(НСтр("ru = 'Строка не выбрана'"));
	Иначе
	
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.Номенклатура), , , ,
			ПолучитьНавигационнуюСсылку(Строка.Номенклатура)));
		
		Если НЕ Строка.Характеристика.Пустая() Тогда
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(", "));
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.Характеристика), , , ,
				ПолучитьНавигационнуюСсылку(Строка.Характеристика)));
				
		КонецЕсли;
			
		Если Не Строка.Склад.Пустая()
			И ИспользоватьНесколькоСкладов Тогда
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(", "));
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.Склад), , , ,
				ПолучитьНавигационнуюСсылку(Строка.Склад)));
		
		КонецЕсли;
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(": "));
		
		Если Запасы Тогда
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'К заказу по запасам:'")));
		Иначе
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Всего к заказу:'")));
		КонецЕсли;
		
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(КЗаказуИтог) + " ", ШрифтЖирный));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.ЕдиницаИзмерения), ШрифтЖирный));
		
		Если НЕ Запасы И ОкругленоИтог > 0 Тогда
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = ' (по заказам:'")));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(КЗаказуИтогЗаказы), ШрифтЖирный));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока("), "));
			
		Иначе
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(", "));
			
		КонецЕсли;
		
		Если ОкругленоИтог > 0 И ИспользоватьУпаковки Тогда
			
			СсылкаУпаковка = "ОткрытьФормуВыбораУпаковки";
			
			// Вывод информации о упаковке.
			Если Строка.УпаковкаЗаказа.Пустая() Тогда
				Если Строка.ИспользоватьУпаковки 
					И ЕстьДоступКИзменениюУпаковки Тогда
					Упаковка = НСтр("ru = '<задать упаковку для округления>'");
					ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Упаковка + " ", ШрифтКурсив, , , СсылкаУпаковка));
				КонецЕсли;
			Иначе
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Округлено до:'")));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(ОкругленоИтог) + " ", ШрифтЖирный));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.ЕдиницаИзмерения) + ", ", ШрифтЖирный));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '(Упаковка:'"), ШрифтКурсив));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
				
				Упаковка = Строка(Строка.УпаковкаЗаказа);
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Упаковка, ШрифтКурсив, , , СсылкаУпаковка));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока("), ", ШрифтКурсив));
			КонецЕсли;
		КонецЕсли;
		
		ЗнакПримерноРавно = ?(ЕстьСтрокаСПустойЦеной, "~", "");
		
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'На сумму:'")));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(ЗнакПримерноРавно, ШрифтЖирный));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(СуммаИтог), ШрифтЖирный));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" " + ВалютаУправленческогоУчета, ШрифтЖирный));
		
	КонецЕсли;
		
	ИнформационнаяСтрока = Новый ФорматированнаяСтрока(ИнформационнаяСтрокаМассив);

КонецПроцедуры

//  Функция - Параметры информационной строки.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаКлиенте
Функция ПараметрыИнформационнойСтроки()
	
	СтруктураВозврата = Новый Структура();
	СтруктураВозврата.Вставить("ОкругленоИтог", 0);
	СтруктураВозврата.Вставить("КЗаказуИтог", 0);
	СтруктураВозврата.Вставить("КЗаказуИтогЗапасы", 0);
	СтруктураВозврата.Вставить("КЗаказуИтогЗаказы", 0);
	СтруктураВозврата.Вставить("СуммаИтог", 0);
	СтруктураВозврата.Вставить("ЕстьСтрокаСПустойЦеной", Ложь);
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Индексирует таблицу, определяемую параметром Запасы
//  Повторяющиеся строки по ключу Номенклатура, Характеристика, Склад сворачиваются
//  в один корневой элемент дерева ИндексыПоиска
//
// Параметры:
//  Запасы - Булево - Признак того, что вызов процедуры производится на шаге Запас.
//
&НаСервере
Процедура ЗаполнитьДеревоИндексов(Запасы)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаЗапасы", ВыгрузитьНоменклатуруСИдентификаторамиСтрок(Объект.Запасы)); 
	Запрос.УстановитьПараметр("ТаблицаЗаказы", ВыгрузитьНоменклатуруСИдентификаторамиСтрок(Объект.ЗаказыКОбеспечению));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	Таблица.Индекс         КАК Индекс
		|ПОМЕСТИТЬ ВтТаблицаЗапасы
		|ИЗ
		|	&ТаблицаЗапасы КАК Таблица
		|;
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	Таблица.Индекс         КАК Индекс
		|ПОМЕСТИТЬ ВтТаблицаЗаказы
		|ИЗ
		|	&ТаблицаЗаказы КАК Таблица
		|;
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.Индекс         КАК Индекс,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	ИСТИНА                 КАК ЭтоЗапасы
		|ИЗ
		|	ВтТаблицаЗапасы КАК Таблица
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.Индекс         КАК Индекс,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	ЛОЖЬ                   КАК ЭтоЗапасы
		|ИЗ
		|	ВтТаблицаЗаказы КАК Таблица
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура, Характеристика, Склад, ДатаПоставки";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Коллекция = ИндексыПоиска.ПолучитьЭлементы();
	Коллекция.Очистить();
	
	Ключ = Новый Структура("Номенклатура, Характеристика, Склад");
	Пока Выборка.Следующий() Цикл
		
		Если Ключ.Номенклатура <> Выборка.Номенклатура Или Ключ.Характеристика <> Выборка.Характеристика Или Ключ.Склад <> Выборка.Склад Тогда
			
			ЗаполнитьЗначенияСвойств(Ключ, Выборка);
			Корень = Коллекция.Добавить();
			Строки = Корень.ПолучитьЭлементы();
			
		КонецЕсли;
		
		ТаблицаФормы = ?(Выборка.ЭтоЗапасы, Объект.Запасы, Объект.ЗаказыКОбеспечению);
		
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.ИДСтроки      = ТаблицаФормы[Выборка.Индекс].ПолучитьИдентификатор(); 
		НоваяСтрока.ТаблицаЗапасы = Выборка.ЭтоЗапасы; 
		
		ТаблицаФормы[Выборка.Индекс].ИДИндекса = Корень.ПолучитьИдентификатор();
		
	КонецЦикла;
		
КонецПроцедуры

//  Функция - Выгрузить номенклатуру с идентификаторами строк.
//
// Параметры:
//  ТаблицаФормы - ТаблицаЗначений - Таблица формы.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервере
Функция ВыгрузитьНоменклатуруСИдентификаторамиСтрок(ТаблицаФормы)
	
	ТаблицаВыгрузки = Новый ТаблицаЗначений();
	ТаблицаВыгрузки.Колонки.Добавить("Номенклатура",   Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаВыгрузки.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаВыгрузки.Колонки.Добавить("Склад",          Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаВыгрузки.Колонки.Добавить("ДатаПоставки",   Новый ОписаниеТипов("Дата"));
	ТаблицаВыгрузки.Колонки.Добавить("Индекс",         Новый ОписаниеТипов("Число"));
	
	ВсегоСтрок = ТаблицаФормы.Количество() - 1;
	Для Индекс = 0 По ВсегоСтрок Цикл
		
		СтрокаТаблицы = ТаблицаФормы[Индекс];
		ВыгруженнаяСтрока = ТаблицаВыгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(ВыгруженнаяСтрока, СтрокаТаблицы);
		ВыгруженнаяСтрока.Индекс = Индекс;
		
	КонецЦикла;
	Возврат ТаблицаВыгрузки;
	
КонецФункции

//  Процедура - Выбрать упаковку клиент.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаКлиенте
Процедура ВыбратьУпаковкуКлиент(ИмяТаблицы)

	Поставка = Элементы[ИмяТаблицы].ТекущиеДанные;

	ЕдиницыИзмерения = Новый Массив();
	ЕдиницыИзмерения.Добавить(Поставка.ЕдиницаИзмерения);
	
	ПараметрыФормыОтбор = Новый Структура("Владелец", Поставка.Номенклатура);
	ПараметрыФормы = Новый Структура("Отбор", ПараметрыФормыОтбор);
	ПараметрыФормы.Вставить("ЕдиницыИзмерения", ЕдиницыИзмерения);
	
	ОткрытьФорму("Обработка.ОбеспечениеПотребностей.Форма.ФормаВыбораУпаковкиЕдиницы", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

// Распространяет по таблицам Запасы и ЗаказыКОбеспечению изменение упаковки
//  Записывает изменение упаковки в базу данных
//
// Параметры:
//  ИДИндекса - Число - Идентификатор корня в дереве ИндексыПоиска, по ветвям которого работает алгорит.
//  Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения - новое значение упаковк.
//
&НаСервере
Процедура ЗаполнитьЗаписатьУпаковкуПоДеревуИндексов(ИДИндекса, Упаковка)
	
	Если Упаковка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧислительИЗнаменательУпаковки = Новый Структура("Числитель, Знаменатель", 1, 1);
	
	// Выбор единицы измерения означает команду на очищение
	Если Упаковка.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Упаковка Тогда
		ЧислительИЗнаменательУпаковки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Упаковка, "Числитель, Знаменатель");
	Иначе
		Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	КонецЕсли;
	
	Корень = ИндексыПоиска.НайтиПоИдентификатору(ИДИндекса);
	
	// Обход всех соответствующих строк в обеих таблицах, с заменой упаковки и коэффициента
	Коллекция = Корень.ПолучитьЭлементы();
	Строка = Неопределено;
	
	Если Коллекция.Количество() > 0 Тогда
		Строка = ?(Коллекция[0].ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Коллекция[0].ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Коллекция[0].ИДСтроки));
	КонецЕсли;
	
	Если Строка <> Неопределено Тогда
		// Запись изменения в регистр сведений ТоварныеОграничения
		РегистрыСведений.ТоварныеОграничения.ЗадатьУпаковкуТовара(Строка.Номенклатура, Строка.Характеристика,
			Строка.Склад, Упаковка);
		
		Для Каждого Ветвь Из Коллекция Цикл
			
			Строка = ?(Ветвь.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Ветвь.ИДСтроки),
				Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Ветвь.ИДСтроки));
			
			Строка.УпаковкаЗаказа = Упаковка;
			Строка.ЧислительУпаковки = ЧислительИЗнаменательУпаковки.Числитель;
			Строка.ЗнаменательУпаковки = ЧислительИЗнаменательУпаковки.Знаменатель;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Очищает дерево ИндексыПоиска полностью, либо только записи ссылающиеся на таблицу ЗаказыКОбеспечению
//
// Параметры:
//  Запасы - Булево - Признак того, что вызов процедуры производится на шаге Запас.
//
&НаКлиенте
Процедура ОчиститьДеревоИндексов(Запасы)
	
	Корни = ИндексыПоиска.ПолучитьЭлементы();
	
	// Таблица Запасы - первая. Ее очищение по кнопке Назад равнозначно полной очистке таблицы
	Если Запасы Тогда
		Корни.Очистить();
	КонецЕсли;
	
	Количество = Корни.Количество() - 1;
	Для н = 0 По Количество Цикл
		
		ИндексКорня = Количество - н;
		Корень = Корни[ИндексКорня];
		
		Ветви = Корень.ПолучитьЭлементы();
		КоличествоВетвей = Ветви.Количество() - 1;
		
		// Удаление ветвей связанных с таблицей ЗаказыКОбеспечению
		Для м = 0 По КоличествоВетвей Цикл
			
			ИндексВетви = КоличествоВетвей - м;
			Ветвь = Ветви[ИндексВетви];
			Если Ветвь.ТаблицаЗапасы = Ложь Тогда
				Ветви.Удалить(ИндексВетви);
			КонецЕсли;
			
		КонецЦикла;
		
		// Если из корня удалены все ветви, удаляется корень
		Если Корень.ПолучитьЭлементы().Количество() = 0 Тогда
			Корни.Удалить(ИндексКорня);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Общепит

// Дерево "ДеревоЗаказыКОбеспечению" отображает данные в 2 уровня:
// на верхнем уровне планы-меню, которые будут оформлены;
// на нижнем - строки заказов, которые попадут в планы-меню.
// Данное дерево синхронизируется с ТЗ "ЗаказыКОбеспечению"
// по которой далее и происходит формирование планов меню.
#Область ДеревоЗаказыКОбеспечению

#Область ДеревоЗаказыКОбеспечениюСлужебныеПроцедурыИФункции

// Процедура заполняет дерево документов по таблице заказов к обеспечению
//
&НаСервере
Процедура питЗаполнитьДеревоЗаказовКОбеспечению() 
	
	// Номер плана-меню для отображения представления на форме,
	// с реальным номером чаще всего не совпадает.
	питМаксНомерПлана = питПредполагаемыйИсходныйНомерПлана;
	
	ДеревоЗаказыКОбеспечению.ПолучитьЭлементы().Очистить();
	
	Таблица = Объект.ЗаказыКОбеспечению;
	
	// Массив структур для заполнения колонок верхней группировки и нижней.
	ИменаКолонокГруппировка		= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
	ИменаКолонокТовары			= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(1,Ложь);
	КлючиГруппировки = Новый Массив;
	КлючиГруппировки.Добавить(Новый Структура(ИменаКолонокГруппировка));
	КлючиГруппировки.Добавить(Новый Структура(ИменаКолонокТовары));
	
	ДеревоДокументовОбъект = РеквизитФормыВЗначение("ДеревоЗаказыКОбеспечению");
	СтрокиГруппировки = ДеревоДокументовОбъект.Строки;
	
	Для Каждого Строка Из Таблица Цикл
		
		// Фильтры, заполняем не по всем строкам, а только по тем, которые удовлетворяют фильтрам.
		ДатаПоставкиДопустима	= Строка.ДатаПоставки >= ФильтрКОтгрузкеНеРанее
			И (Строка.ДатаПоставки <= ФильтрКОтгрузкеНеПозднее Или Не ЗначениеЗаполнено(ФильтрКОтгрузкеНеПозднее));
		ОбеспечениеДопустимо	= Строка.Требуется > Строка.Обеспечено Или Не ФильтрНеобеспеченные;
		ОтметкаДопустима		= Строка.Отметка = Истина Или НЕ ФильтрОтметкаЗаказы;
		ПриоритетДопустим		= (Строка.Приоритет = ФильтрПриоритет) Или Не ЗначениеЗаполнено(ФильтрПриоритет);
		Если НЕ(ДатаПоставкиДопустима И ОбеспечениеДопустимо И ОтметкаДопустима И ПриоритетДопустим) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(КлючиГруппировки[0], Строка);
		ЗаполнитьЗначенияСвойств(КлючиГруппировки[1], Строка);
		
		// Отражаем строку ТЗ в дереве.
		питОтразитьСтрокуЗаказовВДеревеЗаказов(Строка, СтрокиГруппировки, КлючиГруппировки, ТекстНеЗаполнено, питМаксНомерПлана);
		
	КонецЦикла;
	
	// Заполнение ресурсов на верхнем уровне
	Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
		
		СуммаКЗаказу = 0;
		Для каждого Строкатовары Из СтрокаГруппировки.Строки Цикл
			Если Строкатовары.Отметка Тогда
				СуммаКЗаказу = СуммаКЗаказу + Строкатовары.КЗаказу;
			КонецЕсли;
		КонецЦикла;
		СтрокаГруппировки.Обеспечено = СтрокаГруппировки.Строки.Итог("Обеспечено");
		СтрокаГруппировки.Требуется = СтрокаГруппировки.Строки.Итог("Требуется");
		СтрокаГруппировки.Кзаказу = СуммаКЗаказу;
		
	КонецЦикла;
	
	// Сортировка.
	СтрокиГруппировки.Сортировать(ИменаКолонокГруппировка);
	
	ЗначениеВРеквизитФормы(ДеревоДокументовОбъект, "ДеревоЗаказыКОбеспечению");
	
КонецПроцедуры

// Функция отражает строку ТЧ "ЗаказыКОбеспечению" в дереве документов общепит.
//
// Параметры:
//  РесурсыСтроки - Произвольный - Ресурсы строки.
//  Группировки - Произвольный - Группировки.
//  КлючиГруппировки - Произвольный - Ключи группировки.
//  ТекстНеЗаполнено - Произвольный - Текст не заполнено.
//  питМаксНомерПлана - Произвольный - пит макс номер плана.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервереБезКонтекста
Функция питОтразитьСтрокуЗаказовВДеревеЗаказов(РесурсыСтроки, Группировки, КлючиГруппировки, ТекстНеЗаполнено, питМаксНомерПлана)
	
	// Если РесурсыСтроки.Отметка И РесурсыСтроки.КЗаказу > 0 Тогда
		
		МассивСтрок = Группировки.НайтиСтроки(КлючиГруппировки[0]);
		Если МассивСтрок.Количество() = 0 Тогда
			
			Группировка = Группировки.Добавить();
			ЗаполнитьЗначенияСвойств(Группировка, КлючиГруппировки[0]); 
			Группировка.КартинкаПриоритета = 1;
			Группировка.Группировка = питПолучитьПредставлениеГруппировкиДереваДокументов(КлючиГруппировки[0], ТекстНеЗаполнено, питМаксНомерПлана);
			
		Иначе //Поставщик уже есть в дереве.
			Группировка = МассивСтрок[0];
		КонецЕсли;
		
		СтрокиТоваров = Группировка.Строки;
		
		СтрокаТоваров = СтрокиТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, РесурсыСтроки); 
		
	// КонецЕсли;
	
КонецФункции

// Функция получает имена колонок группировки.
//
// Параметры:
//  КодГруппировки - Число - Код уровня.
//  ПолучитьМассив - Массив - Получить массив.
//
// Возвращаемое значение:
//  в зависимости от данного параметра.
//  Префикс			 - Строка	 - Префикс колонок.
//  Суффикс			 - Строка	 - Суффикс колонок.
// Возвращаемое значение:
//  Строка, Массив - Имена колонок.
&НаКлиентеНаСервереБезКонтекста
Функция питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(КодГруппировки = 0, ПолучитьМассив = Истина)
	
	ИменаКолонокСтрокой = "";
	
	Если КодГруппировки = 0 Тогда
		ИменаКолонокСтрокой		= "Организация,Подразделение,Склад,ЦеховаяКладовая,ДатаПоставки,СкладМатериалов";
	ИначеЕсли КодГруппировки = 1 Тогда
		ИменаКолонокСтрокой		= "Заказ,Номенклатура,Характеристика,Назначение,ЕдиницаИзмерения";
	ИначеЕсли КодГруппировки = 2 Тогда
		ИменаКолонокСтрокой		= "КЗаказу,Округлено,Требуется,Обеспечено";
	ИначеЕсли КодГруппировки = 3 Тогда
		ИменаКолонокСтрокой		= "КЗаказу,Подразделение,СкладМатериалов,ЦеховаяКладовая,ДатаПоставки,Организация";
	ИначеЕсли КодГруппировки = 4 Тогда
		ИменаКолонокСтрокой		= "Склад";
	КонецЕсли;
	
	Если ПолучитьМассив Тогда
		Результат = Новый Массив;
		Разделитель = ",";
		Строки = СтрЗаменить(ИменаКолонокСтрокой, Разделитель, Символы.ПС);
		Для Индекс = 1 По СтрЧислоСтрок(Строки) Цикл
			Результат.Добавить(СтрПолучитьСтроку(Строки, Индекс));
		КонецЦикла; 
	Иначе
		Результат = ИменаКолонокСтрокой;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура по переданному идентификатору строки дерева находит строку дерева и по колонке "ИдентификаторСтроки"
//  находит связанную.
//  строку в ТЧ "ЗаказыКОбеспечению". Актуализирует строку ТЧ в соответствии со значениями в строке дерева.
//
// Параметры:
//  ИдентификаторСтрокиДерева - Строка - Идентификатор строки дерева по которому можно найти строку методо.
//
&НаСервере
Процедура питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(ИдентификаторСтрокиДерева)
	
	СтрокаДерева = Неопределено;
	
	Если НЕ ИдентификаторСтрокиДерева = Неопределено Тогда
		СтрокаДерева = ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);
	КонецЕсли;
	
	Если НЕ СтрокаДерева = Неопределено Тогда
		СтрокаТаблицыЗаказов = Неопределено;
		СтрокиТаблицыЗаказов = Объект.ЗаказыКОбеспечению.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаДерева.ИдентификаторСтроки));
		Если СтрокиТаблицыЗаказов.Количество() Тогда
			СтрокаТаблицыЗаказов = СтрокиТаблицыЗаказов[0];
		КонецЕсли;
		
		Если НЕ СтрокаТаблицыЗаказов = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыЗаказов, СтрокаДерева);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура перестраивает дерево заказов с учетом отборов
//
&НаКлиенте
Процедура питОтборДеревоЗаказы()
	питОтборДеревоЗаказыНаСервере();
	Для каждого ТекЭлементДерева Из ДеревоЗаказыКОбеспечению.ПолучитьЭлементы() Цикл
		Элементы.ДеревоЗаказыКОбеспечению.Развернуть(ТекЭлементДерева.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

// Процедура перестраивает дерево заказов с учетом отборов
//
&НаСервере
Процедура питОтборДеревоЗаказыНаСервере()
	питЗаполнитьДеревоЗаказовКОбеспечению();
КонецПроцедуры

// Процедура ищет строки верхней группировки(планы-меню) у которых нет дочерних элементов и удаляет их.
//
&НаКлиенте
Процедура питДеревоЗаказыКОбеспечениюУдалитьПустыеСтрокиПлановМеню()
	
	СтрокиГруппировки = ДеревоЗаказыКОбеспечению.ПолучитьЭлементы();
	
	// Удаление пустых строк плана-меню.
	МассивСтрокДляУдаления = Новый Массив;
	Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
		Если НЕ СтрокаГруппировки.ПолучитьЭлементы().Количество() Тогда
			МассивСтрокДляУдаления.Добавить(СтрокаГруппировки);
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекСтрокаДляУдаления Из МассивСтрокДляУдаления Цикл
		СтрокиГруппировки.Удалить(ТекСтрокаДляУдаления);
	КонецЦикла;
	
КонецПроцедуры

// Процедура пересчитывает ресурсы в верхних группировках дерева заказов.
//
&НаКлиенте
Процедура питДеревоЗаказыКОбеспечениюПересчитатьРесурсы()
	
	СтрокиГруппировки = ДеревоЗаказыКОбеспечению.ПолучитьЭлементы();
	
	ИменаКолонокРесурсов	= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(2);
	
	// Заполнение ресурсов на верхнем уровне
	Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
		
		Для каждого ТекИмяКолонкиРесурса Из ИменаКолонокРесурсов Цикл
			СтрокаГруппировки[ТекИмяКолонкиРесурса] = 0;
		КонецЦикла;
		
		Для каждого СтрокаТоваров Из СтрокаГруппировки.ПолучитьЭлементы() Цикл
			
			Для каждого ТекИмяКолонкиРесурса Из ИменаКолонокРесурсов Цикл
				Если ТекИмяКолонкиРесурса = "КЗаказу" И НЕ СтрокаТоваров.Отметка Тогда
					Продолжить;
				КонецЕсли;
				СтрокаГруппировки[ТекИмяКолонкиРесурса] = СтрокаГруппировки[ТекИмяКолонкиРесурса] + СтрокаТоваров[ТекИмяКолонкиРесурса];
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура изменяет значение отметки в дереве заказов у колонки к заказу для выделенных строк и
//  переносит изменения в связанную ТЧ "ЗаказыКОбеспечению".
//
// Параметры:
//  Установить - Булево - Новое значение отметки.
//
&НаСервере
Процедура питИзменитьОтметкуДеревоЗаказыКОбеспечению(Установить)
	
	// Выделенные строки дерева.
	ВыделенныеСтроки = Элементы.ДеревоЗаказыКОбеспечению.ВыделенныеСтроки;
	
	// Структура для поиска троки ТЧ "ЗаказыКОбеспечению".
	СтруктураПоиска = Новый Структура("ИдентификаторСтроки");
	
	// Массив строк для удаления.
	СтрокиДляУдаления = Новый Массив;
	
	// Обход выделенных строк.
	Для каждого Идентификатор Из ВыделенныеСтроки Цикл
		
		// Получение строки дерева.
		Строка = ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(Идентификатор);
		
		// Если строка найдена.
		Если НЕ Строка = Неопределено Тогда
			
			// Если это строка верхней группировки(планы-меню).
			Если НЕ ПустаяСтрока(Строка.Группировка) Тогда
				
				// Получение дочерних элементов (заказы).
				ВсеДочерние = Строка.ПолучитьЭлементы();
				
				// Очистка массив строк для удаления.
				СтрокиДляУдаления.Очистить();
				
				// Обход строк заказов.
				Для каждого ДочерняяСтрока Из ВсеДочерние Цикл
					
					// Значение отметки строки отличается от того, которое необходимо установить.
					ОтметкиРазличаются = ДочерняяСтрока.Отметка <> Установить;
					
					// Установка нового значения отметки.
					ДочерняяСтрока.Отметка = Установить;
					
					// Если отметки различаются.
					Если ОтметкиРазличаются Тогда
						
						// Поиск строки ТЧ "ЗаказыКОбеспечению" и актуализация колонки "Отметка".
						СтруктураПоиска.ИдентификаторСтроки = ДочерняяСтрока.ИдентификаторСтроки;
						СтрокиТЗ = Объект.ЗаказыКОбеспечению.НайтиСтроки(СтруктураПоиска);
						Для каждого СтрокаТЗ Из СтрокиТЗ Цикл
							СтрокаТЗ.Отметка = Установить;
						КонецЦикла;
						
						// Если установлен фильтр "Только отмеченные", а новое значение отметки - ЛОЖЬ, то
						// такую строку нужно удалить из дерева.
						Если НЕ Установить И ФильтрОтметкаЗаказы Тогда
							СтрокиДляУдаления.Добавить(ДочерняяСтрока);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				// Удаление строк для удаления.
				Для каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
					ВсеДочерние.Удалить(СтрокаДляУдаления);
				КонецЦикла;
				
			Иначе // Это строка нижней группировки (заказов).
				
				// Отметки различаются.
				ОтметкиРазличаются = Строка.Отметка <> Установить;
				
				// Установка нового значения отметки.
				Строка.Отметка = Установить;
				
				// Если отметки различаются.
				Если ОтметкиРазличаются Тогда
					
					// Поиск строки ТЧ "ЗаказыКОбеспечению" и актуализация колонки "Отметка".
					СтруктураПоиска.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
					СтрокиТЗ = Объект.ЗаказыКОбеспечению.НайтиСтроки(СтруктураПоиска);
					Для каждого СтрокаТЗ Из СтрокиТЗ Цикл
						СтрокаТЗ.Отметка = Установить;
					КонецЦикла;
					
					// Удаление строки из дерева, если установлен фильтр "Только отмеченные", 
					// а новое значение отметки - ЛОЖЬ.
					Если НЕ Установить И ФильтрОтметкаЗаказы Тогда
						Строка.ПолучитьРодителя().ПолучитьЭлементы().Удалить(Строка);
					КонецЕсли;
					
				КонецЕсли; // КонецЕсли отметки различаются.
				
			КонецЕсли; // КонецЕсли это строка верхней группировки(планы-меню).
			
		КонецЕсли; // КонецЕсли строка найдена.
		
	КонецЦикла; // КонецЦикла Обход выделенных строк.
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

// Процедура устанавливает настройки по умолчанию с учетом отраслевой специфики
//
&НаСервере
Процедура питУстановитьНастройкиПоУмолчанию()
	
	питПредполагаемыйИсходныйНомерПлана = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питПланМеню.Номер КАК Номер
	|ИЗ
	|	Документ.питПланМеню КАК питПланМеню
	|ГДЕ
	|	питПланМеню.Дата > НАЧАЛОПЕРИОДА(&Дата, ГОД)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Попытка
			питПредполагаемыйИсходныйНомерПлана = Число(ВыборкаДетальныеЗаписи.Номер);
		Исключение
			питПредполагаемыйИсходныйНомерПлана = 0;
		КонецПопытки;
	КонецЕсли;
	
	питМаксНомерПлана = питПредполагаемыйИсходныйНомерПлана;
	
КонецПроцедуры

// Процедура изменят типовые отборы СКД в соответствии с отраслевой спецификой.
//
// Параметры:
//  СхемаКомпоновкиДанных - СхемаКомпоновкиДанных - Схема компоновки данных.
//
&НаСервере
Процедура питИзменитьДоступныеОтборыСКД(СхемаКомпоновкиДанных)
	
	ПоляСкрыть = Новый Массив;
	ПоляСкрыть.Добавить(Новый ПолеКомпоновкиДанных("СегментНоменклатуры"));
	ПоляСкрыть.Добавить(Новый ПолеКомпоновкиДанных("ТипОбеспечения"));
	ПоляСкрыть.Добавить(Новый ПолеКомпоновкиДанных("НаправлениеДеятельности"));
	ПоляСкрыть.Добавить(Новый ПолеКомпоновкиДанных("ПодразделениеПолучатель"));
	ПоляСкрыть.Добавить(Новый ПолеКомпоновкиДанных("СегментНоменклатуры"));
	
	Для каждого ЭлементОтбораСКД Из СхемаКомпоновкиДанных.ВариантыНастроек.Основной.Настройки.Отбор.Элементы Цикл
		Если ПоляСкрыть.Найти(ЭлементОтбораСКД.ЛевоеЗначение) <> Неопределено Тогда
			ЭлементОтбораСКД.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет дерево документов по таблице заказов к обеспечению
//
// Параметры:
//  ИмяТаблицы - Строка - Имя таблицы заказов к обеспечению.
//
&НаСервере
Процедура питЗаполнитьДеревоДокументов(ИмяТаблицы) 
	
	ДеревоДокументов.ПолучитьЭлементы().Очистить();
	
	Таблица = Объект[ИмяТаблицы];
	
	КлючВДереве  = Новый Массив();
	ИменаКолонокПоставщик    = "Организация, Подразделение, Склад, ЦеховаяКладовая, ДатаПоставки, СкладМатериалов";
	ИменаКолонокСпособыИДаты = "Заказ, Номенклатура, Характеристика, Назначение, ЕдиницаИзмерения";
	КлючВДереве.Добавить(Новый Структура(ИменаКолонокПоставщик));
	КлючВДереве.Добавить(Новый Структура(ИменаКолонокСпособыИДаты));
	Поставка = Новый Структура("Отметка, КЗаказу, ЭтоРабота, Вес, ЦенаВВалютеСоглашения, ЦенаВВалютеУправленческогоУчета");
	Поставка.ЭтоРабота = Ложь;
	
	ДеревоДокументовОбъект = РеквизитФормыВЗначение("ДеревоДокументов");
	Поставщики = ДеревоДокументовОбъект.Строки;
	
	Для Каждого Строка Из Таблица Цикл
		
		ЗаполнитьЗначенияСвойств(КлючВДереве[0], Строка);
		ЗаполнитьЗначенияСвойств(КлючВДереве[1], Строка);
		ЗаполнитьЗначенияСвойств(Поставка, Строка);
		Поставка.КЗаказу = Строка.Округлено;
		
		питОтразитьСтрокуЗаказаВДереве(Поставщики, Поставка, КлючВДереве, ТекстНеЗаполнено, питМаксНомерПлана);
		
	КонецЦикла;
	
	Поставщики.Сортировать(ИменаКолонокПоставщик);
	Для Каждого Поставщик Из Поставщики Цикл
		
		СпособыИДатыПоставок = Поставщик.Строки;
		СпособыИДатыПоставок.Сортировать(ИменаКолонокСпособыИДаты);
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоДокументовОбъект, "ДеревоДокументов");
	
КонецПроцедуры

// Функция отражает строку ТЧ "ЗаказыКОбеспечению" в дереве документов общепит.
//
// Параметры:
//  Группировки - Произвольный - Группировки.
//  РесурсыСтроки - Произвольный - Ресурсы строки.
//  КлючВДереве - Произвольный - Ключ в дереве.
//  ТекстНеЗаполнено - Произвольный - Текст не заполнено.
//  питМаксНомерПлана - Произвольный - пит макс номер плана.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервереБезКонтекста
Функция питОтразитьСтрокуЗаказаВДереве(Группировки, РесурсыСтроки, КлючВДереве, ТекстНеЗаполнено, питМаксНомерПлана)
	
	Если РесурсыСтроки.Отметка И РесурсыСтроки.КЗаказу > 0 Тогда
		
		МассивСтрок = Группировки.НайтиСтроки(КлючВДереве[0]);
		Если МассивСтрок.Количество() = 0 Тогда
			
			Группировка = Группировки.Добавить();
			ЗаполнитьЗначенияСвойств(Группировка, КлючВДереве[0]); 
			
			Группировка.ПланМеню = питПолучитьПредставлениеГруппировкиДереваДокументов(КлючВДереве[0], ТекстНеЗаполнено, питМаксНомерПлана);
			
		Иначе //Поставщик уже есть в дереве.
			Группировка = МассивСтрок[0];
		КонецЕсли;
		
		СтрокиТоваров = Группировка.Строки;
		МассивСтрок = СтрокиТоваров.НайтиСтроки(КлючВДереве[1]);
		Если МассивСтрок.Количество() = 0 Тогда
			
			СтрокаТоваров = СтрокиТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТоваров, КлючВДереве[0]);
			ЗаполнитьЗначенияСвойств(СтрокаТоваров, КлючВДереве[1]); 
			
		Иначе //Такой способ и дата уже есть в дереве.
			СтрокаТоваров = МассивСтрок[0];
		КонецЕсли;
		
		СтрокаТоваров.Количество   = СтрокаТоваров.Количество   + РесурсыСтроки.КЗаказу;
		СтрокаТоваров.ВсегоСтрок   = СтрокаТоваров.ВсегоСтрок   + 1;
		
		Группировка.ВсегоСтрок          = Группировка.ВсегоСтрок + 1;
		Группировка.Количество          = Группировка.Количество + РесурсыСтроки.КЗаказу;
		
	КонецЕсли;
	
КонецФункции

// Процедура отражает изменение строки ТЧ "ЗаказыКОбеспечению" в связанном дереве документов
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Поставка - Произвольный - Поставка.
//  Знач КоличествоКЗаказу - Произвольный - Знач количество к заказу.
//  Знач ВозможныРаботы - Произвольный - Знач возможны работы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура питОтразитьПоставкуВДеревеДокументов(Форма, Поставка, Знач КоличествоКЗаказу, Знач ВозможныРаботы)
	
	ПриращениеКоличества            = КоличествоКЗаказу     - Поставка.КоличествоСтарое;
	
	ДобавлениеУдалениеСтроки = ?(Поставка.КоличествоСтарое = 0, 1, ?(КоличествоКЗаказу = 0, -1, 0));
	
	// Старое количество будет актуализировано в типовой функции "ОтразитьПоставкуВКорзине".
	// Поставка.КоличествоСтарое       = КоличествоКЗаказу;
	
	Если ПриращениеКоличества = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Формируем ключ поставки, для поиска позиции в иерархии дерева, в которую необходимо добавлять новую строку.
	КлючОбъектаВДеревеДокументов = Новый Массив();
	КлючОбъектаВДеревеДокументов.Добавить(
		Новый Структура("Организация, Подразделение, Склад, ЦеховаяКладовая, ДатаПоставки, СкладМатериалов",
			Поставка.Организация1,
				Поставка.Подразделение1,
			Поставка.Склад1, Поставка.ЦеховаяКладовая1, Поставка.ДатаПоставки1, Поставка.СкладМатериалов1));
	
	СтруктураКлюча = Новый Структура("Заказ, Номенклатура, Характеристика, Назначение, ЕдиницаИзмерения");
	ЗаполнитьЗначенияСвойств(СтруктураКлюча, Поставка);
	
	// Организация - Организация1 и т.д.
	НовыеЗначенияПоставка = Новый Структура("Организация1, Подразделение1, Склад1, ЦеховаяКладовая1, ДатаПоставки1, СкладМатериалов1",
			Поставка.Организация,
				Поставка.Подразделение,
			Поставка.Склад, Поставка.ЦеховаяКладовая, Поставка.ДатаПоставки, Поставка.СкладМатериалов);
	ЗаполнитьЗначенияСвойств(Поставка, НовыеЗначенияПоставка);
	
	КлючОбъектаВДеревеДокументов.Добавить(СтруктураКлюча);
	
	// Инициализируем поиск с головы дерева.
	ЭлементДерева           = Форма.ДеревоДокументов;
	ВсегоГруппировокВДереве = КлючОбъектаВДеревеДокументов.Количество();
	
	ГруппировкаНайдена      = Ложь;
	Для ИндексГруппировки = 0 По ВсегоГруппировокВДереве - 1 Цикл
		
		КлючОбъектаДляГруппировки = КлючОбъектаВДеревеДокументов[ИндексГруппировки];
		
		// Получаем все элементы на текущем уровне иерархии дерева.
		КоллекцияЭлементовДерева = ЭлементДерева.ПолучитьЭлементы();
		ВсегоЭлементов           = КоллекцияЭлементовДерева.Количество();
		
		// Сверяем ключ строки поставки с полями группировки.
		Для Индекс = 0 По ВсегоЭлементов - 1 Цикл
		
			ЭлементДерева = КоллекцияЭлементовДерева[Индекс];
			ГруппировкаНайдена = Истина;
			Для Каждого КлючОбъектаДляПоляГруппировки Из КлючОбъектаДляГруппировки Цикл
			
				Если ЭлементДерева[КлючОбъектаДляПоляГруппировки.Ключ] <> КлючОбъектаДляПоляГруппировки.Значение Тогда
					
					ГруппировкаНайдена = Ложь;
					Прервать;
				
				КонецЕсли;
		
			КонецЦикла;
		
			Если ГруппировкаНайдена Тогда
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		
		// Ключ поставки не был обнаружен на текущем уровне иерархии, в данном уровне необходимо добавлять строку с новыми
		// значениями ключа, заданными в поставке.
		Если Не ГруппировкаНайдена Тогда 
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	// Создаем новую ветвь в дереве согласно ключу поставки, заполняем строки данными поставки.
	// Поля показателей оставляем нулевыми.
	Для Счетчик = ИндексГруппировки По ВсегоГруппировокВДереве - 1 Цикл
		
		ЭлементДерева = КоллекцияЭлементовДерева.Вставить(Индекс);
		
		ЗаполнитьЗначенияСвойств(ЭлементДерева, Поставка);
		ЭлементДерева.ИсточникОбеспечения =
			?(НЕ ЗначениеЗаполнено(Поставка.ИсточникОбеспечения), 
				Форма.ТекстНеЗаполнено, 
				Поставка.ИсточникОбеспечения);
		КоллекцияЭлементовДерева = ЭлементДерева.ПолучитьЭлементы();
		
		Если Счетчик = 0 Тогда
			ЭлементДерева.Заказ = Неопределено;
			ЭлементДерева.ПланМеню = питПолучитьПредставлениеГруппировкиДереваДокументов(КлючОбъектаВДеревеДокументов[0], Форма.ТекстНеЗаполнено, Форма.питМаксНомерПлана);
		КонецЕсли;
		
		Индекс = 0;
		
	КонецЦикла;
	
	// Пересчитаем показатели вверх по иерархии дерева в связи с обновлением поставки.
	ЭлементДереваНаУдаление = Неопределено;
	
	Пока ЭлементДерева <> Неопределено Цикл
		
		ЭлементДерева.Количество    = ЭлементДерева.Количество   + ПриращениеКоличества;
		
		ЭлементДерева.ВсегоСтрок            = ЭлементДерева.ВсегоСтрок + ДобавлениеУдалениеСтроки; 
		
		// Запоминаем, если строка подлежит удалению.
		Если ЭлементДерева.Количество = 0 Тогда
			
			ЭлементДереваНаУдаление = ЭлементДерева;
			
		КонецЕсли;
		
		ЭлементДерева = ЭлементДерева.ПолучитьРодителя();
		
	КонецЦикла;
	
	// Удаляем ветку, при необходимости.
	Если ЭлементДереваНаУдаление <> Неопределено Тогда
		
		Родитель = ЭлементДереваНаУдаление.ПолучитьРодителя();
		Родитель = ?(Родитель <> Неопределено, Родитель, Форма.ДеревоДокументов);
		Родитель.ПолучитьЭлементы().Удалить(ЭлементДереваНаУдаление);
	
	КонецЕсли;
	
КонецПроцедуры

// Функция получает представление группировки в дереве документов.
//
// Параметры:
//  СтруктураГруппировки - Структура - Структура группировки.
//  ТекстНеЗаполнено - Произвольный - Текст не заполнено.
//  питМаксНомерПлана - Произвольный - пит макс номер плана.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция питПолучитьПредставлениеГруппировкиДереваДокументов(СтруктураГруппировки, ТекстНеЗаполнено = "<Не заполнено>", питМаксНомерПлана)
	
	ПланМенюОбъект = Документы.питПланМеню.СоздатьДокумент();
	ПланМенюОбъект.Дата = СтруктураГруппировки.ДатаПоставки;
	ПланМенюОбъект.ДатаПлан = СтруктураГруппировки.ДатаПоставки;
	ЗаполнитьЗначенияСвойств(ПланМенюОбъект, СтруктураГруппировки);
	ПланМенюОбъект.УстановитьСсылкуНового(Документы.питПланМеню.ПолучитьСсылку(Новый УникальныйИдентификатор));
	// ПланМенюОбъект.УстановитьНовыйНомер();
	
	питМаксНомерПлана = питМаксНомерПлана+1;
	
	Возврат Строка("План-меню "+Формат(питМаксНомерПлана,"ЧЦ=10; ЧРД=; ЧРГ=; ЧВН=; ЧГ=")+" от "+Формат(ПланМенюОбъект.Дата,"ДФ='dd.MM.yyyy hh:mm:ss'"));
	
КонецФункции

// Процедура отражает изменение строки ТЧ "ЗаказыКОбеспечению" в связанном дереве документов
//  и типовом дереве "Корзина заказов".
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Поставка - Произвольный - Поставка.
//  КоличествоКЗаказу - Произвольный - Количество к заказу.
//  ВозможныРаботы - Произвольный - Возможны работы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура питОтразитьПоставкуВКорзинеИДеревеДокументов(Форма, Поставка, КоличествоКЗаказу, ВозможныРаботы)
	
	питОтразитьПоставкуВДеревеДокументов(Форма, Поставка, КоличествоКЗаказу, ВозможныРаботы);
	
	ОтразитьПоставкуВКорзине(Форма, Поставка, КоличествоКЗаказу, ВозможныРаботы);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Назад фрагмент.
//
&НаКлиенте
Процедура НазадФрагмент()
	
	ОчиститьСообщения();
	ДлительнаяОперация = УдалениеЗаказовВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтаФорма);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
	Новый ОписаниеОповещения("УдалениеЗаказовВФонеЗавершение", ЭтаФорма),
	ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти



