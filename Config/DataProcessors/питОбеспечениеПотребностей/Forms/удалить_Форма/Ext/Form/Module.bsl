//  Процедура - Заказ поставщику подтвержден.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаказПоставщикуПодтвержден(Команда)
	
	ОчиститьСообщения();
	
	МассивСсылок = Новый Массив();
	Для Каждого Идентификатор Из Элементы.СформированныеЗаказы.ВыделенныеСтроки Цикл
		СтрокаСписка = ТаблицаДокументы.НайтиПоИдентификатору(Идентификатор);
		Если ТипЗнч(СтрокаСписка.Документ) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			МассивСсылок.Добавить(Новый Структура("Ссылка, ИдентификаторСтроки", СтрокаСписка.Документ, Идентификатор));
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		УстановитьСтатусНаСервере(МассивСсылок, "Подтвержден");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Невозможно установить статус. Не выбраны заказы поставщику';
																|en = 'Cannot set the status. Purchase orders are not selected'"));
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заказ переработчику к исполнению.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаказПереработчикуКИсполнению(Команда)
	
	// ++ НЕ УТ
	ОчиститьСообщения();
	
	МассивСсылок = Новый Массив();
	Для Каждого Идентификатор Из Элементы.СформированныеЗаказы.ВыделенныеСтроки Цикл
		СтрокаСписка = ТаблицаДокументы.НайтиПоИдентификатору(Идентификатор);
		Если ТипЗнч(СтрокаСписка.Документ) = Тип("ДокументСсылка.ЗаказПереработчику2_5")
		// ++ Устарело_Переработка24
		 Или ТипЗнч(СтрокаСписка.Документ) = Тип("ДокументСсылка.ЗаказПереработчику")
		 // -- Устарело_Переработка24
		 Или Ложь Тогда
			МассивСсылок.Добавить(Новый Структура("Ссылка, ИдентификаторСтроки", СтрокаСписка.Документ, Идентификатор));
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		УстановитьСтатусНаСервере(МассивСсылок, "КИсполнению");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Невозможно установить статус. Не выбраны заказы переработчику';
																|en = 'Cannot set the status. Tolling orders are not selected'"));
	КонецЕсли;
	// -- НЕ УТ
	Возврат;
	
КонецПроцедуры

//  Процедура - Заказ на производство к производству.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаказНаПроизводствоКПроизводству(Команда)
	
	// ++ НЕ УТКА
	ОчиститьСообщения();
	
	МассивСсылок = Новый Массив();
	Для Каждого Идентификатор Из Элементы.СформированныеЗаказы.ВыделенныеСтроки Цикл
		СтрокаСписка = ТаблицаДокументы.НайтиПоИдентификатору(Идентификатор);
		Если ТипЗнч(СтрокаСписка.Документ) = Тип("ДокументСсылка.ЗаказНаПроизводство2_2")
			// ++ Устарело_Производство21
			ИЛИ ТипЗнч(СтрокаСписка.Документ) = Тип("ДокументСсылка.ЗаказНаПроизводство")
			// -- Устарело_Производство21
		Тогда
			МассивСсылок.Добавить(Новый Структура("Ссылка, ИдентификаторСтроки", СтрокаСписка.Документ, Идентификатор));
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивСсылок) Тогда
		УстановитьСтатусНаСервере(МассивСсылок, "КПроизводству");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Невозможно установить статус. Не выбраны заказы на производство';
																|en = 'Cannot set the status. Production orders are not selected'"));
	КонецЕсли;
	// -- НЕ УТКА
	Возврат;
	
КонецПроцедуры

//  Процедура - Развернуть строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
