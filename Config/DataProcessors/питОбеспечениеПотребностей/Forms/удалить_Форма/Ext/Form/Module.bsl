#Область Общепит

// Дерево "ДеревоЗаказыКОбеспечению" отображает данные в 2 уровня:
// на верхнем уровне планы-меню, которые будут оформлены;
// на нижнем - строки заказов, которые попадут в планы-меню.
// Данное дерево синхронизируется с ТЗ "ЗаказыКОбеспечению"
// по которой далее и происходит формирование планов меню.
#Область ДеревоЗаказыКОбеспечению

#Область ДеревоЗаказыКОбеспечениюСлужебныеПроцедурыИФункции

// Процедура актуализирует связанные с ТЧ "ЗаказыКОбеспечению" данные при изменении ее измерений.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент)
	
	// Текущие данные.
	Поставка = Элементы.ДеревоЗаказыКОбеспечению.ТекущиеДанные;
	
	// Текущий идентификатор строки. Может измениться, если строка будет перенесена.
	ТекИдентификатор = Поставка.ПолучитьИдентификатор();
	
	Если НЕ Поставка = Неопределено Тогда
		
		Если ПустаяСтрока(Поставка.Группировка) Тогда
			// Если это строка заказов.
			
			// Имена колонок группировок.
			ИменаКолонокГруппировки = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0);
			ИменаКолонокРесурсы = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(2);
			ИменаКолонокГруппировкаСтрокой = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
			КлючиГруппировкиСтруктура = Новый Структура(ИменаКолонокГруппировкаСтрокой);
			ЗаполнитьЗначенияСвойств(КлючиГруппировкиСтруктура, Поставка);
			
			ИмяКолонкиДереваЗначений = СтрЗаменить(Элемент.Имя,"ДеревоЗаказыКОбеспечению","");
			Если НЕ ИменаКолонокГруппировки.Найти(ИмяКолонкиДереваЗначений) = Неопределено 
				И Поставка[ИмяКолонкиДереваЗначений] <> Поставка[ИмяКолонкиДереваЗначений+"1"] Тогда
				// Если было изменено значение колонки, и эта колонка входит в колонки группировки, то
				// такая строка будет перенесена в другую группировку с соответствующими значениями колонок.
				
				// Актуализируем значение дублирующей колонки.
				Поставка[ИмяКолонкиДереваЗначений+"1"] = Поставка[ИмяКолонкиДереваЗначений];
				
				// Поиск нового родителя.
				НоваяСтрокаГруппировки = Неопределено;
				Для каждого ТекГруппировкаДерева Из ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы() Цикл
					СтрокаГруппировкиНайдена = Истина;
					Для каждого ТекИмяКолонкиТовары Из ИменаКолонокГруппировки Цикл
						Если ТекГруппировкаДерева[ТекИмяКолонкиТовары] <> Поставка[ТекИмяКолонкиТовары] Тогда
							СтрокаГруппировкиНайдена = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если СтрокаГруппировкиНайдена Тогда
						НоваяСтрокаГруппировки = ТекГруппировкаДерева;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				// Добавляем новую строку группировки, если она не была найдена.
				Если НоваяСтрокаГруппировки = Неопределено Тогда
					НоваяСтрокаГруппировки = ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы().Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаГруппировки, Поставка, ИменаКолонокГруппировкаСтрокой);
					НоваяСтрокаГруппировки.КартинкаПриоритета = 1;
					НоваяСтрокаГруппировки.Группировка = питПолучитьПредставлениеГруппировкиДереваДокументов(КлючиГруппировкиСтруктура, ТекстНеЗаполнено, ЭтаФорма.питМаксНомерПлана);
				КонецЕсли;
				
				// Добавляем новую строку заказа, переносим в нее все данные из старой строки.
				НоваяСтрокаТоваров = НоваяСтрокаГруппировки.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, Поставка);
				
				// Актуализируем значение идентификатора строки.
				ТекИдентификатор = НоваяСтрокаТоваров.ПолучитьИдентификатор();
				
				// Пересчет ресурсов новой строки группировки.
				Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
					НоваяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = 0;
				КонецЦикла;
				Для каждого ТекСтрокаНовойГруппировки Из НоваяСтрокаГруппировки.ПолучитьЭлементы() Цикл
					Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
						НоваяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = НоваяСтрокаГруппировки[ТекИмяКолонкиРесурсы] + ТекСтрокаНовойГруппировки[ТекИмяКолонкиРесурсы];
					КонецЦикла;
				КонецЦикла;
				
				// Удаление старой строки заказа.
				СтараяСтрокаТоваров = ЭтаФорма.ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(Поставка.ПолучитьИдентификатор());
				СтараяСтрокаГруппировки = СтараяСтрокаТоваров.ПолучитьРодителя();
				СтараяСтрокаГруппировки.ПолучитьЭлементы().Удалить(СтараяСтрокаТоваров);
				// Если в верхней группировке не осталось элементов - удаляем верхнюю группировку.
				Если НЕ СтараяСтрокаГруппировки.ПолучитьЭлементы().Количество() Тогда
					ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы().Удалить(СтараяСтрокаГруппировки);
				Иначе // Пересчитаем ресурсы старой группировки.
					// Пересчет ресурсов новой строки группировки.
					Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
						СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = 0;
					КонецЦикла;
					Для каждого ТекСтрокаСтаройГруппировки Из СтараяСтрокаГруппировки.ПолучитьЭлементы() Цикл
						Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
							Если ТекИмяКолонкиРесурсы = "КЗаказу" И НЕ ТекСтрокаСтаройГруппировки.Отметка Тогда
								Продолжить;
							КонецЕсли;
							СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] + ТекСтрокаСтаройГруппировки[ТекИмяКолонкиРесурсы];
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;
				
				// Развернуть группировку после всех изменений.
				Элементы.ДеревоЗаказыКОбеспечению.Развернуть(НоваяСтрокаГруппировки.ПолучитьИдентификатор());
				
			Иначе // Изменение не повлияло на группировки
				
				// Пересчитаем ресурсы старой группировки.
				СтараяСтрокаТоваров = ЭтаФорма.ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ТекИдентификатор);
				Если НЕ СтараяСтрокаТоваров = Неопределено Тогда
					СтараяСтрокаГруппировки = СтараяСтрокаТоваров.ПолучитьРодителя();
					// Пересчет ресурсов новой строки группировки.
					Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
						СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = 0;
					КонецЦикла;
					Для каждого ТекСтрокаСтаройГруппировки Из СтараяСтрокаГруппировки.ПолучитьЭлементы() Цикл
						Для каждого ТекИмяКолонкиРесурсы Из ИменаКолонокРесурсы Цикл
							Если ТекИмяКолонкиРесурсы = "КЗаказу" И НЕ ТекСтрокаСтаройГруппировки.Отметка Тогда
								Продолжить;
							КонецЕсли;
							СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] = СтараяСтрокаГруппировки[ТекИмяКолонкиРесурсы] + ТекСтрокаСтаройГруппировки[ТекИмяКолонкиРесурсы];
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
			
			// Актуализировать исходную таблицу "ЗаказыКОформлению".
			питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(ТекИдентификатор);
			
		Иначе // Изменили что-то на верхнем уровене(план-меню).
			
			// Перенесем изменение на уровень ниже.
			СтараяСтрокаГруппировки = ЭтаФорма.ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ТекИдентификатор);
			Если НЕ СтараяСтрокаГруппировки = Неопределено Тогда
				
				ИменаКолонокГруппировка			= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
				ИменаКолонокГруппировкаМассив	= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0);
				СтарыеСтрокиТоваров = СтараяСтрокаГруппировки.ПолучитьЭлементы();
				Для каждого ТекСтараяСтрокаТоваров Из СтарыеСтрокиТоваров Цикл
					ЗаполнитьЗначенияСвойств(ТекСтараяСтрокаТоваров, СтараяСтрокаГруппировки, ИменаКолонокГруппировка);
					Для каждого ТекИмяКолонкиГруппировки Из ИменаКолонокГруппировкаМассив Цикл
						ТекСтараяСтрокаТоваров[ТекИмяКолонкиГруппировки+"1"] = ТекСтараяСтрокаТоваров[ТекИмяКолонкиГруппировки];
					КонецЦикла;
					
					// Актуализировать исходную таблицу "ЗаказыКОформлению".
					питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(ТекСтараяСтрокаТоваров.ПолучитьИдентификатор());
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Меянем фокус текущей строки после всех изменений.
	Элементы.ДеревоЗаказыКОбеспечению.ТекущаяСтрока = ТекИдентификатор;
	
КонецПроцедуры

#КонецОбласти

#Область ДеревоЗаказыКОбеспечениюПеретаскивание

// Процедура осуществляет действия с деревом заказов после окончания перетаскивания.
//
// Параметры:
//  Элемент - ТаблицаФормы - Таблица формы.
//  ПараметрыПеретаскивания - ПараметрыПеретаскивания - Параметры перетаскивания.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	СтрокиГруппировки = ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы();
	
	// Пересчет ресурсов дерева.
	питДеревоЗаказыКОбеспечениюПересчитатьРесурсы();
	
	// Удаление пустых строк планов-меню.
	питДеревоЗаказыКОбеспечениюУдалитьПустыеСтрокиПлановМеню();
	
	// Актуализация связанной строки ТЧ "ЗаказыКОбеспечению".
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") 
		И ПараметрыПеретаскивания.Значение.Количество() Тогда
		
		ПеренесенныеСтроки = ПараметрыПеретаскивания.Значение;
		
		// Получение новой строки дерева значений из параметров перетаскивания.
		Для каждого ПеренесеннаяСтрока Из ПеренесенныеСтроки Цикл
			
			// Получение этой же строки в дереве значений.
			ЭлементВДереве = Неопределено;
			Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
				Для каждого СтрокаТоваров Из СтрокаГруппировки.ПолучитьЭлементы() Цикл
					Если СтрокаТоваров.ИдентификаторСтроки = ПеренесеннаяСтрока.ИдентификаторСтроки Тогда
						ЭлементВДереве = СтрокаТоваров;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ ЭлементВДереве = Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЭлементВДереве = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Актуализировать исходную таблицу "ЗаказыКОформлению".
			питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(СтрокаТоваров.ПолучитьИдентификатор());
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура осуществляет действия по перетаскиванию строки дерева заказов.
//
// Параметры:
//  Элемент - ТаблицаФормы - Таблица формы.
//  ПараметрыПеретаскивания - ПараметрыПеретаскивания - Параметры перетаскивания.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//  Строка - Строка - Идентификатор строки нового родителя.
//  Поле - ПолеФормы - Поле, с которым связана данная колонка таблицы, над которой находится объект.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	// Текущие данные.
	ТекДанные = Элемент.ТекущиеДанные;
	
	// Для множественного переноса.
	ВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	
	СтрокиДляУдаления = Новый Массив;
	
	// Если текущие данные найдены.
	Если НЕ ТекДанные = Неопределено Тогда
		
		// Перетаскивать будем вручную, без стандартной обработки, т.к. она не предусматривает множественное перетаскивание.
		СтандартнаяОбработка = Ложь;
		
		Для каждого ТекВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			
			// Идентификатор строки, которую перетаскиваем.
			ТекИдентификатор = ТекВыделеннаяСтрока;
			
			// Строка, которую перетаскиваем.
			ТекСтрока					= ЭтаФорма.ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ТекИдентификатор);
			
			// Строка, в которую перетаскиваем.
			НовыйРодитель				= ?(Строка = Неопределено, Неопределено, ЭтаФорма.ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(Строка));
			
			// Строка, из которой перетаскиваем.
			СтарыйРодитель				= ?(ТекСтрока = Неопределено, Неопределено, ТекСтрока.ПолучитьРодителя());
			
			// Имена неизменяемых колонок верхнего уровня.
			ИменаНеИзменяемыхКолонок	= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(4);
			СообщениеОбОшибке = "";
			ЕстьРазличияВНеизменяемыхКолонках = Ложь;
			Если НЕ НовыйРодитель = Неопределено И НЕ СтарыйРодитель = Неопределено Тогда
				Для каждого ТекНеИзмКолонка Из ИменаНеИзменяемыхКолонок Цикл
					Если НовыйРодитель[ТекНеИзмКолонка] <> СтарыйРодитель[ТекНеИзмКолонка] Тогда
						ЕстьРазличияВНеизменяемыхКолонках = Истина;
						СообщениеОбОшибке = "Не удалось перенести строку по причине:
						| Колонка """+ТекНеИзмКолонка+""" для "+СтарыйРодитель.Группировка+" имеет значение "+СтарыйРодитель[ТекНеИзмКолонка]+",
						| а для "+НовыйРодитель.Группировка+" имеет значение "+НовыйРодитель[ТекНеИзмКолонка]+" ! ";
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Определим, расрешено ли перетаскивание.
			СтарыйРодительЭтоКорень		= СтарыйРодитель = Неопределено;
			НовыйРодительЭтоЗаказ		= ?(НовыйРодитель = Неопределено, Неопределено, ПустаяСтрока(НовыйРодитель.Группировка));
			Если НовыйРодительЭтоЗаказ = Истина Тогда
				НовыйРодитель = НовыйРодитель.ПолучитьРодителя();
				НовыйРодительЭтоЗаказ		= ?(НовыйРодитель = Неопределено, Неопределено, ПустаяСтрока(НовыйРодитель.Группировка));
				Если НЕ НовыйРодитель = Неопределено Тогда
					Строка = НовыйРодитель.ПолучитьИдентификатор();
				КонецЕсли;
			КонецЕсли;
			
			ТекСтрокаЭтоПланМеню		= ?(ТекСтрока = Неопределено, Неопределено, НЕ ПустаяСтрока(ТекСтрока.Группировка));
			
			ПеретаскиваниеЗапрещено = СтарыйРодительЭтоКорень 
			ИЛИ НЕ(НовыйРодительЭтоЗаказ = Ложь) 
			ИЛИ НЕ(ТекСтрокаЭтоПланМеню = Ложь) 
			ИЛИ ЕстьРазличияВНеизменяемыхКолонках;
			
			Если ЕстьРазличияВНеизменяемыхКолонках Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке);
			КонецЕсли;
			
			// Запрет перетаскивания
			Если ПеретаскиваниеЗапрещено Тогда
				Продолжить;
			КонецЕсли;
			
			// Имена колонок, которые необходимо перезаполнить.
			ИменаКолонокГруппировка		= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
			// Имена колонок массивом.
			ИменаКолонокГруппировкаМассив		= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0);
			
			Если НЕ ТекСтрока = Неопределено И НЕ НовыйРодитель = Неопределено Тогда
				
				// !!!
				// У текущей строки меняем поля группировки на те, что у нового родителя.
				ЗаполнитьЗначенияСвойств(ТекСтрока, НовыйРодитель, ИменаКолонокГруппировка);
				Для каждого ТекИмяКолонкиГруппровки Из ИменаКолонокГруппировкаМассив Цикл
					ТекСтрока[ТекИмяКолонкиГруппровки+"1"] = ТекСтрока[ТекИмяКолонкиГруппровки];
				КонецЦикла;
				
				НовСтрока = НовыйРодитель.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
				
				Если НЕ СтарыйРодитель = Неопределено Тогда
					Попытка
						СтрокиДляУдаления.Добавить(ТекСтрока);
					Исключение
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого ТекСтрокаДляУдаления Из СтрокиДляУдаления Цикл
			ТекСтрокаДляУдаления.ПолучитьРодителя().ПолучитьЭлементы().Удалить(ТекСтрокаДляУдаления);
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры

