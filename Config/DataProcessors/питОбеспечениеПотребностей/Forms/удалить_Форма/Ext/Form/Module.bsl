		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаказыКОбеспечению.Отметка");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ИсточникОбеспеченияЗапасы.Имя);
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.СпособОбеспечения");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.Отметка");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ИсточникОбеспеченияЗаказы.Имя);
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаказыКОбеспечению.СпособОбеспечения");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаказыКОбеспечению.Отметка");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
	КонецЕсли;
	
	// +пит
	питУстановитьУсловноеОформление();
	// -пит
	
КонецПроцедуры

//  Процедура - Установить подсказки.
//
&НаСервере
Процедура УстановитьПодсказки()
	
	Подсказки = Новый Структура();
	
	Подсказки.Вставить("СпособыОбеспеченияНаступилаДатаОчередногоЗаказа",
		НСтр("ru = 'Определяет состав товаров,
		|автоматически включаемых в
		|формируемый заказ на третьем
		|шаге работы обработки';
		|en = 'Determines the content of goods
		|which are automatically included in
		|the generated order on the third
		|step of the data processor'"));
		
	Подсказки.Вставить("СпособыОбеспеченияДатаПоставки",
		НСтр("ru = 'Дата ожидаемого поступления, которая
		|будет указана в формируемом заказе';
		|en = 'Date of expected receipt which
		|will be indicated in the order generated'"));
		
	Подсказки.Вставить("СпособыОбеспеченияДатаСледующейПоставки",
		НСтр("ru = 'Граница периода, обеспечиваемого поставкой по графику';
			|en = 'Limit of the period covered by the scheduled delivery'"));
	
	Подсказки.Вставить("СпособыОбеспеченияДнейДоЗаказаПоГрафикуПредставление",
		НСтр("ru = 'Число дней до даты формирования
		|заказа на ближайшую поставку по графику';
		|en = 'Number of days before the date of order generation
		|for the nearest delivery on schedule'"));
	
	Подсказки.Вставить("ГруппаКЗаказуЗапасы",
		НСтр("ru = 'Количество, которое будет указано
		|в формируемом заказе, заказываемое
		|для поддержания запаса';
		|en = 'Number that will be indicated
		|in generated order to maintain 
		|the inventory level'"));
	
	Подсказки.Вставить("ЗаказыКПоступлению",
		НСтр("ru = 'Количество, заказаное ранее и ожидаемое к
		|поступлению';
		|en = 'Quantity ordered earlier and anticipated for
		|arrival'"));
	
	Подсказки.Вставить("МетодОбеспечения",
		НСтр("ru = 'Действующий метод обеспечения потребностей.
		|Поддержание запаса с установкой минимального
		|и максимального запасов вручную, либо расчетным
		|путем по норме или по статистике потребления';
		|en = 'Current method to meet the demand.
		|The inventory is maintained through manual setup of minimum
		|and maximum inventory or calculations by the rate or
		|consumption rate statistics'"));
	
	Подсказки.Вставить("МинимальныйЗапас",
		НСтр("ru = 'Минимальное количество запаса,
		|указанное в товарном ограничении,
		|или рассчитанное по статистике';
		|en = 'Minimum inventory quantity
		|specified in goods restriction
		|or calculated by statistics'"));
	
	Подсказки.Вставить("МаксимальныйЗапас",
		НСтр("ru = 'Максимальное количество запаса,
		|указанное в товарном ограничении,
		|или рассчитанное по статистике';
		|en = 'Maximum inventory amount
		|specified in goods restriction
		|or calculated by statistics'"));
	
	Подсказки.Вставить("Остаток", НСтр("ru = 'Текущий остаток товара на складе';
										|en = 'Current stock balance in the warehouse'"));
	
	Для Каждого Подсказка Из Подсказки Цикл
		Элементы[Подсказка.Ключ].Подсказка = Подсказка.Значение;
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Проверить корректность заполнения фильтра к отгрузке не позднее.
//
// Параметры:
//  Дата - Дата - Дата.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПроверитьКорректностьЗаполненияФильтраКОтгрузкеНеПозднее(Дата, СтандартнаяОбработка)

	Если Дата < ФильтрКОтгрузкеНеРанее И ЗначениеЗаполнено(ФильтрКОтгрузкеНеРанее) Тогда

		СтандартнаяОбработка = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Дата окончания периода не может быть меньше даты начала';
										|en = 'Period end date cannot be less than start date'"), , );

	КонецЕсли;

КонецПроцедуры

//  Функция - Обработать пустой источник обеспечения.
//
// Параметры:
//  ИсточникОбеспечения - Произвольный - Источник обеспечения.
//  ТекстНеЗаполнено - Произвольный - Текст не заполнено.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ОбработатьПустойИсточникОбеспечения(ИсточникОбеспечения, ТекстНеЗаполнено)
	
	Если Не ЗначениеЗаполнено(ИсточникОбеспечения) Тогда
		ИсточникОбеспечения = ТекстНеЗаполнено;
	КонецЕсли;
	
	Возврат ИсточникОбеспечения;
	
КонецФункции

//  Процедура - Сообщить об ошибке незаполненного способа обеспечения.
//
// Параметры:
//  Таблица - ТаблицаЗначений - Таблица.
//
&НаСервере
Процедура СообщитьОбОшибкеНезаполненногоСпособаОбеспечения(Таблица)
	
	ШаблонТекста = Неопределено;
	Если Элементы.СтраницыТаблицаПотребностей.ТекущаяСтраница = Элементы.СтраницаТаблицаЗапасы Тогда
		
		ИмяТаблицы = "Запасы";
		ШаблонТекста = НСтр("ru = 'Не заполнена колонка ""Способ обеспечения"" в строке %НомерСтроки% списка ""Поддержание запасов""';
							|en = 'Column ""Supply method"" in line  %НомерСтроки% of the ""Inventory level control"" list is not filled in.'");
		
	ИначеЕсли Элементы.СтраницыТаблицаПотребностей.ТекущаяСтраница = Элементы.СтраницаТаблицаЗаказы Тогда
		
		ИмяТаблицы = "ЗаказыКОбеспечению";
		ШаблонТекста = НСтр("ru = 'Не заполнена колонка ""Способ обеспечения"" в строке %НомерСтроки% списка ""Обеспечение заказов""';
							|en = 'Column ""Supply method"" column in line  %НомерСтроки% of the ""Order fulfillment"" list is not filled in.'");
		
	КонецЕсли;
	
	Таблица = Объект[ИмяТаблицы]; // ДанныеФормыКоллекция - 
	
	Для Каждого Строка Из Таблица Цикл
		
		Если Строка.Отметка И Не ЗначениеЗаполнено(Строка.СпособОбеспечения) Тогда
			
			ТекстОшибки = СтрЗаменить(ШаблонТекста, "%НомерСтроки%", Таблица.Индекс(Строка) + 1);
			ПутьКТабЧасти = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТаблицы, Таблица.Индекс(Строка) + 1, "СпособОбеспечения");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Неопределено, "Объект." + ПутьКТабЧасти);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Заполнить источник обеспечения.
//
// Параметры:
//  МассивТиповОбеспечения - Массив - Массив типов обеспечения.
//
&НаКлиенте
Процедура ЗаполнитьИсточникОбеспечения(МассивТиповОбеспечения)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Обработка.ОбеспечениеПотребностей.Форма.Форма.Команда.ЗаполнитьИсточникОбеспечения");
	
	ТекущаяТаблица = ?(Элементы.СтраницыТаблицаПотребностей.ТекущаяСтраница = Элементы.СтраницаТаблицаЗапасы,
		"Запасы", "ЗаказыКОбеспечению");
	
	ПараметрыФормы = Новый Структура("ТипОбеспечения, ГрупповоеЗаполнение", Неопределено, Истина);
	Для каждого Идентификатор Из Элементы[ТекущаяТаблица].ВыделенныеСтроки Цикл
		СтрокаПотребности = Объект[ТекущаяТаблица].НайтиПоИдентификатору(Идентификатор);
		Если Не СтрокаПотребности.ИсточникОбеспеченияТолькоПросмотр
			И МассивТиповОбеспечения.Найти(СтрокаПотребности.ТипОбеспечения) <> Неопределено Тогда
			ПараметрыФормы.ТипОбеспечения = СтрокаПотребности.ТипОбеспечения;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрыФормы.ТипОбеспечения <> Неопределено Тогда
		ОткрытьФорму("Обработка.ОбеспечениеПотребностей.Форма.ФормаВыбораИсточникаОбеспечения", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Не выделено ни одной строки с доступным для изменения источником обеспечения. Выполнение команды невозможно.';
										|en = 'No line with supply source available for change is selected. Cannot run the command.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОкруглениеКоличества

// Пересчитывает округление для всех строк соответствующих корню ИДИндекса
//
// Параметры:
//  Строка - ДанныеФормыКоллекция - Строка, содержащая идентификатор корня в дереве ИндексыПоиска, по ветвям которого
//   работает алгоритм.
//  Запасы - Булево - Признак того, что вызов процедуры производится на шаге Запасы.
//
// Возвращаемое значение:
//   Соответствие - обработанные строки.
&НаКлиенте
Функция ПересчитатьОкруглениеКлиент(Строка, Запасы = Ложь)
	
	Если Строка = Неопределено Тогда

		Возврат Неопределено;
	КонецЕсли;
	
	ИДИндекса = Строка.ИДИндекса;
	
	СоответствиеСтрок = ПодготовитьСоответствиеСтрокДляОкругленияКлиент(ИДИндекса);
	
	Структура = ОкруглитьСоответствиеСтрок(СоответствиеСтрок, ИспользоватьУпаковки);
	
	Возврат СоответствиеСтрок;
	
КонецФункции

// Пересчитывает округление для всех строк соответствующих корню ИДИндекса
//
// Параметры:
//  Строка - ДанныеФормыКоллекция - Строка, содержащая идентификатор корня в дереве ИндексыПоиска, по ветвям которого
//   работает алгоритм.
//  Запасы - Булево - Признак того, что вызов процедуры производится на шаге Запасы.
//
// Возвращаемое значение:
//   Соответствие - обработанные строки.
&НаСервере
Функция ПересчитатьОкруглениеСервер(Строка, Запасы = Ложь)
	
	Если Строка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИДИндекса = Строка.ИДИндекса;
	
	СоответствиеСтрок = ПодготовитьСоответствиеСтрокДляОкругленияСервер(ИДИндекса);
	
	Структура = ОкруглитьСоответствиеСтрок(СоответствиеСтрок, ИспользоватьУпаковки);
	
	Возврат СоответствиеСтрок;
	
КонецФункции

//  Функция - Подготовить соответствие строк для округления клиент.
//
// Параметры:
//  ИДИндекса - Произвольный - Ид индекса.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
//
&НаКлиенте
Функция ПодготовитьСоответствиеСтрокДляОкругленияКлиент(ИДИндекса)
	
	Корень = ИндексыПоиска.НайтиПоИдентификатору(ИДИндекса);
	
	ВетвиКорня = Корень.ПолучитьЭлементы();
	
	// Сортировка результата с помощью дополнительной таблицы, для распределения остатка от округления по датам.
	ИндексыПоискаТаблицаСортировки.Очистить();
	
	Для Каждого Ветвь Из ВетвиКорня Цикл
		Строка = ?(Ветвь.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Ветвь.ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Ветвь.ИДСтроки));
		
		СтрокаСортировки = ИндексыПоискаТаблицаСортировки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСортировки, Ветвь);
		СтрокаСортировки.ДатаПоставки = Строка.ДатаПоставки;
	КонецЦикла;
	
	ИндексыПоискаТаблицаСортировки.Сортировать("ДатаПоставки");
	
	Соответствие = Новый Соответствие();
	
	Для Каждого СтрокаСортировки Из ИндексыПоискаТаблицаСортировки Цикл
		Строка = ?(СтрокаСортировки.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(СтрокаСортировки.ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(СтрокаСортировки.ИДСтроки));
		
		Соответствие.Вставить(Строка, СтрокаСортировки.ТаблицаЗапасы);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

//  Функция - Подготовить соответствие строк для округления сервер.
//
// Параметры:
//  ИДИндекса - Произвольный - Ид индекса.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
//
&НаСервере
Функция ПодготовитьСоответствиеСтрокДляОкругленияСервер(ИДИндекса)
	
	Корень = ИндексыПоиска.НайтиПоИдентификатору(ИДИндекса);
	
	ВетвиКорня = Корень.ПолучитьЭлементы();
	
	// Сортировка результата с помощью дополнительной таблицы, для распределения остатка от округления по датам.
	ИндексыПоискаТаблицаСортировки.Очистить();
	
	Для Каждого Ветвь Из ВетвиКорня Цикл
		Строка = ?(Ветвь.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Ветвь.ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Ветвь.ИДСтроки));
		
		СтрокаСортировки = ИндексыПоискаТаблицаСортировки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСортировки, Ветвь);
		СтрокаСортировки.ДатаПоставки = Строка.ДатаПоставки;
	КонецЦикла;
	
	ИндексыПоискаТаблицаСортировки.Сортировать("ДатаПоставки");
	
	Соответствие = Новый Соответствие();
	
	Для Каждого СтрокаСортировки Из ИндексыПоискаТаблицаСортировки Цикл
		Строка = ?(СтрокаСортировки.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(СтрокаСортировки.ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(СтрокаСортировки.ИДСтроки));
		
		Соответствие.Вставить(Строка, СтрокаСортировки.ТаблицаЗапасы);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

//  Функция - Округлить соответствие строк.
//
// Параметры:
//  СоответствиеСтрок - Соответствие - Соответствие строк.
//  ИспользоватьУпаковки - Произвольный - Использовать упаковки.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ОкруглитьСоответствиеСтрок(СоответствиеСтрок, ИспользоватьУпаковки)
	
	ОстатокОкругления = 0;
	ОкругленоИтог = 0;
	КЗаказуИтог = 0;
	
	КЗаказуИтогЗапасы = 0;
	КЗаказуИтогЗаказы = 0;
	
	ОкругленоДоМинимальнойПартии = Ложь;
	
	Для Каждого КлючЗначение Из СоответствиеСтрок Цикл
		
		Строка = КлючЗначение.Ключ;
		Строка.НеОкруглятьПередСозданиемЗаказа = Ложь;
		
		Округлено = 0;
		
		Если Строка <> Неопределено Тогда
			Если Строка.Отметка Тогда
				
				Если ИспользоватьУпаковки Тогда
					Если ОстатокОкругления >= Строка.КЗаказу Тогда
						ОстатокОкругления = ОстатокОкругления - Строка.КЗаказу;
						Округлено = 0; // ОстатокОкругления списывается полностью или частично. Эта строка обеспечена полностью
					Иначе
						КЗаказу = Строка.КЗаказу - ОстатокОкругления; // ОстатокОкругления списывается полностью в счет количества КЗаказу
						Округлено = Округлить(КЗаказу, ?(Строка.ЧислительУпаковки = 0 Или Строка.ЗнаменательУпаковки = 0, 1, Строка.ЧислительУпаковки / Строка.ЗнаменательУпаковки),
						Строка.ТипЕдиницыИзмерения);
						
						Если НЕ ОкругленоДоМинимальнойПартии Тогда
							Кратность = ?(Строка.ЧислительУпаковки = 0 Или Строка.ЗнаменательУпаковки = 0, 1, Строка.ЧислительУпаковки / Строка.ЗнаменательУпаковки);
							МинимальнаяПартияПоставки = Строка.МинимальнаяПартияПоставки * Кратность;
							Округлено = Макс(МинимальнаяПартияПоставки, Округлено);
							ОкругленоДоМинимальнойПартии = Истина;
						КонецЕсли;
						
						ОстатокОкругления = Округлено - КЗаказу;
					КонецЕсли;
				Иначе
					Округлено = Строка.КЗаказу;
				КонецЕсли;
				
				Строка.Округлено = Округлено;
				ОкругленоИтог = ОкругленоИтог + Округлено;
				
				КЗаказуИтог = КЗаказуИтог + Строка.КЗаказу;
				
				// Если истина - накапливается итог по таблице запасов, иначе - заказов
				Если КлючЗначение.Значение Тогда
					КЗаказуИтогЗапасы = КЗаказуИтогЗапасы + Строка.КЗаказу;
				Иначе
					КЗаказуИтогЗаказы = КЗаказуИтогЗаказы + Строка.КЗаказу;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Структура = Новый Структура();
	Структура.Вставить("ОкругленоИтог", 	ОкругленоИтог);
	Структура.Вставить("КЗаказуИтог", 		КЗаказуИтог);
	Структура.Вставить("КЗаказуИтогЗапасы", КЗаказуИтогЗапасы);
	Структура.Вставить("КЗаказуИтогЗаказы", КЗаказуИтогЗаказы);
	
	Возврат Структура;
	
КонецФункции

//  Функция - Округлить.
//
// Параметры:
//  Количество - Произвольный - Количество.
//  Кратность - Произвольный - Кратность.
//  ТипЕдиницыИзмерения - Произвольный - Тип единицы измерения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция Округлить(Количество, Кратность, ТипЕдиницыИзмерения)
	
	Если Кратность <> 1
		Или ТипЕдиницыИзмерения = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук") Тогда
		Если Количество % Кратность <> 0 Тогда
			Остаток = Цел(Количество / Кратность) + 1;
			Возврат Остаток * Кратность;
		Иначе
			Возврат Количество;
		КонецЕсли;
	Иначе 
		Возврат Количество;
	КонецЕсли;
	
КонецФункции

//  Процедура - Отобразить расчитанное округление.
//
// Параметры:
//  Строка - Строка - Строка.
//  Запасы - Произвольный - Запасы.
//
&НаКлиенте
Процедура ОтобразитьРасчитанноеОкругление(Строка, Запасы)
	
	Если Строка = Неопределено Тогда
		Итоги = ПараметрыИнформационнойСтроки();
		СформироватьИнформационнуюСтроку(Неопределено, Итоги, Запасы);
		Возврат;
	КонецЕсли;
	
	ИДИндекса = Строка.ИДИндекса;
	
	Корень = ИндексыПоиска.НайтиПоИдентификатору(ИДИндекса);
	ВетвиКорня = Корень.ПолучитьЭлементы();
	
	ОкругленоИтог = 0;
	КЗаказуИтог = 0;
	
	КЗаказуИтогЗапасы = 0;
	КЗаказуИтогЗаказы = 0;
	
	СуммаИтог = 0;
	ЕстьСтрокаСПустойЦеной = Ложь;
	
	Для Каждого Ветвь Из ВетвиКорня Цикл
		Округлено = 0;
		СтрокаПоДереву = ?(Ветвь.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Ветвь.ИДСтроки), 
		Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Ветвь.ИДСтроки));
		
		Если СтрокаПоДереву <> Неопределено Тогда
			Если СтрокаПоДереву.Отметка Тогда
				
				Округлено = СтрокаПоДереву.Округлено;
				ОкругленоИтог = ОкругленоИтог + Округлено;
				КЗаказуИтог = КЗаказуИтог + СтрокаПоДереву.КЗаказу;
				СуммаИтог = СуммаИтог + (Округлено * СтрокаПоДереву.ЦенаВВалютеУправленческогоУчета);
				
				Если СтрокаПоДереву.ЦенаВВалютеУправленческогоУчета = 0 Тогда
					
					ЕстьСтрокаСПустойЦеной = Истина;
					
				КонецЕсли;
				
				Если Ветвь.ТаблицаЗапасы Тогда
					КЗаказуИтогЗапасы = КЗаказуИтогЗапасы + СтрокаПоДереву.КЗаказу;
				Иначе
					КЗаказуИтогЗаказы = КЗаказуИтогЗаказы + СтрокаПоДереву.КЗаказу;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Итоги = ПараметрыИнформационнойСтроки();
	Итоги.ОкругленоИтог = 			ОкругленоИтог;
	Итоги.КЗаказуИтог = 			КЗаказуИтог;
	Итоги.КЗаказуИтогЗапасы = 		КЗаказуИтогЗапасы;
	Итоги.КЗаказуИтогЗаказы = 		КЗаказуИтогЗаказы;
	Итоги.СуммаИтог = 				СуммаИтог;
	Итоги.ЕстьСтрокаСПустойЦеной = 	ЕстьСтрокаСПустойЦеной;
	
	СформироватьИнформационнуюСтроку(Строка, Итоги, Запасы);
	
КонецПроцедуры

// Обновляет реквизит формы ИнформационнаяСтрока
//
// Параметры:
//  Строка - ДанныеФормыКоллекция - источник данных для формирования информационной строк.
//  Итоги - Структура - содержит следующие данные.
//  Запасы - Число - итогое значение по количеству к заказу таблицы Запас.
//
&НаКлиенте
Процедура СформироватьИнформационнуюСтроку(Строка, Итоги, Запасы)

	ОкругленоИтог = 			Итоги.ОкругленоИтог;
	КЗаказуИтог = 				Итоги.КЗаказуИтог;
	КЗаказуИтогЗапасы = 		Итоги.КЗаказуИтогЗапасы;
	КЗаказуИтогЗаказы = 		Итоги.КЗаказуИтогЗаказы;
	СуммаИтог = 				Итоги.СуммаИтог;
	ЕстьСтрокаСПустойЦеной = 	Итоги.ЕстьСтрокаСПустойЦеной;
	
	Шрифт = Элементы.ИнформационнаяСтрока.Шрифт;
	ШрифтЖирный = Новый Шрифт(Шрифт, , , Истина);
	ШрифтКурсив = Новый Шрифт(Шрифт, , , , Истина);
	
	ИнформационнаяСтрокаМассив = Новый Массив();
	
	Если Строка = Неопределено Тогда
		ИнформационнаяСтрокаМассив.Добавить(НСтр("ru = 'Строка не выбрана';
												|en = 'Line is not selected'"));
	Иначе
	
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.Номенклатура), , , ,
			ПолучитьНавигационнуюСсылку(Строка.Номенклатура)));
		
		Если НЕ Строка.Характеристика.Пустая() Тогда
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(", "));
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.Характеристика), , , ,
				ПолучитьНавигационнуюСсылку(Строка.Характеристика)));
				
		КонецЕсли;
			
		Если Не Строка.Склад.Пустая()
			И ИспользоватьНесколькоСкладов Тогда
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(", "));
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.Склад), , , ,
				ПолучитьНавигационнуюСсылку(Строка.Склад)));
		
		КонецЕсли;
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(": "));
		
		Если Запасы Тогда
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'К заказу по запасам:';
																				|en = 'To order according to inventory:'")));
		Иначе
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Всего к заказу:';
																				|en = 'Total to order:'")));
		КонецЕсли;
		
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(КЗаказуИтог) + " ", ШрифтЖирный));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.ЕдиницаИзмерения), ШрифтЖирный));
		
		Если НЕ Запасы И ОкругленоИтог > 0 Тогда
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '(по запасам:';
																				|en = '(by inventory:'")));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(КЗаказуИтогЗапасы), ШрифтЖирный));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(", "));
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'по заказам:';
																				|en = 'by orders:'")));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(КЗаказуИтогЗаказы), ШрифтЖирный));
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока("), "));
			
		Иначе
			
			ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(", "));
			
		КонецЕсли;
		
		Если ОкругленоИтог > 0 И ИспользоватьУпаковки Тогда
			
			СсылкаУпаковка = "ОткрытьФормуВыбораУпаковки";
			
			// Вывод информации о упаковке.
			Если Строка.УпаковкаЗаказа.Пустая() Тогда
				Если Строка.ИспользоватьУпаковки 
					И ЕстьДоступКИзменениюУпаковки Тогда
					Упаковка = НСтр("ru = '<задать упаковку для округления>';
									|en = '<set a packaging for rounding>'");
					Если ОкругленоИтог <> КЗаказуИтог Тогда
						ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Округлено до:';
																							|en = 'Rounded to:'")));
						ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
						ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(ОкругленоИтог) + " ", ШрифтЖирный));
					КонецЕсли;
					ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Упаковка + " ", ШрифтКурсив, , , СсылкаУпаковка));
				КонецЕсли;
			ИначеЕсли ОкругленоИтог > 0 И Строка.УпаковкаЗаказа.Пустая() Тогда
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Округлено до:';
																					|en = 'Rounded to:'")));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(ОкругленоИтог) + " ", ШрифтЖирный));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.ЕдиницаИзмерения) + ", ", ШрифтЖирный));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
			Иначе
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Округлено до:';
																					|en = 'Rounded to:'")));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(ОкругленоИтог) + " ", ШрифтЖирный));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(Строка.ЕдиницаИзмерения) + ", ", ШрифтЖирный));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = '(Упаковка:';
																					|en = '(Packaging:'"), ШрифтКурсив));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
				
				Упаковка = Строка(Строка.УпаковкаЗаказа);
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Упаковка, ШрифтКурсив, , , СсылкаУпаковка));
				ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока("), ", ШрифтКурсив));
			КонецЕсли;
		КонецЕсли;
		
		ЗнакПримерноРавно = ?(ЕстьСтрокаСПустойЦеной, "~", "");
		
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'На сумму:';
																			|en = 'Amount:'")));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" "));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(ЗнакПримерноРавно, ШрифтЖирный));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(Строка(СуммаИтог), ШрифтЖирный));
		ИнформационнаяСтрокаМассив.Добавить(Новый ФорматированнаяСтрока(" " + ВалютаУправленческогоУчета, ШрифтЖирный));
		
	КонецЕсли;
		
	ИнформационнаяСтрока = Новый ФорматированнаяСтрока(ИнформационнаяСтрокаМассив);

КонецПроцедуры

//  Функция - Параметры информационной строки.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаКлиенте
Функция ПараметрыИнформационнойСтроки()
	
	СтруктураВозврата = Новый Структура();
	СтруктураВозврата.Вставить("ОкругленоИтог", 0);
	СтруктураВозврата.Вставить("КЗаказуИтог", 0);
	СтруктураВозврата.Вставить("КЗаказуИтогЗапасы", 0);
	СтруктураВозврата.Вставить("КЗаказуИтогЗаказы", 0);
	СтруктураВозврата.Вставить("СуммаИтог", 0);
	СтруктураВозврата.Вставить("ЕстьСтрокаСПустойЦеной", Ложь);
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Индексирует таблицу, определяемую параметром Запасы
//  Повторяющиеся строки по ключу Номенклатура, Характеристика, Склад сворачиваются
//  в один корневой элемент дерева ИндексыПоиска.
//
// Параметры:
//  Запасы - Булево - Признак того, что вызов процедуры производится на шаге Запасы.
//
&НаСервере
Процедура ЗаполнитьДеревоИндексов(Запасы)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаЗапасы", ВыгрузитьНоменклатуруСИдентификаторамиСтрок(Объект.Запасы)); 
	Запрос.УстановитьПараметр("ТаблицаЗаказы", ВыгрузитьНоменклатуруСИдентификаторамиСтрок(Объект.ЗаказыКОбеспечению));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	Таблица.Индекс         КАК Индекс
		|ПОМЕСТИТЬ ВтТаблицаЗапасы
		|ИЗ
		|	&ТаблицаЗапасы КАК Таблица
		|;
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	Таблица.Индекс         КАК Индекс
		|ПОМЕСТИТЬ ВтТаблицаЗаказы
		|ИЗ
		|	&ТаблицаЗаказы КАК Таблица
		|;
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.Индекс         КАК Индекс,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	ИСТИНА                 КАК ЭтоЗапасы
		|ИЗ
		|	ВтТаблицаЗапасы КАК Таблица
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура   КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад          КАК Склад,
		|	Таблица.Индекс         КАК Индекс,
		|	Таблица.ДатаПоставки   КАК ДатаПоставки,
		|	ЛОЖЬ                   КАК ЭтоЗапасы
		|ИЗ
		|	ВтТаблицаЗаказы КАК Таблица
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура, Характеристика, Склад, ДатаПоставки";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Коллекция = ИндексыПоиска.ПолучитьЭлементы();
	Коллекция.Очистить();
	
	Ключ = Новый Структура("Номенклатура, Характеристика, Склад");
	Пока Выборка.Следующий() Цикл
		
		Если Ключ.Номенклатура <> Выборка.Номенклатура Или Ключ.Характеристика <> Выборка.Характеристика Или Ключ.Склад <> Выборка.Склад Тогда
			
			ЗаполнитьЗначенияСвойств(Ключ, Выборка);
			Корень = Коллекция.Добавить();
			Строки = Корень.ПолучитьЭлементы();
			
		КонецЕсли;
		
		ТаблицаФормы = ?(Выборка.ЭтоЗапасы, Объект.Запасы, Объект.ЗаказыКОбеспечению);
		
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.ИДСтроки      = ТаблицаФормы[Выборка.Индекс].ПолучитьИдентификатор(); 
		НоваяСтрока.ТаблицаЗапасы = Выборка.ЭтоЗапасы; 
		
		ТаблицаФормы[Выборка.Индекс].ИДИндекса = Корень.ПолучитьИдентификатор();
		
	КонецЦикла;
		
КонецПроцедуры

//  Функция - Выгрузить номенклатуру с идентификаторами строк.
//
// Параметры:
//  ТаблицаФормы - ТаблицаЗначений - Таблица формы.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервере
Функция ВыгрузитьНоменклатуруСИдентификаторамиСтрок(ТаблицаФормы)
	
	ТаблицаВыгрузки = Новый ТаблицаЗначений();
	ТаблицаВыгрузки.Колонки.Добавить("Номенклатура",   Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаВыгрузки.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаВыгрузки.Колонки.Добавить("Склад",          Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаВыгрузки.Колонки.Добавить("ДатаПоставки",   Новый ОписаниеТипов("Дата"));
	ТаблицаВыгрузки.Колонки.Добавить("Индекс",         Новый ОписаниеТипов("Число"));
	
	ВсегоСтрок = ТаблицаФормы.Количество() - 1;
	Для Индекс = 0 По ВсегоСтрок Цикл
		
		СтрокаТаблицы = ТаблицаФормы[Индекс];
		ВыгруженнаяСтрока = ТаблицаВыгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(ВыгруженнаяСтрока, СтрокаТаблицы);
		ВыгруженнаяСтрока.Индекс = Индекс;
		
	КонецЦикла;
	Возврат ТаблицаВыгрузки;
	
КонецФункции

//  Процедура - Выбрать упаковку клиент.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаКлиенте
Процедура ВыбратьУпаковкуКлиент(ИмяТаблицы)

	Поставка = Элементы[ИмяТаблицы].ТекущиеДанные;

	ЕдиницыИзмерения = Новый Массив();
	ЕдиницыИзмерения.Добавить(Поставка.ЕдиницаИзмерения);
	
	ПараметрыФормыОтбор = Новый Структура("Владелец", Поставка.Номенклатура);
	ПараметрыФормы = Новый Структура("Отбор", ПараметрыФормыОтбор);
	ПараметрыФормы.Вставить("ЕдиницыИзмерения", ЕдиницыИзмерения);
	
	ОткрытьФорму("Обработка.ОбеспечениеПотребностей.Форма.ФормаВыбораУпаковкиЕдиницы", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

// Распространяет по таблицам Запасы и ЗаказыКОбеспечению изменение упаковки
//  Записывает изменение упаковки в базу данных.
//
// Параметры:
//  ИДИндекса - Число - Идентификатор корня в дереве ИндексыПоиска, по ветвям которого работает алгорит.
//  Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения - новое значение упаковки.
//
&НаСервере
Процедура ЗаполнитьЗаписатьУпаковкуПоДеревуИндексов(ИДИндекса, Упаковка)
	
	Если Упаковка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧислительИЗнаменательУпаковки = Новый Структура("Числитель, Знаменатель", 1, 1);
	
	// Выбор единицы измерения означает команду на очищение
	Если Упаковка.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Упаковка Тогда
		ЧислительИЗнаменательУпаковки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Упаковка, "Числитель, Знаменатель");
	Иначе
		Упаковка = ПредопределенноеЗначение("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	КонецЕсли;
	
	Корень = ИндексыПоиска.НайтиПоИдентификатору(ИДИндекса);
	
	// Обход всех соответствующих строк в обеих таблицах, с заменой упаковки и коэффициента.
	Коллекция = Корень.ПолучитьЭлементы();
	Строка = Неопределено;
	
	Если Коллекция.Количество() > 0 Тогда
		Строка = ?(Коллекция[0].ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Коллекция[0].ИДСтроки),
			Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Коллекция[0].ИДСтроки));
	КонецЕсли;
	
	Если Строка <> Неопределено Тогда
		// Запись изменения в регистр сведений ТоварныеОграничения
		РегистрыСведений.ТоварныеОграничения.ЗадатьУпаковкуТовара(Строка.Номенклатура, Строка.Характеристика,
			Строка.Склад, Упаковка);
		
		Для Каждого Ветвь Из Коллекция Цикл
			
			Строка = ?(Ветвь.ТаблицаЗапасы, Объект.Запасы.НайтиПоИдентификатору(Ветвь.ИДСтроки),
				Объект.ЗаказыКОбеспечению.НайтиПоИдентификатору(Ветвь.ИДСтроки));
			
			Строка.УпаковкаЗаказа = Упаковка;
			Строка.ЧислительУпаковки = ЧислительИЗнаменательУпаковки.Числитель;
			Строка.ЗнаменательУпаковки = ЧислительИЗнаменательУпаковки.Знаменатель;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Очищает дерево ИндексыПоиска полностью, либо только записи ссылающиеся на таблицу ЗаказыКОбеспечению.
//
// Параметры:
//  Запасы - Булево - Признак того, что вызов процедуры производится на шаге Запасы.
//
&НаКлиенте
Процедура ОчиститьДеревоИндексов(Запасы)
	
	Корни = ИндексыПоиска.ПолучитьЭлементы();
	
	// Таблица Запасы - первая. Ее очищение по кнопке Назад равнозначно полной очистке таблицы.
	Если Запасы Тогда
		Корни.Очистить();
	КонецЕсли;
	
	Количество = Корни.Количество() - 1;
	Для н = 0 По Количество Цикл
		
		ИндексКорня = Количество - н;
		Корень = Корни[ИндексКорня];
		
		Ветви = Корень.ПолучитьЭлементы();
		КоличествоВетвей = Ветви.Количество() - 1;
		
		// Удаление ветвей связанных с таблицей ЗаказыКОбеспечению
		Для м = 0 По КоличествоВетвей Цикл
			
			ИндексВетви = КоличествоВетвей - м;
			Ветвь = Ветви[ИндексВетви];
			Если Ветвь.ТаблицаЗапасы = Ложь Тогда
				Ветви.Удалить(ИндексВетви);
			КонецЕсли;
			
		КонецЦикла;
		
		// Если из корня удалены все ветви, удаляется корень
		Если Корень.ПолучитьЭлементы().Количество() = 0 Тогда
			Корни.Удалить(ИндексКорня);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Общепит

// Дерево "ДеревоЗаказыКОбеспечению" отображает данные в 2 уровня:
// на верхнем уровне планы-меню, которые будут оформлены;
// на нижнем - строки заказов, которые попадут в планы-меню.
// Данное дерево синхронизируется с ТЗ "ЗаказыКОбеспечению"
// по которой далее и происходит формирование планов меню.
#Область ДеревоЗаказыКОбеспечению

#Область ДеревоЗаказыКОбеспечениюСлужебныеПроцедурыИФункции

// Процедура заполняет дерево документов по таблице заказов к обеспечению
//
&НаСервере
Процедура питЗаполнитьДеревоЗаказовКОбеспечению() 
	
	// Номер плана-меню для отображения представления на форме,
	// с реальным номером чаще всего не совпадает.
	питМаксНомерПлана = ЭтаФорма.питПредполагаемыйИсходныйНомерПлана;
	
	ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы().Очистить();
	
	Таблица = Объект.ЗаказыКОбеспечению;
	
	// Массив структур для заполнения колонок верхней группировки и нижней.
	ИменаКолонокГруппировка		= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0,Ложь);
	ИменаКолонокТовары			= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(1,Ложь);
	КлючиГруппировки = Новый Массив;
	КлючиГруппировки.Добавить(Новый Структура(ИменаКолонокГруппировка));
	КлючиГруппировки.Добавить(Новый Структура(ИменаКолонокТовары));
	
	ДеревоДокументовОбъект = РеквизитФормыВЗначение("ДеревоЗаказыКОбеспечению");
	СтрокиГруппировки = ДеревоДокументовОбъект.Строки;
	
	Для Каждого Строка Из Таблица Цикл
		
		// Фильтры, заполняем не по всем строкам, а только по тем, которые удовлетворяют фильтрам.
		ДатаПоставкиДопустима	= Строка.ДатаПоставки >= ФильтрКОтгрузкеНеРанее
			И (Строка.ДатаПоставки <= ФильтрКОтгрузкеНеПозднее Или Не ЗначениеЗаполнено(ФильтрКОтгрузкеНеПозднее));
		ОбеспечениеДопустимо	= Строка.Требуется > Строка.Обеспечено Или Не ФильтрНеобеспеченные;
		ОтметкаДопустима		= Строка.Отметка = Истина Или НЕ ФильтрОтметкаЗаказы;
		ПриоритетДопустим		= (Строка.Приоритет = ФильтрПриоритет) Или Не ЗначениеЗаполнено(ФильтрПриоритет);
		Если НЕ(ДатаПоставкиДопустима И ОбеспечениеДопустимо И ОтметкаДопустима И ПриоритетДопустим) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(КлючиГруппировки[0], Строка);
		ЗаполнитьЗначенияСвойств(КлючиГруппировки[1], Строка);
		
		// Отражаем строку ТЗ в дереве.
		питОтразитьСтрокуЗаказовВДеревеЗаказов(Строка, СтрокиГруппировки, КлючиГруппировки, ТекстНеЗаполнено, питМаксНомерПлана);
		
	КонецЦикла;
	
	// Заполнение ресурсов на верхнем уровне
	Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
		
		СуммаКЗаказу = 0;
		Для каждого Строкатовары Из СтрокаГруппировки.Строки Цикл
			Если Строкатовары.Отметка Тогда
				СуммаКЗаказу = СуммаКЗаказу + Строкатовары.КЗаказу;
			КонецЕсли;
		КонецЦикла;
		СтрокаГруппировки.Обеспечено = СтрокаГруппировки.Строки.Итог("Обеспечено");
		СтрокаГруппировки.Требуется = СтрокаГруппировки.Строки.Итог("Требуется");
		СтрокаГруппировки.Кзаказу = СуммаКЗаказу;
		
	КонецЦикла;
	
	// Сортировка.
	СтрокиГруппировки.Сортировать(ИменаКолонокГруппировка);
	
	ЗначениеВРеквизитФормы(ДеревоДокументовОбъект, "ДеревоЗаказыКОбеспечению");
	
КонецПроцедуры

// Функция отражает строку ТЧ "ЗаказыКОбеспечению" в дереве документов общепит.
//
// Параметры:
//  РесурсыСтроки - Произвольный - Ресурсы строки.
//  Группировки - Произвольный - Группировки.
//  КлючиГруппировки - Произвольный - Ключи группировки.
//  ТекстНеЗаполнено - Произвольный - Текст не заполнено.
//  питМаксНомерПлана - Произвольный - пит макс номер плана.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервереБезКонтекста
Функция питОтразитьСтрокуЗаказовВДеревеЗаказов(РесурсыСтроки, Группировки, КлючиГруппировки, ТекстНеЗаполнено, питМаксНомерПлана)
	
	// Если РесурсыСтроки.Отметка И РесурсыСтроки.КЗаказу > 0 Тогда
		
		МассивСтрок = Группировки.НайтиСтроки(КлючиГруппировки[0]);
		Если МассивСтрок.Количество() = 0 Тогда
			
			Группировка = Группировки.Добавить();
			ЗаполнитьЗначенияСвойств(Группировка, КлючиГруппировки[0]); 
			Группировка.КартинкаПриоритета = 1;
			Группировка.Группировка = питПолучитьПредставлениеГруппировкиДереваДокументов(КлючиГруппировки[0], ТекстНеЗаполнено, питМаксНомерПлана);
			
		Иначе //Поставщик уже есть в дереве.
			Группировка = МассивСтрок[0];
		КонецЕсли;
		
		СтрокиТоваров = Группировка.Строки;
		
		СтрокаТоваров = СтрокиТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, РесурсыСтроки); 
		
	// КонецЕсли;
	
КонецФункции

// Функция получает имена колонок группировки.
//
// Параметры:
//  КодГруппировки - Число - Код уровня.
//  ПолучитьМассив - Массив - Получить массив.
//
// Возвращаемое значение:
//  в зависимости от данного параметра.
//  Префикс			 - Строка	 - Префикс колонок.
//  Суффикс			 - Строка	 - Суффикс колонок.
// Возвращаемое значение:
//  Строка, Массив - Имена колонок.
&НаКлиентеНаСервереБезКонтекста
Функция питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(КодГруппировки = 0, ПолучитьМассив = Истина)
	
	ИменаКолонокСтрокой = "";
	
	Если КодГруппировки = 0 Тогда
		ИменаКолонокСтрокой		= "Организация,Подразделение,Склад,ЦеховаяКладовая,ДатаПоставки,СкладМатериалов";
	ИначеЕсли КодГруппировки = 1 Тогда
		ИменаКолонокСтрокой		= "Заказ,Номенклатура,Характеристика,Назначение,ЕдиницаИзмерения";
	ИначеЕсли КодГруппировки = 2 Тогда
		ИменаКолонокСтрокой		= "КЗаказу,Округлено,Требуется,Обеспечено";
	ИначеЕсли КодГруппировки = 3 Тогда
		ИменаКолонокСтрокой		= "КЗаказу,Подразделение,СкладМатериалов,ЦеховаяКладовая,ДатаПоставки,Организация";
	ИначеЕсли КодГруппировки = 4 Тогда
		ИменаКолонокСтрокой		= "Склад";
	КонецЕсли;
	
	Если ПолучитьМассив Тогда
		Результат = Новый Массив;
		Разделитель = ",";
		Строки = СтрЗаменить(ИменаКолонокСтрокой, Разделитель, Символы.ПС);
		Для Индекс = 1 По СтрЧислоСтрок(Строки) Цикл
			Результат.Добавить(СтрПолучитьСтроку(Строки, Индекс));
		КонецЦикла; 
	Иначе
		Результат = ИменаКолонокСтрокой;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура по переданному идентификатору строки дерева находит строку дерева и по колонке "ИдентификаторСтроки"
//  находит связанную.
//  строку в ТЧ "ЗаказыКОбеспечению". Актуализирует строку ТЧ в соответствии со значениями в строке дерева.
//
// Параметры:
//  ИдентификаторСтрокиДерева - Строка - Идентификатор строки дерева по которому можно найти строку методо.
//
&НаСервере
Процедура питАктуализироватьТаблицуЗаказовПоДеревуЗаказов(ИдентификаторСтрокиДерева)
	
	СтрокаДерева = Неопределено;
	
	Если НЕ ИдентификаторСтрокиДерева = Неопределено Тогда
		СтрокаДерева = ЭтаФорма.ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(ИдентификаторСтрокиДерева);
	КонецЕсли;
	
	Если НЕ СтрокаДерева = Неопределено Тогда
		СтрокаТаблицыЗаказов = Неопределено;
		СтрокиТаблицыЗаказов = Объект.ЗаказыКОбеспечению.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаДерева.ИдентификаторСтроки));
		Если СтрокиТаблицыЗаказов.Количество() Тогда
			СтрокаТаблицыЗаказов = СтрокиТаблицыЗаказов[0];
		КонецЕсли;
		
		Если НЕ СтрокаТаблицыЗаказов = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыЗаказов, СтрокаДерева);
			РассчитатьИтогиНаСервере();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура перестраивает дерево заказов с учетом отборов
//
&НаКлиенте
Процедура питОтборДеревоЗаказы()
	питОтборДеревоЗаказыНаСервере();
	Для каждого ТекЭлементДерева Из ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы() Цикл
		Элементы.ДеревоЗаказыКОбеспечению.Развернуть(ТекЭлементДерева.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

// Процедура перестраивает дерево заказов с учетом отборов
//
&НаСервере
Процедура питОтборДеревоЗаказыНаСервере()
	питЗаполнитьДеревоЗаказовКОбеспечению();
КонецПроцедуры

// Процедура ищет строки верхней группировки(планы-меню) у которых нет дочерних элементов и удаляет их.
//
&НаКлиенте
Процедура питДеревоЗаказыКОбеспечениюУдалитьПустыеСтрокиПлановМеню()
	
	СтрокиГруппировки = ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы();
	
	// Удаление пустых строк плана-меню.
	МассивСтрокДляУдаления = Новый Массив;
	Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
		Если НЕ СтрокаГруппировки.ПолучитьЭлементы().Количество() Тогда
			МассивСтрокДляУдаления.Добавить(СтрокаГруппировки);
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекСтрокаДляУдаления Из МассивСтрокДляУдаления Цикл
		СтрокиГруппировки.Удалить(ТекСтрокаДляУдаления);
	КонецЦикла;
	
КонецПроцедуры

// Процедура пересчитывает ресурсы в верхних группировках дерева заказов.
//
&НаКлиенте
Процедура питДеревоЗаказыКОбеспечениюПересчитатьРесурсы()
	
	СтрокиГруппировки = ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы();
	
	ИменаКолонокРесурсов	= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(2);
	
	// Заполнение ресурсов на верхнем уровне
	Для каждого СтрокаГруппировки Из СтрокиГруппировки Цикл
		
		Для каждого ТекИмяКолонкиРесурса Из ИменаКолонокРесурсов Цикл
			СтрокаГруппировки[ТекИмяКолонкиРесурса] = 0;
		КонецЦикла;
		
		Для каждого СтрокаТоваров Из СтрокаГруппировки.ПолучитьЭлементы() Цикл
			
			Для каждого ТекИмяКолонкиРесурса Из ИменаКолонокРесурсов Цикл
				Если ТекИмяКолонкиРесурса = "КЗаказу" И НЕ СтрокаТоваров.Отметка Тогда
					Продолжить;
				КонецЕсли;
				СтрокаГруппировки[ТекИмяКолонкиРесурса] = СтрокаГруппировки[ТекИмяКолонкиРесурса] + СтрокаТоваров[ТекИмяКолонкиРесурса];
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура изменяет значение отметки в дереве заказов у колонки к заказу для выделенных строк и
//  переносит изменения в связанную ТЧ "ЗаказыКОбеспечению".
//
// Параметры:
//  Установить - Булево - Новое значение отметки.
//
&НаСервере
Процедура питИзменитьОтметкуДеревоЗаказыКОбеспечению(Установить)
	
	// Выделенные строки дерева.
	ВыделенныеСтроки = Элементы.ДеревоЗаказыКОбеспечению.ВыделенныеСтроки;
	
	// Структура для поиска троки ТЧ "ЗаказыКОбеспечению".
	СтруктураПоиска = Новый Структура("ИдентификаторСтроки");
	
	// Массив строк для удаления.
	СтрокиДляУдаления = Новый Массив;
	
	// Обход выделенных строк.
	Для каждого Идентификатор Из ВыделенныеСтроки Цикл
		
		// Получение строки дерева.
		Строка = ЭтаФорма.ДеревоЗаказыКОбеспечению.НайтиПоИдентификатору(Идентификатор);
		
		// Если строка найдена.
		Если НЕ Строка = Неопределено Тогда
			
			// Если это строка верхней группировки(планы-меню).
			Если НЕ ПустаяСтрока(Строка.Группировка) Тогда
				
				// Получение дочерних элементов (заказы).
				ВсеДочерние = Строка.ПолучитьЭлементы();
				
				// Очистка массив строк для удаления.
				СтрокиДляУдаления.Очистить();
				
				// Обход строк заказов.
				Для каждого ДочерняяСтрока Из ВсеДочерние Цикл
					
					// Значение отметки строки отличается от того, которое необходимо установить.
					ОтметкиРазличаются = ДочерняяСтрока.Отметка <> Установить;
					
					// Установка нового значения отметки.
					ДочерняяСтрока.Отметка = Установить;
					
					// Если отметки различаются.
					Если ОтметкиРазличаются Тогда
						
						// Поиск строки ТЧ "ЗаказыКОбеспечению" и актуализация колонки "Отметка".
						СтруктураПоиска.ИдентификаторСтроки = ДочерняяСтрока.ИдентификаторСтроки;
						СтрокиТЗ = Объект.ЗаказыКОбеспечению.НайтиСтроки(СтруктураПоиска);
						Для каждого СтрокаТЗ Из СтрокиТЗ Цикл
							СтрокаТЗ.Отметка = Установить;
						КонецЦикла;
						
						// Если установлен фильтр "Только отмеченные", а новое значение отметки - ЛОЖЬ, то
						// такую строку нужно удалить из дерева.
						Если НЕ Установить И ФильтрОтметкаЗаказы Тогда
							СтрокиДляУдаления.Добавить(ДочерняяСтрока);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				// Удаление строк для удаления.
				Для каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
					ВсеДочерние.Удалить(СтрокаДляУдаления);
				КонецЦикла;
				
			Иначе // Это строка нижней группировки (заказов).
				
				// Отметки различаются.
				ОтметкиРазличаются = Строка.Отметка <> Установить;
				
				// Установка нового значения отметки.
				Строка.Отметка = Установить;
				
				// Если отметки различаются.
				Если ОтметкиРазличаются Тогда
					
					// Поиск строки ТЧ "ЗаказыКОбеспечению" и актуализация колонки "Отметка".
					СтруктураПоиска.ИдентификаторСтроки = Строка.ИдентификаторСтроки;
					СтрокиТЗ = Объект.ЗаказыКОбеспечению.НайтиСтроки(СтруктураПоиска);
					Для каждого СтрокаТЗ Из СтрокиТЗ Цикл
						СтрокаТЗ.Отметка = Установить;
					КонецЦикла;
					
					// Удаление строки из дерева, если установлен фильтр "Только отмеченные", 
					// а новое значение отметки - ЛОЖЬ.
					Если НЕ Установить И ФильтрОтметкаЗаказы Тогда
						Строка.ПолучитьРодителя().ПолучитьЭлементы().Удалить(Строка);
					КонецЕсли;
					
				КонецЕсли; // КонецЕсли отметки различаются.
				
			КонецЕсли; // КонецЕсли это строка верхней группировки(планы-меню).
			
		КонецЕсли; // КонецЕсли строка найдена.
		
	КонецЦикла; // КонецЦикла Обход выделенных строк.
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

//  Процедура - пит при создании на сервере в начале.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура питПриСозданииНаСервереВНачале(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	питСоздатьРеквизитыЭлементыФормы();
	
	Элементы.ОтборПоТипуОбеспечения.СписокВыбора.Очистить();
	Элементы.ОтборПоТипуОбеспечения.СписокВыбора.Добавить(Перечисления.ТипыОбеспечения.питПроизводство);
	
	ЭтаФорма.АвтоЗаголовок = Ложь;
	ЭтаФорма.Заголовок = "Формирование планов-меню по потребностям";
	
КонецПроцедуры

//  Процедура - пит при создании на сервере в конце.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура питПриСозданииНаСервереВКонце(Отказ, СтандартнаяОбработка)
	
	// Для общепита всегда Ложь, т.к. поддержание запасов не предусмотрено.
	ЕстьШагЗапасы = Ложь;
	
	// Тип обеспечения ВСЕГДА "Производство общепита".
	ОтборПоТипуОбеспечения = Перечисления.ТипыОбеспечения.питПроизводство;
	
	питУстановитьНастройкиПоУмолчанию();
	
	питУправлениеФормой();
	
	// +debug
//   питЦентрМониторинга.ЗаписатьОперацииБизнесСтатистики(РеквизитФормыВЗначение("Объект",
// Тип("ОбработкаОбъект.питОбеспечениеПотребностей")));.
	// -debug
	
КонецПроцедуры

//  Функция - Далее к шагу заказы на клиенте.
//
// Параметры:
//  Результат - Произвольный - Результат.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ДалееКШагуЗаказыНаКлиенте(Результат)
	
	ВсеОк = ДалееКШагуЗаказы(Результат);
	
	// Разворачиваем верхний уровень дерева (Планы-меню).
	Для каждого ТекЭлементДерева Из ЭтаФорма.ДеревоЗаказыКОбеспечению.ПолучитьЭлементы() Цикл
		Элементы.ДеревоЗаказыКОбеспечению.Развернуть(ТекЭлементДерева.ПолучитьИдентификатор());
	КонецЦикла;
	
	Возврат ВсеОк;
	
КонецФункции

//  Процедура - пит создать реквизиты элементы формы.
//
&НаСервере
Процедура питСоздатьРеквизитыЭлементыФормы()
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	/////////////////////////////////////////////////////////////
	// Учет предполагаемых номеров планов-меню
	НовыйРеквизит = Новый РеквизитФормы("питПредполагаемыйИсходныйНомерПлана", ОписаниеТиповЧисло(15, 0),"","");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	НовыйРеквизит = Новый РеквизитФормы("питМаксНомерПлана", ОписаниеТиповЧисло(15, 0),"","");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	/////////////////////////////////////////////////////////////
	// Дополнение табличной части "ЗаказыКОбеспечению" отраслевыми колонками
	КолонкиДобавить = Новый Массив;
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "Организация"		, Новый ОписаниеТипов("СправочникСсылка.Организации")			, "Организация"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "Подразделение"		, Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия")	, "Подразделение"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "ЦеховаяКладовая"	, Новый ОписаниеТипов("СправочникСсылка.Склады")				, "Цеховая кладовая"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "Организация1"		, Новый ОписаниеТипов("СправочникСсылка.Организации")			, "Организация"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "Подразделение1"	, Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия")	, "Подразделение"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "ЦеховаяКладовая1"	, Новый ОписаниеТипов("СправочникСсылка.Склады")				, "Цеховая кладовая"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "Склад1"			, Новый ОписаниеТипов("СправочникСсылка.Склады")				, "Склад"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "ДатаПоставки1"		, Новый ОписаниеТипов("Дата")									, "Дата поставки"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "СкладМатериалов"	, Новый ОписаниеТипов("СправочникСсылка.Склады")				, "Склад материалов"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "СкладМатериалов1"	, Новый ОписаниеТипов("СправочникСсылка.Склады")				, "Склад материалов"));
	КолонкиДобавить.Добавить(Новый Структура("Имя, ТипЗначения, Заголовок", "ИдентификаторСтроки", ОписаниеТиповСтрока(36)										, "Идентификатор строки"));
	Для каждого ТекКолонка Из КолонкиДобавить Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ТекКолонка.Имя, ТекКолонка.ТипЗначения, "Объект.ЗаказыКОбеспечению", ТекКолонка.Заголовок));
	КонецЦикла;
	
	/////////////////////////////////////////////////////////////
//   Дерево заказов к обеспечению, которое будет отображаться на форме и данные которого потому будут перенесены в
// таблицу "ЗаказыКОбеспечению".
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДеревоЗаказыКОбеспечению", Новый ОписаниеТипов("ДеревоЗначений")));
	ТаблицаЗаказыКОбеспечению = Объект.ЗаказыКОбеспечению.Выгрузить(Новый Массив);
	Для каждого ТекКолонка Из ТаблицаЗаказыКОбеспечению.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ТекКолонка.Имя, ТекКолонка.ТипЗначения, "ДеревоЗаказыКОбеспечению", ТекКолонка.Заголовок));
	КонецЦикла;
	Для каждого ТекКолонка Из КолонкиДобавить Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ТекКолонка.Имя, ТекКолонка.ТипЗначения, "ДеревоЗаказыКОбеспечению", ТекКолонка.Заголовок));
	КонецЦикла;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Группировка", ОписаниеТиповСтрока(), "ДеревоЗаказыКОбеспечению", "План-меню"));
	
	/////////////////////////////////////////////////////////////
	// Вспомогательное дерево докуметов, на базе которого строится "Дерево заказов к обеспечению".
	ТаблицаЗначенийДокументы = ТаблицаДокументы.Выгрузить(Новый Массив);
	ТипКолонкиДокумент = ТаблицаЗначенийДокументы.Колонки.Найти("Документ").ТипЗначения;
	ТипКолонкиИсточникОбеспечения = ТаблицаЗаказыКОбеспечению.Колонки.Найти("ИсточникОбеспечения").ТипЗначения;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДеревоДокументов", Новый ОписаниеТипов("ДеревоЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Группировка"				, ОписаниеТиповСтрока()													, "ДеревоДокументов", "Группировка"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Заказ"					, ТипКолонкиДокумент													, "ДеревоДокументов", "Заказ"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Номенклатура"			, Новый ОписаниеТипов("СправочникСсылка.Номенклатура")					, "ДеревоДокументов", "Номенклатура"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Характеристика"			, Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры")	, "ДеревоДокументов", "Характеристика"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Назначение"				, Новый ОписаниеТипов("СправочникСсылка.Назначения")					, "ДеревоДокументов", "Назначение"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ЕдиницаИзмерения"		, Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения")		, "ДеревоДокументов", "ЕдиницаИзмерения"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИсточникОбеспечения"		, ТипКолонкиИсточникОбеспечения											, "ДеревоДокументов", "ИсточникОбеспечения"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Склад"					, Новый ОписаниеТипов("СправочникСсылка.Склады")						, "ДеревоДокументов", "Склад"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПодразделениеПолучатель"	, Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия")			, "ДеревоДокументов", "ПодразделениеПолучатель"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВсегоСтрок"				, ОписаниеТиповЧисло(10, 0)												, "ДеревоДокументов", "ВсегоСтрок"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Количество"				, ОписаниеТиповЧисло(15, 3)												, "ДеревоДокументов", "Количество"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПланМеню"				, ОписаниеТиповСтрока()													, "ДеревоДокументов", "ПланМеню"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Организация"				, Новый ОписаниеТипов("СправочникСсылка.Организации")					, "ДеревоДокументов", "Организация"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Подразделение"			, Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия")			, "ДеревоДокументов", "Подразделение"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ЦеховаяКладовая"			, Новый ОписаниеТипов("СправочникСсылка.Склады")						, "ДеревоДокументов", "ЦеховаяКладовая"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДатаПоставки"			, Новый ОписаниеТипов("Дата")											, "ДеревоДокументов", "ДатаПоставки"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СкладМатериалов"			, Новый ОписаниеТипов("СправочникСсылка.Склады")						, "ДеревоДокументов", "СкладМатериалов"));
	
	/////////////////////////////////////////////////////////////
	// В финальную таблицу документов добавим отраслевые колонки
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СкладРеализации"	, Новый ОписаниеТипов("СправочникСсылка.Склады")				, "ТаблицаДокументы", "Склад реализации"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Подразделение"	, Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия")	, "ТаблицаДокументы", "Подразделение"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СкладМатериалов"	, Новый ОписаниеТипов("СправочникСсылка.Склады")				, "ТаблицаДокументы", "Склад материалов"));
	// + вручную расширен тип колонки "Документ", добавлен "План-меню".
	
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	/////////////////////////////////////////////////////////////
	// Команды формы
	Команда = ЭтаФорма.Команды.Добавить("питПродолжитьВТиповойОбработке");
	Команда.Действие					= "питПродолжитьВТиповойОбработке";
	Команда.Заголовок					= "Продолжить обеспечение ингредиентами";
	Команда.Подсказка					= "";
	
	Команда = ЭтаФорма.Команды.Добавить("питОтметитьКЗаказуДеревоЗаказы");
	Команда.Действие					= "питОтметитьКЗаказуДеревоЗаказы";
	Команда.Заголовок					= "Отметить к заказу дерево заказы";
	Команда.Подсказка					= "";
	Команда.Картинка					= БиблиотекаКартинок.УстановитьФлажки;
	
	
	Команда = ЭтаФорма.Команды.Добавить("питСнятьОтметкуДеревоЗаказы");
	Команда.Действие					= "питСнятьОтметкуДеревоЗаказы";
	Команда.Заголовок					= "Снять отметку дерево заказы";
	Команда.Подсказка					= "";
	Команда.Картинка					= БиблиотекаКартинок.СнятьФлажки;
	
	/////////////////////////////////////////////////////////////
	// Элементы формы
	
	// Родительская группа отраслевых элементов.
	питГруппаЗаказыКОформлению = Элементы.Вставить("питГруппаЗаказыКОформлению", Тип("ГруппаФормы"), Элементы.ШагиПотребности, Элементы.ГруппаИтоги);
	питГруппаЗаказыКОформлению.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	питГруппаЗаказыКОформлению.Заголовок = "Планы-меню к оформлению";
	питГруппаЗаказыКОформлению.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	// Фильтры отраслевого дерева.
	питКомандыИФильтрыДеревоЗаказы = Элементы.Добавить("питКомандыИФильтрыДеревоЗаказы", Тип("ГруппаФормы"), питГруппаЗаказыКОформлению);
	питКомандыИФильтрыДеревоЗаказы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	питКомандыИФильтрыДеревоЗаказы.ОтображатьЗаголовок = Ложь;
	питКомандыИФильтрыДеревоЗаказы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	Кнопка = ЭтаФорма.Элементы.Добавить("питОтметитьКЗаказуДеревоЗаказы", Тип("КнопкаФормы"), питКомандыИФильтрыДеревоЗаказы);
	Кнопка.Вид						= ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.Заголовок				="Отметить к заказу дерево заказы";
	Кнопка.Отображение				= ОтображениеКнопки.Картинка;
	Кнопка.ИмяКоманды				= "питОтметитьКЗаказуДеревоЗаказы";
	Кнопка.ОтображениеПодсказки		= ОтображениеПодсказки.Авто;
	
	Кнопка = ЭтаФорма.Элементы.Добавить("питСнятьОтметкуДеревоЗаказы", Тип("КнопкаФормы"), питКомандыИФильтрыДеревоЗаказы);
	Кнопка.Вид						= ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.Заголовок				="Снять отметку дерево заказы";
	Кнопка.Отображение				= ОтображениеКнопки.Картинка;
	Кнопка.ИмяКоманды				= "питСнятьОтметкуДеревоЗаказы";
	Кнопка.ОтображениеПодсказки		= ОтображениеПодсказки.Авто;
	
	ПолеФлажка = ЭтаФорма.Элементы.Добавить("питФильтрОтметкаЗаказы", Тип("ПолеФормы"), питКомандыИФильтрыДеревоЗаказы);
	ПолеФлажка.ПутьКДанным = "ФильтрОтметкаЗаказы";
	ПолеФлажка.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеФлажка.Заголовок = "";
	ПолеФлажка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ПолеФлажка.УстановитьДействие("ПриИзменении", "питФильтрОтметкаЗаказыПриИзменении");
	
	ПолеФормы = ЭтаФорма.Элементы.Добавить("питФильтрПриоритет", Тип("ПолеФормы"), питКомандыИФильтрыДеревоЗаказы);
	ПолеФормы.ПутьКДанным = "ФильтрПриоритет";
	ПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
	ПолеФормы.Заголовок = "Приоритет";
	ПолеФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	ПолеФормы.КнопкаОткрытия = Ложь;
	ПолеФормы.АвтоМаксимальнаяШирина = Ложь;
	ПолеФормы.МаксимальнаяШирина = 8;
	ПолеФормы.УстановитьДействие("ПриИзменении", "питФильтрПриоритетПриИзменении");
	
	ПолеФормы = ЭтаФорма.Элементы.Добавить("питФильтрКОтгрузкеНеРанее", Тип("ПолеФормы"), питКомандыИФильтрыДеревоЗаказы);
	ПолеФормы.ПутьКДанным = "ФильтрКОтгрузкеНеРанее";
	ПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
	ПолеФормы.Заголовок = "План с";
	ПолеФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	ПолеФормы.УстановитьДействие("ПриИзменении"			, "питФильтрПланНеРанееПриИзменении");
	ПолеФормы.УстановитьДействие("ОбработкаВыбора"		, "питФильтрПланНеРанееОбработкаВыбора");
	ПолеФормы.УстановитьДействие("ОкончаниеВводаТекста"	, "питФильтрПланНеРанееОкончаниеВводаТекста");
	
	ПолеФормы = ЭтаФорма.Элементы.Добавить("питФильтрКОтгрузкеНеПозднее", Тип("ПолеФормы"), питКомандыИФильтрыДеревоЗаказы);
	ПолеФормы.ПутьКДанным = "ФильтрКОтгрузкеНеПозднее";
	ПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
	ПолеФормы.Заголовок = "по";
	ПолеФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	ПолеФормы.УстановитьДействие("ПриИзменении"			, "питФильтрПланНеПозднееПриИзменении");
	ПолеФормы.УстановитьДействие("ОбработкаВыбора"		, "питФильтрПланНеПозднееОбработкаВыбора");
	ПолеФормы.УстановитьДействие("ОкончаниеВводаТекста"	, "питФильтрПланНеПозднееОкончаниеВводаТекста");
	
	ПолеФлажка = ЭтаФорма.Элементы.Добавить("питФильтрНеобеспеченные", Тип("ПолеФормы"), питКомандыИФильтрыДеревоЗаказы);
	ПолеФлажка.ПутьКДанным = "ФильтрНеобеспеченные";
	ПолеФлажка.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеФлажка.Заголовок = "";
	ПолеФлажка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ПолеФлажка.УстановитьДействие("ПриИзменении", "питФильтрНеобеспеченныеПриИзменении");
	
	// ДеревоЗаказыКОбеспечению
	ЭлементДеревоЗаказыКОбеспечению = ЭтаФорма.Элементы.Вставить("ДеревоЗаказыКОбеспечению", Тип("ТаблицаФормы"), питГруппаЗаказыКОформлению);
	ЭлементДеревоЗаказыКОбеспечению.ПутьКДанным = "ДеревоЗаказыКОбеспечению";
	ЭтаФорма.Элементы.ДеревоЗаказыКОбеспечениюКоманднаяПанель.Видимость = Ложь;
	ЭлементДеревоЗаказыКОбеспечению.УстановитьДействие("Выбор"						, "ДеревоЗаказыКОбеспечениюВыбор");
	ЭлементДеревоЗаказыКОбеспечению.УстановитьДействие("ПередНачаломДобавления"		, "ДеревоЗаказыКОбеспечениюПередНачаломДобавления");
	ЭлементДеревоЗаказыКОбеспечению.УстановитьДействие("ПередУдалением"				, "ДеревоЗаказыКОбеспечениюПередУдалением");
	ЭлементДеревоЗаказыКОбеспечению.УстановитьДействие("ОкончаниеПеретаскивания"	, "ДеревоЗаказыКОбеспечениюОкончаниеПеретаскивания");
	ЭлементДеревоЗаказыКОбеспечению.УстановитьДействие("Перетаскивание"				, "ДеревоЗаказыКОбеспечениюПеретаскивание");
	
	НоваяГруппаКолонкаДерева = ЭтаФорма.Элементы.Добавить("ДеревоЗаказыКОбеспечениюГруппировкаЗаказ",Тип("ГруппаФормы"), ЭлементДеревоЗаказыКОбеспечению);
	НоваяГруппаКолонкаДерева.Вид = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаКолонкаДерева.ОтображатьВШапке = Ложь;
	НоваяГруппаКолонкаДерева.Группировка = ГруппировкаКолонок.ВЯчейке;
	
	НоваяКолонкаДерева = ЭтаФорма.Элементы.Добавить("ДеревоЗаказыКОбеспечениюГруппировка",Тип("ПолеФормы"), НоваяГруппаКолонкаДерева);
	НоваяКолонкаДерева.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонкаДерева.ПутьКДанным = "ДеревоЗаказыКОбеспечению.Группировка";
	НоваяКолонкаДерева.ТолькоПросмотр = Истина;
	
	НоваяКолонкаДерева = ЭтаФорма.Элементы.Добавить("ДеревоЗаказыКОбеспечениюЗаказ",Тип("ПолеФормы"), НоваяГруппаКолонкаДерева);
	НоваяКолонкаДерева.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонкаДерева.ПутьКДанным = "ДеревоЗаказыКОбеспечению.Заказ";
	НоваяКолонкаДерева.ТолькоПросмотр = Истина;
	
	НоваяКолонкаДерева = ЭтаФорма.Элементы.Добавить("ДеревоЗаказыКОбеспечениюКартинкаПриоритета",Тип("ПолеФормы"), ЭлементДеревоЗаказыКОбеспечению);
	НоваяКолонкаДерева.Вид = ВидПоляФормы.ПолеКартинки;
	НоваяКолонкаДерева.ПутьКДанным = "ДеревоЗаказыКОбеспечению.КартинкаПриоритета";
	НоваяКолонкаДерева.ТолькоПросмотр = Истина;
	НоваяКолонкаДерева.РастягиватьПоГоризонтали = Ложь;
	НоваяКолонкаДерева.КартинкаЗначений = БиблиотекаКартинок.Приоритеты;
	НоваяКолонкаДерева.Заголовок = " ";
	
	НоваяГруппаКолонкаДерева = ЭтаФорма.Элементы.Добавить("ДеревоЗаказыКОбеспечениюНоменклатураХарактеристикаНазначение",Тип("ГруппаФормы"), ЭлементДеревоЗаказыКОбеспечению);
	НоваяГруппаКолонкаДерева.Вид = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаКолонкаДерева.ОтображатьВШапке = Ложь;
