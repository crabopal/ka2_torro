//  Процедура - Дерево заказы к обеспечению перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению к заказу при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюКЗаказуПриИзменении(Элемент)
	
	БылиИзменения = Ложь;
	
	Поставка = Элементы.ДеревоЗаказыКОбеспечению.ТекущиеДанные;
	
	Если НЕ Поставка = Неопределено Тогда
		
		СтараяОтметка = Поставка.Отметка;
		
		Если ПустаяСтрока(Поставка.Группировка) Тогда
			
			Если Элемент = Элементы.ДеревоЗаказыКОбеспечениюКЗаказу Тогда
				Поставка.Отметка = Поставка.КЗаказу > 0;
			КонецЕсли;
			
			Поставка.Округлено	= Поставка.КЗаказу;
			ТекИдентификатор	= Поставка.ПолучитьИдентификатор();
			
		КонецЕсли;
		
		БылиИзменения = Истина;
		
	КонецЕсли;
	
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
	
	// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
	Если БылиИзменения И (СтараяОтметка <> Поставка.Отметка ИЛИ Элемент = Элементы.ДеревоЗаказыКОбеспечениюОтметка) И ФильтрОтметкаЗаказы Тогда
		питОтборДеревоЗаказы();
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению дата поставки очистка.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюДатаПоставкиОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению дата поставки при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюДатаПоставкиПриИзменении(Элемент)
	
	// Текущие данные.
	Поставка = Элементы.ДеревоЗаказыКОбеспечению.ТекущиеДанные;
	Если НЕ Поставка = Неопределено Тогда
		Если Поставка[СтрЗаменить(Элемент.Имя,"ДеревоЗаказыКОбеспечению","")] <> Поставка[СтрЗаменить(Элемент.Имя,"ДеревоЗаказыКОбеспечению","")+"1"] Тогда
			
			// Обновить связанные данные.
			питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
			
			// Перезагрузить дерево, в случае если оно могло измениться из-за отбора.
			Если ЗначениеЗаполнено(ФильтрКЗаказуНеПозднее) ИЛИ ЗначениеЗаполнено(ФильтрКОтгрузкеНеПозднее) Тогда
				питОтборДеревоЗаказы();
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению цеховая кладовая при изменении.
//
// Параметры:
