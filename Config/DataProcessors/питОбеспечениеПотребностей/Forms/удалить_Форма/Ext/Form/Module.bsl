		|СГРУППИРОВАТЬ ПО 
		|	Т.Ссылка";
		
	// ++ Устарело_Переработка24
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказПереработчику") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Т.Ссылка                             КАК Документ,
		|	МАКСИМУМ(Т.Статус)                   КАК Статус,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА Т.Проведен
		|			ТОГДА 0
		|		КОГДА Т.ПометкаУдаления
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ)                               КАК СтандартнаяКартинка,
		|	МАКСИМУМ(Т.Организация)              КАК Организация,
		|	МАКСИМУМ(Т.Партнер)                  КАК ИсточникОбеспечения,
		|	МАКСИМУМ(Т.СуммаДокумента)           КАК Сумма,
		|	МАКСИМУМ(Т.Валюта)                   КАК Валюта,
		|	МАКСИМУМ(
		// ++ НЕ УТКА
		|		ЕСТЬNULL(ЭтапТовары.ДатаПроизводства, 
		// -- НЕ УТКА
		|		ЗаказТовары.ДатаПоступления
		// ++ НЕ УТКА
		|			)
		// -- НЕ УТКА
		|		) КАК ДатаПоставки,
		|	МИНИМУМ(
		// ++ НЕ УТКА
		|		ЕСТЬNULL(ЭтапТовары.ДатаПроизводства, 
		// -- НЕ УТКА
		|		ЗаказТовары.ДатаПоступления
		// ++ НЕ УТКА
		|			)
		// -- НЕ УТКА
		|		)  КАК ДатаПоставкиМинимум
		|ИЗ
		|	Документ.ЗаказПереработчику КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПереработчику.Продукция КАК ЗаказТовары
		|		ПО ЗаказТовары.Ссылка = Т.Ссылка
		// ++ НЕ УТКА
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПереработчику.Услуги КАК ЗаказУслуги
		|		ПО ЗаказУслуги.Ссылка = Т.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ЭтапТовары
		|		ПО ЭтапТовары.Ссылка = ЗаказУслуги.Распоряжение
		|			И НЕ ЭтапТовары.Отменено
