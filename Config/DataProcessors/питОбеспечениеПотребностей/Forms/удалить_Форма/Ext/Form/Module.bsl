//  Процедура - пит установить условное оформление.
//
&НаСервере
Процедура питУстановитьУсловноеОформление()
	
	// +пит Дерево заказов к оформлению
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДеревоЗаказыКОбеспечениюКЗаказу");
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДеревоЗаказыКОбеспечениюОтметка");
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЗаказыКОбеспечению.Группировка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ИменаКолонокГруппировка		= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(0);
	ИменаКолонокРесурсы			= питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(2);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДеревоЗаказыКОбеспечениюГруппировка");
	
	Для каждого ТекИмя Из ИменаКолонокГруппировка Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДеревоЗаказыКОбеспечению"+ТекИмя);
	КонецЦикла;
	Для каждого ТекИмя Из ИменаКолонокРесурсы Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДеревоЗаказыКОбеспечению"+ТекИмя);
	КонецЦикла;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЗаказыКОбеспечению.Группировка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,Истина));
	// -пит
	
КонецПроцедуры

// Процедура устанавливает настройки по умолчанию с учетом отраслевой специфики
//
&НаСервере
Процедура питУстановитьНастройкиПоУмолчанию()
	
	питПредполагаемыйИсходныйНомерПлана = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питПланМеню.Номер КАК Номер
	|ИЗ
	|	Документ.питПланМеню КАК питПланМеню
	|ГДЕ
	|	питПланМеню.Дата > НАЧАЛОПЕРИОДА(&Дата, ГОД)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Попытка
			питПредполагаемыйИсходныйНомерПлана = Число(ВыборкаДетальныеЗаписи.Номер);
		Исключение
			питПредполагаемыйИсходныйНомерПлана = 0;
		КонецПопытки;
	КонецЕсли;
	
	питМаксНомерПлана = питПредполагаемыйИсходныйНомерПлана;
	
КонецПроцедуры

