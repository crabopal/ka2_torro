&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюПодразделениеПриИзменении(Элемент)
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению организация при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюОрганизацияПриИзменении(Элемент)
	// Обновить связанные данные.
	питДеревоЗаказыКОбеспечениюИзмерениеПриИзменении(Элемент);
КонецПроцедуры

//  Процедура - Дерево заказы к обеспечению выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоЗаказыКОбеспечениюВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено Тогда
		
		РедактируемыеКолонки = питДеревоЗаказыКОбеспечениюПолучитьИменаКолонокГруппировки(3);
		ИмяКолонкиДерева = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ДеревоЗаказыКОбеспечению","");
		Если ИмяКолонкиДерева = "Группировка" Тогда
			ИмяКолонкиДерева = "Заказ";
		КонецЕсли;
		
		// Верхний уровень дерева, заказ не запонен.
		Если ИмяКолонкиДерева = "Заказ" И НЕ ПустаяСтрока(ТекДанные.Группировка) Тогда
			Возврат;
		КонецЕсли;
		
		Если РедактируемыеКолонки.Найти(ИмяКолонкиДерева) = Неопределено Тогда
			СтандартнаяОбработка = Ложь;
			Попытка
				ПоказатьЗначение(, ТекДанные[ИмяКолонкиДерева]);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

