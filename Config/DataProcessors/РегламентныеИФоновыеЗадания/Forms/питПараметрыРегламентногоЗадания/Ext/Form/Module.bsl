
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ИмяМетаданных") Тогда
		ИмяМетаданных = Параметры.ИмяМетаданных;
	КонецЕсли;
	Если ИмяМетаданных = "питЗагрузкаRKeeper" Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Настройка параметров для RKeeper 7 производится в учетных записях RKeeper.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Если Параметры.Свойство("Идентификатор") Тогда
		Идентификатор = Параметры.Идентификатор;
	КонецЕсли;
	Если Параметры.Свойство("Действие") Тогда
		Действие = Параметры.Действие;
	КонецЕсли;
	Если Параметры.Свойство("питПараметрыВХранилище") Тогда
		питПараметрыВХранилище = Параметры.питПараметрыВХранилище;
	КонецЕсли;
	Задание = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(Идентификатор);
	обПрочитатьПараметры(Задание);
	
	Если Действие <> "Изменить" Тогда // Это могло быть копирование и в таком случае идентификатор скопирован
		Идентификатор = НСтр("ru = '<будет создан при записи>'");
	КонецЕсли;
	
	питЭтотУзел = ПланыОбмена.питУдаленныеКассы.ЭтотУзел();
	обУстановитьУсловноеОформление();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	обОбновитьОтображениеПараметров();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура питКассовыеУзлыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяМетаданных = "питОбменСУдаленнымиКассами" Тогда
		ТекущаяСтрока = Элементы.питКассовыеУзлы.ТекущиеДанные;
	ИначеЕсли ИмяМетаданных = "питЗагрузкаИзДанныхПродажФронта" Тогда
		ТекущаяСтрока = Элементы.питКассовыеУзлыДПФ.ТекущиеДанные;
	КонецЕсли;
		
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.УзелОбмена) Тогда
		ПоказатьПредупреждение(, "Не заполнен узел обмена!", 10);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.УзелОбмена = питЭтотУзел Тогда
		ПоказатьПредупреждение(, "Выбран узел, соответствующей текущей базе. Обмен производится только с другими узлами.", 10);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИмяМетаданных = "питОбменСУдаленнымиКассами" ИЛИ ИмяМетаданных = "питЗагрузкаИзДанныхПродажФронта" Тогда
		Если питКассовыеУзлы.НайтиСтроки(Новый Структура("УзелОбмена", ТекущаяСтрока.УзелОбмена)).Количество() > 1 Тогда
			ПоказатьПредупреждение(, "Внимание! Узел <" + СокрЛП(ТекущаяСтрока.УзелОбмена) + "> уже есть в табличной части.
							|Убедитесь что строки имеют разные режимы обработки и расположены в правильной последовательности", 10);				
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура питКассовыеУзлыУзелОбменаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.питКассовыеУзлы.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.питКассовыеУзлыДПФ.ТекущиеДанные;
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураСвойств = обПолучитьСвойстваУзлаОбмена(ТекущаяСтрока.УзелОбмена);
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураСвойств);
КонецПроцедуры

&НаКлиенте
Процедура питКассовыеУзлыНастройкаДоставкиПриИзменении(Элемент)
	питКассовыеУзлыНастройкаДоставкиПриИзмененииНаСервере(Элементы.питКассовыеУзлы.ТекущаяСтрока);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура Сохранить(Команда)
	//Проверка на дубли параметров
	НазваниеТаблицыДляПроверки = "";
	НазваниеТаблицыПараметров = "";
	НазваниеКолонки = "";
	Если ИмяМетаданных = "питОбменСУдаленнымиКассами" Тогда
		НазваниеТаблицыДляПроверки = "питКассовыеУзлы";
		НазваниеТаблицыПараметров = "КассовыеУзлы";
		НазваниеКолонки = "УзелОбмена";
	ИначеЕсли  ИмяМетаданных = "питЗагрузкаИзДанныхПродажФронта" Тогда	
		НазваниеТаблицыДляПроверки = "питКассовыеУзлы";
		НазваниеТаблицыПараметров = "КассовыеУзлы";
		НазваниеКолонки = "УзелОбмена";
	ИначеЕсли ИмяМетаданных = "питЗагрузкаRKeeper" Тогда
		НазваниеТаблицыДляПроверки = "питКассыККМ";
		НазваниеТаблицыПараметров = "КассыККМ";
		НазваниеКолонки = "КассаККМ";
	ИначеЕсли ИмяМетаданных = "питОбработкаОчередиОтложенногоПроведения" Тогда
		НазваниеТаблицыДляПроверки = "питОрганизации";
		НазваниеТаблицыПараметров = "питОрганизации";
		НазваниеКолонки = "Организация";
	КонецЕсли;
	Если ЗначениеЗаполнено(НазваниеТаблицыДляПроверки) И ЗначениеЗаполнено(НазваниеТаблицыДляПроверки) И ЗначениеЗаполнено(НазваниеКолонки) Тогда
		РезультатПроверки = обПроверитьСовпаденияВТаблицахПараметров(НазваниеТаблицыДляПроверки, НазваниеТаблицыПараметров, НазваниеКолонки);
		ФлагУспеха = РезультатПроверки.Результат;
		Если НЕ ФлагУспеха И РезультатПроверки.Свойство("СтрокаВопроса") И РезультатПроверки.Свойство("АдресСтруктурыСовпадений") Тогда			
			//Ответ = Вопрос(РезультатПроверки.СтрокаВопроса, РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Отмена);
			
			Результат = Ждать ВопросАсинх(РезультатПроверки.СтрокаВопроса, РежимДиалогаВопрос.ДаНетОтмена, 0, КодВозвратаДиалога.Отмена);
			
			Если Результат = КодВозвратаДиалога.Да Тогда
				ФлагУспеха = обУдалитьСовпаденияИзДругихЗаданий(РезультатПроверки, НазваниеТаблицыПараметров, НазваниеКолонки);
			ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
				ФлагУспеха = обУдалитьСовпаденияИзТекущегоЗадания(РезультатПроверки, НазваниеТаблицыДляПроверки, НазваниеКолонки);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ФлагУспеха Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//Сохранение параметров для передачи в обработчик оповещения
	АдресПараметровВХранилище = обСформироватьПараметры();
	ЭтаФорма.Закрыть(АдресПараметровВХранилище);	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция обСформироватьПараметры()
	
	СтруктураПараметров = Новый Структура;
	
	Если ИмяМетаданных = "питОбменСУдаленнымиКассами" Тогда
		СтруктураПараметров.Вставить("КассовыеУзлы", питКассовыеУзлы.Выгрузить());
		
		СтруктураПараметров.Вставить("ВестиЖурналРегистрации", питВестиЖурналРегистрации);
		СтруктураПараметров.Вставить("ФиксироватьПриемОтправкуОбъектов", питФиксироватьПриемОтправкуОбъектов);
		//Если питОбменДанными.РазделениеВключено() Тогда
		//	СтруктураПараметров.Вставить("ЕстьПодтверждениеНаВыгрузку", ЕстьПодтверждениеНаВыгрузку);
			СтруктураПараметров.Вставить("ЕстьПодтверждениеНаВыгрузку", Истина); //Пока истина до появления фреша
		//КонецЕсли;
		
	ИначеЕсли ИмяМетаданных = "питЗагрузкаИзДанныхПродажФронта" Тогда
		СтруктураПараметров.Вставить("КассовыеУзлы", питКассовыеУзлы.Выгрузить());
		СтруктураПараметров.Вставить("Организация", Организация);

	ИначеЕсли ИмяМетаданных = "питЗагрузкаRKeeper" Тогда
		СтруктураПараметров.Вставить("КассыККМ", питКассыККМ.Выгрузить());
		
		
	ИначеЕсли ИмяМетаданных = "питОбработкаОчередиОтложенногоПроведения" Тогда
		СтруктураПараметров.Вставить("питОрганизации", питОрганизации.Выгрузить());
		
	ИначеЕсли ИмяМетаданных = "питКонтрольОстатковМарокИС" Тогда
		
		СтруктураПараметров.Вставить("СписыватьПросроченныеПозиции", СписыватьПросроченныеПозиции);
		СтруктураПараметров.Вставить("ОтключатьПивныеКегиБезОстатков", ОтключатьПивныеКегиБезОстатков);
		
	КонецЕсли;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(СтруктураПараметров);
	
	питПараметрыВХранилище = ПоместитьВоВременноеХранилище(МассивПараметров, Новый УникальныйИдентификатор);

	Возврат питПараметрыВХранилище;
	
КонецФункции

&НаСервере
// Выполняет поиск совпадений объектов в таблицах параметров 
// регламентных заданий одного типа
//
// Параметры
//  - ТаблицаДляПроверки - ТаблицаЗначений - Таблица текущего регламентного задания
//	- НазваниеТаблицы - Строка - Название таблицы значений в параметрах проверяемых заданий
//  - НазваниеКолонки - Строка - Название колонки по которой будет происходить поиск совпадений
//
// Возвращаемое значение
//  - Булево - Результат обработки совпадений
//
Функция обПроверитьСовпаденияВТаблицахПараметров(НазваниеТаблицыДляПроверки, НазваниеТаблицыПараметров, НазваниеКолонки)
	
	СтруктураРезультата = Новый Структура;
	
	Рез = Истина;
	
	Попытка		
		ТаблицаДляПроверки = ЭтаФорма[НазваниеТаблицыДляПроверки];		
	Исключение	
		СтруктураРезультата.Вставить("Результат", Ложь);
		Возврат СтруктураРезультата;	
	КонецПопытки;
	
	Попытка 
		УИД = Новый УникальныйИдентификатор(Идентификатор);
	Исключение
		УИД = Идентификатор;
	КонецПопытки;
	
	Совпадения = Новый ТаблицаЗначений;
	Совпадения.Колонки.Добавить("НомерЗадания");
	Совпадения.Колонки.Добавить("НомерПараметра");
	Совпадения.Колонки.Добавить(НазваниеКолонки);
	
	СтрокаВопроса = "Найдены совпадения параметров в следующих заданиях:" + Символы.ПС + "%дляЗамены%";	
		
	Регламентные = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	Для Сч = 0 По Регламентные.ВГраница() Цикл
		Если Регламентные[Сч].УникальныйИдентификатор <> УИД И Найти(Регламентные[Сч], ИмяМетаданных) Тогда
			ПараметрыЗадания = Регламентные[Сч].Параметры;
			НомерПараметра = 0;
			Для Каждого Параметр Из ПараметрыЗадания Цикл
				Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство(НазваниеТаблицыПараметров) Тогда
					ТаблицаПроверяемогоЗадания = Параметр[НазваниеТаблицыПараметров];
					Для Каждого ТекСтрока Из ТаблицаДляПроверки Цикл
						Если ТаблицаПроверяемогоЗадания.Найти(ТекСтрока[НазваниеКолонки], НазваниеКолонки) <> Неопределено Тогда
							НоваяСтрока = Совпадения.Добавить();
							НоваяСтрока.НомерЗадания = Сч;
							НоваяСтрока.НомерПараметра = НомерПараметра;
							НоваяСтрока[НазваниеКолонки] = ТекСтрока[НазваниеКолонки];							
							
							СтрокаВопроса = СтрЗаменить(СтрокаВопроса, 
														"%дляЗамены%", 
														" - " + Регламентные[Сч].Наименование + " : " + ТекСтрока[НазваниеКолонки] + ";" + Символы.ПС + "%дляЗамены%");
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				НомерПараметра = НомерПараметра + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	
	Если Совпадения.Количество() > 0 Тогда
		Рез = Ложь;
				
		СтрокаВопроса = СтрЗаменить(СтрокаВопроса, 
									"%дляЗамены%", 
									Символы.ПС + "Удалить совпадающие объекты из перечисленных заданий?"
									+ Символы.ПС + "Да - удалить из перечисленных заданий."
									+ Символы.ПС + "Нет - удалить из ЭТОГО задания."
									+ Символы.ПС + "Отмена - вернуться к редактированию.");
		
		СтруктураХранения = Новый Структура;
		СтруктураХранения.Вставить("МассивЗаданий", Регламентные);
		СтруктураХранения.Вставить("МассивСовпадений", Совпадения);
		
		АдресСтруктурыСовпадений = ПоместитьВоВременноеХранилище(СтруктураХранения, ЭтаФорма);
		
		СтруктураРезультата.Вставить("СтрокаВопроса", СтрокаВопроса);
		СтруктураРезультата.Вставить("АдресСтруктурыСовпадений", АдресСтруктурыСовпадений);
		
	КонецЕсли;
	
	СтруктураРезультата.Вставить("Результат", Рез);
	
	Возврат СтруктураРезультата;
КонецФункции

&НаСервере
Функция обУдалитьСовпаденияИзТекущегоЗадания(ПараметрыСовпадений, НазваниеТаблицыДляПроверки, НазваниеКолонки)
	СтруктураСовпадений = ПолучитьИзВременногоХранилища(ПараметрыСовпадений.АдресСтруктурыСовпадений);
	
	МассивЗаданий = СтруктураСовпадений.МассивЗаданий;
	МассивСовпадений = СтруктураСовпадений.МассивСовпадений;
	
	ТаблицаДляПроверки = ЭтаФорма[НазваниеТаблицыДляПроверки];
	
	Рез = Истина;
	
	Попытка				
		Для Каждого Совпадение Из МассивСовпадений Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить(НазваниеКолонки, Совпадение[НазваниеКолонки]);
			
			ОбъектыДляУдаления = ТаблицаДляПроверки.НайтиСтроки(ПараметрыОтбора);						
			Для Каждого ТекСтрока Из ОбъектыДляУдаления Цикл
				ТаблицаДляПроверки.Удалить(ТекСтрока);
			КонецЦикла;
		КонецЦикла;		
	Исключение				
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Ошибка удаления объекта: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		Рез = Ложь;				
	КонецПопытки;
	
	Возврат Рез;
КонецФункции

&НаСервере
Функция обУдалитьСовпаденияИзДругихЗаданий(ПараметрыСовпадений, НазваниеТаблицыПараметров, НазваниеКолонки)
	СтруктураСовпадений = ПолучитьИзВременногоХранилища(ПараметрыСовпадений.АдресСтруктурыСовпадений);
	
	МассивЗаданий = СтруктураСовпадений.МассивЗаданий;
	МассивСовпадений = СтруктураСовпадений.МассивСовпадений;
	
	Рез = Истина;
	
	Попытка				
		Для Каждого Совпадение Из МассивСовпадений Цикл
			ОбъектыДляУдаления = МассивЗаданий[Совпадение.НомерЗадания].Параметры[Совпадение.НомерПараметра][НазваниеТаблицыПараметров];
			ОбъектДляУдаления = ОбъектыДляУдаления.Найти(Совпадение[НазваниеКолонки], НазваниеКолонки);						
			Если ОбъектДляУдаления <> Неопределено Тогда
				ОбъектыДляУдаления.Удалить(ОбъектДляУдаления);
			КонецЕсли;
			МассивЗаданий[Совпадение.НомерЗадания].Записать();
		КонецЦикла;		
	Исключение				
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Ошибка удаления объекта: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		Рез = Ложь;				
	КонецПопытки;
	
	Возврат Рез;
КонецФункции

&НаСервере
Процедура обПрочитатьПараметры(Задание)
	
	Если Задание.Параметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(питПараметрыВХранилище) Тогда
		ПараметрыЗадания = ПолучитьИзВременногоХранилища(питПараметрыВХранилище)[0];
	Иначе		
		ПараметрыЗадания = Задание.Параметры[0];
	КонецЕслИ;
	Если ТипЗнч(ПараметрыЗадания) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяМетаданных = "питОбменСУдаленнымиКассами" Тогда
		питКассовыеУзлы.Очистить();
		
		Если ПараметрыЗадания.Свойство("КассовыеУзлы") Тогда
			Для Каждого КассовыйУзел Из ПараметрыЗадания.КассовыеУзлы Цикл
				НоваяСтрока = питКассовыеУзлы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, КассовыйУзел);
			КонецЦикла;
		КонецЕсли;	
		
		ПараметрыЗадания.Свойство("ВестиЖурналРегистрации", питВестиЖурналРегистрации);
		ПараметрыЗадания.Свойство("ФиксироватьПриемОтправкуОбъектов", питФиксироватьПриемОтправкуОбъектов);
		//Если питОбменДанными.РазделениеВключено() Тогда
		//	ПараметрыЗадания.Свойство("ЕстьПодтверждениеНаВыгрузку", ЕстьПодтверждениеНаВыгрузку);
			ПараметрыЗадания.Свойство("ЕстьПодтверждениеНаВыгрузку", Истина); // Пока истина до фреша
		//КонецЕсли;
	ИначеЕсли  ИмяМетаданных = "питЗагрузкаИзДанныхПродажФронта" Тогда
		питКассовыеУзлы.Очистить();
		Если ПараметрыЗадания.Свойство("КассовыеУзлы") Тогда
			Для Каждого КассовыйУзел Из ПараметрыЗадания.КассовыеУзлы Цикл
				НоваяСтрока = питКассовыеУзлы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, КассовыйУзел);
			КонецЦикла;
		КонецЕсли;
		ПараметрыЗадания.Свойство("Организация", Организация);
	ИначеЕсли ИмяМетаданных = "питЗагрузкаRKeeper" Тогда
		питКассыККМ.Очистить();
		
		Если ПараметрыЗадания.Свойство("КассыККМ") Тогда
			Для Каждого ТекСтрока Из ПараметрыЗадания.КассыККМ Цикл
				НоваяСтрока = питКассыККМ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяМетаданных = "питОбработкаОчередиОтложенногоПроведения" Тогда
		питОрганизации.Очистить();
		
		Если ПараметрыЗадания.Свойство("питОрганизации") Тогда
			Для Каждого ТекСтрока Из ПараметрыЗадания.питОрганизации Цикл
				НоваяСтрока = питОрганизации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ИмяМетаданных = "питКонтрольОстатковМарокИС" Тогда
		
		СписыватьПросроченныеПозиции = Истина;
		Если ПараметрыЗадания.Свойство("СписыватьПросроченныеПозиции") Тогда
			СписыватьПросроченныеПозиции = ПараметрыЗадания.СписыватьПросроченныеПозиции;
		КонецЕсли;
		
		ОтключатьПивныеКегиБезОстатков = Истина;
		Если ПараметрыЗадания.Свойство("ОтключатьПивныеКегиБезОстатков") Тогда
			ОтключатьПивныеКегиБезОстатков = ПараметрыЗадания.ОтключатьПивныеКегиБезОстатков;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура обОбновитьОтображениеПараметров()	
	обОбновитьОтображениеПараметровНаСервере();
КонецПроцедуры

&НаСервере
Процедура обОбновитьОтображениеПараметровНаСервере()	
	
	Для Каждого Страница Из Элементы.питГруппаСтраницы.ПодчиненныеЭлементы Цикл
		Если СтрНайти(Страница.Имя, ИмяМетаданных) <> 0 Тогда
			Элементы.питГруппаСтраницы.Видимость = Истина;
			Страница.Видимость = Истина;
		Иначе
			Страница.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура обУстановитьУсловноеОформление()
	
	РежимыОбменаСУдаленнымиКассами = Новый Соответствие;
	РежимыОбменаСУдаленнымиКассами.Вставить(0, "Загружать сообщение обмена");
	РежимыОбменаСУдаленнымиКассами.Вставить(1, "Выгружать сообщение обмена");
	РежимыОбменаСУдаленнымиКассами.Вставить(2, "Загружать и выгружать сообщение обмена");
	РежимыОбменаСУдаленнымиКассами.Вставить(3, "Выгружать сообщение обмена при удачной загрузке");

	
	Для Каждого РежимОбмена Из РежимыОбменаСУдаленнымиКассами Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "питКассовыеУзлыРежим");		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "питКассовыеУзлы.Режим", ВидСравненияКомпоновкиДанных.Равно, РежимОбмена.Ключ);		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", РежимОбмена.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция обПолучитьСвойстваУзлаОбмена(УзелОбмена)
	
	СтруктураРезультата = Новый Структура;
	
	СтруктураРезультата.Вставить("НастройкаДоставки", УзелОбмена.НастройкаДоставкиПоУмолчанию);
	СтруктураРезультата.Вставить("Префикс", УзелОбмена.Префикс);
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаСервере
Процедура питКассовыеУзлыНастройкаДоставкиПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	ТекСтрока = питКассовыеУзлы.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	Если НЕ ТекСтрока = Неопределено Тогда
		КаталогНаКлиенте = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрока.НастройкаДоставки, "КаталогНаКлиенте");
		Если КаталогНаКлиенте Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Внимание, выбранная настройка доставки указывает на то, что каталог обмена находится на клиенте.
			|Регламентное задание проигнорирует такую строку.";
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

