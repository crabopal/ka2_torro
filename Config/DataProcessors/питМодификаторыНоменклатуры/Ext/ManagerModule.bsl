// Функция проверяет нет ли у номенклатуры уже такого модификатора
//
// Параметры:
//  Номенклатура - Произвольный - Знач номенклатура.
//  Модификатор - Произвольный - Знач модификатор.
//  ГруппаМодификатора - Произвольный - Знач группа модификатора.
//
// Возвращаемое значение:
//     Булево - Добавление возможно (у номенклатуры нет переданного модификатора).
Функция ПроверитьВозможностьДобавленияМодификатора(ЗНАЧ Номенклатура, ЗНАЧ Модификатор, ЗНАЧ ГруппаМодификатора) Экспорт
	Если Не ЗначениеЗаполнено(Модификатор) И НЕ ЗначениеЗаполнено(ГруппаМодификатора) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Сформируем запрос с отборами
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МодификаторыНоменклатуры.Модификатор КАК Модификатор
	|ИЗ
	|	РегистрСведений.питМодификаторыНоменклатуры КАК МодификаторыНоменклатуры
	|ГДЕ
	|	МодификаторыНоменклатуры.Номенклатура = &Номенклатура
	|	И МодификаторыНоменклатуры.Модификатор = &Модификатор
	|	И МодификаторыНоменклатуры.ГруппаМодификатора = &ГруппаМодификатора");
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Модификатор", Модификатор);
	Запрос.УстановитьПараметр("ГруппаМодификатора", ГруппаМодификатора);
	
	// Возврат результата
	Возврат Запрос.Выполнить().Пустой();
КонецФункции // ПроверитьВозможностьДобавленияМодификатора()

// Процедура заполнения ТЧ Модификаторы по Номенклатуре
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  Модификаторы - Произвольный - Модификаторы.
//
Процедура ЗаполнитьМодификаторы(Номенклатура, Модификаторы) Экспорт
	// Сформируем запрос с отбором по номенклатуре
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МодификаторыНоменклатуры.Модификатор КАК Модификатор,
	|	МодификаторыНоменклатуры.Модификатор.ЕдиницаИзмеренияМодификатора КАК ЕдиницаИзмеренияМодификатора,
	|	МодификаторыНоменклатуры.Модификатор.Цена КАК Цена,
	|	МодификаторыНоменклатуры.ГруппаМодификатора.МинимальноеКоличествоМодификаторов КАК МинимальноеКоличествоМодификаторов,
	|	МодификаторыНоменклатуры.ГруппаМодификатора.МаксимальноеКоличествоМодификаторов КАК МаксимальноеКоличествоМодификаторов,
	|	МодификаторыНоменклатуры.Модификатор.ДопНоменклатура КАК Номенклатура,
	|	МодификаторыНоменклатуры.Модификатор.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	МодификаторыНоменклатуры.ГруппаМодификатора
	|ИЗ
	|	РегистрСведений.питМодификаторыНоменклатуры КАК МодификаторыНоменклатуры
	|ГДЕ
	|	МодификаторыНоменклатуры.Номенклатура = &Номенклатура");
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	// Очищаем ТЧ Модификаторы
	СтрокиМодификаторов = Модификаторы.Строки;
	СтрокиМодификаторов.Очистить();
	
	// Заполняем ТЧ модификаторы по Номенклатуре
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаМодификатор = СтрокиМодификаторов.Добавить();
		СтрокаМодификатор.Модификатор = Выборка.Модификатор;
		СтрокаМодификатор.ГруппаМодификатора = Выборка.ГруппаМодификатора;
		СтрокаМодификатор.ЕдиницаИзмеренияМодификатора = Выборка.ЕдиницаИзмеренияМодификатора;
		СтрокаМодификатор.Цена = Выборка.Цена;
		СтрокаМодификатор.МинимальноеКоличествоМодификаторов = Выборка.МинимальноеКоличествоМодификаторов;
		СтрокаМодификатор.МаксимальноеКоличествоМодификаторов = Выборка.МаксимальноеКоличествоМодификаторов;
		СтрокаМодификатор.Номенклатура = Выборка.Номенклатура;
		СтрокаМодификатор.КоличествоНоменклатуры = Выборка.КоличествоНоменклатуры;
				
		Если ЗначениеЗаполнено(Выборка.ГруппаМодификатора) И НЕ ЗначениеЗаполнено(Выборка.Модификатор) Тогда
			ЗаполнениеЭлементовГруппыМодификатора(Выборка.ГруппаМодификатора, СтрокаМодификатор);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // ЗаполнитьМодификаторы()


// Процедура заполнения ТЧ Унаследованные Модификаторы по Номенклатуре
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  УнаследованныеМодификаторы - Произвольный - Унаследованные модификаторы.
//
Процедура ЗаполнитьУнаследованныеМодификаторы(Номенклатура, УнаследованныеМодификаторы) Экспорт
	УнаследованныеМодификаторы.Очистить();
	
	// Получим все группы этой номенклатуры
	МассивГруппНоменклатуры = Новый Массив();
	ТекРодитель = Номенклатура.Родитель;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		МассивГруппНоменклатуры.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	// Выводить бизнес ланч или нет
	ВыводитьБизнесЛанч = Истина;
	Если НЕ Номенклатура.ЭтоГруппа И НЕ Номенклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.БизнесЛанч Тогда
		ВыводитьБизнесЛанч = Ложь;
	КонецЕсли;
	
	Если МассивГруппНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Соберём таблицу модификаторов
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МодификаторыНоменклатуры.Модификатор КАК Модификатор,
	|	МодификаторыНоменклатуры.ГруппаМодификатора КАК ГруппаМодификаторов,
	|	МодификаторыНоменклатуры.Номенклатура КАК ОтКогоУнаследовали
	|ИЗ
	|	РегистрСведений.питМодификаторыНоменклатуры КАК МодификаторыНоменклатуры
	|ГДЕ
	|	МодификаторыНоменклатуры.Номенклатура В(&МассивГруппНоменклатуры)"
	);
	
	Запрос.УстановитьПараметр("МассивГруппНоменклатуры", МассивГруппНоменклатуры);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Для групп получим элементы
	// Объединим таблицу элементов модификаторов и таблицу элементов групп
	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РезультатЗапроса.Модификатор КАК Модификатор,
	|	РезультатЗапроса.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|	РезультатЗапроса.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|ПОМЕСТИТЬ ТаблицаЭлементовМодификаторов
	|ИЗ
	|	&РезультатЗапроса КАК РезультатЗапроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМодификаторов.Модификатор КАК Модификатор,
	|	ТаблицаМодификаторов.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|	ТаблицаМодификаторов.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|ИЗ
	|	(ВЫБРАТЬ
	|		Модификаторы.Модификатор КАК Модификатор,
	|		ТаблицаЭлементовМодификаторов.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|		ТаблицаЭлементовМодификаторов.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|	ИЗ
	|		ТаблицаЭлементовМодификаторов КАК ТаблицаЭлементовМодификаторов
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питГруппыМодификаторов.Модификаторы КАК Модификаторы
	|			ПО ТаблицаЭлементовМодификаторов.ГруппаМодификаторов = Модификаторы.Ссылка
	|	ГДЕ
	|		ТаблицаЭлементовМодификаторов.Модификатор = ЗНАЧЕНИЕ(Справочник.питМодификаторы.ПустаяСсылка)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТаблицаЭлементовМодификаторов.Модификатор,
	|		ТаблицаЭлементовМодификаторов.ГруппаМодификаторов,
	|		ТаблицаЭлементовМодификаторов.ОтКогоУнаследовали
	|	ИЗ
	|		ТаблицаЭлементовМодификаторов КАК ТаблицаЭлементовМодификаторов
	|	ГДЕ
	|		ТаблицаЭлементовМодификаторов.Модификатор <> ЗНАЧЕНИЕ(Справочник.питМодификаторы.ПустаяСсылка)) КАК ТаблицаМодификаторов
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаМодификаторов.Модификатор,
	|	ТаблицаМодификаторов.ГруппаМодификаторов,
	|	ТаблицаМодификаторов.ОтКогоУнаследовали
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаМодификаторов,
	|	ОтКогоУнаследовали,
	|	Модификатор
	|";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("РезультатЗапроса", РезультатЗапроса);
	
	// Выводим унаследованные модификаторы
	УнаследованныеМодификаторы.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры // ЗаполнитьУнаследованныеМодификаторы()

// Процедура записи Модификатора в регистр
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  Модификатор - Произвольный - Модификатор.
//  ГруппаМодификатора - Произвольный - Группа модификатора.
//  ПредыдущийМодификатор - Произвольный - Предыдущий модификатор.
//  ПредыдущаяГруппаМодификатора - Произвольный - Предыдущая группа модификатора.
//
Процедура ЗаписатьМодификаторВРегистр(Номенклатура, Модификатор, ГруппаМодификатора, ПредыдущийМодификатор, ПредыдущаяГруппаМодификатора) Экспорт
	// Удалим запись измененного модификатора
	Если НЕ ПредыдущийМодификатор.Пустая() ИЛИ НЕ ПредыдущаяГруппаМодификатора.Пустая() Тогда
		УдалениеМодификатораИзРегистра(Номенклатура, ПредыдущийМодификатор, ПредыдущаяГруппаМодификатора);
		ПредыдущийМодификатор = Неопределено;
		ПредыдущаяГруппаМодификатора = Неопределено;
	КонецЕсли;
	
	Если Номенклатура = Неопределено ИЛИ Модификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создадим набор записей
	НаборЗаписейМодификаторыНоменклатуры = РегистрыСведений.питМодификаторыНоменклатуры.СоздатьНаборЗаписей();
	
	// Установим отбор по Номенклатуре
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Номенклатура.Значение = Номенклатура;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Номенклатура.ВидСравнения = ВидСравнения.Равно;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Номенклатура.Использование = Истина;
	
	// Установим отбор по Модификатору
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Модификатор.Значение = Модификатор;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Модификатор.ВидСравнения = ВидСравнения.Равно;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Модификатор.Использование = Истина;
	
	// Установим отбор по Модификатору
	НаборЗаписейМодификаторыНоменклатуры.Отбор.ГруппаМодификатора.Значение = ГруппаМодификатора;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.ГруппаМодификатора.ВидСравнения = ВидСравнения.Равно;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.ГруппаМодификатора.Использование = Истина;
	
	// Очистим набор записей
	НаборЗаписейМодификаторыНоменклатуры.Прочитать();
	НаборЗаписейМодификаторыНоменклатуры.Очистить();
	
	// Добавим запись
	СтрокаМодификаторыНоменклатуры = НаборЗаписейМодификаторыНоменклатуры.Добавить();
	СтрокаМодификаторыНоменклатуры.Номенклатура = Номенклатура;
	СтрокаМодификаторыНоменклатуры.Модификатор = Модификатор;
	СтрокаМодификаторыНоменклатуры.ГруппаМодификатора = ГруппаМодификатора;
	
	// Сохраним
	Попытка
		НаборЗаписейМодификаторыНоменклатуры.Записать();
	Исключение
		
	КонецПопытки;
КонецПроцедуры // ЗаписатьМодификаторВРегистр()

// Процедура удаления Модификатора из регистра
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  Модификатор - Произвольный - Модификатор.
//  ГруппаМодификатора - Произвольный - Группа модификатора.
//
Процедура УдалениеМодификатораИзРегистра(Номенклатура, Модификатор, ГруппаМодификатора) Экспорт
	Если Номенклатура = Неопределено ИЛИ Модификатор = Неопределено ИЛИ ГруппаМодификатора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создадим набор записей
	НаборЗаписейМодификаторыНоменклатуры = РегистрыСведений.питМодификаторыНоменклатуры.СоздатьНаборЗаписей();
	
	// Установим отбор по Номенклатуре
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Номенклатура.Значение = Номенклатура;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Номенклатура.ВидСравнения = ВидСравнения.Равно;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Номенклатура.Использование = Истина;
	
	// Установим отбор по Модификатору
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Модификатор.Значение = Модификатор;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Модификатор.ВидСравнения = ВидСравнения.Равно;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.Модификатор.Использование = Истина;
	
	// Установим отбор по Модификатору
	НаборЗаписейМодификаторыНоменклатуры.Отбор.ГруппаМодификатора.Значение = ГруппаМодификатора;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.ГруппаМодификатора.ВидСравнения = ВидСравнения.Равно;
	НаборЗаписейМодификаторыНоменклатуры.Отбор.ГруппаМодификатора.Использование = Истина;
	
	// Очистим набор записей
	НаборЗаписейМодификаторыНоменклатуры.Записать();
КонецПроцедуры // УдалениеМодификатораИзРегистра()

// Процедура заполнения ветку группы дерева модификаторов элементами
//
// Параметры:
//  Родитель - Произвольный - Родитель.
//  СтрокаМодификатор - Строка - Строка модификатор.
//
Процедура ЗаполнениеЭлементовГруппыМодификатора(Родитель, СтрокаМодификатор) Экспорт
	Если ТипЗнч(СтрокаМодификатор) = Тип("СтрокаДереваЗначений") Тогда
		СтрокиМодификаторов = СтрокаМодификатор.Строки;
	ИначеЕсли ТипЗнч(СтрокаМодификатор) = Тип("ДанныеФормыЭлементДерева") Тогда
		СтрокиМодификаторов = СтрокаМодификатор.ПолучитьЭлементы();
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Модификаторы.Модификатор КАК Модификатор,
	|	Модификаторы.Модификатор.ЕдиницаИзмеренияМодификатора КАК ЕдиницаИзмеренияМодификатора,
	|	Модификаторы.Модификатор.Цена КАК Цена,
	|	Модификаторы.Ссылка.МинимальноеКоличествоМодификаторов КАК МинимальноеКоличествоМодификаторов,
	|	Модификаторы.Ссылка.МаксимальноеКоличествоМодификаторов КАК МаксимальноеКоличествоМодификаторов,
	|	Модификаторы.Модификатор.ДопНоменклатура КАК ДопНоменклатура,
	|	Модификаторы.Модификатор.КоличествоНоменклатуры КАК КоличествоНоменклатуры
	|ИЗ
	|	Справочник.питГруппыМодификаторов.Модификаторы КАК Модификаторы
	|ГДЕ
	|	Модификаторы.Ссылка = &Родитель");
	
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВеткаГруппы = СтрокиМодификаторов.Добавить();
		
		ВеткаГруппы.Модификатор = Выборка.Модификатор;
		ВеткаГруппы.ГруппаМодификатора = Родитель;
		ВеткаГруппы.ЕдиницаИзмеренияМодификатора = Выборка.ЕдиницаИзмеренияМодификатора;
		ВеткаГруппы.Цена = Выборка.Цена;
		ВеткаГруппы.МинимальноеКоличествоМодификаторов = Выборка.МинимальноеКоличествоМодификаторов;
		ВеткаГруппы.МаксимальноеКоличествоМодификаторов = Выборка.МаксимальноеКоличествоМодификаторов;
		ВеткаГруппы.Номенклатура = Выборка.ДопНоменклатура;
		ВеткаГруппы.КоличествоНоменклатуры = Выборка.КоличествоНоменклатуры;
	КонецЦикла;
КонецПроцедуры // ЗаполнениеЭлементовГруппыМодификатора()

