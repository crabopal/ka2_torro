
#Область ПрограммныйИнтерфейс

//  Процедура - Добавление модификатора завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ДобавлениеМодификатора_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") 
		И Результат.Свойство("СтруктураДополнительныеПараметры") 
		И Результат.СтруктураДополнительныеПараметры.Свойство("ИсточникВыбора") Тогда
		ОбработкаВыбора(Результат, Результат.СтруктураДополнительныеПараметры.ИсточникВыбора);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") 
		И ВыбранноеЗначение.Свойство("СтруктураДополнительныеПараметры") Тогда
		
		// Обработка результата.
		ДополнительныеПараметры = ВыбранноеЗначение.СтруктураДополнительныеПараметры;
		Результат = ВыбранноеЗначение;
		
		ТекСтрокаМодификаторов = ДополнительныеПараметры.ТекСтрокаМодификаторов;
		СтруктураМодификатораРезультат = Результат;
		Если ТипЗнч(СтруктураМодификатораРезультат) = Тип("Структура") Тогда
			
			Если СтруктураМодификатораРезультат.Свойство("МассивРезультат") Тогда
				
				СтруктураМодификатораМассив = СтруктураМодификатораРезультат.МассивРезультат;
				
				Для каждого СтруктураМодификатора Из СтруктураМодификатораМассив Цикл
					Если ТипЗнч(СтруктураМодификатора) = Тип("Структура") Тогда
						
						ТекДанные = Элементы.ТаблицаНоменклатура.ТекущиеДанные;
						Если ТекДанные = Неопределено Тогда 
							Возврат; 
						КонецЕсли;
						
						РезультатМодификатор = СтруктураМодификатора.Модификатор;
						РезультатГруппаМодификатора = СтруктураМодификатора.ГруппаМодификатора;
						ТекНоменклатура = ТекДанные.Ссылка;
						Если ПроверитьВозможностьДобавленияМодификатора(ТекНоменклатура, РезультатМодификатор, РезультатГруппаМодификатора) Тогда
							
							Если ТекСтрокаМодификаторов = Неопределено Тогда
								// Добавим в ТЧ
								СтрокаМодификатор = Модификаторы.ПолучитьЭлементы().Добавить();
							Иначе
								СтрокаМодификатор = ТекСтрокаМодификаторов;
							КонецЕсли;
							
							Если НЕ РезультатМодификатор.Пустая() Тогда
								СтруктураРеквизитов = Новый Структура("ЕдиницаИзмеренияМодификатора, Цена, ДопНоменклатура, КоличествоНоменклатуры, Ссылка");
								СтруктураРеквизитов = ОбщегоНазначенияУТВызовСервера.ЗначенияРеквизитовОбъекта(РезультатМодификатор,СтруктураРеквизитов);
							Иначе
								СтруктураРеквизитов = Новый Структура("МинимальноеКоличествоМодификаторов, МаксимальноеКоличествоМодификаторов, Ссылка");
								СтруктураРеквизитов = ОбщегоНазначенияУТВызовСервера.ЗначенияРеквизитовОбъекта(РезультатГруппаМодификатора,СтруктураРеквизитов);
							КонецЕсли;
							
							СтрокаМодификатор.Модификатор = РезультатМодификатор;
							СтрокаМодификатор.ГруппаМодификатора = РезультатГруппаМодификатора;
							СтруктураРеквизитов.Свойство("ЕдиницаИзмеренияМодификатора",СтрокаМодификатор.ЕдиницаИзмеренияМодификатора);
							СтруктураРеквизитов.Свойство("Цена",СтрокаМодификатор.Цена);
							СтруктураРеквизитов.Свойство("МинимальноеКоличествоМодификаторов",СтрокаМодификатор.МинимальноеКоличествоМодификаторов);
							СтруктураРеквизитов.Свойство("МаксимальноеКоличествоМодификаторов",СтрокаМодификатор.МаксимальноеКоличествоМодификаторов);
							СтруктураРеквизитов.Свойство("ДопНоменклатура",СтрокаМодификатор.Номенклатура);
							СтруктураРеквизитов.Свойство("КоличествоНоменклатуры",СтрокаМодификатор.КоличествоНоменклатуры);
							
							// Запишем в регистр
							ЗаписатьМодификаторВРегистр(ТекНоменклатура, РезультатМодификатор, РезультатГруппаМодификатора);
							
							Если РезультатМодификатор.Пустая() И НЕ РезультатГруппаМодификатора.Пустая() Тогда
								ЗаполнениеЭлементовГруппыМодификатора(РезультатГруппаМодификатора, СтрокаМодификатор.ПолучитьИдентификатор());
							КонецЕсли;
						Иначе
							Если ПредыдущийМодификатор <> РезультатМодификатор И (ПредыдущаяГруппаМодификатора <> РезультатГруппаМодификатора ИЛИ РезультатГруппаМодификатора.Пустая() И ПредыдущаяГруппаМодификатора.Пустая()) Тогда
								Если ЗначениеЗаполнено(РезультатМодификатор) Тогда
									Сообщение = Новый СообщениеПользователю;
									Сообщение.Текст = "Модификатор """ + РезультатМодификатор + """ уже выбран для номенклатуры """ + ТекНоменклатура + """";
									Сообщение.Сообщить();
								Иначе
									Сообщение = Новый СообщениеПользователю;
									Сообщение.Текст = "Недопустимы строки с не заполненными модификаторами";
									Сообщение.Сообщить();
								КонецЕсли;
								
								//// Удалим запись измененного модификатора
								// УдалениеМодификатораИзРегистра(ТекНоменклатура, ПредыдущийМодификатор, ПредыдущаяГруппаМодификатора);
								// ПредыдущийМодификатор = Неопределено;
								// ПредыдущаяГруппаМодификатора = Неопределено
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.ТаблицаНоменклатураТолькоГруппы.Пометка = Истина;
	ТолькоГруппы(Неопределено);
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	текНоменклатура = Неопределено;
	
	Если Параметры.Свойство("Номенклатура", текНоменклатура) Тогда
		Элементы.ТаблицаНоменклатура.ТекущаяСтрока = текНоменклатура;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

//  Процедура - Модификаторы выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанныеМодификатор = Элементы.Модификаторы.ТекущиеДанные;
	текЭлемент = Элементы.Модификаторы.ТекущийЭлемент;
	Если ТекДанныеМодификатор = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если текЭлемент.Имя = "МодификаторыГруппаМодификаторов" Тогда
		Если ЗначениеЗаполнено(ТекДанныеМодификатор.Модификатор) Тогда
			Попытка
				ПоказатьЗначение(,ТекДанныеМодификатор.Модификатор);
			Исключение
			КонецПопытки;
		ИначеЕсли ЗначениеЗаполнено(ТекДанныеМодификатор.ГруппаМодификатора) Тогда
			Попытка
				ПоказатьЗначение(,ТекДанныеМодификатор.ГруппаМодификатора);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ ТАБЛИЧНЫХ ПОЛЕЙ

//  Процедура - Таблица номенклатура при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаНоменклатураПриАктивизацииСтроки(Элемент)
	ПодключитьОбработчикОжидания("Подключаемый_ТаблицаНоменклатураПриАктивизацииСтроки", 0.2, Истина);
КонецПроцедуры


//  Процедура - Модификаторы перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//
&НаКлиенте
Процедура МодификаторыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
	
	ТекДанные = Элементы.ТаблицаНоменклатура.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ДобавлениеМодификатора(ТекДанные.Ссылка);
КонецПроцедуры

//  Процедура - Модификаторы при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура МодификаторыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТекДанныеНоменклатура = Элементы.ТаблицаНоменклатура.ТекущиеДанные;
	Если ТекДанныеНоменклатура = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ТекДанныеМодификатор = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекДанныеМодификатор = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Если ТекДанныеМодификатор.ПолучитьРодителя() <> Неопределено Тогда
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПроверитьВозможностьДобавленияМодификатора(ТекДанныеНоменклатура.Ссылка, ТекДанныеМодификатор.Модификатор, ТекДанныеМодификатор.ГруппаМодификатора) Тогда
		
		// Проверим, можно ли использовать номенклатуру.
		
		// Запишем в регистр
		ЗаписатьМодификаторВРегистр(ТекДанныеНоменклатура.Ссылка, ТекДанныеМодификатор.Модификатор, ТекДанныеМодификатор.ГруппаМодификатора);
	Иначе
		Если НЕ ПредыдущийМодификатор.Пустая() И ПредыдущийМодификатор <> ТекДанныеМодификатор.Модификатор И НЕ ПредыдущаяГруппаМодификатора.Пустая() И ПредыдущаяГруппаМодификатора <> ТекДанныеМодификатор.ГруппаМодификатора Тогда
			Если ЗначениеЗаполнено(ТекДанныеМодификатор.Модификатор) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Модификатор """ + ТекДанныеМодификатор.Модификатор + """ уже выбран для номенклатуры """ + ТекДанныеНоменклатура.Ссылка + """";
				Сообщение.Сообщить();
			Иначе
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Недопустимы строки с не заполненными модификаторами";
				Сообщение.Сообщить();
			КонецЕсли;
			
			//// Удалим запись измененного модификатора
			// УдалениеМодификатораИзРегистра(ТекДанныеНоменклатура.Ссылка, ПредыдущийМодификатор, ПредыдущаяГруппаМодификатора);
			// ПредыдущийМодификатор = Неопределено;
			// ПредыдущаяГруппаМодификатора = Неопределено;
			//
			//// Удалим строку с повторяющимся модификатором
			// Модификаторы.Строки.Удалить(ТекДанныеМодификатор);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Модификаторы перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура МодификаторыПередУдалением(Элемент, Отказ)
	ТекДанныеНоменклатура = Элементы.ТаблицаНоменклатура.ТекущиеДанные;
	Если ТекДанныеНоменклатура = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ТекДанныеМодификатор = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекДанныеМодификатор = Неопределено Тогда
		Возврат; 
	КонецЕсли;
	
	Если ТекДанныеМодификатор.ПолучитьРодителя() <> Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Удалим из регистра
	УдалениеМодификатораИзРегистра(ТекДанныеНоменклатура.Ссылка, ТекДанныеМодификатор.Модификатор, ТекДанныеМодификатор.ГруппаМодификатора);
КонецПроцедуры

//  Процедура - Модификаторы перед началом изменения.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура МодификаторыПередНачаломИзменения(Элемент, Отказ)
	ПредыдущийМодификатор = Элементы.Модификаторы.ТекущиеДанные.Модификатор;
	ПредыдущаяГруппаМодификатора = Элементы.Модификаторы.ТекущиеДанные.ГруппаМодификатора;
КонецПроцедуры

//  Процедура - Унаследованные модификаторы выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура УнаследованныеМодификаторыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.ОтКогоУнаследовали) Тогда
		// Переходим на эту группу номенклатуры
		Элементы.ТаблицаНоменклатура.ТекущаяСтрока = ТекДанные.ОтКогоУнаследовали;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Модификаторы модификатор начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыМодификаторНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекДанныеНоменклатура = Элементы.ТаблицаНоменклатура.ТекущиеДанные;
	Если ТекДанныеНоменклатура = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ТекДанныеМодификатор = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекДанныеМодификатор = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Если ТекДанныеМодификатор.ПолучитьРодителя() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавлениеМодификатора(ТекДанныеНоменклатура.Ссылка, ТекДанныеМодификатор.Модификатор, ТекДанныеМодификатор, 0);
КонецПроцедуры

#КонецОбласти


