////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНДНЫХ ПАНЕЛЕЙ ФОРМЫ

//  Процедура - Только группы.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТолькоГруппы(Команда)
	Элементы.ТаблицаНоменклатураТолькоГруппы.Пометка = НЕ Элементы.ТаблицаНоменклатураТолькоГруппы.Пометка;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ТаблицаНоменклатура.Отбор,"ЭтоГруппа",Истина,,,Элементы.ТаблицаНоменклатураТолькоГруппы.Пометка,);
КонецПроцедуры

//  Процедура - Добавить группу модификаторов.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ДобавитьГруппуМодификаторов(Команда)
	ТекДанные = Элементы.ТаблицаНоменклатура.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат; 
	КонецЕсли;
	
	ДобавлениеМодификатора(ТекДанные.Ссылка,,,1);
КонецПроцедуры

//  Процедура - Изменить модификатор.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ИзменитьМодификатор(Команда)
	ТекДанныеМодификатор = Элементы.Модификаторы.ТекущиеДанные;
	текЭлемент = Элементы.Модификаторы.ТекущийЭлемент;
	Если ТекДанныеМодификатор = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если текЭлемент.Имя = "МодификаторыГруппаМодификаторов" Тогда
		Если ЗначениеЗаполнено(ТекДанныеМодификатор.Модификатор) Тогда
			Попытка
				ПоказатьЗначение(,ТекДанныеМодификатор.Модификатор);
			Исключение
			КонецПопытки;
		ИначеЕсли ЗначениеЗаполнено(ТекДанныеМодификатор.ГруппаМодификатора) Тогда
			Попытка
				ПоказатьЗначение(,ТекДанныеМодификатор.ГруппаМодификатора);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Подбор.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подбор(Команда)
	ТекДанные = Элементы.ТаблицаНоменклатура.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	ДобавлениеМодификатора(ТекДанные.Ссылка,,,,Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Модуль формы обработки

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

//  Процедура - Добавление модификатора.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  Модификатор - Произвольный - Модификатор.
//  ТекСтрокаМодификаторов - Строка - Тек строка модификаторов.
//  ВидПодбора - Число - Вид подбора.
//  ЭтоПодбор - Произвольный - Это подбор.
//
&НаКлиенте
Процедура ДобавлениеМодификатора(Номенклатура, Модификатор = Неопределено, ТекСтрокаМодификаторов = Неопределено, ВидПодбора = 0, ЭтоПодбор = Ложь)
	
	ПараметрыФормы = Новый Структура("Номенклатура, Модификатор, ПредыдущийМодификатор, ПредыдущаяГруппаМодификатора, ВидПодбора, ЗакрыватьПриВыборе,ТекСтрокаМодификаторов");
	ПараметрыФормы.Номенклатура = Номенклатура;
	ПараметрыФормы.Модификатор = Модификатор;
	ПараметрыФормы.ПредыдущийМодификатор = ПредыдущийМодификатор;
	ПараметрыФормы.ПредыдущаяГруппаМодификатора = ПредыдущаяГруппаМодификатора;
	ПараметрыФормы.ВидПодбора = ВидПодбора;
	ПараметрыФормы.ЗакрыватьПриВыборе = НЕ ЭтоПодбор;
	ПараметрыФормы.ТекСтрокаМодификаторов = ТекСтрокаМодификаторов;
	
	СтруктураМодификатора = Неопределено;
	
	ОткрытьФорму("Обработка.питМодификаторыНоменклатуры.Форма.ФормаВыбораМодификатора", ПараметрыФормы,ЭтотОбъект,,,, Новый ОписаниеОповещения("ДобавлениеМодификатора_Завершение", ЭтотОбъект, Новый Структура("ТекСтрокаМодификаторов", ТекСтрокаМодификаторов)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

// Процедура заполнения ТЧ Модификаторы по Номенклатуре
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//
&НаСервере
Процедура ЗаполнитьМодификаторы(Номенклатура)
	МодификаторыНоменклатуры = РеквизитФормыВЗначение("Модификаторы",Тип("ДеревоЗначений"));
	Обработки.питМодификаторыНоменклатуры.ЗаполнитьМодификаторы(Номенклатура, МодификаторыНоменклатуры);
	ЗначениеВРеквизитФормы(МодификаторыНоменклатуры,"Модификаторы");
КонецПроцедуры // ЗаполнитьМодификаторы()

//  Процедура - Заполнить унаследованные модификаторы.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//
&НаСервере
Процедура ЗаполнитьУнаследованныеМодификаторы(Номенклатура)
	Обработки.питМодификаторыНоменклатуры.ЗаполнитьУнаследованныеМодификаторы(Номенклатура, УнаследованныеМодификаторы);
КонецПроцедуры

//  Функция - Проверить возможность добавления модификатора.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  Модификатор - Произвольный - Модификатор.
//  ГруппаМодификатора - Произвольный - Группа модификатора.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПроверитьВозможностьДобавленияМодификатора(Номенклатура,Модификатор, ГруппаМодификатора)
	Возврат Обработки.питМодификаторыНоменклатуры.ПроверитьВозможностьДобавленияМодификатора(Номенклатура,Модификатор, ГруппаМодификатора)
КонецФункции

//  Процедура - Записать модификатор в регистр.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  Модификатор - Произвольный - Модификатор.
//  ГруппаМодификатора - Произвольный - Группа модификатора.
//
&НаСервере
Процедура ЗаписатьМодификаторВРегистр(Номенклатура, Модификатор, ГруппаМодификатора)
	Обработки.питМодификаторыНоменклатуры.ЗаписатьМодификаторВРегистр(Номенклатура, Модификатор, ГруппаМодификатора, ПредыдущийМодификатор, ПредыдущаяГруппаМодификатора);
КонецПроцедуры

//  Процедура - Заполнение элементов группы модификатора.
//
// Параметры:
//  Родитель - Произвольный - Родитель.
//  СтрокаМодификаторИдентификатор - Строка - Строка модификатор идентификатор.
//
&НаСервере
Процедура ЗаполнениеЭлементовГруппыМодификатора(Родитель, СтрокаМодификаторИдентификатор)
	СтрокаМодификатор = Модификаторы.НайтиПоИдентификатору(СтрокаМодификаторИдентификатор);
	Обработки.питМодификаторыНоменклатуры.ЗаполнениеЭлементовГруппыМодификатора(Родитель, СтрокаМодификатор);
КонецПроцедуры

