
#Область ПрограммныйИнтерфейс

//  Процедура - Добавить группу завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ДобавитьГруппуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ПриСозданииНаСервере(Ложь,Истина);
	
КонецПроцедуры

//  Процедура - Модификаторы перед началом добавления завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура МодификаторыПередНачаломДобавленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ДобавленМодификатор = Результат;
	
	ПриСозданииНаСервере(Ложь, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ


//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	Если Параметры.Свойство("ВидПодбора") Тогда
	
		ВидПодбора = Параметры.ВидПодбора;
	КонецЕсли;
	Если Параметры.Свойство("Модификатор") Тогда
		Модификатор = Параметры.Модификатор;
	КонецЕсли;
	Если Параметры.Свойство("ПредыдущийМодификатор") Тогда
		ПредыдущийМодификатор = Параметры.ПредыдущийМодификатор;
	КонецЕсли;
	Если Параметры.Свойство("ПредыдущаяГруппаМодификатора") Тогда
		ПредыдущаяГруппаМодификатора = Параметры.ПредыдущаяГруппаМодификатора;
	КонецЕсли;
	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура = Параметры.Номенклатура;
	КонецЕсли;
	Если Параметры.Свойство("ТекСтрокаМодификаторов") Тогда
		ТекСтрокаМодификаторов = Параметры.ТекСтрокаМодификаторов;
	КонецЕсли;
	
	СтрокиМодификаторов = Модификаторы.ПолучитьЭлементы();
	СтрокиМодификаторов.Очистить();
	
	ВыводитьБизнесЛанч = Истина;
	
	Если ВидПодбора = 1 Тогда
		Элементы.МодификаторыНоменклатура.Видимость = Ложь;
	КонецЕсли;
	
	Если ВидПодбора = 0 Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЕстьNULL(МодификаторыГруппа.Ссылка,ЗНАЧЕНИЕ(Справочник.питГруппыМодификаторов.ПустаяСсылка)) КАК ГруппаМодификатора,
		|	МодификаторыЭлементы.Ссылка КАК ЭлементМодификатора,
		|	МодификаторыЭлементы.ДопНоменклатура КАК НоменклатураЭлемента,
		|	МодификаторыЭлементы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.питМодификаторы КАК МодификаторыЭлементы 
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питГруппыМодификаторов.Модификаторы КАК МодификаторыГруппа
		|		ПО МодификаторыЭлементы.Ссылка = МодификаторыГруппа.Модификатор
		|			";
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	(НЕ МодификаторыЭлементы.ЭтоГруппа)";
		ТекстЗапроса = ТекстЗапроса + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГруппаМодификатора,
		|	ЭлементМодификатора";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			// Найдем группу модификатора, если такой ещё нет, то создадим
			СтрокаРодитель = НайтиСтрокуКоллекции(СтрокиМодификаторов, "Наименование", Выборка.ГруппаМодификатора, Ложь);
			
			Если СтрокаРодитель = Неопределено Тогда
				СтрокаРодитель = СтрокиМодификаторов.Добавить();
				СтрокаРодитель.Наименование = Выборка.ГруппаМодификатора;
			КонецЕсли;
			
			Если Выборка.ЭлементМодификатора <> Null Тогда
				// Добавляем элементы в группу
				СтрокиРодителя = СтрокаРодитель.ПолучитьЭлементы();
				// СтрокиРодителя = СтрокаРодитель.Строки;
				СтрокаЭлемент =СтрокиРодителя.Добавить();
				СтрокаЭлемент.Наименование = Выборка.ЭлементМодификатора;
				СтрокаЭлемент.Номенклатура = Выборка.НоменклатураЭлемента;
				СтрокаЭлемент.ПометкаУдаления = Выборка.ПометкаУдаления;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ Модификатор.Пустая() Тогда
			ТекущаяСтрока = НайтиСтрокуКоллекции(СтрокиМодификаторов, "Наименование", Модификатор, Истина);
			Если ТекущаяСтрока <> Неопределено Тогда
				Элементы.Модификаторы.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ВидПодбора = 1 Тогда
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	МодификаторыГруппы.Ссылка КАК Ссылка,
			|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
			|	МодификаторыГруппы.ПометкаУдаления
			|ИЗ
			|	Справочник.питГруппыМодификаторов КАК МодификаторыГруппы";
		Иначе
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	МодификаторыЭлементы.Ссылка КАК Ссылка,
			|	МодификаторыЭлементы.ДопНоменклатура КАК Номенклатура,
			|	МодификаторыЭлементы.ПометкаУдаления
			|ИЗ
			|	Справочник.питМодификаторы КАК МодификаторыЭлементы
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питГруппыМодификаторов.Модификаторы КАК МодификаторыГруппа
			|		ПО МодификаторыЭлементы.Ссылка = МодификаторыГруппа.Модификатор
			|ГДЕ";
			ТекстЗапроса = ТекстЗапроса + "
			|	(НЕ МодификаторыЭлементы.ЭтоГруппа)";
		КонецЕсли;
		
		Запрос = Новый Запрос(ТекстЗапроса);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтрокаМодификатор = СтрокиМодификаторов.Добавить();
			СтрокаМодификатор.Наименование = Выборка.Ссылка;
			СтрокаМодификатор.ПометкаУдаления = Выборка.ПометкаУдаления;
			Если ВидПодбора = 2 Тогда
				СтрокаМодификатор.Номенклатура = Выборка.Номенклатура;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Элементы.Модификаторы.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ЗаписьМодификатора" Тогда
		ТекМодификатор = Неопределено;
		ТекДанные = Элементы.Модификаторы.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			ТекМодификатор = ТекДанные.Наименование;
		КонецЕсли;
		// Далее обновить текущую форму.
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

//  Процедура - Модификаторы перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//
&НаКлиенте
Процедура МодификаторыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
	ТекДанные = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРодитель = ТекДанные.ПолучитьРодителя();
	Если СтрокаРодитель = Неопределено Тогда
		ТекРодитель = ТекДанные.Наименование;
	Иначе
		ТекРодитель = СтрокаРодитель.Наименование;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ГруппаМодификатора", ТекРодитель);
	
	ДобавленМодификатор = Неопределено;
	
	
	ОткрытьФорму("Справочник.питМодификаторы.ФормаОбъекта", ПараметрыФормы,,,,, Новый ОписаниеОповещения("МодификаторыПередНачаломДобавленияЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

//  Процедура - Модификаторы перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура МодификаторыПередУдалением(Элемент, Отказ)
	ТекДанные = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекДанные.Наименование) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	УстановитьПометкуУдаления(ТекДанные.Наименование);
	
	ТекМодификатор = Неопределено;
	ТекДанные = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекМодификатор = ТекДанные.Наименование;
	КонецЕсли;
	
	ПриСозданииНаСервере(Ложь,Истина);
	
	ЭлтыДерева=Модификаторы.ПолучитьЭлементы();
	
	Для Каждого Строка Из ЭлтыДерева Цикл
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.Модификаторы.Развернуть(ИдентификаторСтроки);
	КонецЦикла;
	
	
КонецПроцедуры

//  Процедура - Модификаторы выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Выбрать(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНДНЫХ ПАНЕЛЕЙ ФОРМЫ

//  Процедура - Выбрать.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Выбрать(Команда)
	
	РезультатЗакрыть = Новый Структура("МассивРезультат, СтруктураДополнительныеПараметры", Новый Массив, Новый Структура("ТекСтрокаМодификаторов,ИсточникВыбора",ТекСтрокаМодификаторов,ЭтотОбъект));
	
	ВыделенныеСтроки = Элементы.Модификаторы.ВыделенныеСтроки;
	Для каждого ТекВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		ТекДанные = Модификаторы.НайтиПоИдентификатору(ТекВыделеннаяСтрока);
		Если НЕ ТекДанные = Неопределено Тогда
			
			РодительСтроки = ТекДанные.ПолучитьРодителя();
			Если РодительСтроки = Неопределено Тогда
				РезультатМодификатор = ПредопределенноеЗначение("Справочник.питМодификаторы.ПустаяСсылка");
				РезультатГруппаМодификатора = ТекДанные.Наименование;
			Иначе
				РезультатМодификатор = ТекДанные.Наименование;
				РезультатГруппаМодификатора = РодительСтроки.Наименование;
			КонецЕсли;
			
			РезультатЗакрыть.МассивРезультат.Добавить(Новый Структура("Модификатор, ГруппаМодификатора",РезультатМодификатор,РезультатГруппаМодификатора));
			
		КонецЕсли;
	КонецЦикла;
	
	Если ЗакрыватьПриВыборе Тогда
		Закрыть(РезультатЗакрыть);
	Иначе
		ОповеститьОВыборе(РезультатЗакрыть);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Закрыть форму.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

//  Процедура - Добавить группу.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ДобавитьГруппу(Команда)
	ОткрытьФорму("Справочник.питГруппыМодификаторов.ФормаОбъекта",,,,,, Новый ОписаниеОповещения("ДобавитьГруппуЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Процедура - Установить пометку удаления.
//
// Параметры:
//  Модификатор - Произвольный - Модификатор.
//
&НаСервере
Процедура УстановитьПометкуУдаления(Модификатор)
	УдаляемыйЭлемент = Модификатор.ПолучитьОбъект();
	УдаляемыйЭлемент.УстановитьПометкуУдаления(НЕ УдаляемыйЭлемент.ПометкаУдаления);
	УдаляемыйЭлемент.Записать();
КонецПроцедуры

// Получает идентификатор (метод ПолучитьИдентификатор()) строки дерева значений
//  для заданного значения поля строки дерева.
//  Используется для позиционирования курсора в иерархических списках.
//
// Параметры:
//  КоллекцияЭлементовДерева - Произвольный - Коллекция элементов дерева.
//  ИмяПоля - Произвольный - Имя поля.
//  КлючСтроки - Произвольный - Ключ строки.
//  ВключатьПодчиненные - Произвольный - Включать подчиненные.
//  НайденнаяСтрока - Строка - Найденная строка.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервере
Функция НайтиСтрокуКоллекции(КоллекцияЭлементовДерева, ИмяПоля, КлючСтроки, ВключатьПодчиненные, НайденнаяСтрока = Неопределено)
	
	Для Каждого СтрокаДерева Из КоллекцияЭлементовДерева Цикл
		Если СтрокаДерева[ИмяПоля] = КлючСтроки Тогда
		
			НайденнаяСтрока =  СтрокаДерева;
			
		КонецЕсли;
		
		Если НайденнаяСтрока <> Неопределено Тогда
			Возврат НайденнаяСтрока
		КонецЕсли;
		
		Если ВключатьПодчиненные Тогда
			КоллекцияЭлементов = СтрокаДерева.ПолучитьЭлементы();
			НайденнаяСтрока = НайтиСтрокуКоллекции(КоллекцияЭлементов, ИмяПоля, КлючСтроки, ВключатьПодчиненные, НайденнаяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

// &НаСервере
// Процедура ЗаписатьМодификаторВРегистр(Номенклатура, Модификатор, ГруппаМодификатора)
//	Обработки.питМодификаторыНоменклатуры.ЗаписатьМодификаторВРегистр(Номенклатура, Модификатор, ГруппаМодификатора, ПредыдущийМодификатор, ПредыдущаяГруппаМодификатора);
// КонецПроцедуры

//&НаСервере
//Процедура ЗаполнениеЭлементовГруппыМодификатора(Родитель, СтрокаМодификатор)
//	Обработки.питМодификаторыНоменклатуры.ЗаполнениеЭлементовГруппыМодификатора(Родитель, СтрокаМодификатор);
//КонецПроцедуры

