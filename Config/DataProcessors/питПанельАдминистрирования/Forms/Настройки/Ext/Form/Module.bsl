КонецПроцедуры

&НаКлиенте
Процедура питПрефиксШтрихКодаПриИзменении(Элемент)
	Подключаемый_ПриИзмененииРеквизита(Элемент, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура питСпособРасчетаКалорийностиПриИзменении(Элемент)
	
	Если НЕ Элемент = Неопределено Тогда
		Подключаемый_ПриИзмененииРеквизита(Элемент, Ложь);
	КонецЕсли;
	
	Если НаборКонстант.питСпособРасчетаКалорийности = ПредопределенноеЗначение("Перечисление.питСпособыРасчетаКалорийности.ПоФормуле") Тогда
		Элементы.питФормулаРасчетаКалорийности.Доступность = Истина;
		Если ПустаяСтрока(НаборКонстант.питФормулаРасчетаКалорийности) Тогда
			НаборКонстант.питФормулаРасчетаКалорийности = "4 * [Белки] + 9 * [Жиры] + 4 * [Углеводы] + 7 * [Алкоголь]";
			питФормулаРасчетаКалорийностиПриИзменении(Элементы.питСпособРасчетаКалорийности);
		КонецЕсли;
	Иначе
		Элементы.питФормулаРасчетаКалорийности.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура питСпособРасчетаКоличестваХЭХПриИзменении(Элемент)
	Подключаемый_ПриИзмененииРеквизита(Элемент, Ложь);
КонецПроцедуры

