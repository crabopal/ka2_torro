
#Область ОписаниеПеременных
&НаКлиенте
Перем ОбновитьИнтерфейс;

#КонецОбласти

#Область ПрограммныйИнтерфейс
 #Область ХАССП

// Процедура - Пит ХАССПВыбор цвета завершение
//
// Параметры:
//  Результат				 - Произвольный	 - Результат.
//  ДополнительныеПараметры	 - Произвольный	 - Дополнительные параметры.
//
&НаКлиенте
Процедура питХАССПВыборЦветаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = Результат.Результат;
	НаборКонстант[ДополнительныеПараметры.ИмяЭлемента] = питОбщегоНазначенияКлиентСервер.RGB_HEX(Результат.Красный, Результат.Зеленый, Результат.Синий);
	Элементы[ДополнительныеПараметры.ИмяЭлемента + "ПримерЦвета"].ЦветФона = Новый Цвет(Результат.Красный, Результат.Зеленый, Результат.Синий);
	Подключаемый_ПриИзмененииРеквизита(Элементы[ДополнительныеПараметры.ИмяЭлемента], Ложь);
КонецПроцедуры

#КонецОбласти

// Процедура - Воброс изменения формулы расчета калорийности завершение
//
// Параметры:
//  РезультатВопроса		 - Произвольный	 - Результат.
//  ДополнительныеПараметры	 - Произвольный	 - Дополнительные параметры.
//
&НаКлиенте
Процедура ВобросИзмененияФормулыРасчетаКалорийностиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекФормула = ДополнительныеПараметры.ТекФормула;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		НаборКонстант.питФормулаРасчетаКалорийности = ТекФормула;
		питФормулаРасчетаКалорийностиПриИзменении(ДополнительныеПараметры.Элемент);
	КонецЕсли;

КонецПроцедуры


#КонецОбласти




#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Если Параметры.Свойство("АвтоТест") Тогда
	
		Возврат;
	КонецЕсли;
	
	//+питКА
	Элементы.питФормироватьСпецификацииПоРецептурам.Видимость = НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "КомплекснаяАвтоматизация";
	Элементы.питФормироватьРазрешенияНаЗаменуПоРегистрациямЗамен.Видимость = НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "КомплекснаяАвтоматизация";
	//-питКА
	
	// Значения реквизитов формы
	СоставНабораКонстантФормы    = ОбщегоНазначенияУТ.ПолучитьСтруктуруНабораКонстант(НаборКонстант);
	ВнешниеРодительскиеКонстанты = НастройкиСистемыПовтИсп.ПолучитьСтруктуруРодительскихКонстант(СоставНабораКонстантФормы);
	
	ИнфоПодсистемы = питОбщегоНазначения.ПолучитьИнформациюОПодсистеме("ОбщепитERP");
	Элементы.ДекорацияРелиз.Заголовок = "1С:Общепит. Модуль для 1С:ERP и 1С:КА2, версия <" 
		+ ИнфоПодсистемы.Версия 
		+ "> от " + Формат(ИнфоПодсистемы.ДатаРелиза, "ДФ=dd.MM.yyyy") + "";
	
	питХАССПОбновитьПримерыЦветов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	питСпособРасчетаКалорийностиПриИзменении(Неопределено);
	питНеИзменятьРежимСписанияВПроизводствоПоНастройкеПриИзменении(Неопределено);
	питФормироватьОприходованиеИзлишковПоВыпускуБлюдПриИзменении(Неопределено);  
	питВЖурналеАлкоПродукцииИспользоватьТолькоАктыПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ОбновитьИнтерфейсПрограммы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ХАССП

&НаКлиенте
Процедура питХАССПЦветПриИзменении(Элемент)
	Если НЕ Элемент = Неопределено Тогда
		RGB = питОбщегоНазначенияКлиентСервер.HEX_RGB(НаборКонстант[Элемент.Имя]);
		HEX = питОбщегоНазначенияКлиентСервер.RGB_HEX(RGB.Красный, RGB.Зеленый, RGB.Синий);
		НаборКонстант[Элемент.Имя] = HEX;
		Элементы[Элемент.Имя + "ПримерЦвета"].ЦветФона = Новый Цвет(RGB.Красный, RGB.Зеленый, RGB.Синий);
		Подключаемый_ПриИзмененииРеквизита(Элемент, Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура питХАССПЦветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	RGB = питОбщегоНазначенияКлиентСервер.HEX_RGB(НаборКонстант[Элемент.Имя]);
	питОбщегоНазначенияКлиент.ОткрытьВыборЦвета(Новый Цвет(RGB.Красный, RGB.Зеленый, RGB.Синий), 
		Новый ОписаниеОповещения("питХАССПВыборЦветаЗавершение", ЭтотОбъект, Новый Структура("ИмяЭлемента", Элемент.Имя)));
КонецПроцедуры

