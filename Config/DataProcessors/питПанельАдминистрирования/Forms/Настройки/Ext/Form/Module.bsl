&НаСервере
Процедура питХАССПОбновитьПримерыЦветов()
	ИменаКонстантЦветов = Новый Массив;
	ИменаКонстантЦветов.Добавить("питХАССПЦветУзлаОперации");
	ИменаКонстантЦветов.Добавить("питХАССПЦветРамкиУзлаОперации");
	ИменаКонстантЦветов.Добавить("питХАССПЦветВыделенногоУзлаОперации");
	ИменаКонстантЦветов.Добавить("питХАССПЦветРамкиВыделенногоУзлаОперации");
	ИменаКонстантЦветов.Добавить("питХАССПЦветУзлаНоменклатуры");
	ИменаКонстантЦветов.Добавить("питХАССПЦветРамкиУзлаНоменклатуры");
	ИменаКонстантЦветов.Добавить("питХАССПЦветВыделенногоУзлаНоменклатуры");
	ИменаКонстантЦветов.Добавить("питХАССПЦветРамкиВыделенногоУзлаНоменклатуры");
	ИменаКонстантЦветов.Добавить("питХАССПЦветСвязи");
	ИменаКонстантЦветов.Добавить("питХАССПЦветВыделеннойСвязи");
	ИменаКонстантЦветов.Добавить("питХАССПЦветТекста");
	Для каждого ИмяКонстантыЦветов Из ИменаКонстантЦветов Цикл
		Если Элементы.Найти(ИмяКонстантыЦветов + "ПримерЦвета") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		RGB = питОбщегоНазначенияКлиентСервер.HEX_RGB(НаборКонстант[ИмяКонстантыЦветов]);
		Элементы[ИмяКонстантыЦветов + "ПримерЦвета"].ЦветФона = Новый Цвет(RGB.Красный, RGB.Зеленый, RGB.Синий);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

