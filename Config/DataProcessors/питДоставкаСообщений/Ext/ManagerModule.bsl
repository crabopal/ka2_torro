#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПодключениеКРарусЭвотор

// Функция - Начать выполнение команды
//
// Параметры:
//  ИмяКоманды - Строка - Имя команды.
//  Параметры - Структура - С входными параметрами.
//
// Возвращаемое значение:
//  Структура - Итоговая структура.
Функция НачатьВыполнениеКоманды(ИмяКоманды, Параметры) Экспорт
	
	ВыходныеПараметры = Новый Структура;
	ВыходныеПараметры.Вставить("КодОшибки");
	ВыходныеПараметры.Вставить("ТекстСообщения","");
	ВыходныеПараметры.Вставить("Результат", Истина);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыходныеПараметры",ВыходныеПараметры);
	
	// Проверим знает ли драйвер такую команду.
	Если НЕ ПроверитьКорректностьКоманды(ИмяКоманды, ДополнительныеПараметры) Тогда
		Возврат ДополнительныеПараметры;
	КонецЕсли;

	// Сформируем параметры запроса.
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса = ЗаполнитьПараметрыЗапроса(ИмяКоманды, Параметры);
	
	// При необходимости заполним дополнительные параметры.
	ВходныеПараметры = Новый Структура;
	
	// Дополним общую структура параметров с данными для передачи и обработки.
	ДополнительныеПараметры.Вставить("ИмяКоманды",ИмяКоманды);
	ДополнительныеПараметры.Вставить("ПараметрыЗапроса",ПараметрыЗапроса);
	ДополнительныеПараметры.Вставить("ВходныеПараметры",ВходныеПараметры);
	
	// Приступим к выполнению обмена.
	Если ПараметрыЗапроса.МетодЗапроса = "GET" Тогда
		НачатьПринятиеДанных(ДополнительныеПараметры);
	ИначеЕсли ПараметрыЗапроса.МетодЗапроса = "POST" Тогда
		НачатьОтправкуДанных(ДополнительныеПараметры);
	ИначеЕсли ПараметрыЗапроса.МетодЗапроса = "DELETE" Тогда
		НачатьОтправкуДанных(ДополнительныеПараметры);
	ИначеЕсли ПараметрыЗапроса.МетодЗапроса = "PUT" Тогда
		НачатьЗаписьДанных(ДополнительныеПараметры);
	Иначе
		ДополнительныеПараметры.ВыходныеПараметры.Результат = Ложь;
		ДополнительныеПараметры.ВыходныеПараметры.КодОшибки = 999;
		ДополнительныеПараметры.ВыходныеПараметры.ТекстСообщения = НСтр("ru='Неизвестный метод '", "ru");
	КонецЕсли;
	
	Возврат ДополнительныеПараметры.ВыходныеПараметры;
	
КонецФункции

// Функция - Заполнить параметры запроса
//
// Параметры:
//  КомандаЗапроса - Строка - Имя команды.
//  Параметры - Структура - СтруктураДанных.
//
// Возвращаемое значение:
//  Структура - Параметры запроса.
Функция ЗаполнитьПараметрыЗапроса(КомандаЗапроса, Параметры) Экспорт
	
	ЗаголовкиЗапроса = Новый Соответствие();
	ПараметрыЗапроса = Новый Структура;
	
	Если КомандаЗапроса = "СинхронизацияСТерминалом" Тогда
		
		ФорматФайлаОбмена = "application/json";
		АдресЗапроса = "api/v1/synchronization";
		МетодЗапроса = "PUT";
		
		ЗаголовкиЗапроса.Вставить("pin",Параметры.ПинКод);
		ЗаголовкиЗапроса.Вставить("restart-id", Параметры.Префикс);
		ЗаголовкиЗапроса.Вставить("company", КодироватьСтроку(Параметры.НаименованиеОрганизации, СпособКодированияСтроки.URLВКодировкеURL));
		ЗаголовкиЗапроса.Вставить("node", КодироватьСтроку(Параметры.НаименованиеУзла, СпособКодированияСтроки.URLВКодировкеURL));
		
		
	ИначеЕсли КомандаЗапроса = "ОтправитьФайл" Тогда
		
		ФорматФайлаОбмена = "application/xml";
		АдресЗапроса = "/api/v1/file/" + Параметры.ИмяФайла;
		МетодЗапроса = "POST";
		
		ЗаголовкиЗапроса.Вставить("x-evotor-device-uuid",Параметры.КодТерминала);
		ЗаголовкиЗапроса.Вставить("token", Параметры.ТокенТерминала);
		ПараметрыЗапроса.Вставить("ТекстЗапроса",Параметры.ТекстЗапроса);
		
	ИначеЕсли КомандаЗапроса = "ПолучитьСписокДоступныхФайлов" Тогда
		
		ФорматФайлаОбмена = "application/json";
		АдресЗапроса = "/api/v1/filenames";
		МетодЗапроса = "GET";
		
		ЗаголовкиЗапроса.Вставить("x-evotor-device-uuid",Параметры.КодТерминала);
		ЗаголовкиЗапроса.Вставить("token", Параметры.ТокенТерминала);
		ЗаголовкиЗапроса.Вставить("mask", Параметры.ОжидаемоеИмяФайла);
		
	ИначеЕсли КомандаЗапроса = "ЗагрузитьФайл" Тогда
		
		ФорматФайлаОбмена = "application/xml";
		АдресЗапроса = "/api/v1/file/" + Параметры.ИмяФайла;
		МетодЗапроса = "GET";
		
		ЗаголовкиЗапроса.Вставить("x-evotor-device-uuid",Параметры.КодТерминала);
		ЗаголовкиЗапроса.Вставить("token", Параметры.ТокенТерминала);
		
	ИначеЕсли КомандаЗапроса = "УдалитьФайл" Тогда
		
		ФорматФайлаОбмена = "application/xml";
		АдресЗапроса = "/api/v1/file/" + Параметры.ИмяФайла;
		МетодЗапроса = "DELETE";
		
		ЗаголовкиЗапроса.Вставить("x-evotor-device-uuid",Параметры.КодТерминала);
		ЗаголовкиЗапроса.Вставить("token", Параметры.ТокенТерминала);
		
	Иначе
		
		ФорматФайлаОбмена = "application/json";
		АдресЗапроса = "";
		МетодЗапроса = "";
		
	КонецЕсли;
	
	ПараметрыДоставки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.НастройкаДоставкиПоУмолчанию, "АдресСервераHTTP, ПортHTTP, ПользовательHTTP, ПарольHTTP");
	
	ПараметрыЗапроса.Вставить("СерверЗапроса",    ПараметрыДоставки.АдресСервераHTTP);
	ПараметрыЗапроса.Вставить("Порт",    ПараметрыДоставки.ПортHTTP);
	ПараметрыЗапроса.Вставить("Пользователь",    ПараметрыДоставки.ПользовательHTTP);
	ПараметрыЗапроса.Вставить("Пароль",    ПараметрыДоставки.ПарольHTTP);
	
	ЗаголовкиЗапроса.Вставить("Content-Type", ФорматФайлаОбмена);
	
	ПараметрыЗапроса.Вставить("ЗаголовкиЗапроса", ЗаголовкиЗапроса);
	ПараметрыЗапроса.Вставить("АдресЗапроса",     АдресЗапроса);
	ПараметрыЗапроса.Вставить("МетодЗапроса",     МетодЗапроса);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

// Функция - Отправить запрос
//
// Параметры:
//  ДополнительныеПараметры - Структура - Общие параметры.
//  ТекстОтвета - Строка - Ответ от Эвотора.
//
// Возвращаемое значение:
//  Булево - Результат.
Функция ОтправитьЗапрос(ДополнительныеПараметры, ТекстОтвета = "") Экспорт
	
	ПараметрыЗапроса = ДополнительныеПараметры.ПараметрыЗапроса;
	Если ПараметрыЗапроса.Порт = 443 Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	Иначе
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(ПараметрыЗапроса.СерверЗапроса, ПараметрыЗапроса.Порт, ПараметрыЗапроса.Пользователь, ПараметрыЗапроса.Пароль,, 300, ЗащищенноеСоединение);
	Исключение
		ТекстСообщения = НСтр("ru = 'При создании соединения произошла ошибка'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		
		HTTPЗапрос = Новый HTTPЗапрос(ПараметрыЗапроса.АдресЗапроса, ПараметрыЗапроса.ЗаголовкиЗапроса);
		Если ПараметрыЗапроса.МетодЗапроса = "GET" Тогда
			Ответ = Соединение.Получить(HTTPЗапрос);
			ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
			ДополнительныеПараметры.ВыходныеПараметры.Результат = Истина;
		ИначеЕсли ПараметрыЗапроса.МетодЗапроса = "PUT" Тогда
			Ответ = Соединение.Записать(HTTPЗапрос);
			ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
			ДополнительныеПараметры.ВыходныеПараметры.Результат = Истина;
		ИначеЕсли ПараметрыЗапроса.МетодЗапроса = "POST" Тогда
			Если ЗначениеЗаполнено(ПараметрыЗапроса.ТекстЗапроса) Тогда
				HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыЗапроса.ТекстЗапроса);
			КонецЕсли;
			Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ИначеЕсли ПараметрыЗапроса.МетодЗапроса = "DELETE" Тогда
			Ответ = Соединение.Удалить(HTTPЗапрос);
			ДополнительныеПараметры.ВыходныеПараметры.Результат = Истина;
		КонецЕсли;
		
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось получить данные'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Если Ответ.КодСостояния = 401 Тогда
		ТекстСообщения = НСтр("ru = 'Ключ авторизации неверный.'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	ИначеЕсли Ответ.КодСостояния = 402 Тогда
		ТекстСообщения = НСтр("ru = 'Точка продаж, аккаунт или поддержка интеграции заблокирована.'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	ИначеЕсли Ответ.КодСостояния = 404 Тогда
		ТекстСообщения = НСтр("ru = 'Не найдена указанная точка продаж.'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	ИначеЕсли Ответ.КодСостояния = 405 Тогда
		ТекстСообщения = НСтр("ru = 'Терминал не активен в рамках текущей подписки.'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	ИначеЕсли Ответ.КодСостояния = 500 Тогда
		ТекстСообщения = НСтр("ru = 'Внутренняя ошибка сервиса.'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	ИначеЕсли Ответ.КодСостояния = 503 Тогда
		ТекстСообщения = НСтр("ru = 'Сервис недоступен.'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	ИначеЕсли Ответ.КодСостояния = 500 Тогда
		ТекстСообщения = НСтр("ru = 'Терминал не активен.'");
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	ИначеЕсли НЕ Ответ.КодСостояния = 200 Тогда
		ТекстСообщения = НСтр("ru = 'Произошла ошибка при выгрузке данных. Код ответа: %КодСостояния%.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КодСостояния%", Ответ.КодСостояния);
		СоздатьСообщениеОбОшибке(ДополнительныеПараметры, ТекстСообщения);
	КонецЕсли;
	
	Возврат ДополнительныеПараметры.ВыходныеПараметры.Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПодключениеКРарусЭвотор

// Функция - Проверить корректность команды
//
// Параметры:
//  ИмяКоманды - Строка - Имя команды.
//  РезультатВыполнения - Булево - Признак.
//
// Возвращаемое значение:
//  Булево - Результат проверки.
Функция ПроверитьКорректностьКоманды(ИмяКоманды, РезультатВыполнения)
	
	// Список известных драйверу команд.
	КомандыДрайвера = Новый Массив;
	КомандыДрайвера.Добавить("СинхронизацияСТерминалом");
	КомандыДрайвера.Добавить("ОтправитьФайл");
	КомандыДрайвера.Добавить("ЗагрузитьФайл");
	КомандыДрайвера.Добавить("ПолучитьСписокДоступныхФайлов");
	КомандыДрайвера.Добавить("УдалитьФайл");
	
	Если КомандыДрайвера.Найти(ИмяКоманды) = Неопределено Тогда
		РезультатВыполнения.ВыходныеПараметры.КодОшибки = 999;
		РезультатВыполнения.ВыходныеПараметры.ТекстСообщения = СтрЗаменить(НСтр("ru='Команда ""%ИмяКоманды%"" не поддерживается данным драйвером.'"), "%ИмяКоманды%", ИмяКоманды);
		РезультатВыполнения.ВыходныеПараметры.Результат = Ложь;
	КонецЕсли;
	
	Возврат РезультатВыполнения.ВыходныеПараметры.Результат;
КонецФункции

// Процедура - Начать принятие данных
//
// Параметры:
//  ДополнительныеПараметры - Структура - Структура дополнительных параметров.
//
Процедура НачатьПринятиеДанных(ДополнительныеПараметры)
	
	// Отправим запрос на облако Эвотор.
	ТекстОтвета = "";
	ОтправитьЗапрос(ДополнительныеПараметры, ТекстОтвета);
	
	Если НЕ ДополнительныеПараметры.ВыходныеПараметры.Результат Тогда
		Возврат;
	КонецЕсли;
	
	// Преобразуем ответ json в массивы данных.
	СтруктураОтвета = ЗаполнитьСтруктуруОтвета(ДополнительныеПараметры.ИмяКоманды, ТекстОтвета);
	
	// Обработаем запрос.
	ЗагруженныеДанные = ОбработатьДанныеЗапроса(СтруктураОтвета, ДополнительныеПараметры);
	
	// Обработаем загруженные данные в зависимости от команды.
	Если ДополнительныеПараметры.ИмяКоманды = "ПолучитьСписокДоступныхФайлов" Тогда
		ДополнительныеПараметры.ВыходныеПараметры.Вставить("МассивНайденныхФайлов", ЗагруженныеДанные);
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗагрузитьФайл" Тогда
		ДополнительныеПараметры.ВыходныеПараметры.Вставить("ТекстФайла", ЗагруженныеДанные);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Начать принятие данных
//
// Параметры:
//  ДополнительныеПараметры - Структура - Структура дополнительных параметров.
//
Процедура НачатьЗаписьДанных(ДополнительныеПараметры)
	
	// Отправим запрос на облако Эвотор.
	ТекстОтвета = "";
	ОтправитьЗапрос(ДополнительныеПараметры, ТекстОтвета);
	
	Если НЕ ДополнительныеПараметры.ВыходныеПараметры.Результат Тогда
		Возврат;
	КонецЕсли;
	
	// Преобразуем ответ json.
	СтруктураОтвета = ЗаполнитьСтруктуруОтвета(ДополнительныеПараметры.ИмяКоманды, ТекстОтвета);
	
	// Обработаем запрос.
	ЗагруженныеДанные = ОбработатьДанныеЗапроса(СтруктураОтвета, ДополнительныеПараметры);
	
	// Обработаем загруженные данные в зависимости от команды.
	Если ДополнительныеПараметры.ИмяКоманды = "СинхронизацияСТерминалом" Тогда
		ДополнительныеПараметры.ВыходныеПараметры.Вставить("РезультатСинхронизации", ЗагруженныеДанные);
	КонецЕсли;
	
КонецПроцедуры

// Функция - Обработать данные запроса
//
// Параметры:
//  СтруктураДанных - Структура - Результат преобразования ответа с json.
//  ДополнительныеПараметры - Структура - Общие параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОбработатьДанныеЗапроса(СтруктураДанных, ДополнительныеПараметры)
	
	ВозвращаемыеДанные = Неопределено;
	
	НаборДанных = СтруктураДанных.Ответ;
	
	Если ДополнительныеПараметры.ИмяКоманды = "СинхронизацияСТерминалом" Тогда
		
		ВозвращаемыеДанные = Новый Структура;
		ВозвращаемыеДанные.Вставить("ТокенТерминала", НаборДанных.token);
		ВозвращаемыеДанные.Вставить("КодТерминала",   НаборДанных.device_uuid);
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ПолучитьСписокДоступныхФайлов" Тогда
		
		ВозвращаемыеДанные = Новый Массив;
		Если ТипЗнч(НаборДанных.files) = Тип("Массив") Тогда
			Для Каждого ТекФайл Из НаборДанных.files Цикл
				Если ТекФайл.Свойство("name") Тогда
					ВозвращаемыеДанные.Добавить(ТекФайл.name);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗагрузитьФайл" Тогда
		
		ВозвращаемыеДанные = НаборДанных;
		
	КонецЕсли;
	
	Возврат ВозвращаемыеДанные;
	
КонецФункции

// Процедура - Начать отправку данных
//
// Параметры:
//  ДополнительныеПараметры - Структура - Структура дополнительных параметров.
//
Процедура НачатьОтправкуДанных(ДополнительныеПараметры)
	ОтправитьЗапрос(ДополнительныеПараметры);
КонецПроцедуры

// Процедура добавляет в структуру выходных параметров сообщение об ошибке.
//
// Параметры:
//  ДополнительныеПараметры - Структура - Со всеми параметрами.
//  ТекстСообщения - Произвольный - Знач текст сообщения.
//
Процедура СоздатьСообщениеОбОшибке(ДополнительныеПараметры, Знач ТекстСообщения)
	
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры.ВыходныеПараметры.ТекстСообщения = ТекстСообщения;
		ДополнительныеПараметры.ВыходныеПараметры.Результат = Ложь;
		ДополнительныеПараметры.ВыходныеПараметры.КодОшибки = 999;
	КонецЕсли;
	
	питОбменДанными.ЗафиксироватьСобытие("ОбменСЭвотор", ТекстСообщения,,УровеньЖурналаРегистрации.Ошибка, Истина);
	
КонецПроцедуры

// Функция - Заполнить структуру ответа.
//
// Параметры:
//  ИмяКоманды - Произвольный - Имя команды.
//  Знач ТекстОтвета - Произвольный - Знач текст ответа.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция ЗаполнитьСтруктуруОтвета(ИмяКоманды, Знач ТекстОтвета)
	
	Результат = Новый Структура;
	Если ИмяКоманды = "ЗагрузитьФайл" Тогда
		ДанныеОтвета = ТекстОтвета;
	Иначе
		ДанныеОтвета = ЗаполнитьСтруктуруОтветаИзJSON(ТекстОтвета)
	КонецЕсли;
	
	Результат.Вставить("Ответ", ДанныеОтвета);
	Возврат Результат;
	
КонецФункции

// Функция - Заполнить структуру ответа из json.
//
// Параметры:
//  ТекстJSON - Произвольный - Текст json.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция ЗаполнитьСтруктуруОтветаИзJSON(ТекстJSON)
	
	ДанныеОтвета = Неопределено;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		ПоляДат = Новый Массив;
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON,,ПоляДат);
		ЧтениеJSON.Закрыть();
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось прочитать файл ответа'");
		СоздатьСообщениеОбОшибке(Неопределено, ТекстСообщения);
	КонецПопытки;
	
	Возврат ДанныеОтвета;
	
КонецФункции

