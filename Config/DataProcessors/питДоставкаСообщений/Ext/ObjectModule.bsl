// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Проверяет корректность заполнения параметров для работы методов обработки
//
// Параметры:
//  стрОшибки - Строка - Текст ошибок при проверк.
//
// Возвращаемое значение:
// 	Булево - Результат выполнения операции, Истина - параметры заполнены корректно.
Функция ПроверитьКорректность(стрОшибки = "") Экспорт
	Если НЕ ЗначениеЗаполнено(НастройкаДоставки) Тогда
		стрОшибки = стрОшибки + "Не указана настройка доставки";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

// Проверят наличие указанного в параметре каталога.
//  Если отсутствует, то пытается создать новый.
//  Добавляет заключительный знак "\" к переданному пути
//
// Параметры:
//  Путь - Произвольный - Путь.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
// Возвращаемое значение:
// 	Булево -	Истина, если каталог есть (или был создан). 
// 
Функция ЕстьКаталог(Путь,ТекстОшибки="") Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ (ТипЗнч(Путь) <> Тип("Строка")) Тогда
		ТекстОшибки = "Ошибка: Неверный параметр";
		Возврат Ложь;
	КонецЕсли;
	Если Прав(Путь,1) <> "\" И Прав(Путь,1) <> "/" Тогда
		Путь = Путь + Слеш;
	КонецЕсли;
	Попытка
		ПроверкаКаталога = Новый Файл(Путь);
		Если НЕ ПроверкаКаталога.Существует() Тогда
			СоздатьКаталог(Путь);
			ТекстОшибки = "Создан каталог: " + Путь;
			ПроверкаКаталога = Новый Файл(Путь);
		КонецЕсли;			
		Если ПроверкаКаталога.Существует() Тогда
			Если ПроверкаКаталога.ЭтоКаталог() Тогда
				Результат = Истина;
			Иначе
				ТекстОшибки = "Ошибка: заданный путь <"+Путь+"> не является каталогом (возможно это файл?)";
				Результат = Ложь;
			КонецЕсли;
		Иначе
			ТекстОшибки = "Ошибка: не удалось создать каталог: <"+Путь+">";
			Результат = Ложь;
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Результат = Ложь;
	КонецПопытки;
	// Возвращаем то, что у нас получилось
	Возврат Результат;
КонецФункции // ЕстьКаталог

// Выполняет проверку отправки сообщения обмена
//
// Параметры:
//  FTP - FTPСоединение - параметры FTP соединени.
//  СтрОшибок - Строка - строка ошибок при отправке сообщения обмен.
//
// Возвращаемое значение:
// 	  Булево - Результат успешности выполнения операции отправки
Функция ПроверитьВозможностьОтправки(FTP=НЕОПРЕДЕЛЕНО,СтрОшибок="") Экспорт
	
	// Создадим XML-файл со случайным именем для проверки работы всех механизмов
	ВременноеИмя = Новый УникальныйИдентификатор();
	ВременноеИмя = "_TstWRAcc_" + СтрЗаменить(ВременноеИмя,"-","") + ".tmp";
	
	// Если способ обмена не локальный каталог, а какой-то другой, то каталог временных файлов по умолчанию.
	Если НастройкаДоставки.СпособОбмена = 0 Тогда
		Если НастройкаДоставки.КаталогНаКлиенте ИЛИ (НЕ НастройкаДоставки.КаталогНаКлиенте И НЕ ЕстьКаталог(КаталогТемпФайлов)) Тогда
			КаталогТемпФайлов = КаталогВременныхФайлов();
		КонецЕсли;
	Иначе
		КаталогТемпФайлов = КаталогВременныхФайлов();
	КонецЕсли;
	
	ИмяТестовогоФайла = КаталогТемпФайлов + ВременноеИмя;
	
	Попытка
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяТестовогоФайла);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.Закрыть();
		ЗаписьXML = НЕОПРЕДЕЛЕНО;
	Исключение
		СтрОшибок = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	// Проверим, создался ли файл
	ФС = Новый Файл(ИмяТестовогоФайла);
	Если НЕ ФС.Существует() ИЛИ НЕ ФС.ЭтоФайл() Тогда
		ФС = НЕОПРЕДЕЛЕНО;
		СтрОшибок = "Нет прав на запись в папку """ + КаталогТемпФайлов + """";
		Возврат Ложь;
	КонецЕсли;
	ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяТестовогоФайла;
	ФС = НЕОПРЕДЕЛЕНО; // Этот объект более не нужен
	
	Результат = Ложь;
	// Проверка возможности отправки в зависимости от способа обмена (транспорта)
	Если (НастройкаДоставки.СпособОбмена = 0) ИЛИ (НастройкаДоставки.СпособОбмена = 3) Тогда
		// Проверим, правильно ли задан каталог обмена
		КаталогОбмена = "";
		Если НЕ ПроверитьСуществованиеКаталогаОбмена(КаталогОбмена,FTP,СтрОшибок) Тогда
			Результат = Ложь;
		ИначеЕсли (НастройкаДоставки.СпособОбмена = 0) Тогда
			
			Если НастройкаДоставки.КаталогНаКлиенте Тогда
				Результат = Истина;
				
			Иначе
				
				НовоеМестоРасположениеФайла = КаталогФайловСообщений + ВременноеИмя;
				ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + НовоеМестоРасположениеФайла;
				Попытка
					ПереместитьФайл(ИмяТестовогоФайла,НовоеМестоРасположениеФайла);
					Результат = Истина;
				Исключение 
					СтрОшибок = "Ошибка перемещения тест-файл  в папку """+КаталогФайловСообщений+""" - " + ОписаниеОшибки() + ". ОПЕРАЦИЯ ОТПРАВКИ БУДЕТ ПРЕРВАНА!";
					Результат = Ложь;
				КонецПопытки;
			КонецЕсли;
			
		Иначе // ЗначенияРеквизитов.СпособОбмена = 3
			FTPИмяТестФайла = КаталогОбмена + ВременноеИмя;
			Попытка
				#Если Клиент Тогда
					Состояние("Проверяем доступность FTP на запись...");
				#КонецЕсли
				FTP.Записать(ИмяТестовогоФайла, FTPИмяТестФайла);
				#Если Клиент Тогда
					Состояние("Проверяем доступность FTP на запись - ОК");
				#КонецЕсли
				Результат = Истина;
			Исключение
				СтрОшибок = ОписаниеОшибки();
				Результат = Ложь;
			КонецПопытки;
			#Если Клиент Тогда
				Состояние("Удаляем временные файлы с FTP...");
			#КонецЕсли
			Попытка FTP.Удалить(FTPИмяТестФайла);
			Исключение КонецПопытки;
		КонецЕсли;
	ИначеЕсли (НастройкаДоставки.СпособОбмена = 1) Тогда
		#Если Клиент Тогда
			Почта = Новый Почта(); 
			Попытка
				Почта.Подключиться();
				Почта.Отключиться();
				Результат = Истина;
			Исключение
				СтрОшибок = "Ошибка: " + ОписаниеОшибки();
				Результат = Ложь;
			КонецПопытки;
		#Иначе
			СтрОшибок = "Ошибка: Почтовая система недоступна на сервере 1С:Предприятие и в модуле внешнего соединения!";
			Результат = Ложь;
		#КонецЕсли
	ИначеЕсли (НастройкаДоставки.СпособОбмена = 2) Тогда
		ПочтовыйПрофиль = Новый ИнтернетПочтовыйПрофиль;
		ПочтовыйПрофиль.АдресСервераSMTP = НастройкаДоставки.СерверSMTP;
		ПочтовыйПрофиль.ПортSMTP         = НастройкаДоставки.ПортSMTP;
		ПочтовыйПрофиль.ПользовательSMTP = НастройкаДоставки.ПользовательSMTP;
		ПочтовыйПрофиль.ПарольSMTP       = НастройкаДоставки.ПарольSMTP;
		
		Почта = Новый ИнтернетПочта(); 
		Попытка
			Почта.Подключиться(ПочтовыйПрофиль);
			Почта.Отключиться();
			Результат = Истина;
		Исключение
			СтрОшибок = "Ошибка: " + ОписаниеОшибки();
			Результат = Ложь;
		КонецПопытки;
	ИначеЕсли (НастройкаДоставки.СпособОбмена = 4) Тогда
		Попытка
			HTTPСоединение = Новый HTTPСоединение(НастройкаДоставки.АдресСервераHTTP, НастройкаДоставки.ПортHTTP,НастройкаДоставки.ПользовательHTTP, НастройкаДоставки.ПарольHTTP,,300);
			Результат = Истина;
		Исключение
			СтрОшибок = "Ошибка: " + ОписаниеОшибки();
			Результат = Ложь;
		КонецПопытки;
	КонецЕсли;
	#Если Клиент Тогда
		Состояние("");
	#КонецЕсли
	Возврат Результат;
	
КонецФункции

// Производит проверку на существование каталога обмена - локального и на ftp-сервере.
//
// Параметры:
//  СтрКаталогОбмена - Строка - каталог обмен.
//  FTP - локального и на ftp - сервере.
//   Параметры:
//   Параметры.
//  СтрОшибки - Произвольный - Стр ошибки.
//
// Возвращаемое значение:
// 	  Булево - Результат успешности выполнения операции проверки
Функция ПроверитьСуществованиеКаталогаОбмена(СтрКаталогОбмена = "",FTP=НЕОПРЕДЕЛЕНО,СтрОшибки="") Экспорт
	
	// Для почты не проверяем
	Если НастройкаДоставки.СпособОбмена = 1 ИЛИ НастройкаДоставки.СпособОбмена = 2 ИЛИ (НастройкаДоставки.СпособОбмена = 0 И НастройкаДоставки.КаталогНаКлиенте) Тогда
		Возврат Истина;
	КонецЕсли;
	
	#Если Клиент Тогда
		Состояние("Проверка каталога обмена...");
	#КонецЕсли
	
	Если НастройкаДоставки.СпособОбмена = 0 Тогда
		СтрКаталогОбмена = КаталогФайловСообщений;
	ИначеЕсли НастройкаДоставки.СпособОбмена = 3 Тогда	
		СтрКаталогОбмена = НастройкаДоставки.КаталогОбменаFTP;
	КонецЕсли; 
	
	Если НастройкаДоставки.СпособОбмена = 0 И ПустаяСтрока(СтрКаталогОбмена) Тогда
		СтрОшибки = "Ошибка: Не указан каталог обмена!";
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекДата + СтрОшибки;
		Сообщение.Сообщить();
		Возврат Ложь;
	ИначеЕсли (НастройкаДоставки.СпособОбмена = 0) Тогда
		Если ЕстьКаталог(СтрКаталогОбмена) Тогда
			Возврат Истина;
		Иначе
			СтрОшибки = "Ошибка: указан неверный каталог обмена <" + СтрКаталогОбмена + ">";
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекДата + СтрОшибки;
			Сообщение.Сообщить();
		КонецЕсли;
	ИначеЕсли (НастройкаДоставки.СпособОбмена = 3) Тогда
		Если (Прав(СтрКаталогОбмена,1) <> "/") Тогда
			СтрКаталогОбмена = СтрКаталогОбмена + "/";
		КонецЕсли;
		// Проверим реквизиты подключения к FTP
		Если FTP = НЕОПРЕДЕЛЕНО  Тогда 
			#Если Клиент Тогда
				Состояние("Попытка подключения к FTP...");
			#КонецЕсли
			Попытка 
				FTP = Новый FTPСоединение(НастройкаДоставки.СерверFTP, 
				НастройкаДоставки.ПортFTP, 
				НастройкаДоставки.ПользовательFTP, 
				НастройкаДоставки.ПарольFTP,, 
				НастройкаДоставки.ПассивныйРежим);
				#Если Клиент Тогда
					Состояние("Попытка подключения к FTP - ОК");
				#КонецЕсли
			Исключение
				ТекстОшибки = ИнформацияОбОшибке().Описание;
				Если Найти(ВРег(ТекстОшибки),ВРег("couldn't connect to server")) Тогда
					ТекстОшибки = " на указанном сервере не запущен FTP-сервер";
				ИначеЕсли Найти(ВРег(ТекстОшибки),ВРег("couldn't resolve host name")) Тогда 	
					ТекстОшибки = " указанный сервер не доступен";
				КонецЕсли; 
				стрОшибки = стрОшибки + "Ошибка подключения к FTP серверу <ftp://" + НастройкаДоставки.СерверFTP + ">: " + ТекстОшибки;
				Возврат Ложь;
			КонецПопытки;
		КонецЕсли;
		
		// Проверим существование каталога 		
		Попытка 
			#Если Клиент Тогда
				Состояние("Попытка установить каталог на FTP...");
			#КонецЕсли
			FTP.УстановитьТекущийКаталог(СтрКаталогОбмена);
		Исключение
			#Если Клиент Тогда
				Состояние("Попытка создать каталог на FTP...");
			#КонецЕсли
			Попытка // Пробуем создать "нужный" каталог
				FTP.СоздатьКаталог(СтрКаталогОбмена);
				FTP.УстановитьТекущийКаталог(СтрКаталогОбмена);
			Исключение
				СтрОшибки = "Ошибка: не удалось создать на FTP заданный каталог обмена """ + СтрКаталогОбмена + """";
				ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекДата + СтрОшибки;
				Сообщение.Сообщить();
				Возврат Ложь;
			КонецПопытки;
		КонецПопытки;
		
		#Если Клиент Тогда
			Состояние("Проверяем текущий каталог на FTP...");
		#КонецЕсли
		СтрТекущийКаталог = FTP.ТекущийКаталог();
		Если ВРЕГ(СтрТекущийКаталог) = ВРЕГ(СтрКаталогОбмена) Тогда
			#Если Клиент Тогда
				Состояние("Проверяем текущий каталог на FTP - ОК");
			#КонецЕсли
			Возврат Истина;
		Иначе
			#Если Клиент Тогда
				Состояние("Проверяем текущий каталог на FTP - Ошибка!");
			#КонецЕсли
			СтрОшибки = "Ошибка: не удалось установить на FTP в качестве текущего заданный каталог обмена """ + СтрКаталогОбмена + """";
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекДата + СтрОшибки;
			Сообщение.Сообщить();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	СтрОшибки = "Ошибка: не удалось определить наличие каталога обмена - обратитесь к разработчику";
	Возврат Ложь; 
	
КонецФункции	//	ПроверитьСуществованиеКаталогаОбмена()

// Отправка файла по электронной почте
//
// Параметры:
//  ИмяОтправляемогоФайла - Строка - Имя файла для отправк.
//
// Возвращаемое значение:
// 	Булево - Флаг успешного выполнения отправки файла
Функция ОтправитьФайл_Почта(ИмяОтправляемогоФайла = "") Экспорт
	
	// ПРОВЕРКА
	// Проверка на существование файла-источника
	ФайлИсточник = Новый Файл(ИмяОтправляемогоФайла);
	Если НЕ ФайлИсточник.Существует() Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Файл сообщения не обнаружен <" + ИмяОтправляемогоФайла + ">",,
		УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	ПолноеИмяИсходногоФайла = ФайлИсточник.ПолноеИмя;
	ИмяИсходногоФайла = ФайлИсточник.Имя;
	// В массив для удаления
	ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяОтправляемогоФайла;
	
	Если НастройкаДоставки.АрхивироватьСообщенияОбмена Тогда
		Рез = ЗапаковатьОтправляемыйФайл(ФайлИсточник); // теперь это zip
		Если Рез = Ложь Тогда
			Возврат Рез;
		КонецЕсли;
		ИмяОтправляемогоФайла = ФайлИсточник.ПолноеИмя;
		// В массив для удаления
		ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяОтправляемогоФайла;
	КонецЕсли;
	
	// Транслит
	Транслит = НастройкаДоставки.ВыполнятьТранслитерацию;
	ИмяФайлаСообщения = ФайлИсточник.Имя;
	Если Транслит Тогда
		ИмяФайлаСообщения = питОбменДанными.ВыполнитьТранслит(ИмяФайлаСообщения);
	КонецЕсли;
	
	// Проверили почту
	СтрОшибкиПочта = "";
	Почта = ПодключитьсяКПочте(СтрОшибкиПочта);
	Если Почта = Неопределено Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", СтрОшибкиПочта, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		СтрОшибки = СтрОшибки + СтрОшибкиПочта + Символы.ПС;
		Возврат Ложь;
	КонецЕсли;
	
	// ОТПРАВКА
	Рез = Ложь;
	
	// MAPI
	Если НастройкаДоставки.СпособОбмена = 1 Тогда
		#Если Клиент Тогда
			ПочтовоеСообщение = Новый ПочтовоеСообщение;
		#Иначе
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", 
			"Почтовый профиль пользователя недоступен в режиме внешнего соединения или на сервере!",
			,
			УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
			Возврат Ложь;
		#КонецЕсли
		// SMTP/POP3   
	Иначе	
		ПочтовоеСообщение = Новый ИнтернетПочтовоеСообщение;
		ПочтовоеСообщение.Кодировка = "windows-1251";
	КонецЕсли;
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Начало отправки файла <" + ИмяОтправляемогоФайла 
		+ ", на адрес " + НастройкаДоставки.АдресЭлектроннойПочты + ">",  , УровеньЖурналаРегистрации.Информация,
	КомментироватьХодОбмена);
	Рез = Истина;
	
	// Формируем сообщение обмена
	ПочтовоеСообщение.Тема = "1С: СООБЩЕНИЕ ОБМЕНА: " + ИмяФайлаСообщения;
	ПочтовоеСообщение.Получатели.Добавить(НастройкаДоставки.АдресЭлектроннойПочты);
	ПочтовоеСообщение.Отправитель = НастройкаДоставки.АдресЭлектроннойПочты;
	
	// Создаем вложение с файлом обмена
	ПочтовоеСообщение.Вложения.Добавить(ИмяОтправляемогоФайла, ИмяФайлаСообщения);
	
	// Отправляем сообщение с файлом обмена
	Попытка
		Почта.Послать(ПочтовоеСообщение);
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Отправлен файл <" + ИмяОтправляемогоФайла + ", на адрес " + НастройкаДоставки.АдресЭлектроннойПочты + ">.",
		,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Рез = Истина; // отправили
	Исключение
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при отправке файла <" + ИмяОтправляемогоФайла + ", на адрес " + НастройкаДоставки.АдресЭлектроннойПочты + ">: "
		+ ИнформацияОбОшибке().Описание, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Рез = Ложь;
	КонецПопытки;
	
	// Перемещение из временного каталога в каталог отправленных сообщений
	Если Рез И НастройкаДоставки.СохранятьОтправленные Тогда 
		Попытка
			ПолноеИмяОтправленногоФайла = КаталогОтправленныхСообщений + ИмяИсходногоФайла;
			ПереместитьФайл(ПолноеИмяИсходногоФайла, ПолноеИмяОтправленногоФайла);
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Сохранена копия файла <" + ПолноеИмяОтправленногоФайла + ">",,
			УровеньЖурналаРегистрации.Информация,
			КомментироватьХодОбмена);
		Исключение
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при сохранении копии файла <" + ПолноеИмяОтправленногоФайла + ">: "
			+ ИнформацияОбОшибке().Описание, ,УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		КонецПопытки;
	КонецЕсли;
	
	// Локальный темп каталог чистим всегда от ВСЕХ наших действий (в том числе и следы архивации).
	МаскаФайловУдаления = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "??????????", "*");
	Файлы = НайтиФайлы(КаталогТемпФайлов, МаскаФайловУдаления);
	Для Каждого Файл Из Файлы Цикл
		Попытка
			УдалитьФайлы(Файл.ПолноеИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		Почта.Отключиться();
	Исключение
	КонецПопытки;
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Конец отправки файла <" + ИмяОтправляемогоФайла + ", на адрес " + НастройкаДоставки.АдресЭлектроннойПочты + ">",,
	УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	
	Возврат Истина;
КонецФункции

// Отправка файла по электронной почте
//
// Параметры:
//  ИмяОтправляемогоФайла - Строка - Имя файла для отправк.
//  ПараметрыОбмена - Произвольный - Параметры обмена.
//
// Возвращаемое значение:
// 	Булево - Флаг успешного выполнения отправки файла
Функция ОтправитьФайл_HTTP(ИмяОтправляемогоФайла = "", ПараметрыОбмена) Экспорт
	
	// ПРОВЕРКА
	// Проверка на существование файла-источника
	ФайлИсточник = Новый Файл(ИмяОтправляемогоФайла);
	Если НЕ ФайлИсточник.Существует() Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Файл сообщения не обнаружен <" + ИмяОтправляемогоФайла + ">",,
		УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	ПолноеИмяИсходногоФайла = ФайлИсточник.ПолноеИмя;
	ИмяИсходногоФайла = ФайлИсточник.Имя;
	// В массив для удаления
	ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяОтправляемогоФайла;
	
	// Транслит
	Транслит = НастройкаДоставки.ВыполнятьТранслитерацию;
	ИмяФайлаСообщения = ФайлИсточник.Имя;
	Если Транслит Тогда
		ИмяФайлаСообщения = питОбменДанными.ВыполнитьТранслит(ИмяФайлаСообщения);
	КонецЕсли;
	
	Попытка
		
		Файл = Новый ЧтениеТекста(ИмяОтправляемогоФайла);
		ТекстФайлаЗапроса = Файл.Прочитать();
		Файл.Закрыть();
		
	Исключение
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при чтении копии файла <" + ИмяОтправляемогоФайла + ">: "
			+ ИнформацияОбОшибке().Описание, ,УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);

		
	КонецПопытки;	
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Начало отправки файла <" + ИмяОтправляемогоФайла 
		+ ", на адрес " + НастройкаДоставки.АдресЭлектроннойПочты + ">",  , УровеньЖурналаРегистрации.Информация,
	КомментироватьХодОбмена);
	
	ВходныеПараметры= Новый Структура;
	ВходныеПараметры.Вставить("КодТерминала", ПараметрыОбмена.КодТерминала);
	ВходныеПараметры.Вставить("ТокенТерминала", ПараметрыОбмена.ТокенТерминала);
	ВходныеПараметры.Вставить("ИмяФайла", ИмяФайлаСообщения);
	ВходныеПараметры.Вставить("ТекстЗапроса", ТекстФайлаЗапроса);
	ВходныеПараметры.Вставить("НастройкаДоставкиПоУмолчанию", НастройкаДоставки); 
	ВыходныеПараметры = Обработки.питДоставкаСообщений.НачатьВыполнениеКоманды("ОтправитьФайл", ВходныеПараметры);
	
	Рез = ВыходныеПараметры.Результат;
	Если НЕ Рез Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при отправке файла <" + ИмяОтправляемогоФайла + ": "
		+ ВыходныеПараметры.ТекстСообщения, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
	КонецЕсли;
	
	// Перемещение из временного каталога в каталог отправленных сообщений
	Если Рез И НастройкаДоставки.СохранятьОтправленные Тогда 
		Попытка
			ПолноеИмяОтправленногоФайла = КаталогОтправленныхСообщений + ИмяИсходногоФайла;
			ПереместитьФайл(ПолноеИмяИсходногоФайла, ПолноеИмяОтправленногоФайла);
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Сохранена копия файла <" + ПолноеИмяОтправленногоФайла + ">",,
			УровеньЖурналаРегистрации.Информация,
			КомментироватьХодОбмена);
		Исключение
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при сохранении копии файла <" + ПолноеИмяОтправленногоФайла + ">: "
			+ ИнформацияОбОшибке().Описание, ,УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		КонецПопытки;
	КонецЕсли;
	
	// Локальный темп каталог чистим всегда от ВСЕХ наших действий (в том числе и следы архивации).
	МаскаФайловУдаления = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "??????????", "*");
	Файлы = НайтиФайлы(КаталогТемпФайлов, МаскаФайловУдаления);
	Для Каждого Файл Из Файлы Цикл
		Попытка
			УдалитьФайлы(Файл.ПолноеИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Конец отправки файла <" + ИмяОтправляемогоФайла + ", на адрес " + НастройкаДоставки.АдресЭлектроннойПочты + ">",,
	УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	
	Возврат Истина;
КонецФункции

// Получение файла по FTP протоколу.
//
// Параметры:
// 	ИмяПолученногоФайла - Строка -  файл, в который будет произведено копирование файла с сообщением обмена.
// 	ПараметрыОбмена - Структура - ПараметрыОбмена
//
// Возвращаемое значение:
// 	Булево.
//
Функция ПолучитьФайл_FTP(ИмяПолученногоФайла = "") Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	// Обработали каталоги
	КаталогОбменаFTP = НастройкаДоставки.КаталогОбменаFTP;
	Если Прав(КаталогОбменаFTP,1) <> "/" И Прав(КаталогОбменаFTP,1) <> "\" Тогда
		КаталогОбменаFTP = КаталогОбменаFTP + Слеш;
	КонецЕсли;
	Если Лев(КаталогОбменаFTP,1) <> "/" И Лев(КаталогОбменаFTP,1) <> "\" Тогда
		КаталогОбменаFTP = Слеш + КаталогОбменаFTP;
	КонецЕсли;
	
	// Подключимся к фтп повторно
	СтрОшибкиFTP = "";
	FTP = ПодключитьсяКFTP(СтрОшибкиFTP);
	Если FTP = Неопределено Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрОшибкиFTP,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	
	Транслит = НастройкаДоставки.ВыполнятьТранслитерацию;
	// Получаем маску для поиска файлов с сообщениями обмена
	МаскаФайловИсточник = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "*", "*",,Транслит);
	МаскаФайловПриемник = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "*", "*",,Ложь);
	Попытка
		Файлы = FTP.НайтиФайлы(КаталогОбменаFTP, МаскаФайловИсточник);
	Исключение
		СтрОшибкиFTP = ОписаниеОшибки();
		Если Найти(Врег(СтрОшибкиFTP),ВРег("access denied")) Тогда
			СтрОшибкиFTP = "Ошибка аутентификации при доступе к ресурсу <ftp://" + НастройкаДоставки.СерверFTP + НастройкаДоставки.КаталогОбменаFTP + ">";
		КонецЕсли; 
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрОшибкиFTP,,УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		ВызватьИсключение СтрОшибкиFTP;
		Возврат Ложь;
	КонецПопытки;
	
	Если Файлы.Количество() = 0 Тогда
		// А вдруг несогласованы галочки Транслитерация у отправителя получателя.
		Транслит = НЕ Транслит; // Попробуем с настройкой "наоборот" посмотреть
		МаскаФайловИсточник = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "*", "*",,Транслит);
		Файлы = FTP.НайтиФайлы(КаталогОбменаFTP, МаскаФайловИсточник);
	КонецЕсли;
	
	// получим ожидаемое имя файла для приема
	ОжидаемоеИмяФайла = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, Неопределено, "*", , Транслит);
	ОжидаемоеИмяФайла = Лев(ОжидаемоеИмяФайла,Найти(ОжидаемоеИмяФайла,".")-1);
	
	ОжидаемоеИмяФайлаСРасширением = ОжидаемоеИмяФайла + ".xml";
	
	#Если Клиент Тогда
		Состояние("Ждите. Идет поиск файла обмена на <ftp://" + НастройкаДоставки.СерверFTP + НастройкаДоставки.КаталогОбменаFTP);
	#КонецЕсли
	ПолноеИмяФайлаОбменаИсточник = ""; ИмяФайлаОбменаИсточник = "";
	ИмяСМаксНомером = "";
	
	// Отбираем файл с максимальным номером в имени
	ИмяФайлаСообщенияФТП = "";
	FTPФайлыДляУдаления = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		
		Если ВРег(Файл.Расширение) = ".TMP" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекНомерСообщения = ВыделитьНомерСообщения(Файл.ИмяБезРасширения);
		ОжидаемыйНомерСообщения = ВыделитьНомерСообщения(ОжидаемоеИмяФайла);
		
		Если ТекНомерСообщения < ОжидаемыйНомерСообщения Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			FTPФайлыДляУдаления.Добавить(Файл.ПолноеИмя);
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. "
			+ "Ожидаемый файл - <" + ОжидаемоеИмяФайлаСРасширением + ">.";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Продолжить;
		КонецЕсли;
		
		МаксНомерСообщения = ВыделитьНомерСообщения(ИмяСМаксНомером);
		
		Если (МаксНомерСообщения > 0 И ТекНомерСообщения < МаксНомерСообщения) Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			FTPФайлыДляУдаления.Добавить(Файл.ПолноеИмя);
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. " + "Актуальный файл - <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ПолноеИмяФайлаОбменаИсточник) + ">.";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Продолжить;
		КонецЕсли;
		
		Если ТекНомерСообщения > МаксНомерСообщения Тогда
			// Не успели его прочитать как оно уже устарело (прислали с еще бОльшим номером)
			Если НЕ ПустаяСтрока(ПолноеИмяФайлаОбменаИсточник) Тогда
				FTPФайлыДляУдаления.Добавить(ПолноеИмяФайлаОбменаИсточник);
				
				СтрСообщения = "Файл обмена <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ПолноеИмяФайлаОбменаИсточник) + "> устарел и будет удален. Актуальный файл - <" + Файл.Имя + ">.";
				питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
				
			КонецЕсли;
			ПолноеИмяФайлаОбменаИсточник = Файл.ПолноеИмя;	// Здесь теперь запоминаем нового кандидата
			ИмяСМаксНомером = Файл.ИмяБезРасширения;		// Номер изменим для следующих сравнений
			ИмяФайлаСообщенияФТП = Файл.Имя;
		КонецЕсли;
		
	КонецЦикла;
	
	#Если Клиент Тогда
		Состояние("");
	#КонецЕсли
	// Преобразовали из транслита
	Если Транслит И НЕ ПустаяСтрока(ИмяФайлаСообщенияФТП) Тогда
		Номер = ВыделитьНомерСообщения(ИмяФайлаСообщенияФТП, "Строка");
		ИмяФайлаСообщения = СтрЗаменить(МаскаФайловПриемник,"*.",Номер);
		ИмяФайлаСообщения = СтрЗаменить(ИмяФайлаСообщения,"*",Файл.Расширение);
	Иначе
		ИмяФайлаСообщения = ИмяФайлаСообщенияФТП;
	КонецЕсли;
	
	ПолноеИмяФайлаОбменаПриемник = КаталогТемпФайлов + ИмяФайлаСообщения;
	ПолноеИмяФайлаОбменаИсточник = КаталогОбменаFTP + ИмяФайлаСообщенияФТП;
	
	Рез = Ложь; // Начнем с утверждения что все плохо и своими действиями изменим ситуацию к лучшему :-)
	
	Если Не ПустаяСтрока(ИмяФайлаСообщенияФТП) Тогда
		СтрСообщения = "Начало получения файла <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + ">";
		#Если Клиент Тогда
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		#КонецЕсли
		// Получаем файл с сообщением обмена в указанный файл
		Попытка
			
			ГрузитьИзFTP = Истина; 
			ФайлПолучен = Ложь;
			// Проверим в каталоге обменов готового файла с сообщением обмена
			Файлы = НайтиФайлы(КаталогФайловСообщений,Лев(ИмяФайлаСообщения, СтрДлина(ИмяФайлаСообщения)-3) + "*");
			Если Файлы.Количество() > 0 Тогда
				ГрузитьИзFTP = Ложь; 
			КонецЕсли;
			
			Если ГрузитьИзFTP Тогда
				Попытка
					// SUIG - раскомментировать для удаления текущего обработанного файла.
					// Иначе будет всегда оставаться самый последний обработанный файл.

					FTP.Получить(ПолноеИмяФайлаОбменаИсточник, ПолноеИмяФайлаОбменаПриемник);
					#Если Клиент Тогда
						СтрСообщения = "Успешно получен файл <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + ">"  " в локальный каталог <" + ПолноеИмяФайлаОбменаПриемник + ">";
						питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
					#КонецЕсли 
					ФайлПолучен = Истина;
				Исключение
					СтрСообщения = "Ошибка получения файла с <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + ">" + ОписаниеОшибки();
					питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
					Возврат Ложь;
				КонецПопытки;
			Иначе
				ФайлПолучен = Истина;
				ПолноеИмяФайлаОбменаПриемник = Файлы[0].ПолноеИмя;
			КонецЕсли;
			
			ФайлСообщения = Новый Файл(ПолноеИмяФайлаОбменаПриемник);
			Если НЕ (ФайлСообщения.Существует() И ФайлСообщения.ЭтоФайл()) Тогда
				ВызватьИсключение "Не найдено полученное с <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + ">" 
				+ " сообщение обмена <" + ПолноеИмяФайлаОбменаПриемник + ">";
				Возврат Ложь;
			КонецЕсли;
			
			// Распакуем сообщение если оно запакованное во временную папку и в случае успеха переместим результат
			// в каталог обменов.
			Если НРег(Прав(ПолноеИмяФайлаОбменаПриемник, 3)) = "zip" Тогда
				Рез = РаспаковатьПолученныйФайл(ФайлСообщения);
				Если Рез = Ложь Тогда
					Возврат Рез;
				КонецЕсли;
				ПолноеИмяФайлаОбменаПриемник = ФайлСообщения.ПолноеИмя;
			КонецЕсли;
			
			ПутьФайла=ВРЕГ(ФайлСообщения.Путь);
			Если Прав(ПутьФайла,1) <> "\" И Прав(ПутьФайла,1) <> "/" Тогда
				ПутьФайла = ПутьФайла + Слеш;
			КонецЕсли;
			Если ПутьФайла = ВРЕГ(КаталогФайловСообщений) Тогда
				Рез = Истина; // Файл уже лежит где нужно
				ИмяПолученногоФайла = ФайлСообщения.ПолноеИмя;
			Иначе
				// Перемещение готового сообщения в каталог обменов
				Попытка
					ПереместитьФайл(ФайлСообщения.ПолноеИмя,КаталогФайловСообщений+ФайлСообщения.Имя);
					ИмяПолученногоФайла = КаталогФайловСообщений+ФайлСообщения.Имя;
					Рез = Истина;
				Исключение
					ВызватьИсключение "Не удалось доставить файл сообщения <" + ФайлСообщения.ПолноеИмя + "> в каталог <" + КаталогФайловСообщений + "> "+ОписаниеОшибки();
				КонецПопытки;
			КонецЕсли;
			
			ФайлСообщения = НЕОПРЕДЕЛЕНО;
			
		Исключение
			СтрСообщения = "Ошибка получения файла  <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + "> " + ИнформацияОбОшибке().Описание;
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
			Рез = Ложь;
		КонецПопытки;
		
	Иначе
		СтрСообщения = "Файл сообщения не обнаружен на <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + "> ";
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Рез = Истина; // ну нет его там
	КонецЕсли;
	
	// ЗАКЛЮЧИТЕЛЬНЫЕ ДЕЙСТВИЯ
	// Очистим фтп каталог от ненужных файлов
	Если FTPФайлыДляУдаления.Количество()>0 Тогда
		Попытка
			FTP.УстановитьТекущийКаталог(КаталогОбменаFTP);
		Исключение
			FTP = ПодключитьсяКFTP(СтрОшибкиFTP);
		КонецПопытки;
		Если FTP = НЕОПРЕДЕЛЕНО Тогда
			СтрСообщения = "Ошибка возобновления соединения с сервером <ftp://" + НастройкаДоставки.СерверFTP + "> - "+СтрОшибкиFTP + Символы.ПС + "Файлы устаревших сообщений не будут удалены";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Предупреждение, КомментироватьХодОбмена);
		Иначе
			Для Каждого Файл Из FTPФайлыДляУдаления Цикл
				Попытка // Пытаемся удалить файл со старыми сообщением
					FTP.Удалить(Файл, );
					СтрСообщения = "Удален файл устаревшего сообщения<ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + ">";
					питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
				Исключение
					СтрОшибкиFTP = ОписаниеОшибки();
					СтрСообщения = "Ошибка удаления устаревшего сообщения <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + "> - "+СтрОшибкиFTP;
					питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Предупреждение, КомментироватьХодОбмена);
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Локальный темп каталог чистим всегда от наших действий
	МаскаФайловУдаления = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "*", "*");
	Файлы = НайтиФайлы(КаталогТемпФайлов, МаскаФайловУдаления);
	Для Каждого Файл Из Файлы Цикл
		Попытка
			// Наш полученный по ftp файл, его точно не удаляем.
			Если Файл.ПолноеИмя = ПолноеИмяФайлаОбменаПриемник Тогда
				Продолжить;
			КонецЕсли;
			УдалитьФайлы(Файл.ПолноеИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СтрСообщения = "Конец получения файла <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаИсточник + ">";
	#Если Клиент Тогда 
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	#КонецЕсли
	
	// Возвращаем результат 
	Возврат Рез;
	
КонецФункции


// Функция - Получить файл http.
//
// Параметры:
//  ИмяПолученногоФайла - Строка - Имя полученного файла.
//  ПараметрыОбмена - Произвольный - Параметры обмена.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьФайл_HTTP(ИмяПолученногоФайла = "", ПараметрыОбмена) Экспорт
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Начало получения файла из http сервиса ",,
	УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	
	Транслит = НастройкаДоставки.ВыполнятьТранслитерацию;
	
	// Получаем маску для поиска всех файлов с сообщениями обмена
	МаскаФайлаИсточника = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "*","xml", , Транслит,);
	
	ВходныеПараметры= Новый Структура;
	ВходныеПараметры.Вставить("КодТерминала", УзелОбмена.КодТерминала);
	ВходныеПараметры.Вставить("ТокенТерминала", УзелОбмена.ТокенТерминала);
	ВходныеПараметры.Вставить("ОжидаемоеИмяФайла", МаскаФайлаИсточника);
	ВходныеПараметры.Вставить("НастройкаДоставкиПоУмолчанию", НастройкаДоставки); 
	
	ВыходныеПараметры = Обработки.питДоставкаСообщений.НачатьВыполнениеКоманды("ПолучитьСписокДоступныхФайлов", ВходныеПараметры);
	
	Рез = ВыходныеПараметры.Результат;
	Если НЕ Рез Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при получении файлов: "
		+ ВыходныеПараметры.ТекстСообщения, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	
	
	Файлы = ВыходныеПараметры.МассивНайденныхФайлов;
	
	ОжидаемоеИмяФайла = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь,,"", , Транслит);
	ОжидаемоеИмяФайла = Лев(ОжидаемоеИмяФайла,Найти(ОжидаемоеИмяФайла,".") - 1);
	ОжидаемоеИмяФайлаСРасширением = ОжидаемоеИмяФайла + ".xml";
	
	ПолноеИмяФайлаОбменаИсточник = ""; 
	ИмяФайлаОбменаИсточник = "";
	ИмяСМаксНомером = "";
	
	// Отбираем файл с максимальным номером в имени
	ИмяФайлаСообщенияНТТР = "";
	HTTPФайлыДляУдаления = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		
		ФайлИмяБезРасширения = Лев(Файл, СтрДлина(Файл) - 4);
		ТекНомерСообщения = ВыделитьНомерСообщения(ФайлИмяБезРасширения);
		ОжидаемыйНомерСообщения = ВыделитьНомерСообщения(ОжидаемоеИмяФайла);
		
		Если ТекНомерСообщения < ОжидаемыйНомерСообщения Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			HTTPФайлыДляУдаления.Добавить(Файл);
			СтрСообщения = "Файл обмена <" + Файл + "> устарел и будет удален. "
			+ "Ожидаемый файл - <" + ОжидаемоеИмяФайлаСРасширением + ">.";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Продолжить;
		КонецЕсли;
		
		МаксНомерСообщения = ВыделитьНомерСообщения(ИмяСМаксНомером);
		
		Если (МаксНомерСообщения > 0 И ТекНомерСообщения < МаксНомерСообщения) Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			HTTPФайлыДляУдаления.Добавить(Файл);
			СтрСообщения = "Файл обмена <" + Файл + "> устарел и будет удален. " + "Актуальный файл - <" + (ПолноеИмяФайлаОбменаИсточник) + ">.";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Продолжить;
		КонецЕсли;
		
		Если ТекНомерСообщения > МаксНомерСообщения Тогда
			// Не успели его прочитать как оно уже устарело (прислали с еще бОльшим номером)
			Если НЕ ПустаяСтрока(ПолноеИмяФайлаОбменаИсточник) Тогда
				HTTPФайлыДляУдаления.Добавить(ПолноеИмяФайлаОбменаИсточник);
				
				СтрСообщения = "Файл обмена <" + (ПолноеИмяФайлаОбменаИсточник) + "> устарел и будет удален. Актуальный файл - <" + Файл + ">.";
				питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
				
			КонецЕсли;
			ПолноеИмяФайлаОбменаИсточник = Файл; // Здесь теперь запоминаем нового кандидата
			ИмяСМаксНомером = Файл; // Номер изменим для следующих сравнений
			ИмяФайлаСообщенияНТТР = Файл;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПустаяСтрока(ИмяФайлаСообщенияНТТР) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Получим текст из последнего файла обмена.
	ВходныеПараметры= Новый Структура;
	ВходныеПараметры.Вставить("КодТерминала", УзелОбмена.КодТерминала);
	ВходныеПараметры.Вставить("ТокенТерминала", УзелОбмена.ТокенТерминала);
	ВходныеПараметры.Вставить("ИмяФайла", ИмяФайлаСообщенияНТТР);
	ВходныеПараметры.Вставить("НастройкаДоставкиПоУмолчанию", НастройкаДоставки); 
	
	ВыходныеПараметры = Обработки.питДоставкаСообщений.НачатьВыполнениеКоманды("ЗагрузитьФайл", ВходныеПараметры);
	
	Рез = ВыходныеПараметры.Результат;
	Если НЕ Рез Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при получении файлов: " + ВыходныеПараметры.ТекстСообщения, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	
	// Сохраним полученное сообщение в каталог обменов
	Попытка
		ПланируемоеИмяФайла = КаталогФайловСообщений + ИмяФайлаСообщенияНТТР;
		ФайлСообщения = Новый ЗаписьТекста;
		ФайлСообщения.Открыть(ПланируемоеИмяФайла, КодировкаТекста.UTF8);
		ФайлСообщения.Записать(ВыходныеПараметры.ТекстФайла);
		ФайлСообщения.Закрыть();

		ИмяПолученногоФайла = ПланируемоеИмяФайла;
		Рез = Истина;
	Исключение
		ВызватьИсключение "Не удалось доставить файл сообщения <" + ИмяФайлаСообщенияНТТР + "> в каталог <" + КаталогФайловСообщений + "> "+ОписаниеОшибки();
	КонецПопытки;
	
	// ЗАКЛЮЧИТЕЛЬНЫЕ ДЕЙСТВИЯ
	// Очистим старые файлы.
	Если HTTPФайлыДляУдаления.Количество()>0 Тогда
		Для Каждого Файл Из HTTPФайлыДляУдаления Цикл
			Попытка // Пытаемся удалить файл со старыми сообщением
				
				ВходныеПараметры= Новый Структура;
				ВходныеПараметры.Вставить("КодТерминала", УзелОбмена.КодТерминала);
				ВходныеПараметры.Вставить("ИмяФайла", Файл);
				ВходныеПараметры.Вставить("ТокенТерминала", УзелОбмена.ТокенТерминала);
				ВходныеПараметры.Вставить("НастройкаДоставкиПоУмолчанию", НастройкаДоставки); 
				
				ВыходныеПараметры = Обработки.питДоставкаСообщений.НачатьВыполнениеКоманды("УдалитьФайл", ВходныеПараметры);
				
				Если НЕ ВыходныеПараметры.Результат Тогда
					СтрСообщения = "Ошибка удаления устаревшего сообщения <" + Файл + ">: "+ ВыходныеПараметры.ТекстСообщения;
					питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Предупреждение, КомментироватьХодОбмена);
				Иначе
					СтрСообщения = "Удален файл устаревшего сообщения<" + Файл + ">";
					питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
				КонецЕсли;
				
			Исключение
				СтрСообщения = "Ошибка удаления устаревшего сообщения <" + Файл + "> - "+ОписаниеОшибки();
				питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Предупреждение, КомментироватьХодОбмена);
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	СтрСообщения = "Конец получения файла <" + ИмяФайлаСообщенияНТТР + ">";
	#Если Клиент Тогда 
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	#КонецЕсли
	
	// Возвращаем результат 
	Возврат Рез;
КонецФункции

// Получение файла по электронной почте
//
// Параметры:
//  ИмяПолученногоФайла - Произвольный - Имя полученного файла.
//
// Возвращаемое значение:
//  Булево - Истина - если файл получен, Ложь - в противном случае
Функция ПолучитьФайл_Почта(ИмяПолученногоФайла = "") Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Начало получения файла  из почтового сервера " + НастройкаДоставки.АдресЭлектроннойПочты,,
	УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	
	// Попытка подключения
	СтрОшибкиПочта = "";
	Почта = ПодключитьсяКПочте(СтрОшибкиПочта);
	Если Почта = Неопределено Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрОшибкиПочта,, УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	
	ТемаСообщения = "";
	ИмяФайлаСообщения = "";
	АдресОтправителя = "";
	
	МаскаТемыСообщенияОбмена = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "", ""); // "MessageExchange_Ц_П1_..."
	МаскаТемыСообщенияОбмена = Лев(МаскаТемыСообщенияОбмена, СтрДлина(МаскаТемыСообщенияОбмена)-1); // "MessageExchange_Ц_П1_"
	МаскаТемыСообщенияОбмена = "1С: СООБЩЕНИЕ ОБМЕНА: " + МаскаТемыСообщенияОбмена;
	
	// ПРОВЕРКА ПИСЕМ - MAPI
	Если НастройкаДоставки.СпособОбмена = 1 Тогда
		МассивСообщенийОбмена = Почта.Выбрать(Истина, Ложь);
		Если МассивСообщенийОбмена.Количество() = 0 Тогда
			// Сообщений в почтовом ящике нет
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", 
			"Писем на почтовом сервере <" + НастройкаДоставки.АдресЭлектроннойПочты + "> не обнаружено",, 
			УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Возврат Истина;
		КонецЕсли;
		
		Для Индекс = 0 По МассивСообщенийОбмена.Количество() - 1 Цикл
			// Отсеиваем только те сообщения, которые содержат файлы обмена для участвующих в обмене узлов.
			Если Лев(МассивСообщенийОбмена[Индекс].Тема, СтрДлина(МаскаТемыСообщенияОбмена)) = МаскаТемыСообщенияОбмена Тогда
				// Выбираем сообщение с последним номером сообщения обмена.
				Если МассивСообщенийОбмена[Индекс].Тема > ТемаСообщения Тогда
					ИмяФайлаСообщения = МассивСообщенийОбмена[Индекс].Вложения[0].Наименование;
					АдресОтправителя = МассивСообщенийОбмена[Индекс].Отправитель;
					Если ТипЗнч(АдресОтправителя) <> Тип("Строка") Тогда
						АдресОтправителя = АдресОтправителя.Адрес;
					КонецЕсли;
					ИндексСообщения = Индекс;
					ТемаСообщения = МассивСообщенийОбмена[Индекс].Тема;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
		Если ПустаяСтрока(ТемаСообщения) Тогда
			// Сообщений в почтовом ящике нет
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Писем по маске <" + МаскаТемыСообщенияОбмена 
			+ "> не обнаружено на почтовом сервере <" + НастройкаДоставки.АдресЭлектроннойПочты + ">",, 
			УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
			Возврат Истина; // 
		КонецЕсли;
		
	Иначе
		// SMTP / POP3
		Заголовки = Почта.ПолучитьЗаголовки();
		Если Заголовки.Количество() = 0 Тогда
			// Сообщений в почтовом ящике нет
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", 
			"Писем на почтовом сервере  <" + НастройкаДоставки.АдресЭлектроннойПочты + "> не обнаружено",, 
			УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Возврат Истина;
		КонецЕсли;
		
		Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
			// Отсеиваем только те сообщения, которые содержат файлы обмена для участвующих в обмене узлов.
			Если Лев(Заголовки[Индекс].Тема, СтрДлина(МаскаТемыСообщенияОбмена)) = МаскаТемыСообщенияОбмена Тогда
				// Выбираем сообщение с последним номером сообщения обмена
				Если Заголовки[Индекс].Тема > ТемаСообщения Тогда
					МассивЗаголовков = Новый Массив();
					МассивЗаголовков.Добавить(Заголовки[Индекс]);
					
					ТемаСообщения = Заголовки[Индекс].Тема;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
		Если ПустаяСтрока(ТемаСообщения) Тогда
			// Сообщений в почтовом ящике нет
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Писем по маске <" + МаскаТемыСообщенияОбмена 
			+ " на почтовом сервере <" + НастройкаДоставки.АдресЭлектроннойПочты + "> не обнаружено",, УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Возврат Истина;
		КонецЕсли;
		
		МассивСообщенийОбмена = Почта.Выбрать(Ложь, МассивЗаголовков);
		Если МассивСообщенийОбмена.Количество() = 0 Тогда
			// Сообщений в почтовом ящике нет
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Писем по маске <" + МаскаТемыСообщенияОбмена 
			+ " на почтовом сервере <" + НастройкаДоставки.АдресЭлектроннойПочты + "> не обнаружено",, УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
			Возврат Истина;
		КонецЕсли;
		
		ИндексСообщения = 0;
		
		ИмяФайлаСообщения = МассивСообщенийОбмена[ИндексСообщения].Вложения[0].Имя;
		АдресОтправителя = МассивСообщенийОбмена[ИндексСообщения].Отправитель.Адрес;
	КонецЕсли;
	
	// Записываем файл обмена во временный файл
	ПолноеИмяФайлаОбменаПриемник = КаталогТемпФайлов + ИмяФайлаСообщения;
	
	Рез = Ложь;
	
	Попытка
		Попытка
			МассивСообщенийОбмена[ИндексСообщения].Вложения[0].Данные.Записать(ПолноеИмяФайлаОбменаПриемник);
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Получен файл <" + ИмяФайлаСообщения + ">",,
			УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Исключение
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Ошибка получения файла <"
			+ ИмяФайлаСообщения + ">: " + ИнформацияОбОшибке().Описание, , УровеньЖурналаРегистрации.Ошибка, 
			КомментироватьХодОбмена);
			Рез = Ложь;
		КонецПопытки;
		
		ФайлСообщения = Новый Файл(ПолноеИмяФайлаОбменаПриемник);
		Если НЕ (ФайлСообщения.Существует() И ФайлСообщения.ЭтоФайл()) Тогда
			ВызватьИсключение "Не найдено сообщение обмена: " + ПолноеИмяФайлаОбменаПриемник;
			Возврат Ложь;
		КонецЕсли;
		
		Если НРег(Прав(ПолноеИмяФайлаОбменаПриемник, 3)) = "zip" Тогда
			Рез = РаспаковатьПолученныйФайл(ФайлСообщения);
			Если Рез = Ложь Тогда
				Возврат Ложь;
			КонецЕсли;
			ПолноеИмяФайлаОбменаПриемник = ФайлСообщения.ПолноеИмя;
		КонецЕсли;
		
		ПутьФайла=ВРЕГ(ФайлСообщения.Путь);
		Если Прав(ПутьФайла,1) <> "\" И Прав(ПутьФайла,1) <> "/" Тогда
			ПутьФайла = ПутьФайла + Слеш;
		КонецЕсли;
		Если ПутьФайла = ВРЕГ(КаталогФайловСообщений) Тогда
			Рез = Истина;
			ИмяПолученногоФайла = ФайлСообщения.ПолноеИмя;
		Иначе
			// Перемещение готового сообщения в каталог обменов
			Попытка
				ПереместитьФайл(ФайлСообщения.ПолноеИмя,КаталогФайловСообщений+ФайлСообщения.Имя);
				ИмяПолученногоФайла = КаталогФайловСообщений+ФайлСообщения.Имя;
				Рез = Истина;
			Исключение
				ВызватьИсключение "Не удалось доставить файл сообщения <" + ФайлСообщения.ПолноеИмя + "> в каталог <" + КаталогФайловСообщений + "> "+ОписаниеОшибки();
			КонецПопытки;
		КонецЕсли;			
		
		ФайлСообщения = НЕОПРЕДЕЛЕНО;
		
	Исключение
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Ошибка получения файл сообщения <" 
		+ ФайлСообщения.ПолноеИмя + "> из почтового ящика " + НастройкаДоставки.АдресЭлектроннойПочты
		+ "| в каталог <" + КаталогФайловСообщений + "> " + ИнформацияОбОшибке().Описание,, 
		УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Рез = Ложь;
	КонецПопытки;
	
	// ЗАКЛЮЧИТЕЛЬНЫЕ ДЕЙСТВИЯ
	// Очистим почтовый ящик от ненужных писем с сообщениями
	// Доступно только для SMTP/POP3
	Если НастройкаДоставки.СпособОбмена = 2 Тогда
		Попытка	
			Почта.УдалитьСообщения(МассивСообщенийОбмена);
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Удалены неактуальные файлы сообщений  из почтового ящика " + НастройкаДоставки.АдресЭлектроннойПочты,
			,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Исключение КонецПопытки;
	КонецЕсли;
	
	// Отключаемся
	Попытка	Почта.Отключиться();
	Исключение КонецПопытки;
	
	// Локальный временный каталог чистим всегда от наших действий
	МаскаФайловУдаления = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "??????????", "*");
	Файлы = НайтиФайлы(КаталогТемпФайлов, МаскаФайловУдаления);
	Для Каждого Файл Из Файлы Цикл
		Попытка
			УдалитьФайлы(Файл.ПолноеИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Конец получения файла <" + ИмяПолученногоФайла + ", из почтового ящика " + НастройкаДоставки.АдресЭлектроннойПочты + ">",,
	УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	
	Возврат Рез;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДОСТАВКИ СООБЩЕНИЙ ОБМЕНА

// Только загрузка сообщения обмена (полная загрузка - из конечного каталога в текущий узел).
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
// Возвращаемое значение:
// 	Рез - Истина, когда было успешно доставлено сообщение
Функция Доставка_ЗагрузкаСообщенияОбмена(Параметры) Экспорт
	
	Рез = Ложь;
	ИмяФайлаСообщения = Параметры.ИмяФайлаСообщения;
	СтрОшибки = "";
	
	Если НЕ ЗначениеЗаполнено(МодульИнициализирован) Тогда
		СтрОшибки = "Ошибка: обработка доставки не была правильно инициализирована";
		Параметры.Вставить("Ошибка", СтрОшибки);
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", стрОшибки, , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Рез;
	КонецЕсли;
	
	Если НЕ ПроверитьКорректность(СтрОшибки) Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", стрОшибки, , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	Если СпособОбмена = 0 Тогда // локальная сеть
		Рез = ПолучитьФайл_ЛокСеть(ИмяФайлаСообщения);
	ИначеЕсли СпособОбмена = 1 ИЛИ СпособОбмена = 2 Тогда // почта
		Рез = ПолучитьФайл_Почта(ИмяФайлаСообщения);
	ИначеЕсли СпособОбмена = 3 Тогда // FTP
		Рез = ПолучитьФайл_FTP(ИмяФайлаСообщения);
	ИначеЕсли СпособОбмена= 4 Тогда
		Рез = ПолучитьФайл_HTTP(ИмяФайлаСообщения , Параметры);
	КонецЕсли;
	Параметры.Вставить("ИмяФайлаСообщения", ИмяФайлаСообщения);
	
	// Удалим временные файлы, оставшиеся от проверок или неудачного получения.
	#Если Клиент Тогда
		Состояние("Удаляем временные файлы...");
	#КонецЕсли
	Для ИндСтр=1 По СтрЧислоСтрок(ТемпФайлыДляУдаления) Цикл
		ИмяФайла = СтрПолучитьСтроку(ТемпФайлыДляУдаления,ИндСтр);
		Если НЕ ПустаяСтрока(ИмяФайла) Тогда
			Попытка	УдалитьФайлы(ИмяФайла);
			Исключение КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Параметры.Вставить("Результат", Рез);
	Возврат Рез;
КонецФункции

// Только выгрузка сообщения обмена (полная выгрузка - из текущего узла в конечный каталог).
//
// Параметры:
//  ПараметрыОбмена - Произвольный - Параметры обмена.
//  СтрОшибки - Произвольный - Стр ошибки.
//
// Возвращаемое значение:
// 	Рез - Истина, если выгрузка сообщения обмена завершилась удачно
Функция Доставка_ВыгрузкаСообщенияОбмена(ПараметрыОбмена, СтрОшибки="") Экспорт
	
	ИмяФайлаСообщения="";
	Если ПараметрыОбмена.Свойство("ИмяФайлаСообщения") Тогда
		ИмяФайлаСообщения = ПараметрыОбмена.ИмяФайлаСообщения;
	КонецЕсли;
	
	Рез = Ложь;
	
	Если НЕ ЗначениеЗаполнено(МодульИнициализирован) Тогда
		СтрОшибки = "Ошибка: обработка доставки не была правильно инициализирована";
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", стрОшибки, , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Рез;
	КонецЕсли;
	
	Если НЕ ПроверитьКорректность(стрОшибки) Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", стрОшибки, , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	
	// Отправим выбранным способом
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	Если СпособОбмена = 0 Тогда // локальная сеть
		Рез = ОтправитьФайл_ЛокСеть(ИмяФайлаСообщения, ПараметрыОбмена);
	ИначеЕсли СпособОбмена = 1 ИЛИ СпособОбмена = 2 Тогда // почта
		Рез = ОтправитьФайл_Почта(ИмяФайлаСообщения);
	ИначеЕсли СпособОбмена = 3 Тогда // FTP
		Рез = ОтправитьФайл_FTP(ИмяФайлаСообщения);
	ИначеЕсли СпособОбмена = 4 Тогда
		Рез = ОтправитьФайл_HTTP(ИмяФайлаСообщения, ПараметрыОбмена);
	КонецЕсли;
	
	// удалим временные файлы, оставшиеся от проверок или неудачной отправки.
	#Если Клиент Тогда
		Состояние("Удаляем временные файлы...");
	#КонецЕсли
	Для ИндСтр=1 По СтрЧислоСтрок(ТемпФайлыДляУдаления) Цикл
		ИмяФайла = СтрПолучитьСтроку(ТемпФайлыДляУдаления,ИндСтр);
		// Каталог на клиенте. НЕ удаляем файл сообщения из временного каталога сервера, если установлен "Каталог на клиенте".
		// Он будет удален позже, после того, как его переместят на клиент.
		Если НЕ ПустаяСтрока(ИмяФайла) И НЕ(ПараметрыОбмена.НастройкаОбмена.КаталогНаКлиенте И ПараметрыОбмена.НастройкаОбмена.СпособОбмена = 0 И ИмяФайла = ИмяФайлаСообщения) Тогда
			Попытка
				УдалитьФайлы(ИмяФайла);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Если Рез Тогда
		НомерСообщения = ВыделитьНомерСообщения(ИмяФайлаСообщения);
		питОбменДанными.ЗафиксироватьСобытие(	ПрефиксЛога + "Отправка", 
													"Успешно отправлено сообщение" + ?(ЗначениеЗаполнено(НомерСообщения)," № " + НомерСообщения, ""),
													,
													УровеньЖурналаРегистрации.Информация,
													КомментироватьХодОбмена);
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Выполняем инициализацию параметров, необходимых для доставки сообщений.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ИнициализацияПараметров(Параметры="") Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	Параметры.Вставить("РезультатИнициализации", Ложь);
	
	МодульИнициализирован = НЕОПРЕДЕЛЕНО;
	Если НЕ ЗначениеЗаполнено(Параметры) ИЛИ НЕ Параметры.Количество()>0 Тогда 
		Параметры.Вставить("Ошибка", "Не заполнены параметры для доставки сообщений.");
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("УзелОбмена",УзелОбмена)
		И Параметры.Свойство("НастройкаОбмена",НастройкаДоставки)
		И Параметры.Свойство("Комментировать",КомментироватьХодОбмена)
		И Параметры.Свойство("ВестиЖурналРегистрации",ВестиЖурнал)
		Тогда
	Иначе
		Параметры.Вставить("Ошибка", "Недостаточно параметров для инициализации доставки сообщений.");
		Возврат;
	КонецЕсли;
	
	Если НЕ (ЗначениеЗаполнено(УзелОбмена) И ЗначениеЗаполнено(НастройкаДоставки)) Тогда
		Параметры.Вставить("Ошибка", "Не заполнены Узел Обмена и Настройка Доставки для доставки сообщений.");
		Возврат;
	КонецЕсли;
	
	КомментироватьХодОбмена = ?(КомментироватьХодОбмена = неопределено,Истина,КомментироватьХодОбмена);
	
	КорневойКаталог="";
	КаталогТемпФайлов="";
	КаталогФайловСообщений="";
	КаталогОбработанныхСообщений="";
	КаталогОтправленныхСообщений="";
	ПрефиксЛога = "Обмен.Узел_" + СокрЛП(УзелОбмена.Префикс) + ".";
	Параметры.Вставить("ПрефиксЛога", ПрефиксЛога);
	
	Если ТемпФайлыДляУдаления = Неопределено Тогда
		ТемпФайлыДляУдаления = "";
	КонецЕсли; 
	
	Если ПустаяСтрока(КорневойКаталог) Тогда
		КорневойКаталог = НастройкаДоставки.КаталогОбменов;
	КонецЕсли; 
	Если Прав(КорневойКаталог,1) <> "\" И Прав(КорневойКаталог,1) <> "/" Тогда
		КорневойКаталог = КорневойКаталог + Слеш;
	КонецЕсли;
	
	// Каталог на клиенте. В случае, если используется клиентский каталог и в данный момент выполняется операция загрузки,
	// то необходимо подменить значение переменной "КаталогФайловСообщений", 
	// т.к. на данный момент файл уже перемещен с клиента на сервер в каталог временных файлов.
	ЭтоЗагрузка = Ложь;
	Если Параметры.Свойство("ЭтоЗагрузка") Тогда
		ЭтоЗагрузка = Параметры.ЭтоЗагрузка;
	КонецЕсли;
	// Для режима локального каталога делаем проверки. Для остальных(например FTP) не делаем.
	Если НастройкаДоставки.СпособОбмена = 0 Тогда
		Если НастройкаДоставки.КаталогНаКлиенте Тогда
			Если ЭтоЗагрузка Тогда
				КаталогФайловСообщений = КаталогВременныхФайлов();
			Иначе
				КаталогФайловСообщений = КорневойКаталог;
			КонецЕсли;
		Иначе
			СтрОшибка = "";
			Если НЕ ЕстьКаталог(КорневойКаталог, СтрОшибка) Тогда
				Параметры.Вставить("Ошибка", СтрОшибка);
				Возврат;
			КонецЕсли;
			КаталогФайловСообщений = КорневойКаталог;
		КонецЕсли;
	Иначе
		КаталогФайловСообщений = КаталогВременныхФайлов();
	КонецЕсли;
	
	Если НастройкаДоставки.ИспользоватьВременныйКаталог Тогда
		КаталогТемпФайлов = НастройкаДоставки.КаталогВременныхФайлов;
		Если ПустаяСтрока(КаталогТемпФайлов) Тогда
			КаталогТемпФайлов = КаталогВременныхФайлов();
		КонецЕсли; 
	Иначе
		КаталогТемпФайлов = КаталогВременныхФайлов();
	КонецЕсли;
	
	Если НастройкаДоставки.СохранятьОтправленные Тогда
		КаталогОтправленныхСообщений = НастройкаДоставки.КаталогОтправленныхСообщений;
		Если ПустаяСтрока(КаталогОтправленныхСообщений) Тогда
			КаталогОтправленныхСообщений = "";
		КонецЕсли; 
	Иначе
		КаталогОтправленныхСообщений = "";
	КонецЕсли;
	
	Если НастройкаДоставки.СохранятьПолученные Тогда
		КаталогОбработанныхСообщений = НастройкаДоставки.КаталогПолученныхСообщений;
		Если ПустаяСтрока(КаталогОбработанныхСообщений) Тогда
			КаталогОбработанныхСообщений = "";
		КонецЕсли;
	Иначе
		КаталогОбработанныхСообщений = "";
	КонецЕсли;
	
	// Каталог на клиенте. Проверка каталогов если не на клиенте.
	Если НастройкаДоставки.СпособОбмена = 0 И НЕ НастройкаДоставки.КаталогНаКлиенте Тогда
		
		Если  НЕ ЕстьКаталог(КаталогТемпФайлов) Тогда
			КаталогТемпФайлов = "";
		КонецЕсли;
		
		Если  НЕ ЕстьКаталог(КаталогОтправленныхСообщений) Тогда
			КаталогОтправленныхСообщений = "";
		КонецЕсли;
		
		Если  НЕ ЕстьКаталог(КаталогОбработанныхСообщений) Тогда
			КаталогОбработанныхСообщений = "";
		КонецЕсли;
		
	КонецЕсли;
	
	МодульИнициализирован = Истина;
	Параметры.РезультатИнициализации = Истина;
	
КонецПроцедуры	//	ИнициализацияПараметров()

// Сохраняет в лог обработанное сообщение с записью информации об успешности события или нет.
//
// Параметры:
//  ИмяФайлаСообщения - Произвольный - Имя файла сообщения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СохранитьОбработанноеСообщение(ИмяФайлаСообщения)  Экспорт
	
	Рез = Ложь;
	Если ИмяФайлаСообщения = "" Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Файл для сохранения обработанного сообщения не обнаружен <"
			+ КаталогОбработанныхСообщений + ">", , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли; 
	
	// проверка на существование файла-источника
	ФайлИсточник = Новый Файл(ИмяФайлаСообщения);
	Если НЕ ФайлИсточник.Существует() Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Файл для сохранения обработанного сообщения не обнаружен <"
			+ КаталогОбработанныхСообщений + ">", , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	КраткоеИмяФайлаСообщения = ФайлИсточник.Имя;

	ПолноеИмяОтправленногоФайла = КаталогОбработанныхСообщений + КраткоеИмяФайлаСообщения;
	Попытка
		// SUIG делаем именно копирование, если не требуется оставлять последнее принятое сообщение.
		// В корне каталога обменов - тогда ПереместитьФайл.
		КопироватьФайл(ИмяФайлаСообщения, ПолноеИмяОтправленногоФайла);
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", 
			"Сохранена копия файла <" + ПолноеИмяОтправленногоФайла + ">", , 
			УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
		Рез = Истина;
	Исключение
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", "Ошибка при сохранении копии файла <" + ПолноеИмяОтправленногоФайла + ">: "
			+ ИнформацияОбОшибке().Описание, , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Рез = Ложь;
	КонецПопытки;
	
	Возврат Рез;
	
КонецФункции // СохранитьОбработанноеСообщение()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция подключения к почтовым серверам или почтовому
//  клиенту для инициализации переменной "Почта".
//  Возвращает: Соединение с почтой, если не установлено - Неопределено.
//
// Параметры:
//  СтрОшибки - Произвольный - Стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодключитьсяКПочте(СтрОшибки = "")
	Рез = Неопределено;
	
	Если НастройкаДоставки.СпособОбмена = 1 Тогда // MAPI
		#Если Клиент Тогда
			Почта = Новый Почта();
			Попытка
				Почта.Подключиться(); 
				Рез = Почта;
			Исключение
				СтрОшибки = СтрОшибки + "Ошибка при подключении к почтовому профилю пользователя: " + ИнформацияОбОшибке().Описание;
				
				Возврат Рез;
			КонецПопытки;
		#Иначе
			СтрОшибки = СтрОшибки + "Почтовый профиль пользователя недоступен в режиме внешнего соединения или на сервере!";
			
			Возврат рез;
		#КонецЕсли
		
	Иначе // e-Mail
		ПочтовыйПрофиль = Новый ИнтернетПочтовыйПрофиль;
		ПочтовыйПрофиль.АдресСервераPOP3 = НастройкаДоставки.СерверPOP3;
		ПочтовыйПрофиль.ПортPOP3         = НастройкаДоставки.ПортPOP3;
		ПочтовыйПрофиль.Пользователь     = НастройкаДоставки.ПользовательPOP3;
		ПочтовыйПрофиль.Пароль           = НастройкаДоставки.ПарольPOP3;
		ПочтовыйПрофиль.АдресСервераSMTP = НастройкаДоставки.СерверSMTP;
		ПочтовыйПрофиль.ПортSMTP         = НастройкаДоставки.ПортSMTP;
		ПочтовыйПрофиль.ПользовательSMTP = НастройкаДоставки.ПользовательSMTP;
		ПочтовыйПрофиль.ПарольSMTP       = НастройкаДоставки.ПарольSMTP;
		Если НастройкаДоставки.Таймаут > 0 Тогда
			ПочтовыйПрофиль.ВремяОжидания = НастройкаДоставки.Таймаут;
		КонецЕсли; 
		
		Почта = Новый ИнтернетПочта(); 
		Попытка
			Почта.Подключиться(ПочтовыйПрофиль);
			Рез = Почта;
		Исключение 
			СтрОшибки = СтрОшибки + "Ошибка при подключении к почтовому серверу SMTP: " + ИнформацияОбОшибке().Описание;
			
			Возврат Рез; 
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Рез;
КонецФункции	//	ПодключитьсяКПочте()


// Функция подключения к FTP
//
// Параметры:
//  СтрОшибки - Произвольный - Стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодключитьсяКFTP(СтрОшибки = "")
	FTP = Неопределено;
	
	// Получаем параметры
	Попытка
		Сервер = НастройкаДоставки.СерверFTP;
		Порт = НастройкаДоставки.ПортFTP;
		Логин = НастройкаДоставки.ПользовательFTP;
		Пароль = НастройкаДоставки.ПарольFTP;
		ПассивныйРежим = НастройкаДоставки.ПассивныйРежим;
	Исключение
		СтрОшибки = СтрОшибки + "Некорректные параметры FTP: " + ИнформацияОбОшибке().Описание;
		Возврат неопределено;
	КонецПопытки;
	
	// Проверим реквизиты подключения к FTP
	Если FTP = НЕОПРЕДЕЛЕНО  Тогда 
		#Если Клиент Тогда
			Состояние("Попытка подключения к FTP...");
		#КонецЕсли
		Попытка 
			FTP = Новый FTPСоединение(Сервер, 
			Порт, 
			Логин, 
			Пароль,
			, 
			ПассивныйРежим);
			#Если Клиент Тогда
				Состояние("Попытка подключения к FTP - ОК");
			#КонецЕсли
		Исключение
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			Если Найти(ВРег(ТекстОшибки),ВРег("couldn't connect to server")) Тогда
				ТекстОшибки = " на указанном сервере не запущен FTP-сервер";
			ИначеЕсли Найти(ВРег(ТекстОшибки),ВРег("couldn't resolve host name")) Тогда 	
				ТекстОшибки = " указанный сервер не доступен";
			КонецЕсли; 
			стрОшибки = стрОшибки + "Ошибка подключения к FTP серверу <ftp://" + НастройкаДоставки.СерверFTP + ">: " + ТекстОшибки;
			Возврат неопределено;
		КонецПопытки;
	КонецЕсли;
	
	// Проверим существование "нашего" каталога 		
	Попытка 
		#Если Клиент Тогда
			Состояние("Попытка установить каталог на FTP...");
		#КонецЕсли
		КаталогОбменаFTP = "";
		Если Прав(НастройкаДоставки.КаталогОбменаFTP,1) <> "/" Тогда
			КаталогОбменаFTP = НастройкаДоставки.КаталогОбменаFTP + "/";
		КонецЕсли;
		FTP.УстановитьТекущийКаталог(КаталогОбменаFTP);
	Исключение
		#Если Клиент Тогда
			Состояние("Попытка создать каталог на FTP...");
		#КонецЕсли
		КаталогОбменаFTP = НастройкаДоставки.КаталогОбменаFTP;
		Попытка // Пробуем создать "нужный" каталог
			FTP.СоздатьКаталог(КаталогОбменаFTP);
			FTP.УстановитьТекущийКаталог(КаталогОбменаFTP);
		Исключение
			СтрОшибки = "Ошибка: не удалось создать на FTP заданный каталог обмена """ + КаталогОбменаFTP + """";
			Возврат неопределено;
		КонецПопытки;
	КонецПопытки;
	
	#Если Клиент Тогда
		Состояние("Проверяем текущий каталог на FTP...");
	#КонецЕсли
	СтрТекущийКаталог = FTP.ТекущийКаталог();
	Если Прав(СтрТекущийКаталог,1) <> "/" Тогда
		СтрТекущийКаталог = СтрТекущийКаталог + "/";
	КонецЕсли;
	Если Лев(КаталогОбменаFTP,1) <> "/" Тогда
		КаталогОбменаFTP = "/" + КаталогОбменаFTP;
	КонецЕсли;
	Если ВРЕГ(СтрТекущийКаталог) = ВРЕГ(КаталогОбменаFTP) Тогда
		#Если Клиент Тогда
			Состояние("Проверяем текущий каталог на FTP - ОК");
		#КонецЕсли
		Возврат FTP;
	Иначе
		#Если Клиент Тогда
			Состояние("Проверяем текущий каталог на FTP - Ошибка!");
		#КонецЕсли
		СтрОшибки = "Ошибка: не удалось установить на FTP в качестве текущего заданный каталог обмена """ + КаталогОбменаFTP + """";
		Возврат неопределено;
	КонецЕсли;
	
КонецФункции

// Выполняет архивацию файла обмена
//
// Параметры:
//  ФайлСообщения - Файл - сообщение для упаковк.
//
// Возвращаемое значение:
// 	Рез - Флаг успешного выполнения архивации
Функция ЗапаковатьОтправляемыйФайл(ФайлСообщения)
	Рез = Ложь;
	// Сначала почистим временный каталог от прошлых архивов
	СтарыеФайлы = НайтиФайлы(КаталогТемпФайлов + ФайлСообщения.ИмяБезРасширения + ".zip");
	Для Каждого СтарыйФайл Из СтарыеФайлы Цикл
		УдалитьФайлы(СтарыйФайл.ПолноеИмя);
	КонецЦикла;
	
	Попытка
		ИмяФайлаZIP = ФайлСообщения.ИмяБезРасширения + ".zip";
		ПолноеИмяФайлаZIP = КаталогТемпФайлов + ИмяФайлаZIP;
		
		ФайлZIP = Новый ЗаписьZipФайла(ПолноеИмяФайлаZIP,НастройкаДоставки.ПарольАрхивации);
		ФайлZIP.Добавить(ФайлСообщения.ПолноеИмя);
		#Если Клиент Тогда
			Состояние("Упаковка файла сообщения в ZIP-архив...");
		#КонецЕсли
		ФайлZIP.Записать();
		#Если Клиент Тогда
			Состояние("Упаковка файла сообщения в ZIP-архив - Ок");
		#КонецЕсли
		ФайлZIP = Неопределено;
		
	Исключение
		СтрСообщения = "Не удалось запаковать файл <" + ФайлСообщения.ПолноеИмя + "> в каталог <" + КаталогТемпФайлов + "> " + ОписаниеОшибки();
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", СтрСообщения,, УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецПопытки;
	
	// Пробуем найти результат
	ФайлСообщения = Новый Файл(ПолноеИмяФайлаZIP);
	Если НЕ (ФайлСообщения.Существует() И ФайлСообщения.ЭтоФайл()) Тогда
		СтрСообщения = "Не удалось запаковать файл обмена  <" + ФайлСообщения.ПолноеИмя + ">";
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", СтрСообщения,, УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	Иначе
		Рез = Истина;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Выполняет распаковку файла сообщения
//  Параметры
//
// Параметры:
//  ФайлСообщения - Произвольный - Файл сообщения.
//
// Возвращаемое значение:
//   Рез   – флаг успешного завершения распаковки
Функция РаспаковатьПолученныйФайл(ФайлСообщения)
	Рез = Ложь;
	// Почистим временный каталог от прошлых попыток распаковки
	СтарыеФайлы = НайтиФайлы(КаталогТемпФайлов + ФайлСообщения.ИмяБезРасширения + ".xml");
	Для Каждого СтарыйФайл Из СтарыеФайлы Цикл
		УдалитьФайлы(СтарыйФайл.ПолноеИмя);
	КонецЦикла;
	Попытка // Попытка распаковать
		ФайлZIP = Новый ЧтениеZipФайла(ФайлСообщения.ПолноеИмя,НастройкаДоставки.ПарольАрхивации);
		#Если Клиент Тогда
			Состояние("Распаковка ZIP-архива...");
		#КонецЕсли
		ФайлZIP.ИзвлечьВсе(КаталогТемпФайлов);
		ФайлZIP.Закрыть();
		#Если Клиент Тогда
			Состояние("Распаковка ZIP-архива - ОК");
		#КонецЕсли
	Исключение
		СтрСообщения = "Не удалось распаковать файл <" + ФайлСообщения.ПолноеИмя + "> в каталог <" + КаталогТемпФайлов + "> " + ОписаниеОшибки();
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецПопытки;
	
	// Попробуем найти результат
	ФайлСообщения = Новый Файл(КаталогТемпФайлов + ФайлСообщения.ИмяБезРасширения + ".xml");
	Если НЕ (ФайлСообщения.Существует() И ФайлСообщения.ЭтоФайл()) Тогда
		СтрСообщения = "Не удалось распаковать файл обмена  <" + ФайлСообщения.ПолноеИмя + ">";
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	Иначе
		Рез = Истина;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции // РаспаковатьФайлСообщения()

