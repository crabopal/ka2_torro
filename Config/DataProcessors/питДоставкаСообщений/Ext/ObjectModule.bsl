// ПРОЦЕДУРЫ И ФУНКЦИИ ПЕРЕМЕЩЕНИЯ ФАЙЛОВ ДЛЯ РАЗЛИЧНЫХ СПОСОБОВ ДОСТАВКИ

// Функция публикации файла с сообщением обмена
//
// Параметры:
//  ИмяОтправляемогоФайла - Произвольный - Имя отправляемого файла.
//  ПараметрыОбмена - Произвольный - Параметры обмена.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОтправитьФайл_ЛокСеть(ИмяОтправляемогоФайла = "", ПараметрыОбмена)
	
	// ПРОВЕРКИ
	Рез = Ложь; // инициализация результата
	
	// Проверка на существование файла-источника в выбранном каталоге
	ФайлИсточник = Новый Файл(ИмяОтправляемогоФайла);
	Если НЕ ФайлИсточник.Существует() Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка",
		"Файл сообщения не обнаружен <" + ИмяОтправляемогоФайла + ">",
		,
		УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	
	// В массив для удаления
	ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяОтправляемогоФайла;
	
	// Каталог на клиенте.
	Если ПараметрыОбмена.НастройкаОбмена.СпособОбмена = 0 И НЕ ПараметрыОбмена.НастройкаОбмена.КаталогНаКлиенте Тогда
		// Проверка на существование каталога приемника (корневой каталог)
		Если НайтиФайлы(КаталогФайловСообщений).Количество() = 0 Тогда
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Каталог локальной сети не обнаружен <"
			+ КаталогФайловСообщений + ">", , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
			Возврат Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	// ОТПРАВКА
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Начало отправки файла <" + ИмяОтправляемогоФайла + ">",,
	УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
	
	// Определим полное имя файла-приемника
	ИмяФайлаСообщения = ФайлИсточник.Имя;
	ПолноеИмяФайлаОбменаПриемник = КаталогФайловСообщений + ИмяФайлаСообщения;
	
	Если НастройкаДоставки.АрхивироватьСообщенияОбмена Тогда
		ПолноеИмяФайлаОбменаПриемник = КаталогФайловСообщений + ФайлИсточник.ИмяБезРасширения + ".zip";
		Рез = ЗапаковатьОтправляемыйФайл(ФайлИсточник);
		Если Рез = Ложь Тогда
			Возврат Рез;
		КонецЕсли;
		ИмяОтправляемогоФайла = ФайлИсточник.ПолноеИмя; // теперь это zip вместо xml
	КонецЕсли;
	
	// перемещение из темп-каталога в каталог отправленных сообщений (tmp в xml).
	Если НастройкаДоставки.СохранятьОтправленные Тогда 
		Если НастройкаДоставки.АрхивироватьСообщенияОбмена Тогда
			ПолноеИмяОтправленногоФайла = КаталогОтправленныхСообщений + ФайлИсточник.ИмяБезРасширения + ".zip";
		Иначе
			ПолноеИмяОтправленногоФайла = КаталогОтправленныхСообщений + ФайлИсточник.ИмяБезРасширения + ".xml";
		КонецЕсли; 
		
		Попытка
			КопироватьФайл(ИмяОтправляемогоФайла, ПолноеИмяОтправленногоФайла);
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Сохранена копия файла <" + ПолноеИмяОтправленногоФайла + ">",
				, УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Исключение
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при сохранении копии файла <" + ПолноеИмяОтправленногоФайла + ">: "
				+ ИнформацияОбОшибке().Описание, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		КонецПопытки;
	КонецЕсли;
	
	// Копируем файл в каталог, определенный для данного узла.
	// Если необходимо, делаем копию уже отправленного сообщения.
	Попытка
		
		// Каталог на клиенте. Перемещаем файл только есть каталог серверный, иначе в параметры добавляем имя файла.
		Если НЕ (ПараметрыОбмена.НастройкаОбмена.КаталогНаКлиенте И ПараметрыОбмена.НастройкаОбмена.СпособОбмена = 0) Тогда
			// Копирование из временного каталога в каталог-приемник
			ПереместитьФайл(ИмяОтправляемогоФайла, ПолноеИмяФайлаОбменаПриемник);  // файл отправлен
			
		Иначе
			
			// Пишем имя файла приемника, может пригодиться
			Если ПараметрыОбмена.Свойство("ПолноеИмяФайлаОбменаПриемник") Тогда
				ПараметрыОбмена.ПолноеИмяФайлаОбменаПриемник = ПолноеИмяФайлаОбменаПриемник;
			Иначе
				ПараметрыОбмена.Вставить("ПолноеИмяФайлаОбменаПриемник", ПолноеИмяФайлаОбменаПриемник);
			КонецЕсли;
			
			// Пишем имя файла отправляемого, может пригодиться
			Если ПараметрыОбмена.Свойство("ИмяОтправляемогоФайла") Тогда
				ПараметрыОбмена.ИмяОтправляемогоФайла = ИмяОтправляемогоФайла;
			Иначе
				ПараметрыОбмена.Вставить("ИмяОтправляемогоФайла", ИмяОтправляемогоФайла);
			КонецЕсли;
			
		КонецЕсли;
		
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Успешно отправлен файл <" + ИмяОтправляемогоФайла + "> в локальный каталог <" + КаталогФайловСообщений + ">",
		,УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
		Рез = Истина;
	Исключение
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка отправки файла  <" + ИмяОтправляемогоФайла + "> в локальный каталог <" + КаталогФайловСообщений + ">: "
		+ ИнформацияОбОшибке().Описание, , УровеньЖурналаРегистрации.Ошибка,КомментироватьХодОбмена);
		Рез = Ложь;
	КонецПопытки;
	
	// Локальный временный каталог чистим всегда от ВСЕХ наших действий (в том числе и следы архивации).
	// Для локальной сети копии не нужны - чистим сразу.
	МаскаФайловУдаления = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "??????????", "*");
	Файлы = НайтиФайлы(КаталогТемпФайлов, МаскаФайловУдаления);
	Для Каждого Файл Из Файлы Цикл
		Попытка
			УдалитьФайлы(Файл.ПолноеИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Конец отправки файла <" + ИмяОтправляемогоФайла + ">",,
	УровеньЖурналаРегистрации.Информация);
	
	Возврат Рез;
	
КонецФункции // ОтправитьФайл_ЛокСеть()

// Функция публикации файла с сообщением обмена
//
// Параметры:
//  ИмяОтправляемогоФайла - Произвольный - Имя отправляемого файла.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОтправитьФайл_FTP(ИмяОтправляемогоФайла = "")
	
	// ПРОВЕРКИ
	
	// Проверка на существование файла-источника
	ФайлИсточник = Новый Файл(ИмяОтправляемогоФайла);
	Если НЕ ФайлИсточник.Существует() Тогда
		питОбменДанными.зафиксироватьСобытие(ПрефиксЛога + "Отправка", "Файл сообщения не обнаружен <" + ИмяОтправляемогоФайла + ">",,
		УровеньЖурналаРегистрации.Ошибка,,,КомментироватьХодОбмена);
		Возврат Ложь;
	КонецЕсли;
	ПолноеИмяИсходногоФайла = ФайлИсточник.ПолноеИмя;
	ИмяИсходногоФайла = ФайлИсточник.Имя;
	// В массив для удаления
	ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяОтправляемогоФайла;
	
	Если НастройкаДоставки.АрхивироватьСообщенияОбмена Тогда
		Рез = ЗапаковатьОтправляемыйФайл(ФайлИсточник); // теперь это zip
		Если Рез = Ложь Тогда
			Возврат Рез;
		КонецЕсли;
		ИмяОтправляемогоФайла = ФайлИсточник.ПолноеИмя;
		// В массив для удаления
		ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяОтправляемогоФайла;
	КонецЕсли;
	
	// Транслит
	Транслит = НастройкаДоставки.ВыполнятьТранслитерацию;
	ИмяФайлаСообщения = ФайлИсточник.Имя;
	Если Транслит Тогда
		ИмяФайлаСообщения = питОбменДанными.ВыполнитьТранслит(ИмяФайлаСообщения);
	КонецЕсли;
	
	КаталогОбменаFTP = НастройкаДоставки.КаталогОбменаFTP;
	Если Прав(КаталогОбменаFTP,1) <> "/" Тогда
		КаталогОбменаFTP = КаталогОбменаFTP + "/";
	КонецЕсли;
	Если Лев(КаталогОбменаFTP,1) <> "/" Тогда
		КаталогОбменаFTP = "/" + КаталогОбменаFTP;
	КонецЕсли;
	ПолноеИмяФайлаОбменаПриемник = КаталогОбменаFTP + ИмяФайлаСообщения;
	
	// Каталог-источник на FTP - еще раз проверили (с момента последней проверки связь могла пропасть).
	СтрОшибкиFTP = "";
	FTP = ПодключитьсяКFTP(СтрОшибкиFTP);
	Если FTP = Неопределено Тогда
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", СтрОшибкиFTP,,	УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		СтрОшибки = СтрОшибки + СтрОшибкиFTP + Символы.ПС;
		Возврат Ложь;
	КонецЕсли;
	
	// ОТПРАВКА
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Начало отправки файла <" + ИмяОтправляемогоФайла + ">",,
		УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	Рез = Ложь;
	
	// Пишем в каталог обмена файл
	Попытка
		FTP.Записать(ИмяОтправляемогоФайла, ПолноеИмяФайлаОбменаПриемник);
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Отправлен файл на <ftp://" + НастройкаДоставки.СерверFTP  + ПолноеИмяФайлаОбменаПриемник + ">",
			, УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Рез = Истина; // Отправили
	Исключение
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка отправки файла на <ftp://" + НастройкаДоставки.СерверFTP + ПолноеИмяФайлаОбменаПриемник + ">: "
			+ ИнформацияОбОшибке().Описание, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		Рез = Ложь;
	КонецПопытки;
	
	Если Рез Тогда // Почистим файлы устаревших сообщений, если есть
		НомерОтправленного = ВыделитьНомерСообщения(ПолноеИмяФайлаОбменаПриемник);
		МаскаФайловУдаления = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Истина, "??????????", "*", , Транслит);
		FTPФайлыДляУдаления = FTP.НайтиФайлы(КаталогОбменаFTP, МаскаФайловУдаления);
		Для Каждого FTPФайл Из FTPФайлыДляУдаления Цикл
			ИмяFTPФайла = FTPФайл.Имя;
			ПозРазделителя = Найти(ИмяFTPФайла,".");
			Номер = ВыделитьНомерСообщения(ИмяFTPФайла);
			Если Номер < НомерОтправленного Тогда
				Попытка // Пытаемся удалить файл со старыми сообщением
					FTP.Удалить(FTPФайл.ПолноеИмя, );
					СтрСообщения = "Удалено устаревшее сообщение <" + ИмяFTPФайла + ">";
					питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
				Исключение
					СтрОшибкиFTP = ОписаниеОшибки();
					СтрСообщения = "Ошибка удаления устаревшего сообщения <" + ИмяFTPФайла + "> - "+СтрОшибкиFTP;
					питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Предупреждение, КомментироватьХодОбмена);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Перемещение из временного каталога в каталог отправки сообщений
	Если Рез И НастройкаДоставки.СохранятьОтправленные Тогда 
		Попытка
			ПолноеИмяОтправленногоФайла = КаталогОтправленныхСообщений + ИмяИсходногоФайла;
			ПереместитьФайл(ПолноеИмяИсходногоФайла, ПолноеИмяОтправленногоФайла);
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Сохранена копия файла <" + ПолноеИмяОтправленногоФайла + ">",,
				УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
		Исключение
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", "Ошибка при сохранении копии файла <" + ПолноеИмяОтправленногоФайла + ">: "
			+ ИнформацияОбОшибке().Описание, , УровеньЖурналаРегистрации.Ошибка, КомментироватьХодОбмена);
		КонецПопытки;
	КонецЕсли;
	
	// Локальный временный каталог чистим всегда от ВСЕХ наших действий (в том числе и следы архивации).
	МаскаФайловУдаления = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "??????????", "*");
	Файлы = НайтиФайлы(КаталогТемпФайлов, МаскаФайловУдаления);
	Для Каждого Файл Из Файлы Цикл
		Попытка
			УдалитьФайлы(Файл.ПолноеИмя);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	FTP = Неопределено;
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", 
	"Конец отправки файла <" + ИмяОтправляемогоФайла + ">",
	,
	УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	
	Возврат Рез;
	
КонецФункции // ОтправитьФайл_FTP()

// Функция получения файла с новым сообщением обмена
//  В указанный файл ищет и копирует  файл с последним сообщением обмена
//
// Параметры:
//  ИмяПолученногоФайла - Произвольный - Имя полученного файла.
//
// Возвращаемое значение:
//  Булево - Истина - если файл с сообщением обмена получен, Ложь - в противном случае
Функция ПолучитьФайл_ЛокСеть(ИмяПолученногоФайла = "")
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	СтрСообщения = "Начало получения файла из локального каталога <" + КаталогФайловСообщений + ">";
	питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация, КомментироватьХодОбмена);
	
	// Получаем маску для поиска файлов с сообщениями обмена
	МаскаФайловИсточник = питОбменДанными.ИмяФайлаДоставки(УзелОбмена, Ложь, "*", "*"); 
	
	// получим ожидаемое имя файла для приема
	ОжидаемоеИмяФайла = питОбменДанными.ИмяФайлаДоставки(УзелОбмена,Ложь,Неопределено,"*", ,Ложь);
	ОжидаемоеИмяФайла = Лев(ОжидаемоеИмяФайла,Найти(ОжидаемоеИмяФайла,".")-1);
	ОжидаемоеИмяФайлаСРасширением = ОжидаемоеИмяФайла + ".xml";
	
	#Если Клиент Тогда
		Состояние("Ждите. Идет получение файла обмена ...");
	#КонецЕсли
	ПолноеИмяФайлаОбменаИсточник = "";
	ИмяФайлаОбменаИсточник = "";
	ИмяСМаксНомером = "";
	
	// Отбираем файл с максимальным номером в имени в каталоге-источнике.
	Файлы = НайтиФайлы(КаталогФайловСообщений, МаскаФайловИсточник);
	Для Каждого Файл Из Файлы Цикл
		
		ТекНомерСообщения = ВыделитьНомерСообщения(Файл.ИмяБезРасширения);
		ОжидаемыйНомерСообщения = ВыделитьНомерСообщения(ОжидаемоеИмяФайла);
		МаксНомерСообщения = ВыделитьНомерСообщения(ИмяСМаксНомером);
		
		Если ВРег(Файл.Расширение) <> ".XML" И ВРег(Файл.Расширение) <> ".ZIP" Тогда
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> имеет некорректное расширение (" + СокрЛП(ВРег(Файл.Расширение))
			+ ") и будет удален.";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
			
			Продолжить;
			
		КонецЕсли; 
		
		Если ТекНомерСообщения < ОжидаемыйНомерСообщения Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. "
			+ "Ожидаемый файл - <" + ОжидаемоеИмяФайлаСРасширением + ">.";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
			
			Продолжить;
		КонецЕсли;
		
		Если (МаксНомерСообщения > 0) И (ТекНомерСообщения < МаксНомерСообщения) Тогда  // Это устаревшие сообщения, сразу пропускаем их обработку
			ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + Файл.ПолноеИмя;
			СтрСообщения = "Файл обмена <" + Файл.Имя + "> устарел и будет удален. "
			+ "Актуальный файл - <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ПолноеИмяФайлаОбменаИсточник) + ">.";
			питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
			Продолжить;
		КонецЕсли;
		
		Если ТекНомерСообщения > МаксНомерСообщения Тогда
			// Не успели его прочитать как оно уже устарело (прислали с еще бОльшим номером).
			Если НЕ ПустаяСтрока(ПолноеИмяФайлаОбменаИсточник) Тогда
				ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ПолноеИмяФайлаОбменаИсточник; // Предыдущего кандидата переносим в черный список
				
				СтрСообщения = "Файл обмена <" + питОбменДанными.ПолучитьИмяФайлаИзПолногоПути(ПолноеИмяФайлаОбменаИсточник) 
				+ "> устарел и будет удален. Актуальный файл - <" + Файл.Имя + ">.";
				питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
				
			КонецЕсли;
			ПолноеИмяФайлаОбменаИсточник = Файл.ПолноеИмя;	// Здесь теперь запоминаем нового кандидата
			ИмяСМаксНомером = Файл.ИмяБезРасширения;		// Номер изменим для следующих сравнений
		КонецЕсли;
		
	КонецЦикла;
	
	Рез = Ложь;
	
	ПолноеИмяФайлаОбменаПриемник = ПолноеИмяФайлаОбменаИсточник; // это один и тот же файл
	Если ПустаяСтрока(ПолноеИмяФайлаОбменаИсточник) Тогда
		СтрСообщения = "Не найдено сообщение обмена в локальном каталоге <" + КаталогФайловСообщений + ">";
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
		Возврат Истина; // Сообщение не найдено
	КонецЕсли;
	
	
	ФайлСообщения = Новый Файл(ПолноеИмяФайлаОбменаПриемник);
	Если НЕ (ФайлСообщения.Существует() И ФайлСообщения.ЭтоФайл()) Тогда
		СтрСообщения = "Не найдено сообщение обмена: " + ПолноеИмяФайлаОбменаПриемник + " в локальном каталоге <" + КаталогФайловСообщений + ">";
		питОбменДанными.ЗафиксироватьСобытие(ПрефиксЛога + "Получение", СтрСообщения,, УровеньЖурналаРегистрации.Информация,КомментироватьХодОбмена);
		Возврат Истина;
	КонецЕсли;
	
	Если НРег(Прав(ПолноеИмяФайлаОбменаПриемник, 3)) = "zip" Тогда
		Рез = РаспаковатьПолученныйФайл(ФайлСообщения);
		Если Рез = Ложь Тогда
			Возврат Рез;
		КонецЕсли;
		ПолноеИмяФайлаОбменаПриемник = ФайлСообщения.ПолноеИмя; // Теперь это xml вместо zip
	КонецЕсли;
	
	ПутьФайла=ВРЕГ(ФайлСообщения.Путь);
	Если Прав(ПутьФайла,1) <> "\" И Прав(ПутьФайла,1) <> "/" Тогда
		ПутьФайла = ПутьФайла + Слеш;
	КонецЕсли;
	
	Рез = Истина; 
	ИмяПолученногоФайла = ФайлСообщения.ПолноеИмя;
	
	СтрСообщения = "Конец получения файла сообщения <" + ФайлСообщения.ПолноеИмя + "> из локального каталога <" + КаталогФайловСообщений + ">";
	
	Возврат Рез;
	
КонецФункции // ПолучитьФайлОбмена(ИмяФайла)

// Получает номер сообщения обмена по имени файла
//  Параметры
//
// Параметры:
//  ИмяФайла - Произвольный - Имя файла.
//  Тип - Произвольный - Тип.
//
// Возвращаемое значение:
// 	Число. Номер сообщения обмена
Функция ВыделитьНомерСообщения(ИмяФайла, Тип = "Число")
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		НомерСообщения = 0;
		Возврат НомерСообщения;
	КонецЕсли; 
	
	Колво = СтрДлина(ИмяФайла);
	НомерСообщения = "";
	ФлагНачалосьВыделение = Ложь;
	
	Для НомерСимвола = 0 По Колво - 1 Цикл
		
		ТекСимвол = Сред(ИмяФайла, Колво - НомерСимвола, 1);
		
		Если Найти("0123456789", ТекСимвол) > 0 Тогда
			ФлагНачалосьВыделение = Истина;
			НомерСообщения = ТекСимвол + НомерСообщения;
			
		ИначеЕсли ФлагНачалосьВыделение Тогда
			// цифры закончились
			Прервать;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если Тип = "Число" Тогда 
		Возврат Число(НомерСообщения);
	ИначеЕсли Тип = "Строка" Тогда 
		Возврат НомерСообщения;
	КонецЕсли;
	
КонецФункции // ВыделитьНомерСообщения()

#КонецОбласти

#Область Инициализация

МодульИнициализирован = НЕОПРЕДЕЛЕНО;
ПрефиксЛога = "Обмен.";

#КонецОбласти

#КонецЕсли




