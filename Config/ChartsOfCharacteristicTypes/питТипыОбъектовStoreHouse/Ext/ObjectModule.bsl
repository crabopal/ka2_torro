#Область ПрограммныйИнтерфейс
// Модуль ПВХ ТипыОбъектовRKeeper

////////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ ОБЪЕКТА



////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ МЕТОДОВ ОБЪЕКТА
 
 
// Заполняет предопределенные элементы
//
// Параметры:
//	ЗаполнятьВсе - Булево
//
Процедура ЗаполнитьПредопределенныеЭлементы(ЗаполнятьВсе = Ложь) Экспорт
	Макет = ПланыВидовХарактеристик.питТипыОбъектовRKeeper.ПолучитьМакет("НастройкиПоУмолчанию");
	Если Макет = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не обнаружен макет начальных настроек!"; 
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		// Считаем из макета Имя, Наименование, Код, ЗапретитьПереплатуПоСделкам, Дебетовый, Кредитовый.
		СтрИмя = СокрЛП(Макет.Область(НомерСтроки,1).Текст);
		СтрНаименование = СокрЛП(Макет.Область(НомерСтроки,2).Текст);
		СтрКод = СокрЛП(Макет.Область(НомерСтроки,3).Текст);
		СтрСлужебныйКаталог = СокрЛП(Макет.Область(НомерСтроки,5).Текст);
		СтрСоздавать =	СокрЛП(Макет.Область(НомерСтроки,6).Текст);
		СтрОбновлять =	СокрЛП(Макет.Область(НомерСтроки,7).Текст);
		СтрОбработкаОшибок = СокрЛП(Макет.Область(НомерСтроки,8).Текст);
		СсылкаТипОбъекта = ПланыВидовХарактеристик.питТипыОбъектовRKeeper[СтрИмя];
		Если СсылкаТипОбъекта.Пустая() Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Ошибка при заполнении типа сделки: '" + СтрНаименование + "'. Указан отсутствующий элемент ПВХ Типы объектов R-Keeper!"; 
			Сообщение.Сообщить();
			Продолжить;
		Иначе
			ОбъектТипОбъекта = СсылкаТипОбъекта.ПолучитьОбъект();
		КонецЕсли;
		// Заполняем реквизиты.
		Если ЗаполнятьВсе Тогда
			ОбъектТипОбъекта.Наименование = СтрНаименование;
		ИначеЕсли Не ЗначениеЗаполнено(ОбъектТипОбъекта.Наименование) Тогда
			ОбъектТипОбъекта.Наименование = СтрНаименование;
		КонецЕсли;
		ОбъектТипОбъекта.СлужебныйКаталог = Справочники[СтрИмя].НайтиПоНаименованию(СтрСлужебныйКаталог,Истина);
		
		
		СоздаватьОбъекты = ?(СтрСоздавать = "Истина",Истина,Ложь);
		Если ОбъектТипОбъекта.Создавать <>СоздаватьОбъекты Тогда
			ОбъектТипОбъекта.Создавать = СоздаватьОбъекты;
		КонецЕсли;
		ОбновлятьОбъекты = ?(СтрОбновлять = "Истина",Истина,Ложь);
		Если ОбъектТипОбъекта.Обновлять <>ОбновлятьОбъекты Тогда
			ОбъектТипОбъекта.Обновлять = ОбновлятьОбъекты;
		КонецЕсли;
		ОбработкаОшибокОбъектов = Число(СтрОбработкаОшибок);
		Если ОбъектТипОбъекта.ОбработкаОшибок <>ОбработкаОшибокОбъектов Тогда
			ОбъектТипОбъекта.ОбработкаОшибок = ОбработкаОшибокОбъектов;
		КонецЕсли;
		// Если что-то изменили, то записываем.
		Если ОбъектТипОбъекта.Модифицированность() Тогда
			Попытка		
				ОбъектТипОбъекта.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // ЗаполнитьПредопределенныеЭлементы()

#КонецОбласти

     
