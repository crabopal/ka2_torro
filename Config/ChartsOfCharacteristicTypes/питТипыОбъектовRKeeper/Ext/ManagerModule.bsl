
#Область ПрограммныйИнтерфейс
// Получает ссылку на ПВХ по типу передаваемого значения
//
// Параметры:
//  ИмяМетаданных	 - Произвольный	 - Имя.
//  КэшТаблица		 - Произвольный	 - Кэш таблица.
// 
// Возвращаемое значение:
//   Произвольный - Результат обработки.
//
//
Функция ПолучитьОбъектПоМетаданным(ИмяМетаданных, КэшТаблица = Неопределено) Экспорт
	
	// Кэширование для многократных вызовов.
	Если НЕ КэшТаблица = Неопределено Тогда
		НайденныйКэш = КэшТаблица.НайтиСтроки(Новый Структура("ИмяМетаданных",ИмяМетаданных));
		Если НайденныйКэш.Количество() Тогда
			Возврат НайденныйКэш[0].СсылкаНаПВХ;
		КонецЕсли;
	Иначе
		КэшТаблица = Новый ТаблицаЗначений;
		КэшТаблица.Колонки.Добавить("ИмяМетаданных");
		КэшТаблица.Колонки.Добавить("СсылкаНаПВХ");
	КонецЕсли;
	
	Попытка
		МетаданныеСправочника = Метаданные.Справочники[ИмяМетаданных];
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка." + ИмяМетаданных, , );
	Исключение
		МетаданныеСправочника = Метаданные.Перечисления[ИмяМетаданных];
		ОписаниеТипа = Новый ОписаниеТипов("ПеречислениеСсылка." + ИмяМетаданных, , );
	КонецПопытки;
	// Выберем все элементы.
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТипыОбъектовRKeeper.Ссылка,
	                      |	ТипыОбъектовRKeeper.ТипЗначения
	                      |ИЗ
	                      |	ПланВидовХарактеристик.питТипыОбъектовRKeeper КАК ТипыОбъектовRKeeper");
	ТаблицаТипов = Запрос.Выполнить().Выгрузить();
	СтрокаТипа = ТаблицаТипов.Найти(ОписаниеТипа,"ТипЗначения");
	
	Если СтрокаТипа <> Неопределено Тогда
		
		// Кэширование для многократных вызовов.
		НовКэш = КэшТаблица.Добавить();
		НовКэш.ИмяМетаданных	= ИмяМетаданных;
		НовКэш.СсылкаНаПВХ		= СтрокаТипа.Ссылка;
		
		Возврат СтрокаТипа.Ссылка;
	Иначе
		// Добавим новый.
		НовыйОбъект = ПланыВидовХарактеристик.питТипыОбъектовRKeeper.СоздатьЭлемент();
		
		НовыйОбъект.Обновлять = Истина;
		НовыйОбъект.Создавать = Истина;
		НовыйОбъект.ОбработкаОшибок = 0;
		
		НовыйОбъект.Наименование = МетаданныеСправочника.Синоним;
		НовыйОбъект.ТипЗначения = ОписаниеТипа;
		Попытка
			НовыйОбъект.Записать();
		Исключение
		КонецПопытки;
		
		// Кэширование для многократных вызовов.
		НовКэш = КэшТаблица.Добавить();
		НовКэш.ИмяМетаданных	= ИмяМетаданных;
		НовКэш.СсылкаНаПВХ		= НовыйОбъект.Ссылка;
		
		Возврат НовыйОбъект.Ссылка;
	КонецЕсли;
	
КонецФункции // ЗаполнитьПредопределенныеЭлементы()

#КонецОбласти
