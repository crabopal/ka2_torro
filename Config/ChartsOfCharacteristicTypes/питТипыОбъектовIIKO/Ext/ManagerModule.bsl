
#Область ПрограммныйИнтерфейс
// Получает ссылку на ПВХ по типу передаваемого значения
//
// Параметры:
//  ИмяМетаданных	 - Произвольный	 - Имя метаданных.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьОбъектПоМетаданнымНеПредопределенный(ИмяМетаданных) Экспорт
	Попытка
		Если Найти(ИмяМетаданных,"Фронта") ИЛИ Найти(ИмяМетаданных,"Рецептура") Тогда
			МетаданныеСправочника = Метаданные.Документы[ИмяМетаданных];
			ОписаниеТипа = Новый ОписаниеТипов("ДокументСсылка." + ИмяМетаданных, , );
		Иначе
			МетаданныеСправочника = Метаданные.Справочники[ИмяМетаданных];
			ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка." + ИмяМетаданных, , );
		КонецЕсли;
	Исключение
		МетаданныеСправочника = Метаданные.Перечисления[ИмяМетаданных];
		ОписаниеТипа = Новый ОписаниеТипов("ПеречислениеСсылка." + ИмяМетаданных, , );
	КонецПопытки;
	// Выберем все элементы.
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТипыОбъектовIIKO.Ссылка,
	                      |	ТипыОбъектовIIKO.ТипЗначения
	                      |ИЗ
	                      |	ПланВидовХарактеристик.питТипыОбъектовIIKO КАК ТипыОбъектовIIKO");
	ТаблицаТипов = Запрос.Выполнить().Выгрузить();
	СтрокаТипа = ТаблицаТипов.Найти(ОписаниеТипа,"ТипЗначения");
	
	Если СтрокаТипа <> Неопределено Тогда
		Возврат СтрокаТипа.Ссылка;
	Иначе
		ВызватьИсключение("Передан неизвестный тип ПВХ:"+ИмяМетаданных)
	КонецЕсли;
	
КонецФункции // ЗаполнитьПредопределенныеЭлементы()

// Функция - Получить объект по метаданным
//
// Параметры:
//  ИмяМетаданных	 - Произвольный	 - Имя.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьОбъектПоМетаданным(ИмяМетаданных) Экспорт
	Если ИмяМетаданных = "Номенклатура" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.Номенклатура ;
	ИначеЕсли ИмяМетаданных = "ВидыНоменклатуры" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыНоменклатуры;
	ИначеЕсли ИмяМетаданных = "питМестаПечати" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.питМестаПечати;
	ИначеЕсли ИмяМетаданных = "питТипыОплат" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ТипыОплат;
	ИначеЕсли ИмяМетаданных = "питМодификаторы" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.Модификаторы;
	ИначеЕсли ИмяМетаданных = "питДанныеПродажФронта" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.Чек ;
	ИначеЕсли ИмяМетаданных = "питРецептура" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.Рецептуры;
	ИначеЕсли ИмяМетаданных = "питВидыОплатОрганизаций" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ВидыОплатОрганизаций;
	ИначеЕсли ИмяМетаданных = "питПричиныОтменИСписаний" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.ПричиныОтменИСписаний;
	ИначеЕсли ИмяМетаданных = "КассыККМ" Тогда 
		Результат = ПланыВидовХарактеристик.питТипыОбъектовIIKO.КассыККМ;
	Иначе 
		Результат = ПолучитьОбъектПоМетаданнымНеПредопределенный(ИмяМетаданных);
	КонецЕсли;
	
	Возврат Результат
КонецФункции

#КонецОбласти
