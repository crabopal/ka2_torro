
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("МассивОбъектов") И Параметры.МассивОбъектов.Количество() Тогда
		ВидПрайсЛиста = Параметры.МассивОбъектов[0];
	КонецЕсли;
	Если Параметры.Свойство("ВосстанавливатьЗначенияПриОткрытии") Тогда
		ВосстанавливатьЗначенияПриОткрытии = Параметры.ВосстанавливатьЗначенияПриОткрытии;
	КонецЕсли;
	
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	ТипыЦен.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыЦен КАК ТипыЦен
	|ГДЕ
	|	ТипыЦен.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|АВТОУПОРЯДОЧИВАНИЕ";
	Результат		= Запрос.Выполнить();
	Элементы.ТипЦен.СписокВыбора.ЗагрузитьЗначения(Результат.Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация	= питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидПрайсЛиста) Тогда
		ВыборкаВидаМеню	= Справочники.питВидыМеню.Выбрать();
		Пока ВыборкаВидаМеню.Следующий() Цикл
			ВидПрайсЛиста	= ВыборкаВидаМеню.Ссылка;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОсновнойТипЦен = ПолучитьЗначениеПоУмолчаниюНаСервере("ОсновнойТипЦенПродажи");
	Если (Элементы.ТипЦен.СписокВыбора.Количество()>0) Тогда
		Если Не ЗначениеЗаполнено(ТипЦен) Тогда
			НайденныйОсновнойТипЦен	= Элементы.ТипЦен.СписокВыбора.НайтиПоЗначению(ОсновнойТипЦен);
			Если (НайденныйОсновнойТипЦен=Неопределено) Тогда
				ТипЦен	= Элементы.ТипЦен.СписокВыбора[0].Значение;
			Иначе
				ТипЦен	= ОсновнойТипЦен;
			КонецЕсли;
		Иначе
			НайденныйТипЦен	= Элементы.ТипЦен.СписокВыбора.НайтиПоЗначению(ТипЦен);
			Если (НайденныйТипЦен=Неопределено) Тогда
				Элементы.ТипЦен.СписокВыбора.Добавить(ТипЦен);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Отсутствуют используемые типы цен продажи!");
	КонецЕсли;
	
	Если (ВосстанавливатьЗначенияПриОткрытии) Тогда
		ВосстановитьЗначенияНастроек();
		
		НайденныйОсновнойТипЦен	= Элементы.ТипЦен.СписокВыбора.НайтиПоЗначению(ТипЦен);
		Если (НайденныйОсновнойТипЦен=Неопределено) Тогда
			Элементы.ТипЦен.СписокВыбора.Добавить(ТипЦен);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Если (ВосстанавливатьЗначенияПриОткрытии) Тогда
		СохранениеДанныхВНастройках = СохранениеДанныхФормыВНастройках.ИспользоватьСписок;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ИспользуетсяРасширенноеМенюПриИзменении(Элемент)
	Если (ИспользуетсяРасширенноеМеню) Тогда
		ИспользуетсяИерархия								= Ложь;
		ИспользуетсяСебестоимость							= Ложь;
		Элементы.ИспользуетсяИерархия.Доступность		= ИспользуетсяИерархия;
		Элементы.ИспользуетсяСебестоимость.Доступность	= ИспользуетсяСебестоимость;
	Иначе
		Элементы.ИспользуетсяИерархия.Доступность		= Истина;
		Элементы.ИспользуетсяСебестоимость.Доступность	= Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	СтруктураПараметров		= Новый Структура();
	СтруктураПараметров.Вставить("ВидМеню",ВидПрайсЛиста);
	СтруктураПараметров.Вставить("Организация", Организация);
	СтруктураПараметров.Вставить("ТипЦен",ТипЦен);
	СтруктураПараметров.Вставить("Иерархия",ИспользуетсяИерархия);
	СтруктураПараметров.Вставить("РасширенноеМеню", ИспользуетсяРасширенноеМеню);
	СтруктураПараметров.Вставить("Себестоимость", ИспользуетсяСебестоимость);
	
	Закрыть(СтруктураПараметров);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьЗначениеПоУмолчаниюНаСервере(Настройка, Пользователь = Неопределено);
	Возврат питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию(Настройка, Пользователь);
КонецФункции

// Восстановить значения
&НаКлиенте
Процедура ВосстановитьЗначенияНастроек()
	СохранениеДанныхВНастройках = СохранениеДанныхФормыВНастройках.ИспользоватьСписок;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация	= ПолучитьЗначениеПоУмолчаниюНаСервере("ОсновнаяОрганизация");
	КонецЕсли;
	
	Если (ИспользуетсяРасширенноеМеню) Тогда
		Элементы.ИспользуетсяИерархия.Доступность		= Ложь;
		Элементы.ИспользуетсяСебестоимость.Доступность	= Ложь;
	Иначе
		Элементы.ИспользуетсяИерархия.Доступность		= Истина;
		Элементы.ИспользуетсяСебестоимость.Доступность	= Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
