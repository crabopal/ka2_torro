
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВходнойЦвет = Неопределено;
	Если Параметры.Свойство("Цвет") Тогда
		ВходнойЦвет = Параметры.Цвет;
	КонецЕсли;
	
	Если НЕ ВходнойЦвет = Неопределено
		И ВходнойЦвет.Вид = ВидЦвета.Абсолютный Тогда
		Красный = ВходнойЦвет.Красный;
		Зеленый = ВходнойЦвет.Зеленый;
		Синий = ВходнойЦвет.Синий;
		Hex = питОбщегоНазначенияКлиентСервер.RGB_HEX(Красный, Зеленый, Синий);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыбранныйЦвет = Новый Цвет(Красный,Зеленый,Синий);
	ОбновитьОсновнойЦвет(ВыбранныйЦвет);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ДекорацияЦветНажатие(Элемент)
	ОбновитьОсновнойЦвет(Элемент.ЦветФона);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРучногоЦвета(Элемент)
	НовыйЦвет = Новый Цвет(Красный, Зеленый, Синий);
	ОбновитьОсновнойЦвет(НовыйЦвет);
КонецПроцедуры

&НаКлиенте
Процедура HexПриИзменении(Элемент)
	RGB = питОбщегоНазначенияКлиентСервер.HEX_RGB(Hex);
	НовыйЦвет = Новый Цвет(RGB.Красный, RGB.Зеленый, RGB.Синий);
	ОбновитьОсновнойЦвет(НовыйЦвет);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)
	
	ВыбранныйЦвет = Новый Цвет(Красный, Зеленый, Синий);
	ВыходныеПараметры = Новый Структура;
	ВыходныеПараметры.Вставить("Результат",ВыбранныйЦвет);
	Закрыть(ВыходныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОсновнойЦвет(НовыйЦвет)
	
	ВыбранныйЦвет = НовыйЦвет;
	
	Красный = НовыйЦвет.Красный;
	Зеленый = НовыйЦвет.Зеленый;
	Синий = НовыйЦвет.Синий;
	Hex = питОбщегоНазначенияКлиентСервер.RGB_HEX(Красный, Зеленый, Синий);
	
	Элементы.ДекорацияВыбранныйЦвет.ЦветФона = НовыйЦвет;
	ПреобразованныйЦвет = ИнвертироватьЦвет(НовыйЦвет);
	
	Элементы.ДекорацияПримерФона.ЦветФона = НовыйЦвет;
	Элементы.ДекорацияПримерФона.ЦветТекста = ПреобразованныйЦвет;
	
	Элементы.ДекорацияПримерТекста.ЦветФона = ПреобразованныйЦвет;
	Элементы.ДекорацияПримерТекста.ЦветТекста = НовыйЦвет;
	
КонецПроцедуры

&НаКлиенте
Функция ИнвертироватьЦвет(ВходнойЦвет)
	
	ОбщийПоказатель = (ВходнойЦвет.Красный + ВходнойЦвет.Зеленый + ВходнойЦвет.Синий);
	Если ОбщийПоказатель > 383 Тогда
		ВыходнойЦвет = Новый Цвет(0,0,0);
	Иначе
		ВыходнойЦвет = Новый Цвет(255,255,255);
	КонецЕсли;

	Возврат ВыходнойЦвет;
	
КонецФункции

#КонецОбласти
