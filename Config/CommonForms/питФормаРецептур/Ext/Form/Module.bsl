
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЭтоВРецептурах") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "ЭтоВРецептурах, ТоварыНоменклатура");
	КонецЕсли;
	
	// Установить заголовок формы.
	Если ЭтоВРецептурах Тогда
		Если ЗначениеЗаполнено(ТоварыНоменклатура) Тогда
			ЭтаФорма.Заголовок = "Использование в рецептурах ингредиента """ + ТоварыНоменклатура + """.";
		Иначе
			ЭтаФорма.Заголовок = "Использование ингредиента в рецептурах (ошибка, не указан ингредиент)";
		КонецЕсли;
		ЭтаФорма.АвтоЗаголовок = Ложь;
	Иначе
		Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Номенклатура") И ЗначениеЗаполнено(Параметры.Отбор.Номенклатура) Тогда
			ЭтаФорма.Заголовок = "Список рецептур для номенклатуры """ + Параметры.Отбор.Номенклатура + """.";
		Иначе
			ЭтаФорма.Заголовок = "Список рецептур (ошибка, не указана номенклатура)";
		КонецЕсли;
		ЭтаФорма.АвтоЗаголовок = Ложь;
	КонецЕсли;
	
	// Определить список рецептур для ингредиента
	Если ЭтоВРецептурах И ЗначениеЗаполнено(ТоварыНоменклатура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ингредиент", ТоварыНоменклатура);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбщепитРецептураТовары.Ссылка КАК Рецептура,
		|	ОбщепитРецептураТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	Документ.питРецептура.Ингредиенты КАК ОбщепитРецептураТовары
		|ГДЕ
		|	ОбщепитРецептураТовары.Номенклатура = &Ингредиент";
		
		МассивРецептур = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Рецептура");
		Параметры.Отбор.Вставить("Ссылка", МассивРецептур);
		
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьРецептуруПриготовление(Команда)
	
	СтруктураПараметров = ПолучитьСтруктуруПараметровФормы(
		ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураПриготовление"));
	ОткрытьФорму("Документ.питРецептура.ФормаОбъекта", СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРецептуруРазделка(Команда)
	
	СтруктураПараметров = ПолучитьСтруктуруПараметровФормы(
		ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазделка"));
	ОткрытьФорму("Документ.питРецептура.ФормаОбъекта", СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьСтруктуруПараметровФормы(ХозяйственнаяОперация)
	
	СтруктураПараметров = Новый Структура;
	
	ЗначенияЗаполнения = питОбщегоНазначения.ЗначенияЗаполненияДинамическогоСписка(СписокРецептур.КомпоновщикНастроек);
	Если ЗначениеЗаполнено(ХозяйственнаяОперация) Тогда
		ЗначенияЗаполнения.Вставить("ХозяйственнаяОперация", ХозяйственнаяОперация);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	// Номенклатура из шапки рецептуры
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокРецептурНоменклатура");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЭтоВРецептурах", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

#КонецОбласти

