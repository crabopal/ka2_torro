

#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Определяем способ расчета рецептуры исходя из константы.
	СпособРасчетаРецептуры = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
	СпособРасчетаРецептурыПоАктуальной = (СпособРасчетаРецептуры = Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре);
	
	// Заполнение реквизитов формы по переданным параметрам.
	Параметры.Свойство("Ссылка"						, Ссылка);
	Параметры.Свойство("Организация"				, Организация);
	Параметры.Свойство("Подразделение"				, Подразделение);
	Параметры.Свойство("Дата"						, Дата);
	Параметры.Свойство("АдресУточненияАвтовыбора"	, АдресУточненияАвтовыбора);
	Параметры.Свойство("Склад"						, Склад);
	Параметры.Свойство("ВидПроизводства"			, ВидПроизводства);
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Параметры.Свойство("ЦеховаяКладовая"		, Склад);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ВидПроизводства) Тогда
		// Если вид производства не передали, то ставим "Все заготовки".
		ВидПроизводства = Перечисления.питВидыПроизводства.ПеределыВнутриВыпуска;
	КонецЕсли;
	ЦеховаяКладовая = Склад;
	Если Параметры.Свойство("ЗаголовокКнопки") Тогда
		Элементы.ФормаПеренестиВДокумент.Заголовок = Параметры.ЗаголовокКнопки;
	КонецЕсли;
	
	// Если передан адрес таблицы уточнения автовыбора, то обрабатываем его.
	Если НЕ ПустаяСтрока(АдресУточненияАвтовыбора) Тогда
		// Получаем таблицу уточнения автовыбора из временного хранилища.
		ПолученнаяТаблица = ПолучитьИзВременногоХранилища(АдресУточненияАвтовыбора);
		// Заполняем колонку "ХарактеристикиИспользуются" в переданной таблице.
		ЗаполнитьПризнакХарактеристикиИспользуютсяВТаблице(ПолученнаяТаблица);
		// Загружаем таблицу в реквизит формы.
		ТаблицаХарактеристик.Загрузить(ПолученнаяТаблица);
		// Заполняем дерево характеристик по загруженной таблице.
		ЗаполнитьДеревоХарактеристик();
		
//   Если есть корневая строка с заполненной характеристикой но не заполненными потомками, то вызываем обработку
// изменения характеристики.
		Для каждого ТекСтрокаДерева Из ДеревоХарактеристик.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(ТекСтрокаДерева.Характеристика) И НЕ ТекСтрокаДерева.ПолучитьЭлементы().Количество() Тогда
				ДеревоХарактеристикХарактеристикаПриИзмененииНаСервере(ТекСтрокаДерева.ПолучитьИдентификатор());
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Установка заголовка формы.
	Заголовок = "Уточнение характеристик";
	
	// Установка условного оформления.
	УстановитьУсловноеОформление();
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РазвернутьДеревоХарактеристик();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Дерево характеристик перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ДеревоХарактеристикПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - Дерево характеристик перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоХарактеристикПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - Дерево характеристик характеристика при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоХарактеристикХарактеристикаПриИзменении(Элемент)
	
	// Получение идентификатора текущей строки.
	ИдентификаторСтроки = Элементы.ДеревоХарактеристик.ТекущаяСтрока;
	
	// Серверный вызов.
	ДеревоХарактеристикХарактеристикаПриИзмененииНаСервере(ИдентификаторСтроки);
	
	// Развертка уровней дерева.
	РазвернутьДеревоХарактеристик();
	
КонецПроцедуры

//  Процедура - Дерево характеристик выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоХарактеристикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И НЕ (Элемент.ТекущийЭлемент = Элементы.ДеревоХарактеристикХарактеристика И ТекДанные.ОшибкаАвтовыбора) Тогда
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные[СтрЗаменить(Элемент.ТекущийЭлемент.Имя, Элементы.ДеревоХарактеристик.Имя, "")]);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти


#Область ОбработчикиКомандФормы

//  Процедура - Перенести в документ.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	// Перенос данных 
	АдресТаблицы = ПеренестиИзДереваВТаблицу();
	ОповеститьОВыборе(АдресТаблицы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДереваХарактеристик

// Процедура заполняет дерево характеристик по таблице характеристик.
//
&НаСервере
Процедура ЗаполнитьДеревоХарактеристик()
	
	// Получаем объект дерева значений.
	ДеревоХарактеристикОбъект = РеквизитФормыВЗначение("ДеревоХарактеристик");
	
	// Находим строки в таблице характеристик с пустым ключом родителя - это будут корневые узлы дерева.
	КорниДерева = ТаблицаХарактеристик.НайтиСтроки(Новый Структура("КлючРодителя", ""));
	Для каждого СтрокаТаблицы Из КорниДерева Цикл
		// Вызов рекурсивной функции заполнения дерева.
		ДобавитьВДревоУточнений(СтрокаТаблицы, ДеревоХарактеристикОбъект);
	КонецЦикла;
	
	// Переносим данные из объекта в реквизит формы.
	ЗначениеВРеквизитФормы(ДеревоХарактеристикОбъект, "ДеревоХарактеристик");
	
КонецПроцедуры

// Рекурсивная функция заполнения дерева уточнений.
//
// Параметры:
//  СтрокаТаблицы - СтрокаТаблицыЗначений - Текущая обрабатываемая строка таблицы характеристи.
//  ДеревоХарактеристикОбъект - ДеревоЗначений - Заполняемое дерево.
//
// Возвращаемое значение:
//  Булево - Есть ли среди добавленных строк ошибки автовыбора.
&НаСервере
Функция ДобавитьВДревоУточнений(СтрокаТаблицы, ДеревоХарактеристикОбъект)
	
	// Значение по умолчанию.
	ЕстьОшибкиАвтовыбора = Ложь;
	
	// Добавление строки дерева для текущей строки таблицы.
	НовСтрокаДерева = ДеревоХарактеристикОбъект.Строки.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтрокаДерева, СтрокаТаблицы);
	
	// Поиск потомков текущей строки по полю "КлючРодителя".
	НайденныеПотомки = ТаблицаХарактеристик.НайтиСтроки(Новый Структура("КлючРодителя", СтрокаТаблицы.Ключ));
	Для каждого НайденныйПотомок Из НайденныеПотомки Цикл
		// Рекурсивный вызов, значение для потомков.
		ЕстьОшибкиАвтовыбора = ЕстьОшибкиАвтовыбора ИЛИ ДобавитьВДревоУточнений(НайденныйПотомок, НовСтрокаДерева);
	КонецЦикла;
	
	// Возвращаемое значение.
	ЕстьОшибкиАвтовыбора = ЕстьОшибкиАвтовыбора ИЛИ НовСтрокаДерева.ОшибкаАвтовыбора;
	
	// Удаляем строку дерева, если в ней и в ее потомках нет ошибок автовыбора.
	Если НЕ ЕстьОшибкиАвтовыбора Тогда
		ДеревоХарактеристикОбъект.Строки.Удалить(НовСтрокаДерева);
	КонецЕсли;
	
	Возврат ЕстьОшибкиАвтовыбора;
	
КонецФункции

#КонецОбласти

#Область ПереносДанныхИзДереваХарактеристик

// Функция по переносу данных из дерева характеристик в таблицу и помещения во временное хранилище.
//
// Возвращаемое значение:
//  Строка - Адрес таблицы во временном хранилище.
&НаСервере
Функция ПеренестиИзДереваВТаблицу()
	
	Для каждого ТекСтрокаДерева Из ДеревоХарактеристик.ПолучитьЭлементы() Цикл
		ПеренестиДанныеИзДереваВТаблицу(ТекСтрокаДерева);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаХарактеристик.Выгрузить());
	
КонецФункции

// Рекурсивная процедура по переносу данных из дерева характеристик в таблицу.
//
// Параметры:
//  ВеткаДерева - ДанныеФормыЭлементДерева - Текущая строка дерева характеристик.
//  КлючРодителя - Строка - Текущий ключ родительской строки.
//
&НаСервере
Процедура ПеренестиДанныеИзДереваВТаблицу(ВеткаДерева, КлючРодителя = "")
	
	// Ищем в таблице характеристик строку по ключу.
	СтрокиТаблицы = ТаблицаХарактеристик.НайтиСтроки(Новый Структура("Ключ", ВеткаДерева.Ключ));
	Если СтрокиТаблицы.Количество() Тогда
		// Нашли строку, обновляем ее.
		СтрокаТаблицы = СтрокиТаблицы[0];
	Иначе
		// Не нашли строку, добавляем новую.
		СтрокаТаблицы = ТаблицаХарактеристик.Добавить();
	КонецЕсли;
	
	// Обновление данных в строке.
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВеткаДерева);
	СтрокаТаблицы.КлючРодителя = КлючРодителя;
	
	// Рекурсивный выхов для потомков.
	Для каждого ТекСтрокаДерева Из ВеткаДерева.ПолучитьЭлементы() Цикл
		ПеренестиДанныеИзДереваВТаблицу(ТекСтрокаДерева, ВеткаДерева.Ключ);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаИзмененияХарактеристики

//  Процедура - Дерево характеристик характеристика при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ДеревоХарактеристикХарактеристикаПриИзмененииНаСервере(ИдентификаторСтроки)
	
	// Значение по умолчанию.
	МассивДеревьевСостава = Новый Массив;
	
	// Получаем текущие данные.
	ТекущиеДанные = ДеревоХарактеристик.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем объект дерева значений.
	ДеревоХарактеристикОбъект = РеквизитФормыВЗначение("ДеревоХарактеристик");
	
	// Находим родителей, похожих на текущего.
	ДанныеРодителя = ТекущиеДанные.ПолучитьРодителя();
	Если ДанныеРодителя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Находим потомков у похожих родителей с такой же номенклатурой и вызываем обработку изменения для них.
	МассивДеревьевСостава = Новый Массив;
	// Ищем похожие строки в дереве.
	СтрокиДляОбработки = НайтиПохожиеСтрокиДереваХарактеристик(ДеревоХарактеристикОбъект, ТекущиеДанные, ДанныеРодителя);
	Для каждого ТекСтрокаОбработать Из СтрокиДляОбработки Цикл
		// Обновляем значение характеристики
		ТекСтрокаОбработать.Характеристика = ТекущиеДанные.Характеристика;
		// Вызываем обработку изменения.
		ОбработатьИзменениеХарактеристикиПоСтрокеДереваЗначений(ТекСтрокаОбработать, ДеревоХарактеристикОбъект, МассивДеревьевСостава);
	КонецЦикла;
	
	// Переносим данные из объекта в реквизит формы.
	ЗначениеВРеквизитФормы(ДеревоХарактеристикОбъект, "ДеревоХарактеристик");
	
КонецПроцедуры

//  Функция - Найти похожие строки дерева характеристик.
//
// Параметры:
//  ДеревоХарактеристикОбъект - ДеревоЗначений - Дерево характеристик объект.
//  ДанныеСтроки - Произвольный - Данные строки.
//  ДанныеРодителя - Произвольный - Данные родителя.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервере
Функция НайтиПохожиеСтрокиДереваХарактеристик(ДеревоХарактеристикОбъект, ДанныеСтроки, ДанныеРодителя)
	
	Результат = Новый Массив;
	
	СтрокиРодительские = ДеревоХарактеристикОбъект.Строки.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Рецептура", ДанныеРодителя.Номенклатура, ДанныеРодителя.Характеристика, ДанныеРодителя.Рецептура), Истина);
	Для каждого СтрокаРодительская Из СтрокиРодительские Цикл
		Для каждого ТекСтрокаОбработать Из СтрокаРодительская.Строки Цикл
			Если ТекСтрокаОбработать.Номенклатура = ДанныеСтроки.Номенклатура Тогда
				Результат.Добавить(ТекСтрокаОбработать);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


//  Процедура - Обработать изменение характеристики по строке дерева значений.
//
// Параметры:
//  ТекущиеДанные - Произвольный - Текущие данные.
//  ДеревоХарактеристикОбъект - ДеревоЗначений - Дерево характеристик объект.
//  МассивДеревьевСостава - Массив - Массив деревьев состава.
//  ТаблицаЗащитыОтЗацикливания - ТаблицаЗначений - Таблица защиты от зацикливания.
//
&НаСервере
Процедура ОбработатьИзменениеХарактеристикиПоСтрокеДереваЗначений(ТекущиеДанные, ДеревоХарактеристикОбъект, МассивДеревьевСостава = Неопределено, ТаблицаЗащитыОтЗацикливания = Неопределено)
	
	// Значение по умолчанию.
	Если МассивДеревьевСостава = Неопределено Тогда
		МассивДеревьевСостава = Новый Массив;
	КонецЕсли;
	
	// Создание новой таблицы ,если зашли в функцию первый раз
	Если ТаблицаЗащитыОтЗацикливания = Неопределено Тогда
		ТаблицаЗащитыОтЗацикливания = Новый ТаблицаЗначений;
		ТаблицаЗащитыОтЗацикливания.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаЗащитыОтЗацикливания.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ТаблицаЗащитыОтЗацикливания.Колонки.Добавить("Рецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"));
	КонецЕсли;
	
	// Получаем строку таблицы, соответствующую текущим данным.
	СтрокиТаблицы = ТаблицаХарактеристик.НайтиСтроки(Новый Структура("Ключ", ТекущиеДанные.Ключ));
	Если НЕ СтрокиТаблицы.Количество() Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанныеТаблицы = СтрокиТаблицы[0];
	
	// Новое значение характеристики равно старому, ничего не делаем.
	Если ТекущиеДанные.Характеристика = ТекущиеДанныеТаблицы.Характеристика Тогда
		Возврат;
	КонецЕсли;
	
	// обновление характеристики в таблице.
	ТекущиеДанныеТаблицы.Характеристика = ТекущиеДанные.Характеристика;
	
	// Удалить всех потомков текущей ветки дерева(и по цепочке связанные строки таблицы).
	ТекущиеЭлементы = ТекущиеДанные.Строки;
	Для каждого ТекСтрокаДерева Из ТекущиеЭлементы Цикл
		// Удаление строк таблицы.
		УдалитьСтрокиТаблицыХарактеристикПоСтрокеДерева(ТекСтрокаДерева);
		// Удаление строк дерева.
		ТекущиеЭлементы.Удалить(ТекСтрокаДерева);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Характеристика) Тогда
		
		// Характеристика заполнена, ищем рецептуру.
		ДатаРецептуры = ?(ЗначениеЗаполнено(Ссылка), Дата, КонецДня(Дата));
		ТекущиеДанные.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекущиеДанные.Номенклатура, ТекущиеДанные.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
			ДатаРецептуры, СпособРасчетаРецептуры,, Организация,,,Подразделение);
		
		Если ЗначениеЗаполнено(ТекущиеДанные.Рецептура) Тогда
			
			Если НЕ МассивДеревьевСостава.Количество() Тогда
				
				// Структура проверки от зацикливания
				СтруктураПроверкиОтЗацикливания = Новый Структура("Номенклатура, Характеристика, Рецептура");
				ЗаполнитьЗначенияСвойств(СтруктураПроверкиОтЗацикливания, ТекущиеДанные);
				НайденныеСтрокиЗацикливания = ТаблицаЗащитыОтЗацикливания.НайтиСтроки(СтруктураПроверкиОтЗацикливания);
				Если НЕ НайденныеСтрокиЗацикливания.Количество() Тогда
					НовСтрокаЗащиты = ТаблицаЗащитыОтЗацикливания.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрокаЗащиты, СтруктураПроверкиОтЗацикливания);
					
					// Рецептура найдена, заполняем производство по текущей строке дерева.
					СтрокаБлюдо = Новый Структура("Номенклатура, Характеристика, Серия, Назначение, УпаковкаНоменклатуры, Рецептура, ИдентификаторСтроки, Автопередел");
					ЗаполнитьЗначенияСвойств(СтрокаБлюдо, ТекущиеДанные);
					СтрокаБлюдо.Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
					СтрокаБлюдо.Назначение = Справочники.Назначения.ПустаяСсылка();
					СтрокаБлюдо.УпаковкаНоменклатуры = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
					СтрокаБлюдо.ИдентификаторСтроки = ТекущиеДанные.Ключ;
					СтрокаБлюдо.Автопередел = Истина;
					питИзменениеФактаВПроизводстве.ПолучитьТаблицуПроизводстваПоБлюду(ЭтаФорма, СтрокаБлюдо, 1, 1, "ЭтаФорма", МассивДеревьевСостава);
				КонецЕсли;
				
			КонецЕсли;
			
			// Дополняем дерево характеристик данными из массива деревьев состава.
			ДополнитьДеревоХарактеристик(МассивДеревьевСостава, ТекущиеДанные, ДеревоХарактеристикОбъект, ТаблицаЗащитыОтЗацикливания);
			
		КонецЕсли;
	Иначе
		// Характеристика не заполнена, обнуляем рецептуру.
		ТекущиеДанные.Рецептура = Неопределено;
	КонецЕсли;
	
КонецПроцедуры


// Процедура удаляем строки таблицы характеристик по строке дерева
//
// Параметры:
//  ТекСтрокаДерева - ДанныеФормыЭлементДерева - Строка дерева.
//
&НаСервере
Процедура УдалитьСтрокиТаблицыХарактеристикПоСтрокеДерева(ТекСтрокаДерева)
	
	// Поиск строк по ключу для текущей строки дерева.
	СтрокиТаблицы = ТаблицаХарактеристик.НайтиСтроки(Новый Структура("Ключ", ТекСтрокаДерева.Ключ));
	Для каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		ТаблицаХарактеристик.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	// Рекурсивный выхов для потомков.
	Для каждого ТекПотомок Из ТекСтрокаДерева.Строки Цикл
		УдалитьСтрокиТаблицыХарактеристикПоСтрокеДерева(ТекПотомок);
	КонецЦикла;
	
КонецПроцедуры

// Процедура дополняет дерево характеристик данными из массива деревьев состава.
//
// Параметры:
//  МассивДеревьевСостава - Массив - Массив деревьев состава, полученный в процессе заполнения таблицы производства.
//  ВеткаДерева - ДанныеФормыЭлементДерева - Текущая строка дерева.
//  ДеревоХарактеристикОбъект - ДеревоЗначений - Дерево характеристик объект.
//  ТаблицаЗащитыОтЗацикливания - ТаблицаЗначений - Таблица защиты от зацикливания.
//
&НаСервере
Процедура ДополнитьДеревоХарактеристик(МассивДеревьевСостава, ВеткаДерева, ДеревоХарактеристикОбъект, ТаблицаЗащитыОтЗацикливания)
	
	Если МассивДеревьевСостава.Количество() И МассивДеревьевСостава[0].Строки.Количество() Тогда
		// Если массив деревьев заполнен, то данные по блюду находятся в первом найденном дереве,
		//  а чтобы исключить само блюдо, будем брать сразу его строки.
		Для каждого СтрокаДеревоСостава Из МассивДеревьевСостава[0].Строки[0].Строки Цикл
			// Вызов рекурсивной функции обхода переданных строк дерева состава.
			ДополнитьДеревоХарактеристикРекурсивно(СтрокаДеревоСостава, ВеткаДерева, ДеревоХарактеристикОбъект, ТаблицаЗащитыОтЗацикливания);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Рекурсивная функция, которая дополнить дерево характеристик данными из ветки дерева состава.
//
// Параметры:
//  ВеткаДереваСостава - СтрокаДереваЗначений - Ветка дерева состава.
//  ВеткаДерева - СтрокаДереваЗначений - Ветка дерева состава.
//  ДеревоХарактеристикОбъект - ДеревоЗначений - Дерево характеристик объект.
//  ТаблицаЗащитыОтЗацикливания - ТаблицаЗначений - Таблица защиты от зацикливания.
//
// Возвращаемое значение:
//  Булево - Есть ли ошибки автовыбора в переданной ветке дерева состава.
&НаСервере
Функция ДополнитьДеревоХарактеристикРекурсивно(ВеткаДереваСостава, ВеткаДерева, ДеревоХарактеристикОбъект, ТаблицаЗащитыОтЗацикливания)
	
	// Значение по умолчанию.
	ЕстьОшибкиАвтовыбора = Ложь;
	
	// Ищем похожую строку в дереве характеристик, если она есать, то копипастим из нее характеристику.
	ИзменилиХарактеристику = Ложь;
	ПохожаяСтрока = Неопределено;
	Если НЕ ЗначениеЗаполнено(ВеткаДереваСостава.Характеристика) Тогда
		ПохожиеСтрокиДерева = НайтиПохожиеСтрокиДереваХарактеристик(ДеревоХарактеристикОбъект, ВеткаДереваСостава, ВеткаДерева);
		Если ПохожиеСтрокиДерева.Количество() Тогда
			ПохожаяСтрока = ПохожиеСтрокиДерева[0];
		КонецЕсли;
	КонецЕсли;
	// Добавление новой ветки дерева характеристик.
	ТекущиеЭлементы = ВеткаДерева.Строки;
	НовСтрокаДерева = ТекущиеЭлементы.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтрокаДерева, ВеткаДереваСостава);
	НовСтрокаДерева.Ключ = ВеткаДереваСостава.ИдентификаторСтрокиДерева;
	ЗаполнитьПризнакХарактеристикиИспользуютсяВСтроке(НовСтрокаДерева);
	Если НЕ ПохожаяСтрока = Неопределено И ЗначениеЗаполнено(ПохожаяСтрока.Характеристика) Тогда
		// Ищем похожую строку в дереве характеристик, если она есать, то копипастим из нее характеристику.
		НовСтрокаДерева.Характеристика	= ПохожаяСтрока.Характеристика;
		НовСтрокаДерева.Рецептура		= ПохожаяСтрока.Рецептура;
		ИзменилиХарактеристику = Истина;
	КонецЕсли;
	
	Для каждого НайденныйПотомок Из ВеткаДереваСостава.Строки Цикл
		// Значение для потомков.
		ЕстьОшибкиАвтовыбора = ЕстьОшибкиАвтовыбора ИЛИ ДополнитьДеревоХарактеристикРекурсивно(НайденныйПотомок, НовСтрокаДерева, ДеревоХарактеристикОбъект, ТаблицаЗащитыОтЗацикливания);
	КонецЦикла;
	
	// Возвращаемое значение.
	ЕстьОшибкиАвтовыбора = ЕстьОшибкиАвтовыбора ИЛИ НовСтрокаДерева.ОшибкаАвтовыбора;
	
	// Удаляем строку дерева характеристик, если в ней и в ее потомках нет ошибок автовыбора.
	Если НЕ ЕстьОшибкиАвтовыбора Тогда
		ТекущиеЭлементы.Удалить(НовСтрокаДерева);
	Иначе // Удалять ветку дерева не требуется, можно добавить строку таблицы.
		НовСтрокаТаблицы = ТаблицаХарактеристик.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрокаТаблицы, НовСтрокаДерева);
		НовСтрокаТаблицы.КлючРодителя = ВеткаДерева.Ключ;
		
		Если ИзменилиХарактеристику Тогда
			НовСтрокаТаблицы.Характеристика = Неопределено;
			ОбработатьИзменениеХарактеристикиПоСтрокеДереваЗначений(НовСтрокаДерева, ДеревоХарактеристикОбъект,,ТаблицаЗащитыОтЗацикливания);
		КонецЕсли;
		
	КонецЕсли;
	
	
	
	Возврат ЕстьОшибкиАвтовыбора;
	
КонецФункции

#КонецОбласти

//  Процедура - Развернуть дерево характеристик.
//
&НаКлиенте
Процедура РазвернутьДеревоХарактеристик()
	
	// Развертка всех уровней дерева.
	Для каждого СтрокаДерева Из ДеревоХарактеристик.ПолучитьЭлементы() Цикл
		Элементы.ДеревоХарактеристик.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

// Процедура по установке условного оформления
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Только просмотр для строк, где нет проблем.
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоХарактеристик.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.ОшибкаАвтовыбора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Заполнили автовыбор
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоХарактеристик.Имя);
	ГруппаОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтборЭлемента.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ОтборЭлемента = ГруппаОтборЭлемента.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.ОшибкаАвтовыбора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	ОтборЭлемента = ГруппаОтборЭлемента.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.Характеристика");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаУспех);
	
	// НЕ заполнили автовыбор
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоХарактеристик.Имя);
	ГруппаОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтборЭлемента.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ОтборЭлемента = ГруппаОтборЭлемента.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.ОшибкаАвтовыбора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	ОтборЭлемента = ГруппаОтборЭлемента.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.Характеристика");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаПроблема);
	
	// Для незаполненных характеристик, если они не используются.
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоХарактеристикХарактеристика.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", "<Характеристики не используются>");
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	// Для незаполненных характеристик, требующих уточнения
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоХарактеристикХарактеристика.Имя);
	ГруппаОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтборЭлемента.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ОтборЭлемента = ГруппаОтборЭлемента.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	ОтборЭлемента = ГруппаОтборЭлемента.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоХарактеристик.Характеристика");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", "<Требуется уточнение>");
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	
КонецПроцедуры

// Процедура заполняет признак характеристики используются в переданной таблице.
//
// Параметры:
//  ПолученнаяТаблица - ТаблицаЗначений - Таблица, в которой необходимо заполнить признак "ХарактеристикиИспользуются".
//
&НаСервереБезКонтекста
Процедура ЗаполнитьПризнакХарактеристикиИспользуютсяВТаблице(ПолученнаяТаблица)
	
	// Если в таблице нет колонки ХарактеристикиИспользуются, то добавим ее.
	Если ПолученнаяТаблица.Колонки.Найти("ХарактеристикиИспользуются") = Неопределено Тогда
		ПолученнаяТаблица.Колонки.Добавить("ХарактеристикиИспользуются", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	МассивНоменклатуры = ПолученнаяТаблица.ВыгрузитьКолонку("Номенклатура");
	ИспользованиеХарактеристик = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивНоменклатуры, "ИспользованиеХарактеристик");
	Для каждого ТекИнгредиент Из ПолученнаяТаблица Цикл
		ТекИспользованиеХарактеристик = ИспользованиеХарактеристик.Получить(ТекИнгредиент.Номенклатура);
		ТекИнгредиент.ХарактеристикиИспользуются = 
			(ТекИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры
			ИЛИ ТекИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры
			ИЛИ ТекИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры);
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет признак характеристики используются в переданной строке таблицы или структуре.
//
// Параметры:
//  ТекИнгредиент - СтрокаТаблицыЗначений, Структура - Строка, в которой необходимо заполнить призна.
//
&НаСервереБезКонтекста
Процедура ЗаполнитьПризнакХарактеристикиИспользуютсяВСтроке(ТекИнгредиент)
	
	ТекИспользованиеХарактеристик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекИнгредиент.Номенклатура, "ИспользованиеХарактеристик");
	ТекИнгредиент.ХарактеристикиИспользуются = 
		(ТекИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры
		ИЛИ ТекИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры
		ИЛИ ТекИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры);
	
КонецПроцедуры

