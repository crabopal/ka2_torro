
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(ВходныеПараметры = Неопределено) Экспорт
	
	ЗначениеНастройки = Получить();
	Если ЗначениеЗаполнено(ЗначениеНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УдаленныеКассы.ОформлятьДокументыЕГАИС КАК ОформлятьДокументыЕГАИС
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК УдаленныеКассы
	|ГДЕ
	|	НЕ УдаленныеКассы.ПометкаУдаления
	|	И УдаленныеКассы.ОформлятьДокументыЕГАИС";
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Установить(Перечисления.питСпособыСписанияМарокИСПриПроизводстве.ВоВсехДокументах);
		Возврат;
	КонецЕсли;
	
	Установить(Перечисления.питСпособыСписанияМарокИСПриПроизводстве.ИсключатьЦелевыеДокументы);
	
КонецПроцедуры

#КонецОбласти


#КонецЕсли
