#Область ПрограммныйИнтерфейс

// Позволяет изменить работу интерфейса при встраивании.
//
// Параметры:
//  НастройкиРаботыИнтерфейса - Структура - содержит свойство.
//
Процедура НастройкаИнтерфейса(НастройкиРаботыИнтерфейса) Экспорт
	
КонецПроцедуры

// Заполняет разделы дат запрета изменения, используемые при настройке дат запрета.
//  Если не указать ни одного раздела, тогда будет доступна только настройка общей даты запрета.
//
// Параметры:
//  Разделы - ТаблицаЗначений - с колонками.
//
Процедура ПриЗаполненииРазделовДатЗапретаИзменения(Разделы) Экспорт
	
	Раздел = Разделы.Добавить();
	Раздел.Имя  = "питОбщепит";
	Раздел.Идентификатор = Новый УникальныйИдентификатор("199b1175-8cae-4680-8bf0-2ef63a1adb0d");
	Раздел.Представление = НСтр("ru = 'Общепит'");
	Раздел.ТипыОбъектов.Добавить(Тип("СправочникСсылка.Организации"));
	
КонецПроцедуры

// Позволяет задать таблицы и поля объектов для проверки запрета изменения данных.
//  Для добавления нового источника в ИсточникиДанных см. ДатыЗапретаИзменения.ДобавитьСтроку.
//  Вызывается из процедуры ИзменениеЗапрещено общего модуля ДатыЗапретаИзменения,
//  используемой в подписке на событие ПередЗаписью объекта для проверки наличия
//  запретов и отказа от изменений запрещенного объекта.
//
// Параметры:
//  ИсточникиДанных - ТаблицаЗначений - с колонками.
//
Процедура ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения(ИсточникиДанных) Экспорт
	
	// Документы.
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.Документы.питВыпускБлюд.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.Документы.питПланМеню.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.Документы.питРазделка.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
	
	// ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
	// 	Метаданные.Документы.питРецептура.ПолноеИмя(),
	// 	"Дата", "питОбщепит", "Организация");
	
	// ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
	// 	Метаданные.Документы.питДанныеПродажФронта.ПолноеИмя(),
	// 	"Дата", "питОбщепит", "Организация");
	
	// ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
	// 	Метаданные.Документы.питРегистрацияЗамен.ПолноеИмя(),
	// 	"ДатаОкончанияДействия", "питОбщепит");
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.Документы.питИнвентаризацияТоваров.ПолноеИмя(),
		"Дата", "питОбщепит");
		
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.Документы.питПеремещениеНоменклатурыСкладаПроизводства.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
		
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
	
	// +Хасп
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.Документы.питБракеражПродукции.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
	// -Хасп
	
	// Регистры сведений.
	
	// ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
	// 	Метаданные.РегистрыСведений.питАктуальныеРецептуры.ПолноеИмя(),
	// 	"Период", "питОбщепит", "Организация");
		
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.РегистрыСведений.питУчетДанныхПродаж.ПолноеИмя(),
		"Дата", "питОбщепит");
		
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.РегистрыСведений.питПродажиПоЧекам.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
		
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.РегистрыСведений.питОплатыПоЧекам.ПолноеИмя(),
		"Дата", "питОбщепит", "Организация");
		
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.РегистрыСведений.питПродажиМодификаторовПоЧекам.ПолноеИмя(),
		"Дата", "питОбщепит");
	
	// Регистры накопления.
	
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных,
		Метаданные.РегистрыНакопления.питПроизводство.ПолноеИмя(),
		"Период", "питОбщепит", "Организация");
	
КонецПроцедуры

// Процедура - Перед проверкой запрета изменения.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  ПроверкаЗапретаИзменения - Произвольный - Проверка запрета изменения.
//  УзелПроверкиЗапретаЗагрузки - Произвольный - Узел проверки запрета загрузки.
//  ВерсияОбъекта - Произвольный - Версия объекта.
//
Процедура ПередПроверкойЗапретаИзменения(Объект,
	ПроверкаЗапретаИзменения,
	УзелПроверкиЗапретаЗагрузки,
	ВерсияОбъекта) Экспорт
	
	
КонецПроцедуры

#КонецОбласти




