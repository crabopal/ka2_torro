
#Область ПрограммныйИнтерфейс

#Область ГрафЗаказов

// Функция - Граф заказов поиск в ширину
//
// Параметры:
//  ВершинаКуда - ДокументСсылка.питПланМеню - заказный документ, от которого ищем.
//
// Возвращаемое значение:
//  Структура - Структура с массивами: ПосещенныеДуги, ПосещенныеВершины.
Функция ГрафЗаказов_ПоискВШирину(ВершинаКуда) Экспорт
	
	Очередь = Очередь_Новый();
	Очередь_Добавить(Очередь, ВершинаКуда);
	ПосещенныеВершины = Новый Массив;
	ПосещенныеВершины.Добавить(ВершинаКуда);
	
	ПосещенныеДуги = Новый ТаблицаЗначений;
	ПосещенныеДуги.Колонки.Добавить("ДокументРодитель", Новый ОписаниеТипов("ДокументСсылка.питПланМеню"));
	ПосещенныеДуги.Колонки.Добавить("ДокументПотомок", Новый ОписаниеТипов("ДокументСсылка.питПланМеню"));
	
	Пока Не Очередь_Пустой(Очередь) Цикл
		Вершина = Очередь_Получить(Очередь);
		
		Соседи = ГрафЗаказов_ПолучитьСоседейВершиныВверх(Вершина);
		Для каждого Сосед Из Соседи Цикл
			Если ПосещенныеВершины.Найти(Сосед) = Неопределено Тогда
				Очередь_Добавить(Очередь, Сосед);
				ПосещенныеВершины.Добавить(Сосед);
			КонецЕсли;
			ПосещеннаяДуга = ПосещенныеДуги.Добавить();
			ПосещеннаяДуга.ДокументРодитель = Сосед;
			ПосещеннаяДуга.ДокументПотомок = Вершина;
		КонецЦикла;
		
		Соседи = ГрафЗаказов_ПолучитьСоседейВершиныВниз(Вершина);
		Для каждого Сосед Из Соседи Цикл
			Если ПосещенныеВершины.Найти(Сосед) = Неопределено Тогда
				Очередь_Добавить(Очередь, Сосед);
				ПосещенныеВершины.Добавить(Сосед);
			КонецЕсли;
			ПосещеннаяДуга = ПосещенныеДуги.Добавить();
			ПосещеннаяДуга.ДокументРодитель = Вершина;
			ПосещеннаяДуга.ДокументПотомок = Сосед;
		КонецЦикла;
		
	КонецЦикла;
	
	// Свертка посещенных дуг.
	ПосещенныеДуги.Свернуть("ДокументРодитель,ДокументПотомок");
	
	Возврат Новый Структура("ПосещенныеВершины, ПосещенныеДуги", ПосещенныеВершины, ПосещенныеДуги);
	
КонецФункции

#КонецОбласти

// Процедура вызывается в начале обработчика при создании на сервере отраслевых форм.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма объекта.
//  Отказ - Булево - Отказ создания формы.
//  СтандартнаяОбработка - Булево - Признак выполнения стандартной обработки.
//
Процедура ПриСозданииНаСервереВНачале(Форма,Отказ, СтандартнаяОбработка) Экспорт
	
	АктивныйДокумент = АктивныйДокументПоКопии(Форма.Объект.Ссылка);
	Если НЕ АктивныйДокумент = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данный документ является копией основного документа <" + АктивныйДокумент 
		+ "> и открыт в режиме просмотра!", АктивныйДокумент);
		Форма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается в начале обработчика перед записью документов.
//
// Параметры:
//  ЭтотОбъект		 - Произвольный				 - Объект документа, который записываем.
//  Отказ			 - Булево					 - Признак отказа транзакции записи/проведения.
//  РежимЗаписи		 - РежимЗаписиДокумента		 - Режим записи исходного документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - Режим проведения исходного документа.
//
Процедура ПередЗаписьюВНачале(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	РежимПерепланирования = ЭтотОбъект.ДополнительныеСвойства.Свойство("РежимПерепланирования")
		И ЭтотОбъект.ДополнительныеСвойства.РежимПерепланирования;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// АктивныйДокументПоКопии
	АктивныйДокумент = АктивныйДокументПоКопии(ЭтотОбъект.Ссылка);
	Если НЕ АктивныйДокумент = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данный документ является копией основного документа" +
			" <" + АктивныйДокумент + ">, изменение запрещено!",
			АктивныйДокумент);
		Отказ = Истина;
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимПерепланирования Тогда
		// Проверить перепроизводство.
		ПроверитьПерепроизводствоДокумента(ЭтотОбъект, Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается в конце обработчика перед записью документов.
//
// Параметры:
//  ЭтотОбъект		 - Произвольный				 - Объект документа, который записываем.
//  Отказ			 - Булево					 - Признак отказа транзакции записи/проведения.
//  РежимЗаписи		 - РежимЗаписиДокумента		 - Режим записи исходного документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - Режим проведения исходного документа.
//
Процедура ПередЗаписьюВКонце(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	РежимПерепланирования = ЭтотОбъект.ДополнительныеСвойства.Свойство("РежимПерепланирования")
		И ЭтотОбъект.ДополнительныеСвойства.РежимПерепланирования;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// СохранитьРазницуИнгредиентов
	Если РежимПерепланирования Тогда
		СохранитьРазницуИнгредиентов(ЭтотОбъект);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// СохранитьАудиторскийСледДокумента
	Если РежимПерепланирования И (ЭтотОбъект.ДополнительныеСвойства.Свойство("РазницаТоваров")
		ИЛИ ЭтотОбъект.ДополнительныеСвойства.Свойство("СрезДокументов")) Тогда
		// Создание копии документа в режиме перепланирования.
		Отказ = НЕ СохранитьАудиторскийСледДокумента(ЭтотОбъект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается в начале обработчика при записи документов.
//
// Параметры:
//  ЭтотОбъект	 - Произвольный	 - Объект документа, который записываем.
//  Отказ		 - Булево		 - Признак отказа транзакции записи/проведения.
//
Процедура ПриЗаписиВНачале(ЭтотОбъект, Отказ) Экспорт
	
	РежимПерепланирования = ЭтотОбъект.ДополнительныеСвойства.Свойство("РежимПерепланирования")
		И ЭтотОбъект.ДополнительныеСвойства.РежимПерепланирования;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// СохранитьСвязьСРодительскимиЗаказами
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("РодительскиеЗаказы") Тогда
		СохранитьСвязьСРодительскимиЗаказами(ЭтотОбъект, Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимПерепланирования И ЭтотОбъект.ДополнительныеСвойства.Свойство("РазницаТоваров") Тогда
		// Проводим план-меню в режиме перепланирования и задано свойство "РазницаТоваров".
		// Это значит, что мы изменили план-меню на дельту, вызовем пересчет связанных планов-меню.
		ИсправитьСоседниеДокументы(ЭтотОбъект, Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается в конце обработчика при записи документов.
//
// Параметры:
//  ЭтотОбъект	 - Произвольный	 - Объект документа, который записываем.
//  Отказ		 - Булево		 - Признак отказа транзакции записи/проведения.
//
Процедура ПриЗаписиВКонце(ЭтотОбъект, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЭтотОбъект.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////////////
	// Проверка, что даты плана связанных документов не создают коллизий.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСвязанныеЗаказы.ДокументРодитель КАК ДокументРодитель,
	|	питСвязанныеЗаказы.ДокументРодитель.ДатаПлан КАК ДатаПлан,
	|	питСвязанныеЗаказы.ДокументРодитель.Представление КАК ДокументРодительПредставление
	|ИЗ
	|	РегистрСведений.питСвязанныеЗаказы КАК питСвязанныеЗаказы
	|ГДЕ
	|	питСвязанныеЗаказы.ДокументПотомок = &Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питСвязанныеЗаказы.ДокументПотомок КАК ДокументПотомок,
	|	питСвязанныеЗаказы.ДокументПотомок.ДатаПлан КАК ДатаПлан,
	|	питСвязанныеЗаказы.ДокументПотомок.Представление КАК ДокументПотомокПредставление
	|ИЗ
	|	РегистрСведений.питСвязанныеЗаказы КАК питСвязанныеЗаказы
	|ГДЕ
	|	питСвязанныеЗаказы.ДокументРодитель = &Документ";
	
	Запрос.УстановитьПараметр("Документ", ЭтотОбъект.Ссылка);
	
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	
	// Родители (ДатаПлана должна быть больше или равна текущей).
	РезультатЗапроса = РезультатЗапросаПакет[0];
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ДатаПлан < ЭтотОбъект.ДатаПлан Тогда
			Отказ = Истина;
			ТекстОшибки = "Не удалось выполнить проведение по причине: связанный родительский документ <" + ВыборкаДетальныеЗаписи.ДокументРодительПредставление + "> запланирован на более раннюю дату " + ВыборкаДетальныеЗаписи.ДатаПлан;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
			ЗаписьЖурналаРегистрации("питПланМеню", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
	// Потомки (ДатаПлана должна быть меньше или равна текущей).
	РезультатЗапроса = РезультатЗапросаПакет[1];
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ДатаПлан > ЭтотОбъект.ДатаПлан Тогда
			Отказ = Истина;
			ТекстОшибки = "Не удалось выполнить проведение по причине: связанный документ потомок <" + ВыборкаДетальныеЗаписи.ДокументПотомокПредставление + "> запланирован на более позднюю дату " + ВыборкаДетальныеЗаписи.ДатаПлан;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
			ЗаписьЖурналаРегистрации("питПланМеню", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция проверяет, является ли документ копией.
//
// Параметры:
//  СсылкаНаДокумент - Произвольный	 - Ссылка на документ, который проверяем.
// 
// Возвращаемое значение:
//  ДокументСсылка - Ссылка на активный документ, если таковой найден или неопределено.
//
Функция АктивныйДокументПоКопии(СсылкаНаДокумент) Экспорт
	
	Если СсылкаНаДокумент.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питАудиторскийСлед.ДокументКопия КАК ДокументКопия,
	|	питАудиторскийСлед.ДокументАктивный КАК ДокументАктивный
	|ИЗ
	|	РегистрСведений.питАудиторскийСлед КАК питАудиторскийСлед
	|ГДЕ
	|	питАудиторскийСлед.ДокументКопия = &ДокументКопия";
	Запрос.УстановитьПараметр("ДокументКопия", СсылкаНаДокумент);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ДокументАктивный;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Функция вычисляет разность таблиц товаров в переданном запросе.
//
// Параметры:
//  Запрос - Запрос - Объект запроса, в котором располагаются временные таблицы товаров.
//  ИмяТаблицы1 - Строка - Имя временной таблицы 1.
//  ИмяТаблицы2 - Строка - Имя временной таблицы 2.
//  ИмяТаблицыРезультат - Строка - Имя временной таблицы результат, если не задана, то возвращается ТаблицаЗначений.
//  ВыводитьРавныеСтроки - Булево - Выводить ли строки, которые равны по количеству в обеих таблицах.
//
// Возвращаемое значение:
//    Запрос, ТаблицаЗначений - В зависимости от того, задано имя таблицы результат.
Функция РазностьТаблицТоваровЗапрос(Запрос, ИмяТаблицы1, ИмяТаблицы2, ИмяТаблицыРезультат = Неопределено, ВыводитьРавныеСтроки = Ложь) Экспорт
	
	Запрос.Текст = "ВЫБРАТЬ
	|	втТаблица1.Номенклатура КАК Номенклатура,
	|	втТаблица1.Характеристика КАК Характеристика,
	|	-втТаблица1.Количество КАК Количество
	|ПОМЕСТИТЬ втОбъединеннаяТаблица
	|ИЗ
	|	%втТаблица1% КАК втТаблица1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втТаблица2.Номенклатура,
	|	втТаблица2.Характеристика,
	|	втТаблица2.Количество
	|ИЗ
	|	%втТаблица2% КАК втТаблица2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втОбъединеннаяТаблица.Номенклатура КАК Номенклатура,
	|	втОбъединеннаяТаблица.Характеристика КАК Характеристика,
	|	СУММА(втОбъединеннаяТаблица.Количество) КАК Количество
	|%ПОМЕСТИТЬ втРазностьТаблиц%
	|ИЗ
	|	втОбъединеннаяТаблица КАК втОбъединеннаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	втОбъединеннаяТаблица.Номенклатура,
	|	втОбъединеннаяТаблица.Характеристика";
	Если НЕ ВыводитьРавныеСтроки Тогда
		Запрос.Текст = Запрос.Текст + "
		|ИМЕЮЩИЕ
		|	СУММА(втОбъединеннаяТаблица.Количество) <> 0";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%втТаблица1%", ИмяТаблицы1);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%втТаблица2%", ИмяТаблицы2);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ПОМЕСТИТЬ втРазностьТаблиц%", ?(ИмяТаблицыРезультат = Неопределено, "", "ПОМЕСТИТЬ " + ИмяТаблицыРезультат));
	
	Если ИмяТаблицыРезультат = Неопределено Тогда
		Возврат Запрос.Выполнить().Выгрузить();
	Иначе
		Возврат Запрос.Выполнить();
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДействияПередЗаписью

// Процедура - Проверить перепроизводство документа.
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  Отказ - Булево - Отказ.
//
Процедура ПроверитьПерепроизводствоДокумента(ЭтотОбъект, Отказ)
	Если НЕ ЭтотОбъект.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питПланМенюТовары.Номенклатура КАК Номенклатура,
	|	питПланМенюТовары.Количество КАК Количество,
	|	питПланМенюТовары.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	&ТаблицаТоваров КАК питПланМенюТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	СУММА(втТовары.Количество) КАК Количество,
	|	втТовары.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ втТоварыСгруппированные
	|ИЗ
	|	втТовары КАК втТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	втТовары.Номенклатура,
	|	втТовары.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питВыпускБлюдТовары.Номенклатура КАК Номенклатура,
	|	питВыпускБлюдТовары.Характеристика КАК Характеристика,
	|	СУММА(питВыпускБлюдТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ втВыпуски
	|ИЗ
	|	Документ.питВыпускБлюд.Товары КАК питВыпускБлюдТовары
	|ГДЕ
	|	питВыпускБлюдТовары.Ссылка.Проведен
	|	И питВыпускБлюдТовары.Ссылка.ДокументОснование = &ПланМеню
	|
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдТовары.Номенклатура,
	|	питВыпускБлюдТовары.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыСгруппированные.Номенклатура КАК Номенклатура,
	|	втТоварыСгруппированные.Количество КАК КоличествоПлан,
	|	втТоварыСгруппированные.Характеристика КАК Характеристика,
	|	втТоварыСгруппированные.Номенклатура.Представление КАК НоменклатураПредставление,
	|	втТоварыСгруппированные.Характеристика.Представление КАК ХарактеристикаПредставление,
	|	ЕСТЬNULL(втВыпуски.Количество, 0) КАК КоличествоФакт,
	|	втТоварыСгруппированные.Количество - ЕСТЬNULL(втВыпуски.Количество, 0) КАК КоличествоПроизвести
	|ИЗ
	|	втТоварыСгруппированные КАК втТоварыСгруппированные
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВыпуски КАК втВыпуски
	|		ПО втТоварыСгруппированные.Номенклатура = втВыпуски.Номенклатура
	|			И втТоварыСгруппированные.Характеристика = втВыпуски.Характеристика";
	ТаблицаТоваровИсходная = ЭтотОбъект.Товары.Выгрузить();
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваровИсходная);
	Запрос.УстановитьПараметр("ПланМеню", ЭтотОбъект.Ссылка);
	ТаблицаПланФакт = Запрос.Выполнить().Выгрузить();
	ПоляДляПоиска = "Номенклатура, Характеристика";
	ТаблицаПланФакт.Индексы.Добавить(ПоляДляПоиска);
	СтруктураПоиска = Новый Структура(ПоляДляПоиска);
	
	КэшированныеЗначенияУпаковок = Неопределено;
	
	ТоварыИзменены = Ложь;
	Для каждого ТекущаяСтрокаТоваров Из ЭтотОбъект.Товары Цикл
		
		// Ищем текущую строку товаров в таблице план-факт.
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекущаяСтрокаТоваров);
		НайденныеСтроки = ТаблицаПланФакт.НайтиСтроки(СтруктураПоиска);
		Если НЕ НайденныеСтроки.Количество() Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПланФакт = НайденныеСтроки[0];
		
		Если СтрокаПланФакт.КоличествоПроизвести >= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Определяем, на сколько перепроизвели текущую строку.
		КоличествоИзменить = Мин(СтрокаПланФакт.КоличествоПроизвести*-1, ТекущаяСтрокаТоваров.Количество);
//   КоличествоУпаковокИзменить = Мин(СтрокаПланФакт.КоличествоУпаковокПроизвести*-1,
// ТекущаяСтрокаТоваров.КоличествоУпаковок);.
		КоличествоУпаковокИзменить = КоличествоИзменить * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекущаяСтрокаТоваров.Номенклатура, ТекущаяСтрокаТоваров.Упаковка, КэшированныеЗначенияУпаковок);
		
		// Сообщение о перепроизводстве
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе <" 
			+ ЭтотОбъект.Ссылка + "> зафиксировано перепроизводство <" + СтрокаПланФакт.НоменклатураПредставление 
			+ ?(ПустаяСтрока(СтрокаПланФакт.ХарактеристикаПредставление) , "", ", ") + СтрокаПланФакт.ХарактеристикаПредставление
			+ "> в количестве <" + (КоличествоУпаковокИзменить) + "> " + ТекущаяСтрокаТоваров.Упаковка + "", ЭтотОбъект.Ссылка);
		
		// Увеличиваем строку товаров и увеличиваем план-факт.
		ТекущаяСтрокаТоваров.Количество = ТекущаяСтрокаТоваров.Количество + КоличествоИзменить;
		ТекущаяСтрокаТоваров.КоличествоУпаковок = ТекущаяСтрокаТоваров.КоличествоУпаковок + КоличествоУпаковокИзменить;
		СтрокаПланФакт.КоличествоПроизвести = СтрокаПланФакт.КоличествоПроизвести + КоличествоИзменить;
		СтрокаПланФакт.КоличествоПлан = СтрокаПланФакт.КоличествоПлан + КоличествоИзменить;
		
		ТоварыИзменены = Истина;
		
	КонецЦикла;
	
	Если ТоварыИзменены Тогда
		ТаблицаТоваровНовая = ЭтотОбъект.Товары.Выгрузить();
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ТаблицаПерепроизводства", РазностьТаблицТоваров(ТаблицаТоваровНовая, ТаблицаТоваровИсходная));
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Сохранить разницу ингредиентов.
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//
Процедура СохранитьРазницуИнгредиентов(ЭтотОбъект)
	
	Если ЭтотОбъект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.питПланМеню") 
		И НЕ ЭтотОбъект.Ссылка.Пустая() Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	втНовыеИнгредиенты.Ингредиент КАК Номенклатура,
		|	втНовыеИнгредиенты.Характеристика КАК Характеристика,
		|	втНовыеИнгредиенты.КоличествоИнгредиентаФакт КАК Количество
		|ПОМЕСТИТЬ
		|	втНовыеИнгредиенты
		|ИЗ
		|	&НовыеИнгредиенты КАК втНовыеИнгредиенты
		|;
		|
		|////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	питПланМенюИнгредиенты.Ингредиент КАК Номенклатура,
		|	питПланМенюИнгредиенты.Характеристика КАК Характеристика,
		|	питПланМенюИнгредиенты.КоличествоИнгредиентаФакт КАК Количество
		|ПОМЕСТИТЬ втСтарыеИнгредиенты
		|ИЗ
		|	Документ.питПланМеню.Ингредиенты КАК питПланМенюИнгредиенты
		|ГДЕ
		|	питПланМенюИнгредиенты.Ссылка = &Ссылка
		|	И питПланМенюИнгредиенты.Ссылка.Проведен
		|	И питПланМенюИнгредиенты.ИзАвтопеределов = ЛОЖЬ
		|";
		Запрос.УстановитьПараметр("НовыеИнгредиенты", ЭтотОбъект.Ингредиенты.Выгрузить());
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.Выполнить();
		
		// Вычисляем разность таблиц
		РазностьТаблицТоваровЗапрос(Запрос, "втСтарыеИнгредиенты", "втНовыеИнгредиенты", "втДельта");
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	втДельта.Номенклатура КАК Номенклатура,
		|	втДельта.Характеристика КАК Характеристика,
		|	СУММА(втДельта.Количество) КАК Количество,
		|	&Склад КАК Склад
		|ПОМЕСТИТЬ
		|	втДельтаСгруппированная
		|ИЗ
		|	втДельта КАК втДельта
		|
		|СГРУППИРОВАТЬ ПО
		|	втДельта.Номенклатура,
		|	втДельта.Характеристика
		|
		|ИМЕЮЩИЕ
		|	СУММА(втДельта.Количество) <> 0
		|;
		|
		| "+СтрЗаменить(РегистрыСведений.СхемыОбеспечения.ВременнаяТаблицаСпособыОбеспечения("ВЫЧИСЛЯТЬ"), "ВтТовары", "втДельтаСгруппированная") + "
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДельтаСгруппированная.Номенклатура КАК Номенклатура,
		|	втДельтаСгруппированная.Характеристика КАК Характеристика,
		|	втДельтаСгруппированная.Количество КАК Количество,
		|	ЕСТЬNULL(ВтСпособыОбеспечения.СпособОбеспеченияПотребностей, ЗНАЧЕНИЕ(Справочник.СпособыОбеспеченияПотребностей.ПустаяСсылка)) КАК СпособОбеспечения
		|ИЗ
		|	втДельтаСгруппированная КАК втДельтаСгруппированная
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВтСпособыОбеспечения КАК ВтСпособыОбеспечения
		|		ПО втДельтаСгруппированная.Номенклатура = ВтСпособыОбеспечения.Номенклатура
		|		И втДельтаСгруппированная.Характеристика = ВтСпособыОбеспечения.Характеристика
		|		И втДельтаСгруппированная.Склад = ВтСпособыОбеспечения.Склад
		|ГДЕ
		|	ВтСпособыОбеспечения.СпособОбеспеченияПотребностей.ТипОбеспечения = ЗНАЧЕНИЕ(Перечисление.ТипыОбеспечения.питПроизводство)
		|";
		Запрос.УстановитьПараметр("НовыеИнгредиенты", ЭтотОбъект.Ингредиенты.Выгрузить());
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("Склад", ЭтотОбъект.ЦеховаяКладовая);
		РазницаТоваров = Запрос.Выполнить().Выгрузить();
		РазницаТоваров.Индексы.Добавить("Номенклатура, Характеристика");
		Если РазницаТоваров.Количество() Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("РазницаТоваров", РазницаТоваров);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция вычисляет разность переданных таблиц товаров.
//
// Параметры:
//  ТаблицаТоваровИсходная - ТаблицаЗначений - Первая таблица.
//  ТаблицаТоваровНовая - ТаблицаЗначений - Вторая таблица.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица результат.
Функция РазностьТаблицТоваров(ТаблицаТоваровИсходная, ТаблицаТоваровНовая)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица1.Номенклатура КАК Номенклатура,
	|	Таблица1.Характеристика КАК Характеристика,
	|	Таблица1.Количество КАК Количество
	|ПОМЕСТИТЬ втТаблица1
	|ИЗ
	|	&Таблица1 КАК Таблица1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица2.Номенклатура КАК Номенклатура,
	|	Таблица2.Характеристика КАК Характеристика,
	|	Таблица2.Количество КАК Количество
	|ПОМЕСТИТЬ втТаблица2
	|ИЗ
	|	&Таблица2 КАК Таблица2";
	Запрос.УстановитьПараметр("Таблица1", ТаблицаТоваровИсходная);
	Запрос.УстановитьПараметр("Таблица2", ТаблицаТоваровНовая);
	Запрос.Выполнить();
	
	Возврат РазностьТаблицТоваровЗапрос(Запрос, "втТаблица1", "втТаблица2");
	
КонецФункции

// Функция сохраняет версию переданного документа и делает запись в соответствующий регистр.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка.<ИмяДокумента> - Ссылка на документ, версию которого создаем.
//
// Возвращаемое значение:
//  Булево - Результат копирования.
Функция СохранитьАудиторскийСледДокумента(СсылкаНаДокумент)
	
	Если СсылкаНаДокумент.Пустая() Тогда
		ТекстОшибки = "Ошибка сохранения версии документа <" + СсылкаНаДокумент + "> по причине: 
		|Данная функция недоступна для нового документа";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	ДокументКопия = СсылкаНаДокумент.Скопировать();
	ДокументКопия.Дата = ТекущаяДата();
	ТекстОшибки = питОбщегоНазначенияСервер.ЗаписатьДокументВПопытке(ДокументКопия, РежимЗаписиДокумента.Запись, Истина);
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Ошибка сохранения версии документа <" + СсылкаНаДокумент + "> по причине: 
		|" + ТекстОшибки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.питАудиторскийСлед.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументАктивный = СсылкаНаДокумент;
	МенеджерЗаписи.ДокументКопия = ДокументКопия.Ссылка;
	ТекстОшибки = питОбщегоНазначенияСервер.ЗаписатьМенеджерЗаписиВПопытке(МенеджерЗаписи);
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Ошибка сохранения версии документа <" + СсылкаНаДокумент + "> по причине: 
		|" + ТекстОшибки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ДействияПриЗаписи

#Область ИсправитьСоседниеДокументы

// Процедура - Исправить соседние документы.
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  Отказ - Булево - Отказ.
//
Процедура ИсправитьСоседниеДокументы(ЭтотОбъект, Отказ)
	
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("РазницаТоваров") Тогда
		Возврат;
	КонецЕсли;
	
	КэшированныеЗначенияУпаковок = Неопределено;
	
	// Таблица с дельтой.
	РазницаТоваров = ЭтотОбъект.ДополнительныеСвойства.РазницаТоваров;
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика");
	
	// Получаем текущий срез документов
	ДанныеСреза = ДанныеСрезаДокументов(ЭтотОбъект);
	СрезДокументов = ДанныеСреза.СрезДокументов;
	
	// Получаем соседей вниз по графу.
	СоседниеЗаказыПотомки = ГрафЗаказов_ПолучитьСоседейВершиныВниз(ЭтотОбъект.Ссылка);
	
	Для каждого СоседнийЗаказ Из СоседниеЗаказыПотомки Цикл
		
		// Обходим ближайших потомков вниз.
		СоседнийЗаказОбъект = СоседнийЗаказ.ПолучитьОбъект();
		Если НЕ СоседнийЗаказОбъект.Проведен Тогда
			Продолжить;
		КонецЕсли;
		
		// Фиксируем, изменили мы или нет текущий документ-объект.
		ЕстьИзменения = Ложь;
		// Изменяем потомка на дельту
		Для каждого СтрокаТоварыСоседа Из СоседнийЗаказОбъект.Товары Цикл
			// Обход таблицы товаров.
			// Поиск текущего товара в таблице разницы.
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТоварыСоседа);
			НайденнаяРазница = РазницаТоваров.НайтиСтроки(СтруктураПоиска);
			Если НайденнаяРазница.Количество() Тогда
				// Нашли строку в таблице разницы.
				СтрокаРазницы = НайденнаяРазница[0];
				
				// Отделяем знак разницы от количества.
				ЗнакРазницы = ?(СтрокаРазницы.Количество > 0, 1, -1);
				КоличествоРазницы = ?(СтрокаРазницы.Количество > 0, СтрокаРазницы.Количество, -СтрокаРазницы.Количество);
//   КоличествоУпаковокРазницы = ?(СтрокаРазницы.КоличествоУпаковок > 0, СтрокаРазницы.КоличествоУпаковок,
// -СтрокаРазницы.КоличествоУпаковок);.
				КоличествоУпаковокРазницы = КоличествоРазницы * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаТоварыСоседа.Номенклатура, СтрокаТоварыСоседа.Упаковка, КэшированныеЗначенияУпаковок);
				
				// Определяем, на сколько будем менять строку товаров.
				Если ЗнакРазницы = -1 Тогда
					// Если уменьшаем количество, то мы не можем уменьшить больше чем количество товара(уйти в минус).
					КоличествоИзменить = Мин(КоличествоРазницы, СтрокаТоварыСоседа.Количество);
					КоличествоУпаковокИзменить = Мин(КоличествоУпаковокРазницы, СтрокаТоварыСоседа.КоличествоУпаковок);
				Иначе
					// А если увеличиваем количество, то можно.
					КоличествоИзменить = КоличествоРазницы;
					КоличествоУпаковокИзменить = КоличествоУпаковокРазницы;
				КонецЕсли;
				
				Если КоличествоИзменить = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				// Меняем строку товаров.
				СтрокаТоварыСоседа.Количество = СтрокаТоварыСоседа.Количество + КоличествоИзменить * ЗнакРазницы;
				СтрокаТоварыСоседа.КоличествоУпаковок = СтрокаТоварыСоседа.КоличествоУпаковок + КоличествоУпаковокИзменить * ЗнакРазницы;
				
				// Меняем строку разницы.
				СтрокаРазницы.Количество = СтрокаРазницы.Количество - КоличествоИзменить * ЗнакРазницы;
				Если СтрокаРазницы.Количество = 0 Тогда
					РазницаТоваров.Удалить(СтрокаРазницы);
				КонецЕсли;
				
				// Фиксируем, что поменяли документ-объект.
				ЕстьИзменения = Истина;
			КонецЕсли;
		КонецЦикла;
		
		// Перепроводим документ, если меняли его.
		Если ЕстьИзменения Тогда
			Массив_УдалитьПоЗначению(СрезДокументов, СоседнийЗаказ);
			СоседнийЗаказОбъект.ДополнительныеСвойства.Вставить("РежимПерепланирования", Истина);
			СоседнийЗаказОбъект.ДополнительныеСвойства.Вставить("СрезДокументов", СрезДокументов);
			СоседнийЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СрезДокументов = СоседнийЗаказОбъект.ДополнительныеСвойства.СрезДокументов;
			
			// Зафиксировано перепроизводство
			Если СоседнийЗаказОбъект.ДополнительныеСвойства.Свойство("ТаблицаПерепроизводства") Тогда
				Для каждого СтрокаПерепроизводства Из СоседнийЗаказОбъект.ДополнительныеСвойства.ТаблицаПерепроизводства Цикл
					ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаПерепроизводства);
					НайденнаяРазница = РазницаТоваров.НайтиСтроки(СтруктураПоиска);
					Если НайденнаяРазница.Количество() Тогда
						// Меняем строку разницы.
						СтрокаРазницы = НайденнаяРазница[0];
						СтрокаРазницы.Количество = СтрокаРазницы.Количество + СтрокаПерепроизводства.Количество;
					Иначе
						СтрокаРазницы = РазницаТоваров.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаРазницы, СтрокаПерепроизводства,,"Количество");
						СтрокаРазницы.Количество = СтрокаПерепроизводства.Количество;
					КонецЕсли;
					Если СтрокаРазницы.Количество = 0 Тогда
						РазницаТоваров.Удалить(СтрокаРазницы);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		// Если таблица разницы закончилась, то можем не продолжать обход соседей.
		Если НЕ РазницаТоваров.Количество() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеСреза.МыИзначальноПроводимыйДокумент Тогда
		// Сохраняем аудиторский след для тех документов среза, которые мы не меняли.
		Для каждого ОставшийсяДокументСреза Из СрезДокументов Цикл
			СохранитьАудиторскийСледДокумента(ОставшийсяДокументСреза);
		КонецЦикла;
		// Копирование записей в регистре "питСвязанныеДокументы" по всему срезу документов в копии этих документов.
		СкопироватьСвязиДокументовВКопии(ЭтотОбъект, ДанныеСреза, Отказ);
	КонецЕсли;

КонецПроцедуры

// Текущий срез документов, получаем его если не был передан извне(мы является изначально проводимым документом)
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДанныеСрезаДокументов(ЭтотОбъект)
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("СрезДокументов") Тогда
		СрезДокументов = ЭтотОбъект.ДополнительныеСвойства.СрезДокументов;
		ПосещенныеДуги = Неопределено;
		ПосещенныеВершины = Неопределено;
		МыИзначальноПроводимыйДокумент = Ложь;
	Иначе
		// Ищем полный срез документов
		ПосещенныеВершиныИДуги = ГрафЗаказов_ПоискВШирину(ЭтотОбъект.Ссылка);
		ПосещенныеДуги = ПосещенныеВершиныИДуги.ПосещенныеДуги;
		ПосещенныеВершины = ПосещенныеВершиныИДуги.ПосещенныеВершины;
		СрезДокументов = Новый Массив;
		Для каждого ПосещеннаяВершина Из ПосещенныеВершины Цикл
			СрезДокументов.Добавить(ПосещеннаяВершина);
		КонецЦикла;
		// Текущий документ удаляем из среза, т.к. мы его уже обработали
		Массив_УдалитьПоЗначению(СрезДокументов, ЭтотОбъект.Ссылка);
		МыИзначальноПроводимыйДокумент = Истина;
	КонецЕсли;
	
	// Текущий срез документов, получаем его если не был передан извне(мы является изначально проводимым документом)
	Возврат Новый Структура("СрезДокументов, МыИзначальноПроводимыйДокумент, ПосещенныеВершины, ПосещенныеДуги",
		СрезДокументов, МыИзначальноПроводимыйДокумент, ПосещенныеВершины, ПосещенныеДуги);
	
КонецФункции

// Копирование записей в регистре "питСвязанныеДокументы" по всему срезу документов в копии этих документов.
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  ДанныеСреза - Произвольный - Данные среза.
//  Отказ - Булево - Отказ.
//
Процедура СкопироватьСвязиДокументовВКопии(ЭтотОбъект, ДанныеСреза, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питАудиторскийСлед.ДокументАктивный КАК ДокументАктивный,
	|	МАКСИМУМ(питАудиторскийСлед.ДокументКопия) КАК ДокументКопия
	|ПОМЕСТИТЬ втВерсии
	|ИЗ
	|	РегистрСведений.питАудиторскийСлед КАК питАудиторскийСлед
	|ГДЕ
	|	питАудиторскийСлед.ДокументАктивный В(&ПосещенныеВершины)
	|
	|СГРУППИРОВАТЬ ПО
	|	питАудиторскийСлед.ДокументАктивный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тзПосещенныеДуги.ДокументРодитель КАК ДокументРодитель,
	|	тзПосещенныеДуги.ДокументПотомок КАК ДокументПотомок
	|ПОМЕСТИТЬ втПосещенныеДуги
	|ИЗ
	|	&тзПосещенныеДуги КАК тзПосещенныеДуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втВерсии.ДокументКопия КАК ДокументРодитель,
	|	втВерсии1.ДокументКопия КАК ДокументПотомок
	|ИЗ
	|	втПосещенныеДуги КАК втПосещенныеДуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВерсии КАК втВерсии
	|		ПО втПосещенныеДуги.ДокументРодитель = втВерсии.ДокументАктивный
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВерсии КАК втВерсии1
	|		ПО втПосещенныеДуги.ДокументПотомок = втВерсии1.ДокументАктивный
	|ГДЕ
	|	НЕ втВерсии.ДокументКопия ЕСТЬ NULL
	|	И НЕ втВерсии1.ДокументКопия ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ПосещенныеВершины", ДанныеСреза.ПосещенныеВершины);
	Запрос.УстановитьПараметр("тзПосещенныеДуги", ДанныеСреза.ПосещенныеДуги);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.питСвязанныеЗаказы.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
		ТекстОшибки = питОбщегоНазначенияСервер.ЗаписатьМенеджерЗаписиВПопытке(МенеджерЗаписи);
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибка сохранения версии документа <" + ЭтотОбъект.Ссылка + "> по причине: 
			|" + ТекстОшибки;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Процедура - Сохранить связь с родительскими заказами.
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  Отказ - Булево - Отказ.
//
Процедура СохранитьСвязьСРодительскимиЗаказами(ЭтотОбъект, Отказ)
	
	// Проводим план-меню и видим параметр "РодительскиеЗаказы"
	// Он пришел к нам из обработки "Формирование планов-меню по потребностям"
	// (питНоменклатураПроизводства.СоздатьДокументыОбщепит)
	РодительскиеЗаказы = ЭтотОбъект.ДополнительныеСвойства.РодительскиеЗаказы;
	
	// Заполняем регистр связей
	НаборЗаписей = РегистрыСведений.питСвязанныеЗаказы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументПотомок.Установить(ЭтотОбъект.Ссылка);
	Для каждого РодительскийЗаказ Из РодительскиеЗаказы Цикл
		НовЗапись = НаборЗаписей.Добавить();
		НовЗапись.ДокументПотомок = ЭтотОбъект.Ссылка;
		НовЗапись.ДокументРодитель = РодительскийЗаказ;
	КонецЦикла;
	ТекстОшибки = питОбщегоНазначенияСервер.ЗаписатьНаборЗаписейВПопытке(НаборЗаписей);
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Ошибка записи в регистр связанных заказов общепита по причине: 
		|" + ТекстОшибки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ГрафЗаказов

// Функция - Граф заказов получить соседей вершины вниз.
//
// Параметры:
//  Вершина - Произвольный - Вершина.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ГрафЗаказов_ПолучитьСоседейВершиныВниз(Вершина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСвязанныеЗаказы.ДокументПотомок КАК ДокументПотомок
	|ИЗ
	|	РегистрСведений.питСвязанныеЗаказы КАК питСвязанныеЗаказы
	|ГДЕ
	|	питСвязанныеЗаказы.ДокументРодитель = &Вершина";
	Запрос.УстановитьПараметр("Вершина", Вершина);
	МассивЗаказов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументПотомок");
	
	Возврат МассивЗаказов;
	
КонецФункции

// Функция - Граф заказов получить соседей вершины вверх.
//
// Параметры:
