// Функция - Массив удалить по значению.
//
// Параметры:
//  МассивЭлементов - Массив - Массив элементов.
//  ЗначениеУдалить - Произвольный - Значение удалить.
//
// Возвращаемое значение:
//  Массив - Результат обработки.
Функция Массив_УдалитьПоЗначению(МассивЭлементов, ЗначениеУдалить)
	
	НайденныйИндекс = -1;
	Для Индекс = 0 По МассивЭлементов.ВГраница() Цикл
		Если МассивЭлементов[Индекс] = ЗначениеУдалить Тогда
			НайденныйИндекс = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденныйИндекс = -1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
