	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСвязанныеЗаказы.ДокументРодитель КАК ДокументРодитель
	|ИЗ
	|	РегистрСведений.питСвязанныеЗаказы КАК питСвязанныеЗаказы
	|ГДЕ
	|	питСвязанныеЗаказы.ДокументПотомок = &Вершина";
	Запрос.УстановитьПараметр("Вершина", Вершина);
	МассивЗаказов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументРодитель");
	
	Возврат МассивЗаказов;
	
