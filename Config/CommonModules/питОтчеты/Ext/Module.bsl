
#Область ПрограммныйИнтерфейс

#Область ТекстЗапросаДляСебестоимостиИнгредиентов

// Функция получает текст запроса себестоимости выпускаемых блюд и их ингредиентов.
//
// Параметры:
//  БлюдаИИнгредиентыОтдельно - Булево - Если Истина, тогда результирующая таблица в колонке "Номенклатура"
//   будет содержать как блюда так и ингредиенты, а также колонку "ЭтоБлюдо" и ссылку на номенклатуру блюда в
//   колонке "НоменклатураБлюда" для ингредиентов.
//   Если Ложь, тогда в результирующей таблице в колонке "Номенклатура" будут только ингредиенты, также появится
//   колонка "КоличествоБлюда" и "Рецептура", по которой текущий ингредиент входит в состав блюда в текущем
//   выпуске.
//  ТолькоБлюда - Булево - Если БлюдаИИнгредиентыОтдельно = Истина, то данный флаг будет влиять на то.
//  ИмяДокумента - Произвольный - Имя документа.
//  ИмяТЧБлюда - Произвольный - Имя тч блюда.
//
// Возвращаемое значение:
//  Строка - Текст запроса, получающий временную таблицу "резТаблицаСебестоимости".
Функция ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов(БлюдаИИнгредиентыОтдельно = Истина, ТолькоБлюда = Истина, ИмяДокумента = "питВыпускБлюд", ИмяТЧБлюда = "Блюда") Экспорт
	
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22);
	ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов22 = ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен;
	
	Если ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов22 Тогда
		ТекстЗапросаШаблон = 
		"%1
		|;
		|%2";
		ТекстЗапроса = СтрШаблон(ТекстЗапросаШаблон, 
			ПолучитьТекстЗапросаВТВыпускиПродукции22ПоСсылке("втВыпускиПродукции", ИмяДокумента),
			ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов22("втВыпускиПродукции", БлюдаИИнгредиентыОтдельно, ТолькоБлюда, ИмяДокумента, ИмяТЧБлюда));
	Иначе
		ТекстЗапроса = ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов21(БлюдаИИнгредиентыОтдельно, ТолькоБлюда);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции


// Функция получает текст запроса себестоимости выпускаемых блюд и их ингредиентов.
//
// Параметры:
//  ИмяВТВыпускиПродукции - Произвольный - Имя вт выпуски продукции.
//  БлюдаИИнгредиентыОтдельно - Булево - Если Истина, тогда результирующая таблица в колонке "Номенклатура"
//   будет содержать как блюда так и ингредиенты, а также колонку "ЭтоБлюдо" и ссылку на номенклатуру блюда в
//   колонке "НоменклатураБлюда" для ингредиентов.
//   Если Ложь, тогда в результирующей таблице в колонке "Номенклатура" будут только ингредиенты, также появится
//   колонка "КоличествоБлюда" и "Рецептура", по которой текущий ингредиент входит в состав блюда в текущем
//   выпуске.
//  ТолькоБлюда - Булево - Если БлюдаИИнгредиентыОтдельно = Истина, то данный флаг будет влиять на то.
//  ИмяДокумента - Произвольный - Имя документа.
//  ИмяТЧБлюда - Произвольный - Имя тч блюда.
//
// Возвращаемое значение:
//  Строка - Текст запроса, получающий временную таблицу "резТаблицаСебестоимости".
Функция ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов22(ИмяВТВыпускиПродукции, БлюдаИИнгредиентыОтдельно, ТолькоБлюда, ИмяДокумента = "питВыпускБлюд", ИмяТЧБлюда = "Блюда") Экспорт
	
	ТекстЗапроса = "
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СебестоимостьТоваров.Регистратор КАК Регистратор,
	|	СебестоимостьТоваров.РазделУчета КАК РазделУчета,
	|	СебестоимостьТоваров.ВидДвижения КАК ВидДвижения,
	|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	СебестоимостьТоваров.Количество КАК Количество,
	|	СебестоимостьТоваров.Стоимость КАК Стоимость,
	|	СебестоимостьТоваров.СтоимостьБезНДС КАК СтоимостьБезНДС,
	|	СебестоимостьТоваров.СтоимостьРегл КАК СтоимостьРегл,
	|	СебестоимостьТоваров.РасчетПартий КАК РасчетПартий,
	|	СебестоимостьТоваров.РасчетСебестоимости КАК РасчетСебестоимости, 
	|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры
	|ПОМЕСТИТЬ втДвиженияСебестоимости
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
	|ГДЕ
	|	СебестоимостьТоваров.Регистратор В
	|			(ВЫБРАТЬ
	|				вт.ВыпускПродукции
	|			ИЗ втВыпускиПродукции КАК вт)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	СебестоимостьТоваров.Регистратор КАК Регистратор,
	|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры
	|ПОМЕСТИТЬ втАналитикиВыпускаБлюд
	|ИЗ
	|	втДвиженияСебестоимости КАК СебестоимостьТоваров
	|ГДЕ
	|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры = ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка)
	|	И СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И СебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты)
	|СГРУППИРОВАТЬ ПО
	|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры,
	|	СебестоимостьТоваров.Регистратор,
	|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	СебестоимостьТоваров.Регистратор КАК Регистратор,
	|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры
	|ПОМЕСТИТЬ втАналитикиВыпуска
	|ИЗ
	|	втДвиженияСебестоимости КАК СебестоимостьТоваров
	|ГДЕ
	|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры <> Неопределено
	|	И СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И СебестоимостьТоваров.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НезавершенноеПроизводство)
	|СГРУППИРОВАТЬ ПО
	|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры,
	|	СебестоимостьТоваров.Регистратор,
	|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втАналитикиВыпуска.Регистратор КАК Регистратор,
	|	втАналитикиВыпуска.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	втАналитикиВыпуска.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.Количество, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.Стоимость, 0)) КАК Стоимость,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.СтоимостьБезНДС, 0)) КАК СтоимостьБезНДС,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.СтоимостьРегл, 0)) КАК СтоимостьРегл
	|ПОМЕСТИТЬ втСебестоимостиБлюд
	|ИЗ
	|	втАналитикиВыпускаБлюд КАК втАналитикиВыпуска
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДвиженияСебестоимости КАК СебестоимостьТоваров
	|		ПО втАналитикиВыпуска.АналитикаУчетаНоменклатуры = СебестоимостьТоваров.АналитикаУчетаНоменклатуры
	|		И втАналитикиВыпуска.КорАналитикаУчетаНоменклатуры = СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры
	|ГДЕ
	|	СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|СГРУППИРОВАТЬ ПО
	|	втАналитикиВыпуска.Регистратор,
	|	втАналитикиВыпуска.АналитикаУчетаНоменклатуры,
	|	втАналитикиВыпуска.КорАналитикаУчетаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втАналитикиВыпуска.Регистратор КАК Регистратор,
	|	втАналитикиВыпуска.Регистратор.Дата КАК РегистраторДата,
	|	втАналитикиВыпуска.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	втАналитикиВыпуска.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.Количество, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.Стоимость, 0)) КАК Стоимость,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.СтоимостьБезНДС, 0)) КАК СтоимостьБезНДС,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.СтоимостьРегл, 0)) КАК СтоимостьРегл
	|ПОМЕСТИТЬ втСебестоимостиВсеРегистраторы
	|ИЗ
	|	втАналитикиВыпуска КАК втАналитикиВыпуска
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДвиженияСебестоимости КАК СебестоимостьТоваров
	|		ПО втАналитикиВыпуска.АналитикаУчетаНоменклатуры = СебестоимостьТоваров.АналитикаУчетаНоменклатуры
	|			И втАналитикиВыпуска.КорАналитикаУчетаНоменклатуры = СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры
	|ГДЕ
	|	СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|
	|СГРУППИРОВАТЬ ПО
	|	втАналитикиВыпуска.Регистратор,
	|	втАналитикиВыпуска.АналитикаУчетаНоменклатуры,
	|	втАналитикиВыпуска.КорАналитикаУчетаНоменклатуры
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втСебестоимостиБлюд.Регистратор КАК Регистратор,
	|	втСебестоимостиБлюд.Регистратор.Дата КАК РегистраторДата,
	|	втСебестоимостиБлюд.АналитикаУчетаНоменклатуры,
	|	втСебестоимостиБлюд.КорАналитикаУчетаНоменклатуры,
	|	втСебестоимостиБлюд.Количество,
	|	втСебестоимостиБлюд.Стоимость,
	|	втСебестоимостиБлюд.СтоимостьБезНДС,
	|	втСебестоимостиБлюд.СтоимостьРегл
	|ИЗ
	|	втСебестоимостиБлюд КАК втСебестоимостиБлюд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(втСебестоимостиВсеРегистраторы.РегистраторДата) КАК РегистраторДата,
	|	втСебестоимостиВсеРегистраторы.АналитикаУчетаНоменклатуры,
	|	втСебестоимостиВсеРегистраторы.КорАналитикаУчетаНоменклатуры
	|ПОМЕСТИТЬ втСебестоимостиМаксДата 
	|ИЗ
	|	втСебестоимостиВсеРегистраторы КАК втСебестоимостиВсеРегистраторы
	|СГРУППИРОВАТЬ ПО
	|	втСебестоимостиВсеРегистраторы.АналитикаУчетаНоменклатуры,
	|	втСебестоимостиВсеРегистраторы.КорАналитикаУчетаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(втСебестоимостиВсеРегистраторы.Регистратор) КАК Регистратор,
	|	втСебестоимостиВсеРегистраторы.АналитикаУчетаНоменклатуры,
	|	втСебестоимостиВсеРегистраторы.КорАналитикаУчетаНоменклатуры
	|ПОМЕСТИТЬ втСебестоимостиМаксРегистратор 
	|ИЗ
	|	втСебестоимостиМаксДата КАК втСебестоимостиМаксДата
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСебестоимостиВсеРегистраторы КАК втСебестоимостиВсеРегистраторы
	|		ПО втСебестоимостиМаксДата.РегистраторДата = втСебестоимостиВсеРегистраторы.РегистраторДата
	|		И втСебестоимостиМаксДата.АналитикаУчетаНоменклатуры = втСебестоимостиВсеРегистраторы.АналитикаУчетаНоменклатуры
	|		И втСебестоимостиМаксДата.КорАналитикаУчетаНоменклатуры = втСебестоимостиВсеРегистраторы.КорАналитикаУчетаНоменклатуры
	|СГРУППИРОВАТЬ ПО
	|	втСебестоимостиВсеРегистраторы.АналитикаУчетаНоменклатуры,
	|	втСебестоимостиВсеРегистраторы.КорАналитикаУчетаНоменклатуры
	|;
    |
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСебестоимостиВсеРегистраторы.Регистратор КАК Регистратор,
	|	втСебестоимостиМаксРегистратор.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	втСебестоимостиМаксРегистратор.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры,
	|	втСебестоимостиВсеРегистраторы.Количество КАК Количество,
	|	втСебестоимостиВсеРегистраторы.Стоимость КАК Стоимость,
	|	втСебестоимостиВсеРегистраторы.СтоимостьБезНДС КАК СтоимостьБезНДС,
	|	втСебестоимостиВсеРегистраторы.СтоимостьРегл КАК СтоимостьРегл
	|ПОМЕСТИТЬ втСебестоимости
	|ИЗ
	|	втСебестоимостиМаксРегистратор КАК втСебестоимостиМаксРегистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСебестоимостиВсеРегистраторы КАК втСебестоимостиВсеРегистраторы
	|		ПО втСебестоимостиМаксРегистратор.Регистратор = втСебестоимостиВсеРегистраторы.Регистратор
	|		И втСебестоимостиМаксРегистратор.АналитикаУчетаНоменклатуры = втСебестоимостиВсеРегистраторы.АналитикаУчетаНоменклатуры
	|		И втСебестоимостиМаксРегистратор.КорАналитикаУчетаНоменклатуры = втСебестоимостиВсеРегистраторы.КорАналитикаУчетаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(АналитикаУчетаНоменклатурыОсн.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(АналитикаУчетаНоменклатурыОсн.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ЕСТЬNULL(АналитикаУчетаНоменклатурыРод.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК НоменклатураБлюда,
	|	ЕСТЬNULL(АналитикаУчетаНоменклатурыРод.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаБлюда,
	|	ВЫБОР
	|		КОГДА АналитикаУчетаНоменклатурыРод.Номенклатура ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоБлюдо,
	|	втСебестоимости.Регистратор КАК Регистратор,
	|	втСебестоимости.Количество КАК Количество,
	|	втСебестоимости.Стоимость КАК Сумма,
	|	втСебестоимости.СтоимостьБезНДС КАК СуммаБезНДС,
	|	втСебестоимости.СтоимостьРегл КАК СуммаРегл
	|"+?(БлюдаИИнгредиентыОтдельно, " ПОМЕСТИТЬ резТаблицаСебестоимости ", " ПОМЕСТИТЬ втСебестоимостиСгруппированная ")+"
	|ИЗ
	|	втСебестоимости КАК втСебестоимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатурыОсн
	|		ПО втСебестоимости.АналитикаУчетаНоменклатуры = АналитикаУчетаНоменклатурыОсн.КлючАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатурыРод
	|		ПО втСебестоимости.КорАналитикаУчетаНоменклатуры = АналитикаУчетаНоменклатурыРод.КлючАналитики
	|"+?(БлюдаИИнгредиентыОтдельно И ТолькоБлюда, "ГДЕ АналитикаУчетаНоменклатурыРод.Номенклатура ЕСТЬ NULL", "")+"
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|";
	Если НЕ БлюдаИИнгредиентыОтдельно Тогда
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ
		|	питВыпускБлюдБлюда.Номенклатура КАК Номенклатура,
		|	питВыпускБлюдБлюда.Характеристика КАК Характеристика,
		|	%ВыборИдентификатораСтроки%
		|	питВыпускБлюдБлюда.Рецептура
		|ПОМЕСТИТЬ втБлюдаВерхнегоУровня
		|ИЗ
		|	Документ.%ИмяДокумента%.%ИмяТЧБлюда% КАК питВыпускБлюдБлюда
		|ГДЕ
		|	питВыпускБлюдБлюда.Ссылка В (ВЫБРАТЬ втВыпускиПродукции.ВыпускБлюд ИЗ втВыпускиПродукции КАК втВыпускиПродукции)
		|	%ОтборАвтопередел%
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СебестоимостиИнгредиентов.Регистратор КАК Регистратор,
		|	СебестоимостиИнгредиентов.Номенклатура КАК Номенклатура,
		|	СебестоимостиИнгредиентов.Характеристика КАК Характеристика,   
		|	СебестоимостиИнгредиентов.НоменклатураБлюда КАК НоменклатураБлюда,
		|	СебестоимостиИнгредиентов.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
		|	ЕСТЬNULL(питВыпускБлюдТовары.Рецептура, ЗНАЧЕНИЕ(Документ.питРецептура.пустаяссылка)) КАК Рецептура,
		|	СУММА(СебестоимостиИнгредиентов.Количество) КАК Количество,
		|	СУММА(ЕСТЬNULL(СебестоимостиТоваров.Количество, 0)) КАК КоличествоБлюда,
		|	СУММА(СебестоимостиИнгредиентов.Сумма) КАК Сумма,
		|	СУММА(СебестоимостиИнгредиентов.СуммаБезНДС) КАК СуммаБезНДС,
		|	СУММА(СебестоимостиИнгредиентов.СуммаРегл) КАК СуммаРегл
		|ПОМЕСТИТЬ резТаблицаСебестоимости
		|ИЗ
		|	втСебестоимостиСгруппированная КАК СебестоимостиИнгредиентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСебестоимостиСгруппированная КАК СебестоимостиТоваров
		|		ПО СебестоимостиИнгредиентов.НоменклатураБлюда = СебестоимостиТоваров.Номенклатура
		|			И СебестоимостиИнгредиентов.ХарактеристикаБлюда = СебестоимостиТоваров.Характеристика
		|			И (ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) = СебестоимостиТоваров.НоменклатураБлюда)
		|		ЛЕВОЕ СОЕДИНЕНИЕ втБлюдаВерхнегоУровня КАК питВыпускБлюдТовары
		|		ПО СебестоимостиИнгредиентов.НоменклатураБлюда = питВыпускБлюдТовары.Номенклатура
		|		И СебестоимостиИнгредиентов.ХарактеристикаБлюда = питВыпускБлюдТовары.Характеристика
		|ГДЕ
		|	НЕ СебестоимостиИнгредиентов.ЭтоБлюдо
		|
		|СГРУППИРОВАТЬ ПО
		|	СебестоимостиИнгредиентов.Регистратор,
		|	СебестоимостиИнгредиентов.Номенклатура,
		|	СебестоимостиИнгредиентов.Характеристика,
		|	СебестоимостиИнгредиентов.НоменклатураБлюда,
		|	СебестоимостиИнгредиентов.ХарактеристикаБлюда,
		|	ЕСТЬNULL(питВыпускБлюдТовары.Рецептура, ЗНАЧЕНИЕ(Документ.питРецептура.пустаяссылка))
		|;
		|";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяТЧБлюда%", ИмяТЧБлюда);
		Если ИмяДокумента = "питВыпускБлюд" Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборАвтопередел%", " И питВыпускБлюдБлюда.Автопередел = ЛОЖЬ ");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВыборИдентификатораСтроки%", " питВыпускБлюдБлюда.ИдентификаторСтроки КАК ИдентификаторСтроки, ");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборАвтопередел%", "");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВыборИдентификатораСтроки%", "");
		КонецЕсли;
		
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяДокумента%", ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИЗ втВыпускиПродукции", СтрШаблон("ИЗ %1", ИмяВТВыпускиПродукции));
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция получает текст запроса себестоимости выпускаемых блюд и их ингредиентов.
//
// Параметры:
//  БлюдаИИнгредиентыОтдельно - Булево - Если Истина, тогда результирующая таблица в колонке "Номенклатура"
//   будет содержать как блюда так и ингредиенты, а также колонку "ЭтоБлюдо" и ссылку на номенклатуру блюда в
//   колонке "НоменклатураБлюда" для ингредиентов.
//   Если Ложь, тогда в результирующей таблице в колонке "Номенклатура" будут только ингредиенты, также появится
//   колонка "КоличествоБлюда" и "Рецептура", по которой текущий ингредиент входит в состав блюда в текущем
//   выпуске.
//  ТолькоБлюда - Булево - Если БлюдаИИнгредиентыОтдельно = Истина, то данный флаг будет влиять на то.
//
// Возвращаемое значение:
//  Строка - Текст запроса, получающий временную таблицу "резТаблицаСебестоимости".
Функция ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов21(БлюдаИИнгредиентыОтдельно, ТолькоБлюда) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ЕСТЬNULL(питТиповыеДокументы.ТиповойДокумент, ЗНАЧЕНИЕ(Документ.ВыпускПродукции.ПустаяСсылка)) КАК ВыпускПродукции,
	|	Выпуск.Ссылка КАК ВыпускБлюд
	|ПОМЕСТИТЬ втВыпускиПродукции
	|ИЗ
	|	Документ.питВыпускБлюд КАК Выпуск
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|		ПО Выпуск.Ссылка = питТиповыеДокументы.ДокументОбщепит
	|ГДЕ
	|	питТиповыеДокументы.ТиповойДокумент ССЫЛКА Документ.ВыпускПродукции
	|	И питТиповыеДокументы.ТиповойДокумент.НаправлениеВыпуска = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукцииНаСклад)
	|	И питТиповыеДокументы.ТиповойДокумент.Проведен
	|	И питТиповыеДокументы.Синхронизирован
	|	И Выпуск.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВыпускПродукцииТовары.АналитикаУчетаНоменклатуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка)) КАК АналитикаУчетаНоменклатуры,
	|	ЕСТЬNULL(ВыпускПродукцииТовары.Ссылка, ЗНАЧЕНИЕ(Документ.ВыпускПродукции.ПустаяСсылка)) КАК Регистратор
	|ПОМЕСТИТЬ втАналитикиВыпуска
	|ИЗ
	|	втВыпускиПродукции КАК втВыпускиПродукции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпускПродукции.Товары КАК ВыпускПродукцииТовары
	|		ПО втВыпускиПродукции.ВыпускПродукции = ВыпускПродукцииТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СебестоимостьТоваров.АналитикаУчетаНоменклатуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка)) КАК АналитикаУчетаНоменклатуры,
	|	ЕСТЬNULL(СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка)) КАК КорАналитикаУчетаНоменклатуры,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.Количество, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.Стоимость, 0)) КАК Стоимость,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.СтоимостьБезНДС, 0)) КАК СтоимостьБезНДС,
	|	СУММА(ЕСТЬNULL(СебестоимостьТоваров.СтоимостьРегл, 0)) КАК СтоимостьРегл
	|ПОМЕСТИТЬ втСебестоимости
	|ИЗ
	|	втАналитикиВыпуска КАК втАналитикиВыпуска
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
	|		ПО (втАналитикиВыпуска.АналитикаУчетаНоменклатуры = СебестоимостьТоваров.АналитикаУчетаНоменклатуры
	|				ИЛИ втАналитикиВыпуска.АналитикаУчетаНоменклатуры = СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры)
	|			И втАналитикиВыпуска.Регистратор = СебестоимостьТоваров.Регистратор
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(СебестоимостьТоваров.АналитикаУчетаНоменклатуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка)),
	|	ЕСТЬNULL(СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры, ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНоменклатуры.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(АналитикаУчетаНоменклатурыОсн.Номенклатура, ЗНАЧЕНИЕ(справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(АналитикаУчетаНоменклатурыРод.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК НоменклатураБлюда,
	|	ВЫБОР
	|		КОГДА АналитикаУчетаНоменклатурыРод.Номенклатура ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоБлюдо,
	|	втСебестоимости.Количество КАК Количество,
	|	втСебестоимости.Стоимость КАК Сумма,
	|	втСебестоимости.СтоимостьБезНДС КАК СуммаБезНДС,
	|	втСебестоимости.СтоимостьРегл КАК СуммаРегл
	|"+?(БлюдаИИнгредиентыОтдельно, " ПОМЕСТИТЬ резТаблицаСебестоимости ", " ПОМЕСТИТЬ втСебестоимостиСгруппированная ")+"
	|ИЗ
	|	втСебестоимости КАК втСебестоимости
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатурыОсн
	|		ПО втСебестоимости.АналитикаУчетаНоменклатуры = АналитикаУчетаНоменклатурыОсн.КлючАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатурыРод
	|		ПО втСебестоимости.КорАналитикаУчетаНоменклатуры = АналитикаУчетаНоменклатурыРод.КлючАналитики
	|"+?(БлюдаИИнгредиентыОтдельно И ТолькоБлюда, "ГДЕ АналитикаУчетаНоменклатурыРод.Номенклатура ЕСТЬ NULL", "")+"
	|;";
	Если НЕ БлюдаИИнгредиентыОтдельно Тогда
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ
		|	питВыпускБлюдБлюда.Номенклатура КАК Номенклатура,
		|	питВыпускБлюдБлюда.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	питВыпускБлюдБлюда.Рецептура
		|ПОМЕСТИТЬ втБлюдаВерхнегоУровня
		|ИЗ
		|	Документ.питВыпускБлюд.Блюда КАК питВыпускБлюдБлюда
		|ГДЕ
		|	питВыпускБлюдБлюда.Ссылка = &Ссылка
		|	И питВыпускБлюдБлюда.Автопередел = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(СебестоимостиИнгредиентов.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
		|	ЕСТЬNULL(СебестоимостиИнгредиентов.НоменклатураБлюда, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК НоменклатураБлюда,
		|	ЕСТЬNULL(питВыпускБлюдТовары.Рецептура, ЗНАЧЕНИЕ(Документ.питРецептура.пустаяссылка)) КАК Рецептура,
		|	СУММА(ЕСТЬNULL(СебестоимостиИнгредиентов.Количество, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(СебестоимостиТоваров.Количество, 0)) КАК КоличествоБлюда,
		|	СУММА(ЕСТЬNULL(СебестоимостиИнгредиентов.Сумма, 0)) КАК Сумма,
		|	СУММА(ЕСТЬNULL(СебестоимостиИнгредиентов.СуммаБезНДС, 0)) КАК СуммаБезНДС,
		|	СУММА(ЕСТЬNULL(СебестоимостиИнгредиентов.СуммаРегл, 0)) КАК СуммаРегл
		|ПОМЕСТИТЬ резТаблицаСебестоимости
		|ИЗ
		|	втСебестоимостиСгруппированная КАК СебестоимостиИнгредиентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ втСебестоимостиСгруппированная КАК СебестоимостиТоваров
		|		ПО СебестоимостиИнгредиентов.НоменклатураБлюда = СебестоимостиТоваров.Номенклатура
		|			И ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) = СебестоимостиТоваров.НоменклатураБлюда
		|		ЛЕВОЕ СОЕДИНЕНИЕ втБлюдаВерхнегоУровня КАК питВыпускБлюдТовары
		|		ПО СебестоимостиИнгредиентов.НоменклатураБлюда = питВыпускБлюдТовары.Номенклатура
		|ГДЕ
		|	НЕ СебестоимостиИнгредиентов.ЭтоБлюдо
		|
		|СГРУППИРОВАТЬ ПО
		|	СебестоимостиИнгредиентов.Номенклатура,
		|	СебестоимостиИнгредиентов.НоменклатураБлюда,
		|	ЕСТЬNULL(питВыпускБлюдТовары.Рецептура, ЗНАЧЕНИЕ(Документ.питРецептура.пустаяссылка))
		|;
		|";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ВыполнениеКомандПечати

// Функция получает заголовок печатной формы общепит
//
// Параметры:
//  ИдентификаторКоманды - Строка - Идентификатор команды печати на форме.
//  СсылкаНаДокумент - ДокументСсылка - Ссылка на документ, для которого вызывается команда печати.
//  ЗаголовокПоУмолчанию - Строка - Заголовок по умолчанию для печатной формы.
//
// Возвращаемое значение:
//  Строка - Сформированный заголовок.
Функция ПолучитьЗаголовокПечатнойФормыОбщепит(ИдентификаторКоманды, СсылкаНаДокумент, ЗаголовокПоУмолчанию = "") Экспорт
	
	ЗаголовокФормы = "";
	Если НЕ ПустаяСтрока(ЗаголовокПоУмолчанию) Тогда
		ЗаголовокФормы = ЗаголовокПоУмолчанию;
	Иначе
		ЗаголовокФормы = "Печать документа";
	КонецЕсли;
	
	Если НЕ ИдентификаторКоманды = Неопределено Тогда
		
		МассивИдентификаторовКомандПФССебестоимостью = питОтчетыКлиентСервер.ПолучитьМассивИдентификаторовКомандПечатныхФормСВычисляемойСебестоимостью();
		Если НЕ МассивИдентификаторовКомандПФССебестоимостью.Найти(ИдентификаторКоманды) = Неопределено Тогда
			
			// Проверяем, была ли рассчитана себестоимость продукции.
			ПроизведенРасчетСебестоимости = питОтчеты.ПроизведенРасчетСебестоимости(СсылкаНаДокумент);
			ЗаголовокФормы = ЗаголовокФормы + " (Себестоимость рассчитана "+?(ПроизведенРасчетСебестоимости,"по фактическим данным","по нормативному виду цен общепита")+")";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗаголовокФормы;
	
