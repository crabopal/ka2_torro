// Возвращает строку для подстановки в условие запроса.
//  # - надо заменить на имя поля, & - надо заменить на имя параметра.
//
// Параметры:
//  ВидСравнения - Произвольный - Вид сравнения.
//
// Возвращаемое значение:
//  Строка - строка для подстановки в текст запроса.
Функция СформироватьСтрокуВидаСравнения(ВидСравнения) Экспорт
	Если ТипЗнч(ВидСравнения)<>Тип("ВидСравнения") Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаУсловия="";
	Если ВидСравнения = ВидСравнения.Равно Тогда
		СтрокаУсловия="#=&";
	ИначеЕсли ВидСравнения=ВидСравнения.НеРавно Тогда
		СтрокаУсловия="#<>&";
	ИначеЕсли ВидСравнения=ВидСравнения.ВСписке Тогда
		СтрокаУсловия = "# В (&)";
	ИначеЕсли ВидСравнения= ВидСравнения.ВИерархии Тогда
		СтрокаУсловия = "# В ИЕРАРХИИ (&)";	
	ИначеЕсли ВидСравнения= ВидСравнения.ВСпискеПоИерархии Тогда
		СтрокаУсловия = "# В ИЕРАРХИИ (&)";
	ИначеЕсли ВидСравнения= ВидСравнения.НеВСписке Тогда
		СтрокаУсловия = "НЕ # В (&)";
	ИначеЕсли ВидСравнения= ВидСравнения.НеВСпискеПоИерархии Тогда
		СтрокаУсловия = "НЕ # В ИЕРАРХИИ (&)";
	ИначеЕсли ВидСравнения= ВидСравнения.НеВИерархии Тогда
		СтрокаУсловия = "НЕ # В ИЕРАРХИИ (&)";
	ИначеЕсли ВидСравнения= ВидСравнения.Больше Тогда
		СтрокаУсловия="#>&";
	ИначеЕсли ВидСравнения= ВидСравнения.БольшеИлиРавно Тогда
		СтрокаУсловия="#>=&";
	ИначеЕсли ВидСравнения= ВидСравнения.Меньше Тогда
		СтрокаУсловия="#<&";
	ИначеЕсли ВидСравнения= ВидСравнения.МеньшеИлиРавно Тогда
		СтрокаУсловия="#<=&";
	КонецЕсли;
	
	Возврат СтрокаУсловия;
	
КонецФункции // СформироватьСтрокуОтборов()

// Выводит на печать унифицированную форму ОП1.
//
// Параметры:
//  ТабДокумент - Произвольный - Таб документ.
//  Рецептура - Произвольный - Рецептура.
//  ДокументОбъект - Произвольный - Документ объект.
//  СтрокаДокумента - Строка - Строка документа.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура ВывестиКалькуляцию(ТабДокумент,Рецептура,ДокументОбъект,СтрокаДокумента=Неопределено,ДополнительныеПараметры=Неопределено) Экспорт
	// Рассчитаем дерево для калькулирования
	ЭтоВыпускПродукции	= Ложь;
	ЭтоРецептура		= Ложь;
	// +АвтовыборНоменклатуры
	УточненияАвтовыбора = Неопределено;
	// +АвтовыборНоменклатуры
	Если ТипЗнч(ДокументОбъект)=Тип("ДокументОбъект.питВыпускБлюд") Тогда
		ЭтоВыпускПродукции = Истина;
		// +АвтовыборНоменклатуры
		УточненияАвтовыбора = ДокументОбъект.УточненияАвтовыбора.Выгрузить();
		// +АвтовыборНоменклатуры
	ИначеЕсли ТипЗнч(ДокументОбъект)=Тип("ДокументСсылка.питВыпускБлюд") Тогда
		ЭтоВыпускПродукции = Истина;
		// +АвтовыборНоменклатуры
		УточненияАвтовыбора = питУправлениеДаннымиОбИзделиях.ПолучитьТаблицуУточненийАвтовыбораПоДокументу(ДокументОбъект);
		// +АвтовыборНоменклатуры
	ИначеЕсли ТипЗнч(ДокументОбъект)=Тип("ДокументОбъект.питРецептура") Тогда
		ЭтоРецептура = Истина;
		// +АвтовыборНоменклатуры
		УточненияАвтовыбора = ДокументОбъект.УточненияАвтовыбора.Выгрузить();
		// +АвтовыборНоменклатуры
	ИначеЕсли ТипЗнч(ДокументОбъект)=Тип("ДокументСсылка.питРецептура") Тогда
		ЭтоРецептура = Истина;
		// +АвтовыборНоменклатуры
		УточненияАвтовыбора = питУправлениеДаннымиОбИзделиях.ПолучитьТаблицуУточненийАвтовыбораПоДокументу(ДокументОбъект);
		// +АвтовыборНоменклатуры
	КонецЕсли;
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаУправленческогоУчета = Константы.ВалютаУправленческогоУчета.Получить();
	Если ЭтоВыпускПродукции И СтрокаДокумента=Неопределено Тогда
		СтрокаДокумента = ДокументОбъект.Товары.Найти(Рецептура, "Рецептура");
	КонецЕсли;
	
	// Определим параметры для отчета
	Если ЭтоВыпускПродукции ИЛИ ЭтоРецептура Тогда
		Организация = ДокументОбъект.Организация;
	Иначе
		Организация = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	КонецЕсли;
	
	ДатаКалькуляции				= Неопределено;
	СкладКомпании				= Неопределено;
	ФормироватьСуммыКалькуляцииПоСтоимостиОстатков = Неопределено;
	РассчитываемоеКоличество	= Неопределено;
	ПодразделениеКомпании		= "";
	РазворачиватьДоИнгредиентов = Неопределено;
	РасчетЦеныПоПолуфабрикату = Неопределено;
	ПодразделениеПолуфабрикатов = Неопределено;
	ТипЦенПродажи				= Справочники.ВидыЦен.ПустаяСсылка();
	
	ТипЦенНормативная			= Константы.питНормативнаяЦена.Получить();
	РецептурнаяЕдиница			= Неопределено;
	НеИспользоватьСезонныеПроценты = Неопределено;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("ДатаФормирования", ДатаКалькуляции);
		ДополнительныеПараметры.Свойство("СкладКомпании", СкладКомпании);
		ДополнительныеПараметры.Свойство("ФормироватьСуммыКалькуляцииПоСтоимостиОстатков", ФормироватьСуммыКалькуляцииПоСтоимостиОстатков);
		ДополнительныеПараметры.Свойство("РассчитываемоеКоличество", РассчитываемоеКоличество);
		ДополнительныеПараметры.Свойство("РазворачиватьДоИнгредиентов", РазворачиватьДоИнгредиентов);
		ДополнительныеПараметры.Свойство("ПодразделениеПолуфабрикатов", ПодразделениеПолуфабрикатов);
		ДополнительныеПараметры.Свойство("РасчетЦеныПоПолуфабрикату", РасчетЦеныПоПолуфабрикату);
		Если ДополнительныеПараметры.Свойство("ТипЦенПродажи") Тогда
			ТипЦенПродажи = ДополнительныеПараметры.ТипЦенПродажи;
		КонецЕсли;
		ДополнительныеПараметры.Свойство("РецептурнаяЕдиница", РецептурнаяЕдиница);
		ДополнительныеПараметры.Свойство("НеИспользоватьСезонныеПроценты", НеИспользоватьСезонныеПроценты);
		// +АвтовыборНоменклатуры
		Если ДополнительныеПараметры.Свойство("УточненияАвтовыбора") Тогда
			УточненияАвтовыбора = ПолучитьИзВременногоХранилища(ДополнительныеПараметры.УточненияАвтовыбора);
		КонецЕсли;
		// +АвтовыборНоменклатуры
	КонецЕсли;
	
	Если РазворачиватьДоИнгредиентов = Неопределено Тогда
		РазворачиватьДоИнгредиентов = Ложь ;
	КонецЕсли;
	Если РасчетЦеныПоПолуфабрикату = Неопределено Тогда
		РасчетЦеныПоПолуфабрикату = Ложь ;
	КонецЕсли;
	
	Если НЕ ПодразделениеПолуфабрикатов = Неопределено Тогда
		
	КонецЕсли;
	
	ПодразделениеКомпании = ДокументОбъект.Подразделение;
	
	Если ЭтоВыпускПродукции Тогда
		ДатаКалькуляции = ДокументОбъект.Дата;
		СкладКомпании   = ДокументОбъект.Склад;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПодразделениеКомпании) И ОбщегоНазначения.ЕстьРеквизитОбъекта("Склад", ДокументОбъект.Метаданные()) Тогда
		ПодразделениеКомпании = ДокументОбъект.Склад.Наименование;
	ИначеЕсли НЕ ЗначениеЗаполнено(ПодразделениеКомпании) Тогда	
		ПодразделениеКомпании = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации");
	КонецЕсли;
	
	Если ДатаКалькуляции = Неопределено Тогда
//   Если Константы.питСпособРасчетаРецептур.Получить() = Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре
// Тогда.
		Если питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур") = Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре Тогда
			// Для актуальных рецептур расчет на текущую дату
			ДатаКалькуляции = ТекущаяДата();
		ИначеЕсли ЭтоРецептура Тогда
			// Для рецептур берем дату из документа. ДатаКалькуляции = ДокументОбъект.Дата;
			// Исправлено по желанию клиента. Рецептуры могут быть введены ранее, чем ПоступлениеТоваров,
			// которое устанавливает цену ингредиентов.
			ДатаКалькуляции = ТекущаяДата();
		Иначе
			ДатаКалькуляции = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
	Если ФормироватьСуммыКалькуляцииПоСтоимостиОстатков = Неопределено Тогда
		ФормироватьСуммыКалькуляцииПоСтоимостиОстатков = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ФормироватьСуммыКалькуляцииПоСтоимостиОстатков");
	КонецЕсли;
	
	Если РецептурнаяЕдиница = Неопределено Тогда
		РецептурнаяЕдиница = Истина;
	КонецЕсли;
	// Если не передали значение использования сезонных процентов, то считаем, что надо так, как в константе.
	Если НеИспользоватьСезонныеПроценты = Неопределено Тогда
		НеИспользоватьСезонныеПроценты = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питНеИспользоватьСезонныеПроценты");
	КонецЕсли;
	
	РецептураРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Рецептура, 
		"Количество, КоличествоУпаковок, Упаковка, ХозяйственнаяОперация, Номенклатура, Номенклатура.ЕдиницаИзмерения, Номенклатура.НаименованиеПолное, Характеристика, Характеристика.НаименованиеПолное, НомерРецептуры, Ответственный, Выход");
	
	КоэффициентРазделки = ?(НЕ ЗначениеЗаполнено(Рецептура), 1, ?(РецептураРеквизиты.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураРазделка, 0.01, 1));
	
	Если ЭтоВыпускПродукции И ДокументОбъект.Проведен Тогда
		
		ПроизведенРасчетСебестоимости = ПроизведенРасчетСебестоимости(ДокументОбъект.Ссылка);
		Если ПроизведенРасчетСебестоимости И ВалютаРегламентированногоУчета <> ВалютаУправленческогоУчета Тогда
			СтруктураКурсаВалютыСебестоимости = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДокументОбъект.Дата, Новый Структура("Валюта", ВалютаУправленческогоУчета));
			КурсВалютыСебестоимости = СтруктураКурсаВалютыСебестоимости.Курс * СтруктураКурсаВалютыСебестоимости.Кратность;
		Иначе
			КурсВалютыСебестоимости = 1;
		КонецЕсли;
		
		// +АвтовыборНоменклатуры
		ТаблицаИнгредиентов = питУправлениеДаннымиОбИзделиях.ПолучитьТаблицуИнгредиентовРецептурыСАвтовыбором(Рецептура, УточненияАвтовыбора);
		// -АвтовыборНоменклатуры
		
		ТекстЗапроса = "";
		
		Если ПроизведенРасчетСебестоимости Тогда
			ТекстЗапроса = ТекстЗапроса + ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов(Ложь);
		КонецЕсли;
		
		// Регистре Производство блюдо может быть записано дважды, один раз автопередел, второй не автопередел.
		// Поэтому сначала строки суммируются, чтобы не было дублей по ингредиентам.
		// Потом определяем максимум по количеству блюда, т.к. при сложении могли быть не все ингредиенты быть парами.
		// 99999 для номера строки используется, чтобы аналоги были последними.
		ТекстЗапроса = ТекстЗапроса + "
		// +АвтовыборНоменклатуры
		|ВЫБРАТЬ * ПОМЕСТИТЬ втИнгредиенты ИЗ &ТаблицаИнгредиентов КАК ТаблицаИнгредиентов;
		// -АвтовыборНоменклатуры
		|ВЫБРАТЬ
		|	Производство.Рецептура,
		|	Производство.Ингредиент,
		|	Производство.ХарактеристикаИнгредиента,
		|	МАКСИМУМ(Производство.КоличествоБлюда) КАК КоличествоБлюда,
		|	СУММА(Производство.КоличествоИнгредиента) КАК КоличествоИнгредиента,
		|	СУММА(Производство.Сумма) КАК Сумма
		|ПОМЕСТИТЬ ТаблицаПроизводствоПред
		|ИЗ
		|	РегистрНакопления.питПроизводство КАК Производство
		|ГДЕ
		|	Производство.Рецептура = &Рецептура
		|	И Производство.Регистратор = &Ссылка
		|	И Производство.ВидПроизводственногоДвижения В (&ВидыПроизводственногоДвижения)
		|
		|СГРУППИРОВАТЬ ПО
		|	Производство.Рецептура,
		|	Производство.Ингредиент,
		|	Производство.ХарактеристикаИнгредиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Производство.Рецептура,
		|	Производство.Ингредиент,
		|	Производство.ХарактеристикаИнгредиента,
		|	Производство.КоличествоБлюда КАК КоличествоБлюда,
		|	Производство.КоличествоИнгредиента КАК КоличествоИнгредиента,
		|	ЕстьNull("+?(ПроизведенРасчетСебестоимости,"Себестоимость.СуммаБезНДС * &КурсВалютыСебестоимости","Производство.Сумма")+",0) КАК Сумма
		|ПОМЕСТИТЬ ТаблицаПроизводство
		|ИЗ
		|	ТаблицаПроизводствоПред КАК Производство 
		|		"+?(ПроизведенРасчетСебестоимости,"
		|		ЛЕВОЕ СОЕДИНЕНИЕ резТаблицаСебестоимости КАК Себестоимость
		|			ПО Производство.Рецептура = Себестоимость.Рецептура
		|			И Производство.Ингредиент = Себестоимость.Номенклатура
		|			И Производство.ХарактеристикаИнгредиента = Себестоимость.Характеристика ","")+"
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Производство.Рецептура,
		|	МАКСИМУМ(Производство.КоличествоБлюда) КАК КоличествоБлюда
		|ПОМЕСТИТЬ ТаблицаКоличествоБлюда
		|ИЗ
		|	ТаблицаПроизводство КАК Производство
		|
		|СГРУППИРОВАТЬ ПО
		|	Производство.Рецептура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Производство.Рецептура КАК Рецептура,
		|	Производство.Ингредиент КАК Номенклатура,
		|	Производство.ХарактеристикаИнгредиента КАК Характеристика,
		|	ПроизводствоКоличествоБлюда.КоличествоБлюда КАК КоличествоБлюда,
		|	Производство.КоличествоИнгредиента КАК Количество,
		|	Производство.Сумма КАК Сумма,
		|	ЕСТЬNULL(РецептураТовары.НомерСтроки, 99999) КАК НомерСтроки,
		|";
		Если РецептурнаяЕдиница Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	ВЫБОР КОГДА ДокументРецептураЕдиницы.Упаковка=ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) 
			|	ТОГДА ДокументРецептураЕдиницы.Номенклатура.ЕдиницаИзмерения 
			|	ИНАЧЕ ДокументРецептураЕдиницы.Упаковка 
			|	КОНЕЦ КАК ЕдиницаИзмерения,
			|	ЕСТЬNULL(ДокументРецептураЕдиницы.КоличествоБрутто,1)/ЕСТЬNULL(ДокументРецептураЕдиницы.КоличествоУпаковокБрутто,1) КАК Коэффициент,
			|";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(РецептураТовары.КоличествоНорма, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ РецептураТовары.КоличествоНетто / РецептураТовары.КоличествоНорма * Производство.КоличествоИнгредиента
		|	КОНЕЦ КАК Нетто
		|ИЗ
		|	ТаблицаПроизводство КАК Производство
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаКоличествоБлюда КАК ПроизводствоКоличествоБлюда
		|		ПО Производство.Рецептура = ПроизводствоКоличествоБлюда.Рецептура
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ДокументРецептураТовары.Ссылка КАК Ссылка,
		|			ДокументРецептураТовары.Номенклатура КАК Номенклатура,
		|			ДокументРецептураТовары.Характеристика КАК Характеристика,
		|			МИНИМУМ(ДокументРецептураТовары.НомерСтроки) КАК НомерСтроки,
		|			СУММА(ДокументРецептураТовары.КоличествоБрутто) КАК КоличествоНорма,
		|			СУММА(ДокументРецептураТовары.КоличествоНетто) КАК КоличествоНетто
		|		ИЗ
		|			втИнгредиенты КАК ДокументРецептураТовары
		|		ГДЕ
		|			ДокументРецептураТовары.Ссылка = &Рецептура
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ДокументРецептураТовары.Ссылка,
		|			ДокументРецептураТовары.Номенклатура,
		|			ДокументРецептураТовары.Характеристика) КАК РецептураТовары
		|		ПО Производство.Рецептура = РецептураТовары.Ссылка
		|			И Производство.Ингредиент = РецептураТовары.Номенклатура
		|			И Производство.ХарактеристикаИнгредиента = РецептураТовары.Характеристика
		|";
		Если РецептурнаяЕдиница Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|		ЛЕВОЕ СОЕДИНЕНИЕ втИнгредиенты КАК ДокументРецептураЕдиницы
			|		ПО Производство.Рецептура = ДокументРецептураЕдиницы.Ссылка
			|			И Производство.Ингредиент = ДокументРецептураЕдиницы.Номенклатура
			|			И Производство.ХарактеристикаИнгредиента = ДокументРецептураЕдиницы.Характеристика
			|			И (РецептураТовары.НомерСтроки = ДокументРецептураЕдиницы.НомерСтроки)
			|";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|";	
		
		Запрос			= Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
		Запрос.Текст	= ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаНачала",ДокументОбъект.Дата);
		Запрос.УстановитьПараметр("ДатаКонца",ДокументОбъект.Дата);
		Запрос.УстановитьПараметр("Склад",ДокументОбъект.Склад);
		Запрос.УстановитьПараметр("Рецептура",Рецептура);
		Запрос.УстановитьПараметр("Ссылка",ДокументОбъект.Ссылка);
		Запрос.УстановитьПараметр("ВыводитьСуммуБезНДС", Ложь);
		Запрос.УстановитьПараметр("ВидыПроизводственногоДвижения", Перечисления.питВидыПроизводственногоДвижения.ПолучитьВидыПроизводственногоДвиженияВБлюде());
		Запрос.УстановитьПараметр("КурсВалютыСебестоимости",КурсВалютыСебестоимости);
		
		// +АвтовыборНоменклатуры
		Запрос.УстановитьПараметр("ТаблицаИнгредиентов", ТаблицаИнгредиентов);
		// -АвтовыборНоменклатуры
		
		СтрокиДерева	= Запрос.Выполнить().Выгрузить();
		ПоНорме			= Ложь;
		// ВалютаДокумента = ДокументОбъект.Валюта; Многовалютный учет пока не поддерживается
		ВалютаДокумента = ВалютаРегламентированногоУчета;
		
		// Определяем количество блюда,
		// В документе количество может быть изменено, по сравнению с проведенным.
		Если НЕ СтрокиДерева.Количество()=0 Тогда
			КоличествоБлюда = СтрокиДерева[0].КоличествоБлюда;
		Иначе
			КоличествоБлюда = 0;
		КонецЕсли;
		Если СтрокаДокумента <> Неопределено Тогда
			// КоэффициентБлюда		= ?(СтрокаДокумента.Коэффициент=0, 1, СтрокаДокумента.Коэффициент);
			// ЕдиницаИзмеренияБлюда	= СтрокаДокумента.Упаковка;
			// ПогрешностьОкруглений	= КоличествоБлюда - СтрокаДокумента.Количество*КоэффициентБлюда;
			// Если ПогрешностьОкруглений < 0 Тогда
			// 	ПогрешностьОкруглений	= -ПогрешностьОкруглений;
			// КонецЕсли;
			// Если ПогрешностьОкруглений < 0.003 Тогда
			// 	КоличествоБлюда		= СтрокаДокумента.Количество;
			// Иначе
			// 	КоличествоБлюда		= Окр(КоличествоБлюда/КоэффициентБлюда,3);
			// КонецЕсли;
			КоличествоБлюда		= СтрокаДокумента.КоличествоУпаковок;
			ЕдиницаИзмеренияБлюда	= СтрокаДокумента.Упаковка;
		Иначе
			// КоэффициентБлюда		= ?(Рецептура.Коэффициент=0, 1, Рецептура.Коэффициент);
			КоличествоБлюда			= РецептураРеквизиты.КоличествоУпаковок;
			ЕдиницаИзмеренияБлюда	= РецептураРеквизиты.Упаковка;
		КонецЕсли;
	Иначе
		// Если рецептура не заполнена, то передадим структуру блюда,
		// что бы в дерево состава добавилась ветка блюда, без состава.
		СтруктураРассчитываемогоБлюдо = Неопределено;
		Если НЕ СтрокаДокумента=Неопределено Тогда
			СтруктураРассчитываемогоБлюдо = Новый Структура("Блюдо,Характеристика,ЕдиницаИзмерения",СтрокаДокумента.Номенклатура,СтрокаДокумента.Характеристика,СтрокаДокумента.Упаковка);
		КонецЕсли;
		
		МассивПодразделенийПФ = Неопределено;
		Если НЕ ПодразделениеПолуфабрикатов = Неопределено Тогда
			МассивПодразделенийПФ = Новый Массив(1);
			МассивПодразделенийПФ[0] = ПодразделениеПолуфабрикатов;
		КонецЕсли;
		
		// +ПараметризацияРецептур
		Если НЕ ПодразделениеПолуфабрикатов = Неопределено Тогда
			ПодразделениеПроизводства = ПодразделениеПолуфабрикатов;
		Иначе
			ПодразделениеПроизводства = ДокументОбъект.Подразделение;
		КонецЕсли;
		// -ПараметризацияРецептур
		
		ДеревоСостава			= питПроизводство.РассчитатьДеревоСоставаРецептуры(Рецептура,,РецептураРеквизиты.Количество,,,РецептураРеквизиты.КоличествоУпаковок,,,,,,,СтруктураРассчитываемогоБлюдо,,,,,,,,,МассивПодразделенийПФ, ПодразделениеПроизводства,, УточненияАвтовыбора);
		
		Если РазворачиватьДоИнгредиентов Тогда
			СтрокиДерева = питОбщегоНазначения.СоздатьТаблицуЗначенийПоРезультату(ДеревоСостава, Истина);
			КолонкиГруппировокСтрокой = "";
			КолонкиСверткиСтрокой = "";
			Для каждого ТекКолонкаДерева Из ДеревоСостава.Колонки Цикл
				Если СтрНайти(ТекКолонкаДерева.Имя, "СтатьяКалькуляции")
					ИЛИ СтрНайти(ТекКолонкаДерева.Имя, "ИдентификаторСтрокиДерева") Тогда
					Продолжить;
				КонецЕсли;
				Если СтрНайти(ТекКолонкаДерева.Имя, "Количество") Тогда
					КолонкиСверткиСтрокой = КолонкиСверткиСтрокой + ?(ПустаяСтрока(КолонкиСверткиСтрокой), "", ",") + ТекКолонкаДерева.Имя;
				Иначе
					КолонкиГруппировокСтрокой = КолонкиГруппировокСтрокой + ?(ПустаяСтрока(КолонкиГруппировокСтрокой), "", ",") + ТекКолонкаДерева.Имя;
				КонецЕсли;
			КонецЦикла;
			СтрокиДерева.Свернуть(КолонкиГруппировокСтрокой, КолонкиСверткиСтрокой);
		Иначе
			СтрокиДерева			= ДеревоСостава.Строки[0].Строки;
		КонецЕсли;
		
		ПоНорме					= Истина;
		ВалютаДокумента			= ВалютаРегламентированногоУчета;
		КоличествоБлюда			= РецептураРеквизиты.КоличествоУпаковок;//
		КоэффициентБлюда		= 1;
		ЕдиницаИзмеренияБлюда	= ?(ЗначениеЗаполнено(РецептураРеквизиты.Упаковка),РецептураРеквизиты.Упаковка, РецептураРеквизиты.НоменклатураЕдиницаИзмерения) ;
	КонецЕсли;
	
	КоэффициентПересчета= ?(ЗначениеЗаполнено(РассчитываемоеКоличество), РассчитываемоеКоличество/КоличествоБлюда, 1);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_питОП1");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	
	// Заполнение Шапки
	Если ЗначениеЗаполнено(РецептураРеквизиты.Номенклатура) Тогда
		НоменклатураТекст = СокрЛП(РецептураРеквизиты.НоменклатураНаименованиеПолное)+ "" + ?(ЗначениеЗаполнено(РецептураРеквизиты.Характеристика)," / " + СокрЛП(РецептураРеквизиты.ХарактеристикаНаименованиеПолное),"");
		ЕдиницаИзмеренияТекст = ?(ЗначениеЗаполнено(ЕдиницаИзмеренияБлюда), ЕдиницаИзмеренияБлюда,РецептураРеквизиты.НоменклатураЕдиницаИзмерения) ;
		НоменклатураРасшифровка = РецептураРеквизиты.Номенклатура;
	ИначеЕсли ЗначениеЗаполнено(СтрокаДокумента.Номенклатура) Тогда
		НоменклатураТекст = СокрЛП(СтрокаДокумента.Номенклатура.НаименованиеПолное)+ "" + ?(ЗначениеЗаполнено(СтрокаДокумента.Характеристика)," / " + СокрЛП(СтрокаДокумента.Характеристика.НаименованиеПолное),"");
		ЕдиницаИзмеренияТекст = ?(ЗначениеЗаполнено(СтрокаДокумента.Упаковка), СтрокаДокумента.Упаковка,СтрокаДокумента.Номенклатура.ЕдиницаИзмерения) ;
		НоменклатураРасшифровка = СтрокаДокумента.Номенклатура;
	КонецЕсли;
	
	ОбластьМакета.Параметры.Номенклатура	= НоменклатураТекст;
	ОбластьМакета.Параметры.Количество		= КоличествоБлюда*КоэффициентПересчета;
	ОбластьМакета.Параметры.ЕдиницаИзмерения= ЕдиницаИзмеренияТекст;
	
	ПредставлениеОрганизации                = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДокументОбъект.Организация, ДокументОбъект.Дата), "НаименованиеДляПечатныхФорм,");
	ОбластьМакета.Параметры.Организация		= ПредставлениеОрганизации;
	ОбластьМакета.Параметры.ПодразделениеКомпании = ПодразделениеКомпании;
	ОбластьМакета.Параметры.КодПоОКПО		= ДокументОбъект.Организация.КодПоОКПО;
	ОбластьМакета.Параметры.НомерРецептуры	= РецептураРеквизиты.НомерРецептуры;
	ОбластьМакета.Параметры.Дата			= ДатаКалькуляции;
	Если ЭтоВыпускПродукции ИЛИ ЭтоРецептура Тогда
		ОбластьМакета.Параметры.Номер		= ДокументОбъект.Номер;
	КонецЕсли;
	
	ОбластьМакета.Параметры.ОрганизацияРасшифровка           = Организация;
	ОбластьМакета.Параметры.ПодразделениеКомпанииРасшифровка = ПодразделениеКомпании;
	ОбластьМакета.Параметры.НоменклатураРасшифровка          = НоменклатураРасшифровка;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	ПечататьАртикул = (Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить() = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул);
	
	// Переменная, накапливающая стоимость блюда
	ИтогоСумма		= 0;
	
	// Служебная структура, хранящая кэшированные значения, уменьшает общее число запросов 
	//  к базе во время заполнения дерева состава, вычисления сезонных процентов и т.д.
	КэшЗаполненияДерева = питПроизводство.ИнициализироватьСтруктуруКэшированныхЗначенийДляЗаполненияДереваСостава();
	
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	Ном				= 0;
	
	НаименованияНоменклатур = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СтрокиДерева.ВыгрузитьКолонку("Номенклатура"), "НаименованиеПолное, Артикул, Код, ЕдиницаИзмерения, питВидНоменклатуры, питРецептурнаяУпаковка");
	НаименованияХарактеристик = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СтрокиДерева.ВыгрузитьКолонку("Характеристика"), "НаименованиеПолное");
	
	// Выводим многострочную часть документа
	// Первые строки - это строки блюд
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Ном = Ном + 1;
		ОбластьСтрока.Параметры.Ном = Ном;
		
		Если ЗначениеЗаполнено(СтрокаДерева.Номенклатура) Тогда
			ТекАртикул				= НаименованияНоменклатур[СтрокаДерева.Номенклатура].Артикул;
			ТекКод					= НаименованияНоменклатур[СтрокаДерева.Номенклатура].Код;
			ТекНаименованиеПолное	= НаименованияНоменклатур[СтрокаДерева.Номенклатура].НаименованиеПолное;
			ТекЕдиница				= НаименованияНоменклатур[СтрокаДерева.Номенклатура].ЕдиницаИзмерения;
			ТекВидНоменклатуры		= НаименованияНоменклатур[СтрокаДерева.Номенклатура].питВидНоменклатуры;
			ТекРецептурнаяУпаковка	= НаименованияНоменклатур[СтрокаДерева.Номенклатура].питРецептурнаяУпаковка;
		Иначе
			ТекАртикул				= "";
			ТекКод					= "";
			ТекНаименованиеПолное	= "";
			ТекЕдиница				= Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
			ТекВидНоменклатуры		= Перечисления.питВидыНоменклатуры.Товар;
			ТекРецептурнаяУпаковка	= Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		КонецЕсли;
		
		ОбластьСтрока.Параметры.Код = ?(ПечататьАртикул, ТекАртикул, ТекКод);
		Если ЗначениеЗаполнено(СтрокаДерева.Номенклатура) Тогда
			ОбластьСтрока.Параметры.Номенклатура = СокрЛП(ТекНаименованиеПолное) + "" + ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика)," / " + СокрЛП(НаименованияХарактеристик[СтрокаДерева.Характеристика]),"");
		Иначе
			ОбластьСтрока.Параметры.Номенклатура = "<Уточняется при производстве>";
		КонецЕсли;
		ОбластьСтрока.Параметры.НоменклатураРасшифровка = СтрокаДерева.Номенклатура;
		
		СтруктураРасшифровкиЦены = Неопределено;
		
		Если ПоНорме Тогда
			
			// В случае если производится нормативный расчет калькуляции то следует учесть влияние сезонного коэффициента.
			Если НЕ НеИспользоватьСезонныеПроценты И КоэффициентРазделки=1 Тогда
				
				СезонныйПроцент = питЛицензированиеСервер.ПолучитьСезонныйПроцент(СтрокаДерева.Номенклатура, ДатаКалькуляции, КэшЗаполненияДерева.КэшСезонныхПроцентов);
				СезонныйКоэффициент = 1+СезонныйПроцент/100;
			Иначе
				СезонныйКоэффициент = 1;
			КонецЕсли;
			
			// Здесь в СтрокаДерева количества указаны в единицах из рецептуры,
			// поэтому используем обратные коэффициенты.
			Если РецептурнаяЕдиница Тогда
				ЕдиницаИзмерения = ?(ЗначениеЗаполнено(СтрокаДерева.ЕдиницаИзмерения),СтрокаДерева.ЕдиницаИзмерения, ТекЕдиница) ;
				Коэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаДерева.Номенклатура, ЕдиницаИзмерения);
				НаКоличествоБлюда      = Окр(СтрокаДерева.КоличествоУпаковок        * КоэффициентПересчета*СезонныйКоэффициент*КоэффициентРазделки, 3);
				НаКоличествоБлюдаНетто = Окр(СтрокаДерева.КоличествоУпаковокНетто * КоэффициентПересчета*СезонныйКоэффициент*КоэффициентРазделки, 3);
			Иначе
				ЕдиницаИзмерения = ТекЕдиница;
				Коэффициент = СтрокаДерева.Коэффициент;
				НаКоличествоБлюда      = Окр(СтрокаДерева.Количество           * КоэффициентПересчета*СезонныйКоэффициент*КоэффициентРазделки, 3);
				НаКоличествоБлюдаНетто = Окр(СтрокаДерева.КоличествоНетто      * КоэффициентПересчета*СезонныйКоэффициент*КоэффициентРазделки, 3);
			КонецЕсли;
			
			ОбластьСтрока.Параметры.ЕдиницаИзмерения	= ЕдиницаИзмерения;
			ОбластьСтрока.Параметры.КодЕдиницыИзмерения	= ЕдиницаИзмерения.Код;
			ОбластьСтрока.Параметры.Количество			= НаКоличествоБлюда;
			ОбластьСтрока.Параметры.КоличествоНетто		= НаКоличествоБлюдаНетто;
			
			// Вычислим цену, считаем по текущей дате
			Цена = 0;
			Если ТекВидНоменклатуры = Перечисления.питВидыНоменклатуры.ТехнологическийИнгредиент Тогда
				//
			ИначеЕсли ТекВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
				РецептураПередела		= СтрокаДерева.Рецептура;
				Если ЗначениеЗаполнено(РецептураПередела) Тогда
					КоличествоВРецептуре	= РецептураПередела.Количество;
					Если РасчетЦеныПоПолуфабрикату Тогда
						Цена					= питПроизводство.ПолучитьСтоимостьИнгредиента(СтрокаДерева.Номенклатура, ТипЦенНормативная, ДатаКалькуляции, ВалютаДокумента , ,,,,ЕдиницаИзмерения,СтрокаДерева.Характеристика);
					Иначе
						СуммаНорма				= питПроизводство.ПолучитьСтоимостьПеределаПоРецептуре(РецептураПередела, ТипЦенНормативная, ДатаКалькуляции, ВалютаДокумента,,,НеИспользоватьСезонныеПроценты, КэшЗаполненияДерева, УточненияАвтовыбора);
						Цена					= СуммаНорма / ?(КоличествоВРецептуре=0,1,КоличествоВРецептуре) * Коэффициент;
					КонецЕсли;
					// Дополнительная расшифровка для полуфабриката
					СтруктураРасшифровкиЦены = Новый Структура("Блюдо,Количество,Рецептура,Дата,Склад,Организация,ТипЦен,ПоНорме,ПолеРасшифровки",СтрокаДерева.Номенклатура,СтрокаДерева.Количество,РецептураПередела,ДатаКалькуляции,СкладКомпании,Организация,,ПоНорме,"ОП-1.ЦенаБлюда");
				Иначе
					СуммаНорма				= 0;
					Цена					= 0;
				КонецЕсли;
			Иначе
				Цена					= питПроизводство.ПолучитьСтоимостьИнгредиента(СтрокаДерева.Номенклатура, ТипЦенНормативная, ДатаКалькуляции, ВалютаДокумента , ,,,,ЕдиницаИзмерения,СтрокаДерева.Характеристика);
				СтруктураРасшифровкиЦены = Новый Структура("Блюдо,Дата,Склад,Организация,ТипЦен,ПолеРасшифровки",СтрокаДерева.Номенклатура,ДатаКалькуляции,СкладКомпании,Организация,,"ОП-1.ЦенаИнгредиента");
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Цена	= Цена;
			ОбластьСтрока.Параметры.Сумма	= Цена*НаКоличествоБлюда;
			ИтогоСумма						= ИтогоСумма+Окр(Цена*НаКоличествоБлюда,2);
			
		Иначе
			
			Если СтрокаДерева.Количество=0 Тогда
				Ном = Ном - 1; // В начале цикла делали инкремент номера, но т.к. данная строка не будет выведена, сделаем декремент.
				Продолжить;
			КонецЕсли;	
			
			// Здесь в СтрокаДерева количества указаны в базовых единицах.
			Если РецептурнаяЕдиница Тогда
				ЕдиницаИзмерения = СтрокаДерева.ЕдиницаИзмерения;
				Коэффициент = СтрокаДерева.Коэффициент;
				Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					// Возможно, был списан аналог.
					ЕдиницаИзмерения = ТекРецептурнаяУпаковка;
					///***---
					Коэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаДерева.Номенклатура,ЕдиницаИзмерения);
				КонецЕсли;
			Иначе
				ЕдиницаИзмерения = ТекЕдиница;
				Коэффициент = 1;
			КонецЕсли;
			// Если вдруг пришел нулевой коэффициент, подменим его, т.к. ошибка деления на 0
			Коэффициент = ?(Коэффициент = 0, 1, Коэффициент);
			Количество = СтрокаДерева.Количество/Коэффициент*КоэффициентПересчета;
			ЕдиницаИзмерения = ?(ЗначениеЗаполнено(ЕдиницаИзмерения),ЕдиницаИзмерения,ТекЕдиница);
			ОбластьСтрока.Параметры.ЕдиницаИзмерения	=  ЕдиницаИзмерения;
			ОбластьСтрока.Параметры.КодЕдиницыИзмерения	= ЕдиницаИзмерения.Код;
			ОбластьСтрока.Параметры.КоличествоНетто		= СтрокаДерева.Нетто/Коэффициент*КоэффициентПересчета;
			ОбластьСтрока.Параметры.Количество			= Количество;
			
			Если ВалютаДокумента = ВалютаРегламентированногоУчета Тогда
				Сумма = СтрокаДерева.Сумма;
			Иначе
				// Валютный учет не поддерживается
				Сумма = 0;
			КонецЕсли;
			
			// +Пересчёт суммы, если в регистре сумма нулевая и нет факт. с/с
			Если НЕ ПроизведенРасчетСебестоимости
				И Сумма = 0
				И Количество > 0 Тогда
				Если НЕ ТекВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
					НоваяЦена = питПроизводство.ПолучитьСтоимостьИнгредиента(
						СтрокаДерева.Номенклатура, 
						ТипЦенНормативная, 
						ДатаКалькуляции, 
						ВалютаДокумента,,,,,
						ЕдиницаИзмерения,
						СтрокаДерева.Характеристика
					);
				ИначеЕсли РасчетЦеныПоПолуфабрикату Тогда
					НоваяЦена = питПроизводство.ПолучитьСтоимостьИнгредиента(
					СтрокаДерева.Номенклатура, ТипЦенНормативная, ДатаКалькуляции, ВалютаДокумента,
					, , , , ЕдиницаИзмерения, СтрокаДерева.Характеристика);
				Иначе
					РецептураПередела = питПроизводство.ВернутьОсновнуюРецептуру(
						СтрокаДерева.Номенклатура,
						СтрокаДерева.Характеристика,
						Перечисления.питХозяйственныеОперации.РецептураПриготовление,
						ДатаКалькуляции, , , ДокументОбъект.Организация, , , ДокументОбъект.Подразделение
					);
					Если ЗначениеЗаполнено(РецептураПередела) Тогда
						КоличествоВРецептуре = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РецептураПередела, "Количество");
						СуммаНорма = питПроизводство.ПолучитьСтоимостьПеределаПоРецептуре(
							РецептураПередела, ТипЦенНормативная, ДатаКалькуляции, ВалютаДокумента,
						, , НеИспользоватьСезонныеПроценты, КэшЗаполненияДерева, УточненияАвтовыбора);
						НоваяЦена = СуммаНорма / ?(КоличествоВРецептуре = 0, 1, КоличествоВРецептуре) * Коэффициент;
					КонецЕсли;
				КонецЕсли;
				Сумма = НоваяЦена * Количество;
			КонецЕсли;
			// -Пересчёт суммы, если в регистре сумма нулевая и нет факт. с/с
			
			Сумма = Окр(Сумма*КоэффициентПересчета,2);
			ОбластьСтрока.Параметры.Сумма	= Сумма;
			ОбластьСтрока.Параметры.Цена	= ?(Количество = 0, 0, Сумма/Количество);
			ИтогоСумма						= ИтогоСумма+Сумма;
			
			Если ТекВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
				СтруктураРасшифровкиЦены = Новый Структура("Блюдо,Количество,Рецептура,Дата,Склад,Организация,ТипЦен,ПоНорме,ПолеРасшифровки",СтрокаДерева.Номенклатура,СтрокаДерева.Количество,РецептураПередела,ДатаКалькуляции,СкладКомпании,Организация,        ,ПоНорме,"ОП-1.Блюдо");
			Иначе
				СтруктураРасшифровкиЦены = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		ОбластьСтрока.Параметры.ЦенаРасшифровка	= СтруктураРасшифровкиЦены;
		
		ТабДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	// Выводим подвал документа
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ИтогоСумма = ИтогоСумма;
	
	Руководители = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(ДокументОбъект.Организация, ДокументОбъект.Дата);
	ОбластьПодвал.Параметры.Руководитель = Руководители.РуководительНаименование;
	Если Руководители.Свойство("питЗаведующийПроизводством") Тогда
		ОбластьПодвал.Параметры.ЗаведующийПроизводством = Руководители.питЗаведующийПроизводством;
	КонецЕсли;
	Если Руководители.Свойство("питКалькулятор") Тогда
		ОбластьПодвал.Параметры.Калькулятор = Руководители.питКалькулятор;
	КонецЕсли;
	ОбластьПодвал.Параметры.Выход = РецептураРеквизиты.Выход;
	
	Если ЭтоВыпускПродукции 
		И (ДокументОбъект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ВыпускПродукцииСРозничнойРеализацией
		ИЛИ ДокументОбъект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ВыпускПродукцииСРеализацией)
		И СтрокаДокумента<>Неопределено Тогда
		
		ЦенаПродажи = СтрокаДокумента.Цена;
	Иначе
		
		Если ЭтоРецептура И НЕ ЗначениеЗаполнено(ТипЦенПродажи) И ЗначениеЗаполнено(ДокументОбъект.ЦеховаяКладовая) Тогда
			ТипЦенПродажи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.ЦеховаяКладовая, "РозничныйВидЦены");
		КонецЕсли;
		Если ЗначениеЗаполнено(ТипЦенПродажи) Тогда
			ЦенаПродажи = питПроизводство.ПолучитьСтоимостьИнгредиента(РецептураРеквизиты.Номенклатура, ТипЦенПродажи, ДатаКалькуляции, ВалютаДокумента,,,,, РецептураРеквизиты.Упаковка, РецептураРеквизиты.Характеристика);
		Иначе
			ЦенаПродажи = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	
	ОбластьПодвал.Параметры.ЦенаПродажи = ЦенаПродажи;
	
	Количество								= КоличествоБлюда*КоэффициентПересчета;
	ИтогоСуммаПорции						= ?(Количество=0,0,Окр(ИтогоСумма/Количество,2));
	ОбластьПодвал.Параметры.ИтогоСуммаПорции= ИтогоСуммаПорции;
	СуммаНаценки							= ?(ЦенаПродажи=0,0,Окр((ЦенаПродажи-ИтогоСуммаПорции),2));
	Наценка									= ?(ИтогоСуммаПорции=0,0,Окр((ЦенаПродажи-ИтогоСуммаПорции)*100/(ИтогоСуммаПорции),2));
	ОбластьПодвал.Параметры.Наценка			= ?(Наценка<0,0,Наценка);
	ОбластьПодвал.Параметры.СуммаНаценки	= СуммаНаценки;
	
	ТабДокумент.Вывести(ОбластьПодвал);
КонецПроцедуры

// Функция проверяет, был ли произведен фактический расчет себестоимости за месяц, в котором находится документ.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.питВыпускБлюд - Ссылка на документ выпуска.
//
// Возвращаемое значение:
//  Булево - Признак того, что расчет был произведен.
Функция ПроизведенРасчетСебестоимостиНЕУчитываяЗадания(ДокументСсылка) Экспорт
	
	Результат = Ложь;
	
	// Возврат Результат;
	
	// Проверим, а был ли расчет себестоимости в том месяце, когда был проведен текущий выпуск?
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА РасчетСебестоимостиТоваровОрганизации.Ссылка.ПредварительныйРасчет ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ НЕ РасчетСебестоимостиТоваровОрганизации.Ссылка.ПредварительныйРасчет
	|	КОНЕЦ КАК Результат,
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питВыпускБлюд КАК Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетСебестоимостиТоваров.Организации КАК РасчетСебестоимостиТоваровОрганизации
	|		ПО Документ.Организация = РасчетСебестоимостиТоваровОрганизации.Организация
	|			И (РасчетСебестоимостиТоваровОрганизации.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(Документ.Дата, МЕСЯЦ) И КОНЕЦПЕРИОДА(Документ.Дата, МЕСЯЦ))
	|			И (РасчетСебестоимостиТоваровОрганизации.Ссылка.Проведен)
	|ГДЕ
	|	Документ.Ссылка = &Регистратор
	|	И Документ.Проведен";
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  //ПроизведенРасчетСебестоимости()

// Функция проверяет, был ли произведен фактический расчет себестоимости за месяц, в котором находится документ.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.питВыпускБлюд - Ссылка на документ выпуска.
//
// Возвращаемое значение:
//  Булево - Признак того, что расчет был произведен.
Функция ПроизведенРасчетСебестоимости(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.питРазделка") Тогда
		ИмяДокумента = "питРазделка";
	Иначе
		ИмяДокумента = "питВыпускБлюд";
	КонецЕсли;
	
	Результат = Ложь;
	
	// Возврат Результат;
	
	// Проверим, а был ли расчет себестоимости в том месяце, когда был проведен текущий выпуск?
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	питВыпускБлюд.Ссылка КАК ДокументОбщепит,
	|	НАЧАЛОПЕРИОДА(питВыпускБлюд.Дата, МЕСЯЦ) КАК ДокументОбщепитДата,
	|	питВыпускБлюд.Организация КАК ДокументОбщепитОрганизация
	|ПОМЕСТИТЬ втДокументы
	|ИЗ
	|	Документ.%ИмяДокумента% КАК питВыпускБлюд
	|ГДЕ
	|	питВыпускБлюд.Ссылка = &Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаданияКРасчетуСебестоимости.Документ) КАК КоличествоТиповых,
	|	втДокументы.ДокументОбщепит
	|ПОМЕСТИТЬ втКоличествоТиповых
	|ИЗ
	|	втДокументы КАК втДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаданияКРасчетуСебестоимости КАК ЗаданияКРасчетуСебестоимости
	|		ПО втДокументы.ДокументОбщепитОрганизация = ЗаданияКРасчетуСебестоимости.Организация
	|			И втДокументы.ДокументОбщепитДата = ЗаданияКРасчетуСебестоимости.Месяц
	|
	|СГРУППИРОВАТЬ ПО
	|	втДокументы.ДокументОбщепит
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА втКоличествоТиповых.КоличествоТиповых > 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА РасчетСебестоимостиТоваровОрганизации.Ссылка.ПредварительныйРасчет ЕСТЬ NULL
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ НЕ РасчетСебестоимостиТоваровОрганизации.Ссылка.ПредварительныйРасчет
	|			КОНЕЦ
	|	КОНЕЦ КАК Результат,
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.%ИмяДокумента% КАК Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетСебестоимостиТоваров.Организации КАК РасчетСебестоимостиТоваровОрганизации
	|		ПО Документ.Организация = РасчетСебестоимостиТоваровОрганизации.Организация
	|			И (РасчетСебестоимостиТоваровОрганизации.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(Документ.Дата, МЕСЯЦ) И КОНЕЦПЕРИОДА(Документ.Дата, МЕСЯЦ))
	|			И (РасчетСебестоимостиТоваровОрганизации.Ссылка.Проведен)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКоличествоТиповых КАК втКоличествоТиповых
	|		ПО (втКоличествоТиповых.ДокументОбщепит = Документ.Ссылка)
	|ГДЕ
	|	Документ.Ссылка = &Регистратор
	|	И Документ.Проведен";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ИмяДокумента%", ИмяДокумента);
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции  //ПроизведенРасчетСебестоимости()

// Функция проверяет, был ли произведен фактический расчет себестоимости на переданную дату по переданной организации.
//
// Параметры:
//  Дата - Дата - Дата, на которую проводится проверка.
//  Организация - СправочникСсылка.Организации - Организация, по которой проводится проверка.
//
// Возвращаемое значение:
//  Булево - Признак того, что расчет был произведен.
Функция ПроизведенРасчетСебестоимостиПоДатеОрганизации(Дата, Организация) Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаданияКРасчетуСебестоимости.Организация КАК Организация,
	|	ЗаданияКРасчетуСебестоимости.Месяц КАК Месяц,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаданияКРасчетуСебестоимости.Документ) КАК КоличествоТиповых
	|ПОМЕСТИТЬ втКоличествоТиповых
	|ИЗ
	|	РегистрСведений.ЗаданияКРасчетуСебестоимости КАК ЗаданияКРасчетуСебестоимости
	|ГДЕ
	|	ЗаданияКРасчетуСебестоимости.Организация = &ТекущаяОрганизация
	|	И ЗаданияКРасчетуСебестоимости.Месяц = &НачалоМесяца
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданияКРасчетуСебестоимости.Организация,
	|	ЗаданияКРасчетуСебестоимости.Месяц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втКоличествоТиповых.КоличествоТиповых, 0) > 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ НЕ РасчетСебестоимостиТоваровОрганизации.Ссылка.ПредварительныйРасчет
	|	КОНЕЦ КАК Результат
	|ИЗ
	|	Документ.РасчетСебестоимостиТоваров.Организации КАК РасчетСебестоимостиТоваровОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКоличествоТиповых КАК втКоличествоТиповых
	|		ПО РасчетСебестоимостиТоваровОрганизации.Организация = втКоличествоТиповых.Организация
	|			И (НАЧАЛОПЕРИОДА(РасчетСебестоимостиТоваровОрганизации.Ссылка.Дата, МЕСЯЦ) = втКоличествоТиповых.Месяц)
	|ГДЕ
	|	РасчетСебестоимостиТоваровОрганизации.Организация = &ТекущаяОрганизация
	|	И РасчетСебестоимостиТоваровОрганизации.Ссылка.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|	И РасчетСебестоимостиТоваровОрганизации.Ссылка.Проведен";
	Запрос.УстановитьПараметр("ТекущаяОрганизация"		,Организация);
	Запрос.УстановитьПараметр("НачалоМесяца"	,НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("КонецМесяца"		,КонецМесяца(Дата));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  //ПроизведенРасчетСебестоимости()

// Функция получает таблицу значений себестоимости выпускаемых блюд и их ингредиентов для конкретного переданного
//  документа.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.питВыпускБлюд - Ссылка на документ выпуска.
//  БлюдаИИнгредиентыОтдельно - Булево - Если Истина, тогда результирующая таблица в колонке "Номенклатура"
//   будет содержать как блюда так и ингредиенты, а также колонку "ЭтоБлюдо" и ссылку на номенклатуру блюда в
//   колонке "НоменклатураБлюда" для ингредиентов.
//   Если Ложь, тогда в результирующей таблице в колонке "Номенклатура" будут только ингредиенты, также появится
//   колонка "КоличествоБлюда" и "Рецептура", по которой текущий ингредиент входит в состав блюда в текущем
//   выпуске.
//  ТолькоБлюда - Булево - Если БлюдаИИнгредиентыОтдельно = Истина, то данный флаг будет влиять на то.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица себестоимости выпущенной продукции и ингредиентов.
Функция ПолучитьТаблицуСебестоимстиБлюдИИнгредиентов(ДокументСсылка, БлюдаИИнгредиентыОтдельно = Истина, ТолькоБлюда = Истина) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов(БлюдаИИнгредиентыОтдельно, ТолькоБлюда);
	ТекстЗапроса = ТекстЗапроса + "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	резТаблицаСебестоимости.Номенклатура КАК Номенклатура,
	|	резТаблицаСебестоимости.Характеристика КАК Характеристика,
	|	резТаблицаСебестоимости.НоменклатураБлюда КАК НоменклатураБлюда,
	|	резТаблицаСебестоимости.ХарактеристикаБлюда КАК ХарактеристикаБлюда,
	|	резТаблицаСебестоимости.Рецептура КАК Рецептура,
	|	резТаблицаСебестоимости.Количество КАК Количество,
	|	резТаблицаСебестоимости.КоличествоБлюда КАК КоличествоБлюда,
	|	резТаблицаСебестоимости.Сумма КАК Сумма,
	|	резТаблицаСебестоимости.СуммаБезНДС КАК СуммаБезНДС,
	|	резТаблицаСебестоимости.СуммаРегл КАК СуммаРегл
	|ИЗ
	|	резТаблицаСебестоимости КАК резТаблицаСебестоимости
	|";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ТекстЗапросаДляСебестоимостиИнгредиентов

// Функция - Получить текст запроса вт выпуски продукции 2 2 по ссылке.
//
// Параметры:
//  ИмяВТ - Произвольный - Имя вт.
//  ИмяДокумента - Произвольный - Имя документа.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьТекстЗапросаВТВыпускиПродукции22ПоСсылке(ИмяВТ, ИмяДокумента)
	ТекстЗапроса = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	питТиповыеДокументы.ТиповойДокумент КАК ВыпускПродукции,
	|	Выпуск.Ссылка КАК ВыпускБлюд
	|ПОМЕСТИТЬ втВыпускиПродукции
	|ИЗ
	|	Документ.%ИмяДокумента% КАК Выпуск
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|		ПО Выпуск.Ссылка = питТиповыеДокументы.ДокументОбщепит
	|ГДЕ
	|	питТиповыеДокументы.ТиповойДокумент.Проведен
	|	И питТиповыеДокументы.Синхронизирован
	|	И Выпуск.Ссылка = &Ссылка
	|	И питТиповыеДокументы.ТиповойДокумент ССЫЛКА Документ.ПроизводствоБезЗаказа
	|УПОРЯДОЧИТЬ ПО
	|	питТиповыеДокументы.ТиповойДокумент.МоментВремени УБЫВ
	|";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ втВыпускиПродукции", СтрШаблон("ПОМЕСТИТЬ %1", ИмяВТ));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяДокумента%", ИмяДокумента);
	Возврат ТекстЗапроса;
КонецФункции

#КонецОбласти

#КонецОбласти




