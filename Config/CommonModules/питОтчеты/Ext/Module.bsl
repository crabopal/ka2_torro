		КомандаПечати.МенеджерПечати = "Обработка.питПечатьОтраслевыхФормПита";
		КомандаПечати.Идентификатор = "питПечатьОП4";
		КомандаПечати.Представление = НСтр("ru = 'Накладная на отпуск товара (ОП-4)'");
		КомандаПечати.ТипыОбъектовПечати.Добавить(Тип("ДокументСсылка.ПеремещениеТоваров"));
		КомандаПечати.Порядок = 72;
		
