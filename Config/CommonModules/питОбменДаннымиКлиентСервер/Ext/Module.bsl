#Область ПрограммныйИнтерфейс

// Функция - Типы узлов
//
// Параметры:
//  ТипОбмена - Число - 0 все доступные типы узлов, 1 - узлы обмена с КУ, 2 - Прочие.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки
Функция ТипыУзлов(ТипОбмена = 0) Экспорт
	
	Результат = Новый Массив;
	
	// Тип обмена с КУ.
	Если ТипОбмена = 1 Тогда
		Результат.Добавить(0);
		Результат.Добавить(1);
		Результат.Добавить(2);
		Результат.Добавить(3);
		Результат.Добавить(4);
		Результат.Добавить(8);
	ИначеЕсли ТипОбмена = 2 Тогда
		Результат.Добавить(5);
		Результат.Добавить(6);
		Результат.Добавить(7);
	ИначеЕсли ТипОбмена = 3 Тогда
		Результат.Добавить(2);
		Результат.Добавить(3);
		Результат.Добавить(4);
		Результат.Добавить(8);
	Иначе
		Для Счет = 0 По 8 Цикл
			Результат.Добавить(Счет);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

//  Функция - Свойство пропустить регистрацию.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция Свойство_ПропуститьРегистрацию() Экспорт
	Результат = "ПропуститьРегистрацию";
	Возврат Результат;
КонецФункции

// Функция возвращает разделитель GS1.
//
// Возвращаемое значение:
//  Строка.
Функция РазделительGS1() Экспорт;
	
	Возврат ОбщегоНазначенияБПОКлиентСервер.РазделительGS1(); // Dec 29
	
КонецФункции

// Функция возвращает экранированный символ GS1.
//
// Возвращаемое значение:
//  Строка.
Функция ЭкранированныйСимволGS1() Экспорт;
	
	// Используется для экранирования символа GS1.
	Возврат ОбщегоНазначенияБПОКлиентСервер.ЭкранированныйСимволGS1();
	
КонецФункции

// Функция - Нормализованный штрихкод марки.
//
// Параметры:
//  Штрихкод - Произвольный - Штрихкод.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НормализованныйШтрихкодМарки(Штрихкод) Экспорт
	Данные = СтрЗаменить(Штрихкод, РазделительGS1(), ЭкранированныйСимволGS1());
	Возврат Данные;
КонецФункции

// Функция - Восстановить штрихкод марки.
//
// Параметры:
//  Штрихкод - Произвольный - Знач штрихкод.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВосстановитьШтрихкодМарки(Знач Штрихкод) Экспорт
	Данные = СтрЗаменить(Штрихкод, ЭкранированныйСимволGS1(), РазделительGS1());
	Возврат Данные;
КонецФункции

