
#Область ПрограммныйИнтерфейс
// Процедура-обработчик события при записи объекта справочника
//
// Параметры:
//  СпрОбъект - СправочникОбъект - записываемый объект.
//  Отказ - Булево - установить в Истина, если надо отменить запись.
//
Процедура ПриЗаписиСправочника(СпрОбъект, Отказ) Экспорт
	
	Попытка
		
		Если ТипЗнч(СпрОбъект) = Тип("СправочникОбъект.питМеню") Тогда
			
			// 1. Определим список узлов в которые требуется зарегистрировать изменения
			ВидМеню = СпрОбъект.Владелец;
			МассивУзлов = питОбменДаннымиПовтИсп.ПолучитьМассивУзловДляРегистрацииПоВидуМеню(ВидМеню);
			Если МассивУзлов.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
			
			УзелОтправитель = Неопределено;
			НужныйТипУзла = Тип("ПланОбменаСсылка.питУдаленныеКассы");
			
			Если СпрОбъект.ДополнительныеСвойства.Свойство("УзелОтправитель") Тогда
				// Запоминаем в переменную
				УзелОтправитель = СпрОбъект.ДополнительныеСвойства.УзелОтправитель;
			ИначеЕсли СпрОбъект.ОбменДанными.Загрузка 
				И ЗначениеЗаполнено(СпрОбъект.ОбменДанными.Отправитель) 
				И (ТипЗнч(СпрОбъект.ОбменДанными.Отправитель) = НужныйТипУзла) Тогда
				// Запоминаем в переменную
				УзелОтправитель = СпрОбъект.ОбменДанными.Отправитель;
			КонецЕсли;
			
			// Проверим чтобы узла-отправителя не было в массиве получателей
			Если ЗначениеЗаполнено(УзелОтправитель) Тогда
				ИндексДляУдаления = МассивУзлов.Найти(УзелОтправитель);
				Если ИндексДляУдаления = Неопределено Тогда
					// узла отправителя и так не было 
				Иначе
					МассивУзлов.Удалить(ИндексДляУдаления);
				КонецЕсли;
			КонецЕсли;
			
			// Проверим чтобы в списке не было предопределенного узла это информационной базы
			ИндексДляУдаления = МассивУзлов.Найти(ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
			Если ИндексДляУдаления = Неопределено Тогда
				// ну и хорошо что не было
			Иначе
				МассивУзлов.Удалить(ИндексДляУдаления);
			КонецЕсли;
			
			// Зарегистрируем вид меню
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ВидМеню);
			// И всего его предков до корня
			Пока ЗначениеЗаполнено(ВидМеню.Родитель) Цикл
				ВидМеню = ВидМеню.Родитель;
				ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ВидМеню);
			КонецЦикла;
			
			Если НЕ СпрОбъект.ЭтоГруппа
				И ЗначениеЗаполнено(СпрОбъект.Номенклатура) Тогда
				// Нужно доп-но зарегистрировать номенклатуру по тому же списку узлов-получателей
				ТекНоменклатура = СпрОбъект.Номенклатура;
				ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ТекНоменклатура);
				// И всех предков до корня
				Пока ЗначениеЗаполнено(ТекНоменклатура.Родитель) Цикл
					ТекНоменклатура = ТекНоменклатура.Родитель;
					ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ТекНоменклатура);
				КонецЦикла;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(СпрОбъект) = Тип("СправочникОбъект.Номенклатура") Тогда
			
			ЗарегистрироватьВыгружаемуюНоменклатуру(СпрОбъект);
			
		ИначеЕсли ТипЗнч(СпрОбъект) = Тип("СправочникОбъект.КассыККМ") Тогда
			
			// Регистрация в указанном плане обмена
			Если ЗначениеЗаполнено(СпрОбъект.питКассовыйУзел) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(СпрОбъект.питКассовыйУзел, СпрОбъект.Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание + " (в модуле """ + ИнфОбОшибке.ИмяМодуля + """, Строка № " + XMLСтрока(ИнфОбОшибке.НомерСтроки) + ")";
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("УдаленныеКассы.РегистрацияПоПодписке", УровеньЖурналаРегистрации.Ошибка, , СпрОбъект, ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Процедура-обработчик события при удалении объекта справочника
//
// Параметры:
//  СпрОбъект - СправочникОбъект - записываемый объект.
//  Отказ - Булево - установить в Истина, если надо отменить удаление.
//
Процедура ПриУдаленииСправочника(СпрОбъект, Отказ) Экспорт

	Попытка
	
		Если ТипЗнч(СпрОбъект) = Тип("СправочникОбъект.питМеню") Тогда
			
			// 1. Определим список узлов в которые требуется зарегистрировать изменения
			ВидМеню = СпрОбъект.Владелец;
			МассивУзлов = питОбменДаннымиПовтИсп.ПолучитьМассивУзловДляРегистрацииПоВидуМеню(ВидМеню);
			Если МассивУзлов.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
			
			УзелОтправитель = Неопределено;
			НужныйТипУзла = Тип("ПланОбменаСсылка.питУдаленныеКассы");
			
			Если СпрОбъект.ДополнительныеСвойства.Свойство("УзелОтправитель") Тогда
				// Запоминаем в переменную
				УзелОтправитель = СпрОбъект.ДополнительныеСвойства.УзелОтправитель;
			ИначеЕсли СпрОбъект.ОбменДанными.Загрузка 
				И ЗначениеЗаполнено(СпрОбъект.ОбменДанными.Отправитель) 
				И (ТипЗнч(СпрОбъект.ОбменДанными.Отправитель) = НужныйТипУзла) Тогда
				// Запоминаем в переменную
				УзелОтправитель = СпрОбъект.ОбменДанными.Отправитель;
			КонецЕсли;
			
			// Проверим чтобы узла-отправителя не было в массиве получателей
			Если ЗначениеЗаполнено(УзелОтправитель) Тогда
				ИндексДляУдаления = МассивУзлов.Найти(УзелОтправитель);
				Если ИндексДляУдаления = Неопределено Тогда
					// узла отправителя и так не было 
				Иначе
					МассивУзлов.Удалить(ИндексДляУдаления);
				КонецЕсли;
			КонецЕсли;
			
			// Проверим чтобы в списке не было предопределенного узла это информационной базы
			ИндексДляУдаления = МассивУзлов.Найти(ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
			Если ИндексДляУдаления = Неопределено Тогда
				// ну и хорошо что не было
			Иначе
				МассивУзлов.Удалить(ИндексДляУдаления);
			КонецЕсли;
			
			// Зарегистрируем вид меню
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ВидМеню);
			
		ИначеЕсли ТипЗнч(СпрОбъект) = Тип("СправочникОбъект.Номенклатура") Тогда
			
			ЗарегистрироватьВыгружаемуюНоменклатуру(СпрОбъект);
			
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание + " (в модуле """ + ИнфОбОшибке.ИмяМодуля + """, Строка № " + XMLСтрока(ИнфОбОшибке.НомерСтроки) + ")";
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("УдаленныеКассы.РегистрацияПоПодписке", УровеньЖурналаРегистрации.Ошибка, , СпрОбъект, ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

// Процедура обработки документов при проведении.
//
// Параметры:
//  Источник - Произвольный, Форма - источник события.
//   Отказ	 - Булево, признак отказа от проведения.
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ДокументыОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	// Отправить новые цены в кассовые узлы
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.УстановкаЦенНоменклатуры") Тогда
		ЗарегистрироватьВидыМенюПоИзменениюЦен(Источник.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Общепит обмен данными регистрация перед записью перед записью.
//
// Параметры:
//  СпрОбъект - Произвольный - Спр объект.
//  Отказ - Булево - Отказ.
//
Процедура ОбщепитОбменДаннымиРегистрацияПередЗаписьюПередЗаписью(СпрОбъект, Отказ) Экспорт
	
	Попытка
		Если ТипЗнч(СпрОбъект) = Тип("СправочникОбъект.Номенклатура") Тогда
			
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание + " (в модуле """ + ИнфОбОшибке.ИмяМодуля + """, Строка № " + XMLСтрока(ИнфОбОшибке.НомерСтроки) + ")";
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("УдаленныеКассы.РегистрацияПоПодписке", УровеньЖурналаРегистрации.Ошибка, , СпрОбъект, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Процедура-обработчик события при записи объекта справочника
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - установить в Истина, если надо отменить запись.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура РегистрСведенийПередЗаписью(Источник, Отказ, ДополнительныеПараметры=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдаленныеКассы.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК УдаленныеКассы
	|ГДЕ
	|	НЕ УдаленныеКассы.Ссылка = &ЭтотУзел";
	
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;

	МассивУзлов = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивУзлов.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(МассивУзлов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ШтрихкодыНоменклатуры") Тогда
		Если ЗначениеЗаполнено(Источник) Тогда
			Для Каждого ТекЗапись Из Источник Цикл
				Если НЕ ЗначениеЗаполнено(ТекЗапись.Номенклатура) Тогда
					Продолжить;
				КонецЕсли;
				питОбменДанными.ДопРегистрацияСправочника(МассивУзлов, ТекЗапись.Номенклатура);
			КонецЦикла;
		ИначеЕсли ЗначениеЗаполнено(Источник.Отбор.Штрихкод.Значение) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
			|ГДЕ
			|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
			Запрос.УстановитьПараметр("ШтрихКод", Источник.Отбор.Штрихкод.Значение);
			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Пока Выборка.Следующий() Цикл
					питОбменДанными.ДопРегистрацияСправочника(МассивУзлов, Выборка.Номенклатура);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет регистрацию элементов справочника ВидыМеню
//  по плану обмена "Удаленные кассы" в случае, если у номенклатуры, входящей
//  в состав меню
//
// Параметры:
//  ДокСсылка - Произвольный - Док ссылка.
//
Процедура ЗарегистрироватьВидыМенюПоИзменениюЦен(ДокСсылка) 
	
	Попытка
		
		// Узнаем имя документа.
		Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры") Тогда
			ИмяДокумента = "УстановкаЦенНоменклатуры";
		Иначе
			// Тип документа не поддерживается данной процедурой.
			Возврат;
		КонецЕсли;
		
		// Определим виды меню, которые это вообще затронуло (из-за содержащейся в них переоцененной номенклатуры)
		ТЗ = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВидыМеню.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.питВидыМеню КАК ВидыМеню
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.питМеню КАК ПрайсЛист
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ."+ИмяДокумента+".Товары КАК "+ИмяДокумента+"Товары
		|			ПО ПрайсЛист.Номенклатура = "+ИмяДокумента+"Товары.Номенклатура
		|		ПО ВидыМеню.Ссылка = ПрайсЛист.Владелец
		|ГДЕ
		|	НЕ ВидыМеню.ЭтоГруппа
		|	И НЕ ВидыМеню.ПометкаУдаления
		|	И "+ИмяДокумента+"Товары.Ссылка = &ВыбДок
		|	И ((ВидыМеню.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)) ИЛИ (ВидыМеню.ДатаОкончанияДействия < &ВыбДатаДействия))
		|	И ((ВидыМеню.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1))	ИЛИ (ВидыМеню.ДатаНачалаДействия < ДОБАВИТЬКДАТЕ(&ВыбДатаДействия, МЕСЯЦ, 1)))
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	"+ИмяДокумента+"ВидыЦен.ВидЦены
		|ИЗ
		|	Документ."+ИмяДокумента+".ВидыЦен КАК "+ИмяДокумента+"ВидыЦен
		|ГДЕ
		|	"+ИмяДокумента+"ВидыЦен.Ссылка = &ВыбДок
		|";
		
		Запрос = Новый Запрос(ТЗ);
		Запрос.УстановитьПараметр("ВыбДок", ДокСсылка);
		Запрос.УстановитьПараметр("ВыбДатаДействия", НачалоДня(ТекущаяДата()));
		
		РезЗапроса = Запрос.ВыполнитьПакет();
		Если РезЗапроса[0].Пустой() Тогда
			Возврат; // никого не затронуло - делать ничего не нужно
		КонецЕсли;
		
		ТЗВидовМеню = РезЗапроса[0].Выгрузить();
		// Вот массив видов меню, которые нужно разослать в кассовые узлы
		МассивВидовМеню = ТЗВидовМеню.ВыгрузитьКолонку("Ссылка");
		
		ТЗВидовЦен = РезЗапроса[1].Выгрузить();
		// Вот массив видов меню, которые нужно разослать в кассовые узлы
		МассивВидовЦен = ТЗВидовЦен.ВыгрузитьКолонку("ВидЦены");
		
//   Получим таблицу использования видов меню кассовыми узлами с индивидуальными списками (кроме лежащих в подгруппах
// видов меню).
		ТЗ = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УдаленныеКассы.Ссылка КАК УзелСсылка,
		|	УдаленныеКассыВидыМеню.ВидМеню КАК ВидМенюСсылка
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы КАК УдаленныеКассы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.питВидыМеню КАК ВидыМеню
		|			ПО УдаленныеКассыВидыМеню.ВидМеню = ВидыМеню.Ссылка
		|		ПО УдаленныеКассы.Ссылка = УдаленныеКассыВидыМеню.Ссылка
		|ГДЕ
		|	НЕ УдаленныеКассы.Ссылка = &ЭтотУзел
		|	И УдаленныеКассы.ИндивидуальныйСписокВидовМенюИНоменклатуры
		|	И УдаленныеКассыВидыМеню.ТипЦен В(&ВыбТипЦен)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	питУдаленныеКассы.Ссылка,
		|	ЕСТЬNULL(питУдаленныеКассыВидыМеню.ВидМеню, ЗНАЧЕНИЕ(Справочник.питВидыМеню.ПустаяСсылка))
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.питУдаленныеКассы.ВидыМеню КАК питУдаленныеКассыВидыМеню
		|		ПО (питУдаленныеКассыВидыМеню.Ссылка = питУдаленныеКассы.Ссылка)
		|ГДЕ
		|	ЕСТЬNULL(питУдаленныеКассыВидыМеню.ВидМеню, ЗНАЧЕНИЕ(Справочник.питВидыМеню.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.питВидыМеню.ПустаяСсылка)
		|	И питУдаленныеКассы.ВидЦен В(&ВыбТипЦен)
		|	И НЕ питУдаленныеКассы.Ссылка = &ЭтотУзел";
		
		
		Запрос = Новый Запрос(ТЗ);
		Запрос.УстановитьПараметр("ЭтотУзел", 	ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
		Запрос.УстановитьПараметр("ВыбТипЦен", 	МассивВидовЦен);
		
		ЕстьУзлыСиндСписком = Ложь;
		РезЗапроса = Запрос.Выполнить();
		Если НЕ РезЗапроса.Пустой() Тогда
			// Придется перебирать и виды меню и узлы тоже
			ТабЗначУзловИМеню = РезЗапроса.Выгрузить();
			ЕстьУзлыСиндСписком = Истина;
		КонецЕсли;
			
		Для Каждого ТекущВидМенюСсылка ИЗ МассивВидовМеню Цикл
			
			МассивУзловПолучателей = Новый Массив;
			
			Если ЕстьУзлыСиндСписком Тогда
				// Далее по таблице ищем какие из узлов с инд. списками тоже должны получить текущее меню
				Для Каждого СтрокаТЗ ИЗ ТабЗначУзловИМеню Цикл
					Если (СтрокаТЗ.ВидМенюСсылка = ТекущВидМенюСсылка) ИЛИ // точное соответствие
						 ((СтрокаТЗ.ВидМенюСсылка.ЭтоГруппа И ТекущВидМенюСсылка.ПринадлежитЭлементу(СтрокаТЗ.ВидМенюСсылка))) // через группу-родителя
						 ИЛИ (СтрокаТЗ.ВидМенюСсылка = Справочники.питВидыМеню.ПустаяСсылка())
					Тогда
						// Добавляем кассовый узел в получатели с проверкой на дубли
						Если МассивУзловПолучателей.Найти(СтрокаТЗ.УзелСсылка) = НЕОПРЕДЕЛЕНО Тогда 
							МассивУзловПолучателей.Добавить(СтрокаТЗ.УзелСсылка); // Добавим в список получателей еще один узел
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если МассивУзловПолучателей.Количество() > 0 Тогда
				// Зарегистрируем текущий вид меню сразу для всего определившегося списка(массива) узлов-получателей
				ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловПолучателей, ТекущВидМенюСсылка);
			КонецЕсли;
			
		КонецЦикла;
			
	Исключение
		// Не получилось, соберем информацию почему именно
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока НЕ (ИнфОбОшибке.Причина = Неопределено) Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
						|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ОписаниеРезультата = "Не удалось зарегистрировать виды меню для отправки в кассовые узлы из-за ошибки: " + ТекстОшибки;
		ЗаписьЖурналаРегистрации("ОбменУдаленныеКассы.Регистрация", УровеньЖурналаРегистрации.Ошибка, , ДокСсылка, ОписаниеРезультата);
		
	КонецПопытки;
	
КонецПроцедуры // ЗарегистрироватьВидыМенюПоИзменениюЦен

// Процедура регистрирует номенклатуру, которая должна выгружаться во фронт-офис.
//
// Параметры:
//  СпрОбъект - СправочникОбъект.Номенклатура - Объект номенклатуры, который записывается данный момент.
//
Процедура ЗарегистрироватьВыгружаемуюНоменклатуру(СпрОбъект)
	
	питОбменДанными.ЗарегистрироватьВсюНоменклатуруДляЭлемента(СпрОбъект.Ссылка, Ложь);
	
КонецПроцедуры

// Процедура устанавливает флаг "Выгружать во фронт" всем группам, которые входят в переданную по иерархии.
//
// Параметры:
//  ГруппаНоменклатуры	 - СправочникСсылка.Номенклатура - Ссылка на группу.
//
Процедура УстановитьФлагВыгрузкиГруппамПотомкам(ГруппаНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&ГруппаНоменклатуры)
	|	И Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.питВыгружатьВРБК";
	Запрос.УстановитьПараметр("ГруппаНоменклатуры", ГруппаНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ГруппаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ГруппаОбъект.питВыгружатьВРБК = Истина;
		ГруппаОбъект.ДополнительныеСвойства.Вставить("УстановкаФлагаВыгрузки", Истина);
		ГруппаОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти




