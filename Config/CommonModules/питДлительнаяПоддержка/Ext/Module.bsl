// %ИзЕРП% НоменклатураСервер.НовыеПараметрыУсловногоОформленияЕдиницИзмерения(
//
Функция НовыеПараметрыУсловногоОформленияЕдиницИзмерения(ИспользуетсяАдресноеХранение = Ложь, ИспользуетсяТипИзмеряемойВеличины = Ложь) Экспорт
	
	ИспользоватьНовыйВызов = питДлительнаяПоддержкаПовтИсп.ИспользоватьНовыйВызов();
	Если ИспользоватьНовыйВызов Тогда
		Возврат НоменклатураСервер.НовыеПараметрыУсловногоОформленияЕдиницИзмерения(
			ИспользуетсяАдресноеХранение, ИспользуетсяТипИзмеряемойВеличины);
	Иначе
		Возврат Новый Структура("ИмяПоляЕдиницаИзмерения, ПутьКПолюУпаковка");
	КонецЕсли;
	
КонецФункции

// %ИзЕРП% НоменклатураСервер.УстановитьУсловноеОформлениеЕдиницИзмерения
//
Процедура УстановитьУсловноеОформлениеЕдиницИзмерения(Форма, ПараметрыУсловногоОформления) Экспорт
	
	ИспользоватьНовыйВызов = питДлительнаяПоддержкаПовтИсп.ИспользоватьНовыйВызов();
	Если ИспользоватьНовыйВызов Тогда
		НоменклатураСервер.УстановитьУсловноеОформлениеЕдиницИзмерения(Форма, ПараметрыУсловногоОформления);
	Иначе
		НоменклатураСервер.УстановитьУсловноеОформлениеЕдиницИзмерения(
			Форма,
			ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения,
			ПараметрыУсловногоОформления.ПутьКПолюУпаковка);
	КонецЕсли;
	
КонецПроцедуры

