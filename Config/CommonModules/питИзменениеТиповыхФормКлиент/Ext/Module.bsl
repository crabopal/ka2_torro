/////////////////////////////////////////////////////////////////////////////////////
// ПЕРЕОПРЕДЕЛЯЕМЫЕ ПРОЦЕДУРЫ, ВЫЗЫВАЕМЫЕ ИЗ ОБРАБОТЧИКОВ ТИПОВЫХ ФОРМ.

#Область ПрограммныйИнтерфейс

#Область Общие

// Переопределяемая процедура, вызываемая из одноименного обработчика события формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
Процедура ПослеЗаписи(Форма, ПараметрыЗаписи)Экспорт
	
КонецПроцедуры

//  Процедура - Выполнить переопределяемую команду.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Команда - Произвольный - Команда.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	Если Форма.ИмяФормы = "Обработка.ПанельОбменЕГАИС.Форма.Форма" Тогда
		Если Команда.Имя = "питДобавлениеПродукцииЕГАИС" Тогда
			ОткрытьФорму("Документ.питДобавлениеНовойПродукцииЕГАИС.ФормаСписка", , Форма);
		ИначеЕсли Команда.Имя = "питИнвентаризацияЕГАИС" Тогда
			ОткрытьФорму("Документ.питИнвентаризацияЕГАИС.ФормаСписка", , Форма);
		ИначеЕсли Команда.Имя = "питАктВскрытияТарыАлкогольнойПродукции" Тогда
			ОткрытьФорму("Документ.питАктВскрытияТарыАлкогольнойПродукции.ФормаСписка", , Форма);
		КонецЕсли;
	// В форме отсутствует подключаемый обработчик выполнения команд, пока команда будет в подсистеме "общепит".
	// ИначеЕсли Форма.ИмяФормы = "Обработка.ПанельОбменИСМП.Форма.Форма" Тогда
	// 	Если Команда.Имя = "питКорректировкаОстатковИС" Тогда
	// 		ОткрытьФорму("Документ.питКорректировкаОстатковИС.ФормаСписка", , Форма);
	// 	КонецЕсли;
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		Если Команда.Имя = "питРедактированиеМодификаторов" Тогда
			НоменклатураРедактированиеМодификаторов(Форма, Команда, ДополнительныеПараметры);
		ИначеЕсли Команда.Имя = "питОбновитьМодификаторы" Тогда
			НоменклатураОбновитьМодификаторы(Форма, Команда, ДополнительныеПараметры);
		ИначеЕсли Команда.Имя = "питРецептурыНоменклатуры" Тогда
			ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Номенклатура", Форма.Объект.Ссылка));
			ПараметрыФормы.Вставить("ИзФормыНоменклатуры", Истина);
			ПараметрыФормы.Вставить("ТоварыНоменклатура", Неопределено);
			ОткрытьФорму("Документ.питРецептура.ФормаСписка", ПараметрыФормы, Форма, , ВариантОткрытияОкна.ОтдельноеОкно);
			
		ИначеЕсли Команда.Имя = "питВРецептурах" Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ИзФормыНоменклатуры", Истина);
			ПараметрыФормы.Вставить("ТоварыНоменклатура", Форма.Объект.Ссылка);
			ОткрытьФорму("Документ.питРецептура.ФормаСписка", ПараметрыФормы, Форма, , ВариантОткрытияОкна.ОтдельноеОкно);
		ИначеЕсли Команда.Имя = "питВидНоменклатуры" Тогда
			питВидНоменклатурыПриИзменении(Форма);
		ИначеЕсли Команда.Имя = "питАлкогольныеРецептуры" Тогда
			
			Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
				ТекстСообщения = НСтр("ru='Для перехода необходимо записать элемент'", "ru");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
			
			ВходныеПараметры = Новый Структура;
			ВходныеПараметры.Вставить("Блюдо", Форма.Объект.Ссылка);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор", ВходныеПараметры);
			ПараметрыФормы.Вставить("Номенклатура", Форма.Объект.Ссылка);
			ПараметрыФормы.Вставить("Наименование", Форма.Объект.Наименование);
			ПараметрыФормы.Вставить("ЕдиницаИзмерения", Форма.Объект.ЕдиницаИзмерения);
			ПараметрыФормы.Вставить("ПродаетсяВРозлив", Форма.Объект.питПродажаВРозлив);
			ПараметрыФормы.Вставить("ТолькоПросмотр", Форма.ТолькоПросмотр);
			
			ОбработчикОповещения = Новый ОписаниеОповещения("ОбработчикОповещения_ЗавершениеНастройкиАлкосостава", ЭтотОбъект, 
				Новый Структура("Форма", Форма));
			ОткрытьФорму("РегистрСведений.питАлкогольныеРецептуры.Форма.ФормаНастройкиНоменклатуры",ПараметрыФормы, ЭтотОбъект,,,, 
				ОбработчикОповещения,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаСписка" Тогда
		Если Команда.Имя = "питЗагрузкаFoodCost" Тогда
			ОткрытьФорму("Обработка.питЗагрузкаССайтаFoodCost.Форма", ПараметрыФормы, Форма, , ВариантОткрытияОкна.ОтдельноеОкно);
		КонецЕсли;
	ИначеЕсли Форма.ИмяФормы = "Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание" Тогда
		Если Команда.Имя = "питПерейтиКПараметрам" Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Форма", Форма);
			ОбработчикОповещения= Новый ОписаниеОповещения("ОбработчикОповещения_ЗавершениеУстановкиПараметров", ЭтотОбъект, ДополнительныеПараметры);
			
			ПараметрыВФорму = Новый Структура("ИмяМетаданных, Идентификатор, Действие, питПараметрыВХранилище", Форма.ИмяМетаданных, Форма.Параметры.Идентификатор, Форма.Действие, Форма.питПараметрыВХранилище);
			ОткрытьФорму("Обработка.РегламентныеИФоновыеЗадания.Форма.питПараметрыРегламентногоЗадания", ПараметрыВФорму,,,,, ОбработчикОповещения);
		КонецЕсли;
	ИначеЕсли Форма.ИмяФормы = "Справочник.СпособыОбеспеченияПотребностей.Форма.ФормаЭлемента" Тогда
		Если Команда.Имя = "питТипОбеспечения1"
			ИЛИ Команда.Имя = "питТипОбеспечения2" Тогда
			ТипОбеспеченияПриИзменении(Форма);
		ИначеЕсли Команда.Имя = "питСклад" 
			ИЛИ Команда.Имя = "питПодразделение" Тогда
			питИзменениеТиповыхФормКлиентСервер.СпособыОбеспеченияПотребностейУправлениеФормой(Форма);
		КонецЕсли;
	ИначеЕсли Форма.ИмяФормы = "Документ.АктСписанияЕГАИС.Форма.ФормаДокумента" Тогда
		Если Команда.Имя = "питАкцизныеМаркиЧастичноеВыбытиеКоличество" Тогда
			АктСписанияЕГАИС_питЧастичноеВыбытиеКоличествоПриИзменении(Форма);
			Возврат;
		ИначеЕсли Команда.Имя = "Товары" Тогда
			АктСписанияЕГАИС_ТоварыПриАктивизацииСтроки(Форма);
			Возврат;
		КонецЕсли;
		
		МодульпитЕГАИСОбщегоНазначения = ОбщегоНазначенияКлиент.ОбщийМодуль("питЕГАИСОбщегоНазначения");
		МодульпитЕГАИСОбщегоНазначенияКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("питЕГАИСОбщегоНазначенияКлиент");
		ПараметрыСканированияАкцизныхМарок = МодульпитЕГАИСОбщегоНазначенияКлиент.ПараметрыСканированияАкцизныхМарок(Форма);
		ОбъектФ = Форма.Объект;
		Если Команда.Имя = "питКомандаЗаполнитьПоПродажамЗаДень" Тогда
			МодульпитЕГАИСОбщегоНазначения.ЗаполнитьПоПродажамЗаДень(ОбъектФ, Ложь, ПараметрыСканированияАкцизныхМарок);
		ИначеЕсли Команда.Имя = "питКомандаЗаполнитьПоПродажамЗаДеньТолькоНовые" Тогда 
			МодульпитЕГАИСОбщегоНазначения.ЗаполнитьПоПродажамЗаДень(ОбъектФ, Истина, ПараметрыСканированияАкцизныхМарок);
		ИначеЕсли Команда.Имя = "питКомандаЗаполнитьПроизводствомЗаДень"
			ИЛИ Команда.Имя = "питКомандаЗаполнитьПродажамиПорцийЗаДень"
			ИЛИ Команда.Имя = "питКомандаЗаполнитьПродажамиКоктейлейЗаДень" Тогда
			
			Если НЕ ЗначениеЗаполнено(Форма.Объект.ОрганизацияЕГАИС) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Заполните организацию ЕГАИС!'"));
				Возврат;
			КонецЕсли;
			ПричинаСписанияПриготовление = ПредопределенноеЗначение("Перечисление.ПричиныСписанийЕГАИС.питПриготовление");
			Если НЕ ЗначениеЗаполнено(Форма.Объект.ПричинаСписания) Тогда
				Форма.Объект.ПричинаСписания = ПричинаСписанияПриготовление;
			ИначеЕсли НЕ Форма.Объект.ПричинаСписания = ПричинаСписанияПриготовление Тогда
				ТекстВопроса = СтрШаблон(НСтр("ru='Установленная причина списания <%1> отличается от <%2>. Заполнение отменено.'"),
					Форма.Объект.ПричинаСписания, ПричинаСписанияПриготовление);
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстВопроса);
				Возврат;
			КонецЕсли;
			Если Форма.Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.АктСписанияИзРегистра2") Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru='Заполнение списанных марок при производстве доступно только при списании с 1 и 3 регистра'"));
				Возврат;
			КонецЕсли;    
			
			Если Команда.Имя = "питКомандаЗаполнитьПроизводствомЗаДень" Тогда
				СпособЗаполнения = 0;	
			ИначеЕсли Команда.Имя = "питКомандаЗаполнитьПродажамиПорцийЗаДень" Тогда
				СпособЗаполнения = 1;	
			Иначе //питКомандаЗаполнитьПродажамиКоктейлейЗаДень
				СпособЗаполнения = 2;	
			КонецЕсли;
			
			МодульпитЕГАИСОбщегоНазначения.ЗаполнитьПроизводствомЗаДень(ОбъектФ, Истина, ПараметрыСканированияАкцизныхМарок, СпособЗаполнения);
			
		КонецЕсли;
		КопироватьДанныеФормы(ОбъектФ,Форма.Объект); 
		Форма.Модифицированность = Истина;
		// АкцизныеМаркиЕГАИС.ЗаполнитьСлужебныеРеквизиты(Форма);
		
	ИначеЕсли Команда.Имя = "питОткрытьДокументОбщепит" Тогда
		
		мДокументПит = Неопределено;
		Объект = Форма.Объект;
		Если НЕ Объект.Ссылка.Пустая() И питТиповыеДокументы.НайтиДокументпитДляТиповогоДокумента(Объект.Ссылка, мДокументПит) Тогда
			ОповещениеЗначения = Новый ОписаниеОповещения("ВыполнитьПереопределяемуюКомандуЗавершение", питИзменениеТиповыхФормКлиент.ЭтотОбъект, Новый Структура);
			Попытка
				ПоказатьЗначение(ОповещениеЗначения,мДокументПит);
			Исключение
			КонецПопытки;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ ""Общепит"" не найден!");
		КонецЕсли;
		
	ИначеЕсли Команда.Имя = "питСоздатьЗапросОстатковВРегистре3Общепит" Тогда
		
		ОтчетЕГАИС_СоздатьЗапросОтчета(ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл"));
		
	// ИначеЕсли Форма.ИмяФормы = "ВнешняяОбработка.ФормированиеЗаказовНаПроизводствоПоПлану.Форма.Форма" Тогда
	ИначеЕсли Форма.ИмяФормы = "Обработка.ФормированиеЗаказовНаПроизводствоПоПлану.Форма.Форма" Тогда
		питПланированиеКлиент.ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Перед формированием отчета.
//
// Параметры:
//  ФормаОтчета - Произвольный - Форма отчета.
//
Процедура ПередФормированиемОтчета(ФормаОтчета) Экспорт
	Если СтрЗаканчиваетсяНа(ФормаОтчета.ИмяФормы, "питАнализПродажПоЧекам.Форма") 
		ИЛИ СтрЗаканчиваетсяНа(ФормаОтчета.ИмяФормы, "питАнализПродажСМодификаторамиПоЧекам.Форма") 
		ИЛИ СтрЗаканчиваетсяНа(ФормаОтчета.ИмяФормы, "питАнализОплатПоЧекам.Форма") Тогда
		ЗначениеПараметра = ПолучитьПараметрДниНедели(ФормаОтчета);
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(ФормаОтчета.Отчет.КомпоновщикНастроек, "ДниНедели", ЗначениеПараметра, НЕ ПустаяСтрока(ЗначениеПараметра));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// %ИзЕРП% Необходимо отслеживать типовые изменения и актуализировать данные функции
#Область СправочникСпособыОбеспеченияПотребностейФормаФормаЭлемента

//  Процедура - Тип обеспечения при изменении.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
Процедура ТипОбеспеченияПриИзменении(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	Объект.ИсточникОбеспеченияПотребностей = Неопределено;
	Объект.Соглашение =  ПредопределенноеЗначение("Справочник.СоглашенияСПоставщиками.ПустаяСсылка");
	Объект.ВидЦеныПоставщика = ПредопределенноеЗначение("Справочник.ВидыЦенПоставщиков.ПустаяСсылка");
	
	Если Объект.ТипОбеспечения = ПредопределенноеЗначение("Перечисление.ТипыОбеспечения.питПроизводство") Тогда
		Объект.Подразделение		= Форма.питПодразделениеПред;
		Объект.ИсточникОбеспеченияПотребностей	= Форма.питЦеховаяКладоваяПред;
	КонецЕсли;
	
	питИзменениеТиповыхФормКлиентСервер.СформироватьЗаголовкиПоясняющихНадписей(Форма);
	питИзменениеТиповыхФормКлиентСервер.АктивизироватьСтраницы(Форма);
	
КонецПроцедуры

#КонецОбласти

// Процедура-заглушка.
//
// Параметры:
//  Параметр1 - Произвольный - Параметр 1.
//  Параметр2 - Произвольный - Параметр 2.
//
Процедура ВыполнитьПереопределяемуюКомандуЗавершение(Параметр1, Параметр2) Экспорт
	Заглушка = 0;
КонецПроцедуры

//  Процедура - Обработчик оповещения завершение установки параметров.
//
// Параметры:
//  РезультатОткрытияФормы - Произвольный - Результат открытия формы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура ОбработчикОповещения_ЗавершениеУстановкиПараметров(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Форма.питПараметрыВХранилище = РезультатОткрытияФормы; // Адрес в хранилище

КонецПроцедуры

//  Процедура - Обработчик оповещения завершение настройки алкосостава.
//
// Параметры:
//  РезультатОткрытияФормы - Произвольный - Результат открытия формы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура ОбработчикОповещения_ЗавершениеНастройкиАлкосостава(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт

	Если РезультатОткрытияФормы = Неопределено
		ИЛИ НЕ РезультатОткрытияФормы.Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Форма.Объект.питПродажаВРозлив = РезультатОткрытияФормы.ПродаетсяВРозлив;
	ДополнительныеПараметры.Форма.Модифицированность = Истина;
	//ДопПараметры = Новый Структура;
	//ДопПараметры.Вставить("ОбъектСсылка", ДополнительныеПараметры.Форма.Объект.Ссылка);
	//ДопПараметры.Вставить("АдресДанныхНастроекПараметровНоменклатурыИС", ДополнительныеПараметры.Форма.АдресДанныхНастроекПараметровНоменклатурыИС);
	//питИзменениеТиповыхФормСервер.питОбновитьАлкогольныеРеквизитыНоменклатуры(ДопПараметры);
	
	Если НЕ ДополнительныеПараметры.Форма.Объект.питПродажаВРозлив Тогда
		Возврат;
	Иначе
		ВидыПродукцииИС = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоКлючу(ДополнительныеПараметры.Форма.КлючВидовПродукции);
		Для Каждого ВидПродукции Из ВидыПродукцииИС Цикл
			Если питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииПива(ВидПродукции)
				ИЛИ питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииАлкоголя(ВидПродукции) Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Указано, что продукция состоит только алкоголя, но при этом особенность учета не заполнена.
		|Рекомендуется установить вид продукции в Алкогольная или Пиво'"));
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ВидПродукцииГИСМТ", "Объект");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиКомандФормыНоменклатуры

//  Процедура - Номенклатура редактирование модификаторов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Команда - Произвольный - Команда.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура НоменклатураРедактированиеМодификаторов(Форма, Команда, ДополнительныеПараметры)
	
	Объект = Форма.Объект;
	ПараметрыФормы = Новый Структура ("Номенклатура", Объект.Ссылка);
	ОткрытьФорму("Обработка.питМодификаторыНоменклатуры.Форма",ПараметрыФормы, Форма);
	
КонецПроцедуры

//  Процедура - Номенклатура обновить модификаторы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Команда - Произвольный - Команда.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура НоменклатураОбновитьМодификаторы(Форма, Команда, ДополнительныеПараметры)
	
	// Очистка данные формы дерево "Модификаторы"
	Форма.питМодификаторы.ПолучитьЭлементы().Очистить();
	
	// Получаем данные по модификаторам
	НовДерево = питИзменениеТиповыхФормСервер.ЗаполнитьМодификаторы(Форма.питМодификаторы, Форма.Объект.Ссылка);
	
	// Заполняем дерево
	ЗаполнитьДеревоФормы(Форма.питМодификаторы, НовДерево);
	
КонецПроцедуры

//  Процедура - пит вид номенклатуры при изменении.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
Процедура питВидНоменклатурыПриИзменении(Форма)
	
	ДопустимыеВидыНоменклатуры = Новый Массив;
	ДопустимыеВидыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Товар"));
	ДопустимыеВидыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
	ДопустимыеВидыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
	
	Если Форма.Объект.питВидНоменклатуры = ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.БизнесЛанч")
		И ДопустимыеВидыНоменклатуры.Найти(Форма.Объект.ТипНоменклатуры) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номенклатура с видом общепит ""Бизнес-банч"" может быть только товаром/услугой/работой!");
		Форма.Объект.питВидНоменклатуры = Форма.питВидНоменклатурыКопия;
	Иначе
		Форма.питВидНоменклатурыКопия = Форма.Объект.питВидНоменклатуры;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


// Процедура заполняет дерево формы по уже существующему дереву формы-источнику
//
// Параметры:
//  ДеревоПриемник - ДанныеФормыДерево - Заполняемое дерево.
//  ДеревоИсточник - ДанныеФормыДерево - Дерево, источник данных для заполнения.
//
Процедура ЗаполнитьДеревоФормы(ДеревоПриемник, ДеревоИсточник)
	
	ТекЭлементыПриемника	= ДеревоПриемник.ПолучитьЭлементы();
	ТекЭлементыИсточника	= ДеревоИсточник.ПолучитьЭлементы();
	
	Для каждого ТекЭлементИсточника Из ТекЭлементыИсточника Цикл
		
		НовЭлеменПриемника = ТекЭлементыПриемника.Добавить();
		ЗаполнитьЗначенияСвойств(НовЭлеменПриемника,ТекЭлементИсточника);
		
		ЗаполнитьДеревоФормы(НовЭлеменПриемника, ТекЭлементИсточника);
		
	КонецЦикла;
	
КонецПроцедуры

//  Функция - Получить параметр дни недели.
//
// Параметры:
//  ФормаОтчета - Произвольный - Форма отчета.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьПараметрДниНедели(ФормаОтчета)
	Результат = "";
	ЕстьВыбранныеДни = Ложь;
	Для Сч=1 По 7 Цикл
		Результат = Результат + ?(ФормаОтчета["ФлДень" + Сч], "1", "0");
		Если ФормаОтчета["ФлДень" + Сч] Тогда
			ЕстьВыбранныеДни = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ЕстьВыбранныеДни, Результат, "");
КонецФункции

// +пит
#Область ОбработчикиСобытийЭлементовФормыАктСписанияЕГАИС


Процедура АктСписанияЕГАИС_ТоварыПриАктивизацииСтроки(Форма)
	
	ОбновитьОтборПоОсновнойСтрокеТоваров(Форма);
	
КонецПроцедуры

Процедура АктСписанияЕГАИС_питЧастичноеВыбытиеКоличествоПриИзменении(Форма)
	ТекДанные = Форма.Элементы.питАкцизныеМарки.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрокаТовары = Форма.Элементы.Товары.ТекущиеДанные;
	
	Если НЕ ТекСтрокаТовары = Неопределено
		И НЕ ЗначениеЗаполнено(ТекДанные.ЧастичноеВыбытиеВариантУчета) Тогда
		ТекДанные.ЧастичноеВыбытиеВариантУчета = ПредопределенноеЗначение("Перечисление.ВариантыУчетаЧастичногоВыбытияИС.ТекущаяНоменклатура");
		ТекДанные.ЧастичноеВыбытиеНоменклатура = ТекСтрокаТовары.Номенклатура;
		ТекДанные.ЧастичноеВыбытиеХарактеристика = ТекСтрокаТовары.Характеристика;
	КонецЕсли;
	
	питПерераспределитьКоличествоПоЧастичномуВыбытию(Форма);
КонецПроцедуры

Процедура ОбновитьОтборПоОсновнойСтрокеТоваров(Форма)
	
	ТекДанные = Форма.Элементы.Товары.ТекущиеДанные;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Справка2");
	Если ТекДанные = Неопределено 
		ИЛИ НЕ ЗначениеЗаполнено(ТекДанные.Справка2) Тогда
		Форма.Элементы.питАкцизныеМарки.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПоиска);
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекДанные);
	Форма.Элементы.питАкцизныеМарки.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПоиска);
	
КонецПроцедуры

Процедура питПерераспределитьКоличествоПоЧастичномуВыбытию(Форма)
	
	ТекДанныеОсновнойСтроки = Форма.Элементы.Товары.ТекущиеДанные;
	Если ТекДанныеОсновнойСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	Если ЗначениеЗаполнено(ТекДанныеОсновнойСтроки.ИдентификаторСтроки) Тогда
		СтруктураПоиска.Вставить("ИдентификаторСтроки", ТекДанныеОсновнойСтроки.ИдентификаторСтроки);
	ИначеЕсли ЗначениеЗаполнено(ТекДанныеОсновнойСтроки.Справка2) Тогда
		СтруктураПоиска.Вставить("Справка2", ТекДанныеОсновнойСтроки.Справка2);
	КонецЕсли;
	МассивСтрокАкцизныхМарок = Форма.Объект.АкцизныеМарки.НайтиСтроки(СтруктураПоиска);
	
	НовоеКоличество = 0;
	Для Каждого ТекСтрокаМарок Из МассивСтрокАкцизныхМарок Цикл
		НовоеКоличество = ТекСтрокаМарок.ЧастичноеВыбытиеКоличество + НовоеКоличество;
	КонецЦикла;
	
	ТекДанныеОсновнойСтроки.Количество = НовоеКоличество;
	ТекДанныеОсновнойСтроки.КоличествоПродукцииПоАкцизнымМаркам = НовоеКоличество;

	МодульИнтеграцияЕГАИСКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияЕГАИСКлиентСервер");
	ПараметрыЗаполнения = МодульИнтеграцияЕГАИСКлиентСервер.ПараметрыЗаполненияТабличнойЧасти();
	ПараметрыЗаполнения.ПересчитатьКоличествоУпаковок = Истина;
	
	КэшированныеЗначения = Неопределено;
	МодульСобытияФормЕГАИСКлиентПереопределяемый = ОбщегоНазначенияКлиент.ОбщийМодуль("СобытияФормЕГАИСКлиентПереопределяемый");
	МодульСобытияФормЕГАИСКлиентПереопределяемый.ПриИзмененииКоличестваУпаковок(
		Форма, ТекДанныеОсновнойСтроки, КэшированныеЗначения,
		ПараметрыЗаполнения);
	
	РассчитатьКоличествоЕГАИС(ТекДанныеОсновнойСтроки);
	
КонецПроцедуры

Процедура РассчитатьКоличествоЕГАИС(ТекущаяСтрока)
	
	ТекущаяСтрока.КоличествоЕГАИС = ТекущаяСтрока.Количество * ТекущаяСтрока.КоэффициентЕГАИС;
	
КонецПроцедуры

#КонецОбласти

// Копия процедуры из документа ОтчетЕГАИС.ФормаСпискаДокументов
//
Процедура ОтчетЕГАИС_СоздатьЗапросОтчета(ВидДокумента)
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВидДокумента", ВидДокумента);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.ОтчетЕГАИС.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры


#КонецОбласти



