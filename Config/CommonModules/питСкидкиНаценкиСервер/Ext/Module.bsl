
#Область ПрограммныйИнтерфейс
// Процедура - Формирует из Чека Общепита - Чек ККМ, а затем рассчитывает бонусы механизмом скидок/наценок.
//
// Параметры:
//  СсылкаНаЧекОбщепита			 - ДокументСсылка.питДанныеПродажФронта - Ссылка на Чек Общепита.
//  ТЧНачислениеБонусныхБаллов	 - ТабличнаяЧасть - Табличная часть накопленных бонусов.
//
Процедура РассчитатьБонусыПоЧекуОбщепита(СсылкаНаЧекОбщепита, ТЧНачислениеБонусныхБаллов) Экспорт
	// Процедура основывается на процедуре Документы.ЧекККМ.ФормаДокументаРМК.ФормаНазначитьАвтоматическиеСкидкиЗавершение().
	
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Подготовим входные параметры.
	Если НЕ ЗначениеЗаполнено(СсылкаНаЧекОбщепита.ВалютаДокумента) Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Иначе
		Валюта = СсылкаНаЧекОбщепита.ВалютаДокумента;
	КонецЕсли;
	ВходныеПараметры = Новый Структура;
	ВходныеПараметры.Вставить("ТолькоПредварительныйРасчет", НЕ ЗначениеЗаполнено(Валюта)); // Валюта обязательна для расчета.
	ВходныеПараметры.Вставить("ПрименятьКОбъекту",Истина); // Значение должно быть Истина, чтобы рассчитанные типовым механизмом бонусные баллы перенеслись в косвенный объект.
	ВходныеПараметры.Вставить("ВосстанавливатьУправляемыеСкидки", Ложь);
	ВходныеПараметры.Вставить("УправляемыеСкидки", Неопределено); // Массив скидок необходимо оставить неизвестным, чтобы механизм сам заполнил актуальные. 

	
	// На основании чека Общепит сформируем Чек ККМ.
	ОбъектЧекаККМ = Документы.ЧекККМ.СоздатьДокумент();
	ОбъектЧекаККМ.Дата = СсылкаНаЧекОбщепита.Дата;
	ОбъектЧекаККМ.ВидЦены = СсылкаНаЧекОбщепита.ТипЦен;
	ОбъектЧекаККМ.Склад = Неопределено;
	ОбъектЧекаККМ.Партнер = Справочники.Партнеры.ПустаяСсылка();
	ОбъектЧекаККМ.ФормаОплаты = Неопределено;
	ОбъектЧекаККМ.КартаЛояльности = Справочники.КартыЛояльности.ПустаяСсылка();
	ОбъектЧекаККМ.Валюта = Валюта;
	
	// Перенесем ТЧ Товары.
	ТЧТоварыЧекаОбщепит = СсылкаНаЧекОбщепита.Товары;
	ТЧТоварыЧекаККМ = ОбъектЧекаККМ.Товары;
	Для Каждого ТекСтрока Из ТЧТоварыЧекаОбщепит Цикл
		НоваяСтрока = ТЧТоварыЧекаККМ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
	// Заполним таблицу бонусов чека ккм с помощью механизма ERP.
	СкидкиНаценкиСервер.Рассчитать(ОбъектЧекаККМ,ВходныеПараметры);
	
	// Обновим таблицу бонусов чека общепита.
	ТЧНачислениеБонусныхБаллов.Очистить();
	ТЧБонусныеБаллы = ОбъектЧекаККМ.БонусныеБаллы;
	Для Каждого ТекСтрока Из ТЧБонусныеБаллы Цикл
		НоваяСтрока = ТЧНачислениеБонусныхБаллов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
