// ПЕРЕОПРЕДЕЛЯЕМЫЕ ПРОЦЕДУРЫ, ВЫЗЫВАЕМЫЕ ИЗ ОБРАБОТЧИКОВ ТИПОВЫХ ФОРМ.

#Область ПрограммныйИнтерфейс

//  Процедура - Выполнить переопределяемую команду.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Команда - Произвольный - Команда.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	СписокКоманд = "питСписокПровести,питСписокОтменаПроведения,питСписокУстановитьПометкуУдаления,питОткрытьПланыМеню";
	МассивКоманд = СтрРазделить(СписокКоманд, ",");
	
	Если МассивКоманд.Найти(Команда.Имя) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Команда.Имя = "питОткрытьПланыМеню" Тогда
		ОткрытьФорму("Документ.питПланМеню.ФормаСписка");
	Иначе	
		ВыделенныеСтроки = Форма.Элементы.питСписок.ВыделенныеСтроки;
		Если НЕ ВыделенныеСтроки.Количество() Тогда
			Возврат;
		КонецЕсли;
		
		СсылкиНаДокументы = Новый Массив;
		Для каждого ТекСтрока Из ВыделенныеСтроки Цикл
			СсылкиНаДокументы.Добавить(ТекСтрока);
		КонецЦикла;
		
		питПланирование.ВыполнитьДействиеФормы(Команда.Имя, СсылкиНаДокументы);
		
		Форма.Элементы.питСписок.Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация
#Область СлужебныеПроцедурыИФункции
#КонецОбласти
#КонецОбласти



