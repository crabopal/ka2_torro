
#Область ПрограммныйИнтерфейс


// //////////////////////////////////////////////
//  StoreHouse HeadOffice
//
// Параметры:
//  ТаблицаЭлементов - ТаблицаЗначений - Таблица элементов.
//  ТипОбъекта - Произвольный - Тип объекта.
//  СтрокаНастроек - Строка - Строка настроек.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
Функция ДобавитьНедостающиеСтрокиСоответствия(ТаблицаЭлементов, ТипОбъекта, СтрокаНастроек = Неопределено) Экспорт
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовStoreHouse.СоздатьНаборЗаписей();
	
	Если ТипОбъекта = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Рецептура Тогда
		МетаданныеТипа = Метаданные.Документы.питРецептура;
	ИначеЕсли ТипОбъекта = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Контрагенты Тогда
		МетаданныеТипа = Метаданные.Справочники.Контрагенты;
	ИначеЕсли ТипОбъекта = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Номенклатура Тогда
		МетаданныеТипа = Метаданные.Справочники.Номенклатура;
	ИначеЕсли ТипОбъекта = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.СтруктураПредприятия Тогда
		МетаданныеТипа = Метаданные.Справочники.СтруктураПредприятия;
	ИначеЕсли ТипОбъекта = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.СкладыКомпании Тогда
		МетаданныеТипа = Метаданные.Справочники.Склады;
	Иначе
		ВызватьИсключение("Передан неизвестный тип значения при добавлении соответствий.");
	КонецЕсли;
	
	ТипПВХ = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.ПолучитьОбъектПоМетаданным(МетаданныеТипа.Имя);
	Если СтрокаНастроек = Неопределено Тогда
		СтрокаНастроек = ТипПВХ;
	КонецЕсли;
	
	Попытка
		ЭтоДокумент = Ложь;
		МенеджерДанных = Справочники[МетаданныеТипа.Имя];
	Исключение
		ЭтоДокумент = Истина;
		МенеджерДанных = Документы[МетаданныеТипа.Имя];
	КонецПопытки;
	
	ЕстьРодитель =  ТаблицаЭлементов.Колонки.Найти("Parent") <> Неопределено;
	
	НаборЗаписей.Отбор.ТипОбъекта.Значение = ТипОбъекта;
	НаборЗаписей.Отбор.ТипОбъекта.Использование = Истина;
	Для Каждого СтрокаЭлемента Из ТаблицаЭлементов Цикл
		СсылкаStoreHouse = СтрокаЭлемента.Sifr;
		
		НаборЗаписей.Отбор.СсылкаStoreHouse.Значение = Число(СсылкаStoreHouse);
		НаборЗаписей.Отбор.СсылкаStoreHouse.Использование = Истина;
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ТипОбъекта = ТипОбъекта;
			НоваяЗапись.СсылкаStoreHouse = Число(СсылкаStoreHouse);
			
			НоваяЗапись.ИмяStoreHouse = СтрокаЭлемента.NAME;
			НоваяЗапись.КодStoreHouse = СтрокаЭлемента.CODE;
			
			Если ЕстьРодитель Тогда
				НоваяЗапись.РодительStoreHouse = СтрокаЭлемента.Parent;
				Попытка
					НоваяЗапись.ИмяРодителяStoreHouse = СтрокаЭлемента.ParentName;
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			Если ЭтоДокумент Тогда
				НоваяЗапись.Ссылка1С = СтрокаЭлемента.Ссылка;
			Иначе
				НоваяЗапись.Ссылка1С = МенеджерДанных.ПустаяСсылка();
			КонецЕсли;
			
			Попытка
				НаборЗаписей.Записать(Истина);
			Исключение
			КонецПопытки;
		Иначе
			НоваяЗапись = НаборЗаписей[0];
			
			НоваяЗапись.ИмяStoreHouse = СтрокаЭлемента.NAME;
			НоваяЗапись.КодStoreHouse = СтрокаЭлемента.CODE;
			
			Если ЕстьРодитель Тогда
				НоваяЗапись.РодительStoreHouse = СтрокаЭлемента.Parent;
				Попытка
					НоваяЗапись.ИмяРодителяStoreHouse = СтрокаЭлемента.ParentName;
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если ЭтоДокумент Тогда
				НоваяЗапись.Ссылка1С = СтрокаЭлемента.Ссылка;
			Иначе
				НоваяЗапись.Ссылка1С = МенеджерДанных.ПустаяСсылка();
			КонецЕсли;
			Попытка
				НаборЗаписей.Записать(Истина);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
КонецФункции
// Установка соответствия для элементов
//
// Параметры:
//  Режим - Произвольный - Режим.
//  ИмяМетаданных - Произвольный - Имя метаданных.
//  ОтборСоответствий - Произвольный - Отбор соответствий.
//  ИспользоватьИерархию - Произвольный - Использовать иерархию.
//  ПроцентСовпаденияСоответствия - Произвольный - Процент совпадения соответствия.
//  СоздаватьОбъектыПриЗаполненииСоответствий - Произвольный - Создавать объекты при заполнении соответствий.
//  Ошибки - Произвольный - Ошибки.
//  ВидНоменклатуры - Произвольный - Вид номенклатуры.
//  ФорматОбмена - Произвольный - Формат обмена.
//  ЗагружатьИерархиюНоменклатуры - Произвольный - Загружать иерархию номенклатуры.
//  ВесовыеИОбъемные - Произвольный - Весовые и объемные.
//
Процедура ПроставитьСоответствияЭлементов(Режим, ИмяМетаданных, ОтборСоответствий, ИспользоватьИерархию = Ложь, ПроцентСовпаденияСоответствия = 75, СоздаватьОбъектыПриЗаполненииСоответствий = Ложь, Ошибки = Неопределено, ВидНоменклатуры , ФорматОбмена, ЗагружатьИерархиюНоменклатуры, ВесовыеИОбъемные) Экспорт
	
	// Попытаемся найти для справочника
	Попытка
		МетаданныеМенеджер = Справочники[ИмяМетаданных];
		ИмяМенеджера = "Справочник";
		МетаданныеОбъекта = Метаданные.Справочники[ИмяМетаданных];
	Исключение
		МетаданныеМенеджер = Документы[ИмяМетаданных];
		ИмяМенеджера = "Документ";
		МетаданныеОбъекта = Метаданные.Документы[ИмяМетаданных];
	КонецПопытки;
	
	Если ФорматОбмена = 1 Тогда
		ИмяИсточника = "питStoreHouse4";
	Иначе
		ИмяИсточника = "питStoreHouse";
	КонецЕсли;
	
	// Создадим набор записей с соответствующим отбором
	НаборЗаписей = РегистрыСведений.питСоответствияОбъектовStoreHouse.СоздатьНаборЗаписей();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияОбъектовStoreHouse.ТипОбъекта,
	               |	СоответствияОбъектовStoreHouse.СсылкаStoreHouse,
	               |	СоответствияОбъектовStoreHouse.Ссылка1С,
	               |	СоответствияОбъектовStoreHouse.ИмяStoreHouse,
	               |	СоответствияОбъектовStoreHouse.КодStoreHouse,
	               |	СоответствияОбъектовStoreHouse.ЭтоГруппа,
	               |	СоответствияОбъектовStoreHouse.ИмяРодителяStoreHouse
	               |ИЗ
	               |	РегистрСведений.питСоответствияОбъектовStoreHouse КАК СоответствияОбъектовStoreHouse";
	ТекстОтбора = "";
	Для Каждого СтрокаОтбора Из НаборЗаписей.Отбор Цикл
		ЭлементыОтбора = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ОтборСоответствий,СтрокаОтбора.Имя);
		Если ЭлементыОтбора.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЭлементОтбора = ЭлементыОтбора[0];
		
		ИспользованиеОтбора = ЭлементОтбора.Использование ;
		ЗначениеОтбора = ЭлементОтбора.ПравоеЗначение;
		Если ИспользованиеОтбора И ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			ТипСравнения = ПолучитьПредставлениеИнтервала( ЭлементОтбора.ВидСравнения);

			Запрос.УстановитьПараметр(СтрокаОтбора.Имя, ЗначениеОтбора);
			ТекстОтбора = ТекстОтбора + "И СоответствияОбъектовStoreHouse."+ СтрокаОтбора.Имя + " " + ТипСравнения.Представление + "(&"+ СтрокаОтбора.Имя + ")" +Символы.ПС;
		КонецЕсли;
					   
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + ?(ТекстОтбора = "","",Символы.ПС + "ГДЕ" + Символы.ПС + Сред(ТекстОтбора,2));
	Результат = Запрос.Выполнить();
	Если ИспользоватьИерархию Тогда
		ТЗСоответсвий = Результат.Выгрузить(); //Для поиска родителей
	КонецЕсли;
	ПерезаполнитьСоответствия = Ложь;
		
	Соответствие = Результат.Выбрать();
	
	
	// Составим запрос
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	"+ИмяМетаданных+".Ссылка
	   	|ИЗ
	   	|	"+ИмяМенеджера+"."+ИмяМетаданных+" КАК "+ИмяМетаданных+"
	   	|ГДЕ
		|";
		
	Если ИмяМенеджера = "Справочник" И МетаданныеОбъекта.Иерархический И МетаданныеОбъекта.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		ТекстЗапроса = ТекстЗапроса + ИмяМетаданных+".ЭтоГруппа = &ЭтоГруппа И
		|";
	КонецЕсли;
	Если ИмяМенеджера = "Справочник" Тогда
		ТекстЗапроса = ТекстЗапроса + "НЕ "+ ИмяМетаданных+".ПометкаУдаления И
		|";
	КонецЕсли;
	// Загрузим группы
	Если ИмяМетаданных = "Номенклатура" И СоздаватьОбъектыПриЗаполненииСоответствий И ЗагружатьИерархиюНоменклатуры Тогда
		// получим таблицу групп
		ДопПоля = Новый СписокЗначений;
		ДопПоля.Добавить("PARENT_REF", "PARENT");
		ТаблицаГрупп = питStoreHouse.ПолучитьБазовыеПоляТаблицы("GOODSTREE", ДопПоля,,ФорматОбмена);
		ТаблицаГрупп.Колонки.Добавить("Обработана", Новый ОписаниеТипов("Булево"));
		Массив = Новый Массив();
		Массив.Добавить(Тип("СправочникСсылка.Номенклатура"));
		ОписаниеТиповСсылка = Новый ОписаниеТипов(Массив,,,); 
		ТаблицаГрупп.Колонки.Добавить("СсылкаГруппы", ОписаниеТиповСсылка);
		Для Каждого СтрГруппа ИЗ ТаблицаГрупп Цикл
			Если НЕ СтрГруппа.Обработана Тогда
				СоздатьРодителяНоменклатуры(СтрГруппа.Name, ТаблицаГрупп);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Пока Соответствие.Следующий() Цикл
		// Состояние(Соответствие.СсылкаStoreHouse);
		// ОбработкаПрерыванияПользователя();
		
		РодительЭлемента = Неопределено;
		Если ИспользоватьИерархию И НЕ ПустаяСтрока(Соответствие.ИмяРодителяStoreHouse) Тогда
			СтрокаРодителя = ТЗСоответсвий.Найти(Соответствие.ИмяРодителяStoreHouse, "ИмяStoreHouse");
			Если СтрокаРодителя = Неопределено Тогда
				РодительЭлемента = МетаданныеМенеджер.ПустаяСсылка();
			Иначе
				РодительЭлемента = Справочники[ИмяМетаданных].НайтиПоНаименованию(Соответствие.ИмяРодителяStoreHouse, Истина);
				Если РодительЭлемента = МетаданныеМенеджер.ПустаяСсылка() И СоздаватьОбъектыПриЗаполненииСоответствий Тогда
					ОбъектЭлемент = Справочники[ИмяМетаданных].СоздатьЭлемент(); //Создадим пустышку которая в последствии будет найдена и заполнена
					ОбъектЭлемент.Наименование = Соответствие.ИмяРодителяStoreHouse;
					ОбъектЭлемент.УстановитьНовыйКод("SH");
					ОбъектЭлемент.ОбменДанными.Загрузка = Истина;
					// Найдем и установим родителя если такой есть
					Бабушка = ТЗСоответсвий.Найти(СтрокаРодителя.ИмяРодителяStoreHouse, "ИмяStoreHouse");
					Если Бабушка <> Неопределено Тогда
						Бабушка = Справочники[ИмяМетаданных].НайтиПоНаименованию(СтрокаРодителя.ИмяРодителяStoreHouse, Истина);
						Если Бабушка = МетаданныеМенеджер.ПустаяСсылка() Тогда
							ОбъектРодитель = Справочники[ИмяМетаданных].СоздатьЭлемент();
							ОбъектРодитель.Наименование = Соответствие.ИмяРодителяStoreHouse;
							ОбъектРодитель.УстановитьНовыйКод("SH");
							ОбъектРодитель.ОбменДанными.Загрузка = Истина;
							ОбъектРодитель.Записать();
							Бабушка = ОбъектРодитель.Ссылка;
						КонецЕсли;
						ОбъектЭлемент.Родитель = Бабушка;
					КонецЕсли;
					ОбъектЭлемент.Записать();
					РодительЭлемента = ОбъектЭлемент.Ссылка;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		УсловиеЗапроса = "";
		Если Режим = 1 Тогда
			Если ИмяМенеджера = "Справочник" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Наименование = &Наименование";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Ссылка = &Наименование";
			КонецЕсли;
			Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
			Если МетаданныеОбъекта.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
				Запрос.УстановитьПараметр("ЭтоГруппа", Соответствие.ЭтоГруппа);
			КонецЕсли;
			Если ИмяМенеджера = "Справочник" Тогда
				Запрос.УстановитьПараметр("Наименование", Соответствие.ИмяStoreHouse);
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				СоответствиеПеречисления = НайтиПоСинонимуЗначениеПеречисления(ИмяМетаданных,Соответствие.ИмяStoreHouse);
				Запрос.УстановитьПараметр("Наименование", СоответствиеПеречисления);
			КонецЕсли;
			
			Если РодительЭлемента <> Неопределено Тогда
				Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
			КонецЕсли;
			
		ИначеЕсли Режим = 2 Тогда
			НечеткоеНаименование = ВыполнитьНечеткийПоиск(Соответствие.ИмяStoreHouse, МетаданныеОбъекта, ПроцентСовпаденияСоответствия);
			Если ИмяМенеджера = "Справочник" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Наименование ПОДОБНО &Наименование";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Ссылка = &Наименование";
			КонецЕсли;
			
			Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
			Запрос.УстановитьПараметр("ЭтоГруппа", Соответствие.ЭтоГруппа);
			Если ИмяМенеджера = "Справочник" Тогда
				Запрос.УстановитьПараметр("Наименование", ?(НечеткоеНаименование = "",Соответствие.ИмяStoreHouse + "%",НечеткоеНаименование));
			ИначеЕсли ИмяМенеджера = "Перечисление" Тогда
				СоответствиеПеречисления = НайтиПоСинонимуЗначениеПеречисления(ИмяМетаданных,?(НечеткоеНаименование = "",Соответствие.ИмяStoreHouse,НечеткоеНаименование), Ложь);
				Запрос.УстановитьПараметр("Наименование", СоответствиеПеречисления);
			КонецЕсли;
			
			Если РодительЭлемента <> Неопределено Тогда
				Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
			КонецЕсли;
			
		ИначеЕсли Режим = 3 Тогда
			УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Код = &Код";
			Если РодительЭлемента <> Неопределено Тогда
				УсловиеЗапроса = УсловиеЗапроса + "
				|И "+ИмяМетаданных+".Родитель = &Родитель";
			КонецЕсли;
			Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
			Запрос.УстановитьПараметр("ЭтоГруппа", Соответствие.ЭтоГруппа);
			Запрос.УстановитьПараметр("Код", Число(Соответствие.СсылкаStoreHouse));
			Если РодительЭлемента <> Неопределено Тогда
				Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
			КонецЕсли;
		Иначе
			// по совпадению кода R-keeper и кода 1C
			
			Если Соответствие.ЭтоГруппа Тогда
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Наименование = &Наименование";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
				Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
				
				Запрос.УстановитьПараметр("ЭтоГруппа", Истина);
				Запрос.УстановитьПараметр("Наименование", Соответствие.ИмяStoreHouse);
				Если РодительЭлемента <> Неопределено Тогда
					Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
				КонецЕсли;
			Иначе
				УсловиеЗапроса = УсловиеЗапроса + ИмяМетаданных+".Код = &Код";
				Если РодительЭлемента <> Неопределено Тогда
					УсловиеЗапроса = УсловиеЗапроса + "
					|И "+ИмяМетаданных+".Родитель = &Родитель";
				КонецЕсли;
				Запрос = Новый Запрос(ТекстЗапроса + УсловиеЗапроса);
				Запрос.УстановитьПараметр("ЭтоГруппа", Ложь);
				Запрос.УстановитьПараметр("Код", Строка(Соответствие.КодStoreHouse));
				Если РодительЭлемента <> Неопределено Тогда
					Запрос.УстановитьПараметр("Родитель", РодительЭлемента);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		СсылкаСоответствия = Неопределено;
		Если Выборка.Следующий() Тогда
			СсылкаСоответствия = Выборка.Ссылка;
		ИначеЕсли СоздаватьОбъектыПриЗаполненииСоответствий И ИмяМенеджера = "Справочник" Тогда
			СсылкаСоответствия = Обработки.питЗагрузкаStoreHouse.СоздатьОбъектСоответствия(Соответствие, ИмяМетаданных, РодительЭлемента, ВидНоменклатуры, ИмяИсточника, ВесовыеИОбъемные);
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(СсылкаСоответствия) Тогда
			НаборЗаписей.Отбор.СсылкаStoreHouse.Установить(Соответствие.СсылкаStoreHouse);
			НаборЗаписей.Отбор.ТипОбъекта.Установить(Соответствие.ТипОбъекта);
			
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				ЗаписьНабора = НаборЗаписей[0];
				ЗаписьНабора.Ссылка1С = СсылкаСоответствия;
				Попытка
					НаборЗаписей.Записать();
				Исключение
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,,"Не удалось установить соответствия для "+МетаданныеМенеджер+"");
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


// Возвращает текстовый параметр для запроса по переданному виду сравнения.
//
// Параметры:
//  Сравнение - ВидСравнения - Вид сравнения, для которого получается представлени.
//
// Возвращаемое значение:
// 	Структура - Текстовое описание сравнения
Функция ПолучитьПредставлениеИнтервала(Сравнение) Экспорт
	Результат = Новый Структура("Тип, Представление");
	Если      Сравнение         = ВидСравненияКомпоновкиДанных.Больше Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " > ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " >=";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Меньше Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " < ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " <=";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеРавно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " <> ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Равно Тогда
		Результат.Тип           = "Простое";
		Результат.Представление = " = ";
	// ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Интервал Тогда
	// 	Результат.Тип           = "Интервал";
	// 	Результат.Представление = " >   <  ";
	// ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ИнтервалВключаяГраницы Тогда
	// 	Результат.Тип           = "ИнтервалОбе";
	// 	Результат.Представление = " МЕЖДУ ";
	// ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ИнтервалВключаяНачало Тогда
	// 	Результат.Тип           = "ИнтервалНачало";
	// 	Результат.Представление = " >=  <  ";
	// ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ИнтервалВключаяОкончание Тогда
	// 	Результат.Тип           = "ИнтервалОкончание";
	// 	Результат.Представление = " >   <= ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.Содержит Тогда
		Результат.Тип           = "Содержит";
		Результат.Представление = " ПОДОБНО ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
		Результат.Тип           = "Содержит";
		Результат.Представление = " НЕ ПОДОБНО ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ВСписке Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " В ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " НЕ В ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ВИерархии Тогда    
		Результат.Тип           = "Список";
		Результат.Представление = " В ИЕРАРХИИ ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда    
		Результат.Тип           = "Список";
		Результат.Представление = " НЕ В ИЕРАРХИИ ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " В ИЕРАРХИИ ";
	ИначеЕсли Сравнение         = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
		Результат.Тип           = "Список";
		Результат.Представление = " НЕ В ИЕРАРХИИ ";

	Иначе
		Возврат Неопределено
	КонецЕсли;

	Возврат Результат;
КонецФункции // обПолучитьПредставлениеИнтервала()

// Используется для полнотекстового поиска строки в одном объекте метаданных
//  Используется не только в R-кипере!
//
// Параметры:
//  НаименованиеStoreHouse - Произвольный - Наименование store house.
//  МетаданныеОбъекта - Произвольный - Метаданные объекта.
//  ПроцентСовпаденияСоответствия - Произвольный - Процент совпадения соответствия.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВыполнитьНечеткийПоиск(НаименованиеStoreHouse, МетаданныеОбъекта, ПроцентСовпаденияСоответствия) Экспорт
	МассивПоиска = Новый Массив;
	МассивПоиска.Добавить(МетаданныеОбъекта);
	
	СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(НаименованиеStoreHouse, 10); // первый параметр строка поиска, второй размер списка
	СписокПоиска.ОбластьПоиска = МассивПоиска;
	СписокПоиска.ПолучатьОписание = Ложь;
	
	ПоказыватьОписания = Истина;
	СписокПоиска.ПорогНечеткости = 100 - ПроцентСовпаденияСоответствия; //процент нечеткости для слова из 4 букв, одна может быть неправильной
	
	
	СписокПоиска.СтрокаПоиска = НаименованиеStoreHouse;
	СписокПоиска.РазмерПорции = 1;
	
	Попытка
		СписокПоиска.ПерваяЧасть();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для наименования <"+НаименованиеStoreHouse+"> найдено слишком много результатов! Увеличьте процент схожести для получения результата.");
	КонецПопытки;
	Если СписокПоиска.ПолноеКоличество() <> 0 Тогда
		Возврат СписокПоиска[0].Представление;
	Иначе
		Если СписокПоиска.СлишкомМногоРезультатов() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для наименования <"+НаименованиеStoreHouse+"> найдено слишком много результатов!");
		КонецЕсли;
		Возврат "";
	КонецЕсли;
КонецФункции

// Функция - Получить базовые поля таблицы.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//  МассивДопПолей - Массив - Массив доп полей.
//  СтрокаДопУсловий - Строка - Строка доп условий.
//  ФорматОбмена - Число - Формат обмена.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьБазовыеПоляТаблицы(ИмяТаблицы, МассивДопПолей = Неопределено, СтрокаДопУсловий = Неопределено, ФорматОбмена = 0) Экспорт
	Если Лев(ИмяТаблицы,4) <> "dbo_" Тогда
		ИмяТаблицы = "dbo_" + ИмяТаблицы;
	КонецЕсли;
	
	Если ФорматОбмена = 1 Тогда
		ИсточникДанных= ВнешниеИсточникиДанных.питStoreHouse4;
		ИмяИсточника = "питStoreHouse4";
	Иначе
		ИмяИсточника = "питStoreHouse";
		ИсточникДанных = ВнешниеИсточникиДанных.питStoreHouse;
	КонецЕсли;
	
	Если ИсточникДанных.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Отключен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Отсутствует подключение к базе данных StoreHouse HeadOffice.");
	КонецЕсли;
	
	// Формируем доп поля
	ТекстДопПоля = "";
	Если ТипЗнч(МассивДопПолей) = Тип("СписокЗначений") Тогда
		Для Каждого ПолеМассива Из МассивДопПолей Цикл
			ТекстДопПоля = ТекстДопПоля + ИмяТаблицы + "." + ПолеМассива.Значение + " AS "+ПолеМассива.Представление+"," + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	%ТекстДопПоля%
	|	%ИмяТаблицы%.RID AS CODE,
	|	%ИмяТаблицы%.RID AS SIFR,
	|	%ИмяТаблицы%.NAME
	|ИЗ
	|	ВнешнийИсточникДанных.%ИмяИсточника%.Таблица.%ИмяТаблицы% КАК %ИмяТаблицы%
	|	%СтрокаДопУсловий%";
	// Заполним параметры.
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%ТекстДопПоля%",ТекстДопПоля);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%ИмяТаблицы%",ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%СтрокаДопУсловий%",?(СтрокаДопУсловий<>Неопределено, СтрокаДопУсловий, ""));
	
	// Сохраним значение текста запроса без источника, чтобы сделать попытку воспользоваться другим форматом.
	ТекстЗапросаБезИсточника = ТекстЗапроса;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%ИмяИсточника%",ИмяИсточника);
	Запрос.Текст = ТекстЗапроса;
	Попытка
		ТаблицаВыгрузки = Запрос.Выполнить().Выгрузить();
	Исключение
		// Поменяем значение текущего источника и повторим запрос.
		Если ФорматОбмена = 1 Тогда
			ИмяФорматаОбмена = "старый";
			ИмяИсточника = "питStoreHouse";
		Иначе
			ИмяФорматаОбмена = "новый";
			ИмяИсточника = "питStoreHouse4";
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(ТекстЗапросаБезИсточника,"%ИмяИсточника%", ИмяИсточника);
		ТекстОшибки = НСтр("ru = 'Ошибка получения данных.'");
		Попытка
			РезультатЗапроса = Запрос.Выполнить();
			ТекстОшибки = ТекстОшибки + " Используйте " + ИмяФорматаОбмена +" формат обмена.";
		Исключение
			// Значит ошибка не связана с форматом обмена.
			РезультатЗапроса = Неопределено;
		КонецПопытки;
		
		// Сообщим пользователю информацию об ошибке.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ЗаписьЖурналаРегистрации("Загрузка из StoreHouse HeadOffice",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки + Символы.ПС + ОписаниеОшибки());
		
		ТаблицаВыгрузки = Новый ТаблицаЗначений;
		ТаблицаВыгрузки.Колонки.Добавить("SIFR");
		ТаблицаВыгрузки.Колонки.Добавить("CODE");
		ТаблицаВыгрузки.Колонки.Добавить("NAME");
		Если ТипЗнч(МассивДопПолей) = Тип("СписокЗначений") Тогда
			Для Каждого ПолеМассива Из МассивДопПолей Цикл
				ТаблицаВыгрузки.Колонки.Добавить(ПолеМассива.Представление);
			КонецЦикла;
		КонецЕсли
	КонецПопытки;
	
	Возврат ТаблицаВыгрузки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Создать родителя номенклатуры.
//
// Параметры:
//  НаименованиеРодителя - Произвольный - Наименование родителя.
//  ТаблицаГрупп - ТаблицаЗначений - Таблица групп.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьРодителяНоменклатуры(НаименованиеРодителя, ТаблицаГрупп)
	Если ПустаяСтрока(НаименованиеРодителя) Тогда
		Если ЗначениеЗаполнено(ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Номенклатура.СлужебныйКаталог) Тогда
			Возврат ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Номенклатура.СлужебныйКаталог;
		Иначе
			Возврат Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	СтрокаГруппы = ТаблицаГрупп.Найти(НаименованиеРодителя,"NAME");
	Если СтрокаГруппы.Обработана Тогда
		Возврат СтрокаГруппы.СсылкаГруппы;
	КонецЕсли;
	СсылкаРодителя = Обработки.питЗагрузкаStoreHouse.НайтиГруппуПоНаименованию(НаименованиеРодителя);
	Если СсылкаРодителя = Справочники.Номенклатура.ПустаяСсылка() Тогда
		// Создаем новую группу
		ОбъектРодитель = Справочники.Номенклатура.СоздатьГруппу();
		ОбъектРодитель.Наименование = НаименованиеРодителя;
		// Ищем строку родителя
		Попытка
			СтрокаГруппыПоКоду = ТаблицаГрупп.Найти(Число(СокрЛП(СтрокаГруппы.PARENT)),"CODE");
		Исключение СтрокаГруппыПоКоду = Неопределено КонецПопытки;
		Если СтрокаГруппыПоКоду<>Неопределено Тогда
			ОбъектРодитель.Родитель = СоздатьРодителяНоменклатуры(СтрокаГруппыПоКоду.Name, ТаблицаГрупп);
		ИначеЕсли ЗначениеЗаполнено(ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Номенклатура.СлужебныйКаталог) Тогда
			ОбъектРодитель.Родитель = ПланыВидовХарактеристик.питТипыОбъектовStoreHouse.Номенклатура.СлужебныйКаталог;
		КонецЕсли;
		ОбъектРодитель.ОбменДанными.Загрузка = Истина;
		ОбъектРодитель.Записать();
		СсылкаРодителя = ОбъектРодитель.Ссылка;
	КонецЕсли;
	СтрокаГруппы.Обработана = Истина;
	СтрокаГруппы.СсылкаГруппы = СсылкаРодителя;
	Возврат СсылкаРодителя;
КонецФункции

// Функция - Найти по синониму значение перечисления.
//
// Параметры:
//  ИмяПеречисления - Произвольный - Имя перечисления.
//  ИмяСинонима - Произвольный - Имя синонима.
//  ТочноеСоответствие - Соответствие - Точное соответствие.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиПоСинонимуЗначениеПеречисления(ИмяПеречисления, ИмяСинонима, ТочноеСоответствие = Истина)
	РезультФункции = Перечисления[ИмяПеречисления].ПустаяСсылка();
	
	КоллекцияЗначенийПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления;
	Для каждого ЗначПерем из КоллекцияЗначенийПеречисления Цикл
		Если ТочноеСоответствие Тогда
			ЗначениеНайдено = СокрЛП(СтрЗаменить(ИмяСинонима, " ", "")) = СокрЛП(СтрЗаменить(ЗначПерем.Синоним, " ", ""));
		Иначе
			ЗначениеНайдено = Найти(СокрЛП(СтрЗаменить(ИмяСинонима, " ", "")), СокрЛП(СтрЗаменить(ЗначПерем.Синоним, " ", ""))) <> 0 ИЛИ
			Найти(СокрЛП(СтрЗаменить(ЗначПерем.Синоним, " ", "")), СокрЛП(СтрЗаменить(ИмяСинонима, " ", ""))) <> 0
		КонецЕсли;
		
		Если ЗначениеНайдено Тогда
			РезультФункции = Перечисления[ИмяПеречисления][ЗначПерем.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультФункции;
КонецФункции

