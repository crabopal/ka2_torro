
#Область ПрограммныйИнтерфейс

// Процедура открывает форму со структурой учетных документов ERP, связанных с документом Общепит.
//
// Параметры:
//  СсылкаНаОбъект - Произвольный - Ссылка на объект.
//  ПараметрыВыполнения - Произвольный - Параметры выполнения.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция ПоказатьСтруктуруУчетныхДокументов(СсылкаНаОбъект, ПараметрыВыполнения) Экспорт
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		
		ИмяРегистра = "питТиповыеДокументы";
		Если ПараметрыВыполнения.Свойство("ОписаниеКоманды") 
			И ПараметрыВыполнения.ОписаниеКоманды.Свойство("ДополнительныеПараметры")
			И ПараметрыВыполнения.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ИмяРегистра") Тогда
			ИмяРегистра = ПараметрыВыполнения.ОписаниеКоманды.ДополнительныеПараметры.ИмяРегистра;
		КонецЕсли;
		
		ОткрытьФорму("ОбщаяФорма.питСтруктураУчетныхДокументов",Новый Структура("ОбъектОтбора, ИмяРегистра", СсылкаНаОбъект, ИмяРегистра),
			ПараметрыВыполнения.Источник,
			Новый УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти




