#Область ПрограммныйИнтерфейс

// %ИзЕРП% Необходимо отслеживать типовые изменения и актуализировать данные функции
#Область СправочникСпособыОбеспеченияПотребностейФормаФормаЭлемента

// Активизация страниц с настройками для типа обеспечения ""Производство"".
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ТипОбеспечения - Произвольный - Тип обеспечения.
//  ФормироватьПлановыеЗаказы - Произвольный - Формировать плановые заказы.
//  ОдинИсточник - Произвольный - Один источник.
//
Процедура АктивизироватьСтраницы(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	ТипОбеспечения = Форма.Объект.ТипОбеспечения;
	
	Элементы.Соглашение.Видимость = Ложь;
	Элементы.ВидЦеныПоставщика.Видимость = Ложь;
	Элементы.СтраницаОрганизацияПоСоглашению.Видимость = Ложь;
	
	Элементы.Подразделение.Видимость = Истина;
	Элементы.СтраницыТипОбеспечения.Видимость = Истина;
	Элементы.СтраницыСрокОбеспечения.Видимость = Истина;
	
	Если ТипОбеспечения = ПредопределенноеЗначение("Перечисление.ТипыОбеспечения.питПроизводство") Тогда
		
		Элементы.СтраницыРежимИспользования.Видимость = Ложь;
		Элементы.Подразделение.Видимость = Ложь;
		
		Элементы.СтраницыТипОбеспечения.ТекущаяСтраница  = Элементы.питСтраницаПроизводство;
		Элементы.СтраницыСрокОбеспечения.ТекущаяСтраница = Элементы.СтраницаСрокПроизводства;
		
	ИначеЕсли ТипОбеспечения = ПредопределенноеЗначение("Перечисление.ТипыОбеспечения.питПеремещениеВНоменклатуруПроизводства") Тогда
		
		Элементы.СтраницыРежимИспользования.Видимость = Истина;
		
		Элементы.СтраницыРежимИспользования.ТекущаяСтраница = Элементы.СтраницаРежимИспользованияПеремещение;
		Элементы.СтраницыТипОбеспечения.ТекущаяСтраница     = Элементы.СтраницаПеремещение;
		Элементы.СтраницыСрокОбеспечения.ТекущаяСтраница    = Элементы.СтраницаСрокПеремещения;
		
	КонецЕсли;
	
КонецПроцедуры

// Формирование заголовка надписей для типа обеспечения ""Производство"".
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
Процедура СформироватьЗаголовкиПоясняющихНадписей(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	
	ПояснениеТипаОбеспечения = "";
	
	Если Форма.Объект.ТипОбеспечения = ПредопределенноеЗначение("Перечисление.ТипыОбеспечения.питПроизводство") Тогда
		Элементы.СтраницыРасчетЦиклаОбеспечения.ТекущаяСтраница = Элементы.питСтраницаРасчетПроизводствоОбщепита;
		ПояснениеТипаОбеспечения = НСтр("ru = 'Данный способ обеспечения позволяет формировать планы-меню через специальное рабочее место ""Формирование планов-меню по потребностям"".'");
	ИначеЕсли Форма.Объект.ТипОбеспечения = ПредопределенноеЗначение("Перечисление.ТипыОбеспечения.питПеремещениеВНоменклатуруПроизводства") Тогда
		Элементы.СтраницыРасчетЦиклаОбеспечения.ТекущаяСтраница = Элементы.питСтраницаРасчетПеремещениеВНоменклатуруПроизводства;
		ПояснениеТипаОбеспечения = НСтр("ru = 'Данный способ обеспечения позволяет формировать заказы на перемещение в номенклатуру производства.'");
	КонецЕсли;
	
	Форма.Элементы.ПояснениеТипОбеспечения.Заголовок = ПояснениеТипаОбеспечения;
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Способы обеспечения потребностей управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
Процедура СпособыОбеспеченияПотребностейУправлениеФормой(Форма) Экспорт
	
	Если ЗначениеЗаполнено(Форма.Объект.ИсточникОбеспеченияПотребностей) Тогда
		Форма.Элементы.питСкладМатериалов.Доступность = Истина;
	Иначе
		Форма.Элементы.питСкладМатериалов.Доступность = Ложь;
		Форма.Объект.питСкладМатериалов = Неопределено;
	КонецЕсли;
	
	Форма.питПодразделениеПред		= Форма.Объект.Подразделение;
	Форма.питЦеховаяКладоваяПред	= Форма.Объект.ИсточникОбеспеченияПотребностей;
	
КонецПроцедуры

#КонецОбласти
