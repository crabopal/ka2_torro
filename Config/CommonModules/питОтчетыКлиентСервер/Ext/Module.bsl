#Область ВыполнениеКомандПечати

// Функция получает массив идентификаторов печатных форм с изменяемым источником для суммовой оценки
// 
// Возвращаемое значение:
//  Массив - Массив идентификаторов ПФ.
//
Функция ПолучитьМассивИдентификаторовКомандПечатныхФормСВычисляемойСебестоимостью() Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить("питОП1");
	Массив.Добавить("питОП1_ТБ");
	Массив.Добавить("питОП1_СПараметрами");
	Массив.Добавить("питОП1_ТБ_СПараметрами");
	Массив.Добавить("питОП10");
	Массив.Добавить("питОП12");
	Массив.Добавить("питОП21");
	Массив.Добавить("питТОРГ16");
	Массив.Добавить("питОП23");
	Возврат Массив;
	
КонецФункции

