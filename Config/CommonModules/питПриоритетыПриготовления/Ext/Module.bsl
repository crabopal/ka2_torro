#Область ПрограммныйИнтерфейс

// Функция возвращает приоритет приготовления блюда.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура, которую готовим.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - Характеристика номенклатуры, которую готовим.
//  Склад - СправочникСсылка.Склады - Склад, для которого вычисляем приоритет.
//
// Возвращаемое значение:
//  Число - Найденное значение приоритета.
Функция ПриоритетПриготовленияБлюда(Номенклатура, Характеристика = Неопределено, Склад = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Значение по умолчанию.
	Приоритет = 999999;
	
	Если НЕ питПриоритетыПриготовленияПовтИсп.ИспользоватьПриоритетыПриготовления() Тогда
		Возврат Приоритет;
	КонецЕсли;
	
	ПустаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	ПустойСклад= Справочники.Склады.ПустаяСсылка();
	
	// Ищем как по переданному значению так и по пустому (если по переданному ничего не нашли).
	Характеристики = Новый Массив;
	Характеристики.Добавить(ПустаяХарактеристика);
	Если НЕ Характеристика = Неопределено Тогда
		Характеристики.Добавить(Характеристика);
	КонецЕсли;
	Склады = Новый Массив;
	Склады.Добавить(ПустойСклад);
	Если НЕ Склад = Неопределено Тогда
		Склады.Добавить(Склад);
	КонецЕсли;
	
	// Основной запрос.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питПриоритетыПриготовления.Приоритет КАК Приоритет,
	|	ВЫБОР
	|		КОГДА питПриоритетыПриготовления.Характеристика = &ПустаяХарактеристика
	|				И питПриоритетыПриготовления.Склад = &ПустойСклад
	|			ТОГДА 0
	|		КОГДА питПриоритетыПриготовления.Характеристика <> &ПустаяХарактеристика
	|				И питПриоритетыПриготовления.Склад = &ПустойСклад
	|			ТОГДА 1
	|		КОГДА питПриоритетыПриготовления.Характеристика = &ПустаяХарактеристика
	|				И питПриоритетыПриготовления.Склад <> &ПустойСклад
	|			ТОГДА 2
	|		КОГДА питПриоритетыПриготовления.Характеристика <> &ПустаяХарактеристика
	|				И питПриоритетыПриготовления.Склад <> &ПустойСклад
	|			ТОГДА 3
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПолеСортировки
	|ИЗ
	|	РегистрСведений.питПриоритетыПриготовления КАК питПриоритетыПриготовления
	|ГДЕ
	|	питПриоритетыПриготовления.Номенклатура = &Номенклатура
	|	И питПриоритетыПриготовления.Характеристика В(&Характеристики)
	|	И питПриоритетыПриготовления.Склад В(&Склады)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолеСортировки УБЫВ";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Запрос.УстановитьПараметр("ПустойСклад", ПустойСклад);
	Запрос.УстановитьПараметр("ПустаяХарактеристика", ПустаяХарактеристика);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Приоритет = ВыборкаДетальныеЗаписи.Приоритет;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Приоритет;
	
КонецФункции

// Функция выполняет сортировку переданной таблицы по приоритету приготовления.
//
// Параметры:
//  ТаблицаТоваров - ТаблицаЗначений - Знач таблица товаров.
//  КолонкаСклад - Строка, СправочникСсылка.Склады - Имя колонки склад или ссылка на склад, для которого
//   вычисляется приоритет.
//  КолонкаДата - Дата - Колонка дата.
//  ДобавлятьКолонкиСортировки - Булево - Добавлять ли в результирующую отсортированную таблицу колонки, по которы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Отсортированная по приоритету приготовления входная таблица
Функция СортироватьТаблицуПоПриоритетуПриготовления(Знач ТаблицаТоваров, КолонкаСклад = "питСкладСортировка", КолонкаДата = "питДата", ДобавлятьКолонкиСортировки = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ питПриоритетыПриготовленияПовтИсп.ИспользоватьПриоритетыПриготовления() Тогда
		Если ДобавлятьКолонкиСортировки Тогда
			ДобавитьКолонкиСортировкиВТаблицу(ТаблицаТоваров);
		КонецЕсли;
		Возврат ТаблицаТоваров;
	КонецЕсли;
	
	ЕстьКолонкаХарактеристика = ТаблицаТоваров.Колонки.Найти("Характеристика") <> Неопределено;
	ЕстьКолонкаСклад = ТаблицаТоваров.Колонки.Найти("питСкладСортировка") <> Неопределено;
	ЕстьКолонкаДата = ТаблицаТоваров.Колонки.Найти("питДата") <> Неопределено;
	
	// Если вдруг нет характеристики или склада то добавляем для корректной работы запроса.
	Если НЕ ЕстьКолонкаХарактеристика Тогда
		ТаблицаТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КонецЕсли;
	Если НЕ ЕстьКолонкаСклад Тогда
		ТаблицаТоваров.Колонки.Добавить("питСкладСортировка", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		Если ТипЗнч(КолонкаСклад) = Тип("Строка") И КолонкаСклад <> "питСкладСортировка" Тогда
			Для каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
				ТекСтрокаТоваров.питСкладСортировка = ТекСтрокаТоваров[КолонкаСклад];
			КонецЦикла;
		ИначеЕсли ТипЗнч(КолонкаСклад) = Тип("СправочникСсылка.Склады") Тогда
			Для каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
				ТекСтрокаТоваров.питСкладСортировка = КолонкаСклад;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЕстьКолонкаДата Тогда
		ТаблицаТоваров.Колонки.Добавить("питДата", Новый ОписаниеТипов("Дата"));
		Если ТипЗнч(КолонкаДата) = Тип("Строка") И КолонкаДата <> "питДата" Тогда
			Для каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
				ТекСтрокаТоваров.питДата = ТекСтрокаТоваров[КолонкаДата];
			КонецЦикла;
		ИначеЕсли ТипЗнч(КолонкаДата) = Тип("Дата") Тогда
			Для каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
				ТекСтрокаТоваров.питДата = КолонкаДата;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.питСкладСортировка КАК питСкладСортировка,
	|	втТовары.питДата КАК питДата
	|ПОМЕСТИТЬ втТоварыНеСгруппированная
	|ИЗ
	|	&втТовары КАК втТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыНеСгруппированная.Номенклатура КАК Номенклатура,
	|	втТоварыНеСгруппированная.Характеристика КАК Характеристика,
	|	втТоварыНеСгруппированная.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыНеСгруппированная.питДата КАК питДата
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	втТоварыНеСгруппированная КАК втТоварыНеСгруппированная
	|
	|СГРУППИРОВАТЬ ПО
	|	втТоварыНеСгруппированная.Номенклатура,
	|	втТоварыНеСгруппированная.Характеристика,
	|	втТоварыНеСгруппированная.питСкладСортировка,
	|	втТоварыНеСгруппированная.питДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питПриоритетыПриготовления.Номенклатура КАК Номенклатура,
	|	питПриоритетыПриготовления.Характеристика КАК Характеристика,
	|	питПриоритетыПриготовления.Склад КАК Склад,
	|	питПриоритетыПриготовления.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ втПриоритеты
	|ИЗ
	|	РегистрСведений.питПриоритетыПриготовления КАК питПриоритетыПриготовления
	|ГДЕ
	|	(питПриоритетыПриготовления.Номенклатура, питПриоритетыПриготовления.Характеристика, питПриоритетыПриготовления.Склад) В
	|			(ВЫБРАТЬ
	|				втТовары.Номенклатура,
	|				втТовары.Характеристика,
	|				втТовары.питСкладСортировка КАК Склад
	|			ИЗ
	|				втТовары КАК втТовары
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТовары.Номенклатура,
	|				&ПустаяХарактеристика,
	|				&ПустойСклад
	|			ИЗ
	|				втТовары КАК втТовары
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТовары.Номенклатура,
	|				&ПустаяХарактеристика,
	|				втТовары.питСкладСортировка КАК Склад
	|			ИЗ
	|				втТовары КАК втТовары
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТовары.Номенклатура,
	|				втТовары.Характеристика,
	|				&ПустойСклад
	|			ИЗ
	|				втТовары КАК втТовары)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.питСкладСортировка КАК питСкладСортировка,
	|	втТовары.питДата КАК питДата,
	|	ЕСТЬNULL(втПриоритеты.Приоритет, &МаксимальныйПриоритет) КАК Приоритет,
	|	ЕСТЬNULL(втПриоритетыПустойСклад.Приоритет, &МаксимальныйПриоритет) КАК ПриоритетПустойСклад,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втПриоритеты.Характеристика, &ПустаяХарактеристика) = &ПустаяХарактеристика
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(втПриоритеты.Характеристика, &ПустаяХарактеристика) <> &ПустаяХарактеристика
	|			ТОГДА 2
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПолеСортировки,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втПриоритетыПустойСклад.Характеристика, &ПустаяХарактеристика) = &ПустаяХарактеристика
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(втПриоритетыПустойСклад.Характеристика, &ПустаяХарактеристика) <> &ПустаяХарактеристика
	|			ТОГДА 2
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПолеСортировкиПустойСклад
	|ПОМЕСТИТЬ втТоварыСортировка
	|ИЗ
	|	втТовары КАК втТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриоритеты КАК втПриоритеты
	|		ПО втТовары.Номенклатура = втПриоритеты.Номенклатура
	|			И (втТовары.Характеристика = втПриоритеты.Характеристика
	|				ИЛИ &ПустаяХарактеристика = втПриоритеты.Характеристика)
	|			И втТовары.питСкладСортировка = втПриоритеты.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриоритеты КАК втПриоритетыПустойСклад
	|		ПО втТовары.Номенклатура = втПриоритетыПустойСклад.Номенклатура
	|			И (втТовары.Характеристика = втПриоритетыПустойСклад.Характеристика
	|				ИЛИ &ПустаяХарактеристика = втПриоритетыПустойСклад.Характеристика)
	|			И (&ПустойСклад = втПриоритетыПустойСклад.Склад)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыСортировка.Номенклатура КАК Номенклатура,
	|	втТоварыСортировка.Характеристика КАК Характеристика,
	|	втТоварыСортировка.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыСортировка.питДата КАК питДата,
	|	МАКСИМУМ(втТоварыСортировка.ПолеСортировкиПустойСклад) КАК ПолеСортировкиПустойСкладМакс,
	|	МАКСИМУМ(втТоварыСортировка.ПолеСортировки) КАК ПолеСортировкиМакс
	|ПОМЕСТИТЬ втТоварыМакс
	|ИЗ
	|	втТоварыСортировка КАК втТоварыСортировка
	|
	|СГРУППИРОВАТЬ ПО
	|	втТоварыСортировка.Номенклатура,
	|	втТоварыСортировка.Характеристика,
	|	втТоварыСортировка.питСкладСортировка,
	|	втТоварыСортировка.питДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыМакс.Номенклатура КАК Номенклатура,
	|	втТоварыМакс.Характеристика КАК Характеристика,
	|	втТоварыМакс.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыМакс.питДата КАК питДата,
	|	ЕСТЬNULL(втТоварыСортировка.Приоритет, &МаксимальныйПриоритет) КАК Приоритет,
	|	ЕСТЬNULL(втТоварыСортировка.ПриоритетПустойСклад, &МаксимальныйПриоритет) КАК ПриоритетПустойСклад
	|ИЗ
	|	втТоварыМакс КАК втТоварыМакс
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТоварыСортировка КАК втТоварыСортировка
	|		ПО втТоварыМакс.Номенклатура = втТоварыСортировка.Номенклатура
	|			И втТоварыМакс.Характеристика = втТоварыСортировка.Характеристика
	|			И втТоварыМакс.питСкладСортировка = втТоварыСортировка.питСкладСортировка
	|			И втТоварыМакс.питДата = втТоварыСортировка.питДата
	|			И втТоварыМакс.ПолеСортировкиМакс = втТоварыСортировка.ПолеСортировки
	|			И втТоварыМакс.ПолеСортировкиПустойСкладМакс = втТоварыСортировка.ПолеСортировкиПустойСклад
	|
	|УПОРЯДОЧИТЬ ПО
	|	питДата,
	|	ПриоритетПустойСклад,
	|	Приоритет";
	КлючевыеКолонки = "Номенклатура, Характеристика, питСкладСортировка, питДата";
	Запрос.УстановитьПараметр("МаксимальныйПриоритет", питПриоритетыПриготовленияПовтИсп.МаксимальныйПриоритетПриготовления());
	Запрос.УстановитьПараметр("ПустойСклад", Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("втТовары", ТаблицаТоваров.Скопировать(, КлючевыеКолонки));
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	// Колонки результирующей таблицы полностью копируем из исходной, 
	// удаляя Характеристику/Склад если мы вдруг их добавляли.
	ТаблицаРезультат = ТаблицаТоваров.Скопировать(Новый Массив);
	Если НЕ ЕстьКолонкаХарактеристика Тогда
		ТаблицаРезультат.Колонки.Удалить("Характеристика");
	КонецЕсли;
	Если НЕ ЕстьКолонкаСклад Тогда
		ТаблицаРезультат.Колонки.Удалить("питСкладСортировка");
	КонецЕсли;
	Если ДобавлятьКолонкиСортировки Тогда
		ТаблицаРезультат.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
		ТаблицаРезультат.Колонки.Добавить("ПриоритетПустойСклад", Новый ОписаниеТипов("Число"));
	ИначеЕсли НЕ ЕстьКолонкаДата Тогда
		ТаблицаРезультат.Колонки.Удалить("питДата");
	КонецЕсли;
	
	ТаблицаТоваров.Индексы.Добавить(КлючевыеКолонки);
	СтруктураПоиска = Новый Структура(КлючевыеКолонки);
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ВыборкаДетальныеЗаписи);
		НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(СтруктураПоиска);
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока);
			Если ДобавлятьКолонкиСортировки Тогда
				НоваяСтрока.Приоритет				= ВыборкаДетальныеЗаписи.Приоритет;
				НоваяСтрока.ПриоритетПустойСклад	= ВыборкаДетальныеЗаписи.ПриоритетПустойСклад;
				НоваяСтрока.питДата					= ВыборкаДетальныеЗаписи.питДата;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Функция выполняет сортировку переданной таблицы по приоритету приготовления с учетом регистра связанных заказов.
//
// Параметры:
//  ТаблицаТоваров - ТаблицаЗначений - Знач таблица товаров.
//  КолонкаСклад - Строка, СправочникСсылка.Склады - Имя колонки склад или ссылка на склад, для которого
//   вычисляется приоритет.
//  ДобавлятьКолонкиСортировки - Булево - Добавлять ли в результирующую отсортированную таблицу колонки, по которы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Отсортированная по приоритету приготовления входная таблица
Функция СортироватьТаблицуПоПриоритетуПриготовленияСУчетомСвязанныхПланов(Знач ТаблицаТоваров, КолонкаСклад = "питСкладСортировка", ДобавлятьКолонкиСортировки = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ питПриоритетыПриготовленияПовтИсп.ИспользоватьПриоритетыПриготовления() Тогда
		Если ДобавлятьКолонкиСортировки Тогда
			ДобавитьКолонкиСортировкиВТаблицу(ТаблицаТоваров);
		КонецЕсли;
		Возврат ТаблицаТоваров;
	КонецЕсли;
	
	ЕстьКолонкаХарактеристика = ТаблицаТоваров.Колонки.Найти("Характеристика") <> Неопределено;
	ЕстьКолонкаСклад = ТаблицаТоваров.Колонки.Найти("питСкладСортировка") <> Неопределено;
	ЕстьКолонкаПланМеню = ТаблицаТоваров.Колонки.Найти("ПланМеню") <> Неопределено;
	
	// Если вдруг нет характеристики или склада то добавляем для корректной работы запроса.
	Если НЕ ЕстьКолонкаХарактеристика Тогда
		ТаблицаТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КонецЕсли;
	Если НЕ ЕстьКолонкаСклад Тогда
		ТаблицаТоваров.Колонки.Добавить("питСкладСортировка", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		Если ТипЗнч(КолонкаСклад) = Тип("Строка") И КолонкаСклад <> "питСкладСортировка" Тогда
			Для каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
				ТекСтрокаТоваров.питСкладСортировка = ТекСтрокаТоваров[КолонкаСклад];
			КонецЦикла;
		ИначеЕсли ТипЗнч(КолонкаСклад) = Тип("СправочникСсылка.Склады") Тогда
			Для каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
				ТекСтрокаТоваров.питСкладСортировка = КолонкаСклад;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЕстьКолонкаПланМеню Тогда
		ТаблицаТоваров.Колонки.Добавить("ПланМеню", Новый ОписаниеТипов("ДокументСсылка.питПланМеню"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.питСкладСортировка КАК питСкладСортировка,
	|	ВЫРАЗИТЬ(втТовары.ПланМеню КАК Документ.питПланМеню) КАК ПланМеню
	|ПОМЕСТИТЬ втТоварыНеСгруппированная
	|ИЗ
	|	&втТовары КАК втТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыНеСгруппированная.Номенклатура КАК Номенклатура,
	|	втТоварыНеСгруппированная.Характеристика КАК Характеристика,
	|	втТоварыНеСгруппированная.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыНеСгруппированная.ПланМеню КАК ПланМеню
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	втТоварыНеСгруппированная КАК втТоварыНеСгруппированная
	|
	|СГРУППИРОВАТЬ ПО
	|	втТоварыНеСгруппированная.Номенклатура,
	|	втТоварыНеСгруппированная.Характеристика,
	|	втТоварыНеСгруппированная.питСкладСортировка,
	|	втТоварыНеСгруппированная.ПланМеню
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТовары.Номенклатура КАК Номенклатура,
	|	втТовары.Характеристика КАК Характеристика,
	|	втТовары.питСкладСортировка КАК питСкладСортировка,
	|	втТовары.ПланМеню КАК ПланМеню,
	|	ЕСТЬNULL(питСвязанныеЗаказы.ДокументРодитель, ЗНАЧЕНИЕ(Документ.питПланМеню.ПустаяСсылка)) КАК ПланМенюРодитель
	|ПОМЕСТИТЬ втТоварыСРодителем
	|ИЗ
	|	втТовары КАК втТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питСвязанныеЗаказы КАК питСвязанныеЗаказы
	|		ПО втТовары.ПланМеню = питСвязанныеЗаказы.ДокументПотомок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыСРодителем.Номенклатура КАК Номенклатура,
	|	втТоварыСРодителем.Характеристика КАК Характеристика,
	|	втТоварыСРодителем.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыСРодителем.ПланМеню КАК ПланМеню,
	|	ЕСТЬNULL(втТоварыСРодителем.ПланМеню.ДатаПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПлан,
	|	ЕСТЬNULL(втТоварыСРодителем.ПланМенюРодитель.ДатаПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПланБлюда,
	|	ЕСТЬNULL(питПланМенюБлюда.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК НоменклатураБлюда,
	|	ЕСТЬNULL(питПланМенюБлюда.Характеристика, &ПустаяХарактеристика) КАК ХарактеристикаБлюда,
	|	ЕСТЬNULL(питПланМенюБлюда.Ссылка.Склад, &ПустойСклад) КАК СкладБлюда
	|ПОМЕСТИТЬ втТоварыСБлюдами
	|ИЗ
	|	втТоварыСРодителем КАК втТоварыСРодителем
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питПланМеню.Ингредиенты КАК питПланМенюИнгредиенты
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.питПланМеню.Блюда КАК питПланМенюБлюда
	|			ПО питПланМенюИнгредиенты.Ссылка = питПланМенюБлюда.Ссылка
	|				И питПланМенюИнгредиенты.ИдентификаторБлюда = питПланМенюБлюда.ИдентификаторСтроки
	|				И (питПланМенюИнгредиенты.ИзАвтопеределов = ЛОЖЬ)
	|		ПО втТоварыСРодителем.ПланМенюРодитель = питПланМенюИнгредиенты.Ссылка
	|			И втТоварыСРодителем.Номенклатура = питПланМенюИнгредиенты.Ингредиент
	|			И втТоварыСРодителем.Характеристика = питПланМенюИнгредиенты.Характеристика
	|			И (питПланМенюИнгредиенты.ИзАвтопеределов = ЛОЖЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питПриоритетыПриготовления.Номенклатура КАК Номенклатура,
	|	питПриоритетыПриготовления.Характеристика КАК Характеристика,
	|	питПриоритетыПриготовления.Склад КАК Склад,
	|	питПриоритетыПриготовления.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ втПриоритеты
	|ИЗ
	|	РегистрСведений.питПриоритетыПриготовления КАК питПриоритетыПриготовления
	|ГДЕ
	|	(питПриоритетыПриготовления.Номенклатура, питПриоритетыПриготовления.Характеристика, питПриоритетыПриготовления.Склад) В
	|			(ВЫБРАТЬ
	|				втТоварыСБлюдами.Номенклатура,
	|				втТоварыСБлюдами.Характеристика,
	|				втТоварыСБлюдами.питСкладСортировка КАК Склад
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТоварыСБлюдами.Номенклатура,
	|				&ПустаяХарактеристика,
	|				&ПустойСклад
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТоварыСБлюдами.Номенклатура,
	|				&ПустаяХарактеристика,
	|				втТоварыСБлюдами.питСкладСортировка КАК Склад
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТоварыСБлюдами.Номенклатура,
	|				втТоварыСБлюдами.Характеристика,
	|				&ПустойСклад
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТоварыСБлюдами.НоменклатураБлюда,
	|				втТоварыСБлюдами.ХарактеристикаБлюда,
	|				втТоварыСБлюдами.СкладБлюда
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТоварыСБлюдами.НоменклатураБлюда,
	|				&ПустаяХарактеристика,
	|				&ПустойСклад
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТоварыСБлюдами.НоменклатураБлюда,
	|				&ПустаяХарактеристика,
	|				втТоварыСБлюдами.СкладБлюда
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				втТоварыСБлюдами.НоменклатураБлюда,
	|				втТоварыСБлюдами.ХарактеристикаБлюда,
	|				&ПустойСклад
	|			ИЗ
	|				втТоварыСБлюдами КАК втТоварыСБлюдами)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыСБлюдами.Номенклатура КАК Номенклатура,
	|	втТоварыСБлюдами.Характеристика КАК Характеристика,
	|	втТоварыСБлюдами.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыСБлюдами.ПланМеню КАК ПланМеню,
	|	втТоварыСБлюдами.ДатаПлан КАК ДатаПлан,
	|	втТоварыСБлюдами.ДатаПланБлюда КАК ДатаПланБлюда,
	|	ЕСТЬNULL(втПриоритеты.Приоритет, &МаксимальныйПриоритет) КАК Приоритет,
	|	ЕСТЬNULL(втПриоритетыПустойСклад.Приоритет, &МаксимальныйПриоритет) КАК ПриоритетПустойСклад,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втПриоритеты.Характеристика, &ПустаяХарактеристика) = &ПустаяХарактеристика
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(втПриоритеты.Характеристика, &ПустаяХарактеристика) <> &ПустаяХарактеристика
	|			ТОГДА 2
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПолеСортировки,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втПриоритетыПустойСклад.Характеристика, &ПустаяХарактеристика) = &ПустаяХарактеристика
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(втПриоритетыПустойСклад.Характеристика, &ПустаяХарактеристика) <> &ПустаяХарактеристика
	|			ТОГДА 2
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПолеСортировкиПустойСклад,
	|	ЕСТЬNULL(втПриоритетыБлюда.Приоритет, &МаксимальныйПриоритет) КАК ПриоритетБлюда,
	|	ЕСТЬNULL(втПриоритетыБлюдаПустойСклад.Приоритет, &МаксимальныйПриоритет) КАК ПриоритетБлюдаПустойСклад,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втПриоритетыБлюда.Характеристика, &ПустаяХарактеристика) = &ПустаяХарактеристика
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(втПриоритетыБлюда.Характеристика, &ПустаяХарактеристика) <> &ПустаяХарактеристика
	|			ТОГДА 2
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПолеСортировкиБлюда,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втПриоритетыБлюдаПустойСклад.Характеристика, &ПустаяХарактеристика) = &ПустаяХарактеристика
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(втПриоритетыБлюдаПустойСклад.Характеристика, &ПустаяХарактеристика) <> &ПустаяХарактеристика
	|			ТОГДА 2
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПолеСортировкиБлюдаПустойСклад
	|ПОМЕСТИТЬ втТоварыСортировка
	|ИЗ
	|	втТоварыСБлюдами КАК втТоварыСБлюдами
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриоритеты КАК втПриоритеты
	|		ПО втТоварыСБлюдами.Номенклатура = втПриоритеты.Номенклатура
	|			И (втТоварыСБлюдами.Характеристика = втПриоритеты.Характеристика
	|				ИЛИ &ПустаяХарактеристика = втПриоритеты.Характеристика)
	|			И втТоварыСБлюдами.питСкладСортировка = втПриоритеты.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриоритеты КАК втПриоритетыПустойСклад
	|		ПО втТоварыСБлюдами.Номенклатура = втПриоритетыПустойСклад.Номенклатура
	|			И (втТоварыСБлюдами.Характеристика = втПриоритетыПустойСклад.Характеристика
	|				ИЛИ &ПустаяХарактеристика = втПриоритетыПустойСклад.Характеристика)
	|			И (&ПустойСклад = втПриоритетыПустойСклад.Склад)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриоритеты КАК втПриоритетыБлюда
	|		ПО втТоварыСБлюдами.НоменклатураБлюда = втПриоритетыБлюда.Номенклатура
	|			И (втТоварыСБлюдами.ХарактеристикаБлюда = втПриоритетыБлюда.Характеристика
	|				ИЛИ &ПустаяХарактеристика = втПриоритетыБлюда.Характеристика)
	|			И втТоварыСБлюдами.СкладБлюда = втПриоритетыБлюда.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриоритеты КАК втПриоритетыБлюдаПустойСклад
	|		ПО втТоварыСБлюдами.НоменклатураБлюда = втПриоритетыБлюдаПустойСклад.Номенклатура
	|			И (втТоварыСБлюдами.ХарактеристикаБлюда = втПриоритетыБлюдаПустойСклад.Характеристика
	|				ИЛИ &ПустаяХарактеристика = втПриоритетыБлюдаПустойСклад.Характеристика)
	|			И (&ПустойСклад = втПриоритетыБлюдаПустойСклад.Склад)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыСортировка.Номенклатура КАК Номенклатура,
	|	втТоварыСортировка.Характеристика КАК Характеристика,
	|	втТоварыСортировка.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыСортировка.ПланМеню КАК ПланМеню,
	|	втТоварыСортировка.ДатаПлан КАК ДатаПлан,
	|	втТоварыСортировка.ДатаПланБлюда КАК ДатаПланБлюда,
	|	МАКСИМУМ(втТоварыСортировка.ПолеСортировки) КАК ПолеСортировкиМакс,
	|	МАКСИМУМ(втТоварыСортировка.ПолеСортировкиБлюда) КАК ПолеСортировкиБлюдаМакс,
	|	МАКСИМУМ(втТоварыСортировка.ПолеСортировкиПустойСклад) КАК ПолеСортировкиПустойСкладМакс,
	|	МАКСИМУМ(втТоварыСортировка.ПолеСортировкиБлюдаПустойСклад) КАК ПолеСортировкиБлюдаПустойСкладМакс
	|ПОМЕСТИТЬ втТоварыМакс
	|ИЗ
	|	втТоварыСортировка КАК втТоварыСортировка
	|
	|СГРУППИРОВАТЬ ПО
	|	втТоварыСортировка.Номенклатура,
	|	втТоварыСортировка.Характеристика,
	|	втТоварыСортировка.питСкладСортировка,
	|	втТоварыСортировка.ПланМеню,
	|	втТоварыСортировка.ДатаПлан,
	|	втТоварыСортировка.ДатаПланБлюда
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыМакс.Номенклатура КАК Номенклатура,
	|	втТоварыМакс.Характеристика КАК Характеристика,
	|	втТоварыМакс.питСкладСортировка КАК питСкладСортировка,
	|	втТоварыМакс.ПланМеню КАК ПланМеню,
	|	втТоварыМакс.ДатаПлан КАК ДатаПлан,
	|	втТоварыМакс.ДатаПланБлюда КАК ДатаПланБлюда,
	|	ЕСТЬNULL(втТоварыСортировка.Приоритет, &МаксимальныйПриоритет) КАК Приоритет,
	|	ЕСТЬNULL(втТоварыСортировка.ПриоритетБлюда, &МаксимальныйПриоритет) КАК ПриоритетБлюда,
	|	ЕСТЬNULL(втТоварыСортировка.ПриоритетПустойСклад, &МаксимальныйПриоритет) КАК ПриоритетПустойСклад,
	|	ЕСТЬNULL(втТоварыСортировка.ПриоритетБлюдаПустойСклад, &МаксимальныйПриоритет) КАК ПриоритетБлюдаПустойСклад
	|ПОМЕСТИТЬ втРезультатНеСгруппированный
	|ИЗ
	|	втТоварыМакс КАК втТоварыМакс
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТоварыСортировка КАК втТоварыСортировка
	|		ПО втТоварыМакс.Номенклатура = втТоварыСортировка.Номенклатура
	|			И втТоварыМакс.Характеристика = втТоварыСортировка.Характеристика
	|			И втТоварыМакс.питСкладСортировка = втТоварыСортировка.питСкладСортировка
	|			И втТоварыМакс.ПланМеню = втТоварыСортировка.ПланМеню
	|			И втТоварыМакс.ДатаПлан = втТоварыСортировка.ДатаПлан
	|			И втТоварыМакс.ДатаПланБлюда = втТоварыСортировка.ДатаПланБлюда
	|			И втТоварыМакс.ПолеСортировкиМакс = втТоварыСортировка.ПолеСортировки
	|			И втТоварыМакс.ПолеСортировкиБлюдаМакс = втТоварыСортировка.ПолеСортировкиБлюда
	|			И втТоварыМакс.ПолеСортировкиПустойСкладМакс = втТоварыСортировка.ПолеСортировкиПустойСклад
	|			И втТоварыМакс.ПолеСортировкиБлюдаПустойСкладМакс = втТоварыСортировка.ПолеСортировкиБлюдаПустойСклад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втРезультатНеСгруппированный.Номенклатура КАК Номенклатура,
	|	втРезультатНеСгруппированный.Характеристика КАК Характеристика,
	|	втРезультатНеСгруппированный.питСкладСортировка КАК питСкладСортировка,
	|	втРезультатНеСгруппированный.ПланМеню КАК ПланМеню,
	|	втРезультатНеСгруппированный.ДатаПлан КАК ДатаПлан,
	|	МИНИМУМ(втРезультатНеСгруппированный.ДатаПланБлюда) КАК ДатаПланБлюда
	|ПОМЕСТИТЬ втМинимальнаяДатаПланБлюда
	|ИЗ
	|	втРезультатНеСгруппированный КАК втРезультатНеСгруппированный
	|
	|СГРУППИРОВАТЬ ПО
	|	втРезультатНеСгруппированный.Номенклатура,
	|	втРезультатНеСгруппированный.Характеристика,
	|	втРезультатНеСгруппированный.питСкладСортировка,
	|	втРезультатНеСгруппированный.ПланМеню,
	|	втРезультатНеСгруппированный.ДатаПлан
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втМинимальнаяДатаПланБлюда.Номенклатура КАК Номенклатура,
	|	втМинимальнаяДатаПланБлюда.Характеристика КАК Характеристика,
	|	втМинимальнаяДатаПланБлюда.питСкладСортировка КАК питСкладСортировка,
	|	втМинимальнаяДатаПланБлюда.ПланМеню КАК ПланМеню,
	|	втМинимальнаяДатаПланБлюда.ДатаПлан КАК ДатаПлан,
	|	втМинимальнаяДатаПланБлюда.ДатаПланБлюда КАК ДатаПланБлюда,
	|	ЕСТЬNULL(втРезультатНеСгруппированный.Приоритет, &МаксимальныйПриоритет) КАК Приоритет,
	|	ЕСТЬNULL(втРезультатНеСгруппированный.ПриоритетБлюда, &МаксимальныйПриоритет) КАК ПриоритетБлюда,
	|	ЕСТЬNULL(втРезультатНеСгруппированный.ПриоритетПустойСклад, &МаксимальныйПриоритет) КАК ПриоритетПустойСклад,
	|	ЕСТЬNULL(втРезультатНеСгруппированный.ПриоритетБлюдаПустойСклад, &МаксимальныйПриоритет) КАК ПриоритетБлюдаПустойСклад
	|ИЗ
	|	втМинимальнаяДатаПланБлюда КАК втМинимальнаяДатаПланБлюда
	|		ЛЕВОЕ СОЕДИНЕНИЕ втРезультатНеСгруппированный КАК втРезультатНеСгруппированный
	|		ПО втМинимальнаяДатаПланБлюда.Номенклатура = втРезультатНеСгруппированный.Номенклатура
	|			И втМинимальнаяДатаПланБлюда.Характеристика = втРезультатНеСгруппированный.Характеристика
	|			И втМинимальнаяДатаПланБлюда.питСкладСортировка = втРезультатНеСгруппированный.питСкладСортировка
	|			И втМинимальнаяДатаПланБлюда.ПланМеню = втРезультатНеСгруппированный.ПланМеню
	|			И втМинимальнаяДатаПланБлюда.ДатаПлан = втРезультатНеСгруппированный.ДатаПлан
	|			И втМинимальнаяДатаПланБлюда.ДатаПланБлюда = втРезультатНеСгруппированный.ДатаПланБлюда
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПланБлюда,
	|	ПриоритетБлюдаПустойСклад,
	|	ПриоритетБлюда,
	|	ДатаПлан,
	|	ПриоритетПустойСклад,
	|	Приоритет";
	КлючевыеКолонки = "Номенклатура, Характеристика, питСкладСортировка, ПланМеню";
	Запрос.УстановитьПараметр("МаксимальныйПриоритет", питПриоритетыПриготовленияПовтИсп.МаксимальныйПриоритетПриготовления());
	Запрос.УстановитьПараметр("ПустойСклад", Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("втТовары", ТаблицаТоваров.Скопировать(, КлючевыеКолонки));
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	// Колонки результирующей таблицы полностью копируем из исходной, 
	// удаляя Характеристику/Склад/ПланМеню если мы вдруг их добавляли.
	ТаблицаРезультат = ТаблицаТоваров.Скопировать(Новый Массив);
	Если НЕ ЕстьКолонкаХарактеристика Тогда
		ТаблицаРезультат.Колонки.Удалить("Характеристика");
	КонецЕсли;
	Если НЕ ЕстьКолонкаСклад Тогда
		ТаблицаРезультат.Колонки.Удалить("питСкладСортировка");
	КонецЕсли;
	Если НЕ ЕстьКолонкаПланМеню Тогда
		ТаблицаРезультат.Колонки.Удалить("ПланМеню");
	КонецЕсли;
	
	Если ДобавлятьКолонкиСортировки Тогда
		ДобавитьКолонкиСортировкиВТаблицу(ТаблицаРезультат);
	КонецЕсли;
	
	ТаблицаТоваров.Индексы.Добавить(КлючевыеКолонки);
	СтруктураПоиска = Новый Структура(КлючевыеКолонки);
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ВыборкаДетальныеЗаписи);
		НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(СтруктураПоиска);
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока);
			Если ДобавлятьКолонкиСортировки Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи, "ДатаПланБлюда, ПриоритетБлюда, ПриоритетБлюдаПустойСклад, ДатаПлан, ПриоритетПустойСклад, Приоритет");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Функция выполняет сортировку табличной части "Товары" переданного объекта по приоритету приготовления.
//
// Параметры:
//  Объект - ДокументОбъект, СправочникОбъект - Ссылка на объект, тч которого сортируем.
//  ИмяТЧ - Строка - Имя табличной части.
//  КолонкаСклад - Строка, СправочникСсылка.Склады - Имя колонки склад или ссылка на склад, для которого вычисляетс.
//  ПланМеню - Произвольный - План меню.
//
Процедура СортироватьТабличнуюЧастьОбъектаПоПриоритетуПриготовления(Объект, ИмяТЧ = "Товары", КолонкаСклад = "Склад", ПланМеню = Неопределено) Экспорт
	
	Если НЕ питПриоритетыПриготовленияПовтИсп.ИспользоватьПриоритетыПриготовления() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПланМеню = Неопределено Тогда
		ПланМеню = Документы.питПланМеню.ПустаяСсылка();
	КонецЕсли;
	
	ИсходнаяТаблица = Объект[ИмяТЧ].Выгрузить();
	Если НЕ ЗначениеЗаполнено(ПланМеню) Тогда
		Результат = питПриоритетыПриготовления.СортироватьТаблицуПоПриоритетуПриготовления(ИсходнаяТаблица, КолонкаСклад);
	Иначе
		ИсходнаяТаблица.Колонки.Добавить("ПланМеню", Новый ОписаниеТипов("ДокументСсылка.питПланМеню"));
		ИсходнаяТаблица.ЗаполнитьЗначения(ПланМеню, "ПланМеню");
		Результат = питПриоритетыПриготовления.СортироватьТаблицуПоПриоритетуПриготовленияСУчетомСвязанныхПланов(ИсходнаяТаблица, КолонкаСклад);
		ИсходнаяТаблица.Колонки.Удалить("ПланМеню");
	КонецЕсли;
	Объект[ИмяТЧ].Загрузить(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура - Добавить колонки сортировки в таблицу.
//
// Параметры:
//  ОбрабатываемаяТаблица - ТаблицаЗначений - Обрабатываемая таблица.
//
Процедура ДобавитьКолонкиСортировкиВТаблицу(ОбрабатываемаяТаблица)
	
	ОбрабатываемаяТаблица.Колонки.Добавить("ДатаПланБлюда", Новый ОписаниеТипов("Дата"));
	ОбрабатываемаяТаблица.Колонки.Добавить("ПриоритетБлюда", Новый ОписаниеТипов("Число"));
	ОбрабатываемаяТаблица.Колонки.Добавить("ДатаПлан", Новый ОписаниеТипов("Дата"));
	ОбрабатываемаяТаблица.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
	ОбрабатываемаяТаблица.Колонки.Добавить("ПриоритетПустойСклад", Новый ОписаниеТипов("Число"));
	ОбрабатываемаяТаблица.Колонки.Добавить("ПриоритетБлюдаПустойСклад", Новый ОписаниеТипов("Число"));
	
КонецПроцедуры

#КонецОбласти





