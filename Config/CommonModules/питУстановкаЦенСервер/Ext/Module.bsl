
#Область ПрограммныйИнтерфейс

// %ИзЕРП% питУстановкаЦенСервер.ВычислитьЗначенияЦеныПоДаннымИБ
//  Функция дополняет типовую функцию "ВычислитьЗначенияЦеныПоДаннымИБ",
//  по переданным параметрам исполняет схему компоновки данных, дополняет ее ценами блюд и подменяет набор данных.
//
// Параметры:
//  ТаблицаНоменклатуры - ТаблицаЗначений - Таблица номенклатуры.
//  СтрокаВидЦены - Произвольный - Из функции питУстановкаЦенСервер.ВычислитьЗначенияЦеныПоДаннымИБ.
//  СхемаКомпоновкиДанных - СхемаКомпоновкиДанных - Из функции питУстановкаЦенСервер.ВычислитьЗначенияЦеныПоДаннымИБ.
//  НастройкиКомпоновкиДанных - НастройкиКомпоновкиДанных - Из функции
//   питУстановкаЦенСервер.ВычислитьЗначенияЦеныПоДаннымИБ.
//  Форма - УправляемаяФорма - Из функции питУстановкаЦенСервер.ВычислитьЗначенияЦеныПоДаннымИБ.
//  ДатаЦен - Дата - Дата из функции питУстановкаЦенСервер.ВычислитьЗначенияЦеныПоДаннымИБ.
//  РабочийНаборДанных - НаборДанныхЗапросСхемыКомпоновкиДанных - Из функции.
//
// Возвращаемое значение:
//    ТаблицаЗначений - Таблица цен.
Функция ВычислитьЗначенияЦеныПоДаннымИБПолучитьТаблицуЦен(ТаблицаНоменклатуры, СтрокаВидЦены, СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных, Форма, ДатаЦен, РабочийНаборДанных) Экспорт
	
	// Выполняется только для СКД "Нормативные цены блюд общепита".
	Если СхемаКомпоновкиДанных.НаборыДанных[0].Имя <> "ЗапросАктуальныеРецептуры" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Исполнение схемы компоновки данных.
	
	// Инициализация компоновщика настроек.
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	Если НастройкиКомпоновкиДанных <> Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиДанных);
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	Иначе
		Если ЗначениеЗаполнено(СтрокаВидЦены.АдресНастроекСхемыКомпоновкиДанных) Тогда
			НастройкиИзВидаЦены = ПолучитьИзВременногоХранилища(СтрокаВидЦены.АдресНастроекСхемыКомпоновкиДанных);
			КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиИзВидаЦены);
			КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
		Иначе
			КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КонецЕсли;
	КонецЕсли;
	
	// Заполнение структуры отчета и выбранных полей.
	КомпоновщикНастроек.Настройки.Структура.Очистить();
	ГруппировкаДетальныеЗаписи = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаДетальныеЗаписи.Использование = Истина;
	КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Номенклатура");
	Если Форма.ИспользоватьХарактеристикиНоменклатуры Тогда
		УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Характеристика");
	КонецЕсли;
	Если Форма.ИспользоватьУпаковкиНоменклатуры Тогда
		УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Упаковка");
		УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Коэффициент");
	КонецЕсли;
	УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Цена");
	УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Валюта");
	УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "КоличествоВРецептуре");
	УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Рецептура");
	УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Организация");
	УстановкаЦенСервер.ДобавитьВыбранноеПолеСКД(ГруппировкаДетальныеЗаписи, "Подразделение");
	
	// Получение макета компоновки.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	// Установка параметров.
	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("Период");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ДатаЦен;
	КонецЕсли;
	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("ТаблицаНоменклатурыНоменклатура");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура");
	КонецЕсли;
	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("ТаблицаНоменклатурыХарактеристика");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ТаблицаНоменклатуры.ВыгрузитьКолонку("Характеристика");
	КонецЕсли;
	
	// Вывод результата в ТЗ.
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаЦен = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаЦен);
	ТаблицаЦен = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
//   Обязательно должны быть в наборе данных поля, которые в исходном наборе были доступны для отбора, иначе
// КомпоновщикМакетаКомпоновкиДанных упадет.
	ТаблицаЦен.Колонки.Добавить("ОрганизацияРецептур"		, Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаЦен.Колонки.Добавить("ПодразделениеРецептур"		, Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаЦен.Колонки.Добавить("РецептураОтбор"			, Новый ОписаниеТипов("ДокументСсылка.питРецептура"));
	ТаблицаЦен.Колонки.Добавить("НоменклатураРецептур"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЦен.Колонки.Добавить("ХарактеристикаРецептур"	, Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Дозаполнение результирующей ТЗ, определение цены блюд.
	ВидЦеныНормативный = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит");
	Если ЗначениеЗаполнено(ВидЦеныНормативный) Тогда
		ВалютаНормативная = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЦеныНормативный, "ВалютаЦены");
		КэшЦен = питПроизводство.ИнициализироватьТаблицуКэшаЦен();
		НеИспользоватьСезонныеПроценты = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питНеИспользоватьСезонныеПроценты");
		// Служебная структура, хранящая кэшированные значения, уменьшает общее число запросов 
		//  к базе во время заполнения дерева состава, вычисления сезонных процентов и т.д.
		КэшЗаполненияДерева = питПроизводство.ИнициализироватьСтруктуруКэшированныхЗначенийДляЗаполненияДереваСостава();
		Для каждого ТекСтрокаЦены Из ТаблицаЦен Цикл
			ТекСтрокаЦены.Валюта	= ВалютаНормативная;
			ТекстПредупреждения = "";
			Если НЕ НеИспользоватьСезонныеПроценты Тогда
				СезонныйПроцент = питЛицензированиеСервер.ПолучитьСезонныйПроцент(ТекСтрокаЦены.Номенклатура, ДатаЦен, КэшЗаполненияДерева.КэшСезонныхПроцентов);
				СезонныйКоэффициент = 1+СезонныйПроцент/100;
			Иначе
				СезонныйКоэффициент = 1;
			КонецЕсли;
			СуммаНорма				= питПроизводство.ПолучитьСтоимостьПеределаПоРецептуре(ТекСтрокаЦены.Рецептура, ВидЦеныНормативный, ДатаЦен, ВалютаНормативная, КэшЦен, ТекстПредупреждения, НеИспользоватьСезонныеПроценты, КэшЗаполненияДерева);
			ТекСтрокаЦены.Цена		= СуммаНорма / Окр(?(ТекСтрокаЦены.КоличествоВРецептуре=0,1,ТекСтрокаЦены.КоличествоВРецептуре) * СезонныйКоэффициент, 3);
			
			Если НЕ ПустаяСтрока(ТекстПредупреждения) Тогда
				ТекстСообщения = "При расчете цены по виду цен <"+СтрокаВидЦены.Ссылка+"> на блюдо <"
					+ ТекСтрокаЦены.Номенклатура
					+ ?(Форма.ИспользоватьХарактеристикиНоменклатуры И ЗначениеЗаполнено(ТекСтрокаЦены.Характеристика),"; "+ТекСтрокаЦены.Характеристика,"")
					+ "> не учтены нормативные цены на ингредиенты:"
					+ ТекстПредупреждения;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			
//   Обязательно должны быть в наборе данных поля, которые в исходном наборе были доступны для отбора, иначе
// КомпоновщикМакетаКомпоновкиДанных упадет.
			ТекСтрокаЦены.ОрганизацияРецептур		= ТекСтрокаЦены.Организация;
			ТекСтрокаЦены.ПодразделениеРецептур		= ТекСтрокаЦены.Подразделение;
			ТекСтрокаЦены.РецептураОтбор			= ТекСтрокаЦены.Рецептура;
			ТекСтрокаЦены.НоменклатураРецептур		= ТекСтрокаЦены.Номенклатура;
			Если Форма.ИспользоватьХарактеристикиНоменклатуры Тогда
				ТекСтрокаЦены.ХарактеристикаРецептур	= ТекСтрокаЦены.Характеристика;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Подмена в выполненной СКД набора данных на найденную таблицу.
	
	СтарыйНаборДанных = СхемаКомпоновкиДанных.НаборыДанных[0];
	
	НаборДанныхТаблицаЦен                = СхемаКомпоновкиДанных.НаборыДанных.Вставить(0,Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанныхТаблицаЦен.Имя            = "питТаблицаЦен";
	НаборДанныхТаблицаЦен.ИмяОбъекта     = "питТаблицаЦен";
	НаборДанныхТаблицаЦен.ИсточникДанных = СтарыйНаборДанных.ИсточникДанных;
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "Номенклатура", "СправочникСсылка.Номенклатура");
	Если Форма.ИспользоватьХарактеристикиНоменклатуры Тогда
		ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "Характеристика", "СправочникСсылка.ХарактеристикиНоменклатуры");
	КонецЕсли;
	Если Форма.ИспользоватьУпаковкиНоменклатуры Тогда
		ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "Упаковка", "СправочникСсылка.УпаковкиЕдиницыИзмерения");
		ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "Коэффициент", "Число");
	КонецЕсли;
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "Цена", "Число");
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "Валюта", "СправочникСсылка.Валюты");
	
//   Обязательно должны быть в наборе данных поля, которые в исходном наборе были доступны для отбора, иначе
// КомпоновщикМакетаКомпоновкиДанных упадет.
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "ОрганизацияРецептур"		, "СправочникСсылка.Организации");
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "ПодразделениеРецептур"	, "СправочникСсылка.СтруктураПредприятия");
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "РецептураОтбор"			, "ДокументСсылка.питРецептура");
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "НоменклатураРецептур"	, "СправочникСсылка.Номенклатура");
	ДобавитьПолеНабораДанныхСКД(НаборДанныхТаблицаЦен, "ХарактеристикаРецептур"	, "СправочникСсылка.ХарактеристикиНоменклатуры");
	
	СхемаКомпоновкиДанных.НаборыДанных.Удалить(СтарыйНаборДанных);
	
	РабочийНаборДанных = НаборДанныхТаблицаЦен;
	
	Возврат ТаблицаЦен;
	
КонецФункции

// %ИзЕРП% питУстановкаЦенСервер.ВычислитьЗначенияЦеныПоДаннымИБ
//
// Параметры:
//  ВнешниеНаборыДанных - Структура - Внешние наборы.
//  СхемаКомпоновкиДанных - СхемаКомпоновкиДанных - схема компоновки данных.
//  питТаблицаЦен - ТаблицаЗначений - Таблица цен.
//
Процедура ДобавитьТаблицуЦенКакВнешнийНаборДанных(ВнешниеНаборыДанных, СхемаКомпоновкиДанных, питТаблицаЦен) Экспорт
	
	Если питТаблицаЦен = Неопределено Тогда
		// Значит не нужно добавлять внешний набор.
		Возврат;
	КонецЕсли;
	
	ВнешниеНаборыДанных.Вставить("питТаблицаЦен", питТаблицаЦен);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// %ИзЕРП%
//  питУстановкаЦенСервер.ДобавитьПолеНабораДанныхСКД
//
// Параметры:
//  НаборДанных - Произвольный - Набор данных.
//  ИмяПоля - Произвольный - Имя поля.
//  ТипЗначения - Произвольный - Тип значения.
//
Процедура ДобавитьПолеНабораДанныхСКД(НаборДанных, ИмяПоля, ТипЗначения)
	
	ПолеНабораДанных             = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеНабораДанных.Поле        = ИмяПоля;
	ПолеНабораДанных.ПутьКДанным = ИмяПоля;
	ПолеНабораДанных.ТипЗначения = Новый ОписаниеТипов(ТипЗначения);
	
КонецПроцедуры

#КонецОбласти




