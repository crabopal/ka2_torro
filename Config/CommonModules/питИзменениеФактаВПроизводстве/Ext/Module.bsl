
#Область ПрограммныйИнтерфейс

#Область ПоискВТабличныхЧастях

// Функция ищет ингредиенты из ТЧ "Ингредиенты" с флагом "ИзАвтопеределов", которые соответствуют переданному блюду.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой производим поиск.
//  Ингредиенты - ДанныеФормыКоллекция - Табличная часть "Ингредиенты".
//  СтрокаБлюдо - ДанныеФормыЭлементКоллекции - Строка блюда, для которого ищем ингредиенты.
//
// Возвращаемое значение:
//  Массив - Массив найденных ингредиентов.
Функция НайтиИнгредиентыИзАвтопеределовПоБлюду(Форма, Ингредиенты, СтрокаБлюдо) Экспорт
	
	ИменаРеквизитовТаблицыИнгредиентов = Форма.ИменаКолонокИнгредиенты;
	
	// Поиск строк "ИзАвтопеределов" в ТЧ "Ингредиенты", соответствующих текущему блюду в ТЧ "Блюда"
	СтруктураПоиска = Новый Структура("Ингредиент, Характеристика, УпаковкаИнгредиента, ИзАвтопеределов");
	СтруктураПоиска.Ингредиент			= СтрокаБлюдо.Номенклатура;
	СтруктураПоиска.Характеристика		= СтрокаБлюдо.Характеристика;
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если НЕ ИменаРеквизитовТаблицыИнгредиентов.НайтиПоЗначению("Серия") = Неопределено Тогда
		СтруктураПоиска.Вставить("Серия", СтрокаБлюдо.Серия);
	КонецЕсли;
	СтруктураПоиска.УпаковкаИнгредиента	= СтрокаБлюдо.УпаковкаНоменклатуры;
	СтруктураПоиска.ИзАвтопеределов		= Истина;
	МассивИнгредиентов = Ингредиенты.НайтиСтроки(СтруктураПоиска);
	
	Возврат МассивИнгредиентов;
	
КонецФункции

// Функция выполняет поиск товара в ТЧ "Товары" по переданной строке блюда.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой производим поиск.
//  Товары - ДанныеФормыКоллекция - Табличная часть "Товары".
//  ТекущееБлюдо - ДанныеФормыЭлементКоллекции - Строка блюда, для которого ищем товар.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - Найденная строка ТЧ "Товары".
Функция НайтиТоварПоБлюду(Форма, Товары, ТекущееБлюдо) Экспорт
	
	ИменаРеквизитовТаблицыПоиска = Форма.ИменаКолонокБлюда;
	
	НайденныйТовар = Неопределено;
	Если ТекущееБлюдо.Автопередел Тогда
		Возврат НайденныйТовар;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Номенклатура"		, ТекущееБлюдо.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика"	, ТекущееБлюдо.Характеристика);
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если НЕ ИменаРеквизитовТаблицыПоиска.НайтиПоЗначению("Серия") = Неопределено Тогда
		СтруктураПоиска.Вставить("Серия"			, ТекущееБлюдо.Серия);
	КонецЕсли;
	НайденныеТовары = Товары.НайтиСтроки(СтруктураПоиска);
	Если НайденныеТовары.Количество() Тогда
		НайденныйТовар = НайденныеТовары[0];
	КонецЕсли;
	
	Возврат НайденныйТовар;
	
КонецФункции

// Функция выполняет поиск блюда в ТЧ "Блюда" по переданной строке товаров.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой производим поиск.
//  Блюда - ДанныеФормыКоллекция - Табличная часть "Блюда".
//  СтрокаТовар - ДанныеФормыЭлементКоллекции - Строка товаров, для которой ищем блюдо.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - Найденная строка ТЧ "Блюда".
Функция НайтиБлюдоПоТовару(Форма, Блюда, СтрокаТовар) Экспорт
	
	НайденноеБлюдо = Неопределено;
	
	ИменаРеквизитовТаблицыПоиска = Форма.ИменаКолонокБлюда;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Номенклатура"		, СтрокаТовар.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика"	, СтрокаТовар.Характеристика);
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если НЕ ИменаРеквизитовТаблицыПоиска.НайтиПоЗначению("Серия") = Неопределено Тогда
		СтруктураПоиска.Вставить("Серия"			, СтрокаТовар.Серия);
	КонецЕсли;
	СтруктураПоиска.Вставить("Автопередел"		, Ложь);
	НайденныеБлюда = Блюда.НайтиСтроки(СтруктураПоиска);
	Если НайденныеБлюда.Количество() Тогда
		НайденноеБлюдо = НайденныеБлюда[0];
	КонецЕсли;
	
	Возврат НайденноеБлюдо;
	
КонецФункции

// Функция выполняет поиск строки ТЧ "Ингредиенты", которая соответствует строке ТЧ "Замены".
//
// Параметры:
//  Ингредиенты - ДанныеФормыЭлементКоллекции - Табличная часть "Ингредиенты".
//  Блюда - ДанныеФормыЭлементКоллекции - Табличная часть "Блюда".
//  СтрокаЗамена - ДанныеФормыЭлементКоллекции - Строка замен, для которой ищем ингредиент.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - 
Функция НайтиИнгредиентПоЗамене(Ингредиенты, Блюда, СтрокаЗамена) Экспорт
	
	НайденныйИнгредиент = Неопределено;
	
	// Поиска блюда, соответствующего текущей замене.
	НайденноеБлюдо		= НайтиБлюдоПоЗамене(Блюда, СтрокаЗамена);
	Если НЕ НайденноеБлюдо = Неопределено Тогда
		// Поиск ингредиента, соответствующего текущей замене.
		НайденныйИнгредиент = НайтиИнгредиентПоБлюдуИЗамене(Ингредиенты, НайденноеБлюдо, СтрокаЗамена);
	КонецЕсли;
	
	Возврат НайденныйИнгредиент;
	
КонецФункции

// Функция ищет строку в ТЧ "Блюда" по переданной строке ТЧ "Ингредиенты" и добавляет новую, если не найдена.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой происходит добавление блюда.
//  СтрокаИнгредиент - Строка - Строка ингредиент.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - Найденная строка ТЧ "Блюда".
Функция НайтиДобавитьБлюдоПоИнгредиенту(Форма, СтрокаИнгредиент) Экспорт
	
	// Получаем таблицу блюд из переданной формы.
	Блюда = Форма.Объект.Блюда;
	
	ИменаРеквизитовТаблицыБлюд = Форма.ИменаКолонокБлюда;
	
	// Поиск строки в ТЧ "Блюда", соответствующей текущему ингредиенту "ИзАвтопеределов"
	ТекущееБлюдо = НайтиБлюдоПоИнгредиентуИзАвтопеределов(Форма, Блюда, СтрокаИнгредиент);
	Если ТекущееБлюдо = Неопределено Тогда
		
		ТекущееБлюдо = Блюда.Добавить();
		ТекущееБлюдо.ИдентификаторСтроки			= Новый УникальныйИдентификатор;
		ТекущееБлюдо.Номенклатура					= СтрокаИнгредиент.Ингредиент;
		ТекущееБлюдо.Характеристика					= СтрокаИнгредиент.Характеристика;
		ТекущееБлюдо.УпаковкаНоменклатуры			= СтрокаИнгредиент.УпаковкаИнгредиента;
		ТекущееБлюдо.Автопередел					= СтрокаИнгредиент.ИзАвтопеределов;
		ТекущееБлюдо.Рецептура						= СтрокаИнгредиент.РецептураАвтопередела;
		ТекущееБлюдо.СтатьяКалькуляции				= СтрокаИнгредиент.СтатьяКалькуляции;
		ТекущееБлюдо.КоличествоУпаковокНоменклатуры	= 0;
		ТекущееБлюдо.КоличествоНоменклатуры			= 0;
		ТекущееБлюдо.Порядок						= 0;
		
		// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
		Если НЕ ИменаРеквизитовТаблицыБлюд.НайтиПоЗначению("Серия") = Неопределено Тогда
			ТекущееБлюдо.Серия = СтрокаИнгредиент.Серия;
		КонецЕсли;
		Если НЕ ИменаРеквизитовТаблицыБлюд.НайтиПоЗначению("НазначениеИнгредиентов") = Неопределено Тогда
			ТекущееБлюдо.НазначениеИнгредиентов = СтрокаИнгредиент.НазначениеИнгредиентов;
		КонецЕсли;
		Если НЕ ИменаРеквизитовТаблицыБлюд.НайтиПоЗначению("Назначение") = Неопределено Тогда
			ТекущееБлюдо.Назначение = Справочники.Назначения.ПустаяСсылка();
		КонецЕсли;
		
		// СтатусУказанияСерий
		// Заполняем дополнительные типовые колонки
		КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
		Новый Структура("Номенклатура", "ТипНоменклатуры"));
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущееБлюдо, СтруктураДействий, КэшированныеЗначенияЛокальные);
		
	КонецЕсли;
	
	Возврат ТекущееБлюдо;
	
КонецФункции

// Функция ищет блюдо, в состав которого входит переданный ингредиент.
//
// Параметры:
//  Блюда - ДанныеФормыКоллекция - Табличная часть "Блюда".
//  СтрокаИнгредиент - ДанныеФормыЭлементКоллекции - Строка ингредиента, для которой ищем блюдо.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - Найденная строка таблицы "Блюда".
Функция НайтиБлюдоИнгредиента(Блюда, СтрокаИнгредиент) Экспорт
	
	НайденноеБлюдо = Неопределено;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("ИдентификаторСтроки"		, СтрокаИнгредиент.ИдентификаторБлюда);
	НайденныеБлюда = Блюда.НайтиСтроки(СтруктураПоиска);
	Если НайденныеБлюда.Количество() Тогда
		НайденноеБлюдо = НайденныеБлюда[0];
	КонецЕсли;
	
	Возврат НайденноеБлюдо;
	
КонецФункции

#КонецОбласти

// Процедура обрабатывает изменение фактического количества, который является полуфабрикатом либо рецептуры блюд
//  проходя по дереву производства и заменяя фактическое количество / рецептуры на новые.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма документа, в котором происходит обработка изменения факта.
//  СтрокаИнгредиент - ДанныеФормыЭлементКоллекции - Строка табличной части "Ингредиенты", факт которой изменился.
//  СтрокаБлюдо - ДанныеФормыЭлементКоллекции - Строка табличной части "Блюда", факт которой изменился.
//  Автопередел - Булево - Параметр, который используется при рекурсивном вызове для поиска в таблице
//   ТаблицаДляРаспределения.
//  ТаблицаДляРаспределения - ТаблицаЗначений - Таблица производства, расчитанная для измененного полуфабриката на его
//   новое количество.
//   Если не указана, то расчитывается в момент первого вызова функции.
//  ИзменятьИзмененные - Булево - Признак того, что в процессе пересчета можно изменять строки ингредиентов, у
//   которых стоит флаг "ИзмененФакт".
//  УдалятьЗамены - Булево - Признак того, что в процессе пересчета необходимо удалять замены, у изменяемы.
//  ОбработанныеИнгредиенты - Произвольный - Обработанные ингредиенты.
//
Процедура ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(Форма, СтрокаИнгредиент, СтрокаБлюдо, Автопередел = Ложь, ТаблицаДляРаспределения = Неопределено, ИзменятьИзмененные = Ложь, УдалятьЗамены = Ложь, ОбработанныеИнгредиенты = Неопределено) Экспорт
	
	// Данные объекта.
	Объект = Форма.Объект;
	
	// Проверка, что передали хотя бы 1 из параметров СтрокаИнгредиент ИЛИ СтрокаБлюдо.
	Если СтрокаИнгредиент = Неопределено И СтрокаБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Защита от зацикливания.
	Если ОбработанныеИнгредиенты = Неопределено Тогда
		ОбработанныеИнгредиенты = Новый Массив;
	КонецЕсли;
	
	// Функция может вызываться как для ингредиента, так и для блюда.
	ЭтоИзменениеФактаБлюда = НЕ СтрокаБлюдо = Неопределено;
	
	Если ЭтоИзменениеФактаБлюда Тогда
//   Значение дельты количеств и изменения рецептуры по умолчанию. Инициализируется только если это НЕ
// ЭтоИзменениеФактаБлюда.
		ДельтаКоличествоУпаковокФакт = 0;
		ДельтаКоличествоФакт = 0;
		РецептураИзменена = Ложь;
		// Если меняем факт блюда, то измененные строки также разрешено менять.
		ИзменятьИзмененные = Истина;
		// Если меняем факт блюда, то в процессе перезаполнения удаляем замены ингредиентов.
		УдалятьЗамены = Истина;
	Иначе
		// Определяем дельту, на которую изменилось количество в текущей строке ингредиента.
		ДельтаКоличествоУпаковокФакт	= СтрокаИнгредиент.КоличествоУпаковокИнгредиентаФакт - СтрокаИнгредиент.КоличествоУпаковокИнгредиентаФактПред;
		ДельтаКоличествоФакт			= СтрокаИнгредиент.КоличествоИнгредиентаФакт - СтрокаИнгредиент.КоличествоИнгредиентаФактПред;
		РецептураИзменена				= СтрокаИнгредиент.РецептураАвтопеределаПред <> СтрокаИнгредиент.РецептураАвтопередела;
	КонецЕсли;
	
	// Поиск текущего блюда, с которым будем работать.
	ТекущееБлюдо = Неопределено;
	Если ЭтоИзменениеФактаБлюда Тогда
		
		// Если меняем факт блюда, то работаем с переданной извне строкой.
		ТекущееБлюдо = СтрокаБлюдо;
		
	ИначеЕсли ДельтаКоличествоУпаковокФакт <> 0 ИЛИ ДельтаКоличествоФакт <> 0 ИЛИ РецептураИзменена Тогда
		// Если изменяем факт ингредиента, то ищем блюдо по текущей строке ингредиентов.
		
		// Поиск строки в ТЧ "Блюда", соответствующей текущему ингредиенту "ИзАвтопеределов"
		ТекущееБлюдо = НайтиБлюдоПоИнгредиентуИзАвтопеределов(Форма, Объект.Блюда, СтрокаИнгредиент);
		Если ТекущееБлюдо = Неопределено Тогда
			// Текущее блюдо не найдено, выходим из процедуры
			УстановитьПредыдущееСостояниеИнгредиентаВТекущее(СтрокаИнгредиент);
			Возврат;
		КонецЕсли;
		
		// Установка нового значения рецептуры для блюда.
		ТекущееБлюдо.Рецептура						= СтрокаИнгредиент.РецептураАвтопередела;
		// Установка нового количества блюда со сдвигом на дельту.
		ТекущееБлюдо.КоличествоНоменклатуры			= ТекущееБлюдо.КоличествоНоменклатуры + ДельтаКоличествоФакт;
		ТекущееБлюдо.КоличествоУпаковокНоменклатуры	= ТекущееБлюдо.КоличествоУпаковокНоменклатуры + ДельтаКоличествоУпаковокФакт;
		
	Иначе
		
		// Текущее блюдо не найдено, выходим из процедуры
		УстановитьПредыдущееСостояниеИнгредиентаВТекущее(СтрокаИнгредиент);
		Возврат;
		
	КонецЕсли;
	
	// Продолжаем, если смогли найти текущее блюдо, с котором будем работать.
	
	Если ТаблицаДляРаспределения = Неопределено Тогда
		// Расчет производства для нового значения количества автопередела.
		// Вызывается 1 раз, на самом верхнем уровне рекурсии только для того автопередела,
		// который изменил пользователь.
		
		Если НЕ ТекущееБлюдо.Автопередел Тогда
//   Если новое количество блюда нулевое - это значит, что дельта была отрицательная и равная исходному количеству.
// Используем ее для расчета.
			КоличествоДляРасчета			= ?(ТекущееБлюдо.КоличествоНоменклатуры = 0, -ДельтаКоличествоФакт, ТекущееБлюдо.КоличествоНоменклатуры);
			КоличествоУпаковокДляРасчета	= ?(ТекущееБлюдо.КоличествоУпаковокНоменклатуры = 0, -ДельтаКоличествоУпаковокФакт, ТекущееБлюдо.КоличествоУпаковокНоменклатуры);
		Иначе
			// Теперь для п.ф. считаем по другому, т.к. могут быть строки, которые не готовятся из-за того, что хватает остатков.
//   Теперь просто складываем все количества факт по местам, где встречается рассчитываемое блюдо, причем не учитывая
// флаг "ИзАвтопеределов".
			ИнгредиентыИзАвтопеределовПоБлюду = НайтиИнгредиентыИзАвтопеределовПоБлюду(Форма, Объект.Ингредиенты, ТекущееБлюдо);
			КоличествоДляРасчета = 0;
			КоличествоУпаковокДляРасчета = 0;
			Для каждого ТекИнгредиент Из ИнгредиентыИзАвтопеределовПоБлюду Цикл
				Если ЗначениеЗаполнено(ТекИнгредиент.РецептураАвтопередела) И ТекИнгредиент.ПриготовлениеРазрешено Тогда
					КоличествоДляРасчета = КоличествоДляРасчета + ТекИнгредиент.КоличествоИнгредиентаФакт;
					КоличествоУпаковокДляРасчета = КоличествоУпаковокДляРасчета + ТекИнгредиент.КоличествоУпаковокИнгредиентаФакт;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ТаблицаДляРаспределения = ПолучитьТаблицуПроизводстваПоБлюду(Форма, ТекущееБлюдо, КоличествоДляРасчета, КоличествоУпаковокДляРасчета);
	КонецЕсли;
	
	// Поиск ингредиентов в ТЧ "Ингредиенты", соответствующих измененному автопеределу.
	МассивИнгредиентовТекущих = НайтиИнгредиентыПоБлюдуВТаблицеИнгредиентов(Объект.Ингредиенты, ТекущееБлюдо);
	
	ИнгредиентыИзЗаготовок = Новый Массив;
	
	НайденныеНовыеСтроки = Новый Массив; // Массив строк, которые были найдены в новой таблице производства.
	Для каждого ТекущийИнгредиент Из МассивИнгредиентовТекущих Цикл
		
		Если ИзменятьИзмененные Тогда
			// Разрешаем менять измененные строки.
			ТекущийИнгредиент.ИзмененФакт = Ложь;
		КонецЕсли;
		
		Если ТекущийИнгредиент.ИзмененФакт Тогда
			// Ингредиент уже был изменен, повторно не меняем (за исключением, если не передан специальный параметр).
			Продолжить;
		КонецЕсли;
		
		// Поиск строки в таблице производства, соответствующей текущему блюду и ингредиенту.
		НайденнаяНоваяСтрока = НайтиИнгредиентТаблицыПроизводстваПоИнгредиентуИБлюдуИзОбъекта(Форма, ТаблицаДляРаспределения, ТекущийИнгредиент, ТекущееБлюдо, Автопередел);
		
		// Для режима нехватающих заготовок может быть дополнительная строка 
		Если ИнгредиентыИзЗаготовок.Найти(ТекущийИнгредиент) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТекущийИнгредиентИзЗаготовок = НайтиИнгредиентИзЗаготовокПоПеределу(Объект.Ингредиенты, ТекущийИнгредиент);
		Если НЕ ТекущийИнгредиентИзЗаготовок = Неопределено И ТекущийИнгредиентИзЗаготовок.ИзмененФакт Тогда
			ТекущийИнгредиентИзЗаготовок = Неопределено;
		КонецЕсли;
		Если НЕ ТекущийИнгредиентИзЗаготовок = Неопределено Тогда
			ИнгредиентыИзЗаготовок.Добавить(ТекущийИнгредиентИзЗаготовок);
		КонецЕсли;
		
		Если НЕ НайденнаяНоваяСтрока = Неопределено Тогда
			// Если ингредиент в массиве новых найден.
			НайденныеНовыеСтроки.Добавить(НайденнаяНоваяСтрока);
			
			// Меняем количество ингредиента.
			ОбновитьКоличестваИнгредиентаСУчетомЗаменПоСтрокеПроизводства(ТекущийИнгредиент, ТекущийИнгредиентИзЗаготовок, ТекущееБлюдо, Объект.Замены, НайденнаяНоваяСтрока, ДельтаКоличествоФакт, ДельтаКоличествоУпаковокФакт, ЭтоИзменениеФактаБлюда, УдалятьЗамены);
			
			// Обновляем рецептуру на новую из таблицы производства.
			ТекущийИнгредиент.РецептураАвтопередела				= НайденнаяНоваяСтрока.РецептураАвтопередела;
		Иначе
			// Если ингредиент в таблице производства НЕ найден - обнуляем количество.
			ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт	= 0;
			ТекущийИнгредиент.КоличествоИнгредиентаФакт			= 0;
		КонецЕсли;
		
		Если питИзменениеФактаВПроизводствеКлиентСервер.ТекущийИнгредиентЯвляетсяПолуфабрикатом(ТекущийИнгредиент) Тогда
			
			// Защита от зацикливания
			Если НЕ ОбработанныеИнгредиенты.Найти(ТекущийИнгредиент) = Неопределено Тогда
				ОбщегоНазначения.СообщитьПользователю("Обнаружено зацикливание при обновлении фактического количества по ингредиенту <" + ТекущийИнгредиент.Ингредиент + ">");
				Продолжить;
			КонецЕсли;
			ОбработанныеИнгредиенты.Добавить(ТекущийИнгредиент);
			
			// Обрабатываем рекурсивно изменение количества ингредиента, который является полуфабрикатом.
			ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(Форма, ТекущийИнгредиент, Неопределено, Истина, ТаблицаДляРаспределения, ИзменятьИзмененные, Ложь, ОбработанныеИнгредиенты);
		КонецЕсли;
	КонецЦикла;
	
	// Добавление в ингредиенты новых строк, которых не было раньше.
	МассивИнгредиентовНовых = НайтиИнгредиентыПоБлюдуВТаблицеПроизводства(Форма, ТаблицаДляРаспределения, ТекущееБлюдо, Автопередел);
	Для каждого СтрокаНовыйИнгредиент Из МассивИнгредиентовНовых Цикл
		Если НайденныеНовыеСтроки.Найти(СтрокаНовыйИнгредиент) = Неопределено Тогда
			
			// Новая строка не была среди найденных, значит ее не было раньше. Добавляем.
			ТекущийИнгредиент = ДобавитьИнгредиентПоБлюдуИСтрокеТаблицыПроизводства(Форма, Объект.Ингредиенты, ТекущееБлюдо, СтрокаНовыйИнгредиент);
			
			Если питИзменениеФактаВПроизводствеКлиентСервер.ТекущийИнгредиентЯвляетсяПолуфабрикатом(ТекущийИнгредиент) Тогда
				
				// Защита от зацикливания
				Если НЕ ОбработанныеИнгредиенты.Найти(ТекущийИнгредиент) = Неопределено Тогда
					ОбщегоНазначения.СообщитьПользователю("Обнаружено зацикливание при обновлении фактического количества по ингредиенту <" + ТекущийИнгредиент.Ингредиент + ">");
					Продолжить;
				КонецЕсли;
				ОбработанныеИнгредиенты.Добавить(ТекущийИнгредиент);
				
				// Поиск блюда по добавленному ингредиенту и его добавление, если не найдено.
				НайтиДобавитьБлюдоПоИнгредиенту(Форма, ТекущийИнгредиент);
				// Обновление порядка в таблице блюд.
				ОбновитьПорядокБлюдПоИнгредиенту(Форма, ТекущийИнгредиент, ТекущееБлюдо.Порядок);
				// Обрабатываем рекурсивно изменение количества ингредиента, который является полуфабрикатом.
				ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(Форма, ТекущийИнгредиент, Неопределено, Истина, ТаблицаДляРаспределения, ИзменятьИзмененные, Ложь, ОбработанныеИнгредиенты);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	// Установка нового количества блюда(в режиме нехватающие заготовки может стать меньше, 
	// т.к. блюдо есть на остатках).
	// НовоеКоличествоБлюда = 0;
	// НовоеКоличествоУпаковокБлюда = 0;
	// Если МассивИнгредиентовНовых.Количество() Тогда
	// 	НовоеКоличествоБлюда = МассивИнгредиентовНовых[0].КоличествоНоменклатуры;
	// 	НовоеКоличествоУпаковокБлюда = МассивИнгредиентовНовых[0].КоличествоУпаковокНоменклатуры;
	// КонецЕсли;
	// ТекущееБлюдо.КоличествоНоменклатуры = НовоеКоличествоБлюда;
	// ТекущееБлюдо.КоличествоУпаковокНоменклатуры = НовоеКоличествоУпаковокБлюда;
	ИнгредиентыИзАвтопеределовПоБлюду = НайтиИнгредиентыИзАвтопеределовПоБлюду(Форма, Объект.Ингредиенты, ТекущееБлюдо);
	КоличествоДляРасчета = 0;
	КоличествоУпаковокДляРасчета = 0;
	Для каждого ТекИнгредиент Из ИнгредиентыИзАвтопеределовПоБлюду Цикл
		Если ЗначениеЗаполнено(ТекИнгредиент.РецептураАвтопередела) И ТекИнгредиент.ПриготовлениеРазрешено Тогда
			КоличествоДляРасчета = КоличествоДляРасчета + ТекИнгредиент.КоличествоИнгредиентаФакт;
			КоличествоУпаковокДляРасчета = КоличествоУпаковокДляРасчета + ТекИнгредиент.КоличествоУпаковокИнгредиентаФакт;
		КонецЕсли;
	КонецЦикла;
	ТекущееБлюдо.КоличествоНоменклатуры = КоличествоДляРасчета;
	ТекущееБлюдо.КоличествоУпаковокНоменклатуры = КоличествоУпаковокДляРасчета;
	
	Если КоличествоДляРасчета = 0 Тогда
//   Блюдо перестало готовиться(т.к. оно уже есть на остатках), удалим его из приготовляемых, а везде где оно
// используется.
		// поставим ИзАвтопеределов = Ложь
		УдалитьБлюдоИзПриготовляемых(Форма, ТекущееБлюдо, МассивИнгредиентовТекущих);
	КонецЕсли;
	
	Если НЕ ЭтоИзменениеФактаБлюда Тогда
		// Меняем предыдущее количество ингредиента на текущее.
		УстановитьПредыдущееСостояниеИнгредиентаВТекущее(СтрокаИнгредиент);
	КонецЕсли;
	
КонецПроцедуры

// Процедура обновляет порядок блюд по ингредиенту.
//  Если порядок меньше переданного, то он устанавливается на новый и функция вызывается рекурсивно.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтрокаИнгредиент - ДанныеФормыЭлементКоллекции - Строка ингредиента, который инициализировал обновление порядка.
//  ПорядокБлюда - Число - Порядок блюда, в состав которого входит текущий ингредиент.
//  ОбработанныеИнгредиенты - Произвольный - Обработанные ингредиенты.
//
Процедура ОбновитьПорядокБлюдПоИнгредиенту(Форма, СтрокаИнгредиент, ПорядокБлюда, ОбработанныеИнгредиенты = Неопределено) Экспорт
	
	// Защита от зацикливания.
	Если ОбработанныеИнгредиенты = Неопределено Тогда
		ОбработанныеИнгредиенты = Новый Массив;
	КонецЕсли;
	
	// Получаем таблицы блюд и ингредиентов из формы.
	Объект = Форма.Объект;
	Блюда = Объект.Блюда;
	Ингредиенты = Объект.Ингредиенты;
	
	// Поиск строки в ТЧ "Блюда", соответствующей текущему ингредиенту "ИзАвтопеределов"
	ТекущееБлюдо = НайтиБлюдоПоИнгредиентуИзАвтопеределов(Форма, Блюда, СтрокаИнгредиент);
	Если НЕ ТекущееБлюдо = Неопределено Тогда
		Если ТекущееБлюдо.Порядок <= ПорядокБлюда Тогда
			СмещениеУровня = ПорядокБлюда - ТекущееБлюдо.Порядок + 1;
			ТекущееБлюдо.Порядок = ТекущееБлюдо.Порядок + СмещениеУровня;
			НайденныеИнгредиенты = Ингредиенты.НайтиСтроки(Новый Структура("ИдентификаторБлюда,ИзАвтопеределов", ТекущееБлюдо.ИдентификаторСтроки, Истина));
			Для каждого ТекИнгредиент Из НайденныеИнгредиенты Цикл
				
				// Защита от зацикливания
				Если НЕ ОбработанныеИнгредиенты.Найти(ТекИнгредиент) = Неопределено Тогда
					ОбщегоНазначения.СообщитьПользователю("Обнаружено зацикливание при обновлении порядка по ингредиенту <" + ТекИнгредиент.Ингредиент + ">");
					Продолжить;
				КонецЕсли;
				
				// Защита от зацикливания
				ОбработанныеИнгредиенты.Добавить(ТекИнгредиент);
				
				// Рекурсивный вызов
				ОбновитьПорядокБлюдПоИнгредиенту(Форма, ТекИнгредиент, ТекущееБлюдо.Порядок, ОбработанныеИнгредиенты);
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция добавляет новый ингредиент в ТЧ "Ингредиенты" документа по переданной структуре данных.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма документа, в котором происходит добавление ингредиента.
//  Ингредиенты - ДанныеФормыКоллекция - Табличная часть "Ингредиенты".
//  СтруктураДанных - Структура - Структура со значениями, которыми необходимо заполнить новую строку ТЧ.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - Добавленный ингредиент.
Функция ДобавитьИнгредиентПоСтруктуреДанных(Форма, Ингредиенты, СтруктураДанных) Экспорт
	
	// Новая строка не была среди найденных, значит ее не было раньше. Добавляем.
	ТекущийИнгредиент = Ингредиенты.Добавить();
	ЗаполнитьЗначенияСвойств(ТекущийИнгредиент, СтруктураДанных);
	
	// Заполняем дополнительные типовые колонки
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Ингредиент", "ХарактеристикиИспользуются"));
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущийИнгредиент, СтруктураДействий, КэшированныеЗначенияЛокальные);
	// Заполняем дополнительные отраслевые колонки
	ПараметрыОбъекта = Новый Структура("ХозяйственнаяОперация, Организация, Дата, Ссылка, Подразделение, Склад");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Форма);
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Форма.Объект);
	ПараметрыОбъекта.Вставить("СпособРасчетаРецептуры", Форма.СпособРасчетаРецептуры);
	питИзменениеФактаВПроизводствеВызовСервера.ИнгредиентыИнгредиентПриИзмененииНаСервере(ТекущийИнгредиент, ПараметрыОбъекта);
	
	Возврат ТекущийИнгредиент;
	
КонецФункции

// Процедура инициализирует реквизиты с именами колонок реквизитов табличных частей формы.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, имена колонок которой инициализируем.
//
Процедура ИнициализироватьИменаКолонокРеквизитов(Форма) Экспорт
	
	Форма.ИменаКолонокИнгредиенты.ЗагрузитьЗначения(ИменаРеквизитовРеквизита(Форма, "Объект.Ингредиенты"));
	Форма.ИменаКолонокБлюда.ЗагрузитьЗначения(ИменаРеквизитовРеквизита(Форма, "Объект.Блюда"));
	Форма.ИменаКолонокТовары.ЗагрузитьЗначения(ИменаРеквизитовРеквизита(Форма, "Объект.Товары"));
	
КонецПроцедуры

// Процедура устанавливает изменение факта блюда для переданного блюда и всех вышестоящих блюд.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой происходит изменение факта блюда.
//  ТекущееБлюдо - ДанныеФормыЭлементКоллекции - Строка блюда, для которой устанавливаем изменение факта.
//
Процедура УстановитьИзменениеФактаБлюда(Форма, ТекущееБлюдо) Экспорт
	
	// Проверяем наличие переданной строки текущего блюда.
	Если ТекущееБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем изменен факт блюда.
	ТекущееБлюдо.ИзмененФактБлюда = Истина;
	
	// Если блюдо не автопередел, то изменим флаг у связанного с ним товара.
	Если НЕ ТекущееБлюдо.Автопередел Тогда
		ТекущийТовар = НайтиТоварПоБлюду(Форма, Форма.Объект.Товары, ТекущееБлюдо);
		Если НЕ ТекущийТовар = Неопределено Тогда
			ТекущийТовар.ИзмененФактБлюда = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Получение таблицы блюд и ингредиентов из формы.
	Ингредиенты = Форма.Объект.Ингредиенты;
	Блюда = Форма.Объект.Блюда;
	
	// Поиск ингредиентов, соответствующих текущему блюду.
	НайденныеИнгредиенты = питИзменениеФактаВПроизводстве.НайтиИнгредиентыИзАвтопеределовПоБлюду(Форма, Ингредиенты, ТекущееБлюдо);
	Для каждого НайденныеИнгредиент Из НайденныеИнгредиенты Цикл
		
		// Поиск блюда ингредиента
		БлюдоИнгредиента = НайтиБлюдоИнгредиента(Блюда, НайденныеИнгредиент);
		
		// Рекурсивный вызов для найденного блюда.
		УстановитьИзменениеФактаБлюда(Форма, БлюдоИнгредиента);
		
	КонецЦикла;
	
КонецПроцедуры

// Функция определяет, есть ли в переданных таблицах измененные блюда.
//
// Параметры:
//  Блюда - ДанныеФормыКоллекция, ТабличнаяЧасть - Табличная часть "Блюда".
//  Товары - Произвольный - Товары.
//
// Возвращаемое значение:
//  Булево - Есть изменные блюда.
Функция ЕстьИзмененныеБлюдаТовары(Блюда = Неопределено, Товары = Неопределено) Экспорт
	
	ЕстьИзмененныеБлюда = Ложь;
	
	Если НЕ Блюда = Неопределено Тогда
		Для каждого ТекБлюдо Из Блюда Цикл
			Если ТекБлюдо.ИзмененФактБлюда Тогда
				ЕстьИзмененныеБлюда = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьИзмененныеБлюда Тогда
		Возврат ЕстьИзмененныеБлюда;
	КонецЕсли;
	
	Если НЕ Товары = Неопределено Тогда
		Для каждого ТекБлюдо Из Товары Цикл
			Если ТекБлюдо.ИзмененФактБлюда Тогда
				ЕстьИзмененныеБлюда = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьИзмененныеБлюда;
	
КонецФункции

// Функция ищет ингредиент в ТЧ ингредиенты по переданной структуре данных
//
// Параметры:
//  Ингредиенты - ДанныеФормыКоллекция - Табличная часть "Ингредиенты".
//  СтруктураДанных - Структура - Структура данных для поиска.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции - Найденный ингредиент.
Функция НайтиИнгредиентПоСтруктуреДанных(Ингредиенты, СтруктураДанных) Экспорт
	
	НайденныйИнгредиент = Неопределено;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("ИдентификаторБлюда"	, СтруктураДанных.ИдентификаторБлюда);
	СтруктураПоиска.Вставить("Ингредиент"			, СтруктураДанных.Ингредиент);
	СтруктураПоиска.Вставить("Характеристика"		, СтруктураДанных.Характеристика);
	СтруктураПоиска.Вставить("УпаковкаИнгредиента"	, СтруктураДанных.УпаковкаИнгредиента);
	НайденныеИнгредиенты = Ингредиенты.НайтиСтроки(СтруктураПоиска);
	Если НайденныеИнгредиенты.Количество() Тогда
		НайденныйИнгредиент = НайденныеИнгредиенты[0];
		Для каждого ТекНайденный Из НайденныеИнгредиенты Цикл
			Если ТекНайденный.ИзАвтопеределов Тогда
				// Если найдено несколько ингредиентов, то дополнительно пройдемся по ним 
				// и выберем ингредиент ИзАвтопеределов если такой есть.
				НайденныйИнгредиент = ТекНайденный;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НайденныйИнгредиент;
	
КонецФункции

// Функция получает таблицу производства по блюду.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой происходит расчет.
//  СтрокаБлюдо - ДанныеФормыЭлементКоллекции, Структура - Строка блюда, по которому заполняем производство.
//  КоличествоБлюда - Число - Количество блюда.
//  КоличествоУпаковокБлюда - Число - Количество упаковок блюда.
//  ИмяРеквизитаДанныеОбъекта - Строка - Имя реквизита формы, в котором содержатся данные объекта.
//  МассивДеревьевСостава - Массив - Массив деревьев состава.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица производства.
Функция ПолучитьТаблицуПроизводстваПоБлюду(Форма, СтрокаБлюдо, КоличествоБлюда, КоличествоУпаковокБлюда, ИмяРеквизитаДанныеОбъекта = "Объект", МассивДеревьевСостава = Неопределено) Экспорт
	
	// Получаем данные объекта из переданной формы.
	ДанныеОбъекта = Форма[ИмяРеквизитаДанныеОбъекта];
	
	Если ДанныеОбъекта.ВидПроизводства = Перечисления.питВидыПроизводства.ВсеПеределыОтдельнойОперацией
		И СтрокаБлюдо.Автопередел Тогда
		// Переделы не готовятся, а мы как раз пытаемся посчитать таблицу для передела.
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ИменаРеквизитовТаблицыБлюд = Форма.ИменаКолонокБлюда;
	
	// Расчет производства для нового значения количества автопередела.
	// Вызывается 1 раз, на самом верхнем уровне рекурсии только для того автопередела,
	// который изменил пользователь.
	СтруктураРасчетПроизводства = питПроизводство.СтруктураОбъектаРасчетПроизводства();
	СтруктураРасчетПроизводства.ТипДокумента	= ТипЗнч(ДанныеОбъекта.Ссылка);
	СтруктураРасчетПроизводства.Ссылка			= ДанныеОбъекта.Ссылка;
	СтруктураРасчетПроизводства.Дата			= ДанныеОбъекта.Дата;
	СтруктураРасчетПроизводства.Организация		= ДанныеОбъекта.Организация;
	СтруктураРасчетПроизводства.Подразделение	= ДанныеОбъекта.Подразделение;
	Если СтруктураРасчетПроизводства.ТипДокумента = Тип("ДокументСсылка.питПланМеню") Тогда
		СтруктураРасчетПроизводства.Склад			= ДанныеОбъекта.ЦеховаяКладовая;
	Иначе
		СтруктураРасчетПроизводства.Склад			= ДанныеОбъекта.Склад;
	КонецЕсли;
	СтруктураРасчетПроизводства.МоментВремени	= Новый МоментВремени(СтруктураРасчетПроизводства.Дата);
	// СтруктураРасчетПроизводства.ВидПроизводства	= ДанныеОбъекта.ВидПроизводства; 
	СтруктураРасчетПроизводства.ВидПроизводства	= Перечисления.питВидыПроизводства.ПеределыВнутриВыпуска;
	// Если НЕ СтрокаБлюдо.Автопередел Тогда
	// 	// Считаем блюдо, настройка переносится из шапки документа.
	// 	СтруктураРасчетПроизводства.УчитыватьОстаткиБлюдНаСкладе = ДанныеОбъекта.УчитыватьОстаткиБлюдНаСкладе;
//   ИначеЕсли питОбщегоНазначенияСервер.ВидыПроизводстваНехватающиеЗаготовки().Найти(ДанныеОбъекта.ВидПроизводства) =
// Неопределено Тогда.
	// 	// Стоит режим "Нехватающие заготовки" и текущая рассчитываемая строка является полуфабрикатом, поэтому ставим флаг
	// 	//  "Учитывать остатки блюд"
	// 	СтруктураРасчетПроизводства.УчитыватьОстаткиБлюдНаСкладе = Истина;
	// КонецЕсли;  
	СтруктураРасчетПроизводства.УчитыватьОстаткиБлюдНаСкладе = Ложь;
	НоваяСтрокаТовары = СтруктураРасчетПроизводства.Товары.Добавить();
	НоваяСтрокаТовары.Номенклатура			= СтрокаБлюдо.Номенклатура;
	НоваяСтрокаТовары.Характеристика		= СтрокаБлюдо.Характеристика;
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если ИменаРеквизитовТаблицыБлюд.НайтиПоЗначению("Серия") = Неопределено Тогда
		НоваяСтрокаТовары.Серия					= Справочники.СерииНоменклатуры.ПустаяСсылка();
	Иначе
		НоваяСтрокаТовары.Серия					= СтрокаБлюдо.Серия;
	КонецЕсли;
	Если ИменаРеквизитовТаблицыБлюд.НайтиПоЗначению("НазначениеИнгредиентов") = Неопределено Тогда
		НоваяСтрокаТовары.НазначениеИнгредиентов	= Справочники.Назначения.ПустаяСсылка();
	Иначе
		НоваяСтрокаТовары.НазначениеИнгредиентов	= СтрокаБлюдо.НазначениеИнгредиентов;
	КонецЕсли;
	НоваяСтрокаТовары.Назначение			= СтрокаБлюдо.Назначение;
	НоваяСтрокаТовары.Упаковка				= СтрокаБлюдо.УпаковкаНоменклатуры;
	НоваяСтрокаТовары.Рецептура				= СтрокаБлюдо.Рецептура;
	НоваяСтрокаТовары.ИдентификаторСтроки	= СтрокаБлюдо.ИдентификаторСтроки;
	// Новое значение количества полуфабриката
	// НоваяСтрокаТовары.Количество			= СтрокаБлюдо.КоличествоНоменклатуры;
	// НоваяСтрокаТовары.КоличествоУпаковок	= СтрокаБлюдо.КоличествоУпаковокНоменклатуры;
	НоваяСтрокаТовары.Количество			= КоличествоБлюда;
	НоваяСтрокаТовары.КоличествоУпаковок	= КоличествоУпаковокБлюда;
	// Заполнение таблицы производства.
	ТаблицаДляРаспределения = питПроизводство.ЗаполнитьПроизводственныеТаблицыПоРецептуре(СтруктураРасчетПроизводства, Истина,,,МассивДеревьевСостава);
	
	Возврат ТаблицаДляРаспределения;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура - Обновить количества ингредиента с учетом замен по строке производства.
//
// Параметры:
//  ТекущийИнгредиент - Произвольный - Текущий ингредиент.
//  ТекущийИнгредиентИзЗаготовок - Произвольный - Текущий ингредиент из заготовок.
//  ТекущееБлюдо - Произвольный - Текущее блюдо.
//  Замены - Произвольный - Замены.
//  СтрокаПроизводства - Строка - Строка производства.
//  ДельтаКоличествоФакт - Произвольный - Дельта количество факт.
//  ДельтаКоличествоУпаковокФакт - Произвольный - Дельта количество упаковок факт.
//  ЭтоИзменениеФактаБлюда - Произвольный - Это изменение факта блюда.
//  УдалятьЗамены - Произвольный - Удалять замены.
//
Процедура ОбновитьКоличестваИнгредиентаСУчетомЗаменПоСтрокеПроизводства(ТекущийИнгредиент, ТекущийИнгредиентИзЗаготовок, ТекущееБлюдо, Замены, СтрокаПроизводства, ДельтаКоличествоФакт, ДельтаКоличествоУпаковокФакт, ЭтоИзменениеФактаБлюда, УдалятьЗамены)
	
	// Ищем замены, соответствующие текущему ингредиенту и блюду.
	НайденныеЗамены = НайтиЗаменыПоИнгредиентуИБлюду(Замены, ТекущийИнгредиент, ТекущееБлюдо);
	Если УдалятьЗамены Тогда
		// Удаление замен, если требуется
		УдалитьЗаменыПоИнгредиенту(Замены, НайденныеЗамены, ТекущийИнгредиент);
		// Очищаем массив найденных замен.
		НайденныеЗамены.Очистить();
	КонецЕсли;
	
	// Обновление рецептуры блюда у найденных замен
	Для каждого ТекущаяЗамена Из НайденныеЗамены Цикл
		ТекущаяЗамена.Рецептура = ТекущееБлюдо.Рецептура;
	КонецЦикла;
	
	Если ЭтоИзменениеФактаБлюда Тогда
//   Для изменения факта блюда старое количество полностью заменяем на найденное новое количество(т.к. изменение
// неконтекстное).
		ТекущийИнгредиент.КоличествоИнгредиентаФакт			= СтрокаПроизводства.КоличествоИнгредиентаНорма;
		ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт	= СтрокаПроизводства.КоличествоУпаковокИнгредиентаНорма;
		Возврат;
	КонецЕсли;
	
	// Расчет дельты, на которую необходимо изменить количество ингредиента.
	ДельтаКоличествоИнгредиента			= НайтиДельтуИнгредиентаДляДельтыНоменклатурыПоСтрокеТаблицыПроизводства(СтрокаПроизводства, ДельтаКоличествоФакт, Ложь);
	ДельтаКоличествоУпаковокИнгредиента	= НайтиДельтуИнгредиентаДляДельтыНоменклатурыПоСтрокеТаблицыПроизводства(СтрокаПроизводства, ДельтаКоличествоУпаковокФакт, Истина);
	
	// Обходим замены с конца в начало и уменьшаем их количество, если дельта отрицательная.
	Индекс = НайденныеЗамены.Количество() - 1;
	СтрокиУдалить = Новый Массив;
	Пока Индекс >= 0 И ДельтаКоличествоУпаковокИнгредиента < 0 Цикл
		// Находим текущую строку замены по индексу.
		СтрокаЗамены = НайденныеЗамены[Индекс];
		
		// Находим коэффициент замены.
		КоэффициентЗамены = ?(СтрокаЗамены.КоличествоУпаковокИнгредиентаИсходный = 0, 1, СтрокаЗамены.КоличествоУпаковокИнгредиентаЗамена / СтрокаЗамены.КоличествоУпаковокИнгредиентаИсходный);
		
		// Определяем, на сколько необходимо уменьшить строку замены.
		УменьшитьКоличествоУпаковок	= Мин(-ДельтаКоличествоУпаковокИнгредиента, СтрокаЗамены.КоличествоУпаковокИнгредиентаИсходный);
		УменьшитьКоличество			= Мин(-ДельтаКоличествоИнгредиента, СтрокаЗамены.КоличествоИнгредиентаИсходный);
		
		// Уменьшаем количества в строке замены.
		СтрокаЗамены.КоличествоИнгредиентаИсходный			= СтрокаЗамены.КоличествоИнгредиентаИсходный - УменьшитьКоличество;
		СтрокаЗамены.КоличествоУпаковокИнгредиентаИсходный	= СтрокаЗамены.КоличествоУпаковокИнгредиентаИсходный - УменьшитьКоличествоУпаковок;
		СтрокаЗамены.КоличествоИнгредиентаЗамена			= СтрокаЗамены.КоличествоИнгредиентаЗамена - УменьшитьКоличество * КоэффициентЗамены;
		СтрокаЗамены.КоличествоУпаковокИнгредиентаЗамена	= СтрокаЗамены.КоличествоУпаковокИнгредиентаЗамена - УменьшитьКоличествоУпаковок * КоэффициентЗамены;
		
		// Уменьшаем факт замены в строке ингредиента.
		ТекущийИнгредиент.ФактЗамены = ТекущийИнгредиент.ФактЗамены - УменьшитьКоличествоУпаковок;
		
		// Если количество стало нулевым, то добавляем строку к удалению.
		Если СтрокаЗамены.КоличествоУпаковокИнгредиентаИсходный = 0 Тогда
			СтрокиУдалить.Добавить(СтрокаЗамены);
		КонецЕсли;
		
		// Увеличиваем дельту (т.к. она отрицательная)
		ДельтаКоличествоУпаковокИнгредиента	= ДельтаКоличествоУпаковокИнгредиента + УменьшитьКоличествоУпаковок;
		ДельтаКоличествоИнгредиента			= ДельтаКоличествоИнгредиента + УменьшитьКоличество;
		
		// Уменьшаем индекс строки (обход с конца).
		Индекс = Индекс - 1;
	КонецЦикла;
	
	// Удаление строк, которые были "обнулены".
	Для каждого СтрокаУдалить Из СтрокиУдалить Цикл
		Замены.Удалить(СтрокаУдалить);
	КонецЦикла;
	
	// Корректируем количество ингредиента на дельту (если что-то осталось).
	Если НЕ ТекущийИнгредиентИзЗаготовок = Неопределено Тогда
		КоличествоУпаковокИнгредиентаНовое		= ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт + ДельтаКоличествоУпаковокИнгредиента;
		КоличествоИнгредиентаФактНовое			= ТекущийИнгредиент.КоличествоИнгредиентаФакт + ДельтаКоличествоИнгредиента;
		Если ДельтаКоличествоУпаковокИнгредиента < 0 И КоличествоУпаковокИнгредиентаНовое < 0 Тогда
			ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаФакт	= Макс(0, ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаФакт + КоличествоУпаковокИнгредиентаНовое);
			ТекущийИнгредиентИзЗаготовок.КоличествоИнгредиентаФакт			= Макс(0, ТекущийИнгредиентИзЗаготовок.КоличествоИнгредиентаФакт + КоличествоИнгредиентаФактНовое);
		ИначеЕсли ДельтаКоличествоУпаковокИнгредиента > 0 И ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаНорма > ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаФакт Тогда
			ДобавитьДоНормыУпаковок = ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаНорма - ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаФакт;
			ДобавитьДоНормы = ТекущийИнгредиентИзЗаготовок.КоличествоИнгредиентаНорма - ТекущийИнгредиентИзЗаготовок.КоличествоИнгредиентаФакт;
			ДобавитьУпаковок = Мин(ДобавитьДоНормыУпаковок, ДельтаКоличествоУпаковокИнгредиента); 
			Добавить = Мин(ДобавитьДоНормы, ДельтаКоличествоИнгредиента);
			ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаФакт	= ТекущийИнгредиентИзЗаготовок.КоличествоУпаковокИнгредиентаФакт + ДобавитьУпаковок;
			ТекущийИнгредиентИзЗаготовок.КоличествоИнгредиентаФакт			= ТекущийИнгредиентИзЗаготовок.КоличествоИнгредиентаФакт + Добавить;
			ДельтаКоличествоУпаковокИнгредиента	= ДельтаКоличествоУпаковокИнгредиента - ДобавитьУпаковок;
			ДельтаКоличествоИнгредиента	= ДельтаКоличествоИнгредиента - Добавить;
		КонецЕсли;
	КонецЕсли;
	ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт	= Макс(0, ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт + ДельтаКоличествоУпаковокИнгредиента);
	ТекущийИнгредиент.КоличествоИнгредиентаФакт			= Макс(0, ТекущийИнгредиент.КоличествоИнгредиентаФакт + ДельтаКоличествоИнгредиента);
	
КонецПроцедуры

// Процедура - Установить предыдущее состояние ингредиента в текущее.
//
// Параметры:
//  СтрокаИнгредиент - Строка - Строка ингредиент.
//
Процедура УстановитьПредыдущееСостояниеИнгредиентаВТекущее(СтрокаИнгредиент)
	// Меняем предыдущее количество ингредиента на текущее.
	СтрокаИнгредиент.КоличествоУпаковокИнгредиентаФактПред	= СтрокаИнгредиент.КоличествоУпаковокИнгредиентаФакт;
	СтрокаИнгредиент.КоличествоИнгредиентаФактПред			= СтрокаИнгредиент.КоличествоИнгредиентаФакт;
	СтрокаИнгредиент.РецептураАвтопеределаПред				= СтрокаИнгредиент.РецептураАвтопередела;
КонецПроцедуры

// Функция - Найти блюдо по ингредиенту из автопеределов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Блюда - Произвольный - Блюда.
//  СтрокаИнгредиент - Строка - Строка ингредиент.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиБлюдоПоИнгредиентуИзАвтопеределов(Форма, Блюда, СтрокаИнгредиент)
	
	ИменаРеквизитовТаблицыБлюд = Форма.ИменаКолонокБлюда;
	
	// Поиск строки в ТЧ "Блюда", соответствующей текущему ингредиенту "ИзАвтопеределов"
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, УпаковкаНоменклатуры, Автопередел");
	СтруктураПоиска.Номенклатура = СтрокаИнгредиент.Ингредиент;
	СтруктураПоиска.Характеристика = СтрокаИнгредиент.Характеристика;
	СтруктураПоиска.УпаковкаНоменклатуры = СтрокаИнгредиент.УпаковкаИнгредиента;
	СтруктураПоиска.Автопередел = СтрокаИнгредиент.ИзАвтопеределов;
	
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если НЕ ИменаРеквизитовТаблицыБлюд.НайтиПоЗначению("Серия") = Неопределено Тогда
		СтруктураПоиска.Вставить("Серия", СтрокаИнгредиент.Серия);
	КонецЕсли;
	Если НЕ ИменаРеквизитовТаблицыБлюд.НайтиПоЗначению("Назначение") = Неопределено Тогда
		СтруктураПоиска.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
	КонецЕсли;
	
	МассивБлюд = Блюда.НайтиСтроки(СтруктураПоиска);
	Если МассивБлюд.Количество() Тогда
		ТекущееБлюдо = МассивБлюд[0];
	ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаИнгредиент.Ингредиент, "ЕдиницаИзмерения") = СтруктураПоиска.УпаковкаНоменклатуры Тогда
		СтруктураПоиска.УпаковкаНоменклатуры = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
		МассивБлюд = Блюда.НайтиСтроки(СтруктураПоиска);
		Если МассивБлюд.Количество() Тогда
			ТекущееБлюдо = МассивБлюд[0];
		Иначе
			ТекущееБлюдо = Неопределено;
		КонецЕсли;
	Иначе
		ТекущееБлюдо = Неопределено;
	КонецЕсли;
	
	Возврат ТекущееБлюдо;
	
КонецФункции

// Функция - Найти ингредиенты по блюду в таблице ингредиентов.
//
// Параметры:
//  Ингредиенты - Произвольный - Ингредиенты.
//  СтрокаБлюдо - Строка - Строка блюдо.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция НайтиИнгредиентыПоБлюдуВТаблицеИнгредиентов(Ингредиенты, СтрокаБлюдо)
	
	// Поиск строк в ТЧ "Ингредиенты", соответствующих текущему блюду из ТЧ "Блюда".
	СтруктураПоиска = Новый Структура("ИдентификаторБлюда", СтрокаБлюдо.ИдентификаторСтроки);
	МассивИнгредиентов = Ингредиенты.НайтиСтроки(СтруктураПоиска);
	
	Возврат МассивИнгредиентов;
	
КонецФункции

// Функция - Найти ингредиенты по блюду в таблице производства.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ТаблицаПроизводства - ТаблицаЗначений - Таблица производства.
//  СтрокаБлюдо - Строка - Строка блюдо.
//  Автопередел - Произвольный - Автопередел.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция НайтиИнгредиентыПоБлюдуВТаблицеПроизводства(Форма, ТаблицаПроизводства, СтрокаБлюдо, Автопередел)
	
	Если НЕ ТаблицаПроизводства.Количество() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ИменаРеквизитовТаблицыПоиска = Форма.ИменаКолонокБлюда;
	
	// Поиск строк ингредиентов в таблице производства, соответствующих текущему блюду из ТЧ "Блюда".
	СтруктураПоискаИнгредиентов = Новый Структура("Номенклатура,Характеристика,Рецептура");
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если НЕ ИменаРеквизитовТаблицыПоиска.НайтиПоЗначению("Серия") = Неопределено Тогда
		СтруктураПоискаИнгредиентов.Вставить("Серия");
	КонецЕсли;
	Если НЕ ИменаРеквизитовТаблицыПоиска.НайтиПоЗначению("Назначение") = Неопределено Тогда
		СтруктураПоискаИнгредиентов.Вставить("Назначение");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтруктураПоискаИнгредиентов, СтрокаБлюдо);
	СтруктураПоискаИнгредиентов.Вставить("ЕдиницаИзмеренияНоменклатуры", СтрокаБлюдо.УпаковкаНоменклатуры);
	СтруктураПоискаИнгредиентов.Вставить("Автопередел", Автопередел);
	МассивИнгредиентов = ТаблицаПроизводства.НайтиСтроки(СтруктураПоискаИнгредиентов);
	
	Возврат МассивИнгредиентов;
	
КонецФункции

// Функция - Найти ингредиент таблицы производства по ингредиенту и блюду из объекта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ТаблицаПроизводства - ТаблицаЗначений - Таблица производства.
//  СтрокаИнгредиент - Строка - Строка ингредиент.
//  СтрокаБлюдо - Строка - Строка блюдо.
//  Автопередел - Произвольный - Автопередел.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция НайтиИнгредиентТаблицыПроизводстваПоИнгредиентуИБлюдуИзОбъекта(Форма, ТаблицаПроизводства, СтрокаИнгредиент, СтрокаБлюдо, Автопередел)
	
	НайденныйИнгредиент = Неопределено;
	
	Если НЕ ТаблицаПроизводства.Количество() Тогда
		Возврат НайденныйИнгредиент;
	КонецЕсли;
	
	ИменаРеквизитовТаблицыПоиска = Форма.ИменаКолонокБлюда;
	
	// Структура поиска по совпадению с текущим блюдом.
	СтруктураПоискаИнгредиентов = Новый Структура("Номенклатура,Характеристика,Рецептура");
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если НЕ ИменаРеквизитовТаблицыПоиска.НайтиПоЗначению("Серия") = Неопределено Тогда
		СтруктураПоискаИнгредиентов.Вставить("Серия");
	КонецЕсли;
	Если НЕ ИменаРеквизитовТаблицыПоиска.НайтиПоЗначению("Назначение") = Неопределено Тогда
		СтруктураПоискаИнгредиентов.Вставить("Назначение");
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(СтруктураПоискаИнгредиентов, СтрокаБлюдо);
	СтруктураПоискаИнгредиентов.Вставить("ЕдиницаИзмеренияНоменклатуры"	, СтрокаБлюдо.УпаковкаНоменклатуры);
	СтруктураПоискаИнгредиентов.Вставить("Автопередел"					, Автопередел);
	// Структура поиска по совпадению с текущим ингредиентом.
	СтруктураПоискаИнгредиентов.Вставить("Ингредиент"					, СтрокаИнгредиент.Ингредиент);
	СтруктураПоискаИнгредиентов.Вставить("ХарактеристикаИнгредиента"	, СтрокаИнгредиент.Характеристика);
	СтруктураПоискаИнгредиентов.Вставить("НазначениеИнгредиента"		, СтрокаИнгредиент.Назначение);
	СтруктураПоискаИнгредиентов.Вставить("ЕдиницаИзмеренияИнгредиента"	, СтрокаИнгредиент.УпаковкаИнгредиента);
	СтруктураПоискаИнгредиентов.Вставить("ИзАвтопеределов"				, СтрокаИнгредиент.ИзАвтопеределов);
	
	МассивИнгредиентов = ТаблицаПроизводства.НайтиСтроки(СтруктураПоискаИнгредиентов);
	Если МассивИнгредиентов.Количество() Тогда
		НайденныйИнгредиент = МассивИнгредиентов[0];
	КонецЕсли;
	
	Возврат НайденныйИнгредиент;
	
КонецФункции

// Функция - Найти дельту ингредиента для дельты номенклатуры по строке таблицы производства.
//
// Параметры:
//  СтрокаТаблицыПроизводства - Строка - Строка таблицы производства.
//  ДельтаНоменклатуры - Произвольный - Дельта номенклатуры.
//  ПоКоличествуУпаковок - Произвольный - По количеству упаковок.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция НайтиДельтуИнгредиентаДляДельтыНоменклатурыПоСтрокеТаблицыПроизводства(СтрокаТаблицыПроизводства, ДельтаНоменклатуры, ПоКоличествуУпаковок)
	ДельтаКоличествоИнгредиента = 0;
	
	ПрефиксКолонок = ?(ПоКоличествуУпаковок, "КоличествоУпаковок", "Количество");
	
	Если СтрокаТаблицыПроизводства[ПрефиксКолонок + "Номенклатуры"] = питОбщегоНазначенияКлиентСервер.МодульЧисла(ДельтаНоменклатуры) Тогда
		ДельтаКоличествоИнгредиента = СтрокаТаблицыПроизводства[ПрефиксКолонок + "ИнгредиентаНорма"] * ?(ДельтаНоменклатуры < 0, -1, 1);
	ИначеЕсли СтрокаТаблицыПроизводства[ПрефиксКолонок + "Номенклатуры"] <> 0 Тогда
		ДельтаКоличествоИнгредиента = СтрокаТаблицыПроизводства[ПрефиксКолонок + "ИнгредиентаНорма"] / СтрокаТаблицыПроизводства[ПрефиксКолонок + "Номенклатуры"] * ДельтаНоменклатуры;
	КонецЕсли;
	
	Возврат ДельтаКоличествоИнгредиента;
КонецФункции

// Функция - Добавить ингредиент по блюду и строке таблицы производства.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Ингредиенты - Произвольный - Ингредиенты.
//  СтрокаБлюдо - Строка - Строка блюдо.
//  СтрокаНовыйИнгредиент - Строка - Строка новый ингредиент.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ДобавитьИнгредиентПоБлюдуИСтрокеТаблицыПроизводства(Форма, Ингредиенты, СтрокаБлюдо, СтрокаНовыйИнгредиент)
	
	ИменаРеквизитовТаблицыПоиска = Форма.ИменаКолонокИнгредиенты;
	
	// Новая строка не была среди найденных, значит ее не было раньше. Добавляем.
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ИдентификаторБлюда",					СтрокаБлюдо.ИдентификаторСтроки);
	СтруктураДанных.Вставить("Номенклатура",						СтрокаНовыйИнгредиент.Ингредиент);
	СтруктураДанных.Вставить("Характеристика",						СтрокаНовыйИнгредиент.ХарактеристикаИнгредиента);
	СтруктураДанных.Вставить("Назначение",							СтрокаНовыйИнгредиент.НазначениеИнгредиента);
	СтруктураДанных.Вставить("Ингредиент",							СтрокаНовыйИнгредиент.Ингредиент);
	СтруктураДанных.Вставить("УпаковкаИнгредиента",					СтрокаНовыйИнгредиент.ЕдиницаИзмеренияИнгредиента);
	СтруктураДанных.Вставить("ИзАвтопеределов",						СтрокаНовыйИнгредиент.ИзАвтопеределов);
	СтруктураДанных.Вставить("РецептураАвтопередела",				СтрокаНовыйИнгредиент.РецептураАвтопередела);
	СтруктураДанных.Вставить("КоличествоУпаковокИнгредиентаНорма",	0);
	СтруктураДанных.Вставить("КоличествоИнгредиентаНорма",			0);
	СтруктураДанных.Вставить("КоличествоУпаковокИнгредиентаФакт",	СтрокаНовыйИнгредиент.КоличествоУпаковокИнгредиентаНорма);
	СтруктураДанных.Вставить("КоличествоИнгредиентаФакт",			СтрокаНовыйИнгредиент.КоличествоИнгредиентаНорма);
	СтруктураДанных.Вставить("СтатьяКалькуляции",					СтрокаНовыйИнгредиент.СтатьяКалькуляции);
	// В Выпуске блюд и плане-меню некоторые реквизиты могут различаться, поэтому используем поиск по имени колонки.
	Если НЕ ИменаРеквизитовТаблицыПоиска.НайтиПоЗначению("Серия") = Неопределено Тогда
		СтруктураДанных.Вставить("Серия",							СтрокаНовыйИнгредиент.Серия);
	КонецЕсли;
	СтруктураДанных.Вставить("СезонныйПроцент",						СтрокаНовыйИнгредиент.СезонныйПроцент);
	СтруктураДанных.Вставить("ЗапретитьЗамены",						СтрокаНовыйИнгредиент.ЗапретитьЗамены);
	// СтатусУказанияСерий
	
	ТекущийИнгредиент = ДобавитьИнгредиентПоСтруктуреДанных(Форма, Ингредиенты, СтруктураДанных);
	
	Возврат ТекущийИнгредиент;
	
КонецФункции

// Функция - Найти замены по ингредиенту и блюду.
//
// Параметры:
//  Замены - Произвольный - Замены.
//  ТекущийИнгредиент - Произвольный - Текущий ингредиент.
//  ТекущееБлюдо - Произвольный - Текущее блюдо.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиЗаменыПоИнгредиентуИБлюду(Замены, ТекущийИнгредиент, ТекущееБлюдо)
	
	Если ТекущийИнгредиент.ФактЗамены = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура();
	// Связь с блюдом.
	СтруктураПоиска.Вставить("Блюдо"								, ТекущееБлюдо.Номенклатура);
	СтруктураПоиска.Вставить("ХарактеристикаБлюда"					, ТекущееБлюдо.Характеристика);
	СтруктураПоиска.Вставить("Автопередел"							, ТекущееБлюдо.Автопередел);
	// Связь с ингредиентом.
	СтруктураПоиска.Вставить("ИнгредиентИсходный"					, ТекущийИнгредиент.Ингредиент);
	СтруктураПоиска.Вставить("ХарактеристикаИнгредиентаИсходного"	, ТекущийИнгредиент.Характеристика);
	СтруктураПоиска.Вставить("НазначениеИнгредиентаИсходного"		, ТекущийИнгредиент.Назначение);
	СтруктураПоиска.Вставить("УпаковкаИнгредиентаИсходный"			, ТекущийИнгредиент.УпаковкаИнгредиента);
	
	НайденныеЗамены = Замены.НайтиСтроки(СтруктураПоиска);
	
	Возврат НайденныеЗамены;
	
КонецФункции

// Функция - Удалить замены по ингредиенту.
//
// Параметры:
//  Замены - Произвольный - Замены.
//  УдаляемыеЗамены - Произвольный - Удаляемые замены.
//  ТекущийИнгредиент - Произвольный - Текущий ингредиент.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция УдалитьЗаменыПоИнгредиенту(Замены, УдаляемыеЗамены, ТекущийИнгредиент)
	
	// Увеличиваем количество упаковок факт.
	ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт = ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт + ТекущийИнгредиент.ФактЗамены;
	ТекущийИнгредиент.КоличествоИнгредиентаФакт = ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекущийИнгредиент.Ингредиент, ТекущийИнгредиент.УпаковкаИнгредиента);
	// Обнуляем факт замены у ингредиента.
	ТекущийИнгредиент.ФактЗамены = 0;
	
	Для каждого НайденнаяЗамена Из УдаляемыеЗамены Цикл
		// Удаляем строку замен.
		Замены.Удалить(НайденнаяЗамена);
	КонецЦикла;
	
КонецФункции

// Функция - Найти блюдо по замене.
//
// Параметры:
//  Блюда - Произвольный - Блюда.
//  СтрокаЗамена - Строка - Строка замена.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиБлюдоПоЗамене(Блюда, СтрокаЗамена)
	
	НайденноеБлюдо = Неопределено;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Номенклатура"		, СтрокаЗамена.Блюдо);
	СтруктураПоиска.Вставить("Характеристика"	, СтрокаЗамена.ХарактеристикаБлюда);
	СтруктураПоиска.Вставить("Автопередел"		, СтрокаЗамена.Автопередел);
	НайденныеБлюда = Блюда.НайтиСтроки(СтруктураПоиска);
	Если НайденныеБлюда.Количество() Тогда
		НайденноеБлюдо = НайденныеБлюда[0];
	КонецЕсли;
	
	Возврат НайденноеБлюдо;
	
КонецФункции

// Функция - Найти ингредиент по блюду и замене.
//
// Параметры:
//  Ингредиенты - Произвольный - Ингредиенты.
//  СтрокаБлюдо - Строка - Строка блюдо.
//  СтрокаЗамена - Строка - Строка замена.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиИнгредиентПоБлюдуИЗамене(Ингредиенты, СтрокаБлюдо, СтрокаЗамена)
	
	НайденныйИнгредиент = Неопределено;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("ИдентификаторБлюда"	, СтрокаБлюдо.ИдентификаторСтроки);
	СтруктураПоиска.Вставить("Ингредиент"			, СтрокаЗамена.ИнгредиентИсходный);
	СтруктураПоиска.Вставить("Характеристика"		, СтрокаЗамена.ХарактеристикаИнгредиентаИсходного);
	СтруктураПоиска.Вставить("Назначение"			, СтрокаЗамена.НазначениеИнгредиентаИсходного);
	СтруктураПоиска.Вставить("УпаковкаИнгредиента"	, СтрокаЗамена.УпаковкаИнгредиентаИсходный);
	НайденныеИнгредиенты = Ингредиенты.НайтиСтроки(СтруктураПоиска);
	Если НайденныеИнгредиенты.Количество() Тогда
		НайденныйИнгредиент = НайденныеИнгредиенты[0];
	КонецЕсли;
	
	Возврат НайденныйИнгредиент;
	
КонецФункции

// Функция - Найти ингредиент из заготовок по переделу.
//
// Параметры:
//  Ингредиенты - Произвольный - Ингредиенты.
//  СтрокаИнгредиентаПередела - Строка - Строка ингредиента передела.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НайтиИнгредиентИзЗаготовокПоПеределу(Ингредиенты, СтрокаИнгредиентаПередела)
	
	НайденныйИнгредиент = Неопределено;
	
	Если НЕ питИзменениеФактаВПроизводствеКлиентСервер.ТекущийИнгредиентЯвляетсяПолуфабрикатом(СтрокаИнгредиентаПередела) Тогда
		Возврат НайденныйИнгредиент;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("ИдентификаторБлюда"	, СтрокаИнгредиентаПередела.ИдентификаторБлюда);
	СтруктураПоиска.Вставить("Ингредиент"			, СтрокаИнгредиентаПередела.Ингредиент);
	СтруктураПоиска.Вставить("Характеристика"		, СтрокаИнгредиентаПередела.Характеристика);
	СтруктураПоиска.Вставить("Назначение"			, СтрокаИнгредиентаПередела.Назначение);
	СтруктураПоиска.Вставить("УпаковкаИнгредиента"	, СтрокаИнгредиентаПередела.УпаковкаИнгредиента);
	СтруктураПоиска.Вставить("ИзАвтопеределов"		, Ложь);
	НайденныеИнгредиенты = Ингредиенты.НайтиСтроки(СтруктураПоиска);
	Если НайденныеИнгредиенты.Количество() Тогда
		НайденныйИнгредиент = НайденныеИнгредиенты[0];
	КонецЕсли;
	
	Возврат НайденныйИнгредиент;
	
КонецФункции

// Функция получает имена реквизитов для переданной формы и пути к базовому реквизиту.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, реквизиты которой анализируются.
//  Путь - Строка - Путь к базовому реквизиту, может быть пустым, тогда получаем для всей формы.
//
// Возвращаемое значение:
//  Массив - Массив имен реквизитов.
Функция ИменаРеквизитовРеквизита(Форма, Путь = Неопределено)
	
	ИменаКолонок = Новый Массив;
	Для каждого ТекРеквизит Из Форма.ПолучитьРеквизиты(Путь) Цикл
		ИменаКолонок.Добавить(ТекРеквизит.Имя);
	КонецЦикла;
	
	Возврат ИменаКолонок;
	
КонецФункции

// Функция - Блюдо перестало готовиться
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ТекущееБлюдо - Произвольный - Текущее блюдо.
//  МассивИнгредиентовИзОбъекта - Массив - Массив ингредиентов из таблицы ингредиентов по проверяемому блюду.
//
Процедура УдалитьБлюдоИзПриготовляемых(Форма, ТекущееБлюдо, МассивИнгредиентовИзОбъекта)
	Объект = Форма.Объект;
	// Удаляем текущие ингредиенты
	Для каждого ТекСтрока Из МассивИнгредиентовИзОбъекта Цикл
		Объект.Ингредиенты.Удалить(ТекСтрока);
	КонецЦикла;
	// Удаляем саму строку по блюду.
	Объект.Блюда.Удалить(ТекущееБлюдо);
КонецПроцедуры

#КонецОбласти





