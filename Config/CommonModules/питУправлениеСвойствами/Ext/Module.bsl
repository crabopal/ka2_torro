// +пит

// Функция получает таблицу отбор по свойствам.
//
// Параметры:
//  Рецептура - ДокументСсылка.питРецептура - Ссылка на рецептуру.
//  Подразделение - СправочникСсылка.СтруктураПредприятия - Ссылка на подразделение.
//  ИспользоватьПараметризацию - Булево - Признак использования параметризации.
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура-владелец свойств.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - Характеристика-владелец свойств.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результирующая таблица.
Функция ПолучитьТаблицуОтборПоСвойствам(Рецептура, Подразделение, ИспользоватьПараметризацию = Неопределено, Номенклатура = Неопределено, Характеристика = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОтборПоСвойствам();
	
	Запрос.УстановитьПараметр("Спецификация", Рецептура);
	Запрос.УстановитьПараметр("питПодразделениеРецептуры"	, Подразделение);
	
	Если Номенклатура = Неопределено Тогда
		РеквизитыРецептуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Рецептура, "Номенклатура, Характеристика");
		Запрос.УстановитьПараметр("Номенклатура"			, РеквизитыРецептуры.Номенклатура);
		Запрос.УстановитьПараметр("Характеристика"			, РеквизитыРецептуры.Характеристика);
	Иначе
		Запрос.УстановитьПараметр("Номенклатура"			, Номенклатура);
		Запрос.УстановитьПараметр("Характеристика"			, Характеристика);
	КонецЕсли;
	
	Если ИспользоватьПараметризацию = Неопределено Тогда
		ИспользоватьПараметризацию = 
		ПолучитьФункциональнуюОпцию("ИспользоватьПараметризациюРесурсныхСпецификаций");
	КонецЕсли;
	Запрос.УстановитьПараметр("ИспользоватьПараметризацию"	, ИспользоватьПараметризацию);
	
	РезультатТаблица = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатТаблица;
	
КонецФункции

// Функция получает текст запроса отбор по свойствам
//
// Параметры:
//  ИмяВременнойТаблицы - Строка - Имя временной таблицы, если не задано, то временная таблица не будет создана.
//
// Возвращаемое значение:
//  Строка - Текст запроса.
Функция ТекстЗапросаОтборПоСвойствам(ИмяВременнойТаблицы = "") Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	РесурсныеСпецификацииОтборПоСвойствам.КлючСвязи КАК КлючСвязи,
	|	РесурсныеСпецификацииОтборПоСвойствам.Свойство КАК Свойство,
	|	РесурсныеСпецификацииОтборПоСвойствам.Условие КАК Условие,
	|	РесурсныеСпецификацииОтборПоСвойствам.Значение КАК ЗначениеОтбор,
	|	ВЫБОР
	|		КОГДА РесурсныеСпецификацииОтборПоСвойствам.Свойство.Имя = ""питПодразделениеПроизводства""
	|			ТОГДА &питПодразделениеРецептуры
	|		ИНАЧЕ ЕСТЬNULL(ЕСТЬNULL(СвойстваХарактеристики.Значение, СвойстваНоменклатуры.Значение), ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(РесурсныеСпецификацииОтборПоСвойствам.Значение) = ТИП(БУЛЕВО)
	|						ТОГДА ЛОЖЬ
	|					КОГДА ТИПЗНАЧЕНИЯ(РесурсныеСпецификацииОтборПоСвойствам.Значение) = ТИП(ЧИСЛО)
	|						ТОГДА 0
	|					ИНАЧЕ НЕОПРЕДЕЛЕНО
	|				КОНЕЦ)
	|	КОНЕЦ КАК ЗначениеСвойства
	|ПОМЕСТИТЬ ВТОтборПоСвойствамНастройки
	|ИЗ
	|	Документ.питРецептура.ОтборПоСвойствам КАК РесурсныеСпецификацииОтборПоСвойствам
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК СвойстваНоменклатуры
	|		ПО РесурсныеСпецификацииОтборПоСвойствам.Свойство = СвойстваНоменклатуры.Свойство
	|			И (СвойстваНоменклатуры.Ссылка = &Номенклатура)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК СвойстваХарактеристики
	|		ПО РесурсныеСпецификацииОтборПоСвойствам.Свойство = СвойстваХарактеристики.Свойство
	|			И (СвойстваХарактеристики.Ссылка = &Характеристика)
	|ГДЕ
	|	РесурсныеСпецификацииОтборПоСвойствам.Ссылка = &Спецификация
	|	И &ИспользоватьПараметризацию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.КлючСвязи КАК КлючСвязи,
	|	МИНИМУМ(ВложенныйЗапрос.Используется) КАК Используется
	|%ТекстПоместить%
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТОтборПоСвойствамНастройки.КлючСвязи КАК КлючСвязи,
	|		ВЫБОР ВТОтборПоСвойствамНастройки.Условие
	|			КОГДА ""Равно""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства = ВТОтборПоСвойствамНастройки.ЗначениеОтбор
	|			КОГДА ""НеРавно""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства <> ВТОтборПоСвойствамНастройки.ЗначениеОтбор
	|			КОГДА ""Больше""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства > ВТОтборПоСвойствамНастройки.ЗначениеОтбор
	|			КОГДА ""БольшеИлиРавно""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства >= ВТОтборПоСвойствамНастройки.ЗначениеОтбор
	|			КОГДА ""Меньше""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства < ВТОтборПоСвойствамНастройки.ЗначениеОтбор
	|			КОГДА ""МеньшеИлиРавно""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства <= ВТОтборПоСвойствамНастройки.ЗначениеОтбор
	|			КОГДА ""ВСписке""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства В
	|						(ВЫБРАТЬ
	|							Т.ЗначениеОтбор КАК ЗначениеОтбор
	|						ИЗ
	|							ВТОтборПоСвойствамНастройки КАК Т
	|						ГДЕ
	|							Т.Условие = ""ВСписке""
	|							И Т.Свойство = ВТОтборПоСвойствамНастройки.Свойство
	|							И Т.КлючСвязи = ВТОтборПоСвойствамНастройки.КлючСвязи)
	|			КОГДА ""НеВСписке""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства <> ВТОтборПоСвойствамНастройки.ЗначениеОтбор
	|			КОГДА ""Заполнено""
	|				ТОГДА НЕ ВТОтборПоСвойствамНастройки.ЗначениеСвойства В (НЕОПРЕДЕЛЕНО, ЛОЖЬ, 0)
	|			КОГДА ""НеЗаполнено""
	|				ТОГДА ВТОтборПоСвойствамНастройки.ЗначениеСвойства В (НЕОПРЕДЕЛЕНО, ЛОЖЬ, 0)
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК Используется
	|	ИЗ
	|		ВТОтборПоСвойствамНастройки КАК ВТОтборПоСвойствамНастройки) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.КлючСвязи
	|
	|%ТочкаСЗапятой%
	|
	|";
	
	Если ПустаяСтрока(ИмяВременнойТаблицы) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТекстПоместить%", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТочкаСЗапятой%", "");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТекстПоместить%", " ПОМЕСТИТЬ "+ИмяВременнойТаблицы+" ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТочкаСЗапятой%", " ИНДЕКСИРОВАТЬ ПО КлючСвязи ; ");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

