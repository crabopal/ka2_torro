//
Функция ПолучитьЗначениеИзКэшаСоответствий(Параметры, ИмяСвойства)
	
	Результат = Параметры.КэшированныеЗначения.СоответствиеЭлементов.Получить(ИмяСвойства);
	Возврат Результат;
	
КонецФункции

