// ЗАПИСЬ

// Производит запись регистрации изменений.
//
// Параметры:
//  ЗаписьXML - Произвольный - Запись xml.
//  УзелОбмена - Произвольный - Узел обмена.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ЗаписатьИзменения(ЗаписьXML, УзелОбмена, ДопПараметры) 
	
	Событие = "УдаленныеКассы.Выгрузка.ЗаписьОбъекта";
	
	ТаблицаМетаданных = питОбменДаннымиПовтИсп.ПолучитьСтруктуруМетаданныхДляОбменов(Ложь, Истина, Неопределено);
	НомерСообщения = УзелОбмена.НомерОтправленного + 1;
	
	Если ДопПараметры.Свойство("ФиксироватьПоОбъекту") Тогда
		ФиксироватьПоОбъекту = ДопПараметры.ФиксироватьПоОбъекту;
	Иначе
		ФиксироватьПоОбъекту = Ложь;
		ДопПараметры.Вставить("ФиксироватьПоОбъекту", Ложь);
	КонецЕсли;
	
	НомерЗаписи = 0;
	
	ТипУдалениеОбъекта = Тип("УдалениеОбъекта");
	
	Попытка
	
		Для Каждого ТекСтрока Из ТаблицаМетаданных Цикл
			ДанныеСтруктурПолучены = Ложь;
			Выборка = ПланыОбмена.ВыбратьИзменения(УзелОбмена, НомерСообщения, ТекСтрока.Метаданные);
			Пока Выборка.Следующий() Цикл 
				Попытка
					Если Не ДанныеСтруктурПолучены Тогда 
						СтруктураОбъекта = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ТекСтрока.Дескриптор);
						КлассификаторОбъекта = питОбменДаннымиПовтИсп.ПолучитьИмяКлассификаторОбъекта(ТекСтрока.Метаданные.Имя);
						Если СтруктураОбъекта = Неопределено Тогда
							// Объекты данный типа не отправляется
							Прервать;
						КонецЕсли;
						ДанныеСтруктурПолучены = Истина;
					КонецЕсли;
					ОбъектЗаписи = Выборка.Получить();
					Если КлассификаторОбъекта = "Справочник" ИЛИ КлассификаторОбъекта = "Документ" Тогда 
						Если ТипЗнч(ОбъектЗаписи) = ТипУдалениеОбъекта Тогда
							ЗаписатьУдалениеОбъекта(ЗаписьXML, ОбъектЗаписи, ТекСтрока.Дескриптор);
						Иначе
							// Если указана функция проверки, то проверка на то, известен ли объект записи тек узлу КУ.
							ОбъектИзвестенУзлу = Истина;
							Если НЕ ПустаяСтрока(ТекСтрока.ИмяФункцииПроверкиОбъекта) Тогда
								Выполнить("ОбъектИзвестенУзлу = " + ТекСтрока.ИмяФункцииПроверкиОбъекта);
							КонецЕсли;
							
							Если НЕ ОбъектИзвестенУзлу Тогда
								ЗаписатьУдалениеОбъекта(ЗаписьXML, ОбъектЗаписи, ТекСтрока.Дескриптор);
							Иначе
								ЗаписатьОбъект(ЗаписьXML, ОбъектЗаписи, ТекСтрока.Дескриптор, СтруктураОбъекта, ФиксироватьПоОбъекту, КлассификаторОбъекта, ТекСтрока.Метаданные.Имя, ДопПараметры);
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли КлассификаторОбъекта = "РегистрСведений" Тогда 
						
						// Если указана функция проверки, то проверка на то, известен ли объект записи тек узлу КУ.
						ОбъектИзвестенУзлу = Истина;
						Если НЕ ПустаяСтрока(ТекСтрока.ИмяФункцииПроверкиОбъекта) И ОбъектЗаписи.Количество() > 0 Тогда
							Выполнить("ОбъектИзвестенУзлу = " + ТекСтрока.ИмяФункцииПроверкиОбъекта);
						КонецЕсли;
						
						// Если указана функция проверки, то проверка на то, известен ли объект записи тек узлу КУ.
						ПропуститьЗапись = Ложь;
						Если НЕ ПустаяСтрока(ТекСтрока.ИмяФункцииПропуститьЗапись) И ОбъектЗаписи.Количество() > 0 Тогда
							Выполнить("ПропуститьЗапись = " + ТекСтрока.ИмяФункцииПропуститьЗапись);
						КонецЕсли;
						
						Если НЕ ПропуститьЗапись Тогда
							Если ОбъектИзвестенУзлу И ОбъектЗаписи.Количество() > 0 Тогда
								ЗаписатьКоллекцию(ЗаписьXML, ОбъектЗаписи, ТекСтрока.Дескриптор, СтруктураОбъекта, ФиксироватьПоОбъекту);
							Иначе
								ЗаписатьУдалениеКоллекции(ЗаписьXML, ОбъектЗаписи, ТекСтрока.Дескриптор, СтруктураОбъекта);
							КонецЕсли;
						Иначе
							// Ничего не делаем
						КонецЕсли;
						
					Иначе
						// неизвестный науке зверь, запишем в книжечку, сразу в красную
						ТекстОшибки = "Обнаружен не поддерживаемый вид объектов <" + КлассификаторОбъекта + "> при выборке зарегистрированных изменений";
						Событие = "УдаленныеКассы.Выгрузка.ФормированиеСообщения";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , УзелОбмена, ТекстОшибки);
					КонецЕсли;
					
				Исключение
					ИнфОбОшибке = ИнформацияОбОшибке();
					ТекстОшибки = ИнфОбОшибке.Описание;
					Пока ИнфОбОшибке.Причина <> Неопределено Цикл
						ИнфОбОшибке = ИнфОбОшибке.Причина;
						ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
					КонецЦикла;
					Событие = "УдаленныеКассы.Выгрузка.ЗаписьОбъекта";
					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , ОбъектЗаписи, ТекстОшибки);
				КонецПопытки;
				
			КонецЦикла;
		КонецЦикла;
		
		ДопПараметры.Вставить("РезультатЗаписи", Истина);
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание + " [" + ИнфОбОшибке.ИмяМодуля + "(" + ИнфОбОшибке.НомерСтроки + ")]";
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "УдаленныеКассы.Выгрузка.ФормированиеСообщения";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Процедура записи объекта в XML сообщение
//
// Параметры:
//  ЗаписьXML - ЗаписьXML - Объект для записи XM.
//  Коллекция - РегистрСведенийНаборЗаписей - Объект который необходимо записать в XML сообщении.
//  ИмяКоллекции - Произвольный - Имя коллекции.
//  СтруктураКоллекции - Структура - Структура коллекции.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//
Процедура ЗаписатьКоллекцию(ЗаписьXML, Коллекция, ИмяКоллекции, СтруктураКоллекции, ФиксироватьПоОбъекту)
	
	БылаОшибка = Ложь;
	ЗаписьXML.ЗаписатьНачалоЭлемента("Collection");
	ЗаписьXML.ЗаписатьАтрибут("name", ИмяКоллекции);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
	
	Попытка
		Для Каждого ПараметрыРеквизита Из СтруктураКоллекции Цикл
			
			Если ПустаяСтрока(ПараметрыРеквизита.ИмяXML) Тогда
				// Значение данного сущности не отправляется
				Продолжить;
			КонецЕсли;
			
			ЗначениеРеквизитаОбъекта = Неопределено;
			
			Если ПараметрыРеквизита.Вид = "Изм" ИЛИ ПараметрыРеквизита.Вид = "Рес" ИЛИ ПараметрыРеквизита.Вид = "Рек" Тогда
				Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда
					Выполнить("ЗначениеРеквизитаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
				ИначеЕсли НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяМетаданные) Тогда
					ЗначениеРеквизитаОбъекта = Коллекция[0][ПараметрыРеквизита.ИмяМетаданные];
				Иначе
					// ничего не делаем
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначениеРеквизитаОбъекта) Тогда
					ЗначениеДляЗаписиВXML = питОбменДаннымиПовтИсп.ПолучитьЗначениеАтрибутаДляВыгрузки(ЗначениеРеквизитаОбъекта, ПараметрыРеквизита.ИмяМетаданные, 
						ПараметрыРеквизита.Тип, ПараметрыРеквизита.ИмяФункКонвертВыгр);
					ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, ЗначениеДляЗаписиВXML);
				ИначеЕсли ПараметрыРеквизита.ВыгружатьПустым = "1" Тогда
					// Доп.проверка
					Если ПараметрыРеквизита.Тип = "Число" Тогда 
						ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, "0");
					ИначеЕсли ПараметрыРеквизита.Тип = "Булево" Тогда
						// Пустое булево не бывает, так что лучше вообще не будем ничего писать в XML
					Иначе
						ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, "");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		БылаОшибка = Истина;
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "УдаленныеКассы.Выгрузка.ЗаписьКоллекции";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Collection
	
	Если ФиксироватьПоОбъекту И НЕ БылаОшибка Тогда
		Комментарий = "Запись коллекции <" + Коллекция + "> успешно завершена";
		Событие = "УдаленныеКассы.Выгрузка.ЗаписьКоллекции";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , , Комментарий);
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьКоллекцию()

// Процедура записи объекта в XML сообщение
//
// Параметры:
//  ЗаписьXML - ЗаписьXML - Объект для записи XM.
//  Объект - ЗаписьXML - Объект для записи XM.
//  ИмяОбъекта - Строка - Имя объекта.
//  СтруктураОбъекта - ТаблицаЗначений - Структура объекта.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//  КлассификаторОбъекта - Произвольный - Классификатор объекта.
//  ВидОбъекта - Произвольный - Вид объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ЗаписатьОбъект(ЗаписьXML, Объект, ИмяОбъекта, СтруктураОбъекта, ФиксироватьПоОбъекту, КлассификаторОбъекта, ВидОбъекта, ДопПараметры)
	
	БылаОшибка = Ложь;
	
	Если КлассификаторОбъекта = "Документ" Тогда
		ЭтоДокумент = Истина;
		ЭтоГруппа = Ложь;
	Иначе
		ЭтоДокумент = Ложь;
		ЭтоГруппа = Объект.ЭтоГруппа;
	КонецЕсли;
	
	СвойстваОбъектаЗаписаны = Ложь;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Object");
	ЗаписьXML.ЗаписатьАтрибут("name", ИмяОбъекта);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Properties");
	
	Попытка
		
		// Проверим наличие дополнительных функций обработки до записи объекта
		МассСтрокДопФункций = СтруктураОбъекта.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "1"));
		НомерФункции = 0;
		Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
			НомерФункции = НомерФункции + 1;
			Если (СтрСДопФункцией.Использование = "ГиЭ")
				ИЛИ((СтрСДопФункцией.Использование = "Г"))
				ИЛИ((СтрСДопФункцией.Использование = "Э")) Тогда
				// Попытаемся выполнить доп. функцию обработки заданную в макете
				Попытка 
					Выполнить(СтрСДопФункцией.ИмяФункПриВыгрузке);
				Исключение
					ИнфОбОшибке = ИнформацияОбОшибке();
					ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);
					Событие = "УдаленныеКассы.Выгрузка.ЗаписьОбъекта";
					ТекстОшибки = "Ошибка работы функции пред-обработки <" + СтрСДопФункцией.ИмяФункПриВыгрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
					ЗафиксироватьСобытие(Событие,ТекстОшибки,,УровеньЖурналаРегистрации.Ошибка, ДопПараметры.Комментировать);
					ДопПараметры.МассивОшибок.Добавить(ТекстОшибки);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ПараметрыРеквизита Из СтруктураОбъекта Цикл
			ЗначениеРеквизитаОбъекта = Неопределено;
			Если ПустаяСтрока(ПараметрыРеквизита.ИмяXML) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПараметрыРеквизита.Вид = "Рек" Тогда
				Если ПараметрыРеквизита.Использование = "ГиЭ" Тогда 
					Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда
						Выполнить("ЗначениеРеквизитаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
					ИначеЕсли ПустаяСтрока(ПараметрыРеквизита.ИмяМетаданные) Тогда
						// ничего не делаем
					ИначеЕсли ЭтоДокумент И питОбменДаннымиПовтИсп.ЕстьРеквизитШапкиДокумента(ПараметрыРеквизита.ИмяМетаданные, ВидОбъекта) Тогда
						ЗначениеРеквизитаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					ИначеЕсли НЕ ЭтоДокумент И питОбменДаннымиПовтИсп.ЕстьРеквизитСправочника(ПараметрыРеквизита.ИмяМетаданные, ВидОбъекта) Тогда
						ЗначениеРеквизитаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					Иначе
						// ничего не делаем
					КонецЕсли;
				ИначеЕсли ЭтоГруппа И ПараметрыРеквизита.Использование = "Г" Тогда 
					Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда
						Выполнить("ЗначениеРеквизитаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
					ИначеЕсли ПустаяСтрока(ПараметрыРеквизита.ИмяМетаданные) Тогда
						// ничего не делаем
					ИначеЕсли ЭтоДокумент И питОбменДаннымиПовтИсп.ЕстьРеквизитШапкиДокумента(ПараметрыРеквизита.ИмяМетаданные, ВидОбъекта) Тогда
						ЗначениеРеквизитаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					ИначеЕсли НЕ ЭтоДокумент И питОбменДаннымиПовтИсп.ЕстьРеквизитСправочника(ПараметрыРеквизита.ИмяМетаданные, ВидОбъекта) Тогда
						ЗначениеРеквизитаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					Иначе
						// ничего не делаем
					КонецЕсли;
				ИначеЕсли Не ЭтоГруппа И ПараметрыРеквизита.Использование = "Э" Тогда 
					Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда
						Выполнить("ЗначениеРеквизитаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
					ИначеЕсли ПустаяСтрока(ПараметрыРеквизита.ИмяМетаданные) Тогда
						// ничего не делаем
					ИначеЕсли ЭтоДокумент И питОбменДаннымиПовтИсп.ЕстьРеквизитШапкиДокумента(ПараметрыРеквизита.ИмяМетаданные, ВидОбъекта) Тогда
						ЗначениеРеквизитаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					ИначеЕсли НЕ ЭтоДокумент И питОбменДаннымиПовтИсп.ЕстьРеквизитСправочника(ПараметрыРеквизита.ИмяМетаданные, ВидОбъекта) Тогда
						ЗначениеРеквизитаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					Иначе
						// ничего не делаем
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначениеРеквизитаОбъекта) Тогда
					ЗначениеДляЗаписиВXML = питОбменДаннымиПовтИсп.ПолучитьЗначениеАтрибутаДляВыгрузки(ЗначениеРеквизитаОбъекта, ПараметрыРеквизита.ИмяМетаданные, ПараметрыРеквизита.Тип, ПараметрыРеквизита.ИмяФункКонвертВыгр);
					ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, ЗначениеДляЗаписиВXML);
				ИначеЕсли ПараметрыРеквизита.ВыгружатьПустым = "1" Тогда
					Если ПараметрыРеквизита.Тип = "Строка" ИЛИ ПараметрыРеквизита.Тип = "Ссылка" Тогда 
						ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, "");
					ИначеЕсли ПараметрыРеквизита.Тип = "Число" Тогда 
						ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, "0");
					КонецЕсли;
				КонецЕсли;
		
			ИначеЕсли ПараметрыРеквизита.Вид = "ТЧ" ИЛИ ПараметрыРеквизита.Вид = "Под" Тогда
				
				Если НЕ ЭтоГруппа И ПараметрыРеквизита.Использование = "Г"
					ИЛИ ЭтоГруппа И ПараметрыРеквизита.Использование = "Э" Тогда 
					Продолжить;
				КонецЕсли;
				
				СтруктураТаблицы = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ПараметрыРеквизита.ИмяXML);
				Если СтруктураТаблицы = Неопределено Тогда 
					Продолжить;
				КонецЕсли;
				ТаблицаОбъекта = Неопределено;
				Если Не СвойстваОбъектаЗаписаны Тогда 
					ЗаписьXML.ЗаписатьКонецЭлемента(); // Properties
					СвойстваОбъектаЗаписаны = Истина;
				КонецЕсли;
				Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда
					Выполнить("ТаблицаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
				ИначеЕсли ЭтоДокумент Тогда
					Если питОбменДаннымиПовтИсп.ЕстьТЧДокумента(ПараметрыРеквизита.ИмяМетаданные, ВидОбъекта) Тогда
						ТаблицаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					Иначе
						БрекПоинтТут = Истина;
					КонецЕсли;
				Иначе
					Попытка
						ТаблицаОбъекта = Объект[ПараметрыРеквизита.ИмяМетаданные];
					Исключение
						ТаблицаОбъекта = Неопределено;
					КонецПопытки;
				КонецЕсли;
				
				Если ТаблицаОбъекта = Неопределено Тогда
					// Попытка получение данных закончилась ошибкой
				ИначеЕсли (ТаблицаОбъекта.Количество() = 0) И (ПараметрыРеквизита.ВыгружатьПустым = "0") Тогда
					// Эту ТЧ не будем выгружать, потому что в макете сказано что не надо выгружать если пустая
				Иначе
					ЗаписатьТаблицуОбъекта(ЗаписьXML, ЭтоГруппа, Объект, ВидОбъекта, ТаблицаОбъекта, ПараметрыРеквизита.ИмяXML, СтруктураТаблицы, ДопПараметры);
				КонецЕсли;
			
			КонецЕсли;
		КонецЦикла;
	Исключение
		БылаОшибка = Истина;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = "УдаленныеКассы.Выгрузка.ЗаписьОбъекта";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Если НЕ СвойстваОбъектаЗаписаны Тогда
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Properties
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Object
	
	Если ФиксироватьПоОбъекту И НЕ БылаОшибка Тогда 
		Комментарий = "Запись объекта <" + Объект + "> успешно завершена";
		Событие = "УдаленныеКассы.Выгрузка.";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , , Комментарий);
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьОбъект

// Функция записывает удаление объекта в XML файл
//
// Параметры:
//  ЗаписьXML - ЗаписьXML - Объект для записи XM.
//  Коллекция - НаборЗаписей - Набор записей регистр.
//  ИмяКоллекции - Строка - Имя объекта из метаданных.
//  СтруктураКоллекции - Структура - Структура набора записей.
//
Процедура ЗаписатьУдалениеКоллекции(ЗаписьXML, Коллекция, ИмяКоллекции, СтруктураКоллекции)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Collection");
	
	Попытка
		ПараметрыУдаленияСтрокой = "";
		Для Каждого ПараметрыКоллекции Из СтруктураКоллекции Цикл
			Если ПустаяСтрока(ПараметрыКоллекции.ИмяXML) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПараметрыКоллекции.Вид = "Изм" Тогда
				Если ПустаяСтрока(ПараметрыКоллекции.ИмяФункПриВыгрузке) Тогда 
					Значение = Коллекция.Отбор[ПараметрыКоллекции.ИмяМетаданные].Значение;
				Иначе
					Выполнить("Значение = " + ПараметрыКоллекции.ИмяФункПриВыгрузке);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Значение) Тогда
					Значение = питОбменДаннымиПовтИсп.ПолучитьЗначениеАтрибутаДляВыгрузки(Значение, ПараметрыКоллекции.ИмяМетаданные, ПараметрыКоллекции.Тип, ПараметрыКоллекции.ИмяФункКонвертВыгр);
					ПараметрыУдаленияСтрокой = ПараметрыУдаленияСтрокой + ПараметрыКоллекции.ИмяXML + "=" + Значение + "; ";
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыУдаленияСтрокой = Лев(ПараметрыУдаленияСтрокой, СтрДлина(ПараметрыУдаленияСтрокой) - 2);
		ЗаписьXML.ЗаписатьАтрибут("name", ИмяКоллекции);
		ЗаписьXML.ЗаписатьАтрибут("clearcond", ПараметрыУдаленияСтрокой); 
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "УдаленныеКассы.Выгрузка.ЗаписьУдаления";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры // ЗаписатьУдалениеКоллекции()

// Процедура записи таблицы вложенной в объект
//
// Параметры:
//  ЗаписьXML - ЗаписьXML - Объект для записи XM.
//  ЭтоГруппа - Булево - Признак вида объекта
//   Объект			- СправочникОбъект либо ДокументОбъект
//   ВидОбъекта		- ИмяОбъекта как он задан в метаданных.
//  Объект - ЗаписьXML - Объект для записи XM.
//  ВидОбъекта - Произвольный - Вид объекта.
//  ТаблицаОбъекта - СправочникТабличнаяЧасть/ДокументТабличнаяЧасть - Табличная часть для записи.
//  ИмяТаблицы - Строка - Имя табличной части в XM.
//  СтруктураТаблицы - ТаблицаЗначений - Структура табличной части.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ЗаписатьТаблицуОбъекта(ЗаписьXML, ЭтоГруппа, Объект, ВидОбъекта, ТаблицаОбъекта, ИмяТаблицы, СтруктураТаблицы, ДопПараметры)
	
	Событие = "УдаленныеКассы.Выгрузка.ЗаписьТаблицыОбъекта";
	ЗаписьXML.ЗаписатьНачалоЭлемента("Link");
	ЗаписьXML.ЗаписатьАтрибут("name", ИмяТаблицы);
	ЗаписаноНачало = Ложь;
	
	Попытка
		Для Каждого ТекСтрока Из ТаблицаОбъекта Цикл
			
			ЗаписаноНачало = Ложь;
			ФлагПропустить = Ложь;
			
			// Проверим наличие дополнительных функций обработки до начала записи строки объекта в XML
			МассСтрокДопФункций = СтруктураТаблицы.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "1"));
			НомерФункции = 0;
			Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
				НомерФункции = НомерФункции + 1;
				Если НЕ ПустаяСтрока(СтрСДопФункцией.ИмяФункПриВыгрузке) 
					И (		(СтрСДопФункцией.Использование = "ГиЭ")
					ИЛИ((СтрСДопФункцией.Использование = "Г") И ЭтоГруппа)
					ИЛИ((СтрСДопФункцией.Использование = "Э") И НЕ ЭтоГруппа)) Тогда
					// Попытаемся выполнить доп. функцию обработки заданную в макете
					Попытка 
						Выполнить(СтрСДопФункцией.ИмяФункПриВыгрузке);
					Исключение
						ИнфОбОшибке = ИнформацияОбОшибке();
						ТекстОшибки = ИнфОбОшибке.Описание;
						Пока ИнфОбОшибке.Причина <> Неопределено Цикл
							ИнфОбОшибке = ИнфОбОшибке.Причина;
							ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
						КонецЦикла;
						ТекстОшибки = "Ошибка работы функции пред-обработки ТЧ <" + СтрСДопФункцией.ИмяФункПриВыгрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			
			Если ФлагПропустить Тогда
				Продолжить; // Эту строку ТЧ не нужно записывать в XML
			КонецЕсли;
			
			Для Каждого ПараметрыРеквизита Из СтруктураТаблицы Цикл
				
				Если ПустаяСтрока(ПараметрыРеквизита.ИмяXML) ИЛИ (ПараметрыРеквизита.Вид <> "Рек") Тогда
					Продолжить;
				КонецЕсли;
				
				ЗначениеРеквизитаОбъекта = НЕОПРЕДЕЛЕНО;
				
				Если ПараметрыРеквизита.Использование = "ГиЭ" Тогда 
					Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда 
						Выполнить("ЗначениеРеквизитаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
					ИначеЕсли НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяМетаданные) Тогда
						ЗначениеРеквизитаОбъекта = ТекСтрока[ПараметрыРеквизита.ИмяМетаданные];
					Иначе
						// тогда я не знаю что делать						
					КонецЕсли;
				ИначеЕсли ЭтоГруппа И ПараметрыРеквизита.Использование = "Г" Тогда 
					Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда 
					    Выполнить("ЗначениеРеквизитаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
					ИначеЕсли НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяМетаданные) Тогда
						ЗначениеРеквизитаОбъекта = ТекСтрока[ПараметрыРеквизита.ИмяМетаданные];
					Иначе
						// тогда я не знаю что делать						
					КонецЕсли;
				ИначеЕсли Не ЭтоГруппа И ПараметрыРеквизита.Использование = "Э" Тогда 
					Если НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяФункПриВыгрузке) Тогда 
						Выполнить("ЗначениеРеквизитаОбъекта = " + ПараметрыРеквизита.ИмяФункПриВыгрузке);
					ИначеЕсли НЕ ПустаяСтрока(ПараметрыРеквизита.ИмяМетаданные) Тогда
						ЗначениеРеквизитаОбъекта = ТекСтрока[ПараметрыРеквизита.ИмяМетаданные];
					Иначе
						// тогда я не знаю что делать						
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначениеРеквизитаОбъекта) Тогда
					
					Если НЕ ЗаписаноНачало Тогда
						ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
						ЗаписаноНачало = Истина;
					КонецЕсли;
					
					ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, питОбменДаннымиПовтИсп.ПолучитьЗначениеАтрибутаДляВыгрузки(ЗначениеРеквизитаОбъекта, ПараметрыРеквизита.ИмяМетаданные, ПараметрыРеквизита.Тип, ПараметрыРеквизита.ИмяФункКонвертВыгр));
					
				ИначеЕсли ПараметрыРеквизита.ВыгружатьПустым = "1" Тогда
					
					Если НЕ ЗаписаноНачало Тогда
						ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
						ЗаписаноНачало = Истина;
					КонецЕсли;
					
					Если ПараметрыРеквизита.Тип = "Число" Тогда 
						ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, "0");
					Иначе
						ЗаписьXML.ЗаписатьАтрибут(ПараметрыРеквизита.ИмяXML, "");
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла; // По реквизитам строки ТЧ
			
			// Проверим наличие дополнительных функций обработки перед окончанием записи строки объекта в XML
			МассСтрокДопФункций = СтруктураТаблицы.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "0"));
			НомерФункции = 0;
			Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
				НомерФункции = НомерФункции + 1;
				Если НЕ ПустаяСтрока(СтрСДопФункцией.ИмяФункПриВыгрузке) 
					И (		(СтрСДопФункцией.Использование = "ГиЭ")
					ИЛИ((СтрСДопФункцией.Использование = "Г") И ЭтоГруппа)
					ИЛИ((СтрСДопФункцией.Использование = "Э") И НЕ ЭтоГруппа)
					) Тогда
					// Попытаемся выполнить доп. функцию обработки заданную в макете
					Попытка 
						Выполнить(СтрСДопФункцией.ИмяФункПриВыгрузке);
					Исключение
						ИнфОбОшибке = ИнформацияОбОшибке();
						ТекстОшибки = ИнфОбОшибке.Описание;
						Пока ИнфОбОшибке.Причина <> Неопределено Цикл
							ИнфОбОшибке = ИнфОбОшибке.Причина;
							ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
						КонецЦикла;
						ТекстОшибки = "Ошибка работы функции пост-обработки ТЧ <" + СтрСДопФункцией.ИмяФункПриВыгрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			
			Если ЗаписаноНачало Тогда
				ЗаписьXML.ЗаписатьКонецЭлемента(); // </Item>
				ЗаписаноНачало = Ложь;
			КонецЕсли;
			
		КонецЦикла; // По строкам ТЧ
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Если ЗаписаноНачало Тогда
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Link
	
КонецПроцедуры // ЗаписатьТаблицуОбъекта


/////////////////////////////////////////////////////////////////////////
// ЧТЕНИЕ

// Функция выполняет чтение объекта
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - Обработчик XML сообщении.
//  ИмяОбъекта - Строка - Имя объекта в XML представлении.
//  АтрибутыИзXML - Произвольный - Атрибуты из xml.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//  ДопПараметры - Произвольный - Доп параметры.
//  ТекстОшибки - Произвольный - Текст ошибки.
//  ОбъектовВсего - Произвольный - Объектов всего.
//
// Возвращаемое значение:
//   Булево - Результат выполнения операции
Функция ВыполнитьЧтениеОбъекта(ЧтениеXML, ИмяОбъекта, АтрибутыИзXML, ФиксироватьПоОбъекту, ДопПараметры, ТекстОшибки = "", ОбъектовВсего = 0)
	
	// Получим и проверим структуру объекта 
	ТабСтруктурыОбъекта = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ИмяОбъекта);
	Если (ТабСтруктурыОбъекта = Неопределено) Тогда
		Если ФиксироватьПоОбъекту Тогда
			ТекстОшибки = "Структура объекта <" + ИмяОбъекта + "> не найдена. Объект не будет обработан";
			Событие = "УдаленныеКассы.Загрузка.Чтение";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
		КонецЕсли;
		ЧтениеXML.Пропустить();
		Возврат Истина; // не ошибка, поскольку протокол допускает расширение и появление новых объектов про которые мы еще не знаем
	КонецЕсли;
	
	// Инициализация рабочих переменных
	Результат 		= Ложь;
	ОбъектЗаписан 	= Ложь;
	Объект 			= Неопределено;
	ЭтоДокумент 	= Неопределено;
	ЭтоГруппа		= Неопределено;
	ИмяТаблицы 		= Неопределено;
	ЭтоТаблицаПодчиненныхОбъектов = Ложь;
	ЭтоТабличнаяЧасть = Ложь;
	ИмяПодчТаблицы	= Неопределено;
	СтруктураПодчОбъекта = Неопределено;
	СтруктураТабЧастиОбъекта = Неопределено;
	Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
	СвойстваОбъекта = Неопределено;
	ДопПараметры.Вставить("ПропуститьЧтениеЭтогоОбъекта", Ложь);
	
	// Вспомогательные таблицы
	ТаблицаПодчиненныхОбъектов 	= питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменПодчиненныхОбъектов();
	ТаблицаТЧОбъектов 			= питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменТЧОбъектов();
	ТаблицаСоответствийИмен 	= питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменОбъектов();
	ИмяОбъектаМенеджера			= ТаблицаСоответствийИмен.Получить(ИмяОбъекта);
	КлассификаторОбъекта 		= питОбменДаннымиПовтИсп.ПолучитьИмяКлассификаторОбъекта(ИмяОбъектаМенеджера);
	ИерархияГрупп = Неопределено;
	Если КлассификаторОбъекта = "Документ" Тогда
		ЭтоДокумент = Истина;
		ЭтоГруппа 	= Ложь;
		ИерархияГрупп = Ложь;
	КонецЕсли;
	Если КлассификаторОбъекта = "Справочник" Тогда
		ИерархияГрупп = питОбменДаннымиПовтИсп.ЭтоСправочникСИерархиейГрупп(ИмяОбъектаМенеджера);
	КонецЕсли;
		
	
	Попытка // (мало ли что в жизни бывает)
		Пока ЧтениеXML.Прочитать() Цикл 
			
			ИмяУзлаXML = ЧтениеXML.Имя;
			ТипXMLУзла = ЧтениеXML.ТипУзла;
			
			Если (ТипXMLУзла = ТипУзлаXML.КонецЭлемента) Тогда
				// КОНЕЦ УЗЛА
				Если (ИмяУзлаXML = "Object") Тогда
					// Закончилось описание объекта, пора выходить, сохраним его в базу (если еще не ...)
					Если Объект = Неопределено И НЕ ДопПараметры.ПропуститьЧтениеЭтогоОбъекта Тогда
						// какой-то косяк
						ТекстОшибки = "Нет возможности сохранить в базе объекта вида <" + ИмяОбъекта + ">. Возможно некорректное описание структуры объекта или в сообщении объект-владелец (или родитель) отсутствует или записан после текущего объекта. Рекомендуется обновить ПО-источник сообщений обмена.";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
						Результат = Ложь;
					ИначеЕсли ОбъектЗаписан ИЛИ ДопПараметры.ПропуститьЧтениеЭтогоОбъекта Тогда
						// уже записали ранее, какие молодцы
						Результат = Истина;
					Иначе
						// Наверное после считывания еще что-то "доковыряли" и нужно перезаписать в базу "объект с исправлениями"
						Результат = ВыполнитьЗаписьОбъекта(Объект, ТабСтруктурыОбъекта, ДопПараметры, ЭтоДокумент, ЭтоГруппа,  СвойстваОбъекта, АтрибутыИзXML, , ФиксироватьПоОбъекту, ТекстОшибки);
						Если Результат Тогда
							ОбъектовВсего = ОбъектовВсего + 1;
						КонецЕсли;
					КонецЕсли;
					// Обещали выйти? Вот и выходим!
					Прервать;
				
				// КОНЕЦ УЗЛА
				ИначеЕсли (ИмяУзлаXML = "Properties") Тогда
					// Основные/шапочные реквизиты объекта на этот момент считаны, попробуем уже записать объект в базу
					Если Объект = Неопределено И НЕ ДопПараметры.ПропуститьЧтениеЭтогоОбъекта Тогда
						// Доп.проверка
					ИначеЕсли ОбъектЗаписан ИЛИ ДопПараметры.ПропуститьЧтениеЭтогоОбъекта Тогда
						// уже записали ранее, какие молодцы
						Результат = Истина;
					Иначе
						Результат = ВыполнитьЗаписьОбъекта(Объект, ТабСтруктурыОбъекта, ДопПараметры, ЭтоДокумент, ЭтоГруппа, СвойстваОбъекта, АтрибутыИзXML, , ФиксироватьПоОбъекту, ТекстОшибки);
						// Доп.проверка
						Если Результат Тогда
							ОбъектовВсего = ОбъектовВсего + 1;
							ОбъектЗаписан = Истина;
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли (ИмяУзлаXML = "Link") Тогда
					// Закончилась подчиненная структура (ТЧ или подчиненные объекты)
					ИмяТаблицы = Неопределено;
					ЭтоТаблицаПодчиненныхОбъектов = Ложь;
					ЭтоТабличнаяЧасть = Ложь;
				КонецЕсли;
				
				// А иначе это какой-то другой закрывающий тег, который нас не интересует
				Продолжить; // так что читаем XML дальше
					
				
			ИначеЕсли (ТипXMLУзла = ТипУзлаXML.НачалоЭлемента) Тогда
				// НАЧАЛО УЗЛА
				Если (ИмяУзлаXML = "Properties") Тогда
					Объект = ПолучитьОбъектИЗаполнитьОсновныеСвойства(ЧтениеXML, ИмяОбъекта, ТабСтруктурыОбъекта, ДопПараметры, ЭтоДокумент, ЭтоГруппа, ИерархияГрупп, СвойстваОбъекта, АтрибутыИзXML, ТекстОшибки);

					// Дополнительная проверка
					Если Объект = Неопределено И НЕ ДопПараметры.ПропуститьЧтениеЭтогоОбъекта Тогда
						ТекстОшибки = "Из-за возникших ошибок не был получен объект данных по имени <" + ИмяОбъекта + ">  - процедура чтения сообщения прервана!";
						ВызватьИсключение ТекстОшибки;
					КонецЕсли;
					
					Продолжить;
				
				ИначеЕсли НЕ (ИмяУзлаXML = "Link") Тогда
					
					Продолжить;
					
				ИначеЕсли Объект = Неопределено И ДопПараметры.ПропуститьЧтениеЭтогоОбъекта Тогда
					// Если пропускаем чтение объекта, то пропускаем вместе со строками.
					ЧтениеXML.Пропустить();
					Продолжить;
					
				КонецЕсли;
				
				// НАЧАЛО УЗЛА LINK
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					Если ЧтениеXML.Имя = "name" Тогда
						ИмяТаблицы = ЧтениеXML.Значение;
						ИмяПодчТаблицы = ТаблицаПодчиненныхОбъектов.Получить(ИмяТаблицы);
						Если НЕ ИмяПодчТаблицы = Неопределено Тогда 
							ЭтоТаблицаПодчиненныхОбъектов = Истина;
						Иначе
							ИмяПодчТаблицы = ТаблицаТЧОбъектов.Получить(ИмяТаблицы);
							Если НЕ ИмяПодчТаблицы = Неопределено Тогда 
								ЭтоТабличнаяЧасть = Истина;
							КонецЕсли;
						КонецЕсли;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
					Если ЭтоТаблицаПодчиненныхОбъектов Тогда
						СтруктураПодчОбъекта = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ИмяТаблицы);
						Если СтруктураПодчОбъекта = Неопределено Тогда
							// у нас нет структуры поэтому мы не знаем как читать этот объект
							ЧтениеXML.Пропустить(); //... поэтому пропустим 
							// но в книжечку запишем
							Если ФиксироватьПоОбъекту Тогда
								ТекстОшибки = "Нет данных о подчиненной структуре <" + ИмяТаблицы + "> - игнорируется";
								Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
								ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Примечание, , Объект, ТекстОшибки);
							КонецЕсли;
						Иначе
							ВладелецСсылка = (?(Объект.ЭтоНовый(), Объект.ПолучитьСсылкуНового(), Объект.Ссылка));
							ВозвратныеАтрибуты = Новый Структура;
							Если ПрочитатьПодчиненныйОбъект(ЧтениеXML, ВладелецСсылка, ИмяПодчТаблицы, СтруктураПодчОбъекта, ДопПараметры, ФиксироватьПоОбъекту, ВозвратныеАтрибуты, ОбъектовВсего) Тогда
								Если ВозвратныеАтрибуты.Количество() > 0 Тогда
									// Что-то вернули, нужно проверить и если что есть полезного обновить данные объекта
									Для Каждого ЭлементСтруктуры ИЗ ВозвратныеАтрибуты Цикл
										ИмяРеквизита = ЭлементСтруктуры.Ключ;
										Попытка
											Если НЕ ЗначениеЗаполнено(Объект[ИмяРеквизита]) И ЗначениеЗаполнено(ЭлементСтруктуры.Значение) Тогда
												Объект[ИмяРеквизита] = ЭлементСтруктуры.Значение;
												ОбъектЗаписан = Ложь; // внесены изменения, объект нужно будет записать еще раз
											КонецЕсли;
										Исключение
											ИнфОбОшибке = ИнформацияОбОшибке();
											ТекстОшибки = ИнфОбОшибке.Описание;
											Пока ИнфОбОшибке.Причина <> Неопределено Цикл
												ИнфОбОшибке = ИнфОбОшибке.Причина;
												ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
											КонецЦикла;
											ТекстОшибки = "Ошибка обработки результатов подчиненной <" + ИмяПодчТаблицы + "> - " + ТекстОшибки;
											Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
											ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
										КонецПопытки;
									КонецЦикла;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ЭтоТабличнаяЧасть Тогда
						СтруктураТабЧастиОбъекта = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ИмяТаблицы);
						Если СтруктураТабЧастиОбъекта = Неопределено Тогда
							// у нас нет структуры поэтому мы не знаем как читать эту ТЧ
							ЧтениеXML.Пропустить(); //... поэтому пропустим 
							// но в книжечку запишем
							ТекстОшибки = "Нет данных о табличной части <" + ИмяТаблицы + "> - игнорируется";
							Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
							ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , Объект, ТекстОшибки);
						Иначе
							Если ПрочитатьТабличнуюЧастьОбъект(ЧтениеXML, Объект, ИмяПодчТаблицы, СтруктураТабЧастиОбъекта, ДопПараметры) Тогда
								ОбъектЗаписан = Ложь; // внесены изменения, объект нужно будет записать еще раз
							Иначе
								ТекстОшибки = "Не удалось прочитать табличную часть <" + ИмяПодчТаблицы + "> ";
								Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
								ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
								Возврат Результат;
							КонецЕсли;
						КонецЕсли;
					Иначе // мы не знаем что это и как мы должны это обрабатывать...
						ЧтениеXML.Пропустить(); //... поэтому пропустим 
						// но в книжечку запишем
						ТекстОшибки = "Неизвестная подчиненная структура <" + ИмяТаблицы + "> - игнорируется";
						Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Примечание, , Объект, ТекстОшибки);
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				// другие типы нам не интересны
				
			КонецЕсли; // case по типам узла XML
			
		КонецЦикла; // по разбираемым структурам в XML
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка чтение объекта <" + ИмяОбъекта + "> - " + ТекстОшибки;
		Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ВыполнитьЧтениеОбъекта

// Функция выполняет установку пометки на удаления для объекта
//
// Параметры:
//  СтруктураЗаголовка - Структура - Структура заголовка.
//  ИмяОбъекта - Произвольный - Имя объекта.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//   Булево - Результат выполнения операции
Функция ВыполнитьУдалениеОбъекта(СтруктураЗаголовка, ИмяОбъекта, ФиксироватьПоОбъекту, ДопПараметры)
	
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИДСтрокой = Неопределено;
	Если НЕ СтруктураЗаголовка.Свойство("ID", ИДСтрокой) Тогда
		Возврат Ложь;
	ИначеЕсли ПустаяСтрока(ИДСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат 		= Ложь;
	Событие 		= "УдаленныеКассы.Загрузка.ПометкаУдаления";	
	СсылкаНаОбъект 	= питОбменДаннымиПовтИсп.ПолучитьСсылкуПоИДИИмениОбъекта(ИДСтрокой, ИмяОбъекта, Истина);
	
	Если НЕ СсылкаНаОбъект = Неопределено Тогда  
		Если СсылкаНаОбъект.Пустая() ИЛИ СсылкаНаОбъект.ПометкаУдаления Тогда
			Результат = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(СсылкаНаОбъект)) Тогда
		Если СсылкаНаОбъект.Предопределенный Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Объект = СсылкаНаОбъект.ПолучитьОбъект();
		Объект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
		Объект.УстановитьПометкуУдаления(Истина);
		Результат = Истина;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ПредставлениеОбъекта = ПредставлениеДанных(ТипЗнч(Объект), Объект, Ложь);
		ТекстОшибки = "Не удалось пометить на удаление объект <" + ПредставлениеОбъекта + "> из-за ошибки - " + ТекстОшибки;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
	КонецПопытки;
	
	Если Результат И ФиксироватьПоОбъекту Тогда
		ПредставлениеОбъекта = ПредставлениеДанных(ТипЗнч(Объект), Объект, Ложь);
		Комментарий = ПредставлениеОбъекта +  " помечен на удаление";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , Объект, Комментарий);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ВыполнитьУдалениеОбъекта

// Функция выполняет установку пометки на удаления для объекта
//
// Параметры:
//  ИмяКоллекцииВXML - Произвольный - Имя коллекции вxml.
//  ПараметрыОчистки - Произвольный - Параметры очистки.
//  ДопПараметры - Произвольный - Доп параметры.
//  УдаленоНаборов - Произвольный - Удалено наборов.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//
// Возвращаемое значение:
//   Булево - Результат выполнения операции
Функция ВыполнитьУдаленияКоллекции(ИмяКоллекцииВXML, ПараметрыОчистки, ДопПараметры, УдаленоНаборов = 0, ФиксироватьПоОбъекту = Ложь)
	
	Результат = Ложь;
	Событие = "УдаленныеКассы.Загрузка.ОчисткаКоллекции";
	ПараметрыОчистки = СтрЗаменить(ПараметрыОчистки, "'", "");
	Если ПустаяСтрока(ПараметрыОчистки) Тогда
		Возврат Ложь; // Нет условий очистки
	КонецЕсли;		
	
	Попытка
		
		// Получим имя коллекции в метаданных
		ТаблицаСоответствий = питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменОбъектов();
		ИмяКоллекцииВМетаданных = ТаблицаСоответствий.Получить(ИмяКоллекцииВXML);
		Если ИмяКоллекцииВМетаданных = Неопределено Тогда
			Возврат Ложь; // Данная коллекция неизвестна
		КонецЕсли;
		СтруктураКоллекции = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ИмяКоллекцииВXML);
		Если СтруктураКоллекции = Неопределено Тогда
			Возврат Результат; // Данная коллекция неизвестна
		КонецЕсли;
		
		// Получим менеджер
		МенеджерКоллекции = питОбменДаннымиПовтИсп.ПолучитьМенеджерОбъектаПоИмени(ИмяКоллекцииВМетаданных);
		НаборЗаписей = МенеджерКоллекции.СоздатьНаборЗаписей();
		
		// Переделаем в структуру атрибутов "привычную" функциям обработки из макетов описания объектов
		МассивПараметровОчистки = РазложитьСтрокуВМассивПодстрок(ПараметрыОчистки, ";");
		АтрибутыИзXML = ПреобразоватьМассивПараметровВСтруктуру(МассивПараметровОчистки);
		
		// Получим отбор
		СтруктураОтбора = Новый Структура;
		
		Для Каждого ЭлСтрук Из АтрибутыИзXML Цикл
			
			ЗначениеРеквизита 	= Неопределено;
			АтрибутКлюч 		= ЭлСтрук.Ключ;
			АтрибутЗначение 	= ЭлСтрук.Значение;
			ЗначениеРеквизита	= АтрибутЗначение;

			СтрокаСтруктурыКоллекции = СтруктураКоллекции.Найти(АтрибутКлюч, "ИмяXML");
			
			Если (СтрокаСтруктурыКоллекции = Неопределено)
				ИЛИ ПустаяСтрока(СтрокаСтруктурыКоллекции.ИмяМетаданные) 
				ИЛИ НЕ (СтрокаСтруктурыКоллекции.Использование = "Отб")
			Тогда
				Продолжить;
			КонецЕсли;

			Выполнить("ЗначениеРеквизита = " + СтрокаСтруктурыКоллекции.ИмяФункПриЗагрузке);
			
			// Доп.проверка
			//// Есть у нас регистры где пустое значение в измерении это нормальный вариант работы
			// Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				СтруктураОтбора.Вставить(СтрокаСтруктурыКоллекции.ИмяМетаданные, ЗначениеРеквизита);
			// Иначе 
			// 	Результат = Истина;
			// 	Возврат Результат;
			// КонецЕсли;
			
		КонецЦикла;
		
		Если СтруктураОтбора.Количество() = 0 Тогда
			// !!! Очистить ВЕСЬ регистр без отбора? Отказать!
			// Результат = Истина;
			// Возврат Результат;
			Комментарий = "Производится попытка удаления ВСЕХ записей регистра <" + ИмяКоллекцииВМетаданных + "> по условию <" + ПараметрыОчистки + ">";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , НаборЗаписей, Комментарий);
		КонецЕсли;
		
		// Заполним элементы отбора
		Для Каждого ЭлемСтруктуры ИЗ СтруктураОтбора Цикл
			ЭлемОтбора = НаборЗаписей.Отбор.Найти(ЭлемСтруктуры.Ключ);
			Если ЭлемОтбора = Неопределено Тогда
				БрякаТут = Истина; //Доп.проверка
			Иначе
				ЭлемОтбора.Установить(ЭлемСтруктуры.Значение);
			КонецЕсли;
		КонецЦикла;
		
		НаборЗаписей.Прочитать();
		// А есть ли что тут чистить?
		Если НаборЗаписей.Количество() > 0 Тогда
			// Есть - чистим!
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			УдаленоНаборов = УдаленоНаборов + 1;
		КонецЕсли;
		
		Результат = Истина;
	
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		НаборУсловий = ?(СтруктураОтбора.Количество() > 0,	" по набору условий <" + ЗначениеВСтрокуВнутр(СтруктураОтбора)+ ">",
															" по условию очистки " + ПараметрыОчистки);
		ТекстОшибки = "Не удалось очистить коллекцию <" + ИмяКоллекцииВXML + ">  " + НаборУсловий + "  Из-за ошибки " + ТекстОшибки;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

	Если Результат И ФиксироватьПоОбъекту Тогда
		НаборУсловий = ?(СтруктураОтбора.Количество() > 0,	" по набору условий <" + ЗначениеВСтрокуВнутр(СтруктураОтбора)+ ">", 
															" по условию очистки " + ПараметрыОчистки);
		Комментарий = "Очищена коллекция <" + ИмяКоллекцииВXML + ">  " + НаборУсловий;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , НаборЗаписей, Комментарий);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции // ВыполнитьУдаленияКоллекции

// Функция выполняет чтение объектов регистра сведений
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - Обработчик XML сообщении.
//  ИмяОбъекта - Строка - Имя объекта в XML представлении.
//  АтрибутыИзXML - Произвольный - Атрибуты из xml.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//  ДопПараметры - Произвольный - Доп параметры.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
// Возвращаемое значение:
//   Булево - Результат выполнения операции
Функция ВыполнитьЧтениеОбъектаРегистраСведений(ЧтениеXML, ИмяОбъекта, АтрибутыИзXML, ФиксироватьПоОбъекту, ДопПараметры, ТекстОшибки = "")
	
	
	// Инициализация рабочих переменных
	Результат 		= Ложь;
	НужноЗаписать 	= Ложь;
	ЧислоЗаписей	= 0;
	Событие			= "УдаленныеКассы.Загрузка.ЧтениеКоллекции";
	НаборЗаписей 	= Неопределено;
	
	Попытка
	
		ТабСтруктурыОбъекта = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ИмяОбъекта);
		Если (ТабСтруктурыОбъекта = Неопределено) Тогда
			ТекстОшибки = "Структура объекта <" + ИмяОбъекта + "> не найдена. Объект не будет обработан";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
			ЧтениеXML.Пропустить();
			Возврат Истина; // не ошибка, поскольку протокол допускает расширение и появление новых объектов про которые мы еще не знаем
		КонецЕсли;
		
		СтрСоответствийИмен = питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменОбъектов();
		ИмяОбъектаМенеджера = СтрСоответствийИмен.Получить(ИмяОбъекта);
		МенеджерРегистраОбъ = питОбменДаннымиПовтИсп.ПолучитьМенеджерОбъектаПоИмени(ИмяОбъектаМенеджера);
		Если МенеджерРегистраОбъ = Неопределено Тогда
			ТекстОшибки = "Не удалось получить менеджер для коллекции <" + ИмяОбъекта + "> - пропускается";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;
		
		НаборЗаписей = МенеджерРегистраОбъ.СоздатьНаборЗаписей();
	
		
		Пока ЧтениеXML.Прочитать() Цикл
			
			ИмяУзла = ЧтениеXML.Имя;
			XMLТип	= ЧтениеXML.ТипУзла;
			
			Если (XMLТип = ТипУзлаXML.КонецЭлемента) Тогда
				
				Если (ИмяУзла = "Link") ИЛИ (ИмяУзла = "Object") ИЛИ (ИмяУзла = "Collection") Тогда
					// Данные закончились, нужно выходить из цикла и там проверить все ли записано
					Прервать; 
				КонецЕсли;
				
				// А иначе это окончание какого-то другого узла, нам не интересного - пропускаем
				Продолжить;
					
					
			ИначеЕсли (XMLТип = ТипУзлаXML.НачалоЭлемента) Тогда
				// НАЧАЛО УЗЛА, посмотрим какого именно
				
				Если (ИмяУзла = "Item") Тогда
					
					НаборЗаписей = МенеджерРегистраОбъ.СоздатьНаборЗаписей();
					
					// Вот тут читаем сразу все атрибуты 
					ЧислоЗаписей	= ЧислоЗаписей + 1;
					АтрибутыИзXML	= Новый Структура;
					СтруктураОтбора = Новый Структура();
					ИгнорироватьЭтотОбъект = Ложь;
					СвойстваОбъекта = ПрочитатьАтрибутыОбъекта(ЧтениеXML, ИмяОбъекта, ТабСтруктурыОбъекта, ДопПараметры, АтрибутыИзXML, , СтруктураОтбора, ИгнорироватьЭтотОбъект);
					
					Если ИгнорироватьЭтотОбъект Тогда
						ЧтениеXML.Пропустить();
						Возврат Неопределено;
					КонецЕсли;
					
					// Проверим что получилось
					Если НЕ (СвойстваОбъекта.Количество() > 0) Тогда
						ТекстОшибки = "Нет атрибутов в записи Item № " + Формат(ЧислоЗаписей, "ЧГ=") + "  в коллекции <" + ИмяОбъекта + ">";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
						Возврат Ложь;
					КонецЕсли;
					
					// Заполним элементы Отбора
					Для Каждого ЭлемСтруктуры ИЗ СтруктураОтбора Цикл
						ЭлемОтбора = НаборЗаписей.Отбор.Найти(ЭлемСтруктуры.Ключ);
						Если ЭлемОтбора = Неопределено Тогда
							// Доп.проверка
						Иначе
							ЭлемОтбора.Установить(ЭлемСтруктуры.Значение);
						КонецЕсли;
					КонецЦикла;
					
					НоваяЗапись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяЗапись, СвойстваОбъекта);
					НужноЗаписать = Истина;
					
					РезультатОбработки = Неопределено;
					// Проверим наличие дополнительных функций обработки до записи объекта
					МассСтрокДопФункций = ТабСтруктурыОбъекта.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "1"));
					НомерФункции = 0;
					Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
						НомерФункции = НомерФункции + 1;
						// Попытаемся выполнить доп. функцию обработки заданную в макете
						Попытка 
							Выполнить(СтрСДопФункцией.ИмяФункПриЗагрузке);
						Исключение
							ИнфОбОшибке = ИнформацияОбОшибке();
							ТекстОшибки = ИнфОбОшибке.Описание;
							Пока ИнфОбОшибке.Причина <> Неопределено Цикл
								ИнфОбОшибке = ИнфОбОшибке.Причина;
								ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
							КонецЦикла;
							ТекстОшибки = "Ошибка работы функции пред-обработки <" + СтрСДопФункцией.ИмяФункПриЗагрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
							ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
						КонецПопытки;
					КонецЦикла;
					
					Если НЕ РезультатОбработки = Неопределено Тогда
						НужноЗаписать = РезультатОбработки.НужноЗаписать;
						Результат = РезультатОбработки.Результат;
					КонецЕсли;
					
					Если НужноЗаписать Тогда
						НаборЗаписей.Записать(); //!!! (Ложь) протестировать на "широких наборах"
						Результат	= Истина;
						НужноЗаписать = Ложь;
					КонецЕсли;
					
				ИначеЕсли (ИмяУзла = "Object") ИЛИ (ИмяУзла = "Link") ИЛИ (ИмяУзла = "Collection")  ИЛИ (ИмяУзла = "Properties") Тогда
					// Косяк какой то при разборе случился, прерываемся
					Прервать;
				КонецЕсли;
					
			КонецЕсли; // case по типам узлов XML
			
		КонецЦикла;
		
		Если НужноЗаписать Тогда
			НаборЗаписей.Записать();
			НужноЗаписать = Ложь;
		КонецЕсли;
		
		Результат = Истина; // даже если нам в БД не нужно было записывать, то мы все равно отработали
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , НаборЗаписей, ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ВыполнитьЧтениеОбъектаРегистраСведений

// Функция выполняет запись полученного при чтении объекта
//
// Параметры:
//  Объект - Ссылка - Объект для чтения сообщения обмен.
//  ТабСтруктурыОбъекта - Произвольный - Таб структуры объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//  ЭтоДокумент - Произвольный - Это документ.
//  ЭтоГруппа - Произвольный - Это группа.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  АтрибутыИзXML - Произвольный - Атрибуты из xml.
//  НовыеАтрибутыВладельца - Произвольный - Новые атрибуты владельца.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
// Возвращаемое значение:
//  Булево - Результат выполнения операции
Функция ВыполнитьЗаписьОбъекта(Объект, ТабСтруктурыОбъекта, ДопПараметры, ЭтоДокумент, ЭтоГруппа, СвойстваОбъекта, АтрибутыИзXML = Неопределено, НовыеАтрибутыВладельца = Неопределено, ФиксироватьПоОбъекту = Ложь, ТекстОшибки = "")
	
	Результат = Ложь;
	НужноЗаписать = Истина;
	Событие = "УдаленныеКассы.Загрузка.ЗаписьОбъекта";
	ЭтоНовый = Объект.ЭтоНовый();
	
	Если НовыеАтрибутыВладельца = Неопределено Тогда
		НовыеАтрибутыВладельца = Новый Структура;
	КонецЕсли;
	
	Попытка
		
		Если ЭтоДокумент = Неопределено Тогда
			// Эх сверху не позаботились, самим придется
			ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Объект.Ссылка));
		КонецЕсли;
		

		Если ЭтоДокумент Тогда
			ЭтоГруппа = Ложь;
		Иначе		
			Если Объект.Предопределенный И Объект.ПометкаУдаления Тогда
				Объект.ПометкаУдаления = Ложь;
			КонецЕсли;
		КонецЕсли;
			
		Если (ЭтоГруппа = Неопределено) ИЛИ (ТипЗнч(ЭтоГруппа) <> Тип("Булево")) Тогда
			Если НЕ СвойстваОбъекта.Свойство("ЭтоГруппа") Тогда
				ЭтоГруппа = Ложь;
			ИначеЕсли ТипЗнч(СвойстваОбъекта.ЭтоГруппа) <> Тип("Булево") Тогда
				ЭтоГруппа = Ложь;
			Иначе
				ЭтоГруппа = СвойстваОбъекта.ЭтоГруппа;
			КонецЕсли;
		КонецЕсли;
		
		// Переменные защиты от зацикливания
		СчетчикЦикла = 0;
		МаксимумФунк = 0;
		// Несколько раз попытаемся сохранить объект в базу (в иделе с первого раза)
		// но не более количества доп-х функций обработки + 1 штатная попытка записи
		Пока НужноЗаписать И (СчетчикЦикла <= (МаксимумФунк+1)) Цикл
			СчетчикЦикла = СчетчикЦикла + 1;
			
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
				
			Попытка
				Объект.Записать();
				НужноЗаписать = Ложь;
				Результат = Истина
			Исключение 
				ИнфОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ИнфОбОшибке.Описание;
				Пока ИнфОбОшибке.Причина <> Неопределено Цикл
					ИнфОбОшибке = ИнфОбОшибке.Причина;
					ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
				КонецЦикла;
				ПредставлениеОбъекта = ПредставлениеДанных(ТипЗнч(Объект), Объект, Ложь);
				ТекстОшибки = "Не удалось сохранить в базу объект <" + ПредставлениеОбъекта + "> из-за ошибки - " + ТекстОшибки;
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
				Прервать;
			КонецПопытки;
			
//   Проверим наличие дополнительных функций обработки после записи объекта (которые могут установить флаг
// "НужноЗаписать").
			МассСтрокДопФункций = ТабСтруктурыОбъекта.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "0"));
			НомерФункции = 0;
			Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
				НомерФункции = НомерФункции + 1;
				МаксимумФунк = ?(НомерФункции > МаксимумФунк, НомерФункции, МаксимумФунк);
				Если (СтрСДопФункцией.Использование = "ГиЭ")
				 ИЛИ((СтрСДопФункцией.Использование = "Г") И ЭтоГруппа)
				 ИЛИ((СтрСДопФункцией.Использование = "Э") И НЕ ЭтоГруппа) Тогда
				    // Попытаемся выполнить доп. функцию обработки заданную в макете
				 	Попытка 
						Выполнить(СтрСДопФункцией.ИмяФункПриЗагрузке);
					Исключение
						ИнфОбОшибке = ИнформацияОбОшибке();
						ТекстОшибки = ИнфОбОшибке.Описание;
						Пока ИнфОбОшибке.Причина <> Неопределено Цикл
							ИнфОбОшибке = ИнфОбОшибке.Причина;
							ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
						КонецЦикла;
						ТекстОшибки = "Ошибка работы функции пост-обработки <" + СтрСДопФункцией.ИмяФункПриЗагрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
						Событие = "УдаленныеКассы.Загрузка.ЧтениеПодчиненногоОбъекта";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
					КонецПопытки;
				КонецЕсли;
			КонецЦикла; // по функциям пост-обработки
			
		КонецЦикла; // по попыткам записать объект в базу
		
		Если Результат И ФиксироватьПоОбъекту Тогда
			ПредставлениеОбъекта = ПредставлениеДанных(ТипЗнч(Объект), Объект, Ложь);
			Комментарий = ПредставлениеОбъекта +  " успешно загружен";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , , Комментарий);
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ВыполнитьЗаписьОбъекта

// Функция выполняет чтение объектов справочника
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - Обработчик XML сообщении.
//  ИмяОбъекта - Строка - Имя объекта в XML представлении.
//  СтруктураОбъекта - Структура - Структура объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//  ЭтоДокумент - Произвольный - Это документ.
//  ЭтоГруппа - Произвольный - Это группа.
//  ИерархияГрупп - Произвольный - Иерархия групп.
//  СвойстваОбъекта - Произвольный - Свойства объекта.
//  АтрибутыИзXML - Произвольный - Атрибуты из xml.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
// Возвращаемое значение:
//   Булево - Результат выполнения операции
Функция ПолучитьОбъектИЗаполнитьОсновныеСвойства(ЧтениеXML, ИмяОбъекта, СтруктураОбъекта, ДопПараметры, ЭтоДокумент = Неопределено, ЭтоГруппа	= Неопределено, ИерархияГрупп, СвойстваОбъекта = Неопределено, АтрибутыИзXML = Неопределено, ТекстОшибки = "")
	
	Ссылка 		= Неопределено;
	Объект		= Неопределено;
	Событие		= "УдаленныеКассы.Загрузка.ЧтениеОбъекта";
	
	Попытка
		
		ИгнорироватьЭтотОбъект = Ложь;
		// Считаем основные свойства объекта (шапочные реквизиты) 
		СвойстваОбъекта = ПрочитатьАтрибутыОбъекта(ЧтениеXML, ИмяОбъекта, СтруктураОбъекта, ДопПараметры, АтрибутыИзXML, , , ИгнорироватьЭтотОбъект);
		
		МассивСтрокТаблицаМетаданных = ДопПараметры.ТаблицаМетаданныхДляЗагрузки.НайтиСтроки(Новый Структура("Дескриптор",ИмяОбъекта));
		// Если по правилам в макета объект с таким именем может не пропускаться, то выполняем проверку.
		Если ЗначениеЗаполнено(МассивСтрокТаблицаМетаданных) Тогда
			
			СтрокаТаблицыМетаданных = МассивСтрокТаблицаМетаданных[0];
			ДопПараметры.Вставить("ПропуститьЧтениеЭтогоОбъекта", Ложь);
			
			Если ДопПараметры.Свойство("ПриниматьТолькоДанныеПродаж") 
				И ДопПараметры.ПриниматьТолькоДанныеПродаж 
				И ИмяОбъекта <> "Check" 
				И ИмяОбъекта <> "ChkBar"
				И ИмяОбъекта <> "ChkMod"
				И ИмяОбъекта <> "ChkPay"
				И ИмяОбъекта <> "ChkAlco" Тогда
				
				Если АтрибутыИзXML.Свойство("ID") Тогда
					ИД = АтрибутыИзXML.ID;
					// Проверка новых элементов
					Если ОбъектСуществовует(ИД, ИмяОбъекта, питОбменДаннымиПовтИсп.ПолучитьМенеджерОбъектаПоИмени(СтрокаТаблицыМетаданных.Метаданные.Имя), ДопПараметры) Тогда
						// Элемент уже есть в базе, игнорируем его
						ДопПараметры.ПропуститьЧтениеЭтогоОбъекта = Истина;
					КонецЕсли;
				Иначе
					ДопПараметры.ПропуститьЧтениеЭтогоОбъекта = Истина;
				КонецЕсли;
				
				Если ДопПараметры.Свойство("ФиксироватьПоОбъекту") Тогда
					ТекстОшибки = "Объект <" + ИмяОбъекта + "> не будет обработан, т.к. для данного кассового узла загружаются только документы ""Чеки Общепита""!";
					Событие = "УдаленныеКассы.Загрузка.Чтение";
					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , , ТекстОшибки);
				КонецЕсли;
				
			КонецЕсли;
			
			Для Каждого ТекСтрока из МассивСтрокТаблицаМетаданных Цикл
				Если НЕ ПустаяСтрока(ТекСтрока.ИмяФункцииПропуститьЧтение) Тогда
					Выполнить("ДопПараметры.Вставить(""ПропуститьЧтениеЭтогоОбъекта"", " + ТекСтрока.ИмяФункцииПропуститьЧтение+")");
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ДопПараметры.ПропуститьЧтениеЭтогоОбъекта Тогда
				ИгнорироватьЭтотОбъект = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИгнорироватьЭтотОбъект Тогда
			ЧтениеXML.Пропустить();
			Возврат Неопределено;
		КонецЕсли;
		
		Если НЕ (СвойстваОбъекта.Количество() > 0) Тогда
			ТекстОшибки = "Не удалось считать никаких свойств у объекта вида <" + ИмяОбъекта + ">";	
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			Возврат Неопределено;
		КонецЕсли;
		
		// Проверим ссылку
		Если СвойстваОбъекта.Свойство("Ссылка", Ссылка) Тогда
			Если НЕ (Ссылка = Неопределено) Тогда
				ТипСсылки = ТипЗнч(Ссылка);
				ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипСсылки);
				Если ЭтоДокумент Тогда
					ЭтоГруппа = Ложь; // Хорошо, попробуем именно с этой ссылкой объект создать
				ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
					// Хорошо, попробуем именно с этой ссылкой объект создать
					// а пока определимся группа это или не группа
					Если (ЭтоГруппа	= Неопределено) И НЕ ПустаяСтрока(Ссылка.ВерсияДанных) Тогда
						ЭтоГруппа = Ссылка.ЭтоГруппа;
					КонецЕсли;
				Иначе
					// Нет уж лучше пусть объект штатно создается и новая ссылка сгенерируется
					Ссылка = Неопределено;	
				КонецЕсли;
			КонецЕсли;
		Иначе
			Ссылка = Неопределено;
		КонецЕсли;
		
		// Проверим группу
		Если ЭтоГруппа = Неопределено Тогда
			Если (ЭтоДокумент<>Неопределено) И ЭтоДокумент Тогда
				ЭтоГруппа = Ложь;
			ИначеЕсли СвойстваОбъекта.Свойство("ЭтоГруппа", ЭтоГруппа) Тогда
				Если НЕ ТипЗнч(ЭтоГруппа) = Тип("Булево") Тогда
					ЭтоГруппа = Ложь;		
				КонецЕсли;
			Иначе
				ЭтоГруппа = Ложь;
			КонецЕсли;
		КонецЕсли;
			
		Если НЕ СвойстваОбъектаПрошлиПроверку(ИмяОбъекта, СвойстваОбъекта, СтруктураОбъекта, ЭтоДокумент, ЭтоГруппа, ИерархияГрупп, ТекстОшибки) Тогда
			ТекстОшибки = "Не прошел контроль свойств у объекта вида <" + ИмяОбъекта + "> " + ТекстОшибки;
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			Возврат Неопределено;
		КонецЕсли;
		
		Объект = ПолучитьСоздатьОбъектПоСсылке(Ссылка, ИмяОбъекта, ЭтоДокумент, ЭтоГруппа, Истина, ТекстОшибки);
		
		// Проверим наличие дополнительных функций обработки до записи объекта
		МассСтрокДопФункций = СтруктураОбъекта.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "1"));
		НомерФункции = 0;
		Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
			НомерФункции = НомерФункции + 1;
			Если (СтрСДопФункцией.Использование = "ГиЭ")
			 ИЛИ((СтрСДопФункцией.Использование = "Г") И ЭтоГруппа)
			 ИЛИ((СтрСДопФункцией.Использование = "Э") И НЕ ЭтоГруппа) Тогда
			    // Попытаемся выполнить доп. функцию обработки заданную в макете
			 	Попытка 
					Выполнить(СтрСДопФункцией.ИмяФункПриЗагрузке);
				Исключение
					ИнфОбОшибке = ИнформацияОбОшибке();
					ТекстОшибки = ИнфОбОшибке.Описание;
					Пока ИнфОбОшибке.Причина <> Неопределено Цикл
						ИнфОбОшибке = ИнфОбОшибке.Причина;
						ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
					КонецЦикла;
					ТекстОшибки = "Ошибка работы функции пред-обработки <" + СтрСДопФункцией.ИмяФункПриЗагрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		Если (Объект = Неопределено) Тогда
			// ничего не нужно 
		Иначе
			// ЗАПОЛНИМ ОБЪЕКТу его основные свойства (шапочные реквизиты) 
			ЗаполнитьЗначенияСвойств(Объект, СвойстваОбъекта);
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		
		Если (Объект = Неопределено) Тогда
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Иначе
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
		КонецЕсли;
		
	КонецПопытки;
	
	Возврат Объект;
	
КонецФункции // ПолучитьОбъектИЗаполнитьОсновныеСвойства

// Функция чтения атрибутов из XML сообщения
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - XML парсер
//   ИмяОбъекта - строка, имя объекта в метаданных (используется в конструкции Выполнить... .
//  ИмяОбъекта - Произвольный - Имя объекта.
//  СтруктураОбъекта - Структура - Структура объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//  АтрибутыИзXML - Произвольный - Атрибуты из xml.
//  ВладелецСсылка - Произвольный - Владелец ссылка.
//  ОтборДляРегистра - Произвольный - Отбор для регистра.
//  ФлагИгнорировать - Произвольный - Флаг игнорировать.
//
// Возвращаемое значение:
//  Структура - Структура значений реквизитов объекта
Функция ПрочитатьАтрибутыОбъекта(ЧтениеXML, ИмяОбъекта, СтруктураОбъекта, ДопПараметры, АтрибутыИзXML = Неопределено, ВладелецСсылка = Неопределено, ОтборДляРегистра = Неопределено, ФлагИгнорировать = Ложь)
	
	СвойстваОбъекта = Новый Структура;
	АтрибутыИзXML = ПрочитатьАтрибуты(ЧтениеXML);
	
	Для Каждого Атрибут Из АтрибутыИзXML Цикл
		
		АтрибутКлюч		 = Атрибут.Ключ;
		
		// Строк структуры объекта, которые соответствуют ключу может быть несколько.
		// Например, Количество и КоличествоУпаковок устанавливаются из одного и того же ключа "Count"
		//  в макете ChkBar
		СтрокиСтруктурыОбъекта = СтруктураОбъекта.НайтиСтроки(Новый Структура("ИмяXML", АтрибутКлюч));
		Для каждого СтрокаСтруктурыОбъекта Из СтрокиСтруктурыОбъекта Цикл
			Если (СтрокаСтруктурыОбъекта = Неопределено)
				ИЛИ (СтрокаСтруктурыОбъекта.Вид = "Фун") Тогда 
				// Функции не связанные с заполнением реквизитов вызываются в отдельном цикле в другом месте
				Продолжить;
			КонецЕсли;
			
			АтрибутЗначение  = Атрибут.Значение;
			ЗначениеРеквизита= АтрибутЗначение;
			
			Попытка
				
				Если ПустаяСтрока(СтрокаСтруктурыОбъекта.ИмяФункПриЗагрузке) Тогда
					ЗначениеРеквизита = питОбменДаннымиПовтИсп.ПолучитьЗначениеАтрибутаПриЗагрузке(АтрибутЗначение, СтрокаСтруктурыОбъекта.ИмяМетаданные, СтрокаСтруктурыОбъекта.Тип, СтрокаСтруктурыОбъекта.ИмяФункКонвертЗагр);
				Иначе
					Выполнить("ЗначениеРеквизита = " + СтрокаСтруктурыОбъекта.ИмяФункПриЗагрузке);
				КонецЕсли;
				
				Если ТипЗнч(ЗначениеРеквизита) = Тип("Строка") 
					И (ЗначениеРеквизита = "IgnoreIt!") Тогда
					// Получена директива игнорировать объект и дальше его не читать
					ФлагИгнорировать = Истина;
					Прервать;
				КонецЕсли;
				
				Если НЕ ПустаяСтрока(СтрокаСтруктурыОбъекта.ИмяМетаданные) Тогда
					СвойстваОбъекта.Вставить(СтрокаСтруктурыОбъекта.ИмяМетаданные, ЗначениеРеквизита);
					Если НЕ (ОтборДляРегистра = Неопределено) 
						И НЕ ПустаяСтрока(СтрокаСтруктурыОбъекта.ИмяМетаданные) 
						И (СтрокаСтруктурыОбъекта.Использование = "Отб") 
						Тогда
						// И еще добавим его же в отбор для регистра
						ОтборДляРегистра.Вставить(СтрокаСтруктурыОбъекта.ИмяМетаданные, ЗначениеРеквизита);
					КонецЕсли;
				КонецЕсли;
				
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ИнфОбОшибке.Описание;
				Пока ИнфОбОшибке.Причина <> Неопределено Цикл
					ИнфОбОшибке = ИнфОбОшибке.Причина;
					ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
				КонецЦикла;
				ТекстОшибки = "Ошибка при чтении атрибутов объекта <" + ИмяОбъекта + "> - " + ТекстОшибки;
				Событие = "УдаленныеКассы.Загрузка.ЧтениеАтрибутовОбъекта";
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СвойстваОбъекта;
	
КонецФункции // ПрочитатьАтрибутыОбъекта()

// Функция чтения подчиненных объектов из XML сообщения
//
// Параметры:
//  ЧтениеXML - Произвольный - Чтение xml.
//  ВладелецСсылка - Произвольный - Владелец ссылка.
//  ИмяОбъекта - Произвольный - Имя объекта.
//  ТабСтруктурыОбъекта - Произвольный - Таб структуры объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//  ФиксироватьПоОбъекту - Булево - Признак необходимости фиксации событий в журнал регистрации по каждому объект.
//  НовыеАтрибутыВладельца - Произвольный - Новые атрибуты владельца.
//  ОбъектовВсего - Произвольный - Объектов всего.
//
// Возвращаемое значение:
//   Булево - Результат выполнения операции
Функция ПрочитатьПодчиненныйОбъект(ЧтениеXML, ВладелецСсылка, ИмяОбъекта, ТабСтруктурыОбъекта, ДопПараметры, ФиксироватьПоОбъекту, НовыеАтрибутыВладельца = Неопределено, ОбъектовВсего = 0)
	
	ТекстОшибки		= "";
	Результат 		= Ложь;
	Событие = "УдаленныеКассы.Загрузка.ЧтениеПодчиненногоОбъекта";
	ТаблицаСоответствийИмен 	= питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменОбъектов();
	ИмяОбъектаМенеджера			= ТаблицаСоответствийИмен.Получить(ИмяОбъекта);
	КлассификаторОбъекта 		= питОбменДаннымиПовтИсп.ПолучитьИмяКлассификаторОбъекта(ИмяОбъектаМенеджера);
	ИерархияГрупп = Неопределено;
	Если КлассификаторОбъекта = "Документ" Тогда
		ЭтоДокумент = Истина;
		ИерархияГрупп = Ложь;
	КонецЕсли;
	Если КлассификаторОбъекта = "Справочник" Тогда
		ИерархияГрупп = питОбменДаннымиПовтИсп.ЭтоСправочникСИерархиейГрупп(ИмяОбъектаМенеджера);
	КонецЕсли;
	Если НовыеАтрибутыВладельца = Неопределено Тогда
		НовыеАтрибутыВладельца = Новый Структура;
	КонецЕсли;
	
	Попытка
		
		Пока ЧтениеXML.Прочитать() Цикл
			
			Если (ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента) И
				((ЧтениеXML.Имя = "Link") ИЛИ (ЧтениеXML.Имя = "Object") ИЛИ (ЧтениеXML.Имя = "Collection")) Тогда
				Прервать; // закончилось перечисление подчиненных элементов в XML-файле и работа данной процедуры
			ИначеЕсли НЕ (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) И (ЧтениеXML.Имя = "Item") Тогда
				Продолжить; // это не то что нам нужно, пролистываем
			КонецЕсли;
			
			// Новый объект или очередной элемент коллекции
			
			Ссылка			= Неопределено;
			ЭтоГруппа		= Неопределено;
			ЭтоДокумент		= Неопределено;
			АтрибутыИзXML	= Новый Структура;
			ИгнорироватьЭтотОбъект = Ложь;
			
			СвойстваОбъекта = ПрочитатьАтрибутыОбъекта(ЧтениеXML, ИмяОбъекта, ТабСтруктурыОбъекта, ДопПараметры, АтрибутыИзXML, ВладелецСсылка, , ИгнорироватьЭтотОбъект);
			
			Если ИгнорироватьЭтотОбъект Тогда
				ЧтениеXML.Пропустить();
				Возврат Ложь;
			КонецЕсли;
			
			Если НЕ (СвойстваОбъекта.Количество() > 0) Тогда
				ТекстОшибки = "Не удалось считать никаких свойств у подчиненного объекта вида <" + ИмяОбъекта + ">";
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
			
			// Проверим ссылку
			Если СвойстваОбъекта.Свойство("Ссылка", Ссылка) Тогда
				Если НЕ (Ссылка = Неопределено) Тогда
					ТипСсылки = ТипЗнч(Ссылка);
					ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипСсылки);
					Если ЭтоДокумент Тогда
						ЭтоГруппа = Ложь; // Хорошо, попробуем именно с этой ссылкой объект документа
					ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипСсылки) Тогда
						// Хорошо, попробуем именно с этой ссылкой создать объект справочника
						// а пока определимся группа это или не группа
						Если (ЭтоГруппа	= Неопределено) И НЕ ПустаяСтрока(Ссылка.ВерсияДанных) Тогда
							ЭтоГруппа = Ссылка.ЭтоГруппа;
						КонецЕсли;
					Иначе
						// Нет уж лучше пусть объект штатно создается и новая ссылка сгенерируется
						Ссылка = Неопределено;	
					КонецЕсли;
				КонецЕсли;
			Иначе
				Ссылка = Неопределено;
			КонецЕсли;
			
			// Проверим группу
			Если ЭтоГруппа = Неопределено Тогда
				Если (ЭтоДокумент <> Неопределено) И ЭтоДокумент Тогда
					ЭтоГруппа = Ложь;
				ИначеЕсли СвойстваОбъекта.Свойство("ЭтоГруппа", ЭтоГруппа) Тогда
					Если ТипЗнч(ЭтоГруппа) <> Тип("Булево") Тогда
						ЭтоГруппа = Ложь;		
					КонецЕсли;
				Иначе
					ЭтоГруппа = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			// Проверим остальные свойства
			Если НЕ СвойстваОбъектаПрошлиПроверку(ИмяОбъекта, СвойстваОбъекта, ТабСтруктурыОбъекта, ЭтоДокумент, ЭтоГруппа, ИерархияГрупп, ТекстОшибки) Тогда
				ТекстОшибки = "Не прошел контроль свойств у объекта вида <" + ИмяОбъекта + "> " + ТекстОшибки;	
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
			
			// Получаем или создаем новый объект
			Объект = ПолучитьСоздатьОбъектПоСсылке(Ссылка, ИмяОбъекта, ЭтоДокумент, ЭтоГруппа);
			
			// Проверим наличие дополнительных функций обработки до записи объекта
			МассСтрокДопФункций = ТабСтруктурыОбъекта.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "1"));
			НомерФункции = 0;
			Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
				НомерФункции = НомерФункции + 1;
				Если (СтрСДопФункцией.Использование = "ГиЭ")
				 ИЛИ((СтрСДопФункцией.Использование = "Г") И ЭтоГруппа)
				 ИЛИ((СтрСДопФункцией.Использование = "Э") И НЕ ЭтоГруппа) Тогда
				    // Попытаемся выполнить доп. функцию обработки заданную в макете
				 	Попытка 
						Выполнить(СтрСДопФункцией.ИмяФункПриЗагрузке);
					Исключение
						ИнфОбОшибке = ИнформацияОбОшибке();
						ТекстОшибки = ИнфОбОшибке.Описание;
						Пока ИнфОбОшибке.Причина <> Неопределено Цикл
							ИнфОбОшибке = ИнфОбОшибке.Причина;
							ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
						КонецЦикла;
						ТекстОшибки = "Ошибка работы функции пред-обработки <" + СтрСДопФункцией.ИмяФункПриЗагрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			
			Если Объект = Неопределено Тогда
				// Доп.проверка
				Продолжить; // может другие подчиненные объекты хотя бы сможем создать/записать
			КонецЕсли;
			
			// заполняем ему свойства
			СвойстваОбъекта.Вставить("Владелец", ВладелецСсылка);
			ЗаполнитьЗначенияСвойств(Объект, СвойстваОбъекта);
			
			// сохраняем объект в БД
			Результат = ВыполнитьЗаписьОбъекта(Объект, ТабСтруктурыОбъекта, ДопПараметры, ЭтоДокумент, ЭтоГруппа, СвойстваОбъекта, АтрибутыИзXML, НовыеАтрибутыВладельца, ФиксироватьПоОбъекту, ТекстОшибки);
			Если Результат Тогда
				ОбъектовВсего = ОбъектовВсего + 1;
			Иначе
				Возврат Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		Результат = Истина;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "УдаленныеКассы.Загрузка.ЧтениеПодчиненногоОбъекта";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ПрочитатьПодчиненныйОбъект

// Функция чтения подчиненных объектов из XML сообщения
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - Обработчик XML сообщении.
//  Объект - СправочникОбъект - Объект базы данных.
//  ИмяТЧ - Строка - Имя табличной части в метаданных.
//  СтруктураТаблицыОбъекта - ТаблицаЗначений - Структура табличной части данного объект.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//   Булево - Результат выполнения операции
Функция ПрочитатьТабличнуюЧастьОбъект(ЧтениеXML, Объект, ИмяТЧ, СтруктураТаблицыОбъекта, ДопПараметры)
	
	Результат = Ложь;
	АтрибутыИзXML = Новый Структура;
	Событие = "УдаленныеКассы.Загрузка.ЧтениеТабличнойЧастиОбъекта";
	
	Попытка
		// Очистим табличную часть
		Объект[ИмяТЧ].Очистить();
	
		
		Пока ЧтениеXML.Прочитать() Цикл
			
			Если (ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента) И 
				((ЧтениеXML.Имя = "Link") ИЛИ (ЧтениеXML.Имя = "Object") ИЛИ (ЧтениеXML.Имя = "Collection")) Тогда
				
				// Проверим наличие дополнительных функций обработки до записи объекта
				МассСтрокДопФункций = СтруктураТаблицыОбъекта.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "2"));
				НомерФункции = 0;
				Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
					НомерФункции = НомерФункции + 1;
					Если (СтрСДопФункцией.Использование = "ГиЭ")
						ИЛИ((СтрСДопФункцией.Использование = "Г"))
						ИЛИ((СтрСДопФункцией.Использование = "Э")) Тогда
						// Попытаемся выполнить доп. функцию обработки заданную в макете
						Попытка 
							Выполнить(СтрСДопФункцией.ИмяФункПриЗагрузке);
						Исключение
							ИнфОбОшибке = ИнформацияОбОшибке();
							ТекстОшибки = ИнфОбОшибке.Описание;
							Пока ИнфОбОшибке.Причина <> Неопределено Цикл
								ИнфОбОшибке = ИнфОбОшибке.Причина;
								ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
							КонецЦикла;
							ТекстОшибки = "Ошибка работы функции пост-обработки <" + СтрСДопФункцией.ИмяФункПриЗагрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
							ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;
				
				Прервать;
				
			ИначеЕсли (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) И (ЧтениеXML.Имя = "Item") Тогда
				
				АтрибутыОбъекта = ПрочитатьАтрибутыОбъекта(ЧтениеXML, ИмяТЧ, СтруктураТаблицыОбъекта, ДопПараметры, АтрибутыИзXML);
				
				НоваяСтрока = Объект[ИмяТЧ].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, АтрибутыОбъекта);
				
				// Проверим наличие дополнительных функций обработки до записи объекта
				МассСтрокДопФункций = СтруктураТаблицыОбъекта.НайтиСтроки(Новый Структура("Вид,ВыгружатьПустым","Фун", "1"));
				НомерФункции = 0;
				Для Каждого СтрСДопФункцией ИЗ МассСтрокДопФункций Цикл
					НомерФункции = НомерФункции + 1;
					Если (СтрСДопФункцией.Использование = "ГиЭ")
						ИЛИ((СтрСДопФункцией.Использование = "Г"))
						ИЛИ((СтрСДопФункцией.Использование = "Э")) Тогда
						// Попытаемся выполнить доп. функцию обработки заданную в макете
						Попытка 
							Выполнить(СтрСДопФункцией.ИмяФункПриЗагрузке);
						Исключение
							ИнфОбОшибке = ИнформацияОбОшибке();
							ТекстОшибки = ИнфОбОшибке.Описание;
							Пока ИнфОбОшибке.Причина <> Неопределено Цикл
								ИнфОбОшибке = ИнфОбОшибке.Причина;
								ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
							КонецЦикла;
							ТекстОшибки = "Ошибка работы функции пред-обработки <" + СтрСДопФункцией.ИмяФункПриЗагрузке + "> №" + НомерФункции +  " - " + ТекстОшибки;
							ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Результат = Истина;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка чтения ТЧ <" + ИмяТЧ + "> - " + ТекстОшибки;
		Событие = "УдаленныеКассы.Загрузка.ЧтениеТЧ";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ПрочитатьТабличнуюЧастьОбъект()

// Функция проверки присланных атрибутов
//
// Параметры:
//  ИмяОбъекта - Строка - Имя объекта в XML сообщении.
//  СвойстваОбъекта - Структура - Структура считанных реквизитов.
//  ТабСтруктурыОбъекта - Произвольный - Таб структуры объекта.
//  ЭтоДокумент - Произвольный - Это документ.
//  ЭтоГруппа - Произвольный - Это группа.
//  ИерархияГрупп - Произвольный - Иерархия групп.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
// Возвращаемое значение:
//  Булево - Результат проверки
Функция СвойстваОбъектаПрошлиПроверку(ИмяОбъекта, СвойстваОбъекта, ТабСтруктурыОбъекта, ЭтоДокумент, ЭтоГруппа, ИерархияГрупп, ТекстОшибки = "")
	
	НеисправимыеКосякиБыли = Ложь;
	Событие = "УдаленныеКассы.Загрузка.ЧтениеОбъекта.ПроверкаСвойств";
	
	// !!! Временная заглушка от некорректных данных "с той стороны обменов"
	// Если (ИмяОбъекта = "Product") И (НЕ СвойстваОбъекта.Свойство("ЭтоГруппа") ИЛИ НЕ СвойстваОбъекта.ЭтоГруппа) И
	// 	(НЕ СвойстваОбъекта.Свойство("ВидНоменклатуры") ИЛИ НЕ ЗначениеЗаполнено(СвойстваОбъекта.ВидНоменклатуры)) Тогда
	// 	// Номенклатуру с неуказанным типом в базу записать никак не можно
	// 	НеисправимыеКосякиБыли = Истина;
	// 	ОпределениеПозиции = "";
	// 	ТекстСообщения = "В присланной номенклатуре <>  - не указан тип номенклатуры (или номенклатурная группа)!
	// 					|Объект не может быть сохранен в базу - операция чтения сообщения прерывается";
	// 	Если СвойстваОбъекта.Свойство("Код") И ЗначениеЗаполнено(СвойстваОбъекта.Код) Тогда
	// 		ОпределениеПозиции = ОпределениеПозиции + "Код = <" + СвойстваОбъекта.Код + "> ";
	// 	КонецЕсли;
	// 	Если СвойстваОбъекта.Свойство("Наименование") И ЗначениеЗаполнено(СвойстваОбъекта.Наименование) Тогда
	// 		ОпределениеПозиции = ОпределениеПозиции + "Наименование = <" + СвойстваОбъекта.Наименование + "> ";
	// 	КонецЕсли;
	// 	ТекстСообщения = СтрЗаменить(ТекстСообщения, "<>", ОпределениеПозиции);
	// 	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
	// 	ВызватьИсключение ТекстСообщения;
	// КонецЕсли;
	
	
	Попытка
		Если (ЭтоДокумент <> Неопределено) И ЭтоДокумент Тогда
			Если ((ИмяОбъекта = "DocDisc") ИЛИ (ИмяОбъекта = "RowDisc")) Тогда
				РеглВалюта = ПолучитьРеглВалюту();
				ВалютаВОбъекте = Неопределено;
				Если НЕ СвойстваОбъекта.Свойство("ВалютаДокумента", ВалютаВОбъекте) Тогда
					СвойстваОбъекта.Вставить("ВалютаДокумента", РеглВалюта);
				ИначеЕсли НЕ ЗначениеЗаполнено(ВалютаВОбъекте) Тогда
					СвойстваОбъекта.Вставить("ВалютаДокумента", РеглВалюта);
				ИначеЕсли ВалютаВОбъекте = РеглВалюта Тогда
					// Все хорошо
				Иначе 
					// будем менять шило на мыло
					СвойстваОбъекта.Вставить("ВалютаДокумента", РеглВалюта);
					// но честно признаемся об этом в исповедальный лог-журнал
					НомерДокумента = ?(СвойстваОбъекта.Свойство("Номер"), " №" + СвойстваОбъекта.Номер, " ");
					ТекстСообщения = "В документе назначения скидки " + ?(ИмяОбъекта = "DocDisc", "(шапочной)", "(на позиции)") + НомерДокумента+ " заменена валюта на регламентную";
					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , , ТекстСообщения);
				КонецЕсли;
			КонецЕсли;
			
		Иначе 
			// Свойства СПРАВОЧНИКОВ КРЫЖИМ ТУТ
			МассивКлючейДляУдаления = Новый Массив;
			Для Каждого ЭлмСтрСвойств ИЗ СвойстваОбъекта Цикл
				// Пройдемся по всем полученным свойствам и определим какие реквизиты не применимы по признаку для Группы/Элемента
				СтрокаСтруктурыОбъекта = ТабСтруктурыОбъекта.Найти(ЭлмСтрСвойств.Ключ, "ИмяМетаданные");
				Если СтрокаСтруктурыОбъекта = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если (СтрокаСтруктурыОбъекта.Использование = "ГиЭ")
				 ИЛИ((СтрокаСтруктурыОбъекта.Использование = "Г") И ЭтоГруппа)
				 ИЛИ((СтрокаСтруктурыОбъекта.Использование = "Э") И НЕ ЭтоГруппа) Тогда
				 	// Это нормально
				Иначе
					// А вот это плохо и не соответствует - будем резать!
					МассивКлючейДляУдаления.Добавить(ЭлмСтрСвойств.Ключ);
				КонецЕсли;
				
				// В качестве родителя спр-ка указывают ссылку на элемент а не группу
				Если (ЭлмСтрСвойств.Ключ = "Родитель")
					И ЗначениеЗаполнено(ЭлмСтрСвойств.Значение) Тогда
					// Нужны дополнительные проверки на валидность ссылки-родителя
					Если ПустаяСтрока(ЭлмСтрСвойств.Значение.ВерсияДанных) Тогда
						БрекПоинт = Истина; // Если объект в базу еще не записан то это не факт что он не группа - оставляем
					ИначеЕсли (ИерархияГрупп<>Неопределено) И ИерархияГрупп И НЕ ЭлмСтрСвойств.Значение.ЭтоГруппа Тогда
						// Чего нам только не присылают с той стороны - будем резать!
						МассивКлючейДляУдаления.Добавить(ЭлмСтрСвойств.Ключ);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			// Удалим ненужные свойства
			Для Каждого Ключ ИЗ МассивКлючейДляУдаления Цикл
				СвойстваОбъекта.Удалить(Ключ);
			КонецЦикла;
			
		КонецЕсли;

	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат НЕ НеисправимыеКосякиБыли;
	
КонецФункции // СвойстваОбъектаПрошлиПроверку

// Функция чтения атрибутов из XML сообщения
//
// Параметры:
//  ЧтениеXML - ЧтениеXML - XML парсе.
//  ИмяОбъекта - Произвольный - Имя объекта.
//
// Возвращаемое значение:
//  Структура - Структура значений реквизитов объекта
Функция ПрочитатьАтрибуты(ЧтениеXML, ИмяОбъекта = "")
	
	СвойстваОбъекта = Новый Структура;
	Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
		ЗначениеАтрибута = ЧтениеXML.Значение;
		Если ЧтениеXML.Имя = "name" Тогда
			ИмяОбъекта = ЗначениеАтрибута;
		КонецЕсли;
		СвойстваОбъекта.Вставить(ЧтениеXML.Имя, ЗначениеАтрибута);
	КонецЦикла;
	
	Возврат СвойстваОбъекта;
	
КонецФункции // ПрочитатьАтрибуты()

// Функция проверки наличия номенклатуры в индивидуальном списке кассового узла.
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура - Ссылка на проверяемый элемент.
//  КассовыйУзелСсылка - ПланыОбменовСсылка.УдаленныеКассы - Ссылка на кассовый узел, для которого определяется.
//  ЭтоГруппа - Произвольный - Это группа.
//
// Возвращаемое значение:
//  Булево
Функция НоменклатураЕстьВИндивидуальномСписке(НоменклатураСсылка, КассовыйУзелСсылка, ЭтоГруппа = Неопределено)
	
	Результат = Ложь;
	
	Если НЕ КассовыйУзелСсылка.ИндивидуальныйСписокНоменклатуры Тогда 
		// Вся зарегистрированная номенклатура известна узлу
		Результат = Истина;
		Возврат Результат;
	КонецЕсли;
	
	// Выполним поиск в ТЧ кассового узла
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УдаленныеКассыНоменклатура.Номенклатура
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.Номенклатура КАК УдаленныеКассыНоменклатура
	|ГДЕ
	|	УдаленныеКассыНоменклатура.Ссылка = &КассовыйУзелСсылка
	|	И УдаленныеКассыНоменклатура.Номенклатура = &НоменклатураСсылка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
	Запрос.УстановитьПараметр("НоменклатураСсылка", НоменклатураСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда 
		// Ссылка есть в ТЧ Кассового узла
		Результат = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоГруппа = Неопределено Тогда
		ЭтоГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураСсылка,"ЭтоГруппа");
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		
		// Выполним поиск подчиненных элементов в индивидуальном списке кассового узла
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	УдаленныеКассыНоменклатура.Номенклатура
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы.Номенклатура КАК УдаленныеКассыНоменклатура
		|ГДЕ
		|	УдаленныеКассыНоменклатура.Номенклатура В ИЕРАРХИИ(&НоменклатураСсылка)
		|	И УдаленныеКассыНоменклатура.Ссылка = &КассовыйУзелСсылка";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
		Запрос.УстановитьПараметр("НоменклатураСсылка", НоменклатураСсылка);
		РезультатЗапроса = Запрос.Выполнить(); 
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			// Подчиненный элемент есть в ТЧ Кассового узла
			Результат = Истина;
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверим не указан ли в ТЧ КУ кто либо из родителей
	// Получим всех вышестоящих родителей вида меню
	Если ЗначениеЗаполнено(НоменклатураСсылка.Родитель) Тогда 
		МассивРодителей = ПолучитьВсехВышестоящихРодителейСправочника(НоменклатураСсылка, "Номенклатура");
		Если ЗначениеЗаполнено(МассивРодителей) Тогда
			
			Счетчик = 0;
			ТЗРодителей = Новый ТаблицаЗначений;
			ТЗРодителей.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
			ТЗРодителей.Колонки.Добавить("ИД", ОбщегоНазначения.ОписаниеТипаЧисло(3));
			Для Каждого ТекЭлемент Из МассивРодителей Цикл
				НоваяСтрока = ТЗРодителей.Добавить();
				НоваяСтрока.Ссылка = ТекЭлемент;
				НоваяСтрока.ИД = Счетчик;
				Счетчик = Счетчик + 1;
			КонецЦикла;
			
			// Выполним запрос на наличие родителей в ТЧ КУ.
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ТабРодителей.Ссылка КАК Ссылка,
			|	ТабРодителей.ИД КАК ИД
			|ПОМЕСТИТЬ ТЗРодителей
			|ИЗ
			|	&ТабРодителей КАК ТабРодителей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	УдаленныеКассыНоменклатура.Номенклатура КАК Номенклатура,
			|	УдаленныеКассыНоменклатура.ТолькоИерархия КАК ТолькоИерархия
			|ИЗ
			|	ТЗРодителей КАК ТЗРодителей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.питУдаленныеКассы.Номенклатура КАК УдаленныеКассыНоменклатура
			|		ПО (УдаленныеКассыНоменклатура.Номенклатура = ТЗРодителей.Ссылка)
			|			И (УдаленныеКассыНоменклатура.Ссылка = &КассовыйУзелСсылка)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ИД УБЫВ";
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
			Запрос.УстановитьПараметр("ТабРодителей", ТЗРодителей);
			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Если Выборка.Следующий() Тогда
					Если ЭтоГруппа Тогда
						Результат = Истина;
					Иначе
						Результат = НЕ Выборка.ТолькоИерархия;
					КонецЕсли;
				КонецЕсли;
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НоменклатураМожноОтправлятьВКУ()

// Функция проверки наличия номенклатуры в индивидуальном списке меню
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура - Ссылка на проверяемую в номенклатур.
//  КассовыйУзелСсылка - ПланыОбменаСсылка.УдаленныеКассы - Ссылка на удаленный кассовый узел.
//
// Возвращаемое значение:
//  Булево - Результат проверки
Функция НоменклатураЕстьВВидахМенюУзла(НоменклатураСсылка, КассовыйУзелСсылка)
	
	Результат = Ложь;
	
	Если НЕ КассовыйУзелСсылка.ИндивидуальныйСписокВидовМенюИНоменклатуры Тогда 
		СоответствиеНоменклатуры = питОбменДаннымиПовтИсп.ПолучитьНоменклатуруВВидовМеню("Соответствие");
	Иначе
		СоответствиеНоменклатуры = питОбменДаннымиПовтИсп.ПолучитьНоменклатуруВВидовМенюУзла(КассовыйУзелСсылка, "Соответствие");
	КонецЕсли;
	
	Если СоответствиеНоменклатуры = Неопределено Тогда
		Возврат Результат; // Ложь
	Иначе 
		// Поиск по номенклатуре видов меню
		ЗначениеПоиска = СоответствиеНоменклатуры.Получить(НоменклатураСсылка);
		Результат = НЕ (ЗначениеПоиска =Неопределено);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НоменклатураЕстьВВидахМенюУзла()

// Функция проверки наличия номенклатуры в модификаторах или наборах модификаторах
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура - Ссылка на проверяемую в номенклатур.
//
// Возвращаемое значение:
//  Булево - Результат проверки
Функция НоменклатураЕстьВМодификаторахУзла(НоменклатураСсылка)
	
	Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат Ложь; // Пустые и битые ссылки отправлять в КУ не следует
	КонецЕсли;
	
	// Получим список всех подчиненных номенклатур, т.к. возможно модификатор привязан к ним.
	// Получим первый связанный модификатор, т.к. интересно лишь наличие.
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_МассивПодчиненнойНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Модификаторы.ДопНоменклатура КАК Ссылка
	|ИЗ
	|	Справочник.питМодификаторы КАК Модификаторы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МассивПодчиненнойНоменклатуры КАК ВТ_МассивПодчиненнойНоменклатуры
	|		ПО Модификаторы.ДопНоменклатура = ВТ_МассивПодчиненнойНоменклатуры.Ссылка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции // НоменклатураЕстьВМодификаторахУзла

// Функция проверки наличия правил маршрутизации для данной номенклатуры
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура - Ссылка на проверяемую в номенклатур.
//  КассовыйУзелСсылка - ПланыОбменаСсылка.УдаленныеКассы - Ссылка на удаленный кассовый узе.
//
// Возвращаемое значение:
//  Булево - Результат проверки
Функция НоменклатураЕстьВМаршрутизацииПечати(НоменклатураСсылка, КассовыйУзелСсылка) 
	
	Результат = Ложь;
	
	Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		// Пустые и битые ссылки отправлять в КУ не следует
		Возврат Результат; // Ложь
	КонецЕсли;
	
	// Определим режим настройки КУ
	Если КассовыйУзелСсылка.ПравилаПередачиМаршрутизации = 0 Тогда
		
		// Настройка маршрутизации задаются в КУ
		Возврат Результат; // Ложь
		
	ИначеЕсли КассовыйУзелСсылка.ПравилаПередачиМаршрутизации = 1 Тогда
		// Настройка маршрутизации печати не привязаны к конкретному узлу
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МаршрутизацияПечати.Номенклатура КАК Ссылка
		|ИЗ
		|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
		|ГДЕ
		|	МаршрутизацияПечати.КассовыйУзел = ЗНАЧЕНИЕ(ПланОбмена.питУдаленныеКассы.ПустаяСсылка)
		|	И МаршрутизацияПечати.Номенклатура В ИЕРАРХИИ(&НоменклатураСсылка)";
		
		Запрос.УстановитьПараметр("НоменклатураСсылка", НоменклатураСсылка);
		Результат = НЕ Запрос.Выполнить().Пустой();
		
	ИначеЕсли КассовыйУзелСсылка.ПравилаПередачиМаршрутизации = 2 Тогда 
		// Настройка маршрутизации печати заданы для конкретно этого узла (что в параметре передан)
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МаршрутизацияПечати.Номенклатура КАК Ссылка
		|ИЗ
		|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
		|ГДЕ
		|	МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел
		|	И МаршрутизацияПечати.Номенклатура В ИЕРАРХИИ(&НоменклатураСсылка)";
		
		Запрос.УстановитьПараметр("НоменклатураСсылка", НоменклатураСсылка);
		Запрос.УстановитьПараметр("КассовыйУзел", КассовыйУзелСсылка);
		
		Результат = НЕ Запрос.Выполнить().Пустой();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НоменклатураЕстьВМаршрутизацииПечати

// Функция проверки наличия правил маршрутизации для данной номенклатуры
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура - Ссылка на проверяемую в номенклатур.
//  КассовыйУзелСсылка - ПланыОбменаСсылка.УдаленныеКассы - Ссылка на удаленный кассовый узе.
//  ЭтоГруппа - Произвольный - Это группа.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Булево - Результат проверки
Функция НоменклатураЕстьВСвязанныхИнгредиентах(НоменклатураСсылка, КассовыйУзелСсылка, ЭтоГруппа, ДопПараметры) 
	
	Результат = Ложь;
	Если ЭтоГруппа = Неопределено Тогда
		ЭтоГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураСсылка, "ЭтоГруппа", Ложь);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ДопПараметры.Свойство("НоменклатураПроверкиСвязанныхИнгредиентов") Тогда
		ДопПараметры.Вставить("НоменклатураПроверкиСвязанныхИнгредиентов", Неопределено);
	КонецЕсли;
	Если НЕ ДопПараметры.Свойство("СчетчикПроверкиСвязанныхИнгредиентов") Тогда
		ДопПараметры.Вставить("СчетчикПроверкиСвязанныхИнгредиентов", 0);
	КонецЕсли;
	
	Если ДопПараметры.НоменклатураПроверкиСвязанныхИнгредиентов = НоменклатураСсылка Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Проверка номенклатуры %1 на известность узлу завершилась с ошибкой:
		|алкогольный ингредиент рекурсивно ссылается сам на себя'"), ДопПараметры.НоменклатураПроверкиСвязанныхИнгредиентов);
		Событие = "УдаленныеКассы.Выгрузка";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		// Переполнение глубины анализа.
		Возврат Результат;
	КонецЕсли;
	
	Если ДопПараметры.НоменклатураПроверкиСвязанныхИнгредиентов = Неопределено Тогда
		ДопПараметры.НоменклатураПроверкиСвязанныхИнгредиентов = НоменклатураСсылка;
	КонецЕсли;
	
	Если ДопПараметры.СчетчикПроверкиСвязанныхИнгредиентов >= 10 Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Проверка номенклатуры %1 на известность узлу завершилась с ошибкой:
		|превышено максимальное значение глубины поиска'"), ДопПараметры.НоменклатураПроверкиСвязанныхИнгредиентов);
		Событие = "УдаленныеКассы.Выгрузка";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		// Переполнение глубины анализа.
		Возврат Результат;
	КонецЕсли;
	ДопПараметры.СчетчикПроверкиСвязанныхИнгредиентов = ДопПараметры.СчетчикПроверкиСвязанныхИнгредиентов + 1;
	
	Если ЭтоГруппа Тогда
		ПроверяемаяНоменклатура = питОбщегоНазначения.ПолучитьИерархиюЭлементов(НоменклатураСсылка,, Истина, Ложь);
	Иначе
		ПроверяемаяНоменклатура = НоменклатураСсылка;
	КонецЕсли;


	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	МаркированныеАналогиСостав.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ГруппыАналогов
	|ИЗ
	|	Справочник.питМаркированныеАналоги.Состав КАК МаркированныеАналогиСостав
	|ГДЕ
	|	МаркированныеАналогиСостав.Номенклатура В(&ПроверяемаяНоменклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АлкогольныеРецептуры.Блюдо КАК Блюдо,
	|	СпрНоменклатура.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	РегистрСведений.питАлкогольныеРецептуры КАК АлкогольныеРецептуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО АлкогольныеРецептуры.Блюдо = СпрНоменклатура.Ссылка
	|ГДЕ
	|	АлкогольныеРецептуры.Ингредиент В(&ПроверяемаяНоменклатура)
	|	И НЕ СпрНоменклатура.ЭтоГруппа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АлкогольныеРецептуры.Блюдо,
	|	СпрНоменклатура.ЭтоГруппа
	|ИЗ
	|	ВТ_ГруппыАналогов КАК ВТ_ГруппыАналогов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.питАлкогольныеРецептуры КАК АлкогольныеРецептуры
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ПО АлкогольныеРецептуры.Блюдо = СпрНоменклатура.Ссылка
	|		ПО ВТ_ГруппыАналогов.Ссылка = АлкогольныеРецептуры.ГруппаАналогов
	|ГДЕ
	|	НЕ СпрНоменклатура.ЭтоГруппа";
	Запрос.УстановитьПараметр("ПроверяемаяНоменклатура", ПроверяемаяНоменклатура);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Если продукция известна, то известен и ингредиент.
		Результат = НоменклатураИзвестнаУзлу(Выборка.Блюдо, КассовыйУзелСсылка, Выборка.ЭтоГруппа, ДопПараметры);
		Если Результат Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;
	
	ДопПараметры.СчетчикПроверкиСвязанныхИнгредиентов = ДопПараметры.СчетчикПроверкиСвязанныхИнгредиентов - 1;
	Если ДопПараметры.СчетчикПроверкиСвязанныхИнгредиентов < 1 Тогда
		ДопПараметры.СчетчикПроверкиСвязанныхИнгредиентов = 0;
	КонецЕсли;
	Если ДопПараметры.НоменклатураПроверкиСвязанныхИнгредиентов = НоменклатураСсылка Тогда
		ДопПараметры.НоменклатураПроверкиСвязанныхИнгредиентов = Неопределено;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

// Выполняет чтение всего сообщения
//
// Параметры:
//  ЧтениеXML - Произвольный - Чтение xml.
//  УзелОбмена - Произвольный - Узел обмена.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ПрочитатьСообщение(ЧтениеXML, УзелОбмена, ДопПараметры)
	
	ПрочитатьЗаголовокСообщения(ЧтениеXML, ДопПараметры);
	Если НЕ ДопПараметры.ЗаголовокПрочтен Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ДопПараметры.РабочийРежим И НЕ (ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя="Response") Тогда
		ДопПараметры.Вставить("Ошибка", "Обмен возможен только для рабочего режима работы.");
		ДопПараметры.НомерОтправленного = 0;		
		Возврат;
	КонецЕсли;
	
	Если ДопПараметры.НомерПринятого = 0 Тогда
		ДопПараметры.НомерПринятого = 1;
	КонецЕсли; 
	ПланыОбмена.УдалитьРегистрациюИзменений(ДопПараметры.Отправитель, ДопПараметры.НомерПринятого);
	
	Отказ = Ложь;
	
	ПрочитатьИзменения(ЧтениеXML, УзелОбмена, ДопПараметры, Отказ);
	
	ЧтениеXML.Закрыть();
	Если Отказ Тогда
		ТекстОшибки = "";
		Если ДопПараметры.Свойство("ТекстОшибки",ТекстОшибки) И НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	
	
	Если НЕ Отказ И ЗначениеЗаполнено(ДопПараметры.ТаблицаЧековОбщепита) Тогда
		
		ТабСтруктурыОбъекта = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта("Check");
		СвойстваОбъектаЧекОбщепита = Новый Структура("ЭтоГруппа", Ложь);
		ТаблицаРазличныхДат = ДопПараметры.ТаблицаЧековОбщепита.Скопировать(,"ДатаДокумента");
		ТаблицаРазличныхДат.Свернуть("ДатаДокумента");
		
		
		// Разделим таблицу документов на несколько таблиц значений (в зависимости от количества различных дат).
		Для Каждого ТекДата Из ТаблицаРазличныхДат Цикл 
			
			// Найдем все строки в таблице по дате.
			ПараметрыОтбора = Новый Структура("ДатаДокумента", ТекДата.ДатаДокумента);
			ТаблицаДокументовПоДате = ДопПараметры.ТаблицаЧековОбщепита.Скопировать(ПараметрыОтбора);
			
			Если ТаблицаДокументовПоДате.Количество() > 0 Тогда
				
				ДопПараметры.ДокументыДляЗагрузкиИзДанныхПродаж = Новый Массив;
				НачатьТранзакцию();
				
				Для Каждого ТекСтрока Из ТаблицаДокументовПоДате Цикл
					
					Если ТекСтрока.Объект = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ТекСтрока.Объект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
					
					Результат = ВыполнитьЗаписьОбъекта(ТекСтрока.Объект, ТабСтруктурыОбъекта, ДопПараметры, Истина, Ложь, СвойстваОбъектаЧекОбщепита);
					Если НЕ Результат Тогда
						Отказ = Истина;
					КонецЕсли;
					
				КонецЦикла;
				
				Если Отказ Тогда
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
				
				// Выполним обработку документов
				Попытка
					
					Если ЗначениеЗаполнено(ДопПараметры.ДокументыДляЗагрузкиИзДанныхПродаж) Тогда
						// Выполним обработку документов
						ТекстОшибки = "";
						Обработки.питЗагрузкаИзДанныхПродажФронта.ЗарегистрироватьИзмененияДанныхПродажФронта(ДопПараметры.ДокументыДляЗагрузкиИзДанныхПродаж, ТекстОшибки);
						Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
							ОтменитьТранзакцию();
							ВызватьИсключение ТекстОшибки;
						КонецЕсли;
					КонецЕсли;
					ЗафиксироватьТранзакцию();
					
				Исключение
					
					Отказ = Истина;
					Если ТранзакцияАктивна() Тогда
						ОтменитьТранзакцию();
					КонецЕсли;
					ИнфОбОшибке = ИнформацияОбОшибке();
					ТекстОшибки = ИнфОбОшибке.Описание;
					Пока ИнфОбОшибке.Причина <> Неопределено Цикл
						ИнфОбОшибке = ИнфОбОшибке.Причина;
						ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
					КонецЦикла;
					ТекстВывести = "Не удалось записать данные о продажах в регистр по причине:" + Символы.ПС + ТекстОшибки;
					ЗаписьЖурналаРегистрации("УдаленныеКассы.Загрузка.Чтение", УровеньЖурналаРегистрации.Ошибка, , УзелОбмена, ТекстОшибки);
					
				КонецПопытки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДопПараметры.Вставить("РезультатЧтения", НЕ Отказ);
	
	// Создание целевых документов на основании загруженных первичных документов.
	Если ДопПараметры.ВыполнятьЗагрузкуИзДанныхПродажФронта Тогда
		ВыполнитьЗагрузкуИзДанныхПродаж(ДопПараметры);
	КонецЕсли;
	
	// Создание записей о данных продаж в регистре
	Если НЕ Отказ И Константы.питВыполнятьПроведениеЧековОбщепита.Получить() И ДопПараметры.Свойство("ЧекиНаПроведение")
		И ДопПараметры.ЧекиНаПроведение.Количество() Тогда
		
		// Параметры обернем в структуру для их передачи 
		// через механизм ДлительныеОперации.
		ПараметрыФункции = Новый Структура();
		ПараметрыФункции.Вставить("МассивВыбранныхЧеков",               ДопПараметры.ЧекиНаПроведение);
		ПараметрыФункции.Вставить("СообщатьПрогрессВыполнения",               Ложь);

		НаименованиеФоновогоЗадания = НСтр("ru = 'Проведение чеков общепита'");
		
		ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		(Новый УникальныйИдентификатор), 
		"Обработки.питПроведениеЧековОбщепита.ПровестиЧекиОбщепита", 
		ПараметрыФункции, 
		НаименованиеФоновогоЗадания);
		
	КонецЕсли;
	
КонецПроцедуры

// Выполняет чтение заголовка сообщения.
//
// Параметры:
//  ЧтениеXML - Произвольный - Чтение xml.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ПрочитатьЗаголовокСообщения(ЧтениеXML, ДопПараметры)
	
	ЧтениеXML.Прочитать();
	СвойстваЗаголовка = Новый Структура;
	Если ЧтениеXML.Имя = "Response" Тогда
		Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
			СвойстваЗаголовка.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
		КонецЦикла; 
	КонецЕсли;
	
	ДопПараметры.Вставить("РабочийРежим",     Ложь);
	ДопПараметры.Вставить("ЗаголовокПрочтен", Истина);
	ДопПараметры.Вставить("ВерсияФронтОфиса", "");
	ОшибкиИзменения = "";
	Для каждого ТекСвойство Из СвойстваЗаголовка Цикл
		
		Если ТекСвойство.Ключ = "reqnum" Тогда
			ДопПараметры.НомерПринятого = XMLЗначение(Тип("Число"), ТекСвойство.Значение);
		КонецЕсли; 
		
		Если ТекСвойство.Ключ = "respnum" Тогда
			ДопПараметры.НомерОтправленного = XMLЗначение(Тип("Число"), ТекСвойство.Значение);
		КонецЕсли;
		
		Если ТекСвойство.Ключ = "work" Тогда
			ДопПараметры.РабочийРежим = СтрокаВБулево(ТекСвойство.Значение);
		КонецЕсли;
		
		Если ТекСвойство.Ключ = "error" Тогда
			ОшибкиИзменения = СокрЛП(ТекСвойство.Значение);
		КонецЕсли;
		
		Если ТекСвойство.Ключ = "build" Тогда
			ДопПараметры.ВерсияФронтОфиса = СокрЛП(ТекСвойство.Значение);
		КонецЕсли;
		
	КонецЦикла; 
	
	ОшибкиОбновления = "";
	Если ЧтениеXML.Имя = "Update" Тогда
		ЧтениеXML.ПрочитатьАтрибут();
		Если ЧтениеXML.Имя = "error" Тогда
			ОшибкиОбновления = ЧтениеXML.Значение;
		КонецЕсли; 
	КонецЕсли; 
	
	ЗаголовокПрочтен = Ложь;
	ИдентификаторОтправителя = Неопределено;
	СвойстваЗаголовка.Свойство("databaseid", ИдентификаторОтправителя);
	Если ЗначениеЗаполнено(ИдентификаторОтправителя) Тогда
		Попытка
			Отправитель = ПолучитьСсылкуПоИД(ИдентификаторОтправителя, ПланыОбмена.питУдаленныеКассы);
		Исключение
			Отправитель = Неопределено;
		КонецПопытки; 
		Если Отправитель = Неопределено Тогда
			ЗаголовокПрочтен = Ложь; // Узла нет среди существующих кассовых узлов
			ТекстСобытия =	"Идентификатор базы фронт-офиса отсутствует среди кассовых узлов в данной базе.
							|Возможно кассовый узел, сообщение которого необходимо прочитать, обменивается с другим БЭК-офисом.";
		ИначеЕсли Отправитель <> ДопПараметры.Отправитель Тогда
			ЗаголовокПрочтен = Ложь; // Узел есть, но не тот
			ТекстСобытия = 	"Идентификатор базы фронт-офиса не совпадает с идентификатором кассового узла <" + СокрЛП(ДопПараметры.Отправитель) + ">
							|Возможно кассовый узел, сообщение которого необходимо прочитать, обменивается с другим БЭК-офисом.";
		Иначе
			ЗаголовокПрочтен = Истина;
		КонецЕсли; 
	Иначе
		ЗаголовокПрочтен = Истина;
	КонецЕсли; 
	
	
	ДопПараметры.Вставить("ЗаголовокПрочтен", ЗаголовокПрочтен);
	Если НЕ ЗаголовокПрочтен Тогда
		ДопПараметры.Вставить("Ошибка", ТекстСобытия);
	КонецЕсли; 
			
	Если НЕ ПустаяСтрока(ОшибкиОбновления) Тогда
		ДопПараметры.Вставить("ЗаголовокПрочтен", Ложь);
		ДопПараметры.Вставить("ТекстОшибки", "Кассовый узел: " + Строка(ДопПараметры.Отправитель) 
			+ " сообщает об ошибке обновления данных " + Символы.ПС
			+ "<" + ОшибкиОбновления + ">");
	КонецЕсли; 
		
	ЧтениеXML.Прочитать();	
	Если ЧтениеXML.Имя = "Changes" Тогда
		ЧтениеXML.ПрочитатьАтрибут();
		Если ЧтениеXML.Имя = "error" Тогда
			ОшибкиИзменения = ЧтениеXML.Значение;
		КонецЕсли; 
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(ОшибкиИзменения) Тогда
		ДопПараметры.Вставить("ЗаголовокПрочтен", Ложь);
		ДопПараметры.Вставить("ТекстОшибки", "Кассовый узел: " + Строка(ДопПараметры.Отправитель) + " сообщает об ошибке загрузки данных: " + Символы.ПС + "<" + ОшибкиИзменения + ">"); 
	КонецЕсли; 
	
КонецПроцедуры

// Выполняет чтение основной информации в сообщении обмена.
//
// Параметры:
//  ЧтениеXML - Произвольный - Чтение xml.
//  УзелОбмена - Произвольный - Узел обмена.
//  ДопПараметры - Произвольный - Доп параметры.
//  Отказ - Булево - Отказ.
//
Процедура ПрочитатьИзменения(ЧтениеXML, УзелОбмена, ДопПараметры, Отказ)
	
	СоздатьТаблицуЕдиницИзмерения(ДопПараметры);
	КоличествоЭлементовВТранзакции = ДопПараметры.КоличествоЭлементовВТранзакции;
	
	ДокументыДляПроведения = Новый Массив;
	ДокументыДляЗагрузкиИзДанныхПродаж = Новый Массив;
	ТаблицаДокументов = Неопределено;
	ЭлементДанных = Неопределено;
	
	НастройкаДоставкиСсылка = Неопределено;
	Если ДопПараметры.Свойство("НастройкаОбмена") Тогда
		НастройкаДоставкиСсылка = ДопПараметры.НастройкаОбмена;
	КонецЕсли;
	
	ВестиСистемныйПротокол = Неопределено;
	Если ДопПараметры.Свойство("ВестиЖурналРегистрации") Тогда
		ВестиСистемныйПротокол = ДопПараметры.ВестиЖурналРегистрации;
	КонецЕсли;
	
	ФиксироватьПриемОтправкуОбъектов = Неопределено;
	Если ДопПараметры.Свойство("Комментировать") Тогда
		ФиксироватьПриемОтправкуОбъектов = ДопПараметры.Комментировать;
	КонецЕсли;
	
	КоличествоОшибок = 0;
	КоличествоЗапись = 0;
	УдаленоКоллекций = 0;
	КоличествоПометок = 0;
	КоличествоОбъект = 0;
	КоличествоВообще = 0;
	КоличествоТранзакций = 0;
	
	Событие = "УдаленныеКассы.Загрузка.РазборСообщения";
	Если НастройкаДоставкиСсылка = Неопределено Тогда
		// Получим настройку доставки
		НастройкаДоставкиСсылка = ДопПараметры.НастройкаДоставкиПоУмолчанию;
	КонецЕсли;
	
	Если (ДопПараметры.ВестиЖурналРегистрации = Неопределено) И ЗначениеЗаполнено(НастройкаДоставкиСсылка) Тогда
		ВестиСистемныйПротокол = НастройкаДоставкиСсылка.ВестиСистемныйПротокол;
	Иначе
		ВестиСистемныйПротокол = Истина;
	КонецЕсли;
	
	Если (ФиксироватьПриемОтправкуОбъектов = Неопределено) И ЗначениеЗаполнено(НастройкаДоставкиСсылка) Тогда
		ФиксироватьПриемОтправкуОбъектов = НастройкаДоставкиСсылка.ФиксироватьПриемОтправкуОбъектов;
	Иначе
		ФиксироватьПриемОтправкуОбъектов = Ложь;
	КонецЕсли;
	
	НачатьТранзакцию();
	НомерЗаписи = 0;
	
	Попытка // мало ли что случится
		
		Пока ЧтениеXML.Прочитать() Цикл
			
			ИмяУзла = ЧтениеXML.Имя;
			
			Если (ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
				Если (ИмяУзла = "Request") ИЛИ (ИмяУзла = "Changes") Тогда
					// Урра! Добрались до конца файла, ну или по крайней мере дальше нам не интересно
					Прервать; 
				КонецЕсли;
				// А иначе это закрывающий тег какого-то предыдущего узла объекта или элемента коллекции
				Продолжить; // читам дальше
			
			ИначеЕсли (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
				// Начало нового узла в XML, кто бы он ни был атрибуты мы его сразу считаем
				ИмяОбъекта = ""; //если повезет (а должно!) то и имя объекта сразу же узнаем
				АтрибутыИзXML = ПрочитатьАтрибуты(ЧтениеXML, ИмяОбъекта);
				
				Если (ИмяУзла = "Object") Тогда
					
					Если ПустаяСтрока(ИмяОбъекта) Тогда
						// Без имени не играем!
						ТекстОшибки = "Обнаружен объект без имени - пропускается!";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , УзелОбмена, ТекстОшибки);
						ЧтениеXML.Пропустить();	
						Продолжить;
					КонецЕсли;
					
					// Если по правилам в макете объект с таким именем не загружается
					Если НЕ ДопПараметры.ТаблицаМетаданныхДляЗагрузки.НайтиСтроки(Новый Структура("Дескриптор",ИмяОбъекта)).Количество() Тогда
						// Без имени не играем!
						ТекстОшибки = "Обнаружен объект <"+ИмяОбъекта+">, 
							|который не загружается по правилам макета. Данный объект будет пропущен!";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , УзелОбмена, ТекстОшибки);
						ЧтениеXML.Пропустить();
						Продолжить;
					КонецЕсли;
					
					// Ныряем в процедуру разбора / чтения / получения / сохранения в базу пришедшего по обмену объекта данных
					ОбъектовБыло = КоличествоОбъект;
					Если ВыполнитьЧтениеОбъекта(ЧтениеXML, ИмяОбъекта, АтрибутыИзXML, ФиксироватьПриемОтправкуОбъектов, ДопПараметры, , КоличествоОбъект) Тогда
						КоличествоВообще = КоличествоВообще + (КоличествоОбъект - ОбъектовБыло);
					Иначе
						КоличествоОшибок = КоличествоОшибок + 1;
					КонецЕсли;
					
				ИначеЕсли (ИмяУзла = "DeleteObject") Тогда
					Если ПустаяСтрока(ИмяОбъекта) Тогда
						// Без имени не играем!
						ТекстОшибки = "Запрошено удаление объекта без имени - команда не может быть отработана, пропускается!";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , УзелОбмена, ТекстОшибки);
						ЧтениеXML.Пропустить();	
					КонецЕсли;
					
					// Отработаем команду-запрос на удаления объекта в нашей базе
					Если ВыполнитьУдалениеОбъекта(АтрибутыИзXML, ИмяОбъекта, ФиксироватьПриемОтправкуОбъектов, ДопПараметры) Тогда
						КоличествоПометок = КоличествоПометок + 1;
					КонецЕсли;
						
					
				ИначеЕсли (ИмяУзла = "Collection") Тогда	
					Если ПустаяСтрока(ИмяОбъекта) Тогда
						// Без имени не играем!
						ТекстОшибки = "Обнаружены записи коллекции без имени - пропускается!";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , УзелОбмена, ТекстОшибки);
						ЧтениеXML.Пропустить();	
					КонецЕсли;
					
					ПараметрыОчистки = Неопределено;
					Если АтрибутыИзXML.Свойство("clearcond", ПараметрыОчистки) И НЕ ПустаяСтрока(ПараметрыОчистки) Тогда
						// Пришла команда очистки записей в регистре по указанным условиям отбора
						Если ВыполнитьУдаленияКоллекции(ИмяОбъекта, ПараметрыОчистки, ДопПараметры,УдаленоКоллекций, ФиксироватьПриемОтправкуОбъектов) Тогда
							// УдаленоКоллекций уже в параметре учли
						// Иначе
						// 	КоличествоОшибок = КоличествоОшибок + 1;
						КонецЕсли;
					КонецЕсли;
					
					// Если по правилам в макете коллекция с таким именем не загружается
					Если НЕ ДопПараметры.ТаблицаМетаданныхДляЗагрузки.НайтиСтроки(Новый Структура("Дескриптор",ИмяОбъекта)).Количество() Тогда
						// Без имени не играем!
						ТекстОшибки = "Обнаружена запись коллекции <"+ИмяОбъекта+">, 
							|которая не загружается по правилам макета. Данная запись будет пропущена!";
						ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , УзелОбмена, ТекстОшибки);
						ЧтениеXML.Пропустить();
						Продолжить;
					КонецЕсли;
					
					// Ныряем в процедуру разбора присланных данных коллекции (записей регистра сведений)
					Результат = ВыполнитьЧтениеОбъектаРегистраСведений(ЧтениеXML, ИмяОбъекта, АтрибутыИзXML, ФиксироватьПриемОтправкуОбъектов, ДопПараметры, ТекстОшибки);
					Если Результат = Неопределено Тогда
						// объект проигнорирован
					ИначеЕсли Результат Тогда
						КоличествоЗапись = КоличествоЗапись + 1;
					Иначе
						КоличествоОшибок = КоличествоОшибок + 1;
					КонецЕсли;
					
				ИначеЕсли (ИмяУзла = "Settings") Тогда
					
					ПрочитатьНастройкиУзла(ЧтениеXML, ДопПараметры);
					
				ИначеЕсли (ИмяУзла = "Update")  Тогда
					ЧтениеXML.Пропустить();
					Продолжить; // не должно быть, но какие-то сторонние БЭКи зачем-то нам это посылают...
					
				КонецЕсли; // case по именам узла
				
			КонецЕсли; // case по типам узла
			
			Если КоличествоЭлементовВТранзакции <> 0 Тогда
				НомерЗаписи = НомерЗаписи + 1;
				Если НомерЗаписи%КоличествоЭлементовВТранзакции = 0 Тогда
					ЗафиксироватьТранзакцию();
					НачатьТранзакцию();
				КонецЕсли; 
			КонецЕсли;
			
		КонецЦикла; // по узлам в XML
		
	Исключение
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = "При разборе файла сообщения произошла ошибка исключения - " + ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		
		// Отменим всю транзакцию чтения
		Попытка // в попытке на случай если исключение возникло при вызове ЗафиксироватьТранзакцию
			ОтменитьТранзакцию();
		Исключение
			// ничего тут не поделать
		КонецПопытки;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , УзелОбмена, ТекстОшибки);
		
		Если КоличествоОшибок > 0 Тогда
			ТекстСообщения = "При чтении сообщения обмена всего было зафиксировано ошибок и предупреждений в количестве: " + КоличествоОшибок;
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , УзелОбмена, ТекстСообщения);
		КонецЕсли;
		
		КоличествоОшибок = - 1; // флаг что все совсем плохо
		
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

// Процедура создания таблицы для записи единиц измерения в дополнительных параметрах.
//
// Параметры:
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура СоздатьТаблицуЕдиницИзмерения(ДопПараметры)
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("ID");
	ТаблицаЗначений.Колонки.Добавить("Name");
	ТаблицаЗначений.Колонки.Добавить("Active");
	ТаблицаЗначений.Колонки.Добавить("OwnerID");
	ТаблицаЗначений.Колонки.Добавить("ClassifierID");
	ТаблицаЗначений.Колонки.Добавить("ClassID");
	ТаблицаЗначений.Колонки.Добавить("ClassCode");
	ТаблицаЗначений.Колонки.Добавить("ClassName");
	ТаблицаЗначений.Колонки.Добавить("ClassFullName");
	ТаблицаЗначений.Колонки.Добавить("Koeff");
	ТаблицаЗначений.Колонки.Добавить("Weight");
	ТаблицаЗначений.Колонки.Добавить("Accuracy");
	
	ДопПараметры.Вставить("ЕдиницыИзмерения", ТаблицаЗначений);
	
КонецПроцедуры

// Считывает атрибуты тега XML в отдельную структуру.
//
// Параметры:
//  ЧтениеXML - Произвольный - Чтение xml.
//
// Возвращаемое значение:
// 	Произвольный - Нет.	
Функция ПрочитатьСвойстваОбъектаXML(ЧтениеXML)
	СвойстваОбъекта = Новый Структура;
	
	Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
		Если ЧтениеXML.Имя = "Name" ИЛИ ЧтениеXML.Имя = "ExtrnCode" Тогда
			ЗначениеАтрибута = СокрП(ЧтениеXML.Значение);
		Иначе
			ЗначениеАтрибута = ЧтениеXML.Значение; 
		КонецЕсли; 
		СвойстваОбъекта.Вставить(ЧтениеXML.Имя, ЗначениеАтрибута);
	КонецЦикла;
	
	Возврат СвойстваОбъекта;
	
КонецФункции

// Производит чтение настроек кассового узла.
//
// Параметры:
//  ЧтениеXML - Произвольный - Чтение xml.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ПрочитатьНастройкиУзла(ЧтениеXML, ДопПараметры)
	
	Пока Истина Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Settings" Тогда
			
			Прервать;
			
		ИначеЕсли ЧтениеXML.Имя = "Item" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			// Чтение атрибутов XML
			СвойстваОбъекта = ПрочитатьСвойстваОбъектаXML(ЧтениеXML);
			
			ИмяНастройки = Неопределено;
			СвойстваОбъекта.Свойство("Key", ИмяНастройки);
			ИмяНастройки = СтрЗаменить(СокрЛП(ИмяНастройки), " ", "");
			
			ЗначениеНастройки = Неопределено;
			СвойстваОбъекта.Свойство("Value", ЗначениеНастройки);
			ЗначениеНастройки = СокрЛП(ЗначениеНастройки);
			
			Если ИмяНастройки = "ModeSplitCheck" Тогда
				
				ИмяНастройки = "РазделениеЧеков";
				ЗначениеНастройки = СтрокаВЧисло(ЗначениеНастройки);
				Если ЗначениеНастройки = 1 Тогда
					ЗначениеНастройки = Перечисления.питВариантыРазделенияЧеков.ПоОрганизациямНоменклатуры;
				Иначе
					ЗначениеНастройки = Перечисления.питВариантыРазделенияЧеков.НеРазделять;
				КонецЕсли; 
				
			ИначеЕсли ИмяНастройки = "Organization" Тогда
				ИмяНастройки = "Организация";
				ЗначениеНастройки = ПолучитьСсылкуПоИД(ЗначениеНастройки, Справочники.Организации);
				
			ИначеЕсли ИмяНастройки = "IndividualMenu" Тогда
				ИмяНастройки = "ИндивидуальныйСписокВидовМенюИНоменклатуры";
				ЗначениеНастройки = СтрокаВБулево(ЗначениеНастройки);
				
			Иначе
				Продолжить;
			КонецЕсли; 
			ДопПараметры.Вставить(ИмяНастройки, ЗначениеНастройки);
			
		Иначе
			ЧтениеXML.Прочитать();
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура регистрирует всю номенклатуру, находящуюся в группах, в которых стоит флаг "Выгружать во фронт-офис",
//  а также родителей этих групп вверх по иерархии.
//
// Параметры:
//  УзелОбмена - ПланОбменаСсылка.питУдаленныеКассы - Ссылка на узел, для которого регистрируем.
//  ПараметрыУзла - Произвольный - Параметры узла.
//
Процедура ЗарегистрироватьВсюНоменклатуруДляУзла(УзелОбмена, ПараметрыУзла)
	
	Если НЕ ПараметрыУзла.ИндивидуальныйСписокНоменклатуры Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Номенклатура);
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьНоменклатуруПоИндивидуальномуСписку(УзелОбмена, ПараметрыУзла);
	ЗарегистрироватьНоменклатуруПоВидамМенюУзла(УзелОбмена, ПараметрыУзла);
	ЗарегистрироватьНоменклатуруПоМодификаторам(УзелОбмена, ПараметрыУзла);
	ЗарегистрироватьНоменклатуруПоМаршрутизацииПечати(УзелОбмена, ПараметрыУзла);
	ЗарегистрироватьНоменклатуруПоСвязаннымИнгредиентам(УзелОбмена, ПараметрыУзла);
	
КонецПроцедуры

// Процедура - Зарегистрировать номенклатуру по индивидуальному списку.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ПараметрыУзла - Произвольный - Параметры узла.
//
Процедура ЗарегистрироватьНоменклатуруПоИндивидуальномуСписку(УзелОбмена, ПараметрыУзла)
	
	Если НЕ ПараметрыУзла.ИндивидуальныйСписокНоменклатуры Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Номенклатура);
		Возврат;
	КонецЕсли;
	// Выполним ряд запросов:
	// 1. Получим известную номенклатуру узла
	// 2. Дополним их подчиненными элементами.
	// 3. Возьмем все элементы и получим для них иерархию вверх.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питУдаленныеКассыНоменклатура.Номенклатура КАК Номенклатура,
	|	питУдаленныеКассыНоменклатура.ТолькоИерархия КАК ТолькоИерархия
	|ПОМЕСТИТЬ ВТ_НоменклатураУзла
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.Номенклатура КАК питУдаленныеКассыНоменклатура
	|ГДЕ
	|	питУдаленныеКассыНоменклатура.Ссылка = &Ссылка
	|	И НЕ питУдаленныеКассыНоменклатура.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НоменклатураУзла.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Иерархия
	|ИЗ
	|	ВТ_НоменклатураУзла КАК ВТ_НоменклатураУзла
	|ГДЕ
	|	НЕ ВТ_НоменклатураУзла.ТолькоИерархия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НоменклатураУзла.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_ОбщийРезультат
	|ИЗ
	|	ВТ_НоменклатураУзла КАК ВТ_НоменклатураУзла
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВТ_Иерархия.Номенклатура КАК Номенклатура
	|			ИЗ
	|				ВТ_Иерархия КАК ВТ_Иерархия)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_ОбщийРезультат.Номенклатура КАК Номенклатура
	|			ИЗ
	|				ВТ_ОбщийРезультат КАК ВТ_ОбщийРезультат)
	|ИТОГИ ПО
	|	Номенклатура ТОЛЬКО ИЕРАРХИЯ";
	Запрос.УстановитьПараметр("Ссылка", УзелОбмена);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Выборка.Номенклатура);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Зарегистрировать номенклатуру по видам меню узла.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ПараметрыУзла - Произвольный - Параметры узла.
//
Процедура ЗарегистрироватьНоменклатуруПоВидамМенюУзла(УзелОбмена, ПараметрыУзла)
	
	Если НЕ ПараметрыУзла.ИндивидуальныйСписокВидыМеню Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	питМеню.Номенклатура КАК Номенклатура
		|ИЗ
		|	Справочник.питМеню КАК питМеню
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.питВидыМеню КАК питВидыМеню
		|		ПО питМеню.Владелец = питВидыМеню.Ссылка
		|ГДЕ
		|	НЕ питВидыМеню.ПометкаУдаления
		|	И НЕ питМеню.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|ИТОГИ ПО
		|	Номенклатура ТОЛЬКО ИЕРАРХИЯ";

		
	Иначе
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	питУдаленныеКассыВидыМеню.ВидМеню КАК ВидМеню
		|ПОМЕСТИТЬ ВТ_ВидыМенюУзла
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы.ВидыМеню КАК питУдаленныеКассыВидыМеню
		|ГДЕ
		|	питУдаленныеКассыВидыМеню.Ссылка = &Ссылка
		|	И НЕ питУдаленныеКассыВидыМеню.ВидМеню = ЗНАЧЕНИЕ(Справочник.питВидыМеню.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыМеню.Ссылка КАК ВидМеню
		|ПОМЕСТИТЬ ВТ_ДоступныеВидыМеню
		|ИЗ
		|	Справочник.питВидыМеню КАК ВидыМеню
		|ГДЕ
		|	ВидыМеню.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				ВТ_ВидыМенюУзла.ВидМеню КАК ВидМеню
		|			ИЗ
		|				ВТ_ВидыМенюУзла КАК ВТ_ВидыМенюУзла)
		|	И НЕ ВидыМеню.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	питМеню.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_Меню
		|ИЗ
		|	ВТ_ДоступныеВидыМеню КАК ВТ_ДоступныеВидыМеню
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.питМеню КАК питМеню
		|		ПО ВТ_ДоступныеВидыМеню.ВидМеню = питМеню.Владелец
		|ГДЕ
		|	НЕ питМеню.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Меню.Номенклатура КАК Номенклатура
		|ИЗ
		|	ВТ_Меню КАК ВТ_Меню
		|ИТОГИ ПО
		|	Номенклатура ТОЛЬКО ИЕРАРХИЯ";
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", УзелОбмена);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Выборка.Номенклатура);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Зарегистрировать номенклатуру по модификаторам.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ПараметрыУзла - Произвольный - Параметры узла.
//
Процедура ЗарегистрироватьНоменклатуруПоМодификаторам(УзелОбмена, ПараметрыУзла)
	
	ТаблицаМодификаторов = Новый ТаблицаЗначений;
	ТаблицаМодификаторов.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("СправочникСсылка.питМодификаторы"));
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	питГруппыМодификаторовМодификаторы.Модификатор КАК Модификатор
	|ПОМЕСТИТЬ ВТ_Модификаторы
	|ИЗ
	|	Справочник.питГруппыМодификаторов.Модификаторы КАК питГруппыМодификаторовМодификаторы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питГруппыМодификаторов КАК питГруппыМодификаторов
	|		ПО питГруппыМодификаторовМодификаторы.Ссылка = питГруппыМодификаторов.Ссылка
	|ГДЕ
	|	НЕ питГруппыМодификаторов.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питМодификаторы.ДопНоменклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Модификаторы КАК ВТ_Модификаторы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питМодификаторы КАК питМодификаторы
	|		ПО ВТ_Модификаторы.Модификатор = питМодификаторы.Ссылка
	|ГДЕ
	|	НЕ питМодификаторы.ДопНоменклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|ИТОГИ ПО
	|	Номенклатура ТОЛЬКО ИЕРАРХИЯ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", УзелОбмена);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Выборка.Номенклатура);
	КонецЦикла;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	питМодификаторы.ДопНоменклатура КАК Номенклатура
		|ИЗ
		|	Справочник.питМодификаторы КАК питМодификаторы
		|ГДЕ
		|	НЕ питМодификаторы.ПометкаУдаления
		|	И НЕ питМодификаторы.ДопНоменклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|ИТОГИ ПО
		|	Номенклатура ТОЛЬКО ИЕРАРХИЯ";
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Выборка.Номенклатура);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Зарегистрировать номенклатуру по маршрутизации печати.
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ПараметрыУзла - Произвольный - Параметры узла.
//
Процедура ЗарегистрироватьНоменклатуруПоМаршрутизацииПечати(УзелОбмена, ПараметрыУзла)
	
	// Определим режим настройки КУ
	Если ПараметрыУзла.ПравилаПередачиМаршрутизации = 1 Тогда
		// Настройка маршрутизации печати не привязаны к конкретному узлу
		
		ТекстЗапроса = "ВЫБРАТЬ
		|	МаршрутизацияПечати.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
		|ГДЕ
		|	МаршрутизацияПечати.КассовыйУзел = ЗНАЧЕНИЕ(ПланОбмена.питУдаленныеКассы.ПустаяСсылка)
		|	И НЕ МаршрутизацияПечати.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|ИТОГИ ПО
		|	Номенклатура ТОЛЬКО ИЕРАРХИЯ";
		
	ИначеЕсли ПараметрыУзла.ПравилаПередачиМаршрутизации = 2 Тогда 
		// Настройка маршрутизации печати заданы для конкретно этого узла (что в параметре передан)
		
		ТекстЗапроса = "ВЫБРАТЬ
		|	МаршрутизацияПечати.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
		|ГДЕ
		|	МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел
		|	И НЕ МаршрутизацияПечати.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|ИТОГИ ПО
		|	Номенклатура ТОЛЬКО ИЕРАРХИЯ"
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("КассовыйУзел", УзелОбмена);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Выборка.Номенклатура);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Зарегистрировать номенклатуру по маршрутизации печати.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ПараметрыУзла - Произвольный - Параметры узла.
//
Процедура ЗарегистрироватьНоменклатуруПоСвязаннымИнгредиентам(УзелОбмена, ПараметрыУзла)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СвязанныеИнгредиенты.Блюдо КАК Номенклатура
	|ИЗ
	|	РегистрСведений.питАлкогольныеРецептуры КАК СвязанныеИнгредиенты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СвязанныеИнгредиенты.Ингредиент
	|ИЗ
	|	РегистрСведений.питАлкогольныеРецептуры КАК СвязанныеИнгредиенты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Аналоги.Номенклатура
	|ИЗ
	|	РегистрСведений.питАлкогольныеРецептуры КАК СвязанныеИнгредиенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.питМаркированныеАналоги.Состав КАК Аналоги
	|		ПО СвязанныеИнгредиенты.ГруппаАналогов = Аналоги.Ссылка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("КассовыйУзел", УзелОбмена);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	МассивНоменклатуры = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивНоменклатуры.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(МассивНоменклатуры) Тогда
		Возврат;
	КонецЕсли;
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, МассивНоменклатуры);
	
КонецПроцедуры

// Выполняет регистрацию данных определенного типа
//  по плану обмена УдаленныеКассы.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ТЗСсылок - Произвольный - Тз ссылок.
//  ТипСтрокой - Произвольный - Тип строкой.
//
Процедура ВыполнитьРегистрацию(УзелОбмена, ТЗСсылок, ТипСтрокой="")
	
	Если ЗначениеЗаполнено(ТипСтрокой) Тогда
		
		Запрос = Новый Запрос;
		МВТ = Новый МенеджерВременныхТаблиц;
		Запрос.МенеджерВременныхТаблиц = МВТ;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТЗ.Ссылка
		|ПОМЕСТИТЬ ТЗСсылок
		|ИЗ
		|	&ТабЗнач КАК ТЗ
		|ГДЕ 
		|  НЕ ТЗ.Ссылка = ЗНАЧЕНИЕ(Справочник." + ТипСтрокой + ".ПустаяСсылка)
		|И НЕ ТЗ.Ссылка ЕСТЬ NULL";
		
		Запрос.УстановитьПараметр("ТабЗнач", ТЗСсылок);
		Запрос.Выполнить();
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗСсылок.Ссылка КАК Ссылка
		|ИЗ
		|	ТЗСсылок КАК ТЗСсылок
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|	(ВЫБРАТЬ
		|	" + ТипСтрокой + "Изменения.Ссылка
		|	ИЗ
		|		Справочник." +  ТипСтрокой + ".Изменения КАК " + ТипСтрокой + "Изменения
		|	ГДЕ
		|		" + ТипСтрокой + "Изменения.Узел = &УзелОбмена) КАК " + ТипСтрокой + "Изменения
		|	ПО ТЗСсылок.Ссылка = " + ТипСтрокой + "Изменения.Ссылка
		|ГДЕ
		|	" + ТипСтрокой + "Изменения.Ссылка ЕСТЬ NULL";
		
		Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли; 
		МассивСсылок = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе
		МассивСсылок = ТЗСсылок.ВыгрузитьКолонку("Ссылка");
	КонецЕсли; 
	
	Для Инд = 0 По МассивСсылок.ВГраница() Цикл
		ЗначениеСсылки = МассивСсылок[Инд];
		Попытка
			Если (ЗначениеСсылки = Неопределено) ИЛИ (ЗначениеСсылки = NULL) ИЛИ НЕ ЗначениеЗаполнено(ЗначениеСсылки) Тогда
				// Подстраховка на случай некорректных запросов, возвращающих пустые значения.
				Продолжить;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ЗначениеСсылки);
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = "Ошибка регистрации <" + Строка(ЗначениеСсылки) + ">: " + ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстСообщения = ТекстСообщения + Символы.ПС + ИнфОбОшибке.Описание;
			КонецЦикла;
			ЗаписьЖурналаРегистрации("Регистрация", УровеньЖурналаРегистрации.Ошибка, , ЗначениеСсылки, ТекстСообщения);
		КонецПопытки;
	КонецЦикла; 
	
КонецПроцедуры

// Выполняет регистрацию всех родителей элемента справочника Номенклатура.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  знач ТЗСсылок - Произвольный - знач тз ссылок.
//
Процедура ЗарегистрироватьРодителейНоменклатуры(УзелОбмена, знач ТЗСсылок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Родитель КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Родитель <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И Номенклатура.Ссылка В(&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", ТЗСсылок.ВыгрузитьКолонку("Ссылка"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	Иначе
		ТЗСсылок = РезультатЗапроса.Выгрузить();
		ВыполнитьРегистрацию(УзелОбмена, ТЗСсылок, "Номенклатура");
		ЗарегистрироватьРодителейНоменклатуры(УзелОбмена, ТЗСсылок);
	КонецЕсли; 
	
КонецПроцедуры

// Выполняет регистрацию элементов справочника ЕдиницыИзмерения
//  по справочнику Номенклатура.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//
Процедура ЗарегистрироватьКлассификаторЕдиницИзмерения(УзелОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкиЕдиницыИзмерения.Ссылка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|ГДЕ
	|	НЕ УпаковкиЕдиницыИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)";
	
	ТЗСсылок = Запрос.Выполнить().Выгрузить();
	
	ВыполнитьРегистрацию(УзелОбмена, ТЗСсылок, "УпаковкиЕдиницыИзмерения");
	
КонецПроцедуры

// Выполняет регистрацию элементов справочника Организации
//  по плану обмена УдаленныеКассы.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//
Процедура ЗарегистрироватьОрганизацииПоУзлуОбмена(УзелОбмена)
	
	МассивОрганизаций = питОбменДаннымиПовтИсп.ПолучитьМассивОрганизацийКассовогоУзла(УзелОбмена);
	Если МассивОрганизаций.Количество() > 0 Тогда
		ТЗСсылок = Новый ТаблицаЗначений;
		ТЗСсылок.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		Для Каждого Ссылка ИЗ МассивОрганизаций Цикл
			НовСтр = ТЗСсылок.Добавить();
			НовСтр.Ссылка = Ссылка;
		КонецЦикла;
		ВыполнитьРегистрацию(УзелОбмена, ТЗСсылок, "Организации");
	КонецЕсли;
	
КонецПроцедуры

// Процедура регистрации подразделений по узлу обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//
Процедура ЗарегистрироватьПодразделенияПоУзлуОбмена(УзелОбмена)
	
	МассивПодразделений = питОбменДаннымиПовтИсп.ПолучитьМассивПодразделенийКассовогоУзла(УзелОбмена);
	Если МассивПодразделений.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СтруктураПредприятия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|ГДЕ
		|	СтруктураПредприятия.Ссылка В(&МассивПодразделений)
		|ИТОГИ ПО
		|	Ссылка ИЕРАРХИЯ";
		
		Запрос.УстановитьПараметр("МассивПодразделений", МассивПодразделений);
		
		ТЗСсылок = Запрос.Выполнить().Выгрузить();
		
		ВыполнитьРегистрацию(УзелОбмена, ТЗСсылок, "СтруктураПредприятия");
		
	КонецЕсли;
	
КонецПроцедуры

#Область ПодготовкаКэшированныхДанных

// Процедура - Кэшировать значения объекта.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//  ИмяСвойства - Произвольный - Имя свойства.
//  Значение - Произвольный - Значение.
//  СохранятьВСоответствие - Соответствие - Сохранять в соответствие.
//
Процедура КэшироватьЗначенияОбъекта(Параметры, ИмяСвойства, Значение, СохранятьВСоответствие = Ложь)
	
	Если НЕ СохранятьВСоответствие Тогда
		Параметры.КэшированныеЗначения.Вставить(ИмяСвойства, Значение);
	Иначе
		Параметры.КэшированныеЗначения.СоответствиеЭлементов.Вставить(ИмяСвойства, Значение);
	КонецЕсли;
	
	
КонецПроцедуры

// Функция - Получить значение из кэша.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//  ИмяСвойства - Произвольный - Имя свойства.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьЗначениеИзКэша(Параметры, ИмяСвойства)
	Результат = Неопределено;
	
	Если Параметры.КэшированныеЗначения.Свойство(ИмяСвойства) Тогда
		Результат = Параметры.КэшированныеЗначения[ИмяСвойства];
	Иначе
		ТекстОшибки = СтрШаблон(НСтр("ru='Имя свойства <%1> не найдено. Требуется проверить корректность макета.'", "ru"), ИмяСвойства);
		Событие = "ОбменСКУ";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Получить значение из кэша соответствий.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
