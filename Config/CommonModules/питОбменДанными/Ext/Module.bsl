
#Область ПрограммныйИнтерфейс

#Область ПроцедурыИФункцииЗаписиXMLСообщения

// Процедура предназначена для выгрузки сообщения обмена в кассовый узел.
//
// Параметры:
//  Параметры - Структура - содержит параметры, используемые при выгрузке.
//
Процедура ВыгрузитьСообщениеОбмена(Параметры) Экспорт
	
	Параметры.Вставить("Результат", Ложь);
	
	УзелОбмена      = Параметры.УзелОбмена;
	НастройкаОбмена = Параметры.НастройкаОбмена;
	ЭтотУзел        = ПланыОбмена.питУдаленныеКассы.ЭтотУзел();
	
	Если НЕ Параметры.Свойство("СозданиеНачальногоОбраза") И (УзелОбмена.НомерОтправленного < 1) Тогда
		Параметры.Вставить("Ошибка", "В данный узел не был выгружен начальный образ. Выгрузка невозможна.");
		Возврат;
	КонецЕсли;
	
	ОбработкаДоставкаСообщений = Обработки.питДоставкаСообщений.Создать();
	ОбработкаДоставкаСообщений.ИнициализацияПараметров(Параметры);
	Если НЕ Параметры.РезультатИнициализации Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Вставить("ВыгружатьМодификаторыНоменклатуры", УзелОбмена.ВыгружатьМодификаторыНоменклатуры);
	
	ПрефиксЛога = Параметры.ПрефиксЛога;
	
	СтрОшибки = "";	
	Если НЕ ОбработкаДоставкаСообщений.ПроверитьВозможностьОтправки(, СтрОшибки) Тогда
		СтрСообщения = "Для узла """ + УзелОбмена.Наименование + """ при проверке возможности отправки сообщения обмена обнаружены следующие ошибки: " + СтрОшибки;
		ЗафиксироватьСобытие(ПрефиксЛога + "Отправка", СтрСообщения, УзелОбмена, УровеньЖурналаРегистрации.Ошибка,Параметры.Комментировать);
		Параметры.Вставить("Ошибка", СтрОшибки);
		Возврат;
	КонецЕсли;
	
	// РЕГИСТРАЦИЯ
	ЗафиксироватьСобытие(ПрефиксЛога + "Регистрация", "Начало регистрации справ.данных для узла """ + СокрЛП(УзелОбмена.Наименование) + """",, УровеньЖурналаРегистрации.Информация, Параметры.Комментировать);
	
	Если Параметры.Свойство("СозданиеНачальногоОбраза") Тогда
		// Очистим все прошлые регистрации т.к. "начинаем с чистого листа"
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, НЕОПРЕДЕЛЕНО);
		// Создадим новые регистрации для выгрузки начального образа
		ЗарегистрироватьИзмененияДляВыгрузкиНО(УзелОбмена);
		ЗафиксироватьСобытие(ПрефиксЛога + "Регистрация", "Окончание регистрации справ.данных для узла """ + СокрЛП(УзелОбмена.Наименование) + """",, УровеньЖурналаРегистрации.Информация, Параметры.Комментировать);
	КонецЕсли;
	
	Если Параметры.Свойство("ПолнаяРегистрация") ТОгда
		ЗарегистрироватьИзмененияДляВыгрузкиНО(УзелОбмена);
		ЗафиксироватьСобытие(ПрефиксЛога + "Регистрация", "Окончание регистрации справ.данных для узла """ + СокрЛП(УзелОбмена.Наименование) + """",, УровеньЖурналаРегистрации.Информация, Параметры.Комментировать);
	КонецЕсли;
	// !!! ЗарегистрироватьИзмененияДляВыгрузки(Параметры);
	
	// ЗАПИСЬ СООБЩЕНИЯ
	Параметры.Вставить("КаталогТемпФайлов", ОбработкаДоставкаСообщений.КаталогТемпФайлов);
	ЗаписатьСообщениеСИзменениями(Параметры);
	
	Параметры.Результат = Параметры.РезультатЗаписи;
	
	УдалитьФайлыПоМаске(УзелОбмена, НастройкаОбмена, Истина,,,,, Параметры.Свойство("СозданиеНачальногоОбраза"));
	
	// ДОСТАВКА
	Если Параметры.РезультатЗаписи Тогда  
		Параметры.Результат = ОбработкаДоставкаСообщений.Доставка_ВыгрузкаСообщенияОбмена(Параметры); 
	КонецЕсли;
	
	// По завершении обмена выполним удаление временных файлов (оставшихся от проверок и некорректных обменов)
	УдалитьВременныеФайлы(Параметры.НастройкаОбмена, ОбработкаДоставкаСообщений, Параметры.ПрефиксЛога);
	
	НаборЗаписей = РегистрыСведений.СостоянияОбменовДанными.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(Параметры.УзелОбмена);
	НаборЗаписей.Отбор.ДействиеПриОбмене.Установить(Перечисления.ДействияПриОбмене.ВыгрузкаДанных);
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.УзелИнформационнойБазы = Параметры.УзелОбмена;
	НоваяЗапись.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных;
	НоваяЗапись.РезультатВыполненияОбмена = ?(Параметры.Результат, Перечисления.РезультатыВыполненияОбмена.Выполнено, ?(Параметры.РезультатЗаписи, Перечисления.РезультатыВыполненияОбмена.Ошибка_ТранспортСообщения, Перечисления.РезультатыВыполненияОбмена.Ошибка));
	НоваяЗапись.ДатаНачала = Параметры.НачалоОперацииОбмена;
	НоваяЗапись.ДатаОкончания = ТекущаяДата();
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Процедура предназначена для загрузки сообщения обмена в кассовый узел.
//
// Параметры:
//  Параметры - Структура - содержит параметры, используемые при загрузке.
//
Процедура ЗагрузитьСообщениеОбмена(Параметры) Экспорт
	
	Параметры.Вставить("Результат", Ложь);
	УзелОбмена      = Параметры.УзелОбмена;
	
	Если УзелОбмена.НомерОтправленного < 1 Тогда
		Параметры.Вставить("Ошибка", "В данный узел не был выгружен начальный образ. Загрузка невозможна.");
		Возврат;
	КонецЕсли;
	
	ОбработкаДоставкаСообщений = Обработки.питДоставкаСообщений.Создать();
	ОбработкаДоставкаСообщений.ИнициализацияПараметров(Параметры);
	Если НЕ Параметры.РезультатИнициализации Тогда
		Возврат;
	КонецЕсли;
	
	Рез = ОбработкаДоставкаСообщений.Доставка_ЗагрузкаСообщенияОбмена(Параметры);
	Если (НЕ Рез) ИЛИ ПустаяСтрока(Параметры.ИмяФайлаСообщения) Тогда
		Если ПустаяСтрока(Параметры.Ошибка) Тогда
			СтрОшибки = "Не было получено сообщений из узла """ + СокрЛП(УзелОбмена.Наименование) + """";
			Параметры.Вставить("Ошибка", СтрОшибки);
			Параметры.Вставить("Результат", Истина);
		КонецЕсли;
		ЗафиксироватьСобытие(Параметры.ПрефиксЛога + "Получение", СтрОшибки,, ?(Рез, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка), Параметры.Комментировать);
		Возврат; 
	Иначе
		// ЧТЕНИЕ СООБЩЕНИЯ ОБМЕНА
		Рез = ПрочитатьСообщениеСИзменениями(Параметры);
		
		Если Рез Тогда
			Параметры.Вставить("Результат", Истина);
			Если Параметры.НастройкаОбмена.СохранятьПолученные Тогда
				ОбработкаДоставкаСообщений.СохранитьОбработанноеСообщение(Параметры.ИмяФайлаСообщения);
			КонецЕсли;
		Иначе
			СтрОшибки = "Чтение сообщения <" + Параметры.ИмяФайлаСообщения + "> закончилось с ошибками " + ?(ПустаяСтрока(Параметры.Ошибка),"",": " + Символы.ПС + Параметры.Ошибка);
			Параметры.Вставить("Ошибка", СтрОшибки);
			Параметры.Вставить("Результат", Ложь);
			ЗафиксироватьСобытие(Параметры.ПрефиксЛога + "Чтение", СтрОшибки,,УровеньЖурналаРегистрации.Ошибка,Параметры.Комментировать);
		КонецЕсли;
		
		// ЗАКЛЮЧИТЕЛЬНЫЕ ДЕЙСТВИЯ
		
		// По завершении обмена выполним удаление временных файлов (оставшихся от проверок и некорректных обменов).
		УдалитьВременныеФайлы(Параметры.НастройкаОбмена, ОбработкаДоставкаСообщений, Параметры.ПрефиксЛога);
		
		Если Рез Тогда
			УдалитьФайлыПоМаске(УзелОбмена, Параметры.НастройкаОбмена,Ложь,,,Ложь,);
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Результат Тогда
		СтрСообщения = "Загрузка сообщения обмена из узла """ + СокрЛП(УзелОбмена.Наименование) + """ успешно завершена";
		ЗафиксироватьСобытие(Параметры.ПрефиксЛога + "Получение", СтрСообщения,,УровеньЖурналаРегистрации.Информация,Параметры.Комментировать);
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СостоянияОбменовДанными.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(Параметры.УзелОбмена);
	НаборЗаписей.Отбор.ДействиеПриОбмене.Установить(Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.УзелИнформационнойБазы = Параметры.УзелОбмена;
	НоваяЗапись.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ЗагрузкаДанных;
	НоваяЗапись.РезультатВыполненияОбмена = ?(Параметры.Результат, Перечисления.РезультатыВыполненияОбмена.Выполнено, Перечисления.РезультатыВыполненияОбмена.Ошибка);
	НоваяЗапись.ДатаНачала = Параметры.НачалоОперацииОбмена;
	НоваяЗапись.ДатаОкончания = ТекущаяДата();
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Функция формирует таблицу цен меню.
//
// Параметры:
//  УзелОбмена - ПланОбменаСсылка - Узел информационной базы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ТаблицаЗначений, содержащая колонки "ВидМеню", "Номенклатура", "Цена".
Функция ПолучитьТаблицуЦенМеню(УзелОбмена) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ВидЦенУзла", УзелОбмена.ВидЦен);
	Запрос.УстановитьПараметр("ПустойТипЦен", Справочники.ВидыЦен.ПустаяСсылка());
	
	// Берем виды меню из тч, если в ТЧ есть элементы, иначе берем все.
	Если УзелОбмена.ВидыМеню.Количество() Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	УдаленныеКассыВидыМеню.ВидМеню,
		|	УдаленныеКассыВидыМеню.ТипЦен
		|ПОМЕСТИТЬ СписокВидовМеню
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
		|ГДЕ
		|	УдаленныеКассыВидыМеню.ВидМеню <> &ПустойВидМеню
		|	И УдаленныеКассыВидыМеню.ТипЦен <> &ПустойТипЦен
		|	И УдаленныеКассыВидыМеню.Ссылка = &УзелОбмена
		|;";
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	питВидыМеню.Ссылка КАК ВидМеню,
		|	&ВидЦенУзла КАК ТипЦен
		|ПОМЕСТИТЬ СписокВидовМеню
		|ИЗ
		|	Справочник.питВидыМеню КАК питВидыМеню
		|ГДЕ
		|	НЕ питВидыМеню.ЭтоГруппа
		|	И НЕ питВидыМеню.ПометкаУдаления
		|	И &ВидЦенУзла <> &ПустойТипЦен
		|;";
	КонецЕсли;
	
	ТекстЦеныОтборНоменклатура = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							ПрайсЛист.Номенклатура
	|						ИЗ
	|							Справочник.питМеню КАК ПрайсЛист
	|						ГДЕ
	|							ПрайсЛист.Владелец В
	|								(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|									СписокВидовМеню.ВидМеню
	|								ИЗ
	|									СписокВидовМеню КАК СписокВидовМеню)
	|							И ПрайсЛист.Номенклатура.ЭтоГруппа = ЛОЖЬ";
	ТекстЦеныОтборВидЦен = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							СписокВидовМеню.ТипЦен
	|						ИЗ
	|							СписокВидовМеню КАК СписокВидовМеню";
	ТекстЗапросаЦены = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ТекущаяДата(), 
		"втЦеныНоменклатуры", "ТекущаяДата", ТекстЦеныОтборНоменклатура, "ХарактеристикаЦен", ТекстЦеныОтборВидЦен);
	Запрос.УстановитьПараметр("ХарактеристикаЦен", 
		питЦеныНоменклатуры.ПреобразоватьОтборПоХарактеристикеЦен(ТекущаяДата(), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
	Запрос.Текст = Запрос.Текст + ТекстЗапросаЦены + " ; ";
	
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.ВидМеню,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.ТипЦен,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Упаковка
	|ИЗ
	|	(ВЫБРАТЬ
	|		СписокВидовМеню.ВидМеню КАК ВидМеню,
	|		СписокВидовМеню.ТипЦен КАК ТипЦен,
	|		ПрайсЛист.Номенклатура КАК Номенклатура
	|	ИЗ
	|		Справочник.питМеню КАК ПрайсЛист
	|			ЛЕВОЕ СОЕДИНЕНИЕ СписокВидовМеню КАК СписокВидовМеню
	|			ПО ПрайсЛист.Владелец = СписокВидовМеню.ВидМеню
	|	ГДЕ
	|		ПрайсЛист.Владелец В
	|				(ВЫБРАТЬ
	|					СписокВидовМеню.ВидМеню
	|				ИЗ
	|					СписокВидовМеню КАК СписокВидовМеню)
	|		И ПрайсЛист.Номенклатура.ЭтоГруппа = ЛОЖЬ) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ втЦеныНоменклатуры КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ВложенныйЗапрос.ТипЦен = ЦеныНоменклатурыСрезПоследних.ВидЦены
	|			И ВложенныйЗапрос.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура";	
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	Запрос.УстановитьПараметр("ПустойВидМеню", Справочники.питВидыМеню.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойТипЦен", Справочники.ВидыЦен.ПустаяСсылка());
	
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	
	ПараметрыУчетаНДСПоОрганизации = питОбменДаннымиПовтИсп.ПараметрыУчетаНДСПоОрганизации(
		УзелОбмена.Организация,
		ТекущаяДатаСеанса()
	);
	
	Для Каждого ТекущаяСтрока Из ТаблицаЦен Цикл
		
		// Цены должны быть рассчитаны для основной единицы измерения.
		Если ЗначениеЗаполнено(ТекущаяСтрока.Упаковка) Тогда
			
			ТекУпаковкаКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Упаковка);
			ТекущаяСтрока.Цена = ТекущаяСтрока.Цена / ТекУпаковкаКоэффициент;
			
		КонецЕсли;
		
		// Если тип цен не включает НДС то необходимо НДС добавить.
		Если НЕ ТекущаяСтрока.ТипЦен.ЦенаВключаетНДС Тогда
			ТекСтавкаНДС = УчетНДСУП.СтавкаНДСПоНоменклатуреИНалогообложению(
				ТекущаяСтрока.Номенклатура, 
				ПараметрыУчетаНДСПоОрганизации.ОсновноеНалогообложениеНДСПродажи, 
				УзелОбмена.Организация, 
				ТекущаяДатаСеанса()
			);
			ТекущаяСтрока.Цена = (ТекущаяСтрока.Цена * (100 + УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(ТекСтавкаНДС))) / 100;
		КонецЕсли;
		
		ТекущаяСтрока.Цена = Окр(ТекущаяСтрока.Цена, 2);
		
	КонецЦикла;
	
	Возврат ТаблицаЦен;
	
КонецФункции

// Функция формирует таблицу цен номенклатуры.
//
// Параметры:
//  УзелОбмена - ПланОбменаСсылка - Узел информационной базы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ТаблицаЗначений, содержащая колонки "ВидМеню", "Номенклатура", "Цена".
Функция ПолучитьТаблицуЦенНоменклатуры(УзелОбмена) Экспорт
	
	Запрос = Новый Запрос;
	
	
	ТекстЗапросаШаблон = 
		"%1
		|;
		|%2
		|;
		|%3";
	ТекстЦеныОтборНоменклатура = "ВЫБРАТЬ
	|							НоменклатураСписок.Номенклатура
	|						ИЗ
	|							НоменклатураСписок КАК НоменклатураСписок";
	ТекстЗапросаЦены = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ТекущаяДата(), 
		"втЦеныНоменклатуры", "ТекущаяДата", ТекстЦеныОтборНоменклатура, "ХарактеристикаЦен", "ВидЦенУзла");
	Запрос.УстановитьПараметр("ХарактеристикаЦен", 
		питЦеныНоменклатуры.ПреобразоватьОтборПоХарактеристикеЦен(ТекущаяДата(), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
	
	ТекстЗапросаНоменклатураСписок =
	"ВЫБРАТЬ
	|	НоменклатураИзменения.Ссылка КАК Номенклатура,
	|	ВЫРАЗИТЬ(&ВидЦенУзла КАК Справочник.ВидыЦен) КАК ТипЦен
	|ПОМЕСТИТЬ НоменклатураСписок
	|ИЗ
	|	Справочник.Номенклатура.Изменения КАК НоменклатураИзменения
	|ГДЕ
	|	НоменклатураИзменения.Узел = &УзелОбмена
	|	И НЕ НоменклатураИзменения.Ссылка.ЭтоГруппа
	|";
	ТекстЗапросаРезультат = "
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураСписок.Номенклатура КАК Номенклатура,
	|	СпрНоменклатура.СтавкаНДС КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА НоменклатураСписок.ТипЦен = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ НоменклатураСписок.ТипЦен.ЦенаВключаетНДС
	|	КОНЕЦ КАК ЦенаВключаетНДС,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Упаковка
	|ИЗ
	|	НоменклатураСписок КАК НоменклатураСписок
	|		ЛЕВОЕ СОЕДИНЕНИЕ втЦеныНоменклатуры КАК ЦеныНоменклатурыСрезПоследних
	|		ПО НоменклатураСписок.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО НоменклатураСписок.Номенклатура = СпрНоменклатура.Ссылка";
	
	Запрос.Текст = СтрШаблон(ТекстЗапросаШаблон, ТекстЗапросаНоменклатураСписок, ТекстЗапросаЦены, ТекстЗапросаРезультат);
	
	Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДата());
	Запрос.УстановитьПараметр("УзелОбмена", 	УзелОбмена);
	Запрос.УстановитьПараметр("ВидЦенУзла",		УзелОбмена.ВидЦен);
	
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	
	ПараметрыУчетаНДСПоОрганизации = питОбменДаннымиПовтИсп.ПараметрыУчетаНДСПоОрганизации(
		УзелОбмена.Организация,
		ТекущаяДатаСеанса()
	);
	
	Для Каждого ТекущаяСтрока Из ТаблицаЦен Цикл
		
		// Цены должны быть рассчитаны для основной единицы измерения.
		Если ЗначениеЗаполнено(ТекущаяСтрока.Упаковка) Тогда
			
			ТекУпаковкаКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Упаковка);
			ТекущаяСтрока.Цена = ТекущаяСтрока.Цена / ТекУпаковкаКоэффициент;
			
		КонецЕсли;
		
		// Если тип цен не включает НДС то необходимо НДС добавить.
		Если НЕ ТекущаяСтрока.ЦенаВключаетНДС Тогда
			ТекСтавкаНДС = УчетНДСУП.СтавкаНДСПоНоменклатуреИНалогообложению(
				ТекущаяСтрока.Номенклатура, 
				ПараметрыУчетаНДСПоОрганизации.ОсновноеНалогообложениеНДСПродажи, 
				УзелОбмена.Организация, 
				ТекущаяДатаСеанса()
			);
			ТекущаяСтрока.Цена = (ТекущаяСтрока.Цена * (100 + УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(ТекСтавкаНДС))) / 100;
		КонецЕсли;
		
		ТекущаяСтрока.Цена = Окр(ТекущаяСтрока.Цена, 2);
		
	КонецЦикла;
	
	Возврат ТаблицаЦен;
	
КонецФункции

// Функция - Получить инн сотрудника.
//
// Параметры:
//  Сотрудник - Произвольный - Сотрудник.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьИННСотрудника(Сотрудник) Экспорт 
	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = "";
	ИННСотрудника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "ИНН");
	Если ЗначениеЗаполнено(ИННСотрудника) Тогда
		Результат = XMLСтрока(ИННСотрудника);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получить ставку ндс.
//
// Параметры:
//  СтавкаНДС - Произвольный - Ставка ндс.
//  Дата - Дата - Дата.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьСтавкуНДС(Знач СтавкаНДС, Дата) Экспорт
	Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		Если СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС18) Тогда
			Если Дата >= '20190101' Тогда
				СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС20);
			ИначеЕсли  Дата >= '20260101' Тогда
				СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС22);
			Иначе
				СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС18);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(18) Тогда
			Если Дата >= '20190101' Тогда
				СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(20);
			ИначеЕсли Дата >= '20260101' Тогда
				СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(22);
			Иначе
				СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(18);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат СтавкаНДС;
КонецФункции

#КонецОбласти

#Область ЗаписьИЧтениеДанныхПоМакетам

// Функция получает объекта по ссылке
//
// Параметры:
//  Ссылка - Ссылка - Ссылка на объект баз.
//  ИмяОбъекта - Строка - Имя менеджера объект.
//  ЭтоДокумент - Произвольный - Это документ.
//  ЭтоГруппа - Булево - Признак групп.
//  СоздаватьОбъект - Булево - Флаг необходимости проверить наличие в базе объекта с такой ссылкой.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
// Возвращаемое значение:
//  Произвольный - Объект.
Функция ПолучитьСоздатьОбъектПоСсылке(Ссылка, ИмяОбъекта, ЭтоДокумент = Неопределено, ЭтоГруппа = Неопределено, СоздаватьОбъект = Истина, ТекстОшибки = "") Экспорт
	
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Объект = Неопределено;
	
	Попытка
		
		ИмяОбъектаМенеджер = ИмяОбъекта;
		Если питОбменДаннымиПовтИсп.Латиница(ИмяОбъектаМенеджер) Тогда 
			ТаблицуСоответствийИмен = питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменОбъектов();
			ИмяОбъектаМенеджер = ТаблицуСоответствийИмен.Получить(ИмяОбъектаМенеджер);
		КонецЕсли;
		
		МенеджерОбъекта = питОбменДаннымиПовтИсп.ПолучитьМенеджерОбъектаПоИмени(ИмяОбъектаМенеджер);
		Если МенеджерОбъекта = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если (Ссылка = Неопределено) ИЛИ Ссылка.Пустая() Тогда
			Ссылка = МенеджерОбъекта.ПолучитьСсылку();
		КонецЕсли;
		
		Объект = Ссылка.ПолучитьОбъект();
		
		Если СоздаватьОбъект И ((Объект = Неопределено) ИЛИ (ПустаяСтрока(Объект.ВерсияДанных))) Тогда
			
			Если ЭтоДокумент = Неопределено Тогда
				// Эх сверху не позаботились, самим придется
				ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка));
			КонецЕсли;
		
			Если ЭтоДокумент Тогда		
				// Создаем документ
				Объект = МенеджерОбъекта.СоздатьДокумент();
			ИначеЕсли (ЭтоГруппа = Неопределено) ИЛИ НЕ ЭтоГруппа Тогда
				// Создаем элемент справочника
				Объект = МенеджерОбъекта.СоздатьЭлемент();
			Иначе
				// Создаем группу справочника
				Объект = МенеджерОбъекта.СоздатьГруппу();
			КонецЕсли;
				
			Объект.УстановитьСсылкуНового(Ссылка);
		
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("ОшибкаИсключения.ПолучитьСоздатьОбъектПоСсылке", УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
	КонецПопытки;
	
	Возврат Объект;
	
КонецФункции // ПолучитьСоздатьОбъектПоСсылке

