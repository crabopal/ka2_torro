// Преобразует значение типа "Строка" в тип "Число".
//
// Параметры:
//  Значение - Произвольный - Значение.
//
// Возвращаемое значение:
// 	Число - Результат обработки.
Функция СтрокаВЧисло(Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	Иначе
		ТекЗначение = СтрЗаменить(Значение, ",", ".");
		ТекЗначение = СтрЗаменить(ТекЗначение, Символы.НПП, "");
		Возврат XMLЗначение(Тип("Число"), ТекЗначение);
	КонецЕсли;
КонецФункции

// Преобразует значение типа "Булево" в строку.
//
// Параметры:
//  Значение - Произвольный - Значение.
//
// Возвращаемое значение:
// 	Строка. 	
Функция БулевоСтрокой(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "0";
	Иначе
		Возврат ?(Значение, "1", "0");
	КонецЕсли;
	
КонецФункции

// Преобразует значение типа "Строка" в тип "Булево".
//
// Параметры:
