		Возврат Ложь;
	Иначе
		Возврат XMLЗначение(Тип("Булево"), Значение);
	КонецЕсли; 
	
КонецФункции

// Преобразует число из шестнадцатиричного формата в десятичный.
//
// Параметры:
//  ВходноеЧисло - Число - Входное число.
//
// Возвращаемое значение:
//  Число - Результат обработки.
Функция ПреобразоватьШестнадцатиричноеЧислоВДесятичное(ВходноеЧисло)
	
	ВыходноеЧисло = 0;
	ДлинаСтроки = СтрДлина(ВходноеЧисло);
	
	НомерРазряда = ДлинаСтроки - 1;
	Инд = 1;
	Пока НомерРазряда >= 0 Цикл
		
		ТекСимвол = Сред(ВходноеЧисло, Инд, 1);
		Если ТекСимвол = "A" Тогда
			ТекСимвол = 10;
		ИначеЕсли ТекСимвол = "B" Тогда
			ТекСимвол = 11;
		ИначеЕсли ТекСимвол = "C" Тогда
			ТекСимвол = 12;
		ИначеЕсли ТекСимвол = "D" Тогда
			ТекСимвол = 13;
		ИначеЕсли ТекСимвол = "E" Тогда
			ТекСимвол = 14;
		ИначеЕсли ТекСимвол = "F" Тогда
			ТекСимвол = 15;
		КонецЕсли;
		
		Попытка
			ТекЧисло = Число(ТекСимвол);
		Исключение
			ТекЧисло = 0;
			Прервать;
		КонецПопытки;
		
		ТекЧисло = ТекЧисло * Pow(16, НомерРазряда);
						
		ВыходноеЧисло = ВыходноеЧисло + ТекЧисло;
		
		НомерРазряда = НомерРазряда - 1;
		Инд  = Инд + 1;
		
	КонецЦикла;
	
	Возврат ВыходноеЧисло;
	
КонецФункции

// Преобразует цвет в 10-ричном представлении в объект  "Цвет".
//
// Параметры:
//  ВходнойЦвет - Произвольный - Входной цвет.
//
// Возвращаемое значение:
//  Число - Результат обработки.
Функция ПреобразоватьДесятичноеЧислоВЦвет(ВходнойЦвет)
	
	Попытка
		ТекВходнойЦвет = Число(ВходнойЦвет);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТекВходнойЦвет >= 65536 Тогда
		ТекСиний = Цел(ТекВходнойЦвет/65536);
	Иначе
		ТекСиний = 0;
	КонецЕсли;
	ТекВходнойЦвет = ТекВходнойЦвет - ТекСиний*65536;
	 
	Если ТекВходнойЦвет >= 256 Тогда
		ТекЗеленый = Цел(ТекВходнойЦвет/256);
	Иначе
		ТекЗеленый = 0;
	КонецЕсли;
	ТекВходнойЦвет = ТекВходнойЦвет - ТекЗеленый*256;
	
	Если ТекВходнойЦвет >= 0 Тогда
		ТекКрасный = ТекВходнойЦвет;
	Иначе
		ТекКрасный = 0;
	КонецЕсли;
	
	ВыходнойЦвет = Новый Цвет(ТекКрасный, ТекЗеленый, ТекСиний);
	
	Возврат ВыходнойЦвет;
	
КонецФункции

// Функция - Подготовить номер документа.
//
// Параметры:
//  Префикс - Произвольный - Значение префикс.
//  Номер - Произвольный - Номер.
//  ДлинаНомера - Число - Длина номера.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодготовитьНомерДокумента(Знач Префикс, Номер, ДлинаНомера = 30)
	
	Префикс = СокрЛП(Префикс);
	Постфикс = СокрЛП(Номер);
	Корень = "";
	
	КоличествоНулей = ДлинаНомера - (СтрДлина(Префикс) + СтрДлина(Постфикс));
	Если КоличествоНулей > 0 Тогда
		Корень = Формат(0, СтрШаблон("ЧЦ=%1; ЧН=; ЧВН=; ЧГ=",КоличествоНулей));
	КонецЕсли;
	
	МассивЧастейНомера = СтрРазделить(Номер, "-", Ложь); 
	Если МассивЧастейНомера.Количество() = 2 Тогда
		Префикс = Префикс + МассивЧастейНомера[0];
		Постфикс = МассивЧастейНомера[1]
	КонецЕсли;
	
	Результат = СтрШаблон("%1%2%3", Префикс, Корень, Постфикс);
	
	Возврат Результат;
КонецФункции

// Выполняет создание документов продаж (целевых) на основании документов "ДанныеПродажФронта".
