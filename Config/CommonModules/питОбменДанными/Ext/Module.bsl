// Функция "расщепляет" строку на подстроки, используя заданный
//  разделитель. Разделитель может иметь любую длину.
//  Если в качестве разделителя задан пробел, рядом стоящие пробелы
//  считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//  игнорируются.
//  Например,
//  РазложитьСтрокуВМассивПодстрок(",ку,,,му", ",") возвратит массив значений из пяти элементов,
//  три из которых - пустые строки, а
//  РазложитьСтрокуВМассивПодстрок(" ку   му", " ") возвратит массив значений из двух элементов
//
// Параметры:
//  Стр - Строка - Знач стр.
//  Разделитель - Строка - разделитель, по умолчанию - запятая.
//
// Возвращаемое значение:
// 	Массив  - Значений, элементы которого подстроки.
Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",") Экспорт
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
КонецФункции // РазложитьСтрокуВМассивПодстрок

// Функция преобразует массив из строка вида ключ = значение в структуру
//
// Параметры:
//  МассивПараметров - Массив - Массив параметров.
//  Разделитель - строка - разделитель, по умолчанию знак равенства.
//
// Возвращаемое значение:
// 		Структура - Результат обработки
Функция ПреобразоватьМассивПараметровВСтруктуру(МассивПараметров, Разделитель = "=") Экспорт
	
	Результат = Новый Структура();
	
	Для Каждого Элемент Из МассивПараметров Цикл
		
		Стр 	= СокрЛП(Элемент);
		Если Прав(Стр,1) = ";" Тогда
			Стр = Лев(Стр, СтрДлина(Стр) - 1);
		КонецЕсли;
		Если Лев(Стр,1) = ";" Тогда
			Стр = Сред(Стр, 2);
		КонецЕсли;
		
		Стр 	= СокрЛП(Стр);
		Длина	= СтрДлина(Стр);
		Поз		= Найти(Стр,Разделитель);
		
		Если (Поз < 2) ИЛИ ((Поз + 1) > Длина)  Тогда
			Продолжить; // не сможем выделить пару ключ = значение
		КонецЕсли;
		
		Ключ	 = СокрЛП(Лев(Стр,  Поз-1));
		Значение = СокрЛП(Сред(Стр, Поз+1));
		
		Если ПустаяСтрока(Ключ) ИЛИ ПустаяСтрока(Значение) Тогда
			Продолжить; // не смогли выделить пару ключ = значение
		КонецЕсли;
		
	    Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

// Процедура чтения координат из XML сообщения
//
// Параметры:
//  СвойстваОбъекта - Структура - Структура свойств объект.
//  ИмяАтрибута - Строка - Имя атрибута в XML представлении.
//  Значение - Строка - Строка значений реквизит.
//
// Возвращаемое значение:
//  Дата - Результат обработки.
Функция ЗаполнитьДатуДействияВидаМеню(СвойстваОбъекта, ИмяАтрибута, Значение) Экспорт
	
	ЭтоГруппа = ?(СвойстваОбъекта.Свойство("ЭтоГруппа"),СвойстваОбъекта.ЭтоГруппа,Ложь);
	
	Результат = Дата(1, 1, 1);
	ДатаДействия = питОбменДаннымиПовтИсп.ДатаИзСтроки(Значение);
	
	Если ЗначениеЗаполнено(ДатаДействия) Тогда
		Результат = НачалоДня(ДатаДействия);
	КонецЕсли;
	
	Если НЕ ЭтоГруппа Тогда
		Если ИмяАтрибута = "DTBegin" Тогда
			СвойстваОбъекта.Вставить("ВремяНачалаДействия", Дата(1, 1, 1) + (ДатаДействия - Результат));
		ИначеЕсли ИмяАтрибута = "DTEnd" Тогда
			СвойстваОбъекта.Вставить("ВремяОкончанияДействия", Дата(1, 1, 1) + (ДатаДействия - Результат));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ЗаполнитьДатуДействияВидаМеню

#КонецОбласти

#Область Фильтрация

// Возвращает булев результат проверки принадлежности номенклатуры кассовому узлу
//
// Параметры:
//  НоменклатураСсылка - СправочникСсылка.Номенклатура - Ссылка на проверяемую в номенклатур.
//  КассовыйУзелСсылка - ПланыОбменаСсылка.УдаленныеКассы - Ссылка на удаленный кассовый узе.
//  ЭтоГруппа - Произвольный - Это группа.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Булево - Результат проверки
Функция НоменклатураИзвестнаУзлу(НоменклатураСсылка, КассовыйУзелСсылка, ЭтоГруппа = Неопределено, ДопПараметры) Экспорт
	
	Результат = Ложь;
	
	Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ДопПараметры.СоответствиеИзвестнойНоменклатуры = Неопределено Тогда
		
		РезультатПоиска = ДопПараметры.СоответствиеИзвестнойНоменклатуры.Получить(НоменклатураСсылка);
		Если НЕ РезультатПоиска = Неопределено Тогда
			Возврат РезультатПоиска;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоменклатураЕстьВИндивидуальномСписке(НоменклатураСсылка, КассовыйУзелСсылка, ЭтоГруппа)
		ИЛИ НоменклатураЕстьВВидахМенюУзла(НоменклатураСсылка, КассовыйУзелСсылка)
		ИЛИ НоменклатураЕстьВМодификаторахУзла(НоменклатураСсылка)
		ИЛИ НоменклатураЕстьВМаршрутизацииПечати(НоменклатураСсылка, КассовыйУзелСсылка)
		ИЛИ НоменклатураЕстьВСвязанныхИнгредиентах(НоменклатураСсылка, КассовыйУзелСсылка, ЭтоГруппа, ДопПараметры)
		Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если НЕ ДопПараметры.СоответствиеИзвестнойНоменклатуры = Неопределено Тогда
		ДопПараметры.СоответствиеИзвестнойНоменклатуры.Вставить(НоменклатураСсылка, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НоменклатураИзвестнаУзлу()

// Функция - Место печати известно узлу.
//
// Параметры:
//  ПроверяемаяСсылка - Произвольный - Проверяемая ссылка.
//  КассовыйУзелСсылка - Произвольный - Кассовый узел ссылка.
//  ИндивидуальныйСписок - СписокЗначений - Индивидуальный список.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция МестоПечатиИзвестноУзлу(ПроверяемаяСсылка, КассовыйУзелСсылка, ИндивидуальныйСписок = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПроверяемаяСсылка) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ИндивидуальныйСписок = Неопределено Тогда
		ИндивидуальныйСписок = Ложь;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	питУдаленныеКассыМестаПечати.МестоПечати КАК МестоПечати
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы.МестаПечати КАК питУдаленныеКассыМестаПечати
		|ГДЕ
		|	питУдаленныеКассыМестаПечати.Ссылка = &КассовыйУзелСсылка";
		Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ИндивидуальныйСписок = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ИндивидуальныйСписок Тогда
		Возврат Истина;
	КонецЕсли;
	
	МассивНаПроверку = Новый Массив;
	МассивНаПроверку.Добавить(ПроверяемаяСсылка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТаблицаДанных.Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.МестаПечати КАК ТаблицаДанных
	|ГДЕ
	|	ТаблицаДанных.Ссылка = &КассовыйУзелСсылка
	|	И ТаблицаДанных.МестоПечати В(&МассивНаПроверку)";
	Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
	Запрос.УстановитьПараметр("МассивНаПроверку", МассивНаПроверку);
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = НЕ РезультатЗапроса.Пустой();
	Возврат Результат;
	
КонецФункции

// Функция - Документ назначение скидок известен узлу.
//
// Параметры:
//  ОбъектЗаписи - Произвольный - Объект записи.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДокументКорректировкаОстатковИСИзвестенУзлу(ОбъектЗаписи, ДопПараметры) Экспорт
	Результат = Ложь;
	
	КассовыйУзелСсылка = ДопПараметры.Получатель;
	Если НЕ питОбменДаннымиПовтИсп.ОрганизацияПринадлежитКассовомуУзлу(ОбъектЗаписи.Организация, КассовыйУзелСсылка)
		ИЛИ НЕ питОбменДаннымиПовтИсп.ПодразделениеИзвестноУзлу(ОбъектЗаписи.Подразделение, КассовыйУзелСсылка)  Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Истина;
	Возврат Результат;
	
КонецФункции


// Возвращает булев результат проверки должно ли переданное в первом параметре Номенклатура
//  Быть известным кассовому узлу (передается во втором параметре).
//
// Параметры:
//  НоменклатураСсылка	 - Произвольный	 - Номенклатура ссылка.
//  КассовыйУзелСсылка	 - Произвольный	 - Кассовый узел ссылка.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоменклатураИзвестенаУзлуПоПризнакуВыгружатьТолькоИерархию(НоменклатураСсылка, КассовыйУзелСсылка) Экспорт
	
	Результат = НоменклатураВыгружаетсяВоФронт(НоменклатураСсылка);
	
	Запрос = Новый Запрос;
	
	// Если номенклатура это элемент, то получим ее родителя и скажем по ней выгружается ли она.
	// Если номенклатура это группа, то проверим выгружается ли она или хоть один из ее потомков (т.к. может быть ситуация, что подчиненная группа выгружается).
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(Номенклатура1.питВыгружатьВРБК, ЛОЖЬ) КАК ВыгружатьВоФронт
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура1
	|		ПО Номенклатура.Родитель = Номенклатура1.Ссылка
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(СпрНоменклатура.питВыгружатьВРБК)
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И СпрНоменклатура.ЭтоГруппа";
	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ВыгружатьВоФронт;
	Иначе
		Результат = Ложь; // на всякий случай
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Группа маркированных аналогов известна узлу
//
// Параметры:
//  ПроверяемаяСсылка	 - Произвольный	 - ПроверяемаяСсылка. 
//  КассовыйУзелСсылка	 - Произвольный	 - Кассовый узел ссылка.
//  ДопПараметры		 - Произвольный	 - Дополнительные Параметры.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ГруппаМаркированныхАналоговИзвестнаУзлу(ПроверяемаяСсылка, КассовыйУзелСсылка, ДопПараметры)
	Результат = Истина;
	Если НЕ ЗначениеЗаполнено(ПроверяемаяСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ДопПараметры.ИндивидуальныйСписокНоменклатуры Тогда
		// Если доступна вся номенклатура, то будут доступны и их аналоги.
		Возврат Результат;
	КонецЕсли;
	
	Результат = Ложь;
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Состав.Номенклатура КАК Номенклатура,
	|	СпрНоменклатура.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.питМаркированныеАналоги.Состав КАК Состав
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Состав.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	Состав.Ссылка = &ПроверяемаяСсылка";
	Запрос.УстановитьПараметр("ПроверяемаяСсылка", ПроверяемаяСсылка);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Результат ИЛИ НоменклатураИзвестнаУзлу(Выборка.Номенклатура,
			КассовыйУзелСсылка,
			Выборка.ЭтоГруппа,
			ДопПараметры);
		Если Результат Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

