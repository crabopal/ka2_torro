// Функция - Получить таблицу чеков общепита.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуЧековОбщепита()
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ДатаДокумента", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТЗ.Колонки.Добавить("Объект");
	
	Возврат ТЗ;
КонецФункции

// Определяет массив выгружаемых ролей пользователей фронта.
//
// Параметры:
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ЗаполнитьМассивВыгружаемыхРолейПользователейФронта(ДопПараметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РолиПользователейФронта.Ссылка
	|ИЗ
	|	Справочник.питРолиПользователейФронта КАК РолиПользователейФронта
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питРолиПользователейФронта.Права КАК СоставПравВРоляхПользователейФронта
	|		ПО РолиПользователейФронта.Ссылка = СоставПравВРоляхПользователейФронта.Ссылка
	|ГДЕ
	|	НЕ СоставПравВРоляхПользователейФронта.Право ЕСТЬ NULL ";
	РезультатЗапроса = Запрос.Выполнить();
	МассивВыгружаемыхРолейПользователейФронта = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ДопПараметры.Вставить("МассивВыгружаемыхРолейПользователейФронта", МассивВыгружаемыхРолейПользователейФронта);
	
КонецПроцедуры

// Производит запись заголовка сообщения обмена.
//
// Параметры:
//  ЗаписьXML - Произвольный - Запись xml.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ЗаписатьЗаголовокСообщения(ЗаписьXML, ДопПараметры)
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Request");
	
	// Имя проекта (с фронтами других типов/отраслей не обмениваемся).
	ЗаписьXML.ЗаписатьАтрибут("name", 		"Food");
	
	// Режим рабочей базы
	ЗаписьXML.ЗаписатьАтрибут("work", 		"1");
	
	// Выгрузка начального образа.
	Если ДопПараметры.Свойство("СозданиеНачальногоОбраза") Тогда
		ЗаписьXML.ЗаписатьАтрибут("fullreload", "1");
		ЗаписьXML.ЗаписатьАтрибут("reqnum",	"0");
		ВыгрузкаНО = Истина;
	Иначе
		// Номер отправляемого сообщения (этого).
		ЗаписьXML.ЗаписатьАтрибут("reqnum",	XMLСтрока(ДопПараметры.Получатель.НомерОтправленного + 1));
		ВыгрузкаНО = Ложь;
	КонецЕсли;
	
	// Номер последнего успешно принятого.
	ЗаписьXML.ЗаписатьАтрибут("respnum", 	XMLСтрока(ДопПараметры.Получатель.НомерПринятого));
	
	// Префикс узла.
	ЗаписьXML.ЗаписатьАтрибут("dbprefix", 	XMLСтрока(СокрЛП(ДопПараметры.Префикс)));
	
	// GUID информационной базы.
	ЗаписьXML.ЗаписатьАтрибут("databaseid", ПолучитьИДПоОбъекту(ДопПараметры.Получатель));
	
	// Версия структуры данных обмена.
	ЗаписьXML.ЗаписатьАтрибут("version",	"1.12.04");
	
	// Последние известные нам данные о ПО фронта.
	Если ЗначениеЗаполнено(ДопПараметры.ВерсияФронтОфиса) Тогда
		ЗаписьXML.ЗаписатьАтрибут("LastKnownFrontVer", XMLСтрока(СокрЛП(ДопПараметры.ВерсияФронтОфиса)));
	КонецЕсли;
	
	Если ДопПараметры.Свойство("ПолнаяРегистрация") ИЛИ ДопПараметры.Свойство("СозданиеНачальногоОбраза") Тогда
		ЗаписьXML.ЗаписатьАтрибут("FullRegisration", "1");
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("FullRegisration", "0");
	КонецЕсли;
	
	// Наши данные.
	ЗаписьXML.ЗаписатьАтрибут("build",      Метаданные.Версия);
	ЗаписьXML.ЗаписатьАтрибут("appname",    Метаданные.Синоним);
	
	СтрокаИнформацииИБ = СформироватьСтрокуИнформацииИБ();
	Если ВыгрузкаНО Тогда
		// Выгрузка начального образа.
		ЗаписьXML.ЗаписатьАтрибут("spec", 		"Выгрузка начального образа. " + СтрокаИнформацииИБ);
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("spec", 		"Рабочая база. " + СтрокаИнформацииИБ);
	КонецЕсли; 
	
	// В режиме "только подтверждение" выгрузка данных не требуется.
	Если ДопПараметры.Свойство("ВыгружатьТолькоПодтверждениеПриема") И ДопПараметры.ВыгружатьТолькоПодтверждениеПриема Тогда
		Возврат;
	КонецЕсли;
	
	// Действия с данными.
	ЗаписьXML.ЗаписатьНачалоЭлемента("Actions");
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Булево"));
	МассивТипов.Добавить(Тип("Число"));
	
	ТаблицаДействий = Новый ТаблицаЗначений;
	ТаблицаДействий.Колонки.Добавить("ИмяОбъекта", 	Новый ОписаниеТипов("Строка"));
	ТаблицаДействий.Колонки.Добавить("Очистить", 	Новый ОписаниеТипов(МассивТипов));
	ТаблицаДействий.Колонки.Добавить("Обновить", 	Новый ОписаниеТипов(МассивТипов));
	
	// Организации
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Delivery", ВыгрузкаНО, Истина);
	
	// Организации
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Organization", ВыгрузкаНО, Истина);
	
	// PriceType
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "PriceType", ВыгрузкаНО, Истина);
	
	// Подразделения (Subunit)
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Subunit", ВыгрузкаНО, Истина);
	
	// Сотрудники
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Employee", ВыгрузкаНО, Истина);
	
	// Причины отмен
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Cancel", ВыгрузкаНО, Истина);
	
	// Места хранения/реализации
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Stor", ВыгрузкаНО, Истина);
	
	// Кассы ККМ
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "KKM", ВыгрузкаНО, Истина);
	
	// Перечень прав фронта
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Privilege", Ложь, Истина);
	
	// Роли пользователей фронта
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Role", Ложь, Истина);
	
	// Пользователи
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "User", ВыгрузкаНО, Истина);
	
	// Залы/помещения
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Area", ВыгрузкаНО, Истина);
	
	// Объектов обслуживания (столиков)
	// из этого продукта нет, не поддерживаются
	
	// Ставки НДС
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Tax", ВыгрузкаНО, Истина);
	
	// Классификатор единиц измерения
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "UnitClassifier", ВыгрузкаНО, Истина);
	
	// Группы номенклатуры
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "ProdType", ВыгрузкаНО, Истина);
	
	// КатегорииБлюд (DishesType)
	// из этого продукта нет, не поддерживаются
	
	// Номенклатура
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Product", ВыгрузкаНО, Истина);
	
	// Модификаторы
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Mod", ВыгрузкаНО, Истина);
	
	// Группы модификаторов
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "ModGrp", ВыгрузкаНО, Истина);
	
	// Типы фронтовых скидок
	// из этого продукта нет, не поддерживаются
	
	// Контрагенты (Contractor)
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Contractor", ВыгрузкаНО, Истина);
	
	// Договоры (Contract)
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Contract", ВыгрузкаНО, Истина);
	
	// Виды оплат
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "PayType", ВыгрузкаНО, Истина);
	
	// Группы принтеров (печати)
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "PrnGrp", ВыгрузкаНО, Истина);
	
	// Меню
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Menu", ВыгрузкаНО, Истина);
	
	// Гости
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Guest", ВыгрузкаНО, Истина);
	
	// Карточки
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Card", ВыгрузкаНО, Истина);
	
	// Назначение модификаторов к номенклатуре
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "ProdMod", ВыгрузкаНО, ДопПараметры.Получатель.ВыгружатьМодификаторыНоменклатуры);
	
	// Правила маршрутизации печати
	Если ВыгрузкаНО Тогда
		НоваяСтрока = ТаблицаДействий.Добавить();
		НоваяСтрока.ИмяОбъекта = "Print";
		НоваяСтрока.Очистить = Истина;
		НоваяСтрока.Обновить = (ДопПараметры.УзелОбмена.ПравилаПередачиМаршрутизации > 0);
	ИначеЕсли ДопПараметры.УзелОбмена.ПравилаПередачиМаршрутизации = 0 Тогда
		НоваяСтрока = ТаблицаДействий.Добавить();
		НоваяСтрока.ИмяОбъекта = "Print";
		НоваяСтрока.Очистить = Ложь;
		НоваяСтрока.Обновить = Ложь;
	Иначе 
		НоваяСтрока = ТаблицаДействий.Добавить();
		НоваяСтрока.ИмяОбъекта = "Print";
		НоваяСтрока.Очистить = Ложь;
		НоваяСтрока.Обновить = Истина;
	КонецЕсли;
	
	// Привязки номенклатуры
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "ProdRef", ВыгрузкаНО, Истина);
	
	// Настройки ИС МП выгружаются отдельно.
	ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "ProdStamp", ВыгрузкаНО, Истина);
	
	Если ВыгрузкаНО Тогда
		// Часть таблиц полностью очищается и
		// заполняется заново на стороне Рестарта.
		
		// Заказы будут создаваться заново.
		ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Order", Истина, Ложь);
		
		// Чеки будут пробиваться "с нуля".
		ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Check", Истина, Ложь);
		
		// Закрытия смен очищаются, будут формироваться заново.
		ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, "Shift", Истина, Ложь);
	
	КонецЕсли;
	
	Для каждого ТекСтрока Из ТаблицаДействий Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Update");
		
		ЗаписьXML.ЗаписатьАтрибут("name",	ТекСтрока.ИмяОбъекта);
		ЗаписьXML.ЗаписатьАтрибут("clear", 	БулевоСтрокой(ТекСтрока.Очистить));
		ЗаписьXML.ЗаписатьАтрибут("update", БулевоСтрокой(ТекСтрока.Обновить));
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Update 
	КонецЦикла;
		
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Actions

КонецПроцедуры

// Добавляет строку в таблицу действий над объектами при выгрузке.
//
// Параметры:
//  ТаблицаДействий - ТаблицаЗначений - Таблица действий.
//  ИмяОбъекта - Произвольный - Имя объекта.
//  Очистить - Произвольный - Очистить.
//  Обновить - Произвольный - Обновить.
//
Процедура ДобавитьСтрокуВТаблицуДействий(ТаблицаДействий, ИмяОбъекта, Очистить, Обновить)
	
	НоваяСтрока = ТаблицаДействий.Добавить();
	НоваяСтрока.ИмяОбъекта = ИмяОбъекта;
	НоваяСтрока.Очистить = Очистить;
	НоваяСтрока.Обновить = Обновить;
	
КонецПроцедуры

// Формирует строку, содержащую дополнительную информацию о базе, пользователе и другие данные.
//
// Возвращаемое значение:
// 	Строка. Текст дополнительной информации.
Функция СформироватьСтрокуИнформацииИБ()
	
	ТекПользовательСтрокой 	= СокрЛП(ПараметрыСеанса.ТекущийПользователь);
	ТекКомпьютерСтрокой 	= СокрЛП(ИмяКомпьютера());
	СтрокаПодключенияКБазе 	= СтрокаСоединенияИнформационнойБазы();
	СтрокаИнформации = "Пользователь: " + ТекПользовательСтрокой
		+ "; " + "Компьютер: " +  ТекКомпьютерСтрокой
		+ "; " + "Подключение к базе: " + СтрокаПодключенияКБазе;
	
	Возврат СтрокаИнформации;
	
КонецФункции

// Производит запись измененных реквизитов узла обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  СтруктураНастроекОбменаДанными - Структура - Структура настроек обмена данными.
//
Процедура ЗаписатьРеквизитыУзлаПриВыгрузке(УзелОбмена, СтруктураНастроекОбменаДанными)
	
	УзелОбменаОбъект = УзелОбмена.ПолучитьОбъект();
	УзелОбменаОбъект.НомерОтправленного = СтруктураНастроекОбменаДанными.НомерОтправленного + 1;
	
	УзелОбменаОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
	Попытка
		УзелОбменаОбъект.Записать();
	Исключение
		СтрокаСообщенияОбОшибке = ОписаниеОшибки();
		ЗафиксироватьСобытие(СтруктураНастроекОбменаДанными.ПрефиксЛога + "Запись", "Ошибка при записи реквизитов узла обмена." + Символы.ПС + СтрокаСообщенияОбОшибке, УзелОбмена, , Истина);
	КонецПопытки;
	
КонецПроцедуры

// Производит запись реквизитов кассового узла в XML-файл.
//
// Параметры:
//  ЗаписьXML - Произвольный - Запись xml.
//  УзелОбмена - Произвольный - Узел обмена.
//
Процедура ЗаписатьНастройкиУзла(ЗаписьXML, УзелОбмена)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Settings");
	ЗаписьXML.ЗаписатьАтрибут("spec", 	"настройки кассового узла"); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
	ЗаписьXML.ЗаписатьАтрибут("Key", 	"ModeSplitCheck");  //  Имя реквизита
	Если УзелОбмена.РазделениеЧеков = Перечисления.питВариантыРазделенияЧеков.ПоОрганизациямНоменклатуры Тогда
		ЗначениеНастройки = "1";
	Иначе
		ЗначениеНастройки = "0";
	КонецЕсли; 
	ЗаписьXML.ЗаписатьАтрибут("Value", 	ЗначениеНастройки);  // Значение реквизита
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	
	Если ЗначениеЗаполнено(УзелОбмена.Организация) Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
		ЗаписьXML.ЗаписатьАтрибут("Key", 	"Organization");  //  Имя реквизита 
		ЗаписьXML.ЗаписатьАтрибут("Value", 	ПолучитьИДПоОбъекту(УзелОбмена.Организация));  // Значение реквизита
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	КонецЕсли;

	Если ЗначениеЗаполнено(УзелОбмена.Подразделение) Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
		ЗаписьXML.ЗаписатьАтрибут("Key", 	"Subunit");  //  Имя реквизита
		ЗаписьXML.ЗаписатьАтрибут("Value", 	ПолучитьИДПоОбъекту(УзелОбмена.Подразделение));  // Значение реквизита
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
	ЗаписьXML.ЗаписатьАтрибут("Key", 	"IndividualMenu");  //  Имя реквизита
	ЗаписьXML.ЗаписатьАтрибут("Value",	БулевоСтрокой(УзелОбмена.ИндивидуальныйСписокВидовМенюИНоменклатуры));  // Значение реквизита
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
	ЗаписьXML.ЗаписатьАтрибут("Key", 	"SalesCurrency");
	ЗаписьXML.ЗаписатьАтрибут("Value",	питОбменДаннымиПовтИсп.ПолучитьКодРеглВал());
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
	ЗаписьXML.ЗаписатьАтрибут("Key", 	"Stopped");  //  Имя реквизита
	ЗаписьXML.ЗаписатьАтрибут("Value",	БулевоСтрокой(УзелОбмена.ВыгружатьСтопДляПозицийМеню));  // Значение реквизита
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	
	СтруктураНастроекУзла = Новый Структура;
	// TODO: Пока всегда истина.
	// СтруктураНастроекУзла.Вставить("UseAlcoMarksForCooking", БулевоСтрокой(УзелОбмена.ОформлятьДокументыЕГАИС));
	СтруктураНастроекУзла.Вставить("UseAlcoMarksForCooking", БулевоСтрокой(Истина));
	
	АдресСервера = Константы.АдресПубликацииИнформационнойБазыВИнтернете.Получить();
	Если НЕ ЗначениеЗаполнено(АдресСервера) Тогда
		АдресСервера = Константы.АдресПубликацииИнформационнойБазыВЛокальнойСети.Получить();
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресСервера) Тогда
		АдресСервера = СтрШаблон("%1/hs/remotecheckout",АдресСервера);
	КонецЕсли;
	СтруктураНастроекУзла.Вставить("BackServerAddress", АдресСервера);
	
	Для Каждого ТекНастройка Из СтруктураНастроекУзла Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Item");
		ЗаписьXML.ЗаписатьАтрибут("Key", 	ТекНастройка.Ключ);  //  Имя реквизита
		ЗаписьXML.ЗаписатьАтрибут("Value",	ТекНастройка.Значение);  // Значение реквизита
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Item
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Settings
	
КонецПроцедуры

// Производит запись элемента справочника "Ставки НДС" в XML-файл.
//
// Параметры:
//  ЗаписьXML - Произвольный - Запись xml.
//  ДопПараметры - Произвольный - Доп параметры.
//  Описание - Произвольный - Описание.
//
Процедура ЗаписатьСтавкиНДС(ЗаписьXML, ДопПараметры, Описание = "")
	
	ИмяОбъекта = "Tax";
	Для Каждого ТекСтрока Из ДопПараметры.ТаблицаСтавокНДС Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Object");
		ЗаписьXML.ЗаписатьАтрибут("name", ИмяОбъекта);
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Properties");
		
		ЗаписьXML.ЗаписатьАтрибут("ID", 		ПолучитьСтрокуПоИД(ТекСтрока.ИД));
		ЗаписьXML.ЗаписатьАтрибут("Name", 		ТекСтрока.Наименование);
		
		Если ТипЗнч(ТекСтрока.Значение) = Тип("Число") Тогда
			ЗаписьXML.ЗаписатьАтрибут("Perc",  	Формат(ТекСтрока.Значение, "ЧГ=;ЧРД='.';ЧН=0"));
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Properties
	
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Object
		
	КонецЦикла;
	
КонецПроцедуры

// Производит запись элемента справочника "Ставки НДС" в XML-файл.
//
// Параметры:
// 	ЗаписьXML   	- Объект для записи XML.
// 	ДопПараметры   	- Структура. Структура дополнительных параметров обмена.
//
// Возвращаемое значение:
// 	Нет.	
//
Процедура ЗаписатьНастройкиУчетаМаркируемойПродукции(ЗаписьXML, ДопПараметры, Описание = "")
	
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Таблица.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС.Изменения КАК Таблица
	|ГДЕ
	|	Таблица.Узел = &Узел";
	
	
	Запрос.УстановитьПараметр("Узел", ДопПараметры.Получатель);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаДатНачалаРаботыСМаркируемойПродукцией = КонструкторИСМПОбщегоНазначенияКлиентСервер.ИменаДатНачалаРаботыСМаркируемойПродукцией();

	ДоступныеВидыПродукции = питИнтеграцияИСМП.ДоступныеВидыПродукции();
	ИмяОбъекта = "ProdStamp";
	Коллекция = Новый Массив(1);
	СтруктураОбъекта = питОбменДаннымиПовтИсп.ПолучитьСтруктуруОбъекта(ИмяОбъекта);
	ДанныеКеша = ОбновлениеИнформационнойБазыГосИС.КешКонвертацийВидаПродукции();
	Для Каждого ВидПродукцииИСПереч Из Перечисления.ВидыПродукцииИС Цикл
		
		Если ВидПродукцииИСПереч = Перечисления.ВидыПродукцииИС.Алкогольная Тогда
			Продолжить;
		КонецЕсли;
		
		ВидыПродукции = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоПеречислению(ВидПродукцииИСПереч);
		
		ДоступенДляВыгрузки = Ложь;
		ИспользуетсяВидПродукции = Ложь;
		Для Каждого ВидПродукции Из ВидыПродукции Цикл
			Если ДанныеКеша.ВидыПродукцииГИСМТ.Найти(ВидПродукции) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДоступенДляВыгрузки = Истина;
			ИспользуетсяВидПродукции = ИспользуетсяВидПродукции ИЛИ НЕ ДоступныеВидыПродукции.Найти(ВидПродукции) = Неопределено;
		КонецЦикла;
		
		Если НЕ ДоступенДляВыгрузки Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектЗаписи = Новый Структура;
		ОбъектЗаписи.Вставить("ВидПродукции", ВидПродукцииИСПереч);
		ОбъектЗаписи.Вставить("ВестиУчетПродукции", ИспользуетсяВидПродукции);
		Для Каждого Имя Из ИменаДатНачалаРаботыСМаркируемойПродукцией Цикл
			Значение = Дата('00010101');
			Для Каждого ТекВидПродукции Из ВидыПродукции Цикл
				Значения = КонструкторИСОбщегоНазначенияКлиентСервер.ЗначенияЭлементаКонструктораПоВидуПродукции(
					ПредопределенноеЗначение(
					СтрШаблон("Справочник.ЭлементыКонструктораВидовПродукцииИС.%1",
					КонструкторИСМПОбщегоНазначенияКлиентСервер.ИмяЭлементаКонструктораПоИмениДаты(Имя))),
					ТекВидПродукции);
				Если Значения.Количество() > 0 Тогда
					Значение = Значения[0];
					Прервать;
				КонецЕсли;
			КонецЦикла;
			ОбъектЗаписи.Вставить(Имя, Значение);
		КонецЦикла;
		Коллекция[0] = ОбъектЗаписи;
		ЗаписатьКоллекцию(ЗаписьXML, Коллекция, ИмяОбъекта, 
									СтруктураОбъекта, Ложь);
	КонецЦикла;
	
КонецПроцедуры

Функция ОбработатьИЗаписатьНаборНастроекИС(НаборЗаписей, СвойстваОбъекта, ДопПараметры)
	
	НаборЗаписей.Очистить();
	
	ВидыПродукции = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоПеречислению(СвойстваОбъекта.ВидПродукции);
	
	
	Для Каждого ВидПродукции Из ВидыПродукции Цикл
		ПараметрыЗаписи = АдминистрированиеИСМПКлиентСервер.ПараметрыЗаписиМаркируемойПродукции();
		ПараметрыЗаписи.ЗаписыватьВидПродукции = Истина;
		
		СтрокаДанных = АдминистрированиеИСМПКлиентСервер.СтрокаДанныхЗаписиМаркируемойПродукции();
		СтрокаДанных.ВидПродукции = ВидПродукции;
		СтрокаДанных.ВидПродукцииВерхнегоУровня = Истина;
		СтрокаДанных.УдалениеДанных = НЕ СвойстваОбъекта.ВестиУчетПродукции;
		ПараметрыЗаписи.Данные.Добавить(СтрокаДанных);
		
		ИменаДатНачалаРаботыСМаркируемойПродукцией = КонструкторИСМПОбщегоНазначенияКлиентСервер.ИменаДатНачалаРаботыСМаркируемойПродукцией();
		Для Каждого Имя Из ИменаДатНачалаРаботыСМаркируемойПродукцией Цикл
			Если НЕ СвойстваОбъекта.Свойство(Имя) Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыЗаписи["Записывать" + Имя] = Истина;
			СтрокаДанных[Имя] = СвойстваОбъекта[Имя];
		КонецЦикла;
		
		Результат = АдминистрированиеИСМП.ЗаписатьДанныеМаркируемойПродукции(ПараметрыЗаписи);	
		
	КонецЦикла;
	
	Возврат Новый Структура("Результат, НужноЗаписать", Истина, Ложь);
	
КонецФункции



// Функция - Получить код права.
//
// Параметры:
//  ЗначениеРеквизита - Произвольный - Значение реквизита.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьКодПрава(ЗначениеРеквизита)
	
	КодПрава = СокрЛП(ЗначениеРеквизита);
	Если ЗначениеЗаполнено(КодПрава) Тогда
		КодПраваЧислом = Число(КодПрава);
	Иначе
		КодПраваЧислом = 0;
	КонецЕсли;
	
	Если КодПраваЧислом < 10000 Тогда
		КодПрава = Прав("000" + СокрЛП(КодПрава), 3);
	Иначе
		КодПрава = Прав("00000" + СокрЛП(КодПрава), 5);
	КонецЕсли;
	
	Возврат КодПрава;
КонецФункции

// Процедура записи удаления объекта в XML сообщение
//
// Параметры:
//  ЗаписьXML - ЗаписьXML - Объект для записи XM.
//  Объект - ЗаписьXML - Объект для записи XM.
//  ИмяОбъекта - Строка - Имя объекта в XM.
//
Процедура ЗаписатьУдалениеОбъекта(ЗаписьXML, Объект, ИмяОбъекта)
	
	Если НЕ ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("DeleteObject");
	
	Попытка
		ЗаписьXML.ЗаписатьАтрибут("name"	,ИмяОбъекта);
		ЗаписьXML.ЗаписатьАтрибут("ID"		,ПолучитьИДПоОбъекту(Объект));
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "УдаленныеКассы.Выгрузка.ЗаписьУдаления";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры // ЗаписатьУдалениеОбъекта

// Функция создает XML чтение по узлу обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ИмяФайлаОбменаДанными - Произвольный - Знач имя файла обмена данными.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьXMLЧтениеДляОбменаДанными(УзелОбмена, Знач ИмяФайлаОбменаДанными)
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайлаОбменаДанными);
		Возврат ЧтениеXML;
	Исключение
		Возврат Неопределено;
	КонецПопытки;	
КонецФункции

// Процедура получения сообщения обмена данными.
//  Получает сообщение с новыми данными для этого узла и загружает данные.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
// Возвращаемое значение:
//  Булево       - результат операции.
Функция ПрочитатьСообщениеСИзменениями(Параметры)
	
	Перем НомерСообщения;
	ИмяФайлаСообщения = Параметры.ИмяФайлаСообщения;
	
	РезЧтения = Ложь;
	
	УзелОбмена =  Параметры.УзелОбмена;
	ТемпФайлыДляУдаления = "";
	
	Если ПустаяСтрока(ИмяФайлаСообщения) Тогда
		СтрОшибок = "В функцию чтения сообщения не передали имя файла с сообщением";
		Параметры.Вставить("Ошибка", СтрОшибок);
		Возврат Ложь;
	КонецЕсли;
	
	ТестФайл = Новый Файл(ИмяФайлаСообщения);
	Если НЕ ТестФайл.Существует() ИЛИ НЕ ТестФайл.ЭтоФайл() ИЛИ (ВРЕГ(ТестФайл.Расширение) <> ".XML") Тогда
		СтрОшибок = "Функция чтения сообщения получила некорректное имя файла <" + ИмяФайлаСообщения + ">";
		Параметры.Вставить("Ошибка", СтрОшибок);
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		ЗафиксироватьСобытие(Параметры.ПрефиксЛога + "Чтение", "Начало чтения файла сообщения """ + ИмяФайлаСообщения + """", УзелОбмена,УровеньЖурналаРегистрации.Информация,Параметры.Комментировать);
		КоличествоПопыток = 3;
		ТекОшибка = "";
		НомерСообщения = 0;
		Индекс = 0;
		Пока Истина Цикл
			Попытка
				ЧтениеXML = СоздатьXMLЧтениеДляОбменаДанными(УзелОбмена, ИмяФайлаСообщения);
				ЗагрузитьИзмененияДанныхДляУзла(УзелОбмена, Параметры, ЧтениеXML);
				
				Параметры.Свойство("НомерОтправленного", НомерСообщения);
				РезультатЧтения = Неопределено;
				Если Параметры.Свойство("РезультатЧтения", РезультатЧтения) Тогда
					НомерСообщения = ?(РезультатЧтения, НомерСообщения, 0);
				КонецЕсли;
				Прервать;
			Исключение
				
				Если ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
				КонецЕсли;
				
				СтрОшибки = ИнформацияОбОшибке().Описание;
				Индекс = Индекс + 1;
				СтрСообщения =  СтрОшибки + Символы.ВК + "(Имя модуля: " + ИнформацияОбОшибке().ИмяМодуля + ", " + "номер строки: " + ИнформацияОбОшибке().НомерСтроки + ")";
			КонецПопытки;
			
			ЗафиксироватьСобытие(Параметры.ПрефиксЛога + "Чтение", "Ошибка чтения сообщения. Попытка № " + Индекс + " : " + СтрСообщения, УзелОбмена, УровеньЖурналаРегистрации.Ошибка,Параметры.Комментировать);
			ТекОшибка = СтрОшибки;
			Параметры.Вставить("Ошибка", СтрСообщения);
			
			Если Индекс = КоличествоПопыток Тогда
				ВызватьИсключение "Исчерпан лимит (" + Строка(КоличествоПопыток) + ") попыток записи сообщения обмена.";
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(НомерСообщения) Тогда
			СтрСообщения = "Успешно принято сообщение № " + НомерСообщения + " из узла """ 
			+ УзелОбмена.Наименование + """ (файл """ + ИмяФайлаСообщения + """)";
			РезЧтения = Истина;
			ЗаписьЖурналаРегистрации(Параметры.ПрефиксЛога + "Чтение", УровеньЖурналаРегистрации.Информация,,, СтрСообщения);
		КонецЕсли;
		
	Исключение
		РезЧтения = Ложь;
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		СтатусСобытия = УровеньЖурналаРегистрации.Предупреждение;
		Если Найти(ТекстОшибки, "Номер сообщения меньше или равен номеру ранее принятого сообщения") > 0 Тогда
			СтрСообщения = "Номер сообщения меньше или равен номеру ранее принятого сообщения! ";
		Иначе	
			СтрСообщения = "При чтении сообщения возникла ошибка: " + ТекстОшибки;
			СтатусСобытия = УровеньЖурналаРегистрации.Ошибка;
		КонецЕсли;
		ЗафиксироватьСобытие(Параметры.ПрефиксЛога + "Чтение", СтрСообщения, УзелОбмена, СтатусСобытия, Параметры.Комментировать);
		Параметры.Вставить("Ошибка", СтрСообщения);
	КонецПопытки;
	ЗафиксироватьСобытие(Параметры.ПрефиксЛога + "Чтение", "Конец чтения файла сообщения """ + ИмяФайлаСообщения + """", УзелОбмена,УровеньЖурналаРегистрации.Информация,Параметры.Комментировать);
	
	Возврат РезЧтения;
КонецФункции

// Производит загрузку сообщения обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  СтруктураНастроекОбменаДанными - Структура - Структура настроек обмена данными.
//  ЧтениеXML - Произвольный - Чтение xml.
//
Процедура ЗагрузитьИзмененияДанныхДляУзла(УзелОбмена, СтруктураНастроекОбменаДанными, ЧтениеXML)
	
	ДополнитьСтруктуруОбменаПриЗагрузкеПоУзлу(УзелОбмена, СтруктураНастроекОбменаДанными);
	ПрочитатьСообщение(ЧтениеXML, УзелОбмена, СтруктураНастроекОбменаДанными);
	ЗаписатьРеквизитыУзлаПриЗагрузке(УзелОбмена, СтруктураНастроекОбменаДанными);
	
КонецПроцедуры

// Дополняет структуру настроек обмена настройками узла обмена
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ДополнитьСтруктуруОбменаПриЗагрузкеПоУзлу(УзелОбмена, ДопПараметры)
	
	Реквизиты = УзелОбмена.Метаданные().Реквизиты;
	Для Каждого Реквизит Из Реквизиты Цикл
		ДопПараметры.Вставить(Реквизит.Имя, УзелОбмена[Реквизит.Имя]);
	КонецЦикла;
	
	ДопПараметры.Вставить("ВалютаУчета", 		Константы.ВалютаРегламентированногоУчета.Получить());
	
	Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		ТекСтавкаНДС = УчетНДСУП.СтавкаНДСПоУмолчанию(УзелОбмена.Организация, ТекущаяДатаСеанса());
	Иначе
		ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(18);
		ТекСтавкаНДС = ПолучитьСтавкуНДС(ТекСтавкаНДС, ТекущаяДатаСеанса());
	КонецЕсли;
	ДопПараметры.Вставить("СтавкаНДС",   		ТекСтавкаНДС);
	
	ДопПараметры.Вставить("УзелОбмена", 		УзелОбмена);
	ДопПараметры.Вставить("Отправитель", 		УзелОбмена);
	ДопПараметры.Вставить("НомерОтправленного", УзелОбмена.НомерОтправленного);
	ДопПараметры.Вставить("НомерПринятого", 	УзелОбмена.НомерПринятого);
	
	ДопПараметры.Вставить("ПриниматьТолькоДанныеПродаж", 	УзелОбмена.ПриниматьТолькоДанныеПродаж);
	
	ДопПараметры.Вставить("ТаблицаСтавокНДС", 	ПолучитьТаблицуСтавокНДС(УзелОбмена.Организация));
	ДопПараметры.Вставить("ТаблицаМетаданныхДляЗагрузки", 	питОбменДаннымиПовтИсп.ПолучитьСтруктуруМетаданныхДляОбменов(Ложь, Неопределено, Истина));
	
	ДопПараметры.Вставить("ТипУдаление",		Тип("УдалениеОбъекта"));
	
	ДопПараметры.Вставить("ЧекиНаПроведение", Новый Массив);
	
	ДопПараметры.Вставить("ДокументыДляЗагрузкиИзДанныхПродаж", Новый Массив);
	
	ДопПараметры.Вставить("ТаблицаЧековОбщепита", ПолучитьТаблицуЧековОбщепита());

КонецПроцедуры

// Производит запись измененных реквизитов узла обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  СтруктураНастроекОбменаДанными - Структура - Структура настроек обмена данными.
//
Процедура ЗаписатьРеквизитыУзлаПриЗагрузке(УзелОбмена, СтруктураНастроекОбменаДанными)
	
	УзелОбменаОбъект = УзелОбмена.ПолучитьОбъект();
	УзелОбменаОбъект.НомерПринятого   = СтруктураНастроекОбменаДанными.НомерОтправленного;
	УзелОбменаОбъект.ВерсияФронтОфиса = СтруктураНастроекОбменаДанными.ВерсияФронтОфиса;
	
	РазделениеЧеков = Неопределено;
	СтруктураНастроекОбменаДанными.Свойство("РазделениеЧеков", РазделениеЧеков);
	Если РазделениеЧеков <> Неопределено Тогда
		УзелОбменаОбъект.РазделениеЧеков = РазделениеЧеков;
	КонецЕсли;
	
	// ТЧ "Виды меню"
	ВидыМенюУзлаОбмена = Неопределено;
	Если СтруктураНастроекОбменаДанными.Свойство("ВидыМенюУзлаОбмена", ВидыМенюУзлаОбмена) И УзелОбменаОбъект.ВидыМеню.Количество() Тогда
		ЗаполнитьВидыМенюУзлаОбмена(УзелОбменаОбъект, ВидыМенюУзлаОбмена, УзелОбменаОбъект.ВидыМеню[0].ТипЦен);
	КонецЕсли;
	
	// Организации
	ДополнительныеОрганизацииУзла = Неопределено;
	СтруктураНастроекОбменаДанными.Свойство("ДополнительныеОрганизацииУзла", ДополнительныеОрганизацииУзла);
	Если ДополнительныеОрганизацииУзла <> Неопределено Тогда
		ЗаполнитьДополнительныеОрганизацииУзла(УзелОбменаОбъект, ДополнительныеОрганизацииУзла);
	КонецЕсли;
	УзелОбменаОбъект.Многофирменность = Истина;
	
	// ТЧ "Залы"
	ЗалыУзлаОбмена = Неопределено;
	Если СтруктураНастроекОбменаДанными.Свойство("ЗалыУзлаОбмена", ЗалыУзлаОбмена) И УзелОбменаОбъект.Залы.Количество() Тогда
		ЗаполнитьЗалыУзлаОбмена(УзелОбменаОбъект, ЗалыУзлаОбмена);
	КонецЕсли; 
	
	// ТЧ "Места печати"
	МестаПечатиУзлаОбмена = Неопределено;
	Если СтруктураНастроекОбменаДанными.Свойство("МестаПечатиУзлаОбмена", МестаПечатиУзлаОбмена) И УзелОбменаОбъект.МестаПечати.Количество() Тогда
		ЗаполнитьМестаПечатиУзлаОбмена(УзелОбменаОбъект, МестаПечатиУзлаОбмена);
	КонецЕсли; 
	
	УзелОбменаОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
	УзелОбменаОбъект.ОбменДанными.Загрузка = Истина; // Чтобы не срабатывала типовая подписка, а то она падает.
	Попытка
		 УзелОбменаОбъект.Записать();
	Исключение
		СтрокаСообщенияОбОшибке = ОписаниеОшибки();
		ЗафиксироватьСобытие(СтруктураНастроекОбменаДанными.ПрефиксЛога + "Чтение", "Ошибка при записи реквизитов узла обмена." + Символы.ПС + СтрокаСообщенияОбОшибке, УзелОбмена, УровеньЖурналаРегистрации.Ошибка, Истина);
	КонецПопытки; 
	
КонецПроцедуры

// Заполняет табличную часть "Залы" узла обмена.
//
// Параметры:
//  УзелОбменаОбъект - Произвольный - Узел обмена объект.
//  ЗалыУзла - Произвольный - Залы узла.
//
Процедура ЗаполнитьЗалыУзлаОбмена(УзелОбменаОбъект, ЗалыУзла)
	
	Колво = ЗалыУзла.Количество(); 
	Для ОбрИнд = 1 По Колво Цикл
		ПроверяемыйЗал	= ЗалыУзла[Колво - ОбрИнд];
		НоваяСтрока 	= УзелОбменаОбъект.Залы.Добавить();
		НоваяСтрока.Зал = ПроверяемыйЗал;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет табличную часть "Места печати" узла обмена.
//
// Параметры:
//  УзелОбменаОбъект - Произвольный - Узел обмена объект.
//  МестаПечатиУзла - Произвольный - Места печати узла.
//
Процедура ЗаполнитьМестаПечатиУзлаОбмена(УзелОбменаОбъект, МестаПечатиУзла)
	
	Колво = МестаПечатиУзла.Количество(); 
	Для ОбрИнд = 1 По Колво Цикл
		ПроверяемоеМестоПечати	= МестаПечатиУзла[Колво - ОбрИнд];
		НоваяСтрока 			= УзелОбменаОбъект.МестаПечати.Добавить();
		НоваяСтрока.МестоПечати = ПроверяемоеМестоПечати;
	КонецЦикла;
	
КонецПроцедуры

// Создает таблицу структуры данных для последующего чтения документа.
//
// Параметры:
// 	Нет.
//
// Возвращаемое значение:
//	ТаблицаЗначений. Таблица структуры данных.
//
Функция СоздатьТаблицуСтруктуры()
	
	ТаблицаСтруктуры = Новый ТаблицаЗначений;
	ТаблицаСтруктуры.Колонки.Добавить("ИмяРеквизита",  Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаСтруктуры.Колонки.Добавить("ПутьКДанным",   Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаСтруктуры.Колонки.Добавить("ТипДанных",     Новый ОписаниеТипов("Тип"));
	ТаблицаСтруктуры.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	
	Возврат ТаблицаСтруктуры;
	
КонецФункции

// Создает таблицу значений для чтения табличной части документа.
//
// Параметры
//	ТаблицаСтруктуры  - ТаблицаЗначений. Таблица структуры данных.
//
// Возвращаемое значение
// 	ТаблицаЗначений. Таблица, содержащая данные табличной части.
//
Функция СоздатьТаблицуДляЧтенияТабличнойЧасти(ТаблицаСтруктуры)
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для каждого ТекСтрока Из ТаблицаСтруктуры Цикл
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТекСтрока.ТипДанных);
		ТаблицаРезультат.Колонки.Добавить(ТекСтрока.ИмяРеквизита, Новый ОписаниеТипов(МассивТипов));
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Преобразует значение типа "Строка" в тип "Дата".
//
// Параметры:
// 	Значение   - Строка
//  ФорматДаты - Строка
//
// Возвращаемое значение:
//	тип Дата
//
Функция ПолучитьДатуПоСтроке(Значение, ФорматДаты = "")
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Год 	= 1;
	Месяц 	= 1;
	День 	= 1;
	Час 	= 0;
	Минута 	= 0;
	Секунда = 0;
	
	СтрДлина = СтрДлина(Значение);
	ПозПервДвоеточия = Найти(Значение, ":");
	
	Если ПустаяСтрока(ФорматДаты) Тогда 
		// Определим формат даты
		Если (СтрДлина = 23) ИЛИ (СтрДлина = 22) Тогда
			Если (Число(Сред(Значение, 7, 4)) - Цел(Число(Сред(Значение, 7, 4))) = 0) Тогда 
				ФорматДаты = "dd.MM.yyyy HH:mm:ss.000";
			Иначе
				ФорматДаты = "yyyy.MM.dd HH:mm:ss.000";
			КонецЕсли;
		ИначеЕсли (СтрДлина = 19) ИЛИ (СтрДлина = 18) Тогда 
			Если (Число(Сред(Значение, 7, 4)) - Цел(Число(Сред(Значение, 7, 4))) = 0) Тогда 
				ФорматДаты = "dd.MM.yyyy HH:mm:ss";
			Иначе
				ФорматДаты = "yyyy.MM.dd HH:mm:ss";
			КонецЕсли;
		ИначеЕсли СтрДлина = 10 Тогда
			Если(Число(Сред(Значение, 7, 4)) - Цел(Число(Сред(Значение, 7, 4))) = 0) Тогда 
				ФорматДаты = "dd.MM.yyyy";
			Иначе
				ФорматДаты = "yyyy.MM.dd";
			КонецЕсли;
		ИначеЕсли (СтрДлина = 8) ИЛИ (СтрДлина = 7) Тогда
			ФорматДаты = "HH:mm:ss";
		КонецЕсли;
		
	КонецЕсли;
	
	// Получим значения даты
	Если ФорматДаты = "dd.MM.yyyy" Тогда
		// 22.09.2009
		Год 	= Число(Сред(Значение, 7, 4));
		Месяц 	= Число(Сред(Значение, 4, 2));
		День 	= Число(Сред(Значение, 1, 2));
		Час		= 0;
		Минута	= 0;
		Секунда	= 0;
		
	ИначеЕсли ФорматДаты = "yyyy.MM.dd" Тогда 
		// 2009.09.22
		Год 	= Число(Сред(Значение, 1, 4));
		Месяц 	= Число(Сред(Значение, 6, 2));
		День 	= Число(Сред(Значение, 9, 2));
		Час		= 0;
		Минута	= 0;
		Секунда	= 0;
		
	ИначеЕсли ФорматДаты = "dd.MM.yyyy HH:mm:ss" ИЛИ ФорматДаты = "dd.MM.yyyy HH:mm:ss.000" Тогда
		// 22.09.2009 11:08:54
		День 	= Число(Сред(Значение, 1, 2));
		Месяц 	= Число(Сред(Значение, 4, 2));
		Год 	= Число(Сред(Значение, 7, 4));
		
		ПозПервДвоеточия = Найти(Значение, ":");
		
		Попытка
			Час 	= Число(Сред(Значение, 12, ПозПервДвоеточия - 12));
		Исключение
			Час		= 0;
		КонецПопытки;
		Попытка
			Минута 	= Число(Сред(Значение, ПозПервДвоеточия + 1, 2));
		Исключение
			Минута 	= 0;
		КонецПопытки;
		Попытка
			Секунда	= Число(Сред(Значение, ПозПервДвоеточия + 4, 2));
		Исключение
			Секунда	= 0;
		КонецПопытки;
		
	ИначеЕсли (ФорматДаты = "yyyy.MM.dd HH:mm:ss") ИЛИ (ФорматДаты = "yyyy.MM.dd HH:mm:ss.000") Тогда
		
		Год 	= Число(Сред(Значение, 1, 4));
		Месяц 	= Число(Сред(Значение, 6, 2));
		День 	= Число(Сред(Значение, 9, 2));
		
		ПозПервДвоеточия = Найти(Значение, ":");
		
		Попытка
			Час 	= Число(Сред(Значение, 12, ПозПервДвоеточия - 12));
		Исключение
			Час		= 0;
		КонецПопытки;
		Попытка
			Минута 	= Число(Сред(Значение, ПозПервДвоеточия + 1, 2));
		Исключение
			Минута 	= 0;
		КонецПопытки;
		Попытка
			Секунда	= Число(Сред(Значение, ПозПервДвоеточия + 4, 2));
		Исключение
			Секунда	= 0;
		КонецПопытки;
		
	ИначеЕсли Найти(ФорматДаты, "HH:mm:ss") > 0 Тогда
		// 11:08:54
		
		ТекДата = ТекущаяДата();
		Год 	= Год(ТекДата);
		Месяц 	= Месяц(ТекДата);
		День 	= День(ТекДата);
		
		ПозПервДвоеточия = Найти(Значение, ":");

		Если ПозПервДвоеточия = 0 Тогда
			Час = 0;
			Минута = 0;
			Секунда = 0;
		Иначе
			ПозицияПробел =  Найти(Значение, " "); 
			Если ПозицияПробел = 0 Тогда
				Час		= Число(Сред(Значение, 1, 2));
				Минута	= Число(Сред(Значение, 4, 2));
				Секунда	= Число(Сред(Значение, 7, 2));
			Иначе
				Час		= Число(Сред(Значение, ПозицияПробел + 1, ПозПервДвоеточия - ПозицияПробел - 1));
				Минута	= Число(Сред(Значение, ПозПервДвоеточия + 1, 2));
				Секунда	= Число(Сред(Значение, ПозПервДвоеточия + 4, 2));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	
КонецФункции // ПолучитьДатуПоСтроке

// Создает структуру таблицы для последующего заполнения родителя загруженных модификаторов
//
// Параметры:
//	ДопПараметры      - Структура. Структура дополнительных параметров обмена
//
// Возвращаемое значение:
//	Нет 	
//
Процедура СоздатьТаблицуМодификаторов(ДопПараметры)
	
	ТаблицаМодификаторов = Новый ТаблицаЗначений;
	ТаблицаМодификаторов.Колонки.Добавить("ГруппаМодификаторов", Новый ОписаниеТипов("СправочникСсылка.Модификаторы"));
	ТаблицаМодификаторов.Колонки.Добавить("ИДМодификатора", 	 Новый ОписаниеТипов("Строка"));
	
	ДопПараметры.Вставить("ТаблицаМодификаторов", ТаблицаМодификаторов);

КонецПроцедуры // СоздатьТаблицуМодификаторов

// Добавляет реквизит в таблицу структуры данных.
//
// Параметры:
// 	ТаблицаСтруктуры - ТаблицаЗначений. Таблица структуры данных.
//	ИмяРеквизита     - Строка. Имя реквизита.
//	ПутьКДанным      - Строка. Путь к данным для чтения реквизита.
//	ТипДанных        - Тип. Тип значения реквизита.
//	Представление    - Строка. Представления (синоним) реквизита.
//
// Возвращаемое значение:
//	Нет.
//
Процедура ДобавитьРеквизитВТаблицу(ТаблицаСтруктуры, ИмяРеквизита, ПутьКДанным, ТипДанных, Представление = "")
	
	НоваяСтрока = ТаблицаСтруктуры.Добавить();
	НоваяСтрока.ИмяРеквизита 			= ИмяРеквизита;
	НоваяСтрока.ПутьКДанным 			= ПутьКДанным;
	НоваяСтрока.ТипДанных 				= ТипДанных;
	НоваяСтрока.Представление 			= Представление;
	
КонецПроцедуры

// Заполняет структуру параметров дополнительными значениями
// из объекта планов обмена "Кассовые узлы".
Процедура ДополнитьПараметрыУзла(УзелОбмена, ДопПараметры)
	
	ДопПараметры.Вставить("ОрганизацииУзла", Новый Массив);
	ДопПараметры.Вставить("ПодразделенияУзла", Новый Массив);
	
	Если УзелОбмена.Многофирменность Тогда
		
		// Получим список дополнительный организаций и подразделений кассового узла.
		ТЗ = "ВЫБРАТЬ
		|	питУдаленныеКассыДопОрганизации.Организация КАК Организация,
		|	питУдаленныеКассыДопОрганизации.Подразделение КАК Подразделение
		|ИЗ
		|	ПланОбмена.питУдаленныеКассы.ДополнительныеОрганизации КАК питУдаленныеКассыДопОрганизации
		|ГДЕ
		|	питУдаленныеКассыДопОрганизации.Ссылка = &ВыбУзел";
		
		Запрос = Новый Запрос(ТЗ);
		Запрос.УстановитьПараметр("ВыбУзел", УзелОбмена.Ссылка);
		ТаблицаОрганизацийУзла = Запрос.Выполнить().Выгрузить();
		ДопПараметры.Вставить("ОрганизацииУзла", 	ТаблицаОрганизацийУзла.ВыгрузитьКолонку("Организация"));
		ДопПараметры.Вставить("ПодразделенияУзла", 	ТаблицаОрганизацийУзла.ВыгрузитьКолонку("Подразделение"));
		
	КонецЕсли;
	
	// Добавим организацию узла по-умолчанию (или она будет единственной).
	Если ДопПараметры.ОрганизацииУзла.Найти(УзелОбмена.Организация) = НЕОПРЕДЕЛЕНО Тогда
		ДопПараметры.ОрганизацииУзла.Добавить(УзелОбмена.Организация);
	КонецЕсли;
	
	// Добавим подразделение узла по-умолчанию (или оно будет единственным).
	Если ДопПараметры.ПодразделенияУзла.Найти(УзелОбмена.Подразделение) = НЕОПРЕДЕЛЕНО Тогда
		ДопПараметры.ПодразделенияУзла.Добавить(УзелОбмена.Подразделение);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСрокРеализацииШтрихкода(Штрихкод)
	
	Результат = 0;
	
	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат Результат;
	КонецЕсли;
	
	РеквизитыШтрихкода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Штрихкод, "питДатаПодключения, питСрокРеализации");
	
	Если НЕ ЗначениеЗаполнено(РеквизитыШтрихкода.питСрокРеализации)
		ИЛИ НЕ ЗначениеЗаполнено(РеквизитыШтрихкода.питДатаПодключения)
		ИЛИ КонецДня(РеквизитыШтрихкода.питДатаПодключения) = РеквизитыШтрихкода.питСрокРеализации Тогда
		
		Результат = 0;
		
	Иначе
		Результат = Цел((РеквизитыШтрихкода.питСрокРеализации - РеквизитыШтрихкода.питДатаПодключения) / 86400);
	КонецЕсли;
	
	
	Возврат Результат;
КонецФункции

Процедура ДозаполнитьТЧОплата(Объект, ДопПараметры)
	Если ДопПараметры.Свойство("СуммаИнкассации") Тогда 
		НоваяСтрока = Объект.Оплаты.Добавить();
		НоваяСтрока.Карточка = Справочники.питКарточки.ПустаяСсылка();
		НоваяСтрока.ВидОплаты = питОбменДаннымиПовтИсп.ПолучитьДоступныйТипОплаты(ДопПараметры.Отправитель, Перечисления.питТипыОплат.Наличные);
		НоваяСтрока.СуммаОплаты = ДопПараметры.СуммаИнкассации;
		НоваяСтрока.Сдача = 0;
		ДопПараметры.Удалить("СуммаИнкассации");
	КонецЕсли;
КонецПроцедуры

Процедура ДозаполнитьСтрокуОплатыПоВидуОплаты(НоваяСтрока, СвойстваОбъекта, ДопПараметры)
	
	Если ЗначениеЗаполнено(НоваяСтрока.ВидОплаты) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СвойстваОбъекта.Свойство("ТипОплаты") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДопПараметры.Свойство("ВидыОплатПоУмолчанию") Тогда
		ВидыОплатПоУмолчанию = Новый Структура;
		ВидыОплатПоУмолчанию.Вставить("Наличные",Константы.питТипОплатыНаличные.Получить());
		ВидыОплатПоУмолчанию.Вставить("Электронно",Константы.питТипОплатыЭлектронно.Получить());
		ВидыОплатПоУмолчанию.Вставить("Предоплата",Константы.питТипОплатыПредоплата.Получить());
		ВидыОплатПоУмолчанию.Вставить("Постоплата",Константы.питТипОплатыПостоплата.Получить());
		ВидыОплатПоУмолчанию.Вставить("ВстречноеПредставление",Константы.питТипОплатыВстречноеПредоставление.Получить());
		ДопПараметры.Вставить("ВидыОплатПоУмолчанию", ВидыОплатПоУмолчанию);
	КонецЕсли;
	
	ВидыОплатПоУмолчанию = ДопПараметры.ВидыОплатПоУмолчанию;
	Если СвойстваОбъекта.ТипОплаты = "0" Тогда
		НоваяСтрока.ВидОплаты = ВидыОплатПоУмолчанию.Наличные;
	ИначеЕсли СвойстваОбъекта.ТипОплаты = "1" Тогда
		НоваяСтрока.ВидОплаты = ВидыОплатПоУмолчанию.Электронно;
	ИначеЕсли СвойстваОбъекта.ТипОплаты = "2" Тогда
		НоваяСтрока.ВидОплаты = ВидыОплатПоУмолчанию.Предоплата;
	ИначеЕсли СвойстваОбъекта.ТипОплаты = "3" Тогда
		НоваяСтрока.ВидОплаты = ВидыОплатПоУмолчанию.Постоплата;
	ИначеЕсли СвойстваОбъекта.ТипОплаты = "4" Тогда
		НоваяСтрока.ВидОплаты = ВидыОплатПоУмолчанию.ВстречноеПредставление;
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - Дозаполнить строку алкоголя.
//
// Параметры:
//  НоваяСтрока - Строка - Новая строка.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ДозаполнитьСтрокуАлкоголя(НоваяСтрока, АтрибутыОбъекта, ДопПараметры)
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ГосИС") Тогда
		Возврат;
	КонецЕсли;
	
	МодульпитЕГАИСОбщегоНазначения = ОбщегоНазначения.ОбщийМодуль("питЕГАИСОбщегоНазначения");
	ДатаПодключения = Дата('00010101');
	СрокРеализации = 0;
	ОбъемСлива = 0;
	
	Если АтрибутыОбъекта.Свойство("ДатаПодключения") Тогда
		ДатаПодключения = АтрибутыОбъекта.ДатаПодключения;
	КонецЕсли;
	Если АтрибутыОбъекта.Свойство("СрокРеализации") Тогда
		СрокРеализации = АтрибутыОбъекта.СрокРеализации;
	КонецЕсли;
	Если АтрибутыОбъекта.Свойство("ОбъемСлива") Тогда
		ОбъемСлива = АтрибутыОбъекта.ОбъемСлива;
	КонецЕсли;
	
	Номенклатура = Неопределено;
	АлкогольнаяПродукция = Неопределено;
	Штрихкод = Неопределено;
	КодАкциза = НоваяСтрока.КодАкциза;
	Если СтрДлина(КодАкциза) = 68 Тогда
		РассчитанныйАлккокод = МодульпитЕГАИСОбщегоНазначения.ВыделитьАлкокодИзПДФ417(КодАкциза);
		Если НЕ РассчитанныйАлккокод = Неопределено Тогда
			АлкогольнаяПродукция = МодульпитЕГАИСОбщегоНазначения.ПолучитьАлкономенклатуруПоАлкокоду(РассчитанныйАлккокод);
			Если НЕ АлкогольнаяПродукция = Неопределено Тогда
				РассчитНом = МодульпитЕГАИСОбщегоНазначения.ПолучитьНоменклатуруПоАлкопродукцииИзСоответствия(АлкогольнаяПродукция);
				Если НЕ РассчитНом.Пустая() Тогда 
					Номенклатура = РассчитНом;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли СтрДлина(КодАкциза) = 150 Тогда
		
		СоответствиеШКпоПОДФ = МодульпитЕГАИСОбщегоНазначения.ПолучитьСоответствиеАлкоНоменклатурыПоPDF417(КодАкциза);
		Для каждого ЭлСоотв Из СоответствиеШКпоПОДФ Цикл
			// 1 раз
			ДанныеШтрихкода = ЭлСоотв.Значение;
			
			АлкогольнаяПродукция = ДанныеШтрихкода.АлкогольнаяПродукция;
			Штрихкод = ДанныеШтрихкода.ШтрихкодУпаковки;
			Номенклатура = ДанныеШтрихкода.Номенклатура;
			Прервать;
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ Номенклатура = Неопределено Тогда
		НоваяСтрока.Номенклатура = Номенклатура;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСтрока.Номенклатура, "ЕдиницаИзмерения");
	Иначе
		РеквизитыНоменклатуры = Новый Структура("ЕдиницаИзмерения");
	КонецЕсли;
	
	// Для ТЧ товары всегда стоит е.и. из номенклатуры, наверное в алкопродукции тогда тоже так пусть будет.
	НоваяСтрока.ЕдиницаИзмерения = РеквизитыНоменклатуры.ЕдиницаИзмерения;
	
	Если НЕ АлкогольнаяПродукция = Неопределено Тогда
		НоваяСтрока.АлкогольнаяПродукция = АлкогольнаяПродукция;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НоваяСтрока.ШтрихкодУпаковки)
		И ЗначениеЗаполнено(Штрихкод) Тогда
		НоваяСтрока.ШтрихкодУпаковки = Штрихкод;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НоваяСтрока.КоличествоВМЛ) Тогда
		НоваяСтрока.КоличествоВМЛ = питОбщегоНазначения.ПеревестиОбъемВМиллилитры(НоваяСтрока.Номенклатура,,НоваяСтрока.Количество);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
		ВидПродукции = питИнтеграцияИСМП.ВидПродукцииПоНоменклатуре(НоваяСтрока.Номенклатура);
		Если НЕ питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииПива(ВидПродукции) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НоваяСтрока.Номенклатура)
		ИЛИ НЕ ЗначениеЗаполнено(НоваяСтрока.КоличествоВМЛ) Тогда
		ОбновитьРеквизитыШтрихкодаМарки(НоваяСтрока.ШтрихкодУпаковки, АтрибутыОбъекта);
		Возврат;
	КонецЕсли;
	
	СписокШтрихкодов = Новый Массив;
	СписокШтрихкодов.Добавить(НоваяСтрока.КодАкциза);
	
	ШтрихкодыУпаковок = МодульпитЕГАИСОбщегоНазначения.питНайтиШтрихкодыУпаковокПоСпискуШтрихкодов(
		СписокШтрихкодов,
		Неопределено,
		Перечисления.ТипыУпаковок.МаркированныйТовар);
		
	ДанныеШтрихкода = ШтрихкодыУпаковок[НоваяСтрока.КодАкциза];
	Если НЕ ДанныеШтрихкода = Неопределено Тогда
		Если ЗначениеЗаполнено(ДанныеШтрихкода) Тогда
			НоваяСтрока.АлкогольнаяПродукция = ДанныеШтрихкода[0].АлкогольнаяПродукция;
			НоваяСтрока.ШтрихкодУпаковки = ДанныеШтрихкода[0].Ссылка;
		КонецЕсли;
		ОбновитьРеквизитыШтрихкодаМарки(НоваяСтрока.ШтрихкодУпаковки, АтрибутыОбъекта);
		Возврат;
	КонецЕсли;
	
	Если НЕ ДопПараметры.Свойство("ЕдиницаИзмеренияМЛ") Тогда
		ДопПараметры.Вставить("ЕдиницаИзмеренияМЛ", питОбщегоНазначения.ПолучитьБазовуюЕдиницуИзмеренияПоКоду("111")); // мл.
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СрокРеализации) Тогда
		СрокРеализацииДатой = ?(НЕ ЗначениеЗаполнено(ДатаПодключения), ДатаПодключения, КонецДня(ДатаПодключения));;
	Иначе
		СрокРеализацииДатой = ДатаПодключения + СрокРеализации * 86400;
	КонецЕсли;
	
	ДанныеНовойУпаковки = Справочники.ШтрихкодыУпаковокТоваров.СтруктураСозданияШтрихкодаУпаковки();
	ЗаполнитьЗначенияСвойств(ДанныеНовойУпаковки, НоваяСтрока);
	ДанныеНовойУпаковки.ТипУпаковки = Перечисления.ТипыУпаковок.МаркированныйТовар;
	ДанныеНовойУпаковки.ТипШтрихкода = Перечисления.ТипыШтрихкодов.Code128;
	ДанныеНовойУпаковки.Штрихкод = НоваяСтрока.КодАкциза;
	ДанныеНовойУпаковки.КоличествоПотребительскихУпаковок = 1;
	ДанныеНовойУпаковки.Количество = НоваяСтрока.КоличествоВМЛ;
	ДанныеНовойУпаковки.Упаковка = ДопПараметры.ЕдиницаИзмеренияМЛ;
	ДанныеНовойУпаковки.Вставить("питСрокРеализации", СрокРеализацииДатой);
	ДанныеНовойУпаковки.Вставить("питДатаПодключения", ДатаПодключения);
	ДанныеНовойУпаковки.Вставить("питОбъемСлива", ОбъемСлива);
	НоваяСтрока.ШтрихкодУпаковки = Справочники.ШтрихкодыУпаковокТоваров.СоздатьШтрихкодУпаковки(ДанныеНовойУпаковки);
	
КонецПроцедуры

Процедура ОбновитьРеквизитыШтрихкодаМарки(Штрихкод, ВходныеПараметры)
	
	ДатаПодключения = Дата('00010101');
	СрокРеализации = 0;
	ОбъемСлива = 0;
	Если ВходныеПараметры.Свойство("ДатаПодключения")
		И ЗначениеЗаполнено(ВходныеПараметры.ДатаПодключения) Тогда
		ДатаПодключения = ВходныеПараметры.ДатаПодключения;
	КонецЕсли;
	Если ВходныеПараметры.Свойство("СрокРеализации") Тогда
		СрокРеализации = ВходныеПараметры.СрокРеализации;
	КонецЕсли;
	Если ВходныеПараметры.Свойство("ОбъемСлива") Тогда
		ОбъемСлива = ВходныеПараметры.ОбъемСлива;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Штрихкод)
		ИЛИ НЕ (ЗначениеЗаполнено(ДатаПодключения)
		ИЛИ ЗначениеЗаполнено(СрокРеализации)
		ИЛИ ЗначениеЗаполнено(ОбъемСлива)) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыШтрихкода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Штрихкод, "питДатаПодключения, питСрокРеализации, питОбъемСлива");
	
	Если ЗначениеЗаполнено(РеквизитыШтрихкода.питДатаПодключения)
		ИЛИ ЗначениеЗаполнено(РеквизитыШтрихкода.питСрокРеализации)
		ИЛИ ЗначениеЗаполнено(РеквизитыШтрихкода.питОбъемСлива) Тогда
		Возврат;
	КонецЕсли;
	
	СпрОбъект = Штрихкод.ПолучитьОбъект();
	Если СпрОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаПодключения) Тогда
		СпрОбъект.питДатаПодключения = ДатаПодключения;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СрокРеализации) Тогда
		СрокРеализацииДатой = ?(НЕ ЗначениеЗаполнено(ДатаПодключения), ДатаПодключения, КонецДня(ДатаПодключения));
	Иначе
		СрокРеализацииДатой = ДатаПодключения+СрокРеализации*86400;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СрокРеализацииДатой) Тогда
		СпрОбъект.питСрокРеализации = СрокРеализацииДатой;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъемСлива) Тогда
		СпрОбъект.питОбъемСлива = ОбъемСлива;
	КонецЕсли;
	
	Попытка
		СпрОбъект.ОбменДанными.Загрузка = Истина;
		СпрОбъект.Записать();
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = "ОбменСКУ";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	
КонецПроцедуры

Процедура ОбработатьЧекДоЗаписи(Объект, ДопПараметры)
	
	Если Объект.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаОтмена
		И ЗначениеЗаполнено(Объект.УчетАлкоголя) Тогда
		ИсправитьКоличествоОтменПоАлкоголю(Объект, ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ИсправитьКоличествоОтменПоАлкоголю(Объект, ДопПараметры)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("НомерСтрокиОсновнойПозиции",);
	КоличествоСтрок = Объект.Товары.Количество() - 1;
	ПричинаТехСлив = Справочники.питПричиныОтменИСписаний.СанитарнаяПромывкаСистемы();
	ОтключениеПивнойКеги = Справочники.питПричиныОтменИСписаний.ОтключениеПивнойКеги();
	ПараметрыПересчетаИзМл = Неопределено;
	Для СчетСтрок = 0 По КоличествоСтрок Цикл
		ТекСтрокаТоваров = Объект.Товары[СчетСтрок];
		
		// Корректирововать количество отмен будем только для служебных причин.
		Если НЕ ТекСтрокаТоваров.ПричинаОтмены = ПричинаТехСлив
			И НЕ ТекСтрокаТоваров.ПричинаОтмены = ОтключениеПивнойКеги Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВМЛ = 0;
		СтруктураПоиска.НомерСтрокиОсновнойПозиции = СчетСтрок;
		МассивСтрокАлкоголя = Объект.УчетАлкоголя.НайтиСтроки(СтруктураПоиска);
		Если НЕ ЗначениеЗаполнено(МассивСтрокАлкоголя) Тогда
			Продолжить;
		КонецЕсли;
		ЕстьДругаяНоменклатура = Ложь;
		Для Каждого ТекСтрокаАлкоголя Из МассивСтрокАлкоголя Цикл
			Если НЕ ТекСтрокаАлкоголя.Номенклатура = ТекСтрокаТоваров.Номенклатура Тогда
				ЕстьДругаяНоменклатура = Истина;
				Продолжить;
			КонецЕсли;
			КоличествоВМЛ = КоличествоВМЛ + ТекСтрокаАлкоголя.КоличествоВМЛ;
		КонецЦикла;
		
		// При данных причинах недолжно быть других номенклатур.
		Если ЕстьДругаяНоменклатура ИЛИ НЕ ЗначениеЗаполнено(КоличествоВМЛ) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекСтрокаТоваров.Количество = питОбщегоНазначения.ПеревестиОбъемИзМиллилитров(ТекСтрокаТоваров.Номенклатура,
			ТекСтрокаТоваров.ЕдиницаИзмерения,
			КоличествоВМЛ);
		
	КонецЦикла;
	
	
КонецПроцедуры


// Добавляет созданный зал в массив залов для записи в соответствующую
// табличную часть узла обмена.
//
// Параметры:
// 	ОбъектСсылка       	- СправочникСсылка.Помещения.
// 	ДопПараметры   		- Структура. Структура дополнительных параметров обмена.
//
// Возвращаемое значение:
//	Нет.	
//
Процедура ДополнитьМассивЗаловУзлаОбмена(Объект, ДопПараметры, ЭтоНовый)
	
	Если НЕ ЭтоНовый Тогда
		// Такой объект в базе уже есть
		Возврат;
	КонецЕсли;
	
	УзелОбмена = ДопПараметры.Отправитель;
	Если УзелОбмена.Залы.Найти(Объект.Ссылка, "Зал") = Неопределено Тогда
		
		ЗалыУзлаОбмена = Неопределено;
		ДопПараметры.Свойство("ЗалыУзлаОбмена", ЗалыУзлаОбмена);
		Если ЗалыУзлаОбмена = Неопределено Тогда
			ДопПараметры.Вставить("ЗалыУзлаОбмена", Новый Массив);
		КонецЕсли;
		ДопПараметры.ЗалыУзлаОбмена.Добавить(Объект.Ссылка);
		
	КонецЕсли; 
	
КонецПроцедуры 

// Добавляет созданную вид меню в массив видов меню для записи в соответствующую
// табличную часть узла обмена.
//
// Параметры:
// 	ОбъектСсылка       	- СправочникСсылка.Номенклатура.
// 	ДопПараметры   		- Структура. Структура дополнительных параметров обмена.
//
// Возвращаемое значение:
//	Нет.	
//
Процедура ДополнитьМассивВидовМенюУзлаОбмена(Объект, ДопПараметры, ЭтоНовый)
	
	Если НЕ ЭтоНовый Тогда
		// Такой объект в базе уже есть
		Возврат;
	КонецЕсли;
	
	УзелОбмена = ДопПараметры.Отправитель;
	Если УзелОбмена.ВидыМеню.Найти(Объект.Ссылка, "ВидМеню") = Неопределено Тогда
		
		ВидыМенюУзлаОбмена = Неопределено;
		ДопПараметры.Свойство("ВидыМенюУзлаОбмена", ВидыМенюУзлаОбмена);
		Если ВидыМенюУзлаОбмена = Неопределено Тогда
			ДопПараметры.Вставить("ВидыМенюУзлаОбмена", Новый Массив);
		КонецЕсли;
		ДопПараметры.ВидыМенюУзлаОбмена.Добавить(Объект.Ссылка);
		
	КонецЕсли; 
	
КонецПроцедуры

// Проверяет необходимость загрузки документов.
// Помечает старые документы.
//
// Параметры:
// 	ДанныеОбъекта     - Структура. Объект для последующего создания документа.
//	ДопПараметры      - Структура. Структура дополнительных параметров обмена.
//
// Возвращаемое значение:
//	Нет.	
//
Функция ПроверитьНеобходимостьЗагрузкиДокумента(ДанныеОбъекта, Объект, ДопПараметры)
	
	ЗагружатьДокумент = Истина;
	Объект = Неопределено;
	
	ИДСтрокой = ДанныеОбъекта.Идентификатор;
	Объект = ПолучитьОбъектПоИД(ИДСтрокой, Документы.питДанныеПродажФронта, Ложь, Истина);
	
	// Необходимо обновить ранее загруженный документ продаж.
	Возврат ЗагружатьДокумент;
	
КонецФункции

 Функция ПолучитьКодПраваПоПраву(Право)
	Если ЗначениеЗаполнено(Право) Тогда
		ЗначениеРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Право, "Код")
	Иначе
		ЗначениеРеквизита = "0";
	КонецЕсли;
	
	КодПрава = ПолучитьКодПрава(ЗначениеРеквизита);
	
	Возврат КодПрава;
КонецФункции

// Получает цену позиции меню
//
// Параметры:
//	Меню      		- СправочникСсылка.ПрайсЛист. Позиция меню
//	ДопПараметры    - Структура. Структура дополнительных параметров обмена
//
// Возвращаемое значение:
//	Число. Цена позиции меню 	
//
Функция ПолучитьЦенуМеню(ТекМеню, ДопПараметры)
	
	ТекВидМеню = ТекМеню.Владелец;
	ТекНоменклатура = ТекМеню.Номенклатура;
	
	СтруктураОтбора = Новый Структура("ВидМеню, Номенклатура", ТекВидМеню, ТекНоменклатура);
	МассивСтрок = ДопПараметры.ТаблицаЦенМеню.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() = 0 Тогда
		ТекЦена = 0;
	Иначе
		ТекЦена = МассивСтрок[0].Цена;
	КонецЕсли;
	
	Возврат ТекЦена;
	
КонецФункции

Функция ПолучитьДанныеСотрудника(ТекСотрудник, ДопПараметры, ИмяРеквизита)
	
	СтруктураОтбора = Новый Структура("Сотрудник", ТекСотрудник);
	МассивСтрок = ДопПараметры.ТаблицаДанныхСотрудников.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() = 0 Тогда
		ТекДанные = Неопределено;
	Иначе
		ТекДанные = МассивСтрок[0][ИмяРеквизита];
	КонецЕсли;
	
	Возврат ТекДанные;
	
КонецФункции

// Получает цену позиции меню
//
// Параметры:
//	Меню      		- Структура - Структура свойств объекта обмена
//	ДопПараметры    - Структура - Структура дополнительных параметров обмена
//
// Возвращаемое значение:
//	Булево. Пропускать ли элемент 	
//
Функция ПропуститьЧтениеКонтрагентов(СвойстваОбъекта, ДопПараметры)
	Пропустить = Ложь;
	Если СвойстваОбъекта.Свойство("ЭтоГруппа") И СвойстваОбъекта.ЭтоГруппа Тогда
		Пропустить = Истина;
	КонецЕсли;
	
	Возврат Пропустить;
КонецФункции

// Функция - Получить систему налогообложения организации.
//
// Параметры:
//  ТекОрганизация - Произвольный - Тек организация.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьСистемуНалогообложенияОрганизации(ТекОрганизация)
	
	Результат = питОбменДаннымиПовтИсп.ПолучитьСистемуНалогообложенияОрганизации(ТекОрганизация);
	
	Возврат Результат;
КонецФункции


// Процедура - Дозаполнить карту.
//
// Параметры:
//  ДанныеОбъекта - Произвольный - Данные объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//  Объект - Произвольный - Объект.
//
Процедура ДозаполнитьКарту(ДанныеОбъекта, ДопПараметры, Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питУдаленныеКассыКонтрагенты.Ссылка КАК Ссылка,
	|	питУдаленныеКассыКонтрагенты.ВидОплаты КАК ВидОплаты,
	|	питУдаленныеКассыКонтрагенты.Клиент КАК Клиент,
	|	питУдаленныеКассыКонтрагенты.Контрагент КАК Контрагент,
	|	питУдаленныеКассыКонтрагенты.Соглашение КАК Соглашение,
	|	питУдаленныеКассыКонтрагенты.Договор КАК Договор
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.Контрагенты КАК питУдаленныеКассыКонтрагенты
	|ГДЕ
	|	питУдаленныеКассыКонтрагенты.Ссылка = &Ссылка
	|	И питУдаленныеКассыКонтрагенты.ВидОплаты = &ВидОплаты";
	
	Запрос.УстановитьПараметр("Ссылка", ДопПараметры.УзелОбмена);
	Запрос.УстановитьПараметр("ВидОплаты", ДанныеОбъекта.ВидОплаты);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Клиент) Тогда
			ДанныеОбъекта.Вставить("Клиент", Выборка.Клиент);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			ДанныеОбъекта.Вставить("Контрагент", Выборка.Контрагент);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Соглашение) Тогда
			ДанныеОбъекта.Вставить("Соглашение", Выборка.Соглашение);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Договор) Тогда
			ДанныеОбъекта.Вставить("Договор", Выборка.Договор);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьПризнакПредметаРасчетаСтрокойПоОбъекту(Объект)
	
	КлючПродукции = питИнтеграцияИСМП.ВидПродукцииПоНоменклатуре(Объект.Ссылка, 2);
	
	Результат = питОбменДаннымиПовтИсп.ПолучитьПризнакПредметаРасчетаСтрокой(Объект.питПризнакПредметаРасчета,,,КлючПродукции,);
		//Объект.ТипНоменклатурыПоУмолчанию,
		//Объект.ВидМаркировки,
		//Объект.ПодакцизныйТовар
		//);
	
	Возврат Результат;
КонецФункции

Функция ПолучитьВидПродукцииИС(Объект)
	
	ВидПродукцииИС = питИнтеграцияИСМП.ВидПродукцииПоНоменклатуре(Объект.Ссылка, 0);
	
	Результат = питОбменДаннымиПовтИсп.ПолучитьВидПродукцииИС(ВидПродукцииИС);
	
	Возврат Результат;
КонецФункции

// Функция - Преобразовать значение для обмена.
//
// Параметры:
//  ЗначениеРеквизита	 - Произвольный - Значение реквизита строкой или перечислением.
// 
// Возвращаемое значение:
//  Результат - Преобразованное значение.
//
Функция ПолучитьВидыУпаковокИС(ЗначениеРеквизита) Экспорт
	
	Результат = Неопределено;
	
	// Преобразование из перечисления в строку.
	Если ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.Логистическая Тогда
		
		Результат = "0";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.Групповая Тогда
		
		Результат = "1";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.Потребительская Тогда
		
		Результат = "2";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.Неопределен Тогда
		
		Результат = "3";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.АкцизнаяМаркаСНомеромИСерией Тогда
		
		Результат = "4";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.АгрегированныйТаможенныйКод Тогда
		
		Результат = "5";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.Набор Тогда
		
		Результат = "6";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.ОбъемноСортовойУчет Тогда
		
		Результат = "7";
	
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыУпаковокИС.НеЯвляетсяУпаковкой Тогда
		
		Результат = "8";
	
	ИначеЕсли ТипЗнч(ЗначениеРеквизита) = Тип("ПеречислениеСсылка.ВидыУпаковокИС") Тогда
		
		Результат = "0";

	// Обратное преобразование из строки в перечисление.
	ИначеЕсли ЗначениеРеквизита = "0" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.Логистическая;
		
	ИначеЕсли ЗначениеРеквизита = "1" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.Групповая;
		
	ИначеЕсли ЗначениеРеквизита = "2" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.Потребительская;
		
	ИначеЕсли ЗначениеРеквизита = "3" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.Неопределен;
		
	ИначеЕсли ЗначениеРеквизита = "4" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.АкцизнаяМаркаСНомеромИСерией;
		
	ИначеЕсли ЗначениеРеквизита = "5" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.АгрегированныйТаможенныйКод;
		
	ИначеЕсли ЗначениеРеквизита = "6" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.Набор;
		
	ИначеЕсли ЗначениеРеквизита = "7" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.ОбъемноСортовойУчет;
		
	ИначеЕсли ЗначениеРеквизита = "8" Тогда
		
		Результат = Перечисления.ВидыУпаковокИС.НеЯвляетсяУпаковкой;
		
	Иначе
		
		Результат = Перечисления.ВидыУпаковокИС.ПустаяСсылка();
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

#КонецОбласти
