// ЧТЕНИЕ СООБЩЕНИЯ ОБМЕНА
#Область ПроцедурыИФункцииЧтенияXML


// Процедура - При создании на сервере
//
// Параметры:
//  Форма - ЭтаФорма - Объект формы.
//  Отказ - Булево - Признак отказа.
//
Процедура ПриСозданииНаСервере(Форма, Отказ = Ложь) Экспорт
	
	// Подготовим массив новых реквизитов.
	ДобавляемыеРеквизиты = Новый Массив;
	
	// Реквизит "ЕстьПодтверждениеНаВыгрузку".
	НовыйРеквизит = Новый РеквизитФормы("ЕстьПодтверждениеНаВыгрузку", Новый ОписаниеТипов("Булево"),,"");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	
КонецПроцедуры

// Выполняет поиск права по его коду и типу.
//
// Параметры:
//	КодПраваФронта - Строка. Код права.
//
// Возвращаемое значение:
//	 СправочникСсылка.ПереченьПравФронта.
//
Функция НайтиПравоФронта(КодПраваФронта)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питПереченьПравФронта.Ссылка
	|ИЗ
	|	Справочник.питПереченьПравФронта КАК питПереченьПравФронта
	|ГДЕ
	|	питПереченьПравФронта.Код = &Код";
	Запрос.УстановитьПараметр("Код", КодПраваФронта);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

#КонецОбласти

/////////////////////////////////////////////////////////////////////////////
// РЕГИСТРАЦИЯ ОБЪЕКТОВ В ПЛАНЕ ОБМЕНА
#Область ПроцедурыИФункцииРегистрации

#Область РегистрацияНоменклатуры


// Процедура регистрирует всю номенклатуру, находящуюся в группе,
//  а также родителей этих групп вверх по иерархии.
//
// Параметры:
//  ГруппаНоменклатуры - СправочникСсылка.Номенклатура - Ссылка на группу.
//
Процедура ЗарегистрироватьВсюНоменклатуруДляГруппы(ГруппаНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Родитель = &ГруппаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питУдаленныеКассы.Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	|ГДЕ
	|	НЕ питУдаленныеКассы.ПометкаУдаления
	|	И НЕ питУдаленныеКассы.Ссылка = &ЭтотУзел";
	Запрос.УстановитьПараметр("ГруппаНоменклатуры",	ГруппаНоменклатуры);
	Запрос.УстановитьПараметр("ЭтотУзел",			ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
	Результат = Запрос.ВыполнитьПакет();
	
	// Регистрация потомков.
	ВыборкаУзлов	= Результат[1].Выбрать();
	ТЗСсылок = Неопределено;
	Если НЕ Результат[0].Пустой() Тогда
		ТЗСсылок		= Результат[0].Выгрузить();
		
		// Саму группу тоже регистрируем
		НовСсылка = ТЗСсылок.Добавить();
		НовСсылка.Ссылка = ГруппаНоменклатуры;
		
	КонецЕсли;
	
	ТЗГруппа = Новый ТаблицаЗначений;
	ТЗГруппа.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	НовГруппа = ТЗГруппа.Добавить();
	НовГруппа.Ссылка = ГруппаНоменклатуры;
	
	Пока ВыборкаУзлов.Следующий() Цикл
		
		Если НЕ ТЗСсылок = Неопределено Тогда
			ВыполнитьРегистрацию(ВыборкаУзлов.Ссылка, ТЗСсылок, "Номенклатура");
		КонецЕсли;
		
		ЗарегистрироватьРодителейНоменклатуры(ВыборкаУзлов.Ссылка, ТЗГруппа);
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура регистрирует всю номенклатуру, находящуюся в группе,
//  а также родителей этих групп вверх по иерархии.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Ссылка на группу.
//  ВключаяПотомков - Произвольный - Включая потомков.
//
Процедура ЗарегистрироватьВсюНоменклатуруДляЭлемента(Номенклатура, ВключаяПотомков = Ложь) Экспорт
	
	// Все непомеченные на удаление узлы удаленных касс.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	питУдаленныеКассы.Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	|ГДЕ
	|	НЕ питУдаленныеКассы.ПометкаУдаления
	|	И НЕ питУдаленныеКассы.Ссылка = &ЭтотУзел";
	Запрос.УстановитьПараметр("ЭтотУзел",			ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Регистрация потомков.
	ВыборкаУзлов	= Результат.Выбрать();
	
	МассивУзловДляРегистрации = Новый Массив;
	Пока ВыборкаУзлов.Следующий() Цикл
		МассивУзловДляРегистрации.Добавить(ВыборкаУзлов.Ссылка);
	КонецЦикла;
	
	питОбменДанными.ДопРегистрацияСправочника(МассивУзловДляРегистрации,Номенклатура, Истина, ВключаяПотомков);
	
КонецПроцедуры

// Функция проверяет, входит ли переданная номенклатура в группу,
//  у которой стоит флаг выгрузки во фронт.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Проверяемая номенклатур.
//
// Возвращаемое значение:
//  Булево - Результат проверки.
Функция НоменклатураВыгружаетсяВоФронт(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	// Если номенклатура лежит в корне, то будет NULL. Так что разрешение для номенклатуры в корне можно установить здесь
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(Номенклатура1.питВыгружатьВРБК, ЛОЖЬ) КАК ВыгружатьВоФронт
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура1
	|		ПО Номенклатура.Родитель = Номенклатура1.Ссылка
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура.питВыгружатьВРБК
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И Номенклатура.ЭтоГруппа = ИСТИНА";
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВыгружатьВоФронт;
	Иначе
		Возврат Ложь; // на всякий случай
	КонецЕсли;
	
КонецФункции

#КонецОбласти

// Выполняет регистрацию переданной ссылки справочника с родительскими элементами
//
// Параметры:
//  УзелИлиМассивСсл - Массив - Узел или массив ссл.
//  СправочникСсылка - Произвольный - Справочник ссылка.
//  ВключаяРодителей - Произвольный - Включая родителей.
//  ВключаяДетей - Произвольный - Включая детей.
//
Процедура ДопРегистрацияСправочника(УзелИлиМассивСсл, СправочникСсылка, ВключаяРодителей = Ложь, ВключаяДетей = Ложь) Экспорт
	Если НЕ ЗначениеЗаполнено(СправочникСсылка) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПланыОбмена.ЗарегистрироватьИзменения(УзелИлиМассивСсл, СправочникСсылка);
		Если ВключаяРодителей Тогда
			СписокРодителей = питОбменДанными.ПолучитьВсехВышестоящихРодителейСправочника(СправочникСсылка,СправочникСсылка.Метаданные().Имя, Ложь);
			Для Каждого ТекЭлемент Из СписокРодителей Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(УзелИлиМассивСсл, ТекЭлемент.Ссылка);
			КонецЦикла;
		КонецЕсли;
		
		Если ВключаяДетей Тогда
			// Добавим в результат дочерние 
			ТЗ = "ВЫБРАТЬ 
			|	Справочник.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник." + СправочникСсылка.Метаданные().Имя + " КАК Справочник
			|ГДЕ Справочник.Ссылка В ИЕРАРХИИ (&МассивЭлементов)";
			
			Запрос = Новый Запрос(ТЗ);
			Запрос.УстановитьПараметр("МассивЭлементов", СправочникСсылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(УзелИлиМассивСсл, Выборка.Ссылка);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		ЗаписьЖурналаРегистрации("Регистрация", УровеньЖурналаРегистрации.Ошибка, , СправочникСсылка, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Функция получения списка всех вышестоящих родителей.
//
// Параметры:
//  ЭлементСправочникаСсылка - СправочникСсылка - Ссылка на элемент справочника.
//  ИмяМетаданных - Строка - Имя справочника строкой.
//  ВключатьСамЭлемент - Произвольный - Включать сам элемент.
//
// Возвращаемое значение:
//  Массив - СписокРодителей.
Функция ПолучитьВсехВышестоящихРодителейСправочника(ЭлементСправочникаСсылка, ИмяМетаданных, ВключатьСамЭлемент = Истина) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ИмяМетаданных.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИмяМетаданных КАК ИмяМетаданных
	|ГДЕ
	|	ИмяМетаданных.Ссылка = &ЭлементСправочникаСсылка
	|	И НЕ (ИмяМетаданных.Родитель = ЗНАЧЕНИЕ(Справочник.ИмяМетаданных.ПустаяСсылка))
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ИмяМетаданных", ИмяМетаданных);
	Запрос.УстановитьПараметр("ЭлементСправочникаСсылка", ЭлементСправочникаСсылка);
	МассивРодителей = Новый Массив;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Ссылка = ЭлементСправочникаСсылка И НЕ ВключатьСамЭлемент Тогда
				Продолжить;
			КонецЕсли;
			
			МассивРодителей.Добавить(Выборка.Ссылка);
			
		КонецЦикла;
	Иначе
		Если ВключатьСамЭлемент Тогда
			МассивРодителей.Добавить(ЭлементСправочникаСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МассивРодителей;
	
КонецФункции

// Выполняет регистрацию всех привязок модификаторов номенклатуры по плану обмена УдаленныеКассы
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//
Процедура ЗарегистрироватьВсеМодификаторыНоменклатурыДляУзла(УзелОбмена) Экспорт
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питМодификаторы);
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питГруппыМодификаторов);
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.РегистрыСведений.питМодификаторыНоменклатуры);
	
Конецпроцедуры
// Выполняет регистрацию справочных данных
//  по плану обмена УдаленныеКассы для выгрузки Начального ОБраза
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//
Процедура ЗарегистрироватьИзмененияДляВыгрузкиНО(УзелОбмена) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УдаленныеКассы.ИндивидуальныйСписокПользователей КАК ИндивидуальныйСписокПользователей,
	|	УдаленныеКассы.ИндивидуальныйСписокНоменклатуры КАК ИндивидуальныйСписокНоменклатуры,
	|	УдаленныеКассы.ПравилаПередачиМаршрутизации КАК ПравилаПередачиМаршрутизации
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК УдаленныеКассы
	|ГДЕ
	|	УдаленныеКассы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ питУдаленныеКассыВидыМеню.ВидМеню) КАК КоличествоМеню
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.ВидыМеню КАК питУдаленныеКассыВидыМеню
	|ГДЕ
	|	питУдаленныеКассыВидыМеню.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", УзелОбмена);
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	РезультатЗапроса = РезультатЗапросаПакет[0];
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	ПараметрыУзла = Новый Структура;
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыУзла.Вставить("ИндивидуальныйСписокПользователей", Выборка.ИндивидуальныйСписокПользователей);
		ПараметрыУзла.Вставить("ИндивидуальныйСписокНоменклатуры", Выборка.ИндивидуальныйСписокНоменклатуры);
		ПараметрыУзла.Вставить("ПравилаПередачиМаршрутизации", Выборка.ПравилаПередачиМаршрутизации);
	КонецЕсли;
	РезультатЗапросаМеню = РезультатЗапросаПакет[1];
	ВыборкаМеню = РезультатЗапросаМеню.Выбрать();
	Если ВыборкаМеню.Следующий() Тогда
		ПараметрыУзла.Вставить("ИндивидуальныйСписокВидыМеню", НЕ ВыборкаМеню.КоличествоМеню = 0);
	Иначе
		ПараметрыУзла.Вставить("ИндивидуальныйСписокВидыМеню", Ложь);
	КонецЕсли;
	
	Если УзелОбмена.ПравилаПередачиМаршрутизации > 0 Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.РегистрыСведений.питМаршрутизацияПечати);
	КонецЕсли;
	
	УзелОбъект = УзелОбмена.ПолучитьОбъект();
	
	Если УзелОбъект.ИндивидуальныйСписокВидовМенюИНоменклатуры И (УзелОбъект.ВидыМеню.Количество() > 0) Тогда
		Для Каждого СтрИзТЧ ИЗ УзелОбъект.ВидыМеню Цикл
			питОбменДанными.ДопРегистрацияСправочника(УзелОбмена, СтрИзТЧ.ВидМеню, Истина);
		КонецЦикла;
	Иначе
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питВидыМеню);
	КонецЕсли;
	
	Если УзелОбъект.Залы.Количество() > 0 Тогда
		Для Каждого СтрИзТЧ ИЗ УзелОбъект.Залы Цикл
			питОбменДанными.ДопРегистрацияСправочника(УзелОбмена, СтрИзТЧ.Зал, Ложь);
		КонецЦикла;
	Иначе
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питЗалы);
	КонецЕсли;
	
	Если УзелОбъект.МестаПечати.Количество() > 0 Тогда
		Для Каждого СтрИзТЧ ИЗ УзелОбъект.МестаПечати Цикл
			питОбменДанными.ДопРегистрацияСправочника(УзелОбмена, СтрИзТЧ.МестоПечати, Ложь);
		КонецЦикла;
	Иначе
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питМестаПечати);
	КонецЕсли;
	
	Если УзелОбмена.ВыгружатьМодификаторыНоменклатуры Тогда
		ЗарегистрироватьВсеМодификаторыНоменклатурыДляУзла(УзелОбмена);
	КонецЕсли;
	
	ЗарегистрироватьВсюНоменклатуруДляУзла(УзелОбмена, ПараметрыУзла);
	ЗарегистрироватьКлассификаторЕдиницИзмерения(УзелОбмена);
	ЗарегистрироватьПодразделенияПоУзлуОбмена(УзелОбмена);
	ЗарегистрироватьОрганизацииПоУзлуОбмена(УзелОбмена);
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.ДоговорыКонтрагентов);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Контрагенты);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.ВидыНоменклатуры);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питНастройкиДоставкиСообщений);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Сотрудники);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питПричиныОтменИСписаний);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Склады);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питГости);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питТоварныеГруппы);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питКарточки);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Пользователи);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питРолиПользователейФронта);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питПереченьПравФронта);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.КлассификаторОрганизацийЕГАИС);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питВидыОплатОрганизаций);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.ВидыЦен);
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.питМаркированныеАналоги);
	// ЕГАИС.
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Найти("ВидыАлкогольнойПродукции"));
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.Справочники.Найти("КлассификаторАлкогольнойПродукцииЕГАИС"));
	
	// Настройки учета маркируемой продукции.
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Метаданные.РегистрыСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС);
	
	Запр = Новый Запрос("ВЫБРАТЬ
	|	КассыККМ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	(КассыККМ.питКассовыйУзел = &ВыбУзел) ИЛИ (КассыККМ.питКассовыйУзел = &ПустУзел)");
	Запр.УстановитьПараметр("ВыбУзел", УзелОбмена);
	Запр.УстановитьПараметр("ПустУзел", ПланыОбмена.питУдаленныеКассы.ПустаяСсылка());
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры // ЗарегистрироватьИзмененияДляВыгрузкиНО

#КонецОбласти

#Область РегламентныеЗадания
// Функция - Разделение включено.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция РазделениеВключено() Экспорт
	
	Результат = ОбщегоНазначения.РазделениеВключено() И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных();
	Возврат Результат;
	
КонецФункции

// Процедура - Выполнить обмен с удаленными кассами.
//
// Параметры:
//  ТаблицаУзлыОбмена - ТаблицаЗначений - Таблица узлы обмена.
//  ВестиЖурналРегистрации - Произвольный - Вести журнал регистрации.
//  ФиксироватьПриемОтправкуОбъектов - Произвольный - Фиксировать прием отправку объектов.
//  ВыполнятьОбменНаКлиенте - Произвольный - Выполнять обмен на клиенте.
//  Рез - Произвольный - Рез.
//  ПрерватьЗадание - Произвольный - Прервать задание.
//
Процедура ВыполнитьОбменСУдаленнымиКассами(ТаблицаУзлыОбмена,
	ВестиЖурналРегистрации = Истина,
	ФиксироватьПриемОтправкуОбъектов = Ложь, 
	ВыполнятьОбменНаКлиенте = Ложь,
	Рез = Ложь, 
	ПрерватьЗадание = Ложь) Экспорт
	
	ОбработкаОбмен = Обработки.питОбменСУдаленнымиКассами.Создать();
	
	ОбработкаОбмен.ФиксироватьПоОбъекту   = ФиксироватьПриемОтправкуОбъектов;
	ОбработкаОбмен.ВестиЖурналРегистрации  = ВестиЖурналРегистрации;
	ОбработкаОбмен.Комментировать          = Истина; 
	
	// Собственно обмен
	ИтогоПриемВыполнен = Истина;
	ИтогоОтправкаВыполнена = Истина;
	Для Каждого ТекСтрока Из ТаблицаУзлыОбмена Цикл
		
		// Проверки
		Если ТекСтрока.УзелОбмена.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		Если (НЕ ЗначениеЗаполнено(ТекСтрока.НастройкаДоставки)) И (НЕ ЗначениеЗаполнено(ТекСтрока.УзелОбмена.НастройкаДоставкиПоУмолчанию)) Тогда
			Продолжить;
		КонецЕсли;
		
		Режим = ТекСтрока.Режим;
		
		// 0 - только загружать
		// 1 - только выгружать
		// 2 - и загружать и выгружать
		// 3 - выгружать только при удачном приеме
		// 4 - выгрузить подтверждение при удачном приеме
		
		ЗагружатьСообщениеОбмена = (Режим = 0 ИЛИ Режим = 2 ИЛИ Режим = 3 ИЛИ Режим = 4);
		ВыгружатьСообщениеОбмена = (Режим = 1 ИЛИ Режим = 2 ИЛИ Режим = 3 ИЛИ Режим = 4);
		ВыгружатьСообщениеТолькоПриУдачнойЗагрузке = (Режим = 3 ИЛИ Режим = 4);
		ВыгружатьТолькоПодтверждениеПриема = (Режим = 4);
		
		ПриемВыполнен     = Истина;
		ОтправкаВыполнена = Истина;
		
		ОбработкаОбмен.УзелОбмена      = ТекСтрока.УзелОбмена;
		ОбработкаОбмен.НастройкаОбмена = ?(ЗначениеЗаполнено(ТекСтрока.НастройкаДоставки), ТекСтрока.НастройкаДоставки, ТекСтрока.УзелОбмена.НастройкаДоставкиПоУмолчанию);
		// ОбработкаОбмен.ВыгружатьТолькоПодтверждениеПриема = ВыгружатьТолькоПодтверждениеПриема;
		
		ТекИмяФайлаСообщения = "";
		ПриемВыполнен = Ложь;
		Если ЗагружатьСообщениеОбмена Тогда
			ПриемВыполнен = ОбработкаОбмен.ВыполнитьЗагрузку();
		КонецЕсли;
		
		Если ВыгружатьСообщениеТолькоПриУдачнойЗагрузке Тогда
			ВыгружатьТекущее = ВыгружатьСообщениеОбмена И ПриемВыполнен;
		Иначе
			ВыгружатьТекущее = ВыгружатьСообщениеОбмена;
		КонецЕсли;
		
		Если ВыгружатьТекущее Тогда
			РезультатОтправки = ОбработкаОбмен.ВыполнитьВыгрузку();
			ОтправкаВыполнена = РезультатОтправки.Результат;
		КонецЕсли;
		
		Если (НЕ ПриемВыполнен) И ЗагружатьСообщениеОбмена Тогда
			ИтогоПриемВыполнен = Ложь;
		КонецЕсли; 
		
		Если (НЕ ОтправкаВыполнена) И ВыгружатьТекущее Тогда
			ИтогоОтправкаВыполнена = Ложь;
		КонецЕсли; 
		
	КонецЦикла;
	
	Рез = ИтогоПриемВыполнен И ИтогоОтправкаВыполнена;
	
КонецПроцедуры // ВыполнитьОбменСУдаленнымиКассами()

#КонецОбласти

#Область ПодготовкаДанныхДляВыгрузки

// Процедура - Подготовить данные номенклатуры.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ПодготовитьДанныеНоменклатуры(Объект, ДопПараметры) Экспорт
	
	// Подготовим требуемые данные.
	ТекОбъект = Новый Структура;
	
	ТекОбъект.Вставить("АлкогольнаяПродукцияЕГАИС");
	ТекОбъект.Вставить("НаименованиеЕГАИС");
	ТекОбъект.Вставить("КодВидаАлкогольнойПродукцииЕГАИС");
	ТекОбъект.Вставить("НаименованиеПолноеЕГАИС");
	ТекОбъект.Вставить("ВидПродукцииЕГАИС");
	ТекОбъект.Вставить("ОбъемЕГАИС");
	ТекОбъект.Вставить("КрепостьЕГАИС");
	ТекОбъект.Вставить("ПроизводительЕГАИС");
	ТекОбъект.Вставить("ИмпортерЕГАИС");
	ТекОбъект.Вставить("КодАлкогольнойПродукцииЕГАИС");
	ТекОбъект.Вставить("ВидЛицензииЕГАИС");
	ТекОбъект.Вставить("ПродаетсяВРозлив", Ложь);
	ТекОбъект.Вставить("ПодакцизныйТовар", Ложь);
	ТекОбъект.Вставить("ПолучитьПризнакПредметаРасчетаСтрокой");
	ТекОбъект.Вставить("ВидПродукцииИС", Справочники.ВидыПродукцииИС.ПустаяСсылка());
	ТекОбъект.Вставить("ВидПродукцииИССтрокой");
	ТекОбъект.Вставить("ВидМаркировки");
	
	ДанныеНоменклатуры = ДопПараметры.СоответствиеНоменклатуры[Объект.Ссылка];
	Если НЕ ДанныеНоменклатуры = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекОбъект, ДанныеНоменклатуры);
	КонецЕсли;
	
	ТекОбъект.ПолучитьПризнакПредметаРасчетаСтрокой = питОбменДаннымиПовтИсп.ПолучитьПризнакПредметаРасчетаСтрокой(
		Объект.питПризнакПредметаРасчета, Объект.ТипНоменклатуры,
		ТекОбъект.ВидМаркировки, ТекОбъект.ВидПродукцииИС, ТекОбъект.ПодакцизныйТовар);
	ВидПродукцииИСПереч = питИнтеграцияИСМПКлиентСервер.ВидПродукцииПеречислениемПоСсылке(ТекОбъект.ВидПродукцииИС);
	ТекОбъект.ВидПродукцииИССтрокой = питОбменДаннымиПовтИсп.ПолучитьВидПродукцииИС(ВидПродукцииИСПереч);
	
	Если НЕ ЗначениеЗаполнено(ТекОбъект.АлкогольнаяПродукцияЕГАИС)
		И ЗначениеЗаполнено(Объект.ВидАлкогольнойПродукции) Тогда
		РеквизитыАП = питОбменДаннымиПовтИсп.ПолучитьДанныеПоВидуАлкогольнойПродукции(Объект.ВидАлкогольнойПродукции);
		ТекОбъект.ВидПродукцииЕГАИС = Объект.ВидАлкогольнойПродукции;
		ТекОбъект.ВидЛицензииЕГАИС = РеквизитыАП.ВидЛицензии;
		ТекОбъект.КодВидаАлкогольнойПродукцииЕГАИС = РеквизитыАП.Код;
	КонецЕсли;
	
	Если ТекОбъект.ВидЛицензииЕГАИС = Неопределено Тогда
		ТекОбъект.ВидЛицензииЕГАИС = Перечисления.ВидыЛицензийАлкогольнойПродукции.ПустаяСсылка();
	КонецЕсли;
	ТекОбъект.ВидЛицензииЕГАИС = питОбменДаннымиПовтИсп.ПолучитьВидЛицензииАлкогольнойПродукции(ТекОбъект.ВидЛицензииЕГАИС, ТекОбъект.ВидПродукцииИС);
	
	// Добавим значения в кэш.
	КэшироватьЗначенияОбъекта(ДопПараметры, "ОбъектНоменклатура", ТекОбъект);
	
КонецПроцедуры

// Процедура - Подготовить данные номенклатуры.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ПодготовитьДанныеОрганизации(Объект, ДопПараметры) Экспорт
	
	// Подготовим требуемые данные.
	ТекОбъект = Новый Структура;
	ТекОбъект.Вставить("СистемаНалогообложенияКод", "");
	ТекОбъект.Вставить("ОрганизацияОсвобожденаОтНДС", Неопределено);
	ТекОбъект.Вставить("СтавкаНДСПоУСН", Справочники.СтавкиНДС.ПустаяСсылка());
	
	ТекОбъект.СистемаНалогообложенияКод = ПолучитьСистемуНалогообложенияОрганизации(Объект.Ссылка);
	
	ПараметрыУчетаНДСПоОрганизации = питОбменДаннымиПовтИсп.ПараметрыУчетаНДСПоОрганизации(
		Объект.Ссылка,
		ТекущаяДатаСеанса()
	);
	
	ТекОбъект.ОрганизацияОсвобожденаОтНДС = 
		ПараметрыУчетаНДСПоОрганизации.ОсновноеНалогообложениеНДСПродажи = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	ТекОбъект.СтавкаНДСПоУСН = ПараметрыУчетаНДСПоОрганизации.СтавкаНДСПриУСН;
	
	// Добавим значения в кэш.
	КэшироватьЗначенияОбъекта(ДопПараметры, "ОбъектОрганизация", ТекОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ПолучитьШтрихкодУпаковкиПоЗначению

// Функция - Получить штрихкод упаковки по значению.
//
// Параметры:
//  ИсходноеЗначениеШтрихкода - Произвольный - Исходное значение штрихкода.
//  Номенклатура - Произвольный - Номенклатура.
//  КоличествоВМЛ - Произвольный - Количество вмл.
//  ДатаПодключения - Дата - Дата подключения.
//  СрокРеализации - Произвольный - Срок реализации.
//  ОбъемСлива - Произвольный - Объем слива.
//  СоздаватьНовый - Произвольный - Создавать новый.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьШтрихкодУпаковкиПоЗначению(ИсходноеЗначениеШтрихкода, Номенклатура = Неопределено, 
		КоличествоВМЛ = 0, 
		ДатаПодключения = Неопределено,
		СрокРеализации = Неопределено,
		ОбъемСлива = 0,
		СоздаватьНовый = Истина) Экспорт
		
	Результат = Неопределено;
	
	КодМаркировкиОригинал = питОбменДаннымиКлиентСервер.ВосстановитьШтрихкодМарки(ИсходноеЗначениеШтрихкода);
	
	МодульРазборКодаМаркировкиИССлужебный = ОбщегоНазначения.ОбщийМодуль("РазборКодаМаркировкиИССлужебный");
	ДанныеРазбораКода = МодульРазборКодаМаркировкиИССлужебный.РазобратьКодМаркировки(КодМаркировкиОригинал);
	
	Если НЕ ДанныеРазбораКода = Неопределено Тогда
		КодМаркировкиНормализованный = ДанныеРазбораКода.НормализованныйКодМаркировки;
	ИначеЕсли СтрНайти(КодМаркировкиОригинал, питОбменДаннымиКлиентСервер.РазделительGS1()) > 0 Тогда
		// Иначе пользователь не сможет даже форму списка открыть.
		КодМаркировкиНормализованный = питОбменДаннымиКлиентСервер.НормализованныйШтрихкодМарки(ИсходноеЗначениеШтрихкода);
	Иначе
		КодМаркировкиНормализованный = КодМаркировкиОригинал;
	КонецЕсли;
	
	ТекШтрихкодУпаковки = Справочники.ШтрихкодыУпаковокТоваров.ПолучитьПоЗначениюШтрихкода(КодМаркировкиНормализованный);
	Если НЕ ТекШтрихкодУпаковки = Неопределено Тогда
		Возврат ТекШтрихкодУпаковки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода";
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", КодМаркировкиНормализованный);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СоздаватьНовый Тогда
		Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
	КонецЕсли;
	
	Если ДатаПодключения = Неопределено Тогда
		ДатаПодключения = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ТипЗнч(СрокРеализации) = Тип("Число") Тогда
		Если НЕ ЗначениеЗаполнено(СрокРеализации) Тогда
			СрокРеализацииДатой = КонецДня(ДатаПодключения);
		Иначе
			// Реквизит хранит значение в днях.
			СрокРеализацииДатой = ДатаПодключения + СрокРеализации*86400;
		КонецЕсли;
	Иначе
		СрокРеализацииДатой = СрокРеализации;
	КонецЕсли;
	
	ДанныеНовойУпаковки = Справочники.ШтрихкодыУпаковокТоваров.СтруктураСозданияШтрихкодаУпаковки();
	ДанныеНовойУпаковки.Номенклатура = Номенклатура;
	ДанныеНовойУпаковки.ТипУпаковки = Перечисления.ТипыУпаковок.МаркированныйТовар;
	ДанныеНовойУпаковки.Штрихкод = КодМаркировкиНормализованный;
	ДанныеНовойУпаковки.КоличествоПотребительскихУпаковок = 1;
	ДанныеНовойУпаковки.Количество = КоличествоВМЛ;
	ДанныеНовойУпаковки.Упаковка = питОбщегоНазначения.ПолучитьБазовуюЕдиницуИзмеренияПоКоду("111");
	ДанныеНовойУпаковки.Вставить("питСрокРеализации", СрокРеализацииДатой);
	ДанныеНовойУпаковки.Вставить("питДатаПодключения", ДатаПодключения);
	ДанныеНовойУпаковки.Вставить("питОбъемСлива", ОбъемСлива);
	
	Результат = Справочники.ШтрихкодыУпаковокТоваров.СоздатьШтрихкодУпаковки(ДанныеНовойУпаковки);
	
	Если КодМаркировкиНормализованный = КодМаркировкиОригинал
		ИЛИ ДанныеРазбораКода = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПулКодовМаркировкиСУЗ.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	|ГДЕ
	|	ПулКодовМаркировкиСУЗ.КодМаркировки = &КодМаркировки";
	Запрос.УстановитьПараметр("КодМаркировки", КодМаркировкиОригинал);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыСканирования = Новый Структура("Организация");
	МодульШтрихкодированиеОбщегоНазначенияИС = ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИС");
	ДанныеШтрихкода = МодульШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьДанныеШтрихкода();
	
	Если НЕ ДанныеШтрихкода.Свойство("Штрихкод") Тогда
		ДанныеШтрихкода.Вставить("Штрихкод")
	КонецЕсли;
	Если НЕ ДанныеШтрихкода.Свойство("ШтрихкодBase64") Тогда
		ДанныеШтрихкода.Вставить("ШтрихкодBase64")
	КонецЕсли;
	Если НЕ ДанныеШтрихкода.Свойство("ЕстьВПулеКодовМаркировки") Тогда
		ДанныеШтрихкода.Вставить("ЕстьВПулеКодовМаркировки", Ложь)
	КонецЕсли;
	Если НЕ ДанныеШтрихкода.Свойство("ПолныйКодМаркировки") Тогда
		ДанныеШтрихкода.Вставить("ПолныйКодМаркировки", "")
	КонецЕсли;
	ДанныеШтрихкода.Номенклатура = Номенклатура;
	ДанныеШтрихкода.ШтрихкодУпаковки = Результат;
	ДанныеШтрихкода.Штрихкод = КодМаркировкиНормализованный;
	МодульШтрихкодированиеОбщегоНазначенияИСКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИСКлиентСервер");
	ДанныеШтрихкода.ШтрихкодBase64 = МодульШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ШтрихкодВBase64(КодМаркировкиОригинал);
	ЗаполнитьЗначенияСвойств(ДанныеШтрихкода, ДанныеРазбораКода);
	ЗаполнитьЗначенияСвойств(ДанныеШтрихкода, ДанныеРазбораКода.СоставКодаМаркировки);
	Попытка
		РегистрыСведений.ПулКодовМаркировкиСУЗ.ЗаписатьДанныеКодаМаркировки(ДанныеШтрихкода, ПараметрыСканирования)
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Преобразует цвет из десятиричного формата в тип "Цвет".
//
// Параметры:
//  ВходнойЦвет - Произвольный - Входной цвет.
//
// Возвращаемое значение:
// 	Произвольный - Результат обработуки.
Функция ПолучитьЦветПоФорматуФронтОфиса(ВходнойЦвет) Экспорт
	
	ВходнойЦвет = СтрЗаменить(ВходнойЦвет, " ", "");
	Если ПустаяСтрока(ВходнойЦвет) ИЛИ ВходнойЦвет = "-1" Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	// Преобразование из шестнадцатиричного формата в десятичный, если необходимо.
	Если Сред(ВходнойЦвет, 1, 1) = "$" Тогда
		ВходноеЧисло = Сред(ВходнойЦвет, 2); 
		ВходнойЦвет = ПреобразоватьШестнадцатиричноеЧислоВДесятичное(ВходноеЧисло);
	КонецЕсли;
	
	// Получение цвета из десятичного представления.
	ВыходнойЦвет = ПреобразоватьДесятичноеЧислоВЦвет(ВходнойЦвет);
	
	Возврат ВыходнойЦвет;
	
КонецФункции

// Получает идентификатор объекта для записи в XML
//
// Параметры:
//  Объект - Произвольный - Объект.
//
// Возвращаемое значение:
// 	Строка - Идентификатор объекта.
Функция ПолучитьИДПоОбъекту(Объект) Экспорт
	
	Результат = "";
	
	Попытка
		
		Если НЕ (Объект = Неопределено) И ЗначениеЗаполнено(Объект.Ссылка) Тогда 
			Результат = питОбменДаннымиПовтИсп.ПолучитьИДПоСсылке(Объект.Ссылка);
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка получения XML-представления ссылки объекта <" + Объект + "> - " + ТекстОшибки;
		ЗаписьЖурналаРегистрации("Обмен", УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;

КонецФункции



// Дозаполняет шапку документа "Данные продаж фронта"
//
// Параметры:
//  ДанныеОбъекта - Произвольный - Данные объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//  Объект - Произвольный - Данные объекта.
//
Процедура ДозаполнитьШапкуЧека(ДанныеОбъекта, ДопПараметры, Объект = Неопределено) Экспорт
	
	// Если сообщение об ошибке есть, то добавляем его в комментарий.
	Если ДанныеОбъекта.Свойство("СообщениеОбОшибке") И ЗначениеЗаполнено(ДанныеОбъекта.СообщениеОбОшибке) Тогда
		ДанныеОбъекта.Комментарий = СокрЛП(ДанныеОбъекта.Комментарий + " " +ДанныеОбъекта.СообщениеОбОшибке);
	КонецЕсли;
	
	Если ДанныеОбъекта.Свойство("НомерСмены") И НЕ ЗначениеЗаполнено(ДанныеОбъекта.НомерСмены) Тогда
		ДанныеОбъекта.НомерСмены = -1;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.КассаККМ) И ДопПараметры.Свойство("Отправитель") Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("КассовыйУзел", ДопПараметры.Отправитель);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КассыККМ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КассыККМ КАК КассыККМ
		|ГДЕ
		|	КассыККМ.питКассовыйУзел = &КассовыйУзел";
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ДанныеОбъекта.КассаККМ = Выборка.Ссылка;
		КонецЕсли; 
	КонецЕсли;
	
	Если НЕ ДанныеОбъекта.Свойство("Подразделение") ИЛИ НЕ ЗначениеЗаполнено(ДанныеОбъекта.Подразделение) Тогда
		Если ЗначениеЗаполнено(ДанныеОбъекта.КассаККМ) И НЕ ПустаяСтрока(ДанныеОбъекта.КассаККМ.ВерсияДанных) Тогда
			ДанныеОбъекта.Вставить("Подразделение", ДанныеОбъекта.КассаККМ.Подразделение);
		ИначеЕсли ДопПараметры.Свойство("Подразделение") Тогда
			ДанныеОбъекта.Вставить("Подразделение", ДопПараметры.Подразделение);
		КонецЕсли;
	КонецЕсли;
	
	// Организация
	Если НЕ ДанныеОбъекта.Свойство("Организация") ИЛИ НЕ ЗначениеЗаполнено(ДанныеОбъекта.Организация) Тогда
		Если ЗначениеЗаполнено(ДанныеОбъекта.КассаККМ) И НЕ ПустаяСтрока(ДанныеОбъекта.КассаККМ.ВерсияДанных) Тогда
			ДанныеОбъекта.Организация = ДанныеОбъекта.КассаККМ.Владелец;
		ИначеЕсли ДопПараметры.Свойство("Организация") Тогда
			ДанныеОбъекта.Организация = ДопПараметры.Организация;
		КонецЕсли;
	КонецЕсли;
	
	// Если хоз операция Внесение или Изъятие, то добавляем наличные.
	Если ДанныеОбъекта.Свойство("СуммаИнкассации") И (ДанныеОбъекта.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаВнесение ИЛИ 
		ДанныеОбъекта.ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаИзъятие) Тогда
		ДопПараметры.Вставить("СуммаИнкассации", ДанныеОбъекта.СуммаИнкассации);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Дозаполнить шапку смена заведения.
//
// Параметры:
//  ДанныеОбъекта - Произвольный - Данные объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//  Объект - Произвольный - Данные объекта.
//
Процедура ДозаполнитьШапкуКорректировкиОстатковИС(ДанныеОбъекта, ДопПараметры, Объект = Неопределено) Экспорт
	
	ДанныеОбъекта.Вставить("ХозяйственнаяОперация", Перечисления.питХозяйственныеОперации.КорректировкаОстатковИСКорректировкаОстатков);
	
	Если ДопПараметры.СпособНумерацииДокументов = 0
		И ДанныеОбъекта.Свойство("НомерДокумента")
		И ЗначениеЗаполнено(ДанныеОбъекта.НомерДокумента) Тогда
		ДанныеОбъекта.Вставить("Номер", ПодготовитьНомерДокумента(ДопПараметры.Префикс, ДанныеОбъекта.НомерДокумента));
	КонецЕсли;
	
КонецПроцедуры

// Функция - Строка корректировки остатков известна ку.
//
// Параметры:
//  ТекСтрока - Строка - Тек строка.
//  Объект - Произвольный - Объект.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
Функция СтрокаКорректировкиОстатковИзвестнаКУ(ТекСтрока, Объект, ДопПараметры) Экспорт
	Результат = Ложь;
	
	Если ТипЗнч(ТекСтрока.МестоПечати) = Тип("СправочникСсылка.питМестаПечати")
		И НоменклатураИзвестнаУзлу(ТекСтрока.Номенклатура, ДопПараметры.Получатель,, ДопПараметры)
		И МестоПечатиИзвестноУзлу(ТекСтрока.МестоПечати, ДопПараметры.Получатель, ДопПараметры.ИндивидуальныйСписокМестаПечати) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Добавляет созданное место печати в массив мест печати для записи в соответствующую
//  табличную часть узла обмена.
//
// Параметры:
//  МестоПечатиОбъект - Произвольный - Место печати объект.
//  ДопПараметры - Произвольный - Доп параметры.
//  ЭтоНовый - Произвольный - Это новый.
//
Процедура ДополнитьМассивМестПечатиУзлаОбмена(МестоПечатиОбъект, ДопПараметры, ЭтоНовый) Экспорт
	
	Если НЕ ЭтоНовый Тогда
		// Такой объект в базе уже есть
		Возврат;
	КонецЕсли;
	
	УзелОбмена = ДопПараметры.Отправитель;
	Если УзелОбмена.МестаПечати.Найти(МестоПечатиОбъект.Ссылка, "МестоПечати") = Неопределено Тогда
		
		МестаПечатиУзлаОбмена = Неопределено;
		ДопПараметры.Свойство("МестаПечатиУзлаОбмена", МестаПечатиУзлаОбмена);
		Если МестаПечатиУзлаОбмена = Неопределено Тогда
			ДопПараметры.Вставить("МестаПечатиУзлаОбмена", Новый Массив);
		КонецЕсли;
		ДопПараметры.МестаПечатиУзлаОбмена.Добавить(МестоПечатиОбъект.Ссылка);
		
	КонецЕсли; 
	
КонецПроцедуры

// Добавляет созданное место печати в массив мест печати для записи в соответствующую
//  табличную часть узла обмена.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  ДопПараметры - Произвольный - Доп параметры.
//  ЭтоНовый - Произвольный - Это новый.
//
Процедура ДополнитьМассивОрганизацийУзлаОбмена(Объект, ДопПараметры, ЭтоНовый) Экспорт
	
	Если НЕ ЭтоНовый Тогда
		// Такой объект в базе уже есть
		Возврат;
	КонецЕсли;
	
	УзелОбмена = ДопПараметры.Отправитель;
	Если УзелОбмена.ДополнительныеОрганизации.Найти(Объект.Ссылка, "Организация") = Неопределено Тогда
		
		ДополнительныеОрганизацииУзла = Неопределено;
		ДопПараметры.Свойство("ДополнительныеОрганизацииУзла", ДополнительныеОрганизацииУзла);
		Если ДополнительныеОрганизацииУзла = Неопределено Тогда
			ДопПараметры.Вставить("ДополнительныеОрганизацииУзла", Новый Массив);
		КонецЕсли;
		ДопПараметры.ДополнительныеОрганизацииУзла.Добавить(Объект.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

// Ищет соответствие организация - подразделение в ТЧ "Организации" кассового узла.
//  Возвращает первое найденное или НЕОПРЕДЕЛЕНО, если не найдено.
//  Подразделение - Произвольный - Подразделение.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Параметры:
//  Подразделение - Произвольный - Подразделение.
//  ДопПараметры - Произвольный - Доп параметры.
//  ИскатьУПотомков - Произвольный - Искать у потомков.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьОрганизациюПодразделения(Подразделение, ДопПараметры, ИскатьУПотомков = Истина) Экспорт
	
	Возврат Неопределено; //+chesdm_debug
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	
//   Сначала выгребаются все потомки подразделения, Ищет соответствие организация - подразделение в ТЧ "Организации"
// кассового узла.
	// При этом в качестве подразделения может быть как переданное в эту функцию, так и один из его потомков.
	Если ИскатьУПотомков Тогда
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ
		|	Подразделение.Ссылка
		|ПОМЕСТИТЬ тзПотомков
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК Подразделение
		|ГДЕ
		|	Подразделение.Ссылка В ИЕРАРХИИ(&Подразделение)";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ ПЕРВЫЕ 1
	|	питУдаленныеКассыДополнительныеОрганизации.Организация
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.ДополнительныеОрганизации КАК питУдаленныеКассыДополнительныеОрганизации
	|ГДЕ
	|	питУдаленныеКассыДополнительныеОрганизации.Ссылка = &УзелОбмена";
	
	Если ИскатьУПотомков Тогда
		ТекстЗапроса = ТекстЗапроса + "И (питУдаленныеКассыДополнительныеОрганизации.Подразделение = &Подразделение
		|			ИЛИ питУдаленныеКассыДополнительныеОрганизации.Подразделение В
		|				(ВЫБРАТЬ
		|					тзПотомков.Ссылка
		|				ИЗ
		|					тзПотомков КАК тзПотомков))";
	Иначе
		ТекстЗапроса = ТекстЗапроса + " И питУдаленныеКассыДополнительныеОрганизации.Подразделение = &Подразделение ";
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Подразделение",	Подразделение);
	Запрос.УстановитьПараметр("УзелОбмена",		ДопПараметры.УзелОбмена);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Организация;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Выполняет транслитерацию переданного текста.
//
// Параметры:
//  Значение - Произвольный - Значение.
//
// Возвращаемое значение:
//   Строка - преобразованный текст.
Функция ВыполнитьТранслит(Значение) Экспорт
	
	ТранслитерацияСоответствие = Новый Соответствие();
	ТранслитерацияСоответствие.Вставить("А", "A");
	ТранслитерацияСоответствие.Вставить("Б", "B");
	ТранслитерацияСоответствие.Вставить("В", "V");
	ТранслитерацияСоответствие.Вставить("Г", "G");
	ТранслитерацияСоответствие.Вставить("Д", "D");
	ТранслитерацияСоответствие.Вставить("Е", "YE");
	ТранслитерацияСоответствие.Вставить("Ё", "YO");
	ТранслитерацияСоответствие.Вставить("Ж", "ZH");
	ТранслитерацияСоответствие.Вставить("З", "Z");
	ТранслитерацияСоответствие.Вставить("И", "E");
	ТранслитерацияСоответствие.Вставить("Й", "Y");
	ТранслитерацияСоответствие.Вставить("К", "K");
	ТранслитерацияСоответствие.Вставить("Л", "L");
	ТранслитерацияСоответствие.Вставить("М", "M");
	ТранслитерацияСоответствие.Вставить("Н", "N");
	ТранслитерацияСоответствие.Вставить("О", "O");
	ТранслитерацияСоответствие.Вставить("П", "P");
	ТранслитерацияСоответствие.Вставить("Р", "R");
	ТранслитерацияСоответствие.Вставить("С", "S");
	ТранслитерацияСоответствие.Вставить("Т", "T");
	ТранслитерацияСоответствие.Вставить("У", "U");
	ТранслитерацияСоответствие.Вставить("Ф", "F");
	ТранслитерацияСоответствие.Вставить("Х", "H");
	ТранслитерацияСоответствие.Вставить("Ц", "C");
	ТранслитерацияСоответствие.Вставить("Ч", "CH");
	ТранслитерацияСоответствие.Вставить("Ш", "SH");
	ТранслитерацияСоответствие.Вставить("Щ", "SHH");
	ТранслитерацияСоответствие.Вставить("Ъ", "##");
	ТранслитерацияСоответствие.Вставить("Ы", "EE");
	ТранслитерацияСоответствие.Вставить("Ь", "#");
	ТранслитерацияСоответствие.Вставить("Э", "EA");
	ТранслитерацияСоответствие.Вставить("Ю", "YU");
	ТранслитерацияСоответствие.Вставить("Я", "YA");
	
	// Переведем кириллицу в транслит (не все FTP сервера поддерживают кириллицу).
	Для Каждого ТекСимвол Из ТранслитерацияСоответствие Цикл
		Значение = СтрЗаменить(Значение, ТекСимвол.Ключ, ТекСимвол.Значение);
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции

// Проверяет доставку файла по указанной настройке.
//
// Параметры:
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  стрОшибки - Произвольный - стр ошибки.
//
// Возвращаемое значение:
//   Булево - Флаг успешной доставки сообщения.
Функция ПроверитьДоставкуСообщения(НастройкаДоставки, стрОшибки = "") Экспорт
	стрОшибки = "";
	ЛокКаталог_ = НастройкаДоставки.КаталогОбменов;
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	ИмяТестовогоФайла = "test_exch_" + Формат(ТекущаяДата(), "ДФ = ддММгггг") + ".tmp";
	Если СпособОбмена = 0 Тогда 
		
		РезультатПроверки = ПроверитьДоставкуСообщенияЛокКаталог(НастройкаДоставки.Ссылка, стрОшибки);
		
		Возврат РезультатПроверки;
		
	КонецЕсли;
	
	ПолноеИмяТестовогоФайла = ?(Прав(ЛокКаталог_,1)="\" ИЛИ Прав(ЛокКаталог_,1)="/",ЛокКаталог_,ЛокКаталог_ + Слеш) + ИмяТестовогоФайла;
	
	// Проверка записи во временный каталог
	ТекстДок = Новый ТекстовыйДокумент;
	Попытка
		ТекстДок.Записать(ПолноеИмяТестовогоФайла);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при создании тестового файла <" + ПолноеИмяТестовогоФайла + "> в каталоге обмена:
		|" + ИнформацияОбОшибке().Описание;
		
		Возврат Ложь;
	КонецПопытки;
	
	Если СпособОбмена = 0 Тогда
		// ЛОКАЛЬНЫЙ КАТАЛОГ
		Если НайтиФайлы(ЛокКаталог_).Количество() = 0 Тогда
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
			|Каталог не обнаружен";
			Возврат Ложь;	
		КонецЕсли;
		
		ПолноеИмяТестовогоФайлаПриемник = ?(Прав(ЛокКаталог_,1)="/" ИЛИ Прав(ЛокКаталог_,1)="\",
		НастройкаДоставки.КаталогОбменов,ЛокКаталог_ + Слеш) + ИмяТестовогоФайла;
		Попытка
			КопироватьФайл(ПолноеИмяТестовогоФайла, ПолноеИмяТестовогоФайлаПриемник);
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
			|" + ИнформацияОбОшибке().Описание;
			Возврат Ложь;
		КонецПопытки;
		
		Попытка
			КопироватьФайл(ПолноеИмяТестовогоФайлаПриемник, ПолноеИмяТестовогоФайла);
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при получении тестового файла из каталога обмена:
			|" + ИнформацияОбОшибке().Описание;
			
			Возврат Ложь;
		КонецПопытки;
		
		Попытка
			УдалитьФайлы(ПолноеИмяТестовогоФайлаПриемник);
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при удалении тестового файла из каталога обмена:
			|" + ИнформацияОбОшибке().Описание;
			
			Возврат Ложь;
		КонецПопытки;		
	ИначеЕсли СпособОбмена = 1 Тогда // MAPI (доступно только на клиенте)
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Почта MAPI не доступна на сервере и во внешнем соединении!";
		Возврат Ложь;
		
	ИначеЕсли СпособОбмена = 2 Тогда // POP-SMTP
		
		ПочтовыйПрофиль = Новый ИнтернетПочтовыйПрофиль;
		ПочтовыйПрофиль.АдресСервераPOP3 = НастройкаДоставки.СерверPOP3;
		ПочтовыйПрофиль.ПортPOP3         = НастройкаДоставки.ПортPOP3;
		ПочтовыйПрофиль.Пользователь     = НастройкаДоставки.ПользовательPOP3;
		ПочтовыйПрофиль.Пароль           = НастройкаДоставки.ПарольPOP3;
		
		Почта = Новый ИнтернетПочта(); 
		Попытка
			Почта.Подключиться(ПочтовыйПрофиль);
			Почта.Отключиться();
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при подключении к почтовому серверу POP3:
			|" + ИнформацияОбОшибке().Описание;
			Возврат Ложь;
		КонецПопытки;
		
		ПочтовыйПрофиль = Новый ИнтернетПочтовыйПрофиль;
		ПочтовыйПрофиль.АдресСервераSMTP = НастройкаДоставки.СерверSMTP;
		ПочтовыйПрофиль.ПортSMTP         = НастройкаДоставки.ПортSMTP;
		ПочтовыйПрофиль.ПользовательSMTP = НастройкаДоставки.ПользовательSMTP;
		ПочтовыйПрофиль.ПарольSMTP       = НастройкаДоставки.ПарольSMTP;
		
		Почта = Новый ИнтернетПочта(); 
		Попытка
			Почта.Подключиться(ПочтовыйПрофиль);
			Почта.Отключиться();
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при подключении к почтовому серверу SMTP:
			|" + ИнформацияОбОшибке().Описание;
			
			Возврат Ложь;
		КонецПопытки;
		
	ИначеЕсли СпособОбмена = 3 Тогда // FTP
		
		Попытка
			FTP = Новый FTPСоединение(НастройкаДоставки.СерверFTP, НастройкаДоставки.ПортFTP, НастройкаДоставки.ПользовательFTP, НастройкаДоставки.ПарольFTP,, НастройкаДоставки.ПассивныйРежим, НастройкаДоставки.Таймаут);
		Исключение
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			Если Найти(ВРег(ТекстОшибки),ВРег("couldn't connect to server")) Тогда
				ТекстОшибки = " на указанном сервере не запущен FTP-сервер";
			ИначеЕсли Найти(ВРег(ТекстОшибки),ВРег("couldn't resolve host name")) Тогда 	
				ТекстОшибки = " указанный сервер не доступен";
			КонецЕсли;
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка подключения к FTP серверу <ftp://" + НастройкаДоставки.СерверFTP + ">: " + ТекстОшибки;
			Возврат Ложь;
		КонецПопытки;
		
		ПолноеИмяТестовогоФайлаПриемник = ?(Прав(НастройкаДоставки.КаталогОбменаFTP,1)="/",
		НастройкаДоставки.КаталогОбменаFTP,НастройкаДоставки.КаталогОбменаFTP + "/") + ИмяТестовогоФайла;
		Попытка
			FTP.Записать(ПолноеИмяТестовогоФайла, ПолноеИмяТестовогоФайлаПриемник);
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при попытке публикации на сервере FTP тестового файла:
			|" + ИнформацияОбОшибке().Описание;
			
			Возврат Ложь;
		КонецПопытки;
		
		Попытка
			FTP.Получить(ПолноеИмяТестовогоФайлаПриемник, ПолноеИмяТестовогоФайла);
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при попытке получения c сервера FTP тестового файла:
			|" + ИнформацияОбОшибке().Описание;
			
			Возврат Ложь;
		КонецПопытки;
		
		Попытка
			FTP.Удалить(НастройкаДоставки.КаталогОбменаFTP, ИмяТестовогоФайла);
		Исключение
			ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
			стрОшибки = ТекДата + стрОшибки + "Ошибка при попытке удаления c сервера FTP тестового файла:
			|" + ИнформацияОбОшибке().Описание;
			
			Возврат Ложь;
		КонецПопытки;
	ИначеЕсли СпособОбмена = 4 Тогда
		
		Попытка
			HTTPСоединение = Новый HTTPСоединение(НастройкаДоставки.АдресСервераHTTP, НастройкаДоставки.ПортHTTP,НастройкаДоставки.ПользовательHTTP, НастройкаДоставки.ПарольHTTP,,300);
		Исключение
			СтрОшибок = "Ошибка: " + ОписаниеОшибки();
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	// Удаляем локальный тестовый файл
	Попытка
		УдалитьФайлы(ПолноеИмяТестовогоФайла);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при удалении тестового файла:
		|" + ИнформацияОбОшибке().Описание;
		
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Функция проверки настройки доставки сообщения через локальный каталог.
//
// Параметры:
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  стрОшибки - Произвольный - стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПроверитьДоставкуСообщенияЛокКаталог(НастройкаДоставки, стрОшибки) Экспорт
	
	стрОшибки = "";
	ЛокКаталог_ = НастройкаДоставки.КаталогОбменов;
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	ИмяТестовогоФайла = "test_exch_" + Формат(ТекущаяДата(), "ДФ = ддММгггг") + ".tmp";
	
	Попытка
		Если НастройкаДоставки.ИспользоватьВременныйКаталог Тогда
			ТемпКаталог = ?(Прав(ЛокКаталог_,1)="/" ИЛИ Прав(ЛокКаталог_,1)="\",ЛокКаталог_,ЛокКаталог_ + Слеш) + "TEMP\";
			Если НайтиФайлы(ТемпКаталог).Количество() = 0 Тогда
				СоздатьКаталог(ТемпКаталог);
			КонецЕсли;
		Иначе
			ТемпКаталог = КаталогВременныхФайлов();
		КонецЕсли;
	Исключение
		стрОшибки = стрОшибки + "Ошибка при создании каталога:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	ПолноеИмяТестовогоФайла = ТемпКаталог + ИмяТестовогоФайла;
	
	// Можем проверить только запись в локальный каталог
	ТекстДок = Новый ТекстовыйДокумент;
	Попытка
		ТекстДок.Записать(ПолноеИмяТестовогоФайла);
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
	Исключение
		стрОшибки = стрОшибки + "Ошибка при создании тестового файла:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	// ЛОКАЛЬНЫЙ КАТАЛОГ
	Если НайтиФайлы(ЛокКаталог_).Количество() = 0 Тогда
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
		|Каталог не обнаружен";
		Возврат Ложь;	
	КонецЕсли;
	
	ПолноеИмяТестовогоФайлаПриемник = ?(Прав(ЛокКаталог_,1)="\" ИЛИ Прав(ЛокКаталог_,1)="/",
	НастройкаДоставки.КаталогОбменов,ЛокКаталог_ + Слеш) + ИмяТестовогоФайла;
	Попытка
		КопироватьФайл(ПолноеИмяТестовогоФайла, ПолноеИмяТестовогоФайлаПриемник);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		КопироватьФайл(ПолноеИмяТестовогоФайлаПриемник, ПолноеИмяТестовогоФайла);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при получении тестового файла из каталога обмена:
		|" + ИнформацияОбОшибке().Описание;
		
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		УдалитьФайлы(ПолноеИмяТестовогоФайлаПриемник);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при удалении тестового файла из каталога обмена:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Возвращает доступные на заданную дату виды меню.
//
// Параметры:
//  НаДату - Произвольный - На дату.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуДоступныхВидовМеню(НаДату = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыМеню.Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ВидыМеню.Ссылка) КАК Представление
	|ИЗ
	|	Справочник.питВидыМеню КАК ВидыМеню
	|ГДЕ
	|	(ВидыМеню.ДниНедели = ""0000000""
	|			ИЛИ ВидыМеню.ДниНедели = ""       ""
	|			ИЛИ ПОДСТРОКА(ВидыМеню.ДниНедели, ДЕНЬНЕДЕЛИ(&НаДату), 1) = ""1"")
	|	И НЕ ВидыМеню.ЭтоГруппа
	|	И НЕ ВидыМеню.ПометкаУдаления
	|	И (ВидыМеню.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				И ВидыМеню.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ВидыМеню.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				И &НаДату <= ВидыМеню.ДатаОкончанияДействия
	|			ИЛИ ВидыМеню.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				И &НаДату >= ВидыМеню.ДатаНачалаДействия
	|			ИЛИ &НаДату МЕЖДУ ВидыМеню.ДатаНачалаДействия И ВидыМеню.ДатаОкончанияДействия)
	|	И (ВидыМеню.ВремяНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				И ВидыМеню.ВремяОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ВидыМеню.ВремяНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				И &НаВремя <= ВидыМеню.ВремяОкончанияДействия
	|			ИЛИ ВидыМеню.ВремяОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				И &НаВремя >= ВидыМеню.ВремяНачалаДействия
	|			ИЛИ &НаВремя МЕЖДУ ВидыМеню.ВремяНачалаДействия И ВидыМеню.ВремяОкончанияДействия
	|			ИЛИ ВидыМеню.ВремяНачалаДействия > ВидыМеню.ВремяОкончанияДействия
	|				И (&НаВремя МЕЖДУ ВидыМеню.ВремяНачалаДействия И ДАТАВРЕМЯ(1, 1, 1, 23, 59, 59)
	|					ИЛИ &НаВремя МЕЖДУ ДАТАВРЕМЯ(1, 1, 1) И ВидыМеню.ВремяОкончанияДействия))";
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("ПустаяДата", 		'00010101000000');
	СписокПустыеДниНедели = Новый СписокЗначений; 
	СписокПустыеДниНедели.Добавить("0000000");
	СписокПустыеДниНедели.Добавить("       ");
	Запрос.УстановитьПараметр("ПустыеДниНедели", 	СписокПустыеДниНедели);
	Запрос.УстановитьПараметр("НаДату", 			НачалоДня(НаДату));
	Запрос.УстановитьПараметр("НаВремя", 			Дата(1, 1, 1, Час(НаДату), Минута(НаДату), 0));
	ТаблицаВидыМеню = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаВидыМеню;
	
КонецФункции

// Получает ссылку по ее идентификатору.
//
// Параметры:
//  ИсхИДСтрокой - Произвольный - Знач исх ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ПроверитьНаличие - Произвольный - Проверить наличие.
//
// Возвращаемое значение:
// 	Произвольный - Результат обработки.
Функция ПолучитьСсылкуПоИД(Знач ИсхИДСтрокой, МенеджерОбъекта, ПроверитьНаличие = Ложь) Экспорт
	
	Результат = МенеджерОбъекта.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИсхИДСтрокой) Тогда
		
		// Преобразуем в корректное значение ID
		ИДСтрокой = ПолучитьИДПоСтроке(ИсхИДСтрокой);
		// Получение ИД из строки
		ИД = Новый УникальныйИдентификатор(ИДСтрокой);
		// Получение ссылки по ИД
		Результат = МенеджерОбъекта.ПолучитьСсылку(ИД);
		// Проверяем есть объект в нашей БД
		Если ПроверитьНаличие Тогда
			Если ПустаяСтрока(Результат.ВерсияДанных) Тогда
				// Такого объекта в базе нет
				Результат = МенеджерОбъекта.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	// Возврат ссылки (без проверки не исключается что "битая").
	Возврат Результат;
	
КонецФункции

// Получает ссылку объекта ИБ по его идентификатору.
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//
// Возвращаемое значение:
// 	Произвольный - Ссылка объекта ИБ.
Функция ПолучитьИДПоСтроке(Знач ИДСтрокой) Экспорт 
	
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "{", "");
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "}", "");
	
	Возврат ИДСтрокой;
	
КонецФункции

// Получает идентификатор ссылки для записи в XML
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//  ДобавлятьРамку - Произвольный - Добавлять рамку.
//  ПроверятьКорректность - Произвольный - Проверять корректность.
//
// Возвращаемое значение:
//  Строка - Идентификатор объекта
Функция ПолучитьИДПоСсылке(Ссылка, ДобавлятьРамку = Истина, ПроверятьКорректность = Ложь) Экспорт 
	
	Результат = "";
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		Результат = XMLСтрока(Ссылка);
		
		СсылкаКорректная = Истина;
		Если ПроверятьКорректность
			И НЕ ТипЗнч(Ссылка) = Тип("Строка") Тогда
			СсылкаКорректная = ОбщегоНазначения.СсылкаСуществует(Ссылка);
		КонецЕсли;
		
		Если НЕ СсылкаКорректная Тогда
			Результат = "";
			
			ТекстОшибки = СтрШаблон(НСтр("ru='Обнаружена некорректная ссылка <%1>. Требуется запустить проверку ссылочной целостности.
			|(Конфигуратор - Администрирование - Тестирование и исправление)'"), Ссылка);
			ЗаписьЖурналаРегистрации("Обмен", УровеньЖурналаРегистрации.Ошибка, , Ссылка, ТекстОшибки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	
		ИначеЕсли Результат = "00000000-0000-0000-0000-000000000000" Тогда
			Результат = "";
		ИначеЕсли ДобавлятьРамку Тогда
			Результат = "{" + Результат + "}"
		Иначе
			Результат = Результат;
		КонецЕсли;
		
	Исключение
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка получения XML-представления ссылки <" + Ссылка + "> - " + ТекстОшибки;
		ЗаписьЖурналаРегистрации("Обмен", УровеньЖурналаРегистрации.Ошибка, , Ссылка, ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Получает объект ИБ по его идентификатору.
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ЭтоГруппа - Произвольный - Это группа.
//  СоздаватьОбъект - Произвольный - Создавать объект.
//
// Возвращаемое значение:
// 	Массив - Массив родителей всех уровней.
Функция ПолучитьОбъектПоИД(Знач ИДСтрокой, МенеджерОбъекта, ЭтоГруппа, СоздаватьОбъект = Истина) Экспорт
	ОбъектСсылка = ПолучитьСсылкуПоИД(ИДСтрокой, МенеджерОбъекта);
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектБазыДанных = ОбъектСсылка.ПолучитьОбъект();
	Если ОбъектБазыДанных = Неопределено Тогда
		Если СоздаватьОбъект Тогда
			Если НЕ  Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка)) Тогда
				Если ЭтоГруппа Тогда
					Объект = МенеджерОбъекта.СоздатьГруппу();
				Иначе
					Объект = МенеджерОбъекта.СоздатьЭлемент();
				КонецЕсли; 
			Иначе
				Объект = МенеджерОбъекта.СоздатьДокумент();
			КонецЕсли; 
			Объект.УстановитьСсылкуНового(ОбъектСсылка);
		Иначе
			Объект = ОбъектБазыДанных;
		КонецЕсли; 
	Иначе
		Объект = ОбъектБазыДанных;
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции

// Получает ссылку ставки НДС по идентификатору.
//
// Параметры:
//  ИДСтрокой - Произвольный - Ид строкой.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
// 	 СправочникСсылка.СтавкиНДС - Ставка НДС.
Функция ПолучитьСтавкуНДСПоИД(ИДСтрокой, ДопПараметры) Экспорт
	ИД = ПолучитьИДПоСтроке(ИДСтрокой);
	СтруктураОтбора = Новый Структура("ИД", НРег(ИД));
	МассивСтрок = ДопПараметры.ТаблицаСтавокНДС.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() = 0 Тогда
		СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка();
	Иначе
		СтавкаНДС = МассивСтрок[0].СтавкаНДС;
	КонецЕсли;
	Возврат СтавкаНДС;
КонецФункции

// Заносит строку протокола события с указанием вида и важности события.
//
// Параметры:
//  ТипСобытия - Произвольный - Тип события.
//  СтрСообщения - Произвольный - Знач стр сообщения.
//  Данные - Произвольный - Знач данные.
//  УровеньЖурнала - Произвольный - Знач уровень журнала.
//  КомментироватьХодОбмена - Произвольный - Комментировать ход обмена.
//
Процедура ЗафиксироватьСобытие(ТипСобытия, Знач СтрСообщения, Знач Данные = Неопределено, Знач УровеньЖурнала = Неопределено, КомментироватьХодОбмена = Ложь) Экспорт
	
	ТекВремяДата = Формат(ТекущаяДата(), "ДФ = 'гггг.ММ.дд ЧЧ:мм:сс'");
	
	СтрСообщения = СтрЗаменить(СтрСообщения, Символы.ПС, ". ");
	
	МетаданныеОбъекта = Неопределено;
	ДанныеСсылка = Неопределено;
	
	Если Данные <> Неопределено Тогда
		Попытка
			МетаданныеОбъекта = Данные.Метаданные();
		Исключение 
		КонецПопытки;
		Попытка
			ДанныеСсылка = Данные.Ссылка;
		Исключение 
		КонецПопытки;
	КонецЕсли;
	
	// Журнал регистрации
	Если (УровеньЖурнала = Неопределено) ИЛИ (ТипЗнч(УровеньЖурнала) <> Тип("УровеньЖурналаРегистрации")) Тогда
		ЗаписьЖурналаРегистрации(ТипСобытия, 			   , МетаданныеОбъекта, ДанныеСсылка, СтрСообщения);
	Иначе
		ЗаписьЖурналаРегистрации(ТипСобытия, УровеньЖурнала, МетаданныеОбъекта, ДанныеСсылка, СтрСообщения);
	КонецЕсли;
	
	// Сообщение для пользователя
	Если КомментироватьХодОбмена Тогда
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекДата + СтрСообщения);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает полное представление объекта.
//
// Параметры:
//  ТипДанных - Произвольный - Тип данных.
//  Данные - Произвольный - Данные.
//  ЭтоУдаление - Произвольный - Это удаление.
//
// Возвращаемое значение:
// 	Строка - Представление объекта.
Функция ПредставлениеДанных(ТипДанных,Данные,ЭтоУдаление) Экспорт
	
	ТипДанныхСтр = Строка(ТипДанных);
	Если ЭтоУдаление Тогда
		Представление = "Удаление объекта: " + Строка(ТипДанныхСтр) + ": " + Строка(Данные);
	Иначе
		Представление = Строка(ТипДанныхСтр) + ": " + Строка(Данные);
	КонецЕсли;
	
	Код = ""; Наименование = "";
	Отбор = НЕОПРЕДЕЛЕНО;
	НаименованиеДок = "";
	
	Если (Найти(ВРЕГ(ТипДанныхСтр),"ДОКУМЕНТ")) Тогда
		Попытка
			НаименованиеДок = Строка(Данные);
		Исключение
		КонецПопытки;
	ИначеЕсли (Найти(ВРЕГ(ТипДанныхСтр),"ССЫЛКА")=0) И (Найти(ВРЕГ(ТипДанныхСтр),"ОБЪЕКТ")=0) Тогда
		Попытка
			Отбор = Данные.Отбор;
		Исключение
		КонецПопытки;
	Иначе
		Попытка
			Код = СокрЛП(Данные.Код);
		Исключение
		КонецПопытки;
		Если ПустаяСтрока(Код) Тогда
			Попытка
				Наименование = СокрЛП(Данные.Наименование);
			Исключение
				Наименование = "";
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(НаименованиеДок) Тогда
		Представление = Представление + ", ( " +СокрЛП(НаименованиеДок) + ")";
	ИначеЕсли НЕ ПустаяСтрока(Код) Тогда
		Представление = Представление + ", (Код = " + СокрЛП(Данные.Код) + ")";
	ИначеЕсли НЕ ПустаяСтрока(Наименование) Тогда
		Представление = Представление + ", (" + СокрЛП(Данные.Наименование) + ")";
	ИначеЕсли ЗначениеЗаполнено(Отбор) Тогда
		Пока ИСТИНА Цикл
			ПозицияНач = Найти(Отбор, "<Объект не найден> (");
			Если ПозицияНач = 0 Тогда
				Прервать;
			КонецЕсли; 
			Отбор = СтрЗаменить(Отбор, Сред(Отбор, ПозицияНач, 56), "<Объект будет загружен далее>");
		КонецЦикла; 
		Представление  = Представление + ", (" + Отбор + ")";
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Получает имя файла обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ОтправкаСообщения - Произвольный - Отправка сообщения.
//  Номер - Произвольный - Знач номер.
//  Расширение - Произвольный - Знач расширение.
//  Архивация - Произвольный - Архивация.
//  Транслит - Произвольный - Транслит.
//  СозданиеНачальногоОбраза - Произвольный - Создание начального образа.
//
// Возвращаемое значение:
//   Строка - С именем файла.
Функция ИмяФайлаДоставки(УзелОбмена, ОтправкаСообщения = Истина, Знач Номер = Неопределено, Знач Расширение = Неопределено, Архивация = Ложь, Транслит = Ложь, СозданиеНачальногоОбраза = Ложь) Экспорт
	
	Рез = "";
	
	ЭтотУзел = ПланыОбмена[УзелОбмена.Метаданные().Имя].ЭтотУзел();
	
	УзелИсточник = ?(ОтправкаСообщения, ЭтотУзел, УзелОбмена);
	УзелПриемник = ?(ОтправкаСообщения, УзелОбмена, ЭтотУзел);
	
	Если Расширение = Неопределено Тогда
		Расширение = ?(Архивация, "zip", "xml");
	КонецЕсли;
	
	ТипУзлаОбмена = ТипЗнч(УзелОбмена.Ссылка);
	
	Если ТипУзлаОбмена = Тип("ПланОбменаСсылка.питУдаленныеКассы") Тогда
		
		// EXCH_Request_1.xml
		Если СозданиеНачальногоОбраза И ОтправкаСообщения Тогда
			Номер = "0";
		Иначе
			Если Номер = Неопределено Тогда
				Номер = НомерСообщенияОбмена(УзелОбмена, ЭтотУзел = УзелПриемник, 0);
			ИначеЕсли ТипЗнч(Номер) = Тип("Число") Тогда
				Номер = Формат(Номер, "ЧГ=0");
			КонецЕсли;
		КонецЕсли; 
		
		Рез = ?(ОтправкаСообщения, СокрЛП(УзелПриемник.Префикс), СокрЛП(УзелИсточник.Префикс))
			+ "_" + ?(ОтправкаСообщения, "Request", "Response") 
			+ "_" + Номер + "." + Расширение;
		
		Если Транслит Тогда
			Рез = ВыполнитьТранслит(Рез);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Рез; 
	
КонецФункции

// Получает номер сообщения обмена текущего узла с указанным в параметре.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  Принятое - Произвольный - Принятое.
//  ДлинаНомера - Произвольный - Длина номера.
//
// Возвращаемое значение:
//   Число - Номер принятого или отправленного сообщения.
Функция НомерСообщенияОбмена(УзелОбмена, Принятое = Истина, ДлинаНомера = 10) Экспорт
	
	Номер = ?(Принятое, УзелОбмена.НомерПринятого + 1, УзелОбмена.НомерОтправленного);
	Если ДлинаНомера = 0 Тогда
		Номер = Формат(Номер, "ЧГ=0");
	Иначе
		Номер = Формат(Номер, "ЧЦ=" + ДлинаНомера + "; ЧВН=;ЧГ=0");
	КонецЕсли; 
	
	Возврат Номер;
	
КонецФункции // НомерСообщенияОбмена()

// Выделяет из полного пути к файлу его имя (набор символов после последней \).
//
// Параметры:
//  ПутьКФайлу - Произвольный - Знач путь к файлу.
//  Символ - Произвольный - Символ.
//
// Возвращаемое значение:
//   Строка - Расширение файла.
Функция ПолучитьИмяФайлаИзПолногоПути(Знач ПутьКФайлу, Символ = "\") Экспорт
	
	ИмяФайла = ПолучитьЧастьСтрокиОтделеннойСимволом(ПутьКФайлу, Символ);
	Возврат ИмяФайла;
КонецФункции	

// Функция - Удалить файлы по маске.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  Выгрузка - Произвольный - Выгрузка.
//  МаскаНомер - Произвольный - Маска номер.
//  МаскаРасширения - Произвольный - Маска расширения.
//  ИсключатьТекущее - Произвольный - Исключать текущее.
//  МассивИсключения - Массив - Массив исключения.
//  СозданиеНачальногоОбраза - Произвольный - Создание начального образа.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция УдалитьФайлыПоМаске(УзелОбмена,НастройкаДоставки,Выгрузка = Истина, МаскаНомер = "??????????", МаскаРасширения = "*", 
	ИсключатьТекущее = Истина, МассивИсключения = Неопределено, СозданиеНачальногоОбраза = Ложь) Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	Рез = Истина;
	КаталогСообщенийОбмена = НастройкаДоставки.КаталогОбменов;
	
	Если ПустаяСтрока(КаталогСообщенийОбмена) Тогда
		КаталогСообщенийОбмена = КаталогВременныхФайлов();
	КонецЕсли;
	
	Маска = "";
	Если ПустаяСтрока(Маска) Тогда
		ЭтотУзел = ПланыОбмена[УзелОбмена.Метаданные().Имя].ЭтотУзел();
		ИмяФайлаТекСообщения = ИмяФайлаДоставки(УзелОбмена, Выгрузка, 
		?(Выгрузка, УзелОбмена.НомерОтправленного, УзелОбмена.НомерПринятого), , НастройкаДоставки.АрхивироватьСообщенияОбмена,, СозданиеНачальногоОбраза);
		
		Маска = ИмяФайлаДоставки(УзелОбмена, Выгрузка, МаскаНомер, МаскаРасширения);
		
		ИмяФайлаТекСообщения = СтрЗаменить(ИмяФайлаТекСообщения, ".xml", "");
		ИмяФайлаТекСообщения = СтрЗаменить(ИмяФайлаТекСообщения, ".zip", "");
		
	КонецЕсли;
	
	МассивФайлыОбмена = НайтиФайлы(КаталогСообщенийОбмена, Маска);
	
	// Дополним файлами из каталога временных файлов.
	Если Прав(КаталогСообщенийОбмена,1) <> "/" И Прав(КаталогСообщенийОбмена,1) <> "\" Тогда
		КаталогСообщенийОбмена = КаталогСообщенийОбмена + Слеш;
	КонецЕсли;
	Если НастройкаДоставки.ИспользоватьВременныйКаталог Тогда
		МассивВременныеФайлы = НайтиФайлы(НастройкаДоставки.КаталогВременныхФайлов, Маска);
		Для Каждого ТекФайл Из МассивВременныеФайлы Цикл
			МассивФайлыОбмена.Добавить(ТекФайл);
		КонецЦикла;
	КонецЕсли;
	
	ЕстьИсключенияКоторыеНельзяУдалять = (ТипЗнч(МассивИсключения) = Тип("Массив")) И (МассивИсключения.Количество() > 0);
	Для Каждого ТекФайл Из МассивФайлыОбмена Цикл
		Если ИсключатьТекущее И ТекФайл.ИмяБезРасширения = ИмяФайлаТекСообщения Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьИсключенияКоторыеНельзяУдалять И (МассивИсключения.Найти(ТекФайл.ПолноеИмя) <> Неопределено) Тогда
			Продолжить;
		КонецЕсли;
		
		// Пытаемся удалить файл со старым сообщением.
		Попытка
			УдалитьФайлы(ТекФайл.ПолноеИмя);
		Исключение
			Рез = Ложь;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Рез;
КонецФункции

// Выполняет выгрузку данных (включая регистрацию, запись и доставку сообщения).
//
// Параметры:
//  Параметры - Структура - содержит набор параметров, необходимых для обмена.
//
Процедура ВыполнитьВыгрузкуДанных(Параметры) Экспорт
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Параметры = Новый Структура("Ошибка, Результат", "Функции обмена не были переданы параметры.", Ложь);
		Возврат; 
	КонецЕсли;
	питОбменДаннымиПолныеПрава.ВыгрузитьСообщениеОбмена(Параметры);	
КонецПроцедуры

// Выполняет загрузку данных (включая регистрацию, запись и доставку сообщения).
//
// Параметры:
//  Параметры - Структура - содержит набор параметров, необходимых для обмена.
//
Процедура ВыполнитьЗагрузкуДанных(Параметры) Экспорт
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Параметры = Новый Структура("Ошибка, Результат", "Функции обмена не были переданы параметры.", Ложь);
		Возврат; 
	КонецЕсли;
	питОбменДаннымиПолныеПрава.ЗагрузитьСообщениеОбмена(Параметры);
КонецПроцедуры

// По ссылке получает выгрузку меню по его виду.
//
// Параметры:
//  ВидМеню - Произвольный - Вид меню.
//
// Возвращаемое значение:
//   ТаблицаЗначений, Неопределено - результат выполнения запроса.
Функция ПолучитьСоставВидаМеню(ВидМеню) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Меню.Ссылка КАК Ссылка,
	|	Меню.Родитель,
	|	Меню.ЭтоГруппа,
	|	Меню.Код,
	|	Меню.Наименование,
	|	Меню.Номенклатура,
	|	Меню.ЕдиницаИзмерения.Наименование КАК ИмяЕдИзм,
	|	Меню.НомерВГруппе,
	|	Меню.Выключен,
	|	Меню.ИмяКартинки,
	|	Меню.ЦветФонаКнопок,
	|	Меню.Номенклатура.питБыстрыйКод КАК БыстрыйКод,
	|	Меню.Владелец,
	|	Меню.ПометкаУдаления
	|ИЗ
	|	Справочник.питМеню КАК Меню
	|ГДЕ
	|	Меню.Владелец = &ВидМеню
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка ИЕРАРХИЯ";
	Запрос.УстановитьПараметр("ВидМеню", ВидМеню);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ПолучитьСоставВидаМеню

// По ссылке получает роли пользователя во фронте.
//
// Параметры:
//  Пользователь - Произвольный - Пользователь.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - результат выполнения запроса.
Функция ПолучитьРолиФронтаПользователя(Пользователь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРолиПользователейФронта.РольФронта КАК РольПользователяФронта
	|ИЗ
	|	РегистрСведений.питРолиПользователейФронта КАК питРолиПользователейФронта
	|ГДЕ
	|	питРолиПользователейФронта.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Функция - Получить кжбу по владельцу.
//
// Параметры:
//  ВладелецСсылка - Произвольный - Владелец ссылка.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьАлкоИнгредиентыПоВладельцу(ВладелецСсылка, ДопПараметры) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ингредиент", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(Результат,
		"ГруппаАналогов", Тип("СправочникСсылка.питМаркированныеАналоги"));
	Результат.Колонки.Добавить("КоличествоБлюда", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	Результат.Колонки.Добавить("КоличествоИнгредиента", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	
	ДанныеНоменклатуры = ДопПараметры.СоответствиеНоменклатуры[ВладелецСсылка];
	
	Если ДанныеНоменклатуры = Неопределено
		ИЛИ НЕ ДанныеНоменклатуры.Свойство("СоставАлкогольнойПродукции") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ДанныеНоменклатуры.СоставАлкогольнойПродукции Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


// По ссылке удаляет роли пользователя во фронте из регистра.
//
// Параметры:
//  Пользователь - Произвольный - Пользователь.
//
Процедура УдалитьРолиПользователейФронта(Пользователь) Экспорт
	
	Попытка
		НаборЗап = РегистрыСведений.питРолиПользователейФронта.СоздатьНаборЗаписей();
		НаборЗап.Отбор.Пользователь.Значение = Пользователь;
		НаборЗап.Отбор.Пользователь.Использование = Истина;
		НаборЗап.Прочитать();
		НаборЗап.Очистить();
		НаборЗап.Записать(Истина);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "УдаленныеКассы.Загрузка";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Записывает роль пользователя во фронте в регистр.
//
// Параметры:
//  Пользователь - Произвольный - Пользователь.
//  РольФронта - Произвольный - Роль фронта.
//
Процедура ЗаписатьРольПользователя(Пользователь, РольФронта) Экспорт
	
	Если РольФронта = Неопределено ИЛИ ПустаяСтрока(РольФронта) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		НаборЗап = РегистрыСведений.питРолиПользователейФронта.СоздатьНаборЗаписей();
		НаборЗап.Отбор.Пользователь.Значение = Пользователь;
		НаборЗап.Отбор.Пользователь.Использование = Истина;
		НаборЗап.Отбор.РольФронта.Значение = РольФронта;
		НаборЗап.Отбор.РольФронта.Использование = Истина;
		НаборЗап.Прочитать();
		НаборЗап.Очистить();
		НовЗапись = НаборЗап.Добавить();
		НовЗапись.Пользователь = Пользователь;
		НовЗапись.РольФронта = РольФронта;
		
		НаборЗап.Записать(Истина);
		
	Исключение
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "УдаленныеКассы.Загрузка";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

// Функция получения таблицы штрих кодов заданных для объекта
//
// Параметры:
//  ВладелецСсылка - СправочникСсылка.Номенклатура 
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ПолучитьШтрихкодыПоВладельцу(ВладелецСсылка) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ШтрихКоды.Штрихкод КАК ШтрихКод,
	|	ШтрихКоды.Номенклатура КАК Номенклатура,
	|	ШтрихКоды.Упаковка КАК Упаковка,
	|	ЛОЖЬ КАК ЭтоGTIN,
	|	0 КАК ВидШтрихкода
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихКоды
	|ГДЕ
	|	ШтрихКоды.Номенклатура = &ВыбСсылка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("ВыбСсылка", ВладелецСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРезультата = питОбщегоНазначения.ПустаяТаблицаПоРезультатуЗапроса(РезультатЗапроса);
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаРезультата, "ЭтоGTIN", Тип("Булево"));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаРезультата, "ВидУпаковки", Тип("Строка"));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаРезультата, "КоличествоПотребительскихУпаковок", Тип("Число"));
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ТаблицаРезультата;
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если НЕ НоваяСтрока.ВидШтрихкода = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ШтрихКод = Выборка.ШтрихКод;
		Если НЕ МенеджерОборудованияКлиентСервер.ПроверитьКорректностьGTIN(ШтрихКод) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
			МодульШтрихкодированиеОбщегоНазначенияИСКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИСКлиентСервер");
			МодульРазборКодаМаркировкиИССлужебныйКлиентСервер = ОбщегоНазначения.ОбщийМодуль("РазборКодаМаркировкиИССлужебныйКлиентСервер");
			GTIN = МодульШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(Штрихкод);
			НоваяСтрока.ЭтоGTIN = (НЕ МодульРазборКодаМаркировкиИССлужебныйКлиентСервер.ЭтоВнутреннийШтрихкод(GTIN)
				И ШтрихКод = GTIN);
		Иначе
			Продолжить;
		КонецЕсли;
		
		ОписанияGTIN = РегистрыСведений.ОписаниеGTINИС.ПолучитьОписание(GTIN);
		ОписаниеGTIN = ОписанияGTIN[GTIN];
		Если ОписаниеGTIN = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОписаниеGTIN);
		НоваяСтрока.ВидУпаковки = ПолучитьВидыУпаковокИС(ОписаниеGTIN.ВидУпаковки);
		НоваяСтрока.ЭтоGTIN = ЭтоGTINПоОписаниюGTIN(ОписаниеGTIN);
		
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;
	
КонецФункции

Функция ЭтоGTINПоОписаниюGTIN(ОписаниеGTIN)
	Результат = ЗначениеЗаполнено(ОписаниеGTIN.ВидУпаковки)
		И НЕ ОписаниеGTIN.ВидУпаковки = Перечисления.ВидыУпаковокИС.НеЯвляетсяУпаковкой
		И НЕ ОписаниеGTIN.ВидУпаковки = Перечисления.ВидыУпаковокИС.Неопределен;
	Возврат Результат;
КонецФункции


// Функция - Проверить наличие связанных объектов с номенклатурой.
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//  Комментировать - Произвольный - Комментировать.
//  Действие - Строка - Действие.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПроверитьНаличиеСвязанныхОбъектовСНоменклатурой(Ссылка, Комментировать = Ложь, Действие ="") Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_Номенклатура.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА ВТ_Номенклатура.ЭтоГруппа
	               |			ТОГДА ВТ_Номенклатура.питВыгружатьВРБК
	               |		ИНАЧЕ ЕСТЬNULL(ВТ_Номенклатура1.питВыгружатьВРБК, ЛОЖЬ)
	               |	КОНЕЦ КАК ВыгружаетсяВоФронт,
	               |	ВТ_Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	               |	ВТ_Номенклатура.Представление КАК Представление
	               |ПОМЕСТИТЬ ВТ_НоменклатураБезФильтра
	               |ИЗ
	               |	Справочник.Номенклатура КАК ВТ_Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ВТ_Номенклатура1
	               |		ПО ВТ_Номенклатура.Родитель = ВТ_Номенклатура1.Ссылка
	               |ГДЕ
	               |	ВТ_Номенклатура.Ссылка = &Ссылка
	               |	И НЕ ВТ_Номенклатура.ЭтоГруппа
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_Номенклатура.Ссылка,
	               |	ВЫБОР
	               |		КОГДА ВТ_Номенклатура.ЭтоГруппа
	               |			ТОГДА ВТ_Номенклатура.питВыгружатьВРБК
	               |		ИНАЧЕ ЕСТЬNULL(ВТ_Номенклатура1.питВыгружатьВРБК, ЛОЖЬ)
	               |	КОНЕЦ,
	               |	ВТ_Номенклатура.ЭтоГруппа,
	               |	ВТ_Номенклатура.Представление
	               |ИЗ
	               |	Справочник.Номенклатура КАК ВТ_Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ВТ_Номенклатура1
	               |		ПО ВТ_Номенклатура.Родитель = ВТ_Номенклатура1.Ссылка
	               |ГДЕ
	               |	ВТ_Номенклатура1.Ссылка = &Ссылка
	               |	И ВТ_Номенклатура1.ЭтоГруппа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НоменклатураБезФильтра.Ссылка КАК Ссылка,
	               |	ВТ_НоменклатураБезФильтра.ВыгружаетсяВоФронт КАК ВыгружаетсяВоФронт,
	               |	ВТ_НоменклатураБезФильтра.ЭтоГруппа КАК ЭтоГруппа,
	               |	ВТ_НоменклатураБезФильтра.Представление КАК ПредставлениеНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ВыгружаемаяНоменклатура
	               |ИЗ
	               |	ВТ_НоменклатураБезФильтра КАК ВТ_НоменклатураБезФильтра
	               |ГДЕ
	               |	НЕ(НЕ ВТ_НоменклатураБезФильтра.ВыгружаетсяВоФронт
	               |				И НЕ ВТ_НоменклатураБезФильтра.ЭтоГруппа)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СпрНоменклатура.Ссылка КАК Номенклатура,
	               |	ЕСТЬNULL(питМодификаторы.Ссылка, НЕОПРЕДЕЛЕНО) КАК СвязанныйЭлемент,
	               |	""Модификатор"" КАК ОбъектСвязи,
	               |	1 КАК ТипОбъектаСвязи,
	               |	СпрНоменклатура.ПредставлениеНоменклатуры КАК ПредставлениеНоменклатуры,
	               |	питМодификаторы.Представление КАК Представление,
	               |	"""" КАК ПредставлениеВладельца
	               |ПОМЕСТИТЬ ВТ_НайденныеСтроки
	               |ИЗ
	               |	ВТ_ВыгружаемаяНоменклатура КАК СпрНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питМодификаторы КАК питМодификаторы
	               |		ПО СпрНоменклатура.Ссылка = питМодификаторы.ДопНоменклатура
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СпрНоменклатура.Ссылка,
	               |	ЕСТЬNULL(питМеню.Ссылка, НЕОПРЕДЕЛЕНО),
	               |	""Меню"",
	               |	2,
	               |	СпрНоменклатура.ПредставлениеНоменклатуры,
	               |	питМеню.Представление,
	               |	питМеню.Владелец.Представление
	               |ИЗ
	               |	ВТ_ВыгружаемаяНоменклатура КАК СпрНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питМеню КАК питМеню
	               |		ПО СпрНоменклатура.Ссылка = питМеню.Номенклатура
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СпрНоменклатура.Ссылка,
	               |	ЕСТЬNULL(питМодификаторыНоменклатуры.Модификатор, НЕОПРЕДЕЛЕНО),
	               |	""Модификаторы номенклатуры"",
	               |	3,
	               |	СпрНоменклатура.ПредставлениеНоменклатуры,
	               |	"""",
	               |	""""
	               |ИЗ
	               |	ВТ_ВыгружаемаяНоменклатура КАК СпрНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питМодификаторыНоменклатуры КАК питМодификаторыНоменклатуры
	               |		ПО СпрНоменклатура.Ссылка = питМодификаторыНоменклатуры.Номенклатура
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СпрНоменклатура.Ссылка,
	               |	ЕСТЬNULL(питМаршрутизацияПечати.КассовыйУзел, НЕОПРЕДЕЛЕНО),
	               |	""Маршрутизация печати"",
	               |	4,
	               |	СпрНоменклатура.ПредставлениеНоменклатуры,
	               |	"""",
	               |	""""
	               |ИЗ
	               |	ВТ_ВыгружаемаяНоменклатура КАК СпрНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питМаршрутизацияПечати КАК питМаршрутизацияПечати
	               |		ПО СпрНоменклатура.Ссылка = питМаршрутизацияПечати.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_НайденныеСтроки.Номенклатура КАК Номенклатура,
	               |	ВТ_НайденныеСтроки.СвязанныйЭлемент КАК СвязанныйЭлемент,
	               |	ВТ_НайденныеСтроки.ОбъектСвязи КАК ОбъектСвязи,
	               |	ВТ_НайденныеСтроки.ТипОбъектаСвязи КАК ТипОбъектаСвязи,
	               |	ВТ_НайденныеСтроки.ПредставлениеНоменклатуры КАК ПредставлениеНоменклатуры,
	               |	ВТ_НайденныеСтроки.Представление КАК Представление
	               |ИЗ
	               |	ВТ_НайденныеСтроки КАК ВТ_НайденныеСтроки
	               |ГДЕ
	               |	НЕ ВТ_НайденныеСтроки.СвязанныйЭлемент = НЕОПРЕДЕЛЕНО
	               |ИТОГИ
	               |	МАКСИМУМ(ПредставлениеНоменклатуры)
	               |ПО
	               |	Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ЭлементыИмеютСвязанныеОбъекты = НЕ РезультатЗапроса.Пустой();
	Если ЭлементыИмеютСвязанныеОбъекты Тогда
		МассивСтрокСообщения = Новый Массив;
		МассивСтрокСообщения.Добавить("Отказ выполнения "+ Действие);
		
		МассивСтрокСообщения.Добавить("Связанные объекты выгружаются во фронт.");
		ПрефиксСтроки = " -";
		
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			МассивСтрокСообщения.Добавить(СтрШаблон("Номенклатура <%1>:", Выборка.ПредставлениеНоменклатуры));
			ВыборкаДЗ = Выборка.Выбрать();
			Пока ВыборкаДЗ.Следующий() Цикл
				Если ВыборкаДЗ.ТипОбъектаСвязи = 3 ИЛИ ВыборкаДЗ.ТипОбъектаСвязи = 4 Тогда
					ТекстСтроки = СтрШаблон(" - Запись регистра сведений ""%1""",ВыборкаДЗ.ОбъектСвязи);
				ИначеЕсли ВыборкаДЗ.ТипОбъектаСвязи = 2 Тогда
					ТекстСтроки = СтрШаблон(" - Элемент справочника ""%1"" <%2> (Вид меню ""%3"")",ВыборкаДЗ.ОбъектСвязи, ВыборкаДЗ.Представление,ВыборкаДЗ.ПредставлениеВладельца);
				Иначе
					ТекстСтроки = СтрШаблон(" - Элемент справочника ""%1"" <%2>",ВыборкаДЗ.ОбъектСвязи, ВыборкаДЗ.Представление);
				КонецЕсли;
				
				МассивСтрокСообщения.Добавить(ТекстСтроки);
			КонецЦикла;
		КонецЦикла;
		
		ТекстСообщения = СтрСоединить(МассивСтрокСообщения,Символы.ПС);
		ЗаписьЖурналаРегистрации("СправочникНоменклатура", УровеньЖурналаРегистрации.Предупреждение, , , ТекстСообщения);
		Если Комментировать Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЭлементыИмеютСвязанныеОбъекты;
КонецФункции

// Получает всех родителей элемента справочника
//
// Параметры:
//  СправочникСсылка - Произвольный - Справочник ссылка.
//
// Возвращаемое значение:
// 	Массив - Массив родителей всех уровней	
Функция ПолучитьМассивСРодителями(СправочникСсылка) Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(СправочникСсылка);
	
	ТекРодитель = СправочникСсылка.Родитель;
	Пока НЕ ТекРодитель.Пустая() Цикл
		Результат.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает массив касс ККМ кассового узла.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//
// Возвращаемое значение:
// 	 Массив - Массив касс ККМ.
Функция ПолучитьКассыККМПоУзлуОбмена(УзелОбмена) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КассыККМ.Ссылка
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	КассыККМ.питКассовыйУзел В(&УзелОбмена)";
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	МассивКассККМ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивКассККМ;
	
КонецФункции

// Проверяет набор записей РС "Маршрутизация печати", нужно ли его отправлять в кассовый узел или пропустить.
//
// Параметры:
//  ЭлементДанных - Произвольный - Элемент данных.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПропуститьЗаписьНабораМаршрутизацияПечати(ЭлементДанных, ДопПараметры) Экспорт
	
	Если ДопПараметры.УзелОбмена.ПравилаПередачиМаршрутизации = 0 Тогда
		Возврат Истина; // Этот узел БЭК "не слушает" - ничего ему не будем отправлять
	КонецЕсли;
	
	ИндивидуальныеПравила = (ДопПараметры.УзелОбмена.ПравилаПередачиМаршрутизации = 2);
	УзелВНабореЗаполнен = ЗначениеЗаполнено(ЭлементДанных.Отбор.КассовыйУзел.Значение);
	
	Если УзелВНабореЗаполнен <> ИндивидуальныеПравила Тогда
		Возврат Истина; // Этот набор записей не для текущего узла, пропускаем
	КонецЕсли;
	
	Если ИндивидуальныеПравила И (ЭлементДанных.Отбор.КассовыйУзел.Значение <> ДопПараметры.УзелОбмена) Тогда
		Возврат Истина; // Этот набор записей для другого узла, пропускаем
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Проверяет набор записей РС "Маршрутизация печати", есть ли неизвестные КУ значения измерений.
//  Если запись не будет проходить проверку то далее необходимо отправить команду удаления записи в КУ.
//
// Параметры:
//  ЭлементДанных - Произвольный - Элемент данных.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаписьНабораМаршрутизацияПечатиПроходитПроверку(ЭлементДанных, ДопПараметры) Экспорт
	
	Результат = Истина; // по умолчанию
	
	// Пустой набор записей.
	Если ЭлементДанных.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДопПараметры.ПравилаПередачиМаршрутизации = 0 Тогда
		// В данном режиме передача записей маршрутизации печати выключена, записи не передаются даже если регистрация
		Результат = Ложь;
	ИначеЕсли ДопПараметры.ПравилаПередачиМаршрутизации = 1 Тогда
		// В данном режиме передаются только общие правила маршрутизации
		Если ЗначениеЗаполнено(ЭлементДанных.Отбор.КассовыйУзел.Значение) Тогда 
			// Это не общие правило, по этому не отправляем его в кассовый узел
			Результат = Ложь;
		Иначе
			// Возможна ситуация, при которой фактически записи в регистре нет, но регистрация по ней осталась
			// Необходимо проверить существование этой записи в БД на момент выгрузки
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	МаршрутизацияПечати.Номенклатура
			|ИЗ
			|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
			|ГДЕ
			|	МаршрутизацияПечати.КассовыйУзел = ЗНАЧЕНИЕ(ПланОбмена.питУдаленныеКассы.ПустаяСсылка)
			|	И МаршрутизацияПечати.Номенклатура = &НоменклатураСсылка
			|	И МаршрутизацияПечати.ВидМеню = &ВидМенюСсылка
			|	И МаршрутизацияПечати.Зал = &ЗалСсылка
			|	И МаршрутизацияПечати.МестоПечати = &МестоПечатиСсылка";
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("НоменклатураСсылка",	ЭлементДанных.Отбор.Номенклатура.Значение);
			Запрос.УстановитьПараметр("ВидМенюСсылка",		ЭлементДанных.Отбор.ВидМеню.Значение);
			Запрос.УстановитьПараметр("ЗалСсылка",			ЭлементДанных.Отбор.Зал.Значение);
			Запрос.УстановитьПараметр("МестоПечатиСсылка",	ЭлементДанных.Отбор.МестоПечати.Значение);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда 
				// Физически в базе записи нет, поэтому отправим команду на удаление данной записи из кассового узла
				Результат = Ложь;
			ИначеЕсли (ЭлементДанных.Отбор.Номенклатура.Значение.Пустая() ИЛИ НоменклатураИзвестнаУзлу(ЭлементДанных.Отбор.Номенклатура.Значение, ДопПараметры.Получатель,,ДопПараметры))
				И (ЭлементДанных.Отбор.ВидМеню.Значение.Пустая() ИЛИ питОбменДаннымиПовтИсп.ВидМенюИзвестенУзлу(ЭлементДанных.Отбор.ВидМеню.Значение, ДопПараметры.Получатель))
				И (ЭлементДанных.Отбор.Зал.Значение.Пустая() ИЛИ питОбменДаннымиПовтИсп.ЗалИзвестенУзлу(ЭлементДанных.Отбор.Зал.Значение, ДопПараметры.Получатель))
				И питОбменДаннымиПовтИсп.МестоПечатиИзвестноУзлу(ЭлементДанных.Отбор.МестоПечати.Значение, ДопПараметры.Получатель) Тогда // Место печати пустым быть не может
				// хорошая запись
				Результат = Истина;
			Иначе
				// плохая запись, удалим
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ДопПараметры.ПравилаПередачиМаршрутизации = 2 Тогда
		
		// В данном режиме передаются правила маршрутизации, относящиеся к данному узлу
		Если НЕ ЭлементДанных.Отбор.КассовыйУзел.Значение = ДопПараметры.Получатель Тогда
			// Данная запись не имеет отношение к данному узлу, пошлем команду на удаление
			Результат = Ложь;
		Иначе
			// Возможна ситуация, при которой фактически записи в регистре нет, но регистрация по ней осталась
			// Необходимо проверить существование этой записи в БД на момент выгрузки
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	МаршрутизацияПечати.Номенклатура
			|ИЗ
			|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
			|ГДЕ
			|	МаршрутизацияПечати.Номенклатура = &НоменклатураСсылка
			|	И МаршрутизацияПечати.ВидМеню = &ВидМенюСсылка
			|	И МаршрутизацияПечати.Зал = &ЗалСсылка
			|	И МаршрутизацияПечати.МестоПечати = &МестоПечатиСсылка
			|	И МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел";
			
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("КассовыйУзел",		ДопПараметры.Получатель);
			Запрос.УстановитьПараметр("НоменклатураСсылка",	ЭлементДанных.Отбор.Номенклатура.Значение);
			Запрос.УстановитьПараметр("ВидМенюСсылка",		ЭлементДанных.Отбор.ВидМеню.Значение);
			Запрос.УстановитьПараметр("ЗалСсылка",			ЭлементДанных.Отбор.Зал.Значение);
			Запрос.УстановитьПараметр("МестоПечатиСсылка",	ЭлементДанных.Отбор.МестоПечати.Значение);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда 
				// Физически в базе записи нет, поэтому отправим команду на удаление данной записи из кассового узла
				Результат = Ложь;
			ИначеЕсли (ЭлементДанных.Отбор.Номенклатура.Значение.Пустая() ИЛИ НоменклатураИзвестнаУзлу(ЭлементДанных.Отбор.Номенклатура.Значение, ДопПараметры.Получатель,,ДопПараметры))
				И (ЭлементДанных.Отбор.ВидМеню.Значение.Пустая() ИЛИ питОбменДаннымиПовтИсп.ВидМенюИзвестенУзлу(ЭлементДанных.Отбор.ВидМеню.Значение, ДопПараметры.Получатель))
				И (ЭлементДанных.Отбор.Зал.Значение.Пустая() ИЛИ питОбменДаннымиПовтИсп.ЗалИзвестенУзлу(ЭлементДанных.Отбор.Зал.Значение, ДопПараметры.Получатель))
				И питОбменДаннымиПовтИсп.МестоПечатиИзвестноУзлу(ЭлементДанных.Отбор.МестоПечати.Значение, ДопПараметры.Получатель) Тогда // Место печати пустым быть не может
				// хорошая запись
				Результат = Истина;
			Иначе
				// плохая запись, удалим
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет набор записей РС "Маршрутизация печати", есть ли неизвестные КУ значения измерений.
//  Если запись не будет проходить проверку то далее необходимо отправить команду удаления записи в КУ.
//
// Параметры:
//  ЭлементДанных - Произвольный - Элемент данных.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаписьНабораМодификаторыНоменклатурыПроходитПроверку(ЭлементДанных, ДопПараметры) Экспорт
	
	ОтправитьУдаление = Ложь;
	Если (ЭлементДанных.Количество() = 0) 
		ИЛИ НЕ ЗначениеЗаполнено(ЭлементДанных.Отбор.Номенклатура.Значение) 
		ИЛИ НЕ НоменклатураИзвестнаУзлу(ЭлементДанных.Отбор.Номенклатура.Значение, ДопПараметры.Получатель,,ДопПараметры) Тогда
		ОтправитьУдаление = Истина;
	КонецЕсли;
	
	Возврат НЕ ОтправитьУдаление;
	
КонецФункции

// Функция - Получить точность округления.
//
// Параметры:
//  Объект - Произвольный - Объект.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьТочностьОкругления(Объект) Экспорт 
	
	Результат = 0;
	Если НЕ Объект = Неопределено Тогда
		ТЧПравилаОкругления = Объект.ПравилаОкругленияЦены;
		Если ТЧПравилаОкругления.Количество() Тогда
			// Возьмем точность из первой строки.
			Результат = ТЧПравилаОкругления[0].ТочностьОкругления;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Функция возвращает данные настройки обмена
// Параметры:
// 	НастройкаДоставки	-	НастройкаДоставки	-	НастройкаДоставки
// Возвращаемое значение:
// Структура - ДанныеНастройки
Функция ПолучитьДанныеНастройкиОбмена(НастройкаДоставки) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОбщепитНастройкиДоставкиСообщений.Ссылка,
	|	ОбщепитНастройкиДоставкиСообщений.ВерсияДанных,
	|	ОбщепитНастройкиДоставкиСообщений.ПометкаУдаления,
	|	ОбщепитНастройкиДоставкиСообщений.Код,
	|	ОбщепитНастройкиДоставкиСообщений.Наименование,
	|	ОбщепитНастройкиДоставкиСообщений.СпособОбмена,
	|	ОбщепитНастройкиДоставкиСообщений.АдресЭлектроннойПочты,
	|	ОбщепитНастройкиДоставкиСообщений.Таймаут,
	|	ОбщепитНастройкиДоставкиСообщений.СерверSMTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПортSMTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПользовательSMTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПарольSMTP,
	|	ОбщепитНастройкиДоставкиСообщений.СерверPOP3,
	|	ОбщепитНастройкиДоставкиСообщений.ПортPOP3,
	|	ОбщепитНастройкиДоставкиСообщений.ПользовательPOP3,
	|	ОбщепитНастройкиДоставкиСообщений.ПарольPOP3,
	|	ОбщепитНастройкиДоставкиСообщений.ПрофильMAPI,
	|	ОбщепитНастройкиДоставкиСообщений.ПарольMAPI,
	|	ОбщепитНастройкиДоставкиСообщений.СерверFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПортFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПользовательFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПарольFTP,
	|	ОбщепитНастройкиДоставкиСообщений.КаталогОбменаFTP,
	|	ОбщепитНастройкиДоставкиСообщений.СерверПроксиFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПортПроксиFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПротоколПроксиFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПользовательПроксиFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПарольПроксиFTP,
	|	ОбщепитНастройкиДоставкиСообщений.ПассивныйРежим,
	|	ОбщепитНастройкиДоставкиСообщений.ВестиЛогФайл,
	|	ОбщепитНастройкиДоставкиСообщений.ВестиЖурналРегистрации,
	|	ОбщепитНастройкиДоставкиСообщений.АрхивироватьСообщенияОбмена,
	|	ОбщепитНастройкиДоставкиСообщений.ПарольАрхивации,
	|	ОбщепитНастройкиДоставкиСообщений.ФиксироватьПриемОтправкуОбъектов,
	|	ОбщепитНастройкиДоставкиСообщений.КаталогОбменов,
	|	ОбщепитНастройкиДоставкиСообщений.ИспользоватьВременныйКаталог,
	|	ОбщепитНастройкиДоставкиСообщений.СохранятьОтправленные,
	|	ОбщепитНастройкиДоставкиСообщений.СохранятьПолученные,
	|	ОбщепитНастройкиДоставкиСообщений.ВыполнятьТранслитерацию,
	|	ОбщепитНастройкиДоставкиСообщений.ВестиСистемныйПротокол,
	|	ОбщепитНастройкиДоставкиСообщений.КаталогОтправленныхСообщений,
	|	ОбщепитНастройкиДоставкиСообщений.КаталогПолученныхСообщений,
	|	ОбщепитНастройкиДоставкиСообщений.КаталогВременныхФайлов,
	|	ОбщепитНастройкиДоставкиСообщений.КаталогНаКлиенте,
	|	ОбщепитНастройкиДоставкиСообщений.Предопределенный,
	|	ОбщепитНастройкиДоставкиСообщений.ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.питНастройкиДоставкиСообщений КАК ОбщепитНастройкиДоставкиСообщений
	|ГДЕ
	|	ОбщепитНастройкиДоставкиСообщений.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", НастройкаДоставки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеНастройки = Новый Структура("Ссылка, ПарольАрхивации, КаталогОбменов, ИспользоватьВременныйКаталог, СохранятьОтправленные, СохранятьПолученные,
		| ВестиСистемныйПротокол,КаталогПолученныхСообщений, КаталогОтправленныхСообщений,КаталогВременныхФайлов, СпособОбмена, КаталогНаКлиенте, КаталогОбменов, ИспользоватьВременныйКаталог");
		ЗаполнитьЗначенияСвойств(ДанныеНастройки, Выборка);
		Возврат ДанныеНастройки;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Получает ссылку объекта по типу и идентификатору.
//
// Параметры:
// 	ИДСтрокой     	- Строка. Идентификатор объекта.
// 	ТипЗначения     - Тип значения. Тип объекта.
//
// Возвращаемое значение:
//	Ссылка. Ссылка ИБ.
//
Функция ПолучитьСсылкуПоТипу(Знач ИДСтрокой, ТипЗначения)
	
	Если НЕ ЗначениеЗаполнено(ИДСтрокой) Тогда
		Возврат XMLЗначение(ТипЗначения, "00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "{", "");
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "}", "");
	
	// Возврат ссылки (не исключается "битая").
	Возврат XMLЗначение(ТипЗначения, ИДСтрокой);
	
КонецФункции

// Определяет наличие правил маршрутизации печати для кассового узла.
//
// Параметры:
//	 УзелОбмена - ПланОбменаСсылка.УдаленныеКассы. Кассовый узел.
//
// Возвращаемое значение:
//	 Булево. Результат проверки правил.
//
Функция НастроеныПравилаМаршрутизацииДляКассовогоУзла(УзелОбмена)
	
	Результат = Ложь;
	Если НЕ ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
					|	МаршрутизацияПечати.МестоПечати
					|ИЗ
					|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
					|ГДЕ
					|	МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел";
	
	Если УзелОбмена.ПравилаПередачиМаршрутизации = 2 Тогда
		Запрос.УстановитьПараметр("КассовыйУзел", УзелОбмена);
	Иначе
		Запрос.УстановитьПараметр("КассовыйУзел", ПланыОбмена.питУдаленныеКассы.ПустаяСсылка());
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует структуру таблицы для загрузки данных по модификаторам номенклатуры
//
// Параметры:
//	 Нет
//
// Возвращаемое значение:
//	 ТаблицаЗначений
//
Функция ПодготовитьТаблицуМодификаторыНоменклатуры()
	
	ТаблицаМодификаторыНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаМодификаторыНоменклатуры.Колонки.Добавить("Номенклатура", 	    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаМодификаторыНоменклатуры.Колонки.Добавить("Модификатор", 	    Новый ОписаниеТипов("СправочникСсылка.питМодификаторы"));
	ТаблицаМодификаторыНоменклатуры.Колонки.Добавить("ГруппаМодификатора", Новый ОписаниеТипов("СправочникСсылка.питГруппыМодификаторов"));
	ТаблицаМодификаторыНоменклатуры.Колонки.Добавить("ЭлементДанных",       Новый ОписаниеТипов("РегистрСведенийНаборЗаписей.питМодификаторыНоменклатуры"));
	
	Возврат ТаблицаМодификаторыНоменклатуры;
	
КонецФункции // ПодготовитьТаблицуМодификаторыНоменклатуры()

// Формирует структуру таблицы для загрузки данных по маршрутизации печати
//
// Параметры:
//	 Нет
//
// Возвращаемое значение:
//	 ТаблицаЗначений
//
Функция ПодготовитьТаблицуМаршрутизацияПечати()
	
	ТаблицаМаршрутизацияПечати = Новый ТаблицаЗначений;
	ТаблицаМаршрутизацияПечати.Колонки.Добавить("Номенклатура", 	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаМаршрутизацияПечати.Колонки.Добавить("ВидМеню", 			Новый ОписаниеТипов("СправочникСсылка.питВидыМеню"));
	ТаблицаМаршрутизацияПечати.Колонки.Добавить("Зал", 				Новый ОписаниеТипов("СправочникСсылка.питЗалы"));
	ТаблицаМаршрутизацияПечати.Колонки.Добавить("МестоПечати", 		Новый ОписаниеТипов("СправочникСсылка.питМестаПечати"));
	ТаблицаМаршрутизацияПечати.Колонки.Добавить("ЭлементДанных", 	Новый ОписаниеТипов("РегистрСведенийНаборЗаписей.питМаршрутизацияПечати"));
	
	Возврат ТаблицаМаршрутизацияПечати;
	
КонецФункции

// Получает цену номенклатуры.
//
// Параметры:
//	Меню      		- СправочникСсылка.ПрайсЛист. Позиция меню.
//	ДопПараметры    - Структура. Структура дополнительных параметров обмена.
//
// Возвращаемое значение:
//	Число. Цена позиции меню.
//
Функция ПолучитьЦенуНоменклатуры(ТекНоменклатура, ДопПараметры)
	
	СтруктураОтбора = Новый Структура("Номенклатура", ТекНоменклатура);
	МассивСтрок = ДопПараметры.ТаблицаЦенНоменклатуры.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() = 0 Тогда
		ТекЦена = 0;
	Иначе
		ТекЦена = МассивСтрок[0].Цена;
	КонецЕсли;
	
	Возврат ТекЦена;
	
КонецФункции

// Получает идентификатор ставки НДС по значению ссылки.
//
// Параметры:
//	 СтавкаНДС 			- СправочникСсылка.СтавкиНДС.
//   ДопПараметры    	- Структура. Структура дополнительных параметров обмена.
//
// Возвращаемое значение:
//	 Строка. Идентификатор.
//
Функция ПолучитьИДСтавкиНДС(Номенклатура, СтавкаНДС, ДопПараметры)
	
	Если НЕ ЗначениеЗаполнено(СтавкаНДС)
		И ЗначениеЗаполнено(Номенклатура) Тогда
		ТекСтавкаНДС = УчетНДСУП.СтавкаНДСНоменклатуры(Номенклатура, ДопПараметры.Организация, ТекущаяДатаСеанса());
	Иначе
		ТекСтавкаНДС = СтавкаНДС;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("СтавкаНДС", ТекСтавкаНДС);
	МассивСтрок = ДопПараметры.ТаблицаСтавокНДС.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() = 0 Тогда
		ИД = "00000000-0000-0000-0000-000000000000";
	Иначе
		ИД = МассивСтрок[0].ИД;
	КонецЕсли; 
	
	Возврат ИД;
	
КонецФункции

#КонецОбласти

// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И МЕТОДЫ
#Область СлужебныеПроцедурыИФункции

// Метод создания записи XML.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ИмяФайлаОбменаДанными - Произвольный - Знач имя файла обмена данными.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СоздатьXMLЗаписьДляОбменаДанными(УзелОбмена, Знач ИмяФайлаОбменаДанными)
	
	Если ПустаяСтрока(ИмяФайлаОбменаДанными) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	
	Попытка
		ЗаписьXML.ОткрытьФайл(ИмяФайлаОбменаДанными);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ЗаписьXML;
	
КонецФункции

// Процедура записи сообщения с измененными данными.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ЗаписатьСообщениеСИзменениями(Параметры)
	
	КэшированныеЗначения = Новый Структура;
	КэшированныеЗначения.Вставить("СоответствиеЭлементов", Новый Соответствие);
	Параметры.Вставить("КэшированныеЗначения", КэшированныеЗначения);
	Параметры.Вставить("РезультатЗаписи", Ложь);
	
	УзелОбмена = Параметры.УзелОбмена;
	ПрефиксЛога = Параметры.ПрефиксЛога;
	ТемпФайлыДляУдаления = "";
	ИмяФайлаСообщения = "";
	КаталогТемпФайлов = Параметры.КаталогТемпФайлов;
	
	// Формируем имя файла сообщения
	ИмяТемпФайла = КаталогТемпФайлов + ИмяФайлаДоставки(УзелОбмена, Истина, УзелОбмена.НомерОтправленного+1, "xml",,, Параметры.Свойство("СозданиеНачальногоОбраза"));
	ТемпФайлыДляУдаления = ТемпФайлыДляУдаления + Символы.ПС + ИмяТемпФайла;
	ЗаписьXML = Неопределено;
	КоличествоПопыток = 3;
	
	ЗафиксироватьСобытие(ПрефиксЛога + "Запись", "Начало записи файла сообщения " + """" + ИмяТемпФайла + """", УзелОбмена,УровеньЖурналаРегистрации.Информация,Параметры.Комментировать);
	Попытка
		ТекОшибка = "";
		СтрОшибки = "";
		Количество = 0;
		Пока Истина Цикл
			Если ЗаписьXML <> Неопределено Тогда
				Попытка
					ЗаписьXML.Закрыть();
				Исключение
				КонецПопытки;
				ЗаписьXML = Неопределено;
			КонецЕсли;
			Попытка
				ЗаписьXML = СоздатьXMLЗаписьДляОбменаДанными(УзелОбмена, ИмяТемпФайла);
				Если ЗаписьXML = Неопределено Тогда
					ВызватьИсключение "Не удается открыть файл для записи сообщения: """ + Строка(ИмяТемпФайла) + """";
				КонецЕсли;
				ВыгрузитьИзмененияДанныхДляУзла(УзелОбмена, Параметры, ЗаписьXML);
				Прервать;
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				СтрОшибки	= ИнфОбОшибке.Описание;
				Пока ИнфОбОшибке.Причина <> Неопределено Цикл
					ИнфОбОшибке = ИнфОбОшибке.Причина;
					СтрОшибки = СтрОшибки + Символы.ПС + ИнфОбОшибке.Описание;
				КонецЦикла;
				Параметры.Вставить("Ошибка", СтрОшибки);
				Количество = Количество + 1; 
				СтрСообщения = СтрОшибки + Символы.ВК + "(Имя модуля: " + ИнфОбОшибке.ИмяМодуля + ", " + "номер строки: " + ИнфОбОшибке.НомерСтроки + ")";
				
				Если Найти(ВРег(СтрОшибки),ВРег("Недостаточно прав")) > 0 Тогда
					ВызватьИсключение СтрСообщения;  
				КонецЕсли;
			КонецПопытки;
			
			ЗафиксироватьСобытие(ПрефиксЛога + "Запись", "Ошибка записи сообщения. Попытка № " + Количество + " : " + СтрОшибки, УзелОбмена, УровеньЖурналаРегистрации.Ошибка,Параметры.Комментировать);
			ТекОшибка = СтрОшибки;
			
			Если Количество >= КоличествоПопыток Тогда
				ВызватьИсключение "Исчерпан лимит (" + Строка(КоличествоПопыток) + ") попыток записи сообщения обмена.";
			КонецЕсли; 
			
		КонецЦикла;
			
		НомерСообщения = УзелОбмена.НомерОтправленного;
		
		Если НЕ ЗначениеЗаполнено(НомерСообщения) Тогда
			ЗафиксироватьСобытие(	ПрефиксЛога + "Запись", 
									"Не определен номер отправляемого сообщения.",
									УзелОбмена,
									УровеньЖурналаРегистрации.Ошибка,
									Параметры.Комментировать);
		ИначеЕсли НомерСообщения = 1 Тогда
			СтрСообщения = "Успешно записан файл """ + ИмяТемпФайла + """ с выгрузкой начального образа для кассового узла <" + УзелОбмена.Наименование + ">";
			ЗафиксироватьСобытие(	ПрефиксЛога + "Запись",
									СтрСообщения,
									УзелОбмена,
									УровеньЖурналаРегистрации.Информация,
									Параметры.Комментировать);
		Иначе
			СтрСообщения = "Успешно записано сообщение № " + НомерСообщения + " для узла <" + УзелОбмена.Наименование + ">  в файл """ + ИмяТемпФайла + """";
			ЗафиксироватьСобытие(	ПрефиксЛога + "Запись",
									СтрСообщения,
									УзелОбмена,
									УровеньЖурналаРегистрации.Информация,
									Параметры.Комментировать);
		КонецЕсли;
		
		ИмяФайлаСообщения = ИмяТемпФайла;
		
	Исключение
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		Параметры.Вставить("Ошибка", ТекстОшибки);
		Если Найти(ТекстОшибки,"Недостаточно прав") > 0 Тогда
			СтрСообщения = "Недостаточно прав доступа для выгрузки объектов из базы: " + Символы.ВК  + ТекстОшибки;
			СтрСообщения = СтрСообщения + Символы.ВК 
			+ "Необходимо выполнить следующие действия для записи сообщения:" + Символы.ВК
			+ "- завершить работу всех активных пользователей"  + Символы.ВК
			+ "- в режиме Конфигуратора открыть пункт меню Администрирование - Тестирование и исправление..." + Символы.ВК
			+ "- установить только галочку ""Реструктуризация таблиц информационной базы""" + Символы.ВК
			+ "- выбрать ""Только тестирование""" + Символы.ВК
			+ "- запустить тестирование" + Символы.ВК
			+ "- после тестирования повторить выгрузку сообщения." + Символы.ВК
			+ "При невозможности выполнить данные действия обратитесь к квалифицированному специалисту.";
			ЗафиксироватьСобытие(	ПрефиксЛога + "Запись", 
									СтрСообщения, 
									УзелОбмена, 
									УровеньЖурналаРегистрации.Ошибка,
									Параметры.Комментировать);
			
		Иначе	
			ЗафиксироватьСобытие(	ПрефиксЛога + "Запись", 
									"При записи сообщения возникла ошибка: " + Символы.ПС + ТекстОшибки, 
									УзелОбмена, 
									УровеньЖурналаРегистрации.Ошибка,
									Параметры.Комментировать);
		КонецЕсли; 
		Рез = Ложь;
	КонецПопытки;
	
	Для ИндСтр=1 По СтрЧислоСтрок(ТемпФайлыДляУдаления) Цикл
		ИмяФайла=СтрПолучитьСтроку(ТемпФайлыДляУдаления,ИндСтр);
		Если ПустаяСтрока(ИмяФайла) ИЛИ (Параметры.РезультатЗаписи И (ИмяФайла=ИмяТемпФайла)) Тогда
			Продолжить;
		Иначе
			Попытка	
				УдалитьФайлы(ИмяФайла);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	ЗафиксироватьСобытие(	ПрефиксЛога + "Запись", 
							"Конец записи файла сообщения " + """" + ИмяТемпФайла + """", 
							УзелОбмена,
							УровеньЖурналаРегистрации.Информация,
							Параметры.Комментировать);
	
	Параметры.Вставить("ИмяФайлаСообщения", ИмяФайлаСообщения);
	
КонецПроцедуры

// Производит выгрузку изменений для узла обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  СтруктураНастроекОбменаДанными - Структура - Структура настроек обмена данными.
//  ЗаписьXML - Произвольный - Запись xml.
//
Процедура ВыгрузитьИзмененияДанныхДляУзла(УзелОбмена, СтруктураНастроекОбменаДанными, ЗаписьXML)
	
	ДополнитьСтруктуруОбменаПриВыгрузкеПоУзлу(УзелОбмена, СтруктураНастроекОбменаДанными);
	
	// Request - начало
	ЗаписатьЗаголовокСообщения(ЗаписьXML, СтруктураНастроекОбменаДанными); 
	
	// Запись Settings.
	ЗаписатьНастройкиУзла(ЗаписьXML, УзелОбмена);
	
	// Ставки НДС выгружаются всегда.
	ЗаписатьСтавкиНДС(ЗаписьXML, СтруктураНастроекОбменаДанными);
	ЗаписатьНастройкиУчетаМаркируемойПродукции(ЗаписьXML, СтруктураНастроекОбменаДанными);
	
	// Запись всех объектов по правилам выгрузки.
	ЗаписатьИзменения(ЗаписьXML, УзелОбмена, СтруктураНастроекОбменаДанными);
	
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Request - конец
	ЗаписьXML.Закрыть();
	
	ЗаписатьРеквизитыУзлаПриВыгрузке(УзелОбмена, СтруктураНастроекОбменаДанными);
	
КонецПроцедуры // ВыгрузитьИзмененияДанныхДляУзла()

// Дополняет структуру настроек обмена настройками узла обмена.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура ДополнитьСтруктуруОбменаПриВыгрузкеПоУзлу(УзелОбмена, ДопПараметры)
	
	Реквизиты = УзелОбмена.Метаданные().Реквизиты;
	Для Каждого Реквизит Из Реквизиты Цикл
		ДопПараметры.Вставить(Реквизит.Имя, УзелОбмена[Реквизит.Имя]);
	КонецЦикла;
	
	ДопПараметры.Вставить("Получатель", 		УзелОбмена);
	ДопПараметры.Вставить("НомерОтправленного", УзелОбмена.НомерОтправленного);
	ДопПараметры.Вставить("НомерПринятого", 	УзелОбмена.НомерПринятого);
	
	ДопПараметры.Вставить("ТаблицаЦенМеню", 		ПолучитьТаблицуЦенМеню(УзелОбмена));
	
	ДопПараметры.Вставить("ТаблицаЦенНоменклатуры", ПолучитьТаблицуЦенНоменклатуры(УзелОбмена));
	
	ДопПараметры.Вставить("СоответствиеНоменклатуры", ПолучитьСоответствиеНоменклатуры(УзелОбмена, ДопПараметры));
	
	ДопПараметры.Вставить("СоответствиеТиповЦенМеню", ПолучитьСоответствиеТиповЦенМеню(ДопПараметры.ТаблицаЦенМеню));
	
	ДопПараметры.Вставить("ТаблицаДанныхСотрудников", ПолучитьТаблицуДанныхСотрудников(УзелОбмена));
	
	ДопПараметры.Вставить("ТаблицаСтавокНДС", 		ПолучитьТаблицуСтавокНДС(УзелОбмена.Организация));
	
	ДопПараметры.Вставить("ТипУдаление",			Тип("УдалениеОбъекта"));
	
	ДопПараметры.Вставить("СоответствиеИзвестнойНоменклатуры", Новый Соответствие);
	
	ЗаполнитьМассивВыгружаемыхРолейПользователейФронта(ДопПараметры);
	
КонецПроцедуры

// Функция получает данные о сотрудниках из регистра сведений "ТекущиеКадровыеДанныеСотрудников".
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Данные о сотрудниках.
Функция ПолучитьТаблицуДанныхСотрудников(УзелОбмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СотрудникиИзменения.Ссылка
	|ПОМЕСТИТЬ втСотрудники
	|ИЗ
	|	Справочник.Сотрудники.Изменения КАК СотрудникиИзменения
	|ГДЕ
	|	СотрудникиИзменения.Узел = &Узел
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация КАК Организация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение КАК Подразделение,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения КАК ДатаУвольнения,
	|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втСотрудники КАК втСотрудники
	|		ПО ТекущиеКадровыеДанныеСотрудников.Сотрудник = втСотрудники.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = ФизическиеЛица.Ссылка";
	
	Запрос.УстановитьПараметр("Узел", УзелОбмена);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Функция - Получить соответствие типов цен меню.
//
// Параметры:
//  ТаблицаЦен - ТаблицаЗначений - Таблица цен.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
Функция ПолучитьСоответствиеТиповЦенМеню(ТаблицаЦен)
	
	СоответствиеТиповЦенВидамМеню = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЦен.ВидМеню КАК ВидМеню,
	|	ТаблицаЦен.ТипЦен КАК ТипЦен
	|ПОМЕСТИТЬ ВТ_ТаблицаЦен
	|ИЗ
	|	&ТаблицаЦен КАК ТаблицаЦен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаЦен.ВидМеню КАК ВидМеню,
	|	ВТ_ТаблицаЦен.ТипЦен КАК ТипЦен
	|ИЗ
	|	ВТ_ТаблицаЦен КАК ВТ_ТаблицаЦен
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицаЦен.ВидМеню,
	|	ВТ_ТаблицаЦен.ТипЦен";
	Запрос.УстановитьПараметр("ТаблицаЦен", ТаблицаЦен);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если СоответствиеТиповЦенВидамМеню.Получить(Выборка.ВидМеню) = Неопределено Тогда
				СоответствиеТиповЦенВидамМеню.Вставить(Выборка.ВидМеню, Выборка.ТипЦен);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СоответствиеТиповЦенВидамМеню;
КонецФункции

// Функция - Получить соответствие номенклатуры.
//
// Параметры:
//  УзелОбмена - Произвольный - Узел обмена.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
Функция ПолучитьСоответствиеНоменклатуры(УзелОбмена, ДопПараметры)
	
	СоответствиеНоменклатуры = Новый Соответствие;
	
	Если ДопПараметры.Свойство("ФильтрацияВыгрузки") Тогда
		ФильтрацияВыгрузки = ДопПараметры.ФильтрацияВыгрузки;
	Иначе
		ФильтрацияВыгрузки = Неопределено;
	КонецЕсли;
	
	Если НЕ ФильтрацияВыгрузки = Неопределено И НЕ ФильтрацияВыгрузки.Свойство("Product") Тогда
		Возврат СоответствиеНоменклатуры; 
	КонецЕсли;
	
	ВидЦен = ДопПараметры.ВидЦен;
	ДанныеНаДату = ТекущаяДатаСеанса();
	Организация = ДопПараметры.Организация;
	Страна = ЗначениеНастроекКлиентСерверПовтИсп.СтранаРегистрацииОрганизации(Организация);
	
	НоменклатураИзменения = "Справочник.Номенклатура.Изменения";
	ОтборИзменения = "НоменклатураИзменения.Узел = &УзелОбмена";
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НоменклатураИзменения.Ссылка КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	&НоменклатураИзменения КАК НоменклатураИзменения
	|ГДЕ
	|	&ОтборИзменения
	|	И НЕ НоменклатураИзменения.Ссылка.ЭтоГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ОписаниеНоменклатурыИС.ВариантЧастичногоВыбытия КАК ВариантЧастичногоВыбытия,
	|	&ОпределениеВидаПродукции КАК ВидПродукцииИС
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО ВТ_Номенклатура.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	АлкогольныеИнгредиенты.Ингредиент КАК Ингредиент,
	|	АлкогольныеИнгредиенты.ГруппаАналогов КАК ГруппаАналогов,
	|	АлкогольныеИнгредиенты.КоличествоБлюда КАК КоличествоБлюда,
	|	АлкогольныеИнгредиенты.КоличествоИнгредиента КАК КоличествоИнгредиента
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.питАлкогольныеРецептуры КАК АлкогольныеИнгредиенты
	|		ПО ВТ_Номенклатура.Номенклатура = АлкогольныеИнгредиенты.Блюдо
	|ИТОГИ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция) КАК АлкогольнаяПродукция
	|ПОМЕСТИТЬ ВТ_АлкогольнаяПродукция
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|		ПО ВТ_Номенклатура.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Номенклатура.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_АлкогольнаяПродукция.Номенклатура КАК Номенклатура,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Объем КАК Объем,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Крепость КАК Крепость,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции КАК ВидПродукции,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Производитель КАК Производитель,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Импортер КАК Импортер,
	|	ВидыАлкогольнойПродукции.ВидЛицензии КАК ВидЛицензии,
	|	ВидыАлкогольнойПродукции.Код КАК КодВидаАлкогольнойПродукции,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Код КАК Код,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Наименование КАК Наименование,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.НаименованиеПолное КАК НаименованиеПолное,
	|	ВТ_АлкогольнаяПродукция.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ВЫРАЗИТЬ(ВТ_АлкогольнаяПродукция.Номенклатура КАК Справочник.Номенклатура).питПродажаВРозлив КАК ПродаетсяВРозлив
	|ИЗ
	|	ВТ_АлкогольнаяПродукция КАК ВТ_АлкогольнаяПродукция
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыАлкогольнойПродукции КАК ВидыАлкогольнойПродукции
	|			ПО КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции = ВидыАлкогольнойПродукции.Ссылка
	|		ПО ВТ_АлкогольнаяПродукция.АлкогольнаяПродукция = КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка
	|" + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ УчетПодакцизныхТоваров.ТекстЗапросаВтПодакцизныеТовары("ВТ_Номенклатура", "НаДату")
	+ ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ЕСТЬNULL(ВтПодакцизныеТовары.ПодакцизныйТовар, ЛОЖЬ)) КАК ПодакцизныйТовар
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПодакцизныеТовары КАК ВтПодакцизныеТовары
	|		ПО ВТ_Номенклатура.Номенклатура = ВтПодакцизныеТовары.Номенклатура
	|ГДЕ
	|	ВтПодакцизныеТовары.ПодакцизныйТовар = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Номенклатура.Номенклатура";
	
	Запрос.УстановитьПараметр("НаДату", ДанныеНаДату);
	Запрос.УстановитьПараметр("ВидЦенУзла", ВидЦен);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Страна", Страна);
	
	Если НЕ ФильтрацияВыгрузки = Неопределено И ФильтрацияВыгрузки.Свойство("Product") Тогда
		НоменклатураИзменения = "Справочник.Номенклатура";
		ОтборИзменения = "НоменклатураИзменения.Ссылка В (&МассивСсылок)";  
		МассивСсылок = ФильтрацияВыгрузки.Product;
		Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Иначе
		Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);		
	КонецЕсли;

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НоменклатураИзменения", НоменклатураИзменения);	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборИзменения", ОтборИзменения);
	
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(Запрос.Текст);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеПоНоменклатуре = СоответствиеНоменклатуры[Выборка.Номенклатура];
		Если ДанныеПоНоменклатуре = Неопределено Тогда
			ДанныеПоНоменклатуре = Новый Структура;
			СоответствиеНоменклатуры[Выборка.Номенклатура] = ДанныеПоНоменклатуре;
		КонецЕсли;
		
		ДанныеПоНоменклатуре.Вставить("ВариантЧастичногоВыбытия", Выборка.ВариантЧастичногоВыбытия);
		ДанныеПоНоменклатуре.Вставить("ВидПродукцииИС", Выборка.ВидПродукцииИС);
		
	КонецЦикла;
		
	Выборка = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		ДанныеПоНоменклатуре = СоответствиеНоменклатуры[Выборка.Номенклатура];
		Если ДанныеПоНоменклатуре = Неопределено Тогда
			ДанныеПоНоменклатуре = Новый Структура;
			СоответствиеНоменклатуры[Выборка.Номенклатура] = ДанныеПоНоменклатуре;
		КонецЕсли;
		
		Если НЕ ДанныеПоНоменклатуре.Свойство("СоставАлкогольнойПродукции") Тогда
			Результат = Новый ТаблицаЗначений;
			Результат.Колонки.Добавить("Ингредиент", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
			Результат.Колонки.Добавить("ГруппаАналогов", Новый ОписаниеТипов("СправочникСсылка.питМаркированныеАналоги"));
			Результат.Колонки.Добавить("КоличествоБлюда", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
			Результат.Колонки.Добавить("КоличествоИнгредиента", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));

			ДанныеПоНоменклатуре.Вставить("СоставАлкогольнойПродукции", Результат);
		КонецЕсли;
		
		ВыборкаАлкоСостав = Выборка.Выбрать();
		Пока ВыборкаАлкоСостав.Следующий() Цикл
			НоваяСтрока = ДанныеПоНоменклатуре.СоставАлкогольнойПродукции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаАлкоСостав);
		КонецЦикла;
		
	КонецЦикла;
	
	Выборка = РезультатЗапроса[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеПоНоменклатуре = СоответствиеНоменклатуры[Выборка.Номенклатура];
		Если ДанныеПоНоменклатуре = Неопределено Тогда
			ДанныеПоНоменклатуре = Новый Структура;
			СоответствиеНоменклатуры[Выборка.Номенклатура] = ДанныеПоНоменклатуре;
		КонецЕсли;
		
		ДанныеПоНоменклатуре.Вставить("АлкогольнаяПродукцияЕГАИС", Выборка.АлкогольнаяПродукция);
		ДанныеПоНоменклатуре.Вставить("ОбъемЕГАИС", Выборка.Объем);
		ДанныеПоНоменклатуре.Вставить("КрепостьЕГАИС", Выборка.Крепость);
		ДанныеПоНоменклатуре.Вставить("ВидПродукцииЕГАИС", Выборка.ВидПродукции);
		ДанныеПоНоменклатуре.Вставить("ПроизводительЕГАИС", Выборка.Производитель);
		ДанныеПоНоменклатуре.Вставить("ИмпортерЕГАИС", Выборка.Импортер);
		ДанныеПоНоменклатуре.Вставить("ВидЛицензииЕГАИС", Выборка.ВидЛицензии);
		ДанныеПоНоменклатуре.Вставить("КодАлкогольнойПродукцииЕГАИС", Выборка.Код);
		ДанныеПоНоменклатуре.Вставить("КодВидаАлкогольнойПродукцииЕГАИС", Выборка.КодВидаАлкогольнойПродукции);
		ДанныеПоНоменклатуре.Вставить("НаименованиеЕГАИС", Выборка.Наименование);
		ДанныеПоНоменклатуре.Вставить("НаименованиеПолноеЕГАИС", Выборка.НаименованиеПолное);
		ДанныеПоНоменклатуре.Вставить("ПродаетсяВРозлив", Выборка.ПродаетсяВРозлив);
		
	КонецЦикла;
	
	Выборка = РезультатЗапроса[6].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеПоНоменклатуре = СоответствиеНоменклатуры[Выборка.Номенклатура];
		Если ДанныеПоНоменклатуре = Неопределено Тогда
			ДанныеПоНоменклатуре = Новый Структура;
			СоответствиеНоменклатуры[Выборка.Номенклатура] = ДанныеПоНоменклатуре;
		КонецЕсли;
		
		ДанныеПоНоменклатуре.Вставить("ПодакцизныйТовар", Выборка.ПодакцизныйТовар);
		
	КонецЦикла;
	
	Возврат СоответствиеНоменклатуры;
КонецФункции

