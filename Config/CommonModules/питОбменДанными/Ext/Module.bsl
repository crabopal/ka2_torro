// Получает полный ИД по строке.
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//
// Возвращаемое значение:
// 	Ссылка. Ссылка объекта ИБ.
Функция ПолучитьСтрокуПоИД(Знач ИДСтрокой)
	
	Если Лев(ИДСтрокой, 1) <> "{" Тогда
		ИДСтрокой = "{" + ИДСтрокой;
	КонецЕсли;
	
	Если Прав(ИДСтрокой, 1) <> "}" Тогда
		ИДСтрокой = ИДСтрокой + "}";
	КонецЕсли;
		
	Возврат ИДСтрокой;
	
КонецФункции

// Возвращает часть строки после последнего встреченного символа в строке.
//
// Параметры:
//  ИсходнаяСтрока - Строка - Знач исходная строка.
//  СимволПоиска - Произвольный - Знач символ поиска.
//
// Возвращаемое значение:
// 	Строка. Часть строки после символа-разделителя.
Функция ПолучитьЧастьСтрокиОтделеннойСимволом(Знач ИсходнаяСтрока, Знач СимволПоиска)
	
	ПозицияСимвола = СтрДлина(ИсходнаяСтрока);
	Пока ПозицияСимвола >= 1 Цикл
		
		Если Сред(ИсходнаяСтрока, ПозицияСимвола, 1) = СимволПоиска Тогда
			
			Возврат Сред(ИсходнаяСтрока, ПозицияСимвола + 1); 
			
		КонецЕсли;
		
		ПозицияСимвола = ПозицияСимвола - 1;	
	КонецЦикла;
	
	Возврат "";
	
КонецФункции // ПолучитьЧастьСтрокиОтделеннойСимволом()

// Функция проверки существования элемента в базе.
//
// Параметры:
//  ИД - Произвольный - Ид.
//  ИмяОбъекта - Произвольный - Имя объекта.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОбъектСуществовует(ИД ,ИмяОбъекта , МенеджерОбъекта, ДопПараметры)
	
	Ссылка = ПолучитьСсылкуПоИД(ИД, МенеджерОбъекта, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Удаляет временные файлы (не сообщений) из темп-каталога обменов,
//  оставшиеся в результате сбоев обмена.
//
// Параметры:
//  НастройкаОбмена - СправочникСсылка.питНастройкиДоставкиСообщений - Настройки параметров обмена.
//  ОбработкаДоставкаСообщений - Произвольный - Обработка доставка сообщений.
//  ПрефиксЛога - Строка - Префикс лог файла из параметров обмена.
//
Процедура УдалитьВременныеФайлы(НастройкаОбмена, ОбработкаДоставкаСообщений, ПрефиксЛога)
	КорневойКаталог = НастройкаОбмена.КаталогОбменов;
	
	Если НастройкаОбмена.ИспользоватьВременныйКаталог Тогда 
		КаталогТемпФайлов = КорневойКаталог + "TEMP\";
	Иначе
		КаталогТемпФайлов = КаталогВременныхФайлов();
	КонецЕсли;
	
	// Мусор мог остаться и в самом корневом каталоге.
	МассивКаталоговВремФайлов = Новый Массив;
	МассивКаталоговВремФайлов.Добавить(КаталогТемпФайлов);
	МассивКаталоговВремФайлов.Добавить(КорневойКаталог);
	
	Для Сч = 0 По МассивКаталоговВремФайлов.ВГраница() Цикл
		КаталогТемпФайлов = МассивКаталоговВремФайлов[Сч];
		ТекстОшибки = "";
		Если НЕ ОбработкаДоставкаСообщений.ЕстьКаталог(КаталогТемпФайлов,ТекстОшибки) Тогда
			СтрОшибки = "Ошибка при удалении файлов из временного каталога <" + КаталогТемпФайлов + ">: " + ТекстОшибки;
			ЗафиксироватьСобытие(ПрефиксЛога + "УдалениеВремФайлов", СтрОшибки,,УровеньЖурналаРегистрации.Ошибка);
			Продолжить;
		КонецЕсли;
		
		МассивМасокФайлов = Новый Массив;
		МассивМасокФайлов.Добавить("_TstWRAcc_*.*");
		МассивМасокФайлов.Добавить("test_exch_*.*");
		Для Сч2 = 0 По МассивМасокФайлов.ВГраница() Цикл
			МаскаФайлов = МассивМасокФайлов[Сч2];
			УдалятьВремФайлы = Ложь;
			МассивФайлов = НайтиФайлы(КаталогТемпФайлов,МаскаФайлов);
			Если МассивФайлов.Количество()<>0 Тогда
				УдалятьВремФайлы = Истина;
			КонецЕсли;
			
			Если УдалятьВремФайлы Тогда
				ДатаУдаления = ТекущаяДата() - 3600*2; // Создали 2 часа назад
				Для Каждого ТекФайл Из МассивФайлов Цикл
					Попытка
						Если ТекФайл.ПолучитьВремяИзменения() > ДатаУдаления Тогда
							Продолжить;
						КонецЕсли;
						УдалитьФайлы(ТекФайл.ПолноеИмя);
					Исключение КонецПопытки;
				КонецЦикла;
			КонецЕсли; 
		КонецЦикла;
		
	КонецЦикла; // Для Сч = 0
	
КонецПроцедуры

// Формирует таблицу соответствия ставок НДС и идентификаторов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуСтавокНДС(Организация)
	
	ТаблицаСтавокНДС = Новый ТаблицаЗначений;
	ТаблицаСтавокНДС.Колонки.Добавить("СтавкаНДС", 	Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТаблицаСтавокНДС.Колонки.Добавить("ИД", 		ОбщегоНазначения.ОписаниеТипаСтрока(40));
	ТаблицаСтавокНДС.Колонки.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(40));
	ТаблицаСтавокНДС.Колонки.Добавить("Значение", 	ОбщегоНазначения.ОписаниеТипаЧисло(5, 2));
	ТаблицаСтавокНДС.Колонки.Добавить("Активность", Новый ОписаниеТипов("Булево"));
	
	АктуальнаяОсновнаяСтавка = УчетНДСУП.СтавкаНДСПоУмолчанию(Организация, ТекущаяДатаСеанса());
	
	// 18%
	НоваяСтрока = ТаблицаСтавокНДС.Добавить();
	Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		НоваяСтрока.СтавкаНДС 	= УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС18);
	Иначе
		НоваяСтрока.СтавкаНДС 	= питОбщегоНазначения.СтавкаНДСПоЧислу(18);
	КонецЕсли;
	НоваяСтрока.ИД 			= "a1551715-8556-4846-a6da-d53347c53326";
	НоваяСтрока.Наименование= "18%";
	НоваяСтрока.Значение 	= 18;
	
	// 10%
	НоваяСтрока = ТаблицаСтавокНДС.Добавить();
	Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		НоваяСтрока.СтавкаНДС 	= УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС10);
	Иначе
		НоваяСтрока.СтавкаНДС 	= питОбщегоНазначения.СтавкаНДСПоЧислу(10);
