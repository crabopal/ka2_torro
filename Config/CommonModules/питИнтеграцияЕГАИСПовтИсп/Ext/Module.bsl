
#Область ПрограммныйИнтерфейс

// Возвращает префикс переданного пространства имен.
//
// Параметры:
//  ПространствоИмен - Произвольный - Пространство имен.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПрефиксПространстваИмен(ПространствоИмен) Экспорт
	
	Если ВРег(ПространствоИмен) = ВРег("http://fsrar.ru/WEGAIS/RepProducedProduct") 
		ИЛИ ВРег(ПространствоИмен) = ВРег("http://fsrar.ru/WEGAIS/RepProducedProduct_v3") 
		ИЛИ ВРег(ПространствоИмен) = ВРег("http://fsrar.ru/WEGAIS/RepProducedProduct_v4")   Тогда
		Возврат "rpp";
	ИначеЕсли ВРег(ПространствоИмен) = ВРег("http://fsrar.ru/WEGAIS/RequestAddProducts") Тогда
		Возврат "raddp";
	ИначеЕсли ВРег(ПространствоИмен) = ВРег("http://fsrar.ru/WEGAIS/QueryRejectRepProduced") Тогда
		Возврат "qrrp";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

