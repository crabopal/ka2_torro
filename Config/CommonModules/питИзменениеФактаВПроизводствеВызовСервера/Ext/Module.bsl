#Область ПрограммныйИнтерфейс

//  Процедура - Ингредиенты ингредиент при изменении на сервере.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//  ПараметрыОбъекта - Произвольный - Параметры объекта.
//
Процедура ИнгредиентыИнгредиентПриИзмененииНаСервере(СтрокаТабличнойЧасти, ПараметрыОбъекта) Экспорт
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТабличнойЧасти.Ингредиент, "питВидНоменклатуры");
	СтрокаТабличнойЧасти.ЭтоБлюдо = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо);
	Если СтрокаТабличнойЧасти.ЭтоБлюдо Тогда
		ДатаРецептуры = ?(ЗначениеЗаполнено(ПараметрыОбъекта.Ссылка), ПараметрыОбъекта.Дата, КонецДня(ПараметрыОбъекта.Дата));
		СтрокаТабличнойЧасти.РецептураАвтопередела = питПроизводство.ВернутьОсновнуюРецептуру(СтрокаТабличнойЧасти.Ингредиент,СтрокаТабличнойЧасти.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
			ДатаРецептуры, ПараметрыОбъекта.СпособРасчетаРецептуры, , ПараметрыОбъекта.Организация,,,ПараметрыОбъекта.Подразделение);
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.РецептураАвтопередела) И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтатьяКалькуляции) Тогда
			СтрокаТабличнойЧасти.СтатьяКалькуляции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТабличнойЧасти.РецептураАвтопередела, "СтатьяКалькуляции");
		КонецЕсли;
	Иначе
		СтрокаТабличнойЧасти.РецептураАвтопередела = Неопределено;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.ПриготовлениеРазрешено = питПроизводствоПовтИсп.ПодразделениеРазрешено(СтрокаТабличнойЧасти.РецептураАвтопередела, ПараметрыОбъекта.Подразделение, ПараметрыОбъекта.Склад);
	СтрокаТабличнойЧасти.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(РеквизитыНоменклатуры.питВидНоменклатуры, СтрокаТабличнойЧасти.Специя, СтрокаТабличнойЧасти.ПриготовлениеРазрешено);
	
	СтрокаТабличнойЧасти.ИзАвтопеределов = Ложь;
	Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.РецептураАвтопередела) И СтрокаТабличнойЧасти.ПриготовлениеРазрешено Тогда
		СтрокаТабличнойЧасти.ИзАвтопеределов = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация
#Область СлужебныеПроцедурыИФункции
#КонецОбласти
#КонецОбласти


