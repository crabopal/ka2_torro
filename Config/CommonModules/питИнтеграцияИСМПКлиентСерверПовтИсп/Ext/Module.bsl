// Функция - Преобразователь по значению
//
// Параметры:
//  Значение - СправочникСсылка.КлючиВидовПродукцииИС - Входное значение.
// 
// Возвращаемое значение:
//  Массив - СправочникСсылка.ВидыПродукцииИС
//
Функция ВидыПродукцииПоКлючу(КлючПродукции) Экспорт
	Результат = КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииКлюча(КлючПродукции);
	Возврат Результат;
КонецФункции

// Функция - Преобразователь по значению
//
// Параметры:
//  Значение - СправочникСсылка.КлючиВидовПродукцииИС,
//                 СправочникСсылка.ВидыПродукцииИС,
//                 ПеречислениеСсылка.ВидыПродукцииИС - Входное значение.
// 
// Возвращаемое значение:
//  Массив - СправочникСсылка.ВидыПродукцииИС
//
Функция ВидыПродукцииПоЗначению(Значение) Экспорт
	
	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.КлючиВидовПродукцииИС") Тогда
		Результат = ВидыПродукцииПоКлючу(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("ПеречислениеСсылка.ВидыПродукцииИС") Тогда
		Результат = ВидыПродукцииПоПеречислению(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ВидыПродукцииИС") Тогда
		Результат.Добавить(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ТоварныеГруппыГИСМТ") Тогда
		Результат = КонструкторИСМПОбщегоНазначенияКлиентСервер.ВидыПродукции(Значение)
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВидПродукцииПеречислениемПоСсылке(ЗначениеПеречисления) Экспорт
	Результат = питИнтеграцияИСМП.ВидПродукцииПеречислениемПоСсылке(ЗначениеПеречисления);
	Возврат Результат;
КонецФункции

Функция ВидПродукцииВходитВДоступные(ВидыПродукцииДоступные, ВидПродукции) Экспорт
	
	Если ТипЗнч(ВидПродукции) = Тип("СправочникСсылка.КлючиВидовПродукцииИС") Тогда
		ВидыПродукцииИС = ВидыПродукцииПоКлючу(ВидПродукции);
		
		Результат = Ложь;
		Для Каждого ТекВидПродкции Из ВидыПродукцииИС Цикл
			Если ВидыПродукцииДоступные.Найти(ТекВидПродкции) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Результат = Истина;
			Прервать;
		КонецЦикла;
	Иначе
		Результат = НЕ ВидыПродукцииДоступные.Найти(ВидПродукции) = Неопределено;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции


Функция ЭтоВидПродукцииДоступныйДляОтраженияОстатковИС(ВидПродукции) Экспорт
	
	ВидыПродукцииДоступные = питИнтеграцияИСМП.ВидыПродукцииДоступныеДляОтраженияОстатковИС(
		НЕ ТипЗнч(ВидПродукции) = Тип("ПеречислениеСсылка.ВидыПродукцииИС"));
		
	Результат = ВидПродукцииВходитВДоступные(ВидыПродукцииДоступные, ВидПродукции);
	
	Возврат Результат;
	
КонецФункции


// Функция - Это вид продукции пива.
//
// Параметры:
//  ВидПродукции - Произвольный - Вид продукции.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ЭтоВидПродукцииПива(ВидПродукции) Экспорт
	
	ВидыПродукцииДоступные = ВидыПродукцииПива(
		НЕ ТипЗнч(ВидПродукции) = Тип("ПеречислениеСсылка.ВидыПродукцииИС"));
		
	Результат = ВидПродукцииВходитВДоступные(ВидыПродукцииДоступные, ВидПродукции);
	
	Возврат Результат;
	
КонецФункции

