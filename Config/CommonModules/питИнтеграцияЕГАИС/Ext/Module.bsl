
#Область ПрограммныйИнтерфейс

// Проверяет соответствие типа ЕГАИС и передаваемого документа.
//
// Параметры:
//  ДокументСсылка - Произвольный - Документ ссылка.
//  ТипЕГАИС - Произвольный - Тип егаис.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДокументСоответствуетТипуЕГАИС(ДокументСсылка, ТипЕГАИС) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.питДобавлениеНовойПродукцииЕГАИС") Тогда
		
		Возврат ВРег(ТипЕГАИС) = ВРег("RequestAddProducts");
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

// Возвращает таблицу соответствия вида документа и версии формата строковому типу ЕГАИС.
//
// Параметры:
//  Таблица - ТаблицаЗначений - Таблица.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица с колонками:
//   * ТипЕГАИС - Строка - Строковый тип ЕГАИС.
//   * ВидДокументаЕГАИС - ПеречислениеСсылка.ВидыДокументовЕГАИС - Операция.
//   * ФорматОбмена - ПеречислениеСсылка.ФорматыОбменаЕГАИС - Формат обмена.
Функция ДобавитьВТаблицуСоответствияДокументовТипамЕГАИС(Таблица) Экспорт
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = ("RepProducedProduct");
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V1;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питОтчетОПроизводствеПродукции;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = ("RepProducedProduct_v3");
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V3;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питОтчетОПроизводствеПродукции;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = ("RepProducedProduct_v4");
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V4;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питОтчетОПроизводствеПродукции;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = ("RequestAddProducts");
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V3;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питЗапросНаДобавлениеПродукции;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = ("RequestAddProducts");
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V2;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питЗапросНаДобавлениеПродукции;
	
	// ++[Производные типы]
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = ("RepInformF1Reg");
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V3;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питКвитанцияОРегистрацииСправок1ОтчетаОПроизводстве;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = ("RepInformF1Reg");
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V2;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питКвитанцияОРегистрацииСправок1ОтчетаОПроизводстве;
	
	// Остатки ЕГАИС в мл
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = "QueryRestBCode";
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V4;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл;
	НоваяСтрока.ПространствоИмен  = "QueryParameters";
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипЕГАИС = "ReplyRestBCode_v2";
	НоваяСтрока.ФорматОбмена      = Перечисления.ФорматыОбменаЕГАИС.V4;
	НоваяСтрока.ВидДокументаЕГАИС = Перечисления.ВидыДокументовЕГАИС.питОтветНаЗапросОтчетаОстаткиВРегистре3ПоМл;
	
КонецФункции

// Процедура - Записать соответствие номенклатуры.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//  ЗаписыватьСправку2 - Произвольный - Записывать справку 2.
//  СопоставлятьПоИдентификаторуУпаковки - Произвольный - Сопоставлять по идентификатору упаковки.
//  СопоставлятьПоСерии - Произвольный - Сопоставлять по серии.
//
Процедура ЗаписатьСоответствиеНоменклатуры(ДокументОбъект, ЗаписыватьСправку2 = Ложь, 
	СопоставлятьПоИдентификаторуУпаковки = Ложь, СопоставлятьПоСерии = Истина) Экспорт
	
	ИмяКолонки = "АлкогольнаяПродукция";
	КолонкиДляВыгрузки = ИмяКолонки + ", " + "Номенклатура, Характеристика";
	Если СопоставлятьПоСерии Тогда
		КолонкиДляВыгрузки = КолонкиДляВыгрузки + ", Серия";
	КонецЕсли;
	Если СопоставлятьПоИдентификаторуУпаковки Тогда
		КолонкиДляВыгрузки = КолонкиДляВыгрузки + ", ИдентификаторУпаковки";
	КонецЕсли;
	Если ЗаписыватьСправку2 Тогда
		КолонкиДляВыгрузки = КолонкиДляВыгрузки + ", Справка2";
	КонецЕсли;
	Данные = ДокументОбъект.Товары.Выгрузить(, КолонкиДляВыгрузки);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	&ИмяКолонкиАлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	&ИмяКолонкиСерия КАК Серия,
	|	&ИмяКолонкиИдентификаторУпаковки КАК ИдентификаторУпаковки,
	|	&ИмяКолонкиСправка2 КАК Справка2
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Таблица КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Серия КАК Серия,
	|	Таблица.ИдентификаторУпаковки КАК ИдентификаторУпаковки,
	|	Таблица.Справка2 КАК Справка2,
	|	Сопоставлено.АлкогольнаяПродукция КАК Сопоставлено,
	|	МАКСИМУМ(ЕСТЬNULL(Сопоставлено.Порядок, ЕСТЬNULL(СопоставленоБЕЗСерии.Порядок, 0))) КАК Порядок
	|ИЗ
	|	Таблица КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК Сопоставлено
	|		ПО (Сопоставлено.Номенклатура = Таблица.Номенклатура)
	|			И (Сопоставлено.Характеристика = Таблица.Характеристика)
	|			И (Сопоставлено.ИдентификаторУпаковки = Таблица.ИдентификаторУпаковки)
	|			И (Сопоставлено.Справка2 = Таблица.Справка2)
	|			И (Сопоставлено.Серия = Таблица.Серия)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СопоставленоБЕЗСерии
	|		ПО (СопоставленоБЕЗСерии.Номенклатура = Таблица.Номенклатура)
	|			И (СопоставленоБЕЗСерии.Характеристика = Таблица.Характеристика)
	|			И (СопоставленоБЕЗСерии.ИдентификаторУпаковки = Таблица.ИдентификаторУпаковки)
	|			И (СопоставленоБЕЗСерии.Справка2 = Таблица.Справка2)
	|ГДЕ
	|	Таблица.АлкогольнаяПродукция <> ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)
	|	И Таблица.Номенклатура <> &ПустаяСсылкаНоменклатура
	|	И Сопоставлено.АлкогольнаяПродукция ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.АлкогольнаяПродукция,
	|	Таблица.Номенклатура,
	|	Таблица.Характеристика,
	|	Таблица.Серия,
	|	Таблица.ИдентификаторУпаковки,
	|	Таблица.Справка2,
	|	Сопоставлено.АлкогольнаяПродукция");
	
	Запрос.УстановитьПараметр("Таблица", Данные);
	Запрос.УстановитьПараметр("ПустаяСсылкаНоменклатура", ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("Номенклатура"));
	Запрос.УстановитьПараметр("ПустаяСтрока",             "");
	Запрос.УстановитьПараметр("ПустаяСправка2",           Справочники.Справки2ЕГАИС.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяСерия",              ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры"));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяКолонкиАлкогольнаяПродукция", ИмяКолонки);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ИмяКолонкиИдентификаторУпаковки",
		?(СопоставлятьПоИдентификаторуУпаковки, "Т.ИдентификаторУпаковки", "&ПустаяСтрока"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ИмяКолонкиСерия",
		?(СопоставлятьПоСерии, "Т.Серия", "&ПустаяСерия"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ИмяКолонкиСправка2",
		?(ЗаписыватьСправку2, "Т.Справка2", "&ПустаяСправка2"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.СоответствиеНоменклатурыЕГАИС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(Выборка.Номенклатура, Истина);
		НаборЗаписей.Отбор.Характеристика.Установить(Выборка.Характеристика, Истина);
		НаборЗаписей.Отбор.Серия.Установить(Выборка.Серия, Истина);
		НаборЗаписей.Отбор.АлкогольнаяПродукция.Установить(Выборка.АлкогольнаяПродукция, Истина);
		НаборЗаписей.Отбор.ИдентификаторУпаковки.Установить(Выборка.ИдентификаторУпаковки, Истина);
		НаборЗаписей.Отбор.Справка2.Установить(Выборка.Справка2, Истина);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Номенклатура          = Выборка.Номенклатура;
		НоваяЗапись.Характеристика        = Выборка.Характеристика;
		НоваяЗапись.Серия                 = Выборка.Серия;
		НоваяЗапись.АлкогольнаяПродукция  = Выборка.АлкогольнаяПродукция;
		НоваяЗапись.ИдентификаторУпаковки = Выборка.ИдентификаторУпаковки;
		НоваяЗапись.Справка2              = Выборка.Справка2;
		НоваяЗапись.Порядок               = Выборка.Порядок + 1;
	
		Попытка
			НаборЗаписей.Записать();
		Исключение
			
			ТекстОшибки = НСтр("ru = 'При записи соответствия номенклатуры произошла ошибка:
			                         |%1'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(ТекстОшибки, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			
			ОбщегоНазначенияЕГАИСВызовСервера.ЗаписатьОшибкуВЖурналРегистрации(
				СтрШаблон(ТекстОшибки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Загружает переданный документ, полученных из УТМ.
//
// Параметры:
//  ДанныеДокумента - Произвольный - Данные документа.
//  ОрганизацияЕГАИС - Произвольный - Организация егаис.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * Изменения - Массив - Массив структур, см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения().
Функция ДанныеЗагруженногоДокумента(ДанныеДокумента, ОрганизацияЕГАИС, ДополнительныеПараметры) Экспорт
	
	Если ДанныеДокумента.Операция = Перечисления.ВидыДокументовЕГАИС.питКвитанцияОРегистрацииСправок1ОтчетаОПроизводстве Тогда
		
		ДанныеЗагруженногоДокумента = питИнтеграцияЕГАИС.ЗагрузитьВходящуюСправку1(ДанныеДокумента, ОрганизацияЕГАИС, ДополнительныеПараметры);
		
	ИначеЕсли ДанныеДокумента.Операция = Перечисления.ВидыДокументовЕГАИС.питОтветНаЗапросОтчетаОстаткиВРегистре3ПоМл Тогда
		
		ДанныеЗагруженногоДокумента = питЗагрузитьОтветНаЗапросОтчетаОстаткиВРегистре3ВМл(
			ДанныеДокумента, ОрганизацияЕГАИС, ДополнительныеПараметры);
		
	Иначе
		
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный тип загружаемого документа %1.';
													|en = 'Неизвестный тип загружаемого документа %1.'"), ДанныеДокумента.ТипЕГАИС);
		
	КонецЕсли;
	
	Возврат ДанныеЗагруженногоДокумента;
	
КонецФункции

// Функция ЗагрузитьВходящуюСправку1(ОбъектXDTO, ДополнительныеПараметры, Результат, ДокОснование) Экспорт
//
// Параметры:
//  ДанныеДокумента			 - Структура	 - Данные документа
//  ОрганизацияЕГАИС		 - СправочникСсылка.КлассификаторОрганизацийЕГАИС - Организация ЕГАИС.
//  ДополнительныеПараметры	 - Структура	 - Дополнительные параметры
// 
// Возвращаемое значение:
//  Структура - результат
//
Функция ЗагрузитьВходящуюСправку1(ДанныеДокумента, ОрганизацияЕГАИС, ДополнительныеПараметры) Экспорт
	
	//РезультатОп = Новый Структура("Результат, ОписаниеОшибки, ПолученОтказ, ДокументОснование, ВидДокумента", Истина, "", Ложь);
	ВозвращаемоеЗначение = ОбменДаннымиЕГАИСКлиентСервер.СтруктураИзменения();
	
	ОбъектXDTO = ДанныеДокумента.Объект;
	
	ТекстОшибки = "";
	ШапкаXDTO = ОбъектXDTO.Header;//Document.RepInformF1Reg.Header;
	// ид отчета
	ИДОтчета = ШапкаXDTO.Identity;
	ИДПрисвоенный = ШапкаXDTO.RepRegId;
	//ОрганизацияОтправительОтчета = ЗагрузитьОрганизацию(ШапкаXDTO.Client, ДополнительныеПараметры, ТекстОшибки);//ШапкаXDTO.Client;
	ОрганизацияОтправительОтчета = ИнтеграцияЕГАИС.ЗагрузитьОрганизацию(ШапкаXDTO.Client);
	
	ДокОтчетОПроизводстве = Документы.питВыпускПродукцииЕГАИС.ДокументОтчетОПроизводствеПоИдентификатору(ИДПрисвоенный);//ИДПрисвоенный);
	
	Если НЕ ЗначениеЗаполнено(ДокОтчетОПроизводстве) Тогда
		
		Попытка
			ИдентификаторОтчета = Новый УникальныйИдентификатор(ИДОтчета);
		Исключение
			ВозвращаемоеЗначение.ТекстОшибки = НСтр("ru = 'Некорректный идентификатор отчета о производстве %1.'") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ВозвращаемоеЗначение.ТекстОшибки = СтрЗаменить(ВозвращаемоеЗначение.ТекстОшибки, "%1", ИДОтчета);
			//РезультатОп.ПолученОтказ = Истина;
			Возврат ВозвращаемоеЗначение;
		КонецПопытки;
		
		ДокОтчетОПроизводстве = Документы.питВыпускПродукцииЕГАИС.ПолучитьСсылку(ИдентификаторОтчета);
		ОтчетОбъект = ДокОтчетОПроизводстве.ПолучитьОбъект();
		//Если ОтчетОбъект = Неопределено Тогда
		//	ДокОтчетОПроизводстве = ДокОснование;
		//	ОтчетОбъект = ДокОтчетОПроизводстве.ПолучитьОбъект();
		//КонецЕсли;
		
		Если ОтчетОбъект = Неопределено Тогда
			ВозвращаемоеЗначение.ТекстОшибки = НСтр("ru = 'Неизвестный идентификатор отчета о производстве %1.'");
			ВозвращаемоеЗначение.ТекстОшибки = СтрЗаменить(ВозвращаемоеЗначение.ТекстОшибки, "%1", ИдентификаторОтчета);
			////РезультатОп.ПолученОтказ = Истина;
			//Возврат ВозвращаемоеЗначение;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВозвращаемоеЗначение.ТекстОшибки) Тогда
	
		Если НЕ ЗначениеЗаполнено(ДокОтчетОПроизводстве) Тогда
			ВозвращаемоеЗначение.ТекстОшибки = НСтр("ru = 'Не найден Отчет о производстве с идентификатором %1.'");
			ВозвращаемоеЗначение.ТекстОшибки = СтрЗаменить(ВозвращаемоеЗначение.ТекстОшибки, "%1", ИДОтчета);
			////РезультатОп.ПолученОтказ = Истина;
			//Возврат ВозвращаемоеЗначение;
		КонецЕсли;
		
		//РезультатОп.ДокументОснование = ДокОтчетОПроизводстве;
		//РезультатОп.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.ОтчетОПроизводствеПродукции;
		Если НЕ ЗначениеЗаполнено(ВозвращаемоеЗначение.ТекстОшибки) Тогда
			ДокОбъект = ДокОтчетОПроизводстве.ПолучитьОбъект();
			Если НЕ ЗначениеЗаполнено(ДокОбъект.ИдентификаторЕГАИС) Тогда
				ДокОбъект.ИдентификаторЕГАИС = ОбъектXDTO.Header.RepRegId;
			КонецЕсли;
			// получим ИДшники справок 1 и 2 из контента
			Для Каждого ЭлементСодержимого Из ОбъектXDTO.Content.Position Цикл
				// позиция скорее всего будет только 1, но цикл лучше сделаем
				РегНомерСправки1 = ЭлементСодержимого.InformF1RegId;
				РегНомерСправки2 = ЭлементСодержимого.InformF2RegId;
				
				Если НЕ ДокОтчетОПроизводстве = Неопределено Тогда
					// Создадим справки на основании данных документа, а затем еще запросим их 
					ТЧПроизводство = ДокОтчетОПроизводстве.Производство;
					Для каждого ПроизводимыйАП Из ТЧПроизводство Цикл
						
						// справка 1
						НоваяСпрА = Справочники.Справки1ЕГАИС.СоздатьЭлемент();
						НоваяСпрА.РегистрационныйНомер = РегНомерСправки1;
						НоваяСпрА.АлкогольнаяПродукция = ПроизводимыйАП.АлкогольнаяПродукция;
						НоваяСпрА.ДатаРозлива = ДокОтчетОПроизводстве.ДатаПроизводства;
						НоваяСпрА.Количество = ПроизводимыйАП.Количество;
						// эти реквизиты заранее не можем знать, после перезапроса справок они заполнятся
						//НоваяСпрА.НомерПодтвержденияЕГАИС = 
						//НоваяСпрА.ДатаПодтвержденияЕГАИС = 
						Попытка НоваяСпрА.Записать(); Исключение НоваяСпрА = Справочники.Справки1ЕГАИС.ПустаяСсылка(); КонецПопытки;
						
						// справка 2
						НоваяСпрБ = Справочники.Справки2ЕГАИС.СоздатьЭлемент();
						НоваяСпрБ.РегистрационныйНомер = РегНомерСправки2;
						НоваяСпрБ.АлкогольнаяПродукция = ПроизводимыйАП.АлкогольнаяПродукция;
						НоваяСпрБ.НомерСправки1 = РегНомерСправки1;
						НоваяСпрБ.Справка1 = НоваяСпрА.Ссылка;
						НоваяСпрБ.ДокументОснование = ДокОтчетОПроизводстве;
						НоваяСпрБ.Количество = ПроизводимыйАП.Количество;
						// эти реквизиты заранее не можем знать, после перезапроса справок они заполнятся
						//НоваяСпрБ.НомерПодтвержденияЕГАИС = 
						//НоваяСпрБ.ДатаПодтвержденияЕГАИС = 
						Попытка НоваяСпрБ.Записать(); Исключение НоваяСпрБ = Справочники.Справки2ЕГАИС.ПустаяСсылка(); КонецПопытки;
						
						СтрокаТЧ = ДокОбъект.Производство.Найти(ПроизводимыйАП.АлкогольнаяПродукция, "АлкогольнаяПродукция");
						Если НЕ СтрокаТЧ = Неопределено Тогда
							СтрокаТЧ.Справка2 = НоваяСпрБ.Ссылка; 
						КонецЕсли;
					КонецЦикла;
					
					ПОпытка 
						ДокОбъект.Записать();
					Исключение 
						ВозвращаемоеЗначение.ТекстОшибки = НСтр("ru = 'Не удалось записать исходный Отчет о производстве'");
						////РезультатОп.ПолученОтказ = Истина;
						//Возврат ВозвращаемоеЗначение;
					КонецПопытки;
					
				КонецЕсли;
				
				
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;	
	//Возврат РезультатОп;
	// новая стр возврата:
	//ВозвращаемоеЗначение = ОбменДаннымиЕГАИСКлиентСервер.СтруктураИзменения();
	
	ВозвращаемоеЗначение.ОрганизацияЕГАИС = ОрганизацияЕГАИС;
	ВозвращаемоеЗначение.Операция         = ДанныеДокумента.Операция;
	ВозвращаемоеЗначение.ФорматОбмена     = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = Неопределено;//ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = Неопределено;//РезультатДобавленияЗаписи.Ссылка;
	
	ВозвращаемоеЗначение.Объект            = Неопределено;//Ссылка;
	ВозвращаемоеЗначение.ДокументОснование = ДокОтчетОПроизводстве.Ссылка;
	ВозвращаемоеЗначение.НовыйСтатус       = Неопределено;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ОрганизацияЕГАИС,
			ДанныеДокумента.Операция,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Загружает данные отчета Остатки в регистре №3 в разрезе мл в базу данных.
//
// Параметры:
//  ДанныеДокумента - Структура - Данные документа
//  ОрганизацияЕГАИС - СправочникСсылка.КлассификаторОрганизацийЕГАИС - Организация ЕГАИС
//  ДополнительныеПараметры - Неопределено - Дополнительные параметры
// 
// Возвращаемое значение:
//  см. ОбменДаннымиЕГАИСКлиентСервер.СтруктураИзменения
Функция питЗагрузитьОтветНаЗапросОтчетаОстаткиВРегистре3ВМл(ДанныеДокумента, ОрганизацияЕГАИС, ДополнительныеПараметры = Неопределено) Экспорт
	
	РезультатПоиска = ИнтеграцияЕГАИС.НайтиОбъектПоИдентификаторуЗапроса(
		ДанныеДокумента.ИдентификаторЗапроса, Ложь);
	
	Если РезультатПоиска = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке данных отчета ЕГАИС (Остатки в регистре №3 по мл в Общепите):
			           |Не найден документ с идентификатором запроса %1.'"),
			ДанныеДокумента.ИдентификаторЗапроса);
		
	КонецЕсли;
	
	Если ДополнительныеПараметры <> Неопределено Тогда
		
		Если ДополнительныеПараметры.СтопЛист.Получить(РезультатПоиска.Ссылка) <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДополнительныеПараметры.ТекущийОбъект = РезультатПоиска.Ссылка;
		
	КонецЕсли;
	
	ИсходящееСообщение = Неопределено;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ТипыЗапросовИС.Входящий);
	Реквизиты.Вставить("Операция",             ДанныеДокумента.Операция);
	Реквизиты.Вставить("Документ",             РезультатПоиска.Ссылка);
	Реквизиты.Вставить("СообщениеОснование",   ИсходящееСообщение);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получены данные отчета ""Остатки в регистре №3 в мл""'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ОрганизацияЕГАИС",     ОрганизацияЕГАИС);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус   = Неопределено;
	ОбъектИзменен = Ложь;
	
	РезультатДобавленияЗаписи = ОбменДаннымиЕГАИС.ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДокументОбъект = РезультатПоиска.Ссылка.ПолучитьОбъект();
		
		// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
		// Документ будет получен в следующий итерации загрузки данных.
		ДокументОбъект.Заблокировать();
		
		ДокументОбъект.Дата = ДанныеДокумента.Объект.RestsDate;
		ДокументОбъект.АкцизныеМарки.Очистить();
		
		Если ДанныеДокумента.Объект.MarkInfo <> Неопределено Тогда
			
			Для Каждого ЭлементДанных Из ДанныеДокумента.Объект.MarkInfo Цикл
				
				Для Каждого КодАкцизнойМарки Из ЭлементДанных.amccat Цикл
					
					СтрокаТЧ = ДокументОбъект.АкцизныеМарки.Добавить();
					СтрокаТЧ.КодАкцизнойМарки = КодАкцизнойМарки.amc; 
					СтрокаТЧ.питОбъемВМл = КодАкцизнойМарки.amcvol; 
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ПараметрыОбновленияСтатуса = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект       = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки      = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ФорматОбмена         = РезультатПоиска.ФорматОбмена;
		
		ПолноеИмя = ДокументОбъект.Ссылка.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначенияИС.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(
			ДокументОбъект.Ссылка, ДанныеДокумента.Операция,
			ПараметрыОбновленияСтатуса);
		
		ДокументОбъект.Записать(РежимЗаписи(ДокументОбъект));
		ОбъектИзменен = Истина;
		
		ЕстьОшибки = Документы.ОтчетЕГАИС.ЕстьРасхожденияВПолученныхДанных(ДокументОбъект.ВидДокумента, ДокументОбъект.Ссылка);
		Если ЕстьОшибки Тогда
			
			ПараметрыОбновленияСтатуса = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
			ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Ложь;
			ПараметрыОбновленияСтатуса.ДокументОбъект       = ДокументОбъект;
			ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = ДанныеДокумента.ИдентификаторЗапроса;
			ПараметрыОбновленияСтатуса.СтатусОбработки      = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
			ПараметрыОбновленияСтатуса.ФорматОбмена         = РезультатПоиска.ФорматОбмена;
			
			НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(
				ДокументОбъект.Ссылка, ДанныеДокумента.Операция,
				ПараметрыОбновленияСтатуса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ОбменДаннымиЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ОрганизацияЕГАИС = ОрганизацияЕГАИС;
	ВозвращаемоеЗначение.Операция         = ДанныеДокумента.Операция;
	ВозвращаемоеЗначение.ФорматОбмена     = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = РезультатДобавленияЗаписи.Ссылка;
	
	ВозвращаемоеЗначение.Объект            = ДокументОбъект.Ссылка;
	ВозвращаемоеЗначение.ДокументОснование = Неопределено;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ОрганизацияЕГАИС,
			ДанныеДокумента.Операция,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Процедура - Категории операций
//
// Параметры:
//  ПолучениеДанных - Соответствие Из ПеречислениеСсылка.ВидыДокументовЕГАИС - Операции получения данных.
//
Процедура КатегорииОпераций(ПолучениеДанных) Экспорт
	
	ПолучениеДанных.Вставить(
		Перечисления.ВидыДокументовЕГАИС.питОтветНаЗапросОтчетаОстаткиВРегистре3ПоМл,
		НСтр("ru = 'Получение отчета ""Остатки в регистре №3 в мл (Общепит)""';
			|en = 'Получение отчета ""Остатки в регистре №3 в мл (Общепит)""'"));
	
КонецПроцедуры

Функция СтатусПослеПолученияДанных(ДокументСсылка, Операция, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Операция = Перечисления.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл
		Или Операция = Перечисления.ВидыДокументовЕГАИС.питОтветНаЗапросОтчетаОстаткиВРегистре3ПоМл Тогда
		
		СтатусыБазовыйПроцесс = РегистрыСведений.СтатусыДокументовЕГАИС.СтруктураСтатусы();
		СтатусыБазовыйПроцесс.Принят = Перечисления.СтатусыОбработкиОтчетаЕГАИС.ПолученОтчет;
		СтатусыБазовыйПроцесс.Ошибка = Перечисления.СтатусыОбработкиОтчетаЕГАИС.ПолученОтчет;
		СтатусыБазовыйПроцесс.ОшибкаДействия.Добавить(Перечисления.ДальнейшиеДействияПоВзаимодействиюЕГАИС.НеТребуется);
		
		Если Операция = Перечисления.ВидыДокументовЕГАИС.питОтветНаЗапросОтчетаОстаткиВРегистре3ПоМл Тогда
			СтатусыБазовыйПроцесс.ОшибкаДействия.Добавить(Перечисления.ДальнейшиеДействияПоВзаимодействиюЕГАИС.НеТребуется);
		КонецЕсли;
		
		Если ДополнительныеПараметры <> Неопределено
			И ДополнительныеПараметры.Свойство("СтатусОбработки") Тогда
			СтатусОбработки = ДополнительныеПараметры.СтатусОбработки;
		Иначе
			СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС;
		КонецЕсли;
		
		ПараметрыОбновления = РегистрыСведений.СтатусыДокументовЕГАИС.РассчитатьСтатусы(
			ДокументСсылка,
			СтатусОбработки,
			СтатусыБазовыйПроцесс);
	
		Возврат ПараметрыОбновления;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Функция получает остаток по марке ИС.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - Организация марки.
//  ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров - Штрихкод марки.
//  НаДату - Дата - Дата получения остатка.
//
// Возвращаемое значение:
//  Число - Количество остатка.
Функция ПолучитьОстатокПоМаркеИС(Организация, ШтрихкодУпаковки, НаДату = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ОрганизацияОстатков = Организация;
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.КлассификаторОрганизацийЕГАИС") Тогда
		
		РеквизитыОрганизацииЕГАИС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "Контрагент");
		ОрганизацияОстатков = РеквизитыОрганизацииЕГАИС.Контрагент;
		
	КонецЕсли;
	
	КоличествоОстаток = 0;
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.Штрихкод КАК Штрихкод,
	|	СУММА(ОстаткиМарокИСОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС.Остатки(
	|			&НаДату,
	|			Организация = &Организация
	|				И Штрихкод = &Штрихкод) КАК ОстаткиМарокИСОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМарокИСОстатки.Штрихкод
	|
	|ИМЕЮЩИЕ
	|	СУММА(ОстаткиМарокИСОстатки.КоличествоОстаток) > 0";
	Запрос.УстановитьПараметр("Организация", ОрганизацияОстатков);
	Запрос.УстановитьПараметр("Штрихкод", ШтрихкодУпаковки);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		КоличествоОстаток = Выборка.КоличествоОстаток;
	КонецЦикла;
	
	Возврат КоличествоОстаток;
КонецФункции

