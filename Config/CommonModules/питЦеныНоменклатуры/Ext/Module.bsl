
#Область ПрограммныйИнтерфейс

// Функция - Текст запроса цены номенклатуры.
//
// Параметры:
//  Дата								 - Дата			 - Дата.
//  ИмяВременнойТаблицы					 - Произвольный	 - Имя временной таблицы.
//  ИмяПараметраОтборПериод				 - Произвольный	 - Имя параметра отбор период.
//  ИмяТекстПараметраОтборНоменклатура	 - Произвольный	 - Имя текст параметра отбор номенклатура.
//  ИмяТекстПараметраОтборХарактеристика - Произвольный	 - Имя текст параметра отбор характеристика.
//  ИмяТекстПараметраОтборВидЦены		 - Произвольный	 - Имя текст параметра отбор вид цены.
//  ТекстКомплексногоОтбора				 - Произвольный	 - Текст комплексного отбора.
//  ИспользоватьФизТаблицу				 - Произвольный	 - Использовать физ таблицу.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ТекстЗапросаЦеныНоменклатуры(Знач Дата, Знач ИмяВременнойТаблицы = "втЦеныНоменклатуры",
	Знач ИмяПараметраОтборПериод = "",
	Знач ИмяТекстПараметраОтборНоменклатура = "",
	Знач ИмяТекстПараметраОтборХарактеристика = "",
	Знач ИмяТекстПараметраОтборВидЦены = "",
	Знач ТекстКомплексногоОтбора = "",
	ИспользоватьФизТаблицу = Ложь) Экспорт
	
	ИспользуетсяЦенообразование25 = питЦеныНоменклатурыПовтИсп.ИспользуетсяЦенообразование25(КонецДня(Дата));
	
	ОтборПоПериодуСКД = СтрНачинаетсяС(ИмяПараметраОтборПериод, "{");
	ИмяПараметраОтборПериод = СтрЗаменить(ИмяПараметраОтборПериод, "{", "");
	ИмяПараметраОтборПериод = СтрЗаменить(ИмяПараметраОтборПериод, "}", "");
	
	ПараметрыОтборов = Новый Структура;
	ПараметрыОтборов.Вставить("Номенклатура",
		Новый Структура("ИмяПараметра, ИмяПоУмолчанию", ИмяТекстПараметраОтборНоменклатура, "ОтборНоменклатура"));
	ПараметрыОтборов.Вставить(?(ИспользуетсяЦенообразование25, "ХарактеристикаЦО", "Характеристика"),
		Новый Структура("ИмяПараметра, ИмяПоУмолчанию", ИмяТекстПараметраОтборХарактеристика, "ОтборХарактеристика"));
	ПараметрыОтборов.Вставить("ВидЦены",
		Новый Структура("ИмяПараметра, ИмяПоУмолчанию", ИмяТекстПараметраОтборВидЦены, "ОтборВидЦены"));
	
	ТекстЗапроса = БазовыйТекстЗапросаЦеныНоменклатуры(ИспользуетсяЦенообразование25, ИспользоватьФизТаблицу);
	
	// Имя временной таблицы меняем на переданное.
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ втЦеныНоменклатуры", СтрШаблон("ПОМЕСТИТЬ %1", ИмяВременнойТаблицы));
	
	// Отбор по периоду.
	Если ИспользоватьФизТаблицу Тогда
		ШаблонОтборПоПериоду = ?(ОтборПоПериодуСКД, "{Период = &%1}", "Период = &%1");
		ШаблонОтборПоПериодуПустой = "ИСТИНА";
	Иначе
		ШаблонОтборПоПериоду = ?(ОтборПоПериодуСКД, "{(&%1)}", "&%1");
		ШаблонОтборПоПериодуПустой = "";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПериод",
		?(ПустаяСтрока(ИмяПараметраОтборПериод), ШаблонОтборПоПериодуПустой, СтрШаблон(ШаблонОтборПоПериоду, ИмяПараметраОтборПериод)));
		
	// Комплексный отбор (Номенклатура, Характеристика) В (...)
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КомплексныйОтбор",
		?(ПустаяСтрока(ТекстКомплексногоОтбора), "ИСТИНА", ТекстКомплексногоОтбора));
	
	// Одиночные отборы
	Для каждого ПараметрОтборов Из ПараметрыОтборов Цикл
		ТекстОтборПоУмолчанию = СтрШаблон("%1 = &%2", ПараметрОтборов.Ключ, ПараметрОтборов.Значение.ИмяПоУмолчанию);
		Если ПустаяСтрока(ПараметрОтборов.Значение.ИмяПараметра) Тогда
			ТекстОтбор = "ИСТИНА";
		Иначе
			ТекстОтбор = СтрШаблон(" %1 В (%2%3) ", 
				ПараметрОтборов.Ключ, 
				?(СтрНачинаетсяС(ПараметрОтборов.Значение.ИмяПараметра, "ВЫБРАТЬ"), "", "&"), 
				ПараметрОтборов.Значение.ИмяПараметра);
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстОтборПоУмолчанию, ТекстОтбор);
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция преобразует отбор по характеристике в отбор по характеристике для цен
//
// Параметры:
//  Дата - Дата - Знач дата.
//  ОтборХарактеристика - Произвольный - Знач отбор характеристика.
//
// Возвращаемое значение:
//  Массив, СправочникСсылка.ХарактеристикиНоменклатуры, 
//  СправочникСсылка.ХарактеристикиНоменклатурыДляЦенообразования - Отбор по характеристике для цен.
Функция ПреобразоватьОтборПоХарактеристикеЦен(Знач Дата, Знач ОтборХарактеристика) Экспорт
	
	ИспользуетсяЦенообразование25 = питЦеныНоменклатурыПовтИсп.ИспользуетсяЦенообразование25(КонецДня(Дата));
	Если НЕ ИспользуетсяЦенообразование25 Тогда
		Возврат ОтборХарактеристика;
	КонецЕсли;
	
	Если ТипЗнч(ОтборХарактеристика) = Тип("Массив") Тогда
		ХарактеристикиЦОСоответствие = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ОтборХарактеристика, "ХарактеристикаНоменклатурыДляЦенообразования");
		ХарактеристикиЦО = Новый Массив;
		Для каждого КлючИЗначение Из ХарактеристикиЦОСоответствие Цикл
			Если ХарактеристикиЦО.Найти(КлючИЗначение.Значение) = Неопределено Тогда
				ХарактеристикиЦО.Добавить(КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		Если ОтборХарактеристика.Найти(Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()) <> Неопределено Тогда
			ХарактеристикиЦО.Добавить(Справочники.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка());
		КонецЕсли;
	ИначеЕсли ОтборХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Тогда
		ХарактеристикиЦО = Справочники.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка();
	Иначе
		ХарактеристикиЦО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборХарактеристика, "ХарактеристикаНоменклатурыДляЦенообразования");
	КонецЕсли;
	
	Возврат ХарактеристикиЦО;
	
КонецФункции

// Функция преобразует текст комплексного отбора с учетом использования ценообразования 2.5.
//  А именно, подменяет имя поля Характеристика на ХарактеристикаЦО и в тексте запроса отбор
//  происходит не по характеристике а по характеристике для ценообразования.
//
// Параметры:
//  Дата - Дата - Знач дата.
//  ТекстКомплексногоОтбора - Произвольный - Знач текст комплексного отбора.
//
// Возвращаемое значение:
//  Строка - Измененный текст отбора.
Функция ПреобразоватьТекстКомплексногоОтбора(Знач Дата, Знач ТекстКомплексногоОтбора) Экспорт
	
	Если НЕ СтрНачинаетсяС(ТекстКомплексногоОтбора, "(") Тогда
		Возврат ТекстКомплексногоОтбора;
	КонецЕсли;
	
	ИспользуетсяЦенообразование25 = питЦеныНоменклатурыПовтИсп.ИспользуетсяЦенообразование25(КонецДня(Дата));
	Если НЕ ИспользуетсяЦенообразование25 Тогда
		Возврат ТекстКомплексногоОтбора;
	КонецЕсли;
	
	ОтбираемыеПоля = СтрРазделить(СтрЗаменить(СтрРазделить(ТекстКомплексногоОтбора, ")")[0], "(", ""), ",");
	ИндексХарактеристики = -1;
	ТекстОтбираемыеПоля = "(";
	Для Инд = 0 По ОтбираемыеПоля.Количество() - 1 Цикл
		ОтбираемоеПоле = ОтбираемыеПоля[Инд];
		ТекстОтбираемыеПоля = ТекстОтбираемыеПоля + ?(Инд = 0, "", ",");
		Если СокрЛП(ОтбираемоеПоле) = "Характеристика" Тогда
			ИндексХарактеристики = Инд;
			ТекстОтбираемыеПоля = ТекстОтбираемыеПоля + "ХарактеристикаЦО";
		Иначе
			ТекстОтбираемыеПоля = ТекстОтбираемыеПоля + ОтбираемоеПоле;
		КонецЕсли;
	КонецЦикла;
	ТекстОтбираемыеПоля = ТекстОтбираемыеПоля + ")";
	
	Если ИндексХарактеристики = -1 Тогда
		Возврат ТекстКомплексногоОтбора;
	КонецЕсли;
	
	НомерПодзапроса = 1;
	ТекстПодзапроса = ТекстПодзапроса(ТекстКомплексногоОтбора, НомерПодзапроса);
	Если ПустаяСтрока(ТекстПодзапроса) Тогда
		Возврат ТекстКомплексногоОтбора;
	КонецЕсли;
	
	НовыйТекстПодзапросов = "(";
	Пока НЕ ПустаяСтрока(ТекстПодзапроса) Цикл
		
		МассивСтрокПодзапроса = СтрРазделить(ТекстПодзапроса, Символы.ПС);
		ИндексСтроки = 0;
		Для каждого СтрокаПодзапроса Из МассивСтрокПодзапроса Цикл
			Если СтрНайти(СтрокаПодзапроса, "ВЫБРАТЬ") Тогда
				НовыйТекстПодзапросов = НовыйТекстПодзапросов + СтрокаПодзапроса;
			ИначеЕсли ИндексСтроки = ИндексХарактеристики Тогда
				ИндексНачалоСинонима = СтрНайти(СтрокаПодзапроса, " КАК ");
				Если ИндексНачалоСинонима Тогда
					ЧастьСтрокиПодзапроса1 = СокрЛП(Лев(СтрокаПодзапроса, ИндексНачалоСинонима - 1));
					ЧастьСтрокиПодзапроса2 = Прав(СтрокаПодзапроса, СтрДлина(СтрокаПодзапроса) - ИндексНачалоСинонима);
				Иначе
					Если СтрЗаканчиваетсяНа(СтрокаПодзапроса, ",") Тогда
						ПоследнийСимвол = ",";
					ИначеЕсли СтрЗаканчиваетсяНа(СтрокаПодзапроса, ")") Тогда
						ПоследнийСимвол = ",";
					Иначе
						ПоследнийСимвол = "";
					КонецЕсли;
					ЧастьСтрокиПодзапроса1 = СокрЛП(СтрЗаменить(СтрокаПодзапроса, ПоследнийСимвол, ""));
					ЧастьСтрокиПодзапроса2 = ПоследнийСимвол;
				КонецЕсли;
				НоваяСтрокаПодзапроса = СтрШаблон("ЕстьNULL(%1%2, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)) %3", ЧастьСтрокиПодзапроса1, ".ХарактеристикаНоменклатурыДляЦенообразования", ЧастьСтрокиПодзапроса2);
				ИндексСтроки = ИндексСтроки + 1;
			Иначе
				НоваяСтрокаПодзапроса = СтрокаПодзапроса;
				ИндексСтроки = ИндексСтроки + 1;
			КонецЕсли;
			НовыйТекстПодзапросов = НовыйТекстПодзапросов + Символы.ПС + НоваяСтрокаПодзапроса;
		КонецЦикла;
		
		НомерПодзапроса = НомерПодзапроса + 1;
		ТекстПодзапроса = ТекстПодзапроса(ТекстКомплексногоОтбора, НомерПодзапроса);
	КонецЦикла;
	
	Возврат СтрШаблон("%1 В %2", ТекстОтбираемыеПоля, НовыйТекстПодзапросов);
	
КонецФункции

// Функция преобразует условие соединения с регистром цен по характеристике с учетом ценообразования 2.5
//
// Параметры:
//  Дата - Дата - Знач дата.
//  СинонимТаблицыТоваров - Строка - Синоним таблицы товаров с которой соединяем цены.
//  ИмяПоляХарактеристика - Строка - Имя поля характеристики по которому соединяем.
//  СинонимТаблицыЦен - Строка - Синоним таблицы цен с которой соединяем товары.
//
// Возвращаемое значение:
//  Строка - Преобразованное условие соединения.
Функция УсловиеСоединенияХарактеристика(Знач Дата, СинонимТаблицыТоваров, ИмяПоляХарактеристика, СинонимТаблицыЦен) Экспорт
	
	ИспользуетсяЦенообразование25 = питЦеныНоменклатурыПовтИсп.ИспользуетсяЦенообразование25(КонецДня(Дата));
	Если ИспользуетсяЦенообразование25 Тогда
		ТекстШаблон = "ЕстьNULL(%1.%2.ХарактеристикаНоменклатурыДляЦенообразования, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)) = %3.ХарактеристикаЦО";
	Иначе
		ТекстШаблон = "%1.%2 = %3.Характеристика";
	КонецЕсли;
	
	Возврат СтрШаблон(ТекстШаблон, СинонимТаблицыТоваров, ИмяПоляХарактеристика, СинонимТаблицыЦен);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Текст подзапроса.
//
// Параметры:
//  ТекстКомплексногоОтбора - Произвольный - Текст комплексного отбора.
//  НомерПодзапроса - Произвольный - Номер подзапроса.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстПодзапроса(ТекстКомплексногоОтбора, НомерПодзапроса)
	
	ПозицияНачалаПодзапроса = СтрНайти(ТекстКомплексногоОтбора, "ВЫБРАТЬ",, 1, НомерПодзапроса);
	Если ПозицияНачалаПодзапроса = 0 Тогда
		ТекстПодзапроса = "";
	Иначе
		ПозицияКонцаПодзапроса = СтрНайти(ТекстКомплексногоОтбора, "ВЫБРАТЬ",, 1, НомерПодзапроса + 1);
		Если ПозицияКонцаПодзапроса = 0 Тогда
			ПозицияКонцаПодзапроса = СтрДлина(ТекстКомплексногоОтбора) + 1;
		КонецЕсли;
		ТекстПодзапроса = Сред(ТекстКомплексногоОтбора, ПозицияНачалаПодзапроса, ПозицияКонцаПодзапроса - ПозицияНачалаПодзапроса);
	КонецЕсли;
	Возврат ТекстПодзапроса;
	
КонецФункции

// Функция - Базовый текст запроса цены номенклатуры.
//
// Параметры:
//  ИспользуетсяЦенообразование25 - Произвольный - Используется ценообразование 2 5.
//  ИспользоватьФизТаблицу - Произвольный - Использовать физ таблицу.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция БазовыйТекстЗапросаЦеныНоменклатуры(ИспользуетсяЦенообразование25, ИспользоватьФизТаблицу)
	
	 Если ИспользуетсяЦенообразование25 И ИспользоватьФизТаблицу Тогда
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ЦеныНоменклатуры.Период КАК Период,
		|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатуры.ХарактеристикаЦО КАК ХарактеристикаЦО,
		|	ЦеныНоменклатуры.ВидЦены КАК ВидЦены,
		|	ЦеныНоменклатуры.Цена КАК Цена,
		|	ЦеныНоменклатуры.Валюта КАК Валюта,
		|	ЦеныНоменклатуры.Упаковка КАК Упаковка
		|ПОМЕСТИТЬ втЦеныНоменклатуры
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры25 КАК ЦеныНоменклатуры
		|ГДЕ
		|	&ОтборПериод
		|	И Номенклатура = &ОтборНоменклатура
		|	И ХарактеристикаЦО = &ОтборХарактеристика
		|	И ВидЦены = &ОтборВидЦены
		|	И &КомплексныйОтбор
		|	И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
		|	И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|";
	ИначеЕсли ИспользуетсяЦенообразование25 И НЕ ИспользоватьФизТаблицу Тогда
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатуры.ХарактеристикаЦО КАК ХарактеристикаЦО,
		|	ЦеныНоменклатуры.ВидЦены КАК ВидЦены,
		|	ЦеныНоменклатуры.Цена КАК Цена,
		|	ЦеныНоменклатуры.Валюта КАК Валюта,
