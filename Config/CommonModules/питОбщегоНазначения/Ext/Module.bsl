

#Область ПрограммныйИнтерфейс

#Область УправлениеПроизводством

// Функция проверяет режим производства ERP 2.1 и 2.2 в соответствии
//  с переданным флагом использования производства 2.2 для подсистемы "Общепит".
//  Если 2.2 или 2.1 для объектов Общепита использовать невозможно,
//  функция вернет Ложь и запишет ТекстОшибки.
//
// Параметры:
//  питИспользовать22 - Булево - флагом использования производства 2.2 для подсистемы "Общепит".
//  ТекстОшибки - Строка - сюда будет записан тест ошибки в случае ее возникновения.
//
// Возвращаемое значение:
//  Булево - Результат проверки.
Функция ПроверитьРежимПроизводстваERP(питИспользовать22, ТекстОшибки="") Экспорт
	
	ВсеОк = Истина;
	
	ВерсияЕРП = питОбщегоНазначения.ПолучитьВерсиюКонфигурацииУправлениеПредприятием();
	ВерсияЕРПМассив = СтрРазделить(ВерсияЕРП, ".");
	Если ВерсияЕРПМассив.Количество() < 2 Тогда
		Возврат ВсеОк;
	КонецЕсли;
	
	Если ВерсияЕРП = "2.1" Тогда
		
		ВсеОк = НЕ питИспользовать22;
		ТекстОшибки = "Нельзя использовать формирования документов производства версии 2.2 для ЕРП версии 2.1";
		
	ИначеЕсли Число(ВерсияЕРПМассив[1]) >= 2 Тогда
		
		ERPИспользовать21 = Константы.ИспользоватьУправлениеПроизводством.Получить();
		ERPИспользовать22 = Константы.ИспользоватьУправлениеПроизводством2_2.Получить();
		
		Если питИспользовать22 И НЕ ERPИспользовать22 Тогда
			ТекстОшибки = ТекстОшибки 
			+ "Режим формирования документов производства версии 2.2 в настройках общепита установлен в значение ""Истина"", но не может использоваться без включения его в настройках производства ERP:
			| НСИ и Администрирование -> Производство -> Управление производством(версия 2.2)";
			ВсеОк = Ложь;
		ИначеЕсли НЕ питИспользовать22 И НЕ ERPИспользовать21 Тогда 
			ТекстОшибки = ТекстОшибки 
			+ "Режим формирования документов производства версии 2.2 в настройках общепита установлен в значение ""Ложь"", но не может использоваться без включения его в настройках производства ERP:
			| НСИ и Администрирование -> Производство -> Управление производством(версия 2.1)";
			ВсеОк = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВсеОк;
	
КонецФункции

#КонецОбласти

#Область Номенклатура

// Функция проверяет, используются ли характеристики для переданной номенклатуры
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатур.
//
// Возвращаемое значение:
//  Булево - Результат выполнения функции.
Функция ХарактеристикиИспользуются(Номенклатура) Экспорт
	
	Возврат Справочники.Номенклатура.ХарактеристикиИспользуются(Номенклатура);
	
КонецФункции

// Процедура - Заполнить реквизиты по виду номенклатуры.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  ПрерыватьЗаполнениеПриОшибкеПроверки - Произвольный - Прерывать заполнение при ошибке проверки.
//  Отказ - Булево - Отказ.
//  СтарыйВидНоменклатуры - Произвольный - Старый вид номенклатуры.
//  ЗаполнениеПоИсточникуКопирования - Произвольный - Заполнение по источнику копирования.
//
Процедура ЗаполнитьРеквизитыПоВидуНоменклатуры(Номенклатура,
												ПрерыватьЗаполнениеПриОшибкеПроверки = Ложь,
												Отказ = Ложь,
												СтарыйВидНоменклатуры = Неопределено,
												ЗаполнениеПоИсточникуКопирования = Ложь) Экспорт
	
	
	// ИменаРеквизитов = "";
//   ВсеРеквизитыНоменклатурыТаблица =
// ЗначениеНастроекПовтИсп.ВсеРеквизитыНоменклатурыТаблица(Перечисления.ТипыНоменклатуры.ПустаяСсылка(),.
	// 	Перечисления.ОсобенностиУчетаНоменклатуры.ПустаяСсылка(),
	// 	Номенклатура.ИспользованиеХарактеристик,
	// 	Номенклатура.ВидНоменклатуры.ИспользоватьСрокГодностиСерии);
	// СтрокиРеквизитыМассив = ВсеРеквизитыНоменклатурыТаблица.НайтиСтроки(Новый Структура("Использование", Истина));
	// РеквизитыСтрока = "";
	// Для каждого ТекРеквизит Из СтрокиРеквизитыМассив Цикл
	// 	РеквизитыСтрока = РеквизитыСтрока + ТекРеквизит.Имя + ",";
	// КонецЦикла;
	// РеквизитыСтрока = РеквизитыСтрока + "ЭтоГруппа, Ссылка, Наименование, Родитель";
	
	НоменклатураСтруктура = ПолучитьРеквизитыОбъекта(Номенклатура,,,,,,,Истина);
	
	Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(НоменклатураСтруктура, 
		ПрерыватьЗаполнениеПриОшибкеПроверки,
		Отказ,
		СтарыйВидНоменклатуры,
		ЗаполнениеПоИсточникуКопирования);
	
	ЗаполнитьОбъектПоСтруктуре(Номенклатура, НоменклатураСтруктура);
	
КонецПроцедуры

// Процедура - Заполнить значения пустых свойств.
//
// Параметры:
//  Приемник - Произвольный - Приемник.
//  Источник - Произвольный - Источник.
//
Процедура ЗаполнитьЗначенияПустыхСвойств(Приемник, Источник) Экспорт
	
	Для каждого КлючЗначение Из Источник Цикл
		Если (ТипЗнч(Приемник[КлючЗначение.Ключ]) = Тип("Булево")
			И Не Приемник[КлючЗначение.Ключ])
			Или Не ЗначениеЗаполнено(Приемник[КлючЗначение.Ключ]) Тогда
			Приемник[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Общие

// Функция - Получить информацию о подсистеме.
//
// Параметры:
//  ИмяПодсистемы - Произвольный - Имя подсистемы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьИнформациюОПодсистеме(ИмяПодсистемы) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("Версия", "0.0.0.0");
	Результат.Вставить("ЭтоОсновнаяКонфигурация", Ложь);
	Результат.Вставить("ВыполненаРегистрацияОтложенныхОбработчиков", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВерсииПодсистем.Версия КАК Версия,
	|	ВерсииПодсистем.ЭтоОсновнаяКонфигурация КАК ЭтоОсновнаяКонфигурация,
	|	ВерсииПодсистем.ВыполненаРегистрацияОтложенныхОбработчиков КАК ВыполненаРегистрацияОтложенныхОбработчиков
	|ИЗ
	|	РегистрСведений.ВерсииПодсистем КАК ВерсииПодсистем
	|ГДЕ
	|	ВерсииПодсистем.ИмяПодсистемы = &ИмяПодсистемы";
	Запрос.УстановитьПараметр("ИмяПодсистемы", ИмяПодсистемы);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, ВыборкаДетальныеЗаписи);
	КонецЕсли;
	
	// Дата последнего релиза фиксированная, берется из модуля обновления информационной базы.
	Результат.Вставить("ДатаРелиза", питОбновлениеИнформационнойБазы.ДатаРелиза());
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Функция создает пустую таблицу значений по результату запроса.
//
// Параметры:
//  Результат - РезультатЗапроса, ДеревоЗначений, ТаблицаЗначений - Результат запроса.
//  СкопироватьСтроки - Булево - Признак, который указывает на то, копировать ли строки из
//   результата запроса в новую таблицу.
//   Рекомендуется применять только для результата запроса, который не содержит итогов.
//  ИсключаяКолонки - Строка - Строка колонок-исключений, которые не будут созданы.
//  ВозможныеТипыКолонок - Соответствие - Массив типов колонок по их именам на случай есл.
//  ТолькоЛистьяДерева - Произвольный - Только листья дерева.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Созданная таблица.
Функция СоздатьТаблицуЗначенийПоРезультату(Результат, СкопироватьСтроки, ИсключаяКолонки = "", ВозможныеТипыКолонок = Неопределено, ТолькоЛистьяДерева = Истина) Экспорт
	
	Если ТипЗнч(Результат) = Тип("РезультатЗапроса") И Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПустойТип = Новый ОписаниеТипов;
	
	МассивИменИсключений = СтрРазделить(ИсключаяКолонки, ",");
	
	РезультирующаяТаблица = Новый ТаблицаЗначений;
	Для каждого ТекКолонкаРезультат Из Результат.Колонки Цикл
		
		// Исключение колонок.
		Если НЕ ПустаяСтрока(ИсключаяКолонки) И НЕ МассивИменИсключений.Найти(ТекКолонкаРезультат.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекТип = ТекКолонкаРезультат.ТипЗначения;
		Если ТекТип = ПустойТип И НЕ ВозможныеТипыКолонок = Неопределено Тогда
			ВозможныйТип = ВозможныеТипыКолонок.Получить(ТекКолонкаРезультат.Имя);
			Если ВозможныйТип <> Неопределено Тогда
				ТекТип = ВозможныйТип;
			Иначе
				ТекТип = Новый ОписаниеТипов("Строка"); // Не нашли как типизировать, типизируем как "Строка".
			КонецЕсли;
		КонецЕсли;
		
		РезультирующаяТаблица.Колонки.Добавить(ТекКолонкаРезультат.Имя, ТекТип); 
	КонецЦикла;
	
	// Копирование строк.
	Если СкопироватьСтроки Тогда
		Если ТипЗнч(Результат) = Тип("РезультатЗапроса") Тогда
			ВыборкаРезультата = Результат.Выбрать();
			Пока ВыборкаРезультата.Следующий() Цикл
				НовСтрокаТаблица = РезультирующаяТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаТаблица, ВыборкаРезультата);
			КонецЦикла;
		ИначеЕсли ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
			Для каждого ВыборкаРезультата Из Результат Цикл
				НовСтрокаТаблица = РезультирующаяТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаТаблица, ВыборкаРезультата);
			КонецЦикла;
		ИначеЕсли ТипЗнч(Результат) = Тип("ДеревоЗначений") Тогда
			ЗаполнитьТаблицуЗначенийПоСтрокамДереваЗначенийРекурсивно(Результат.Строки, РезультирующаяТаблица, ТолькоЛистьяДерева);
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультирующаяТаблица;
	
КонецФункции

// Процедура - Заполнить таблицу значений по строкам дерева значений рекурсивно.
//
// Параметры:
//  вхСтрокиДерева - Произвольный - вх строки дерева.
//  выхТаблицаЗначений - ТаблицаЗначений - вых таблица значений.
//  ТолькоЛистьяДерева - Произвольный - Только листья дерева.
//
Процедура ЗаполнитьТаблицуЗначенийПоСтрокамДереваЗначенийРекурсивно(вхСтрокиДерева, выхТаблицаЗначений, ТолькоЛистьяДерева = Истина) Экспорт
	
	Для каждого ТекСтрокаДерева Из вхСтрокиДерева Цикл
		Если НЕ ТекСтрокаДерева.Строки.Количество() ИЛИ НЕ ТолькоЛистьяДерева Тогда
			НовСтрокаТаблица = выхТаблицаЗначений.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаТаблица, ТекСтрокаДерева);
		КонецЕсли;
		ЗаполнитьТаблицуЗначенийПоСтрокамДереваЗначенийРекурсивно(ТекСтрокаДерева.Строки, выхТаблицаЗначений);
	КонецЦикла;
	
КонецПроцедуры

// Функция получает складские типы номенклатуры.
//
// Возвращаемое значение:
//  Массив - Складские типы номенклатуры.
Функция ПолучитьСкладскиеТипыНоменклатуры() Экспорт
	
	СкладскиеТипыНоменклатуры = Новый Массив;
	СкладскиеТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Товар);
	СкладскиеТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Набор);
	СкладскиеТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.МногооборотнаяТара);
	Возврат СкладскиеТипыНоменклатуры;
	
КонецФункции

// Функция - Получить реквизиты объекта.
//
// Параметры:
//  Объект				 - Произвольный	 - Объект.
//  СтруктураРеквизитов	 - Структура	 - Структура реквизитов.
//  ЭтоПланОбмена		 - Произвольный	 - Это план обмена.
//  ЭтоПВХ				 - Произвольный	 - Это пвх.
//  ЭтоПланВидовРасчета	 - Произвольный	 - Это план видов расчета.
//  ЭтоДокумент			 - Произвольный	 - Это документ.
//  ЭтоЗадача			 - Произвольный	 - Это задача.
//  ЭтоСправочник		 - Произвольный	 - Это справочник.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьРеквизитыОбъекта(Знач Объект, 
									Знач СтруктураРеквизитов = Неопределено,
									Знач ЭтоПланОбмена = Ложь,
									Знач ЭтоПВХ = Ложь,
									Знач ЭтоПланВидовРасчета = Ложь,
									Знач ЭтоДокумент = Ложь,
									Знач ЭтоЗадача = Ложь,
									Знач ЭтоСправочник = Ложь) Экспорт
	
	МетаданныеОбъекта = Объект.Метаданные();
	ИмяТаблицы = МетаданныеОбъекта.ПолноеИмя();
	
	ТабЧасти = Новый Массив;
	
	// Формируем список реквизитов объекта для запроса
	Если ТипЗнч(СтруктураРеквизитов) = Тип("Строка") И ЗначениеЗаполнено(СтруктураРеквизитов) Тогда
		
		// Если передали список реквизитов, инициализируем структуру
		Если Найти(СтруктураРеквизитов, ",") <> 0 Тогда
			СтруктураРеквизитов = Новый Структура(СтруктураРеквизитов);
		КонецЕсли;
		
	Иначе
		// Определяем список реквизитов объектов для подстановки в текст запроса
		СписокРеквизитов = "";
		Если ЭтоСправочник ИЛИ ЭтоПланОбмена ИЛИ ЭтоПВХ ИЛИ ЭтоПланВидовРасчета Тогда
			Если МетаданныеОбъекта.ДлинаКода > 0 Тогда
				СписокРеквизитов = "Код,";
			КонецЕсли;
			Если МетаданныеОбъекта.ДлинаНаименования > 0 Тогда
				СписокРеквизитов = СписокРеквизитов + "Наименование,";
			КонецЕсли;
			Если ЭтоСправочник ИЛИ ЭтоПВХ Тогда
				Если МетаданныеОбъекта.Иерархический Тогда
					СписокРеквизитов = СписокРеквизитов + "Родитель,";
				КонецЕсли;
				Если ЭтоСправочник И (МетаданныеОбъекта.Владельцы.Количество() <> 0) Тогда
					СписокРеквизитов = СписокРеквизитов + "Владелец,";
				КонецЕсли;
				Если ЭтоСправочник Тогда
					СписокРеквизитов = СписокРеквизитов + "ЭтоГруппа,";
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЭтоДокумент Тогда
			Если МетаданныеОбъекта.ДлинаНомера > 0 Тогда
				СписокРеквизитов = "Номер,";
			КонецЕсли;
			СписокРеквизитов =  СписокРеквизитов + "Дата,";
		ИначеЕсли ЭтоЗадача Тогда
			Если МетаданныеОбъекта.ДлинаНомера > 0 Тогда
				СписокРеквизитов = "Номер,";
			КонецЕсли;
			СписокРеквизитов =  СписокРеквизитов + "Дата,";
			Если МетаданныеОбъекта.ДлинаНаименования > 0 Тогда
				СписокРеквизитов = СписокРеквизитов + "Наименование,";
			КонецЕсли;
		КонецЕсли;
		
		СписокРеквизитов = СписокРеквизитов + "ПометкаУдаления,Ссылка,";
		
		Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл 
			
			Если ЭтоСправочник Тогда
				Если (Объект.ЭтоГруппа 
					И Реквизит.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента)
					ИЛИ (НЕ Объект.ЭтоГруппа 
					И Реквизит.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы) Тогда
					Продолжить; // Реквизиты, которые используются только для группы при этом объект не группа и наоборот исключаем.
				КонецЕсли;
			КонецЕсли;
			
			СписокРеквизитов = СписокРеквизитов + Реквизит.Имя + ",";
		КонецЦикла;
		
		// Отрезаем последнюю запятую
		СписокРеквизитов = Лев(СписокРеквизитов, СтрДлина(СписокРеквизитов) - 1);
		СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
		
		Если ЭтоСправочник ИЛИ ЭтоДокумент Тогда
			Для каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
				ТабЧасти.Добавить(ТабличнаяЧасть.Имя);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(СтруктураРеквизитов) = Тип("Строка") И ЗначениеЗаполнено(СтруктураРеквизитов) Тогда
		СтруктураРеквизитов = Новый Структура("СтруктураРеквизитов", Объект[СтруктураРеквизитов]);
	Иначе
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Объект);
	КонецЕсли;
	
	Для каждого ТабЧасть Из ТабЧасти Цикл
		СтруктураРеквизитов.Вставить(ТабЧасть, Объект[ТабЧасть].Выгрузить());
	КонецЦикла;
	
	Если СтруктураРеквизитов = Неопределено Тогда
		СтруктураРеквизитов = Новый Структура;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции //ПолучитьРеквизитыОбъекта()

// Возвращает значение или структуру с именами и значениями реквизитов произвольного объекта ссылочного типа
//  прочитанные из информационной базы. Источник: http://forum.aeroion.ru/topic465.html
//
// Параметры:
//  Ссылка - Произвольный - Знач ссылка.
//  СтруктураРеквизитов - Структура - Знач структура реквизитов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьРеквизитыСсылки(Знач Ссылка, Знач СтруктураРеквизитов = Неопределено) Экспорт
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	ИмяТаблицы = МетаданныеОбъекта.ПолноеИмя();
	
	ЭтоСправочник = Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка));
	ЭтоПланОбмена = ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка));
	ЭтоПВХ = ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка));
	ЭтоПланВидовРасчета = ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка));
	ЭтоДокумент = (Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка)) ИЛИ БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка)));
	ЭтоЗадача = Задачи.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка));
	
	ТекстЗапроса = "ВЫБРАТЬ ";
	
	// Формируем список реквизитов объекта для запроса
	Если ТипЗнч(СтруктураРеквизитов) = Тип("Строка") И ЗначениеЗаполнено(СтруктураРеквизитов) Тогда
		
		ТекстЗапроса = ТекстЗапроса + СокрЛП(СтруктураРеквизитов);
		// Если передали список реквизитов, инициализируем структуру
		Если Найти(СтруктураРеквизитов, ",") <> 0 Тогда
			СтруктураРеквизитов = Новый Структура(СтруктураРеквизитов);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СтруктураРеквизитов) = Тип("Структура") И СтруктураРеквизитов.Количество() > 0 Тогда
		
		Для каждого Реквизит Из СтруктураРеквизитов Цикл ТекстЗапроса = ТекстЗапроса + Реквизит.Ключ + ","; КонецЦикла;
		
		// Отрезаем последнюю запятую
		ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 1);
		
	Иначе
		
		// Определяем список реквизитов объектов для подстановки в текст запроса
		СписокРеквизитов = "";
		Если ЭтоСправочник ИЛИ ЭтоПланОбмена ИЛИ ЭтоПВХ ИЛИ ЭтоПланВидовРасчета Тогда
			Если МетаданныеОбъекта.ДлинаКода > 0 Тогда
				СписокРеквизитов = "Код,";
			КонецЕсли;
			Если МетаданныеОбъекта.ДлинаНаименования > 0 Тогда
				СписокРеквизитов = СписокРеквизитов + "Наименование,";
			КонецЕсли;
			Если ЭтоСправочник ИЛИ ЭтоПВХ Тогда
				Если МетаданныеОбъекта.Иерархический Тогда
					СписокРеквизитов = СписокРеквизитов + "Родитель,";
				КонецЕсли;
				Если ЭтоСправочник И (МетаданныеОбъекта.Владельцы.Количество() <> 0) Тогда
					СписокРеквизитов = СписокРеквизитов + "Владелец,";
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЭтоДокумент Тогда
			Если МетаданныеОбъекта.ДлинаНомера > 0 Тогда
				СписокРеквизитов = "Номер,";
			КонецЕсли;
			СписокРеквизитов =  СписокРеквизитов + "Дата,";
		ИначеЕсли ЭтоЗадача Тогда
			Если МетаданныеОбъекта.ДлинаНомера > 0 Тогда
				СписокРеквизитов = "Номер,";
			КонецЕсли;
			СписокРеквизитов =  СписокРеквизитов + "Дата,";
			Если МетаданныеОбъекта.ДлинаНаименования > 0 Тогда
				СписокРеквизитов = СписокРеквизитов + "Наименование,";
			КонецЕсли;
		КонецЕсли;
		
		СписокРеквизитов = СписокРеквизитов + "ПометкаУдаления,";
		
		Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл СписокРеквизитов = СписокРеквизитов + Реквизит.Имя + ","; КонецЦикла;
		
		// Отрезаем последнюю запятую
		СписокРеквизитов = Лев(СписокРеквизитов, СтрДлина(СписокРеквизитов) - 1);
		СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
		
		ТекстЗапроса = ТекстЗапроса + СписокРеквизитов;
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ " + ИмяТаблицы + "
	|ГДЕ Ссылка = &Ссылка";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Если ТипЗнч(СтруктураРеквизитов) = Тип("Строка") И ЗначениеЗаполнено(СтруктураРеквизитов) Тогда
				Возврат Выборка[СтруктураРеквизитов];
			Иначе
				ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);
				Возврат СтруктураРеквизитов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции //ПолучитьРеквизитыОбъекта()

// Процедура заполняет переданный объект по переданной структуре
//
// Параметры:
//  Объект - ДокументОбъект, СправочникОбъект и т.д. - Объект, который заполнить.
//  Структура - Структура - Структура, по которой заполнить.
//
Процедура ЗаполнитьОбъектПоСтруктуре(Объект, Структура) Экспорт
	
	Исключения = "";
	Для каждого КлючИЗначение Из Структура Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
			Исключения = Исключения + КлючИЗначение.Ключ + ",";
			Объект[КлючИЗначение.Ключ].Загрузить(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(Исключения) Тогда
		Исключения = Лев(Исключения, СтрДлина(Исключения) - 1);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, Структура, , Исключения);
	
КонецПроцедуры

// Получение элемента справочника СтавкиНДС по числу.
//
// Параметры:
//  СтавкаЧислом - Число - Ставка НДС числом.
//  РасчетнаяСтавка - Булево - Является ли ставка расчетной.
//
// Возвращаемое значение:
//  СправочникСсылка.СтавкиНДС - Найденная ставка
Функция СтавкаНДСПоЧислу(СтавкаЧислом = Неопределено, РасчетнаяСтавка = Ложь) Экспорт 
	
	Если СтавкаЧислом = Неопределено Тогда
		Возврат Справочники.СтавкиНДС.БезНДС;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтавкиНДС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Ставка = &СтавкаЧислом
	|	И СтавкиНДС.РасчетнаяСтавка = &РасчетнаяСтавка";
	Запрос.УстановитьПараметр("РасчетнаяСтавка", РасчетнаяСтавка);
	Запрос.УстановитьПараметр("СтавкаЧислом", СтавкаЧислом);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Выгружает запрос в строку XML, которую можно вставить в Консоль запросов.
//  Для переноса запроса и всех его параметров в Консоль запросов, необходимо вызвать функцию в окне.
//  «Вычислить выражение»(Shift + F9), скопировать полученный XML в поле "Текст запроса"
//  консоли запросов и выполнить команду "Заполнить из XML" из меню "Еще".
//  Подробнее об использование функции смотрите в справке к консоли запросов.
//
// Параметры:
//  Запрос - Запрос - Запрос, который необходимо выгрузить в формат строки XML.
//  ТипБольшогоРезультата - Строка - Если запрос больше 305к символов, то не влезет в окно отладки.
//  ПутьКФайлу - Произвольный - Путь к файлу.
//
// Возвращаемое значение:
//    Строка - строка в формате XML, которую можно извлечь при помощи метода
Функция ЗапросВСтроку(Запрос, ТипБольшогоРезультата = "Массив", ПутьКФайлу = "") Экспорт // АПК:299
	
	Если НЕ Запрос.МенеджерВременныхТаблиц = Неопределено
		И ЗначениеЗаполнено(Запрос.МенеджерВременныхТаблиц.Таблицы) Тогда
		
		МассивПакетов = Новый Массив;
		ВременныйЗапрос = Новый Запрос;
		ВременныйЗапрос.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
		СлужебныеКолонки = Новый Соответствие;
		СлужебныеКолонки["НомерСтроки"] = "НомерСтрокиНомерСтрокиНомерСтроки";
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПереопределятьПустыеТипы", Истина);
		
		Для Каждого ВремТаблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
			ИмяВрмТаблица = ВремТаблица.ПолноеИмя;
			
			Если СтрНайти(Запрос.Текст, ИмяВрмТаблица) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			МассивПолейВыборкиМенеджера = Новый Массив;
			МассивПолейВыборкиВЗапрос = Новый Массив;
			
			Для Каждого ТекКолонка Из ВремТаблица.Колонки Цикл
				
				ИмяКолонки = ТекКолонка.Имя;
				ПредставлениеКолонки = СлужебныеКолонки[ИмяКолонки];
				Если ПредставлениеКолонки = Неопределено Тогда
					ПредставлениеКолонки = ИмяКолонки;
				КонецЕсли;
				
				МассивПолейВыборкиМенеджера.Добавить(СтрШаблон("Таблица.%1 КАК %2", ИмяКолонки, ПредставлениеКолонки));
				МассивПолейВыборкиВЗапрос.Добавить(СтрШаблон("Таблица.%1 КАК %2", ПредставлениеКолонки, ИмяКолонки));
				
			КонецЦикла;
			
			ТекстПолейВыборки = СтрСоединить(МассивПолейВыборкиМенеджера, ",
			|	");
			
			ВременныйЗапрос.Текст = СтрШаблон("ВЫБРАТЬ
			|	%1
			|ИЗ
			|	%2 КАК Таблица", ТекстПолейВыборки, ИмяВрмТаблица);
			РезультатЗапроса = ВременныйЗапрос.Выполнить();
			
			ТаблицаМенеджера = ВыгрузитьРезультатЗапроса(РезультатЗапроса,,ДополнительныеПараметры);
			
			Запрос.УстановитьПараметр(ИмяВрмТаблица, ТаблицаМенеджера);
			
			ТекстПолейВыборки = СтрСоединить(МассивПолейВыборкиВЗапрос, ",
			|	");
			
			МассивПакетов.Добавить(СтрШаблон("ВЫБРАТЬ
			|	%1
			|ПОМЕСТИТЬ %2
			|ИЗ
			|	&%2 КАК Таблица", ТекстПолейВыборки, ИмяВрмТаблица));
			
			
		КонецЦикла;
		
		МассивПакетов.Добавить(Запрос.Текст);
		
		ИтоговыйЗапрос = Новый Запрос;
		ЗаполнитьЗначенияСвойств(ИтоговыйЗапрос, Запрос,, "МенеджерВременныхТаблиц");
		ИтоговыйЗапрос.Текст = СтрСоединить(МассивПакетов, ОбщегоНазначения.РазделительПакетаЗапросов());
		
		Для Каждого ТекПараметр Из Запрос.Параметры Цикл
			Если СтрНайти(Запрос.Текст, ТекПараметр.Ключ) = 0 Тогда
				Продолжить;
			КонецЕсли;
			ИтоговыйЗапрос.УстановитьПараметр(ТекПараметр.Ключ, ТекПараметр.Значение);
		КонецЦикла;
	Иначе
		ИтоговыйЗапрос = Запрос;
	КонецЕсли;
	
	ТекстЗапроса = ОбщегоНазначения.ЗапросВСтрокуXML(ИтоговыйЗапрос);
	
	Результат = ТекстЗапроса;
	МаксимальноеКоличествоСимволовДляОтладки = 305000;
	Если СтрДлина(ТекстЗапроса) <= МаксимальноеКоличествоСимволовДляОтладки Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ВРег(ТипБольшогоРезультата) = ВРег("ВременныйФайл")
		ИЛИ ВРег(ТипБольшогоРезультата) = "ВФ" Тогда
		Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
			ПутьКФайлу = ПолучитьИмяВременногоФайла("txt");
		КонецЕсли;
		Попытка
			Запись = Новый ЗаписьТекста(ПутьКФайлу,КодировкаТекста.UTF8,,Ложь);
			Запись.Записать(ТекстЗапроса);
			Запись.Закрыть();
		Исключение
			ПутьКФайлу = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Результат = ПутьКФайлу;
		Возврат Результат;
	ИначеЕсли ВРег(ТипБольшогоРезультата) = ВРег("ВременноеХранилище")
		ИЛИ ВРег(ТипБольшогоРезультата) = "ВХ" Тогда
		АдресХранилища = Строка(Новый УникальныйИдентификатор);
		ПоместитьВоВременноеХранилище(ТекстЗапроса,АдресХранилища);
		Результат = АдресХранилища;
		Возврат Результат;
	КонецЕсли;
	
	ПробельныеСимволы = Новый Массив;
	ПробельныеСимволы.Добавить(Символы.Таб);
	Для Каждого ТекСимвол Из ПробельныеСимволы Цикл
		ДубльСимвол = ТекСимвол + ТекСимвол;
		Пока СтрНайти(ТекстЗапроса, ДубльСимвол) > 0 Цикл
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ДубльСимвол, ТекСимвол);
		КонецЦикла;
	КонецЦикла;
	
	Результат = Новый Массив;
	Пока Истина Цикл
		Результат.Добавить(Лев(ТекстЗапроса, МаксимальноеКоличествоСимволовДляОтладки));
		ТекстЗапроса = Сред(ТекстЗапроса, МаксимальноеКоличествоСимволовДляОтладки+1);
		Если СтрДлина(ТекстЗапроса) < МаксимальноеКоличествоСимволовДляОтладки Тогда
			Результат.Добавить(ТекстЗапроса);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Функция - Выгрузить результат запроса.
//
// Параметры:
//  РезультатЗапроса - РезультатЗапроса - Результат запроса выборка/пакет.
//  ТипРезультата - Строка - Тип из питОбщегоНазначения.ТипРезультата_[ИмяТипа]. Доступны:
//   ТаблицаЗначений,Массив,Соответствие.
//   По умолчанию "ТаблицаЗначений".
//  ДополнительныеПараметры - Структура - Требуется для передачи дополнительных параметров.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат выборки.
Функция ВыгрузитьРезультатЗапроса(РезультатЗапроса, ТипРезультата = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТипРезультата) Тогда
		ТипРезультата = ТипРезультата_ТаблицаЗначений();
	КонецЕсли;
	
	// Подготовим новую таблицу значений.
	ТЗ = Новый ТаблицаЗначений;
	
	СпособОбработкиВложенныхРезультатов = 0;
	ПереопределятьПустыеТипы = Ложь;
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("СпособОбработкиВложенныхРезультатов") Тогда
			СпособОбработкиВложенныхРезультатов = ДополнительныеПараметры.СпособОбработкиВложенныхРезультатов;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("ПереопределятьПустыеТипы") Тогда
			ПереопределятьПустыеТипы = ДополнительныеПараметры.ПереопределятьПустыеТипы;
		КонецЕсли;
		
	КонецЕсли;
	
	// Заполним колонки.
	ОписаниеТипаРезультатЗапроса = ОписаниеТипа(Тип("РезультатЗапроса"));
	ОписаниеТипаТаблицаЗначений = ОписаниеТипа(Тип("ТаблицаЗначений"));
	ОписаниеТипаДляПустыхТипов = ОбщегоНазначения.ОписаниеТипаСтрока(10);
	МассивКолонок = Новый Массив;
	МассивКолонокВложенныхВыборок = Новый Массив;
	Для каждого КолонкаРезультатЗапроса Из РезультатЗапроса.Колонки Цикл
		
		ИмяКолонки = КолонкаРезультатЗапроса.Имя;
		
		ТипКолонки = КолонкаРезультатЗапроса.ТипЗначения;
		Если СпособОбработкиВложенныхРезультатов > 0
			И КолонкаРезультатЗапроса.ТипЗначения = ОписаниеТипаРезультатЗапроса Тогда
			ТипКолонки = ОписаниеТипаТаблицаЗначений;
			МассивКолонокВложенныхВыборок.Добавить(ИмяКолонки);
		КонецЕсли;
		Если ПереопределятьПустыеТипы
			И НЕ ЗначениеЗаполнено(ТипКолонки.Типы()) Тогда
			ТипКолонки = ОписаниеТипаДляПустыхТипов;
		КонецЕсли;
		ТЗ.Колонки.Добавить(ИмяКолонки,ТипКолонки,,КолонкаРезультатЗапроса.Ширина);
		
		МассивКолонок.Добавить(ИмяКолонки);
		
	КонецЦикла;
	
	Если СпособОбработкиВложенныхРезультатов = 0 Тогда
		МассивКолонокВложенныхВыборок.Очистить();
	КонецЕсли;
	
	// Заполним таблицу.
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Для Каждого ТекКолонка Из МассивКолонокВложенныхВыборок Цикл
				Если СпособОбработкиВложенныхРезультатов = 1
					И НЕ Выборка[ТекКолонка].Пустой()
					ИЛИ СпособОбработкиВложенныхРезультатов = 2 Тогда
					НоваяСтрока[ТекКолонка] = ВыгрузитьРезультатЗапроса(Выборка[ТекКолонка],,ДополнительныеПараметры);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
	СписокКолонок = СтрСоединить(МассивКолонок, ", ");
	
	// В случае необходимости преобразования результирующего типа - выполним преобразование.
	Если ТипРезультата = ТипРезультата_ТаблицаЗначений() Тогда
		Результат = ТЗ;
	ИначеЕсли ТипРезультата = ТипРезультата_Соответствие() Тогда
		
		Результат = Новый Соответствие;
		Для Каждого ТекСтрока Из ТЗ Цикл
			СтруктураРезультата = Новый Структура(СписокКолонок);
			ЗаполнитьЗначенияСвойств(СтруктураРезультата, ТекСтрока);
			Результат.Вставить(ТекСтрока[ДополнительныеПараметры.Ключ], СтруктураРезультата);
		КонецЦикла;
		
	ИначеЕсли ТипРезультата = ТипРезультата_Массив() Тогда
		
		Результат = Новый Массив;
		Для Каждого ТекСтрока Из ТЗ Цикл
			СтруктураРезультата = Новый Структура(СписокКолонок);
			ЗаполнитьЗначенияСвойств(СтруктураРезультата, ТекСтрока);
			Результат.Добавить(СтруктураРезультата);
		КонецЦикла;
		
	Иначе
		Результат = ТЗ;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Тип результата.
//
// Возвращаемое значение:
//  Строка - Тип значения.
Функция ТипРезультата_ТаблицаЗначений() Экспорт
	Результат = "ТаблицаЗначений";
	Возврат Результат;
КонецФункции

// Функция - Тип результата..
//
// Возвращаемое значение:
//  Строка - Тип значения.
Функция ТипРезультата_Массив() Экспорт
	Результат = "Массив";
	Возврат Результат;
КонецФункции

// Функция - Тип результата..
//
// Возвращаемое значение:
//  Строка - Тип значения.
Функция ТипРезультата_Соответствие() Экспорт
	Результат = "Соответствие";
	Возврат Результат;
КонецФункции

// Создает объект ОписаниеТипов, содержащий тип по типу.
//
// Параметры:
//  ТипЗначения - Произвольный - Тип значения.
//
// Возвращаемое значение:
//  ОписаниеТипов - описание типа.
Функция ОписаниеТипа(ТипЗначения) Экспорт
	
	Если ТипЗнч(ТипЗначения) = Тип("Массив") Тогда
		МассивТипов = ТипЗначения;
	Иначе
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗначения);
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
КонецФункции

// Функция - Получить вложенные элементы справочника.
//
// Параметры:
//  СправочникСсылка - Произвольный - Справочник ссылка.
//  ВключатьЭлемент - Произвольный - Включать элемент.
//  ВыполнятьАвтоУпорядочивание - Произвольный - Выполнять авто упорядочивание.
//  ТипРезультата - Произвольный - Тип результата.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьВложенныеЭлементыСправочника(Знач СправочникСсылка, ВключатьЭлемент = Ложь, 
	ВыполнятьАвтоУпорядочивание = Ложь, 
	ТипРезультата = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТипРезультата) Тогда
		ТипРезультата = ТипРезультата_Массив();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СправочникСсылка) Тогда
		
		ПустойРезультат = Новый Массив;
		Если ТипРезультата = ТипРезультата_ТаблицаЗначений() Тогда
			ПустойРезультат = Новый ТаблицаЗначений;
			ПустойРезультат.Колонки.Добавить("Ссылка");
			ПустойРезультат.Колонки.Добавить("Родитель");
		КонецЕсли;
		
		Возврат ПустойРезультат;
		
	КонецЕсли;
	
	МассивСсылок = питОбщегоНазначенияКлиентСервер.ЗначениеВМассив(СправочникСсылка);
	
	Результат = Новый Массив;
	Если ТипРезультата = ТипРезультата_ТаблицаЗначений() Тогда
		ТипКолонкиСсылка = ТипЗнч(МассивСсылок[0]);
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("Ссылка", питОбщегоНазначения.ОписаниеТипа(ТипКолонкиСсылка));
		Результат.Колонки.Добавить("Родитель", питОбщегоНазначения.ОписаниеТипа(ТипКолонкиСсылка));
	КонецЕсли;
	
	СправочникМетаданные = МассивСсылок[0].Метаданные().Имя;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Справочник.Ссылка КАК Ссылка,
	|	Справочник.Родитель КАК Родитель
	|ИЗ
	|	Справочник.Номенклатура КАК Справочник
	|ГДЕ
	|	Справочник.Ссылка В ИЕРАРХИИ(&МассивЭлементов)
	|	И НЕ Справочник.Ссылка В (&МассивЭлементов)
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если ВключатьЭлемент Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И НЕ Справочник.Ссылка В (&МассивЭлементов)", "");
	КонецЕсли;
	
	Если НЕ ВыполнятьАвтоУпорядочивание Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "АВТОУПОРЯДОЧИВАНИЕ", "");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Номенклатура",СправочникМетаданные);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивЭлементов", МассивСсылок);
	Выборка = Запрос.Выполнить().Выбрать();
	Если ТипРезультата = ТипРезультата_ТаблицаЗначений() Тогда
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
	Иначе
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Получить всех вышестоящих родителей справочника.
//
// Параметры:
//  ЭлементСправочникаСсылка - Произвольный - Элемент справочника ссылка.
//  ВключатьСамЭлемент - Произвольный - Включать сам элемент.
//  ВыполнятьАвтоУпорядочивание - Произвольный - Выполнять авто упорядочивание.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьВсехВышестоящихРодителейСправочника(ЭлементСправочникаСсылка, ВключатьСамЭлемент = Истина,
	ВыполнятьАвтоУпорядочивание = Ложь) Экспорт
	
	МассивРодителей = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ЭлементСправочникаСсылка) Тогда
		Возврат МассивРодителей;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ИмяМетаданных.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИмяМетаданных КАК ИмяМетаданных
	|ГДЕ
	|	ИмяМетаданных.Ссылка В (&ЭлементСправочникаСсылка)
	|	И НЕ (ИмяМетаданных.Родитель = ЗНАЧЕНИЕ(Справочник.ИмяМетаданных.ПустаяСсылка))
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";
	Если НЕ ВыполнятьАвтоУпорядочивание Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "АВТОУПОРЯДОЧИВАНИЕ", "");
	КонецЕсли;

	ЭтоМассив = ТипЗнч(ЭлементСправочникаСсылка) = Тип("Массив");
	ЭлементМетаданных = ЭлементСправочникаСсылка;
	Если ЭтоМассив Тогда
		ЭлементМетаданных = ЭлементСправочникаСсылка[0];
	КонецЕсли;
	
	ТекМетаданные = ЭлементМетаданных.Метаданные();
	Если НЕ ТекМетаданные.Иерархический Тогда
		Если ВключатьСамЭлемент Тогда
			Если ЭтоМассив Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивРодителей, ЭлементСправочникаСсылка)
			Иначе
				МассивРодителей.Добавить(ЭлементСправочникаСсылка);
			КонецЕсли;
		КонецЕсли;
		Возврат МассивРодителей
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ИмяМетаданных", ЭлементМетаданных.Метаданные().Имя);
	Запрос.УстановитьПараметр("ЭлементСправочникаСсылка", ЭлементСправочникаСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Если ВключатьСамЭлемент Тогда
			Если ЭтоМассив Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивРодителей, ЭлементСправочникаСсылка)
			Иначе
				МассивРодителей.Добавить(ЭлементСправочникаСсылка);
			КонецЕсли;
		КонецЕсли;
		Возврат МассивРодителей;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивРодителей.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если НЕ ВключатьСамЭлемент Тогда
		МассивИсходныхЭлементов = питОбщегоНазначенияКлиентСервер.ЗначениеВМассив(ЭлементСправочникаСсылка);
		Для Каждого ТекЭлемент Из МассивИсходныхЭлементов Цикл
			ИндексУдаления = МассивРодителей.Найти(ТекЭлемент);
			Если ИндексУдаления = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МассивРодителей.Удалить(ИндексУдаления);
		КонецЦикла;
	КонецЕсли;

	Возврат МассивРодителей;
	
КонецФункции

#КонецОбласти

#Область РаботаСБуферомОбмена

// Процедура добавляет колонки рецептуры в таблицу буфера обмена
//
// Параметры:
//  ТаблицаСтрок - ТаблицаЗначений - Таблица буфера обмена.
//
Процедура ИнициализироватьТаблицуБуфераОбмена(ТаблицаСтрок) Экспорт
	
	ОписаниеТиповЧисло18_6 = ОбщегоНазначенияУТ.ПолучитьОписаниеТиповЧисла(18,6);
	ОписаниеТиповЧисло5_2 = ОбщегоНазначенияУТ.ПолучитьОписаниеТиповЧисла(5,2);
	ТаблицаСтрок.Колонки.Добавить("КоличествоУпаковокБрутто"			, ОписаниеТиповЧисло18_6);
	ТаблицаСтрок.Колонки.Добавить("КоличествоУпаковокНетто"				, ОписаниеТиповЧисло18_6);
	ТаблицаСтрок.Колонки.Добавить("КоличествоУпаковокВыход"				, ОписаниеТиповЧисло18_6);
	ТаблицаСтрок.Колонки.Добавить("КоличествоВыход"						, ОписаниеТиповЧисло18_6);
	ТаблицаСтрок.Колонки.Добавить("КоличествоБрутто"					, ОписаниеТиповЧисло18_6);
	ТаблицаСтрок.Колонки.Добавить("КоличествоНетто"						, ОписаниеТиповЧисло18_6);
	ТаблицаСтрок.Колонки.Добавить("Рецептура"							, Новый ОписаниеТипов("ДокументСсылка.питРецептура"));
	ТаблицаСтрок.Колонки.Добавить("ЗапретитьЗамены"						, Новый ОписаниеТипов("Булево"));
	ТаблицаСтрок.Колонки.Добавить("Замена"								, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСтрок.Колонки.Добавить("ХарактеристикаЗамены"				, Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаСтрок.Колонки.Добавить("ПроцентПотерьПриХолоднойОбработке"	, ОписаниеТиповЧисло5_2);
	ТаблицаСтрок.Колонки.Добавить("ПроцентПотерьПриГорячейОбработке"	, ОписаниеТиповЧисло5_2);
	ТаблицаСтрок.Колонки.Добавить("ПроцентСебестоимости"				, ОписаниеТиповЧисло5_2);
	ТаблицаСтрок.Колонки.Добавить("АлгоритмРасчетаКоличества"			, Новый ОписаниеТипов("Строка"));
	
КонецПроцедуры

#КонецОбласти

#Область ДинамическоеСозданиеЭлементовФормы

// Процедура - Создание динамического списка.
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  ИмяСписка - Произвольный - Имя списка.
//  ТекстЗапроса - Произвольный - Текст запроса.
//  МассивКолонок - Массив - Массив колонок.
//  СписокДействий - СписокЗначений - Список действий.
//  ТаблицаСписка - ТаблицаЗначений - Таблица списка.
//  ДобавитьВ - Произвольный - Добавить в.
//  ВставитьПеред - Произвольный - Вставить перед.
//  СвояКоманднаяПанель - Произвольный - Своя командная панель.
//  ПараметрыЗапроса - Произвольный - Параметры запроса.
//
Процедура СозданиеДинамическогоСписка(ЭтаФорма, ИмяСписка = "Список", ТекстЗапроса = "", МассивКолонок, 
	СписокДействий = Неопределено, ТаблицаСписка = "", ДобавитьВ = "", ВставитьПеред = "", СвояКоманднаяПанель = ЛОЖЬ,
	ПараметрыЗапроса = Неопределено) Экспорт
	
	Элементы = ЭтаФорма.Элементы;
	
	// Защита от дурака
	Если ТекстЗапроса = "" И ТаблицаСписка = "" Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Ошибка формирования динамического списка, укажите запрос или таблицу";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
																									
	// Создаем свою командную панель, тот случай когда я не нашел способа снять галочку "Автозаполнение"
	Если СвояКоманднаяПанель Тогда
		Если ВставитьПеред = "" Тогда
			ГруппаДинамическогоСписка  = Элементы.Добавить("Группа" + ИмяСписка + "СоСвоейКоманднойПанелью",Тип("ГруппаФормы"),?(ДобавитьВ = "",ЭтаФорма,ЭтаФорма.Элементы[ДобавитьВ]));
		Иначе
			ГруппаДинамическогоСписка  = Элементы.Вставить("Группа" + ИмяСписка + "СоСвоейКоманднойПанелью",Тип("ГруппаФормы"),?(ДобавитьВ = "",ЭтаФорма,ЭтаФорма.Элементы[ДобавитьВ]),ЭтаФорма.Элементы[ВставитьПеред]);			
		КонецЕсли;
		ГруппаДинамическогоСписка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаДинамическогоСписка.ОтображатьЗаголовок = Ложь;
		ГруппаДинамическогоСписка.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаДинамическогоСписка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		КоманднаяПанельСписка  = Элементы.Добавить(ИмяСписка + "КоманднаяПанель2",Тип("ГруппаФормы"),ГруппаДинамическогоСписка);
		КоманднаяПанельСписка.Вид = ВидГруппыФормы.КоманднаяПанель;			
	КонецЕсли;
									
	// Создаем реквизит формы
	ТипыРеквизита = Новый Массив;                             
	ТипыРеквизита.Добавить(Тип("ДинамическийСписок"));
	ОписаниеТиповДляРеквизита = Новый ОписаниеТипов(ТипыРеквизита); 
	ДинамическийСписок = Новый РеквизитФормы(ИмяСписка, ОписаниеТиповДляРеквизита,,"",ЛОЖЬ); //Имя реквизита
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок);        
	
	// Задаем свойства реквизиту
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);        
	РеквизитДинамическийСписок = ЭтаФорма[ИмяСписка]; //Имя реквизита
	Если ТекстЗапроса = "" Тогда
		РеквизитДинамическийСписок.ПроизвольныйЗапрос = ЛОЖЬ;
		РеквизитДинамическийСписок.ОсновнаяТаблица = ТаблицаСписка;
	Иначе
		РеквизитДинамическийСписок.ПроизвольныйЗапрос = ИСТИНА;
		РеквизитДинамическийСписок.ТекстЗапроса = ТекстЗапроса;
		Если ТаблицаСписка <> "" Тогда РеквизитДинамическийСписок.ОсновнаяТаблица = ТаблицаСписка; КонецЕсли;		
	КонецЕсли;
	
	// Заполняем параметры если они были указаны
	Если ПараметрыЗапроса <> Неопределено Тогда
		Для Каждого Параметра из ПараметрыЗапроса Цикл
			РеквизитДинамическийСписок.Параметры.УстановитьЗначениеПараметра(Параметра.Ключ,Параметра.Значение);	
		КонецЦикла;		 
	КонецЕсли;
	
	// Размещаем реквизит на форме
	Если ЛОЖЬ
		ИЛИ ВставитьПеред = "" 
		ИЛИ СвояКоманднаяПанель //Если своя командная панель тогда нет логики уже в параметре ВставитьПеред
		Тогда
		ТаблицаФормы = Элементы.Добавить(ИмяСписка,Тип("ТаблицаФормы"),?(СвояКоманднаяПанель,ГруппаДинамическогоСписка,?(ДобавитьВ = "",ЭтаФорма,ЭтаФорма.Элементы[ДобавитьВ])));
	Иначе
		ТаблицаФормы = Элементы.Вставить(ИмяСписка,Тип("ТаблицаФормы"),?(ДобавитьВ = "",ЭтаФорма,ЭтаФорма.Элементы[ДобавитьВ]),ЭтаФорма.Элементы[ВставитьПеред]);	
	КонецЕсли;		
	ТаблицаФормы.ПутьКДанным = ИмяСписка; //Имя реквизита 
	
	// Если своя панель тогда скрываем стандартную
	Если СвояКоманднаяПанель Тогда
		Элементы[ИмяСписка].ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	КонецЕсли;

	// Создание колонок на основание МассивКолонок
	Для Каждого Элемента Из МассивКолонок Цикл
		ПараметрыКолонки = СтрЗаменить(Элемента,",",Символы.ПС);
		Если СтрЧислоСтрок(ПараметрыКолонки) > 1 Тогда
			Заголовок = СтрПолучитьСтроку(ПараметрыКолонки, 1);
			ИмяКолонки = СтрПолучитьСтроку(ПараметрыКолонки, 2);
		Иначе
			Заголовок = "";
			ИмяКолонки = ПараметрыКолонки; 
		КонецЕсли;	
		НоваяКолонкаТаблицы = Элементы.Добавить(ИмяСписка + ИмяКолонки, Тип("ПолеФормы"), ТаблицаФормы);
		Если Заголовок <> "" Тогда 
			НоваяКолонкаТаблицы.Заголовок = Заголовок; 
		КонецЕсли;
		НоваяКолонкаТаблицы.ПутьКДанным = ИмяСписка + "." + ИмяКолонки; 	
	КонецЦикла;
	
	// Задаем действия (События) на основание СписокДействий, если он определен
	Если СписокДействий <> Неопределено Тогда 	
		ПереченьСвойств = "ПриИзменении
						|Выбор
						|ПриАктивизацииСтроки
						|ВыборЗначения
						|ПриАктивизацииПоля
						|ПриАктивизацииЯчейки
						|ПередНачаломДобавления
						|ПередНачаломИзменения
						|ПередУдалением
						|ПриНачалеРедактирования
						|ПередОкончаниемРедактирования
						|ПриОкончанииРедактирования
						|ОбработкаВыбора
						|ПередРазворачиванием
						|ПередСворачиванием
						|ПослеУдаления
						|ПриСменеТекущегоРодителя
						|ОбработкаЗаписиНового
						|ПриСохраненииПользовательскихНастроекНаСервере
						|ПередЗагрузкойПользовательскихНастроекНаСервере
						|ПриЗагрузкеПользовательскихНастроекНаСервере
						|ПриОбновленииСоставаПользовательскихНастроекНаСервере
						|ОбработкаЗапросаОбновления
						|ПриПолученииДанныхНаСервере
						|НачалоПеретаскивания
						|ПроверкаПеретаскивания
						|ОкончаниеПеретаскивания
						|Перетаскивание";
		Для Счетчик = 1 по 28 Цикл
			ИмяСвойства = СтрПолучитьСтроку(ПереченьСвойств, Счетчик);
			Элементы[ИмяСписка].УстановитьДействие(ИмяСвойства,?(СписокДействий.Свойство(ИмяСвойства),СписокДействий[ИмяСвойства],""));
		КонецЦикла;
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область Бухгалтерия

// Возвращает сумму выделенных ячеек табличного документа.
//
// Параметры:
//  Результат - Произвольный - Знач результат.
//  КэшВыделеннойОбласти - Произвольный - Кэш выделенной области.
//
// Возвращаемое значение:
// 	Число - Сумма значений ячеек.
Функция ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(Знач Результат, КэшВыделеннойОбласти) Экспорт
	
	Сумма = 0;
	Для Каждого КлючИЗначение Из КэшВыделеннойОбласти Цикл
		СтруктураАдресВыделеннойОбласти = КлючИЗначение.Значение;
		Для ИндексСтрока = СтруктураАдресВыделеннойОбласти.Верх По СтруктураАдресВыделеннойОбласти.Низ Цикл
			Для ИндексКолонка = СтруктураАдресВыделеннойОбласти.Лево По СтруктураАдресВыделеннойОбласти.Право Цикл
				Попытка
					Ячейка = Результат.Область(ИндексСтрока, ИндексКолонка, ИндексСтрока, ИндексКолонка);
					Если Ячейка.Видимость = Истина Тогда
						Если Ячейка.СодержитЗначение И ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда
							Сумма = Сумма + Ячейка.Значение;
						ИначеЕсли ЗначениеЗаполнено(Ячейка.Текст) Тогда
							ЧислоВЯчейке = Число(СтроковыеФункцииКлиентСервер.ЗаменитьОдниСимволыДругими(Символ(32)+Символ(43), Ячейка.Текст, Символ(0)));
							Сумма = Сумма + ЧислоВЯчейке;
						КонецЕсли;
					КонецЕсли;
				Исключение
					// Запись в журнал регистрации не требуется.
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	КэшВыделеннойОбласти.Вставить("Сумма", Сумма);
	
	Возврат Сумма;
	
КонецФункции

// Возвращает отборы динамического списка как значения заполнения при программном вводе новой строки в список.
//
// Параметры:
//  КомпоновщикНастроек - Произвольный - Знач компоновщик настроек.
//
// Возвращаемое значение:
//   Структура   - значения отборов для заполнения нового элемента списка.
Функция ЗначенияЗаполненияДинамическогоСписка(Знач КомпоновщикНастроек) Экспорт
	
	ЗначенияЗаполнения = Новый Структура;
	
	НастройкиСписка = КомпоновщикНастроек.ПолучитьНастройки();
	ДобавитьЗначенияЗаполнения(НастройкиСписка.Отбор.Элементы, ЗначенияЗаполнения);
	
	Возврат ЗначенияЗаполнения;

КонецФункции

// Заменяет отбор, установленный пользователем в сохраненной настройке списка, на отбор, установленный программно при
//  создании формы списка.
//  Вызывается при восстановлении пользовательских настроек динамического списка
//  из обработчика списка ПередЗагрузкойПользовательскихНастроекНаСервере.
//
// Параметры:
//  Список - ДинамическийСписок - Динамический список, для которого устанавливается отбор.
//  Настройки - ПользовательскиеНастройкиКомпоновкиДанных - Восстанавливаемые настройки списка.
//  ИмяОтбора - Строка - Имя элемента отбора.
//
Процедура ВосстановитьОтборСписка(Список, Настройки, ИмяОтбора) Экспорт

	Отборы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(
		Список.КомпоновщикНастроек.Настройки.Отбор, ИмяОтбора);
	
	Если Отборы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбора = Отборы[0];
	ИдентификаторНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки;
	
	Для каждого ЭлементНастроек Из Настройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастроек) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементНастроек.ИдентификаторПользовательскойНастройки = ИдентификаторНастройки Тогда
			ЭлементНастроек.ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
			ЭлементНастроек.Использование  = ЭлементОтбора.Использование;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Функция - Пересчитать цену при изменении флагов налогов.
//
// Параметры:
//  Цена - Произвольный - Цена.
//  ЦенаВключаетНДС - Произвольный - Цена включает ндс.
//  СуммаВключаетНДС - Произвольный - Сумма включает ндс.
//  СтавкаНДС - Произвольный - Ставка ндс.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПересчитатьЦенуПриИзмененииФлаговНалогов(Цена, ЦенаВключаетНДС,
						СуммаВключаетНДС, СтавкаНДС) Экспорт

	// Инициализация переменных
	НадоВключитьНДС  = Ложь;
	НадоИсключитьНДС = Ложь;
	НоваяЦена		 = Цена;

	Если СуммаВключаетНДС
		И (НЕ ЦенаВключаетНДС) Тогда
		
		// Надо добавлять НДС       
		НадоВключитьНДС = Истина;
	ИначеЕсли (НЕ СуммаВключаетНДС)
		И ЦенаВключаетНДС  Тогда
		
		// Надо исключать НДС       
		НадоИсключитьНДС = Истина;
	КонецЕсли;
		
	Если НадоИсключитьНДС Тогда
		НоваяЦена = (НоваяЦена * 100) / (100 + СтавкаНДС);
	КонецЕсли;

	Если НадоВключитьНДС Тогда
		НоваяЦена = (НоваяЦена * (100 + СтавкаНДС)) / 100;
	КонецЕсли;

	Возврат НоваяЦена;

КонецФункции // ПересчитатьЦенуПриИзмененииФлаговНалогов()

#КонецОбласти

// Получение синонима реквизита объекта метаданных.
//
// Параметры:
//  ЭтотОбъектМетаданные - Произвольный - Этот объект метаданные.
//  ИмяРеквизита - Произвольный - Имя реквизита.
//  ИмяТабличнойЧасти - Произвольный - Имя табличной части.
//
// Возвращаемое значение:
// 	СинонимРеквизита	 - Строка - Синоним реквизита объекта.
Функция ПолучитьСинонимРеквизита(ЭтотОбъектМетаданные,ИмяРеквизита="",ИмяТабличнойЧасти="") Экспорт
	Если ТипЗнч(ЭтотОбъектМетаданные)<>Тип("ОбъектМетаданных") Тогда
		ЭтотОбъектМетаданные= ЭтотОбъектМетаданные.Метаданные();
	КонецЕсли;
	СинонимРеквизита		= ИмяРеквизита;
	Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
		Реквизит	= ЭтотОбъектМетаданные.Реквизиты.Найти(ИмяРеквизита);
	Иначе
		Если ПустаяСтрока(ИмяРеквизита) Тогда
			Реквизит	= ЭтотОбъектМетаданные.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
		Иначе
			Реквизит	= ЭтотОбъектМетаданные.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты.Найти(ИмяРеквизита);
		КонецЕсли;
	КонецЕсли;
	Если Реквизит<>Неопределено Тогда
		СинонимРеквизита	= Реквизит.Синоним;
	КонецЕсли;
	Возврат СинонимРеквизита;
КонецФункции // ПолучитьСинонимРеквизита()

// Проверяет корректность заполнения элемента
//  по заполненности обязательных реквизитов и уникальности уникальных индексированных.
//
// Параметры:
//  ЭтотОбъект - СправочникОбъект - проверяемый объект.
//  Ошибки - Строка - содержит описание ошибок заполнения.
//  ДопРеквизиты - Структура - дополнительные реквизиты, обязательные для проверки.
//  Заполнение - Булево - если Истина, проверять на заполнение.
//  Уникальность - Булево - если Истина, проверка уникальности реквизитов.
//
// Возвращаемое значение:
//  Результат - Булево - корректность заполнения элемента.
Функция ПроверитьКорректность(ЭтотОбъект, Ошибки="", ДопРеквизиты=Неопределено, Заполнение=Истина, Уникальность=Истина) Экспорт
	Результат	= Истина;
	
	// Определимся это элемент или группа (для плана счетов всегда элемент).
	Попытка
		ЭтоГруппа		= ЭтотОбъект.ЭтоГруппа;
	Исключение
		ЭтоГруппа		= Ложь;
	КонецПопытки;
	// Получим список обязательных реквизитов
	Попытка
		Реквизиты			= ЭтотОбъект.ПолучитьОбязательныеРеквизиты(Не ЭтоГруппа, ЭтоГруппа);
	Исключение
		Возврат Результат;
	КонецПопытки;
	// Получим метаданные объекта
	ЭтотОбъектМетаданные= ЭтотОбъект.Метаданные();
	
	// Добавим дополнительные реквизиты
	Если ДопРеквизиты<>Неопределено Тогда
		Для Каждого ДопРеквизит Из ДопРеквизиты Цикл
			Реквизиты.Вставить(ДопРеквизит.Ключ,ДопРеквизит.Значение);
		КонецЦикла;
	КонецЕсли;
	
	// Проверим / установим заранее владельца, чтобы ниже в циклах этим не заниматься.
	ЭтоСправочник	= Ложь;
	Владелец		= Неопределено;
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЭтотОбъект.Ссылка)) Тогда // Владелец бывает только у справочников.
		ЭтоСправочник=Истина;
		Если ЗначениеЗаполнено(ЭтотОбъект.Владелец) Тогда
			Владелец=ЭтотОбъект.Владелец;
		КонецЕсли;
	КонецЕсли;
	
	// Пройдемся по списку реквизитов с проверкой.
	Для каждого Реквизит Из Реквизиты Цикл
		Если ТипЗнч(Реквизит.Значение)=Тип("Структура") Тогда
			// Проверяем табличную часть
			ТабличнаяЧасть			= ЭтотОбъект[Реквизит.Ключ];
			СписокНайденныхДублей	= Новый СписокЗначений();
			// Идем по табличной части
			Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
				// Создадим структуру отбора для проверки уникальности реквизитов
				Если Уникальность Тогда 
					СтруктураОтбора=Новый Структура();
				КонецЕсли;
				// Переберем обязательные реквизиты
				Для Каждого РеквизитТаблицы Из Реквизит.Значение Цикл
					Если (Заполнение) И (РеквизитТаблицы.Значение<>2) И (РеквизитТаблицы.Значение>0) И Не ЗначениеЗаполнено(СтрокаТаблицы[РеквизитТаблицы.Ключ]) Тогда
						Результат	= Ложь;
						Ошибки		= Ошибки+"Таблица <"+ПолучитьСинонимРеквизита(ЭтотОбъектМетаданные,,Реквизит.Ключ)+"> значение колонки <"+ПолучитьСинонимРеквизита(ЭтотОбъектМетаданные,РеквизитТаблицы.Ключ,Реквизит.Ключ)+"> не заполнено ! Строка номер "+СокрЛП(СтрокаТаблицы.НомерСтроки)+Символы.ПС;
						Продолжить; // Если реквизит таблицы не заполнен, проверять его уникальность нет смысла.
					КонецЕсли;
					// Заполним структуру отбора для проверки уникальности реквизитов.
					Если Уникальность И РеквизитТаблицы.Значение>1 Тогда
						СтруктураОтбора.Вставить(СокрЛП(РеквизитТаблицы.Ключ),СтрокаТаблицы[РеквизитТаблицы.Ключ]);
					КонецЕсли;
				КонецЦикла;
				// Проверка уникальности
				Если Уникальность И СтруктураОтбора.Количество()>0 И СписокНайденныхДублей.НайтиПоЗначению(СтрокаТаблицы)=Неопределено Тогда
					// Поищем строки, удовлетворяющие структуре отбора
					НайденныеСтроки	= ТабличнаяЧасть.НайтиСтроки(СтруктураОтбора);
					// Если найдены больше 1, то строки не уникальные
					Если НайденныеСтроки.Количество()>1 Тогда
						// Добавим строку в список найденных дублей, чтобы не сообщать о ней еще раз.
						Результат			= Ложь;
						ДублирующиесяСтроки	= ""; 
						// Выведем строку сообщения
						Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
							ДублирующиесяСтроки	= ДублирующиесяСтроки+","+СокрЛП(НайденнаяСтрока.НомерСтроки);
							// Добавим строку в список найденных дублей, чтобы не сообщать о ней еще раз.
							СписокНайденныхДублей.Добавить(НайденнаяСтрока);
						КонецЦикла;
						СтрокаРеквизитов="";
						Для Каждого РеквизитТаблицы Из СтруктураОтбора Цикл
							СтрокаРеквизитов=СтрокаРеквизитов+?(ПустаяСтрока(СтрокаРеквизитов),"",",")+РеквизитТаблицы.Ключ;
						КонецЦикла;
						Ошибки=Ошибки+"Таблица <"+ПолучитьСинонимРеквизита(ЭтотОбъектМетаданные,,Реквизит.Ключ)+"> значения колонки <"+ПолучитьСинонимРеквизита(ЭтотОбъектМетаданные,РеквизитТаблицы.Ключ,Реквизит.Ключ)+"> не уникальны ! Строки: "+Сред(ДублирующиесяСтроки,2)+Символы.ПС;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		Иначе // Обычный реквизит справочника
			// Сначала проверим заполнение (параметры структуры 1 или 3).
			Если Заполнение 
				И ((Реквизит.Значение=1) ИЛИ (Реквизит.Значение=3) ИЛИ (Реквизит.Значение=Неопределено))
				И НЕ ЗначениеЗаполнено(ЭтотОбъект[Реквизит.Ключ]) Тогда
				Результат	= Ложь;
				Ошибки		= Ошибки+"Реквизит """+ПолучитьСинонимРеквизита(ЭтотОбъектМетаданные,Реквизит.Ключ)+""" не заполнен !"+Символы.ПС;
				Продолжить; // Если реквизит не заполнен, проверять его уникальность нет смысла
			КонецЕсли;
			// Проверим уникальность (параметры структуры 2 или 3)
			// Проверку сделаем прямым сравнением (а не >2) во избежание ошибки при нечисловом типе значения.
			Если (Уникальность) И ((Реквизит.Значение=2) ИЛИ (Реквизит.Значение=3)) Тогда
				ИмяОбъекта = ЭтотОбъект.Метаданные().Имя;
				Если Метаданные.Справочники.Найти(ИмяОбъекта) <> Неопределено Тогда
					// Имеем справочник
					Менеджер	= Справочники[ЭтотОбъект.Метаданные().Имя];
				ИначеЕсли Метаданные.ПланыВидовХарактеристик.Найти(ИмяОбъекта) <> Неопределено Тогда
					// Имеем ПВХ
					Менеджер	= ПланыВидовХарактеристик[ЭтотОбъект.Метаданные().Имя];
				ИначеЕсли Метаданные.ПланыВидовРасчета.Найти(ИмяОбъекта) <> Неопределено Тогда
					// Имеем ПВР
					Менеджер	= ПланыВидовРасчета[ЭтотОбъект.Метаданные().Имя];
				Иначе
				КонецЕсли;
				
				Если Реквизит.Ключ="Наименование" Тогда
					Если ЭтоСправочник Тогда
						НайденнаяСсылка	= Менеджер.НайтиПоНаименованию(ЭтотОбъект.Наименование,Истина,,Владелец);
					Иначе
						НайденнаяСсылка	= Менеджер.НайтиПоНаименованию(ЭтотОбъект.Наименование,Истина);
					КонецЕсли;
				ИначеЕсли Реквизит.Ключ="Код" Тогда
					Если ЭтоСправочник Тогда
						Запрос = Новый Запрос;
						Запрос.Текст = 
						"ВЫБРАТЬ ПЕРВЫЕ 1
						|	"+ ИмяОбъекта + ".Ссылка
						|ИЗ
						|	Справочник."+ ИмяОбъекта + " КАК "+ ИмяОбъекта + "
						|ГДЕ
						|	"+ ИмяОбъекта + ".Код = &Код 
						|	И "+ ИмяОбъекта + ".Ссылка <> &Ссылка ";
						Если ЗначениеЗаполнено(Владелец) Тогда
							ЗАпрос.Текст = ЗАпрос.Текст + "
							|	И "+ ИмяОбъекта + ".Владелец = &Владелец"
						КонецЕсли; 
						Запрос.УстановитьПараметр("Код",ЭтотОбъект.Код);
						Запрос.УстановитьПараметр("Ссылка",ЭтотОбъект.Ссылка);
						Запрос.УстановитьПараметр("Владелец",Владелец);
						Выборка = Запрос.Выполнить().Выбрать();
						Если Выборка.Следующий() Тогда
							НайденнаяСсылка = Выборка.Ссылка;
						Иначе	
							НайденнаяСсылка = Менеджер.ПустаяСсылка();
						КонецЕсли; 
					Иначе
						НайденнаяСсылка=Менеджер.НайтиПоКоду(ЭтотОбъект.Код);
					КонецЕсли;
				Иначе // реквизит
					Если ЭтоСправочник Тогда
						НайденнаяСсылка	= Менеджер.НайтиПоРеквизиту(Реквизит.Ключ,ЭтотОбъект[Реквизит.Ключ],,Владелец);
					Иначе
						НайденнаяСсылка	= Менеджер.НайтиПоРеквизиту(Реквизит.Ключ,ЭтотОбъект[Реквизит.Ключ]);
					КонецЕсли;
				КонецЕсли;
				
				Если (ЗначениеЗаполнено(НайденнаяСсылка)) И (НайденнаяСсылка<>ЭтотОбъект.Ссылка) Тогда
					Результат	= Ложь;
					Ошибки		= Ошибки+"Реквизит """+ПолучитьСинонимРеквизита(ЭтотОбъектМетаданные,Реквизит.Ключ)+""" не уникален !";
					Если ЗначениеЗаполнено(Владелец) Тогда
						Ошибки	= Ошибки+" (В пределах владельца: "+СокрЛП(Владелец)+")";
					КонецЕсли;
					Ошибки		= Ошибки+Символы.ПС;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции // ПроверитьКорректность()

// Возвращает путь к каталогу компоненты защиты
//
// Возвращаемое значение:
// 	 Строка - Каталог.
Функция ПолучитьКаталогКомпонентыЗащиты() Экспорт
	
	ПутьПоУмолчанию = "";
	Попытка 
		WS=Новый COMОбъект("WScript.Shell");
		ПутьПоУмолчанию=WS.RegRead("HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders\Common AppData");
		Если НЕ ПустаяСтрока(ПутьПоУмолчанию) И (Прав(ПутьПоУмолчанию,1)<>"\") Тогда
			ПутьПоУмолчанию=ПутьПоУмолчанию+"\";
		КонецЕсли;
	Исключение
		ПутьПоУмолчанию="C:\1C-Rarus\";	
	КонецПопытки;
	
	Если НЕ ПустаяСтрока(ПутьПоУмолчанию) Тогда
		ПутьПоУмолчанию=ПутьПоУмолчанию+"Protect\LocalProtect\";  
	КонецЕсли;
	
	Возврат ПутьПоУмолчанию;
	
КонецФункции // ПолучитьКаталогКомпонентыЗащиты()

// Процедура меняет связи параметров выбора переданного элемента.
//
// Параметры:
//  Элемент - ПолеФормы - Элемент формы.
//  Имя - Строка - Имя связи.
//  НоваяСвязьПараметровВыбора - СвязьПараметровВыбора - Новая связь параметров выбора.
//
Процедура ЗаменитьСвязьПараметровВыбора(Элемент, Имя, НоваяСвязьПараметровВыбора) Экспорт


	МассивСвязей = Новый Массив;
	Для Каждого СвязьПараметровВыбора Из Элемент.СвязиПараметровВыбора Цикл
		Если ВРег(СвязьПараметровВыбора.Имя) <> ВРег(Имя) Тогда
			МассивСвязей.Добавить(СвязьПараметровВыбора);
		КонецЕсли;
	КонецЦикла;

	Элемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый Массив);
	МассивСвязей.Добавить(НоваяСвязьПараметровВыбора);
	Элемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязей);

КонецПроцедуры

