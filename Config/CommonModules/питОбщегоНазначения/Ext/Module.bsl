// Формирует штрих-код в формате EAN-13 для товара
//
// Возвращаемое значение:
//  НовыйКод - число - сформированный штрих-код
Функция СформироватьШтрихКодТовара() Экспорт
	ЗащитаОтЗацикливания=100;
	Счетчик=0;
	ПрефиксШтрихКода = Формат(Константы.питПрефиксШтрихКода.Получить(), "ЧЦ=2; ЧДЦ=0; ЧГ=");
	ДлинаПрефикса=СтрДлина(ПрефиксШтрихКода);
	Пока Истина Цикл
		МоментВремени = ТекущаяДата();
		Год 	= Число(Формат(МоментВремени, "ДФ=yyyy"));
		Месяц 	= Число(Формат(МоментВремени, "ДФ=MM"));
		День	= Число(Формат(МоментВремени, "ДФ=dd"));
		Час 	= Число(Формат(МоментВремени, "ДФ=чч"));
		Минута 	= Число(Формат(МоментВремени, "ДФ=мм"));
		Секунда	= Число(Формат(МоментВремени, "ДФ=сс"));
		
		НовыйКод = Формат(2764800*Месяц + 86400*День + 3600*Час + 60*Минута+Секунда, "ЧЦ=8; ЧДЦ=0; ЧГ=");
		ДлинаКода = СтрДлина(НовыйКод);
		ДлинаРандомКода = 12 - (ДлинаПрефикса + ДлинаКода);
		
		// Защита от модификаторов кода тоже
		РандомКод = СформироватьПроизвольныйКод(ДлинаРандомКода);
		Если ДлинаПрефикса + ДлинаРандомКода + ДлинаКода = 12 Тогда
			НовыйКод = ПрефиксШтрихКода + РандомКод + НовыйКод;
		Иначе
			НовыйКод = ПрефиксШтрихКода + Лев(РандомКод, 12 - (ДлинаПрефикса + ДлинаКода)) + НовыйКод;
		КонецЕсли;
		
		// Добавим контрольный символ EAN13
		НовыйКод = EAN13(НовыйКод);
		
		Если ШтрихКодУникален(НовыйКод) Тогда
			Прервать;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		Если Счетчик >= ЗащитаОтЗацикливания Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат НовыйКод;
КонецФункции

// Формирует случайный код в произвольном цифровом формате (для служебных целей).
//  Возвращает строку чисел, если АлфавитноЦифровой=0, и буквенно-цифровую A-Z&0-9 иначе.
//
// Параметры:
//  КоличествоЗнаков - число - длина кода.
//  АлфавитноЦифровой - цифровую A - Z&0-9 иначе.
//   Параметры:
//   Параметры.
//
// Возвращаемое значение:
//  Стр - строка - сформированный произвольный код.
Функция СформироватьПроизвольныйКод(КоличествоЗнаков = 20, АлфавитноЦифровой = 0) Экспорт
	Стр = "";
	ИндексСлучайных = 0;
	НаборСлучайных = ИнициализацияСлучайнойПоследовательности(, ИндексСлучайных);
	Для К = 1 по ОкрВверх(КоличествоЗнаков / 4) Цикл
		Стр = Стр + Формат(СлучайноеЧисло(4, НаборСлучайных, ИндексСлучайных), "ЧЦ=4; ЧДЦ=0; ЧВН=; ЧГ=");
	КонецЦикла;
	Возврат Лев(Стр, КоличествоЗнаков);
КонецФункции

// Вычисляет контрольную цифру EAN-13/EAN-8.
//  Возвращает штрих-код с контрольной цифрой.
//
// Параметры:
//  Код - Произвольный - Знач код.
//
// Возвращаемое значение:
//  Рез - Строка - штрих-код с контрольной цифрой. 
Функция EAN13(Знач Код) Экспорт
	
	Если СтрДлина(Код) <= 8 Тогда
		EAN8 = Истина;
		Код = Лев(Код, 7);
	Иначе
		EAN8 = Ложь;
		Код = Лев(Код, 12);
	КонецЕсли;
	
	Попытка
		ШтрихКод = Формат(Число(Код),"ЧЦ="+?(EAN8,"7","12")+"; ЧДЦ=; ЧН=; ЧВН=; ЧГ=");
	Исключение
		ШтрихКод = Формат(Число(0),"ЧЦ="+?(EAN8,"7","12")+"; ЧДЦ=; ЧН=; ЧВН=; ЧГ=");
	КонецПопытки;
	Если ПустаяСтрока(ШтрихКод) Тогда
		Возврат 0;
	КонецЕсли; 
	
	Четн = 0;
	Нечетн = 0;
	Если EAN8 Тогда
		Итераций = 4;
		ШтрихКод = ШтрихКод + "0"; // незначащий восьмой символ, чтобы цикл прошел.
	Иначе
		Итераций = 6;
	КонецЕсли;
	Для Индекс = 1 По Итераций Цикл
		Четн = Четн + Сред(ШтрихКод, 2 * Индекс, 1);
		Нечетн = Нечетн + Сред(ШтрихКод, 2 * Индекс - 1, 1);
	КонецЦикла;
	Если EAN8 Тогда
		Нечетн = Нечетн * 3;
	Иначе 
		Четн = Четн * 3;
	КонецЕсли;
	КонтЦифра = 10 - (Четн + Нечетн) % 10;
	Если КонтЦифра = 10 Тогда 
		КонтЦифра = 0;
	КонецЕсли;
	
	Рез = Код + Строка(КонтЦифра);
	Возврат Рез;
	
КонецФункции // EAN13

// Функция проверяет уникальность штрих-кода
//  Параметры
//
// Параметры:
//  ШтрихКод - Произвольный - Штрих код.
//  Ссылка - Произвольный - Ссылка.
//
// Возвращаемое значение:
//  Булево - если код уникальный
Функция ШтрихКодУникален(ШтрихКод, Ссылка = Неопределено) Экспорт
	Если ПустаяСтрока(ШтрихКод) Тогда
		Возврат Истина;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питКарточки.Ссылка КАК Объект
	|ИЗ
	|	Справочник.питКарточки КАК питКарточки
	|ГДЕ
	|	питКарточки.ДанныеКарты = &ШтрихКод
	|	И питКарточки.Ссылка <> &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.питШтрихКод = &ШтрихКод
	|	И Номенклатура.Ссылка <> &Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли; 
	
КонецФункции

