КонецФункции 

// Функция производит преобразование из X системы счисления в Y
//
// Параметры:
//  ЧислоXСистемы - Число - Число x системы.
//  ШаблонXСистемы - Произвольный - Знач шаблон x системы.
//  ШаблонYСистемы - Произвольный - Знач шаблон y системы.
//
// Возвращаемое значение:
//  Число - преобразованное число в системе счислений Y.
Функция ПреобразоватьВСистемуСчисления(ЧислоXСистемы, Знач ШаблонXСистемы, Знач ШаблонYСистемы) Экспорт
	
	ШаблонXСистемы = ВРег(ШаблонXСистемы);
	ШаблонYСистемы = ВРег(ШаблонYСистемы);
	
	// Вначале определим разрядность основания
	ОснованиеXСистемы = СтрДлина(ШаблонXСистемы);
	ОснованиеYСистемы = СтрДлина(ШаблонYСистемы);
	
	Если ОснованиеXСистемы = 10 Тогда
		ЧислоYРешение = "";
		ЦелаяЧасть = ЧислоXСистемы;
		
		Остаток = ЦелаяЧасть % ОснованиеYСистемы;
		ЦелаяЧасть = Цел(ЦелаяЧасть / ОснованиеYСистемы);
		
		ЧислоYРешение = Сред(ШаблонYСистемы,Остаток+1,1) + ЧислоYРешение;
		Пока Остаток > 0 Или ЦелаяЧасть > 0 Цикл

			Остаток = ЦелаяЧасть % ОснованиеYСистемы;
			ЦелаяЧасть = Цел(ЦелаяЧасть / ОснованиеYСистемы);
			
			ЧислоYРешение = Сред(ШаблонYСистемы,Остаток+1,1) + ЧислоYРешение;
		КонецЦикла;
		
		Возврат ЧислоYРешение;
	ИначеЕсли ОснованиеYСистемы = 10 Тогда
		ЧислоYРешение = 0;
		НомерРазряда = 0;
		Пока НомерРазряда < СтрДлина(ЧислоXСистемы) Цикл
			НомерРазряда = НомерРазряда + 1;
			// Найдем символ в шаблон
			Множитель = Макс(Найти(ШаблонXСистемы, Сред(Строка(ЧислоXСистемы),НомерРазряда,1))-1,0);
			
			ЧислоYРешение = ЧислоYРешение + Множитель * Pow(ОснованиеXСистемы,СтрДлина(ЧислоXСистемы)-НомерРазряда);
			
		КонецЦикла;
		Возврат ЧислоYРешение;
	Иначе
		// Вначале преобразуем в десятиричную
		ЧислоВДесятичнойСистеме = ПреобразоватьВСистемуСчисления(ЧислоXСистемы, ШаблонXСистемы, "0123456789");
		ЧислоВДесятичнойСистеме = Число(ЧислоВДесятичнойСистеме);
		Возврат ПреобразоватьВСистемуСчисления(ЧислоВДесятичнойСистеме, "0123456789", ШаблонYСистемы);
	КонецЕсли;
	
	
КонецФункции

// Функция получает текущую версию конфигурации ERP в строковом представлении.
//
// Параметры:
//  ВыводитьРелиз - Булево - Выводить релиз.
//  ВыводитьБилд - Булево - Выводить билд.
//
// Возвращаемое значение:
//  Строка - Версия конфигурации в формате x.x.x.x
Функция ПолучитьВерсиюКонфигурацииУправлениеПредприятием(ВыводитьРелиз = Ложь, ВыводитьБилд = Ложь) Экспорт
	
	ПолнаяВерсияМассив = СтрРазделить(Метаданные.Версия, ".");
	РезультатВерсияМассив = Новый Массив;
	Если ПолнаяВерсияМассив.Количество() >= 2 Тогда
		РезультатВерсияМассив.Добавить(ПолнаяВерсияМассив[0]);
		РезультатВерсияМассив.Добавить(ПолнаяВерсияМассив[1]);
	КонецЕсли;
	Если ВыводитьРелиз И ПолнаяВерсияМассив.Количество() >= 3 Тогда
		РезультатВерсияМассив.Добавить(ПолнаяВерсияМассив[2]);
	КонецЕсли;
	Если ВыводитьБилд И ПолнаяВерсияМассив.Количество() >= 4 Тогда
		РезультатВерсияМассив.Добавить(ПолнаяВерсияМассив[3]);
	КонецЕсли;
	Результат = СтрСоединить(РезультатВерсияМассив, ".");
	Возврат Результат;
	
КонецФункции

// Функция проверяет, является ли переданный вид номенклатуры видом номенклатуры общепита
//  (по регистру "питВидыНоменклатурыОбщепит").
//
// Параметры:
//  ВидНоменклатуры - СправочникСсылка.ВидыНоменклатуры - Вид номенклатуры на проверку.
//
// Возвращаемое значение:
//  Булево - Результат работы функции.
Функция  ЭтоВидНоменклатурыОбщепит(ВидНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питВидыНоменклатурыОбщепит.ВидНоменклатуры КАК ВидНоменклатуры
		|ИЗ
		|	РегистрСведений.питВидыНоменклатурыОбщепит КАК питВидыНоменклатурыОбщепит
		|ГДЕ
		|	питВидыНоменклатурыОбщепит.ВидНоменклатуры = &ВидНоменклатуры";
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

// Функция - Пустая таблица по результат запроса.
//
// Параметры:
//  РезультатЗапроса - Произвольный - Результат запроса.
//  ВыгружатьЗапрос - Произвольный - Выгружать запрос.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПустаяТаблицаПоРезультатуЗапроса(РезультатЗапроса, ВыгружатьЗапрос = Ложь) Экспорт
	
	Если ВыгружатьЗапрос Тогда
		ТаблицаДанных = питОбщегоНазначения.ВыгрузитьРезультатЗапроса(РезультатЗапроса);
		Возврат ТаблицаДанных;
	КонецЕсли;
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	Для каждого КолонкаРезультатЗапроса Из РезультатЗапроса.Колонки Цикл
		ТаблицаДанных.Колонки.Добавить(КолонкаРезультатЗапроса.Имя,
			КолонкаРезультатЗапроса.ТипЗначения,,
			КолонкаРезультатЗапроса.Ширина);
	КонецЦикла;

	Возврат ТаблицаДанных;
КонецФункции

// Добавляет в таблицу колонку по имени если колонки с таким именем нет.
//
// Параметры:
//  Таблица - ТаблицаЗначений - Таблица которую обрабатываем.
//  ИмяКолонки - Строка - Имя Колонки.
//  ТипКолонки - Тип - Не обязательный. Если не указан то делаем ОписаниеТипов число 15,2 для сумм.
//
Процедура ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонки, ТипКолонки) Экспорт
	
	Если НЕ Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТипКолонки) = Тип("ОписаниеТипов") Тогда
		ОписаниеТипаКолонки = ТипКолонки;
	Иначе
		ОписаниеТипаКолонки = питОбщегоНазначения.ОписаниеТипа(ТипКолонки);
	КонецЕсли;
	
	Таблица.Колонки.Добавить(ИмяКолонки, ОписаниеТипаКолонки);
	
КонецПроцедуры

// Функция - Свернуть таблицу значений.
//
// Параметры:
//  ИсходнаяТаблицаЗначений - ТаблицаЗначений - Исходная таблица значений.
//  КолонкиГруппировок - Произвольный - Колонки группировок.
//  КолонкиСуммирования - Произвольный - Колонки суммирования.
//  КолонкиМаксимума - Произвольный - Колонки максимума.
//  КолонкиМинимума - Произвольный - Колонки минимума.
//  ТекстОтбора - Произвольный - Текст отбора.
//  ПараметрыОтбора - Произвольный - Параметры отбора.
//  КолонкиКоличество - Произвольный - Колонки количество.
//  КолонкиКоличествоРазличные - Произвольный - Колонки количество различные.
//  ТекстОтбораИмеющие - Произвольный - Текст отбора имеющие.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
Функция СвернутьТаблицуЗначений(ИсходнаяТаблицаЗначений, 
									КолонкиГруппировок = "", 
									КолонкиСуммирования = "", 
									КолонкиМаксимума = "", 
									КолонкиМинимума = "",
									ТекстОтбора = "",
									ПараметрыОтбора = Неопределено,
									КолонкиКоличество = "",
									КолонкиКоличествоРазличные = "",
									ТекстОтбораИмеющие = "") Экспорт
									
	// Инициализация параметров
	Если ПараметрыОтбора = Неопределено Тогда
		ПараметрыОтбора = Новый Структура;
	КонецЕсли;
	
	СписокПолейПакетаИнициализации = Новый Массив;
	
	// Подготовим порядок обхода.
	СтруктураСвертки = Новый Структура;
	СтруктураСвертки.Вставить("Группировки", КолонкиГруппировок);
	СтруктураСвертки.Вставить("Сумма", КолонкиСуммирования);
	СтруктураСвертки.Вставить("Максимум", КолонкиМаксимума);
	СтруктураСвертки.Вставить("Минимум", КолонкиМинимума);
	СтруктураСвертки.Вставить("Количество", КолонкиКоличество);
	СтруктураСвертки.Вставить("КоличествоРазличные", КолонкиКоличествоРазличные);
	
	СчетчикСлужебныхПолей = 0;
	СтруктураПолей = Новый Структура;
	Для Каждого ТекНабор Из СтруктураСвертки Цикл
		
		// Получим шаблон поля.
		ИмяТаблицыИнициализации = "ИсходнаяТаблица.";
		ШаблонПоляИнициализации = "%1%2 КАК %3";
		Если ТекНабор.Ключ = "Группировки" Тогда
			ШаблонПоля = "ИсходнаяТаблица.%1";
		ИначеЕсли ТекНабор.Ключ = "Сумма" Тогда
			ШаблонПоляИнициализации = "ВЫБОР
			|			КОГДА %1%2 = НЕОПРЕДЕЛЕНО
			|			ТОГДА 0
			|			ИНАЧЕ %1%2
			|		КОНЕЦ КАК %3";
			ШаблонПоля = "СУММА(ИсходнаяТаблица.%1) КАК %2";
		ИначеЕсли ТекНабор.Ключ = "Максимум" Тогда
			ШаблонПоля = "МАКСИМУМ(ИсходнаяТаблица.%1) КАК %2";
		ИначеЕсли ТекНабор.Ключ = "Минимум" Тогда
			ШаблонПоля = "МИНИМУМ(ИсходнаяТаблица.%1) КАК %2";
		ИначеЕсли ТекНабор.Ключ = "Количество" Тогда
			ШаблонПоля = "КОЛИЧЕСТВО(ИсходнаяТаблица.%1) КАК %2";
		ИначеЕсли ТекНабор.Ключ = "КоличествоРазличные" Тогда
			ШаблонПоля = "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИсходнаяТаблица.%1) КАК %2";
		Иначе
			Продолжить;
		КонецЕсли;
		
		// Список колонок приходит через ","
		ПсевдонимПоКлючу = Истина;
		Если ТипЗнч(ТекНабор.Значение) = Тип("Структура") Тогда
			НазваниеПолей = ТекНабор.Значение;
			ПсевдонимПоКлючу = Ложь;
		ИначеЕсли ТипЗнч(ТекНабор.Значение) = Тип("Массив") Тогда
			НазваниеПолей = ТекНабор.Значение;
		Иначе
			НазваниеПолей = СтрРазделить(ТекНабор.Значение,",");
		КонецЕсли;
		
		СписокПолейПакетаВыборки = Новый Массив;
		Для Каждого ТекПоле Из НазваниеПолей Цикл
			Если ПсевдонимПоКлючу Тогда
				КлючПоля = СокрЛП(ТекПоле);
				ЗначениеПоля = КлючПоля;
			Иначе
				КлючПоля = ТекПоле.Ключ;
				ЗначениеПоля = СокрЛП(ТекПоле.Значение);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ЗначениеПоля) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеПоляИнициализации = КлючПоля;
			Если СтрДлина(КлючПоля) = 1
				И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(КлючПоля) Тогда
				СчетчикСлужебныхПолей = СчетчикСлужебныхПолей + 1;
				ИмяТаблицыИнициализации = "";
				КлючПоля = СтрШаблон("питСлужебноеПоле%1", СчетчикСлужебныхПолей);
				ЗначениеПоля = КлючПоля;
			КонецЕсли;
			
			ТекстПоля = СтрШаблон(ШаблонПоляИнициализации, ИмяТаблицыИнициализации, ЗначениеПоляИнициализации, КлючПоля);
			Если СписокПолейПакетаИнициализации.Найти(ТекстПоля) = Неопределено Тогда
				СписокПолейПакетаИнициализации.Добавить(ТекстПоля);                      
			КонецЕсли;
			Если ТекНабор.Ключ = "Группировки" Тогда
				ТекстПоля = СтрШаблон(ШаблонПоля, КлючПоля);
			Иначе
				ТекстПоля = СтрШаблон(ШаблонПоля, КлючПоля, ЗначениеПоля);
			КонецЕсли;
			СписокПолейПакетаВыборки.Добавить(ТекстПоля);
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(СписокПолейПакетаВыборки) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстПолей = СтрСоединить(СписокПолейПакетаВыборки, ",
		|	");
		
		СтруктураПолей.Вставить(ТекНабор.Ключ, ТекстПолей);
		
	КонецЦикла;
	
	МассивЗапроса = Новый Массив;
	
	Для Каждого ТекНабор Из СтруктураПолей Цикл
		
		ТекстПолей = ТекНабор.Значение;
		Если НЕ ЗначениеЗаполнено(ТекстПолей) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(МассивЗапроса) Тогда
			МассивЗапроса.Добавить(",");
		КонецЕсли;
		
		МассивЗапроса.Добавить(ТекстПолей);
		
	КонецЦикла;
	
	Если СтруктураПолей.Свойство("Группировки")
		И ЗначениеЗаполнено(СтруктураПолей.Группировки) Тогда
		ТекстПолейГруппировки = СтруктураПолей.Группировки;
	Иначе
		ТекстПолейГруппировки = "питСлужебноеПоле_ДляГруппировки";
		СписокПолейПакетаИнициализации.Добавить("0 КАК питСлужебноеПоле_ДляГруппировки");
	КонецЕсли;
	
	МассивЗапроса.Вставить(0, "ВЫБРАТЬ");
	
	МассивЗапроса.Добавить("ИЗ
	|	ИсходнаяТаблица КАК ИсходнаяТаблица
	|СГРУППИРОВАТЬ ПО");
	МассивЗапроса.Добавить(ТекстПолейГруппировки);
	
	Если ЗначениеЗаполнено(ТекстОтбораИмеющие) Тогда
		МассивЗапроса.Добавить("ИМЕЮЩИЕ");
		МассивЗапроса.Добавить(ТекстОтбораИмеющие);
	КонецЕсли;
	
	МассивПакетов = Новый Массив;
	ТекстПакетаПоУмолчанию = "ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ ИсходнаяТаблица
	|ИЗ
	|	&ИсходнаяТаблица КАК ИсходнаяТаблица
	|ГДЕ 
	|	&ТекстОтбора";
	Если НЕ ЗначениеЗаполнено(ТекстОтбора) Тогда
		ТекстОтбора = "ИСТИНА";
	КонецЕсли;
	ТекстПолейИнициализации = СтрСоединить(СписокПолейПакетаИнициализации, ",
		|	");
	ТекстПакетаПоУмолчанию = СтрЗаменить(ТекстПакетаПоУмолчанию, "*", ТекстПолейИнициализации);
	ТекстПакетаПоУмолчанию = СтрЗаменить(ТекстПакетаПоУмолчанию, "&ТекстОтбора", ТекстОтбора);
	
	МассивПакетов.Добавить(ТекстПакетаПоУмолчанию);
	МассивПакетов.Добавить(СтрСоединить(МассивЗапроса, Символы.ПС));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИсходнаяТаблица", ИсходнаяТаблицаЗначений);
	Запрос.Текст = СтрСоединить(МассивПакетов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Для Каждого ТекСвойство Из ПараметрыОтбора Цикл
		Запрос.УстановитьПараметр(ТекСвойство.Ключ, ТекСвойство.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если ЗначениеЗаполнено(ИсходнаяТаблицаЗначений) Тогда
		Результат = ВыгрузитьРезультатЗапроса(РезультатЗапроса);
	Иначе
		Результат = ПустаяТаблицаПоРезультатуЗапроса(РезультатЗапроса);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Возвращает простые типы.
//
// Возвращаемое значение:
//  Соответствие - Простых типы и значения по умолчанию.
Функция ПростыеТипы() Экспорт

	Результат = Новый Соответствие;
	Результат[Тип("Строка")] = "";
	Результат[Тип("Число")]  = 0;
	Результат[Тип("Дата")] = Дата('00010101');
	Результат[Тип("Булево")] = Ложь;

	Возврат Результат;

КонецФункции

// Функция - Пустая структура по результат запроса.
//
// Параметры:
//  РезультатЗапроса - Произвольный - Результат запроса.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция ПустаяСтруктураПоРезультатуЗапроса(РезультатЗапроса, ИнициализироватьЗначениеПоУмолчанию = Ложь) Экспорт
	
	Если ИнициализироватьЗначениеПоУмолчанию Тогда
		СоответствиеПростыхТипов = ПростыеТипы();
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	Для каждого КолонкаРезультатЗапроса Из РезультатЗапроса.Колонки Цикл
		
		СтруктураДанных.Вставить(КолонкаРезультатЗапроса.Имя);
		Если НЕ ИнициализироватьЗначениеПоУмолчанию Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеПоУмолчанию = Неопределено;
		
		ДоступныеТипы = КолонкаРезультатЗапроса.ТипЗначения.Типы();
		Для Каждого ТекТип Из ДоступныеТипы Цикл
			ЗначениеПоУмолчанию = СоответствиеПростыхТипов[ТекТип];
			Если НЕ ЗначениеПоУмолчанию = Неопределено Тогда
				Прервать;
			ИначеЕсли ТекТип = Тип("Null") Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				ЗначениеПоУмолчанию = Новый(ТекТип);
				Прервать;
			Исключение
				// Ошибка преобразования в ссылочный.
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		СтруктураДанных.Вставить(КолонкаРезультатЗапроса.Имя, ЗначениеПоУмолчанию);
		
	КонецЦикла;

	Возврат СтруктураДанных;
КонецФункции

// Процедура - Изменить регламентное задание.
//
// Параметры:
//  ИмяЗадания - Произвольный - Имя задания.
//  Использование - Произвольный - Использование.
//  Расписание - Произвольный - Расписание.
//  ТекстРасписания - Строка - Текст расписания.
//
Процедура ИзменитьРегламентноеЗадание(ИмяЗадания, Использование = Неопределено, Расписание = Неопределено, ТекстРасписания = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегЗадание = Неопределено;
	МетаданныеПредопределенного = Метаданные.РегламентныеЗадания.Найти(ИмяЗадания);
	Если МетаданныеПредопределенного <> Неопределено Тогда
		РегЗадание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеПредопределенного);
	КонецЕсли;
	
	ПараметрыЗадания = Новый Структура;
	Если НЕ Использование = Неопределено Тогда
		ПараметрыЗадания.Вставить("Использование", Истина И Использование);
	КонецЕсли;
	
	Если НЕ Расписание = Неопределено Тогда
		ПараметрыЗадания.Вставить("Расписание", Расписание);
	КонецЕсли;
	
	Если НЕ РегЗадание = Неопределено Тогда
		РегламентныеЗаданияСервер.ИзменитьЗадание(РегЗадание.УникальныйИдентификатор, ПараметрыЗадания);
		РегЗадание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеПредопределенного);
	КонецЕсли;
	
	ПолучитьТекстЗаголовкаИРасписанияРегламентнойНастройки(РегЗадание,
		ТекстРасписания, 
		Неопределено);
	
КонецПроцедуры

// Функция - Получить иерархию элементов.
//
// Параметры:
//  СправочникСсылка - Произвольный - Справочник ссылка.
//  ВключаяРодителей - Произвольный - Включая родителей.
//  ВключаяДетей - Произвольный - Включая детей.
//  ВключаяСамЭлемент - Произвольный - Включая сам элемент.
//  ВыполнятьАвтоУпорядочивание - Произвольный - Выполнять авто упорядочивание.
//  СначалаПолучениеДетей - Произвольный - Сначала получение детей.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьИерархиюЭлементов(СправочникСсылка, ВключаяРодителей = Ложь, ВключаяДетей = Ложь, ВключаяСамЭлемент = Ложь, 
	ВыполнятьАвтоУпорядочивание = Ложь, СначалаПолучениеДетей = Истина) Экспорт
	
	СписокЭлементов = Новый Массив;

	Если ВключаяДетей 
		И СначалаПолучениеДетей Тогда
		СписокПотомков = ПолучитьВложенныеЭлементыСправочника(СправочникСсылка, Ложь,ВыполнятьАвтоУпорядочивание);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокЭлементов, СписокПотомков);
	КонецЕсли;
	
	Если ВключаяРодителей Тогда
		СписокРодителей = ПолучитьВсехВышестоящихРодителейСправочника(СправочникСсылка, Ложь, ВыполнятьАвтоУпорядочивание);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокЭлементов, СписокРодителей);
	КонецЕсли;
	
	Если ВключаяДетей 
		И НЕ СначалаПолучениеДетей Тогда
		СписокПотомков = ПолучитьВложенныеЭлементыСправочника(СправочникСсылка, Ложь,ВыполнятьАвтоУпорядочивание);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокЭлементов, СписокПотомков);
	КонецЕсли;
	
	Если ВключаяСамЭлемент Тогда
		Если ТипЗнч(СправочникСсылка) = Тип("Массив") Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокЭлементов, СправочникСсылка)
		Иначе
			СписокЭлементов.Добавить(СправочникСсылка);
		КонецЕсли;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокЭлементов);
	Возврат СписокЭлементов;
	
КонецФункции

// Заполняет представление регламентного задания (реквизиты ЗаданиеАктивно, ТекстРасписания)
//
// Параметры:
//  Задание - РегламентноеЗадание, Неопределено - регламентное задание представление которого необходимо получит.
//  ТекстРасписания - Строка - представление расписания (выходной.
//  РасписаниеАктивно - Булево - использование задания (выходной.
//
Процедура ПолучитьТекстЗаголовкаИРасписанияРегламентнойНастройки(Задание, ТекстРасписания, РасписаниеАктивно) Экспорт
	
	РасписаниеАктивно = Ложь;
	
	Если Задание = Неопределено Тогда
		
		ТекстРасписания = НСтр("ru = '<Расписание не задано>';
								|en = '<Расписание не задано>'");
		
	Иначе
		
		Если Задание.Использование Тогда
			РасписаниеАктивно = Истина;
			ТекстРасписания = СтрШаблон(НСтр("ru = 'Расписание: %1';
											|en = 'Расписание: %1'"), Строка(Задание.Расписание));
		Иначе
			ТекстРасписания = СтрШаблон(НСтр("ru = 'Расписание (НЕ АКТИВНО): %1';
											|en = 'Расписание (НЕ АКТИВНО): %1'"), Строка(Задание.Расписание));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает подразделение по складу.
//
// Параметры:
//  СтруктурнаяЕдиница - Произвольный - Склад.
//  ТолькоРодители - Произвольный - Только родители.
//
// Возвращаемое значение:
//  Произвольный - Подразделение.
//
Функция ПодразделениеПоСкладу(Склад, ТолькоРодители = Ложь) Экспорт
	
	Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "Подразделение");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Бухгалтерия

// Процедура - Добавить значения заполнения.
//
// Параметры:
//  КоллекцияОтборов - Произвольный - Коллекция отборов.
//  ЗначенияЗаполнения - Произвольный - Значения заполнения.
//
Процедура ДобавитьЗначенияЗаполнения(КоллекцияОтборов, ЗначенияЗаполнения)

	Для каждого ЭлементОтбора Из КоллекцияОтборов Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементОтбора.Использование 
			И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			
			НаименованиеОтбора = Строка(ЭлементОтбора.ЛевоеЗначение);
			Если СтрНайти(НаименованиеОтбора, ".") = 0 Тогда
				ЗначенияЗаполнения.Вставить(НаименованиеОтбора, ЭлементОтбора.ПравоеЗначение);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") 
			И ЭлементОтбора.Использование 
			И ЭлементОтбора.ТипГруппы <> ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда
			
			ДобавитьЗначенияЗаполнения(ЭлементОтбора.Элементы, ЗначенияЗаполнения);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// Функция округляет число до ближайшего верхнего целого
//
// Параметры:
//  Значение - Произвольный - Значение.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОкрВверх(Значение)
	ВремЗначение = Цел(Значение);
	Если Значение > ВремЗначение Тогда
		Возврат ВремЗначение + 1;
	Иначе
		Возврат ВремЗначение;
	КонецЕсли;
КонецФункции

// Функция возвращает псевдослучайное число указанного порядка
//  (порядок равен количеству цифр в числе, [1..4]).
//  Используется массив весовых Коэффициентов НаборСлучайных[].
//
// Параметры:
//  Порядок - Произвольный - Порядок.
//  НаборСлучайных - Произвольный - Набор случайных.
//  ИндексСлучайных - Произвольный - Индекс случайных.
//
// Возвращаемое значение:
//  полученное число
Функция СлучайноеЧисло(Порядок, НаборСлучайных, ИндексСлучайных)
	Перем РСЧ, СЧ;
	СЧ = 0;
	Для К = 0 По 7 Цикл
		СлучайноеЧисло = НаборСлучайных[К];
		СЧ = СЧ + СлучайноеЧисло;
	КонецЦикла;
	РСЧ = СЧ - Цел(СЧ);
	ИндексСлучайных = ИндексСлучайных + 1;
	Если ИндексСлучайных > 7 Тогда
		ИндексСлучайных = 1;
	КонецЕсли;
	НаборСлучайных[ИндексСлучайных] = РСЧ;
	СЧ = 1;
	Для К = 0 По Порядок-1 Цикл
		СЧ = СЧ * 10;
	КонецЦикла;
	Возврат Цел(РСЧ * СЧ);
КонецФункции

// Инициализация случайно последовательности.
//
// Параметры:
//  Смещение - Произвольный - Смещение.
//  ИндексСлучайных - Произвольный - Индекс случайных.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ИнициализацияСлучайнойПоследовательности(Смещение = 0, ИндексСлучайных)
	Перем Час, Минута, Сек, Ранд, День, Кол;
	НаборСлучайных = Новый Массив(8);
	НаборСлучайных[0] = 0.2354;
	НаборСлучайных[1] = 0.5378;
	НаборСлучайных[2] = 0.0932;
	НаборСлучайных[3] = 0.9084;
	НаборСлучайных[4] = 0.3490;
	НаборСлучайных[5] = 0.3489;
	НаборСлучайных[6] = 0.4884;
	НаборСлучайных[7] = 0.8477;
	ИндексСлучайных = 0;
	ТекДата = ТекущаяДата();
	День = ДеньГода(ТекДата) % 1000;
	Час = Час(ТекДата);
	Минута = Минута(ТекДата);
	Сек = Секунда(ТекДата);
	Ранд = Час + Минута + Сек + День + Смещение;
	Для Кол = 1 По Ранд Цикл
		СлучайноеЧисло(0, НаборСлучайных, ИндексСлучайных);
	КонецЦикла;
	Возврат НаборСлучайных;
КонецФункции

#КонецОбласти





