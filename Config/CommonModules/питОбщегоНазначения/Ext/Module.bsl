//

// Рассчитываем сумму документа со всеми налогами
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//  ИмяТабличнойЧасти - Произвольный - Имя табличной части.
//  НеУчитыватьТару - Произвольный - Не учитывать тару.
//
// Возвращаемое значение:
//  Число - Сумма документа со всеми налогами.
Функция ПолучитьСуммуДокументаСНДС(ДокументОбъект, ИмяТабличнойЧасти = Неопределено, НеУчитыватьТару = Истина) Экспорт

	МетаданныеДокумента = ДокументОбъект.Ссылка.Метаданные();

	СуммаДокумента = 0;
	Если ИмяТабличнойЧасти <> Неопределено Тогда
		СуммаДокумента = СуммаДокумента + ДокументОбъект[ИмяТабличнойЧасти].Итог("Сумма");
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаВключаетНДС", МетаданныеДокумента)
		   И ОбщегоНазначенияУТ.ЕстьРеквизитТабЧастиОбъекта("СуммаНДС", МетаданныеДокумента, ИмяТабличнойЧасти)
		   И НЕ ДокументОбъект.СуммаВключаетНДС Тогда
			СуммаДокумента = СуммаДокумента + ДокументОбъект[ИмяТабличнойЧасти].Итог("СуммаНДС");
		КонецЕсли;
	Иначе
		Для каждого ТЧОбъекта Из ДокументОбъект.Ссылка.Метаданные().ТабличныеЧасти Цикл
			Если НеУчитыватьТару и ТЧОбъекта.Имя = "ВозвратнаяТара" Тогда
				Продолжить;
			КонецЕсли;
			Если ТЧОбъекта.Имя = "ВыданныеАвансы" Тогда
				Продолжить;
			КонецЕсли;
			Если ТЧОбъекта.Имя = "ДенежныеСредства" Тогда
				Продолжить;
			КонецЕсли;
			Если ОбщегоНазначенияУТ.ЕстьРеквизитТабЧастиОбъекта("Сумма", МетаданныеДокумента, ТЧОбъекта.Имя) Тогда
				СуммаДокумента = СуммаДокумента + ДокументОбъект[ТЧОбъекта.Имя].Итог("Сумма");
				Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаВключаетНДС", МетаданныеДокумента)
					И ОбщегоНазначенияУТ.ЕстьРеквизитТабЧастиОбъекта("СуммаНДС", МетаданныеДокумента, ТЧОбъекта.Имя)
					И НЕ ДокументОбъект.СуммаВключаетНДС Тогда
					СуммаДокумента = СуммаДокумента + ДокументОбъект[ТЧОбъекта.Имя].Итог("СуммаНДС");
				КонецЕсли;
			КонецЕсли;
			Если ОбщегоНазначенияУТ.ЕстьРеквизитТабЧастиОбъекта("СуммаСкидки", МетаданныеДокумента, ТЧОбъекта.Имя) Тогда
				СуммаДокумента = СуммаДокумента - ДокументОбъект[ТЧОбъекта.Имя].Итог("СуммаСкидки");
			КонецЕсли;
		КонецЦикла;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Сумма", МетаданныеДокумента) Тогда
			СуммаДокумента = СуммаДокумента + ДокументОбъект.Сумма;
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаВключаетНДС", МетаданныеДокумента)
				И ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаНДС", МетаданныеДокумента)
				И НЕ ДокументОбъект.СуммаВключаетНДС Тогда
				СуммаДокумента = СуммаДокумента + ДокументОбъект.СуммаНДС;
			КонецЕсли;
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаСкидки", МетаданныеДокумента) Тогда
			СуммаДокумента = СуммаДокумента - ДокументОбъект.СуммаСкидки;
		КонецЕсли; 
	КонецЕсли;
	

	Возврат СуммаДокумента;

КонецФункции // ПолучитьСуммуДокументаСНДС()

// Функция получает коэффициент переданной упаковки относительно переданной номенклатуры
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура.
//  Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения - Упаковки.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//
// Возвращаемое значение:
//  Число - Коэффициент
Функция ПолучитьКоэффициентУпаковки(Номенклатура, Упаковка, КэшированныеЗначения = Неопределено) Экспорт
	
	Если КэшированныеЗначения = Неопределено Тогда
		КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	КонецЕсли;
	
	ТекДанные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьКоэффициентУпаковки(
				Упаковка, 
				КэшированныеЗначения,
				Номенклатура);
	
	Возврат ТекДанные.Коэффициент;
	
КонецФункции

// Функция - Перевести объем в миллилитры.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  ЕдиницаИзмерения - Произвольный - Единица измерения.
//  Количество - Произвольный - Количество.
//  АлкогольнаяПродукция - Произвольный - Алкогольная продукция.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПеревестиОбъемВМиллилитры(Знач Номенклатура, Знач ЕдиницаИзмерения = Неопределено, Знач Количество = 1, 
	Знач АлкогольнаяПродукция = Неопределено) Экспорт
	
	Результат = Неопределено;
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	КоэффициентЕдиницы = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура, ЕдиницаИзмерения);
	КоэффициентМиллилитра = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура, питОбщегоНазначения.ПолучитьБазовуюЕдиницуИзмеренияПоКоду("111"));
	КоэффициентПересчета = КоэффициентЕдиницы / КоэффициентМиллилитра;
	// Допустим базовая е.и. Литр
	// Переданная - Дал коэф 10
	// Миллилитр - коэф 0.001
	// КоэффициентПересчета = 10 / 0.001 = 10000
	Возврат Количество * КоэффициентПересчета;
	
КонецФункции // ПеревестиОбъемВМиллилитры()

// Функция переводит объем из миллилитров в переданную единицу.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Ссылка на номенклатуру.
//  ЕдиницаИзмерения - СправочникСсылка.УпаковкиЕдиницыИзмерения - Ссылка на единицу измерения.
//  КоличествоВМЛ - Произвольный - Количество вмл.
//
// Возвращаемое значение:
//  Число - Пересчитанное количество.
Функция ПеревестиОбъемИзМиллилитров(Номенклатура, ЕдиницаИзмерения = Неопределено, КоличествоВМЛ = 1) Экспорт
	
	Результат = Неопределено;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	КоэффициентЕдиницы = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура, ЕдиницаИзмерения);
	КоэффициентМиллилитра = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура, питОбщегоНазначения.ПолучитьБазовуюЕдиницуИзмеренияПоКоду("111"));
	КоэффициентПересчета = КоэффициентМиллилитра / КоэффициентЕдиницы;
	// Допустим базовая е.и. Литр
	// Переданная - Дал коэф 10
	// Миллилитр - коэф 0.001
	// КоэффициентПересчета = 0.001 / 10  = 0.0001
	Возврат КоличествоВМЛ * КоэффициентПересчета;
	
КонецФункции // ПеревестиОбъемИзМиллилитров()

// Функция - Получить базовую единицу измерения по коду
//
// Параметры:
//  КодСтрокой - Строка - Код единицы строкой.
//
// Возвращаемое значение:
//  СправочникСсылка.УпаковкиЕдиницыИзмерения - Найденная единица.
&НаСервере
Функция ПолучитьБазовуюЕдиницуИзмеренияПоКоду(КодСтрокой) Экспорт
	РезультатСоответствиеКодовЕИ = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора(КодСтрокой);
	ЕдИз = РезультатСоответствиеКодовЕИ.Получить(КодСтрокой);
	Если ЕдИз = Неопределено Тогда
		ЕдИз = 1;
	КонецЕсли;
	Возврат ЕдИз;
КонецФункции // ПолучитьБазовуюЕдиницуИзмеренияПоКоду()

// Проверяет наличие у контрагента хотя бы одного договора по данной организации
//
// Параметры:
//  Организация - Произвольный - Организация.
//  Контрагент - Произвольный - Контрагент.
//
// Возвращаемое значение:
//  Булево - Истина, если для переданных Контрагента и Организации нет ни одного договора
Функция КонтрагентБезДоговоров(Организация, Контрагент) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Организация) ИЛИ НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Пустой()
	
КонецФункции

// Функция возвращает значение по умолчанию для передаваемого пользователя и настройки.
//
// Параметры:
//  Настройка - Строка - вид настройки, значение по умолчанию которой необходимо получит.
//  Пользователь - СправочникСсылка.Пользователи - пользователь программы, настройка которого.
//
// Возвращаемое значение:
