
#Область ПрограммныйИнтерфейс

// Процедура добавляет команды создания перемещения на основании выпуска блюд.
//
// Параметры:
//  КомандыСозданияНаОсновании	 - ТаблицаЗначений - Таблица команд создания на основании БСП.
//
Процедура ДобавитьКомандуСоздатьНаОснованииПеремещенияДвиженияПродукции(КомандыСозданияНаОсновании) Экспорт
	
	Если ПравоДоступа("Добавление", Метаданные.Документы.ДвижениеПродукцииИМатериалов)
		И ПравоДоступа("Добавление", Метаданные.Документы.ПеремещениеТоваров) Тогда
		
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Обработчик = "питСозданиеНаОснованииКлиент.СоздатьПеремещениеНаОснованииВыпускаБлюдНедовложения";
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.ДвижениеПродукцииИМатериалов.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = "Перемещение недовложений";
		КомандаСоздатьНаОсновании.МножественныйВыбор = Истина;
		
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Обработчик = "питСозданиеНаОснованииКлиент.СоздатьПеремещениеНаОснованииВыпускаБлюдВсеИнгредиенты";
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.ДвижениеПродукцииИМатериалов.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = "Перемещение всех ингредиентов";
		КомандаСоздатьНаОсновании.МножественныйВыбор = Истина;
		
	КонецЕсли;
	
КонецПроцедуры  

// Добавляет команду создания документа "Отчет о производстве ЕГАИС".
//
// Параметры:
//  КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Процедура ДобавитьКомандуСоздатьНаОснованииОтчетОПроизводстеЕГАИС(КомандыСозданияНаОсновании) Экспорт
	
	Если ПравоДоступа("Добавление", Метаданные.Документы.ОтчетОПроизводствеЕГАИС) Тогда
		
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.ОтчетОПроизводствеЕГАИС.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = ОбщегоНазначенияУТ.ПредставлениеОбъекта(Метаданные.Документы.ОтчетОПроизводствеЕГАИС);
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		
	КонецЕсли;
	
КонецПроцедуры


// Функция возвращает параметры открытия формы перемещения при создании на основании выпуска блюд
//
// Параметры:
//  МассивСсылок	 - Массив - Массив ссылок выпусков блюд.
//  СпособЗаполнения - Строка - Способ заполнения перемещения: ЗаполнитьВсемиИнгредиентами и ЗаполнитьНедовложениями
// 
// Возвращаемое значение:
//  Структура - Параметры открытия формы перемещения.
//
Функция ПараметрыОткрытияФормыПеремещенияНаОснованииВыпускаБлюд(МассивСсылок, СпособЗаполнения) Экспорт
	
	Если НЕ МассивСсылок.Количество() Тогда
		// Выходим, если массив ссылок пустой
		Возврат Неопределено;
	КонецЕсли;
	
	// Ссылка на заполняемый документ
	ДокументСсылка = МассивСсылок[0];
	
	// Реквизиты выпуска блюд
	ШапкаДокументаОбщепит = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Склад, Склад.ЦеховаяКладовая");
	
	// Определяем, какой документ создавать
	Если ШапкаДокументаОбщепит.СкладЦеховаяКладовая Тогда
		ИмяНакладной = "ДвижениеПродукцииИМатериалов";
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую;
	Иначе
		ИмяНакладной = "ПеремещениеТоваров";
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	КонецЕсли;
	
	// Получим таблицу товаров по выпуску блюд.
	ТаблицаТоваров = ТоварыТиповогоДокументаПоВыпускуБлюд(ДокументСсылка, ШапкаДокументаОбщепит.Склад, СпособЗаполнения);
	ОткрытьФормуДокумента = НЕ ТаблицаТоваров = Неопределено И ТаблицаТоваров.Количество();
	
	// Ошибка в случае, если ингредиенты не найдены
	Если Не ОткрытьФормуДокумента Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Заполнение данных заполнения.
	ДанныеЗаполнения = Новый Структура("РеквизитыШапки, АдресТовары, ДокументОснование");
	ДанныеЗаполнения.РеквизитыШапки		= ШапкаТиповогоДокументаПоВыпускуБлюд(ДокументСсылка, ИмяНакладной, ХозяйственнаяОперация);
	ДанныеЗаполнения.ДокументОснование	= ДокументСсылка;
	ДанныеЗаполнения.АдресТовары		= ПоместитьВоВременноеХранилище(ТаблицаТоваров);
	
	// Заполнение параметров открытия.
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИмяФормы", "Документ." + ИмяНакладной + ".ФормаОбъекта");
	ПараметрыОткрытия.Вставить("ПараметрыФормы", Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения));
	ПараметрыОткрытия.Вставить("РежимОткрытияОкнаФормы", РежимОткрытияОкнаФормы.Независимый);
	
	Возврат ПараметрыОткрытия;
	
КонецФункции

// Вызывается из соответствующего обработчика документа
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Обрабатываемый объект.
//  ДанныеЗаполнения - Произвольный - Значение, которое используется как основание для заполнения.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
Процедура ОбработкаЗаполнения(ДокументОбъект, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("ДокументОснование") 
		И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.питВыпускБлюд") Тогда
		// Документ-основание — это выпуск блюд.
		Если ТипЗнч(ДокументОбъект) = тип("ДокументОбъект.ПеремещениеТоваров")
			ИЛИ ТипЗнч(ДокументОбъект) = тип("ДокументОбъект.ДвижениеПродукцииИМатериалов") Тогда
			// Документ, который заполняем — это перемещение или движение продукции и материалов.
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполнения.РеквизитыШапки);
			ДокументОбъект.ДокументОснование = ДанныеЗаполнения.ДокументОснование;
			
			ТаблицаТовары = ПолучитьИзВременногоХранилища(ДанныеЗаполнения.АдресТовары);
			Для Каждого Строка Из ТаблицаТовары Цикл
				НоваяСтрока = ДокументОбъект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.НазначениеОтправителя = НоваяСтрока.Назначение;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ШапкаТиповогоДокументаПоВыпускуБлюд(ДокументОснованиеСсылка, ИмяНакладной, ХозяйственнаяОперация)
	
	РеквизитыШапки = Новый Структура;
	
	// Реквизиты выпуска блюд
	ШапкаДокументаОбщепит = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиеСсылка, "Дата, Организация, Подразделение, Склад, Ответственный, Комментарий");
	
	Если ИмяНакладной = "ДвижениеПродукцииИМатериалов" Тогда
		
		// Заполнение данных заполнения.
		РеквизитыШапки = Новый Структура("
		|Дата,
		|ХозяйственнаяОперация,
		|Организация,
		|Отправитель,
		|Получатель,
		|Статус,
		|Ответственный, 
		|Комментарий,
		|НалогообложениеНДС");
		РеквизитыШапки.Дата						= ШапкаДокументаОбщепит.Дата;
		РеквизитыШапки.ХозяйственнаяОперация	= ХозяйственнаяОперация;
		РеквизитыШапки.Организация				= ШапкаДокументаОбщепит.Организация;
		РеквизитыШапки.Отправитель				= Справочники.Склады.ПустаяСсылка();
		РеквизитыШапки.Получатель				= ШапкаДокументаОбщепит.Склад;
		РеквизитыШапки.Ответственный			= ШапкаДокументаОбщепит.Ответственный;
		РеквизитыШапки.Комментарий				= ШапкаДокументаОбщепит.Комментарий;
		РеквизитыШапки.Статус					= Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
		ПараметрыУчетаПоОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(РеквизитыШапки.Организация, 
			РеквизитыШапки.Дата, 
			РеквизитыШапки.Отправитель);
		РеквизитыШапки.НалогообложениеНДС			= ПараметрыУчетаПоОрганизации.ОсновноеНалогообложениеНДСПродажи;
		
	ИначеЕсли ИмяНакладной = "ПеремещениеТоваров" Тогда
		
		// Заполнение данных заполнения.
		РеквизитыШапки = Новый Структура("
		|ДатаРаспоряжения,
		|Дата,
		|ВидЦены,
		|ХозяйственнаяОперация,
		|Организация,
		|Подразделение,
		|СкладОтправитель,
		|СкладПолучатель,
		|Статус,
		|Ответственный, 
		|Комментарий,
		|СпособДоставки");
		РеквизитыШапки.ДатаРаспоряжения			= КонецДня(ШапкаДокументаОбщепит.Дата);
		РеквизитыШапки.ВидЦены					= питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит");
		РеквизитыШапки.Дата						= ШапкаДокументаОбщепит.Дата;
		РеквизитыШапки.Организация				= ШапкаДокументаОбщепит.Организация;
		РеквизитыШапки.Ответственный			= ШапкаДокументаОбщепит.Ответственный;
		РеквизитыШапки.Подразделение			= ШапкаДокументаОбщепит.Подразделение;
		РеквизитыШапки.СкладОтправитель			= Справочники.Склады.ПустаяСсылка();
		РеквизитыШапки.СкладПолучатель			= ШапкаДокументаОбщепит.Склад;
		РеквизитыШапки.Статус					= Перечисления.СтатусыПеремещенийТоваров.Принято;
		РеквизитыШапки.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
		РеквизитыШапки.Комментарий				= ШапкаДокументаОбщепит.Комментарий;
		РеквизитыШапки.СпособДоставки			= Перечисления.СпособыДоставки.Самовывоз;
		
	КонецЕсли;
	
	Возврат РеквизитыШапки;
	
КонецФункции

// Заполняет таблицу документов, на основании Выпуска блюд.
//
// Параметры:
//  МассивДокументовОснований - Документ, на основании которого вводится ДокументОбъект.
//  Склад - Склад, на котором анализируются остатки номенклатуры.
//  СпособЗаполнения - Способ заполнения табличной части документа.
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТоварыТиповогоДокументаПоВыпускуБлюд(ДокументОснованиеСсылка, СкладДляАнализа, СпособЗаполнения = "ЗаполнитьНедовложениями", УчетВПродажныхЦенах = Неопределено)
	
	// Инициализация таблицы результата.
	ДокОбъект = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	ТаблицаРезультат = ДокОбъект.Товары.Выгрузить();
	ДокОбъект = Неопределено;
	
	// В зависимости от способа заполнения заполним табличную часть документа ДокументОбъект.
	Если СпособЗаполнения="ЗаполнитьНедовложениями" ИЛИ СпособЗаполнения="ЗаполнитьВсемиИнгредиентами" Тогда
		
		ВсеИнгредиенты				= (СпособЗаполнения="ЗаполнитьВсемиИнгредиентами");
		УчитыватьЗаменыВРецептурах	= Ложь;
		
		// Определение таблиц недовложений.
		СтруктураТаблицПроизводства = питПроизводство.АнализНедовложений(ДокументОснованиеСсылка, СкладДляАнализа, , Истина, УчетВПродажныхЦенах);
		СтруктураТаблицНедовложений = питПроизводство.АнализТаблицПроизводстваНаНедовложения(ДокументОснованиеСсылка, СтруктураТаблицПроизводства, ВсеИнгредиенты, УчитыватьЗаменыВРецептурах);
		ТаблицаНедовложений			= СтруктураТаблицНедовложений.ТаблицаНедовложений;
		
		// Заполним табличную часть поступления, перемещения
		Для Каждого СтрокаНедовложения Из ТаблицаНедовложений Цикл
			
			// В зависимости от способа заполнения нам необходимо анализировать либо не хватающее количество.
			Если НЕ ВсеИнгредиенты Тогда                                                                         
				КоличествоНорма			= СтрокаНедовложения.КоличествоНоменклатурыНедовложение;
				КоличествоУпаковокНорма	= СтрокаНедовложения.КоличествоУпаковокНоменклатурыНедовложение;
			Иначе // либо все количество для производства
				КоличествоНорма			= СтрокаНедовложения.КоличествоНоменклатурыНеобходимо;
				КоличествоУпаковокНорма	= СтрокаНедовложения.КоличествоУпаковокНоменклатурыНеобходимо;
			КонецЕсли;
			
			// Факт приравниваем к норме.
			КоличествоФакт			= КоличествоНорма;
			КоличествоУпаковокФакт	= КоличествоУпаковокНорма;
			Если КоличествоФакт > 0 Тогда
				
				// Заполнение результирующей таблицы.
				НоваяСтрока							= ТаблицаРезультат.Добавить();
				НоваяСтрока.Номенклатура			= СтрокаНедовложения.Номенклатура;
				НоваяСтрока.Характеристика			= СтрокаНедовложения.Характеристика;
				НоваяСтрока.Упаковка				= СтрокаНедовложения.УпаковкаНоменклатуры;
				НоваяСтрока.КоличествоУпаковок		= КоличествоУпаковокФакт;
				НоваяСтрока.Количество				= КоличествоФакт;
				НоваяСтрока.ИдентификаторСтроки		= Новый УникальныйИдентификатор;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; // СпособЗаполнения="ЗаполнитьНедовложениямиСУчетомОстатков" ...
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти
