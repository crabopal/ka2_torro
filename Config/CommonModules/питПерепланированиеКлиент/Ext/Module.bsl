// ПЕРЕОПРЕДЕЛЯЕМЫЕ ПРОЦЕДУРЫ, ВЫЗЫВАЕМЫЕ ИЗ ОБРАБОТЧИКОВ ТИПОВЫХ ФОРМ.

#Область ПрограммныйИнтерфейс

//  Процедура - Выпуск блюд создать на основании плана с учетом произведенных.
//
// Параметры:
//  МассивСсылок - Массив - Массив ссылок.
//  ПараметрыВыполнения - Произвольный - Параметры выполнения.
//
Процедура ВыпускБлюдСоздатьНаОснованииПланаСУчетомПроизведенных(МассивСсылок, ПараметрыВыполнения) Экспорт
	
	ПараметрыВыполненияКоманды = Новый Структура("Источник,Уникальность,Окно,НавигационнаяСсылка");
	ЗаполнитьЗначенияСвойств(ПараметрыВыполненияКоманды, ПараметрыВыполнения.ОписаниеКоманды.ДополнительныеПараметры);
	
	Если НЕ ПараметрыВыполнения.ОписаниеКоманды.МножественныйВыбор Тогда
		ПараметрКоманды = МассивСсылок;
	Иначе
		ПараметрКоманды = МассивСсылок[0];
	КонецЕсли;
	
	Основание = Новый Структура;
	Основание.Вставить("ДокументОснование", ПараметрКоманды);
	Основание.Вставить("СУчетомПроизведенных", ПараметрыВыполнения.ОписаниеКоманды.ДополнительныеПараметры.Свойство("СУчетомПроизведенных"));
	
	ПараметрыФормы = Новый Структура("Основание", Основание);
	
	ОткрытьФорму(
		"Документ.питВыпускБлюд.Форма.ФормаДокумента",
		ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,
		ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация
#Область СлужебныеПроцедурыИФункции
#КонецОбласти
#КонецОбласти



