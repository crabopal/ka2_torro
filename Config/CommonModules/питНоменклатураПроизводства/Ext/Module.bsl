
#Область ПрограммныйИнтерфейс

#Область ОбеспечениеПотребностей

// Функция - Добавить доступные типы обеспечения.
//
// Параметры:
//  Результат - Произвольный - Результат.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДобавитьДоступныеТипыОбеспечения(Результат) Экспорт
	
	Если НЕ Результат = Неопределено Тогда
		// ЕстьОграничения = НЕ (ПравоДоступа("Добавление", Метаданные.Документы.питПланМеню)
		// И ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2"));
		Результат.Добавить(Перечисления.ТипыОбеспечения.питПеремещениеВНоменклатуруПроизводства);
		Результат.Добавить(Перечисления.ТипыОбеспечения.питПроизводство);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Процедура - Добавить тексты запроса общепит.
//
// Параметры:
//  ТекстыЗапроса - Произвольный - Тексты запроса.
//  Параметры - Произвольный - Параметры.
//
Процедура ДобавитьТекстыЗапросаОбщепит(ТекстыЗапроса, Параметры) Экспорт
	
	Если Параметры.Свойство("питОбеспечениеПотребностей") Тогда
		Для каждого ТиповойТекстЗапроса Из ТекстыЗапроса Цикл
			Если СтрНайти(ТиповойТекстЗапроса.Значение, "ПОМЕСТИТЬ ВтДанныеЗаполнения")
				ИЛИ СтрНайти(ТиповойТекстЗапроса.Значение, "ПОМЕСТИТЬ ВтТаблицаЗначений") Тогда
				
				ТекстЗаменить = "ВЫБРАТЬ
					// Данные, необходимые для заполнения документа "План-меню".
					|	Т.питОрганизация                             КАК питОрганизация,
					|	Т.питПодразделение                           КАК питПодразделение,
					|	Т.питЦеховаяКладовая                         КАК питЦеховаяКладовая,
					|	Т.питСкладМатериалов                         КАК питСкладМатериалов,
					|	Т.питЕдиницаИзмерения                        КАК питЕдиницаИзмерения,
					|	Т.питЗаказ                                   КАК питЗаказ,
					|";
				Если СтрНайти(ТиповойТекстЗапроса.Значение, "ПОМЕСТИТЬ ВтТаблицаЗначений") Тогда
					ТекстЗаменить = СтрЗаменить(ТекстЗаменить, "Т.пит", "Таблица.");
				КонецЕсли;
				
				ТиповойТекстЗапроса.Значение = СтрЗаменить(ТиповойТекстЗапроса.Значение, 
					"ВЫБРАТЬ",
					ТекстЗаменить);
				
			КонецЕсли;
		КонецЦикла;
		ТекстыЗапроса.Добавить(Обработки.питОбеспечениеПотребностей.ТаблицаПланыМенюКОформлению(), "ТаблицаПланыМеню");
	КонецЕсли;
	
	ТекстыЗапроса.Добавить(ТаблицаЗаказыНаПеремещениеВНоменклатуруПроизводстваКОформлению(), "ТаблицаЗаказыНаПеремещениеВНоменклатуруПроизводства");
	
КонецПроцедуры

// Процедура - Создать документы общепит.
//
// Параметры:
//  Таблицы - Произвольный - Таблицы.
//  ДокументыОбъекты - Произвольный - Документы объекты.
//  Параметры - Произвольный - Параметры.
//
Процедура СоздатьДокументыОбщепит(Таблицы, ДокументыОбъекты, Параметры) Экспорт
	
	///////////////////////////////////////////////////////////////////
	// Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства
	
	ТекстКомментарий = НСтр("ru = 'Сформирован автоматически обработкой ""Формирование заказов по потребностям"".';
							|en = 'Generated automatically by the ""Generate orders by demands"" data processor.'");
	
	ПоляКлючаЗаказа = "Организация, Подразделение, СкладОтправитель, СкладПолучатель, ДлительностьПеремещения, ЖелаемаяДатаПоступления, ИспользоватьДлительностьПеремещения";
	МассивТаблиц = ОбеспечениеСервер.РазбитьТаблицуПоЗначениюКлюча(Таблицы.ТаблицаЗаказыНаПеремещениеВНоменклатуруПроизводства, ПоляКлючаЗаказа);
	
	Для Каждого Элемент Из МассивТаблиц Цикл
		
		ДанныеЗаполнения = Элемент.Ключ;
		ДанныеЗаполнения.Вставить("Товары", Элемент.Таблица);
		ДанныеЗаполнения.Вставить("Комментарий", ТекстКомментарий);
		Документ = ПолучитьДокумент(Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства, ДанныеЗаполнения, Перечисления.питСтатусыЗаказовНаПеремещениеВНоменклатуруПроизводства.КОбеспечению);
		ДокументыОбъекты.Добавить(Документ);
		
	КонецЦикла;
	
	///////////////////////////////////////////////////////////////////
	// Документы.питПланМеню
	Если Параметры.Свойство("питОбеспечениеПотребностей") Тогда
		
		ПоляКлючаЗаказа = "Организация, Подразделение, СкладРеализации, ЦеховаяКладовая, ДатаПлан, Склад";
		Таблицы.ТаблицаПланыМеню.Сортировать(ПоляКлючаЗаказа);
		МассивТаблиц = ОбеспечениеСервер.РазбитьТаблицуПоЗначениюКлюча(Таблицы.ТаблицаПланыМеню, ПоляКлючаЗаказа);
		
		Для Каждого Элемент Из МассивТаблиц Цикл
			
			РодительскиеЗаказы = Новый Массив;
			Для каждого ТекСтрокаТаблицы Из Элемент.Таблица Цикл
				Если ЗначениеЗаполнено(ТекСтрокаТаблицы.Заказ)
					И ТипЗнч(ТекСтрокаТаблицы.Заказ) = Тип("ДокументСсылка.питПланМеню") 
					И РодительскиеЗаказы.Найти(ТекСтрокаТаблицы.Заказ) = Неопределено Тогда
					РодительскиеЗаказы.Добавить(ТекСтрокаТаблицы.Заказ);
				КонецЕсли;
			КонецЦикла;
			
			ДанныеЗаполнения = Элемент.Ключ;
			КолонкиГруппировок = Новый Массив;
			КолонкиСуммирования = Новый Массив;
			Для каждого ТекКолонка Из Элемент.Таблица.Колонки Цикл
				Если ТекКолонка.Имя = "Заказ" Тогда
					Продолжить;
				ИначеЕсли СтрНайти(ТекКолонка.Имя, "Количество") Тогда
					КолонкиСуммирования.Добавить(ТекКолонка.Имя);
				Иначе
					КолонкиГруппировок.Добавить(ТекКолонка.Имя);
				КонецЕсли;
			КонецЦикла;
			Элемент.Таблица.Свернуть(СтрСоединить(КолонкиГруппировок, ","), СтрСоединить(КолонкиСуммирования, ","));
			ДанныеЗаполнения.Вставить("Товары", Элемент.Таблица);
			ДанныеЗаполнения.Вставить("Комментарий", ТекстКомментарий);
			Документ = Обработки.питОбеспечениеПотребностей.ПолучитьДокумент(Документы.питПланМеню, ДанныеЗаполнения);
			Документ.ДополнительныеСвойства.Вставить("РодительскиеЗаказы", РодительскиеЗаказы);
			
			ДокументыОбъекты.Добавить(Документ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

#КонецОбласти

// Функция - Получить производственную номенклатуру по складской.
//
// Параметры:
//  НоменклатураСкладская - Произвольный - Номенклатура складская.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьПроизводственнуюНоменклатуруПоСкладской(НоменклатураСкладская) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная КАК НоменклатураПроизводственная,
	|	питСоответствиеНоменклатурыСкладаПроизводства.Коэффициент КАК Коэффициент,
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
	|ГДЕ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская = &НоменклатураСкладская";
	
	Запрос.УстановитьПараметр("НоменклатураСкладская", НоменклатураСкладская);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат неопределено;
	иначе
		Выборка =  РезультатЗапроса.Выбрать();
		
		Выборка.Следующий();
		
		Возврат Новый Структура("Номенклатура,ЕдиницаИзмерения,Коэффициент", Выборка.НоменклатураПроизводственная, Выборка.ЕдиницаИзмерения, Выборка.Коэффициент);
	КонецЕсли;
	
КонецФункции

// Возвращает структуру содержащую список складских номенклатур для данной производственной
//  и коэффициент и Ед. изм для первой по приоритету для заполнения табличной части
//
// Параметры:
//  НоменклатураПроизводственная - Справочник.Номенклатура - Номенклатура производственная.
//
// Возвращаемое значение:
//   Структура  
//              Список - Список 
//              Номенклатура
//              ЕдиницаИзмерения
//              Коэффициент- 
Функция ПолучитьСписокСкладскойНоменклатурыПоПроизводственной(НоменклатураПроизводственная) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская КАК НоменклатураСкладская,
	|	питСоответствиеНоменклатурыСкладаПроизводства.Коэффициент КАК Коэффициент,
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
	|ГДЕ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная = &НоменклатураПроизводственная";
	
	Запрос.УстановитьПараметр("НоменклатураПроизводственная", НоменклатураПроизводственная);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура("Список,Номенклатура,ЕдиницаИзмерения, Коэффициент", Новый СписокЗначений,,, -1 );
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество() > 1 И Выборка.НоменклатураСкладская = НоменклатураПроизводственная Тогда
			продолжить;
		КонецЕсли; 
		Если Результат.Коэффициент < 0 Тогда
			Результат.Коэффициент = Выборка.Коэффициент; // Первого который подставляем
			Результат.Номенклатура = Выборка.НоменклатураСкладская;
			Результат.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
		КонецЕсли; 
		Результат.Список.Добавить(Выборка.НоменклатураСкладская);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает данные конкретной производственной номенклатуры по складской
//  Используется при изменении складской номенклатуры в перемещении из производства
//
// Параметры:
//  НоменклатураСкладская - Справочник.Номенклатура - Номенклатура Складская
//   <продолжение описания параметра.
//  НоменклатураПроизводственная - Справочник.Номенклатура - Номенклатура производственная.
//
// Возвращаемое значение:
//   Структура   - <описание возвращаемого значения>
Функция ПолучитьДанныеСкладскойНоменклатуры(НоменклатураСкладская, НоменклатураПроизводственная)Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	питСоответствиеНоменклатурыСкладаПроизводства.Коэффициент КАК Коэффициент
	|ИЗ
	|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
	|ГДЕ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская = &НоменклатураСкладская
	|	И питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная = &НоменклатураПроизводственная";
	
	Запрос.УстановитьПараметр("НоменклатураПроизводственная", НоменклатураПроизводственная);
	Запрос.УстановитьПараметр("НоменклатураСкладская", НоменклатураСкладская);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат Новый Структура("ЕдиницаИзмерения, Коэффициент", ВыборкаДетальныеЗаписи.ЕдиницаИзмерения, ВыборкаДетальныеЗаписи.Коэффициент);
	Иначе
		Возврат Новый Структура("ЕдиницаИзмерения, Коэффициент", Неопределено, 1);
	КонецЕсли; 
	
КонецФункции // ПолучитьДанныеПроизводственнойНоменклатуры()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбеспечениеПотребностей

// Функция - Таблица заказы на перемещение в номенклатуру производства к оформлению.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ТаблицаЗаказыНаПеремещениеВНоменклатуруПроизводстваКОформлению()

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВЫБОР КОГДА Т.ИсточникОбеспечения = НЕОПРЕДЕЛЕНО ТОГДА
		|				ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|			ИНАЧЕ
		|				Т.ИсточникОбеспечения
		|		КОНЕЦ                                 КАК СкладОтправитель,
		|	Т.Организация                             КАК Организация,
		|	Т.Подразделение                           КАК Подразделение,
		|	Т.Склад                                   КАК СкладПолучатель,
		|
		|	Т.Номенклатура                            КАК Номенклатура,
		|	Т.Характеристика                          КАК Характеристика,
		|	Т.Назначение                              КАК Назначение,
		|
		|	Т.ДлительностьВДнях                       КАК ДлительностьПеремещения,
		|	Т.ДатаПоставки                            КАК ЖелаемаяДатаПоступления,
		|	ВЫБОР КОГДА Т.ДлительностьВДнях <> 0 ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ИспользоватьДлительностьПеремещения,
		|
		|	СУММА(Т.Количество)                       КАК КоличествоУпаковок,
		|	СУММА(Т.Количество)                       КАК Количество
		|ИЗ
		|	ВтДанныеЗаполнения КАК Т
		|ГДЕ
		|	Т.ТипОбеспечения = ЗНАЧЕНИЕ(Перечисление.ТипыОбеспечения.питПеремещениеВНоменклатуруПроизводства)
		|СГРУППИРОВАТЬ ПО
		|	Т.ИсточникОбеспечения, Т.Организация, Т.Подразделение, Т.Склад, Т.НаправлениеДеятельности,
		|	Т.Номенклатура, Т.Характеристика, Т.Назначение, Т.ДатаПоставки, Т.ДлительностьВДнях
		|УПОРЯДОЧИТЬ ПО
		|	СкладОтправитель, Организация, Подразделение, СкладПолучатель,                 // порядок обхода заказов
		|	Назначение, Номенклатура, Характеристика // порядок строк в заказе
		|;
		|
		|/////////////////////////////////////////////////////////
		|";

	Возврат ТекстЗапроса;

КонецФункции

// %ИзЕРП% Обработки.ОбеспечениеПотребностей.ПолучитьДокумент
//  отслеживать изменения
//
// Параметры:
//  МенеджерДокументов - Произвольный - Менеджер документов.
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  Статус - Произвольный - Статус.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьДокумент(МенеджерДокументов, ДанныеЗаполнения, Статус)
	
	ДокументОбъект = МенеджерДокументов.СоздатьДокумент();
	ДанныеЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());
	ДанныеЗаполнения.Вставить("ЭтоОбеспечениеПотребностей", Истина);
	
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Статус) Тогда
		ДокументОбъект.Статус = Статус;
	КонецЕсли;
	
	Возврат ДокументОбъект;
	
КонецФункции

#КонецОбласти

#КонецОбласти





