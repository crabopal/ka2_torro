				СтрокаПротокола.НомерВетки = БуферНомерВетки;
				СтрокаПротокола.ТолькоДобавлена = Истина;
				
				Если СтрокаПротокола.ХЭХ = Справочники.питХимикоэнергетическиеХарактеристики.Калорийность Тогда
					СтрокаКалорийностиПротокола = СтрокаПротокола;
				КонецЕсли;
				
				// Свяжем добавленную строку с уже созданными потомками
				НайденныеСтроки = ТаблицаСостава.НайтиСтроки(Новый Структура("ХЭХ,Уровень,Родитель,ТолькоДобавлена", СтрокаПротокола.ХЭХ, БуферУровень + 1, 0, Истина));
