			КонецЦикла;
			
			// Если у нас оказались строки с пустым ХЭХ (т.е. ХЭХ не было), то надо им создать родителя.
			НайденныеСтроки = ТаблицаСостава.НайтиСтроки(Новый Структура("ХЭХ,Уровень,Родитель,ТолькоДобавлена", Справочники.питХимикоэнергетическиеХарактеристики.ПустаяСсылка(), БуферУровень + 1, 0, Истина));
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаПротокола = ТаблицаСостава.Добавить();
