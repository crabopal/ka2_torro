					СтрокаПротокола.НомерВетки = ТаблицаСостава[0].НомерВетки;
					СтрокаПротокола.ТолькоДобавлена = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		// Свернем таблицу
		ТаблицаХЭХ.Свернуть("ХимикоэнергетическаяХарактеристика,ЕдиницаИзмерения,Вычислено", "КоличествоХарактеристики");
		
		// Протокол расчета
		СтрокаКалорийностиПротокола = Неопределено;
		
		Если ВестиПротокол Тогда
			// Восстановим значения
			ТаблицаСостава[0].Уровень = БуферУровень;
