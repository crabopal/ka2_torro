	ДеревоПрайса.Колонки.Добавить("ХЭХ",             				Новый ОписаниеТипов("Строка"));
	ДеревоПрайса.Колонки.Добавить("НомерВГруппе",    				Новый ОписаниеТипов("Число"));
	ДеревоПрайса.Колонки.Добавить("ЭтоГруппа",       				Новый ОписаниеТипов("Булево"));
	ДеревоПрайса.Колонки.Добавить("Себестоимость",   				Новый ОписаниеТипов("Число"));
	ДеревоПрайса.Колонки.Добавить("СебестоимостьПоДвойномуУчету",   Новый ОписаниеТипов("Число"));
	ДеревоПрайса.Колонки.Добавить("ПроцентНаценки",  				Новый ОписаниеТипов("Число"));
	ДеревоПрайса.Колонки.Добавить("ПроцентНаценкиПоДвойномуУчету",  Новый ОписаниеТипов("Число"));
	
	ЦеныСУчетомНДС = ТипЦен.ЦенаВключаетНДС;
	
	ПредставлениеОрганизации				= ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, ТекущаяДата()), "НаименованиеДляПечатныхФорм,");
	ОбластьШапка.Параметры.Организация		= ПредставлениеОрганизации;
	ОбластьШапка.Параметры.ТекДата			= Формат(ТекущаяДата(), "ДЛФ=DD");
	ОбластьШапка.Параметры.ВидМеню			= СокрЛП(КатегорияМеню);
	ТабДокумент.Вывести(ОбластьШапка); 
	
	// СпособРасчетаРецептур = Константы.питСпособРасчетаРецептур.Получить();
	СпособРасчетаРецептур = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
	
	Запрос							= Новый Запрос();
	Запрос.МенеджерВременныхТаблиц	= Новый	МенеджерВременныхТаблиц();
	
	Запрос.УстановитьПараметр("ТипЦен",				ТипЦЕн);
	Запрос.УстановитьПараметр("ВключатьНДС",		ЦеныСУчетомНДС);
	Запрос.УстановитьПараметр("ПустойКонтрагент",	Справочники.Контрагенты.ПустаяСсылка());	
	Запрос.УстановитьПараметр("МассивНоменклатуры",	ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("ВидМеню",			КатегорияМеню);
	
	ТекстЗапросаШаблон = 
		"%1
		|;
		|%2";
	ТекстЗапросаЦены = питЦеныНоменклатуры.ТекстЗапросаЦеныНоменклатуры(ТекущаяДата(), 
		"ТаблицаЦен",, "МассивНоменклатуры", "ХарактеристикаЦен", "ТипЦен");
	Запрос.УстановитьПараметр("ХарактеристикаЦен", 
		питЦеныНоменклатуры.ПреобразоватьОтборПоХарактеристикеЦен(ТекущаяДата(), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
	
	Если СпособРасчетаРецептур <> Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ПрайсЛист.Номенклатура КАК Номенклатура,
		               |	ПрайсЛист.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ПрайсЛист.Номенклатура.ВидНоменклатуры КАК Категория,
		               |	ПрайсЛист.Рецептура КАК Рецептура,
		               |	ПрайсЛист.Ссылка КАК Ссылка,
		               |	ПрайсЛист.Родитель КАК Родитель,
		               |	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК Цена
		               |ПОМЕСТИТЬ ТаблицаДанных
		               |ИЗ
		               |	Справочник.питМеню КАК ПрайсЛист
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЦен КАК ТаблицаЦен
		               |		ПО ПрайсЛист.Номенклатура = ТаблицаЦен.Номенклатура
		               |ГДЕ
		               |	ПрайсЛист.Владелец = &ВидМеню
		               |	И ПрайсЛист.Номенклатура В(&МассивНоменклатуры)
		               |	И НЕ ПрайсЛист.ЭтоГруппа
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаДанных.Номенклатура КАК Номенклатура,
		               |	ТаблицаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ТаблицаДанных.Ссылка.Наименование КАК НазваниеВМеню,
		               |	ТаблицаДанных.Номенклатура.НаименованиеПолное КАК НоменклатураПеч,
		               |	ТаблицаДанных.Цена КАК Цена,
		               |	ТаблицаДанных.Рецептура КАК Рецептура,
		               |	ТаблицаДанных.Ссылка КАК Ссылка,
		               |	ТаблицаДанных.Родитель КАК Родитель,
		               |	ТаблицаДанных.Рецептура.Комментарий КАК Комментарий,
		               |	ТаблицаДанных.Рецептура.Выход КАК Выход
		               |ИЗ
		               |	ТаблицаДанных КАК ТаблицаДанных
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Номенклатура
		               |ИТОГИ
		               |	ВЫБОР
		               |		КОГДА НЕ Номенклатура ЕСТЬ NULL
		               |				И Рецептура ЕСТЬ NULL
		               |			ТОГДА МАКСИМУМ(ЕдиницаИзмерения)
		               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		               |	КОНЕЦ КАК ЕдиницаИзмерения,
		               |	МАКСИМУМ(НазваниеВМеню),
		               |	СРЕДНЕЕ(Цена)
		               |ПО
		               |	Родитель,
		               |	Ссылка,
		               |	Номенклатура,
		               |	ЕдиницаИзмерения,
		               |	Рецептура";
		
		Запрос.Текст = СтрШаблон(ТекстЗапросаШаблон, ТекстЗапросаЦены, ТекстЗапроса);
	Иначе
		
		// СпособРасчетаРецептур	= Константы.питСпособРасчетаРецептур.Получить();
		СпособРасчетаРецептур = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
		
		Запрос.УстановитьПараметр("ДатаОбъекта",ТекущаяДата());
		Запрос.УстановитьПараметр("ПустаяДата",Дата("00010101"));
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Рецептура.Ссылка КАК Рецептура,
		               |	ВЫБОР
		               |		КОГДА Рецептура.Основная
		               |			ТОГДА 1
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК Сортировка,
		               |	Рецептура.Номенклатура КАК Номенклатура
		               |ПОМЕСТИТЬ ТаблицаРецептурОбщая
		               |ИЗ
		               |	Документ.питРецептура КАК Рецептура
		               |ГДЕ
		               |	Рецептура.Номенклатура В(&МассивНоменклатуры)
		               |	И Рецептура.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.РецептураПриготовление)
		               |	И Рецептура.ДатаНачала <= &ДатаОбъекта
		               |	И ВЫБОР
		               |			КОГДА Рецептура.ДатаКонца = &ПустаяДата
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ Рецептура.ДатаКонца >= &ДатаОбъекта
		               |		КОНЕЦ
		               |	И НЕ Рецептура.ПометкаУдаления
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаРецептурОтбора.Рецептура КАК Рецептура,
		               |	ТаблицаРецептурОтбора.Номенклатура КАК Номенклатура
		               |ПОМЕСТИТЬ ТаблицаРецептур
		               |ИЗ
		               |	ТаблицаРецептурОбщая КАК ТаблицаРецептурОтбора
		               |ГДЕ
		               |	ТаблицаРецептурОтбора.Сортировка В
		               |			(ВЫБРАТЬ ПЕРВЫЕ 1
		               |				МИНИМУМ(ТаблицаРецептурВложенная.Сортировка)
		               |			ИЗ
		               |				ТаблицаРецептурОбщая КАК ТаблицаРецептурВложенная
		               |			ГДЕ
		               |				ТаблицаРецептурОтбора.Номенклатура = ТаблицаРецептурВложенная.Номенклатура)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ПрайсЛист.Номенклатура КАК Номенклатура,
		               |	ПрайсЛист.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ПрайсЛист.Ссылка.Наименование КАК НазваниеВМеню,
		               |	ПрайсЛист.Номенклатура.НаименованиеПолное КАК НоменклатураПеч,
		               |	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК Цена,
		               |	ВложенныйЗапрос.Рецептура КАК Рецептура,
		               |	ПрайсЛист.Ссылка КАК Ссылка,
		               |	ПрайсЛист.Родитель КАК Родитель,
		               |	ВложенныйЗапрос.Рецептура.Комментарий КАК Комментарий,
		               |	ВложенныйЗапрос.Рецептура.Выход КАК Выход
		               |ИЗ
		               |	Справочник.питМеню КАК ПрайсЛист
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЦен КАК ТаблицаЦен
		               |		ПО ПрайсЛист.Номенклатура = ТаблицаЦен.Номенклатура
		               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |			ТаблицаРецептур.Рецептура КАК Рецептура,
		               |			ТаблицаРецептур.Номенклатура КАК Номенклатура
		               |		ИЗ
		               |			ТаблицаРецептур КАК ТаблицаРецептур) КАК ВложенныйЗапрос
		               |		ПО ПрайсЛист.Номенклатура = ВложенныйЗапрос.Номенклатура
		               |ГДЕ
		               |	ПрайсЛист.Владелец = &ВидМеню
		               |	И ПрайсЛист.Номенклатура В(&МассивНоменклатуры)
		               |	И НЕ ПрайсЛист.ЭтоГруппа
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ПрайсЛист.Номенклатура
		               |ИТОГИ
		               |	ВЫБОР
		               |		КОГДА НЕ Номенклатура ЕСТЬ NULL
		               |				И Рецептура ЕСТЬ NULL
		               |			ТОГДА МАКСИМУМ(ЕдиницаИзмерения)
		               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		               |	КОНЕЦ КАК ЕдиницаИзмерения,
		               |	МАКСИМУМ(НазваниеВМеню),
		               |	СРЕДНЕЕ(Цена)
		               |ПО
		               |	Родитель,
		               |	Ссылка,
		               |	Номенклатура,
		               |	ЕдиницаИзмерения,
		               |	Рецептура";
		
		Запрос.Текст = СтрШаблон(ТекстЗапросаШаблон, ТекстЗапросаЦены, ТекстЗапроса);
	КонецЕсли;
	
	РезультатПрайс		= Запрос.Выполнить();
	
	ЗапросПоХЭХ			= Новый Запрос();
	ЗапросПоХЭХ.Текст	= "ВЫБРАТЬ ПЕРВЫЕ 1
							|	ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика
							|ИЗ
							|	РегистрСведений.питХимикоэнергетическиеХарактеристики КАК ХимикоэнергетическиеХарактеристики";
	РезультатХЭХ		= ЗапросПоХЭХ.Выполнить();
	ЕстьХЭХ				= Не РезультатХЭХ.Пустой();
	
	Категория			= "";
	ВыборкаКатегория	= РезультатПрайс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Родитель");
	Пока ВыборкаКатегория.Следующий() Цикл
		Категория		= ВыборкаКатегория.Родитель;
		Если Не ЗначениеЗаполнено(Категория) Тогда
			Категория	= Справочники.питМеню.ПустаяСсылка();
		КонецЕсли;
		ПараметрРодитель= Категория; 
		ВыборкаТовар	= ВыборкаКатегория.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Ссылка");
		Выход 			= "";
		Пока ВыборкаТовар.Следующий() Цикл
			ТекНоменклатура		= ВыборкаТовар.Ссылка.Номенклатура;
			// Попытаемся выбрать название блюда по названию элемента меню
			НоменклатураПеч		= ВыборкаТовар.НазваниеВМеню;
			// Если это название не задано, тогда выбираем наименование номенклатуры блюда
			Если Не ЗначениеЗаполнено(НоменклатураПеч) Тогда
				НоменклатураПеч = ВыборкаТовар.НоменклатураПеч;
			КонецЕсли;
			
			ВыборкаЕдиница = ВыборкаТовар.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ЕдиницаИзмерения");
			
			Пока ВыборкаЕдиница.Следующий() Цикл
				
				ЕдиницаИзмерения	= ВыборкаЕдиница.ЕдиницаИзмерения;
				Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					ЕдиницаИзмерения = ВыборкаЕдиница.Ссылка.Номенклатура.ЕдиницаИзмерения;
				КонецЕсли;
				КоэффициентЕдиницы	= питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекНоменклатура, ЕдиницаИзмерения);
				Цена				= ВыборкаТовар.Цена * КоэффициентЕдиницы;
				
				// Определяем, есть ли рецептура, она может быть только одна
				Состав				= "";
				Выход				= "";
				ТекРецептура		= Неопределено;
				ВыборкаРецептура	= ВыборкаТовар.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Рецептура");
				Если ВыборкаРецептура.Следующий() Тогда
					Попытка
						ТекРецептура	= ВыборкаРецептура.Рецептура;
						Состав			= ВыборкаРецептура.Комментарий;
						Выход			= ВыборкаРецептура.Выход;
					Исключение КонецПопытки;
				КонецЕсли;
				
				ПараметрВыход				= Выход;
				ПараметрНоменклатураПеч		= НоменклатураПеч;
				ПараметрЕдиница				= ЕдиницаИзмерения;
				ПараметрЦена				= Цена;
				ПараметрСсылка				= ВыборкаРецептура.Ссылка;
				ПараметрСостав				= "";
				ПараметрХЭХ					= "";
				
				Если ИспользуетсяСебестоимость Тогда
					ТекСебестоимость		= ПолучитьСебестоимостьНоменклатуры(ТекНоменклатура, ТекРецептура, Организация, НеИспользоватьСезонныеПроценты, КэшЗаполненияДерева);
					
					// Приведём полученную себестоимость к единице меню
					ТекСебестоимость		= ТекСебестоимость*?(ЗначениеЗаполнено(КоэффициентЕдиницы),КоэффициентЕдиницы,1);
					
					ПараметрСебестоимость	= ТекСебестоимость;
				Иначе
					ПараметрСебестоимость	= 0;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Состав) Тогда
					ПараметрСостав	= Состав; 
				КонецЕсли;
				
				Если ЕстьХЭХ Тогда
					Если ЗначениеЗаполнено(ТекРецептура) Тогда
						ТребуемоеКоличество = 1; // ТекРецептура.Количество
						СписокХЭХ			= питДиетпитание.ПолучитьСоставПечатныхХЭХ(ТекРецептура.Номенклатура, ТекРецептура, ТребуемоеКоличество * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекРецептура.Номенклатура, ТекРецептура.Упаковка), Перечисления.питВидыМакетовХЭХ.Меню);
					Иначе
						ТребуемоеКоличество = ТекНоменклатура.питКоличествоНоменклатуры; // 100
						СписокХЭХ			= питДиетпитание.ПолучитьСоставПечатныхХЭХ(ТекНоменклатура, , ТребуемоеКоличество * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекНоменклатура, ТекНоменклатура.питЕдиницаИзмеренияДляХЭХ), Перечисления.питВидыМакетовХЭХ.Меню);
					КонецЕсли;	
					Если СписокХЭХ <> Неопределено Тогда
						Разделитель	= "";
						СтрокаХЭХ	= "Пищевая ценность: ";
						Для Каждого СтрокаСпискаХЭХ Из СписокХЭХ Цикл
							СтрокаХЭХ	= СтрокаХЭХ + Разделитель + СокрЛП(СтрокаСпискаХЭХ.ХимикоэнергетическаяХарактеристика.Наименование) + 
							" - " + СтрокаСпискаХЭХ.КоличествоХарактеристики + " " + СокрЛП(СтрокаСпискаХЭХ.ЕдиницаИзмерения.Наименование);
							Если Разделитель = "" Тогда 
								Разделитель = ", "; 
							КонецЕсли;
						КонецЦикла;
						ПараметрХЭХ = СтрокаХЭХ;
					КонецЕсли;
				КонецЕсли;
				
				ДобавитьВДеревоПрайсЛиста(ДеревоПрайса, ПараметрРодитель, ПараметрСсылка, ПараметрНоменклатураПеч, ПараметрВыход, ПараметрЦена, ПараметрСостав, ПараметрХЭХ, , ПараметрСебестоимость, ПараметрЕдиница);
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ВывестиДеревоТоваров(ДеревоПрайса.Строки, ТабДокумент, ОбластьКатегория, ОбластьСтрока, ОбластьРецептура, ОбластьХЭХ, ИспользуетсяСебестоимость);
	
	Если ТипЗнч(Руководители)=Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Руководители)=Тип("Структура") Тогда
		// Получим данные лиц ответственных
		ТекущийУправляющий	= Неопределено;
		ТекущийКалькулятор	= Неопределено;
		Руководители.Свойство("Руководитель", ТекущийУправляющий);
		Руководители.Свойство("питКалькулятор", ТекущийКалькулятор);
		
		ОбластьПодвал.Параметры.Управляющий = ТекущийУправляющий;
		ОбластьПодвал.Параметры.Калькулятор = ТекущийКалькулятор;
	КонецЕсли;	
	
	ОбластьПодвал.Параметры.ОписаниеТипаЦен = "Цены указаны "+?(ЦеныСУчетомНДС,"с учетом","без учета")+" НДС";
	
	ТабДокумент.Вывести(ОбластьПодвал); 
	
	// Зададим параметры макета
	ТабДокумент.ПолеСверху          = 0;
	ТабДокумент.ПолеСлева           = 0;
	ТабДокумент.ПолеСнизу           = 0;
	ТабДокумент.ПолеСправа          = 0;
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДокумент.ОтображатьЗаголовки	= Ложь;
	ТабДокумент.ОтображатьСетку     = Ложь;
	ТабДокумент.Защита              = Истина;
	ТабДокумент.ТолькоПросмотр      = Истина;
	ТабДокумент.ПолеСлева           = 9;
	ТабДокумент.ПолеСправа          = 6;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Диетпитание_ПечатьМенюПоИерархии";
	
	Возврат ТабДокумент;
	
КонецФункции // ПечатьМенюПоИерархии()

// Печать расширенного меню (с выводом ХЭХ и групп ХЭХ).
//
// Параметры:
//  ТаблицаНоменклатуры - ТаблицаЗначений - Таблица номенклатуры.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  ТабличныйДокумент - табличный документ для печати.
Функция ПечатьРасширенноеМеню(ТаблицаНоменклатуры, ДопПараметры=Неопределено) Экспорт
	Перем ИскатьПоВсемОрганизациям;
	
	Если (ТипЗнч(ТаблицаНоменклатуры)<>Тип("ТаблицаЗначений") ИЛИ ТаблицаНоменклатуры.Количество()=0) Тогда 
		Возврат Неопределено; 
	КонецЕсли;
	
	ТабДокумент				= Новый ТабличныйДокумент();
	ФорматВыводаСуммы		= "ЧЦ=15; ЧДЦ=2; ЧН=0.00";
	ФорматВыводаКоличества	= "ЧЦ=10; ЧДЦ=3; ЧН=0.00";
	
	Попытка
		Организация						= ДопПараметры["Организация"];			
		КатегорияМеню					= ДопПараметры["КатегорияМеню"];
	Исключение
		Организация						= питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
		КатегорияМеню					= Справочники.питВидыМеню.ПустаяСсылка();
	КонецПопытки;	
	
	Руководители = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Организация, ТекущаяДата());
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_питРасширенноеМеню");
	
	// Сформируем список ХЭХ (ТаблицаВыводимыхХЭХ) в порядке возрастания приоритетов для макета "Расширенное меню".
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
					|	БазовыйЗапрос.ХимикоэнергетическаяХарактеристика,
					|	БазовыйЗапрос.ГруппаХЭХ,
					|	МАКСИМУМ(БазовыйЗапрос.ИсхПриоритет) КАК ИсхПриоритет,
					|	МАКСИМУМ(БазовыйЗапрос.ФормироватьГруппы) КАК ФормироватьГруппы,
					|	МАКСИМУМ(БазовыйЗапрос.Приоритет) КАК Приоритет,
					|	МАКСИМУМ(БазовыйЗапрос.ВычислФормироватьГруппы) КАК ВычислФормироватьГруппы,
					|	БазовыйЗапрос.ЕдиницаИзмерения
					|ИЗ
					|	(ВЫБРАТЬ
					|		ХЭХДляПечати.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика,
					|		ХЭХДляПечати.ХимикоэнергетическаяХарактеристика.ГруппаХЭХ КАК ГруппаХЭХ,
					|		ХЭХДляПечати.Приоритет КАК ИсхПриоритет,
					|		ХЭХДляПечати.ФормироватьГруппыПриВыводе КАК ФормироватьГруппы,
					|		-1 КАК Приоритет,
					|		ЛОЖЬ КАК ВычислФормироватьГруппы,
					|		ХЭХДляПечати.ХимикоэнергетическаяХарактеристика.ЕдиницаИзмерения КАК ЕдиницаИзмерения
					|	ИЗ
					|		РегистрСведений.питХЭХДляПечати КАК ХЭХДляПечати
					|	ГДЕ
					|		ХЭХДляПечати.Макет = &ВсеМакеты
					|	
					|	ОБЪЕДИНИТЬ ВСЕ
					|	
					|	ВЫБРАТЬ
					|		ХЭХДляПечати.ХимикоэнергетическаяХарактеристика,
					|		ХЭХДляПечати.ХимикоэнергетическаяХарактеристика.ГруппаХЭХ,
					|		ХЭХДляПечати.Приоритет,
					|		ХЭХДляПечати.ФормироватьГруппыПриВыводе,
					|		ХЭХДляПечати.Приоритет,
					|		ХЭХДляПечати.ФормироватьГруппыПриВыводе,
					|		ХЭХДляПечати.ХимикоэнергетическаяХарактеристика.ЕдиницаИзмерения
					|	ИЗ
					|		РегистрСведений.питХЭХДляПечати КАК ХЭХДляПечати
					|	ГДЕ
					|		ХЭХДляПечати.Макет = &ДанныйМакет) КАК БазовыйЗапрос
					|
					|СГРУППИРОВАТЬ ПО
					|	БазовыйЗапрос.ХимикоэнергетическаяХарактеристика,
					|	БазовыйЗапрос.ГруппаХЭХ,
					|	БазовыйЗапрос.ЕдиницаИзмерения";
	
	Запрос.УстановитьПараметр("ВсеМакеты",    Перечисления.питВидыМакетовХЭХ.ВсеМакеты);
	Запрос.УстановитьПараметр("ДанныйМакет",  Перечисления.питВидыМакетовХЭХ.РасширенноеМеню);
	ТаблицаВыводимыхХЭХ = Запрос.Выполнить().Выгрузить();
	
	// Выясним, выводить ли группы в ПФ, а также вычислим приоритет, если ХЭХ имеется и в
	// макете "Расширенное меню" и во всех макетах.
	ВыводитьГруппы = Ложь;
	Для Каждого СтрокаВыводимыхХЭХ Из ТаблицаВыводимыхХЭХ Цикл
		Если СтрокаВыводимыхХЭХ.Приоритет >= 0 Тогда
			ВыводитьГруппы = СтрокаВыводимыхХЭХ.ВычислФормироватьГруппы;
		Иначе
			Если ВыводитьГруппы = Неопределено Тогда
				ВыводитьГруппы = СтрокаВыводимыхХЭХ.ФормироватьГруппы;
			КонецЕсли;
			СтрокаВыводимыхХЭХ.Приоритет = СтрокаВыводимыхХЭХ.ИсхПриоритет;
		КонецЕсли;
	КонецЦикла;
	ТаблицаВыводимыхХЭХ.Сортировать("Приоритет");
	ТаблицаВыводимыхХЭХ.Колонки.Удалить("ИсхПриоритет");
	ТаблицаВыводимыхХЭХ.Колонки.Удалить("ФормироватьГруппы");
	ТаблицаВыводимыхХЭХ.Колонки.Удалить("ВычислФормироватьГруппы");
	ТаблицаВыводимыхХЭХ.Колонки.Добавить("Ширина", Новый ОписаниеТипов("Число"));
	
	ТабШапкаТаблицы		= Новый ТабличныйДокумент();
	
	// Формируем шапку таблицы
	Если ВыводитьГруппы Тогда
		СтрокаГруппы = "СГруппой|";
	Иначе
		СтрокаГруппы = "БезГруппы|";
	КонецЕсли;
	
	// Ячейка "Наименование" шапки таблицы
	ОбластьШапкаТаблицы		= Макет.ПолучитьОбласть(СтрокаГруппы + "КолонкаНаименование");
	ТабШапкаТаблицы.Вывести(ОбластьШапкаТаблицы);
	// Ячейка "Выход" шапки таблицы
	ОбластьШапкаВыход		= Макет.ПолучитьОбласть(СтрокаГруппы + "КолонкаВыход");
	ТабШапкаТаблицы.Присоединить(ОбластьШапкаВыход);
	
	// Определяем минимальную ширину колонки "ХЭХ" и размер шрифта для определения фактической ширины колонки.
	ДанныеОбласти 			= Макет.ПолучитьОбласть(СтрокаГруппы + "КолонкаХЭХ").Область("R1C1");
	ШиринаХЭХ				= ДанныеОбласти.ШиринаКолонки;
	РазмерШрифта			= ДанныеОбласти.Шрифт.Размер;
	
	// Начинаем добавление колонок "ХЭХ" и "Группа ХЭХ" в шапку таблицы.
	ГруппаХЭХ				= Неопределено;
	ТабХЭХ					= Неопределено;
	КоличествоХЭХ			= 0;
	Для Каждого СтрокаВыводимыхХЭХ Из ТаблицаВыводимыхХЭХ Цикл
		// Определим фактическую ширину колонки "ХЭХ", чтобы в нее поместилось наименование ХЭХ.
		СтрокаВыводимыхХЭХ.Ширина	= Макс(ШиринаХЭХ, (СтрДлина(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.Наименование) + 1) * РазмерШрифта / 8);
		ОбластьШапкиХЭХ				= Макет.ПолучитьОбласть(СтрокаГруппы + "КолонкаХЭХ");
		Если ВыводитьГруппы Тогда
			// Начинается вывод новой группы
			Если СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.ГруппаХЭХ <> ГруппаХЭХ Тогда
				// Если до этого группа выводилась, то объединим ячейки этой группы в одну.
				Если (ГруппаХЭХ <> Неопределено) И ЗначениеЗаполнено(ГруппаХЭХ) Тогда
					ТабХЭХ.Область("R1C1:R1C"+СокрЛП(КоличествоХЭХ)).Объединить();
					ТабШапкаТаблицы.Присоединить(ТабХЭХ);
				КонецЕсли;
				// Новый документ для вывода "ХЭХ"/"ГруппаХЭХ"
				ТабХЭХ			= Новый ТабличныйДокумент();
				КоличествоХЭХ	= 0;
				ГруппаХЭХ		= СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.ГруппаХЭХ;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.ГруппаХЭХ) Тогда
				// Если "ГруппаХЭХ" не заполнена, то сразу выводим ХЭХ без выяснения группы.
				ОбластьШапкиХЭХ								= Макет.ПолучитьОбласть(СтрокаГруппы + "КолонкаТолькоХЭХ");
				ОбластьШапкиХЭХ.Область("C1").ШиринаКолонки = СтрокаВыводимыхХЭХ.Ширина;
				ОбластьШапкиХЭХ.Параметры.ТолькоХЭХ			= СокрЛП(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика) + ", " + СокрЛП(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.ЕдиницаИзмерения);
				ТабХЭХ.Вывести(ОбластьШапкиХЭХ);
				ТабШапкаТаблицы.Присоединить(ТабХЭХ);
				// Создаем новый документ для вывода "ХЭХ"/"ГруппаХЭХ" (считаем, что отсутствие группы тоже группа).
				ТабХЭХ			= Новый ТабличныйДокумент();
				КоличествоХЭХ	= 0;
				ГруппаХЭХ		= СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.ГруппаХЭХ;
				Продолжить;
			КонецЕсли;
			// Добавляем новый ХЭХ в пределах текущей группы ХЭХ
			ОбластьШапкиХЭХ.Область("C1").ШиринаКолонки		= СтрокаВыводимыхХЭХ.Ширина;
			ОбластьШапкиХЭХ.Параметры.ХЭХ					= СокрЛП(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика) + ", " + СокрЛП(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.ЕдиницаИзмерения);
			ОбластьШапкиХЭХ.Параметры.ГруппаХЭХ				= ГруппаХЭХ;
			ТабХЭХ.Присоединить(ОбластьШапкиХЭХ);
			КоличествоХЭХ		= КоличествоХЭХ + 1;
		Иначе
			// ХЭХ может изначально выводится без группы
			ОбластьШапкиХЭХ.Область("C1").ШиринаКолонки		= СтрокаВыводимыхХЭХ.Ширина;
			ОбластьШапкиХЭХ.Параметры.ХЭХ					= СокрЛП(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика) + ", " + СокрЛП(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика.ЕдиницаИзмерения);
			ТабШапкаТаблицы.Присоединить(ОбластьШапкиХЭХ);
		КонецЕсли;
	КонецЦикла;
	
	// При выходе из вышестоящего цикла последняя группа не выведена - выведем.
	Если ВыводитьГруппы И (ГруппаХЭХ <> Неопределено) И ЗначениеЗаполнено(ГруппаХЭХ) Тогда
		ТабХЭХ.Область("R1C1:R1C"+СокрЛП(КоличествоХЭХ)).Объединить();
		ТабШапкаТаблицы.Присоединить(ТабХЭХ);
	КонецЕсли;	
	
	// Определим ширину всей таблицы
	ШиринаТаблицы = 0;
	Для Счетчик = 1 По ТабШапкаТаблицы.ШиринаТаблицы Цикл
		ШиринаТаблицы = ШиринаТаблицы + ТабШапкаТаблицы.Область("C"+СокрЛП(Счетчик)).ШиринаКолонки;
	КонецЦикла;
	
	// Выводим секцию "Шапка"
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	ИсходнаяШирина = 0;
	Для Счетчик = 1 По ОбластьЗаголовок.ШиринаТаблицы Цикл
		ИсходнаяШирина = ИсходнаяШирина + ОбластьЗаголовок.Область("C"+СокрЛП(Счетчик)).ШиринаКолонки;
	КонецЦикла;
	
	// Так как ширина шапки отличается от ширины заголовка в макете, подкорректируем ширину заголовка.
	ОбластьЗаголовок.Область("C2").ШиринаКолонки = ?(ИсходнаяШирина > ШиринаТаблицы, ОбластьЗаголовок.Область("C2").ШиринаКолонки, ШиринаТаблицы - ИсходнаяШирина + ОбластьЗаголовок.Область("C2").ШиринаКолонки);
	
	// Заполним параметры заголовка
	ПредставлениеОрганизации				= ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, ТекущаяДата()), "НаименованиеДляПечатныхФорм,");
	ОбластьЗаголовок.Параметры.Организация	= ПредставлениеОрганизации;
	ОбластьЗаголовок.Параметры.ТекДата		= Формат(ТекущаяДата(), "ДЛФ=DD");
	ОбластьЗаголовок.Параметры.ВидМеню		= СокрЛП(КатегорияМеню);
	
	// Выведем заголовок
	ТабЗаголовок							= Новый ТабличныйДокумент();
	ТабЗаголовок.Вывести(ОбластьЗаголовок);
	ТабЗаголовок.Область().СоздатьФорматСтрок();
	ТабДокумент.Вывести(ТабЗаголовок);
	// Выведем шапку таблицы
	ТабШапкаТаблицы.Область().СоздатьФорматСтрок();
	ТабДокумент.Вывести(ТабШапкаТаблицы);
	
	// Получим записи элементов меню для данного владельца.
	
	// СпособРасчетаРецептур = Константы.питСпособРасчетаРецептур.Получить();
	СпособРасчетаРецептур = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
	
	Если СпособРасчетаРецептур <> Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре Тогда
		// Если способ расчета "По рецептуре", то рецептура просто выбирается как реквизит.
		Запрос=Новый Запрос("ВЫБРАТЬ
							|	ПрайсЛист.Номенклатура КАК Номенклатура,
							|	ПрайсЛист.Наименование КАК НазваниеВМеню,
							|	ПрайсЛист.Номенклатура.НаименованиеПолное КАК НоменклатураПеч,
							|	ПрайсЛист.Номенклатура.ВидНоменклатуры КАК Категория,
							|	ПрайсЛист.Рецептура КАК Рецептура,
							|	ПрайсЛист.Рецептура.Комментарий КАК Комментарий,
							|	ПрайсЛист.Рецептура.Выход КАК Выход
							|ИЗ
							|	Справочник.питМеню КАК ПрайсЛист
							|ГДЕ
							|	ПрайсЛист.Владелец = &ВидМеню
							|	И ПрайсЛист.Номенклатура В (&МассивНоменклатуры)
							|	И (НЕ ПрайсЛист.ЭтоГруппа)
							|
							|УПОРЯДОЧИТЬ ПО
							|	ПрайсЛист.Номенклатура.ВидНоменклатуры,
							|	Номенклатура
							|ИТОГИ
							|	МАКСИМУМ(НазваниеВМеню)
							|ПО
							|	Категория,
							|	Номенклатура,
							|	Рецептура");
	Иначе
		
		Запрос		= Новый Запрос();
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Рецептура.Ссылка КАК Рецептура,
		               |	ВЫБОР
		               |		КОГДА Рецептура.Основная
		               |			ТОГДА 1
		               |		ИНАЧЕ 0
		               |	КОНЕЦ КАК Сортировка,
		               |	Рецептура.Номенклатура КАК Номенклатура
		               |ПОМЕСТИТЬ ТаблицаРецептурОбщая
		               |ИЗ
		               |	Документ.питРецептура КАК Рецептура
		               |ГДЕ
		               |	Рецептура.Номенклатура В(&МассивНоменклатуры)
		               |	И Рецептура.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.РецептураПриготовление)
		               |	И Рецептура.ДатаНачала <= &ДатаОбъекта
		               |	И ВЫБОР
		               |			КОГДА Рецептура.ДатаКонца = &ПустаяДата
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ Рецептура.ДатаКонца >= &ДатаОбъекта
		               |		КОНЕЦ
		               |	И НЕ Рецептура.ПометкаУдаления
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ПрайсЛист.Номенклатура КАК Номенклатура,
		               |	ПрайсЛист.Наименование КАК НазваниеВМеню,
		               |	ПрайсЛист.Номенклатура.НаименованиеПолное КАК НоменклатураПеч,
		               |	ПрайсЛист.Номенклатура.ВидНоменклатуры КАК Категория,
		               |	ВложенныйЗапрос.Рецептура КАК Рецептура,
		               |	ВложенныйЗапрос.Рецептура.Выход КАК Выход,
		               |	ВложенныйЗапрос.Рецептура.Комментарий КАК Комментарий
		               |ИЗ
		               |	Справочник.питМеню КАК ПрайсЛист
		               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |			ТаблицаРецептурОтбора.Рецептура КАК Рецептура,
		               |			ТаблицаРецептурОтбора.Номенклатура КАК Номенклатура
		               |		ИЗ
		               |			ТаблицаРецептурОбщая КАК ТаблицаРецептурОтбора
		               |		ГДЕ
		               |			ТаблицаРецептурОтбора.Сортировка В
		               |					(ВЫБРАТЬ ПЕРВЫЕ 1
		               |						МИНИМУМ(ТаблицаРецептурВложенная.Сортировка)
		               |					ИЗ
		               |						ТаблицаРецептурОбщая КАК ТаблицаРецептурВложенная
		               |					ГДЕ
		               |						ТаблицаРецептурОтбора.Номенклатура = ТаблицаРецептурВложенная.Номенклатура)) КАК ВложенныйЗапрос
		               |		ПО ПрайсЛист.Номенклатура = ВложенныйЗапрос.Номенклатура
		               |ГДЕ
		               |	ПрайсЛист.Номенклатура В(&МассивНоменклатуры)
		               |	И НЕ ПрайсЛист.ЭтоГруппа
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ПрайсЛист.Номенклатура.ВидНоменклатуры,
		               |	ПрайсЛист.Номенклатура
		               |ИТОГИ ПО
		               |	Категория,
		               |	Номенклатура,
		               |	Рецептура";
		
		Запрос.Текст	= ТекстЗапроса;
		
		Запрос.УстановитьПараметр("ДатаОбъекта", ТекущаяДата());
		Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидМеню", КатегорияМеню);
	Запрос.УстановитьПараметр("МассивНоменклатуры",ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	
	РезультатПрайс		= Запрос.Выполнить();
	
	ЕдиницаКонстантаХЭХ = Константы.питЕдиницаИзмеренияПоКлассификаторуДляХЭХ.Получить();
	
	// Выполним обход результата запроса по "Категория"
	Категория			= "";
	ВыборкаКатегория	= РезультатПрайс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Категория");
	Пока ВыборкаКатегория.Следующий() Цикл
		
		Категория		= ВыборкаКатегория.Категория;
		Если Не ЗначениеЗаполнено(Категория) Тогда
			Категория	= "Прочие";
		КонецЕсли;
		// Выводим строку с наименованием категории
		ТабКатегория	= Новый ТабличныйДокумент();
		ОбластьКатегорияОтступ	= Макет.ПолучитьОбласть("СтрокаКатегории|КолонкаКатегорияОтступ");
		ТабКатегория.Вывести(ОбластьКатегорияОтступ);
		// Для совпадения ширины строки категории и шапки таблицы выводим секцию по ячейкам с шириной,
		// равной ширине ячеек шапки, а потом все ячейки объединяем (начинаем со второй: первая - отступ).
		Для Счетчик = 2 По ТабШапкаТаблицы.ШиринаТаблицы Цикл
			ОбластьКатегория						= Макет.ПолучитьОбласть("СтрокаКатегории|КолонкаКатегория");
			ОбластьКатегория.Область().СоздатьФорматСтрок();
			ОбластьКатегория.Область("C1").ШиринаКолонки = ТабШапкаТаблицы.Область("C" + СокрЛП(Счетчик)).ШиринаКолонки;
			ОбластьКатегория.Параметры.Категория	= Категория;
			ТабКатегория.Присоединить(ОбластьКатегория);
		КонецЦикла;
		Диапазон = "R1C2:R1C" + СокрЛП(ТабКатегория.ШиринаТаблицы);
		ТабКатегория.Область(Диапазон).Объединить();
		// Обведем строку категории
		ТабКатегория.Область(Диапазон).ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1, 0);
		ТабКатегория.Область(Диапазон).ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1, 0);
		ТабКатегория.Область(Диапазон).ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1, 0);
		ТабКатегория.Область(Диапазон).ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1, 0);
		ТабДокумент.Вывести(ТабКатегория); 
		
		// Обойдем результат запроса внутри категории
		ВыборкаТовар=ВыборкаКатегория.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Номенклатура");
		Выход = "";
		Пока ВыборкаТовар.Следующий() Цикл
			ТабБлюдо			= Новый ТабличныйДокумент();
			
			ТекНоменклатура 	= ВыборкаТовар.Номенклатура;
			// Попытаемся выбрать название блюда по названию элемента меню.
			НоменклатураПеч 	= ВыборкаТовар.НазваниеВМеню;
			// Если это название не задано, тогда выбираем наименование номенклатуры блюда.
			Если Не ЗначениеЗаполнено(НоменклатураПеч) Тогда
				НоменклатураПеч = ВыборкаТовар.НоменклатураПеч;
			КонецЕсли;
			// Определим, есть ли рецептура, она может быть только одна.
			Состав				= "";
			Выход				= "";
			ТекРецептура		= Неопределено;
			
			ВыборкаРецептура=ВыборкаТовар.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Рецептура");
			Если ВыборкаРецептура.Следующий() Тогда
				Попытка
					ТекРецептура= ВыборкаРецептура.Рецептура;
					Состав		= ВыборкаРецептура.Комментарий;
					Выход		= ВыборкаРецептура.Выход;
				Исключение КонецПопытки;
			КонецЕсли;
			
			// Если рецептура не указана, пробуем подобрать
			Если Не ЗначениеЗаполнено(ТекРецептура) Тогда
				ТекРецептура	= питПроизводство.ВернутьОсновнуюРецептуру(ТекНоменклатура,, Перечисления.питХозяйственныеОперации.РецептураПриготовление, ТекущаяДата(), СпособРасчетаРецептур, , Организация, ИскатьПоВсемОрганизациям);
				Попытка
					Состав		= ТекРецептура.Комментарий;
					Выход		= ТекРецептура.Выход;
				Исключение КонецПопытки;
			КонецЕсли;
			
			// Поле "Выход" рецептуры разбиваем на две части: числовую (количество) и текстовую (единица измерения).
			Счетчик = Найти(Выход, " ");
			Если Счетчик > 0 Тогда
				ВыходКоличество		= СокрЛП(Сред(Выход, 1, Счетчик - 1));
				ВыходЕдиница		= СокрЛП(Сред(Выход, Счетчик + 1, СтрДлина(Выход) - Счетчик));
			Иначе
				ВыходКоличество		= Выход;
				ВыходЕдиница		= "";
			КонецЕсли;
			
			// Определим единицу измерения количества, на которое рассчитываем состав ХЭХ.
			Если ЗначениеЗаполнено(ТекРецептура) Тогда
				// Для блюда с рецептурой.
				// Ищем единицу в зависимости от использования.
					
				Если ЗначениеЗаполнено(ЕдиницаКонстантаХЭХ) Тогда
					ЕдиницаХЭХ			= ЕдиницаКонстантаХЭХ;
					Подсказка 			= "";
					ТребуемоеКоличество = 100 * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекРецептура.Номенклатура, ЕдиницаКонстантаХЭХ);
				Иначе
					ЕдиницаХЭХ			= ТекРецептура.Упаковка;
					Подсказка			= " (НА 1 " + ВРег(ЕдиницаХЭХ.Наименование) + ")";
					ТребуемоеКоличество = 1 * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекРецептура.Номенклатура, ЕдиницаХЭХ);
				КонецЕсли;
				СписокХЭХ				= ПолучитьСоставПечатныхХЭХ(ТекРецептура.Номенклатура, ТекРецептура, ТребуемоеКоличество, Перечисления.питВидыМакетовХЭХ.РасширенноеМеню, ТаблицаВыводимыхХЭХ, Ложь);
			Иначе
				// Для товара или блюда без рецептуры.
				// Ищем единицу в зависимости от использования.
				Если ЗначениеЗаполнено(ЕдиницаКонстантаХЭХ) Тогда
					ЕдиницаХЭХ			= ЕдиницаКонстантаХЭХ;
					Подсказка			= "";
					ТребуемоеКоличество = 100 * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекРецептура.Номенклатура, ЕдиницаКонстантаХЭХ);
				Иначе
					ЕдиницаХЭХ 			= ТекНоменклатура.ЕдиницаИзмерения;
					Подсказка			= " (НА 1 " + ВРег(ЕдиницаХЭХ.Наименование) + ")";
					ТребуемоеКоличество = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекРецептура.Номенклатура, ЕдиницаХЭХ);
				КонецЕсли;
				СписокХЭХ = ПолучитьСоставПечатныхХЭХ(ТекНоменклатура, , ТребуемоеКоличество, Перечисления.питВидыМакетовХЭХ.РасширенноеМеню, ТаблицаВыводимыхХЭХ, Ложь);
			КонецЕсли;
			
			// Выводим в строке таблицы наименование блюда/товара и выход.
			ОбластьНоменклатура							= Макет.ПолучитьОбласть("СтрокаБлюда|КолонкаНаименование");
			ОбластьНоменклатура.Параметры.Наименование	= СокрЛП(НоменклатураПеч) + Подсказка;
			ТабБлюдо.Вывести(ОбластьНоменклатура);
			ОбластьВыходКоличество						= Макет.ПолучитьОбласть("СтрокаБлюда|КолонкаКоличество");
			ОбластьВыходКоличество.Параметры.Количество = ВыходКоличество;
			ТабБлюдо.Присоединить(ОбластьВыходКоличество);
			ОбластьВыходЕдиница							= Макет.ПолучитьОбласть("СтрокаБлюда|КолонкаЕдиница");
			ОбластьВыходЕдиница.Параметры.ЕдИзм			= ВыходЕдиница;
			ТабБлюдо.Присоединить(ОбластьВыходЕдиница);
			
			// Выводим поочередно количество ХЭХ для данного блюда/товара.
			Для Каждого СтрокаВыводимыхХЭХ Из ТаблицаВыводимыхХЭХ Цикл
				Если СписокХЭХ <> Неопределено Тогда
					// Если такая ХЭХ есть - выведем, иначе ставим прочерк.
					СтрокаХЭХ		= СписокХЭХ.Найти(СтрокаВыводимыхХЭХ.ХимикоэнергетическаяХарактеристика, "ХимикоэнергетическаяХарактеристика");
					Если СтрокаХЭХ <> Неопределено Тогда
						Если СтрокаХЭХ.КоличествоХарактеристики = 0 Тогда
							КоличествоХЭХ	= "-";
						Иначе	
							КоличествоХЭХ	= Формат(СтрокаХЭХ.КоличествоХарактеристики, "ЧЦ=15; ЧДЦ=3");
						КонецЕсли;	
					Иначе
						КоличествоХЭХ		= "-";
					КонецЕсли;
				Иначе
					КоличествоХЭХ			= "-";
				КонецЕсли;
				ОбластьХЭХБлюда							= Макет.ПолучитьОбласть("СтрокаБлюда|КолонкаХЭХ");
				ОбластьХЭХБлюда.Область().ШиринаКолонки = СтрокаВыводимыхХЭХ.Ширина;
				ОбластьХЭХБлюда.Параметры.ХЭХ			= КоличествоХЭХ;
				ТабБлюдо.Присоединить(ОбластьХЭХБлюда);
			КонецЦикла;
			ТабБлюдо.Область().СоздатьФорматСтрок();
			ТабДокумент.Вывести(ТабБлюдо);
		КонецЦикла;
	КонецЦикла;
	
	// Выведем подвал
	ОбластьПодвал								= Макет.ПолучитьОбласть("Подвал");
	ТабПодвал									= Новый ТабличныйДокумент();
	ОбластьПодвал.Область("C2").ШиринаКолонки	= ?(ИсходнаяШирина > ШиринаТаблицы, ОбластьПодвал.Область("C2").ШиринаКолонки, ШиринаТаблицы - ИсходнаяШирина + ОбластьПодвал.Область("C2").ШиринаКолонки);
	ОбластьПодвал.Параметры.ЕдиницаДляХЭХ		= ЕдиницаКонстантаХЭХ;
	
	Если ТипЗнч(Руководители)=Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Руководители)=Тип("Структура") Тогда
		// Получим данные лиц ответственных
		ТекущийУправляющий	= Неопределено;
		ТекущийКалькулятор	= Неопределено;
		Руководители.Свойство("Руководитель", ТекущийУправляющий);
		Руководители.Свойство("питКалькулятор", ТекущийКалькулятор);
		
		ОбластьПодвал.Параметры.Управляющий = ТекущийУправляющий;
		ОбластьПодвал.Параметры.Калькулятор = ТекущийКалькулятор;
	КонецЕсли;
	
	ТабПодвал.Вывести(ОбластьПодвал);
	ТабПодвал.Область().СоздатьФорматСтрок();
	ТабДокумент.Вывести(ТабПодвал);
	
	// Зададим параметры макета
	ТабДокумент.ПолеСверху          = 0;
	ТабДокумент.ПолеСлева           = 0;
	ТабДокумент.ПолеСнизу           = 0;
	ТабДокумент.ПолеСправа          = 0;
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ОтображатьЗаголовки = Ложь;
	ТабДокумент.ОтображатьСетку     = Ложь;
	ТабДокумент.Защита              = Истина;
	ТабДокумент.ТолькоПросмотр      = Истина;
	ТабДокумент.ПолеСлева           = 9;
	ТабДокумент.ПолеСправа          = 6;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Диетпитание_ПечатьРасширенноеМеню";
	
	Возврат ТабДокумент;
	
КонецФункции // ПечатьРасширенноеМеню()

#КонецОбласти

#Область ПечатьНедовложений

// Формирует табличный документ потребности в ингредиентах
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  Реж - Произвольный - Реж.
//
// Возвращаемое значение:
//  ТабличныйДокумент -  потребность в ингредиентах
Функция ПечатьПотребностьВИнгредиентах(МассивОбъектов, ОбъектыПечати, Реж="") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСлева  = 0;
	ТабличныйДокумент.ПолеСнизу  = 0;
	ТабличныйДокумент.ПолеСправа = 0;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ЭтоВыпуск = (ТипЗнч(МассивОбъектов[0]) = Тип("ДокументОбъект.питВыпускБлюд")) ИЛИ (ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.питВыпускБлюд"));
	ЭтоПланМеню = (ТипЗнч(МассивОбъектов[0]) = Тип("ДокументОбъект.питПланМеню")) ИЛИ (ТипЗнч(МассивОбъектов[0]) = Тип("ДокументСсылка.питПланМеню"));
	
	Если ЭтоВыпуск Тогда 
		СтрИмяДокумента = "ВыпускБлюд";
		ИмяПоляСклад = "Склад";
	КонецЕсли;
	
	Если ЭтоПланМеню Тогда 
		СтрИмяДокумента = "ПланМеню";
		ИмяПоляСклад = "ЦеховаяКладовая";
	КонецЕсли;
	
	Если ЭтоПланМеню Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_питПотребностьВИнгредиентахПланМеню");
		ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_"+СтрИмяДокумента+"_ПотребностьВИнгредиентахПланМеню";
	Иначе
		Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_питПотребностьВИнгредиентах");
		ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_"+СтрИмяДокумента+"_ПотребностьВИнгредиентах";
	КонецЕсли;
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДокументСсылка Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураТаблицПроизводства = питПроизводство.АнализНедовложений(ДокументСсылка, ДокументСсылка[ИмяПоляСклад], , Истина);
		
		ТаблицаПроизводства = СтруктураТаблицПроизводства.ТаблицаПроизводства;
		ТаблицаЗамен = СтруктураТаблицПроизводства.ТаблицаЗамен;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заголовок = "Потребность в ингредиентах";
		ОбластьМакета.Параметры.НомерДок = ДокументСсылка.Номер;
		ОбластьМакета.Параметры.ДатаДок = Формат(ДокументСсылка.Дата,"ДФ = дд.ММ.гггг");
		ОбластьМакета.Параметры.МестоХранения = ДокументСсылка[ИмяПоляСклад];
		СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДокументСсылка.Организация, ДокументСсылка.Дата);
		ОбластьМакета.Параметры.ОрганизацияПредставление = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьТовар = Макет.ПолучитьОбласть("Товар");
		
		// Удалим автопеределы
		ПеременнаяЦикла = ТаблицаПроизводства.Количество()-1;
		Если Реж <> "ПоБлюдамСПолуфабрикатами" Тогда 
			Пока ПеременнаяЦикла >= 0 Цикл
				Если ТаблицаПроизводства[ПеременнаяЦикла].ИзАвтопеределов Тогда
					ТаблицаПроизводства.Удалить(ПеременнаяЦикла);
				КонецЕсли;
				ПеременнаяЦикла = ПеременнаяЦикла - 1;
			КонецЦикла;
		КонецЕсли;
		
		// Подготовим таблицу для вывода
		Если Реж = "ПоБлюдам" Тогда
			ТаблицаПроизводства.Свернуть("Ингредиент,ХарактеристикаИнгредиента,ЕдиницаИзмеренияИнгредиента,Номенклатура,Характеристика,ЕдиницаИзмеренияНоменклатуры,Рецептура","КоличествоУпаковокИнгредиентаНорма,КоличествоУпаковокИнгредиентаФакт,КоличествоУпаковокНоменклатуры,КоличествоУпаковокИнгредиентаИсходное");
			ТаблицаПроизводства.Сортировать("Номенклатура,Характеристика,Ингредиент,ХарактеристикаИнгредиента");
			ТаблицаЗамен.Свернуть("Блюдо,ХарактеристикаБлюда,Рецептура,ИнгредиентИсходный,ХарактеристикаИнгредиентаИсходного,УпаковкаИнгредиентаИсходный","КоличествоУпаковокИнгредиентаИсходный");
		ИначеЕсли Реж = "ПоБлюдамСПолуфабрикатами" Тогда
			ТаблицаПроизводства.Сортировать("Номенклатура, Характеристика, РецептураАвтопередела, Ингредиент, ХарактеристикаИнгредиента");
			ТаблицаПроизводства.Свернуть("Ингредиент,ХарактеристикаИнгредиента,ЕдиницаИзмеренияИнгредиента,Номенклатура,Характеристика,ЕдиницаИзмеренияНоменклатуры,Рецептура,РецептураАвтопередела","КоличествоУпаковокИнгредиентаНорма,КоличествоУпаковокИнгредиентаФакт,КоличествоУпаковокНоменклатуры,КоличествоУпаковокИнгредиентаИсходное");
			ТаблицаЗамен.Свернуть("Блюдо,ХарактеристикаБлюда,Рецептура,ИнгредиентИсходный,ХарактеристикаИнгредиентаИсходного,УпаковкаИнгредиентаИсходный","КоличествоУпаковокИнгредиентаИсходный");
		Иначе	
			ТаблицаПроизводства.Свернуть("Ингредиент,ХарактеристикаИнгредиента,ЕдиницаИзмеренияИнгредиента","КоличествоУпаковокИнгредиентаНорма,КоличествоУпаковокИнгредиентаФакт,КоличествоУпаковокИнгредиентаИсходное");
			ТаблицаПроизводства.Сортировать("Ингредиент,ХарактеристикаИнгредиента");
			ТаблицаЗамен.Свернуть("ИнгредиентИсходный,ХарактеристикаИнгредиентаИсходного,УпаковкаИнгредиентаИсходный","КоличествоУпаковокИнгредиентаИсходный");
		КонецЕсли;
		
		// Обходим таблицу Производства и выводим ее на просмотр
		Если Реж = "ПоБлюдам" ИЛИ Реж = "ПоБлюдамСПолуфабрикатами" Тогда
			ТекБлюдо = Неопределено;
			ТекХарактеристикаБлюда = Неопределено;
			ТекРецептура = Неопределено;
			ОбластьБлюдо = Макет.ПолучитьОбласть("Блюдо");
			ОбластьРецептура = Макет.ПолучитьОбласть("Рецептура");
		КонецЕсли;
		
		ФорматВыводаКоличества = "ЧДЦ=3";
		
		ПечататьАртикул = (Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить() = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул);
		
		Ном = 1;
		Для Каждого СтрокаПроизводства Из ТаблицаПроизводства Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаПроизводства.Ингредиент) Тогда
//   Если по блюду не нашлось рецептуры, то будет пустая строка в таблице производства, которую мы не будем
// обрабатывать.
				Продолжить; 
			КонецЕсли;
			
			Если (Реж = "ПоБлюдам" ИЛИ Реж = "ПоБлюдамСПолуфабрикатами") И ((ТекБлюдо <> СтрокаПроизводства.Номенклатура) ИЛИ (ТекХарактеристикаБлюда <> СтрокаПроизводства.Характеристика)) Тогда
				ОбластьБлюдо.Параметры.Блюдо = СтрокаПроизводства.Номенклатура.НаименованиеПолное + ?(ЗначениеЗаполнено(СтрокаПроизводства.Характеристика), ";" + СтрокаПроизводства.Характеристика.НаименованиеПолное, "");
				ТекБлюдо = СтрокаПроизводства.Номенклатура;
				ТекХарактеристикаБлюда = СтрокаПроизводства.Характеристика;
				
				// Определим, есть ли вхождение блюда в производственную таблицу с другой рецептурой.
				КоличествоРецептур = КоличествоРецептурПриготовленияБлюда(ТаблицаПроизводства, СтрокаПроизводства.Номенклатура, СтрокаПроизводства.Характеристика);
				
				Если КоличествоРецептур=1 Тогда
					ОбластьБлюдо.Параметры.ЕдиницаИзмерения = СтрокаПроизводства.ЕдиницаИзмеренияНоменклатуры;
					ОбластьБлюдо.Параметры.Количество = Формат(СтрокаПроизводства.КоличествоУпаковокНоменклатуры, ФорматВыводаКоличества);
					ОбластьБлюдо.Параметры.РецептураБлюда = СтрокаПроизводства.Рецептура;
				Иначе
					ОбластьБлюдо.Параметры.ЕдиницаИзмерения = "";
					ОбластьБлюдо.Параметры.Количество = "";
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(ОбластьБлюдо);
			КонецЕсли;
			
			Если (Реж = "ПоБлюдам" ИЛИ Реж = "ПоБлюдамСПолуфабрикатами") И (ТекРецептура <> СтрокаПроизводства.Рецептура) И КоличествоРецептур > 1 Тогда
				ОбластьРецептура.Параметры.Рецептура = СтрокаПроизводства.Рецептура;
				ОбластьРецептура.Параметры.ЕдиницаИзмерения = СтрокаПроизводства.ЕдиницаИзмеренияНоменклатуры;
				ОбластьРецептура.Параметры.Количество = СтрокаПроизводства.КоличествоУпаковокНоменклатуры;
				ОбластьРецептура.Параметры.РецептураБлюда = СтрокаПроизводства.Рецептура;
				ТекРецептура = СтрокаПроизводства.Рецептура;
				ТабличныйДокумент.Вывести(ОбластьРецептура);
			КонецЕсли;
			
			ОбластьТовар.Параметры.Заполнить(СтрокаПроизводства);
			ОбластьТовар.Параметры.Ингредиент			= СтрокаПроизводства.Ингредиент.НаименованиеПолное + ?(ЗначениеЗаполнено(СтрокаПроизводства.ХарактеристикаИнгредиента), ";" + СтрокаПроизводства.ХарактеристикаИнгредиента.НаименованиеПолное, "");
			ОбластьТовар.Параметры.Номер				= Ном;
			ОбластьТовар.Параметры.КодНоменклатуры		= ?(ПечататьАртикул, СтрокаПроизводства.Ингредиент.Артикул, СтрокаПроизводства.Ингредиент.Код);
			ОбластьТовар.Параметры.ЕдиницаИзмерения		= СтрокаПроизводства.ЕдиницаИзмеренияИнгредиента.Наименование;
			ОбластьТовар.Параметры.КоличествоИнгредиентаНорма	= Формат(СтрокаПроизводства.КоличествоУпаковокИнгредиентаНорма,ФорматВыводаКоличества);
			
			Если ЭтоПланМеню Тогда
				
				// Норма-Факт
				ОбластьТовар.Параметры.КоличествоИнгредиентаИсходное = Формат(СтрокаПроизводства.КоличествоУпаковокИнгредиентаИсходное,ФорматВыводаКоличества);;
				
			Иначе
				
				// Норма-Факт
				ОбластьТовар.Параметры.КоличествоСУчетомОстатка = Формат(СтрокаПроизводства.КоличествоУпаковокИнгредиентаНорма - СтрокаПроизводства.КоличествоУпаковокИнгредиентаФакт, ФорматВыводаКоличества);
				
				// Норма-Факт-Замена
				Отбор = Новый Структура;
				Отбор.Вставить("ИнгредиентИсходный",СтрокаПроизводства.Ингредиент);
				Отбор.Вставить("ХарактеристикаИнгредиентаИсходного",СтрокаПроизводства.Характеристика);
				Отбор.Вставить("УпаковкаИнгредиентаИсходный",СтрокаПроизводства.ЕдиницаИзмеренияИнгредиента);
				Если Реж = "ПоБлюдам" ИЛИ Реж = "ПоБлюдамСПолуфабрикатами" Тогда
					Отбор.Вставить("Блюдо",СтрокаПроизводства.Номенклатура);
					Отбор.Вставить("ХарактеристикаБлюда",СтрокаПроизводства.Характеристика);
					Отбор.Вставить("Рецептура",СтрокаПроизводства.Рецептура);
				КонецЕсли;
				
				СтрокаЗамен = ТаблицаЗамен.НайтиСтроки(Отбор);
				КоличествоЗамены = 0;
				Для Каждого ЭлементМассива Из СтрокаЗамен Цикл
					КоличествоЗамены = КоличествоЗамены + ЭлементМассива.КоличествоУпаковокИнгредиентаИсходный;
				КонецЦикла;
				
				ОбластьТовар.Параметры.КоличествоСУчетомОстаткаИЗамен = Формат(СтрокаПроизводства.КоличествоУпаковокИнгредиентаНорма - СтрокаПроизводства.КоличествоУпаковокИнгредиентаФакт - КоличествоЗамены, ФорматВыводаКоличества);
				
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьТовар);
			Ном = Ном + 1;
		КонецЦикла;
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, ДокументСсылка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьПотребностьВИнгредиентах

#КонецОбласти

