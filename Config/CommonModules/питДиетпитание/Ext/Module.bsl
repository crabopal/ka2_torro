				СтрокаКалорийностиПротокола.ТолькоДобавлена = Истина;
			Иначе
				Если ЗначениеЗаполнено(СтруктураКалорийности.Источник) Тогда
					// Нужно отсечь строки-потомки
					НайденныеСтроки = ТаблицаСостава.НайтиСтроки(Новый Структура("Родитель", ТаблицаСостава.Индекс(СтрокаКалорийностиПротокола)));
					Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						НайденнаяСтрока.Родитель = 0;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаКалорийностиПротокола.Формула = СтруктураКалорийности.Формула;
			СтрокаКалорийностиПротокола.Источник = СтруктураКалорийности.Источник;
			СтрокаКалорийностиПротокола.КоличествоИсходное = Калорийность;
			СтрокаКалорийностиПротокола.ПроцентПотерь = 0;
			СтрокаКалорийностиПротокола.КоличествоИтого = Калорийность;
			
		КонецЕсли;
		
		СтрокаКалорийности.КоличествоХарактеристики = Калорийность;
	КонецЕсли;
	
КонецПроцедуры

// Создает структуру таблицы состава
//
// Параметры:
//  ТаблицаСостава - ТаблицаЗначений - Таблица состава.
//
Процедура СоздатьТаблицуСостава(ТаблицаСостава)
	ТаблицаСостава.Очистить();
	ТаблицаСостава.Колонки.Очистить();
	
	ТаблицаСостава.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСостава.Колонки.Добавить("Рецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"));
	ТаблицаСостава.Колонки.Добавить("КоличествоНоменклатуры", Новый ОписаниеТипов("Число"));
	ТаблицаСостава.Колонки.Добавить("ЕдиницаИзмеренияНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТаблицаСостава.Колонки.Добавить("ХЭХ", Новый ОписаниеТипов("СправочникСсылка.питХимикоэнергетическиеХарактеристики"));
	ТаблицаСостава.Колонки.Добавить("ЕдиницаИзмеренияХЭХ", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТаблицаСостава.Колонки.Добавить("КоличествоИсходное", Новый ОписаниеТипов("Число"));
	ТаблицаСостава.Колонки.Добавить("ПроцентПотерь", Новый ОписаниеТипов("Число"));
	ТаблицаСостава.Колонки.Добавить("КоличествоИтого", Новый ОписаниеТипов("Число"));
	ТаблицаСостава.Колонки.Добавить("Формула", Новый ОписаниеТипов("Строка"));
	ТаблицаСостава.Колонки.Добавить("Источник");
	ТаблицаСостава.Колонки.Добавить("Родитель", Новый ОписаниеТипов("Число"));
	ТаблицаСостава.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Число"));
	ТаблицаСостава.Колонки.Добавить("НомерВетки", Новый ОписаниеТипов("Число"));
	ТаблицаСостава.Колонки.Добавить("ТолькоДобавлена", Новый ОписаниеТипов("Булево"));
КонецПроцедуры


