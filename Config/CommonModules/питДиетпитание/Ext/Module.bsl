					НайденнаяСтрока.ТолькоДобавлена = Ложь;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		Запрос = Новый Запрос();
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.ХимикоэнергетическаяХарактеристика,
		|	МАКСИМУМ(ВложенныйЗапрос.КоличествоХарактеристики) КАК КоличествоХарактеристики,
		|	ВложенныйЗапрос.Вычислено,
		|	МАКСИМУМ(ВложенныйЗапрос.КоличествоХарактеристикиВыч) КАК КоличествоХарактеристикиВыч
		|ИЗ
		|	(ВЫБРАТЬ
		|		ХимикоэнергетическиеХарактеристики.ХимикоэнергетическаяХарактеристика КАК ХимикоэнергетическаяХарактеристика,
		|		ВЫБОР
		|			КОГДА &НоменклатураКоличествоНоменклатуры * &НоменклатураКоэффициент = 0
		|				ТОГДА 0
		|			ИНАЧЕ &НеобходимоеКоличество * ХимикоэнергетическиеХарактеристики.КоличествоХарактеристики / (ВЫБОР
		|					КОГДА &НоменклатураКоличествоНоменклатуры = 0
		|						ТОГДА 1
		|					ИНАЧЕ &НоменклатураКоличествоНоменклатуры
		|				КОНЕЦ * ВЫБОР
		|					КОГДА &НоменклатураЕдиницаИзмеренияДляХЭХ = &ПустаяЕдиница
		|						ТОГДА 1
		|					ИНАЧЕ &НоменклатураКоэффициент
		|				КОНЕЦ)
		|		КОНЕЦ КАК КоличествоХарактеристики,
		|		ИСТИНА КАК Вычислено,
		|		-1000 КАК КоличествоХарактеристикиВыч
		|	ИЗ
