				СтрокаПротокола.КоличествоНоменклатуры = НеобходимоеКоличествоУпаковок;///***--- / ТекРецептураКоэффициент
				СтрокаПротокола.ЕдиницаИзмеренияНоменклатуры = ТекРецептура.Упаковка;
				СтрокаПротокола.ХЭХ = Справочники.питХимикоэнергетическиеХарактеристики.ПустаяСсылка();
				СтрокаПротокола.ЕдиницаИзмеренияХЭХ = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
				СтрокаПротокола.КоличествоИсходное = 0;
				СтрокаПротокола.ПроцентПотерь = 0;
				СтрокаПротокола.КоличествоИтого = 0;
				СтрокаПротокола.Формула = "";
				СтрокаПротокола.Источник = "";
				СтрокаПротокола.Родитель = 0;
				СтрокаПротокола.Уровень = БуферУровень;
				СтрокаПротокола.НомерВетки = БуферНомерВетки;
				СтрокаПротокола.ТолькоДобавлена = Истина;
				
				НомерСтроки = ТаблицаСостава.Количество() - 1;
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
