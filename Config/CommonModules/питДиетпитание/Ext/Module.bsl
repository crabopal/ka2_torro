		|			КОГДА &НоменклатураКоличествоНоменклатуры * &НоменклатураКоэффициент = 0
		|				ТОГДА 0
		|			ИНАЧЕ &НеобходимоеКоличество * ХимикоэнергетическиеХарактеристики.КоличествоХарактеристики / (ВЫБОР
		|					КОГДА &НоменклатураКоличествоНоменклатуры = 0
		|						ТОГДА 1
		|					ИНАЧЕ &НоменклатураКоличествоНоменклатуры
		|				КОНЕЦ * ВЫБОР
		|					КОГДА &НоменклатураЕдиницаИзмеренияДляХЭХ = &ПустаяЕдиница
		|						ТОГДА 1
		|					ИНАЧЕ &НоменклатураКоэффициент
		|				КОНЕЦ)
		|		КОНЕЦ,
		|		ИСТИНА,
		|		ВЫБОР
		|			КОГДА &НоменклатураКоличествоНоменклатуры * &НоменклатураКоэффициент = 0
		|				ТОГДА 0
		|			ИНАЧЕ &НеобходимоеКоличество * ХимикоэнергетическиеХарактеристики.КоличествоХарактеристики / (ВЫБОР
		|					КОГДА &НоменклатураКоличествоНоменклатуры = 0
		|						ТОГДА 1
		|					ИНАЧЕ &НоменклатураКоличествоНоменклатуры
		|				КОНЕЦ * ВЫБОР
		|					КОГДА &НоменклатураЕдиницаИзмеренияДляХЭХ = &ПустаяЕдиница
		|						ТОГДА 1
		|					ИНАЧЕ &НоменклатураКоэффициент
		|				КОНЕЦ)
		|		КОНЕЦ
		|	ИЗ
		|		РегистрСведений.питХимикоэнергетическиеХарактеристики КАК ХимикоэнергетическиеХарактеристики
		|	ГДЕ
		|		ХимикоэнергетическиеХарактеристики.Номенклатура = &Номенклатура
		|		И ХимикоэнергетическиеХарактеристики.Рецептура = &Рецептура) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.ХимикоэнергетическаяХарактеристика,
		|	ВложенныйЗапрос.Вычислено";
		
		Запрос.УстановитьПараметр("ПустаяЕдиница", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
		Запрос.УстановитьПараметр("Номенклатура",  Номенклатура);
		Запрос.УстановитьПараметр("НоменклатураКоличествоНоменклатуры", Номенклатура.питКоличествоНоменклатуры);
		
//   Запрос.УстановитьПараметр("НоменклатураКоэффициент", питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура,
// Номенклатура.питЕдиницаИзмеренияДляХЭХ));.
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура, Номенклатура.питЕдиницаИзмеренияДляХЭХ);
		Иначе
			ТекКоэффициент = 1;
		КонецЕсли;
		Запрос.УстановитьПараметр("НоменклатураКоэффициент", ТекКоэффициент);
		
		Запрос.УстановитьПараметр("НоменклатураЕдиницаИзмеренияДляХЭХ", Номенклатура.питЕдиницаИзмеренияДляХЭХ);
		Запрос.УстановитьПараметр("НеобходимоеКоличество", НеобходимоеКоличество);
		Запрос.УстановитьПараметр("ВсеРецептуры", Документы.питРецептура.ПустаяСсылка());
		Запрос.УстановитьПараметр("Рецептура", ?(РодительскаяРецептура = Неопределено, Документы.питРецептура.ПустаяСсылка(), РодительскаяРецептура.Ссылка));
		
		СтрокаКалорийностиПротокола = Неопределено;
		СтрокаКалорийности = Неопределено;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.КоличествоХарактеристики > 0 Тогда
				НоваяСтрока										= ТаблицаХЭХ.Добавить();
