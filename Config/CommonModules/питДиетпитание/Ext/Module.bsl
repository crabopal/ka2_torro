// ПРОЦЕДУРЫ И ФУНКЦИИ, СВЯЗАННЫЕ С ИСПОЛЬЗОВАНИЕМ ФОРМУЛЫ РАСЧЕТА КАЛОРИЙНОСТИ

// Возвращает позицию требуемого знака (символ) с конца формулы, исключая выражения в скобках.
//
// Параметры:
//  Формула - Произвольный - Формула.
//  Знак - Строка, искомый знак - символ.
//
// Возвращаемое значение:
// 	Число - позиция знака в формуле при просмотре с конца строки, исключая выражения в скобках.
Функция НайтиЗнакВнеСкобок(Формула, Знак)
	Вложенность = 0;
	ДлинаСтроки = СтрДлина(Формула);
	Для Счетчик = 1 По ДлинаСтроки Цикл
		Если Сред(Формула, ДлинаСтроки - Счетчик + 1, 1) = ")" Тогда
			Вложенность = Вложенность + 1;
		КонецЕсли;
		Если Сред(Формула, ДлинаСтроки - Счетчик + 1, 1) = "(" Тогда
			Вложенность = Вложенность - 1;
		КонецЕсли;
		Если Сред(Формула, ДлинаСтроки - Счетчик + 1, 1) = "]" Тогда
			Вложенность = Вложенность + 1;
		КонецЕсли;
		Если Сред(Формула, ДлинаСтроки - Счетчик + 1, 1) = "[" Тогда
			Вложенность = Вложенность - 1;
		КонецЕсли;
		Если (Сред(Формула, ДлинаСтроки - Счетчик + 1, 1) = Знак) И (Вложенность = 0) Тогда
			Возврат ДлинаСтроки - Счетчик + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

// Возвращает формулу, используемую системой 1С для вычисления посредством "Выполнить(...)" (в синтаксисе 1С).
//
// Параметры:
//  Формула - Произвольный - Формула.
//  Префикс - Произвольный - Префикс.
//
// Возвращаемое значение:
// 	Строка - преобразованная формула для расчета в системе 1С.
Функция ВставитьПрефиксВФормулуКалорийности(Формула, Префикс)
	ТекФормула = СокрЛП(Формула);
	Если (Лев(ТекФормула, 1) = "+") ИЛИ (Лев(ТекФормула, 1) = "-") Тогда
		Возврат ВставитьПрефиксВФормулуКалорийности("0" + ТекФормула, Префикс);
	КонецЕсли;
	// Разбиваем на части арифметическими операциями
	Знак = "/";
	Поз = НайтиЗнакВнеСкобок(ТекФормула, Знак);
	Если Поз = 0 Тогда
		Знак = "*";
		Поз = НайтиЗнакВнеСкобок(ТекФормула, Знак);
	КонецЕсли;
	Если Поз = 0 Тогда
		Знак = "+";
		Поз = НайтиЗнакВнеСкобок(ТекФормула, Знак);
	КонецЕсли;
	Если Поз = 0 Тогда
		Знак = "-";
		Поз = НайтиЗнакВнеСкобок(ТекФормула, Знак);
	КонецЕсли;
	// Производим префиксацию частей, связанных арифметическими операциями
	Если Поз > 0  Тогда
		Возврат ВставитьПрефиксВФормулуКалорийности(Сред(ТекФормула, 1, Поз - 1), Префикс) + Знак + ВставитьПрефиксВФормулуКалорийности(Сред(ТекФормула, Поз + 1, СтрДлина(ТекФормула) - Поз), Префикс);
	КонецЕсли;
	// Проверяем, записано ли выражение в скобках
	Если (Лев(ТекФормула, 1) = "(") И (Прав(ТекФормула, 1) = ")") Тогда
		Возврат "(" + ВставитьПрефиксВФормулуКалорийности(Сред(ТекФормула, 2, СтрДлина(ТекФормула) - 2), Префикс) + ")";
	КонецЕсли;
	// Проверяем, является ли переменная числом
	Попытка
		ВремПерем = Число(ТекФормула) - Число(СокрЛП(Число(ТекФормула)));
		ЭтоЧисло = (ВремПерем = 0);
	Исключение	
		ЭтоЧисло = Ложь;
	КонецПопытки;
	Если ЭтоЧисло Тогда
		Возврат СтрЗаменить(ТекФормула, ",", ".");
	КонецЕсли;
	// Остается только наименование ХЭХ: делаем префиксацию и вызов
	Возврат (Префикс + "[""" + Сред(ТекФормула, 2, СтрДлина(ТекФормула) - 2) + """]");
КонецФункции

// Возвращает формулу расчета калорийности из Рецептуры.
//
// Параметры:
//  Рецептура - ДокументСсылка.питРецептура или ДокументОбъект.питРецептура - Рецептура номенклатуры.
//  СпособРасчетаКалорийности - Перечисления.питСпособыРасчетаКалорийности - Способ расчета калорийности.
//  СтруктураКалорийности - Структура - Структура калорийности.
//
// Возвращаемое значение:
// 	Строка - Формула расчета калорийности
Функция ПолучитьФормулуВРецептуре(Рецептура, СпособРасчетаКалорийности = Неопределено, СтруктураКалорийности = Неопределено)
	ТекФормула = "";
	Если Рецептура <> Неопределено Тогда // Рецептура может быть объектом, поэтому не используется ЗначениеЗаполнено(..)
		ТекСпособ = ?(ЗначениеЗаполнено(СпособРасчетаКалорийности), СпособРасчетаКалорийности, Рецептура.СпособРасчетаКалорийности);
		Если СтруктураКалорийности <> Неопределено Тогда
			СтруктураКалорийности.СпособРасчета = ТекСпособ;
		КонецЕсли;
		Если ТекСпособ = Перечисления.питСпособыРасчетаКалорийности.Суммированием Тогда
			Если СтруктураКалорийности <> Неопределено Тогда
				СтруктураКалорийности.СпособРасчета = Перечисления.питСпособыРасчетаКалорийности.Суммированием;
			КонецЕсли;
			ТекФормула = "-"; // Условное обозначение способа "суммированием"
		ИначеЕсли ТекСпособ = Перечисления.питСпособыРасчетаКалорийности.ПоФормуле И ТекСпособ = Рецептура.СпособРасчетаКалорийности Тогда
			// Формулу используем, только если у нас расчет калорийности ведется по формуле.
			Если ЗначениеЗаполнено(Рецептура.ФормулаРасчетаКалорийности) Тогда
				ТекФормула = Рецептура.ФормулаРасчетаКалорийности;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураКалорийности <> Неопределено Тогда
		СтруктураКалорийности.Источник = Рецептура;
	КонецЕсли;
	
	Возврат ТекФормула;
КонецФункции

// Возвращает формулу расчета калорийности из Номенклатуры
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура или СправочникОбъект.Номенклатура - Номенклатура,
//   для которой рассчитываем калорийность.
//  СпособРасчетаКалорийности - Перечисления.питСпособыРасчетаКалорийности - Способ расчета калорийности.
//  СтруктураКалорийности - Структура - Структура калорийности.
//
// Возвращаемое значение:
// 	Строка - Формула расчета калорийности.
Функция ПолучитьФормулуВНоменклатуре(Номенклатура, СпособРасчетаКалорийности = Неопределено, СтруктураКалорийности = Неопределено)
	ТекФормула = "";
	Если Номенклатура <> Неопределено Тогда
		ТекСпособ = ?(ЗначениеЗаполнено(СпособРасчетаКалорийности), СпособРасчетаКалорийности, Номенклатура.питСпособРасчетаКалорийности);
		Если СтруктураКалорийности <> Неопределено Тогда
			СтруктураКалорийности.СпособРасчета = ТекСпособ;
		КонецЕсли;
		Если ТекСпособ = Перечисления.питСпособыРасчетаКалорийности.Суммированием Тогда
			Если СтруктураКалорийности <> Неопределено Тогда
				СтруктураКалорийности.СпособРасчета = Перечисления.питСпособыРасчетаКалорийности.Суммированием;
			КонецЕсли;
			ТекФормула = "-"; // Условное обозначение способа "суммированием"
		ИначеЕсли ТекСпособ = Перечисления.питСпособыРасчетаКалорийности.ПоФормуле И ТекСпособ = Номенклатура.питСпособРасчетаКалорийности Тогда
			// Формулу используем, только если у нас расчет калорийности ведется по формуле.
			Если ЗначениеЗаполнено(Номенклатура.питФормулаРасчетаКалорийности) Тогда
				ТекФормула = Номенклатура.питФормулаРасчетаКалорийности;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураКалорийности <> Неопределено Тогда
		СтруктураКалорийности.Источник = Номенклатура;
	КонецЕсли;
	
	Возврат ТекФормула;
КонецФункции

// Возвращает формулу расчета калорийности из Константы
//
// Параметры:
//  СпособРасчетаКалорийности - Перечисления.питСпособыРасчетаКалорийности - Способ расчета калорийности.
//  СтруктураКалорийности - Структура - Структура калорийности.
//
// Возвращаемое значение:
// 	Строка - Формула расчета калорийности.
Функция ПолучитьФормулуВКонстанте(СпособРасчетаКалорийности = Неопределено, СтруктураКалорийности = Неопределено)
	ТекФормула = "";
	ТекСпособ = ?(ЗначениеЗаполнено(СпособРасчетаКалорийности), СпособРасчетаКалорийности, Константы.питСпособРасчетаКалорийности.Получить());
	Если СтруктураКалорийности <> Неопределено Тогда
		СтруктураКалорийности.СпособРасчета = ТекСпособ;
	КонецЕсли;
	// Формулу используем, только если у нас расчет калорийности ведется по формуле.
	Если ТекСпособ = Перечисления.питСпособыРасчетаКалорийности.Суммированием Тогда
		Если СтруктураКалорийности <> Неопределено Тогда
			СтруктураКалорийности.СпособРасчета = ТекСпособ;
		КонецЕсли;
		ТекФормула = "-"; // Условное обозначение способа "суммированием".
	ИначеЕсли ТекСпособ = Перечисления.питСпособыРасчетаКалорийности.ПоФормуле И ТекСпособ = Константы.питСпособРасчетаКалорийности.Получить() Тогда
		ТекФормула = Константы.питФормулаРасчетаКалорийности.Получить();
		Если НЕ ЗначениеЗаполнено(ТекФормула) Тогда // На случай, если в константе только пробелы.
			Если СтруктураКалорийности <> Неопределено Тогда
				СтруктураКалорийности.СпособРасчета = Перечисления.питСпособыРасчетаКалорийности.Суммированием;
			КонецЕсли;
			ТекФормула = "";
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураКалорийности <> Неопределено Тогда
		СтруктураКалорийности.Источник = "Константа";
	КонецЕсли;
	
	Возврат ТекФормула;
КонецФункции

// Возвращает список лексем формулы калорийности
//
// Параметры:
//  Формула - Произвольный - Формула.
//
// Возвращаемое значение:
// 	Массив структур - массив лексем, заданных структурами с типом лексемы и индексом начала лексемы в формуле.
Функция ПолучитьСписокЛексем(Формула)
	ЕстьТочка = Ложь;
	НомерСимвола = 1;
	ТекущаяЛексема = "Неопределено";
	НачалоЛексемы = 1;
	// Список лексем - массив структур с типом лексем и индексом символа начала лексемы в формуле.
	СписокЛексем = Новый Массив();
	Пока НомерСимвола <= СтрДлина(Формула) Цикл
		ТекСимвол = Сред(Формула, НомерСимвола, 1);
		Если ТекущаяЛексема = "Неопределено" Тогда
			// Игнорируем пробелы и табуляции
			Если ПустаяСтрока(ТекСимвол) Тогда
				НомерСимвола = НомерСимвола + 1;
				Продолжить;
			КонецЕсли;
			// Проверим, что за лексема начинается с этого символа (либо сам символ и есть лексема).
			Если Найти("0123456789", ТекСимвол) > 0 Тогда
				// Начинается число
				ТекущаяЛексема = "Число";
				НачалоЛексемы = НомерСимвола;
				ЕстьТочка = Ложь;
				
			ИначеЕсли ТекСимвол = "[" Тогда
				// Начинается ХЭХ
				ТекущаяЛексема = "ХЭХ";
				НачалоЛексемы = НомерСимвола;
				
			ИначеЕсли ТекСимвол = "(" Тогда
				// Открывающая скобка
				СтруктураЛексемы = Новый Структура();
				СтруктураЛексемы.Вставить("Тип", "(");
				СтруктураЛексемы.Вставить("Начало", НомерСимвола);
				СписокЛексем.Добавить(СтруктураЛексемы);
				
				
			ИначеЕсли ТекСимвол = ")" Тогда
				// Закрывающая скобка
				СтруктураЛексемы = Новый Структура();
				СтруктураЛексемы.Вставить("Тип", ")");
				СтруктураЛексемы.Вставить("Начало", НомерСимвола);
				СписокЛексем.Добавить(СтруктураЛексемы);
				
			ИначеЕсли Найти("+-*/", ТекСимвол) > 0 Тогда
				// Знак операции
				СтруктураЛексемы = Новый Структура();
				СтруктураЛексемы.Вставить("Тип", ТекСимвол);
				СтруктураЛексемы.Вставить("Начало", НомерСимвола);
				СписокЛексем.Добавить(СтруктураЛексемы);
				
			Иначе
				// Обработка других символов
				СтруктураЛексемы = Новый Структура();
				СтруктураЛексемы.Вставить("Тип", ТекущаяЛексема); // Здесь ТекущаяЛексема = "Неопределено"
				СтруктураЛексемы.Вставить("Начало", НомерСимвола);
				СписокЛексем.Добавить(СтруктураЛексемы);
				
			КонецЕсли;
			НомерСимвола = НомерСимвола + 1;
			
		Иначе
			Если ТекущаяЛексема = "Число" Тогда
				Если Найти("0123456789", ТекСимвол) > 0 Тогда
					// Цифра
					НомерСимвола = НомерСимвола + 1;
					
				ИначеЕсли (Найти(".,", ТекСимвол) > 0) И (НЕ ЕстьТочка) Тогда 
					// Десятичный разделитель
					ЕстьТочка = Истина;
					НомерСимвола = НомерСимвола + 1;
					
				Иначе
					// Число закончилось, приращение символа не делаем - это уже другая лексема.
					СтруктураЛексемы = Новый Структура();
					СтруктураЛексемы.Вставить("Тип", ТекущаяЛексема); // Здесь ТекущаяЛексема = "Число"
					СтруктураЛексемы.Вставить("Начало", НачалоЛексемы);
					СписокЛексем.Добавить(СтруктураЛексемы);
					ТекущаяЛексема = "Неопределено"; // Сбрасываем тип лексемы
					
				КонецЕсли;
				
			ИначеЕсли ТекущаяЛексема = "ХЭХ" Тогда
				// Проверка, закончилась ли лексема "ХЭХ"
				Если ТекСимвол = "]" Тогда
					СтруктураЛексемы = Новый Структура();
					СтруктураЛексемы.Вставить("Тип", ТекущаяЛексема); // Здесь ТекущаяЛексема = "ХЭХ"
					СтруктураЛексемы.Вставить("Начало", НачалоЛексемы);
					СписокЛексем.Добавить(СтруктураЛексемы);
					ТекущаяЛексема = "Неопределено"; // Сбрасываем тип лексемы
				КонецЕсли;
				НомерСимвола = НомерСимвола + 1;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	// Если число было последним - вносим его
	Если ТекущаяЛексема = "Число" Тогда
		СтруктураЛексемы = Новый Структура();
		СтруктураЛексемы.Вставить("Тип", ТекущаяЛексема); // Здесь ТекущаяЛексема = "Число".
		СтруктураЛексемы.Вставить("Начало", НачалоЛексемы);
		СписокЛексем.Добавить(СтруктураЛексемы);
		
	ИначеЕсли ТекущаяЛексема <> "Неопределено" Тогда // Делаем общую проверку.
		// А это - ошибка
		СтруктураЛексемы = Новый Структура();
		СтруктураЛексемы.Вставить("Тип", "Неопределено"); // Поставим "Неопределено", чтобы обратить внимание.
		СтруктураЛексемы.Вставить("Начало", НачалоЛексемы);
		СписокЛексем.Добавить(СтруктураЛексемы);
		
	КонецЕсли;
	
	Возврат СписокЛексем;
КонецФункции

// Выполняет проверку правила грамматики <Формула>
//  при анализе синтаксической корректности формулы расчета калорийности.
//
// Параметры:
//  СписокЛексем - СписокЗначений - Список лексем.
//  НомерЛексемы - Произвольный - Номер лексемы.
//  НомерОшибочногоСимвола - Произвольный - Номер ошибочного символа.
//  СообщениеОбОшибке - Произвольный - Сообщение об ошибке.
//
// Возвращаемое значение:
// 	Булево - результат проверки правила грамматики
Функция ГрамматикаФормула(СписокЛексем, НомерЛексемы, НомерОшибочногоСимвола, СообщениеОбОшибке)
	// Проверяется корректность правила
	// <Формула> ::= "(" <Формула> ")" | <Терм> <Остаток>   {"(", "Число", "ХЭХ"}
	Если НомерОшибочногоСимвола <> 0 Тогда
		// Возврат при ошибке
		Возврат Ложь;
	КонецЕсли;
	Если НомерЛексемы >= СписокЛексем.Количество() Тогда
		НомерОшибочногоСимвола = -1; // Условное обозначение для выхода за пределы формулы
		СообщениеОбОшибке = "Ожидается число, ХЭХ или выражение в скобках";
		Возврат Ложь;
	КонецЕсли;
	
	// Проверка, какая ветка правила сработала (по лексеме из фигурных скобок)
	Если СписокЛексем[НомерЛексемы].Тип = "(" Тогда
		// Ветка <Формула> ::= "(" <Формула> ")"
		// Скобку уже проверили, проверяем формулу
		НомерЛексемы = НомерЛексемы + 1;
		Результат = ГрамматикаФормула(СписокЛексем, НомерЛексемы, НомерОшибочногоСимвола, СообщениеОбОшибке);
		Если Не Результат Тогда
			// Формула после скобки некорректна - возврат из функции
			Возврат Ложь;
		КонецЕсли;
		// Теперь осталось проверить, стоит ли закрывающая скобка
		Если НомерЛексемы >= СписокЛексем.Количество() Тогда
			НомерОшибочногоСимвола = -1; // Условное обозначение для выхода за пределы формулы.
			СообщениеОбОшибке = "Отсутствует закрывающая скобка";
			Возврат Ложь;
		КонецЕсли;
		// Проверяем скобку
		Если СписокЛексем[НомерЛексемы].Тип = ")" Тогда
			НомерЛексемы = НомерЛексемы + 1;
			Возврат Истина;
		Иначе
			// Ошибка - по правилу тут жестко должна скобка закрываться!
			НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
			СообщениеОбОшибке = "Отсутствует закрывающая скобка";
			Возврат Ложь;
		КонецЕсли;	
		
	ИначеЕсли (СписокЛексем[НомерЛексемы].Тип = "Число") ИЛИ (СписокЛексем[НомерЛексемы].Тип = "ХЭХ") Тогда
		// Ветка <Формула> ::= <Терм> <Остаток>
		// Терм уже проверили, проверяем остаток
		НомерЛексемы = НомерЛексемы + 1;
		Возврат ГрамматикаОстаток(СписокЛексем, НомерЛексемы, НомерОшибочногоСимвола, СообщениеОбОшибке);
		
	ИначеЕсли СписокЛексем[НомерЛексемы].Тип = ")" Тогда
		// Ошибочная закрывающая скобка
		НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
		СообщениеОбОшибке = "Ожидается число, ХЭХ или выражение в скобках";
		Возврат Ложь;
		
	ИначеЕсли Найти("+-*/", СписокЛексем[НомерЛексемы].Тип) > 0 Тогда
		// Ошибочный знак операции
		НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
		СообщениеОбОшибке = "Ожидается число, ХЭХ или выражение в скобках";
		Возврат Ложь;
		
	ИначеЕсли СписокЛексем[НомерЛексемы].Тип = "Неопределено" Тогда
		НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
		СообщениеОбОшибке = "Недопустимый элемент выражения";
		Возврат Ложь;
		
	КонецЕсли;
	
	// Дополнительная проверка
	НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
	СообщениеОбОшибке = "Синтаксическая ошибка"; // Не будем диагностировать, просто засвидетельствуем.
	Возврат Ложь;
КонецФункции	

// Выполняет проверку правила грамматики <Остаток>
//  при анализе синтаксической корректности формулы расчета калорийности.
//
// Параметры:
//  СписокЛексем - СписокЗначений - Список лексем.
//  НомерЛексемы - Произвольный - Номер лексемы.
//  НомерОшибочногоСимвола - Произвольный - Номер ошибочного символа.
//  СообщениеОбОшибке - Произвольный - Сообщение об ошибке.
//
// Возвращаемое значение:
// 	Булево - результат проверки правила грамматики.
Функция ГрамматикаОстаток(СписокЛексем, НомерЛексемы, НомерОшибочногоСимвола, СообщениеОбОшибке)
	// Проверяется корректность правила
	// <Остаток> ::= <Знак> <Формула> | Е                   {"+", "-", "*", "/", Е}.
	Если НомерОшибочногоСимвола <> 0 Тогда
		// Ошибка уже возникла - незачем дальше проверять
		Возврат Ложь;
	КонецЕсли;
	Если НомерЛексемы >= СписокЛексем.Количество() Тогда
		// Действует ветка правила <Остаток> ::= Е (т.е. пусто)
		Возврат Истина;
	КонецЕсли;
	
	// Теперь проверяем, что за ветка правила сработала
	Если Найти("+-*/", СписокЛексем[НомерЛексемы].Тип) > 0 Тогда
		// Ветка <Остаток> ::= <Знак> <Формула>
		// Знак уже проверили, проверяем формулу
		НомерЛексемы = НомерЛексемы + 1;
		Возврат ГрамматикаФормула(СписокЛексем, НомерЛексемы, НомерОшибочногоСимвола, СообщениеОбОшибке);
		
	ИначеЕсли (СписокЛексем[НомерЛексемы].Тип = "Число") ИЛИ (СписокЛексем[НомерЛексемы].Тип = "ХЭХ") Тогда
		// Вместо знака идет число или ХЭХ: знак пропустили
		НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
		СообщениеОбОшибке = "Пропущен знак операции";
		Возврат Ложь;
		
	ИначеЕсли СписокЛексем[НомерЛексемы].Тип = ")" Тогда
		// Ветка <Остаток> ::= Е
		// Не увеличиваем номер лексемы - она не из этого правила
		Возврат Истина;
		
	ИначеЕсли СписокЛексем[НомерЛексемы].Тип = "(" Тогда
		// Вместо знака идет открывающая скобка: знак пропустили
		НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
		СообщениеОбОшибке = "Пропущен знак операции";
		Возврат Ложь;
		
	ИначеЕсли СписокЛексем[НомерЛексемы].Тип = "Неопределено" Тогда
		// Обработка неизвестных ситуаций
		НомерОшибочногоСимвола = СписокЛексем[НомерЛексемы].Начало;
		СообщениеОбОшибке = "Недопустимый элемент выражения";
		Возврат Ложь;
		
	КонецЕсли;
	
	// Срабатывает ветка <Остаток> ::= Е
	Возврат Истина;
	
КонецФункции

// Процедура - Вкус запах консистенция.
//
// Параметры:
//  ОбластьМакета - Произвольный - Область макета.
//  Рецептура - Произвольный - Рецептура.
//  ПоГосту - Произвольный - По госту.
//
Процедура ВкусЗапахКонсистенция(ОбластьМакета, Рецептура, ПоГосту)
	
	ОбластьМакета.Параметры.ВнешнийВид            = СокрЛП(Рецептура.ВнешнийВид);
	ОбластьМакета.Параметры.Цвет                  = СокрЛП(Рецептура.Цвет);
	Если НЕ ПоГосту Тогда // не выводится в макете по ГОСТу.
		ОбластьМакета.Параметры.Консистенция          = СокрЛП(Рецептура.Консистенция);
	КонецЕсли;
	ОбластьМакета.Параметры.ВкусИЗапах            = СокрЛП(Рецептура.ВкусИЗапах);
	
	
КонецПроцедуры

#КонецОбласти


