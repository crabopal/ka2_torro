#Область ПрограммныйИнтерфейс

//  Процедура - Удалить единицы измерения.
//
// Параметры:
//  ТоварыПоЕдиницамИзмерения - Произвольный - Товары по единицам измерения.
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
Процедура УдалитьЕдиницыИзмерения(ТоварыПоЕдиницамИзмерения, ИдентификаторСтроки) Экспорт
	СтруктураОтбора = Новый Структура("ИдентификаторРодителя", ИдентификаторСтроки);
	НайденныеСтроки = ТоварыПоЕдиницамИзмерения.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		ТоварыПоЕдиницамИзмерения.Удалить(ТекСтрока);
	КонецЦикла;
КонецПроцедуры

//  Процедура - Скопировать единицы измерения.
//
// Параметры:
//  ТоварыПоЕдиницамИзмерения - Произвольный - Товары по единицам измерения.
//  ИдентификаторИсточника - Произвольный - Идентификатор источника.
//  ИдентификаторПриемника - Произвольный - Идентификатор приемника.
//
Процедура СкопироватьЕдиницыИзмерения(ТоварыПоЕдиницамИзмерения, ИдентификаторИсточника, ИдентификаторПриемника) Экспорт
	СтруктураОтбора = Новый Структура("ИдентификаторРодителя", ИдентификаторИсточника);
	НайденныеСтроки = ТоварыПоЕдиницамИзмерения.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		НовСтрока = ТоварыПоЕдиницамИзмерения.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
		НовСтрока.ИдентификаторРодителя = ИдентификаторПриемника;
		НовСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЦикла;
КонецПроцедуры

//  Процедура - Заполнить строку.
//
// Параметры:
//  Таблица - ТаблицаЗначений - Таблица.
//  СтруктураОтбора - Структура - Структура отбора.
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  ВводТарныхЕдиниц - Произвольный - Ввод тарных единиц.
//
Процедура ЗаполнитьСтроку(Таблица, СтруктураОтбора, ДанныеЗаполнения, ВводТарныхЕдиниц = Ложь) Экспорт

	НайденныеСтроки = Таблица.НайтиСтроки(СтруктураОтбора);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		ТекСтрока = НайденныеСтроки[0];
		ЗаполнитьЗначенияСвойств(ТекСтрока, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Распределить количество по единицам измерения.
//
// Параметры:
//  ТоварыПоЕдиницамИзмерения - Произвольный - Товары по единицам измерения.
//  СтрокаЗапасов - Строка - Строка запасов.
//  ПересчитыватьФактВСтрокеЗапасов - Произвольный - Пересчитывать факт в строке запасов.
//  СообщениеОбИзмененииФакта - Строка - Сообщение об изменении факта.
//
Процедура РаспределитьКоличествоПоЕдиницамИзмерения(ТоварыПоЕдиницамИзмерения, СтрокаЗапасов, ПересчитыватьФактВСтрокеЗапасов = Ложь, СообщениеОбИзмененииФакта = "") Экспорт
	
	ТекКэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	СтруктураОтбора = Новый Структура("ИдентификаторРодителя", СтрокаЗапасов.ИдентификаторСтроки);
	СтруктураОтбора.Вставить("ИзПолуфабриката", Ложь);
	
	НайденныеСтроки = ТоварыПоЕдиницамИзмерения.НайтиСтроки(СтруктураОтбора);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		КоличествоПоЕдиницамИзмерения = 0;
		
		СтрокаСЕдИзЗапасов = Неопределено;
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			КоличествоИзВеса = 0;
			КоличествоИзВеса = ?(Строка.ПлотностьНапитка = 0 ИЛИ Строка.КоличествоВзвешенныхЕдиниц = 0, 0, (Строка.Вес - Строка.КоличествоВзвешенныхЕдиниц * Строка.ВесТары) / Строка.ПлотностьНапитка);
			КоличествоИзВеса = ?(КоличествоИзВеса < 0, 0, КоличествоИзВеса);
			
			КоличествоПоЕдиницамИзмерения = КоличествоПоЕдиницамИзмерения + (Строка.Количество + КоличествоИзВеса) * Строка.Коэффициент;
			
			Если Строка.ЕдиницаИзмерения = СтрокаЗапасов.Упаковка
				ИЛИ (НЕ ЗначениеЗаполнено(СтрокаЗапасов.Упаковка) И Строка.ЭтоБазовая) Тогда
				СтрокаСЕдИзЗапасов = Строка;
			КонецЕсли;
		КонецЦикла;	
		
		Если СтрокаСЕдИзЗапасов = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Коэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаЗапасов.Номенклатура, СтрокаЗапасов.Упаковка);
		КоличествоПоЕдиницамИзмерения = КоличествоПоЕдиницамИзмерения / ?(Коэффициент = 0, 1, Коэффициент);
		
		РазностьКоличеств = СтрокаЗапасов.КоличествоУпаковокФактБезПФ - КоличествоПоЕдиницамИзмерения;
		
		Если РазностьКоличеств*-1 > СтрокаСЕдИзЗапасов.Количество Тогда
			СписатьКоличество = СтрокаСЕдИзЗапасов.Количество;
			СтрокаСЕдИзЗапасов.Количество = 0;
			
			СтрокаЗапасов.КоличествоУпаковокФактБезПФ	= СтрокаЗапасов.КоличествоУпаковокФактБезПФ - РазностьКоличеств - СписатьКоличество;
			СтрокаЗапасов.КоличествоУпаковокФакт		= СтрокаЗапасов.КоличествоУпаковокФактБезПФ + СтрокаЗапасов.КоличествоУпаковокИзПолуфабрикатов;
			СтрокаЗапасов.Расхождение = (СтрокаЗапасов.КоличествоФакт <> СтрокаЗапасов.Количество) Или (СтрокаЗапасов.КоличествоУпаковок <> СтрокаЗапасов.КоличествоУпаковокФакт);
			СтрокаЗапасов.КоличествоУпаковокОтклонение	= СтрокаЗапасов.КоличествоУпаковокФакт - СтрокаЗапасов.КоличествоУпаковок;
			
			СообщениеОбИзмененииФакта = "Количество в текущей строке товаров не может быть уменьшено более чем на <"+СписатьКоличество+"> по единице измерения <"+СтрокаЗапасов.Упаковка+">. 
			| Оставшееся количество корректируется в панели ввода количеств по единицам измерения!";
			ПересчитыватьФактВСтрокеЗапасов = Истина;
			
		Иначе
			СтрокаСЕдИзЗапасов.Количество = СтрокаСЕдИзЗапасов.Количество + РазностьКоличеств;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Выполнить пересчет строки основной таблицы по таблице единиц измерения.
//
// Параметры:
//  ТоварыПоЕдиницамИзмерения - Произвольный - Товары по единицам измерения.
//  СтрокаЗапасов - Строка - Строка запасов.
//
Процедура ВыполнитьПересчетСтрокиОсновнойТаблицыПоТаблицеЕдиницИзмерения(ТоварыПоЕдиницамИзмерения, СтрокаЗапасов) Экспорт
	СтруктураОтбора = Новый Структура("ИдентификаторРодителя, ИзПолуфабриката", СтрокаЗапасов.ИдентификаторСтроки, Ложь);
	
	НайденныеСтроки = ТоварыПоЕдиницамИзмерения.НайтиСтроки(СтруктураОтбора);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		КоличествоПоЕдиницамИзмерения = 0;
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			КоличествоИзВеса = 0;
			КоличествоИзВеса = ?(Строка.ПлотностьНапитка = 0 ИЛИ Строка.КоличествоВзвешенныхЕдиниц = 0, 0, (Строка.Вес - Строка.КоличествоВзвешенныхЕдиниц * Строка.ВесТары) / Строка.ПлотностьНапитка);
			КоличествоИзВеса = ?(КоличествоИзВеса < 0, 0, КоличествоИзВеса);
			
			КоличествоПоЕдиницамИзмерения = КоличествоПоЕдиницамИзмерения + (Строка.Количество + КоличествоИзВеса) * Строка.Коэффициент;
		КонецЦикла;	
		
		Коэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаЗапасов.Номенклатура, СтрокаЗапасов.Упаковка);
		КоличествоПоЕдиницамИзмеренияВЕдиницеЗапасов = КоличествоПоЕдиницамИзмерения / ?(Коэффициент = 0, 1, Коэффициент);
		
		СтрокаЗапасов.КоличествоФактБезПФ			= КоличествоПоЕдиницамИзмерения;
		СтрокаЗапасов.КоличествоУпаковокФактБезПФ	= КоличествоПоЕдиницамИзмеренияВЕдиницеЗапасов;
		
	Иначе
		СтрокаЗапасов.КоличествоФактБезПФ = 0;
		СтрокаЗапасов.КоличествоУпаковокФактБезПФ = 0;
	КонецЕсли;
	
	СтруктураОтбора.ИзПолуфабриката = Истина;
	
	НайденныеСтроки = ТоварыПоЕдиницамИзмерения.НайтиСтроки(СтруктураОтбора);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		КоличествоПоЕдиницамИзмерения = 0;
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			КоличествоИзВеса = 0;
			КоличествоИзВеса = ?(Строка.ПлотностьНапитка = 0 ИЛИ Строка.КоличествоВзвешенныхЕдиниц = 0, 0, (Строка.Вес - Строка.КоличествоВзвешенныхЕдиниц * Строка.ВесТары) / Строка.ПлотностьНапитка);
			КоличествоИзВеса = ?(КоличествоИзВеса < 0, 0, КоличествоИзВеса);
			
			КоличествоПоЕдиницамИзмерения = КоличествоПоЕдиницамИзмерения + (Строка.Количество + КоличествоИзВеса) * Строка.Коэффициент;
		КонецЦикла;	
		
		Коэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаЗапасов.Номенклатура, СтрокаЗапасов.Упаковка);
		КоличествоПоЕдиницамИзмеренияВЕдиницеЗапасов = КоличествоПоЕдиницамИзмерения / ?(Коэффициент = 0, 1, Коэффициент);
		
		СтрокаЗапасов.КоличествоИзПолуфабрикатов = КоличествоПоЕдиницамИзмерения;
		СтрокаЗапасов.КоличествоУпаковокИзПолуфабрикатов = КоличествоПоЕдиницамИзмеренияВЕдиницеЗапасов;
	Иначе
		СтрокаЗапасов.КоличествоИзПолуфабрикатов = 0;
		СтрокаЗапасов.КоличествоУпаковокИзПолуфабрикатов = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


