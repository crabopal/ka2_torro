
#Область ПрограммныйИнтерфейс

// Процедура вызывается перед записью документа "Инвентаризация запасов".
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если (РежимЗаписи = РежимЗаписиДокумента.Запись
		ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
		// Корректировка нужна, если документ проводим. Иначе нет смысла пересчитывать, данные все равно будут не актуальными.
		// Корректировка книжного количества, если мы записываем документ задним числом
		Если ЭтотОбъект.РежимКорректировкиКоличества <> Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.НеКорректироватьКнижноеКоличество Тогда	
			// Корректировка производится в обработчике ПередЗаписью(), так как она влиет на состав табличной части товары
			// и изменения должны быть записаны перед тем, как по данному документу будут заполнятся товары
			// документов Оприходования и Списания.
			КорректироватьКнижноеКоличество(ЭтотОбъект);
		КонецЕсли;
		
		// Заменим режим корректировки количества для того, чтобы при дальнейших регламентных проведениях
		// всегда гарантировано получать один и тот же результат
		ЭтотОбъект.РежимКорректировкиКоличества	= Константы.питРежимКорректировкиКоличестваВИнвентаризации.Получить();
		
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Вставить("питРежимЗаписи",РежимЗаписи);
	
КонецПроцедуры

// Корректировка книжного количества
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  РежимКорректировки - ПеречислениеСсылка.питРежимКорректировкиКоличестваВИнвентаризации - Режим корректировки.
//  НастройкиОтборов - Произвольный - Настройки отборов.
//
Процедура КорректироватьКнижноеКоличество(ЭтотОбъект, РежимКорректировки = Неопределено, НастройкиОтборов = Неопределено) Экспорт
	
	Если РежимКорректировки = Неопределено Тогда
		РежимКорректировки = ЭтотОбъект.РежимКорректировкиКоличества;
	КонецЕсли;
	
	Если РежимКорректировки <> Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.НеКорректироватьКнижноеКоличество Тогда
		
		ТекКэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		
		СтруктураОтборПерезаполнения = Новый Структура("Склад,Дата",ЭтотОбъект.Склад,ЭтотОбъект.Дата);
		
		// Если режим отличный от "Не корректировать", то необходимо пересчитать книжное количество в ТЧ "Товары".
		СтрокиЗаполнитьЕдиницы = питИнвентаризация.ПерезаполнитьУчетныеДанныеСтрок(ЭтотОбъект.Товары, СтруктураОтборПерезаполнения, РежимКорректировки);
		
		// Заполнение ТЧ "ТоварыПоЕдиницамИзмерения" по добавленным при пересчете учетных данных строкам.
		питИнвентаризацияВызовСервера.ЗаполнитьТоварыПоЕдиницамИзмерения(ЭтотОбъект, СтрокиЗаполнитьЕдиницы);
		Для каждого ТекСтрокаЗаполнить Из СтрокиЗаполнитьЕдиницы Цикл
			питИнвентаризацияКлиентСервер.РаспределитьКоличествоПоЕдиницамИзмерения(ЭтотОбъект.ТоварыПоЕдиницамИзмерения, ТекСтрокаЗаполнить);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Функция перезаполняет учетные данные переданных строк ТЧ "Товары" в соответствии с режимом корректировки.
//
// Параметры:
//  СтрокиПерезаполнить - ТаблицаЗначений, Массив - Строки, которые будем перезаполнять.
//  СтруктураОтборПерезаполнения - Структура - Склад и Дата для отборов в запросе к остаткам.
//  РежимКорректировки - ПеречислениеСсылка.питРежимКорректировкиКоличестваВИнвентаризации - Режим корректировки.
//
// Возвращаемое значение:
//  Массив - Добавленные в результате пересчета строки.
Функция ПерезаполнитьУчетныеДанныеСтрок(СтрокиПерезаполнить, СтруктураОтборПерезаполнения, РежимКорректировки) Экспорт
	
	ИспользоватьОбособленноеОбеспечениеЗаказов	= ПолучитьФункциональнуюОпцию("ИспользоватьОбособленноеОбеспечениеЗаказов");
	ИспользоватьХарактеристикиНоменклатуры		= ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ИспользоватьСерииНоменклатурыСклад			= ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатуры") И ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатурыСклад");
	
	ТекКэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	// Результирующий массив.
	СтрокиЗаполнитьЕдиницы = Новый Массив;
	
	// Если режим = Не корректировать, то ничего не делаем.
	Если РежимКорректировки = Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.НеКорректироватьКнижноеКоличество Тогда
		Возврат СтрокиЗаполнитьЕдиницы;
	КонецЕсли;
	
	// Определяем списки для отборов СКД.
	СписокНоменклатуры	= Новый СписокЗначений;
	СписокХарактеристик	= Новый СписокЗначений;
	СписокСерий			= Новый СписокЗначений;
	СписокНазначений	= Новый СписокЗначений;
	Для каждого ТекСтрокаОтборПерезаполнения Из СтрокиПерезаполнить Цикл
		СписокНоменклатуры.Добавить(ТекСтрокаОтборПерезаполнения.Номенклатура);
		СписокХарактеристик.Добавить(ТекСтрокаОтборПерезаполнения.Характеристика);
		СписокСерий.Добавить(ТекСтрокаОтборПерезаполнения.Серия);
		СписокНазначений.Добавить(ТекСтрокаОтборПерезаполнения.Назначение);
	КонецЦикла;
	
	// Инициализация настроек
	НастройкиОтбораСКД = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	// Используем типовой макет "ОтборПересчетаПоСкладу" из дока "Пересчет товаров".
	СхемаКомпоновкиДанных = Документы.ПересчетТоваров.ПолучитьМакет("ОтборПересчетаПоСкладу");
	URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор());
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
	НастройкиОтбораСКД.Инициализировать(ИсточникНастроек);
	
	// Загрузка настроек СКД по умолчанию и их отключение.
	НастройкиОтбораСКД.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	НастройкиКД = НастройкиОтбораСКД.ПолучитьНастройки();
	Для каждого ТекОтборСКД Из НастройкиОтбораСКД.Настройки.Отбор.Элементы Цикл
		ТекОтборСКД.Использование = Ложь;
	КонецЦикла;
	
	Если РежимКорректировки = Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличество Тогда
		
//   В данном режиме мы не добавляем новые строки в ТЧ Товары, поэтому ставим отборы и получаем данные только по той
// номенклатуре, которая уже введена.
		//  Иначе отборов нет и получаем все остатки.
		
		НовыйЭлементОтбораСКД = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура");
		НовыйЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйЭлементОтбораСКД.ПравоеЗначение = СписокНоменклатуры.ВыгрузитьЗначения();
		НовыйЭлементОтбораСКД.Использование = Истина;
		
		НовыйЭлементОтбораСКД = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Характеристика");
		НовыйЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйЭлементОтбораСКД.ПравоеЗначение = СписокХарактеристик.ВыгрузитьЗначения();
		НовыйЭлементОтбораСКД.Использование = Истина;
		
		НовыйЭлементОтбораСКД = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Серия");
		НовыйЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйЭлементОтбораСКД.ПравоеЗначение = СписокСерий.ВыгрузитьЗначения();
		НовыйЭлементОтбораСКД.Использование = Истина;
		
		НовыйЭлементОтбораСКД = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлементОтбораСКД.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Назначение");
		НовыйЭлементОтбораСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		НовыйЭлементОтбораСКД.ПравоеЗначение = СписокНазначений.ВыгрузитьЗначения();
		НовыйЭлементОтбораСКД.Использование = Истина;
		
	КонецЕсли;
	
	// загрузка настроек СКД.
	НастройкиОтбораСКД.ЗагрузитьНастройки(НастройкиКД);
	
	// Установка параметров СКД.
	УстановитьЗначениеПараметраНастроек(НастройкиОтбораСКД.Настройки, "Склад" , СтруктураОтборПерезаполнения.Склад);
	УстановитьЗначениеПараметраНастроек(НастройкиОтбораСКД.Настройки, "Помещение", Справочники.СкладскиеПомещения.ПустаяСсылка());
	УстановитьЗначениеПараметраНастроек(НастройкиОтбораСКД.Настройки, "ДатаОстатков", ?(ЗначениеЗаполнено(СтруктураОтборПерезаполнения.Дата), СтруктураОтборПерезаполнения.Дата, ТекущаяДатаСеанса()));
	
	// Макет компоновки.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтбораСКД.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	// Процессор компоновки.
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	// Вывод результата.
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	РезультатТаблица = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Если РезультатТаблица.Количество() Тогда
		
		// Остатки найдены, обновляем строки для перезаполнения.
		КолонкиСПОстатков = "Номенклатура";
		Если ИспользоватьХарактеристикиНоменклатуры Тогда
			КолонкиСПОстатков = КолонкиСПОстатков + ",Характеристика";
		КонецЕсли;
		Если ИспользоватьСерииНоменклатурыСклад Тогда
			КолонкиСПОстатков = КолонкиСПОстатков + ",Серия";
		КонецЕсли;
		Если ИспользоватьОбособленноеОбеспечениеЗаказов Тогда
			КолонкиСПОстатков = КолонкиСПОстатков + ",Назначение";
		КонецЕсли;
		СПОстатков = Новый Структура(КолонкиСПОстатков);
		
		Для каждого ТекСтрокаПерезаполнить Из СтрокиПерезаполнить Цикл
			ЗаполнитьЗначенияСвойств(СПОстатков, ТекСтрокаПерезаполнить);
			ОстаткиСтроки = РезультатТаблица.НайтиСтроки(СПОстатков);
			Если ОстаткиСтроки.Количество() Тогда
				СтрокаОстатки = ОстаткиСтроки[0];
				ТекСтрокаПерезаполнить.Количество			= СтрокаОстатки.Количество;
				ТекКоэффициентЕИТовара						= питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекСтрокаПерезаполнить.Номенклатура, ТекСтрокаПерезаполнить.Упаковка, ТекКэшированныеЗначения);
				ТекСтрокаПерезаполнить.КоличествоУпаковок	= СтрокаОстатки.КоличествоУпаковок/?(ТекКоэффициентЕИТовара=0,1,ТекКоэффициентЕИТовара);
			Иначе
				ТекСтрокаПерезаполнить.Количество			= 0;
				ТекСтрокаПерезаполнить.КоличествоУпаковок	= 0;
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Иначе обнуляем строки для перезаполнения.
		Для каждого ТекСтрокаПерезаполнить Из СтрокиПерезаполнить Цикл
			ТекСтрокаПерезаполнить.Количество			= 0;
			ТекСтрокаПерезаполнить.КоличествоУпаковок	= 0;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ РежимКорректировки = Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличество Тогда
		
		// Добавление новых строк в таблицу.
		
		Для каждого ТекСтрокаРезультат Из РезультатТаблица Цикл
			
			СтрокаНайдена = Ложь;
			
			Для каждого ТекСтрокаПерезаполнить Из СтрокиПерезаполнить Цикл
				
				Если ТекСтрокаРезультат.Номенклатура = ТекСтрокаПерезаполнить.Номенклатура Тогда
					СтрокаНайдена = Истина;
					Если ИспользоватьХарактеристикиНоменклатуры Тогда
						СтрокаНайдена = ТекСтрокаРезультат.Характеристика = ТекСтрокаПерезаполнить.Характеристика;
					КонецЕсли;
					Если ИспользоватьСерииНоменклатурыСклад Тогда
						СтрокаНайдена = ТекСтрокаРезультат.Серия = ТекСтрокаПерезаполнить.Серия;
					КонецЕсли;
					Если ИспользоватьОбособленноеОбеспечениеЗаказов Тогда
						СтрокаНайдена = ТекСтрокаРезультат.Назначение = ТекСтрокаПерезаполнить.Назначение;
					КонецЕсли;
					Если СтрокаНайдена Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ СтрокаНайдена Тогда
				
				НовСтрокаПерезаполнить = СтрокиПерезаполнить.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаПерезаполнить, ТекСтрокаРезультат);
				НовСтрокаПерезаполнить.ИдентификаторСтроки = Новый УникальныйИдентификатор;
				НовСтрокаПерезаполнить.КоличествоИзПолуфабрикатов = 0;
				НовСтрокаПерезаполнить.КоличествоУпаковокИзПолуфабрикатов = 0;
				Если РежимКорректировки = Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличествоСЗаполнениемИОбновлением Тогда
					НовСтрокаПерезаполнить.КоличествоФактБезПФ = 0;
					НовСтрокаПерезаполнить.КоличествоУпаковокФактБезПФ = 0;
					НовСтрокаПерезаполнить.КоличествоФакт = 0;
					НовСтрокаПерезаполнить.КоличествоУпаковокФакт = 0;
				Иначе
					НовСтрокаПерезаполнить.КоличествоФактБезПФ = НовСтрокаПерезаполнить.Количество;
					НовСтрокаПерезаполнить.КоличествоУпаковокФактБезПФ = НовСтрокаПерезаполнить.КоличествоУпаковок;
					НовСтрокаПерезаполнить.КоличествоФакт = НовСтрокаПерезаполнить.Количество;
					НовСтрокаПерезаполнить.КоличествоУпаковокФакт = НовСтрокаПерезаполнить.КоличествоУпаковок;
				КонецЕсли;
				
				СтрокиЗаполнитьЕдиницы.Добавить(НовСтрокаПерезаполнить);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтрокиЗаполнитьЕдиницы;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура - Установить значение параметра настроек.
//
// Параметры:
//  Настройки - Произвольный - Настройки.
//  ИмяПараметра - Произвольный - Имя параметра.
//  Значение - Произвольный - Значение.
//
