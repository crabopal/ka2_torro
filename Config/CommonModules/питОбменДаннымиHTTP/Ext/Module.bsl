#Область ПрограммныйИнтерфейс

#Область ОписаниеКоманд

// Функция - Метод информация по коду маркировки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция Метод_ИнформацияПоКодуМаркировки() Экспорт
	Возврат Перечисления.питУдаленныеКассыЛогированиеМетоды.ИнформацияПоКодуМаркировки;
КонецФункции

#КонецОбласти

#Область ПодготовкаДанныхДляОтветов

// Функция - Данные по коду маркировки.
//
// Параметры:
//  ВходныеПараметры - Произвольный - Входные параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДанныеПоКодуМаркировки(ВходныеПараметры) Экспорт
	
	ВыходныеПараметры = Новый Структура;
	ВыходныеПараметры.Вставить("Результат", Ложь);
	ВыходныеПараметры.Вставить("Номенклатура", "");
	ВыходныеПараметры.Вставить("Характеристика", "");
	ВыходныеПараметры.Вставить("АлкогольнаяПродукция", "");
	ВыходныеПараметры.Вставить("Объем", 0);
	
	КодМаркировкиВBase64 = ВходныеПараметры.stampCode;
	ОрганизацияИСМП = Неопределено;
	Если ВходныеПараметры.Свойство("OrgID") Тогда
		ОрганизацияИСМП = питОбменДанными.ПолучитьСсылкуПоИД(ВходныеПараметры.OrgID,
			Справочники.Организации);
	КонецЕсли;
	
	КодМаркировки = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.Base64ВШтрихкод(КодМаркировкиВBase64);
	
	ШтрихкодУпаковки = питОбменДанными.ПолучитьШтрихкодУпаковкиПоЗначению(КодМаркировки,,,,,, Ложь);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(АкцизныеМаркиЕГАИС.АлкогольнаяПродукция, НЕОПРЕДЕЛЕНО) КАК АлкогольнаяПродукция,
	|	ЕСТЬNULL(АкцизныеМаркиЕГАИС.АлкогольнаяПродукция.Объем, 0) КАК Объем
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	|		ПО ШтрихкодыУпаковокТоваров.Ссылка = АкцизныеМаркиЕГАИС.АкцизнаяМарка
	|			И (АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияИСМП)
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.Ссылка = &ШтрихкодУпаковки";
	
	Если НЕ ЗначениеЗаполнено(ОрганизацияИСМП) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияИСМП", "ИСТИНА");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ШтрихкодУпаковки", ШтрихкодУпаковки);
	Запрос.УстановитьПараметр("ОрганизацияИСМП", ОрганизацияИСМП);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ВыходныеПараметры, Выборка);
		ВыходныеПараметры.Результат = Истина;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Result", ВыходныеПараметры.Результат);
	Результат.Вставить("ProdID", питОбменДанными.ПолучитьИДПоСсылке(ВыходныеПараметры.Номенклатура));
	Результат.Вставить("ProdVarID", питОбменДанными.ПолучитьИДПоСсылке(ВыходныеПараметры.Характеристика));
	Результат.Вставить("AlcoID", питОбменДанными.ПолучитьИДПоСсылке(ВыходныеПараметры.АлкогольнаяПродукция));
	Результат.Вставить("Volume", ВыходныеПараметры.Объем);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Функция - Начать обработку запроса.
//
// Параметры:
//  ЗапросСервиса - Произвольный - Запрос сервиса.
//  ИмяКоманды - Произвольный - Имя команды.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НачатьОбработкуЗапроса(ЗапросСервиса, ИмяКоманды) Экспорт
	
	ПараметрыОбработки = ПодготовитьПараметрыОбработки(ЗапросСервиса, ИмяКоманды);
	ТекстОшибок = "";
	Если НЕ ПараметрыОбработкиКорректны(ПараметрыОбработки, ТекстОшибок) Тогда
		ЗафиксироватьОшибкуОбработки(ПараметрыОбработки, ТекстОшибок);
		Ответ = СформироватьОтвет(ПараметрыОбработки);
		Возврат Ответ;
	КонецЕсли;
	
	Если ПараметрыОбработки.ИмяКоманды = Метод_ИнформацияПоКодуМаркировки() Тогда
		ОбработатьКоманду_ИнформацияПоКодуМаркировки(ПараметрыОбработки);
		
	Иначе
		
		ТекстОшибки = НСтр("ru='Обработка сообщения завершилась с ошибкой. Неизвестный тип запроса'");
		ЗафиксироватьОшибкуОбработки(ПараметрыОбработки, ТекстОшибки);
		
	КонецЕсли;
	
	Ответ = СформироватьОтвет(ПараметрыОбработки);
	Возврат Ответ;
	
КонецФункции

// Процедура - Очистить устаревшие записи.
//
Процедура ОчиститьУстаревшиеЗаписи() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.питКонтрольОстатковМарокИС);
	
	РегистрыСведений.питУдаленныеКассыЛогирование.ОчиститьУстаревшиеЗаписи();

КонецПроцедуры

// Функция - Сформировать текст ответа.
//
// Параметры:
//  ВыходноеЗначение - Произвольный - Выходное значение.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СформироватьТекстСообщенияJSON(ВыходноеЗначение) Экспорт
	
	Результат = "";
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON( , Символы.Таб);
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписатьJSON(ЗаписьJSON, ВыходноеЗначение,,"ПреобразоватьВJSON",питОбменДаннымиHTTP);
		Результат = ЗаписьJSON.Закрыть();
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);
		Событие = ИмяСобытияЖР();
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Функция - Преобразовать из JSON
//
// Параметры:
//  Свойство - Произвольный - Знач свойство.
//  Значение - Произвольный - Значение.
//  ДополнительныеПараметры - Структура - Дополнительные параметры.
//  Отказ - Булево - Отказ.
//
// Возвращаемое значение:
//  Произвольный - Преобразованное значение.
Функция ПреобразоватьВJSON(Знач Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт
	
	ТипЭлемента = ТипЗнч(Значение);
	ИмяТипа = XMLТип(ТипЭлемента).ИмяТипа;
	ПреобразованноеЗначение = Неопределено;
	Попытка
		
		Если СтрНайти(ИмяТипа,"Ref") > 0 Тогда
			ПреобразованноеЗначение = питОбменДанными.ПолучитьИДПоСсылке(Значение);
		ИначеЕсли ИмяТипа = "Null" Тогда
			ПреобразованноеЗначение = "";
		ИначеЕсли ИмяТипа = "ValueStorage" Тогда
			ПреобразованноеЗначение = ЗначениеВСтрокуВнутр(Значение);
		Иначе
			// Неизвестно, что было отправлено.
			Отказ = Истина;
		КонецЕсли;
		
	Исключение
		Отказ = Истина;
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);
		Событие = ИмяСобытияЖР();
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Результат = (ПреобразованноеЗначение);
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиВыполнения

// Процедура - Обработать команду информация по коду маркировки.
//
// Параметры:
//  ПараметрыОбработки - Произвольный - Параметры обработки.
//
Процедура ОбработатьКоманду_ИнформацияПоКодуМаркировки(ПараметрыОбработки)
	
	ВыходныеПараметры = ДанныеПоКодуМаркировки(ПараметрыОбработки);
	ПараметрыОбработки.ТекстОтвета  = СформироватьТекстСообщенияJSON(ВыходныеПараметры);
	
КонецПроцедуры

#КонецОбласти

// Функция - Подготовить параметры обработки.
//
// Параметры:
//  Запрос - Произвольный - Запрос.
//  ИмяКоманды - Произвольный - Имя команды.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодготовитьПараметрыОбработки(Запрос, ИмяКоманды)
	
	ПараметрыОбработки = Новый Структура;
	
	ПолучитьПараметрыИзЗаголовка(Запрос.Заголовки, ПараметрыОбработки, "Заголовок");
	ПолучитьПараметрыИзЗаголовка(Запрос.ПараметрыURL, ПараметрыОбработки, "ПараметрАдреса");
	ПолучитьПараметрыИзЗаголовка(Запрос.ПараметрыЗапроса, ПараметрыОбработки, "ПараметрЗапроса");
	
	Если ПараметрыОбработки.Свойство("CheckoutPrefix") Тогда
		КассовыйУзел = ПолучитьКассовыйУзелПоПрефиксу(ПараметрыОбработки.CheckoutPrefix);
	ИначеЕсли ПараметрыОбработки.Свойство("Checkout_Prefix") Тогда
		КассовыйУзел = ПолучитьКассовыйУзелПоПрефиксу(ПараметрыОбработки.Checkout_Prefix);
	ИначеЕсли ПараметрыОбработки.Свойство("TaskId") Тогда
		КассовыйУзел = питОбменДанными.ПолучитьСсылкуПоИД(ПараметрыОбработки.TaskId, ПланыОбмена.питУдаленныеКассы);
	ИначеЕсли ПараметрыОбработки.Свойство("Task_Id") Тогда
		КассовыйУзел = питОбменДанными.ПолучитьСсылкуПоИД(ПараметрыОбработки.Task_Id, ПланыОбмена.питУдаленныеКассы);
	Иначе
		КассовыйУзел = ПланыОбмена.питУдаленныеКассы.ПустаяСсылка();
	КонецЕсли;
	
	Если ПараметрыОбработки.Свойство("UnloadingMethod") Тогда 
		СпособВыгрузки = ПараметрыОбработки.UnloadingMethod;
	ИначеЕсли ПараметрыОбработки.Свойство("Unloading_Method") Тогда 
		СпособВыгрузки = ПараметрыОбработки.Unloading_Method;
	Иначе
		СпособВыгрузки = Неопределено;
	КонецЕсли;
	
	Если ПараметрыОбработки.Свойство("Filter") Тогда
		Фильтр = Число(ПараметрыОбработки.Filter);
	Иначе
		Фильтр = 0;
	КонецЕсли;

	ПараметрыОбработки.Вставить("СпособВыгрузки", СпособВыгрузки);
	ПараметрыОбработки.Вставить("КассовыйУзел", КассовыйУзел);
	ПараметрыОбработки.Вставить("Фильтр", Фильтр);
	ПараметрыОбработки.Вставить("МетодHTTP", Запрос.HTTPМетод);
	ПараметрыОбработки.Вставить("ОтносительныйURL", Сред(Запрос.ОтносительныйURL, 2));
	ПараметрыОбработки.Вставить("ИмяКоманды", ИмяКоманды);
	ПараметрыОбработки.Вставить("РезультатОбработки", Истина);
	ПараметрыОбработки.Вставить("ТекстОтвета", "");
	ПараметрыОбработки.Вставить("ВыходныеПараметры", Новый Структура);
	ПараметрыОбработки.Вставить("ЗапросHTTP", Запрос);
		
	ЗафиксироватьСобытиеВЖурналеЛогирования(ПараметрыОбработки, Перечисления.питУдаленныеКассыЛогированиеДействия.НачалоОбработки);

	Возврат ПараметрыОбработки;
КонецФункции

// Функция - Параметры обработки корректны.
//
// Параметры:
//  ПараметрыОбработки - Произвольный - Параметры обработки.
//  ОписаниеОшибки - Произвольный - Описание ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПараметрыОбработкиКорректны(ПараметрыОбработки, ОписаниеОшибки)
	
	Если ПараметрыОбработки.ИмяКоманды = Метод_ИнформацияПоКодуМаркировки()
		И (НЕ ПараметрыОбработки.Свойство("stampCode")
		ИЛИ НЕ ЗначениеЗаполнено(ПараметрыОбработки.stampCode)) Тогда
		ОписаниеОшибки = НСтр("ru='Код маркировки не указан'");
	КонецЕсли;
	
	Возврат НЕ ЗначениеЗаполнено(ОписаниеОшибки);
КонецФункции

// Процедура - Зафиксировать ошибку обработки.
//
// Параметры:
//  ПараметрыОбработки - Произвольный - Параметры обработки.
//  ТекстОшибки - Произвольный - Текст ошибки.
//
Процедура ЗафиксироватьОшибкуОбработки(ПараметрыОбработки, ТекстОшибки = Неопределено)
	
	ПараметрыОбработки.РезультатОбработки = Ложь;
	
	Если НЕ ТекстОшибки = Неопределено Тогда
		ПараметрыОбработки.ТекстОтвета = ТекстОшибки;
	КонецЕсли;
	
	ВыходныеПараметры = Новый Структура;
	ВыходныеПараметры.Вставить("Result", ПараметрыОбработки.РезультатОбработки);
	ВыходныеПараметры.Вставить("Comment", ПараметрыОбработки.ТекстОтвета);

	ПараметрыОбработки.ТекстОтвета = СформироватьТекстСообщенияJSON(ВыходныеПараметры);
	
КонецПроцедуры


// Функция - Сформировать ответ.
//
// Параметры:
//  ПараметрыОбработки - Произвольный - Параметры обработки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СформироватьОтвет(ПараметрыОбработки)
	
	ТелоОтвета = ПараметрыОбработки.ТекстОтвета;
	Если ПараметрыОбработки.РезультатОбработки Тогда
		КодСостояния = 200;
		Причина = "";
	Иначе
		КодСостояния = 403;
		Причина = ТелоОтвета;
	КонецЕсли;
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния, Причина);
	
	Если ПараметрыОбработки.РезультатОбработки
		И НЕ ТелоОтвета = Неопределено Тогда
		
		Если ТипЗнч(ТелоОтвета) = Тип("Строка") Тогда
			Ответ.УстановитьТелоИзСтроки(ТелоОтвета, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		ИначеЕсли ТипЗнч(ТелоОтвета) = Тип("ДвоичныеДанные") Тогда
			Ответ.УстановитьТелоИзДвоичныхДанных(ТелоОтвета)
		КонецЕсли;
		
		ЗаполнитьОбязательныеЗаголовкиОтвета(Ответ, ТелоОтвета);
		
	КонецЕсли;
	
	ПараметрыОбработки.Вставить("ОтветHTTP", Ответ);
	
	ЗафиксироватьСобытиеВЖурналеЛогирования(ПараметрыОбработки, 
		Перечисления.питУдаленныеКассыЛогированиеДействия.ФормированиеОтвета);

	Возврат Ответ;
КонецФункции


// Процедура - Заполнить обязательные заголовки ответа.
//
// Параметры:
//  Ответ - Произвольный - Ответ.
//  ТелоОтвета - Произвольный - Тело ответа.
//
Процедура ЗаполнитьОбязательныеЗаголовкиОтвета(Ответ, ТелоОтвета = Неопределено)
	
	ТипОтвета = Неопределено;
	Если ТелоОтвета = Неопределено Тогда
		Попытка
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
			Если питОбщегоНазначенияКлиентСервер.ЭтоСтрокаJSON(ТипОтвета) Тогда
				ТипОтвета = "application/json";
			ИначеЕсли питОбщегоНазначенияКлиентСервер.ЭтоСтрокаXML(ТипОтвета) Тогда
				ТипОтвета = "application/xml";
			КонецЕсли;
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	Иначе
		Если питОбщегоНазначенияКлиентСервер.ЭтоСтрокаJSON(ТипОтвета) Тогда
			ТипОтвета = "application/json";
		ИначеЕсли питОбщегоНазначенияКлиентСервер.ЭтоСтрокаXML(ТипОтвета) Тогда
			ТипОтвета = "application/xml";
		ИначеЕсли ТипЗнч(ТелоОтвета) = Тип("ДвоичныеДанные") Тогда
			ТипОтвета = "application/zip";
		КонецЕсли;
	КонецЕсли;
	
	Если ТипОтвета = Неопределено
		И ТелоОтвета = Неопределено Тогда
		Попытка
			ТелоОтвета = Ответ.ПолучитьТелоКакДвоичныеДанные();
			ТипОтвета = "application/zip";
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	
	Заголовки = Ответ.Заголовки;
	Если НЕ ТипОтвета = Неопределено Тогда
		Заголовки["Content-Type"] = ТипОтвета;
	КонецЕсли;
	Заголовки["Expires"] = Формат(ТекущаяДатаСеанса(), "ДФ='дд ММ гггг ЧЧ:мм:сс'");
	
КонецПроцедуры


// Процедура - Зафиксировать событие в журнале логирования.
//
// Параметры:
//  ПараметрыОбработки - Произвольный - Параметры обработки.
//  Действие - Произвольный - Действие.
//
Процедура ЗафиксироватьСобытиеВЖурналеЛогирования(ПараметрыОбработки, Действие)
	
	РегистрыСведений.питУдаленныеКассыЛогирование.ЗафиксироватьСобытие(ПараметрыОбработки, Действие);
	
КонецПроцедуры

// Функция - Имя события жр.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ИмяСобытияЖР()
	Результат = НСтр("ru='УдаленныеКассы'");
	Возврат Результат;
КонецФункции



// Функция - Получить параметры из заголовка.
//
// Параметры:
//  Заголовки - Произвольный - Заголовки.
//  ВходныеПараметры - Произвольный - Входные параметры.
//  ИмяПоУмолчанию - Строка - Имя по умолчанию.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьПараметрыИзЗаголовка(Заголовки, ВходныеПараметры, ИмяПоУмолчанию = "")
	
	СчетчикПустыхЭлементов = 1;
	Для Каждого ТекЗаголовок Из Заголовки Цикл
		
		ИмяЗаголовка = ТекЗаголовок.Ключ;
		
		ИмяЗаголовка = СтрЗаменить(ИмяЗаголовка, "-","_");
		ИмяЗаголовка = СтрЗаменить(ИмяЗаголовка, "*","");
		
		МассивПодстроки = СтрРазделить(ИмяЗаголовка,";");
		
		Если МассивПодстроки.Количество() > 1 Тогда
			ИмяЗаголовка = МассивПодстроки[1];
		КонецЕсли;
		
		ТекЗначение = ТекЗаголовок.Значение;
		Если ТипЗнч(ТекЗначение) = Тип("Строка") Тогда
			ТекЗначение = РаскодироватьСтроку(ТекЗначение, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИмяЗаголовка) 
			И ЗначениеЗаполнено(ИмяПоУмолчанию) Тогда
			ВходныеПараметры.Вставить(ИмяПоУмолчанию + Формат(СчетчикПустыхЭлементов, "ЧГ="), ТекЗначение);
			СчетчикПустыхЭлементов = СчетчикПустыхЭлементов + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяЗаголовка) Тогда
			ВходныеПараметры.Вставить(ИмяЗаголовка, ТекЗначение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВходныеПараметры;
	
КонецФункции

// Функция - Получить кассовый узел по префиксу.
//
// Параметры:
//  ПрефиксКассовогоУзла - Произвольный - Префикс кассового узла.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьКассовыйУзелПоПрефиксу(ПрефиксКассовогоУзла)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	питУдаленныеКассы.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	|ГДЕ
	|	питУдаленныеКассы.Код = &Префикс
	|	И НЕ питУдаленныеКассы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Префикс", ПрефиксКассовогоУзла);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		КассовыйУзел = Выборка.Ссылка;
	Иначе
		КассовыйУзел = ПланыОбмена.питУдаленныеКассы.ПустаяСсылка();
	КонецЕсли;
	
	Возврат КассовыйУзел;
	
КонецФункции 

#КонецОбласти




