// Процедура - Заполнить товары по единицам измерения.
//
// Параметры:
//  ТекОбъект - Произвольный - Тек объект.
//  СтрокиЗаполнить - Произвольный - Строки заполнить.
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
Процедура ЗаполнитьТоварыПоЕдиницамИзмерения(ТекОбъект, СтрокиЗаполнить = Неопределено, ИдентификаторСтроки = Неопределено) Экспорт
	
	Если СтрокиЗаполнить = Неопределено И ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновнаяЕдиницаМассы = питИнвентаризацияВызовСервера.ПолучитьОсновнуюЕдиницуИзмеренияМассы();
	
	Если СтрокиЗаполнить = Неопределено Тогда
		НайденныеСтроки = ТекОбъект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
		Если НЕ НайденныеСтроки.Количество() Тогда
			Возврат;
		КонецЕсли;
	Иначе
		НайденныеСтроки = Новый Массив;
		Для каждого ТекСтрокаЗаполнить Из СтрокиЗаполнить Цикл
			НайденныеСтроки.Добавить(ТекСтрокаЗаполнить);
		КонецЦикла;
	КонецЕсли;
	
	МассивНоменклатура = Новый Массив;
	Для каждого ТекСтрока Из НайденныеСтроки Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			МассивНоменклатура.Добавить(ТекСтрока.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	СП		= Новый Структура("Номенклатура");
	СПВес	= Новый Структура("Номенклатура, Упаковка");
	РезультатУпаковки = питИнвентаризацияВызовСервера.ТаблицаУпаковокНоменклатуры(МассивНоменклатура, Неопределено, Истина, Истина, Истина);
	
	Для каждого ТекСтрокаТовары Из НайденныеСтроки Цикл
		
		// Удаление существующих записей.
		питИнвентаризацияКлиентСервер.УдалитьЕдиницыИзмерения(ТекОбъект.ТоварыПоЕдиницамИзмерения, ТекСтрокаТовары.ИдентификаторСтроки);
		
		ЗаполнитьЗначенияСвойств(СП, ТекСтрокаТовары);
		НайденныеУпаковки = РезультатУпаковки.НайтиСтроки(СП);
		Для каждого ТекУпаковка Из НайденныеУпаковки Цикл
			НовСтрокаЕдиницы = ТекОбъект.ТоварыПоЕдиницамИзмерения.Добавить();
			НовСтрокаЕдиницы.Номенклатура				= ТекСтрокаТовары.Номенклатура;
			НовСтрокаЕдиницы.ХарактеристикаНоменклатуры	= ТекСтрокаТовары.Номенклатура;
			НовСтрокаЕдиницы.ЕдиницаИзмерения			= ТекУпаковка.Упаковка;
			НовСтрокаЕдиницы.ЭтоБазовая					= ТекУпаковка.ЭтоБазовая;
			
			Если ТекСтрокаТовары.Упаковка = ТекУпаковка.Упаковка
				ИЛИ (НЕ ЗначениеЗаполнено(ТекСтрокаТовары.Упаковка) И ТекУпаковка.ЭтоБазовая) Тогда
				НовСтрокаЕдиницы.Количество = ТекСтрокаТовары.КоличествоУпаковокФакт;
			Иначе
				НовСтрокаЕдиницы.Количество = 0;
			КонецЕсли;
			
			НовСтрокаЕдиницы.Коэффициент				= ТекУпаковка.Коэффициент;
			
			НовСтрокаЕдиницы.ИзПолуфабриката			= Ложь;
			НовСтрокаЕдиницы.ИдентификаторРодителя		= ТекСтрокаТовары.ИдентификаторСтроки;
			НовСтрокаЕдиницы.ИдентификаторСтроки		= Новый УникальныйИдентификатор;
			НовСтрокаЕдиницы.ТарнаяЕдиницаИзмерения		= Ложь;
			
			Если ТекУпаковка.НомВесИспользовать
				И ТекУпаковка.НомВесЗнаменатель <> 0 
				И ТекУпаковка.Вес <> 0 Тогда
				
				НомКоэффициентВеса = ТекУпаковка.НомВесЧислитель / ТекУпаковка.НомВесЗнаменатель;
				
				СПВес.Номенклатура = ТекУпаковка.Номенклатура;
				СПВес.Упаковка = ТекУпаковка.НомВесЕдиницаИзмерения;
				НайденныеВесовыеУп = РезультатУпаковки.НайтиСтроки(СПВес);
				Если НайденныеВесовыеУп.Количество() Тогда
					НомКоэффициентВесовойЕдиницы = 1/?(НайденныеВесовыеУп[0].Коэффициент=0,1,НайденныеВесовыеУп[0].Коэффициент);
				Иначе
					Продолжить;
				КонецЕсли;
				
				СПВес.Номенклатура = ТекУпаковка.Номенклатура;
				СПВес.Упаковка = ТекУпаковка.ВесЕдиницаИзмерения;
				НайденныеВесовыеУп = РезультатУпаковки.НайтиСтроки(СПВес);
				Если НайденныеВесовыеУп.Количество() Тогда
					УпаковкаКоэффициентВесовойЕдиницы = 1/?(НайденныеВесовыеУп[0].Коэффициент=0,1,НайденныеВесовыеУп[0].Коэффициент);
				Иначе
					Продолжить;
				КонецЕсли;
				
				СПВес.Номенклатура = ТекУпаковка.Номенклатура;
				СПВес.Упаковка = ОсновнаяЕдиницаМассы;
				НайденныеВесовыеУп = РезультатУпаковки.НайтиСтроки(СПВес);
				Если НайденныеВесовыеУп.Количество() Тогда
					КоэффициентОсновнойЕИМассы = 1/?(НайденныеВесовыеУп[0].Коэффициент=0,1,НайденныеВесовыеУп[0].Коэффициент);
				Иначе
					Коэф = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекУпаковка.Номенклатура, ОсновнаяЕдиницаМассы);
					КоэффициентОсновнойЕИМассы = 1/?(Коэф=0,1,Коэф);
				КонецЕсли;
				
				ВесБазовойЕИ				= НомКоэффициентВеса;
				КоэффициентУпаковкиКБазовой	= ТекУпаковка.Коэффициент;
				
				ВесТары = 0;
				Если Окр(УпаковкаКоэффициентВесовойЕдиницы,3) = Окр(НомКоэффициентВесовойЕдиницы,3)
					И Окр(УпаковкаКоэффициентВесовойЕдиницы,3) = Окр(КоэффициентОсновнойЕИМассы,3) Тогда
					ВесУпаковкиНетто			= ВесБазовойЕИ * КоэффициентУпаковкиКБазовой;
					ВесУпаковкиБрутто			= ТекУпаковка.Вес;
					ВесТары = ВесУпаковкиБрутто - ВесУпаковкиНетто;
				Иначе
					ВесУпаковкиНетто			= ВесБазовойЕИ * КоэффициентУпаковкиКБазовой / НомКоэффициентВесовойЕдиницы * КоэффициентОсновнойЕИМассы;
					ВесУпаковкиБрутто			= ТекУпаковка.Вес / УпаковкаКоэффициентВесовойЕдиницы * КоэффициентОсновнойЕИМассы;
					ВесТары = Окр(ВесУпаковкиБрутто - ВесУпаковкиНетто,3);
				КонецЕсли;
				
				Если ВесТары > 0 Тогда
					
					НовСтрокаЕдиницы.ТарнаяЕдиницаИзмерения		= Истина;
					НовСтрокаЕдиницы.Вес						= 0;
					НовСтрокаЕдиницы.ВесТары					= ВесТары * УпаковкаКоэффициентВесовойЕдиницы / КоэффициентОсновнойЕИМассы;
					НовСтрокаЕдиницы.КоличествоВзвешенныхЕдиниц	= 0;
					НовСтрокаЕдиницы.ПлотностьНапитка			= Окр(ВесБазовойЕИ * КоэффициентУпаковкиКБазовой / НомКоэффициентВесовойЕдиницы * УпаковкаКоэффициентВесовойЕдиницы,3);
					НовСтрокаЕдиницы.ВесЕдиницаИзмерения		= ТекУпаковка.ВесЕдиницаИзмерения;
					
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - Получить основную единицу измерения массы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьОсновнуюЕдиницуИзмеренияМассы() Экспорт
	Возврат Константы.ЕдиницаИзмеренияВеса.Получить();
КонецФункции

// Функция - Получить основную единицу измерения объема.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьОсновнуюЕдиницуИзмеренияОбъема() Экспорт
	Возврат Константы.ЕдиницаИзмеренияОбъема.Получить();
КонецФункции

#КонецОбласти




