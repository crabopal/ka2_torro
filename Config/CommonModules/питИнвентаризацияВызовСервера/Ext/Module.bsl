	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	// +пит
	|	Номенклатура.Ссылка,
	// -пит
	|	УпаковкиНоменклатуры.Ссылка,
	|	УпаковкиНоменклатуры.ПометкаУдаления,
	|	ЛОЖЬ,
	|	10,
