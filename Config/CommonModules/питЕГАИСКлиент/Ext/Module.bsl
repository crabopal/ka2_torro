
#Область ПрограммныйИнтерфейс

// Не будем на данном этапе реализовывать поиск номенклатуры по ШК, т.к. нас интересует только коды марок
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура питПолучитьДанныеИзТСДПослеЗакрытияВопросаОбщепитЗаполнение(Результат, ДополнительныеПараметры) Экспорт
	
	// ДополнительныеПараметры.Форма - Упр форма, которую будем заполнять товарами
	// ДополнительныеПараметры.ТаблицаТОваров - МассивСтрокТоваровИзТСД
	Форма = ДополнительныеПараметры.Форма;
	ТаблицаТОваровИзТСД = ДополнительныеПараметры.ТаблицаТОваров;   
	// теперь заполним если пустое поле ШтрихкодМаркиАлкогольнойПродукции
	Для каждого Строкатоваров Из ТаблицаТОваровИзТСД Цикл
		Если ЗначениеЗаполнено(Строкатоваров.Штрихкод) И НЕ ЗначениеЗаполнено(Строкатоваров.ШтрихкодМаркиАлкогольнойПродукции) Тогда
			// Если ШтрихкодированиеОбщегоНазначенияЕГАИС.ЭтоШтрихкодАкцизнойМарки(Строкатоваров.Штрихкод) Тогда	
				Строкатоваров.ШтрихкодМаркиАлкогольнойПродукции = Строкатоваров.Штрихкод;	
			// КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	МассивНенайденныхАлкокодов = Новый Массив;
	СписокНенайденных = "";
	
	Если Форма.ИмяФормы = "Документ.АктСписанияЕГАИС.Форма.ФормаДокумента" ИЛИ 
		 Форма.ИмяФормы = "Документ.АктПостановкиНаБалансЕГАИС.Форма.ФормаДокумента" ИЛИ
		 Форма.ИмяФормы = "Документ.ТТНИсходящаяЕГАИС.Форма.ФормаДокумента" Тогда
		 
		 КэшированныеЗначения = Неопределено;
		 СписокШК = Новый Массив;
		 Для каждого СтрокаТоваров Из ТаблицаТОваровИзТСД Цикл
			 Если ЗначениеЗаполнено(СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции) Тогда
		 	 	СписокШк.Добавить(СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции);
			Иначе
		 	 	СписокШк.Добавить(СтрокаТоваров.Штрихкод);
			КонецЕсли;
		 КонецЦикла;;
		 
		 ПараметрыСканированияАкцизныхМарок = ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыСканирования(Форма);
		 Рез = питЕГАИСОбщегоНазначения.ПолучитьДанныеПоШтрихкодамМаркированного(СписокШк,ПараметрыСканированияАкцизныхМарок, Неопределено); //ПолучитьДанныеПоШтрихкодамPDF417
		 // Рез - это соответствие, состоящие из стольких строк, сколько марок мы передаем по ТСД, 
		 // Ключ = сама марка, Значение - Структура с вычисленными по марке данными
		 Для каждого СтрокаСоотв Из Рез Цикл
			 
			Если НЕ СтрокаСоотв.МаркируемаяПродукция Тогда
				Продолжить;
			КонецЕсли;
			 
			НовыйШтрихКод = СтрокаСоотв.Штрихкод;
			АлкономенклатураИзКлассификатора = СтрокаСоотв.АлкогольнаяПродукция;
			ТекАлкокод = СтрокаСоотв.КодАлкогольнойПродукции;
			Номенклатура = СтрокаСоотв.Номенклатура;
			Справка2 = СтрокаСоотв.Справка2;
			ШтрихкодУпаковки = СтрокаСоотв.ШтрихкодУпаковки;
			 
			Если НЕ ЗначениеЗаполнено(ТекАлкокод) И СтрДлина(НовыйШтрихКод) = 68 Тогда
				// Попробуем вычислить алкокод из ПДФ417
				ТекАлкокод = питЕГАИСОбщегоНазначения.ВыделитьАлкокодИзПДФ417(НовыйШтрихКод);
			КонецЕсли;
			 
			
			Если НЕ ЗначениеЗаполнено(АлкономенклатураИзКлассификатора) И ЗначениеЗаполнено(ТекАлкокод) Тогда
				Если МассивНенайденныхАлкокодов.Найти(ТекАлкокод) = Неопределено Тогда
					МассивНенайденныхАлкокодов.ДОбавить(ТекАлкокод);
					СписокНенайденных = СписокНенайденных + ?(СписокНенайденных = "", "", ", ") + ТекАлкокод;
				КонецЕсли;
				МассивСтрок = Новый Массив;
			Иначе
				// Ищем, есть ли строка в товарах с таким алкокодом
				// в противном случае, добавляем новую строку
				ТЧТовары = Форма.Объект.Товары;
				ОтборСтрок = Новый Структура("АлкогольнаяПродукция", АлкономенклатураИзКлассификатора);
				МассивСтрок = ТЧТовары.НайтиСтроки(ОтборСтрок);
			КонецЕсли;
			
			// Ищем, есть ли строка в товарах с таким алкокодом
			// в противном случае, добавляем новую строку
			Если МассивСтрок.Количество() = 0 Тогда
			
				НоваяСтрока = Форма.Объект.Товары.Добавить();
				НоваяСтрока.ИндексАкцизнойМарки = 1;
				// НоваяСтрока.МаркируемаяАлкогольнаяПродукция = Истина;
				НоваяСтрока.АлкогольнаяПродукция 	=     АлкономенклатураИзКлассификатора;
				НоваяСтрока.Количество 		=     1;
				НоваяСтрока.КоличествоУпаковок		=     1;
				НоваяСтрока.КоличествоАкцизныхМарок = 1;
				НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
				
				НоваяСтрока.Номенклатура 	=     Номенклатура;
				НоваяСтрока.Справка2		=     Справка2;
				
				Форма.Элементы.Товары.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
				
				СтрокаТЧ = Форма.Объект.АкцизныеМарки.Добавить();
				Если НЕ Форма.ИмяФормы = "Документ.ТТНИсходящаяЕГАИС.Форма.ФормаДокумента" Тогда 
					СтрокаТЧ.КодАкцизнойМарки = НовыйШтрихКод; //этот реквизит только в актах ЕГАИС присутствует
				КонецЕсли;
				СтрокаТЧ.АкцизнаяМарка = ШтрихкодУпаковки;
				СтрокаТЧ.Справка2 = Справка2;
				СтрокаТЧ.Количество = 1;
				СтрокаТЧ.ИдентификаторСтроки = НоваяСтрока.ИдентификаторСтроки;
				
				
				// СтрОтб = Новый Структура("ИдентификаторСтроки", НоваяСтрока.ИдентификаторСтроки);
				// НоваяСтрока.КоличествоАкцизныхМарок = Форма.Объект.АкцизныеМарки.НайтиСтроки(СтрОтб).Количество(); 
				
			Иначе
				
				// На всякий случай проверим, нет ли уже введенной такой же марки
				ОтборСтрокМарок = Новый Структура("АкцизнаяМарка", ШтрихкодУпаковки);
				МассивСтрокМарок = Форма.Объект.АкцизныеМарки.НайтиСтроки(ОтборСтрокМарок);
				
				Если НЕ МассивСтрокМарок.Количество() = 0 Тогда
					// Сообщить("Данный код акцизной марки уже присутствует в списке!");
					Продолжить;
				КонецЕсли;
				
				// Меняем существующую
				СущСтрока = МассивСтрок[0];
				Форма.Элементы.Товары.ТекущаяСтрока = СущСтрока.ПолучитьИдентификатор();
				
				СущСтрока.Количество = СущСтрока.Количество + 1;
				СущСтрока.КоличествоАкцизныхМарок = СущСтрока.КоличествоАкцизныхМарок + 1;
				
				СущСтрока.КоличествоУпаковок = СущСтрока.КоличествоУпаковок + 1;
				
				СтрокаТЧ = Форма.Объект.АкцизныеМарки.Добавить();
				Если НЕ Форма.ИмяФормы = "Документ.ТТНИсходящаяЕГАИС.Форма.ФормаДокумента" Тогда 
					СтрокаТЧ.КодАкцизнойМарки = НовыйШтрихКод;
				КонецЕсли;
				СтрокаТЧ.АкцизнаяМарка = ШтрихкодУпаковки;
				СтрокаТЧ.Справка2 = Справка2;
				СтрокаТЧ.Количество = 1;
				СтрокаТЧ.ИдентификаторСтроки = СущСтрока.ИдентификаторСтроки;
				
			КонецЕсли;
			 
		 КонецЦикла;
		 
		 Если Форма.ИмяФормы = "Документ.АктСписанияЕГАИС.Форма.ФормаДокумента" Тогда
			 ВыполнитьОбработкуОповещения(ДополнительныеПараметры.питОповещениеПриЗавершении);
		 КонецЕсли;
		 
	// для инвентаризации:
		 
ИначеЕсли Форма.ИмяФормы = "Документ.питИнвентаризацияЕГАИС.Форма.Форма" Тогда 
		 
		 КэшированныеЗначения = Неопределено;
		 СписокШК = Новый Массив;
		 Для каждого СтрокаТоваров Из ТаблицаТОваровИзТСД Цикл
			 Если ЗначениеЗаполнено(СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции) Тогда
		 	 	СписокШк.Добавить(СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции);
			Иначе
		 	 	СписокШк.Добавить(СтрокаТоваров.Штрихкод);
			КонецЕсли;
		 КонецЦикла;;
		 
		ПараметрыСканированияАкцизныхМарок = Форма.ОбщПараметрыСканирования;//ШтрихкодированиеИСКлиентСервер.ИнициализироватьПараметрыСканирования(Форма);
		Рез = питЕГАИСОбщегоНазначения.ПолучитьДанныеПоШтрихкодамМаркированного(СписокШк,ПараметрыСканированияАкцизныхМарок, Неопределено); 
		// Рез - это соответствие, состоящие из стольких строк, сколько марок мы передаем по ТСД, 
		// Ключ = сама марка, Значение - Структура с вычисленными по марке данными
		Для каждого СтрокаСоотв Из Рез Цикл
			
			Если НЕ СтрокаСоотв.МаркируемаяПродукция Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйШтрихКод = СтрокаСоотв.Штрихкод; //строковое значение
			
			Форма.СписокОтсканированных.Добавить(НовыйШтрихКод);
			
			АлкономенклатураИзКлассификатора = СтрокаСоотв.АлкогольнаяПродукция;
			ТекАлкокод = СтрокаСоотв.КодАлкогольнойПродукции;
			Номенклатура = СтрокаСоотв.Номенклатура;
			Справка2 = СтрокаСоотв.Справка2;
			ШтрихкодУпаковки = СтрокаСоотв.ШтрихкодУпаковки;
			 
			Если НЕ ЗначениеЗаполнено(ТекАлкокод) И СтрДлина(НовыйШтрихКод) = 68 Тогда
				// Попробуем вычислить алкокод из ПДФ417
				ТекАлкокод = питЕГАИСОбщегоНазначения.ВыделитьАлкокодИзПДФ417(НовыйШтрихКод);
			КонецЕсли;
			 
			
			Если НЕ ЗначениеЗаполнено(АлкономенклатураИзКлассификатора) И ЗначениеЗаполнено(ТекАлкокод) Тогда
				МассивСтрок = Новый Массив;
			Иначе
				// Ищем, есть ли строка в товарах с таким алкокодом
				// в противном случае, добавляем новую строку
				ТЧТовары = Форма.Объект.ОстаткиПоДаннымЕГАИС;
				ОтборСтрок = Новый Структура("АлкогольнаяПродукция, Справка2", АлкономенклатураИзКлассификатора, Справка2);
				МассивСтрок = ТЧТовары.НайтиСтроки(ОтборСтрок);
			КонецЕсли;
			
			// Ищем, есть ли строка в товарах с таким алкокодом
			// в противном случае, добавляем новую строку
			Если МассивСтрок.Количество() = 0 Тогда
			
				НоваяСтрока = Форма.Объект.ОстаткиПоДаннымЕГАИС.Добавить();

				НоваяСтрока.АлкогольнаяПродукция 	=     АлкономенклатураИзКлассификатора;
				НоваяСтрока.КоличествоФакт 		=     1;
				
				НоваяСтрока.Номенклатура 	=     Номенклатура;
				НоваяСтрока.Справка2		=     Справка2;
				
				Форма.Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
				
			Иначе
				// Меняем существующую
				СущСтрока = МассивСтрок[0];
				Форма.Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока = СущСтрока.ПолучитьИдентификатор();
				
				СущСтрока.КоличествоФакт = СущСтрока.КоличествоФакт + 1;
				
			КонецЕсли;
			 
		 КонецЦикла;
		 
	// В ТТН входящей производим верификацию
	ИначеЕсли Форма.ИмяФормы = "Документ.ТТНВходящаяЕГАИС.Форма.ФормаДокумента" Тогда
		
		 КэшированныеЗначения = Неопределено;
		 СписокШК = Новый Массив;
		 Для каждого СтрокаТоваров Из ТаблицаТОваровИзТСД Цикл
			 Если ЗначениеЗаполнено(СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции) Тогда
		 	 	СписокШк.Добавить(СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции);
			Иначе
		 	 	СписокШк.Добавить(СтрокаТоваров.Штрихкод);
			КонецЕсли;
		 КонецЦикла;;
		 
		 // ПараметрыСканированияАкцизныхМарок = АкцизныеМаркиКлиентСервер.ПараметрыСканированияАкцизныхМарок(Форма);
		 ПараметрыСканированияАкцизныхМарок = ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыСканирования(Форма);
		 Рез = питЕГАИСОбщегоНазначения.ПолучитьДанныеПоШтрихкодамМаркированного(СписокШк,ПараметрыСканированияАкцизныхМарок, Неопределено); //ПолучитьДанныеПоШтрихкодамPDF417
		 ДополнительныеПараметры.Вставить("питСоответствиеТоваровТСД", Рез);
		 
		 Форма.питПодключаемый_ПолученыДанныеИзТСД(Рез, ДополнительныеПараметры);
		 
	ИначеЕсли Форма.ИмяФормы = "Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор" Тогда
		
		 КэшированныеЗначения = Неопределено;
		 СписокШК = Новый Массив;  //массив структор ШК
		 СтруктураШК = Новый Структура("Количество, Штрихкод");
		 Для каждого СтрокаТоваров Из ТаблицаТОваровИзТСД Цикл
		     
		    Если ЗначениеЗаполнено(СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции) Тогда
		 	 	ШК = СтрокаТоваров.ШтрихкодМаркиАлкогольнойПродукции;
		    Иначе
		 	 	ШК = СтрокаТоваров.Штрихкод;
		    КонецЕсли;
		    
		    СписокШК.Добавить(ШК);
		    
		 КонецЦикла;;
		 
		 // ПараметрыСканированияАкцизныхМарок = АкцизныеМаркиКлиентСервер.ПараметрыСканированияАкцизныхМарок(Форма);
		 ПараметрыСканированияАкцизныхМарок = ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыСканирования(Форма);
		 Рез = питЕГАИСОбщегоНазначения.ПолучитьДанныеПоШтрихкодамМаркированного(СписокШк,ПараметрыСканированияАкцизныхМарок, Неопределено); //ПолучитьДанныеПоШтрихкодамPDF417
		Если ТипЗнч(Форма.ПроверяемыйДокумент) = Тип("ДокументСсылка.АктСписанияЕГАИС") ИЛИ 
				ТипЗнч(Форма.ПроверяемыйДокумент) = Тип("ДокументСсылка.АктПостановкиНаБалансЕГАИС") ИЛИ 
				ТипЗнч(Форма.ПроверяемыйДокумент) = Тип("ДокументСсылка.ТТНИсходящаяЕГАИС") Тогда 
			Форма.Подключаемый_ПолученыДанныеИзТСД(ТаблицаТОваровИзТСД, Неопределено);
		ИначеЕсли ТипЗнч(Форма.ПроверяемыйДокумент) = Тип("ДокументСсылка.ТТНВходящаяЕГАИС") Тогда
			Форма.питПодключаемый_ПриЗагрузкеИзТСДВПроверку(Рез);//Подключаемый_ПолученыДанныеИзТСД(ТаблицаТОваровИзТСД, Неопределено);
		КонецЕсли; 
		 	
	 КонецЕсли;	
	 
	ИмяИсходнойФормы = "";
	Если Форма.ИмяФормы = "Обработка.ПроверкаИПодборАлкогольнойПродукцииЕГАИС.Форма.ПроверкаИПодбор" Тогда
		ИмяИсходнойФормы = Форма.ВладелецФормы.ИмяФормы;
		ОбъектИсхФормы =  Форма.ВладелецФормы.Объект;
	Иначе
		ИмяИсходнойФормы = Форма.ИмяФормы;
		ОбъектИсхФормы =  Форма.Объект;
	КонецЕсли;
	 
	Если ИмяИсходнойФормы = "Документ.ТТНВходящаяЕГАИС.Форма.ФормаДокумента"
		ИЛИ ИмяИсходнойФормы = "Документ.ТТНИсходящаяЕГАИС.Форма.ФормаДокумента" Тогда
		ОргИзФормы = ОбъектИсхФормы.Грузоотправитель;
	Иначе
		ОргИзФормы = ОбъектИсхФормы.ОрганизацияЕГАИС;
	КонецЕсли;
	
	Если МассивНенайденныхАлкокодов.Количество() > 0 И ЗначениеЗаполнено(ОргИзФормы) Тогда
		
		питСоздатьЗапросыНаНенайденныеАлкопозиции(МассивНенайденныхАлкокодов, ОргИзФормы);
		// СообщениеП = Новый СообщениеПользователю;
		ТекстДляВывода = "По ненайденным к классификаторе позициям: " + СписокНенайденных + " будет отправлен запрос на загрузку из ЕГАИС" + Символы.ПС + "После загрузки нажмите кнопку обновления документа";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстДляВывода);
		// СообщениеП.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - пит формирование исходящего запроса по алкокодам завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
Процедура питФормированиеИсходящегоЗапросаПоАлкокодам_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		// Результат.Вставить("ЗначениеПараметра", ДополнительныеПараметры.ЗначениеПараметра);
	КонецЕсли;
	
	// Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Процедура - пит создать запросы на ненайденные алкопозиции.
//
// Параметры:
//  МассивНенайденныхАлкокодов - Массив - Массив ненайденных алкокодов.
//  ОрганизацияИзФормы - Произвольный - Организация из формы.
//
Процедура питСоздатьЗапросыНаНенайденныеАлкопозиции(МассивНенайденныхАлкокодов, ОрганизацияИзФормы)
		
	ОрганизацияЕГАИС = ОрганизацияИзФормы;
	Операция = ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.ЗапросАлкогольнойПродукции");
	ИмяПараметра = "КОД";
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("питФормированиеИсходящегоЗапросаПоАлкокодам_Завершение", СобытияФормЕГАИСКлиентПереопределяемый);

	// На каждый алкокод делаем запрос в ЕГАИС
	Для каждого НеопознанныйАлкокод Из МассивНенайденныхАлкокодов Цикл
				
		ДанныеДляВыполненияОбменаНаКлиенте = ОбменДаннымиЕГАИСВызовСервера.ПодготовитьЗапросДанныхКлассификатораКПередаче(
			ОрганизацияЕГАИС, Операция, ИмяПараметра, СокрЛП(НеопознанныйАлкокод));
		ДанныеДляВыполненияОбменаНаКлиенте.Вставить("ВОсновнойФорме");
		ОбменДаннымиЕГАИССлужебныйКлиент.ОбработатьОчередьПередачиДанных(
			ОповещениеПриЗавершении, ДанныеДляВыполненияОбменаНаКлиенте);
			
		//ИнтеграцияЕГАИСКлиент.ПодготовитьЗапросДанныхКлассификатораКПередаче(
		//	Новый ОписаниеОповещения("питФормированиеИсходящегоЗапросаПоАлкокодам_Завершение", СобытияФормЕГАИСКлиентПереопределяемый),
		//	ОрганизацияИзФормы,
		//	ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.ЗапросАлкогольнойПродукции"),
		//	"КОД",
		//	СокрЛП(НеопознанныйАлкокод));
			
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти



