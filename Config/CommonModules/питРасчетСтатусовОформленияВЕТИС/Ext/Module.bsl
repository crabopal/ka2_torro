// Механизм расчета статусов оформления документов ВЕТИС.
//

#Область ПрограммныйИнтерфейс

// Процедура - При определении имен реквизитов документа для расчета статуса оформления документа ветис.
//
// Параметры:
//  МетаданныеДокументаОснования - Произвольный - Метаданные документа основания.
//  МетаданныеДокументаВЕТИС - Произвольный - Метаданные документа ветис.
//  Реквизиты - Произвольный - Реквизиты.
//
Процедура ПриОпределенииИменРеквизитовДокументаДляРасчетаСтатусаОформленияДокументаВЕТИС(
			МетаданныеДокументаОснования, МетаданныеДокументаВЕТИС, Реквизиты) Экспорт
	
	// +пит
	
	Если МетаданныеДокументаОснования = Метаданные.Документы.питВыпускБлюд
		ИЛИ МетаданныеДокументаОснования = Метаданные.Документы.питРазделка Тогда
		
		Реквизиты.Контрагент             			= "Организация";
		Реквизиты.Ответственный = "Ответственный";
		Реквизиты.ТорговыйИлиПроизводственныйОбъект = "Подразделение";
		
	КонецЕсли;
	// -пит
	
КонецПроцедуры

// Процедура - При определении текста запроса для расчета статуса оформления документа ветис.
//
// Параметры:
//  МетаданныеДокументаОснования - Произвольный - Метаданные документа основания.
//  МетаданныеДокументаВЕТИС - Произвольный - Метаданные документа ветис.
//  ТекстЗапроса - Произвольный - Текст запроса.
//  ДополнительныеПараметрыЗапроса - Произвольный - Дополнительные параметры запроса.
//
Процедура ПриОпределенииТекстаЗапросаДляРасчетаСтатусаОформленияДокументаВЕТИС(
			МетаданныеДокументаОснования, МетаданныеДокументаВЕТИС, ТекстЗапроса, ДополнительныеПараметрыЗапроса) Экспорт
	
	// +пит
	Если МетаданныеДокументаОснования = Метаданные.Документы.питВыпускБлюд Тогда
		
		// Для дока "Выпуск блюд" определяем текст запроса для расчета регистра статусов оформления.
		
		ТабличныеЧастиДокумента = Новый Массив;
		
		Если МетаданныеДокументаВЕТИС = Метаданные.Документы.ПроизводственнаяОперацияВЕТИС Тогда
			
			// ВыходныеИзделия
			ВыходныеИзделияПриход  = ШаблонОписанияПриходнойТабличнойЧастиДокумента("Блюда", "БлюдаСерии", МетаданныеДокументаОснования);
			
			// ПобочныеИзделия
			ПобочныеИзделияПриход  = ШаблонОписанияПриходнойТабличнойЧастиДокумента("ПобочныеИзделия", "ПобочныеИзделияСерии", МетаданныеДокументаОснования);
			
			// МатериалыИРаботы
			МатериалыИРаботыРасход = ШаблонОписанияРасходнойТабличнойЧастиДокумента("Ингредиенты", Неопределено, МетаданныеДокументаОснования);
			
			// Все ТЧ документа
			ТабличныеЧастиДокумента.Добавить(ВыходныеИзделияПриход);
			ТабличныеЧастиДокумента.Добавить(ПобочныеИзделияПриход);
			ТабличныеЧастиДокумента.Добавить(МатериалыИРаботыРасход);
			
			ТекстЗапроса = ТекстЗапросаДляРасчетаСтатусаОформления(МетаданныеДокументаОснования, ТабличныеЧастиДокумента);
			
		ИначеЕсли МетаданныеДокументаВЕТИС = Метаданные.Документы.ИсходящаяТранспортнаяОперацияВЕТИС Тогда
			
			// ВыходныеИзделия
			ВыпускТоварыРасход  = ШаблонОписанияРасходнойТабличнойЧастиДокумента("Товары", "ТоварыСерии", МетаданныеДокументаОснования);
			
			ТекстЗапроса = ТекстЗапросаДляРасчетаСтатусаОформления(МетаданныеДокументаОснования, ВыпускТоварыРасход);
			
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокументаОснования = Метаданные.Документы.питРазделка Тогда
		
		ТабличныеЧастиДокумента = Новый Массив;
		Если МетаданныеДокументаВЕТИС = Метаданные.Документы.ПроизводственнаяОперацияВЕТИС Тогда
			
			// ВыходныеИзделия
			ВыпускРазделкаПриход  = ШаблонОписанияПриходнойТабличнойЧастиДокумента("Товары",Неопределено,МетаданныеДокументаОснования);
			ВыпускРазделкаРасход  = ШаблонОписанияРасходнойТабличнойЧастиДокумента("",Неопределено,МетаданныеДокументаОснования);
			ТабличныеЧастиДокумента.Добавить(ВыпускРазделкаПриход);
			ТабличныеЧастиДокумента.Добавить(ВыпускРазделкаРасход);
			
			ТекстЗапроса = ТекстЗапросаДляРасчетаСтатусаОформления(МетаданныеДокументаОснования, ТабличныеЧастиДокумента);
			
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокументаОснования = Метаданные.Документы.ПроизводствоБезЗаказа
		ИЛИ МетаданныеДокументаОснования = Метаданные.Документы.ПеремещениеТоваров Тогда
		
//   Для "Производства без заказа", в случае, если оно является подкладным статусы не определяем. Для этого есть
// исходный "Выпуск блюд".
		мТиповойДокумент = Неопределено;
		мОписаниеПредупреждения = "";
		// ?
//   Если питТиповыеДокументы.НайтиДокументпитДляТиповогоДокумента(ДокументОснование, мТиповойДокумент,
// мОписаниеПредупреждения) Тогда.
		// 	ТекстЗапроса ="";
		// КонецЕсли;
		
	КонецЕсли;
	// -пит
	
КонецПроцедуры

//  Процедура - Проверить типовые документы и модифицировать текст запроса.
//
// Параметры:
//  МассивДокументов - Массив - Массив документов.
//  ТекстЗапроса - Произвольный - Текст запроса.
//
Процедура ПроверитьТиповыеДокументыИМодифицироватьТекстЗапроса(МассивДокументов, ТекстЗапроса) Экспорт
	
	Если МассивДокументов.Количество() 
		И (ТипЗнч(МассивДокументов[0]) = Тип("ДокументСсылка.ПроизводствоБезЗаказа")
		ИЛИ ТипЗнч(МассивДокументов[0]) = Тип("ДокументСсылка.ПеремещениеТоваров")) Тогда
		
//   Для "Производства без заказа", в случае, если оно является подкладным статусы не определяем. Для этого есть
// исходный "Выпуск блюд".
		мТиповойДокумент = Неопределено;
		мОписаниеПредупреждения = "";
		Если питТиповыеДокументы.НайтиДокументпитДляТиповогоДокумента(МассивДокументов, мТиповойДокумент, мОписаниеПредупреждения) Тогда
			ТекстЗапроса ="";
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Функция - Шаблон описания приходной табличной части документа.
//
// Параметры:
//  ИмяТабличнойЧастиТовары - Строка - Имя табличной части товары.
//  ИмяТабличнойЧастиСерии - Произвольный - Имя табличной части серии.
//  МетаданныеДокументаОснования - Произвольный - Метаданные документа основания.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ШаблонОписанияПриходнойТабличнойЧастиДокумента(ИмяТабличнойЧастиТовары = "Товары", ИмяТабличнойЧастиСерии = NULL, МетаданныеДокументаОснования)
	
	Возврат ШаблонОписанияТабличнойЧастиДокумента(Истина, ИмяТабличнойЧастиТовары, ИмяТабличнойЧастиСерии, МетаданныеДокументаОснования);
	
КонецФункции

//  Функция - Шаблон описания расходной табличной части документа.
//
// Параметры:
//  ИмяТабличнойЧастиТовары - Строка - Имя табличной части товары.
//  ИмяТабличнойЧастиСерии - Произвольный - Имя табличной части серии.
//  МетаданныеДокументаОснования - Произвольный - Метаданные документа основания.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ШаблонОписанияРасходнойТабличнойЧастиДокумента(ИмяТабличнойЧастиТовары = "Товары", ИмяТабличнойЧастиСерии = NULL, МетаданныеДокументаОснования)
	
	Возврат ШаблонОписанияТабличнойЧастиДокумента(Ложь, ИмяТабличнойЧастиТовары, ИмяТабличнойЧастиСерии, МетаданныеДокументаОснования);
	
КонецФункции

//  Функция - Шаблон описания табличной части документа.
//
// Параметры:
//  ВидДвиженияПриход - Произвольный - Вид движения приход.
//  ИмяТабличнойЧастиТовары - Строка - Имя табличной части товары.
//  ИмяТабличнойЧастиСерии - Произвольный - Имя табличной части серии.
//  МетаданныеДокументаОснования - Произвольный - Метаданные документа основания.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ШаблонОписанияТабличнойЧастиДокумента(ВидДвиженияПриход = Истина,
			ИмяТабличнойЧастиТовары = "Товары", ИмяТабличнойЧастиСерии = NULL, МетаданныеДокументаОснования)
			
	ОписаниеТЧ = Новый Структура;
	// Вид движения
	ОписаниеТЧ.Вставить("ВидДвиженияПриход", 	         ВидДвиженияПриход);
	// ТЧ Товары
	ОписаниеТЧ.Вставить("ИмяТабличнойЧастиТовары",       ИмяТабличнойЧастиТовары);
	// ТЧ Серии
	ОписаниеТЧ.Вставить("ИмяТабличнойЧастиСерии",  	     ИмяТабличнойЧастиСерии);
	ОписаниеТЧ.Вставить("АвтоПоискСерий", 		   	     (ИмяТабличнойЧастиСерии = NULL));
	// Имена полей ТЧ Товары
	
	// +пит
	Если ИмяТабличнойЧастиТовары = "Блюда" Тогда
		ОписаниеТЧ.Вставить("ИмяПоляКоличествоТЧТовары",   		 "КоличествоНоменклатуры");
		ОписаниеТЧ.Вставить("ИмяПоляНоменклатураТЧТовары",   		 "Номенклатура");
		ОписаниеТЧ.Вставить("ДопОтборы_ТаблицаТовары",       " И %ПсевдонимТабличнойЧастиТовары%.Автопередел = ЛОЖЬ ");
		ОписаниеТЧ.Вставить("ДопОтборы_Общие",       		 "");
	ИначеЕсли ИмяТабличнойЧастиТовары = "Ингредиенты" Тогда
		ОписаниеТЧ.Вставить("ИмяПоляКоличествоТЧТовары",   		 "КоличествоИнгредиентаФакт");
		ОписаниеТЧ.Вставить("ИмяПоляНоменклатураТЧТовары",   		 "Ингредиент");
		ОписаниеТЧ.Вставить("ДопОтборы_ТаблицаТовары",       " И %ПсевдонимТабличнойЧастиТовары%.ИзАвтопеределов = ЛОЖЬ ");
		ОписаниеТЧ.Вставить("ДопОтборы_Общие",       		 "");
	ИначеЕсли ИмяТабличнойЧастиТовары = "Товары" И МетаданныеДокументаОснования = Метаданные.Документы.питВыпускБлюд Тогда
		ОписаниеТЧ.Вставить("ИмяПоляКоличествоТЧТовары",   		 "Количество");
		ОписаниеТЧ.Вставить("ИмяПоляНоменклатураТЧТовары",   		 "Номенклатура");
//   ОписаниеТЧ.Вставить("ДопОтборы_Общие",       " И %ПсевдонимТабличнойЧастиТовары%.Ссылка.ХозяйственнаяОперация =
// ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ВыпускПродукцииСПеремещением) ");.
		ОписаниеТЧ.Вставить("ДопОтборы_Общие",       " И %ПсевдонимТабличнойЧастиТовары%.Ссылка.Склад <> %ПсевдонимТабличнойЧастиТовары%.Ссылка.СкладПолучатель ");
		ОписаниеТЧ.Вставить("ДопОтборы_ТаблицаТовары",       		 "");
	Иначе
		ОписаниеТЧ.Вставить("ИмяПоляКоличествоТЧТовары",   		 "Количество");
		ОписаниеТЧ.Вставить("ИмяПоляНоменклатураТЧТовары",   		 "Номенклатура");
		ОписаниеТЧ.Вставить("ДопОтборы_ТаблицаТовары",       "");
		ОписаниеТЧ.Вставить("ДопОтборы_Общие",       		 "");
	КонецЕсли;
	ОписаниеТЧ.Вставить("ИмяПоляКоличествоТЧСерии",   		 "Количество");
	// -пит
	
	ОписаниеТЧ.Вставить("ИмяПоляХарактеристикаТЧТовары",  "Характеристика");
	ОписаниеТЧ.Вставить("ИмяПоляНазначениеТЧТовары", 	 "Назначение");
	ОписаниеТЧ.Вставить("ИмяПоляСерияТЧТовары",   		 "Серия");
	
	// Имена полей ТЧ Серии
	ОписаниеТЧ.Вставить("ИмяПоляНоменклатураТЧСерии",    "Номенклатура");
	ОписаниеТЧ.Вставить("ИмяПоляХарактеристикаТЧСерии",  "Характеристика");
	ОписаниеТЧ.Вставить("ИмяПоляНазначениеТЧСерии", 	 "Назначение");
	ОписаниеТЧ.Вставить("ИмяПоляСерияТЧСерии",   		 "Серия");
	
	// Модификаторы текста запроса.
	ОписаниеТЧ.Вставить("ДопСоединения_Общие",   		 "");
	ОписаниеТЧ.Вставить("ДопСоединения_ТаблицаТовары",   "");
	ОписаниеТЧ.Вставить("ДопСоединения_ТаблицаСерии",    "");
	
	ОписаниеТЧ.Вставить("ДопОтборы_ТаблицаСерии",        "");
	
	Возврат ОписаниеТЧ;
	
КонецФункции


//  Функция - Текст запроса для расчета статуса оформления.
//
// Параметры:
//  МетаданныеДокументаОснования - Произвольный - Метаданные документа основания.
//  ОписаниеТабличныхЧастей - Произвольный - Описание табличных частей.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ТекстЗапросаДляРасчетаСтатусаОформления(МетаданныеДокументаОснования, ОписаниеТабличныхЧастей)
	
	Если ТипЗнч(ОписаниеТабличныхЧастей) <> Тип("Массив") Тогда
		// Передано описание единственной табличной части
		ТабличныеЧастиОснования = Новый Массив;
		ТабличныеЧастиОснования.Добавить(ОписаниеТабличныхЧастей);
	Иначе
		ТабличныеЧастиОснования = ОписаниеТабличныхЧастей;
	КонецЕсли;
	
	КоличествоТЧ = ТабличныеЧастиОснования.Количество();
	Если КоличествоТЧ = 0 Тогда
		УточнениеОшибки = НСтр("ru='Некорректный вызов ТекстЗапросаДляРасчетаСтатусаОформления'");
		ВызватьИсключение ИнтеграцияИСКлиентСервер.ТекстОшибкиВЕТИС(УточнениеОшибки); // Некорректный вызов ТекстЗапросаДляРасчетаСтатусаОформления
	КонецЕсли;
	
	Для Каждого ОписаниеТЧ Из ТабличныеЧастиОснования Цикл
		
		Если ОписаниеТЧ.АвтоПоискСерий Тогда
			
			Если КоличествоТЧ = 1 И МетаданныеДокументаОснования.ТабличныеЧасти.Найти("Серии") <> Неопределено Тогда
				ОписаниеТЧ.ИмяТабличнойЧастиСерии = "Серии";
			ИначеЕсли МетаданныеДокументаОснования.ТабличныеЧасти.Найти(ОписаниеТЧ.ИмяТабличнойЧастиТовары + "Серии") <> Неопределено Тогда
				ОписаниеТЧ.ИмяТабличнойЧастиСерии = ОписаниеТЧ.ИмяТабличнойЧастиТовары + "Серии";
			Иначе
				ОписаниеТЧ.ИмяТабличнойЧастиСерии = Неопределено;
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
	
	ШаблонЗапросаССериями =
	"ВЫБРАТЬ
	|	%ПсевдонимТабличнойЧастиТовары%.Ссылка КАК Ссылка,
	|	%ВидДвиженияПриход% КАК ЭтоДвижениеПриход,
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары% КАК Номенклатура,
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляХарактеристикаТЧТовары% КАК Характеристика,
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляСерияТЧТовары% КАК Серия,
	// +пит
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляКоличествоТЧТовары% КАК Количество
	// -пит
	|%СозданиеВременнойТаблицы%
	|ИЗ
	|	Документ.%ИмяДокумента%%ИмяТабличнойЧастиТовары% КАК %ПсевдонимТабличнойЧастиТовары%
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.%ИмяДокумента% КАК ТаблицаДокумента
	|		ПО ТаблицаДокумента.Ссылка = %ПсевдонимТабличнойЧастиТовары%.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО СправочникНоменклатура.Ссылка = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары%
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.%ИмяДокумента%%ИмяТабличнойЧастиСерии% КАК %ПсевдонимТабличнойЧастиСерии%
	|		ПО %ПсевдонимТабличнойЧастиСерии%.Ссылка = %ПсевдонимТабличнойЧастиТовары%.Ссылка
	|			И %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляНоменклатураТЧСерии% = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары%
	|			И %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляХарактеристикаТЧСерии% = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляХарактеристикаТЧТовары%
	|			И %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляНазначениеТЧСерии% = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНазначениеТЧТовары%
	|%ДопСоединения_Общие%
	|%ДопСоединения_ТаблицаТовары%
	|
	|ГДЕ
	|	%ПсевдонимТабличнойЧастиТовары%.Ссылка В (&МассивДокументов)
	|	И %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляНоменклатураТЧСерии% ЕСТЬ NULL
	|	И СправочникНоменклатура.ПодконтрольнаяПродукцияВЕТИС
	|%ДопОтборы_Общие%
	|%ДопОтборы_ТаблицаТовары%
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	%ПсевдонимТабличнойЧастиСерии%.Ссылка КАК Ссылка,
	|	%ВидДвиженияПриход% КАК ЭтоДвижениеПриход,
	|	%ПсевдонимТабличнойЧастиСерии%.%ИмяПоляНоменклатураТЧСерии% КАК Номенклатура,
	|	%ПсевдонимТабличнойЧастиСерии%.%ИмяПоляХарактеристикаТЧСерии% КАК Характеристика,
	|	%ПсевдонимТабличнойЧастиСерии%.%ИмяПоляСерияТЧСерии% КАК Серия,
	// +пит
	|	%ПсевдонимТабличнойЧастиСерии%.%ИмяПоляКоличествоТЧСерии% КАК Количество
	// -пит
	|ИЗ
	|	Документ.%ИмяДокумента%%ИмяТабличнойЧастиСерии% КАК %ПсевдонимТабличнойЧастиСерии%
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.%ИмяДокумента% КАК ТаблицаДокумента
	|		ПО ТаблицаДокумента.Ссылка = %ПсевдонимТабличнойЧастиСерии%.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО СправочникНоменклатура.Ссылка = %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляНоменклатураТЧСерии%
	|	ЛЕВОЕ СОЕДИНЕНИЕ 
	|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			%ПсевдонимТабличнойЧастиТовары%.Ссылка КАК Ссылка,
	|			%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары% КАК %ИмяПоляНоменклатураТЧТовары%,
	|			%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляХарактеристикаТЧТовары% КАК %ИмяПоляХарактеристикаТЧТовары%,
	|			%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНазначениеТЧТовары% КАК %ИмяПоляНазначениеТЧТовары%
	|		 ИЗ
	|			Документ.%ИмяДокумента%%ИмяТабличнойЧастиТовары% КАК %ПсевдонимТабличнойЧастиТовары%
	|		 ГДЕ
	|			%ПсевдонимТабличнойЧастиТовары%.Ссылка В (&МассивДокументов)) КАК %ПсевдонимТабличнойЧастиТовары%
	|		ПО %ПсевдонимТабличнойЧастиСерии%.Ссылка = %ПсевдонимТабличнойЧастиТовары%.Ссылка
	|			И %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляНоменклатураТЧСерии% = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары%
	|			И %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляХарактеристикаТЧСерии% = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляХарактеристикаТЧТовары%
	|			И %ПсевдонимТабличнойЧастиСерии%.%ИмяПоляНазначениеТЧСерии% = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНазначениеТЧТовары%
	|%ДопСоединения_Общие%
	|%ДопСоединения_ТаблицаСерии%
	|
	|ГДЕ
	|	%ПсевдонимТабличнойЧастиСерии%.Ссылка В (&МассивДокументов)
	|	И %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары% ЕСТЬ НЕ NULL
	|	И СправочникНоменклатура.ПодконтрольнаяПродукцияВЕТИС
	|%ДопОтборы_Общие%
	|%ДопОтборы_ТаблицаСерии%
	|";
	
	ШаблонЗапросаБезСерий =
	"ВЫБРАТЬ
	|	%ПсевдонимТабличнойЧастиТовары%.Ссылка КАК Ссылка,
	|	%ВидДвиженияПриход% КАК ЭтоДвижениеПриход,
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары% КАК Номенклатура,
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляХарактеристикаТЧТовары% КАК Характеристика,
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляСерияТЧТовары% КАК Серия,
	// +пит
	|	%ПсевдонимТабличнойЧастиТовары%.%ИмяПоляКоличествоТЧТовары% КАК Количество
	// -пит
	|%СозданиеВременнойТаблицы%
	|ИЗ
	|	Документ.%ИмяДокумента%%ИмяТабличнойЧастиТовары% КАК %ПсевдонимТабличнойЧастиТовары%
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.%ИмяДокумента% КАК ТаблицаДокумента
	|		ПО ТаблицаДокумента.Ссылка = %ПсевдонимТабличнойЧастиТовары%.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО СправочникНоменклатура.Ссылка = %ПсевдонимТабличнойЧастиТовары%.%ИмяПоляНоменклатураТЧТовары%
	|%ДопСоединения_Общие%
	|%ДопСоединения_ТаблицаТовары%
	|
	|ГДЕ
	|	%ПсевдонимТабличнойЧастиТовары%.Ссылка В (&МассивДокументов)
	|	И СправочникНоменклатура.ПодконтрольнаяПродукцияВЕТИС
	|%ДопОтборы_Общие%
	|%ДопОтборы_ТаблицаТовары%
	|";
	
	ШаблонОбъединениеЗапросов = "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|";
	
	ТекстЗапроса = "";
	
	Для НомерТаблицы = 0 По КоличествоТЧ - 1 Цикл
		
		ОписаниеТЧ = ТабличныеЧастиОснования[НомерТаблицы];
		
		Если ОписаниеТЧ.ИмяТабличнойЧастиСерии = Неопределено Тогда
			ШаблонТекстаЗапроса = ШаблонЗапросаБезСерий;
		Иначе
			ШаблонТекстаЗапроса = ШаблонЗапросаССериями;
		КонецЕсли;
		
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяДокумента%", МетаданныеДокументаОснования.Имя);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%СозданиеВременнойТаблицы%",
			?(НомерТаблицы = 0, "ПОМЕСТИТЬ " + РасчетСтатусовОформленияИС.ИмяВременнойТаблицыДляВыборкиДанныхДокумента(), ""));
		
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ВидДвиженияПриход%",
			Формат(ОписаниеТЧ.ВидДвиженияПриход, "БЛ=Ложь; БИ=Истина"));
		
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяТабличнойЧастиТовары%",
			?(ОписаниеТЧ.ИмяТабличнойЧастиТовары = "", "", ".") + ОписаниеТЧ.ИмяТабличнойЧастиТовары);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляНоменклатураТЧТовары%",   ОписаниеТЧ.ИмяПоляНоменклатураТЧТовары);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляХарактеристикаТЧТовары%", ОписаниеТЧ.ИмяПоляХарактеристикаТЧТовары);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляНазначениеТЧТовары%", 	  ОписаниеТЧ.ИмяПоляНазначениеТЧТовары);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляСерияТЧТовары%", 		  ОписаниеТЧ.ИмяПоляСерияТЧТовары);
		// +пит
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляКоличествоТЧТовары%", 	  ОписаниеТЧ.ИмяПоляКоличествоТЧТовары);
		// -пит
		
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ДопСоединения_Общие%", 		  ОписаниеТЧ.ДопСоединения_Общие);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ДопСоединения_ТаблицаТовары%",   ОписаниеТЧ.ДопСоединения_ТаблицаТовары);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ДопОтборы_Общие%", 			  ОписаниеТЧ.ДопОтборы_Общие);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ДопОтборы_ТаблицаТовары%", 	  ОписаниеТЧ.ДопОтборы_ТаблицаТовары);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ПсевдонимТабличнойЧастиТовары%", "ТаблицаТовары");
		
		// +пит
		Если МетаданныеДокументаОснования = Метаданные.Документы.питРазделка Тогда
//   ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "ТаблицаТовары.Серия",   "
// ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) ");.
//   ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "ТаблицаТовары.Характеристика",   "
// ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) ");.
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "ТаблицаТовары.Назначение", 	  " ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) ");
		КонецЕсли;
		// -пит
		
		Если ОписаниеТЧ.ИмяТабличнойЧастиСерии <> Неопределено Тогда
			
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяТабличнойЧастиСерии%",
				?(ОписаниеТЧ.ИмяТабличнойЧастиСерии = "", "", ".") + ОписаниеТЧ.ИмяТабличнойЧастиСерии);
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ПсевдонимТабличнойЧастиСерии%", "ТаблицаСерии");
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляНоменклатураТЧСерии%",   ОписаниеТЧ.ИмяПоляНоменклатураТЧСерии);
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляХарактеристикаТЧСерии%", ОписаниеТЧ.ИмяПоляХарактеристикаТЧСерии);
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляНазначениеТЧСерии%",     ОписаниеТЧ.ИмяПоляНазначениеТЧСерии);
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляСерияТЧСерии%",   		 ОписаниеТЧ.ИмяПоляСерияТЧСерии);
			// +пит
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ИмяПоляКоличествоТЧСерии%", 	 ОписаниеТЧ.ИмяПоляКоличествоТЧСерии);
			// -пит
			
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ДопСоединения_ТаблицаСерии%",   ОписаниеТЧ.ДопСоединения_ТаблицаСерии);
			ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "%ДопОтборы_ТаблицаСерии%", 		 ОписаниеТЧ.ДопОтборы_ТаблицаСерии);
			
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ?(НомерТаблицы > 0, ШаблонОбъединениеЗапросов, "") + ШаблонТекстаЗапроса;
		
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

