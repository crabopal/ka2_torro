/////////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ПОДПИСОК НА СОБЫТИЯ

#Область ПрограммныйИнтерфейс

#Область ПланОбменаПолный

// Процедура - Полный регистрация пит документа перед записью.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПолныйРегистрация_питДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Попытка
		МодульОбменДаннымиСобытияУТУП = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиСобытияУТУП");
		МодульОбменДаннымиСобытияУТУП.ОбменДаннымиПолныйПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

// Процедура - Полный регистрация пит константы перед записью.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//
Процедура ПолныйРегистрация_питКонстантыПередЗаписью(Источник, Отказ) Экспорт
	Попытка
		МодульОбменДаннымиСобытияУТУП = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиСобытияУТУП");
		МодульОбменДаннымиСобытияУТУП.ОбменДаннымиПолныйПередЗаписьюКонстанты(Источник, Отказ);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

// Процедура - Полный регистрация пит набора перед записью.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//  Замещение - Произвольный - Замещение.
//
Процедура ПолныйРегистрация_питНабораПередЗаписью(Источник, Отказ, Замещение) Экспорт
	Попытка
		МодульОбменДаннымиСобытияУТУП = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиСобытияУТУП");
		МодульОбменДаннымиСобытияУТУП.ОбменДаннымиПолныйПередЗаписьюРегистра(Источник, Отказ, Замещение);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

// Процедура - Полный регистрация пит удаления перед удалением.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//
Процедура ПолныйРегистрация_питУдаленияПередУдалением(Источник, Отказ) Экспорт
	Попытка
		МодульОбменДаннымиСобытияУТУП = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиСобытияУТУП");
		МодульОбменДаннымиСобытияУТУП.ОбменДаннымиПолныйПередУдалением(Источник, Отказ);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

// Процедура - Полный регистрация пит перед записью.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//
Процедура ПолныйРегистрация_питПередЗаписью(Источник, Отказ) Экспорт
	Попытка
		МодульОбменДаннымиСобытияУТУП = ОбщегоНазначения.ОбщийМодуль("ОбменДаннымиСобытияУТУП");
		МодульОбменДаннымиСобытияУТУП.ОбменДаннымиПолныйПередЗаписью(Источник, Отказ);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область КонтрольОстатковМарокИС

// Процедура - Контроль остатков марок ис.
//
// Параметры:
//  ВходныеПараметры - Произвольный - Входные параметры.
//
Процедура КонтрольОстатковМарокИС(ВходныеПараметры = Неопределено) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.питКонтрольОстатковМарокИС);
	
	ПериодКонтроля = ТекущаяДатаСеанса();
	
	Если ВходныеПараметры = Неопределено Тогда
		ВходныеПараметры = Новый Структура;
	КонецЕсли;
	
	СписыватьПросроченные = Истина;
	Если ВходныеПараметры.Свойство("СписыватьПросроченныеПозиции") Тогда
		СписыватьПросроченные = ВходныеПараметры.СписыватьПросроченныеПозиции;
	КонецЕсли;
	
	ОтключатьПивныеКегиБезОстатков = Истина;
	Если ВходныеПараметры.Свойство("ОтключатьПивныеКегиБезОстатков") Тогда
		ОтключатьПивныеКегиБезОстатков = ВходныеПараметры.ОтключатьПивныеКегиБезОстатков;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.Организация КАК Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати КАК МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод КАК Штрихкод,
	|	ОстаткиМарокИСОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиИсходные
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС.Остатки(&НачалоПериода, ) КАК ОстаткиМарокИСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиМарокИС.Организация,
	|	ОстаткиМарокИС.МестоПечати,
	|	ОстаткиМарокИС.Номенклатура,
	|	ОстаткиМарокИС.Штрихкод,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиМарокИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОстаткиМарокИС.Количество
	|			ИНАЧЕ -ОстаткиМарокИС.Количество
	|		КОНЕЦ)
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС КАК ОстаткиМарокИС
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМарокИС.Организация,
	|	ОстаткиМарокИС.МестоПечати,
	|	ОстаткиМарокИС.Номенклатура,
	|	ОстаткиМарокИС.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.Организация КАК Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати КАК МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод КАК Штрихкод,
	|	СУММА(ОстаткиМарокИСОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиСгруппированные
	|ИЗ
	|	ВТ_ОстаткиИсходные КАК ОстаткиМарокИСОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМарокИСОстатки.Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.Организация КАК Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати КАК МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод КАК Штрихкод,
	|	ОстаткиМарокИСОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	&СписыватьПросроченные
	|		И ОстаткиМарокИСОстатки.КоличествоОстаток > 0
	|		И НЕ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питСрокРеализации, &ПустаяДата) = &ПустаяДата
	|		И ШтрихкодыУпаковокТоваров.питСрокРеализации < &ПериодКонтроля КАК МаркаПросроченная,
	|	&ОтключатьПивныеКегиБезОстатков
	|		И ОстаткиМарокИСОстатки.КоличествоОстаток <= 0
	|		И ЕСТЬNULL(ВскрытыеПотребительскиеУпаковкиИС.Статус, &СтатусПодключен) = &СтатусПодключен КАК ОтключитьКегу
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	ВТ_ОстаткиСгруппированные КАК ОстаткиМарокИСОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ПО ОстаткиМарокИСОстатки.Штрихкод = ШтрихкодыУпаковокТоваров.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВскрытыеПотребительскиеУпаковкиИС КАК ВскрытыеПотребительскиеУпаковкиИС
	|		ПО ОстаткиМарокИСОстатки.Штрихкод = ВскрытыеПотребительскиеУпаковкиИС.КодМаркировки
	|ГДЕ
	|	(&СписыватьПросроченные
	|				И НЕ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питСрокРеализации, &ПустаяДата) = &ПустаяДата
	|				И ШтрихкодыУпаковокТоваров.питСрокРеализации < &ПериодКонтроля
	|				И ОстаткиМарокИСОстатки.КоличествоОстаток > 0
	|			ИЛИ &ОтключатьПивныеКегиБезОстатков
	|				И ОстаткиМарокИСОстатки.КоличествоОстаток <= 0
	|				И ЕСТЬNULL(ВскрытыеПотребительскиеУпаковкиИС.Статус, &СтатусПодключен) = &СтатусПодключен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Организация КАК Организация,
	|	ВТ_Остатки.МестоПечати КАК МестоПечати,
	|	ВТ_Остатки.Номенклатура КАК Номенклатура,
	|	ВТ_Остатки.Штрихкод КАК ШтрихкодУпаковки,
	|	-ВТ_Остатки.КоличествоОстаток КАК Количество,
	|	МестаПечати.СкладПриготовления КАК СкладПриготовления
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питМестаПечати КАК МестаПечати
	|		ПО ВТ_Остатки.МестоПечати = МестаПечати.Ссылка
	|ГДЕ
	|	ВТ_Остатки.МаркаПросроченная
	|ИТОГИ ПО
	|	Организация,
	|	СкладПриготовления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Штрихкод КАК КодМаркировки
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|ГДЕ
	|	ВТ_Остатки.ОтключитьКегу
	|	И НЕ ВТ_Остатки.МаркаПросроченная";
	Запрос.УстановитьПараметр("ПустаяДата", Дата('00010101'));
	Запрос.УстановитьПараметр("НачалоПериода", ПериодКонтроля - 7*86400);
	Запрос.УстановитьПараметр("ПериодКонтроля", ПериодКонтроля);
	Запрос.УстановитьПараметр("СтатусПодключен", Перечисления.СтатусыВскрытыхПотребительскихУпаковокИС.Подключено);
	Запрос.УстановитьПараметр("СписыватьПросроченные", СписыватьПросроченные);
	Запрос.УстановитьПараметр("ОтключатьПивныеКегиБезОстатков", ОтключатьПивныеКегиБезОстатков);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаПоОрганизациям = РезультатЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	МассивСозданныхДокументов = Новый Массив;
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		СоответствиеДокументовПоПодразделениям = Новый Соответствие;
		ВыборкаПоСкладам = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоСкладам.Следующий() Цикл
			
			ТекДокумент = Документы.питКорректировкаОстатковИС.СоздатьДокумент();
			ТекДокумент.Дата = ПериодКонтроля;
			ТекДокумент.Заполнить(Неопределено);
			ТекДокумент.Организация = ВыборкаПоСкладам.Организация;
			ТекДокумент.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.КорректировкаОстатковИСКорректировкаОстатков;
			ТекДокумент.Склад = ВыборкаПоСкладам.СкладПриготовления;
			ТекДокумент.Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДокумент.Склад, "Подразделение");
			
			ВыборкаЗаписей = ВыборкаПоСкладам.Выбрать();
			Пока ВыборкаЗаписей.Следующий() Цикл
				
				НоваяСтрока = ТекДокумент.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаЗаписей);
				
			КонецЦикла;
			
			МассивСозданныхДокументов.Добавить(ТекДокумент);
			
		КонецЦикла;

	КонецЦикла;
	
	// Выполним автоматическое отключение кеги.
	ТаблицаКодовМаркировки = РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.НоваяТаблицаОтключенияВскрытыхПотребительскихУпаковок();
	
	Выборка = РезультатЗапроса[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаКодовМаркировки.Добавить();
		НоваяСтрока.КодМаркировки = Выборка.КодМаркировки;
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого ТекСтрока Из МассивСозданныхДокументов Цикл
			ТекСтрока.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТаблицаКодовМаркировки) Тогда
			РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.ОтключитьВскрытыеПотребительскиеУпаковки(ТаблицаКодовМаркировки);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = "ИнтеграцияИСМП";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
		ОтменитьТранзакцию();
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

// Вызов данной процедуры происходит перед записью элемента типовых документов
//  Когда необходимо выполнить какие-либо проверки на возможность записи.
//
// Параметры:
//  Источник - ДокументОбъект - Типовой документ.
//  Отказ - Булево - Признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - Режим проведения документа.
//
Процедура питПередЗаписьюТиповыхДокументов(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	// Возврат; // {debug}
	
	ИдетЗагрузкаДанных = Ложь;
	Попытка
		ИдетЗагрузкаДанных = Источник.ОбменДанными.Загрузка;
	Исключение
	КонецПопытки;
	Если ИдетЗагрузкаДанных Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка флага "питРазрешитьЗаписьТиповогоДокумента". 
	// Устанавливается при записи из метода "СформироватьТиповыеДокументы".
	Если Источник.ДополнительныеСвойства.Свойство("питРазрешитьЗаписьТиповогоДокумента") 
		И Источник.ДополнительныеСвойства.питРазрешитьЗаписьТиповогоДокумента Тогда
		Возврат;
	КонецЕсли;
	
	// Для оприходований излишков не запрещаем редактирование, 
	// но снимаем флаг "Синхронизирован" для связанных с ним документов "Общепит".
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ОприходованиеИзлишковТоваров") Тогда
		ТекстОшибки = "";
		Отказ = НЕ питТиповыеДокументы.УстановитьСинхронизациюТиповыхДокументов(,Источник.Ссылка,Ложь,ТекстОшибки);
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Для ЗаказМатериаловВПроизводство не запрещаем редактирование в РЕЖИМЕ 2.2!!!, 
	// но снимаем флаг "Синхронизирован" для связанных с ним документов "Общепит".
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказМатериаловВПроизводство") 
		ИЛИ ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказНаПеремещение") Тогда
		
		ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
		РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22);
		Если ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен Тогда
			
			ТекстОшибки = "";
			Отказ = НЕ питТиповыеДокументы.УстановитьСинхронизациюТиповыхДокументов(,Источник.Ссылка,Ложь,ТекстОшибки);
			Если Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	мТиповойДокумент = Неопределено;
	мОписаниеПредупреждения = "";
	Если НЕ Источник.Ссылка.Пустая() И питТиповыеДокументы.НайтиДокументпитДляТиповогоДокумента(Источник.Ссылка, мТиповойДокумент, мОписаниеПредупреждения) Тогда
		
		Если Источник.ПометкаУдаления = Истина И Источник.Ссылка.ПометкаУдаления = Ложь Тогда
			ТекстИсключения = "Установка пометки на удаление запрещена! ";
		ИначеЕсли Источник.ПометкаУдаления = Ложь И Источник.Ссылка.ПометкаУдаления = Истина Тогда
			ТекстИсключения = "Снятие пометки на удаление запрещено! ";
		Иначе
			ТекстИсключения = "Запись запрещена! ";
		КонецЕсли;
		ТекстИсключения = ТекстИсключения + мОписаниеПредупреждения; // добавляем подробное описание
		
		Отказ = Истина;
		ВызватьИсключение ТекстИсключения;
		
	КонецЕсли;
	
КонецПроцедуры

// Вызов данной процедуры происходит при записи документов "пит".
//
// Параметры:
//  Источник - ДокументОбъект - Документ подсистемы "пит".
//  Отказ - Булево - признак отказа от записи.
//
Процедура питПриЗаписиДокументовОбщепит(Источник, Отказ) Экспорт
	
	ИдетЗагрузкаДанных = Ложь;
	Попытка
		ИдетЗагрузкаДанных = Источник.ОбменДанными.Загрузка;
	Исключение
	КонецПопытки;
	Если ИдетЗагрузкаДанных Тогда
		Возврат;
	КонецЕсли;
	
	// +ОтложенноеПроведение
	Если НЕ Источник.ДополнительныеСвойства.Свойство("питИспользоватьОтложенноеПроведениеВыпускаБлюд") Тогда
		Источник.ДополнительныеСвойства.Вставить("питИспользоватьОтложенноеПроведениеВыпускаБлюд", ТипЗнч(Источник) = Тип("ДокументОбъект.питВыпускБлюд") И питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питИспользоватьОтложенноеПроведениеВыпускаБлюд"));
	КонецЕсли;
	Если Источник.ДополнительныеСвойства.питИспользоватьОтложенноеПроведениеВыпускаБлюд
		И НЕ Источник.ДополнительныеСвойства.Свойство("питВыполнениеДействияОтложенногоПроведения") Тогда
		Возврат;
	КонецЕсли;
	// -ОтложенноеПроведение
	
	мТиповойДокумент = Неопределено;
	мОписаниеПредупреждения = "";
	
	ТекстОшибки = "";
	Отказ = НЕ питТиповыеДокументы.УстановитьСинхронизациюТиповыхДокументов(Источник.Ссылка,,Ложь,ТекстОшибки);
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питФормироватьТиповыеДокументыПриЗаписиДокументапит") = Истина Тогда
		
		СтруктураПараметров = Новый Структура;
		ТекстОшибки = "";
		
		// +ОтложенноеПроведение
		СтруктураПараметров.Вставить("питИспользоватьОтложенноеПроведениеВыпускаБлюд", ТипЗнч(Источник) = Тип("ДокументОбъект.питВыпускБлюд") И питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питИспользоватьОтложенноеПроведениеВыпускаБлюд"));
		СтруктураПараметров.Вставить("питТекущийПриоритетДействияОтложенногоПроведения", 0);
		Если СтруктураПараметров.питИспользоватьОтложенноеПроведениеВыпускаБлюд Тогда
			СтруктураПараметров.питТекущийПриоритетДействияОтложенногоПроведения = питТиповыеДокументы.ПолучитьТекущийПриоритетДействияОтложенногоПроведения(Источник.Ссылка);
		КонецЕсли;
		
		Если СтруктураПараметров.питИспользоватьОтложенноеПроведениеВыпускаБлюд Тогда
			
			Отказ = НЕ питТиповыеДокументы.ДобавитьДействиеОтложенногоПроведения(Источник.Ссылка, Перечисления.питДействияОтложенногоПроведения.СформироватьТиповыеДокументы, Неопределено, СтруктураПараметров.питТекущийПриоритетДействияОтложенногоПроведения,ТекстОшибки);
			СтруктураПараметров.питТекущийПриоритетДействияОтложенногоПроведения = СтруктураПараметров.питТекущийПриоритетДействияОтложенногоПроведения + 1;
			Если Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
		Иначе
		// -ОтложенноеПроведение
			
			ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
			РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22, ТекстОшибки);
			Если НЕ РежимПроизводстваРазрешен Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
			
			// Будем проводить типовые документы на секунду позже. 
			// Это необходимо для правильного контроля остатков при перепроведении документа "пит".
			СтруктураПараметров.Вставить("ДатаСмещение", 0);
			СтруктураПараметров.Вставить("РежимПроизводстваРазрешен", РежимПроизводстваРазрешен);
			СтруктураПараметров.Вставить("ФормироватьДокументыПроизводства22", ФормироватьДокументыПроизводства22);
			
			// Используется в "Регистрации замен" при обновлении коэффициента исходного документа.
			Если Источник.ДополнительныеСвойства.Свойство("питБезОбновленияПодкладныхДокументов") 
				И Источник.ДополнительныеСвойства.питБезОбновленияПодкладныхДокументов Тогда
				Возврат;
			КонецЕсли;
			
			Если Источник.ДополнительныеСвойства.Свойство("РежимЗаписи") Тогда
				СтруктураПараметров.Вставить("РежимЗаписи", Источник.ДополнительныеСвойства.РежимЗаписи);
			КонецЕсли;
			
			Если Источник.ДополнительныеСвойства.Свойство("ПометкаУдаленияСтарая") Тогда
				СтруктураПараметров.Вставить("ПометкаУдаленияСтарая", Источник.ДополнительныеСвойства.ПометкаУдаленияСтарая);
			КонецЕсли;
			Если Источник.ДополнительныеСвойства.Свойство("ПометкаУдаленияНовая") Тогда
				СтруктураПараметров.Вставить("ПометкаУдаленияНовая", Источник.ДополнительныеСвойства.ПометкаУдаленияНовая);
			КонецЕсли;
			
			Отказ = НЕ питТиповыеДокументы.СформироватьТиповыеДокументы(Источник.Ссылка,СтруктураПараметров,,ТекстОшибки);
			Если Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - пит перед записью типовых справочников перед записью.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//
Процедура питПередЗаписьюТиповыхСправочниковПередЗаписью(Источник, Отказ) Экспорт
	
	// Возврат; // {debug}
	
	ИдетЗагрузкаДанных = Ложь;
	Попытка
		ИдетЗагрузкаДанных = Источник.ОбменДанными.Загрузка;
	Исключение
	КонецПопытки;
	Если ИдетЗагрузкаДанных Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.РесурсныеСпецификации") Тогда
		
		// Проверка флага "питРазрешитьЗаписьТиповогоДокумента". 
		// Устанавливается при записи из метода "СформироватьТиповыеДокументы".
		Если Источник.ДополнительныеСвойства.Свойство("питРазрешитьЗаписьТиповогоДокумента") 
			И Источник.ДополнительныеСвойства.питРазрешитьЗаписьТиповогоДокумента Тогда
			Возврат;
		КонецЕсли;
		
		// Для ресурсных спецификации не запрещаем редактирование, 
		// но снимаем флаг "Синхронизирован" для связанных с ним документов "Общепит"
		// (только если спецификация имеет статус "В разработке").
		Если ТипЗнч(Источник) = Тип("СправочникОбъект.РесурсныеСпецификации") Тогда
			ТекстОшибки = "";
			Отказ = НЕ питТиповыеДокументы.УстановитьСинхронизациюТиповыхДокументов(,Источник.Ссылка, Ложь,ТекстОшибки);
			Если Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		мТиповойДокумент = Неопределено;
		мОписаниеПредупреждения = "";
		Если НЕ Источник.Ссылка.Пустая() И питТиповыеДокументы.НайтиДокументпитДляТиповогоДокумента(Источник.Ссылка, мТиповойДокумент, мОписаниеПредупреждения) Тогда
			
			Если Источник.ПометкаУдаления = Истина И Источник.Ссылка.ПометкаУдаления = Ложь Тогда
				ТекстИсключения = "Установка пометки на удаление запрещена! ";
			ИначеЕсли Источник.ПометкаУдаления = Ложь И Источник.Ссылка.ПометкаУдаления = Истина Тогда
				ТекстИсключения = "Снятие пометки на удаление запрещено! ";
			Иначе
				ТекстИсключения = "Запись запрещена! ";
			КонецЕсли;
			ТекстИсключения = ТекстИсключения + мОписаниеПредупреждения; // добавляем подробное описание
			
			Отказ = Истина;
			ВызватьИсключение ТекстИсключения;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.СтруктураПредприятия") Тогда
		
		СтарыйРодитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Родитель");
		Если НЕ Источник.Ссылка.Пустая() Тогда
			Источник.ДополнительныеСвойства.Вставить("питРодительИзменен", Источник.Родитель <> СтарыйРодитель);
			Источник.ДополнительныеСвойства.Вставить("питСтарыйРодитель", СтарыйРодитель);
			Источник.ДополнительныеСвойства.Вставить("питЭтоНовый", Ложь);
			
		Иначе
			Источник.ДополнительныеСвойства.Вставить("питЭтоНовый", Истина);
			Источник.ДополнительныеСвойства.Вставить("питРодительИзменен", Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - пит перед записью документов общепит перед записью.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура питПередЗаписьюДокументовОбщепитПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Источник.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	Источник.ДополнительныеСвойства.Вставить("ПометкаУдаленияСтарая", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ПометкаУдаления"));
	Источник.ДополнительныеСвойства.Вставить("ПометкаУдаленияНовая", Источник.ПометкаУдаления);
КонецПроцедуры

// Процедура - пит при записи типовых справочников при записи.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//
Процедура питПриЗаписиТиповыхСправочниковПриЗаписи(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.СтруктураПредприятия") Тогда
		
		// Если произошла смена родителя
		Если Источник.ДополнительныеСвойства.Свойство("питРодительИзменен") И Источник.ДополнительныеСвойства.питРодительИзменен Тогда
			
			// Перестроить регистр актуальных рецептур по подразделениям.
			
			// Таблица уже произведенных в рамках данной транзакции записей,
			//  чтобы исключить 2 одинаковых записи в базу, т.к. это приведет к ошибке.
			//  Может произойти, если в рецептуре указано "Подразделение1" с флагом "Включая подчиненные"
			//  и "Подразделение2" с флагом "Включая подчиненные" при этом "Подразделение2" входит в "Подразделение1".
			ПроизведенныеЗаписи = Новый ТаблицаЗначений;
			ПроизведенныеЗаписи.Колонки.Добавить("Период"			, Новый ОписаниеТипов("Дата"));
			ПроизведенныеЗаписи.Колонки.Добавить("Подразделение"	, Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
			ПроизведенныеЗаписи.Колонки.Добавить("Номенклатура"		, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
			ПроизведенныеЗаписи.Колонки.Добавить("Характеристика"	, Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
			ПроизведенныеЗаписи.Колонки.Добавить("Организация"		, Новый ОписаниеТипов("СправочникСсылка.Организации"));
			СтруктураПоиска = Новый Структура("Период,Подразделение,Номенклатура,Характеристика,Организация");
			
			Запрос			= Новый Запрос; // Запрос по рецептурам
			ЗапросЗамены	= Новый Запрос; // Запрос по регистрациям замен
			
			// Если запись не новая(перетащили из одной ветки в другую)
			Если НЕ Источник.ДополнительныеСвойства.питЭтоНовый Тогда
				
				// Поиск всех родителей вверх по иераррхии в старой ветке.
				СтарыеРодители	= ПолучитьВсехВышестоящихРодителейСправочника(Источник.ДополнительныеСвойства.питСтарыйРодитель, "СтруктураПредприятия", Истина);
				
				// Поиск рецептур, в которых указывались старые родители с флагом "Включая подчиненные"
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	питРецептураРазрешенныеПодразделения.Подразделение КАК Подразделение,
				|	питРецептура.Ссылка КАК Рецептура,
				|	питРецептура.Организация КАК Организация,
				|	питРецептура.Номенклатура КАК Номенклатура,
				|	питРецептура.Характеристика КАК Характеристика,
				|	питРецептура.ДатаНачала КАК Период,
				|	питРецептура.ДатаКонца КАК ДатаОкончания
				|ИЗ
				|	Документ.питРецептура.РазрешенныеПодразделения КАК питРецептураРазрешенныеПодразделения
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питРецептура КАК питРецептура
				|		ПО питРецептураРазрешенныеПодразделения.Ссылка = питРецептура.Ссылка
				|ГДЕ
				|	питРецептураРазрешенныеПодразделения.Подразделение В(&СтарыеРодители)
				|	И питРецептураРазрешенныеПодразделения.ВключаяПодчиненные = ИСТИНА
				|	И питРецептура.ПометкаУдаления = ЛОЖЬ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|";
				
				// Поиск доков "Регистрация замен" по аналогии с рецептурами.
				ЗапросЗамены.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	питРегистрацияЗамен.Ссылка КАК ДокСсылка
				|ИЗ
				|	Документ.питРегистрацияЗамен.Подразделения КАК питРегистрацияЗаменПодразделения
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питРегистрацияЗамен КАК питРегистрацияЗамен
				|		ПО питРегистрацияЗаменПодразделения.Ссылка = питРегистрацияЗамен.Ссылка
				|ГДЕ
				|	питРегистрацияЗаменПодразделения.Подразделение В(&СтарыеРодители)
				|	И питРегистрацияЗаменПодразделения.ВключаяПодчиненные = ИСТИНА
				|	И питРегистрацияЗамен.ПометкаУдаления = ЛОЖЬ
				|	И питРегистрацияЗамен.Проведен
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|";
				
				Запрос.УстановитьПараметр("СтарыеРодители"	, СтарыеРодители);
				
				ЗапросЗамены.УстановитьПараметр("СтарыеРодители"	, СтарыеРодители);
				
			КонецЕсли;
			
			// Поиск всех родителей вверх по иерерархии в новой ветке.
			НовыеРодители	= ПолучитьВсехВышестоящихРодителейСправочника(Источник.Родитель, "СтруктураПредприятия", Истина);
			
			// Поиск рецептур, в которых указывались новые родители с флагом "Включая подчиненные"
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	питРецептураРазрешенныеПодразделения.Подразделение КАК Подразделение,
			|	питРецептура.Ссылка КАК Рецептура,
			|	питРецептура.Организация КАК Организация,
			|	питРецептура.Номенклатура КАК Номенклатура,
			|	питРецептура.Характеристика КАК Характеристика,
			|	питРецептура.ДатаНачала КАК Период,
			|	питРецептура.ДатаКонца КАК ДатаОкончания
			|ИЗ
			|	Документ.питРецептура.РазрешенныеПодразделения КАК питРецептураРазрешенныеПодразделения
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питРецептура КАК питРецептура
			|		ПО питРецептураРазрешенныеПодразделения.Ссылка = питРецептура.Ссылка
			|ГДЕ
			|	питРецептураРазрешенныеПодразделения.Подразделение В(&НовыеРодители)
			|	И питРецептураРазрешенныеПодразделения.ВключаяПодчиненные = ИСТИНА
			|	И питРецептура.ПометкаУдаления = ЛОЖЬ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СтруктураПредприятия.Ссылка КАК Подразделение
			|ИЗ
			|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
			|ГДЕ
			|	СтруктураПредприятия.Ссылка В ИЕРАРХИИ(&Ссылка)";
			
			// По аналогии с рецептурами.
			ЗапросЗамены.Текст = ЗапросЗамены.Текст +
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	питРегистрацияЗамен.Ссылка КАК ДокСсылка
			|ИЗ
			|	Документ.питРегистрацияЗамен.Подразделения КАК питРегистрацияЗаменПодразделения
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питРегистрацияЗамен КАК питРегистрацияЗамен
			|		ПО питРегистрацияЗаменПодразделения.Ссылка = питРегистрацияЗамен.Ссылка
			|ГДЕ
			|	питРегистрацияЗаменПодразделения.Подразделение В(&НовыеРодители)
			|	И питРегистрацияЗаменПодразделения.ВключаяПодчиненные = ИСТИНА
			|	И питРегистрацияЗамен.ПометкаУдаления = ЛОЖЬ
			|	И питРегистрацияЗамен.Проведен";
			
			Запрос.УстановитьПараметр("НовыеРодители"	, НовыеРодители);
			Запрос.УстановитьПараметр("Ссылка"			, Источник.Ссылка);
			
			ЗапросЗамены.УстановитьПараметр("НовыеРодители"	, НовыеРодители);
			ЗапросЗамены.УстановитьПараметр("Ссылка"			, Источник.Ссылка);
			
			РезультатЗапроса = Запрос.ВыполнитьПакет();
			РезультатЗапросаЗамены = ЗапросЗамены.ВыполнитьПакет();
			
			Если НЕ Источник.ДополнительныеСвойства.питЭтоНовый Тогда
				
				// Для неновых элементов (при перетаскивании из одной ветки в другую).
				// Для всех рецептур, у которых родители этого элемента вверх по иерархии были указаны как разрешенные
				// с флагом "Включая подчиненные" удалить записи из регистра "Актуальные рецептуры" по текущему
				// подразделению и всем его помкам.
				
				ВыборкаСтарыеРодители			= РезультатЗапроса[0].Выбрать();
				ВыборкаНовыеРодители			= РезультатЗапроса[1].Выбрать();
				ВыборкаПодразделенияПереместить	= РезультатЗапроса[2].Выбрать();
				
				СтарыеДокиЗамен					= РезультатЗапросаЗамены[0].Выбрать();
				НовыеДокиЗамен					= РезультатЗапросаЗамены[1].Выбрать();
				
				Пока ВыборкаСтарыеРодители.Следующий() Цикл
					
					Пока ВыборкаПодразделенияПереместить.Следующий() Цикл
						
						АктуальнаяРецептураМенеджер = РегистрыСведений.питАктуальныеРецептуры.СоздатьМенеджерЗаписи();
						ЗаполнитьЗначенияСвойств(АктуальнаяРецептураМенеджер, ВыборкаСтарыеРодители);
						АктуальнаяРецептураМенеджер.Подразделение = ВыборкаПодразделенияПереместить.Подразделение;
						
						Попытка
							АктуальнаяРецептураМенеджер.Удалить();
						Исключение
							ТекстОшибки = "Не удалось записать элемент справочника ""Структура предприятия"" по причине:
							| Имеются рецептуры для изменяемого подразделения:
							| " + ОписаниеОшибки();
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
						КонецПопытки;
						
					КонецЦикла;
					ВыборкаПодразделенияПереместить.Сбросить();
					
				КонецЦикла;
				
				// Обход найденных доков замен и их перепроведение.
				Пока СтарыеДокиЗамен.Следующий() Цикл
					ДокЗамены = СтарыеДокиЗамен.ДокСсылка.ПолучитьОбъект();
					ДвиженияЗамены = РегистрыСведений.питЗаменыИнгредиентов.СоздатьНаборЗаписей();
					ДвиженияЗамены.Отбор.Регистратор.Установить(СтарыеДокиЗамен.ДокСсылка);
					ДокЗамены.ЗаполнитьДвижения(ДвиженияЗамены);
					Попытка
						ДвиженияЗамены.Записать();
					Исключение
						ТекстОшибки = "Не удалось записать элемент справочника ""Структура предприятия"" по причине:
						| Имеются документы ""Регистрация замен"" для изменяемого подразделения:
						| " + ОписаниеОшибки();
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
					КонецПопытки;
				КонецЦикла;
				
			Иначе
				
				ВыборкаНовыеРодители			= РезультатЗапроса[0].Выбрать();
				ВыборкаПодразделенияПереместить	= РезультатЗапроса[1].Выбрать();
				
				НовыеДокиЗамен					= РезультатЗапросаЗамены[0].Выбрать();
				
			КонецЕсли;
			
			// Для всех рецептур, у которых НОВЫЕ родители этого элемента вверх по иерархии были указаны как разрешенные
			// с флагом "Включая подчиненные" добавить записи в регистр "Актуальные рецептуры" по текущему
			// подразделению и всем его помкам.
			Пока ВыборкаНовыеРодители.Следующий() Цикл
				
				Пока ВыборкаПодразделенияПереместить.Следующий() Цикл
					
					АктуальнаяРецептураМенеджер = РегистрыСведений.питАктуальныеРецептуры.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(АктуальнаяРецептураМенеджер, ВыборкаНовыеРодители);
					АктуальнаяРецептураМенеджер.Подразделение = ВыборкаПодразделенияПереместить.Подразделение;
					
					ЗаполнитьЗначенияСвойств(СтруктураПоиска, АктуальнаяРецептураМенеджер);
					НайденныеЗаписи = ПроизведенныеЗаписи.НайтиСтроки(СтруктураПоиска);
					Если НайденныеЗаписи.Количество() Тогда
						Продолжить;
					КонецЕсли;
					
					НовПроизведеннаяЗапись = ПроизведенныеЗаписи.Добавить();
					ЗаполнитьЗначенияСвойств(НовПроизведеннаяЗапись, АктуальнаяРецептураМенеджер);
					
					Попытка
						АктуальнаяРецептураМенеджер.Записать(Ложь);
					Исключение
						ТекстОшибки = "Не удалось записать элемент справочника ""Структура предприятия"" по причине:
						| Имеются рецептуры для нового родителя подразделения:
						| " + ОписаниеОшибки();
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
					КонецПопытки;
					
				КонецЦикла;
				
				ВыборкаПодразделенияПереместить.Сбросить();
				
			КонецЦикла;
			
			// Обход найденных доков замен и их перепроведение.
			Пока НовыеДокиЗамен.Следующий() Цикл
				ДокЗамены = НовыеДокиЗамен.ДокСсылка.ПолучитьОбъект();
				ДвиженияЗамены = РегистрыСведений.питЗаменыИнгредиентов.СоздатьНаборЗаписей();
				ДвиженияЗамены.Отбор.Регистратор.Установить(НовыеДокиЗамен.ДокСсылка);
				ДокЗамены.ЗаполнитьДвижения(ДвиженияЗамены);
				Попытка
					ДвиженияЗамены.Записать();
				Исключение
					ТекстОшибки = "Не удалось записать элемент справочника ""Структура предприятия"" по причине:
					| Имеются документы ""Регистрация замен"" для изменяемого подразделения:
					| " + ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
				КонецПопытки;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - пит инвентаризация перед записью перед записью.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура питИнвентаризацияПередЗаписьюПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	питИнвентаризация.ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения);
КонецПроцедуры

// Процедура - пит обработка заполнения обработка заполнения.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  ТекстЗаполнения - Произвольный - Текст заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура питОбработкаЗаполненияОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.УстановкаЦенНоменклатуры") 
		И ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питПеремещениеНоменклатурыСкладаПроизводства") Тогда
		СтандартнаяОбработка = Ложь;
		// Подменяем данные заполнения на структуру, чтобы в типовом документе отработал универсальный обработчик заполнения.
		ДанныеЗаполнения = Документы.питПеремещениеНоменклатурыСкладаПроизводства.ПолучитьДанныеЗаполненияДокументаУстановкиЦен(ДанныеЗаполнения);
		Источник.Заполнить(ДанныеЗаполнения);
	КонецЕсли;
КонецПроцедуры

// Функция получения списка всех вышестоящих родителей.
//
// Параметры:
//  ЭлементСправочникаСсылка - СправочникСсылка - Ссылка на элемент справочника.
//  ИмяМетаданных - Строка - Имя справочника строкой.
//  ВключатьСамЭлемент - Произвольный - Включать сам элемент.
//
// Возвращаемое значение:
//  Массив - СписокРодителей.
Функция ПолучитьВсехВышестоящихРодителейСправочника(ЭлементСправочникаСсылка, ИмяМетаданных, ВключатьСамЭлемент) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	| ИмяМетаданных.Ссылка КАК Ссылка
	|ИЗ
	| Справочник.ИмяМетаданных КАК ИмяМетаданных
	|ГДЕ
	| ИмяМетаданных.Ссылка = &ЭлементСправочникаСсылка
	| И НЕ (ИмяМетаданных.Родитель = ЗНАЧЕНИЕ(Справочник.ИмяМетаданных.ПустаяСсылка))
	|ИТОГИ ПО
	| Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ИмяМетаданных", ИмяМетаданных);
	Запрос.УстановитьПараметр("ЭлементСправочникаСсылка", ЭлементСправочникаСсылка);
	МассивРодителей = Новый Массив;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ВключатьСамЭлемент И Выборка.Ссылка = ЭлементСправочникаСсылка Тогда
				Продолжить;
			КонецЕсли;
			МассивРодителей.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Иначе
		Если ВключатьСамЭлемент Тогда
			МассивРодителей.Добавить(ЭлементСправочникаСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МассивРодителей;
	
КонецФункции

#КонецОбласти






