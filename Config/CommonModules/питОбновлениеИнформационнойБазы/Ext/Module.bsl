////////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции подсистемы пит

// Проверить необходимость обновления информационной базы при смене версии конфигурации.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НеобходимоОбновлениеИнформационнойБазыпит() Экспорт
	
	// структура описания подсистемы пит
	Описаниепит = Новый Структура("Имя, Версия, ТребуемыеПодсистемы", "", "", Новый Массив);
	
	// заполнение данных по подсистеме пит
	ПриДобавленииПодсистемы(Описаниепит);
	
	Если ОбновлениеИнформационнойБазыСлужебный.НеобходимоВыполнитьОбновление(
			Описаниепит.Версия, ОбновлениеИнформационнойБазыСлужебный.ВерсияИБ(Описаниепит.Имя)) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает числовой вес версии для сравнения версий между собой
//
// Параметры:
//  Версия - Произвольный - Знач версия.
//  Разделитель - Произвольный - Знач разделитель.
//
// Возвращаемое значение:
//  Число - вес версии
Функция ВесВерсии(Знач Версия, Знач Разделитель) Экспорт 
	
	Если Версия = "" Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат ВесВерсииИзМассиваСтрок(СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Версия, Разделитель));
	
КонецФункции

// Процедура - Установить выводить описание обновлений.
//
// Параметры:
//  ВыводитьОписаниеОбновлений - Произвольный - Выводить описание обновлений.
//
Процедура УстановитьВыводитьОписаниеОбновлений(ВыводитьОписаниеОбновлений) Экспорт
	
	ВыводитьОписаниеОбновлений = Истина;
	
КонецПроцедуры

// Для перевода на 2.5.7 при заполнении регистров потребностей
//
// Параметры:
//  ТекстыЗапроса - Произвольный - Тексты запроса.
//  ПолноеИмяДокумента - Произвольный - Полное имя документа.
//
Процедура ПодменитьДанныеДокументаДляПроведения(ТекстыЗапроса, ПолноеИмяДокумента) Экспорт
	
	Если ПолноеИмяДокумента = "Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства"
		ИЛИ ПолноеИмяДокумента = "Документ.питПеремещениеНоменклатурыСкладаПроизводства"
		ИЛИ ПолноеИмяДокумента = "Документ.питПланМеню"
		ИЛИ ПолноеИмяДокумента = "Документ.питВыпускБлюд" Тогда
		ИмяДокумента = СтрРазделить(ПолноеИмяДокумента, ".")[1];
		
		ТекстыЗапроса = Документы[ИмяДокумента].ТекстыЗапросаРаспределениеЗапасовДвиженияДляОбновленияИБ();
	КонецЕсли;
	
КонецПроцедуры

// %ИзЕРП% Обработка.РезультатыОбновленияПрограммы.Форма.ОтложенныеОбработчики.ЗапуститьВыполнениеОтложенногоОбработчика
//
// Параметры:
//  ПроцедурыОбновления - Произвольный - Процедуры обновления.
//
Процедура ЗапуститьВыполнениеОтложенныхОбработчиков(ПроцедурыОбновления) Экспорт
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Константа.СведенияОбОбновленииИБ");
		Блокировка.Заблокировать();
		
		СведенияОбОбновлении = ОбновлениеИнформационнойБазыСлужебный.СведенияОбОбновленииИнформационнойБазы();
		
		// +пит
		Если СведенияОбОбновлении.ВремяОкончаниеОтложенногоОбновления <> Неопределено Тогда
		Для каждого ПроцедураОбновления Из ПроцедурыОбновления Цикл
		// Фиксация переданных обработчиков в списке к запуску.
		// -пит
		
		Если СведенияОбОбновлении.УправлениеОтложеннымОбновлением.Свойство("ЗапуститьОбработчики")
			И ТипЗнч(СведенияОбОбновлении.УправлениеОтложеннымОбновлением.ЗапуститьОбработчики) = Тип("Массив") Тогда
			ЗапущенныеОбработчики = СведенияОбОбновлении.УправлениеОтложеннымОбновлением.ЗапуститьОбработчики;
			Если ЗапущенныеОбработчики.Найти(ПроцедураОбновления) = Неопределено Тогда
				ЗапущенныеОбработчики.Добавить(ПроцедураОбновления);
			КонецЕсли;
		Иначе
			ЗапущенныеОбработчики = Новый Массив;
			ЗапущенныеОбработчики.Добавить(ПроцедураОбновления);
			СведенияОбОбновлении.УправлениеОтложеннымОбновлением.Вставить("ЗапуститьОбработчики", ЗапущенныеОбработчики);
		КонецЕсли;
		
		// +пит
		КонецЦикла;
		// -пит
		
		// +пит
		// Обнуление времени окончания отложенного обновления.
		СведенияОбОбновлении.ВремяОкончаниеОтложенногоОбновления = Неопределено;
		// -пит
		
		ОбновлениеИнформационнойБазыСлужебный.ЗаписатьСведенияОбОбновленииИнформационнойБазы(СведенияОбОбновлении);
		
		// +пит
		// Сброс статусов переданных обработчиков в регистре сведений.
		Для каждого ПроцедураОбновления Из ПроцедурыОбновления Цикл
			МенеджерЗап = РегистрыСведений.ОбработчикиОбновления.СоздатьМенеджерЗаписи();
			МенеджерЗап.ИмяОбработчика = ПроцедураОбновления;
			МенеджерЗап.Прочитать();
			Если МенеджерЗап.Выбран() Тогда
				МенеджерЗап.Статус = Перечисления.СтатусыОбработчиковОбновления.НеВыполнялся;
				МенеджерЗап.Записать();
			КонецЕсли;
		КонецЦикла;
		
		// Выполнение отложенного обновления НЕ в фоне.
		ОбновлениеИнформационнойБазыСлужебный.ВыполнитьОтложенноеОбновлениеСейчас(Неопределено);
		
		// Установка времени окончания отложенного обновления.
		СведенияОбОбновлении = ОбновлениеИнформационнойБазыСлужебный.СведенияОбОбновленииИнформационнойБазы();
		СведенияОбОбновлении.ВремяОкончаниеОтложенногоОбновления = ТекущаяДатаСеанса();
		ОбновлениеИнформационнойБазыСлужебный.ЗаписатьСведенияОбОбновленииИнформационнойБазы(СведенияОбОбновлении);
		КонецЕсли;
		// -пит
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Первоначальное_заполнение

// Процедура - Подготовить обработчики заполнения предопределенных элементов.
//
// Параметры:
//  Обработчики - Произвольный - Обработчики.
//
Процедура ПодготовитьОбработчикиЗаполненияПредопределенныхЭлементов(Обработчики)
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить("Справочники.питНастройкиДоставкиСообщений");
	
	Для Каждого ТекОбъект Из МассивОбъектов Цикл
		Обработчик = Обработчики.Добавить();
		Обработчик.НачальноеЗаполнение	= Истина;
		Обработчик.Версия = "*";
		Обработчик.Процедура = СтрШаблон("%1.ЗаполнитьПредопределенныеЭлементы",ТекОбъект);
		Обработчик.РежимВыполнения = "Оперативно";
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Функция - Вес версии из массива строк.
//
// Параметры:
//  РазрядыВерсииСтроками - Строка - Разряды версии строками.
//
// Возвращаемое значение:
//  Массив - Результат обработки.
Функция ВесВерсииИзМассиваСтрок(РазрядыВерсииСтроками)
	
	Возврат 0
		+ Число(РазрядыВерсииСтроками[0]) * 1000000000
		+ Число(РазрядыВерсииСтроками[1]) * 1000000
		+ Число(РазрядыВерсииСтроками[2]) * 1000
		+ Число(РазрядыВерсииСтроками[3]);
	
КонецФункции

#КонецОбласти

