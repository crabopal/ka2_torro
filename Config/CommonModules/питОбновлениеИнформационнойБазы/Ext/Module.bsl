	ЕдиницаИзмеренияВыходаВРецептурах = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питЕдиницаИзмеренияВыходаВРецептурах");
	Если ЗначениеЗаполнено(ЕдиницаИзмеренияВыходаВРецептурах) Тогда
		ДанныеЕИВыходаВРецептурах = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмеренияВыходаВРецептурах, "Числитель, Знаменатель");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	втИнгредиенты.Номенклатура КАК Номенклатура,
		|	втИнгредиенты.КоличествоВыход КАК КоличествоВыход,
		|	НоменклатураСпр.ВесЧислитель КАК ВесЧислитель,
		|	НоменклатураСпр.ВесЗнаменатель КАК ВесЗнаменатель,
		|	НоменклатураСпр.ВесЕдиницаИзмерения КАК ВесЕдиницаИзмерения,
		|	НоменклатураСпр.ВесЕдиницаИзмерения.Числитель КАК ВесЕдиницаИзмеренияЧислитель,
		|	НоменклатураСпр.ВесЕдиницаИзмерения.Знаменатель КАК ВесЕдиницаИзмеренияЗнаменатель,
		|	втИнгредиенты.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.питРецептура.Ингредиенты КАК втИнгредиенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
		|		ПО втИнгредиенты.Номенклатура = НоменклатураСпр.Ссылка
		|ГДЕ
		|	НоменклатураСпр.ВесИспользовать
		|	И НЕ втИнгредиенты.Ссылка.ПометкаУдаления
		|ИТОГИ ПО
		|	Ссылка";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаРецептуры = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРецептуры.Следующий() Цикл
			
			КоличествоРезультат = 0;
			
			ВыборкаДетальныеЗаписи = ВыборкаРецептуры.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номенклатура) Тогда
					Продолжить;
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.ВесЕдиницаИзмерения = ЕдиницаИзмеренияВыходаВРецептурах Тогда
					КоэффициентПересчетаВОсновнуюЕИМассы = Неопределено;
					Если ВыборкаДетальныеЗаписи.ВесЗнаменатель <> 0 Тогда
						КоэффициентПересчетаВЕИВыходаВРецептурах = (ВыборкаДетальныеЗаписи.ВесЧислитель/ВыборкаДетальныеЗаписи.ВесЗнаменатель);
					Иначе
						КоэффициентПересчетаВЕИВыходаВРецептурах = 1;
					КонецЕсли;
				Иначе
					Если ВыборкаДетальныеЗаписи.ВесЗнаменатель <> 0 И ВыборкаДетальныеЗаписи.ВесЕдиницаИзмеренияЗнаменатель <> 0 Тогда
						КоэффициентПересчетаВОсновнуюЕИМассы = (ВыборкаДетальныеЗаписи.ВесЧислитель/ВыборкаДетальныеЗаписи.ВесЗнаменатель) * (ВыборкаДетальныеЗаписи.ВесЕдиницаИзмеренияЧислитель/ВыборкаДетальныеЗаписи.ВесЕдиницаИзмеренияЗнаменатель);
					Иначе
						КоэффициентПересчетаВЕИВыходаВРецептурах = 1;
					КонецЕсли;
					Если ДанныеЕИВыходаВРецептурах.Числитель <> 0 Тогда
						КоэффициентПересчетаВЕИВыходаВРецептурах = КоэффициентПересчетаВОсновнуюЕИМассы * (ДанныеЕИВыходаВРецептурах.Знаменатель / ДанныеЕИВыходаВРецептурах.Числитель);
					Иначе
						КоэффициентПересчетаВЕИВыходаВРецептурах = 1;
					КонецЕсли;
				КонецЕсли;
				КоличествоРезультат = КоличествоРезультат + ВыборкаДетальныеЗаписи.КоличествоВыход * КоэффициентПересчетаВЕИВыходаВРецептурах;
				
			КонецЦикла;
			
			Если КоличествоРезультат <> 0 Тогда
				
				Попытка
					ДокОбъект = ВыборкаРецептуры.Ссылка.ПолучитьОбъект();
				Исключение
					Продолжить;
				КонецПопытки;
				ДокОбъект.ОбменДанными.Загрузка = Истина;
				
				// Меняем выход вес, на тот, который посчитался.
				ДокОбъект.ВыходВес = КоличествоРезультат;
				
				Попытка
					ДокОбъект.Записать();
				Исключение
					ИнфОбОшибке = ИнформацияОбОшибке();
					ТекстОшибки = ИнфОбОшибке.Описание;
					Пока ИнфОбОшибке.Причина <> Неопределено Цикл
						ИнфОбОшибке = ИнфОбОшибке.Причина;
						ТекстОшибки = ТекстОшибки + "
						|" + ИнфОбОшибке.Описание;
					КонецЦикла;
					ТекстОшибки = "Ошибка выполнения процедуры ""УстановитьВыходВесВРецептурах"": " + ТекстОшибки;
					Событие = "УстановитьВыходВесВРецептурах";
					ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_на_версию_2_4_11

// Процедура - Установить использование подсистемы общепит.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьИспользованиеПодсистемыОбщепит(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрофилиГруппДоступаРоли.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ втПрофилиНеСгрупп
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|ГДЕ
		|	ПрофилиГруппДоступаРоли.Роль.Имя ПОДОБНО ""пит%""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПрофилиГруппДоступаРоли.Ссылка
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|ГДЕ
		|	ПрофилиГруппДоступаРоли.Роль.Имя = ""ПолныеПрава""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втПрофилиНеСгрупп.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ втПрофили
		|ИЗ
		|	втПрофилиНеСгрупп КАК втПрофилиНеСгрупп
		|
		|СГРУППИРОВАТЬ ПО
		|	втПрофилиНеСгрупп.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГруппыДоступаПользователи.Пользователь КАК Пользователь
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
		|		ПО ГруппыДоступаПользователи.Ссылка = ГруппыДоступа.Ссылка
		|ГДЕ
		|	ГруппыДоступа.Профиль В
		|			(ВЫБРАТЬ
		|				втПрофили.Ссылка
		|			ИЗ
		|				втПрофили КАК втПрофили)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ПользовательОбъект = ВыборкаДетальныеЗаписи.Пользователь.ПолучитьОбъект();
			ПользовательОбъект.питРаботатьСПодсистемойОбщепит = Истина;
			ПользовательОбъект.ОбменДанными.Загрузка = Истина;
			Попытка
				ПользовательОбъект.Записать();
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ИнфОбОшибке.Описание;
				Пока ИнфОбОшибке.Причина <> Неопределено Цикл
					ИнфОбОшибке = ИнфОбОшибке.Причина;
					ТекстОшибки = ТекстОшибки + "
					|" + ИнфОбОшибке.Описание;
				КонецЦикла;
				ТекстОшибки = "Ошибка выполнения процедуры ""УстановитьИспользованиеПодсистемыОбщепит"": " + ТекстОшибки;
				Событие = "УстановитьИспользованиеПодсистемыОбщепит";
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Процедура - Обновить параметры отправки статистики.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ОбновитьПараметрыОтправкиСтатистики(Параметры = Неопределено) Экспорт
	
	// 0. Проверка существования подсистемы.
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЦентрМониторинга") Тогда
		Возврат;
	КонецЕсли;
	МодульЦентрМониторингаСлужебный = ОбщегоНазначения.ОбщийМодуль("ЦентрМониторингаСлужебный");
	
	// 1. Получение текущих настроек.
	ПараметрыЦентраМониторинга = МодульЦентрМониторингаСлужебный.ПолучитьПараметрыЦентраМониторинга();
	
	// 2. Определение необходимости обновления.
	Если Не (ПараметрыЦентраМониторинга.ВключитьЦентрМониторинга = Истина
		И ПараметрыЦентраМониторинга.ЦентрОбработкиИнформацииОПрограмме = Ложь
		И ПараметрыЦентраМониторинга.Сервер <> "stat.rarus.ru") Тогда 
		// Либо режим не отправка вендору, либо адрес сервера уже обновлен.
		Возврат;
	КонецЕсли;
	
	// 3. Очищаем содержимое регистра "ПакетыДляОтправки" т.к. отправка будет осуществляться на другой сервер.
	РегистрыСведений.ПакетыДляОтправки.Очистить();
	
	// 4. При необходимости (определяется разработчиком) можно очистить остальные регистры подсистемы.
	
	// 5. Установка новых параметров подсистемы.
	ТекДата = ТекущаяУниверсальнаяДата();
	
	ПараметрыЦентраМониторинга = МодульЦентрМониторингаСлужебный.ПолучитьПараметрыПоУмолчаниюВнешнийВызов(); // Уже содержит новый адрес сервера.
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		ПараметрыЦентраМониторинга.БизнесСтатистикаПериодФормирования = 3600;
	КонецЕсли;
	
	ПараметрыЦентраМониторинга.РегистрацияДамповСледующееФормирование = ТекДата + ПараметрыЦентраМониторинга.РегистрацияДамповПериодФормирования;
	ПараметрыЦентраМониторинга.БизнесСтатистикаСледующееФормирование = ТекДата + ПараметрыЦентраМониторинга.БизнесСтатистикаПериодФормирования;
	ПараметрыЦентраМониторинга.СтатистикаКонфигурацииСледующееФормирование = ТекДата + ПараметрыЦентраМониторинга.СтатистикаКонфигурацииПериодФормирования;
	
	ГСЧ = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	ДельтаОтправки = ГСЧ.СлучайноеЧисло(0, 86400);
	ПараметрыЦентраМониторинга.ОтправкаДанныхСледующееФормирование = ТекДата + ДельтаОтправки;
	
	ПараметрыЦентраМониторинга.ПериодАгрегацииМалый = 600;
	ПараметрыЦентраМониторинга.ПериодАгрегации = 3600;
	ПараметрыЦентраМониторинга.ПериодУдаления = 86400;
	
	ПараметрыЦентраМониторинга.ВключитьЦентрМониторинга = Истина;
	
	МодульЦентрМониторингаСлужебный.УстановитьПараметрыЦентраМониторингаВнешнийВызов(ПараметрыЦентраМониторинга);
	
	// 6. Регистрация ИБ на новом сервере.
	// Только для БСП 3.*, т.к. в более ранних отсутствует метод "ОтправитьТестовыйПакет".
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
	ПараметрыПроцедуры = Новый Структура("Итератор, ОтправкаТестовогоПакета, ПолучениеИдентификатора", 0, Ложь, Истина);
	МодульЦентрМониторингаСлужебный.ОтправитьТестовыйПакет(ПараметрыПроцедуры, АдресРезультата);
	
	// 7. Создание и настройка регламентного задания, отвечающего за сбор и отправку статистики.
	СтароеРегЗадание = МодульЦентрМониторингаСлужебный.ПолучитьРегламентноеЗаданиеВнешнийВызов("СборИОтправкаСтатистики", Ложь);
	Если СтароеРегЗадание = Неопределено Тогда 
		// Регл. задание еще не создавалось. Создаем новое.
		РегЗадание = МодульЦентрМониторингаСлужебный.ПолучитьРегламентноеЗаданиеВнешнийВызов("СборИОтправкаСтатистики", Истина);
		МодульЦентрМониторингаСлужебный.УстановитьРасписаниеПоУмолчаниюВнешнийВызов(РегЗадание);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обновить представления номенклатуры характеристики ингредиентов рецептур.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ОбновитьПредставленияНоменклатурыХарактеристикиИнгредиентовРецептур(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептураИнгредиенты.Номенклатура КАК Номенклатура,
	|	питРецептураИнгредиенты.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ втИнгредиенты
	|ИЗ
	|	Документ.питРецептура.Ингредиенты КАК питРецептураИнгредиенты
	|
	|СГРУППИРОВАТЬ ПО
	|	питРецептураИнгредиенты.Номенклатура,
	|	питРецептураИнгредиенты.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Представление КАК Представление
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В
	|			(ВЫБРАТЬ
	|				втИнгредиенты.Номенклатура
	|			ИЗ
	|				втИнгредиенты КАК втИнгредиенты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка,
	|	ХарактеристикиНоменклатуры.Представление КАК Представление
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Ссылка В
	|			(ВЫБРАТЬ
	|				втИнгредиенты.Характеристика
	|			ИЗ
	|				втИнгредиенты КАК втИнгредиенты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питРецептура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питРецептура КАК питРецептура";
	
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	
	ПредставленияНоменклатуры = РезультатЗапросаПакет[1].Выгрузить();
	ПредставленияНоменклатуры.Индексы.Добавить("Ссылка");
	ПредставленияХарактеристик = РезультатЗапросаПакет[2].Выгрузить();
	ПредставленияХарактеристик.Индексы.Добавить("Ссылка");
	СтруктураПоиска = Новый Структура("Ссылка");
	
	ВыборкаРецептуры = РезультатЗапросаПакет[3].Выбрать();
	Пока ВыборкаРецептуры.Следующий() Цикл
		
		Попытка
			ДокОбъект = ВыборкаРецептуры.Ссылка.ПолучитьОбъект();
		Исключение
			Продолжить;
		КонецПопытки;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		
		Для каждого ТекИнгредиент Из ДокОбъект.Ингредиенты Цикл
			Если ПустаяСтрока(ТекИнгредиент.НоменклатураСтрокой) Тогда
				СтруктураПоиска.Ссылка = ТекИнгредиент.Номенклатура;
				НайденныеСтроки = ПредставленияНоменклатуры.НайтиСтроки(СтруктураПоиска);
