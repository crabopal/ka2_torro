// Процедура - Установить флаг специи в рецептурах.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьФлагСпецииВРецептурах(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питРецептура КАК питРецептура
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Исключение
			Возврат;
		КонецПопытки;
		
		Если ДокОбъект.Ингредиенты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВыполненПересчет = Ложь;
		
		Для каждого ТекИнгредиент Из ДокОбъект.Ингредиенты Цикл
			Если НЕ ТекИнгредиент.Специя Тогда
				Продолжить;
			КонецЕсли;
			ВыполненПересчет = Истина;
			ТекИнгредиент.Специя = Ложь;
			ТекИнгредиент.КоличествоУпаковокБрутто = Окр(ТекИнгредиент.КоличествоУпаковокБрутто, 3);
			ТекИнгредиент.КоличествоУпаковокНетто = Окр(ТекИнгредиент.КоличествоУпаковокНетто, 3);
			ТекИнгредиент.КоличествоУпаковокВыход = Окр(ТекИнгредиент.КоличествоУпаковокВыход, 3);
			ТекИнгредиент.КоличествоБрутто	= Окр(ТекИнгредиент.КоличествоУпаковокБрутто * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекИнгредиент.Номенклатура, ТекИнгредиент.Упаковка, КэшированныеЗначения), 3);
			ТекИнгредиент.КоличествоНетто	= Окр(ТекИнгредиент.КоличествоУпаковокНетто * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекИнгредиент.Номенклатура, ТекИнгредиент.Упаковка, КэшированныеЗначения), 3);
			ТекИнгредиент.КоличествоВыход	= Окр(ТекИнгредиент.КоличествоУпаковокВыход * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекИнгредиент.Номенклатура, ТекИнгредиент.Упаковка, КэшированныеЗначения), 3);
		КонецЦикла;
		
		Если НЕ ВыполненПересчет Тогда
			Продолжить; // Ничего не делаем, если ничего не пересчитывали.
		КонецЕсли;
		
		Попытка
			ДокОбъект.Записать();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ТекстОшибки = "Ошибка выполнения процедуры ""УстановитьФлагСпецииВРецептурах"": " + ТекстОшибки;
			Событие = "УстановитьФлагСпецииВРецептурах";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

