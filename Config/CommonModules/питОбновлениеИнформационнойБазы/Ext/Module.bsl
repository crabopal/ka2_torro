	|	втРезультатДок.КоличествоИнгредиентаНорма КАК КоличествоИнгредиентаНорма,
	|	втРезультатДок.ИнгредиентВидНоменклатуры КАК ИнгредиентВидНоменклатуры,
	|	втРезультатДок.Автопередел КАК Автопередел,
	|	втРезультатДок.ИзАвтопеределов КАК ИзАвтопеределов,
	|	втРезультатДок.ИнгредиентИсходный КАК ИнгредиентИсходный,
	|	втРезультатДок.ХарактеристикаИнгредиентаИсходного КАК ХарактеристикаИнгредиентаИсходного,
	|	втРезультатДок.КоличествоИнгредиентаИсходного КАК КоличествоИнгредиентаИсходного,
	|	втРезультатДок.КоличествоНедовложения КАК КоличествоНедовложения,
	|	ВЫБОР
	|		КОГДА втРезультатДок.ИнгредиентВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.питВидыНоменклатуры.Товар)
	|				ИЛИ втРезультатДок.ИнгредиентВидНоменклатуры = ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА втРезультатДок.Автопередел
	|							И НЕ втРезультатДок.ИзАвтопеределов
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ТоварВЗаготовке)
	|					КОГДА НЕ втРезультатДок.Автопередел
	|							И НЕ втРезультатДок.ИзАвтопеределов
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ТоварВБлюде)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ПустаяСсылка)
	|				КОНЕЦ
	|		КОГДА втРезультатДок.ИнгредиентВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.питВидыНоменклатуры.Блюдо)
	|			ТОГДА ВЫБОР
	|					КОГДА втРезультатДок.Автопередел
	|							И НЕ втРезультатДок.ИзАвтопеределов
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ЗаготовкаВЗаготовке)
	|					КОГДА НЕ втРезультатДок.Автопередел
	|							И НЕ втРезультатДок.ИзАвтопеределов
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ЗаготовкаВБлюде)
	|					КОГДА втРезультатДок.Автопередел
	|							И втРезультатДок.ИзАвтопеределов
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ЗаготовкаВЗаготовкеАвтопередел)
	|					КОГДА НЕ втРезультатДок.Автопередел
	|							И втРезультатДок.ИзАвтопеределов
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ЗаготовкаВБлюдеАвтопередел)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ПустаяСсылка)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.питВидыПроизводственногоДвижения.ПустаяСсылка)
	|	КОНЕЦ КАК ВидПроизводственногоДвижения
	|ПОМЕСТИТЬ втРезультатДокСВидомПроизв
	|ИЗ
	|	втРезультатДок КАК втРезультатДок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питПроизводство.Период КАК Период,
	|	питПроизводство.Регистратор КАК Регистратор,
	|	питПроизводство.Блюдо КАК Блюдо,
	|	питПроизводство.Характеристика КАК Характеристика,
	|	питПроизводство.Ингредиент КАК Ингредиент,
	|	питПроизводство.ХарактеристикаИнгредиента КАК ХарактеристикаИнгредиента,
	|	питПроизводство.Склад КАК Склад,
	|	питПроизводство.Организация КАК Организация,
	|	питПроизводство.Рецептура КАК Рецептура,
	|	питПроизводство.Подразделение КАК Подразделение,
	|	питПроизводство.ВидПроизводственногоДвижения КАК ВидПроизводственногоДвижения,
	|	питПроизводство.КоличествоБлюда КАК КоличествоБлюда,
	|	питПроизводство.КоличествоИнгредиента КАК КоличествоИнгредиента,
	|	питПроизводство.Сумма КАК Сумма,
	|	ЕСТЬNULL(втРезультатДокСВидомПроизв.КоличествоИнгредиентаНорма, 0) КАК КоличествоИнгредиентаНорма,
	|	ЕСТЬNULL(втРезультатДокСВидомПроизв.КоличествоИнгредиентаИсходного, 0) КАК КоличествоИнгредиентаИсходного,
	|	ЕСТЬNULL(втРезультатДокСВидомПроизв.КоличествоНедовложения, 0) КАК КоличествоНедовложения,
	|	ЕСТЬNULL(втРезультатДокСВидомПроизв.ИнгредиентИсходный, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК ИнгредиентИсходный,
	|	ЕСТЬNULL(втРезультатДокСВидомПроизв.ХарактеристикаИнгредиентаИсходного, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаИнгредиентаИсходного
	|ИЗ
	|	РегистрНакопления.питПроизводство КАК питПроизводство
	|		ЛЕВОЕ СОЕДИНЕНИЕ втРезультатДокСВидомПроизв КАК втРезультатДокСВидомПроизв
	|		ПО питПроизводство.Период = втРезультатДокСВидомПроизв.Период
	|			И питПроизводство.Регистратор = втРезультатДокСВидомПроизв.Ссылка
	|			И питПроизводство.Блюдо = втРезультатДокСВидомПроизв.Блюдо
	|			И питПроизводство.Характеристика = втРезультатДокСВидомПроизв.Характеристика
	|			И питПроизводство.Ингредиент = втРезультатДокСВидомПроизв.Ингредиент
	|			И питПроизводство.ХарактеристикаИнгредиента = втРезультатДокСВидомПроизв.ХарактеристикаИнгредиента
	|			И питПроизводство.Склад = втРезультатДокСВидомПроизв.Склад
	|			И питПроизводство.Организация = втРезультатДокСВидомПроизв.Организация
	|			И питПроизводство.Рецептура = втРезультатДокСВидомПроизв.Рецептура
	|			И питПроизводство.Подразделение = втРезультатДокСВидомПроизв.Подразделение
	|			И питПроизводство.ВидПроизводственногоДвижения = втРезультатДокСВидомПроизв.ВидПроизводственногоДвижения
	|ИТОГИ ПО
	|	Регистратор";
	
	Запрос.Текст = ТекстЗапроса;	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВерхняя = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВерхняя.Следующий() Цикл
		
		ДвиженияПроизводство = РегистрыНакопления.питПроизводство.СоздатьНаборЗаписей();
		ДвиженияПроизводство.Отбор.Регистратор.Установить(ВыборкаВерхняя.Регистратор);
		ДвиженияПроизводство.Записывать = Истина;
		
		Выборка = ВыборкаВерхняя.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НоваяЗапись = ДвиженияПроизводство.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			
		КонецЦикла;
		
		ДвиженияПроизводство.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

