// Процедура - Выполнить установку наименования в рецептурах.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ВыполнитьУстановкуНаименованияВРецептурах(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептура.Ссылка КАК Ссылка,
	|	питРецептура.Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Документ.питРецептура КАК питРецептура
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Исключение
			Возврат;
		КонецПопытки;
		
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		
		ДокОбъект.Наименование = ВыборкаДетальныеЗаписи.Наименование;
		
		Попытка
			ДокОбъект.Записать();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ТекстОшибки = "Ошибка выполнения процедуры ""ВыполнитьУстановкуНаименованияВРецептурах"": " + ТекстОшибки;
			Событие = "ВыполнитьУстановкуНаименованияВРецептурах";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

