// Процедура - пит при добавлении обработчиков обновления распределение запасов движения.
//
// Параметры:
//  Обработчики - Произвольный - Обработчики.
//
Процедура питПриДобавленииОбработчиковОбновленияЗапасыИПотребности(Обработчики) Экспорт
	
	// УИДы наших обработчиков.
	МассивУИДов = Новый Массив;
	МассивУИДов.Добавить("70957a7f-403f-4139-af8a-6f0d70a06f22");
	МассивУИДов.Добавить("fa6ccc78-1138-4dad-bf80-32767b0ceaff");
	МассивУИДов.Добавить("6b803428-8327-4110-b5b7-b65e09e94fc2");
	МассивУИДов.Добавить("f826e110-eccc-4e4e-ae8d-555c7c943143");
	МассивУИДов.Добавить("775c2f75-bdc7-4c35-9305-20225124d7be");
	МассивУИДов.Добавить("7921ff9e-a793-421f-abaf-a5ac9551931d");
	МассивУИДов.Добавить("8a97142f-359f-4814-a1e3-5bd9ff6abc34");
	МассивУИДов.Добавить("7236c2f8-e63c-4b04-b287-523bd9ab8857");
	МассивУИДов.Добавить("c7eb0241-eb47-4f30-a1eb-54782ccfcaf3");
	МассивУИДов.Добавить("2e5387d7-cf8d-4020-8f36-61458be98234");
	
	МассивУИДовДляОтбора = Новый Массив;
	Для каждого ТекУИДСтрокой Из МассивУИДов Цикл
		МассивУИДовДляОтбора.Добавить(Новый УникальныйИдентификатор(ТекУИДСтрокой));
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбработчикиОбновления.ИмяОбработчика КАК ИмяОбработчика
		|ИЗ
		|	РегистрСведений.ОбработчикиОбновления КАК ОбработчикиОбновления
		|ГДЕ
		|	ОбработчикиОбновления.Идентификатор В (&ИдентификаторыОбработчикаПотребностей)
		|	И ОбработчикиОбновления.Статус <> &Статус
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОбработчикиОбновления.ИмяОбработчика КАК ИмяОбработчика
		|ИЗ
		|	РегистрСведений.ОбработчикиОбновления КАК ОбработчикиОбновления
		|ГДЕ
		|	ОбработчикиОбновления.Идентификатор В (&ИдентификаторТиповогоОбработчика)
		|	И ОбработчикиОбновления.Статус = &Статус";
	Запрос.УстановитьПараметр("ИдентификаторыОбработчикаПотребностей", МассивУИДовДляОтбора);
	Запрос.УстановитьПараметр("ИдентификаторТиповогоОбработчика", Новый УникальныйИдентификатор("8e6273b6-318a-42c9-9233-1a263dc0462a"));
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыОбработчиковОбновления.Выполнен);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат; // Основной обработчик еще не был выполнен
	КонецЕсли;
	// Основной обработчик выполнен, наши обработчики не выполнены, пытаемся выполнить...
	
	ОбработчиковДо = Обработчики.Количество();
	
	ОбработчиковПосле = Обработчики.Количество();
	
	ОбработчиковДобавлено = ОбработчиковПосле - ОбработчиковДо;
	
	Если ОбработчиковДобавлено = 0 Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Перевыполнить обновление новых регистров потребностей.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ПеревыполнитьОбновлениеНовыхРегистровПотребностей(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивОбработчиков = Новый Массив;
	МассивОбработчиков.Добавить("РегистрыНакопления.ЗапасыИПотребности.ОбработатьДанныеДляПереходаНаНовуюВерсию");
	МассивОбработчиков.Добавить("РегистрыСведений.РаспределениеЗапасов.ОбработатьДанныеДляПереходаНаНовуюВерсию");
	питОбновлениеИнформационнойБазы.ЗапуститьВыполнениеОтложенныхОбработчиков(МассивОбработчиков);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

// Процедура - Установить способ автовыбора характеристики в спецификациях.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьСпособАвтовыбораХарактеристикиВСпецификациях(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	питТиповыеДокументы.ТиповойДокумент КАК Ссылка
	|ИЗ
	|	РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК РесурсныеСпецификацииМатериалыИУслуги
	|		ПО питТиповыеДокументы.ТиповойДокумент = РесурсныеСпецификацииМатериалыИУслуги.Ссылка
	|ГДЕ
	|	питТиповыеДокументы.ТиповойДокумент ССЫЛКА Справочник.РесурсныеСпецификации
	|	И РесурсныеСпецификацииМатериалыИУслуги.СпособАвтовыбораХарактеристики = ЗНАЧЕНИЕ(Перечисление.СпособыАвтовыбораХарактеристики.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			СпрОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Исключение
			Возврат;
		КонецПопытки;
		
		Если СпрОбъект.МатериалыИУслуги.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ТекМатериал Из СпрОбъект.МатериалыИУслуги Цикл
			Если НЕ ЗначениеЗаполнено(ТекМатериал.СпособАвтовыбораХарактеристики) Тогда
				ТекМатериал.СпособАвтовыбораХарактеристики = Перечисления.СпособыАвтовыбораХарактеристики.УказываетсяВНСИ;
			КонецЕсли;
		КонецЦикла;
		
		СпрОбъект.ОбменДанными.Загрузка = Истина;
		
		Попытка
			СпрОбъект.Записать();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ТекстОшибки = "Ошибка выполнения процедуры ""УстановитьСпособАвтовыбораХарактеристикиВСпецификациях"": " + ТекстОшибки;
			Событие = "УстановитьСпособАвтовыбораХарактеристикиВСпецификациях";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_на_версию_2_5_9

// Процедура - Исправить код единицы порции с 868 на 1868.
//
// Параметры:
//  ВходныеПараметры - Произвольный - Входные параметры.
//
Процедура ИсправитьКодЕдиницыИзмеренияПорция(ВходныеПараметры = Неопределено) Экспорт
	
	СтарыйКодПорции = "868";
	НовыйКодПорции = "1868";
	СтароеНаименованиеПорции = НСтр("ru='пор'");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка,
	|	КлассификаторЕдиницИзмерения.Наименование КАК Наименование,
	|	КлассификаторЕдиницИзмерения.Код КАК Код
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК КлассификаторЕдиницИзмерения
	|ГДЕ
	|	(КлассификаторЕдиницИзмерения.Код = &СтарыйКодПорции
	|			ИЛИ КлассификаторЕдиницИзмерения.Код = &НовыйКодПорции)
	|	И КлассификаторЕдиницИзмерения.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	Запрос.УстановитьПараметр("СтарыйКодПорции", СтарыйКодПорции);
	Запрос.УстановитьПараметр("НовыйКодПорции", НовыйКодПорции);
	Запрос.Текст = ТекстЗапроса;
	
	ПоСтаромуКодуПорция = Неопределено;
	ПоСтаромуКодуДругаяЕИ = Неопределено;
	ПоНовомуКодуПорция = Неопределено;
	ПоНовомуКодуДругаяЕИ = Неопределено;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтоПорция = СтрНайти(Выборка.Наименование, СтароеНаименованиеПорции) > 0;
		
		Если СокрЛП(Выборка.Код) = СтарыйКодПорции
			И НЕ ЭтоПорция Тогда
			ПоСтаромуКодуДругаяЕИ = Выборка.Ссылка;
		ИначеЕсли СокрЛП(Выборка.Код) = СтарыйКодПорции
			И ЭтоПорция Тогда
			ПоСтаромуКодуПорция = Выборка.Ссылка;
		ИначеЕсли СокрЛП(Выборка.Код) = НовыйКодПорции
			И НЕ ЭтоПорция Тогда
			ПоНовомуКодуДругаяЕИ = Выборка.Ссылка;
		ИначеЕсли СокрЛП(Выборка.Код) = НовыйКодПорции
			И ЭтоПорция Тогда
			ПоНовомуКодуПорция = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ПоНовомуКодуПорция) 
		И НЕ ЗначениеЗаполнено(ПоСтаромуКодуПорция) Тогда
		// Ситуация, когда порции нет ни по старому коду ни по новому, смысла что-то делать нет.
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПоНовомуКодуПорция) Тогда
		Возврат;
	КонецЕсли;
	
	// Если новый код занят, то сместим его перед остальной математикой.
	Если ЗначениеЗаполнено(ПоНовомуКодуДругаяЕИ) Тогда
		
		СпрОбъектДругаяЕИПоНовомуКоду = ПоНовомуКодуДругаяЕИ.ПолучитьОбъект();
		СпрОбъектДругаяЕИПоНовомуКоду.УстановитьНовыйКод();
		Попытка
			СпрОбъектДругаяЕИПоНовомуКоду.Записать();
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Событие = "ОбщепитОбновлениеИнформационнойБазы";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
	// Если по старому коду не порция, то скопируем его.
	Если ЗначениеЗаполнено(ПоСтаромуКодуДругаяЕИ) Тогда
		СпрОбъектДругаяЕИПоСтаромуКоду = ПоСтаромуКодуДругаяЕИ.Скопировать();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПоСтаромуКодуПорция) Тогда
		СпрОбъектПорция = ПоСтаромуКодуПорция.ПолучитьОбъект();
	ИначеЕсли ЗначениеЗаполнено(ПоСтаромуКодуДругаяЕИ) Тогда
		СпрОбъектПорция = ПоСтаромуКодуДругаяЕИ.ПолучитьОбъект();
	Иначе
		СпрОбъектПорция = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	КонецЕсли;
	
	СпрОбъектПорция.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
	СпрОбъектПорция.Код = НовыйКодПорции;
	СпрОбъектПорция.Наименование = НСтр("ru='порц'");
	СпрОбъектПорция.НаименованиеПолное = НСтр("ru='Порция'");
	СпрОбъектПорция.МеждународноеСокращение = "";
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СпрОбъектПорция, "ТипИзмеряемойВеличины") Тогда
		СпрОбъектПорция.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук;
	КонецЕсли;
	
	Попытка
		СпрОбъектПорция.Записать();
		// Если по старому коду не порция, то скопированному объекту установим старый код и запишем.
		Если ЗначениеЗаполнено(ПоСтаромуКодуДругаяЕИ) Тогда
			СпрОбъектДругаяЕИПоСтаромуКоду.Код = СтарыйКодПорции;
			СпрОбъектДругаяЕИПоСтаромуКоду.Записать();
		КонецЕсли;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = "ОбщепитОбновлениеИнформационнойБазы";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_на_версию_2_5_15

// Процедура - заполнить новый реквизит справочника места печати.
//
// Параметры:
//  ВходныеПараметры - Произвольный - Входные параметры.
//
Процедура ЗаполнениеРеквизитаВидаМестаВМестахПечати(ВходныеПараметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
