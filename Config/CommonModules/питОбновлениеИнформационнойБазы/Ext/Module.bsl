////////////////////////////////////////////////////////////////////////////////
// Обработчики обновления информационной базы.

// Добавляет в список процедуры-обработчики обновления данных ИБ
//  для всех поддерживаемых версий библиотеки или конфигурации.
//  Вызывается перед началом обновления данных ИБ для построения плана обновления.
//  Обработчики - ТаблицаЗначений - описание полей, см. в процедуре
//  ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления.
//  Пример добавления процедуры-обработчика в список:
//  Обработчик = Обработчики.Добавить();
//  Обработчик.Версия              = "1.1.0.0";
//  Обработчик.Процедура           = "ОбновлениеИБ.ПерейтиНаВерсию_1_1_0_0";
//  Обработчик.РежимВыполнения     = "Монопольно";
//
// Параметры:
//  Обработчики - ТаблицаЗначений - описание полей, см. в процедуре
//   ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления.
//   Пример добавления процедуры-обработчика в список:
//   Обработчик = Обработчики.Добавить();
//   Обработчик.Версия              = "1.1.0.0";
//   Обработчик.Процедура           = "ОбновлениеИБ.ПерейтиНаВерсию_1_1_0_0";
//   Обработчик.РежимВыполнения     = "Монопольно";
//   Параметры.
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	#Область Обработчики_документов_общепит_многопоточные
	
	Документы.питВыпускБлюд.ПриДобавленииОбработчиковОбновления(Обработчики);
	Документы.питПланМеню.ПриДобавленииОбработчиковОбновления(Обработчики);
	Документы.питДанныеПродажФронта.ПриДобавленииОбработчиковОбновления(Обработчики);
	Документы.питРецептура.ПриДобавленииОбработчиковОбновления(Обработчики);
	Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства.ПриДобавленииОбработчиковОбновления(Обработчики);
	
	#КонецОбласти
	
	#Область Обработчики_выполняемые_при_каждом_обновлении_ИБ
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.ОбщиеДанные = Истина;
	Обработчик.Процедура = "питОбновлениеИнформационнойБазы.ОбновитьИдентификаторыОбъектовМетаданных";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.ОбщиеДанные = Истина;
	Обработчик.Процедура = "питОбновлениеИнформационнойБазы.СоздатьОбновитьДополнительныеРеквизиты";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.ОбщиеДанные = Истина;
	Обработчик.Процедура = "питОбщегоНазначенияHACCP.УстановитьПредопределенныеЭлементыХасп";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.ОбщиеДанные = Истина;
	Обработчик.Процедура = "питОбновлениеИнформационнойБазы.СозданиеЗаполнениеПричинОтменИСписаний";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.ОбщиеДанные = Истина;
	Обработчик.Процедура = "питОбновлениеИнформационнойБазы.СозданиеЗаполнениеРолейПользователейФронта";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.ОбщиеДанные = Истина;
	Обработчик.Процедура = "питОбновлениеИнформационнойБазы.СозданиеЗаполнениеПрочихПредопределенных";
	
	ПодготовитьОбработчикиЗаполненияПредопределенныхЭлементов(Обработчики);
	
