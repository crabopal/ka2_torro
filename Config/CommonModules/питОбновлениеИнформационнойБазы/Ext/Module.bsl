#Область Обновление_на_версию_2_2_3

// Процедура - Установить подразделения производства в рецептуре.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьПодразделенияПроизводстваВРецептуре(Параметры = Неопределено) Экспорт
	
	// +РазрешенныеПодразделения
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питРецептура.Ссылка
		|ИЗ
		|	Документ.питРецептура КАК питРецептура";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			РецептураОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			НайденныеПодразделения = РецептураОбъект.РазрешенныеПодразделения.НайтиСтроки(Новый Структура("Подразделение", РецептураОбъект.Подразделение));
			ПодразделениеЦехНайдено = Ложь;
			Для каждого ТекНайденноеПодразделение Из НайденныеПодразделения Цикл
				Если ТекНайденноеПодразделение.ЦеховаяКладовая = Справочники.Склады.ПустаяСсылка() 
					ИЛИ ТекНайденноеПодразделение.ЦеховаяКладовая = РецептураОбъект.ЦеховаяКладовая Тогда
					ПодразделениеЦехНайдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ПодразделениеЦехНайдено Тогда
				НовПодразделение = РецептураОбъект.РазрешенныеПодразделения.Добавить();
				НовПодразделение.Подразделение		= РецептураОбъект.Подразделение;
				НовПодразделение.ЦеховаяКладовая	= РецептураОбъект.ЦеховаяКладовая;
				НовПодразделение.ВключаяПодчиненные	= Ложь;
			КонецЕсли;
			
			// Запись объекта в базу, параметр "Включить бизнес логику" - Ложь.
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(РецептураОбъект);
			
		КонецЦикла;
	КонецЕсли;
	// -РазрешенныеПодразделения
	
КонецПроцедуры

// Процедура - Установить причину типовых документов.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьПричинуТиповыхДокументов(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питТиповыеДокументы.ДокументОбщепит,
	|	питТиповыеДокументы.ТиповойДокумент,
	|	питТиповыеДокументы.Синхронизирован,
	|	питТиповыеДокументы.ПричинаТиповогоДокумента
	|ПОМЕСТИТЬ втТиповыеДокументы
	|ИЗ
	|	РегистрСведений.питТиповыеДокументы КАК питТиповыеДокументы
	|ГДЕ
	|	питТиповыеДокументы.ТиповойДокумент ССЫЛКА Документ.ДвижениеПродукцииИМатериалов
	|	И питТиповыеДокументы.ПричинаТиповогоДокумента = 0
	|	И питТиповыеДокументы.ДокументОбщепит ССЫЛКА Документ.питВыпускБлюд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТиповыеДокументы.ДокументОбщепит,
	|	втТиповыеДокументы.ТиповойДокумент,
	|	втТиповыеДокументы.Синхронизирован,
	|	втТиповыеДокументы.ПричинаТиповогоДокумента,
	|	питВыпускБлюд.Склад КАК СкладВыпуска,
	|	ДвижениеПродукцииИМатериалов.Получатель КАК СкладПолучатель
	|ИЗ
	|	втТиповыеДокументы КАК втТиповыеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд КАК питВыпускБлюд
	|		ПО втТиповыеДокументы.ДокументОбщепит = питВыпускБлюд.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ДвижениеПродукцииИМатериалов КАК ДвижениеПродукцииИМатериалов
	|		ПО втТиповыеДокументы.ТиповойДокумент = ДвижениеПродукцииИМатериалов.Ссылка
	|ГДЕ
	|	ДвижениеПродукцииИМатериалов.Получатель <> питВыпускБлюд.Склад";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			// Случай, когда документ создан для выпуска с розничной реализацией
			МенеджерЗаписи = РегистрыСведений.питТиповыеДокументы.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
			МенеджерЗаписи.ПричинаТиповогоДокумента = 1; 
			МенеджерЗаписи.Записать();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_на_версию_2_4_1

// Процедура - Заполнить регистр актуальные рецептуры.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ЗаполнитьРегистрАктуальныеРецептуры(Параметры = Неопределено) Экспорт
	
	ТекстСообщения = "";
	
	РазрешенныеПодразделения = Новый ТаблицаЗначений;
	РазрешенныеПодразделения.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	РазрешенныеПодразделения.Колонки.Добавить("ВключаяПодчиненные", Новый ОписаниеТипов("Булево"));
	
	РеквизитыШапки = Новый Структура("Рецептура, Номенклатура, Характеристика, Организация, Период, ДатаОкончания");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептура.Ссылка КАК Рецептура,
	|	питРецептура.Номенклатура КАК Номенклатура,
	|	питРецептура.Характеристика КАК Характеристика,
	|	питРецептура.Организация КАК Организация,
	|	питРецептура.ДатаНачала КАК Период,
	|	питРецептура.ДатаКонца КАК ДатаОкончания,
	|	питРецептураРазрешенныеПодразделения.Подразделение КАК Подразделение,
	|	питРецептураРазрешенныеПодразделения.ВключаяПодчиненные КАК ВключаяПодчиненные
	|ИЗ
	|	Документ.питРецептура.РазрешенныеПодразделения КАК питРецептураРазрешенныеПодразделения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питРецептура КАК питРецептура
	|		ПО питРецептураРазрешенныеПодразделения.Ссылка = питРецептура.Ссылка
	|ГДЕ
	|	питРецептура.ПометкаУдаления = ЛОЖЬ
	|ИТОГИ ПО
	|	Рецептура";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаРецептуры = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаРецептуры.Следующий() Цикл
			
			ВыборкаДетальныеЗаписи = ВыборкаРецептуры.Выбрать();
			
			Счетчик = 0;
			РазрешенныеПодразделения.Очистить();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НовСтрока = РазрешенныеПодразделения.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, ВыборкаДетальныеЗаписи);
				
				Если Счетчик = 0 Тогда
					ЗаполнитьЗначенияСвойств(РеквизитыШапки, ВыборкаДетальныеЗаписи);
				КонецЕсли;
				Счетчик = Счетчик + 1;
			КонецЦикла;
			
			ТекПодразделения = питПроизводство.НайтиПодразделенияПоРазрешенным(РазрешенныеПодразделения);
			Для каждого ТекПодразделение Из ТекПодразделения Цикл
				
				МенеджерДобавить = РегистрыСведений.питАктуальныеРецептуры.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МенеджерДобавить,РеквизитыШапки);
				МенеджерДобавить.Подразделение			= ТекПодразделение;
				
				Попытка
					МенеджерДобавить.Записать(Ложь);
				Исключение
					ТекстСообщения = "
					|Не удалось записать рецептуру с параметрами:
					| - Дата начала:	<"+РеквизитыШапки.Период+">
					| - Номенклатура:	<"+РеквизитыШапки.Номенклатура+">
					| - Характеристика:	<"+РеквизитыШапки.Характеристика+">
					| - Организация:	<"+РеквизитыШапки.Организация+"> 
					| - Подразделение:	<"+ТекПодразделение+">!
					|"+ОписаниеОшибки();
					питОбщегоНазначенияСервер.ЗаписатьОшибкуВЖурналРегистрации(ТекстСообщения);
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Обновление_на_версию_2_4_5

// Процедура - Выполнить перепроведение документов чек общепита.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ВыполнитьПерепроведениеДокументовЧекОбщепита(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПроводитьДокументы = Константы.питВыполнятьПроведениеЧековОбщепита.Получить();
	Если НЕ ПроводитьДокументы = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	питДанныеПродажФронта.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питДанныеПродажФронта КАК питДанныеПродажФронта
	|ГДЕ
	|	НЕ питДанныеПродажФронта.ПометкаУдаления
	|	И питДанныеПродажФронта.Проведен";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Попытка
				ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ИнфОбОшибке.Описание;
				Пока ИнфОбОшибке.Причина <> Неопределено Цикл
					ИнфОбОшибке = ИнфОбОшибке.Причина;
					ТекстОшибки = ТекстОшибки + "
					|" + ИнфОбОшибке.Описание;
				КонецЦикла;
				ТекстОшибки = "Ошибка выполнения процедуры ""ВыполнитьПерепроведениеДокументовЧекОбщепита"": " + ТекстОшибки;
				Событие = "ПроведениеЧековОбщепита";
				ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Процедура - Выполнить пересчет базового количества в рецептурах.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ВыполнитьПересчетБазовогоКоличестваВРецептурах(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питРецептура КАК питРецептура
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Исключение
			Возврат;
		КонецПопытки;
		
		Если ДокОбъект.Ингредиенты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ТекИнгредиент Из ДокОбъект.Ингредиенты Цикл
			ТекИнгредиент.КоличествоБрутто	= ТекИнгредиент.КоличествоУпаковокБрутто * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекИнгредиент.Номенклатура, ТекИнгредиент.Упаковка, КэшированныеЗначения);
			ТекИнгредиент.КоличествоНетто	= ТекИнгредиент.КоличествоУпаковокНетто * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекИнгредиент.Номенклатура, ТекИнгредиент.Упаковка, КэшированныеЗначения);
			ТекИнгредиент.КоличествоВыход	= ТекИнгредиент.КоличествоУпаковокВыход * питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекИнгредиент.Номенклатура, ТекИнгредиент.Упаковка, КэшированныеЗначения);
		КонецЦикла;
		
		Попытка
			ДокОбъект.Записать();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ТекстОшибки = "Ошибка выполнения процедуры ""ВыполнитьПересчетБазовогоКоличестваВРецептурах"": " + ТекстОшибки;
			Событие = "ВыполнитьПересчетБазовогоКоличестваВРецептурах";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Процедура - Установить виды номенклатуры общепит.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьВидыНоменклатурыОбщепит(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	НЕ ВидыНоменклатуры.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ВидыНомМенеджер = РегистрыСведений.питВидыНоменклатурыОбщепит.СоздатьМенеджерЗаписи();
		ВидыНомМенеджер.ВидНоменклатуры = ВыборкаДетальныеЗаписи.Ссылка;
		ВидыНомМенеджер.ВидимостьКоманд = Истина;
		
		Попытка
			ВидыНомМенеджер.Записать();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ТекстОшибки = "Ошибка выполнения процедуры ""УстановитьВидыНоменклатурыОбщепит"": " + ТекстОшибки;
			Событие = "УстановитьВидыНоменклатурыОбщепит";
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Процедура - Установить режим корректировки количества.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьРежимКорректировкиКоличества(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Константы.питРежимКорректировкиКоличестваВИнвентаризации.Установить(Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличество);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Процедура - Заполнить новые ресурсы количества в выпусках блюд.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ЗаполнитьНовыеРесурсыКоличестваВВыпускахБлюд(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	питВыпускБлюдБлюда.Номенклатура КАК Блюдо,
	|	питВыпускБлюдБлюда.Характеристика КАК Характеристика,
	|	питВыпускБлюдИнгредиенты.Ингредиент КАК Ингредиент,
	|	питВыпускБлюдИнгредиенты.Характеристика КАК ХарактеристикаИнгредиента,
	|	ВЫБОР
	|		КОГДА питВыпускБлюдИнгредиенты.УпаковкаИнгредиента = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА питВыпускБлюдИнгредиенты.Ингредиент.ЕдиницаИзмерения
	|		ИНАЧЕ питВыпускБлюдИнгредиенты.УпаковкаИнгредиента
	|	КОНЕЦ КАК УпаковкаИнгредиента,
	|	питВыпускБлюдБлюда.Ссылка.Дата КАК Период,
	|	питВыпускБлюдБлюда.Ссылка.Склад КАК Склад,
	|	питВыпускБлюдБлюда.Ссылка.Организация КАК Организация,
	|	питВыпускБлюдБлюда.Рецептура КАК Рецептура,
	|	питВыпускБлюдБлюда.Ссылка.Подразделение КАК Подразделение,
	|	питВыпускБлюдБлюда.КоличествоНоменклатуры КАК КоличествоБлюда,
	|	питВыпускБлюдИнгредиенты.КоличествоИнгредиентаФакт КАК КоличествоИнгредиента,
	|	питВыпускБлюдИнгредиенты.КоличествоИнгредиентаНорма - питВыпускБлюдИнгредиенты.КоличествоИнгредиентаФакт КАК КоличествоНедовложения,
	|	питВыпускБлюдИнгредиенты.КоличествоУпаковокИнгредиентаФакт КАК КоличествоУпаковокИнгредиента,
	|	питВыпускБлюдИнгредиенты.Ингредиент.питВидНоменклатуры КАК ИнгредиентВидНоменклатуры,
	|	питВыпускБлюдИнгредиенты.КоличествоИнгредиентаНорма КАК КоличествоИнгредиентаНорма,
	|	питВыпускБлюдБлюда.Автопередел КАК Автопередел,
	|	питВыпускБлюдИнгредиенты.ИзАвтопеределов КАК ИзАвтопеределов,
	|	питВыпускБлюдБлюда.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ПроизводствоИнгр
	|ИЗ
	|	Документ.питВыпускБлюд.Блюда КАК питВыпускБлюдБлюда
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд.Ингредиенты КАК питВыпускБлюдИнгредиенты
	|		ПО питВыпускБлюдБлюда.ИдентификаторСтроки = питВыпускБлюдИнгредиенты.ИдентификаторБлюда
	|			И питВыпускБлюдБлюда.Ссылка = питВыпускБлюдИнгредиенты.Ссылка
	|ГДЕ
	|	питВыпускБлюдБлюда.Ссылка.Проведен
	|	И питВыпускБлюдИнгредиенты.Ссылка.Проведен
	|;
	|
