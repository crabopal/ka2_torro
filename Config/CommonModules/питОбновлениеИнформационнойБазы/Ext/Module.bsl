// Процедура - Создать обновить дополнительные реквизиты.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура СоздатьОбновитьДополнительныеРеквизиты(Параметры = Неопределено) Экспорт
	
	Набор = питОбщегоНазначенияСервер.НаборДополнительныхРеквизитовПоИмени("Документ_питРецептура");
	Если Набор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитСсылка = питОбщегоНазначенияСервер.ДополнительныйРеквизитПоИмени("питПодразделениеПроизводства");
	Если РеквизитСсылка = Неопределено Тогда
		РеквизитОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	Иначе
		РеквизитОбъект = РеквизитСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	НаборСвойств       = Набор;
	Наименование       = "Подразделение производства";
	
	РеквизитОбъект.Имя			= "питПодразделениеПроизводства";
	РеквизитОбъект.НаборСвойств = НаборСвойств;
	РеквизитОбъект.Доступен     = Истина;
	РеквизитОбъект.Наименование = Наименование;
	РеквизитОбъект.Заголовок    = Наименование;
	РеквизитОбъект.ТипЗначения  = Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия");
	
	Попытка
		РеквизитОбъект.Записать();
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""СоздатьОбновитьДополнительныеРеквизиты"": " + ТекстОшибки;
		Событие = "СоздатьОбновитьДополнительныеРеквизиты";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	НаборОбъект = Набор.ПолучитьОбъект();
	НайденныеРеквизиты = НаборОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", РеквизитОбъект.Ссылка));
	Если НЕ НайденныеРеквизиты.Количество() Тогда
		НовРеквизитНабора = НаборОбъект.ДополнительныеРеквизиты.Добавить();
		НовРеквизитНабора.Свойство = РеквизитОбъект.Ссылка;
		
		Попытка
			НаборОбъект.Записать();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
