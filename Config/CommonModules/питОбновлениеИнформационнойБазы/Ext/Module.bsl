// Процедура выполняет первоначальное заполнение
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ПервоначальноеЗаполнениеИБ(Параметры = Неопределено) Экспорт
	
	// Заполнение констант по умолчанию.
	Константы.питИспользоватьВидыОбработкиСырья.Установить(Ложь);
	Константы.питНеИзменятьРежимСписанияВПроизводствоПоНастройке.Установить(Истина);
	Константы.питРежимРасчетаСписанияВПроизводство.Установить(Перечисления.питРежимыРасчетаСписанияВПроизводство.ПоНорме);
	Константы.питИскатьРецептурыПоВсемОрганизациям.Установить(Ложь);
	Константы.питНеИспользоватьСезонныеПроценты.Установить(Ложь);
	Константы.питСпособРасчетаРецептур.Установить(Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре);
	Константы.питСпособРасчетаКоличестваХЭХ.Установить(Перечисления.питСпособыРасчетаКоличестваХЭХ.ПоКоличествуВыход);
	Константы.питФормулаРасчетаКалорийности.Установить("4 * [Белки] + 9 * [Жиры] + 4 * [Углеводы] + 7 * [Алкоголь]");
	Константы.питФормироватьТиповыеДокументыПриЗаписиДокументапит.Установить(Истина);
	Константы.питФормироватьДокументыПроизводства22.Установить(Истина);
	Константы.питФормироватьСпецификацииПоРецептурам.Установить(Истина);
	Константы.питФормироватьОприходованиеИзлишковПоВыпускуБлюд.Установить(Ложь);
	Константы.питПодразделениеПроизводстваПолуфабрикатов.Установить(Перечисления.питПодразделенияПроизводстваПолуфабрикатов.ПодразделениеВыпускаБлюд);
	Константы.питОрганизацияПеремещенияДляРеализации.Установить(Перечисления.питОрганизацииПеремещенияДляРеализации.ОрганизацияПроизводства);
	Константы.питСписаниеМарокИСПриПроизводстве.Установить(Перечисления.питСпособыСписанияМарокИСПриПроизводстве.НеИспользовать);
	
	ЕдиницыИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора("161", Истина);
	Грамм = ЕдиницыИзмерения.Получить("161");
	Если НЕ Грамм = Неопределено Тогда
		Константы.питЕдиницаИзмеренияПоКлассификаторуДляХЭХ.Установить(Грамм);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Создание заполнение ролей пользователей фронта.
