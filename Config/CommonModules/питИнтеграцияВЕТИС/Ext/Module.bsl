
#Область ПрограммныйИнтерфейс

#Область ПроизводственнаяОперацияВЕТИС

// %ИзЕРП%
//  ИнтеграцияВЕТИСУТ.СтруктураЗапросаДанныеДокументаПроизводствоБезЗаказа()
//
// Параметры:
//  СтруктураЗапроса - Структура - Структура запроса.
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
//
Функция СтруктураЗапросаДанныеДокументаОбщепит(СтруктураЗапроса, ДанныеЗаполнения) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питВыпускБлюд") Тогда
		
		СтруктураЗапроса = Новый Структура();
		
		// +питКА
		Если питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "УправлениеПредприятием" Тогда
		// -питКА
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	МИНИМУМ(
			|		ВЫБОР
			|			КОГДА НазначенияДавальца.Договор.Контрагент ЕСТЬ НЕ NULL
			|				ТОГДА НазначенияДавальца.Договор.Контрагент
			//++ НЕ УТКА
			|			ИНАЧЕ ВЫБОР
			//++ Устарело_Переработка24
			|				КОГДА НазначенияДавальца.Заказ ЕСТЬ НЕ NULL
			|					И ТИПЗНАЧЕНИЯ(НазначенияДавальца.Заказ) = ТИП(Документ.ЗаказДавальца)
			|					ТОГДА ВЫРАЗИТЬ(НазначенияДавальца.Заказ КАК Документ.ЗаказДавальца).Контрагент
			//-- Устарело_Переработка24
			|				КОГДА НазначенияДавальца.Заказ ЕСТЬ НЕ NULL
			|					И ТИПЗНАЧЕНИЯ(НазначенияДавальца.Заказ) = ТИП(Документ.ЗаказДавальца2_5)
			|					ТОГДА ВЫРАЗИТЬ(НазначенияДавальца.Заказ КАК Документ.ЗаказДавальца2_5).Контрагент
			//-- НЕ УТКА
			|				КОГДА ИСТИНА
			|					ТОГДА Товары.Ссылка.Организация
			//++ НЕ УТКА
			|			КОНЕЦ
			//-- НЕ УТКА
			|		КОНЕЦ) КАК ОрганизацияКонтрагент
			|ПОМЕСТИТЬ ОсновнаяОрганизацияКонтрагент
			|ИЗ
			|	Документ.питВыпускБлюд.Блюда КАК Товары
			|	
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК НазначенияДавальца
			|	ПО Товары.Назначение = НазначенияДавальца.Ссылка
			|	И НазначенияДавальца.ТипНазначения В (
			//++ Устарело_Переработка24
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.ДавальческоеПродукция22),
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.ДавальческоеМатериалы22),
			//-- Устарело_Переработка24
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.ДавальческоеМатериалыПодЭтап22),
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.Давальческое2_5))
			|ГДЕ
			|	Товары.Ссылка = &ДокументОснование
			|
			|ИМЕЮЩИЕ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ
			|		ВЫБОР
			|			КОГДА НазначенияДавальца.Договор.Контрагент ЕСТЬ НЕ NULL
			|				ТОГДА НазначенияДавальца.Договор.Контрагент
			//++ НЕ УТКА
			|			ИНАЧЕ ВЫБОР
			//++ Устарело_Переработка24
			|				КОГДА НазначенияДавальца.Заказ ЕСТЬ НЕ NULL
			|					И ТИПЗНАЧЕНИЯ(НазначенияДавальца.Заказ) = ТИП(Документ.ЗаказДавальца)
			|					ТОГДА ВЫРАЗИТЬ(НазначенияДавальца.Заказ КАК Документ.ЗаказДавальца).Контрагент
			//-- Устарело_Переработка24
			|				КОГДА НазначенияДавальца.Заказ ЕСТЬ НЕ NULL
			|					И ТИПЗНАЧЕНИЯ(НазначенияДавальца.Заказ) = ТИП(Документ.ЗаказДавальца2_5)
			|					ТОГДА ВЫРАЗИТЬ(НазначенияДавальца.Заказ КАК Документ.ЗаказДавальца2_5).Контрагент
			//-- НЕ УТКА
			|				КОГДА ИСТИНА
			|					ТОГДА Товары.Ссылка.Организация
			//++ НЕ УТКА
			|			КОНЕЦ
			//-- НЕ УТКА
			|		КОНЕЦ) = 1
			|;";
		// +питКА
		Иначе
			// В КА нет документа ЗаказДавальца и ЗаказДавальца2_5
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	МИНИМУМ(
			|		ВЫБОР
			|			КОГДА НазначенияДавальца.Договор.Контрагент ЕСТЬ НЕ NULL
			|				ТОГДА НазначенияДавальца.Договор.Контрагент
			|				КОГДА ИСТИНА
			|					ТОГДА Товары.Ссылка.Организация
			|		КОНЕЦ) КАК ОрганизацияКонтрагент
			|ПОМЕСТИТЬ ОсновнаяОрганизацияКонтрагент
			|ИЗ
			|	Документ.питВыпускБлюд.Блюда КАК Товары
			|	
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Назначения КАК НазначенияДавальца
			|	ПО Товары.Назначение = НазначенияДавальца.Ссылка
			|	И НазначенияДавальца.ТипНазначения В (
			//++ Устарело_Переработка24
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.ДавальческоеПродукция22),
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.ДавальческоеМатериалы22),
			//-- Устарело_Переработка24
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.ДавальческоеМатериалыПодЭтап22),
			|			ЗНАЧЕНИЕ(Перечисление.ТипыНазначений.Давальческое2_5))
			|ГДЕ
			|	Товары.Ссылка = &ДокументОснование
			|
			|ИМЕЮЩИЕ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ
			|		ВЫБОР
			|			КОГДА НазначенияДавальца.Договор.Контрагент ЕСТЬ НЕ NULL
			|				ТОГДА НазначенияДавальца.Договор.Контрагент
			|				КОГДА ИСТИНА
			|					ТОГДА Товары.Ссылка.Организация
			|		КОНЕЦ) = 1
			|;";
		КонецЕсли;
		// -питКА
		ТекстЗапроса = ТекстЗапроса +
		"
		|
		|ВЫБРАТЬ
		|	Таблица.Ссылка КАК ДокументОснование,
		|
		|	ВЫБОР
		|		КОГДА ОсновнаяОрганизацияКонтрагент.ОрганизацияКонтрагент ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|		ИНАЧЕ ОсновнаяОрганизацияКонтрагент.ОрганизацияКонтрагент
		|	КОНЕЦ КАК ОрганизацияКонтрагент,
		|	Таблица.Подразделение КАК ТорговыйПроизводственныйОбъект,
		|
		|	НАЧАЛОПЕРИОДА(Таблица.Дата, ДЕНЬ) КАК ДатаОперацииНачалоПериода,
		|	КОНЕЦПЕРИОДА(Таблица.Дата, ДЕНЬ) КАК ДатаОперацииКонецПериода,
		|
		|	"""" КАК ИдентификаторПроизводственнойТранзакции,
		|	ЛОЖЬ КАК ЗавершениеПроизводственнойТранзакции,
		|	(НЕ Таблица.Проведен) КАК ЕстьОшибкиПроведен
		|
		|ИЗ
		|	Документ.питВыпускБлюд КАК Таблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОсновнаяОрганизацияКонтрагент КАК ОсновнаяОрганизацияКонтрагент
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Таблица.Ссылка = &ДокументОснование
		|";
		СтруктураЗапроса.Вставить("Реквизиты", ТекстЗапроса);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика КАК Характеристика,
		|	ТабличнаяЧасть.Серия КАК Серия,
		|	ВЫБОР
		|		КОГДА ISNULL(ТабличнаяЧасть.Серия.ДатаПроизводства, ДАТАВРЕМЯ(1,1,1)) <> ДАТАВРЕМЯ(1,1,1) ТОГДА
		|			ТабличнаяЧасть.Серия.ДатаПроизводства
		|	ИНАЧЕ
		|		НАЧАЛОПЕРИОДА(ТабличнаяЧасть.Ссылка.Дата, ДЕНЬ)
		|	КОНЕЦ                                                      КАК ДатаПроизводства,
		|	ТабличнаяЧасть.КоличествоНоменклатуры                      КАК Количество
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	Документ.питВыпускБлюд.Блюда КАК ТабличнаяЧасть
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО ТабличнаяЧасть.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд.БлюдаСерии КАК ТаблицаСерии
		|		ПО ТаблицаСерии.Ссылка              = ТабличнаяЧасть.Ссылка
		|			И ТаблицаСерии.Номенклатура      = ТабличнаяЧасть.Номенклатура
		|			И ТаблицаСерии.Характеристика    = ТабличнаяЧасть.Характеристика
		|			И ТаблицаСерии.Назначение        = ТабличнаяЧасть.Назначение
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &ДокументОснование
		|	И ТабличнаяЧасть.Автопередел = ЛОЖЬ
		|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииВЕТИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|	И ТаблицаСерии.Номенклатура ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТабличнаяЧасть.Номенклатура                                КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика                              КАК Характеристика,
		|	ТабличнаяЧасть.Серия                                       КАК Серия,
		|	ВЫБОР
		|		КОГДА ISNULL(ТабличнаяЧасть.Серия.ДатаПроизводства, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА
		|			ТабличнаяЧасть.Серия.ДатаПроизводства
		|	ИНАЧЕ
		|		НАЧАЛОПЕРИОДА(ТабличнаяЧасть.Ссылка.Дата, ДЕНЬ)
		|	КОНЕЦ                                                      КАК ДатаПроизводства,
		|	ТабличнаяЧасть.Количество                                  КАК Количество
		|ИЗ
		|	Документ.питВыпускБлюд.БлюдаСерии КАК ТабличнаяЧасть
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО ТабличнаяЧасть.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &ДокументОснование
		|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииВЕТИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТабличнаяЧасть.Номенклатура                                КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика                              КАК Характеристика,
		|	ТабличнаяЧасть.Серия                                       КАК Серия,
		|	ВЫБОР
		|		КОГДА ISNULL(ТабличнаяЧасть.Серия.ДатаПроизводства, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА
		|			ТабличнаяЧасть.Серия.ДатаПроизводства
		|	ИНАЧЕ
		|		НАЧАЛОПЕРИОДА(ТабличнаяЧасть.Ссылка.Дата, ДЕНЬ)
		|	КОНЕЦ                                                      КАК ДатаПроизводства,
		|	ТабличнаяЧасть.Количество                                  КАК Количество
		|ИЗ
		|	Документ.питВыпускБлюд.ПобочныеИзделия КАК ТабличнаяЧасть
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО ТабличнаяЧасть.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питВыпускБлюд.ПобочныеИзделияСерии КАК ТаблицаСерии
		|		 ПО ТаблицаСерии.Ссылка              = ТабличнаяЧасть.Ссылка
		|			И ТаблицаСерии.Номенклатура      = ТабличнаяЧасть.Номенклатура
		|			И ТаблицаСерии.Характеристика    = ТабличнаяЧасть.Характеристика
		|			И ТаблицаСерии.Назначение        = ТабличнаяЧасть.Назначение
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &ДокументОснование
		|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииВЕТИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|	И ТаблицаСерии.Номенклатура ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТабличнаяЧасть.Номенклатура                                КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика                              КАК Характеристика,
		|	ТабличнаяЧасть.Серия                                       КАК Серия,
		|	ВЫБОР
		|		КОГДА ISNULL(ТабличнаяЧасть.Серия.ДатаПроизводства, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1) ТОГДА
		|			ТабличнаяЧасть.Серия.ДатаПроизводства
		|	ИНАЧЕ
		|		НАЧАЛОПЕРИОДА(ТабличнаяЧасть.Ссылка.Дата, ДЕНЬ)
		|	КОНЕЦ                                                      КАК ДатаПроизводства,
		|	ТабличнаяЧасть.Количество                                  КАК Количество
		|ИЗ
		|	Документ.питВыпускБлюд.ПобочныеИзделияСерии КАК ТабличнаяЧасть
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|			ПО ТабличнаяЧасть.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &ДокументОснование
		|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииВЕТИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|";
		СтруктураЗапроса.Вставить("Товары", ТекстЗапроса);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТабличнаяЧасть.Ингредиент                                  КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика                              КАК Характеристика,
		|	ТабличнаяЧасть.Серия                                       КАК Серия,
		|	ТабличнаяЧасть.КоличествоИнгредиентаФакт                   КАК Количество
		|ПОМЕСТИТЬ Сырье
		|ИЗ
		|	Документ.питВыпускБлюд.Ингредиенты КАК ТабличнаяЧасть
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО ТабличнаяЧасть.Ингредиент = ОписаниеНоменклатурыИС.Номенклатура
		|
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &ДокументОснование
		|	И ТабличнаяЧасть.ИзАвтопеределов = ЛОЖЬ
		|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииВЕТИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|";
		СтруктураЗапроса.Вставить("Сырье", ТекстЗапроса);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питРазделка") Тогда
		
		СтруктураЗапроса = Новый Структура();
		
		ТекстЗапроса = "ВЫБРАТЬ
		|	Таблица.Ссылка КАК ДокументОснование,
		|
		|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК ОрганизацияКонтрагент,
		|	Таблица.Подразделение КАК ТорговыйПроизводственныйОбъект,
		|
		|	НАЧАЛОПЕРИОДА(Таблица.Дата, ДЕНЬ) КАК ДатаОперацииНачалоПериода,
		|	КОНЕЦПЕРИОДА(Таблица.Дата, ДЕНЬ) КАК ДатаОперацииКонецПериода,
		|
		|	"""" КАК ИдентификаторПроизводственнойТранзакции,
		|	ЛОЖЬ КАК ЗавершениеПроизводственнойТранзакции,
		|	(НЕ Таблица.Проведен) КАК ЕстьОшибкиПроведен
		|ИЗ
		|	Документ.питРазделка КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &ДокументОснование
		|";
		СтруктураЗапроса.Вставить("Реквизиты", ТекстЗапроса);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика КАК Характеристика,
		|	ТабличнаяЧасть.Серия КАК Серия,
		|	НАЧАЛОПЕРИОДА(ТабличнаяЧасть.Ссылка.Дата, ДЕНЬ) КАК ДатаПроизводства,
		|	ТабличнаяЧасть.Количество КАК Количество
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	Документ.питРазделка.Товары КАК ТабличнаяЧасть
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО ТабличнаяЧасть.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &ДокументОснование
		|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииВЕТИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|";
		СтруктураЗапроса.Вставить("Товары", ТекстЗапроса);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
		|	ТабличнаяЧасть.Характеристика КАК Характеристика,
		|	ТабличнаяЧасть.Серия КАК Серия,
		|	ТабличнаяЧасть.Количество КАК Количество
		|ПОМЕСТИТЬ Сырье
		|ИЗ
		|	Документ.питРазделка КАК ТабличнаяЧасть
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО ТабличнаяЧасть.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|ГДЕ
		|	ТабличнаяЧасть.Ссылка = &ДокументОснование
		|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииВЕТИС <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|";
		СтруктураЗапроса.Вставить("Сырье", ТекстЗапроса);
		
	КонецЕсли;
	
	// ДобавитьТекстЗапросаСырье(СтруктураЗапроса, "ПроизводствоБезЗаказа", "МатериалыИРаботы");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка) КАК ШтрихкодУпаковки
	|ПОМЕСТИТЬ Штрихкоды
	|ГДЕ ЛОЖЬ
	|";
	СтруктураЗапроса.Вставить("Штрихкоды", ТекстЗапроса);
	
	Возврат СтруктураЗапроса;
	
КонецФункции

#КонецОбласти

// +пит
//
// Параметры:
//  ДокументОбщепит - Произвольный - Документ общепит.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НайтиИсточникДанныхДляДокументаОбщепит(ДокументОбщепит) Экспорт
	
	Если ТипЗнч(ДокументОбщепит) = Тип("ДокументСсылка.питВыпускБлюд") Тогда
		
		ТиповойДокумент = ТиповойДокументДокументаОбщепит(ДокументОбщепит);
		Если НЕ ТиповойДокумент = Неопределено Тогда
			ДокументОбщепит = ТиповойДокумент;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОбщепит) = Тип("Структура") И ДокументОбщепит.Свойство("Основание") Тогда
		
		ТиповойДокумент = ТиповойДокументДокументаОбщепит(ДокументОбщепит.Основание);
		Если НЕ ТиповойДокумент = Неопределено Тогда
			ДокументОбщепит.Основание = ТиповойДокумент;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДокументОбщепит;
	
КонецФункции

//  Функция - Обработка заполнения документа начало.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ОбработкаЗаполненияДокументаНачало(ДокументОбъект, ДанныеЗаполнения) Экспорт
	
	ТипОбъекта = ТипЗнч(ДокументОбъект);
	Если НЕ ТипОбъекта = Тип("ДокументОбъект.ИсходящаяТранспортнаяОперацияВЕТИС") Тогда
		Возврат ДанныеЗаполнения;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питВыпускБлюд") Тогда
		КопияДанныеЗаполнения = ДанныеЗаполнения;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Основание") Тогда
		КопияДанныеЗаполнения = Новый Структура;
		Для Каждого ЭлементСтруктуры Из ДанныеЗаполнения Цикл
			КопияДанныеЗаполнения.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЦикла;
	Иначе
		КопияДанныеЗаполнения = ДанныеЗаполнения;
	КонецЕсли;
	
	ДанныеЗаполнения = НайтиИсточникДанныхДляДокументаОбщепит(ДанныеЗаполнения);
	
	Возврат КопияДанныеЗаполнения;
	
КонецФункции

//  Процедура - Обработка заполнения документа конец.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//  СтарыеДанныеЗаполнения - Произвольный - Старые данные заполнения.
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
Процедура ОбработкаЗаполненияДокументаКонец(ДокументОбъект, СтарыеДанныеЗаполнения, ДанныеЗаполнения) Экспорт
	
	ТипОбъекта = ТипЗнч(ДокументОбъект);
	Если НЕ ТипОбъекта = Тип("ДокументОбъект.ИсходящаяТранспортнаяОперацияВЕТИС") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбщепит = Неопределено;
	Если ТипЗнч(СтарыеДанныеЗаполнения) = Тип("ДокументСсылка.питВыпускБлюд") Тогда
		ДокументОбщепит = СтарыеДанныеЗаполнения;
	ИначеЕсли ТипЗнч(СтарыеДанныеЗаполнения) = Тип("Структура") И СтарыеДанныеЗаполнения.Свойство("Основание") Тогда
		ДокументОбщепит = СтарыеДанныеЗаполнения.Основание;
	КонецЕсли;
	
	Если НЕ ДокументОбщепит = Неопределено Тогда
		ДокументОбъект.ДокументОснование = ДокументОбщепит;
	КонецЕсли;
	
	ДанныеЗаполнения = СтарыеДанныеЗаполнения;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Функция - Типовой документ документа общепит.
//
// Параметры:
//  ДокументОбщепит - Произвольный - Документ общепит.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ТиповойДокументДокументаОбщепит(ДокументОбщепит)
	
	ТиповыеДокументы = Неопределено;
	ТекстСообщения = "";
	ФильтрПоТипу = Новый Массив;
	ФильтрПоТипу.Добавить("Документ.ПеремещениеТоваров");
	ФильтрПоТипу.Добавить("Документ.ДвижениеПродукцииИМатериалов");
	
	// Получение типовых документов с фильтром по типу.
	ПараметрыПолучения = Новый Структура("УпорядочитьПоДатеИНомеру, УпорядочитьПоМоментуВремени, ФильтрПоТипу", Ложь, Истина, ФильтрПоТипу);
	питТиповыеДокументы.НайтиТиповойДокументДляДокументапит(ДокументОбщепит, ТиповыеДокументы, ТекстСообщения, ПараметрыПолучения);
	Если ТиповыеДокументы = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли НЕ ТипЗнч(ТиповыеДокументы) = Тип("Массив") Тогда
		Возврат ТиповыеДокументы;
	Иначе
		Возврат ТиповыеДокументы[0];
	КонецЕсли;
	
КонецФункции

#КонецОбласти


