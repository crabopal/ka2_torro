Функция ПользовательИзвестенУзлу(Пользователь, КассовыйУзелСсылка, ИндивидуальныйСписокПользователей = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИндивидуальныйСписокПользователей = Неопределено Тогда
		ИндивидуальныйСписокПользователей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассовыйУзелСсылка,"ИндивидуальныйСписокПользователей");
	КонецЕсли;
	
	Если НЕ ИндивидуальныйСписокПользователей Тогда
		Возврат Истина;
	КонецЕсли;
	
	// У пользователей нет иерархии.
//   МассивПользовательНаПроверку =
// питОбменДанными.ПолучитьВсехВышестоящихРодителейСправочника(Пользователь,"Пользователи", Истина);.
	
	МассивПользовательНаПроверку = Новый Массив;
	МассивПользовательНаПроверку.Добавить(Пользователь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питУдаленныеКассыПользователи.Пользователь КАК Пользователь
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.Пользователи КАК питУдаленныеКассыПользователи
	|ГДЕ
	|	питУдаленныеКассыПользователи.Ссылка = &КассовыйУзелСсылка
	|	И питУдаленныеКассыПользователи.Пользователь В(&МассивПользовательНаПроверку)";
	Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
	Запрос.УстановитьПараметр("МассивПользовательНаПроверку", МассивПользовательНаПроверку);
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = НЕ РезультатЗапроса.Пустой();
	Возврат Результат;
КонецФункции

