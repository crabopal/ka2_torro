			Исключение
				ТекстОшибки = ИнформацияОбОшибке().Описание;
			КонецПопытки; 
		КонецЕсли;
		
		Если ЦветаКнопки.ЦветШрифтаНадписи3 = Неопределено Тогда
			Объект.питЦветШрифтаНадписи3 = "";
