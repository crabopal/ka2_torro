// Функция производит поиск элемента справочника "Упаковки единицы измерения" по полученным параметрам
//  Если элемент не найден то создадим его с переданными параметрами
//
// Параметры:
//  ИД - Строка - Уникальный идентификатор элемента справочника "Классификаторы единиц измерения.
//  Код - Строка - Код элемента справочника справочника "Классификаторы единиц измерения.
//  Наименование - Строка - Наименование элемента справочника "Классификаторы единиц измерения.
//  НаименованиеПолное - Строка - Полное наименование элемента справочника "Классификаторы единиц измерения.
//
// Возвращаемое значение:
//   СправочникСсылка.УпаковкиЕдиницыИзмерения - Ссылка справочника "УпаковкиЕдиницыИзмерения" 
Функция ПолучитьКлассификаторЕдиницИзмерения(ИД = Неопределено, Код = Неопределено, Наименование = Неопределено, НаименованиеПолное = Неопределено) Экспорт
	
	Результат = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(Код) И НЕ ЗначениеЗаполнено(Наименование) 
		И (НЕ ЗначениеЗаполнено(ИД) ИЛИ (Найти(ИД, "00000000-0000-0000-0000-000000000000") > 0)) Тогда
		Возврат Результат; // Пустая ссылка
	КонецЕсли;
	
	// С тех пор как нашлись БЭКи в которых есть элементы классификатора с повторяющимися (неуникальными кодами)
	// мы будем делать поиск в первую очередь именно по коду... 
	Если ЗначениеЗаполнено(Код) Тогда 
		ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|ГДЕ
		|	УпаковкиЕдиницыИзмерения.Код = &Код
		|
		|УПОРЯДОЧИТЬ ПО
		|	УпаковкиЕдиницыИзмерения.ПометкаУдаления,
		|	УпаковкиЕдиницыИзмерения.НаименованиеПолное УБЫВ,
		|	УпаковкиЕдиницыИзмерения.Наименование УБЫВ
		|";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Код", Код);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// ... и только во вторую очередь по самой ссылке т.е. по ее уникальному идентификатору
	НоваяСсылка = Неопределено;
	Если ЗначениеЗаполнено(ИД) И (Найти(ИД, "00000000-0000-0000-0000-000000000000") = 0) Тогда
		НоваяСсылка = питОбменДаннымиПовтИсп.ПолучитьСсылкуПоИДИИмениОбъекта(ИД, "УпаковкиЕдиницыИзмерения");
		Если ЗначениеЗаполнено(НоваяСсылка) И НЕ ПустаяСтрока(НоваяСсылка.ВерсияДанных) Тогда
			Возврат НоваяСсылка;
		КонецЕсли;
	КонецЕсли;
	
	// Поиск по наименованию
	Если ЗначениеЗаполнено(Наименование) Тогда 
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		|ГДЕ
		|	УпаковкиЕдиницыИзмерения.Наименование = &Наименование";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// Создание нового элемента справочника "Классификаторы единиц измерения" по полученным параметрам 
	Если ЗначениеЗаполнено(Код) Тогда
		РезультатСоответствиеКодовЕИ = Справочники.УпаковкиЕдиницыИзмерения.ЗаполнитьЕдиницыИзмеренияИзКлассификатора(Код);
		Результат = РезультатСоответствиеКодовЕИ.Получить(Код);
	Иначе
		НовыйЭлемент = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			НовыйЭлемент.УстановитьСсылкуНового(НоваяСсылка);
		КонецЕсли;
		// Код
		НовыйЭлемент.Код = Код;
		НовыйЭлемент.Владелец = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения;
		НовыйЭлемент.Безразмерная = Ложь;
		// Наименование
		Если ЗначениеЗаполнено(Наименование) Тогда 
			НовыйЭлемент.Наименование = Наименование;
		КонецЕсли;
		// Наименование полное
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда 
			НовыйЭлемент.НаименованиеПолное = НаименованиеПолное;
		КонецЕсли;
		Попытка
			НовыйЭлемент.ДополнительныеСвойства.Вставить("Загрузка", Истина);
			НовыйЭлемент.Записать();
			Результат = НовыйЭлемент.Ссылка;
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ЗаписьЖурналаРегистрации("Запись элемента ""УпаковкиЕдиницыИзмерения""", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьКлассификаторЕдиницИзмерения

