					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		// неверное имя документа
	КонецПопытки; 
	
	Возврат ЕстьРеквизит;
	
КонецФункции // ЕстьРеквизитШапкиДокумента

