	Запр.УстановитьПараметр("ВыбУзел", 	КассовыйУзелСсылка);
	
	РезЗапра = Запр.Выполнить();
	Если РезЗапра.Пустой() Тогда
		Возврат Истина; 
		// Конкретных разрешенных не указали/не ввели, значит любой (так заказчик сказал)
