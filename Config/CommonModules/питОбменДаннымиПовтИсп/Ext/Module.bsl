// Функция получения значение реквизита в XML формате
//
// Параметры:
//  ЗначениеРеквизита - Произвольный - Значение реквизита объект.
//  ИмяМетаданные - Строка - Имя объекта в дереве метаданных.
//  Тип - Строка - Тип объекта строкой.
//  ИмяФункцииОбработки - Строка - Имя функций для получения XML значения.
//
// Возвращаемое значение:
//  Произвольный - Значение реквизита
Функция ПолучитьЗначениеАтрибутаДляВыгрузки(ЗначениеРеквизита, ИмяМетаданные, Тип, ИмяФункцииОбработки) Экспорт
	
	Результат = Неопределено;
	
	Если ПустаяСтрока(ИмяФункцииОбработки) Тогда 
		Если Тип = "Ссылка" Тогда
			Результат = питОбменДаннымиПовтИсп.ПолучитьИДПоСсылке(ЗначениеРеквизита);
		ИначеЕсли Тип = "Переч" Тогда
			Результат = ЗначениеРеквизита;
		ИначеЕсли Тип = "Строка" Тогда
			Результат = XMLСтрока(СокрП(ЗначениеРеквизита));
		ИначеЕсли Тип = "Булево" Тогда
			Если ИмяМетаданные = "ПометкаУдаления" Тогда
				Результат = питОбменДаннымиПовтИсп.БулевоВСтроку(НЕ ЗначениеРеквизита);
			Иначе
				Результат = питОбменДаннымиПовтИсп.БулевоВСтроку(ЗначениеРеквизита);
			КонецЕсли;
		ИначеЕсли Тип = "Число" Тогда
			Результат = Формат(ЗначениеРеквизита, "ЧГ=;ЧРД='.'");
		ИначеЕсли Тип = "Дата" Тогда
			Результат = Формат(ЗначениеРеквизита, "ДФ='yyyy.MM.dd HH:mm:ss'");
		Иначе
			Результат = XMLСтрока(ЗначениеРеквизита);
		КонецЕсли;
	Иначе
		Выполнить("Результат = " + ИмяФункцииОбработки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьЗначениеАтрибутаДляВыгрузки

// Функция получения значение реквизита в XML формате
//
// Параметры:
//  ЗначениеРеквизита - Произвольный - Значение реквизита объект.
//  ИмяМетаданные - Строка - Имя объекта в дереве метаданных.
//  Тип - Строка - Тип объекта строкой.
//  ИмяФункцииОбработки - Строка - Имя функций для получения XML значения.
//
// Возвращаемое значение:
//  Произвольный - Значение реквизита
Функция ПолучитьЗначениеАтрибутаПриЗагрузке(ЗначениеРеквизита, ИмяМетаданные, Тип, ИмяФункцииОбработки) Экспорт
	
	Результат = Неопределено;
	Попытка
		Если ПустаяСтрока(ИмяФункцииОбработки) Тогда
			Если Тип = "Строка" Тогда
				Результат = ЗначениеРеквизита;
			ИначеЕсли Тип = "Число" Тогда
				Результат = питОбменДаннымиПовтИсп.СтрокаВЧисло(ЗначениеРеквизита);
			ИначеЕсли Тип = "Булево" Тогда
				Если ИмяМетаданные = "ПометкаУдаления" Тогда
					Результат = НЕ питОбменДаннымиПовтИсп.БулевоИзСтроки(ЗначениеРеквизита);
				Иначе
					Результат = питОбменДаннымиПовтИсп.БулевоИзСтроки(ЗначениеРеквизита);
				КонецЕсли;
			ИначеЕсли Тип = "Дата" Тогда
				Результат = питОбменДаннымиПовтИсп.ДатаИзСтроки(ЗначениеРеквизита);
			Иначе 
				// ну что-то надо вернуть
				Результат = ЗначениеРеквизита;
			КонецЕсли;
		Иначе
			Выполнить("Результат = " + ИмяФункцииОбработки);
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Значение <" + ЗначениеРеквизита + ">; Метаданные <" + ИмяМетаданные + ">; Тип  <" + Тип + ">;
					|Функция  <" + ИмяФункцииОбработки + ">;
					|Ошибка: " + ТекстОшибки;
		Событие = "ОшибкаИсключения.ПолучитьЗначениеАтрибутаПриЗагрузке";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	Возврат Результат;
	
КонецФункции // ПолучитьЗначениеАтрибутаПриЗагрузке()

