//
// Параметры:
//  ВидМенюСсылка - Произвольный - Вид меню ссылка.
//
// Возвращаемое значение:
//  Массив - Результат обработки.
Функция ПолучитьМассивУзловДляРегистрацииПоВидуМеню(ВидМенюСсылка) Экспорт
	
	Результат = Новый Массив;
	
	МассивСРодителямиВидаМеню = питОбменДанными.ПолучитьМассивСРодителями(ВидМенюСсылка);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	питУдаленныеКассы.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Узлы
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	|ГДЕ
	|	НЕ питУдаленныеКассы.ИндивидуальныйСписокВидовМенюИНоменклатуры
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УдаленныеКассыВидыМеню.Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
	|ГДЕ
	|	УдаленныеКассыВидыМеню.Ссылка.ИндивидуальныйСписокВидовМенюИНоменклатуры
	|	И УдаленныеКассыВидыМеню.ВидМеню В(&МассивСРодителями)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	питУдаленныеКассы.Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
	|		ПО питУдаленныеКассы.Ссылка = УдаленныеКассыВидыМеню.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	питУдаленныеКассы.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(УдаленныеКассыВидыМеню.ВидМеню) = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Узлы.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_Узлы КАК ВТ_Узлы
	|ГДЕ
	|	НЕ ВТ_Узлы.Ссылка = &ЭтотУзел");
	Запрос.УстановитьПараметр("МассивСРодителями", МассивСРодителямиВидаМеню);
	Запрос.УстановитьПараметр("ЭтотУзел",ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
	
	РезЗапроса = Запрос.Выполнить();
	
	Если НЕ РезЗапроса.Пустой() Тогда
		Результат = РезЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция получает строку адреса из К.И. по таб. части "Контактная информация",
//  если у организации он заполнен.
//
// Параметры:
//  ОрганизацияСсылка - СправочникСсылка.Организации - организация, у которой ищем адрес.
//  ВидАдреса - СправочникСсылка.ВидыКонтактнойИнформации - Вид К.И.
//
// Возвращаемое значение:
//  Строка - Строка адреса.
Функция ПолучитьСтрокуАдресОрганизации(ОрганизацияСсылка, ВидАдреса) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОрганизацииКонтактнаяИнформация.Представление
	|ИЗ
	|	Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	|ГДЕ
	|	ОрганизацииКонтактнаяИнформация.Ссылка = &Ссылка
	|	И ОрганизацииКонтактнаяИнформация.Вид = &Вид";
	Запрос.УстановитьПараметр("Ссылка", ОрганизацияСсылка);
	Запрос.УстановитьПараметр("Вид", ВидАдреса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Представление;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Функция из переданной структуры двумя датами(дата, время) формирует строку.
//
// Параметры:
//  СтруктураДатаВремя - Структура - Структура с датой и временем.
//
// Возвращаемое значение:
//  Строка - Дата и время строкой
Функция ПолучитьДатуПлюсВремяСтрокой(СтруктураДатаВремя) Экспорт
	
	ПустаяДата = '00010101000000';
	
	Если НЕ СтруктураДатаВремя.Свойство("ДатаДействия") Тогда
		СтруктураДатаВремя.Вставить("ДатаДействия", Дата(ПустаяДата));
	КонецЕсли;
	Если НЕ СтруктураДатаВремя.Свойство("ВремяДействия") Тогда
		СтруктураДатаВремя.Вставить("ВремяДействия", Дата(ПустаяДата));
	КонецЕсли;
	
	Если СтруктураДатаВремя.ДатаДействия = ПустаяДата И СтруктураДатаВремя.ВремяДействия = ПустаяДата Тогда
		ДатаСтрокой = "";
	ИначеЕсли СтруктураДатаВремя.ДатаДействия = ПустаяДата Тогда
		ДатаСтрокой = Формат(СтруктураДатаВремя.ВремяДействия, "ДФ='HH:mm:ss'");
	ИначеЕсли СтруктураДатаВремя.ВремяДействия = ПустаяДата Тогда
		ДатаСтрокой = Формат(СтруктураДатаВремя.ДатаДействия, "ДФ='yyyy.MM.dd'");
	Иначе
		ДатаСтрокой = Формат(СтруктураДатаВремя.ДатаДействия, "ДФ='yyyy.MM.dd'") + " " + Формат(СтруктураДатаВремя.ВремяДействия, "ДФ='HH:mm:ss'");
	КонецЕсли;
	
	Возврат ДатаСтрокой;
	
КонецФункции

// Функция - Получить статус договора контрагента.
//
// Параметры:
//  ДатаНачалаСтрокой - Дата - Дата начала строкой.
//  ДатаОкончанияСтрокой - Дата - Дата окончания строкой.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьСтатусДоговораКонтрагента(ДатаНачалаСтрокой = Неопределено, ДатаОкончанияСтрокой = Неопределено) Экспорт
	
	ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	
	Если ДатаНачалаСтрокой = Неопределено И ДатаОкончанияСтрокой = Неопределено Тогда
		Возврат ЗначениеСтатуса;
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	
	ДатаНачала = Неопределено;
	ДатаОкончания = Неопределено;
	
	Если НЕ ДатаНачалаСтрокой = Неопределено Тогда
		ДатаНачала = ДатаИзСтроки(ДатаНачалаСтрокой);
	КонецЕсли;
	Если НЕ ДатаОкончанияСтрокой = Неопределено Тогда
		ДатаОкончания = ДатаИзСтроки(ДатаОкончанияСтрокой);
	КонецЕсли;
	
	Если ДатаНачала = Неопределено Тогда
		Если ТекДата >= ДатаОкончания Тогда
			ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.Закрыт;
		Иначе
			ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		КонецЕсли;
	ИначеЕсли ДатаОкончания = Неопределено Тогда
		Если ТекДата >= ДатаНачала Тогда
			ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		Иначе
			ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.НеСогласован;
		КонецЕсли;
	Иначе
		Если ТекДата < ДатаНачала Тогда
			ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.НеСогласован;
		ИначеЕсли ТекДата >= ДатаНачала И ТекДата < ДатаОкончания Тогда
			ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		Иначе
			ЗначениеСтатуса = Перечисления.СтатусыДоговоровКонтрагентов.Закрыт;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеСтатуса;
	
КонецФункции

// Функция получает цвет фона кнопок у меню строкой.
//
// Параметры:
//  ИсхЦветФонаКнопок - Строка - Исходное значение цвета в объекте меню.
//  ТекРодитель - СправочникСсылка.питМеню - Ссылка на родителя тек. меню.
//
// Возвращаемое значение:
//  Строка - Цвет фона кнопок строкой.
Функция ПолучитьЦветКнопокСтрокой(ИсхЦветФонаКнопок, ТекРодитель = Неопределено) Экспорт
	
	НаследоватьЦвет = Ложь;
	
	ЦветФонаКнопок = Формат(ПолучитьСистемныйЦвет(ИсхЦветФонаКнопок), "ЧГ=''");
	Если ЦветФонаКнопок = "-1" И ЗначениеЗаполнено(ТекРодитель)Тогда
		
		Пока НЕ ТекРодитель.Пустая() Цикл
			
			ЦветФонаКнопок = Формат(ПолучитьСистемныйЦвет(ТекРодитель.ЦветФонаКнопок), "ЧГ=''");
			Если ЦветФонаКнопок <> "-1" Тогда
				НаследоватьЦвет = Истина;
				Прервать;
			КонецЕсли;
			
			ТекРодитель = ТекРодитель.Родитель;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НаследоватьЦвет Тогда
		ЗначениеЦвета = "";
	Иначе
		ЗначениеЦвета = ЦветФонаКнопок + ",-1,-1";
	КонецЕсли;
	
	Возврат ЗначениеЦвета;
	
КонецФункции

// Возвращает числовое значение цвета, переданного в виде RGB
//
// Параметры:
//  Красный - Произвольный - Красный.
//  Зеленый - Произвольный - Зеленый.
//  Синий - Произвольный - Синий.
//
// Возвращаемое значение:
// 	Число - Представление цвета в виде числа.
Функция СмешатьЦвет(Красный, Зеленый, Синий) Экспорт
	Возврат Красный + Зеленый*256 + Синий*65536;
КонецФункции

// Функция получения таблицу значений метаданных
//
// Параметры:
//  ТолькоСправочники - Произвольный - Только справочники.
//  ТолькоДляВыгрузки - Произвольный - Только для выгрузки.
//  ТолькоДляЗагрузки - Произвольный - Только для загрузки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица метаданных
Функция ПолучитьСтруктуруМетаданныхДляОбменов(ТолькоСправочники, ТолькоДляВыгрузки = Истина, ТолькоДляЗагрузки = Неопределено) Экспорт
	
	// Инициализируем таблицу значений
	ТаблицаМетаданных = Новый ТаблицаЗначений;
	ТаблицаМетаданных.Колонки.Добавить("Метаданные");
	ТаблицаМетаданных.Колонки.Добавить("Дескриптор");
	ТаблицаМетаданных.Колонки.Добавить("ИмяФункцииПроверкиОбъекта");
	ТаблицаМетаданных.Колонки.Добавить("ИмяФункцииПропуститьЗапись");
	ТаблицаМетаданных.Колонки.Добавить("ИмяФункцииПропуститьЧтение");

	// Получим макет "Порядок выгрузки объектов метаданных"
	МакетВыгрузки = ПланыОбмена.питУдаленныеКассы.ПолучитьМакет("ПорядокВыгрузкиОбъектовМетаданных");
	
	// Инициализируем области
	ОбластьСправочников 		= МакетВыгрузки.ПолучитьОбласть("Справочники");
	ВсегоСправочников			= ОбластьСправочников.ВысотаТаблицы;
	ТекМетаданные 				= Неопределено;
	
	// Обход строк макета
	Для СчетчикСтрокМакета = 1 По МакетВыгрузки.ВысотаТаблицы Цикл

		Если ТолькоСправочники И (СчетчикСтрокМакета > ВсегоСправочников) Тогда
			Прервать;
		КонецЕсли;
		
		ТекМетаданные 		= Неопределено;
		
		Классификатор					= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 1).Текст);
		ТекИмяМетаданных				= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 2).Текст);
		ТекТэгДанныхВxml				= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 3).Текст);
		ТекФлагВыгружать				= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 4).Текст);
		ТекФлагЗагружать				= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 5).Текст);
		ТекИмяФункцииПроверкиОбъекта	= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 6).Текст);
		ТекИмяФункцииПропуститьЗапись	= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 7).Текст);
		ТекИмяФункцииПропуститьЧтение	= СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 8).Текст);
		
		Если ПустаяСтрока(ТекИмяМетаданных) Тогда
			Продолжить; // такое нам не нужно
		КонецЕсли;
		
		Если ТолькоДляВыгрузки = Неопределено Тогда
			// поэтому фильтру не проверяем
		ИначеЕсли ТолькоДляВыгрузки И НЕ (ТекФлагВыгружать = "Истина") Тогда
			Продолжить; // такое нам не нужно
		КонецЕсли;
			
		Если ТолькоДляЗагрузки = Неопределено  Тогда
			// поэтому фильтру не проверяем
		ИначеЕсли ТолькоДляЗагрузки И НЕ (ТекФлагЗагружать = "Истина") Тогда
			Продолжить; // такое нам не нужно
		КонецЕсли;
		
		Попытка
			Если Классификатор = "Справочник" Тогда
				ТекМетаданные = Метаданные.Справочники[ТекИмяМетаданных];
			ИначеЕсли Классификатор = "Документ" Тогда
				ТекМетаданные = Метаданные.Документы[ТекИмяМетаданных];
			ИначеЕсли Классификатор = "РегистрСведений" Тогда
				ТекМетаданные = Метаданные.РегистрыСведений[ТекИмяМетаданных];
			Иначе // кто-то накосячил в макете
				Продолжить; // такое нам не нужно
			КонецЕсли;
		Исключение
			ТекМетаданные = Неопределено;
		КонецПопытки;
		
		Если ТекМетаданные = Неопределено Тогда
			Продолжить; // такое нам не нужно
		КонецЕсли;
		
		// Добавим строку в таблицу значений
		НоваяСтрока								= ТаблицаМетаданных.Добавить();
		НоваяСтрока.Метаданные					= ТекМетаданные;
		НоваяСтрока.Дескриптор					= ТекТэгДанныхВxml;
		НоваяСтрока.ИмяФункцииПроверкиОбъекта	= ТекИмяФункцииПроверкиОбъекта;
		НоваяСтрока.ИмяФункцииПропуститьЗапись	= ТекИмяФункцииПропуститьЗапись;
		НоваяСтрока.ИмяФункцииПропуститьЧтение	= ТекИмяФункцииПропуститьЧтение;
		
	КонецЦикла;
	
	Возврат ТаблицаМетаданных;
	
КонецФункции // ПолучитьСтруктуруМетаданныхДляОбменов()

// Функция получения структуры объекта
//
// Параметры:
//  ИмяОбъекта - Строка - Имя объекта в XML представления.
//  ТолькоЭтуОбласть - Произвольный - Только эту область.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Структура объекта
Функция ПолучитьСтруктуруОбъекта(ИмяОбъекта, ТолькоЭтуОбласть = "") Экспорт
	
	Если ПланыОбмена.питУдаленныеКассы.ПустаяСсылка().Метаданные().Макеты.Найти(ИмяОбъекта) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		МакетСтруктурОбъектов = ПланыОбмена.питУдаленныеКассы.ПолучитьМакет(ИмяОбъекта);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ПустаяСтрока(ТолькоЭтуОбласть) Тогда
		ТабличныйДокумент = МакетСтруктурОбъектов;
	Иначе
		Попытка
			ТабличныйДокумент = МакетСтруктурОбъектов.ПолучитьОбласть(ТолькоЭтуОбласть);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	ЕстьДопКолонка = НЕ (ТабличныйДокумент.Области.Найти("ЗагружатьПустой") = Неопределено);
	Прибавка = ?(ЕстьДопКолонка,1,0);
	
	// Инициализируем таблицу значений
	СтруктураОбъекта = Новый ТаблицаЗначений;
	СтруктураОбъекта.Колонки.Добавить("Использование");
	СтруктураОбъекта.Колонки.Добавить("Вид");
	СтруктураОбъекта.Колонки.Добавить("ВыгружатьПустым");
	Если ЕстьДопКолонка Тогда
		СтруктураОбъекта.Колонки.Добавить("ЗагружатьПустой");
	КонецЕсли;
	СтруктураОбъекта.Колонки.Добавить("ИмяМетаданные");
	СтруктураОбъекта.Колонки.Добавить("ИмяXML");
	СтруктураОбъекта.Колонки.Добавить("Тип");
	СтруктураОбъекта.Колонки.Добавить("ИмяФункПриЗагрузке");
	СтруктураОбъекта.Колонки.Добавить("ИмяФункКонвертЗагр");
	СтруктураОбъекта.Колонки.Добавить("ИмяФункПриВыгрузке");
	СтруктураОбъекта.Колонки.Добавить("ИмяФункКонвертВыгр");
	
	Для СчетчикСтрокМакета = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл 
		НоваяСтрока						= СтруктураОбъекта.Добавить();
		НоваяСтрока.Использование		= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 1).Текст);
		НоваяСтрока.Вид					= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 2).Текст);
		НоваяСтрока.ВыгружатьПустым		= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 3).Текст);
	Если ЕстьДопКолонка Тогда
		НоваяСтрока.ЗагружатьПустой		= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 4).Текст);
	КонецЕсли;		
		НоваяСтрока.ИмяМетаданные		= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 4+Прибавка).Текст);
		НоваяСтрока.ИмяXML				= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 5+Прибавка).Текст);
		НоваяСтрока.Тип					= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 6+Прибавка).Текст);
		НоваяСтрока.ИмяФункПриЗагрузке	= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 7+Прибавка).Текст);
		НоваяСтрока.ИмяФункКонвертЗагр	= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 8+Прибавка).Текст);
		НоваяСтрока.ИмяФункПриВыгрузке	= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета, 9+Прибавка).Текст);
		НоваяСтрока.ИмяФункКонвертВыгр 	= СокрЛП(ТабличныйДокумент.Область(СчетчикСтрокМакета,10+Прибавка).Текст);
	КонецЦикла;
	
	Возврат СтруктураОбъекта;
	
КонецФункции // ПолучитьСтруктуруОбъекта()

// Функция получает классификатора объекта по имени
//
// Параметры:
//  ИмяОбъекта - Строка - Имя объекта в дереве метаданных.
//
// Возвращаемое значение:
//  Строка
Функция ПолучитьИмяКлассификаторОбъекта(ИмяОбъекта) Экспорт 
	
	Попытка
		
		КлассификаторОбъекта = Неопределено;
		
		Если НЕ Метаданные.НайтиПоПолномуИмени("Справочник." + ИмяОбъекта) = Неопределено Тогда
			КлассификаторОбъекта = "Справочник";
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("Документ." + ИмяОбъекта) = Неопределено Тогда
			КлассификаторОбъекта = "Документ";
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("ПланОбмена." + ИмяОбъекта) = Неопределено Тогда
			КлассификаторОбъекта = "ПланОбмена";
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("ПланВидовХарактеристик." + ИмяОбъекта) = Неопределено Тогда
			КлассификаторОбъекта = "ПланВидовХарактеристик";
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("РегистрСведений." + ИмяОбъекта) = Неопределено Тогда
			КлассификаторОбъекта = "РегистрСведений";
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("РегистрНакопления." + ИмяОбъекта) = Неопределено Тогда
			КлассификаторОбъекта = "РегистрНакопления";
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("Получение менеджера объекта", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат КлассификаторОбъекта;
	
КонецФункции // ПолучитьИмяКлассификаторОбъекта()

// Функция получения ссылки по ее уникальному идентификатору
//
// Параметры:
//  ИсхИДСтрокой - Строка - Строковое представление идентификатор.
//  ИмяОбъекта - Строка - Имя объект.
//  ПроверитьНаличие - Булево - Флаг необходимости проверить наличие в базе объекта с такой ссылкой.
//
// Возвращаемое значение:
//  Ссылка
Функция ПолучитьСсылкуПоИДИИмениОбъекта(ИсхИДСтрокой, ИмяОбъекта, ПроверитьНаличие = Ложь) Экспорт
	
	ИмяОбъектаМенеджер = ИмяОбъекта;
	Если питОбменДаннымиПовтИсп.Латиница(ИмяОбъектаМенеджер) Тогда 
		ТаблицуСоответствийИмен = питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменОбъектов();
		ИмяОбъектаМенеджер = ТаблицуСоответствийИмен.Получить(ИмяОбъектаМенеджер);
		Если ИмяОбъектаМенеджер = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	МенеджерОбъекта = питОбменДаннымиПовтИсп.ПолучитьМенеджерОбъектаПоИмени(ИмяОбъектаМенеджер);
	
	Результат = МенеджерОбъекта.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИсхИДСтрокой) Тогда
		
		// Преобразуем в корректное значение ID
		ИДСтрокой = питОбменДаннымиПовтИсп.ПолучитьИДПоСтроке(ИсхИДСтрокой);
		// Получение ИД из строки
		ИД = Новый УникальныйИдентификатор(ИДСтрокой);
		// Получение ссылки по ИД
		Результат = МенеджерОбъекта.ПолучитьСсылку(ИД);
		// Проверяем есть объект в нашей БД
		Если ПроверитьНаличие Тогда
			Если ПустаяСтрока(Результат.ВерсияДанных) Тогда
				Результат = МенеджерОбъекта.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Возврат ссылки (без проверки не исключается что "битая")
	Возврат Результат;
	
КонецФункции // ПолучитьСсылкуПоИДИИмениОбъекта()

// Функция получения соответствие имен метаданных и XML
//
// Возвращаемое значение:
//  Соответствие 
Функция ПолучитьТаблицуСоответствийИменОбъектов() Экспорт
	
	СоответствиеИмен = Новый Соответствие;
	МакетВыгрузки = ПланыОбмена.питУдаленныеКассы.ПолучитьМакет("ПорядокВыгрузкиОбъектовМетаданных");
	
	Для СчетчикСтрокМакета = 1 По МакетВыгрузки.ВысотаТаблицы Цикл
		ТекИмяМетаданных = СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 2).Текст);
		ТекТэгДанныхВxml = СокрЛП(МакетВыгрузки.Область(СчетчикСтрокМакета, 3).Текст);
		Если ПустаяСтрока(ТекИмяМетаданных) ИЛИ ПустаяСтрока(ТекИмяМетаданных) Тогда
			// какая-то ошибка в макете, не будем добавлять такое в возвращаемое соответствие
		Иначе
			СоответствиеИмен.Вставить(ТекТэгДанныхВxml, ТекИмяМетаданных);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СоответствиеИмен;

КонецФункции // ПолучитьТаблицуСоответствийИменОбъектов()

