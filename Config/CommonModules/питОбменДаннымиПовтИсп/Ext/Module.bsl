// Функция получает значение для обмена.
//
// Параметры:
//  ЗначениеРеквизита - Произвольный - Значение реквизита строкой или перечислением.
//
// Возвращаемое значение:
//  Результат - Преобразованное значение.
Функция ПолучитьВидМестаПечати(ЗначениеРеквизита) Экспорт
	
	Результат = Неопределено;
	
	// Преобразование из перечисления в строку.
	Если ЗначениеРеквизита = Перечисления.питВидыМестПечати.Принтер Тогда
		Результат = "0";
		
	ИначеЕсли ЗначениеРеквизита = Перечисления.питВидыМестПечати.ПивнойКран Тогда
		
		Результат = "1";
		
	ИначеЕсли ЗначениеРеквизита = Перечисления.питВидыМестПечати.ВскрытиеАлкоголя Тогда
		
		Результат = "2";
		
	ИначеЕсли ТипЗнч(ЗначениеРеквизита) = Тип("ПеречислениеСсылка.питВидыМестПечати") Тогда
		
		Результат = "0";
		
	// Обратное преобразование из строки в перечисление.
	ИначеЕсли ЗначениеРеквизита = "0" Тогда 
		
		Результат = Перечисления.питВидыМестПечати.Принтер;
		
	ИначеЕсли ЗначениеРеквизита = "1" Тогда
		
		Результат = Перечисления.питВидыМестПечати.ПивнойКран;
		
	ИначеЕсли ЗначениеРеквизита = "2" Тогда
		
		Результат = Перечисления.питВидыМестПечати.ВскрытиеАлкоголя;
		
	Иначе
		
		Результат = Перечисления.питВидыМестПечати.Принтер;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Функция - Получить данные по виду алкогольной продукции.
//
// Параметры:
//  ВидАлкогольнойПродукции - Произвольный - Вид алкогольной продукции.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьДанныеПоВидуАлкогольнойПродукции(ВидАлкогольнойПродукции) Экспорт
	
	РеквизитыАП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидАлкогольнойПродукции, "ВидЛицензии, Код");
	ВидЛицензииПеречисление = РеквизитыАП.ВидЛицензии;
	РеквизитыАП.ВидЛицензии = "0";
	Если ВидЛицензииПеречисление = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция Тогда
		РеквизитыАП.ВидЛицензии = "1";
	ИначеЕсли ВидЛицензииПеречисление = Перечисления.ВидыЛицензийАлкогольнойПродукции.Пиво Тогда
		РеквизитыАП.ВидЛицензии = "2";
	КонецЕсли;
	
	Возврат РеквизитыАП;
КонецФункции

// Функция - Преобразовать значение для обмена.
//
// Параметры:
//  ЗначениеРеквизита - Произвольный - Значение реквизита строкой или перечислением.
//  ВидПродукцииИС - Произвольный - Вид продукции ИСМП.
//
// Возвращаемое значение:
//  Результат - Преобразованное значение.
Функция ПолучитьВидЛицензииАлкогольнойПродукции(ЗначениеРеквизита, ВидПродукцииИС = Неопределено) Экспорт
	
	Результат = Неопределено;
	
	
	// Преобразование из перечисления в строку.
	Если ЗначениеРеквизита = Перечисления.ВидыЛицензийАлкогольнойПродукции.ПустаяСсылка() Тогда
		Результат = "0";
		
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция
		ИЛИ питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииАлкоголя(ВидПродукцииИС) Тогда
		
		Результат = "1";
		
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыЛицензийАлкогольнойПродукции.Пиво
		ИЛИ питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииПива(ВидПродукцииИС) Тогда
		
		Результат = "2";
		
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт Тогда
		
		Результат = "3";
		
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяНеПищеваяПродукция Тогда
		
		Результат = "4";
		
	ИначеЕсли ЗначениеРеквизита = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяПищеваяПродукция Тогда
		
		Результат = "5";
		
	ИначеЕсли ТипЗнч(ЗначениеРеквизита) = Тип("ПеречислениеСсылка.ВидыЛицензийАлкогольнойПродукции") Тогда
		
		Результат = "0";
		
	// Обратное преобразование из строки в перечисление.
	ИначеЕсли ЗначениеРеквизита = "0" Тогда 
		
		Результат = Перечисления.ВидыЛицензийАлкогольнойПродукции.ПустаяСсылка();
		
	ИначеЕсли ЗначениеРеквизита = "1" Тогда
		
		Результат = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция;
		
	ИначеЕсли ЗначениеРеквизита = "2" Тогда
		
		Результат = Перечисления.ВидыЛицензийАлкогольнойПродукции.Пиво;
		
	ИначеЕсли ЗначениеРеквизита = "3" Тогда
		
		Результат = Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт;
		
	ИначеЕсли ЗначениеРеквизита = "4" Тогда
		
		Результат = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяНеПищеваяПродукция;
		
	ИначеЕсли ЗначениеРеквизита = "5" Тогда
		
		Результат = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяПищеваяПродукция;
		
	Иначе
		
		Результат = Перечисления.ВидыЛицензийАлкогольнойПродукции.ПустаяСсылка();
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

