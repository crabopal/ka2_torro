// Функция - Получить систему налогообложения организации.
//
// Параметры:
//  ТекОрганизация - Произвольный - Входное значение.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьСистемуНалогообложенияОрганизации(ТекОрганизация) Экспорт
	
	НастройкиСистемыНалогообложения = НастройкиНалоговУчетныхПолитик.ДействующиеПараметрыНалоговУчетныхПолитикНаДату(
		"НастройкиСистемыНалогообложения",
		ТекОрганизация,
		ТекущаяДатаСеанса(),
		Истина);
		
	НастройкиУчетаУСН = НастройкиНалоговУчетныхПолитик.ДействующиеПараметрыНалоговУчетныхПолитикНаДату(
		"НастройкиУчетаУСН",
		ТекОрганизация,
		ТекущаяДатаСеанса(),
		Истина);
	
	Результат = Неопределено;
	
	// Преобразование из перечисления в строку.
	Если НастройкиСистемыНалогообложения.ПрименяетсяПСН Тогда
		
		Результат = "3";
		
	ИначеЕсли НастройкиСистемыНалогообложения.ПрименяетсяЕНВД Тогда
		
		Результат = "4";
		
	ИначеЕсли НастройкиСистемыНалогообложения.ПрименяетсяАУСН Тогда
		
		Результат = "6";
		
	ИначеЕсли НастройкиСистемыНалогообложения.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая Тогда
		
		Результат = "0";
		
	ИначеЕсли НастройкиСистемыНалогообложения.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная
		И НастройкиУчетаУСН.ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.Доходы Тогда
		
		Результат = "1";
		
	ИначеЕсли НастройкиСистемыНалогообложения.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
		
		Результат = "2";
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция возвращает параметры учета НДС по организации.
//
// Параметры:
// 	ТекОрганизация - СправочникСсылка.Организации - Организация, для которой необходимо получить параметры.
// 	ТекПериод - Дата - Дата, на которую необходимо получить параметры учета.
// 
// Возвращаемое значение:
