// Модуль процедур и функций для поддержки механизма обмена данными с удаленными кассами.

// Возвращает массив организаций кассового узла.
//
// Параметры:
//  КассовыйУзелСсылка - Произвольный - Кассовый узел ссылка.
//
// Возвращаемое значение:
//  Массив - Результат обработки.
Функция ПолучитьМассивОрганизацийКассовогоУзла(КассовыйУзелСсылка) Экспорт
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(КассовыйУзелСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(КассовыйУзелСсылка) <> Тип("ПланОбменаСсылка.питУдаленныеКассы") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если КассовыйУзелСсылка.Многофирменность Тогда
		ТЗ = "ВЫБРАТЬ
			|	УдаленныеКассыДополнительныеОрганизации.Организация КАК Ссылка
			|ИЗ
			|	ПланОбмена.питУдаленныеКассы.ДополнительныеОрганизации КАК УдаленныеКассыДополнительныеОрганизации
			|ГДЕ
			|	УдаленныеКассыДополнительныеОрганизации.Ссылка = &ВыбКассовыйУзел";
		
		Запрос = Новый Запрос(ТЗ);
		Запрос.УстановитьПараметр("ВыбКассовыйУзел", КассовыйУзелСсылка);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
		КонецЕсли;
		
	КонецЕсли;
	
	// Добавим основную организацию (она же по-умолчанию).
	Если ЗначениеЗаполнено(КассовыйУзелСсылка.Организация) Тогда
		Результат.Добавить(КассовыйУзелСсылка.Организация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает булев результат проверки принадлежности переданной в параметре
//  организации к кассовому узлу.
//
// Параметры:
//  ОрганизацияСсылка - Произвольный - Организация ссылка.
//  КассовыйУзелСсылка - Произвольный - Кассовый узел ссылка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОрганизацияПринадлежитКассовомуУзлу(ОрганизацияСсылка, КассовыйУзелСсылка) Экспорт
	
	МассивОрганизаций = ПолучитьМассивОрганизацийКассовогоУзла(КассовыйУзелСсылка);
	
	Если МассивОрганизаций.Найти(ОрганизацияСсылка) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

