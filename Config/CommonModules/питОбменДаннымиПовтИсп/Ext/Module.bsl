// Функция - Получить ссылку на право из кода строкой
//
// Параметры:
//  КодСтрокой - Строка - Строка кода прав.
//  ИмяОбъекта - Произвольный - Имя объекта.
//
// Возвращаемое значение:
//  СправочникСсылка.питПереченьПравФронта - Ссылка на право
Функция ПолучитьСсылкуНаПравоИзКодаСтрокой(КодСтрокой, ИмяОбъекта) Экспорт
	
	КодЧислом = Число(КодСтрокой);
	Если СтрДлина(СокрЛП(КодСтрокой)) = 3 Тогда
		КодПрава = Прав("000" + XMLСтрока(КодЧислом), 3);
	Иначе
		КодПрава = Прав("00000" + XMLСтрока(КодЧислом), 5);
	КонецЕсли;
	
	// Получим менеджер объекта
	ИмяОбъектаМенеджер = ИмяОбъекта;
	Если питОбменДаннымиПовтИсп.Латиница(ИмяОбъектаМенеджер) Тогда 
		ТаблицуСоответствийИмен = питОбменДаннымиПовтИсп.ПолучитьТаблицуСоответствийИменОбъектов();
		ИмяОбъектаМенеджер = ТаблицуСоответствийИмен.Получить(ИмяОбъектаМенеджер);
		Если ИмяОбъектаМенеджер = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	МенеджерОбъекта = питОбменДаннымиПовтИсп.ПолучитьМенеджерОбъектаПоИмени(ИмяОбъектаМенеджер);
	
	// Попытаемся найти элемент с таким кодом в базе
	ПравоСсл = МенеджерОбъекта.НайтиПоКоду(КодПрава);
	Если ПравоСсл.Пустая() Тогда
		// Возможно не было "ведущих нулей" при записи числового кода
		ПравоСсл = МенеджерОбъекта.НайтиПоКоду("" + КодЧислом);
	КонецЕсли;
	
	Возврат ПравоСсл;
	
КонецФункции

// Функция получения значения перечисления "ВидыОплат" строкой
//
// Параметры:
//  ВидОплаты - ПеречислениеСсылка.ВидыОплат - Ссылка на перечисление.
//  ЭтоВыгрузкаНО - Произвольный - Это выгрузка но.
//
// Возвращаемое значение:
//  Структура - Перечисление в виде строки для XML сообщения и строка названия картинки.
Функция ПолучитьВидыОплатСтрокой(ВидОплаты, ЭтоВыгрузкаНО = Ложь) Экспорт
	
	Результат = "";
	Картинка = "";
	// ВидОплаты Method.
	// 0 Наличные
	// 1 ПлатежнаяКарта
	// 2 БезНал (РестАрт)
	// 3 Клубная карта (РестАрт)
	// 4 Талоны и купоны
	// 5 Питание сотрудников
	// 6 За счет заведения / Бонусы розницы
	// 7 Депозитные карты/ системы лояльности
	// 8 Зачет аванса
	// 9 В рассрочку
	// 10 Банковский кредит
	// 11 Подарочный сертификат
	// 12 Встречное предоставление
	Попытка
		Если ВидОплаты = Перечисления.питТипыОплат.Наличные Тогда
			Результат = "0";
			Если ЭтоВыгрузкаНО Тогда
				Картинка = "Payment_Cash.bmp";
			КонецЕсли;
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.ПлатежнаяКарта Тогда
			Результат = "1"; 
			Если ЭтоВыгрузкаНО Тогда
				Картинка = "Payment_Card.bmp";
			КонецЕсли;
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.питТалоныИКупоны  Тогда
			Результат = "4";
			Если ЭтоВыгрузкаНО Тогда
				Картинка = "Payment_Ticket.bmp";
			КонецЕсли;
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.питПитаниеСотрудников Тогда
			Результат = "5";
			Если ЭтоВыгрузкаНО Тогда
				Картинка = "Payment_food.bmp";
			КонецЕсли;
			
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.питЗаСчетЗаведения Тогда
			Результат = "6";
			
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.питДепозитнаяКарта Тогда
			Результат = "7";
		
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.питЗачетАванса Тогда
			Результат = "8";
			
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.БанковскийКредит Тогда
			Результат = "10";
			
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.ПодарочныйСертификатСторонний Тогда
			Результат = "11";
			
		ИначеЕсли ВидОплаты = Перечисления.питТипыОплат.питВстречноеПредоставление Тогда
			Результат = "12";
							
		Иначе
			Результат = "0";
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("Преобразование перечисления ""питТипыОплат"" в XML строку", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	СтруктураРезультат = Новый Структура("ВидОплаты, Картинка", XMLСтрока(Результат), XMLСтрока(Картинка));
	Возврат СтруктураРезультат;
	
КонецФункции // ПолучитьВидыОплатСтрокой() 

// Функция получения строки вида "ЦветФонаКнопки, ЦветШрифтаНадписи1, ЦветШрифтаНадписи2"
//
// Параметры:
//  питЦветФонаКнопки - Произвольный - пит цвет фона кнопки.
//  питЦветШрифтаНадписи1 - Произвольный - пит цвет шрифта надписи 1.
//  питЦветШрифтаНадписи2 - Произвольный - пит цвет шрифта надписи 2.
//  питЦветШрифтаНадписи3 - Произвольный - пит цвет шрифта надписи 3.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
Функция ПолучитьДанныеЦветовВидыОплатСтрокой(питЦветФонаКнопки, питЦветШрифтаНадписи1, питЦветШрифтаНадписи2, питЦветШрифтаНадписи3) Экспорт
	
	// Строка вида "ЦветФонаКнопки, ЦветШрифтаНадписи1, ЦветШрифтаНадписи2".
	Если ПустаяСтрока(питЦветФонаКнопки) Тогда
		ЦветФонаКнопки = "-1";
	Иначе
		Попытка
			ЦветФонаКнопки = ЗначениеИзСтрокиВнутр(питЦветФонаКнопки);
			ЦветФонаКнопки = Формат(СмешатьЦвет(ЦветФонаКнопки.Красный, ЦветФонаКнопки.Зеленый, ЦветФонаКнопки.Синий), "ЧН=; ЧГ=''");
		Исключение
			ЦветФонаКнопки = "-1";
		КонецПопытки;
	КонецЕсли;
	
	Если ПустаяСтрока(питЦветШрифтаНадписи1) Тогда
		ЦветШрифтаНадписи1 = "-1";
	Иначе
		Попытка
			ЦветШрифтаНадписи1 = ЗначениеИзСтрокиВнутр(питЦветШрифтаНадписи1);
			ЦветШрифтаНадписи1 = Формат(СмешатьЦвет(ЦветШрифтаНадписи1.Красный, ЦветШрифтаНадписи1.Зеленый, ЦветШрифтаНадписи1.Синий), "ЧН=; ЧГ=''");
		Исключение
			ЦветШрифтаНадписи1 = "-1";
		КонецПопытки;
	КонецЕсли;
	
	Если ПустаяСтрока(питЦветШрифтаНадписи2) Тогда
		ЦветШрифтаНадписи2 = "-1";
	Иначе
		Попытка
			ЦветШрифтаНадписи2 = ЗначениеИзСтрокиВнутр(питЦветШрифтаНадписи2);
			ЦветШрифтаНадписи2 = Формат(СмешатьЦвет(ЦветШрифтаНадписи2.Красный, ЦветШрифтаНадписи2.Зеленый, ЦветШрифтаНадписи2.Синий), "ЧН=; ЧГ=''");
		Исключение
			ЦветШрифтаНадписи2 = "-1";
		КонецПопытки;
	КонецЕсли;
	
	Если ПустаяСтрока(питЦветШрифтаНадписи3) Тогда
		ЦветШрифтаНадписи3 = "-1";
	Иначе
		Попытка
			ЦветШрифтаНадписи3 = ЗначениеИзСтрокиВнутр(питЦветШрифтаНадписи3);
			ЦветШрифтаНадписи3 = Формат(СмешатьЦвет(ЦветШрифтаНадписи3.Красный, ЦветШрифтаНадписи3.Зеленый, ЦветШрифтаНадписи3.Синий), "ЧН=; ЧГ=''");
		Исключение
			ЦветШрифтаНадписи3 = "-1";
		КонецПопытки;
	КонецЕсли;
	
	Возврат ЦветФонаКнопки + "," + ЦветШрифтаНадписи1 + "," + ЦветШрифтаНадписи2 + "," + ЦветШрифтаНадписи3;
	
КонецФункции

// Функция получения значения перечисления "ВидыОплат" строкой
