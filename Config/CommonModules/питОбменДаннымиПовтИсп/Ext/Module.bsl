// 		* СтатьяРасходов_НеОблагаетсяНДС - ПланВидовХарактеристикСсылка.СтатьиРасходов - Статья списания НДС при изменении деятельности на необлагаемую НДС.
// 		* АналитикаРасходов_НеОблагаетсяНДС - Неопределено, Характеристика.СтатьиРасходов - Аналитика списания НДС при изменении деятельности на необлагаемую НДС.
// 		* СтатьяРасходов_ОблагаетсяЕНВД - ПланВидовХарактеристикСсылка.СтатьиРасходов - Статья списания НДС при изменении деятельности на облагаемую ЕНВД.
// 		* АналитикаРасходов_ОблагаетсяЕНВД - Неопределено, Характеристика.СтатьиРасходов - Аналитика списания НДС при изменении деятельности на облагаемую ЕНВД.
//		* ФормироватьНДСПредъявленныйПриВключенииВСтоимость - Булево - Признак формирования НДСПредъявленный при включении в стоимость.
//		* СписыватьНДСПоРасходамНеПринимаемымВНУ - Булево - Признак списания НДС по расходам, не принимаемым в НУ.
//		* СтавкаНДСПриУСН - СправочникСсылка.СтавкиНДС - Ставка НДС.
//
Функция ПараметрыУчетаНДСПоОрганизации(ТекОрганизация, ТекПериод) Экспорт
	
	// Для отладки
	//ПараметрыУчетаПоОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(ТекОрганизация, Дата("20250101"));
	ПараметрыУчетаПоОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(ТекОрганизация, ТекПериод);
	Возврат ПараметрыУчетаПоОрганизации;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает системный цвет.
//
// Параметры:
//  ТекЦветСтрокой - Произвольный - Тек цвет строкой.
//
// Возвращаемое значение:
// 	Строка. Представление цвета.
Функция ПолучитьСистемныйЦвет(ТекЦветСтрокой)
	
	Если ПустаяСтрока(ТекЦветСтрокой) Тогда
		Возврат -1;
	КонецЕсли;
	
	ТекЦвет = ЗначениеИЗСтрокиВнутр(ТекЦветСтрокой);
	
	Если ТекЦвет.Вид = ВидЦвета.Абсолютный Тогда
		Возврат СмешатьЦвет(ТекЦвет.Красный, ТекЦвет.Зеленый, ТекЦвет.Синий);
	Иначе
		Возврат -1;
	КонецЕсли;
	
КонецФункции

// Преобразует цвет в 10-ричном представлении в объект  "Цвет".
//
// Параметры:
//  ВходнойЦвет - Произвольный - Входной цвет.
//
// Возвращаемое значение:
//  Число - Результат обработки.
Функция ПреобразоватьДесятичноеЧислоВЦвет(ВходнойЦвет)
	
	Попытка
		ТекВходнойЦвет = Число(ВходнойЦвет);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТекВходнойЦвет >= 65536 Тогда
		ТекСиний = Цел(ТекВходнойЦвет/65536);
	Иначе
		ТекСиний = 0;
	КонецЕсли;
	ТекВходнойЦвет = ТекВходнойЦвет - ТекСиний*65536;
	 
	Если ТекВходнойЦвет >= 256 Тогда
		ТекЗеленый = Цел(ТекВходнойЦвет/256);
	Иначе
		ТекЗеленый = 0;
	КонецЕсли;
	ТекВходнойЦвет = ТекВходнойЦвет - ТекЗеленый*256;
	
	Если ТекВходнойЦвет >= 0 Тогда
		ТекКрасный = ТекВходнойЦвет;
	Иначе
		ТекКрасный = 0;
	КонецЕсли;
	
	ВыходнойЦвет = Новый Цвет(ТекКрасный, ТекЗеленый, ТекСиний);
	
	Возврат ВыходнойЦвет;
	
КонецФункции

// Преобразует число из шестнадцатиричного формата в десятичный.
//
// Параметры:
//  ВходноеЧисло - Число - Входное число.
//
// Возвращаемое значение:
//  Число - Результат обработки.
Функция ПреобразоватьШестнадцатиричноеЧислоВДесятичное(ВходноеЧисло)
	
	ВыходноеЧисло = 0;
	ДлинаСтроки = СтрДлина(ВходноеЧисло);
	
	НомерРазряда = ДлинаСтроки - 1;
	Инд = 1;
	Пока НомерРазряда >= 0 Цикл
		
		ТекСимвол = Сред(ВходноеЧисло, Инд, 1);
		Если ТекСимвол = "A" Тогда
			ТекСимвол = 10;
		ИначеЕсли ТекСимвол = "B" Тогда
			ТекСимвол = 11;
		ИначеЕсли ТекСимвол = "C" Тогда
			ТекСимвол = 12;
		ИначеЕсли ТекСимвол = "D" Тогда
			ТекСимвол = 13;
		ИначеЕсли ТекСимвол = "E" Тогда
			ТекСимвол = 14;
		ИначеЕсли ТекСимвол = "F" Тогда
			ТекСимвол = 15;
		КонецЕсли;
		
		Попытка
			ТекЧисло = Число(ТекСимвол);
		Исключение
			ТекЧисло = 0;
			Прервать;
		КонецПопытки;
		
		ТекЧисло = ТекЧисло * Pow(16, НомерРазряда);
						
		ВыходноеЧисло = ВыходноеЧисло + ТекЧисло;
		
		НомерРазряда = НомерРазряда - 1;
		Инд  = Инд + 1;
		
	КонецЦикла;
	
	Возврат ВыходноеЧисло;
	
КонецФункции

#КонецОбласти



