	Если ЭтоГруппа = Неопределено Тогда
		ЭтоГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник,"ЭтоГруппа");
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ИндивидуальныйСписокПользователей = Неопределено Тогда
		ИндивидуальныйСписокПользователей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассовыйУзелСсылка,"ИндивидуальныйСписокПользователей");
	КонецЕсли;
	
	Если НЕ ИндивидуальныйСписокПользователей Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Пользователь
	|ПОМЕСТИТЬ ВТ_Пользователи
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО Сотрудники.ФизическоеЛицо = Пользователи.ФизическоеЛицо
	|ГДЕ
	|	Сотрудники.Ссылка = &Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Пользователи.Пользователь КАК Пользователь
	|ИЗ
	|	ВТ_Пользователи КАК ВТ_Пользователи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.питУдаленныеКассы.Пользователи КАК питУдаленныеКассыПользователи
	|		ПО ВТ_Пользователи.Пользователь = питУдаленныеКассыПользователи.Пользователь
	|ГДЕ
	|	питУдаленныеКассыПользователи.Ссылка = &КассовыйУзелСсылка";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = НЕ РезультатЗапроса.Пустой();
	Возврат Результат;
КонецФункции

