// Функция получает код символа и определяет латинский ли он
//  Параметры
//
// Параметры:
//  Строка - Строка - Строка проверки.
//
// Возвращаемое значение:
//  Булево
Функция Латиница(Строка) Экспорт
	
	КодСимвола = КодСимвола(Строка, 1);
	Если КодСимвола >= 1 И КодСимвола <= 128 Тогда 
		Латиница = Истина;
	Иначе
		Латиница = Ложь;
	КонецЕсли;
	
	Возврат Латиница;
	
КонецФункции // Латиница()

// Функция получает менеджер объекта по имени
//
// Параметры:
//  ИмяОбъекта - Строка - Имя объекта в дереве метаданных.
//
// Возвращаемое значение:
//  Произвольный - Менеджер.
Функция ПолучитьМенеджерОбъектаПоИмени(ИмяОбъекта) Экспорт 
	
	МенеджерОбъекта = Неопределено;
	
	Попытка
		
		Если НЕ Метаданные.НайтиПоПолномуИмени("Справочник." + ИмяОбъекта) = Неопределено Тогда
			МенеджерОбъекта = Справочники[ИмяОбъекта];
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("Документ." + ИмяОбъекта) = Неопределено Тогда
			МенеджерОбъекта = Документы[ИмяОбъекта];
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("ПланОбмена." + ИмяОбъекта) = Неопределено Тогда
			МенеджерОбъекта = ПланыОбмена[ИмяОбъекта];
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("ПланВидовХарактеристик." + ИмяОбъекта) = Неопределено Тогда
			МенеджерОбъекта = ПланыВидовХарактеристик[ИмяОбъекта];
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("РегистрСведений." + ИмяОбъекта) = Неопределено Тогда
			МенеджерОбъекта = РегистрыСведений[ИмяОбъекта];
		ИначеЕсли НЕ Метаданные.НайтиПоПолномуИмени("РегистрНакопления." + ИмяОбъекта) = Неопределено Тогда
			МенеджерОбъекта = РегистрыНакопления[ИмяОбъекта];
		КонецЕсли;
		
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Не удалось получить менеджер объекта по переданному в параметр имени <" + ИмяОбъекта + ">";
		ЗаписьЖурналаРегистрации("ОшибкаИсключения.ПолучитьМенеджерОбъектаПоИмени", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат МенеджерОбъекта;
	
КонецФункции // ПолучитьМенеджерОбъектаПоИмени

// Получение уникального идентификатора по строке
//
// Параметры:
