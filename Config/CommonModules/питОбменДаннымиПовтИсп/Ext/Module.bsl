// Функция получения значения перечисления "СпособыПечатиЗаказа" строкой
//
// Параметры:
//  СпособПечати - ПеречислениеСсылка.СпособыПечатиЗаказа - Ссылка на перечисление.
//
// Возвращаемое значение:
//  Строка - Перечисление в виде строки для XML сообщения 
Функция ПолучитьСпособыПечатиЗаказаСтрокой(СпособПечати) Экспорт
	
	Результат = "";
	
	Попытка
		Если СпособПечати = Перечисления.питСпособыПечатиЗаказа.Параллельно Тогда
			Результат = "0";
		ИначеЕсли СпособПечати = Перечисления.питСпособыПечатиЗаказа.Последовательно Тогда
			Результат = "1";
		КонецЕсли;
