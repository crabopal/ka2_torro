Функция ПолучитьВидыОплатИзСтроки(ВидОплаты) Экспорт
	
	// Результат = "";
	Результат = Неопределено;
	
	// ВидОплаты Method.
	// 0 Наличные
	// 1 ПлатежнаяКарта
	// 2 БезНал (РестАрт)
	// 3 Клубная карта (РестАрт)
	// 4 Талоны и купоны
