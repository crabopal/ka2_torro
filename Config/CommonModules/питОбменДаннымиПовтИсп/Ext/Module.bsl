// Функция получения значения перечисления "ВидыОперацийПоЗагрузкеДанныхПродаж" строкой
//
// Параметры:
//  КассовыйУзелСсылка - Произвольный - Кассовый узел ссылка.
//  ВидОплаты - Произвольный - Вид оплаты.
//
// Возвращаемое значение:
//  Строка - Перечисление в виде строки для XML сообщения 
Функция ПолучитьДоступныйТипОплаты(КассовыйУзелСсылка, ВидОплаты) Экспорт
	
	Попытка
		Запрос = Новый Запрос;
		
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	питВидыОплатОрганизаций.Ссылка
		|ИЗ
		|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
		|ГДЕ
		|	питВидыОплатОрганизаций.ТипОплаты = &ВидОплаты";
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ВидОплаты", ВидОплаты);
		Запрос.УстановитьПараметр("КассовыйУзелСсылка", КассовыйУзелСсылка);
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Возврат Результат.Ссылка;
		Иначе
			Возврат Справочники.питВидыОплатОрганизаций.ПустаяСсылка();
		КонецЕсли;
		
	Исключение
		ТекстОшибки = "";
		ИнфОбОшибке = ИнформацияОбОшибке();
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ТекстОшибки = ТекстОшибки + Символы.ПС + ИнфОбОшибке.Описание;
			ИнфОбОшибке = ИнфОбОшибке.Причина;
		КонецЦикла;
		ТекстОшибки = ИнфОбОшибке.Описание + ТекстОшибки;
		ЗаписьЖурналаРегистрации("Ошибка при получении доступного типа оплаты", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
КонецФункции // ПолучитьВидыДоговоровСтрокой()



// Функция получения значения перечисления "ВидыОплат" строкой
//
// Параметры:
//  НазначениеВидаОплат - Произвольный - Назначение вида оплат.
//
// Возвращаемое значение:
//  Структура - Перечисление в виде строки для XML сообщения и строка названия картинки.
Функция ПолучитьНазначенияВидаОплатСтрокой(НазначениеВидаОплат) Экспорт
	
	Результат = "";
	
	Попытка
		Если НазначениеВидаОплат = Перечисления.питНазначенияВидовОплат.Универсальный Тогда
			Результат = "0";
		ИначеЕсли НазначениеВидаОплат = Перечисления.питНазначенияВидовОплат.Розница Тогда
			Результат = "1"; 
		ИначеЕсли НазначениеВидаОплат = Перечисления.питНазначенияВидовОплат.ВнесениеАванса Тогда
			Результат = "2";
		ИначеЕсли НазначениеВидаОплат = Перечисления.питНазначенияВидовОплат.ЗачетАванса Тогда
			Результат = "3";
		ИначеЕсли НазначениеВидаОплат = Перечисления.питНазначенияВидовОплат.ПередачаВКредит Тогда
			Результат = "4";
		ИначеЕсли НазначениеВидаОплат = Перечисления.питНазначенияВидовОплат.ОплатаКредита Тогда
			Результат = "5";
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("Преобразование перечисления ""рестНазначенияВидовОплат"" в XML строку", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ПолучитьВидыОплатСтрокой() 

// Функция получения значения перечисления "рестНазначениеВидаОплат" строкой
//
// Параметры:
//  НазначениеСтрокой - Произвольный - Назначение строкой.
//
// Возвращаемое значение:
//  Строка - Перечисление в виде строки для XML сообщения 
Функция ПолучитьНазначениеВидаОплатИзСтроки(НазначениеСтрокой) Экспорт
	
	Результат = Перечисления.питНазначенияВидовОплат.Универсальный;
	
	Попытка
		Если НазначениеСтрокой = "0" Тогда
			Результат = Перечисления.питНазначенияВидовОплат.Универсальный;
		ИначеЕсли НазначениеСтрокой = "1" Тогда
			Результат = Перечисления.питНазначенияВидовОплат.Розница;
		ИначеЕсли НазначениеСтрокой = "2"  Тогда
			Результат = Перечисления.питНазначенияВидовОплат.ВнесениеАванса; 
		ИначеЕсли НазначениеСтрокой = "3" Тогда
			Результат = Перечисления.питНазначенияВидовОплат.ЗачетАванса;
		ИначеЕсли НазначениеСтрокой = "4" Тогда
			Результат = Перечисления.питНазначенияВидовОплат.ПередачаВКредит;
		ИначеЕсли НазначениеСтрокой = "5" Тогда
			Результат = Перечисления.питНазначенияВидовОплат.ОплатаКредита;
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("Преобразование строки в перечисления ""рестНазначенияВидовОплат""", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ПолучитьВидыОплатИзСтроки() 


