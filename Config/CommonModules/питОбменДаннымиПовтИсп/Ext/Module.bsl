// Функция для удаления повторяющихся символов из указанной строки
//
// Параметры:
//  ИсходнаяСтрока - Строка - Исходная строка.
//  ПовторяющийсяСимвол - Произвольный - Повторяющийся символ.
//  УдалитьПоследнийЗнак - Произвольный - Удалить последний знак.
//
// Возвращаемое значение:
//  Строка - Исходная строка без повторяющихся символов. 
Функция УдалитьПовторяющиесяЗнаки(ИсходнаяСтрока, ПовторяющийсяСимвол,УдалитьПоследнийЗнак = Ложь) Экспорт
	
	ЕстьПовторяющиесяЗнаки = Истина;
	
	Попытка
		Пока ЕстьПовторяющиесяЗнаки Цикл
			Если Найти(ИсходнаяСтрока, ПовторяющийсяСимвол+ПовторяющийсяСимвол ) = 0 Тогда
				ЕстьПовторяющиесяЗнаки = Ложь;
			Иначе
				ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока,ПовторяющийсяСимвол+ПовторяющийсяСимвол,ПовторяющийсяСимвол);
			КонецЕсли;
		КонецЦикла;
		Если УдалитьПоследнийЗнак И Прав(ИсходнаяСтрока,1) = ПовторяющийсяСимвол Тогда
			ИсходнаяСтрока = Лев(ИсходнаяСтрока, СтрДлина(ИсходнаяСтрока)-1);
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("Удаление повторяющихся символов", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат ИсходнаяСтрока;
	
КонецФункции // УдалитьПовторяющиесяЗнаки()
//  Функция - Получить признак предмета расчета по виду номенклатуры
//
// Параметры:
//  ПризнакПредметаПоУмолчанию - Произвольный - Признак предмета по умолчанию.
//  питВидНоменклатуры - Произвольный - пит вид номенклатуры.
//  ПодакцизныйТовар - Произвольный - Подакцизный товар.
//
// Возвращаемое значение:
