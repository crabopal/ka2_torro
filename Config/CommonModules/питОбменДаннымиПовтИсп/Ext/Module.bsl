КонецФункции // БулевоИзСтроки()

// Преобразует значение типа "Строка" в тип "Дата"
//
// Параметры:
//  Значение - Произвольный - Значение.
//  ФорматДаты - Произвольный - Формат даты.
//
// Возвращаемое значение:
// 	Дата. 	
Функция ДатаИзСтроки(Значение, ФорматДаты = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Год 	= 1;
	Месяц 	= 1;
	День 	= 1;
	Час 	= 0;
	Минута 	= 0;
	Секунда = 0;
	
	СтрДлина = СтрДлина(Значение);
	ПозПервогоДвоеточия = Найти(Значение, ":");
	
	Если ПустаяСтрока(ФорматДаты) Тогда 
		// Определим формат даты
		Если (СтрДлина = 23) ИЛИ (СтрДлина = 22) Тогда
			Если (Число(Сред(Значение, 7, 4)) - Цел(Число(Сред(Значение, 7, 4))) = 0) Тогда 
				ФорматДаты = "dd.MM.yyyy HH:mm:ss.000";
			Иначе
				ФорматДаты = "yyyy.MM.dd HH:mm:ss.000";
			КонецЕсли;
		ИначеЕсли (СтрДлина = 19) ИЛИ (СтрДлина = 18) Тогда 
			Если (Число(Сред(Значение, 7, 4)) - Цел(Число(Сред(Значение, 7, 4))) = 0) Тогда 
				ФорматДаты = "dd.MM.yyyy HH:mm:ss";
			Иначе
				ФорматДаты = "yyyy.MM.dd HH:mm:ss";
			КонецЕсли;
		ИначеЕсли СтрДлина = 10 Тогда
			Если(Число(Сред(Значение, 7, 4)) - Цел(Число(Сред(Значение, 7, 4))) = 0) Тогда 
				ФорматДаты = "dd.MM.yyyy";
			Иначе
				ФорматДаты = "yyyy.MM.dd";
			КонецЕсли;
		ИначеЕсли (СтрДлина = 8) ИЛИ (СтрДлина = 7) Тогда
			ФорматДаты = "HH:mm:ss";
		КонецЕсли;
		
	КонецЕсли;
	
	// Получим значения даты
	Если ФорматДаты = "dd.MM.yyyy" Тогда
		// 22.09.2009
		Год 	= Число(Сред(Значение, 7, 4));
		Месяц 	= Число(Сред(Значение, 4, 2));
		День 	= Число(Сред(Значение, 1, 2));
		Час		= 0;
		Минута	= 0;
		Секунда	= 0;
		
	ИначеЕсли ФорматДаты = "yyyy.MM.dd" Тогда 
		// 2009.09.22
		Год 	= Число(Сред(Значение, 1, 4));
		Месяц 	= Число(Сред(Значение, 6, 2));
		День 	= Число(Сред(Значение, 9, 2));
		Час		= 0;
		Минута	= 0;
		Секунда	= 0;
		
	ИначеЕсли ФорматДаты = "dd.MM.yyyy HH:mm:ss" ИЛИ ФорматДаты = "dd.MM.yyyy HH:mm:ss.000" Тогда
		// 22.09.2009 11:08:54
		День 	= Число(Сред(Значение, 1, 2));
		Месяц 	= Число(Сред(Значение, 4, 2));
		Год 	= Число(Сред(Значение, 7, 4));
		
		ПозПервогоДвоеточия = Найти(Значение, ":");
		
		Попытка
			Час 	= Число(Сред(Значение, 12, ПозПервогоДвоеточия - 12));
		Исключение
			Час		= 0;
		КонецПопытки;
		Попытка
			Минута 	= Число(Сред(Значение, ПозПервогоДвоеточия + 1, 2));
		Исключение
			Минута 	= 0;
		КонецПопытки;
		Попытка
			Секунда	= Число(Сред(Значение, ПозПервогоДвоеточия + 4, 2));
		Исключение
			Секунда	= 0;
		КонецПопытки;
		
	ИначеЕсли ФорматДаты = "yyyy.MM.dd HH:mm:ss" ИЛИ ФорматДаты = "yyyy.MM.dd HH:mm:ss.000" Тогда 
		
		Год 	= Число(Сред(Значение, 1, 4));
		Месяц 	= Число(Сред(Значение, 6, 2));
		День 	= Число(Сред(Значение, 9, 2));
		
		ПозПервогоДвоеточия = Найти(Значение, ":");
		
		Попытка
			Час 	= Число(Сред(Значение, 12, ПозПервогоДвоеточия - 12));
		Исключение
			Час		= 0;
		КонецПопытки;
		Попытка
			Минута 	= Число(Сред(Значение, ПозПервогоДвоеточия + 1, 2));
		Исключение
			Минута 	= 0;
		КонецПопытки;
		Попытка
			Секунда	= Число(Сред(Значение, ПозПервогоДвоеточия + 4, 2));
		Исключение
			Секунда	= 0;
		КонецПопытки;
		
	ИначеЕсли Найти(ФорматДаты, "HH:mm:ss") > 0 Тогда
		// 11:08:54
		Год 	= 1;
		Месяц 	= 1;
		День 	= 1;
		ПозПервогоДвоеточия = Найти(Значение, ":");

		Если ПозПервогоДвоеточия = 0 Тогда
			Час = 0;
			Минута = 0;
			Секунда = 0;
		Иначе
			ПозицияПробел =  Найти(Значение, " "); 
			Если ПозицияПробел = 0 Тогда
				Час		= Число(Сред(Значение, 1, 2));
				Минута	= Число(Сред(Значение, 4, 2));
				Секунда	= Число(Сред(Значение, 7, 2));
			Иначе
				Час		= Число(Сред(Значение, ПозицияПробел + 1, ПозПервогоДвоеточия - ПозицияПробел - 1));
				Минута	= Число(Сред(Значение, ПозПервогоДвоеточия + 1, 2));
				Секунда	= Число(Сред(Значение, ПозПервогоДвоеточия + 4, 2));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	
КонецФункции // ПолучитьДатуПоСтроке

// Функция преобразует значение типа "Строка" в тип "Число"
//
// Параметры:
//  Значение - Строка - Значение, которое необходимо преобразовать в числ.
//
// Возвращаемое значение:
//  Число
Функция СтрокаВЧисло(Значение) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	Иначе
		ТекЗначение = СтрЗаменить(Значение, ",", ".");
		ТекЗначение = СтрЗаменить(ТекЗначение, Символы.НПП, "");
		Возврат XMLЗначение(Тип("Число"), ТекЗначение);
	КонецЕсли;
	
КонецФункции // СтрокаВЧисло()

