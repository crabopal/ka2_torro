	Результат = Новый Массив;
	
	Запр = Новый Запрос("ВЫБРАТЬ
	                    |	питУдаленныеКассы.Ссылка КАК Ссылка
	                    |ИЗ
	                    |	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	                    |ГДЕ
	                    |	питУдаленныеКассы.ВыгружатьМодификаторыНоменклатуры
	                    |	И НЕ (питУдаленныеКассы.Ссылка = &ЦентрУзел)");
						
	Запр.УстановитьПараметр("ЦентрУзел", ПланыОбмена.питУдаленныеКассы.ЭтотУзел());
