// Возвращаемое значение:
//  ПеречислениеСсылка.ЮрФизЛицо - Значение перечисления.
Функция ПолучитьЮрФизЛицоИзСтроки(ЗначениеРеквизита) Экспорт
	
	Результат = Перечисления.ЮрФизЛицо.ЮрЛицо;
	
	Попытка
		Если ЗначениеРеквизита = "0" Тогда 
			Результат = Перечисления.ЮрФизЛицо.ЮрЛицо;
		ИначеЕсли ЗначениеРеквизита =  "1" Тогда
			Результат = Перечисления.ЮрФизЛицо.ФизЛицо;
		ИначеЕсли ЗначениеРеквизита =  "2" Тогда
			Результат = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("Преобразование в перечисление ""ЗначениеРеквизита"" из XML строки", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

