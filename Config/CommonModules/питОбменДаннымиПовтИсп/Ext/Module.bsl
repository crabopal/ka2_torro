// Возвращает массив подразделений кассового узла включая подчиненные и родительские
//  элементы согласно иерархии справочника ""Подразделения компании"".
//
// Параметры:
//  КассовыйУзелСсылка - Произвольный - Кассовый узел ссылка.
//  ВключаяРодителей - Произвольный - Включая родителей.
//  ВключаяДетей - Произвольный - Включая детей.
//
// Возвращаемое значение:
//  СписокЗначений - Результат обработки.
Функция ПолучитьПолныйСписокПодразделенийКассовогоУзла(КассовыйУзелСсылка, ВключаяРодителей = Истина, ВключаяДетей = Истина) Экспорт
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(КассовыйУзелСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(КассовыйУзелСсылка) <> Тип("ПланОбменаСсылка.питУдаленныеКассы") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПолучитьМассивПодразделенийКассовогоУзла(КассовыйУзелСсылка);
	
	Если ВключаяДетей Тогда
		// Добавим в результат дочерние подразделения
		ТЗ = "ВЫБРАТЬ 
			|	СтруктураПредприятия.Ссылка КАК Подразделение
			|ИЗ
			|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
			|ГДЕ СтруктураПредприятия.Ссылка В ИЕРАРХИИ (&МассивПодразделений)";
			
		Запрос = Новый Запрос(ТЗ);
		Запрос.УстановитьПараметр("МассивПодразделений", Результат);
		РезультатЗапроса = Запрос.Выполнить();
			
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Результат2 = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Подразделение");
			Для Каждого Проверим ИЗ Результат2 Цикл
				Если Результат.Найти(Проверим) = Неопределено Тогда 
					Результат.Добавить(Проверим);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		
	КонецЕсли;
	
	Если ВключаяРодителей Тогда
		// Добавим в результат всех родителей
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СтруктураПредприятия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|ГДЕ
		|	СтруктураПредприятия.Ссылка В(&СписокПодр)
		|ИТОГИ ПО
		|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
			
		Запрос.УстановитьПараметр("СписокПодр", Результат);
		РезультатЗапроса = Запрос.Выполнить();
			
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Результат3 = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
			Для Каждого Проверим ИЗ Результат3 Цикл
				Если Результат.Найти(Проверим) = Неопределено Тогда 
					Результат.Добавить(Проверим);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает булев результат проверки имеет ли переданное в первом параметре Подразделение
//  какое-либо отношение к кассовому узлу (передается во втором параметре).
//
// Параметры:
//  ПодразделениеСсылка - Произвольный - Подразделение ссылка.
//  КассовыйУзелСсылка - Произвольный - Кассовый узел ссылка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПодразделениеИзвестноУзлу(ПодразделениеСсылка, КассовыйУзелСсылка) Экспорт
	
	МассивПодразделений = ПолучитьПолныйСписокПодразделенийКассовогоУзла(КассовыйУзелСсылка, Истина, Истина);
	
	Если МассивПодразделений.Найти(ПодразделениеСсылка) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

// Возвращает булев результат проверки должно ли переданное в первом параметре ВидОплатыОрганизации
//  быть известным кассовому узлу (передается во втором параметре).
