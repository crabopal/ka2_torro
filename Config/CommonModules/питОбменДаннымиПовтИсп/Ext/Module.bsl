КонецФункции

// Преобразует цвет из десятиричного формата в тип "Цвет".
//
// Параметры:
//  ВходнойЦвет - Произвольный - Входной цвет.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьЦветПоФорматуФронтОфиса(ВходнойЦвет) Экспорт
	
	ВходнойЦвет = СтрЗаменить(ВходнойЦвет, " ", "");
	Если ПустаяСтрока(ВходнойЦвет) ИЛИ ВходнойЦвет = "-1" Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	// Преобразование из шестнадцатиричного формата в десятичный, если необходимо.
	Если Сред(ВходнойЦвет, 1, 1) = "$" Тогда
		ВходноеЧисло = Сред(ВходнойЦвет, 2); 
		ВходнойЦвет = ПреобразоватьШестнадцатиричноеЧислоВДесятичное(ВходноеЧисло);
	КонецЕсли;
	
	// Получение цвета из десятичного представления.
	ВыходнойЦвет = ПреобразоватьДесятичноеЧислоВЦвет(ВходнойЦвет);
	
	Возврат ВыходнойЦвет;
	
КонецФункции

// Функция получает значение перечисления "ЮрФизЛицо" из строки.
//
// Параметры:
