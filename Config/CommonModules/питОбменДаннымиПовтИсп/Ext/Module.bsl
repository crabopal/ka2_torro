
#Область ПрограммныйИнтерфейс

#Область ФильтрацияНоменклатуры

// Функция получения выборки номенклатуры по видам меню кассового узла.
//
// Параметры:
//  ТипРезультата - Строка - Тип результата: "Выборка", "Соответствие".
//
// Возвращаемое значение:
//  Произвольный - Если значений нет, то Неопределено, иначе в зависимости от типа результата.
Функция ПолучитьНоменклатуруВВидовМеню(ТипРезультата = "") Экспорт 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.питМеню КАК ПрайсЛист
	|		ПО (ПрайсЛист.Номенклатура = СпрНоменклатура.Ссылка)
	|ГДЕ
	|	НЕ ПрайсЛист.Владелец.ПометкаУдаления
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Результат = Неопределено;
	ИначеЕсли ТипРезультата = "Соответствие" Тогда
		Результат = Новый Соответствие;
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Выборка.Ссылка);
		КонецЦикла;
	Иначе
		Результат = РезультатЗапроса.Выбрать();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ВыборкаВсейНоменклатурыВВидахМенюУзла()

// Функция получения выборки номенклатуры по видам меню кассового узла.
//
// Параметры:
//  КассовыйУзелСсылка - ПланОбмена.УдаленныеКассы - Ссылка на КУ для которого получаем выборку.
//  ТипРезультата - Строка - Тип результата: Выборка, ТаблицаЗначений, Соответствие.
//
// Возвращаемое значение:
//  Произвольный - Если значений нет, то Неопределено, иначе в зависимости от типа результата.
Функция ПолучитьНоменклатуруВВидовМенюУзла(КассовыйУзелСсылка, ТипРезультата = "") Экспорт 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УдаленныеКассыВидыМеню.ВидМеню
	|ПОМЕСТИТЬ ВидыМенюУзла
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.ВидыМеню КАК УдаленныеКассыВидыМеню
	|ГДЕ
	|	УдаленныеКассыВидыМеню.Ссылка = &ВыбУзел
	|
	|СГРУППИРОВАТЬ ПО
	|	УдаленныеКассыВидыМеню.ВидМеню
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыПрайсЛистов.Ссылка
	|ПОМЕСТИТЬ ВыгружаемыеВидыМеню
	|ИЗ
	|	Справочник.питВидыМеню КАК ВидыПрайсЛистов
	|ГДЕ
	|	ВидыПрайсЛистов.ЭтоГруппа = ЛОЖЬ
	|	И ВидыПрайсЛистов.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВидыМенюУзла.ВидМеню
	|			ИЗ
	|				ВидыМенюУзла КАК ВидыМенюУзла)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВидыПрайсЛистов.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрайсЛист.Номенклатура КАК Ссылка
	|ИЗ
	|	Справочник.питМеню КАК ПрайсЛист
	|ГДЕ
	|	ПрайсЛист.Владелец В
	|			(ВЫБРАТЬ
	|				ВыгружаемыеВидыМеню.Ссылка
	|			ИЗ
	|				ВыгружаемыеВидыМеню КАК ВыгружаемыеВидыМеню)
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВыбУзел", КассовыйУзелСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Результат = Неопределено;
	ИначеЕсли ТипРезультата = "ТаблицаЗначений" Тогда
		Результат = РезультатЗапроса.Выгрузить();
	ИначеЕсли ТипРезультата = "Соответствие" Тогда
		Результат = Новый Соответствие;
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Выборка.Ссылка);
		КонецЦикла;
	Иначе
		Результат = РезультатЗапроса.Выбрать();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ВыборкаВсейНоменклатурыВВидахМенюУзла

#КонецОбласти

