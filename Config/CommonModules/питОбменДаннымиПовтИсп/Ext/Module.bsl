			Результат = Перечисления.питТипыОплат.питПитаниеСотрудников;
		ИначеЕсли ВидОплаты = "6" Тогда
			Результат = Перечисления.питТипыОплат.питЗаСчетЗаведения;
		ИначеЕсли ВидОплаты = "7" Тогда
			Результат = Перечисления.питТипыОплат.питДепозитнаяКарта;
		ИначеЕсли ВидОплаты = "8" Тогда
			Результат = Перечисления.питТипыОплат.питЗачетАванса;
		ИначеЕсли ВидОплаты = "10" Тогда
			Результат = Перечисления.питТипыОплат.БанковскийКредит;
		ИначеЕсли ВидОплаты = "11" Тогда
			Результат = Перечисления.питТипыОплат.ПодарочныйСертификатСобственный;
		ИначеЕсли ВидОплаты = "12" Тогда
			Результат = Перечисления.питТипыОплат.питВстречноеПредоставление;
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("Преобразование строки в перечисления ""питТипыОплат""", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ПолучитьВидыОплатИзСтроки() 

// Преобразует значение цвета в формате Рестарта в реквизиты типы оплаты.
// Параметры:
//  ДанныеКнопки - Произвольный - Данные кнопки.
//
// Возвращаемое значение:
// 	 Структура - Реквизиты объекта.
Функция ПолучитьЦветаКнопкиТипаОплаты(ДанныеКнопки) Экспорт
	
	Если ДанныеКнопки = Неопределено ИЛИ ПустаяСтрока(ДанныеКнопки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЦветаКнопки = Новый Структура;
	МассивДанныеКнопки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ДанныеКнопки, ",");
	Если МассивДанныеКнопки.Количество() = 0 Тогда
		ЦветаКнопки.Вставить("ЦветФонаКнопки", 		Неопределено);
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи1", 	Неопределено); 	 	
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи2", 	Неопределено);
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи3", 	Неопределено);
	ИначеЕсли МассивДанныеКнопки.Количество() = 1 Тогда
		ЦветаКнопки.Вставить("ЦветФонаКнопки", ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[0]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи1", 	Неопределено); 	 	
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи2", 	Неопределено);
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи3", 	Неопределено);
	ИначеЕсли МассивДанныеКнопки.Количество() = 2 Тогда
		ЦветаКнопки.Вставить("ЦветФонаКнопки", 		ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[0]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи1", 	ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[1]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи2", 	Неопределено);
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи3", 	Неопределено);
	ИначеЕсли МассивДанныеКнопки.Количество() = 3 Тогда
		ЦветаКнопки.Вставить("ЦветФонаКнопки", 		ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[0]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи1", 	ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[1]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи2", 	ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[2]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи3", 	Неопределено);
	Иначе
		ЦветаКнопки.Вставить("ЦветФонаКнопки", 		ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[0]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи1", 	ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[1]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи2", 	ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[2]));
		ЦветаКнопки.Вставить("ЦветШрифтаНадписи3", 	ПолучитьЦветПоФорматуФронтОфиса(МассивДанныеКнопки[3]));
	КонецЕсли;
		
	Возврат ЦветаКнопки;	
	
КонецФункции

