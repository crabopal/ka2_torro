
#Область ПрограммныйИнтерфейс

// Функция проверяет наличие переданного подразделения и цеха в разрешенных
//  к использованию в производстве для переданной рецептуры.
//
// Параметры:
//  Рецептура - ДокументСсылка.Рецептура - Ссылка на рецептуру.
//  ПереданноеПодразделение - Произвольный - Переданное подразделение.
//  Цех - СправочникСсылка.Склады - Ссылка на цех.
//  УчитыватьЦех - Произвольный - Учитывать цех.
//  УчитыватьНастройкуПодразделениеПроизводства - Произвольный - Учитывать настройку подразделение производства.
//
// Возвращаемое значение:
//  Булево - Разрешено ли подразделение.
Функция удалитьПодразделениеРазрешено(Рецептура, ПереданноеПодразделение, Цех, УчитыватьЦех = Истина, УчитыватьНастройкуПодразделениеПроизводства = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Рецептура) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(ПереданноеПодразделение) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
		Подразделение = ПереданноеПодразделение;
	Иначе
		Подразделение = ПолучитьИзВременногоХранилища(ПереданноеПодразделение);
	КонецЕсли;
	
	Если УчитыватьНастройкуПодразделениеПроизводства И питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питПодразделениеПроизводстваПолуфабрикатов") = Перечисления.питПодразделенияПроизводстваПолуфабрикатов.ПодразделениеРецептуры Тогда
		РеквизитыРецептуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Рецептура, "Подразделение, ЦеховаяКладовая");
		ТекПодразделения = Новый Массив(1);
		ТекПодразделения[0] = РеквизитыРецептуры.Подразделение;
		ТекЦеховаяКладовая = РеквизитыРецептуры.ЦеховаяКладовая;
	Иначе
		Если ТипЗнч(Подразделение) = Тип("Массив") Тогда
			ТекПодразделения = Подразделение;
		Иначе
			ТекПодразделения = Новый Массив(1);
			ТекПодразделения[0] = Подразделение;
		КонецЕсли;
		ТекЦеховаяКладовая = Цех;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептураРазрешенныеПодразделения.Подразделение КАК Подразделение,
	|	питРецептураРазрешенныеПодразделения.ЦеховаяКладовая КАК ЦеховаяКладовая,
	|	питРецептураРазрешенныеПодразделения.ВключаяПодчиненные КАК ВключаяПодчиненные
	|ПОМЕСТИТЬ втПодразделенияПроизводства
	|ИЗ
	|	Документ.питРецептура.РазрешенныеПодразделения КАК питРецептураРазрешенныеПодразделения
	|ГДЕ
	|	питРецептураРазрешенныеПодразделения.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктураПредприятия.Ссылка КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК ЦеховаяКладовая
	|ПОМЕСТИТЬ втПодразделенияСИерархией
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|ГДЕ
	|	СтруктураПредприятия.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				втПодразделенияПроизводства.Подразделение
	|			ИЗ
	|				втПодразделенияПроизводства КАК втПодразделенияПроизводства
	|			ГДЕ
	|				втПодразделенияПроизводства.ВключаяПодчиненные = ИСТИНА)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втПодразделенияПроизводства.Подразделение,
	|	втПодразделенияПроизводства.ЦеховаяКладовая
	|ИЗ
	|	втПодразделенияПроизводства КАК втПодразделенияПроизводства
	|ГДЕ
	|	втПодразделенияПроизводства.ВключаяПодчиненные = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПодразделенияСИерархией.Подразделение КАК Подразделение,
	|	втПодразделенияСИерархией.ЦеховаяКладовая КАК ЦеховаяКладовая
	|ПОМЕСТИТЬ втПодразделения
	|ИЗ
	|	втПодразделенияСИерархией КАК втПодразделенияСИерархией
	|
	|СГРУППИРОВАТЬ ПО
	|	втПодразделенияСИерархией.Подразделение,
	|	втПодразделенияСИерархией.ЦеховаяКладовая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА втПодразделения.Подразделение В (&Подразделения)
	|				"+?(УчитыватьЦех, "ТОГДА ВЫБОР
	|						КОГДА втПодразделения.ЦеховаяКладовая = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ВЫБОР
	|								КОГДА втПодразделения.ЦеховаяКладовая = &Цех
	|									ТОГДА ИСТИНА
	|								ИНАЧЕ ЛОЖЬ
	|							КОНЕЦ
	|					КОНЕЦ","ТОГДА ИСТИНА")+"
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Разрешено
	|ИЗ
	|	втПодразделения КАК втПодразделения";
	
	Запрос.УстановитьПараметр("Подразделения", ТекПодразделения);
	Запрос.УстановитьПараметр("Ссылка", Рецептура);
	Запрос.УстановитьПараметр("Цех", ТекЦеховаяКладовая);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Разрешено = Ложь;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Разрешено = NULL Тогда
			Разрешено = Ложь;
		Иначе
			Разрешено = ВыборкаДетальныеЗаписи.Разрешено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Разрешено;
	
КонецФункции

// Функция проверяет наличие переданного подразделения и цеха в разрешенных
//  к использованию в производстве для переданной рецептуры.
//
// Параметры:
//  Рецептура - ДокументСсылка.Рецептура - Ссылка на рецептуру.
//  ПереданноеПодразделение - Произвольный - Переданное подразделение.
//  Цех - СправочникСсылка.Склады - Ссылка на цех.
//  УчитыватьЦех - Произвольный - Учитывать цех.
//  УчитыватьНастройкуПодразделениеПроизводства - Произвольный - Учитывать настройку подразделение производства.
//  ПодразделениеПроизводстваПолуфабрикатов - Произвольный - Подразделение производства полуфабрикатов.
//
// Возвращаемое значение:
//  Булево - Разрешено ли подразделение.
Функция ПодразделениеРазрешено(Рецептура, ПереданноеПодразделение, Цех, УчитыватьЦех = Истина, УчитыватьНастройкуПодразделениеПроизводства = Истина, Знач ПодразделениеПроизводстваПолуфабрикатов = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Рецептура) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = Ложь;
	
	Если ПодразделениеПроизводстваПолуфабрикатов = Неопределено Тогда
		ПодразделениеПроизводстваПолуфабрикатов = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питПодразделениеПроизводстваПолуфабрикатов");
	КонецЕсли;
	
	Если УчитыватьНастройкуПодразделениеПроизводства И ПодразделениеПроизводстваПолуфабрикатов = Перечисления.питПодразделенияПроизводстваПолуфабрикатов.ПодразделениеРецептуры Тогда
		
		// В подразделении рецептуры всегда умеем готовить
		Результат = Истина;
		
	Иначе
		
		РеквизитыРецептуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Рецептура, 
		"ДатаНачала, ДатаКонца");
		
		Подразделение		= ПереданноеПодразделение;
		ТекЦеховаяКладовая	= Цех;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	питАктуальныеРецептурыСрезПоследних.Рецептура КАК Рецептура,
		|	питАктуальныеРецептурыСрезПоследних.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.питАктуальныеРецептуры.СрезПоследних(
		|			&ДанаНачала,
		|			Рецептура = &Рецептура
		|				И Подразделение = &Подразделение) КАК питАктуальныеРецептурыСрезПоследних";
		
		Запрос.УстановитьПараметр("ДанаНачала"				, РеквизитыРецептуры.ДатаНачала);
		
		Запрос.УстановитьПараметр("Рецептура"				, Рецептура);
		Запрос.УстановитьПараметр("Подразделение"			, Подразделение);
		
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			РецептураНайдена = Ложь;
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаОкончания) 
					ИЛИ ВыборкаДетальныеЗаписи.ДатаОкончания >= РеквизитыРецептуры.ДатаКонца Тогда
					РецептураНайдена = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если РецептураНайдена Тогда
				
				Если УчитыватьЦех Тогда
					
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	МАКСИМУМ(ВЫБОР
					|			КОГДА питРецептураРазрешенныеПодразделения.ЦеховаяКладовая = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
					|				ТОГДА ИСТИНА
					|			ИНАЧЕ ВЫБОР
					|					КОГДА питРецептураРазрешенныеПодразделения.ЦеховаяКладовая = &Цех
					|						ТОГДА ИСТИНА
					|					ИНАЧЕ ЛОЖЬ
					|				КОНЕЦ
					|		КОНЕЦ) КАК ЦехРазрешен
					|ИЗ
					|	Документ.питРецептура.РазрешенныеПодразделения КАК питРецептураРазрешенныеПодразделения
					|ГДЕ
					|	питРецептураРазрешенныеПодразделения.Ссылка = &Ссылка
					|	И питРецептураРазрешенныеПодразделения.Подразделение = &Подразделение";
					
					Запрос.УстановитьПараметр("Подразделение", Подразделение);
					Запрос.УстановитьПараметр("Ссылка", Рецептура);
					Запрос.УстановитьПараметр("Цех", Цех);
					РезультатЗапроса = Запрос.Выполнить();
					Если РезультатЗапроса.Пустой() Тогда
						Результат = Истина; // Такой случай возможен только если подразделение было в иерархии, для таких подразделений все цеха разрешены
					Иначе
						ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
						ВыборкаДетальныеЗаписи.Следующий();
						Результат = ?(ВыборкаДетальныеЗаписи.ЦехРазрешен = Null, Истина, ВыборкаДетальныеЗаписи.ЦехРазрешен);
					КонецЕсли;
					
				Иначе
					Результат = Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


//  Функция - Найти подразделения рецептуры.
//
// Параметры:
//  Рецептура - Произвольный - Рецептура.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НайтиПодразделенияРецептуры(Рецептура = Неопределено) Экспорт
	
	Результат = Новый Массив;
	Если НЕ Рецептура = Неопределено И НЕ ЗначениеЗаполнено(Рецептура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептураРазрешенныеПодразделения.Подразделение КАК Подразделение,
	|	питРецептураРазрешенныеПодразделения.ВключаяПодчиненные КАК ВключаяПодчиненные
	|ПОМЕСТИТЬ втПодразделенияПроизводства
	|ИЗ 
	|	Документ.питРецептура.РазрешенныеПодразделения КАК питРецептураРазрешенныеПодразделения
	|ГДЕ
	|	питРецептураРазрешенныеПодразделения.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктураПредприятия.Ссылка КАК Подразделение
	|ПОМЕСТИТЬ втПодразделенияСИерархией
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|ГДЕ
	|	СтруктураПредприятия.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				втПодразделенияПроизводства.Подразделение
	|			ИЗ
	|				втПодразделенияПроизводства КАК втПодразделенияПроизводства
	|			ГДЕ
	|				втПодразделенияПроизводства.ВключаяПодчиненные = ИСТИНА)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втПодразделенияПроизводства.Подразделение
	|ИЗ
	|	втПодразделенияПроизводства КАК втПодразделенияПроизводства
	|ГДЕ
	|	втПодразделенияПроизводства.ВключаяПодчиненные = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПодразделенияСИерархией.Подразделение КАК Подразделение
	|ИЗ
	|	втПодразделенияСИерархией КАК втПодразделенияСИерархией
	|
	|СГРУППИРОВАТЬ ПО
	|	втПодразделенияСИерархией.Подразделение
	|";
	
	Запрос.УстановитьПараметр("Ссылка", Рецептура);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подразделение");
	
	Возврат Результат;
	
КонецФункции

//  Функция - Получить имя основной конфигурации.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьИмяОсновнойКонфигурации() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВерсииПодсистем.ИмяПодсистемы КАК ИмяПодсистемы
	|ИЗ
	|	РегистрСведений.ВерсииПодсистем КАК ВерсииПодсистем
	|ГДЕ
	|	ВерсииПодсистем.ЭтоОсновнаяКонфигурация = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат = "";
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Результат = ВыборкаДетальныеЗаписи.ИмяПодсистемы;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

// Функция вызывает типовую
//
// Параметры:
//  Валюта	 - Произвольный	 - Валюта.
// 
// Возвращаемое значение:
//  СправочникСсылка.Валюты - Валюта регламентированного учета.
//
Функция ПолучитьВалютуРегламентированногоУчета(Знач Валюта = Неопределено) Экспорт
	
	Возврат ЗначениеНастроекПовтИсп.ПолучитьВалютуРегламентированногоУчета(Валюта);
	
КонецФункции


// Возвращает курс валюты на дату.
//
// Параметры:
//   Валюта    - СправочникСсылка.Валюты - валюта, для которой получается курс.
//   ДатаКурса - Дата - дата, на которую получается курс.
//
// Возвращаемое значение: 
//   Структура:
//    * Курс      - Число - курс валюты на указанную дату.
//    * Кратность - Число - кратность валюты на указанную дату.
//    * Валюта    - СправочникСсылка.Валюты - ссылка валюты.
//    * ДатаКурса - Дата - дата получения курса.
//
Функция ПолучитьКурсВалюты(Валюта, ДатаКурса) Экспорт
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ДатаКурса);
	
КонецФункции

#КонецОбласти




