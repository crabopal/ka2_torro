
#Область ПрограммныйИнтерфейс
// Возвращает структуру параметров для сообщений прогресса выполнения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НовыеПараметрыСообщенийПрогресса() Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Ссылка",           ПредопределенноеЗначение("Документ.питДанныеПродажФронта.ПустаяСсылка"));
	Результат.Вставить("Организация",      ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
	Результат.Вставить("НачальноеЗначение"); 	// Число или Дата - начальная граница диапазона
	Результат.Вставить("КонечноеЗначение");  	// Число или Дата - конечная граница диапазона
	Результат.Вставить("ДостигнутоеЗначение");  // Число или Дата - текущее положение
	Результат.Вставить("ИмяЭтапа", ИмяЭтапаПроведениеДокументов());
	// Сообщение прогресса связано с контролем наличия ранее запущенных фоновых заданий на файловой базе.
	Результат.Вставить("КонтрольРанееЗапущенных", Истина); // Булево

	Возврат Результат;

КонецФункции

//  Функция - Имя этапа проведение документов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ИмяЭтапаПроведениеДокументов() Экспорт

	Возврат "ПроведениеДокументов";

КонецФункции

//  Функция - Описание процесса длительной операции.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ОписаниеПроцессаДлительнойОперации() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьАктуализациюРасчетовСКонтрагентами", Ложь);
	Результат.Вставить("ИспользоватьЗакрытиеМесяца", Ложь);
	Результат.Вставить("ИспользоватьПроведениеДокументов", Ложь);
	Результат.Вставить("ИспользоватьПерепроведениеДокументов", Ложь);
	Результат.Вставить("КоличествоМесяцев", 1);
	Результат.Вставить("КоличествоОрганизаций", 1);
	Результат.Вставить("Месяц", '0001-01-01');
	Результат.Вставить("Организация"); // СправочникСсылка.Организации
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти



