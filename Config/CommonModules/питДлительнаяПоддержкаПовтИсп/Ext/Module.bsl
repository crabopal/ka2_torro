// Определение запуска на новой версии ЕРП 2.5.26+
// 
// Возвращаемое значение:
//  Булево - Истина, если версия новая 2.5.26 и более
//
Функция ИспользоватьНовыйВызов2526() Экспорт
	
	НовыйВызов = Истина;
	ВерсияЕРП = питОбщегоНазначения.ПолучитьВерсиюКонфигурацииУправлениеПредприятием(Истина);
	ВерсияЕРПМассив = СтрРазделить(ВерсияЕРП, ".");
	Если ВерсияЕРПМассив.Количество() >= 3 Тогда
		РедакцияИПодредакция = СтрШаблон("%1.%2", ВерсияЕРПМассив[0], ВерсияЕРПМассив[1]);
		НомерРелиза = Число(ВерсияЕРПМассив[2]);
		Если РедакцияИПодредакция = "2.5"
			И НомерРелиза < 26 Тогда
			НовыйВызов = Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат НовыйВызов;
	
КонецФункции

