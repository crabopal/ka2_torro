// +пит
//
// Параметры:
//  ИмяОперацииВетис - Произвольный - Имя операции ветис.
//  СоответствиеПолей - Соответствие - Соответствие полей.
//
Процедура ДобавитьСоответствиеПолейВыпускБлюд(ИмяОперацииВетис, СоответствиеПолей) Экспорт
	
	ИмяХСПолучатель = "";
	ИмяПредприятиеПолучатель = "";
	Если ИмяОперацииВетис = "ПроизводственнаяОперация" Тогда
		ИмяХС				= "ХозяйствующийСубъект";
		ИмяПредприятие		= "Предприятие";
	ИначеЕсли ИмяОперацииВетис = "ИсходящаяОперация" Тогда
		ИмяХС						= "ГрузоотправительХозяйствующийСубъект";
		ИмяПредприятие				= "ГрузоотправительПредприятие";
		ИмяХСПолучатель				= "ГрузополучательХозяйствующийСубъект";
		ИмяПредприятиеПолучатель	= "ГрузополучательПредприятие";
	Иначе
		ИмяХС				= "ХозяйствующийСубъект";
		ИмяПредприятие		= "Предприятие";
	КонецЕсли;
	
	СоответствиеПолей.Вставить("питВыпускБлюд", Новый Соответствие);
	СоответствиеПолей["питВыпускБлюд"].Вставить(ИмяХС, "Организация");
	СоответствиеПолей["питВыпускБлюд"].Вставить(ИмяПредприятие, "Склад");
	Если НЕ ПустаяСтрока(ИмяХСПолучатель) Тогда
		СоответствиеПолей["питВыпускБлюд"].Вставить(ИмяХСПолучатель, "Организация");
	КонецЕсли;
	Если НЕ ПустаяСтрока(ИмяПредприятиеПолучатель) Тогда
		СоответствиеПолей["питВыпускБлюд"].Вставить(ИмяПредприятиеПолучатель, "СкладПолучатель");
	КонецЕсли;
	
КонецПроцедуры
// -пит

// +пит
//
// Параметры:
//  ИмяОперацииВетис - Произвольный - Имя операции ветис.
//  СоответствиеПолей - Соответствие - Соответствие полей.
//
Процедура ДобавитьСоответствиеПолейРазделка(ИмяОперацииВетис, СоответствиеПолей) Экспорт
	
	ИмяХС				= "ХозяйствующийСубъект";
	ИмяПредприятие		= "Предприятие";
	
	СоответствиеПолей.Вставить("питРазделка", Новый Соответствие);
	СоответствиеПолей["питРазделка"].Вставить(ИмяХС, "Организация");
	СоответствиеПолей["питРазделка"].Вставить(ИмяПредприятие, "Склад");	
	
КонецПроцедуры
// -пит

// +пит
//
// Параметры:
//  ИмяОперацииВетис - Произвольный - Имя операции ветис.
//  СоответствиеПолей - Соответствие - Соответствие полей.
//
Процедура ДобавитьСоответствиеПолейДокументовОбщепит(ИмяОперацииВетис, СоответствиеПолей) Экспорт
	
	ДобавитьСоответствиеПолейВыпускБлюд(ИмяОперацииВетис, СоответствиеПолей);
	ДобавитьСоответствиеПолейРазделка(ИмяОперацииВетис, СоответствиеПолей);
	
КонецПроцедуры

