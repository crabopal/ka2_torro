
#Область ПрограммныйИнтерфейс

#Область ОбработчикиОбновления

// Процедура - Установить предопределенные элементы хасп.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура УстановитьПредопределенныеЭлементыХасп(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Справочники.питОценкиОрганолептики.ПроверитьСоздатьОценкиОрганолептики();
	Справочники.питТипыОпасныхФакторов.ПроверитьСоздатьПредопределенныеЭлементы();
	питОбщегоНазначенияHACCP.ЗаполнитьЗначенияКонстантПоУмолчанию();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Функция - Заполнить значения констант по умолчанию.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьЗначенияКонстантПоУмолчанию() Экспорт
	
	КонстантыЗаполнить = Новый Соответствие;
	КонстантыЗаполнить.Вставить("питХАССПЦветУзлаОперации"						, "#FFFFFF");
	КонстантыЗаполнить.Вставить("питХАССПЦветРамкиУзлаОперации"					, "#000000");
	КонстантыЗаполнить.Вставить("питХАССПЦветВыделенногоУзлаОперации"			, "#FFFFFF");
	КонстантыЗаполнить.Вставить("питХАССПЦветРамкиВыделенногоУзлаОперации"		, "#000000");
	КонстантыЗаполнить.Вставить("питХАССПЦветСвязи"								, "#000000");
	КонстантыЗаполнить.Вставить("питХАССПЦветВыделеннойСвязи"					, "#000000");
	КонстантыЗаполнить.Вставить("питХАССПЦветТекста"							, "#000000");
	КонстантыЗаполнить.Вставить("питХАССПРазмерТекста"							, "14");
	КонстантыЗаполнить.Вставить("питХАССПТолщинаРамкиУзла"						, "1");
	КонстантыЗаполнить.Вставить("питХАССПТолщинаСвязи"							, "1");
	КонстантыЗаполнить.Вставить("питХАССПЦветУзлаНоменклатуры"					, "#FFFFFF");
	КонстантыЗаполнить.Вставить("питХАССПЦветРамкиУзлаНоменклатуры"				, "#000000");
	КонстантыЗаполнить.Вставить("питХАССПЦветВыделенногоУзлаНоменклатуры"		, "#FFFFFF");
	КонстантыЗаполнить.Вставить("питХАССПЦветРамкиВыделенногоУзлаНоменклатуры"	, "#000000");
	КонстантыЗаполнить.Вставить("питХАССПФормаУзлаОперации"						, Перечисления.питВидыФормУзловБлокСхемыХАССП.Прямоугольник);
	КонстантыЗаполнить.Вставить("питХАССПФормаУзлаНоменклатуры"					, Перечисления.питВидыФормУзловБлокСхемыХАССП.Овал);
	Для каждого ТекКонстанта Из КонстантыЗаполнить Цикл
		МенеджерКонстанты = Константы[ТекКонстанта.Ключ].СоздатьМенеджерЗначения();
		МенеджерКонстанты.Прочитать();
		Если НЕ ЗначениеЗаполнено(МенеджерКонстанты.Значение) 
			ИЛИ (ТипЗнч(МенеджерКонстанты.Значение) = Тип("Строка") И НЕ СтрНачинаетсяС(МенеджерКонстанты.Значение, "#")) Тогда
			МенеджерКонстанты.Значение = ТекКонстанта.Значение;
			МенеджерКонстанты.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

#КонецОбласти

// Получает объект ИБ по его идентификатору.
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ЭтоГруппа - Произвольный - Это группа.
//  СоздаватьОбъект - Произвольный - Создавать объект.
//
// Возвращаемое значение:
// 	Массив - Массив родителей всех уровней.
Функция ПолучитьОбъектПоИД(Знач ИДСтрокой, МенеджерОбъекта, ЭтоГруппа, СоздаватьОбъект = Истина) Экспорт
	ОбъектСсылка = ПолучитьСсылкуПоИД(ИДСтрокой, МенеджерОбъекта);
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектБазыДанных = ОбъектСсылка.ПолучитьОбъект();
	Если ОбъектБазыДанных = Неопределено Тогда
		Если СоздаватьОбъект Тогда
			Если НЕ  Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка)) Тогда
				Если ЭтоГруппа Тогда
					Объект = МенеджерОбъекта.СоздатьГруппу();
				Иначе
					Объект = МенеджерОбъекта.СоздатьЭлемент();
				КонецЕсли; 
			Иначе
				Объект = МенеджерОбъекта.СоздатьДокумент();
			КонецЕсли; 
			Объект.УстановитьСсылкуНового(ОбъектСсылка);
		Иначе
			Объект = ОбъектБазыДанных;
		КонецЕсли; 
	Иначе
		Объект = ОбъектБазыДанных;
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции

// Получает ссылку по ее идентификатору.
//
// Параметры:
//  ИсхИДСтрокой - Произвольный - Знач исх ид строкой.
//  МенеджерОбъекта - Произвольный - Менеджер объекта.
//  ПроверитьНаличие - Произвольный - Проверить наличие.
//
// Возвращаемое значение:
// 	Произвольный - Искомая ссылка.
Функция ПолучитьСсылкуПоИД(Знач ИсхИДСтрокой, МенеджерОбъекта, ПроверитьНаличие = Ложь) Экспорт
	
	Результат = МенеджерОбъекта.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИсхИДСтрокой) Тогда
		
		// Преобразуем в корректное значение ID
		ИДСтрокой = ПолучитьИДПоСтроке(ИсхИДСтрокой);
		// Получение ИД из строки
		ИД = Новый УникальныйИдентификатор(ИДСтрокой);
		// Получение ссылки по ИД
		Результат = МенеджерОбъекта.ПолучитьСсылку(ИД);
		// Проверяем есть объект в нашей БД
		Если ПроверитьНаличие Тогда
			Если ПустаяСтрока(Результат.ВерсияДанных) Тогда
				// Такого объекта в базе нет
				Результат = МенеджерОбъекта.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	// Возврат ссылки (без проверки не исключается что "битая").
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает ссылку объекта ИБ по его идентификатору.
//
// Параметры:
//  ИДСтрокой - Произвольный - Знач ид строкой.
//
// Возвращаемое значение:
// 	Ссылка - Ссылка объекта ИБ.
Функция ПолучитьИДПоСтроке(Знач ИДСтрокой)
	
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "{", "");
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "}", "");
	
	Возврат ИДСтрокой;
	
КонецФункции

#КонецОбласти





