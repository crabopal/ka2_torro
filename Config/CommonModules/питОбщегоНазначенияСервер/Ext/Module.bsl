
#Область ПрограммныйИнтерфейс

#Область ЗаписьОбъектов

// Функция выполняет запись переданного документа и возвращает текст ошибки.
//
// Параметры:
//  ДокументОбъект			 - Произвольный	 - Объект документа, который записываем.
//  РежимЗаписи				 - РежимЗаписиДокумента	 - Режим записи исходного документа.
//  ОтключитьБизнесЛогику	 - Булево				 - Взводит флаг "Загрузка" в истина, чтобы не выполнялась бизнес-логика документа.
// 
// Возвращаемое значение:
//  Строка - Текст ошибки записи, если она возникла, иначе пустая строка.
//
Функция ЗаписатьДокументВПопытке(ДокументОбъект, РежимЗаписи, ОтключитьБизнесЛогику = Ложь) Экспорт
	
	ДокументОбъект.ОбменДанными.Загрузка = ОтключитьБизнесЛогику;
	Возврат ЗаписатьВПопытке(ДокументОбъект, РежимЗаписиДокумента.Запись);
	
КонецФункции

// Функция выполняет запись менеджера записи и возвращает текст ошибки.
//
// Параметры:
//  МенеджерЗаписи - РегистрСведенийМенеджерЗаписи.<Имя регистра сведений> - Менеджер записи.
//
// Возвращаемое значение:
//  Строка - Текст ошибки записи, если она возникла, иначе пустая строка.
Функция ЗаписатьМенеджерЗаписиВПопытке(МенеджерЗаписи) Экспорт
	
	Возврат ЗаписатьВПопытке(МенеджерЗаписи);
	
КонецФункции

// Функция выполняет запись менеджера записи и возвращает текст ошибки.
//
// Параметры:
//  НаборЗаписей - Произвольный - Набор записей.
//  Замещать - Произвольный - Замещать.
//
// Возвращаемое значение:
//  Строка - Текст ошибки записи, если она возникла, иначе пустая строка.
Функция ЗаписатьНаборЗаписейВПопытке(НаборЗаписей, Замещать = Истина) Экспорт
	
	Возврат ЗаписатьВПопытке(НаборЗаписей,,Замещать);
	
КонецФункции


// Функция выполняет запись объекта и возвращает текст ошибки.
//
// Параметры:
//  ОбъектЗаписи - ДокументОбъект.<ИмяДокумента>, РегистрСведенийМенеджерЗаписи.<Имя регистра сведений> - Объект,
//   который записываем.
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи документа, если записываем документ.
//  Замещать - Произвольный - Замещать.
//
// Возвращаемое значение:
//  Строка - Текст ошибки записи, если она возникла, иначе пустая строка.
Функция ЗаписатьВПопытке(ОбъектЗаписи, РежимЗаписи = Неопределено, Замещать = Неопределено) Экспорт
	
	ТекстОшибки = "";
	Попытка
		Если НЕ Замещать = Неопределено Тогда
			ОбъектЗаписи.Записать(Замещать);
		ИначеЕсли НЕ РежимЗаписи = Неопределено Тогда
			ОбъектЗаписи.Записать(РежимЗаписи);
		Иначе
			ОбъектЗаписи.Записать();
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка записи по причине:
		|" + ТекстОшибки;
		ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
	КонецПопытки;
	Возврат ТекстОшибки;
	
КонецФункции

#КонецОбласти

#Область РаботаСТранзакциями

// Будет ли выброшено исключение "В данной транзакции уже происходили ошибки" (является ли транзакция сломанной)
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВТранзакцииПроисходилиОшибки() Экспорт 
	Запрос = Новый Запрос("ВЫБРАТЬ 1");
	Попытка
		Запрос.Выполнить();
		Результат = Ложь;
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Результат = Истина;
	КонецПопытки; 
	Возврат Результат;
КонецФункции

// Процедура - Зафиксировать транзакцию обязательно.
//
Процедура ЗафиксироватьТранзакциюОбязательно() Экспорт
	Если ВТранзакцииПроисходилиОшибки() Тогда
		ВызватьИсключение "В данной транзакции уже происходили ошибки";
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаЗагрузкаДанныхПереопределяемый

// Процедура - При заполнении типов исключаемых из выгрузки загрузки.
//
// Параметры:
//  Типы - Произвольный - Типы.
//
Процедура ПриЗаполненииТиповИсключаемыхИзВыгрузкиЗагрузки(Типы) Экспорт
	
	МетаданныеПодсистемыПит = Метаданные.Подсистемы.Найти("питОбъектыВсе");
	Для каждого МетаданныеОбъектаПит Из МетаданныеПодсистемыПит.Состав Цикл
		Типы.Добавить(МетаданныеОбъектаПит);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Функция - Получить остатки полуфабрикатов.
//
// Параметры:
//  ТабПолуфабрикатов - Произвольный - Таб полуфабрикатов.
//  Склад - Произвольный - Склад.
//  ДатаОстатков - Дата - Дата остатков.
//  ВычитатьДвиженияПодкладныхДокументов - Произвольный - Вычитать движения подкладных документов.
//  ДокументОбщепит - Произвольный - Документ общепит.
//  УчитыватьОбеспеченные - Произвольный - Учитывать обеспеченные.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьОстаткиПолуфабрикатов(ТабПолуфабрикатов, Склад, ДатаОстатков, ВычитатьДвиженияПодкладныхДокументов = Истина, ДокументОбщепит = Неопределено, УчитыватьОбеспеченные = Неопределено)  Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// +ОстаткиПоОбеспечению
	Если УчитыватьОбеспеченные = Неопределено Тогда
		ИмяВтОстатки = "";
		УчитыватьОбеспеченные = Ложь;
		Если НЕ ДокументОбщепит = Неопределено Тогда
			Если ТипЗнч(ДокументОбщепит) = Тип("ДокументСсылка.питПланМеню") Тогда
				ВидПроизводства = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбщепит, "ВидПроизводства");
			ИначеЕсли ТипЗнч(ДокументОбщепит) = Тип("ДокументОбъект.питПланМеню") Тогда
				ВидПроизводства = ДокументОбщепит.ВидПроизводства;
			Иначе
				ВидПроизводства = Неопределено;
			КонецЕсли;
			Если ВидПроизводства = Перечисления.питВидыПроизводства.ПеределыОтдельнойОперациейСУчетомЗапланированных Тогда
				ИмяВтОстатки = "втОстаткиНеСгруппированные";
				УчитыватьОбеспеченные = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИмяВтОстатки = ?(УчитыватьОбеспеченные, "втОстаткиНеСгруппированные", "");
	КонецЕсли;
	// -ОстаткиПоОбеспечению
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписНоменклатуры.Номенклатура,
		|	СписНоменклатуры.Характеристика,
		|	СписНоменклатуры.Серия,
		|	СписНоменклатуры.Назначение
		|ПОМЕСТИТЬ ВТ_СписНоменклатуры
		|ИЗ
		|	&СписНоменклатуры КАК СписНоменклатуры
		|;
		|%ТекстЗапросаВременнаяТаблицаМассивРегистраторов%
		|%ТекстЗапросаДляВычетаДвиженийРегистратора%
		|%ТочкаСЗапятой%
		|%ТекстЗапросаСвободныеОстатки%";
	
	// +ОстаткиПоОбеспечению
	ДобавлятьТекстЗапросаДляВычетаДвижений = ВычитатьДвиженияПодкладныхДокументов И НЕ ДокументОбщепит = Неопределено;
	Если ДобавлятьТекстЗапросаДляВычетаДвижений ИЛИ УчитыватьОбеспеченные Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ТекстЗапросаВременнаяТаблицаМассивРегистраторов%", ПолучитьТекстЗапросаВременнаяТаблицаМассивРегистраторов());
		Если ТипЗнч(ДокументОбщепит) = Тип("ДокументСсылка.питВыпускБлюд")
			ИЛИ ТипЗнч(ДокументОбщепит) = Тип("ДокументСсылка.питПланМеню") Тогда
			ДокументОбщепитСсылка =ДокументОбщепит;
		ИначеЕсли ТипЗнч(ДокументОбщепит) = Тип("ДокументОбъект.питВыпускБлюд")
			ИЛИ ТипЗнч(ДокументОбщепит) = Тип("ДокументОбъект.питПланМеню") Тогда
			ДокументОбщепитСсылка =ДокументОбщепит.Ссылка;
		Иначе
			ДокументОбщепитСсылка = Неопределено
		КонецЕсли;
		Запрос.УстановитьПараметр("ДокументОбщепит", ДокументОбщепитСсылка);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ТекстЗапросаВременнаяТаблицаМассивРегистраторов%", "");
	КонецЕсли;
	// -ОстаткиПоОбеспечению
	
	Если ДобавлятьТекстЗапросаДляВычетаДвижений Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ТекстЗапросаДляВычетаДвиженийРегистратора%", ПолучитьТекстЗапросаДляВычетаДвиженийРегистратора(,Ложь));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ТочкаСЗапятой%", ";");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ТекстЗапросаДляВычетаДвиженийРегистратора%", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ТочкаСЗапятой%", "");
	КонецЕсли;
	Запрос.УстановитьПараметр("НаДату", Новый Граница(КонецМесяца(?(ТипЗнч(ДатаОстатков) = Тип("МоментВремени"), ДатаОстатков.Дата, ДатаОстатков)),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НаДатуДата", Запрос.Параметры.НаДату.Значение);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ТекстЗапросаСвободныеОстатки%", ПолучитьТекстЗапросаСвободныеОстатки(,ИмяВтОстатки,,ДобавлятьТекстЗапросаДляВычетаДвижений));
	
	// +ОстаткиПоОбеспечению
	Если УчитыватьОбеспеченные Тогда
		СкладыВСпискеНоменклатуры = Ложь;
		
		// 1. Прибавляем движения по ОжидаемоеПоступление.
		Запрос.Текст = Запрос.Текст + " ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	РаспределениеЗапасов.Номенклатура КАК Номенклатура,
		|	РаспределениеЗапасов.Характеристика КАК Характеристика,
		|	РаспределениеЗапасов.Назначение КАК Назначение,
		|	РаспределениеЗапасов.Склад КАК Склад,
		|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
		|	РаспределениеЗапасов.Свободно КАК Количество
		|ИЗ
		|	РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
		|ГДЕ
		|	РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОжидаемоеПоступление)
		|	И РаспределениеЗапасов.ЗаказНаОтгрузку = НЕОПРЕДЕЛЕНО ";
		Запрос.Текст = Запрос.Текст + " И " + ТекстЗапросаОбеспечениеОтборТаблиц(СкладыВСпискеНоменклатуры);
		
		// 4. Финальная группировка данных.
		Запрос.Текст = Запрос.Текст + ";
		|ВЫБРАТЬ
		|	втРезультат.Номенклатура КАК Номенклатура,
		|	втРезультат.Характеристика КАК Характеристика,
		|	втРезультат.Назначение КАК Назначение,
		|	втРезультат.Склад КАК Склад,
		|	втРезультат.Серия КАК Серия,
		|	СУММА(втРезультат.Количество) КАК Количество
		|ИЗ
		|	"+ИмяВтОстатки+" КАК втРезультат
		|СГРУППИРОВАТЬ ПО
		|	втРезультат.Номенклатура,
		|	втРезультат.Характеристика,
		|	втРезультат.Назначение,
		|	втРезультат.Склад,
		|	втРезультат.Серия
		|";
		
	КонецЕсли;
	// -ОстаткиПоОбеспечению
	
	Запрос.УстановитьПараметр("СписНоменклатуры", ТабПолуфабрикатов);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатТаблица =  Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатТаблица;
	
КонецФункции


// Функция возвращает текст запроса получения остатков номенклатуры по складу на дату.
//  Для корректной работы запроса необходима установка параметров запроса "Склад" и "НаДату".
//
// Параметры:
//  ИмяВременнойТаблицыНоменклатура - Строка - Имя ВТ с номенклатурой, по которой получаются остатки.
//  ИмяВТОстатки - Произвольный - Имя вт остатки.
//  СкладыВСпискеНоменклатуры - Произвольный - Склады в списке номенклатуры.
//  ДобавлятьТекстЗапросаДляВычетаДвижений - Произвольный - Добавлять текст запроса для вычета движений.
//  ИмяВТДляВычетаДвижений - Произвольный - Имя вт для вычета движений.
//
// Возвращаемое значение:
//  Строка - Текст запроса.
Функция ПолучитьТекстЗапросаСвободныеОстатки(ИмяВременнойТаблицыНоменклатура = "ВТ_СписНоменклатуры", ИмяВТОстатки = "", СкладыВСпискеНоменклатуры = Ложь, ДобавлятьТекстЗапросаДляВычетаДвижений = Истина, ИмяВТДляВычетаДвижений = "втДвиженияВычетТоварыОрганизаций") Экспорт
	
	Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОрганизацийОстатки.КоличествоОстаток КАК Количество,
	|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Назначение КАК Назначение,
	|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Серия КАК Серия,
	|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения КАК Склад
	|ПОМЕСТИТЬ %втОстаткиТоварыПред%
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций.Остатки(
	|			&НаДату,
	|";
	Текст = Текст + ?(НЕ СкладыВСпискеНоменклатуры,"
	|			АналитикаУчетаНоменклатуры.МестоХранения В (&Склад)
	|				И (АналитикаУчетаНоменклатуры.Номенклатура, АналитикаУчетаНоменклатуры.Характеристика, АналитикаУчетаНоменклатуры.Назначение, АналитикаУчетаНоменклатуры.Серия) В
	|					(ВЫБРАТЬ
	|						ВТ_СписНоменклатуры.Номенклатура,
	|						ВТ_СписНоменклатуры.Характеристика,
	|						ВТ_СписНоменклатуры.Назначение,
	|						ВТ_СписНоменклатуры.Серия
	|					ИЗ
	|						"+ИмяВременнойТаблицыНоменклатура+" КАК ВТ_СписНоменклатуры)",
	"
	|			(АналитикаУчетаНоменклатуры.Номенклатура, АналитикаУчетаНоменклатуры.Характеристика, АналитикаУчетаНоменклатуры.Назначение, АналитикаУчетаНоменклатуры.Серия, АналитикаУчетаНоменклатуры.МестоХранения) В
	|					(ВЫБРАТЬ
	|						ВТ_СписНоменклатуры.Номенклатура,
	|						ВТ_СписНоменклатуры.Характеристика,
	|						ВТ_СписНоменклатуры.Назначение,
	|						ВТ_СписНоменклатуры.Серия,
	|						ВТ_СписНоменклатуры.Склад
	|					ИЗ
	|						"+ИмяВременнойТаблицыНоменклатура+" КАК ВТ_СписНоменклатуры)");
	
	Текст = Текст + "
	|) КАК ТоварыОрганизацийОстатки
	|
	|%ТекстЗапросаВычетДвижений%
	|%ТочкаСЗапятой%
	|%ТекстЗапросаГруппировка%
	|;";
	
	Если ДобавлятьТекстЗапросаДляВычетаДвижений Тогда
		
		ИмяОстаткиПред = "втОстаткиТоварыПред";
		
		ТекстЗапросаВычетДвижений = "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	втДвиженияВычетТоварыОрганизаций.Количество КАК Количество,
		|	втДвиженияВычетТоварыОрганизаций.Номенклатура КАК Номенклатура,
		|	втДвиженияВычетТоварыОрганизаций.Характеристика КАК Характеристика,
		|	втДвиженияВычетТоварыОрганизаций.Назначение КАК Назначение,
		|	втДвиженияВычетТоварыОрганизаций.Серия КАК Серия,
		|	втДвиженияВычетТоварыОрганизаций.Склад КАК Склад
		|ИЗ
		// |	втДвиженияВычетТоварыОрганизаций КАК втДвиженияВычетТоварыОрганизаций
		|	%ИмяВТДляВычетаДвижений% КАК втДвиженияВычетТоварыОрганизаций
		|";
		ТекстЗапросаВычетДвижений = СтрЗаменить(ТекстЗапросаВычетДвижений, "%ИмяВТДляВычетаДвижений%", ИмяВТДляВычетаДвижений);
		
		ТочкаСЗапятой = ";";
		
		ТекстЗапросаГруппировка = "
		|ВЫБРАТЬ
		|	СУММА(втОстаткиТоварыПред.Количество) КАК Количество,
		|	втОстаткиТоварыПред.Номенклатура КАК Номенклатура,
		|	втОстаткиТоварыПред.Характеристика КАК Характеристика,
		|	втОстаткиТоварыПред.Назначение КАК Назначение,
		|	втОстаткиТоварыПред.Серия КАК Серия,
		|	втОстаткиТоварыПред.Склад КАК Склад
		|ПОМЕСТИТЬ
		|	втОстаткиТовары
		|ИЗ
		|	втОстаткиТоварыПред КАК втОстаткиТоварыПред
		|СГРУППИРОВАТЬ ПО
		|	втОстаткиТоварыПред.Номенклатура,
		|	втОстаткиТоварыПред.Характеристика,
		|	втОстаткиТоварыПред.Назначение,
		|	втОстаткиТоварыПред.Серия,
		|	втОстаткиТоварыПред.Склад
		|";
		
	Иначе
		ИмяОстаткиПред = "втОстаткиТовары";
		ТекстЗапросаВычетДвижений = "";
		ТочкаСЗапятой = "";
		ТекстЗапросаГруппировка = "";
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "%втОстаткиТоварыПред%"			, ИмяОстаткиПред);
	Текст = СтрЗаменить(Текст, "%ТекстЗапросаВычетДвижений%"	, ТекстЗапросаВычетДвижений);
	Текст = СтрЗаменить(Текст, "%ТочкаСЗапятой%"				, ТочкаСЗапятой);
	Текст = СтрЗаменить(Текст, "%ТекстЗапросаГруппировка%"		, ТекстЗапросаГруппировка);
	
	Текст = Текст + "
	|ВЫБРАТЬ
	|	ВТ_СписНоменклатуры.Номенклатура,
	|	ВТ_СписНоменклатуры.Характеристика,
	|	ВТ_СписНоменклатуры.Назначение,
	|	"+?(СкладыВСпискеНоменклатуры,"ВТ_СписНоменклатуры.Склад,","&Склад,")+"
	|	ВТ_СписНоменклатуры.Серия КАК Серия,
	|	ЕстьNULL(втОстаткиТовары.Количество,0) КАК Количество
	|"+?(ПустаяСтрока(ИмяВТОстатки),"","ПОМЕСТИТЬ "+ИмяВТОстатки+" ")+"
	|ИЗ
	|	"+ИмяВременнойТаблицыНоменклатура+" КАК ВТ_СписНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстаткиТовары КАК втОстаткиТовары 
	|		ПО ВТ_СписНоменклатуры.Номенклатура = втОстаткиТовары.Номенклатура
	|			И ВТ_СписНоменклатуры.Характеристика = втОстаткиТовары.Характеристика
	|			И ВТ_СписНоменклатуры.Назначение = втОстаткиТовары.Назначение
	|			И ВТ_СписНоменклатуры.Серия = втОстаткиТовары.Серия
	|			"+?(СкладыВСпискеНоменклатуры,"И ВТ_СписНоменклатуры.Склад = втОстаткиТовары.Склад","")+"
	|";
	
	Возврат Текст;
	
КонецФункции

// Функция - Получить текст запроса для вычета движений регистратора.
//
// Параметры:
//  ИмяВТДляВычетаДвижений - Строка - Имя вт для вычета движений.
//  ИнициализироватьВременнуюТаблицуМассивРегистраторов - Массив - Инициализировать временную таблицу масси.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьТекстЗапросаДляВычетаДвиженийРегистратора(ИмяВТДляВычетаДвижений = "втДвиженияВычетТоварыОрганизаций", ИнициализироватьВременнуюТаблицуМассивРегистраторов = Истина) Экспорт
	
	ТекстЗапроса = "";
	Если ИнициализироватьВременнуюТаблицуМассивРегистраторов Тогда
		ТекстЗапроса = ТекстЗапроса + ПолучитьТекстЗапросаВременнаяТаблицаМассивРегистраторов();
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Назначение КАК Назначение,
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Серия КАК Серия,
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.МестоХранения КАК Склад,
	|	ВЫБОР
	|		КОГДА ТоварыОрганизаций.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ТОГДА ТоварыОрганизаций.Количество
	|		ИНАЧЕ -ТоварыОрганизаций.Количество
	|	КОНЕЦ КАК Количество
	// |ПОМЕСТИТЬ втДвиженияВычетТоварыОрганизаций
	|ПОМЕСТИТЬ %ИмяВТДляВычетаДвижений%
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций КАК ТоварыОрганизаций
	|ГДЕ
	|	ТоварыОрганизаций.Регистратор В
	|			(ВЫБРАТЬ
	|				МассивРегистраторов.ТиповойДокумент
	|			ИЗ
	|				втМассивРегистраторов КАК МассивРегистраторов)
	|	И ТоварыОрганизаций.Период <= &НаДатуДата
	|	И ТоварыОрганизаций.АналитикаУчетаНоменклатуры.МестоХранения = &Склад
	|";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяВТДляВычетаДвижений%", ИмяВТДляВычетаДвижений);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция добавляет функциональность к типовой функции
//  питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию(
//
// Параметры:
//  Настройка - Строка - вид настройки, значение по умолчанию которой необходимо получить уже преобразованная к
//   верхнему регистру в типовой функции.
//  Пользователь - СправочникСсылка.Пользователи - пользователь программы, настройка которого.
//
// Возвращаемое значение:
//  Произвольный - Значение по умолчанию для настройки.
Функция ПолучитьЗначениеПоУмолчанию(Настройка, Пользователь = Неопределено) Экспорт
	
	НастройкаВРег = Врег(Настройка);
	
	Если НастройкаВРег = ВРег("ИскатьРецептурыПоВсемОрганизациям") Тогда
		Возврат Константы.питИскатьРецептурыПоВсемОрганизациям.Получить();
	ИначеЕсли НастройкаВРег = ВРег("ОтложитьОплату") Тогда 
		Возврат Истина;
	ИначеЕсли НастройкаВРег = ВРег("ЗаписыватьПриНеЗаполненнойРецептуре") Тогда 
		Возврат Истина;
	ИначеЕсли НастройкаВРег = ВРег("РежимРасчетаСписанияВПроизводство") Тогда
		Возврат Константы.питРежимРасчетаСписанияВПроизводство.Получить();
	ИначеЕсли НастройкаВРег = ВРег("НеИзменятьРежимСписанияВПроизводствоПоНастройке") Тогда
		Возврат Константы.питНеИзменятьРежимСписанияВПроизводствоПоНастройке.Получить();
	ИначеЕсли НастройкаВРег = ВРег("СтатьяКалькуляцииПоУмолчанию") Тогда
		Возврат Константы.питСтатьяКалькуляцииПоУмолчанию.Получить();
	ИначеЕсли НастройкаВРег = ВРег("СпособРасчетаРецептур") Тогда
		Возврат Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре;
	ИначеЕсли НастройкаВРег = ВРег("НормативныйТипЦенОбщепит") Тогда
		Возврат Константы.питНормативнаяЦена.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питСтатьяОприходованияИзлишков") Тогда
		Возврат Константы.питСтатьяОприходованияИзлишков.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питФормулаРасчетаКалорийности") Тогда
		Возврат ?(ЗначениеЗаполнено(Константы.питФормулаРасчетаКалорийности.Получить())
		,Константы.питФормулаРасчетаКалорийности.Получить()
		,"4 * [Белки] + 9 * [Жиры] + 4 * [Углеводы] + 7 * [Алкоголь]");
	ИначеЕсли НастройкаВРег = ВРег("питГруппаХЭХПоУмолчанию") Тогда
		Возврат Константы.питГруппаХЭХПоУмолчанию.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питПодразделениеПроизводстваПолуфабрикатов") Тогда
		Возврат ?(ЗначениеЗаполнено(Константы.питПодразделениеПроизводстваПолуфабрикатов.Получить())
		,Константы.питПодразделениеПроизводстваПолуфабрикатов.Получить()
		,Перечисления.питПодразделенияПроизводстваПолуфабрикатов.ПодразделениеВыпускаБлюд);
		// Возврат Перечисления.питПодразделенияПроизводстваПолуфабрикатов.ПодразделениеВыпускаБлюд;
	ИначеЕсли НастройкаВРег = ВРег("питПеремещатьБлюдаСРазрешенныхКладовых") Тогда
		Возврат Константы.питПеремещатьБлюдаСРазрешенныхКладовых.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питФормироватьТиповыеДокументыПриЗаписиДокументапит") Тогда
		Возврат Истина; // Асинхронный режим нуждается в доработке, пока отключен.
	ИначеЕсли НастройкаВРег = ВРег("питОрганизацияПеремещенияДляРеализации") Тогда
		Возврат ?(ЗначениеЗаполнено(Константы.питОрганизацияПеремещенияДляРеализации.Получить())
		,Константы.питОрганизацияПеремещенияДляРеализации.Получить()
		,Перечисления.питОрганизацииПеремещенияДляРеализации.ОрганизацияПроизводства);
	ИначеЕсли НастройкаВРег = ВРег("питВосприниматьБлюдоБезРецептурыКакТовар") Тогда
		Возврат Константы.питВосприниматьБлюдоБезРецептурыКакТовар.Получить();	
	ИначеЕсли НастройкаВРег = ВРег("питВидыПроизводстваМодификаторов") Тогда
		Возврат Константы.питВидПроизводстваМодификаторов.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питРежимПриготовленияПолуфабрикатов") Тогда
		Возврат Константы.питРежимПриготовленияПолуфабрикатов.Получить();
	ИначеЕсли НастройкаВРег = ВРег("ОтклонениеОтБазовойВеличиныПриЗаполненииАктаПроработки") Тогда
		Возврат Константы.питОтклонениеОтБазовойВеличиныПриЗаполненииАктаПроработки.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питИспользоватьОтложенноеПроведениеВыпускаБлюд") Тогда
		Возврат Константы.питИспользоватьОтложенноеПроведениеВыпускаБлюд.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питОстанавливатьОбработкуОчередиПриВозникновенииОшибок") Тогда
		Возврат Константы.питОстанавливатьОбработкуОчередиПриВозникновенииОшибок.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питНеИспользоватьСезонныеПроценты") Тогда
		Возврат Константы.питНеИспользоватьСезонныеПроценты.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питКоличествоДляРасчетаПоФормулеВРецептурах") Тогда
		Возврат Константы.питКоличествоДляРасчетаПоФормулеВРецептурах.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питЕдиницаИзмеренияВыходаВРецептурах") Тогда
		Возврат Константы.питЕдиницаИзмеренияВыходаВРецептурах.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питСмещатьДатыТиповыхДокументов") Тогда
		Возврат Константы.питСмещатьДатыТиповыхДокументов.Получить();
	ИначеЕсли НастройкаВРег = ВРег("питЗаполнятьНоменклатуруСкладаВЗаказеНаПеремещениеВНоменклатуруПроизводства") Тогда
		Возврат Константы.питЗаполнятьНоменклатуруСкладаВЗаказеНаПеремещениеВНоменклатуруПроизводства.Получить();
	Иначе
		Возврат Бух_ПолучитьЗначениеПоУмолчанию(НастройкаВРег, Пользователь);
	КонецЕсли;
	
КонецФункции

// Функция скопирована из модуля БухгалтерскийУчетПереопределяемый.ПустоеПодразделение
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция Бух_ПустоеПодразделение() Экспорт

	Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();

КонецФункции // ПустоеПодразделение()

// Удаляет из списка проверяемых реквизитов табличные части, если хотя бы одна из них заполнена
//
// Параметры:
//  Объект - ДокументОбъект, СправочникОбъект - объект с табличными частям.
//  ИменаТабличныхЧастей - Произвольный - Знач имена табличных частей.
//  ПроверяемыеРеквизиты - Массив - Перечень проверяемых реквизитов.
//
Процедура ИсключитьИзПроверкиОсновныеТабличныеЧасти(Объект, Знач ИменаТабличныхЧастей, ПроверяемыеРеквизиты) Экспорт
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ТипЗнч(ИменаТабличныхЧастей) = Тип("Строка") Тогда
		ИменаТабличныхЧастей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаТабличныхЧастей);
	КонецЕсли;
	
	ЕстьЗаписи = Ложь;
	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
		
		Если Объект[СокрЛП(ИмяТабличнойЧасти)].Количество() > 0 Тогда
			ЕстьЗаписи = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьЗаписи Тогда
		Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
			МассивНепроверяемыхРеквизитов.Добавить(СокрЛП(ИмяТабличнойЧасти));
		КонецЦикла;
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

// Удаляет из списка проверяемых реквизитов неиспользуемые табличные части и все их реквизиты
//
// Параметры:
//  ПроверяемыеРеквизиты - Массив - Перечень проверяемых реквизитов.
//  НеИспользуемыеТабличныеЧасти - Массив - Перечень имен неиспользуемых табличных частей.
//
Процедура ИсключитьИзПроверкиНеиспользуемыеТабличныеЧасти(ПроверяемыеРеквизиты, НеИспользуемыеТабличныеЧасти) Экспорт
	
	// Исключим из проверки сами списки
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеИспользуемыеТабличныеЧасти);
	
	// Исключим из проверки колонки списков
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Для Каждого ИмяТабличнойЧасти Из НеИспользуемыеТабличныеЧасти Цикл
		ПрефиксРеквизита = ИмяТабличнойЧасти + ".";
		ДлинаПрефикса = СтрДлина(ПрефиксРеквизита);
		Для Каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
			Если СтрДлина(ПроверяемыйРеквизит) > ДлинаПрефикса 
			   И Лев(ПроверяемыйРеквизит, ДлинаПрефикса) = ПрефиксРеквизита Тогда
			   МассивНепроверяемыхРеквизитов.Добавить(ПроверяемыйРеквизит);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

// Функция возвращает дополнительный реквизит по его имени.
//
// Параметры:
//  ИмяРеквизита - Строка - Имя дополнительного реквизита.
//
// Возвращаемое значение:
//  ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - Ссылка на дополнительный реквизит.
Функция ДополнительныйРеквизитПоИмени(ИмяРеквизита) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|ГДЕ
		|	ДополнительныеРеквизитыИСведения.Имя = &ИмяРеквизита";
	
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Результат = ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

