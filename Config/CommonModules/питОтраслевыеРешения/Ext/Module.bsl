// Функция - Перевести объем в миллилитры.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  ЕдиницаИзмерения - Произвольный - Единица измерения.
//  Количество - Произвольный - Количество.
//  ПараметрыРасчета - Произвольный - Параметры расчета.
//  АлкогольнаяПродукция - Произвольный - Алкогольная продукция.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПеревестиОбъемВМиллилитры(Номенклатура, ЕдиницаИзмерения = Неопределено, Количество = 1, ПараметрыРасчета = Неопределено,
	АлкогольнаяПродукция = Неопределено) Экспорт
	
	Результат = питОбщегоНазначения.ПеревестиОбъемВМиллилитры(Номенклатура,ЕдиницаИзмерения,Количество, АлкогольнаяПродукция);
	
	Возврат Результат;
КонецФункции

//  Функция - Свойство пропустить регистрацию.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция Свойство_ПропуститьРегистрацию() Экспорт
	Возврат питОбменДаннымиКлиентСервер.Свойство_ПропуститьРегистрацию();
КонецФункции

