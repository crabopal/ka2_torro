
#Область ПрограммныйИнтерфейс

#Область ПереопределяемыеФункцииУправленияДоступом

// Заполняет массив структур, которые будут использованы для начального заполнения и
//  восстановления начального заполнения профилей.
//
// Параметры:
//  ОписанияПрофилей - Массив - добавить описания профилей групп доступа (Структура).
//   Состав свойств структуры см. УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа.
//  ПараметрыОбновления - Структура - содержит свойства.
//
Процедура ЗаполнитьПоставляемыеПрофилиГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт
	
	Если ОписанияПрофилей = Неопределено Тогда
		ОписанияПрофилей = Новый Массив;
	КонецЕсли;
	
	ОписатьПрофиль_питТехнолог(ОписанияПрофилей, ПараметрыОбновления);
	ОписатьПрофиль_питКалькулятор(ОписанияПрофилей, ПараметрыОбновления);
	ОписатьПрофиль_питАдминистратор(ОписанияПрофилей, ПараметрыОбновления);
	ОписатьПрофиль_питМенеджерОбъекта(ОписанияПрофилей, ПараметрыОбновления);
	ОписатьПрофиль_питПолноправный(ОписанияПрофилей, ПараметрыОбновления);
	
КонецПроцедуры

// Позволяет указать списки, у которых объекты метаданных содержат описание логики ограничения
//  доступа в модулях менеджеров или переопределяемом модуле.
//  см. ОбщийМодуль.УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа()
//
// Параметры:
//  Списки - Произвольный - Списки.
//
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Документы.питРазделка, Истина);
	Списки.Вставить(Метаданные.Документы.питВыпускБлюд, Истина);
	Списки.Вставить(Метаданные.Документы.питПланМеню, Истина);
	Списки.Вставить(Метаданные.Документы.питДанныеПродажФронта, Истина);
	Списки.Вставить(Метаданные.Документы.питКорректировкаОстатковИС, Истина);
	Списки.Вставить(Метаданные.Документы.питРецептура, Истина);
	Списки.Вставить(Метаданные.Документы.питИнвентаризацияТоваров, Истина);
	Списки.Вставить(Метаданные.Документы.питАктПроработки, Истина);
	Списки.Вставить(Метаданные.Документы.питПеремещениеНоменклатурыСкладаПроизводства, Истина);
	Списки.Вставить(Метаданные.Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства, Истина);
	Списки.Вставить(Метаданные.Документы.питБракеражПродукции, Истина);
	
	Списки.Вставить(Метаданные.РегистрыНакопления.питПроизводство, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.питПродажиПоЧекам, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.питОплатыПоЧекам, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.питЗаменыИнгредиентов, Истина);
	
КонецПроцедуры

// Заполняет массив структур, которые будут использованы для начального заполнения и
//  восстановления начального заполнения профилей.
//  см. ОбщийМодуль.УправлениеДоступомПереопределяемый.ЗаполнитьПоставляемыеПрофилиГруппДоступа()
//
// Параметры:
//  ОписанияПрофилей - Произвольный - Описания профилей.
//  ПараметрыОбновления - Произвольный - Параметры обновления.
//
Процедура ДополнитьПоставляемыеПрофилиГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт
	
	Для каждого ОписаниеПрофиля Из ОписанияПрофилей Цикл
		Если НЕ ПустаяСтрока(ОписаниеПрофиля.Имя) 
			И ОписаниеПрофиля.Свойство("Роли") 
			И ОписаниеПрофиля.ВидыДоступа.НайтиПоЗначению("ВнешниеПользователи") = Неопределено Тогда
			ОписаниеПрофиля.Роли.Добавить("питЧтениеУдаленныхКасс");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Служебная функция. Сделана экспортной для удобства внедрения.
//
// Параметры:
//  ОписаниеПрофиля - Произвольный - Описание профиля.
//
Процедура ДополнитьПрофильОбязательнымиРолями(ОписаниеПрофиля) Экспорт
	
	УправлениеДоступомУТ.ДополнитьПрофильОбязательнымиРолями(ОписаниеПрофиля);
	
	Если НЕ Метаданные.Роли.Найти("БазовыеПраваУХ") = Неопределено Тогда
		ОписаниеПрофиля.Роли.Добавить("БазовыеПраваУХ");
	КонецЕсли;
	
	ОписаниеПрофиля.Роли.Добавить("питПодсистемаОбщепит");
	ОписаниеПрофиля.Роли.Добавить("питЧтениеУдаленныхКасс");
	ОписаниеПрофиля.Роли.Добавить("питБазовыеПраваОбщепит");
	ОписаниеПрофиля.Роли.Добавить("слкУправлениеМенеджеромЛицензийСЛК");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура - Описать профиль пит калькулятор.
//
// Параметры:
//  ОписанияПрофилей - Произвольный - Описания профилей.
//  ПараметрыОбновления - Произвольный - Параметры обновления.
//
Процедура ОписатьПрофиль_питКалькулятор(ОписанияПрофилей, ПараметрыОбновления)
	
	// Описание для заполнения профиля "Калькулятор".
	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Имя           = "питКалькулятор";
	ОписаниеПрофиля.Идентификатор = "817fd39b-e55b-11e7-858c-7824af9a11ac";
	ОписаниеПрофиля.Наименование  = НСтр("ru = 'Общепит Калькулятор'");
	ОписаниеПрофиля.Описание =
		НСтр("ru = 'Общепит Калькулятор'");
	
	ДополнитьПрофильОбязательнымиРолями(ОписаниеПрофиля);
	
	// +питКА
	МетаданныеРоли = Метаданные.Роли;
	МассивРолей = МассивРолей_питКалькулятор();
	Для каждого ТекРоль Из МассивРолей Цикл
		Если НЕ МетаданныеРоли.Найти(ТекРоль) = Неопределено Тогда
			ОписаниеПрофиля.Роли.Добавить(ТекРоль);
		КонецЕсли;
	КонецЦикла;
	// -питКА
	
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);
	
КонецПроцедуры

