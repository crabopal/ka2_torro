// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ, РЕАЛИЗУЮЩИЕ АЛГОРИТМЫ РЕГЛАМЕНТНЫХ И ФОНОВЫХ ЗАДАНИЙ

#Область ПрограммныйИнтерфейс

// Выполняет загрузку данных R-Keeper в документы данных продаж фронта
//
// Параметры:
//  СтруктураПараметров - Структура - Знач структура параметров.
//
Процедура ЗагрузкаДанныхRKeeper(Знач СтруктураПараметров = Неопределено) Экспорт
	
	// Получим список касс RKeeper
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СоответствияОбъектовRKeeper.Ссылка1С
	|ИЗ
	|	РегистрСведений.питСоответствияОбъектовRKeeper КАК СоответствияОбъектовRKeeper
	|ГДЕ
	|	СоответствияОбъектовRKeeper.ТипОбъекта = &ТипОбъектаКасса
	|	И НЕ СоответствияОбъектовRKeeper.Ссылка1С ЕСТЬ NULL
	|	И СоответствияОбъектовRKeeper.Ссылка1С <> НЕОПРЕДЕЛЕНО
	|	И СоответствияОбъектовRKeeper.Ссылка1С <> ЗНАЧЕНИЕ(Справочник.КассыККМ.ПустаяСсылка)
	|	%ОтборПоКассамККМ%";
	Запрос.УстановитьПараметр("ТипОбъектаКасса", ПланыВидовХарактеристик.питТипыОбъектовRKeeper.КассыККМ);
	
	// Установим отбор по кассам ККМ если они есть в переданных параметрах.
	Если СтруктураПараметров <> Неопределено
		И ТипЗнч(СтруктураПараметров) = Тип("Структура") 
		И СтруктураПараметров.Свойство("КассыККМ") 
		И СтруктураПараметров.КассыККМ.Количество() Тогда
		СтрокаОтборПоКассам = " И СоответствияОбъектовRKeeper.Ссылка1С В (&МассивКассККМ) ";
		Если ТипЗнч(СтруктураПараметров.КассыККМ) = Тип("ТаблицаЗначений") Тогда
			Запрос.УстановитьПараметр("МассивКассККМ", СтруктураПараметров.КассыККМ.ВыгрузитьКолонку("КассаККМ"));
		Иначе
			Запрос.УстановитьПараметр("МассивКассККМ", СтруктураПараметров.КассыККМ);
		КонецЕсли;
	Иначе
		СтрокаОтборПоКассам = "";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ОтборПоКассамККМ%", СтрокаОтборПоКассам);
	
	ВыборкаКасс = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКасс.Следующий() Цикл
	
		МассивКасс = Новый Массив;
		МассивКасс.Добавить(ВыборкаКасс.Ссылка1С);
		
		// Получим дату минимального последнего загруженного документа кассы
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	МАКСИМУМ(ЕСТЬNULL(ДанныеПродажФронта.Дата, ДАТАВРЕМЯ(1, 1, 1))) КАК Дата,
		               |	КассыККМ.Ссылка КАК КассаККМ
		               |ИЗ
		               |	Справочник.КассыККМ КАК КассыККМ
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питДанныеПродажФронта КАК ДанныеПродажФронта
		               |		ПО КассыККМ.Ссылка = ДанныеПродажФронта.КассаККМ
		               |			И (НЕ ДанныеПродажФронта.ПометкаУдаления)
		               |ГДЕ
		               |	КассыККМ.Ссылка В(&КассыККМ)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	КассыККМ.Ссылка
		               |ИТОГИ
		               |	МИНИМУМ(Дата)
		               |ПО
		               |	ОБЩИЕ";
		Запрос.УстановитьПараметр("КассыККМ", МассивКасс);
		ВыборкаДПФ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		ДатаНачала = Неопределено;
		Если ВыборкаДПФ.Следующий() Тогда
			ДатаНачала = ВыборкаДПФ.Дата;
		КонецЕсли;
		
		Запрос = новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	УчетныеЗаписиRKeeper.НачалоУчета КАК НачалоУчета,
		|	УчетныеЗаписиRKeeper.Наименование КАК Наименование,
		|	УчетныеЗаписиRKeeper.ТипСоответствий КАК ТипСоответствий,
		|	УчетныеЗаписиRKeeper.Ссылка КАК Ссылка,
		|	УчетныеЗаписиRKeeper.Ссылка.ВидЗагрузкиУдалений КАК ВидЗагрузкиУдалений,
		|	УчетныеЗаписиRKeeper.ВыполнятьЗагрузкуИзДанныхПродажФронта КАК ВыполнятьЗагрузкуИзДанныхПродажФронта
		|ИЗ
		|	Справочник.питУчетныеЗаписиRKeeper КАК УчетныеЗаписиRKeeper
		|ГДЕ
		|	УчетныеЗаписиRKeeper.ИспользоватьВФоновомОбмене
		|	И НЕ УчетныеЗаписиRKeeper.ПометкаУдаления
		|	%ОтборПоИндивидуальномуРЗ%
		|	%ОтборПоУчетнойЗаписи%";
		
		// Установим отбор по учетной записи кипера, к которой привязано текущее РЗ, если она есть в переданных параметрах.
		Если СтруктураПараметров <> Неопределено
			И ТипЗнч(СтруктураПараметров) = Тип("Структура") 
			И СтруктураПараметров.Свойство("УчетнаяЗапись") Тогда
			СтрокаОтборПоУчетнойЗаписи = " И УчетныеЗаписиRKeeper.Ссылка = &УчетнаяЗапись ";
			СтрокаОтборПоИндивидуальномуРЗ = "";
			Запрос.УстановитьПараметр("УчетнаяЗапись", СтруктураПараметров.УчетнаяЗапись);
		Иначе
			СтрокаОтборПоУчетнойЗаписи = "";
			СтрокаОтборПоИндивидуальномуРЗ = " И НЕ УчетныеЗаписиRKeeper.РЗИспользоватьИндивидуальныеНастройкиОбмена";
		КонецЕсли;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ОтборПоУчетнойЗаписи%", СтрокаОтборПоУчетнойЗаписи);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ОтборПоИндивидуальномуРЗ%", СтрокаОтборПоИндивидуальномуРЗ);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
		
			НачалоУчета = Выборка.НачалоУчета;
			Если НЕ питОбщегоНазначенияКлиентСервер.питЗначениеЗаполнено(НачалоУчета) И Не питОбщегоНазначенияКлиентСервер.питЗначениеЗаполнено(ДатаНачала) Тогда
				ТекстОшибки = "Не заполнена константа <Дата начала ведения учета R-Keeper> для учетной записи " + Выборка.Наименование;
				ЗаписьЖурналаРегистрации("Обмен.питЗагрузкаДанныхRKeeper", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выполнения обмена с R-Keeper: " + ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			ОбработкаЗагрузкаRKeeper = Обработки.питЗагрузкаRKeeper7.Создать();
			ОбработкаЗагрузкаRKeeper.УчетнаяЗапись = Выборка.Ссылка;
			ОбработкаЗагрузкаRKeeper.ТипСоответствий = Выборка.ТипСоответствий;
			// Подключимся к БД при необходимости
			Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Отключен Тогда
				Обработки.питЗагрузкаRKeeper7.ПодключитьсяКВнешнемуИсточникуДанных(Выборка.Ссылка);
			КонецЕсли;
			Если ВнешниеИсточникиДанных.питRKeeper7.ПолучитьСостояние() = СостояниеВнешнегоИсточникаДанных.Отключен Тогда
				ТекстОшибки = "Невозможно установить подключение с R-Keeper. Настройте параметры подключения для учетной записи " + Выборка.Наименование;
				ЗаписьЖурналаРегистрации("Обмен.ЗагрузкаДанныхRKeeper", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выполнения обмена с R-Keeper: " + ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			// Получим дату последнего загруженного документа
			Если ЗначениеЗаполнено(ДатаНачала) Тогда
				ОбработкаЗагрузкаRKeeper.ДатаНачала = ДатаНачала;
			Иначе
				ОбработкаЗагрузкаRKeeper.ДатаНачала = НачалоУчета;
			КонецЕсли;
			
			ОбработкаЗагрузкаRKeeper.ВыполнятьЗагрузкуИзДанныхПродажФронта = Выборка.ВыполнятьЗагрузкуИзДанныхПродажФронта;
			ОбработкаЗагрузкаRKeeper.ЗагружатьСПустымиЦенами = Истина;
			ОбработкаЗагрузкаRKeeper.ВыводитьОтчет = Ложь;
			ОбработкаЗагрузкаRKeeper.ПроцентСовпаденияСоответствия = 75;
			ОбработкаЗагрузкаRKeeper.ВидЗагрузкиУдалений = Выборка.ВидЗагрузкиУдалений;
			
			Если ОбработкаЗагрузкаRKeeper.Продажи.Количество() = 0 Тогда
				Отборы = ОбработкаЗагрузкаRKeeper.ПолучитьОтборыТаблицыПродажПоРеквизитам(МассивКасс);
				
				ОбработкаЗагрузкаRKeeper.ЗагрузитьТаблицуПродаж(Отборы, МассивКасс);
				
			КонецЕсли;
			
			РезультатПоПродажам = ОбработкаЗагрузкаRKeeper.ПолучитьРезультатПоПродажам();
			
			МассивСозданныхДокументов = ОбработкаЗагрузкаRKeeper.СоздатьДокументыДПФ(РезультатПоПродажам);
			Обработки.питЗагрузкаRKeeper7.ОтключитьсяОтВнешнегоИсточникаДанных();
			
			// СОЗДАНИЕ ЦЕЛЕВЫХ ДОКУМЕНТОВ
			Если ОбработкаЗагрузкаRKeeper.ВыполнятьЗагрузкуИзДанныхПродажФронта И МассивСозданныхДокументов.Количество() > 0 Тогда
				// если уже какая то пачка была прогружена, то ее не надо делить
				ЧекиНаСозданиеЦелевых = Обработки.питЗагрузкаИзДанныхПродажФронта.ДополнитьЧекиСвязаннымиПоЦелевым(МассивСозданныхДокументов);
				ДопПараметры = Новый Структура("Организация,УзелОбмена",ВыборкаКасс.Ссылка1С.питКассовыйУзел.Организация, ВыборкаКасс.Ссылка1С.питКассовыйУзел);
				СтруктураОбработанныхДПФ = ВыполнитьЗагрузкуИзДанныхПродаж(ДопПараметры, ЧекиНаСозданиеЦелевых);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Выполняет обмен с удаленными подразделениями плана обмена "Удаленные кассы"
//  Параметры
//
// Параметры:
//  СтруктураПараметров - Структура - Знач структура параметров.
//
Процедура ОбменСУдаленнымиКассами(Знач СтруктураПараметров = НЕОПРЕДЕЛЕНО) Экспорт
	
	ТекстОшибки = "";
	Если СтруктураПараметров = НЕОПРЕДЕЛЕНО
		ИЛИ НЕ СтруктураПараметров.Свойство("КассовыеУзлы")
		ИЛИ НЕ СтруктураПараметров.КассовыеУзлы.Количество() Тогда
		ТекстОшибки = "Не заданы параметры регламентного задания";
		#Если Клиент Тогда
			СообщениеПользователю = Новый СообщениеПользователю();
			СообщениеПользователю.Текст = ТекстОшибки;
			СообщениеПользователю.Сообщить();
		#КонецЕсли 
		ЗаписьЖурналаРегистрации("ФоновоеЗадание.ОбменСУдаленнымиКассами", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		ВызватьИсключение "Задание завершилось с ошибками по причине: Не заданы параметры регламентного задания";
	КонецЕсли;
	
	Попытка
		ПрерватьЗадание = Ложь; // флаг неуспешного завершения задания (например, ошибка фтп)
		
		Если питОбменДанными.РазделениеВключено() И НЕ (СтруктураПараметров.Свойство("ЕстьПодтверждениеНаВыгрузку") И СтруктураПараметров.ЕстьПодтверждениеНаВыгрузку) Тогда
			ТекстОшибки = НСтр("ru='Для выполнения обмена необходимо подтверждение на выгрузку данных'", "ru");
			ЗаписьЖурналаРегистрации("ФоновоеЗадание.ОбменСУдаленнымиКассами", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		ТаблицаУзлыОбмена = Новый ТаблицаЗначений;
		Если СтруктураПараметров.Свойство("КассовыеУзлы") Тогда
			ТаблицаУзлыОбмена = СтруктураПараметров.КассовыеУзлы.Скопировать();
			
			СоответствиеКаталогНаКлиенте = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТаблицаУзлыОбмена.ВыгрузитьКолонку("НастройкаДоставки"), "КаталогНаКлиенте");
			Для каждого ТекСтрокаТаблицы Из ТаблицаУзлыОбмена Цикл
				Если СоответствиеКаталогНаКлиенте.Получить(ТекСтрокаТаблицы.НастройкаДоставки) Тогда
					ТекстПредупреждения = "Узел <" + ТекСтрокаТаблицы.УзелОбмена + "> не будет обработан, т.к. в настройках доставки сообщений указан флаг ""Каталог на клиенте"" ";
					ЗаписьЖурналаРегистрации("ФоновоеЗадание.ОбменСУдаленнымиКассами", УровеньЖурналаРегистрации.Ошибка,,, ТекстПредупреждения);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		ВестиЖурналРегистрации = Истина;
		Если СтруктураПараметров.Свойство("ВестиЖурналРегистрации") Тогда
			ВестиЖурналРегистрации = СтруктураПараметров.ВестиЖурналРегистрации;
		КонецЕсли;
		
		ФиксироватьПриемОтправкуОбъектов = Ложь;
		Если СтруктураПараметров.Свойство("ФиксироватьПриемОтправкуОбъектов") Тогда
			ФиксироватьПриемОтправкуОбъектов = СтруктураПараметров.ФиксироватьПриемОтправкуОбъектов;
		КонецЕсли;
		
		питОбменДанными.ВыполнитьОбменСУдаленнымиКассами(ТаблицаУзлыОбмена, ВестиЖурналРегистрации, ФиксироватьПриемОтправкуОбъектов,,, ПрерватьЗадание);
		
		ПрефиксИмени = СокрЛП(ПланыОбмена.питУдаленныеКассы.ЭтотУзел().Код) + "_";
		
	Исключение 
		
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		ТекстОшибки = "Ошибка выполнения фонового задания: " + ТекстОшибки + Символы.ВК + "(Имя модуля: " + ИнформацияОбОшибке().ИмяМодуля + ", " 
			+ Символы.ВК + "номер строки: " + ИнформацияОбОшибке().НомерСтроки + ")"; 
		#Если Клиент Тогда
			СообщениеПользователю = Новый СообщениеПользователю();
			СообщениеПользователю.Текст = ТекстОшибки;
			СообщениеПользователю.Сообщить();
		#КонецЕсли 
		ЗаписьЖурналаРегистрации("ФоновоеЗадание.ОбменСУдаленнымиКассами", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		ПрерватьЗадание = Истина; // была явная ошибка, задание надо завершить аварийно
		
	КонецПопытки;
	
	Если ПрерватьЗадание Тогда
		ВызватьИсключение "Завершилось с ошибками. См. журнал регистрации";
	КонецЕсли;
	
КонецПроцедуры

// Выполняет загрузку из данных продаж фронта в целевые документы
//
// Параметры:
//  СтруктураПараметров - Структура - Знач структура параметров.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗагрузкаИзДанныхПродажФронта(Знач СтруктураПараметров = Неопределено) Экспорт
	
	ПрерватьЗадание = Ложь;
	
	КассовыеУзлы = Неопределено;
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") И СтруктураПараметров.Свойство("КассовыеУзлы") Тогда
		КассовыеУзлы = СтруктураПараметров.КассовыеУзлы.ВыгрузитьКолонку("УзелОбмена");
		Если СтруктураПараметров.Свойство("Организация") Тогда
			Организация = СтруктураПараметров.Организация;
		Иначе
			Организация = Справочники.Организации.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	// Дата начала отбора исходя из даты запрета изменения.
	ДатаНачалаОтбора = Дата("00010101");
	ДанныеДляПроверки = ДатыЗапретаИзменения.ШаблонДанныхДляПроверки();
	НоваяСтрока = ДанныеДляПроверки.Добавить();
	НоваяСтрока.Дата   = Дата("00010101");
	НоваяСтрока.Раздел = "питОбщепит";
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("НоваяВерсия", Истина);
	ОписаниеДанных.Вставить("Данные",      "");
	ОписаниеОшибки = Новый Структура;
	Если ДатыЗапретаИзменения.НайденЗапретИзмененияДанных(ДанныеДляПроверки, ОписаниеДанных, ОписаниеОшибки) Тогда
		Если ОписаниеОшибки.Свойство("Запреты")
			И ОписаниеОшибки.Запреты.Количество() Тогда
			// Установка даты начала отбора на начало следующего дня после даты запрета
			ДатаНачалаОтбора = КонецДня(ОписаниеОшибки.Запреты[0].ДатаЗапрета) + 1;
		КонецЕсли;
	КонецЕсли;
	
	МассивОбработанныхДанных = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КассовыеУзлы", КассовыеУзлы);
	Запрос.Текст = "ВЫБРАТЬ
	               |	питУчетДанныхПродаж.ДокументРегистратор КАК ДокументРегистратор,
	               |	питУчетДанныхПродаж.ДокументРегистратор.КассаККМ.питКассовыйУзел КАК КассовыйУзел,
				   |	питУчетДанныхПродаж.ДокументРегистратор.КассаККМ КАК КассаККМ
	               |ИЗ
	               |	РегистрСведений.питУчетДанныхПродаж КАК питУчетДанныхПродаж
	               |ГДЕ
	               |	НЕ питУчетДанныхПродаж.ОбновленПриемник
				   |	И питУчетДанныхПродаж.Дата >= &ДатаНачалаОтбора
	               |	"+?(КассовыеУзлы = Неопределено Или КассовыеУзлы.Количество()=0,"","И питУчетДанныхПродаж.ДокументРегистратор.КассаККМ.питКассовыйУзел В (&КассовыеУзлы)")+"
	               |ИТОГИ ПО
	               |	КассовыйУзел";
	Запрос.УстановитьПараметр("ДатаНачалаОтбора", ДатаНачалаОтбора);
	ВыборкаКУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	БылаЗагрузка = Ложь;
	
	Пока ВыборкаКУ.Следующий() Цикл
		ДокументыДляЗагрузкиИзДанныхПродаж = Новый Массив;
		Выборка = ВыборкаКУ.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументыДляЗагрузкиИзДанныхПродаж.Добавить(Выборка.ДокументРегистратор);
		КонецЦикла;
		ТекстОшибки = "";
		ДокументыДляЗагрузкиИзДанныхПродаж = Обработки.питЗагрузкаИзДанныхПродажФронта.ЗарегистрироватьИзмененияДанныхПродажФронта(ДокументыДляЗагрузкиИзДанныхПродаж, ТекстОшибки);
		ПрерватьЗадание = НЕ ПустаяСтрока(ТекстОшибки); // была явная ошибка, задание надо завершить аварийно
		Если ПрерватьЗадание Тогда
			Прервать;
		КонецЕсли;
		Если ДокументыДляЗагрузкиИзДанныхПродаж.Количество() Тогда
			БылаЗагрузка = Истина;
			ДопПараметры = Новый Структура("УзелОбмена,Организация", ВыборкаКУ.КассовыйУзел, Организация);
			СтруктураОбработанныхДокументов = ВыполнитьЗагрузкуИзДанныхПродаж(ДопПараметры , ДокументыДляЗагрузкиИзДанныхПродаж, ДатаНачалаОтбора);
			СтруктураОтвета	= Новый Структура;
			СтруктураОтвета.Вставить("КассовыйУзел", ВыборкаКУ.КассовыйУзел);
			СтруктураОтвета.Вставить("СтруктураОбработанныхДокументов", СтруктураОбработанныхДокументов);
			
			МассивОбработанныхДанных.Добавить(СтруктураОтвета);
		КонецЕсли; 
	КонецЦикла;
	
	Если ПрерватьЗадание Тогда
		ВызватьИсключение "Завершилось с ошибками. См. журнал регистрации";
	КонецЕсли;
	
	Если НЕ БылаЗагрузка Тогда
		ТекстСообщения = "В Кассах ККМ не заполнен кассовый узел, либо все документы находятся в закрытом периоде. Загрузка пропущена.";
		ЗаписьЖурналаРегистрации("ЗагрузкаИзДанныхПродаж", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
	КонецЕслИ;
	
	Возврат МассивОбработанныхДанных;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
// Выполняет создание документов продаж (целевых) на основании документов "ДанныеПродажФронта".
//
// Параметры:
//  ДопПараметры - Произвольный - Доп параметры.
//  МассивДокументов - Массив - Массив документов.
//  ДатаНачалаОтбора - Дата - Дата начала отбора.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВыполнитьЗагрузкуИзДанныхПродаж(ДопПараметры, МассивДокументов = Неопределено, ДатаНачалаОтбора = Неопределено)
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка из чеков общепита по кассовому узлу "+ДопПараметры.УзелОбмена+"...");
	
	СписокИсключающихДокументов = Неопределено;
	
	ОбработкаЗагрузки = Обработки.питЗагрузкаИзДанныхПродажФронта.Создать();
	ОбработкаЗагрузки.ДатаНачалаОтбора		= ?(ДатаНачалаОтбора = Неопределено, '00010101', ДатаНачалаОтбора);
	ОбработкаЗагрузки.ДатаКонцаОтбора       = КонецДня(ТекущаяДата());
	ОбработкаЗагрузки.Организация           = ДопПараметры.Организация;
	ОбработкаЗагрузки.КассовыйУзел = ДопПараметры.УзелОбмена;
	ОбработкаЗагрузки.ГруппироватьПоНомеруСмены = Истина;
	
	Если СписокИсключающихДокументов = Неопределено Тогда
		СписокИсключающихДокументов = ОбработкаЗагрузки.СписокИсключающихДокументов;
	Иначе
		ОбработкаЗагрузки.СписокИсключающихДокументов = СписокИсключающихДокументов;
	КонецЕсли;
	
	// Создание целевых документов
	Если МассивДокументов <> Неопределено Тогда
		
		// Фильтр массива документов, исключаем неподдерживаемые операции.
		ВидыОперацийДокументов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивДокументов, "ВидОперации");
		ДокументыДляЗагрузки = Новый Массив;
		Для каждого ТекДокумент Из МассивДокументов Цикл
			Если ВидыОперацийДокументов.Получить(ТекДокумент) = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаНеподдерживаемаяОперация Тогда
				Продолжить;
			КонецЕсли;
			ДокументыДляЗагрузки.Добавить(ТекДокумент);
		КонецЦикла;
		
		ОбработкаЗагрузки.СписокОбрабатываемыхДокументов = Новый СписокЗначений;
		ОбработкаЗагрузки.СписокОбрабатываемыхДокументов.ЗагрузитьЗначения(ДокументыДляЗагрузки);
	КонецЕсли;
	
	ОбработкаЗагрузки.ЗагрузитьПараметрыКассККМ();
	СтруктураОбработанныхДокументов = ОбработкаЗагрузки.ВыполнитьЗагрузкуДанных();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Завершено создание целевых документов по чекам Общепита по кассовому узлу " + ДопПараметры.УзелОбмена);
		
	Возврат СтруктураОбработанныхДокументов;
	
КонецФункции

#КонецОбласти






