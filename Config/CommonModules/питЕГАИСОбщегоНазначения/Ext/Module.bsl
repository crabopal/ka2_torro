КонецПроцедуры

// Документы АктСписанияЕГАИС АктСписанияЕГАИСXML
//
// Параметры:
//  ЕстьЧастичноеВыбытие - Булево - Признак частичного выбытия.
//  Шапка - Произвольный - Шапка документа.
//
Процедура АктСписанияЕГАИСXMLСкорректироватьЧастичноеВыбытие(ЕстьЧастичноеВыбытие, Шапка) Экспорт
	
	ЕстьЧастичноеВыбытие = ЕстьЧастичноеВыбытие ИЛИ Шапка.ПричинаСписания = Перечисления.ПричиныСписанийЕГАИС.питПриготовление;
	
КонецПроцедуры

Процедура СлужебныеДанныеАлкогольнойПродукцииСкорректироватьЧастичноеВыбытие(ТекстЗапроса) Экспорт
	
	СтрокаИЗТовары = "
		|ИЗ
		|	Товары КАК Товары";
	
	поз = СтрНайти(ТекстЗапроса, СтрокаИЗТовары, НаправлениеПоиска.СКонца);
	Если поз > 0 Тогда
		
		ТекстЗапроса = Сред(ТекстЗапроса, 1, поз) +
			"
			|ПОМЕСТИТЬ ВТ_ДанныеАлкогольнойПродукции" +
			Сред(ТекстЗапроса,поз) +
			"
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	*,
			|	ЕСТЬNULL(ОписаниеНоменклатурыИС.ЕмкостьПотребительскойУпаковки, 1) КАК ЕмкостьПотребительскойУпаковки,
			|	Товары.ЭтоНоменклатураЧастичногоВыбытия
			|		ИЛИ Товары.ТипПродукции = ЗНАЧЕНИЕ(Перечисление.ТипыПродукцииЕГАИС.Упакованная)
			|			И Товары.ВариантЧастичногоВыбытия = ЗНАЧЕНИЕ(Перечисление.ВариантыУчетаЧастичногоВыбытияИС.ТекущаяНоменклатура) КАК ЭтоНоменклатураЧастичногоВыбытия
			|ИЗ
			|	ВТ_ДанныеАлкогольнойПродукции КАК Товары
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
			|		ПО Товары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура"
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СлужебныеДанныеАлкогольнойПродукцииСкорректироватьКоличествоЕГАИС(СтрокаТЧ, СтрокаПродукции, ЕстьКолонкаКоличествоЕГАИС) Экспорт
	
	ЕстьЕмкостьПотребительскойУпаковки = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаПродукции, "ЕмкостьПотребительскойУпаковки");
	
	Если ЕстьКолонкаКоличествоЕГАИС И ЕстьЕмкостьПотребительскойУпаковки Тогда
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			Если СтрокаПродукции.ЭтоНоменклатураЧастичногоВыбытия Тогда
				СтрокаТЧ.КоэффициентЕГАИС = СтрокаПродукции.ЕмкостьПотребительскойУпаковки / СтрокаПродукции.КоличествоВПотребительскойУпаковке;
				СтрокаТЧ.КоличествоЕГАИС = СтрокаТЧ.Количество * СтрокаТЧ.КоэффициентЕГАИС;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

