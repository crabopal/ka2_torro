// Функция - Получить таблицу выпускаемой продукции выпуска продукции.
//
// Параметры:
//  ДокСсылка - Произвольный - Док ссылка.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуВыпускаемойПродукции_ВыпускаПродукции(ДокСсылка)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПроизводства.Номенклатура КАК Номенклатура,
	|	ТаблицаПроизводства.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	ТаблицаПроизводства.УпаковкаНоменклатуры КАК УпаковкаНоменклатуры
	|ПОМЕСТИТЬ ВТ_Производство
	|ИЗ
	|	&ТаблицаПроизводства КАК ТаблицаПроизводства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Производство.Номенклатура КАК Номенклатура,
	|	ВТ_Производство.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	ВТ_Производство.УпаковкаНоменклатуры КАК УпаковкаНоменклатуры
	|ПОМЕСТИТЬ ТЧСгруп
	|ИЗ
	|	ВТ_Производство КАК ВТ_Производство
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО ВТ_Производство.Номенклатура = НоменклатураСпр.Ссылка
	|ГДЕ
	|	НоменклатураСпр.ВидАлкогольнойПродукции <> ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Производство.Номенклатура,
	|	ВТ_Производство.КоличествоНоменклатуры,
	|	ВТ_Производство.УпаковкаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧСгруп.Номенклатура КАК Номенклатура,
	|	ТЧСгруп.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	ТЧСгруп.УпаковкаНоменклатуры КАК УпаковкаНоменклатуры
	|ИЗ
	|	ТЧСгруп КАК ТЧСгруп";
	
	Запрос.УстановитьПараметр("ТаблицаПроизводства", ДокСсылка.Блюда.Выгрузить());
	
	ТЗПродукции = Запрос.Выполнить().Выгрузить();
	Возврат ТЗПродукции;
	
КонецФункции

// Функция - Получить таблицу сырья выпуска продукции.
//
// Параметры:
//  ДокСсылка - Произвольный - Док ссылка.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуСырья_ВыпускаПродукции(ДокСсылка)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПроизводства.Ингредиент КАК Номенклатура,
	|	ТаблицаПроизводства.КоличествоУпаковокИнгредиентаФакт КАК КоличествоНоменклатуры,
	|	ТаблицаПроизводства.УпаковкаИнгредиента КАК УпаковкаНоменклатуры,
	|	ТаблицаПроизводства.ИзАвтопеределов КАК ИзАвтопеределов
	|ПОМЕСТИТЬ ВТ_Производство
	|ИЗ
	|	&ТаблицаПроизводства КАК ТаблицаПроизводства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Производство.Номенклатура КАК Номенклатура,
	|	ВТ_Производство.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	ВТ_Производство.УпаковкаНоменклатуры КАК УпаковкаНоменклатуры,
	|	ВТ_Производство.ИзАвтопеределов КАК ИзАвтопеределов
	|ПОМЕСТИТЬ ТЧСгруп
	|ИЗ
	|	ВТ_Производство КАК ВТ_Производство
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО ВТ_Производство.Номенклатура = НоменклатураСпр.Ссылка
	|ГДЕ
	|	НЕ ВТ_Производство.ИзАвтопеределов
	|	И НоменклатураСпр.ВидАлкогольнойПродукции <> ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Производство.Номенклатура,
	|	ВТ_Производство.КоличествоНоменклатуры,
	|	ВТ_Производство.УпаковкаНоменклатуры,
	|	ВТ_Производство.ИзАвтопеределов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧСгруп.Номенклатура КАК Номенклатура,
	|	ТЧСгруп.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	ТЧСгруп.УпаковкаНоменклатуры КАК УпаковкаНоменклатуры
	|ИЗ
	|	ТЧСгруп КАК ТЧСгруп";
	
	Запрос.УстановитьПараметр("ТаблицаПроизводства", ДокСсылка.Ингредиенты.Выгрузить());
	
	ТЗСырья = Запрос.Выполнить().Выгрузить();
	Возврат ТЗСырья;
	
КонецФункции

// Функция - Получить таблицу номенклатуры в номенклатуре егаис.
//
// Параметры:
//  ТЗВходящая - Произвольный - Тз входящая.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ПолучитьТаблицуНоменклатурыВНоменклатуреЕГАИС(ТЗВходящая)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗВходящая.Номенклатура КАК Номенклатура,
	|	ТЗВходящая.КоличествоНоменклатуры КАК КоличествоНоменклатуры,
	|	ТЗВходящая.УпаковкаНоменклатуры КАК УпаковкаНоменклатуры
	|ПОМЕСТИТЬ ТЗВходящая
	|ИЗ
	|	&ТЗВх КАК ТЗВходящая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗВходящая.Номенклатура КАК Номенклатура,
	|	ТЗВходящая.КоличествоНоменклатуры КАК КоличествоБУВБазовых
	|ПОМЕСТИТЬ ОстаткиБУВБазовыхЕдИзм
	|ИЗ
	|	ТЗВходящая КАК ТЗВходящая
	|ГДЕ
	|	НЕ ТЗВходящая.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБУВБазовыхЕдИзм.КоличествоБУВБазовых КАК КоличествоОстатокБУ,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК НоменклатураАлкоголь
	|ПОМЕСТИТЬ ОстаткиБУВАлкогольнойНоменклатуреВсе
	|ИЗ
	|	ОстаткиБУВБазовыхЕдИзм КАК ОстаткиБУВБазовыхЕдИзм
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|		ПО ОстаткиБУВБазовыхЕдИзм.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБУВАлкогольнойНоменклатуреВсе.НоменклатураАлкоголь КАК АлкогольнаяПродукция,
	|	ОстаткиБУВАлкогольнойНоменклатуреВсе.НоменклатураАлкоголь.Код КАК Алкокод,
	|	ОстаткиБУВАлкогольнойНоменклатуреВсе.Номенклатура КАК Номенклатура,
	|	ОстаткиБУВАлкогольнойНоменклатуреВсе.КоличествоОстатокБУ КАК Количество
	|ИЗ
	|	ОстаткиБУВАлкогольнойНоменклатуреВсе КАК ОстаткиБУВАлкогольнойНоменклатуреВсе";
	
	Запрос.УстановитьПараметр("ТЗВх", ТЗВходящая);
	
	ТЗСырья = Запрос.Выполнить().Выгрузить();
	Возврат ТЗСырья;
	
КонецФункции

