				// Если передали склад списком
				СтрокаУсловияАктов = СтрокаУсловияАктов + " И АктВскрытияТарыАлкогольнойПродукцииТовары.Ссылка.Склад В (&Склад)";
				СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И ВЫБОР КОГДА питДанныеПродажФронтаАлкоголь.Ссылка.КассаККМ.питКассовыйУзел.СпособОпределенияСкладаРеализации = 1 И питДанныеПродажФронтаАлкоголь.Ссылка.Зал.СкладРеализации <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА
														|		питДанныеПродажФронтаАлкоголь.Ссылка.Зал.СкладРеализации
														|	ИНАЧЕ
														|		 питДанныеПродажФронтаАлкоголь.Ссылка.КассаККМ.питКассовыйУзел.СкладРеализации
														|	КОНЕЦ В (&Склад)";
			КонецЕсли;
		КонецЕсли;
		СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И (ВЫБОР КОГДА питДанныеПродажФронтаАлкоголь.Ссылка.КассаККМ.питКассовыйУзел.СпособОпределенияСкладаРеализации = 1 И питДанныеПродажФронтаАлкоголь.Ссылка.Зал.СкладРеализации <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА
												|		питДанныеПродажФронтаАлкоголь.Ссылка.Зал.СкладРеализации
												|	ИНАЧЕ
												|		 питДанныеПродажФронтаАлкоголь.Ссылка.КассаККМ.питКассовыйУзел.СкладРеализации
												|	КОНЕЦ, питДанныеПродажФронтаАлкоголь.Номенклатура) В
												|				(ВЫБРАТЬ
												|					АлкоПродукцияПодлежащаяАктуВскрытия.СкладКомпании,
												|					АлкоПродукцияПодлежащаяАктуВскрытия.Номенклатура
												|				ИЗ
												|					АлкоПродукцияПодлежащаяАктуВскрытия КАК АлкоПродукцияПодлежащаяАктуВскрытия)";
		СтрокаУсловияАктов = СтрокаУсловияАктов +  " И (АктВскрытияТарыАлкогольнойПродукцииТовары.Ссылка.Склад, АктВскрытияТарыАлкогольнойПродукцииТовары.Номенклатура) В
		|				(ВЫБРАТЬ
		|					АлкоПродукцияПодлежащаяАктуВскрытия.СкладКомпании,
		|					АлкоПродукцияПодлежащаяАктуВскрытия.Номенклатура
		|				ИЗ
		|					АлкоПродукцияПодлежащаяАктуВскрытия КАК АлкоПродукцияПодлежащаяАктуВскрытия)";
		
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДПФ", СтрокаУсловияДПФ);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеАктов", СтрокаУсловияАктов);
	
	ЗапросПолучениеАкциза.Текст = ТекстЗапроса;
	
	РезультатЗапроса = ЗапросПолучениеАкциза.ВыполнитьПакет();
	Выборка = РезультатЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗАлкогольнаяПродукция.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
	КонецЦикла;

	Выборка = РезультатЗапроса[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗАлкогольнаяПродукцияСКоличеством.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
	КонецЦикла;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТЗПродаж", ТЗПродаж);
	СтруктураВозврата.Вставить("МассивОшибок", МассивОшибок);
	СтруктураВозврата.Вставить("АкцизныеМарки",ТЗАлкогольнаяПродукция);
	СтруктураВозврата.Вставить("АкцизныеМаркиСКоличеством", ТЗАлкогольнаяПродукцияСКоличеством);
	Возврат СтруктураВозврата;
	
	
КонецФункции

// Функция - Получить номенклатуру по алкопродукции из соответствия.
//
// Параметры:
//  АлкоПродукция - Произвольный - Алко продукция.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьНоменклатуруПоАлкопродукцииИзСоответствия(АлкоПродукция) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствиеНоменклатурыЕГАИС.Номенклатура
	               |ИЗ
	               |	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	               |ГДЕ
	               |	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = &АлкогольнаяПродукция";
	Запрос.УстановитьПараметр("АлкогольнаяПродукция", АлкоПродукция);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	Иначе
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
		
КонецФункции

// Функция - Получить соответствие алко номенклатуры по pd f4 1 7.
//
// Параметры:
//  ШтрихкодСтрокой - Произвольный - Штрихкод строкой.
//  ОрганизацияЕГАИС - Произвольный - Организация егаис.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
Функция ПолучитьСоответствиеАлкоНоменклатурыПоPDF417(ШтрихкодСтрокой, ОрганизацияЕГАИС = Неопределено) Экспорт
	
	// Ищем в спр упаковок для новых марок, если не нашли, ищем "старым" методом.
	Результат = Новый Соответствие;
	АкцизныеМаркиВДокументе = Неопределено;
	СписокШтрихкодов = Новый Массив;
	СписокШтрихкодов.Добавить(ШтрихкодСтрокой);
	
	ШтрихкодыУпаковок = питНайтиШтрихкодыУпаковокПоСпискуШтрихкодов(
		СписокШтрихкодов,
		ОрганизацияЕГАИС,
		Перечисления.ТипыУпаковок.МаркированныйТовар);
	
	КодыАлкогольнойПродукции = Новый Массив;
	СоответствиеКодаАкцизнойМарке = Новый Соответствие;
	
	Для Каждого КлючЗначение Из ШтрихкодыУпаковок Цикл
		
		ДанныеШтрихкодаУпаковки = КлючЗначение.Значение[0];
		
		ДанныеШтрихкода = АкцизныеМаркиКлиентСервер.СтруктураДанныхШтрихкода(КлючЗначение.Ключ);
		ДанныеШтрихкода.Штрихкод         = КлючЗначение.Ключ;
		ДанныеШтрихкода.ШтрихкодУпаковки = ДанныеШтрихкодаУпаковки.Ссылка;
		ДанныеШтрихкода.ТипШтрихкода     = Перечисления.ТипыШтрихкодов.PDF417;
		
		ЗаполнитьЗначенияСвойств(ДанныеШтрихкода, ДанныеШтрихкодаУпаковки);
		
		
		Если ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
			ТарнаяЕд = ДанныеШтрихкода.Номенклатура.питТарнаяЕдиницаИзмерения;
			ДанныеШтрихкода.Вставить("ТарнаяЕдиницаИзмерения"      , ТарнаяЕд);
			Если НЕ ЗначениеЗаполнено(ТарнаяЕд) Тогда
				ДанныеШтрихкода.Вставить("КоэффициентТарной"           , 1);
			Иначе
//   СтрокаСЕдиницей = ДанныеШтрихкода.Номенклатура.питТарнаяЕдиницаИзмерения.Найти(ТарнаяЕд,
// "ЕдиницаПоКлассификатору");.
				Если НЕ ТарнаяЕд.Пустая() Тогда
					ДанныеШтрихкода.Вставить("КоэффициентТарной"           , ТарнаяЕд.Коэффициент);
				Иначе
					ДанныеШтрихкода.Вставить("КоэффициентТарной"           , 1);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ДанныеШтрихкода.Вставить("ТарнаяЕдиницаИзмерения"      , Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
			ДанныеШтрихкода.Вставить("КоэффициентТарной"           , 1);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеШтрихкода.КодАлкогольнойПродукции) Тогда
			ДанныеШтрихкода.КодАлкогольнойПродукции = АкцизныеМаркиВызовСервера.КодКлассификатораНоменклатурыЕГАИС(ДанныеШтрихкода.Штрихкод);
			КодыАлкогольнойПродукции.Добавить(ДанныеШтрихкода.КодАлкогольнойПродукции);
			
			СоответствиеКодаАкцизнойМарке.Вставить(ДанныеШтрихкода.КодАлкогольнойПродукции, ДанныеШтрихкода.Штрихкод);
		КонецЕсли;
		
		Результат.Вставить(КлючЗначение.Ключ, ДанныеШтрихкода);
		
		Индекс = СписокШтрихкодов.Найти(КлючЗначение.Ключ);
		Пока Индекс <> Неопределено Цикл
			СписокШтрихкодов.Удалить(Индекс);
			Результат[КлючЗначение.Ключ].Количество = Результат[КлючЗначение.Ключ].Количество + 1;
			
			Индекс = СписокШтрихкодов.Найти(КлючЗначение.Ключ);
		КонецЦикла;
		
	КонецЦикла;
	
	СоответствиеАлкогольнойПродукции = ИнтеграцияЕГАИС.СоответствиеАлкогольнойПродукции(КодыАлкогольнойПродукции);
	Для Каждого КлючИЗначение Из СоответствиеАлкогольнойПродукции Цикл
		КодАкцизнойМарки = СоответствиеКодаАкцизнойМарке[КлючИЗначение.Ключ];
		ДанныеШтрихкода = Результат[КодАкцизнойМарки];
		Если ДанныеШтрихкода <> Неопределено Тогда
			ДанныеШтрихкода.АлкогольнаяПродукция = КлючИЗначение.Значение
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КодАкцизнойМарки Из СписокШтрихкодов Цикл
		
		Если Результат[КодАкцизнойМарки] <> Неопределено Тогда
			Результат[КодАкцизнойМарки].Количество = Результат[КодАкцизнойМарки].Количество + 1;
			Продолжить;
		КонецЕсли;
	
		ДанныеШтрихкода = АкцизныеМаркиКлиентСервер.СтруктураДанныхШтрихкода(КодАкцизнойМарки);
		ДанныеШтрихкода.Количество   = 1;
		ДанныеШтрихкода.ТипШтрихкода = Перечисления.ТипыШтрихкодов.PDF417;
		ДанныеШтрихкода.ТипУпаковки  = Перечисления.ТипыУпаковок.МаркированныйТовар;
		
		//
		ВидПродукции = Перечисления.ВидыПродукцииИС.Алкогольная;
		
		СтруктураШтрихкода = РазборКодаМаркировкиЕГАИСОбщегоНазначенияКлиентСервер.РазложитьШтрихкодСНомеромИСерией(КодАкцизнойМарки, "");
		ВидыПродукции = Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВидПродукции));
		
		ТипШтрихкодаИВидУпаковки = РазборКодаМаркировкиИССлужебныйКлиентСервер.ТипШтрихкодаИВидУпаковки();
		ТипШтрихкодаИВидУпаковки.ТипШтрихкода = Перечисления.ТипыШтрихкодов.DataMatrix;
		ТипШтрихкодаИВидУпаковки.ВидУпаковки  = Перечисления.ВидыУпаковокИС.АкцизнаяМаркаСНомеромИСерией;
		
		СоставКодаМаркировки = Новый Структура;
		СоставКодаМаркировки.Вставить("ТипМарки",   СтруктураШтрихкода.ТипМарки);
		СоставКодаМаркировки.Вставить("СерияМарки", СтруктураШтрихкода.СерияМарки);
		СоставКодаМаркировки.Вставить("НомерМарки", СтруктураШтрихкода.НомерМарки);
		
		ДанныеШтрихкода.Вставить("СоставКодаМаркировки", СоставКодаМаркировки);
		//
		
		АкцизныеМаркиВызовСервера.ЗаполнитьСопоставленнуюНоменклатуруПоАкцизнойМарке(КодАкцизнойМарки, ДанныеШтрихкода);
		
		Если ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
			ТарнаяЕд = ДанныеШтрихкода.Номенклатура.питТарнаяЕдиницаИзмерения;
			ДанныеШтрихкода.Вставить("ТарнаяЕдиницаИзмерения"      , ТарнаяЕд);
			Если НЕ ЗначениеЗаполнено(ТарнаяЕд) Тогда
				ДанныеШтрихкода.Вставить("КоэффициентТарной"           , 1);
			Иначе
//   СтрокаСЕдиницей = ДанныеШтрихкода.Номенклатура.питТарнаяЕдиницаИзмерения.Найти(ТарнаяЕд,
// "ЕдиницаПоКлассификатору");.
				Если НЕ ТарнаяЕд.Пустая() Тогда
					ДанныеШтрихкода.Вставить("КоэффициентТарной"           , ТарнаяЕд.Коэффициент);
				Иначе
					ДанныеШтрихкода.Вставить("КоэффициентТарной"           , 1);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ДанныеШтрихкода.Вставить("ТарнаяЕдиницаИзмерения"      , Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
			ДанныеШтрихкода.Вставить("КоэффициентТарной"           , 1);
		КонецЕсли;
		
		Результат.Вставить(КодАкцизнойМарки, ДанныеШтрихкода);
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Функция - Параметры получения списанных марок при производстве
//
// Параметры:
//  ОрганизацияЕГАИС - СправочникСсылка.КлассификаторОрганизацийЕГАИС - Организация ЕГАИС.
//  ДатаОтбора - Дата - Знач дата отбора.     
//  СпособЗаполнения - Число - 0 - По производству, 1 - По чекам проциями, 2- По чекам - коктейлями.
//
// Возвращаемое значение:
//  Структура - Входные параметры.
Функция ПараметрыПолученияСписанныхМарокПриПроизводстве(ОрганизацияЕГАИС, Знач ДатаОтбора = Неопределено, СпособЗаполнения = 0) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДатаОтбора) Тогда
		ДатаОтбора = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОтбора) Тогда
		НачалоПериода = НачалоДня(ДатаОтбора);
		КонецПериода = КонецДня(ДатаОтбора);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НачалоПериода", НачалоПериода);
	Результат.Вставить("КонецПериода", КонецПериода);
	Результат.Вставить("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Результат.Вставить("СпособЗаполнения", СпособЗаполнения);
	
	// Необязательные.
	Результат.Вставить("Организация");
	Результат.Вставить("СтруктурнаяЕдиница");
	
	Возврат Результат;
КонецФункции

// Функция - Получить списанные на производство марки
//
// Параметры:
//  ВходныеПараметры - структура - ПараметрыПолученияСписанныхМарокПриПроизводстве().
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица списанных марок.
Функция ПолучитьСписанныеНаПроизводствоМарки(ВходныеПараметры) Экспорт
	
	ТаблицаМарок = Новый ТаблицаЗначений;
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаМарок, "Номенклатура", 
		Тип("СправочникСсылка.Номенклатура"));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаМарок, "АлкогольнаяПродукция", 
		Тип("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаМарок, "Справка2", 
		Тип("СправочникСсылка.Справки2ЕГАИС"));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаМарок, "ШтрихкодУпаковки", 
		Тип("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаМарок, "Количество", 
		ОбщегоНазначения.ОписаниеТипаЧисло(18,4));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаМарок, "КоличествоВМЛ", 
		ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаМарок, "ЕдиницаИзмерения", 
		Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
		
	// Доопределим стандартные реквизиты.
	Если НЕ ЗначениеЗаполнено(ВходныеПараметры.Организация)
		ИЛИ НЕ ЗначениеЗаполнено(ВходныеПараметры.СтруктурнаяЕдиница) Тогда
		
		РеквизитыОрганизацииЕГАИС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВходныеПараметры.ОрганизацияЕГАИС, "ТорговыйОбъект, Контрагент, Сопоставлено");
		Если НЕ РеквизитыОрганизацииЕГАИС.Сопоставлено Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Организация ЕГАИС не сопоставлена ни с одной организацией в учетной базе!'"));
			Возврат ТаблицаМарок;
		КонецЕсли;
		
		ВходныеПараметры.Организация = РеквизитыОрганизацииЕГАИС.Контрагент;
		ВходныеПараметры.СтруктурнаяЕдиница = РеквизитыОрганизацииЕГАИС.ТорговыйОбъект;
		
	КонецЕсли;
	
	Склады = питОбщегоНазначенияКлиентСервер.ЗначениеВМассив(ВходныеПараметры.СтруктурнаяЕдиница);
	
	ИспользоватьМаркиИСКассовыхСистемПриПроизводстве = Константы.питИспользоватьМаркиИСКассовыхСистемПриПроизводстве.Получить();
	
	ДоступныеМестаПечати = Новый Массив;
	Если ВходныеПараметры.СпособЗаполнения = 1
		ИЛИ ВходныеПараметры.СпособЗаполнения = 2
		ИЛИ ИспользоватьМаркиИСКассовыхСистемПриПроизводстве Тогда
		ДоступныеМестаПечати = Справочники.питМестаПечати.МестаПечатиПоСтруктурнойЕдинице(Склады);
	КонецЕсли;
	
	Если ВходныеПараметры.СпособЗаполнения = 0 Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Склады, ДоступныеМестаПечати);
	ИначеЕсли ВходныеПараметры.СпособЗаполнения = 1
		ИЛИ ВходныеПараметры.СпособЗаполнения = 2 Тогда
		Склады = ДоступныеМестаПечати;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ВходныеПараметры.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ВходныеПараметры.КонецПериода);
	Запрос.УстановитьПараметр("Организация", ВходныеПараметры.Организация);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ВходныеПараметры.ОрганизацияЕГАИС);
	
	ВидыДвиженийМарок = Новый Массив;
	Если ВходныеПараметры.СпособЗаполнения = 0 Тогда
		ВидыДвиженийМарок.Добавить(Перечисления.питВидыДвиженийОстатковМарокИС.Приготовление);
	ИначеЕсли ВходныеПараметры.СпособЗаполнения = 1 Тогда
		ВидыДвиженийМарок.Добавить(Перечисления.питВидыДвиженийОстатковМарокИС.ПродажаПорций);
		ВидыДвиженийМарок.Добавить(Перечисления.питВидыДвиженийОстатковМарокИС.ОтменаПорций);
	ИначеЕсли ВходныеПараметры.СпособЗаполнения = 2 Тогда
		ВидыДвиженийМарок.Добавить(Перечисления.питВидыДвиженийОстатковМарокИС.ПродажаБлюд);
		ВидыДвиженийМарок.Добавить(Перечисления.питВидыДвиженийОстатковМарокИС.ОтменаБлюд);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВидыДвиженийМарок", ВидыДвиженийМарок);
	Запрос.УстановитьПараметр("МестоПечати", Склады);

	СписаниеМарокИСПриПроизводстве = Константы.питСписаниеМарокИСПриПроизводстве.Получить();
	Запрос.УстановитьПараметр("СписаниеМарокИСПриПроизводстве", СписаниеМарокИСПриПроизводстве);

	ТекстЗапроса = "ВЫБРАТЬ
	|	ОстаткиМарокИС.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИС.Штрихкод КАК Штрихкод,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиМарокИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОстаткиМарокИС.Количество
	|			ИНАЧЕ -ОстаткиМарокИС.Количество
	|		КОНЕЦ) КАК Количество
	|ПОМЕСТИТЬ ВТ_Марки
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС КАК ОстаткиМарокИС
	|ГДЕ
	|	ОстаткиМарокИС.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ОстаткиМарокИС.Организация = &Организация
	|	И ОстаткиМарокИС.МестоПечати В(&МестоПечати)
	|	И ОстаткиМарокИС.ВидДвиженияМарок В(&ВидыДвиженийМарок)
	|	И НЕ ОстаткиМарокИС.Штрихкод = ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМарокИС.Номенклатура,
	|	ОстаткиМарокИС.Штрихкод
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиМарокИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОстаткиМарокИС.Количество
	|			ИНАЧЕ -ОстаткиМарокИС.Количество
	|		КОНЕЦ) < 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Марки.Номенклатура КАК Номенклатура,
	|	ВТ_Марки.Штрихкод КАК ШтрихкодУпаковки,
	|	-ВТ_Марки.Количество КАК КоличествоВМЛ,
	|	АкцизныеМаркиЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	АкцизныеМаркиЕГАИС.Справка2 КАК Справка2,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения 
	|ИЗ
	|	ВТ_Марки КАК ВТ_Марки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	|		ПО ВТ_Марки.Штрихкод = АкцизныеМаркиЕГАИС.АкцизнаяМарка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ПО ВТ_Марки.Штрихкод = ШтрихкодыУпаковокТоваров.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТ_Марки.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС";
		
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ТаблицаМарок;
	КонецЕсли;
	
	КэшПараметров = Неопределено;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаМарок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);   
		НоваяСтрока.Количество = питОбщегоНазначения.ПеревестиОбъемИзМиллилитров(НоваяСтрока.Номенклатура,
			НоваяСтрока.ЕдиницаИзмерения,
			Выборка.КоличествоВМЛ);
	КонецЦикла;
	
	Возврат ТаблицаМарок;
КонецФункции

#КонецОбласти

#Область ПолучениеДанныхПоШтрихкодам

// Процедура - Проверить и заполнить вложенные штрихкоды.
//
// Параметры:
//  ДеревоУпаковок - ДеревоЗначений - Дерево упаковок.
//  ВложенныеШтрихкоды - Произвольный - Вложенные штрихкоды.
//  АкцизныеМаркиВДокументе - Произвольный - Акцизные марки в документе.
//  ОбработанныеШтрихкоды - Произвольный - Обработанные штрихкоды.
//  ШтрихкодыУпаковок - Произвольный - Штрихкоды упаковок.
//
Процедура ПроверитьИЗаполнитьВложенныеШтрихкоды(ДеревоУпаковок, ВложенныеШтрихкоды, АкцизныеМаркиВДокументе,
	                                            ОбработанныеШтрихкоды = Неопределено, ШтрихкодыУпаковок = Неопределено) Экспорт
	
	Для Каждого СтрокаДерева Из ДеревоУпаковок Цикл
		
		Если АкцизныеМаркиВДокументе <> Неопределено
			И АкцизныеМаркиВДокументе[СтрокаДерева.ШтрихкодУпаковки] <> Неопределено Тогда
			СтрокаДерева.ЕстьОшибки  = Истина;
			СтрокаДерева.ТекстОшибки = НСтр("ru='Уже добавлена в документ'");
		КонецЕсли;
		
		
		Если ОбработанныеШтрихкоды <> Неопределено 
			И ШтрихкодыУпаковок <> Неопределено Тогда
			
			Если ШтрихкодыУпаковок.Найти(СтрокаДерева.ШтрихкодУпаковки) <> Неопределено Тогда
				
				ДанныеШтрихкода = АкцизныеМаркиКлиентСервер.СтруктураДанныхШтрихкода(СтрокаДерева.ЗначениеШтрихкода);
				ДанныеШтрихкода.ШтрихкодУпаковки        = СтрокаДерева.ШтрихкодУпаковки;
				ДанныеШтрихкода.ТипШтрихкода            = СтрокаДерева.ТипШтрихкода;
				ДанныеШтрихкода.ТипУпаковки             = СтрокаДерева.ТипУпаковки;
				ДанныеШтрихкода.АлкогольнаяПродукция    = СтрокаДерева.АлкогольнаяПродукция;
				ДанныеШтрихкода.КодАлкогольнойПродукции = СтрокаДерева.КодАлкогольнойПродукции;
				ДанныеШтрихкода.Справка2                = СтрокаДерева.Справка2;
				ДанныеШтрихкода.Номенклатура            = СтрокаДерева.Номенклатура;
				ДанныеШтрихкода.Характеристика          = СтрокаДерева.Характеристика;
				ДанныеШтрихкода.Серия                   = СтрокаДерева.Серия;
				Если ДанныеШтрихкода.ТипУпаковки = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка Тогда
					ДанныеШтрихкода.Количество = СтрокаДерева.КоличествоАкцизныхМарок;
				КонецЕсли;
				
				ОбработанныеШтрихкоды.Вставить(СтрокаДерева.ШтрихкодУпаковки, ДанныеШтрихкода);
				
			КонецЕсли;
		
		КонецЕсли;
		
		ВложенныеШтрихкоды.Вставить(СтрокаДерева.ШтрихкодУпаковки, СтрокаДерева.ЗначениеШтрихкода);
		
		ПроверитьИЗаполнитьВложенныеШтрихкоды(СтрокаДерева.Строки, ВложенныеШтрихкоды, АкцизныеМаркиВДокументе);
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - пит найти штрихкоды упаковок по списку штрихкодов.
//
// Параметры:
//  ЗначенияШтрихкодов - Произвольный - Значения штрихкодов.
//  ОрганизацияЕГАИС - Произвольный - Организация егаис.
//  ТипыУпаковок - Произвольный - Типы упаковок.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция питНайтиШтрихкодыУпаковокПоСпискуШтрихкодов(ЗначенияШтрихкодов, ОрганизацияЕГАИС = Неопределено, ТипыУпаковок = Неопределено) Экспорт
	
	Результат = Новый Соответствие;
	
	Если ТипЗнч(ЗначенияШтрихкодов) = Тип("Массив") Тогда
		СписокЗначенийШтрихкодов = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ЗначенияШтрихкодов);
	Иначе
		СписокЗначенийШтрихкодов = Новый Массив;
		СписокЗначенийШтрихкодов.Добавить(ЗначенияШтрихкодов);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокЗначенийШтрихкодов", СписокЗначенийШтрихкодов);
	Если НЕ ОрганизацияЕГАИС = Неопределено Тогда
		Запрос.УстановитьПараметр("ОрганизацияЕГАИС",         ОрганизацияЕГАИС);
	КонецЕсли;
	Запрос.УстановитьПараметр("УсловиеПоТипамУпаковок",   Истина);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка            КАК Ссылка,
	|	ШтрихкодыУпаковокТоваров.ДатаУпаковки      КАК ДатаУпаковки,
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
	|	ШтрихкодыУпаковокТоваров.ТипУпаковки       КАК ТипУпаковки,
	|	ШтрихкодыУпаковокТоваров.ТипШтрихкода      КАК ТипШтрихкода,
	|	ШтрихкодыУпаковокТоваров.Номенклатура      КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика    КАК Характеристика,
	|	ШтрихкодыУпаковокТоваров.Упаковка          КАК Упаковка,
	|	ШтрихкодыУпаковокТоваров.Серия             КАК Серия
	|ПОМЕСТИТЬ ШтрихкодыУпаковокТоваров
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода В(&СписокЗначенийШтрихкодов)
	|	И &УсловиеПоТипамУпаковок
	|;
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(ШтрихкодыУпаковокТоваров.ДатаУпаковки) КАК ДатаУпаковки,
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода
	|ПОМЕСТИТЬ МаксимальныеДатыУпаковки
	|ИЗ
	|	ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода В(&СписокЗначенийШтрихкодов)
	|СГРУППИРОВАТЬ ПО
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода
	|;
	|
	|ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка            КАК Ссылка,
	|	ШтрихкодыУпаковокТоваров.ДатаУпаковки      КАК ДатаУпаковки,
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода,
	|	ШтрихкодыУпаковокТоваров.ТипУпаковки       КАК ТипУпаковки,
	|	ШтрихкодыУпаковокТоваров.ТипШтрихкода      КАК ТипШтрихкода,
	|	ШтрихкодыУпаковокТоваров.Номенклатура      КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика    КАК Характеристика,
	|	ШтрихкодыУпаковокТоваров.Упаковка          КАК Упаковка,
	|	ШтрихкодыУпаковокТоваров.Серия             КАК Серия,
	|	ЕСТЬNULL(АкцизныеМаркиЕГАИС.Статус,               ЗНАЧЕНИЕ(Перечисление.СтатусыАкцизныхМарок.ПустаяСсылка))                 КАК Статус,
	|	ЕСТЬNULL(АкцизныеМаркиЕГАИС.Справка2,             ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))                          КАК Справка2,
	|	ЕСТЬNULL(АкцизныеМаркиЕГАИС.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК АлкогольнаяПродукция,
	|	ВЫБОР
	|		КОГДА НЕ АкцизныеМаркиЕГАИС.АлкогольнаяПродукция ЕСТЬ NULL
	|			ТОГДА АкцизныеМаркиЕГАИС.АлкогольнаяПродукция.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодАлкогольнойПродукции
	|ИЗ
	|	ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МаксимальныеДатыУпаковки КАК МаксимальныеДатыУпаковки
	|		ПО МаксимальныеДатыУпаковки.ЗначениеШтрихкода = ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода
	|			И МаксимальныеДатыУпаковки.ДатаУпаковки = ШтрихкодыУпаковокТоваров.ДатаУпаковки
	|			
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	|		ПО АкцизныеМаркиЕГАИС.АкцизнаяМарка = ШтрихкодыУпаковокТоваров.Ссылка
	|			И АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС
	|";
	
	Если ОрганизацияЕГАИС = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС", "");
	КонецЕсли;
	Если ТипыУпаковок <> Неопределено Тогда
		
		Если ТипЗнч(ТипыУпаковок) = Тип("Массив") Тогда
			СписокТиповУпаковок = ТипыУпаковок;
		Иначе
			СписокТиповУпаковок = Новый Массив;
			СписокТиповУпаковок.Добавить(ТипыУпаковок);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("СписокТиповУпаковок", СписокТиповУпаковок);
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&УсловиеПоТипамУпаковок",
			"ШтрихкодыУпаковокТоваров.ТипУпаковки В(&СписокТиповУпаковок)");
		
	КонецЕсли;
	
	ТаблицаШтрихкодовУпаковок = Запрос.Выполнить().Выгрузить();
	
	КодыАлкогольнойПродукции = Новый Массив;
	Для Каждого СтрокаТЧ Из ТаблицаШтрихкодовУпаковок Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.АлкогольнаяПродукция)
			И ЗначениеЗаполнено(СтрокаТЧ.КодАлкогольнойПродукции) Тогда
			
			КодыАлкогольнойПродукции.Добавить(СтрокаТЧ.КодАлкогольнойПродукции);
			
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТЧ.АлкогольнаяПродукция)
			И Не ЗначениеЗаполнено(СтрокаТЧ.КодАлкогольнойПродукции)
			И ШтрихкодированиеОбщегоНазначенияЕГАИС.ЭтоШтрихкодАкцизнойМарки(СтрокаТЧ.ЗначениеШтрихкода) Тогда
			
			СтрокаТЧ.КодАлкогольнойПродукции = АкцизныеМаркиВызовСервера.КодКлассификатораНоменклатурыЕГАИС(СтрокаТЧ.ЗначениеШтрихкода);
			КодыАлкогольнойПродукции.Добавить(СтрокаТЧ.КодАлкогольнойПродукции);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СоответствиеАлкогольнойПродукции = ИнтеграцияЕГАИС.СоответствиеАлкогольнойПродукции(КодыАлкогольнойПродукции);
	
	Для Каждого СтрокаТЧ Из ТаблицаШтрихкодовУпаковок Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.АлкогольнаяПродукция)
			И ЗначениеЗаполнено(СтрокаТЧ.КодАлкогольнойПродукции) Тогда
			
			АлкогольнаяПродукция = СоответствиеАлкогольнойПродукции[СтрокаТЧ.КодАлкогольнойПродукции];
			Если ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
				СтрокаТЧ.АлкогольнаяПродукция = АлкогольнаяПродукция;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из ТаблицаШтрихкодовУпаковок Цикл
		
		ДанныеШтрихкодаУпаковки = Новый Структура;
		ДанныеШтрихкодаУпаковки.Вставить("Ссылка"                 , СтрокаТЧ.Ссылка);
		ДанныеШтрихкодаУпаковки.Вставить("ТипУпаковки"            , СтрокаТЧ.ТипУпаковки);
		ДанныеШтрихкодаУпаковки.Вставить("ТипШтрихкода"           , СтрокаТЧ.ТипШтрихкода);
		ДанныеШтрихкодаУпаковки.Вставить("Номенклатура"           , СтрокаТЧ.Номенклатура);
		
		// Добавим тарную единицу измерения и коэффициент.
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			ТарнаяЕд = СтрокаТЧ.Номенклатура.питТарнаяЕдиницаИзмерения;
			ДанныеШтрихкодаУпаковки.Вставить("ТарнаяЕдиницаИзмерения"      , ТарнаяЕд);
			Если НЕ ЗначениеЗаполнено(ТарнаяЕд) Тогда
				ДанныеШтрихкодаУпаковки.Вставить("КоэффициентТарной"           , 1);
			Иначе
				Если НЕ ТарнаяЕд.Пустая() Тогда
					ДанныеШтрихкодаУпаковки.Вставить("КоэффициентТарной"           , ТарнаяЕд.Коэффициент);
				Иначе
					ДанныеШтрихкодаУпаковки.Вставить("КоэффициентТарной"           , 1);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ДанныеШтрихкодаУпаковки.Вставить("ТарнаяЕдиницаИзмерения"      , Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
			ДанныеШтрихкодаУпаковки.Вставить("КоэффициентТарной"           , 1);
		КонецЕсли;
		
		ДанныеШтрихкодаУпаковки.Вставить("Характеристика"         , СтрокаТЧ.Характеристика);
		ДанныеШтрихкодаУпаковки.Вставить("Серия"                  , СтрокаТЧ.Серия);
		ДанныеШтрихкодаУпаковки.Вставить("Статус"                 , СтрокаТЧ.Статус);
		ДанныеШтрихкодаУпаковки.Вставить("Справка2"               , СтрокаТЧ.Справка2);
		ДанныеШтрихкодаУпаковки.Вставить("АлкогольнаяПродукция"   , СтрокаТЧ.АлкогольнаяПродукция);
		ДанныеШтрихкодаУпаковки.Вставить("КодАлкогольнойПродукции", СтрокаТЧ.КодАлкогольнойПродукции);
		
		Если Результат[СтрокаТЧ.ЗначениеШтрихкода] <> Неопределено Тогда
			Результат[СтрокаТЧ.ЗначениеШтрихкода].Добавить(ДанныеШтрихкодаУпаковки);
		Иначе
			МассивУпаковок = Новый Массив;
			МассивУпаковок.Добавить(ДанныеШтрихкодаУпаковки);
			Результат.Вставить(СтрокаТЧ.ЗначениеШтрихкода, МассивУпаковок);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОбработкаШтрихКодов

// Функция - Получить алкономенклатуру по алкокоду.
//
// Параметры:
//  Алкокод - Произвольный - Алкокод.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьАлкономенклатуруПоАлкокоду(Алкокод) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	               |ГДЕ
	               |	КлассификаторАлкогольнойПродукцииЕГАИС.Код = &Код
	               |	И НЕ КлассификаторАлкогольнойПродукцииЕГАИС.ПометкаУдаления";
				   
	Запрос.УстановитьПараметр("Код", Алкокод);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

// Функция - Получить данные по штрихкодам маркированного.
//
// Параметры:
//  СписокШтрихкодов - СписокЗначений - Список штрихкодов.
//  ПараметрыСканированияАкцизныхМарок - Произвольный - Параметры сканирования акцизных марок.
//  АкцизныеМаркиВДокументе - Произвольный - Акцизные марки в документе.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьДанныеПоШтрихкодамМаркированного(СписокШтрихкодов, ПараметрыСканированияАкцизныхМарок, АкцизныеМаркиВДокументе) Экспорт
	
	МассивСтруктур = Новый Массив;
	
	Если ТипЗнч(СписокШтрихкодов) = Тип("Массив") Тогда
		Для каждого ЭлМас из СписокШтрихкодов Цикл
			МассивСтруктур.Добавить(Новый Структура("Штрихкод, Количество", ЭлМас, 1));	
		КонецЦикла;
	КонецЕсли;
	
	РезультатТиповой = ШтрихкодированиеОбщегоНазначенияИС.ДанныеПоШтрихкодам(МассивСтруктур, ПараметрыСканированияАкцизныхМарок, АкцизныеМаркиВДокументе);
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатТиповой.ДанныеКодовМаркировки);
	
КонецФункции

#КонецОбласти

#Область ФормированиеИОбработкаКнопокАктаСписания

// Процедура - Заполнить по продажам на сервере.
//
// Параметры:
//  ТолькоПоНовым - Произвольный - Только по новым.
//  Объект - Произвольный - Объект.
//  ПараметрыСканированияАкцизныхМарок - Произвольный - Параметры сканирования акцизных марок.
//
Процедура ЗаполнитьПоПродажамНаСервере(ТолькоПоНовым = Ложь, Объект, ПараметрыСканированияАкцизныхМарок) Экспорт
	
	НачалоПериода = ?(ЗначениеЗаполнено(Объект.Дата), НачалоДня(Объект.Дата), НачалоДня(ТекущаяДата()));//(Параметры.Ключ.Пустая(), НачалоДня(ТекущаяДата()), НачалоДня(Объект.Дата));
	КонецПериода = КонецДня(НачалоПериода);
	ОрганизацияЕГАИСИзКлассификатора = Объект.ОрганизацияЕГАИС;
	Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	
	// ???
	ВедетсяУчетПоСкладам = Истина;//ПолучитьФункциональнуюОпцию("УчетПоНесколькимСкладам");//БухгалтерскийУчет.ВедетсяУчетПоСкладам(ПланыСчетов.Хозрасчетный.Товары);
	ВедетсяУчетПоПодр = Истина;//БухгалтерскийУчетПереопределяемый.ВестиУчетПоПодразделениям();
	
	
	Склад = Справочники.Склады.ПустаяСсылка();
	Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлассификаторОрганизацийЕГАИС.Контрагент КАК Организация,
	               |	КлассификаторОрганизацийЕГАИС.ТорговыйОбъект КАК Склад
	               |ИЗ
	               |	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	               |ГДЕ
	               |	КлассификаторОрганизацийЕГАИС.Ссылка = &Ссылка
	               |	И КлассификаторОрганизацийЕГАИС.Сопоставлено";
	Запрос.УстановитьПараметр("Ссылка", Объект.ОрганизацияЕГАИС);
	Рез = запрос.Выполнить();
	Если НЕ Рез.Пустой() Тогда
		Выборка = Рез.Выбрать();
		Выборка.Следующий();
		Орг = Выборка.Организация;
		Склад = Выборка.Склад;	
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Организация ЕГАИС не сопоставлена ни с одной организацией в учетной базе!";
		Сообщение.Сообщить();
		// Возврат;
	КонецЕсли;

	Это1Рег = Объект.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.АктСписанияИзРегистра1;
	СтруктураВозвр = питЕГАИСОбщегоНазначения.ПолучитьРозничныеПродажиАлкогольнойПродукцииДляЖурнала(НачалоПериода, КонецПериода, Орг, Склад, Подразделение, Это1Рег, ТолькоПоНовым);
	ТЗРез = СтруктураВозвр.ТЗПродаж;
		
	АкцизныеМаркиСКоличеством = СтруктураВозвр.АкцизныеМаркиСКоличеством;
	
	Объект.Товары.Загрузить(ТЗРез);
	
	// Если списание с 1 регистра, то нам нужен только маркируемый алкоголь с марками нового формата
	Если ТолькоПоНовым Тогда
		
		Объект.Товары.Очистить();	
		
		// и убираем из акцизных марок строки со старыми
		Если СтруктураВозвр.АкцизныеМарки.Количество() > 0 Тогда
			ТаблицаКопия = СтруктураВозвр.АкцизныеМарки.Скопировать();
			СтруктураВозвр.АкцизныеМарки.Очистить();
			Для каждого СтрокаКопии Из ТаблицаКопия Цикл
				Если СтрДлина(СтрокаКопии.КодАкциза) = 150 Тогда
					НоваяСтрМ = СтруктураВозвр.АкцизныеМарки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрМ, СтрокаКопии);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	
	// проставим единицы измерения - перенести в обработку
	Для каждого СтрокаТаб из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТаб.Номенклатура) Тогда
			СтрокаТаб.Упаковка = СтрокаТаб.Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
	КонецЦикла;
	
	// ПараметрыСканированияАкцизныхМарок = АкцизныеМаркиКлиентСервер.ПараметрыСканированияАкцизныхМарок(ЭтотОбъект);
	// ПараметрыСканированияАкцизныхМарок = питЕГАИСОбщегоНазначения.ПараметрыСканированияАкцизныхМарок(ЭтотОбъект);
	ПараметрыСканированияАкцизныхМарок.СоздаватьШтрихкодУпаковки = Истина;
	ПараметрыСканированияАкцизныхМарок.ЗапретитьАкцизныеМаркиDataMatrixБезСтатуса = Ложь;

	Объект.АкцизныеМарки.Очистить();
	Для каждого СтрокаМарок Из СтруктураВозвр.АкцизныеМарки Цикл
		
		// заполним новый реквизит "Акцизная марка" в ТЧ
		СписокШК = Новый Массив;
		СписокШк.Добавить(СтрокаМарок.КодАкциза);
		НайдСтрокаСНоменклатураПоАП = АкцизныеМаркиСКоличеством.Найти(СтрокаМарок.АлкогольнаяПродукция, "АлкогольнаяПродукция");
		Если НЕ НайдСтрокаСНоменклатураПоАП = Неопределено Тогда
			ПараметрыСканированияАкцизныхМарок.Номенклатура = НайдСтрокаСНоменклатураПоАП.Номенклатура;
		КонецЕсли;
		Рез = питЕГАИСОбщегоНазначения.ПолучитьДанныеПоШтрихкодамМаркированного(СписокШк,ПараметрыСканированияАкцизныхМарок, Неопределено); 
		
		Справка2 = Справочники.Справки2ЕГАИС.ПустаяСсылка();
		ШтрихкодУпаковки = Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		
		НовыйШтрихКод = ""; //строковое значение
		ДанныеПоМарке = Новый Структура;
		АлкономенклатураИзКлассификатора = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка();
		ТекАлкокод = "";
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		Справка2 = Справочники.Справки2ЕГАИС.ПустаяСсылка();
		ШтрихкодУпаковки = Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		
		Для каждого СтрокаСоотв Из Рез Цикл
			// 1 раз проходим цикл 
			НовыйШтрихКод = СтрокаСоотв.Ключ; //строковое значение
			ДанныеПоМарке = СтрокаСоотв.Значение;
			АлкономенклатураИзКлассификатора = ДанныеПоМарке.АлкогольнаяПродукция;
			ТекАлкокод = ДанныеПоМарке.КодАлкогольнойПродукции;
			Номенклатура = ДанныеПоМарке.Номенклатура;
			Справка2 = ДанныеПоМарке.Справка2;
			ШтрихкодУпаковки = ДанныеПоМарке.ШтрихкодУпаковки;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(АлкономенклатураИзКлассификатора) И НЕ ЗначениеЗаполнено(СтрокаМарок.АлкогольнаяПродукция) Тогда
			СтрокаМарок.АлкогольнаяПродукция = АлкономенклатураИзКлассификатора;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(АлкономенклатураИзКлассификатора) Тогда
			АлкономенклатураИзКлассификатора = СтрокаМарок.АлкогольнаяПродукция;	
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаМарок.АлкогольнаяПродукция) ИЛИ НЕ ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
			// пробуем сперва найти в РС Акцизные марки
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	АкцизныеМаркиЕГАИС.АлкогольнаяПродукция КАК АП,
			               |	АкцизныеМаркиЕГАИС.АкцизнаяМарка КАК АкцизнаяМарка
			               |ИЗ
			               |	РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
			               |ГДЕ
			               |	АкцизныеМаркиЕГАИС.АкцизнаяМарка.ЗначениеШтрихкода = &ЗначениеШтрихкода";
			Запрос.УстановитьПараметр("ЗначениеШтрихкода", СтрокаМарок.КодАкциза);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				АлкономенклатураИзКлассификатора = Выборка.АП;
				СтрокаМарок.АлкогольнаяПродукция = Выборка.АП;
				ШтрихкодУпаковки = Выборка.АкцизнаяМарка;
				Если НЕ ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
					ШтрихкодУпаковки = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода" ,СтрокаМарок.КодАкциза); 
				КонецЕсли;
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаМарок.АлкогольнаяПродукция) Тогда
					РассчитанныйАлккокод = питЕГАИСОбщегоНазначения.ВыделитьАлкокодИзПДФ417(СтрокаМарок.КодАкциза);
					Если НЕ (РассчитанныйАлккокод = Неопределено) Тогда
						АлкономенклатураИзКлассификатора = питЕГАИСОбщегоНазначения.ПолучитьАлкономенклатуруПоАлкокоду(РассчитанныйАлккокод);
						Если НЕ (АлкономенклатураИзКлассификатора = Неопределено) Тогда
							СтрокаМарок.АлкогольнаяПродукция = АлкономенклатураИзКлассификатора;
						Иначе
							АлкономенклатураИзКлассификатора = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка();
							СтрокаМарок.АлкогольнаяПродукция = АлкономенклатураИзКлассификатора;
						КонецЕсли;
					Иначе
						АлкономенклатураИзКлассификатора = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка();
						СтрокаМарок.АлкогольнаяПродукция = АлкономенклатураИзКлассификатора;
					КонецЕсли; 
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		
		// Если АлкономенклатураИзКлассификатора = Неопределено Тогда
		// 	Продолжить;
		// КонецЕсли;
		
		СтрокиТЧ = Объект.Товары.НайтиСтроки(НОвый Структура("АлкогольнаяПродукция",СтрокаМарок.АлкогольнаяПродукция));
		Если СтрокиТЧ.Количество() > 0 Тогда
			СтрокаТЧ = СтрокиТЧ[0];
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторСтроки) Тогда
				СтрокаТЧ.ИдентификаторСтроки = Новый УникальныйИдентификатор;	
			КонецЕсли;
		Иначе
			СтрокаТЧ = Объект.Товары.Добавить();
			СтрокаТЧ.АлкогольнаяПродукция = СтрокаМарок.АлкогольнаяПродукция;
			СтрокаТЧ.ИдентификаторСтроки = Новый УникальныйИдентификатор;	
		КонецЕсли;
		
		ОбщиеСтрокиТЧАлкогольнойПродукции = АкцизныеМаркиСКоличеством.НайтиСтроки(Новый Структура("АлкогольнаяПродукция",СтрокаМарок.АлкогольнаяПродукция));
		Если ОбщиеСтрокиТЧАлкогольнойПродукции.Количество() > 0 Тогда
			СтрокаТЧ.Количество =  ОбщиеСтрокиТЧАлкогольнойПродукции[0].Количество;
		КонецЕсли;
		
		// СтрокаТЧ.МаркируемаяАлкогольнаяПродукция = Истина;
		
		СтрокаТЧ.КоличествоУпаковок = СтрокаТЧ.Количество;
		СтрокаТЧ.Справка2 = Справка2;
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			СтрокаТЧ.Номенклатура = Номенклатура;
		КонецЕсли;
		
		// СтрокаТЧ.ИндексАкцизнойМарки = 1;  //делаем зеленой строку
				
		НоваяСтрокаМарок = Объект.АкцизныеМарки.Добавить();
		НоваяСтрокаМарок.КодАкцизнойМарки = СтрокаМарок.КодАкциза;
		НоваяСтрокаМарок.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
		НоваяСтрокаМарок.Количество = 1;
		НоваяСтрокаМарок.АкцизнаяМарка = ШтрихкодУпаковки;
		НоваяСтрокаМарок.Справка2 = СтрокаТЧ.Справка2;
		
//   СтрокаТЧ.КоличествоАкцизныхМарок = Объект.АкцизныеМарки.НайтиСтроки(НОвый
// Структура("ИдентификаторСтроки",НоваяСтрокаМарок.ИдентификаторСтроки)).Количество();.
		////КонецЕсли;
	КонецЦикла;
	
	Для каждого СтрокаТЧ ИЗ Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторСтроки) Тогда
			СтрокаТЧ.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;	
	
	Для каждого СтрокаТЧ ИЗ Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.КоличествоУпаковок) Тогда
			СтрокаТЧ.КоличествоУпаковок = СтрокаТЧ.Количество;
		КонецЕсли;
	КонецЦикла;
	МассивОшибок = СтруктураВозвр.МассивОшибок;
	Для Каждого ОтдОшибка Из МассивОшибок Цикл
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "тдОшибк";
		Сообщение.Сообщить();
	КонецЦикла;
	
	// ОбновитьСлужебныеРеквизитыТЧ();
		
КонецПроцедуры

// Процедура - Заполнить по продажам за день.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  ТолькоПоНовым - Произвольный - Только по новым.
//  ПараметрыСканированияАкцизныхМарок - Произвольный - Параметры сканирования акцизных марок.
//
Процедура ЗаполнитьПоПродажамЗаДень(Объект, ТолькоПоНовым = Ложь, ПараметрыСканированияАкцизныхМарок) Экспорт
	
	ДанныеОбъекта = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.АктСписанияЕГАИС"));
	
	ЗаполнитьПоПродажамНаСервере(ТолькоПоНовым, ДанныеОбъекта, ПараметрыСканированияАкцизныхМарок);	
	
	ЗначениеВДанныеФормы(ДанныеОбъекта, Объект);
	
КонецПроцедуры

// Процедура - Заполнить производством за день.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  ТолькоПоНовым - Произвольный - Только по новым.
//  ПараметрыСканированияАкцизныхМарок - Произвольный - Параметры сканирования акцизных марок.
//  СпособЗаполнения - Число - Способ заполнения.
//
Процедура ЗаполнитьПроизводствомЗаДень(Объект, ТолькоПоНовым = Ложь, ПараметрыСканированияАкцизныхМарок, СпособЗаполнения) Экспорт
	// Объект = Форма.Объект;
	
	ВходныеПараметры = питЕГАИСОбщегоНазначения.ПараметрыПолученияСписанныхМарокПриПроизводстве(Объект.ОрганизацияЕГАИС, Объект.Дата, СпособЗаполнения);
	ТаблицаМарок = питЕГАИСОбщегоНазначения.ПолучитьСписанныеНаПроизводствоМарки(ВходныеПараметры);
	
	// Объект.Магазин = ВходныеПараметры.СтруктурнаяЕдиница;
	// Объект.Организация = ВходныеПараметры.Организация;
	
	Объект.Товары.Очистить();
	Объект.АкцизныеМарки.Очистить();
	
	//Для Каждого ТекСтрокаМарки Из ТаблицаМарок Цикл
	//	
	//	ТекСтрокаТовары = Объект.Товары.Добавить();
	//	ЗаполнитьЗначенияСвойств(ТекСтрокаТовары, ТекСтрокаМарки);
	//	
	//	ТекСтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	//	
	//	ТекСтрокаТовары.КоличествоУпаковок = ТекСтрокаТовары.Количество;
	//	ТекСтрокаТовары.КоличествоПродукцииПоАкцизнымМаркам = ТекСтрокаТовары.Количество;
	//	ТекСтрокаТовары.КоличествоЕГАИС = ТекСтрокаТовары.Количество;
	//	// ТекСтрокаТовары.питКоличествоВМЛ = ТекСтрокаМарки.КоличествоВМЛ;
	//	
	//	НоваяСтрокаАМ = Объект.АкцизныеМарки.Добавить();
	//	ЗаполнитьЗначенияСвойств(НоваяСтрокаАМ, ТекСтрокаМарки);
	//	НоваяСтрокаАМ.ШтрихкодУпаковки = ТекСтрокаМарки.ШтрихкодУпаковки;
	//	НоваяСтрокаАМ.АкцизнаяМарка = ТекСтрокаМарки.ШтрихкодУпаковки;
	//	НоваяСтрокаАМ.ЧастичноеВыбытиеКоличество = ТекСтрокаМарки.КоличествоВМЛ;
	//	НоваяСтрокаАМ.ЧастичноеВыбытиеВариантУчета = Перечисления.ВариантыУчетаЧастичногоВыбытияИС.ТекущаяНоменклатура;
	//	НоваяСтрокаАМ.ЧастичноеВыбытиеНоменклатура = ТекСтрокаМарки.Номенклатура;
	//	// НоваяСтрокаАМ.ЧастичноеВыбытиеХарактеристика = ТекСтрокаМарки.Характеристика;
	//	НоваяСтрокаАМ.ИдентификаторСтроки = Неопределено;
	//	НоваяСтрокаАМ.Количество = 1;
	//	
	//КонецЦикла;             
	
	// из УПО
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	
	СтруктураПоискаТоваров = Новый Структура("Справка2, Номенклатура, АлкогольнаяПродукция, ИдентификаторСтроки");
	СтруктураПоискаМарок = Новый Структура("Справка2, ИдентификаторСтроки, АкцизнаяМарка,
	|ЧастичноеВыбытиеНоменклатура, ЧастичноеВыбытиеХарактеристика");
	Для Каждого ТекСтрокаМарки Из ТаблицаМарок Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаТоваров, ТекСтрокаМарки);
		ИдентификаторСтроки = "";
		Если НЕ ЗначениеЗаполнено(ТекСтрокаМарки.Справка2) Тогда
			ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		СтруктураПоискаТоваров.ИдентификаторСтроки = ИдентификаторСтроки;

		МассивСтрокТоваров = Объект.Товары.НайтиСтроки(СтруктураПоискаТоваров);
		Если ЗначениеЗаполнено(МассивСтрокТоваров) Тогда
			ТекСтрокаТовары = МассивСтрокТоваров[0];
			ТекСтрокаТовары.Количество = ТекСтрокаТовары.Количество + ТекСтрокаМарки.Количество;
		Иначе
			ТекСтрокаТовары = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ТекСтрокаТовары, ТекСтрокаМарки);
			ТекСтрокаТовары.ИдентификаторСтроки = ИдентификаторСтроки;
		КонецЕсли;
		
		//ТекСтрокаТовары.питКоличествоВМЛ = ТекСтрокаТовары.питКоличествоВМЛ + ТекСтрокаМарки.КоличествоВМЛ;
		
		ИнтеграцияИСПереопределяемый.ОбработатьСтрокуТабличнойЧасти(ТекСтрокаТовары, СтруктураДействий, Объект);
		
		ТекСтрокаТовары.КоличествоУпаковок = ТекСтрокаТовары.Количество;
		
		СтруктураПоискаМарок.Справка2 = ТекСтрокаТовары.Справка2;
		СтруктураПоискаМарок.ИдентификаторСтроки = ТекСтрокаТовары.ИдентификаторСтроки;
		СтруктураПоискаМарок.АкцизнаяМарка = ТекСтрокаМарки.ШтрихкодУпаковки;
		СтруктураПоискаМарок.ЧастичноеВыбытиеНоменклатура = ТекСтрокаТовары.Номенклатура;
		//СтруктураПоискаМарок.ЧастичноеВыбытиеХарактеристика = ТекСтрокаТовары.Характеристика;
		
		МассивСтрокМарок = Объект.АкцизныеМарки.НайтиСтроки(СтруктураПоискаМарок);
		Если ЗначениеЗаполнено(МассивСтрокМарок) Тогда
			НоваяСтрокаМарки = МассивСтрокМарок[0];
		Иначе
			НоваяСтрокаМарки = Объект.АкцизныеМарки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаМарки, ТекСтрокаМарки,,"Количество");
			ЗаполнитьЗначенияСвойств(НоваяСтрокаМарки, СтруктураПоискаМарок);
			НоваяСтрокаМарки.ЧастичноеВыбытиеВариантУчета = Перечисления.ВариантыУчетаЧастичногоВыбытияИС.ТекущаяНоменклатура;
		КонецЕсли;
		
		НоваяСтрокаМарки.ЧастичноеВыбытиеКоличество = НоваяСтрокаМарки.ЧастичноеВыбытиеКоличество + ТекСтрокаМарки.Количество;
		//НоваяСтрокаМарки.Количество = питОбщегоНазначенияКлиентСервер.ОкруглитьДоЦелого(НоваяСтрокаМарки.ЧастичноеВыбытиеКоличество); 
		НоваяСтрокаМарки.Количество = НоваяСтрокаМарки.ЧастичноеВыбытиеКоличество;
		
	КонецЦикла;
	
	// АкцизныеМаркиЕГАИС.ЗаполнитьСлужебныеРеквизиты(Форма);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполненияНаОсновании

// Процедура - Заполнить отчет о производстве на основании.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  ЭтотОбъект - Произвольный - Этот объект.
//
Процедура ЗаполнитьОтчетОПроизводствеНаОсновании(ДанныеЗаполнения, ЭтотОбъект) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питВыпускБлюд") Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		ЭтотОбъект.Ответственный = ДанныеЗаполнения.Ответственный;
		
		ЭтотОбъект.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.питОтчетОПроизводствеПродукции;
		ЭтотОбъект.СтатусПроверкиИПодбора = Перечисления.СтатусыПроверкиИПодбораИС.НеВыполнялось;
		ЭтотОбъект.ДанныеПроверкиИПодбора = Неопределено;
		ЭтотОбъект.ИдентификаторЕГАИС = "";
		ЭтотОбъект.Номер = "";
		ЭтотОбъект.Дата = ТекущаяДата();
		ЭтотОбъект.ДатаПроизводства = ДанныеЗаполнения.Дата;
		ЭтотОбъект.ДокументОснование = ДанныеЗаполнения;
		
		// Заполним организацию по соответствию ИНН и КПП
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИНН", ДанныеЗаполнения.Организация.ИНН);
		Запрос.УстановитьПараметр("КПП", ДанныеЗаполнения.Организация.КПП);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлассификаторОрганизацийЕГАИС.Ссылка
		|ИЗ
		|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
		|ГДЕ
		|	КлассификаторОрганизацийЕГАИС.ИНН = &ИНН
		|	И КлассификаторОрганизацийЕГАИС.КПП = &КПП";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЭтотОбъект.ОрганизацияЕГАИС = Выборка.Ссылка;
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"И КлассификаторОрганизацийЕГАИС.КПП = &КПП", "");
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ЭтотОбъект.ОрганизацияЕГАИС = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		ЭтотОбъект.Производитель = ЭтотОбъект.ОрганизацияЕГАИС;
		
		Если ДанныеЗаполнения.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ВыпускПродукции Тогда
			ЭтотОбъект.ТипПроизводства = Перечисления.питТипПроизводстваЕГАИС.ПроизводствоСырьяДляСобственногоИспользования;
		Иначе
			ЭтотОбъект.ТипПроизводства = Перечисления.питТипПроизводстваЕГАИС.Производство;
		КонецЕсли;
		
		// Заполняем производство
		ТЗПроизводства_документа = ПолучитьТаблицуВыпускаемойПродукции_ВыпускаПродукции(ДанныеЗаполнения.Ссылка);
		ТЗВНомЕГАИС = ПолучитьТаблицуНоменклатурыВНоменклатуреЕГАИС(ТЗПроизводства_документа);
		ТЗВНомЕГАИС.Колонки.Добавить("НомерПартии", Новый ОписаниеТипов("Строка"));
		ТЗВНомЕГАИС.ЗаполнитьЗначения(ДанныеЗаполнения.Номер, "НомерПартии");
		
		ЭтотОбъект.Производство.Загрузить(ТЗВНомЕГАИС);
		
		// Заполняем сырье
		ТЗСырья_документа = ПолучитьТаблицуСырья_ВыпускаПродукции(ДанныеЗаполнения.Ссылка);
		ТЗВНомЕГАИС = ПолучитьТаблицуНоменклатурыВНоменклатуреЕГАИС(ТЗСырья_документа);
		
		СтрокаОкругленныхАП = "";
		Для каждого СтрокаСАП Из ТЗВНомЕГАИС Цикл
			ИсхКол = СтрокаСАП.Количество;
			Если СтрокаСАП.Количество <> Окр(СтрокаСАП.Количество) Тогда
				
				Если НЕ СтрокаОкругленныхАП = "" Тогда
					СтрокаОкругленныхАП = СтрокаОкругленныхАП + ",";	
				КонецЕсли;
				СтрокаОкругленныхАП = СтрокаОкругленныхАП + Строка(СтрокаСАП.АлкогольнаяПродукция);
				СтрокаСАП.Количество = Окр(СтрокаСАП.Количество + 0.499);
			КонецЕсли;
		КонецЦикла;
		
		ЭтотОбъект.Сырье.Загрузить(ТЗВНомЕГАИС);
		Если НЕ СтрокаОкругленныхАП = "" Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("СтрокаОкругленныхАП", СтрокаОкругленныхАП);
		КонецЕсли;
		// Сообщение = Новый СообщениеПользователю();
		// Сообщение.Текст = "Позиции АП округлены до целых: " + СтрокаОкругленныхАП + ".";
		// Сообщение.Сообщить();
		// Для Каждого Стр из ДанныеЗаполнения.Товары Цикл
		// 	НоваяСтрока = ЭтотОбъект.Товары.Добавить();
		// 	ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		// КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область АктСписанияЕГАИС

// Процедура дополняет причины списания требующие указания марки
//  из "Документы.АктСписанияЕГАИС.ПричиныСписанияТребующиеУказанияМарки"
//
// Параметры:
//  ПричиныМассив - Массив - Массив причин, который требуется дополнить.
//
Процедура ПричиныСписанияТребующиеУказанияМарки(ПричиныМассив) Экспорт
	
	ПричиныМассив.Добавить(Перечисления.ПричиныСписанийЕГАИС.питПриготовление);
	
КонецПроцедуры

// Процедура меняет статус документа если это необходимо.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.АктСписанияЕГАИС - Ссылка на документ ЕГАИС.
//  ПараметрыОбновленияСтатуса - Структура - Функцию ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса().
//  СтрокаТЧ - СтрокаТаблицыЗначений - Строка таблицы товары документа.
//  ДанныеЗаписиСтатуса - Структура - Функции.
//
Процедура УстановитьСтатусДокумента(ДокументСсылка, ПараметрыОбновленияСтатуса, СтрокаТЧ, ДанныеЗаписиСтатуса) Экспорт
	
	Если НЕ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияЕГАИС") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОбновленияСтатуса.ДокументОбъект = Неопределено Тогда
		ПричинаСписания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПричинаСписания");
	Иначе
		ПричинаСписания = ПараметрыОбновленияСтатуса.ДокументОбъект.ПричинаСписания;
	КонецЕсли;
	РазрешитьЧастичноеСписание = ПричинаСписания = Перечисления.ПричиныСписанийЕГАИС.питПриготовление;
	
	Если РазрешитьЧастичноеСписание 
		И питИнтеграцияЕГАИС.ПолучитьОстатокПоМаркеИС(
			СтрокаТЧ.ОрганизацияЕГАИС, СтрокаТЧ.ШтрихкодУпаковки) > 0 Тогда
		ДанныеЗаписиСтатуса.Статус = Перечисления.СтатусыАкцизныхМарок.ВскрытаяБутылка;
	КонецЕсли;
	
КонецПроцедуры

// Документы АктСписанияЕГАИС АктСписанияЕГАИСXML
//
// Параметры:
//  Шапка - Произвольный - Шапка документа.
//  СтрокаТЧ - Произвольный - Строка ТЧ документа.
//  НоваяСтрока - СтрокаТаблицыЗначений - Строка "ТоварыИтоги", которую необходимо модифицировать.
