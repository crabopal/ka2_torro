	// ПересчитыватьВМЛ = Шапка.ПричинаСписания = Перечисления.ПричиныСписанийЕГАИС.питПриготовление;
	// НоваяСтрока.Количество = питОбщегоНазначения.ПеревестиОбъемВМиллилитры(
