	|	ДПФ_Исходные.СкладРеализацииЗала КАК СкладРеализацииЗала,
	|	ДПФ_Исходные.СкладРеализацииКассовогоУзла КАК СкладРеализацииКассовогоУзла,
	|	ДПФ_Исходные.Ссылка КАК Ссылка,
	|	ОбщепитДанныеПродажФронтаУчетАлкоголя.Номенклатура КАК Номенклатура,
	|	ОбщепитДанныеПродажФронтаУчетАлкоголя.Количество КАК Количество,
	|	1 КАК Коэффициент,
	|	ОбщепитДанныеПродажФронтаУчетАлкоголя.КодАкциза КАК КодАкциза,
	|	ДПФ_Исходные.СпособОпределенияСкладаРеализации КАК СпособОпределенияСкладаРеализации,
	|	ДПФ_Исходные.ПодразделениеОрганизации КАК ПодразделениеОрганизации
	|ПОМЕСТИТЬ ВТ_ДПФ_ДляАнализа
	|ИЗ
	|	ДПФ_Исходные КАК ДПФ_Исходные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питДанныеПродажФронта.УчетАлкоголя КАК ОбщепитДанныеПродажФронтаУчетАлкоголя
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ПО ОбщепитДанныеПродажФронтаУчетАлкоголя.Номенклатура = СпрНоменклатура.Ссылка
	|		ПО ДПФ_Исходные.Ссылка = ОбщепитДанныеПродажФронтаУчетАлкоголя.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|			ПО ОбщепитДанныеПродажФронтаУчетАлкоголя.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	(&ВидПродукцииИС_УсловиеОтбораЭтоАлкоголь
	|			ИЛИ &ВидПродукцииИС_УсловиеОтбораЭтоПиво
	|				И ОбщепитДанныеПродажФронтаУчетАлкоголя.ШтрихкодУпаковки = ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка))
	|	И (&УчитыватьКрепкийАлкоголь 
	|		ИЛИ ОбщепитДанныеПродажФронтаУчетАлкоголя.МестоПечати = ЗНАЧЕНИЕ(Справочник.питМестаПечати.ПустаяСсылка))";
	
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("ДатаКонца", 		КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("УчитыватьКрепкийАлкоголь", 		РежимЗаполнения = 0);
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		питИнтеграцияИСМПКлиентСервер.ВидыПродукцииАлкоголя(),,
		"&ВидПродукцииИС_УсловиеОтбораЭтоАлкоголь");
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПива(),,
		"&ВидПродукцииИС_УсловиеОтбораЭтоПиво");
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ОбщепитДанныеПродажФронтаАлкоголь.Номенклатура,
	|	ОбщепитДанныеПродажФронтаАлкоголь.Ссылка,
	|	ОбщепитДанныеПродажФронтаАлкоголь.Количество,
	|	ОбщепитДанныеПродажФронтаАлкоголь.Коэффициент,
	|	ОбщепитДанныеПродажФронтаАлкоголь.КодАкциза,
	|	ОбщепитДанныеПродажФронтаАлкоголь.Дата,
	|	ОбщепитДанныеПродажФронтаАлкоголь.СменаНачало,
	|	ОбщепитДанныеПродажФронтаАлкоголь.Организация,
	|	ОбщепитДанныеПродажФронтаАлкоголь.ПодразделениеОрганизации,
	|	ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала,
	|	ОбщепитДанныеПродажФронтаАлкоголь.СпособОпределенияСкладаРеализации,
	|	ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииКассовогоУзла
	|ИЗ
	|	ВТ_ДПФ_ДляАнализа КАК ОбщепитДанныеПродажФронтаАлкоголь
	|ГДЕ
	|	&Датачека
	// ОбщепитДанныеПродажФронтаАлкоголь.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	// |	И НЕ ОбщепитДанныеПродажФронтаАлкоголь.Ссылка.ПометкаУдаления 		
	|	И &УсловиеДПФ";
	// |	И НЕ ОбщепитДанныеПродажФронтаАлкоголь.Ссылка.ПометкаУдаления";
	
	Если питВЖурналеАлкоПродукцииИспользоватьТолькоАкты Тогда
		СтрокаУсловияДПФ = "ОбщепитДанныеПродажФронтаАлкоголь.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", Организация); 
		Если ЗначениеЗаполнено(Склад) И ВедетсяУчетПоСкладам Тогда
			Если ТипЗнч(Склад) = Тип("СправочникСсылка.Склады") Тогда
				СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И ВЫБОР КОГДА ОбщепитДанныеПродажФронтаАлкоголь.СпособОпределенияСкладаРеализации = 1 И ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА
														|		ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала
														|	ИНАЧЕ
														|		 ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииКассовогоУзла
														|	КОНЕЦ = &Склад";
			Иначе
				// Если передали склад списком складов
				СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И ВЫБОР КОГДА ОбщепитДанныеПродажФронтаАлкоголь.СпособОпределенияСкладаРеализации = 1 И ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА
														|		ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала
														|	ИНАЧЕ
														|		 ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииКассовогоУзла
														|	КОНЕЦ В (&Склад)";
			КонецЕсли;
			Запрос.УстановитьПараметр("Склад", Склад); 
		КонецЕсли;
		Если ЗначениеЗаполнено(Подразделение) Тогда
			СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И ОбщепитДанныеПродажФронтаАлкоголь.ПодразделениеОрганизации = &Подразделение";
			Запрос.УстановитьПараметр("Подразделение", Подразделение); 
		КонецЕсли;
	Иначе
		СтрокаУсловияДПФ = "ОбщепитДанныеПродажФронтаАлкоголь.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", Организация); 
		Если ЗначениеЗаполнено(Склад) И ВедетсяУчетПоСкладам Тогда
			Если ТипЗнч(Склад) = Тип("СправочникСсылка.Склады") Тогда
				СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И ВЫБОР КОГДА ОбщепитДанныеПродажФронтаАлкоголь.СпособОпределенияСкладаРеализации = 1 И ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА
														|		ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала
														|	ИНАЧЕ
														|		 ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииКассовогоУзла
														|	КОНЕЦ = &Склад";
			Иначе
				СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И ВЫБОР КОГДА ОбщепитДанныеПродажФронтаАлкоголь.СпособОпределенияСкладаРеализации = 1 И ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА
														|		ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала
														|	ИНАЧЕ
														|		 ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииКассовогоУзла
														|	КОНЕЦ В (&Склад)";
			КонецЕсли;
			Запрос.УстановитьПараметр("Склад", Склад); 
		КонецЕсли;
		СтрокаУсловияДПФ = СтрокаУсловияДПФ + " И (ВЫБОР КОГДА ОбщепитДанныеПродажФронтаАлкоголь.СпособОпределенияСкладаРеализации = 1 И ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА
												|		ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииЗала
												|	ИНАЧЕ
												|		 ОбщепитДанныеПродажФронтаАлкоголь.СкладРеализацииКассовогоУзла
												|	КОНЕЦ, ОбщепитДанныеПродажФронтаАлкоголь.Номенклатура) В
												|				(ВЫБРАТЬ
												|					АлкоПродукцияПодлежащаяАктуВскрытия.СкладКомпании,
												|					АлкоПродукцияПодлежащаяАктуВскрытия.Номенклатура
												|				ИЗ
												|					АлкоПродукцияПодлежащаяАктуВскрытия КАК АлкоПродукцияПодлежащаяАктуВскрытия)";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДПФ", СтрокаУсловияДПФ);	
	
	ДатаЧекаПоДатеСмены = Ложь;//Константы.ОбщепитЗаполнятьАктСписанияПоДатеЗакрытияСмены.Получить();
	Если ДатаЧекаПоДатеСмены Тогда
		СтрокаДатаЧека = "ВЫБОР КОГДА ОбщепитДанныеПродажФронтаАлкоголь.СменаНачало = ДАТАВРЕМЯ(1, 1, 1) ТОГДА ОбщепитДанныеПродажФронтаАлкоголь.Дата МЕЖДУ &ДатаНачала И &ДатаКонца ИНАЧЕ ОбщепитДанныеПродажФронтаАлкоголь.СменаНачало МЕЖДУ &ДатаНачала И &ДатаКонца КОНЕЦ ";
	Иначе
		СтрокаДатаЧека = "ОбщепитДанныеПродажФронтаАлкоголь.Дата МЕЖДУ &ДатаНачала И &ДатаКонца";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Датачека", СтрокаДатаЧека);

	
	ТЗРез = Запрос.Выполнить().Выгрузить();	
	ТЗРез.Колонки.Добавить("АлкогольнаяПродукция", Новый ОписаниеТипов("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));
	ТЗРез.ЗаполнитьЗначения(Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка(), "АлкогольнаяПродукция");
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БуфТЧ.Номенклатура КАК Номенклатура,
	               |	БуфТЧ.КодАкциза КАК КодАкциза
	               |ПОМЕСТИТЬ БуфТЧ
	               |ИЗ
	               |	&БуфТЧ КАК БуфТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ 
	               |	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПРодукцииегаис.пустаяссылка)) КАК АлкогольнаяПродукция
	               |ПОМЕСТИТЬ ВТ_Соотв
	               |ИЗ
	               |	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	               |ГДЕ
	               |	СоответствиеНоменклатурыЕГАИС.Номенклатура В
	               |			(ВЫБРАТЬ
	               |				БуфТЧ.Номенклатура КАК Номенклатура
	               |			ИЗ
	               |				БуфТЧ КАК БуфТЧ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ 
	               |	ЕСТЬNULL(АкцизныеМаркиЕГАИС.АлкогольнаяПродукция, ВТ_Соотв.АлкогольнаяПродукция) КАК АлкогольнаяПродукция,
	               |	ВЫБОР КОГДА АкцизныеМаркиЕГАИС.АлкогольнаяПродукция ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК АПЕстьВРегистреМарок,
	               |	БуфТЧ.КодАкциза КАК КодАкциза
	               |ИЗ
	               |	БуфТЧ КАК БуфТЧ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	               |		ПО БуфТЧ.КодАкциза = АкцизныеМаркиЕГАИС.АкцизнаяМарка.ЗначениеШтрихкода
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Соотв КАК ВТ_Соотв
	               |		ПО БуфТЧ.Номенклатура = ВТ_Соотв.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ БуфТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_Соотв";
	
	Запрос.УстановитьПараметр("БуфТЧ", ТЗРез);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НайдСтрока = ТЗРез.Найти(Выборка.КодАкциза, "КодАкциза");
		Если НайдСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Это1Рег Тогда
			НайдСтрока.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
			Если ТолькоНовыеМарки Тогда
				Если СтрДлина(Выборка.КодАкциза) < 150 Тогда
					ТЗРез.Удалить(НайдСтрока);	
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Марки по 150 символов для 2 регистра выводить не будем
			НайдСтрока.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
			Если СтрДлина(Выборка.КодАкциза) = 150 Тогда
				ТЗРез.Удалить(НайдСтрока);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Для каждой строки вычислим АП, если она есть в классификаторе по акцизу
	Для каждого СтрокаТЗ Из ТЗРез Цикл
		
		// В первую очередь будем искать по РС Акцизные марки ЕГАИС, и если не найдем, искать через соответствие
		Если ЗначениеЗаполнено(СтрокаТЗ.АлкогольнаяПродукция) Тогда
			Продолжить;
		КонецЕсли;
		
		РассчитанныйАлккокод = ВыделитьАлкокодИзПДФ417(СтрокаТЗ.КодАкциза);
		Если РассчитанныйАлккокод = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		АлкономенклатураИзКлассификатора = питЕГАИСОбщегоНазначения.ПолучитьАлкономенклатуруПоАлкокоду(РассчитанныйАлккокод);
		Если АлкономенклатураИзКлассификатора = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если не ЗначениеЗаполнено(СтрокаТЗ.Номенклатура) Тогда
			СтрокаТЗ.Номенклатура = питЕГАИСОбщегоНазначения.ПолучитьНоменклатуруПоАлкопродукцииИзСоответствия(АлкономенклатураИзКлассификатора); 	
		КонецЕсли;
		СтрокаТЗ.АлкогольнаяПродукция = АлкономенклатураИзКлассификатора;
		Если ЗначениеЗаполнено(СтрокаТЗ.КодАкциза) Тогда
			// Принимаем, что количество и коэффициент соответствует таре, коэффициент берем тарной
			СтрокаТЗ.Количество = 1;
			СтрокаТЗ.коэффициент = 1;
			// Если ЗначениеЗаполнено(СтрокаТЗ.Номенклатура) Тогда
			// 	ТарнаяЕд = СтрокаТЗ.Номенклатура.ОбщепитТарнаяЕдиницаИзмерения;
			// 	Если ЗначениеЗаполнено(ТарнаяЕд) Тогда
			// 		НайдСтрока = СтрокаТЗ.Номенклатура.ОбщепитЕдиницыИзмерения.Найти(ТарнаяЕд, "ЕдиницаПоКлассификатору");
			// 		Если НЕ НайдСтрока = Неопределено Тогда
			// 			СтрокаТЗ.коэффициент = НайдСтрока.Коэффициент;	
			// 		КонецЕсли;
			// 	КонецЕсли;
			// КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗапросДляВТ = Новый Запрос;
	ЗапросДляВТ.МенеджерВременныхТаблиц = МВТ;
	ЗапросДляВТ.УстановитьПараметр("ТЗВнеш",ТЗРез);
	ЗапросДляВТ.Текст = "ВЫБРАТЬ
	|	ТЗВнеш.Ссылка,
	|	ТЗВнеш.Номенклатура,
	|	ТЗВнеш.Количество,
	|	ТЗВнеш.Коэффициент,
	|	ТЗВнеш.АлкогольнаяПродукция,
	|	ТЗВнеш.КодАкциза
	|ПОМЕСТИТЬ ВТ_ДПФ
	|ИЗ
	|	&ТЗВнеш КАК ТЗВнеш";
	ЗапросДляВТ.Выполнить();
	
КонецПроцедуры

#КонецОбласти

