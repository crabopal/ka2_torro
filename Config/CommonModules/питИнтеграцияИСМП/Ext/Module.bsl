#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции


#Область КонтрольОстатковМарокИС

//  Процедура - Контроль остатков марок ис.
//
// Параметры:
//  ВходныеПараметры - Произвольный - Входные параметры.
//
Процедура КонтрольОстатковМарокИС(ВходныеПараметры = Неопределено) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.питКонтрольОстатковМарокИС);
	
	ПериодКонтроля = ТекущаяДатаСеанса();
	
	Если ВходныеПараметры = Неопределено Тогда
		ВходныеПараметры = Новый Структура;
	КонецЕсли;
	
	СписыватьПросроченные = Истина;
	Если ВходныеПараметры.Свойство("СписыватьПросроченныеПозиции") Тогда
		СписыватьПросроченные = ВходныеПараметры.СписыватьПросроченныеПозиции;
	КонецЕсли;
	
	ОтключатьПивныеКегиБезОстатков = Истина;
	Если ВходныеПараметры.Свойство("ОтключатьПивныеКегиБезОстатков") Тогда
		ОтключатьПивныеКегиБезОстатков = ВходныеПараметры.ОтключатьПивныеКегиБезОстатков;
	КонецЕсли;
	
	ОбновлятьСтатусыАкцизныхМарок = Истина;
	Если ВходныеПараметры.Свойство("ОбновлятьСтатусыАкцизныхМарок") Тогда
		ОбновлятьСтатусыАкцизныхМарок = ВходныеПараметры.ОбновлятьСтатусыАкцизныхМарок;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.Организация КАК Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати КАК МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод КАК Штрихкод,
	|	ОстаткиМарокИСОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиИсходные
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС.Остатки(&НачалоПериода, ) КАК ОстаткиМарокИСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиМарокИС.Организация,
	|	ОстаткиМарокИС.МестоПечати,
	|	ОстаткиМарокИС.Номенклатура,
	|	ОстаткиМарокИС.Штрихкод,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиМарокИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОстаткиМарокИС.Количество
	|			ИНАЧЕ -ОстаткиМарокИС.Количество
	|		КОНЕЦ)
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС КАК ОстаткиМарокИС
	|ГДЕ
	|	ОстаткиМарокИС.Период МЕЖДУ &НачалоПериода И &ПериодКонтроля
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМарокИС.Организация,
	|	ОстаткиМарокИС.МестоПечати,
	|	ОстаткиМарокИС.Номенклатура,
	|	ОстаткиМарокИС.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.Организация КАК Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати КАК МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод КАК Штрихкод,
	|	СУММА(ОстаткиМарокИСОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиСгруппированные
	|ИЗ
	|	ВТ_ОстаткиИсходные КАК ОстаткиМарокИСОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМарокИСОстатки.Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.Организация КАК Организация,
	|	ОстаткиМарокИСОстатки.МестоПечати КАК МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод КАК Штрихкод,
	|	ОстаткиМарокИСОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	&СписыватьПросроченные
	|		И ОстаткиМарокИСОстатки.КоличествоОстаток > 0
	|		И НЕ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питСрокРеализации, &ПустаяДата) = &ПустаяДата
	|		И &ВидПродукцииИС_УсловиеОтбораЭтоПиво
	|		И ШтрихкодыУпаковокТоваров.питСрокРеализации < &ПериодКонтроля КАК МаркаПросроченная,
	|	&ОтключатьПивныеКегиБезОстатков
	|		И ОстаткиМарокИСОстатки.КоличествоОстаток <= 0
	|		И ЕСТЬNULL(КегиНаОборудованииРозливаИСМП.Статус, &СтатусПодключен) = &СтатусПодключен КАК ОтключитьКегу
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	ВТ_ОстаткиСгруппированные КАК ОстаткиМарокИСОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ПО ОстаткиМарокИСОстатки.Штрихкод = ШтрихкодыУпаковокТоваров.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВскрытыеПотребительскиеУпаковкиИС КАК КегиНаОборудованииРозливаИСМП
	|		ПО ОстаткиМарокИСОстатки.Штрихкод = КегиНаОборудованииРозливаИСМП.КодМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ОстаткиМарокИСОстатки.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО ОстаткиМарокИСОстатки.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	(&СписыватьПросроченные
	|				И НЕ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питСрокРеализации, &ПустаяДата) = &ПустаяДата
	|				И ШтрихкодыУпаковокТоваров.питСрокРеализации < &ПериодКонтроля
	|				И &ВидПродукцииИС_УсловиеОтбораЭтоПиво
	|				И ОстаткиМарокИСОстатки.КоличествоОстаток > 0
	|			ИЛИ &ОбновлятьСтатусыАкцизныхМарок
	|			ИЛИ &ОтключатьПивныеКегиБезОстатков
	|				И ОстаткиМарокИСОстатки.КоличествоОстаток <= 0
	|				И ЕСТЬNULL(КегиНаОборудованииРозливаИСМП.Статус, &СтатусПодключен) = &СтатусПодключен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Организация КАК Организация,
	|	ВТ_Остатки.МестоПечати КАК МестоПечати,
	|	ВТ_Остатки.Номенклатура КАК Номенклатура,
	|	ВТ_Остатки.Штрихкод КАК ШтрихкодУпаковки,
	|	-ВТ_Остатки.КоличествоОстаток КАК Количество,
	|	МестаПечати.СкладПриготовления КАК СкладПриготовления
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питМестаПечати КАК МестаПечати
	|		ПО ВТ_Остатки.МестоПечати = МестаПечати.Ссылка
	|ГДЕ
	|	ВТ_Остатки.МаркаПросроченная
	|ИТОГИ ПО
	|	Организация,
	|	СкладПриготовления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Штрихкод КАК КодМаркировки
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|ГДЕ
	|	ВТ_Остатки.ОтключитьКегу
	|	И НЕ ВТ_Остатки.МаркаПросроченная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Штрихкод КАК Штрихкод,
	|	СУММА(ВТ_Остатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиПоМаркам
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Остатки.Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АкцизныеМаркиЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	АкцизныеМаркиЕГАИС.АкцизнаяМарка КАК АкцизнаяМарка,
	|	ВЫБОР
	|		КОГДА НЕ(АкцизныеМаркиЕГАИС.Статус = &СтатусВНаличии
	|					ИЛИ АкцизныеМаркиЕГАИС.Статус = &СтатусВскрытие)
	|			ТОГДА АкцизныеМаркиЕГАИС.Статус
	|		КОГДА ВТ_ОстаткиПоМаркам.КоличествоОстаток > 0
	|			ТОГДА &СтатусВскрытие
	|		ИНАЧЕ &СтатусСписано
	|	КОНЕЦ КАК Статус,
	|	АкцизныеМаркиЕГАИС.Справка2 КАК Справка2,
	|	АкцизныеМаркиЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	АкцизныеМаркиЕГАИС.Основание КАК Основание,
	|	АкцизныеМаркиЕГАИС.КоличествоЧастичногоВыбытия КАК КоличествоЧастичногоВыбытия
	|ИЗ
	|	ВТ_ОстаткиПоМаркам КАК ВТ_ОстаткиПоМаркам
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	|		ПО ВТ_ОстаткиПоМаркам.Штрихкод = АкцизныеМаркиЕГАИС.АкцизнаяМарка
	|ГДЕ
	|	(АкцизныеМаркиЕГАИС.Статус = &СтатусВНаличии
	|			ИЛИ АкцизныеМаркиЕГАИС.Статус = &СтатусВскрытие)
	|	И &ОбновлятьСтатусыАкцизныхМарок";
	Запрос.УстановитьПараметр("ПустаяДата", Дата('00010101'));
	Запрос.УстановитьПараметр("НачалоПериода", ПериодКонтроля - 7*86400);
	Запрос.УстановитьПараметр("ПериодКонтроля", ПериодКонтроля);
	Запрос.УстановитьПараметр("СтатусПодключен", Перечисления.СтатусыВскрытыхПотребительскихУпаковокИС.Подключено);
	Запрос.УстановитьПараметр("СписыватьПросроченные", СписыватьПросроченные);
	Запрос.УстановитьПараметр("ОтключатьПивныеКегиБезОстатков", ОтключатьПивныеКегиБезОстатков);
	Запрос.УстановитьПараметр("ОбновлятьСтатусыАкцизныхМарок", ОбновлятьСтатусыАкцизныхМарок);
	Запрос.УстановитьПараметр("СтатусВНаличии", Перечисления.СтатусыАкцизныхМарок.ВНаличии);
	Запрос.УстановитьПараметр("СтатусВскрытие", Перечисления.СтатусыАкцизныхМарок.ВскрытаяБутылка);
	Запрос.УстановитьПараметр("СтатусСписано", Перечисления.СтатусыАкцизныхМарок.Отсутствует);
	Запрос.Текст = ТекстЗапроса;
	
	
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПива(),,
		"&ВидПродукцииИС_УсловиеОтбораЭтоПиво");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаПоОрганизациям = РезультатЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	МассивСозданныхДокументов = Новый Массив;
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		СоответствиеДокументовПоПодразделениям = Новый Соответствие;
		ВыборкаПоСкладам = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоСкладам.Следующий() Цикл
			
			ТекДокумент = Документы.питКорректировкаОстатковИС.СоздатьДокумент();
			ТекДокумент.Дата = ПериодКонтроля;
			ТекДокумент.Заполнить(Неопределено);
			ТекДокумент.Организация = ВыборкаПоСкладам.Организация;
			ТекДокумент.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.КорректировкаОстатковИСКорректировкаОстатков;
			ТекДокумент.Склад = ВыборкаПоСкладам.СкладПриготовления;
			ТекДокумент.Подразделение = питОбщегоНазначения.ПодразделениеПоСкладу(ТекДокумент.Склад);
			
			ВыборкаЗаписей = ВыборкаПоСкладам.Выбрать();
			Пока ВыборкаЗаписей.Следующий() Цикл
				
				НоваяСтрока = ТекДокумент.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаЗаписей);
				
			КонецЦикла;
			
			МассивСозданныхДокументов.Добавить(ТекДокумент);
			
		КонецЦикла;

	КонецЦикла;
	
	// Выполним автоматическое отключение кеги.
	ТаблицаКодовМаркировки = РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.НоваяТаблицаОтключенияВскрытыхПотребительскихУпаковок();
	
	Выборка = РезультатЗапроса[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаКодовМаркировки.Добавить();
		НоваяСтрока.КодМаркировки = Выборка.КодМаркировки;
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого ТекСтрока Из МассивСозданныхДокументов Цикл
			ТекСтрока.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТаблицаКодовМаркировки) Тогда
			РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.ОтключитьВскрытыеПотребительскиеУпаковки(ТаблицаКодовМаркировки);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = ИмяСобытияЖР();
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
		ОтменитьТранзакцию();
		
	КонецПопытки;
	
	ПропуститьРегистрацию = питОтраслевыеРешения.Свойство_ПропуститьРегистрацию();
	Выборка = РезультатЗапроса[6].Выбрать();
	Пока Выборка.Следующий() Цикл
		НовыйНабор = РегистрыСведений.АкцизныеМаркиЕГАИС.СоздатьНаборЗаписей();
		НовыйНабор.Отбор.ОрганизацияЕГАИС.Установить(Выборка.ОрганизацияЕГАИС);
		НовыйНабор.Отбор.АкцизнаяМарка.Установить(Выборка.АкцизнаяМарка);
		
		НоваяЗапись = НовыйНабор.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
		
		НовыйНабор.ДополнительныеСвойства.Вставить(ПропуститьРегистрацию, Истина);
		Попытка
			НовыйНабор.Записать(Истина);
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Событие = ИмяСобытияЖР();
			ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - Перевести объем в миллилитры ис.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  ЕдиницаИзмерения - Произвольный - Единица измерения.
//  Количество - Произвольный - Количество.
//  ПараметрыРасчета - Произвольный - Параметры расчета.
//  АлкогольнаяПродукция - Произвольный - Алкогольная продукция.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПеревестиОбъемВМиллилитрыИС(Номенклатура, 
		ЕдиницаИзмерения = Неопределено, 
		Количество = 1,
		ПараметрыРасчета = Неопределено,
		АлкогольнаяПродукция = Неопределено) Экспорт
		
	ОбъемныеВидыПродукции = ВидыПродукцииДоступныеДляОтраженияОстатковИС();
	
	Результат = 0;
	
	ВидПродукции = ВидПродукцииПоНоменклатуре(Номенклатура, 1);
	Если ОбъемныеВидыПродукции.Найти(ВидПродукции) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = питОтраслевыеРешения.ПеревестиОбъемВМиллилитры(Номенклатура, ЕдиницаИзмерения, Количество,
		ПараметрыРасчета, АлкогольнаяПродукция);
		
	// Количество в мл всегда должно быть целое.
	Результат = питОбщегоНазначенияКлиентСервер.ОкруглитьДоЦелого(Результат);
	Возврат Результат;
КонецФункции

// Виды продукции доступные для отражения в регистре остатков марок ИС.
//
// Возвращаемое значение:
//  Массив - Виды продукции.
Функция ВидыПродукцииДоступныеДляОтраженияОстатковИС(ВНовомФормате = Истина) Экспорт
	
	Результат = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПива(ВНовомФормате);
	Если питИнтеграцияЕГАИС.РеализоватьАлкогольПорционно() Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, питИнтеграцияИСМПКлиентСервер.ВидыПродукцииАлкоголя(ВНовомФормате));
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция КлючиВидовПродукцииВскрываемыйАлкоголь() Экспорт
	МассивКлючей = питИнтеграцияИСМПКлиентСервер.КлючВидовПродукцииПоПеречислению(Перечисления.ВидыПродукцииИС.Алкогольная);
	Результат = питОбщегоНазначенияКлиентСервер.ЗначениеВМассив(МассивКлючей);
	Возврат Результат;
КонецФункции

// Функция - Свойства маркированной продукции.
//
// Параметры:
//  Номенклатура - Массив, СправочникСсылка.Номенклатура - Номенклатура
// 
// Возвращаемое значение:
//  Произвольный - Соответствие если входящий массив и Структура если ссылка.
//
Функция СвойстваМаркированнойПродукции(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СпрНоменклатура.питПродажаВРозлив КАК ПродаетсяВРозлив,
	|	&ОпределениеВидаПродукции_ВидПродукции КАК ВидПродукцииИС,
	|	&ОпределениеВидаПродукции_КлючПродукции КАК КлючВидаПродукцииИС,
	|	СпрНоменклатура.Ссылка КАК НоменклатураСсылка
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО СпрНоменклатура.Ссылка = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка В(&Номенклатура)";
	
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(ТекстЗапроса,,"&ОпределениеВидаПродукции_КлючПродукции", Истина);
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(ТекстЗапроса,,"&ОпределениеВидаПродукции_ВидПродукции", Ложь);
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат питОбщегоНазначения.ВыгрузитьРезультатЗапроса(РезультатЗапроса, питОбщегоНазначения.ТипРезультата_Соответствие(),
			Новый Структура("Ключ", "НоменклатураСсылка"));
	КонецЕсли;
	
	Результат = питОбщегоНазначения.ПустаяСтруктураПоРезультатуЗапроса(РезультатЗапроса, Истина);
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции



// Виды продукции доступные для отражения в регистре остатки марок ИС только по контуру ЕГАИС.
