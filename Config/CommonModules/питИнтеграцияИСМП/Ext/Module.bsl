Функция КлючВидовПродукцииПоПеречислению(ВидПродукции, ДанныеКэша = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВидПродукции) Тогда
		Возврат Справочники.КлючиВидовПродукцииИС.ПустаяСсылка();
	КонецЕсли;
	
	Если ВидПродукции = Перечисления.ВидыПродукцииИС.Алкогольная Тогда
		МаркируемаяПродукцияЕГАИС = Истина;
	Иначе
		МаркируемаяПродукцияЕГАИС = Неопределено;
	КонецЕсли;
	
	ДанныеДляУточнения = ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ДанныеДляУточненияТоварнойГруппы();
	
	КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.КлючПоЗначениюПеречисления(
		ВидПродукции,
		ДанныеКэша,
		МаркируемаяПродукцияЕГАИС,
		ДанныеДляУточнения);
		
	Возврат КлючВидовПродукции;
	
КонецФункции

Функция ВидПродукцииПеречислениемПоСсылке(ЗначениеКПреобразованию) Экспорт
	
	Результат = Перечисления.ВидыПродукцииИС.ПустаяСсылка();
	Если НЕ ЗначениеЗаполнено(ЗначениеКПреобразованию) Тогда
		Возврат Результат;
	ИначеЕсли ТипЗнч(ЗначениеКПреобразованию) = Тип("ПеречислениеСсылка.ВидыПродукцииИС") Тогда
		Возврат ЗначениеКПреобразованию;
	ИначеЕсли ТипЗнч(ЗначениеКПреобразованию) = Тип("СправочникСсылка.КлючиВидовПродукцииИС") Тогда
		ВидыПродукцииИС = КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииКлюча(ЗначениеКПреобразованию);
	ИначеЕсли ТипЗнч(ЗначениеКПреобразованию) = Тип("СправочникСсылка.ТоварныеГруппыГИСМТ") Тогда
		ВидыПродукцииИС = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоТоварнойГруппе(ЗначениеКПреобразованию);
	Иначе
		ВидыПродукцииИС = питОбщегоНазначенияКлиентСервер.ЗначениеВМассив(ЗначениеКПреобразованию);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидыПродукцииИС) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидПродукцииСпр = ВидыПродукцииИС[0];
	
	ВидыПродукцииПереч = КонструкторИСОбщегоНазначенияКлиентСервер.ЗначенияЭлементаКонструктораПоВидуПродукции(
		ПредопределенноеЗначение(
		"Справочник.ЭлементыКонструктораВидовПродукцииИС.СвязьЭлементаСправочникаИЗначенияПеречисленияВидаПродукции"),
		ВидПродукцииСпр);
	ЭтоВидПродукцииЕГАИС = питИнтеграцияИСМПКлиентСервер.ЭтоПродукцияЕГАИС(ВидыПродукцииИС)
		И питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииАлкоголя(ВидПродукцииСпр);
		
	Для Каждого ТекЗначение Из ВидыПродукцииПереч Цикл
		Если НЕ ЗначениеЗаполнено(ТекЗначение) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоВидПродукцииЕГАИС
			И НЕ питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииАлкоголя(ТекЗначение) Тогда
			Продолжить;
		КонецЕсли;
		Результат = ТекЗначение;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Процедура - Определить вид продукции текста запроса.
//
// Параметры:
//  ТекстЗапроса - Строка - Текст запроса.
//  ПутьКПолюНоменклатура - Строка - Путь к полю номенклатура.
//  ЗаменяемыйПараметр - Строка - Заменяемый параметр.
//
Процедура ОпределитьВидПродукцииТекстаЗапроса(ТекстЗапроса,
	ПутьКПолюНоменклатура = "ОписаниеНоменклатурыИС",
	ЗаменяемыйПараметр = "&ОпределениеВидаПродукции",
	ВидПродукцииЭтоКлюч = Ложь) Экспорт

	Если ВидПродукцииЭтоКлюч Тогда
		ОпределениеВидаПродукции = СтрШаблон(" ЕСТЬNULL(%1.КлючВидовПродукции, ЗНАЧЕНИЕ(Справочник.КлючиВидовПродукцииИС.ПустаяСсылка))" ,
			ПутьКПолюНоменклатура);
	Иначе
		ОпределениеВидаПродукции = СтрШаблон(" %1" ,
			питИнтеграцияИСМП.ПолеВидаПродукцииИС(ПутьКПолюНоменклатура));
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаменяемыйПараметр, ОпределениеВидаПродукции);
	

	
КонецПроцедуры

// Функция - Заполнить условие вида продукции ИСВЗапросе
//
// Параметры:
//  Запрос			 - Запрос - Запрос или текст запроса.
//  ВидПродукцииИС	 - ПеречислениеСсылка.ВидыПродукцииИС - Вид продукции перечислением.
// 
// Возвращаемое значение:
//  Строка - Текст запроса
//
Функция ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, ВидПродукцииИС, ИмяТаблицыОписания = "ОписаниеНоменклатурыИС",
	ИмяКлюча = Неопределено) Экспорт
	
	ТекстЗапроса = Запрос.Текст;
	
	Если ТипЗнч(ВидПродукцииИС) = Тип("Массив") Тогда
		ВремВидПродукции = ?(ЗначениеЗаполнено(ВидПродукцииИС), ВидПродукцииИС[0], Неопределено);
		ПараметрыУсловия = УсловиеВидаПродукцииИС(Запрос, ИмяТаблицыОписания, ВремВидПродукции);
		Если ТипЗнч(ВремВидПродукции) = Тип("ПеречислениеСсылка.ВидыПродукцииИС") Тогда
			ОбщийМассивВидовПродукции = Новый Массив;
			Для Каждого ВремВидПродукции Из ВидПродукцииИС Цикл
				ЗначениеПараметра = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоПеречислению(ВремВидПродукции);
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОбщийМассивВидовПродукции, ЗначениеПараметра);
			КонецЦикла;
		Иначе
			ОбщийМассивВидовПродукции = ВидПродукцииИС;
		КонецЕсли;
		УсловияВидаПродукции = ПараметрыУсловия.ТекстУсловия;
		Запрос.УстановитьПараметр(ПараметрыУсловия.ИмяПараметра, ОбщийМассивВидовПродукции);
		
	Иначе
		ПараметрыУсловия = УсловиеВидаПродукцииИС(Запрос, ИмяТаблицыОписания, ВидПродукцииИС);
		УсловияВидаПродукции = ПараметрыУсловия.ТекстУсловия;
	КонецЕсли;
	
	Если ИмяКлюча = Неопределено Тогда
		ИмяКлюча = КлючУсловияВидаПродукцииИС();
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ИмяКлюча, УсловияВидаПродукции);
	Запрос.Текст = ТекстЗапроса;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция - Заполнить условие вида продукции ИСВЗапросе
//
// Параметры:
//  Запрос			 - Запрос - Запрос или текст запроса.
//  ВидПродукцииИС	 - ПеречислениеСсылка.ВидыПродукцииИС - Вид продукции перечислением.
// 
// Возвращаемое значение:
//  Строка - Текст запроса
//
Функция ЗаполнитьПолеВидаПродукцииИСВЗапросе(Запрос, ВидПродукцииЭтоКлюч = Ложь, ИмяТаблицыОписания = "ОписаниеНоменклатурыИС",
	ИмяКлюча = Неопределено) Экспорт
	
	Если ИмяКлюча = Неопределено Тогда
		ИмяКлюча = КлючПолеВидаПродукцииИС();
	КонецЕсли;
	
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(Запрос.Текст,ИмяТаблицыОписания, ИмяКлюча, ВидПродукцииЭтоКлюч);
	
	Возврат Запрос.Текст;
	
КонецФункции

Функция КлючПолеВидаПродукцииИС() Экспорт
	Возврат "&ВидПродукцииИС_ПолеВидПродукции";
КонецФункции

Функция КлючУсловияВидаПродукцииИС() Экспорт
	Возврат "&ВидПродукцииИС_УсловиеОтбора";
КонецФункции


Функция ПолеВидаПродукцииИС(ИмяТаблицыОписания) Экспорт
	
	ИменаПолейКлючаВидовПродукции = КонструкторИСОбщегоНазначенияКлиентСервер.ИменаПолейКлючаВидовПродукции();
	МассивПолей = Новый Массив;
	Для Каждого ИмяПоля Из ИменаПолейКлючаВидовПродукции Цикл
		МассивПолей.Добавить(СтрШаблон("КОГДА ЕСТЬNULL(%1.КлючВидовПродукции.%2, ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка))
		|			<> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
		|	ТОГДА ЕСТЬNULL(%1.КлючВидовПродукции.%2, ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка))",ИмяТаблицыОписания, ИмяПоля));
	КонецЦикла;
	
	Результат = СтрШаблон("ВЫБОР
	|		%1
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
	|	КОНЕЦ", СтрСоединить(МассивПолей, Символы.ПС));
	Возврат Результат;
	
КонецФункции

Функция УсловиеВидаПродукцииИС(Запрос, ИмяТаблицыОписания, ВидПродукцииИС)
	
	УсловияВидаПродукции = "";
	ЗначениеПараметра = Неопределено;
	ВыходныеПараметры = Новый Структура("ТекстУсловия, ИмяПараметра, ЗначениеПараметра");
	
	ВыходныеПараметры.ИмяПараметра = СтрШаблон("ВидПродукцииИС_%1", СтрЗаменить(Новый УникальныйИдентификатор, "-", ""));
	Если НЕ ЗначениеЗаполнено(ВидПродукцииИС) Тогда
		
		ЗначениеПараметра = ВидПродукцииИС
		
	ИначеЕсли ТипЗнч(ВидПродукцииИС) = Тип("СправочникСсылка.ВидыПродукцииИС") Тогда
		
		ЗначениеПараметра = ВидПродукцииИС;
		
	ИначеЕсли ТипЗнч(ВидПродукцииИС) = Тип("ПеречислениеСсылка.ВидыПродукцииИС") Тогда
		
		ЗначениеПараметра = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоПеречислению(ВидПродукцииИС);
		
	КонецЕсли;
	
	Если ЗначениеПараметра = Неопределено Тогда
		ВыходныеПараметры.ТекстУсловия = ?(ВидПродукцииИС = Неопределено, "ИСТИНА", "ЛОЖЬ");
	Иначе
		ВыходныеПараметры.ТекстУсловия = СтрШаблон("%1 В(&%2)", ПолеВидаПродукцииИС(ИмяТаблицыОписания), ВыходныеПараметры.ИмяПараметра);
	КонецЕсли;
	ВыходныеПараметры.ЗначениеПараметра = ЗначениеПараметра;
	
	Запрос.УстановитьПараметр(ВыходныеПараметры.ИмяПараметра, ВыходныеПараметры.ЗначениеПараметра);
	Возврат ВыходныеПараметры;
КонецФункции

// Функция - Виды продукции пива.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ВидыПродукцииПива(ВНовомФормате = Истина) Экспорт
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыПродукцииИС.Пиво);
	Результат.Добавить(Перечисления.ВидыПродукцииИС.БезалкогольноеПиво);
	Если НЕ ВНовомФормате Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукцииОбщий = Новый Массив;
	Для Каждого ТекЗначение Из Результат Цикл
		ВидыПродукции = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоПеречислению(ТекЗначение);
		Для Каждого ВремЗначение Из ВидыПродукции Цикл
			Если НЕ питИнтеграцияИСМПКлиентСервер.ЭтоПродукцияИСМП(ВремЗначение) Тогда
				Продолжить;
			КонецЕсли;
			ВидыПродукцииОбщий.Добавить(ВремЗначение);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ВидыПродукцииОбщий;
	
КонецФункции 

// Функция - Виды продукции пива.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ВидыПродукцииАлкоголя(ВНовомФормате = Истина) Экспорт
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыПродукцииИС.Алкогольная);
	Если НЕ ВНовомФормате Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукцииОбщий = Новый Массив;
	Для Каждого ТекЗначение Из Результат Цикл
		ВидыПродукции = питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПоПеречислению(ТекЗначение);
		Для Каждого ВремЗначение Из ВидыПродукции Цикл
			ВидыПродукцииОбщий.Добавить(ВремЗначение);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ВидыПродукцииОбщий;
	
КонецФункции 

Функция ДоступныеВидыПродукции() Экспорт
	
	Результат = Новый Массив;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Подсистемы = Новый Массив;
	Для Каждого Суффикс Из КонструкторИСОбщегоНазначенияКлиентСервер.СуффиксыВидовПродукции() Цикл
		Если ОбщегоНазначенияИС.ПодсистемаИспользуется(Суффикс) Тогда
			Подсистемы.Добавить(
				Справочники.ЭлементыКонструктораВидовПродукцииИС["ВидыПродукции"+Суффикс]);
		КонецЕсли;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗначенияЭлементовКонструктора.ВидПродукции КАК ВидПродукции
	|ИЗ
	|	РегистрСведений.ЗначенияЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктора
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияПользователяЭлементовКонструктора
	|		ПО ЗначенияЭлементовКонструктора.ЭлементКонструктора = ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора
	|			И ЗначенияЭлементовКонструктора.ВидПродукции = ЗначенияПользователяЭлементовКонструктора.ВидПродукции
	|ГДЕ
	|	ЗначенияЭлементовКонструктора.ЭлементКонструктора В(&Подсистемы)
	|	И ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗначенияПользователяЭлементовКонструктора.ВидПродукции
	|ИЗ
	|	РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияПользователяЭлементовКонструктора
	|ГДЕ
	|	ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора В(&Подсистемы)
	|	И НЕ ЗначенияПользователяЭлементовКонструктора.ПометкаУдаления";
	Запрос.УстановитьПараметр("Подсистемы", Подсистемы);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ВидПродукции);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции


