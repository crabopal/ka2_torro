// Функция - Вид продукции по номенклатуре.
//
// Параметры:
//  ТекущаяНоменклатура	 - Произвольный	 - Текущая номенклатура.
//  ТипРезультата		 - Число	 - Тип. Например,
//								0 - ПеречислениеСсылка.ВидыПродукцииИС,
//								1 - СправочникСсылка.ВидыПродукцииИС,
//								2 - СправочникСсылка.КлючиВидовПродукцииИС.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ВидПродукцииПоНоменклатуре(ТекущаяНоменклатура, ТипРезультата = 0) Экспорт
	
	КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.ПустаяСсылка();
	Если ЗначениеЗаполнено(ТекущаяНоменклатура) Тогда
		ОписаниеНоменклатуры = РегистрыСведений.ОписаниеНоменклатурыИС.Получить(Новый Структура("Номенклатура", ТекущаяНоменклатура));
		КлючВидовПродукции = ОписаниеНоменклатуры.КлючВидовПродукции;
	КонецЕсли;
	// Возвращать ключ вида продукции.
	Если ТипРезультата = 2 Тогда
		Возврат КлючВидовПродукции;
	КонецЕсли;
	
	Если ТипРезультата = 0 Тогда
		Результат = Перечисления.ВидыПродукцииИС.ПустаяСсылка();
	Иначе
		Результат = Справочники.ВидыПродукцииИС.ПустаяСсылка();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КлючВидовПродукции) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыПродукцииИС = КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииКлюча(ОписаниеНоменклатуры.КлючВидовПродукции);
	Если НЕ ЗначениеЗаполнено(ВидыПродукцииИС) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидПродукцииСпр = ВидыПродукцииИС[0];
	Если ТипРезультата = 1 Тогда
		Возврат ВидПродукцииСпр;
	КонецЕсли;
	
	ВидыПродукцииПереч = КонструкторИСОбщегоНазначенияКлиентСервер.ЗначенияЭлементаКонструктораПоВидуПродукции(
		ПредопределенноеЗначение(
		"Справочник.ЭлементыКонструктораВидовПродукцииИС.СвязьЭлементаСправочникаИЗначенияПеречисленияВидаПродукции"),
		ВидПродукцииСпр);
		
	ЭтоВидПродукцииЕГАИС = питИнтеграцияИСМПКлиентСервер.ЭтоПродукцияЕГАИС(ВидыПродукцииИС)
		И питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииАлкоголя(ВидПродукцииСпр);	
	Для Каждого ТекЗначение Из ВидыПродукцииПереч Цикл
		Если НЕ ЗначениеЗаполнено(ТекЗначение) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоВидПродукцииЕГАИС
			И НЕ питИнтеграцияИСМПКлиентСервер.ЭтоВидПродукцииАлкоголя(ТекЗначение) Тогда
			Продолжить;
		КонецЕсли;
	Результат = ТекЗначение;
	КонецЦикла;
	
	
	Возврат Результат;
КонецФункции

Функция ВидыПродукцииПоПеречислению(ЗначениеПеречисления, МаркируемаяПродукцияЕГАИС = Истина) Экспорт
	
