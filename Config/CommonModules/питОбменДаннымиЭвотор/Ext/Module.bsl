//  Функция - Новый таблица учет алкоголя.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
Функция НовыйТаблицаУчетАлкоголя()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Код",          Новый ОписаниеТипов("Строка"));
	ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоваров.Колонки.Добавить("КодАкциза",    Новый ОписаниеТипов("Строка"));
	ТаблицаТоваров.Колонки.Добавить("Количество",   Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("ИмяЕдИзм",     Новый ОписаниеТипов("Строка"));
	ТаблицаТоваров.Колонки.Добавить("Коэффициент",  Новый ОписаниеТипов("Число"));
	
	Возврат ТаблицаТоваров;
	
КонецФункции

// Процедура - Дополнить запись товара к передаче.
//
// Параметры:
//  СтруктураТовара - Структура - Структура товара.
//  Товар - Произвольный - Товар.
//
Процедура ДополнитьЗаписьТовараКПередаче(СтруктураТовара, Товар) Экспорт
	
	Если СтруктураТовара = Неопределено Тогда
		СтруктураТовара = ОфлайнОборудование1СЭвоторКлиентСервер.РеквизитыТовара();
	КонецЕсли;
	
	// Если иерархия все же пришла, то не будем ее эмулировать, а просто ее заполним.
	Если Товар.Свойство("УникальныйИдентификаторГруппы") 
		И Товар.Свойство("ИспользоватьИерархиюПоИдентификаторам") 
		И Товар.ИспользоватьИерархиюПоИдентификаторам Тогда
		СтруктураТовара.parentUuid = Товар.УникальныйИдентификаторГруппы;
	КонецЕсли;
	
	//Если Товар.Свойство("ЭтоПодакцизныйТовар") Тогда
	//	СтруктураТовара.is_excisable = Товар.ЭтоПодакцизныйТовар;
	//КонецЕсли;
	
КонецПроцедуры

