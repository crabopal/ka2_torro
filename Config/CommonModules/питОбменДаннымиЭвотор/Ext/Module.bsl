//  Функция - Получить кассовый узел терминала.
//
// Параметры:
//  ТерминалСсылка - Произвольный - Терминал ссылка.
//  СформироватьСсылкуНового - Произвольный - Сформировать ссылку нового.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьКассовыйУзелТерминала(ТерминалСсылка, СформироватьСсылкуНового = Ложь) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питУдаленныеКассы.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы КАК питУдаленныеКассы
	|ГДЕ
	|	питУдаленныеКассы.УзелТерминала = &УзелТерминала";
	Запрос.УстановитьПараметр("УзелТерминала", ТерминалСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	ИначеЕсли СформироватьСсылкуНового Тогда
		Результат = ПланыОбмена.питУдаленныеКассы.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Иначе
		Результат = ПланыОбмена.питУдаленныеКассы.ПустаяСсылка();
	КонецЕсли;

	Возврат Результат;
КонецФункции

