// Функция - Получить соответствие перечисления Видов продукции ИС в БПО.
//
// Возвращаемое значение:
//  Соответствие - Ключ - Перечисление ВидыПродукцииИС, Значение - Перечисление ВидыМаркированнойПродукцииБПО.
Функция ВидыПродукцииИСВБПО() Экспорт
	
	// См. .
	ЭмуляцияНоменклатуры = Новый Структура("ВидПродукцииИС, ПродаетсяВРозлив",, Ложь);
	ЗаписьТовар = МенеджерОфлайнОборудования.ЗаписьТовараПрайсЛиста();
	
	МассивСообщений = Новый Массив;
	ВидыПродукцииИС = Метаданные.Перечисления.ВидыПродукцииИС.ЗначенияПеречисления;
	СоответствиеВариантов = Новый Соответствие;
	Для Каждого ЗначениеВидПродукцииИС Из ВидыПродукцииИС Цикл
		
		ВидПродукцииИС = Перечисления.ВидыПродукцииИС[ЗначениеВидПродукцииИС.Имя];
		
		ВидПродукцииБПО = Неопределено;
		Если ВидПродукцииИС = Перечисления.ВидыПродукцииИС.МолочнаяПродукцияБезВЕТИС
			ИЛИ ВидПродукцииИС = Перечисления.ВидыПродукцииИС.МолочнаяПродукцияПодконтрольнаяВЕТИС Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.МолочнаяПродукция;
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ПродукцияИзНатуральногоМеха Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.ИзделияИзМеха;
		ИначеЕсли ВидПродукцииИС = ВидПродукцииИСАлкоголь()
			ИЛИ ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ПодконтрольнаяПродукцияВЕТИС Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.ПустаяСсылка();
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.МорепродуктыПодконтрольныеВЕТИС Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.Морепродукты;
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.КормаДляЖивотныхБезВЕТИС
			ИЛИ ВидПродукцииИС = Перечисления.ВидыПродукцииИС.КормаДляЖивотныхПодконтрольныеВЕТИС
			ИЛИ ВидПродукцииИС = Перечисления.ВидыПродукцииИС.КормаДляЖивотныхВлажныеБезВЕТИС
			ИЛИ ВидПродукцииИС = Перечисления.ВидыПродукцииИС.КормаДляЖивотныхВлажныеПодконтрольныеВЕТИС Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.КормаДляЖивотных;
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.КонсервированнаяПродукцияБезВЕТИС
			ИЛИ ВидПродукцииИС = Перечисления.ВидыПродукцииИС.КонсервированнаяПродукцияПодконтрольнаяВЕТИС Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.КонсервированнаяПродукция;
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ПивоВПотребительскихУпаковках Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.Пиво;
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.МедицинскиеИзделия20 Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.МедицинскиеИзделия;
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ЛегкаяПромышленность2025 Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.ЛегкаяПромышленность;
		ИначеЕсли ВидПродукцииИС = Перечисления.ВидыПродукцииИС.БАДы2025 Тогда
			ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.Бады;
		КонецЕсли;
		
		Если ВидПродукцииБПО = Неопределено Тогда
			
			Попытка
				ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО[ЗначениеВидПродукцииИС.Имя];
			Исключение
				ВидПродукцииБПО = Перечисления.ВидыМаркированнойПродукцииБПО.ПустаяСсылка();
			КонецПопытки;
			
			Если НЕ ЗначениеЗаполнено(ВидПродукцииБПО) Тогда
				ЭмуляцияНоменклатуры.ВидПродукцииИС = ВидПродукцииИС;
				ЗаписьТовар.ВидМаркированнойПродукции = Неопределено;
				Попытка
					ПодключаемоеОборудованиеOfflineВызовСервера_ЗаполнитьВидПродукцииИС(ЭмуляцияНоменклатуры, ЗаписьТовар);
					Если НЕ ЗаписьТовар.ВидМаркированнойПродукции = Неопределено Тогда
						ВидПродукцииБПО = ЗаписьТовар.ВидМаркированнойПродукции;
					КонецЕсли;
				Исключение
					МассивСообщений.Добавить(СтрШаблон(НСтр("ru='- %1'"), ЗначениеВидПродукцииИС.Имя));
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		СоответствиеВариантов[ВидПродукцииИС] = ВидПродукцииБПО;
	КонецЦикла;
	
	СоответствиеВариантов[ВидПродукцииИСРазливноеПиво()] = Перечисления.ВидыМаркированнойПродукцииБПО.РазливноеПиво;
	
	Если ОбщегоНазначения.РежимОтладки()
		И ЗначениеЗаполнено(МассивСообщений) Тогда
		МассивСообщений.Вставить(0, НСтр("ru='Обнаружены расхождения между видами продукции ИС и виды маркированной продукции БПО:'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(МассивСообщений, Символы.ПС));
	КонецЕсли;
	
	Возврат СоответствиеВариантов;
КонецФункции

Процедура ПодключаемоеОборудованиеOfflineВызовСервера_ЗаполнитьВидПродукцииИС(Номенклатура, ЗаписьТовар) 
	// +УОП
	Экспорт
	// -УОП
	
	ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
	
	Если Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Алкогольная Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Ложь;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Табак Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.Табак;
		ЗаписьТовар.ТипМаркированнойПродукции = Перечисления.ТипыМаркировкиККТ.ТабачнаяПродукция;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Обувь Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.Обувь;
		ЗаписьТовар.ТипМаркированнойПродукции = Перечисления.ТипыМаркировкиККТ.ОбувныеТовары;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ЛегкаяПромышленность 
	ИЛИ Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ЛегкаяПромышленность2025 Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.ЛегкаяПромышленность;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.МолочнаяПродукцияПодконтрольнаяВЕТИС Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.МолочнаяПродукция;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.МолочнаяПродукцияБезВЕТИС Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.МолочнаяПродукция;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Шины Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.Шины;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Фотоаппараты Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.Фотоаппараты;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Велосипеды Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.Велосипеды;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.КреслаКоляски Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.КреслаКоляски;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Духи Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.Духи;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.УпакованнаяВода Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.УпакованнаяВода; 
