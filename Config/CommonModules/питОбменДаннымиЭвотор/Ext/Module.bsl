
#Область ПрограммныйИнтерфейс

#Область ОбщиеПроцедурыИФункции

// Функция получает параметры устройства.
//
// Параметры:
//  Устройство - Произвольный - Устройство.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьПараметрыУстройства(Устройство) Экспорт
	
	ВозвращаемоеЗначение = Неопределено;
	
	Запрос = Новый Запрос;
	// +rarus
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодключаемоеОборудование.ПравилоОбмена КАК ПравилоОбмена,
	|	ПодключаемоеОборудование.УзелИнформационнойБазы КАК УзелИнформационнойБазы,
	|	ЕСТЬNULL(ПодключаемоеОборудование.ПравилоОбмена.Склад.РозничныйВидЦены, ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)) КАК ВидЦен,
	|	ЕСТЬNULL(ПодключаемоеОборудование.ПравилоОбмена.Склад, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК Склад,
	|	ЕСТЬNULL(ПодключаемоеОборудование.ПравилоОбмена.МаксимальныйКод, 0) КАК МаксимальныйКод,
	|	ЕСТЬNULL(ПодключаемоеОборудование.ПравилоОбмена.ВыгружатьИзменения, ИСТИНА) КАК ВыгружатьИзменения,
	|	ЕСТЬNULL(ПодключаемоеОборудование.ПравилоОбмена.Склад.РозничныйВидЦены.ЦенаВключаетНДС, ИСТИНА) КАК ЦенаВключаетНДС,
	|	ПодключаемоеОборудование.ТипОфлайнОборудования КАК ТипОборудования,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питТипДрайвера, 0) КАК ТипДрайвера,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питПрефикс, """") КАК Префикс,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питТипЦен, НЕОПРЕДЕЛЕНО) КАК питТипЦен,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питКассаККМ, НЕОПРЕДЕЛЕНО) КАК питКассаККМ,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питКассаККМ.питКассовыйУзел, НЕОПРЕДЕЛЕНО) КАК питКассовыйУзел,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питКассаККМ.Подразделение, НЕОПРЕДЕЛЕНО) КАК Подразделение,
	|	ПодключаемоеОборудование.Организация КАК Организация,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питТипВыгружаемойИерархии, 0) КАК питТипВыгружаемойИерархии,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питЗагружатьНоменклатуру, ЛОЖЬ) КАК ЗагружатьНоменклатуру
	|ИЗ
	|	Справочник.ОфлайнОборудование КАК ПодключаемоеОборудование
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменСПодключаемымОборудованиемOffline КАК ОбменСПодключаемымОборудованиемOffline
	|		ПО ПодключаемоеОборудование.УзелИнформационнойБазы = ОбменСПодключаемымОборудованиемOffline.Ссылка
	|ГДЕ
	|	ПодключаемоеОборудование.Ссылка = &Устройство";
	// -rarus
	
	Запрос.УстановитьПараметр("Устройство", Устройство);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ВозвращаемоеЗначение = Новый Структура;
			ВозвращаемоеЗначение.Вставить("ПравилоОбмена",          Выборка.ПравилоОбмена);
			ВозвращаемоеЗначение.Вставить("УзелИнформационнойБазы", Выборка.УзелИнформационнойБазы);
			ВозвращаемоеЗначение.Вставить("ВидЦен",                 Выборка.ВидЦен);
			ВозвращаемоеЗначение.Вставить("ТипОборудования",        Выборка.ТипОборудования);
			ВозвращаемоеЗначение.Вставить("МаксимальныйКод",        Выборка.МаксимальныйКод);
			ВозвращаемоеЗначение.Вставить("ВыгружатьИзменения",     Выборка.ВыгружатьИзменения);
			ВозвращаемоеЗначение.Вставить("ЦенаВключаетНДС",        Выборка.ЦенаВключаетНДС);
			// +rarus
			ВозвращаемоеЗначение.Вставить("Организация",                    Выборка.Организация);
			ВозвращаемоеЗначение.Вставить("ТипЦен", Выборка.питТипЦен);
			ВозвращаемоеЗначение.Вставить("КассаККМ", Выборка.питКассаККМ);
			ВозвращаемоеЗначение.Вставить("ТипДрайвера",                    Выборка.ТипДрайвера);
			ВозвращаемоеЗначение.Вставить("Префикс",                        Выборка.Префикс);
			ВозвращаемоеЗначение.Вставить("ТипВыгружаемойИерархии",     Выборка.питТипВыгружаемойИерархии);
			ВозвращаемоеЗначение.Вставить("ЗагружатьНоменклатуру",     Выборка.ЗагружатьНоменклатуру);
			ВозвращаемоеЗначение.Вставить("КассовыйУзел", Выборка.питКассовыйУзел);
			ВозвращаемоеЗначение.Вставить("Подразделение",     Выборка.Подразделение);
			// -rarus
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Функция получает параметры устройства.
//
// Параметры:
//  Устройство - Произвольный - Устройство.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьТипДрайвераУстройства(Устройство) Экспорт
	
	ВозвращаемоеЗначение = 0;
	
	Запрос = Новый Запрос;
	// +rarus
	Запрос.Текст = "ВЫБРАТЬ
	|	ОборудованиеПоОрганизациям.УзелИнформационнойБазы КАК УзелИнформационнойБазы,
	|	ЕСТЬNULL(ОбменСПодключаемымОборудованиемOffline.питТипДрайвера, 0) КАК ТипДрайвера
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ОборудованиеПоОрганизациям
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменСПодключаемымОборудованиемOffline КАК ОбменСПодключаемымОборудованиемOffline
	|		ПО ОборудованиеПоОрганизациям.УзелИнформационнойБазы = ОбменСПодключаемымОборудованиемOffline.Ссылка
	|ГДЕ
	|	ОборудованиеПоОрганизациям.Ссылка = &Устройство";
	// -rarus
	
	Запрос.УстановитьПараметр("Устройство", Устройство);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ВозвращаемоеЗначение = Выборка.ТипДрайвера;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Функция возвращает структуру с данными в формате, необходимом для выгрузки списка товаров в ККМ Offline.
//
// Параметры:
//  Устройство		 - СправочникСсылка.ПодключаемоеОборудование - Устройство для которого необходимо получить данные.
//  ПрайсЛист		 - Произвольный	 - Прайс лист.
//  ПолнаяВыгрузка	 - Произвольный	 - Полная выгрузка.
// 
// Возвращаемое значение:
//  Структура - с массивом структур для выгрузки и количеством не выгруженных строк.
//
Функция ПолучитьДанныеДляКассы(Устройство, ПрайсЛист, ПолнаяВыгрузка) Экспорт
	
	Параметры = питОбменДаннымиЭвотор.ПолучитьПараметрыУстройства(Устройство);
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// +УОП
	СоответствиеВидовПродукцииИСБПО = ВидыПродукцииИСВБПО();
	// -УОП
	
	ДанныеДляКассы = питОбменДаннымиЭвотор.ТаблицыДанныхДляВыгрузки(Устройство, Параметры, ПолнаяВыгрузка);
	ДанныеДляКассы.ТаблицаШтрихкоды.Индексы.Добавить("Номенклатура");
	
	СтруктураПризнакПредметаРасчета = Новый Структура;
	СтруктураПризнакПредметаРасчета.Вставить("ТипНоменклатуры");
	СтруктураПризнакПредметаРасчета.Вставить("ПодакцизныйТовар");
	
	Для каждого СтрокаТовара Из ДанныеДляКассы.ТаблицаТовары Цикл
		ЗаписьТовара = МенеджерОфлайнОборудования.ЗаписьТовараПрайсЛиста();
		
		ЗаполнитьЗначенияСвойств(ЗаписьТовара, СтрокаТовара);
		ЗаполнитьЗначенияСвойств(СтруктураПризнакПредметаРасчета, СтрокаТовара);
		
		ЗаписьТовара.Код                     = СтрокаТовара.Код;
		ЗаписьТовара.Цена                    = СтрокаТовара.Цена;
		ЗаписьТовара.Остаток                 = 0;
		ЗаписьТовара.УникальныйИдентификатор = СтрокаТовара.Ссылка.УникальныйИдентификатор();
		ЗаписьТовара.Наименование            = СтрокаТовара.Наименование;
		
		ЗаписьТовара.СтавкаНДС               = ПолучитьСтавкуНДСККМ(СтрокаТовара.СтавкаНДС);
		ЗаписьТовара.ПризнакПредметаРасчета  = РозничныеПродажиКлиентСервер.ПризнакПредметаРасчетаФискальнойОперации(
			СтруктураПризнакПредметаРасчета.ТипНоменклатуры,
			СтруктураПризнакПредметаРасчета.ПодакцизныйТовар);
		
		// +УОП
		УникальныйИдентификаторРодителя = СтрокаТовара.Родитель.УникальныйИдентификатор();
		Если НЕ ЗначениеЗаполнено(УникальныйИдентификаторРодителя) Тогда
			УникальныйИдентификаторРодителя = Неопределено;
		Иначе
			УникальныйИдентификаторРодителя = Строка(УникальныйИдентификаторРодителя);
		КонецЕсли;
		ЗаписьТовара.УникальныйИдентификаторГруппы = УникальныйИдентификаторРодителя;
		ЗаписьТовара.Вставить("ИспользоватьИерархиюПоИдентификаторам", Истина);
		
		ЗаписьТовара.ЭтоАлкоголь = СтрокаТовара.АлкогольнаяПродукция;
		Если ЗаписьТовара.ЭтоАлкоголь Тогда
			ЗаписьТовара.АлкогольныеРеквизиты.Маркируемый = СтрокаТовара.Маркируемый;
			ЗаписьТовара.АлкогольныеРеквизиты.КодВидаАлкогольнойПродукции = СтрокаТовара.КодВидаАлкогольнойПродукции;
			ЗаписьТовара.АлкогольныеРеквизиты.ЕмкостьТары = СтрокаТовара.ЕмкостьТары;
			ЗаписьТовара.АлкогольныеРеквизиты.Крепость = СтрокаТовара.Крепость;
			ЗаписьТовара.АлкогольныеРеквизиты.ИННПроизводителя = СтрокаТовара.ИННПроизводителя;
			ЗаписьТовара.АлкогольныеРеквизиты.КПППроизводителя = СтрокаТовара.КПППроизводителя;
		КонецЕсли;
		
		ЗаполнитьВидПродукцииИС(СтрокаТовара, ЗаписьТовара, СоответствиеВидовПродукцииИСБПО);
		// -УОП
		
		ЗаписьТовара.Артикул                 = СтрокаТовара.Артикул;
		ЗаписьТовара.Описание                = СтрокаТовара.НаименованиеПолное;
		ЗаписьТовара.ЭтоВесовойТовар         = СтрокаТовара.ЭтоВесовой;
		ЗаписьТовара.НомерСекции             = 1;
		
		ЗаписьТовара.КодЕдиницыИзмерения                     = СтрокаТовара.ЕдиницаИзмеренияКод; 
		ЗаписьТовара.УникальныйИдентификаторЕдиницыИзмерения = СтрокаТовара.ЕдиницаИзмеренияСсылка.УникальныйИдентификатор();
		
		ТаблицаШтрихкоды = ДанныеДляКассы.ТаблицаШтрихкоды.НайтиСтроки(Новый Структура("Номенклатура", СтрокаТовара.Ссылка));
		Для каждого СтрокаШтрихкода Из ТаблицаШтрихкоды Цикл
			// Штрихкод
			ЗаписьШтрихкода = МенеджерОфлайнОборудования.ЗаписьШтрихкодаПрайсЛиста();
			ЗаписьШтрихкода.Штрихкод = СтрокаШтрихкода.Штрихкод;
			ЗаписьТовара.Штрихкоды.Добавить(ЗаписьШтрихкода);
		КонецЦикла;
		
		ПрайсЛист.Товары.Добавить(ЗаписьТовара);
	КонецЦикла;
	
	Для каждого СтрокаЕдиницаИзмерения Из ДанныеДляКассы.ТаблицаЕдиницыИзмерения Цикл
		ЗаписьЕИ = МенеджерОфлайнОборудования.ЗаписьЕдиницыИзмеренияПрайсЛиста();
		
		ЗаписьЕИ.Код                     = СтрокаЕдиницаИзмерения.Код;
		ЗаписьЕИ.Наименование            = СтрокаЕдиницаИзмерения.Наименование;
		ЗаписьЕИ.УникальныйИдентификатор = СтрокаЕдиницаИзмерения.Ссылка.УникальныйИдентификатор();
		ЗаписьЕИ.КодОКЕИ                 = СтрокаЕдиницаИзмерения.Код;
		
		ПрайсЛист.ЕдиницыИзмерения.Добавить(ЗаписьЕИ);
	КонецЦикла;
	
	// +УОП
	Для каждого СтрокаГруппыТоваров Из ДанныеДляКассы.ТаблицаГруппТоваров Цикл
		
		ЗаписьГруппыТоваров = МенеджерОфлайнОборудования.ЗаписьГруппыТоваровПрайсЛиста();
		ЗаписьГруппыТоваров.Код = СокрЛП(СтрокаГруппыТоваров.Код);
		ЗаписьГруппыТоваров.Наименование = СтрокаГруппыТоваров.Наименование;
		
		УникальныйИдентификатор = СтрокаГруппыТоваров.Ссылка.УникальныйИдентификатор();
		Если НЕ ЗначениеЗаполнено(УникальныйИдентификатор) Тогда
			УникальныйИдентификатор = Неопределено;
		Иначе
			УникальныйИдентификатор = Строка(УникальныйИдентификатор);
		КонецЕсли;

		ЗаписьГруппыТоваров.УникальныйИдентификатор = УникальныйИдентификатор;
		
		УникальныйИдентификаторРодителя = СтрокаГруппыТоваров.Родитель.УникальныйИдентификатор();
		Если НЕ ЗначениеЗаполнено(УникальныйИдентификаторРодителя) Тогда
			УникальныйИдентификаторРодителя = Неопределено;
		Иначе
			УникальныйИдентификаторРодителя = Строка(УникальныйИдентификаторРодителя);
		КонецЕсли;
		ЗаписьГруппыТоваров.УникальныйИдентификаторГруппы = УникальныйИдентификаторРодителя;
		
		ЗаписьГруппыТоваров.Вставить("ИспользоватьИерархиюПоИдентификаторам", Истина);
		// Строка необходимая для механизма бпо.
		// ЗаписьГруппыТоваров.КодГруппы = 0;
		
		ПрайсЛист.ГруппыТоваров.Добавить(ЗаписьГруппыТоваров);
		
	КонецЦикла;
	// -УОП
	
КонецФункции

// Функция возвращает таблицу товаров с данными к выгрузке в устройство.
//
// Параметры:
//  Устройство		 - СправочникСсылка.ПодключаемоеОборудование - Устройство для которого необходимо получить данные.
//  Параметры		 - Структура								 - Параметры формирования данных.
//  ПолнаяВыгрузка	 - Булево									 - Выгружать все товары.
// 
// Возвращаемое значение:
//  Массив - Результаты запроса для заполнения.
//
Функция ТаблицыДанныхДляВыгрузки(Устройство, Параметры, ПолнаяВыгрузка) Экспорт
	
	// Подготовим таблицы.
	ТаблицаТовары = Новый ТаблицаЗначений;
	ТаблицаТовары.Колонки.Добавить("Ссылка");
	ТаблицаТовары.Колонки.Добавить("Код");
	ТаблицаТовары.Колонки.Добавить("Артикул");
	ТаблицаТовары.Колонки.Добавить("Наименование");
	ТаблицаТовары.Колонки.Добавить("НаименованиеПолное");
	ТаблицаТовары.Колонки.Добавить("СтавкаНДС");
	ТаблицаТовары.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаТовары.Колонки.Добавить("ЕдиницаИзмеренияКод");
	ТаблицаТовары.Колонки.Добавить("ЕдиницаИзмеренияСсылка");
	ТаблицаТовары.Колонки.Добавить("Услуга");
	ТаблицаТовары.Колонки.Добавить("Цена");
	
	ТаблицаТовары.Колонки.Добавить("ЭтоВесовой", Новый ОписаниеТипов("Булево"));
	ТаблицаТовары.Колонки.Добавить("ТипНоменклатуры");
	ТаблицаТовары.Колонки.Добавить("Весовой",							Новый ОписаниеТипов("Булево"));
	ТаблицаТовары.Колонки.Добавить("КодНалога",							Новый ОписаниеТипов("Число"));
	ТаблицаТовары.Колонки.Добавить("АлкогольнаяПродукция",				Новый ОписаниеТипов("Булево"));
