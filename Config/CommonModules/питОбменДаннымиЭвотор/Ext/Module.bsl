		питЦеныНоменклатуры.ПреобразоватьОтборПоХарактеристикеЦен(КонецДня(ТекущаяДата()), Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
	// -пит
	
	Запрос.УстановитьПараметр("ВидПродукцииИСРазливноеПиво", ВидРазливноеПиво);
	Запрос.УстановитьПараметр("ВидПродукцииИСАлкоголь", ВидАлкоголь);
	
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПива(),,
		"&ВидПродукцииИС_УсловиеОтбораЭтоПиво");
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		питИнтеграцияИСМПКлиентСервер.ВидыПродукцииАлкоголя(),,
		"&ВидПродукцииИС_УсловиеОтбораЭтоАлкоголь");
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(Запрос.Текст);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КоличествоПакетов = РезультатЗапроса.Количество();
	
	ПараметрыУчетаНДСПоОрганизации = питОбменДаннымиПовтИсп.ПараметрыУчетаНДСПоОрганизации(
		Параметры.Организация,
		ТекущаяДатаСеанса()
	);
	
	// Обойдем пакет с номенклатурой.
	Если НЕ РезультатЗапроса[КоличествоПакетов - 5 + ДельтаПакетов].Пустой() Тогда
		Выборка = РезультатЗапроса[КоличествоПакетов - 5+ ДельтаПакетов].Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
			
			// Если тип цен не включает НДС то необходимо НДС добавить.
			Если НЕ ЦенаВключаетНДС Тогда
				ТекСтавкаНДС = УчетНДСУП.СтавкаНДСПоНоменклатуреИНалогообложению(
					Выборка.Номенклатура, 
					ПараметрыУчетаНДСПоОрганизации.ОсновноеНалогообложениеНДСПродажи, 
					Параметры.Организация, 
					ТекущаяДатаСеанса()
				);
				НоваяСтрока.СтавкаНДС = ТекСтавкаНДС;
				НоваяСтрока.Цена = (НоваяСтрока.Цена * (100 + УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(ТекСтавкаНДС))) / 100;
			КонецЕсли;
			
			НоваяСтрока.Цена = Окр(НоваяСтрока.Цена, 2);
			НоваяСтрока.ЕдиницаИзмерения = Выборка.ОсновнаяЕдиницаИзмерения;
			
			НоваяСтрока.ЭтоМаркированнаяПродукция = ЗначениеЗаполнено(Выборка.ВидПродукцииИС);
			
			Если Выборка.ВидПродукцииИС = ВидРазливноеПиво
				ИЛИ Выборка.ВидПродукцииИС = ВидАлкоголь Тогда
				ВидПродукции = Выборка.ВидПродукцииИС;
			Иначе
				ВидПродукции = питИнтеграцияИСМПКлиентСервер.ВидПродукцииПеречислениемПоСсылке(Выборка.ВидПродукцииИС);
			КонецЕсли;
			НоваяСтрока.ВидПродукцииИС = ВидПродукции;
	
		КонецЦикла;
	КонецЕсли;
	
	// Обойдем пакет с штрихкодами.
	Если НЕ РезультатЗапроса[КоличествоПакетов - 4+ ДельтаПакетов].Пустой() Тогда
		Выборка = РезультатЗапроса[КоличествоПакетов - 4+ ДельтаПакетов].Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаШтрихкоды.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
	КонецЕсли;
	
	// Обойдем пакет с единицами измерений.
	Если НЕ РезультатЗапроса[КоличествоПакетов-3 + ДельтаПакетов].Пустой() Тогда
		Выборка = РезультатЗапроса[КоличествоПакетов-3 + ДельтаПакетов].Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаЕдиницыИзмерения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
	КонецЕсли;
	
	// Обойдем пакет с группами номенклатуры.
	Если НЕ РезультатЗапроса[КоличествоПакетов-2 + ДельтаПакетов].Пустой() Тогда
		
		Если Параметры.ТипВыгружаемойИерархии = 0 Тогда
			
			Выборка = РезультатЗапроса[КоличествоПакетов-2 + ДельтаПакетов].Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Ссылка) И Выборка.ЭтоГруппа Тогда
					НоваяСтрока = ТаблицаГруппТоваров.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			ТаблицаИерархииМеню = Новый ТаблицаЗначений;
			ТаблицаИерархииМеню.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.питМеню"));
			ТаблицаИерархииМеню.Колонки.Добавить("ЭтоГруппа");
			
			Выборка = РезультатЗапроса[КоличествоПакетов-2 + ДельтаПакетов].Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Ссылка) И Выборка.ЭтоГруппа Тогда
					НоваяСтрока = ТаблицаИерархииМеню.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				КонецЕсли;
			КонецЦикла;
			
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ИерархияМеню.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТ_ИерархияМеню
			|ИЗ
			|	&ТаблицаИерархииМеню КАК ИерархияМеню
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПрайсЛист.Ссылка КАК Ссылка,
			|	ПрайсЛист.Наименование КАК Наименование,
			|	ПрайсЛист.Код КАК Код,
			|	ПрайсЛист.ЭтоГруппа КАК ЭтоГруппа,
			|	ВЫБОР
			|		КОГДА ПрайсЛист.Родитель = ЗНАЧЕНИЕ(Справочник.питМеню.ПустаяСсылка)
			|			ТОГДА ПрайсЛист.Владелец
			|		ИНАЧЕ ПрайсЛист.Родитель
			|	КОНЕЦ КАК Родитель
			|ИЗ
			|	ВТ_ИерархияМеню КАК ВТ_СписокНоменклатуры
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питМеню КАК ПрайсЛист
			|		ПО ВТ_СписокНоменклатуры.Ссылка = ПрайсЛист.Ссылка";
			
			Запрос.УстановитьПараметр("ТаблицаИерархииМеню", ТаблицаИерархииМеню);
			РезультатЗапросаПоИерархии = Запрос.Выполнить();
			Если НЕ РезультатЗапросаПоИерархии.Пустой() Тогда
				Выборка = РезультатЗапросаПоИерархии.Выбрать();
				Пока Выборка.Следующий() Цикл
					Если ЗначениеЗаполнено(Выборка.Ссылка) И Выборка.ЭтоГруппа Тогда
						НоваяСтрока = ТаблицаГруппТоваров.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.ТипВыгружаемойИерархии = 1 
		И НЕ РезультатЗапроса[КоличествоПакетов - 1 + ДельтаПакетов].Пустой() Тогда
		Выборка = РезультатЗапроса[КоличествоПакетов - 1 + ДельтаПакетов].Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
				НоваяСтрока = ТаблицаГруппТоваров.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результаты = Новый Структура();
	Результаты.Вставить("ТаблицаТовары",           ТаблицаТовары);
	Результаты.Вставить("ТаблицаШтрихкоды",        ТаблицаШтрихкоды);
	Результаты.Вставить("ТаблицаЕдиницыИзмерения", ТаблицаЕдиницыИзмерения);
	Результаты.Вставить("ТаблицаГруппТоваров",     ТаблицаГруппТоваров);

	Возврат Результаты;
КонецФункции

#КонецОбласти

#Область ПроцедурыФункцииЗагрузкиДанных
// Процедура вызывается при загрузке отчета о розничных продажах с устройства.
//  Выполняет запись информации в узел плана обмена. Создает отчет о розничных продажах.
//
// Параметры:
//  ОфлайнОборудование	 - Произвольный	 - Офлайн оборудование.
//  ДанныеОПродажах		 - Произвольный	 - Данные о продажах.
//  Отказ				 - Булево		 - Отказ.
//  СообщениеОбОшибке	 - Произвольный	 - Сообщение об ошибке.
// 
// Возвращаемое значение:
//  Произвольный - Результат обработки. 
//
Функция ПриЗагрузкеОтчетаОРозничныхПродажах(ОфлайнОборудование, ДанныеОПродажах, Отказ, СообщениеОбОшибке) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивСозданныхДокументов = Новый Массив;

	// Подготовим параметры.
	Параметры = питОбменДаннымиЭвотор.ПолучитьПараметрыУстройства(ОфлайнОборудование);
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаТоваров   = НовыйТаблицаТоваров();
	ТаблицаВозвратов = НовыйТаблицаТоваров();
	
	ТаблицаОплат = Новый ТаблицаЗначений;
	ТаблицаОплат.Колонки.Добавить("ВидОплаты", Новый ОписаниеТипов("СправочникСсылка.питВидыОплатОрганизаций"));
	ТаблицаОплат.Колонки.Добавить("Сумма",     Новый ОписаниеТипов("Число"));
	ТаблицаОплат.Колонки.Добавить("Сдача",     Новый ОписаниеТипов("Число"));
	
	СтруктураВидовОплаты = ПолучитьСтруктуруВидовОплат();
	
	ПараметрыСозданияЧеков = Новый Структура;
	
	СоздаватьНоменклатуру = Параметры.Свойство("ЗагружатьНоменклатуру") И Параметры.ЗагружатьНоменклатуру;
	Если СоздаватьНоменклатуру Тогда
		КаталогНоменклатуры = НоменклатураКаталогЭвотор();
	Иначе
		КаталогНоменклатуры = Неопределено;
	КонецЕсли;
	
	// Обойдем все отчеты о продажах
	Для Каждого ОтчетОПродажах Из ДанныеОПродажах Цикл
		
		КэшСозданныхЧеков = Новый Соответствие;
		Для Каждого ЧекиПродажи Из ОтчетОПродажах.Чеки Цикл
			
			ИдентификаторЧека = ЧекиПродажи.УникальныйИдентификатор;
			Если ЧекиПродажи.Свойство("УникальныйИдентификаторИсходный") 
				И ЗначениеЗаполнено(ЧекиПродажи.УникальныйИдентификаторИсходный) Тогда
				ИдентификаторЧека = ЧекиПродажи.УникальныйИдентификаторИсходный;
			КонецЕсли;
			
			// Чеки могут быть разделены по группам печати принтеров.
			// По умолчанию такого не происходит, но протокол поддерживает.
			// В Бэке все разделенные чеки будем рассматривать как единый чек.
			ЧекиПоПринтерам = КэшСозданныхЧеков[ИдентификаторЧека];
			Если ЧекиПоПринтерам = Неопределено Тогда
				ЧекиПоПринтерам = Новый Массив;
				КэшСозданныхЧеков[ИдентификаторЧека] = ЧекиПоПринтерам;
			КонецЕсли;	
			ТребуетсяОчищатьЧек = ЧекиПоПринтерам.Найти(ЧекиПродажи.УникальныйИдентификатор) = Неопределено;
			
			ЭтоИзвестнаяОперация = Истина;
			Если ЧекиПродажи.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств  Тогда
				ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаПродажа;
			ИначеЕсли ЧекиПродажи.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств Тогда 
				ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаВозврат;
			Иначе
				ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаНеподдерживаемаяОперация;
				ЭтоИзвестнаяОперация = Ложь;
			КонецЕсли;

			Если ТребуетсяОчищатьЧек Тогда
				ТаблицаТоваров.Очистить();
				ТаблицаВозвратов.Очистить();
				ТаблицаОплат.Очистить();
			КонецЕсли;
			
			// Перебираем товары из каждого чека
			Для Каждого СтрокаТЧ Из ЧекиПродажи.Товары Цикл
				Если НЕ ЭтоИзвестнаяОперация Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока = ТаблицаТоваров.Добавить();
				
				НоменклатураСсылка = ПолучитьСсылкуНаНоменклатуру(СтрокаТЧ.УникальныйИдентификаторНоменклатуры,
					СоздаватьНоменклатуру,
					КаталогНоменклатуры,
					СтрокаТЧ.Наименование,
					СтрокаТЧ.НаименованиеЕдиницыИзмерения,
					Параметры);
				
				НоваяСтрока.Код          = СтрокаТЧ.Код;
				НоваяСтрока.Номенклатура = НоменклатураСсылка;
				НоваяСтрока.Цена         = СтрокаТЧ.Цена;
				НоваяСтрока.Количество   = СтрокаТЧ.Количество;
				НоваяСтрока.Сумма        = СтрокаТЧ.СуммаВсего;
				НоваяСтрока.Скидка = СтрокаТЧ.Скидка;
				НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(СтрокаТЧ.СтавкаНДС);
			КонецЦикла;
			
			// Обойдем строки оплат.
			Для каждого СтрокаОплаты Из ЧекиПродажи.Оплаты Цикл
				
				Если СтрокаОплаты.СуммаНаличнойОплаты > 0
					ИЛИ СтрокаОплаты.питСдача > 0 Тогда
					НоваяСтрока = ТаблицаОплат.Добавить();
					НоваяСтрока.ВидОплаты = СтруктураВидовОплаты.Наличные;
					НоваяСтрока.Сумма = СтрокаОплаты.СуммаНаличнойОплаты;
					НоваяСтрока.Сдача = СтрокаОплаты.питСдача;
				КонецЕсли;
				
				Если СтрокаОплаты.СуммаЭлектроннойОплаты > 0 Тогда
					НоваяСтрока = ТаблицаОплат.Добавить();
					НоваяСтрока.ВидОплаты = СтруктураВидовОплаты.Электронно;
					НоваяСтрока.Сумма = СтрокаОплаты.СуммаЭлектроннойОплаты;
				КонецЕсли;
					
				Если СтрокаОплаты.СуммаВстречнымПредоставлением > 0 Тогда
					НоваяСтрока = ТаблицаОплат.Добавить();
					НоваяСтрока.ВидОплаты = СтруктураВидовОплаты.ВстречноеПредставление;
					НоваяСтрока.Сумма = СтрокаОплаты.СуммаВстречнымПредоставлением;
				КонецЕсли;
				
				Если СтрокаОплаты.СуммаПредоплатой > 0 Тогда
					НоваяСтрока = ТаблицаОплат.Добавить();
					НоваяСтрока.ВидОплаты = СтруктураВидовОплаты.Предоплата;
					НоваяСтрока.Сумма = СтрокаОплаты.СуммаПредоплатой;
				КонецЕсли;
				
				Если СтрокаОплаты.СуммаПостоплатой > 0 Тогда
					НоваяСтрока = ТаблицаОплат.Добавить();
					НоваяСтрока.ВидОплаты = СтруктураВидовОплаты.Постоплата;
					НоваяСтрока.Сумма = СтрокаОплаты.СуммаПостоплатой;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ЗначениеЗаполнено(ТаблицаОплат)
				И (ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаПродажа
				ИЛИ ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаВозврат) Тогда
				НоваяСтрока = ТаблицаОплат.Добавить();
				НоваяСтрока.ВидОплаты = СтруктураВидовОплаты.Наличные;
			КонецЕсли;
			
			// ТаблицаТоваров.Свернуть("Код, Номенклатура, Цена, Скидка", "Количество, Сумма");
			
			ТаблицаОплат.Свернуть("ВидОплаты", "Сумма, Сдача");
			
			Комментарий = СформироватьКомментарий(ОфлайнОборудование,Параметры.Префикс);
			
			ТаблицыДанных = ПолучитьСтруктуруРеквизитовЧека();
			ЗаполнитьЗначенияСвойств(ТаблицыДанных,ЧекиПродажи);
			
			ТаблицыДанных.УникальныйИдентификатор = ИдентификаторЧека;
			
			ТаблицыДанных.Дата = ЧекиПродажи.ДатаЧека;
			ТаблицыДанных.ДатаЧека = ЧекиПродажи.ДатаЧека;
			ТаблицыДанных.ДатаСмены = ОтчетОПродажах.ДатаЗакрытияСмены;
			ТаблицыДанных.ДатаЗакрытияСмены = ОтчетОПродажах.ДатаЗакрытияСмены;
			
			ТаблицыДанных.НомерСмены = ОтчетОПродажах.НомерСмены;
			ТаблицыДанных.СменаНомер = ОтчетОПродажах.НомерСмены;
			ТаблицыДанных.СменаНачало = ОтчетОПродажах.ДатаОткрытияСмены;
			ТаблицыДанных.ТипЦен = Параметры.ТипЦен;
			ТаблицыДанных.ВидОперации = ВидОперации;
			
			ТаблицыДанных.Товары = ТаблицаТоваров;
			ТаблицыДанных.Оплаты = ТаблицаОплат;
			// ТаблицыДанных.ВозвратыТоваров = ТаблицаВозвратов;
			
			
			// Заполним документ "чек общепита".
			СоздатьИЗаполнитьЧекОбщепита(МассивСозданныхДокументов, Параметры, ТаблицыДанных, Комментарий,ПараметрыСозданияЧеков);
			
			ЧекиПоПринтерам.Добавить(ЧекиПродажи.УникальныйИдентификатор);
			
		КонецЦикла;
		
		// Обойдем документы внесения и выемки денег.
		Для Каждого ДвижениеДС Из ОтчетОПродажах.ДвиженияДС Цикл
			ЭтоИзвестнаяОперация = Истина;
			Если ДвижениеДС.ТипДвижения = "Внесение" Тогда
				ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаВнесение;
			ИначеЕсли ДвижениеДС.ТипДвижения = "Выемка" Тогда 
				ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаИзъятие;
			Иначе
				ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаНеподдерживаемаяОперация;
			КонецЕсли;
			
			ТаблицаОплат.Очистить();
			
			НоваяСтрока = ТаблицаОплат.Добавить();
			НоваяСтрока.ВидОплаты = СтруктураВидовОплаты.Наличные;
			НоваяСтрока.Сумма = ДвижениеДС.Сумма;
			
			Комментарий = СформироватьКомментарий(ОфлайнОборудование, Параметры.Префикс);
			
			ТаблицыДанных = ПолучитьСтруктуруРеквизитовЧека();
			ТаблицыДанных.УникальныйИдентификатор = ДвижениеДС.УникальныйИдентификатор;
			ТаблицыДанных.НомерЧека = ДвижениеДС.Номер;
			ТаблицыДанных.Дата = ДвижениеДС.Дата;
			ТаблицыДанных.ДатаЧека = ДвижениеДС.Дата;
			ТаблицыДанных.ТипЦен = Параметры.ТипЦен;
			
			ТаблицыДанных.ВидОперации = ВидОперации;
			
			ТаблицыДанных.Оплаты = ТаблицаОплат;
			
			СоздатьИЗаполнитьЧекОбщепита(МассивСозданныхДокументов, Параметры, ТаблицыДанных, Комментарий,ПараметрыСозданияЧеков);
			
		КонецЦикла;
	КонецЦикла;
	
	УзелОбъект = Параметры.УзелИнформационнойБазы.ПолучитьОбъект();
	УзелОбъект.ДатаЗагрузки = ТекущаяДатаСеанса();
	УзелОбъект.Записать();

	
	Если МассивСозданныхДокументов.Количество() > 0 Тогда
		
		// Выполним обработку документов
		Обработки.питЗагрузкаИзДанныхПродажФронта.ЗарегистрироватьИзмененияДанныхПродажФронта(МассивСозданныхДокументов);
		
	КонецЕсли;
	
	// Проведение чеков.
	Если Константы.питВыполнятьПроведениеЧековОбщепита.Получить() 
		И ЗначениеЗаполнено(МассивСозданныхДокументов) Тогда
		
		// Параметры обернем в структуру для их передачи 
		// через механизм ДлительныеОперации.
		ПараметрыФункции = Новый Структура();
		ПараметрыФункции.Вставить("МассивВыбранныхЧеков",               МассивСозданныхДокументов);
		ПараметрыФункции.Вставить("СообщатьПрогрессВыполнения",               Ложь);

		НаименованиеФоновогоЗадания = НСтр("ru = 'Проведение чеков общепита'");
		
		ДлительныеОперации.ЗапуститьВыполнениеВФоне(
			(Новый УникальныйИдентификатор), 
			"Обработки.питПроведениеЧековОбщепита.ПровестиЧекиОбщепита", 
			ПараметрыФункции, 
			НаименованиеФоновогоЗадания);
		
	КонецЕсли;
	
	Возврат МассивСозданныхДокументов;
КонецФункции

//  Функция - При загрузке данных о вскрытиях алкогольной тары.
//
// Параметры:
//  ОфлайнОборудование - Произвольный - Офлайн оборудование.
//  ДанныеОВскрытияхТары - Произвольный - Данные о вскрытиях тары.
//  Отказ - Булево - Отказ.
//  СообщениеОбОшибке - Произвольный - Сообщение об ошибке.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПриЗагрузкеДанныхОВскрытияхАлкогольнойТары(ОфлайнОборудование, ДанныеОВскрытияхТары, Отказ, СообщениеОбОшибке) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивСозданныхДокументов = Новый Массив;

	Параметры = питОбменДаннымиЭвотор.ПолучитьПараметрыУстройства(ОфлайнОборудование);
	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаУчетАлкоголя = НовыйТаблицаУчетАлкоголя();
	
	СоздаватьНоменклатуру = Параметры.Свойство("ЗагружатьНоменклатуру") И Параметры.ЗагружатьНоменклатуру;
	Если СоздаватьНоменклатуру Тогда
		КаталогНоменклатуры = НоменклатураКаталогЭвотор();
	Иначе
		КаталогНоменклатуры = Неопределено;
	КонецЕсли;
	
	ПараметрыСозданияЧеков = Новый Структура;
	
	Для Каждого АктВскрытия Из ДанныеОВскрытияхТары Цикл
		ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя;
		ТаблицаУчетАлкоголя.Очистить();
		// Перебираем товары из каждого чека
		Для Каждого СтрокаТЧ Из АктВскрытия.Товары Цикл
			
			НоваяСтрока = ТаблицаУчетАлкоголя.Добавить();
			
			НоменклатураСсылка = ПолучитьСсылкуНаНоменклатуру(СтрокаТЧ.УникальныйИдентификаторНоменклатуры, СоздаватьНоменклатуру, КаталогНоменклатуры, СтрокаТЧ.Наименование, СтрокаТЧ.НаименованиеЕдиницыИзмерения);
			
			НоваяСтрока.Код          = СтрокаТЧ.Код;
			НоваяСтрока.Номенклатура = НоменклатураСсылка;
			НоваяСтрока.Количество   = СтрокаТЧ.Количество;
			НоваяСтрока.КодАкциза    = СтрокаТЧ.ШтрихкодАлкогольнойПродукции;
			
			
		КонецЦикла;
		
		Комментарий = СформироватьКомментарий(ОфлайнОборудование,Параметры.Префикс);
		
		ТаблицыДанных = ПолучитьСтруктуруРеквизитовЧека();
		ТаблицыДанных.УникальныйИдентификатор = АктВскрытия.УникальныйИдентификатор;
		ТаблицыДанных.НомерЧека = АктВскрытия.Номер;
		ТаблицыДанных.Дата = АктВскрытия.Дата;
		ТаблицыДанных.ДатаЧека = АктВскрытия.Дата;
		ТаблицыДанных.ВидОперации = ВидОперации;
		ТаблицыДанных.УчетАлкоголя = ТаблицаУчетАлкоголя;
		ТаблицыДанных.ТипЦен = Параметры.ТипЦен;
		
		СоздатьИЗаполнитьЧекОбщепита(МассивСозданныхДокументов, Параметры, ТаблицыДанных, Комментарий, ПараметрыСозданияЧеков);
	КонецЦикла;
	
	УзелОбъект = Параметры.УзелИнформационнойБазы.ПолучитьОбъект();
	УзелОбъект.ДатаЗагрузки = ТекущаяДатаСеанса();
	УзелОбъект.Записать();
	
	Возврат МассивСозданныхДокументов;
КонецФункции

