//  Процедура - Создать и заполнить чек общепита.
//
// Параметры:
//  МассивСозданныхДокументов - Массив - Массив созданных документов.
//  РеквизитыККМ - Произвольный - Реквизиты ккм.
//  ТаблицыДанных - Произвольный - Таблицы данных.
//  Комментарий - Строка - Комментарий.
//  ДопПараметры - Произвольный - Доп параметры.
//
Процедура СоздатьИЗаполнитьЧекОбщепита(МассивСозданныхДокументов, РеквизитыККМ, ТаблицыДанных, Комментарий = "", ДопПараметры = Неопределено )
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	Если НЕ ДопПараметры.Свойство("МестаПечати") Тогда
		ДопПараметры.Вставить("МестаПечати", Новый Соответствие);
	КонецЕсли;
	
	Если НЕ ДопПараметры.Свойство("ТаблицаНоменклатурныхПриоритетов") Тогда
		ДопПараметры.Вставить("ТаблицаНоменклатурныхПриоритетов");
	КонецЕсли;
	
	Если НЕ ДопПараметры.Свойство("КассовыйУзел") Тогда
		ДопПараметры.Вставить("КассовыйУзел");
	КонецЕсли;
		
	СтруктураПараметровДокумента = Новый Структура();
	СтруктураПараметровДокумента.Вставить("Организация", 	РеквизитыККМ.Организация);
	СтруктураПараметровДокумента.Вставить("Дата", 			ТаблицыДанных.Дата);
	СтруктураПараметровДокумента.Вставить("Подразделение",	РеквизитыККМ.Подразделение);
		
	СтруктураПараметровДокумента.Вставить("Ответственный", 	Пользователи.ТекущийПользователь());
	СтруктураПараметровДокумента.Вставить("ВидОперации", 	ТаблицыДанных.ВидОперации);
	СтруктураПараметровДокумента.Вставить("КассаККМ", 		РеквизитыККМ.КассаККМ);
	
	Если НЕ ЗначениеЗаполнено(ДопПараметры.КассовыйУзел)
		И ЗначениеЗаполнено(РеквизитыККМ.КассаККМ) Тогда
		ДопПараметры.Вставить("КассовыйУзел", РеквизитыККМ.КассовыйУзел);
	КонецЕсли;
	СтруктураПараметровДокумента.Вставить("КассовыйУзел", 		ДопПараметры.КассовыйУзел);
	
	ДополнительныеПараметрыДокумента = Новый Структура;
	ДополнительныеПараметрыДокумента.Вставить("НомерЧека", 		ТаблицыДанных.НомерЧека);
	ДополнительныеПараметрыДокумента.Вставить("ДатаЧека",		ТаблицыДанных.ДатаЧека);
	ДополнительныеПараметрыДокумента.Вставить("ДатаСмены", 		ТаблицыДанных.ДатаСмены);
	ДополнительныеПараметрыДокумента.Вставить("ДатаЗакрытияСмены", ТаблицыДанных.ДатаЗакрытияСмены);
	ДополнительныеПараметрыДокумента.Вставить("НомерСмены", 	ТаблицыДанных.НомерСмены);
	ДополнительныеПараметрыДокумента.Вставить("СуммаВключаетНДС", ТаблицыДанных.СуммаВключаетНДС);
	ДополнительныеПараметрыДокумента.Вставить("СменаНомер", 	ТаблицыДанных.СменаНомер);
	ДополнительныеПараметрыДокумента.Вставить("СменаНачало", 	ТаблицыДанных.СменаНачало);
	ДополнительныеПараметрыДокумента.Вставить("ТипЦен", 		ТаблицыДанных.ТипЦен);
	ДополнительныеПараметрыДокумента.Вставить("Комментарий", 	Комментарий);
	ДополнительныеПараметрыДокумента.Вставить("ИДПродажи", ТаблицыДанных.УникальныйИдентификаторСвязанногоДокументаККМ);
	СсылкаДокумента = ?(
		ЗначениеЗаполнено(ТаблицыДанных.УникальныйИдентификатор), 
		Документы.питДанныеПродажФронта.ПолучитьСсылку(ТаблицыДанных.УникальныйИдентификатор), 
		Документы.питДанныеПродажФронта.ПолучитьСсылку());
	
	питДанныеПродажФронтаОбъект =  СсылкаДокумента.ПолучитьОбъект();
	
	// Такого документа еще нет
	Если питДанныеПродажФронтаОбъект = Неопределено Тогда
		питДанныеПродажФронтаОбъект = Документы.питДанныеПродажФронта.СоздатьДокумент();
		питДанныеПродажФронтаОбъект.УстановитьСсылкуНового(СсылкаДокумента);
	Иначе
		питДанныеПродажФронтаОбъект.Товары.Очистить();
		питДанныеПродажФронтаОбъект.Оплаты.Очистить();
	КонецЕсли; 
	
	Если питДанныеПродажФронтаОбъект.ЭтоНовый() И ЗначениеЗаполнено(ТаблицыДанных.Дата) Тогда
		питДанныеПродажФронтаОбъект.Дата = ТаблицыДанных.Дата;
	КонецЕсли;
	
	// Заполним основными параметрами.
	ЗаполнитьЗначенияСвойств(питДанныеПродажФронтаОбъект,СтруктураПараметровДокумента);
	
	// Выполнить инициализацию по умолчанию.
	питДанныеПродажФронтаОбъект.Заполнить(СтруктураПараметровДокумента);
	
	// Дозаполним реквизиты.
	ЗаполнитьЗначенияСвойств(питДанныеПродажФронтаОбъект,ДополнительныеПараметрыДокумента);
	
	Если НЕ ЗначениеЗаполнено(питДанныеПродажФронтаОбъект.Номер)Тогда
		питДанныеПродажФронтаОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	
	ПараметрыУчетаНДСПоОрганизации = питОбменДаннымиПовтИсп.ПараметрыУчетаНДСПоОрганизации(
		РеквизитыККМ.Организация,
		ТекущаяДатаСеанса()
	);

	Если НЕ ТаблицыДанных.Товары = Неопределено Тогда
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", питДанныеПродажФронтаОбъект.СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитатьСуммуСкидки", Ложь);
		ВыборкаПоТоварам = ЗаполнитьНоменклатуру(ТаблицыДанных.Товары, Истина);
		
		Пока ВыборкаПоТоварам.Следующий() Цикл
			
			Если НЕ ВыборкаПоТоварам.Количество > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = питДанныеПродажФронтаОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоТоварам);
			
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
			НоваяСтрока.Упаковка = ВыборкаПоТоварам.ОсновнаяЕдиницаИзмерения;
			
			МестоПечати = ДопПараметры.МестаПечати[НоваяСтрока.Номенклатура];
			Если ДопПараметры.МестаПечати[НоваяСтрока.Номенклатура] = Неопределено Тогда
				МестоПечати = ПолучитьМестоПечатиДляНоменклатуры(НоваяСтрока.Номенклатура,
					ДопПараметры.КассовыйУзел,,,
					ДопПараметры.ТаблицаНоменклатурныхПриоритетов);
				ДопПараметры.МестаПечати[НоваяСтрока.Номенклатура] = МестоПечати;
				
			КонецЕсли;
			НоваяСтрока.МестоПечати = МестоПечати;
			НоваяСтрока.Цена = ?(НоваяСтрока.Количество = 0, НоваяСтрока.Сумма, НоваяСтрока.Сумма / НоваяСтрока.Количество);
			НоваяСтрока.СуммаСкидкиСтроки = ВыборкаПоТоварам.СуммаСкидкиСтроки;
			НоваяСтрока.ПроцентСкидкиСтроки = ?(ВыборкаПоТоварам.Сумма=0, 0, Окр(ВыборкаПоТоварам.СуммаСкидкиСтроки * 100 / ВыборкаПоТоварам.Сумма, 2));			
			
			НоваяСтрока.СтавкаНДС = УчетНДСУП.СтавкаНДСПоНоменклатуреИНалогообложению(
					ВыборкаПоТоварам.Номенклатура, 
					ПараметрыУчетаНДСПоОрганизации.ОсновноеНалогообложениеНДСПродажи, 
					РеквизитыККМ.Организация, 
					ТекущаяДатаСеанса()
				);
			
			// Пересчитаем Сумму НДС и Всего.
			// Пересчитаем Сумму НДС.
			СуммаСтроки = НоваяСтрока.Сумма - (НоваяСтрока.СуммаСкидкиСтроки + НоваяСтрока.СуммаСкидки);
			НоваяСтрока.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(СуммаСтроки,
				Истина,
				УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС));
		КонецЦикла;
	КонецЕсли;

	Если НЕ ТаблицыДанных.Оплаты = Неопределено Тогда
		Для Каждого Оплата ИЗ ТаблицыДанных.Оплаты Цикл
			ОплатаПлатежнойКартой = питДанныеПродажФронтаОбъект.Оплаты.Добавить();
			ОплатаПлатежнойКартой.СуммаОплаты = Оплата.Сумма;
			ОплатаПлатежнойКартой.ВидОплаты = Оплата.ВидОплаты;
			ОплатаПлатежнойКартой.Сдача = Оплата.Сдача;
			ОплатаПлатежнойКартой.Фискальный = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ТаблицыДанных.УчетАлкоголя = Неопределено Тогда
		ВыборкаПоТоварам = ЗаполнитьНоменклатуру(ТаблицыДанных.УчетАлкоголя, Ложь);
		
		Для Каждого ТекСтрока ИЗ ТаблицыДанных.УчетАлкоголя Цикл
			НоваяСтрока = питДанныеПродажФронтаОбъект.УчетАлкоголя.Добавить();
			НоваяСтрока.КодАкциза  = ТекСтрока.КодАкциза;
			НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
			НоваяСтрока.Количество = ТекСтрока.Количество;
			
			НоваяСтрока.ЕдиницаИзмерения = ВыборкаПоТоварам.ОсновнаяЕдиницаИзмерения;
			
			Если НоваяСтрока.Коэффициент = 0 Тогда
				НоваяСтрока.Коэффициент = 1;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;

	Попытка
		питДанныеПродажФронтаОбъект.ОбменДанными.Загрузка = Истина;
		питДанныеПродажФронтаОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);
		Событие = "ОбменСЭвотор";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	МассивСозданныхДокументов.Добавить(питДанныеПродажФронтаОбъект.Ссылка);

КонецПроцедуры

//  Функция - Заполнить номенклатуру.
//
// Параметры:
//  ТаблицаТоваров - ТаблицаЗначений - Таблица товаров.
//  ЭтоТаблицаТовары - ТаблицаЗначений - Это таблица товары.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ЗаполнитьНоменклатуру(ТаблицаТоваров, ЭтоТаблицаТовары)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	&ТоварыДопРеквизиты,
	|	Товары.Количество КАК Количество,
	|	Товары.СтавкаНДС КАК СтавкаНДС
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ТаблицаЗначений КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СправочникНоменклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	СУММА(Товары.Количество) КАК Количество,
	|	&ТоварыАгрДопРеквизиты,
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(СправочникНоменклатура.СтавкаНДС, ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС))
	|		ИНАЧЕ Товары.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК ОсновнаяЕдиницаИзмерения,
	|	ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки1, 1) КАК Коэффициент
	|ИЗ
	|	ВТ_Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(СправочникНоменклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)),
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)),
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)
	|		ТОГДА ЕСТЬNULL(СправочникНоменклатура.СтавкаНДС, ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС))
	|		ИНАЧЕ Товары.СтавкаНДС
	|	КОНЕЦ,
	|	ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки1, 1)";
	
	ТекстЗаменыТоварыДопРеквизиты = "";
	ТекстЗаменыТоварыАгрДопРеквизиты = "";
	
	Если ЭтоТаблицаТовары Тогда
		ТекстЗаменыТоварыДопРеквизиты = "
		|	Товары.Скидка КАК Скидка,
		|	Товары.Сумма КАК Сумма,
		|	Товары.Цена КАК Цена";
		
		ТекстЗаменыТоварыАгрДопРеквизиты = "
		|	СУММА(Товары.Цена) КАК Цена,
		|	СУММА(Товары.Сумма) КАК Сумма,
		|	СУММА(Товары.Скидка) КАК СуммаСкидкиСтроки";
		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ТоварыДопРеквизиты", ТекстЗаменыТоварыДопРеквизиты);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ТоварыАгрДопРеквизиты", ТекстЗаменыТоварыАгрДопРеквизиты);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ТекстЗапросаКоэффициентУпаковки1",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"СправочникНоменклатура.ЕдиницаИзмерения",
			"СправочникНоменклатура.Ссылка"));
	
	Запрос.УстановитьПараметр("ТаблицаЗначений", ТаблицаТоваров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
КонецФункции

//  Функция - Получить структуру реквизитов чека.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
//
Функция ПолучитьСтруктуруРеквизитовЧека()
	ТаблицыДанных = Новый Структура;
	ТаблицыДанных.Вставить("УникальныйИдентификатор", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТаблицыДанных.Вставить("УникальныйИдентификаторСвязанногоДокументаККМ", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТаблицыДанных.Вставить("НомерЧека");
	ТаблицыДанных.Вставить("Дата");
	ТаблицыДанных.Вставить("ДатаЧека");
	ТаблицыДанных.Вставить("ДатаСмены");
	ТаблицыДанных.Вставить("ДатаЗакрытияСмены");
	
	ТаблицыДанных.Вставить("НомерСмены");
	ТаблицыДанных.Вставить("СуммаВключаетНДС",Истина);
	ТаблицыДанных.Вставить("СменаНомер");
	ТаблицыДанных.Вставить("СменаНачало");
	ТаблицыДанных.Вставить("ВидОперации");
	ТаблицыДанных.Вставить("Товары");
	ТаблицыДанных.Вставить("Оплаты");
	ТаблицыДанных.Вставить("УчетАлкоголя");
	ТаблицыДанных.Вставить("ТипЦен");	
	Возврат ТаблицыДанных;
КонецФункции

//  Функция - Получить структуру видов оплат.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
//
Функция ПолучитьСтруктуруВидовОплат()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Наличные",Константы.питТипОплатыНаличные.Получить());
	ДополнительныеПараметры.Вставить("Электронно",Константы.питТипОплатыЭлектронно.Получить());
	ДополнительныеПараметры.Вставить("Предоплата",Константы.питТипОплатыПредоплата.Получить());
	ДополнительныеПараметры.Вставить("Постоплата",Константы.питТипОплатыПостоплата.Получить());
	ДополнительныеПараметры.Вставить("ВстречноеПредставление",Константы.питТипОплатыВстречноеПредоставление.Получить());
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

//  Функция - Получить ссылку на номенклатуру.
//
// Параметры:
//  ИДНоменклатуры - Произвольный - Ид номенклатуры.
//  СоздаватьНоменклатуру - Произвольный - Создавать номенклатуру.
//  КаталогНоменклатуры - Произвольный - Каталог номенклатуры.
//  НаименованиеНоменклатуры - Строка - Наименование номенклатуры.
//  НаименованиеЕдиницыИзмерения - Строка - Наименование единицы измерения.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьСсылкуНаНоменклатуру(ИДНоменклатуры,
	Знач СоздаватьНоменклатуру,
	КаталогНоменклатуры,
	НаименованиеНоменклатуры = "",
	НаименованиеЕдиницыИзмерения = "",
	ДопПараметры = Неопределено)

	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	питИДНоменклатуры = СтрЗаменить(ИДНоменклатуры, "{", "");
	питИДНоменклатуры = СтрЗаменить(питИДНоменклатуры, "}", "");
	
	Если НЕ ЗначениеЗаполнено(питИДНоменклатуры) 
		И НаименованиеНоменклатуры = НоменклатураПродажаПоСвободнойЦене().Наименование Тогда
		питИДНоменклатуры = НоменклатураПродажаПоСвободнойЦене().УникальныйИдентификатор;
		СоздаватьНоменклатуру = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(питИДНоменклатуры) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Результат = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(питИДНоменклатуры));
	Если ЗначениеЗаполнено(Результат) И ЗначениеЗаполнено(Результат.ВерсияДанных) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ СоздаватьНоменклатуру Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЭлементНоменклатуры = питОбменДанными.ПолучитьОбъектПоИД(питИДНоменклатуры,Справочники.Номенклатура,Ложь,Истина);
	ЭлементНоменклатуры.УстановитьНовыйКод();
	ЭлементНоменклатуры.Наименование = СокрЛП(НаименованиеНоменклатуры);
	ЭлементНоменклатуры.НаименованиеПолное = СокрЛП(ЭлементНоменклатуры.Наименование);
	ЭлементНоменклатуры.Родитель = КаталогНоменклатуры;
	
	Если НЕ ДопПараметры.Свойство("ВидНоменклатурыПоУмолчанию") Тогда
		ВидНоменклатурыПоУмолчанию = Справочники.ВидыНоменклатуры.ВидНоменклатурыПоУмолчанию();
		Если НЕ ЗначениеЗаполнено(ВидНоменклатурыПоУмолчанию) Тогда
			Запрос = Новый Запрос;
			ТекстЗапроса = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВидыНоменклатуры.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
			|ГДЕ
			|	ВидыНоменклатуры.ТипНоменклатуры = &ТипНоменклатуры
			|	И НЕ ВидыНоменклатуры.ПометкаУдаления";
			Запрос.УстановитьПараметр("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Товар);
			Запрос.Текст = ТекстЗапроса;
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Если Выборка.Следующий() Тогда
				ВидНоменклатурыПоУмолчанию = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		ДопПараметры.Вставить("ВидНоменклатурыПоУмолчанию", ВидНоменклатурыПоУмолчанию);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭлементНоменклатуры.ВидНоменклатуры) Тогда
		ЭлементНоменклатуры.ВидНоменклатуры = ДопПараметры.ВидНоменклатурыПоУмолчанию;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДопПараметры.ВидНоменклатурыПоУмолчанию) Тогда
		ЭлементНоменклатуры.ВидНоменклатуры = ДопПараметры.ВидНоменклатурыПоУмолчанию;
	КонецЕсли;
	
	Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(ЭлементНоменклатуры);
	
	Если НЕ ЗначениеЗаполнено(ЭлементНоменклатуры.СтавкаНДС) Тогда
		Если НЕ ДопПараметры.Свойство("СтавкаНДСПоУмолчанию") Тогда
			ТекущаяДата = ТекущаяДатаСеанса();
			Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
				Если ТекущаяДата >= '20190101' Тогда
					ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС20);
				ИначеЕсли ТекущаяДата >= '20260101' Тогда
					ТекСтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.НДС22);
				КонецЕсли;
			Иначе
				Если ТекущаяДата >= '20190101' Тогда
					ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(20);
				ИначеЕсли ТекущаяДата >= '20260101' Тогда
					ТекСтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу(22);
				КонецЕсли;
			КонецЕсли;
			ДопПараметры.Вставить("СтавкаНДСПоУмолчанию", ТекСтавкаНДС);
		КонецЕсли;
		ЭлементНоменклатуры.СтавкаНДС = ДопПараметры.СтавкаНДСПоУмолчанию;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭлементНоменклатуры.питВидНоменклатуры) Тогда
		ЭлементНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭлементНоменклатуры.ТипНоменклатуры) Тогда
		ТипНоменклатуры = Неопределено;
		Если ЭлементНоменклатуры.ВидНоменклатуры = ДопПараметры.ВидНоменклатурыПоУмолчанию
			И НЕ ДопПараметры.Свойство("ТипНоменклатурыПоУмолчанию") Тогда
			ТипНоменклатурыПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементНоменклатуры.ВидНоменклатуры, "ТипНоменклатуры");
			ДопПараметры.Вставить("ТипНоменклатурыПоУмолчанию", ТипНоменклатурыПоУмолчанию);
			ТипНоменклатуры = ТипНоменклатурыПоУмолчанию;
		ИначеЕсли ЭлементНоменклатуры.ВидНоменклатуры = ДопПараметры.ВидНоменклатурыПоУмолчанию Тогда
			ТипНоменклатуры = ДопПараметры.ТипНоменклатурыПоУмолчанию;
		ИначеЕсли ЗначениеЗаполнено(ЭлементНоменклатуры.ВидНоменклатуры) Тогда
			ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементНоменклатуры.ВидНоменклатуры, "ТипНоменклатуры");
		КонецЕсли;
		ЭлементНоменклатуры.ТипНоменклатуры = ТипНоменклатуры;
	КонецЕсли;
	
	ЭлементНоменклатуры.ОбменДанными.Загрузка = Истина;
	
	Попытка
		ЭлементНоменклатуры.Записать();
		Результат = ЭлементНоменклатуры.Ссылка;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);
		Событие = "Обмен с Эвотор";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

//  Функция - Номенклатура каталог эвотор.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоменклатураКаталогЭвотор()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СлужебныйКаталогНоменклатуры());
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			КаталогНоменклатуры = Выборка.Ссылка;
		КонецЦикла;
	Иначе
		КаталогНоменклатурыОбъект = Справочники.Номенклатура.СоздатьГруппу();
		КаталогНоменклатурыОбъект.УстановитьСсылкуНового(СлужебныйКаталогНоменклатуры());
		КаталогНоменклатурыОбъект.Наименование = НСтр("ru='Служебный каталог Эвотор'", "ru");
		КаталогНоменклатурыОбъект.ОбменДанными.Загрузка = Истина;
		Попытка
			КаталогНоменклатурыОбъект.Записать();
			КаталогНоменклатуры = КаталогНоменклатурыОбъект.Ссылка;
		Исключение
			КаталогНоменклатуры = Справочники.Номенклатура.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	Возврат КаталогНоменклатуры;
КонецФункции

//  Функция - Номенклатура продажа по свободной цене.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоменклатураПродажаПоСвободнойЦене()
	Результат = Новый Структура;
	Результат.Вставить("Наименование","Позиция по свободной цене");
	Результат.Вставить("УникальныйИдентификатор", "3789d8b5-313c-4461-8320-d624cad36812");
	
	Возврат Результат;
КонецФункции


// Функция осуществляет поиск в Кэше маршрутизации печати ближайшего унаследованного
//  места печати для номенклатуры для заданного зала.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  КассовыйУзел - Произвольный - Кассовый узел.
//  Зал - Произвольный - Зал.
//  ВидМеню - Произвольный - Вид меню.
//  ТаблицаНоменклатурныхПриоритетов - ТаблицаЗначений - Таблица номенклатурных приоритетов.
//
// Возвращаемое значение:
//  УнаследованноеМестоПечати - Строка. Полученное место печати.
Функция ПолучитьМестоПечатиДляНоменклатуры(Номенклатура, КассовыйУзел, Зал = Неопределено, ВидМеню = Неопределено, ТаблицаНоменклатурныхПриоритетов = Неопределено)
	
	Если ТаблицаНоменклатурныхПриоритетов = Неопределено Тогда
		// ДЛя определения места продажи проинициализируем таблицу номенклатурных приоритетов
		ТаблицаНоменклатурныхПриоритетов = ПолучитьТаблицуНоменклатурныхПриоритетов();
	КонецЕсли;

	УнаследованноеМестоПечати = Справочники.питМестаПечати.ПустаяСсылка();
	
	// Номенклатуру необходимо преобразовать в список, куда войдет она сама и все ее родители.
	СписокНоменклатура = питОбменДанными.ПолучитьВсехВышестоящихРодителейСправочника(Номенклатура,"Номенклатура");
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНоменклатурныхПриоритетов.Ссылка,
	|	ТаблицаНоменклатурныхПриоритетов.Приоритет
	|ПОМЕСТИТЬ ТЗНомПриоритетов
	|ИЗ
	|	&ТаблицаНоменклатурныхПриоритетов КАК ТаблицаНоменклатурныхПриоритетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОпределениеПриоритетов.Принтер,
	|	ОпределениеПриоритетов.ПриоритетНоменклатура + ОпределениеПриоритетов.ПриоритетВидМеню + ОпределениеПриоритетов.ПриоритетЗал КАК ПриоритетСумма,
	|	ОпределениеПриоритетов.ПриоритетНоменклатура КАК ПриоритетНоменклатура,
	|	ОпределениеПриоритетов.ПриоритетВидМеню КАК ПриоритетВидМеню,
	|	ОпределениеПриоритетов.ПриоритетЗал КАК ПриоритетЗал
	|ИЗ
	|	(ВЫБРАТЬ
	|		МаршрутизацияПечати.Номенклатура КАК Номенклатура,
	|		МаршрутизацияПечати.МестоПечати КАК Принтер,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.Номенклатура.ЭтоГруппа
	|				ТОГДА ТЗНомПриоритетов.Приоритет
	|			ИНАЧЕ ТЗНомПриоритетов.Приоритет + 1
	|		КОНЕЦ КАК ПриоритетНоменклатура,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.ВидМеню = &ПустойВидМеню
	|				ТОГДА 1
	|			ИНАЧЕ 2
	|		КОНЕЦ КАК ПриоритетВидМеню,
	|		ВЫБОР
	|			КОГДА МаршрутизацияПечати.Зал = &ПустойЗал
	|				ТОГДА 1
	|			ИНАЧЕ 2
	|		КОНЕЦ КАК ПриоритетЗал
	|	ИЗ
	|		РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
	|			ЛЕВОЕ СОЕДИНЕНИЕ ТЗНомПриоритетов КАК ТЗНомПриоритетов
	|			ПО (ВЫБОР
	|					КОГДА МаршрутизацияПечати.Номенклатура.ЭтоГруппа
	|						ТОГДА МаршрутизацияПечати.Номенклатура = ТЗНомПриоритетов.Ссылка
	|					ИНАЧЕ МаршрутизацияПечати.Номенклатура.Родитель = ТЗНомПриоритетов.Ссылка
	|				КОНЕЦ)
	|	ГДЕ
	|		(МаршрутизацияПечати.Номенклатура В (&Номенклатура)
	|				ИЛИ МаршрутизацияПечати.Номенклатура = &ПустаяНоменклатура)
	|		И (МаршрутизацияПечати.ВидМеню = &ВидМеню ИЛИ &ВидМеню = НЕОПРЕДЕЛЕНО
	|				ИЛИ МаршрутизацияПечати.ВидМеню = &ПустойВидМеню)
	|		И (МаршрутизацияПечати.Зал = &Зал ИЛИ &Зал = НЕОПРЕДЕЛЕНО
	|				ИЛИ МаршрутизацияПечати.Зал = &ПустойЗал)
	|		И МаршрутизацияПечати.КассовыйУзел = &Узел) КАК ОпределениеПриоритетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетСумма УБЫВ,
	|	ПриоритетНоменклатура УБЫВ,
	|	ПриоритетВидМеню УБЫВ,
	|	ПриоритетЗал УБЫВ";
	
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатура);
	Запрос.УстановитьПараметр("ВидМеню", ВидМеню);
	Запрос.УстановитьПараметр("Зал", Зал);
	Запрос.УстановитьПараметр("Узел", КассовыйУзел);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойВидМеню", Справочники.питВидыМеню.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойЗал", Справочники.питЗалы.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТаблицаНоменклатурныхПриоритетов",ТаблицаНоменклатурныхПриоритетов);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		УнаследованноеМестоПечати = Выборка.Принтер;
	КонецЕсли;
	
	Возврат УнаследованноеМестоПечати;
	

КонецФункции // ПолучитьУнаследованноеМестоПечатиДляНоменклатуры()

// Функция - Получить таблицу номенклатурных приоритетов
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
Функция ПолучитьТаблицуНоменклатурныхПриоритетов()
	
	// Получение всех номенклатурных групп.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	0 КАК Приоритет
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа";
	
	ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
	
	ТекСтрока = ТаблицаЗначений.Добавить();
	ТекСтрока.Ссылка    = Справочники.Номенклатура.ПустаяСсылка();
	ТекСтрока.Приоритет = 0;
	
	Для Каждого ТекСтрока Из ТаблицаЗначений Цикл
		
		тмпПриоритет    = 1;
		тмпНоменклатура = ТекСтрока.Ссылка;
		
		Пока тмпНоменклатура <> Справочники.Номенклатура.ПустаяСсылка() Цикл
			тмпНоменклатура = тмпНоменклатура.Родитель;
			тмпПриоритет    = тмпПриоритет + 1;
		КонецЦикла;
		
		ТекСтрока.Приоритет = тмпПриоритет;
		
	КонецЦикла;
	
	Возврат ТаблицаЗначений;
	
КонецФункции

// Процедура - Заполнить вид продукции ис.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  ЗаписьТовар - Произвольный - Запись товар.
//  СоответствиеВидовПродукцииИСБПО - Соответствие - Соответствие видов продукции исбпо.
//
Процедура ЗаполнитьВидПродукцииИС(Номенклатура, ЗаписьТовар, СоответствиеВидовПродукцииИСБПО)
	
	ЗаписьТовар.ЭтоМаркированнаяПродукция = Истина;
	ЗаписьТовар.ВидМаркированнойПродукции = СоответствиеВидовПродукцииИСБПО[Номенклатура.ВидПродукцииИС];
	ЗаписьТовар.ТипМаркированнойПродукции = ЗаписьТовар.ВидМаркированнойПродукции;
	
	Если Номенклатура.ВидПродукцииИС = ВидПродукцииИСАлкоголь() Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Ложь;
		ЗаписьТовар.ЭтоАлкоголь = Истина;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ПивоВПотребительскихУпаковках
		И Номенклатура.ПродаетсяВРозлив Тогда
		ЗаписьТовар.ЭтоМаркированнаяПродукция = Ложь;
		ЗаписьТовар.ЭтоАлкоголь = Истина;
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.РазливноеПиво;
	ИначеЕсли Номенклатура.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.ПивоВПотребительскихУпаковках
		И НЕ Номенклатура.ПродаетсяВРозлив Тогда
		ЗаписьТовар.ВидМаркированнойПродукции = Перечисления.ВидыМаркированнойПродукцииБПО.Пиво;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область УОП

//  Функция - Сформировать комментарий.
//
// Параметры:
//  Устройство - Произвольный - Устройство.
//  Префикс - Произвольный - Префикс.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция СформироватьКомментарий(Устройство,Префикс)
	
	Комментарий = СтрШаблон(НСтр("ru = 'Загружено из %1:%2 (%3)'"), Устройство, Устройство,Префикс);
	
	Возврат Комментарий;
	
КонецФункции

//  Функция - Получить ставку ндс.
//
// Параметры:
//  СтавкаНДСККМ - Произвольный - Ставка ндсккм.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПолучитьСтавкуНДС(СтавкаНДСККМ)
	
	СоответствиеСтавокНСД = УчетНДСРФ.СоответствиеСтавокНДССтроковымЗначениям();
	
	Если СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаБезНДС() Тогда
		Возврат Справочники.СтавкиНДС.БезНДС;
	Иначе
		Возврат СоответствиеСтавокНСД.Получить(СтавкаНДСККМ);
	КонецЕсли;
	
КонецФункции

//  Функция - Получить ставку ндсккм.
//
// Параметры:
//  СтавкаНДС - Произвольный - Ставка ндс.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция удалить_ПолучитьСтавкуНДСККМ(СтавкаНДС)
	
	Если СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
		Возврат МенеджерОфлайнОборудования.СтавкаБезНДС();
	Иначе
		Возврат Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтавкаНДС, "Ставка"));
	КонецЕсли;
	
КонецФункции

// Функция - Получить ставку ндс ккм.
//
// Параметры:
//  СтавкаНДС - Произвольный - Ставка ндс.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
// 
Функция ПолучитьСтавкуНДСККМ(СтавкаНДС)
	
	СтавкаНДСПеречисление = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтавкаНДС, "ПеречислениеСтавкаНДС");
	
	Если СтавкаНДСПеречисление = Перечисления.СтавкиНДС.БезНДС Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаБезНДС();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС0 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС0();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС5 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС5();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС7 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС7();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС10 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС10();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС18 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС18();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС20 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС20();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС22 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС22();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС10_110 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС110();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС20_120 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС120();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС22_122 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС122();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС5_105 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС105();
		
	ИначеЕсли СтавкаНДСПеречисление = Перечисления.СтавкиНДС.НДС7_107 Тогда
		
		Возврат МенеджерОфлайнОборудования.СтавкаНДС107();
		
	Иначе
		
		Возврат МенеджерОфлайнОборудования.СтавкаБезНДС();
		
	КонецЕсли;
	
КонецФункции

//  Функция - Новый таблица товаров.
