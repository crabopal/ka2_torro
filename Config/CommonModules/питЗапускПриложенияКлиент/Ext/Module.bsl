#Область ПрограммныйИнтерфейс

// Функция, вызываемая перед началом работы системы.
//
Процедура ПередНачаломРаботыСистемы() Экспорт
	
	ОбработатьПараметрыКлиентаПередНачаломРаботыСистемы();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура, вызываемая перед началом работы системы.
//
Процедура ОбработатьПараметрыКлиентаПередНачаломРаботыСистемы()
	
	Если НЕ ЗначениеЗаполнено(ПараметрЗапуска) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ПараметрЗапуска, "СформироватьИдентификаторКонфигурации") > 0 Тогда
		
		ЗавершитьРаботу = СтрНайти(ПараметрЗапуска, "СформироватьИдентификаторКонфигурацииИЗакрыть") > 0;
		СохранитьИдентификаторКонфигурацииВКаталогБазы(ЗавершитьРаботу);
		
	КонецЕсли;
	
КонецПроцедуры

// Клиентская точка входа в алгоритм сохранения идентификатора конфигурации.
//
// Параметры:
//  ЗавершитьРаботу	 - Булево - Признак необходимости завершения работы приложения.
//
Процедура СохранитьИдентификаторКонфигурацииВКаталогБазы(ЗавершитьРаботу)
	
	ЭтоФайловаяБаза = СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1;
	Если Не ЭтоФайловаяБаза Тогда
		Возврат;
	КонецЕсли;
	
	// Выполним поиск начало служебного каталога.
	НачальнаяПозиция = СтрНайти(ПараметрЗапуска, "<КаталогИсходныхДанных_""");
	Если НачальнаяПозиция > 0 Тогда
		// Сместим на длину поиска.
		НачальнаяПозиция = НачальнаяПозиция+24;
		// Найдем последний символ
		КонечныйСимвол = СтрНайти(ПараметрЗапуска, """>", ,НачальнаяПозиция);
		
		КаталогРасположенияИБ = Сред(ПараметрЗапуска, НачальнаяПозиция, (КонечныйСимвол - НачальнаяПозиция));
		
	Иначе
		
		КаталогРасположенияИБ = Сред(
			СтрокаСоединенияИнформационнойБазы(),
			7,
			СтрДлина(СтрокаСоединенияИнформационнойБазы()) - 8
		);
		
	КонецЕсли;
	
	питЗапускПриложенияВызовСервера.СохранитьИдентификаторКонфигурацииВКаталогБазы(ЗавершитьРаботу, КаталогРасположенияИБ);
	
	Если ЗавершитьРаботу Тогда
		
		ПрекратитьРаботуСистемы();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

