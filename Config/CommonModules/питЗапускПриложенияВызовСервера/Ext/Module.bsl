#Область ПрограммныйИнтерфейс

// Сохраняет идентификатор базы в файл Идентификатор_Базы в каталоге информационной базы.
//  Работает только в файловом режиме.
//
// Параметры:
//  ЗавершитьРаботу	 - Булево	 - Признак необходимости закрытия программы после,
//  	возврата управления на клиент
//  Каталог			 - Строка	 - Каталог, в который будет выполнено сохранение.
//
Процедура СохранитьИдентификаторКонфигурацииВКаталогБазы(ЗавершитьРаботу, Каталог) Экспорт
	
	Файл = Каталог + ПолучитьРазделительПути() + "Идентификатор_Базы";
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ПолучитьИдентификаторКонфигурации());
	
	ДвоичныеДанные.Записать(Файл);
	
КонецПроцедуры

