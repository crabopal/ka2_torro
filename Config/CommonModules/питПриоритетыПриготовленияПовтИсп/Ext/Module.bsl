// Функция возвращает приоритет приготовления блюда.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура, которую готовим.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - Характеристика номенклатуры, которую готовим.
//  Склад - Произвольный - Склад.
//
// Возвращаемое значение:
//  Число - Найденное значение приоритета.
Функция ПриоритетПриготовленияБлюда(Номенклатура, Характеристика = Неопределено, Склад = Неопределено) Экспорт
	
	Возврат питПриоритетыПриготовления.ПриоритетПриготовленияБлюда(Номенклатура, Характеристика, Склад);
	
КонецФункции

// Функция определяет необходимость использования приоритетов приготовления блюд.
//
// Возвращаемое значение:
//  Булево - Найденное значение.
Функция ИспользоватьПриоритетыПриготовления() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.питИспользоватьПриоритетыПриготовления.Получить();
	
КонецФункции

// Функция - Максимальный приоритет приготовления.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция МаксимальныйПриоритетПриготовления() Экспорт
	Возврат 999999;
КонецФункции

