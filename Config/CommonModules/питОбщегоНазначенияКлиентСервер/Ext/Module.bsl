// Отображает информацию о характеристике номенклатуры как подсказку.
//
// Параметры:
//  ПолеВводаХарактеристики - ПолеФормы - поле формы, содержащее информацию.
//  ХарактеристикиИспользуются - Произвольный - Характеристики используются.
//
Процедура ОтобразитьИнформациюОХарактеристике(ПолеВводаХарактеристики, ХарактеристикиИспользуются) Экспорт
	
	Если ХарактеристикиИспользуются Тогда
		ПолеВводаХарактеристики.Отметканезаполненного = Ложь;
		ПолеВводаХарактеристики.Автоотметканезаполненного = Ложь;
		ПолеВводаХарактеристики.ПодсказкаВвода = "<Любая характеристика>";
		ПолеВводаХарактеристики.ТолькоПросмотр = Ложь;
	Иначе
		ПолеВводаХарактеристики.ПодсказкаВвода = "<Характеристики не используются>";
		ПолеВводаХарактеристики.Отметканезаполненного = Ложь;
		ПолеВводаХарактеристики.Автоотметканезаполненного = Ложь;
		ПолеВводаХарактеристики.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСЧислами

// Функция - Rgb hex.
//
// Параметры:
//  Red - Произвольный - red.
//  Green - Произвольный - green.
//  Blue - Произвольный - blue.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция RGB_HEX(Знач Red, Знач Green, Знач Blue) Экспорт
	
	// Пример для 255, 255, 255
	
	// 00000001 00000000 00000000 00000000
	СтаршийРазряд = ПобитовыйСдвигВлево(1, 24);
	
	// Красный
	// 00000000 11111111 00000000 00000000
	RedDec = ПобитовыйСдвигВлево(Red, 16);
	// Зеленый
	// 00000000 00000000 11111111 00000000 
	GreenDec = ПобитовыйСдвигВлево(Green, 8);
	// Синий остается как есть
	// 00000000 00000000 00000000 11111111
	
	// Дальше все складываем:
	// 00000001 00000000 00000000 00000000 +
	// 00000000 11111111 00000000 00000000 +
	// 00000000 00000000 11111111 00000000 +
	// 00000000 00000000 00000000 11111111 =
	// 00000001 11111111 11111111 11111111
	РезультатDec = ПобитовоеИли(ПобитовоеИли(ПобитовоеИли(СтаршийРазряд, RedDec), GreenDec), Blue);
	
	// Перевод в 16ричную систему и убираем старший разряд функцией Сред
	// 1 FF FF FF
	РезультатHex = "#" + Сред(DecToAny(РезультатDec, 16), 2);
	
	Возврат РезультатHex;
	
КонецФункции

// Функция - Hex rgb.
//
// Параметры:
//  Hex - Произвольный - Знач hex.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция HEX_RGB(Знач Hex) Экспорт
	
	Попытка
		RED		= ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(HEX, 2, 2));
		GREEN	= ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(HEX, 4, 2));
		BLUE	= ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(HEX, 6, 2));
	Исключение
		RED		= 255;
		GREEN	= 255;
		BLUE	= 255;
	КонецПопытки;
	
	RGB		= Строка(RED) + ", " + Строка(GREEN) + ", " + Строка(BLUE);
	
	Возврат Новый Структура("Строка, Красный, Зеленый, Синий", RGB, RED, GREEN, BLUE);
	
КонецФункции

// Функция - Dec to any.
//
// Параметры:
//  тЗначение - Произвольный - Значение.
//  тОснование - Произвольный - Основание.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция DecToAny(Знач тЗначение, тОснование) Экспорт
	
	тРезультат = "";
	
	Пока тЗначение > 0 Цикл
		тРезультат = Сред("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", тЗначение%тОснование + 1, 1) + тРезультат;
		тЗначение = Цел(тЗначение/тОснование) ;
	КонецЦикла;
	
	Возврат тРезультат;
	
КонецФункции

#КонецОбласти

#Область Бухгалтерия

// Оставлена для совместимости. Следует использовать БухгалтерскиеОтчеты.ИмяОтчета(), ИмяОтчетаПоИмениФормы().
//  Возвращает имя объекта метаданных, которому принадлежит форма.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма объекта.
//
// Возвращаемое значение:
// 	Строка - Имя объекта метаданных.
Функция ПолучитьИдентификаторОбъекта(Форма) Экспорт
	
	Возврат ИмяОтчетаПоИмениФормы(Форма);
	
КонецФункции

// Возвращает наименование фонового задания для выполнения отчета.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма отчета.
//  ИмяОтчета - Произвольный - Имя отчета.
//
// Возвращаемое значение:
// 	Строка - Наименование фонового задания.
Функция ПолучитьНаименованиеЗаданияВыполненияОтчета(Форма, ИмяОтчета = "") Экспорт
	
	НаименованиеЗадания = НСтр("ru = 'Выполнение отчета: %1';
								|en = 'Generating report: %1'");
	
	Если ПустаяСтрока(ИмяОтчета) Тогда
		ИмяОтчета = ИмяОтчетаПоИмениФормы(Форма);
	КонецЕсли;
	
	НаименованиеЗадания = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НаименованиеЗадания, ИмяОтчета);
	
	Возврат НаименованиеЗадания;
	
КонецФункции

// Возвращает имя отчета (объекта метаданных), которому принадлежит форма.
//  Следует использовать для форм, принадлежащих отчету.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма объекта.
//
// Возвращаемое значение:
// 	Строка       - Имя отчета (объекта метаданных).
//  Неопределено - Передана не форма отчета (например, если отчет использует общую форму).
Функция ИмяОтчетаПоИмениФормы(Форма) Экспорт
	
	ЭлементыИмени = СтрРазделить(Форма.ИмяФормы, ".");
	Если ЭлементыИмени.Количество() > 1 И ЭлементыИмени[0] = "Отчет" Тогда
		Возврат ЭлементыИмени[1];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Процедура устанавливает функциональные опции формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма, в которой требуется установить функциональные опции.
//  Организация - Произвольный - Организация.
//  Период - Дата - Дата установки периодических опций.
//
Процедура УстановитьПараметрОрганизацияФункциональныхОпцийФормы(Форма, Организация, Период = Неопределено) Экспорт

	ПараметрыФО = Новый Структура();
	ПараметрыФО.Вставить("Организация", Организация);
	Если Период <> Неопределено Тогда
		ПараметрыФО.Вставить("Период", НачалоМесяца(Период));
		// Приводим к началу месяца для того, чтобы сократить пространство кэшируемых значений.
		// Параметр "Организация" используется в функциональных опциях, привязанных к регистрам сведений с периодичностью
		// Месяц или реже.
	КонецЕсли;
	
	Форма.УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФО);
	
КонецПроцедуры

// Процедура устанавливает функциональные опции формы документа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма, в которой требуется установить функциональные опции.
//
Процедура УстановитьПараметрыФункциональныхОпцийФормыДокумента(Форма) Экспорт
	
	УстановитьПараметрОрганизацияФункциональныхОпцийФормы(Форма, Форма.Объект.Организация, Форма.Объект.Дата);
	
КонецПроцедуры

// Удаление из массива пустых элементов
//
// Параметры:
//  МассивЭлементов - Массив - Массив элементов.
//
Процедура УдалитьНеЗаполненныеЭлементыМассива(МассивЭлементов) Экспорт

	Колво = МассивЭлементов.Количество();
	Для н=1 По Колво Цикл
		Если НЕ ЗначениеЗаполнено(МассивЭлементов[Колво-н]) Тогда
			МассивЭлементов.Удалить(Колво-н);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ИзЕРП

// %ИзЕРП% ОбработкаТабличнойЧастиКлиентСервер.КоличествоССуффиксом
//  Формирует названия идентификаторов количества с суффиксом
//
// Параметры:
//  Суффикс - Произвольный - Знач суффикс.
//
// Возвращаемое значение:
// 	Структура - набор названий идентификаторов. Описание:
Функция КоличествоССуффиксом(Знач Суффикс) Экспорт
	
	СтруктураВозврата = Новый Структура("Количество, КоличествоУпаковок, КоличествоПоРНПТ");
	
	Если ТипЗнч(Суффикс) = Тип("Структура") Тогда
		Суффикс = Суффикс.Суффикс;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Суффикс) Тогда
		Суффикс = "";
	КонецЕсли;
	
	// Количество
	Если Суффикс = "Забаланс" Тогда
		СтруктураВозврата.Количество         = "";
	ИначеЕсли Суффикс = "Оприходовано" Тогда
		СтруктураВозврата.Количество         = "Количество";	
	Иначе
		СтруктураВозврата.Количество = "Количество" + Суффикс;
	КонецЕсли;
	
	// КоличествоУпаковок
	Если Суффикс = "Оприходовано" Тогда
		СтруктураВозврата.КоличествоУпаковок = "КоличествоОприходование";
	Иначе
		СтруктураВозврата.КоличествоУпаковок = "КоличествоУпаковок"  + Суффикс;
	КонецЕсли;
	
	// КоличествоПоРНПТ
	Если ПустаяСтрока(Суффикс) 
		ИЛИ Суффикс = "После" Тогда
		СтруктураВозврата.КоличествоПоРНПТ = "КоличествоПоРНПТ" + Суффикс;
	Иначе
		СтруктураВозврата.КоличествоПоРНПТ = "";
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти

// Процедура выполняет проверку переданного значения на заполненность.
//  Процедура является оберткой стандартного метода "ЗначениеЗаполнено",
//  которая при проверке мутабельного значения вызовет исключение.
//
// Параметры:
//  Значение -  - проверяемое значение.
//
// Возвращаемое значение:
//  Результат - проверки
Функция питЗначениеЗаполнено(Значение) Экспорт
	Попытка
		Возврат ЗначениеЗаполнено(Значение);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Устанавливает или изменяет "быстрый" отбор динамического списка (по значениям отбора, указанным в реквизитах формы)
//
// Параметры:
//  Форма - УправляемаяФорма - форма, у которой есть реквизит динамический список с именем Список.
//  ИмяПоля - Строка - имя отбора, у формы должны быть реквизиты с именами Отбор<ИмяПоля> и Отбор<ИмяПоля> Использования.
//  ВидСравнения - Произвольный - Вид сравнения.
//
Процедура УстановитьБыстрыйОтбор(Форма, ИмяПоля, ВидСравнения = Неопределено) Экспорт
	
	ПравоеЗначение = Форма["Отбор" + ИмяПоля];
	Использование  = Форма["Отбор" + ИмяПоля + "Использование"];
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(
	Форма.Список.КомпоновщикНастроек.Настройки.Отбор, 
	ИмяПоля);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
	Форма.Список.КомпоновщикНастроек.Настройки.Отбор,
	ИмяПоля,
	ПравоеЗначение,
	ВидСравнения,
	,
	Использование);
	
КонецПроцедуры

// Возвращает элемент пользовательского отбора динамического списка,
//  соответствующий отбору, заданному в конфигураторе с указанным именем.
//  Соответствие определяется по совпадению идентификаторов настройки.
//  Параметры
//
// Параметры:
//  Список - ДинамическийСписок - динамический список, для которого ищется элемент отбор.
//  ИмяОтбора - Строка - имя отбора, заданное в конфигураторе для элемента настроек динамического списка.
//
// Возвращаемое значение:
// 	ЭлементОтбораКомпоновкиДанных - найденный элемент пользовательского отбора
//  Неопределено - если элемент пользовательского отбора не найден
Функция ЭлементОтбораСпискаПоИмени(Список, ИмяОтбора) Экспорт
	
	Отборы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(
	Список.КомпоновщикНастроек.Настройки.Отбор, 
	ИмяОтбора);
	
	Если Отборы.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат Отборы[0];
	КонецЕсли;
	
КонецФункции

// Функция возвращает текст надписи "Цены и валюта".
//
// Параметры:
//  СтруктураНадписи - Структура - Структура надписи.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СформироватьНадписьЦеныИВалюта(СтруктураНадписи) Экспорт
	Перем ВалютаРегламентированногоУчета;
	
	ТекстНадписи = "";
	
	Если НЕ СтруктураНадписи.Свойство("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета) Тогда
		ВалютаРегламентированногоУчета = питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	КонецЕсли;
	
	// Тип цен
	Если СтруктураНадписи.Свойство("ТипЦен")
		И ЗначениеЗаполнено(СтруктураНадписи.ТипЦен) Тогда
		ТекстНадписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Тип цен: %1 '"), СтруктураНадписи.ТипЦен);
	КонецЕсли;
		
	// НДС в сумме
	Если СтруктураНадписи.Свойство("НДСНеВыделять") 
		И СтруктураНадписи.НДСНеВыделять Тогда 
		ТекстНадписи = ТекстНадписи + ?(ПустаяСтрока(ТекстНадписи), НСтр("ru = 'НДС не выделять'"), НСтр("ru = '(НДС не выделять)'"));
	ИначеЕсли СтруктураНадписи.Свойство("ДокументБезНДС") 
		И СтруктураНадписи.ДокументБезНДС Тогда 
		ТекстНадписи = ТекстНадписи + ?(ПустаяСтрока(ТекстНадписи), НСтр("ru = 'Документ без НДС'"), НСтр("ru = '(Документ без НДС)'"));
	ИначеЕсли СтруктураНадписи.Свойство("СуммаВключаетНДС") Тогда
		Если СтруктураНадписи.СуммаВключаетНДС Тогда
			ТекстНадписи = ТекстНадписи + ?(ПустаяСтрока(ТекстНадписи), НСтр("ru = 'НДС в сумме'"), НСтр("ru = '(НДС в сумме)'")); 
		Иначе
			ТекстНадписи = ТекстНадписи + ?(ПустаяСтрока(ТекстНадписи), НСтр("ru = 'НДС сверху'"), НСтр("ru = '(НДС сверху)'")); 
		КонецЕсли;
	КонецЕсли;

	// Валюта
	Если СтруктураНадписи.Свойство("ВалютаДокумента")
		И ЗначениеЗаполнено(СтруктураНадписи.ВалютаДокумента)
		И (СтруктураНадписи.ВалютаДокумента <> ВалютаРегламентированногоУчета) Тогда
		
		ТекстНадписи = ТекстНадписи + ?(ПустаяСтрока(ТекстНадписи), "", ", ") + НСтр("ru = '%1%2 = %3 %4'");
		ТекстНадписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ТекстНадписи,
			?(СтруктураНадписи.Кратность = 1, "", СтруктураНадписи.Кратность),
			СтруктураНадписи.ВалютаДокумента,
			СтруктураНадписи.Курс,
			ВалютаРегламентированногоУчета);
			
	КонецЕсли;
		
	БезНДС = (СтруктураНадписи.Свойство("ДокументБезНДС") И СтруктураНадписи.ДокументБезНДС)
			ИЛИ  СтруктураНадписи.Свойство("НДСНеВыделять") И СтруктураНадписи.НДСНеВыделять;

	// Включение НДС в стоимость
	Если СтруктураНадписи.Свойство("НДСВключенВСтоимость") И НЕ БезНДС Тогда
		Если СтруктураНадписи.НДСВключенВСтоимость Тогда
			ТекстНадписи = ТекстНадписи + ?(ПустаяСтрока(ТекстНадписи), "", ", ") + НСтр("ru = 'НДС включен в стоимость'"); 
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстНадписи) Тогда 
		Если СтруктураНадписи.Свойство("ТипЦен") Тогда
			ТекстНадписи = НСтр("ru = 'Тип цен: <нет> '");
		ИначеЕсли СтруктураНадписи.Свойство("ВалютаДокумента") Тогда
			Если ЗначениеЗаполнено(СтруктураНадписи.ВалютаДокумента) Тогда
				ТекстНадписи = НСтр("ru = 'Валюта: %1'");
				ТекстНадписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстНадписи, ВалютаРегламентированногоУчета);
			Иначе
				ТекстНадписи = НСтр("ru = 'Валюта: <нет> '");
			КонецЕсли;
		ИначеЕсли СтруктураНадписи.Свойство("НДСВключенВСтоимость")
			И НЕ БезНДС Тогда
			ТекстНадписи = НСтр("ru = 'НДС не включен в стоимость'");
		КонецЕсли;
	КонецЕсли;
		
	Возврат ТекстНадписи;

КонецФункции

// Рассчитывает сумму в строке табличной части документа
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//  ЗначениеПустогоКоличества - Произвольный - Значение пустого количества.
//  ИмяКоличества - Произвольный - Имя количества.
//
Процедура РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, ЗначениеПустогоКоличества = 0, ИмяКоличества = "Количество") Экспорт
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * ?(СтрокаТабличнойЧасти[ИмяКоличества] = 0, ЗначениеПустогоКоличества, СтрокаТабличнойЧасти[ИмяКоличества]);
	
КонецПроцедуры

// Расчет, исходя из постоянной суммы
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//  СуммаВключаетНДС - Произвольный - Сумма включает ндс.
//
Процедура РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, СуммаВключаетНДС = Ложь) Экспорт
	
	Если ТипЗнч(СтрокаТабличнойЧасти)=Тип("Структура") Тогда
		Если СтрокаТабличнойЧасти.Свойство("Сумма") И СтрокаТабличнойЧасти.Свойство("СтавкаНДС") Тогда
			СтрокаТабличнойЧасти.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(
												СтрокаТабличнойЧасти.Сумма - ?(СтрокаТабличнойЧасти.Свойство("СуммаСкидки"), СтрокаТабличнойЧасти.СуммаСкидки, 0),
												СтрокаТабличнойЧасти.СтавкаНДС,
												СуммаВключаетНДС);
		КонецЕсли;
	Иначе // Строка табличной части
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС) Тогда
			СтрокаТабличнойЧасти.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(
												СтрокаТабличнойЧасти.Сумма,
												СтрокаТабличнойЧасти.СтавкаНДС,
												СуммаВключаетНДС);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает массив доступных хоз. операций рецептур для переданной номенклатуры
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Ссылка на номенклатуру.
//  ВыходныеПараметры - Произвольный - Выходные параметры.
//
// Возвращаемое значение:
//  Массив - Массив хозяйственных операций общепит.
Функция ПолучитьДоступныеВидыРецептур(Номенклатура, ВыходныеПараметры = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") 
		И ЗначениеЗаполнено(Номенклатура) Тогда
		
		ВидНоменклатуры = питОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "питВидНоменклатуры");
		
		ВыходныеПараметры = Новый Структура;
		ВыходныеПараметры.Вставить("ВидНоменклатуры", ВидНоменклатуры);
		
		Если ВидНоменклатуры = ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Блюдо") Тогда
			Результат.Добавить(ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураПриготовление"));
		ИначеЕсли ВидНоменклатуры = ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Товар") Тогда
			Результат.Добавить(ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазделка"));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// +ПараметризацияРецептур

// Функция получает суффикс колонки количеств рецептуры по виду количеств.
//
// Параметры:
//  ВидКоличеств - ПеречислениеСсылка.питВидыКоличеств - Вид количеств рецептуры.
//
// Возвращаемое значение:
//  Строка - Полученный суффикс.
Функция СуффиксКолонкиКоличествПоВидуКоличеств(ВидКоличеств) Экспорт
	
	Результат = "Брутто";
	Если ВидКоличеств = ПредопределенноеЗначение("Перечисление.питВидыКоличеств.КоличествоНетто") Тогда
		Результат = "Нетто";
	ИначеЕсли ВидКоличеств = ПредопределенноеЗначение("Перечисление.питВидыКоличеств.КоличествоВыход") Тогда
		Результат = "Выход";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// -ПараметризацияРецептур

// Функция возвращает описание типов числа с переданной длиной и точностью.
//
// Параметры:
//  Длина - Число - Длина числа.
//  Точность - Число - Точность числа.
//
// Возвращаемое значение:
//  ОписаниеТипов - Описание типов.
Функция ОписаниеТиповЧисло(Длина, Точность) Экспорт
	
	КЧ = Новый КвалификаторыЧисла(Длина, Точность);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	Возврат Новый ОписаниеТипов(Массив, , ,КЧ);
	
КонецФункции

// Функция возвращает описание типов строки с переданной длиной
//
// Параметры:
//  Длина - Число - Длина строки.
//
// Возвращаемое значение:
//  ОписаниеТипов - Описание типов.
Функция ОписаниеТиповСтрока(Длина = 0) Экспорт
	
	Если Длина = 0 Тогда
		Возврат Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	КС = Новый КвалификаторыСтроки(Длина);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	Возврат Новый ОписаниеТипов(Массив, , КС);
	
КонецФункции

// Функция вычисляет модуль переданного числа.
//
// Параметры:
//  Число - Число - Число, для которого необходимо вычислить модуль.
//
// Возвращаемое значение:
//  Число - Найденное число по модулю.
Функция МодульЧисла(Число) Экспорт
	Возврат Макс(Число, -Число);
КонецФункции

// Если тип не массив, то помещает в него переданное значение.
//
// Параметры:
//  Значение - Произвольный - любое значение.
//
// Возвращаемое значение:
//  Массив - Новый массив из одного элемента или переданный массив.
Функция ЗначениеВМассив(Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	
	Возврат Массив;
	
КонецФункции

