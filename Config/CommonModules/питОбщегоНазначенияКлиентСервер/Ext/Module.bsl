// Процедура - Регламентированный отчет алко приложение26 изменить период.
//
// Параметры:
//  Форма	 - Произвольный	 - См. РегламентированныйОтчетАлкоПриложение26
//  Шаг		 - Произвольный	 - См. РегламентированныйОтчетАлкоПриложение26
//
Процедура РегламентированныйОтчетАлкоПриложение26ИзменитьПериод(Форма, Шаг) Экспорт
		
	ДатаКонцаПериодаОтчета = НачалоДня(Форма.мДатаКонцаПериодаОтчета);
	Если ДатаКонцаПериодаОтчета = Дата(2024, 12, 31) И Шаг > 0 Тогда
		Форма.мДатаКонцаПериодаОтчета  = КонецДня(Дата(2025, 01, 14));
	ИначеЕсли ДатаКонцаПериодаОтчета = Дата(2025, 01, 14) И Шаг > 0 Тогда
		Форма.мДатаКонцаПериодаОтчета  = КонецКвартала(ДобавитьМесяц(НачалоМесяца(Форма.мДатаКонцаПериодаОтчета), Шаг * 2));
	ИначеЕсли ДатаКонцаПериодаОтчета = Дата(2025, 01, 14) И Шаг < 0 Тогда
		Форма.мДатаКонцаПериодаОтчета  = НачалоМесяца(Форма.мДатаКонцаПериодаОтчета) - 1;
	ИначеЕсли ДатаКонцаПериодаОтчета = Дата(2025, 03, 31) И Шаг <= 0 Тогда
		Форма.мДатаКонцаПериодаОтчета  = КонецДня(Дата(2025, 01, 14));
	Иначе
		Форма.мДатаКонцаПериодаОтчета  = КонецКвартала(ДобавитьМесяц(Форма.мДатаКонцаПериодаОтчета, Шаг * 3));
	КонецЕсли;
	Форма.мДатаНачалаПериодаОтчета = НачалоКвартала(Форма.мДатаКонцаПериодаОтчета);
		
КонецПроцедуры

Функция ДатаСтавкиНДС22() Экспорт
	Результат = Дата(2026,1,1,0,0,0);
	Возврат Результат;
КонецФункции


// Вернуть округленное число до целой части. Независимо от режима округления.
// Например, 0.3 -> 1, 2.6 -> 3.
//
// Параметры:
//  ТекЧисло - Число - Число необходимое для преобразования.
// 
// Возвращаемое значение:
//  Число - Результат округления до целой части.
//
Функция ОкруглитьДоЦелого(ТекЧисло, Разрядность = 0) Экспорт
	Результат = Окр(ТекЧисло + ?(ТекЧисло > 0, 0.5, -0.5)/Pow(10, Разрядность), Разрядность,РежимОкругления.Окр15как10);
	Возврат Результат;
КонецФункции

