	Если НЕ ЗначениеЗаполнено(ПутьКДанным) Тогда
		ПутьКДанным = ИмяЭлемента;
	КонецЕсли;
	
	Если ПоложениеЗаголовкаЧислом = 0 Тогда
		НовоеПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ИначеЕсли ПоложениеЗаголовкаЧислом = 1 Тогда
		НовоеПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Низ;
	ИначеЕсли ПоложениеЗаголовкаЧислом = 2 Тогда
		НовоеПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	ИначеЕсли ПоложениеЗаголовкаЧислом = 3 Тогда
		НовоеПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	ИначеЕсли ПоложениеЗаголовкаЧислом = 5 Тогда
		НовоеПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Иначе
		НовоеПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	КонецЕсли;
	
	Если ВидПереключателяЧислом = 0 Тогда
		ТекВидПереключателя = ВидПереключателя.Авто;
	ИначеЕсли ВидПереключателяЧислом = 1 Тогда
		ТекВидПереключателя = ВидПереключателя.Переключатель;
	ИначеЕсли ВидПереключателяЧислом = 2 Тогда
		ТекВидПереключателя = ВидПереключателя.Тумблер;
	Иначе
		ТекВидПереключателя = ВидПереключателя.Авто;
	КонецЕсли;
	
	Если Родитель = Неопределено 
		И НЕ ЭлеменПередКоторым = Неопределено Тогда
		Родитель = ЭлеменПередКоторым.Родитель;
	КонецЕсли;
	
	ТипЭлемента = Тип("ПолеФормы");
	НовыйЭлементФормы = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);
	
	НовыйЭлементФормы.ПутьКДанным = ПутьКДанным;
	НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеПереключателя;
	НовыйЭлементФормы.Заголовок = ЗаголовокЭлемента;
	НовыйЭлементФормы.ПоложениеЗаголовка = НовоеПоложениеЗаголовка;
	НовыйЭлементФормы.ВидПереключателя = ТекВидПереключателя;
	
	Возврат НовыйЭлементФормы;
КонецФункции

#КонецОбласти

#Область РегламентныеЗадания

// Процедура - Установить параметры.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаСервере
Процедура УстановитьПараметры(Форма) Экспорт
	
	Задание = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(Форма.Идентификатор);
	
	Если ЭтоАдресВременногоХранилища(Форма.питПараметрыВХранилище) Тогда
		МассивСПараметрами = ПолучитьИзВременногоХранилища(Форма.питПараметрыВХранилище);
	Иначе
		Возврат; //Не заходили на форму настройки параметров и адрес хранилища пуст
	КонецЕсли;
	Задание.Параметры = МассивСПараметрами;
	Задание.Записать();
	
КонецПроцедуры

#КонецОбласти

// Получает данные формы дерево с модификаторами.
//
// Параметры:
//  МодификаторыДеревоФормы - ДеревоЗначений - Знач модификаторы дерево формы.
//  ТекНоменклатура - Произвольный - Тек номенклатура.
//
// Возвращаемое значение:
//     НЕТ
Функция ЗаполнитьМодификаторы(Знач МодификаторыДеревоФормы, ТекНоменклатура) Экспорт
	
	МодификаторыДерево = ДанныеФормыВЗначение(МодификаторыДеревоФормы, Тип("ДеревоЗначений"));
	МодификаторыДерево.Строки.Очистить();
			
	// Сформируем запрос с отбором по номенклатуре.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МодификаторыНоменклатуры.Модификатор КАК Модификатор,
	|	МодификаторыНоменклатуры.ГруппаМодификатора КАК ГруппаМодификатора
	|ИЗ
	|	РегистрСведений.питМодификаторыНоменклатуры КАК МодификаторыНоменклатуры
	|ГДЕ
	|	МодификаторыНоменклатуры.Номенклатура = &Номенклатура");
	
	Запрос.УстановитьПараметр("Номенклатура", ТекНоменклатура);
	
	// Очищаем ТЧ Модификаторы.
	МодификаторыДерево.Строки.Очистить();
	
	// Заполняем ТЧ модификаторы по Номенклатуре.
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаМодификатор = МодификаторыДерево.Строки.Добавить();
		СтрокаМодификатор.Модификатор = Выборка.Модификатор;
		СтрокаМодификатор.ГруппаМодификатора = Выборка.ГруппаМодификатора;
		
		Если Выборка.Модификатор.Пустая() Тогда
			ЗаполнениеЭлементовГруппыМодификатора(Выборка.ГруппаМодификатора, СтрокаМодификатор);
		КонецЕсли;
	КонецЦикла;
	
	// УНАСЛЕДОВАННЫЕ МОДИФИКАТОРЫ
	// Получим все группы этой номенклатуры.
	МассивГруппНоменклатуры = Новый Массив();
	ТекРодитель = ТекНоменклатура.Родитель;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		МассивГруппНоменклатуры.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	Если МассивГруппНоменклатуры.Количество() = 0 Тогда
		ЗначениеВДанныеФормы(МодификаторыДерево, МодификаторыДеревоФормы);
		Возврат МодификаторыДеревоФормы;
	КонецЕсли;
	
	// Соберём таблицу модификаторов.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МодификаторыНоменклатуры.Модификатор КАК Модификатор,
	|	МодификаторыНоменклатуры.ГруппаМодификатора КАК ГруппаМодификаторов,
	|	МодификаторыНоменклатуры.Номенклатура КАК ОтКогоУнаследовали
	|ИЗ
	|	РегистрСведений.питМодификаторыНоменклатуры КАК МодификаторыНоменклатуры
	|ГДЕ
	|	МодификаторыНоменклатуры.Номенклатура В(&МассивГруппНоменклатуры)");
	
	Запрос.УстановитьПараметр("МассивГруппНоменклатуры", МассивГруппНоменклатуры);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		ЗначениеВДанныеФормы(МодификаторыДерево, МодификаторыДеревоФормы);
		Возврат МодификаторыДеревоФормы;
	КонецЕсли;
	
	// Отберём группы.
	СтруктураОтбора = Новый Структура("Модификатор", Справочники.питМодификаторы.ПустаяСсылка());
	МассивГруппРезультатаЗапроса = РезультатЗапроса.НайтиСтроки(СтруктураОтбора);
	МассивГруппМодификаторов = Новый Массив;
	Для Каждого ТекущаяГруппа Из МассивГруппРезультатаЗапроса Цикл
		МассивГруппМодификаторов.Добавить(ТекущаяГруппа.ГруппаМодификаторов);
	КонецЦикла;
	
	// Для групп получим элементы.
	// Объединим таблицу элементов модификаторов и таблицу элементов групп.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РезультатЗапроса.Модификатор КАК Модификатор,
	|	РезультатЗапроса.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|	РезультатЗапроса.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|ПОМЕСТИТЬ ТаблицаЭлементовМодификаторов
	|ИЗ
	|	&РезультатЗапроса КАК РезультатЗапроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМодификаторов.Модификатор КАК Модификатор,
	|	ТаблицаМодификаторов.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|	ТаблицаМодификаторов.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕСТЬNULL(Модификаторы.Модификатор, ЗНАЧЕНИЕ(Справочник.питМодификаторы.ПустаяСсылка)) КАК Модификатор,
	|		ТаблицаЭлементовМодификаторов.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|		ТаблицаЭлементовМодификаторов.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|	ИЗ
	|		ТаблицаЭлементовМодификаторов КАК ТаблицаЭлементовМодификаторов
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питГруппыМодификаторов.Модификаторы КАК Модификаторы
	|			ПО ТаблицаЭлементовМодификаторов.ГруппаМодификаторов = Модификаторы.Ссылка
	|	ГДЕ
	|		ТаблицаЭлементовМодификаторов.Модификатор = ЗНАЧЕНИЕ(Справочник.питМодификаторы.ПустаяСсылка)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТаблицаЭлементовМодификаторов.Модификатор,
	|		ТаблицаЭлементовМодификаторов.ГруппаМодификаторов,
	|		ТаблицаЭлементовМодификаторов.ОтКогоУнаследовали
	|	ИЗ
	|		ТаблицаЭлементовМодификаторов КАК ТаблицаЭлементовМодификаторов
	|	ГДЕ
	|		ТаблицаЭлементовМодификаторов.Модификатор <> ЗНАЧЕНИЕ(Справочник.питМодификаторы.ПустаяСсылка)) КАК ТаблицаМодификаторов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаМодификаторов.Модификатор,
	|	ТаблицаМодификаторов.ГруппаМодификаторов,
	|	ТаблицаМодификаторов.ОтКогоУнаследовали
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтКогоУнаследовали,
	|	ГруппаМодификаторов
	|ИТОГИ ПО
	|	ОтКогоУнаследовали, ГруппаМодификаторов
	|";
	
	Запрос.УстановитьПараметр("РезультатЗапроса", РезультатЗапроса);
	Запрос.УстановитьПараметр("МассивГруппМодификаторов", МассивГруппМодификаторов);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Пока Выборка.Следующий() Цикл
		
		ВыборкаГруппы =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		Пока ВыборкаГруппы.Следующий() Цикл
			
			СтрокаМодификатор = МодификаторыДерево.Строки.Добавить();
			СтрокаМодификатор.ГруппаМодификатора = ВыборкаГруппы.ГруппаМодификаторов;
			СтрокаМодификатор.ОтКогоУнаследовали = ВыборкаГруппы.ОтКогоУнаследовали;
			
			ВыборкаЭлементы = ВыборкаГруппы.Выбрать(ОбходРезультатаЗапроса.Прямой);
			Пока ВыборкаЭлементы.Следующий() Цикл
				Если НЕ ЗначениеЗаполнено(ВыборкаЭлементы.Модификатор) Тогда
					Продолжить;
				КонецЕсли; 
				СтрокаМодификаторЭлемент = СтрокаМодификатор.Строки.Добавить();
				СтрокаМодификаторЭлемент.Модификатор = ВыборкаЭлементы.Модификатор;
				СтрокаМодификаторЭлемент.ОтКогоУнаследовали = ВыборкаЭлементы.ОтКогоУнаследовали;
				ТекОтКогоУнаследовали = ВыборкаЭлементы.ОтКогоУнаследовали;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВДанныеФормы(МодификаторыДерево, МодификаторыДеревоФормы);
	Возврат МодификаторыДеревоФормы;
	
КонецФункции // ЗаполнитьМодификаторы()

// Процедура дополняет параметры формы.
//
// Параметры:
//  ПараметрыФормы - Структура - Параметры формы.
//  питНаименованиеУсловия - Произвольный - пит наименование условия.
//  ИмяТЧ - Строка - Имя табличной части, к которой относится текущая форма отбора по свойствам.
//
Процедура ДополнитьПараметрыФормыОтбораПоСвойствам(ПараметрыФормы, питНаименованиеУсловия, ИмяТЧ) Экспорт
	
	Если ИмяТЧ = "Ингредиенты" Тогда
		ПараметрыФормы.Вставить("питНаименованиеУсловия", питНаименованиеУсловия);
	КонецЕсли;
	
КонецПроцедуры

// Процедура дополняет коллекцию команд создания на основании в типовых документах.
//
// Параметры:
//  КомандыСозданияНаОсновании - Произвольный - Команды создания на основании.
//  Параметры - Произвольный - Параметры.
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	ИмяДокументаВнутреннееПотребление = питОбратнаяСовместимостьПовтИсп.ИмяДокументаВнутреннееПотребление();
	
	Если СтрНачинаетсяС(Параметры.ИмяФормы, "Документ.РеализацияТоваровУслуг")
		ИЛИ СтрНачинаетсяС(Параметры.ИмяФормы, СтрШаблон("Документ.%1", ИмяДокументаВнутреннееПотребление))
		ИЛИ СтрНачинаетсяС(Параметры.ИмяФормы, "Документ.ВозвратТоваровОтКлиента")
		ИЛИ СтрНачинаетсяС(Параметры.ИмяФормы, "Документ.ОтчетОРозничныхПродажах")
		ИЛИ СтрНачинаетсяС(Параметры.ИмяФормы, "Документ.ДвижениеПродукцииИМатериалов")
		ИЛИ СтрНачинаетсяС(Параметры.ИмяФормы, "Документ.ПеремещениеТоваров") 
		ИЛИ СтрНачинаетсяС(Параметры.ИмяФормы, "Обработка.ЖурналДокументовВнутреннегоТовародвижения.Форма.СписокДокументов") Тогда
		
		Документы.питВыпускБлюд.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, "Записывать");
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из соответствующего обработчика документа
//
// Параметры:
//  Объект - ДокументОбъект - Обрабатываемый объект.
//  Отказ - Булево - Если в теле процедуры-обработчика установить данному параметру значение Истина,
//   то будет выполнен отказ от продолжения работы после выполнения проверки заполнения.
//  МассивНепроверяемыхРеквизитов - Массив - Массив непроверяемых реквизитов.
//  ПроверяемыеРеквизиты - Массив - Массив путей к реквизитам, для которых будет выполнена проверка заполнения.
//
Процедура ОбработкаПроверкиЗаполнения(Объект, Отказ, МассивНепроверяемыхРеквизитов, ПроверяемыеРеквизиты) Экспорт
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.РеализацияТоваровУслуг")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ОтчетОРозничныхПродажах") Тогда
		
		Если МассивНепроверяемыхРеквизитов.Найти("Товары.Цена") = Неопределено Тогда
			МассивНепроверяемыхРеквизитов.Добавить("Товары.Цена");
		КонецЕсли;
		Если МассивНепроверяемыхРеквизитов.Найти("Товары.Сумма") = Неопределено Тогда
			МассивНепроверяемыхРеквизитов.Добавить("Товары.Сумма");
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ОтчетЕГАИС") Тогда
		
		Если Объект.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл Тогда
			
			МассивНепроверяемыхРеквизитов.Удалить(МассивНепроверяемыхРеквизитов.Найти("АлкогольнаяПродукция"));
			МассивНепроверяемыхРеквизитов.Удалить(МассивНепроверяемыхРеквизитов.Найти("Справка2"));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// %ИзЕРП% ПродажиСервер.ПроверитьКорректностьЗаполненияДокументаПродажи
//
// Параметры:
//  ИмяТаблицы - Строка - Имя таблицы, заполнение которой проверяем.
//  МассивПроверок - Массив - Массив проверок, сформированных в типовой функции.
//
Процедура ИзменитьМассивПроверокКорректностиЗаполненияДокументовПродажи(ИмяТаблицы, МассивПроверок) Экспорт
	
	Если ИмяТаблицы = "Документ.РеализацияТоваровУслуг"  Тогда
		ИндексКонтроляЦен = МассивПроверок.Найти("КонтрольЗаполненияЦен");
		Если НЕ ИндексКонтроляЦен = Неопределено Тогда
			МассивПроверок.Удалить(ИндексКонтроляЦен);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

