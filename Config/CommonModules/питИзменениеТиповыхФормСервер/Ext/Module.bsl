// Функция - Новая гипер ссылка.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ИмяКоманды - Произвольный - Имя команды.
//  ЗаголовокЭлемента - Произвольный - Заголовок элемента.
//  ШиринаКнопки - Произвольный - Ширина кнопки.
//  ВысотаКнопки - Произвольный - Высота кнопки.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоваяГиперСсылка(Элементы, ИмяЭлемента, Родитель, ИмяКоманды = "", ЗаголовокЭлемента = "", 
	ШиринаКнопки = 0, ВысотаКнопки = 0,
