// Функция - Новая обычная группа.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ЗаголовокЭлемента - Произвольный - Заголовок элемента.
//  ГруппировкаВертикальная - Произвольный - Группировка вертикальная.
//  РастягиватьПоГоризонтали - Произвольный - Растягивать по горизонтали.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоваяОбычнаяГруппа(Элементы, ИмяЭлемента, Родитель, ЗаголовокЭлемента = "", 
	ГруппировкаВертикальная = Истина, РастягиватьПоГоризонтали = Истина,
	ЭлеменПередКоторым = Неопределено) Экспорт
	
	Если ГруппировкаВертикальная Тогда
		ТипГруппировки = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Иначе
		ТипГруппировки = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КонецЕсли;
	
	ТипЭлемента = Тип("ГруппаФормы");
	НовыйЭлементФормы = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);
	
	НовыйЭлементФормы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлементФормы.Заголовок = ЗаголовокЭлемента;
	НовыйЭлементФормы.ТолькоПросмотр = Ложь;
	НовыйЭлементФормы.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлементФормы.ОтображатьЗаголовок = Ложь;
	НовыйЭлементФормы.Группировка = ТипГруппировки;
	НовыйЭлементФормы.РастягиватьПоГоризонтали = РастягиватьПоГоризонтали;
	
	Возврат НовыйЭлементФормы;
КонецФункции

// Функция - Новая свертываемая группа.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ЗаголовокЭлемента - Произвольный - Заголовок элемента.
//  ГруппировкаВертикальная - Произвольный - Группировка вертикальная.
//  Скрывать - Произвольный - Скрывать.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоваяСвертываемаяГруппа(Элементы, ИмяЭлемента, Родитель, ЗаголовокЭлемента = "", ГруппировкаВертикальная = Истина, Скрывать = Ложь,
	ЭлеменПередКоторым = Неопределено) Экспорт
	
	Если ГруппировкаВертикальная Тогда
		ТипГруппировки = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Иначе
		ТипГруппировки = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КонецЕсли;
	
	ТипЭлемента = Тип("ГруппаФормы");
	НоваяГруппа = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);
	
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Заголовок = ЗаголовокЭлемента;
	НоваяГруппа.ТолькоПросмотр = Ложь;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	НоваяГруппа.ОтображатьЗаголовок = Истина;
	НоваяГруппа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	НоваяГруппа.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	НоваяГруппа.Группировка = ТипГруппировки;
	НоваяГруппа.РастягиватьПоГоризонтали = Истина;
	НоваяГруппа.ОтображатьОтступСлева = Ложь;
	
	Если Скрывать Тогда
		НоваяГруппа.Скрыть();	
	КонецЕсли;
	Возврат НоваяГруппа;
КонецФункции

// Функция - Новая всплывающая группа.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ЗаголовокЭлемента - Произвольный - Заголовок элемента.
//  ГруппировкаВертикальная - Произвольный - Группировка вертикальная.
//  УровеньВыделенияЧислом - Число - Уровень выделения числом.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоваяВсплывающаяГруппа(Элементы, 
		ИмяЭлемента, 
		Родитель,
		ЗаголовокЭлемента = "", 
		ГруппировкаВертикальная = Истина, 
		УровеньВыделенияЧислом = 2,
		ЭлеменПередКоторым = Неопределено) Экспорт
	
	Если ГруппировкаВертикальная Тогда
		ТипГруппировки = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Иначе
		ТипГруппировки = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КонецЕсли;
	
	Если УровеньВыделенияЧислом = 1 Тогда
		УровеньВыделения = ОтображениеОбычнойГруппы.СлабоеВыделение;
	ИначеЕсли УровеньВыделенияЧислом = 0 Тогда
		УровеньВыделения = ОтображениеОбычнойГруппы.Нет;
	ИначеЕсли УровеньВыделенияЧислом = 3 Тогда
		УровеньВыделения = ОтображениеОбычнойГруппы.СильноеВыделение;
	Иначе
		УровеньВыделения = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	КонецЕсли; 
	
	ТипЭлемента = Тип("ГруппаФормы");
	НоваяГруппа = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);

	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Заголовок = ЗаголовокЭлемента;
	НоваяГруппа.ТолькоПросмотр = Ложь;
	НоваяГруппа.Отображение = УровеньВыделения;
	НоваяГруппа.ОтображатьЗаголовок = Истина;
	НоваяГруппа.Поведение = ПоведениеОбычнойГруппы.Всплывающая;
	НоваяГруппа.Группировка = ТипГруппировки;
	
	Возврат НоваяГруппа;
КонецФункции


// Функция - Новая страницы.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ЗаголовокЭлемента - Произвольный - Заголовок элемента.
