/////////////////////////////////////////////////////////////////////////////////////
// ПЕРЕОПРЕДЕЛЯЕМЫЕ ПРОЦЕДУРЫ, ВЫЗЫВАЕМЫЕ ИЗ ОБРАБОТЧИКОВ ТИПОВЫХ ФОРМ.

#Область ПрограммныйИнтерфейс

#Область ЗаполнениеОбработчиковФормы

// Процедура - При создании на сервере.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ПриСозданииНаСервере(Форма,Отказ, СтандартнаяОбработка) Экспорт
	
	ИмяДокументаВнутреннееПотребление = питОбратнаяСовместимостьПовтИсп.ИмяДокументаВнутреннееПотребление();
	
	Если Форма.ИмяФормы = "Обработка.ПанельОбменЕГАИС.Форма.Форма" Тогда
		
		СоздатьЭлементыФормыПанелиОбменаСЕГАИС(Форма);
		
	ИначеЕсли Форма.ИмяФормы = "Обработка.ПанельОбменИСМП.Форма.Форма" Тогда
		
		// В форме отсутствует подключаемый обработчик выполнения команд, пока команда будет в подсистеме "общепит".
		// Уже есть обработчик.
		СоздатьЭлементыФормыПанелиОбменаСИСМП(Форма);
		
	ИначеЕсли Форма.ИмяФормы = "ОбщаяФорма.НастройкаОтбораПоСвойствамИРасчетаПоФормулам" Тогда
		
		СоздатьЭлементыФормыНастроекОтбораПоСвойствам(Форма);
		
	ИначеЕсли Форма.ИмяФормы = "ОбщаяФорма.НастройкаАвтовыбораНоменклатуры" Тогда
		
		СоздатьЭлементыФормыНастроекАвтовыбораНоменклатуры(Форма);
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		
		СоздатьОбновитьСтраницуРеквизитовОбщепитаНоменклатуры(Форма);
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.ВидыНоменклатуры.Форма.ФормаЭлемента" Тогда
		
		ПолеВвода = Форма.Элементы.Вставить("питПризнакПредметаРасчета", Тип("ПолеФормы"), Форма.Элементы.ГруппаКолонкиЛево);
		ПолеВвода.ПутьКДанным = "Объект.питПризнакПредметаРасчета";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Признак предмета расчета";
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаСписка" Тогда
		// Добавляем команду "Загрузка из FoodCost"
		Команда = Форма.Команды.Добавить("питЗагрузкаFoodCost");
		Команда.Действие				= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		Команда.Заголовок				= "Загрузка из FoodCost";
		
		Кнопка = Форма.Элементы.Вставить("питЗагрузкаFoodCost",Тип("КнопкаФормы"), Форма.Элементы.ГруппаПанельКатегорий, Форма.Элементы.ВариантыНавигации);
		Кнопка.Вид						= ВидКнопкиФормы.КнопкаКоманднойПанели;
		Кнопка.Отображение				= ОтображениеКнопки.Картинка;
		Кнопка.ИмяКоманды				= "питЗагрузкаFoodCost";
		Кнопка.Картинка					= БиблиотекаКартинок.ОбщепитЛоготипФудКост1;
		Кнопка.Ширина					= 10;
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаГруппы" Тогда
		
		// Добавление на форму флага "Выгружать во фронт-офис".
		// ГруппаОбщепита = Форма.Элементы.Вставить("питНастройкиВыгрузки",Тип("ГруппаФормы") ,Форма);
		// ГруппаОбщепита.Заголовок = "Настройки выгрузки во фронт-офис";
		// ГруппаОбщепита.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		// ПолеВвода = Форма.Элементы.Вставить("питВыгружатьВРБК", Тип("ПолеФормы"), ГруппаОбщепита);
		// ПолеВвода.ПутьКДанным = "Объект.питВыгружатьВРБК";
		// ПолеВвода.Вид = ВидПоляФормы.ПолеФлажка;
		// ПолеВвода.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		// ПолеВвода.Заголовок = "Выгружать во фронт-офис";
		// ПолеВвода.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		//   ПолеВвода.ПредупреждениеПриРедактировании = "Установка флага выгрузки приведет к тому, что к обмену с кассовыми
		// узлами будут зарегистрированы все потомки данной группы.
		//   | В случае снятия флажка, номенклатура, входящая в данную группу перестанет передаваться, что может привести к
		// ошибкам обменов.
		// | Продолжить?";
		// ГруппаОбщепита.ОтображатьЗаголовок = Ложь;
		
	ИначеЕсли Форма.ИмяФормы = "Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание" Тогда
		
		Команда = Форма.Команды.Добавить("питПерейтиКПараметрам");
		Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		Команда.Заголовок					= "Перейти к параметрам";

		Кнопка = Форма.Элементы.Добавить("питПараметры",Тип("КнопкаФормы"), Форма.Элементы.ГруппаВключениеИРасписание);
		Кнопка.Вид						= ВидКнопкиФормы.Гиперссылка;
		Кнопка.Заголовок				="Перейти к параметрам";
		Кнопка.Отображение				= ОтображениеКнопки.Текст;
		Кнопка.ИмяКоманды				= "питПерейтиКПараметрам";
		
		ДобавляемыеРеквизиты = Новый Массив;
		НовыйРеквизит = Новый РеквизитФормы("питПараметрыВХранилище", Новый ОписаниеТипов("Строка"),,"");
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	    Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

		Возврат;
		
		
		// Страницы - "питСтраницы".
		НовыеСтраницы = Форма.Элементы.Добавить("питСтраницы", Тип("ГруппаФормы"), Форма);
		НовыеСтраницы.Вид = ВидГруппыФормы.Страницы;
		// Страница - "питСтрОсновные".
		НоваяСтраница = Форма.Элементы.Добавить("питСтрОсновные", Тип("ГруппаФормы"), Форма.Элементы.питСтраницы);
		НоваяСтраница.Заголовок = "Основные";
		НоваяСтраница.Вид = ВидГруппыФормы.Страница;
		// Страница - "питСтрПараметры".
		НоваяСтраница = Форма.Элементы.Добавить("питСтрПараметры", Тип("ГруппаФормы"), Форма.Элементы.питСтраницы);
		НоваяСтраница.Заголовок = "Параметры";
		НоваяСтраница.Вид = ВидГруппыФормы.Страница;
		
		Для Каждого ПеремещаемыйЭлемент Из Форма.Элементы Цикл
			Если ПеремещаемыйЭлемент.Имя = "Основное" ИЛИ 
				ПеремещаемыйЭлемент.Имя = "ДействияПриОшибках" ИЛИ
				ПеремещаемыйЭлемент.Имя = "Дополнительно" ИЛИ
				ПеремещаемыйЭлемент.Имя = "Метаданные" ИЛИ
				ПеремещаемыйЭлемент.Имя = "СообщенияПользователюИОписаниеИнформацииОбОшибке" Тогда
				
				Форма.Элементы.Переместить(ПеремещаемыйЭлемент, Форма.Элементы.питСтрОсновные);
			КонецЕсли;
		КонецЦикла;
		
		// Страницы - "питВидыОбменов".
		НовыеСтраницы = Форма.Элементы.Добавить("питВидыОбменов", Тип("ГруппаФормы"), Форма.Элементы.питСтрПараметры);
		НовыеСтраницы.Вид = ВидГруппыФормы.Страницы;
		НовыеСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		// Страница - "питОбменСУдаленнымиКассами".
		НоваяСтраница = Форма.Элементы.Добавить("питСтрОбменСУдаленнымиКассами", Тип("ГруппаФормы"), Форма.Элементы.питВидыОбменов);
		НоваяСтраница.Заголовок = "Параметры";
		НоваяСтраница.Вид = ВидГруппыФормы.Страница;
		// Страница - "питЗагрузкаRKeeper".
		НоваяСтраница = Форма.Элементы.Добавить("питСтрЗагрузкаRKeeper", Тип("ГруппаФормы"), Форма.Элементы.питВидыОбменов);
		НоваяСтраница.Заголовок = "Параметры";
		НоваяСтраница.Вид = ВидГруппыФормы.Страница;
		
		Если питОбменДанными.РазделениеВключено() Тогда
			ДобавляемыеРеквизиты = Новый Массив;
			НовыйРеквизит = Новый РеквизитФормы("ЕстьПодтверждениеНаВыгрузку", Новый ОписаниеТипов("ТаблицаЗначений"),,"");
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		    Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

			// Элемент - "ЕстьПодтверждениеНаВыгрузку".
			НовыйЭлементФормы = Форма.Элементы.Добавить("ЕстьПодтверждениеНаВыгрузку",Тип("ПолеФормы"), Форма.Элементы.питОбменСУдаленнымиКассами);
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
			НовыйЭлементФормы.Заголовок = "Подтвердить выгрузку данных";
			НовыйЭлементФормы.ПутьКДанным = "ЕстьПодтверждениеНаВыгрузку";
			НовыйЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		КонецЕсли;
		
		Если Форма.ИмяМетаданных = "питЗагрузкаRKeeper" Тогда
			
		ИначеЕсли Форма.ИмяМетаданных = "питОбменСУдаленнымиКассами" Тогда
			// Подготовим массив новых реквизитов.
			ДобавляемыеРеквизиты = Новый Массив;
			НовыйРеквизит = Новый РеквизитФормы("питКассовыеУзлы", Новый ОписаниеТипов("ТаблицаЗначений"),,"");
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
			НовыйРеквизит = Новый РеквизитФормы("Префикс", Новый ОписаниеТипов("Строка"), "питКассовыеУзлы" , "Префикс");
		    ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		    НовыйРеквизит = Новый РеквизитФормы("УзелОбмена", Новый ОписаниеТипов("ПланОбменаСсылка.питУдаленныеКассы"), "питКассовыеУзлы" , "Узел обмена");
		    ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		    НовыйРеквизит = Новый РеквизитФормы("НастройкаДоставки", Новый ОписаниеТипов("СправочникСсылка.питНастройкиДоставкиСообщений"), "питКассовыеУзлы" , "Настройка доставки");
		    ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		    НовыйРеквизит = Новый РеквизитФормы("Режим", Новый ОписаниеТипов("Число"	, Новый КвалификаторыЧисла(1,0)), "питКассовыеУзлы" , "Режим");
		    ДобавляемыеРеквизиты.Добавить(НовыйРеквизит); 
			// Касательно второй группы
			НовыйРеквизит = Новый РеквизитФормы("питВестиЖурналРегистрации", Новый ОписаниеТипов("Булево"), , "Вести журнал регистрации");
		    ДобавляемыеРеквизиты.Добавить(НовыйРеквизит); 
		    НовыйРеквизит = Новый РеквизитФормы("питФиксироватьПриемОтправкуОбъектов", Новый ОписаниеТипов("Булево"), , "Фиксировать прием/отправку каждого объекта");
		    ДобавляемыеРеквизиты.Добавить(НовыйРеквизит); 
			// Изменяем все
		    Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

			ГруппаПитТаблицаУзлов = Форма.Элементы.Вставить("питТаблицаУзлов",Тип("ГруппаФормы") , Форма.Элементы.питСтрОбменСУдаленнымиКассами);
			ГруппаПитТаблицаУзлов.Заголовок = "Узлы обмена";
			ГруппаПитТаблицаУзлов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			питКассовыеУзлы = Форма.Элементы.Вставить("питКассовыеУзлы", Тип("ТаблицаФормы"), ГруппаПитТаблицаУзлов);
			питКассовыеУзлы.ПутьКДанным = "питКассовыеУзлы";
			питКассовыеУзлы.УстановитьДействие("ПередОкончаниемРедактирования", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
			
			НовыйЭлементФормы = Форма.Элементы.Добавить("питКассовыеУзлыПрефикс",Тип("ПолеФормы"), питКассовыеУзлы);
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлементФормы.ПутьКДанным = "питКассовыеУзлы.Префикс";
			НовыйЭлементФормы.ТолькоПросмотр	= Истина;
			НовыйЭлементФормы = Форма.Элементы.Добавить("питКассовыеУзлыУзелОбмена",Тип("ПолеФормы"), питКассовыеУзлы);
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлементФормы.ПутьКДанным = "питКассовыеУзлы.УзелОбмена";
			НовыйЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
			НовыйЭлементФормы = Форма.Элементы.Добавить("питКассовыеУзлыНастройкаДоставки",Тип("ПолеФормы"), питКассовыеУзлы);
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлементФормы.ПутьКДанным = "питКассовыеУзлы.НастройкаДоставки";
			НовыйЭлементФормы = Форма.Элементы.Добавить("питКассовыеУзлыРежим",Тип("ПолеФормы"), питКассовыеУзлы);
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлементФормы.ПутьКДанным = "питКассовыеУзлы.Режим";
			НовыйЭлементФормы.РежимВыбораИзСписка = Истина;
			НовыйЭлементФормы.СписокВыбора.Добавить(0, "Загружать сообщение обмена");
			НовыйЭлементФормы.СписокВыбора.Добавить(1, "Выгружать сообщение обмена");
			НовыйЭлементФормы.СписокВыбора.Добавить(2, "Выгружать и загружать сообщение обмена");
			НовыйЭлементФормы.СписокВыбора.Добавить(3, "Выгружать сообщение обмена при удачной загрузке");
			
			Для Каждого РежимОбмена Из НовыйЭлементФормы.СписокВыбора Цикл
				ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
				КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "питКассовыеУзлыРежим");		
				ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "питКассовыеУзлы.Режим", ВидСравненияКомпоновкиДанных.Равно, РежимОбмена.Значение);
				ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", РежимОбмена.Представление);
			КонецЦикла;


			// Касательно второй группы
			ГруппаПитПротоколОбмена = Форма.Элементы.Вставить("питПротоколОбмена",Тип("ГруппаФормы") , Форма.Элементы.питСтрОбменСУдаленнымиКассами);
			ГруппаПитПротоколОбмена.Заголовок = "Протокол обменов";
			ГруппаПитПротоколОбмена.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			НовыйЭлементФормы = Форма.Элементы.Добавить("питВестиЖурналРегистрации",Тип("ПолеФормы"), ГруппаПитПротоколОбмена);
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
			НовыйЭлементФормы.ПутьКДанным = "питВестиЖурналРегистрации";
			НовыйЭлементФормы = Форма.Элементы.Добавить("питФиксироватьПриемОтправкуОбъектов",Тип("ПолеФормы"), ГруппаПитПротоколОбмена);
			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
			НовыйЭлементФормы.ПутьКДанным = "питФиксироватьПриемОтправкуОбъектов";

			Задание = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(Форма.Параметры.Идентификатор);
			// ПрочитатьПараметры(Форма, Задание);
		КонецЕсли;
		

		
	ИначеЕсли Форма.ИмяФормы = "Справочник.КассыККМ.Форма.ФормаЭлемента" Тогда
		
		// Добавление на форму флага "Кассовый узел".
		ГруппаОбщепита = Форма.Элементы.Вставить("питНастройкиВыгрузки",Тип("ГруппаФормы") ,Форма);
		ГруппаОбщепита.Заголовок = "Настройки пит";
