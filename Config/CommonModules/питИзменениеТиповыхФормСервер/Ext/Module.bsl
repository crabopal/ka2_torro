	Кнопка.Отображение				= ОтображениеКнопки.Текст;
	Кнопка.ИмяКоманды				= "питКорректировкаОстатковИС";
	Кнопка.ОтображениеПодсказки		= ОтображениеПодсказки.ОтображатьСнизу;
	
	СоздатьЭлементыФормыСозданиеЦелевых(Форма);
	
КонецПроцедуры

Процедура СоздатьЭлементыФормыСозданиеЦелевых(Форма)
	
	Элементы	= Форма.Элементы;
	
	ГруппаОбщепита = Форма.Элементы.Добавить("питГруппаОбщепитОбмен",Тип("ГруппаФормы") ,Форма.Элементы.ГруппаСмТакжеЛево);
	ГруппаОбщепита.Заголовок = "Общепит-Обмен";
	ГруппаОбщепита.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОбщепита.ОтображатьЗаголовок = Ложь;
	ГруппаОбщепита.РастягиватьПоГоризонтали = Ложь;
	ГруппаОбщепита.Поведение = ПоведениеОбычнойГруппы.Обычное;
	ГруппаОбщепита.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.ГиперссылкаЗаголовка;
	ГруппаОбщепита.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	Команда = Форма.Команды.Добавить("питЗагрузкаИзДанныхПродажФронта");
	Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	Команда.Заголовок					= "Создание целевых документов по Чекам Общепита";
	Команда.Подсказка					= "Загрузка данных из документов ""Чеки общепита"" в целевые документы";
	
	Кнопка = Форма.Элементы.Добавить("питЗагрузкаИзДанныхПродажФронта",Тип("КнопкаФормы"), ГруппаОбщепита);
	Кнопка.Вид						= ВидКнопкиФормы.Гиперссылка;
	Кнопка.Отображение				= ОтображениеКнопки.Текст;
	Кнопка.ИмяКоманды				= "питЗагрузкаИзДанныхПродажФронта";
	Кнопка.ОтображениеПодсказки		= ОтображениеПодсказки.ОтображатьСнизу;
	
КонецПроцедуры

