		ИЛИ Форма.ИмяФормы = "Документ.ОрдерНаОтражениеНедостачТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = СтрШаблон("Документ.%1.Форма.ФормаДокумента", ИмяДокументаВнутреннееПотребление)
		ИЛИ Форма.ИмяФормы = "Документ.ПересчетТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.питКорректировкаОстатковИС.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.УстановкаЦенНоменклатуры.Форма.ФормаДокумента"
		
		Тогда
		
		мДокументПит = Неопределено;
		Объект = Форма.Объект;
		Если НЕ Объект.Ссылка.Пустая() И питТиповыеДокументы.НайтиДокументпитДляТиповогоДокумента(Объект.Ссылка, мДокументПит) Тогда
			
			// Добавляем команду "Обновить модификаторы"
			Команда = Форма.Команды.Добавить("питОткрытьДокументОбщепит");
			Команда.Действие				= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
			Команда.Заголовок				= "Открыть документ общепита";
			Команда.Подсказка				= "Открыть связанный с текущим объектом документ подсистемы ""Общепит""!";
			
			Кнопка = Форма.Элементы.Добавить("питОткрытьДокументОбщепит",Тип("КнопкаФормы"), Форма.КоманднаяПанель);
			Кнопка.Вид						= ВидКнопкиФормы.КнопкаКоманднойПанели;
			Кнопка.Заголовок				="Открыть документ общепита";
			Кнопка.ИмяКоманды				= "питОткрытьДокументОбщепит";
			Кнопка.Отображение				= ОтображениеКнопки.КартинкаИТекст;
			Кнопка.Картинка					= БиблиотекаКартинок.Лупа;
			
		КонецЕсли;
		
	ИначеЕсли Форма.ИмяФормы = "Документ.АктСписанияЕГАИС.Форма.ФормаДокумента" Тогда
		Если Форма.Команды.Найти("питКомандаЗаполнитьПоПродажамЗаДень") = Неопределено Тогда 
			Новком = Форма.Команды.Добавить("питКомандаЗаполнитьПоПродажамЗаДень");
			Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		КонецЕсли;
		
		Если Форма.Команды.Найти("питКомандаЗаполнитьПоПродажамЗаДеньТолькоНовые") = Неопределено Тогда 
			Новком = Форма.Команды.Добавить("питКомандаЗаполнитьПоПродажамЗаДеньТолькоНовые");
			Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		КонецЕсли;
		
		Если Форма.Команды.Найти("питКомандаЗаполнитьПроизводствомЗаДень") = Неопределено Тогда 
			Новком = Форма.Команды.Добавить("питКомандаЗаполнитьПроизводствомЗаДень");
			Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		КонецЕсли;         
		
		Если Форма.Команды.Найти("питКомандаЗаполнитьПродажамиПорцийЗаДень") = Неопределено Тогда 
			Новком = Форма.Команды.Добавить("питКомандаЗаполнитьПродажамиПорцийЗаДень");
			Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		КонецЕсли;  
		
		Если Форма.Команды.Найти("питКомандаЗаполнитьПродажамиКоктейлейЗаДень") = Неопределено Тогда 
			Новком = Форма.Команды.Добавить("питКомандаЗаполнитьПродажамиКоктейлейЗаДень");
			Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		КонецЕсли;  
		
		НовоеПодменю = Форма.Элементы.Добавить("питПодменюЗаполнить", Тип("ГруппаФормы"), Форма.Элементы.ГруппаНередактируемыеПослеОтправкиКомандыТовары);
		НовоеПодменю.Вид = ВидГруппыФормы.Подменю;
		НовоеПодменю.Заголовок = "Заполнить по продажам";  
		
		// Подменю с не крепким алкоголем
		ПодгруппаНеКрепкийАлкоголь = Форма.Элементы.Добавить("питПодменюНеКрепкийАлкоголь", Тип("ГруппаФормы"), НовоеПодменю);
		ПодгруппаНеКрепкийАлкоголь.Вид = ВидГруппыФормы.Подменю;
		ПодгруппаНеКрепкийАлкоголь.Заголовок = НСтр("ru='Пиво, сидр и т.п.'");   
		
		// Подменю с крепким алкоголем
		ПодгруппаКрепкийАлкоголь = Форма.Элементы.Добавить("питПодменюКрепкийАлкоголь", Тип("ГруппаФормы"), НовоеПодменю);
		ПодгруппаКрепкийАлкоголь.Вид = ВидГруппыФормы.Подменю;
		ПодгруппаКрепкийАлкоголь.Заголовок = НСтр("ru='Крепкий алкоголь'");   
		
		// кнопка заполнения всеми продажами за день
	    НоваяКнопка = Форма.Элементы.Добавить("питЗаполнитьПоПродажамЗаДень", Тип("КнопкаФормы"), ПодгруппаНеКрепкийАлкоголь);
	    НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	    НоваяКнопка.Заголовок = "Заполнить по продажам за день";
	    НоваяКнопка.ИмяКоманды = "питКомандаЗаполнитьПоПродажамЗаДень";
		
		// кнопка заполнения по продажам исключительно новых марок
	    НоваяКнопка = Форма.Элементы.Добавить("питЗаполнитьПоПродажамЗаДеньТолькоНовые", Тип("КнопкаФормы"), ПодгруппаНеКрепкийАлкоголь);
	    НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	    НоваяКнопка.Заголовок = "Заполнить по продажам за день (только новые марки)";
	    НоваяКнопка.ИмяКоманды = "питКомандаЗаполнитьПоПродажамЗаДеньТолькоНовые";
		
		// кнопка заполнения по продажам на онсновании произведенной продукции
	    НоваяКнопка = Форма.Элементы.Добавить("питКомандаЗаполнитьПроизводствомЗаДень", Тип("КнопкаФормы"), ПодгруппаКрепкийАлкоголь);
	    НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	    НоваяКнопка.Заголовок = "Заполнить производством за день";
	    НоваяКнопка.ИмяКоманды = "питКомандаЗаполнитьПроизводствомЗаДень";  
		
		// кнопка заполнения по продажам порций алкоголя за день
	    НоваяКнопка = Форма.Элементы.Добавить("питКомандаЗаполнитьПродажамиПорцийЗаДень", Тип("КнопкаФормы"), ПодгруппаКрепкийАлкоголь);
	    НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	    НоваяКнопка.Заголовок = НСтр("ru='Заполнить продажами чистого алкоголя'");
	    НоваяКнопка.ИмяКоманды = "питКомандаЗаполнитьПродажамиПорцийЗаДень";  
		
		// кнопка заполнения по продажам коктейлей алкоголя за день
	    НоваяКнопка = Форма.Элементы.Добавить("питКомандаЗаполнитьПродажамиКоктейлейЗаДень", Тип("КнопкаФормы"), ПодгруппаКрепкийАлкоголь);
	    НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	    НоваяКнопка.Заголовок = НСтр("ru='Заполнить продажами алкоголесодержащих блюд'");
	    НоваяКнопка.ИмяКоманды = "питКомандаЗаполнитьПродажамиКоктейлейЗаДень";  
		
		Форма.Элементы.ПричинаСписания.СписокВыбора.Добавить(Перечисления.ПричиныСписанийЕГАИС.питПриготовление, "Приготовление Общепит");
		
		// Добавление таблицы Акцизные марки
		питУправлениеДиалогомСервер = ОбщегоНазначения.ОбщийМодуль("питИзменениеТиповыхФормСервер");
		
		НовРеквизиты = Новый Массив;
		НовРеквизит = Новый РеквизитФормы("питПустаяКолонка", ОбщегоНазначения.ОписаниеТипаСтрока(0),"Объект.АкцизныеМарки" , "Пустая колонка");
		НовРеквизиты.Добавить(НовРеквизит);
		Форма.ИзменитьРеквизиты(НовРеквизиты);
		
		ГруппаАкцизныхМарок = питУправлениеДиалогомСервер.НоваяСвертываемаяГруппа(Форма.Элементы,
			"питГруппаАкцизныеМарки",
			Форма.Элементы.СтраницаТовары,
			НСтр("ru='Акцизные марки'"),, Истина);
			
		НоваяТаблица = питУправлениеДиалогомСервер.НоваяТаблица(Форма.Элементы,
			"питАкцизныеМарки",
			ГруппаАкцизныхМарок,
			"Объект.АкцизныеМарки",,
			НСтр("ru='Акцизные марки'"));
		НоваяТаблица.ИзменятьСоставСтрок = Ложь;
		НоваяКолонка = питУправлениеДиалогомСервер.НоваяКолонкаТаблицы(Форма.Элементы, "питАкцизныеМаркиМарка", НоваяТаблица,
			"Объект.АкцизныеМарки.АкцизнаяМарка",,
			НСтр("ru='Акцизная марка'"));
		НоваяКолонка.ТолькоПросмотр = Истина;
		НоваяКолонка = питУправлениеДиалогомСервер.НоваяКолонкаТаблицы(Форма.Элементы, "питАкцизныеМаркиКоличество", НоваяТаблица,
			"Объект.АкцизныеМарки.Количество",,
			НСтр("ru='Количество марок'"));
		НоваяКолонка.ТолькоПросмотр = Истина;
		НоваяКолонка = питУправлениеДиалогомСервер.НоваяКолонкаТаблицы(Форма.Элементы, "питАкцизныеМаркиЧастичноеВыбытиеКоличество", НоваяТаблица,
			"Объект.АкцизныеМарки.ЧастичноеВыбытиеКоличество",,
			НСтр("ru='Частичное списание'"));
		НоваяКолонка.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
		
		НоваяКолонка = питУправлениеДиалогомСервер.НоваяКолонкаТаблицы(Форма.Элементы, "питАкцизныеМаркиВыбытиеБутылки", НоваяТаблица,
			"Объект.АкцизныеМарки.ВыбытиеБутылки",,
			НСтр("ru='Бутылка закончилась'"));
		НоваяКолонка = питУправлениеДиалогомСервер.НоваяКолонкаТаблицы(Форма.Элементы, "питАкцизныеМаркиПустаяКолонка", НоваяТаблица,
			"Объект.АкцизныеМарки.питПустаяКолонка");
		НоваяКолонка.ТолькоПросмотр = Истина;
		НоваяКолонка.ОтображатьВШапке = Ложь;
		
		ТекДействие = Форма.Элементы.Товары.ПолучитьДействие("ПриАктивизацииСтроки");
		Если НЕ ЗначениеЗаполнено(ТекДействие) Тогда
			Форма.Элементы.Товары.УстановитьДействие("ПриАктивизацииСтроки", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
		КонецЕсли;
		
		
	ИначеЕсли Форма.ИмяФормы = "Документ.ОтчетЕГАИС.Форма.ФормаДокумента" Тогда
		
		Форма.Элементы.ВидДокумента.СписокВыбора.Добавить(Перечисления.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл);
		
	ИначеЕсли Форма.ИмяФормы = "Документ.ОтчетЕГАИС.Форма.ФормаСпискаДокументов" Тогда
		
		НоваяКоманда(Форма.Команды, "питСоздатьЗапросОстатковВРегистре3Общепит", "Остатки в регистре №3 в мл (Общепит)", "Подключаемый_ВыполнитьПереопределяемуюКоманду", Ложь);
		НоваяКнопка(Форма.Элементы, "питСоздатьЗапросОстатковВРегистре3Общепит", Форма.Элементы.СписокПодменюСоздать, "питСоздатьЗапросОстатковВРегистре3Общепит");
		
		Форма.Элементы.ВидДокументаОтбор.СписокВыбора.Добавить(Перечисления.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл);
		
		Форма.ПараметрыВидимостиКолонок.АлкогольнаяПродукция.Добавить(Перечисления.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл);
		Форма.ПараметрыВидимостиКолонок.Справка2.Добавить(Перечисления.ВидыДокументовЕГАИС.питЗапросОтчетаОстаткиВРегистре3ПоМл);
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Пользователи.Форма.ФормаЭлемента" Тогда
		
		ПолеВвода = Форма.Элементы.Вставить("питРаботатьСПодсистемойОбщепит", Тип("ПолеФормы"), Форма, Форма.Элементы.ГруппаВходВПрограммуРазрешен);
		ПолеВвода.ПутьКДанным = "Объект.питРаботатьСПодсистемойОбщепит";
		ПолеВвода.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеВвода.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		
	ИначеЕсли Форма.ИмяФормы = "Обработка.ЛегальностьПолученияОбновлений.Форма.ПроверкаЛегальностиПолученияОбновления" Тогда
		Форма.Элементы.РазрешитьОтправкуСтатистики.Заголовок = питЦентрМониторинга.ЗаменитьВендораВСтроке(Форма.Элементы.РазрешитьОтправкуСтатистики.Заголовок);
	ИначеЕсли Форма.ИмяФормы = "Обработка.НастройкиЦентраМониторинга.Форма.НастройкиЦентраМониторинга" Тогда
		Форма.Элементы.ОтправлятьИнформациюОбОшибкахРасширеннаяПодсказка.Заголовок = питЦентрМониторинга.ЗаменитьВендораВСтроке(Форма.Элементы.ОтправлятьИнформациюОбОшибкахРасширеннаяПодсказка.Заголовок);
	ИначеЕсли Форма.ИмяФормы = "Обработка.НастройкиЦентраМониторинга.Форма.ОтправкаКонтактнойИнформации" Тогда
		Форма.Элементы.Заголовок.Заголовок = питЦентрМониторинга.ЗаменитьВендораВСтроке(Форма.Элементы.Заголовок.Заголовок);
	ИначеЕсли Форма.ИмяФормы = "Обработка.ПанельАдминистрированияБСП.Форма.ИнтернетПоддержкаИСервисы" Тогда
		Для каждого ТекЭлемент Из Форма.Элементы.ЦентрМониторингаРазрешитьОтправлятьДанные.СписокВыбора Цикл
			ТекЭлемент.Представление	= питЦентрМониторинга.ЗаменитьВендораВСтроке(ТекЭлемент.Представление);
		КонецЦикла;
	ИначеЕсли Форма.ИмяФормы = "Документ.ПланПроизводства.Форма.ФормаДокумента" Тогда
		питПланирование.СоздатьЭлементыФормыПланаПроизводства(Форма);
	ИначеЕсли Форма.ИмяФормы = "Документ.ПланПроизводства.Форма.ФормаСписка" 
		И Форма.Параметры.Свойство("питПланПроизводства") Тогда
		питПланирование.УстановитьОтборФормыСпискаПланаПроизводства(Форма);
	// ИначеЕсли Форма.ИмяФормы = "ВнешняяОбработка.ФормированиеЗаказовНаПроизводствоПоПлану.Форма.Форма" Тогда
	ИначеЕсли Форма.ИмяФормы = "Обработка.ФормированиеЗаказовНаПроизводствоПоПлану.Форма.Форма" Тогда
		питПланирование.СоздатьЭлементыФормированиеЗаказовНаПроизводствоПоПлану(Форма);
	ИначеЕсли Форма.ИмяФормы = "Справочник.ШтрихкодыУпаковокТоваров.Форма.ФормаЭлемента" Тогда
		НоваяГруппа = питИзменениеТиповыхФормСервер.НоваяОбычнаяГруппа(Форма.Элементы,
			"питПараметрыПива",
			Форма.Элементы.СтраницаОсновное);
		НовоеПолеВвода = питИзменениеТиповыхФормСервер.НовоеПолеВвода(Форма.Элементы,
			"питДатаПодключения",
			НоваяГруппа,
			"Объект.питДатаПодключения");
		НовоеПолеВвода = питИзменениеТиповыхФормСервер.НовоеПолеВвода(Форма.Элементы,
			"питСрокРеализации",
			НоваяГруппа,
			"Объект.питСрокРеализации");
		НовоеПолеВвода = питИзменениеТиповыхФормСервер.НовоеПолеВвода(Форма.Элементы,
			"питОбъемСлива",
			НоваяГруппа,
			"Объект.питОбъемСлива");
	КонецЕсли;
	
КонецПроцедуры

