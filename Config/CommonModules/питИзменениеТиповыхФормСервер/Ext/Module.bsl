//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи)Экспорт
	
	Если Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		
		Если Форма.Элементы.Найти("СтраницаРеквизитыПит") = Неопределено Тогда
			СоздатьОбновитьСтраницуРеквизитовОбщепитаНоменклатуры(Форма);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Переопределяемая процедура, вызываемая из одноименного обработчика события формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
Процедура ПередЗаписьюНаСервере(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи)Экспорт
	
	Если Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		
		Если ТекущийОбъект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга 
			И ТекущийОбъект.питВидНоменклатуры <> Перечисления.питВидыНоменклатуры.БизнесЛанч Тогда
			ТекущийОбъект.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Услуга;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ГенераторЭлементов


// Функция - Новая команда.
//
// Параметры:
//  Команды - Произвольный - Команды.
//  ИмяКоманды - Произвольный - Имя команды.
//  Заголовок - Произвольный - Заголовок.
//  Действие - Строка - Действие.
//  ДобавитьПрефиксДействию - Произвольный - Добавить префикс действию.
//  ИзменяетСохраняемыеДанные - Произвольный - Изменяет сохраняемые данные.
//  Картинка - Произвольный - Картинка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НоваяКоманда(Команды, ИмяКоманды, Заголовок, Действие = "", ДобавитьПрефиксДействию = Истина, ИзменяетСохраняемыеДанные = Ложь, Картинка = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Действие = ИмяКоманды;
	КонецЕсли;
	
	Если ДобавитьПрефиксДействию Тогда
		Действие = "Подключаемый_" + Действие;
	КонецЕсли;
	
	НоваяКоманда = Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Заголовок = Заголовок;
	НоваяКоманда.Действие = Действие;
	НоваяКоманда.ИзменяетСохраняемыеДанные = ИзменяетСохраняемыеДанные;
	
	Если Не Картинка = Неопределено Тогда
		НоваяКоманда.Картинка = Картинка;
	КонецЕсли;
	
	Возврат НоваяКоманда;
	
КонецФункции

// Функция - Новое подменю.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ЗаголовокЭлемента - Строка - Заголовок элемента.
//  ЭлементПередКоторым - Произвольный - Элемент перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НовоеПодменю(Элементы, ИмяЭлемента, Родитель, ЗаголовокЭлемента = "", ЭлементПередКоторым = Неопределено) Экспорт
	
	ТипЭлемента = Тип("ГруппаФормы");
	НовыйЭлементФормы = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлементПередКоторым);
	НовыйЭлементФормы.Вид = ВидГруппыФормы.Подменю;
	НовыйЭлементФормы.Заголовок = ЗаголовокЭлемента;
	
	Возврат НовыйЭлементФормы;
	
КонецФункции

// Функция - Новая группа кнопок.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ЗаголовокЭлемента - Строка - Заголовок элемента.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НоваяГруппаКнопок(Элементы, ИмяЭлемента, Родитель, ЗаголовокЭлемента = "",ЭлеменПередКоторым = Неопределено) Экспорт
	
	ТипЭлемента = Тип("ГруппаФормы");
	НовыйЭлементГруппа = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);

	НовыйЭлементГруппа.Вид		= ВидГруппыФормы.ГруппаКнопок;
	НовыйЭлементГруппа.Заголовок= ЗаголовокЭлемента;
	
	Возврат НовыйЭлементГруппа;
	
КонецФункции

// Функция - Новая кнопка.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ИмяКоманды - Произвольный - Имя команды.
//  ЗаголовокЭлемента - Произвольный - Заголовок элемента.
//  ШиринаКнопки - Произвольный - Ширина кнопки.
//  ВысотаКнопки - Произвольный - Высота кнопки.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция НоваяКнопка(Элементы, ИмяЭлемента, Родитель, ИмяКоманды = "", ЗаголовокЭлемента = "", 
	ШиринаКнопки = 0, 
	ВысотаКнопки = 0,
	ЭлеменПередКоторым = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяКоманды) Тогда
		ИмяКоманды = ИмяЭлемента;
	КонецЕсли;
	
	ТипЭлемента = Тип("КнопкаФормы");
	НовыйЭлементФормы = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);
	
	НовыйЭлементФормы.Заголовок = ЗаголовокЭлемента;
	НовыйЭлементФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	НовыйЭлементФормы.ИмяКоманды = ИмяКоманды;
	НовыйЭлементФормы.Отображение = ОтображениеКнопки.Авто;
	НовыйЭлементФормы.Ширина = ШиринаКнопки;
	НовыйЭлементФормы.Высота = ВысотаКнопки;
	
	Возврат НовыйЭлементФормы;
КонецФункции

// Создает элемент группы кнопок командной панели.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  Родитель - Произвольный - Родитель.
//  ИмяКоманды - Произвольный - Имя команды.
//  ЗаголовокЭлемента - Произвольный - Заголовок элемента.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция НоваяКнопкаКоманднойПанели(Элементы, ИмяЭлемента, Родитель, ИмяКоманды = "", ЗаголовокЭлемента = "", ЭлеменПередКоторым = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяКоманды) Тогда
		ИмяКоманды = ИмяЭлемента;
	КонецЕсли;
	
	ТипЭлемента = Тип("КнопкаФормы");
	НовыйЭлементФормы = ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);

	НовыйЭлементФормы.Заголовок		= ЗаголовокЭлемента;
	НовыйЭлементФормы.Вид			= ВидКнопкиФормы.КнопкаКоманднойПанели;
