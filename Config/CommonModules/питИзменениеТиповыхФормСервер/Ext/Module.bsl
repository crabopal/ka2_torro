	//ПоместитьВоВременноеХранилище(ДанныеНастроек, АдресДанныхНастроекПараметровНоменклатурыИС);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ГенераторЭлементов

// Функция - Добавить элемент на форму.
//
// Параметры:
//  Элементы - Произвольный - Элементы.
//  ИмяЭлемента - Произвольный - Имя элемента.
//  ТипЭлемента - Произвольный - Тип элемента.
//  Родитель - Произвольный - Родитель.
//  ЭлеменПередКоторым - Произвольный - Элемен перед которым.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДобавитьЭлементНаФорму(Элементы, ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым = Неопределено)
	
	Если ЭлеменПередКоторым = Неопределено Тогда
		НовыйЭлементФормы = Элементы.Добавить(ИмяЭлемента, ТипЭлемента, Родитель);
	Иначе
		Элементы.Вставить(ИмяЭлемента, ТипЭлемента, Родитель, ЭлеменПередКоторым);
		НовыйЭлементФормы = Элементы[ИмяЭлемента];
	КонецЕсли;
	
	Возврат НовыйЭлементФормы;
	
КонецФункции

#КонецОбласти

// Процедура заполнения ветку группы дерева модификаторов элементами.
//
// Параметры:
//  Родитель - Произвольный - Родитель.
//  СтрокаМодификатор - Строка - Строка модификатор.
//
Процедура ЗаполнениеЭлементовГруппыМодификатора(Родитель, СтрокаМодификатор)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Модификаторы.Модификатор КАК Модификатор
	|ИЗ
	|	Справочник.питГруппыМодификаторов.Модификаторы КАК Модификаторы
	|ГДЕ
	|	Модификаторы.Ссылка = &Родитель");
	
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ВеткаГруппы = СтрокаМодификатор.Строки.Добавить();
		ВеткаГруппы.Модификатор = Выборка.Модификатор;
		
	КонецЦикла;
	
КонецПроцедуры

// / ЗаполнениеЭлементовГруппыМодификатора()
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
Процедура СоздатьОбновитьСтраницуРеквизитовОбщепитаНоменклатуры(Форма)
	
	Форма.УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("питВидимостьОбщепитныхКомандВФормеНоменклатуры",Форма.Объект.ВидНоменклатуры));
	Если питОбщегоНазначения.ЭтоВидНоменклатурыОбщепит(Форма.Объект.ВидНоменклатуры) Тогда
		
		ГруппаОбщепита = Форма.Элементы.Вставить("СтраницаРеквизитыпит",Тип("ГруппаФормы") ,Форма.Элементы.СтраницыКарточкаНоменклатуры);
		ГруппаОбщепита.Заголовок = "Реквизиты Общепита";
		
		ПолеВвода = Форма.Элементы.Добавить("питВидНоменклатуры", Тип("ПолеФормы"), ГруппаОбщепита);
		ПолеВвода.ПутьКДанным = "Объект.питВидНоменклатуры";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Вид номенклатуры общепита";
		ПолеВвода.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
		// ПолеВвода.РежимВыбораИзСписка = Истина;
		// ПолеВвода.СписокВыбора.Добавить(Перечисления.питВидыНоменклатуры.Товар);
		
		ПолеВвода = Форма.Элементы.Добавить("питТоварнаяГруппа", Тип("ПолеФормы"), ГруппаОбщепита);
		ПолеВвода.ПутьКДанным = "Объект.питТоварнаяГруппа";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Товарная группа";
		
		ПолеВвода = Форма.Элементы.Вставить("питРецептурнаяУпаковка", Тип("ПолеФормы"), ГруппаОбщепита);
		ПолеВвода.ПутьКДанным = "Объект.питРецептурнаяУпаковка";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Рецептурная единица";
		
		ПолеВвода = Форма.Элементы.Вставить("питПризнакПредметаРасчета", Тип("ПолеФормы"), ГруппаОбщепита);
		ПолеВвода.ПутьКДанным = "Объект.питПризнакПредметаРасчета";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Признак предмета расчета";
		
		ГруппаПитНастройкиИСМП = Форма.Элементы.Добавить("питНастройкиИСМП",Тип("ГруппаФормы") ,ГруппаОбщепита);
		ГруппаПитНастройкиИСМП.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаПитНастройкиИСМП.Заголовок = "Настройки ИС МП";
		ГруппаПитНастройкиИСМП.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаПитНастройкиИСМП.ОтображатьЗаголовок = Истина;
		
		ПолеФлажка = Форма.Элементы.Вставить("питПродажаВРозлив", Тип("ПолеФормы"), ГруппаПитНастройкиИСМП);
		ПолеФлажка.ПутьКДанным = "Объект.питПродажаВРозлив";
		ПолеФлажка.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеФлажка.Заголовок = "Продажа алкоголя/пива в розлив";
		ПолеФлажка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ПолеФлажка.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		ПолеФлажка.РасширеннаяПодсказка.Заголовок = "Это порционная алкогольная или пивная позиция или может быть указана в качестве ингредиента составе алкогольной рецептуры.";
		
		Команда = Форма.Команды.Добавить("питАлкогольныеРецептуры");
		Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		Команда.Заголовок					= "Перейти к настройке алкогольного состава";
		
		Кнопка = Форма.Элементы.Добавить("питАлкогольныеРецептуры",Тип("КнопкаФормы"), ГруппаПитНастройкиИСМП);
		Кнопка.Вид						= ВидКнопкиФормы.Гиперссылка;
		Кнопка.Заголовок				="Перейти к настройке алкогольного состава";
		Кнопка.Отображение				= ОтображениеКнопки.Текст;
		Кнопка.ИмяКоманды				= "питАлкогольныеРецептуры";
		
		
		ПолеВвода = Форма.Элементы.Вставить("питОбъемНетто", Тип("ПолеФормы"), ГруппаПитНастройкиИСМП);
		ПолеВвода.ПутьКДанным = "Объект.питОбъемНетто";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Объем нетто (в литрах)";
		
		ПолеВвода = Форма.Элементы.Вставить("питОбъемТехническогоСлива", Тип("ПолеФормы"), ГруппаПитНастройкиИСМП);
		ПолеВвода.ПутьКДанным = "Объект.питОбъемТехническогоСлива";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Объем технического слива (в литрах)";
		
		ПолеВвода = Форма.Элементы.Вставить("питСрокРеализации", Тип("ПолеФормы"), ГруппаПитНастройкиИСМП);
		ПолеВвода.ПутьКДанным = "Объект.питСрокРеализации";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Срок реализации (в часах)";
		
		
		Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Форма.Объект.Ссылка, Форма.Элементы.питРецептурнаяУпаковка);
		
		Команда = Форма.Команды.Добавить("питРецептурыНоменклатуры");
		Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		Команда.Заголовок					= "Перейти к рецептурам";
		
		Кнопка = Форма.Элементы.Добавить("питРецептурыНоменклатуры",Тип("КнопкаФормы"), ГруппаОбщепита);
		Кнопка.Вид						= ВидКнопкиФормы.Гиперссылка;
		Кнопка.Заголовок				="Перейти к рецептурам";
		Кнопка.Отображение				= ОтображениеКнопки.Текст;
		Кнопка.ИмяКоманды				= "питРецептурыНоменклатуры";
		
		Команда = Форма.Команды.Добавить("питВРецептурах");
		Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		Команда.Заголовок					= "В рецептурах";
		
		Кнопка = Форма.Элементы.Добавить("питВРецептурах",Тип("КнопкаФормы"), ГруппаОбщепита);
		Кнопка.Вид						= ВидКнопкиФормы.Гиперссылка;
		Кнопка.Заголовок				="В рецептурах";
		Кнопка.Отображение				= ОтображениеКнопки.Текст;
		Кнопка.ИмяКоманды				= "питВРецептурах";
		
		СтраницыПита = Форма.Элементы.Добавить("питСтраницыпита", Тип("ГруппаФормы"), ГруппаОбщепита);
		СтраницыПита.Вид = ВидГруппыФормы.Страницы;
		/////////////////////////////
		// Страница "Модификаторы"
		
		ГруппаМодификаторы = Форма.Элементы.Вставить("питСтраницаМодификаторы",Тип("ГруппаФормы") ,Страницыпита);
		ГруппаМодификаторы.Вид = ВидГруппыФормы.Страница;
		ГруппаМодификаторы.Заголовок	= "Модификаторы";
		
		// Создание и заполнение "обычного" объекта прикладного типа ДеревоЗначений,
		// который будет отображен на управляемой форме
		ДеревоОбъект = Новый ДеревоЗначений;
		ДеревоОбъект.Колонки.Добавить("Модификатор",		Новый ОписаниеТипов("СправочникСсылка.питМодификаторы")	,"Модификатор");
		ДеревоОбъект.Колонки.Добавить("ОтКогоУнаследовали",	Новый ОписаниеТипов("СправочникСсылка.Номенклатура")		,"От кого унаследовали");
		ДеревоОбъект.Колонки.Добавить("ГруппаМодификатора",	Новый ОписаниеТипов("СправочникСсылка.питГруппыМодификаторов"),"Набор");
		
		// Создание Реквизита формы типа ДанныеФормыДерево
		МассивДобавляемыхРеквизитов = Новый Массив;
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питВидНоменклатурыКопия", Новый ОписаниеТипов("ПеречислениеСсылка.питВидыНоменклатуры")));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питМодификаторы", Новый ОписаниеТипов("ДеревоЗначений")));
		Для Каждого Колонка Из ДеревоОбъект.Колонки Цикл
			МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "питМодификаторы"));
		КонецЦикла;
		
		Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
		
		Форма.питВидНоменклатурыКопия = Форма.Объект.питВидНоменклатуры;
		
		НоваяКомПанель = Форма.Элементы.Добавить("питМодификаторыКоманднаяПанель", Тип("ГруппаФормы"), ГруппаМодификаторы);
		НоваяКомПанель.Вид = ВидГруппыФормы.КоманднаяПанель;
		
		// Создание элемента формы типа ТаблицаФормы для отображения дерева
		ЭлементДерево = Форма.Элементы.Добавить("питМодификаторы", Тип("ТаблицаФормы"), ГруппаМодификаторы);
		ЭлементДерево.ПутьКДанным		= "питМодификаторы";
		ЭлементДерево.Отображение		= ОтображениеТаблицы.Дерево;
		ЭлементДерево.ТолькоПросмотр	= Истина;
		ЭлементДерево.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		
		НоваяГруппаМодификаторы = Форма.Элементы.Добавить(ЭлементДерево.Имя + "ГруппаМодификаторы", Тип("ГруппаФормы"), ЭлементДерево);
		НоваяГруппаМодификаторы.Заголовок	= "Модификаторы, набор модификаторов";
		НоваяГруппаМодификаторы.Группировка	= ГруппировкаКолонок.ВЯчейке;
		
		Для Каждого Колонка Из ДеревоОбъект.Колонки Цикл
			Если Колонка.Имя = "ОтКогоУнаследовали" Тогда
				ТекРодитель = ЭлементДерево;
			Иначе
				// Колонка будет в группе
				ТекРодитель = НоваяГруппаМодификаторы;
			КонецЕсли;
			НовыйЭлемент = Форма.Элементы.Добавить(ЭлементДерево.Имя + Колонка.Имя, Тип("ПолеФормы"), ТекРодитель);
			НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным	= "питМодификаторы." + Колонка.Имя;
			НовыйЭлемент.Заголовок		= Колонка.Заголовок;
		КонецЦикла;
		
		// Добавляем команду "Редактирование модификаторов"
		Команда = Форма.Команды.Добавить("питРедактированиеМодификаторов");
		Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		Команда.Заголовок					= "Редактирование модификаторов";
		
		Кнопка = Форма.Элементы.Добавить("питРедактированиеМодификаторов",Тип("КнопкаФормы"),НоваяКомПанель);
		Кнопка.Вид						= ВидКнопкиФормы.КнопкаКоманднойПанели;
		Кнопка.Заголовок				="Редактирование модификаторов";
		Кнопка.Отображение				= ОтображениеКнопки.КартинкаИТекст;
		Кнопка.ИмяКоманды				= "питРедактированиеМодификаторов";
		Кнопка.Картинка					= БиблиотекаКартинок.Изменить;
		
		// Добавляем команду "Обновить модификаторы"
		Команда = Форма.Команды.Добавить("питОбновитьМодификаторы");
		Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		Команда.Заголовок					= "Обновить модификаторы";
		
		Кнопка = Форма.Элементы.Добавить("питОбновитьМодификаторы",Тип("КнопкаФормы"),НоваяКомПанель);
		Кнопка.Вид						= ВидКнопкиФормы.КнопкаКоманднойПанели;
		Кнопка.Заголовок				="Обновить модификаторы";
		Кнопка.Отображение				= ОтображениеКнопки.Картинка;
		Кнопка.ИмяКоманды				= "питОбновитьМодификаторы";
		Кнопка.Картинка					= БиблиотекаКартинок.Обновить;
		
		ЗаполнитьМодификаторы(Форма.питМодификаторы, Форма.Объект.Ссылка);
		
		///////////////////////////////
		// Страница "Фронт-офис"
		
		ГруппаПитФронтОфис = Форма.Элементы.Вставить("питСтраницаФронтОфис",Тип("ГруппаФормы") ,Страницыпита);
		ГруппаПитФронтОфис.Вид = ВидГруппыФормы.Страница;
		ГруппаПитФронтОфис.Заголовок = "Фронт-офис";
		
		ГруппаПитФронтОфис.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ГруппаПитФронтОфис.РастягиватьПоГоризонтали = Истина;
		
		ГруппаПитФронтОфисФлажки = Форма.Элементы.Добавить("питФронтОфисФлажки",Тип("ГруппаФормы") ,ГруппаПитФронтОфис);
		ГруппаПитФронтОфисФлажки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаПитФронтОфисФлажки.РастягиватьПоГоризонтали = Истина;
		
		ПолеВвода = Форма.Элементы.Добавить("питНазначениеУслуги", Тип("ПолеФормы"), ГруппаПитФронтОфисФлажки);
		ПолеВвода.ПутьКДанным = "Объект.питНазначениеУслуги";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
