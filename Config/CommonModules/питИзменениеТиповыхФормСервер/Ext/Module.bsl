// Процедура - Создать элементы формы настроек отбора по свойствам.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
Процедура СоздатьЭлементыФормыНастроекОтбораПоСвойствам(Форма)
	
	Элементы	= Форма.Элементы;
	
	Если Форма.ИмяТЧ <> "Ингредиенты" Тогда
		Возврат;
	КонецЕсли;
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питНаименованиеУсловия", Новый ОписаниеТипов("Строка")));
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	ГруппаОбщепита = Форма.Элементы.Вставить("питГруппаОбщепит",Тип("ГруппаФормы") ,Форма.Элементы.ГруппаОтборПоСвойствам, Форма.Элементы.ОтборПоСвойствам);
	ГруппаОбщепита.Заголовок = "Реквизиты Общепита";
	ГруппаОбщепита.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОбщепита.ОтображатьЗаголовок = Ложь;
	ГруппаОбщепита.РастягиватьПоГоризонтали = Истина;
	
	ПолеВвода = Форма.Элементы.Добавить("питНаименованиеУсловия", Тип("ПолеФормы"), ГруппаОбщепита);
	ПолеВвода.ПутьКДанным = "питНаименованиеУсловия";
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.Заголовок = "Название условия";
	ПолеВвода.ПодсказкаВвода = "<Авто>";
	
	Если Форма.Параметры.Свойство("ОтборПоСвойствам") И Форма.Параметры.ОтборПоСвойствам.Количество() Тогда
		Форма.питНаименованиеУсловия = Форма.Параметры.ОтборПоСвойствам[0].НаименованиеУсловия;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Создать элементы формы настроек автовыбора номенклатуры.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
Процедура СоздатьЭлементыФормыНастроекАвтовыбораНоменклатуры(Форма)
	
	Элементы	= Форма.Элементы;
	
	Если Форма.ИмяТЧ <> "Ингредиенты" Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаУказываетсяВРецептуре = "Указывается в рецептуре";
	Элементы.МатериалУказываетсяВНСИ.Заголовок			= СтрокаУказываетсяВРецептуре;
	Элементы.ХарактеристикаУказываетсяВНСИ.Заголовок	= СтрокаУказываетсяВРецептуре;
	Элементы.МатериалУказываетсяВНСИ.СписокВыбора.Очистить();
	Элементы.МатериалУказываетсяВНСИ.СписокВыбора.Добавить(Перечисления.СпособыАвтовыбораНоменклатуры.УказываетсяВНСИ, СтрокаУказываетсяВРецептуре);
	Элементы.ХарактеристикаУказываетсяВНСИ.СписокВыбора.Очистить();
	Элементы.ХарактеристикаУказываетсяВНСИ.СписокВыбора.Добавить(Перечисления.СпособыАвтовыбораНоменклатуры.УказываетсяВНСИ, СтрокаУказываетсяВРецептуре);
	Элементы.ГруппаУточняетсяПриПроизводстве.Видимость = Ложь;
	
КонецПроцедуры

// Процедура - Создать элементы формы панели обмена с егаис.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
