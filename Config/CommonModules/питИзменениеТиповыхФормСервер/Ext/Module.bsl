	Кнопка = Форма.Элементы.Добавить("питИнвентаризацияЕГАИС",Тип("КнопкаФормы"), ГруппаБлокПроизводстваЛево);
	Кнопка.Вид						= ВидКнопкиФормы.Гиперссылка;
	Кнопка.Заголовок				="Инвентаризация ЕГАИС";
	Кнопка.Отображение				= ОтображениеКнопки.Текст;
	Кнопка.ИмяКоманды				= "питИнвентаризацияЕГАИС";
	Кнопка.ОтображениеПодсказки		= ОтображениеПодсказки.ОтображатьСнизу;
	
	Команда = Форма.Команды.Добавить("питАктВскрытияТарыАлкогольнойПродукции");
	Команда.Действие					= "Подключаемый_ВыполнитьПереопределяемуюКоманду";
