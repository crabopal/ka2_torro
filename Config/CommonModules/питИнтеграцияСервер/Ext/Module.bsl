// ПЕРЕОПРЕДЕЛЯЕМЫЕ ПРОЦЕДУРЫ, ВЫЗЫВАЕМЫЕ ИЗ ОБРАБОТЧИКОВ ТИПОВЫХ ФОРМ.

#Область ПрограммныйИнтерфейс

// Переопределяемая процедура, вызываемая из одноименного обработчика события формы
//  типового документа.
//
// Параметры:
//  Форма				 - УправляемаяФорма - форма, из обработчика события которой происходит вызов процедуры.
//  	см. справочную информацию по событиям управляемой формы.
//  Отказ				 - Булево - Стандартный флаг.
//  СтандартнаяОбработка - Булево - Стандартный флаг.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	ИмяДокументаВнутреннееПотребление = питОбратнаяСовместимостьПовтИсп.ИмяДокументаВнутреннееПотребление();
	
	//Возврат; // {debug}
	
	// Условие, тут будут только формы документов, по которым есть смысл делать проверку.
	Если Форма.ИмяФормы = "Документ.ВыпускПродукции.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.СписаниеЗатратНаВыпуск.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ПередачаМатериаловВПроизводство.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказМатериаловВПроизводство.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаПроизводство.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.СборкаТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ОтчетОРозничныхПродажах.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ПроизводствоБезЗаказа.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ДвижениеПродукцииИМатериалов.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.СписаниеНедостачТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.РазрешениеНаЗаменуМатериалов.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.питРегистрацияЗамен.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ОрдерНаОтражениеНедостачТоваров.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПересчетТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ПеремещениеТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = СтрШаблон("Документ.%1.Форма.ФормаДокумента", ИмяДокументаВнутреннееПотребление)
		ИЛИ Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.питКорректировкаОстатковИС.Форма.ФормаДокумента" Тогда
		
		Объект = Форма.Объект;
		мДокументПит = Неопределено;
		мОписаниеПредупреждения = "";
		
		Если Форма.ИмяФормы = "Документ.ЗаказМатериаловВПроизводство.Форма.ФормаДокумента" 
			ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" Тогда
			ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
			РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22);
			Если ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ Объект.Ссылка.Пустая() И питТиповыеДокументы.НайтиДокументпитДляТиповогоДокумента(Объект.Ссылка, мДокументПит, мОписаниеПредупреждения) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(мОписаниеПредупреждения+" Документ открыт в режиме просмотра!",мДокументПит);
			Форма.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация
#Область СлужебныеПроцедурыИФункции
#КонецОбласти
#КонецОбласти

