
#Область ПрограммныйИнтерфейс

#Область ПечатьИзФормыДокументов

// Вывод итогов по странице печатной формы документа.
//
// Параметры:
//  ТабДокумент - Произвольный - Таб документ.
//  ОбластьПодвал - Произвольный - Область подвал.
//  СтруктураИтоговПоСтранице - Структура - Структура итогов по странице.
//  УровеньГруппировки - Произвольный - Уровень группировки.
//
Процедура ВывестиИтогиПоСтранице(ТабДокумент,ОбластьПодвал,СтруктураИтоговПоСтранице,УровеньГруппировки=0) Экспорт
	Если ОбластьПодвал <> Неопределено Тогда
		Если СтруктураИтоговПоСтранице <> Неопределено Тогда
			ФорматВыводаКоличества	= "ЧЦ=15; ЧДЦ=3";
			ФорматВыводаСуммы		= "ЧЦ=15; ЧДЦ=2";
			Для Каждого ЭлементИтога Из СтруктураИтоговПоСтранице Цикл
				Если Найти(ЭлементИтога.Ключ,"Кол")<>0 Тогда
					ЗначениеПараметра=Формат(ЭлементИтога.Значение,ФорматВыводаКоличества);
				Иначе
					ЗначениеПараметра=Формат(ЭлементИтога.Значение,ФорматВыводаСуммы);
				КонецЕсли;
				Попытка
					ОбластьПодвал.Параметры[ЭлементИтога.Ключ] = ЗначениеПараметра;
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьПодвал);
	КонецЕсли;
КонецПроцедуры // ВывестиИтогиПоСтранице()

// Функция, добавляет итоги по странице печатной формы
//
// Параметры:
//  ТекСтрока - СтрокаТабличнойЧасти - обрабатываемая строк.
//  СтруктураИтоговПоСтранице - Структура - Структура итогов по странице.
//
Процедура ДобавитьИтогиПоСтранице(ТекСтрока, СтруктураИтоговПоСтранице) Экспорт
	Для Каждого ЭлементСтруктуры Из СтруктураИтоговПоСтранице Цикл
		Если ЭлементСтруктуры.Ключ = "ВалютаДокумента" Тогда
			Продолжить;
		КонецЕсли;
		НовоеЗначение = ЭлементСтруктуры.Значение + ТекСтрока[ЭлементСтруктуры.Ключ];
		Если ЭлементСтруктуры.Ключ = "СуммаСкидки" Тогда
			Попытка
				НовоеЗначение = НовоеЗначение + ТекСтрока["СуммаСкидкиСтроки"];
			Исключение
			КонецПопытки; 
		КонецЕсли; 
		СтруктураИтоговПоСтранице.Вставить(ЭлементСтруктуры.Ключ,НовоеЗначение);
	КонецЦикла;

КонецПроцедуры
// Функция - Вывести горизонтальную область.
//
// Параметры:
//  ТабДокумент - Произвольный - Таб документ.
//  Область - Произвольный - Область.
//  ОбластьШапка - Произвольный - Область шапка.
//  ОбластьПодвал - Произвольный - Область подвал.
//  НомерСтраницы - Произвольный - Номер страницы.
//  СтруктураИтоговПоСтранице - Структура - Структура итогов по странице.
//  мсвДопОбластиПодвала - Произвольный - мсв доп области подвала.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ВывестиГоризонтальнуюОбласть(ТабДокумент, Область, ОбластьШапка = Неопределено, ОбластьПодвал = Неопределено, НомерСтраницы = 1,
	СтруктураИтоговПоСтранице = Неопределено, мсвДопОбластиПодвала = Неопределено) Экспорт
	
	// Запишем их в один массив
	МассивОбластейДляПроверки = Новый Массив();
	Если ТипЗнч(Область)=Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из Область Цикл
			МассивОбластейДляПроверки.Добавить(ЭлементМассива);	
		КонецЦикла;
	Иначе
		МассивОбластейДляПроверки.Добавить(Область);
	КонецЕсли;
	Если ОбластьПодвал <> Неопределено Тогда
		МассивОбластейДляПроверки.Добавить(ОбластьПодвал);
	КонецЕсли;
	Если мсвДопОбластиПодвала <> Неопределено Тогда
		Для Каждого ТекОбласть Из мсвДопОбластиПодвала Цикл
			МассивОбластейДляПроверки.Добавить(ТекОбласть);
		КонецЦикла;
	КонецЕсли;
	
	// Проверим, помещаются ли на странице
	РезультатПроверки = питОбщегоНазначенияСервер.ПроверитьВыводТабличногоДокумента(ТабДокумент, МассивОбластейДляПроверки, Истина);
	
	// Если не помещаются
	Если НЕ РезультатПроверки Тогда
		ВывестиИтогиПоСтранице(ТабДокумент,ОбластьПодвал,СтруктураИтоговПоСтранице); // Выводим итог по странице
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц(); // Переходим на следующую страницу
		Если ОбластьШапка <> Неопределено Тогда
			Попытка
				ОбластьШапка.Параметры["НомерСтраницы"]	= ?(ТипЗнч(НомерСтраницы)=Тип("Число") И НомерСтраницы>0,"Страница:"+НомерСтраницы,"");
			Исключение КонецПопытки;			
			ТабДокумент.Вывести(ОбластьШапка); // Выводим шапку таблицы
		КонецЕсли;
		НомерСтраницы = НомерСтраницы + 1;
	КонецЕсли;
	
	Если ТипЗнч(Область)=Тип("Массив") Тогда
		Для Каждого ЭлементМассива Из Область Цикл
			ТабДокумент.Вывести(ЭлементМассива);	
		КонецЦикла;
	Иначе
		// Выводим текущую область
		ТабДокумент.Вывести(Область);
	КонецЕсли;
	
	Возврат НомерСтраницы;
	
КонецФункции // ВывестиГоризонтальнуюОбласть()

#КонецОбласти

// Определяет, что текущий способ расчета рецептур равен по актуальной рецептуре.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОпределитьСпособРасчетаРецептурыПоАктуальной() Экспорт
	
	// СпособРасчетаРецептуры = Константы.питСпособРасчетаРецептур.Получить();
	СпособРасчетаРецептуры = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
	СпособРасчетаРецептурыПоАктуальной = (СпособРасчетаРецептуры = Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре);
	Возврат СпособРасчетаРецептурыПоАктуальной;
	
КонецФункции


// Определяет номер иконки номенклатуры по виду номенклатуры и флагу специя.
//  Используется в формах документа Рецептура.
//
// Параметры:
//  питВидНоменклатуры - Произвольный - пит вид номенклатуры.
//  Специя - Произвольный - Специя.
//  ПриготовлениеРазрешено - Произвольный - Приготовление разрешено.
//  ЭтоМодификатор - Произвольный - Это модификатор.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОпределитьНомерИконкиНоменклатуры(питВидНоменклатуры, Специя, ПриготовлениеРазрешено = Истина, ЭтоМодификатор = Ложь) Экспорт
	
	НомерИконки = 10; // нет иконки
	
	Если питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар Тогда
		
		Если ЭтоМодификатор Тогда
			НомерИконки = 8;
		Иначе
			НомерИконки = 2;
		КонецЕсли;
		
		
	ИначеЕсли питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо Тогда
		
		Если ЭтоМодификатор Тогда
			НомерИконки = 7;
		Иначе
			Если ПриготовлениеРазрешено Тогда
				НомерИконки = 0;
			Иначе
				НомерИконки = 2;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли питВидНоменклатуры = Перечисления.питВидыНоменклатуры.БизнесЛанч Тогда
		НомерИконки = 6;
	ИначеЕсли питВидНоменклатуры = Перечисления.питВидыНоменклатуры.ТехнологическийИнгредиент Тогда
		НомерИконки = 4;
	КонецЕсли;
	
	Если Специя=Истина Тогда
		НомерИконки = НомерИконки + 1;
	КонецЕсли;
	
	Возврат НомерИконки;
	
КонецФункции



// Проверяет можно ли данное подразделение выбирать в документах выпуска продукции модуля пит
//
// Параметры:
//  Подразделение - Произвольный - Подразделение.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПроверитьПроизводственноеПодразделение(Подразделение) Экспорт
	Рез = Истина;
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	Если НЕ ФормироватьДокументыПроизводства22 Тогда
		Если ЗначениеЗаполнено(Подразделение) И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "ИспользуетсяСписаниеЗатратНаВыпуск") Тогда
			ТекстСообщения = НСтр("ru = 'Необходимо выбрать подразделение в котором используется производство без заказов с документами списание затрат на выпуск.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Рез = Ложь;
			
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Подразделение) И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "ПроизводствоБезЗаказов") Тогда
			ТекстСообщения = НСтр("ru = 'Необходимо выбрать подразделение, которое производит продукцию без заказов на производство.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Рез = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Процедура устанавливает использование плановой стоимости в документе.
//
// Параметры:
//  ИспользоватьПлановуюСтоимость - Булево - Флаг использования плановой стоимости в документах.
//  Документ - Булево - Флаг использования плановой стоимости в документах.
//
Процедура УстановитьИспользованиеПлановойСтоимости(ИспользоватьПлановуюСтоимость, Документ) Экспорт
	
	ПериодУчетнойПолитики = ?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДатаСеанса());
	// +25
//   ПараметрыПолитики = РегистрыСведений.УчетнаяПолитикаОрганизаций.ПараметрыУчетнойПолитики(Документ.Организация,
// ПериодУчетнойПолитики);.
	ПараметрыПолитики = НастройкиНалоговУчетныхПолитик.ДействующиеПараметрыНалоговУчетныхПолитик("УчетнаяПолитикаФинансовогоУчета", 
		Документ.Организация, 
		ПериодУчетнойПолитики);
	// -25
	Если ПараметрыПолитики <> Неопределено Тогда
		ИспользоватьПлановуюСтоимость = ПараметрыПолитики.УчетГотовойПродукцииПоПлановойСтоимости;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти




