
#Область ПрограммныйИнтерфейс

#Область ФормаПланПроизводства

// Процедура вызывается в начале типовой процедуры "При чтении на сервере" документа "План производства".
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма документа "План производства".
//
Процедура ПриЧтенииНаСервереВНачале(ЭтаФорма) Экспорт
	СоздатьЭлементыФормыПланаПроизводства(ЭтаФорма);
КонецПроцедуры

// Процедура вызывается при создании на сервере документа "План производства" и создает элементы, если это вид плана
//  общепит.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма документа "План производства".
//  ЭтоВидПланаОбщепит - Произвольный - Знач это вид плана общепит.
//
Процедура СоздатьЭлементыФормыПланаПроизводства(Форма, Знач ЭтоВидПланаОбщепит = Неопределено) Экспорт
	
	Если Форма.Элементы.Найти("ПродукцияпитРецептура") = Неопределено Тогда // Только если элементы еще не созданы.
		
		// Добавляем реквизит формы "питРецептура" в таблицу "ПродукцияПоДатам".
		МассивДобавляемыхРеквизитов = Новый Массив;
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питРецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"), "Объект.Продукция"));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питРецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"), "ПродукцияПоДатам"));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питРецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"), "ПолуфабрикатыПоДатам"));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питРецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"), "ВсеПолуфабрикатыПоДатам"));
		Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
		
		// Добавляем элемент формы питРецептура в таблицу Продукция
		ПолеВвода = Форма.Элементы.Вставить("ПродукцияпитРецептура",
			Тип("ПолеФормы"), 
			Форма.Элементы.Продукция,
			Форма.Элементы.ПродукцияСпецификация);
		ПолеВвода.ПутьКДанным = "Объект.Продукция.питРецептура";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Рецептура";
		ПолеВвода.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
		ПолеВвода.ТолькоПросмотр = Истина;
		ПолеВвода.Видимость = Ложь;
		
		// Добавляем элемент формы питРецептура в таблицу ПродукцияПоДатам
		ПолеВвода = Форма.Элементы.Вставить("ПродукцияПоДатампитРецептура",
			Тип("ПолеФормы"), 
			Форма.Элементы.ГруппаФиксацияСлева,
			Форма.Элементы.ПродукцияПоДатамСпецификация);
		ПолеВвода.ПутьКДанным = "ПродукцияПоДатам.питРецептура";
		ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
		ПолеВвода.Заголовок = "Рецептура";
		МассивПараметровВыбора = Новый Массив;
		МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("Отбор.ХозяйственнаяОперация", Перечисления.питХозяйственныеОперации.РецептураПриготовление));
		ПолеВвода.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
		МассивСвязейПараметровВыбора = Новый Массив;
		МассивСвязейПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Номенклатура", "Элементы.ПродукцияПоДатам.ТекущиеДанные.Номенклатура", РежимИзмененияСвязанногоЗначения.Очищать));
		МассивСвязейПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Характеристика", "Элементы.ПродукцияПоДатам.ТекущиеДанные.Характеристика", РежимИзмененияСвязанногоЗначения.Очищать));
		ПолеВвода.СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязейПараметровВыбора);
		ПолеВвода.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
		ПолеВвода.ТолькоПросмотр = Истина;
		ПолеВвода.Видимость = Ложь;
		
		// Заполнение созданного реквизита.
		Для каждого ТекСтрокаПродукции Из Форма.Объект.Продукция Цикл
			ТекСтрокаПродукции.питРецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекСтрокаПродукции.Номенклатура, ТекСтрокаПродукции.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
				Форма.Объект.НачалоПериода,,,,,,Форма.Объект.Подразделение);
		КонецЦикла;
		
		// Удалить отбор реквизита Подразделение-диспетчер
		МассивПараметровВыбора = Новый Массив;
		Форма.Элементы.Подразделение.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
		
		УстановитьВидимостьЭлементовФормыПланаПроизводства(Форма)
		
	КонецЕсли;
КонецПроцедуры

// Процедура вызывается в форме документа "План производства" при установке видимости элементов формы.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма документа "План производства".
//
Процедура УстановитьВидимостьЭлементовФормыПланаПроизводства(ЭтаФорма) Экспорт
	
	Если ЭтаФорма.Элементы.Найти("ПродукцияпитРецептура") = Неопределено Тогда // Только если элементы еще не созданы.
		Возврат;
	КонецЕсли;
	
	// Является ли текущий вид плана общепитным?
	ВидПлана = ЭтаФорма.Объект.ВидПлана;
	ЭтоВидПланаОбщепит = РегистрыСведений.питВидыПлановОбщепит.ЭтоВидПланаОбщепит(ВидПлана);
	Элементы = ЭтаФорма.Элементы;
	
	// Если поменяли вид плана на общепитный то создаем динамически элементы формы.
	СоздатьЭлементыФормыПланаПроизводства(ЭтаФорма, ЭтоВидПланаОбщепит);
	
	// Видимость спецификаций и рецептур.
	Элементы.ПродукцияСпецификация.Видимость = НЕ ЭтоВидПланаОбщепит;
	Элементы.ПродукцияПоДатамСпецификация.Видимость = НЕ ЭтоВидПланаОбщепит;
	Элементы.ПродукцияпитРецептура.Видимость = ЭтоВидПланаОбщепит;
	Элементы.ПродукцияПоДатампитРецептура.Видимость = ЭтоВидПланаОбщепит;
	
	// Для видов плана общепит подразделение будет называться иначе.
	Элементы.Подразделение.Заголовок = ?(ЭтоВидПланаОбщепит, "Подразделение производства", "");
	
	Если ЭтоВидПланаОбщепит 
		И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидПлана, "ЗаполнятьПодразделение") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранный вид плана общепит не имеет детализации по подразделению, планирование полуфабрикатов и материалов будет недоступно!");
		Элементы.ПродукцияПоДатамЗапланироватьПолуфабрикаты.Доступность = Ложь;
		Элементы.ПродукцияЗапланироватьПолуфабрикаты.Доступность = Ложь;
	Иначе
		Элементы.ПродукцияПоДатамЗапланироватьПолуфабрикаты.Доступность = Истина;
		Элементы.ПродукцияЗапланироватьПолуфабрикаты.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Процедура заполняет рецептуру при изменении номенклатуры или характеристики на форме документа "План производства".
//
// Параметры:
//  Форма - УправляемаяФорма - Форма документа "План производства".
//  ТекущаяСтрока - СтрокаТабличнойЧасти - Строка табличной части, где нужно заполнить рецептуру.
//
Процедура НоменклатураХарактеристикаПриИзмененииНаСервере(Форма, ТекущаяСтрока) Экспорт
	
	Объект = Форма.Объект;
	
	Если РегистрыСведений.питВидыПлановОбщепит.ЭтоВидПланаОбщепит(Объект.ВидПлана) Тогда
		// заполняем рецептуру
		ДатаРецептуры = КонецДня(Объект.НачалоПериода);
		ТекущаяСтрока.питРецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
			ДатаРецептуры,,,,,,Объект.Подразделение);
		// обнуляем спецификацию
		ТекущаяСтрока.Спецификация = Неопределено;
	Иначе
		// обнуляем рецептуру
		ТекущаяСтрока.питРецептура = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

// Процедура устанавливает отбор формы списка плана производства.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма документа "План производства".
//
Процедура УстановитьОтборФормыСпискаПланаПроизводства(Форма) Экспорт
	
	ВидыПланов = Новый СписокЗначений();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питВидыПлановОбщепит.ВидПлана КАК ВидПлана
		|ИЗ
		|	РегистрСведений.питВидыПлановОбщепит КАК питВидыПлановОбщепит";
	ВидыПланов.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидПлана"));
	
	ЭлементОтбора = Форма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидПлана");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ЭлементОтбора.ПравоеЗначение = ВидыПланов;
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеЗаказовНаПроизводствоПоПлану

// Процедура создает отраслевые элементы в обработке "формирование заказов на производство по плану".
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма обработки "ФормированиеЗаказовНаПроизводствоПоПлану".
//
Процедура СоздатьЭлементыФормированиеЗаказовНаПроизводствоПоПлану(ЭтаФорма) Экспорт
	
	// Добавляем реквизит формы "питФормированиеЗаказовНаПроизводствоПоПлану".
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питФормированиеЗаказовНаПроизводствоПоПлану", Новый ОписаниеТипов("Булево"), ""));
	// Реквизиты складов
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питСкладМатериалов", Новый ОписаниеТипов("СправочникСсылка.Склады"), "Объект.ФормированиеЗаказов"));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("питСкладПроизводства", Новый ОписаниеТипов("СправочникСсылка.Склады"), "Объект.ФормированиеЗаказов"));
	ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	ЭтаФорма.питФормированиеЗаказовНаПроизводствоПоПлану = Ложь;
	
	// Отбор по видам планов общепит.
	ОтборыКомпоновщика = ЭтаФорма.КомпоновщикНастроек.Настройки.Отбор.Элементы;
	НовыйОтбор = ОтборыКомпоновщика.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидПлана");
	НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	НовыйОтбор.Использование = Истина;
	ВидыПлановОбщепит = Новый СписокЗначений;
	ВидыПлановОбщепит.ЗагрузитьЗначения(РегистрыСведений.питВидыПлановОбщепит.ВсеВидыПлановОбщепит());
	НовыйОтбор.ПравоеЗначение = ВидыПлановОбщепит;
	НовыйОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Если НЕ ЭтаФорма.Параметры.Свойство("питФормированиеЗаказовНаПроизводствоПоПлану") Тогда
		НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
		Возврат;
	КонецЕсли;
	
	Объект = ЭтаФорма.Объект;
	Элементы = ЭтаФорма.Элементы;
	
	// Элементы формы складов
	ПолеВвода = ЭтаФорма.Элементы.Вставить("питСкладМатериалов",
		Тип("ПолеФормы"), 
		Элементы.ФормированиеЗаказов,
		Элементы.ФормированиеЗаказовСклад);
	ПолеВвода.ПутьКДанным = "Объект.ФормированиеЗаказов.питСкладМатериалов";
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.Заголовок = "Склад материалов";
	ПолеВвода.КартинкаШапки = БиблиотекаКартинок.Изменить;
	
	ПолеВвода = ЭтаФорма.Элементы.Вставить("питСкладПроизводства",
		Тип("ПолеФормы"), 
		Элементы.ФормированиеЗаказов,
		Элементы.ФормированиеЗаказовСклад);
	ПолеВвода.ПутьКДанным = "Объект.ФормированиеЗаказов.питСкладПроизводства";
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.Заголовок = "Склад производства";
	ПолеВвода.КартинкаШапки = БиблиотекаКартинок.Изменить;
	
	Элементы.ФормированиеЗаказовСклад.Заголовок = "Склад реализации";
	
	
	// Общие изменения формы
	ЭтаФорма.питФормированиеЗаказовНаПроизводствоПоПлану = Истина;
	ЭтаФорма.АвтоЗаголовок = Ложь;
	ЭтаФорма.Заголовок = "Формирование планов-меню по планам производства";
	
	// Страница "Отбор планов"
	Элементы.ГруппаПростыОтборы.Заголовок = "Создавать планы-меню по:";
	Элементы.ТипПроизводственногоПроцесса.ТолькоПросмотр = Истина;
	Объект.ТипПроизводственногоПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
	Элементы.Подразделение.Заголовок = "Подразделение производства";
	// Удалить отбор реквизита Подразделение-диспетчер
	МассивПараметровВыбора = Новый Массив;
	Элементы.Подразделение.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
	// Страница "Определение состава и объема заказа"
	Элементы.ДалееШаг2.Заголовок = СтрЗаменить(Элементы.ДалееШаг2.Заголовок, "заказы", "планы-меню");
	
	// Страница "Уточнение сформированных заказов"
	ТекстЗапроса = "ВЫБРАТЬ
	|	питПланМеню.Ссылка КАК Ссылка,
	|	питПланМеню.Дата КАК Дата,
	|	питПланМеню.Номер КАК Номер,
	|	питПланМеню.Организация КАК Организация,
	|	питПланМеню.Подразделение КАК Подразделение,
	|	питПланМеню.ДатаПлан КАК ДатаПлан,
	|	питПланМеню.Склад КАК Склад,
	|	питПланМеню.ЦеховаяКладовая КАК ЦеховаяКладовая,
	|	питПланМеню.СкладРеализации КАК СкладРеализации,
	|	питПланМеню.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.питПланМеню КАК питПланМеню";
	СтрокаКолонок = "Ссылка;Дата;Номер;Организация;Подразделение;ДатаПлан;Склад материалов,Склад;ЦеховаяКладовая;СкладРеализации;Комментарий";
	МассивКолонок = СтрРазделить(СтрокаКолонок, ";");
	питОбщегоНазначения.СозданиеДинамическогоСписка(ЭтаФорма, "питСписок", ТекстЗапроса, МассивКолонок,,"Документ.питПланМеню", "СтраницаШаг3",,,);
	
	Элементы.Список2_2.Видимость = Ложь;
	Элементы.Список2_1.Видимость = Ложь;
	ЭтаФорма["СформированныеЗаказы"].ТипЗначения = Новый ОписаниеТипов("ДокументСсылка.питПланМеню");
	Элементы.питСписок.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	
	КоманднаяПанельНовая = Элементы.Вставить("питСписокНоваяКоманднаяПанель", Тип("ГруппаФормы"), Элементы.СтраницаШаг3, Элементы.питСписок);
	КоманднаяПанельНовая .Вид = ВидГруппыФормы.КоманднаяПанель;
	
	Новком = ЭтаФорма.Команды.Добавить("питСписокПровести");
	Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	Новком = ЭтаФорма.Команды.Добавить("питСписокОтменаПроведения");
	Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	Новком = ЭтаФорма.Команды.Добавить("питСписокУстановитьПометкуУдаления");
	Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	
	Новком = ЭтаФорма.Команды.Добавить("питОткрытьПланыМеню");
	Новком.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
	
	питСписок = ЭтаФорма.Элементы.Добавить("питСписокПровести",
		Тип("КнопкаФормы"), 
		КоманднаяПанельНовая);
	питСписок.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	питСписок.Заголовок = "Провести";
	питСписок.Картинка = БиблиотекаКартинок.Провести;
	питСписок.ИмяКоманды = "питСписокПровести";
	питСписок.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
	питСписок = ЭтаФорма.Элементы.Добавить("питСписокОтменаПроведения",
		Тип("КнопкаФормы"), 
		КоманднаяПанельНовая);
	питСписок.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	питСписок.Заголовок = "Отменить проведение";
	питСписок.ИмяКоманды = "питСписокОтменаПроведения";
	
	питСписок = ЭтаФорма.Элементы.Добавить("питСписокУстановитьПометкуУдаления",
		Тип("КнопкаФормы"), 
		КоманднаяПанельНовая);
	питСписок.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	питСписок.Заголовок = "Пометить на удаление / Снять пометку";
	питСписок.ИмяКоманды = "питСписокУстановитьПометкуУдаления";
	
	//СтраницаШаг3
	питНадпись = ЭтаФорма.Элементы.Вставить("питОткрытьПланыМеню",
		Тип("КнопкаФормы"), 
		ЭтаФорма.Элементы["СтраницаШаг3"],
		ЭтаФорма.Элементы.ОткрытьСписокЗаказов);
	питСписок.Вид = ВидКнопкиФормы.Гиперссылка;
	питСписок.Заголовок = "Перейти в общий список планов-меню";
	питСписок.ИмяКоманды = "питОткрытьПланыМеню";
	
	ЭтаФорма.Элементы.ОткрытьСписокЗаказов.Видимость = Ложь;
	
КонецПроцедуры

// Процедура подготавливает данные заполнения при создании заказов в обработке
//  "ФормированиеЗаказовНаПроизводствоПоПлану".
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма обработки "ФормированиеЗаказовНаПроизводствоПоПлану".
//  ДокументОбъект - ДокументОбъект - Объект документа, который будет заполняться, подменяем его на отраслевой.
//  ДанныеЗаполнения - Структура - Структура данных заполнения.
//
Процедура ПодготовитьДанныеЗаполнения(ЭтаФорма, ДокументОбъект, ДанныеЗаполнения) Экспорт
	
	Если НЕ ЭтаФорма.Параметры.Свойство("питФормированиеЗаказовНаПроизводствоПоПлану") Тогда
		Попытка
			Если НЕ ЭтаФорма.питФормированиеЗаказовНаПроизводствоПоПлану Тогда
				Возврат;
			КонецЕсли;
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	// Подмена документ-объект
	ДокументОбъект = Документы.питПланМеню.СоздатьДокумент();
	
	// Дополнение данных заполнения отраслевыми данными.
	Если ДанныеЗаполнения.Свойство("ДатаВыпуска") Тогда
		ДанныеЗаполнения.Вставить("ДатаПлан", ДанныеЗаполнения.ДатаВыпуска);
	КонецЕсли;
	Если ДанныеЗаполнения.Свойство("Склад") Тогда
		ДанныеЗаполнения.Вставить("СкладРеализации", ДанныеЗаполнения.Склад);
	КонецЕсли;
	Если ДанныеЗаполнения.Свойство("питСкладМатериалов") Тогда
		ДанныеЗаполнения.Вставить("Склад", ДанныеЗаполнения.питСкладМатериалов);
		ДанныеЗаполнения.Вставить("ЦеховаяКладовая", ДанныеЗаполнения.питСкладПроизводства);
		ДанныеЗаполнения.Вставить("СкладРеализации", ДанныеЗаполнения.питСкладПроизводства);
	КонецЕсли;
	Если ДанныеЗаполнения.Свойство("питСкладПроизводства") Тогда
		ДанныеЗаполнения.Вставить("ЦеховаяКладовая", ДанныеЗаполнения.питСкладПроизводства);
		ДанныеЗаполнения.Вставить("СкладРеализации", ДанныеЗаполнения.питСкладПроизводства);
	КонецЕсли;
	ДанныеЗаполнения.Вставить("Статус", Перечисления.питСтатусыПлановМеню.КОбеспечению);
	
КонецПроцедуры

// Процедура изменяет выбранную схему компоновки данных формирования заказов на производство по плану под отраслевые
//  данные.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма обработки "ФормированиеЗаказовНаПроизводствоПоПлану".
//  СхемаКомпоновкиДанных - СхемаКомпоновкиДанных - Типовая схема компоновки данных.
//
Процедура ИзменитьВыбраннуюСхемуКомпоновкиДанныхФормированияЗаказовНаПроизводствоПоПлану(ЭтаФорма, СхемаКомпоновкиДанных) Экспорт
	
	Если НЕ ЭтаФорма.Параметры.Свойство("питФормированиеЗаказовНаПроизводствоПоПлану") Тогда
		Попытка
			Если НЕ ЭтаФорма.питФормированиеЗаказовНаПроизводствоПоПлану Тогда
				Возврат;
			КонецЕсли;
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	// Получаем старый текст запроса и разбиваем его на пакеты.
	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;
	МассивТекстовЗапроса = СтрРазделить(ТекстЗапроса, ";");
	НовыйМассивТекстовЗапроса = Новый Массив;
	
	Для каждого ТекущийТекстЗапроса Из МассивТекстовЗапроса Цикл
		
		Если СтрНайти(ТекущийТекстЗапроса, "ПОМЕСТИТЬ Заказы") Тогда
			
			// Нашли временную таблицу "Заказы".
			// Заменим ее на отраслевую, где данные выбираются из документа "План-меню".
			НовыйТекстЗапроса = "ВЫБРАТЬ
			|	ВЫБОР ВЫРАЗИТЬ(&Сценарий КАК Справочник.СценарииТоварногоПланирования).Периодичность
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, НЕДЕЛЯ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ДЕКАДА)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, МЕСЯЦ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, КВАРТАЛ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ПОЛУГОДИЕ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ГОД)
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ДЕНЬ)
			|	КОНЕЦ КАК ДатаПотребности,
			|	ПланМенюТовары.Номенклатура КАК Номенклатура,
			|	ПланМенюТовары.Характеристика КАК Характеристика,
			|	ВЫБОР
			|		КОГДА &ПланированиеПоНазначениям
			|			ТОГДА ПланМенюТовары.Назначение
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
			|	КОНЕЦ КАК Назначение,
			|	ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка) КАК Спецификация,
			|	СУММА(ПланМенюТовары.Количество) КАК Количество,
			|	ПланМеню.Подразделение КАК Подразделение,
			|	ПланМеню.СкладРеализации КАК Склад
			|	%СсылкаНаЗаказ%
			|ПОМЕСТИТЬ Заказы
			|ИЗ
			|	Документ.питПланМеню.Товары КАК ПланМенюТовары
			|		{ЛЕВОЕ СОЕДИНЕНИЕ ОтборПоСегментуНоменклатуры КАК ОтборПоСегментуНоменклатуры
			|		ПО ПланМенюТовары.Номенклатура = ОтборПоСегментуНоменклатуры.Номенклатура
			|			И ПланМенюТовары.Характеристика = ОтборПоСегментуНоменклатуры.Характеристика}
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.питПланМеню КАК ПланМеню
			|		ПО ПланМенюТовары.Ссылка = ПланМеню.Ссылка
			|ГДЕ
			|	ПланМенюТовары.Ссылка.Проведен
			|	И ВЫБОР
			|			КОГДА &Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ПланМенюТовары.Ссылка.Подразделение = &Подразделение
			|					ИЛИ НЕ &ОтборПодразделения
			|		КОНЕЦ
			|	И (НЕ &ОтборПоНазначению
			|			ИЛИ ПланМенюТовары.Назначение = &Назначение)
			|	И ВЫБОР
			|			КОГДА &НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ПланМеню.ДатаПлан >= &НачалоПериода
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА &ОкончаниеПериода = ДАТАВРЕМЯ(1, 1, 1)
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ПланМеню.ДатаПлан <= &ОкончаниеПериода
			|		КОНЕЦ
			|{ГДЕ
			|	(ОтборПоСегментуНоменклатуры.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры),
			|	ПланМенюТовары.Рецептура.*,
			|	ПланМенюТовары.Номенклатура.*,
			|	ПланМенюТовары.Характеристика.*}
			|
			|СГРУППИРОВАТЬ ПО
			|	ПланМенюТовары.Номенклатура,
			|	ПланМенюТовары.Характеристика,
			|	ВЫБОР
			|		КОГДА &ПланированиеПоНазначениям
			|			ТОГДА ПланМенюТовары.Назначение
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
			|	КОНЕЦ,
			|	ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка),
			|	ВЫБОР ВЫРАЗИТЬ(&Сценарий КАК Справочник.СценарииТоварногоПланирования).Периодичность
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, НЕДЕЛЯ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ДЕКАДА)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, МЕСЯЦ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, КВАРТАЛ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ПОЛУГОДИЕ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ГОД)
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ПланМеню.ДатаПлан, ДЕНЬ)
			|	КОНЕЦ,
			|	ПланМеню.Подразделение,
			|	ПланМеню.СкладРеализации
			|	%СсылкаНаЗаказГруппировка%";
			
			Если СтрНайти(ТекущийТекстЗапроса, "Ссылка КАК ЗаказНаПроизводство") Тогда
				// Если в исходном тексте запроса есть ссылка на заказ, то и в заменяемом тоже добавим.
				НовыйТекстЗапроса = СтрЗаменить(НовыйТекстЗапроса, "%СсылкаНаЗаказ%", ",ПланМеню.Ссылка КАК ЗаказНаПроизводство");
				НовыйТекстЗапроса = СтрЗаменить(НовыйТекстЗапроса, "%СсылкаНаЗаказГруппировка%", ",ПланМеню.Ссылка");
			Иначе
				// По умолчанию ссылку на заказ не добавляем.
				НовыйТекстЗапроса = СтрЗаменить(НовыйТекстЗапроса, "%СсылкаНаЗаказ%", "");
				НовыйТекстЗапроса = СтрЗаменить(НовыйТекстЗапроса, "%СсылкаНаЗаказГруппировка%", "");
			КонецЕсли;
			
			НовыйМассивТекстовЗапроса.Добавить(НовыйТекстЗапроса);
			
		ИначеЕсли СтрНайти(ТекущийТекстЗапроса, "РегистрНакопления.ПланыПроизводства.Обороты(") Тогда
			
//   Общепитный запрос обращается не к регистру накопления а напрямую к табличной части документа для того, чтобы
// поставить фильтр.
			// и выбрать только те строки, у которых колонка Полуфабрикат в значении ИСТИНА.
			// Этого нельзя сделать в регистре накопления, т.к. колонка "ЭтоПолуфабрикат" в нем всегда ЛОЖЬ
			// из-за того, что не заполнена спецификация номенклатуры.
			НовыйТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР ВЫРАЗИТЬ(&Сценарий КАК Справочник.СценарииТоварногоПланирования).Периодичность
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, НЕДЕЛЯ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕКАДА)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, МЕСЯЦ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, КВАРТАЛ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ПОЛУГОДИЕ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ГОД)
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕНЬ)
			|	КОНЕЦ КАК ДатаВыпуска,
			|	ВЫБОР ВЫРАЗИТЬ(&Сценарий КАК Справочник.СценарииТоварногоПланирования).Периодичность
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, НЕДЕЛЯ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕКАДА)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, МЕСЯЦ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, КВАРТАЛ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ПОЛУГОДИЕ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ГОД)
			|		ИНАЧЕ НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕНЬ)
			|	КОНЕЦ КАК НачалоПериодаВыпуска,
			|	МИНИМУМ(ПланПроизводстваПродукция.ДатаВыпуска) КАК ДатаЗаказа,
			|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаВыпускаПолуфабриката,
			|	ПланПроизводстваПродукция.Номенклатура КАК Номенклатура,
			|	ПланПроизводстваПродукция.Характеристика КАК Характеристика,
			|	ПланПроизводстваПродукция.Назначение КАК Назначение,
			|	СУММА(ПланПроизводстваПродукция.Количество) КАК КоличествоВПланах,
			|	ПланПроизводстваПродукция.Ссылка.Подразделение КАК Подразделение,
			|	ПланПроизводстваПродукция.Спецификация КАК Спецификация,
			|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК ПодразделениеВыпускаПродукции,
			|	0 КАК КоличествоПродукцииВСпецификации,
			|	0 КАК ДнейДоЗаказа,
			|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад
			|ПОМЕСТИТЬ ТаблицаПланов
			|ИЗ
			|	Документ.ПланПроизводства.Продукция КАК ПланПроизводстваПродукция
			|ГДЕ
			|	ПланПроизводстваПродукция.Ссылка.ТипПроизводственногоПроцесса = &ТипПроизводственногоПроцесса
			|	И ПланПроизводстваПродукция.Количество > 0
			|	И НЕ ПланПроизводстваПродукция.Отменено
			|	И ПланПроизводстваПродукция.Ссылка.Проведен
			|	И ПланПроизводстваПродукция.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
			|	И ПланПроизводстваПродукция.Ссылка.Сценарий = &Сценарий
			|	И (НЕ &ОтборПоНазначению
			|			ИЛИ ПланПроизводстваПродукция.Назначение = &Назначение)
			|	И (&НачалоПериодаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ (ПланПроизводстваПродукция.ДатаВыпуска >= &НачалоПериодаЗаказа
			|				ИЛИ ПланПроизводстваПродукция.ДатаВыпуска = ДАТАВРЕМЯ(1, 1, 1)))
			|	И (&ОкончаниеПериодаЗаказа = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ ПланПроизводстваПродукция.ДатаВыпуска <= &ОкончаниеПериодаЗаказа)
			|	И (&НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ (ПланПроизводстваПродукция.ДатаВыпуска >= &НачалоПериода
			|				ИЛИ ПланПроизводстваПродукция.ДатаВыпуска = ДАТАВРЕМЯ(1, 1, 1)))
			|	И (&ОкончаниеПериода = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ ПланПроизводстваПродукция.ДатаВыпуска <= &ОкончаниеПериода)
			|	И НЕ ПланПроизводстваПродукция.Полуфабрикат
			|{ГДЕ
			|	ПланПроизводстваПродукция.Ссылка.ВидПлана КАК ВидПлана,
			|	(ПланПроизводстваПродукция.ДатаВыпуска >= &НачалоПериода) КАК НачалоПериода,
			|	(ПланПроизводстваПродукция.ДатаВыпуска <= &ОкончаниеПериода) КАК ОкончаниеПериода,
			|	ПланПроизводстваПродукция.Номенклатура.* КАК Номенклатура,
			|	ПланПроизводстваПродукция.Характеристика.* КАК Характеристика,
			|	((ПланПроизводстваПродукция.Номенклатура, ПланПроизводстваПродукция.Характеристика) В
			|			(ВЫБРАТЬ
			|				ОтборПоСегментуНоменклатуры.Номенклатура,
			|				ОтборПоСегментуНоменклатуры.Характеристика
			|			ИЗ
			|				ОтборПоСегментуНоменклатуры КАК ОтборПоСегментуНоменклатуры
			|			ГДЕ
			|				ОтборПоСегментуНоменклатуры.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК ИспользуетсяОтборПоСегментуНоменклатуры}
			|
			|СГРУППИРОВАТЬ ПО
			|	ВЫБОР ВЫРАЗИТЬ(&Сценарий КАК Справочник.СценарииТоварногоПланирования).Периодичность
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, НЕДЕЛЯ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕКАДА)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, МЕСЯЦ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, КВАРТАЛ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ПОЛУГОДИЕ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ГОД)
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕНЬ)
			|	КОНЕЦ,
			|	ВЫБОР ВЫРАЗИТЬ(&Сценарий КАК Справочник.СценарииТоварногоПланирования).Периодичность
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, НЕДЕЛЯ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Декада)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕКАДА)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Месяц)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, МЕСЯЦ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, КВАРТАЛ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Полугодие)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ПОЛУГОДИЕ)
			|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
			|			ТОГДА НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ГОД)
			|		ИНАЧЕ НАЧАЛОПЕРИОДА(ПланПроизводстваПродукция.ДатаВыпуска, ДЕНЬ)
			|	КОНЕЦ,
			|	ПланПроизводстваПродукция.Номенклатура,
			|	ПланПроизводстваПродукция.Характеристика,
			|	ПланПроизводстваПродукция.Назначение,
			|	ПланПроизводстваПродукция.Ссылка.Подразделение,
			|	ПланПроизводстваПродукция.Спецификация";
			
			НовыйМассивТекстовЗапроса.Добавить(НовыйТекстЗапроса);
			
		Иначе
			
			НовыйМассивТекстовЗапроса.Добавить(ТекущийТекстЗапроса);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Устанавливаем новый текст запроса.
	СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = СтрСоединить(НовыйМассивТекстовЗапроса, ";");
	
КонецПроцедуры

// Процедура выполняет переданное действие формы для переданного массива документов.
//
// Параметры:
//  Действие - Строка - Действие, которое необходимо выполнить.
//  Документы - Массив - Массив документов, над которыми необходимо выполнить действие.
//
Процедура ВыполнитьДействиеФормы(Действие, Документы) Экспорт
	
	Для каждого ТекущийДокумент Из Документы Цикл
		ДокументОбъект = ТекущийДокумент.ПолучитьОбъект();
		Если Действие = "питСписокПровести" Тогда
			Попытка
				Если ДокументОбъект.ПроверитьЗаполнение() Тогда
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
			Исключение
				ТекстОшибки = ТекстОшибки + "
				|Ошибка проведения документа """ + ДокументОбъект.Метаданные().Представление() + """
				|по причине: <"+ОписаниеОшибки()+">";
			КонецПопытки;
		ИначеЕсли Действие = "питСписокОтменаПроведения" Тогда
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
				ТекстОшибки = ТекстОшибки + "
				|Ошибка отмены проведения документа """ + ДокументОбъект.Метаданные().Представление() + """
				|по причине: <"+ОписаниеОшибки()+">";
			КонецПопытки;
		ИначеЕсли Действие = "питСписокУстановитьПометкуУдаления" Тогда
			Попытка
				ДокументОбъект.УстановитьПометкуУдаления(НЕ ДокументОбъект.ПометкаУдаления);
			Исключение
				ТекстОшибки = ТекстОшибки + "
				|Ошибка установки/снятия пометки удаления документа """ + ДокументОбъект.Метаданные().Представление() + """
				|по причине: <"+ОписаниеОшибки()+">";
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура вызывает типовую обработку ТЧ Созданного документа по переданной структуре действий.
//  Предварительно вычисляется имя ТЧ в зависимости от того, отраслевой это запуск обработки или нет.
//  Вызывается на форме обработки "ФормированиеЗаказовНаПроизводствоПоПлану".
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - Форма обработки "ФормированиеЗаказовНаПроизводствоПоПлану".
//  ДокументОбъект - ДокументОбъект - Созданный документ.
//  СтруктураДействий - Структура - Структура действий с табличной частью.
//  КэшированныеЗначения - Структура - Структура кешированных значений.
//
Процедура ОбработатьТЧСозданногоДокумента(ЭтаФорма, ДокументОбъект, СтруктураДействий, КэшированныеЗначения) Экспорт
	ИмяТЧ = ?(ЭтаФорма["питФормированиеЗаказовНаПроизводствоПоПлану"], "Товары", "Продукция"); 
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокументОбъект[ИмяТЧ], СтруктураДействий, КэшированныеЗначения);	
КонецПроцедуры

// Функция выполняет заполнение складов и сортировку таблицы формирования заказов из АРМ
//  "ФормированиеЗаказовНаПроизводствоПоПлану" по приоритету приготовления.
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  ТаблицаФормированиеЗаказов - ТаблицаЗначений - Знач таблица формирование заказов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Отсортированная таблица.
Функция МодифицироватьТаблицуФормированияЗаказов(ЭтаФорма, Знач ТаблицаФормированиеЗаказов) Экспорт
	
	Если НЕ ЭтаФорма.Параметры.Свойство("питФормированиеЗаказовНаПроизводствоПоПлану") Тогда
		Попытка
			Если НЕ ЭтаФорма.питФормированиеЗаказовНаПроизводствоПоПлану Тогда
				Возврат ТаблицаФормированиеЗаказов;
			КонецЕсли;
		Исключение
			Возврат ТаблицаФормированиеЗаказов;
		КонецПопытки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ втТаблицаФормированиеЗаказов
	|ИЗ
	|	&ТаблицаФормированиеЗаказов КАК ТаблицаФормированиеЗаказов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблицаФормированиеЗаказов.*,
	|	ЕстьNULL(СхемыОбеспеченияПроизводства.Склад, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК Склад
	|ПОМЕСТИТЬ питВтТовары
	|ИЗ
	|	втТаблицаФормированиеЗаказов КАК втТаблицаФормированиеЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СхемыОбеспеченияПроизводства КАК СхемыОбеспеченияПроизводства
	|			ПО втТаблицаФормированиеЗаказов.ПодразделениеДиспетчер = СхемыОбеспеченияПроизводства.Подразделение
	|			И втТаблицаФормированиеЗаказов.Номенклатура.СхемаОбеспечения = СхемыОбеспеченияПроизводства.СхемаОбеспечения
	|;
	|
	| "+СтрЗаменить(РегистрыСведений.СхемыОбеспечения.ВременнаяТаблицаСпособыОбеспечения("ВЫЧИСЛЯТЬ"), "ВтТовары", "питВтТовары") + "
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтСпособыОбеспечения.Номенклатура,
	|	ВтСпособыОбеспечения.Характеристика,
	|	ВтСпособыОбеспечения.СпособОбеспеченияПотребностей
	|ПОМЕСТИТЬ втСпособыОбеспеченияПроизводствоОбщепит
	|ИЗ
	|	ВтСпособыОбеспечения КАК ВтСпособыОбеспечения
	|ГДЕ
	|	ВтСпособыОбеспечения.СпособОбеспеченияПотребностей.ТипОбеспечения = ЗНАЧЕНИЕ(Перечисление.ТипыОбеспечения.питПроизводство)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питВтТовары.*,
	|	ISNULL(ВтСпособыОбеспечения.СпособОбеспеченияПотребностей.ИсточникОбеспеченияПотребностей, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК питСкладПроизводства,
	|	ISNULL(ВтСпособыОбеспечения.СпособОбеспеченияПотребностей.питСкладМатериалов, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК питСкладМатериалов
	|ИЗ
	|	питВтТовары КАК питВтТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСпособыОбеспеченияПроизводствоОбщепит КАК ВтСпособыОбеспечения
	|		ПО питВтТовары.Номенклатура = ВтСпособыОбеспечения.Номенклатура
	|		И питВтТовары.Характеристика = ВтСпособыОбеспечения.Характеристика
	|";
	Запрос.УстановитьПараметр("ТаблицаФормированиеЗаказов", ТаблицаФормированиеЗаказов);
	ТаблицаФормированиеЗаказов = Запрос.Выполнить().Выгрузить();
	Для каждого ТекущаяСтрока Из ТаблицаФормированиеЗаказов Цикл
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Склад) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.питСкладПроизводства) Тогда
			ТекущаяСтрока.питСкладПроизводства = ТекущаяСтрока.Склад;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.питСкладМатериалов) Тогда
			ТекущаяСтрока.питСкладМатериалов = ТекущаяСтрока.питСкладПроизводства;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаФормированиеЗаказов = питПриоритетыПриготовления.СортироватьТаблицуПоПриоритетуПриготовления(ТаблицаФормированиеЗаказов, "питСкладПроизводства", "ДатаВыпуска");
	
	Возврат ТаблицаФормированиеЗаказов;
	
КонецФункции

// %ИзЕРП% Начало процедуры Обработка.ФормированиеЗаказовНаПроизводствоПоПлану.Форма.Форма.СоздатьЗаказыНаСервере
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ТаблицаЗаказов - ТаблицаЗначений - Знач таблица заказов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ФормированиеПлановМенюПоПланамПроизводстваПолучитьТаблицуЗаказов(Форма, Знач ТаблицаЗаказов) Экспорт
	
	Если НЕ Форма.Параметры.Свойство("питФормированиеЗаказовНаПроизводствоПоПлану") Тогда
		Попытка
			Если НЕ Форма.питФормированиеЗаказовНаПроизводствоПоПлану Тогда
				Возврат ТаблицаЗаказов;
			КонецЕсли;
		Исключение
			Возврат ТаблицаЗаказов;
		КонецПопытки;
	КонецЕсли;
	
	Объект = Форма.Объект;
	ИспользоватьНесколькоСкладов = Форма.ИспользоватьНесколькоСкладов;
	СкладПоУмолчанию = Форма.СкладПоУмолчанию;
	
	// +%ИзЕРП%
	Отбор = Новый Структура("ОтметитьКЗаказу", Истина);
	ТаблицаЗаказов = Объект.ФормированиеЗаказов.Выгрузить(Отбор, "
		| ПодразделениеДиспетчер,
		| Номенклатура,
		| Характеристика,
		| Назначение,
		| НаправлениеДеятельности,
		| Давалец,
		| Договор,
		| Спецификация,
		| Склад,
		// +пит
		| питСкладМатериалов,
		| питСкладПроизводства,
		// -пит
		| ДатаЗаказа,
		| ДатаВыпуска,
		| Упаковка,
		| КоличествоУпаковок,
		| Количество");
	
	Если Не ИспользоватьНесколькоСкладов Тогда
		ТаблицаЗаказов.ЗаполнитьЗначения(СкладПоУмолчанию, "Склад");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЗаказов.ПодразделениеДиспетчер,
	|	ТаблицаЗаказов.Номенклатура,
	|	ТаблицаЗаказов.Характеристика,
	|	ТаблицаЗаказов.Назначение,
	|	ТаблицаЗаказов.НаправлениеДеятельности,
	|	ТаблицаЗаказов.Давалец,
	|	ТаблицаЗаказов.Договор,
	|	ТаблицаЗаказов.Спецификация,
	|	ТаблицаЗаказов.Склад,
	// +пит
	|	ТаблицаЗаказов.питСкладМатериалов,
	|	ТаблицаЗаказов.питСкладПроизводства,
	// -пит
	|	ТаблицаЗаказов.ДатаЗаказа,
	|	ТаблицаЗаказов.ДатаВыпуска,
	|	ТаблицаЗаказов.Упаковка,
	|	ТаблицаЗаказов.КоличествоУпаковок,
	|	ТаблицаЗаказов.Количество
	|ПОМЕСТИТЬ ТаблицаЗаказов
	|ИЗ
	|	&ТаблицаЗаказов КАК ТаблицаЗаказов
	|ГДЕ
	|	ТаблицаЗаказов.КоличествоУпаковок > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЗаказов.ПодразделениеДиспетчер,
	|	ТаблицаЗаказов.Номенклатура,
	|	ТаблицаЗаказов.Характеристика,
	|	ТаблицаЗаказов.Назначение,
	|	ТаблицаЗаказов.НаправлениеДеятельности,
	|	ТаблицаЗаказов.Давалец,
	|	ТаблицаЗаказов.Договор,
	|	ТаблицаЗаказов.Договор.ТипДоговора КАК ТипДоговора,
	|	ТаблицаЗаказов.Спецификация,
	|	ТаблицаЗаказов.Склад,
	// +пит
	|	ТаблицаЗаказов.питСкладМатериалов,
	|	ТаблицаЗаказов.питСкладПроизводства,
	// -пит
	|	ТаблицаЗаказов.ДатаЗаказа КАК ДатаЗаказа,
	|	ТаблицаЗаказов.ДатаВыпуска,
	|	ТаблицаЗаказов.Упаковка,
	|	ТаблицаЗаказов.КоличествоУпаковок,
	|	ТаблицаЗаказов.Количество
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЗаказов.ПодразделениеДиспетчер,
	|	ТаблицаЗаказов.Номенклатура,
	|	ТаблицаЗаказов.Характеристика,
	|	ТаблицаЗаказов.Назначение,
	|	ТаблицаЗаказов.НаправлениеДеятельности,
	|	ТаблицаЗаказов.Давалец,
	|	ТаблицаЗаказов.Договор,
	|	ТаблицаЗаказов.Количество,
	|	ТаблицаЗаказов.Спецификация,
	|	ТаблицаЗаказов.КоличествоУпаковок,
	|	ТаблицаЗаказов.Упаковка,
	|	ТаблицаЗаказов.Склад,
	// +пит
	|	ТаблицаЗаказов.питСкладМатериалов,
	|	ТаблицаЗаказов.питСкладПроизводства,
	// -пит
	|	ТаблицаЗаказов.ДатаЗаказа,
	|	ТаблицаЗаказов.ДатаВыпуска
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаказа";
	
	Запрос.УстановитьПараметр("ТаблицаЗаказов", ТаблицаЗаказов);
	
	СписокОшибок = Новый СписокЗначений;
	
	ТаблицаЗаказов = Запрос.Выполнить().Выгрузить();
	// -%ИзЕРП%
	
	Возврат ТаблицаЗаказов;
	
КонецФункции

// Процедура дополняет колонки свертки заказов в
//  Обработка.ФормированиеЗаказовНаПроизводствоПоПлану.Форма.Форма.СоздатьЗаказыНаСервере.
//
// Параметры:
//  ЭтаФорма - Произвольный - Эта форма.
//  Колонки - Произвольный - Колонки.
//
Процедура ФормированиеПлановМенюПоПланамПроизводстваДополнитьКолонкиСвертки(ЭтаФорма, Колонки) Экспорт
	
	Если НЕ ЭтаФорма.Параметры.Свойство("питФормированиеЗаказовНаПроизводствоПоПлану") Тогда
		Попытка
			Если НЕ ЭтаФорма.питФормированиеЗаказовНаПроизводствоПоПлану Тогда
				Возврат;
			КонецЕсли;
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	Колонки = Колонки + ",питСкладМатериалов,питСкладПроизводства";
КонецПроцедуры

