// %ИзЕРП% Документы.ПланПроизводства.ЗаполнитьДокументПолуфабрикатами
//
// Параметры:
//  Параметры - Произвольный - Знач параметры.
//  АдресХранилища - Произвольный - Знач адрес хранилища.
//
Процедура ЗаполнитьДокументПолуфабрикатами(Знач Параметры, Знач АдресХранилища) Экспорт
	
	// Проверка параметра планирования полуфабрикатов.
	Если НЕ Параметры.Свойство("ПланироватьПолуфабрикаты") Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка заполненности подразделения.
	Если НЕ (Параметры.Свойство("Подразделение")
		И ЗначениеЗаполнено(Параметры.Подразделение)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Планирование полуфабрикатов не выполнено по причине: не заполнено подразделение производства");
		Возврат;
	КонецЕсли;
	
	// Получаем заполняемую таблицу значений из параметров.
	ЗаполняемаяТЧ = Параметры.ЗаполняемаяТЧ;
	Если ЗаполняемаяТЧ.Колонки.Найти("Полуфабрикат") = Неопределено Тогда
		ЗаполняемаяТЧ.Колонки.Добавить("Полуфабрикат", Новый ОписаниеТипов("Булево"));
	КонецЕсли; 
	Если ЗаполняемаяТЧ.Колонки.Найти("Характеристика") = Неопределено Тогда
		ЗаполняемаяТЧ.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КонецЕсли;
	ЗаполняемаяТЧ.Колонки.Добавить("ИспользуемыеСпецификации");
	ЕстьКолонкаОтменено = ЗаполняемаяТЧ.Колонки.Найти("Отменено")<> Неопределено;
	Если ЗаполняемаяТЧ.Колонки.Найти("ДатаВыпускаПродукцииПолуфабриката") = Неопределено Тогда
		ЗаполняемаяТЧ.Колонки.Добавить("ДатаВыпускаПродукцииПолуфабриката", Новый ОписаниеТипов("Дата"));
	КонецЕсли;
	
	Для каждого СтрокаТЧ Из ЗаполняемаяТЧ Цикл
		
		// отмененные и нулевые строки е обрабатываем.
		Если СтрокаТЧ.Количество = 0
			ИЛИ (ЕстьКолонкаОтменено И СтрокаТЧ.Отменено) Тогда
			СтрокаТЧ.ИспользуемыеСпецификации = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.питРецептура) Тогда
			// Поиск рецептуры, если она не была заполнена.
			СтрокаТЧ.питРецептура = питПроизводство.ВернутьОсновнуюРецептуру(СтрокаТЧ.Номенклатура, СтрокаТЧ.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
				Параметры.НачалоПериода,,,,,,Параметры.Подразделение);
		КонецЕсли;
		
		// Заполнение таблицы производства.
		ТаблицаСостава = ПолучитьСоставРецептуры(СтрокаТЧ.питРецептура, Параметры.Подразделение, СтрокаТЧ.Количество, Истина);
		Для каждого ЭлементМатериал Из ТаблицаСостава Цикл
			
			Если НЕ ЗначениеЗаполнено(ЭлементМатериал.Рецептура) Тогда
				// НЕ заполнена рецептура у строки состава - это НЕ вложенный п.ф., такую строку не обрабатываем.
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ЗаполняемаяТЧ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМатериал,	"Номенклатура,Характеристика");
			НоваяСтрока.Количество = ЭлементМатериал.Количество;
			НоваяСтрока.КоличествоУпаковок = ЭлементМатериал.Количество;
			НоваяСтрока.Полуфабрикат = Истина;
			НоваяСтрока.питРецептура = ЭлементМатериал.Рецептура;
			НоваяСтрока.ДатаВыпускаПродукцииПолуфабриката =  ПланированиеКлиентСервер.РассчитатьДатуНачалаПериода(СтрокаТЧ.ДатаВыпуска, Параметры.Периодичность);
			НоваяСтрока.ДатаВыпуска = НоваяСтрока.ДатаВыпускаПродукцииПолуфабриката - ЭлементМатериал.СрокПроизводства * 24*60*60;
			НоваяСтрока.ДатаЗапуска = НоваяСтрока.ДатаВыпуска;
			
			Если Параметры.ЗаполнятьСпецификациюПоПериодам Тогда
				Дата = НоваяСтрока.ДатаВыпуска;
			Иначе
				Если Параметры.Свойство("НачалоПериодаСмещения") Тогда
					Дата = Мин(Параметры.НачалоПериодаСмещения, НоваяСтрока.ДатаВыпуска);
				ИначеЕсли Параметры.Свойство("НачалоПериода") Тогда
					Дата = Мин(Параметры.НачалоПериода, НоваяСтрока.ДатаВыпуска);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаТЧ.ИспользуемыеСпецификации = Неопределено;
		
	КонецЦикла;
	
	// Свертка результата.
	КолонкиГруппировок = "";
	Для Каждого Колонка Из ЗаполняемаяТЧ.Колонки Цикл
		Если Колонка.Имя = "Количество"
			Или Колонка.Имя = "КоличествоУпаковок" Тогда
			Продолжить;
		КонецЕсли;
		Если КолонкиГруппировок <> "" Тогда
			КолонкиГруппировок = КолонкиГруппировок + ",";
		КонецЕсли;
		КолонкиГруппировок = КолонкиГруппировок + Колонка.Имя;
	КонецЦикла;
	ЗаполняемаяТЧ.Свернуть(КолонкиГруппировок, "Количество, КоличествоУпаковок");
	
	ПоместитьВоВременноеХранилище(ЗаполняемаяТЧ, АдресХранилища);
	
КонецПроцедуры

// Процедура заполняет движения плана производства общепит по ингредиентам запланированных блюд и полуфабрикатов.
//  Вызывается в модуле "РасчетПланаПроизводства".
//
// Параметры:
//  СписокДляЗаписи - Массив - Типовой массив, см. "РасчетПланаПроизводства.ВыполнитьРасчетВнутриЗамераВремени" и
//   "РасчетПланаПроизводства.ВыполнитьКорректировкуВнутриЗамераВремени".
//  ПараметрыРасчета - Структура - Типовая структура, см. "РасчетПланаПроизводства.ВыполнитьРасчетВнутриЗамераВремени.
//
Процедура ЗаполнитьДвиженияПланаПроизводстваОбщепит(СписокДляЗаписи, ПараметрыРасчета) Экспорт
	
	// Проверяем, что имеем дело с планом производства общепит.
	Если НЕ(ПараметрыРасчета.Свойство("ПланПроизводства") И ЗначениеЗаполнено(ПараметрыРасчета.ПланПроизводства)
		И питПланирование.ЭтоПланПроизводстваОбщепит(ПараметрыРасчета.ПланПроизводства)) Тогда
		Возврат;
	КонецЕсли;
	
	// Обход типового списка для записи.
	Для каждого СтруктураДляЗаписи Из СписокДляЗаписи Цикл
		
		Если НЕ (СтруктураДляЗаписи.Свойство("Движения") И СтруктураДляЗаписи.Движения.Свойство("ПланыПроизводства")
			И СтруктураДляЗаписи.Движения.Свойство("ПланыПотребленияМатериалов")) Тогда
			// Если в структуре нет движений по плану производства и плану потребления материалов, то ничего не делаем.
			Продолжить;
		КонецЕсли;
		
		// Очищаем старые движения по планам потребления материалов.
		СтруктураДляЗаписи.Движения.ПланыПотребленияМатериалов.Очистить();
		
		// Запоминаем исходное количество строк в таблице.
		КоличествоСтрок = СтруктураДляЗаписи.Движения.ПланыПроизводства.Количество();
		ТекущийНомерСтроки = 0;
		
		Для каждого ТекДвижение Из СтруктураДляЗаписи.Движения.ПланыПроизводства Цикл
			// обход движений по плану производства и расчет планов потребления материалов.
			
			ТекущийНомерСтроки = ТекущийНомерСтроки + 1;
			Если КоличествоСтрок < ТекущийНомерСтроки Тогда
				// Если превысили исходное количество строк - выходим из цикла.
				Прервать;
			КонецЕсли;
			
			Если НЕ ТекДвижение.Количество > 0 Тогда
				// Количество блюда не задано, пропускаем данную строку.
				Продолжить;
			КонецЕсли;
			
			/////////////////////////////////////////////////////////////////////////////////////////
			
			// Поиск актуальной рецептуры.
			АктуальнаяРецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекДвижение.Номенклатура, ТекДвижение.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
				ТекДвижение.ДатаЗапускаВыпуска,,,,,,ПараметрыРасчета.Реквизиты.ПодразделениеДиспетчер);
			Если НЕ ЗначениеЗаполнено(АктуальнаяРецептура) Тогда
				Продолжить;
			КонецЕсли;
			
			// Получение состава рецептуры.
			ТаблицаИнгредиентов = ПолучитьСоставРецептуры(АктуальнаяРецептура, ПараметрыРасчета.Реквизиты.ПодразделениеДиспетчер, ТекДвижение.Количество, Ложь);
			
			Для каждого ТекИнгредиент Из ТаблицаИнгредиентов Цикл
				// обход состава рецептуры
				
				Если ЗначениеЗаполнено(ТекИнгредиент.Рецептура) Тогда
					// Заполнена рецептура у строки состава - это вложенный п.ф., такую строку не обрабатываем.
					Продолжить;
				КонецЕсли;
				
				// Добавляем новое движение в план потребления материалов.
				НовДвижение = СтруктураДляЗаписи.Движения.ПланыПотребленияМатериалов.Добавить();
				ЗаполнитьЗначенияСвойств(НовДвижение, ТекИнгредиент, "Номенклатура, Характеристика, Количество");
				НовДвижение.КЗаказу = ТекИнгредиент.Количество;
				НовДвижение.ВидПлана = ПараметрыРасчета.Реквизиты.ВидПлана;
				НовДвижение.ДатаПроизводства = ТекДвижение.ДатаЗапускаВыпуска;
				НовДвижение.Период = ТекДвижение.Период;
				НовДвижение.КоличествоНаЕдиницуПродукции = ТекИнгредиент.Количество / ТекДвижение.Количество;
				НовДвижение.НоменклатураПродукции = ТекДвижение.Номенклатура;
				НовДвижение.ХарактеристикаПродукции = ТекДвижение.Характеристика;
				НовДвижение.ПланПроизводства = ПараметрыРасчета.ПланПроизводства;
				НовДвижение.ПодразделениеДиспетчер = ПараметрыРасчета.Реквизиты.ПодразделениеДиспетчер;
				НовДвижение.ПодразделениеИсполнитель = ПараметрыРасчета.Реквизиты.ПодразделениеДиспетчер;
				НовДвижение.Регистратор = ТекДвижение.Регистратор;
				НовДвижение.РазделительРасчета = ТекДвижение.РазделительРасчета;
				НовДвижение.Склад = Справочники.Склады.ПустаяСсылка();
				НовДвижение.СодержитРасчетноеКоличество = Ложь;
				НовДвижение.Статус = ТекДвижение.Статус;
				НовДвижение.Сценарий = ТекДвижение.Сценарий;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Функция проверяет, является ли план производства общепитным.
//
// Параметры:
//  СсылкаНаПлан - ДокументСсылка.ПланПроизводства - Ссылка на проверяемый документ.
//
// Возвращаемое значение:
//  Булево - Результат проверки.
Функция ЭтоПланПроизводстваОбщепит(СсылкаНаПлан) Экспорт
	ВидПлана = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаПлан, "ВидПлана");
	Возврат РегистрыСведений.питВидыПлановОбщепит.ЭтоВидПланаОбщепит(ВидПлана);
КонецФункции

// Функция проверяет, является ли план производства общепитным и выдает сообщение пользователю.
//
// Параметры:
//  СсылкаНаПлан - ДокументСсылка.ПланПроизводства - Ссылка на проверяемый документ.
//
// Возвращаемое значение:
//  Булево - Результат проверки.
Функция ПроверитьПланПроизводстваОбщепитВыдатьСообщение(СсылкаНаПлан) Экспорт
	Если НЕ ЗначениеЗаполнено(СсылкаНаПлан) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения документа полуфабрикатами сначала необходимо его записать");
	КонецЕсли;
	Возврат ЭтоПланПроизводстваОбщепит(СсылкаНаПлан);
КонецФункции

// Вызов данной процедуры происходит перед записью документа ПланПроизводства.
//
// Параметры:
//  Источник - ДокументОбъект - Типовой документ.
//  Отказ - Булево - Признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - Режим проведения документа.
//
Процедура питПередЗаписьюПлановПроизводства(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	// Если загрузка данных, то ниче не делаем.
	ИдетЗагрузкаДанных = Ложь;
	Попытка
		ИдетЗагрузкаДанных = Источник.ОбменДанными.Загрузка;
	Исключение
	КонецПопытки;
	Если ИдетЗагрузкаДанных Тогда
		Возврат;
	КонецЕсли;
	
	// Если не план производства общепит то ниче не делаем.
	Если НЕ РегистрыСведений.питВидыПлановОбщепит.ЭтоВидПланаОбщепит(Источник.ВидПлана) Тогда
		Возврат;
	КонецЕсли;
	
	// Обнуляем спецификацию в табличной части продукция.
	Для каждого ТекСтрокаПродукция Из Источник.Продукция Цикл
		ТекСтрокаПродукция.Спецификация = Неопределено;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Получить состав рецептуры.
//
// Параметры:
//  АктуальнаяРецептура - Произвольный - Актуальная рецептура.
//  Подразделение - Произвольный - Подразделение.
//  КоличествоБлюда - Произвольный - Количество блюда.
//  ДополнитьДаннымиОбеспечения - Произвольный - Дополнить данными обеспечения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьСоставРецептуры(АктуальнаяРецептура, Подразделение, КоличествоБлюда, ДополнитьДаннымиОбеспечения)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Результат.Колонки.Добавить("Рецептура", Новый ОписаниеТипов("ДокументСсылка.питРецептура"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов(питОбщегоНазначенияКлиентСервер.ОписаниеТиповЧисло(15, 3)));
	Результат.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов(питОбщегоНазначенияКлиентСервер.ОписаниеТиповЧисло(15, 3)));
	
	МассивПодразделений = Новый Массив(1);
	МассивПодразделений.Добавить(Подразделение);
	ДеревоСостава = питПроизводство.РассчитатьДеревоСоставаРецептуры(АктуальнаяРецептура,,КоличествоБлюда,,,КоличествоБлюда,,,,,,,,,,,,,,,,МассивПодразделений, Подразделение);
	
	Если НЕ ДеревоСостава.Строки.Количество() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для каждого СтрокаСостава Из ДеревоСостава.Строки[0].Строки Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСостава);
	КонецЦикла;
	
	Если ДополнитьДаннымиОбеспечения Тогда
		
		СкладОбеспечения = Справочники.Склады.ПустаяСсылка();
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	питРецептураРазрешенныеПодразделения.ЦеховаяКладовая КАК Склад
			|ИЗ
			|	Документ.питРецептура.РазрешенныеПодразделения КАК питРецептураРазрешенныеПодразделения
			|ГДЕ
			|	питРецептураРазрешенныеПодразделения.Подразделение = &Подразделение
			|	И питРецептураРазрешенныеПодразделения.Ссылка = &АктуальнаяРецептура";
		Запрос.УстановитьПараметр("Подразделение", Подразделение);
		Запрос.УстановитьПараметр("АктуальнаяРецептура", АктуальнаяРецептура);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			ВыборкаДетальныеЗаписи.Следующий();
			СкладОбеспечения = ВыборкаДетальныеЗаписи.Склад;
		КонецЕсли;
		
		// Добавляем данные по способам обеспечения и сроку производства.
		Результат = ЗаполнитьДанныеОбеспечения(Результат, СкладОбеспечения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Заполнить данные обеспечения.
//
// Параметры:
//  Знач ТаблицаПолуфабрикатов - ТаблицаЗначений - Знач таблица полуфабрикатов.
//  Знач Склад - Произвольный - Знач склад.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗаполнитьДанныеОбеспечения(Знач ТаблицаПолуфабрикатов, Знач Склад)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ втПолуфабрикаты
	|ИЗ
	|	&ТаблицаПолуфабрикатов КАК ТаблицаПолуфабрикатов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПолуфабрикаты.Номенклатура КАК Номенклатура,
	|	втПолуфабрикаты.Характеристика КАК Характеристика,
	|	втПолуфабрикаты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	втПолуфабрикаты.Рецептура КАК Рецептура,
	|	втПолуфабрикаты.Количество КАК Количество,
	|	втПолуфабрикаты.КоличествоУпаковок КАК КоличествоУпаковок,
	|	&Склад КАК Склад
	|ПОМЕСТИТЬ питВтТовары
	|ИЗ
	|	втПолуфабрикаты КАК втПолуфабрикаты
	|;
	|
	| "+СтрЗаменить(РегистрыСведений.СхемыОбеспечения.ВременнаяТаблицаСпособыОбеспечения("ВЫЧИСЛЯТЬ"), "ВтТовары", "питВтТовары") + "
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питВтТовары.*,
	|	ISNULL(ВтСпособыОбеспечения.СпособОбеспеченияПотребностей, ЗНАЧЕНИЕ(Справочник.СпособыОбеспеченияПотребностей.ПустаяСсылка)) КАК СпособОбеспеченияПотребностей,
	|	ISNULL(ВтСпособыОбеспечения.СпособОбеспеченияПотребностей.СрокИсполненияЗаказа, 0) КАК СрокПроизводства
	|ИЗ
	|	питВтТовары КАК питВтТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтСпособыОбеспечения КАК ВтСпособыОбеспечения
	|		ПО питВтТовары.Номенклатура = ВтСпособыОбеспечения.Номенклатура
	|		И питВтТовары.Характеристика = ВтСпособыОбеспечения.Характеристика
	|";
	
	Запрос.УстановитьПараметр("ТаблицаПолуфабрикатов", ТаблицаПолуфабрикатов);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

