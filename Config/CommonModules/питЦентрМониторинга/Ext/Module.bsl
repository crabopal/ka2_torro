Функция ИнициализироватьТаблицуБизнесСтатистики()
	
	ТаблицаБизнесСтатистики = Новый ТаблицаЗначений;
	ТаблицаБизнесСтатистики.Колонки.Добавить("ИмяОбъекта"				, Новый ОписаниеТипов("Строка"));
	ТаблицаБизнесСтатистики.Колонки.Добавить("ИмяРеквизита"				, Новый ОписаниеТипов("Строка"));
	ТаблицаБизнесСтатистики.Колонки.Добавить("СинонимРеквизита"			, Новый ОписаниеТипов("Строка"));
	ТаблицаБизнесСтатистики.Колонки.Добавить("ИмяРесурса"				, Новый ОписаниеТипов("Строка"));
	ТаблицаБизнесСтатистики.Колонки.Добавить("ТекстДопУсловия"			, Новый ОписаниеТипов("Строка"));
	ТаблицаБизнесСтатистики.Колонки.Добавить("АгрегатнаяФункция"		, Новый ОписаниеТипов("Строка"));
	ТаблицаБизнесСтатистики.Колонки.Добавить("ПроизвольныйТекстЗапроса"	, Новый ОписаниеТипов("Строка"));
	Возврат ТаблицаБизнесСтатистики;
	
КонецФункции

Процедура ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, ИмяОбъекта, ИмяРеквизита, СинонимРеквизита = "", ИмяРесурса = "", ТекстДопУсловия = "", АгрегатнаяФункция = "", ПроизвольныйТекстЗапроса = "")
	
	НоваяСтрока = ТаблицаБизнесСтатистики.Добавить();
	НоваяСтрока.ИмяОбъекта					= ИмяОбъекта;
	НоваяСтрока.ИмяРеквизита				= ИмяРеквизита;
	НоваяСтрока.СинонимРеквизита			= ?(ПустаяСтрока(СинонимРеквизита), ИмяРеквизита, СинонимРеквизита);
	НоваяСтрока.ИмяРесурса					= ?(ПустаяСтрока(ИмяРесурса), "1", ИмяРесурса);
	НоваяСтрока.ТекстДопУсловия				= ТекстДопУсловия;
	НоваяСтрока.АгрегатнаяФункция			= ?(ПустаяСтрока(АгрегатнаяФункция), "СУММА(", АгрегатнаяФункция);
	НоваяСтрока.ПроизвольныйТекстЗапроса	= ПроизвольныйТекстЗапроса;
	
КонецПроцедуры

Функция ТекстЗапросаИспользуютсяХарактеристики(ПроизвольныйОтбор = Ложь)
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	МАКСИМУМ(питВыпускБлюдТовары.Ссылка) КАК Количество
	|ПОМЕСТИТЬ втТаблицаИспользованияХарактеристик
	|ИЗ
	|	Документ.питВыпускБлюд.Товары КАК питВыпускБлюдТовары
	|ГДЕ
	|	НЕ питВыпускБлюдТовары.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	%ПроизвольныйОтбор%
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдТовары.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(питВыпускБлюдЗамены.Ссылка)
	|ИЗ
	|	Документ.питВыпускБлюд.Замены КАК питВыпускБлюдЗамены
	|ГДЕ
	|	(НЕ питВыпускБлюдЗамены.ХарактеристикаБлюда = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|			ИЛИ НЕ питВыпускБлюдЗамены.ХарактеристикаИнгредиентаИсходного = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|			ИЛИ НЕ питВыпускБлюдЗамены.ХарактеристикаИнгредиентаЗамена = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	|	%ПроизвольныйОтбор%
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдЗамены.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(питВыпускБлюдБлюда.Ссылка)
	|ИЗ
	|	Документ.питВыпускБлюд.Блюда КАК питВыпускБлюдБлюда
	|ГДЕ
	|	НЕ питВыпускБлюдБлюда.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	%ПроизвольныйОтбор%
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдБлюда.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(питВыпускБлюдИнгредиенты.Ссылка)
	|ИЗ
	|	Документ.питВыпускБлюд.Ингредиенты КАК питВыпускБлюдИнгредиенты
	|ГДЕ
	|	НЕ питВыпускБлюдИнгредиенты.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	%ПроизвольныйОтбор%
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдИнгредиенты.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(питВыпускБлюдПобочныеИзделия.Ссылка)
	|ИЗ
	|	Документ.питВыпускБлюд.ПобочныеИзделия КАК питВыпускБлюдПобочныеИзделия
	|ГДЕ
	|	НЕ питВыпускБлюдПобочныеИзделия.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	%ПроизвольныйОтбор%
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдПобочныеИзделия.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(питВыпускБлюдМодификаторы.Ссылка)
	|ИЗ
	|	Документ.питВыпускБлюд.Модификаторы КАК питВыпускБлюдМодификаторы
	|ГДЕ
	|	НЕ питВыпускБлюдМодификаторы.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	%ПроизвольныйОтбор%
	|СГРУППИРОВАТЬ ПО
	|	питВыпускБлюдМодификаторы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ХарактеристикиИспользуются"" КАК ХарактеристикиИспользуются
	|ПОМЕСТИТЬ втХарактеристикиИспользуются
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втХарактеристикиИспользуются.ХарактеристикиИспользуются КАК ХарактеристикиИспользуются,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ втТаблицаИспользованияХарактеристик.Количество) КАК Количество
	|ИЗ
	|	втХарактеристикиИспользуются КАК втХарактеристикиИспользуются
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТаблицаИспользованияХарактеристик КАК втТаблицаИспользованияХарактеристик
	|		ПО (ИСТИНА)
	|
	|СГРУППИРОВАТЬ ПО
	|	втХарактеристикиИспользуются.ХарактеристикиИспользуются";
	
	Если НЕ ПроизвольныйОтбор Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПроизвольныйОтбор%", "");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

