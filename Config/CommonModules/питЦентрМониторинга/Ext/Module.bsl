#Область ПрограммныйИнтерфейс

// Выполняется при запуске регламентного задания сбор статистики, вызывается из БСП
//  из функции ЦентрМониторингаПереопределяемый.ПриСбореПоказателейСтатистикиКонфигурации.
//  Данная функция предназначена для записи специфической статистики по объектам, не требующей разреза периода.
//  Например значения констант.
//
Процедура ПриСбореПоказателейСтатистикиКонфигурации() Экспорт
	
	// 0. Проверка существования подсистемы.
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЦентрМониторинга") Тогда
		Возврат;
	КонецЕсли;
	МодульЦентрМониторинга = ОбщегоНазначения.ОбщийМодуль("ЦентрМониторинга");
	
	// Получение таблицы с объектами, по которым собираем бизнес статистику.
	ОбъектыБизнесСтатистики = ОбъектыБизнесСтатистики();
	
	// Соответствие, необходимое как входные данные для вызова БСП функции "ЗаписатьСтатистикуКонфигурации".
	// Ключ - это ключ фиксируемой операции, значение - текст запроса, в котором должна быть колонка с реквизитом,
	// который фиксируем и колонка "Количество".
	СоответствиеИменМетаданных = Новый Соответствие;
	
	// Обход таблицы бизнес-статистики.
	Для каждого ОбъектБизнесСтатистики Из ОбъектыБизнесСтатистики Цикл
		
		Если НЕ ПустаяСтрока(ОбъектБизнесСтатистики.ПроизвольныйТекстЗапроса) Тогда
			// Для текущего объекта написан произвольный текст запроса, используем его.
			ТекстЗапроса = ОбъектБизнесСтатистики.ПроизвольныйТекстЗапроса;
		Иначе
			// Для данного объекта создадим текст запроса из шаблона.
			// %1 - ИмяРеквизита
			// %2 - СинонимРеквизита
			// %3 - АгрегатнаяФункция (
			// %4 - ИмяРесурса
			// %5 - ИмяОбъекта
			// %6 - ТекстДопУсловия
			ТекстЗапроса = ТекстЗапросаШаблонДляЗаписиСтатистики();
			
			ТекстЗапроса = СтрШаблон(ТекстЗапроса,
			ОбъектБизнесСтатистики.ИмяРеквизита,
			ОбъектБизнесСтатистики.СинонимРеквизита,
			ОбъектБизнесСтатистики.АгрегатнаяФункция,
			ОбъектБизнесСтатистики.ИмяРесурса,
			ОбъектБизнесСтатистики.ИмяОбъекта,
			ОбъектБизнесСтатистики.ТекстДопУсловия);
			
		КонецЕсли;
		
		// Заполнение соответствия.
		СоответствиеИменМетаданных.Вставить(ОбъектБизнесСтатистики.ИмяОбъекта + ОбъектБизнесСтатистики.СинонимРеквизита, ТекстЗапроса);
		
	КонецЦикла;
	
	// БСП функция записи статистики в регистр "Статистика конфигурации".
	МодульЦентрМониторинга.ЗаписатьСтатистикуКонфигурации(СоответствиеИменМетаданных);
	
КонецПроцедуры

// Процедура изменяет параметры центра мониторинга по умолчанию, вызывается
//  в ЦентрМониторингаСлужебный.ПолучитьПараметрыПоУмолчанию
//
// Параметры:
//  ПараметрыКонстанты	 - Структура - Структура параметров 
//   из функции ЦентрМониторингаСлужебный.ПолучитьПараметрыПоУмолчанию.
//
Процедура ИзменитьПараметрыЦентраМониторингаПоУмолчанию(ПараметрыКонстанты) Экспорт
	
	ПараметрыКонстанты.Вставить("Сервер"				, "stat.rarus.ru");
	ПараметрыКонстанты.Вставить("АдресРесурса"			, "RarusQMC/hs/PultQMC/v1/packet/");
	ПараметрыКонстанты.Вставить("АдресРесурсаДляДампов"	, "RarusQMC/hs/PultQMC/DumpsInfo/");
	ПараметрыКонстанты.Вставить("Порт"					, 80);
	ПараметрыКонстанты.Вставить("ЗащищенноеСоединение"	, Ложь);
	
КонецПроцедуры

// Функция заменяет вендора в переданной строке с 1С на 1С-Рарус.
//
// Параметры:
//  СтрокаЗаменить	 - Строка - Строка до замены.
// 
// Возвращаемое значение:
//  Строка - Строка после замены.
//
Функция ЗаменитьВендораВСтроке(СтрокаЗаменить) Экспорт
	
	Возврат СтрЗаменить(СтрокаЗаменить, """1С""", """1С-Рарус""");
	
КонецФункции

// Процедура записывает операции бизнес статистики, использующие периодичность по переданному отраслевому объекту.
//  Вызывается непосредственно во время взаимодействия с объектом, например при формировании отчета, запуске обработки
//  и т.д.
// Вызывает БСП функцию ЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики, которая формирует записи в регистр
//  "Буфер операций статистики".
//
// Параметры:
//  Объект	 - ОбъектСсылка - Ссылка на объект.
//
Процедура ЗаписатьОперацииБизнесСтатистики(Объект) Экспорт
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЦентрМониторинга") Тогда
		Возврат;
	КонецЕсли;
	МодульЦентрМониторинга = ОбщегоНазначения.ОбщийМодуль("ЦентрМониторинга");
	
	// Привелигированный режим, чтобы даже под ограниченными правами не было проблем со сбором статистики.
	УстановитьПривилегированныйРежим(Истина);
	
	// Получение полного имени объекта по метаданным.
	ПолноеИмяОбъекта = Объект.Метаданные().ПолноеИмя();
	ПолноеИмяОбъектаМассив = СтрРазделить(ПолноеИмяОбъекта, ".", Ложь);
	
	Если ПолноеИмяОбъектаМассив[0] = "Отчет" Тогда
		
		// Имеем дело с отчетом, имя операции будет содержать ключ варианта отчета и "КоличествоФормирований".
		ИмяОперацииБизнесСтатистики = "";
		КлючВарианта = "";
		ДопСвойстваОтчета = Объект.КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства;
		Если ДопСвойстваОтчета.Свойство("КлючВарианта") Тогда
			КлючВарианта = ДопСвойстваОтчета.КлючВарианта;
		КонецЕсли;
		ИмяОперацииБизнесСтатистики = ПолноеИмяОбъекта + "." + КлючВарианта + ".КоличествоФормирований";
		МодульЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики(ИмяОперацииБизнесСтатистики, 1);
		
	ИначеЕсли ПолноеИмяОбъектаМассив[0] = "Обработка" Тогда
		
		// Имеем дело с обработкой, имя операции будет содержать "КоличествоОткрытий".
		ИмяОперацииБизнесСтатистики = ПолноеИмяОбъекта  + ".КоличествоОткрытий";
		МодульЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики(ИмяОперацииБизнесСтатистики, 1);
		
	ИначеЕсли ПолноеИмяОбъектаМассив[0] = "Документ" И ПолноеИмяОбъектаМассив[1] = "питВыпускБлюд" Тогда
		
		// Имеем дело с документом "Выпуск блюд", здесь записываем несколько статистических показателей:
		//  По значениям реквизитов в шапке документа
		//  По использованию характеристик и серий
		//  По наличию данных в табличных частях, таких как модификаторы, побочные изделия.
		
		////////////////////////////////////////////////////////////////////////////
		// Статистика по показателям шапки.
		МассивПоказателейШапкиВыпускБлюд = Новый Массив;
		МассивПоказателейШапкиВыпускБлюд.Добавить("РежимРасчетаСписанияВПроизводство");
		МассивПоказателейШапкиВыпускБлюд.Добавить("ХозяйственнаяОперация");
		МассивПоказателейШапкиВыпускБлюд.Добавить("РежимИспользованияАналогов");
		МассивПоказателейШапкиВыпускБлюд.Добавить("ВидПроизводства");
		МассивПоказателейШапкиВыпускБлюд.Добавить("РежимПриготовленияМодификаторов");
		МассивПоказателейШапкиВыпускБлюд.Добавить("НеИспользоватьСезонныеПроценты");
		МассивПоказателейШапкиВыпускБлюд.Добавить("РазрешитьНедовложения");
		МассивПоказателейШапкиВыпускБлюд.Добавить("УчитыватьОстаткиБлюдНаСкладе");
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ";
		Для Сч = 0 По МассивПоказателейШапкиВыпускБлюд.Количество()-1 Цикл
			Запрос.Текст = Запрос.Текст + ?(Сч>0,",","") + "
			|	ПРЕДСТАВЛЕНИЕ(Таблица." + МассивПоказателейШапкиВыпускБлюд[Сч] + ") КАК " + МассивПоказателейШапкиВыпускБлюд[Сч];
		КонецЦикла;
		Запрос.Текст = Запрос.Текст + "
		|ИЗ
		|	Документ.питВыпускБлюд КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Для каждого ТекПоказатель Из МассивПоказателейШапкиВыпускБлюд Цикл
			ИмяОперацииБизнесСтатистики = "ЗаписьОбъекта." + ПолноеИмяОбъекта + "." + ТекПоказатель + "." + ВыборкаДетальныеЗаписи[ТекПоказатель];
			МодульЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики(ИмяОперацииБизнесСтатистики, 1);
		КонецЦикла;
		
		////////////////////////////////////////////////////////////////////////////
		// Статистика по сложным показателям(используются характеристики, используются серии).
		ТекстЗапросаИспользуютсяХарактеристики	= ТекстЗапросаИспользуютсяХарактеристики(Истина);
		ТекстЗапросаИспользуютсяХарактеристики = СтрЗаменить(ТекстЗапросаИспользуютсяХарактеристики, "%ПроизвольныйОтбор%", " И Ссылка = &Ссылка ");
		Запрос.Текст = ТекстЗапросаИспользуютсяХарактеристики;
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Если ВыборкаДетальныеЗаписи.Количество > 0 Тогда
			ИмяОперацииБизнесСтатистики = "ЗаписьОбъекта." + ПолноеИмяОбъекта + ".ИспользуютсяХарактеристики.Да";
		Иначе
			ИмяОперацииБизнесСтатистики = "ЗаписьОбъекта." + ПолноеИмяОбъекта + ".ИспользуютсяХарактеристики.Нет";
		КонецЕсли;
		МодульЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики(ИмяОперацииБизнесСтатистики, 1);
		
		ТекстЗапросаИспользуютсяСерии			= ТекстЗапросаИспользуютсяСерии(Истина);
		ТекстЗапросаИспользуютсяСерии			= СтрЗаменить(ТекстЗапросаИспользуютсяСерии, "%ПроизвольныйОтбор%", " И Ссылка = &Ссылка ");
		Запрос.Текст = ТекстЗапросаИспользуютсяСерии;
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Если ВыборкаДетальныеЗаписи.Количество > 0 Тогда
			ИмяОперацииБизнесСтатистики = "ЗаписьОбъекта." + ПолноеИмяОбъекта + ".ИспользуютсяСерии.Да";
		Иначе
			ИмяОперацииБизнесСтатистики = "ЗаписьОбъекта." + ПолноеИмяОбъекта + ".ИспользуютсяСерии.Нет";
		КонецЕсли;
		МодульЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики(ИмяОперацииБизнесСтатистики, 1);
		
		////////////////////////////////////////////////////////////////////////////
		// Статистика по сложным показателям в табличных частях.
		ТекстЗапроса = "";
		МассивПоказателейИспользуютсяТабличныеЧасти = Новый Массив();
		МассивПоказателейИспользуютсяТабличныеЧасти.Добавить("ЗаменыИспользуются");
		МассивПоказателейИспользуютсяТабличныеЧасти.Добавить("МодификаторыИспользуются");
		МассивПоказателейИспользуютсяТабличныеЧасти.Добавить("ТрудозатратыИспользуются");
		МассивПоказателейИспользуютсяТабличныеЧасти.Добавить("ПобочныеИзделияИспользуются");
		Счетчик = 0;
		Для каждого ТекПоказатель Из МассивПоказателейИспользуютсяТабличныеЧасти Цикл
			ТекстЗапросаПоказатель = ТекстЗапросаШаблонДляЗаписиСтатистики();
			ТекстЗапросаПоказатель = СтрШаблон(ТекстЗапросаПоказатель,
				"""" + ТекПоказатель + """",
				ТекПоказатель,
				"КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ",
				"Ссылка",
				"Документ.питВыпускБлюд." + СтрЗаменить(ТекПоказатель, "Используются", ""),
				"ГДЕ Ссылка = &Ссылка");
			ТекстЗапроса = ТекстЗапроса + ?(Счетчик>0,";","") + ТекстЗапросаПоказатель + Символы.ПС;
			Счетчик = Счетчик + 1;
		КонецЦикла;
		Запрос.Текст = ТекстЗапроса;
		РезультатПакет = Запрос.ВыполнитьПакет();
		Счетчик = 0;
		Для каждого ТекПоказатель Из МассивПоказателейИспользуютсяТабличныеЧасти Цикл
			ВыборкаДетальныеЗаписи = РезультатПакет[Счетчик].Выбрать();
			ВыборкаДетальныеЗаписи.Следующий();
			Если ВыборкаДетальныеЗаписи.Количество > 0 Тогда
				ИмяОперацииБизнесСтатистики = "ЗаписьОбъекта." + ПолноеИмяОбъекта + "." + ТекПоказатель + ".Да";
			Иначе
				ИмяОперацииБизнесСтатистики = "ЗаписьОбъекта." + ПолноеИмяОбъекта + "." + ТекПоказатель + ".Нет";
			КонецЕсли;
			МодульЦентрМониторинга.ЗаписатьОперациюБизнесСтатистики(ИмяОперацииБизнесСтатистики, 1);
			Счетчик = Счетчик + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция инициализирует и заполняет данными таблицу значений объектов бизнес статистики.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Результирующая таблица, структура которой определяется 
//  в функции "ИнициализироватьТаблицуБизнесСтатистики"
//
Функция ОбъектыБизнесСтатистики()
	
	// Получение структуры таблицы.
	ТаблицаБизнесСтатистики = ИнициализироватьТаблицуБизнесСтатистики();
	
	// Добавление строк таблицы по константам.
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питИспользоватьВидыОбработкиСырья"						, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питРежимКорректировкиКоличестваВИнвентаризации"			, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питКоличествоДляРасчетаПоФормулеВРецептурах"				, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питФормироватьДокументыПроизводства22"					, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питФормироватьРазрешенияНаЗаменуПоРегистрациямЗамен"		, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питФормироватьСкладскиеАктыПоИнвентаризацииТоваров"		, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питФормироватьОприходованиеИзлишковПоВыпускуБлюд"		, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питИспользоватьОтложенноеПроведениеВыпускаБлюд"			, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питОстанавливатьОбработкуОчередиПриВозникновенииОшибок"	, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питНеИзменятьРежимСписанияВПроизводствоПоНастройке"		, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питРежимРасчетаСписанияВПроизводство"					, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питИскатьРецептурыПоВсемОрганизациям"					, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питНеИспользоватьСезонныеПроценты"						, "Значение");
	ДобавитьОбъектБизнесСтатистики(ТаблицаБизнесСтатистики, "Константа.питВосприниматьБлюдоБезРецептурыКакТовар"				, "Значение");
