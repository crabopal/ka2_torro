

#Область ПрограммныйИнтерфейс

#Область СогласиеНаВыгрузкуДанных
// Процедура - ОбработчикОповещения_ПодтвердитьВыгрузкуДанных.
//
// Параметры:
//  Результат - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры - Структура - ДополнительныеПараметры.
//
&НаКлиенте
Процедура ОбработчикОповещения_ПодтвердитьВыгрузкуДанных(Результат,ДополнительныеПараметры) Экспорт
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Отмена выбранного действия'", "ru"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Форма.ЕстьПодтверждениеНаВыгрузку = Истина;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработчикПродолженияВыгрузки);
	

КонецПроцедуры

// ОбработчикОповещения_ПодтвердитьВыгрузкуДанных
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ВходныеПараметры - Произвольный - Входные параметры.
//
Процедура ПоказатьВопросОПодтверждениеВыгрузки(Форма, ВходныеПараметры = Неопределено) Экспорт
	
	ОбработчикПродолженияВыгрузки = Новый ОписаниеОповещения("Подключаемый_ПродолжитьВыгрузкуДанных", Форма, ВходныеПараметры);
		
	Если НЕ Форма.ЕстьПодтверждениеНаВыгрузку И питОбменДанными.РазделениеВключено() Тогда

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", Форма);
		ДополнительныеПараметры.Вставить("ОбработчикПродолженияВыгрузки", ОбработчикПродолженияВыгрузки);
		
		ОписаниеОповещенияОЗакрытииФормы = Новый ОписаниеОповещения("ОбработчикОповещения_ПодтвердитьВыгрузкуДанных", ЭтотОбъект, ДополнительныеПараметры);
		ТекстВопроса = НСтр("ru='Планируется выгрузка данных за пределы сервиса. Продолжить?'", "ru");
		ПоказатьВопрос(ОписаниеОповещенияОЗакрытииФормы,ТекстВопроса,РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
	Иначе
		ВыполнитьОбработкуОповещения(ОбработчикПродолженияВыгрузки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Обработчик события выбора поля Договор
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ПараметрыСоздания - Структура - Содержит дополнительные параметры заполнения нового договор.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ДоговорОбработкаВыбора(Элемент, ВыбранноеЗначение, ПараметрыСоздания, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда
		
		Если ВыбранноеЗначение = "НовыйДоговор" Тогда
			ЗначенияЗаполнения = ЗначенияЗаполненияПоПараметрамВыбора(Элемент.ПараметрыВыбора);
			ЗначенияЗаполнения.Вставить("Организация");
			ЗначенияЗаполнения.Вставить("Контрагент");
			
			// Дополняем ЗначенияЗаполнения явно переданными параметрами нового договора
			// вид договор берется из параметров выбора и не должен переопределяться
			ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, ПараметрыСоздания,,"ХозяйственнаяОперация");
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
			ПараметрыФормы.Вставить("СозданИзФормыДокумента", Истина);
			
			ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаОбъекта", ПараметрыФормы, Элемент);
			
		ИначеЕсли ВыбранноеЗначение = "БезДоговора" Тогда
			
			ПараметрыСоздания.Вставить("Наименование", "Без договора");
			
			ПараметрыДоговора = Новый Структура;
			ПараметрыДоговора.Вставить("ЗначенияЗаполнения", ПараметрыСоздания);
			
//   ВыбранноеЗначение =
// РаботаСДоговорамиКонтрагентовБПВызовСервера.СоздатьОсновнойДоговорКонтрагента(ПараметрыДоговора);.
			
		КонецЕсли;
	ИначеЕсли Элемент.СписокВыбора.Количество() > 0 Тогда 
		Элемент.СписокВыбора.Очистить();
	КонецЕсли;
	
КонецПроцедуры

// Заполняет список выбор для поля Договор
//
// Параметры:
//  ЭлементФормыСписка - Произвольный - Элемент формы списка.
//  Текст - Строка - Текст, введенный в поле "Договор" форм.
//  КонтрагентБезДоговоров - Булево - Истина, если в поле Договор должен быть доступен выбор из предопределенных
//   значений.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ЗаполнитьСписокВыбора(ЭлементФормыСписка, Текст, КонтрагентБезДоговоров, СтандартнаяОбработка) Экспорт
	
	СписокВыбора = ЭлементФормыСписка.СписокВыбора;
	
	Если СписокВыбора.Количество()> 0 Тогда
		СписокВыбора.Очистить();
	КонецЕсли;
	
	Если ПустаяСтрока(Текст) И КонтрагентБезДоговоров Тогда
		
		СписокВыбора.Добавить("БезДоговора", "Без договора");
		СписокВыбора.Добавить("НовыйДоговор", "Создать договор ...");
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура открытия формы выбора цвета.
//
// Параметры:
//  ЗначениеПоУмолчанию - Цвет - Цвет, который передан по умолчанию в форму.
//  ОбработчикОповещения - ОбработчикОповещения - Обработчик оповещения после выбора цвета.
//
Процедура ОткрытьВыборЦвета(ЗначениеПоУмолчанию, ОбработчикОповещения = Неопределено) Экспорт
	
	ВходныеПараметры = Новый Структура;
	ВходныеПараметры.Вставить("Цвет", ЗначениеПоУмолчанию);
	
	ОткрытьФорму("ОбщаяФорма.питВыборЦвета", ВходныеПараметры,
		ЭтотОбъект,
		,,,
		ОбработчикОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Открывает навигационную ссылку в программе, которая ассоциирована с протоколом навигационной ссылки.
//  Допустимые протоколы: http, https, e1c, v8help, mailto, tel, skype.
//  Для открытия проводника или файла в программе просмотра не следует формировать ссылку по протоколу file://
//  - для открытия проводника см. ОткрытьПроводник.
//  - для открытия файла по расширению см. ОткрытьФайлВПрограммеПросмотра.
//
// Параметры:
//  ИнтернетСсылка - Произвольный - Интернет ссылка.
//  Оповещение - Произвольный - Знач оповещение.
//
Процедура ОткрытьНавигационнуюСсылку(ИнтернетСсылка, Знач Оповещение = Неопределено) Экспорт
	
	Попытка
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ИнтернетСсылка, Оповещение);
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Произошла ошибка при переходе по ссылке %1.
		|Подробная информация об ошибке:
		|%2'"),
		ИнтернетСсылка,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Значения заполнения по параметрам выбора.
//
// Параметры:
//  ПараметрыВыбора - Произвольный - Параметры выбора.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЗначенияЗаполненияПоПараметрамВыбора(ПараметрыВыбора)
	
	ЗначенияЗаполнения = Новый Структура;
	
	Для каждого ПараметрВыбора Из ПараметрыВыбора Цикл
		Если СтрНайти(ПараметрВыбора.Имя, "Отбор.") <> 0 Тогда
			ЗначенияЗаполнения.Вставить(СтрЗаменить(ПараметрВыбора.Имя, "Отбор.", ""), ПараметрВыбора.Значение);
		ИначеЕсли СтрНайти(ПараметрВыбора.Имя, ".") = 0 Тогда
			ЗначенияЗаполнения.Вставить(ПараметрВыбора.Имя, ПараметрВыбора.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

#КонецОбласти





