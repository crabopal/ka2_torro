#Область ПрограммныйИнтерфейс

// Функция возвращает массив форм подсистемы общепит по объектам,
//  находящимся в подсистеме "питОбъектыВсе".
// 
// Возвращаемое значение:
//  Массив - Массив форм подсистемы общепит.
//
Функция ИменаФормПодсистемыОбщепит() Экспорт
	
	Результат = Новый Массив;
	
	// Получение состава подсистемы "питОбъектыВсе".
	ВсеОбъектыОбщепит = Метаданные.Подсистемы.питОбъектыВсе.Состав;
	Для каждого ТекОбъект Из ВсеОбъектыОбщепит Цикл
		Попытка
			// Попытка получить формы объекта.
			ФормыОбъекта = ТекОбъект.Формы;
		Исключение
			// У объекта нет форм, инициализируем пустой массив.
			ФормыОбъекта = Новый Массив;
		КонецПопытки;
		Для каждого ТекФормаОбъекта Из ФормыОбъекта Цикл
			// Добавляем имя найденных форм в результат.
			Результат.Добавить(ТекФормаОбъекта.ПолноеИмя());
		КонецЦикла;
	КонецЦикла;
	Результат.Добавить("ОбщаяФорма.ФормаОтчета");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Инициализация
#Область СлужебныеПроцедурыИФункции
#КонецОбласти
#КонецОбласти
