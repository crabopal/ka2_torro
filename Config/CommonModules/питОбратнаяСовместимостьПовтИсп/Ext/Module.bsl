#Область ПрограммныйИнтерфейс

//  Функция - Имя документа внутреннее потребление.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ИмяДокументаВнутреннееПотребление() Экспорт
	
	Если Метаданные.Документы.Найти("ВнутреннееПотреблениеТоваров") = Неопределено Тогда
		ИмяДокумента = "ВнутреннееПотребление";
	Иначе
		ИмяДокумента = "ВнутреннееПотреблениеТоваров";
	КонецЕсли;
	
	Возврат ИмяДокумента;
КонецФункции

