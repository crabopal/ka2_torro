// +АвтовыборНоменклатуры

// Вызывается в УправлениеДаннымиОбИзделиях.ВыборХарактеристикиПоСвойствам
//  Процедура изменяет текст запроса выбора характеристики по свойствам для документа "Рецептура".
//
// Параметры:
//  ЗапросТекст - Строка - Изменяемый текст запроса.
//
Процедура ИзменитьТекстЗапросаВыбораХарактеристикиПоСвойствам(ЗапросТекст) Экспорт
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "Справочник.питРецептура", "Документ.питРецептура");
	
КонецПроцедуры

// Функция вызывает типовую УправлениеДаннымиОбИзделиях.ОбработатьНастройкиАвтовыбораНоменклатуры
//
// Параметры:
//  ТаблицаИнгредиентов - ТаблицаЗначений - Таблица, в которой заполняем автовыбор.
//  Рецептура - ДокументСсылка.питРецептура - Ссылка на рецептуру.
//  Количество - Число - Количество полуфабриката.
//  РецептураРеквизиты - Структура - Структура реквизитов рецептуры (номенклатура, характеристика, количество).
//  УточненияАвтовыбора - Произвольный - Уточнения автовыбора.
//
Процедура ОбработатьНастройкиАвтовыбораНоменклатуры(ТаблицаИнгредиентов, Рецептура, Количество, РецептураРеквизиты, УточненияАвтовыбора = Неопределено) Экспорт
	
	Если ТаблицаИнгредиентов.Колонки.Найти("ОшибкаАвтовыбора") = Неопределено Тогда
		ТаблицаИнгредиентов.Колонки.Добавить("ОшибкаАвтовыбора", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	ЭтоУправлениеПредприятием = питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "УправлениеПредприятием";
	Если НЕ ЭтоУправлениеПредприятием Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьПараметризациюРесурсныхСпецификаций") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаИнгредиентов.Колонки.Найти("Идентификатор") = Неопределено Тогда
		ТаблицаИнгредиентов.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
		Для каждого ТекСтрока Из ТаблицаИнгредиентов Цикл
			ТекСтрока.Идентификатор = 0;
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаИнгредиентов.Колонки.Найти("ХарактеристикиИспользуются") = Неопределено Тогда
		ТаблицаИнгредиентов.Колонки.Добавить("ХарактеристикиИспользуются", Новый ОписаниеТипов("Булево"));
		МассивНоменклатуры = ТаблицаИнгредиентов.ВыгрузитьКолонку("Номенклатура");
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивНоменклатуры, "питВидНоменклатуры, ИспользованиеХарактеристик");
		Для каждого ТекИнгредиент Из ТаблицаИнгредиентов Цикл
			ТекРеквизитыНоменклатуры = РеквизитыНоменклатуры.Получить(ТекИнгредиент.Номенклатура);
			Если ТекРеквизитыНоменклатуры = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекИнгредиент.ХарактеристикиИспользуются = 
			(ТекРеквизитыНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры
			ИЛИ ТекРеквизитыНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры
			ИЛИ ТекРеквизитыНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры);
			
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаИнгредиентов.Колонки.Найти("СведенияАвтовыбора") = Неопределено Тогда
		ТаблицаИнгредиентов.Колонки.Добавить("СведенияАвтовыбора", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(255)));
	КонецЕсли;
	
	ДанныеПоНоменклатуре = ДанныеПоНоменклатуре();
	ЗаполнитьЗначенияСвойств(ДанныеПоНоменклатуре, РецептураРеквизиты);
	ДанныеПоНоменклатуре.Вставить("Спецификация", Рецептура);
	ДанныеПоНоменклатуре.Вставить("Количество", Количество);
	
	// Если в шапке рецептуры не заполнена характеристика, а должна, то попытаемся ее найти в таблице уточнений.
	Если НЕ ЗначениеЗаполнено(ДанныеПоНоменклатуре.Характеристика) И НЕ УточненияАвтовыбора = Неопределено Тогда
		НайденныеУточнения = УточненияАвтовыбора.НайтиСтроки(Новый Структура("Номенклатура, КлючРодителя", ДанныеПоНоменклатуре.Номенклатура, ""));
		Если НайденныеУточнения.Количество() Тогда
			ДанныеПоНоменклатуре.Характеристика = НайденныеУточнения[0].Характеристика;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыАвтовыбора = ПолучитьПараметрыАвтовыбора(ДанныеПоНоменклатуре);
	
	// ВозвращаемоеЗначение = УправлениеДаннымиОбИзделиях.ОбработатьНастройкиАвтовыбораНоменклатуры(
	// 				ТаблицаИнгредиентов,
	// 				ПараметрыАвтовыбора,
	// 				"питРецептура",
	// 				Ложь,
	// 				Истина);
	УправлениеДаннымиОбИзделиях.ОбработатьНастройкиАвтовыбораНоменклатуры(
					ТаблицаИнгредиентов,
					ПараметрыАвтовыбора);
	
	// Обновление видов номенклатуры после автозаполнения.
	МассивНоменклатуры = ТаблицаИнгредиентов.ВыгрузитьКолонку("Номенклатура");
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивНоменклатуры, "питВидНоменклатуры, ИспользованиеХарактеристик");
	
	// Заполнение служебной колонки "ОшибкаАвтовыбора".
	Если ТаблицаИнгредиентов.Колонки.Найти("ОшибкаАвтовыбора") = Неопределено Тогда
		ТаблицаИнгредиентов.Колонки.Добавить("ОшибкаАвтовыбора", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Для каждого ТекИнгредиент Из ТаблицаИнгредиентов Цикл
		ТекРеквизитыНоменклатуры = РеквизитыНоменклатуры.Получить(ТекИнгредиент.Номенклатура);
		Если ТекРеквизитыНоменклатуры = Неопределено Тогда
			ТекИнгредиент.ОшибкаАвтовыбора = Истина;
			Продолжить;
		КонецЕсли;
		
		ТекИнгредиент.НоменклатурапитВидНоменклатуры = ТекРеквизитыНоменклатуры.питВидНоменклатуры;
		
		ТекИнгредиент.ХарактеристикиИспользуются = 
			(ТекРеквизитыНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры
			ИЛИ ТекРеквизитыНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры
			ИЛИ ТекРеквизитыНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры);
		Если НЕ ЗначениеЗаполнено(ТекИнгредиент.Номенклатура)
			ИЛИ (ТекИнгредиент.ХарактеристикиИспользуются И НЕ ЗначениеЗаполнено(ТекИнгредиент.Характеристика)) Тогда
			
			Если НЕ УточненияАвтовыбора = Неопределено Тогда
				// Обработка таблицы уточнений характеристик.
				СтрокиРодительские = УточненияАвтовыбора.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Рецептура", ДанныеПоНоменклатуре.Номенклатура, ДанныеПоНоменклатуре.Характеристика, Рецептура));
				Если СтрокиРодительские.Количество() Тогда
					НайденныеУточнения = УточненияАвтовыбора.НайтиСтроки(Новый Структура("Номенклатура, КлючРодителя", ТекИнгредиент.Номенклатура, СтрокиРодительские[0].Ключ));
					Если НайденныеУточнения.Количество() Тогда
						ТекИнгредиент.Характеристика = НайденныеУточнения[0].Характеристика;
						ТекИнгредиент.Рецептура = НайденныеУточнения[0].Рецептура;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ТекИнгредиент.ОшибкаАвтовыбора = НЕ ЗначениеЗаполнено(ТекИнгредиент.Характеристика);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет ТЧ "Уточнения автовыбора" по переданному массиву деревьев состава
//
// Параметры:
//  МассивДеревьев - Массив - Массив деревьев состава.
//  ТаблицаУточнений - ТабличнаяЧасть - ТЧ "Уточнения автовыбора.
//
Процедура ЗаполнитьУточненияАвтовыбора(МассивДеревьев, ТаблицаУточнений) Экспорт
	
	ТаблицаУточнений.Очистить();
	Для каждого ДеревоСостава Из МассивДеревьев Цикл
		ЗаполнитьУточненияАвтовыбораРекурсивно(ДеревоСостава.Строки, ТаблицаУточнений);
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает, найдены ли ошибки автовыбора в переданной таблице.
//
// Параметры:
//  УточненияАвтовыбора - ТаблицаЗначений - Таблица уточнений автовыбора.
//
// Возвращаемое значение:
//  Булево - Результат работы функции.
Функция ЗаполнитьНайденыОшибкиАвтовыбора(УточненияАвтовыбора) Экспорт
	
	Возврат УточненияАвтовыбора.НайтиСтроки(Новый Структура("ОшибкаАвтовыбора, Характеристика", Истина, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка())).Количество();
	
КонецФункции

// Функция получает таблицу уточнений автовыбора по ссылке на документ
//
// Параметры:
//  СсылкаНаДокумент - Произвольный - Ссылка на документ.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Найденная таблица уточнений.
//
Функция ПолучитьТаблицуУточненийАвтовыбораПоДокументу(СсылкаНаДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	Документ.%ИмяДокумента%.УточненияАвтовыбора КАК питПланМенюУточненияАвтовыбора
		|ГДЕ
		|	питПланМенюУточненияАвтовыбора.Ссылка = &Ссылка";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ИмяДокумента%", СсылкаНаДокумент.Метаданные().Имя);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Функция получает таблицу ингредиентов рецептуры с автовыбором.
//
// Параметры:
//  Рецептура - ДокументСсылка.питРецептура - Ссылка на рецептуру.
//  УточненияАвтовыбора - Произвольный - Уточнения автовыбора.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица ингредиентов.
Функция ПолучитьТаблицуИнгредиентовРецептурыСАвтовыбором(Рецептура, УточненияАвтовыбора) Экспорт
	
	Если ТипЗнч(Рецептура) = Тип("ДанныеФормыСтруктура") Тогда
		
		ТаблицаИнгредиентов = Рецептура.Ингредиенты.Выгрузить();
		ТаблицаИнгредиентов.Колонки.Добавить("НоменклатурапитВидНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.питВидыНоменклатуры"));
		
		РецептураСсылка = Рецептура.Ссылка;
		РеквизитыРецептуры = ДанныеПоНоменклатуре();
		ЗаполнитьЗначенияСвойств(РеквизитыРецептуры, Рецептура);
		
	Иначе
		РецептураСсылка = Рецептура;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	питРецептура.Ссылка КАК Ссылка,
		|	питРецептура.Характеристика КАК Характеристика,
		|	питРецептура.Номенклатура КАК Номенклатура,
		|	питРецептура.КоличествоУпаковок КАК КоличествоУпаковок,
		|	питРецептура.Количество КАК Количество,
		|	питРецептура.Упаковка КАК Упаковка
		|ИЗ
		|	Документ.питРецептура КАК питРецептура
		|ГДЕ
		|	питРецептура.Ссылка = &Рецептура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	*,
		|	питРецептураИнгредиенты.Номенклатура.питВидНоменклатуры КАК НоменклатурапитВидНоменклатуры
		|ИЗ
		|	Документ.питРецептура.Ингредиенты КАК питРецептураИнгредиенты
		|ГДЕ
		|	питРецептураИнгредиенты.Ссылка = &Рецептура";
		Запрос.УстановитьПараметр("Рецептура", Рецептура);
		ПакетРезультатов = Запрос.ВыполнитьПакет();
		РеквизитыРецептуры = ПакетРезультатов[0].Выбрать();
		РеквизитыРецептуры.Следующий();
		ТаблицаИнгредиентов = ПакетРезультатов[1].Выгрузить();
		
	КонецЕсли;
	
	питУправлениеДаннымиОбИзделиях.ОбработатьНастройкиАвтовыбораНоменклатуры(ТаблицаИнгредиентов, РецептураСсылка, РеквизитыРецептуры.Количество, РеквизитыРецептуры, УточненияАвтовыбора);
	
	Возврат ТаблицаИнгредиентов;
	
КонецФункции

#КонецОбласти

// %ИзЕРП% Справочники.РесурсныеСпецификации.ДанныеСпецификации
//
// Параметры:
//  ДанныеПоНоменклатуре - Произвольный - Данные по номенклатуре.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ТаблицаДанныхПоНоменклатуреДляПараметровАвтовыбораИРасчетаПоФормулам(ДанныеПоНоменклатуре) Экспорт
	
	НаборДанныхПоНоменклатуре = Справочники.РесурсныеСпецификации.СписокНоменклатуры();
	НаборДанныхПоНоменклатуре.Колонки.Добавить("Идентификатор",       Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	НаборДанныхПоНоменклатуре.Колонки.Добавить("Назначение",          Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	НовСтрокаНаборДанных = НаборДанныхПоНоменклатуре.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтрокаНаборДанных, ДанныеПоНоменклатуре);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Идентификатор",           0);
	ДополнительныеПараметры.Вставить("ПодразделениеДиспетчер",  Справочники.СтруктураПредприятия.ПустаяСсылка());
	ДополнительныеПараметры.Вставить("НаправлениеДеятельности", Справочники.НаправленияДеятельности.ПустаяСсылка());
	ДополнительныеПараметры.Вставить("Распоряжение",            Справочники.РесурсныеСпецификации.ПустаяСсылка());
	ДополнительныеПараметры.Вставить("Назначение",              Справочники.Назначения.ПустаяСсылка());
	ДополнительныеПараметры.Вставить("НачалоПроизводства",      Дата(1,1,1));
	ЗаполнитьЗначенияСвойств(НовСтрокаНаборДанных, ДополнительныеПараметры);
	
	Возврат НаборДанныхПоНоменклатуре;
	
КонецФункции

// Процедура - Заполнить уточнения автовыбора рекурсивно.
//
// Параметры:
//  СтрокиДерева - Произвольный - Строки дерева.
//  ТаблицаУточнений - ТаблицаЗначений - Таблица уточнений.
//  КлючРодителя - Произвольный - Ключ родителя.
//
Процедура ЗаполнитьУточненияАвтовыбораРекурсивно(СтрокиДерева, ТаблицаУточнений, КлючРодителя = Неопределено) Экспорт
	
	Для каждого ВеткаДерева Из СтрокиДерева Цикл
		
		НовСтрокаУточнений = ТаблицаУточнений.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрокаУточнений, ВеткаДерева);
		НовСтрокаУточнений.Ключ = ВеткаДерева.ИдентификаторСтрокиДерева;
		НовСтрокаУточнений.КлючРодителя = КлючРодителя;
		
		ЗаполнитьУточненияАвтовыбораРекурсивно(ВеткаДерева.Строки, ТаблицаУточнений, ВеткаДерева.ИдентификаторСтрокиДерева);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РасчетПоФормулам


// %ИзЕРП% УправлениеДаннымиОбИзделиях.СоответствиеЭлементовТабличныхЧастейСПараметризацией
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
// Возвращаемое значение:
//  Соответствие - Результат обработки.
Функция СоответствиеЭлементовТабличныхЧастейСПараметризацией(ИмяТаблицы)
	
	Результат = Новый Структура;
	
	Если ИмяТаблицы = "Ингредиенты" Тогда
		
		Результат.Вставить("Номенклатура",          "ИнгредиентыНоменклатура");
		Результат.Вставить("Характеристика",        "ИнгредиентыХарактеристика");
		Результат.Вставить("НоменклатураСтрокой",   "ИнгредиентыНоменклатураСтрокой");
		Результат.Вставить("ХарактеристикаСтрокой", "ИнгредиентыХарактеристикаСтрокой");
		Результат.Вставить("КоличествоУпаковок",    "ИнгредиентыКоличествоУпаковок");
		
	Иначе
		
		Результат.Вставить("Номенклатура",          ИмяТаблицы + "Номенклатура");
		Результат.Вставить("Характеристика",        ИмяТаблицы + "Характеристика");
		Результат.Вставить("НоменклатураСтрокой",   ИмяТаблицы + "НоменклатураСтрокой");
		Результат.Вставить("ХарактеристикаСтрокой", ИмяТаблицы + "ХарактеристикаСтрокой");
		Результат.Вставить("КоличествоУпаковок",    ИмяТаблицы + "КоличествоУпаковок");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Прочее

// %ИзЕРП% УправлениеДаннымиОбИзделиях.ТекстЗапросаДоступныеСвойстваНоменклатуры (2.4)
//
// Параметры:
//  ТолькоДействующие - Произвольный - Только действующие.
//  ДоступныСвойстваНоменклатуры - Произвольный - Доступны свойства номенклатуры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстЗапросаДоступныеСвойстваНоменклатуры24(ТолькоДействующие = Истина, ДоступныСвойстваНоменклатуры = Истина)
	
	ТекстыЗапроса = Новый Массив();
	
	// +пит
	// Реквизиты рецептуры.
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Вид,
	|	ТаблицаСвойств.Свойство КАК Свойство,
	|	0 КАК Порядок
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
	|		ПО ИСТИНА
	|ГДЕ
	|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры)
	|	И ТаблицаСвойств.Ссылка = &НаборРецептуры
	|	И &ТолькоДействующие");
	// -пит
	
	// Доп реквизиты общие для всех характеристик
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Вид,
	// +пит
	|	ТаблицаСвойств.Свойство КАК Свойство,
	|	1 КАК Порядок
	// -пит
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
	|		ПО ИСТИНА
	|ГДЕ
	|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры) 
	|	И ВидыНоменклатуры.ИспользоватьХарактеристики
	|	И ТаблицаСвойств.Ссылка = &Набор_Справочник_Номенклатура_Общие
	|	И &ТолькоДействующие");
	
	// Доп реквизиты характеристик вида номенклатуры
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Вид,
	// +пит
	|	ТаблицаСвойств.Свойство КАК Свойство,
	|	1 КАК Порядок
	// -пит
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
	|		ПО (ВЫБОР
	|				КОГДА ВидыНоменклатуры.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
	|					ТОГДА ВидыНоменклатуры.ВладелецХарактеристик.НаборСвойствХарактеристик
	|				ИНАЧЕ ВидыНоменклатуры.НаборСвойствХарактеристик
	|			КОНЕЦ = ТаблицаСвойств.Ссылка)
	|ГДЕ
	|	ВидыНоменклатуры.Ссылка В(&ВидыНоменклатуры)
	|	И &ТолькоДействующие");
	
	Если ДоступныСвойстваНоменклатуры Тогда
		
		// Доп реквизиты общие для номенклатуры
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Вид,
		// +пит
		|	ТаблицаСвойств.Свойство КАК Свойство,
		|	1 КАК Порядок
		// -пит
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
		|		ПО ИСТИНА
		|ГДЕ
		|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры)
		// +пит
		|	И ТаблицаСвойств.Ссылка = &Набор_Справочник_Номенклатура_Общие
		// |	И ТаблицаСвойств.Ссылка В (&МассивНаборов)
		// -пит
		|	И &ТолькоДействующие");
		
		// Доп реквизиты вида номенклатуры
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Вид,
		// +пит
		|	ТаблицаСвойств.Свойство КАК Свойство,
		|	1 КАК Порядок
		// -пит
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
		|		ПО ВидыНоменклатуры.НаборСвойств = ТаблицаСвойств.Ссылка
		|ГДЕ
		|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры)
		|	И &ТолькоДействующие");
		
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, Символы.ПС + " ОБЪЕДИНИТЬ " + Символы.ПС);
	
	Если ТолькоДействующие Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ТолькоДействующие", "И НЕ ТаблицаСвойств.ПометкаУдаления");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ТолькоДействующие", "");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить("
	|ВЫБРАТЬ
	|	Т.Вид                                     КАК Вид,
	|	Т.Свойство                                КАК Свойство,
	|	Т.Свойство.Заголовок                      КАК Представление,
	|	Т.Свойство.ТипЗначения                    КАК ТипЗначения,
	|	Т.Свойство.ВладелецДополнительныхЗначений КАК ВладелецДополнительныхЗначений,
	|	Т.Свойство.ПометкаУдаления                КАК ПометкаУдаления,
	|	Т.Свойство.Имя                            КАК Имя
	|ИЗ
	// +пит
	|	&ТекстЗапроса КАК Т
	|УПОРЯДОЧИТЬ ПО
	|	Т.Порядок", "&ТекстЗапроса", "(" + ТекстЗапроса + ")");
	// -пит
	
	Возврат ТекстЗапроса;
	
КонецФункции

// %ИзЕРП% УправлениеДаннымиОбИзделиях.ТекстЗапросаДоступныеСвойстваНоменклатуры (2.5)
//
// Параметры:
//  ТолькоДействующие - Произвольный - Только действующие.
//  ДоступныСвойстваНоменклатуры - Произвольный - Доступны свойства номенклатуры.
//  ДоступныСвойстваХарактеристики - Произвольный - Доступны свойства характеристики.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстЗапросаДоступныеСвойстваНоменклатуры25(ТолькоДействующие = Истина, ДоступныСвойстваНоменклатуры = Истина, ДоступныСвойстваХарактеристики = Истина)
	
	ТекстыЗапроса = Новый Массив();
	
	// +пит
	// Реквизиты рецептуры.
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Вид,
	|	ТаблицаСвойств.Свойство КАК Свойство,
	|	0 КАК Порядок
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
	|		ПО ИСТИНА
	|ГДЕ
	|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры)
	|	И ТаблицаСвойств.Ссылка = &НаборРецептуры
	|	И &ТолькоДействующие");
	// -пит
	
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)                             КАК Вид,
	// +пит
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка) КАК Свойство,
	|	1 КАК Порядок
	// -пит
	|ГДЕ
	|	ЛОЖЬ
	|");
	
	Если ДоступныСвойстваНоменклатуры Тогда
		
		// Доп реквизиты общие для номенклатуры
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Вид,
		// +пит
		|	ТаблицаСвойств.Свойство КАК Свойство,
		|	1 КАК Порядок
		// -пит
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
		|		ПО ИСТИНА
		|ГДЕ
		|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры)
		|	И ТаблицаСвойств.Ссылка = &Набор_Справочник_Номенклатура_Общие
		|	И &ТолькоДействующие");
		
		// Доп реквизиты вида номенклатуры
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Вид,
		// +пит
		|	ТаблицаСвойств.Свойство КАК Свойство,
		|	1 КАК Порядок
		// +пит
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
		|		ПО ВидыНоменклатуры.НаборСвойств = ТаблицаСвойств.Ссылка
		|ГДЕ
		|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры)
		|	И &ТолькоДействующие");
		
	КонецЕсли;
	
	Если ДоступныСвойстваХарактеристики Тогда
	
		// Доп реквизиты общие для всех характеристик
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Вид,
		// +пит
		|	ТаблицаСвойств.Свойство КАК Свойство,
		|	1 КАК Порядок
		// +пит
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
		|		ПО ИСТИНА
		|ГДЕ
		|	ВидыНоменклатуры.Ссылка В (&ВидыНоменклатуры) 
		|	И ВидыНоменклатуры.ИспользоватьХарактеристики
		|	И ТаблицаСвойств.Ссылка = &Набор_Справочник_ХарактеристикиНоменклатуры_Общие
		|	И &ТолькоДействующие");
		
		// Доп реквизиты характеристик вида номенклатуры
		ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Вид,
		// +пит
		|	ТаблицаСвойств.Свойство КАК Свойство,
		|	1 КАК Порядок
		// +пит
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ТаблицаСвойств
		|		ПО (ВЫБОР
		|				КОГДА ВидыНоменклатуры.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
		|					ТОГДА ВидыНоменклатуры.ВладелецХарактеристик.НаборСвойствХарактеристик
		|				ИНАЧЕ ВидыНоменклатуры.НаборСвойствХарактеристик
		|			КОНЕЦ = ТаблицаСвойств.Ссылка)
		|ГДЕ
		|	ВидыНоменклатуры.Ссылка В(&ВидыНоменклатуры)
		|	И &ТолькоДействующие");
	
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, Символы.ПС + " ОБЪЕДИНИТЬ " + Символы.ПС);
	
	Если ТолькоДействующие Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ТолькоДействующие", "И НЕ ТаблицаСвойств.ПометкаУдаления");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ТолькоДействующие", "");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить("
	|ВЫБРАТЬ
	|	Т.Вид                                     КАК Вид,
	|	Т.Свойство                                КАК Свойство,
	|	ПРЕДСТАВЛЕНИЕ(Т.Свойство)                 КАК Представление,
	|	Т.Свойство.ТипЗначения                    КАК ТипЗначения,
	|	Т.Свойство.ВладелецДополнительныхЗначений КАК ВладелецДополнительныхЗначений,
	|	Т.Свойство.ПометкаУдаления                КАК ПометкаУдаления,
	|	&ВыражениеИдентификатора                  КАК Идентификатор
	|ИЗ
	// +пит
	|	&ТекстЗапроса КАК Т
	|УПОРЯДОЧИТЬ ПО
	|	Т.Порядок", "&ТекстЗапроса", "(" + ТекстЗапроса + ")");
	// -пит
	
	МДДопРеквизитов = Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения;
	ВыражениеИдентификатора = РаботаСФормулами.ВыражениеПолногоИдентификатораХарактеристики(МДДопРеквизитов, Ложь);
	ВыражениеИдентификатора = СтрЗаменить(ВыражениеИдентификатора, "%ИмяТаблицы%", "Т.Свойство");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеИдентификатора", ВыражениеИдентификатора);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// %ИзЕРП% УправлениеДаннымиОбИзделиях.ТекстЗапросаДоступныеСвойстваНоменклатуры (2.5)
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ИсточникиСвойствДляОтбораПоСвойствам()
	
	Результат = Новый Массив;
	
	Результат.Добавить("Номенклатура");
	Результат.Добавить("Характеристика");
	// +пит
	// Результат.Добавить("НаправлениеДеятельности");
	// -пит
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// +АвтовыборНоменклатуры

// %ИзЕРП% Справочники.РесурсныеСпецификации.ПолучитьПараметрыАвтовыбора
//
// Параметры:
//  ДанныеПоНоменклатуре - Произвольный - Данные по номенклатуре.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьПараметрыАвтовыбора(ДанныеПоНоменклатуре)
	
	Попытка
		// Так стало в 2.5.23
		ПараметрыАвтовыбора = УправлениеДаннымиОбИзделиях.ПараметрыАвтовыбораКонструктор();
	Исключение
		// Так было по 2.5.22
		ПараметрыАвтовыбора = УправлениеДаннымиОбИзделиях.ПолучитьПараметрыАвтовыбора();
	КонецПопытки;
	
	ПараметрыАвтовыбора.ТаблицаДанныхПоНоменклатуре = ТаблицаДанныхПоНоменклатуреДляПараметровАвтовыбораИРасчетаПоФормулам(ДанныеПоНоменклатуре);
	ПараметрыАвтовыбора.МенеджерВременныхТаблиц = МенеджерВременныхТаблицДляПараметровАвтовыбора(ПараметрыАвтовыбора.ТаблицаДанныхПоНоменклатуре);
	
	ПараметрыАвтовыбора.ПолучитьПредставления = Ложь;
	ПараметрыАвтовыбора.ПолучитьСведенияАвтовыбора = Истина;
	
	Таблицы = ДанныеСпецификацииТаблицыОбластьАвтовыбор(ПараметрыАвтовыбора.МенеджерВременныхТаблиц);
	ПараметрыАвтовыбора.ЗначенияСвойствИзделий = Таблицы.ЗначенияСвойствИзделий;
	ПараметрыАвтовыбора.СоответствиеСвойств = Таблицы.СоответствиеСвойств;
	
	// НаборДанныхПоНоменклатуре = СписокНоменклатуры();
	// ЗаполнитьЗначенияСвойств(НаборДанныхПоНоменклатуре.Добавить(), СписокСтруктураДанных);
	// ОбщегоНазначенияУТ.ПронумероватьТаблицуЗначений(СписокНоменклатуры, "Идентификатор");
	
	Возврат ПараметрыАвтовыбора;
	
КонецФункции

// %ИзЕРП% Справочники.РесурсныеСпецификации.ДанныеСпецификации
//
// Параметры:
//  ТаблицаДанныхПоНоменклатуре - ТаблицаЗначений - Таблица данных по номенклатуре.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция МенеджерВременныхТаблицДляПараметровАвтовыбора(ТаблицаДанныхПоНоменклатуре)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	Т.Идентификатор             КАК Идентификатор,
	|	Т.Спецификация              КАК Спецификация,
	|	Т.Номенклатура              КАК Номенклатура,
	|	Т.Характеристика            КАК Характеристика,
	|	Т.Количество                КАК Количество,
	|	Т.ПодразделениеДиспетчер    КАК ПодразделениеДиспетчер,
	|	Т.НаправлениеДеятельности   КАК НаправлениеДеятельности,
	|	Т.Распоряжение              КАК Распоряжение,
	|	Т.Назначение                КАК Назначение,
	|	Т.НачалоПроизводства        КАК НачалоПроизводства
	|ПОМЕСТИТЬ ВтДанныеПоНоменклатуре
	|ИЗ
	|	&НаборДанныхПоНоменклатуре КАК Т
	|";
	
	Запрос.УстановитьПараметр("НаборДанныхПоНоменклатуре", ТаблицаДанныхПоНоменклатуре);
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	
	Возврат МенеджерВременныхТаблиц;
	
КонецФункции

// %ИзЕРП% Справочники.РесурсныеСпецификации.ДанныеСпецификации
//
// Параметры:
//  МенеджерВременныхТаблиц - Произвольный - Менеджер временных таблиц.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
Функция ДанныеСпецификацииТаблицыОбластьАвтовыбор(МенеджерВременныхТаблиц)
	
	РазделительЗапросовВПакете = ОбщегоНазначения.РазделительПакетаЗапросов();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ИспользоватьПараметризацию", ПолучитьФункциональнуюОпцию("ИспользоватьПараметризациюРесурсныхСпецификаций"));
	Запрос.УстановитьПараметр("ИспользоватьТехнологическиеПроцессы", ПолучитьФункциональнуюОпцию("ИспользоватьТехнологическиеПроцессы"));
	
	ТекстыЗапроса = Новый СписокЗначений;
	
	#Область ВтТехнологическиеПроцессы
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВтДанныеПоНоменклатуре.Идентификатор                                    КАК Идентификатор,
	|
	|	Операции.Спецификация                                                   КАК Спецификация,
	|	ВЫРАЗИТЬ(Операции.Владелец КАК Справочник.ЭтапыПроизводства)            КАК Этап,
	|	Операции.Ссылка                                                         КАК Операция,
	|	Операции.ТехнологическийПроцесс                                         КАК ТехнологическийПроцесс,
	|	Операции.ТехнологическийПроцесс.ЕстьПараметризацияРесурсов              КАК ЕстьПараметризацияРесурсов,
	|	Операции.КоэффициентТехнологическогоПроцесса                            КАК Коэффициент,
	|
	|	ВЫРАЗИТЬ(Операции.Владелец КАК Справочник.ЭтапыПроизводства).НомерЭтапа КАК НомерЭтапа,
	|	Операции.НомерОперации                                                  КАК НомерОперации
	|
	|ПОМЕСТИТЬ ВтТехнологическиеПроцессы
	|ИЗ
	|	Справочник.ТехнологическиеОперации КАК Операции
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтДанныеПоНоменклатуре КАК ВтДанныеПоНоменклатуре
	|		ПО Операции.Спецификация = ВтДанныеПоНоменклатуре.Спецификация
	|
	|ГДЕ
	|	&ИспользоватьТехнологическиеПроцессы
	|	И Операции.СодержитТехнологическийПроцесс
	|	И НЕ Операции.ПометкаУдаления 
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса + РазделительЗапросовВПакете, "ВтТехнологическиеПроцессы");
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтТехнологическиеПроцессы.Спецификация           КАК Спецификация,
	|	ВтТехнологическиеПроцессы.ТехнологическийПроцесс КАК ТехнологическийПроцесс
	|
	|ПОМЕСТИТЬ ВтТехнологическиеПроцессыСпецификаций
	|ИЗ
	|	ВтТехнологическиеПроцессы КАК ВтТехнологическиеПроцессы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТехнологическийПроцесс
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса + РазделительЗапросовВПакете, "ВтТехнологическиеПроцессыСпецификаций");
	
	#КонецОбласти
	
	#Область Автовыбор

	ТекстЗапроса = 
	"ВЫБРАТЬ
