// Функция - Получить виды производственного движения в блюде
// 
// Возвращаемое значение:
//   Произвольный - Результат обработки.
//
Функция ПолучитьВидыПроизводственногоДвиженияВБлюде() Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить(Перечисления.питВидыПроизводственногоДвижения.ЗаготовкаВБлюде);
	Массив.Добавить(Перечисления.питВидыПроизводственногоДвижения.ЗаготовкаВБлюдеАвтопередел);
	Массив.Добавить(Перечисления.питВидыПроизводственногоДвижения.ТехнологическийОтходВБлюде);
	Массив.Добавить(Перечисления.питВидыПроизводственногоДвижения.ТоварВБлюде);
	Возврат Массив;
	
КонецФункции

#КонецОбласти
