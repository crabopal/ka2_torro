// Обработчик команды добавления типов оплат.
//
&НаКлиенте
Процедура ТипыОплатДобавить(Команда)
	
	МассивОрганизаций = Новый Массив;
	МассивОрганизаций.Добавить(Объект.Организация);
	МассивОрганизаций.Добавить(ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
	
	ЗначенияОтборов = Новый Структура;
	ЗначенияОтборов.Вставить("ТипОплаты",   Новый ФиксированныйМассив(ПолучитьДопустимыеТипыОплаты()));
	ЗначенияОтборов.Вставить("Организация", Новый ФиксированныйМассив(МассивОрганизаций));
	
	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыПередачи.Вставить("Отбор", ЗначенияОтборов);
	
	ОткрытьФорму("Справочник.питВидыОплатОрганизаций.ФормаВыбора", ПараметрыПередачи, ЭтаФорма);
	
КонецПроцедуры

