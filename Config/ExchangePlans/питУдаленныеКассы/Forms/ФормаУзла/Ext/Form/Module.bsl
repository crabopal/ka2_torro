

#Область ПрограммныйИнтерфейс

#Область ОбменСЭвотор


// Процедура - Обработчик оповещения подтверждение сброса токена
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры
//
&НаКлиенте
Процедура ОбработчикОповещения_ПодтверждениеСбросаТокена(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗапроситьПинКод();
	
КонецПроцедуры


// Процедура - ОбработчикОповещения_ВводПинКода
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры
//
&НаКлиенте
Процедура ОбработчикОповещения_ВводПинКода(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	Если РезультатОткрытияФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьСоединениеСТерминаломЭвотораНаСервере(РезультатОткрытияФормы);
КонецПроцедуры //ОбработчикОповещения_ВводПинКода

#КонецОбласти

// Процедура - Настроить маршрутизацию завершение
//
// Параметры:
//  РезультатВопроса		 Произвольный - Результат вопроса.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры
//
&НаКлиенте
Процедура НастроитьМаршрутизациюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		РезультатЗаписи = Записать();
		Если НЕ РезультатЗаписи Тогда
			Возврат;
		КонецЕсли; 
	Иначе
		Возврат;
	КонецЕсли;
	
	НастроитьМаршрутизациюФрагмент();
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

// Обработчик события формы "После записи".
// 
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбновитьПовторноИспользуемыеЗначения();
	ОбновитьСписокКассККМ();
	
	// После записи элемента, если открыта обработка ""Загрузка из чеков общепита"", то в ней перезапонить список касс.
	Оповестить("питКассовыйУзелЗаписан","питОбновитьСписокКассККМ","питОбновитьСписокКассККМ");
	
	ОбновитьИнформациюПравилаМаршрутизации();
	ЗаполнитьТолькоИерархия();
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ ФОРМЫ

// Обработчик события формы "При создании на сервере".
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьИндикациюДат(ДатаВыгрузки, ДатаЗагрузки);
	
	Если Параметры.Свойство("ЗначенияЗаполнения") Тогда
		ЗаполнитьЗначенияСвойств(Объект, Параметры.ЗначенияЗаполнения);
	КонецЕсли;
	
	Если Параметры.Свойство("ВыполнятьЗагрузкуИзДанныхПродажФронта") И НЕ Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта = Параметры.ВыполнятьЗагрузкуИзДанныхПродажФронта Тогда
		Объект.ВыполнятьЗагрузкуИзДанныхПродажФронта = Параметры.ВыполнятьЗагрузкуИзДанныхПродажФронта;
		Модифицированность = Истина;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() 
		И ЗначениеЗаполнено(Объект.УзелТерминала) Тогда
		Объект.УзелТерминала = Параметры.УзелТерминала;
		ОбновитьРеквизитыПоТерминалу();
		Модифицированность = Истина;
	КонецЕсли;
	
	УстановитьНастройкиПоУмолчанию();
	
	ОбновитьСписокКассККМ();
	
	ОбновитьИнформациюПравилаМаршрутизации();
	
	Элементы.ПодарочныеСертификатыВидОплаты.СписокВыбора.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питВидыОплатОрганизаций.Ссылка
		|ИЗ
		|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
		|ГДЕ
		|	питВидыОплатОрганизаций.ТипОплаты В(&ТипыОплат)";
	ТипыОплат = Новый Массив(2);
	ТипыОплат.Добавить(Перечисления.питТипыОплат.ПодарочныйСертификатСобственный);
	ТипыОплат.Добавить(Перечисления.питТипыОплат.ПодарочныйСертификатСторонний);
	Запрос.УстановитьПараметр("ТипыОплат", ТипыОплат);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Элементы.ПодарочныеСертификатыВидОплаты.СписокВыбора.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	МожноРедактировать = ПравоДоступа("Редактирование", Метаданные.ПланыОбмена.питУдаленныеКассы);
	ЭтаФорма.ТолькоПросмотр = НЕ МожноРедактировать;
	Элементы.ВидыМенюВидыМенюДобавить.Видимость = МожноРедактировать;
	Элементы.ВидыМенюВидыМенюИзменить.Видимость = МожноРедактировать;
	Элементы.ДополнительныеОрганизацииОрганизацииДобавить.Видимость = МожноРедактировать;
	Элементы.ДополнительныеОрганизацииОрганизацииИзменить.Видимость = МожноРедактировать;
	Элементы.ЗалыЗалыДобавить.Видимость = МожноРедактировать;
	Элементы.ЗалыЗалыИзменить.Видимость = МожноРедактировать;
	Элементы.МестаПечатиМестаПечатиДобавить.Видимость = МожноРедактировать;
	Элементы.МестаПечатиМестаПечатиИзменить.Видимость = МожноРедактировать;
	
	ИспользуютсяСоглашенияСКлиентами = 
		Не (Константы.ИспользованиеСоглашенийСКлиентами.Получить() = Перечисления.ИспользованиеСоглашенийСКлиентами.НеИспользовать);
	Элементы.КонтрагентыСоглашение.Видимость = ИспользуютсяСоглашенияСКлиентами;
	
	МожноРедактироватьОрганизации = ПравоДоступа("Редактирование", Метаданные.ПланыОбмена.питУдаленныеКассы.ТабличныеЧасти.ДополнительныеОрганизации);
	Элементы.ДополнительныеОрганизацииОрганизацииДобавить.Видимость = МожноРедактироватьОрганизации;
	Элементы.ДополнительныеОрганизацииОрганизацииИзменить.Видимость = МожноРедактироватьОрганизации;
	
	Если Объект.Ссылка.Пустая() Тогда
		ИнициализацияНовогоКассовогоУзла();
	КонецЕсли;
	
	ЗаполнитьТолькоИерархия();
	
КонецПроцедуры

// Обработчик события формы "При открытии".
// 
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеИнтерфейсом();
	Если (ПустаяСтрока(Объект.ВерсияФронтОфиса) ИЛИ  Объект.Ссылка.Пустая()) И МожноРедактировать Тогда
		Объект.ВерсияФронтОфиса = "Неизвестна";
	КонецЕсли;
	Модифицированность = Ложь;
КонецПроцедуры

// Обработчик события формы "При повторном открытии".
//
&НаКлиенте
Процедура ПриПовторномОткрытии()
	ПриОткрытии(Ложь);
КонецПроцедуры

// Обработчие оповещения.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "питМаршрутизацияПечати_ФормаСписка_Закрытие" Тогда
		ОбновитьИнформациюПравилаМаршрутизации();
	КонецЕсли;
КонецПроцедуры

// Обработчик выбора формы.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если НЕ ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначенияВыбора = ТипЗнч(ВыбранноеЗначение);
	Если ТипЗначенияВыбора = Тип("СправочникСсылка.питВидыМеню") Тогда		
		НайденныеСтроки = Объект.ВидыМеню.НайтиСтроки(Новый Структура("ВидМеню", ВыбранноеЗначение));		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ПоказатьПредупреждение(Неопределено, "Вид меню <" + СокрЛП(ВыбранноеЗначение) + "> уже есть в табличной части!", , "Ошибка");
			Возврат;
		КонецЕсли;		
		НоваяСтрока = Объект.ВидыМеню.Добавить();
		НоваяСтрока.ВидМеню = ВыбранноеЗначение;
		ДопРегистрацияСсылкиНаСервере(ВыбранноеЗначение, Истина);
		ЭтотОбъект.Модифицированность = Истина;
		
	ИначеЕсли ТипЗначенияВыбора = Тип("СправочникСсылка.Номенклатура") Тогда		
		Если Объект.Номенклатура.НайтиСтроки(Новый Структура("Номенклатура", ВыбранноеЗначение)).Количество() > 0 Тогда
			ПоказатьПредупреждение(Неопределено, "Номенклатура " + Строка(ВыбранноеЗначение) + " уже есть в табличной части.", , "Ошибка");
			Возврат;
		КонецЕсли;		
		Если ВыбранаВсяНоменклатура(Объект.Номенклатура) Тогда
			Объект.Номенклатура.Очистить();
		КонецЕсли;
		НоваяСтрока = Объект.Номенклатура.Добавить();
		НоваяСтрока.Номенклатура = ВыбранноеЗначение;
		НоваяСтрока.Организация = Объект.Организация;
		НоваяСтрока.ЭтоГруппа = питОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыбранноеЗначение,"ЭтоГруппа");
		//Элементы.Номенклатура.ТекущаяСтрока = НоваяСтрока;
		ДопРегистрацияСсылкиНаСервере(ВыбранноеЗначение, Истина, НоваяСтрока.ЭтоГруппа);
		ЭтотОбъект.Модифицированность = Истина;
		Объект.ИндивидуальныйСписокНоменклатуры = Истина;
		
	ИначеЕсли ТипЗначенияВыбора = Тип("СправочникСсылка.Организации") Тогда		
		Если ВыбранноеЗначение = Объект.Организация Тогда
			ПоказатьПредупреждение(Неопределено,"Организация <" + СокрЛП(ВыбранноеЗначение) + "> уже указана в качестве основной организации!", , "Ошибка");
			Возврат;
		КонецЕсли;	
		Если Объект.ДополнительныеОрганизации.НайтиСтроки(Новый Структура("Организация", ВыбранноеЗначение)).Количество() > 0 Тогда
			ПоказатьПредупреждение(Неопределено,"Организация <" + СокрЛП(ВыбранноеЗначение) + "> уже есть в табличной части!", , "Ошибка");
			Возврат;
		КонецЕсли;		
		НоваяСтрока = Объект.ДополнительныеОрганизации.Добавить();
		НоваяСтрока.Организация = ВыбранноеЗначение;		
		//Элементы.ДополнительныеОрганизации.ТекущаяСтрока = НоваяСтрока;
		ДопРегистрацияСсылкиНаСервере(ВыбранноеЗначение);
		ЭтотОбъект.Модифицированность = Истина;
		
	ИначеЕсли ТипЗначенияВыбора = Тип("СправочникСсылка.Склады") Тогда 		
		Если Объект.МестаХранения.НайтиСтроки(Новый Структура("МестоХранения", ВыбранноеЗначение)).Количество() > 0 Тогда
			ПоказатьПредупреждение(Неопределено,"Место хранения <" + СокрЛП(ВыбранноеЗначение) + "> уже есть в табличной части!", , "Ошибка");
			Возврат;
		КонецЕсли;		
		НоваяСтрока = Объект.МестаХранения.Добавить();
		НоваяСтрока.МестоХранения = ВыбранноеЗначение;		
		//Элементы.МестаХранения.ТекущаяСтрока = НоваяСтрока;
		ДопРегистрацияСсылкиНаСервере(ВыбранноеЗначение, Истина);
		ЭтотОбъект.Модифицированность = Истина;
		
	ИначеЕсли ТипЗначенияВыбора = Тип("СправочникСсылка.питЗалы") Тогда
		Если Объект.Залы.НайтиСтроки(Новый Структура("Зал", ВыбранноеЗначение)).Количество() > 0 Тогда
			ПоказатьПредупреждение(Неопределено, "Зал <" + СокрЛП(ВыбранноеЗначение) + "> уже есть в табличной части!", , "Ошибка");
			Возврат;
		КонецЕсли;
		НоваяСтрока = Объект.Залы.Добавить();
		НоваяСтрока.Зал = ВыбранноеЗначение;		
		//Элементы.Залы.ТекущаяСтрока = НоваяСтрока;
		ДопРегистрацияСсылкиНаСервере(ВыбранноеЗначение);
		ЭтотОбъект.Модифицированность = Истина;
		
	ИначеЕсли ТипЗначенияВыбора = Тип("СправочникСсылка.питМестаПечати") Тогда		
		Если Объект.МестаПечати.НайтиСтроки(Новый Структура("МестоПечати", ВыбранноеЗначение)).Количество() > 0 Тогда
			ПоказатьПредупреждение(Неопределено,"Место печати <" + СокрЛП(ВыбранноеЗначение) + "> уже есть в табличной части!", , "Ошибка");
			Возврат;
		КонецЕсли;
		НоваяСтрока = Объект.МестаПечати.Добавить();
		НоваяСтрока.МестоПечати = ВыбранноеЗначение;		
		//Элементы.МестаПечати.ТекущаяСтрока = НоваяСтрока;		
		ДопРегистрацияСсылкиНаСервере(ВыбранноеЗначение);
		ОбновитьИнформациюПравилаМаршрутизации();
		ЭтотОбъект.Модифицированность = Истина;
				
	ИначеЕсли ТипЗначенияВыбора = Тип("СправочникСсылка.питВидыОплатОрганизаций") Тогда		
		//Если Объект.ТипыОплат.НайтиСтроки(Новый Структура("ТипОплаты", ВыбранноеЗначение)).Количество() > 0 Тогда
		//	ПоказатьПредупреждение(Неопределено,"Тип оплаты <" + СокрЛП(ВыбранноеЗначение) + "> уже есть в табличной части!",, "Ошибка");
		//	Возврат;
		//КонецЕсли;		
		//НоваяСтрока = Объект.ТипыОплат.Добавить();
		//НоваяСтрока.ТипОплаты = ВыбранноеЗначение;		
		////Элементы.ТипыОплат.ТекущаяСтрока = НоваяСтрока;    
		//ДопРегистрацияСсылкиНаСервере(ВыбранноеЗначение, Истина);
		//ЭтотОбъект.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события формы "Перед записью".
// 
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ Объект.Многофирменность Тогда
		Объект.ДополнительныеОрганизации.Очистить();
	Иначе
		ТекстОшибки = "";
		Отказ = НЕ ПроверитьОрганизацииПодразделений(ТекстОшибки);
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "ДополнительныеОрганизации", "Объект", Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Объект.ИндивидуальныйСписокВидовМенюИНоменклатуры Тогда
		Объект.ВидыМеню.Очистить();
		Объект.Номенклатура.Очистить();
	КонецЕсли;
	
	Если Объект.ВерсияФронтОфиса = "Неизвестна" Тогда
		Объект.ВерсияФронтОфиса = "";
	КонецЕсли;
	
	Если Объект.Префикс <> Объект.Код Тогда
		Объект.Префикс = Объект.Код;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

// Обработчик изменения реквизита, определяющего способ миграции маршрутизации печати.
//
&НаКлиенте
Процедура ПравилаПередачиМаршрутизацииПриИзменении(Элемент)
	
	// Если объект КУ уже был записан(ссылка существует), тогда пробуем сделать регистрацию для этого КУ.
	Если НЕ(ПустаяСтрока(Объект.ВерсияДанных) ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка)) Тогда
		ЗарегистрироватьМаршрутизациюПечатиПоПравилу(Объект.ПравилаПередачиМаршрутизации, Объект.Ссылка);
	КонецЕсли;
	
	ОбновитьИнформациюПравилаМаршрутизации();
	УправлениеИнтерфейсом();
	
КонецПроцедуры

// Обработчик изменения флага "Многофирменность".
//
&НаКлиенте
Процедура МногофирменностьПриИзменении(Элемент)
	УправлениеИнтерфейсом();
КонецПроцедуры

// Обработчик изменения флага "Индивидуальный список видов меню и номенклатуры".
