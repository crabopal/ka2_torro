	Для Каждого СтрокаКонтрагенты Из Объект.Контрагенты Цикл 
		Если Не СтрокаКонтрагенты.НомерСтроки = ТекДанные.НомерСтроки
		   И СтрокаКонтрагенты.ВидОплаты = ТекДанные.ВидОплаты Тогда 
			ТекДанные.ВидОплаты = Справочники.питВидыОплатОрганизаций.ПустаяСсылка();
			Возврат
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВыбранаВсяНоменклатура(ТЧНоменклатура)
	Если ТЧНоменклатура.Количество() = 1
		И НЕ ЗначениеЗаполнено(ТЧНоменклатура[0].Номенклатура) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьЭлементовПоТипуКассовогоУзла()
	
	// (0) 1С:Фастфуд.Фронт-офис 
	// (1) 1С:Ресторан.Фронт-офис,
	// (2) 1С:Ресторан ред.1,
	// (3) 1C-Рарус:Фастфуд Evo,
	// (4) РестАрт,
	// (5) RK7,
	// (6) IIKO,
	// (7) Облако Эвотор,
	// (8) 1C-Рарус:Ресторан Evo.
	ЭтоФронтРаруса = НЕ (питОбменДаннымиКлиентСервер.ТипыУзлов(1).Найти(Объект.ТипКассовогоУзла) = Неопределено);
	
	// Параметры выгрузки/загрузки.
	Элементы.ВыгружатьСтопДляПозицийМеню.Видимость = ЭтоФронтРаруса;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеТабличнойЧасти(ТабличнаяЧасть, ИмяОсновногоРеквизита, ЗначениеПустогоРеквизита)
	
	// Если ТЧ пустая, то проверять на выгружать все элементы - не нужно.
	Если НЕ ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоЭлементов = ТабличнаяЧасть.Количество();
	
	Если КоличествоЭлементов >1 Тогда
		
		// Проверим есть ли пустой элемент.
		МассивСтрок = ТабличнаяЧасть.НайтиСтроки(Новый Структура(ИмяОсновногоРеквизита, ЗначениеПустогоРеквизита));
		Если ЗначениеЗаполнено(МассивСтрок) Тогда
			ТабличнаяЧасть.Удалить(МассивСтрок[0]);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти




