	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ТипОплатыДоступныеЗначения", ПолучитьДопустимыеТипыОплаты());
	ПараметрыПередачи.Вставить("Ключ", Элементы.ТипыОплат.ТекущиеДанные.ТипОплаты);
	
	ОткрытьФорму("Справочник.питВидыОплатОрганизаций.ФормаОбъекта", ПараметрыПередачи, ЭтаФорма);
	
