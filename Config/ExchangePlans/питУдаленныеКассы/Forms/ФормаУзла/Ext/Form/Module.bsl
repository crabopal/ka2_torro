// Выводит на форму узла информацию о настроенных правилах маршрутизации печати.
//
&НаСервере
Процедура ОбновитьИнформациюПравилаМаршрутизации()
	
	ИнформацияПравила = "";
	ЦветТекста = Новый Цвет;
	
	КоличествоПравил = ПолучитьКоличествоПравилМаршрутизации();
	Если Объект.ПравилаПередачиМаршрутизации = 0 Тогда
		ИнформацияПравила = "Обмен правилами маршрутизации не производится.";		
		ЦветТекста = ЦветаСтиля.ЦветТекстаПредупреждение;
	ИначеЕсли Объект.ПравилаПередачиМаршрутизации = 2 И Объект.Ссылка.Пустая() Тогда
		ИнформацияПравила = "Для настройки правил маршрутизации необходимо записать данный кассовый узел.";
		ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
	ИначеЕсли КоличествоПравил = 0 Тогда
		ИнформацияПравила = "Правила маршрутизации не настроены.";
		ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
	Иначе
		ПолучитьДанныеОНастройкахМаршрутизации(КоличествоПравил, ИнформацияПравила, ЦветТекста);
	КонецЕсли; 
	
	Элементы.ИнформацияМаршрутизация.Заголовок = ИнформацияПравила;
	Элементы.ИнформацияМаршрутизация.ЦветТекста = ЦветТекста;
	
КонецПроцедуры

&НаСервереБезКонтекста
