&НаКлиенте
Функция НовоеЗначениеИндивидуальногоСписка(ТабличнаяЧасть,ПроверяемыйРеквизит)
	
		// Выполним проверку пользователей.
	Если ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
		КоличествоПользователей = ТабличнаяЧасть.Количество();
		Если КоличествоПользователей > 1 Тогда
			Результат = Истина;
		Иначе
			// Если элемент пустой, то выгружаем все.
			Результат = ЗначениеЗаполнено(ТабличнаяЧасть[0][ПроверяемыйРеквизит]);
		КонецЕсли;
	Иначе
		// Список пустой - включаем фильтрацию.
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ИнициализацияНовогоКассовогоУзла()
	
	Объект.РазделениеЧеков = Перечисления.питВариантыРазделенияЧеков.НеРазделять;
	Объект.НастройкаДоставкиПоУмолчанию = Справочники.питНастройкиДоставкиСообщений.ЛокальнаяСеть;
	Объект.ПриниматьТолькоДанныеПродаж = Истина;
	Объект.РазрешитьПриемМенюИзКУ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Пользователи) Тогда
		//Добавим пустую строку (выгружаем все элементы).
		Объект.Пользователи.Добавить();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		//Добавим пустую строку (выгружаем все элементы).
		НоваяСтрока = Объект.Номенклатура.Добавить();
		НоваяСтрока.Организация = Объект.Организация;
		Объект.ИндивидуальныйСписокНоменклатуры = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТолькоИерархия()
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) 
		И Объект.ИндивидуальныйСписокНоменклатуры Тогда
		МассивСсылок = Новый Массив;
		Для Каждого ТекСтрока Из Объект.Номенклатура Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				МассивСсылок.Добавить(ТекСтрока.Номенклатура);
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&МассивСсылок)";
		Запрос.УстановитьПараметр("МассивСсылок", Объект.Номенклатура.Выгрузить(,"Номенклатура"));
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрокиТЧ = Объект.Номенклатура.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Ссылка));
				Для Каждого ТекСтрокаТЧ Из СтрокиТЧ Цикл
					ТекСтрокаТЧ.ЭтоГруппа = Выборка.ЭтоГруппа;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентыКлиентПриИзмененииНаСервере(ИндексСтроки)
	ТекущаяСтрока = Объект.Контрагенты.НайтиПоИдентификатору(ИндексСтроки);
	ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(ТекущаяСтрока.Клиент, ТекущаяСтрока.Контрагент,Истина);
