// Функция проверка правильности заполнения ТЧ "Дополнительные организации".
//
// Параметры:
//  ТекстОшибки	 - Строка - Если результат ЛОЖЬ, то будет записан текст ошибки.
// 
// Возвращаемое значение:
//  Булево - Результат проверки.
//
Функция ПроверитьОрганизацииПодразделений(ТекстОшибки = "")
	
	Возврат Истина; //+chesdm_debug
	
	Результат = Истина;
	ПодразделенияТЧ = Объект.ДополнительныеОрганизации.Выгрузить();
	ПодразделенияТЧ.Свернуть("Подразделение");
	ПерваяНайденнаяОрганизация = Неопределено;
	ОшибочныеОрганизацииТекст = "";
	Сч = 0;
	
	// Обходим подразделения и проверяем, нет ли у каждого из подразделений более 1 организации.
	Для каждого ТекПодразделение Из ПодразделенияТЧ Цикл
		// Цикл по подразделениям
		
		Сч = 0; // Счетчик организаций текущего подразделения
		
		Для каждого ТекСтрока Из Объект.ДополнительныеОрганизации Цикл
			// Цикл по всей ТЧ
			Если ТекСтрока.Подразделение = ТекПодразделение.Подразделение Тогда
				// Нашли строку подразделения
				Если Сч = 0 Тогда 
					// Записали первую найденную организацию
					ПерваяНайденнаяОрганизация = ТекСтрока.Организация;
					Сч = Сч + 1;
				Иначе
					// Это уже не первая организация для данного подразделения, считаем, что это ошибка.
					ОшибочныеОрганизацииТекст = ОшибочныеОрганизацииТекст + "
					| - Подразделение <"+ТекСтрока.Подразделение+"> указано для нескольких организаций";
					Результат = Ложь;
					Прервать; // Переходим на следующую итерацию цикла по подразделениям.
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если НЕ Результат Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС + "Ошибка при проверке таблицы дополнительных организаций: " 
			+ ОшибочныеОрганизацииТекст;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПроверитьОрганизацииПодразделений

