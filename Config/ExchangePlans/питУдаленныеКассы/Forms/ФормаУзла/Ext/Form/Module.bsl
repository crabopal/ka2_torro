&НаКлиенте
Процедура НоменклатураВыгружатьВсе(Команда)
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		Объект.Номенклатура.Очистить();
	КонецЕсли;
	
	НоваяСтрока = Объект.Номенклатура.Добавить();
	НоваяСтрока.Организация = Объект.Организация;
	Объект.ИндивидуальныйСписокНоменклатуры = Ложь;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбменСЭвотор

&НаСервере
Процедура ОбновитьРеквизитыПоТерминалу()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПодключаемоеОборудование.Организация КАК Организация
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.УзелИнформационнойБазы = &УзелИнформационнойБазы";
	
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", Объект.УзелТерминала);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Объект.ДополнительныеОрганизации.Очистить();
	Если Выборка.Следующий() Тогда
		Объект.Организация = Выборка.Организация;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Функция ПроверитьВозможностьСоединенияСЭвотор()
	Отказ = Ложь;
	
	ТекстОшибки = "";
	
	Если Объект.Ссылка.Пустая() Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Кассовый узел не записан'", "ru");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.НастройкаДоставкиПоУмолчанию) Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Настройка доставки не указана'", "ru");
	КонецЕсли;
	
	ПроверитьВозможностьСоединенияСЭвоторНаСервере(Объект.НастройкаДоставкиПоУмолчанию, Отказ, ТекстОшибки);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Возврат Отказ;
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьВозможностьСоединенияСЭвоторНаСервере(НастройкаДоставкиПоУмолчанию, Отказ, ТекстОшибки)

	ПараметрыДоставки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаДоставкиПоУмолчанию, "СпособОбмена, АдресСервераHTTP");
	
	Если НЕ ПараметрыДоставки.СпособОбмена = 4 Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Для обмена необходимо использовать способ доставки HTTP соединение'", "ru");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыДоставки.АдресСервераHTTP) Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Адрес сервера не задан'", "ru");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПинКод()
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ОбработчикОповещения_ВводПинКода", ЭтотОбъект),,НСтр("ru='Ввод пин-кода'", "ru"),4, Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСоединениеСТерминаломЭвотораНаСервере(ПинКод)
	
	ВходныеПараметры= Новый Структура;
	ВходныеПараметры.Вставить("ПинКод", ПинКод);
	ВходныеПараметры.Вставить("Префикс", Объект.Префикс);
	ВходныеПараметры.Вставить("НастройкаДоставкиПоУмолчанию", Объект.НастройкаДоставкиПоУмолчанию);
	ВходныеПараметры.Вставить("НаименованиеОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,"Наименование"));
	ВходныеПараметры.Вставить("НаименованиеУзла", Объект.Наименование);
	
	ВыходныеПараметры = Обработки.питДоставкаСообщений.НачатьВыполнениеКоманды("СинхронизацияСТерминалом", ВходныеПараметры);
	
	Если ВыходныеПараметры.Результат Тогда
		Если ВыходныеПараметры.РезультатСинхронизации.Свойство("ТокенТерминала") Тогда
			Объект.ТокенТерминала = ВыходныеПараметры.РезультатСинхронизации.ТокенТерминала;
		КонецЕсли;
		
		Если ВыходныеПараметры.РезультатСинхронизации.Свойство("КодТерминала") Тогда
			Объект.КодТерминала = ВыходныеПараметры.РезультатСинхронизации.КодТерминала;
		КонецЕсли;
		
		Модифицированность = Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ВыходныеПараметры.ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Процедура, устанавливающая индикацию дат загрузки и выгрузки на основании данных регистра истории обменов.
//
&НаСервере
Процедура УстановитьИндикациюДат(ДатаВыгрузки, ДатаЗагрузки)
	
	ДатаВыгрузки = "Не определена";
	ДатаЗагрузки = "Не определена";
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияОбменовДанными.ДействиеПриОбмене,
	|	СостоянияОбменовДанными.РезультатВыполненияОбмена,
	|	СостоянияОбменовДанными.ДатаОкончания
	|ИЗ
	|	РегистрСведений.СостоянияОбменовДанными КАК СостоянияОбменовДанными
	|ГДЕ
	|	СостоянияОбменовДанными.УзелИнформационнойБазы = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных Тогда
			ДатаВыгрузки = Формат(Выборка.ДатаОкончания, "");
			Если Выборка.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено Тогда
				Элементы.ДатаВыгрузки.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
			Иначе
				Элементы.ДатаВыгрузки.ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
			КонецЕсли;
		Иначе
			ДатаЗагрузки = Формат(Выборка.ДатаОкончания, "");
			Если Выборка.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено Тогда
				Элементы.ДатаЗагрузки.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
			Иначе
				Элементы.ДатаЗагрузки.ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

// Процедура получает список касс ККМ, относящихся к данному узлу.
//
&НаСервере
Функция ПолучитьСписокКассККМ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КассыККМ.Ссылка КАК КассаККМ
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	КассыККМ.питКассовыйУзел = &КассовыйУзел";
	Запрос.УстановитьПараметр("КассовыйУзел", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультат = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаРезультат.ВыгрузитьКолонку("КассаККМ");
	
КонецФункции

// Процедура получающая строки состояния настройки маршрутизации.
//
&НаСервере
Процедура ПолучитьДанныеОНастройкахМаршрутизации(КоличествоПравил, ИнформацияПравила, ЦветТекста)
	
	ТекстНезаданныеМестаПечати = "";
	ТекстНезаданныеЗалы = "";
	ТекстНезаданныеВидыМеню = "";
	ОбщийТекст = "";
	Разделитель = "";
	
	// Места печати
	МестаПечатиЗаданы = ПолучитьНезаданныеМестаПечати(ТекстНезаданныеМестаПечати);
	Если НЕ МестаПечатиЗаданы  Тогда
		ТекстНезаданныеМестаПечати = "места печати: " + ТекстНезаданныеМестаПечати;
		ОбщийТекст = ОбщийТекст + Разделитель + ТекстНезаданныеМестаПечати;
		Разделитель = ", ";
	КонецЕсли; 
	
	// Залы
	ЗалыЗаданы = ПолучитьНезаданныеЗалы(ТекстНезаданныеЗалы);
	Если НЕ ЗалыЗаданы Тогда
		ТекстНезаданныеЗалы = "залы: " + ТекстНезаданныеЗалы;
		ОбщийТекст = ОбщийТекст + Разделитель + ТекстНезаданныеЗалы;
		Разделитель = ", ";
	КонецЕсли; 
	
	// Вид меню
	ВидыМенюЗаданы = ПолучитьНезаданныеВидыМеню(ТекстНезаданныеВидыМеню);
	Если НЕ ВидыМенюЗаданы Тогда
		ТекстНезаданныеВидыМеню = "виды меню: " + ТекстНезаданныеВидыМеню;
		ОбщийТекст = ОбщийТекст + Разделитель + ТекстНезаданныеВидыМеню;
		Разделитель = ", ";
	КонецЕсли; 
	
	ОбщийРезультат = МестаПечатиЗаданы И ЗалыЗаданы И ВидыМенюЗаданы;
	
	Если ОбщийРезультат Тогда
		ИнформацияПравила = "Настроено правил: " + Строка(КоличествоПравил);
		ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
	Иначе
		ИнформацияПравила = "В правилах указаны объекты, не выгружаемые в данный кассовый узел: " + ОбщийТекст;
		ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
	КонецЕсли; 
	
КонецПроцедуры

// Получает общее количество настроенных правил маршрутизации печати.
//
// Параметры:
//	 Нет.
//
// Возвращаемое значение:
//	Число. Количество правил.
//
&НаСервере
Функция ПолучитьКоличествоПравилМаршрутизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(МаршрутизацияПечати.МестоПечати) КАК КоличествоПравил
	|ИЗ
	|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
	|ГДЕ
	|	МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел";
	
	Если Объект.ПравилаПередачиМаршрутизации = 2 Тогда
		КассовыйУзел = Объект.Ссылка;
	Иначе
		КассовыйУзел = ПланыОбмена.питУдаленныеКассы.ПустаяСсылка();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КассовыйУзел", КассовыйУзел);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КоличествоПравил;
	
КонецФункции

// Получает список мест печати по настроенным правилам маршрутизации печати.
//
// Параметры:
//	 Нет.
//
// Возвращаемое значение:
//	Массив. Заданные места печати.
//
&НаСервере
Функция ПолучитьМестаПечатиПоПравиламМаршрутизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МаршрутизацияПечати.МестоПечати КАК МестоПечати
	|ИЗ
	|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
	|ГДЕ
	|	МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел
	|	И МаршрутизацияПечати.МестоПечати <> ЗНАЧЕНИЕ(Справочник.питМестаПечати.ПустаяСсылка)
	|";
	
	Если Объект.ПравилаПередачиМаршрутизации = 2 Тогда
		КассовыйУзел = Объект.Ссылка;
	Иначе
		КассовыйУзел = ПланыОбмена.питУдаленныеКассы.ПустаяСсылка();
	КонецЕсли; 
	Запрос.УстановитьПараметр("КассовыйУзел", КассовыйУзел);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультат = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаРезультат.ВыгрузитьКолонку("МестоПечати");
	
КонецФункции

// Получает строку текста с местаими печати, не выгружаемыми в узел.
//
&НаСервере
Функция ПолучитьНезаданныеМестаПечати(ТекстНезаданныеМестаПечати)
	
	МассивМестаПечати = ПолучитьМестаПечатиПоПравиламМаршрутизации();
	МестоПечатиЗадано = Неопределено;
	ТекстНезаданныеМестаПечати = "";
	Разделитель = "";
	Для каждого ТекМестоПечати Из МассивМестаПечати Цикл
		
		НайденныеСтроки = Объект.МестаПечати.НайтиСтроки(Новый Структура("МестоПечати", ТекМестоПечати));
		Если НайденныеСтроки.Количество() = 0 Тогда
			ТекстНезаданныеМестаПечати = ТекстНезаданныеМестаПечати + Разделитель + Строка(ТекМестоПечати);
			Если МестоПечатиЗадано = Неопределено Тогда
				МестоПечатиЗадано = Ложь;
				Разделитель = ", ";
			КонецЕсли;
		КонецЕсли; 
		
	КонецЦикла; 
	Если МестоПечатиЗадано = Неопределено Тогда
		МестоПечатиЗадано = Истина;
	КонецЕсли;
	
	Возврат МестоПечатиЗадано;
	
КонецФункции

// Получает строку текста с залами, не выгружаемыми в узел.
//
&НаСервере
Функция ПолучитьНезаданныеЗалы(ТекстНезаданныеЗалы)
	
	МассивЗалы = ПолучитьЗалыПоПравиламМаршрутизации();
	ЗалЗадан = Неопределено;
	ТекстНезаданныеЗалы = "";
	Разделитель = "";
	// Если ТЧ пустое значит все залы известны узлу.
	Если Объект.Залы.Количество() > 0 Тогда
		Для Каждого ТекЗал Из МассивЗалы Цикл
			
			НайденныеСтроки = объект.Залы.НайтиСтроки(Новый Структура("Зал", ТекЗал));
			Если НайденныеСтроки.Количество() = 0 Тогда
				ТекстНезаданныеЗалы = ТекстНезаданныеЗалы + Разделитель + Строка(ТекЗал);
				Если ЗалЗадан = Неопределено Тогда
					ЗалЗадан = Ложь;
					Разделитель = ", ";
				КонецЕсли;
			КонецЕсли; 
			
		КонецЦикла;
	КонецЕсли;

	Если ЗалЗадан = Неопределено Тогда
		ЗалЗадан = Истина;
	КонецЕсли; 
	
	Возврат ЗалЗадан;
	
КонецФункции
 
// Получает строку текста с видами меню, не выгружаемыми в узел.
//
&НаСервере
Функция ПолучитьНезаданныеВидыМеню(ТекстНезаданныеВидыМеню)
	
	Если Объект.ВидыМеню.Количество() = 0 Тогда
		ВидМенюЗадан = Истина;
		Возврат ВидМенюЗадан;
	КонецЕсли; 
	
	МассивВидыМеню = ПолучитьВидыМенюПоПравиламМаршрутизации();
	ВидМенюЗадан = Неопределено;
	ТекстНезаданныеВидыМеню = "";
	Разделитель = "";
	Для каждого ТекВидМеню Из МассивВидыМеню Цикл
		
		НайденныеСтроки = Объект.ВидыМеню.НайтиСтроки(Новый Структура("ВидМеню", ТекВидМеню));
		Если НайденныеСтроки.Количество() = 0 Тогда
			ТекстНезаданныеВидыМеню = ТекстНезаданныеВидыМеню + Разделитель + Строка(ТекВидМеню);
			Если ВидМенюЗадан = Неопределено Тогда
				ВидМенюЗадан = Ложь;
				Разделитель = ", ";
			КонецЕсли;
		КонецЕсли; 
		
	КонецЦикла; 
	Если ВидМенюЗадан = Неопределено Тогда
		ВидМенюЗадан = Истина;
	КонецЕсли; 
	
	Возврат ВидМенюЗадан;
	
КонецФункции

// Получает список залов по настроенным правилам маршрутизации печати.
//
&НаСервере
Функция ПолучитьЗалыПоПравиламМаршрутизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МаршрутизацияПечати.Зал КАК Зал
	|ИЗ
	|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
	|ГДЕ
	|	МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел
	|	И МаршрутизацияПечати.Зал <> ЗНАЧЕНИЕ(Справочник.питЗалы.ПустаяСсылка)";
	
	Если Объект.ПравилаПередачиМаршрутизации = 2 Тогда
		КассовыйУзел = Объект.Ссылка;
	Иначе
		КассовыйУзел = ПланыОбмена.питУдаленныеКассы.ПустаяСсылка();
	КонецЕсли; 
	Запрос.УстановитьПараметр("КассовыйУзел", КассовыйУзел);
	РезультатЗапроса = Запрос.Выполнить();
	МассивЗалы = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Зал");
	
	Возврат МассивЗалы;
	
КонецФункции

// Получает список видов меню по настроенным правилам маршрутизации печати.
//
&НаСервере
Функция ПолучитьВидыМенюПоПравиламМаршрутизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МаршрутизацияПечати.ВидМеню КАК ВидМеню
	|ИЗ
	|	РегистрСведений.питМаршрутизацияПечати КАК МаршрутизацияПечати
	|ГДЕ
	|	МаршрутизацияПечати.КассовыйУзел = &КассовыйУзел
	|	И МаршрутизацияПечати.ВидМеню <> ЗНАЧЕНИЕ(Справочник.питВидыМеню.ПустаяСсылка)";
	
	Если Объект.ПравилаПередачиМаршрутизации = 2 Тогда
		КассовыйУзел = Объект.Ссылка;
	Иначе
		КассовыйУзел = ПланыОбмена.питУдаленныеКассы.ПустаяСсылка();
	КонецЕсли; 
	Запрос.УстановитьПараметр("КассовыйУзел", КассовыйУзел);
	РезультатЗапроса = Запрос.Выполнить();
	МассивВидыМеню = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ВидМеню");
	
	Возврат МассивВидыМеню;
	
КонецФункции

