
#Область ПрограммныйИнтерфейс


// Процедура - Обработчик оповещения подтверждение сброса токена
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры
//
&НаКлиенте
Процедура ОбработчикОповещения_ПодтверждениеСбросаТокена(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗапроситьПинКод();
	
КонецПроцедуры


// Процедура - ОбработчикОповещения_ВводПинКода
//
// Параметры:
//  РезультатОткрытияФормы	 - Произвольный - Результат открытия окна.
//  ДополнительныеПараметры	 - Структура - ДополнительныеПараметры
//
&НаКлиенте
Процедура ОбработчикОповещения_ВводПинКода(РезультатОткрытияФормы,ДополнительныеПараметры) Экспорт
	Если РезультатОткрытияФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьСоединениеСТерминаломЭвотораНаСервере(РезультатОткрытияФормы);
КонецПроцедуры //ОбработчикОповещения_ВводПинКода

#КонецОбласти


#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗначенияЗаполнения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры.ЗначенияЗаполнения);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкаДоставки) Тогда 
		НастройкаДоставки = Справочники.питНастройкиДоставкиСообщений.ЛокальнаяСеть;
	КонецЕсли;
	
	УстановитьДоступность(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

// Обработчик события формы изменения значения реквизита
// 
&НаКлиенте
Процедура НастройкаДоставкиПриИзменении(Элемент)
	
	ТекстОшибки = "";
	УстановитьДоступность(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТокенТерминалаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыполнитьСоединениеСТерминаломЭвотора(Неопределено);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#Область ОбменСЭвотор

&НаКлиенте
Процедура ВыполнитьСоединениеСТерминаломЭвотора(Команда)
	
	Если ПроверитьВозможностьСоединенияСЭвотор() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТокенТерминала) Тогда
		ОбработчикОповещения = Новый ОписаниеОповещения("ОбработчикОповещения_ПодтверждениеСбросаТокена", ЭтотОбъект);
		ТекстВопроса = НСтр("ru='Данный узел уже связан с терминалом. Продолжить?'", "ru");
		ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса,РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		ЗапроситьПинКод();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Обработчик события элемента формы
&НаКлиенте
Процедура Выбрать(Команда)
	
	ВыходныеПараметры = Новый Структура;
	ВыходныеПараметры.Вставить("НастройкаДоставки",НастройкаДоставки);
	ВыходныеПараметры.Вставить("ТокенТерминала",ТокенТерминала);
	ВыходныеПараметры.Вставить("КодТерминала",КодТерминала);
	ВыходныеПараметры.Вставить("Модифицированность",Модифицированность);
	Модифицированность = Ложь;
	Закрыть(ВыходныеПараметры)
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбменСЭвотор

&НаКлиенте
Функция ПроверитьВозможностьСоединенияСЭвотор()
	Отказ = Ложь;
	
	ТекстОшибки = "";
	
	Если НЕ ЗначениеЗаполнено(НастройкаДоставки) Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Настройка доставки не указана'", "ru");
	КонецЕсли;
	
	ПроверитьВозможностьСоединенияСЭвоторНаСервере(Отказ, ТекстОшибки);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Возврат Отказ;
КонецФункции

&НаСервере
Процедура ПроверитьВозможностьСоединенияСЭвоторНаСервере(Отказ, ТекстОшибки)

	ПараметрыДоставки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаДоставки, "СпособОбмена, АдресСервераHTTP");
	
	Если НЕ ПараметрыДоставки.СпособОбмена = 4 Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Для обмена необходимо использовать способ доставки HTTP соединение'", "ru");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыДоставки.АдресСервераHTTP) Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Адрес сервера не задан'", "ru");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПинКод()
	ОбработчикОповещения = Новый ОписаниеОповещения("ОбработчикОповещения_ВводПинКода", ЭтотОбъект);
	ПоказатьВводСтроки(ОбработчикОповещения,,НСтр("ru='Ввод пин-кода'", "ru"),4, Ложь);
КонецПроцедуры


&НаСервере
Процедура ВыполнитьСоединениеСТерминаломЭвотораНаСервере(ПинКод)
	
	ВходныеПараметры= Новый Структура;
	ВходныеПараметры.Вставить("ПинКод", ПинКод);
	ВходныеПараметры.Вставить("Префикс", ПрефиксУзла);
	ВходныеПараметры.Вставить("НастройкаДоставкиПоУмолчанию", НастройкаДоставки);
	ВходныеПараметры.Вставить("НаименованиеОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация,"Наименование"));
	ВходныеПараметры.Вставить("НаименованиеУзла", НаименованиеУзла);
	
	ВыходныеПараметры = Обработки.питДоставкаСообщений.НачатьВыполнениеКоманды("СинхронизацияСТерминалом", ВходныеПараметры);
	
	Если ВыходныеПараметры.Результат Тогда
		Если ВыходныеПараметры.РезультатСинхронизации.Свойство("ТокенТерминала") Тогда
			ТокенТерминала = ВыходныеПараметры.РезультатСинхронизации.ТокенТерминала;
		КонецЕсли;
		
		Если ВыходныеПараметры.РезультатСинхронизации.Свойство("КодТерминала") Тогда
			КодТерминала = ВыходныеПараметры.РезультатСинхронизации.КодТерминала;
		КонецЕсли;
		
		Модифицированность = Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ВыходныеПараметры.ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступность(Форма)
	
	Элементы = Форма.Элементы;
	СпособОбмена = питОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.НастройкаДоставки, "СпособОбмена");
	Элементы.ГруппаОбменСЭвотор.Доступность = СпособОбмена = 4;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация
#Область ОписаниеПеременных
#КонецОбласти
#КонецОбласти
