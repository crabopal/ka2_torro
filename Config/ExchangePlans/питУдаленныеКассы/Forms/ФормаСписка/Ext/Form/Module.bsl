
#Область ОбработчикиСобытийФормы

// Обработчик события формы "При создании на сервере".
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭлементОтбора = ЭтаФорма.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.Использование  = Истина;
	ЭлементОтбора.ПравоеЗначение = ПланыОбмена.питУдаленныеКассы.ЭтотУзел();
	ЭлементОтбора.Представление  = "Не отображать текущий узел";
КонецПроцедуры

#КонецОбласти
