
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Ссылка") Тогда
		УстановитьИндикациюДат(Параметры.Ссылка, ДатаВыгрузки, ДатаЗагрузки);
	КонецЕсли;
	
	Если Параметры.Свойство("НомерПринятого") Тогда
		НомерПринятого = Параметры.НомерПринятого;
	КонецЕсли;
	
	Если Параметры.Свойство("НомерОтправленного") Тогда
		НомерОтправленного = Параметры.НомерОтправленного;
	КонецЕсли;
	
	Если Параметры.Свойство("ВерсияФронтОфиса") Тогда 
		ВерсияФронтОфиса = Параметры.ВерсияФронтОфиса;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьИндикациюДат(Ссылка,ДатаВыгрузки, ДатаЗагрузки)
	
	ДатаВыгрузки = "Не определена";
	ДатаЗагрузки = "Не определена";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияОбменовДанными.ДействиеПриОбмене,
	|	СостоянияОбменовДанными.РезультатВыполненияОбмена,
	|	СостоянияОбменовДанными.ДатаОкончания
	|ИЗ
	|	РегистрСведений.СостоянияОбменовДанными КАК СостоянияОбменовДанными
	|ГДЕ
	|	СостоянияОбменовДанными.УзелИнформационнойБазы = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ДействиеПриОбмене = Перечисления.ДействияПриОбмене.ВыгрузкаДанных Тогда
			ДатаВыгрузки = Формат(Выборка.ДатаОкончания, "");
			Если Выборка.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено Тогда
				Элементы.ДатаВыгрузки.ЦветТекста = ЦветаСтиля.ГиперссылкаЦвет;
			Иначе
				Элементы.ДатаВыгрузки.ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
			КонецЕсли;
		Иначе
			ДатаЗагрузки = Формат(Выборка.ДатаОкончания, "");
			Если Выборка.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено Тогда
				Элементы.ДатаЗагрузки.ЦветТекста = ЦветаСтиля.ГиперссылкаЦвет;
			Иначе
				Элементы.ДатаЗагрузки.ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
