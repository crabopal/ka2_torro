#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий


// Стандартный обработчик ПередЗаписью элемента плана обмена.
//
// Параметры:
//  Отказ	 - Булево - Отказ. 
//
Процедура ПередЗаписью(Отказ)
	
	Если ЭтоНовый() Тогда
		ДополнительныеСвойства.Вставить("ЭтоНовый", Истина);
	Иначе
		// При выгрузке и загрузке идет перезапись КУ, необходимо пропускать такие моменты.
		// Если количество Залов указали пустое, то регистрируем все. 
		// Если раньше количество было 0, то регистрируем все, чтобы во фронт ушли пометки на удаления неизвестных.
		Если НЕ ДополнительныеСвойства = Неопределено 
			И (ДополнительныеСвойства.Свойство("Загрузка") И НЕ ДополнительныеСвойства. Загрузка
			ИЛИ НЕ ДополнительныеСвойства.Свойство("Загрузка")) Тогда
			
			Если (Залы.Количество() = 0) ИЛИ (Ссылка.Залы.Количество() = 0) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Ссылка,Метаданные.Справочники.питЗалы);
			Иначе
				// Зарегистрируем новые и старые значения ТЧ Залы
				Для Каждого ЭлементТЧЗалы ИЗ Залы Цикл
					ПланыОбмена.ЗарегистрироватьИзменения(Ссылка, ЭлементТЧЗалы.Зал);
				КонецЦикла;
				
				СтарыйМассивЗалов = Ссылка.Залы;
				Для Каждого ЭлементТЧЗалы ИЗ СтарыйМассивЗалов Цикл
					ПланыОбмена.ЗарегистрироватьИзменения(Ссылка, ЭлементТЧЗалы.Зал);
				КонецЦикла;
			КонецЕсли;
			
			// Новые правила регистрации узла.
			ДополнительнаяРегистрацияИзмененныхЭлементов("Пользователи", 
				"Пользователь", 
				Метаданные.Справочники.Пользователи);
				
			// Новые правила регистрации узла.
			ДополнительнаяРегистрацияИзмененныхЭлементов("Номенклатура", 
				"Номенклатура", 
				Метаданные.Справочники.Номенклатура);
		КонецЕсли;
	КонецЕсли;
	
	Загрузка = Неопределено;
	ДополнительныеСвойства.Свойство("Загрузка",Загрузка);
	Если ЗначениеЗаполнено(Загрузка) Тогда
		Возврат;
	КонецЕсли;
		
	Если Ссылка.Пустая() И Ссылка = ПланыОбмена.питУдаленныеКассы.ЭтотУзел() Тогда
		Наименование = "База бэк-офиса";
	КонецЕсли;
	
	Если НЕ Многофирменность Тогда
		РазделениеЧеков = Перечисления.питВариантыРазделенияЧеков.НеРазделять;
	КонецЕсли;
	
	Если НЕ Организация.Пустая() И ДополнительныеОрганизации.Найти(Организация, "Организация") = Неопределено Тогда
		НоваяСтрока = ДополнительныеОрганизации.Добавить();
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Подразделение = Подразделение;
	КонецЕсли;
	
	Если НЕ ПроверитьКорректность() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ИндивидуальныйСписокПользователей = ОбновленныйПоказательИндивидуальногоСписка(Пользователи,
		"Пользователь",
		Справочники.Пользователи.ПустаяСсылка());
	ИндивидуальныйСписокНоменклатуры = ОбновленныйПоказательИндивидуальногоСписка(Номенклатура,
		"Номенклатура",
		Справочники.Номенклатура.ПустаяСсылка());
КонецПроцедуры

// Стандартный обработчик ПриЗаписи элемента плана обмена.
//
// Параметры:
//  Отказ	 - Булево - Отказ. 
//
Процедура ПриЗаписи(Отказ)
	
	Если ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда
		// Выполняем регистрацию в плане обмена всех объектов указанных в реквизитах и ТЧ
		Для Каждого СтрИзТЧ ИЗ МестаПечати Цикл
			питОбменДанными.ДопРегистрацияСправочника(Ссылка, СтрИзТЧ.МестоПечати, Ложь);
		КонецЦикла;

		Для Каждого СтрИзТЧ ИЗ Залы Цикл
			питОбменДанными.ДопРегистрацияСправочника(Ссылка, СтрИзТЧ.Зал, Ложь);
		КонецЦикла;
		
		Для Каждого СтрИзТЧ ИЗ ВидыМеню Цикл
			питОбменДанными.ДопРегистрацияСправочника(Ссылка, СтрИзТЧ.ВидМеню, Истина);
		КонецЦикла;
		
		Для Каждого СтрИзТЧ ИЗ ДополнительныеОрганизации Цикл
			питОбменДанными.ДопРегистрацияСправочника(Ссылка, СтрИзТЧ.Подразделение, Истина);
			питОбменДанными.ДопРегистрацияСправочника(Ссылка, СтрИзТЧ.Организация, Ложь);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СкладРеализации) Тогда
			питОбменДанными.ДопРегистрацияСправочника(Ссылка, СкладРеализации, Истина);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СкладПриготовления) Тогда
			питОбменДанными.ДопРегистрацияСправочника(Ссылка, СкладПриготовления, Истина);
		КонецЕсли;
		
		питОбменДанными.ДопРегистрацияСправочника(Ссылка, Подразделение, Истина);
		
		питОбменДанными.ДопРегистрацияСправочника(Ссылка, Организация, Ложь);
		
		питОбменДанными.ДопРегистрацияСправочника(Ссылка, ВидЦен, Ложь);
		
		питОбменДанными.ДопРегистрацияСправочника(Ссылка, НастройкаДоставкиПоУмолчанию, Ложь);
		
		Для Каждого ТекСтрока Из Пользователи Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Пользователь) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Ссылка, ТекСтрока.Пользователь);
			Иначе
				ПланыОбмена.ЗарегистрироватьИзменения(Ссылка, Метаданные.Справочники.Пользователи);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекСтрока Из Номенклатура Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				питОбменДанными.ДопРегистрацияСправочника(Ссылка, ТекСтрока.Номенклатура, Истина);
			Иначе
				ПланыОбмена.ЗарегистрироватьИзменения(Ссылка, Метаданные.Справочники.Номенклатура);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	ИспользуютсяСоглашенияСКлиентами = 
		Не (Константы.ИспользованиеСоглашенийСКлиентами.Получить() = Перечисления.ИспользованиеСоглашенийСКлиентами.НеИспользовать);
		
	Если Не ИспользуютсяСоглашенияСКлиентами Тогда 
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Контрагенты.Соглашение"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Модуль плана обмена Удаленные кассы.

// Возвращает структуру обязательных / уникальных реквизитов элемента.
// 
// Возвращаемое значение:
//  Структура - Содержит строковые идентификаторы реквизитов.
//  Для реквизита значение структуры содержит число: 1 - Обязательный, 2 - Уникальный.
//
Функция ПолучитьОбязательныеРеквизиты()
	
	ОбязательныеРеквизиты = Новый Структура();
	ОбязательныеРеквизиты.Вставить("Код", 1);
	ОбязательныеРеквизиты.Вставить("Наименование", 2);
	// ОбязательныеРеквизиты.Вставить("Префикс", 2);
	
	Если Ссылка <> ПланыОбмена.питУдаленныеКассы.ЭтотУзел() Тогда
		ОбязательныеРеквизиты.Вставить("Организация", 					1);
		ОбязательныеРеквизиты.Вставить("Подразделение", 				1);
		ОбязательныеРеквизиты.Вставить("НастройкаДоставкиПоУмолчанию", 	1);
		// ОбязательныеРеквизиты.Вставить("ТипЦен", 						1);
	КонецЕсли;
	
	Возврат ОбязательныеРеквизиты;
	
КонецФункции

// Проверяет корректность заполнения объекта.
//
// Возвращаемое значение:
//	Булево - Флаг успешной проверки.
//
Функция ПроверитьКорректность()
	
	Результат = Истина;
	
	Загрузка = Неопределено;
	ДополнительныеСвойства.Свойство("Загрузка", Загрузка);
	Если ЗначениеЗаполнено(Загрузка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Реквизиты = ПолучитьОбязательныеРеквизиты();
	Для Каждого Реквизит Из Реквизиты Цикл
		
		Если Реквизит.Значение >= 1 И НЕ ЗначениеЗаполнено(ЭтотОбъект[Реквизит.Ключ]) Тогда
			Результат = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Реквизит """ + Реквизит.Ключ + """ не заполнен" , ЭтотОбъект, Реквизит.Ключ);
			Продолжить; 
		КонецЕсли;
			
		Если Реквизит.Значение = 2 Тогда
			Менеджер = ПланыОбмена[ЭтотОбъект.Метаданные().Имя];
			Если Реквизит.Ключ = "Наименование" Тогда
				НайденнаяСсылка = Менеджер.НайтиПоНаименованию(ЭтотОбъект.Наименование, Истина);
			Иначе
				НайденнаяСсылка = Менеджер.НайтиПоРеквизиту(Реквизит.Ключ, ЭтотОбъект[Реквизит.Ключ]);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденнаяСсылка) И НайденнаяСсылка <> ЭтотОбъект.Ссылка Тогда
				Результат = Ложь;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Реквизит """ + Реквизит.Ключ + """ не уникален", ЭтотОбъект, Реквизит.Ключ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Многофирменность Тогда	
		Для Каждого ТекСтрока Из ДополнительныеОрганизации Цикл
			ОрганизацияПустая = ТекСтрока.Организация.Пустая();
			ПодразделениеПустое = ТекСтрока.Подразделение.Пустая();
			Если ОрганизацияПустая Тогда
				Результат = Ложь;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Организации: организация строки №" + Строка(ТекСтрока.НомерСтроки) + " не заполнено", ЭтотОбъект, "ДополнительныеОрганизации");
			КонецЕсли;
			Если ПодразделениеПустое Тогда
				Результат = Ложь;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Организации: подразделение строки №" + Строка(ТекСтрока.НомерСтроки) + " не заполнено", ЭтотОбъект, "ДополнительныеОрганизации");
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
	// Организации выгружаемых касс ККМ должны быть в ТЧ "Дополнительные организации".
	Если НЕ Ссылка.Пустая() Тогда
		
		МассивКассККМ = питОбменДанными.ПолучитьКассыККМПоУзлуОбмена(Ссылка);
		Для Каждого ТекКассаККМ Из МассивКассККМ Цикл
			
			ТекОрганизация = ТекКассаККМ.Владелец;
			Если Многофирменность Тогда
				Если ДополнительныеОрганизации.Найти(ТекОрганизация, "Организация") = Неопределено Тогда
					Результат = Ложь;
					ТекОшибка = "Кассы ККМ: организация <" + Строка(ТекОрганизация) + "> кассы ККМ <" + Строка(ТекКассаККМ) + ">" 
						+ " не указана в таблице ""Организации""";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекОшибка, ЭтотОбъект, "ДополнительныеОрганизации");
				КонецЕсли; 
			Иначе
				Если ТекОрганизация <> Организация Тогда
					Результат = Ложь;
					ТекОшибка = "Кассы ККМ: организация <" + Строка(ТекОрганизация) + "> кассы ККМ <" + Строка(ТекКассаККМ) + ">" 
						+ " не указана в качестве основной организации";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекОшибка, ЭтотОбъект, "ДополнительныеОрганизации");
				КонецЕсли; 
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;
	
	// Организации выгружаемых привязок номенклатуры к организациям должны быть в ТЧ "Дополнительные организации".
	Если Многофирменность Тогда
		Для Каждого ТекСтрока Из Номенклатура Цикл
			Если ТекСтрока.Организация.Пустая() Тогда
				Результат = Ложь;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номенклатура: строка №" + Строка(ТекСтрока.НомерСтроки) + ": Не заполнен реквизит ""Организация""", ЭтотОбъект, "Номенклатура");
				Продолжить;
			КонецЕсли;
			ТекОрганизация = ТекСтрока.Организация;
			Если ДополнительныеОрганизации.Найти(ТекОрганизация, "Организация") = Неопределено Тогда
				Результат = Ложь;
				ТекОшибка = "Виды меню/Номенклатура: организация <" + Строка(ТекОрганизация) + "> номенклатуры <" 
					+ Строка(ТекСтрока.Номенклатура) + ">, Строка №" + Строка(ТекСтрока.НомерСтроки)
					+ " не указана в таблице ""Организации""";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекОшибка, ЭтотОбъект, "ДополнительныеОрганизации");
			КонецЕсли; 
			
		КонецЦикла; 
	КонецЕсли; 
	
	Для Каждого ТекСтрока Из ВидыМеню Цикл
		Если ТекСтрока.ТипЦен.Пустая() Тогда
			Результат = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Виды меню: строка №" + Строка(ТекСтрока.НомерСтроки) + ": Не заполнен реквизит ""Тип цен""", ЭтотОбъект, "ВидыМеню");
		КонецЕсли;
	КонецЦикла;		
	
	Для Каждого ТекСтрока Из МестаПечати Цикл
		Если ТекСтрока.МестоПечати.СкладПриготовления.Пустая() Тогда
			Результат = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Места печати: строка №" + Строка(ТекСтрока.НомерСтроки) + ": Не заполнен склад приготовления для места печати <" + СокрЛП(ТекСтрока.МестоПечати) + ">", ЭтотОбъект, "Места печати");
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнительнаяРегистрацияИзмененныхЭлементов(ИмяТабличнойЧасти, ИмяРеквизита, ДанныеПолнойРегистрации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питУдаленныеКассыТабличнаяЧасть.%ИмяРеквизита% КАК %ИмяРеквизита%
	|ИЗ
	|	ПланОбмена.питУдаленныеКассы.%ИмяТабличнойЧасти% КАК питУдаленныеКассыТабличнаяЧасть
	|ГДЕ
	|	питУдаленныеКассыТабличнаяЧасть.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%ИмяРеквизита%",ИмяРеквизита);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%ИмяТабличнойЧасти%", ИмяТабличнойЧасти);
	
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	МассивСтарыхЭлементов = Новый Массив;
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивСтарыхЭлементов.Добавить(Выборка[ИмяРеквизита]);
		КонецЦикла;
	КонецЕсли;
	
	МассивНовыхЭлементов = Новый Массив;
	Для Каждого ТекСтрока Из ЭтотОбъект[ИмяТабличнойЧасти] Цикл
		МассивНовыхЭлементов.Добавить(ТекСтрока[ИмяРеквизита]);
	КонецЦикла;
	
	Если НЕ ОбщегоНазначения.КоллекцииИдентичны(МассивНовыхЭлементов, МассивСтарыхЭлементов) Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивНовыхЭлементов, МассивСтарыхЭлементов, Истина);
		Для Каждого ТекЭлемент Из МассивНовыхЭлементов Цикл
			Если ЗначениеЗаполнено(ТекЭлемент) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Ссылка, ТекЭлемент);
			Иначе
				ПланыОбмена.ЗарегистрироватьИзменения(Ссылка, ДанныеПолнойРегистрации);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ОбновленныйПоказательИндивидуальногоСписка(ТабличнаяЧасть, ИмяРеквизита, ЗначениеВыгружатьВсе)
	
	// Выполним проверку пользователей.
	Если ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
		КоличествоЭлементов = ТабличнаяЧасть.Количество();
		Если КоличествоЭлементов > 1 Тогда
			Результат = Истина;
			
			// Проверим наличие выгружать все элементы и фиксированного элемента.
			МассивВыгружатьВсе = ТабличнаяЧасть.НайтиСтроки(Новый Структура(ИмяРеквизита, ЗначениеВыгружатьВсе));
			Если ЗначениеЗаполнено(МассивВыгружатьВсе) Тогда
				// Т.к. есть несколько элементов и один из них выгружать все, то удалим выгружать все.
				Для Каждого ТекСтрока Из МассивВыгружатьВсе Цикл
					ТабличнаяЧасть.Удалить(ТекСтрока);
				КонецЦикла;
			КонецЕсли;
			
		Иначе
			// Если элемент пустой, то выгружаем все.
			Результат = ЗначениеЗаполнено(ТабличнаяЧасть[0][ИмяРеквизита]);
		КонецЕсли;
	Иначе
		// Список пустой - включаем фильтрацию.
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

