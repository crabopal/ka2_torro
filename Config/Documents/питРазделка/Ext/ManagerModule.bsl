#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


#Область ПрограммныйИнтерфейс

// СтандартныеПодсистемы.УправлениеДоступом

// УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
//
// Параметры:
//  Ограничение - Произвольный - Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Подразделение)
	|	И ЗначениеРазрешено(Склад)";
	
КонецПроцедуры

#Область Отчеты

// Заполняет список команд отчетов.
//
// Параметры:
//  КомандыОтчетов - ТаблицаЗначений - состав полей в функции МенюОтчеты.СоздатьКоллекциюКомандОтчето.
//  НастройкиФормы - Произвольный - Настройки формы.
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, НастройкиФормы) Экспорт
	
	питОтчеты.ДобавитьКомандуПоказатьУчетныеДокументы(КомандыОтчетов);
	
КонецПроцедуры

#КонецОбласти

#Область Серии

// Имена реквизитов, от значений которых зависят параметры указания серий.
//
// Возвращаемое значение:
// 		Строка - имена реквизитов, перечисленные через запятую.
Функция ИменаРеквизитовДляЗаполненияПараметровУказанияСерий() Экспорт
	
	Возврат "Подразделение, Дата";
	
КонецФункции

// Возвращает параметры указания серий для товаров, указанных в документе.
//
// Параметры:
//  Объект - Структура - структура значений реквизитов объекта, необходимых для заполнения параметров указания серий.
//
// Возвращаемое значение:
// 			Структура - Структура параметров указания серий для объекта.
Функция ПараметрыУказанияСерий(Объект) Экспорт
	
	ПараметрыУказанияСерий = Новый Структура;
	
	#Область Шапка
	
	Шапка = НоменклатураКлиентСервер.ПараметрыУказанияСерий();
	Шапка.ПолноеИмяОбъекта = "Документ.питРазделка";
	Шапка.ИмяПоляСклад		= "Склад";
	Шапка.ИмяТЧТовары		= "Товары";
	Шапка.ИмяТЧСерии			= "Серии";
	Шапка.ТоварВШапке		= Истина;
	Шапка.УчитыватьСебестоимостьПоСериям	= ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьПоСериямСклад", Новый Структура());
	Шапка.ИспользоватьСерииНоменклатуры	= ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатурыСклад", Новый Структура());
	Шапка.ИменаПолейСтатусУказанияСерий.Добавить("СтатусУказанияСерий");
	Шапка.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПередачаВПроизводствоОтгрузка);
	Шапка.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПередачаВПроизводствоПриемка);
	Шапка.ЭтоНакладная = Истина;
	Шапка.СерииПриПланированииОтгрузкиУказываютсяВТЧСерии = Истина;
	Шапка.ПланированиеОтгрузки = Ложь;
	Шапка.ПланированиеОтбора   = Ложь;
	Шапка.ФактОтбора           = Истина;
	Шапка.РегистрироватьСерии = Ложь;
	Шапка.Дата = Объект.Дата;
	Шапка.ПоляСвязи.Добавить("Назначение");
	
	ПараметрыУказанияСерий.Вставить("Шапка", Шапка);
	ПараметрыУказанияСерий.Вставить("ПоляСвязи", Новый Массив);
	ПараметрыУказанияСерий.ПоляСвязи.Добавить("Назначение");
	
	#КонецОбласти
	
	#Область Товары
	
	ПараметрыУказанияСерийТЧ = НоменклатураКлиентСервер.ПараметрыУказанияСерий();
	
	ПараметрыУказанияСерийТЧ.ПолноеИмяОбъекта	= "Документ.питРазделка";
	ПараметрыУказанияСерийТЧ.ИмяПоляСклад		= "Склад";
	ПараметрыУказанияСерийТЧ.ИмяТЧТовары		= "Товары";
	ПараметрыУказанияСерийТЧ.ИмяТЧСерии			= "ТоварыСерии";
	
	ПараметрыУказанияСерийТЧ.УчитыватьСебестоимостьПоСериям	= ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьПоСериямСклад", Новый Структура());
	ПараметрыУказанияСерийТЧ.ИспользоватьСерииНоменклатуры	= ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатурыСклад", Новый Структура());
	
	ПараметрыУказанияСерийТЧ.ИменаПолейСтатусУказанияСерий.Добавить("СтатусУказанияСерий");
	
	ПараметрыУказанияСерийТЧ.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПриемкаПродукцииИзПроизводства);
	
	ПараметрыУказанияСерийТЧ.ЭтоНакладная = Истина;
	
	ПараметрыУказанияСерийТЧ.СерииПриПланированииОтгрузкиУказываютсяВТЧСерии = Истина;
	ПараметрыУказанияСерийТЧ.ПланированиеОтгрузки = Ложь;
	ПараметрыУказанияСерийТЧ.ПланированиеОтбора   = Ложь;
	ПараметрыУказанияСерийТЧ.ФактОтбора           = Истина;
	
	ПараметрыУказанияСерийТЧ.РегистрироватьСерии = Истина;
	
	ПараметрыУказанияСерийТЧ.Дата = Объект.Дата;
	
	ПараметрыУказанияСерий.Вставить("ТЧ", ПараметрыУказанияСерийТЧ);
	
	#КонецОбласти
	
	#Область ПобочныеИзделия
	
	ПараметрыУказанияСерийТЧ = НоменклатураКлиентСервер.ПараметрыУказанияСерий();
	
	ПараметрыУказанияСерийТЧ.ПолноеИмяОбъекта	= "Документ.питВыпускБлюд";
	ПараметрыУказанияСерийТЧ.ИмяПоляСклад		= "Получатель";
	ПараметрыУказанияСерийТЧ.ИмяТЧТовары		= "ПобочныеИзделия";
	// ПараметрыУказанияСерийТЧ.ИмяТЧСерии			= "ПобочныеИзделияСерии";
	ПараметрыУказанияСерийТЧ.ИмяТЧСерии			= "ПобочныеИзделия";
	
	ПараметрыУказанияСерийТЧ.УчитыватьСебестоимостьПоСериям	= ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьПоСериямСклад", Новый Структура());
	ПараметрыУказанияСерийТЧ.ИспользоватьСерииНоменклатуры	= ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатурыСклад", Новый Структура());
	
	ПараметрыУказанияСерийТЧ.ИменаПолейСтатусУказанияСерий.Добавить("СтатусУказанияСерий");
	
	ПараметрыУказанияСерийТЧ.ПоляСвязи.Добавить("Назначение");
	ПараметрыУказанияСерийТЧ.ПоляСвязи.Добавить("Получатель");
	
	ПараметрыУказанияСерийТЧ.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПриемкаПродукцииИзПроизводства);
	
	ПараметрыУказанияСерийТЧ.ЭтоНакладная = Истина;
	
	ПараметрыУказанияСерийТЧ.СерииПриПланированииОтгрузкиУказываютсяВТЧСерии = Истина;
	ПараметрыУказанияСерийТЧ.ПланированиеОтгрузки = Ложь;
	ПараметрыУказанияСерийТЧ.ПланированиеОтбора   = Ложь;
	ПараметрыУказанияСерийТЧ.ФактОтбора           = Истина;
	
	ПараметрыУказанияСерийТЧ.РегистрироватьСерии = Истина;
	
	ПараметрыУказанияСерийТЧ.Дата = Объект.Дата;
	
	ПараметрыУказанияСерий.Вставить("ПобочныеИзделия", ПараметрыУказанияСерийТЧ);
	
	#КонецОбласти
	
	Возврат ПараметрыУказанияСерий;
	
КонецФункции

// Возвращает текст запроса для расчета статусов указания серий.
//
// Параметры:
//  ПараметрыУказанияСерий - Структура - состав полей задается в функци.
//
// Возвращаемое значение:
// 		Строка - текст запроса.
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерий(ПараметрыУказанияСерий) Экспорт
	
	ТекстЗапроса = "";
	
	Если ПараметрыУказанияСерий.ТоварВШапке Тогда
		ТекстЗапроса = ТекстЗапросаЗаполненияСтатусовУказанияСерийШапкиРазборки();
	Иначе
		ТекстЗапроса = ТекстЗапросаЗаполненияСтатусовУказанияСерийВыходныеИзделия();
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Печать

// Заполняет список команд печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - состав полей в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "питОП23";
	КомандаПечати.Представление = НСтр("ru = 'ОП-23 (Акт разделки)'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

// Процедура - Печать.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ПараметрыПечати - Произвольный - Параметры печати.
//  КоллекцияПечатныхФорм - Произвольный - Коллекция печатных форм.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  ПараметрыВывода - Произвольный - Параметры вывода.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Проверяем, нужно ли для макета Накладная формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "питОП23") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "питОП23", "ОП-23 (Акт разделки)",
			ПечатьОП23(МассивОбъектов, ОбъектыПечати),,"Документ.питРазделка.ПФ_MXL_ОП23");
	КонецЕсли;
	
КонецПроцедуры

// Функция - Получить дополнительные реквизиты для реестра.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьДополнительныеРеквизитыДляРеестра() Экспорт
	
	Результат = Новый Структура("Информация", "Склад");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеПоСтатистике

// Формирует описание реквизитов объекта, заполняемых по статистике их использования.
//
// Параметры:
//  ОписаниеРеквизитов - Структура - описание реквизитов, для которых необходимо получить значения по статистик.
//
Процедура ЗадатьОписаниеЗаполняемыхРеквизитовПоСтатистике(ОписаниеРеквизитов) Экспорт
	
	ЗаполнениеОбъектовПоСтатистике.ДобавитьОписаниеЗаполняемыхРеквизитов(ОписаниеРеквизитов, "Организация, Подразделение");
	
	Параметры = ЗаполнениеОбъектовПоСтатистике.ПараметрыЗаполняемыхРеквизитов();
	Параметры.РазрезыСбораСтатистики.ИспользоватьВсегда = "Ответственный";
	
КонецПроцедуры

#КонецОбласти

// Процедура проверяет правильность заполнения документа "Разделка", в случае ошибочной ситуации
//  устанавливает параметр "Отказ" в значение "Истина" и выводит сообщение пользователю.
//
// Параметры:
//  Объект - ДокументОбъект.питРазделка - Объект, подлежащий проверке. Может являться объектом данных формы.
//  Отказ - Булево - Флаг отказа.
//  УстанавливатьПолеДанных - Булево - Определяет, неободимо ли привязывать ошибочное сообщения к полю данных.
//
Процедура ПроверитьЗаполнениеДокументаРазделка(Объект, Отказ, УстанавливатьПолеДанных = Истина) Экспорт
	
	ЕстьРаспределениеПоДолямСебестоимости = (Объект.Товары.Итог("ПроцентСебестоимости") > 0);
	ЕстьРаспределениеПоДолямВыхода = (Объект.Товары.Итог("ПроцентВыхода") > 0);
	
	ТекстСообщения = "";
	ИмяКолонки = "";
	Для каждого ТекТовар Из Объект.Товары Цикл
		
		Если ЕстьРаспределениеПоДолямСебестоимости И ТекТовар.ПроцентСебестоимости =0 Тогда
			Отказ = Истина;
			ТекстСообщения = "Доли себестоимости должны быть заданы либо не заданы для всех товаров!";
			ИмяКолонки = "ПроцентСебестоимости";
		ИначеЕсли ЕстьРаспределениеПоДолямВыхода И ТекТовар.ПроцентВыхода = 0 Тогда
			Отказ = Истина;
			ТекстСообщения = "Доли выхода должны быть заданы либо не заданы для всех товаров!";
			ИмяКолонки = "ПроцентВыхода";
		ИначеЕсли НЕ ЕстьРаспределениеПоДолямВыхода И НЕ ЕстьРаспределениеПоДолямСебестоимости Тогда
			Отказ = Истина;
			ТекстСообщения = "Необходимо задать доли выхода либо доли себестоимости товаров!";
			ИмяКолонки = "ПроцентВыхода";
		КонецЕсли;
		
		Если Отказ Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Если УстанавливатьПолеДанных Тогда
				Сообщение.Поле = "Объект.Товары["+Строка(ТекТовар.НомерСтроки-1)+"]."+ИмяКолонки;
				Сообщение.УстановитьДанные(Объект);
			КонецЕсли;
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - Проверить товары на дубли.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПроверитьТоварыНаДубли(ДокументОбъект) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДанныеФормыСтруктура") Тогда
		Документ = ДанныеФормыВЗначение(ДокументОбъект, Тип("ДокументОбъект.питРазделка")); // Преобразования данных формы в объект
		УстановитьСоответствиеОбъектаИРеквизитаФормы(Документ, "Объект"); // Установка соответствия
	Иначе
		Документ = ДокументОбъект;
	КонецЕсли;
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРазделкаТовары.НомерСтроки,
	|	питРазделкаТовары.Номенклатура,
	|	питРазделкаТовары.Характеристика,
	|	питРазделкаТовары.Серия
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	&втТовары КАК питРазделкаТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питРазделкаТовары.Номенклатура,
	|	питРазделкаТовары.Характеристика,
	|	питРазделкаТовары.Серия,
	|	МИНИМУМ(питРазделкаТовары.НомерСтроки) КАК НомерСтроки,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ втРезультат
	|ИЗ
	|	втТовары КАК питРазделкаТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	питРазделкаТовары.Номенклатура,
	|	питРазделкаТовары.Характеристика,
	|	питРазделкаТовары.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втРезультат.Номенклатура,
	|	втРезультат.Характеристика,
	|	втРезультат.Серия,
	|	втРезультат.НомерСтроки,
	|	втРезультат.Количество
	|ИЗ
	|	втРезультат КАК втРезультат
	|ГДЕ
	|	втРезультат.Количество > 1";
	
	Запрос.УстановитьПараметр("втТовары", ДокументОбъект.Товары.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Результат = Ложь;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Дубли в строке <"+ВыборкаДетальныеЗаписи.НомерСтроки+"> по реквизитам Номенклатура, Характеристика, Серия!";
			Сообщение.УстановитьДанные(Документ);
			Сообщение.Поле = "Товары[" + (ВыборкаДетальныеЗаписи.НомерСтроки - 1) + "].Номенклатура";
			Сообщение.Сообщить();
			Возврат Результат;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Серии

// Функция - Текст запроса заполнения статусов указания серий шапки разборки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерийШапкиРазборки()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Товары.Серия,
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Количество,
	|	Товары.СтатусУказанияСерий,
	|	Товары.НомерСтроки
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Серия,
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	СУММА(Товары.Количество) КАК Количество,
	|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура).ВидНоменклатуры КАК ВидНоменклатуры
	|ПОМЕСТИТЬ ТоварыДляЗапроса
	|ИЗ
	|	Товары КАК Товары
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Серия,
	|	Товары.Номенклатура,
	|	Товары.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Серии.Номенклатура,
	|	Серии.Характеристика,
	|	Серии.Количество
	|ПОМЕСТИТЬ Серии
	|ИЗ
	|	&Серии КАК Серии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСерий.Номенклатура,
	|	ТаблицаСерий.Характеристика,
	|	СУММА(ТаблицаСерий.Количество) КАК Количество
	|ПОМЕСТИТЬ СерииДляЗапроса
	|ИЗ
	|	Серии КАК ТаблицаСерий
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСерий.Номенклатура,
	|	ТаблицаСерий.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.СтатусУказанияСерий КАК СтарыйСтатусУказанияСерий,
	|	ВЫБОР
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий ЕСТЬ NULL 
	|			ТОГДА 0
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 14
	|					ИНАЧЕ 13
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтгрузки
	|			ТОГДА ВЫБОР
	|					КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|							И ТоварыДляЗапроса.Количество > 0
	|						ТОГДА 10
	|					ИНАЧЕ 9
	|				КОНЕЦ
	|		КОГДА Склады.ИспользоватьОрдернуюСхемуПриОтгрузке
	|				И &Дата >= Склады.ДатаНачалаОрдернойСхемыПриОтгрузке
	|			ТОГДА 0
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтбора
	|			ТОГДА ВЫБОР
	|					КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчетСерийПоFEFO
	|						ТОГДА ВЫБОР
	|								КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|										И ТоварыДляЗапроса.Количество > 0
	|									ТОГДА 6
	|								ИНАЧЕ 5
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|									И ТоварыДляЗапроса.Количество > 0
	|								ТОГДА 8
	|							ИНАЧЕ 7
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПоФактуОтбора
	|				И &ФактОтбора
	|				И ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриОтгрузкеКомплектовДляРазборки
	|			ТОГДА ВЫБОР
	|					КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьОстаткиСерий
	|						ТОГДА ВЫБОР
	|								КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|										И ТоварыДляЗапроса.Количество > 0
	|									ТОГДА 4
	|								ИНАЧЕ 3
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|									И ТоварыДляЗапроса.Количество > 0
	|								ТОГДА 2
	|							ИНАЧЕ 1
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтатусУказанияСерий
	|ПОМЕСТИТЬ Статусы
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыДляЗапроса КАК ТоварыДляЗапроса
	|			ЛЕВОЕ СОЕДИНЕНИЕ СерииДляЗапроса КАК СерииДляЗапроса
	|			ПО ТоварыДляЗапроса.Номенклатура = СерииДляЗапроса.Номенклатура
	|				И ТоварыДляЗапроса.Характеристика = СерииДляЗапроса.Характеристика
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерий
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|				ПО ПолитикиУчетаСерий.Склад = Склады.Ссылка
	|			ПО (ПолитикиУчетаСерий.Склад = &Склад)
	|				И ТоварыДляЗапроса.ВидНоменклатуры = ПолитикиУчетаСерий.Ссылка
	|		ПО Товары.Номенклатура = ТоварыДляЗапроса.Номенклатура
	|			И Товары.Характеристика = ТоварыДляЗапроса.Характеристика
	|;	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Статусы.НомерСтроки КАК НомерСтроки,
	|	Статусы.СтатусУказанияСерий КАК СтатусУказанияСерий
	|ИЗ
	|	Статусы КАК Статусы
	|ГДЕ
	|	Статусы.СтатусУказанияСерий <> Статусы.СтарыйСтатусУказанияСерий
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция - Текст запроса заполнения статусов указания серий выходные изделия.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерийВыходныеИзделия()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	Товары.Количество КАК Количество,
	|	Товары.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	Товары.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Серия,
	|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура).ВидНоменклатуры КАК ВидНоменклатуры,
	|	СУММА(Товары.Количество) КАК Количество
	|ПОМЕСТИТЬ ТоварыДляЗапроса
	|ИЗ
	|	Товары КАК Товары
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.Характеристика,
	|	Товары.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Серии.Номенклатура,
	|	Серии.Характеристика,
	|	Серии.Количество КАК Количество
	|ПОМЕСТИТЬ Серии
	|ИЗ
	|	&Серии КАК Серии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Серии.Номенклатура,
	|	Серии.Характеристика,
	|	СУММА(Серии.Количество) КАК Количество
	|ПОМЕСТИТЬ СерииДляЗапроса
	|ИЗ
	|	Серии КАК Серии
	|
	|СГРУППИРОВАТЬ ПО
	|	Серии.Номенклатура,
	|	Серии.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.СтатусУказанияСерий КАК СтарыйСтатусУказанияСерий,
	|	ВЫБОР
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий ЕСТЬ NULL 
	|			ТОГДА 0
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 14
	|					ИНАЧЕ 13
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтгрузки
	|			ТОГДА ВЫБОР
	|					КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|							И ТоварыДляЗапроса.Количество > 0
	|						ТОГДА 10
	|					ИНАЧЕ 9
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтбора
	|			ТОГДА ВЫБОР
	|					КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|							И ТоварыДляЗапроса.Количество > 0
	|						ТОГДА 8
	|					ИНАЧЕ 7
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПриемке
	|				И ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПриемкеПродукцииИзПроизводства
	|			ТОГДА ВЫБОР
	|					КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьОстаткиСерий
	|						ТОГДА ВЫБОР
	|								КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|										И ТоварыДляЗапроса.Количество > 0
	|									ТОГДА 4
	|								ИНАЧЕ 3
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ТоварыДляЗапроса.Количество = ЕСТЬNULL(СерииДляЗапроса.Количество, 0)
	|									И ТоварыДляЗапроса.Количество > 0
	|								ТОГДА 2
	|							ИНАЧЕ 1
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтатусУказанияСерий
	|ПОМЕСТИТЬ Статусы
	|ИЗ
	|	Товары КАК Товары
	|	
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТоварыДляЗапроса КАК ТоварыДляЗапроса
	|		ПО Товары.Номенклатура = ТоварыДляЗапроса.Номенклатура
	|		И Товары.Характеристика = ТоварыДляЗапроса.Характеристика
	|		И Товары.Серия = ТоварыДляЗапроса.Серия
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ СерииДляЗапроса КАК СерииДляЗапроса
	|		ПО ТоварыДляЗапроса.Номенклатура = СерииДляЗапроса.Номенклатура
	|		И ТоварыДляЗапроса.Характеристика = СерииДляЗапроса.Характеристика
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерий
	|		ПО (ПолитикиУчетаСерий.Склад = &Склад)
	|		И ТоварыДляЗапроса.ВидНоменклатуры = ПолитикиУчетаСерий.Ссылка
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|		ПО ПолитикиУчетаСерий.Склад = Склады.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Статусы.НомерСтроки КАК НомерСтроки,
	|	Статусы.СтатусУказанияСерий КАК СтатусУказанияСерий
	|ИЗ
	|	Статусы КАК Статусы
	|ГДЕ
	|	Статусы.СтатусУказанияСерий <> Статусы.СтарыйСтатусУказанияСерий
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Печать

// Функция формирует табличный документ с печатной формой накладной,
//  разработанной методистами.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма накладной.
Функция ПечатьОП23(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_Разделка_ОП23";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.питРазделка.ПФ_MXL_ОП23");
	
	Для каждого ТекОбъектРазделки Из МассивОбъектов Цикл
		
		ПроизведенРасчетСебестоимости = питОтчеты.ПроизведенРасчетСебестоимости(ТекОбъектРазделки.Ссылка);
		
		ТипЦенНормативная			= Константы.питНормативнаяЦена.Получить();
		
		ТекстЗапроса = "";
		Если ПроизведенРасчетСебестоимости Тогда
			ТекстЗапроса = ТекстЗапроса + питОтчеты.ПолучитьТекстЗапросаСебестоимостиБлюдИИнгредиентов(Ложь,,"питРазделка", "Товары");
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ
		|	питРазделка.Ссылка КАК Ссылка,
		|	питРазделка.Номер КАК Номер,
		|	питРазделка.Дата КАК Дата,
		|	питРазделка.Дата КАК ДатаНач,
		|	питРазделка.Дата КАК ДатаКон,
		|	питРазделка.Организация КАК Организация,
		|	питРазделка.Склад КАК Склад,
		|	питРазделка.Склад.Представление КАК ПредставлениеСклада,
		|	питРазделка.Номенклатура КАК Продукт,
		|	питРазделка.Номенклатура.НаименованиеПолное + ВЫБОР
		|		КОГДА питРазделка.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|			ТОГДА """"
		|		ИНАЧЕ "" / "" + питРазделка.Характеристика.НаименованиеПолное
		|	КОНЕЦ КАК ПродуктПредставление,
		|	питРазделка.Номенклатура КАК Номенклатура,
		|	питРазделка.Характеристика КАК Характеристика,
		|	ВЫБОР
		|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
		|			ТОГДА питРазделка.Номенклатура.Артикул
		|		ИНАЧЕ питРазделка.Номенклатура.Код
		|	КОНЕЦ КАК ПродуктКод,
		|	питРазделка.Упаковка.Наименование КАК ЕдиницаИзмерения,
		|	питРазделка.Упаковка.Код КАК КодЕдиницы,
		|	питРазделка.Упаковка КАК Упаковка,
		|	питРазделка.КоличествоУпаковок КАК Количество,
		|	питРазделка.СуммаДокумента КАК СуммаДокумента,
		|	Константы.ВалютаРегламентированногоУчета КАК ВалютаДокумента
		|ИЗ
		|	Документ.питРазделка КАК питРазделка,
		|	Константы КАК Константы
		|ГДЕ
		|	питРазделка.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	питРазделка.Дата,
		|	питРазделка.Ссылка
		|ИТОГИ
		|	МИНИМУМ(ДатаНач),
		|	МАКСИМУМ(ДатаКон)
		|ПО
		|	ОБЩИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	питРазделкаТовары.НомерСтроки КАК НомерСтроки,
		|	питРазделкаТовары.Номенклатура КАК Номенклатура,
		|	питРазделкаТовары.Характеристика КАК Характеристика,
		|	питРазделкаТовары.Номенклатура.НаименованиеПолное + ВЫБОР
		|		КОГДА питРазделкаТовары.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|			ТОГДА """"
		|		ИНАЧЕ "" / "" + питРазделкаТовары.Характеристика.НаименованиеПолное
		|	КОНЕЦ КАК НоменклатураПредставление,
		|	ВЫБОР
		|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
		|			ТОГДА питРазделкаТовары.Номенклатура.Артикул
		|		ИНАЧЕ питРазделкаТовары.Номенклатура.Код
		|	КОНЕЦ КАК Код,
		|	питРазделкаТовары.КоличествоУпаковок КАК Количество,
		|	питРазделкаТовары.КоличествоУпаковокНорма КАК КоличествоНорма,
		|	питРазделкаТовары.Упаковка КАК Упаковка,
		|	питРазделкаТовары.ПроцентВыхода КАК ПроцентВыхода,
		|	ЕстьNull("+?(ПроизведенРасчетСебестоимости,"Себестоимость.СуммаБезНДС","0")+",0) КАК Сумма
		|ИЗ
		|	Документ.питРазделка.Товары КАК питРазделкаТовары
		|	"+?(ПроизведенРасчетСебестоимости,"
		|		ЛЕВОЕ СОЕДИНЕНИЕ резТаблицаСебестоимости КАК Себестоимость
		|			ПО питРазделкаТовары.Номенклатура = Себестоимость.НоменклатураБлюда
		|			И питРазделкаТовары.Характеристика = Себестоимость.ХарактеристикаБлюда ","")+"
		|ГДЕ
		|	питРазделкаТовары.Ссылка = &Ссылка";
		
		ДополнительнаяКолонкаПечатныхФормДокументов = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
		Если НЕ ЗначениеЗаполнено(ДополнительнаяКолонкаПечатныхФормДокументов) Тогда
			ДополнительнаяКолонкаПечатныхФормДокументов = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.НеВыводить;
		КонецЕсли;
		ВыводитьКоды = ДополнительнаяКолонкаПечатныхФормДокументов <> Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.НеВыводить;
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("Ссылка", ТекОбъектРазделки);
		Запрос.УстановитьПараметр("ДополнительнаяКолонкаПечатныхФормДокументов", ДополнительнаяКолонкаПечатныхФормДокументов);
		Запрос.Текст = ТекстЗапроса;
		
		РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
		КоличествоПакетов = РезультатЗапросаПакет.Количество();
		ШапкаИтоги = РезультатЗапросаПакет[КоличествоПакетов-2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если ШапкаИтоги.Следующий() Тогда
			
			ДатаНач = ?(ЗначениеЗаполнено(ШапкаИтоги.ДатаНач), ШапкаИтоги.ДатаНач, '00010101');
			ДатаКон = ?(ЗначениеЗаполнено(ШапкаИтоги.ДатаКон), ШапкаИтоги.ДатаКон, '00010101');
			
			ПервыйДокумент = Истина;
			Шапка = ШапкаИтоги.Выбрать();
			Пока Шапка.Следующий() Цикл
				ВыборкаСтрокТовары = РезультатЗапросаПакет[КоличествоПакетов-1].Выбрать();
				
				Если Не ПервыйДокумент Тогда
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				КонецЕсли;
				
				ПервыйДокумент = Ложь;
				// Запомним номер строки, с которой начали выводить текущий документ.
				НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
				
				// Выводим шапку накладной
				ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
				
				Руководители = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Шапка.Организация, Шапка.Дата);
				
				ОбластьМакета.Параметры.Руководитель = Руководители.РуководительНаименование;
				ОбластьМакета.Параметры.Должность = Руководители.РуководительДолжность;
				
				СведенияОбОрганизации    = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
				ПредставлениеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,");
				ОбластьМакета.Параметры.Организация = ПредставлениеОрганизации;
				
				ОбластьМакета.Параметры.Склад = Шапка.Склад;
				
				ОбластьМакета.Параметры.КодПоОКПО = СведенияОбОрганизации.КодПоОКПО;
				ОбластьМакета.Параметры.НомерДок = Шапка.Номер;
				ОбластьМакета.Параметры.ДатаДок = Шапка.Дата;
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				ОбластьМакета = Макет.ПолучитьОбласть("Строка");
				
				ИтогОтклонение = 0;
				ИтогВыработано = 0;
				ИтогоСумма = 0;
				
				ПерваяСтрока = Истина;
				ПустыеЯчейки = Новый Структура("Продукт, ПродуктПредставление, ПродуктКод, ЕдиницаИзмерения, КодЕдиницы, ЦенаПродукта, МассаПродукта, СуммаПродукта");
				
				ТекЦенаПродукта = 0;
				ТекСуммаПродукта = 0;
				ВсегоДоляВыхода = 0;
				Если ПроизведенРасчетСебестоимости Тогда
					Пока ВыборкаСтрокТовары.Следующий() Цикл
						ТекСумма	= ВыборкаСтрокТовары.Сумма;
						ТекСуммаПродукта = ТекСуммаПродукта + ТекСумма;
						ВсегоДоляВыхода = ВсегоДоляВыхода + ВыборкаСтрокТовары.ПроцентВыхода;
					КонецЦикла;
					ВыборкаСтрокТовары.Сбросить();
					ТекЦенаПродукта = ТекСуммаПродукта / Шапка.Количество;
				Иначе
					ТекЦенаПродукта = питПроизводство.ПолучитьСтоимостьИнгредиента(Шапка.Номенклатура, ТипЦенНормативная, Шапка.Дата, Шапка.ВалютаДокумента,,,,,Шапка.Упаковка,Шапка.Характеристика);
					ТекСуммаПродукта = ТекЦенаПродукта * Шапка.Количество;
					Пока ВыборкаСтрокТовары.Следующий() Цикл
						ВсегоДоляВыхода = ВсегоДоляВыхода + ВыборкаСтрокТовары.ПроцентВыхода;
					КонецЦикла;
					ВыборкаСтрокТовары.Сбросить();
				КонецЕсли;
				
				ОсталосьДоляВыхода = ВсегоДоляВыхода;
				ОсталосьПроцентВыхода = 100;
				
				Пока ВыборкаСтрокТовары.Следующий() Цикл
					
					Если ПерваяСтрока Тогда
						// Если строка первая, то заполним продукт
						ОбластьМакета.Параметры.Заполнить(Шапка);
						ОбластьМакета.Параметры.МассаПродукта = Шапка.Количество;
						
						ОбластьМакета.Параметры.ЦенаПродукта = ТекЦенаПродукта;
						ОбластьМакета.Параметры.СуммаПродукта = ТекСуммаПродукта;
						
					Иначе
						ОбластьМакета.Параметры.Заполнить(ПустыеЯчейки);
						
					КонецЕсли;
					
					ПерваяСтрока = Ложь;
					
					ОбластьМакета.Параметры.Заполнить(ВыборкаСтрокТовары);
					
					ОбластьМакета.Параметры.ПроцентВыхода = ?(ВыборкаСтрокТовары.ПроцентВыхода = ОсталосьДоляВыхода, ОсталосьПроцентВыхода, ВыборкаСтрокТовары.ПроцентВыхода / ВсегоДоляВыхода * 100);
					ОсталосьПроцентВыхода = ОсталосьПроцентВыхода - ОбластьМакета.Параметры.ПроцентВыхода;
					ОсталосьДоляВыхода = ОсталосьДоляВыхода - ВыборкаСтрокТовары.ПроцентВыхода;
					
					Если ПроизведенРасчетСебестоимости Тогда
						ТекСумма	= ВыборкаСтрокТовары.Сумма;
						Если ВыборкаСтрокТовары.Количество <> 0 Тогда
							ТекЦена		= ВыборкаСтрокТовары.Сумма / ВыборкаСтрокТовары.Количество;
						Иначе
							ТекЦена = 0;
						КонецЕсли;
					Иначе
						ТекЦена = питПроизводство.ПолучитьСтоимостьИнгредиента(ВыборкаСтрокТовары.Номенклатура, ТипЦенНормативная, Шапка.Дата, Шапка.ВалютаДокумента,,,,,ВыборкаСтрокТовары.Упаковка,ВыборкаСтрокТовары.Характеристика);
						ТекСумма = ТекЦена * ВыборкаСтрокТовары.Количество;
					КонецЕсли;
					ОбластьМакета.Параметры.Цена = ТекЦена;
					ОбластьМакета.Параметры.Сумма = ТекСумма;
					
					Отклонение = (ВыборкаСтрокТовары.Количество - ВыборкаСтрокТовары.КоличествоНорма)*ТекЦена;
					ОбластьМакета.Параметры.Отклонение = Отклонение;
					
					ИтогОтклонение = ИтогОтклонение + Отклонение;
					ИтогВыработано = ИтогВыработано + ВыборкаСтрокТовары.Количество;
					ИтогоСумма = ИтогоСумма + ТекСумма;
					
					ТабличныйДокумент.Вывести(ОбластьМакета);
				КонецЦикла;
				
				// Вывести Итого
				ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
				
				ОбластьМакета.Параметры.ИтогоМассаПродукта = Шапка.Количество;
				ОбластьМакета.Параметры.ИтогоСуммаПродукта = ТекСуммаПродукта;
				ОбластьМакета.Параметры.ИтогоМасса         = ИтогВыработано;
				ОбластьМакета.Параметры.ИтогоВсегоМасса    = ИтогВыработано;
				ОбластьМакета.Параметры.ИтогоСумма         = ИтогоСумма;
				ОбластьМакета.Параметры.ИтогоОтклонение    = ИтогОтклонение;
				ОбластьМакета.Параметры.ИтогоПереработано  = ЧислоПрописью(Шапка.Количество) + " " + Шапка.ЕдиницаИзмерения;
				ОбластьМакета.Параметры.ИтогоВыработано    = ЧислоПрописью(ИтогВыработано);
				ОбластьМакета.Параметры.ИтогоОтклонение    = ИтогОтклонение;
				// Чтение значения для бухгалтера
				ОбластьМакета.Параметры.Бухгалтер = Руководители.ГлавныйБухгалтерНаименование;
				
				ТабличныйДокумент.Вывести(ОбластьМакета);
				
				// В табличном документе зададим имя области, в которую был 
				// выведен объект. Нужно для возможности печати покомплектно.
				УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
				НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли

