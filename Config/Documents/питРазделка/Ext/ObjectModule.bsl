#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Процедура - Обработка заполнения.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ДанныеЗаполнения <> Неопределено И ТипДанныхЗаполнения <> Тип("Структура")
		И Метаданные().ВводитсяНаОсновании.Содержит(ДанныеЗаполнения.Метаданные()) Тогда
		// нет ввода на основании.
	КонецЕсли;
	
	// +25
	// ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьСвойстваОбъекта(ЭтотОбъект, ДанныеЗаполнения);
	ЗаполнениеОбъектовПоСтатистике.ЗаполнитьРеквизитыОбъекта(ЭтотОбъект, ДанныеЗаполнения);
	// -25
	
	Если ЗначениеЗаполнено(Номенклатура) И НЕ ЗначениеЗаполнено(Рецептура) Тогда
		// Определим основную рецептуру для номенклатуры в шапке.
		Если ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураРазделка Тогда
			ВидОперацииРецептуры = Перечисления.питХозяйственныеОперации.РецептураРазделка;
		Иначе
			ВидОперацииРецептуры = Перечисления.питХозяйственныеОперации.РецептураРазукомплектацияБлюд;
		КонецЕсли;
		// СпособРасчетаРецептур	= Константы.питСпособРасчетаРецептур.Получить();
		СпособРасчетаРецептур	= питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
		Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(Номенклатура, Характеристика, ВидОперацииРецептуры, Дата,СпособРасчетаРецептур , , Организация,,,Подразделение);
	КонецЕсли;
	
	// Если НЕ ЗначениеЗаполнено(СтатьяПрочихДоходовРасходов) Тогда
//  	СтатьяПрочихДоходовРасходов =
// 
// ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ПрочиеДоходыИРасходы.РазницыСтоимостиБлюдаИСтоимостиТоваровВРазукомплектации");.
	// КонецЕсли;
	
КонецПроцедуры

// Процедура - При копировании.
//
// Параметры:
//  ОбъектКопирования - Произвольный - Объект копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

// Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	//// В режиме 2.2 сделаем заполнение данной колонки обязательным, т.к. схема с сборкой/разборкой не поддерживается.
	// ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	// Если НЕ ФормироватьДокументыПроизводства22 Тогда
	// 	МассивНепроверяемыхРеквизитов.Добавить("Товары.ПроцентСебестоимости");
	// КонецЕсли;
	
	// Проверка заполнения характеристик в шапке.
	Если НЕ питОбщегоНазначения.ХарактеристикиИспользуются(Номенклатура) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Характеристика");
	КонецЕсли;
	
	ПараметрыПроверкиХарактеристик = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "Товары";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	ПараметрыПроверкиХарактеристик = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "ПобочныеИзделия";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	// +Серии
	#Область ПроверкаСерий
	
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.питРазделка);
	НоменклатураСервер.ПроверитьЗаполнениеСерий(ЭтотОбъект, ПараметрыУказанияСерий.ТЧ, Отказ, МассивНепроверяемыхРеквизитов);
	НоменклатураСервер.ПроверитьЗаполнениеСерий(ЭтотОбъект,
		ПараметрыУказанияСерий.ПобочныеИзделия,
		Отказ,
		МассивНепроверяемыхРеквизитов);
	#КонецОбласти
	// -Серии
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

// Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = НЕ Документы.питРазделка.ПроверитьТоварыНаДубли(ЭтотОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СуммарнаяДоляВыхода = Товары.Итог("ПроцентВыхода");
	
	Если НЕ (ЭтотОбъект.ДополнительныеСвойства.Свойство("ПроверкаЗаполненияВыполнена") 
		И ЭтотОбъект.ДополнительныеСвойства.ПроверкаЗаполненияВыполнена) Тогда
		// Если еще не сделали проверку заполнения из формы(например создаем документ программно).
		// Документы.питРазделка.ПроверитьЗаполнениеДокументаРазделка(ЭтотОбъект, Отказ, Ложь);
	КонецЕсли;
	
	// +Серии
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект,Документы.питРазделка);
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект, ПараметрыУказанияСерий);
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект, ПараметрыУказанияСерий.ПобочныеИзделия);
	// -Серии
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли



