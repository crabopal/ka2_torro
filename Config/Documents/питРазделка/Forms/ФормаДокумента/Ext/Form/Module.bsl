	УпаковкаПриИзмененииНаСервере();
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(Объект, СтруктураДействий, КэшированныеЗначения);
	
	// +Серии
	ЗаполнитьСтатусыУказанияСерийСервер("Шапка");
	ОбновитьКешированныеЗначенияДляУчетаСерий("Шапка",, КэшированныеЗначенияСерий, Ложь);
	// -Серии
	
КонецПроцедуры

