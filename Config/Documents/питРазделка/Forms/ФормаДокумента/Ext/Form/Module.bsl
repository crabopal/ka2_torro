//  Процедура - Рецептура при изменении завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура РецептураПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ  = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	РецептураПриИзмененииНаСервере();
	КоличествоПредыдущее = Объект.Количество;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	Для Каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "Норма");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "");
		
		// +Серии
		ТекущаяСтрокаИдентификатор = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
		ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(ПараметрыУказанияСерий["ТЧ"], ТекущаяСтрокаИдентификатор, КэшированныеЗначенияСерий);
		// -Серии
		
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Количество при изменении завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура КоличествоПриИзменении_Завершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	КэшированныеЗначения =  ДополнительныеПараметры.КэшированныеЗначения;
	
	ОсталосьРаспределить = Объект.КоличествоУпаковок;
	ОсталосьКоличествоУпаковокБрутто = Объект.Товары.Итог("ПроцентВыхода");
	ВсегоДоляВыхода = ОсталосьКоличествоУпаковокБрутто;
	
	Для Каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
		
		ТекКоличествоВыхода = ?(СтрокаТабличнойЧасти.ПроцентВыхода = ОсталосьКоличествоУпаковокБрутто, ОсталосьРаспределить, СтрокаТабличнойЧасти.ПроцентВыхода/ВсегоДоляВыхода * Объект.КоличествоУпаковок);
		СтрокаТабличнойЧасти.КоличествоУпаковок	= ТекКоличествоВыхода;
		
		ОсталосьКоличествоУпаковокБрутто = ОсталосьКоличествоУпаковокБрутто - СтрокаТабличнойЧасти.ПроцентВыхода;
		ОсталосьРаспределить = ОсталосьРаспределить - ТекКоличествоВыхода;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Серии

//  Процедура - Открыть подбор серий завершение.
//
// Параметры:
//  РезультатЗакрытия - Произвольный - Результат закрытия.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОткрытьПодборСерийЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ТоварВШапке = ДополнительныеПараметры.ТоварВШапке;
	
	ЗначениеВозврата = РезультатЗакрытия;
	
	Если ЗначениеВозврата <> Неопределено Тогда
		ОбработатьУказаниеСерийСервер(ДополнительныеПараметры.ИмяТЧ, ДополнительныеПараметры.ПараметрыУказанияСерий, ДополнительныеПараметры.ПараметрыФормыУказанияСерий);
		Если ТоварВШапке Тогда
			Если Объект.Серии.Количество() Тогда
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
				Объект.Количество = Объект.Серии.Итог("Количество");
				ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(Объект, СтруктураДействий, КэшированныеЗначения);
				ЗаполнитьСтатусыУказанияСерийСервер("Шапка");
				ПересчитатьКоличестваВТабличнойЧасти(Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТоварВШапке Тогда
		НоменклатураКлиент.ОбновитьКешированныеЗначенияШапкиДляУчетаСерий(Объект,КэшированныеЗначенияСерий,ПараметрыУказанияСерий.Шапка);
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Параметры пересчета количества единиц.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
Функция ПараметрыПересчетаКоличестваЕдиниц() Экспорт
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	Возврат ПараметрыПересчета;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Объект.Номенклатура, Элементы.Упаковка);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// +Серии
	ПриЧтенииСозданииНаСервере();
	// +Серии
	
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	УстановитьХарактеристикиИспользуютсяВШапке();
	
	УстановитьУсловноеОформление();
	КоличествоПредыдущее = объект.Количество;
	
	// Для нового документа
	Если Параметры.Ключ.Пустая() Тогда
		Если НЕ ЗначениеЗаполнено(Объект.СтатьяКалькуляции) Тогда
			Объект.СтатьяКалькуляции = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СтатьяКалькуляцииПоУмолчанию");
		КонецЕсли;
	КонецЕсли;
	
	// +Серии
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	// -Серии
	
	// Добавил инициализацию данного параметра, 
	// может пригодится при открытии формы подбора номенклатуры, для отображения в ней цен на товары.
	Объект.ТипЦен = Константы.питНормативнаяЦена.Получить();
	
	//// В режиме 2.2 сделаем заполнение данной колонки обязательным, т.к. схема с сборкой/разборкой не поддерживается.
	// ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	// Элементы.ТоварыПроцентСебестоимости.АвтоОтметкаНезаполненного = ФормироватьДокументыПроизводства22;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	питПроизводство.УстановитьВидимостьНадписиРазныеЕдиницы(Объект, Элементы, "Товары");
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// +Серии
	ОбновитьКешированныеЗначенияДляУчетаСерий("Шапка",, КэшированныеЗначенияСерий, Ложь);
	ОбновитьКешированныеЗначенияДляУчетаСерий("Товары", Элементы.Товары, КэшированныеЗначенияСерий, Ложь);
	ОбновитьКешированныеЗначенияДляУчетаСерий("ПобочныеИзделия", Элементы.ПобочныеИзделия, КэшированныеЗначенияСерий, Ложь);
	// -Серии
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборТоваровВДокументПродажи.Форма.Форма" Тогда
		
		ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение);
		
	КонецЕсли;
	
	// +Серии
	Если НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
		
		НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[СерияРедактируетсяВШапке], ВыбранноеЗначение);
		Если СерияРедактируетсяВШапке = "Шапка" Тогда
			НоменклатураКлиент.ОбновитьКешированныеЗначенияШапкиДляУчетаСерий(Объект,КэшированныеЗначенияСерий,ПараметрыУказанияСерий.Шапка);
		КонецЕсли;
		
	КонецЕсли;
	// -Серии
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// Документы.питРазделка.ПроверитьЗаполнениеДокументаРазделка(Объект,Отказ);
	// ТекущийОбъект.ДополнительныеСвойства.Вставить("ПроверкаЗаполненияВыполнена", Истина);
	
КонецПроцедуры

//  Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	// +Серии
	ЗаполнитьПараметрыУказанияСерий();
	УстановитьВидимостьЭлементовСерий();
	// -Серии
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область Шапка

//  Процедура - Подразделение организации при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПодразделениеОрганизацииПриИзменении(Элемент)
	ПодразделениеОрганизацииПриИзмененииНаСервере();
КонецПроцедуры

//  Процедура - Номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	ПараметрыОбъекта = Новый Структура("ВидОперации, Организация, ХозяйственнаяОперация, Дата, Склад, Ссылка,
			|СпособУчетаНДС,
			|Номенклатура, Характеристика, Количество, ЕдиницаИзмерения, Коэффициент, Рецептура, СчетУчета, Подразделение");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
	ПараметрыОбъекта.Вставить("СпособРасчетаРецептурыПоАктуальной", СпособРасчетаРецептурыПоАктуальной);
	
	НоменклатураПриИзмененииНаСервере(ПараметрыОбъекта);
	ЗаполнитьЗначенияСвойств(Объект, ПараметрыОбъекта);
	
	РецептураПриИзменении(Элемент);
	
	
	УправлениеФормой(ЭтаФорма);
	
	// +Серии
	ЗаполнитьСтатусыУказанияСерийСервер("Шапка");
	ОбновитьКешированныеЗначенияДляУчетаСерий("Шапка",, КэшированныеЗначенияСерий, Ложь);
	// -Серии
	
КонецПроцедуры

//  Процедура - Рецептура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РецептураПриИзменении(Элемент)
	
	Если Объект.Товары.Количество() > 0 Тогда
		Ответ = Неопределено;
		ПоказатьВопрос(Новый ОписаниеОповещения("РецептураПриИзмененииЗавершение", ЭтотОбъект, Новый Структура("Элемент", Элемент)), "Табличная часть будет перезаполнена! Продолжить?",РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	РецептураПриИзмененииНаСервере();
	КоличествоПредыдущее = Объект.Количество;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	Для Каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "Норма");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "");
		
		// +Серии
		ТекущаяСтрокаИдентификатор = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
		ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(ПараметрыУказанияСерий["ТЧ"], ТекущаяСтрокаИдентификатор, КэшированныеЗначенияСерий);
		// -Серии
		
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Вид операции при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	// УправлениеФормой(ЭтаФорма);
	
	Если ЗначениеЗаполнено(Объект.ХозяйственнаяОперация) И (Объект.ХозяйственнаяОперация <> ВидОперацииПредыдущий)
		И ((Объект.Товары.Количество() > 0) ИЛИ (ЗначениеЗаполнено(Объект.Рецептура)) ИЛИ (ЗначениеЗаполнено(Объект.Номенклатура))) Тогда
		
		Ответ = Неопределено;
		ПоказатьВопрос(Новый ОписаниеОповещения("ВидОперацииПриИзмененииЗавершение", ЭтотОбъект), НСтр("ru = 'Документ будет очищен! Продолжить?'"),
		РежимДиалогаВопрос.ДаНет,,, НСтр("ru = 'Изменение вида операции'"));
	КонецЕсли;
КонецПроцедуры

