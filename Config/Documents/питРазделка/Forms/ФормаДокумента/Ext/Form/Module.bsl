//  Процедура - Подразделение организации при изменении на сервере.
//
&НаСервере
Процедура ПодразделениеОрганизацииПриИзмененииНаСервере()
	Если НЕ питДокументы.ПроверитьПроизводственноеПодразделение(Объект.Подразделение) Тогда
		Объект.Подразделение = "";
	КонецЕсли;
КонецПроцедуры

//  Процедура - Номенклатура при изменении на сервере.
//
// Параметры:
//  ПараметрыОбъекта - Произвольный - Параметры объекта.
//
&НаСервере
Процедура НоменклатураПриИзмененииНаСервере(ПараметрыОбъекта)
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбъекта.Номенклатура, "питВидНоменклатуры, ЕдиницаИзмерения");
	
	ТекстСообщения = Неопределено;
	// Разукомплектации в ЕРП нет
	ПараметрыОбъекта.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураРазделка;
	ВидРецептуры = Перечисления.питХозяйственныеОперации.РецептураРазделка;
	
	Если ТекстСообщения <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Номенклатура");
	КонецЕсли;
	
	Если ВидРецептуры <> Неопределено Тогда
		ДатаРецептуры = ?(ЗначениеЗаполнено(ПараметрыОбъекта.Ссылка), ПараметрыОбъекта.Дата, КонецДня(ПараметрыОбъекта.Дата));
		ПараметрыОбъекта.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(ПараметрыОбъекта.Номенклатура, ПараметрыОбъекта.Характеристика, ВидРецептуры,
				ДатаРецептуры, , , ПараметрыОбъекта.Организация,,,ПараметрыОбъекта.Подразделение);
	Иначе
		ПараметрыОбъекта.Рецептура = Документы.питРецептура.ПустаяСсылка();
	КонецЕсли;
	
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(ПараметрыОбъекта.Номенклатура, Элементы.Упаковка);
	
	УстановитьХарактеристикиИспользуютсяВШапке();
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.Характеристика, ХарактеристикиИспользуются);
	
	питПроизводство.УстановитьВидимостьНадписиРазныеЕдиницы(Объект, Элементы, "Товары");
	
КонецПроцедуры

//  Процедура - Рецептура при изменении на сервере.
//
&НаСервере
Процедура РецептураПриИзмененииНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.Рецептура) Тогда
		Объект.Товары.Очистить();
		Возврат;
	КонецЕсли;
	
	// Заполням табличную часть документа по рецептуре.
	РеквизитыРецептуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Рецептура, "Упаковка, Количество, КоличествоУпаковок");
	Объект.Упаковка = РеквизитыРецептуры.Упаковка;
	Объект.Количество = РеквизитыРецептуры.Количество;
	Объект.КоличествоУпаковок = РеквизитыРецептуры.КоличествоУпаковок;
	
	Объект.Товары.Очистить();
	
	ОсталосьРаспределить = Объект.КоличествоУпаковок;
	ОсталосьКоличествоУпаковокБрутто = Объект.Рецептура.Ингредиенты.Итог("КоличествоУпаковокБрутто");
	ВсегоДоляВыхода = ОсталосьКоличествоУпаковокБрутто;
	Для Каждого СтрокаРецептуры Из Объект.Рецептура.Ингредиенты Цикл
		
		СтрокаТабличнойЧасти = Объект.Товары.Добавить();
		СтрокаТабличнойЧасти.Номенклатура = СтрокаРецептуры.Номенклатура;
		СтрокаТабличнойЧасти.Характеристика = СтрокаРецептуры.Характеристика;
		СтрокаТабличнойЧасти.Упаковка = СтрокаРецептуры.Упаковка;
		СтрокаТабличнойЧасти.ПроцентВыхода    = СтрокаРецептуры.КоличествоУпаковокБрутто;
		
		// Если СтрокаРецептуры.ПроцентСебестоимости = 0 Тогда
		// 	СтрокаТабличнойЧасти.ПроцентСебестоимости = СтрокаТабличнойЧасти.ПроцентВыхода;
		// Иначе
		СтрокаТабличнойЧасти.ПроцентСебестоимости = СтрокаРецептуры.ПроцентСебестоимости;
		// КонецЕсли;
		
		ТекКоличествоВыхода = ?(СтрокаРецептуры.КоличествоУпаковокБрутто = ОсталосьКоличествоУпаковокБрутто, ОсталосьРаспределить, СтрокаРецептуры.КоличествоУпаковокБрутто/ВсегоДоляВыхода * Объект.КоличествоУпаковок);
		СтрокаТабличнойЧасти.КоличествоУпаковокНорма	= ТекКоличествоВыхода;
		СтрокаТабличнойЧасти.КоличествоУпаковок			= ТекКоличествоВыхода;
		
		ОсталосьКоличествоУпаковокБрутто = ОсталосьКоличествоУпаковокБрутто - СтрокаРецептуры.КоличествоУпаковокБрутто;
		ОсталосьРаспределить = ОсталосьРаспределить - ТекКоличествоВыхода;
		
	КонецЦикла;
	
	Объект.ПобочныеИзделия.Очистить();
	Для Каждого СтрокаРецептуры Из Объект.Рецептура.ПобочныеИзделия Цикл
		СтрокаТабличнойЧасти = Объект.ПобочныеИзделия.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаРецептуры);
	КонецЦикла;
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	питПроизводство.УстановитьВидимостьНадписиРазныеЕдиницы(Объект, Элементы, "Товары");
	
КонецПроцедуры

