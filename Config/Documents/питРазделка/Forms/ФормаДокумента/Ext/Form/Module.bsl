//  Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИсключитьДействия - Произвольный - Исключить действия.
//
&НаКлиенте
Процедура ТаблицаНоменклатураПриИзменении(ИмяТЧ, ИсключитьДействия = Неопределено)
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ДанныеОбУпаковке = ДанныеОбУпаковке(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Упаковка, КэшированныеЗначения);
	
	СтруктураДействий = Новый Структура;
											
	ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	
	// +Серии
	ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)]);
	// -Серии
	
	// Исключим указанные действия
	Если НЕ ИсключитьДействия = Неопределено И ТипЗнч(ИсключитьДействия) = Тип("Массив") Тогда
		Для каждого ТекИсключение Из ИсключитьДействия Цикл
			Если СтруктураДействий.Свойство(ТекИсключение) Тогда
				СтруктураДействий.Удалить(ТекИсключение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

//  Процедура - Таблица выбор серии.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Поле - Произвольный - Поле.
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаВыборСерии(ИмяТЧ, Поле, Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекущиеДанные.СтатусУказанияСерий > 0
		И ТекущиеДанные.СтатусУказанияСерий <= 11 Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьПодборСерий(ИмяТЧ, Поле.ТекстРедактирования);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Таблица при окончании редактирования.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаПриОкончанииРедактирования(ИмяТЧ, Элемент)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если НоменклатураКлиент.НеобходимоОбновитьСтатусыСерий(
			Элемент, КэшированныеЗначенияСерий, ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)]) Тогда
		
		ТекущаяСтрокаИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		
		ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)], ТекущаяСтрокаИдентификатор, КэшированныеЗначенияСерий);
		
		ОбновитьКешированныеЗначенияДляУчетаСерий("Товары", Элемент, КэшированныеЗначенияСерий, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Таблица обработка выбора.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаКлиенте
Процедура ТаблицаОбработкаВыбора(ИмяТЧ, ВыбранноеЗначение)
	
	ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ);
	
КонецПроцедуры

//  Процедура - Таблица обработка выбора подбора на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаСервере
Процедура ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		СписокТоваров = ВыбранноеЗначение;
	Иначе
		СписокТоваров = Новый Массив;
		СписокТоваров.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	МассивСтрок = Новый Массив;
	Для каждого СтрокаТовара Из СписокТоваров Цикл
		
		ТекущаяСтрока = Объект[ИмяТЧ].Добавить();
		ТекущаяСтрока.Номенклатура = СтрокаТовара;
		
		ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(
				ИмяТЧ, 
				ТекущаяСтрока, 
				ЭтаФорма, 
				СтруктураДействий);
				
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
		
		МассивСтрок.Добавить(ТекущаяСтрока.ПолучитьИдентификатор());
		
	КонецЦикла;
	
	ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивСтрок, СтруктураДействий);
	
КонецПроцедуры

//  Процедура - Таблица серия при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаСерияПриИзменении(ИмяТЧ)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение						= Элементы[ИмяТЧ].ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки	= Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)], ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область КопированиеВставкаСтрок

//  Процедура - Скопировать строки на сервере.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура СкопироватьСтрокиНаСервере(ИмяТаблицы)
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(Объект[ИмяТаблицы], Элементы[ИмяТаблицы].ВыделенныеСтроки);
	
КонецПроцедуры

//  Процедура - Получить строки из буфера обмена.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена(ИмяТаблицы)
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена();
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТаблицы, СтруктураДействий);
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект[ИмяТаблицы].Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		// Дозаполним еще реквизиты, такие как "Рецептура", "ЭтоБлюдо", "ЭтоТовар" и т.д.
		СписокСвойствСтрокой = "Номенклатура, Характеристика, ЭтоУслуга, ЭтоБлюдо, ПриготовлениеРазрешено, ЭтоТовар, Иконка, Рецептура, ИзмененФактБлюда, РецептураПред";
		ДанныеСтрокаТаблицы = Новый Структура(СписокСвойствСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, ТекущаяСтрока);
		
		СвойстваПараметрыОбъектаСтрокой = "ХозяйственнаяОперация, Организация, Дата, Ссылка, Подразделение, Склад";
		ПараметрыОбъекта = Новый Структура(СвойстваПараметрыОбъектаСтрокой);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
		
		ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеСтрокаТаблицы);
		
	КонецЦикла;
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

//  Функция - Получить имя текущей табличной части.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучитьИмяТекущейТабличнойЧасти()
	
	ИмяТаблицы = "Товары";
	Возврат ИмяТаблицы;
	
КонецФункции

#КонецОбласти

#Область Характеристики

//  Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
											
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары,	ПараметрыЗаполненияРеквизитов);
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.ПобочныеИзделия,	ПараметрыЗаполненияРеквизитов);
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении количества упаковок.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчета);
	// СтруктураДействий.Вставить("ПересчитатьСумму");
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий)
	
	Объект = Форма.Объект;
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
	Новый Структура("Номенклатура", "ТипНоменклатуры"));
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
	Форма.ИмяФормы, ИмяТЧ));
	
КонецПроцедуры

//  Процедура - Установить характеристики используются в шапке.
//
&НаСервере
Процедура УстановитьХарактеристикиИспользуютсяВШапке()
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		ХарактеристикиИспользуются = питОбщегоНазначения.ХарактеристикиИспользуются(Объект.Номенклатура);
	Иначе
		ХарактеристикиИспользуются = Ложь;
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Данные об упаковке.
//
// Параметры:
//  ТекНоменклатура - Произвольный - Тек номенклатура.
//  ТекУпаковка - Произвольный - Тек упаковка.
//  ТекКэшированныеЗначения - Произвольный - Тек кэшированные значения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ДанныеОбУпаковке(ТекНоменклатура, ТекУпаковка, ТекКэшированныеЗначения)
	Возврат ПакетнаяОбработкаТабличнойЧастиСервер.ДанныеОбУпаковке(ТекНоменклатура, ТекУпаковка, ТекКэшированныеЗначения);
КонецФункции

#КонецОбласти

#Область Серии

//  Процедура - Заполнить параметры указания серий.
//
&НаСервере
Процедура ЗаполнитьПараметрыУказанияСерий()
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питРазделка));
	
КонецПроцедуры

//  Функция - Параметры формы указания серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущиеДанныеИдентификатор - Произвольный - Текущие данные идентификатор.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор)
	
	Возврат НоменклатураСервер.ПараметрыФормыУказанияСерий(Объект, ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)], ТекущиеДанныеИдентификатор, ЭтаФорма);
	
КонецФункции

//  Процедура - Открыть подбор серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Текст - Строка - Текст.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ОткрытьПодборСерий(ИмяТЧ, Текст = "", ТекущиеДанные = Неопределено)
	
	Если ИмяТЧ = "Товары" Тогда
		СерияРедактируетсяВШапке      = "ТЧ";
	Иначе
		СерияРедактируетсяВШапке      = ИмяТЧ;
	КонецЕсли;
	
	НуженСерверныйВызов = НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(
		ЭтаФорма, 
		ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)], 
		Текст, 
		ТекущиеДанные);
	
	Если НуженСерверныйВызов Тогда
		
		Если ИмяТЧ = "Шапка" Тогда
			ТекущиеДанныеИдентификатор = Неопределено;
		ИначеЕсли ТекущиеДанные = Неопределено Тогда
			ТекущиеДанныеИдентификатор = Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
		Иначе
			ТекущиеДанныеИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		КонецЕсли;
		
		ПараметрыФормыУказанияСерий = ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор);
		ДополнительныеПараметры = Новый Структура("ПараметрыУказанияСерий,ПараметрыФормыУказанияСерий, ИмяТЧ, ТоварВШапке", 
		ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)], ПараметрыФормыУказанияСерий, ИмяТЧ, ИмяТЧ="Шапка");
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьПодборСерийЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму(ПараметрыФормыУказанияСерий.ИмяФормы, 
		ПараметрыФормыУказанияСерий, 
		ЭтаФорма,,,,
		ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обработать указание серий сервер.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//  ПараметрыФормыУказанияСерий - Произвольный - Параметры формы указания серий.
//
&НаСервере
Процедура ОбработатьУказаниеСерийСервер(Знач ИмяТЧ, Знач ПараметрыУказанияСерий, Знач ПараметрыФормыУказанияСерий)
	
	Если ПараметрыУказанияСерий.ИмяТЧТовары = "Товары"
		ИЛИ ПараметрыУказанияСерий.ИмяТЧТовары = "ПобочныеИзделия" Тогда
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ОбновлятьКоличествоТоваровПриРегистрацииСерий", Истина);
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокСерии(
		Неопределено, 
		ПараметрыУказанияСерий.ИмяТЧТовары, 
		СтруктураДействий);
	Иначе
		СтруктураДействий = Неопределено;
	КонецЕсли; 
	
	НоменклатураСервер.ОбработатьУказаниеСерий(
	Объект, 
	ПараметрыУказанияСерий, 
	ПараметрыФормыУказанияСерий, 
	СтруктураДействий);
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении количества упаковок серии.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокСерии(ТекущаяСтрока, ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчетаКоличестваЕдиниц = ПараметрыПересчетаКоличестваЕдиниц();
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчетаКоличестваЕдиниц);
	
КонецПроцедуры

//  Процедура - Установить видимость элементов серий.
//
&НаСервере
Процедура УстановитьВидимостьЭлементовСерий()
	
	Элементы.ТоварыСерия.Видимость = ПараметрыУказанияСерий.ТЧ.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.ТЧ.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыУказатьСерии.Видимость = ПараметрыУказанияСерий.ТЧ.ИспользоватьСерииНоменклатуры;
	
	Элементы.ПобочныеИзделияСерия.Видимость = ПараметрыУказанияСерий.ПобочныеИзделия.ИспользоватьСерииНоменклатуры;
	Элементы.ПобочныеИзделияСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.ПобочныеИзделия.ИспользоватьСерииНоменклатуры;
	Элементы.ПобочныеИзделияУказатьСерии.Видимость = ПараметрыУказанияСерий.ПобочныеИзделия.ИспользоватьСерииНоменклатуры;
	
	Элементы.СтатусУказанияСерий.Видимость         = ПараметрыУказанияСерий.Шапка.ИспользоватьСерииНоменклатуры;
	Элементы.Серия.Видимость                       = ПараметрыУказанияСерий.Шапка.ИспользоватьСерииНоменклатуры;
	
	УстановитьДоступностьСерииВШапке();
	
КонецПроцедуры

//  Процедура - Обновить кешированные значения для учета серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//  КэшированныеЗначенияСерий - Произвольный - Кэшированные значения серий.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ОбновитьКешированныеЗначенияДляУчетаСерий(ИмяТЧ, Элемент, КэшированныеЗначенияСерий, Копирование)
	
	Если ИмяТЧ = "Шапка" Тогда
		НоменклатураКлиент.ОбновитьКешированныеЗначенияШапкиДляУчетаСерий(
		Объект,КэшированныеЗначенияСерий,ПараметрыУказанияСерий.Шапка);
	Иначе
		НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(
		Элемент, КэшированныеЗначенияСерий, ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)], Копирование);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заполнить статусы указания серий сервер.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтрокиТоваровДляОбработки - Произвольный - Строки товаров для обработки.
//  СтрокиСерийДляОбработки - Произвольный - Строки серий для обработки.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, СтрокиТоваровДляОбработки = Неопределено, СтрокиСерийДляОбработки = Неопределено)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий[?(ИмяТЧ="Товары","ТЧ",ИмяТЧ)], СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки);
	Если ИмяТч = "Шапка" Тогда
		УстановитьДоступностьСерииВШапке();
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - После изменения строк тч программно на сервере.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  МассивИдентификаторовСтрок - Массив - Массив идентификаторов строк.
//  СтруктураРанееВыполненныхДействий - Структура - Структура ранее выполненных действий.
//
&НаСервере
Процедура ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивИдентификаторовСтрок = Неопределено, СтруктураРанееВыполненныхДействий = Неопределено)

	МассивСтрок = Неопределено;
	КоллекцияСтрок = Объект[ИмяТЧ];
	Если МассивИдентификаторовСтрок <> Неопределено Тогда
		МассивСтрок = Новый Массив;
		Для каждого ИдентификаторСтроки Из МассивИдентификаторовСтрок Цикл
			МассивСтрок.Добавить(Объект[ИмяТЧ].НайтиПоИдентификатору(ИдентификаторСтроки));
		КонецЦикла; 
		КоллекцияСтрок = МассивСтрок;
	КонецЕсли;
	
	Если СтруктураРанееВыполненныхДействий = Неопределено Тогда
		СтруктураРанееВыполненныхДействий = Новый Структура;
	КонецЕсли;
	
	Если (ИмяТЧ = "Товары" ИЛИ ИмяТЧ = "ПобочныеИзделия")
		И НЕ СтруктураРанееВыполненныхДействий.Свойство("ПроверитьСериюРассчитатьСтатус") Тогда
		ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, МассивСтрок, МассивСтрок);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Подготовить заполнить статусы указания серий.
//
&НаСервере
Процедура ПодготовитьЗаполнитьСтатусыУказанияСерий()
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питРазделка));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.ТЧ);
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.Шапка);
	УстановитьДоступностьСерииВШапке();
КонецПроцедуры

//  Процедура - Установить доступность серии в шапке.
//
&НаСервере
Процедура УстановитьДоступностьСерииВШапке()
	Если Объект.СтатусУказанияСерий = 14
		Или Объект.СтатусУказанияСерий = 13 Тогда
		Элементы.Серия.Доступность = Истина;
		Элементы.Серия.ПодсказкаВвода = "";
	Иначе
		Элементы.Серия.Доступность = Ложь;
		Элементы.Серия.ПодсказкаВвода = "<указывается отдельно>";
	КонецЕсли;
КонецПроцедуры

//  Процедура - Заполнить статусы указания серий при окончании редактирования строки тч.
//
// Параметры:
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//  ТекущаяСтрокаИдентификатор - Строка - Текущая строка идентификатор.
//  КэшированныеЗначенияСерий - Произвольный - Кэшированные значения серий.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Знач ПараметрыУказанияСерий,
	ТекущаяСтрокаИдентификатор,
	КэшированныеЗначенияСерий)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Объект, 
	ПараметрыУказанияСерий, ТекущаяСтрокаИдентификатор, КэшированныеЗначенияСерий);
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия по сериям.
//
// Параметры:
//  СтруктураДействий - Структура - Структура действий.
//  Склад - Произвольный - Склад.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Склад, ПараметрыУказанияСерий)
	
	ПараметрыПроверкиСерий = Новый Структура("Склад, ПараметрыУказанияСерий", Склад, ПараметрыУказанияСерий);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПараметрыПроверкиСерий);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

//  Процедура - Таблица склад при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИмяСклад - Произвольный - Имя склад.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ТаблицаСкладПриИзменении(ИмяТЧ, ИмяСклад = Неопределено, ТекущиеДанные)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	Если ИмяСклад = Неопределено Тогда
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
	Иначе
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, ТекущиеДанные[ИмяСклад], ПараметрыУказанияСерий[ИмяТЧ]);
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - При чтении создании на сервере.
//
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	// +Серии
	ЗаполнитьПараметрыУказанияСерий();
	ЗаполнитьСтатусыУказанияСерийСервер("Товары");
	ЗаполнитьСтатусыУказанияСерийСервер("ПобочныеИзделия");
	ЗаполнитьСтатусыУказанияСерийСервер("Шапка");
	УстановитьВидимостьЭлементовСерий();
	// -Серии
	
КонецПроцедуры

//  Процедура - Обработка выбора подбор товаров на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		
		// Дозаполним еще реквизиты, такие как "Рецептура", "ЭтоБлюдо", "ЭтоТовар" и т.д.
		СписокСвойствСтрокой = "Номенклатура, Характеристика, ЭтоУслуга, ЭтоБлюдо, ЭтоТовар, Иконка, Рецептура";
		ДанныеСтрокаТаблицы = Новый Структура(СписокСвойствСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, ТекущаяСтрока);
		
		СвойстваПараметрыОбъектаСтрокой = "ХозяйственнаяОперация, Организация, Дата, Ссылка, Подразделение";
		ПараметрыОбъекта = Новый Структура();
		ПараметрыОбъекта = Новый Структура(СвойстваПараметрыОбъектаСтрокой);
		ПараметрыОбъекта.Вставить("СпособРасчетаРецептуры", СпособРасчетаРецептурыПоАктуальной);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
		
		ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеСтрокаТаблицы);
		
	КонецЦикла;
	
	питПроизводство.УстановитьВидимостьНадписиРазныеЕдиницы(Объект, Элементы, "Товары");
	
КонецПроцедуры

//  Процедура - Товары номенклатура при изменении на сервере.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//  ПараметрыОбъекта - Произвольный - Параметры объекта.
//
&НаСервереБезКонтекста
Процедура ТоварыНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, Знач ПараметрыОбъекта)
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТабличнойЧасти.Номенклатура, "питВидНоменклатуры");
	СтрокаТабличнойЧасти.ЭтоБлюдо = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо);
	СтрокаТабличнойЧасти.ЭтоУслуга = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Услуга);
	
	СтрокаТабличнойЧасти.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(РеквизитыНоменклатуры.питВидНоменклатуры, Ложь);
	
	Если СтрокаТабличнойЧасти.ЭтоБлюдо Тогда
		ДатаРецептуры = ?(ЗначениеЗаполнено(ПараметрыОбъекта.Ссылка), ПараметрыОбъекта.Дата, КонецДня(ПараметрыОбъекта.Дата));
		СтрокаТабличнойЧасти.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(СтрокаТабличнойЧасти.Номенклатура,СтрокаТабличнойЧасти.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
			ДатаРецептуры, ПараметрыОбъекта.СпособРасчетаРецептуры, , ПараметрыОбъекта.Организация,,,ПараметрыОбъекта.Подразделение);
	Иначе
		СтрокаТабличнойЧасти.Рецептура = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Получить параметры подбора.
//
// Параметры:
//  ИмяТаблицы - Строка - Имя таблицы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучитьПараметрыПодбора(ИмяТаблицы = "Товары")
	
	ПараметрыФормы = Новый Структура;
	
	Если ИмяТаблицы = "Товары" Тогда
		
		ПараметрЗаголовок = НСтр("ru = 'Подбор товаров в %Документ%'");
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", Объект.Ссылка);
		Иначе
			ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", НСтр("ru = 'разделку'"));
		КонецЕсли;
		
//   ОтборТипЦен = ?(ЗначениеЗаполнено(Объект.ТипЦен),Объект.ТипЦен,
// питОбщегоНазначения.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит"));.
		ОтборТипЦен = питОбщегоНазначения.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит");
		ОтборЦенаВключаетНДС = ?(ЗначениеЗаполнено(Объект.ТипЦен),питОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборТипЦен,"ЦенаВключаетНДС"), Истина);
		
		ПараметрыФормы.Вставить("Заголовок",										ПараметрЗаголовок);
		ПараметрыФормы.Вставить("Дата",												Объект.Дата);
		ПараметрыФормы.Вставить("Склад",											Объект.Склад);
		ПараметрыФормы.Вставить("Организация",										Объект.Организация);
		ПараметрыФормы.Вставить("Валюта",											?(ЗначениеЗаполнено(Объект.ВалютаДокумента),Объект.ВалютаДокумента,питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета()));
		ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти",	Ложь);
		ПараметрыФормы.Вставить("Документ",											Объект.Ссылка);
		ПараметрыФормы.Вставить("ВидЦены",											ОтборТипЦен);
		ПараметрыФормы.Вставить("ЦенаВключаетНДС",									ОтборЦенаВключаетНДС);
		ПараметрыФормы.Вставить("РежимПодбораБезСоглашенийСКлиентами",				Истина);
		
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции

//  Процедура - Установить условное оформление.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ТоварыНоменклатураЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.Товары.Упаковка";
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ПобочныеИзделияНоменклатураЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.ПобочныеИзделия.Упаковка";
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.Характеристика, ХарактеристикиИспользуются);
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
		"ТоварыХарактеристика",
		"Объект.Товары.ХарактеристикиИспользуются");
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
		"ПобочныеИзделияХарактеристика",
		"Объект.ПобочныеИзделия.ХарактеристикиИспользуются");
	
	// +Серии
	НоменклатураСервер.УстановитьУсловноеОформлениеСтатусовУказанияСерий(ЭтаФорма	, Ложь, "ТоварыСтатусУказанияСерий", "Объект.Товары.СтатусУказанияСерий");
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма		, Ложь, "ТоварыСерия", "Объект.Товары.СтатусУказанияСерий", "Объект.Товары.ТипНоменклатуры");
	НоменклатураСервер.УстановитьУсловноеОформлениеСтатусовУказанияСерий(ЭтаФорма	, Ложь, "ПобочныеИзделияСтатусУказанияСерий", "Объект.ПобочныеИзделия.СтатусУказанияСерий");
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма		, Ложь, "ПобочныеИзделияСерия", "Объект.ПобочныеИзделия.СтатусУказанияСерий", "Объект.ПобочныеИзделия.ТипНоменклатуры");
	// -Серии
	
КонецПроцедуры

//  Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.Рецептура.ТолькоПросмотр = ?(Форма.СпособРасчетаРецептурыПоАктуальной, Истина, Ложь);
	Элементы.Рецептура.Доступность = ЗначениеЗаполнено(Объект.Номенклатура);
	
	Элементы.ПодразделениеОрганизации.Доступность = ЗначениеЗаполнено(Объект.Организация);
	
	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазделка") Тогда
		МассивВидовНоменклатуры = Новый Массив;
		МассивВидовНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Блюдо"));
		МассивВидовНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Товар"));
		МассивВидовНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.ТехнологическийИнгредиент"));
		ВидНоменклатуры = Новый ФиксированныйМассив(МассивВидовНоменклатуры);
		ЗаголовокВыбора = "Товары";
		ВидРецептуры = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазделка");
	ИначеЕсли Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазукомплектацияБлюд") Тогда
		ВидНоменклатуры = ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Блюдо");
		ЗаголовокВыбора = "Блюда";
		ВидРецептуры = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазукомплектацияБлюд");
	Иначе
		МассивВидовНоменклатуры = Новый Массив;
		МассивВидовНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Товар"));
		МассивВидовНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Блюдо"));
		МассивВидовНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.ТехнологическийИнгредиент"));
		ВидНоменклатуры = Новый ФиксированныйМассив(МассивВидовНоменклатуры);
		ЗаголовокВыбора = "Номенклатура";
		МассивВидовРецептуры = Новый Массив;
		МассивВидовРецептуры.Добавить(ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазделка"));
		МассивВидовРецептуры.Добавить(ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураРазукомплектацияБлюд"));
		ВидРецептуры = Новый ФиксированныйМассив(МассивВидовРецептуры);
	КонецЕсли;
	
	НовыйМассивПараметров = Новый Массив();
	НовыйМассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.питВидНоменклатуры", ВидНоменклатуры));
	НовыйМассивПараметров.Добавить(Новый ПараметрВыбора("Заголовок", ЗаголовокВыбора));
	Элементы.Номенклатура.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассивПараметров);
	
	Если НЕ Форма.СпособРасчетаРецептурыПоАктуальной Тогда
		НовыйМассивПараметров = Новый Массив();
		НовыйМассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ХозяйственнаяОперация", ВидРецептуры));
		Элементы.Рецептура.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассивПараметров);
	КонецЕсли;
	
	СформироватьНадписьЦеныИВалюта(Форма);
	
КонецПроцедуры

//  Процедура - Сформировать надпись цены и валюта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьНадписьЦеныИВалюта(Форма)
	
	Форма.ЦеныИВалюта = "Цены и валюта";
	
КонецПроцедуры 

//  Процедура - Пересчитать количества в табличной части.
//
// Параметры:
//  Пересчитывать - Произвольный - Пересчитывать.
//
&НаКлиенте
Процедура ПересчитатьКоличестваВТабличнойЧасти(Пересчитывать = Неопределено)
	
	Если Объект.Товары.Количество() > 0 Тогда
		
		Если Пересчитывать = Неопределено Тогда
			Пересчитывать = Объект.Количество <> КоличествоПредыдущее;
		КонецЕсли;
		
		// Пересчитать количества в табличной части.
		Если Пересчитывать Тогда
			
			КоличествоПредыдущее = Объект.Количество;
			
			ОсталосьРаспределить = Объект.КоличествоУпаковок;
			ОсталосьКоличествоУпаковокБрутто = Объект.Товары.Итог("ПроцентВыхода");
			ВсегоДоляВыхода = ОсталосьКоличествоУпаковокБрутто;
			
			Для Каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
				
				ТекКоличествоВыхода = ?(СтрокаТабличнойЧасти.ПроцентВыхода = ОсталосьКоличествоУпаковокБрутто, ОсталосьРаспределить, СтрокаТабличнойЧасти.ПроцентВыхода/ВсегоДоляВыхода * Объект.КоличествоУпаковок);
				СтрокаТабличнойЧасти.КоличествоУпаковокНорма	= ТекКоличествоВыхода;
				
				ОсталосьКоличествоУпаковокБрутто = ОсталосьКоличествоУпаковокБрутто - СтрокаТабличнойЧасти.ПроцентВыхода;
				ОсталосьРаспределить = ОсталосьРаспределить - ТекКоличествоВыхода;
				
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "Норма");
				ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения);
				
			КонецЦикла;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("КоличествоПриИзменении_Завершение", ЭтотОбъект, Новый Структура("КэшированныеЗначения", КэшированныеЗначения)), "Пересчитать фактические количества в табличной части?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Посчитать количества вединицах хранения.
//
// Параметры:
//  Суффикс - Произвольный - Суффикс.
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ПосчитатьКоличестваВединицахХранения(Суффикс, ИмяТЧ)
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", Суффикс);
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

//  Процедура - Подключаемый выполнить команду на сервере.
//
// Параметры:
//  Контекст - Произвольный - Контекст.
