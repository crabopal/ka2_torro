#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Процедура - Обработка заполнения.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  ТекстЗаполнения - Произвольный - Текст заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированныйУчетПодсистемы") Тогда
		МодульЗаполнениеДокументов = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеДокументов");
		МодульЗаполнениеДокументов.Заполнить(ЭтотОбъект, ДанныеЗаполнения, Ложь);
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питВыпускБлюд") Тогда
		
		Документы.питБракеражПродукции.ЗаполнитьДокументНаОснованииВыпускаБлюд(ЭтотОбъект, ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = тип("ДокументСсылка.питПланМеню") Тогда
		
		Документы.питБракеражПродукции.ЗаполнитьДокументНаОснованииПланаМеню(ЭтотОбъект, ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Добавить("Товары");
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

// Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.питБракеражПродукции);
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект, ПараметрыУказанияСерий.Товары);
	
	// Установка недсотающих ключей строк товаров.
	УстановитьНедостающиеКлючиСтрокТоваров();
	
КонецПроцедуры

// Процедура - Обработка проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Если обмен данными, то ничего не делаем.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = "";
	
	Если НЕ Отказ Тогда
		
		НаборЗаписейДобавить = РегистрыСведений.питБракеражныйЖурнал.СоздатьНаборЗаписей();
		НаборЗаписейДобавить.Отбор.Документ.Установить(Ссылка);
		
		Для каждого ТекТовар Из Товары Цикл
			
			СтрокаДобавить = НаборЗаписейДобавить.Добавить();
			// Измерения
			СтрокаДобавить.Организация						= Организация;
			СтрокаДобавить.Подразделение					= Подразделение;
			СтрокаДобавить.Склад							= Склад;
			СтрокаДобавить.ДатаБракеража					= Дата;
			СтрокаДобавить.ДатаИзготовления					= ТекТовар.ДатаИзготовления;
			СтрокаДобавить.Номенклатура						= ТекТовар.Номенклатура;
			СтрокаДобавить.Характеристика					= ТекТовар.Характеристика;
			СтрокаДобавить.Серия							= ТекТовар.Серия;
			СтрокаДобавить.Документ							= Ссылка;
			// Ресурсы
			СтрокаДобавить.ОрганолептическаяОценка			= ТекТовар.ОрганолептическаяОценка;
			СтрокаДобавить.РазрешеноКРеализации				= ТекТовар.РазрешеноКРеализации;
			// Реквизиты
			СтрокаДобавить.Ответственный					= Ответственный;
			СтрокаДобавить.ПодписиЧленовБракеражнойКомиссии	= ТекТовар.ПодписиЧленовБракеражнойКомиссии;
			СтрокаДобавить.Вес								= ТекТовар.Вес;
			СтрокаДобавить.Примечание						= ТекТовар.Примечание;
			
		КонецЦикла;
		
		Попытка
			НаборЗаписейДобавить.ДополнительныеСвойства.Вставить("РазрешитьЗапись", Истина);
			НаборЗаписейДобавить.Записать(Истина);
		Исключение
			Отказ = Истина;
			ТекстСообщения = ТекстСообщения + "
			|Не удалось записать бракераж продукции по документу " + Ссылка + " по причине:
			|"+ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обработка удаления проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	// Удалим существующие записи по документу.
	ТекстСообщения = "";
	Отказ = НЕ РегистрыСведений.питБракеражныйЖурнал.УдалитьЗаписиПоДокументу(Ссылка, ТекстСообщения);
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура - Инициализировать документ.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный		= Пользователи.ТекущийПользователь();
	Склад				= ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Склад, Ложь, Истина);
	
КонецПроцедуры

// Процедура - Установить недостающие ключи строк товаров.
//
Процедура УстановитьНедостающиеКлючиСтрокТоваров()
	Для каждого ТекСтрокаТовары Из Товары Цикл
		Если ПустаяСтрока(ТекСтрокаТовары.КлючСтроки) Тогда
			ТекСтрокаТовары.КлючСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Инициализация
#Область ПрограммныйИнтефейс
#КонецОбласти
#КонецОбласти

#КонецЕсли




