// Заполняет список команд отчетов.
//
// Параметры:
//  КомандыОтчетов - ТаблицаЗначений - состав полей в функции МенюОтчеты.СоздатьКоллекциюКомандОтчето.
//  НастройкиФормы - Произвольный - Настройки формы.
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, НастройкиФормы) Экспорт
	
КонецПроцедуры

#КонецОбласти

#Область Печать

// Заполняет список команд печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - состав полей в функции УправлениеПечатью.СоздатьКоллекциюКомандПечат.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	МожноРедактировать = ПравоДоступа("Редактирование", Метаданные.Документы.питБракеражПродукции);
	Если НЕ МожноРедактировать Тогда
		Возврат;
	КонецЕсли;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "питБракеражныйЖурнал";
	КомандаПечати.Представление = НСтр("ru = 'Бракеражный журнал'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

// Процедура - Печать.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ПараметрыПечати - Произвольный - Параметры печати.
//  КоллекцияПечатныхФорм - Произвольный - Коллекция печатных форм.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  ПараметрыВывода - Произвольный - Параметры вывода.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// БракеражныйЖурнал
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "питБракеражныйЖурнал") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "питБракеражныйЖурнал", "Бракеражный журнал",
			ПечатьБракеражныйЖурнал(МассивОбъектов, ОбъектыПечати),,"Документ.питБракеражПродукции.ПФ_MXL_питБракеражныйЖурнал");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Серии

// Имена реквизитов, от значений которых зависят параметры указания серий.
//
// Возвращаемое значение:
// 		Строка - имена реквизитов, перечисленные через запятую.
Функция ИменаРеквизитовДляЗаполненияПараметровУказанияСерий() Экспорт
	
	Возврат "Подразделение, Дата";
	
КонецФункции

// Возвращает параметры указания серий для товаров, указанных в документе.
//
// Параметры:
//  Объект - Структура - структура значений реквизитов объекта, необходимых для заполнения параметров указания серий.
//
// Возвращаемое значение:
// 			Структура - Структура параметров указания серий для объекта.
Функция ПараметрыУказанияСерий(Объект) Экспорт
	
	ПараметрыУказанияСерий = Новый Структура;
	
	#Область Товары
	
	ПараметрыУказанияСерийТЧ = НоменклатураКлиентСервер.ПараметрыУказанияСерий();
	
	ПараметрыУказанияСерийТЧ.ПолноеИмяОбъекта	= "Документ.питБракеражПродукции";
	ПараметрыУказанияСерийТЧ.ИмяПоляСклад		= "Склад";
	ПараметрыУказанияСерийТЧ.ИмяТЧТовары		= "Товары";
	// ПараметрыУказанияСерийТЧ.ИмяТЧСерии			= "ТоварыСерии";
	ПараметрыУказанияСерийТЧ.ИмяТЧСерии			= "Товары";
	
	ПараметрыУказанияСерийТЧ.УчитыватьСебестоимостьПоСериям	= ПолучитьФункциональнуюОпцию("УчитыватьСебестоимостьПоСериямСклад", Новый Структура());
	ПараметрыУказанияСерийТЧ.ИспользоватьСерииНоменклатуры	= ПолучитьФункциональнуюОпцию("ИспользоватьСерииНоменклатурыСклад", Новый Структура());
	
	ПараметрыУказанияСерийТЧ.ИменаПолейСтатусУказанияСерий.Добавить("СтатусУказанияСерий");
	
	ПараметрыУказанияСерийТЧ.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПриемкаПродукцииИзПроизводства);
	
	ПараметрыУказанияСерийТЧ.ЭтоНакладная = Истина;
	
	ПараметрыУказанияСерийТЧ.СерииПриПланированииОтгрузкиУказываютсяВТЧСерии = Истина;
	ПараметрыУказанияСерийТЧ.ПланированиеОтгрузки = Ложь;
	ПараметрыУказанияСерийТЧ.ПланированиеОтбора   = Ложь;
	ПараметрыУказанияСерийТЧ.ФактОтбора           = Истина;
	
	ПараметрыУказанияСерийТЧ.РегистрироватьСерии = Истина;
	
	ПараметрыУказанияСерийТЧ.Дата = Объект.Дата;
	
	ПараметрыУказанияСерий.Вставить("Товары", ПараметрыУказанияСерийТЧ);
	
	#КонецОбласти
	
	Возврат ПараметрыУказанияСерий;
	
КонецФункции

// Возвращает текст запроса для расчета статусов указания серий.
//
// Параметры:
//  ПараметрыУказанияСерий - Структура - состав полей задается в функци.
//
// Возвращаемое значение:
// 		Строка - текст запроса.
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерий(ПараметрыУказанияСерий) Экспорт
	
	ТекстЗапроса = "";
	
	Если ПараметрыУказанияСерий.ИмяТЧТовары = "Товары" Тогда
		ТекстЗапроса = ТекстЗапросаЗаполненияСтатусовУказанияСерийТоварыБлюда();
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СозданиеНаОсновании

// Определяет список команд создания на основании.
//
// Параметры:
//  КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании.
//  Параметры - Структура - Вспомогательные параметры. Для чтения.
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
КонецПроцедуры

// Добавляет команду создания документа.
//
// Параметры:
//  КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	Если ПравоДоступа("Добавление", Метаданные.Документы.питБракеражПродукции) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.питБракеражПродукции.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = ОбщегоНазначенияУТ.ПредставлениеОбъекта(Метаданные.Документы.питБракеражПродукции);
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		
		
		
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

// Процедура - Заполнить документ на основании выпуска блюд.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//  ДокументОснование - Произвольный - Документ основание.
//  ТолькоТовары - Произвольный - Только товары.
//  Дополнить - Произвольный - Дополнить.
//
Процедура ЗаполнитьДокументНаОснованииВыпускаБлюд(ДокументОбъект, ДокументОснование, ТолькоТовары = Ложь, Дополнить = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	питВыпускБлюд.Представление КАК Представление,
	|	питВыпускБлюд.Ссылка КАК ДокументОснование,
	|	питВыпускБлюд.Дата КАК ДатаИзготовления,
	|	питВыпускБлюд.Организация,
	|	питВыпускБлюд.Подразделение,
	|	питВыпускБлюд.Склад КАК Склад,
	|	питВыпускБлюд.Товары.(
	|		Номенклатура,
	|		Характеристика,
	|		Серия,
	|		СтатусУказанияСерий,
	|		Количество,
	|		КоличествоУпаковок
	|	),
	|	питВыпускБлюд.ТоварыСерии.(
	|		Серия,
	|		Номенклатура,
	|		Характеристика,
	|		Получатель,
	|		Назначение,
	|		Количество
	|	)
	|ИЗ
	|	Документ.питВыпускБлюд КАК питВыпускБлюд
	|ГДЕ
	|	питВыпускБлюд.Ссылка = &ДокументОснование";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование",ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	Если НЕ ТолькоТовары Тогда
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка);
	КонецЕсли;
	
	Если НЕ Выборка.Товары = Неопределено Тогда
		ТаблицаТоваров = Выборка.Товары.Выгрузить();
		Если НЕ Дополнить Тогда
			ДокументОбъект.Товары.Очистить();
		КонецЕсли;
		Для каждого ТекТовар Из ТаблицаТоваров Цикл
			НовСтрокаТовары = ДокументОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаТовары, ТекТовар);
			НовСтрокаТовары.КлючСтроки = Новый УникальныйИдентификатор;
			НовСтрокаТовары.ДатаИзготовления = Выборка.ДатаИзготовления;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ Выборка.ТоварыСерии = Неопределено Тогда
		ТаблицаСерий = Выборка.ТоварыСерии.Выгрузить();
		Если НЕ Дополнить Тогда
			ДокументОбъект.ТоварыСерии.Очистить();
		КонецЕсли;
		Для каждого ТекСтрокаСерии Из ТаблицаСерий Цикл
			НовСтрока = ДокументОбъект.ТоварыСерии.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрокаСерии);
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ТолькоТовары Тогда
		ДокументОбъект.Комментарий = "Создан на основании документа: <"+Выборка.Представление+">";
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Заполнить документ на основании плана меню.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//  ДокументОснование - Произвольный - Документ основание.
//  ТолькоТовары - Произвольный - Только товары.
//  Дополнить - Произвольный - Дополнить.
//
Процедура ЗаполнитьДокументНаОснованииПланаМеню(ДокументОбъект, ДокументОснование, ТолькоТовары = Ложь, Дополнить = Ложь) Экспорт
	
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	питПланМеню.Представление КАК Представление,
	|	питПланМеню.Ссылка КАК ДокументОснование,
	|	питПланМеню.ДатаПлан КАК ДатаИзготовления,
	|	питПланМеню.Организация,
	|	питПланМеню.Подразделение,
	|	питПланМеню."+?(ФормироватьДокументыПроизводства22, "ЦеховаяКладовая", "Склад")+" КАК Склад,
	|	питПланМеню.Товары.(
	|		Номенклатура,
	|		Характеристика
	|	)
	|ИЗ
	|	Документ.питПланМеню КАК питПланМеню
	|ГДЕ
	|	питПланМеню.Ссылка = &ДокументОснование";
		
		
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование",ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если НЕ ТолькоТовары Тогда
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка);
	КонецЕсли;
	
	Если НЕ Выборка.Товары = Неопределено Тогда
		ТаблицаТоваров = Выборка.Товары.Выгрузить();
		Если НЕ Дополнить Тогда
			ДокументОбъект.Товары.Очистить();
		КонецЕсли;
		Для каждого ТекТовар Из ТаблицаТоваров Цикл
			НовСтрокаТовары = ДокументОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаТовары, ТекТовар);
			НовСтрокаТовары.КлючСтроки = Новый УникальныйИдентификатор;
			НовСтрокаТовары.ДатаИзготовления = Выборка.ДатаИзготовления;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ТолькоТовары Тогда
		ДокументОбъект.Комментарий = "Документ создан на основании документа: <"+Выборка.Представление+">";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

