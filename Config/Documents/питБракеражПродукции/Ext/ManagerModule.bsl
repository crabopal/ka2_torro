// Функция формирует табличный документ с печатной формой "Бракеражный журнал"
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма
Функция ПечатьБракеражныйЖурнал(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// ВыборкаПоТоварам = ЗапросПоТоварам.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.питБракеражПродукции.ПФ_MXL_питБракеражныйЖурнал");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ПолеСверху			= 0;
	ТабличныйДокумент.ПолеСлева				= 0;
	ТабличныйДокумент.ПолеСнизу				= 0;
	ТабличныйДокумент.ПолеСправа			= 0;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_питБракеражПродукции_питБракеражныйЖурнал";
	
	СисИнфо = Новый СистемнаяИнформация;
	Если ПустаяСтрока(СисИнфо.ИнформацияПрограммыПросмотра) Тогда 
		ТабличныйДокумент.ПолеСлева          = 0;
	Иначе
		ТабличныйДокумент.ПолеСлева          = 10;
	КонецЕсли;
	
	// Признак того, что документ первый(для последующих документов
	// вставляем горизонтальный разделитель страниц.
	ПервыйДокумент = Истина;
	
	////////////////////////////////////////////////////////////
	// Обход массива документов.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питБракеражныйЖурнал.Документ КАК Ссылка,
	|	питБракеражныйЖурнал.Организация КАК ОрганизацияРасшифровка,
	|	питБракеражныйЖурнал.Организация.Представление КАК Организация,
	|	питБракеражныйЖурнал.Склад КАК СкладРасшифровка,
	|	питБракеражныйЖурнал.Подразделение КАК ПодразделениеРасшифровка,
	|	питБракеражныйЖурнал.ДатаБракеража КАК ДатаБракеража,
	|	питБракеражныйЖурнал.Склад.Представление КАК Склад,
	|	питБракеражныйЖурнал.Подразделение.Представление КАК Подразделение,
	|	питБракеражныйЖурнал.ДатаИзготовления КАК ДатаИзготовления,
	|	питБракеражныйЖурнал.Номенклатура КАК НоменклатураРасшифровка,
	|	питБракеражныйЖурнал.ОрганолептическаяОценка.Представление КАК ОрганолептическаяОценкаПредставление,
	|	ВЫБОР
	|		КОГДА питБракеражныйЖурнал.РазрешеноКРеализации
	|			ТОГДА ""Разрешено""
	|		ИНАЧЕ ""Запрещено""
	|	КОНЕЦ КАК РазрешеноКРеализацииПредставление,
	|	питБракеражныйЖурнал.Примечание КАК Примечание,
	|	питБракеражныйЖурнал.Номенклатура.Представление КАК НоменклатураПредставление,
	|	питБракеражныйЖурнал.Характеристика.Представление КАК ХарактеристикаПредставление,
	|	питБракеражныйЖурнал.Серия.Представление КАК СерияПредставление,
	|	питБракеражныйЖурнал.ПодписиЧленовБракеражнойКомиссии КАК ПодписиЧленовБракеражнойКомиссии,
	|	питБракеражныйЖурнал.Вес КАК Вес
	|ИЗ
	|	РегистрСведений.питБракеражныйЖурнал КАК питБракеражныйЖурнал
	|ГДЕ
	|	питБракеражныйЖурнал.Документ В(&МассивОбъектов)
	|ИТОГИ ПО
	|	ОрганизацияРасшифровка,
	|	ПодразделениеРасшифровка,
	|	СкладРасшифровка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаВерхняя = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВерхняя.Следующий() Цикл
		ВыборкаСредняя = ВыборкаВерхняя.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСредняя.Следующий() Цикл
			ВыборкаНижняя = ВыборкаСредняя.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаНижняя.Следующий() Цикл
				Счетчик = 0;
				ВыборкаСсылка = ВыборкаНижняя.Выбрать();
				Пока ВыборкаСсылка.Следующий() Цикл
					
					Если Счетчик = 0 Тогда
						
						////////////////////////////////////////////////////////////
						// Подготовка табличного документа и макета
						// Для не первого документа вставка разделителя страниц.
						Если НЕ ПервыйДокумент Тогда
							
							ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
							ТабличныйДокумент.Вывести(ОбластьМакета);
							
							ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						КонецЕсли;
						ПервыйДокумент = Ложь;
						// Запомним номер строки, с которой начали выводить текущий документ.
						НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
						
						// Вывод шапки печатной формы
						ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
						ОбластьМакета.Параметры.Заголовок					= "Журнал бракеража готовой кулинарной продукции";
						ОбластьМакета.Параметры.Склад						= ВыборкаСсылка.Склад;
						ОбластьМакета.Параметры.СкладРасшифровка			= ВыборкаСсылка.СкладРасшифровка;
						ОбластьМакета.Параметры.Подразделение				= ВыборкаСсылка.Подразделение;
						ОбластьМакета.Параметры.ПодразделениеРасшифровка	= ВыборкаСсылка.ПодразделениеРасшифровка;
						ОбластьМакета.Параметры.Организация					= ВыборкаСсылка.Организация;
						ОбластьМакета.Параметры.ОрганизацияРасшифровка		= ВыборкаСсылка.ОрганизацияРасшифровка;
						ТабличныйДокумент.Вывести(ОбластьМакета);
						
						// Область ингредиентов, по которым есть недовложения.
						ОбластьТовар = Макет.ПолучитьОбласть("Товар");
						
					КонецЕсли;
					
					// Вывод ТЧ "Товары"
					ОбластьТовар.Параметры.Заполнить(ВыборкаСсылка);
					ОбластьТовар.Параметры.ДатаИзготовления	= Формат(ВыборкаСсылка.ДатаИзготовления, "ДФ='дд.ММ.гггг ЧЧ:мм'");
					ОбластьТовар.Параметры.ДатаБракеража	= Формат(ВыборкаСсылка.ДатаБракеража, "ДФ='дд.ММ.гггг ЧЧ:мм'");
					ОбластьТовар.Параметры.Номенклатура = ВыборкаСсылка.НоменклатураПредставление 
					+ ?(ЗначениеЗаполнено(ВыборкаСсылка.ХарактеристикаПредставление)," / " + СокрЛП(ВыборкаСсылка.ХарактеристикаПредставление),"")
					+ ?(ЗначениеЗаполнено(ВыборкаСсылка.СерияПредставление)," / " + СокрЛП(ВыборкаСсылка.СерияПредставление),"");
					ТабличныйДокумент.Вывести(ОбластьТовар);
					
					Счетчик = Счетчик + 1;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область Серии

// Функция - Текст запроса заполнения статусов указания серий товары блюда.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерийТоварыБлюда()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Серия,
	|	Товары.СтатусУказанияСерий,
	|	Товары.НомерСтроки
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.СтатусУказанияСерий КАК СтарыйСтатусУказанияСерий,
	|	ВЫБОР
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий ЕСТЬ NULL 
	|			ТОГДА 0
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 14
	|					ИНАЧЕ 13
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтгрузки
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 10
	|					ИНАЧЕ 9
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтбора
	|			ТОГДА ВЫБОР
	|					КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчетСерийПоFEFO
	|						ТОГДА ВЫБОР
	|								КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|									ТОГДА 6
	|								ИНАЧЕ 5
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|								ТОГДА 8
	|							ИНАЧЕ 7
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПоФактуОтбора
	|				И ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриОтгрузкеНаВнутренниеНужды
	|			ТОГДА ВЫБОР
	|					КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьОстаткиСерий
	|						ТОГДА ВЫБОР
	|								КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|									ТОГДА 4
	|								ИНАЧЕ 3
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|								ТОГДА 2
	|							ИНАЧЕ 1
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтатусУказанияСерий
	|ПОМЕСТИТЬ Статусы
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерий
	|		ПО (ПолитикиУчетаСерий.Склад = &Склад)
	|			И (ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура).ВидНоменклатуры = ПолитикиУчетаСерий.Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Статусы.НомерСтроки,
	|	Статусы.СтатусУказанияСерий
	|ИЗ
	|	Статусы КАК Статусы
	|ГДЕ
	|	Статусы.СтатусУказанияСерий <> Статусы.СтарыйСтатусУказанияСерий
	|
	|УПОРЯДОЧИТЬ ПО
	|	Статусы.НомерСтроки";
	
	Возврат ТекстЗапроса;
	
КонецФункции

