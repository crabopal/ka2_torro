
#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения;

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область Серии

//  Процедура - Открыть подбор серий завершение.
//
// Параметры:
//  РезультатЗакрытия - Произвольный - Результат закрытия.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОткрытьПодборСерийЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		ОбработатьУказаниеСерийСервер(ДополнительныеПараметры.ИмяТЧ, ДополнительныеПараметры.ПараметрыУказанияСерий, ДополнительныеПараметры.ПараметрыФормыУказанияСерий);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();                                                            
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	ЗаполнитьПараметрыУказанияСерий();
	
	УстановитьВидимостьЭлементовСерий();
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.питБракеражПродукции.Форма.ФормаЗаполненияСтрок" Тогда
		ОбработкаВыбораПодборФормаЗаполнения(ВыбранноеЗначение);
		УправлениеФормой(ЭтаФорма);
	ИначеЕсли СтрНачинаетсяС(ИсточникВыбора.ИмяФормы, "Документ.питВыпускБлюд") Тогда
		ОбработкаВыбораПодборЗаполнитьПоВыпускуБлюд(ВыбранноеЗначение);
		
	ИначеЕсли СтрНачинаетсяС(ИсточникВыбора.ИмяФормы, "Документ.питПланМеню") Тогда
		ОбработкаВыбораПодборЗаполнитьПоПлануМеню(ВыбранноеЗначение);
	КонецЕсли;
	
	Если НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
		
		НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[ВыбранноеЗначение.ИмяТЧ], ВыбранноеЗначение);
		
	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Склад при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТаблицаСкладПриИзменении("Товары", , ТекущиеДанные);
КонецПроцедуры

//  Процедура - Товары при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ОбновитьКешированныеЗначенияДляУчетаСерий("Товары", Элемент, КэшированныеЗначения, Копирование);
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ДатаИзготовления = ?(Объект.Ссылка.Пустая(), ТекущаяДата(), Объект.Дата);
	ТекущиеДанные.КлючСтроки = Новый УникальныйИдентификатор;
	
КонецПроцедуры

//  Процедура - Товары при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТаблицаПриОкончанииРедактирования("Товары", Элемент);
КонецПроцедуры

//  Процедура - Товары перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	ОбновитьКешированныеЗначенияДляУчетаСерий("Товары", Элемент, КэшированныеЗначения, Ложь);
КонецПроцедуры

//  Процедура - Товары номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	ТаблицаНоменклатураПриИзменении("Товары");
КонецПроцедуры

//  Процедура - Товары серия при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСерияПриИзменении(Элемент)
	ТаблицаСерияПриИзменении("Товары");
КонецПроцедуры

#КонецОбласти

#Область Серии

//  Процедура - Товары серия начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСерияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий("Товары", Элемент.ТекстРедактирования, Элементы.Товары.ТекущиеДанные);
КонецПроцедуры

//  Процедура - Товары выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если (Поле = Элементы["ТоварыСерия"] 
				ИЛИ Поле = Элементы["ТоварыСтатусУказанияСерий"]) Тогда
		ТаблицаВыборСерии("Товары", Поле, Элемент, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Товары обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТаблицаОбработкаВыбора("Товары", ВыбранноеЗначение);
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область Серии

//  Процедура - Товары указать серии.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТоварыУказатьСерии(Команда)
	ОткрытьПодборСерий("Товары");
КонецПроцедуры

#КонецОбласти

//  Процедура - Заполнить по документу.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаполнитьПоДокументу(Команда)
	Если Команда.Имя = "ЗаполнитьПоВыпускуБлюд" Тогда
		ОткрытьФорму("Документ.питВыпускБлюд.ФормаВыбора", Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Истина, Истина), ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли Команда.Имя = "ЗаполнитьПоПлануМеню" Тогда
		ОткрытьФорму("Документ.питПланМеню.ФормаВыбора", Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Истина, Истина), ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Заполнить выделенные.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаполнитьВыделенные(Команда)
	ВыделенныеСтроки = Элементы.Товары.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() Тогда
		АдресТаблицы = ПолучитьТаблицуВыделенныхСтрок(ВыделенныеСтроки);
		ОткрытьФорму("Документ.питБракеражПродукции.Форма.ФормаЗаполненияСтрок", Новый Структура("АдресСтрокиЗаполнить", АдресТаблицы), ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Характеристики

//  Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются"
		,Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
		Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
		Новый Структура("Номенклатура", "ТипНоменклатуры"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары,	ПараметрыЗаполненияРеквизитов);
	
КонецПроцедуры

//  Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаНоменклатураПриИзменении(ИмяТЧ)
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
	
	ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий)
	
	Объект = Форма.Объект;
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		Форма.ИмяФормы, ИмяТЧ));
	
КонецПроцедуры

#КонецОбласти

#Область Серии

//  Процедура - Заполнить параметры указания серий.
//
&НаСервере
Процедура ЗаполнитьПараметрыУказанияСерий()
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питБракеражПродукции));
	
КонецПроцедуры

//  Функция - Параметры формы указания серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущиеДанныеИдентификатор - Произвольный - Текущие данные идентификатор.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор)
	
	Возврат НоменклатураСервер.ПараметрыФормыУказанияСерий(Объект, ПараметрыУказанияСерий[ИмяТЧ], ТекущиеДанныеИдентификатор, ЭтаФорма);
	
КонецФункции

//  Процедура - Открыть подбор серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Текст - Строка - Текст.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ОткрытьПодборСерий(ИмяТЧ, Текст = "", ТекущиеДанные = Неопределено)
	
	НуженСерверныйВызов = НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(
							ЭтаФорма, 
							ПараметрыУказанияСерий[ИмяТЧ], 
							Текст, 
							ТекущиеДанные);
	
	Если НуженСерверныйВызов Тогда
		
		Если ТекущиеДанные = Неопределено Тогда
			ТекущиеДанныеИдентификатор = Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
		Иначе
			ТекущиеДанныеИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		КонецЕсли;
		
		ПараметрыФормыУказанияСерий = ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор);
		ДополнительныеПараметры = Новый Структура("ПараметрыУказанияСерий,ПараметрыФормыУказанияСерий, ИмяТЧ", 
											ПараметрыУказанияСерий[ИмяТЧ], ПараметрыФормыУказанияСерий, ИмяТЧ);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьПодборСерийЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму(ПараметрыФормыУказанияСерий.ИмяФормы, 
						ПараметрыФормыУказанияСерий, 
						ЭтаФорма,,,,
						ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Таблица выбор серии.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Поле - Произвольный - Поле.
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаВыборСерии(ИмяТЧ, Поле, Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекущиеДанные.СтатусУказанияСерий > 0
		И ТекущиеДанные.СтатусУказанияСерий <= 11 Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьПодборСерий(ИмяТЧ, Поле.ТекстРедактирования);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обработать указание серий сервер.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//  ПараметрыФормыУказанияСерий - Произвольный - Параметры формы указания серий.
//
&НаСервере
Процедура ОбработатьУказаниеСерийСервер(Знач ИмяТЧ, Знач ПараметрыУказанияСерий, Знач ПараметрыФормыУказанияСерий)
	
	СтруктураДействий = Неопределено;
	
	НоменклатураСервер.ОбработатьУказаниеСерий(
		Объект, 
		ПараметрыУказанияСерий, 
		ПараметрыФормыУказанияСерий, 
		СтруктураДействий);
	
КонецПроцедуры

//  Процедура - Установить видимость элементов серий.
//
&НаСервере
Процедура УстановитьВидимостьЭлементовСерий()
	
	Элементы.ТоварыСерия.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыУказатьСерии.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	
КонецПроцедуры

//  Процедура - Обновить кешированные значения для учета серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ОбновитьКешированныеЗначенияДляУчетаСерий(ИмяТЧ, Элемент, КэшированныеЗначения, Копирование)
	
	НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(
				Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ], Копирование);
КонецПроцедуры

//  Процедура - Таблица при окончании редактирования.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаПриОкончанииРедактирования(ИмяТЧ, Элемент)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если НоменклатураКлиент.НеобходимоОбновитьСтатусыСерий(
			Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ]) Тогда
		
		ТекущаяСтрокаИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		
		ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(ПараметрыУказанияСерий[ИмяТЧ], ТекущаяСтрокаИдентификатор, КэшированныеЗначения);
		НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ]);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заполнить статусы указания серий при окончании редактирования строки тч.
//
// Параметры:
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//  ТекущаяСтрокаИдентификатор - Строка - Текущая строка идентификатор.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Знач ПараметрыУказанияСерий,
																			ТекущаяСтрокаИдентификатор,
																			КэшированныеЗначения)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Объект, 
				ПараметрыУказанияСерий, ТекущаяСтрокаИдентификатор, КэшированныеЗначения);
	
КонецПроцедуры

//  Процедура - Заполнить статусы указания серий сервер.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтрокиТоваровДляОбработки - Произвольный - Строки товаров для обработки.
//  СтрокиСерийДляОбработки - Произвольный - Строки серий для обработки.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, СтрокиТоваровДляОбработки = Неопределено, СтрокиСерийДляОбработки = Неопределено)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий[ИмяТЧ], СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки);
	
КонецПроцедуры

// Процедуру следует использовать, если строки были добавлены программно (не интерактивно), например, при вставке из
//  буфера, при заполнении по спецификации.
//  Процедура выполняет действия которые зависят от данных в строках.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  МассивИдентификаторовСтрок - Массив - Массив идентификаторов строк.
//  СтруктураРанееВыполненныхДействий - Структура - Структура ранее выполненных действий.
//
&НаСервере
Процедура ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивИдентификаторовСтрок = Неопределено, СтруктураРанееВыполненныхДействий = Неопределено)

	МассивСтрок = Неопределено;
	КоллекцияСтрок = Объект[ИмяТЧ];
	Если МассивИдентификаторовСтрок <> Неопределено Тогда
		МассивСтрок = Новый Массив;
		Для каждого ИдентификаторСтроки Из МассивИдентификаторовСтрок Цикл
			МассивСтрок.Добавить(Объект[ИмяТЧ].НайтиПоИдентификатору(ИдентификаторСтроки));
		КонецЦикла; 
		КоллекцияСтрок = МассивСтрок;
	КонецЕсли;
	
	Если СтруктураРанееВыполненныхДействий = Неопределено Тогда
		СтруктураРанееВыполненныхДействий = Новый Структура;
	КонецЕсли;
	
	Если НЕ СтруктураРанееВыполненныхДействий.Свойство("ПроверитьСериюРассчитатьСтатус") Тогда
		ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, МассивСтрок, МассивСтрок);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Таблица обработка выбора подбора на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаСервере
Процедура ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		СписокТоваров = ВыбранноеЗначение;
	Иначе
		СписокТоваров = Новый Массив;
		СписокТоваров.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	МассивСтрок = Новый Массив;
	Для каждого СтрокаТовара Из СписокТоваров Цикл
		
		ТекущаяСтрока = Объект[ИмяТЧ].Добавить();
		ТекущаяСтрока.Номенклатура = СтрокаТовара;
		
		ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(
				ИмяТЧ, 
				ТекущаяСтрока, 
				ЭтаФорма, 
				СтруктураДействий);
				
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
		
		МассивСтрок.Добавить(ТекущаяСтрока.ПолучитьИдентификатор());
		
	КонецЦикла;
	
	ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивСтрок, СтруктураДействий);
	
КонецПроцедуры

//  Процедура - Таблица обработка выбора.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаКлиенте
Процедура ТаблицаОбработкаВыбора(ИмяТЧ, ВыбранноеЗначение)
	ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ);
КонецПроцедуры

//  Процедура - Добавить в структуру действия по сериям.
//
// Параметры:
//  СтруктураДействий - Структура - Структура действий.
//  Склад - Произвольный - Склад.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Склад, ПараметрыУказанияСерий)
	
	ПараметрыПроверкиСерий = Новый Структура("Склад, ПараметрыУказанияСерий", Склад, ПараметрыУказанияСерий);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПараметрыПроверкиСерий);
	
КонецПроцедуры

//  Процедура - Таблица склад при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИмяСклад - Произвольный - Имя склад.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ТаблицаСкладПриИзменении(ИмяТЧ, ИмяСклад = Неопределено, ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	Если ИмяСклад = Неопределено Тогда
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
	Иначе
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, ТекущиеДанные[ИмяСклад], ПараметрыУказанияСерий[ИмяТЧ]);
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

//  Процедура - Таблица серия при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаСерияПриИзменении(ИмяТЧ)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение						= Элементы[ИмяТЧ].ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки	= Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[ИмяТЧ], ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - При чтении создании на сервере.
//
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЗаполнитьПараметрыУказанияСерий();
	ЗаполнитьСтатусыУказанияСерийСервер("Товары");
	УстановитьВидимостьЭлементовСерий();
	
КонецПроцедуры

//  Процедура - Установить условное оформление.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
		"ТоварыХарактеристика",
		"Объект.Товары.ХарактеристикиИспользуются");
	
	#Область Серии
	
	НоменклатураСервер.УстановитьУсловноеОформлениеСтатусовУказанияСерий(ЭтаФорма, Ложь, "ТоварыСтатусУказанияСерий", "Объект.Товары.СтатусУказанияСерий");
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма, Ложь, "ТоварыСерия", "Объект.Товары.СтатусУказанияСерий", "Объект.Товары.ТипНоменклатуры");
	
	#КонецОбласти
	
КонецПроцедуры

//  Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
КонецПроцедуры

//  Процедура - Подключаемый выполнить команду на сервере.
//
// Параметры:
//  Контекст - Произвольный - Контекст.
//  Результат - Произвольный - Результат.
//
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

//  Процедура - Подключаемый обновить команды.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

//  Процедура - Обработка выбора подбор форма заполнения.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборФормаЗаполнения(ВыбранноеЗначение)
	
	ПолученнаяТаблица = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	Для каждого ПолученнаяСтрока Из ПолученнаяТаблица Цикл
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("КлючСтроки", ПолученнаяСтрока.КлючСтроки));
		Если НайденныеСтроки.Количество() Тогда
			ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], ПолученнаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Обработка выбора подбор заполнить по выпуску блюд.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборЗаполнитьПоВыпускуБлюд(ВыбранноеЗначение)
	Если НЕ ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(ВыбранноеЗначение);
	Иначе
		МассивДокументов = ВыбранноеЗначение
	КонецЕсли;
	Для каждого ТекДокумент Из МассивДокументов Цикл
		Документы.питБракеражПродукции.ЗаполнитьДокументНаОснованииВыпускаБлюд(Объект, ТекДокумент, Истина, Истина);
	КонецЦикла;
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	ПослеИзмененияСтрокТЧПрограммноНаСервере("Товары");
КонецПроцедуры

//  Процедура - Обработка выбора подбор заполнить по плану меню.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборЗаполнитьПоПлануМеню(ВыбранноеЗначение)
	Если НЕ ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(ВыбранноеЗначение);
	Иначе
		МассивДокументов = ВыбранноеЗначение
	КонецЕсли;
	Для каждого ТекДокумент Из МассивДокументов Цикл
		Документы.питБракеражПродукции.ЗаполнитьДокументНаОснованииПланаМеню(Объект, ТекДокумент, Истина, Истина);
	КонецЦикла;
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	ПослеИзмененияСтрокТЧПрограммноНаСервере("Товары");
КонецПроцедуры

//  Функция - Получить таблицу выделенных строк.
//
// Параметры:
//  ВыделенныеСтроки - Произвольный - Выделенные строки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
&НаСервере
Функция ПолучитьТаблицуВыделенныхСтрок(ВыделенныеСтроки)
	
	МассивСтрок = Новый Массив;
	Для каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		ТекСтрока = Объект.Товары.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если НЕ ТекСтрока = Неопределено Тогда
			МассивСтрок.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	ТаблицаТоваров = Объект.Товары.Выгрузить(МассивСтрок);
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаТоваров);
	
КонецФункции

#КонецОбласти



