
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресСтрокиЗаполнить = Неопределено;
	Параметры.Свойство("АдресСтрокиЗаполнить", АдресСтрокиЗаполнить);
	Если НЕ СтрокиЗаполнить = Неопределено Тогда
		СтрокиЗаполнить.Загрузить(ПолучитьИзВременногоХранилища(АдресСтрокиЗаполнить));
	КонецЕсли;
	
	ЗаполнитьТаблицуРеквизитов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТаблицаРеквизитовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДаннные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДаннные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ТаблицаРеквизитовНовоеЗначение.ОграничениеТипа = ТекущиеДаннные.ТипЗначения;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовНовоеЗначениеПриИзменении(Элемент)
	
	ТекущиеДаннные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДаннные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДаннные.Изменить = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	// Перенос данных 
	АдресТаблицы = ПеренестиВСтрокиЗаполнить();
	ОповеститьОВыборе(АдресТаблицы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитов()
	
	ТаблицаСтрок = СтрокиЗаполнить.Выгрузить();
	КолонкиТаблицыСтрок = ТаблицаСтрок.Колонки;
	
	СтрокаРеквизитов = "ДатаИзготовления,ОрганолептическаяОценка,РазрешеноКРеализации,ПодписиЧленовБракеражнойКомиссии,Вес,Примечание";
	СтрокаПредставлений = "Дата изготовления,Органолептическая оценка,Разрешено к реализации,Подписи членов бракеражной комиссии,Вес,Примечание";
	МассивРеквизитов = СтрРазделить(СтрокаРеквизитов, ",");
	МассивПредставлений = СтрРазделить(СтрокаПредставлений, ",");
	Для Сч = 0 По МассивРеквизитов.Количество() - 1 Цикл
		НовСтрокаТаблицы = ТаблицаРеквизитов.Добавить();
		НовСтрокаТаблицы.Реквизит				= МассивРеквизитов[Сч];
		НовСтрокаТаблицы.РеквизитПредставление	= МассивПредставлений[Сч];
		НовСтрокаТаблицы.Изменить				= Ложь;
		НовСтрокаТаблицы.НовоеЗначение			= Неопределено;
		НайденнаяКолонка						= КолонкиТаблицыСтрок.Найти(МассивРеквизитов[Сч]);
		Если НЕ НайденнаяКолонка = Неопределено Тогда
			НовСтрокаТаблицы.ТипЗначения		= НайденнаяКолонка.ТипЗначения;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПеренестиВСтрокиЗаполнить()
	
	РеквизитыИзменить = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Изменить", Истина));
	Для каждого ТекСтрокаРеквизит Из РеквизитыИзменить Цикл
		Для каждого ТекСтрокаСтроки Из СтрокиЗаполнить Цикл
			ТекСтрокаСтроки[ТекСтрокаРеквизит.Реквизит] = ТекСтрокаРеквизит.НовоеЗначение;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(СтрокиЗаполнить.Выгрузить());
	
КонецФункции

#КонецОбласти

