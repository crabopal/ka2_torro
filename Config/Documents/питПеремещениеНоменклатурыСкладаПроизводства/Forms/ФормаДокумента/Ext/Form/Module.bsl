//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область КопированиеВставкаСтрок

//  Процедура - Скопировать строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СкопироватьСтроки(Команда)
	
	ИмяТаблицы = ПолучитьИмяТекущейТабличнойЧасти();
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрок = Элементы[ИмяТаблицы].ВыделенныеСтроки.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СкопироватьСтрокиНаСервере(ИмяТаблицы);
	
	РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОКопированииСтрок(КоличествоСтрок);
	
КонецПроцедуры

//  Процедура - Вставить строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВставитьСтроки(Команда)
	
	ИмяТаблицы = ПолучитьИмяТекущейТабличнойЧасти();
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	КоличествоТоваровДоВставки = Объект[ИмяТаблицы].Количество();
	ПолучитьСтрокиИзБуфераОбмена(ИмяТаблицы);
	КоличествоСтрок = Объект.Товары.Количество()-КоличествоТоваровДоВставки;
	РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОВставкеСтрок(КоличествоСтрок);
	
КонецПроцедуры

#КонецОбласти

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КопированиеВставкаСтрок

//  Процедура - Скопировать строки на сервере.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура СкопироватьСтрокиНаСервере(ИмяТаблицы)
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(Объект[ИмяТаблицы], Элементы[ИмяТаблицы].ВыделенныеСтроки);
	
КонецПроцедуры

//  Процедура - Получить строки из буфера обмена.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена(ИмяТаблицы)
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена();
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТаблицы, СтруктураДействий);
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

//  Функция - Получить имя текущей табличной части.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучитьИмяТекущейТабличнойЧасти()
	
	ИмяТаблицы = "Товары";
	Возврат ИмяТаблицы;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Вид операции при изменении на сервере.
//
&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()
	Если Объект.ХозяйственнаяОперация <> ХозяйственнаяОперацияПред Тогда
		Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
			НоменклатураПриИзмененииАналоги(СтрокаТабличнойЧасти);
		КонецЦикла;
	КонецЕсли;
	ХозяйственнаяОперацияПред = Объект.ХозяйственнаяОперация;
КонецПроцедуры

//  Процедура - Товары номенклатура списание при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыНоменклатураСписаниеПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	
	ТаблицаНоменклатураПриИзменении(СтрокаТабличнойЧасти, "Товары");
	НоменклатураПриИзмененииАналоги(СтрокаТабличнойЧасти);
	
КонецПроцедуры

//  Процедура - Товары номенклатура оприходование при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыНоменклатураОприходованиеПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	
	Если ТипЗнч(ИдентификаторТекущейСтроки) = Тип("ДанныеФормыЭлементКоллекции") Тогда
		СтрокаТабличнойЧасти = ИдентификаторТекущейСтроки;
	Иначе
		СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	КонецЕсли;
	
	ТаблицаНоменклатураПриИзменении(СтрокаТабличнойЧасти, "Товары", "Оприходование");
	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыИзПроизводства") Тогда 
		СтруктураСкладской = ПолучитьДанныеСкладскойНоменклатуры(СтрокаТабличнойЧасти.НоменклатураОприходование, СтрокаТабличнойЧасти.Номенклатура);
		СтрокаТабличнойЧасти.УпаковкаОприходование			= СтруктураСкладской.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.КоэффициентПроизводства		= СтруктураСкладской.Коэффициент;
		ПересчитатьКоличествоОприходованияНаСервере(СтрокаТабличнойЧасти);
		ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
		ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "Оприходование");
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Товары количество при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыКоличествоПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	ПересчитатьКоличествоОприходованияНаСервере(СтрокаТабличнойЧасти);
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "Оприходование");
КонецПроцедуры

//  Процедура - Товары количество оприходование при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыКоличествоОприходованиеПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "Оприходование");
КонецПроцедуры

//  Процедура - Товары упаковка при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыУпаковкаПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	ПересчитатьКоличествоОприходованияНаСервере(СтрокаТабличнойЧасти);
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "Оприходование");
КонецПроцедуры

//  Процедура - Товары упаковка оприходование при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыУпаковкаОприходованиеПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	ПересчитатьКоличествоОприходованияНаСервере(СтрокаТабличнойЧасти);
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "Оприходование");
КонецПроцедуры

#КонецОбласти

#Область Серии

//  Процедура - Заполнить параметры указания серий.
//
&НаСервере
Процедура ЗаполнитьПараметрыУказанияСерий()
	
	ПараметрыУказанияСерий =
		Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питПеремещениеНоменклатурыСкладаПроизводства));
	
КонецПроцедуры

//  Процедура - Установить видимость элементов серий.
//
&НаСервере
Процедура УстановитьВидимостьЭлементовСерий()
	
	Элементы.ТоварыСерияСписание.Видимость = ПараметрыУказанияСерий.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыСерияОприходование.Видимость = ПараметрыУказанияСерий.ИспользоватьСерииНоменклатуры;
	
КонецПроцедуры

//  Процедура - Открыть подбор серий.
//
// Параметры:
//  ЭтоСерияОприходование - Произвольный - Это серия оприходование.
//  Текст - Строка - Текст.
//
&НаКлиенте
Процедура ОткрытьПодборСерий(ЭтоСерияОприходование, Текст = "")
	РедактируетсяСерияОприходование = ЭтоСерияОприходование;
	Если ЭтоСерияОприходование Тогда
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
		
		ТекущаяСтрока = Новый Структура;
		ТекущаяСтрока.Вставить("Номенклатура", ТекущиеДанные.НоменклатураОприходование);
		ТекущаяСтрока.Вставить("Характеристика", ТекущиеДанные.ХарактеристикаОприходование);
		ТекущаяСтрока.Вставить("ХарактеристикиИспользуются", ТекущиеДанные.ХарактеристикиИспользуютсяОприходование);
		ТекущаяСтрока.Вставить("Серия", ТекущиеДанные.СерияОприходование);
		ТекущаяСтрока.Вставить("СтатусУказанияСерий", ТекущиеДанные.СтатусУказанияСерийОприходование);
		ТекущаяСтрока.Вставить("ИдентификаторТекущейСтроки", ТекущиеДанные.ПолучитьИдентификатор());
		ТекущаяСтрока.Вставить("Количество", ТекущиеДанные.КоличествоОприходование);
		
		ТекущаяСтрока.Вставить("Дата", Объект.Дата);
		ТекущаяСтрока.Вставить("Организация", Объект.Организация);
		ТекущаяСтрока.Вставить("Ответственный", Объект.Ответственный);
		ТекущаяСтрока.Вставить("Подразделение", Объект.Подразделение);
		ТекущаяСтрока.Вставить("СкладОтправитель", Объект.СкладПолучатель); // Не опечатка.
		ТекущаяСтрока.Вставить("СкладПолучатель", Объект.СкладПолучатель);
		ТекущаяСтрока.Вставить("Ссылка", Объект.Ссылка);
		
		Если НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(ЭтаФорма,ПараметрыУказанияСерий,Текст,ТекущаяСтрока)Тогда
			ТекстИсключения = НСтр("ru = 'Ошибка при попытке указать серии - в этом документе для указания серий не нужен серверный вызов.';
									|en = 'An error occurred when attempting to specify series. No server call is required to specify series in this document.'");
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
	Иначе
		
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
		
		ТекущаяСтрока = Новый Структура;
		ТекущаяСтрока.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
		ТекущаяСтрока.Вставить("Характеристика", ТекущиеДанные.Характеристика);
		ТекущаяСтрока.Вставить("ХарактеристикиИспользуются", ТекущиеДанные.ХарактеристикиИспользуются);
		ТекущаяСтрока.Вставить("Серия", ТекущиеДанные.Серия);
		ТекущаяСтрока.Вставить("СтатусУказанияСерий", ТекущиеДанные.СтатусУказанияСерий);
		ТекущаяСтрока.Вставить("ИдентификаторТекущейСтроки", ТекущиеДанные.ПолучитьИдентификатор());
		ТекущаяСтрока.Вставить("Количество", ТекущиеДанные.КоличествоОприходование);
		
		ТекущаяСтрока.Вставить("Дата", Объект.Дата);
		ТекущаяСтрока.Вставить("Организация", Объект.Организация);
		ТекущаяСтрока.Вставить("Ответственный", Объект.Ответственный);
		ТекущаяСтрока.Вставить("Подразделение", Объект.Подразделение);
		ТекущаяСтрока.Вставить("СкладОтправитель", Объект.СкладОтправитель);
		ТекущаяСтрока.Вставить("СкладПолучатель", Объект.СкладОтправитель); // Не опечатка.
		ТекущаяСтрока.Вставить("Ссылка", Объект.Ссылка);
		
		Если НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(ЭтаФорма,ПараметрыУказанияСерий,Текст,ТекущаяСтрока)Тогда
			ТекстИсключения = НСтр("ru = 'Ошибка при попытке указать серии - в этом документе для указания серий не нужен серверный вызов.';
									|en = 'An error occurred when attempting to specify series. No server call is required to specify series in this document.'");
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Заполнить статусы указания серий сервер.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтрокиТоваровДляОбработки - Произвольный - Строки товаров для обработки.
//  СтрокиСерийДляОбработки - Произвольный - Строки серий для обработки.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, СтрокиТоваровДляОбработки = Неопределено, СтрокиСерийДляОбработки = Неопределено)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий, СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки);
	
КонецПроцедуры

// Процедуру следует использовать, если строки были добавлены программно (не интерактивно), например, при вставке из
//  буфера, при заполнении по спецификации.
//  Процедура выполняет действия которые зависят от данных в строках.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  МассивИдентификаторовСтрок - Массив - Массив идентификаторов строк.
//  СтруктураРанееВыполненныхДействий - Структура - Структура ранее выполненных действий.
//
&НаСервере
Процедура ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивИдентификаторовСтрок = Неопределено, СтруктураРанееВыполненныхДействий = Неопределено)

	МассивСтрок = Неопределено;
	КоллекцияСтрок = Объект[ИмяТЧ];
	Если МассивИдентификаторовСтрок <> Неопределено Тогда
		МассивСтрок = Новый Массив;
		Для каждого ИдентификаторСтроки Из МассивИдентификаторовСтрок Цикл
			МассивСтрок.Добавить(Объект[ИмяТЧ].НайтиПоИдентификатору(ИдентификаторСтроки));
		КонецЦикла; 
		КоллекцияСтрок = МассивСтрок;
	КонецЕсли;
	
	Если СтруктураРанееВыполненныхДействий = Неопределено Тогда
		СтруктураРанееВыполненныхДействий = Новый Структура;
	КонецЕсли;
	
	Если НЕ СтруктураРанееВыполненныхДействий.Свойство("ПроверитьСериюРассчитатьСтатус") Тогда
		ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, МассивСтрок, МассивСтрок);
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Таблица склад при изменении на сервере.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаСервере
Процедура ТаблицаСкладПриИзмененииНаСервере(ИмяТЧ)
	
	ЗаполнитьПараметрыУказанияСерий();
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для каждого ТекущиеДанные Из Объект.Товары Цикл
		
		СтруктураДействий = Новый Структура;
		ДобавитьВСтруктуруДействияПоСериям(ТекущиеДанные, ЭтаФорма, СтруктураДействий, ПараметрыУказанияСерий);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	
	УстановитьВидимостьЭлементовСерий();
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия по сериям.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПоСериям(ТекущаяСтрока, Форма, СтруктураДействий, ПараметрыУказанияСерий)
	
	Объект = Форма.Объект;
	
	ПараметрыПроверкиСерий = Новый Структура("Склад, ПараметрыУказанияСерий");
	ПараметрыПроверкиСерий.Склад = Новый Структура("Отправитель, Получатель", Объект.СкладОтправитель, Объект.СкладПолучатель);
	ПараметрыПроверкиСерий.ПараметрыУказанияСерий = ПараметрыУказанияСерий;
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПараметрыПроверкиСерий);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - При чтении создании на сервере.
//
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	// Работа с сериями
	ЗаполнитьПараметрыУказанияСерий();
	ЗаполнитьСтатусыУказанияСерийСервер("Товары");
	УстановитьВидимостьЭлементовСерий();
	
	СтруктураКешированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ХозяйственнаяОперацияПред = Объект.ХозяйственнаяОперация;
	
КонецПроцедуры

//  Процедура - Установить условное оформление.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// +Упаковки
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ТоварыНоменклатураЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.Товары.Упаковка";
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ТоварыНоменклатураОприходованиеЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.Товары.УпаковкаОприходование";
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	// -Упаковки
	
	// +Характеристики
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыХарактеристикаСписание.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>';
		|en = '<characteristics are not used>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыХарактеристикаОприходование.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.ХарактеристикиИспользуютсяОприходование");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>';
		|en = '<characteristics are not used>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	// -Характеристики
	
	// +Серии
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыСерияСписание.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.СтатусУказанияСерий");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<серия не указывается>';
		|en = '<series is not specified>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыСерияОприходование.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.СтатусУказанияСерийОприходование");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<серия не указывается>';
		|en = '<series is not specified>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	// -Серии
	
КонецПроцедуры

//  Процедура - Установить заголовок формы.
//
&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1'"),
		?(Объект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство, "Перемещение в номенклатуру производства", "Перемещение в номенклатуру склада"));
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстЗаголовка = ТекстЗаголовка + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru=' %1 от %2'"), Объект.Номер, Формат(Объект.Дата, "ДЛФ=D"));
	Иначе
		ТекстЗаголовка = ТекстЗаголовка + НСтр("ru = ' (создание)'");
	КонецЕсли;
	
	Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

//  Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство") Тогда
		Элементы.ТоварыГруппаСписываемыйТовар.Заголовок = "Списываемый товар (номенклатура склада)";
		Элементы.ТоварыГруппаПриходуемыйТовар.Заголовок = "Приходуемый товар (номенклатура производства)";
	Иначе
		Элементы.ТоварыГруппаСписываемыйТовар.Заголовок = "Списываемый товар (номенклатура производства)";
		Элементы.ТоварыГруппаПриходуемыйТовар.Заголовок = "Приходуемый товар (номенклатура склада)";
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ТекущиеДанные - Произвольный - Текущие данные.
//  ИмяТЧ - Произвольный - Имя тч.
//  Суффикс - Строка - Суффикс.
//
&НаСервере
Процедура ТаблицаНоменклатураПриИзменении(ТекущиеДанные, ИмяТЧ, Суффикс = "")
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Суффикс) Тогда
		ТекущаяСтрока = ТекущиеДанные;
	Иначе
		ТекущаяСтрока = Новый Структура;
		ТекущаяСтрока.Вставить("Номенклатура", ТекущиеДанные.НоменклатураОприходование);
		ТекущаяСтрока.Вставить("НоменклатураОприходование", ТекущиеДанные.НоменклатураОприходование);
		ТекущаяСтрока.Вставить("Характеристика", ТекущиеДанные.ХарактеристикаОприходование);
		ТекущаяСтрока.Вставить("ХарактеристикиИспользуются", ТекущиеДанные.ХарактеристикиИспользуютсяОприходование);
		ТекущаяСтрока.Вставить("Упаковка", ТекущиеДанные.УпаковкаОприходование);
		ТекущаяСтрока.Вставить("Серия", ТекущиеДанные.СерияОприходование);
		ТекущаяСтрока.Вставить("СтатусУказанияСерий", ТекущиеДанные.СтатусУказанияСерийОприходование);
		ТекущаяСтрока.Вставить("ТипНоменклатуры", ТекущиеДанные.ТипНоменклатурыОприходование);
		ТекущаяСтрока.Вставить("Артикул", ТекущиеДанные.АртикулОприходование);
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий, ПараметрыУказанияСерий);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, СтруктураКешированныеЗначения);
	
	Если НЕ ПустаяСтрока(Суффикс) Тогда
		
		ТекущиеДанные.ХарактеристикаОприходование				= ТекущаяСтрока.Характеристика;
		ТекущиеДанные.ХарактеристикиИспользуютсяОприходование	= ТекущаяСтрока.ХарактеристикиИспользуются;
		ТекущиеДанные.ТипНоменклатурыОприходование				= ТекущаяСтрока.ТипНоменклатуры;
		ТекущиеДанные.АртикулОприходование						= ТекущаяСтрока.Артикул;
		
	КонецЕсли;
	
	ТекущаяСтрока = ТекущиеДанные;
	СтруктураДействий = Новый Структура;
	ДобавитьВСтруктуруДействияПоСериям(ТекущаяСтрока, ЭтаФорма, СтруктураДействий, ПараметрыУказанияСерий);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, СтруктураКешированныеЗначения);
	
КонецПроцедуры

//  Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура, НоменклатураОприходование", "ТипНоменклатуры", "ТипНоменклатурыОприходование"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура, НоменклатураОприходование", "ХарактеристикиИспользуются", "ХарактеристикиИспользуютсяОприходование"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура, НоменклатураОприходование", "Артикул", "АртикулОприходование"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары,ПараметрыЗаполненияРеквизитов);
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий, ПараметрыУказанияСерий)
	
	Объект = Форма.Объект;
	
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
	Новый Структура("Номенклатура", "ТипНоменклатуры"));
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
	Форма.ИмяФормы, ИмяТЧ));
	
КонецПроцедуры

//  Процедура - Номенклатура при изменении аналоги.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//
&НаСервере
Процедура НоменклатураПриИзмененииАналоги(СтрокаТабличнойЧасти)

	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство") Тогда
		
		СтруктураАналога =  ПолучитьПроизводственнуюНоменклатуруПоСкладской(СтрокаТабличнойЧасти.Номенклатура);
		Если СтруктураАналога = Неопределено Тогда
			// Ничего не нашли, заполняем самим сабой
			СтрокаТабличнойЧасти.НоменклатураОприходование		= СтрокаТабличнойЧасти.Номенклатура;
			СтрокаТабличнойЧасти.УпаковкаОприходование			= СтрокаТабличнойЧасти.Упаковка;
			ТоварыНоменклатураОприходованиеПриИзмененииНаСервере(СтрокаТабличнойЧасти);
			СтрокаТабличнойЧасти.КоэффициентПроизводства		= 1;
			СтрокаТабличнойЧасти.КоличествоОприходование		= СтрокаТабличнойЧасти.Количество;
			СтрокаТабличнойЧасти.КоличествоУпаковокОприходование= СтрокаТабличнойЧасти.Количество;
		Иначе
			СтрокаТабличнойЧасти.НоменклатураОприходование		= СтруктураАналога.Номенклатура;
			СтрокаТабличнойЧасти.УпаковкаОприходование			= СтруктураАналога.ЕдиницаИзмерения;
			ТоварыНоменклатураОприходованиеПриИзмененииНаСервере(СтрокаТабличнойЧасти);
			СтрокаТабличнойЧасти.КоэффициентПроизводства		= СтруктураАналога.Коэффициент;
			ПересчитатьКоличествоОприходованияНаСервере(СтрокаТабличнойЧасти);
			ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
			ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "Оприходование");
		КонецЕсли;
		Элементы.ТоварыНоменклатураОприходование.ТолькоПросмотр = Истина;
		
	ИначеЕсли Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыИзПроизводства") Тогда
		
		СтруктураАналога =  ПолучитьСписокСкладскойНоменклатурыПоПроизводственной(СтрокаТабличнойЧасти.Номенклатура);
		Если СтруктураАналога.Коэффициент < 0 Тогда // Не нашли подставляем самого себя
			СтрокаТабличнойЧасти.НоменклатураОприходование		= СтрокаТабличнойЧасти.Номенклатура;
			СтрокаТабличнойЧасти.УпаковкаОприходование			= СтрокаТабличнойЧасти.Упаковка;
			ТоварыНоменклатураОприходованиеПриИзмененииНаСервере(СтрокаТабличнойЧасти);
			СтрокаТабличнойЧасти.КоэффициентПроизводства		= 1;
			СтрокаТабличнойЧасти.КоличествоУпаковокОприходование= СтрокаТабличнойЧасти.Количество;
			СтрокаТабличнойЧасти.КоличествоОприходование		= СтрокаТабличнойЧасти.Количество;
			Элементы.ТоварыНоменклатураОприходование.СписокВыбора.Очистить();
			Элементы.ТоварыНоменклатураОприходование.СписокВыбора.Добавить(СтрокаТабличнойЧасти.Номенклатура);
			Элементы.ТоварыНоменклатураОприходование.РежимВыбораИзСписка = Ложь;
		Иначе
			СтрокаТабличнойЧасти.НоменклатураОприходование		= СтруктураАналога.Номенклатура;
			СтрокаТабличнойЧасти.УпаковкаОприходование			= СтруктураАналога.ЕдиницаИзмерения;
			ТоварыНоменклатураОприходованиеПриИзмененииНаСервере(СтрокаТабличнойЧасти);
			СтрокаТабличнойЧасти.КоэффициентПроизводства		= СтруктураАналога.Коэффициент;
			ПересчитатьКоличествоОприходованияНаСервере(СтрокаТабличнойЧасти);
			ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
			ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "Оприходование");
			Элементы.ТоварыНоменклатураОприходование.СписокВыбора.Очистить();
			Для каждого Стр Из СтруктураАналога.Список Цикл
				Элементы.ТоварыНоменклатураОприходование.СписокВыбора.Добавить(Стр.Значение);
			КонецЦикла; 
			Элементы.ТоварыНоменклатураОприходование.РежимВыбораИзСписка = Истина;
		КонецЕсли; 
		Элементы.ТоварыНоменклатураОприходование.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Пересчитать количество оприходования на сервере.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//
&НаСервере
Процедура ПересчитатьКоличествоОприходованияНаСервере(СтрокаТабличнойЧасти)
	КоэффициентУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаТабличнойЧасти.Номенклатура, СтрокаТабличнойЧасти.Упаковка, СтруктураКешированныеЗначения);
	КоэффициентУпаковкиОприходование = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаТабличнойЧасти.НоменклатураОприходование, СтрокаТабличнойЧасти.УпаковкаОприходование, СтруктураКешированныеЗначения);
	Если СтрокаТабличнойЧасти.КоэффициентПроизводства = 0 
		ИЛИ КоэффициентУпаковкиОприходование = 0 Тогда
		СтрокаТабличнойЧасти.КоличествоУпаковокОприходование = 0;
	ИначеЕсли Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство") Тогда
		СтрокаТабличнойЧасти.КоличествоУпаковокОприходование = (СтрокаТабличнойЧасти.КоличествоУпаковок * СтрокаТабличнойЧасти.КоэффициентПроизводства) * (КоэффициентУпаковки / КоэффициентУпаковкиОприходование);
	ИначеЕсли  Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыИзПроизводства") Тогда
		СтрокаТабличнойЧасти.КоличествоУпаковокОприходование = (СтрокаТабличнойЧасти.КоличествоУпаковок / СтрокаТабличнойЧасти.КоэффициентПроизводства) * (КоэффициентУпаковки / КоэффициентУпаковкиОприходование);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Посчитать количества вединицах хранения.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//  Суффикс - Произвольный - Суффикс.
//
&НаСервере
Процедура ПосчитатьКоличестваВединицахХранения(ТекущаяСтрока, Суффикс)
	
	СтруктураДействий = Новый Структура;
	СтруктураСуффикса = Новый Структура("Суффикс, НужноОкруглять", Суффикс, Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", СтруктураСуффикса);
	
	СтрокаСтруктурыДляПересчета = СтрЗаменить("Номенклатура,Упаковка,Количество%Суффикс%,КоличествоУпаковок%Суффикс%", "%Суффикс%", Суффикс);
	СтруктураДляПересчета = Новый Структура(СтрокаСтруктурыДляПересчета);
	ЗаполнитьЗначенияСвойств(СтруктураДляПересчета, ТекущаяСтрока);
	СтруктураДляПересчета.Номенклатура = ТекущаяСтрока["Номенклатура" + Суффикс];
	СтруктураДляПересчета.Упаковка = ТекущаяСтрока["Упаковка" + Суффикс];
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтруктураДляПересчета, СтруктураДействий, СтруктураКешированныеЗначения);
	ТекущаяСтрока["Количество" + Суффикс] = Окр(СтруктураДляПересчета["Количество" + Суффикс], 3);
	ТекущаяСтрока["КоличествоУпаковок" + Суффикс] = СтруктураДляПересчета["КоличествоУпаковок" + Суффикс];
	
КонецПроцедуры

//  Функция - Получить производственную номенклатуру по складской.
//
// Параметры:
//  ТоварыНоменклатура - Произвольный - Товары номенклатура.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьПроизводственнуюНоменклатуруПоСкладской(ТоварыНоменклатура)
	Возврат питНоменклатураПроизводства.ПолучитьПроизводственнуюНоменклатуруПоСкладской(ТоварыНоменклатура);
КонецФункции

//  Функция - Получить список складской номенклатуры по производственной.
//
// Параметры:
//  Аналог - Произвольный - Аналог.
//
// Возвращаемое значение:
//  СписокЗначений - Результат обработки.
//
&НаСервере
Функция ПолучитьСписокСкладскойНоменклатурыПоПроизводственной(Аналог)
	Возврат питНоменклатураПроизводства.ПолучитьСписокСкладскойНоменклатурыПоПроизводственной(Аналог);
КонецФункции

//  Функция - Получить данные складской номенклатуры.
//
// Параметры:
//  НоменклатураОприходование - Произвольный - Номенклатура оприходование.
//  Номенклатура - Произвольный - Номенклатура.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьДанныеСкладскойНоменклатуры(НоменклатураОприходование, Номенклатура)
	Возврат питНоменклатураПроизводства.ПолучитьДанныеСкладскойНоменклатуры(НоменклатураОприходование, Номенклатура);
КонецФункции

//  Процедура - Подключаемый выполнить команду на сервере.
//
// Параметры:
//  Контекст - Произвольный - Контекст.
//  Результат - Произвольный - Результат.
//
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

//  Процедура - Подключаемый обновить команды.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении количества упаковок.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчета);
	
КонецПроцедуры

#КонецОбласти



