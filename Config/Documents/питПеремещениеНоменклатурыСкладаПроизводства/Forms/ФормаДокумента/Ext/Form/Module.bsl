&НаКлиенте
Перем РедактируетсяСерияОприходование; // Используется для определения, что форма подбора серий вызвана для серии оприходования.

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	УстановитьУсловноеОформление();
	
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	УстановитьЗаголовокФормы();
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
КонецПроцедуры

//  Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	ЗаполнитьПараметрыУказанияСерий();
	УстановитьЗаголовокФормы();
	УправлениеФормой(ЭтаФорма);
	УстановитьВидимостьЭлементовСерий();
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
		
		Если РедактируетсяСерияОприходование Тогда
			ТекущиеДанные = Элементы.Товары.ДанныеСтроки(ВыбранноеЗначение.ИдентификаторТекущейСтроки);
			
			ТекущаяСтрока = Новый Структура;
			ТекущаяСтрока.Вставить("Серия", ТекущиеДанные.СерияОприходование);
			ТекущаяСтрока.Вставить("СтатусУказанияСерий", ТекущиеДанные.СтатусУказанияСерийОприходование);
			
			НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий, ВыбранноеЗначение, ТекущаяСтрока);
			
			ТекущиеДанные.СерияОприходование               = ТекущаяСтрока.Серия;
			ТекущиеДанные.СтатусУказанияСерийОприходование = ТекущаяСтрока.СтатусУказанияСерий;
			
		Иначе
			НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий, ВыбранноеЗначение);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Склад источник при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СкладИсточникПриИзменении(Элемент)
	ТаблицаСкладПриИзмененииНаСервере("Товары");
КонецПроцедуры

//  Процедура - Склад приемник при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СкладПриемникПриИзменении(Элемент)
	ТаблицаСкладПриИзмененииНаСервере("Товары");
КонецПроцедуры

//  Процедура - Вид операции при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	УстановитьЗаголовокФормы();
	УправлениеФормой(ЭтаФорма);
	ВидОперацииПриИзмененииНаСервере();
КонецПроцедуры

//  Процедура - Товары номенклатура списание при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураСписаниеПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.Товары.ТекущаяСтрока;
	ТоварыНоменклатураСписаниеПриИзмененииНаСервере(ИдентификаторТекущейСтроки);
КонецПроцедуры

//  Процедура - Товары номенклатура оприходование при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураОприходованиеПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.Товары.ТекущаяСтрока;
	ТоварыНоменклатураОприходованиеПриИзмененииНаСервере(ИдентификаторТекущейСтроки);
КонецПроцедуры

//  Процедура - Товары серия списание начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСерияСписаниеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий(Ложь, Элемент.ТекстРедактирования);
КонецПроцедуры

//  Процедура - Товары серия оприходование начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСерияОприходованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий(Истина, Элемент.ТекстРедактирования);
КонецПроцедуры

//  Процедура - Товары серия списание при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСерияСписаниеПриИзменении(Элемент)
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение            		 = Элементы.Товары.ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки = Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий, ВыбранноеЗначение);
КонецПроцедуры

//  Процедура - Товары серия оприходование при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСерияОприходованиеПриИзменении(Элемент)
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	ВыбранноеЗначение.Значение            		 = ТекущиеДанные.СерияОприходование;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	
	ТекущаяСтрока = Новый Структура;
	ТекущаяСтрока.Вставить("Серия", ТекущиеДанные.СерияОприходование);
	ТекущаяСтрока.Вставить("СтатусУказанияСерий", ТекущиеДанные.СтатусУказанияСерийОприходование);
	ТекущаяСтрока.Вставить("Количество", ТекущиеДанные.КоличествоОприходование);
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий, ВыбранноеЗначение, ТекущаяСтрока);
	
	ТекущиеДанные.СерияОприходование               = ТекущаяСтрока.Серия;
	ТекущиеДанные.СтатусУказанияСерийОприходование = ТекущаяСтрока.СтатусУказанияСерий;
КонецПроцедуры

//  Процедура - Товары количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.Товары.ТекущаяСтрока;
	ТоварыКоличествоПриИзмененииНаСервере(ИдентификаторТекущейСтроки);
КонецПроцедуры

//  Процедура - Товары количество оприходование при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоОприходованиеПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.Товары.ТекущаяСтрока;
	ТоварыКоличествоОприходованиеПриИзмененииНаСервере(ИдентификаторТекущейСтроки);
КонецПроцедуры

//  Процедура - Товары упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыУпаковкаПриИзменении(Элемент)
	ТоварыУпаковкаПриИзмененииНаСервере(Элементы.Товары.ТекущаяСтрока);
КонецПроцедуры

//  Процедура - Товары упаковка оприходование при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыУпаковкаОприходованиеПриИзменении(Элемент)
	ТоварыУпаковкаОприходованиеПриИзмененииНаСервере(Элементы.Товары.ТекущаяСтрока);
КонецПроцедуры

//  Процедура - Товары при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат 
	КонецЕсли; 
	
	Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство") Тогда
		Элементы.ТоварыНоменклатураОприходование.ТолькоПросмотр = Истина;
	ИначеЕсли  Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыИзПроизводства") Тогда
		СтруктураАналога = ПолучитьСписокСкладскойНоменклатурыПоПроизводственной(ТекДанные.Номенклатура);
		Элементы.ТоварыНоменклатураОприходование.СписокВыбора.Очистить();
		Для каждого Стр Из СтруктураАналога.Список Цикл
			Элементы.ТоварыНоменклатураОприходование.СписокВыбора.Добавить(Стр.Значение);
		КонецЦикла; 
		Элементы.ТоварыНоменклатураОприходование.РежимВыбораИзСписка = Истина;
		Элементы.ТоварыНоменклатураОприходование.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
