#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Устанавливает статус для объекта документа
//
// Параметры:
//  НовыйСтатус - Строка - Имя статуса, который будет установлен у заказо.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
// 	Булево - Истина, в случае успешной установки нового статуса.
Функция УстановитьСтатус(НовыйСтатус, ДополнительныеПараметры) Экспорт
	
	Статус = Перечисления.питСтатусыЗаказовНаПеремещениеВНоменклатуруПроизводства[НовыйСтатус];
	
	Возврат ПроверитьЗаполнение();
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Процедура - Обработка заполнения.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  ТекстЗаполнения - Произвольный - Текст заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ИнициализироватьДокумент(ДанныеЗаполнения);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированныйУчетПодсистемы") Тогда
		МодульЗаполнениеДокументов = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеДокументов");
		МодульЗаполнениеДокументов.Заполнить(ЭтотОбъект, ДанныеЗаполнения, Ложь);
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.питЗаказНаПеремещениеВНоменклатуруПроизводства") Тогда
		
		ЗаполнитьДокументНаОснованииЗаказаНаПеремещениеВНоменклатуруПроизводства(ДанныеЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	// +Характеристики
	ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект,МассивНепроверяемыхРеквизитов,Отказ,ПараметрыПроверки);
	ПараметрыПроверки.ИменаПолейССуффиксом.Вставить("Номенклатура", "НоменклатураОприходование");
	ПараметрыПроверки.ИменаПолейССуффиксом.Вставить("Характеристика", "ХарактеристикаОприходование");
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект,МассивНепроверяемыхРеквизитов,Отказ,ПараметрыПроверки);
	// -Характеристики
	
	// +Серии
	НоменклатураСервер.ПроверитьЗаполнениеСерий(ЭтотОбъект,
		НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.питПеремещениеНоменклатурыСкладаПроизводства),
		Отказ,
		МассивНепроверяемыхРеквизитов);
	// -Серии
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

// Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	// +Серии
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект,
		НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.питПеремещениеНоменклатурыСкладаПроизводства));
	// -Серии
	
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	
КонецПроцедуры

// Процедура - При записи.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеДокументов.ПриЗаписиДокумента(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Процедура - Обработка проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Если обмен данными, то ничего не делаем.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// +%ИзЕРП% Набор типовых процедур для обработки проведения документа.
	
	ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ);
	
	// -%ИзЕРП%
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура - Заполнить документ на основании заказа на перемещение в номенклатуру производства.
//
// Параметры:
//  Знач ДокументОснование - Произвольный - Знач документ основание.
//
Процедура ЗаполнитьДокументНаОснованииЗаказаНаПеремещениеВНоменклатуруПроизводства(Знач ДокументОснование)
	
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство) КАК ХозяйственнаяОперация,
	|	Документ.Ссылка КАК ДокументИсточник,
	|	Документ.Организация КАК Организация,
	|	Документ.Подразделение КАК Подразделение,
	|	Документ.Валюта КАК Валюта,
	|	Документ.СкладОтправитель КАК СкладОтправитель,
	|	Документ.СкладПолучатель КАК СкладПолучатель,
	|	Документ.Представление КАК Представление,
	|	Документ.Назначение КАК Назначение,
	|	Документ.ЖелаемаяДатаПоступления КАК ЖелаемаяДатаПоступления,
	|	Документ.ДлительностьПеремещения КАК ДлительностьПеремещения,
	|	Документ.ИспользоватьДлительностьПеремещения КАК ИспользоватьДлительностьПеремещения,
	|	Документ.ПеремещениеПодДеятельность КАК ПеремещениеПодДеятельность
	|ИЗ
	|	Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументОснованиеТовары.Ссылка КАК Ссылка,
	|	ДокументОснованиеТовары.Номенклатура КАК Номенклатура,
	|	ДокументОснованиеТовары.Характеристика КАК Характеристика,
	|	ДокументОснованиеТовары.Назначение КАК Назначение,
	|	ДокументОснованиеТовары.Количество КАК Количество,
	|	ДокументОснованиеТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ДокументОснованиеТовары.Упаковка КАК Упаковка,
	|	ДокументОснованиеТовары.КлючСтроки КАК КлючСтроки
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства.Товары КАК ДокументОснованиеТовары
	|ГДЕ
	|	ДокументОснованиеТовары.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументОснованиеТовары.Ссылка КАК Ссылка,
	|	ДокументОснованиеТовары.Номенклатура КАК Номенклатура,
	|	ДокументОснованиеТовары.Характеристика КАК Характеристика,
	|	ВЫБОР КОГДА ДокументОснованиеТовары.Обособленно ТОГДА
	|			ДокументОснованиеТовары.Назначение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		КОНЕЦ КАК Назначение,
	|	ДокументОснованиеТовары.Количество КАК Количество,
	|	ДокументОснованиеТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ДокументОснованиеТовары.Упаковка КАК Упаковка,
	|	ДокументОснованиеТовары.КоэффициентПроизводства КАК КоэффициентПроизводства,
	|	ДокументОснованиеТовары.КлючЗапасов КАК КлючЗапасов,
	|	ДокументОснованиеТовары.ВариантОбеспечения КАК ВариантОбеспечения
	|ПОМЕСТИТЬ втТоварыСкладские
	|ИЗ
	|	Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства.ТоварыСкладские КАК ДокументОснованиеТовары
	|ГДЕ
	|	ДокументОснованиеТовары.Ссылка = &ДокументОснование
	|	И ДокументОснованиеТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументОснованиеТовары.Номенклатура КАК НоменклатураОприходование,
	|	ДокументОснованиеТовары.Характеристика КАК ХарактеристикаОприходование,
	|	ДокументОснованиеТовары.Назначение КАК НазначениеОприходование,
	|	ДокументОснованиеТовары.Упаковка КАК УпаковкаОприходование,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.Количество, 0) * ЕСТЬNULL(ДокументОснованиеТоварыСкладские.КоэффициентПроизводства, 1) КАК КоличествоОприходование,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.КоличествоУпаковок, 0) * ЕСТЬNULL(ДокументОснованиеТоварыСкладские.КоэффициентПроизводства, 1) КАК КоличествоУпаковокОприходование,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.КоэффициентПроизводства, 1) КАК КоэффициентПроизводства,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.Назначение, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Назначение,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.КоличествоУпаковок, 0) КАК КоличествоУпаковок,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Упаковка,
	|	ЕСТЬNULL(ДокументОснованиеТоварыСкладские.ВариантОбеспечения, ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)) КАК ВариантОбеспечения
	|ИЗ
	|	втТовары КАК ДокументОснованиеТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТоварыСкладские КАК ДокументОснованиеТоварыСкладские
	|		ПО ДокументОснованиеТовары.КлючСтроки = ДокументОснованиеТоварыСкладские.КлючЗапасов";
		
		
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	
	// Шапка.
	ВыборкаШапка = РезультатЗапросаПакет[0].Выбрать();
	ВыборкаШапка.Следующий();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	
	СтруктураКешированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	// Товары.
	Товары.Очистить();
	РезультатЗапроса = РезультатЗапросаПакет[3];
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НовСтрокаТовары = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаТовары, ВыборкаДетальныеЗаписи);
			НовСтрокаТовары.Назначение = Неопределено; // Не копируем назначение складской номенклатуры из заказа
			Если НЕ ЗначениеЗаполнено(НовСтрокаТовары.Номенклатура) Тогда
				НовСтрокаТовары.КоличествоУпаковокОприходование = ВыборкаДетальныеЗаписи.КоличествоУпаковок;
				НовСтрокаТовары.КоличествоОприходование = ВыборкаДетальныеЗаписи.Количество;
				НовСтрокаТовары.КоэффициентПроизводства = 1;
			КонецЕсли;
			// Учитываем коэффициенты упаковок.
			КоэффициентУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ВыборкаДетальныеЗаписи.Номенклатура, ВыборкаДетальныеЗаписи.Упаковка, СтруктураКешированныеЗначения);
			КоэффициентУпаковкиОприходование = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ВыборкаДетальныеЗаписи.НоменклатураОприходование, ВыборкаДетальныеЗаписи.УпаковкаОприходование, СтруктураКешированныеЗначения);
			Если КоэффициентУпаковки <> КоэффициентУпаковкиОприходование Тогда
				НовСтрокаТовары.КоличествоУпаковокОприходование = НовСтрокаТовары.КоличествоУпаковокОприходование * КоэффициентУпаковки / КоэффициентУпаковкиОприходование;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЭтотОбъект.Комментарий = "Создан на основании документа: <"+ВыборкаШапка.Представление+">";
	
КонецПроцедуры

// Процедура - Инициализировать документ.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный		= Пользователи.ТекущийПользователь();
	Валюта				= питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета(Валюта);
	Организация			= ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	Склад				= ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Склад, Ложь, Истина);
	СтатьяКалькуляции	= питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СтатьяКалькуляцииПоУмолчанию");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли




