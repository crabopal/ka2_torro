#Область СозданиеНаОсновании

// Определяет список команд создания на основании.
//
// Параметры:
//  КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//   См. описание 1 параметра процедуры
//   СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//  Параметры - Структура - Вспомогательные параметры. Для чтения.
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	Документы.УстановкаЦенНоменклатуры.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
КонецПроцедуры

// Добавляет команду создания документа "Пересчет товаров".
//
// Параметры:
//  КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	Если ПравоДоступа("Добавление", Метаданные.Документы.питПеремещениеНоменклатурыСкладаПроизводства) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.питПеремещениеНоменклатурыСкладаПроизводства.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = ОбщегоНазначенияУТ.ПредставлениеОбъекта(Метаданные.Документы.питПеремещениеНоменклатурыСкладаПроизводства);
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		
		
		
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область Серии

// Имена реквизитов, от значений которых зависят параметры указания серий
//
// Возвращаемое значение:
// 		Строка - имена реквизитов, перечисленные через запятую.
Функция ИменаРеквизитовДляЗаполненияПараметровУказанияСерий() Экспорт
	ИменаРеквизитов = "СкладОтправитель,СкладПолучатель,Дата";
	Возврат ИменаРеквизитов;
КонецФункции

// Возвращает параметры указания серий для товаров, указанных в документе.
//
// Параметры:
//  Объект - Структура - структура значений реквизитов объекта, необходимых для заполнения параметров указания серий.
//
// Возвращаемое значение:
//  Структура - состав полей задается в функции ОбработкаТабличнойЧастиКлиентСервер.ПараметрыУказанияСерий.
Функция ПараметрыУказанияСерий(Объект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыУказанияСерий = НоменклатураКлиентСервер.ПараметрыУказанияСерий();
	ПараметрыУказанияСерий.ПолноеИмяОбъекта = "Документ.питПеремещениеНоменклатурыСкладаПроизводства";
	
	ПараметрыСерийСкладаОтправитель = СкладыСервер.ИспользованиеСерийНаСкладе(Объект.СкладОтправитель, Ложь);
	ПараметрыСерийСкладаПолучатель  = СкладыСервер.ИспользованиеСерийНаСкладе(Объект.СкладПолучатель, Ложь);
	
	ИспользоватьОрдернуюСхемуПолучатель  = СкладыСервер.ИспользоватьОрдернуюСхемуПриПоступлении(Объект.СкладПолучатель, Объект.Дата, Ложь);
	ИспользоватьОрдернуюСхемуОтправитель = СкладыСервер.ИспользоватьОрдернуюСхемуПриОтгрузке(Объект.СкладОтправитель, Объект.Дата);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ПараметрыУказанияСерий.ИмяТЧСерии = "Товары";
	
	ПараметрыУказанияСерий.ИспользоватьСерииНоменклатуры = ПараметрыСерийСкладаОтправитель.ИспользоватьСерииНоменклатуры
		Или (ПараметрыСерийСкладаПолучатель.ИспользоватьСерииНоменклатуры
		И Не ИспользоватьОрдернуюСхемуПолучатель)
		Или ПараметрыСерийСкладаПолучатель.УчитыватьСебестоимостьПоСериям;
	
	ПараметрыУказанияСерий.УчитыватьСебестоимостьПоСериям = ПараметрыСерийСкладаОтправитель.УчитыватьСебестоимостьПоСериям
		Или ПараметрыСерийСкладаПолучатель.УчитыватьСебестоимостьПоСериям;
	
	ПараметрыУказанияСерий.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ОтгрузкаПоПеремещению);
	ПараметрыУказанияСерий.СкладскиеОперации.Добавить(Перечисления.СкладскиеОперации.ПриемкаПоПеремещению);
	
	ПараметрыУказанияСерий.ПоляСвязи.Добавить("НоменклатураОприходование");
	ПараметрыУказанияСерий.ПоляСвязи.Добавить("ХарактеристикаОприходование");
	ПараметрыУказанияСерий.ПоляСвязи.Добавить("Назначение");
	ПараметрыУказанияСерий.ПоляСвязи.Добавить("НазначениеОприходование");
	
	ПараметрыУказанияСерий.ЭтоНакладная = Истина;
	
	ПараметрыУказанияСерий.ИмяПоляСклад = "СкладОтправитель";
	ПараметрыУказанияСерий.ИмяПоляСкладОтправитель = "СкладОтправитель";
	ПараметрыУказанияСерий.ИмяПоляСкладПолучатель  = "СкладПолучатель";
	
	ПараметрыУказанияСерий.ПланированиеОтгрузки = Ложь;
	ПараметрыУказанияСерий.ПланированиеОтбора   = Ложь;
	ПараметрыУказанияСерий.ФактОтбора           = Истина;
	// ПараметрыУказанияСерий.ТолькоСерииДляСебестоимости = Истина;
	ПараметрыУказанияСерий.РегистрироватьСерии = НоменклатураКлиентСервер.НеобходимоРегистрироватьСерии(ПараметрыУказанияСерий);
	ПараметрыУказанияСерий.Дата = Объект.Дата;
	
	ПараметрыУказанияСерий.ИменаПолейССуффиксом.Вставить("Номенклатура",	"НоменклатураОприходование");
	ПараметрыУказанияСерий.ИменаПолейССуффиксом.Вставить("Характеристика",	"ХарактеристикаОприходование");
	ПараметрыУказанияСерий.ИменаПолейССуффиксом.Вставить("Серия",			"СерияОприходование");
	
	ПараметрыУказанияСерий.ИменаПолейСтатусУказанияСерий.Добавить("СтатусУказанияСерий");
	ПараметрыУказанияСерий.ИменаПолейСтатусУказанияСерий.Добавить("СтатусУказанияСерийОприходование");
	ПараметрыУказанияСерий.ОсобеннаяПроверкаСтатусовУказанияСерий = Истина;
	
	ПараметрыУказанияСерий.СоответствиеИмениПоляСерияСтатусуУказанияСерий.Вставить("СтатусУказанияСерий", "Серия");
	ПараметрыУказанияСерий.СоответствиеИмениПоляСерияСтатусуУказанияСерий.Вставить("СтатусУказанияСерийОприходование",
																					"СерияОприходование");
	
	ПараметрыУказанияСерий.ИмяИсточникаЗначенийВФормеОбъекта = "ТекущиеДанные";
	
	Возврат ПараметрыУказанияСерий;
КонецФункции

// Возвращает текст запроса для расчета статусов указания серий
//
// Параметры:
//  ПараметрыУказанияСерий - Структура - состав полей задается в функци.
//
// Возвращаемое значение:
//  Строка - текст запроса
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерий(ПараметрыУказанияСерий) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия,
	|	Товары.НоменклатураОприходование КАК НоменклатураОприходование,
	|	Товары.ХарактеристикаОприходование КАК ХарактеристикаОприходование,
	|	Товары.СерияОприходование КАК СерияОприходование,
	|	Товары.Количество КАК Количество,
	|	Товары.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	Товары.СтатусУказанияСерийОприходование КАК СтатусУказанияСерийОприходование,
	|	Товары.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.СтатусУказанияСерий КАК СтарыйСтатусУказанияСерий,
	|	Товары.СтатусУказанияСерийОприходование КАК СтарыйСтатусУказанияСерийОприходование,
	|	ВЫБОР
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий ЕСТЬ NULL
	|			ТОГДА 0
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 14
	|					ИНАЧЕ 13
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтгрузки
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 10
	|					ИНАЧЕ 9
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПланированииОтбора
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 8
	|					ИНАЧЕ 7
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПриемке
	|				И ПолитикиУчетаСерий.ПолитикаУчетаСерий.УказыватьПриПриемкеПродукцииИзПроизводства
	|			ТОГДА ВЫБОР
	|					КОГДА ПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьОстаткиСерий
	|						ТОГДА ВЫБОР
	|								КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|									ТОГДА 4
	|								ИНАЧЕ 3
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|								ТОГДА 2
	|							ИНАЧЕ 1
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтатусУказанияСерий,
	|	ВЫБОР
	|		КОГДА ПолитикиУчетаСерийОприходование.ПолитикаУчетаСерий ЕСТЬ NULL
	|			ТОГДА 0
	|		КОГДА ПолитикиУчетаСерийОприходование.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 14
	|					ИНАЧЕ 13
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерийОприходование.ПолитикаУчетаСерий.УказыватьПриПланированииОтгрузки
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 10
	|					ИНАЧЕ 9
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерийОприходование.ПолитикаУчетаСерий.УказыватьПриПланированииОтбора
	|			ТОГДА ВЫБОР
	|					КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|						ТОГДА 8
	|					ИНАЧЕ 7
	|				КОНЕЦ
	|		КОГДА ПолитикиУчетаСерийОприходование.ПолитикаУчетаСерий.УказыватьПриПриемке
	|				И ПолитикиУчетаСерийОприходование.ПолитикаУчетаСерий.УказыватьПриПриемкеПродукцииИзПроизводства
	|			ТОГДА ВЫБОР
	|					КОГДА ПолитикиУчетаСерийОприходование.ПолитикаУчетаСерий.УчитыватьОстаткиСерий
	|						ТОГДА ВЫБОР
	|								КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|									ТОГДА 4
	|								ИНАЧЕ 3
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Товары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|								ТОГДА 2
	|							ИНАЧЕ 1
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтатусУказанияСерийОприходование
	|ПОМЕСТИТЬ Статусы
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерий
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|			ПО ПолитикиУчетаСерий.Склад = Склады.Ссылка
	|		ПО (ПолитикиУчетаСерий.Склад = &СкладОтправитель)
	|			И (ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура).ВидНоменклатуры = ПолитикиУчетаСерий.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерийОприходование
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК СкладыОприходование
	|			ПО ПолитикиУчетаСерийОприходование.Склад = СкладыОприходование.Ссылка
	|		ПО (ПолитикиУчетаСерийОприходование.Склад = &СкладПолучатель)
	|			И (ВЫРАЗИТЬ(Товары.НоменклатураОприходование КАК Справочник.Номенклатура).ВидНоменклатуры = ПолитикиУчетаСерийОприходование.Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Статусы.НомерСтроки КАК НомерСтроки,
	|	Статусы.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	Статусы.СтатусУказанияСерийОприходование КАК СтатусУказанияСерийОприходование
	|ИЗ
	|	Статусы КАК Статусы
	|ГДЕ
	|	(Статусы.СтатусУказанияСерий <> Статусы.СтарыйСтатусУказанияСерий
	|			ИЛИ Статусы.СтатусУказанияСерийОприходование <> Статусы.СтарыйСтатусУказанияСерийОприходование)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат ТекстЗапроса;

КонецФункции

// %ИзЕРП% Документы.ПересортицаТоваров.ТекстЗапросаПроверкиЗаполненияСерий
//
// Параметры:
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстЗапросаПроверкиЗаполненияСерий(ПараметрыУказанияСерий) Экспорт
	
	Возврат Документы.ПересортицаТоваров.ТекстЗапросаПроверкиЗаполненияСерий(ПараметрыУказанияСерий);
	
КонецФункции

#КонецОбласти

#Область Проведение

// +25
//  %ИзЕРП% Описывает учетные механизмы используемые в документе для регистрации в механизме проведения.
//
// Параметры:
//  МеханизмыДокумента - Массив - список имен учетных механизмов, для которых будет выполнен.
//
Процедура ЗарегистрироватьУчетныеМеханизмы(МеханизмыДокумента) Экспорт
	
	МеханизмыДокумента.Добавить("Обеспечение");
	
КонецПроцедуры

// +25
//  %ИзЕРП% Возвращает таблицы для движений, необходимые для проведения документа по регистрам учетных механизмов.
//
// Параметры:
//  Документ - ДокументСсылка - ссылка на документ, по которому необходимо получить данны.
//  Регистры - Структура - список имен регистров, для которых необходимо получить таблиц.
//  ДопПараметры - Структура - дополнительные параметры для получения данных, определяющие контекст проведения.
//
// Возвращаемое значение:
//  Структура - коллекция элементов:
//     * Таблица<ИмяРегистра> - ТаблицаЗначений - таблица данных для отражения в регистр.
Функция ДанныеДокументаДляПроведения(Документ, Регистры, ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = ПроведениеДокументов.ДопПараметрыИнициализироватьДанныеДокументаДляПроведения();
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.питПеремещениеНоменклатурыСкладаПроизводства") Тогда
		ДокументСсылка = Документ.Ссылка;
	Иначе
		ДокументСсылка = Документ;
	КонецЕсли;
	
	Запрос			= Новый Запрос;
	ТекстыЗапроса	= Новый СписокЗначений;
	
	Если Не ДопПараметры.ПолучитьТекстыЗапроса Тогда
		////////////////////////////////////////////////////////////////////////////
		// Создадим запрос инициализации движений
		
		ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
		
		////////////////////////////////////////////////////////////////////////////
		// Сформируем текст запроса
		
	КонецЕсли;
	
	ОтразитьРаспределениеЗапасовДвижения(Запрос, ТекстыЗапроса, Регистры);
	
	////////////////////////////////////////////////////////////////////////////
	// Получим таблицы для движений
	
	Возврат ПроведениеДокументов.ИнициализироватьДанныеДокументаДляПроведения(Запрос, ТекстыЗапроса, ДопПараметры);
	
КонецФункции

// %ИзЕРП%
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ТекстыЗапросаРаспределениеЗапасовДвиженияДляОбновленияИБ() Экспорт
	
	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый СписокЗначений();
	Регистры = Неопределено;
	
	ОтразитьРаспределениеЗапасовДвижения(Запрос, ТекстыЗапроса, Регистры);
	
	Возврат ТекстыЗапроса;
	
КонецФункции

// %ИзЕРП%
//
// Параметры:
//  ИмяРегистра - Произвольный - Имя регистра.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДополнительныеИсточникиДанныхДляДвижений(ИмяРегистра) Экспорт

	ИсточникиДанных = Новый Соответствие;

	Возврат ИсточникиДанных; 

КонецФункции

#КонецОбласти

#Область УправлениеДоступом
// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
//
// Параметры:
//  Ограничение - Произвольный - Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(СкладОтправитель)
	|	И ЗначениеРазрешено(СкладПолучатель)
	|	И ЗначениеРазрешено(Подразделение)
	|";
	
КонецПроцедуры

#КонецОбласти

// Функция получает результат запроса по связанным с передаваемым планом-меню выпускам блюд.
//
// Параметры:
//  ДокументИсточник - ДокументСсылка. - Ссылка на документ основание.
//
// Возвращаемое значение:
//  РезультатЗапроса - РезультатЗапроса
Функция РезультатЗапросаСвязанныеПеремещенияНоменклатурыСкладаПроизводства(ДокументИсточник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Представление КАК Представление,
	|	ВЫРАЗИТЬ(Документ.ДокументИсточник КАК Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства).Представление КАК ПредставлениеЗаказа
	|ИЗ
	|	Документ.питПеремещениеНоменклатурыСкладаПроизводства КАК Документ
	|ГДЕ
	|	Документ.ДокументИсточник = &ДокументИсточник
	|	И НЕ Документ.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокументИсточник", ДокументИсточник);
	Возврат Запрос.Выполнить();
	
КонецФункции

// Функция возвращает структуру данных заполнения документа установки цен по документу перемещения в производство.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка.питПеремещениеНоменклатурыСкладаПроизводства - Ссылк.
//
// Возвращаемое значение:
//  Структура - Структура данных заполнения.
Функция ПолучитьДанныеЗаполненияДокументаУстановкиЦен(СсылкаНаДокумент) Экспорт
	
	// Отсекаем неверные входные данные.
	Если ТипЗнч(СсылкаНаДокумент) <> Тип("ДокументСсылка.питПеремещениеНоменклатурыСкладаПроизводства") 
		ИЛИ НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	// Нормативный вид цен берем из константы.
	ВидЦены = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит");
	
	// Получение данных документа перемещения в производство.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питПеремещениеНоменклатурыСкладаПроизводства.Организация КАК Организация,
	|	питПеремещениеНоменклатурыСкладаПроизводства.Подразделение КАК Подразделение,
	|	питПеремещениеНоменклатурыСкладаПроизводства.СкладОтправитель КАК СкладОтправитель,
	|	питПеремещениеНоменклатурыСкладаПроизводства.СкладПолучатель КАК СкладПолучатель,
	|	питПеремещениеНоменклатурыСкладаПроизводства.Валюта КАК Валюта,
	|	питПеремещениеНоменклатурыСкладаПроизводства.Дата КАК Дата
	|ИЗ
	|	Документ.питПеремещениеНоменклатурыСкладаПроизводства КАК питПеремещениеНоменклатурыСкладаПроизводства
	|ГДЕ
	|	питПеремещениеНоменклатурыСкладаПроизводства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	0 КАК НомерСтроки,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.Номенклатура КАК Номенклатура,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.Характеристика КАК Характеристика,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.Количество КАК Количество,
	|	0 КАК Цена,
	|	0 КАК Сумма,
	|	&ВидЦены КАК ВидЦены,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.Ссылка.Валюта КАК Валюта,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.НоменклатураОприходование КАК НоменклатураОприходование,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.ХарактеристикаОприходование КАК ХарактеристикаОприходование,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.УпаковкаОприходование КАК УпаковкаОприходование,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.КоличествоОприходование КАК КоличествоОприходование,
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.КоличествоУпаковокОприходование КАК КоличествоУпаковокОприходование,
	|	0 КАК ЦенаОприходования,
	|	0 КАК СуммаОприходования
	|ИЗ
	|	Документ.питПеремещениеНоменклатурыСкладаПроизводства.Товары КАК питПеремещениеНоменклатурыСкладаПроизводстваТовары
	|ГДЕ
	|	питПеремещениеНоменклатурыСкладаПроизводстваТовары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	ДанныеШапки = ПакетРезультатов[0].Выбрать();
	ДанныеШапки.Следующий();
	ТаблицаТоваров = ПакетРезультатов[1].Выгрузить();
	НомерСтроки = 1;
	Для каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		СтрокаТоваров.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	// Заполнение цен по нормативному виду цен. //питПроизводство.ПолучитьСтоимостьИнгредиента
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");
	КолонкиПоЗначению = Новый Структура("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Дата", ДанныеШапки.Дата);
	ПараметрыЗаполнения.Вставить("Валюта", ДанныеШапки.Валюта);
	ПараметрыЗаполнения.Вставить("ВидЦены", ВидЦены);
	ПараметрыЗаполнения.Вставить("КолонкиПоЗначению", КолонкиПоЗначению);
	ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(
		ТаблицаТоваров, // Табличная часть
		, // Выделенные строки (заполнять во всех строках)
		ПараметрыЗаполнения,
		СтруктураДействий);
	
	// Расчет цены номенклатуры оприходования.
	ТаблицаТоваров.Свернуть("НоменклатураОприходование,ХарактеристикаОприходование,УпаковкаОприходование,ВидЦены,Валюта", "КоличествоОприходование,КоличествоУпаковокОприходование,Сумма");
	ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоваров.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоваров.Колонки.Добавить("Цена", питОбщегоНазначенияКлиентСервер.ОписаниеТиповЧисло(15,2));
	Для каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		СтрокаТоваров.Номенклатура = СтрокаТоваров.НоменклатураОприходование;
		СтрокаТоваров.Характеристика = СтрокаТоваров.ХарактеристикаОприходование;
		СтрокаТоваров.Упаковка = СтрокаТоваров.УпаковкаОприходование;
		СтрокаТоваров.Цена = ?(СтрокаТоваров.КоличествоУпаковокОприходование = 0, 0, СтрокаТоваров.Сумма / СтрокаТоваров.КоличествоУпаковокОприходование);
	КонецЦикла;
	ТаблицаТоваров.Колонки.Удалить("НоменклатураОприходование");
	ТаблицаТоваров.Колонки.Удалить("ХарактеристикаОприходование");
	ТаблицаТоваров.Колонки.Удалить("УпаковкаОприходование");
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаНоменклатуры", ПоместитьВоВременноеХранилище(ТаблицаТоваров));
	Результат.Вставить("Дата", ДанныеШапки.Дата);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проведение

// %ИзЕРП%
//
// Параметры:
//  Запрос - Произвольный - Запрос.
//  ТекстыЗапроса - Произвольный - Тексты запроса.
//  Регистры - Произвольный - Регистры.
//
Процедура ОтразитьРаспределениеЗапасовДвижения(Запрос, ТекстыЗапроса, Регистры)
	
	ТекстЗапросаТабЧасть =
		// Приход на неордерном складе или по старым назначениям.
		"ВЫБРАТЬ
		|	ТабЧасть.Ссылка КАК Ссылка,
		|	ТабЧасть.Ссылка.Дата КАК Период,
		|	ТабЧасть.НоменклатураОприходование КАК Номенклатура,
		|	ТабЧасть.ХарактеристикаОприходование КАК Характеристика,
		|	ТабЧасть.Ссылка.СкладПолучатель КАК Склад,
		|	ТабЧасть.НазначениеОприходование КАК Назначение,
		|	ЗНАЧЕНИЕ(Справочник.КонтролируемыеПартии.ПустаяСсылка) КАК КонтролируемаяПартия,
		|	ЛОЖЬ КАК ПроконтролироватьКачество,
		|	ЛОЖЬ КАК ПодлежитРазблокировке,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПодтвержденияКачества,
		|	ТабЧасть.КоличествоОприходование КАК Количество,
		|	ИСТИНА КАК ПоГрафику,
		|	ТабЧасть.Ссылка.ДокументИсточник КАК РаспоряжениеВГрафике
		|ИЗ
		|	Документ.питПеремещениеНоменклатурыСкладаПроизводства.Товары КАК ТабЧасть
		|ГДЕ
		|	(НЕ ТабЧасть.Ссылка.СкладПолучатель.ИспользоватьОрдернуюСхемуПриПоступлении
		|			ИЛИ ТабЧасть.Ссылка.СкладПолучатель.ДатаНачалаОрдернойСхемыПриПоступлении > ТабЧасть.Ссылка.Дата
		|			ИЛИ ТабЧасть.НазначениеОприходование.ДвиженияПоСкладскимРегистрам = ЛОЖЬ)
		|	И НЕ ТабЧасть.Ссылка.ДокументИсточник = ЗНАЧЕНИЕ(Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства.ПустаяСсылка)
		|	И ТИПЗНАЧЕНИЯ(ТабЧасть.Ссылка.ДокументИсточник) = ТИП(Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства)
		|	И ТабЧасть.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство)";
	
	питДлительнаяПоддержка.ПриходЗапаса(Запрос, ТекстыЗапроса, Регистры, ТекстЗапросаТабЧасть, Истина, Ложь);
	
	ТекстЗапросаТабЧасть =
		// Сторно приходного ордера по старым назначениям.
		"ВЫБРАТЬ
		|	ТабЧасть.Ссылка                              КАК Ссылка,
		|	ТабЧасть.Ссылка.Дата                         КАК Период,
		|	ТабЧасть.НоменклатураОприходование           КАК Номенклатура,
		|	ТабЧасть.ХарактеристикаОприходование         КАК Характеристика,
		|	ТабЧасть.Ссылка.СкладПолучатель              КАК Склад,
		|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
		|	ЗНАЧЕНИЕ(Справочник.КонтролируемыеПартии.ПустаяСсылка) КАК КонтролируемаяПартия,
		|	ЛОЖЬ КАК ПроконтролироватьКачество,
		|	ЛОЖЬ КАК ПодлежитРазблокировке,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПодтвержденияКачества,
		|	-ТабЧасть.КоличествоОприходование            КАК Количество,
		|	ЛОЖЬ                                         КАК ПоГрафику,
		|	НЕОПРЕДЕЛЕНО                                 КАК РаспоряжениеВГрафике
		|ИЗ
		|	Документ.питПеремещениеНоменклатурыСкладаПроизводства.Товары КАК ТабЧасть
		|ГДЕ
		|	ТабЧасть.НазначениеОприходование.ДвиженияПоСкладскимРегистрам = ЛОЖЬ
		|		И ТабЧасть.Ссылка.СкладПолучатель.ИспользоватьОрдернуюСхемуПриПоступлении
		|		И ТабЧасть.Ссылка.СкладПолучатель.ДатаНачалаОрдернойСхемыПриПоступлении <= ТабЧасть.Ссылка.Дата
		|	И НЕ ТабЧасть.Ссылка.ДокументИсточник = ЗНАЧЕНИЕ(Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства.ПустаяСсылка)
		|	И ТИПЗНАЧЕНИЯ(ТабЧасть.Ссылка.ДокументИсточник) = ТИП(Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства)
		|	И ТабЧасть.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство)";
	
	питДлительнаяПоддержка.ПриходЗапаса(Запрос, ТекстыЗапроса, Регистры, ТекстЗапросаТабЧасть, Ложь, Ложь);
	
	ТекстЗапросаТабЧасть =
		"ВЫБРАТЬ
		|	ТабЧасть.Ссылка КАК Ссылка,
		|	ТабЧасть.Ссылка.Дата КАК Период,
		|	ТабЧасть.НоменклатураОприходование КАК Номенклатура,
		|	ТабЧасть.ХарактеристикаОприходование КАК Характеристика,
		|	ТабЧасть.Ссылка.СкладПолучатель КАК Склад,
		|	ВЫБОР
		|		КОГДА ТабЧасть.Назначение.ДвиженияПоСкладскимРегистрам = ЛОЖЬ
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.НазначениеОприходование
		|	КОНЕЦ КАК Назначение,
		|	ЛОЖЬ КАК ПроконтролироватьКачество,
		|	ЛОЖЬ КАК ПодлежитРазблокировке,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПодтвержденияКачества,
		|	ТабЧасть.КоличествоОприходование КАК Количество,
		|	ТабЧасть.Ссылка.ДокументИсточник КАК Заказ,
		|	ТабЧасть.Ссылка.Дата КАК ДатаПоступления,
		|	ИСТИНА КАК ДоступенДляРасхода,
		|	ИСТИНА КАК ПоГрафику,
		|	ТабЧасть.Ссылка.ДокументИсточник КАК РаспоряжениеВГрафике,
		|	ТабЧасть.КоличествоОприходование КАК КоличествоВГрафике
		|ИЗ
		|	Документ.питПеремещениеНоменклатурыСкладаПроизводства.Товары КАК ТабЧасть
		|ГДЕ
		|	ТабЧасть.Ссылка.СкладПолучатель.ИспользоватьОрдернуюСхемуПриПоступлении
		|	И ТабЧасть.Ссылка.СкладПолучатель.ДатаНачалаОрдернойСхемыПриПоступлении <= ТабЧасть.Ссылка.Дата
		|	И НЕ ТабЧасть.Ссылка.ДокументИсточник = ЗНАЧЕНИЕ(Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства.ПустаяСсылка)
		|	И ТИПЗНАЧЕНИЯ(ТабЧасть.Ссылка.ДокументИсточник) = ТИП(Документ.питЗаказНаПеремещениеВНоменклатуруПроизводства)
		|	И ТабЧасть.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ПеремещениеСкладскойНоменклатурыВПроизводство)";
	
	питДлительнаяПоддержка.ЗапланироватьПриходЗапаса(Запрос, ТекстыЗапроса, Регистры, ТекстЗапросаТабЧасть, Истина, Ложь);
	
КонецПроцедуры

// %ИзЕРП% Процедура устанавливает параметры запросов.
//
// Параметры:
//  Запрос - Запрос - Объект запроса.
//  ДокументСсылка - ДокументСсылка - Ссылка на документ.
//
Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВыпускБлюд.Дата КАК Период,
		|	ВыпускБлюд.Организация КАК Организация,
		|	ВыпускБлюд.Подразделение КАК Подразделение,
		|	ВыпускБлюд.Дата КАК ДатаПотребности,
		|	ВыпускБлюд.СкладОтправитель КАК СкладОтправитель,
		|	ВыпускБлюд.СкладПолучатель КАК СкладПолучатель,
		|	ВыпускБлюд.ДокументИсточник КАК ДокументИсточник,
		|	ВыпускБлюд.ХозяйственнаяОперация КАК ХозяйственнаяОперация
		|ИЗ
		|	Документ.питПеремещениеНоменклатурыСкладаПроизводства КАК ВыпускБлюд
		|ГДЕ
		|	ВыпускБлюд.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",                 Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",            Реквизиты.Организация);
	Запрос.УстановитьПараметр("Подразделение",          Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("ДатаПотребности",        Реквизиты.ДатаПотребности);
	Запрос.УстановитьПараметр("СкладОтправитель",       Реквизиты.СкладОтправитель);
	Запрос.УстановитьПараметр("СкладПолучатель",        Реквизиты.СкладПолучатель);
	Запрос.УстановитьПараметр("ДокументИсточник",       Реквизиты.ДокументИсточник);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",  Реквизиты.ХозяйственнаяОперация);
	
	Запрос.УстановитьПараметр("ПустаяСсылкаНазначение",    Справочники.Назначения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяСсылкаСклад",         Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяСсылкаПодразделение", Справочники.СтруктураПредприятия.ПустаяСсылка());
	
КонецПроцедуры

