#Область СлужебныеПроцедурыИФункции

#Область СообщенияЕГАИС

// Сообщение к передаче XML
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - Ссылка на докумен.
//  ДальнейшееДействие - Произвольный - Дальнейшее действие.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
//  Строка - Текст сообщения XML
Функция СообщениеКПередачеXML(ДокументСсылка, ДальнейшееДействие, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДальнейшееДействие = Перечисления.ДальнейшиеДействияПоВзаимодействиюЕГАИС.ПередайтеДанные Тогда
		
		Возврат ДобавлениеНовойПродукцииЕГАИСXML(ДокументСсылка);
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий

// Процедура - Обработка получения формы.
//
// Параметры:
//  ВидФормы - Произвольный - Вид формы.
//  Параметры - Произвольный - Параметры.
//  ВыбраннаяФорма - Произвольный - Выбранная форма.
//  ДополнительнаяИнформация - Произвольный - Дополнительная информация.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	ИнтеграцияЕГАИСВызовСервера.ПриПолученииФормыДокумента(
		"питДобавлениеНовойПродукцииЕГАИС",
		ВидФормы,
		Параметры,
		ВыбраннаяФорма,
		ДополнительнаяИнформация,
		СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область СообщенияЕГАИС

// Устанавливает значение свойства объекта XDTO.
//
// Параметры:
//  ОбъектXDTO - Произвольный - Объект xdto.
//  ИмяСвойства - Произвольный - Имя свойства.
//  ЗначениеСвойства - Произвольный - Значение свойства.
//  ТекстОшибки - Произвольный - Текст ошибки.
//  Глубина - Произвольный - Глубина.
//
Процедура УстановитьЗначениеСвойстваXDTO(ОбъектXDTO, ИмяСвойства, ЗначениеСвойства, ТекстОшибки, Глубина = Неопределено)
	
			Если ТипЗнч(ОбъектXDTO[ИмяСвойства]) = Тип("СписокXDTO") Тогда
				ОбъектXDTO[ИмяСвойства].Добавить(ЗначениеСвойства);
			Иначе
				ОбъектXDTO[ИмяСвойства] = ЗначениеСвойства;
			КонецЕсли;
		
КонецПроцедуры


// Функция - Добавление новой продукции егаисxml.
//
// Параметры:
//  ДокументСсылка - Произвольный - Документ ссылка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДобавлениеНовойПродукцииЕГАИСXML(ДокументСсылка)
	
	СообщенияXML = Новый Массив;
	
	ТекстыЗапроса = Новый СписокЗначений;
	
	ТекстыЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ЕГАИСПрисоединенныеФайлы.Документ КАК Ссылка,
		|	КОЛИЧЕСТВО(ЕГАИСПрисоединенныеФайлы.Ссылка) КАК ПоследнийНомер
		|ПОМЕСТИТЬ Версии
		|ИЗ
		|	Справочник.ЕГАИСПрисоединенныеФайлы КАК ЕГАИСПрисоединенныеФайлы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.питВыпускПродукцииЕГАИС КАК Шапка
		|		ПО (Шапка.Ссылка = &Ссылка)
		|			И (Шапка.ВидДокумента = ЕГАИСПрисоединенныеФайлы.Операция)
		|			И (Шапка.Ссылка = ЕГАИСПрисоединенныеФайлы.Документ)
		|ГДЕ
		|	ЕГАИСПрисоединенныеФайлы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыЗапросовИС.Исходящий)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕГАИСПрисоединенныеФайлы.Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Шапка.Номер КАК Номер,
		|	Шапка.Дата КАК Дата,
		|	ЕСТЬNULL(Версии.ПоследнийНомер, 0) КАК ПоследнийНомерВерсии,
		|	Шапка.Идентификатор КАК Идентификатор,
		|	Шапка.ВидДокумента КАК Операция,
		|	Шапка.ТипПродукции КАК ТипПродукции,
		|	Шапка.Производитель КАК Производитель,
		|	Шапка.Производитель.Код КАК ПроизводительКод,
		|	ВЫРАЗИТЬ(Шапка.Производитель.Наименование КАК СТРОКА(64)) КАК ПроизводительНаименование,
		|	ВЫРАЗИТЬ(Шапка.Производитель.НаименованиеПолное КАК СТРОКА(255)) КАК ПроизводительНаименованиеПолное,
		|	Шапка.Производитель.ИНН КАК ПроизводительИНН,
		|	Шапка.Производитель.КПП КАК ПроизводительКПП,
		|	Шапка.Производитель.КодСтраны КАК ПроизводительКодСтраны,
		|	Шапка.Производитель.КодРегиона КАК ПроизводительКодРегиона,
		|	Шапка.Производитель.ПочтовыйИндекс КАК ПроизводительПочтовыйИндекс,
		|	ВЫРАЗИТЬ(Шапка.Производитель.ПредставлениеАдреса КАК СТРОКА(1000)) КАК ПроизводительПредставлениеАдреса,
		|	Шапка.Производитель.ТипОрганизации КАК ПроизводительТипОрганизации,
		|	Шапка.Производитель.ИдентификаторОрганизацииТС КАК ПроизводительИдентификаторОрганизацииТС,
		|	Шапка.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	Шапка.ОрганизацияЕГАИС.Код КАК ИдентификаторФСРАР,
		|	Шапка.ОрганизацияЕГАИС.ФорматОбмена КАК ФорматОбмена,
		|	Шапка.ТипПродукции КАК ТипПродукции1,
		|	Шапка.НаименованиеПолное КАК НаименованиеПолное,
		|	Шапка.НаименованиеКраткое КАК НаименованиеКраткое,
		|	Шапка.КодВидаПродукции КАК КодВидаПродукции,
		|	Шапка.КодСтраныПроисхождения КАК КодСтраныПроисхождения,
		|	Шапка.ПризнакНефасованнойПродукции КАК ПризнакНефасованнойПродукции,
		|	Шапка.Крепость КАК Крепость,
		|	Шапка.Бренд КАК Бренд,
		|	Шапка.КодТипаУпаковки КАК КодТипаУпаковки,
		|	Шапка.КодФРАП КАК КодФРАП
		|ИЗ
		|	Документ.питДобавлениеНовойПродукцииЕГАИС КАК Шапка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Версии КАК Версии
		|		ПО Шапка.Ссылка = Версии.Ссылка
		|ГДЕ
		|	Шапка.Ссылка = &Ссылка",
		"Шапка");
	
	ПараметрыФормированияТекстаЗапроса = ШтрихкодированиеЕГАИС.ПараметрыФормированияТекстаЗапросаВложенныхШтрихкодов();
	ПараметрыФормированияТекстаЗапроса.ДокументСсылка                  = ДокументСсылка;
	ПараметрыФормированияТекстаЗапроса.ИспользоватьИдентификаторСтроки = Истина;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	РезультатыЗапроса = питДлительнаяПоддержка.ВыполнитьПакетЗапросов(Запрос, ТекстыЗапроса);
	
	Шапка                = РезультатыЗапроса["Шапка"].Выбрать();
	
	ВложенныеШтрихкодыУпаковок = Неопределено;
	
	Если Не Шапка.Следующий() Тогда
		
		СообщениеXML = ОбменДаннымиЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Документ = ДокументСсылка;
		СообщениеXML.Описание = ОбменДаннымиЕГАИС.ОписаниеОперацииПередачиДанных(
			Шапка.Операция, ДокументСсылка);
		
		ОбменДаннымиЕГАИСКлиентСервер.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		
		СообщенияXML.Добавить(СообщениеXML);
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	НомерВерсии = Шапка.ПоследнийНомерВерсии + 1;
	ФорматОбмена = ОбменДаннымиЕГАИСКлиентСервер.ФорматОбмена(Шапка.ФорматОбмена);
	
	СообщениеXML = ОбменДаннымиЕГАИС.СтруктураСообщенияXML();
	СообщениеXML.Описание = ОбменДаннымиЕГАИС.ОписаниеОперацииПередачиДанных(
		Шапка.Операция, ДокументСсылка, НомерВерсии);
	
	ПространствоИмен = Перечисления.ВидыДокументовЕГАИС.ПространствоИмен(Шапка.Операция, ФорматОбмена);
	ИмяТипа          = Перечисления.ВидыДокументовЕГАИС.ТипЕГАИС(Шапка.Операция, ФорматОбмена);
	
	Если ПространствоИмен = Неопределено
		Или ИмяТипа = Неопределено Тогда
		ОбменДаннымиЕГАИСКлиентСервер.ДобавитьТекстОшибки(
			СообщениеXML,
			СтрШаблон(НСтр("ru = 'Операция не поддерживается в версии формата обмена: %1.'"), ФорматОбмена));
		СообщенияXML.Добавить(СообщениеXML);
		Возврат СообщенияXML;
	КонецЕсли;
	
	Если Шапка.Операция = Перечисления.ВидыДокументовЕГАИС.питЗапросНаДобавлениеПродукции Тогда
		
			#Область ФорматОбмена_V3
			
			ДокументXDTO = РаботаСXMLЕГАИС.ОбъектXDTO(ПространствоИмен, "RequestAddProducts");
			
			РаботаСXMLЕГАИС.ЗаполнитьСвойствоXDTO(ДокументXDTO, "Identity", Шапка.Идентификатор, СообщениеXML, 3);
			
			ТекстОшибки = "";
			
			//
			ДокументXDTO.ClientId = Шапка.ОрганизацияЕГАИС.Код;
			ДокументXDTO.RequestNumber = Шапка.Номер;
			ДокументXDTO.RequestDate = Шапка.Дата;
			
			ТипПродукции = Шапка.ТипПродукции;
			Если ТипПродукции = Перечисления.питТипПродукцииЕГАИС.ССП Тогда
				ТипПродукцииСтрокой = "ССП";
			ИначеЕсли ТипПродукции = Перечисления.питТипПродукцииЕГАИС.ССНП Тогда
				ТипПродукцииСтрокой = "ССНП";
			Иначе
				ТипПродукцииСтрокой = "АП";
			КонецЕсли;
			
			ЭлементСодержимогоXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "RequestAddSSPPositionType"));
			
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "Producer"		, Шапка.ПроизводительКод 			, ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "Type"			, ТипПродукцииСтрокой 				, ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "VidCode"   		, Шапка.КодВидаПродукции            , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "CountryCode"    , Шапка.КодСтраныПроисхождения      , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "FullName"   	, Шапка.НаименованиеПолное          , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "ShortName"   	, Шапка.НаименованиеКраткое         , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "FRAPID"   		, Шапка.КодФРАП           , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "Brand"   		, Шапка.Бренд           , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "PackageType"  	, Шапка.КодТипаУпаковки           , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "Unpacked_Flag"  , Число(Шапка.ПризнакНефасованнойПродукции)           , ТекстОшибки);
			УстановитьЗначениеСвойстваXDTO(ЭлементСодержимогоXDTO, "PERCENT_ALC"   	, Шапка.Крепость    , ТекстОшибки, 5);
			// PackageType
			
			ДокументXDTO.Content = ЭлементСодержимогоXDTO;
			//
		#КонецОбласти
	
	КонецЕсли;
	
	ТекстСообщенияXML = РаботаСXMLЕГАИС.ОбъектXDTOВXML(ДокументXDTO, Шапка.ИдентификаторФСРАР, ПространствоИмен, ИмяТипа);
	
	СообщениеXML.ТекстСообщенияXML = ТекстСообщенияXML;
	СообщениеXML.ТипСообщения      = Перечисления.ТипыЗапросовИС.Исходящий;
	СообщениеXML.ОрганизацияЕГАИС  = Шапка.ОрганизацияЕГАИС;
	СообщениеXML.Операция          = Шапка.Операция;
	СообщениеXML.ФорматОбмена      = ФорматОбмена;
	СообщениеXML.Документ          = ДокументСсылка;
	СообщениеXML.ДокументОснование = Неопределено;
	СообщениеXML.Версия            = НомерВерсии;
	
	СообщенияXML.Добавить(СообщениеXML);
	
	Возврат СообщенияXML;
	
КонецФункции

#КонецОбласти

// Функция - Стркуктура данных запроса на добавление продукции.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СтркуктураДанныхЗапросаНаДобавлениеПродукции()
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор" , Неопределено); // Идентификатор документа (клиентский).
	Результат.Вставить("Номер"         , "");           // Номер документа.
	Результат.Вставить("Дата"          , '00010101');   // Дата составления.
	Результат.Вставить("ТипПродукции"  , Неопределено);   
	Результат.Вставить("НаименованиеПолное" , "");   
	Результат.Вставить("НаименованиеКраткое" , "");   
	Результат.Вставить("КодВидаПродукции" , 0);   
	Результат.Вставить("КодСтраныПроисхождения" , 0);   
	Результат.Вставить("Крепость" , 0);   
	Результат.Вставить("ПризнакНефасованнойПродукции" , Ложь);   
	Результат.Вставить("Производитель" , Неопределено); // Производитель.
	Результат.Вставить("ОрганизацияЕГАИС" , Неопределено); 
	Результат.Вставить("КодФРАП" , ""); 
	Результат.Вставить("Бренд" , "");
	Результат.Вставить("КодТипаУпаковки" , "");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли


