// Добавляет на форму списка условное оформление состояния фиксации.
//
// Параметры:
//  Форма - УправляемаяФорма - форма документа.
//  ОформляемоеПоле - Строка - имя поля для оформления.
//  ПутьКДанным - Строка - путь к реквизиту СтатусОбработки.
//
Процедура УстановитьУсловноеОформлениеСтатусаОбработки(Форма, ОформляемоеПоле = "Список", ПутьКДанным = "Список.СтатусОбработки") Экспорт
	
	УсловноеОформлениеКД = Форма.УсловноеОформление;
	
	// Представление статуса Передается
	ПредставлениеЭлемента = НСтр("ru = 'Документ передается в ЕГАИС'");
	
	ЭлементУсловногоОформления = УсловноеОформлениеКД.Элементы.Добавить();
	ЭлементУсловногоОформления.Представление = ПредставлениеЭлемента;
	ЭлементУсловногоОформления.Использование = Истина;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.СтатусОбработкиПередаетсяГосИС);
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ОформляемоеПоле);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементУсловногоОформления.Отбор,
		ПутьКДанным,
		Перечисления.питСтатусыОбработкиЗапросаНаДобавлениеПродукцииЕГАИС.ОбрабатываетсяЕГАИС,
		ВидСравненияКомпоновкиДанных.Равно,
		ПредставлениеЭлемента,
		Истина);
	
	// Представление статуса ОшибкаПередачи
	ПредставлениеЭлемента = НСтр("ru = 'Получена ошибка передачи в ЕГАИС'");
	
	ЭлементУсловногоОформления = УсловноеОформлениеКД.Элементы.Добавить();
	ЭлементУсловногоОформления.Представление = ПредставлениеЭлемента;
	ЭлементУсловногоОформления.Использование = Истина;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.СтатусОбработкиОшибкаПередачиГосИС);
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ОформляемоеПоле);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭлементУсловногоОформления.Отбор,
		ПутьКДанным,
		Перечисления.питСтатусыОбработкиЗапросаНаДобавлениеПродукцииЕГАИС.ОшибкаПередачи,
		ВидСравненияКомпоновкиДанных.Равно,
		ПредставлениеЭлемента,
		Истина);
	
КонецПроцедуры

// Возвращает данные документа в виде структуры перед выгрузкой в УТМ.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПередачаВРегистр2ЕГАИС - выгружаемая передача.
//
// Возвращаемое значение:
//   Структура - данные передачи.
Функция ИнициализироватьДанныеДокументаДляВыгрузки(ДокументСсылка) Экспорт
	
	ДанныеДокумента = СтркуктураДанныхЗапросаНаДобавлениеПродукции();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	питДобавлениеНовойПродукцииЕГАИС.Ссылка,
	|	питДобавлениеНовойПродукцииЕГАИС.Номер,
	|	питДобавлениеНовойПродукцииЕГАИС.Дата,
	|	питДобавлениеНовойПродукцииЕГАИС.КодФРАП,
	|	питДобавлениеНовойПродукцииЕГАИС.Бренд,
	|	питДобавлениеНовойПродукцииЕГАИС.КодТипаУпаковки,
	|	питДобавлениеНовойПродукцииЕГАИС.ОрганизацияЕГАИС,
	|	питДобавлениеНовойПродукцииЕГАИС.Идентификатор,
	|	питДобавлениеНовойПродукцииЕГАИС.Производитель,
	|	питДобавлениеНовойПродукцииЕГАИС.ТипПродукции,
	|	питДобавлениеНовойПродукцииЕГАИС.НаименованиеПолное,
	|	питДобавлениеНовойПродукцииЕГАИС.НаименованиеКраткое,
	|	питДобавлениеНовойПродукцииЕГАИС.КодВидаПродукции,
	|	питДобавлениеНовойПродукцииЕГАИС.КодСтраныПроисхождения,
	|	питДобавлениеНовойПродукцииЕГАИС.ПризнакНефасованнойПродукции,
	|	питДобавлениеНовойПродукцииЕГАИС.Крепость
	|ИЗ
	|	Документ.питДобавлениеНовойПродукцииЕГАИС КАК питДобавлениеНовойПродукцииЕГАИС
	|ГДЕ
	|	питДобавлениеНовойПродукцииЕГАИС.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ДанныеДокумента, Выборка);
		
	
	Возврат ДанныеДокумента;
	
КонецФункции

