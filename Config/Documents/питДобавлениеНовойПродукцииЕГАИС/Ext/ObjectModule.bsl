
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Процедура - Инициализировать документ.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено) Экспорт

	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
		ВидДокумента = Перечисления.ВидыДокументовЕГАИС.питЗапросНаДобавлениеПродукции;
	КонецЕсли;
	
	Если ПустаяСтрока(Идентификатор) Тогда
		Идентификатор = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

// Процедура - При копировании.
//
// Параметры:
//  ОбъектКопирования - Произвольный - Объект копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	СтатусОбработки = Перечисления.питСтатусыОбработкиЗапросаНаДобавлениеПродукцииЕГАИС.Черновик;
	
	Идентификатор = "";
	ИдентификаторЕГАИС = "";
	ДатаРегистрацииДвижений = '00010101';
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли




