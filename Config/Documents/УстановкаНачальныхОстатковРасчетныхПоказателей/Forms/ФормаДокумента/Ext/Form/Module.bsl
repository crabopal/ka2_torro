
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ДатаОстатков = НачалоМесяца(ОбщегоНазначения.ТекущаяДатаПользователя());
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	Элементы.СтраницаКомментарий.Картинка = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.Комментарий);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	
	СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	СобытияФорм.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	Элементы.СтраницаКомментарий.Картинка = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.Комментарий);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СобытияФорм.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПредставлениеДатыОстатков = ОбщегоНазначенияУТКлиентСервер.ПолучитьПредставлениеПериодаРегистрации(Объект.ДатаОстатков);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ПоСценарию И Не ЗначениеЗаполнено(Объект.Сценарий) Тогда
		ОбщегоНазначения.СообщитьПользователю(ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , "Сценарий"), ,
			"Сценарий", "Объект", Отказ);
	КонецЕсли;
	ПредставлениеТабличнойЧасти = Объект.Ссылка.Метаданные().ТабличныеЧасти.ОстаткиРасчетногоПоказателя.Синоним;
	Если ПоОрганизациям Тогда
		ПроверяемыеСтроки = Объект.ОстаткиРасчетногоПоказателя.НайтиСтроки(Новый Структура("Организация",
			Справочники.Организации.ПустаяСсылка()));
		Для Каждого ПроверяемаяСтрока Из ПроверяемыеСтроки Цикл
			ОбщегоНазначения.СообщитьПользователю(ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", , "Организация",
				ПроверяемаяСтрока.НомерСтроки, ПредставлениеТабличнойЧасти), ,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ОстаткиРасчетногоПоказателя",
				ПроверяемаяСтрока.НомерСтроки, "Организация"), "Объект", Отказ);
		КонецЦикла;
	КонецЕсли;
	Если ПоПодразделениям Тогда
		ПроверяемыеСтроки = Объект.ОстаткиРасчетногоПоказателя.НайтиСтроки(Новый Структура("Подразделение",
			Справочники.СтруктураПредприятия.ПустаяСсылка()));
		Для Каждого ПроверяемаяСтрока Из ПроверяемыеСтроки Цикл
			ОбщегоНазначения.СообщитьПользователю(ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", , "Подразделение",
				ПроверяемаяСтрока.НомерСтроки, ПредставлениеТабличнойЧасти), ,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ОстаткиРасчетногоПоказателя",
				ПроверяемаяСтрока.НомерСтроки, "Подразделение"), "Объект", Отказ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаОстатковПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Сценарий) Тогда
		ПоместитьВоВременноеХранилищеТаблицуКурсовСценария();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОстатковОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДатаОстатковРегулирование(Элемент, Направление, СтандартнаяОбработка)
	ОбщегоНазначенияУТКлиент.РегулированиеПредставленияПериодаРегистрации(Направление, СтандартнаяОбработка,
		Объект.ДатаОстатков, ПредставлениеДатыОстатков);
	Объект.ДатаОстатков = НачалоМесяца(Объект.ДатаОстатков);
КонецПроцедуры

&НаКлиенте
Процедура ДатаОстатковНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОбработчикЗакрытия = Новый ОписаниеОповещения("ДатаОстатковНачалоВыбораЗавершение", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("Значение, РежимВыбораПериода", Объект.ДатаОстатков, "МЕСЯЦ");
	
	ОткрытьФорму("ОбщаяФорма.ВыборПериода", ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор, , ,
		ОбработчикЗакрытия, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОстатковНачалоВыбораЗавершение(ВыбранныйПериод, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаОстатков = НачалоМесяца(ВыбранныйПериод);
	ПредставлениеДатыОстатков = ОбщегоНазначенияУТКлиентСервер.ПолучитьПредставлениеПериодаРегистрации(
		Объект.ДатаОстатков);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказательБюджетовПриИзменении(Элемент)
	ПриИзмененииПоказателяБюджетов();
КонецПроцедуры

&НаКлиенте
Процедура ПоСценариюПриИзменении(Элемент)
	
	Если Не ПоСценарию Тогда
		Объект.Сценарий = Неопределено;
		АдресТаблицыКурсовСценария = Неопределено;
	КонецЕсли;
	
	УстановитьВидимость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоОрганизациямПриИзменении(Элемент)
	
	Если Не ПоОрганизациям Тогда
		Для Каждого СтрокаТЧ Из Объект.ОстаткиРасчетногоПоказателя Цикл
			СтрокаТЧ.Организация = Неопределено;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПоказательБюджетов) Тогда
		УстановитьСвойстваКолонокПоРасчетномуПоказателю();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоПодразделениямПриИзменении(Элемент)
	
	Если Не ПоПодразделениям Тогда
		Для Каждого СтрокаТЧ Из Объект.ОстаткиРасчетногоПоказателя Цикл
			СтрокаТЧ.Подразделение = Неопределено;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Сценарий) Тогда
		ПоместитьВоВременноеХранилищеТаблицуКурсовСценария();
	Иначе
		АдресТаблицыКурсовСценария = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОстаткиРасчетногоПоказателя

&НаКлиенте
Процедура ОстаткиРасчетногоПоказателяПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	НомерСтрокиДубля = Неопределено;
	Если Не ОтменаРедактирования Тогда
		Если СтрокаДублируетСуществующую(Элемент.ТекущаяСтрока, НомерСтрокиДубля) Тогда
			ТекстСообщения = НСтр("ru = 'Нельзя вводить строки с одинаковыми значениями.
										|Указанные значения уже встречаются в строке №%1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерСтрокиДубля);
			ПоказатьПредупреждение(, ТекстСообщения);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиРасчетногоПоказателяАналитикаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ПараметрыПоказателя.АналитикаВалюты)
		И Элемент.Имя = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ОстаткиРасчетногоПоказателяАналитика%1",
		ПараметрыПоказателя.АдресАналитикиВалюта) Тогда
		ТекущаяСтрока = Элементы.ОстаткиРасчетногоПоказателя.ТекущиеДанные;
		ЗначениеАналитики = ТекущаяСтрока[СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Аналитика%1",
			ПараметрыПоказателя.АдресАналитикиВалюта)];
		Если ЗначениеЗаполнено(ЗначениеАналитики) Тогда
			Валюта = ПолучитьВалютуИзЗначенияАналитики(ЗначениеАналитики);
		Иначе
			Валюта = Неопределено;
		КонецЕсли;
		Если ТекущаяСтрока.Валюта <> Валюта Тогда
			ТекущаяСтрока.Валюта = Валюта;
			ТекущаяСтрока.СуммаВВалюте = 0;
			ТекущаяСтрока.СуммаУпр = 0;
			ТекущаяСтрока.СуммаРегл = 0;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиРасчетногоПоказателяВалютаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ОстаткиРасчетногоПоказателя.ТекущиеДанные;
	ТекущаяСтрока.СуммаВВалюте = 0;
	ТекущаяСтрока.СуммаУпр = 0;
	ТекущаяСтрока.СуммаРегл = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиРасчетногоПоказателяСуммаВВалютеПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ОстаткиРасчетногоПоказателя.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Валюта) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", , "Валюта",
			ТекущаяСтрока.НомерСтроки), ,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ОстаткиРасчетногоПоказателя",
			ТекущаяСтрока.НомерСтроки, "Валюта"), "Объект");
		ТекущаяСтрока.СуммаВВалюте = 0;
	Иначе
		ПересчитатьСуммуУпр = Ложь;
		ПересчитатьСуммуРегл = Ложь;
		Если ТекущаяСтрока.Валюта <> ВалютаУпрУчета Тогда
			ПересчитатьСуммуУпр = Истина;
		Иначе
			ТекущаяСтрока.СуммаУпр = ТекущаяСтрока.СуммаВВалюте;
		КонецЕсли;
		Если ТекущаяСтрока.Валюта <> ?(ЗначениеЗаполнено(ТекущаяСтрока.Организация),
			ЗначениеНастроекКлиентСерверПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ТекущаяСтрока.Организация),
			ВалютаРеглУчета) Тогда
			ПересчитатьСуммуРегл = Истина;
		Иначе
			ТекущаяСтрока.СуммаРегл = ТекущаяСтрока.СуммаВВалюте;
		КонецЕсли;
		Если ПересчитатьСуммуУпр Или ПересчитатьСуммуРегл Тогда
			Если ЗначениеЗаполнено(Объект.Сценарий) Тогда
				ПересчитатьСуммыУпрИРеглПоПрогнознымКурсамВСтрокеТабличнойЧасти(ТекущаяСтрока.ПолучитьИдентификатор(),
					ПересчитатьСуммуУпр, ПересчитатьСуммуРегл);
			Иначе
				ПересчитатьСуммыУпрИРеглВСтрокеТабличнойЧасти(ТекущаяСтрока.ПолучитьИдентификатор(), ПересчитатьСуммуУпр,
					ПересчитатьСуммуРегл);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиРасчетногоПоказателяСуммаУпрПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ОстаткиРасчетногоПоказателя.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Валюта) Тогда
		Если ВалютаУпрУчета <> ?(ЗначениеЗаполнено(ТекущаяСтрока.Организация),
			ЗначениеНастроекКлиентСерверПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ТекущаяСтрока.Организация),
			ВалютаРеглУчета) Тогда
			ПересчитатьСуммуРегл = Истина;
		Иначе
			ТекущаяСтрока.СуммаРегл = ТекущаяСтрока.СуммаУпр;
			ПересчитатьСуммуРегл = Ложь;
		КонецЕсли;
		Если ПересчитатьСуммуРегл Тогда
			Если ЗначениеЗаполнено(Объект.Сценарий) Тогда
				ПересчитатьСуммыУпрИРеглПоПрогнознымКурсамВСтрокеТабличнойЧасти(ТекущаяСтрока.ПолучитьИдентификатор(), Ложь,
					ПересчитатьСуммуРегл);
			Иначе
				ПересчитатьСуммыУпрИРеглВСтрокеТабличнойЧасти(ТекущаяСтрока.ПолучитьИдентификатор(), Ложь, ПересчитатьСуммуРегл);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

