&НаКлиенте
Процедура ЗаполнитьПоФактическимНачальнымОстаткам(Команда)
	
	ОчиститьСообщения();
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ГраницаФактДанных", НачалоДня(Объект.ДатаОстатков - 1));
	Если Объект.ОстаткиРасчетногоПоказателя.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьОстаткиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru='Перед заполнением табличная часть будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьОстаткиСервер(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоГраницеФактическихДанных(Команда)
	
	ОчиститьСообщения();
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	Если Не ПоСценарию Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Заполнение возможно только по конкретному сценарию.'"), , "ПоСценарию");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	Если Объект.ОстаткиРасчетногоПоказателя.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьОстаткиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Перед заполнением табличная часть будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ВвестиГраницуФактическихДанныхДляЗаполненияОстатков(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

