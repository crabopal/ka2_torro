&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЗаполнитьСвойстваПоказателяБюджетов();
	
	ПоСценарию = ЗначениеЗаполнено(Объект.Сценарий);
	Если ПоСценарию Тогда
		ПоместитьВоВременноеХранилищеТаблицуКурсовСценария();
	КонецЕсли;
	ВалютаУпрУчета = ЗначениеНастроекПовтИсп.ВалютаУправленческогоУчета();
	ВалютаРеглУчета = ЗначениеНастроекПовтИсп.БазоваяВалютаПоУмолчанию();
	АдресКэшаКурсовВалют = ПоместитьВоВременноеХранилище(РаботаСКурсамиВалютУТ.ИнициализироватьКэшКурсовВалют(),
		УникальныйИдентификатор);
	АдресКэшаЗначенийАналитик = ПоместитьВоВременноеХранилище(Новый Соответствие, УникальныйИдентификатор);
	
	КоличествоСтрокТабличнойЧасти = Объект.ОстаткиРасчетногоПоказателя.Количество();
	Если КоличествоСтрокТабличнойЧасти > 0 Тогда
		СтруктураПоиска = Новый Структура("Организация", Справочники.Организации.ПустаяСсылка());
		КоличествоНайденныхСтрок = Объект.ОстаткиРасчетногоПоказателя.НайтиСтроки(СтруктураПоиска).Количество();
		ПоОрганизациям = (КоличествоСтрокТабличнойЧасти > КоличествоНайденныхСтрок);
		СтруктураПоиска = Новый Структура("Подразделение", Справочники.СтруктураПредприятия.ПустаяСсылка());
		КоличествоНайденныхСтрок = Объект.ОстаткиРасчетногоПоказателя.НайтиСтроки(СтруктураПоиска).Количество();
		ПоПодразделениям = (КоличествоСтрокТабличнойЧасти > КоличествоНайденныхСтрок);
	Иначе
		ПоОрганизациям = Ложь;
		ПоПодразделениям = Ложь;
	КонецЕсли;
	
	УстановитьВидимость(ЭтотОбъект);
	УстановитьСвойстваКолонокПоРасчетномуПоказателю();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимость(Форма)
	
	Форма.Элементы.Сценарий.Видимость = Форма.ПоСценарию;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваКолонокПоРасчетномуПоказателю()

	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	
	Если ВидыАналитикПоказателя = Неопределено Тогда
		Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
			ИмяКолонки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ОстаткиРасчетногоПоказателяАналитика%1",
				НомерАналитики);
			Элементы[ИмяКолонки].Видимость = Ложь;
			Элементы[ИмяКолонки].ОграничениеТипа = Новый ОписаниеТипов;
		КонецЦикла;
	Иначе
		СоответствиеВладельцев = ФинансоваяОтчетностьПовтИсп.СоответствиеОтборовПоВладельцу();
		СоответствиеПоОрганизации = БюджетированиеПовтИсп.ТипыАналитикСвязанныеСОрганизацией();
		Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
			ИмяКолонки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ОстаткиРасчетногоПоказателяАналитика%1",
				НомерАналитики);
			СтрокаНаименованиеКолонки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ВидАналитики%1Наименование",
				НомерАналитики);
			Если ЗначениеЗаполнено(ВидыАналитикПоказателя[СтрокаНаименованиеКолонки]) Тогда
				Элементы[ИмяКолонки].Заголовок = ВидыАналитикПоказателя[СтрокаНаименованиеКолонки];
				СтрокаТипЗначенияКолонки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ВидАналитики%1ТипЗначения",
					НомерАналитики);
				Элементы[ИмяКолонки].Видимость = Истина;
				Элементы[ИмяКолонки].ОграничениеТипа = ВидыАналитикПоказателя[СтрокаТипЗначенияКолонки];
				СтрокаДополнительноеСвойство = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					"ВидАналитики%1ДополнительноеСвойство", НомерАналитики);
				Если ЗначениеЗаполнено(ВидыАналитикПоказателя[СтрокаДополнительноеСвойство]) Тогда
					ПараметрыВыбораФормы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ПараметрВыбора("Отбор.Владелец",
						ВидыАналитикПоказателя[СтрокаДополнительноеСвойство]));
					Элементы[ИмяКолонки].ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораФормы);
				Иначе
					ДобавленыПараметрыСвязиПоВладельцу = Ложь;
					Для Каждого Тип Из Элементы[ИмяКолонки].ОграничениеТипа.Типы() Цикл
						Если ДобавленыПараметрыСвязиПоВладельцу Тогда
							Прервать;
						КонецЕсли;
						ТипыВладельца = СоответствиеВладельцев[Тип];
						Если ТипыВладельца <> Неопределено Тогда
							Для НомерАналитикиВладельца = 1 По НомерАналитики - 1 Цикл
								Если ДобавленыПараметрыСвязиПоВладельцу Тогда
									Прервать;
								КонецЕсли;
								НомерПроверяемойАналитики = НомерАналитики - НомерАналитикиВладельца;
								ОписаниеТиповПроверяемойАналитики = ВидыАналитикПоказателя[СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									"ВидАналитики%1ТипЗначения", НомерАналитикиВладельца)];
								Для Каждого СтрокаТипа Из ТипыВладельца Цикл
									Если ОписаниеТиповПроверяемойАналитики.СодержитТип(СтрокаТипа.Тип) Тогда
										ПутьКДаннымПроверяемойАналитики = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											"Элементы.ОстаткиРасчетногоПоказателя.ТекущиеДанные.Аналитика%1", НомерПроверяемойАналитики);
										СвязиПараметровВыбора = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый СвязьПараметраВыбора(
											"Отбор." + СтрокаТипа.Реквизит, ПутьКДаннымПроверяемойАналитики));
										Элементы[ИмяКолонки].СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
										ДобавленыПараметрыСвязиПоВладельцу = Истина;
										Прервать;
									КонецЕсли;
								КонецЦикла;
							КонецЦикла;
						КонецЕсли;
					КонецЦикла;
					ДобавленыПараметрыСвязиПоОрганизации = Ложь;
					Для Каждого Тип Из Элементы[ИмяКолонки].ОграничениеТипа.Типы() Цикл
						Если ДобавленыПараметрыСвязиПоОрганизации Тогда
							Прервать;
						КонецЕсли;
						Если СоответствиеПоОрганизации[Тип] <> Неопределено Тогда
							Если ДобавленыПараметрыСвязиПоВладельцу Тогда
								СвязиПараметровВыбора = Новый Массив(Элементы[ИмяКолонки].СвязиПараметровВыбора);
							Иначе
								СвязиПараметровВыбора = Новый Массив;
							КонецЕсли;
							Если ПоОрганизациям Тогда
								СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор." + СоответствиеПоОрганизации[Тип],
								"Элементы.ОстаткиРасчетногоПоказателя.ТекущиеДанные.Организация"));
							КонецЕсли;
							Элементы[ИмяКолонки].СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
							ДобавленыПараметрыСвязиПоОрганизации = Истина;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Иначе
				Элементы[ИмяКолонки].Видимость = Ложь;
				Элементы[ИмяКолонки].ОграничениеТипа = Новый ОписаниеТипов;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваПоказателяБюджетов()
	
	Если ЗначениеЗаполнено(Объект.ПоказательБюджетов) Тогда
		ВидыАналитикПоказателя = БюджетированиеСервер.ВидыАналитик(Объект.ПоказательБюджетов, Истина);
		ПараметрыПоказателя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПоказательБюджетов,
			"УчитыватьПоКоличеству, УчитыватьПоВалюте, АналитикаВалюты, АдресАналитикиВалюта");
		Если ЗначениеЗаполнено(ПараметрыПоказателя.АналитикаВалюты) Тогда
			ПараметрыПоказателя.Вставить("ЗаполнениеВалюты", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ПараметрыПоказателя.АналитикаВалюты, "ЗаполнениеВалюты"));
		КонецЕсли;
	Иначе
		ПараметрыПоказателя = Новый Структура("УчитыватьПоКоличеству, УчитыватьПоВалюте, АналитикаВалюты, АдресАналитикиВалюта, ЗаполнениеВалюты",
			Ложь, Ложь, Неопределено);
		ВидыАналитикПоказателя = Неопределено;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыПоказателя);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПоказателяБюджетов()
	
	ЗаполнитьСвойстваПоказателяБюджетов();
	
	Объект.ОстаткиРасчетногоПоказателя.Очистить();
	
	УстановитьСвойстваКолонокПоРасчетномуПоказателю();

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяВалюта.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяСуммаВВалюте.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УчитыватьПоВалюте");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяВалюта.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("АналитикаВалюты");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	
	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяКоличество.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УчитыватьПоКоличеству");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяОрганизация.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПоОрганизациям");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяПодразделение.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПоПодразделениям");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяСуммаВВалюте.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОстаткиРасчетногоПоказателя.Валюта");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяСуммаУпр.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("АналитикаВалюты");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОстаткиРасчетногоПоказателя.СуммаВВалюте");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОстаткиРасчетногоПоказателяСуммаРегл.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("АналитикаВалюты");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОстаткиРасчетногоПоказателя.СуммаВВалюте");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВвестиГраницуФактическихДанныхДляЗаполненияОстатков(ДополнительныеПараметры)
	
	ПараметрыФормы = Новый Структура("ВидБюджета, НачалоПериода, ГраницаФактДанных", Неопределено, Объект.ДатаОстатков-1, Объект.ДатаОстатков-1);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаГраницыФактическихДанных", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("ОбщаяФорма.НастройкаГраницыФакта", ПараметрыФормы,,,,, ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаГраницыФактическихДанных(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("ГраницаФактДанных", Результат);
		ЗаполнитьОстаткиСервер(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОстаткиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ДополнительныеПараметры.Свойство("ГраницаФактДанных") Тогда
			ЗаполнитьОстаткиСервер(ДополнительныеПараметры);
		Иначе
			ВвестиГраницуФактическихДанныхДляЗаполненияОстатков(ДополнительныеПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиСервер(ПараметрыЗаполнения)
	
	НастройкиЗаполнения = Новый НастройкиКомпоновкиДанных;
	ФинансоваяОтчетностьСервер.НовыйОтбор(НастройкиЗаполнения.Отбор, "ПоказательБюджетов", Объект.ПоказательБюджетов);
	ФинансоваяОтчетностьСервер.НовыйОтбор(НастройкиЗаполнения.Отбор, "Сценарий", Объект.Сценарий);
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ГраницаОстатков = ПараметрыЗаполнения.ГраницаФактДанных;
	РассчитатьФактПоПоказателюБюджетов = ПараметрыЗаполнения.Свойство("ГраницаФактДанных") И ЗначениеЗаполнено(
		ГраницаОстатков);
	Если Не РассчитатьФактПоПоказателюБюджетов Тогда
		ПараметрыОстатков = Новый Структура;
		ПараметрыОстатков.Вставить("ДатаОстатков", Объект.ДатаОстатков);
		ПараметрыОстатков.Вставить("НастройкиОтчета", НастройкиЗаполнения);
		ПараметрыОстатков.Вставить("ПоОрганизациям", ПоОрганизациям);
		ПараметрыОстатков.Вставить("ПоПодразделениям", ПоПодразделениям);
		ПараметрыОстатков.Вставить("ОстаткиНаКонкретнуюДату", Ложь);
		ПараметрыОстатков.Вставить("УстановленОтбор", Истина);
		ПараметрыОстатков.Вставить("УстановленОтборКомпоновкиДанных", Ложь);
		ПараметрыОстатков.Вставить("ФункциональнаяВалюта", Неопределено);
		РегистрыСведений.НачальныеОстаткиРасчетныхПоказателей.СформироватьВременныеТаблицы_АктуальныеНачальныеОстаткиРасчетныхПоказателей(
			МенеджерВременныхТаблиц, ПараметрыОстатков);
		СтрокаПоказатель = МенеджерВременныхТаблиц.Таблицы.Найти("АктуальныеДатыОстатков").ПолучитьДанные();
		Если Не СтрокаПоказатель.Пустой() Тогда
			ГраницаОстатков = СтрокаПоказатель.Выгрузить()[0].ДатаОстатков-1;
		Иначе
			ГраницаОстатков = НачалоГода(Объект.ДатаОстатков-1);
			РассчитатьФактПоПоказателюБюджетов = Истина;
			ОбщегоНазначенияУТ.УничтожитьВременныеТаблицы(МенеджерВременныхТаблиц);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
 	Если РассчитатьФактПоПоказателюБюджетов Тогда
		ПараметрыПолученияФакта = ПараметрыПолученияФактаПоНастройкамЗаполнения();
		ОстаткиПоПоказателюБюджетов = БюджетированиеСервер.ФактПоПоказателямБюджетов(НастройкиЗаполнения,
			ПараметрыПолученияФакта, МенеджерВременныхТаблиц, "ОстаткиПоРасчетнымПоказателям");
	КонецЕсли;
	
	ЕстьПлановыеОбороты = Ложь;
	Если НачалоДня(ГраницаОстатков) < НачалоДня(Объект.ДатаОстатков-1) Тогда
	
		ДанныеКурсовСценария = Новый Структура;
		ДанныеКурсовСценария.Вставить("ГраницаФактДанных", ГраницаОстатков);
		ДанныеКурсовСценария.Вставить("ТаблицаКурсовСценария", ПолучитьИзВременногоХранилища(АдресТаблицыКурсовСценария));
		
		РассчитатьПлановыеОборотыПоВлияющимСтатьямБюджетов(НастройкиЗаполнения, ГраницаОстатков, МенеджерВременныхТаблиц,
			ДанныеКурсовСценария);
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ЕстьПлановыеОбороты = МенеджерВременныхТаблиц.Таблицы.Найти("ПлановыеОбороты") <> Неопределено
			И ФинансовыйУчетПоДаннымБалансовыхРегистров.ЕстьЗаписиВоВременнойТаблице(Запрос, Новый Массив, "ПлановыеОбороты");
		Если ЕстьПлановыеОбороты И УчитыватьПоВалюте Тогда
			ПересчитатьОстаткиИзВалютыВВалюту = ФинансовыйУчетПоДаннымБалансовыхРегистров.ЕстьЗаписиВоВременнойТаблице(Запрос,
				Новый Массив, "ОстаткиПоРасчетнымПоказателям");
			Если ПересчитатьОстаткиИзВалютыВВалюту Тогда
				// Необходимо выполнить пересчет сумм в валютах регламентированного и управленческого учета, так как остатки и обороты
				// могли быть рассчитаны по разным курсам на дату остатков (фактическим и прогнозным)
				ПараметрыТаблицыДанных = БюджетированиеСервер.ПараметрыПересчетаТаблицыДанныхВВалюту();
				ПараметрыТаблицыДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				ПараметрыТаблицыДанных.ИмяВременнойТаблицы = "ОстаткиПоРасчетнымПоказателям";
				БюджетированиеСервер.ПересчитатьТаблицуДанныхВВалюту(ПараметрыТаблицыДанных, Неопределено,
					Перечисления.ВидыУчетаВФункциональнойВалюте.ВВалютеРегл, , ДанныеКурсовСценария);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ОстаткиПоПоказателюБюджетов = МенеджерВременныхТаблиц.Таблицы.Найти("ОстаткиПоРасчетнымПоказателям").ПолучитьДанные().Выгрузить();
	Если ЕстьПлановыеОбороты Тогда
		ОбщегоНазначенияУТКлиентСервер.ДополнитьТаблицу(МенеджерВременныхТаблиц.Таблицы.Найти(
			"ПлановыеОбороты").ПолучитьДанные().Выгрузить(), ОстаткиПоПоказателюБюджетов);
	КонецЕсли;
	
	СвернутьТаблицуОстатковПередЗагрузкой(ОстаткиПоПоказателюБюджетов);
	
	Объект.ОстаткиРасчетногоПоказателя.Загрузить(ОстаткиПоПоказателюБюджетов);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьПлановыеОборотыПоВлияющимСтатьямБюджетов(НастройкиЗаполнения, ГраницаОстатков,
	МенеджерВременныхТаблиц, ДанныеКурсовСценария)
	
	ПравилаРасчетаПоказателя = БюджетированиеСервер.ПолучитьПравилаРасчетаПоказателейБюджетов(НастройкиЗаполнения);
	ЗапросПоПравиламРасчета = БюджетированиеСервер.СформироватьЗапросКИсточникуДанныхПоПравиламРасчета(
		ПравилаРасчетаПоказателя.ВыгрузитьКолонку("ПравилоРасчета"), "План");
	ТекстЗапроса = ЗапросПоПравиламРасчета.ТекстЗапроса;
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	ИсключаемыеИзЗапросаПоля = Новый Массив;
	ИсключаемыеИзЗапросаПоля.Добавить("ПериодДень");
	ИсключаемыеИзЗапросаПоля.Добавить("ПериодПланирования");
	ИсключаемыеИзЗапросаПоля.Добавить("СтатьяБюджетов");
	Если Не ПоОрганизациям Тогда
		ИсключаемыеИзЗапросаПоля.Добавить("Организация");
	КонецЕсли;
	Если Не ПоПодразделениям Тогда
		ИсключаемыеИзЗапросаПоля.Добавить("Подразделение");
	КонецЕсли;
	
	ШаблонТекстаИсключаемогоПоля = "ПсевдонимТаблицыИсточника.%1 КАК %2";
	ШаблонТекстаДобавляемогоПоля = "НЕОПРЕДЕЛЕНО КАК %1";
	Для Каждого ИсключаемоеПоле Из ИсключаемыеИзЗапросаПоля Цикл
		ТекстИсключаемогоПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаИсключаемогоПоля, ИсключаемоеПоле, ИсключаемоеПоле);
		ТекстДобавляемогоПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаДобавляемогоПоля, ИсключаемоеПоле);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстИсключаемогоПоля, ТекстДобавляемогоПоля);
	КонецЦикла;
	
	ШаблонТекстаИсключаемогоПоля = "ПсевдонимТаблицыИсточника.Аналитика%1 КАК Аналитика%1Источника";
	ШаблонТекстаДобавляемогоПоля = "НЕОПРЕДЕЛЕНО КАК Аналитика%1Источника";
	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
		ТекстИсключаемогоПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаИсключаемогоПоля, НомерАналитики);
		ТекстДобавляемогоПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаДобавляемогоПоля, НомерАналитики);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстИсключаемогоПоля, ТекстДобавляемогоПоля);
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловияПоТаблицеИсточникаИПоляКомпановки",
		"Сценарий = &Сценарий И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "{&ДатаАктуальности}", "&ДатаАктуальности");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Данные.ПоказательБюджетов КАК ПоказательБюджетов,
	|	Данные.Сценарий КАК Сценарий,
	|	&ТекстПоляОрганизация,
	|	&ТекстПоляПодразделение,
	|	ВЫБОР
	|		КОГДА &УчитыватьПоВалюте
	|			ТОГДА &ТекстПоляВалюта
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА &УчитыватьПоВалюте
	|			ТОГДА Данные.Валюта
	|		ИНАЧЕ &ВалютаУпр
	|	КОНЕЦ КАК ВалютаХранения,
	|	&ТекстПолейАналитик,
	|	Данные.КоличествоОборот * ВЫБОР КОГДА Данные.Расход ТОГДА -1 ИНАЧЕ 1 КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА &УчитыватьПоВалюте
	|			ТОГДА Данные.СуммаВВалютеОборот
	|		ИНАЧЕ Данные.СуммаУпрОборот
	|	КОНЕЦ * ВЫБОР КОГДА Данные.Расход ТОГДА -1 ИНАЧЕ 1 КОНЕЦ КАК СуммаВВалютеХранения,
	|	Данные.СуммаУпрОборот * ВЫБОР КОГДА Данные.Расход ТОГДА -1 ИНАЧЕ 1 КОНЕЦ КАК СуммаУпр,
	|	Данные.СуммаРеглОборот * ВЫБОР КОГДА Данные.Расход ТОГДА -1 ИНАЧЕ 1 КОНЕЦ КАК СуммаРегл,
	|	&ПериодКурса КАК ПериодКурса
	|ПОМЕСТИТЬ ПлановыеОбороты
	|ИЗ
	|	Данные КАК Данные";
	МассивПолейАналитик = Новый Массив;
	Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
		МассивПолейАналитик.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Данные.Аналитика%1",
			НомерАналитики));
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстПолейАналитик", СтрСоединить(МассивПолейАналитик, "," + Символы.ПС
		+ Символы.Таб));
	Если ЗначениеЗаполнено(ПараметрыПоказателя.АдресАналитикиВалюта) Тогда
		ТипыАналитикиВалюты = ВидыАналитикПоказателя[СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"ВидАналитики%1ТипЗначения", ПараметрыПоказателя.АдресАналитикиВалюта)].Типы();
		МассивВыраженийВалюты = Новый Массив;
		ШаблонВыраженияВалюты = "КОГДА ТИПЗНАЧЕНИЯ(Данные.Аналитика%1) = ТИП(%2)
			|	ТОГДА ВЫРАЗИТЬ (Данные.Аналитика%1 КАК %2).%3"; // @query-part
		Для Каждого ТипАналитикиВалюты Из ТипыАналитикиВалюты Цикл
			МассивВыраженийВалюты.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыраженияВалюты,
			ПараметрыПоказателя.АдресАналитикиВалюта, ФинансовыйУчетПоДаннымБалансовыхРегистров.ПолноеИмяТипа(
			ТипАналитикиВалюты), ПараметрыПоказателя.ЗаполнениеВалюты));
		КонецЦикла;
		ТекстПоляВалюта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ВЫБОР %1 КОНЕЦ", СтрСоединить(
			МассивВыраженийВалюты, Символы.ПС + Символы.Таб));
	Иначе
		ТекстПоляВалюта = "Данные.Валюта";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстПоляВалюта", ТекстПоляВалюта);
	Если ПоОрганизациям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстПоляОрганизация", "Данные.Организация КАК Организация");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстПоляОрганизация,", "");
	КонецЕсли;
	Если ПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстПоляПодразделение", "Данные.Подразделение КАК Подразделение");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстПоляПодразделение,", "");
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() + Запрос.Текст;
	
	Для Каждого ПараметрЗапроса Из ЗапросПоПравиламРасчета.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
	КонецЦикла;
	Запрос.УстановитьПараметр("ДатаАктуальности", Объект.Дата);
	Запрос.УстановитьПараметр("Сценарий", Объект.Сценарий);
	Запрос.УстановитьПараметр("ВыражениеНачалоПериода", КонецДня(ГраницаОстатков) + 1);
	Запрос.УстановитьПараметр("ВыражениеКонецПериода", Объект.ДатаОстатков-1);
	Запрос.УстановитьПараметр("УчитыватьПоВалюте", ПараметрыПоказателя.УчитыватьПоВалюте);
	Запрос.УстановитьПараметр("ВалютаУпр", ЗначениеНастроекПовтИсп.ВалютаУправленческогоУчета());
	Запрос.УстановитьПараметр("ПериодКурса", Объект.ДатаОстатков);
	
	Запрос.Выполнить();
	
	ПараметрыТаблицыДанных = БюджетированиеСервер.ПараметрыПересчетаТаблицыДанныхВВалюту();
	ПараметрыТаблицыДанных.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
	ПараметрыТаблицыДанных.ИмяВременнойТаблицы = "ПлановыеОбороты";
	БюджетированиеСервер.ПересчитатьТаблицуДанныхВВалюту(ПараметрыТаблицыДанных, Неопределено,
		Перечисления.ВидыУчетаВФункциональнойВалюте.ВВалютеРегл, , ДанныеКурсовСценария);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПолученияФактаПоНастройкамЗаполнения()
	
	ПараметрыПолученияФакта = БюджетированиеСервер.ШаблонПараметровПолученияФакта();
	
	ПараметрыПолученияФакта.ОстаткиТолькоНаНачалоПериода = Истина;
	ПараметрыПолученияФакта.Период = Новый СтандартныйПериод(Объект.ДатаОстатков, Объект.ДатаОстатков);
	
	ПараметрыПолученияФакта.ПоОрганизациям = ПоОрганизациям;
	ПараметрыПолученияФакта.ПоПодразделениям = ПоПодразделениям;
	
	Возврат ПараметрыПолученияФакта;

КонецФункции

&НаСервере
Процедура СвернутьТаблицуОстатковПередЗагрузкой(ТаблицаОстатков)
	
	КолонкиГруппировок = Новый Массив;
	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
		КолонкиГруппировок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Аналитика%1", НомерАналитики));
	КонецЦикла;
	Если ТаблицаОстатков.Колонки.Найти("Организация") <> Неопределено Тогда
		КолонкиГруппировок.Добавить("Организация");
	КонецЕсли;
	Если ТаблицаОстатков.Колонки.Найти("Подразделение") <> Неопределено Тогда
		КолонкиГруппировок.Добавить("Подразделение");
	КонецЕсли;
	КолонкиГруппировок.Добавить("Валюта");
	КолонкиСуммирования = "Количество,СуммаВВалюте,СуммаУпр,СуммаРегл";
	ТаблицаОстатков.Свернуть(СтрСоединить(КолонкиГруппировок, ","), КолонкиСуммирования);
	
	СтруктураПоискаПустыхСтрок = Новый Структура(КолонкиСуммирования, 0,0,0,0);
	ОбщегоНазначенияУТ.НайтиИУдалитьСтрокиТаблицыЗначений(ТаблицаОстатков, СтруктураПоискаПустыхСтрок);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьВоВременноеХранилищеТаблицуКурсовСценария()
	
	ТаблицаКурсовСценария = Справочники.Сценарии.ТаблицаКурсовСценария(Объект.Сценарий, ,
		НачалоГода(ТекущаяДатаСеанса()), Объект.ДатаОстатков-1);
	АдресТаблицыКурсовСценария = ПоместитьВоВременноеХранилище(ТаблицаКурсовСценария, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВалютуИзЗначенияАналитики(ЗначениеАналитики)
	
	КэшЗначенийАналитик = ПолучитьИзВременногоХранилища(АдресКэшаЗначенийАналитик);
	Валюта = БюджетнаяОтчетностьВыводСервер.Подключаемый_ЗначениеИзАналитики(КэшЗначенийАналитик,
		ЗначениеАналитики, ПараметрыПоказателя.ЗаполнениеВалюты);
	АдресКэшаЗначенийАналитик = ПоместитьВоВременноеХранилище(КэшЗначенийАналитик, УникальныйИдентификатор);
	
	Возврат Валюта;
	
КонецФункции

&НаСервере
Процедура ПересчитатьСуммыУпрИРеглВСтрокеТабличнойЧасти(ИдентификаторСтроки, ПересчитатьСуммуУпр, ПересчитатьСуммуРегл)
	
	СтрокаТабличнойЧасти = Объект.ОстаткиРасчетногоПоказателя.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	БазоваяВалюта = ЗначениеНастроекПовтИсп.БазоваяВалютаПоУмолчанию();
	
	КэшКурсовВалют = ПолучитьИзВременногоХранилища(АдресКэшаКурсовВалют);
	КоличествоЗаписейКэша = КэшКурсовВалют.Количество();
	
	Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Валюта) Тогда
		КурсВалюты = РаботаСКурсамиВалютУТ.ПолучитьКурсВалютыИзКэша(СтрокаТабличнойЧасти.Валюта, Объект.ДатаОстатков,
			КэшКурсовВалют, БазоваяВалюта);
	КонецЕсли;
	
	Если ПересчитатьСуммуУпр Или Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Валюта) Тогда
		КурсВалютыУпр = РаботаСКурсамиВалютУТ.ПолучитьКурсВалютыИзКэша(ВалютаУпрУчета, Объект.ДатаОстатков, КэшКурсовВалют,
			БазоваяВалюта);
	КонецЕсли;
	Если ПересчитатьСуммуУпр Тогда
		СтрокаТабличнойЧасти.СуммаУпр = ?(КурсВалютыУпр = 0, 0, СтрокаТабличнойЧасти.СуммаВВалюте * КурсВалюты / КурсВалютыУпр);
	КонецЕсли;
	
	Если ПересчитатьСуммуРегл Тогда
		Если ПоОрганизациям И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Организация) Тогда
			КурсВалютыРегл = РаботаСКурсамиВалютУТ.ПолучитьКурсВалютыИзКэша(
				ЗначениеНастроекКлиентСерверПовтИсп.ВалютаРегламентированногоУчетаОрганизации(
				СтрокаТабличнойЧасти.Организация), Объект.ДатаОстатков, КэшКурсовВалют, БазоваяВалюта);
		Иначе
			КурсВалютыРегл = РаботаСКурсамиВалютУТ.ПолучитьКурсВалютыИзКэша(ВалютаРеглУчета, Объект.ДатаОстатков,
				КэшКурсовВалют, БазоваяВалюта);
		КонецЕсли;
		СтрокаТабличнойЧасти.СуммаРегл = ?(КурсВалютыРегл = 0, 0, СтрокаТабличнойЧасти.СуммаВВалюте * ?(ЗначениеЗаполнено(
			СтрокаТабличнойЧасти.Валюта), КурсВалюты, КурсВалютыУпр) / КурсВалютыРегл);
	КонецЕсли;
	
	Если КэшКурсовВалют.Количество() > КоличествоЗаписейКэша Тогда
		ПоместитьВоВременноеХранилище(КэшКурсовВалют, УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыУпрИРеглПоПрогнознымКурсамВСтрокеТабличнойЧасти(ИдентификаторСтроки, ПересчитатьСуммуУпр, ПересчитатьСуммуРегл)
	
	СтрокаТабличнойЧасти = Объект.ОстаткиРасчетногоПоказателя.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ТаблицаКурсовСценария = ПолучитьИзВременногоХранилища(АдресТаблицыКурсовСценария);
	
	Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Валюта) Тогда
		СтрокаТаблицыКурсов = ТаблицаКурсовСценария.Найти(СтрокаТабличнойЧасти.Валюта, "Валюта");
		КурсВалюты = ?(СтрокаТаблицыКурсов = Неопределено, 0, СтрокаТаблицыКурсов.Курс);
	КонецЕсли;
	
	Если ПересчитатьСуммуУпр Или Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Валюта) Тогда
		СтрокаТаблицыКурсов = ТаблицаКурсовСценария.Найти(ВалютаУпрУчета, "Валюта");
		КурсВалютыУпр = ?(СтрокаТаблицыКурсов = Неопределено, 0, СтрокаТаблицыКурсов.Курс);
	КонецЕсли;
	Если ПересчитатьСуммуУпр Тогда
		СтрокаТабличнойЧасти.СуммаУпр = ?(КурсВалютыУпр = 0, 0, СтрокаТабличнойЧасти.СуммаВВалюте * КурсВалюты / КурсВалютыУпр);
	КонецЕсли;
	
	Если ПересчитатьСуммуРегл Тогда
		Если ПоОрганизациям И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Организация) Тогда
			СтрокаТаблицыКурсов = ТаблицаКурсовСценария.Найти(
				ЗначениеНастроекКлиентСерверПовтИсп.ВалютаРегламентированногоУчетаОрганизации(
				СтрокаТабличнойЧасти.Организация), "Валюта");
		Иначе
			СтрокаТаблицыКурсов = ТаблицаКурсовСценария.Найти(ВалютаРеглУчета, "Валюта");
		КонецЕсли;
		КурсВалютыРегл = ?(СтрокаТаблицыКурсов = Неопределено, 0, СтрокаТаблицыКурсов.Курс);
		СтрокаТабличнойЧасти.СуммаРегл = ?(КурсВалютыРегл = 0, 0, СтрокаТабличнойЧасти.СуммаВВалюте * ?(ЗначениеЗаполнено(
			СтрокаТабличнойЧасти.Валюта), КурсВалюты, КурсВалютыУпр) / КурсВалютыРегл);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтрокаДублируетСуществующую(ТекущаяСтрока, НомерСтрокиДубля)
	
	СтрокаТаблицы = Объект.ОстаткиРасчетногоПоказателя.НайтиПоИдентификатору(ТекущаяСтрока);
	
	КолонкиПоиска = СтрРазделить("Организация,Подразделение,Валюта", ",");
	Для НомерАналитики = 1 По БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик() Цикл
		КолонкиПоиска.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Аналитика%1", НомерАналитики));
	КонецЦикла;
	СтруктураПоиска = Новый Структура;
	Для Каждого Колонка Из КолонкиПоиска Цикл
		СтруктураПоиска.Вставить(Колонка, СтрокаТаблицы[Колонка]);
	КонецЦикла;
	
	НайденныеСтроки = Объект.ОстаткиРасчетногоПоказателя.НайтиСтроки(СтруктураПоиска);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока <> СтрокаТаблицы Тогда
			НомерСтрокиДубля = НайденнаяСтрока.НомерСтроки;
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
