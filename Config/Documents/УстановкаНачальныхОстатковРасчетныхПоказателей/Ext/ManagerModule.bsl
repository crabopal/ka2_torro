#Область ПроведениеДокумента

Процедура СформироватьТаблицаНачальныеОстаткиРасчетныхПоказателей(ТаблицыДляДвижений, Документ, Регистры)
	
	ИмяРегистра = "НачальныеОстаткиРасчетныхПоказателей";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	УстановкаНачальныхОстатковРасчетныхПоказателей.ДатаОстатков КАК ДатаОстатков,
	|	УстановкаНачальныхОстатковРасчетныхПоказателей.ПоказательБюджетов КАК ПоказательБюджетов,
	|	УстановкаНачальныхОстатковРасчетныхПоказателей.Сценарий КАК Сценарий
	|ПОМЕСТИТЬ Реквизиты
	|ИЗ
	|	Документ.УстановкаНачальныхОстатковРасчетныхПоказателей КАК УстановкаНачальныхОстатковРасчетныхПоказателей
	|ГДЕ
	|	УстановкаНачальныхОстатковРасчетныхПоказателей.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Реквизиты.ДатаОстатков КАК ДатаОстатков,
	|	Реквизиты.ПоказательБюджетов КАК ПоказательБюджетов,
	|	Реквизиты.Сценарий КАК Сценарий,
	|	ОстаткиРасчетногоПоказателя.Организация КАК Организация,
	|	ОстаткиРасчетногоПоказателя.Подразделение КАК Подразделение,
	|	&ТекстПолейАналитик,
	|	ОстаткиРасчетногоПоказателя.Валюта КАК Валюта,
	|	ОстаткиРасчетногоПоказателя.Количество КАК Количество,
	|	ОстаткиРасчетногоПоказателя.СуммаВВалюте КАК СуммаВВалюте,
	|	ОстаткиРасчетногоПоказателя.СуммаУпр КАК СуммаУпр,
	|	ОстаткиРасчетногоПоказателя.СуммаРегл КАК СуммаРегл
	|ИЗ
	|	Документ.УстановкаНачальныхОстатковРасчетныхПоказателей.ОстаткиРасчетногоПоказателя КАК ОстаткиРасчетногоПоказателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Реквизиты КАК Реквизиты
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ОстаткиРасчетногоПоказателя.Ссылка = &Ссылка";
	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	МассивПолейАналитик = Новый Массив;
	Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
		МассивПолейАналитик.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"ОстаткиРасчетногоПоказателя.Аналитика%1 КАК Аналитика%1", НомерАналитики));
	КонецЦикла;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПолейАналитик", СтрСоединить(МассивПолейАналитик, "," + Символы.ПС + Символы.Таб));
	Запрос.Текст = ТекстЗапроса;
	
	ТаблицаПроведения = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений.Вставить("ТаблицаНачальныеОстаткиРасчетныхПоказателей", ТаблицаПроведения);
	
КонецПроцедуры

