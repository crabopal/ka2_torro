#Область Печать

// Процедура - Выполнить команду печати завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВыполнитьКомандуПечатиЗавершение(Результат, Команда) Экспорт
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	Если НЕ ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда
		ОписаниеКоманды.Вставить("ДополнительныеПараметры", Новый Структура());
	КонецЕсли;
	
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКоманды ="питОП1_СПараметрами" ИЛИ ИдентификаторКоманды ="питОП1_ТБ_СПараметрами" Тогда
		ОписаниеКоманды.ДополнительныеПараметры.ДополнительныеПараметры.Вставить("СтруктураПараметровОП1", Результат);
	Иначе
		Возврат;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
	
КонецПроцедуры

#КонецОбласти

#Область Серии

// Процедура - Открыть подбор серий завершение.
//
// Параметры:
//  РезультатЗакрытия - Произвольный - Результат закрытия.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОткрытьПодборСерийЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		ОбработатьУказаниеСерийСервер(ДополнительныеПараметры.ИмяТЧ, ДополнительныеПараметры.ПараметрыУказанияСерий, ДополнительныеПараметры.ПараметрыФормыУказанияСерий);
		Если ДополнительныеПараметры.ПараметрыУказанияСерий.ИмяТЧТовары = "Товары" Тогда
			ИзмененыТовары = Истина;
			УправлениеФормой(ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - После закрытия вопроса перед записью.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ПослеЗакрытияВопросаПередЗаписью(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		КомандаЗаполнитьПроизводство(Неопределено);
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Записать(Новый Структура("ПовторныйВызов", Истина));
	КонецЕсли;
	
КонецПроцедуры

// Процедура - После закрытия вопроса изменение типа цен.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ПослеЗакрытияВопросаИзменениеТипаЦен(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьЦеныПоВидуЦенСервер(Объект.ТипЦен);
		Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
	КонецЕсли;
КонецПроцедуры

