// Процедура - Вопрос об изменении рецептуры блюда завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ВопросОбИзмененииРецептурыБлюдаЗавершение(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		БлюдаРецептураПриИзмененииНаСервере(Элементы.Блюда.ТекущаяСтрока);
	Иначе
		// Пользовтаель не захотел делать пересчет, откатываем значение рецептуры на предыдущее.
		ТекущееБлюдо = Элементы.Блюда.ТекущиеДанные;
		Если НЕ ТекущееБлюдо = Неопределено Тогда
			ТекущееБлюдо.Рецептура = ТекущееБлюдо.РецептураПред;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура - Товары рецептура при изменении завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ТоварыРецептураПриИзмененииЗавершение(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ТоварыРецептураПриИзмененииНаСервере(Элементы.Товары.ТекущаяСтрока);
	Иначе
		// Пользовтаель не захотел делать пересчет, откатываем значение рецептуры на предыдущее.
		ТекущийТовар = Элементы.Товары.ТекущиеДанные;
		Если НЕ ТекущийТовар = Неопределено Тогда
			ТекущийТовар.Рецептура = ТекущийТовар.РецептураПред;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


#КонецОбласти

#КонецОбласти

#Область ПолучитьВес

// Процедура - Получить вес завершение.
//
// Параметры:
//  РезультатВыполнения - Произвольный - Результат выполнения.
//  ТекущаяСтрока - Строка - Текущая строка.
//
&НаКлиенте
Процедура ПолучитьВесЗавершение(РезультатВыполнения, ТекущаяСтрока) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ТекущаяСтрока.КоличествоУпаковок = РезультатВыполнения.Вес;
		
		СтруктураДействий = Новый Структура;
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок("Товары", СтруктураДействий);
		
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		// РассчитатьИтоговыеПоказателиПоступления(ЭтаФорма);
	Иначе
		МенеджерОборудованияУТКлиент.СообщитьОбОшибке(РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

