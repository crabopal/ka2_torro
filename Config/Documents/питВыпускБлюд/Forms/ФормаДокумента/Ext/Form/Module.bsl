// Процедура - Команда заполнить производство.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура КомандаЗаполнитьПроизводство(Команда)
	// Проверим на возможность этого действия
	Если НЕ Объект.Ссылка.Пустая() Тогда
		// Продолжаем
	КонецЕсли;
	
	// +АвтовыборНоменклатуры
	Объект.УточненияАвтовыбора.Очистить();
	// +АвтовыборНоменклатуры
	
	ЗаполнитьПроизводства();
	
	ИзмененыТовары = Ложь;
	УправлениеФормой(ЭтаФорма);
	БлюдаПриАктивизацииСтроки(Неопределено);
	
	// Перезаполнили производство, взводим флаг модифицированности формы.
	Модифицированность = Истина;
	
КонецПроцедуры

// Процедура - Очистить производство.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ОчиститьПроизводство(Команда)
	Объект.Блюда.Очистить();
	Объект.Ингредиенты.Очистить();
	Объект.Замены.Очистить();
	Объект.Трудозатраты.Очистить();
	Объект.ПобочныеИзделия.Очистить();
	// +АвтовыборНоменклатуры
	Объект.УточненияАвтовыбора.Очистить();
	// -АвтовыборНоменклатуры
	Если Объект.Товары.Количество() Тогда
		ИзмененыТовары = Истина;
		УправлениеФормой(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

// Процедура - Подбор по меню.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборПоМеню(Команда)
		
	Отказ = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ",        Объект.Ссылка);
	ПараметрыФормы.Вставить("Склад",      Объект.Склад);
	ПараметрыФормы.Вставить("Дата",       Объект.Дата);
	ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти", Истина);
	ПараметрыФормы.Вставить("РежимПодбораИсключитьГруппыДоступныеВЗаказах",  Истина);
	
	
	ОткрытьФорму("Обработка.питПодборТоваровПоМеню.Форма", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	

КонецПроцедуры

