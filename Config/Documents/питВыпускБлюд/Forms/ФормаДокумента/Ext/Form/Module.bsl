// Процедура - Товары выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если (Поле = Элементы["ТоварыСерия"] 
				ИЛИ Поле = Элементы["ТоварыСтатусУказанияСерий"]) Тогда
		ТаблицаВыборСерии("Товары", Поле, Элемент, СтандартнаяОбработка);
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.ТоварыРецептура
		// +ИзменениеФактаВПроизводстве
		И Объект.РежимРасчетаСписанияВПроизводство = ПредопределенноеЗначение("Перечисление.питРежимыРасчетаСписанияВПроизводство.ПоНорме") Тогда
		// -ИзменениеФактаВПроизводстве
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Рецептура);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Товары при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
