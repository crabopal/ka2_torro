// Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИмяСклад - Произвольный - Имя склад.
//  ТекущаяСтрока - Строка - Текущая строка.
//
&НаКлиенте
Процедура ТаблицаНоменклатураПриИзменении(ИмяТЧ, ИмяСклад = Неопределено, ТекущаяСтрока = Неопределено)
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
											
	Если ИмяТЧ = "Модификаторы" Тогда
		ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий, "УпаковкаНоменклатуры");
	Иначе
		ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
	КонецЕсли;
	
	Если ИмяТЧ <> "Модификаторы" Тогда
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	КонецЕсли;
	
	// +Серии
	Если ИмяТЧ <> "Ингредиенты" И ИмяТЧ <> "Замены" 
		И ИмяТЧ <> "Модификаторы" Тогда // Заглушка
		Если ИмяСклад = Неопределено Тогда
			ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
		Иначе
			ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, ТекущаяСтрока[ИмяСклад], ПараметрыУказанияСерий[ИмяТЧ]);
		КонецЕсли;
	КонецЕсли;
	// -Серии
	
	Если ИмяТЧ = "Товары" И ЭтоРозница И ТекущаяСтрока.Цена = 0 Тогда
		ПараметрыОбъекта = Новый Структура;
		ПараметрыОбъекта.Вставить("Дата", Объект.Дата);
		ПараметрыОбъекта.Вставить("Валюта", Объект.Валюта);
		ПараметрыОбъекта.Вставить("ВидЦены", РозничныйВидЦены(Объект.СкладПолучатель));
		Если ЗначениеЗаполнено(ПараметрыОбъекта.ВидЦены) Тогда
			СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияЦеныРозницаВСтрокеТЧ(ПараметрыОбъекта));
		КонецЕсли;	
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
	
	Если ИмяТЧ = "ВыходныеИзделия"
		ИЛИ ИмяТЧ = "ПобочныеИзделия" Тогда
		
		Если ИмяТЧ = "ВыходныеИзделия" Тогда
			ТекущаяСтрока.Получатель = ПолучательПоУмолчанию(ТекущаяСтрока);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Функция - Розничный вид цены.
//
// Параметры:
//  Склад - Произвольный - Склад.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервереБезКонтекста
Функция РозничныйВидЦены(Склад)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "РозничныйВидЦены");
КонецФункции

// Процедура - Таблица количество упаковок при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаКоличествоУпаковокПриИзменении(ИмяТЧ)
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;

	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	
	Если ИмяТЧ = "ПобочныеИзделия" Тогда
		СтруктураДействий.Вставить("ПересчитатьСумму");
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
	
КонецПроцедуры

// Процедура - Таблица упаковка при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаУпаковкаПриИзменении(ИмяТЧ)
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
	
КонецПроцедуры

#КонецОбласти

#Область ПобочныеИзделияСлужебныеФункции

// Процедура - Добавить в структуру действия при изменении количества упаковок.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчета);
	Если ИмяТЧ = "ПобочныеИзделия" Тогда
		СтруктураДействий.Вставить("ПересчитатьСумму");
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//  ИмяРеквизитаУпаковка - Строка - Имя реквизита упаковка.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий, ИмяРеквизитаУпаковка = "Упаковка")

	Объект = Форма.Объект;
	
	Если Не ТекущаяСтрока = Неопределено Тогда
		СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока[ИмяРеквизитаУпаковка]);
	Иначе
		СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу");
	КонецЕсли;
	
	Если ИмяТЧ = "Товары" Тогда
		ПараметрыЗаполненияСтавкиНДС = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияСтавкиНДС(Объект);
		СтруктураПересчетаСуммы = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ПараметрыЗаполненияСтавкиНДС);
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
	КонецЕсли;
	
	Если ИмяТЧ <> "Ингредиенты" И ИмяТЧ <> "Замены" Тогда
		СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул",
		Новый Структура("Номенклатура", "Артикул"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
		Новый Структура("Номенклатура", "ТипНоменклатуры"));
	КонецЕсли;
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		Форма.ИмяФормы, ИмяТЧ));
	
	Если ИмяТЧ = "Замены" Тогда
		Если Форма.Элементы[ИмяТЧ].ТекущийЭлемент = Форма.Элементы.ЗаменыИнгредиентИсходный Тогда
			СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
			Новый Структура("ИнгредиентИсходный", "ХарактеристикиИнгредиентаИсходногоИспользуются"));
		Иначе
			СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
			Новый Структура("ИнгредиентЗамена", "ХарактеристикиИнгредиентаЗаменаИспользуются"));
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяТЧ = "Ингредиенты" Тогда
		СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Ингредиент", "ХарактеристикиИспользуются"));
	КонецЕсли;
	
КонецПроцедуры

// Функция - Получатель по умолчанию.
//
// Параметры:
//  ТекСтрока - Строка - Тек строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ПолучательПоУмолчанию(ТекСтрока)
	
	СтруктураСтроки = Новый Структура("НаправлениеВыпуска, Получатель");
	ЗаполнитьЗначенияСвойств(СтруктураСтроки, ТекСтрока);
	СтруктураСтроки.НаправлениеВыпуска = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыпускПродукцииНаСклад");
	
	Возврат ПолучательПоУмолчаниюНаСервере(СтруктураСтроки);
	
КонецФункции

// Функция - Получатель по умолчанию на сервере.
//
// Параметры:
//  ТекСтрока - Строка - Тек строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолучательПоУмолчаниюНаСервере(ТекСтрока)
	
	Если ТекСтрока.НаправлениеВыпуска = Перечисления.ХозяйственныеОперации.ВыпускПродукцииВПодразделение
		И Не ЗначениеЗаполнено(ТекСтрока.Получатель) Тогда
		Возврат Объект.Подразделение;
	ИначеЕсли ТекСтрока.НаправлениеВыпуска = Перечисления.ХозяйственныеОперации.ВыпускПродукцииНаСклад Тогда
		Если ТипЗнч(ТекСтрока.Получатель) = Тип("СправочникСсылка.Склады")
			И Не ТекСтрока.Получатель.Подразделение = Объект.Подразделение Тогда
			ТекСтрока.Получатель = Неопределено;
		КонецЕсли;
		Возврат ЗначениеНастроекПовтИсп.ПолучитьЦеховуюКладовуюПоУмолчанию(Объект.Подразделение, ТекСтрока.Получатель);
	Иначе
		Возврат ТекСтрока.Получатель;
	КонецЕсли;
	
КонецФункции

// Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
											
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.ПобочныеИзделия,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
											
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("Блюдо", "ХарактеристикиБлюдаИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Замены,	ПараметрыЗаполненияРеквизитов);
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("ИнгредиентИсходный", "ХарактеристикиИнгредиентаИсходногоИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Замены,	ПараметрыЗаполненияРеквизитов);
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("ИнгредиентЗамена", "ХарактеристикиИнгредиентаЗаменаИспользуются"));
	
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Замены,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Блюда,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Ингредиент", "ХарактеристикиИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Ингредиенты,	ПараметрыЗаполненияРеквизитов);
	// +ИзменениеФактаВПроизводстве
	Для каждого ТекИнгредиент Из Объект.Ингредиенты Цикл
		ТекИнгредиент.КоличествоУпаковокИнгредиентаФактПред = ТекИнгредиент.КоличествоУпаковокИнгредиентаФакт;
		ТекИнгредиент.КоличествоИнгредиентаФактПред = ТекИнгредиент.КоличествоИнгредиентаФакт;
		ТекИнгредиент.РецептураАвтопеределаПред = ТекИнгредиент.РецептураАвтопередела;
	КонецЦикла;
	Для каждого ТекБлюдо Из Объект.Блюда Цикл
		ТекБлюдо.РецептураПред = ТекБлюдо.Рецептура;
	КонецЦикла;
	Для каждого ТекТовар Из Объект.Товары Цикл
		ТекТовар.РецептураПред = ТекТовар.Рецептура;
	КонецЦикла;
	// -ИзменениеФактаВПроизводстве
	
	// +Модификаторы
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
											
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Модификаторы,	ПараметрыЗаполненияРеквизитов);
	// -Модификаторы
	
	
КонецПроцедуры

// Процедура обновляет отбор таблицы Трудозатрат на форме по текущему значению идентификатора строки в таблице блюд.
//
&НаКлиенте
Процедура ОбновитьОтборСтрокВТаблицеПобочныхИзделий()
	
	Перем ТекДанные;
	
	ТекДанные = Элементы.БлюдаПобочныеИзделия.ТекущиеДанные;
	Если ТекДанные <>  Неопределено Тогда
		Элементы.ПобочныеИзделия.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", ТекДанные.ИдентификаторСтроки);
	Иначе
		Элементы.ПобочныеИзделия.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", "xxx");/// Скроем
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Серии

// Процедура - Заполнить параметры указания серий.
//
&НаСервере
Процедура ЗаполнитьПараметрыУказанияСерий()
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питВыпускБлюд));
	
КонецПроцедуры

// Функция - Параметры формы указания серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущиеДанныеИдентификатор - Произвольный - Текущие данные идентификатор.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор)
	
	Возврат НоменклатураСервер.ПараметрыФормыУказанияСерий(Объект, ПараметрыУказанияСерий[ИмяТЧ], ТекущиеДанныеИдентификатор, ЭтаФорма);
	
КонецФункции

// Процедура - Установить видимость элементов серий.
//
&НаСервере
Процедура УстановитьВидимостьЭлементовСерий()
	
	Элементы.ТоварыСерия.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыУказатьСерии.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	
	Элементы.МодификаторыСерия.Видимость = ПараметрыУказанияСерий.Модификаторы.ИспользоватьСерииНоменклатуры;
	Элементы.МодификаторыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Модификаторы.ИспользоватьСерииНоменклатуры;
	Элементы.МодификаторыУказатьСерии.Видимость = ПараметрыУказанияСерий.Модификаторы.ИспользоватьСерииНоменклатуры;
	
	Элементы.ПобочныеИзделияСерия.Видимость = ПараметрыУказанияСерий.ПобочныеИзделия.ИспользоватьСерииНоменклатуры;
	Элементы.ПобочныеИзделияСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.ПобочныеИзделия.ИспользоватьСерииНоменклатуры;
//   Элементы.ПобочныеИзделияУказатьСерии.Видимость =
// ПараметрыУказанияСерий.ПобочныеИзделия.ИспользоватьСерииНоменклатуры;.
	
	Элементы.БлюдаСерия.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	Элементы.БлюдаСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	Элементы.ВыпущеннаяПродукцияЗаменыСерия.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	Элементы.ВыпущеннаяПродукцияЗаменыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	Элементы.БлюдаТрудозатратыСерия.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	Элементы.БлюдаТрудозатратыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	Элементы.БлюдаПобочныеИзделияСерия.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	Элементы.БлюдаПобочныеИзделияСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Блюда.ИспользоватьСерииНоменклатуры;
	
	Элементы.ИнгредиентыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Ингредиенты.ИспользоватьСерииНоменклатуры;
	
	Элементы.ЗаменыСтатусУказанияСерийИнгредиентаИсходный.Видимость = ПараметрыУказанияСерий.Замены.ИспользоватьСерииНоменклатуры;
	Элементы.ЗаменыСтатусУказанияСерийИнгредиентаЗамена.Видимость = ПараметрыУказанияСерий.Замены.ИспользоватьСерииНоменклатуры;
	
КонецПроцедуры

// Процедура - Обновить кешированные значения для учета серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ОбновитьКешированныеЗначенияДляУчетаСерий(ИмяТЧ, Элемент, КэшированныеЗначения, Копирование)
	
	Если ИмяТЧ = "Замены" ИЛИ ИмяТЧ = "Ингредиенты" Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(
				Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ], Копирование);
КонецПроцедуры

// Процедура - Открыть подбор серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Текст - Строка - Текст.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ОткрытьПодборСерий(ИмяТЧ, Текст = "", ТекущиеДанные = Неопределено)
	
	НуженСерверныйВызов = НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(
							ЭтаФорма, 
							ПараметрыУказанияСерий[ИмяТЧ], 
							Текст, 
							ТекущиеДанные);
	
	Если НуженСерверныйВызов Тогда
		
		Если ТекущиеДанные = Неопределено Тогда
			ТекущиеДанныеИдентификатор = Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
		Иначе
			ТекущиеДанныеИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		КонецЕсли;
		
		ПараметрыФормыУказанияСерий = ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор);
		ДополнительныеПараметры = Новый Структура("ПараметрыУказанияСерий,ПараметрыФормыУказанияСерий, ИмяТЧ", 
											ПараметрыУказанияСерий[ИмяТЧ], ПараметрыФормыУказанияСерий, ИмяТЧ);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьПодборСерийЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму(ПараметрыФормыУказанияСерий.ИмяФормы, 
						ПараметрыФормыУказанияСерий, 
						ЭтаФорма,,,,
						ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обработать указание серий сервер.
//
// Параметры:
//  Знач ИмяТЧ - Произвольный - Знач имя тч.
//  Знач ПараметрыУказанияСерий - Произвольный - Знач параметры указания серий.
//  Знач ПараметрыФормыУказанияСерий - Произвольный - Знач параметры формы указания серий.
//
&НаСервере
Процедура ОбработатьУказаниеСерийСервер(Знач ИмяТЧ, Знач ПараметрыУказанияСерий, Знач ПараметрыФормыУказанияСерий)
	
	Если ПараметрыУказанияСерий.ИмяТЧТовары = "Товары" 
		ИЛИ ПараметрыУказанияСерий.ИмяТЧТовары = "ПобочныеИзделия" Тогда

		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ОбновлятьКоличествоТоваровПриРегистрацииСерий", Истина);
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокСерии(
				Неопределено, 
				ПараметрыУказанияСерий.ИмяТЧТовары, 
				СтруктураДействий);
	Иначе
		СтруктураДействий = Неопределено;
	КонецЕсли; 
	
	НоменклатураСервер.ОбработатьУказаниеСерий(
		Объект, 
		ПараметрыУказанияСерий, 
		ПараметрыФормыУказанияСерий, 
		СтруктураДействий);
	
КонецПроцедуры

// Процедура - Заполнить статусы указания серий сервер.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтрокиТоваровДляОбработки - Произвольный - Строки товаров для обработки.
//  СтрокиСерийДляОбработки - Произвольный - Строки серий для обработки.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, СтрокиТоваровДляОбработки = Неопределено, СтрокиСерийДляОбработки = Неопределено)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий[ИмяТЧ], СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки);
	
КонецПроцедуры

// Процедура - Заполнить статусы указания серий при окончании редактирования строки тч.
//
// Параметры:
//  Знач ПараметрыУказанияСерий - Произвольный - Знач параметры указания серий.
//  ТекущаяСтрокаИдентификатор - Строка - Текущая строка идентификатор.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Знач ПараметрыУказанияСерий,
																			ТекущаяСтрокаИдентификатор,
																			КэшированныеЗначения)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Объект, 
				ПараметрыУказанияСерий, ТекущаяСтрокаИдентификатор, КэшированныеЗначения);
	
КонецПроцедуры

// Процедура - При чтении создании на сервере.
//
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	// +Серии
	ЗаполнитьПараметрыУказанияСерий();
	ЗаполнитьСтатусыУказанияСерийСервер("Товары");
	ЗаполнитьСтатусыУказанияСерийСервер("Модификаторы");
	ЗаполнитьСтатусыУказанияСерийСервер("ПобочныеИзделия");
	ЗаполнитьСтатусыУказанияСерийСервер("Блюда");
	ЗаполнитьСтатусыУказанияСерийСервер("Ингредиенты");
	ЗаполнитьСтатусыУказанияСерийСервер("Замены");
	УстановитьВидимостьЭлементовСерий();
	// -Серии
	
	НастроитьЭлементыФормы(ЭтаФорма);
	
КонецПроцедуры

// Процедура - Таблица серия при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаСерияПриИзменении(ИмяТЧ)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение						= Элементы[ИмяТЧ].ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки	= Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[ИмяТЧ], ВыбранноеЗначение);
	
КонецПроцедуры

// Процедура - Таблица выбор серии.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Поле - Произвольный - Поле.
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаВыборСерии(ИмяТЧ, Поле, Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекущиеДанные.СтатусУказанияСерий > 0
		И ТекущиеДанные.СтатусУказанияСерий <= 11 Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьПодборСерий(ИмяТЧ, Поле.ТекстРедактирования);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Таблица при окончании редактирования.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаПриОкончанииРедактирования(ИмяТЧ, Элемент)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если НоменклатураКлиент.НеобходимоОбновитьСтатусыСерий(
			Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ]) Тогда
		
		ТекущаяСтрокаИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		
		ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(ПараметрыУказанияСерий[ИмяТЧ], ТекущаяСтрокаИдентификатор, КэшированныеЗначения);
		НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ]);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедуру следует использовать, если строки были добавлены программно (не интерактивно), например, при вставке из
//  буфера, при заполнении по спецификации.
//  Процедура выполняет действия которые зависят от данных в строках.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  МассивИдентификаторовСтрок - Массив - Массив идентификаторов строк.
//  СтруктураРанееВыполненныхДействий - Структура - Структура ранее выполненных действий.
//
&НаСервере
Процедура ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивИдентификаторовСтрок = Неопределено, СтруктураРанееВыполненныхДействий = Неопределено)

	МассивСтрок = Неопределено;
	КоллекцияСтрок = Объект[ИмяТЧ];
	Если МассивИдентификаторовСтрок <> Неопределено Тогда
		МассивСтрок = Новый Массив;
		Для каждого ИдентификаторСтроки Из МассивИдентификаторовСтрок Цикл
			МассивСтрок.Добавить(Объект[ИмяТЧ].НайтиПоИдентификатору(ИдентификаторСтроки));
		КонецЦикла; 
		КоллекцияСтрок = МассивСтрок;
	КонецЕсли;
	
	Если СтруктураРанееВыполненныхДействий = Неопределено Тогда
		СтруктураРанееВыполненныхДействий = Новый Структура;
	КонецЕсли;
	
	Если ((ИмяТЧ = "Товары") ИЛИ (ИмяТЧ = "Модификаторы") ИЛИ (ИмяТЧ = "Блюда") ИЛИ (ИмяТЧ = "Ингредиенты")  ИЛИ (ИмяТЧ = "Замены"))
		И НЕ СтруктураРанееВыполненныхДействий.Свойство("ПроверитьСериюРассчитатьСтатус") Тогда
		ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, МассивСтрок, МассивСтрок);
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - Таблица обработка выбора.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаКлиенте
Процедура ТаблицаОбработкаВыбора(ИмяТЧ, ВыбранноеЗначение)
	
	ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ);
	
КонецПроцедуры

// Процедура - Таблица обработка выбора подбора на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаСервере
Процедура ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		СписокТоваров = ВыбранноеЗначение;
	Иначе
		СписокТоваров = Новый Массив;
		СписокТоваров.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	МассивСтрок = Новый Массив;
	Для каждого СтрокаТовара Из СписокТоваров Цикл
		
		ТекущаяСтрока = Объект[ИмяТЧ].Добавить();
		ТекущаяСтрока.Номенклатура = СтрокаТовара;
		
		ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(
				ИмяТЧ, 
				ТекущаяСтрока, 
				ЭтаФорма, 
				СтруктураДействий);
				
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
		
		МассивСтрок.Добавить(ТекущаяСтрока.ПолучитьИдентификатор());
		
	КонецЦикла;
	
	ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивСтрок, СтруктураДействий);
	
КонецПроцедуры

// Процедура - Добавить в структуру действия по сериям.
//
// Параметры:
//  СтруктураДействий - Структура - Структура действий.
//  Склад - Произвольный - Склад.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Склад, ПараметрыУказанияСерий)
	
	ПараметрыПроверкиСерий = Новый Структура("Склад, ПараметрыУказанияСерий", Склад, ПараметрыУказанияСерий);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПараметрыПроверкиСерий);
	
КонецПроцедуры

// Процедура - Таблица склад при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИмяСклад - Произвольный - Имя склад.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ТаблицаСкладПриИзменении(ИмяТЧ, ИмяСклад = Неопределено, ТекущиеДанные)
	
	// ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	Если ИмяСклад = Неопределено Тогда
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
	Иначе
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, ТекущиеДанные[ИмяСклад], ПараметрыУказанияСерий[ИмяТЧ]);
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

// Процедура - Склад при изменении на сервере.
//
&НаСервере
Процедура СкладПриИзмененииНаСервере()
	ЗаполнитьНалогообложениеНДС();
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		РеквизитыСклада = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Склад, "ЦеховаяКладовая, Подразделение");
		Если РеквизитыСклада.ЦеховаяКладовая 
			И Объект.Подразделение <> РеквизитыСклада.Подразделение Тогда
			Объект.Подразделение = РеквизитыСклада.Подразделение;
			ПодразделениеОрганизацииПриИзмененииНаСервере();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция - Заполнить цены по виду цен сервер.
//
// Параметры:
//  ВидЦен - Произвольный - Вид цен.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ЗаполнитьЦеныПоВидуЦенСервер(ВидЦен)
	
	ЦеныРассчитаны = Ложь;
	
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат ЦеныРассчитаны;
	КонецЕсли;
	
	ЦеныРассчитаны = ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(
		Объект.Товары,
		, // Массив строк или структура отбора
		Новый Структура( // Параметры заполнения
			"Дата, Валюта, ВидЦены",
			Объект.Дата,
			ВидЦен.ВалютаЦены,
			ВидЦен),
		Новый Структура( // Структура действий с измененными строками
			"ПересчитатьСумму",
			"КоличествоУпаковок"));
	
	Возврат ЦеныРассчитаны;
	
КонецФункции

#КонецОбласти

#Область Трудозатраты

// Процедура - Управление формой трудозатраты.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  Элементы - Произвольный - Элементы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормойТрудозатраты(Объект, Элементы)
	
	Элементы.ИсполнительТрудозатрат.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.ИсполнительТрудозатрат) И Объект.Трудозатраты.Количество();

КонецПроцедуры

// Процедура - Исполнитель получение данных выбора.
//
// Параметры:
//  ДанныеВыбора - Произвольный - Данные выбора.
//  Текст - Произвольный - Текст.
//  Параметры - Произвольный - Параметры.
//
&НаСервереБезКонтекста
Процедура ИсполнительПолучениеДанныхВыбора(ДанныеВыбора, Текст, Параметры)
	
	ДанныеВыбора = Новый СписокЗначений;
	ПроизводствоСервер.ЗаполнитьДанныеВыбораПриВводеИсполнителя(ДанныеВыбора, Текст, Параметры);
	
КонецПроцедуры

#КонецОбласти

#Область КопированиеВставкаСтрок

// Процедура - Скопировать строки на сервере.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура СкопироватьСтрокиНаСервере(ИмяТаблицы)
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(Объект[ИмяТаблицы], Элементы[ИмяТаблицы].ВыделенныеСтроки);
	
КонецПроцедуры

// Процедура - Получить строки из буфера обмена.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена(ИмяТаблицы)
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена();
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТаблицы, СтруктураДействий);
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект[ИмяТаблицы].Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		// Дозаполним еще реквизиты, такие как "Рецептура", "ЭтоБлюдо", "ЭтоТовар" и т.д.
		СписокСвойствСтрокой = "Номенклатура, Характеристика, ЭтоУслуга, ЭтоБлюдо, ПриготовлениеРазрешено, ЭтоТовар, Иконка, Рецептура, ИзмененФактБлюда, РецептураПред";
		ДанныеСтрокаТаблицы = Новый Структура(СписокСвойствСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, ТекущаяСтрока);
		
		СвойстваПараметрыОбъектаСтрокой = "ХозяйственнаяОперация, Организация, Дата, Ссылка, Подразделение, Склад";
		ПараметрыОбъекта = Новый Структура();
		ПараметрыОбъекта = Новый Структура(СвойстваПараметрыОбъектаСтрокой);
		ПараметрыОбъекта.Вставить("СпособРасчетаРецептуры", СпособРасчетаРецептуры);
		ПараметрыОбъекта.Вставить("ВосприниматьБлюдоБезРецептурыКакТовар", ВосприниматьБлюдоБезРецептурыКакТовар);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
		
		ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеСтрокаТаблицы);
		
	КонецЦикла;
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий[ИмяТаблицы]);
	
	
КонецПроцедуры

// Функция - Получить имя текущей табличной части.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ПолучитьИмяТекущейТабличнойЧасти()
	
	ИмяТекущейСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	ИмяТаблицы = "";
	Если ИмяТекущейСтраницы = "ГруппаТовары" Тогда
		
		ИмяТаблицы = "Товары";
		
	КонецЕсли;
	
	Возврат ИмяТаблицы;
	
КонецФункции

#КонецОбласти

#Область ИзменениеФактаВПроизводстве

#Область ОбработчикиСобытийБлюда

// Серверные вызовы

// Процедура - Блюда рецептура при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура БлюдаРецептураПриИзмененииНаСервере(ИдентификаторСтроки)
	ТекущееБлюдо = Объект.Блюда.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущееБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущееБлюдо.Автопередел Тогда
		// Получение ингредиентов в ТЧ "Ингредиенты", которые соответствуют текущему блюду.
		ИнгредиентыИзАвтопеределов = питИзменениеФактаВПроизводстве.НайтиИнгредиентыИзАвтопеределовПоБлюду(ЭтаФорма, Объект.Ингредиенты, ТекущееБлюдо);
		Для каждого СтрокаИнгредиент Из ИнгредиентыИзАвтопеределов Цикл
			// Изменяем рецептуру автопередела у найденных ингредиентов
			СтрокаИнгредиент.РецептураАвтопередела = ТекущееБлюдо.Рецептура;
		КонецЦикла;
	Иначе
		// Получение товара, соответствующего текущему блюду.
		НайденныйТовар = питИзменениеФактаВПроизводстве.НайтиТоварПоБлюду(ЭтаФорма, Объект.Товары, ТекущееБлюдо);
		НайденныйТовар.Рецептура = ТекущееБлюдо.Рецептура;
	КонецЕсли;
	
	// Вызываем рекурсивную обработку изменения факта блюда / автопередела.
	питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, Неопределено, ТекущееБлюдо);
	
	// Служебный обработчик, который обновляет статусы укзаания серий.
	ПослеИзмененияСтрокТЧПрограммноНаСервере("Ингредиенты");
	
	// Устанавливаем изменение факта блюда.
	питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, ТекущееБлюдо);
	
	// Предыдущую рецептуру обновляем на текущуюю
	ТекущееБлюдо.РецептураПред = ТекущееБлюдо.Рецептура;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийИнгредиенты

// Серверные вызовы

// Процедура - Ингредиенты количество упаковок ингредиента факт при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ИнгредиентыКоличествоУпаковокИнгредиентаФактПриИзмененииНаСервере(ИдентификаторСтроки)
	
	СтрокаИнгредиент = Объект.Ингредиенты.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если НЕ СтрокаИнгредиент = Неопределено Тогда
		
		питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, СтрокаИнгредиент, Неопределено);
		
		ПослеИзмененияСтрокТЧПрограммноНаСервере("Ингредиенты");
		
		// Установка флага, что факт строки был изменен.
		СтрокаИнгредиент.ИзмененФакт = Истина;
		
		// Поиск блюда ингредиента
		БлюдоИнгредиента = питИзменениеФактаВПроизводстве.НайтиБлюдоИнгредиента(Объект.Блюда, СтрокаИнгредиент);
		
		// Устанавливаем изменение факта блюда.
		питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, БлюдоИнгредиента);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обработка выбора подбор ингредиентов на сервере.
//
// Параметры:
//  ИдентификаторСтрокиБлюда - Произвольный - Идентификатор строки блюда.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборИнгредиентовНаСервере(ИдентификаторСтрокиБлюда, ВыбранноеЗначение)
	
	// Получение текущей строки блюда.
	СтрокаБлюдо = Объект.Блюда.НайтиПоИдентификатору(ИдентификаторСтрокиБлюда);
	Если СтрокаБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		// Новая строка не была среди найденных, значит ее не было раньше. Добавляем.
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ИдентификаторБлюда",					СтрокаБлюдо.ИдентификаторСтроки);
		СтруктураДанных.Вставить("Номенклатура",						СтрокаТовара.Номенклатура);
		СтруктураДанных.Вставить("Характеристика",						СтрокаТовара.Характеристика);
		СтруктураДанных.Вставить("Ингредиент",							СтрокаТовара.Номенклатура);
		СтруктураДанных.Вставить("УпаковкаИнгредиента",					?(ЗначениеЗаполнено(СтрокаТовара.Упаковка), СтрокаТовара.Упаковка, СтрокаТовара.Номенклатура.ЕдиницаИзмерения));
		СтруктураДанных.Вставить("КоличествоУпаковокИнгредиентаНорма",	0);
		СтруктураДанных.Вставить("КоличествоИнгредиентаНорма",			0);
		СтруктураДанных.Вставить("КоличествоУпаковокИнгредиентаФакт",	СтрокаТовара.КоличествоУпаковок);
		СтруктураДанных.Вставить("КоличествоИнгредиентаФакт",			СтрокаТовара.Количество);
		СтруктураДанных.Вставить("Серия",								СтрокаТовара.Серия);
		СтруктураДанных.Вставить("ЗапретитьЗамены",						Ложь);
		СтруктураДанных.Вставить("СезонныйПроцент",						0);
		
		// Ищем ингредиент среди уже добавленных.
		ТекущийИнгредиент = питИзменениеФактаВПроизводстве.НайтиИнгредиентПоСтруктуреДанных(Объект.Ингредиенты, СтруктураДанных);
		Если ТекущийИнгредиент = Неопределено Тогда
			// Не нашли ингредиент, добавляем новый.
			ТекущийИнгредиент = питИзменениеФактаВПроизводстве.ДобавитьИнгредиентПоСтруктуреДанных(ЭтаФорма, Объект.Ингредиенты, СтруктураДанных);
		Иначе
			// Нашли ингредиент, обновляем фактическое количество.
			ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт	= ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт + СтруктураДанных.КоличествоУпаковокИнгредиентаФакт;
			ТекущийИнгредиент.КоличествоИнгредиентаФакт			= ТекущийИнгредиент.КоличествоИнгредиентаФакт + СтруктураДанных.КоличествоИнгредиентаФакт;
		КонецЕсли;
		
		Если питИзменениеФактаВПроизводствеКлиентСервер.ТекущийИнгредиентЯвляетсяПолуфабрикатом(ТекущийИнгредиент) Тогда
			// Поиск блюда по добавленному ингредиенту и его добавление, если не найдено.
			питИзменениеФактаВПроизводстве.НайтиДобавитьБлюдоПоИнгредиенту(ЭтаФорма, ТекущийИнгредиент);
			// Обновление порядка в таблице блюд.
			питИзменениеФактаВПроизводстве.ОбновитьПорядокБлюдПоИнгредиенту(ЭтаФорма, ТекущийИнгредиент, СтрокаБлюдо.Порядок);
			// Обрабатываем рекурсивно изменение количества ингредиента, который является полуфабрикатом.
			питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, ТекущийИнгредиент, Неопределено);
		КонецЕсли;
		
	КонецЦикла;
	
	ПослеИзмененияСтрокТЧПрограммноНаСервере("Ингредиенты");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТовары

// Серверные вызовы

// Процедура - Товары рецептура при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ТоварыРецептураПриИзмененииНаСервере(ИдентификаторСтроки)
	
	СтрокаТовар = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТовар = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Изменен факт для товара.
	СтрокаТовар.ИзмененФактБлюда = Истина;
	
	ТекущееБлюдо = питИзменениеФактаВПроизводстве.НайтиБлюдоПоТовару(ЭтаФорма, Объект.Блюда, СтрокаТовар);
	Если ТекущееБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущееБлюдо.Рецептура = СтрокаТовар.Рецептура;
	
	// Вызываем рекурсивную обработку изменения факта блюда / автопередела.
	питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, Неопределено, ТекущееБлюдо);
	
	// Служебный обработчик, который обновляет статусы укзаания серий.
	ПослеИзмененияСтрокТЧПрограммноНаСервере("Ингредиенты");
	
	// Устанавливаем изменение факта блюда.
	питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, ТекущееБлюдо);
	
	// Устанавливаем предыдущее значение рецептуры.
	СтрокаТовар.РецептураПред	= СтрокаТовар.Рецептура;
	ТекущееБлюдо.РецептураПред	= ТекущееБлюдо.Рецептура;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЗамены

// Серверные вызовы

// Процедура - Замены исходное количество единица при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ЗаменыИсходноеКоличествоЕдиницаПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Замены.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьФактЗаменПоСтрокеЗамены(ТекущаяСтрока);
	
КонецПроцедуры

// Процедура - Замены ингредиент исходный при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ЗаменыИнгредиентИсходныйПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Замены.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем единицу измерения на непустую.
	ТекущаяСтрока.УпаковкаИнгредиентаИсходный = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ИнгредиентИсходный, "ЕдиницаИзмерения");
	
	ОбновитьФактЗаменПоСтрокеЗамены(ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

// Процедура - Обновить факт замен в таблице ингредиентов.
//
&НаСервере
Процедура ОбновитьФактЗаменВТаблицеИнгредиентов()
	
	// "Обнуляем" факт замены.
	Для каждого ТекущийИнгредиент Из Объект.Ингредиенты Цикл
		ТекущийИнгредиент.ФактЗамены = 0;
	КонецЦикла;
	
	// Обход замен, поиск соответствующего ингредиента и инкремент "ФактЗамены".
	Для каждого ТекЗамена Из Объект.Замены Цикл
		ОбновитьФактЗаменПоСтрокеЗамены(ТекЗамена);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Обновить факт замен по строке замены.
//
// Параметры:
//  СтрокаЗамена - Строка - Строка замена.
//
&НаСервере
Процедура ОбновитьФактЗаменПоСтрокеЗамены(СтрокаЗамена)
	
	// Поиск ингредиента, соответствующего текущей замене.
	НайденныйИнгредиент	= питИзменениеФактаВПроизводстве.НайтиИнгредиентПоЗамене(Объект.Ингредиенты, Объект.Блюда, СтрокаЗамена);
	Если НайденныйИнгредиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Инкремент факта замены.
	НайденныйИнгредиент.ФактЗамены = НайденныйИнгредиент.ФактЗамены + СтрокаЗамена.КоличествоУпаковокИнгредиентаИсходный;
	
	// Установка флага измененности.
	НайденныйИнгредиент.ИзмененФакт = Истина;
	
	// Поиск блюда ингредиента
	БлюдоИнгредиента = питИзменениеФактаВПроизводстве.НайтиБлюдоИнгредиента(Объект.Блюда, НайденныйИнгредиент);
	
	// Устанавливаем изменение факта блюда.
	питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, БлюдоИнгредиента);
	
КонецПроцедуры

