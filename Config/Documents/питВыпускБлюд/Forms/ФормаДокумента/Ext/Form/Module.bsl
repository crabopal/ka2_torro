// Процедура - пит статья расходов при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питСтатьяРасходовПриИзменении(Элемент)
	
	// Выбор статей и аналитик.
	ДоходыИРасходыКлиентСервер.СтатьяПриИзменении(ЭтотОбъект, Элемент);
	
	НовыеТипы = Новый Массив;
	НовыеТипы.Добавить(ТипЗнч(Объект.АналитикаАктивовПассивов));
	Элементы.АналитикаАктивовПассивов.ДоступныеТипы = Новый ОписаниеТипов(НовыеТипы);
	Элементы.АналитикаАктивовПассивов.КнопкаВыбора = Истина;
	
КонецПроцедуры

// Процедура - пит статья расходов начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура питСтатьяРасходовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	// Выбор статей и аналитик.
	ДоходыИРасходыКлиент.НачалоВыбораСтатьи(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// Процедура - Аналитика расходов начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура АналитикаРасходовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	// Выбор статей и аналитик.
	ДоходыИРасходыКлиент.НачалоВыбораАналитикиРасходов(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

// Процедура - Аналитика расходов авто подбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Текст - Произвольный - Текст.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  ПараметрыПолученияДанных - Произвольный - Параметры получения данных.
//  Ожидание - Произвольный - Ожидание.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура АналитикаРасходовАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	// Выбор статей и аналитик.
	ДоходыИРасходыКлиент.АвтоПодборАналитикиРасходов(
		ЭтотОбъект,
		Элемент,
		Текст,
		ДанныеВыбора,
		Параметры,
		СтандартнаяОбработка);
	
КонецПроцедуры

// Процедура - Аналитика расходов окончание ввода текста.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Текст - Произвольный - Текст.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  ПараметрыПолученияДанных - Произвольный - Параметры получения данных.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура АналитикаРасходовОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	// Выбор статей и аналитик.
	ДоходыИРасходыКлиент.ОкончаниеВводаТекстаАналитикиРасходов(
		ЭтотОбъект,
		Элемент,
		Текст,
		ДанныеВыбора,
		Параметры,
		СтандартнаяОбработка);
	
КонецПроцедуры

// Процедура - Товары при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	ОбновитьОтборСтрокВТаблицеМодификаторов();
КонецПроцедуры


// Процедура - Модификаторы при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура МодификаторыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекСтрока = Элемент.ТекущиеДанные;
		
		ТекДанные = Элементы.Товары.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			
			Если ПустаяСтрока(ТекДанные.ИдентификаторСтроки) Тогда
				ТекДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			
			Элемент.ТекущиеДанные.ИдентификаторСтроки = ТекДанные.ИдентификаторСтроки;
			
			ОбновитьОтборСтрокВТаблицеМодификаторов();
			
		КонецЕсли;
		
	КонецЕсли;
	ОбновитьКешированныеЗначенияДляУчетаСерий("Модификаторы", Элемент, КэшированныеЗначения, Копирование);
КонецПроцедуры

// Процедура - Модификаторы при изменении 1.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыПриИзменении1(Элемент)
	
	МодификаторыПриИзменении();
	
КонецПроцедуры

// Процедура - Модификаторы перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура МодификаторыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	// Должен быть установлен вид обработки.
	ТекДанныеТовары = Элементы.Товары.ТекущиеДанные;
	Если ТекДанныеТовары = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен товар в списке товаров!");
		Возврат;
	КонецЕсли;
	
	// Открытие формы выбора.
	ТекДанныеОбъект = Новый Структура("Дата, Организация, Подразделение, СпособРасчетаРецептуры", Объект.Дата, Объект.Организация, Объект.Подразделение, СпособРасчетаРецептуры);
	СтрПараметры = Новый Структура("ТекущаяСтрокаТЧ, ТекДанныеОбъект", Новый Структура("Номенклатура, Характеристика, ИдентификаторСтроки", ТекДанныеТовары.Номенклатура, ТекДанныеТовары.Характеристика, ТекДанныеТовары.ИдентификаторСтроки),ТекДанныеОбъект);
	ФормаВыбора = ПолучитьФорму("Документ.питВыпускБлюд.Форма.ФормаПодбораМодификаторов",СтрПараметры,Элемент);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

// Процедура - Модификаторы обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если НЕ Элемент.ТекущийЭлемент = Неопределено
		И (Элемент.ТекущийЭлемент = Элементы.МодификаторыСтатусУказанияСерий
		ИЛИ Элемент.ТекущийЭлемент = Элементы.МодификаторыСерия
		ИЛИ Элемент.ТекущийЭлемент = Элементы.МодификаторыГруппаСерия) Тогда
		
		ТаблицаОбработкаВыбора("Модификаторы", ВыбранноеЗначение);
		
	Иначе
		
		// Из формы выбора модификаторов.
		
		ТекДанные = Элементы.Товары.ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда
			
			Если ПустаяСтрока(ТекДанные.ИдентификаторСтроки) Тогда
				ТекДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			
			ДобавитьМодификаторы(ВыбранноеЗначение, ТекДанные.ИдентификаторСтроки);
			
			Для каждого ТекМод Из Объект.Модификаторы Цикл
				// ТекДанныеМод = Элементы.Модификаторы.Найти ТекМод.ПолучитьИдентификатор()
				ТаблицаНоменклатураПриИзменении("Модификаторы",,ТекМод);
			КонецЦикла;
			
			ОбновитьОтборСтрокВТаблицеМодификаторов();
			
			ПослеИзмененияСтрокТЧПрограммноНаСервере("Модификаторы");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Модификаторы выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено Тогда
		
		Если (Элемент.ТекущийЭлемент = Элементы.МодификаторыМодификатор) Тогда
			ИмяЭлемента = "Модификатор";
		ИначеЕсли Элемент.ТекущийЭлемент = Элементы.МодификаторыНоменклатура Тогда
			ИмяЭлемента = "Номенклатура";
		ИначеЕсли Элемент.ТекущийЭлемент = Элементы.МодификаторыРецептура Тогда
			ИмяЭлемента = "Рецептура";
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ИмяЭлемента) Тогда
			СтандартнаяОбработка = Ложь;
			Попытка
				ПоказатьЗначение(, ТекДанные[ИмяЭлемента]);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если (Поле = Элементы["МодификаторыСерия"] 
				ИЛИ Поле = Элементы["МодификаторыСтатусУказанияСерий"]) Тогда
		ТаблицаВыборСерии("Модификаторы", Поле, Элемент, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Модификаторы серия при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыСерияПриИзменении(Элемент)
	ТаблицаСерияПриИзменении("Модификаторы");
КонецПроцедуры

// Процедура - Модификаторы серия начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыСерияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий("Модификаторы", Элемент.ТекстРедактирования, Элементы.Модификаторы.ТекущиеДанные);
КонецПроцедуры

// Процедура - Модификаторы перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура МодификаторыПередУдалением(Элемент, Отказ)
	ОбновитьКешированныеЗначенияДляУчетаСерий("Модификаторы", Элемент, КэшированныеЗначения, Ложь);
КонецПроцедуры

// Процедура - Модификаторы при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура МодификаторыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТаблицаПриОкончанииРедактирования("Модификаторы", Элемент);
КонецПроцедуры

// Процедура - Партнер при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПартнерПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено (Объект.Партнер) Тогда
		ДоставкаТоваровКлиентСервер.ОчиститьРеквизитыДоставки(Элементы,Объект);
		УстановитьВидимостьЗапретаОтгрузкиПартнеру();
		Возврат;
	КонецЕсли;
	
	ПриИзмененииПартнераСервер();
	
	Если ИспользоватьСоглашенияСКлиентами И ЗначениеЗаполнено(Объект.Соглашение) Тогда
		ПродажиКлиент.ОповеститьОбОкончанииЗаполненияУсловийПродажПоУмолчанию();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.РаботаСКонтрагентами") Тогда
		МодульПроверкаКонтрагентовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроверкаКонтрагентовКлиент");
		// СтандартныеПодсистемы.РаботаСКонтрагентами
		МодульПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентовВДокументе(ЭтотОбъект, Элемент);
		// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	КонецЕсли;
	
	
КонецПроцедуры

// Процедура - Контрагент при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииСервер();
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.РаботаСКонтрагентами") Тогда
		МодульПроверкаКонтрагентовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроверкаКонтрагентовКлиент");
		// СтандартныеПодсистемы.РаботаСКонтрагентами
		МодульПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентовВДокументе(ЭтотОбъект, Элемент);
		// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	КонецЕсли;
	
КонецПроцедуры
	
// Процедура - Соглашение при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СоглашениеПриИзменении(Элемент)
	
	СоглашениеПриИзмененииСервер();
	
КонецПроцедуры

// Процедура - Соглашение начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура СоглашениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыВыбораСоглашения = ПродажиКлиент.ПараметрыНачалаВыбораСоглашенияСКлиентом();
	
	ПараметрыВыбораСоглашения.Элемент                     = Элемент;
	ПараметрыВыбораСоглашения.Партнер                     = Объект.Партнер;
	ПараметрыВыбораСоглашения.Документ                    = Объект.Соглашение;
	ПараметрыВыбораСоглашения.ДатаДокумента               = Объект.Дата;
	ПараметрыВыбораСоглашения.ДанныеФормыСтруктура        = Объект;
	
	ПродажиКлиент.НачалоВыбораСоглашенияСКлиентом(ПараметрыВыбораСоглашения, СтандартнаяОбработка);
	
КонецПроцедуры

// Процедура - Оплата сумма оплаты при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОплатаСуммаОплатыПриИзменении(Элемент)
	
	Строка = Элементы.Оплата.ТекущиеДанные;
	
	Если Строка.СуммаОплаты < 0 Тогда
		Строка.СуммаОплаты = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область Печать

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	ИмяФормыПараметровПечати = "";
	
	СтруктураПараметровПечати = Новый Структура;
	
//   Устанавливаем заголовок формы печати, если требуется(например для указания, каким образом была получена суммовая
// оценка).
	Если ОписаниеКоманды.ДополнительныеПараметры.Свойство("ЗаголовокФормы") Тогда
		ОписаниеКоманды.ДополнительныеПараметры.ЗаголовокФормы = питОтчеты.ПолучитьЗаголовокПечатнойФормыОбщепит(ИдентификаторКоманды, Объект.Ссылка, ОписаниеКоманды.Представление);
	КонецЕсли;
	
	Если ИдентификаторКоманды ="питОП1_ТБ" Или ИдентификаторКоманды ="питОП1_ТБ_СПараметрами" Тогда
		СтрокаБлюда = Новый Структура("Ссылка,Номенклатура,Упаковка,Количество,КоличествоУпаковок,Рецептура,Цена,Сумма");
		СтрокаБлюда.Ссылка = Объект.Ссылка;
		Если Элементы.Товары.ТекущиеДанные = Неопределено Тогда
			ПоказатьПредупреждение(,"Не выбрана строка блюда");
			Возврат;
		КонецЕсли;
		 
		ЗаполнитьЗначенияСвойств(СтрокаБлюда, Элементы.Товары.ТекущиеДанные);
		ОписаниеКоманды.ДополнительныеПараметры.ДополнительныеПараметры.Вставить("ТекущаяСтрокаДляПечати", СтрокаБлюда);
		
	КонецЕсли;
	
	Если ИдентификаторКоманды ="питОП1_СПараметрами" Или ИдентификаторКоманды ="питОП1_ТБ_СПараметрами" Тогда
		ИмяФормыПараметровПечати = "Документ.питВыпускБлюд.Форма.ФормаПараметрыПечатиОП1";
	КонецЕсли;
	
	Если ИмяФормыПараметровПечати <> "" Тогда
		ОбъектыПечати = питОтчетыКлиент.ОбъектыПечати(Объект);
		ПараметрыФормы = Новый Структура("МассивОбъектов", ОбъектыПечати);  //Команда.ОбъектыПечати);
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьКомандуПечатиЗавершение", ЭтотОбъект, Команда);
		ОткрытьФорму(ИмяФормыПараметровПечати, ПараметрыФормы,,,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение);
		
	Иначе
		
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

