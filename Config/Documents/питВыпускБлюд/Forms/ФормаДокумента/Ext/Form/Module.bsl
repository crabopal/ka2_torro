//// Прочий функционал:

// Процедура - Заполнить добавленные колонки таблиц.
//
&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	ЗаполнитьДобавленныеКолонкиТаблицыТовары();
	
	Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
		СтрокаТаблицы.Всего = СтрокаТаблицы.Сумма + ?(Объект.ЦенаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из Объект.АгентскиеУслуги Цикл
		СтрокаТаблицы.Всего = СтрокаТаблицы.Сумма + ?(Объект.ЦенаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
	КонецЦикла;
	
КонецПроцедуры

// Заполнение колонок "Товары.Всего", "Товары.ЭтоУслуга", "Товары.ЭтоБлюдо", "Товары.СчетУчетаЗабалансовый"
//
&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицыТовары()
	// Процедура из документа ОтчетОРозничныхПродажах
	
	ТаблицаТовары = Объект.Товары.Выгрузить(, "Номенклатура,СчетУчета");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Таб.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_ТаблицаУслуг
	|ИЗ
	|	&ТаблицаТовары КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.Номенклатура КАК Номенклатура,
	|	Таб.Номенклатура.питВидНоменклатуры КАК ВидНоменклатуры
	|ПОМЕСТИТЬ ТаблицаУслуг
	|ИЗ
	|	ВТ_ТаблицаУслуг КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУслуг.Номенклатура КАК Номенклатура,
	|	ТаблицаУслуг.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ТаблицаУслуг.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.питВидыНоменклатуры.Услуга) КАК ЭтоУслуга,
	|	ТаблицаУслуг.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.питВидыНоменклатуры.Блюдо) КАК ЭтоБлюдо
	|ИЗ
	|	ТаблицаУслуг КАК ТаблицаУслуг";
	Запрос.УстановитьПараметр("ТаблицаТовары", ТаблицаТовары);
	
	ТаблицаУслуг = Запрос.Выполнить().Выгрузить();
	ТаблицаУслуг.Индексы.Добавить("Номенклатура");
	
	ПодразделениеПроизводстваПолуфабрикатов = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питПодразделениеПроизводстваПолуфабрикатов");
	
	Для каждого СтрокаДокумента Из Объект.Товары Цикл
		// Заполняем колонки "ЭтоУслуга" и "ЭтоБлюдо"
		СтрокаУслуги = ТаблицаУслуг.Найти(СтрокаДокумента.Номенклатура, "Номенклатура");
		СтрокаДокумента.ЭтоУслуга = СтрокаУслуги.ЭтоУслуга;
		СтрокаДокумента.ЭтоБлюдо  = СтрокаУслуги.ЭтоБлюдо;
		ПодразделениеРазрешено = питПроизводствоПовтИсп.ПодразделениеРазрешено(СтрокаДокумента.Рецептура, Объект.Подразделение, Объект.Склад,,,ПодразделениеПроизводстваПолуфабрикатов);
		СтрокаДокумента.ПриготовлениеРазрешено = ?(ЗначениеЗаполнено(СтрокаДокумента.Рецептура), ПодразделениеРазрешено, НЕ ВосприниматьБлюдоБезРецептурыКакТовар);
		СтрокаДокумента.Всего = СтрокаДокумента.Сумма + ?(Объект.ЦенаВключаетНДС, 0, СтрокаДокумента.СуммаНДС);
		СтрокаДокумента.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(СтрокаУслуги.ВидНоменклатуры, Ложь, СтрокаДокумента.ПриготовлениеРазрешено);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Заполнить добавленные колонки таблицы ингредиентов.
//
&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицыИнгредиентов()
	// Процедура из документа ОтчетОРозничныхПродажах
	
	ТаблицаТовары = Объект.Ингредиенты.Выгрузить(, "Ингредиент");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Таб.Ингредиент КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_ТаблицаУслуг
	|ИЗ
	|	&ТаблицаТовары КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.Номенклатура КАК Номенклатура,
	|	Таб.Номенклатура.питВидНоменклатуры КАК ВидНоменклатуры
	|ПОМЕСТИТЬ ТаблицаУслуг
	|ИЗ
	|	ВТ_ТаблицаУслуг КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУслуг.Номенклатура КАК Номенклатура,
	|	ТаблицаУслуг.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ТаблицаУслуг.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.питВидыНоменклатуры.Блюдо) КАК ЭтоБлюдо
	|ИЗ
	|	ТаблицаУслуг КАК ТаблицаУслуг";
	Запрос.УстановитьПараметр("ТаблицаТовары", ТаблицаТовары);
	
	ТаблицаУслуг = Запрос.Выполнить().Выгрузить();
	ТаблицаУслуг.Индексы.Добавить("Номенклатура");
	
	ПодразделениеПроизводстваПолуфабрикатов = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питПодразделениеПроизводстваПолуфабрикатов");
	
	Для каждого СтрокаДокумента Из Объект.Ингредиенты Цикл
		// Заполняем колонки "ЭтоУслуга" и "ЭтоБлюдо"
		СтрокаУслуги = ТаблицаУслуг.Найти(СтрокаДокумента.Ингредиент, "Номенклатура");
		СтрокаДокумента.ЭтоБлюдо  = СтрокаУслуги.ЭтоБлюдо;
		СтрокаДокумента.ПриготовлениеРазрешено = питПроизводствоПовтИсп.ПодразделениеРазрешено(СтрокаДокумента.РецептураАвтопередела, Объект.Подразделение, Объект.Склад,,,ПодразделениеПроизводстваПолуфабрикатов);
		СтрокаДокумента.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(СтрокаУслуги.ВидНоменклатуры, СтрокаДокумента.Специя, СтрокаДокумента.ПриготовлениеРазрешено);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Установить заголовок формы.
//
&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ТекстЗаголовка = НСтр("ru = 'Выпуск блюд'");
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстЗаголовка = ТекстЗаголовка + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru=' %1 от %2'"), Объект.Номер, Формат(Объект.Дата, "ДЛФ=D"));
	Иначе
		ТекстЗаголовка = ТекстЗаголовка + НСтр("ru = ' (создание)'");
	КонецЕсли;
	
	Заголовок = ТекстЗаголовка + " (" + Строка(Объект.ХозяйственнаяОперация) +". "+ Строка(Объект.РежимРасчетаСписанияВПроизводство) + ")";
	
КонецПроцедуры

// Процедура - Подготовить форму на сервере.
//
&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтоРозница     = (Объект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ВыпускПродукцииСРозничнойРеализацией);
	ЭтоРеализация  = (Объект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ВыпускПродукцииСРеализацией);
	ЭтоПеремещение = (Объект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ВыпускПродукцииСПеремещением);
	ЭтоСписание    = (Объект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ВыпускПродукцииСоСписанием);
	
	ВалютаРегламентированногоУчета = питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	
	ПоказыватьВДокументахСчетаУчета	= Истина;
	
	// Закладки производства
	// ЗаполнитьТаблицуВыпущеннаяПродукция();
	ВыпущеннаяПродукцияТекущаяСтрока = 0;
	
	// Рассчитываем только колонку ФактЗамены
	///***---питПроизводство.ЗаписатьВТаблицуПроизводствоФактЗамены(Объект.Производство, Объект.Замены);
	
	// СпособРасчетаРецептуры = Константы.питСпособРасчетаРецептур.Получить();
	СпособРасчетаРецептуры = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
	
	Если НЕ ЗначениеЗаполнено(Объект.РежимПриготовленияМодификаторов) Тогда
		Объект.РежимПриготовленияМодификаторов = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питВидыПроизводстваМодификаторов");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидПроизводства) Тогда
		Объект.ВидПроизводства = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питРежимПриготовленияПолуфабрикатов");
	КонецЕсли;
	
	СпособРасчетаРецептурыПоАктуальной = (СпособРасчетаРецептуры = Перечисления.питСпособРасчетаРецептур.ПоАктуальнойРецептуре);
	
	ТипСклада = ПолучитьТипСкладаНаСервере(Объект.Склад);
	
	ИскатьПоВсемОрганизациям = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ИскатьРецептурыПоВсемОрганизациям");
	
	Если НЕ СпособРасчетаРецептурыПоАктуальной И НЕ ИскатьПоВсемОрганизациям Тогда
		НоваяСвязьПараметровВыбора = Новый СвязьПараметраВыбора("Отбор.Организация", "Объект.Организация");
		питОбщегоНазначения.ЗаменитьСвязьПараметровВыбора(Элементы.ТоварыРецептура, "Отбор.Организация", НоваяСвязьПараметровВыбора)
	КонецЕсли;
	
	УстановитьЗаголовокФормы();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	УстановитьЗаголовкиКолонокНаСервере();
	
	// Для всех
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

// Процедура - Обработка оповещения обработки табличной части товары на сервере.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
&НаСервере
Процедура ОбработкаОповещенияОбработкиТабличнойЧастиТоварыНаСервере(Параметры)
	
	ТаблицаОбработки = ПолучитьИзВременногоХранилища(Параметры.АдресОбработаннойТабличнойЧастиТоварыВХранилище);
	
	Для Каждого СтрокаТабличнойЧасти ИЗ ТаблицаОбработки Цикл
		
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТабличнойЧасти.Номенклатура, "питВидНоменклатуры");
		СтрокаТабличнойЧасти.ЭтоУслуга = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Услуга);
		СтрокаТабличнойЧасти.ЭтоБлюдо  = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо);
		
	КонецЦикла;
	
	ОбновитьИтоги(ЭтаФорма);
	
КонецПроцедуры

// Процедура обновляет отбор таблицы ингредиентов на форме по текущему значению идентификатора строки в таблице блюд.
//
&НаКлиенте
Процедура ОбновитьОтборСтрокВТаблицеИнгредиентов()
	
	Перем ТекДанные;
	
	ТекДанные = Элементы.Блюда.ТекущиеДанные;
	Если ТекДанные <>  Неопределено Тогда
		Если Элементы.ИнгредиентыТолькоИзмененные.Пометка Тогда
			Элементы.Ингредиенты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда, ИзмененФакт", ТекДанные.ИдентификаторСтроки, Истина);
		Иначе
			Элементы.Ингредиенты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", ТекДанные.ИдентификаторСтроки);
		КонецЕсли;
	Иначе
		Элементы.Ингредиенты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", "xxx");/// Скроем
	КонецЕсли;

КонецПроцедуры


