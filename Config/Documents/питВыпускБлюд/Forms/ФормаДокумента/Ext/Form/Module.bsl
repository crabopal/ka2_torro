		// НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		// Элементы.Склад.ПараметрыВыбора = НовыеПараметры;
		//
		//// Склад
		// НовыйПараметр = Новый СвязьПараметраВыбора("Отбор.Подразделение", "Объект.Подразделение");
		// НовыйМассив = Новый Массив();
		// НовыйМассив.Добавить(НовыйПараметр);
		// НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		// Элементы.Склад.СвязиПараметровВыбора = НовыеПараметры;
		
		
		// Касса ККМ
		// НовыйПараметр = Новый СвязьПараметраВыбора("Отбор.Склад", "Объект.СкладПолучатель");
		// НовыйМассив = Новый Массив();
		// НовыйМассив.Добавить(НовыйПараметр);
		// НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		// Элементы.КассаККМ.СвязиПараметровВыбора = НовыеПараметры;
		
	Иначе
		Элементы.Склад.Заголовок = "Склад";
		
		// Касса ККМ
		// НовыйПараметр = Новый СвязьПараметраВыбора("Отбор.Склад", "Объект.Склад");
		// НовыйМассив = Новый Массив();
		// НовыйМассив.Добавить(НовыйПараметр);
		// НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		// Элементы.КассаККМ.СвязиПараметровВыбора = НовыеПараметры;
		
	КонецЕсли;
	
	УстановитьЗаголовокФормы();
	УправлениеФормой(ЭтаФорма);
	
	ПродажиСервер.УстановитьОтметкуНезаполненногоДоговора(Элементы, "Договор");
	ПродажиСервер.УстановитьДоступностьДоговора(Объект, Элементы.Договор.Доступность, Элементы.ГруппаДоговор.Видимость);
	// Элементы.ГруппаНадписьДоговор.Видимость = Элементы.ГруппаДоговор.Видимость;
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.РаботаСКонтрагентами") Тогда
		МодульПроверкаКонтрагентов = ОбщегоНазначения.ОбщийМодуль("ПроверкаКонтрагентов");
		МодульПроверкаКонтрагентовВызовСервераПереопределяемыйУТ = ОбщегоНазначения.ОбщийМодуль("ПроверкаКонтрагентовВызовСервераПереопределяемыйУТ");
		// СтандартныеПодсистемы.РаботаСКонтрагентами
		МодульПроверкаКонтрагентов.ПриСозданииНаСервереДокумент(ЭтотОбъект, Параметры);
		МодульПроверкаКонтрагентовВызовСервераПереопределяемыйУТ.ФормаДокументаПриСозданииНаСервере(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	КонецЕсли;
	
	ПараметрыВыбораСтатейИАналитик = Документы.питВыпускБлюд.ПараметрыВыбораСтатейИАналитик(Объект.ХозяйственнаяОперация);
	ДоходыИРасходыСервер.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыВыбораСтатейИАналитик);
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
		// Для нового документа
		Объект.питОтложитьОплату = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОтложитьОплату");
		Если НЕ ЗначениеЗаполнено(Объект.СтатьяКалькуляции) Тогда
			Объект.СтатьяКалькуляции = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СтатьяКалькуляцииПоУмолчанию");
		КонецЕсли;
	Иначе
		Объект.СуммаВключаетНДС = Объект.ЦенаВключаетНДС;
	КонецЕсли;
	
	УстановитьВидимостьКомандПечати();
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	ОбновитьИконкиМодификаторов();
	
	// +ИзменениеФактаВПроизводстве
	ОбновитьФактЗаменВТаблицеИнгредиентов();
	питИзменениеФактаВПроизводстве.ИнициализироватьИменаКолонокРеквизитов(ЭтаФорма);
	// -ИзменениеФактаВПроизводстве
	
КонецПроцедуры

// Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	Для каждого ВыборкаДетальныеЗаписи Из ПредставленияВыпусковБлюд Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Обратите внимание, что по <"+ПредставлениеПланаМеню+">
		|уже создан <"+ВыборкаДетальныеЗаписи.Представление+">";
		Сообщение.КлючДанных = ВыборкаДетальныеЗаписи.ВыпускБлюд;
		Сообщение.ИдентификаторНазначения = ЭтаФорма.УникальныйИдентификатор;
		Сообщение.Сообщить();
	КонецЦикла;
КонецПроцедуры

// Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

// Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	Если ИмяСобытия = "ОбработанаТабличнаяЧастьТовары" И ТипЗнч(Параметр) = Тип("Структура") 
		И Параметр.Свойство("ИдентификаторВызывающейФормы")
		И Параметр.ИдентификаторВызывающейФормы = УникальныйИдентификатор Тогда
		ОбработкаОповещенияОбработкиТабличнойЧастиТоварыНаСервере(Параметр);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ВосприниматьБлюдоБезРецептурыКакТовар = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питВосприниматьБлюдоБезРецептурыКакТовар");
	
	Если ОбщегоНазначенияУТКлиентСервер.АвторизованВнешнийПользователь() Тогда
		ТребуетсяОткрытиеПечатнойФормы = Истина;
		Возврат;
	КонецЕсли;
	
	// +Серии
	ПриЧтенииСозданииНаСервере();
	// +Серии
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// ПриЧтенииСозданииНаСервере();
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	СобытияФорм.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	ПодготовитьФормуНаСервере();
	
	ЗаполнитьДобавленныеКолонкиТаблицыТовары();
	ЗаполнитьДобавленныеКолонкиТаблицыИнгредиентов();
	
	// Выбор статей и аналитик.
	ПараметрыВыбораСтатейИАналитик = Документы.питВыпускБлюд.ПараметрыВыбораСтатейИАналитик(Объект.ХозяйственнаяОперация);
	ДоходыИРасходыСервер.ПриЧтенииНаСервере(ЭтотОбъект, ПараметрыВыбораСтатейИАналитик);
	
КонецПроцедуры

// Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// +Серии
	ЗаполнитьПараметрыУказанияСерий();
	УстановитьВидимостьЭлементовСерий();
	// -Серии
	
	УстановитьЗаголовокФормы();
	
	ЗаполнитьДобавленныеКолонкиТаблицыТовары();
	ЗаполнитьДобавленныеКолонкиТаблицыИнгредиентов();
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	Если ЭтоРеализация Тогда
		Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.РаботаСКонтрагентами") Тогда
			МодульПроверкаКонтрагентов = ОбщегоНазначения.ОбщийМодуль("ПроверкаКонтрагентов");
			// СтандартныеПодсистемы.РаботаСКонтрагентами
			МодульПроверкаКонтрагентов.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
			// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
		КонецЕсли;
	КонецЕсли;
	
	УправлениеФормой(ЭтаФорма);
	
	Если ЭтоРеализация Тогда
		
		ПродажиСервер.УстановитьОтметкуНезаполненногоДоговора(Элементы, "Договор");
		ПродажиСервер.УстановитьДоступностьДоговора(Объект, Элементы.Договор.Доступность, Элементы.ГруппаДоговор.Видимость);
		// Элементы.ГруппаНадписьДоговор.Видимость = Элементы.ГруппаДоговор.Видимость;
		
	КонецЕсли;
	
	ОбновитьИконкиМодификаторов();
	
	// +ИзменениеФактаВПроизводстве
	ОбновитьФактЗаменВТаблицеИнгредиентов();
	// -ИзменениеФактаВПроизводстве
	
	НастроитьЭлементыФормы(ЭтаФорма);
	
	// Выбор статей и аналитик.
	ДоходыИРасходыСервер.ПослеЗаписиНаСервере(ЭтотОбъект);
	
//	
КонецПроцедуры

// Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
		
		НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[ВыбранноеЗначение.ИмяТЧ], ВыбранноеЗначение);
		
	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.питПодборТоваровПоМеню.Форма.Форма" Тогда
		
		ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ПодборТоваровВДокументПродажи.Форма.Форма" Тогда
		
		// +ИзменениеФактаВПроизводстве
		Если СтрНайти(ИсточникВыбора.Заголовок, "товар") Тогда
			ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение);
		ИначеЕсли СтрНайти(ИсточникВыбора.Заголовок, "ингредиент") Тогда
			ИдентификаторСтрокиБлюда = Элементы.Блюда.ТекущаяСтрока;
			ОбработкаВыбораПодборИнгредиентовНаСервере(ИдентификаторСтрокиБлюда, ВыбранноеЗначение);
		КонецЕсли;
		// -ИзменениеФактаВПроизводстве
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.питФормаПодбораХарактеристик" Тогда
		// +АвтовыборНоменклатуры
		ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение);
		УправлениеФормой(ЭтаФорма);
		// -АвтовыборНоменклатуры
	КонецЕсли;
	
КонецПроцедуры

// Процедура - После записи.
//
// Параметры:
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбновитьОтборСтрокВТаблицеИнгредиентов(); // Обновляем отбор, т.к. стоит старый, т.к. событие при активизации строки тут не сработает.
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ПобочныеИзделия

#Область ПобочныеИзделияСобытия

// Процедура - Побочные изделия номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПобочныеИзделияНоменклатураПриИзменении(Элемент)
	ТаблицаНоменклатураПриИзменении("ПобочныеИзделия", "Получатель");
КонецПроцедуры

// Процедура - Побочные изделия количество упаковок при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПобочныеИзделияКоличествоУпаковокПриИзменении(Элемент)
	
	ТаблицаКоличествоУпаковокПриИзменении("ПобочныеИзделия");
	
КонецПроцедуры

// Процедура - Побочные изделия упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПобочныеИзделияУпаковкаПриИзменении(Элемент)
	
	ТаблицаУпаковкаПриИзменении("ПобочныеИзделия");
	
КонецПроцедуры

// Процедура - Побочные изделия цена при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПобочныеИзделияЦенаПриИзменении(Элемент)
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы.ПобочныеИзделия.ТекущиеДанные;

	СтруктураДействий = Новый Структура;
	
	СтруктураДействий.Вставить("ПересчитатьСумму");
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
	
КонецПроцедуры

// Процедура - Побочные изделия сумма при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПобочныеИзделияСуммаПриИзменении(Элемент)
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы.ПобочныеИзделия.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьЦенуПоСумме");
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
	
КонецПроцедуры

// Процедура - Побочные изделия при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ПобочныеИзделияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекСтрока = Элемент.ТекущиеДанные;
		ТекСтрока.Подразделение = Объект.Подразделение;
		ТекСтрока.Получатель = ПолучательПоУмолчанию(ТекСтрока);
		
		ТекДанные = Элементы.БлюдаПобочныеИзделия.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			Элемент.ТекущиеДанные.ИдентификаторБлюда = ТекДанные.ИдентификаторСтроки;
		КонецЕсли;
		
	КонецЕсли;
	
	// ОбщегоНазначенияУТКлиент.КешироватьТекущуюСтроку(ЭтотОбъект, "ПобочныеИзделия");
	
	ОбновитьКешированныеЗначенияДляУчетаСерий("ПобочныеИзделия", Элемент, КэшированныеЗначения, Копирование);
	
КонецПроцедуры

// Процедура - Блюда побочные изделия при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
