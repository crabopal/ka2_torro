// Процедура - Обработка выбора подбор на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Обработка выбора подбор товаров на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		
		// Дозаполним еще реквизиты, такие как "Рецептура", "ЭтоБлюдо", "ЭтоТовар" и т.д.
		СписокСвойствСтрокой = "Номенклатура, Характеристика, ЭтоУслуга, ЭтоБлюдо, ПриготовлениеРазрешено, ЭтоТовар, Иконка, Рецептура, ИзмененФактБлюда, РецептураПред";
		ДанныеСтрокаТаблицы = Новый Структура(СписокСвойствСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, ТекущаяСтрока);
		
		СвойстваПараметрыОбъектаСтрокой = "ХозяйственнаяОперация, Организация, Дата, Ссылка, Подразделение, Склад";
		ПараметрыОбъекта = Новый Структура();
		ПараметрыОбъекта = Новый Структура(СвойстваПараметрыОбъектаСтрокой);
		ПараметрыОбъекта.Вставить("СпособРасчетаРецептуры", СпособРасчетаРецептуры);
		ПараметрыОбъекта.Вставить("ВосприниматьБлюдоБезРецептурыКакТовар", ВосприниматьБлюдоБезРецептурыКакТовар);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
		
		ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеСтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Подразделение организации при изменении на сервере.
//
&НаСервере
Процедура ПодразделениеОрганизацииПриИзмененииНаСервере()
	Если НЕ питДокументы.ПроверитьПроизводственноеПодразделение(Объект.Подразделение) Тогда
		Объект.Подразделение = "";
	КонецЕсли;
КонецПроцедуры

// Функция - Получить параметры подбора.
//
// Параметры:
//  ИмяТаблицы - Строка - Имя таблицы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ПолучитьПараметрыПодбора(ИмяТаблицы = "Товары")
	
	ПараметрыФормы = Новый Структура;
	
	// +ИзменениеФактаВПроизводстве
	Если ИмяТаблицы = "Товары" Тогда
		ПараметрЗаголовок = НСтр("ru = 'Подбор товаров в %Документ%'");
	ИначеЕсли ИмяТаблицы = "Ингредиенты" Тогда
		ПараметрЗаголовок = НСтр("ru = 'Подбор ингредиентов в %Документ%'");
	КонецЕсли;
	// -ИзменениеФактаВПроизводстве
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", Объект.Ссылка);
	Иначе
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", НСтр("ru = 'выпуск блюд'"));
	КонецЕсли;
	
	ОтборТипЦен = ?(ЗначениеЗаполнено(Объект.ТипЦен),Объект.ТипЦен, питОбщегоНазначения.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит"));
	
	ПараметрыФормы.Вставить("Заголовок",										ПараметрЗаголовок);
	ПараметрыФормы.Вставить("Дата",												Объект.Дата);
	ПараметрыФормы.Вставить("Склад",											Объект.Склад);
	ПараметрыФормы.Вставить("Организация",										Объект.Организация);
	ПараметрыФормы.Вставить("ЦенаВключаетНДС",									Объект.ЦенаВключаетНДС);
	ПараметрыФормы.Вставить("Валюта",											?(ЗначениеЗаполнено(Объект.Валюта),Объект.Валюта,питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета()));
	ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти",	Ложь);
	ПараметрыФормы.Вставить("Документ",											Объект.Ссылка);
	ПараметрыФормы.Вставить("ВидЦены",											ОтборТипЦен);
	ПараметрыФормы.Вставить("РежимПодбораБезСоглашенийСКлиентами",				Истина);
	
	Возврат ПараметрыФормы;
	
КонецФункции

// Процедура обновляет отбор таблицы Трудозатрат на форме по текущему значению идентификатора строки в таблице блюд.
//
&НаКлиенте
Процедура ОбновитьОтборСтрокВТаблицеТрудозатрат()
	
	Перем ТекДанные;
	
	ТекДанные = Элементы.БлюдаТрудозатраты.ТекущиеДанные;
	Если ТекДанные <>  Неопределено Тогда
		Элементы.Трудозатраты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", ТекДанные.ИдентификаторСтроки);
	Иначе
		Элементы.Трудозатраты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", "xxx");/// Скроем
	КонецЕсли;

КонецПроцедуры

// Процедура обновляет отбор таблицы ингредиентов на форме по текущему значению идентификатора строки в таблице блюд.
//
&НаКлиенте
Процедура ОбновитьОтборСтрокВТаблицеМодификаторов()
	
	Перем ТекДанные;
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекДанные <> Неопределено И НЕ ПустаяСтрока(ТекДанные.ИдентификаторСтроки) Тогда
		Элементы.Модификаторы.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки);
	Иначе
		Элементы.Модификаторы.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", "xxx");/// Скроем
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Модификаторы при изменении.
//
// Параметры:
//  ИмяРеквизита - Строка - Имя реквизита.
//
&НаКлиенте
Процедура МодификаторыПриИзменении(ИмяРеквизита = "")
	
	Перем ДанныеМодификатора, ТекДанные;
	
	ТекДанные = Элементы.Модификаторы.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И ЗначениеЗаполнено(ТекДанные.Модификатор) Тогда
		ДанныеМодификатора = ПолучитьДанныеМодификатора(ТекДанные.Модификатор);
		
		Если ИмяРеквизита = "" Тогда
			ТекДанные.Номенклатура						= ДанныеМодификатора.ДопНоменклатура;
			ТекДанные.Цена								= ДанныеМодификатора.Цена;
			ТекДанные.Сумма								= ДанныеМодификатора.Цена * ТекДанные.Количество;
			ТекДанные.УпаковкаНоменклатуры				= ДанныеМодификатора.ЕдиницаИзмеренияНоменклатуры;
			ТекДанные.КоличествоНоменклатуры			= ДанныеМодификатора.КоличествоНоменклатуры * ТекДанные.Количество;
			ТекДанные.КоличествоУпаковокНоменклатуры	= ДанныеМодификатора.КоличествоУпаковокНоменклатуры * ТекДанные.Количество;
		КонецЕсли;
		
		ДатаРецептуры = ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, КонецДня(Объект.Дата));
		ТекДанные.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекДанные.Номенклатура,ТекДанные.Характеристика, ДанныеМодификатора.РежимПриготовление,
		ДатаРецептуры, СпособРасчетаРецептуры, , Объект.Организация,,,Объект.Подразделение);
		
	КонецЕсли;

КонецПроцедуры

// Функция - Получить данные модификатора.
//
// Параметры:
//  Модификатор - Произвольный - Модификатор.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПолучитьДанныеМодификатора(Модификатор)
	
	ДанныеМодификатора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Модификатор, "ДопНоменклатура, КоличествоНоменклатуры, КоличествоУпаковокНоменклатуры, Цена, ЕдиницаИзмеренияНоменклатуры");
	ДанныеМодификатора.Вставить("РежимПриготовление", Перечисления.питХозяйственныеОперации.РецептураПриготовление);
	
	Возврат ДанныеМодификатора;
	
КонецФункции

// Процедура - Добавить модификаторы.
//
// Параметры:
//  АдресТаблицы - Произвольный - Адрес таблицы.
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ДобавитьМодификаторы(АдресТаблицы, ИдентификаторСтроки)
	
	ТаблицаДобавить = ПолучитьИзВременногоХранилища(АдресТаблицы);
	Для каждого ТекСтрокаДобавить Из ТаблицаДобавить Цикл
		НайденныеСтроки = Объект.Модификаторы.НайтиСтроки(Новый Структура("Модификатор, ИдентификаторСтроки", ТекСтрокаДобавить.Модификатор, ИдентификаторСтроки));
		Если НайденныеСтроки.Количество() Тогда
			
			ТекСтрокаМод = НайденныеСтроки[0];
			
			ТекСтрокаМод.Количество						= ТекСтрокаМод.Количество + ТекСтрокаДобавить.Количество;
			ТекСтрокаМод.КоличествоНоменклатуры			= ТекСтрокаМод.КоличествоНоменклатуры + ТекСтрокаДобавить.КоличествоНоменклатуры;
			ТекСтрокаМод.КоличествоУпаковокНоменклатуры	= ТекСтрокаМод.КоличествоУпаковокНоменклатуры + ТекСтрокаДобавить.КоличествоУпаковокНоменклатуры;
			
			ТекСтрокаМод.Сумма = ТекСтрокаМод.Сумма + (ТекСтрокаДобавить.Количество*ТекСтрокаМод.Цена);
			
		Иначе
			
			ТекСтрокаМод = Объект.Модификаторы.Добавить();
			ЗаполнитьЗначенияСвойств(ТекСтрокаМод, ТекСтрокаДобавить);
			ТекСтрокаМод.Номенклатура = ТекСтрокаДобавить.НоменклатураОсновнойПозиции;
			ТекСтрокаМод.Характеристика = ТекСтрокаДобавить.ХарактеристикаОсновнойПозиции;
			ТекСтрокаМод.УпаковкаНоменклатуры = ТекСтрокаДобавить.ЕдиницаИзмеренияНоменклатуры;
			ТекСтрокаМод.ИдентификаторСтроки = ИдентификаторСтроки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Обновить иконки модификаторов.
//
&НаСервере
Процедура ОбновитьИконкиМодификаторов()
	
	ВидыНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Объект.Модификаторы.Выгрузить(,"Номенклатура").ВыгрузитьКолонку("Номенклатура"),"питВидНоменклатуры");
	
	Для каждого ТекМодификатор Из Объект.Модификаторы Цикл
		ТекМодификатор.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(ВидыНоменклатуры[ТекМодификатор.Номенклатура], Ложь, Истина, Истина);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Добавить в структуру действия при изменении количества упаковок серии.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокСерии(ТекущаяСтрока, ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчетаКоличестваЕдиниц = ПараметрыПересчетаКоличестваЕдиниц();
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчетаКоличестваЕдиниц);
	Если ИмяТЧ = "ПобочныеИзделия" Тогда
		СтруктураДействий.Вставить("ПересчитатьСумму");
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Установить видимость запрета отгрузки партнеру.
//
Процедура УстановитьВидимостьЗапретаОтгрузкиПартнеру()
	
	СегментыСервер.УстановитьВидимостьЗапретаОтгрузкиПартнеру(Объект.Партнер, Элементы);
	
КонецПроцедуры

// Процедура - При изменении партнера сервер.
//
Процедура ПриИзмененииПартнераСервер()
	
	ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(Объект.Партнер, Объект.Контрагент);
	
	ПродажиСервер.УстановитьДоступностьДоговора(Объект, Элементы.Договор.Доступность, Элементы.ГруппаДоговор.Видимость, Объект.Договор);
	
КонецПроцедуры

// Процедура - Подключаемый обработать результат проверки контрагентов.
//
&НаКлиенте
Процедура Подключаемый_ОбработатьРезультатПроверкиКонтрагентов()
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.РаботаСКонтрагентами") Тогда
		МодульПроверкаКонтрагентовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроверкаКонтрагентовКлиент");
		// СтандартныеПодсистемы.РаботаСКонтрагентами
		МодульПроверкаКонтрагентовКлиент.ОбработатьРезультатПроверкиКонтрагентовВДокументе(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	КонецЕсли;
КонецПроцедуры

// Процедура - Контрагент при изменении сервер.
//
&НаСервере
Процедура КонтрагентПриИзмененииСервер()
	
	ПродажиСервер.УстановитьДоступностьДоговора(Объект, Элементы.Договор.Доступность, Элементы.ГруппаДоговор.Видимость, Объект.Договор);
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ЗаполнитьДоговорПоУмолчанию();
		// ПродажиСервер.ПартнерПриИзменении(Объект);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Заполнить договор по умолчанию.
//
&НаСервере
Процедура ЗаполнитьДоговорПоУмолчанию()
	
	ХозяйственнаяОперацияДоговора = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");
	Договор = ПродажиСервер.ПолучитьДоговорПоУмолчанию(Объект, 
		ХозяйственнаяОперацияДоговора, 
		Объект.Валюта);
	
КонецПроцедуры

// Процедура - Соглашение при изменении сервер.
//
&НаСервере
Процедура СоглашениеПриИзмененииСервер()
	
	ПоСоглашениюИспользуютсяДоговорыКонтрагентов = ЗначениеЗаполнено(Объект.Соглашение) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Соглашение, "ИспользуютсяДоговорыКонтрагентов");
	
	Если ЭтоРеализация Тогда
		
		ПродажиСервер.УстановитьОтметкуНезаполненногоДоговора(Элементы, "Договор");
		ПродажиСервер.УстановитьДоступностьДоговора(Объект, Элементы.Договор.Доступность, Элементы.ГруппаДоговор.Видимость);
		// Элементы.ГруппаНадписьДоговор.Видимость = Элементы.ГруппаДоговор.Видимость;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Управление связями параметров выбора реквизитов формы.
//
&НаСервере
Процедура УправлениеСвязямиПараметровВыбораРеквизитовФормы()
	
	// Договор, добавляем связь с реквизитом формы ПоСоглашениюИспользуютсяДоговорыКонтрагентов
	ЭлементФормы = Элементы.Договор;
	НовыеСвязиПараметровВыбора = Новый Массив;
	Для Каждого СвязьПараметровВыбора Из ЭлементФормы.СвязиПараметровВыбора Цикл
		Если Не СвязьПараметровВыбора.Имя = "ПоСоглашениюИспользуютсяДоговорыКонтрагентов" Тогда
			НовыеСвязиПараметровВыбора.Добавить(СвязьПараметровВыбора);
		КонецЕсли;
	КонецЦикла;
	ПараметрВыбора = Новый СвязьПараметраВыбора("ПоСоглашениюИспользуютсяДоговорыКонтрагентов", "ПоСоглашениюИспользуютсяДоговорыКонтрагентов", РежимИзмененияСвязанногоЗначения.НеИзменять);
	НовыеСвязиПараметровВыбора.Добавить(ПараметрВыбора);
	ЭлементФормы.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыеСвязиПараметровВыбора);
	
КонецПроцедуры

