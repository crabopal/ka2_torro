
#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Если НЕ Параметры.Свойство("ТекущаяСтрокаТЧ") Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Форма не предназначена для самостоятельного использования");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ТекущаяСтрокаТЧ = Параметры.ТекущаяСтрокаТЧ;
	
	ТекДанныеОбъект = Параметры.ТекДанныеОбъект;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрокаТЧ.Номенклатура) Тогда
		Отказ = Истина;
		Возврат;
	Иначе
		Номенклатура = ТекущаяСтрокаТЧ.Номенклатура;
	КонецЕсли;
	
	// Выводить бизнес ланч или нет
	ВыводитьБизнесЛанч = Истина;
	Если НЕ Номенклатура.ЭтоГруппа И НЕ Номенклатура.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.БизнесЛанч Тогда
		ВыводитьБизнесЛанч = Ложь;
	КонецЕсли;
	
	СписокМодификаторовДляВыбора = Новый СписокЗначений();
	
	// Получим все доступные модификаторы и заполним дерево доступных модификаторов
	ЗаполнитьДоступныеМодификаторы();
	
	МассивНеПодходящих = НеПодходящиеМодификаторы();
	Если МассивНеПодходящих.количество() > 0 Тогда
		Для Каждого Стр из МассивНеПодходящих Цикл
			// Модификатор которыого сейчас нет в списке, но когда документ создавался он был.
			Стр.НеПодходящийМодификатор = Истина;
		КонецЦикла;
	КонецЕсли;
	Модификаторы.Сортировать("НеПодходящийМодификатор");
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Для каждого ТекЭлемент Из ДоступныеМодификаторы.ПолучитьЭлементы() Цикл
		Элементы.ДоступныеМодификаторы.Развернуть(ТекЭлемент.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

//  Процедура - Доступные модификаторы выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДоступныеМодификаторыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ДанныеСтроки = ДоступныеМодификаторы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ДанныеСтроки.Модификатор.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим на наличие выбранного модификатора
	НайденныеСтроки = Модификаторы.НайтиСтроки(Новый Структура("Модификатор, ГруппаМодификатора",ДанныеСтроки.Модификатор,ДанныеСтроки.ГруппаМодификатора));
	Если НайденныеСтроки.Количество() = 0 Тогда
		// Добавляем новую строку
		НоваяСтрока = Модификаторы.Добавить();
		НоваяСтрока.Модификатор = ДанныеСтроки.Модификатор;
		НоваяСтрока.ГруппаМодификатора = ДанныеСтроки.ГруппаМодификатора;
		Если ДанныеСтроки.НеПодходящийМодификатор Тогда
			НоваяСтрока.НеПодходящийМодификатор = Истина;
		КонецЕсли;
		 
		НоваяСтрока.НоменклатураОсновнойПозиции = ТекущаяСтрокаТЧ.Номенклатура;
		НоваяСтрока.ХарактеристикаОсновнойПозиции = ТекущаяСтрокаТЧ.Характеристика;
		
		ОбработкаРеквизита("Модификаторы.Модификатор", НоваяСтрока);
	Иначе
		// Увеличим количество
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + 1;
			ОбработкаРеквизита("Модификаторы.Количество", НайденнаяСтрока);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Модификаторы количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыКоличествоПриИзменении(Элемент)
	ТекСтрока = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбработкаРеквизита("Модификаторы.Количество", ТекСтрока);
КонецПроцедуры

//  Процедура - Модификаторы цена при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыЦенаПриИзменении(Элемент)
	ТекСтрока = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбработкаРеквизита("Модификаторы.Цена", ТекСтрока);
КонецПроцедуры

//  Процедура - Модификаторы сумма при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыСуммаПриИзменении(Элемент)
	ТекСтрока = Элементы.Модификаторы.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбработкаРеквизита("Модификаторы.Сумма", ТекСтрока);
КонецПроцедуры

//  Процедура - Модификаторы перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура МодификаторыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

//  Процедура - Ок.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Ок(Команда)
	
	ОповеститьОВыборе(ВернутьАдресРезультата());
	
КонецПроцедуры

//  Процедура - Очистить.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Очистить(Команда)
	Модификаторы.Очистить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Процедура - Заполнить доступные модификаторы.
//
&НаСервере
Процедура ЗаполнитьДоступныеМодификаторы()
	
	ДоступныеМодификаторыОбъект = ДанныеФормыВЗначение(ДоступныеМодификаторы, Тип("ДеревоЗначений"));
	
	// Получим все группы этой номенклатуры
	МассивГруппНоменклатуры = Новый Массив();
	ТекРодитель = Номенклатура.Родитель;
	Пока питОбщегоНазначенияКлиентСервер.питЗначениеЗаполнено(ТекРодитель) Цикл
		МассивГруппНоменклатуры.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	// Сформируем запрос
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Модификаторы.ГруппаМодификатора КАК ГруппаМодификатора,
	|	Модификаторы.Модификатор КАК Модификатор
	|ИЗ
	|	(ВЫБРАТЬ
	|		СобственныеМодификаторы.Модификатор КАК Модификатор,
	|		СобственныеМодификаторы.ГруппаМодификатора КАК ГруппаМодификатора
	|	ИЗ
	|		РегистрСведений.питМодификаторыНоменклатуры КАК СобственныеМодификаторы
	|	ГДЕ
	|		СобственныеМодификаторы.Номенклатура = &Номенклатура
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		УнаследованныеМодификаторы.Модификатор,
	|		УнаследованныеМодификаторы.ГруппаМодификатора КАК ГруппаМодификатора
	|	ИЗ
	|		РегистрСведений.питМодификаторыНоменклатуры КАК УнаследованныеМодификаторы
	|	ГДЕ
	|		УнаследованныеМодификаторы.Номенклатура В(&МассивГруппНоменклатуры)
	|) КАК Модификаторы
	|
	|СГРУППИРОВАТЬ ПО
	|	Модификаторы.ГруппаМодификатора,
	|	Модификаторы.Модификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаМодификатора УБЫВ,
	|	Модификатор");
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("МассивГруппНоменклатуры", МассивГруппНоменклатуры);
	
	// Выгрузим модификаторы
	ТаблицаМодификаторов = Запрос.Выполнить().Выгрузить();
	
	// Заполняем дерево модификаторов
	Для Каждого СтрокаТаблицы Из ТаблицаМодификаторов Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ГруппаМодификатора) И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Модификатор) Тогда
			СтрокаГруппы = ДоступныеМодификаторыОбъект.Строки.Добавить();
			СтрокаГруппы.Модификатор = СтрокаТаблицы.Модификатор;
			СтрокаГруппы.ГруппаМодификатора = СтрокаТаблицы.ГруппаМодификатора;
			СтрокаГруппы.ЭтоНабор = Истина;
			Если ВыводитьБизнесЛанч Тогда
				// СтрокаГруппы.ДляБизнесЛанча = СтрокаТаблицы.ГруппаМодификатора.ДляБизнесЛанча;
				// СтрокаГруппы.ОбязательныйВыбор = Истина;
				СтрокаГруппы.МинимальноеКоличествоМодификаторов = СтрокаТаблицы.ГруппаМодификатора.МинимальноеКоличествоМодификаторов;
				СтрокаГруппы.МаксимальноеКоличествоМодификаторов = СтрокаТаблицы.ГруппаМодификатора.МаксимальноеКоличествоМодификаторов;
			КонецЕсли;
			
			// Заполним группу элементами
			ЗаполнитьЭлементами(СтрокаТаблицы.ГруппаМодификатора,СтрокаГруппы);
		Иначе
			СтрокаЭлемента = ДоступныеМодификаторыОбъект.Строки.Добавить();
			СтрокаЭлемента.Модификатор = СтрокаТаблицы.Модификатор;
			СтрокаЭлемента.ГруппаМодификатора = СтрокаТаблицы.ГруппаМодификатора;
			СтрокаЭлемента.Цена = СтрокаТаблицы.Модификатор.Цена;
			// СтрокаЭлемента.ЭтоНабор = Истина;
			СписокМодификаторовДляВыбора.Добавить(СтрокаТаблицы.Модификатор, СокрЛП(СтрокаТаблицы.Модификатор.Наименование));
			
			// Если ВыводитьБизнесЛанч Тогда
			// 	СтрокаЭлемента.ДляБизнесЛанча = СтрокаТаблицы.ГруппаМодификатора.ДляБизнесЛанча;
			// КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СписокМодификаторовДляВыбора.СортироватьПоПредставлению();
	
	// Кроме того добавим не доступные, но которые были ранее в документе, что бы пользователь мог восстановить
	// если случайно удалит
	МассивНеПодходящих = НеПодходящиеМодификаторы();
	Если МассивНеПодходящих.количество() > 0 Тогда
		Для Каждого Стр из МассивНеПодходящих Цикл
			СтрокаГруппы = ДоступныеМодификаторыОбъект.Строки.Добавить();
			СтрокаГруппы.Модификатор = Стр.Модификатор;
			СтрокаГруппы.Цена = Стр.Цена;
			СтрокаГруппы.ГруппаМодификатора = "";
			СтрокаГруппы.НеПодходящийМодификатор = Истина;
			СтрокаГруппы.ЭтоНабор = Истина;
		КонецЦикла;
	КонецЕсли;
	ДоступныеМодификаторыОбъект.Строки.Сортировать("НеПодходящийМодификатор");
	
	ЗначениеВДанныеФормы(ДоступныеМодификаторыОбъект, ДоступныеМодификаторы);
	
КонецПроцедуры

//  Функция - Не подходящие модификаторы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция НеПодходящиеМодификаторы()
	Перем Рез;
	Рез = Новый Массив;
	Для Каждого ТекСтрока Из Модификаторы Цикл
		Если СписокМодификаторовДляВыбора.НайтиПоЗначению(ТекСтрока.Модификатор) = Неопределено Тогда
			Рез.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	
	Возврат Рез;
КонецФункции

// Заполнение группы модификаторов
//
// Параметры:
//  ГруппаМодификатора - Произвольный - Группа модификатора.
//  СтрокаГруппы - Строка - Строка группы.
//
&НаСервере
Процедура ЗаполнитьЭлементами(ГруппаМодификатора, СтрокаГруппы)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Модификаторы.Модификатор КАК Модификатор,
	|	Модификаторы.Модификатор.Цена КАК Цена
	|ИЗ
	|	Справочник.питГруппыМодификаторов.Модификаторы КАК Модификаторы
	|ГДЕ
	|	Модификаторы.Ссылка = &ГруппаМодификатора"
	// |	"+?(ВыводитьБизнесЛанч,"","И (НЕ Модификаторы.Ссылка.ДляБизнесЛанча)")
	);
	
	Запрос.УстановитьПараметр("ГруппаМодификатора", ГруппаМодификатора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаЭлемента = СтрокаГруппы.Строки.Добавить();
		СтрокаЭлемента.Модификатор = Выборка.Модификатор;
		СтрокаЭлемента.ГруппаМодификатора = ГруппаМодификатора;
		СтрокаЭлемента.Цена = Выборка.Цена;
		
		СписокМодификаторовДляВыбора.Добавить(Выборка.Модификатор, СокрЛП(Выборка.Модификатор.Наименование));
		
		// Если ВыводитьБизнесЛанч Тогда
		// 	СтрокаЭлемента.ДляБизнесЛанча = Выборка.ГруппаМодификатора.ДляБизнесЛанча;
		// КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Обработка изменения реквизитов формы.
//
// Параметры:
//  ИмяРеквизита - Произвольный - Имя реквизита.
//  ТекСтрока - "Строка табличной части" - Текущая строка табличной части.
//
&НаКлиенте
Процедура ОбработкаРеквизита(ИмяРеквизита,ТекСтрока=Неопределено)
	Если ТекСтрока = Неопределено Тогда
		ТекСтрока = Элементы.Модификаторы.ТекущаяСтрока;	
	КонецЕсли;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяРеквизита="Модификаторы.Модификатор" Тогда
		
		РезультатКоличество = ПолучитьРеквизитыПоСсылке(ТекСтрока.Модификатор, "КоличествоНоменклатуры,КоличествоУпаковокНоменклатуры,ДопНоменклатура,Цена,ЕдиницаИзмеренияМодификатора,ЕдиницаИзмеренияНоменклатуры");
		
		ТекСтрока.ЕдиницаИзмеренияМодификатора = РезультатКоличество.ЕдиницаИзмеренияМодификатора;
		ТекСтрока.НоменклатураОсновнойПозиции = РезультатКоличество.ДопНоменклатура;
		ТекСтрока.ХарактеристикаОсновнойПозиции = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		
		// Подставляем цену модификатора
		ТекСтрока.Цена = РезультатКоличество.Цена;
		
		Если ТекСтрока.Количество=0 или ТекСтрока.Количество=Неопределено Тогда
			ТекСтрока.Количество = 1;
		КонецЕСли;
		
		
		ТекСтрока.Сумма                        = ТекСтрока.Цена * ТекСтрока.Количество;
		ТекСтрока.КоличествоНоменклатуры       = РезультатКоличество.КоличествоНоменклатуры;
		ТекСтрока.КоличествоУпаковокНоменклатуры       = РезультатКоличество.КоличествоУпаковокНоменклатуры;
		
		ТекСтрока.ЕдиницаИзмеренияНоменклатуры = РезультатКоличество.ЕдиницаИзмеренияНоменклатуры;
		
		РеквизитыНоменклатуры = ПолучитьРеквизитыПоСсылке(ТекСтрока.НоменклатураОсновнойПозиции, "питВидНоменклатуры");
		
		ТекСтрока.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(РеквизитыНоменклатуры.питВидНоменклатуры, Ложь, Истина, Истина);
		
		Если Элементы.МодификаторыРецептура.Видимость И РеквизитыНоменклатуры.питВидНоменклатуры = ПредопределенноеЗначение("Перечисление.питВидыНоменклатуры.Блюдо") Тогда
			// Найдем основную рецептуру для блюда.
			ТекСтрока.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекСтрока.НоменклатураОсновнойПозиции, ТекСтрока.ХарактеристикаОсновнойПозиции, ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.РецептураПриготовление"), ТекДанныеОбъект.Дата, ТекДанныеОбъект.СпособРасчетаРецептуры,,ТекДанныеОбъект.Организация,,, ТекДанныеОбъект.Подразделение);
		КонецЕсли;
		
		ОбработкаРеквизита("Модификаторы.Количество", ТекСтрока);
		
	
		
	ИначеЕсли ИмяРеквизита="Модификаторы.Количество" Тогда 		
		
		РезультатКоличество = ПолучитьРеквизитыПоСсылке(ТекСтрока.Модификатор,"КоличествоНоменклатуры,КоличествоУпаковокНоменклатуры");
		
		ТекСтрока.Сумма                  = ТекСтрока.Цена * ТекСтрока.Количество;
		ТекСтрока.КоличествоНоменклатуры = РезультатКоличество.КоличествоНоменклатуры * ТекСтрока.Количество;
		ТекСтрока.КоличествоУпаковокНоменклатуры = РезультатКоличество.КоличествоУпаковокНоменклатуры * ТекСтрока.Количество;
		
	ИначеЕсли ИмяРеквизита="Модификаторы.Цена" Тогда 			
		ТекСтрока.Сумма = ТекСтрока.Цена * ТекСтрока.Количество;
		
	ИначеЕсли ИмяРеквизита="Модификаторы.Сумма" Тогда 
		Если ТекСтрока.Количество<>0 Тогда
			ТекСтрока.Цена = ТекСтрока.Сумма / ТекСтрока.Количество;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры // ОбработкаРеквизита() 

//  Функция - Получить реквизиты по ссылке.
//
// Параметры:
//  Модификатор - Произвольный - Модификатор.
//  Реквизиты - Произвольный - Реквизиты.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучитьРеквизитыПоСсылке(Модификатор, Реквизиты)
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Модификатор, Реквизиты);
КонецФункции

//  Функция - Вернуть адрес результата.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ВернутьАдресРезультата()
	
	Возврат ПоместитьВоВременноеХранилище(Модификаторы.Выгрузить());
	
КонецФункции


#КонецОбласти





