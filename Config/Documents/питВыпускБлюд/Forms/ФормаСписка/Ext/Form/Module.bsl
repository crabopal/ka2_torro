#Область ПрограммныйИнтерфейс

#Область Печать

//  Процедура - Выполнить команду печати завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВыполнитьКомандуПечатиЗавершение(Результат, Команда) Экспорт
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	Если НЕ ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда
		ОписаниеКоманды.Вставить("ДополнительныеПараметры", Новый Структура());
	КонецЕсли;
	
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКоманды ="питОП1_СПараметрами" ИЛИ ИдентификаторКоманды ="питОП1_ТБ_СПараметрами" Тогда
		ОписаниеКоманды.ДополнительныеПараметры.ДополнительныеПараметры.Вставить("СтруктураПараметровОП1", Результат);
	Иначе
		Возврат;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийФормы
//////////////////////////////////////////////////////////////////////////////////
//// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область Печать

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	ИмяФормыПараметровПечати = "";
	
	СтруктураПараметровПечати = Новый Структура;
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
//   Устанавливаем заголовок формы печати, если требуется(например для указания, каким образом была получена суммовая
// оценка).
		Если ОписаниеКоманды.ДополнительныеПараметры.Свойство("ЗаголовокФормы") Тогда
			ОписаниеКоманды.ДополнительныеПараметры.ЗаголовокФормы = питОтчеты.ПолучитьЗаголовокПечатнойФормыОбщепит(ИдентификаторКоманды, ТекДанные.Ссылка, ОписаниеКоманды.Представление);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Не выбрана строка блюда");
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКоманды ="питОП1_СПараметрами" Или ИдентификаторКоманды ="питОП1_ТБ_СПараметрами" Тогда
		ИмяФормыПараметровПечати = "Документ.питВыпускБлюд.Форма.ФормаПараметрыПечатиОП1";
	КонецЕсли;
	
	Если ИмяФормыПараметровПечати <> "" Тогда
		ОбъектыПечати = питОтчетыКлиент.ОбъектыПечати(Элементы.Список);
		ПараметрыФормы = Новый Структура("МассивОбъектов", ОбъектыПечати);  //Команда.ОбъектыПечати);
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьКомандуПечатиЗавершение", ЭтотОбъект, Команда);
		ОткрытьФорму(ИмяФормыПараметровПечати, ПараметрыФормы,,,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение);
		
	Иначе
		
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Печать

