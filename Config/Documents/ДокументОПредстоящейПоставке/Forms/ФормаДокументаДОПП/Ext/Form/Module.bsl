&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗаголовкиСтрок(СтрокаТаблицы)
	
	СтрокаТаблицы.НадписьНомерДокумента = НСтр("ru='Номер:'");
	СтрокаТаблицы.НадписьДатаДокумента  = НСтр("ru='Дата:'");
	СтрокаТаблицы.НадписьПоДокументу    = НСтр("ru='По документу:'");
	СтрокаТаблицы.НадписьПоТНВЭД        = НСтр("ru='По ТН ВЭД:'");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьАналитикуАкцизов(СтрокаТабличнойЧасти)
	
	Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.НалоговаяБазаАкцизы) Тогда
		
		
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.АдвалорнаяСтавкаАкциза) Тогда
			
			ТекстСообщения = НСтр("ru='%1 руб. (%2 руб. * %3%%)'");
			
			СтрокаТабличнойЧасти.АналитикаАкциза = СтрШаблон(ТекстСообщения,
			СтрокаТабличнойЧасти.СуммаАкциза,
			СтрокаТабличнойЧасти.НалоговаяБазаАкцизы,
			СтрокаТабличнойЧасти.АдвалорнаяСтавкаАкциза);
			
		Иначе
			
			Если СтрокаТабличнойЧасти.ЕдиницаИзмеренияАкциза = "112" Тогда
				ЕдиницаНалоговойБазы = НСтр("ru='литров'");
				ЕдиницаСтавки = НСтр("ru='за литр'");
			ИначеЕсли СтрокаТабличнойЧасти.ЕдиницаИзмеренияАкциза = "168" Тогда
				ЕдиницаНалоговойБазы = НСтр("ru='тонн'");
				ЕдиницаСтавки = НСтр("ru='за тонну'");
			ИначеЕсли СтрокаТабличнойЧасти.ЕдиницаИзмеренияАкциза = "251" Тогда
				ЕдиницаНалоговойБазы = НСтр("ru='лошадиных сил'");
				ЕдиницаСтавки = НСтр("ru='за лошадиную силу'");
			ИначеЕсли СтрокаТабличнойЧасти.ЕдиницаИзмеренияАкциза = "831" Тогда
				ЕдиницаНалоговойБазы = НСтр("ru='литров 100% спирта'");
				ЕдиницаСтавки = НСтр("ru='за литр 100% спирта'");
			Иначе
				ЭлементЕдиницыИзмеренияАкциза = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(СтрокаТабличнойЧасти.ЕдиницаИзмеренияАкциза);
				Если ЭлементЕдиницыИзмеренияАкциза <> Неопределено Тогда
					ЕдиницаНалоговойБазы = ЭлементЕдиницыИзмеренияАкциза;
					ЕдиницаСтавки = НСтр("ru='за '" + ЭлементЕдиницыИзмеренияАкциза);
				КонецЕсли
			КонецЕсли;
			
			ТекстСообщения = НСтр("ru='%1 руб. (%2 %3 * %4 %5)'");
			
			СтрокаТабличнойЧасти.АналитикаАкциза = СтрШаблон(ТекстСообщения,
			СтрокаТабличнойЧасти.СуммаАкциза,
			СтрокаТабличнойЧасти.НалоговаяБазаАкцизы,
			ЕдиницаНалоговойБазы,
			СтрокаТабличнойЧасти.ТвердаяСтавкаАкциза,
			ЕдиницаСтавки);
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТабличнойЧасти.АналитикаАкциза = НСтр("ru='Без акциза'");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НоменклатураПриИзмененииСервер(СтрокаТабличнойЧасти, ДанныеОбъекта, СтруктураКурса = Неопределено)
	
	СтавкаНДС10 = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(
				Перечисления.СтавкиНДС.НДС10, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	ОсновнаяСтавкаНДС = УчетНДСУП.СтавкаНДСПоУмолчанию(Неопределено, Объект.Дата);
	
	Если СтрокаТабличнойЧасти.СтавкаНДС <> СтавкаНДС10
		И СтрокаТабличнойЧасти.СтавкаНДС <> ОсновнаяСтавкаНДС Тогда
		СтрокаТабличнойЧасти.СтавкаНДС = ОсновнаяСтавкаНДС;
	КонецЕсли;
	
	РасчитатьСуммыВТабличнойЧастиНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта, СтруктураКурса);
	
КонецПроцедуры

&НаСервере
Процедура РасчитатьСуммыВТабличнойЧастиНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта, СтруктураКурса = Неопределено)
	
	РасчитатьСуммыВТабличнойЧастиДОПП(СтрокаТабличнойЧасти, ДанныеОбъекта);
	ОбновитьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура РасчитатьСуммыВТабличнойЧастиДОПП(СтрокаТабличнойЧасти, ДанныеОбъекта, СтруктураКурса = Неопределено) Экспорт
	
	// Рассчитаем по фактурной стоимости налоговую базу в рублях на дату, предшествующую дате ввоза товаров
	Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.АдвалорнаяСтавкаАкциза)
		И Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ТвердаяСтавкаАкциза) Тогда
		ВидАкциза = 2;
	Иначе
		ВидАкциза = 1;
	КонецЕсли;
	
	Если СтрокаТабличнойЧасти.ОсобыйПризнакДОПП = "0" Тогда 
		Если ДанныеОбъекта.Валюта <> ДанныеОбъекта.ВалютаРегламентированногоУчета Тогда
			Если СтруктураКурса = Неопределено Тогда
				ДатаДляРасчетаКурса = ДанныеОбъекта.Дата - 86400;
				СтруктураКурса = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ДанныеОбъекта.Валюта, ДатаДляРасчетаКурса);
				Если СтруктураКурса.КурсЗнаменатель = 0 Тогда
					СтруктураКурса.КурсЗнаменатель = 1;
				КонецЕсли;
			КонецЕсли;
			ФактурнаяСтоимость = Окр((СтрокаТабличнойЧасти.ФактурнаяСтоимость * (СтруктураКурса.КурсЧислитель/СтруктураКурса.КурсЗнаменатель)), 2);
			Если ВидАкциза = 2 Тогда
				СтрокаТабличнойЧасти.СуммаАкциза = ФактурнаяСтоимость * СтрокаТабличнойЧасти.АдвалорнаяСтавкаАкциза / 100;
			КонецЕсли;
			СтрокаТабличнойЧасти.НалоговаяБазаНДС = ФактурнаяСтоимость + СтрокаТабличнойЧасти.СуммаАкциза;
		Иначе
			Если ВидАкциза = 2 Тогда
				СтрокаТабличнойЧасти.СуммаАкциза = СтрокаТабличнойЧасти.ФактурнаяСтоимость * СтрокаТабличнойЧасти.АдвалорнаяСтавкаАкциза / 100;
			КонецЕсли;
			СтрокаТабличнойЧасти.НалоговаяБазаНДС = СтрокаТабличнойЧасти.ФактурнаяСтоимость + СтрокаТабличнойЧасти.СуммаАкциза;
		КонецЕсли;
	Иначе
		СтрокаТабличнойЧасти.НалоговаяБазаНДС = 0;
		СтрокаТабличнойЧасти.СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка();
		СтрокаТабличнойЧасти.СуммаАкциза = 0;
	КонецЕсли;
	
	// Рассчитаем по налоговой базе и ставке сумму НДС
	СтрокаТабличнойЧасти.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
		СтрокаТабличнойЧасти.НалоговаяБазаНДС,
		Ложь,
		УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС));
		
	Если ДанныеОбъекта.ОсобыйПризнакЗаявителя = "0" И СтрокаТабличнойЧасти.ОсобыйПризнакДОПП = "0" Тогда
		Если СтрокаТабличнойЧасти.МаркируемаяПродукция = Истина Тогда
			СтрокаТабличнойЧасти.ОбеспечительныйПлатеж = СтрокаТабличнойЧасти.СуммаНДС;
		Иначе
			СтрокаТабличнойЧасти.ОбеспечительныйПлатеж = СтрокаТабличнойЧасти.СуммаНДС + СтрокаТабличнойЧасти.СуммаАкциза;
		КонецЕсли;
	Иначе
		СтрокаТабличнойЧасти.ОбеспечительныйПлатеж = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораАкцизы(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
	
	ДанныеСтрокиТаблицы = Новый Структура(
		"ФактурнаяСтоимость,НалоговаяБазаНДС,СтавкаНДС,СуммаНДС,ОбеспечительныйПлатеж,КатегорияПодакцизныхТоваров,КБК,МаркируемаяПродукция,
		|НалоговаяБазаАкцизы,ЕдиницаИзмеренияАкциза,ТвердаяСтавкаАкциза,АдвалорнаяСтавкаАкциза,СуммаАкциза,АналитикаАкциза, ОсобыйПризнакДОПП");
		
	ДанныеОбъекта = Новый Структура(
		"ВалютаРегламентированногоУчета,Валюта,Дата,ОсобыйПризнакЗаявителя",
		ВалютаРегламентированногоУчета, Объект.Валюта, Объект.Дата, Объект.ОсобыйПризнакЗаявителя);
		
	ЗаполнитьЗначенияСвойств(ДанныеСтрокиТаблицы, СтрокаТабличнойЧасти);
	ЗаполнитьЗначенияСвойств(ДанныеСтрокиТаблицы, ВыбранноеЗначение);
	
	РасчитатьСуммыВТабличнойЧастиНаСервере(ДанныеСтрокиТаблицы, ДанныеОбъекта);
	ЗаполнитьАналитикуАкцизов(ДанныеСтрокиТаблицы);
	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ДанныеСтрокиТаблицы);
	ОбновитьИтоги(ЭтотОбъект);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДоговорКонтрагентаПриИзмененииНаСервере()

	ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВалютаВзаиморасчетов");
	
	Если Объект.Валюта <> ВалютаДоговора Тогда
		
		Объект.Валюта = ВалютаДоговора;
		НаименованиеВалютыДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Валюта, "Наименование");
		
		ДанныеОбъекта = Новый Структура(
			"ВалютаРегламентированногоУчета,Валюта,Дата,ОсобыйПризнакЗаявителя",
			ВалютаРегламентированногоУчета, Объект.Валюта, Объект.Дата, Объект.ОсобыйПризнакЗаявителя);
		
		Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
			
			РасчитатьСуммыВТабличнойЧастиНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта);
			
		КонецЦикла;
		
		УправлениеФормой(ЭтотОбъект);
		ОбновитьИтоги(ЭтотОбъект);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОсобыйПризнакЗаявителяПриИзмененииНаСервере()
	
	ДанныеОбъекта = Новый Структура(
		"ВалютаРегламентированногоУчета,Валюта,Дата,ОсобыйПризнакЗаявителя",
		ВалютаРегламентированногоУчета, Объект.Валюта, Объект.Дата, Объект.ОсобыйПризнакЗаявителя);
	
	Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
		
		РасчитатьСуммыВТабличнойЧастиНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта);
		
	КонецЦикла;
	
	УправлениеФормой(ЭтотОбъект);
	ОбновитьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	УстановитьОсобыйПризнакЗаявителя();
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		КонтрагентОбработатьИзменение();
	КонецЕсли;
	
	СтруктураРеквизитовВыгрузки = ОбновитьДанныеРеквизитовВыгрузки();
		
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмпортПодакцизныхТоваров Тогда
		КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		СтруктураДействий = Новый Структура();
		ПараметрыЗаполнения =
			ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияПризнакаПодакцизныйТовар(Объект);
		СтруктураДействий.Вставить("ЗаполнитьРеквизитыРасчетаАкциза", ПараметрыЗаполнения);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.Товары, СтруктураДействий, КэшированныеЗначения);

		Если Объект.Валюта <> ВалютаРегламентированногоУчета Тогда
			
			ДанныеОбъекта = Новый Структура(
				"ВалютаРегламентированногоУчета,Валюта,Дата,ОсобыйПризнакЗаявителя",
				ВалютаРегламентированногоУчета, Объект.Валюта, Объект.Дата, Объект.ОсобыйПризнакЗаявителя);
				
			ДатаДляРасчетаКурса = ДанныеОбъекта.Дата - 86400;
			СтруктураКурса = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ДанныеОбъекта.Валюта, ДатаДляРасчетаКурса);
			Если СтруктураКурса.КурсЗнаменатель = 0 Тогда
				СтруктураКурса.КурсЗнаменатель = 1;
			КонецЕсли;
				
			Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
				РасчитатьСуммыВТабличнойЧастиНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта, СтруктураКурса);
			КонецЦикла;
			
		КонецЕсли;

		Для Каждого Строка Из Объект.Товары Цикл
			
			Строка.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
				Строка.НалоговаяБазаНДС,
				УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(Строка.СтавкаНДС),
				Ложь);
			ЗаполнитьАналитикуАкцизов(Строка);

		КонецЦикла;
	
	КонецЕсли;

	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
	
	СобытияФорм.ПриИзмененииЭлемента(ЭтотОбъект, "Товары");
	
	УправлениеФормой(ЭтотОбъект);
	ОбновитьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	СтруктураДействий = Новый Структура;
	СтруктураЗаполненияСтавкиНДС = 
		ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияСтавкиНДС(Объект);
	СтруктураЗаполненияСтавкиНДС.ИнициализацияВходящегоДокумента = Истина;
	
	СтруктураДействий.Вставить("СкорректироватьСтавкуНДС", СтруктураЗаполненияСтавкиНДС);
	Если ИмпортПодакцизныхТоваров Тогда
		ПараметрыЗаполнения =
			ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияПризнакаПодакцизныйТовар(Объект);
		СтруктураДействий.Вставить("ЗаполнитьРеквизитыРасчетаАкциза", ПараметрыЗаполнения);
	КонецЕсли;

	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Объект.Товары, СтруктураДействий, КэшированныеЗначения);
	
	Если Объект.Валюта <> ВалютаРегламентированногоУчета Тогда
		
		ДанныеОбъекта = Новый Структура(
			"ВалютаРегламентированногоУчета,Валюта,Дата,ОсобыйПризнакЗаявителя",
			ВалютаРегламентированногоУчета, Объект.Валюта, Объект.Дата, Объект.ОсобыйПризнакЗаявителя);
			
		ДатаДляРасчетаКурса = ДанныеОбъекта.Дата - 86400;
		СтруктураКурса = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(ДанныеОбъекта.Валюта, ДатаДляРасчетаКурса);
		Если СтруктураКурса.КурсЗнаменатель = 0 Тогда
			СтруктураКурса.КурсЗнаменатель = 1;
		КонецЕсли;
			
		Для каждого СтрокаТабличнойЧасти Из Объект.Товары Цикл
			РасчитатьСуммыВТабличнойЧастиНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта, СтруктураКурса);
		КонецЦикла;
		
	КонецЕсли;
	
	СтавкаНДС10 = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(
				Перечисления.СтавкиНДС.НДС10, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	ОсновнаяСтавкаНДС = УчетНДСУП.СтавкаНДСПоУмолчанию(Неопределено, Объект.Дата);
	
	Для Каждого Строка Из Объект.Товары Цикл
		
		Если Строка.СтавкаНДС <> СтавкаНДС10 Тогда
			Строка.СтавкаНДС = ОсновнаяСтавкаНДС;
		КонецЕсли;
		
		Строка.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
			Строка.НалоговаяБазаНДС,
			УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(Строка.СтавкаНДС),
			Ложь);
		ЗаполнитьАналитикуАкцизов(Строка);

	КонецЦикла;
	
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);
	
	СобытияФорм.ПриИзмененииЭлемента(ЭтотОбъект, "Товары");
	
	УстановитьСписокВыбораСтавкиНДС();
	УправлениеФормой(ЭтотОбъект);
	
	ОбновитьИтоги(ЭтотОбъект);
		
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()

	КонтрагентОбработатьИзменение();
	
	УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура КонтрагентОбработатьИзменение()

	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ДоговорКонтрагентаПриИзмененииНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьОсобыйПризнакЗаявителя()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация, "ОсобыйПризнакЗаявителяДОПП, ИнойОсобыйПризнакЗаявителяДОПП");
		Объект.ОсобыйПризнакЗаявителя = РеквизитыОрганизации.ОсобыйПризнакЗаявителяДОПП;
		Если Объект.ОсобыйПризнакЗаявителя = "2" Тогда
			Объект.ИнойОсобыйПризнакЗаявителя = РеквизитыОрганизации.ИнойОсобыйПризнакЗаявителяДОПП;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ОсобыйПризнакЗаявителя) Тогда
			Объект.ОсобыйПризнакЗаявителя = "0";
		КонецЕсли;
		ОсобыйПризнакЗаявителяПриИзмененииНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияАкцизов(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ДанныеСтроки = Объект.Товары.НайтиПоИдентификатору(ВыбранноеЗначение);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ТолькоПросмотр",             ТолькоПросмотр);
	ПараметрыФормы.Вставить("НалоговаяБазаАкцизы",        ДанныеСтроки.НалоговаяБазаАкцизы);
	ПараметрыФормы.Вставить("ТвердаяСтавкаАкциза",        ДанныеСтроки.ТвердаяСтавкаАкциза);
	ПараметрыФормы.Вставить("АдвалорнаяСтавкаАкциза",     ДанныеСтроки.АдвалорнаяСтавкаАкциза);
	ПараметрыФормы.Вставить("ЕдиницаИзмеренияАкциза",     ДанныеСтроки.ЕдиницаИзмеренияАкциза);
	ПараметрыФормы.Вставить("СуммаАкциза",                ДанныеСтроки.СуммаАкциза);
	ПараметрыФормы.Вставить("Номенклатура",               ДанныеСтроки.Номенклатура);
	ПараметрыФормы.Вставить("ФактурнаяСтоимость",         ДанныеСтроки.ФактурнаяСтоимость);
	ПараметрыФормы.Вставить("ЕдиницаИзмерения",           ДанныеСтроки.Упаковка);
	ПараметрыФормы.Вставить("КодТНВЭД",                   ДанныеСтроки.КодТНВЭД);
	ПараметрыФормы.Вставить("Количество",                 ДанныеСтроки.Количество);
	ПараметрыФормы.Вставить("ДатаПринятияНаУчет",         Объект.Дата);
	ПараметрыФормы.Вставить("Организация",                Объект.Организация);
	ПараметрыФормы.Вставить("ВалютаДокумента",            Объект.Валюта);
	ПараметрыФормы.Вставить("ВалютаРеглУчета",            ВалютаРегламентированногоУчета);
	ПараметрыФормы.Вставить("ЕстьУчетПодакцизныхТоваров", ДанныеСтроки.ПодакцизныйТовар);
	ПараметрыФормы.Вставить("КоэфициентПересчета",        ДанныеСтроки.КоэффициентПересчета);
	ПараметрыФормы.Вставить("КатегорияПодакцизныхТоваров",ДанныеСтроки.КатегорияПодакцизныхТоваров);
	ПараметрыФормы.Вставить("КБК",                        ДанныеСтроки.КБК);
	ПараметрыФормы.Вставить("МаркируемаяПродукция",       ДанныеСтроки.МаркируемаяПродукция);
	
	КодыБКМассив = Новый Массив();
	Для Каждого КБК Из КодыБК Цикл
		СтруктураСтроки = Новый Структура();
		СтруктураСтроки.Вставить("Код",      КБК.Код);
		СтруктураСтроки.Вставить("Название", КБК.Название);
		КодыБКМассив.Добавить(СтруктураСтроки);
	КонецЦикла;
	ПараметрыФормы.Вставить("КодыБК", КодыБКМассив);
	
	КБКПокатегориямПараметр = Новый Массив();
	Для Каждого КБК Из КБКПокатегориям Цикл
		СтруктураСтроки = Новый Структура();
		СтруктураСтроки.Вставить("Код",                   КБК.Код);
		СтруктураСтроки.Вставить("КодПодакцизногоТовара", КБК.КодПодакцизногоТовара);
		КБКПокатегориямПараметр.Добавить(СтруктураСтроки);
	КонецЦикла;
	ПараметрыФормы.Вставить("КБКПокатегориям", КБКПокатегориямПараметр);
	
	ОткрытьФорму("Документ.ДокументОПредстоящейПоставке.Форма.ФормаРедактированияАкцизов", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаВЭлектронномВиде

&НаКлиенте
Процедура ОткрытьФормуСведенияОПодписантах()

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СтруктураРеквизитов", СтруктураРеквизитовВыгрузки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПараметрыВыгрузкиЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ДокументОПредстоящейПоставке.Форма.ФормаСведенияОПодписантах", ПараметрыФормы, ЭтотОбъект,,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыВыгрузкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		СтруктураРеквизитовВыгрузки = Результат;
		
		Модифицированность = Истина;
				
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбновитьДанныеРеквизитовВыгрузки()
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Объект.Ссылка);
				
	ЭтоПБОЮЛ = НЕ РегламентированнаяОтчетностьВызовСервера.ЭтоЮридическоеЛицо(Объект.Организация);
	
	СтрокаСведений = "ИННЮЛ, ИННФЛ, КППЮЛ, НаимЮЛПол, ФИО, КодНО, ФИОРук, ФИОБух, ФИОУпПред, ИННРук, ИННБух, ИННУпПред";
	СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Объект.Организация, Объект.Дата, СтрокаСведений);
	
	ПараметрыВыгрузки = Новый Структура;
	
	Если НЕ ЗначениеЗаполнено(СведенияОбОрганизации) Тогда
		Возврат ПараметрыВыгрузки;
	КонецЕсли;
				
	ПараметрыВыгрузки.Вставить("ЭтоПБОЮЛ", ЭтоПБОЮЛ);
	ПараметрыВыгрузки.Вставить("НалогоплательщикИННЮЛ", СведенияОбОрганизации.ИННЮЛ);
	ПараметрыВыгрузки.Вставить("НалогоплательщикКПП", 	СведенияОбОрганизации.КППЮЛ);
	ПараметрыВыгрузки.Вставить("НалогоплательщикИННФЛ", СведенияОбОрганизации.ИННФЛ);
	ПараметрыВыгрузки.Вставить("НалогоплательщикНаимЮЛ",СведенияОбОрганизации.НаимЮЛПол);
	ПараметрыВыгрузки.Вставить("НалогоплательщикФИО", 	СведенияОбОрганизации.ФИО);
	
	ПараметрыВыгрузки.Вставить("КодИФНС", СведенияОбОрганизации.КодНО);
	
	ДанныеПредставителя = ПолучитьСведенияОПредставителе(СведенияОбОрганизации.КодНО);
	
	ПараметрыВыгрузки.Вставить("ПрОтпр", Число(ДанныеПредставителя.ТипПредставителя));
	
	ОтправительЯвляетсяЮЛ = Истина;
	
	Если ДанныеПредставителя.ТипПредставителя = "1" Тогда
		
		ФИОПодп1Титул = СведенияОбОрганизации.ФИОРук;
		ФИОПодп2Титул = СведенияОбОрганизации.ФИОБух;
		
	Иначе
		
		ФИОПодп1Титул = СведенияОбОрганизации.ФИОУпПред;
		
	КонецЕсли;
	
	НаимОтпр 		= "";
	ИННЮЛОтпр		= "";
	КППОтпр         = "";

	ИННФЛОтпр       = "";

	ФамилияФЛОтпр   = "";
	ИмяФЛОтпр       = "";
	ОтчествоФЛОтпр  = "";

	ПрПодп1         = 0;
	ИННФЛПодп1      = СведенияОбОрганизации.ИННРук;
	ДолжностьПодп1  = "";
	
	ФамилияПодп1    = "";
	ИмяПодп1        = "";
	ОтчествоПодп1   = "";

	НаимДовПодп1    = "";
	НомерДовПодп1   = "";
	ДатаДовПодп1    = "";
	
	ПрПодп2         = 0;
    ИННФЛПодп2      = СведенияОбОрганизации.ИННБух;;
	ДолжностьПодп2  = "";
	
	ФамилияПодп2    = "";
	ИмяПодп2        = "";
	ОтчествоПодп2   = "";
	
	НаимДовПодп2    = "";
	НомерДовПодп2   = "";
	ДатаДовПодп2    = "";

	ПрКурьер        = 0;
	ИННФЛКурьер		= ИННФЛПодп1;

	ФамилияКурьер   = "";
	ИмяКурьер       = "";
	ОтчествоКурьер  = "";
	
	НаимДовКурьер   = "";
	НомерДовКурьер  = "";
	ДатаДовКурьер   = "";

	Если ДанныеПредставителя.ТипПредставителя = "1" Тогда

		Если НЕ ЭтоПБОЮЛ Тогда
			
			ОтправительЯвляетсяЮЛ = Истина;
			
			НаимОтпр 		= СведенияОбОрганизации.НаимЮЛПол;
			ИННЮЛОтпр		= СведенияОбОрганизации.ИННЮЛ;
			КППОтпр         = СведенияОбОрганизации.КППЮЛ;
			
			ПрПодп1 = 2;
			
			ФИОПодп1        = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп1Титул);
			ФамилияПодп1    = ФИОПодп1.Фамилия;
			ИмяПодп1        = ФИОПодп1.Имя;
			ОтчествоПодп1   = ФИОПодп1.Отчество;
			
			ПрПодп2 = 2;
			
			ФИОПодп2        = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп2Титул);
			ФамилияПодп2    = ФИОПодп2.Фамилия;
			ИмяПодп2        = ФИОПодп2.Имя;
			ОтчествоПодп2   = ФИОПодп2.Отчество;
			
			ПрКурьер = 2;

			ФамилияКурьер   = ФИОПодп1.Фамилия;
			ИмяКурьер       = ФИОПодп1.Имя;
			ОтчествоКурьер  = ФИОПодп1.Отчество;
			
		Иначе
			
			ОтправительЯвляетсяЮЛ = Ложь;
			
			ИННФЛОтпр        = СведенияОбОрганизации.ИННФЛ;
			
			ФИОотправителя   = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп1Титул);
			ФамилияФЛОтпр    = ФИОотправителя.Фамилия;
			ИмяФЛОтпр        = ФИОотправителя.Имя;
			ОтчествоФЛОтпр   = ФИОотправителя.Отчество;

			ПрПодп1 = 1;
			ФИОПодп1        = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп1Титул);
			ФамилияПодп1    = ФИОПодп1.Фамилия;
			ИмяПодп1        = ФИОПодп1.Имя;
			ОтчествоПодп1   = ФИОПодп1.Отчество;
			
			ПрКурьер = 1;
			
			ФамилияКурьер   = ФИОотправителя.Фамилия;
			ИмяКурьер       = ФИОотправителя.Имя;
			ОтчествоКурьер  = ФИОотправителя.Отчество;
			
		КонецЕсли;
		
	Иначе
		
		Если ДанныеПредставителя.флПредставительЮрЛицо Тогда

			ОтправительЯвляетсяЮЛ = Истина;
			
			ПредставительСсылка = ДанныеПредставителя.ПредставительСсылка;
			НаимОтпр 		    = СокрЛП(ПредставительСсылка);
			ИННЮЛОтпр		    = ПредставительСсылка.ИНН;
			КППОтпр             = ПредставительСсылка.КПП;	
			
			ПрПодп1 = 3;
			ФИОПодп1        = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп1Титул);
			ФамилияПодп1    = ФИОПодп1.Фамилия;
			ИмяПодп1        = ФИОПодп1.Имя;
			ОтчествоПодп1   = ФИОПодп1.Отчество;

			ФИОПодп2        = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп2Титул);
			ФамилияПодп2    = ФИОПодп2.Фамилия;
			ИмяПодп2        = ФИОПодп2.Имя;
			ОтчествоПодп2   = ФИОПодп2.Отчество;

			ПрКурьер 		= 3;

			ФамилияКурьер   = ФИОПодп1.Фамилия;
			ИмяКурьер       = ФИОПодп1.Имя;
			ОтчествоКурьер  = ФИОПодп1.Отчество;
			
		Иначе
			
			ОтправительЯвляетсяЮЛ = Ложь;
			
			ИННФЛОтпр        = СведенияОбОрганизации.ИННУпПред;
			
			ФИОотправителя   = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп1Титул);
			ФамилияФЛОтпр    = ФИОотправителя.Фамилия;
			ИмяФЛОтпр        = ФИОотправителя.Имя;
			ОтчествоФЛОтпр   = ФИОотправителя.Отчество;
			
			ПрПодп1 		= 3;
			ФамилияПодп1    = ФИОотправителя.Фамилия;
			ИмяПодп1        = ФИОотправителя.Имя;
			ОтчествоПодп1   = ФИОотправителя.Отчество;
			
			ФИОПодп2        = РегламентированнаяОтчетность.РазложитьФИО(ФИОПодп2Титул);
			ФамилияПодп2    = ФИОПодп2.Фамилия;
			ИмяПодп2        = ФИОПодп2.Имя;
			ОтчествоПодп2   = ФИОПодп2.Отчество;
			
			ПрКурьер = 3;
			
			ФамилияКурьер   = ФИОотправителя.Фамилия;
			ИмяКурьер       = ФИОотправителя.Имя;
			ОтчествоКурьер  = ФИОотправителя.Отчество;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыВыгрузки.Вставить("ОтправительЯвляетсяЮЛ", ОтправительЯвляетсяЮЛ);
	
	ПараметрыВыгрузки.Вставить("НаимОтпр", 		НаимОтпр);
	ПараметрыВыгрузки.Вставить("ИННЮЛОтпр",		ИННЮЛОтпр);
	ПараметрыВыгрузки.Вставить("КППОтпр",       КППОтпр);

	ПараметрыВыгрузки.Вставить("ИННФЛОтпр",     ИННФЛОтпр);

	ПараметрыВыгрузки.Вставить("ФамилияФЛОтпр", ФамилияФЛОтпр);
	ПараметрыВыгрузки.Вставить("ИмяФЛОтпр",     ИмяФЛОтпр);
	ПараметрыВыгрузки.Вставить("ОтчествоФЛОтпр",ОтчествоФЛОтпр);
	
	Если ТипЗнч(СтруктураРеквизитовВыгрузки) = Тип("Структура") Тогда
		
		ПараметрыВыгрузки.Вставить("ИмпортерСовпадаетСОтправителем",
			СтруктураРеквизитовВыгрузки.ИмпортерСовпадаетСОтправителем);
		
		ПараметрыВыгрузки.Вставить("ИмпортерЯвляетсяЮЛ", СтруктураРеквизитовВыгрузки.ИмпортерЯвляетсяЮЛ);
		
		ПараметрыВыгрузки.Вставить("НаимИмпорт",  СтруктураРеквизитовВыгрузки.НаимИмпорт);
		ПараметрыВыгрузки.Вставить("ИННЮЛИмпорт", СтруктураРеквизитовВыгрузки.ИННЮЛИмпорт);
		ПараметрыВыгрузки.Вставить("КППИмпорт",   СтруктураРеквизитовВыгрузки.КППИмпорт);
		
		ПараметрыВыгрузки.Вставить("ИННФЛИмпорт",      СтруктураРеквизитовВыгрузки.ИННФЛИмпорт);
		ПараметрыВыгрузки.Вставить("ФамилияФЛИмпорт",  СтруктураРеквизитовВыгрузки.ФамилияФЛИмпорт);
		ПараметрыВыгрузки.Вставить("ИмяФЛИмпорт",      СтруктураРеквизитовВыгрузки.ИмяФЛИмпорт);
		ПараметрыВыгрузки.Вставить("ОтчествоФЛИмпорт", СтруктураРеквизитовВыгрузки.ОтчествоФЛИмпорт);
		
	Иначе
		
		ПараметрыВыгрузки.Вставить("ИмпортерСовпадаетСОтправителем", Истина);
		
		ПараметрыВыгрузки.Вставить("ИмпортерЯвляетсяЮЛ", Истина);
		
		ПараметрыВыгрузки.Вставить("НаимИмпорт",  "");
		ПараметрыВыгрузки.Вставить("ИННЮЛИмпорт", "");
		ПараметрыВыгрузки.Вставить("КППИмпорт",   "");
		
		ПараметрыВыгрузки.Вставить("ИННФЛИмпорт",      "");
		ПараметрыВыгрузки.Вставить("ФамилияФЛИмпорт",  "");
		ПараметрыВыгрузки.Вставить("ИмяФЛИмпорт",      "");
		ПараметрыВыгрузки.Вставить("ОтчествоФЛИмпорт", "");
		
	КонецЕсли;
	
	ПараметрыВыгрузки.Вставить("ПрПодп1",       ПрПодп1);
	ПараметрыВыгрузки.Вставить("ИННФЛПодп1",    ИННФЛПодп1);
	ПараметрыВыгрузки.Вставить("ДолжностьПодп1",ДолжностьПодп1);
	
	ПараметрыВыгрузки.Вставить("ФамилияПодп1",  ФамилияПодп1);
	ПараметрыВыгрузки.Вставить("ИмяПодп1",      ИмяПодп1);
	ПараметрыВыгрузки.Вставить("ОтчествоПодп1", ОтчествоПодп1);

	ПараметрыВыгрузки.Вставить("НаимДовПодп1",  НаимДовПодп1);
	ПараметрыВыгрузки.Вставить("НомерДовПодп1", НомерДовПодп1);
	ПараметрыВыгрузки.Вставить("ДатаДовПодп1",  ДатаДовПодп1);
	
	ПараметрыВыгрузки.Вставить("ПрПодп2",       ПрПодп2);
	ПараметрыВыгрузки.Вставить("ИННФЛПодп2",    ИННФЛПодп2);
	ПараметрыВыгрузки.Вставить("ДолжностьПодп2",ДолжностьПодп2);
	
	ПараметрыВыгрузки.Вставить("ФамилияПодп2",  ФамилияПодп2);
	ПараметрыВыгрузки.Вставить("ИмяПодп2",      ИмяПодп2);
	ПараметрыВыгрузки.Вставить("ОтчествоПодп2", ОтчествоПодп2);

	ПараметрыВыгрузки.Вставить("НаимДовПодп2",  НаимДовПодп2);
	ПараметрыВыгрузки.Вставить("НомерДовПодп2", НомерДовПодп2);
	ПараметрыВыгрузки.Вставить("ДатаДовПодп2",  ДатаДовПодп2);
	
	ПараметрыВыгрузки.Вставить("ОтправленПочтой", Ложь);
	ПараметрыВыгрузки.Вставить("ПрКурьер",      ПрКурьер);
	ПараметрыВыгрузки.Вставить("ИННФЛКурьер",   ИННФЛКурьер);
	                 
	ПараметрыВыгрузки.Вставить("ФамилияКурьер", ФамилияКурьер);
	ПараметрыВыгрузки.Вставить("ИмяКурьер",     ИмяКурьер);
	ПараметрыВыгрузки.Вставить("ОтчествоКурьер",ОтчествоКурьер);
	
	ПараметрыВыгрузки.Вставить("НаимДовКурьер",  НаимДовКурьер);
	ПараметрыВыгрузки.Вставить("НомерДовКурьер", НомерДовКурьер);
	ПараметрыВыгрузки.Вставить("ДатаДовКурьер",  ДатаДовКурьер);
		
	ПараметрыВыгрузки.Вставить("ФИОУпПред", СведенияОбОрганизации.ФИОУпПред);
	ПараметрыВыгрузки.Вставить("ИННУпПред", СведенияОбОрганизации.ИННУпПред);
	
	ПараметрыВыгрузки.Вставить("ФИОРук",    СведенияОбОрганизации.ФИОРук);
	
	Возврат ПараметрыВыгрузки;	
	
КонецФункции

&НаСервере
Функция ПолучитьСведенияОПредставителе(КодИФНС) Экспорт
	
	флПредставительЮрЛицо = Истина;
	НаименованиеОрганизацииПредставителя = "";
	ФИОПредставителя = "";
	ТипПредставителя = "1";
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РегистрацииВНалоговомОргане.Код,
	|	РегистрацииВНалоговомОргане.КПП,
	|	РегистрацииВНалоговомОргане.Представитель,
	|	РегистрацииВНалоговомОргане.УполномоченноеЛицоПредставителя
	|ИЗ
	|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|ГДЕ
	|	РегистрацииВНалоговомОргане.Код = &Код
	|	И РегистрацииВНалоговомОргане.Владелец = &Владелец");
	
	Запрос.УстановитьПараметр("Код", КодИФНС);
	Запрос.УстановитьПараметр("Владелец", Объект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Представитель) Тогда
		
		ТипПредставителя = "2";
		
		Если НЕ РегламентированнаяОтчетность.ПредставительЯвляетсяФизЛицом(Выборка.Представитель) Тогда
			
			флПредставительЮрЛицо = Истина;
			ФИОПредставителя = СокрЛП(Выборка.УполномоченноеЛицоПредставителя);
			ПредставительСсылка = Выборка.Представитель;
			
		Иначе
			
			флПредставительЮрЛицо = Ложь;
			ПредставительСсылка = Выборка.Представитель;
			ФИОПредставителя = СокрЛП(ПредставительСсылка);
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("ТипПредставителя, флПредставительЮрЛицо, ФИОПредставителя, ПредставительСсылка", 
							 ТипПредставителя, флПредставительЮрЛицо, ФИОПредставителя, ПредставительСсылка);
	
КонецФункции

