#Область ДОПП

&НаСервере
Функция ПроверкиФорматаДОППВыполнены()
	
	ПроверкиВыполнены = Истина;
	
	// Проверка уникальности регистрационных номеров
	Если СокрЛП(Объект.РегистрационныйЗнак) = СокрЛП(Объект.РегистрационныйЗнакПрицепа)
	 Или СокрЛП(Объект.РегистрационныйЗнак) = СокрЛП(Объект.РегистрационныйЗнакПрицепаДополнительный) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Регистрационный номер не уникален.'"), ,
			"РегистрационныйЗнак",
			"Объект");
		ПроверкиВыполнены = Ложь;
	КонецЕсли;
	
	Если СокрЛП(Объект.РегистрационныйЗнакПрицепа) = СокрЛП(Объект.РегистрационныйЗнакПрицепаДополнительный)
	   И ЗначениеЗаполнено(Объект.РегистрационныйЗнакПрицепа) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Регистрационный номер прицепа не уникален.'"), ,
			"РегистрационныйЗнакПрицепа",
			"Объект");
		ПроверкиВыполнены = Ложь;
		
	КонецЕсли;
	
	Если КонецДня(Объект.ДатаВвоза) < Объект.Дата Тогда
	
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата ввоза не может быть ранее даты регистрации ДОПП.'"), ,
			"ДатаВвоза",
			"Объект");
		ПроверкиВыполнены = Ложь;
	
	КонецЕсли;
	
	Возврат ПроверкиВыполнены;

КонецФункции

&НаСервере
Процедура ЗарегистрироватьАктуализироватьДОПП()
	
	Если Не ПроверкиФорматаДОППВыполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтатусДОППТекст) Тогда
		// ДОПП был зарегистрирован в СПОТ, актуализация не выполняется.
		// При необходимости исправления ранее зарегистрированного ДОПП необходимо формировать корректировочный ДОПП.
		Возврат;
	КонецЕсли;
	
	// ++ НЕ УТ
	СоздатьРеглОтчетДОПП();
	// -- НЕ УТ
	
КонецПроцедуры

// ++ НЕ УТ

&НаСервере
Процедура СоздатьРеглОтчетДОПП(Корректировочный = Ложь)
	
	Если Корректировочный = Ложь 
			И Объект.Комментарий = НСтр("ru = 'Создан обработчиком обновления'") Тогда
		Возврат;
	КонецЕсли;
	
	КонтейнерДОПП = Отчеты.РегламентированноеУведомлениеДокументОПредстоящейПоставке.КонтейнерДляЗаполнения(
		ИмяФормыДОПП(Объект.Дата));
	ПараметрыЗаполненияКонтейнера = Новый Структура;
	ПараметрыЗаполненияКонтейнера.Вставить("УчетныйДокументДОПП", Объект.Ссылка);
	ПараметрыЗаполненияКонтейнера.Вставить("СсылкаНаДОПП",        СсылкаНаДОПП);
	ПараметрыЗаполненияКонтейнера.Вставить("НомерРеглДОПП",       Объект.НомерДОПП);
	ПараметрыЗаполненияКонтейнера.Вставить("ДатаДокумента",       Объект.Дата);
	ПараметрыЗаполненияКонтейнера.Вставить("Корректировочный",    Корректировочный);
	ПараметрыЗаполненияКонтейнера.Вставить("ДатаДОПП",            Объект.ДатаДОПП);
	ПараметрыСоздания = ДанныеДляЗаполненияРеглОтчетаДОПП(КонтейнерДОПП, ПараметрыЗаполненияКонтейнера);
	СсылкаНаДОПП = Отчеты.РегламентированноеУведомлениеДокументОПредстоящейПоставке.НовыйДОПП(ПараметрыСоздания);
	ДатаРеглДОПП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаДОПП, "Дата");
	
	Если Корректировочный Тогда
		ЗаполнитьТекстПроДОПП();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФормыДОПП(Дата)
	
	Если Дата >= '20260101' Тогда
		Возврат "Форма2026_1";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеДляЗаполненияРеглОтчетаДОПП(КонтейнерДОПП, Параметры)
	
	ЗаполнитьКонтейнерДОПП(КонтейнерДОПП, Параметры);
	
	Если Параметры.Корректировочный Тогда
		// Необходимо создать новый регл. отчета с номером корректировки + 1, а не актуализировать предыдущий.
		СсылкаНаДОПП = Документы.УведомлениеОСпецрежимахНалогообложения.ПустаяСсылка();
	КонецЕсли;
	
	РеквизитыУчетногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.УчетныйДокументДОПП, "Организация, Дата");
	
	ПараметрыСоздания = Новый Структура();
	ПараметрыСоздания.Вставить("Организация",       РеквизитыУчетногоДокумента.Организация);
	ПараметрыСоздания.Вставить("РегистрацияВИФНС",  Справочники.Организации.РегистрацияВНалоговомОргане(РеквизитыУчетногоДокумента.Организация, РеквизитыУчетногоДокумента.Дата));
	ПараметрыСоздания.Вставить("Контейнер",         КонтейнерДОПП);
	ПараметрыСоздания.Вставить("ДокументОснование", Параметры.УчетныйДокументДОПП);
	ПараметрыСоздания.Вставить("ИмяФормы",          "Форма2026_1");
	ПараметрыСоздания.Вставить("Ссылка",            Параметры.СсылкаНаДОПП);
	ПараметрыСоздания.Вставить("Дата",              Параметры.ДатаДокумента);
	
	Возврат ПараметрыСоздания;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьКонтейнерДОПП(КонтейнерДОПП, Параметры)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Параметры.УчетныйДокументДОПП);
	СтавкаНДС10 = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(
				Перечисления.СтавкиНДС.НДС10, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	СтавкаНДС22 = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(
				Перечисления.СтавкиНДС.НДС22, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	Запрос.УстановитьПараметр("СтавкаНДС10", СтавкаНДС10);
	Запрос.УстановитьПараметр("СтавкаНДС22", СтавкаНДС22);
			
