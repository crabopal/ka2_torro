&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	СтруктураРеквизитовФормы = Новый Структура;
	СтруктураРеквизитовФормы.Вставить("мСохраненныйДок", СсылкаНаДОПП);
	СтруктураРеквизитовФормы.Вставить("Организация",     Объект.Организация);
	УстановитьФункциональныеОпцииФормы();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	ЗаполнитьКоллекциюСписковВыбора();
	
	НаименованиеВалютыДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Валюта, "Наименование");
	ВалютаРегламентированногоУчета = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	
	ОбновитьИтоги(ЭтотОбъект);
	
	УстановитьЗаголовокФормы(ЭтотОбъект);
	
	УправлениеФормой(ЭтотОбъект);
	
	РаботаСТабличнымиЧастями.ИнициализироватьКэшСтрок(Элементы.Товары);
		
	УстановитьУсловноеОформление();
	
	ТекстСостояние = ОбновитьТекстСостояние(Объект.Организация, Объект.НомерДОПП, Объект.СуммаОбеспечительногоПлатежа);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	Элементы.ДоговорКонтрагента.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
	Элементы.ТоварыСтоимостьВал.Заголовок = СтрШаблон(
		НСтр("ru='Фактурная стоимость (%1)'"),
		Форма.НаименованиеВалютыДокумента); 
		
	Элементы.РегистрационныйЗнакПрицепаДополнительный.Доступность = ЗначениеЗаполнено(Объект.РегистрационныйЗнакПрицепа);
	Элементы.ИнойОсобыйПризнакЗаявителя.Видимость = Объект.ОсобыйПризнакЗаявителя = "2";
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗаголовокФормы(Форма)
	
	Объект = Форма.Объект;
	ТекстЗаголовка = НСтр("ru = 'Документ о предстоящей поставке товаров'");
		
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстЗаголовка = ТекстЗаголовка + СтрШаблон(НСтр("ru=' %1 от %2'"), Объект.Номер, Объект.Дата);
	Иначе
		ТекстЗаголовка = ТекстЗаголовка + НСтр("ru = ' (создание)'");
	КонецЕсли;
	
	Форма.Заголовок = ТекстЗаголовка;

КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ПлательщикНДС = УчетнаяПолитика.ПлательщикНДС(Объект.Организация, Объект.Дата);
	
	ОбщегоНазначенияБПКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтотОбъект);
	ВедетсяУчетПрослеживаемыхТоваров =УчетПрослеживаемыхТоваровЛокализация.ИспользоватьУчетПрослеживаемыхИмпортныхТоваров(
														Объект.Дата);
	ИмпортПодакцизныхТоваров = УчетПодакцизныхТоваров.ИспользуетсяИмпортПодакцизныхТоваров(
					Объект.Организация, Объект.Дата);
		
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Признак прослеживаемости
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыПрослеживаемыйТовар");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ВедетсяУчетПрослеживаемыхТоваров", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// ТоварыСтавкаНДС
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыСтавкаНДС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Товары.ТоварыОсобыйПризнакДОПП", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтоги(Форма)
	
	Объект = Форма.Объект;
	Форма.ОбеспечительныйПлатеж = Окр(Объект.Товары.Итог("ОбеспечительныйПлатеж"));
	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьНалогиПоСтрокеТовары(СтрокаТаблицы)
	
	Если СтрокаТаблицы.ОсобыйПризнакДОПП = "0" Тогда
		ПриИзмененииНоменклатуры(СтрокаТаблицы);
		ДанныеОбъекта = Новый Структура(
			"ВалютаРегламентированногоУчета,Валюта,Дата,ОсобыйПризнакЗаявителя",
			ВалютаРегламентированногоУчета, Объект.Валюта, Объект.Дата, Объект.ОсобыйПризнакЗаявителя); 
		ДанныеСтрокиТаблицы = Новый Структура(
			"ФактурнаяСтоимость,НалоговаяБазаНДС,СтавкаНДС,СуммаНДС,ОбеспечительныйПлатеж,КатегорияПодакцизныхТоваров,КБК,МаркируемаяПродукция,
			|НалоговаяБазаАкцизы,ЕдиницаИзмеренияАкциза,ТвердаяСтавкаАкциза,АдвалорнаяСтавкаАкциза,СуммаАкциза,АналитикаАкциза,ОсобыйПризнакДОПП");
		ЗаполнитьЗначенияСвойств(ДанныеСтрокиТаблицы, СтрокаТаблицы);
		РасчитатьСуммыВТабличнойЧастиНаСервере(ДанныеСтрокиТаблицы, ДанныеОбъекта);
		ЗаполнитьАналитикуАкцизов(ДанныеСтрокиТаблицы);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСтрокиТаблицы);

	Иначе
		СтрокаТаблицы.СтавкаНДС                   = ПредопределенноеЗначение("Справочник.СтавкиНДС.ПустаяСсылка");
		СтрокаТаблицы.СуммаНДС                    = 0;
		СтрокаТаблицы.НалоговаяБазаНДС            = 0;
		СтрокаТаблицы.НалоговаяБазаАкцизы         = 0;
		СтрокаТаблицы.ТвердаяСтавкаАкциза         = 0;
		СтрокаТаблицы.АдвалорнаяСтавкаАкциза      = 0;
		СтрокаТаблицы.СуммаАкциза                 = 0;
		СтрокаТаблицы.ПодакцизныйТовар            = Ложь;
		СтрокаТаблицы.АналитикаАкциза             = НСтр("ru='Без акциза'");
		СтрокаТаблицы.ОбеспечительныйПлатеж       = 0;
		СтрокаТаблицы.КатегорияПодакцизныхТоваров = ПредопределенноеЗначение("Справочник.КатегорииПодакцизныхТоваров.ПустаяСсылка");
		СтрокаТаблицы.КБК                         = "";
		СтрокаТаблицы.МаркируемаяПродукция        = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьНалогиПоСтроке(ДанныеОбъекта, СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти.НалоговаяБазаНДС <> 0 Тогда
		СтрокаТабличнойЧасти.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
			СтрокаТабличнойЧасти.НалоговаяБазаНДС,
			УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС),
			Ложь);
	КонецЕсли;
	
	Если ДанныеОбъекта.ОсобыйПризнакЗаявителя = "0" Тогда
		Если СтрокаТабличнойЧасти.МаркируемаяПродукция Тогда
			СтрокаТабличнойЧасти.ОбеспечительныйПлатеж = СтрокаТабличнойЧасти.СуммаНДС;
		Иначе
			СтрокаТабличнойЧасти.ОбеспечительныйПлатеж = СтрокаТабличнойЧасти.СуммаНДС + СтрокаТабличнойЧасти.СуммаАкциза;
		КонецЕсли;
	Иначе
		СтрокаТабличнойЧасти.ОбеспечительныйПлатеж = 0;
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииНоменклатуры(СтрокаТабличнойЧасти)
	
	ОчиститьСообщения();
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	Если ИмпортПодакцизныхТоваров Тогда
		ПараметрыЗаполнения =
			ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияПризнакаПодакцизныйТовар(Объект);
		СтруктураДействий.Вставить("ЗаполнитьРеквизитыРасчетаАкциза", ПараметрыЗаполнения);
	КонецЕсли;
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
	СтруктураДействий.Вставить("ЗаполнитьНоменклатуруПартнераПоНоменклатуре", Объект.Партнер);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		
	ПараметрыЗаполненияСтавкиНДС = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияСтавкиНДС(Объект, Истина);
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ПараметрыЗаполненияСтавкиНДС);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	Если ИмпортПодакцизныхТоваров Тогда
		
		РассчитатьСуммуАкцизаВТабЧасти(ТекущаяСтрока);
		ДанныеСтрокиТаблицы = Новый Структура(
			"НалоговаяБазаАкцизы,ЕдиницаИзмеренияАкциза,ТвердаяСтавкаАкциза,АдвалорнаяСтавкаАкциза,СуммаАкциза,АналитикаАкциза");
		ЗаполнитьЗначенияСвойств(ДанныеСтрокиТаблицы, ТекущаяСтрока);
		ЗаполнитьАналитикуАкцизов(ДанныеСтрокиТаблицы);
		ТекущаяСтрока.АналитикаАкциза = ДанныеСтрокиТаблицы.АналитикаАкциза;
	
	КонецЕсли;
	
	ДанныеСтрокиТаблицы = Новый Структура(
		"ФактурнаяСтоимость,НалоговаяБазаНДС,СтавкаНДС,
		|СуммаНДС,СуммаАкциза,ОбеспечительныйПлатеж,МаркируемаяПродукция,
		|ТвердаяСтавкаАкциза,АдвалорнаяСтавкаАкциза,ОсобыйПризнакДОПП");
		
	ДанныеОбъекта = Новый Структура(
		"ВалютаРегламентированногоУчета,Дата,Валюта,ОсобыйПризнакЗаявителя",
		ВалютаРегламентированногоУчета, Объект.Дата, Объект.Валюта, Объект.ОсобыйПризнакЗаявителя);
		
	ЗаполнитьЗначенияСвойств(ДанныеСтрокиТаблицы, ТекущаяСтрока);
	
	НоменклатураПриИзмененииСервер(ДанныеСтрокиТаблицы, ДанныеОбъекта);
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеСтрокиТаблицы);
	
	ОбновитьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПартнерПриИзмененииСервер()
	
	ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(Объект.Партнер, Объект.Контрагент);
	КонтрагентПриИзмененииНаСервере();
	
	НоменклатураПартнеровСервер.ЗаполнитьНоменклатуруПартнераПоНоменклатуреПриИзмененииПартнера(Объект.Товары, Объект.Партнер);
	ОтветственныеЛицаСервер.ПриИзмененииСвязанныхРеквизитовДокумента(Объект);

