&НаСервереБезКонтекста
Функция ОбновитьТекстСостояние(Организация, НомерДОПП, СуммаОП)
	
	Если Не ЗначениеЗаполнено(НомерДОПП) Тогда
				ТекстРаспоряжения = НСтр("ru = 'Принять к учету / отменить'");
	Иначе
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("НомерДОПП", НомерДОПП);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.Текст = "ВЫБРАТЬ
		|	СУММА(ДокументыОПредстоящейПоставке.СуммаНалога) КАК СуммаНалога
		|ИЗ
		|	РегистрСведений.ДокументыОПредстоящейПоставке КАК ДокументыОПредстоящейПоставке
		|ГДЕ
		|	ДокументыОПредстоящейПоставке.НомерДОПП = &НомерДОПП
		|	И ДокументыОПредстоящейПоставке.Организация = &Организация
		|	И ДокументыОПредстоящейПоставке.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостояниеДОПП.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументыОПредстоящейПоставке.НомерДОПП";
		
		Результат = Запрос.Выполнить().Выбрать();
		
		СуммаПринято = 0;
		ЗаписьЕсть = Ложь;
		Если Результат.Следующий() Тогда
			СуммаПринято = Результат.СуммаНалога;
			ЗаписьЕсть = Истина;
		КонецЕсли;
		
		ОсталосьПринять = СуммаОП - СуммаПринято;
		
		Если СуммаПринято = 0 Или Не ЗаписьЕсть Тогда
			ТекстРаспоряжения = НСтр("ru = 'Принять к учету / отменить'");
		ИначеЕсли ОсталосьПринять <= 0 Тогда
			ТекстРаспоряжения = НСтр("ru = 'Принят к учету / отменен полностью'");
		Иначе
			ТекстРаспоряжения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru = 'Принято к учету / отменено %1; Осталось принять / отменить %2'"),
												СуммаПринято,
												ОсталосьПринять);
		КонецЕсли;
	КонецЕсли;
	
	НавигационнаяСсылкаСостояние = "СостояниеДОПП";
	ЦветТекста = ЦветаСтиля.ГиперссылкаЦвет;
	
	Возврат Новый ФорматированнаяСтрока(ТекстРаспоряжения, , ЦветТекста, , НавигационнаяСсылкаСостояние);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыДОПП(Объект)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерДОПП", Объект.НомерДОПП);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.Текст = "ВЫБРАТЬ
	|	ДокументыОПредстоящейПоставке.Организация КАК Организация,
	|	ДокументыОПредстоящейПоставке.ДатаСобытия КАК ДатаСобытия,
	|	ДокументыОПредстоящейПоставке.КБК КАК КБК,
	|	ДокументыОПредстоящейПоставке.НомерДОПП КАК НомерДОПП
	|ИЗ
	|	РегистрСведений.ДокументыОПредстоящейПоставке КАК ДокументыОПредстоящейПоставке
	|ГДЕ
	|	ДокументыОПредстоящейПоставке.НомерДОПП = &НомерДОПП
	|	И ДокументыОПредстоящейПоставке.Организация = &Организация";
	
	Результат = Запрос.Выполнить().Выгрузить();
	РеквизитыДОПП = Новый Структура();
	РеквизитыДОПП.Вставить("КоличествоЗаписей", Результат.Количество());
	РеквизитыДОПП.Вставить("Организация",       Объект.Организация);
	РеквизитыДОПП.Вставить("НомерДОПП",         Объект.НомерДОПП);
	РеквизитыДОПП.Вставить("Проведен",          Объект.Проведен);
	РеквизитыДОПП.Вставить("СуммаДокумента",    Объект.СуммаДокумента);
	Если Результат.Количество() = 1 Тогда
		ЗначениеКлюча = Новый Структура();
		ЗначениеКлюча.Вставить("Организация", Результат[0].Организация);
		ЗначениеКлюча.Вставить("ДатаСобытия", Результат[0].ДатаСобытия);
		ЗначениеКлюча.Вставить("КБК"        , Результат[0].КБК);
		ЗначениеКлюча.Вставить("НомерДОПП"  , Результат[0].НомерДОПП);
		КлючЗаписи = РегистрыСведений["ДокументыОПредстоящейПоставке"].СоздатьКлючЗаписи(ЗначениеКлюча);
		РеквизитыДОПП.Вставить("КлючЗаписи", КлючЗаписи);
	КонецЕсли;
	
	Возврат РеквизитыДОПП;
	
КонецФункции

