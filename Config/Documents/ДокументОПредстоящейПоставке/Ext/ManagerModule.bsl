Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументОПредстоящейПоставке.Ссылка КАК Ссылка,
	|	ДокументОПредстоящейПоставке.Дата КАК Дата,
	|	ДокументОПредстоящейПоставке.Организация КАК Организация,
	|	ДокументОПредстоящейПоставке.Контрагент КАК Контрагент,
	|	ДокументОПредстоящейПоставке.Валюта КАК Валюта,
	|	ДокументОПредстоящейПоставке.СуммаОбеспечительногоПлатежа КАК СуммаДокумента,
	|	ДокументОПредстоящейПоставке.СуммаОбеспечительногоПлатежа КАК СуммаОбеспечительногоПлатежа,
	|	ДокументОПредстоящейПоставке.Номер КАК Номер,
	|	ДокументОПредстоящейПоставке.Договор КАК Договор,
	|	ДокументОПредстоящейПоставке.Подразделение КАК Подразделение,
	|	ДокументОПредстоящейПоставке.Комментарий КАК Комментарий,
	|	ДокументОПредстоящейПоставке.ПометкаУдаления КАК ПометкаУдаления,
	|	ДокументОПредстоящейПоставке.Проведен КАК Проведен,
	|	ДокументОПредстоящейПоставке.Организация.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета,
	|	ДокументОПредстоящейПоставке.Организация.СтранаРегистрации КАК СтранаРегистрации,
	|	ДокументОПредстоящейПоставке.Автор КАК Автор,
	|	ДокументОПредстоящейПоставке.НомерДОПП КАК НомерДОПП,
	|	ДокументОПредстоящейПоставке.ДатаДОПП КАК ДатаДОПП,
	|	ДокументОПредстоящейПоставке.Партнер КАК Поставщик,
	|	ДокументОПредстоящейПоставке.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	Документ.ДокументОПредстоящейПоставке КАК ДокументОПредстоящейПоставке
	|ГДЕ
	|	ДокументОПредстоящейПоставке.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.СуммаНДС, 0)) КАК СуммаНДС,
	|	СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.ОбеспечительныйПлатеж, 0)) КАК ОбеспечительныйПлатеж
	|ИЗ
	|	Документ.ДокументОПредстоящейПоставке.Товары КАК ДокументОПредстоящейПоставкеТовары
	|ГДЕ
	|	ДокументОПредстоящейПоставкеТовары.Ссылка = &Ссылка
	|
	|ИМЕЮЩИЕ НЕ СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.СуммаНДС, 0)) ЕСТЬ NULL
	|	ИЛИ НЕ СУММА(ЕСТЬNULL(ДокументОПредстоящейПоставкеТовары.ОбеспечительныйПлатеж, 0)) ЕСТЬ NULL
	|";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	Реквизиты = РезультатыЗапроса[0].Выбрать();
	Реквизиты.Следующий();
	
	Для Каждого Колонка Из РезультатыЗапроса[0].Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, Реквизиты[Колонка.Имя]);
	КонецЦикла;
	
	Результат = РезультатыЗапроса[1].Выбрать();
	Если Результат.Следующий() Тогда
		СуммаОкругленияНДС = Результат.СуммаНДС - Окр(Результат.СуммаНДС);
		Запрос.УстановитьПараметр("СуммаОкругленияНДС", СуммаОкругленияНДС);
		
		Запрос.УстановитьПараметр("СуммаОкругленияАкциза", Результат.ОбеспечительныйПлатеж - Реквизиты.СуммаДокумента
															- СуммаОкругленияНДС);
	Иначе
		Запрос.УстановитьПараметр("СуммаОкругленияНДС",    0);
		Запрос.УстановитьПараметр("СуммаОкругленияАкциза", 0);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период",                  Реквизиты.Дата);
	Запрос.УстановитьПараметр("ИдентификаторМетаданных", ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяОбъекта()));
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",   Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС);
	
	Если ЗначениеЗаполнено(Реквизиты.Договор) Тогда
		ШаблонСтроки = НСтр("ru = 'По договору ""%1""'"); // @НСтр
		ИнформацияПоДоговору = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтроки, Реквизиты.Договор);
	КонецЕсли;
	Запрос.УстановитьПараметр("ИнформацияПоДоговору", ИнформацияПоДоговору);
	
	Запрос.УстановитьПараметр("ИспользоватьПодакцизныеТовары",
		УчетПодакцизныхТоваров.ИспользуетсяИмпортПодакцизныхТоваров(Реквизиты.Организация, Реквизиты.Дата));
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьМногострановойУчет") Тогда
		Запрос.УстановитьПараметр("СтранаРегистрации", ЗначениеНастроекКлиентСерверПовтИсп.ОсновнаяСтрана());
	КонецЕсли;
	
	ВалютаРеглУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Реквизиты.Организация);
	КоэффициентыПересчета = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентыПересчетаВалюты(
		ВалютаРеглУчета, ВалютаРеглУчета, Реквизиты.Дата, Реквизиты.Организация);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуУпр", КоэффициентыПересчета.КоэффициентПересчетаВВалютуУпр);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицаПрочиеАктивыПассивы(ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ПрочиеАктивыПассивы";
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВТРасшифровкаНалогов", ТекстыЗапроса) Тогда
		ДобавитьТекстЗапросаВТРасшифровкаНалогов(ТекстыЗапроса);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)              КАК ВидДвижения,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.НДС_ВвозимыеТовары)    КАК Аналитика,
	|	СУММА(Налоги.СуммаНДСУУ)                               КАК Сумма
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|
	|ГДЕ
	|	&СуммаДокумента <> 0
	|	И Налоги.СуммаНДС <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)              КАК ВидДвижения,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.Акцизы)      КАК Аналитика,
	|	СУММА(Налоги.СуммаАкцизаУУ)                         КАК Сумма
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	&СуммаДокумента <> 0
	|	И Налоги.СуммаАкциза <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)              КАК ВидДвижения,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)         КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги)     КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.ОбеспечительныйПлатежСПОТ) КАК Аналитика,
	|	СУММА(Налоги.СуммаНДСУУ + Налоги.СуммаАкциза)       КАК Сумма
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|
	|ГДЕ
	|	&СуммаДокумента <> 0
	|	И Налоги.СуммаАкциза + Налоги.СуммаНДС <> 0";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаДвиженияПоПрочимАктивамПассивам(ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ДвиженияПоПрочимАктивамПассивам";
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВТРасшифровкаНалогов", ТекстыЗапроса) Тогда
		ДобавитьТекстЗапросаВТРасшифровкаНалогов(ТекстыЗапроса);
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПрочихАктивовПассивов.Дебет) КАК ДебетКредит,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.НДС_ВвозимыеТовары)    КАК Аналитика,
	|	Налоги.СуммаНДС                                     КАК СуммаРегл,
	|	Налоги.СуммаНДСУУ                                   КАК СуммаБезНДС,
	|	Налоги.СуммаНДСУУ                                   КАК СуммаСНДС,
	|	Налоги.СуммаНДСУУ                                   КАК СуммаУпр,
	|	Налоги.ИдентификаторСтроки                          КАК ИдентификаторФинЗаписи,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ЗакупкаВСтранахЕАЭС) КАК НастройкаХозяйственнойОперации
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	Налоги.СуммаНДС <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПрочихАктивовПассивов.Дебет) КАК ДебетКредит,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)     КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги) КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.Акцизы)      КАК Аналитика,
	|	Налоги.СуммаАкциза                                  КАК СуммаРегл,
	|	Налоги.СуммаАкцизаУУ                                КАК СуммаБезНДС,
	|	Налоги.СуммаАкцизаУУ                                КАК СуммаСНДС,
	|	Налоги.СуммаАкцизаУУ                                КАК СуммаУпр,
	|	Налоги.ИдентификаторСтроки                          КАК ИдентификаторФинЗаписи,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ЗакупкаВСтранахЕАЭС) КАК НастройкаХозяйственнойОперации
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	Налоги.СуммаАкциза <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период                                             КАК Период,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПрочихАктивовПассивов.Кредит) КАК ДебетКредит,
	|	&Организация                                        КАК Организация,
	|	НЕОПРЕДЕЛЕНО                                        КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)         КАК НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.Налоги)     КАК Статья,
	|	ЗНАЧЕНИЕ(Справочник.ВидыНалоговВзносов.ОбеспечительныйПлатежСПОТ) КАК Аналитика,
	|	Налоги.СуммаАкциза + Налоги.СуммаНДС                КАК СуммаРегл,
	|	Налоги.СуммаАкцизаУУ + Налоги.СуммаНДСУУ            КАК СуммаБезНДС,
	|	Налоги.СуммаАкцизаУУ + Налоги.СуммаНДСУУ            КАК СуммаСНДС,
	|	Налоги.СуммаАкцизаУУ + Налоги.СуммаНДСУУ            КАК СуммаУпр,
	|	Налоги.ИдентификаторСтроки                          КАК ИдентификаторФинЗаписи,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ЗакупкаВСтранахЕАЭС) КАК НастройкаХозяйственнойОперации
	|ИЗ
	|	ВТРасшифровкаНалогов КАК Налоги
	|ГДЕ
	|	Налоги.СуммаАкциза + Налоги.СуммаНДС <> 0";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ДобавитьТекстЗапросаВТРасшифровкаНалогов(ТекстыЗапроса)
	
	ИмяТаблицы = "ВТРасшифровкаНалогов";
	Если ПроведениеДокументов.ЕстьТаблицаЗапроса(ИмяТаблицы, ТекстыЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Строки.СуммаНДС КАК СуммаНДС,
	|	Строки.КБК КАК КБК,
	|	ВЫБОР
	|		КОГДА Строки.МаркируемаяПродукция
	|		ТОГДА 0
	|		ИНАЧЕ Строки.СуммаАкциза
	|	КОНЕЦ КАК СуммаАкциза,
	|	Строки.НомерСтроки КАК НомерСтроки,
	|	Строки.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТРасшифровкаНалоговПредварительная
	|ИЗ
	|	Документ.ДокументОПредстоящейПоставке.Товары КАК Строки
	|
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|	И &СуммаДокумента <> 0
	|;
	|////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Строки.СуммаНДС) КАК СуммаНДС,
	|	МАКСИМУМ(Строки.СуммаАкциза) КАК СуммаАкциза
	|ПОМЕСТИТЬ ВТСтроки
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК Строки
	|;
	|////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК ЭтоНДС,
	|	МАКСИМУМ(РасшифровкаНалогов.НомерСтроки) КАК НомерСтроки,
	|	&СуммаОкругленияНДС КАК ОкруглениеНалога
	|ПОМЕСТИТЬ ВТНомераСтрок
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК РасшифровкаНалогов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСтроки КАК Строки
	|		ПО РасшифровкаНалогов.СуммаНДС = Строки.СуммаНДС
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|	
	|ВЫБРАТЬ
	|	ЛОЖЬ КАК ЭтоНДС,
	|	МАКСИМУМ(РасшифровкаНалогов.НомерСтроки) КАК НомерСтроки,
	|	&СуммаОкругленияАкциза КАК ОкруглениеНалога
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК РасшифровкаНалогов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСтроки КАК Строки
	|		ПО РасшифровкаНалогов.СуммаАкциза = Строки.СуммаАкциза
	|;
	|////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасшифровкаНалогов.СуммаНДС - ЕстьNull(СтрокиНДС.ОкруглениеНалога, 0) КАК СуммаНДС,
	|	ВЫРАЗИТЬ((РасшифровкаНалогов.СуммаНДС - ЕстьNull(СтрокиНДС.ОкруглениеНалога, 0))
	|				* &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(31,2)) КАК СуммаНДСУУ,
	|	РасшифровкаНалогов.СуммаАкциза - ЕстьNull(СтрокиАкциз.ОкруглениеНалога, 0) КАК СуммаАкциза,
	|	ВЫРАЗИТЬ((РасшифровкаНалогов.СуммаАкциза  - ЕстьNull(СтрокиАкциз.ОкруглениеНалога, 0))
	|				* &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(31,2)) КАК СуммаАкцизаУУ,
	|	РасшифровкаНалогов.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТРасшифровкаНалогов
	|ИЗ
	|	ВТРасшифровкаНалоговПредварительная КАК РасшифровкаНалогов
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТНомераСтрок КАК СтрокиНДС
	|		ПО РасшифровкаНалогов.НомерСтроки = СтрокиНДС.НомерСтроки
	|			И СтрокиНДС.ЭтоНДС
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТНомераСтрок КАК СтрокиАкциз
	|		ПО РасшифровкаНалогов.НомерСтроки = СтрокиАкциз.НомерСтроки
	|			И НЕ СтрокиАкциз.ЭтоНДС
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяТаблицы);
	
КонецПроцедуры

Функция ТекстЗапросаТаблицаРеестрДокументов(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "РеестрДокументов";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Ссылка                  КАК Ссылка,
	|	&Период                  КАК ДатаДокументаИБ,
	|	&Номер                   КАК НомерДокументаИБ,
	|	&ИдентификаторМетаданных КАК ТипСсылки,
	|	&Организация             КАК Организация,
	|	&ХозяйственнаяОперация   КАК ХозяйственнаяОперация,
	|	НЕОПРЕДЕЛЕНО             КАК Партнер,
	|	&Контрагент              КАК Контрагент,
	|	&Договор                 КАК Договор,
	|	&НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	НЕОПРЕДЕЛЕНО             КАК МестоХранения,
	|	&Подразделение           КАК Подразделение,
	|	&Автор                   КАК Ответственный,
	|	&Комментарий             КАК Комментарий,
	|	&Валюта                  КАК Валюта,
	|	&СуммаОбеспечительногоПлатежа КАК Сумма,
	
	//++ НЕ УТ
	|	 НЕОПРЕДЕЛЕНО            КАК Статус,
	//-- НЕ УТ
	
	|	&Проведен                КАК Проведен,
	|	&ПометкаУдаления         КАК ПометкаУдаления,
	|	ЛОЖЬ                     КАК ДополнительнаяЗапись,
	|	&ИнформацияПоДоговору    КАК Дополнительно,
	|	&ДатаДОПП                КАК ДатаПервичногоДокумента,
	|	&НомерДОПП               КАК НомерПервичногоДокумента,
	|	&Период                  КАК ДатаОтраженияВУчете,
	|	НЕОПРЕДЕЛЕНО             КАК Приоритет
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает результат адаптации текста запроса движений по регистру.
// 
// Параметры:
//  ИмяРегистра - Строка - имя регистра в конфигурации.
// 
// Возвращаемое значение:
//  см. ОбновлениеИнформационнойБазыУТ.РезультатАдаптацииЗапроса
//
Функция АдаптированныйТекстЗапросаДвиженийПоРегистру(ИмяРегистра) Экспорт
	
	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый СписокЗначений;
	
	ПолноеИмяДокумента           = "Документ.ДокументОПредстоящейПоставке";
	СинонимТаблицыДокумента      = "";
	ВЗапросеЕстьИсточник         = Истина;
	ТекстыЗапросаВременныхТаблиц = Новый Соответствие();
	
	ПереопределениеРасчетаПараметров = Новый Структура;
	ПереопределениеРасчетаПараметров.Вставить("НомерНаПечать",        """""");
	ПереопределениеРасчетаПараметров.Вставить("ИнформацияПоДоговору", """""");
	
	ЗначенияПараметров = Новый Структура;
	ЗначенияПараметров.Вставить("ИдентификаторМетаданных",
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяДокумента));
	ЗначенияПараметров.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС);
	
	Если ИмяРегистра = "РеестрДокументов" Тогда
		
		ТекстЗапроса = ТекстЗапросаТаблицаРеестрДокументов(Запрос, ТекстыЗапроса, ИмяРегистра);
		СинонимТаблицыДокумента = "";
		ВЗапросеЕстьИсточник = Ложь;
		
	Иначе
		ТекстИсключения = НСтр("ru = 'В документе %ПолноеИмяДокумента% не реализована адаптация текста запроса формирования движений по регистру %ИмяРегистра%.'");
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ПолноеИмяДокумента%", 	ПолноеИмяДокумента);
		ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИмяРегистра%", 		ИмяРегистра);
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если ИмяРегистра = "РеестрДокументов" Тогда
		
		ТекстЗапроса = ОбновлениеИнформационнойБазыУТ.АдаптироватьЗапросПроведенияПоНезависимомуРегистру(
			ТекстЗапроса,
			ПолноеИмяДокумента,
			СинонимТаблицыДокумента,
			ВЗапросеЕстьИсточник,
			ПереопределениеРасчетаПараметров,
			ТекстыЗапросаВременныхТаблиц);
		
	Иначе
		
		ТекстЗапроса = ОбновлениеИнформационнойБазыУТ.АдаптироватьЗапросМеханизмаПроведения(
			ТекстЗапроса,
			ПолноеИмяДокумента,
			СинонимТаблицыДокумента,
			ПереопределениеРасчетаПараметров,
			ТекстыЗапросаВременныхТаблиц);
		
	КонецЕсли;
	
	Результат = ОбновлениеИнформационнойБазыУТ.РезультатАдаптацииЗапроса();
	Результат.ЗначенияПараметров = ЗначенияПараметров;
	Результат.ТекстЗапроса = ТекстЗапроса;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

//++ НЕ УТ

#Область ОбновлениеИнформационнойБазы

// см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "Документы.ДокументОПредстоящейПоставке.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.27.70";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("de97bc49-9d7a-47a9-a0ec-a9afbf8c584a");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "Документы.ДокументОПредстоящейПоставке.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Некритичный;
	Обработчик.Комментарий = НСтр("ru = 'Создание документов о предстоящей поставке'");
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.УведомлениеОСпецрежимахНалогообложения.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.Документы.ДокументОПредстоящейПоставке.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ","); 
	
КонецПроцедуры

// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = Документы.УведомлениеОСпецрежимахНалогообложения.ПустаяСсылка().Метаданные().ПолноеИмя();
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Дата УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Дата УБЫВ");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УведомлениеОСпецрежимахНалогообложения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УведомлениеОСпецрежимахНалогообложения КАК УведомлениеОСпецрежимахНалогообложения
	|ГДЕ
	|	НЕ УведомлениеОСпецрежимахНалогообложения.ПометкаУдаления
	|	И УведомлениеОСпецрежимахНалогообложения.ВидУведомления = ЗНАЧЕНИЕ(Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.ДокументОПредстоящейПоставке)
	|	И УведомлениеОСпецрежимахНалогообложения.Основание <> НЕОПРЕДЕЛЕНО
	|	И ТИПЗНАЧЕНИЯ(УведомлениеОСпецрежимахНалогообложения.Основание) В (&ТипыОснований)";
	
	ТипыОснований = Новый СписокЗначений();
	
	
	ТипыОснований.Добавить(Тип("ДокументСсылка.ЗаказПереработчику2_5"));
	ТипыОснований.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	ТипыОснований.Добавить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
	ТипыОснований.Добавить(Тип("ДокументСсылка.ЗаключениеДоговораАренды"));
	ТипыОснований.Добавить(Тип("ДокументСсылка.ЗаявкаНаВозвратТоваровОтКлиента"));
	Запрос.УстановитьПараметр("ТипыОснований", ТипыОснований);
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

// Обработчик обновления
// 
// Параметры:
// 	Параметры - См. ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляМногопоточнойОбработки 
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяОбъекта = Документы.УведомлениеОСпецрежимахНалогообложения.ПустаяСсылка().Метаданные().ПолноеИмя();
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		
		Параметры.ОбработкаЗавершена =
			ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
		
	КонецЕсли;
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	ИсключенияПриОбновлении = Новый Массив;
	
	СписокОписаний = Новый Массив;
	СписокОписаний.Добавить(НСтр("ru = 'Обновление документов ""Документ о предстоящей поставке (ДОПП)""'"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбновляемыеДанные", ОбновляемыеДанные);
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбновляемыеДанные.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ОбновляемыеДанные
	|ИЗ
	|	&ОбновляемыеДанные КАК ОбновляемыеДанные
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбновляемыеДанные.Ссылка     КАК Ссылка,
	|	МАКСИМУМ(ДокументыРеализацииПолномочийНалоговыхОрганов.НомерУведомления) КАК НомерДОПП,
	|	МАКСИМУМ(ДокументыРеализацииПолномочийНалоговыхОрганов.ДатаУведомления)  КАК ДатаДОПП
	|ПОМЕСТИТЬ ДанныеСНомеромДОПП
	|ИЗ
	|	ОбновляемыеДанные КАК ОбновляемыеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДокументыРеализацииПолномочийНалоговыхОрганов КАК ДокументыРеализацииПолномочийНалоговыхОрганов
	|		ПО ОбновляемыеДанные.Ссылка = ДокументыРеализацииПолномочийНалоговыхОрганов.ДокументОснование
	|			И ДокументыРеализацииПолномочийНалоговыхОрганов.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхДокументов.КвитанцияОПрисвоенииСтатусаДОПП)
	|СГРУППИРОВАТЬ ПО
	|	ОбновляемыеДанные.Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбновляемыеДанные.Ссылка     КАК Ссылка,
	|	ТаблицаОснований.Дата        КАК Дата,
	|	ТаблицаОснований.Организация КАК Организация,
	|	ТаблицаОснований.Основание   КАК Основание,
	|	РеестрДокументов.Партнер     КАК Партнер,
	|	РеестрДокументов.Договор     КАК Договор,
	|	РеестрДокументов.Валюта      КАК Валюта,
	|	ДанныеСНомеромДОПП.НомерДОПП КАК НомерДОПП,
	|	ДанныеСНомеромДОПП.ДатаДОПП  КАК ДатаДОПП,
	|	КлючиРеестраДокументов.Ключ  КАК Контрагент,
	|	ТаблицаОснований.ДанныеУведомления КАК ДанныеУведомления
	|ИЗ
	|	ОбновляемыеДанные КАК ОбновляемыеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОСпецрежимахНалогообложения КАК ТаблицаОснований
	|		ПО ТаблицаОснований.Ссылка = ОбновляемыеДанные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|		ПО ТаблицаОснований.Основание = РеестрДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиРеестраДокументов КАК КлючиРеестраДокументов
	|		ПО РеестрДокументов.Контрагент = КлючиРеестраДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеСНомеромДОПП КАК ДанныеСНомеромДОПП
	|		ПО ОбновляемыеДанные.Ссылка = ДанныеСНомеромДОПП.Ссылка
	|";
	
	ВыборкаДокументов = Запрос.Выполнить().Выбрать();
	КБКПоКатегориямТаблица = РегистрыСведений.ДокументыОПредстоящейПоставке.ПолучитьКБКПоКатегориямТоваров();
	Штуки = Константы.ЕдиницаИзмеренияКоличестваШтук.Получить();
	СтавкаНДС10 = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(
				Перечисления.СтавкиНДС.НДС10, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	СтавкаНДС22 = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(
				Перечисления.СтавкиНДС.НДС22, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	СтавкиНДС = Новый Структура();
	СтавкиНДС.Вставить("СтавкаНДС10", СтавкаНДС10);
	СтавкиНДС.Вставить("СтавкаНДС22", СтавкаНДС22);
				
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КатегорииПодакцизныхТоваров.Код КАК КодАкциза,
	|	УпаковкиЕдиницыИзмерения.Код КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.КатегорииПодакцизныхТоваров КАК КатегорииПодакцизныхТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО КатегорииПодакцизныхТоваров.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.Ссылка";
	
	Акцизы = Запрос.Выполнить().Выгрузить();

	Пока ВыборкаДокументов.Следующий() Цикл
				
		ПричинаИсключения = 0;
		Рекомендация = "";
		
		НачатьТранзакцию();
		
		Попытка
			
			ПричинаИсключения = 1; // Блокировка
		
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ВыборкаДокументов.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			ПричинаИсключения = 2; // ПлохиеДанные
			Рекомендация = НСтр("ru = 'Создайте ДОПП вручную'");
			
			ДокументОбъект = ВыборкаДокументов.Ссылка.ПолучитьОбъект();
			
			Если ДокументОбъект = Неопределено Тогда
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаДокументов.Ссылка);
			Иначе
				ДОПП = Документы.ДокументОПредстоящейПоставке.СоздатьДокумент();
				ДОПП.ОбменДанными.Загрузка = Истина;
				
				ДОПП.ДокументОснование = ВыборкаДокументов.Основание;
				ЗаполнитьЗначенияСвойств(ДОПП, ВыборкаДокументов);
				
				ДозаполнитьДОПП(ДОПП, ВыборкаДокументов.ДанныеУведомления, КБКПоКатегориямТаблица, Штуки, Акцизы, СтавкиНДС);
				
				ДОПП.Комментарий = НСтр("ru = 'Создан обработчиком обновления'");
				ДОПП.УстановитьНовыйНомер();
				ДОПП.Записать(РежимЗаписиДокумента.Запись);
				
				ДокументОбъект.Основание = ДОПП.Ссылка;
			КонецЕсли;
			
			ПричинаИсключения = 3; // Запись
				
			Если ДокументОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаДокументов.Ссылка);
			КонецЕсли;
				
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), ВыборкаДокументов.СчетФактура);
			
			Если ПричинаИсключения = 2 Тогда
				
				ОписаниеПроблемы = ОбновлениеИнформационнойБазыУТ.ПроблемаСДанными(
					ВыборкаДокументов.Ссылка, Рекомендация, ИнформацияОбОшибке());
				ИсключенияПриОбновлении.Добавить(ОписаниеПроблемы);
				
			ИначеЕсли ПричинаИсключения = 3 Тогда
				
				ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(
					ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
				ВызватьИсключение СтрСоединить(СписокОписаний, Символы.ПС);
				
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена =
		ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
	ОбновлениеИнформационнойБазыУТ.ЗаписатьПлохиеДанные(ИсключенияПриОбновлении, ОбъектовОбработано, Параметры);
	
КонецПроцедуры

Процедура ДозаполнитьДОПП(ДОПП, ДанныеУведомления, КБКПоКатегориямТаблица, Штуки, Акцизы, СтавкиНДС)
	
	СтруктураДОПП = ДанныеУведомления.Получить();
	Титул = СтруктураДОПП.ДанныеУведомления.Титульная;
	ДОПП.ОсобыйПризнакЗаявителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "ОсПрЗаяв", "0");
	ДОПП.ИнойОсобыйПризнакЗаявителя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "ИнОсПрЗаяв", "0");
	ДОПП.ДатаВвоза = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "ДатаВвоз", ТекущаяДатаСеанса());
	ДОПП.СуммаОбеспечительногоПлатежа = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "СумОбПлат", 0);
	Если Не ЗначениеЗаполнено(ДОПП.НомерДОПП) Тогда
		ДОПП.НомерДОПП = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "НомерДОПП", "");
		ДОПП.ДатаДОПП = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "ДатаРегистр", Дата(1,1,1));
	КонецЕсли;
	ОКСМПерев = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "КодСтраныРегистрацииПеревозчика", "");
	РегНомПерев = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "КодСтраныРегистрацииПеревозчика", "");
	
	Если ОКСМПерев = 643 Тогда
		ДОПП.Перевозчик = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", РегНомПерев);
	Иначе
		ДОПП.Перевозчик = Справочники.Контрагенты.НайтиПоРеквизиту("РегистрационныйНомер", РегНомПерев);
	КонецЕсли;
	
	ДОПП.РегистрационныйЗнак = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "РегЗнакТС", "");
	ДОПП.РегистрационныйЗнакПрицепа = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "НомерПрицеп1", "");
	ДОПП.РегистрационныйЗнакПрицепаДополнительный = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Титул, "НомерПрицеп2", "");

	СтраницыТовары = СтруктураДОПП.ДанныеМногостраничныхРазделов.ТоварДоговор;
	ПризнакДОПП = "0";
	Для Каждого СтрокаТовары Из СтраницыТовары Цикл
		СтрокаТоварыДОПП = ДОПП.Товары.Добавить();
		РеквизитыСтрТовары = СтрокаТовары.Значение;
		СтрокаТоварыДОПП.Содержание = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "НаимТов", 0);
		СтрокаТоварыДОПП.Количество = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "КолТов", 0);
		Если СтрокаТоварыДОПП.Количество <> 0 Тогда
			
		Иначе
			СтрокаТоварыДОПП.Количество = 1;
		КонецЕсли;
		СтрокаТоварыДОПП.КоличествоУпаковок = СтрокаТоварыДОПП.Количество;
		СтрокаТоварыДОПП.ФактурнаяСтоимость = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "СтоимТов", 0);
		СтрокаТоварыДОПП.Цена = СтрокаТоварыДОПП.ФактурнаяСтоимость / СтрокаТоварыДОПП.Количество;
		КодАкциза = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "КодПТ", "");
		СтрокаТоварыДОПП.КатегорияПодакцизныхТоваров = Справочники.КатегорииПодакцизныхТоваров.НайтиПоКоду(КодАкциза);
		СтрокаКБК = КБКПоКатегориямТаблица.Найти(КодАкциза, "КодПодакцизногоТовара");
		Если СтрокаКБК <> неопределено Тогда
			СтрокаТоварыДОПП.КБК = СтрокаКБК.Код;
		КонецЕсли;
		СтрокаТоварыДОПП.МаркируемаяПродукция = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "МаркируемыйТовар", Ложь);
		ПодакцизныйТовар = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "ПрПТ", Ложь);
		Если ПодакцизныйТовар = "1" Тогда
			СтрокаТоварыДОПП.ПодакцизныйТовар = Истина;
		КонецЕсли;
		
		СумАкцизАдв = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "СумАкцизАдв", 0);
		Если СумАкцизАдв = Неопределено Тогда
			СумАкцизАдв = 0;
		КонецЕсли;
		
		СумАкцизТв = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "СумАкцизТв", 0);
		Если СумАкцизТв = Неопределено Тогда
			СумАкцизТв = 0;
		КонецЕсли;
		
		СтрокаТоварыДОПП.СуммаНДС            = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "СумНДС", 0);
		СтрокаТоварыДОПП.НалоговаяБазаНДС    = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "НДСБаза", 0);
		СтавкаНДС = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "НДССт", 0);
		
		Если ЗначениеЗаполнено(СтавкаНДС) Тогда
			Если СтавкаНДС = "10" Тогда
				СтрокаТоварыДОПП.СтавкаНДС = СтавкиНДС.СтавкаНДС10;
			ИначеЕсли СтавкаНДС = "22" Тогда
				СтрокаТоварыДОПП.СтавкаНДС = СтавкиНДС.СтавкаНДС22;
			КонецЕсли;
		КонецЕсли;
		
		АкцизТвБаза = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "АкцизТвБаза", 0);
		Если АкцизТвБаза = Неопределено Тогда
			АкцизТвБаза = 0;
		КонецЕсли;
		
		АкцизАдвБаза = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "АкцизАдвБаза", 0);
		Если АкцизАдвБаза = Неопределено Тогда
			АкцизАдвБаза = 0;
		КонецЕсли;
		
		СтрокаТоварыДОПП.НалоговаяБазаАкцизы = АкцизАдвБаза + АкцизТвБаза;
		
		СтрокаТоварыДОПП.АдвалорнаяСтавкаАкциза = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "АкцАдвСт", 0);
		СтрокаТоварыДОПП.ТвердаяСтавкаАкциза    = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "АкцТвСт", 0);
		НомерТД = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "НомерДекл", "");
		СтрокаТоварыДОПП.НомерТД = Справочники.НомераГТД.НайтиПоКоду(НомерТД);
		КодТНВЭД = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "ТНВЭД", "");
		СтрокаТоварыДОПП.КодТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(КодТНВЭД);
		ОКЕИ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "ОКЕИ", 0);
		Если ЗначениеЗаполнено(ОКЕИ) Тогда
			Если ОКЕИ = "796" Тогда
				СтрокаТоварыДОПП.Упаковка = Штуки;
			Иначе
				СтрокаТоварыДОПП.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(ОКЕИ,,,Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
			КонецЕсли;
		Иначе
			СтрокаТоварыДОПП.Упаковка = Штуки;
		КонецЕсли;
		ОКСМПроисх = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "ОКСМПроисх", "");
		СтрокаТоварыДОПП.СтранаПроисхождения = Справочники.СтраныМира.НайтиПоКоду(ОКСМПроисх);
		СтрокаТоварыДОПП.ОсобыйПризнакДОПП = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыСтрТовары, "ОсобПризн", "0");
		ПризнакДОПП = СтрокаТоварыДОПП.ОсобыйПризнакДОПП;
		Если СтрокаТоварыДОПП.ОсобыйПризнакДОПП = "0" Тогда
			СтрокаТоварыДОПП.ОбеспечительныйПлатеж = СтрокаТоварыДОПП.СуммаНДС
											+?(СтрокаТоварыДОПП.МаркируемаяПродукция, 0, СтрокаТоварыДОПП.СуммаАкциза);
		КонецЕсли;
										
		Если ЗначениеЗаполнено(СтрокаТоварыДОПП.КатегорияПодакцизныхТоваров) Тогда
			
			НайденнаяСтрока = Акцизы.Найти(КодАкциза, "КодАкциза");
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаТоварыДОПП.ЕдиницаИзмеренияАкциза = НайденнаяСтрока.ЕдиницаИзмерения;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
	ДОПП.ОсобыйПризнакДОПП = ПризнакДОПП;
	
КонецПроцедуры

