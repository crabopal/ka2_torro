#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Устанавливает статус для объекта документа
//
// Параметры:
//  НовыйСтатус - Строка - Имя статуса, который будет установлен у заказо.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
// 	Булево - Истина, в случае успешной установки нового статуса.
Функция УстановитьСтатус(НовыйСтатус, ДополнительныеПараметры) Экспорт
	
	// +пит
	ЗначениеНовогоСтатуса = Перечисления.питСтатусыЗаказовНаПеремещениеВНоменклатуруПроизводства[НовыйСтатус];
	// -пит
	
	// +пит
	// Если ДополнительныеПараметры <> Неопределено Тогда
	//	
	// 	ЗаказыСервер.СкорректироватьСтрокиЗаказа(ЭтотОбъект, ДополнительныеПараметры);
	//	
	// КонецЕсли;
	// -пит
	
	Статус = ЗначениеНовогоСтатуса;
	
	// +пит
	// ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.ЗаказНаПеремещение);
	// НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ЭтотОбъект, ПараметрыУказанияСерий);
	// -пит
	
	Возврат ПроверитьЗаполнение();
	
КонецФункции

#КонецОбласти


#Область ОбработчикиСобытий

// Процедура - Обработка заполнения.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  ТекстЗаполнения - Произвольный - Текст заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
		Если ДанныеЗаполнения.Свойство("Товары") Тогда
			ЗаполнитьПоТаблицеТовары(ДанныеЗаполнения.Товары);
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("ЭтоОбеспечениеПотребностей") Тогда
			ПодобратьНоменклатуруСкладаДляНоменклатурыПроизводства();
		КонецЕсли;
		
	КонецЕсли;
	
	ИнициализироватьДокумент(ДанныеЗаполнения);
КонецПроцедуры

// Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	// +Характеристики
	ПараметрыПроверкиХарактеристик = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "Товары";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "ТоварыСкладские";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	// -Характеристики
	
	ПроверятьЗаполненияСкладскихТоваров = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питЗаполнятьНоменклатуруСкладаВЗаказеНаПеремещениеВНоменклатуруПроизводства");
	Если ПроверятьЗаполненияСкладскихТоваров Тогда
		ПроверяемыеРеквизиты.Добавить("ТоварыСкладские");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

// Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ШаблонНазначения = Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства.ШаблонНазначения(ЭтотОбъект);
	ПерегенерацияНазначения = Справочники.Назначения.ПроверитьЗаполнитьПередЗаписью(Назначение, ШаблонНазначения,
		ЭтотОбъект, "", Отказ);
	
	Если НЕ ЗначениеЗаполнено(ХозяйственнаяОперация) Тогда
		ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.ЗаказНаПеремещениеВНоменклатуруПроизводства;
	КонецЕсли;
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
КонецПроцедуры

// Процедура - При записи.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеДокументов.ПриЗаписиДокумента(ЭтотОбъект, Отказ);
	
	ШаблонНазначения = Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства.ШаблонНазначения(ЭтотОбъект);
	Справочники.Назначения.ПриЗаписиДокумента(Назначение, ШаблонНазначения, ЭтотОбъект, СкладПолучатель, ПеремещениеПодДеятельность);
КонецПроцедуры

// Процедура - Обработка проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Если обмен данными, то ничего не делаем.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// +%ИзЕРП% Набор типовых процедур для обработки проведения документа.
	
	ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ);
	
	// -%ИзЕРП%
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Процедура - При копировании.
//
// Параметры:
//  ОбъектКопирования - Произвольный - Объект копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	ДокументИсточник       = Неопределено;
	ЖелаемаяДатаПоступления = Дата(1, 1, 1);
	Назначение              = Справочники.Назначения.ПустаяСсылка();
	Для каждого СтрокаТовары Из ТоварыСкладские Цикл
		СтрокаТовары.НачалоОтгрузки = Дата(1, 1, 1);
		СтрокаТовары.Назначение = Справочники.Назначения.ПустаяСсылка();
	КонецЦикла;
	
	ИнициализироватьДокумент();
КонецПроцедуры

// Процедура - Инициализировать документ.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный			= Пользователи.ТекущийПользователь();
	Валюта					= питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета(Валюта);
	Организация				= ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	ХозяйственнаяОперация	= Перечисления.питХозяйственныеОперации.ЗаказНаПеремещениеВНоменклатуруПроизводства;
	Статус					= Перечисления.питСтатусыЗаказовНаПеремещениеВНоменклатуруПроизводства.КОбеспечению;
	
	ПараметрыЗаполнения = УчетНДСУПКлиентСервер.ПараметрыЗаполненияВидаДеятельностиНДС();
	ПараметрыЗаполнения.Организация = Организация;
	ПараметрыЗаполнения.Дата = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	ПараметрыЗаполнения.Склад = СкладПолучатель;
	ПараметрыЗаполнения.ДвижениеТоваровНаСкладах = Истина;
	УчетНДСУП.ЗаполнитьВидДеятельностиНДС(ПеремещениеПодДеятельность, ПараметрыЗаполнения);
	
	питДлительнаяПоддержка.ПолучитьПриоритетПоУмолчанию(Приоритет);
	
КонецПроцедуры

// Процедура - Заполнить по таблице товары.
//
// Параметры:
//  АдресПродукция - Произвольный - Адрес продукция.
//
Процедура ЗаполнитьПоТаблицеТовары(АдресПродукция)
	
	Если ЭтоАдресВременногоХранилища(АдресПродукция) Тогда
		ТаблицаТоваров = ПолучитьИзВременногоХранилища(АдресПродукция);
		УдалитьИзВременногоХранилища(АдресПродукция);
	Иначе
		ТаблицаТоваров = АдресПродукция; //для заполнения была передана таблица значений.
	КонецЕсли;
	
	Товары.Очистить();
	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ГруппируемыеПоля = "Номенклатура,Характеристика"
		+ ?(ТаблицаТоваров.Колонки.Найти("Назначение") <> Неопределено,",Назначение","")
		+ ?(ТаблицаТоваров.Колонки.Найти("Упаковка") <> Неопределено,",Упаковка","");
	
	СвернутаяТаблицаТоваров = ТаблицаТоваров.Скопировать(,ГруппируемыеПоля+",Количество, КоличествоУпаковок");
	СвернутаяТаблицаТоваров.Свернуть(ГруппируемыеПоля,"Количество, КоличествоУпаковок");
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого СтрокаТовара из СвернутаяТаблицаТоваров Цикл
		
		СтрокаПродукция = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПродукция, СтрокаТовара);
		
		СтрокаПродукция.КлючСтроки = Новый УникальныйИдентификатор;
		
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаПродукция, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Подобрать номенклатуру склада для номенклатуры производства.
//
Процедура ПодобратьНоменклатуруСкладаДляНоменклатурыПроизводства()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыПроизводственные.Номенклатура КАК Номенклатура,
	|	ТоварыПроизводственные.Количество КАК Количество,
	|	ТоварыПроизводственные.КлючСтроки КАК КлючСтроки
	|ПОМЕСТИТЬ втТоварыПроизводственные
	|ИЗ
	|	&ТаблицаТоваров КАК ТоварыПроизводственные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыПроизводственные.КлючСтроки КАК КлючСтроки,
	|	втТоварыПроизводственные.Номенклатура КАК НоменклатураПроизводственная,
	|	втТоварыПроизводственные.Количество КАК КоличествоПроизводственная,
	|	ЕСТЬNULL(питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК НоменклатураСкладская,
	|	ЕСТЬNULL(питСоответствиеНоменклатурыСкладаПроизводства.Коэффициент, 0) КАК Коэффициент,
	|	ЕСТЬNULL(питСоответствиеНоменклатурыСкладаПроизводства.Приоритет, 0) КАК Приоритет
	|ПОМЕСТИТЬ втАналоги
	|ИЗ
	|	втТоварыПроизводственные КАК втТоварыПроизводственные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
	|		ПО втТоварыПроизводственные.Номенклатура = питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная
	|ГДЕ
	|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная В
	|			(ВЫБРАТЬ
	|				вт.Номенклатура
	|			ИЗ
	|				втТоварыПроизводственные КАК вт)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втАналоги.НоменклатураСкладская КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия
	|ПОМЕСТИТЬ втТоварыДляОстатков
	|ИЗ
	|	втАналоги КАК втАналоги
	|
	|;
	|" + питОбщегоНазначенияСервер.ПолучитьТекстЗапросаСвободныеОстатки("втТоварыДляОстатков", "втОстатки", Ложь, Ложь) + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втОстатки.Номенклатура КАК Номенклатура,
	|	втОстатки.Характеристика КАК Характеристика,
	|	втОстатки.Количество КАК КоличествоОстаток
	|ИЗ
	|	втОстатки КАК втОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втАналоги.КлючСтроки КАК КлючСтроки,
	|	втАналоги.НоменклатураПроизводственная КАК НоменклатураПроизводственная,
	|	втАналоги.КоличествоПроизводственная КАК КоличествоПроизводственная,
	|	втАналоги.НоменклатураСкладская КАК НоменклатураСкладская,
	|	ЕСТЬNULL(втОстатки.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаСкладская,
	|	втАналоги.Коэффициент КАК Коэффициент,
	|	втАналоги.Приоритет КАК Приоритет
	|ИЗ
	|	втАналоги КАК втАналоги
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК втОстатки
	|		ПО втАналоги.НоменклатураСкладская = втОстатки.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(КоличествоПроизводственная)
	|ПО
	|	КлючСтроки";
	Запрос.УстановитьПараметр("ТаблицаТоваров", Товары.Выгрузить());
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("НаДату", Дата);
	Запрос.УстановитьПараметр("Склад", СкладОтправитель);
	
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	
	ТаблицаОстатков = РезультатЗапросаПакет[5].Выгрузить();
	
	СтруктураПоискаОстатков = Новый Структура("Номенклатура, Характеристика");
	РезультатЗапроса = РезультатЗапросаПакет[6];
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаКлючСтроки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКлючСтроки.Следующий() Цикл
			
			ОсталосьЗаменить = ВыборкаКлючСтроки.КоличествоПроизводственная;
			Счетчик = 1;
			
			ВыборкаДетальныеЗаписи = ВыборкаКлючСтроки.Выбрать();
			НаиболееПриоритетнаяСтрока = Неопределено;
			Пока ВыборкаДетальныеЗаписи.Следующий() И ОсталосьЗаменить > 0 Цикл
				
				СтруктураПоискаОстатков.Номенклатура = ВыборкаДетальныеЗаписи.НоменклатураСкладская;
				СтруктураПоискаОстатков.Характеристика = ВыборкаДетальныеЗаписи.ХарактеристикаСкладская;
				ТекОстатки = ТаблицаОстатков.НайтиСтроки(СтруктураПоискаОстатков);
				ВсегоОстатков = 0;
				Если ТекОстатки.Количество() Тогда
					ВсегоОстатков = ТекОстатки[0].КоличествоОстаток;
				КонецЕсли;
				
				КоличествоЗаменить = Мин(
					ОсталосьЗаменить / ?(ВыборкаДетальныеЗаписи.Коэффициент <> 0, ВыборкаДетальныеЗаписи.Коэффициент, 1), 
					ВсегоОстатков);
				Если КоличествоЗаменить > 0 Тогда
					
					НовСтрокаРезультат = ТоварыСкладские.Добавить();
					НовСтрокаРезультат.Номенклатура = ВыборкаДетальныеЗаписи.НоменклатураСкладская;
					НовСтрокаРезультат.Характеристика = ВыборкаДетальныеЗаписи.ХарактеристикаСкладская;
					НовСтрокаРезультат.КлючЗапасов = ВыборкаДетальныеЗаписи.КлючСтроки;
					НовСтрокаРезультат.Количество = КоличествоЗаменить;
					НовСтрокаРезультат.КоличествоУпаковок = КоличествоЗаменить;
					НовСтрокаРезультат.КоэффициентПроизводства = ВыборкаДетальныеЗаписи.Коэффициент;
					НовСтрокаРезультат.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
					
					ОсталосьЗаменить = ОсталосьЗаменить - КоличествоЗаменить * ВыборкаДетальныеЗаписи.Коэффициент;
					Если Счетчик = 1 Тогда
						НаиболееПриоритетнаяСтрока = НовСтрокаРезультат;
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТекОстатки.Количество() И ВыборкаДетальныеЗаписи.Коэффициент <> 0 Тогда
					ТекОстатки[0].КоличествоОстаток = ТекОстатки[0].КоличествоОстаток - КоличествоЗаменить;
				КонецЕсли;
				
				Счетчик = Счетчик + 1;
			КонецЦикла;
			Если ОсталосьЗаменить > 0 Тогда
				Если НаиболееПриоритетнаяСтрока = Неопределено Тогда
					ВыборкаДетальныеЗаписи.Сбросить();
					ВыборкаДетальныеЗаписи.Следующий();
					НаиболееПриоритетнаяСтрока = ТоварыСкладские.Добавить();
					НаиболееПриоритетнаяСтрока.Номенклатура = ВыборкаДетальныеЗаписи.НоменклатураСкладская;
					НаиболееПриоритетнаяСтрока.Характеристика = ВыборкаДетальныеЗаписи.ХарактеристикаСкладская;
					НаиболееПриоритетнаяСтрока.КлючЗапасов = ВыборкаДетальныеЗаписи.КлючСтроки;
					НаиболееПриоритетнаяСтрока.Количество = 0;
					НаиболееПриоритетнаяСтрока.КоличествоУпаковок = 0;
					НаиболееПриоритетнаяСтрока.КоэффициентПроизводства = ВыборкаДетальныеЗаписи.Коэффициент;
					НаиболееПриоритетнаяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
				КонецЕсли;
				НаиболееПриоритетнаяСтрока.Количество = НаиболееПриоритетнаяСтрока.Количество 
					+ ОсталосьЗаменить / ?(НаиболееПриоритетнаяСтрока.КоэффициентПроизводства <> 0, НаиболееПриоритетнаяСтрока.КоэффициентПроизводства, 1);
				НаиболееПриоритетнаяСтрока.КоличествоУпаковок = НаиболееПриоритетнаяСтрока.Количество;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
