
#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Статус при изменении завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СтатусПриИзмененииЗавершение(Результат, Команда) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.Статус = ПредыдущийСтатус;
	Иначе
		ЗаполнитьПредставленияСвязанныхПеремещенийНоменклатурыСкладаПроизводства();
		Для каждого ВыборкаДетальныеЗаписи Из ПредставленияПеремещений Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Обратите внимание, что после смены статуса
			|необходимо перепровести связанный документ <"+ВыборкаДетальныеЗаписи.Представление+">";
			Сообщение.КлючДанных = ВыборкаДетальныеЗаписи.ВыпускБлюд;
			Сообщение.ИдентификаторНазначения = ЭтаФорма.УникальныйИдентификатор;
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Обеспечение

//  Процедура - После вопроса заполнять обеспечение целыми упаковками.
//
// Параметры:
//  Ответ - Произвольный - Ответ.
//  Результат - Произвольный - Результат.
//
&НаКлиенте
Процедура ПослеВопросаЗаполнятьОбеспечениеЦелымиУпаковками(Ответ, Результат) Экспорт
	
	ОбеспечениеУстановитьДействиеПослеВопроса(Ответ, Результат);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Разбить строку завершение.
//
// Параметры:
//  НоваяСтрока - Строка - Новая строка.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура РазбитьСтрокуЗавершение(НоваяСтрока, ДополнительныеПараметры) Экспорт 
	
	ТекущаяСтрока = Элементы[ДополнительныеПараметры.ИмяТЧ].ТекущиеДанные;
	
	Если НоваяСтрока <> Неопределено Тогда
		
		СтруктураДействий = Новый Структура;
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ДополнительныеПараметры.ИмяТЧ, СтруктураДействий);		
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Выполнить команду завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВыполнитьКомандуЗавершение(Результат, Команда) Экспорт
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	Если ОписаниеКоманды.Вид = "СозданиеНаОсновании" И ОписаниеКоманды.Представление = "Перемещение номенклатуры склада и производства" 
		И Объект.Статус <> ПредопределенноеЗначение("Перечисление.питСтатусыЗаказовНаПеремещениеВНоменклатуруПроизводства.КПеремещению")
		И НЕ Объект.ПометкаУдаления
		И Результат = КодВозвратаДиалога.Да Тогда
		Объект.Статус = ПредопределенноеЗначение("Перечисление.питСтатусыЗаказовНаПеремещениеВНоменклатуруПроизводства.КПеремещению");
		Попытка
			Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось записать документ по причине: " + ОписаниеОшибки(), "", "");
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыВстраивания = Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства.ДоступныеОстаткиПараметрыВстраивания();
	ОбеспечениеВДокументахСервер.ДоступныеОстаткиПриСозданииНаСервере(ЭтотОбъект, ПараметрыВстраивания);
	питЗаполнитьКолонкуДоступно();
	
	УстановитьУсловноеОформление();
	
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// Обработчик механизма "Назначения"
	Справочники.Назначения.ФормаДокументаПриСозданииНаСервере(ЭтаФорма);
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	ПроверятьЗаполненияСкладскихТоваров = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питЗаполнятьНоменклатуруСкладаВЗаказеНаПеремещениеВНоменклатуруПроизводства");
	
	ПредыдущийСтатус = Объект.Статус;
	
	ЗаполнитьКоэффициентПроизводстваУпаковок();
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	Элементы.ТоварыСкладские.АвтоОтметкаНезаполненного = ПроверятьЗаполненияСкладскихТоваров;
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПараметрыВстраивания = Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства.ДоступныеОстаткиПараметрыВстраивания();
	ОбеспечениеВДокументахСервер.ДоступныеОстаткиПриЧтенииНаСервере(ЭтотОбъект, ПараметрыВстраивания);
	питЗаполнитьКолонкуДоступно();
	
	ПриЧтенииСозданииНаСервере();
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	УправлениеФормой(ЭтаФорма);
	ЗаполнитьСлужебныеРеквизитыФормыДокумента();
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "Обработка.СостояниеОбеспечения.Форма.Форма" Тогда
		
		// ?
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Товары номенклатура при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыНоменклатураПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	
	СкладскиеСтроки = Объект.ТоварыСкладские.НайтиСтроки(Новый Структура("КлючЗапасов", СтрокаТабличнойЧасти.КлючСтроки));
	Для каждого СтрокаСкладскойНоменклатуры Из СкладскиеСтроки Цикл
		
		СтарыйКоэффициентПроизводства = СтрокаСкладскойНоменклатуры.КоэффициентПроизводстваУпаковок;
		
		// +БизнесЛогика Установка коэффициента производства по выбранной номенклатуре
		УстановитьКоэффициентПроизводства(СтрокаСкладскойНоменклатуры, СтрокаТабличнойЧасти);
		// -БизнесЛогика
		
		// Подбор количества
		Если СтарыйКоэффициентПроизводства <> СтрокаСкладскойНоменклатуры.КоэффициентПроизводстваУпаковок Тогда
			СтрокаСкладскойНоменклатуры.КоличествоУпаковок = СтрокаСкладскойНоменклатуры.КоличествоУпаковок * СтарыйКоэффициентПроизводства / СтрокаСкладскойНоменклатуры.КоэффициентПроизводстваУпаковок;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаНоменклатураПриИзменении(СтрокаТабличнойЧасти, "Товары");
	
	// +БизнесЛогика При удалении производственной номенклатуры удаляем все складские, связанные с ней.
	УдалитьСкладскиеТоварыПоТекущемуПроизводственному(СтрокаТабличнойЧасти);
	// -БизнесЛогика
	
КонецПроцедуры

//  Процедура - Товары складские номенклатура при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//  ИдентификаторПроизводственнойСтроки - Произвольный - Идентификатор производственной строки.
//
&НаСервере
Процедура ТоварыСкладскиеНоменклатураПриИзмененииНаСервере(ИдентификаторТекущейСтроки, ИдентификаторПроизводственнойСтроки)
	
	СтрокаТабличнойЧасти = Объект.ТоварыСкладские.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	СтрокаПроизводственнойНоменклатуры = Объект.Товары.НайтиПоИдентификатору(ИдентификаторПроизводственнойСтроки);
	
	СтарыйКоэффициентПроизводства = СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок;
	
	// +БизнесЛогика Установка коэффициента производства по выбранной номенклатуре
	УстановитьКоэффициентПроизводства(СтрокаТабличнойЧасти, СтрокаПроизводственнойНоменклатуры);
	// -БизнесЛогика
	
	// Подбор количества
	Если СтрокаТабличнойЧасти.КоличествоУпаковок = 0 Тогда
		КоличествоУпаковокПодобрано = 0;
		Для каждого ТекСтрокаТоварыСкладские Из Объект.ТоварыСкладские Цикл
			КоличествоУпаковокПодобрано = КоличествоУпаковокПодобрано + ТекСтрокаТоварыСкладские.КоличествоУпаковок * ТекСтрокаТоварыСкладские.КоэффициентПроизводстваУпаковок;
		КонецЦикла;
		ОсталосьПодобрать = Макс(0, СтрокаПроизводственнойНоменклатуры.КоличествоУпаковок - КоличествоУпаковокПодобрано);
		СтрокаТабличнойЧасти.КоличествоУпаковок = ОсталосьПодобрать / СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок;
	ИначеЕсли СтарыйКоэффициентПроизводства <> СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок Тогда
		СтрокаТабличнойЧасти.КоличествоУпаковок = СтрокаТабличнойЧасти.КоличествоУпаковок * СтарыйКоэффициентПроизводства / СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок;
	КонецЕсли;
	
	ТаблицаНоменклатураПриИзменении(СтрокаТабличнойЧасти, "ТоварыСкладские");
	
КонецПроцедуры

//  Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ТекущиеДанные - Произвольный - Текущие данные.
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаСервере
Процедура ТаблицаНоменклатураПриИзменении(ТекущиеДанные, ИмяТЧ)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, СтруктураКешированныеЗначения);
	
КонецПроцедуры

//  Процедура - Товары количество при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыКоличествоПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
КонецПроцедуры

//  Процедура - Товары упаковка при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыУпаковкаПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	СтрокаТабличнойЧасти = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	
	СкладскиеСтроки = Объект.ТоварыСкладские.НайтиСтроки(Новый Структура("КлючЗапасов", СтрокаТабличнойЧасти.КлючСтроки));
	Для каждого СтрокаСкладскойНоменклатуры Из СкладскиеСтроки Цикл
		
		СтарыйКоэффициентПроизводства = СтрокаСкладскойНоменклатуры.КоэффициентПроизводстваУпаковок;
		
		// +БизнесЛогика Установка коэффициента производства по выбранной номенклатуре
		УстановитьКоэффициентПроизводства(СтрокаСкладскойНоменклатуры, СтрокаТабличнойЧасти);
		// -БизнесЛогика
		
		// Подбор количества
		Если СтарыйКоэффициентПроизводства <> СтрокаСкладскойНоменклатуры.КоэффициентПроизводстваУпаковок Тогда
			СтрокаСкладскойНоменклатуры.КоличествоУпаковок = СтрокаСкладскойНоменклатуры.КоличествоУпаковок * СтарыйКоэффициентПроизводства / СтрокаСкладскойНоменклатуры.КоэффициентПроизводстваУпаковок;
		КонецЕсли;
		
	КонецЦикла;
	
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
КонецПроцедуры

//  Процедура - Товары складские количество при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//
&НаСервере
Процедура ТоварыСкладскиеКоличествоПриИзмененииНаСервере(ИдентификаторТекущейСтроки)
	СтрокаТабличнойЧасти = Объект.ТоварыСкладские.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
КонецПроцедуры

//  Процедура - Товары складские упаковка при изменении на сервере.
//
// Параметры:
//  ИдентификаторТекущейСтроки - Произвольный - Идентификатор текущей строки.
//  ИдентификаторПроизводственнойСтроки - Произвольный - Идентификатор производственной строки.
//
&НаСервере
Процедура ТоварыСкладскиеУпаковкаПриИзмененииНаСервере(ИдентификаторТекущейСтроки, ИдентификаторПроизводственнойСтроки)
	СтрокаТабличнойЧасти = Объект.ТоварыСкладские.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
	СтрокаПроизводственнойНоменклатуры = Объект.Товары.НайтиПоИдентификатору(ИдентификаторПроизводственнойСтроки);
	
	СтарыйКоэффициентПроизводства = СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок;
	
	// +БизнесЛогика Установка коэффициента производства по выбранной номенклатуре
	УстановитьКоэффициентПроизводства(СтрокаТабличнойЧасти, СтрокаПроизводственнойНоменклатуры);
	// -БизнесЛогика
	
	// Подбор количества
	Если СтрокаТабличнойЧасти.КоличествоУпаковок = 0 Тогда
		КоличествоУпаковокПодобрано = 0;
		Для каждого ТекСтрокаТоварыСкладские Из Объект.ТоварыСкладские Цикл
			КоличествоУпаковокПодобрано = КоличествоУпаковокПодобрано + ТекСтрокаТоварыСкладские.КоличествоУпаковок * ТекСтрокаТоварыСкладские.КоэффициентПроизводстваУпаковок;
		КонецЦикла;
		ОсталосьПодобрать = Макс(0, СтрокаПроизводственнойНоменклатуры.КоличествоУпаковок - КоличествоУпаковокПодобрано);
		СтрокаТабличнойЧасти.КоличествоУпаковок = ОсталосьПодобрать / СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок;
	ИначеЕсли СтарыйКоэффициентПроизводства <> СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок Тогда
		СтрокаТабличнойЧасти.КоличествоУпаковок = СтрокаТабличнойЧасти.КоличествоУпаковок * СтарыйКоэффициентПроизводства / СтрокаТабличнойЧасти.КоэффициентПроизводстваУпаковок;
	КонецЕсли;
	
	ПосчитатьКоличестваВединицахХранения(СтрокаТабличнойЧасти, "");
	
КонецПроцедуры

&НаСервере
Процедура ТоварыВариантОбеспеченияПриИзмененииНаСервере(ПараметрыЗаполнения)
	
	Изменения = ОбеспечениеВДокументахСервер.ВариантОбеспеченияПриИзменении(
		ЭтотОбъект,
		Элементы.ТоварыСкладские.ТекущаяСтрока);
		
	Режим = ОбеспечениеВДокументахКлиентСервер.РежимВыборДействияНепосредственно();
	ПослеЗаполненияОбеспечения(Изменения, Режим, ПараметрыЗаполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВариантОбеспеченияПриИзмененииПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт
	
	ПараметрыЗаполнения = ОбеспечениеВДокументахКлиент.ПараметрыОбработкиДатОтгрузкиПослеЗаполненияОбеспечения(Ответ);
	ТоварыВариантОбеспеченияПриИзмененииНаСервере(ПараметрыЗаполнения);
	
КонецПроцедуры

//  Процедура - Товары складские при изменении на сервере.
//
&НаСервере
Процедура ТоварыСкладскиеПриИзмененииНаСервере()
	питЗаполнитьКолонкуДоступно();
КонецПроцедуры

//  Процедура - Статус при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	Если Объект.Статус <> ПредыдущийСтатус И ЗначениеЗаполнено(Объект.Ссылка) И ЕстьСвязанныеПеремещенияНоменклатурыСкладаПроизводства(Объект.Ссылка) Тогда
		Оповещение = Новый ОписаниеОповещения("СтатусПриИзмененииЗавершение", ЭтотОбъект, Новый Структура());
		ПоказатьВопрос(Оповещение, "Для текущего заказа уже созданы документы ""Перемещение номенклатуры склада и производства"", продолжить изменение статуса?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ПредыдущийСтатус = Объект.Статус;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Товары номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.Товары.ТекущаяСтрока;
	ТоварыНоменклатураПриИзмененииНаСервере(ИдентификаторТекущейСтроки);
КонецПроцедуры

//  Процедура - Товары складские номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСкладскиеНоменклатураПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.ТоварыСкладские.ТекущаяСтрока;
	ИдентификаторПроизводственнойСтроки = Элементы.Товары.ТекущаяСтрока;
	ТоварыСкладскиеНоменклатураПриИзмененииНаСервере(ИдентификаторТекущейСтроки, ИдентификаторПроизводственнойСтроки);
КонецПроцедуры

//  Процедура - Товары складские при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ТоварыСкладскиеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	// +БизнесЛогика Связь складских товаров и производственных.
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекДанные = Элементы.Товары.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(ТекДанные.КлючСтроки) Тогда
				ТекДанные.КлючСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			Элемент.ТекущиеДанные.КлючЗапасов = ТекДанные.КлючСтроки;
			ОбновитьОтборСтрокВТаблицеТоваровСкладских();
			// +пит
			ТекДанныеСкладские = Элементы.ТоварыСкладские.ТекущиеДанные;
			Если НЕ ТекДанныеСкладские = Неопределено Тогда
				ТекДанныеСкладские.Доступно = 999999999;
				ТекДанныеСкладские.КодСтроки = Объект.ТоварыСкладские.Количество() + 1;
			КонецЕсли;
			// -пит
		КонецЕсли;
	КонецЕсли;
	// -БизнесЛогика
КонецПроцедуры

//  Процедура - Товары складские перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ТоварыСкладскиеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ТекДанныеТовары = Элементы.Товары.ТекущиеДанные;
	Если ТекДанныеТовары = Неопределено Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не задана номенклатура производства");
	КонецЕсли;
КонецПроцедуры

//  Процедура - Товары складские номенклатура начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСкладскиеНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДанныеТовары = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекДанныеТовары = Неопределено 
		И ЗначениеЗаполнено(ТекДанныеТовары.Номенклатура) Тогда
		ТекДанныеВыбора = СформироватьСписокСкладскойНоменклатурыПоПроизводственной(ТекДанныеТовары.Номенклатура);
	Иначе
		ТекДанныеВыбора = Новый СписокЗначений;
	КонецЕсли;
	Элементы.ТоварыСкладскиеНоменклатура.СписокВыбора.ЗагрузитьЗначения(ТекДанныеВыбора.ВыгрузитьЗначения());
КонецПроцедуры

//  Процедура - Товары складские номенклатура начало выбора из списка.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСкладскиеНоменклатураНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
		ТекДанныеТовары = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекДанныеТовары = Неопределено 
		И ЗначениеЗаполнено(ТекДанныеТовары.Номенклатура) Тогда
		ТекДанныеВыбора = СформироватьСписокСкладскойНоменклатурыПоПроизводственной(ТекДанныеТовары.Номенклатура);
	Иначе
		ТекДанныеВыбора = Новый СписокЗначений;
	КонецЕсли;
	Элементы.ТоварыСкладскиеНоменклатура.СписокВыбора.ЗагрузитьЗначения(ТекДанныеВыбора.ВыгрузитьЗначения());
КонецПроцедуры

//  Процедура - Товары количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.Товары.ТекущаяСтрока;
	ТоварыКоличествоПриИзмененииНаСервере(ИдентификаторТекущейСтроки);
КонецПроцедуры

//  Процедура - Товары упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыУпаковкаПриИзменении(Элемент)
	ТоварыУпаковкаПриИзмененииНаСервере(Элементы.Товары.ТекущаяСтрока);
КонецПроцедуры

//  Процедура - Товары складские количество упаковок при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСкладскиеКоличествоУпаковокПриИзменении(Элемент)
	ИдентификаторТекущейСтроки = Элементы.ТоварыСкладские.ТекущаяСтрока;
	ТоварыСкладскиеКоличествоПриИзмененииНаСервере(ИдентификаторТекущейСтроки);
КонецПроцедуры

//  Процедура - Товары складские упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСкладскиеУпаковкаПриИзменении(Элемент)
	ТоварыСкладскиеУпаковкаПриИзмененииНаСервере(Элементы.ТоварыСкладские.ТекущаяСтрока, Элементы.Товары.ТекущаяСтрока);
КонецПроцедуры

//  Процедура - Товары при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	ОбновитьОтборСтрокВТаблицеТоваровСкладских();
КонецПроцедуры

//  Процедура - Товары складские вариант обеспечения при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСкладскиеВариантОбеспеченияПриИзменении(Элемент)
	
	Перем ПараметрыФормы;
	Если ОбеспечениеВДокументахКлиент.ОткрытьФормуВыбораСкладаИСерий(ЭтотОбъект) Тогда
		ВариантПолученияПараметров = ОбеспечениеВДокументахКлиентСервер.РежимВыборДействия();
		ПараметрыФормы = ПараметрыФормыЗапросаКоличестваИСерий(ВариантПолученияПараметров); // вызов сервера
	КонецЕсли;
	
	ОбеспечениеВДокументахКлиент.ВариантОбеспеченияПриИзменении(
		ЭтотОбъект,
		ПараметрыФормы,
		"ОбработатьВыборСкладаИСерии",
		Истина,
		"ТоварыВариантОбеспеченияПриИзмененииПослеВопроса");
	
КонецПроцедуры

//  Процедура - Товары складские вариант обеспечения очистка.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСкладскиеВариантОбеспеченияОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

//  Процедура - Товары складские вариант обеспечения обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСкладскиеВариантОбеспеченияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОбеспечениеВДокументахКлиент.ВариантОбеспеченияОбработкаВыбора(
		ЭтотОбъект,
		Элементы.ТоварыСкладские.ТекущиеДанные,
		ВыбранноеЗначение);
	
КонецПроцедуры

//  Процедура - Товары складские при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСкладскиеПриИзменении(Элемент)
