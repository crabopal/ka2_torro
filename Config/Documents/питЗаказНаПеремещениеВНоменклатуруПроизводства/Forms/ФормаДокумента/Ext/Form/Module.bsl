//  Процедура - Разбить строку.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура РазбитьСтроку(Команда)
	
	Если СтрНайти(Команда.Имя, "ТоварыСкладские") Тогда
		ИмяТЧ = "ТоварыСкладские";
	Иначе
		ИмяТЧ = "Товары";
	КонецЕсли;
	ДополнительныеПараметры = Новый Структура("ИмяТЧ", ИмяТЧ);
	
	ТаблицаФормы  = Элементы[ИмяТЧ];
	ДанныеТаблицы = Объект[ИмяТЧ];
	
	Оповещение = Новый ОписаниеОповещения("РазбитьСтрокуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РаботаСТабличнымиЧастямиКлиент.РазбитьСтроку(ДанныеТаблицы, ТаблицаФормы, Оповещение);
	
КонецПроцедуры

//  Процедура - Вставить строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВставитьСтроки(Команда)
	
	Если СтрНайти(Команда.Имя, "ТоварыСкладские") Тогда
		ИмяТЧ = "ТоварыСкладские";
	Иначе
		ИмяТЧ = "Товары";
	КонецЕсли;
	
	КоличествоТоваровДоВставки = Объект[ИмяТЧ].Количество();
	
	КлючЗапасов = Неопределено;
	Если ИмяТЧ = "ТоварыСкладские" Тогда
		ТекДанные = Элементы.Товары.ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда
			КлючЗапасов = ТекДанные.КлючСтроки;
		КонецЕсли;
		ПолучитьСтрокиИзБуфераОбмена(ИмяТЧ, КлючЗапасов);
	Иначе
		ПолучитьСтрокиИзБуфераОбмена(ИмяТЧ);
	КонецЕсли;
	
	КоличествоВставленных = Объект[ИмяТЧ].Количество()-КоличествоТоваровДоВставки;
	РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОВставкеСтрок(КоличествоВставленных);
	
КонецПроцедуры

//  Процедура - Скопировать строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СкопироватьСтроки(Команда)
	
	Если СтрНайти(Команда.Имя, "ТоварыСкладские") Тогда
		ИмяТЧ = "ТоварыСкладские";
	Иначе
		ИмяТЧ = "Товары";
	КонецЕсли;
	
	Если РаботаСТабличнымиЧастямиКлиент.ВыбранаСтрокаДляВыполненияКоманды(Элементы[ИмяТЧ]) Тогда
		СкопироватьСтрокиНаСервере(ИмяТЧ);
		РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОКопированииСтрок(Элементы[ИмяТЧ].ВыделенныеСтроки.Количество());
	КонецЕсли;

КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
		ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	Если ОписаниеКоманды.Вид = "СозданиеНаОсновании" И ОписаниеКоманды.Представление = "Перемещение номенклатуры склада и производства" 
		И Объект.Статус <> ПредопределенноеЗначение("Перечисление.питСтатусыЗаказовНаПеремещениеВНоменклатуруПроизводства.КПеремещению")
		И НЕ Объект.ПометкаУдаления Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьКомандуЗавершение", ЭтотОбъект, Команда);
		ПоказатьВопрос(Оповещение, "Документ не переведен в статус ""К перемещению"". Выполнить предварительное проведение документа со сменой статуса?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
	КонецЕсли;
КонецПроцедуры

