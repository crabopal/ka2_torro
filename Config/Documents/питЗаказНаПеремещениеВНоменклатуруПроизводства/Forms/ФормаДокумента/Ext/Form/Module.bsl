//  Процедура - Установить видимость элементов использования длительности.
//
&НаСервере
Процедура УстановитьВидимостьЭлементовИспользованияДлительности()
	
	Элементы.ДлительностьПеремещения.ТолькоПросмотр = Не Объект.ИспользоватьДлительностьПеремещения;
	
	Если Объект.ИспользоватьДлительностьПеремещения Тогда
		Элементы.ТоварыСкладскиеНачалоОтгрузки.Заголовок = НСтр("ru = 'Начало отгрузки';
														|en = 'Shipment start'");
	Иначе
		Элементы.ТоварыСкладскиеНачалоОтгрузки.Заголовок = НСтр("ru = 'Дата отгрузки';
														|en = 'Shipment date'");
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Обеспечение установить действие.
//
// Параметры:
//  КодДействия - Произвольный - Код действия.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ОбеспечениеУстановитьДействие(КодДействия)
	
	Результат = ОбеспечениеВДокументахСервер.ОбеспечениеУстановитьДействиеСтруктураРезультата();
	
	Если КодДействия = "ФЛАГ_ОБОСОБЛЕННО" Или КодДействия = "ФЛАГ_НЕОБОСОБЛЕННО" Тогда
		
		Изменения = ОбеспечениеВДокументахСервер.УстановитьДействиеОбособленно(
			КодДействия,
			ЭтотОбъект,
			Элементы.ТоварыСкладские.ВыделенныеСтроки);
			
		ОбновитьКолонкуДоступноСервер();
		
	Иначе
		
		Изменения = ОбеспечениеВДокументахСервер.УстановитьДействие(
			КодДействия,
			ЭтотОбъект,
			Элементы.ТоварыСкладские.ВыделенныеСтроки);
			
		ЗаполнитьЗначенияСвойств(Результат, Изменения);
		
		Если Изменения.ТаблицаИзменений <> Неопределено Тогда
			ПослеЗаполненияОбеспечения(
				Изменения.ТаблицаИзменений,
				ОбеспечениеВДокументахКлиентСервер.РежимВыборДействия(),
				Результат);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//  Процедура - Обеспечение установить действие с вопросом.
//
// Параметры:
//  КодДействия - Произвольный - Код действия.
//
&НаКлиенте
Процедура ОбеспечениеУстановитьДействиеСВопросом(КодДействия)
	
	Результат = ОбеспечениеУстановитьДействие(КодДействия);
	
	ОбеспечениеВДокументахКлиент.ПоказатьВопросЗаполнятьОбеспечениеЦелымиУпаковками(
		ЭтотОбъект,
		Объект.ТоварыСкладские,
		Результат,
		"ПослеВопросаЗаполнятьОбеспечениеЦелымиУпаковками");
		
КонецПроцедуры

//  Процедура - Обеспечение установить действие после вопроса.
//
// Параметры:
//  Ответ - Произвольный - Ответ.
//  Результат - Произвольный - Результат.
//
&НаСервере
Процедура ОбеспечениеУстановитьДействиеПослеВопроса(Ответ, Результат)
	
	СтруктураРезультата = ОбеспечениеВДокументахСервер.УстановитьДействиеПослеВопроса(Ответ, Результат, ЭтотОбъект);
	ПослеЗаполненияОбеспечения(
		СтруктураРезультата.ТаблицаИзменений,
		ОбеспечениеВДокументахКлиентСервер.РежимВыборДействия(),
		СтруктураРезультата);
	
КонецПроцедуры

//  Процедура - Обновить колонку доступно сервер.
//
&НаСервере
Процедура ОбновитьКолонкуДоступноСервер()
	
	// ОбеспечениеВДокументахСервер.ОбновитьКолонкуДоступно(ЭтотОбъект);
	
КонецПроцедуры

//  Процедура - После заполнения обеспечения.
//
// Параметры:
//  Изменения - Произвольный - Изменения.
//  Режим - Произвольный - Режим.
//  ПараметрыЗаполнения - Произвольный - Параметры заполнения.
//
&НаСервере
Процедура ПослеЗаполненияОбеспечения(Изменения, Режим = Неопределено, ПараметрыЗаполнения = Неопределено)
	
	Документы.питЗаказНаПеремещениеВНоменклатуруПроизводства.ПослеЗаполненияОбеспечения(Объект, Изменения, Режим, ПараметрыЗаполнения);
	
	СтруктураДействий = Новый Структура();
	ДобавитьДействияОбеспеченияНаСервере(СтруктураДействий, "СкладОбязателен,ДатаОтгрузкиОбязательна");
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	Для Каждого Изменение Из Изменения Цикл
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Изменение.Строка, СтруктураДействий, КэшированныеЗначения);
	КонецЦикла;
	ОбеспечениеВДокументахКлиентСервер.ЗаполнитьСлужебныеРеквизиты(Объект.ТоварыСкладские, ДатаОтгрузкиОбязательна, СкладОбязателен);
	ОбновитьКолонкуДоступноСервер();
	
КонецПроцедуры

//  Функция - Параметры документа для действий обеспечения.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыДокументаДляДействийОбеспечения(Форма)
	
	ПараметрыДокумента = Новый Структура();
	ПараметрыДокумента.Вставить("Форма",                              Форма);
	ПараметрыДокумента.Вставить("Коллекция",                          Форма.Объект.ТоварыСкладские);
	ПараметрыДокумента.Вставить("ВариантОбеспеченияИФлагОбособленно", Неопределено);
	
	Возврат ПараметрыДокумента;
	
КонецФункции

//  Процедура - Добавить действия обеспечения на сервере.
//
// Параметры:
//  СтруктураДействий - Структура - Структура действий.
//  ПоляСтрокой - Произвольный - Поля строкой.
//
&НаСервере
Процедура ДобавитьДействияОбеспеченияНаСервере(СтруктураДействий, ПоляСтрокой)
	
	ПараметрыДокумента = ПараметрыДокументаДляДействийОбеспечения(ЭтотОбъект);
	ОбеспечениеВДокументахКлиентСервер.ДобавитьДействияОбеспечения(СтруктураДействий, ПоляСтрокой, ПараметрыДокумента);
	
КонецПроцедуры

#КонецОбласти

#Область БизнесЛогикаРаботыФормы

//  Процедура - Удалить складские товары по текущему производственному.
//
// Параметры:
//  ТекДанныеТовары - Произвольный - Тек данные товары.
//
&НаСервере
Процедура УдалитьСкладскиеТоварыПоТекущемуПроизводственному(ТекДанныеТовары)
	
	Если ТекДанныеТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекДанныеТовары = Неопределено Тогда
		СтрокиУдалить = Объект.ТоварыСкладские.НайтиСтроки(Новый Структура("КлючЗапасов", ТекДанныеТовары.КлючСтроки));
		Для каждого ТекСтрокаУдалить Из СтрокиУдалить Цикл
			Объект.ТоварыСкладские.Удалить(ТекСтрокаУдалить);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Установить коэффициент производства.
//
// Параметры:
//  ТекДанныеТоварыСкладские - Произвольный - Тек данные товары складские.
//  СтрокаПроизводственнойНоменклатуры - Строка - Строка производственной номенклатуры.
//
&НаСервере
Процедура УстановитьКоэффициентПроизводства(ТекДанныеТоварыСкладские, СтрокаПроизводственнойНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питСоответствиеНоменклатурыСкладаПроизводства.Коэффициент КАК Коэффициент
		|ИЗ
		|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
		|ГДЕ
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская = &НоменклатураСкладская";
	Запрос.УстановитьПараметр("НоменклатураСкладская", ТекДанныеТоварыСкладские.Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ТекДанныеТоварыСкладские.КоэффициентПроизводства =  ВыборкаДетальныеЗаписи.Коэффициент;
	Иначе
		ТекДанныеТоварыСкладские.КоэффициентПроизводства = 1;
	КонецЕсли;
	
	// В коэффициенте производства учитываем упаковку.
	КоэффициентУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекДанныеТоварыСкладские.Номенклатура, ТекДанныеТоварыСкладские.Упаковка);
	КоэффициентПроизводственнойУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаПроизводственнойНоменклатуры.Номенклатура, СтрокаПроизводственнойНоменклатуры.Упаковка);
	ТекДанныеТоварыСкладские.КоэффициентПроизводстваУпаковок = ТекДанныеТоварыСкладские.КоэффициентПроизводства * КоэффициентУпаковки / КоэффициентПроизводственнойУпаковки;
	
КонецПроцедуры

//  Процедура - Обновить отбор строк в таблице товаров складских.
//
&НаКлиенте
Процедура ОбновитьОтборСтрокВТаблицеТоваровСкладских()
	
	Перем ТекДанные;
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.КлючСтроки) Тогда
		Элементы.ТоварыСкладские.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючЗапасов", ТекДанные.КлючСтроки);
	Иначе
		Элементы.ТоварыСкладские.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючЗапасов", "xxx");/// Скроем
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Сформировать список складской номенклатуры по производственной.
//
// Параметры:
//  НоменклатураПроизводственная - Произвольный - Номенклатура производственная.
//
// Возвращаемое значение:
//  СписокЗначений - Результат обработки.
//
&НаСервере
Функция СформироватьСписокСкладскойНоменклатурыПоПроизводственной(НоменклатураПроизводственная)
	
	Результат = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураСкладская КАК НоменклатураСкладская
		|ИЗ
		|	РегистрСведений.питСоответствиеНоменклатурыСкладаПроизводства КАК питСоответствиеНоменклатурыСкладаПроизводства
		|ГДЕ
		|	питСоответствиеНоменклатурыСкладаПроизводства.НоменклатураПроизводственная = &НоменклатураПроизводственная";
	
	Запрос.УстановитьПараметр("НоменклатураПроизводственная", НоменклатураПроизводственная);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Добавить(ВыборкаДетальныеЗаписи.НоменклатураСкладская);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

