//  Процедура - Установить условное оформление.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// +Упаковки
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ТоварыНоменклатураЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.Товары.Упаковка";
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ТоварыСкладскиеНоменклатураЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.ТоварыСкладские.Упаковка";
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	// -Упаковки
	
	// +Характеристики
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыХарактеристика.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>';
		|en = '<characteristics are not used>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыСкладскиеХарактеристика.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТоварыСкладские.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтмененнойСтрокиДокумента);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>';
		|en = '<characteristics are not used>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	// -Характеристики
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы["ТоварыСкладскиеНачалоОтгрузки"].Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ТоварыСкладские.НачалоОтгрузки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Из даты документа>'"));
	
КонецПроцедуры

//  Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
КонецПроцедуры

//  Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары			,ПараметрыЗаполненияРеквизитов);
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.ТоварыСкладские	,ПараметрыЗаполненияРеквизитов);
	
КонецПроцедуры

//  Процедура - Заполнить служебные реквизиты формы документа.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыФормыДокумента()
	
	ПараметрыДокумента = ПараметрыДокументаДляДействийОбеспечения(ЭтотОбъект);
	ОбеспечениеВДокументахСервер.ЗаполнитьСлужебныеРеквизитыФормыДокумента(ПараметрыДокумента);
	
	питЗаполнитьКолонкуДоступно();
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий)
	
	Объект = Форма.Объект;
	
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
	Новый Структура("Номенклатура", "ТипНоменклатуры"));
	Если ИмяТЧ = "ТоварыСкладские" Тогда
		СтруктураДействий.Вставить("ПроверитьЗаполнитьОбеспечение",
		Новый Структура("ЗаполнитьОбособленно", Ложь));
	КонецЕсли;
	СтруктураДействий.Вставить("ПроверитьЗаполнитьНазначение");
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
	Форма.ИмяФормы, ИмяТЧ));
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении количества упаковок.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчета);
	
КонецПроцедуры

//  Процедура - Посчитать количества вединицах хранения.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//  Суффикс - Произвольный - Суффикс.
//
&НаСервере
Процедура ПосчитатьКоличестваВединицахХранения(ТекущаяСтрока, Суффикс)
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", Суффикс);
	ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, СтруктураКешированныеЗначения);
	
КонецПроцедуры

//  Процедура - Заполнить представления связанных перемещений номенклатуры склада производства.
//
&НаСервере
Процедура ЗаполнитьПредставленияСвязанныхПеремещенийНоменклатурыСкладаПроизводства()
	ПредставленияПеремещений.Очистить();
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		РезультатЗапроса = Документы.питПеремещениеНоменклатурыСкладаПроизводства.РезультатЗапросаСвязанныеПеремещенияНоменклатурыСкладаПроизводства(Объект.Ссылка);
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				НовСтрокаПредставление = ПредставленияПеремещений.Добавить();
				НовСтрокаПредставление.Ссылка = ВыборкаДетальныеЗаписи.Ссылка;
				НовСтрокаПредставление.Представление = ВыборкаДетальныеЗаписи.Представление;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//  Функция - Есть связанные перемещения номенклатуры склада производства.
//
// Параметры:
//  ПланМеню - Произвольный - План меню.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ЕстьСвязанныеПеремещенияНоменклатурыСкладаПроизводства(ПланМеню)
	
	Возврат НЕ Документы.питПеремещениеНоменклатурыСкладаПроизводства.РезультатЗапросаСвязанныеПеремещенияНоменклатурыСкладаПроизводства(ПланМеню).Пустой();
	
КонецФункции

//  Процедура - Заполнить коэффициент производства упаковок.
//
&НаСервере
Процедура ЗаполнитьКоэффициентПроизводстваУпаковок()
	
	КэшированныеЗначенияУпаковок = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для каждого СтрокаТоварыСкладские Из Объект.ТоварыСкладские Цикл
		
		СтрокиТовары = Объект.Товары.НайтиСтроки(Новый Структура("КлючСтроки", СтрокаТоварыСкладские.КлючЗапасов));
		Если НЕ СтрокиТовары.Количество() Тогда
			СтрокаТоварыСкладские.КоэффициентПроизводстваУпаковок = СтрокаТоварыСкладские.КоэффициентПроизводства;
			Продолжить;
		КонецЕсли;
		
		СтрокаТовары = СтрокиТовары[0];
		
		КоэффициентУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаТоварыСкладские.Номенклатура, СтрокаТоварыСкладские.Упаковка, КэшированныеЗначенияУпаковок);
		КоэффициентПроизводственнойУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаТовары.Номенклатура, СтрокаТовары.Упаковка, КэшированныеЗначенияУпаковок);
		СтрокаТоварыСкладские.КоэффициентПроизводстваУпаковок = СтрокаТоварыСкладские.КоэффициентПроизводства * КоэффициентУпаковки / КоэффициентПроизводственнойУпаковки;
		
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Подключаемый выполнить команду на сервере.
//
// Параметры:
//  Контекст - Произвольный - Контекст.
