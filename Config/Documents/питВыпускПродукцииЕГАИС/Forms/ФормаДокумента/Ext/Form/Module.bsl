

#Область ПрограммныйИнтерфейс

#Область Статус

//  Процедура - Статус обработки обработка навигационной ссылки завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		 Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;
	
	Если Не Модифицированность И Объект.Проведен Тогда
		ОбработатьНажатиеНавигационнойСсылки(ДополнительныеПараметры.НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Отправка вегаис завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОтправкаВЕГАИС_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Результат Тогда
		ЭтотОбъект.Прочитать();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Документ успешно выгружен.'"));
	ИначеЕсли ДополнительныеПараметры.Свойство("ПроведенПередОтправкой") Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	Если Параметры.Свойство("АвтоТест") Тогда
	
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаПроизводства) Тогда
		Объект.ДатаПроизводства = Объект.Дата;
	КонецЕсли;
	
	Документы.питВыпускПродукцииЕГАИС.УстановитьУсловноеОформлениеСтатусаОбработки(ЭтотОбъект, "СтатусОбработки", "Объект.СтатусОбработки");
	
	ОбновитьПредставленияНаФорме();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда		
		ДоступностьЭлементовФормы();
	КонецЕсли;
	
	ДокОбъект = РеквизитФормыВЗначение("Объект"); 
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ДокОбъект.ДополнительныеСвойства.Свойство("СтрокаОкругленныхАП") Тогда
			СобщениеПользователю = Новый СообщениеПользователю();
			СобщениеПользователю.Текст ="Позиции АП округлены до целых: " + ДокОбъект.ДополнительныеСвойства.СтрокаОкругленныхАП + ".";
			СобщениеПользователю.Сообщить();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ОбновитьПредставленияНаФорме();
	ДоступностьЭлементовФормы();
	
КонецПроцедуры

//  Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ОбновитьПредставленияНаФорме();
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	Если ИмяСобытия = "ИзменениеСостоянияЕГАИС"
		И Параметр.Ссылка = Объект.Ссылка Тогда
		
		Если Параметр.Свойство("ОбъектИзменен")
			И Параметр.ОбъектИзменен Тогда
			ОбновитьПредставленияНаФорме(Истина);
		Иначе
			ОбновитьПредставленияНаФорме(Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ВыполненОбменЕГАИС"
		И (Параметр = Неопределено
		Или (ТипЗнч(Параметр) = Тип("Структура") И Параметр.ОбновлятьСтатусЕГАИСВФормахДокументов)) Тогда
		
		ОбновитьПредставленияНаФорме(Истина);
		
	КонецЕсли;
	
	Если ИмяСобытия = "ПредварительноеСохранениеРезультатовСканированияАлкогольнойПродукции"
		И ТипЗнч(Параметр) = Тип("ДокументСсылка.питВыпускПродукцииЕГАИС")
		И Объект.Ссылка = Параметр
		И Объект.СтатусПроверкиИПодбора <> ПредопределенноеЗначение("Перечисление.СтатусыПроверкиИПодбораИС.Выполняется") Тогда
		
		ОбновитьПредставленияНаФорме(Истина);
		
	КонецЕсли;
	
	ОбщегоНазначенияСобытияФормИСКлиентПереопределяемый.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Статус обработки обработка навигационной ссылки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НавигационнаяСсылкаФорматированнойСтроки - Произвольный - Навигационная ссылка форматированной строки.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура СтатусОбработкиОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОчиститьСообщения();
	
	Если (Не ЗначениеЗаполнено(Объект.Ссылка)) Или (Не Объект.Проведен) Тогда
		
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение",
		                                                    ЭтотОбъект,
		                                                    Новый Структура("НавигационнаяСсылкаФорматированнойСтроки", НавигационнаяСсылкаФорматированнойСтроки));
		ТекстВопроса = НСтр("ru = '""Акт списания ЕГАИС"" не проведен. Провести?';
							|en = '""Акт списания ЕГАИС"" не проведен. Провести?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	ИначеЕсли Модифицированность Тогда
		
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение",
		                                                    ЭтотОбъект,
		                                                    Новый Структура("НавигационнаяСсылкаФорматированнойСтроки", НавигационнаяСсылкаФорматированнойСтроки));
		ТекстВопроса = НСтр("ru = '""Акт списания ЕГАИС"" был изменен. Провести?';
							|en = '""Акт списания ЕГАИС"" был изменен. Провести?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Товары справка б при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСправкаБПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Сырье.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.Справка2) Тогда
			ТекущиеДанные.АлкогольнаяПродукция = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Справка2, "АлкогольнаяПродукция");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Товары выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СырьеАлкогольнаяПродукция" И (Поле.ТолькоПросмотр ИЛИ Элемент.ТолькоПросмотр ИЛИ ЭтаФорма.ТолькоПросмотр) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Ключ", Элемент.ТекущиеДанные.АлкогольнаяПродукция);
		ОткрытьФорму("Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ФормаОбъекта", ПараметрыФормы, Поле,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Поле.Имя = "СырьеСправкаБ" И (Поле.ТолькоПросмотр ИЛИ Элемент.ТолькоПросмотр ИЛИ ЭтаФорма.ТолькоПросмотр) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Ключ", Элемент.ТекущиеДанные.Справка2);
		ОткрытьФорму("Справочник.Справки2ЕГАИС.ФормаОбъекта", ПараметрыФормы, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

//  Процедура - Производство алкогольная продукция при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПроизводствоАлкогольнаяПродукцияПриИзменении(Элемент)
	ТекДанные = Элементы.Производство.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.АлкогольнаяПродукция) Тогда
		ТекДанные.Алкокод = ПолучитьКодАП(ТекДанные.АлкогольнаяПродукция);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Организация егаис при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОрганизацияЕГАИСПриИзменении(Элемент)
	Объект.Производитель = объект.ОрганизацияЕГАИС;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

//  Процедура - Провести и закрыть.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПровестиИЗакрыть(Команда)
	
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Документ.питВыпускПродукцииЕГАИС.Форма.ФормаДокумента.ПровестиИЗакрыть");
	
	ОчиститьСообщения();
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	
	Если Записать(ПараметрыЗаписи) Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Записать документ.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаписатьДокумент(Команда)
	
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Документ.питВыпускПродукцииЕГАИС.Форма.ФормаДокумента.Записать");
	
	ОчиститьСообщения();
	Записать();
	
КонецПроцедуры

//  Процедура - Провести документ.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПровестиДокумент(Команда)
	
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Документ.питВыпускПродукцииЕГАИС.Форма.ФормаДокумента.Провести");
	
	ОчиститьСообщения();
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	Записать(ПараметрыЗаписи);
	
КонецПроцедуры

//  Процедура - Запросить отмену проведения.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗапроситьОтменуПроведения(Команда)
	
	Если Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Документ не сохранен.'"));
		Возврат;
	КонецЕсли;
	
	ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.питЗапросНаОтменуПроведенияОтчетаОПроизводстве");
	
	ОбменДаннымиЕГАИСКлиент.ОтменитьПоследнююОперацию(Объект.Ссылка);

	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
