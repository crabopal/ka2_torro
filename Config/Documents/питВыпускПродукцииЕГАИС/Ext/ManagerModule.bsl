// Возвращает статус по умолчанию.
//
// Возвращаемое значение:
//  Перечисления.СтатусыОбработкиАктаПостановкиНаБалансЕГАИС - Статус по-умолчанию.
Функция СтатусПоУмолчанию() Экспорт
	
	Возврат Перечисления.питСтатусыОбработкиОтчетаОПроизводствеПродукцииЕГАИС.Черновик;
	
КонецФункции

// Возвращает статусы ошибок.
//
// Возвращаемое значение:
//  Массив - Статусы ошибок.
Функция СтатусыОшибок() Экспорт
	
	Статусы = Новый Массив;
	
	Статусы.Добавить(Перечисления.питСтатусыОбработкиОтчетаОПроизводствеПродукцииЕГАИС.ОшибкаПередачи);
	Статусы.Добавить(Перечисления.питСтатусыОбработкиОтчетаОПроизводствеПродукцииЕГАИС.ОшибкаПроведенияЕГАИС);
	Статусы.Добавить(Перечисления.питСтатусыОбработкиОтчетаОПроизводствеПродукцииЕГАИС.ЗапросНаОтменуПроведенияОшибка);
	
	Возврат Статусы;
	
КонецФункции

