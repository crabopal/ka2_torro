				РаботаСXMLЕГАИС.ЗаполнитьСвойствоXDTO(Position, "Comment3", СтрокаТЧ.Комментарий3,          СообщениеXML);
				РаботаСXMLЕГАИС.ЗаполнитьСвойствоXDTO(Position, "Party", СтрокаТЧ.НомерПартии,          СообщениеXML);
				
