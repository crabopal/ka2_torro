			НоваяСтрока.Количество              = СтрокаТЧ.Количество;
			НоваяСтрока.Крепость                = СтрокаТЧ.Крепость;
			НоваяСтрока.НомерПартии             = СтрокаТЧ.НомерПартии;
			НоваяСтрока.Комментарий1            = СтрокаТЧ.Комментарий1;
			НоваяСтрока.Комментарий2            = СтрокаТЧ.Комментарий2;
			НоваяСтрока.Комментарий3            = СтрокаТЧ.Комментарий3;
			
		КонецЦикла;
		
		// ТоварыИтоги.Свернуть("АлкогольнаяПродукция, Справка2, НомерСправки2", "Количество");//, Сумма");
		
		АкцизныеМарки = Новый ТаблицаЗначений;
		// АкцизныеМарки.Колонки.Добавить("Справка2");
		АкцизныеМарки.Колонки.Добавить("КодАкцизнойМарки");
		
		// Для Каждого СтрокаТЧ Из ВложенныеШтрихкодыУпаковок.МаркированныеТовары Цикл
		//	
		// 	Справка2 = Неопределено;
		//	
		// 	НоваяСтрока = АкцизныеМарки.Добавить();
		// 	НоваяСтрока.КодАкцизнойМарки = СтрокаТЧ.ЗначениеШтрихкода;
		//	
		// КонецЦикла;
		
		#КонецОбласти
		
		#Область ОтчетОПроизводсте
		
		Если ФорматОбмена = Перечисления.ФорматыОбменаЕГАИС.V1  Тогда
			
			#Область ФорматОбмена_V12
			
			ДокументXDTO = РаботаСXMLЕГАИС.ОбъектXDTO(ПространствоИмен, "RepProducedType");
			
			РаботаСXMLЕГАИС.ЗаполнитьСвойствоXDTO(ДокументXDTO, "Identity", Шапка.Идентификатор, СообщениеXML, 3);
			
			ДокументXDTO.Header = РаботаСXMLИС.ОбъектXDTOПоИмениТипа(ДокументXDTO, "Header");
			
			Если Шапка.ТипПроизводства = Перечисления.питТипПроизводстваЕГАИС.Переработка Тогда
				ТипПроизводстваСтрокой = "OperConversion";
			ИначеЕсли Шапка.ТипПроизводства = Перечисления.питТипПроизводстваЕГАИС.ПроизводствоСырьяДляСобственногоИспользования Тогда
				ТипПроизводстваСтрокой = "OperMaterials";
