	|			КОГДА ТаблицаРегистра.СрокПолезногоИспользованияБУ <> ТаблицаРегистра.СрокИспользованияДляВычисленияАмортизации
	|				ТОГДА ВЫБОР
	|						КОГДА (ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьРегл, 0) + ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьЦФ, 0)) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ВЫРАЗИТЬ(ТаблицаРегистра.СтоимостьДляВычисленияАмортизации 
	|										* ВтТаблицаОССгруппированная.СтоимостьБУ 
	|											/ (ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьРегл, 0) 
	|												+ ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьЦФ, 0)) КАК ЧИСЛО(31, 2))
	|					КОНЕЦ
	|			ИНАЧЕ ВтТаблицаОССгруппированная.СтоимостьБУ
	|		КОНЕЦ КАК СтоимостьДляВычисленияАмортизации,
	|
	// СтоимостьДляВычисленияАмортизацииЦФ
	|	ТаблицаРегистра.СтоимостьДляВычисленияАмортизацииЦФ
	|		- ВЫБОР 
	|			КОГДА ТаблицаРегистра.СтоимостьДляВычисленияАмортизацииЦФ = 0
	|				ТОГДА 0
	|			КОГДА ТаблицаРегистра.СрокПолезногоИспользованияБУ <> ТаблицаРегистра.СрокИспользованияДляВычисленияАмортизации
	|				ТОГДА ВЫБОР
	|						КОГДА (ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьРегл, 0) + ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьЦФ, 0)) = 0
	|							ТОГДА 0
	|						ИНАЧЕ ВЫРАЗИТЬ(ТаблицаРегистра.СтоимостьДляВычисленияАмортизацииЦФ 
	|										* ВтТаблицаОССгруппированная.СтоимостьБУ 
	|											/ (ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьРегл, 0) 
	|												+ ЕСТЬNULL(ВтСтоимостьВНАСгруппированная.СтоимостьЦФ, 0)) КАК ЧИСЛО(31, 2))
	|					КОНЕЦ
	|			ИНАЧЕ ВтТаблицаОССгруппированная.СтоимостьБУ
	|		КОНЕЦ КАК СтоимостьДляВычисленияАмортизацииЦФ,
	|
	// ПРДляВычисленияАмортизации
	|	ТаблицаРегистра.ПРДляВычисленияАмортизации 
	|		- ВтТаблицаОССгруппированная.СтоимостьПР КАК ПРДляВычисленияАмортизации
	|
	|ИЗ
	|	ДанныеДокументаРеквизиты КАК ДанныеДокумента
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтТаблицаОССгруппированная КАК ВтТаблицаОССгруппированная
	|		ПО ВтТаблицаОССгруппированная.Ссылка = ДанныеДокумента.Ссылка
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСтоимостьВНАСгруппированная КАК ВтСтоимостьВНАСгруппированная
	|		ПО ВтСтоимостьВНАСгруппированная.Ссылка = ДанныеДокумента.Ссылка
	|			И ВтСтоимостьВНАСгруппированная.ОбъектУчета = ДанныеДокумента.ОсновноеСредство
	|
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтПараметрыАмортизацииОСБУ КАК ТаблицаРегистра
	|		ПО ТаблицаРегистра.Ссылка = ДанныеДокумента.Ссылка
	|			И ТаблицаРегистра.ОсновноеСредство = ДанныеДокумента.ОсновноеСредство
	|
	|ГДЕ
	|	ДанныеДокумента.ОтражатьВРеглУчете
	|	И ДанныеДокумента.ХозяйственнаяОперация В (
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РазукомплектацияОСЧастичная),
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыделениеУзловКомпонентовАмортизации))
	|";
	СписокЗапросов.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	ТекстЗапроса = СтрСоединить(СписокЗапросов, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении());

	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра, Истина);
	
КонецПроцедуры

Процедура ТекстЗапросаТаблицаПараметрыАмортизацииОСУУ(Запрос, ТекстыЗапроса, Регистры)

