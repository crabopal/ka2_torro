&НаКлиенте
Процедура ПриИзмененииОтраженияВУчете()
	
	Для каждого ДанныеСтроки Из Объект.НМА Цикл
		ПриИзмененииДанныхВСтроке(ДанныеСтроки, ЭтотОбъект);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеНаОснованииИнвентаризацииЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		ИмяОткрываемойФормы = "Документ.ПринятиеКУчетуНМА2_4.ФормаОбъекта";
			
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		ИмяОткрываемойФормы = "Документ.ПеремещениеНМА2_4.ФормаОбъекта";
			
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		ИмяОткрываемойФормы = "Документ.СписаниеНМА2_4.ФормаОбъекта";
			
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Переоценка") Тогда
		
		ИмяОткрываемойФормы = "Документ.ПереоценкаНМА2_4.ФормаОбъекта";
		
	КонецЕсли; 
	
	ОткрытьФорму(ИмяОткрываемойФормы, Результат.ПараметрыФормы, ЭтотОбъект, ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДокументНаОснованииВСтроке(ДанныеСтроки, ДокументыНаОсновании)
	
	ДанныеСтроки.ДокументНаОснованииБУ = Неопределено;
	ДанныеСтроки.ДокументНаОснованииНУ = Неопределено;
	ДанныеСтроки.ДокументНаОснованииУУ = Неопределено;
	
	СписокДокументов = ДокументыНаОсновании.Получить(ДанныеСтроки.НематериальныйАктив);
	
	Если СписокДокументов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// БУ
	Если ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.ПринятиеКУчету;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.Перемещение;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Переоценка") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.Переоценка;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.Списание;
	
	КонецЕсли; 
	
	// НУ
	Если ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.ПринятиеКУчету;
	
	ИначеЕсли ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.Перемещение;
	
	ИначеЕсли ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.Списание;
	
	КонецЕсли; 
	
	// УУ
	Если ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.ПринятиеКУчету;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.Перемещение;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Переоценка") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.Переоценка;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.Списание;
	
	КонецЕсли; 
	
КонецПроцедуры

