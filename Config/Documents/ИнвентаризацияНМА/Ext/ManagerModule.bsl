// Возвращает данные учета НМА.
//
// Параметры:
//  Параметры - Структура - Параметры операции.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Содержит данные учета: 
//  	* Ключ - СправочникСсылка.НематериальныеАктивы -
//  	* Значение - Структура - 
//
Функция ДанныеУчета(Параметры) Экспорт

	Если Параметры.Свойство("СписокНМА") И Параметры.СписокНМА.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СписокНМА.НематериальныйАктив КАК НематериальныйАктив
	|
	|ПОМЕСТИТЬ СостояниеНМА
	|
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПорядокУчетаНМАУУ.НематериальныйАктив КАК НематериальныйАктив
	|	ИЗ
	|		РегистрСведений.ПорядокУчетаНМАУУ.СрезПоследних(
	|				&Дата,
	|				&ОтражатьВУпрУчете
	|					И Организация = &Организация
	|					И (НЕ &ПоСпискуНМА ИЛИ НематериальныйАктив В (&СписокНМА))) КАК ПорядокУчетаНМАУУ
	|	ГДЕ
	|		ПорядокУчетаНМАУУ.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияНМА.ПринятКУчету) 
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПорядокУчетаНМАБУ.НематериальныйАктив КАК НематериальныйАктив
	|	ИЗ
	|		РегистрСведений.ПорядокУчетаНМАБУ.СрезПоследних(
	|				&Дата,
	|				&ОтражатьВРеглУчете
	|					И Организация = &Организация
	|					И (НЕ &ПоСпискуНМА ИЛИ НематериальныйАктив В (&СписокНМА))) КАК ПорядокУчетаНМАБУ
	|	ГДЕ
	|		(&ОтражатьВБУ
	|				И ПорядокУчетаНМАБУ.СостояниеБУ = ЗНАЧЕНИЕ(Перечисление.СостоянияНМА.ПринятКУчету)
	|			ИЛИ &ОтражатьВНУ
	|				И ПорядокУчетаНМАБУ.СостояниеНУ = ЗНАЧЕНИЕ(Перечисление.СостоянияНМА.ПринятКУчету))
	|
	|	) КАК СписокНМА
	|
	|ГДЕ
	|	СписокНМА.НематериальныйАктив.ВидОбъектаУчета = ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовУчетаНМА.НематериальныйАктив)
	|
	|СГРУППИРОВАТЬ ПО
	|	СписокНМА.НематериальныйАктив
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НематериальныйАктив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МестоУчетаНМА.Организация КАК Организация,
	|	МестоУчетаНМА.Подразделение КАК Подразделение,
	|	МестоУчетаНМА.НематериальныйАктив КАК НематериальныйАктив
	|
	|ПОМЕСТИТЬ СписокНМА
	|
	|ИЗ
	|	РегистрСведений.МестоУчетаНМА.СрезПоследних(
	|		&Дата, 
	|		НематериальныйАктив В
	|				(ВЫБРАТЬ
	|					СостояниеНМА.НематериальныйАктив
	|				ИЗ
	|					СостояниеНМА)) КАК МестоУчетаНМА
	|
	|ГДЕ
	|	(&ПоСпискуНМА
	|		ИЛИ МестоУчетаНМА.Организация = &Организация
	|				И МестоУчетаНМА.Подразделение = &Подразделение)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НематериальныйАктив,
	|	Организация,
	|	Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьНМА.Организация КАК Организация,
	|	СтоимостьНМА.Подразделение КАК Подразделение,
	|	СтоимостьНМА.НематериальныйАктив КАК НематериальныйАктив,
	|	СтоимостьНМА.СтоимостьОстаток КАК СтоимостьПоДаннымУчетаУУ,
	|	СтоимостьНМА.СтоимостьРеглОстаток + СтоимостьНМА.СтоимостьЦФОстаток КАК СтоимостьПоДаннымУчетаБУ,
	|	СтоимостьНМА.СтоимостьНУОстаток КАК СтоимостьПоДаннымУчетаНУ
	|
	|ПОМЕСТИТЬ СтоимостьНМА
	|
	|ИЗ
	|	РегистрНакопления.СтоимостьНМА.Остатки(
	|			&Дата,
	|			(НематериальныйАктив, Организация, Подразделение) В
	|				(ВЫБРАТЬ
	|					СписокНМА.НематериальныйАктив,
	|					СписокНМА.Организация,
	|					СписокНМА.Подразделение
	|				ИЗ
	|					СписокНМА)) КАК СтоимостьНМА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НематериальныйАктив,
	|	Организация,
	|	Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокНМА.НематериальныйАктив КАК НематериальныйАктив,
	|	СписокНМА.Организация КАК Организация,
	|	СписокНМА.Подразделение КАК Подразделение,
	|
	|	ВЫБОР
	|		КОГДА НЕ &ОтражатьВУпрУчете
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(СтоимостьНМА.СтоимостьПоДаннымУчетаУУ, 0)
	|	КОНЕЦ КАК СтоимостьПоДаннымУчетаУУ,
	|
	|	ВЫБОР
	|		КОГДА НЕ &ОтражатьВБУ
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(СтоимостьНМА.СтоимостьПоДаннымУчетаБУ, 0)
	|	КОНЕЦ КАК СтоимостьПоДаннымУчетаБУ,
	|
	|	ВЫБОР
	|		КОГДА НЕ &ОтражатьВНУ
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(СтоимостьНМА.СтоимостьПоДаннымУчетаНУ, 0)
	|	КОНЕЦ КАК СтоимостьПоДаннымУчетаНУ
	|
	|ИЗ
	|	СписокНМА КАК СписокНМА
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтоимостьНМА КАК СтоимостьНМА
	|		ПО (СтоимостьНМА.НематериальныйАктив = СписокНМА.НематериальныйАктив)
	|			И (СтоимостьНМА.Организация = СписокНМА.Организация)
	|			И (СтоимостьНМА.Подразделение = СписокНМА.Подразделение)
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("Подразделение", Параметры.Подразделение);
	Запрос.УстановитьПараметр("СписокНМА", ?(Параметры.Свойство("СписокНМА"), Параметры.СписокНМА, Новый Массив));
	Запрос.УстановитьПараметр("ПоСпискуНМА", ?(Параметры.Свойство("СписокНМА"), Истина, Ложь));
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Параметры.Дата), КонецДня(Параметры.Дата), КонецДня(ТекущаяДатаСеанса())));
	Запрос.УстановитьПараметр("ОтражатьВУпрУчете", Параметры.ОтражатьВУпрУчете);
	Запрос.УстановитьПараметр("ОтражатьВРеглУчете", Параметры.ОтражатьВБУ ИЛИ Параметры.ОтражатьВНУ);
	Запрос.УстановитьПараметр("ОтражатьВБУ", Параметры.ОтражатьВБУ);
	Запрос.УстановитьПараметр("ОтражатьВНУ", Параметры.ОтражатьВНУ);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ТекущиеДанныеУчета = Новый Соответствие;
	
	ВзаимосвязанныеОрганизации = Справочники.Организации.МассивВзаимосвязанныхОрганизаций(Параметры.Организация);

	Пока Выборка.Следующий() Цикл
		
		ДанныеУчета = Новый Структура;
		ДанныеУчета.Вставить("Организация", Выборка.Организация);
		ДанныеУчета.Вставить("Подразделение", Выборка.Подразделение);
		ДанныеУчета.Вставить("СтоимостьПоДаннымУчетаБУ", Выборка.СтоимостьПоДаннымУчетаБУ);
		ДанныеУчета.Вставить("СтоимостьПоДаннымУчетаНУ", Выборка.СтоимостьПоДаннымУчетаНУ);
		ДанныеУчета.Вставить("СтоимостьПоДаннымУчетаУУ", Выборка.СтоимостьПоДаннымУчетаУУ);
		
		Взаимосвязана = (Выборка.Организация = Параметры.Организация ИЛИ ВзаимосвязанныеОрганизации.Найти(Выборка.Организация) <> Неопределено);
		ДанныеУчета.Вставить("Взаимосвязана", Взаимосвязана);
		
		ТекущиеДанныеУчета.Вставить(Выборка.НематериальныйАктив, ДанныеУчета);
	
	КонецЦикла;

	Возврат ТекущиеДанныеУчета;
	
КонецФункции

Функция ЗаполнитьДанныеУчета(Объект, КоллекцияСтрок, ЗаполнитьСлужебныеРеквизиты = Ложь) Экспорт

	СписокНМА = Новый Массив;
	Для каждого ДанныеСтроки Из КоллекцияСтрок Цикл
		СписокНМА.Добавить(ДанныеСтроки.НематериальныйАктив);
	КонецЦикла; 
	
	ПараметрыИнвентаризации = Новый Структура;
	ПараметрыИнвентаризации.Вставить("Организация", Объект.Организация);
	ПараметрыИнвентаризации.Вставить("Подразделение", Объект.Подразделение);
	ПараметрыИнвентаризации.Вставить("Дата", Объект.Дата);
	ПараметрыИнвентаризации.Вставить("СписокНМА", СписокНМА);
	ПараметрыИнвентаризации.Вставить("ОтражатьВУпрУчете", Объект.ОтражатьВУпрУчете);
	ПараметрыИнвентаризации.Вставить("ОтражатьВБУ", Объект.ОтражатьВБУ);
	ПараметрыИнвентаризации.Вставить("ОтражатьВНУ", Объект.ОтражатьВНУ);

	ДанныеУчетаПоСтрокам = ДанныеУчета(ПараметрыИнвентаризации);
	
	Для каждого ДанныеСтроки Из КоллекцияСтрок Цикл
		
		ДанныеУчета = ДанныеУчетаПоСтрокам.Получить(ДанныеСтроки.НематериальныйАктив);
		
		ВнеоборотныеАктивыКлиентСервер.ЗаполнитьДанныеУчетаВСтрокеИнвентаризацииНМА(ДанныеСтроки, ДанныеУчета, ПараметрыИнвентаризации);
		
		ВнеоборотныеАктивыКлиентСервер.ЗаполнитьДействиеНаОснованииИнвентаризацииНМА(ДанныеСтроки, Объект, ДанныеУчета);
		
	КонецЦикла; 

	Возврат ДанныеУчетаПоСтрокам;
	
КонецФункции

#Область Печать

