&НаСервере
Процедура ПодборНаСервере(Знач ВыбранноеЗначение)

	ДобавленныеСтроки = ВнеоборотныеАктивыКлиентСервер.ОбработкаВыбораЭлемента(Объект.ОС, "ОбъектУчета", ВыбранноеЗначение);

	Если ДобавленныеСтроки.Количество() <> 0 Тогда
		ЗаполнитьДанныеУчетаНаСервере(ДобавленныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТабличнуюЧасть(ОписаниеОповещения, ТолькоВыбранныеСтроки)

	ТекстВопроса = Неопределено;
	Если ТолькоВыбранныеСтроки Тогда
		Если Элементы.ОС.ВыделенныеСтроки.Количество() <> 0 Тогда
			ТекстВопроса = НСтр(
				"ru = 'При заполнении существующие данные в выбранных строках будут перезаполнены.
				|Продолжить?'");
		КонецЕсли; 
	ИначеЕсли Объект.ОС.Количество() <> 0 Тогда
		ТекстВопроса = НСтр(
			"ru = 'При заполнении существующие данные будут перезаполнены.
			|Продолжить?'");
	КонецЕсли; 
	
	Если ТекстВопроса <> Неопределено Тогда
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
	
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокКнопок); 
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОстаткамЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект.Организация)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = ЗаполнитьПоОстаткамНаСервере();
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗаполненияПоОстаткам", ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
		
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоОстаткамНаСервере()

	ПараметрыФункции = Новый Структура;
	ПараметрыФункции.Вставить("Организация", Объект.Организация);
	ПараметрыФункции.Вставить("Подразделение", Объект.Подразделение);
	ПараметрыФункции.Вставить("МОЛ", Объект.МОЛ);
	ПараметрыФункции.Вставить("Дата", Объект.Дата);
	ПараметрыФункции.Вставить("ХозяйственнаяОперация", Объект.ХозяйственнаяОперация);
	ПараметрыФункции.Вставить("Организация", Объект.Организация);
	ПараметрыФункции.Вставить("ОтражатьВУпрУчете", Объект.ОтражатьВУпрУчете);
	ПараметрыФункции.Вставить("ОтражатьВБУ", Объект.ОтражатьВБУ);
	ПараметрыФункции.Вставить("ОтражатьВНУ", Объект.ОтражатьВНУ);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения, "Документы.ИнвентаризацияОС.ДанныеУчета", ПараметрыФункции);
	
	Возврат ДлительнаяОперация;

КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатЗаполненияПоОстаткам(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ОбработатьРезультатЗаполненияПоОстаткамНаСервере(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатЗаполненияПоОстаткамНаСервере(Знач Результат)

	Объект.ОС.Очистить();
	
	ПараметрыИнвентаризации = Новый Структура;
	ПараметрыИнвентаризации.Вставить("Организация", Объект.Организация);
	ПараметрыИнвентаризации.Вставить("Подразделение", Объект.Подразделение);
	ПараметрыИнвентаризации.Вставить("МОЛ", Объект.МОЛ);
		
	ТекущиеДанныеУчета = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Для каждого ДанныеУчета Из ТекущиеДанныеУчета Цикл
	
		ДанныеСтроки = Объект.ОС.Добавить();
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, ДанныеУчета);
		
		ВнеоборотныеАктивыКлиентСервер.ЗаполнитьДанныеУчетаВСтрокеИнвентаризацииОС(
			ДанныеСтроки, 
			ДанныеУчета,
			ПараметрыИнвентаризации,
			Ложь,
			Истина,
			СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4);
			
		ПриИзмененииДанныхВСтроке(ДанныеСтроки, ЭтотОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеУчетаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДанныеУчетаЗавершениеНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеУчетаЗавершениеНаСервере()

	ЗаполнитьДанныеУчетаНаСервере(Объект.ОС);
	
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьДанныеУчетаНаСервере(КоллекцияСтрок)

	Документы.ИнвентаризацияОС.ЗаполнитьДанныеУчета(Объект, КоллекцияСтрок, Ложь, Истина);
	
	Для каждого ДанныеСтроки Из Объект.ОС Цикл
		ПриИзмененииДанныхВСтроке(ДанныеСтроки, ЭтотОбъект);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФактическиеДанныеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьФактическиеДанныеНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФактическиеДанныеНаСервере()

	Для каждого ИдентификаторСтроки Из Элементы.ОС.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Объект.ОС.НайтиПоИдентификатору(ИдентификаторСтроки);
		ДанныеСтроки.НаличиеФактическое = ДанныеСтроки.НаличиеПоДаннымУчета;
		ДанныеСтроки.СтоимостьФактическаяБУ = ДанныеСтроки.СтоимостьПоДаннымУчетаБУ;
		ДанныеСтроки.СтоимостьФактическаяНУ = ДанныеСтроки.СтоимостьПоДаннымУчетаНУ;
		ДанныеСтроки.СтоимостьФактическаяУУ = ДанныеСтроки.СтоимостьПоДаннымУчетаУУ;
		
		ПриИзмененииДанныхВСтроке(ДанныеСтроки, ЭтотОбъект);
		
	КонецЦикла; 

КонецПроцедуры

#КонецОбласти

#Область ПриИзмененииРеквизитов

&НаКлиенте
Процедура ХозяйственнаяОперацияПриИзмененииЗавершение(Результат, ОчиститьТЧ) Экспорт

	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Объект.ХозяйственнаяОперация = ЗначенияРеквизитовДоИзменения.ХозяйственнаяОперация;
		Возврат;
	КонецЕсли;
	
	Если ОчиститьТЧ = Истина Тогда
		Объект.ОС.Очистить();
	КонецЕсли;
	
	НастроитьЗависимыеЭлементыФормыНаКлиентеНаСервере(ЭтотОбъект, "ХозяйственнаяОперация");

	Для каждого ДанныеСтроки Из Объект.ОС Цикл
		ПриИзмененииДанныхВСтроке(ДанныеСтроки, ЭтотОбъект);
	КонецЦикла; 

	СохранитьЗначенияРеквизитовДоИзменения(ЭтотОбъект);
	
КонецПроцедуры
 
&НаСервере
Процедура ДатаПриИзмененииНаСервере()

	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ИнвентаризацияНезавершенногоСтроительства 
		И (НЕ СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4
			ИЛИ НЕ СлужебныеПараметрыФормы.ИспользоватьОбъектыСтроительства) Тогда
		
		Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ИнвентаризацияОС;
		Объект.ОС.Очистить();
	КонецЕсли;
	
	Если НЕ СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4
		И (Объект.ОтражатьВУпрУчете
			ИЛИ Объект.ОтражатьВНУ) Тогда
		
		Объект.ОтражатьВБУ = Истина;
		Объект.ОтражатьВУпрУчете = Ложь;
		Объект.ОтражатьВНУ = Ложь;
	КонецЕсли;

	ЗаполнитьДанныеУчетаНаСервере(Объект.ОС);
	
	НастроитьЗависимыеЭлементыФормыНаСервере("Дата,ХозяйственнаяОперация,ОтражатьВУпрУчете,ОтражатьВБУ,ОтражатьВНУ");
	
	СохранитьЗначенияРеквизитовДоИзменения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ЗаполнитьДанныеУчетаНаСервере(Объект.ОС);
	
	НастроитьЗависимыеЭлементыФормыНаСервере("Организация");
	
КонецПроцедуры

&НаСервере
Процедура ПодразделениеПриИзмененииНаСервере()

	ЗаполнитьДанныеУчетаНаСервере(Объект.ОС);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОтраженияВУчете()
	
	Для каждого ДанныеСтроки Из Объект.ОС Цикл
		ПриИзмененииДанныхВСтроке(ДанныеСтроки, ЭтотОбъект);
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура МОЛПриИзмененииНаСервере()

	ЗаполнитьДанныеУчетаНаСервере(Объект.ОС);
	НастроитьЗависимыеЭлементыФормыНаКлиентеНаСервере(ЭтотОбъект, "МОЛ");
	
КонецПроцедуры

&НаСервере
Процедура ОСМОЛПриИзмененииНаСервере()

	ТекущаяСтрока = Элементы.ОС.ТекущаяСтрока;
	ДанныеСтроки = Объект.ОС.НайтиПоИдентификатору(ТекущаяСтрока);
	ЗаполнитьДанныеУчетаНаСервере(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеСтроки));

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСтоимостиВСтроке(ДанныеСтроки)
	
	Если НЕ ДанныеСтроки.НаличиеФактическое
		И (ДанныеСтроки.СтоимостьФактическаяБУ <> 0
				И Объект.ОтражатьВБУ 
			ИЛИ ДанныеСтроки.СтоимостьФактическаяНУ <> 0
				И Объект.ОтражатьВНУ
			ИЛИ ДанныеСтроки.СтоимостьФактическаяУУ <> 0
				И Объект.ОтражатьВУпрУчете) Тогда
		
		ДанныеСтроки.НаличиеФактическое = Истина;
		
	ИначеЕсли ДанныеСтроки.НаличиеФактическое
		И (ДанныеСтроки.СтоимостьФактическаяБУ = 0
			ИЛИ НЕ Объект.ОтражатьВБУ) 
		И (ДанныеСтроки.СтоимостьФактическаяНУ = 0
			ИЛИ НЕ Объект.ОтражатьВНУ)
		И (ДанныеСтроки.СтоимостьФактическаяУУ = 0
			ИЛИ НЕ Объект.ОтражатьВУпрУчете) Тогда
		
		ДанныеСтроки.НаличиеФактическое = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииДанныхВСтроке(ДанныеСтроки, Форма)

	Объект = Форма.Объект;
	
	ВнеоборотныеАктивыКлиентСервер.ЗаполнитьДействиеНаОснованииИнвентаризацииОС(
		ДанныеСтроки, 
		Объект,
		Форма.СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4);
		
	ЗаполнитьДокументНаОснованииВСтроке(ДанныеСтроки, Форма.ДокументыНаОсновании);
	
	ВнеоборотныеАктивыКлиентСервер.ЗаполнитьПредставлениеДействия(ДанныеСтроки, Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СохранитьЗначенияРеквизитовДоИзменения(Форма)

	НовыеЗначенияРеквизитовДоИзменения = Новый Структура("ХозяйственнаяОперация,Дата");
	ЗаполнитьЗначенияСвойств(НовыеЗначенияРеквизитовДоИзменения, Форма.Объект);
	
	Форма.ЗначенияРеквизитовДоИзменения = Новый ФиксированнаяСтруктура(НовыеЗначенияРеквизитовДоИзменения);

КонецПроцедуры

#КонецОбласти

#Область СозданиеНаОсновании

&НаСервере
Процедура НайтиДокументыНаОсновании()

	Если СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4 Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету) КАК Действие,
		|	ДанныеДокумента.Ссылка КАК Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство КАК ОбъектУчета
		|ИЗ
		|	Документ.ПринятиеКУчетуОС2_4 КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПринятиеКУчетуОС2_4.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.Перемещение),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|ИЗ
		|	Документ.ПеремещениеОС2_4 КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеОС2_4.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.Переоценка),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|ИЗ
		|	Документ.ПереоценкаОС2_4 КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереоценкаОС2_4.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.Списание),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|ИЗ
		|	Документ.СписаниеОС2_4 КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеОС2_4.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.ВыбытиеАрендованныхОС),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|ИЗ
		|	Документ.ВыбытиеАрендованныхОС КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыбытиеАрендованныхОС.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.ПрекращениеДоговораАренды),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|ИЗ
		|	Документ.ПрекращениеДоговораАренды КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПрекращениеДоговораАренды.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|";
		
	Иначе
		
		//++ Локализация
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету) КАК Действие,
		|	ДанныеДокумента.Ссылка КАК Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство КАК ОбъектУчета
		|ИЗ
		|	Документ.ПринятиеКУчетуОС КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПринятиеКУчетуОС.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.Перемещение),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|ИЗ
		|	Документ.ПеремещениеОС КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеОС.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.Списание),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|ИЗ
		|	Документ.СписаниеОС КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеОС.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ДействияНаОснованииИнвентаризации.ВыбытиеАрендованныхОС),
		|	ДанныеДокумента.Ссылка,
		|	ТабличнаяЧасть.ОсновноеСредство
		|
		|ИЗ
		|	Документ.ВыбытиеАрендованныхОС КАК ДанныеДокумента
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыбытиеАрендованныхОС.ОС КАК ТабличнаяЧасть
		|		ПО (ТабличнаяЧасть.Ссылка = ДанныеДокумента.Ссылка)
		|
		|ГДЕ
		|	ДанныеДокумента.Проведен
		|	И ДанныеДокумента.ДокументОснование = &ДокументОснование
		|	И ДанныеДокумента.ДокументНаОсновании";
		
		//-- Локализация
		
	КонецЕсли; 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	СоответствиеДокументов = Новый Соответствие;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СписокДокументов = СоответствиеДокументов.Получить(Выборка.ОбъектУчета);
		
		Если СписокДокументов = Неопределено Тогда
			СписокДокументов = Новый Структура;
			СписокДокументов.Вставить("ПринятиеКУчету", Неопределено);
			СписокДокументов.Вставить("Перемещение", Неопределено);
			СписокДокументов.Вставить("Переоценка", Неопределено);
			СписокДокументов.Вставить("Списание", Неопределено);
			СписокДокументов.Вставить("ВыбытиеАрендованныхОС", Неопределено);
			СписокДокументов.Вставить("ПрекращениеДоговораАренды", Неопределено);
		КонецЕсли;
		
		Если Выборка.Действие = Перечисления.ДействияНаОснованииИнвентаризации.ПринятиеКУчету Тогда
			СписокДокументов.ПринятиеКУчету = Выборка.Ссылка;
		ИначеЕсли Выборка.Действие = Перечисления.ДействияНаОснованииИнвентаризации.Перемещение Тогда
			СписокДокументов.Перемещение = Выборка.Ссылка;
		ИначеЕсли Выборка.Действие = Перечисления.ДействияНаОснованииИнвентаризации.Списание Тогда
			СписокДокументов.Списание = Выборка.Ссылка;
		ИначеЕсли Выборка.Действие = Перечисления.ДействияНаОснованииИнвентаризации.ВыбытиеАрендованныхОС Тогда
			СписокДокументов.ВыбытиеАрендованныхОС = Выборка.Ссылка;
		ИначеЕсли Выборка.Действие = Перечисления.ДействияНаОснованииИнвентаризации.Переоценка Тогда
			СписокДокументов.Переоценка = Выборка.Ссылка;
		ИначеЕсли Выборка.Действие = Перечисления.ДействияНаОснованииИнвентаризации.ПрекращениеДоговораАренды Тогда
			СписокДокументов.ПрекращениеДоговораАренды = Выборка.Ссылка;
		КонецЕсли; 
		
		СоответствиеДокументов.Вставить(Выборка.ОбъектУчета, СписокДокументов);
	
	КонецЦикла;
	
	ДокументыНаОсновании = Новый ФиксированноеСоответствие(СоответствиеДокументов);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиДокументаСозданногоНаОсновании()

	НайтиДокументыНаОсновании();
	ЗаполнитьСлужебныеРеквизитыТЧ();

КонецПроцедуры

#КонецОбласти

#Область ШтрихкодыИТорговоеОборудование

&НаСервере
Процедура ОбработатьШтрихкоды(Знач ДанныеШтрихкодов)
	
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ИнвентаризацияНезавершенногоСтроительства
		И СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4 Тогда		
		Возврат; // Объекты строительства не поддерживают штрих-коды.
	КонецЕсли;
	
	ПараметрыПодбора = ОбщегоНазначенияУТКлиентСервер.ПараметрыПодбора(Элементы.ОСОбъектУчета, ЭтотОбъект);
	МассивОбъектов = ВнеоборотныеАктивы.НайтиОсновныеСредстваПоШтрихкодам(ДанныеШтрихкодов, ПараметрыПодбора);
	
	ДобавленныеСтроки = ВнеоборотныеАктивыКлиентСервер.ОбработкаВыбораЭлемента(Объект.ОС, "ОбъектУчета", МассивОбъектов);
	
	Если ДобавленныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДанныеУчетаНаСервере(ДобавленныеСтроки);
	
	Для каждого ДанныеСтроки Из ДобавленныеСтроки Цикл
		ДанныеСтроки.НаличиеФактическое = Истина;
		ПриИзмененииНаличиеФактическое(ДанныеСтроки, ЭтотОбъект);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗагрузкуДанныеИзТСД()
	
	ОчиститьСообщения();
	
	МенеджерОборудованияКлиент.НачатьЗагрузкуДанныеИзТСД(
		Новый ОписаниеОповещения("ЗагрузитьИзТСДЗавершение", ЭтотОбъект),
		УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзТСДЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Результат Тогда
		ОбработатьШтрихкоды(Результат.ТаблицаТоваров);
	Иначе
		МенеджерОборудованияУТКлиент.СообщитьОбОшибке(Результат);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
			
	#Область ОСДействиеПредставление_ЦветТекста
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОСДействиеПредставление.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОС.ДействиеПредставление");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	#КонецОбласти
			
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	НастроитьЗависимыеЭлементыФормыНаСервере();
	
	СохранитьЗначенияРеквизитовДоИзменения(ЭтотОбъект);
	
	НайтиДокументыНаОсновании();
	
	ЗаполнитьСлужебныеРеквизитыТЧ();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыТЧ()
	
	Документы.ИнвентаризацияОС.ЗаполнитьДанныеУчета(Объект, Объект.ОС, Истина, Истина);
	
	Для каждого ДанныеСтроки Из Объект.ОС Цикл
		ЗаполнитьДокументНаОснованииВСтроке(ДанныеСтроки, ДокументыНаОсновании);
		ВнеоборотныеАктивыКлиентСервер.ЗаполнитьПредставлениеДействия(ДанныеСтроки, ЭтотОбъект);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗависимыеЭлементыФормыНаКлиентеНаСервере(Форма, ИзмененныеРеквизиты = "")

	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	СлужебныеПараметрыФормы = Форма.СлужебныеПараметрыФормы;

	СтруктураИзмененныхРеквизитов = Новый Структура(ИзмененныеРеквизиты);
	
	ОбновитьВсе = СтруктураИзмененныхРеквизитов.Количество() = 0;
	
	ПараметрыРеквизитовОбъекта = ВнеоборотныеАктивыКлиентСервер.ЗначенияСвойствЗависимыхРеквизитов_ИнвентаризацияОС(
									Объект, ИзмененныеРеквизиты);
	ОбщегоНазначенияУТКлиентСервер.НастроитьЗависимыеЭлементыФормы(Форма, ПараметрыРеквизитовОбъекта);
	
	Если ОбновитьВсе Тогда
			
		ВалютаУпрПредставление = СлужебныеПараметрыФормы.ВалютаУпрПредставление;
		
		Элементы.ИтогСтоимостьФактическаяУУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'УУ'"), ВалютаУпрПредставление);
			
		Элементы.ИтогСтоимостьПоДаннымУчетаУУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'УУ'"), ВалютаУпрПредставление);
			
		Элементы.ОССтоимостьФактическаяУУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'Стоимость (УУ)'"), ВалютаУпрПредставление);
			
		Элементы.ОССтоимостьПоДаннымУчетаУУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'Стоимость (УУ)'"), ВалютаУпрПредставление);
			
	КонецЕсли;
	
	Если СтруктураИзмененныхРеквизитов.Свойство("Дата")
		ИЛИ ОбновитьВсе Тогда
		
		ВнеоборотныеАктивыКлиентСервер.УстановитьВидимостьЗначенияСпискаВыбора(
			Элементы.ХозяйственнаяОперация.СписокВыбора,
			СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4 И СлужебныеПараметрыФормы.ИспользоватьОбъектыСтроительства,
			ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ИнвентаризацияНезавершенногоСтроительства"));
			
		Элементы.ОтражатьВУпрУчете.ТолькоПросмотр = НЕ СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4;
		Элементы.ОтражатьВНУ.ТолькоПросмотр = НЕ СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4;
		
	КонецЕсли;
	
	Если СтруктураИзмененныхРеквизитов.Свойство("ХозяйственнаяОперация")
		ИЛИ ОбновитьВсе Тогда
		
		ЭтоИнвентаризацияСтроительства = 
			Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ИнвентаризацияНезавершенногоСтроительства");
		
		Элементы.ОСОбъектУчета.ОграничениеТипа = 
			?(ЭтоИнвентаризацияСтроительства И СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4, 
				Новый ОписаниеТипов("СправочникСсылка.ОбъектыСтроительства"),
				Новый ОписаниеТипов("СправочникСсылка.ОбъектыЭксплуатации"));
		
		Элементы.ОСИнвентарныйНомер.Видимость = НЕ ЭтоИнвентаризацияСтроительства ИЛИ НЕ СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4;
		Элементы.ОСКод.Видимость = НЕ ЭтоИнвентаризацияСтроительства ИЛИ НЕ СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4;
		
		Элементы.ОСОбъектУчета.Заголовок = 
			?(ЭтоИнвентаризацияСтроительства, НСтр("ru = 'Объект строительства'"), НСтр("ru = 'Основное средство'"));
			
		Элементы.СтраницаОсновныеСредства.Заголовок = 
			?(ЭтоИнвентаризацияСтроительства, НСтр("ru = 'Объекты строительства'"), НСтр("ru = 'Основные средства'"));
		
		ПараметрыВыбораОС = Новый Массив;
		
		Если Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ИнвентаризацияВложенийВОС")
			ИЛИ Объект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ИнвентаризацияНезавершенногоСтроительства") Тогда
			
			Элементы.ГруппаИтогиСтоимостьПоДаннымУчета.Заголовок = НСтр("ru = 'Затраты по данным учета'");
			Элементы.ГруппаИтогиСтоимостьФактическая.Заголовок = НСтр("ru = 'Затраты фактические'");
			Элементы.ОСГруппаПоДаннымУчета.Подсказка = НСтр("ru = 'Затраты по данным учета'");
			Элементы.ОСГруппаФактическое.Подсказка = НСтр("ru = 'Затраты фактические'");
		
		Иначе
			
			Элементы.ГруппаИтогиСтоимостьПоДаннымУчета.Заголовок = НСтр("ru = 'Стоимость по данным учета'");
			Элементы.ГруппаИтогиСтоимостьФактическая.Заголовок = НСтр("ru = 'Стоимость фактическая'");
			Элементы.ОСГруппаПоДаннымУчета.Подсказка = НСтр("ru = 'По данным учета'");
			Элементы.ОСГруппаФактическое.Подсказка = НСтр("ru = 'Фактическое наличие'");
			
			ПараметрВыбора = Новый ПараметрВыбора("Контекст", "БУ,УУ");
			ПараметрыВыбораОС.Добавить(ПараметрВыбора);
			
			МассивТиповОС = Новый Массив;
			МассивТиповОС.Добавить(ПредопределенноеЗначение("Перечисление.ТипыОС.ОбъектЭксплуатации"));
			МассивТиповОС.Добавить(ПредопределенноеЗначение("Перечисление.ТипыОС.КапитальноеВложение"));
			ПараметрВыбора = Новый ПараметрВыбора("Отбор.ТипОС", Новый ФиксированныйМассив(МассивТиповОС));
			ПараметрыВыбораОС.Добавить(ПараметрВыбора);
			
		КонецЕсли; 
		
		Элементы.ОСОбъектУчета.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораОС);
		
		Элементы.ОСЗагрузитьДанныеИзТСД.Видимость = НЕ ЭтоИнвентаризацияСтроительства ИЛИ НЕ СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4;
		
	КонецЕсли;
	
	Если СтруктураИзмененныхРеквизитов.Свойство("Организация")
		ИЛИ ОбновитьВсе Тогда
		
		ВалютаРеглПредставление = СлужебныеПараметрыФормы.ВалютаРеглПредставление;
		
		Элементы.ИтогСтоимостьФактическаяБУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'БУ'"), ВалютаРеглПредставление);
			
		Элементы.ИтогСтоимостьФактическаяНУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'НУ'"), ВалютаРеглПредставление);
			
		Элементы.ИтогСтоимостьПоДаннымУчетаБУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'БУ'"), ВалютаРеглПредставление);
			
		Элементы.ИтогСтоимостьПоДаннымУчетаНУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'НУ'"), ВалютаРеглПредставление);
			
		Элементы.ОССтоимостьФактическаяБУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'Стоимость (БУ)'"), ВалютаРеглПредставление);
			
		Элементы.ОССтоимостьПоДаннымУчетаБУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'Стоимость (БУ)'"), ВалютаРеглПредставление);
			
		Элементы.ОССтоимостьФактическаяНУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'Стоимость (НУ)'"), ВалютаРеглПредставление);
			
		Элементы.ОССтоимостьПоДаннымУчетаНУ.Заголовок = 
			ВнеоборотныеАктивыКлиентСервер.ДобавитьКСтрокеВалюту(НСтр("ru = 'Стоимость (НУ)'"), ВалютаРеглПредставление);
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЗависимыеЭлементыФормыНаСервере(ИзмененныеРеквизиты = "")
	
	СтруктураИзмененныхРеквизитов = Новый Структура(ИзмененныеРеквизиты);
	
	ОбновитьВсе = СтруктураИзмененныхРеквизитов.Количество() = 0;
	
	Если ОбновитьВсе Тогда
			
		ВнеоборотныеАктивыСлужебный.УстановитьСвойствоСтруктуры(
			"ИспользоватьОбъектыСтроительства", ПолучитьФункциональнуюОпцию("ИспользоватьОбъектыСтроительства"), СлужебныеПараметрыФормы);
		
		ВнеоборотныеАктивыСлужебный.УстановитьСвойствоСтруктуры(
			"ВалютаУпр",
			Константы.ВалютаУправленческогоУчета.Получить(),
			СлужебныеПараметрыФормы);
			
		ВнеоборотныеАктивыСлужебный.УстановитьСвойствоСтруктуры(
			"ВалютаУпрПредставление",
			Строка(СлужебныеПараметрыФормы.ВалютаУпр),
			СлужебныеПараметрыФормы);
			
	КонецЕсли;
	
	Если СтруктураИзмененныхРеквизитов.Свойство("Дата")
		ИЛИ ОбновитьВсе Тогда
			
		ВнеоборотныеАктивыСлужебный.УстановитьСвойствоСтруктуры(
			"ИспользуетсяУправлениеВНА_2_4", ВнеоборотныеАктивы.ИспользуетсяУправлениеВНА_2_4(Объект.Дата), СлужебныеПараметрыФормы);
		
	КонецЕсли;
	
	Если СтруктураИзмененныхРеквизитов.Свойство("Организация")
		ИЛИ ОбновитьВсе Тогда
		
		ВнеоборотныеАктивыСлужебный.УстановитьСвойствоСтруктуры(
			"ВалютаРегл",
			ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(Объект.Организация),
			СлужебныеПараметрыФормы);
			
		ВнеоборотныеАктивыСлужебный.УстановитьСвойствоСтруктуры(
			"ВалютаРеглПредставление",
			Строка(СлужебныеПараметрыФормы.ВалютаРегл),
			СлужебныеПараметрыФормы);
			
	КонецЕсли;

	НастроитьЗависимыеЭлементыФормыНаКлиентеНаСервере(ЭтотОбъект, ИзмененныеРеквизиты);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеУчета(Знач ПараметрыИнвентаризации)

	ДанныеУчетаПоСтрокам = Документы.ИнвентаризацияОС.ДанныеУчета(ПараметрыИнвентаризации);
								
	ДанныеУчета = ДанныеУчетаПоСтрокам.Найти(ПараметрыИнвентаризации.СписокОС[0], "ОбъектУчета");
	
	Если ДанныеУчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущиеДанныеУчета = Новый Структура("ОрганизацияПоДаннымУчета,ПодразделениеПоДаннымУчета,МОЛПоДаннымУчета,
	|ОрганизацииВзаимосвязаны,ПолученоВАренду,Договор,НаличиеПоДаннымУчета,
	|СтоимостьПоДаннымУчетаБУ,СтоимостьПоДаннымУчетаНУ,СтоимостьПоДаннымУчетаУУ,
	|ИнвентарныйНомер,Код,ХозяйственнаяОперация");

	ЗаполнитьЗначенияСвойств(ТекущиеДанныеУчета, ДанныеУчета);
	
	Возврат ТекущиеДанныеУчета;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииНаличиеФактическое(ДанныеСтроки, Форма)
	
	Объект = Форма.Объект;
	
	Если ДанныеСтроки.НаличиеФактическое Тогда
		
		Если ДанныеСтроки.СтоимостьФактическаяБУ = 0
			И Объект.ОтражатьВБУ Тогда
			ДанныеСтроки.СтоимостьФактическаяБУ = ДанныеСтроки.СтоимостьПоДаннымУчетаБУ;
		КонецЕсли;
		
		Если ДанныеСтроки.СтоимостьФактическаяНУ = 0
			И Объект.ОтражатьВНУ Тогда
			ДанныеСтроки.СтоимостьФактическаяНУ = ДанныеСтроки.СтоимостьПоДаннымУчетаНУ;
		КонецЕсли;
		
		Если ДанныеСтроки.СтоимостьФактическаяУУ = 0
			И Объект.ОтражатьВУпрУчете Тогда
			ДанныеСтроки.СтоимостьФактическаяУУ = ДанныеСтроки.СтоимостьПоДаннымУчетаУУ;
		КонецЕсли;
		
	Иначе
		
		ДанныеСтроки.СтоимостьФактическаяБУ = 0;
		ДанныеСтроки.СтоимостьФактическаяНУ = 0;
		ДанныеСтроки.СтоимостьФактическаяУУ = 0;
		
	КонецЕсли; 
	
	ПриИзмененииДанныхВСтроке(ДанныеСтроки, Форма);

КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДокументНаОснованииВСтроке(ДанныеСтроки, ДокументыНаОсновании)
	
	ДанныеСтроки.ДокументНаОснованииБУ = Неопределено;
	ДанныеСтроки.ДокументНаОснованииНУ = Неопределено;
	ДанныеСтроки.ДокументНаОснованииУУ = Неопределено;
	
	СписокДокументов = ДокументыНаОсновании.Получить(ДанныеСтроки.ОбъектУчета);
	
	Если СписокДокументов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// БУ
	Если ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.ПринятиеКУчету;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.Перемещение;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Переоценка") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.Переоценка;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.Списание;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ВыбытиеАрендованныхОС") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.ВыбытиеАрендованныхОС;
	
	ИначеЕсли ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПрекращениеДоговораАренды") Тогда
		
		ДанныеСтроки.ДокументНаОснованииБУ = СписокДокументов.ПрекращениеДоговораАренды;
	
	КонецЕсли; 
	
	// НУ
	Если ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.ПринятиеКУчету;
	
	ИначеЕсли ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.Перемещение;
	
	ИначеЕсли ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.Списание;
	
	ИначеЕсли ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ВыбытиеАрендованныхОС") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.ВыбытиеАрендованныхОС;
	
	ИначеЕсли ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПрекращениеДоговораАренды") Тогда
		
		ДанныеСтроки.ДокументНаОснованииНУ = СписокДокументов.ПрекращениеДоговораАренды;
	
	КонецЕсли; 
	
	// УУ
	Если ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.ПринятиеКУчету;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.Перемещение;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Переоценка") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.Переоценка;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.Списание;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ВыбытиеАрендованныхОС") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.ВыбытиеАрендованныхОС;
	
	ИначеЕсли ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПрекращениеДоговораАренды") Тогда
		
		ДанныеСтроки.ДокументНаОснованииУУ = СписокДокументов.ПрекращениеДоговораАренды;
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеНаОснованииИнвентаризацииЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету") Тогда
		
		Если СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4 Тогда
			
			ИмяОткрываемойФормы = "Документ.ПринятиеКУчетуОС2_4.ФормаОбъекта";
				
		Иначе
			
			//++ Локализация
			ИмяОткрываемойФормы = "Документ.ПринятиеКУчетуОС.ФормаОбъекта";
			//-- Локализация
			
		КонецЕсли;
			
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение") Тогда
		
		Если СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4 Тогда
			
			ИмяОткрываемойФормы = "Документ.ПеремещениеОС2_4.ФормаОбъекта";
				
		Иначе
			
			//++ Локализация
			ИмяОткрываемойФормы = "Документ.ПеремещениеОС.ФормаОбъекта";
			//-- Локализация
			
		КонецЕсли;
			
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание") Тогда
		
		Если СлужебныеПараметрыФормы.ИспользуетсяУправлениеВНА_2_4 Тогда
			
			ИмяОткрываемойФормы = "Документ.СписаниеОС2_4.ФормаОбъекта";
				
		Иначе
			
			//++ Локализация
			ИмяОткрываемойФормы = "Документ.СписаниеОС.ФормаОбъекта";
			//-- Локализация
			
		КонецЕсли;
			
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ВыбытиеАрендованныхОС") Тогда
		
		ИмяОткрываемойФормы = "Документ.ВыбытиеАрендованныхОС.ФормаОбъекта";
		
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПрекращениеДоговораАренды") Тогда
		
		ИмяОткрываемойФормы = "Документ.ПрекращениеДоговораАренды.ФормаОбъекта";
		
	ИначеЕсли Результат.Действие = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Переоценка") Тогда
		
		ИмяОткрываемойФормы = "Документ.ПереоценкаОС2_4.ФормаОбъекта";
		
	КонецЕсли; 
	
	ОткрытьФорму(ИмяОткрываемойФормы, Результат.ПараметрыФормы, ЭтотОбъект, ЭтотОбъект);

КонецПроцедуры

