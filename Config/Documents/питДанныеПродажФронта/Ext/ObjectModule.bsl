// ОБРАБОТЧИКИ СОБЫТИЙ

// Процедура - обработчик события "ОбработкаЗаполнения".
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения)
	
	// СуммаВключаетНДС = Истина;
	//
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированныйУчетПодсистемы") Тогда
		МодульЗаполнениеДокументов = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеДокументов");
		МодульЗаполнениеДокументов.Заполнить(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры
// ОбработкаЗаполнения()
//
// Параметры:
//  ОбъектКопирования - Произвольный - Объект копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	Дата = НачалоДня(ОбщегоНазначения.ТекущаяДатаПользователя());
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

// Процедура вызывается перед записью документа
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ДополнительныеСвойства.Свойство("РежимОбновленияИБ") Тогда
		Возврат;
	КонецЕсли;
	
	// Выполняем всегда
	Документы.питДанныеПродажФронта.ЗаполнитьНедостающиеИдентификаторыСтрок(ЭтотОбъект);
	
	// Выполним расчет бонусов.
	Если ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаПродажа Тогда
		питСкидкиНаценкиСервер.РассчитатьБонусыПоЧекуОбщепита(ЭтотОбъект, НачислениеБонусныхБаллов);
	КонецЕсли;
	
	// Посчитать суммы документа и записать ее в соответствующий реквизит шапки для показа в журналах.
	РасчетСуммДокумента();
	Если ОбменДанными.Загрузка ИЛИ (ДополнительныеСвойства.Свойство("Загрузка") И ДополнительныеСвойства.Загрузка) Тогда
		Возврат;
	КонецЕсли;
	
	Заголовок = "Сохранение документа: " + СокрЛП(ЭтотОбъект)+"";
	ПроверитьЗаполнениеШапки(Отказ, Заголовок);
	
	ПроверитьЗаполнениеТабличнойЧастиТовары(Отказ, Заголовок);
	
	ПроверитьЗаполнениеТабличнойЧастиОплаты(Отказ, Заголовок);
	
	ПроверитьЗаполнениеТабличнойЧастиМодификаторы(Отказ, Заголовок);
	
	ПроверитьКорректностьСуммОплат(Отказ, Заголовок);
	
	// +Серии
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект,Документы.питДанныеПродажФронта);
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект, ПараметрыУказанияСерий.Товары);
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект, ПараметрыУказанияСерий.Модификаторы);
	// -Серии
	
КонецПроцедуры

// Процедура вызывается при записи документа
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПриЗаписи(Отказ)
	
	Если ДополнительныеСвойства.Свойство("РежимОбновленияИБ") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка 
		ИЛИ (ДополнительныеСвойства.Свойство("Загрузка") 
			И ДополнительныеСвойства.Загрузка)
		ИЛИ (ДополнительныеСвойства.Свойство("АвтоПроведение") 
			И ДополнительныеСвойства.АвтоПроведение) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПометкаУдаления Тогда
		
		УдалитьДанныеРегистраУчетДанныхПродаж();
		
		Если НЕ Отказ Тогда
			УдалитьЗаписиВРегистреПродажПоЧекам(Отказ);
		КонецЕсли;
		
		Если НЕ Отказ Тогда
			УдалитьЗаписиВРегистреОплатПоЧекам(Отказ);
		КонецЕсли;
		
		Если НЕ Отказ Тогда
			УдалитьЗаписиВРегистреПродажМодификаторовПоЧекам(Отказ);
		КонецЕсли;
		
	Иначе
		
		ОбновитьДанныеРегистраУчетДанныхПродаж();
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обработка проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Выполним проверку возможности проведения
	Если НЕ Константы.питВыполнятьПроведениеЧековОбщепита.Получить() Тогда
		Отказ= Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для проведения документа необходимо включить константу <Выполнять проведения чеков Общепита>'", "ru"));
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ГосИС") Тогда
		СтруктураДополнительныеСвойства = Новый Структура;
		СтруктураДополнительныеСвойства.Вставить("ТаблицыДляДвижений", Новый Структура);
		Документы.питДанныеПродажФронта.ИнициализироватьДанныеДокумента(ЭтотОбъект.Ссылка, СтруктураДополнительныеСвойства);
		
		Для каждого КлючИЗначение Из СтруктураДополнительныеСвойства.ТаблицыДляДвижений Цикл
			ДвжиенияРегистр = Движения[КлючИЗначение.Ключ];
			ДвжиенияРегистр.Записывать = Истина;
			ДвжиенияРегистр.Загрузить(КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("АвтоПроведение") 
		И ДополнительныеСвойства.АвтоПроведение Тогда
		Возврат;
	КонецЕсли;
	
	ТЗТовары = Неопределено;
	ТЗОплаты = Неопределено;
	ТЗМодификаторы = Неопределено;
	
	ПодготовитьТЧКЗаписиВРегистрПродажИОплатПоЧекам(ТЗТовары, ТЗОплаты, ТЗМодификаторы);
	
	// Сформируем записи по регистрам.
	Если НЕ Отказ Тогда
		СформироватьЗаписиВРегистреПродажПоЧекам(Отказ, ТЗТовары);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		СформироватьЗаписиВРегистреОплатПоЧекам(Отказ, ТЗОплаты);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		СформироватьЗаписиВРегистреПродажМодификаторовПоЧекам(Отказ, ТЗМодификаторы);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обработка удаления проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если НЕ Отказ Тогда
		УдалитьЗаписиВРегистреПродажПоЧекам(Отказ);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		УдалитьЗаписиВРегистреОплатПоЧекам(Отказ);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		УдалитьЗаписиВРегистреПродажМодификаторовПоЧекам(Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
// Производит удаление данных регистра "Учет данных продаж"
//
Процедура УдалитьДанныеРегистраУчетДанныхПродаж()
	
	// Поиск записей в регистре "Данные продаж фронта"
	НаборЗаписейДанныеПродажФронта = РегистрыСведений.питУчетДанныхПродаж.СоздатьНаборЗаписей();
	НаборЗаписейДанныеПродажФронта.Отбор.ДокументРегистратор.Установить(Ссылка);
	НаборЗаписейДанныеПродажФронта.Прочитать();
	
	Если НаборЗаписейДанныеПродажФронта.Количество() > 0 Тогда
		НаборЗаписейДанныеПродажФронта.Очистить();
		НаборЗаписейДанныеПродажФронта.Записать();
	КонецЕсли;
	
КонецПроцедуры // УдалитьДанныеРегистраУчетДанныхПродаж()

// Проверяет правильность заполнения шапки документа.
//  Если какой-то из реквизитов шапки, влияющий на проведение не заполнен или
//  заполнен не корректно, то выставляется флаг отказа в проведении.
//  Проверяется также правильность заполнения реквизитов ссылочных полей документа.
//  Проверка выполняется по объекту и по выборке из результата запроса по шапке.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  Заголовок - Произвольный - Заголовок.
//
Процедура ПроверитьЗаполнениеШапки(Отказ, Заголовок)
	
	// Укажем, что надо проверить:
	СтруктураОбязательныхПолей = Новый Структура("Организация");
	
	// Теперь вызовем общую процедуру проверки.
	// ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры // ПроверитьЗаполнениеШапки()

// Проверяет правильность заполнения строк табличной части "Товары".
//
// Параметры:
//  Отказ - Булево - Отказ.
//  Заголовок - Произвольный - Заголовок.
//
Процедура ПроверитьЗаполнениеТабличнойЧастиТовары(Отказ, Заголовок)
	
	Для каждого ТекСтрока Из Товары Цикл
		СтрокаНачалаСообщенияОбОшибке =  "Строка номер "+ СокрЛП(ТекСтрока.НомерСтроки) +
		                             	" табличной части ""Товары"": ";
		Если ТекСтрока.Номенклатура.Пустая() Тогда
			СтрокаСообщения = "Не заполнено значение реквизитов ""Номенклатура"".";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
		КонецЕсли;
		Если НЕ ТекСтрока.Номенклатура.Пустая() И ТекСтрока.Количество = 0 Тогда
			СтрокаСообщения = "Не заполнено значение реквизита ""Количество"".";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
		КонецЕсли;
		// Если НЕ ТекСтрока.Номенклатура.Пустая() И НЕ ЗначениеЗаполнено(ТекСтрока.СтавкаНДС) И УчитыватьНДС Тогда
		// Если НЕ ТекСтрока.Номенклатура.Пустая() И НЕ ЗначениеЗаполнено(ТекСтрока.СтавкаНДС) Тогда
		// 	СтрокаСообщения = "Не заполнено значение реквизита ""Ставка НДС"".";
		// 	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
		// КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

// ПроверитьЗаполнениеТабличнойЧастиТовары()
//
// Параметры:
//  Отказ - Булево - Отказ.
//  Заголовок - Произвольный - Заголовок.
//
Процедура ПроверитьЗаполнениеТабличнойЧастиОплаты(Отказ, Заголовок)
	
	// Укажем, что надо проверить:
	СтруктураОбязательныхПолей = Новый Структура("ВидОплаты");
	
	// В пите добавились типы оплат
	Для Каждого СтрокаТЧ Из Оплаты Цикл
		
		СтрокаНачалаСообщенияОбОшибке = "В строке номер """+ СокрЛП(СтрокаТЧ.НомерСтроки) + """ табличной части ""Оплаты"": ";
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ВидОплаты) Тогда
			СтрокаСообщения = "Не заполнено значение реквизита ""Вид оплаты""!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
			Продолжить;
			
		ИначеЕсли СтрокаТЧ.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.Наличные Тогда
			Продолжить;
			Если СтрокаТЧ.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны Тогда
				Если ЗначениеЗаполнено(СтрокаТЧ.Карточка) 
					И СтрокаТЧ.Карточка.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны Тогда
					НоминалТалона = СтрокаТЧ.Карточка.КратностьПлатежа;
				Иначе
					СтрокаСообщения = "Для типа оплаты ""Талон"", необходимо выбрать карточку с видом оплаты ""Талон""!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
				КонецЕсли;
				
			ИначеЕсли СтрокаТЧ.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питПитаниеСотрудников Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Карточка) Тогда
					
					СтрокаСообщения = "Для типа оплаты ""Питание сотрудников"", необходимо выбрать карточку с видом оплаты ""Питание сотрудников""!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
					
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет правильность заполнения строк табличной части "Модификаторы".
//
// Параметры:
//  Отказ - Булево - Отказ.
//  Заголовок - Произвольный - Заголовок.
//
Процедура ПроверитьЗаполнениеТабличнойЧастиМодификаторы(Отказ, Заголовок)
	
	Для каждого ТекСтрока Из Модификаторы Цикл
		СтрокаНачалаСообщенияОбОшибке =  "Строка номер "+ СокрЛП(ТекСтрока.НомерСтроки) +
										" табличной части ""Модификаторы"": ";
		Если ТекСтрока.НоменклатураОсновнойПозиции.Пустая() Тогда
			СтрокаСообщения = "Не заполнено значение реквизитов ""Номенклатура основной позиции"".";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
		КонецЕсли;
		Если ТекСтрока.Модификатор.Пустая() Тогда
			СтрокаСообщения = "Не заполнено значение реквизитов ""Модификатор"".";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
		КонецЕсли;
		Если НЕ ТекСтрока.Номенклатура.Пустая() И ТекСтрока.Количество = 0 Тогда
			СтрокаСообщения = "Не заполнено значение реквизита ""Количество"".";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, , , ,Отказ);
		КонецЕсли;
	КонецЦикла;
	

КонецПроцедуры
// ПроверитьЗаполнениеТабличнойЧастиМодификаторы()
//
// Параметры:
//  Отказ - Булево - Отказ.
//  Заголовок - Произвольный - Заголовок.
//
Процедура ПроверитьКорректностьСуммОплат(Отказ, Заголовок)
	Если ВидОперации <> Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаОтмена Тогда
		
		СуммаОплатыТалонами = 0;
		Для Каждого СтрокаТЧ Из Оплаты Цикл
			
			Префикс = "Оплаты[%1].";
			Префикс = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Префикс, Формат(СтрокаТЧ.НомерСтроки - 1, "ЧН=0; ЧГ="));
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ВидОплаты.ТипОплаты) Тогда
				СтрокаСообщения = "Не заполнено значение реквизита ""Тип оплаты""!";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, ЭтотОбъект, Префикс+"ВидОплаты", "Объект", Отказ);
				Продолжить;
			
			
			ИначеЕсли СтрокаТЧ.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.Наличные Тогда
				Продолжить;
			КонецЕсли;
			
			
			Если СтрокаТЧ.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны Тогда
				Если ЗначениеЗаполнено(СтрокаТЧ.Карточка) 
					И СтрокаТЧ.Карточка.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны Тогда
					НоминалТалона = СтрокаТЧ.Карточка.КратностьПлатежа;
					Если ЗначениеЗаполнено(НоминалТалона) Тогда
						Если Цел(СтрокаТЧ.СуммаОплаты/НоминалТалона) <> (СтрокаТЧ.СуммаОплаты/НоминалТалона) Тогда
							СтрокаСообщения = "Сумма оплаты должна быть кратна номиналу талона из карточки! Номинал талона = "+НоминалТалона+".";
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, ЭтотОбъект, Префикс+"Карточка", "Объект", Отказ);
						КонецЕсли;
					Иначе
						СтрокаСообщения = "В карточке не указан номинал талона!";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, ЭтотОбъект, Префикс+"Карточка", "Объект", Отказ);
					КонецЕсли;
				Иначе
					СтрокаСообщения = "Для типа оплаты ""Талон"", необходимо выбрать карточку с видом оплаты ""Талон""!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, ЭтотОбъект, Префикс+"Карточка", "Объект", Отказ);
					Отказ = Истина;
				КонецЕсли;
				
				СуммаОплатыТалонами = СуммаОплатыТалонами + СтрокаТЧ.СуммаОплаты;
				
			ИначеЕсли СтрокаТЧ.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питПитаниеСотрудников Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Карточка) Тогда
					СтрокаСообщения = "Для типа оплаты ""Питание сотрудников"", необходимо выбрать карточку с видом оплаты ""Питание сотрудников""!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, ЭтотОбъект, Префикс+"Карточка", "Объект", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ Отказ Тогда
			// Сумма проданных блюд и модификаторов должна совпадать с суммой полученных оплаты 
			// за вычетом сдачи с наличных и сгоревших остатков талонов.
			СуммаОплаты = Оплаты.Итог("СуммаОплаты") - Оплаты.Итог("Сдача");
			Если СуммаОплаты <> СуммаДокумента И НЕ (ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаИзъятие ИЛИ ВидОперации = Перечисления.питХозяйственныеОперации.ДанныеПродажФронтаВнесение) Тогда
				СтрокаСообщения = "Сумма оплат документа: " + Формат(СуммаОплаты, "ЧДЦ=2") + " не соответствует сумме товаров+модификаторов: " + Формат(СуммаДокумента, "ЧДЦ=2") + " !";
				НеХочуОтказ = Ложь;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения, ЭтотОбъект, "Оплаты", "Объект", НеХочуОтказ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

// Процедура - Сформировать записи в регистре продаж по чекам
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТЗТовары - Произвольный - Тз товары.
//
Процедура СформироватьЗаписиВРегистреПродажПоЧекам(Отказ, ТЗТовары)
	Попытка
		// Поиск записей в регистре "Данные продаж фронта"
		НаборЗаписейДанныеПродажФронта = РегистрыСведений.питПродажиПоЧекам.СоздатьНаборЗаписей();
		НаборЗаписейДанныеПродажФронта.Отбор.Документ.Установить(Ссылка);
		НаборЗаписейДанныеПродажФронта.Прочитать();
		
		// При необходимости очистим старые записи.
		Если НаборЗаписейДанныеПродажФронта.Количество() > 0 Тогда
			НаборЗаписейДанныеПродажФронта.Очистить();
		КонецЕсли;
		
		Для Каждого ТекСтрока Из ТЗТовары Цикл
			НоваяЗапись = НаборЗаписейДанныеПродажФронта.Добавить();
			НоваяЗапись.Дата = Дата;
			НоваяЗапись.Документ = Ссылка;
			НоваяЗапись.Организация = Организация;
			НоваяЗапись.Подразделение = Подразделение;
			НоваяЗапись.КассаККМ = КассаККМ;
			НоваяЗапись.НомерСмены = НомерСмены;
			НоваяЗапись.ВидОперации = ВидОперации;
			НоваяЗапись.Кассир = Ответственный;
			НоваяЗапись.ПричинаОтмены = ТекСтрока.ПричинаОтмены;
			НоваяЗапись.Номенклатура = ТекСтрока.Номенклатура;
			
			НоваяЗапись.Количество = ТекСтрока.Количество;
			НоваяЗапись.СуммаНДС = ТекСтрока.СуммаНДС;
			НоваяЗапись.СуммаСкидки = ТекСтрока.СуммаСкидки;
			НоваяЗапись.Сумма = ТекСтрока.Сумма;
		КонецЦикла;
		
		НаборЗаписейДанныеПродажФронта.Записать();
	Исключение
		Отказ = Истина;
	КонецПопытки;
КонецПроцедуры // СформироватьЗаписиВРегистреПродажПоЧекам()

