// УдалитьЗаписиВРегистреПродажПоЧекам()
//
// Параметры:
//  ТЗТовары - Произвольный - Тз товары.
//  ТЗОплаты - Произвольный - Тз оплаты.
//  ТЗМодификаторы - Произвольный - Тз модификаторы.
//
Процедура ПодготовитьТЧКЗаписиВРегистрПродажИОплатПоЧекам(ТЗТовары, ТЗОплаты, ТЗМодификаторы)
	
	ТЗТовары = Новый ТаблицаЗначений;
	ТЗТовары.Колонки.Добавить("Номенклатура");
	ТЗТовары.Колонки.Добавить("Количество");
	ТЗТовары.Колонки.Добавить("Сумма");
	ТЗТовары.Колонки.Добавить("СуммаСкидки");
	ТЗТовары.Колонки.Добавить("СуммаНДС");
	ТЗТовары.Колонки.Добавить("ПричинаОтмены");
	
	ТЗОплаты = Новый ТаблицаЗначений;
	ТЗОплаты.Колонки.Добавить("ВидОплаты");
	ТЗОплаты.Колонки.Добавить("Карточка");
	ТЗОплаты.Колонки.Добавить("Сумма");
	ТЗОплаты.Колонки.Добавить("СуммаОплаты");
	
	
	ТЗМодификаторы = Новый ТаблицаЗначений;
	ТЗМодификаторы.Колонки.Добавить("НоменклатураОсновнойПозиции");
	ТЗМодификаторы.Колонки.Добавить("Номенклатура");
	ТЗМодификаторы.Колонки.Добавить("Количество");
	ТЗМодификаторы.Колонки.Добавить("Сумма");
	ТЗМодификаторы.Колонки.Добавить("СуммаСкидки");
	ТЗМодификаторы.Колонки.Добавить("Модификатор");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбщепитДанныеПродажФронтаТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ОбщепитДанныеПродажФронтаТовары.Количество) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА &СуммаВключаетНДС
	|				ТОГДА ОбщепитДанныеПродажФронтаТовары.Сумма
	|			ИНАЧЕ ОбщепитДанныеПродажФронтаТовары.Сумма + ОбщепитДанныеПродажФронтаТовары.СуммаНДС
	|		КОНЕЦ) КАК Сумма,
	|	СУММА(ОбщепитДанныеПродажФронтаТовары.СуммаНДС) КАК СуммаНДС,
	|	ОбщепитДанныеПродажФронтаТовары.ПричинаОтмены КАК ПричинаОтмены,
	|	СУММА(ОбщепитДанныеПродажФронтаТовары.СуммаСкидкиСтроки + ОбщепитДанныеПродажФронтаТовары.СуммаСкидки) КАК СуммаСкидки
	|ИЗ
	|	Документ.питДанныеПродажФронта.Товары КАК ОбщепитДанныеПродажФронтаТовары
	|ГДЕ
	|	ОбщепитДанныеПродажФронтаТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбщепитДанныеПродажФронтаТовары.Номенклатура,
	|	ОбщепитДанныеПродажФронтаТовары.ПричинаОтмены,
	|	ОбщепитДанныеПродажФронтаТовары.СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбщепитДанныеПродажФронтаОплаты.ВидОплаты КАК ВидОплаты,
	|	ОбщепитДанныеПродажФронтаОплаты.Карточка КАК Карточка,
	|	ОбщепитДанныеПродажФронтаОплаты.СуммаОплаты - ОбщепитДанныеПродажФронтаОплаты.Сдача КАК СуммаОплаты
	|ИЗ
	|	Документ.питДанныеПродажФронта.Оплаты КАК ОбщепитДанныеПродажФронтаОплаты
	|ГДЕ
	|	ОбщепитДанныеПродажФронтаОплаты.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбщепитДанныеПродажФронтаОплаты.ВидОплаты,
	|	ОбщепитДанныеПродажФронтаОплаты.Карточка,
	|	ОбщепитДанныеПродажФронтаОплаты.СуммаОплаты - ОбщепитДанныеПродажФронтаОплаты.Сдача
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбщепитДанныеПродажФронтаМодификаторы.НоменклатураОсновнойПозиции КАК НоменклатураОсновнойПозиции,
	|	ОбщепитДанныеПродажФронтаМодификаторы.Модификатор КАК Модификатор,
	|	ОбщепитДанныеПродажФронтаМодификаторы.Номенклатура КАК Номенклатура,
	|	СУММА(ОбщепитДанныеПродажФронтаМодификаторы.Количество) КАК Количество,
	|	СУММА(ОбщепитДанныеПродажФронтаМодификаторы.Сумма) КАК Сумма,
	|	СУММА(ОбщепитДанныеПродажФронтаМодификаторы.СуммаСкидки) КАК СуммаСкидки
	|ИЗ
	|	Документ.питДанныеПродажФронта.Модификаторы КАК ОбщепитДанныеПродажФронтаМодификаторы
	|ГДЕ
	|	ОбщепитДанныеПродажФронтаМодификаторы.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбщепитДанныеПродажФронтаМодификаторы.НоменклатураОсновнойПозиции,
	|	ОбщепитДанныеПродажФронтаМодификаторы.Модификатор,
	|	ОбщепитДанныеПродажФронтаМодификаторы.Номенклатура";
	
	Запрос.УстановитьПараметр("СуммаВключаетНДС", СуммаВключаетНДС);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатЗапроса[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
	КонецЦикла;
	
	Выборка = РезультатЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗОплаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
	КонецЦикла;
	
	Выборка = РезультатЗапроса[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗМодификаторы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
	КонецЦикла;
КонецПроцедуры

// Производит обновление данных регистра "Учет данных продаж"
//
Процедура ОбновитьДанныеРегистраУчетДанныхПродаж()
	
	// Поиск записей в регистре "Данные продаж фронта"
	НаборЗаписейДанныеПродажФронта = РегистрыСведений.питУчетДанныхПродаж.СоздатьНаборЗаписей();
	НаборЗаписейДанныеПродажФронта.Отбор.ДокументРегистратор.Установить(Ссылка);
	НаборЗаписейДанныеПродажФронта.Прочитать();
	
	Если НаборЗаписейДанныеПродажФронта.Количество() = 0 Тогда
		// Добавление записи с данными текущего документа
		ЗаписьДанныеПродажФронта = НаборЗаписейДанныеПродажФронта.Добавить();
		ЗаписьДанныеПродажФронта.ДокументРегистратор 		= Ссылка;
		ЗаписьДанныеПродажФронта.КассовыйУзел				= Ссылка.КассаККМ.питКассовыйУзел;
		ЗаписьДанныеПродажФронта.ДокументПриемник  			= Неопределено;
		ЗаписьДанныеПродажФронта.ОбновленПриемник 			= Ложь;
		ЗаписьДанныеПродажФронта.ДатаПоследнегоОбновления 	= ТекущаяДата();
		ЗаписьДанныеПродажФронта.Дата 						= Дата;
		ЗаписьДанныеПродажФронта.КассовыйУзел				= КассовыйУзел;
	Иначе
		МассивПриемников = НаборЗаписейДанныеПродажФронта.ВыгрузитьКолонку("ДокументПриемник");
		
		// 1. Обновление всех записей с документом-приемником
		Для каждого ТекЗапись Из НаборЗаписейДанныеПродажФронта Цикл
			ТекЗапись.ОбновленПриемник 			= Ложь; 
			ТекЗапись.ДатаПоследнегоОбновления 	= ТекущаяДата();
			ТекЗапись.Дата 						= Дата;
			ТекЗапись.КассовыйУзел				= КассовыйУзел;
			
			Если НЕ ЗначениеЗаполнено(ТекЗапись.ДокументПриемник) Тогда
				Продолжить;
			КонецЕсли;
			
			НаборЗаписейДокументПриемник = РегистрыСведений.питУчетДанныхПродаж.СоздатьНаборЗаписей();
			НаборЗаписейДокументПриемник.Отбор.ДокументПриемник.Установить(ТекЗапись.ДокументПриемник);
			НаборЗаписейДокументПриемник.Прочитать();
			Если НаборЗаписейДокументПриемник.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для каждого ТекЗаписьДокументПриемник Из НаборЗаписейДокументПриемник Цикл
				ТекЗаписьДокументПриемник.ОбновленПриемник 			= Ложь;
				ТекЗаписьДокументПриемник.ДатаПоследнегоОбновления 	= ТекущаяДата();
				ТекЗаписьДокументПриемник.Дата 						= Дата;
				ТекЗаписьДокументПриемник.КассовыйУзел				= КассовыйУзел;
			КонецЦикла; 
            			
			НаборЗаписейДокументПриемник.Записать();
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	// Запись
	НаборЗаписейДанныеПродажФронта.Записать();
	
КонецПроцедуры // ОбновитьДанныеРегистраУчетДанныхПродаж()


#КонецЕсли


#КонецОбласти


