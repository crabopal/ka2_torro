// Параметры:
//  Объект - Произвольный - Объект.
//
Процедура ЗаполнитьНедостающиеИдентификаторыСтрок(Объект) Экспорт
	
	СтруктураПоискаМодификаторов = Новый Структура("НоменклатураОсновнойПозиции, ХарактеристикаОсновнойПозиции, СерияОсновнойПозиции");
	Для каждого ТекСтрокаТовары Из Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрокаТовары.ИдентификаторСтроки) Тогда
			ТекСтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			СтруктураПоискаМодификаторов.НоменклатураОсновнойПозиции 	= ТекСтрокаТовары.Номенклатура;
			СтруктураПоискаМодификаторов.ХарактеристикаОсновнойПозиции	= ТекСтрокаТовары.Характеристика;
			СтруктураПоискаМодификаторов.СерияОсновнойПозиции			= ТекСтрокаТовары.Серия;
			СтрокиМодификаторов = Объект.Модификаторы.НайтиСтроки(СтруктураПоискаМодификаторов);
			Для каждого ТекСтрокаМодификаторов Из СтрокиМодификаторов Цикл
				ТекСтрокаМодификаторов.ИдентификаторСтроки = ТекСтрокаТовары.ИдентификаторСтроки;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

