

#Область ПрограммныйИнтерфейс

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// СтандартныеПодсистемы.ВерсионированиеОбъектов

// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
//  Настройки - Структура - настройки подсистемы.
//
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
//  Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.РегистрацияЗамен - ДокументСсылкаРегистрацияЗаме.
//  СтруктураДополнительныеСвойства - Структура - СтруктураДополнительныеСвойств.
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ГосИС") Тогда
		Возврат;
	КонецЕсли;
	
	МодульпитЕГАИСОбщегоНазначения = ОбщегоНазначения.ОбщийМодуль("питЕГАИСОбщегоНазначения");
	ВидыПродукции = питИнтеграцияИСМП.ВидыПродукцииДоступныеДляОтраженияОстатковИС();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Шапка.Дата КАК Период,
	|	Шапка.Организация КАК Организация,
	|	ВТ_УчетАлкоголя.МестоПечати КАК МестоПечати,
	|	ВТ_УчетАлкоголя.Номенклатура КАК Номенклатура,
	|	СУММА(ВТ_УчетАлкоголя.Количество * &ТекстЗапросаКоэффициентУпаковки) КАК КоличествоВБазовой,
	|	СУММА(ВТ_УчетАлкоголя.КоличествоВМЛ) КАК Количество,
	|	ВТ_УчетАлкоголя.ШтрихкодУпаковки КАК Штрихкод,
	|	ВТ_УчетАлкоголя.КодАкциза КАК ШтрихкодСтрокой,
	|	ВТ_УчетАлкоголя.Ссылка КАК Регистратор,
	|	ВЫБОР
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат)
	|				ИЛИ Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя)
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	&ОпределениеВидаПродукции КАК ВидПродукцииИС,
	|	ВЫБОР
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ВскрытиеАлкоголя)
	|		КОГДА (Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа)
	|				ИЛИ Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат))
	|				И ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ПродажаПорций)
	|		КОГДА (Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа)
	|				ИЛИ Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат))
	|				И НЕ ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ПродажаБлюд)
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаОтмена)
	|				И ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ОтменаПорций)
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаОтмена)
	|				И НЕ ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ОтменаБлюд)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ПустаяСсылка)
	|	КОНЕЦ КАК ВидДвиженияМарок
	|ИЗ
	|	Документ.питДанныеПродажФронта КАК Шапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.питДанныеПродажФронта.УчетАлкоголя КАК ВТ_УчетАлкоголя
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ПО ВТ_УчетАлкоголя.Номенклатура = СпрНоменклатура.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|			ПО ВТ_УчетАлкоголя.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.питДанныеПродажФронта.Товары КАК ВТ_Товары
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатураПродукции
	|				ПО ВТ_Товары.Номенклатура = СпрНоменклатураПродукции.Ссылка
	|			ПО ВТ_УчетАлкоголя.Ссылка = ВТ_Товары.Ссылка
	|				И ВТ_УчетАлкоголя.НомерСтрокиОсновнойПозиции = ВТ_Товары.НомерСтроки
	|				И (НЕ ВТ_УчетАлкоголя.НомерСтрокиОсновнойПозиции = 0)
	|		ПО Шапка.Ссылка = ВТ_УчетАлкоголя.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|	И (НЕ ВТ_УчетАлкоголя.КодАкциза = """" ИЛИ НЕ ВТ_УчетАлкоголя.ШтрихкодУпаковки = ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка))
	|	И &ВидПродукцииИС_УсловиеОтбораДоступа
	|
	|СГРУППИРОВАТЬ ПО
	|	Шапка.Дата,
	|	Шапка.Организация,
	|	ВТ_УчетАлкоголя.Ссылка,
	|	ВТ_УчетАлкоголя.КодАкциза,
	|	ВТ_УчетАлкоголя.МестоПечати,
	|	ВТ_УчетАлкоголя.Номенклатура,
	|	ВТ_УчетАлкоголя.ШтрихкодУпаковки,
	|	ВЫБОР
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ВскрытиеАлкоголя)
	|		КОГДА (Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа)
	|				ИЛИ Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат))
	|				И ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ПродажаПорций)
	|		КОГДА (Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа)
	|				ИЛИ Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат))
	|				И НЕ ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ПродажаБлюд)
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаОтмена)
	|				И ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ОтменаПорций)
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаОтмена)
	|				И НЕ ЕСТЬNULL(СпрНоменклатураПродукции.питПродажаВРозлив, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ОтменаБлюд)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.ПустаяСсылка)
	|	КОНЕЦ,
	|	&ОпределениеВидаПродукции,
	|	ВЫБОР
	|		КОГДА Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат)
	|				ИЛИ Шапка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя)
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ";
	
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(Запрос.Текст);
	
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		ВидыПродукции,,
		"&ВидПродукцииИС_УсловиеОтбораДоступа");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ТекстЗапросаКоэффициентУпаковки",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковкиДляВыбора(
			"ВТ_УчетАлкоголя.ЕдиницаИзмерения",
			"ВТ_УчетАлкоголя.Номенклатура"));
		
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаОстаткиМарокИС = питОбщегоНазначения.ПустаяТаблицаПоРезультатуЗапроса(РезультатЗапроса);
	
	питОбщегоНазначения.ДобавитьКолонкуВТаблицу(ТаблицаОстаткиМарокИС, 
		"АлкогольнаяПродукция",
		Тип("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));
		
	ПараметрыПересчетаВМЛ = Неопределено;
	СписокШтрихкодов = Новый Массив;
	СписокСтрокБезШтрихкода = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		АлкогольнаяПродукция = Неопределено;
		Штрихкод = Неопределено;
		КодАкциза = Выборка.ШтрихкодСтрокой;
		Если СтрДлина(КодАкциза) = 68 Тогда
			РассчитанныйАлккокод = МодульпитЕГАИСОбщегоНазначения.ВыделитьАлкокодИзПДФ417(КодАкциза);
			Если НЕ РассчитанныйАлккокод = Неопределено Тогда
				АлкогольнаяПродукция = МодульпитЕГАИСОбщегоНазначения.ПолучитьАлкономенклатуруПоАлкокоду(РассчитанныйАлккокод);
			КонецЕсли;
			
		ИначеЕсли СтрДлина(КодАкциза) = 150 Тогда
			                                                
			СоответствиеШКпоПОДФ = МодульпитЕГАИСОбщегоНазначения.ПолучитьСоответствиеАлкоНоменклатурыПоPDF417(КодАкциза);
			Для каждого ЭлСоотв Из СоответствиеШКпоПОДФ Цикл
				// 1 раз
				ДанныеШтрихкода = ЭлСоотв.Значение;
				
				АлкогольнаяПродукция = ДанныеШтрихкода.АлкогольнаяПродукция;
				Штрихкод = ДанныеШтрихкода.ШтрихкодУпаковки;
				Прервать;
			КонецЦикла;
			
		КонецЕсли;
		
		Количество = Выборка.Количество;
		Если НЕ ЗначениеЗаполнено(Количество) Тогда
			Количество = питОбщегоНазначения.ПеревестиОбъемВМиллилитры(Выборка.Номенклатура,,
				Выборка.КоличествоВБазовой);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Количество) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаОстаткиМарокИС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Количество = Количество;
		Если ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
			НоваяСтрока.АлкогольнаяПродукция = АлкогольнаяПродукция;
		КонецЕсли;
		Если ЗначениеЗаполнено(Штрихкод) Тогда
			НоваяСтрока.Штрихкод = Штрихкод;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяСтрока.Штрихкод) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокШтрихкодов.Добавить(НоваяСтрока.ШтрихкодСтрокой);
		СписокСтрокБезШтрихкода.Добавить(НоваяСтрока);
	КонецЦикла;
	
	ШтрихкодыУпаковок = МодульпитЕГАИСОбщегоНазначения.питНайтиШтрихкодыУпаковокПоСпискуШтрихкодов(
		СписокШтрихкодов,
		Неопределено,
		Перечисления.ТипыУпаковок.МаркированныйТовар);
		
	Для Каждого ТекСтрока Из СписокСтрокБезШтрихкода Цикл
		
		ДанныеШтрихкода = ШтрихкодыУпаковок[ТекСтрока.ШтрихкодСтрокой];
		Если НЕ ДанныеШтрихкода = Неопределено Тогда
			Если ЗначениеЗаполнено(ДанныеШтрихкода) Тогда
				ТекСтрока.АлкогольнаяПродукция = ДанныеШтрихкода[0].АлкогольнаяПродукция;
				ТекСтрока.Штрихкод = ДанныеШтрихкода[0].Ссылка;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		ДанныеНовойУпаковки = Справочники.ШтрихкодыУпаковокТоваров.СтруктураСозданияШтрихкодаУпаковки();
		ЗаполнитьЗначенияСвойств(ДанныеНовойУпаковки, ТекСтрока);
		ДанныеНовойУпаковки.ТипУпаковки = Перечисления.ТипыУпаковок.МаркированныйТовар;
		ДанныеНовойУпаковки.ТипШтрихкода = Перечисления.ТипыШтрихкодов.Code128;
		ДанныеНовойУпаковки.Штрихкод = ТекСтрока.ШтрихкодСтрокой;
		ДанныеНовойУпаковки.КоличествоПотребительскихУпаковок = 1;
		ДанныеНовойУпаковки.Вставить("питДатаПодключения", ТекСтрока.Период);
		НоваяСтрока.Штрихкод = Справочники.ШтрихкодыУпаковокТоваров.СоздатьШтрихкодУпаковки(ДанныеНовойУпаковки);
		
	КонецЦикла;
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("питОстаткиМарокИС", ТаблицаОстаткиМарокИС);
	
КонецПроцедуры

// Заполняет список команд печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - состав полей в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// нет печатных форм
	
	// Реестр документов
	// КомандаПечати = КомандыПечати.Добавить();
	// КомандаПечати.Идентификатор = "Реестр";
	// КомандаПечати.Представление = НСтр("ru = 'Реестр документов'");
	// КомандаПечати.ЗаголовокФормы= НСтр("ru = 'Реестр документов ""Данные продаж фронта""'");
	// КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечатиРеестраДокументов";
	// КомандаПечати.СписокФорм    = "ФормаСписка";
