#КонецОбласти

// Процедура - Обработать изменения по кнопке цены и валюты завершение.
//
// Параметры:
//  РезультатЗакрытия - Произвольный - Результат закрытия.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработатьИзмененияПоКнопкеЦеныИВалютыЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Свойство("СтруктураПараметровКоманды") Тогда
		
		СтруктураЦеныИВалюта = ДополнительныеПараметры.СтруктураПараметровКоманды;
		
		Если РезультатЗакрытия = Неопределено Тогда 
			Возврат;
		ИначеЕсли РезультатЗакрытия.Значение = ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.ДокументБезНДС") Тогда
			СтруктураЦеныИВалюта.ДокументБезНДС 	= Истина;
			СтруктураЦеныИВалюта.Вставить("ПредСуммаВключаетНДС", СтруктураЦеныИВалюта.СуммаВключаетНДС);
		ИначеЕсли РезультатЗакрытия.Значение = ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.НДСВСумме") Тогда
			СтруктураЦеныИВалюта.ДокументБезНДС 	= Ложь;
			СтруктураЦеныИВалюта.Вставить("ПредСуммаВключаетНДС", СтруктураЦеныИВалюта.СуммаВключаетНДС);
			СтруктураЦеныИВалюта.СуммаВключаетНДС 	= Истина;
		Иначе
			СтруктураЦеныИВалюта.ДокументБезНДС 	= Ложь;
			СтруктураЦеныИВалюта.Вставить("ПредСуммаВключаетНДС", СтруктураЦеныИВалюта.СуммаВключаетНДС);
			СтруктураЦеныИВалюта.СуммаВключаетНДС 	= Ложь;
		КонецЕсли;
			
	Иначе
		СтруктураЦеныИВалюта = РезультатЗакрытия;
	КонецЕсли;
	
	// Отработка изменений
	Если ТипЗнч(СтруктураЦеныИВалюта) = Тип("Структура") Тогда
		
		ВалютаДоИзменения       = Объект.ВалютаДокумента;
		КурсДоИзменения         = Объект.КурсДокумента;
		КратностьДоИзменения    = Объект.КратностьДокумента;
		
		Объект.ВалютаДокумента    = СтруктураЦеныИВалюта.ВалютаДокумента;
		Объект.КурсДокумента      = СтруктураЦеныИВалюта.Курс;
		Объект.КратностьДокумента = СтруктураЦеныИВалюта.Кратность;
		Объект.ТипЦен             = СтруктураЦеныИВалюта.ТипЦен;
		Объект.СуммаВключаетНДС   = СтруктураЦеныИВалюта.СуммаВключаетНДС;
		Объект.ДокументБезНДС	  = СтруктураЦеныИВалюта.ДокументБезНДС;
		Если НЕ ЗначениеЗаполнено(ВалютаДоИзменения) Тогда
			ВалютаДоИзменения    = ВалютаРегламентированногоУчета;
			КурсДоИзменения      = 1;
			КратностьДоИзменения = 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
			Объект.ВалютаДокумента    = ВалютаРегламентированногоУчета;
			Объект.КурсДокумента      = 1;
			Объект.КратностьДокумента = 1;
		КонецЕсли;
		
		Модифицированность = Истина;
		Если СтруктураЦеныИВалюта.Свойство("ПересчитатьНДС") Тогда
			ПересчитатьНДС = СтруктураЦеныИВалюта.ПересчитатьНДС;
		ИначеЕсли СтруктураЦеныИВалюта.Свойство("ПредСуммаВключаетНДС") Тогда
			ПересчитатьНДС = СтруктураЦеныИВалюта.СуммаВключаетНДС <> СтруктураЦеныИВалюта.ПредСуммаВключаетНДС;
		Иначе
			ПересчитатьНДС = Истина;
		КонецЕсли;
		
		ЗаполнитьРассчитатьСуммы(
			ВалютаДоИзменения,
			КурсДоИзменения,
			КратностьДоИзменения,
			ПересчитатьНДС);
		
		ОбновитьИтоги(ЭтаФорма);
		СформироватьНадписьЦеныИВалюта(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

#Область Серии

// Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
		
		НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[ВыбранноеЗначение.ИмяТЧ], ВыбранноеЗначение);
		
		ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
		
	КонецЕсли;
	
	Если Окно <> Неопределено Тогда
		Окно.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

// Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

// Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// ЕРП
	
	УстановитьУсловноеОформление();
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	// ЕРП
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// +Серии
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПриЧтенииСозданииНаСервере();
		
	КонецЕсли;
	// -Серии
	
	УстановитьФункциональныеОпцииФормы();
	
	ТекущаяДатаДокумента = Объект.Дата;
	
	ВалютаРегламентированногоУчета = питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	
	// для возвратов выводим документ продажи
	ПолучитьДокументПродажиПоИД();
	
	ВсегоБезналичныхОплат = ПолучитьСуммуБезналичнойОплаты();
	СформироватьНадписьЦеныИВалюта(ЭтаФорма);
	
	УстановитьПараметрыВыбораВидаОплаты();
	
	// УстановитьВидимость();
	УправлениеФормой(ЭтаФорма);
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
	
КонецПроцедуры

// Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

// Процедура - После записи.
//
// Параметры:
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
КонецПроцедуры

// Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

// Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	
	// Отработаем специфику хозопераций
	// и установим видимость реквизитов и заголовков колонок.
	
	УстановитьВидимость();
	
	// ОбновитьИтоги(ЭтаФорма);
	
КонецПроцедуры

// Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЗаполнитьДобавленныеКолонкиТаблицыТовары();
	
	// +Серии
	ПриЧтенииСозданииНаСервере();
	// +Серии
	
КонецПроцедуры

// Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьДобавленныеКолонкиТаблицыТовары();
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	// +Серии
	ЗаполнитьПараметрыУказанияСерий();
	УстановитьВидимостьЭлементовСерий();
	// -Серии
	
	ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область Серии

// Процедура - Товары серия начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСерияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий("Товары", Элемент.ТекстРедактирования, Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

// Процедура - Товары выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если (Поле = Элементы["ТоварыСерия"] 
				ИЛИ Поле = Элементы["ТоварыСтатусУказанияСерий"]) Тогда
		ТаблицаВыборСерии("Товары", Поле, Элемент, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

// Процедура - Товары при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено
		И ПустаяСтрока(ТекущиеДанные.ИдентификаторСтроки) Тогда
		
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
		
	КонецЕсли;
	
	ОбновитьКешированныеЗначенияДляУчетаСерий("Товары", Элемент, КэшированныеЗначения, Копирование);
КонецПроцедуры

// Процедура - Товары перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	// удаление модификаторов
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		НайденныеМодификаторы = Объект.Модификаторы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки));
		Для каждого ТекМодификатор Из НайденныеМодификаторы Цикл
			Объект.Модификаторы.Удалить(ТекМодификатор);
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьКешированныеЗначенияДляУчетаСерий("Товары", Элемент, КэшированныеЗначения, Ложь);
КонецПроцедуры

// Процедура - Товары при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТаблицаПриОкончанииРедактирования("Товары", Элемент);
КонецПроцедуры

// Процедура - Товары обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТаблицаОбработкаВыбора("Товары", ВыбранноеЗначение);
	ИзмененыТовары = Истина;
	УправлениеФормой(ЭтаФорма);
КонецПроцедуры

// Процедура - Склад при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТаблицаСкладПриИзменении("Товары", , ТекущиеДанные);
	ТекущиеДанные = Элементы.Модификаторы.ТекущиеДанные;
	ТаблицаСкладПриИзменении("Модификаторы", , ТекущиеДанные);
КонецПроцедуры

// Процедура - Товары серия при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСерияПриИзменении(Элемент)
	ТаблицаСерияПриИзменении("Товары");
	
	ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
	
КонецПроцедуры

// Процедура - Модификаторы серия начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыСерияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий("Модификаторы", Элемент.ТекстРедактирования, Элементы.Модификаторы.ТекущиеДанные);
КонецПроцедуры

// Процедура - Модификаторы выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если (Поле = Элементы["МодификаторыСерия"] 
				ИЛИ Поле = Элементы["МодификаторыСтатусУказанияСерий"]) Тогда
		ТаблицаВыборСерии("Модификаторы", Поле, Элемент, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

// Процедура - Модификаторы при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура МодификаторыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ОбновитьКешированныеЗначенияДляУчетаСерий("Модификаторы", Элемент, КэшированныеЗначения, Копирование);
КонецПроцедуры

// Процедура - Модификаторы перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура МодификаторыПередУдалением(Элемент, Отказ)
	ОбновитьКешированныеЗначенияДляУчетаСерий("Модификаторы", Элемент, КэшированныеЗначения, Ложь);
КонецПроцедуры

// Процедура - Модификаторы при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура МодификаторыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ТаблицаПриОкончанииРедактирования("Модификаторы", Элемент);
КонецПроцедуры

// Процедура - Модификаторы обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТаблицаОбработкаВыбора("Модификаторы", ВыбранноеЗначение);
	ИзмененыТовары = Истина;
	УправлениеФормой(ЭтаФорма);
КонецПроцедуры

// Процедура - Модификаторы серия при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыСерияПриИзменении(Элемент)
	ТаблицаСерияПриИзменении("Модификаторы");
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

// Процедура - Подключаемый при изменении дополнительного реквизита.
