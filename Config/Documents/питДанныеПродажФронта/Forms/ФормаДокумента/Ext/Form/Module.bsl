////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ТАБЛИЧНОГО ПОЛЯ ТОВАРЫ
//

// Процедура - Товары номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ДанныеСтрокаТаблицы = Новый Структура("Номенклатура, Количество, Цена, Сумма, СтавкаНДС, СуммаНДС,
		|Упаковка, Коэффициент, КоличествоУпаковок");
	ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, Элементы.Товары.ТекущиеДанные);
	
	ПараметрыОбъекта = Новый Структура("Организация, Дата, Ссылка, СуммаВключаетНДС, ВалютаДокумента, ТипЦен");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
	
	ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
	ЗаполнитьЗначенияСвойств(Элементы.Товары.ТекущиеДанные, ДанныеСтрокаТаблицы);
	
	ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
	
	ТаблицаНоменклатураПриИзменении("Товары");
	
КонецПроцедуры

// Процедура - Товары единица измерения при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
	
	ПосчитатьКоличестваВединицахХранения("");
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ТАБЛИЧНОГО ПОЛЯ МОДИФИКАТОРЫ
//

// Процедура - Модификаторы единица измерения номенклатуры при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыЕдиницаИзмеренияНоменклатурыПриИзменении(Элемент)
	ПосчитатьКоличестваВединицахХранения("Номенклатуры", "Модификаторы", "УпаковкаНоменклатуры");
	СтрокаТаблицы = Элементы.Модификаторы.ТекущиеДанные;
	СтрокаТаблицы.Коэффициент = 1;
КонецПроцедуры

// Процедура - Модификаторы идентификатор строки обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыИдентификаторСтрокиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.Модификаторы.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		ТекДанные.ИдентификаторСтроки = ВыбранноеЗначение;
		ТекДанные.ИдентификаторСтрокиПредставление = СписокВыбораОсновнойПозиции.НайтиПоЗначению(ВыбранноеЗначение).Представление;
		Элементы.Модификаторы.ЗакончитьРедактированиеСтроки(Ложь);
		
		ДанныеОсновнойПозиции = ПолучитьДанныеОсновнойПозицииПоИдентификаторуСтроки(ТекДанные.ИдентификаторСтроки);
		Если НЕ ДанныеОсновнойПозиции = Неопределено Тогда
			ТекДанные.НоменклатураОсновнойПозиции	= ДанныеОсновнойПозиции.Номенклатура;
			ТекДанные.ХарактеристикаОсновнойПозиции	= ДанныеОсновнойПозиции.Характеристика;
			ТекДанные.СерияОсновнойПозиции			= ДанныеОсновнойПозиции.Серия;
			ТекДанные.НомерСтрокиОсновнойПозиции	= ДанныеОсновнойПозиции.НомерСтроки;
			
			ТаблицаНоменклатураПриИзменении("Модификаторы");
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

// Процедура - Вид операции при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	УстановитьВидимость();
КонецПроцедуры

// Процедура - Модификаторы модификатор начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура МодификаторыМодификаторНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	стрПараметры = Новый Структура("НоменклатураДляОтбора", Элементы.Модификаторы.ТекущиеДанные.НоменклатураОсновнойПозиции);
	ФормаВыбора = ПолучитьФорму("Справочник.питМодификаторы.ФормаВыбора", стрПараметры , Элемент);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

// Процедура - Модификаторы модификатор при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыМодификаторПриИзменении(Элемент)
	
	ДанныеСтрокиМодификаторов = Новый Структура("Модификатор,Количество,Номенклатура,Цена,Сумма,КоличествоУпаковокНоменклатуры,
		|КоличествоНоменклатуры,УпаковкаНоменклатуры,Коэффициент");
	ЗаполнитьЗначенияСвойств(ДанныеСтрокиМодификаторов, Элементы.Модификаторы.ТекущиеДанные);
	МодификаторыМодификаторПриИзмененииНаСервере(ДанныеСтрокиМодификаторов, КэшированныеЗначения);
	Если ЗначениеЗаполнено(ДанныеСтрокиМодификаторов.Номенклатура) Тогда
		ЗаполнитьЗначенияСвойств(Элементы.Модификаторы.ТекущиеДанные, ДанныеСтрокиМодификаторов);
	Иначе
		
	КонецЕсли;
	
	
	ТаблицаНоменклатураПриИзменении("Модификаторы");
	
КонецПроцедуры

// Процедура - Оплаты при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОплатыПриИзменении(Элемент)
	ВсегоБезналичныхОплат = ПолучитьСуммуБезналичнойОплаты();
	СуммаОплат  = ПолучитьСуммуОплат();
КонецПроцедуры

// Процедура - Товары при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	СуммаИтог = ПолучитьИтоговуюСумму();
	ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
КонецПроцедуры

// Процедура - Модификаторы при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыПриИзменении(Элемент)
	СуммаИтог = ПолучитьИтоговуюСумму();
КонецПроцедуры

// Процедура - Цены и валюта нажатие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ЦеныИВалютаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОбработатьИзмененияПоКнопкеЦеныИВалюты();
	
КонецПроцедуры

// Процедура - Товары цена при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	ПриИзмененииКоличествоЦена("Товары");
КонецПроцедуры

// Процедура - Товары количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ПосчитатьКоличестваВединицахХранения("");
	ПриИзмененииКоличествоЦена("Товары");
	
КонецПроцедуры

// Процедура - Товары сумма при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	ПриИзмененииСумма("Товары");
КонецПроцедуры

// Процедура - Товары ставка ндс при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСтавкаНДСПриИзменении(Элемент)
	ПриИзмененииСтавкаНДС("Товары");
КонецПроцедуры

// Процедура - Товары сумма ндс при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСуммаНДСПриИзменении(Элемент)
	ПриИзмененииСуммаНДС("Товары");
КонецПроцедуры

// Процедура - Товары сумма скидки строки при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСуммаСкидкиСтрокиПриИзменении(Элемент)
