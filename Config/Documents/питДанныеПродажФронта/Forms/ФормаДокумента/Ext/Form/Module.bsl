// Процедура - Модификаторы сумма скидки при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыСуммаСкидкиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы["Модификаторы"].ТекущиеДанные;
	
	Если ТекущиеДанные.Свойство("СуммаСкидки") Тогда
		ТекущиеДанные.ПроцентСкидки = ?(ТекущиеДанные.Сумма + ТекущиеДанные.СуммаСкидки = 0, 0, Окр(ТекущиеДанные.СуммаСкидки * 100 / (ТекущиеДанные.Сумма + ТекущиеДанные.СуммаСкидки), 2));
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Модификаторы сумма при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МодификаторыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы["Модификаторы"].ТекущиеДанные;
	
	Если ТекущиеДанные.Свойство("СуммаСкидки") Тогда
		ТекущиеДанные.ПроцентСкидки = ?(ТекущиеДанные.Сумма + ТекущиеДанные.СуммаСкидки = 0, 0, Окр(ТекущиеДанные.СуммаСкидки * 100 / (ТекущиеДанные.Сумма + ТекущиеДанные.СуммаСкидки), 2));
	КонецЕсли;
	
