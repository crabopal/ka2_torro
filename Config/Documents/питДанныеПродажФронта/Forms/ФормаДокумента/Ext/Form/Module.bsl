// Процедура - Открыть подбор серий завершение.
//
// Параметры:
//  РезультатЗакрытия - Произвольный - Результат закрытия.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОткрытьПодборСерийЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если РезультатЗакрытия <> Неопределено Тогда
		ОбработатьУказаниеСерийСервер(ДополнительныеПараметры.ИмяТЧ, ДополнительныеПараметры.ПараметрыУказанияСерий, ДополнительныеПараметры.ПараметрыФормыУказанияСерий);
		Если ДополнительныеПараметры.ПараметрыУказанияСерий.ИмяТЧТовары = "Товары" 
			ИЛИ ДополнительныеПараметры.ПараметрыУказанияСерий.ИмяТЧТовары = "Модификаторы" Тогда
			ИзмененыТовары = Истина;
			УправлениеФормой(ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция - Параметры пересчета количества единиц.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПараметрыПересчетаКоличестваЕдиниц() Экспорт
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	Возврат ПараметрыПересчета;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиБиблиотек
