// Процедура - Заполнить параметры указания серий.
//
&НаСервере
Процедура ЗаполнитьПараметрыУказанияСерий()
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питДанныеПродажФронта));
	
КонецПроцедуры

// Функция - Параметры формы указания серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущиеДанныеИдентификатор - Произвольный - Текущие данные идентификатор.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаСервере
Функция ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор)
	
	Возврат НоменклатураСервер.ПараметрыФормыУказанияСерий(Объект, ПараметрыУказанияСерий[ИмяТЧ], ТекущиеДанныеИдентификатор, ЭтаФорма);
	
КонецФункции

// Процедура - Открыть подбор серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Текст - Строка - Текст.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ОткрытьПодборСерий(ИмяТЧ, Текст = "", ТекущиеДанные = Неопределено)
	
	НуженСерверныйВызов = НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(
							ЭтаФорма, 
							ПараметрыУказанияСерий[ИмяТЧ], 
							Текст, 
							ТекущиеДанные);
	
	Если НуженСерверныйВызов Тогда
		
		Если ТекущиеДанные = Неопределено Тогда
			ТекущиеДанныеИдентификатор = Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
		Иначе
			ТекущиеДанныеИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		КонецЕсли;
		
		ПараметрыФормыУказанияСерий = ПараметрыФормыУказанияСерий(ИмяТЧ, ТекущиеДанныеИдентификатор);
		ДополнительныеПараметры = Новый Структура("ПараметрыУказанияСерий,ПараметрыФормыУказанияСерий, ИмяТЧ", 
											ПараметрыУказанияСерий[ИмяТЧ], ПараметрыФормыУказанияСерий, ИмяТЧ);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьПодборСерийЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму(ПараметрыФормыУказанияСерий.ИмяФормы, 
						ПараметрыФормыУказанияСерий, 
						ЭтаФорма,,,,
						ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Обработать указание серий сервер.
//
// Параметры:
//  Знач ИмяТЧ - Произвольный - Знач имя тч.
//  Знач ПараметрыУказанияСерий - Произвольный - Знач параметры указания серий.
//  Знач ПараметрыФормыУказанияСерий - Произвольный - Знач параметры формы указания серий.
//
&НаСервере
Процедура ОбработатьУказаниеСерийСервер(Знач ИмяТЧ, Знач ПараметрыУказанияСерий, Знач ПараметрыФормыУказанияСерий)
	
	Если ПараметрыУказанияСерий.ИмяТЧТовары = "Товары" 
		ИЛИ ПараметрыУказанияСерий.ИмяТЧТовары = "Модификаторы" Тогда
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ОбновлятьКоличествоТоваровПриРегистрацииСерий", Истина);
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокСерии(
		Неопределено, 
		ПараметрыУказанияСерий.ИмяТЧТовары, 
		СтруктураДействий);
	Иначе
		СтруктураДействий = Неопределено;
	КонецЕсли; 
	
	НоменклатураСервер.ОбработатьУказаниеСерий(
	Объект, 
	ПараметрыУказанияСерий, 
	ПараметрыФормыУказанияСерий, 
	СтруктураДействий);
	
КонецПроцедуры

// Процедура - Добавить в структуру действия при изменении количества упаковок серии.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокСерии(ТекущаяСтрока, ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчетаКоличестваЕдиниц = ПараметрыПересчетаКоличестваЕдиниц();
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчетаКоличестваЕдиниц);
	
КонецПроцедуры

// Процедура - Таблица выбор серии.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Поле - Произвольный - Поле.
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаВыборСерии(ИмяТЧ, Поле, Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекущиеДанные.СтатусУказанияСерий > 0
		И ТекущиеДанные.СтатусУказанияСерий <= 11 Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьПодборСерий(ИмяТЧ, Поле.ТекстРедактирования);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Установить видимость элементов серий.
//
&НаСервере
Процедура УстановитьВидимостьЭлементовСерий()
	
	Элементы.ТоварыСерия.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	Элементы.ТоварыУказатьСерии.Видимость = ПараметрыУказанияСерий.Товары.ИспользоватьСерииНоменклатуры;
	
	Элементы.МодификаторыСерия.Видимость = ПараметрыУказанияСерий.Модификаторы.ИспользоватьСерииНоменклатуры;
	Элементы.МодификаторыСтатусУказанияСерий.Видимость = ПараметрыУказанияСерий.Модификаторы.ИспользоватьСерииНоменклатуры;
	Элементы.МодификаторыУказатьСерии.Видимость = ПараметрыУказанияСерий.Модификаторы.ИспользоватьСерииНоменклатуры;
	
КонецПроцедуры

// Процедура - Заполнить статусы указания серий сервер.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтрокиТоваровДляОбработки - Произвольный - Строки товаров для обработки.
//  СтрокиСерийДляОбработки - Произвольный - Строки серий для обработки.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, СтрокиТоваровДляОбработки = Неопределено, СтрокиСерийДляОбработки = Неопределено)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий[ИмяТЧ], СтрокиТоваровДляОбработки, СтрокиСерийДляОбработки);
	
КонецПроцедуры

// Процедура - При чтении создании на сервере.
//
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	// +Серии
	ЗаполнитьПараметрыУказанияСерий();
	ЗаполнитьСтатусыУказанияСерийСервер("Товары");
	ЗаполнитьСтатусыУказанияСерийСервер("Модификаторы");
	УстановитьВидимостьЭлементовСерий();
	// -Серии
	
КонецПроцедуры

// Процедура - Обновить кешированные значения для учета серий.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ОбновитьКешированныеЗначенияДляУчетаСерий(ИмяТЧ, Элемент, КэшированныеЗначения, Копирование)
	
	НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(
				Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ], Копирование);
КонецПроцедуры

// Процедура - Таблица при окончании редактирования.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаПриОкончанииРедактирования(ИмяТЧ, Элемент)
	
	ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если НоменклатураКлиент.НеобходимоОбновитьСтатусыСерий(
			Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ]) Тогда
		
		ТекущаяСтрокаИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		
		ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(ПараметрыУказанияСерий[ИмяТЧ], ТекущаяСтрокаИдентификатор, КэшированныеЗначения);
		НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(Элемент, КэшированныеЗначения, ПараметрыУказанияСерий[ИмяТЧ]);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Заполнить статусы указания серий при окончании редактирования строки тч.
//
// Параметры:
//  Знач ПараметрыУказанияСерий - Произвольный - Знач параметры указания серий.
//  ТекущаяСтрокаИдентификатор - Строка - Текущая строка идентификатор.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//
&НаСервере
Процедура ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Знач ПараметрыУказанияСерий,
	ТекущаяСтрокаИдентификатор,
	КэшированныеЗначения)
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(Объект, 
	ПараметрыУказанияСерий, ТекущаяСтрокаИдентификатор, КэшированныеЗначения);
	
КонецПроцедуры

// Процедуру следует использовать, если строки были добавлены программно (не интерактивно), например, при вставке из
//  буфера, при заполнении по спецификации.
//  Процедура выполняет действия которые зависят от данных в строках.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  МассивИдентификаторовСтрок - Массив - Массив идентификаторов строк.
//  СтруктураРанееВыполненныхДействий - Структура - Структура ранее выполненных действий.
//
&НаСервере
Процедура ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивИдентификаторовСтрок = Неопределено, СтруктураРанееВыполненныхДействий = Неопределено)
	
	МассивСтрок = Неопределено;
	КоллекцияСтрок = Объект[ИмяТЧ];
	Если МассивИдентификаторовСтрок <> Неопределено Тогда
		МассивСтрок = Новый Массив;
		Для каждого ИдентификаторСтроки Из МассивИдентификаторовСтрок Цикл
			МассивСтрок.Добавить(Объект[ИмяТЧ].НайтиПоИдентификатору(ИдентификаторСтроки));
		КонецЦикла; 
		КоллекцияСтрок = МассивСтрок;
	КонецЕсли;
	
	Если СтруктураРанееВыполненныхДействий = Неопределено Тогда
		СтруктураРанееВыполненныхДействий = Новый Структура;
	КонецЕсли;
	
	Если ((ИмяТЧ = "Товары") ИЛИ (ИмяТЧ = "Модификаторы"))
		И НЕ СтруктураРанееВыполненныхДействий.Свойство("ПроверитьСериюРассчитатьСтатус") Тогда
		ЗаполнитьСтатусыУказанияСерийСервер(ИмяТЧ, МассивСтрок, МассивСтрок);
	КонецЕсли; 
	
	ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления();
	
КонецПроцедуры

// Процедура - Таблица обработка выбора подбора на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаСервере
Процедура ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		СписокТоваров = ВыбранноеЗначение;
	Иначе
		СписокТоваров = Новый Массив;
		СписокТоваров.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	МассивСтрок = Новый Массив;
	Для каждого СтрокаТовара Из СписокТоваров Цикл
		
		ТекущаяСтрока = Объект[ИмяТЧ].Добавить();
		ТекущаяСтрока.Номенклатура = СтрокаТовара;
		
		ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(
				ИмяТЧ, 
				ТекущаяСтрока, 
				ЭтаФорма, 
				СтруктураДействий);
				
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
		
		МассивСтрок.Добавить(ТекущаяСтрока.ПолучитьИдентификатор());
		
	КонецЦикла;
	
	ПослеИзмененияСтрокТЧПрограммноНаСервере(ИмяТЧ, МассивСтрок, СтруктураДействий);
	
КонецПроцедуры

// Процедура - Таблица обработка выбора.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаКлиенте
Процедура ТаблицаОбработкаВыбора(ИмяТЧ, ВыбранноеЗначение)
	
	ТаблицаОбработкаВыбораПодбораНаСервере(ВыбранноеЗначение, ИмяТЧ);
	
КонецПроцедуры

// Процедура - Добавить в структуру действия по сериям.
//
// Параметры:
//  СтруктураДействий - Структура - Структура действий.
//  Склад - Произвольный - Склад.
//  ПараметрыУказанияСерий - Произвольный - Параметры указания серий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Склад, ПараметрыУказанияСерий)
	
	ПараметрыПроверкиСерий = Новый Структура("Склад, ПараметрыУказанияСерий", Склад, ПараметрыУказанияСерий);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", ПараметрыПроверкиСерий);
	
КонецПроцедуры

// Процедура - Таблица склад при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИмяСклад - Произвольный - Имя склад.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ТаблицаСкладПриИзменении(ИмяТЧ, ИмяСклад = Неопределено, ТекущиеДанные)
	
	// ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	
	Если ИмяСклад = Неопределено Тогда
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
	Иначе
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, ТекущиеДанные[ИмяСклад], ПараметрыУказанияСерий[ИмяТЧ]);
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

// Процедура - Таблица серия при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаСерияПриИзменении(ИмяТЧ)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение						= Элементы[ИмяТЧ].ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки	= Элементы[ИмяТЧ].ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий[ИмяТЧ], ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

// Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

// Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область КопированиеВставкаСтрок

// Процедура - Скопировать строки на сервере.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура СкопироватьСтрокиНаСервере(ИмяТаблицы)
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(Объект[ИмяТаблицы], Элементы[ИмяТаблицы].ВыделенныеСтроки);
	
КонецПроцедуры

// Процедура - Получить строки из буфера обмена.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена(ИмяТаблицы)
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена();
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТаблицы, СтруктураДействий);
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

// Функция - Получить имя текущей табличной части.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ПолучитьИмяТекущейТабличнойЧасти()
	
	ИмяТаблицы = "Товары";
	Возврат ИмяТаблицы;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиБиблиотек

// Процедура - Выполнить команду на сервере.
//
// Параметры:
//  ПараметрыВыполнения - Произвольный - Параметры выполнения.
//
&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

// @skip-check module-unused-method
//
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

#КонецОбласти

// Процедура устанавливает видимость для тех колонок в табличной части
//  "Товары", видимость которых определяется реквизитами документа.
//
&НаКлиенте
Процедура УстановитьВидимость()
	
	// Колонки = Элементы.Товары.ПодчиненныеЭлементы;
	// Колонки.ТоварыСтавкаНДС.Видимость                = Объект.УчитыватьНДС;
	// Колонки.ТоварыСуммаНДС.Видимость                 = Объект.УчитыватьНДС;
	// Элементы.ГруппаИтогИНДС.Видимость                = Объект.УчитыватьНДС;
	
	// Это сделано через условное оформление формы.
//   Если Объект.ВидОперации =
// ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаОтмена") Тогда.
	// 	Колонки.ТоварыДатаОтмены.Видимость 		= Истина;
	// 	Колонки.ТоварыСоСписанием.Видимость 		= Истина;
	// 	Колонки.ТоварыПричинаОтмены.Видимость 	= Истина;
	// Иначе
	// 	Колонки.ТоварыДатаОтмены.Видимость 		= Ложь;
	// 	Колонки.ТоварыСоСписанием.Видимость 		= Ложь;
	// 	Колонки.ТоварыПричинаОтмены.Видимость 	= Ложь;
	// КонецЕсли;
	
	Элементы.ДокументПродажи.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат");

	Элементы.ГруппаТовары.Видимость = Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя");
	Элементы.ГруппаМодификаторы.Видимость = Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя");
	Элементы.ГруппаОплаты.Видимость = Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя");

	Элементы.ГруппаУчетАлкоголя.Видимость = 
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаУчетАлкоголя")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаОтмена")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат");
	
	Элементы.ГруппаНачислениеБонусныхБаллов.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа");

		Элементы.ТоварыСкидкиСтроки.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа");
	Элементы.ТоварыСкидкиНаТовар.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа");
	Элементы.МодификаторыСкидки.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаПродажа");
КонецПроцедуры // УстановитьВидимость()

// Процедура - Посчитать количества вединицах хранения.
//
// Параметры:
//  Суффикс - Произвольный - Суффикс.
//  ИмяТЧ - Строка - Имя тч.
//  ИмяРеквизитаУпаковка - Произвольный - Имя реквизита упаковка.
//
&НаКлиенте
Процедура ПосчитатьКоличестваВединицахХранения(Суффикс, ИмяТЧ = "Товары", ИмяРеквизитаУпаковка = Неопределено)
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", Суффикс);
	
	Если НЕ ИмяРеквизитаУпаковка = Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			СтруктураПолейТЧ = Новый Структура;
			СтруктураПолейТЧ.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
			СтруктураПолейТЧ.Вставить("Упаковка", ТекущаяСтрока[ИмяРеквизитаУпаковка]);
			СтруктураПолейТЧ.Вставить("КоличествоУпаковок"+Суффикс, ТекущаяСтрока["КоличествоУпаковок"+Суффикс]);
			СтруктураПолейТЧ.Вставить("Количество"+Суффикс    , ТекущаяСтрока["Количество"+Суффикс]);
			ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтруктураПолейТЧ, СтруктураДействий, КэшированныеЗначения);
			ТекущаяСтрока["Количество"+Суффикс] = СтруктураПолейТЧ["Количество"+Суффикс];
		Иначе
			ТекущаяСтрока["Количество"+Суффикс] = ТекущаяСтрока["КоличествоУпаковок"+Суффикс];
		КонецЕсли;
	Иначе
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	
КонецПроцедуры

// Пересчеты реквизитов в строках табличных частей

// Процедура - Товары номенклатура при изменении на сервере.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//  Знач ПараметрыОбъекта - Произвольный - Знач параметры объекта.
//
&НаСервереБезКонтекста
Процедура ТоварыНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, Знач ПараметрыОбъекта)
	
	МетаданныеДокумента = ПараметрыОбъекта.Ссылка.Метаданные();
	
	питОбщегоНазначенияКлиентСервер.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти,, "КоличествоУпаковок");
	питОбщегоНазначенияКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, ПараметрыОбъекта.СуммаВключаетНДС);
	
КонецПроцедуры

// Процедура - Получить документ продажи по ид.
//
&НаСервере
Процедура ПолучитьДокументПродажиПоИД()
	Если НЕ ПустаяСтрока(Объект.ИДПродажи) Тогда
		УникальныйИдентификаторПродаж = Новый УникальныйИдентификатор(Объект.ИДПродажи);
		ОбъектСсылка = Документы.питДанныеПродажФронта.ПолучитьСсылку(УникальныйИдентификаторПродаж);
		Если НЕ ОбъектСсылка.Пустая() Тогда
			ДокументПродажи = "По чеку продажи: " + ОбъектСсылка;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура - Установить функциональные опции формы.
//
&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	питОбщегоНазначенияКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированныйУчетПодсистемы") Тогда
		МодульУчетнаяПолитика = ОбщегоНазначения.ОбщийМодуль("УчетнаяПолитика");
		ПлательщикНДС = МодульУчетнаяПолитика.ПлательщикНДС(Объект.Организация, Объект.Дата);
	КонецЕсли;
	
	ИспользоватьТипыЦенНоменклатуры = Истина;
	
	ИспользуютсяПодарочныеСертификаты = Истина;
	
	ПрименяютсяДоговораСКомитентамиНаПродажу = Истина;
	
КонецПроцедуры

// Процедура - Обновить список выбора основной позиции заполнить представления.
//
&НаСервере
Процедура ОбновитьСписокВыбораОсновнойПозицииЗаполнитьПредставления()
	
	Элементы.МодификаторыИдентификаторСтроки.СписокВыбора.Очистить();
	СписокВыбораОсновнойПозиции.Очистить();
	Для каждого ТекСтрокаТовары Из Объект.Товары Цикл
		ПредставлениеСтроки = "" + Строка(ТекСтрокаТовары.НомерСтроки) + ", " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрокаТовары.Номенклатура, "НаименованиеПолное") 
			+ ?(ЗначениеЗаполнено(ТекСтрокаТовары.Характеристика), ", " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрокаТовары.Характеристика, "НаименованиеПолное"), "")
			+ ?(ЗначениеЗаполнено(ТекСтрокаТовары.Серия), ", " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрокаТовары.Серия, "Наименование"), "");
		Элементы.МодификаторыИдентификаторСтроки.СписокВыбора.Добавить(ТекСтрокаТовары.ИдентификаторСтроки, ПредставлениеСтроки);
		СписокВыбораОсновнойПозиции.Добавить(ТекСтрокаТовары.ИдентификаторСтроки, ПредставлениеСтроки);
		СтрокиМодификаторов = Объект.Модификаторы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекСтрокаТовары.ИдентификаторСтроки));
		Для каждого ТекСтрокаМодификаторов Из СтрокиМодификаторов Цикл
			ТекСтрокаМодификаторов.ИдентификаторСтрокиПредставление	= ПредставлениеСтроки;
			ТекСтрокаМодификаторов.НоменклатураОсновнойПозиции		= ТекСтрокаТовары.Номенклатура;
			ТекСтрокаМодификаторов.ХарактеристикаОсновнойПозиции	= ТекСтрокаТовары.Характеристика;
			ТекСтрокаМодификаторов.СерияОсновнойПозиции				= ТекСтрокаТовары.Серия;
			ТекСтрокаМодификаторов.НомерСтрокиОсновнойПозиции		= ТекСтрокаТовары.НомерСтроки;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры


// Процедура - Модификаторы модификатор при изменении на сервере.
//
// Параметры:
//  ДанныеСтрокиМодификаторов - Произвольный - Данные строки модификаторов.
//
&НаСервере
Процедура МодификаторыМодификаторПриИзмененииНаСервере(ДанныеСтрокиМодификаторов, КэшированныеЗначения)
	
	ДанныеСтрокиМодификаторов.Номенклатура = ДанныеСтрокиМодификаторов.Модификатор.ДопНоменклатура;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтрокиМодификаторов.Номенклатура) Тогда
		ДанныеСтрокиМодификаторов.Количество = 0;
		ДанныеСтрокиМодификаторов.Цена = 0;
		ДанныеСтрокиМодификаторов.Сумма = 0;
		Возврат;
	КонецЕсли;
	
	ДанныеСтрокиМодификаторов.УпаковкаНоменклатуры = ДанныеСтрокиМодификаторов.Модификатор.ЕдиницаИзмеренияНоменклатуры;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питМодификаторы.ДопНоменклатура,
		|	питМодификаторы.КоличествоУпаковокНоменклатуры,
		|	питМодификаторы.Цена,
		|	питМодификаторы.ЕдиницаИзмеренияНоменклатуры
		// |	питМодификаторы.Коэффициент
		|ИЗ
		|	Справочник.питМодификаторы КАК питМодификаторы
		|ГДЕ
		|	питМодификаторы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеСтрокиМодификаторов.Модификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если Выборка.Цена <> 0 Тогда
		ДанныеСтрокиМодификаторов.Цена = Выборка.Цена;
	Иначе
		// ищем цену по номенклатуре
	КонецЕсли;
	
	ПараметрыОбъекта = Новый Структура("Организация, Дата, Ссылка, СуммаВключаетНДС, ВалютаДокумента, ТипЦен");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
	МетаданныеДокумента = ПараметрыОбъекта.Ссылка.Метаданные();
	
	Если ДанныеСтрокиМодификаторов.Количество = 0 Тогда
		ДанныеСтрокиМодификаторов.Количество = 1;
	КонецЕсли;
	ДанныеСтрокиМодификаторов.КоличествоУпаковокНоменклатуры = ДанныеСтрокиМодификаторов.Количество * Выборка.КоличествоУпаковокНоменклатуры;
	//ДанныеСтрокиМодификаторов.Цена  = ДанныеСтрокиМодификаторов.Цена * ДанныеСтрокиМодификаторов.Количество;
	//ДанныеСтрокиМодификаторов.Сумма = ДанныеСтрокиМодификаторов.Цена * ДанныеСтрокиМодификаторов.КоличествоУпаковокНоменклатуры;
	ДанныеСтрокиМодификаторов.Сумма  = ДанныеСтрокиМодификаторов.Цена * ДанныеСтрокиМодификаторов.Количество;
	
	ДанныеСтрокиМодификаторов.Коэффициент = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьКоэффициентУпаковки(
												Выборка.ЕдиницаИзмеренияНоменклатуры,
												КэшированныеЗначения,
												Выборка.ДопНоменклатура).Коэффициент;
												
	ДанныеСтрокиМодификаторов.КоличествоНоменклатуры = ДанныеСтрокиМодификаторов.КоличествоУпаковокНоменклатуры * ДанныеСтрокиМодификаторов.Коэффициент;


КонецПроцедуры

// Получает сумму безналичной оплаты документа
//
// Возвращаемое значение:
//  Число. Сумма безналичной оплаты.
&НаСервере
Функция ПолучитьСуммуБезналичнойОплаты()
	СуммаБезналичнойОплаты = 0;
	Для каждого ТекСтрока Из объект.Оплаты Цикл
		Если ТекСтрока.ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.Наличные Тогда
			Продолжить;
		КонецЕсли;
		СуммаБезналичнойОплаты = СуммаБезналичнойОплаты + ТекСтрока.СуммаОплаты - ТекСтрока.Сдача;
	КонецЦикла;
	Возврат СуммаБезналичнойОплаты;
КонецФункции // ПолучитьСуммуБезналичнойОплаты()

// Возвращает сумму товаров и модификаторов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиенте
Функция ПолучитьИтоговуюСумму()
	Возврат Объект.Товары.Итог("Всего") + Объект.Модификаторы.Итог("Сумма");
КонецФункции

// Возвращает сумму полученных оплат
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьСуммуОплат()
	Возврат Объект.Оплаты.Итог("СуммаОплаты") - Объект.Оплаты.Итог("Сдача");
КонецФункции

// Процедура - Обновить итоги.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтоги(Форма)
	
	Объект = Форма.Объект;
	
	Форма.СуммаИтог = Объект.Товары.Итог("Всего") + Объект.Модификаторы.Итог("Сумма");
	Форма.СуммаОплат = Объект.Оплаты.Итог("СуммаОплаты") - Объект.Оплаты.Итог("Сдача");
	
	// Форма.СуммаИтог = Форма.ПолучитьИтоговуюСумму();
	// Форма.СуммаОплат  = Форма.ПолучитьСуммуОплат();
	// Форма.ИтогВсего    = Объект.Товары.Итог("Всего") + Объект.АгентскиеУслуги.Итог("Всего");
	// Форма.ТоварыИтогСуммаНДС = Объект.Товары.Итог("СуммаНДС") + Объект.АгентскиеУслуги.Итог("СуммаНДС");
	
КонецПроцедуры

// Пересчет табличной части документа после изменений в форме "Цены и валюта".
//  Выполняется пересчет колонок: цена, скидка, сумма, сумма НДС, всего.
//
&НаКлиенте
Процедура ОбработатьИзмененияПоКнопкеЦеныИВалюты()
	
	// Формируем структуру параметров для заполнения формы "Цены и Валюта".
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВалютаДокумента",      Объект.ВалютаДокумента);
	СтруктураПараметров.Вставить("Курс",                 Объект.КурсДокумента);
	СтруктураПараметров.Вставить("Кратность",            Объект.КратностьДокумента);
	СтруктураПараметров.Вставить("СуммаВключаетНДС",     Объект.СуммаВключаетНДС);
	СтруктураПараметров.Вставить("ДокументБезНДС",       Объект.ДокументБезНДС);
	СтруктураПараметров.Вставить("Организация",          Объект.Организация);
	СтруктураПараметров.Вставить("ДатаДокумента",        Объект.Дата);
	СтруктураПараметров.Вставить("ТипЦен",               Объект.ТипЦен);
	
	ДополнительныеПараметры = Новый Структура;
	
	Если ИспользоватьТипыЦенНоменклатуры Тогда 
		ОткрыватьИзМеню = Ложь;
	Иначе
		ОткрыватьИзМеню = Истина;
		ДополнительныеПараметры.Вставить("СтруктураПараметровКоманды", СтруктураПараметров);
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработатьИзмененияПоКнопкеЦеныИВалютыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ОткрыватьИзМеню Тогда
		
		СписокКоманд = Новый СписокЗначений;
		
		Если НЕ ПлательщикНДС Тогда
			СписокКоманд.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.ДокументБезНДС"));
		КонецЕсли;
		СписокКоманд.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.НДССверху"));
		СписокКоманд.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.НДСВСумме"));
		
		ПоказатьВыборИзМеню(ОповещениеОЗакрытии, СписокКоманд, Элементы.ЦеныИВалюта);
	Иначе
		ОткрытьФорму("ОбщаяФорма.ФормаЦеныИВалюта", СтруктураПараметров,,,,,ОповещениеОЗакрытии);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Сформировать надпись цены и валюта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьНадписьЦеныИВалюта(Форма)
	
	Объект = Форма.Объект;
	СтруктураНадписи = Новый Структура(
		"ВалютаДокумента, Курс, Кратность, СуммаВключаетНДС, ДокументБезНДС, ВалютаРегламентированногоУчета",
		Объект.ВалютаДокумента,
		Объект.КурсДокумента,
		Объект.КратностьДокумента,
		Объект.СуммаВключаетНДС,
		Объект.ДокументБезНДС,
		Форма.ВалютаРегламентированногоУчета);
	Если Форма.ИспользоватьТипыЦенНоменклатуры Тогда
		СтруктураНадписи.Вставить("ТипЦен", Объект.ТипЦен);
	КонецЕсли;
	Форма.ЦеныИВалюта = питОбщегоНазначенияКлиентСервер.СформироватьНадписьЦеныИВалюта(СтруктураНадписи);
	
КонецПроцедуры

// Процедура - Заполнить рассчитать суммы.
//
// Параметры:
//  Знач ВалютаДоИзменения - Произвольный - Знач валюта до изменения.
//  КурсДоИзменения - Произвольный - Курс до изменения.
//  КратностьДоИзменения - Произвольный - Кратность до изменения.
//  ПересчитатьНДС - Произвольный - Пересчитать ндс.
//
&НаСервере
Процедура ЗаполнитьРассчитатьСуммы(Знач ВалютаДоИзменения, КурсДоИзменения, КратностьДоИзменения, ПересчитатьНДС = Ложь);
	
	СписокНоменклатуры	= ОбщегоНазначения.ВыгрузитьКолонку(Объект.Товары, "Номенклатура", Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокНоменклатуры,
	ОбщегоНазначения.ВыгрузитьКолонку(Объект.Модификаторы, "Номенклатура"), Истина);
	
	ТаблицаЦенНоменклатуры = Новый ТаблицаЗначений;
	// Если ЗначениеЗаполнено(Объект.ТипЦен) Тогда	
	// 	ТаблицаЦенНоменклатуры = Ценообразование.ПолучитьТаблицуЦенНоменклатуры(
	// 		СписокНоменклатуры,
	// 		Объект.ТипЦен,
	// 		Объект.Дата);
	// Иначе
	// 	ТаблицаЦенНоменклатуры = Ценообразование.ПолучитьТаблицуЦенНоменклатурыДокументов(
	// 		СписокНоменклатуры,
	// 		Перечисления.СпособыЗаполненияЦен.ПоПродажнымЦенам,
	// 		Объект.Дата);
	// КонецЕсли;
	
	Если КурсДоИзменения <> 0 И КратностьДоИзменения <> 0 Тогда
		СтруктураКурса = Новый Структура("Курс, Кратность", КурсДоИзменения, КратностьДоИзменения);
	Иначе
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДоИзменения, Объект.Дата);
	КонецЕсли;
	
	Для Каждого Строка Из Объект.Товары Цикл
		ЗаполнитьРассчитатьСуммыВСтроке(Строка, ТаблицаЦенНоменклатуры, ВалютаДоИзменения, СтруктураКурса, ПересчитатьНДС, Истина, 0);
	КонецЦикла;
	Для Каждого Строка Из Объект.Модификаторы Цикл
		ЗаполнитьРассчитатьСуммыВСтроке(Строка, ТаблицаЦенНоменклатуры, ВалютаДоИзменения, СтруктураКурса, ПересчитатьНДС, Ложь, 0);
	КонецЦикла;
	
	УправлениеФормой(ЭтаФорма);
	ОбновитьИтоги(ЭтаФорма);
	
КонецПроцедуры

// Процедура - Заполнить рассчитать суммы в строке.
//
// Параметры:
//  Строка - Строка - Строка.
//  ТаблицаЦенНоменклатуры - ТаблицаЗначений - Таблица цен номенклатуры.
//  ВалютаПередИзменением - Произвольный - Валюта перед изменением.
//  СтруктураКурса - Структура - Структура курса.
//  ПересчитатьНДС - Произвольный - Пересчитать ндс.
//  ЕстьНДС - Произвольный - Есть ндс.
//  ЗначениеПустогоКоличества - Произвольный - Значение пустого количества.
//
&НаСервере
Процедура ЗаполнитьРассчитатьСуммыВСтроке(Строка, ТаблицаЦенНоменклатуры, ВалютаПередИзменением, СтруктураКурса, ПересчитатьНДС, ЕстьНДС, ЗначениеПустогоКоличества)
	
	НайденнаяСтрока	= ТаблицаЦенНоменклатуры.Найти(Строка.Номенклатура, "Номенклатура");
	Если НайденнаяСтрока <> Неопределено Тогда
		Цена = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(НайденнаяСтрока.Цена,
			Новый Структура("Валюта, Курс, Кратность", НайденнаяСтрока.Валюта, НайденнаяСтрока.Курс, НайденнаяСтрока.Кратность),
			Новый Структура("Валюта, Курс, Кратность", Объект.ВалютаДокумента, Объект.КурсДокумента, Объект.КратностьДокумента));
		Если Строка.Свойство("Коэффициент") Тогда
			Цена = Цена * Строка.Коэффициент;
		КонецЕсли;
		ЦенаВключаетНДС = НайденнаяСтрока.ЦенаВключаетНДС;
	Иначе
		Цена = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Строка.Цена,
			Новый Структура("Валюта, Курс, Кратность", ВалютаПередИзменением, СтруктураКурса.Курс, СтруктураКурса.Кратность),
			Новый Структура("Валюта, Курс, Кратность", Объект.ВалютаДокумента, Объект.КурсДокумента, Объект.КратностьДокумента));
		ЦенаВключаетНДС = ?(ПересчитатьНДС, НЕ Объект.СуммаВключаетНДС, Объект.СуммаВключаетНДС);
	КонецЕсли;
	
	Если ЕстьНДС Тогда
		
		Если Объект.ДокументБезНДС Тогда
			Если НЕ питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
				Строка.СтавкаНДС = УчетНДСЛокализация.СтавкаНДСПоПеречислению(Перечисления.СтавкиНДС.БезНДС);
			Иначе
				Строка.СтавкаНДС = питОбщегоНазначения.СтавкаНДСПоЧислу();
			КонецЕсли;
		КонецЕсли;
		
		Строка.Цена = питОбщегоНазначения.ПересчитатьЦенуПриИзмененииФлаговНалогов(
			Цена, ЦенаВключаетНДС, Объект.СуммаВключаетНДС, УчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(Строка.СтавкаНДС));
		
		Строка.Сумма = Строка.Цена * ?(Строка.Количество = 0, ЗначениеПустогоКоличества, Строка.Количество);
		Строка.СуммаНДС = ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Строка.Сумма, Строка.СтавкаНДС, Объект.СуммаВключаетНДС);
		Строка.Всего = Строка.Сумма + ?(Объект.СуммаВключаетНДС, 0, Строка.СуммаНДС) - ПолучитьСуммуСкидки(Строка);
		
	Иначе
		Строка.Цена = Цена;
		Строка.Сумма = Строка.Цена * ?(Строка.Количество = 0, ЗначениеПустогоКоличества, Строка.Количество);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - При изменении количество цена.
//
// Параметры:
//  ИмяТабЧасти - Произвольный - Имя таб части.
//
&НаКлиенте
Процедура ПриИзмененииКоличествоЦена(ИмяТабЧасти)
	
	ТекущиеДанные = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	Если ИмяТабЧасти = "Модификаторы" Тогда
		ЗначениеПустогоКоличества = 1;
	Иначе
		ЗначениеПустогоКоличества = 0;
	КонецЕсли;
	питОбщегоНазначенияКлиентСервер.РассчитатьСуммуТабЧасти(ТекущиеДанные, ЗначениеПустогоКоличества, "КоличествоУпаковок");
		
	Если ТекущиеДанные.Свойство("СуммаВРознице") Тогда
		ТекущиеДанные.СуммаВРознице = ТекущиеДанные.Количество * ТекущиеДанные.ЦенаВРознице;
	КонецЕсли;
	
	ПолучитьСуммуВсегоСтроки(ТекущиеДанные, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

// Процедура - При изменении сумма.
//
// Параметры:
//  ИмяТабЧасти - Произвольный - Имя таб части.
//
&НаКлиенте
Процедура ПриИзмененииСумма(ИмяТабЧасти)
	
	ТекущиеДанные = Элементы[ИмяТабЧасти].ТекущиеДанные;
	Если ТекущиеДанные.Количество = 0 Тогда
		Если ИмяТабЧасти = "Модификаторы" Тогда
			ТекущиеДанные.Цена = ТекущиеДанные.Сумма;
		Иначе
			ТекущиеДанные.Цена = 0;
		КонецЕсли;
	Иначе
		ТекущиеДанные.Цена = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
	КонецЕсли;
		
	ПолучитьСуммуВсегоСтроки(ТекущиеДанные, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

// Процедура - При изменении ставка ндс.
//
// Параметры:
//  ИмяТабЧасти - Произвольный - Имя таб части.
//
&НаКлиенте
Процедура ПриИзмененииСтавкаНДС(ИмяТабЧасти)
	
	ТекущиеДанные = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	ПолучитьСуммуВсегоСтроки(ТекущиеДанные, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

// Процедура - При изменении сумма ндс.
//
// Параметры:
//  ИмяТабЧасти - Произвольный - Имя таб части.
//
&НаКлиенте
Процедура ПриИзмененииСуммаНДС(ИмяТабЧасти)
	
	ТекущиеДанные = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	ПолучитьСуммуВсегоСтроки(ТекущиеДанные, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

// Процедура - При изменении суммы скидок.
//
// Параметры:
//  ИмяТабЧасти - Произвольный - Имя таб части.
//
&НаКлиенте
Процедура ПриИзмененииСуммыСкидок(ИмяТабЧасти)
	
	ТекущиеДанные = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	Если ТекущиеДанные.Свойство("СуммаСкидки") Тогда
		ТекущиеДанные.ПроцентСкидки = ?(ТекущиеДанные.Сумма=0, 0, Окр(ТекущиеДанные.СуммаСкидки * 100 / ТекущиеДанные.Сумма, 2));
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("СуммаСкидкиСтроки") Тогда
		ТекущиеДанные.ПроцентСкидкиСтроки = ?(ТекущиеДанные.Сумма=0, 0, Окр(ТекущиеДанные.СуммаСкидкиСтроки * 100 / ТекущиеДанные.Сумма, 2));
	КонецЕсли;
	
	ПолучитьСуммуВсегоСтроки(ТекущиеДанные, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

// Процедура - При изменении процента скидок.
//
// Параметры:
//  ИмяТабЧасти - Произвольный - Имя таб части.
//
&НаКлиенте
Процедура ПриИзмененииПроцентаСкидок(ИмяТабЧасти)
	
	ТекущиеДанные = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	Если ТекущиеДанные.Свойство("ПроцентСкидки") Тогда
		Если ТекущиеДанные.ПроцентСкидки>100 Тогда
			ТекущиеДанные.ПроцентСкидки = 100;
		ИначеЕсли ТекущиеДанные.ПроцентСкидки<0 Тогда
			ТекущиеДанные.ПроцентСкидки = 0;
		КонецЕсли;
		
		ТекущиеДанные.СуммаСкидки = Окр(ТекущиеДанные.Сумма * ТекущиеДанные.ПроцентСкидки / 100,2);
		
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("ПроцентСкидкиСтроки") Тогда
		Если ТекущиеДанные.ПроцентСкидкиСтроки>100 Тогда
			ТекущиеДанные.ПроцентСкидкиСтроки = 100;
		ИначеЕсли ТекущиеДанные.ПроцентСкидкиСтроки<0 Тогда
			ТекущиеДанные.ПроцентСкидкиСтроки = 0;
		КонецЕсли;
		
		ТекущиеДанные.СуммаСкидкиСтроки = Окр(ТекущиеДанные.Сумма * ТекущиеДанные.ПроцентСкидкиСтроки / 100,2);
		
	КонецЕсли;
	
	ПолучитьСуммуВсегоСтроки(ТекущиеДанные, Объект.СуммаВключаетНДС);
	
КонецПроцедуры

// Функция - Получить сумму скидки.
//
// Параметры:
//  ТекущиеДанные - Произвольный - Текущие данные.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСуммуСкидки(ТекущиеДанные)
	
	ИтоговаяСуммаСкидки = 0;
	Если ТекущиеДанные.Свойство("СуммаСкидки") Тогда
		ИтоговаяСуммаСкидки = ИтоговаяСуммаСкидки + ТекущиеДанные.СуммаСкидки;
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("СуммаСкидкиСтроки") Тогда
		ИтоговаяСуммаСкидки = ИтоговаяСуммаСкидки + ТекущиеДанные.СуммаСкидкиСтроки;
	КонецЕсли;

	Возврат ИтоговаяСуммаСкидки;
КонецФункции


// Процедура - Заполнить добавленные колонки таблицы товары.
//
&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицыТовары()
	
	Для каждого СтрокаТаблицы Из Объект.Товары Цикл
		ПолучитьСуммуВсегоСтроки(СтрокаТаблицы, Объект.СуммаВключаетНДС);
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Элементы.Подразделение.Доступность = ЗначениеЗаполнено(Объект.Организация);
	
	СформироватьНадписьЦеныИВалюта(Форма);
	
	Элементы.ДокументПродажи.Видимость = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.питХозяйственныеОперации.ДанныеПродажФронтаВозврат");
	Элементы.ТоварыИтогСуммаНДС.Видимость = Не Объект.ДокументБезНДС;
	
	ОбновитьИтоги(Форма);
	
КонецПроцедуры

// Процедура - Дата при изменении на сервере.
//
&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	Если (Объект.ВалютаДокумента <> ВалютаРегламентированногоУчета) Тогда
		СтруктураКурсаДокумента   = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
		Объект.КурсДокумента      = СтруктураКурсаДокумента.Курс;
		Объект.КратностьДокумента = СтруктураКурсаДокумента.Кратность;
	КонецЕсли;
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

// Процедура - Организация при изменении на сервере.
//
&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	Если ПлательщикНДС Тогда 
		Объект.ДокументБезНДС = Ложь;
	КонецЕсли;
	
	УстановитьПараметрыВыбораВидаОплаты();
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

// Процедура - Установить параметры выбора вида оплаты.
//
&НаСервере
Процедура УстановитьПараметрыВыбораВидаОплаты()
	
	ТипыОплатБезналичныеОплаты = Новый Массив;
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.ПлатежнаяКарта);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.БанковскийКредит);
	
	// В Перечисления.питТипыОплат стало больше значений, поэтому изменился фильтр.
	// Организация заполнена только для типов оплат ПлатежнаяКарта или БанковскийКредит.
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.Наличные);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питКлубнаяКарта);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питПитаниеСотрудников);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питТалоныИКупоны);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питЗаСчетЗаведения);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питБонусы);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питЗачетАванса);
	
	Если ИспользуютсяПодарочныеСертификаты Тогда
		ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.ПодарочныйСертификатСобственный);
		Если ПрименяютсяДоговораСКомитентамиНаПродажу Тогда
			ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.ПодарочныйСертификатСторонний);
		КонецЕсли;
	КонецЕсли;
	
	МассивОрганизаций = Новый Массив;
	МассивОрганизаций.Добавить(Объект.Организация);
	МассивОрганизаций.Добавить(Справочники.Организации.ПустаяСсылка());
	
	ПараметрыБезналичныхОплат = Новый Массив;
	
	ПараметрыБезналичныхОплат.Добавить(Новый ПараметрВыбора("Отбор.ТипОплаты", Новый ФиксированныйМассив(ТипыОплатБезналичныеОплаты)));
	ПараметрыБезналичныхОплат.Добавить(Новый ПараметрВыбора("Отбор.Организация", Новый ФиксированныйМассив(МассивОрганизаций)));
	
	Элементы.ОплатыВидОплаты.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыБезналичныхОплат);
	
КонецПроцедуры

// Процедура - Установить условное оформление.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// ОбщептЕРП. Есть установленные в форме, пока не очищаем.  
	// УсловноеОформление.Элементы.Очистить();
	
	ДополнительныеПараметры = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ДополнительныеПараметры.Вставить("ПутьКПолюУпаковка", "Объект.Товары.Упаковка");
	ДополнительныеПараметры.Вставить("ИмяПоляЕдиницаИзмерения", "ТоварыНоменклатураЕдиницаИзмерения");
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтаФорма, ДополнительныеПараметры);
	
	ДополнительныеПараметры.Вставить("ПутьКПолюУпаковка", "Объект.Модификаторы.УпаковкаНоменклатуры");
	ДополнительныеПараметры.Вставить("ИмяПоляЕдиницаИзмерения", "МодификаторыНоменклатураЕдиницаИзмерения");
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтаФорма, ДополнительныеПараметры);

	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
		"ТоварыХарактеристика",
		"Объект.Товары.ХарактеристикиИспользуются");
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
		"МодификаторыХарактеристика",
		"Объект.Модификаторы.ХарактеристикиИспользуются");
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
		"МодификаторыХарактеристикаОсновнойПозиции",
		"Объект.Модификаторы.ХарактеристикиОсновнойПозицииИспользуются");
	
	// +Серии
	#Область Серии
	
	НоменклатураСервер.УстановитьУсловноеОформлениеСтатусовУказанияСерий(ЭтаФорма, Ложь, "ТоварыСтатусУказанияСерий", "Объект.Товары.СтатусУказанияСерий");
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма, Ложь, "ТоварыСерия", "Объект.Товары.СтатусУказанияСерий", "Объект.Товары.ТипНоменклатуры");
	
	НоменклатураСервер.УстановитьУсловноеОформлениеСтатусовУказанияСерий(ЭтаФорма, Ложь, "МодификаторыСтатусУказанияСерий", "Объект.Модификаторы.СтатусУказанияСерий");
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма, Ложь, "МодификаторыСерия", "Объект.Модификаторы.СтатусУказанияСерий", "Объект.Модификаторы.ТипНоменклатуры");
	
	#КонецОбласти
	// -Серии
	
КонецПроцедуры

// Процедура - Получить сумму всего строки.
//
// Параметры:
//  ТекущиеДанные - Произвольный - Текущие данные.
//  СуммаВключаетНДС - Произвольный - Сумма включает ндс.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ПолучитьСуммуВсегоСтроки(ТекущиеДанные, СуммаВключаетНДС)
	
	Если СуммаВключаетНДС Тогда
		СуммаНДС = 0;
	ИначеЕсли ТекущиеДанные.Свойство("СуммаНДС") Тогда
		питОбщегоНазначенияКлиентСервер.РассчитатьСуммуНДСТабЧасти(ТекущиеДанные, СуммаВключаетНДС);
		СуммаНДС = ТекущиеДанные.СуммаНДС;
	Иначе
		СуммаНДС = 0;
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("Всего") Тогда
		ТекущиеДанные.Всего = ТекущиеДанные.Сумма + СуммаНДС - ПолучитьСуммуСкидки(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
		Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
		Новый Структура("Номенклатура", "ТипНоменклатуры"));
		
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Модификаторы,	ПараметрыЗаполненияРеквизитов);
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("НоменклатураОсновнойПозиции", "ХарактеристикиОсновнойПозицииИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
											
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Модификаторы,	ПараметрыЗаполненияРеквизитов);
	
КонецПроцедуры

// Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИмяСклад - Произвольный - Имя склад.
//
&НаКлиенте
Процедура ТаблицаНоменклатураПриИзменении(ИмяТЧ, ИмяСклад = Неопределено)
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
	
	// +Серии
	Если ИмяСклад = Неопределено Тогда
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, Объект.Склад, ПараметрыУказанияСерий[ИмяТЧ]);
	Иначе
		ДобавитьВСтруктуруДействияПоСериям(СтруктураДействий, ТекущаяСтрока[ИмяСклад], ПараметрыУказанияСерий[ИмяТЧ]);
	КонецЕсли;
	// -Серии
	
	Если ИмяТЧ = "Товары" Тогда
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

// Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий)
	
	Объект = Форма.Объект;
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		Форма.ИмяФормы, ИмяТЧ));
		
	Если ИмяТЧ = "Модификаторы" Тогда
		
		Если Форма.Элементы[ИмяТЧ].ТекущийЭлемент = Форма.Элементы.МодификаторыНоменклатураОсновнойПозиции
			ИЛИ Форма.Элементы[ИмяТЧ].ТекущийЭлемент = Форма.Элементы.МодификаторыХарактеристикаОсновнойПозиции 
			ИЛИ Форма.Элементы[ИмяТЧ].ТекущийЭлемент = Форма.Элементы.МодификаторыИдентификаторСтроки Тогда
			СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
			Новый Структура("НоменклатураОсновнойПозиции", "ХарактеристикиОсновнойПозицииИспользуются"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Добавить в структуру действия при изменении количества упаковок.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчета);
	
КонецПроцедуры

// Функция - Получить данные основной позиции по идентификатору строки.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
&НаСервере
Функция ПолучитьДанныеОсновнойПозицииПоИдентификаторуСтроки(ИдентификаторСтроки)
	
	Результат = Неопределено;
	
	НайденныеТовары = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
	Если НайденныеТовары.Количество() Тогда
		Результат = Новый Структура("НомерСтроки,Номенклатура,Характеристика,Серия");
		ЗаполнитьЗначенияСвойств(Результат, НайденныеТовары[0]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура - Модификаторы количество при изменении.
//
// Параметры:
//  Элемент - Элемент - Элемент формы.
//
&НаКлиенте
Процедура МодификаторыКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы.Модификаторы.ТекущиеДанные; 
	
	ДанныеМодификатора = ВернутьДанныеМодификатораНаСервере(Элементы.Модификаторы.ТекущиеДанные.Модификатор, КэшированныеЗначения);
	

	ТекДанные.КоличествоУпаковокНоменклатуры = ТекДанные.Количество * ДанныеМодификатора.КоличествоУпаковокНоменклатуры;
	ТекДанные.Сумма                          = ТекДанные.Количество * ТекДанные.Цена;
	ТекДанные.Коэффициент = ДанныеМодификатора.Коэффициент;
	ТекДанные.КоличествоНоменклатуры = ТекДанные.КоличествоУпаковокНоменклатуры * ТекДанные.Коэффициент;
	
КонецПроцедуры 

// Функция - Вернуть данные модификатора.
//
// Параметры:
//  Модификатор - СправочникСсылка.питМодификаторы - модифифкатор
//
// Возвращаемое значение:
//  Структура - содержит данные модификатора.
&НаСервере
Функция ВернутьДанныеМодификатораНаСервере(Модификатор, КэшированныеЗначения)
	Результат = Новый Структура("ДопНоменклатура, КоличествоУпаковокНоменклатуры, Цена, ЕдиницаИзмеренияНоменклатуры, Коэффициент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	питМодификаторы.ДопНоменклатура,
		|	питМодификаторы.КоличествоУпаковокНоменклатуры,
		|	питМодификаторы.Цена,
		|	питМодификаторы.ЕдиницаИзмеренияНоменклатуры
		|ИЗ
		|	Справочник.питМодификаторы КАК питМодификаторы
		|ГДЕ
		|	питМодификаторы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Модификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Результат.Коэффициент = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьКоэффициентУпаковки(
												Результат.ЕдиницаИзмеренияНоменклатуры,
												КэшированныеЗначения,
												Результат.ДопНоменклатура).Коэффициент;


	
	Возврат Результат;
	
КонецФункции


#КонецОбласти









