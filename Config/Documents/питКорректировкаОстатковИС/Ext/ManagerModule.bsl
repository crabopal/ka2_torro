#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// Определяет список команд заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Таблица с командами заполнения.
//  Параметры - Структура - Вспомогательные параметры. Для чтения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения, Параметры) Экспорт
	
КонецПроцедуры

#КонецОбласти

#Область Проведение

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
//  Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры:
//  ДокументСсылка - Произвольный - Документ ссылка.
//  СтруктураДополнительныеСвойства - Структура - Структура дополнительные свойства.
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ВидыПродукции = питОтраслевыеРешения.ВидыПродукцииДоступныеДляОтраженияОстатковИС();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыПродукцииИС", ВидыПродукции);
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Шапка.Дата КАК Период,
	|	Шапка.Организация КАК Организация,
	|	ВТ_Товары.МестоПечати КАК МестоПечати,
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	СУММА(ВТ_Товары.Количество) КАК Количество,
	|	ВТ_Товары.ШтрихкодУпаковки КАК Штрихкод,
	|	ВТ_Товары.Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&ОпределениеВидаПродукции КАК ВидПродукцииИС,
	|	ВЫБОР
	|		КОГДА Шапка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.КорректировкаОстатковИСПриготовление)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.Приготовление)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.Корректировка)
	|	КОНЕЦ КАК ВидДвиженияМарок
	|ПОМЕСТИТЬ ВТ_Запасы
	|ИЗ
	|	Документ.питКорректировкаОстатковИС КАК Шапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.питКорректировкаОстатковИС.Запасы КАК ВТ_Товары
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ПО ВТ_Товары.Номенклатура = СпрНоменклатура.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|			ПО ВТ_Товары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|		ПО Шапка.Ссылка = ВТ_Товары.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|	И НЕ ВТ_Товары.ШтрихкодУпаковки = ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка)
	|	И &ВидПродукцииИС_УсловиеОтбораДоступа
	|
	|СГРУППИРОВАТЬ ПО
	|	Шапка.Дата,
	|	Шапка.Организация,
	|	ВТ_Товары.МестоПечати,
	|	ВТ_Товары.Номенклатура,
	|	ВТ_Товары.АлкогольнаяПродукция,
	|	ВТ_Товары.ШтрихкодУпаковки,
	|	ВТ_Товары.Ссылка,
	|	&ОпределениеВидаПродукции,
	|	ВЫБОР
	|		КОГДА Шапка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.питХозяйственныеОперации.КорректировкаОстатковИСПриготовление)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.Приготовление)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.питВидыДвиженийОстатковМарокИС.Корректировка)
	|	КОНЕЦ
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_Товары.Количество) <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Запасы.Период КАК Период,
	|	ВТ_Запасы.Организация КАК Организация,
	|	ВТ_Запасы.МестоПечати КАК МестоПечати,
	|	ВТ_Запасы.Номенклатура КАК Номенклатура,
	|	ВТ_Запасы.Количество КАК Количество,
	|	ВТ_Запасы.Штрихкод КАК Штрихкод,
	|	ВТ_Запасы.Регистратор КАК Регистратор,
	|	ВТ_Запасы.ВидДвижения КАК ВидДвижения,
	|	ВТ_Запасы.ВидДвиженияМарок КАК ВидДвиженияМарок,
	|	ВТ_Запасы.ВидПродукцииИС КАК ВидПродукцииИС
	|ИЗ
	|	ВТ_Запасы КАК ВТ_Запасы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиМарок.Организация КАК Организация,
	|	ОстаткиМарок.МестоПечати КАК МестоПечати,
	|	ОстаткиМарок.Номенклатура КАК Номенклатура,
	|	ОстаткиМарок.Штрихкод КАК Штрихкод,
	|	ОстаткиМарок.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ДвиженияПослеЗаписи
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС.Остатки(
	|			&МоментКонтроля,
	|			(Организация, МестоПечати, Номенклатура, Штрихкод) В
	|				(ВЫБРАТЬ
	|					ВТ_Запасы.Организация КАК Организация,
	|					ВТ_Запасы.МестоПечати КАК МестоПечати,
	|					ВТ_Запасы.Номенклатура КАК Номенклатура,
	|					ВТ_Запасы.Штрихкод КАК Штрихкод
	|				ИЗ
	|					ВТ_Запасы КАК ВТ_Запасы)) КАК ОстаткиМарок
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СуществующиеЗаписиДокумента.Организация,
	|	СуществующиеЗаписиДокумента.МестоПечати,
	|	СуществующиеЗаписиДокумента.Номенклатура,
	|	СуществующиеЗаписиДокумента.Штрихкод,
	|	ВЫБОР
	|		КОГДА СуществующиеЗаписиДокумента.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА -СуществующиеЗаписиДокумента.Количество
	|		ИНАЧЕ СуществующиеЗаписиДокумента.Количество
	|	КОНЕЦ
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС КАК СуществующиеЗаписиДокумента
	|ГДЕ
	|	СуществующиеЗаписиДокумента.Регистратор = &Ссылка
	|	И СуществующиеЗаписиДокумента.Период <= &ПериодКонтроля
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Запасы.Организация,
	|	ВТ_Запасы.МестоПечати,
	|	ВТ_Запасы.Номенклатура,
	|	ВТ_Запасы.Штрихкод,
	|	ВТ_Запасы.Количество
	|ИЗ
	|	ВТ_Запасы КАК ВТ_Запасы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвиженияПослеЗаписи.Организация КАК Организация,
	|	ДвиженияПослеЗаписи.МестоПечати КАК МестоПечати,
	|	ДвиженияПослеЗаписи.Номенклатура КАК Номенклатура,
	|	ДвиженияПослеЗаписи.Штрихкод КАК КодМаркировки,
	|	СУММА(ДвиженияПослеЗаписи.Количество) КАК Количество
	|ИЗ
	|	ДвиженияПослеЗаписи КАК ДвиженияПослеЗаписи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО ДвиженияПослеЗаписи.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	&ВидПродукцииИС_УсловиеОтбораЭтоПиво
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияПослеЗаписи.Организация,
	|	ДвиженияПослеЗаписи.МестоПечати,
	|	ДвиженияПослеЗаписи.Номенклатура,
	|	ДвиженияПослеЗаписи.Штрихкод
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДвиженияПослеЗаписи.Количество) <= 0";
	
	Запрос.УстановитьПараметр("МоментКонтроля", Новый Граница(СтруктураДополнительныеСвойства.ДляПроведения.МоментВремени, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодКонтроля", СтруктураДополнительныеСвойства.ДляПроведения.МоментВремени.Дата);
	
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(Запрос.Текст);
	
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		ВидыПродукции,,
		"&ВидПродукцииИС_УсловиеОтбораДоступа");
	питИнтеграцияИСМП.ЗаполнитьУсловиеВидаПродукцииИСВЗапросе(Запрос, 
		питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПива(),,
		"&ВидПродукцииИС_УсловиеОтбораЭтоПиво");
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаОстаткиМарокИС = питОбщегоНазначения.ВыгрузитьРезультатЗапроса(РезультатЗапроса[1]);
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("питОстаткиМарокИС", ТаблицаОстаткиМарокИС);
	
	Если РезультатЗапроса[3].Пустой() Тогда
		Возврат;
	КонецЕсли;
	// Выполним автоматическое отключение кеги.
	ТаблицаКодовМаркировки = РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.НоваяТаблицаОтключенияВскрытыхПотребительскихУпаковок();
	
	Выборка = РезультатЗапроса[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаКодовМаркировки.Добавить();
		НоваяСтрока.КодМаркировки = Выборка.КодМаркировки;
	КонецЦикла;

	Если ЗначениеЗаполнено(ТаблицаКодовМаркировки) Тогда
		РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.ОтключитьВскрытыеПотребительскиеУпаковки(ТаблицаКодовМаркировки);
	КонецЕсли;
КонецПроцедуры

// Выполняет контроль возникновения отрицательных остатков.
//
// Параметры:
//  ДокументСсылкаКорректировкаОстатков - Произвольный - Документ ссылка корректировка остатков.
//  ДополнительныеСвойства - Произвольный - Дополнительные свойства.
//  Отказ - Булево - Отказ.
//  УдалениеПроведения - Произвольный - Удаление проведения.
//
Процедура ВыполнитьКонтроль(ДокументСсылкаКорректировкаОстатков, ДополнительныеСвойства, Отказ, УдалениеПроведения = Ложь) Экспорт
	
	Если (НЕ ПараметрыСеанса.ПроводитьБезКонтроляОстатковТоваровОрганизаций 
		И Константы.КонтролироватьОстаткиТоваровОрганизаций.Получить()) Тогда
		Возврат;
	КонецЕсли;

	СтруктураВременныеТаблицы = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы;
	
	// Если временные таблицы "ДвиженияЗаказыНаПроизводствоИзменение", 
	// "ДвиженияРазмещениеЗаказовИзменение", "ДвиженияЗапасыИзменение"
	// содержат записи, необходимо выполнить контроль реализации товаров.
	
	Если СтруктураВременныеТаблицы.Свойство("ДвиженияОстаткиМарокИСИзменение")
		И СтруктураВременныеТаблицы.ДвиженияОстаткиМарокИСИзменение Тогда 
		
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	ДвиженияОстаткиМарокИСИзменение.НомерСтроки КАК НомерСтроки,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ДвиженияОстаткиМарокИСИзменение.Организация) КАК ОрганизацияПредставление,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ДвиженияОстаткиМарокИСИзменение.МестоПечати) КАК МестоПечатиПредставление,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ДвиженияОстаткиМарокИСИзменение.Номенклатура) КАК НоменклатураПредставление,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ДвиженияОстаткиМарокИСИзменение.Штрихкод) КАК ШтрихкодПредставление,
		|	ЕСТЬNULL(ДвиженияОстаткиМарокИСИзменение.КоличествоИзменение, 0)
		|		+ ЕСТЬNULL(ЗапасыОстаткиМарокИСОстатки.КоличествоОстаток, 0) КАК Остаток,
		|	ЕСТЬNULL(ЗапасыОстаткиМарокИСОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
		|ИЗ
		|	ДвиженияОстаткиМарокИСИзменение КАК ДвиженияОстаткиМарокИСИзменение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.питОстаткиМарокИС.Остатки(
		|				&МоментКонтроля,
		|				(Организация, МестоПечати, Номенклатура, Штрихкод) В
		|					(ВЫБРАТЬ
		|						ДвиженияОстаткиМарокИСИзменение.Организация КАК Организация,
		|						ДвиженияОстаткиМарокИСИзменение.МестоПечати КАК МестоПечати,
		|						ДвиженияОстаткиМарокИСИзменение.Номенклатура КАК Номенклатура,
		|						ДвиженияОстаткиМарокИСИзменение.Штрихкод КАК Штрихкод
		|					ИЗ
		|						ДвиженияОстаткиМарокИСИзменение КАК ДвиженияОстаткиМарокИСИзменение)) КАК ЗапасыОстаткиМарокИСОстатки
		|		ПО ДвиженияОстаткиМарокИСИзменение.Организация = ЗапасыОстаткиМарокИСОстатки.Организация
		|			И ДвиженияОстаткиМарокИСИзменение.МестоПечати = ЗапасыОстаткиМарокИСОстатки.МестоПечати
		|			И ДвиженияОстаткиМарокИСИзменение.Номенклатура = ЗапасыОстаткиМарокИСОстатки.Номенклатура
		|			И ДвиженияОстаткиМарокИСИзменение.Штрихкод = ЗапасыОстаткиМарокИСОстатки.Штрихкод
		|ГДЕ
		|	ЕСТЬNULL(ЗапасыОстаткиМарокИСОстатки.КоличествоОстаток, 0) < 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки");
		
		Запрос.МенеджерВременныхТаблиц = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("МоментКонтроля", ДополнительныеСвойства.ДляПроведения.МоментКонтроля);
			
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		// Отрицательный остаток по сериям номенклатуры к расходу.
		Если НЕ МассивРезультатов[0].Пустой() Тогда
			ДокументОбъектКорректировкаОстатковОбъект = ДокументСсылкаКорректировкаОстатков.ПолучитьОбъект();
			ВыборкаИзРезультатаЗапроса = МассивРезультатов[0].Выбрать();
			ОстаткиМарокИС(ДокументОбъектКорректировкаОстатковОбъект, ВыборкаИзРезультатаЗапроса, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьКонтроль()

// Сообщает об ошибках проведения по регистру Размещение заказов.
//
// Параметры:
//  ДокОбъект - ДокументОбъект - проводимый документ.
//  ВыборкаЗаписей - ВыборкаИзРезультатаЗапроса - выборка из результата запроса контроля остатков.
//  Отказ - Булево - признак наличия ошибок.
//
Процедура ОстаткиМарокИС(ДокОбъект, ВыборкаЗаписей, Отказ) Экспорт
	
	ЗаголовокОшибки = НСтр("ru = 'Ошибка:'");
	ТекстЗаголовкаСообщения = ЗаголовокОшибки + Символы.ПС + НСтр(
		"ru = 'Обнаружена нехватка марок ИС. Требуется оформление вскрытия алкоголя'");
	ОбщегоНазначения.СообщитьПользователю(ТекстЗаголовкаСообщения, ДокОбъект, , , Отказ);
		
	ШаблонСообщения = НСтр("ru = 'Номенклатура: %НоменклатураХарактеристикаПартия%,
		|остаток %КоличествоОстаток% мл
		|недостаточно %Количество% мл'");
		
	Пока ВыборкаЗаписей.Следующий() Цикл
		
		ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%НоменклатураХарактеристикаПартия%", ВыборкаЗаписей.НоменклатураПредставление);
		
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КоличествоОстаток%", ВыборкаЗаписей.Остаток);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Количество%", -ВыборкаЗаписей.КоличествоОстаток);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокОбъект, , , Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

