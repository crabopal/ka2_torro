#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// В обработчике события ОбработкаЗаполнения документа выполняется
//  - заполнение документа по инвентаризации запасов на складе.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	СтратегияЗаполнения = Новый Соответствие;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированныйУчетПодсистемы") Тогда
		МодульЗаполнениеДокументов = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеДокументов");
		МодульЗаполнениеДокументов.Заполнить(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
	ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.КорректировкаОстатковИСКорректировкаОстатков;
	
КонецПроцедуры // ОбработкаЗаполнения()

// Процедура - обработчик события ОбработкаПроведения объекта.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	СтруктураДополнительныеСвойства = Новый Структура;
	СтруктураДополнительныеСвойства.Вставить("ТаблицыДляДвижений", Новый Структура);
	СтруктураДополнительныеСвойства.Вставить("ДляПроведения", Новый Структура);
	СтруктураДополнительныеСвойства.ДляПроведения.Вставить("МоментВремени", МоментВремени());
	СтруктураДополнительныеСвойства.ДляПроведения.Вставить("МоментКонтроля", МоментВремени());
	СтруктураДополнительныеСвойства.ДляПроведения.Вставить("СтруктураВременныеТаблицы", Новый Структура);
	Документы.питКорректировкаОстатковИС.ИнициализироватьДанныеДокумента(ЭтотОбъект.Ссылка, СтруктураДополнительныеСвойства);
	
	Для каждого КлючИЗначение Из СтруктураДополнительныеСвойства.ТаблицыДляДвижений Цикл
		ДвжиенияРегистр = Движения[КлючИЗначение.Ключ];
		ДвжиенияРегистр.Записывать = Истина;
		ДвжиенияРегистр.Загрузить(КлючИЗначение.Значение);
	КонецЦикла;
	
	Движения.Записать();
	
	Если ДополнительныеСвойства.Свойство("питРазрешитьЗаписьТиповогоДокумента") Тогда
		// Контроль
		Документы.питКорректировкаОстатковИС.ВыполнитьКонтроль(Ссылка, СтруктураДополнительныеСвойства, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - При копировании.
//
// Параметры:
//  ОбъектКопирования - Произвольный - Объект копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	ПереданВЕГАИС = Неопределено;
	АктСписанияЕГАИС = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");

#КонецЕсли
