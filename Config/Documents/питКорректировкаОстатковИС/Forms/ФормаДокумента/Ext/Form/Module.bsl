&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

//@skip-check module-unused-method
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура вызывает обработку заполнения документа по основанию.
//
&НаСервере
Процедура ЗаполнитьПоДокументу(ДокументОснование)
	
	Документ = РеквизитФормыВЗначение("Объект");
	Документ.Заполнить(ДокументОснование);
	ЗначениеВРеквизитФормы(Документ, "Объект");
	Модифицированность = Истина;
	
КонецПроцедуры // ЗаполнитьПоДокументу()

&НаКлиенте
Асинх Процедура НачатьЗаполнениеТаблицыЗапасов(РежимЗаполнения)
	
	Если ЗначениеЗаполнено(Объект.Запасы) Тогда
		
		ОтветПользователя = Ждать ВопросАсинх(НСтр("ru='Таблица запасов не пустая. Очистить?'"), 
			РежимДиалогаВопрос.ДаНет);
		Если ОтветПользователя = КодВозвратаДиалога.Да Тогда
			Объект.Запасы.Очистить();
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьТаблицуЗапасов(РежимЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЗапасов(РежимЗаполнения)
	
	ДоступныеМестаПечати = Справочники.питМестаПечати.МестаПечатиПоСтруктурнойЕдинице(Объект.Склад);

	ДатаФормирования = Объект.Дата;
	Если ДатаФормирования = НачалоДня(ДатаФормирования) Тогда
		ДатаФормирования = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОстаткиМарокИСОстатки.МестоПечати КАК МестоПечати,
	|	ОстаткиМарокИСОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиМарокИСОстатки.Штрихкод КАК ШтрихкодУпаковки,
	|	-ОстаткиМарокИСОстатки.КоличествоОстаток КАК Количество,
	|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питСрокРеализации, &ПустаяДата) КАК питСрокРеализации,
	|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питДатаПодключения, &ПустаяДата) КАК питДатаПодключения
	|ИЗ
	|	РегистрНакопления.питОстаткиМарокИС.Остатки(
	|			&Дата,
	|			Организация = &Организация
	|				И МестоПечати В (&ДоступныеМестаПечати)) КАК ОстаткиМарокИСОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ПО ОстаткиМарокИСОстатки.Штрихкод = ШтрихкодыУпаковокТоваров.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО ОстаткиМарокИСОстатки.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	ОстаткиМарокИСОстатки.КоличествоОстаток > 0
	|	И &ОтборПоПросроченным
	|	И &ОтборПоВидамПродукции";
	Запрос.УстановитьПараметр("Дата", ДатаФормирования);
	Запрос.УстановитьПараметр("ПустаяДата", Дата('00010101'));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ДоступныеМестаПечати", ДоступныеМестаПечати);
	
	ОтборПоПросроченным = "";
	Если РежимЗаполнения = 1 Тогда
		ОтборПоПросроченным = "И НЕ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питСрокРеализации, &ПустаяДата) = &ПустаяДата
		|	И ЕСТЬNULL(ШтрихкодыУпаковокТоваров.питСрокРеализации, &ПустаяДата) <= &Дата";
	КонецЕсли;
	ОтборПоВидамПродукции = "";
	Если Объект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.КорректировкаОстатковИСКорректировкаОстатковПивныхКег Тогда
		ОтборПоВидамПродукции = "И &ОпределениеВидаПродукции В (&ВидПродукцииИСМППиво)";
		Запрос.УстановитьПараметр("ВидПродукцииИСМППиво", питИнтеграцияИСМПКлиентСервер.ВидыПродукцииПива());
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.КорректировкаОстатковИСКорректировкаОстатковАлкогольныхПозиций Тогда
		ОтборПоВидамПродукции = "И &ОпределениеВидаПродукции В (&ВидПродукцииИСМПАлкоголь)";
		Запрос.УстановитьПараметр("ВидПродукцииИСМПАлкоголь", питИнтеграцияИСМПКлиентСервер.ВидыПродукцииАлкоголя());
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ОтборПоПросроченным", ОтборПоПросроченным);;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ОтборПоВидамПродукции", ОтборПоВидамПродукции);;
	
	Запрос.Текст = ТекстЗапроса;
	
	питИнтеграцияИСМП.ОпределитьВидПродукцииТекстаЗапроса(Запрос.Текст);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

ЭтоНоваяСтрокаЗапасы = Ложь;

#КонецОбласти