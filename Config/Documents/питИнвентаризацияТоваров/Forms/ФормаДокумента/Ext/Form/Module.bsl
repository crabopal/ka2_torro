

#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

&НаКлиенте
Перем ВыполняетсяЗапись; //используется для передачи текущей строки в обработчик ожидания

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область Общепит

// Создает таблицу для вкладки ввода количеств документа ИнвентаризацияТоваров
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ИмяГруппы - Произвольный - Имя группы.
//  ЗаголовокГруппы - Произвольный - Заголовок группы.
//  РодительГруппы - Произвольный - Родитель группы.
//  ПутьКДаннымТаблицы - Произвольный - Путь к данным таблицы.
//  КолонкиДляИсключения - Произвольный - Колонки для исключения.
//  ДопПараметры - Произвольный - Доп параметры.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
Функция СоздатьГруппуСТаблицей(Форма, ИмяГруппы, ЗаголовокГруппы, РодительГруппы, ПутьКДаннымТаблицы, КолонкиДляИсключения = Неопределено, ДопПараметры = Неопределено) Экспорт
	ЕстьДопПараметры = ДопПараметры <> Неопределено И ТипЗнч(ДопПараметры) = Тип("Структура");
	
	Группа = Форма.Элементы.Вставить(ИмяГруппы, Тип("ГруппаФормы"), РодительГруппы);
	Если РодительГруппы.Вид = ВидГруппыФормы.Страницы Тогда
		Группа.Вид 			= ВидГруппыФормы.Страница;
	Иначе
		Группа.Вид 			= ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Отображение	= ОтображениеОбычнойГруппы.Нет; 
	КонецЕсли;
	Группа.Заголовок = ЗаголовокГруппы;
	
	ЭтоТаблицаОбъекта = Лев(ПутьКДаннымТаблицы, 7) = "Объект.";
	
	Если ЭтоТаблицаОбъекта Тогда
		ИмяТаблицы = СтрЗаменить(Прав(ПутьКДаннымТаблицы, СтрДлина(ПутьКДаннымТаблицы) - 7), ".", "");
	Иначе
		ИмяТаблицы = СтрЗаменить(ПутьКДаннымТаблицы, ".", "");
	КонецЕсли;
	
	ТаблицаФормы = Форма.Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), Группа);
	ТаблицаФормы.ПутьКДанным = ПутьКДаннымТаблицы;
	ТаблицаФормы.Отображение = ОтображениеТаблицы.Список;
	ТаблицаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ТаблицаФормы.ПоложениеКоманднойПанели = ?(ЕстьДопПараметры И ДопПараметры.Свойство("ПоложениеКоманднойПанелиЭлементаФормы"), ДопПараметры.ПоложениеКоманднойПанелиЭлементаФормы, ПоложениеКоманднойПанелиЭлементаФормы.Нет);
	ТаблицаФормы.ВертикальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
	ТаблицаФормы.ГоризонтальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
	ТаблицаФормы.АвтоМаксимальнаяВысота = ?(ЕстьДопПараметры И ДопПараметры.Свойство("АвтоМаксимальнаяВысота"), ДопПараметры.АвтоМаксимальнаяВысота, Ложь);
	ТаблицаФормы.МаксимальнаяВысота = ?(ЕстьДопПараметры И ДопПараметры.Свойство("МаксимальнаяВысота"), ДопПараметры.МаксимальнаяВысота, 5);
	
	Если ЭтоТаблицаОбъекта Тогда
		ВременнаяТЗ = Форма.Объект[Прав(ПутьКДаннымТаблицы, СтрДлина(ПутьКДаннымТаблицы) - 7)].Выгрузить();
		Если КолонкиДляИсключения = Неопределено Тогда
			КолонкиДляИсключения = Новый Массив;
		КонецЕсли;
		КолонкиДляИсключения.Добавить("ИсходныйНомерСтроки");
	Иначе
		ВременнаяТЗ = Форма.РеквизитФормыВЗначение(ПутьКДаннымТаблицы, Тип("ТаблицаЗначений"));
	КонецЕсли;
	
	ЕстьИсключения = КолонкиДляИсключения <> Неопределено И ТипЗнч(КолонкиДляИсключения) = Тип("Массив") И КолонкиДляИсключения.Количество() > 0;
	
	УказанаШиринаКолонок = ЕстьДопПараметры И ДопПараметры.Свойство("ШиринаКолонок");
	
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	
	Для Каждого Колонка Из ВременнаяТЗ.Колонки Цикл
		Если ЕстьИсключения И КолонкиДляИсключения.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Колонка.Имя = "ЕдиницаИзмерения" И ПутьКДаннымТаблицы = "питПолуфабрикатныеЕдиницы" Тогда
			
			НовыйЭлементГруппа = Форма.Элементы.Добавить(СтрШаблон("%1%2", ИмяТаблицы, "УпаковкаЕдиницаИзмерения"), Тип("ГруппаФормы"), ТаблицаФормы);
			НовыйЭлементГруппа.Вид = ВидГруппыФормы.ГруппаКолонок;
			НовыйЭлементГруппа.Группировка = ГруппировкаКолонок.ВЯчейке;
			НовыйЭлементГруппа.ОтображатьВШапке = Ложь;
			// НовыйЭлементГруппа.РастягиватьПоГоризонтали = Ложь;
			НовыйЭлементГруппа.Ширина = 6;
			
			НовыйЭлемент = Форма.Элементы.Добавить(СтрШаблон("%1%2", ИмяТаблицы, "Упаковка"), Тип("ПолеФормы"), НовыйЭлементГруппа);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = СтрШаблон("%1.%2", ПутьКДаннымТаблицы, Колонка.Имя);
			НовыйЭлемент.ТолькоПросмотр = Истина;
			НовыйЭлемент.ОтображатьВШапке = Ложь;
			НовыйЭлемент.АвтомаксимальнаяШирина = Ложь;
			НовыйЭлемент.Ширина = 6;
			
			НовыйЭлемент2 = Форма.Элементы.Добавить(СтрШаблон("%1%2", ИмяТаблицы, "НоменклатураЕдиницаИзмерения"), Тип("ПолеФормы"), НовыйЭлементГруппа);
			НовыйЭлемент2.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент2.ПутьКДанным = СтрШаблон("%1.%2", ПутьКДаннымТаблицы, "Номенклатура.ЕдиницаИзмерения");
			НовыйЭлемент2.ТолькоПросмотр = Истина;
			НовыйЭлемент2.Заголовок = "Единица измерения";
			НовыйЭлемент2.АвтомаксимальнаяШирина = Ложь;
			НовыйЭлемент2.Ширина = 6;
			
			ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = НовыйЭлемент2.Имя;
			ПараметрыУсловногоОформления.ПутьКПолюУпаковка = НовыйЭлемент.ПутьКДанным;
			питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
			
		Иначе
			
			НовыйЭлемент = Форма.Элементы.Добавить(СтрШаблон("%1%2", ИмяТаблицы, Колонка.Имя), Тип("ПолеФормы"), ТаблицаФормы);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = СтрШаблон("%1.%2", ПутьКДаннымТаблицы, Колонка.Имя);
			НовыйЭлемент.ТолькоПросмотр = Истина;
			
			Если УказанаШиринаКолонок Тогда
				НовыйЭлемент.Ширина = ДопПараметры.ШиринаКолонок;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаФормы;
КонецФункции

//  Процедура - Заполнить таблицы единиц измерения.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиенте
Процедура ЗаполнитьТаблицыЕдиницИзмерения(Форма) Экспорт
	Форма.питПризнакОбработкиАктивизацииСтроки = Истина;
	Если Форма.питПризнакВводаКоличеств Тогда
		
		Форма.питЕдиницыИзмерения.Очистить();
		Форма.питТарныеЕдиницы.Очистить();
		Форма.питПолуфабрикатныеЕдиницы.Очистить();
		
		ТекущиеДанные = Форма.Элементы.Товары.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) И ТипЗнч(ТекущиеДанные.Упаковка) = Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения") Тогда
			Номенклатура = ТекущиеДанные.Номенклатура;
			
			СтруктураОтбора = Новый Структура("ИдентификаторРодителя", ТекущиеДанные.ИдентификаторСтроки);
			НайденныеСтроки = Форма.Объект.ТоварыПоЕдиницамИзмерения.НайтиСтроки(СтруктураОтбора);
			
			Для Каждого ТекСтрока Из НайденныеСтроки Цикл
				Если ТекСтрока.ИзПолуфабриката Тогда
					НовСтрокаПЕИ = Форма.питПолуфабрикатныеЕдиницы.Добавить();
					НовСтрокаПЕИ.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
					НовСтрокаПЕИ.ИдентификаторРодителя = ТекСтрока.ИдентификаторСтроки;
					ЗаполнитьЗначенияСвойств(НовСтрокаПЕИ, ТекСтрока);
				Иначе
					НовСтрокаЕИ = Форма.питЕдиницыИзмерения.Добавить();
					НовСтрокаЕИ.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
					НовСтрокаЕИ.ИдентификаторРодителя = ТекСтрока.ИдентификаторСтроки;
					ЗаполнитьЗначенияСвойств(НовСтрокаЕИ, ТекСтрока);
					
					Если ТекСтрока.ТарнаяЕдиницаИзмерения Тогда
						НовСтрокаТЕИ = Форма.питТарныеЕдиницы.Добавить();
						НовСтрокаТЕИ.ЕдиницаВеса = ТекСтрока.ВесЕдиницаИзмерения;
						НовСтрокаТЕИ.ИдентификаторСтроки = НовСтрокаЕИ.ИдентификаторСтроки;
						НовСтрокаТЕИ.ИдентификаторРодителя = ТекСтрока.ИдентификаторСтроки;
						ЗаполнитьЗначенияСвойств(НовСтрокаТЕИ, ТекСтрока);
						НовСтрокаТЕИ.Плотность = СтрШаблон("%1 %2/%3", НовСтрокаТЕИ.ПлотностьНапитка, СокрЛП(НовСтрокаТЕИ.ЕдиницаВеса), СокрЛП(ТекСтрока.ЕдиницаИзмерения));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Форма.питПризнакОбработкиАктивизацииСтроки = Ложь;
КонецПроцедуры

//  Процедура - Перезаполнить рецептуры полуфабрикатов завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПерезаполнитьРецептурыПолуфабрикатовЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт 
	Если РезультатВопроса Тогда
		ПерезаполнитьРецептурыПолуфабрикатовНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

//  Процедура - Заполнить завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ЗаполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.Товары.Очистить();
	Иначе
		Возврат;
	КонецЕсли;
	
	ЗаполнитьФрагмент();
	
КонецПроцедуры

//  Процедура - Заполнить факт по учету завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ЗаполнитьФактПоУчетуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Ответ = РезультатВопроса;
    
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    
    ЗаполнитьФактПоУчетуСервер();
	
	// +пит
	Если НЕ ЭтотОбъект.питПризнакОбработкиАктивизацииСтроки Тогда
		ЗаполнитьТаблицыЕдиницИзмерения(ЭтотОбъект);
	КонецЕсли;
	// -пит
	
КонецПроцедуры

//  Процедура - Поиск по штрихкоду завершение.
//
// Параметры:
//  ДанныхШтрихкода - Произвольный - Данных штрихкода.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(ДанныхШтрихкода, ДополнительныеПараметры) Экспорт
	
	ОбработатьШтрихкоды(ДанныхШтрихкода);
	
КонецПроцедуры

//  Процедура - Получить вес завершение.
//
// Параметры:
//  РезультатВыполнения - Произвольный - Результат выполнения.
//  ТекущаяСтрока - Строка - Текущая строка.
//
&НаКлиенте
Процедура ПолучитьВесЗавершение(РезультатВыполнения, ТекущаяСтрока) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		
		ТекущаяСтрока.КоличествоФакт = РезультатВыполнения.Вес;
		
		ТекущаяСтрока.КоличествоУпаковокФакт = ТекущаяСтрока.КоличествоФакт;
		ТекущаяСтрока.Расхождение = ТекущаяСтрока.Количество <> ТекущаяСтрока.КоличествоФакт;
		ТекущаяСтрока.КоличествоУпаковок = ТекущаяСтрока.Количество - ТекущаяСтрока.КоличествоФакт;
		
	Иначе
		МенеджерОборудованияУТКлиент.СообщитьОбОшибке(РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Загрузить из тсд завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ЗагрузитьИзТСДЗавершение(Результат, Параметры) Экспорт
	
	Если Результат.Результат Тогда
		ОбработатьШтрихкоды(Результат.ТаблицаТоваров);
	Иначе
		МенеджерОборудованияУТКлиент.СообщитьОбОшибке(Результат);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// +АвтовыборНоменклатуры
	НайденыОшибкиАвтовыбора = питУправлениеДаннымиОбИзделиях.ЗаполнитьНайденыОшибкиАвтовыбора(Объект.УточненияАвтовыбора);
	// +АвтовыборНоменклатуры
	
	УстановитьУсловноеОформление();
	
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	КонецЕсли;
	
	Элементы.ТоварыПоискПоШтрихкоду.Видимость = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ШтрихкодыНоменклатуры);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1СДокументооборотом") Тогда
		МодульИнтеграцияС1СДокументооборотБазоваяФункциональность = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияС1СДокументооборотБазоваяФункциональность");
		// ИнтеграцияС1СДокументооборотом
		МодульИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтаФорма);
		// Конец ИнтеграцияС1СДокументооборотом
	КонецЕсли;
	
	ПредыдущаяДата = Объект.Дата;
	
	// Выбор статей и аналитик.
	ПараметрыВыбораСтатейИАналитик = Документы.питИнвентаризацияТоваров.ПараметрыВыбораСтатейИАналитик();
	ДоходыИРасходыСервер.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыВыбораСтатейИАналитик);
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// +пит
	питПриСозданииНаСервере(ЭтаФорма);
	Если НЕ Константы.питФормироватьСкладскиеАктыПоИнвентаризацииТоваров.Получить() Тогда
		Элементы.СтатьяРасходов.Видимость = Ложь;
		Элементы.АналитикаРасходов.Видимость = Ложь;
		Элементы.СтатьяДоходов.Видимость = Ложь;
		Элементы.АналитикаДоходов.Видимость = Ложь;
		Элементы.ОрганизацияСкладскихАктов.Видимость = Ложь;
	КонецЕсли;
	Элементы.ОрганизацияРецептур.Видимость = НЕ питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ИскатьРецептурыПоВсемОрганизациям");
	УправлениеФормой(ЭтаФорма)
	// +пит
	
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	ПриЧтенииСозданииНаСервере();
	
	// Выбор статей и аналитик.
	ПараметрыВыбораСтатейИАналитик = Документы.питИнвентаризацияТоваров.ПараметрыВыбораСтатейИАналитик();
	ДоходыИРасходыСервер.ПриЧтенииНаСервере(ЭтотОбъект, ПараметрыВыбораСтатейИАналитик);
	
	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ТекущийОбъект.ОтборПересчета = Новый ХранилищеЗначения(ОтборПересчета.Настройки, Новый СжатиеДанных(9));

	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

//  Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
		
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	ЗаполнитьПризнакРасхождение();
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	// Выбор статей и аналитик.
	ДоходыИРасходыСервер.ПослеЗаписиНаСервере(ЭтотОбъект);
	
	// +пит
	УправлениеФормой(ЭтаФорма)
	// -пит
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	
	// +пит
	Если Объект.Ссылка.Пустая()
		И Объект.Полуфабрикаты.Количество() Тогда
		Оповещение = Новый ОписаниеОповещения("ПерезаполнитьРецептурыПолуфабрикатовЗавершение", ЭтотОбъект);
		ВариантыОтветов = Новый СписокЗначений;
		ВариантыОтветов.Добавить(Истина, НСтр("ru='Перезаполнить'"));
		ВариантыОтветов.Добавить(Ложь, НСтр("ru='Не перезаполнять'"));
		ПоказатьВопрос(Оповещение, НСтр("ru='Перезаполнить рецептуры полуфабрикатов?'"), ВариантыОтветов);
	КонецЕсли;
	// -пит
	
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

//  Процедура - При закрытии.
//
// Параметры:
//  ЗавершениеРаботы - Произвольный - Завершение работы.
//
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияУТКлиент.ЕстьНеобработанноеСобытие() Тогда
			ОбработатьШтрихкоды(МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВМассив(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование

	// Неизвестные штрихкоды
	Если Источник = "ПодключаемоеОборудование"
		И ИмяСобытия = "НеизвестныеШтрихкоды"
		И Параметр.ФормаВладелец = УникальныйИдентификатор Тогда
		
		КэшированныеЗначения.Штрихкоды.Очистить();
		ДанныеШтрихкодов = Новый Массив;
		
		Для Каждого ПолученныйШтрихкод Из Параметр.ПолученыНовыеШтрихкоды Цикл
			ДанныеШтрихкодов.Добавить(ПолученныйШтрихкод);
		КонецЦикла;
		
		Для Каждого ПолученныйШтрихкод Из Параметр.ЗарегистрированныеШтрихкоды Цикл
			ДанныеШтрихкодов.Добавить(ПолученныйШтрихкод);
		КонецЦикла;
		
		ОбработатьШтрихкоды(ДанныеШтрихкодов);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  РезультатВыбора - Произвольный - Результат выбора.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(РезультатВыбора, ИсточникВыбора)
	
	// +пит
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборТоваровВДокументПродажи.Форма.Форма" Тогда
		ОбработкаВыбораПодборТоваровНаСервере(РезультатВыбора);
	ИначеЕсли НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
	// -пит
		НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий, РезультатВыбора);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.Назначения.Форма.ФормаВыбора" Тогда	
		Элементы.Товары.ТекущиеДанные.Назначение = РезультатВыбора;	
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.питФормаПодбораХарактеристик" Тогда
		
		// +АвтовыборНоменклатуры
		ОбработкаВыбораПодборХарактеристикНаСервере(РезультатВыбора);
		УправлениеФормой(ЭтаФорма);
		Если НЕ НайденыОшибкиАвтовыбора Тогда
			Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.ГруппаТовары;
		КонецЕсли;
		// -АвтовыборНоменклатуры
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - После записи.
//
// Параметры:
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("Запись_питИнвентаризацияТоваров", ПараметрыЗаписи, Объект.Ссылка);

	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область Прочее
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

//  Процедура - Товары количество упаковок отклонение при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоУпаковокОтклонениеПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокОтклонение(СтруктураДействий);
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

#КонецОбласти

#Область Общепит

#Область ТаблицаПолуфабрикатов

//  Процедура - Полуфабрикаты номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПолуфабрикатыНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Полуфабрикаты.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", Новый Структура("НужноОкруглять", Ложь));
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ЭтаФорма.ИмяФормы, "Полуфабрикаты"));
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		ТекущаяСтрока.Количество 			 = 0;
		ТекущаяСтрока.КоличествоУпаковок	 = 0;
	Иначе
		ТекущаяСтрока.КоличествоУпаковок	 = 1;
		ПосчитатьКоличестваВединицахХранения("Полуфабрикаты");
	КонецЕсли;
	
	СтруктураТекСтроки = Новый Структура("Номенклатура, Характеристика, Рецептура", ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика, ТекущаяСтрока.Рецептура);
	ТекПараметрыОбъекта = Новый Структура("Ссылка,Дата,Подразделение,ОрганизацияРецептур", 
		Объект.Ссылка,
		Объект.Дата,
		Объект.Подразделение,
		Объект.ОрганизацияРецептур);
	ПолуфабрикатыНоменклатураПриИзмененииНаСервере(СтруктураТекСтроки, ТекПараметрыОбъекта);
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураТекСтроки);
	
КонецПроцедуры

//  Процедура - Полуфабрикаты выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПолуфабрикатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элементы.Полуфабрикаты.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Полуфабрикаты упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПолуфабрикатыУпаковкаПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Полуфабрикаты.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
КонецПроцедуры

//  Процедура - Полуфабрикаты количество упаковок при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПолуфабрикатыКоличествоУпаковокПриИзменении(Элемент)
	ПосчитатьКоличестваВединицахХранения("Полуфабрикаты");
КонецПроцедуры

//  Процедура - Полуфабрикаты при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ПолуфабрикатыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекДанные = Элементы.Полуфабрикаты.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			Если ПустаяСтрока(ТекДанные.ИдентификаторСтроки) Тогда
				ТекДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

//  Процедура - пит изменить отображение группы количеств.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питИзменитьОтображениеГруппыКоличеств(Элемент)
	ЭтотОбъект.питПризнакВводаКоличеств = НЕ ЭтотОбъект.питПризнакВводаКоличеств;
	ЭтаФорма.Элементы.питГруппаКоличеств.Видимость = ЭтотОбъект.питПризнакВводаКоличеств;
	ЭтаФорма.Элементы.питГруппаРазделитель.Видимость = НЕ ЭтотОбъект.питПризнакВводаКоличеств;
КонецПроцедуры

//  Процедура - пит товары при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питТоварыПриАктивизацииСтроки(Элемент)
	
	Если НЕ ЭтотОбъект.питПризнакОбработкиАктивизацииСтроки Тогда
		ЗаполнитьТаблицыЕдиницИзмерения(ЭтотОбъект);
		ТекущиеДанные = ЭтотОбъект.Элементы.Товары.ТекущиеДанные;
		ЭтотОбъект.Элементы.питДекорацияЗаголовок.Заголовок = СтрШаблон("Количество по единицам измерения %1", ?(ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Номенклатура), ТекущиеДанные.Номенклатура, ""));
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - пит таблицы единиц перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура питТаблицыЕдиницПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - пит таблицы единиц перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура питТаблицыЕдиницПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

//  Процедура - Статья расходов при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СтатьяРасходовПриИзменении(Элемент)
	// Выбор статей и аналитик.
	ДоходыИРасходыКлиентСервер.СтатьяПриИзменении(ЭтотОбъект, Элемент);
КонецПроцедуры

//  Процедура - Статья доходов при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СтатьяДоходовПриИзменении(Элемент)
	// Выбор статей и аналитик.
	ДоходыИРасходыКлиентСервер.СтатьяПриИзменении(ЭтотОбъект, Элемент);
КонецПроцедуры

//  Процедура - пит ввод количеств при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура питВводКоличествПриИзменении(Элемент)
	
	ТекСтрокаЗапасов = Элементы.Товары.ТекущиеДанные;
	ТекСтрокаКоличеств = Элемент.Родитель.ТекущиеДанные;
	
	СтруктураОтбора = Новый Структура("ИдентификаторРодителя,ИдентификаторСтроки,ИзПолуфабриката", ТекСтрокаКоличеств.ИдентификаторРодителя, ТекСтрокаКоличеств.ИдентификаторСтроки, Ложь);
	
	ВводТарныхЕдниц = Элемент.Родитель.Имя = "питТарныеЕдиницы";
	
	питИнвентаризацияКлиентСервер.ЗаполнитьСтроку(Объект.ТоварыПоЕдиницамИзмерения, СтруктураОтбора, ТекСтрокаКоличеств, ВводТарныхЕдниц);
	питИнвентаризацияКлиентСервер.ВыполнитьПересчетСтрокиОсновнойТаблицыПоТаблицеЕдиницИзмерения(Объект.ТоварыПоЕдиницамИзмерения, ТекСтрокаЗапасов);
	
	Если НЕ ТекСтрокаЗапасов = Неопределено Тогда
		ТекСтрокаЗапасов.КоличествоУпаковокФакт = ТекСтрокаЗапасов.КоличествоУпаковокФактБезПФ + ТекСтрокаЗапасов.КоличествоУпаковокИзПолуфабрикатов;
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "ФактБезПФ");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекСтрокаЗапасов, СтруктураДействий, КэшированныеЗначения);
		СтруктураДействий = Новый Структура;
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокФакт(СтруктураДействий);
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекСтрокаЗапасов, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

//  Процедура - Склад при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	СкладПомещениеПриИзмененииСервер();
	
КонецПроцедуры

//  Процедура - Дата при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ДатаПриИзмененииСервер();
	
	// +пит
	Если Объект.Полуфабрикаты.Количество() Тогда
		Оповещение = Новый ОписаниеОповещения("ПерезаполнитьРецептурыПолуфабрикатовЗавершение", ЭтотОбъект);
		ВариантыОтветов = Новый СписокЗначений;
		ВариантыОтветов.Добавить(Истина, НСтр("ru='Перезаполнить'"));
		ВариантыОтветов.Добавить(Ложь, НСтр("ru='Не перезаполнять'"));
		ПоказатьВопрос(Оповещение, НСтр("ru='Перезаполнить рецептуры полуфабрикатов?'"), ВариантыОтветов);
	КонецЕсли;
	// -пит
	
КонецПроцедуры

//  Процедура - Ответственный при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОтветственныйПриИзменении(Элемент)
	
	ОтвественныйПриИзмененииСервер();
	
КонецПроцедуры

//  Процедура - Только расхождения при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТолькоРасхожденияПриИзменении(Элемент)
	
	Если ТолькоРасхождения Тогда
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("Расхождение",Истина);
	Иначе
		Элементы.Товары.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Товары при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элементы.Товары.ТекущиеДанные.Количество = 0;
		Элементы.Товары.ТекущиеДанные.КоличествоФакт = 0;
		Элементы.Товары.ТекущиеДанные.КоличествоУпаковок = 0;
		Элементы.Товары.ТекущиеДанные.КоличествоУпаковокФакт = 0;
		Элементы.Товары.ТекущиеДанные.КоличествоУпаковокОтклонение = 0;
		
		// +пит
		Элементы.Товары.ТекущиеДанные.КоличествоИзПолуфабрикатов = 0;
		Элементы.Товары.ТекущиеДанные.КоличествоУпаковокИзПолуфабрикатов = 0;
		Элементы.Товары.ТекущиеДанные.КоличествоФактБезПФ = 0;
		Элементы.Товары.ТекущиеДанные.КоличествоУпаковокФактБезПФ = 0;
		Элементы.Товары.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		// -пит
		
	КонецЕсли;
	
	// +пит
	Если НЕ Копирование Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ЭтотОбъект.питПредыдущаяНоменклатура	= ТекущиеДанные.Номенклатура;
		ЭтотОбъект.питПредыдущаяУпаковка		= ТекущиеДанные.Упаковка;
	ИначеЕсли НоваяСтрока И Копирование Тогда
		СтарыйИдентификатор = Элемент.ТекущиеДанные.ИдентификаторСтроки;
		питИнвентаризацияКлиентСервер.СкопироватьЕдиницыИзмерения(Объект.ТоварыПоЕдиницамИзмерения, СтарыйИдентификатор, Элемент.ТекущиеДанные.ИдентификаторСтроки);
		ЗаполнитьТаблицыЕдиницИзмерения(ЭтаФорма);
	КонецЕсли;
	// -пит
	
КонецПроцедуры

//  Процедура - Товары номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "Факт");
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий));
	СтруктураДействий.Вставить("ПроверитьЗаполнитьНазначение");
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипИзмеряемойВеличины", Новый Структура("Номенклатура", "ТипИзмеряемойВеличины"));
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ЭтаФорма.ИмяФормы, "Товары"));

	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	// +пит
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "ИзПолуфабрикатов");
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "ФактБезПФ");
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	питИнвентаризацияКлиентСервер.УдалитьЕдиницыИзмерения(Объект.ТоварыПоЕдиницамИзмерения, ТекущаяСтрока.ИдентификаторСтроки);
	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			ТекущаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ЗаполнитьТоварыПоЕдиницамИзмеренияСервер(ТекущаяСтрока.ИдентификаторСтроки);
	КонецЕсли;
	Если НЕ ЭтотОбъект.питПризнакОбработкиАктивизацииСтроки Тогда
		ЗаполнитьТаблицыЕдиницИзмерения(ЭтаФорма);
	КонецЕсли;
	// -пит
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		ТекущаяСтрока.КоличествоФакт 		 = 0;
		ТекущаяСтрока.КоличествоУпаковокФакт = 0;
		ТекущаяСтрока.Количество 			 = 0;
		ТекущаяСтрока.КоличествоУпаковок	 = 0;
		ТекущаяСтрока.КоличествоУпаковокОтклонение = 0;
		
		// +пит
		ТекущаяСтрока.КоличествоИзПолуфабрикатов = 0;
		ТекущаяСтрока.КоличествоУпаковокИзПолуфабрикатов = 0;
		ТекущаяСтрока.КоличествоФактБезПФ = 0;
		ТекущаяСтрока.КоличествоУпаковокФактБезПФ = 0;
		// -пит
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Товары характеристика при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыХарактеристикаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
КонецПроцедуры

//  Процедура - Товары назначение при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНазначениеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
КонецПроцедуры

//  Процедура - Товары выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.Товары.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

//  Процедура - Упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура УпаковкаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	// +пит
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковокСуффикс", "Факт");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		

		ТекущаяСтрока.Расхождение = (ТекущаяСтрока.КоличествоФакт <> ТекущаяСтрока.Количество) Или (ТекущаяСтрока.КоличествоУпаковок <> ТекущаяСтрока.КоличествоУпаковокФакт);
		ТекущаяСтрока.КоличествоУпаковокОтклонение = ТекущаяСтрока.КоличествоУпаковокФакт - ТекущаяСтрока.КоличествоУпаковок;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковокСуффикс", "ИзПолуфабрикатов");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковокСуффикс", "ФактБезПФ");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЕсли;
	// -пит
	
КонецПроцедуры

//  Процедура - Товары количество упаковок факт при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоУпаковокФактПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	// +пит
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока.КоличествоУпаковокФакт = ТекущаяСтрока.КоличествоУпаковокФактБезПФ + ТекущаяСтрока.КоличествоУпаковокИзПолуфабрикатов;
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "ФактБезПФ");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	// -пит
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокФакт(СтруктураДействий);
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);			
	
	// +пит
	СтрокаЗапасов = Элементы.Товары.ТекущиеДанные;
	СообщениеОбИзмененииФакта = "";
	ПересчитыватьФактВСтрокеЗапасов = Ложь;
	питИнвентаризацияКлиентСервер.РаспределитьКоличествоПоЕдиницамИзмерения(Объект.ТоварыПоЕдиницамИзмерения, СтрокаЗапасов, ПересчитыватьФактВСтрокеЗапасов, СообщениеОбИзмененииФакта);
	Если ПересчитыватьФактВСтрокеЗапасов Тогда
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "ФактБезПФ");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "Факт");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	Если НЕ ПустаяСтрока(СообщениеОбИзмененииФакта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбИзмененииФакта);
	КонецЕсли;
	Если НЕ ЭтотОбъект.питПризнакОбработкиАктивизацииСтроки Тогда
		ЗаполнитьТаблицыЕдиницИзмерения(ЭтотОбъект);
	КонецЕсли;
	// -пит
	
КонецПроцедуры

//  Процедура - Товары перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	ОчиститьСообщения();
	
	Отказ = Истина;
	
	ВыделененныеСтроки = Элементы.Товары.ВыделенныеСтроки;
	
	// +пит
	СтрокиУдалить = Новый Массив;
	Для Каждого Идентификатор Из ВыделененныеСтроки Цикл
		
		СтрТабл = Элементы.Товары.ДанныеСтроки(Идентификатор);
		
		СтрокиЕдиницыИзмерения = Объект.ТоварыПоЕдиницамИзмерения.НайтиСтроки(Новый Структура("ИдентификаторРодителя", СтрТабл.ИдентификаторСтроки));
		Для каждого ТекСтрокаЕИ Из СтрокиЕдиницыИзмерения Цикл
			Объект.ТоварыПоЕдиницамИзмерения.Удалить(ТекСтрокаЕИ);
		КонецЦикла;
		
		СтрокиУдалить.Добавить(СтрТабл);
		
	КонецЦикла;
	Для каждого ТекСтрокаУдалить Из СтрокиУдалить Цикл
		Объект.Товары.Удалить(ТекСтрокаУдалить);
	КонецЦикла;
	// -пит
	
КонецПроцедуры

//  Процедура - Товары серия начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТоварыСерияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьПодборСерий(Элемент.ТекстРедактирования);
	
КонецПроцедуры

//  Процедура - Товары серия при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСерияПриИзменении(Элемент)
	
	ВыбранноеЗначение = НоменклатураКлиентСервер.ВыбраннаяСерия();
	
	ВыбранноеЗначение.Значение            		 = Элементы.Товары.ТекущиеДанные.Серия;
	ВыбранноеЗначение.ИдентификаторТекущейСтроки = Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор();
	
	НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий, ВыбранноеЗначение);
	
КонецПроцедуры

//  Процедура - Товары при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Не ОтменаРедактирования
		И НоваяСтрока Тогда
		
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#Область Прочее


// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

#КонецОбласти

#Область Общепит

#Область ТаблицаПолуфабрикатов

//  Процедура - пит распределить по товарам.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура питРаспределитьПоТоварам(Команда)
	
	// +АвтовыборНоменклатуры
	Объект.УточненияАвтовыбора.Очистить();
	// +АвтовыборНоменклатуры
	
	питРаспределитьПоТоварамНаСервере();
	Если НЕ НайденыОшибкиАвтовыбора Тогда
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.ГруппаТовары;
	КонецЕсли;
	// ЗаполнитьТаблицыЕдиницИзмерения(ЭтаФорма);
	УправлениеФормой(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - пит перезаполнить учетное количество.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура питПерезаполнитьУчетноеКоличество(Команда)
	ПерезаполнитьУчетноеКоличествоСервер();
КонецПроцедуры

//  Процедура - Подбор полуфабрикаты.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборПолуфабрикаты(Команда)
	ПараметрыПодбора = ПолучитьПараметрыПодбора("Полуфабрикаты");
	ОткрытьФорму("Обработка.ПодборТоваровВДокументПродажи.Форма", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
КонецПроцедуры

#КонецОбласти

#Область ИзменениеФактаВПроизводстве

//  Процедура - Уточнить характеристики.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура УточнитьХарактеристики(Команда)
	
	Если НЕ НайденыОшибкиАвтовыбора Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения, "Уточнение характеристик не требуется");
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("АдресУточненияАвтовыбора"	, УпаковатьУточненияАвтовыбора());
	СтруктураПараметров.Вставить("Ссылка"					, Объект.Ссылка);
	СтруктураПараметров.Вставить("Организация"				, Объект.ОрганизацияРецептур);
	СтруктураПараметров.Вставить("Подразделение"			, Объект.Подразделение);
	СтруктураПараметров.Вставить("Дата"						, Объект.Дата);
	СтруктураПараметров.Вставить("ЦеховаяКладовая"			, Объект.Склад);
	
	ОткрытьФорму("ОбщаяФорма.питФормаПодбораХарактеристик", СтруктураПараметров, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Записать документ.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаписатьДокумент(Команда)
	
	ОбщегоНазначенияУТКлиент.Записать(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Заполнить.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не СкладПомещениеЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Товары.Количество() > 0 Тогда
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект), НСтр("ru = 'Перед заполнением список товаров будет очищен. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьФрагмент();
КонецПроцедуры

//  Процедура - Заполнить факт по учету.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаполнитьФактПоУчету(Команда)
	
	Если КоличествоФактЗаполнено() Тогда
		
		ТекстВопроса = НСтр("ru='В табличной части уже есть строки с заполненным фактическим количеством.
			|При заполнении эта информация будет утеряна. Продолжить?'");
		
		Ответ = Неопределено;

		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьФактПоУчетуЗавершение", ЭтотОбъект), ТекстВопроса,РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
        Возврат;
		
	КонецЕсли;
	
	ЗаполнитьФактПоУчетуСервер();
	// +пит
	Если НЕ ЭтотОбъект.питПризнакОбработкиАктивизацииСтроки Тогда
		ЗаполнитьТаблицыЕдиницИзмерения(ЭтотОбъект);
	КонецЕсли;
	// -пит
КонецПроцедуры

//  Процедура - Провести документ.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПровестиДокумент(Команда)
	
	ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Провести и закрыть.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПровестиИЗакрыть(Команда)
	
	ОбщегоНазначенияУТКлиент.ПровестиИЗакрыть(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Поиск по штрихкоду выполнить.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПоискПоШтрихкодуВыполнить(Команда)

	ОчиститьСообщения();
	Оповещение = Новый ОписаниеОповещения("ПоискПоШтрихкодуЗавершение", ЭтотОбъект);
	ШтрихкодированиеНоменклатурыКлиент.ПоказатьВводШтрихкода(Оповещение);
	
КонецПроцедуры

//  Процедура - Получить вес.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПолучитьВес(Команда)
	
	ОчиститьСообщения();
	
	ТекущаяСтрока = МенеджерОборудованияУТКлиент.ТекущаяСтрока(ЭтаФорма);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерОборудованияКлиент.НачатьПолученияВесаСЭлектронныхВесов(
		Новый ОписаниеОповещения("ПолучитьВесЗавершение", ЭтотОбъект, ТекущаяСтрока),
		УникальныйИдентификатор);
	
КонецПроцедуры

//  Процедура - Загрузить данные из тсд.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗагрузитьДанныеИзТСД(Команда)
	
	ОчиститьСообщения();
	
	МенеджерОборудованияКлиент.НачатьЗагрузкуДанныеИзТСД(
		Новый ОписаниеОповещения("ЗагрузитьИзТСДЗавершение", ЭтотОбъект),
		УникальныйИдентификатор);
	
КонецПроцедуры

//  Процедура - Выгрузить данные втсд.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВыгрузитьДанныеВТСД(Команда)
	
	ПараметрыФормы = Новый Структура("ВариантЗаполнения, Пересчет", "ПоТоварамПересчета", Объект.Ссылка);
	ОткрытьФорму("Обработка.ВыгрузкаБазыТоваровВТСД.Форма", ПараметрыФормы);
	
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтеграцияС1СДокументооборотом") Тогда
		МодульИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль(
			"ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент");
		МодульИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(
			Команда, ЭтаФорма, Объект);
	КонецЕсли;
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

//  Процедура - Подключаемый выполнить переопределяемую команду.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПриИзмененииРеквизитов

//  Процедура - Склад помещение при изменении сервер.
//
&НаСервере
Процедура СкладПомещениеПриИзмененииСервер()
	
	НастроитьПоСкладуПомещению();
	
	ИнициализироватьКомпоновкуДанных(Истина);
	ПодготовитьЗаполнитьУстановитьВидимостьСерий();
	
КонецПроцедуры

//  Процедура - Дата при изменении сервер.
//
&НаСервере
Процедура ДатаПриИзмененииСервер()
	
	НастроитьПоСкладуПомещению();
	ПодготовитьЗаполнитьУстановитьВидимостьСерий();
	
КонецПроцедуры

//  Процедура - Отвественный при изменении сервер.
//
&НаСервере
Процедура ОтвественныйПриИзмененииСервер()
	
КонецПроцедуры

#КонецОбласти

#Область ПодборыИОбработкаПроверкиКоличества

//  Процедура - Открыть подбор серий.
//
// Параметры:
//  Текст - Строка - Текст.
//  ТекущиеДанные - Произвольный - Текущие данные.
//
&НаКлиенте
Процедура ОткрытьПодборСерий(Текст = "", ТекущиеДанные = Неопределено)
	
	Если НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(ЭтаФорма, ПараметрыУказанияСерий, Текст, ТекущиеДанные) Тогда
		ТекстИсключения = НСтр("ru = 'Ошибка при попытке указать серии - в этом документе для указания серий не нужен серверный вызов.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ШтрихкодыИТорговоеОборудование

//  Процедура - Обработать штрихкоды.
//
// Параметры:
//  ДанныеШтрихкодов - Произвольный - Данные штрихкодов.
//
&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкодов)
	
	ИзменятьКоличество = Не (СостояниеРедактирования = "НеРедактируется"); 
	
	СтруктураДействийСДобавленнымиСтроками = Новый Структура;
	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействийСДобавленнымиСтроками.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий));
	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакТипИзмеряемойВеличины", Новый Структура("Номенклатура", "ТипИзмеряемойВеличины"));
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокФакт(СтруктураДействийСДобавленнымиСтроками);
	
	СтруктураДействийСИзмененнымиСтроками = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокФакт(СтруктураДействийСИзмененнымиСтроками);
	
	СтруктураДействий = ШтрихкодированиеНоменклатурыКлиент.ПараметрыОбработкиШтрихкодов();
	
	СтруктураДействий.Штрихкоды                              = ДанныеШтрихкодов;
	СтруктураДействий.СтруктураДействийСДобавленнымиСтроками = СтруктураДействийСДобавленнымиСтроками;
	СтруктураДействий.СтруктураДействийСИзмененнымиСтроками  = СтруктураДействийСИзмененнымиСтроками;
	СтруктураДействий.ПараметрыУказанияСерий                 = ПараметрыУказанияСерий;
	СтруктураДействий.ИмяКолонкиКоличество                   = "КоличествоУпаковокФакт";
	СтруктураДействий.НеИспользоватьУпаковки                 = Истина;
	СтруктураДействий.ИзменятьКоличество                     = ИзменятьКоличество;
	СтруктураДействий.ТолькоТовары                           = Истина;
	
	ОбработатьШтрихкодыСервер(СтруктураДействий,КэшированныеЗначения);
	
	ШтрихкодированиеНоменклатурыКлиент.ОбработатьНеизвестныеШтрихкоды(СтруктураДействий,КэшированныеЗначения,ЭтаФорма);
	
	Если ШтрихкодированиеНоменклатурыКлиент.НужноОткрытьФормуУказанияСерийПослеОбработкиШтрихкодов(СтруктураДействий) Тогда
		
		ТекущиеДанныеИдентификатор = СтруктураДействий.МассивСтрокССериями[0];
		
		ПодключитьОбработчикОжидания("ОткрытьПодборСерийПриСканированииШтрихкодаНоменклатуры",0.1,Истина);
			
	КонецЕсли;
	
	Если СтруктураДействий.ТекущаяСтрока <> Неопределено Тогда
		Элементы.Товары.ТекущаяСтрока = СтруктураДействий.ТекущаяСтрока;
	КонецЕсли;
	
	// +пит
	Если СтруктураДействий.ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрокаОбщепит = Объект.Товары.НайтиПоИдентификатору(СтруктураДействий.ТекущаяСтрока);
		ТекущаяСтрокаОбщепит.КоличествоУпаковокФактБезПФ	= ТекущаяСтрокаОбщепит.КоличествоУпаковокФакт - ТекущаяСтрокаОбщепит.КоличествоУпаковокИзПолуфабрикатов;
		СтруктураДействийОбщепит = Новый Структура;
		СтруктураДействийОбщепит.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "ФактБезПФ");
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрокаОбщепит, СтруктураДействийОбщепит, КэшированныеЗначения);
		
		питИнвентаризацияКлиентСервер.УдалитьЕдиницыИзмерения(Объект.ТоварыПоЕдиницамИзмерения, ТекущаяСтрокаОбщепит.ИдентификаторСтроки);
		Если ЗначениеЗаполнено(ТекущаяСтрокаОбщепит.Номенклатура) Тогда
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрокаОбщепит.ИдентификаторСтроки) Тогда
				ТекущаяСтрокаОбщепит.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			ЗаполнитьТоварыПоЕдиницамИзмеренияСервер(ТекущаяСтрокаОбщепит.ИдентификаторСтроки);
		КонецЕсли;
		Если НЕ ЭтотОбъект.питПризнакОбработкиАктивизацииСтроки Тогда
			ЗаполнитьТаблицыЕдиницИзмерения(ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	// -пит
	
КонецПроцедуры

//  Процедура - Обработать штрихкоды сервер.
//
// Параметры:
//  СтруктураПараметровДействия - Структура - Структура параметров действия.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//
&НаСервере
Процедура ОбработатьШтрихкодыСервер(СтруктураПараметровДействия,КэшированныеЗначения)
	
	ШтрихкодированиеНоменклатурыСервер.ОбработатьШтрихкоды(ЭтаФорма, Объект, СтруктураПараметровДействия, КэшированныеЗначения);
	
КонецПроцедуры

#КонецОбласти

#Область Серии

//  Процедура - Установить видимость элементов серий.
//
&НаСервере
Процедура УстановитьВидимостьЭлементовСерий()
	
	Элементы.ТоварыСерия.Видимость = ПараметрыУказанияСерий.ИспользоватьСерииНоменклатуры;
	
КонецПроцедуры

//  Процедура - Подготовить заполнить установить видимость серий.
//
&НаСервере
Процедура ПодготовитьЗаполнитьУстановитьВидимостьСерий()
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питИнвентаризацияТоваров));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	
	УстановитьВидимостьЭлементовСерий();
	
КонецПроцедуры

//  Процедура - Открыть подбор серий при сканировании штрихкода номенклатуры.
//
&НаКлиенте
Процедура ОткрытьПодборСерийПриСканированииШтрихкодаНоменклатуры()
	
	Если ТекущиеДанныеИдентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущиеДанныеИдентификатор);
	ОткрытьПодборСерий(,ТекущиеДанные);
		
КонецПроцедуры

#КонецОбласти

#Область Прочее

//  Процедура - Заполнить сервер.
//
&НаСервере
Процедура ЗаполнитьСервер()
	
	// +пит
	Объект.ТоварыПоЕдиницамИзмерения.Очистить();
	// -пит
	
	УстановитьЗначениеПараметраНастроек(ОтборПересчета.Настройки, "ДатаОстатков", ?(ЗначениеЗаполнено(Объект.Дата),
		Новый Граница(Объект.Дата, ВидГраницы.Включая),
		Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая)));
	
	// +пит
	// Период оборотов.
	СтарыйПериодОборотовИспользование = Ложь;
	Для каждого ТекЭлементОтборПересчета Из ОтборПересчета.Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(ТекЭлементОтборПересчета) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если ТекЭлементОтборПересчета.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПараметрыДанных.ПериодОборотов") Тогда
			СтарыйПериодОборотовИспользование = ТекЭлементОтборПересчета.Использование;
			Если ТекЭлементОтборПересчета.Использование Тогда
				УстановитьЗначениеПараметраНастроек(ОтборПересчета.Настройки, "ПериодОборотов", ТекЭлементОтборПересчета.ПравоеЗначение);
			Иначе
				УстановитьЗначениеПараметраНастроек(ОтборПересчета.Настройки, "ПериодОборотов", Новый СтандартныйПериод(Дата("00010101"), Дата("00010101")));
			КонецЕсли;
			ТекЭлементОтборПересчета.Использование = Ложь;
		КонецЕсли;
	КонецЦикла;
	// -пит
	
	// +пит
	СхемаКомпоновкиДанных = Документы.питИнвентаризацияТоваров.ПолучитьМакет("ОтборПересчетаПоСкладу");
	// -пит
	
	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных.ЗаполнениеПоОтборам.Запрос;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковки",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
		"ТоварыВЯчейках.Упаковка", Неопределено));
	СхемаКомпоновкиДанных.НаборыДанных.ЗаполнениеПоОтборам.Запрос = ТекстЗапроса;

	СегментыСервер.ВключитьОтборПоСегментуНоменклатурыВСКД(ОтборПересчета);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ОтборПересчета.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	Объект.Товары.Загрузить(ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных));
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	ЗаполнитьПризнакРасхождение();
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	
	// +пит
	Для каждого ТекСтрокаТовары Из Объект.Товары Цикл
		ТекСтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
	питИнвентаризацияВызовСервера.ЗаполнитьТоварыПоЕдиницамИзмерения(Объект, Объект.Товары);
	// -пит
	
	// +пит
	// Период оборотов.
	Для каждого ТекЭлементОтборПересчета Из ОтборПересчета.Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(ТекЭлементОтборПересчета) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если ТекЭлементОтборПересчета.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПараметрыДанных.ПериодОборотов") Тогда
			ТекЭлементОтборПересчета.Использование = СтарыйПериодОборотовИспользование;
		КонецЕсли;
	КонецЦикла;
	// -пит
	
КонецПроцедуры

//  Процедура - Заполнить факт по учету сервер.
//
&НаСервере
Процедура ЗаполнитьФактПоУчетуСервер()
	
	ТекКэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого СтрТабл Из Объект.Товары Цикл
		
		СтрТабл.КоличествоФакт = СтрТабл.Количество;
		СтрТабл.КоличествоУпаковокФакт = СтрТабл.КоличествоУпаковок;
		СтрТабл.Расхождение = (СтрТабл.КоличествоФакт <> СтрТабл.Количество) Или (СтрТабл.КоличествоУпаковок <> СтрТабл.КоличествоУпаковокФакт);
		СтрТабл.КоличествоУпаковокОтклонение = СтрТабл.КоличествоУпаковокФакт - СтрТабл.КоличествоУпаковок;
		
		// +пит
		СтрТабл.КоличествоФактБезПФ			= СтрТабл.Количество - СтрТабл.КоличествоИзПолуфабрикатов;
		СтрТабл.КоличествоУпаковокФактБезПФ	= СтрТабл.КоличествоУпаковок - СтрТабл.КоличествоУпаковокИзПолуфабрикатов;
		
		ТоварыПоЕИОбнулить = Объект.ТоварыПоЕдиницамИзмерения.НайтиСтроки(Новый Структура("ИзПолуфабриката,ИдентификаторРодителя", Ложь, СтрТабл.ИдентификаторСтроки));
		Для каждого ТекСтрокаТоварыПоЕИ Из ТоварыПоЕИОбнулить Цикл
			ТекСтрокаТоварыПоЕИ.Количество = 0;
			ТекСтрокаТоварыПоЕИ.КоличествоВзвешенныхЕдиниц = 0;
			ТекСтрокаТоварыПоЕИ.Вес = 0;
		КонецЦикла;
		питИнвентаризацияКлиентСервер.РаспределитьКоличествоПоЕдиницамИзмерения(Объект.ТоварыПоЕдиницамИзмерения, СтрТабл);
		// -пит
		
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Настроить по складу помещению.
//
&НаСервере
Процедура НастроитьПоСкладуПомещению()
	
	ИспользоватьКачество = Ложь;
	
КонецПроцедуры

//  Процедура - Инициализировать компоновку данных.
//
// Параметры:
//  ВсегдаИспользоватьНастройкиПоУмолчанию - Произвольный - Всегда использовать настройки по умолчанию.
//
&НаСервере
Процедура ИнициализироватьКомпоновкуДанных(ВсегдаИспользоватьНастройкиПоУмолчанию)
	
	// +пит
	СхемаКомпоновкиДанных = Документы.питИнвентаризацияТоваров.ПолучитьМакет("ОтборПересчетаПоСкладу");
	// -пит
	
	URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор());
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
	
	ОтборПересчета.Инициализировать(ИсточникНастроек);
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекНастройки = ТекОбъект.ОтборПересчета.Получить();
	Если ТекНастройки = Неопределено
		Или ВсегдаИспользоватьНастройкиПоУмолчанию Тогда
		ОтборПересчета.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		ОтборПересчета.ЗагрузитьНастройки(ТекНастройки);
	КонецЕсли;
	
	ОтборПересчета.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
	УстановитьЗначениеПараметраНастроек(ОтборПересчета.Настройки, "Склад" , Объект.Склад);
	УстановитьЗначениеПараметраНастроек(ОтборПересчета.Настройки, "Помещение", Справочники.СкладскиеПомещения.ПустаяСсылка());
	
КонецПроцедуры

//  Процедура - Установить значение параметра настроек.
//
// Параметры:
//  Настройки - Произвольный - Настройки.
//  ИмяПараметра - Произвольный - Имя параметра.
//  Значение - Произвольный - Значение.
//
&НаСервереБезКонтекста
Процедура УстановитьЗначениеПараметраНастроек(Настройки, ИмяПараметра, Значение)
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Значение;
		Параметр.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заполнить признак расхождение.
//
&НаСервере
Процедура ЗаполнитьПризнакРасхождение()
	
	Для Каждого СтрТабл Из Объект.Товары Цикл
		СтрТабл.Расхождение = СтрТабл.КоличествоФакт <> СтрТабл.Количество Или СтрТабл.КоличествоУпаковок <> СтрТабл.КоличествоУпаковокФакт;
		СтрТабл.КоличествоУпаковокОтклонение = СтрТабл.КоличествоУпаковокФакт - СтрТабл.КоличествоУпаковок;
	КонецЦикла;
	
КонецПроцедуры

//  Функция - Количество факт заполнено.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция КоличествоФактЗаполнено()
	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("КоличествоФакт", 0));
	Возврат НайденныеСтроки.Количество() <> Объект.Товары.Количество();
	
КонецФункции

//  Процедура - Добавить в структуру действия при изменении количества упаковок факт.
//
// Параметры:
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокФакт(СтруктураДействий)
	
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "Факт");
	СтруктураДействий.Вставить("ЗаполнитьФлагРасхождение");
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковокОтклонение");
	
КонецПроцедуры

//  Функция - Склад помещение заполнены.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция СкладПомещениеЗаполнены()

	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		
		Результат = Ложь;
		ТекстСообщения = НСтр("ru = 'Не заполнено поле ""Склад"".
			|Для выполнения действия необходимо указать склад, на котором проводится пересчет'");
		ОчиститьСообщения();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Склад","Объект");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//  Процедура - Подключаемый выполнить команду на сервере.
//
// Параметры:
//  Контекст - Произвольный - Контекст.
//  Результат - Произвольный - Результат.
//
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

//  Процедура - Подключаемый обновить команды.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении количества упаковок отклонение.
//
// Параметры:
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокОтклонение(СтруктураДействий)
	
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковокСуффиксИзОтклонения", "Факт");
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "Факт");
	СтруктураДействий.Вставить("ЗаполнитьФлагРасхождение");
	
КонецПроцедуры

#КонецОбласти

#Область Общепит

#Область ТаблицаПолуфабрикатов

//  Процедура - пит распределить по товарам на сервере.
//
&НаСервере
Процедура питРаспределитьПоТоварамНаСервере()
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("ТипДокумента"	, ТипЗнч(Объект.Ссылка));
	СтруктураОбъекта.Вставить("Ссылка"			, Объект.Ссылка);
	СтруктураОбъекта.Вставить("Дата"			, Объект.Дата);
	СтруктураОбъекта.Вставить("Организация"		, Объект.ОрганизацияРецептур);
	СтруктураОбъекта.Вставить("Подразделение"	, Объект.Подразделение);
	СтруктураОбъекта.Вставить("Склад"			, Объект.Склад);
	СтруктураОбъекта.Вставить("УчитыватьОстаткиБлюдНаСкладе", Ложь);
	СтруктураОбъекта.Вставить("НеИспользоватьСезонныеПроценты", Истина);
	СтруктураОбъекта.Вставить("ВидПроизводства", Перечисления.питВидыПроизводства.ПеределыВнутриВыпуска);
	СтруктураОбъекта.Вставить("МоментВремени", Новый МоментВремени(СтруктураОбъекта.Дата));
	
	ТаблицаТовары = Объект.Товары.Выгрузить(); 
	
	ТаблицаТоварыПоЕдиницамИзмерения = Объект.ТоварыПоЕдиницамИзмерения.Выгрузить();
	ТаблицаПолуфабрикаты = Объект.Полуфабрикаты.Выгрузить();
	РаспределитьПолуфабрикатыПоТоварам(СтруктураОбъекта, ТаблицаТовары, ТаблицаПолуфабрикаты, ТаблицаТоварыПоЕдиницамИзмерения, Объект.УточненияАвтовыбора);
	Объект.Товары.Загрузить(ТаблицаТовары);
	Объект.ТоварыПоЕдиницамИзмерения.Загрузить(ТаблицаТоварыПоЕдиницамИзмерения);
	
	// Дозаполнение служебных реквизитов.
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	ЗаполнитьПризнакРасхождение();
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	
	// +АвтовыборНоменклатуры
	НайденыОшибкиАвтовыбора = питУправлениеДаннымиОбИзделиях.ЗаполнитьНайденыОшибкиАвтовыбора(Объект.УточненияАвтовыбора);
	// +АвтовыборНоменклатуры
	
КонецПроцедуры

// Процедура раскладывает состав введенных полуфабрикатов до ингредиентов и распределяет их в таблицу товаров.
//
// Параметры:
//  СтруктураОбъекта - Структура - Содержит поля, необходимые для процедуры
//   "ЗаполнитьПроизводственныеТаблицыПоРецептуре".
//  ТаблицаТовары - ТаблицаЗначений - Таблица товаров, куда будем распределять пф.
//  ТаблицаПолуфабрикаты - ТаблицаЗначений - Исходная таблица полуфабрикатов.
//  ТаблицаПоЕдиницамИзмерения - ТаблицаЗначений - Таблица единиц измерения товаров.
//  УточненияАвтовыбора - Произвольный - Уточнения автовыбора.
//
&НаСервереБезКонтекста
Процедура РаспределитьПолуфабрикатыПоТоварам(СтруктураОбъекта, ТаблицаТовары, ТаблицаПолуфабрикаты, ТаблицаПоЕдиницамИзмерения, УточненияАвтовыбора)
	
	ТекКэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	// Очистка информации о полуфабрикатах.
	Для каждого ТекСтрокаТовары Из ТаблицаТовары Цикл
			ТекСтрокаТовары.КоличествоФакт			= ТекСтрокаТовары.КоличествоФакт - ТекСтрокаТовары.КоличествоИзПолуфабрикатов;
			ТекСтрокаТовары.КоличествоУпаковокФакт	= ТекСтрокаТовары.КоличествоУпаковокФакт - ТекСтрокаТовары.КоличествоУпаковокИзПолуфабрикатов;
			ТекСтрокаТовары.КоличествоИзПолуфабрикатов			= 0;
			ТекСтрокаТовары.КоличествоУпаковокИзПолуфабрикатов	= 0;
		// КонецЕсли;
	КонецЦикла;
	ТоварыПоЕИУдалить = ТаблицаПоЕдиницамИзмерения.НайтиСтроки(Новый Структура("ИзПолуфабриката", Истина));
	Для каждого ТекСтрокаТоварыПоЕИ Из ТоварыПоЕИУдалить Цикл
		ТаблицаПоЕдиницамИзмерения.Удалить(ТекСтрокаТоварыПоЕИ);
	КонецЦикла;
	
	// Добавление в структуру объекта таблицы товаров для корректного заполнения таблицы производства.
	ТаблицаТоваров = ТаблицаПолуфабрикаты.Скопировать();
	ТаблицаТоваров.Колонки.Добавить("Серия"					, Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТаблицаТоваров.Колонки.Добавить("Назначение"			, Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	ТаблицаТоваров.Колонки.Добавить("НазначениеИнгредиентов", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	Если питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		ТаблицаТоваров.Колонки.Добавить("СчетУчета"			, Новый ОписаниеТипов("Строка"));
	Иначе
		ТаблицаТоваров.Колонки.Добавить("СчетУчета"			, Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	КонецЕсли;
	Для каждого ТекСтрокаТовары Из ТаблицаТоваров Цикл
		Если ПустаяСтрока(ТекСтрокаТовары.ИдентификаторСтроки) Тогда
			ТекСтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	СтруктураОбъекта.Вставить("Товары", ТаблицаТоваров);
	
	// +АвтовыборНоменклатуры
	МассивДеревьевСостава = Новый Массив;
	// +АвтовыборНоменклатуры
	
	// Заполнение таблицы производства.
	ТаблицаДляРаспределения = питПроизводство.ЗаполнитьПроизводственныеТаблицыПоРецептуре(СтруктураОбъекта, Истина, , , МассивДеревьевСостава, УточненияАвтовыбора);
	
	// Удаление товаров  "Технологический ингредиент" 
	Для каждого ТекСтрокаТовары Из ТаблицаДляРаспределения Цикл     
		Если ТекСтрокаТовары.Ингредиент.ПитВидНоменклатуры = Перечисления.питВидыНоменклатуры.ТехнологическийИнгредиент Тогда
			ТаблицаДляРаспределения.Удалить(ТекСтрокаТовары);
		КонецЕсли;
	КонецЦикла;

	// +АвтовыборНоменклатуры
	питУправлениеДаннымиОбИзделиях.ЗаполнитьУточненияАвтовыбора(МассивДеревьевСостава, УточненияАвтовыбора);
	НайденыОшибкиАвтовыбора = питУправлениеДаннымиОбИзделиях.ЗаполнитьНайденыОшибкиАвтовыбора(УточненияАвтовыбора);
	// +АвтовыборНоменклатуры
	
	Для каждого ТекСтрокаТаблицы Из ТаблицаДляРаспределения Цикл
		Если ЗначениеЗаполнено(ТекСтрокаТаблицы.РецептураАвтопередела) И ТекСтрокаТаблицы.КоличествоИнгредиентаНорма = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Полуфабрикат <"
			+ ТекСтрокаТаблицы.Ингредиент 
			+ ?(ЗначениеЗаполнено(ТекСтрокаТаблицы.ХарактеристикаИнгредиента), "; " + ТекСтрокаТаблицы.ХарактеристикаИнгредиента, "")
			+ "> приготовляемый для <" + ТекСтрокаТаблицы.Номенклатура
			+ ?(ЗначениеЗаполнено(ТекСтрокаТаблицы.Характеристика), "; " + ТекСтрокаТаблицы.Характеристика, "")
			+ "> не будет распределен" + ", т.к. его количество к приготовлению меньше 0.001");
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаДляРаспределения.Количество() <> 0 Тогда
		
		СтрокиПриготовлениеЗапрещено = ТаблицаДляРаспределения.НайтиСтроки(Новый Структура("ПриготовлениеЗапрещено", Истина));
		Для каждого ТекСтрокаЗапрещено Из СтрокиПриготовлениеЗапрещено Цикл
			Если ТекСтрокаЗапрещено.КоличествоУпаковокНоменклатуры <> 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Полуфабрикат <"
				+ ТекСтрокаЗапрещено.Номенклатура 
				+ ?(ЗначениеЗаполнено(ТекСтрокаЗапрещено.Характеристика), "; " + ТекСтрокаЗапрещено.Характеристика, "")
				+"> не будет распределен" + ", т.к. запрещен к приготовлению для текущих подразделения и склада.");
			КонецЕсли;
		КонецЦикла;
		
		// Свертка производственной таблицы.
		ПоляГруппировки = "Ингредиент, ХарактеристикаИнгредиента, ЕдиницаИзмеренияИнгредиента, ИзАвтопеределов";
		ПоляСуммирования = "КоличествоИнгредиентаНорма, КоличествоУпаковокИнгредиентаНорма";
		ТаблицаДляРаспределения.Свернуть(ПоляГруппировки, ПоляСуммирования);
		
		СтруктураОтбораЗапасов = Новый Структура("Номенклатура, Характеристика");
		СтруктураОтбораПоЕИ = Новый Структура("ЕдиницаИзмерения, ИдентификаторРодителя, ИзПолуфабриката");
		
		// Массив строк, по которым позже будем перезаполнять учетное количество.
		СтрокиЗаполнитьУчет = Новый Массив;
		
		Для Каждого ТекСтрока Из ТаблицаДляРаспределения Цикл
			
			// Обрабатываем только НЕ передельные позиции(ингредиенты).
			Если ТекСтрока.ИзАвтопеределов Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекСтрока.Ингредиент) Тогда
				Продолжить;
			КонецЕсли;
			
			// Поиск ингредиента в основной таблице товаров инвентаризации.
			СтруктураОтбораЗапасов.Номенклатура		= ТекСтрока.Ингредиент;
			СтруктураОтбораЗапасов.Характеристика	= ТекСтрока.ХарактеристикаИнгредиента;
			НайденныеСтроки = ТаблицаТовары.НайтиСтроки(СтруктураОтбораЗапасов);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				// Строка в основной таблице найдена, запоминаем.
				НайденнаяСтрока = НайденныеСтроки[0];
			Иначе
				// Срока в основной таблице не найдена, добавляем новую.
				НайденнаяСтрока = ТаблицаТовары.Добавить();
				НайденнаяСтрока.Номенклатура						= ТекСтрока.Ингредиент;
				НайденнаяСтрока.Характеристика						= ТекСтрока.ХарактеристикаИнгредиента;
				НайденнаяСтрока.Упаковка							= ТекСтрока.ЕдиницаИзмеренияИнгредиента;
				НайденнаяСтрока.КоличествоФакт						= 0;
				НайденнаяСтрока.КоличествоУпаковокФакт				= 0;
				НайденнаяСтрока.Количество							= 0;
				НайденнаяСтрока.КоличествоУпаковок					= 0;
				НайденнаяСтрока.КоличествоИзПолуфабрикатов			= 0;
				НайденнаяСтрока.КоличествоУпаковокИзПолуфабрикатов	= 0;
				НайденнаяСтрока.КоличествоФактБезПФ					= 0;
				НайденнаяСтрока.КоличествоУпаковокФактБезПФ			= 0;
				
				СтрокиЗаполнитьУчет.Добавить(НайденнаяСтрока);
				
			КонецЕсли;
			
			Если ПустаяСтрока(НайденнаяСтрока.ИдентификаторСтроки) Тогда
				НайденнаяСтрока.ИдентификаторСтроки					= Новый УникальныйИдентификатор;
			КонецЕсли;
			
			ТекКоэффициентЕИИнгредиента	= питОбщегоНазначения.ПолучитьКоэффициентУпаковки(ТекСтрока.Ингредиент, ТекСтрока.ЕдиницаИзмеренияИнгредиента, ТекКэшированныеЗначения);
			ТекКоэффициентЕИТовара		= питОбщегоНазначения.ПолучитьКоэффициентУпаковки(НайденнаяСтрока.Номенклатура, НайденнаяСтрока.Упаковка, ТекКэшированныеЗначения);
			ТекКоэффициентПересчета		= ТекКоэффициентЕИИнгредиента/?(ТекКоэффициентЕИТовара=0,1,ТекКоэффициентЕИТовара);
			
			// Увеличиваем количество факт(с учетом ПФ) и количество из ПФ в основной таблице.
			НайденнаяСтрока.КоличествоФакт						= НайденнаяСтрока.КоличествоФакт + ТекСтрока.КоличествоИнгредиентаНорма;
			НайденнаяСтрока.КоличествоУпаковокФакт				= НайденнаяСтрока.КоличествоУпаковокФакт + ТекСтрока.КоличествоУпаковокИнгредиентаНорма * ТекКоэффициентПересчета;
			НайденнаяСтрока.КоличествоИзПолуфабрикатов			= НайденнаяСтрока.КоличествоИзПолуфабрикатов + ТекСтрока.КоличествоИнгредиентаНорма;
			НайденнаяСтрока.КоличествоУпаковокИзПолуфабрикатов	= НайденнаяСтрока.КоличествоУпаковокИзПолуфабрикатов + ТекСтрока.КоличествоУпаковокИнгредиентаНорма * ТекКоэффициентПересчета;
			
			// Поиск строк по пф в таблице по единицам измерения.
			СтруктураОтбораПоЕИ.ЕдиницаИзмерения		= ТекСтрока.ЕдиницаИзмеренияИнгредиента;
			СтруктураОтбораПоЕИ.ИзПолуфабриката			= Истина;
			СтруктураОтбораПоЕИ.ИдентификаторРодителя	= НайденнаяСтрока.ИдентификаторСтроки;
			НайденныеСтрокиПоЕИ = ТаблицаПоЕдиницамИзмерения.НайтиСтроки(СтруктураОтбораПоЕИ);
			
			Если НайденныеСтрокиПоЕИ.Количество() = 0 Тогда
				
				// Строк не нашли, добавляем новую.
				НоваяСтрока = ТаблицаПоЕдиницамИзмерения.Добавить();
				НоваяСтрока.Номенклатура				= ТекСтрока.Ингредиент;
				НоваяСтрока.ХарактеристикаНоменклатуры	= ТекСтрока.ХарактеристикаИнгредиента;
				НоваяСтрока.ЕдиницаИзмерения			= ТекСтрока.ЕдиницаИзмеренияИнгредиента;
				НоваяСтрока.Количество					= ТекСтрока.КоличествоУпаковокИнгредиентаНорма;
				НоваяСтрока.Коэффициент					= ТекКоэффициентЕИИнгредиента;
				
				НоваяСтрока.Вес							= 0;
				НоваяСтрока.ПлотностьНапитка			= 0;
				НоваяСтрока.ТарнаяЕдиницаИзмерения		= Ложь;
				НоваяСтрока.ВесТары						= 0;
				
				НоваяСтрока.КоличествоВзвешенныхЕдиниц	= 0;
				НоваяСтрока.ИзПолуфабриката				= Истина;
				НоваяСтрока.ИдентификаторРодителя		= НайденнаяСтрока.ИдентификаторСтроки;
				НоваяСтрока.ИдентификаторСтроки			= Новый УникальныйИдентификатор;
				
			Иначе
				// Строку нашли, обновляем количество в ней.
				НайденнаяСтрока = НайденныеСтрокиПоЕИ[0];
				НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + ТекСтрока.КоличествоУпаковокИнгредиентаНорма;
			КонецЕсли;
			
		КонецЦикла;
		
		// Учетные количества.
		питИнвентаризация.ПерезаполнитьУчетныеДанныеСтрок(СтрокиЗаполнитьУчет, Новый Структура("Склад, Дата", СтруктураОбъекта.Склад, СтруктураОбъекта.Дата), Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличество);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Посчитать количества вединицах хранения.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ПосчитатьКоличестваВединицахХранения(ИмяТЧ)
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		
		КэшированныеЗначенияЛокальные = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначенияЛокальные);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Полуфабрикаты номенклатура при изменении на сервере.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//  ПараметрыОбъекта - Произвольный - Параметры объекта.
//
&НаСервереБезКонтекста
Процедура ПолуфабрикатыНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, ПараметрыОбъекта)
	
	СпособРасчетаРецептуры = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
	
	ДатаРецептуры = ?(ЗначениеЗаполнено(ПараметрыОбъекта.Ссылка), ПараметрыОбъекта.Дата, КонецДня(ПараметрыОбъекта.Дата));
	СтрокаТабличнойЧасти.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(СтрокаТабличнойЧасти.Номенклатура,СтрокаТабличнойЧасти.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
	ДатаРецептуры, СпособРасчетаРецептуры, , ПараметрыОбъекта.ОрганизацияРецептур,,,ПараметрыОбъекта.Подразделение);
	
КонецПроцедуры

#КонецОбласти

// Вызывается в обработчике события "ПриСозданииНаСервере".
//  Программное создание элементов и реквизитов формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаСервере
Процедура питПриСозданииНаСервере(Форма)
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Вкладка ввода количеств
	
	Форма.Элементы.ГруппаТовары.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	
	ГруппаТело				= Форма.Элементы.Вставить("питГруппаТелоДокумента", Тип("ГруппаФормы"), Форма.Элементы.ГруппаТовары);
	ГруппаТело.Вид 			= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТело.Отображение	= ОтображениеОбычнойГруппы.Нет; 
	ГруппаТело.Группировка	= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаТело.ОтображатьЗаголовок = Ложь;
	
	Форма.Элементы.Переместить(Форма.Элементы.УсловияПересчетаТоваров, ГруппаТело);
	Форма.Элементы.Переместить(Форма.Элементы.ГруппаТоварыШапка, ГруппаТело);
	Форма.Элементы.Переместить(Форма.Элементы.Товары, ГруппаТело);
	// Форма.Элементы.Переместить(Форма.Элементы.ТоварыПоЕдиницамИзмерения, ГруппаТело);
	
	ГруппаБоковаяПанель				= Форма.Элементы.Вставить("питГруппаБоковаяПанель", Тип("ГруппаФормы"), Форма.Элементы.ГруппаТовары);
	ГруппаБоковаяПанель.Вид 		= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаБоковаяПанель.Отображение	= ОтображениеОбычнойГруппы.Нет; 
	ГруппаБоковаяПанель.Группировка	= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаБоковаяПанель.ОтображатьЗаголовок = Ложь;
	
	ГруппаРазделитель			= Форма.Элементы.Вставить("питГруппаРазделитель", Тип("ГруппаФормы"), ГруппаБоковаяПанель);
	ГруппаРазделитель.Вид 		= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаРазделитель.Видимость 	= Истина;
	ГруппаРазделитель.Отображение	= ОтображениеОбычнойГруппы.Нет; 
	ГруппаРазделитель.Группировка	= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаРазделитель.ОтображатьЗаголовок = Ложь;
	ГруппаРазделитель.РастягиватьПоВертикали = Истина;
	ГруппаРазделитель.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
	
	ДекорацияФормы 			= Форма.Элементы.Вставить("питДекорацияРазвернуть", Тип("ДекорацияФормы"), ГруппаРазделитель);
	ДекорацияФормы.Вид 		= ВидДекорацииФормы.Картинка;
	ДекорацияФормы.Картинка = БиблиотекаКартинок.питРазвернутьОтборы;
	ДекорацияФормы.Ширина 	= 1;
	ДекорацияФормы.Высота 	= 2;
	ДекорацияФормы.Масштабировать = Истина;
	ДекорацияФормы.РазмерКартинки = РазмерКартинки.Пропорционально;
	ДекорацияФормы.Гиперссылка = Истина;
	ДекорацияФормы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
	
	ГруппаКоличеств				= Форма.Элементы.Вставить("питГруппаКоличеств", Тип("ГруппаФормы"), ГруппаБоковаяПанель);
	ГруппаКоличеств.Вид 		= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКоличеств.Видимость 	= Ложь;
	ГруппаКоличеств.Ширина 		= 40;
	ГруппаКоличеств.Отображение	= ОтображениеОбычнойГруппы.Нет;
	ГруппаКоличеств.Группировка	= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаКоличеств.ШрифтЗаголовка = Новый Шрифт(ГруппаБоковаяПанель.ШрифтЗаголовка, , 11);
	ГруппаКоличеств.РастягиватьПоВертикали = Истина;
	ГруппаКоличеств.ОтображатьЗаголовок = Ложь;
	
	ДекорацияФормы = Форма.Элементы.Вставить("питДекорацияВерх", Тип("ДекорацияФормы"), ГруппаКоличеств);
	ДекорацияФормы.Вид = ВидДекорацииФормы.Картинка;
	ДекорацияФормы.Высота = 1;
	ДекорацияФормы.Заголовок = "";
	ДекорацияФормы.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
	ДекорацияФормы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	ДекорацияФормы.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	
	ДекорацияФормы = Форма.Элементы.Вставить("питДекорацияЗаголовок", Тип("ДекорацияФормы"), ГруппаКоличеств);
	ДекорацияФормы.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияФормы.Высота = 1;
	ДекорацияФормы.Заголовок = "";
	ДекорацияФормы.ЦветТекста = ЦветаСтиля.ЦветТекстаУспех;
	ДекорацияФормы.Шрифт = Новый Шрифт(,11);
	ДекорацияФормы.РастягиватьПоГоризонтали = Истина;
	ДекорацияФормы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Авто;
	ДекорацияФормы.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Авто;
	
	КолонкиДляИсключения = Новый Массив();
	КолонкиДляИсключения.Добавить("ИдентификаторСтроки");
	КолонкиДляИсключения.Добавить("ИдентификаторРодителя");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ШиринаКолонок", 13);
	ДопПараметры.Вставить("МаксимальнаяВысота", 7);
	
	ТаблицаЕИ = СоздатьГруппуСТаблицей(Форма, "питГруппаЕдиницыИзмерения", "", ГруппаКоличеств, "питЕдиницыИзмерения", КолонкиДляИсключения, ДопПараметры);
	ТаблицаЕИ.Родитель.ШрифтЗаголовка = Новый Шрифт(ГруппаБоковаяПанель.ШрифтЗаголовка, , 3);
	
	Форма.Элементы.питЕдиницыИзмеренияКоличество.УстановитьДействие("ПриИзменении", "питВводКоличествПриИзменении");
	Форма.Элементы.питЕдиницыИзмеренияКоличество.ТолькоПросмотр = Ложь;
	
	КолонкиДляИсключения.Добавить("ПлотностьНапитка");
	КолонкиДляИсключения.Добавить("ВесТары");
	КолонкиДляИсключения.Добавить("ЕдиницаВеса");
	
	ДопПараметры.Вставить("МаксимальнаяВысота", 6);
	
	ТаблицаТЕИ = СоздатьГруппуСТаблицей(Форма, "питГруппаТарныеЕдиницыИзмерения", "Тарные", ГруппаКоличеств, "питТарныеЕдиницы", КолонкиДляИсключения, ДопПараметры);
	
	Форма.Элементы.питТарныеЕдиницыВес.ТолькоПросмотр = Ложь;
	Форма.Элементы.питТарныеЕдиницыВес.УстановитьДействие("ПриИзменении", "питВводКоличествПриИзменении");
	
	Форма.Элементы.питТарныеЕдиницыКоличествоВзвешенныхЕдиниц.ТолькоПросмотр = Ложь;
	Форма.Элементы.питТарныеЕдиницыКоличествоВзвешенныхЕдиниц.УстановитьДействие("ПриИзменении", "питВводКоличествПриИзменении");
	
	КолонкиДляИсключения.Очистить();
	КолонкиДляИсключения.Добавить("ИдентификаторСтроки");
	КолонкиДляИсключения.Добавить("ИдентификаторРодителя");
	КолонкиДляИсключения.Добавить("Номенклатура");
	
	ТаблицаПЕИ = СоздатьГруппуСТаблицей(Форма, "питГруппаПолуфабрикатныеЕдиницыИзмерения", "Полуфабрикатные", ГруппаКоличеств, "питПолуфабрикатныеЕдиницы", КолонкиДляИсключения, ДопПараметры);
	ТаблицаПЕИ.ТолькоПросмотр = Истина;
	
	ДекорацияФормы = Форма.Элементы.Вставить("питСвернутьКоличества", Тип("ДекорацияФормы"), ГруппаКоличеств);
	ДекорацияФормы.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияФормы.Заголовок = "свернуть";
	ДекорацияФормы.Гиперссылка = Истина;
	ДекорацияФормы.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
	ДекорацияФормы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	ДекорацияФормы.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	
	Форма.Элементы.питСвернутьКоличества.УстановитьДействие("Нажатие", "питИзменитьОтображениеГруппыКоличеств");
	Форма.Элементы.питДекорацияРазвернуть.УстановитьДействие("Нажатие", "питИзменитьОтображениеГруппыКоличеств");
	
	Форма.Элементы.питЕдиницыИзмерения.УстановитьДействие("ПередНачаломДобавления"			, "питТаблицыЕдиницПередНачаломДобавления");
	Форма.Элементы.питЕдиницыИзмерения.УстановитьДействие("ПередУдалением"					, "питТаблицыЕдиницПередУдалением");
	Форма.Элементы.питТарныеЕдиницы.УстановитьДействие("ПередНачаломДобавления"				, "питТаблицыЕдиницПередНачаломДобавления");
	Форма.Элементы.питТарныеЕдиницы.УстановитьДействие("ПередУдалением"						, "питТаблицыЕдиницПередУдалением");
	Форма.Элементы.питПолуфабрикатныеЕдиницы.УстановитьДействие("ПередНачаломДобавления"	, "питТаблицыЕдиницПередНачаломДобавления");
	Форма.Элементы.питПолуфабрикатныеЕдиницы.УстановитьДействие("ПередУдалением"			, "питТаблицыЕдиницПередУдалением");
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// ГруппаРежимКорректировки
	
	ГруппаРежимКорректировки = Форма.Элементы.Вставить("питГруппаРежимКорректировки",Тип("ГруппаФормы") ,Форма.Элементы.ГруппаДополнительно);
	ГруппаРежимКорректировки.Заголовок = "Режим корректировки количества";
	ГруппаРежимКорректировки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаРежимКорректировки.ОтображатьЗаголовок = Истина;
	ГруппаРежимКорректировки.РазрешитьИзменениеСостава = Ложь;
	ГруппаРежимКорректировки.РастягиватьПоГоризонтали = Ложь;
	ГруппаРежимКорректировки.Ширина = 96;
	ГруппаРежимКорректировки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ПолеФормы = Форма.Элементы.Вставить("РежимКорректировкиКоличества",Тип("ПолеФормы") ,ГруппаРежимКорректировки);
	ПолеФормы.Заголовок = "Режим корректировки количества при записи документа";
	ПолеФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеФормы.Вид = ВидПоляФормы.ПолеПереключателя;
	ПолеФормы.ВидПереключателя = ВидПереключателя.Переключатель;
	ПолеФормы.СписокВыбора.Добавить(Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.НеКорректироватьКнижноеКоличество, "Не корректировать книжное количество");
	ПолеФормы.СписокВыбора.Добавить(Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличество, "Учетное количество и цена имеющихся товаров будут откорректированы в соответствии с текущим остатком на складе. Фактическое количество останется без изменения.");
	ПолеФормы.СписокВыбора.Добавить(Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличествоСЗаполнением, "Учетное количество и цена имеющихся товаров будут откорректированы в соответствии с  остатком на складе. Товар, имеющийся на складе, но не вошедший в товарную часть документа добавится в неё. Фактическое количество приравняется к учетному количеству.");
	ПолеФормы.СписокВыбора.Добавить(Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличествоСЗаполнениемИОбновлением, "Учетное количество и цена имеющихся товаров будут откорректированы в соответствии с текущим остатком на складе. Товар, имеющийся на складе, но не вошедший в товарную часть документа добавится в неё. Фактическое количество приравняется к нулю.");
	ПолеФормы.ПутьКДанным = "Объект.РежимКорректировкиКоличества";
	ПолеФормы.КоличествоКолонок = 1;
	// ПолеФормы.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Верх;
	
КонецПроцедуры

//  Процедура - Заполнить товары по единицам измерения сервер.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ЗаполнитьТоварыПоЕдиницамИзмеренияСервер(ИдентификаторСтроки)
	питИнвентаризацияВызовСервера.ЗаполнитьТоварыПоЕдиницамИзмерения(Объект,,ИдентификаторСтроки);
КонецПроцедуры

//  Процедура - Перезаполнить учетное количество сервер.
//
&НаСервере
Процедура ПерезаполнитьУчетноеКоличествоСервер()
	
	// Учетные количества.
	питИнвентаризация.ПерезаполнитьУчетныеДанныеСтрок(Объект.Товары, Новый Структура("Склад, Дата", Объект.Склад, Объект.Дата), Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.КорректироватьКнижноеКоличество);
	
	ЗаполнитьПризнакРасхождение();
	
КонецПроцедуры

//  Процедура - Перезаполнить рецептуры полуфабрикатов на сервере.
//
&НаСервере
Процедура ПерезаполнитьРецептурыПолуфабрикатовНаСервере()
	СпособРасчетаРецептуры = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("СпособРасчетаРецептур");
	Для каждого ТекПолуфабрикат Из Объект.Полуфабрикаты Цикл
		ДатаРецептуры = ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Дата, КонецДня(Объект.Дата));
		ТекПолуфабрикат.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(ТекПолуфабрикат.Номенклатура,ТекПолуфабрикат.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
		ДатаРецептуры, СпособРасчетаРецептуры, , Объект.ОрганизацияРецептур,,,Объект.Подразделение);
	КонецЦикла;
	питРаспределитьПоТоварамНаСервере();
КонецПроцедуры

//  Функция - Получить параметры подбора.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучитьПараметрыПодбора(ИмяТаблицы)
	
	ПараметрыФормы = Новый Структура;
	
	Если ИмяТаблицы = "Полуфабрикаты" Тогда
		
		ПараметрЗаголовок = НСтр("ru = 'Подбор полуфабрикатов в %Документ%'");
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", Объект.Ссылка);
		Иначе
			ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", НСтр("ru = 'инвентарищацию товаров'"));
		КонецЕсли;
		
		ОтборТипЦен = питОбщегоНазначения.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит");
		ОтборЦенаВключаетНДС = ?(ЗначениеЗаполнено(ОтборТипЦен), питОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборТипЦен, "ЦенаВключаетНДС"), Истина);
		
		ПараметрыФормы.Вставить("Заголовок",										ПараметрЗаголовок);
		ПараметрыФормы.Вставить("Дата",												Объект.Дата);
		ПараметрыФормы.Вставить("Склад",											Объект.Склад);
		ПараметрыФормы.Вставить("Организация",										Объект.ОрганизацияРецептур);
		ПараметрыФормы.Вставить("Валюта",											питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета());
		ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти",	Ложь);
		ПараметрыФормы.Вставить("Документ",											Объект.Ссылка);
		ПараметрыФормы.Вставить("ВидЦены",											ОтборТипЦен);
		ПараметрыФормы.Вставить("ЦенаВключаетНДС",									ОтборЦенаВключаетНДС);
		ПараметрыФормы.Вставить("РежимПодбораБезСоглашенийСКлиентами",				Истина);
		
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции

//  Процедура - Обработка выбора подбор товаров на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение)
	
	ТекКэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Полуфабрикаты.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ТекущаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
		СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
		СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
		СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", Новый Структура("НужноОкруглять", Ложь));
		СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
			ЭтаФорма.ИмяФормы, "Полуфабрикаты"));
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, ТекКэшированныеЗначения);
		
		СтруктураТекСтроки = Новый Структура("Номенклатура, Характеристика, Рецептура", ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика, ТекущаяСтрока.Рецептура);
		ТекПараметрыОбъекта = Новый Структура("Ссылка,Дата,Подразделение,ОрганизацияРецептур", 
			Объект.Ссылка,
			Объект.Дата,
			Объект.Подразделение,
			Объект.ОрганизацияРецептур);
		ПолуфабрикатыНоменклатураПриИзмененииНаСервере(СтруктураТекСтроки, ТекПараметрыОбъекта);
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураТекСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	// +АвтовыборНоменклатуры
	Элементы.ДекорацияУточнениеХарактеристик.Видимость = Форма.НайденыОшибкиАвтовыбора;
	// +АвтовыборНоменклатуры
	
КонецПроцедуры

#КонецОбласти

#Область ИзменениеФактаВПроизводстве

//  Функция - Упаковать уточнения автовыбора.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция УпаковатьУточненияАвтовыбора()
	Возврат ПоместитьВоВременноеХранилище(Объект.УточненияАвтовыбора.Выгрузить());
КонецФункции

//  Функция - Распаковать уточнения автовыбора.
//
// Параметры:
//  Адрес - Произвольный - Адрес.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция РаспаковатьУточненияАвтовыбора(Адрес)
	Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

//  Процедура - Обработка выбора подбор характеристик на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение)
	
	Объект.УточненияАвтовыбора.Загрузить(РаспаковатьУточненияАвтовыбора(ВыбранноеЗначение));
	НайденыОшибкиАвтовыбора = питУправлениеДаннымиОбИзделиях.ЗаполнитьНайденыОшибкиАвтовыбора(Объект.УточненияАвтовыбора);
	// Если НЕ НайденыОшибкиАвтовыбора Тогда
		питРаспределитьПоТоварамНаСервере();
	// КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - Заполнить фрагмент.
//
&НаКлиенте
Процедура ЗаполнитьФрагмент()
	
	ЗаполнитьСервер();
	
КонецПроцедуры

//  Процедура - Установить условное оформление.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма);
	
	// +пит
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма, 
		"ПолуфабрикатыХарактеристика",
		"Объект.Полуфабрикаты.ХарактеристикиИспользуются");
	
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
	ПараметрыУсловногоОформления.ИмяПоляЕдиницаИзмерения = "ПолуфабрикатыУпаковкаЕдиницаИзмерения";
	ПараметрыУсловногоОформления.ПутьКПолюУпаковка = "Объект.Полуфабрикаты.Упаковка";
	питДлительнаяПоддержка.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, ПараметрыУсловногоОформления);
	// -пит
	
	//
	
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма, "СерииВсегдаВТЧТовары");
	
	//
	
	НоменклатураСервер.УстановитьУсловноеОформлениеНазначенияНоменклатуры(ЭтаФорма);
	
	//
	
КонецПроцедуры

//  Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипИзмеряемойВеличины",
											Новый Структура("Номенклатура", "ТипИзмеряемойВеличины"));
	
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары,ПараметрыЗаполненияРеквизитов);
	
	// +пит
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Полуфабрикаты,ПараметрыЗаполненияРеквизитов);
	// -пит
	
КонецПроцедуры

//  Процедура - При чтении создании на сервере.
//
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	НастроитьПоСкладуПомещению();
	ИнициализироватьКомпоновкуДанных(Ложь);
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	ЗаполнитьПризнакРасхождение();
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.питИнвентаризацияТоваров));
	УстановитьВидимостьЭлементовСерий();
	
	// +пит
	Если Объект.Ссылка.Пустая() Тогда
		Объект.РежимКорректировкиКоличества = Константы.питРежимКорректировкиКоличестваВИнвентаризации.Получить();
		Если НЕ ЗначениеЗаполнено(Объект.РежимКорректировкиКоличества) Тогда
			Объект.РежимКорректировкиКоличества = Перечисления.питРежимКорректировкиКоличестваВИнвентаризации.НеКорректироватьКнижноеКоличество;
		КонецЕсли;
	КонецЕсли;
	// -пит
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

ВыполняетсяЗапись = Ложь;

#КонецОбласти


