
#Область ОбработчикиСобытийФормы

#Область ИзменениеФактаВПроизводстве

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.питФормаПодбораХарактеристик" Тогда
		
		// +АвтовыборНоменклатуры
		ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение);
		// -АвтовыборНоменклатуры
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Заголовок = "КАЛЬКУЛЯЦИОННАЯ КАРТОЧКА ";
	
	
	Подразделение = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОсновноеПодразделениеОрганизации");
	РассчитываемоеКоличество = 1;
	НеИспользоватьСезонныеПроценты = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питНеИспользоватьСезонныеПроценты");
	
	ДатаФормирования = ТекущаяДата();
	
	Если Параметры.Свойство("РецептурнаяЕдиница") Тогда
		РецептурнаяЕдиница = ?(Параметры.РецептурнаяЕдиница=Истина, 1, 2);
	Иначе
		РецептурнаяЕдиница = 2;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыЦен.Ссылка
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	ВидыЦен.ПометкаУдаления = ЛОЖЬ";
	
	СписокТипЦен = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Элементы.ТипЦен.СписокВыбора.ЗагрузитьЗначения(СписокТипЦен);
	
	Если ТипЗнч(Параметры.МассивОбъектов) = Тип("Массив") Тогда
		// Определим блюдо из документа рецептуры
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов", Параметры.МассивОбъектов);
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	питРецептура.Номенклатура КАК Номенклатура,
		|	питРецептура.Организация КАК Организация,
		|	питРецептура.Подразделение КАК Подразделение,
		|	питРецептура.ЦеховаяКладовая КАК ЦеховаяКладовая,
		|	питРецептура.Характеристика КАК Характеристика,
		|	питРецептура.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА питРецептура.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
		|			ИЛИ питРецептура.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры)
		|			ИЛИ питРецептура.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
		|				ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ХарактеристикиИспользуются
		|ИЗ
		|	Документ.питРецептура КАК питРецептура
		|ГДЕ
		|	питРецептура.Ссылка В(&МассивОбъектов)
		// +АвтовыборНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	питРецептураУточненияАвтовыбора.Ключ КАК Ключ,
		|	питРецептураУточненияАвтовыбора.КлючРодителя КАК КлючРодителя,
		|	питРецептураУточненияАвтовыбора.Номенклатура КАК Номенклатура,
		|	питРецептураУточненияАвтовыбора.Характеристика КАК Характеристика,
		|	питРецептураУточненияАвтовыбора.Рецептура КАК Рецептура,
		|	питРецептураУточненияАвтовыбора.ОшибкаАвтовыбора КАК ОшибкаАвтовыбора
		|ИЗ
		|	Документ.питРецептура.УточненияАвтовыбора КАК питРецептураУточненияАвтовыбора
		|ГДЕ
		|	питРецептураУточненияАвтовыбора.Ссылка В(&МассивОбъектов)";
		
		РезультатПакет = Запрос.ВыполнитьПакет();
		
		Выборка = РезультатПакет[0].Выбрать();
		// -АвтовыборНоменклатуры
		
		Если Выборка.Количество()=1 Тогда
			Если Выборка.Следующий() Тогда
				Блюдо = Выборка.Номенклатура;
				// +АвтовыборНоменклатуры
				ОрганизацияУточнения			= Выборка.Организация;
				ПодразделениеУточнения			= Выборка.Подразделение;
				СкладУточнения					= Выборка.ЦеховаяКладовая;
				НоваяСтрока						= УточненияАвтовыбора.Добавить();
				НоваяСтрока.Ключ				= Новый УникальныйИдентификатор;
				НоваяСтрока.Номенклатура		= Выборка.Номенклатура;
				НоваяСтрока.Характеристика		= Выборка.Характеристика;
				НоваяСтрока.Рецептура			= Выборка.Ссылка;
				НоваяСтрока.ОшибкаАвтовыбора	= Истина;
				// -АвтовыборНоменклатуры
				
				// Определим количество блюда и дату из документа рецептуры
				Запрос.УстановитьПараметр("Номенклатура", Выборка.Номенклатура);
				Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	питРецептура.Номенклатура,
				|	питРецептура.Количество,
				|	питРецептура.Упаковка,
				|	питРецептура.Дата КАК Дата,
				|	ВЫБОР
				|		КОГДА Константы.питСпособРасчетаРецептур = ЗНАЧЕНИЕ(Перечисление.питСпособРасчетаРецептур.ПоАктуальнойРецептуре)
				|			ТОГДА ЛОЖЬ
				|		ИНАЧЕ питРецептура.Основная
				|	КОНЕЦ КАК Основная
				|ИЗ
				|	Документ.питРецептура КАК питРецептура,
				|	Константы КАК Константы
				|ГДЕ
				|	питРецептура.Ссылка В(&МассивОбъектов)
				|	И питРецептура.Номенклатура = &Номенклатура
				|
				|УПОРЯДОЧИТЬ ПО
				|	Основная УБЫВ,
				|	Дата УБЫВ
				|АВТОУПОРЯДОЧИВАНИЕ";
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					РассчитываемоеКоличество = Выборка.Количество;
					ЕдиницаИзмерения = Выборка.Упаковка;
					Если ДатаФормирования = Неопределено Тогда
						// Т.е. режим по основной рецептуре, дату берем из документа.
						ДатаФормирования = Выборка.Дата;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Выборка.Количество()=0 Тогда
			Блюдо = "(нет блюд приготовления)";
		Иначе
			Пока Выборка.Следующий() Цикл
				// +АвтовыборНоменклатуры
				ОрганизацияУточнения			= Выборка.Организация;
				ПодразделениеУточнения			= Выборка.Подразделение;
				СкладУточнения					= Выборка.ЦеховаяКладовая;
				НоваяСтрока						= УточненияАвтовыбора.Добавить();
				НоваяСтрока.Ключ				= Новый УникальныйИдентификатор;
				НоваяСтрока.Номенклатура		= Выборка.Номенклатура;
				НоваяСтрока.Характеристика		= Выборка.Характеристика;
				НоваяСтрока.Рецептура			= Выборка.Ссылка;
				НоваяСтрока.ОшибкаАвтовыбора	= Истина;
				// -АвтовыборНоменклатуры
			КонецЦикла;
			Блюдо = "(несколько блюд)";
		КонецЕсли;
		
		// +АвтовыборНоменклатуры
		УточненияАвтовыбораТаблица = РезультатПакет[1].Выгрузить();
		Если УточненияАвтовыбораТаблица.Количество() Тогда
			УточненияАвтовыбора.Загрузить(УточненияАвтовыбораТаблица);
		КонецЕсли;
		// -АвтовыборНоменклатуры
		
	Иначе
		Блюдо = "(не выбраны документы)";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ИзменениеФактаВПроизводстве

//  Процедура - Расчет цены по полуфабрикату при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РасчетЦеныПоПолуфабрикатуПриИзменении(Элемент)
	Если  РасчетЦеныПоПолуфабрикату Тогда
		Элементы.РазворачиватьДоИнгредиентов.Доступность = Ложь;
		РазворачиватьДоИнгредиентов = Ложь;
	Иначе
		Элементы.РазворачиватьДоИнгредиентов.Доступность = Истина;
	КонецЕсли;
	
	КонецПроцедуры

#КонецОбласти

#КонецОбласти


#Область ОбработчикиКомандФормы

#Область ИзменениеФактаВПроизводстве

//  Процедура - Уточнить характеристики.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура УточнитьХарактеристики(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("АдресУточненияАвтовыбора"	, УпаковатьУточненияАвтовыбора());
	СтруктураПараметров.Вставить("Ссылка"					, ПредопределенноеЗначение("Документ.питВыпускБлюд.ПустаяСсылка"));
	СтруктураПараметров.Вставить("Организация"				, ОрганизацияУточнения);
	СтруктураПараметров.Вставить("Подразделение"			, ПодразделениеУточнения);
	СтруктураПараметров.Вставить("Дата"						, ДатаФормирования);
	СтруктураПараметров.Вставить("Склад"					, СкладУточнения);
	СтруктураПараметров.Вставить("ЗаголовокКнопки"			, "Перенести в форму печати");
	
	ОткрытьФорму("ОбщаяФорма.питФормаПодбораХарактеристик", СтруктураПараметров, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

/////////////////////////////////////////////////
// 	ПРОЦЕДУРЫ ОБРАБОТЧКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

//  Процедура - Команда ок закрыть.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура КомандаОкЗакрыть(Команда)
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("РассчитываемоеКоличество", РассчитываемоеКоличество);
	СтруктураПараметров.Вставить("ДатаФормирования",         ДатаФормирования);
	СтруктураПараметров.Вставить("Подразделение",            Подразделение);
	СтруктураПараметров.Вставить("ТипЦенПродажи",            ТипЦенПродажи);
	СтруктураПараметров.Вставить("РецептурнаяЕдиница",       (РецептурнаяЕдиница=1));
	СтруктураПараметров.Вставить("НеИспользоватьСезонныеПроценты", НеИспользоватьСезонныеПроценты);
	СтруктураПараметров.Вставить("РазворачиватьДоИнгредиентов", РазворачиватьДоИнгредиентов);	
	СтруктураПараметров.Вставить("РасчетЦеныПоПолуфабрикату", РасчетЦеныПоПолуфабрикату);

	Если ЗначениеЗаполнено(ПодразделениеПолуфабрикатов) Тогда
		СтруктураПараметров.Вставить("ПодразделениеПолуфабрикатов", ПодразделениеПолуфабрикатов);
	КонецЕсли;
	// +АвтовыборНоменклатуры
	СтруктураПараметров.Вставить("УточненияАвтовыбора", УпаковатьУточненияАвтовыбора());
	// +АвтовыборНоменклатуры
	Закрыть(СтруктураПараметров);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИзменениеФактаВПроизводстве

//  Функция - Упаковать уточнения автовыбора.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция УпаковатьУточненияАвтовыбора()
	Возврат ПоместитьВоВременноеХранилище(УточненияАвтовыбора.Выгрузить());
КонецФункции

//  Функция - Распаковать уточнения автовыбора.
//
// Параметры:
//  Адрес - Произвольный - Адрес.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция РаспаковатьУточненияАвтовыбора(Адрес)
	Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

//  Процедура - Обработка выбора подбор характеристик на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение)
	
	УточненияАвтовыбора.Загрузить(РаспаковатьУточненияАвтовыбора(ВыбранноеЗначение));
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти



