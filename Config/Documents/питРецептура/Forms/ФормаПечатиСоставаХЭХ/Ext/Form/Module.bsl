


#Область ОбработчикиСобытийФормы

#Область ИзменениеФактаВПроизводстве

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.питФормаПодбораХарактеристик" Тогда
		
		// +АвтовыборНоменклатуры
		ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение);
		// -АвтовыборНоменклатуры
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СпособВыводаКоличестваПриИзменении(Неопределено);
	ВыводимыеХЭХПриИзменении(Неопределено);
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	
	
	КонстантаСпособРасчетаКоличестваХЭХ = Константы.питСпособРасчетаКоличестваХЭХ.Получить();
	
	Если ЗначениеЗаполнено(КонстантаСпособРасчетаКоличестваХЭХ) Тогда
		СпособРасчетаКоличестваХЭХ = Перечисления.питСпособыРасчетаКоличестваХЭХ.Индекс(КонстантаСпособРасчетаКоличестваХЭХ);
	Иначе
		СпособРасчетаКоличестваХЭХ = -1;
	КонецЕсли;
	Количество = 0;
	
	Если ТипЗнч(Параметры.МассивОбъектов) = Тип("Массив") Тогда
		// Определим блюдо из документа рецептуры
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов", Параметры.МассивОбъектов);
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	питРецептура.Номенклатура,
		|	питРецептура.Организация КАК Организация,
		|	питРецептура.Подразделение КАК Подразделение,
		|	питРецептура.ЦеховаяКладовая КАК ЦеховаяКладовая,
		|	питРецептура.Характеристика КАК Характеристика,
		|	питРецептура.Ссылка КАК Ссылка,
		|	питРецептура.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА питРецептура.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры)
		|				ИЛИ питРецептура.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры)
		|				ИЛИ питРецептура.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ХарактеристикиИспользуются
		|ИЗ
		|	Документ.питРецептура КАК питРецептура
		|ГДЕ
		|	питРецептура.Ссылка В(&МассивОбъектов)
		// +АвтовыборНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	питРецептураУточненияАвтовыбора.Ключ КАК Ключ,
		|	питРецептураУточненияАвтовыбора.КлючРодителя КАК КлючРодителя,
		|	питРецептураУточненияАвтовыбора.Номенклатура КАК Номенклатура,
		|	питРецептураУточненияАвтовыбора.Характеристика КАК Характеристика,
		|	питРецептураУточненияАвтовыбора.Рецептура КАК Рецептура,
		|	питРецептураУточненияАвтовыбора.ОшибкаАвтовыбора КАК ОшибкаАвтовыбора
		|ИЗ
		|	Документ.питРецептура.УточненияАвтовыбора КАК питРецептураУточненияАвтовыбора
		|ГДЕ
		|	питРецептураУточненияАвтовыбора.Ссылка В(&МассивОбъектов)";
		
		РезультатПакет = Запрос.ВыполнитьПакет();
		
		Выборка = РезультатПакет[0].Выбрать();
		// -АвтовыборНоменклатуры
		
		Если Выборка.Количество()=1 Тогда
			Если Выборка.Следующий() Тогда
				Блюдо = Выборка.Номенклатура;
				Номенклатура = Выборка.Номенклатура;
				
				// +АвтовыборНоменклатуры
				ОрганизацияУточнения			= Выборка.Организация;
				ПодразделениеУточнения			= Выборка.Подразделение;
				СкладУточнения					= Выборка.ЦеховаяКладовая;
				ДатаУточнения					= Выборка.Дата;
				НоваяСтрока						= УточненияАвтовыбора.Добавить();
				НоваяСтрока.Ключ				= Новый УникальныйИдентификатор;
				НоваяСтрока.Номенклатура		= Выборка.Номенклатура;
				НоваяСтрока.Характеристика		= Выборка.Характеристика;
				НоваяСтрока.Рецептура			= Выборка.Ссылка;
				НоваяСтрока.ОшибкаАвтовыбора	= Истина;
				// -АвтовыборНоменклатуры
				
				// Определим количество блюда и дату из документа рецептуры
				Запрос.УстановитьПараметр("Номенклатура", Выборка.Номенклатура);
				Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	питРецептура.Номенклатура,
				|	питРецептура.Подразделение,
				|	питРецептура.Количество,
				|	питРецептура.КоличествоУпаковок,
				|	питРецептура.Упаковка КАК ЕдиницаИзмерения,
				|	питРецептура.Дата КАК Дата,
				|	ВЫБОР
				|		КОГДА Константы.питСпособРасчетаРецептур = ЗНАЧЕНИЕ(Перечисление.питСпособРасчетаРецептур.ПоАктуальнойРецептуре)
				|			ТОГДА ЛОЖЬ
				|		ИНАЧЕ питРецептура.Основная
				|	КОНЕЦ КАК Основная
				|ИЗ
				|	Документ.питРецептура КАК питРецептура,
				|	Константы КАК Константы
				|ГДЕ
				|	питРецептура.Ссылка В(&МассивОбъектов)
				|	И питРецептура.Номенклатура = &Номенклатура
				|
				|УПОРЯДОЧИТЬ ПО
				|	Основная УБЫВ,
				|	Дата УБЫВ
				|АВТОУПОРЯДОЧИВАНИЕ";
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Количество = Выборка.Количество;
					КоличествоУпаковок = Выборка.КоличествоУпаковок;
					ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
					// +ПараметризацияРецептур
					питПодразделениеПроизводства = Выборка.Подразделение;
					// -ПараметризацияРецептур
					// Коэффициент = питДокументы.ПолучитьКоэффициентЕдиницыИзмерения(Номенклатура, ЕдиницаИзмерения);
					Коэффициент = 0;
				КонецЕсли;
				
				Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Номенклатура, Элементы.ЕдиницаИзмерения);
			КонецЕсли;
			
		ИначеЕсли Выборка.Количество()=0 Тогда
			Блюдо = "(нет блюд приготовления)";
		Иначе
			Блюдо = "(несколько блюд)";
			Пока Выборка.Следующий() Цикл
				// +АвтовыборНоменклатуры
				ОрганизацияУточнения			= Выборка.Организация;
				ПодразделениеУточнения			= Выборка.Подразделение;
				СкладУточнения					= Выборка.ЦеховаяКладовая;
				ДатаУточнения					= Выборка.Дата;
				НоваяСтрока						= УточненияАвтовыбора.Добавить();
				НоваяСтрока.Ключ				= Новый УникальныйИдентификатор;
				НоваяСтрока.Номенклатура		= Выборка.Номенклатура;
				НоваяСтрока.Характеристика		= Выборка.Характеристика;
				НоваяСтрока.Рецептура			= Выборка.Ссылка;
				НоваяСтрока.ОшибкаАвтовыбора	= Истина;
				// -АвтовыборНоменклатуры
			КонецЦикла;
		КонецЕсли;
		
		// +АвтовыборНоменклатуры
		УточненияАвтовыбораТаблица = РезультатПакет[1].Выгрузить();
		Если УточненияАвтовыбораТаблица.Количество() Тогда
			УточненияАвтовыбора.Загрузить(УточненияАвтовыбораТаблица);
		КонецЕсли;
		// -АвтовыборНоменклатуры
		
	Иначе
		Блюдо = "(не выбраны документы)";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

//  Процедура - Способ вывода количества при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпособВыводаКоличестваПриИзменении(Элемент)
	Если СпособВыводаКоличества = 1 Тогда
		Если ТипЗнч(Блюдо)=Тип("Строка") Тогда
			СпособВыводаКоличества = 0;
			ПоказатьПредупреждение(,"Невозможна печать состава ХЭХ на заданное количество, когда выборано нескольких блюд.")
		ИначеЕсли НЕ ЗначениеЗаполнено(Блюдо) Тогда
			СпособВыводаКоличества = 0;
			ПоказатьПредупреждение(,"Невозможна печать состава ХЭХ на заданное количество, когда не указано блюдо.")
		КонецЕсли;
	КонецЕсли;
	Элементы.Количество.Доступность = (СпособВыводаКоличества = 1);
	Элементы.ЕдиницаИзмерения.Доступность = (СпособВыводаКоличества = 1);
КонецПроцедуры

//  Процедура - Выводимые хэх при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ВыводимыеХЭХПриИзменении(Элемент)
	Элементы.ГруппаХЭХ.Доступность = (ВыводимыеХЭХ = 3);
КонецПроцедуры

//  Процедура - Количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	Количество = ПересчитатьКоличество(Номенклатура,ЕдиницаИзмерения, КоличествоУпаковок);
КонецПроцедуры

//  Процедура - Единица измерения при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении(Элемент)
	Количество = ПересчитатьКоличество(Номенклатура,ЕдиницаИзмерения, КоличествоУпаковок);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область ИзменениеФактаВПроизводстве

//  Процедура - Уточнить характеристики.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура УточнитьХарактеристики(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("АдресУточненияАвтовыбора"	, УпаковатьУточненияАвтовыбора());
	СтруктураПараметров.Вставить("Ссылка"					, ПредопределенноеЗначение("Документ.питВыпускБлюд.ПустаяСсылка"));
	СтруктураПараметров.Вставить("Организация"				, ОрганизацияУточнения);
	СтруктураПараметров.Вставить("Подразделение"			, ПодразделениеУточнения);
	СтруктураПараметров.Вставить("Дата"						, ДатаУточнения);
	СтруктураПараметров.Вставить("Склад"					, СкладУточнения);
	СтруктураПараметров.Вставить("ЗаголовокКнопки"			, "Перенести в форму печати");
	
	ОткрытьФорму("ОбщаяФорма.питФормаПодбораХарактеристик", СтруктураПараметров, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Печать хэх.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПечатьХЭХ(Команда)
	Отказ = Ложь;
	
	Если СпособВыводаКоличества=1 И Количество <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Неверное значение количества!";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если (ВыводимыеХЭХ = 3) И ГруппаХЭХ.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнена группа ХЭХ!";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура();
	СтруктураРезультата.Вставить("Количество", Количество);
	СтруктураРезультата.Вставить("КоличествоУпаковок", КоличествоУпаковок);
	СтруктураРезультата.Вставить("Коэффициент", Коэффициент);
	СтруктураРезультата.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
	СтруктураРезультата.Вставить("СпособВыводаКоличества", СпособВыводаКоличества);
	СтруктураРезультата.Вставить("СпособВыводаРезультата", СпособВыводаРезультата);
	СтруктураРезультата.Вставить("ВыводимыеХЭХ", ВыводимыеХЭХ);
	СтруктураРезультата.Вставить("СпособРасчетаКоличестваХЭХ", СпособРасчетаКоличестваХЭХ);
	СтруктураРезультата.Вставить("ГруппаХЭХ", ГруппаХЭХ);
	// +ПараметризацияРецептур
	СтруктураРезультата.Вставить("питПодразделениеПроизводства", питПодразделениеПроизводства);
	// -ПараметризацияРецептур
	
	// +АвтовыборНоменклатуры
	СтруктураРезультата.Вставить("УточненияАвтовыбора", УпаковатьУточненияАвтовыбора());
	// +АвтовыборНоменклатуры
	
	Закрыть(СтруктураРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИзменениеФактаВПроизводстве

//  Функция - Упаковать уточнения автовыбора.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция УпаковатьУточненияАвтовыбора()
	Возврат ПоместитьВоВременноеХранилище(УточненияАвтовыбора.Выгрузить());
КонецФункции

//  Функция - Распаковать уточнения автовыбора.
//
// Параметры:
//  Адрес - Произвольный - Адрес.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция РаспаковатьУточненияАвтовыбора(Адрес)
	Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

//  Процедура - Обработка выбора подбор характеристик на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение)
	
	УточненияАвтовыбора.Загрузить(РаспаковатьУточненияАвтовыбора(ВыбранноеЗначение));
	
КонецПроцедуры

#КонецОбласти

//  Функция - Пересчитать количество.
//
// Параметры:
//  Номенклатура - Произвольный - Номенклатура.
//  Упаковка - Произвольный - Упаковка.
//  КоличествоУпаковок - Произвольный - Количество упаковок.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПересчитатьКоличество(Номенклатура, Упаковка, КоличествоУпаковок)
	
	ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура, Упаковка);
	
	Возврат КоличествоУпаковок * ТекКоэффициент;
	
КонецФункции

#КонецОбласти


