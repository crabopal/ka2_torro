

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Подставить данные из регистра завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПодставитьДанныеИзРегистраЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ДанныеСтрокаТаблицы = ДополнительныеПараметры.ДанныеСтрокаТаблицы;
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьВидыОбработки(Неопределено);
		// ПроцентПотерьПриХолоднойОбработке = ДанныеСтрокаТаблицы.ПроцентПотерьПриХолоднойОбработке;
		// ПроцентПотерьПриГорячейОбработке = ДанныеСтрокаТаблицы.ПроцентПотерьПриГорячейОбработке;
		
	Иначе
		
		ИзменитьИнгредиентВДетальныхТаблицах(Номенклатура);
		
	КонецЕсли;
	
	ПосчитатьКоличестваВединицахХранения();
	НоменклатураПриИзмененииФрагмент();
	
КонецПроцедуры

#КонецОбласти

#Область ВидыОбработки

//  Процедура - Заполнить виды обработки завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ЗаполнитьВидыОбработкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Команда = ДополнительныеПараметры.Команда;
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьВидыОбработки(Команда);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	СписокПараметров = "Номенклатура,СпособАвтовыбораНоменклатуры, Характеристика, СтатьяКалькуляции, Упаковка, КоличествоУпаковокБрутто, КоличествоУпаковокНетто, КоличествоУпаковокВыход, 
	
			|КоличествоБрутто, КоличествоНетто, КоличествоВыход, Рецептура, Специя,
			|ЗапретитьЗамены, Замена, ХарактеристикаЗамены, КоэффициентЗамены, ПроцентПотерьПриГорячейОбработке, ПроцентПотерьПриХолоднойОбработке,
			|ЭтоБлюдо, ЭтоТовар, Иконка, СпособРасчетаРецептурыПоАктуальной, ИскатьПоВсемОрганизациям,
			// +АвтовыборНоменклатуры
			|НоменклатураСтрокой, ХарактеристикаСтрокой,
			// -АвтовыборНоменклатуры
			|ДокументХозяйственнаяОперация, ДокументДата, ДокументНоменклатура, ДокументХарактеристика, ДокументОрганизация, ДокументСсылка,АдресВидыОбработки, АдресПотериХЭХ, ИдентификаторСтроки, КлючСвязи, Копирование, НоваяСтрока, ПрименятьМеханизмВидовОбработки, АдресТекПодразделения, РасчетПоФормуле, СуффиксКолонкиКоличествДляФормул";
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, СписокПараметров);
	
	ПрименятьМеханизмВидовОбработки = ПрименятьМеханизмВидовОбработки И ДокументХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
	
	Если НЕ СпособРасчетаРецептурыПоАктуальной И НЕ ИскатьПоВсемОрганизациям Тогда
		НоваяСвязьПараметровВыбора = Новый СвязьПараметраВыбора("Отбор.Организация", "ДокументОрганизация");
		питОбщегоНазначения.ЗаменитьСвязьПараметровВыбора(Элементы.Рецептура, "Отбор.Организация", НоваяСвязьПараметровВыбора)
	КонецЕсли;
	
	НоменклатураПредыдущееЗначение = Номенклатура;
	
	// Пробуем рассчитать процент пересчета.
	Если ПроцентПотерьПриХолоднойОбработке = 0 Тогда
		Если КоличествоУпаковокБрутто>0 и КоличествоУпаковокНетто>0 Тогда
			// Если задано и то и другое, то процент рассчитаем как фактический процент пересчета.
			ПроцентПотерьПриХолоднойОбработке = РассчитатьПроцентПотерьОбработки(КоличествоУпаковокБрутто, КоличествоУпаковокНетто); 
		Иначе
			ПроцентПотерьПриХолоднойОбработке = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "питПроцентПотерьПриХолоднойОбработке");
		КонецЕсли;
	КонецЕсли;
	
	Если ПроцентПотерьПриГорячейОбработке = 0 Тогда
		Если КоличествоУпаковокВыход>0 и КоличествоУпаковокНетто>0 Тогда
			ПроцентПотерьПриГорячейОбработке = РассчитатьПроцентПотерьОбработки(КоличествоУпаковокНетто, КоличествоУпаковокВыход);
		Иначе
			ПроцентПотерьПриГорячейОбработке = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "питПроцентПотерьПриГорячейОбработке");
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоБлюдо И СпособРасчетаРецептурыПоАктуальной Тогда
		ДатаРецептуры = ?(ЗначениеЗаполнено(ДокументСсылка), ДокументДата, КонецДня(ДокументДата));
		Если НЕ ЗначениеЗаполнено(ДокументХозяйственнаяОперация) Тогда
			ДокументХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
		КонецЕсли;
		НайдПодразделения = питПроизводство.НайтиПодразделенияПоРазрешенным(ПолучитьИзВременногоХранилища(АдресТекПодразделения));
		Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(Номенклатура, Характеристика, ДокументХозяйственнаяОперация,	ДатаРецептуры, СпособРасчетаРецептурыПоАктуальной, , ДокументОрганизация,,,НайдПодразделения);
		
	ИначеЕсли ЭтоТовар Тогда
		Рецептура = Неопределено;
	КонецЕсли;
	
	ЭтаФорма.Заголовок = "Строка рецептуры блюда "+"'"+ДокументНоменклатура+"'"; 
	
	УправлениеФормой(ЭтаФорма);
	
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Номенклатура, Элементы.Упаковка);
	
	Модифицированность = Ложь;
	
	// Виды обработки
	Если ПрименятьМеханизмВидовОбработки Тогда
		
		ВидыОбработкиЗаполнитьДанныеСервер();
		ЗаполнитьСписокХЭХПоУмолчанию();
		ЗагрузитьДанныеПоВидамОбработкиИзВременногоХранилища();
		
	КонецЕсли;
	
	УстановитьХарактеристикиИспользуются();
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.Характеристика, ХарактеристикиИспользуются);
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.ХарактеристикаЗамены, ХарактеристикиЗаменыИспользуются);
	
	// +АвтовыборНоменклатуры
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.НоменклатураСтрокой);
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ХарактеристикаСтрокой);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	// -АвтовыборНоменклатуры
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Если происходит копирование строки, то необходимо принудительно поднять флаг модифицированности.
	Если Копирование Тогда
		Модифицированность = Истина;
		ИдентификаторСтроки = Новый УникальныйИдентификатор();
		КлючСвязи = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = Новый УникальныйИдентификатор();
		КлючСвязи = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	// Виды обработки
	Если ПрименятьМеханизмВидовОбработки Тогда
		ОбновитьОбщиеПроцентыПотерь();
		
		// +ПараметризацияРецептур
		Если РасчетПоФормуле Тогда
			ПересчитатьКоличествоПриИзмененииРасчетПоФормуле();
		Иначе
			КоличествоПриИзменении(Неопределено);
		КонецЕсли;
		// -ПараметризацияРецептур
		
		ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
		ОбновитьТаблицыРежимИнгредиентов();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	// Произведем проверку, чтобы блюдо не включало в себя это же блюдо
	Если Номенклатура = ДокументНоменклатура И Характеристика = ДокументХарактеристика Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рецептура блюда не может включать в себя это же блюдо.");
		// вернем номенклатуру
		Номенклатура = НоменклатураПредыдущееЗначение;
		Характеристика = Неопределено;
		Возврат;
	КонецЕсли;
	
	ДанныеСтрокаТаблицы = Новый Структура("Номенклатура, Характеристика, СтатьяКалькуляции, Количество, Рецептура, Упаковка, 
		|Специя, ЭтоБлюдо, ЭтоТовар, Иконка, СпособРасчетаРецептурыПоАктуальной,
		|ДокументСсылка, ДокументХозяйственнаяОперация, ДокументДата, ДокументОрганизация, ПроцентПотерьПриХолоднойОбработке, ПроцентПотерьПриГорячейОбработке");
	ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, ЭтаФорма);
	
	НоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеСтрокаТаблицы);
	
	Если ПрименятьМеханизмВидовОбработки И ЗначениеЗаполнено(НоменклатураПредыдущееЗначение) Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПодставитьДанныеИзРегистраЗавершение", ЭтотОбъект, Новый Структура("ДанныеСтрокаТаблицы", ДанныеСтрокаТаблицы)), "Подставить нормативные проценты потерь из регистра?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	Иначе
		ЗаполнитьВидыОбработки(Неопределено);
	КонецЕсли;
	
	ПосчитатьКоличестваВединицахХранения();
	НоменклатураПриИзмененииФрагмент();
КонецПроцедуры
// -ПараметризацияРецептур

//  Процедура - Количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	ОпределитьКоличество(КоличествоУпаковокНетто, КоличествоУпаковокБрутто, ПроцентПотерьПриХолоднойОбработке, Ложь, Ложь);
	ОпределитьКоличество(КоличествоУпаковокВыход, КоличествоУпаковокНетто, ПроцентПотерьПриГорячейОбработке, Ложь, Истина);
	
	ПосчитатьКоличестваВединицахХранения();
	
	Если НЕ Элемент = Неопределено Тогда 
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Количество нетто при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КоличествоНеттоПриИзменении(Элемент)
	
	Если КоличествоУпаковокБрутто = 0  ИЛИ ПрименятьМеханизмВидовОбработки Тогда
		ОпределитьКоличество(КоличествоУпаковокБрутто, КоличествоУпаковокНетто, ПроцентПотерьПриХолоднойОбработке, Истина, Ложь);
	Иначе
		ПроцентПотерьПриХолоднойОбработке = РассчитатьПроцентПотерьОбработки(КоличествоУпаковокБрутто, КоличествоУпаковокНетто);
	КонецЕсли;
	
	ОпределитьКоличество(КоличествоУпаковокВыход, КоличествоУпаковокНетто, ПроцентПотерьПриГорячейОбработке, Ложь, Истина);
	
	ПосчитатьКоличестваВединицахХранения();
КонецПроцедуры



//  Процедура - Количество выход при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КоличествоВыходПриИзменении(Элемент)
	
	Если КоличествоУпаковокНетто = 0 ИЛИ ПрименятьМеханизмВидовОбработки Тогда
		ОпределитьКоличество(КоличествоУпаковокНетто, КоличествоУпаковокВыход, ПроцентПотерьПриГорячейОбработке, Истина, Истина);
	Иначе
		ПроцентПотерьПриГорячейОбработке = РассчитатьПроцентПотерьОбработки(КоличествоУпаковокНетто, КоличествоУпаковокВыход);
	КонецЕсли;
	
	Если КоличествоУпаковокБрутто = 0 ИЛИ ПрименятьМеханизмВидовОбработки Тогда
		ОпределитьКоличество(КоличествоУпаковокБрутто, КоличествоУпаковокНетто, ПроцентПотерьПриХолоднойОбработке, Истина, Ложь);
	Иначе
		ПроцентПотерьПриХолоднойОбработке = РассчитатьПроцентПотерьОбработки(КоличествоУпаковокБрутто, КоличествоУпаковокНетто);
	КонецЕсли;
	
	ПосчитатьКоличестваВединицахХранения();
КонецПроцедуры

//  Процедура - Специя при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпецияПриИзменении(Элемент)
	
	// Удалим невидимые десятичные знаки
	Если НЕ Специя Тогда
		КоличествоУпаковокБрутто      = Окр(КоличествоУпаковокБрутто, 3);
		КоличествоУпаковокНетто = Окр(КоличествоУпаковокНетто, 3);
		КоличествоУпаковокВыход = Окр(КоличествоУпаковокВыход, 3);
	КонецЕсли;
	// Исправим номер иконки
	Иконка = Цел(Иконка/2)*2 + ?(Специя, 1, 0);
	
	ПосчитатьКоличестваВединицахХранения();
	
	УправлениеФормой(ЭтаФорма);
	
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Запретить замены при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗапретитьЗаменыПриИзменении(Элемент)
	УправлениеФормой(ЭтаФорма);
	
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура УпаковкаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ПосчитатьКоличестваВединицахХранения();
	КонецЕсли;
	
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Замена при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗаменаПриИзменении(Элемент)
	Модифицированность = Истина;
	УстановитьХарактеристикиИспользуются();
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.ХарактеристикаЗамены, ХарактеристикиЗаменыИспользуются);
КонецПроцедуры

//  Процедура - Коэффициент замены при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КоэффициентЗаменыПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Рецептура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РецептураПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Таблица хэх ингредиенты при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область ВидыОбработки

#Область ОбработчикиСобытийТаблицаХЭХПоИнгредиентам

// Обработчик события "ПередНачаломДобавления" таблицы формы "ТаблицаХЭХИнгредиенты".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат; // Копирование запрещено.
	КонецЕсли;
	
	ТекДанныеДерево = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если НЕ ТекДанныеДерево = Неопределено И ТипЗнч(ТекДанныеДерево.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		
		// Открытие формы выбора.
		ПараметрыВыбора = Новый Структура("РежимВыбора", Истина);
		ФормаВыбора = ПолучитьФорму("Справочник.питХимикоэнергетическиеХарактеристики.ФормаВыбора",ПараметрыВыбора,Элемент);
		ФормаВыбора.Открыть();
		
	Иначе // Необходимо, чтобы был установлен вид обработки в дереве, иначе не понятно, для кого ХЭХ.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в дереве видов обработки!");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "Выбор" таблицы формы "ТаблицаХЭХИнгредиенты".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.ТаблицаХЭХИнгредиентыХимикоэнергетическаяХарактеристика Тогда
		
		// Если фокус на колонке "ХЭХ", то открываем значение.
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.ХимикоэнергетическаяХарактеристика);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ОбработкаВыбора" таблицы формы "ТаблицаХЭХИнгредиенты".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ТаблицаХЭХИнгредиентыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанныеДерево = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если НЕ ТекДанныеДерево = Неопределено И ТипЗнч(ТекДанныеДерево.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		
		ТекВидОбработки = ТекДанныеДерево.Группировка;
		ТекТипОбработки = ТекДанныеДерево.ТипОбработки;
		ТекИнгредиент = ТекДанныеДерево.Ингредиент;
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.питХимикоэнергетическиеХарактеристики") Тогда
			
			// Установка текущей строки для дерева видов обработок и таблицы хэх.
			Если ТекТипОбработки = ПредопределенноеЗначение("Перечисление.питТипыОбработкиСырья.Горячая") Тогда
				ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиГорячая);
			Иначе
				ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиХолодная);
			КонецЕсли;
			Если НЕ ТекВетка = Неопределено Тогда
				НайденныеСтроки = ТаблицаХЭХ.НайтиСтроки(Новый Структура("Ингредиент, ВидОбработки, ХимикоэнергетическаяХарактеристика", ТекИнгредиент, ТекВидОбработки, ВыбранноеЗначение));
				Если НайденныеСтроки.Количество() Тогда
					ТекЭлементХЭХ = НайденныеСтроки[0];
				Иначе
					ТекЭлементХЭХ = ТаблицаХЭХ.Добавить();
					ТекЭлементХЭХ.ХимикоэнергетическаяХарактеристика = ВыбранноеЗначение;
					ТекЭлементХЭХ.Ингредиент = ТекИнгредиент;
					ТекЭлементХЭХ.ВидОбработки = ТекВидОбработки;
				КонецЕсли;
				
				Элементы.ТаблицаХЭХИнгредиенты.ТекущаяСтрока = ТекЭлементХЭХ.ПолучитьИдентификатор();
				
			КонецЕсли;
			
			// Обновление отбора строк.
			ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
			
			Модифицированность = Истина;
		КонецЕсли;
		
	Иначе // Необходимо, чтобы был установлен вид обработки в дереве, иначе не понятно, для кого ХЭХ.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в дереве видов обработки!");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийДеревоИнгредиентов

// Обработчик события "Выбор" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено 
		И Элемент.ТекущийЭлемент = Элементы.ДеревоИнгредиентыВидыОбработкиГруппировка Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Группировка);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПриАктивизацииСтроки" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиПриАктивизацииСтроки(Элемент)
	
	// Обновление отбора в таблице ХЭХ
	ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
	
КонецПроцедуры

// Обработчик события "ПередНачаломДобавления" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат; // Копирование запрещено.
	КонецЕсли;
	
	// Открытие формы выбора.
	ПараметрыВыбора = Новый Структура("РежимВыбора, ЭтоФормаВидовОбработки", Истина, Истина);
	ФормаВыбора = ПолучитьФорму("Справочник.питВидыОбработкиСырья.ФормаВыбора",ПараметрыВыбора,Элемент);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

// Обработчик события "ОбработкаВыбора" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекИнгредиент = Номенклатура;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		// Обработка структуры с видом и типом обработки, пришедшей из формы выбора.
		
		ТекВидОбработки = Неопределено;
		ТекТипОбработки = Неопределено;
		Если ВыбранноеЗначение.Свойство("ВидОбработки",ТекВидОбработки) Тогда
			Если ВыбранноеЗначение.Свойство("ТипОбработки",ТекТипОбработки) Тогда
				
				// Обновление текущей строки.
				Если ТекТипОбработки = ПредопределенноеЗначение("Перечисление.питТипыОбработкиСырья.Горячая") Тогда
					ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиГорячая);
				Иначе
					ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиХолодная);
				КонецЕсли;
				Если НЕ ТекВетка = Неопределено Тогда
					
					ТекДобавляемыйЭлемент = Неопределено;
					
					Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
						Если ТекЭлементВетки.Группировка = ТекВидОбработки И ТекЭлементВетки.Ингредиент = ТекИнгредиент Тогда
							ТекДобавляемыйЭлемент = ТекЭлементВетки;
						КонецЕсли;
					КонецЦикла;
					
					Если ТекДобавляемыйЭлемент = Неопределено Тогда
						ТекДобавляемыйЭлемент = ТекВетка.ПолучитьЭлементы().Добавить();
						ТекДобавляемыйЭлемент.Группировка		= ТекВидОбработки;
						ТекДобавляемыйЭлемент.Ингредиент		= ТекИнгредиент;
						ТекДобавляемыйЭлемент.ТипОбработки		= ТекТипОбработки;
						ТекДобавляемыйЭлемент.ЭтоГруппировка	= Ложь;
						
						Для каждого ТекХЭХ Из СписокХЭХПоУмолчанию Цикл
							НовХЭХ = ТаблицаХЭХ.Добавить();
							НовХЭХ.Ингредиент = ТекИнгредиент;
							НовХЭХ.ВидОбработки = ТекВидОбработки;
							НовХЭХ.ХимикоэнергетическаяХарактеристика = ТекХЭХ.Значение;
						КонецЦикла;
						
					КонецЕсли;
					
					Элементы.ДеревоИнгредиентыВидыОбработки.ТекущаяСтрока = ТекДобавляемыйЭлемент.ПолучитьИдентификатор();
					
					ОбновитьТаблицыРежимИнгредиентов();
					
				КонецЕсли;
				
				Модифицированность = Истина;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У выбираемого вида обработки должен быть задан тип!");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПередУдалением" таблицы формы "ДеревоИнгредиентыВидыОбработки".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено И НЕ ТипЗнч(ТекДанные.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры


// Обработчик события "ПриИзменении" элемента "ДеревоИнгредиентыВидыОбработки".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДеревоИнгредиентыВидыОбработкиПриИзменении(Элемент)
	
	ОбновитьОбщиеПроцентыПотерь();
	// +ПараметризацияРецептур
	Если РасчетПоФормуле Тогда
		ПересчитатьКоличествоПриИзмененииРасчетПоФормуле();
	КонецЕсли;
	// -ПараметризацияРецептур
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Характеристики

//  Процедура - Характеристика при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ХарактеристикаПриИзменении(Элемент)
	
	// Произведем проверку, чтобы блюдо не включало в себя это же блюдо
	Если Номенклатура = ДокументНоменклатура И Характеристика = ДокументХарактеристика Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рецептура блюда не может включать в себя это же блюдо.");
		// вернем номенклатуру
		Номенклатура = НоменклатураПредыдущееЗначение;
		Характеристика = Неопределено;
		Возврат;
	КонецЕсли;
	
	ДанныеСтрокаТаблицы = Новый Структура("Номенклатура, Характеристика, СтатьяКалькуляции, Количество, Рецептура, Упаковка, 
		|Специя, ЭтоБлюдо, ЭтоТовар, Иконка, СпособРасчетаРецептурыПоАктуальной,
		|ДокументСсылка, ДокументХозяйственнаяОперация, ДокументДата, ДокументОрганизация, ПроцентПотерьПриХолоднойОбработке, ПроцентПотерьПриГорячейОбработке");
	ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, ЭтаФорма);
	
	НоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеСтрокаТаблицы);
	
	ПосчитатьКоличестваВединицахХранения();
	НоменклатураПриИзмененииФрагмент();
	
КонецПроцедуры

//  Процедура - Характеристика замены при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ХарактеристикаЗаменыПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Статья калькуляции при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СтатьяКалькуляцииПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область ВидыОбработки

#Область ОбработчикиСобытийТаблицаХЭХПоИнгредиентам

// Обработчик команды "ПодборТаблицаХЭХИнгредиенты".
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборТаблицаХЭХИнгредиенты(Команда)
	
	ТекДанныеДерево = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если НЕ ТекДанныеДерево = Неопределено И ТипЗнч(ТекДанныеДерево.Группировка) = Тип("СправочникСсылка.питВидыОбработкиСырья") Тогда
		
		// Открытие формы выбора.
		ПараметрыВыбора = Новый Структура("РежимВыбора, ЗакрыватьПриВыборе", Истина, Ложь);
		ФормаВыбора = ПолучитьФорму("Справочник.питХимикоэнергетическиеХарактеристики.ФормаВыбора",ПараметрыВыбора,Элементы.ТаблицаХЭХИнгредиенты);
		ФормаВыбора.Открыть();
		
	Иначе // Необходимо, чтобы был установлен вид обработки в дереве, иначе не понятно, для кого ХЭХ.
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид обработки в дереве видов обработки!");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийДеревоИнгредиентов

// Обработчик команды "ПодборДеревоВидыОбработки".
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборДеревоВидыОбработки(Команда)
	
	// Открытие формы выбора.
	ПараметрыВыбора = Новый Структура("РежимВыбора, ЭтоФормаВидовОбработки, ЗакрыватьПриВыборе", Истина, Истина, Ложь);
	ФормаВыбора = ПолучитьФорму("Справочник.питВидыОбработкиСырья.ФормаВыбора",ПараметрыВыбора,Элементы.ДеревоИнгредиентыВидыОбработки);
	ФормаВыбора.Открыть();
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Заполнить виды обработки обработчик.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаполнитьВидыОбработкиОбработчик(Команда)
	
	Если ПрименятьМеханизмВидовОбработки И ЗначениеЗаполнено(НоменклатураПредыдущееЗначение) Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьВидыОбработкиЗавершение", ЭтотОбъект, Новый Структура("Команда", Команда)), "Подставить нормативные проценты потерь из регистра?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заполнить виды обработки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаполнитьВидыОбработки(Команда)
	
	ЗаполнитьДетальныеТаблицыПоИнгредиенту(Номенклатура);
	
	ОбновитьОбщиеПроцентыПотерь();
	// +ПараметризацияРецептур
	Если РасчетПоФормуле Тогда
		ПересчитатьКоличествоПриИзмененииРасчетПоФормуле();
	КонецЕсли;
	// -ПараметризацияРецептур
	
	Если ПрименятьМеханизмВидовОбработки Тогда
		ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
		ОбновитьТаблицыРежимИнгредиентов();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Команда ок закрыть.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура КомандаОкЗакрыть(Команда)
	
	Отказ = Ложь;
	
	Если ЭтоБлюдо Тогда
		Если НЕ ЗначениеЗаполнено(Рецептура) И НЕ СпособРасчетаРецептурыПоАктуальной Тогда
			ТекстСообщения = "Не указана рецептура.";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , "Рецептура", Отказ);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Замена) Тогда
		Если КоэффициентЗамены=0 Тогда
			ТекстСообщения = "Не указан коэффициент замены.";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , "КоэффициентЗамены", Отказ);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Если НЕ Специя Тогда
			ОкруглитьКоличество(КоличествоУпаковокБрутто);
			ОкруглитьКоличество(КоличествоУпаковокНетто);
			ОкруглитьКоличество(КоличествоУпаковокВыход);
			
			ОкруглитьКоличество(КоличествоБрутто);
			ОкруглитьКоличество(КоличествоНетто);
			ОкруглитьКоличество(КоличествоВыход);
		КонецЕсли;
		Если ЗапретитьЗамены ИЛИ НЕ ЭтоТовар ИЛИ Специя Тогда
			Замена = Неопределено;
			КоэффициентЗамены = 0;
		КонецЕсли;
		Если НЕ ЭтоТовар Тогда
			ЗапретитьЗамены = Ложь;
		КонецЕсли;
		Если НЕ ЭтоБлюдо Тогда
			Рецептура = Неопределено;
		КонецЕсли;
		
		ВыгрузитьДанныеПоВидамОбработкиВоВременноеХранилище();
		
		// Заполнение по умолчанию СпособАвтовыбораНоменклатуры 
		Если Не ЗначениеЗаполнено(ЭтаФорма.СпособАвтовыбораНоменклатуры) Тогда
			питЗаполнитьСпособАвтовыбораНоменклатурыПоУмолчанию();
		КонецЕсли;
		
		
		ПараметрыСтроки = Новый Структура("Номенклатура,СпособАвтовыбораНоменклатуры,Характеристика, СтатьяКалькуляции, Упаковка, КоличествоУпаковокБрутто, КоличествоУпаковокНетто, КоличествоУпаковокВыход, 
				|КоличествоБрутто, КоличествоНетто, КоличествоВыход, Рецептура, Специя,
				|ЗапретитьЗамены, Замена, ХарактеристикаЗамены, КоэффициентЗамены, ПроцентПотерьПриГорячейОбработке, ПроцентПотерьПриХолоднойОбработке,
				|ЭтоБлюдо, ЭтоТовар, Иконка, АдресВидыОбработки, АдресПотериХЭХ, ИдентификаторСтроки, КлючСвязи, ПроцентСебестоимости, РасчетПоФормуле");
		ЗаполнитьЗначенияСвойств(ПараметрыСтроки, ЭтаФорма);
		
		Закрыть(ПараметрыСтроки);
		
	Иначе
		Закрыть(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Пересчет брутто от нетто.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПересчетБруттоОтНетто(Команда)
	ОпределитьКоличество(КоличествоУпаковокБрутто, КоличествоУпаковокНетто, ПроцентПотерьПриХолоднойОбработке, Истина, Ложь);
	ПосчитатьКоличестваВединицахХранения();
	
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Пересчет нетто от брутто.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПересчетНеттоОтБрутто(Команда)
	ОпределитьКоличество(КоличествоУпаковокНетто, КоличествоУпаковокБрутто, ПроцентПотерьПриХолоднойОбработке, Ложь, Ложь);
	ОпределитьКоличество(КоличествоУпаковокВыход, КоличествоУпаковокНетто, ПроцентПотерьПриГорячейОбработке, Ложь, Истина);
	ПосчитатьКоличестваВединицахХранения();
	
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Пересчет нетто от выход.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПересчетНеттоОтВыход(Команда)
	ОпределитьКоличество(КоличествоУпаковокНетто, КоличествоУпаковокВыход, ПроцентПотерьПриГорячейОбработке, Истина, Истина);
	ОпределитьКоличество(КоличествоУпаковокБрутто, КоличествоУпаковокНетто, ПроцентПотерьПриХолоднойОбработке, Истина, Ложь);
	ПосчитатьКоличестваВединицахХранения();
	
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Пересчет выход от нетто.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПересчетВыходОтНетто(Команда)
	ОпределитьКоличество(КоличествоУпаковокВыход, КоличествоУпаковокНетто, ПроцентПотерьПриГорячейОбработке, Ложь, Истина);
	ПосчитатьКоличестваВединицахХранения();
	
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВынестиВОбщийМодуль

// Процедура округляет количество до 3 или до 6 десятичных знаков, в зависимости от признака Специя.
//
// Параметры:
//  пКоличество - Произвольный - п количество.
//
&НаКлиенте
Процедура ОкруглитьКоличество(пКоличество)
	// При пересчетах оставляем только видимые знаки.
	Если Специя=Истина  Тогда
		пКоличество = Окр(пКоличество,6);
	Иначе
		пКоличество = Окр(пКоличество,3);
	КонецЕсли;
КонецПроцедуры

// Расчитывает новое количество по проценту потерь, и с округлением по признаку Специя.
//
// Параметры:
//  КоличествоРезультат - Произвольный - Количество результат.
//  КоличествоИсходное - Произвольный - Количество исходное.
//  ПроцентПотерь - Произвольный - Процент потерь.
//  ОбратныйРассчет - Произвольный - Обратный рассчет.
//  ГорячаяОбработка - Произвольный - Горячая обработка.
//
&НаКлиенте
Процедура ОпределитьКоличество(КоличествоРезультат, КоличествоИсходное, ПроцентПотерь, ОбратныйРассчет=Ложь, ГорячаяОбработка=Неопределено)
	
	Если ПроцентПотерь > 100 Тогда
		Если ГорячаяОбработка=Ложь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Процент потерь при холодной обработке не может превышать 100%.");
		ИначеЕсли ГорячаяОбработка=Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Процент потерь при горячей обработке не может превышать 100%.");
		Иначе
			// без предупреждений
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ПроцентПотерь=100 И ОбратныйРассчет=Истина И КоличествоИсходное<>0 Тогда
		Если ГорячаяОбработка=Ложь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не правильный процент потерь при холодной обработке.");
		ИначеЕсли ГорячаяОбработка=Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не правильный процент потерь при горячей обработке.");
		Иначе
			// без предупреждений
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ОбратныйРассчет=Истина Тогда
		Если ПроцентПотерь <> 100 Тогда
			КоличествоРезультат = КоличествоИсходное * 100 / (100 - ПроцентПотерь);
			ОкруглитьКоличество(КоличествоРезультат);
		КонецЕсли;
	Иначе
		КоличествоРезультат = КоличествоИсходное * (100 - ПроцентПотерь) / 100;
		ОкруглитьКоличество(КоличествоРезультат);
	КонецЕсли;
	
КонецПроцедуры

// Определяет процент потерь холодной или горячей обработки по количествам.
//
// Параметры:
//  КоличествоИсх - Произвольный - Количество исх.
//  КоличествоОбработанное - Произвольный - Количество обработанное.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьПроцентПотерьОбработки(КоличествоИсх, КоличествоОбработанное)
	Если КоличествоИсх = 0 Тогда
		Возврат 0;
	Иначе
		Возврат Окр((КоличествоИсх - КоличествоОбработанное) * 100 / КоличествоИсх, 2);
	КонецЕсли;
КонецФункции

//  Процедура - Посчитать количества вединицах хранения.
//
&НаКлиенте
Процедура ПосчитатьКоличестваВединицахХранения()
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ДанныеОбУпаковке = ДанныеОбУпаковке(Номенклатура, Упаковка, КэшированныеЗначения);
	
	СписокСвойствТекущейСтроки = "Номенклатура, Упаковка, КоличествоБрутто, КоличествоУпаковокБрутто, КоличествоНетто, КоличествоУпаковокНетто, КоличествоВыход, КоличествоУпаковокВыход";
	СтруктураТекущейСтроки = Новый Структура(СписокСвойствТекущейСтроки);
	ЗаполнитьЗначенияСвойств(СтруктураТекущейСтроки, ЭтаФорма);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", Новый Структура("Суффикс, НужноОкруглять", "Брутто", Ложь));
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтруктураТекущейСтроки, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Нетто";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтруктураТекущейСтроки, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Выход";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтруктураТекущейСтроки, СтруктураДействий, КэшированныеЗначения);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураТекущейСтроки, СписокСвойствТекущейСтроки);
	
	// Округление базовых количеств до 3 знаков.
	СтароеКоличество = Новый Структура("КоличествоБрутто, КоличествоНетто, КоличествоВыход");
	ЗаполнитьЗначенияСвойств(СтароеКоличество, ЭтаФорма);
	
	ОкруглитьКоличество(ЭтаФорма.КоличествоБрутто);
	ОкруглитьКоличество(ЭтаФорма.КоличествоНетто);
	ОкруглитьКоличество(ЭтаФорма.КоличествоВыход);
	
	Для каждого КлючИЗначение Из СтароеКоличество Цикл
		Если КлючИЗначение.Значение <> ЭтаФорма[КлючИЗначение.Ключ] Тогда
			СуффиксКоличества = СтрЗаменить(КлючИЗначение.Ключ, "Количество", "");
			ИмяКолонкиУпаковок = СтрШаблон("КоличествоУпаковок%1", СуффиксКоличества);
			ЭтаФорма[ИмяКолонкиУпаковок] = 
				ЭтаФорма[КлючИЗначение.Ключ] / ?(ДанныеОбУпаковке.Коэффициент = 0, 1, ДанныеОбУпаковке.Коэффициент);
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				СтрШаблон("Недостаточно точности базовой единицы измерения, количество %1 округлено до %2 %3",
					СуффиксКоличества,
					ЭтаФорма[ИмяКолонкиУпаковок],
					ЭтаФорма.Упаковка));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//  Функция - Данные об упаковке.
//
// Параметры:
//  ТекНоменклатура - Произвольный - Тек номенклатура.
//  ТекУпаковка - Произвольный - Тек упаковка.
//  ТекКэшированныеЗначения - Произвольный - Тек кэшированные значения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ДанныеОбУпаковке(ТекНоменклатура, ТекУпаковка, ТекКэшированныеЗначения)
	Возврат ПакетнаяОбработкаТабличнойЧастиСервер.ДанныеОбУпаковке(ТекНоменклатура, ТекУпаковка, ТекКэшированныеЗначения);
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Номенклатура при изменении фрагмент.
//
&НаКлиенте
Процедура НоменклатураПриИзмененииФрагмент()
	
	УстановитьХарактеристикиИспользуются();
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.Характеристика, ХарактеристикиИспользуются);
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.ХарактеристикаЗамены, ХарактеристикиЗаменыИспользуются);
	
	Если НЕ ЭтоТовар Тогда
		Специя = Ложь;
		Замена = Неопределено;
		КоэффициентЗамены = 0;
	КонецЕсли;
	
	НоменклатураПредыдущееЗначение = Номенклатура;
	
	УправлениеФормой(ЭтаФорма);
	
	Модифицированность = Истина;
	
КонецПроцедуры

//  Процедура - Номенклатура при изменении на сервере.
//
// Параметры:
//  ПараметрыСтроки - Произвольный - Параметры строки.
//
&НаСервере
Процедура НоменклатураПриИзмененииНаСервере(ПараметрыСтроки)
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыСтроки.Номенклатура, 
				"питВидНоменклатуры, питРецептурнаяУпаковка, ЕдиницаИзмерения, питПроцентПотерьПриХолоднойОбработке, питПроцентПотерьПриГорячейОбработке");
	
	Если ЗначениеЗаполнено(РеквизитыНоменклатуры.питРецептурнаяУпаковка) Тогда
		ПараметрыСтроки.Упаковка = РеквизитыНоменклатуры.питРецептурнаяУпаковка;
	Иначе  // Если нет рецептурной, тогда установим основную единицу
		ПараметрыСтроки.Упаковка = РеквизитыНоменклатуры.ЕдиницаИзмерения;
	КонецЕсли;
	
	ПараметрыСтроки.ЭтоБлюдо = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо);
	ПараметрыСтроки.ЭтоТовар = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар);
	ПараметрыСтроки.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(РеквизитыНоменклатуры.питВидНоменклатуры, ПараметрыСтроки.Специя);
	
	Если ПараметрыСтроки.ЭтоБлюдо Тогда
		ДатаРецептуры = ?(ЗначениеЗаполнено(ПараметрыСтроки.ДокументСсылка), ПараметрыСтроки.ДокументДата, КонецДня(ПараметрыСтроки.ДокументДата));
		Если НЕ ЗначениеЗаполнено(ПараметрыСтроки.ДокументХозяйственнаяОперация) Тогда
			ПараметрыСтроки.ДокументХозяйственнаяОперация = Перечисления.питХозяйственныеОперации.РецептураПриготовление;
		КонецЕсли;
		НайдПодразделения = питПроизводство.НайтиПодразделенияПоРазрешенным(ПолучитьИзВременногоХранилища(АдресТекПодразделения));
		ПараметрыСтроки.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(ПараметрыСтроки.Номенклатура, ПараметрыСтроки.Характеристика,  ПараметрыСтроки.ДокументХозяйственнаяОперация,
				ДатаРецептуры, ПараметрыСтроки.СпособРасчетаРецептурыПоАктуальной, , ПараметрыСтроки.ДокументОрганизация,,,НайдПодразделения);
	Иначе
		ПараметрыСтроки.Рецептура = Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыНоменклатуры.питПроцентПотерьПриХолоднойОбработке) И ЗначениеЗаполнено(РеквизитыНоменклатуры.питПроцентПотерьПриГорячейОбработке) Тогда
		ЕстьПроцентыПотерь = (РеквизитыНоменклатуры.питПроцентПотерьПриХолоднойОбработке) ИЛИ (РеквизитыНоменклатуры.питПроцентПотерьПриГорячейОбработке);
	Иначе
		ЕстьПроцентыПотерь = Ложь;
	КонецЕсли;
	Если ЕстьПроцентыПотерь Тогда
		// Необходимо задать вопрос пользователю, это сделаем после возврата в клиент.
		ПараметрыСтроки.Вставить("ЕстьПроцентыПотерь", ЕстьПроцентыПотерь);
		ПараметрыСтроки.Вставить("ПроцентПотерьПриХолоднойОбработке", РеквизитыНоменклатуры.питПроцентПотерьПриХолоднойОбработке);
		ПараметрыСтроки.Вставить("ПроцентПотерьПриГорячейОбработке",  РеквизитыНоменклатуры.питПроцентПотерьПриГорячейОбработке);
	КонецЕсли;
	
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Номенклатура, Элементы.Упаковка);
	
КонецПроцедуры

// +ПараметризацияРецептур
//
&НаКлиенте
Процедура ПересчитатьКоличествоПриИзмененииРасчетПоФормуле()
	
	Если СуффиксКолонкиКоличествДляФормул = "Брутто" Тогда
		ОпределитьКоличество(КоличествоУпаковокНетто, КоличествоУпаковокБрутто, ПроцентПотерьПриХолоднойОбработке, Ложь, Ложь);
		ОпределитьКоличество(КоличествоУпаковокВыход, КоличествоУпаковокНетто, ПроцентПотерьПриГорячейОбработке, Ложь, Истина);
	ИначеЕсли СуффиксКолонкиКоличествДляФормул = "Нетто" Тогда
		ОпределитьКоличество(КоличествоУпаковокБрутто, КоличествоУпаковокНетто, ПроцентПотерьПриХолоднойОбработке, Истина, Ложь);
		ОпределитьКоличество(КоличествоУпаковокВыход, КоличествоУпаковокНетто, ПроцентПотерьПриГорячейОбработке, Ложь, Истина);
	Иначе
		ОпределитьКоличество(КоличествоУпаковокНетто, КоличествоУпаковокВыход, ПроцентПотерьПриГорячейОбработке, Истина, Истина);
		ОпределитьКоличество(КоличествоУпаковокБрутто, КоличествоУпаковокНетто, ПроцентПотерьПриХолоднойОбработке, Истина, Ложь);
	КонецЕсли;
	
	ПосчитатьКоличестваВединицахХранения();
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ВидыОбработки

// Процедура начального заполнения данных формы (сервер).
//
&НаСервере
Процедура ВидыОбработкиЗаполнитьДанныеСервер()
	
	// Очистка данных
	ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы().Очистить();
	ТаблицаХЭХ.Очистить();
	
	// Создание ветки холодной обработки
	ВеткаХолоднаяОбработка = ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы().Добавить();
	ВеткаХолоднаяОбработка.Группировка = Перечисления.питТипыОбработкиСырья.Холодная;
	ВеткаХолоднаяОбработка.ТипОбработки = Перечисления.питТипыОбработкиСырья.Холодная;
	ВеткаХолоднаяОбработка.ЭтоГруппировка = Истина;
	ТипОбработкиХолодная = ВеткаХолоднаяОбработка.ПолучитьИдентификатор();
	
	// Создание ветки горячей обработки
	ВеткаГорячаяОбработка = ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы().Добавить();
	ВеткаГорячаяОбработка.Группировка = Перечисления.питТипыОбработкиСырья.Горячая;
	ВеткаГорячаяОбработка.ТипОбработки = Перечисления.питТипыОбработкиСырья.Горячая;
	ВеткаГорячаяОбработка.ЭтоГруппировка = Истина;
	ТипОбработкиГорячая = ВеткаГорячаяОбработка.ПолучитьИдентификатор();
	
КонецПроцедуры

// Процедура заполнения детальных таблиц по ингредиенту (на сервере).
//
// Параметры:
//  Ингредиент - Произвольный - Ингредиент.
//
&НаСервере
Процедура ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент)
	
	Обработки.питПотериПриОбработкеСырья.ЗаполнитьДетальныеТаблицыПоИнгредиенту(Ингредиент, 
		ДеревоИнгредиентыВидыОбработки, ТаблицаХЭХ, ТипОбработкиХолодная, ТипОбработкиГорячая);
	
КонецПроцедуры

// Процедура с действиями обновления детальных таблиц на клиенте.
//
&НаКлиенте
Процедура ОбновитьТаблицыРежимИнгредиентов()
	
	Элементы.ДеревоИнгредиентыВидыОбработки.Развернуть(ТипОбработкиХолодная);
	Элементы.ДеревоИнгредиентыВидыОбработки.Развернуть(ТипОбработкиГорячая);
	
КонецПроцедуры

// Процедура обновления отбора строк в таблице формы "ТаблицаХЭХИнгредиенты".
//
&НаКлиенте
Процедура ОбновитьОтборСтрокТаблицыХЭХИнгредиенты()
	
	ТекДанные = Элементы.ДеревоИнгредиентыВидыОбработки.ТекущиеДанные;
	Если ТекДанные = Неопределено ИЛИ ТипЗнч(ТекДанные.Группировка) = Тип("ПеречислениеСсылка.питТипыОбработкиСырья") Тогда
		Элементы.ТаблицаХЭХИнгредиенты.ОтборСтрок = Новый ФиксированнаяСтруктура("Ингредиент,ВидОбработки", "ххх", "ххх"); // Скрыть все
	Иначе
		Элементы.ТаблицаХЭХИнгредиенты.ОтборСтрок = Новый ФиксированнаяСтруктура("Ингредиент,ВидОбработки", ТекДанные.Ингредиент, ТекДанные.Группировка);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обновить общие проценты потерь.
//
&НаКлиенте
Процедура ОбновитьОбщиеПроцентыПотерь()
	
	ТекПроцент = 100;
	ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиГорячая);
	Если НЕ ТекВетка = Неопределено Тогда
		Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
			ТекПроцент = ТекПроцент * ((100 - ТекЭлементВетки.ПроцентПотерь) / 100);
		КонецЦикла;
		ПроцентПотерьПриГорячейОбработке = 100 - ТекПроцент;
		ТекВетка.ПроцентПотерь = ПроцентПотерьПриГорячейОбработке;
	КонецЕсли;
	
	ТекПроцент = 100;
	ТекВетка = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиХолодная);
	Если НЕ ТекВетка = Неопределено Тогда
		Для каждого ТекЭлементВетки Из ТекВетка.ПолучитьЭлементы() Цикл
			ТекПроцент = ТекПроцент * ((100 - ТекЭлементВетки.ПроцентПотерь) / 100);
		КонецЦикла;
		ПроцентПотерьПриХолоднойОбработке = 100 - ТекПроцент;
		ТекВетка.ПроцентПотерь = ПроцентПотерьПриХолоднойОбработке;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заполнить список хэх по умолчанию.
//
&НаСервере
Процедура ЗаполнитьСписокХЭХПоУмолчанию()
	
	ГруппаХЭХ = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питГруппаХЭХПоУмолчанию");
	Если ЗначениеЗаполнено(ГруппаХЭХ) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	питХимикоэнергетическиеХарактеристики.Ссылка
		|ИЗ
		|	Справочник.питХимикоэнергетическиеХарактеристики КАК питХимикоэнергетическиеХарактеристики
		|ГДЕ
		|	питХимикоэнергетическиеХарактеристики.ГруппаХЭХ = &ГруппаХЭХ";
		Запрос.УстановитьПараметр("ГруппаХЭХ", ГруппаХЭХ);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			СписокХЭХПоУмолчанию.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Изменить ингредиент в детальных таблицах.
//
// Параметры:
//  Ингредиент - Произвольный - Ингредиент.
//
&НаКлиенте
Процедура ИзменитьИнгредиентВДетальныхТаблицах(Ингредиент)
	
	Для каждого ТекВетка Из ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы() Цикл
		Для каждого ТекЭлемент Из ТекВетка.ПолучитьЭлементы() Цикл
			ТекЭлемент.Ингредиент = Ингредиент;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого ТекСтрока Из ТаблицаХЭХ Цикл
		ТекСтрока.Ингредиент = Ингредиент;
	КонецЦикла;
	
	ОбновитьОтборСтрокТаблицыХЭХИнгредиенты();
	
КонецПроцедуры

//  Функция - Поместить таблицу по адресу.
//
// Параметры:
//  Таблица - ТаблицаЗначений - Таблица.
//  Адрес - Произвольный - Адрес.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
&НаСервере
Функция ПоместитьТаблицуПоАдресу(Таблица, Адрес = Неопределено)
	Возврат ПоместитьВоВременноеХранилище(Таблица,?(Адрес = Неопределено,Новый УникальныйИдентификатор,Адрес));
КонецФункции

//  Процедура - Выгрузить данные по видам обработки во временное хранилище.
//
&НаСервере
Процедура ВыгрузитьДанныеПоВидамОбработкиВоВременноеХранилище()
	
	// Удаление старых данных по идентификатору
	СтрокиДляУдаления = Новый Массив;
	ВидыОбработкиСырья	= ПолучитьИзВременногоХранилища(АдресВидыОбработки);
	Для каждого ТекВидОбработки Из ВидыОбработкиСырья Цикл
		Если ТекВидОбработки.ИдентификаторСтроки = ИдентификаторСтроки Тогда
			СтрокиДляУдаления.Добавить(ТекВидОбработки);
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекСтрокаУдалить Из СтрокиДляУдаления Цикл
		ВидыОбработкиСырья.Удалить(ТекСтрокаУдалить);
	КонецЦикла;
	СтрокиДляУдаления.Очистить();
	
	// Удаление старых данных по идентификатору
	ПотериХЭХ			= ПолучитьИзВременногоХранилища(АдресПотериХЭХ);
	Для каждого ТекХЭХ Из ПотериХЭХ Цикл
		Если ТекХЭХ.ИдентификаторСтроки = ИдентификаторСтроки Тогда
			СтрокиДляУдаления.Добавить(ТекХЭХ);
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекСтрокаУдалить Из СтрокиДляУдаления Цикл
		ПотериХЭХ.Удалить(ТекСтрокаУдалить);
	КонецЦикла;
	СтрокиДляУдаления.Очистить();
	
	Для каждого ТекВетка Из ДеревоИнгредиентыВидыОбработки.ПолучитьЭлементы() Цикл
		Для каждого ТекЭлементДерева Из ТекВетка.ПолучитьЭлементы() Цикл
			НовВидОбработки = ВидыОбработкиСырья.Добавить();
			НовВидОбработки.ВидОбработкиСырья	= ТекЭлементДерева.Группировка;
			НовВидОбработки.ПроцентПотерь		= ТекЭлементДерева.ПроцентПотерь;
			НовВидОбработки.ИдентификаторСтроки	= ИдентификаторСтроки;
		КонецЦикла;
	КонецЦикла;
	
	Для каждого ТекХЭХ Из ТаблицаХЭХ Цикл
		НовСтрокаХЭХ = ПотериХЭХ.Добавить();
		НовСтрокаХЭХ.ВидОбработкиСырья					= ТекХЭХ.ВидОбработки;
		НовСтрокаХЭХ.ХимикоэнергетическаяХарактеристика	= ТекХЭХ.ХимикоэнергетическаяХарактеристика;
		НовСтрокаХЭХ.ПроцентПотерь						= ТекХЭХ.ПроцентПотерь;
		НовСтрокаХЭХ.ИдентификаторСтроки				= ИдентификаторСтроки;
	КонецЦикла;
	
	АдресПотериХЭХ		= ПоместитьТаблицуПоАдресу(ПотериХЭХ, АдресПотериХЭХ);
	АдресВидыОбработки	= ПоместитьТаблицуПоАдресу(ВидыОбработкиСырья, АдресВидыОбработки);
	
КонецПроцедуры

//  Процедура - Загрузить данные по видам обработки из временного хранилища.
//
&НаСервере
Процедура ЗагрузитьДанныеПоВидамОбработкиИзВременногоХранилища()
	
	// Найдем ветки дерева.
	ТекВеткаГорячая = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиГорячая);
	Если ТекВеткаГорячая = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекВеткаХолодная = ДеревоИнгредиентыВидыОбработки.НайтиПоИдентификатору(ТипОбработкиХолодная);
	Если ТекВеткаХолодная = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидыОбработкиСырья	= ПолучитьИзВременногоХранилища(АдресВидыОбработки);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептураВидыОбработки.ВидОбработкиСырья,
	|	питРецептураВидыОбработки.ПроцентПотерь,
	|	питРецептураВидыОбработки.ИдентификаторСтроки
	|ПОМЕСТИТЬ втВидыОбработки
	|ИЗ
	|	&ВидыОбработкиСырья КАК питРецептураВидыОбработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втВидыОбработки.ВидОбработкиСырья,
	|	СУММА(втВидыОбработки.ПроцентПотерь) КАК ПроцентПотерь,
	|	втВидыОбработки.ИдентификаторСтроки,
	|	питВидыОбработкиСырья.ТипОбработкиСырья
	|ИЗ
	|	втВидыОбработки КАК втВидыОбработки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питВидыОбработкиСырья КАК питВидыОбработкиСырья
	|		ПО втВидыОбработки.ВидОбработкиСырья = питВидыОбработкиСырья.Ссылка
	|ГДЕ
	|	втВидыОбработки.ИдентификаторСтроки = &ИдентификаторСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	втВидыОбработки.ВидОбработкиСырья,
	|	втВидыОбработки.ИдентификаторСтроки,
	|	питВидыОбработкиСырья.ТипОбработкиСырья";
	
	Запрос.УстановитьПараметр("ВидыОбработкиСырья", ВидыОбработкиСырья);
	Запрос.УстановитьПараметр("ИдентификаторСтроки", ИдентификаторСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ТипОбработкиСырья = Перечисления.питТипыОбработкиСырья.Горячая Тогда
				НовСтрокаДерева = ТекВеткаГорячая.ПолучитьЭлементы().Добавить();
			Иначе
				НовСтрокаДерева = ТекВеткаХолодная.ПолучитьЭлементы().Добавить();
			КонецЕсли;
			НовСтрокаДерева.Группировка		= ВыборкаДетальныеЗаписи.ВидОбработкиСырья;
			НовСтрокаДерева.Ингредиент		= Номенклатура;
			НовСтрокаДерева.ПроцентПотерь	= ВыборкаДетальныеЗаписи.ПроцентПотерь;
			НовСтрокаДерева.ТипОбработки	= ВыборкаДетальныеЗаписи.ТипОбработкиСырья;
			НовСтрокаДерева.ЭтоГруппировка	= Ложь;
		КонецЦикла;
	КонецЕсли;
	
	ПотериХЭХ			= ПолучитьИзВременногоХранилища(АдресПотериХЭХ);
	НайденныеСтрокиПотериХЭХ = ПотериХЭХ.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
	Для каждого ТекСтрокаПотериХЭХ Из НайденныеСтрокиПотериХЭХ Цикл
		НовХЭХ = ТаблицаХЭХ.Добавить();
		НовХЭХ.ВидОбработки							= ТекСтрокаПотериХЭХ.ВидОбработкиСырья;
		НовХЭХ.Ингредиент							= Номенклатура;
		НовХЭХ.ХимикоэнергетическаяХарактеристика	= ТекСтрокаПотериХЭХ.ХимикоэнергетическаяХарактеристика;
		НовХЭХ.ПроцентПотерь						= ТекСтрокаПотериХЭХ.ПроцентПотерь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Характеристики

//  Процедура - Установить характеристики используются.
//
&НаСервере
Процедура УстановитьХарактеристикиИспользуются()
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ХарактеристикиИспользуются = питОбщегоНазначения.ХарактеристикиИспользуются(Номенклатура);
	Иначе
		ХарактеристикиИспользуются = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Замена) Тогда
		ХарактеристикиЗаменыИспользуются = питОбщегоНазначения.ХарактеристикиИспользуются(Замена);
	Иначе
		ХарактеристикиЗаменыИспользуются = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

//  Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.Рецептура.ТолькоПросмотр      = (Форма.СпособРасчетаРецептурыПоАктуальной ИЛИ НЕ Форма.ЭтоБлюдо);
	Элементы.Замена.Доступность            = (НЕ Форма.ЗапретитьЗамены И Форма.ЭтоТовар И НЕ Форма.Специя);
	Элементы.КоэффициентЗамены.Доступность = Элементы.Замена.Доступность;
	Элементы.ЗапретитьЗамены.Доступность   = Форма.ЭтоТовар;
	
	ФорматКоличества = ?(Форма.Специя, "ЧЦ=15; ЧДЦ=6", "ЧЦ=15; ЧДЦ=3");
	Элементы.КоличествоУпаковокБрутто.ФорматРедактирования      = ФорматКоличества;
	Элементы.КоличествоУпаковокНетто.ФорматРедактирования = ФорматКоличества;
	Элементы.КоличествоУпаковокВыход.ФорматРедактирования = ФорматКоличества;
	
	// +ПараметризацияРецептур
	Элементы.КоличествоУпаковокБрутто.Доступность		= НЕ Форма.РасчетПоФормуле;
	Элементы.КоличествоУпаковокНетто.Доступность		= НЕ Форма.РасчетПоФормуле;
	Элементы.КоличествоУпаковокВыход.Доступность		= НЕ Форма.РасчетПоФормуле;
	Элементы.КнопкаПересчетБруттоОтНетто.Доступность	= НЕ Форма.РасчетПоФормуле;
	Элементы.КнопкаПересчетНеттоОтБрутто.Доступность	= НЕ Форма.РасчетПоФормуле;
	Элементы.КнопкаПересчетНеттоОтВыход.Доступность		= НЕ Форма.РасчетПоФормуле;
	Элементы.КнопкаПересчетВыходОтНетто.Доступность		= НЕ Форма.РасчетПоФормуле;
	Элементы.ДекорацияРасчетПоФормуле.Видимость			= Форма.РасчетПоФормуле;
	Элементы.ДекорацияРасчетПоФормуле.Заголовок			= "Количество "+НРег(Форма.СуффиксКолонкиКоличествДляФормул)+" рассчитывается по формуле, остальные количества считаются исходя из процентов потерь.";
	// -ПараметризацияРецептур
	
	Элементы.ПроцентПотерьПриХолоднойОбработке.Доступность	= НЕ Форма.ПрименятьМеханизмВидовОбработки;
	Элементы.ПроцентПотерьПриГорячейОбработке.Доступность	= НЕ Форма.ПрименятьМеханизмВидовОбработки;
	Если Форма.ПрименятьМеханизмВидовОбработки Тогда
		// Элементы.КоличествоУпаковокНетто.ТолькоПросмотр		= Истина;
		// Элементы.КоличествоУпаковокВыход.ТолькоПросмотр		= Истина;
		Элементы.ПроцентСебестоимости.Видимость				= Ложь;
	Иначе
		// Элементы.КоличествоУпаковокНетто.ТолькоПросмотр		= Ложь;
		// Элементы.КоличествоУпаковокВыход.ТолькоПросмотр		= Ложь;
		Элементы.ПроцентСебестоимости.Видимость				= Истина;
	КонецЕсли;
	
	// +АвтовыборНоменклатуры
	Если ЗначениеЗаполнено(Форма.НоменклатураСтрокой) Тогда
		Элементы.НоменклатураСтрокой.Видимость = Истина;
		Элементы.Номенклатура.Видимость = Ложь;
	Иначе
		Элементы.НоменклатураСтрокой.Видимость = Ложь;
		Элементы.Номенклатура.Видимость = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.ХарактеристикаСтрокой) Тогда
		Элементы.ХарактеристикаСтрокой.Видимость = Истина;
		Элементы.Характеристика.Видимость = Ложь;
	Иначе
		Элементы.ХарактеристикаСтрокой.Видимость = Ложь;
		Элементы.Характеристика.Видимость = Истина;
	КонецЕсли;
	// -АвтовыборНоменклатуры
	
КонецПроцедуры
