// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ БСП

//  Процедура - Свернуть развернуть отборы.
//
// Параметры:
//  РазвернутьОтборы - Произвольный - Развернуть отборы.
//
&НаКлиенте
Процедура СвернутьРазвернутьОтборы(РазвернутьОтборы)
	ЭтаФорма.Элементы.ГруппаРазделитель.Видимость = НЕ РазвернутьОтборы;
	ЭтаФорма.Элементы.ГруппаПравоДанные.Видимость = РазвернутьОтборы;
КонецПроцедуры

//  Процедура - Список при обновлении состава пользовательских настроек на сервере.
//
// Параметры:
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура СписокПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Элементы.Список.СоздатьЭлементыФормыПользовательскихНастроек(Элементы.ГруппаБыстрыеОтборы,,3);
КонецПроцедуры

//  Процедура - Актуальные при изменении на сервере.
//
&НаСервере
Процедура АктуальныеПриИзмененииНаСервере()
	СоздатьОбновитьПрограммныеОтборыДинамическогоСписка();
	ОбновитьДоступностьФиксированныхОтборовДинамическогоСписка();
КонецПроцедуры

//  Процедура - Актуальные по подразделению при изменении на сервере.
//
&НаСервере
Процедура АктуальныеПоПодразделениюПриИзмененииНаСервере()
	СоздатьОбновитьПрограммныеОтборыДинамическогоСписка();
КонецПроцедуры

//  Процедура - Создать обновить программные отборы динамического списка.
//
&НаСервере
Процедура СоздатьОбновитьПрограммныеОтборыДинамическогоСписка()
	
	ОтборАктуальныеПоПодразделению = Неопределено;
	МассивУдалить = Новый Массив;
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если СтрНайти(ЭлементОтбора.Представление, "Отбор") Тогда
			МассивУдалить.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекЭлементУдалить Из МассивУдалить Цикл
		Список.Отбор.Элементы.Удалить(ТекЭлементУдалить);
	КонецЦикла;
	
	// первое условие отбора
	Если Актуальные Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Актуальная");
		ЭлементОтбора.Представление = "ОтборАктуальные";
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Истина;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
	// второе условие отбора
	Если ЗначениеЗаполнено(АктуальныеПоПодразделению) Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("АктуальныеПоПодразделению");
		ЭлементОтбора.Представление = "ОтборАктуальныеПоПодразделению";
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = АктуальныеПоПодразделению;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
	// Номенклатура
	Если ЗначениеЗаполнено(ОтборНоменклатура) Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура");
		ЭлементОтбора.Представление = "ОтборНоменкатура";
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ОтборНоменклатура;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
	// ХозяйственнаяОперация
	Если ЗначениеЗаполнено(ОтборХозОперация) Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ХозяйственнаяОперация");
		ЭлементОтбора.Представление = "ОтборХозяйственнаяОперация";
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ОтборХозОперация;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обновить доступность фиксированных отборов динамического списка.
//
&НаСервере
Процедура ОбновитьДоступностьФиксированныхОтборовДинамическогоСписка()
	
КонецПроцедуры

//  Процедура - Актуальные по подразделению очистка на сервере.
//
&НаСервере
Процедура АктуальныеПоПодразделениюОчисткаНаСервере()
	СоздатьОбновитьПрограммныеОтборыДинамическогоСписка();
КонецПроцедуры

