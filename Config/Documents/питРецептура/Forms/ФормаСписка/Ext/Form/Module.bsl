////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	МожноРедактировать = ПравоДоступа("Редактирование", Метаданные.Документы.питРецептура);
	Элементы.СписокКонтекстноеМенюИзменитьВыделенные.Видимость = МожноРедактировать;
	Элементы.ПодменюСоздать.Видимость = МожноРедактировать;
	
	Если Параметры.Свойство("ИзФормыНоменклатуры") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "ИзФормыНоменклатуры, ТоварыНоменклатура");
	КонецЕсли;
	
	// Установить заголовок формы.
	Если ИзФормыНоменклатуры Тогда
		Если ЗначениеЗаполнено(ТоварыНоменклатура) Тогда
			ЭтаФорма.Заголовок = "Использование в рецептурах ингредиента """ + ТоварыНоменклатура + """.";
		ИначеЕсли Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Номенклатура") Тогда
			ЭтаФорма.Заголовок = "Список рецептур для номенклатуры """ + Параметры.Отбор.Номенклатура + """.";
		Иначе
			ЭтаФорма.Заголовок = "Список рецептур (ошибка, не указана номенклатура)";
		КонецЕсли;
		ЭтаФорма.АвтоЗаголовок = Ложь;
	КонецЕсли;
	
	// Определить список рецептур для ингредиента
	Если ИзФормыНоменклатуры И ЗначениеЗаполнено(ТоварыНоменклатура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ингредиент", ТоварыНоменклатура);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбщепитРецептураТовары.Ссылка КАК Рецептура,
		|	ОбщепитРецептураТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	Документ.питРецептура.Ингредиенты КАК ОбщепитРецептураТовары
		|ГДЕ
		|	ОбщепитРецептураТовары.Номенклатура = &Ингредиент";
		
		МассивРецептур = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Рецептура");
		Параметры.Отбор.Вставить("Ссылка", МассивРецептур);
		
	КонецЕсли;
	
КонецПроцедуры

