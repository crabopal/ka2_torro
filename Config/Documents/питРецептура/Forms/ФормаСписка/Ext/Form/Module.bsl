////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

//  Функция - Получить структуру параметров формы.
//
// Параметры:
//  ХозяйственнаяОперация - Произвольный - Хозяйственная операция.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
//
&НаКлиенте
Функция ПолучитьСтруктуруПараметровФормы(ХозяйственнаяОперация)
	
	СтруктураПараметров = Новый Структура;
	
	ЗначенияЗаполнения = питОбщегоНазначения.ЗначенияЗаполненияДинамическогоСписка(Список.КомпоновщикНастроек);
	Если ЗначениеЗаполнено(ХозяйственнаяОперация) Тогда
		ЗначенияЗаполнения.Вставить("ХозяйственнаяОперация", ХозяйственнаяОперация);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	Возврат СтруктураПараметров;
	
КонецФункции

