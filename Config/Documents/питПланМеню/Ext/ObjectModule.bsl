#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Устанавливает статус для объекта документа
//
// Параметры:
//  НовыйСтатус - Строка - Имя статуса, который будет установлен у заказо.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
// 	Булево - Истина, в случае успешной установки нового статуса.
Функция УстановитьСтатус(НовыйСтатус, ДополнительныеПараметры) Экспорт
	
	// +пит
	ЗначениеНовогоСтатуса = Перечисления.питСтатусыПлановМеню[НовыйСтатус];
	// -пит
	
	// +пит
	// Если ДополнительныеПараметры <> Неопределено Тогда
	//	
	// 	ЗаказыСервер.СкорректироватьСтрокиЗаказа(ЭтотОбъект, ДополнительныеПараметры);
	//	
	// КонецЕсли;
	// -пит
	
	Статус = ЗначениеНовогоСтатуса;
	
	// +пит
	// ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.ЗаказНаПеремещение);
	// НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ЭтотОбъект, ПараметрыУказанияСерий);
	// -пит
	
	Возврат ПроверитьЗаполнение();
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

//  Процедура - Обработка заполнения.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  ТекстЗаполнения - Строка - Текст заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения = "",СтандартнаяОбработка = ИСТИНА)
	
	Ответственный = Пользователи.ТекущийПользователь();
	
	ТипЦен						= питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит");
	
	РежимИспользованияАналогов = Перечисления.питРежимыИспользованияАналогов.Разрешить;
	
	ВидПроизводства = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питРежимПриготовленияПолуфабрикатов");
	
	Если ДанныеЗаполнения = Неопределено Тогда // Заполнение нового документа без основания
		
		ПроцентНаценкиИзНоменклатуры= Истина;
		Автопланирование			= Ложь;
		РазрешитьНедовложения		= Ложь;
		ОкруглятьДо					= 0.01;
		НеИспользоватьСезонныеПроценты = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питНеИспользоватьСезонныеПроценты");
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
		Если ДанныеЗаполнения.Свойство("Товары") Тогда
			ЗаполнитьПоТаблицеТовары(ДанныеЗаполнения.Товары);
		КонецЕсли;
		
		Документы.питПланМеню.ЗаполнитьПоНормативам(ЭтотОбъект);
		
	КонецЕсли;
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

//  Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаСписанияМатериалов) Тогда
		ДатаСписанияМатериалов = ДатаПлан;
	КонецЕсли;
	
	// +питПриоритетыПриготовления
	Если ДополнительныеСвойства.Свойство("питСортироватьПоПриоритетуПриготовления") Тогда
		питПриоритетыПриготовления.СортироватьТабличнуюЧастьОбъектаПоПриоритетуПриготовления(ЭтотОбъект, "Товары", Склад);
	КонецЕсли;
	// -питПриоритетыПриготовления
	
	// +ПерепланированиеПроизводства
	питПерепланирование.ПередЗаписьюВНачале(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	// -ПерепланированиеПроизводства
	
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
//   Попытка заполнить плановую дату, если она не была заполнена. Если дата документа пустая, тогда просто ставим на
// завтра.
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаПлан) Тогда
		ЭтотОбъект.ДатаПлан = ?(ЗначениеЗаполнено(ЭтотОбъект.Дата) И НЕ ЭтотОбъект.Ссылка.Пустая(), ЭтотОбъект.Дата, КонецДня(ТекущаяДата())+1);
	КонецЕсли;
	
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22);
	Если ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен Тогда
		Если ЗначениеЗаполнено(ЭтотОбъект.ЦеховаяКладовая) Тогда
			ДанныеСклада = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ЦеховаяКладовая,"Подразделение, ЦеховаяКладовая");
			Если ДанныеСклада.ЦеховаяКладовая Тогда
				ЭтотОбъект.Подразделение = ДанныеСклада.Подразделение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// +ИзменениеФактаВПроизводстве
	ЕстьИзмененныеБлюда = питИзменениеФактаВПроизводстве.ЕстьИзмененныеБлюдаТовары(ЭтотОбъект.Блюда, Неопределено);
	// -ИзменениеФактаВПроизводстве
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И (Статус = Перечисления.питСтатусыПлановМеню.КОбеспечению
		ИЛИ ДополнительныеСвойства.Свойство("СрезДокументов")) // Если это зависимый док в режиме перепланирования, то независимо от статуса перезаполним производство.
		И НЕ ЕстьИзмененныеБлюда Тогда
		Документы.питПланМеню.ЗаполнитьПоНормативам(ЭтотОбъект);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	ЗаполнитьЕстьСхемаОбеспечения();
	
	// +ПерепланированиеПроизводства
	питПерепланирование.ПередЗаписьюВКонце(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	// -ПерепланированиеПроизводства
	
КонецПроцедуры

//  Процедура - При записи.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// +ПерепланированиеПроизводства
	питПерепланирование.ПриЗаписиВНачале(ЭтотОбъект, Отказ);
	// -ПерепланированиеПроизводства
	
	ПроведениеДокументов.ПриЗаписиДокумента(ЭтотОбъект, Отказ);
	
	// +ПерепланированиеПроизводства
	питПерепланирование.ПриЗаписиВКонце(ЭтотОбъект, Отказ);
	// -ПерепланированиеПроизводства
	
КонецПроцедуры

//  Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22);
	Если ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен Тогда
		// ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Подразделение"));
	Иначе
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ЦеховаяКладовая"));
	КонецЕсли;
	
	Если НЕ ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СкладРеализации"));
	КонецЕсли;
	
	#Область ПроверкаХарактеристик
	
	ПараметрыПроверкиХарактеристик = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "Товары";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "ПобочныеИзделия";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "Блюда";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	МассивНепроверяемыхРеквизитов.Добавить("Замены.ХарактеристикаБлюда");
	МассивНепроверяемыхРеквизитов.Добавить("Замены.ХарактеристикаИнгредиентаИсходного");
	МассивНепроверяемыхРеквизитов.Добавить("Замены.ХарактеристикаИнгредиентаЗамена");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"
		|ВЫБРАТЬ 
		|	ТЧЗамены.НомерСтроки,
		|	ТЧЗамены.Блюдо, 
		|	ТЧЗамены.ИнгредиентИсходный, 
		|	ТЧЗамены.ИнгредиентЗамена,
		|	ТЧЗамены.ХарактеристикаБлюда,
		|	ТЧЗамены.ХарактеристикаИнгредиентаЗамена,
		|	ТЧЗамены.ХарактеристикаИнгредиентаИсходного
		|ПОМЕСТИТЬ ВТЗамены 
		|ИЗ &ТЧЗамены КАК ТЧЗамены;
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА НЕ Блюда.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
		|				И питВыпускБлюдЗамены.ХарактеристикаБлюда = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ХарактеристикаБлюдаЗаполнена,
		|	питВыпускБлюдЗамены.НомерСтроки,
		|	ВЫБОР
		|		КОГДА НЕ ИнгредиентыЗамена.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
		|				И питВыпускБлюдЗамены.ХарактеристикаИнгредиентаЗамена = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ХарактеристикаЗаменыЗаполнена,
		|	ВЫБОР
		|		КОГДА НЕ ИнгредиентыИсходные.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
		|				И питВыпускБлюдЗамены.ХарактеристикаИнгредиентаИсходного = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ХарактеристикаИнгредиентаИсходногоЗаполнена
		|ИЗ
		|	ВТЗамены КАК питВыпускБлюдЗамены
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Блюда
		|		ПО питВыпускБлюдЗамены.Блюдо = Блюда.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ИнгредиентыИсходные
		|		ПО питВыпускБлюдЗамены.ИнгредиентИсходный = ИнгредиентыИсходные.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ИнгредиентыЗамена
		|		ПО питВыпускБлюдЗамены.ИнгредиентЗамена = ИнгредиентыЗамена.Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ТЧЗамены", ЭтотОбъект.Замены.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	КлючДанных = ОбщегоНазначенияУТ.КлючДанныхДляСообщенияПользователю(ЭтотОбъект);
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если НЕ ВыборкаДетальныеЗаписи.ХарактеристикаБлюдаЗаполнена Тогда
			Отказ = Истина;
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Замены", ВыборкаДетальныеЗаписи.НомерСтроки, "ХарактеристикаБлюда");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена характеристика блюда в строке "+ВыборкаДетальныеЗаписи.НомерСтроки+" таблицы ""Замены""!",,,,Отказ);
		КонецЕсли;
		Если НЕ ВыборкаДетальныеЗаписи.ХарактеристикаЗаменыЗаполнена Тогда
			Отказ = Истина;
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Замены", ВыборкаДетальныеЗаписи.НомерСтроки, "ХарактеристикаИнгредиентаЗамена");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена характеристика замены в строке "+ВыборкаДетальныеЗаписи.НомерСтроки+" таблицы ""Замены""!",,,,Отказ);
		КонецЕсли;
		Если НЕ ВыборкаДетальныеЗаписи.ХарактеристикаЗаменыЗаполнена Тогда
			Отказ = Истина;
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Замены", ВыборкаДетальныеЗаписи.НомерСтроки, "ХарактеристикаИнгредиентаИсходного");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена характеристика исходного ингредиента в строке "+ВыборкаДетальныеЗаписи.НомерСтроки+" таблицы ""Замены""!",,,,Отказ);
		КонецЕсли;
	КонецЦикла;
	
	МассивНепроверяемыхРеквизитов.Добавить("Ингредиенты.Характеристика");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	ТЧИнгредиенты.НомерСтроки, 
	|	ТЧИнгредиенты.Ингредиент,
	|	ТЧИнгредиенты.Характеристика
	|ПОМЕСТИТЬ ВТИнгредиенты 
	|ИЗ &ТЧИнгредиенты КАК ТЧИнгредиенты;
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ Ингредиенты.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
	|				И питВыпускБлюдИнгредиенты.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ХарактеристикаЗаполнена,
	|	питВыпускБлюдИнгредиенты.НомерСтроки
	|ИЗ
	|	ВТИнгредиенты КАК питВыпускБлюдИнгредиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ингредиенты
	|		ПО питВыпускБлюдИнгредиенты.Ингредиент = Ингредиенты.Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ТЧИнгредиенты", ЭтотОбъект.Ингредиенты.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	КлючДанных = ОбщегоНазначенияУТ.КлючДанныхДляСообщенияПользователю(ЭтотОбъект);
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если НЕ ВыборкаДетальныеЗаписи.ХарактеристикаЗаполнена Тогда
			Отказ = Истина;
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Ингредиенты", ВыборкаДетальныеЗаписи.НомерСтроки, "Характеристика");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена характеристика ингредиента в строке "+ВыборкаДетальныеЗаписи.НомерСтроки+" таблицы ""Ингредиенты""!",,,,Отказ);
		КонецЕсли;
	КонецЦикла;
	
	#КонецОбласти
	
	Если НЕ Трудозатраты.Количество() Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ИсполнительТрудозатрат");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

//  Процедура - Обработка проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// +%ИзЕРП% Набор типовых процедур для обработки проведения документа.
	
	ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ);
	
	// -%ИзЕРП%
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Процедура - Инициализировать документ.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//
Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Валюта                    = питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета(Валюта);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация               = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЦеховаяКладовая) Тогда
		ЦеховаяКладовая            = ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Склад, Ложь, Истина);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СкладРеализации) Тогда
		СкладРеализации            = ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Склад, Ложь, Истина);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Склад                     = ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Склад, Ложь, Истина);
		Если НЕ ЗначениеЗаполнено(Склад) Тогда
			Склад = ЦеховаяКладовая;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Заполнить по таблице товары.
//
// Параметры:
//  АдресПродукция - Произвольный - Адрес продукция.
//
Процедура ЗаполнитьПоТаблицеТовары(АдресПродукция)
	
	Если ЭтоАдресВременногоХранилища(АдресПродукция) Тогда
		ТаблицаТоваров = ПолучитьИзВременногоХранилища(АдресПродукция);
		УдалитьИзВременногоХранилища(АдресПродукция);
	Иначе
		ТаблицаТоваров = АдресПродукция; //для заполнения была передана таблица значений.
	КонецЕсли;
	
	Товары.Очистить();
	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ГруппируемыеПоля = "Номенклатура,Характеристика"
		+ ?(ТаблицаТоваров.Колонки.Найти("Назначение") <> Неопределено,",Назначение","")
		+ ?(ТаблицаТоваров.Колонки.Найти("Упаковка") <> Неопределено,",Упаковка","");
	
	СвернутаяТаблицаТоваров = ТаблицаТоваров.Скопировать(,ГруппируемыеПоля+",Количество, КоличествоУпаковок");
	СвернутаяТаблицаТоваров.Свернуть(ГруппируемыеПоля,"Количество, КоличествоУпаковок");
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого СтрокаТовара из СвернутаяТаблицаТоваров Цикл
		
		СтрокаПродукция = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПродукция, СтрокаТовара);
		
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаПродукция, СтруктураДействий, КэшированныеЗначения);
		
		СтрокаПродукция.Рецептура = питПроизводство.ВернутьОсновнуюРецептуру(СтрокаПродукция.Номенклатура,СтрокаПродукция.Характеристика, Перечисления.питХозяйственныеОперации.РецептураПриготовление,
			ДатаПлан, , , Организация,,,Подразделение);
		
	КонецЦикла;
	
	// Заполнение Цен
	ИспользоватьПлановуюСтоимость = Ложь;
	питДокументы.УстановитьИспользованиеПлановойСтоимости(ИспользоватьПлановуюСтоимость, ЭтотОбъект);
	Если ИспользоватьПлановуюСтоимость Тогда
		Валюта = Константы.ВалютаПлановойСебестоимостиПродукции.Получить();
	Иначе
		Валюта = Константы.ВалютаУправленческогоУчета.Получить();
	КонецЕсли;
	ЦеныРассчитаны = ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(
	Товары,
	, // Массив строк или структура отбора
	Новый Структура( // Параметры заполнения
	"Дата, Валюта, ВидЦены",
	Дата,
	Валюта,
	ТипЦен),
	Новый Структура( // Структура действий с измененными строками
	"ПересчитатьСумму",
	"КоличествоУпаковок"));
	
	// +питПриоритетыПриготовления
	питПриоритетыПриготовления.СортироватьТабличнуюЧастьОбъектаПоПриоритетуПриготовления(ЭтотОбъект, "Товары", Склад);
	// -питПриоритетыПриготовления
	
	СуммаДокумента = Товары.Итог("Сумма");
	
КонецПроцедуры

//  Процедура - Заполнить есть схема обеспечения.
//
Процедура ЗаполнитьЕстьСхемаОбеспечения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	тчИнгредиенты.Ингредиент КАК Ингредиент,
	|	тчИнгредиенты.Характеристика КАК Характеристика,
	|	тчИнгредиенты.ИзАвтопеределов КАК ИзАвтопеределов,
	|	ЛОЖЬ КАК ЭтоЗамена
	|ПОМЕСТИТЬ втИнгредиенты
	|ИЗ
	|	&тчИнгредиенты КАК тчИнгредиенты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тчЗамены.ИнгредиентЗамена КАК Ингредиент,
	|	тчЗамены.ХарактеристикаИнгредиентаЗамена КАК Характеристика,
	|	ЛОЖЬ КАК ИзАвтопеределов,
	|	ИСТИНА КАК ЭтоЗамена
	|ПОМЕСТИТЬ втЗамены
	|ИЗ
	|	&тчЗамены КАК тчЗамены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втИнгредиенты.Ингредиент КАК Ингредиент,
	|	втИнгредиенты.Характеристика КАК Характеристика,
	|	втИнгредиенты.ИзАвтопеределов КАК ИзАвтопеределов,
	|	втИнгредиенты.ЭтоЗамена КАК ЭтоЗамена
	|ПОМЕСТИТЬ втПланМенюИнгредиенты
	|ИЗ
	|	втИнгредиенты КАК втИнгредиенты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втЗамены.Ингредиент КАК Ингредиент,
	|	втЗамены.Характеристика КАК Характеристика,
	|	втЗамены.ИзАвтопеределов КАК ИзАвтопеределов,
	|	втЗамены.ЭтоЗамена КАК ЭтоЗамена
	|ИЗ
	|	втЗамены КАК втЗамены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питПланМенюИнгредиенты.Ингредиент КАК Номенклатура,
	|	питПланМенюИнгредиенты.Характеристика КАК Характеристика,
	|	питПланМенюИнгредиенты.ЭтоЗамена КАК ЭтоЗамена,
	|	&ЦеховаяКладовая КАК Склад
	|ПОМЕСТИТЬ питВтТовары
	|ИЗ
	|	втПланМенюИнгредиенты КАК питПланМенюИнгредиенты
	|ГДЕ
	|	питПланМенюИнгредиенты.ИзАвтопеределов = ЛОЖЬ
	|СГРУППИРОВАТЬ ПО
	|	питПланМенюИнгредиенты.Ингредиент,
	|	питПланМенюИнгредиенты.Характеристика,
	|	питПланМенюИнгредиенты.ЭтоЗамена
	|;
	|
	| "+СтрЗаменить(РегистрыСведений.СхемыОбеспечения.ВременнаяТаблицаСпособыОбеспечения("ВЫЧИСЛЯТЬ"), "ВтТовары", "питВтТовары") + "
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питВтТовары.Номенклатура КАК Номенклатура,
	|	питВтТовары.Характеристика КАК Характеристика,
	|	питВтТовары.ЭтоЗамена КАК ЭтоЗамена,
	|	ISNULL(ВтСпособыОбеспечения.СпособОбеспеченияПотребностей, ЗНАЧЕНИЕ(Справочник.СпособыОбеспеченияПотребностей.ПустаяСсылка)) КАК СпособОбеспеченияПотребностей
	|ИЗ
	|	питВтТовары КАК питВтТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтСпособыОбеспечения КАК ВтСпособыОбеспечения
	|			ПО питВтТовары.Номенклатура = ВтСпособыОбеспечения.Номенклатура
	|				И питВтТовары.Характеристика = ВтСпособыОбеспечения.Характеристика
	|";
	Запрос.УстановитьПараметр("тчИнгредиенты", Ингредиенты.Выгрузить());
	Запрос.УстановитьПараметр("тчЗамены", Замены.Выгрузить());
	Запрос.УстановитьПараметр("ЦеховаяКладовая",ЦеховаяКладовая);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		СП_Ингредиенты = Новый Структура("Ингредиент, Характеристика");
		СП_Замены = Новый Структура("ИнгредиентЗамена, ХарактеристикаИнгредиентаЗамена");
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			// Поиск строк в табличной части документа.
			Если НЕ Выборка.ЭтоЗамена Тогда
				СП_Ингредиенты.Ингредиент = Выборка.Номенклатура;
				СП_Ингредиенты.Характеристика = Выборка.Характеристика;
				НайденныеСтроки = Ингредиенты.НайтиСтроки(СП_Ингредиенты);
			Иначе
				СП_Замены.ИнгредиентЗамена = Выборка.Номенклатура;
				СП_Замены.ХарактеристикаИнгредиентаЗамена = Выборка.Характеристика;
				НайденныеСтроки = Замены.НайтиСтроки(СП_Замены);
			КонецЕсли;
			
			// Установка флага "Есть схема обеспечения".
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.ЕстьСхемаОбеспечения = ЗначениеЗаполнено(Выборка.СпособОбеспеченияПотребностей);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

