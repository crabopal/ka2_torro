	|	И ЗначениеРазрешено(ЦеховаяКладовая)
	|	И ЗначениеРазрешено(Подразделение)";
	
КонецПроцедуры


#Область ОбновлениеИнформационнойБазы

// см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
//
// Параметры:
//  Обработчики - Произвольный - Обработчики.
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "Документы.питПланМеню.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.5.5";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("91006344-260f-4d70-9f22-2598758255dc");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "Документы.питПланМеню.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.Комментарий = НСтр("ru = 'Заполняет реквизит СтавкаНДС с типом СправочникСсылка.СтавкиНДС.';
	|en = 'Fills in СтавкаНДС attribute with СправочникСсылка.СтавкиНДС type.'");
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.Документы.питПланМеню.ПолноеИмя());
	Читаемые.Добавить(Метаданные.Справочники.СтавкиНДС.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.Документы.питПланМеню.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Блокируемые.Добавить(Метаданные.Документы.питПланМеню.ПолноеИмя());
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");
	
	Обработчик.ПриоритетыВыполнения = ОбновлениеИнформационнойБазы.ПриоритетыВыполненияОбработчика();
	
	НоваяСтрока = Обработчик.ПриоритетыВыполнения.Добавить();
	НоваяСтрока.Процедура = "Справочники.СтавкиНДС.ЗаполнитьЭлементыНачальнымиДанными";
	НоваяСтрока.Порядок = "Любой";
	
КонецПроцедуры

// Зарегистрировать данные к обработке для перехода.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = "Документ.питПланМеню";
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Ссылка.Дата УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Ссылка");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	питПланМеню.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питПланМеню КАК питПланМеню
	|ГДЕ
	|	(ИСТИНА В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			Документ.питПланМеню.Товары КАК питПланМенюТовары
	|		ГДЕ
	|			питПланМеню.Ссылка = питПланМенюТовары.Ссылка
	//|			И (питПланМенюТовары.УдалитьСтавкаНДС <> &ПустаяСтавкаНДС
	|			И питПланМенюТовары.СтавкаНДС = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка))
	|	)";
	
	//УчетНДСЛокализация.УстановитьПараметрЗапросаПустаяСтавкаНДСПеречислением(Запрос);
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

// Процедура - Обработать данные для перехода на новую версию.
//
// Параметры:
//  Параметры - Произвольный - Параметры.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяОбъекта = ПустаяСсылка().Метаданные().ПолноеИмя();
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Для Каждого Документ Из ОбновляемыеДанные Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Документ.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			ДокументОбъект = Документ.Ссылка.ПолучитьОбъект(); // ДокументОбъект
			
			ОбъектИзменен = Ложь;
			Если ДокументОбъект <> Неопределено Тогда
				
				МассивТЧ = Новый Массив();
				МассивТЧ.Добавить("Товары");
				
				//УчетНДСЛокализация.ЗаполнитьКолонкуТЧСтавкаНДС(ДокументОбъект, МассивТЧ, ОбъектИзменен);
				
			КонецЕсли;
			
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Документ.Ссылка);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), Документ.Ссылка);
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

// %ИзЕРП%
//
// Параметры:
//  ИмяРегистра - Произвольный - Имя регистра.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДополнительныеИсточникиДанныхДляДвижений(ИмяРегистра) Экспорт

	ИсточникиДанных = Новый Соответствие;

	Возврат ИсточникиДанных; 

КонецФункции


#КонецОбласти


// /////////////////////////////////////////
//  / Модуль менеджера документа "План меню"
//
// Параметры:
//  Объект - Произвольный - Объект.
//
Процедура ЗаполнитьПоНормативам(Объект) Экспорт
	
	ВосприниматьБлюдоБезРецептурыКакТовар = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питВосприниматьБлюдоБезРецептурыКакТовар");
	
	// Проверка незаполненных рецептур выходных изделий
	Если НЕ ВосприниматьБлюдоБезРецептурыКакТовар Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ * ПОМЕСТИТЬ втТовары ИЗ &Товары КАК Товары;
		|ВЫБРАТЬ
		|	питПланМенюТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	втТовары КАК питПланМенюТовары
		|ГДЕ
		|	НЕ питПланМенюТовары.ПриготовлениеЗапрещено
		|	И питПланМенюТовары.Номенклатура.питВидНоменклатуры = &Блюдо
		|	И питПланМенюТовары.Рецептура = ЗНАЧЕНИЕ(Документ.питРецептура.ПустаяСсылка)";
		Запрос.УстановитьПараметр("Товары", Объект.Товары.Выгрузить());
		Запрос.УстановитьПараметр("Блюдо", Перечисления.питВидыНоменклатуры.Блюдо);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось заполнить производства! Есть незаполненные рецептуры в таблице выходных изделий!");
			Документы.питПланМеню.ОчиститьПроизводствоСервер(Объект);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.питПланМеню") Тогда
		ДокументОбъект = Объект;
	Иначе
		ДокументОбъект = ДанныеФормыВЗначение(Объект,Тип("ДокументОбъект.питПланМеню"));
	КонецЕсли;
	
	// +ИзменениеФактаВПроизводстве
	ЕстьИзмененныеБлюда = питИзменениеФактаВПроизводстве.ЕстьИзмененныеБлюдаТовары(Неопределено, Объект.Товары);
	// -ИзменениеФактаВПроизводстве
	
	// +АвтовыборНоменклатуры
	МассивДеревьевСостава = Новый Массив;
	// +АвтовыборНоменклатуры
	
	// Заполним нормативным составом
	ТаблицаПроизводства = питПроизводство.ЗаполнитьПроизводственныеТаблицыПоРецептуре(ДокументОбъект, ЕстьИзмененныеБлюда,,,МассивДеревьевСостава, Объект.УточненияАвтовыбора);
	
	// +АвтовыборНоменклатуры
	питУправлениеДаннымиОбИзделиях.ЗаполнитьУточненияАвтовыбора(МассивДеревьевСостава, Объект.УточненияАвтовыбора);
	Если питУправлениеДаннымиОбИзделиях.ЗаполнитьНайденыОшибкиАвтовыбора(Объект.УточненияАвтовыбора) Тогда
		ОбщегоНазначения.СообщитьПользователю("Найдены неуточненные характеристики в таблице производства!");
	КонецЕсли;
	// +АвтовыборНоменклатуры
	
	СтрокиУдалить = Новый Массив;
	Для каждого ТекСтрокаПроизводство Из ТаблицаПроизводства Цикл
		Если ТекСтрокаПроизводство.ИзАвтопеределов И НЕ ЗначениеЗаполнено(ТекСтрокаПроизводство.РецептураАвтопередела) Тогда
			ТекСтрокаПроизводство.ИзАвтопеределов = Ложь;
			СтрокиСостава = ТаблицаПроизводства.НайтиСтроки(Новый Структура("Номенклатура,Характеристика", ТекСтрокаПроизводство.Ингредиент, ТекСтрокаПроизводство.ХарактеристикаИнгредиента));
			Для каждого ТекСтрокаСостава Из СтрокиСостава Цикл
				Если СтрокиУдалить.Найти(ТекСтрокаСостава) = Неопределено Тогда
					СтрокиУдалить.Добавить(ТекСтрокаСостава);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Для каждого ТекСтрокаУдалить Из СтрокиУдалить Цикл
		ТаблицаПроизводства.Удалить(ТекСтрокаУдалить);
	КонецЦикла;
	
	// +РазрешенныеПодразделения
	Объект.Товары.Загрузить(питПроизводство.УстановитьЗапрещенныеТовары(ТаблицаПроизводства, Объект.Товары.Выгрузить()));
	// -РазрешенныеПодразделения
	
	ТаблицаПроизводства.Колонки.Добавить("ФактЗамены", новый ОписаниеТипов("Число"));
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка");
	
	Объект.Замены.Очистить();
	СтруктураПараметров = Новый Структура("МоментВремени, СчитатьФактВТаблицеЗамен, Склад, Организация, Подразделение, РежимИспользованияАналогов, ОрганизацияПрименяетУСН");
	СтруктураПараметров.МоментВремени  = ДокументОбъект.МоментВремени();
	СтруктураПараметров.СчитатьФактВТаблицеЗамен = Ложь;
	СтруктураПараметров.Склад = Объект.Склад;
	СтруктураПараметров.Организация = Объект.Организация;
	СтруктураПараметров.Подразделение = Объект.Подразделение;
	
	СтруктураПараметров.РежимИспользованияАналогов = Объект.РежимИспользованияАналогов;
	
	СтруктураПараметров.ОрганизацияПрименяетУСН = Ложь;////ОбщептЕРП!!!
	СтруктураПараметров.Вставить("СсылкаНаДокумент", ?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка));
	СтруктураПараметров.Вставить("ВидПроизводства", Объект.ВидПроизводства);
	
	питПроизводство.ЗаполнитьПроизводственныеТаблицыФактическимКоличеством(ТаблицаПроизводства,Объект.Замены , СтруктураПараметров);
	
	Если НЕ Объект.РазрешитьНедовложения Тогда
		// Остаточную нехватку пишем в КоличествоФакт, и заполняем колонку ФактЗамены
		питПроизводство.ЗаписатьОстаточныеНехваткиВКоличествоФакт(ТаблицаПроизводства, Объект.Замены);
	Иначе
		// Рассчитываем только колонку ФактЗамены
		питПроизводство.ЗаписатьВТаблицуПроизводствоФактЗамены(ТаблицаПроизводства, Объект.Замены);
	КонецЕсли;
	
	// Заполняем таблицу производства
	Если ТаблицаПроизводства <> Неопределено Тогда
		
		Объект.Блюда.Очистить();
		Объект.Ингредиенты.Очистить();

		ТаблицаПроизводства.Колонки.ЕдиницаИзмеренияНоменклатуры.Имя = "УпаковкаНоменклатуры";
		ТаблицаПроизводства.Колонки.ЕдиницаИзмеренияИнгредиента.Имя  = "УпаковкаИнгредиента";
		
		ТаблБлюд = ТаблицаПроизводства.Скопировать(,"Номенклатура,Характеристика,Назначение,УпаковкаНоменклатуры,Рецептура,Автопередел,КоличествоНоменклатуры,КоличествоУпаковокНоменклатуры,Порядок");
		ТаблБлюд.Свернуть("Номенклатура,Характеристика,Назначение,Рецептура,УпаковкаНоменклатуры,Автопередел,КоличествоНоменклатуры, КоличествоУпаковокНоменклатуры,Порядок");
		ТаблБлюд.Колонки.Добавить("ИдентификаторСтроки", ОписаниеТиповСтрока, ,36);
		
		ТаблицаПроизводства.Колонки.Добавить("ИдентификаторБлюда", ОписаниеТиповСтрока, ,36);
		
		
		Для Каждого Стр из ТаблБлюд Цикл
			
			Стр.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			
			МассивСтрокингредиентов = ТаблицаПроизводства.НайтиСтроки(Новый Структура("Номенклатура,Характеристика,Назначение,УпаковкаНоменклатуры,Рецептура,Автопередел",Стр.Номенклатура,Стр.Характеристика,Стр.Назначение,Стр.УпаковкаНоменклатуры,Стр.Рецептура, Стр.Автопередел ) );
			
			Для Каждого СтрИнгр из МассивСтрокингредиентов Цикл
				
				НовСтрТаблИнгредиентов = Объект.Ингредиенты.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрТаблИнгредиентов, СтрИнгр);
				НовСтрТаблИнгредиентов.ИдентификаторБлюда = Стр.ИдентификаторСтроки;
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НовСтрТаблИнгредиентов, "Блюдо") Тогда
					НовСтрТаблИнгредиентов.Блюдо = Стр.Номенклатура;
				КонецЕсли;
				
				НовСтрТаблИнгредиентов.Характеристика = СтрИнгр.ХарактеристикаИнгредиента;
				НовСтрТаблИнгредиентов.Назначение = СтрИнгр.НазначениеИнгредиента;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Объект.Блюда.Загрузить(ТаблБлюд);
		
		ДополнительныеТаблицыВыпускаПоТаблицеБлюд = питПроизводство.ПолучитьДополнительныеТаблицыВыпускаПоТаблицеБлюд(ТаблБлюд,";0;1;");
		Объект.Трудозатраты.Загрузить(ДополнительныеТаблицыВыпускаПоТаблицеБлюд[0]);
		Объект.ПобочныеИзделия.Загрузить(ДополнительныеТаблицыВыпускаПоТаблицеБлюд[1]);
		
		// +ИзменениеФактаВПроизводстве
		Для каждого ТекТовар Из Объект.Блюда Цикл
			ТекТовар.ИзмененФактБлюда = Ложь;
		КонецЦикла;
		// -ИзменениеФактаВПроизводстве
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Очистить производство сервер.
//
// Параметры:
//  Объект - Произвольный - Объект.
//
Процедура ОчиститьПроизводствоСервер(Объект) Экспорт
	Объект.Блюда.Очистить();
	Объект.Ингредиенты.Очистить();
	Объект.Замены.Очистить();
	Объект.Трудозатраты.Очистить();
	Объект.ПобочныеИзделия.Очистить();
	// +АвтовыборНоменклатуры
	Объект.УточненияАвтовыбора.Очистить();
	// -АвтовыборНоменклатуры
КонецПроцедуры

// Формирует запрос проверки при смене статуса списка документов
//
// Параметры:
//  МассивДокументов - Массив - Массив ссылок на документы, которые надо проверят.
//  НовыйСтатус - Произвольный - Новый статус.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
// 	Запрос - Запрос проверки перед сменой статуса.
Функция СформироватьЗапросПроверкиПриСменеСтатуса(МассивДокументов, НовыйСтатус, ДополнительныеПараметры) Экспорт
	
	ЗначениеНовогоСтатуса = Перечисления.питСтатусыПлановМеню[НовыйСтатус];
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаДокументов.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ТаблицаДокументов.Ссылка) КАК Представление,
	|	ПРЕДСТАВЛЕНИЕ(ТаблицаДокументов.Статус) КАК ПредставлениеТекущегоСтатуса,
	|	ПРЕДСТАВЛЕНИЕ(&Статус) КАК ПредставлениеНовогоСтатуса,
	|	ВЫБОР
	|		КОГДА ТаблицаДокументов.Статус = &Статус
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СтатусСовпадает,
	|	ТаблицаДокументов.Проведен КАК Проведен,
	|	ТаблицаДокументов.ПометкаУдаления КАК ПометкаУдаления,
	|	ИСТИНА КАК ЗаписьПроведением
	|ИЗ
	|	Документ.питПланМеню КАК ТаблицаДокументов
	|ГДЕ
	|	ТаблицаДокументов.Ссылка В(&МассивДокументов)
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Статус", ЗначениеНовогоСтатуса);
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	Возврат Запрос;
	
КонецФункции

// Формирует представление объекта метаданных на основном языке.
//
// Возвращаемое значение:
// Строка - Представление объекта метаданных на основном языке.
Функция ПредставлениеОбъектаНаОсновномЯзыке() Экспорт
	
	КодОсновногоЯзыка = ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка();
	
	ПредставлениеОбъекта = "План-меню";
	
	Возврат ПредставлениеОбъекта;
	
КонецФункции

// %ИзЕРП% Документы.ЗаказНаПеремещение.ПроверкаПередСменойСтатуса
//  Возвращает результат проверки при смене статуса документа
//
// Параметры:
//  ВыборкаПроверки - ВыборкаИзРезультатаЗапроса - Текущая строка выборк.
//  НовыйСтатус - Произвольный - Новый статус.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
// 	Булево - Истина, в случае успешного завершения проверки.
Функция ПроверкаПередСменойСтатуса(ВыборкаПроверки, НовыйСтатус, ДополнительныеПараметры) Экспорт
	
	Возврат Истина;
	
КонецФункции

#КонецЕсли

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проведение

// %ИзЕРП%
//
// Параметры:
//  Запрос - Произвольный - Запрос.
//  ТекстыЗапроса - Произвольный - Тексты запроса.
//  Регистры - Произвольный - Регистры.
//
Процедура ОтразитьРаспределениеЗапасовДвижения(Запрос, ТекстыЗапроса, Регистры)
	
	ТекстЗапросаТабЧасть =
		"ВЫБРАТЬ
		|	ТабЧасть.Ссылка                 КАК Ссылка,
		|	ТабЧасть.Ссылка.Дата            КАК Период,
		|	ТабЧасть.Номенклатура           КАК Номенклатура,
		|	ТабЧасть.Характеристика         КАК Характеристика,
		|	ТабЧасть.Ссылка.СкладРеализации КАК Склад,
		|	ТабЧасть.Назначение             КАК Назначение,
		|	ЛОЖЬ КАК ПроконтролироватьКачество,
		|	ЛОЖЬ КАК ПодлежитРазблокировке,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПодтвержденияКачества,
		|	ТабЧасть.Ссылка                 КАК Заказ,
		|	ТабЧасть.Ссылка.ДатаПлан        КАК ДатаПоступления,
		|	ИСТИНА                          КАК ДоступенДляРасхода,
		|	ТабЧасть.КоличествоНоменклатуры КАК Количество,
		|	ЛОЖЬ                            КАК ПоГрафику,
		|	НЕОПРЕДЕЛЕНО                    КАК РаспоряжениеВГрафике,
		|	0                               КАК КоличествоВГрафике
		|ИЗ
		|	Документ.питПланМеню.Блюда КАК ТабЧасть
		|ГДЕ
		|	НЕ ТабЧасть.Автопередел
		|";
	
