// %ИзЕРП% Процедура устанавливает параметры запросов.
//
// Параметры:
//  Запрос - Запрос - Объект запроса.
//  ДокументСсылка - ДокументСсылка - Ссылка на документ.
//
Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПланМеню.Дата КАК Период,
	|	ПланМеню.Организация КАК Организация,
	|	ПланМеню.Подразделение КАК Подразделение,
	|	ПланМеню.ДатаПлан КАК ДатаПотребности,
	|	ПланМеню.СкладРеализации КАК СкладРеализации,
	|	ПланМеню.ЦеховаяКладовая КАК ЦеховаяКладовая
	|ИЗ
	|	Документ.питПланМеню КАК ПланМеню
	|ГДЕ
	|	ПланМеню.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",           Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",      Реквизиты.Организация);
	Запрос.УстановитьПараметр("Подразделение",    Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("ДатаПотребности",  Реквизиты.ДатаПотребности);
	Запрос.УстановитьПараметр("СкладРеализации",  Реквизиты.СкладРеализации);
	Запрос.УстановитьПараметр("ЦеховаяКладовая",  Реквизиты.ЦеховаяКладовая);
	Запрос.УстановитьПараметр("ПустаяСсылкаНазначение",    Справочники.Назначения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяСсылкаСклад",         Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяСсылкаПодразделение", Справочники.СтруктураПредприятия.ПустаяСсылка());
	
КонецПроцедуры

#КонецОбласти

// Функция формирует табличный документ с печатной формой ОП-2 "План-меню"
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма
Функция ПечатьОП2(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	питВыпускБлюд.Ссылка КАК Ссылка,
	|	питВыпускБлюд.ХозяйственнаяОперация КАК ВидОперации,
	|	питВыпускБлюд.Номер КАК НомерДокумента,
	|	питВыпускБлюд.Дата КАК ДатаДокумента,
	|	питВыпускБлюд.ДатаПлан КАК ДатаПлан,
	|	питВыпускБлюд.Организация КАК Организация,
	|	питВыпускБлюд.Организация.НаименованиеПолное КАК ПредставлениеОрганизации,
	|	питВыпускБлюд.Подразделение КАК ПодразделениеОрганизации,
	|	питВыпускБлюд.Подразделение.Наименование КАК ПодразделениеПредставление,
	|	питВыпускБлюд.Склад КАК Склад,
	|	питВыпускБлюд.СкладРеализации КАК СкладПолучатель,
	|	питВыпускБлюд.СкладРеализации.Представление КАК ПредставлениеСкладПолучатель,
	|	питВыпускБлюд.Склад.Представление КАК ПредставлениеСклад,
	|	питВыпускБлюд.Склад.ТипСклада КАК ТипСклада,
	|	NULL КАК ТипЦенРозничнойТорговли,
	|	питВыпускБлюд.ТипЦен КАК ТипЦен,
	|	ИСТИНА КАК ТипЦенЦенаВключаетНДС
	|ИЗ
	|	Документ.питПланМеню КАК питВыпускБлюд
	|ГДЕ
	|	питВыпускБлюд.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	питВыпускБлюд.Дата,
	|	питВыпускБлюд.Ссылка";
	
	ЗапросПоТоварам = Новый Запрос;
	ЗапросПоТоварам.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросПоТоварам.УстановитьПараметр("ДополнительнаяКолонкаПечатныхФормДокументов", Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить());
	ЗапросПоТоварам.Текст =
	"ВЫБРАТЬ
	|	питВыпускБлюд.Номенклатура КАК Номенклатура,
	|	питВыпускБлюд.Характеристика КАК Характеристика,
	|	питВыпускБлюд.Номенклатура.НаименованиеПолное + ВЫБОР
	|		КОГДА питВыпускБлюд.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ "" / "" + питВыпускБлюд.Характеристика.НаименованиеПолное
	|	КОНЕЦ КАК ТоварНаименование,
	|	питВыпускБлюд.Рецептура.НомерРецептуры КАК НомерРецептуры,
	|	питВыпускБлюд.Рецептура.Выход КАК ВыходПродукта,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
	|			ТОГДА питВыпускБлюд.Номенклатура.Артикул
	|		ИНАЧЕ питВыпускБлюд.Номенклатура.Код
	|	КОНЕЦ КАК ТоварКод,
	|	питВыпускБлюд.Количество КАК Количество,
	|	питВыпускБлюд.Цена КАК Цена,
	|	питВыпускБлюд.Сумма КАК Сумма,
	|	питВыпускБлюд.СтавкаНДС КАК СтавкаНДС,
	|	питВыпускБлюд.НомерСтроки КАК НомерСтроки,
	|	питВыпускБлюд.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.питПланМеню.Товары КАК питВыпускБлюд
	|ГДЕ
	|	питВыпускБлюд.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	питВыпускБлюд.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	Шапка = Запрос.Выполнить().Выбрать();
	
	ВыборкаПоТоварам = ЗапросПоТоварам.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_питОП2");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ПолеСверху			= 0;
