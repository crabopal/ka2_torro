//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПровестиСПерепланированием(Команда)
	
	РежимПерепланирования = Истина;
	ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма);
	
КонецПроцедуры

