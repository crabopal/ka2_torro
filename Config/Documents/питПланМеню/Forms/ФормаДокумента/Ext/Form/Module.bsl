//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ИсполнительТрудозатратОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Текст) Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыОтбора = Новый Структура("Организация,Подразделение");
		ПараметрыОтбора.Организация = Объект.Организация;
		ПараметрыОтбора.Подразделение = Объект.Подразделение;
		ИсполнительПолучениеДанныхВыбора(ДанныеВыбора, Текст, ПараметрыОтбора);
	КонецЕсли;
КонецПроцедуры

