

#Область ПрограммныйИнтерфейс

#Область Трудозатраты

//  Процедура - Исполнитель начало выбора завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ИсполнительНачалоВыбораЗавершение(Результат, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Объект.ИсполнительТрудозатрат = Результат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ИзменениеФактаВПроизводстве

#Область ОбработчикиСобытийБлюда

// Клиентские вызовы

//  Процедура - Вопрос об изменении рецептуры блюда завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ВопросОбИзмененииРецептурыБлюдаЗавершение(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		БлюдаРецептураПриИзмененииНаСервере(Элементы.Блюда.ТекущаяСтрока);
	Иначе
		// Пользовтаель не захотел делать пересчет, откатываем значение рецептуры на предыдущее.
		ТекущееБлюдо = Элементы.Блюда.ТекущиеДанные;
		Если НЕ ТекущееБлюдо = Неопределено Тогда
			ТекущееБлюдо.Рецептура = ТекущееБлюдо.РецептураПред;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТовары

// Клиентские вызовы

//  Процедура - Товары рецептура при изменении завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ТоварыРецептураПриИзмененииЗавершение(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ТоварыРецептураПриИзмененииНаСервере(Элементы.Товары.ТекущаяСтрока);
	Иначе
		// Пользовтаель не захотел делать пересчет, откатываем значение рецептуры на предыдущее.
		ТекущийТовар = Элементы.Товары.ТекущиеДанные;
		Если НЕ ТекущийТовар = Неопределено Тогда
			ТекущийТовар.Рецептура = ТекущийТовар.РецептураПред;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

//  Процедура - Перейти к меню завершение.
//
// Параметры:
//  ВыбранныйЭлемент - Произвольный - Выбранный элемент.
//  СписокПараметров - СписокЗначений - Список параметров.
//
&НаКлиенте
Процедура ПерейтиКМеню_Завершение(ВыбранныйЭлемент, СписокПараметров = Неопределено) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		возврат
	КонецЕсли;
	СтруктураОтбора = Новый Структура("Владелец", ВыбранныйЭлемент.Значение);
	ОткрытьФорму("Справочник.питМеню.ФормаСписка", Новый Структура("Отбор", СтруктураОтбора),,,,,);
	
КонецПроцедуры

//  Процедура - Выполнить команду завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВыполнитьКомандуЗавершение(Результат, Команда) Экспорт
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	Если ОписаниеКоманды.Вид = "СозданиеНаОсновании" И ОписаниеКоманды.Представление = "Выпуск блюд" 
		И Объект.Статус <> ПредопределенноеЗначение("Перечисление.питСтатусыПлановМеню.КПроизводству")
		И НЕ Объект.ПометкаУдаления
		И Результат = КодВозвратаДиалога.Да Тогда
		Объект.Статус = ПредопределенноеЗначение("Перечисление.питСтатусыПлановМеню.КПроизводству");
		Попытка
			Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось записать документ по причине: " + ОписаниеОшибки(), "", "");
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
	
КонецПроцедуры

//  Процедура - После закрытия вопроса изменение типа цен.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ПослеЗакрытияВопросаИзменениеТипаЦен(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьЦеныПоВидуЦенСервер(Объект.ТипЦен);
		ТоварыПересчитатьПлановуюМаржинальностьКлиент();
		Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
	КонецЕсли;
КонецПроцедуры

//  Процедура - После закрытия вопроса изменение типа цен продажи.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Параметры - Произвольный - Параметры.
//
&НаКлиенте
Процедура ПослеЗакрытияВопросаИзменениеТипаЦенПродажи(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьЦеныПродажиСервер();
		ТоварыПересчитатьПлановуюМаржинальностьКлиент();
	КонецЕсли;
КонецПроцедуры

//  Процедура - Статус при изменении завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СтатусПриИзмененииЗавершение(Результат, Команда) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.Статус = ПредыдущийСтатус;
	Иначе
		ЗаполнитьПредставленияСвязанныхВыпусковБлюд();
		Для каждого ВыборкаДетальныеЗаписи Из ПредставленияВыпусковБлюд Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Обратите внимание, что после смены статуса
			|необходимо перепровести связанный документ <"+ВыборкаДетальныеЗаписи.Представление+">";
			Сообщение.КлючДанных = ВыборкаДетальныеЗаписи.ВыпускБлюд;
			Сообщение.ИдентификаторНазначения = ЭтаФорма.УникальныйИдентификатор;
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

#Область ПобочныеИзделия

#Область ПобочныеИзделияСлужебныеФункции

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	// +ПерепланированиеПроизводства
	ТекущийОбъект.ДополнительныеСвойства.Вставить("РежимПерепланирования", РежимПерепланирования);
	// -ПерепланированиеПроизводства
КонецПроцедуры

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
	
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22);
	Если ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен Тогда
		ПроверяемыеРеквизиты.Добавить("ЦеховаяКладовая");
	Иначе
		ПроверяемыеРеквизиты.Добавить("Подразделение");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

// Обработчик события возникающего на сервере при чтении данных объекта.
//
// Параметры:
//  ТекущийОбъект - ДокументОбъект - Объект, который будет прочитан.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Если ОбщегоНазначенияУТКлиентСервер.АвторизованВнешнийПользователь() Тогда
		ТребуетсяОткрытиеПечатнойФормы = Истина;
		Возврат;
	КонецЕсли;
	
	// Обработчик механизма "ДатыЗапретаИзменения"
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПриЧтенииСозданииНаСервере();
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	СобытияФорм.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// +ПерепланированиеПроизводства
	питПерепланирование.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// -ПерепланированиеПроизводства
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// +АвтовыборНоменклатуры
	НайденыОшибкиАвтовыбора = питУправлениеДаннымиОбИзделиях.ЗаполнитьНайденыОшибкиАвтовыбора(Объект.УточненияАвтовыбора);
	// +АвтовыборНоменклатуры
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
	
		
		ПриЧтенииСозданииНаСервере();
		
	КонецЕсли;
	
	ВосприниматьБлюдоБезРецептурыКакТовар = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("питВосприниматьБлюдоБезРецептурыКакТовар");
	
	// ЕРП
	УстановитьУсловноеОформление();
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	УстановитьЗаголовокФормы();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// Обработчик механизма "Назначения"
	Справочники.Назначения.ФормаДокументаПриСозданииНаСервере(ЭтаФорма);
	
	// ЕРП
	
//   Попытка заполнить плановую дату, если она не была заполнена. Если дата документа пустая, тогда просто ставим на
// завтра.
	Если НЕ ЗначениеЗаполнено(Объект.ДатаПлан) Тогда
		Объект.ДатаПлан = ?(ЗначениеЗаполнено(Объект.Дата) И НЕ Объект.Ссылка.Пустая(), Объект.Дата, КонецДня(ТекущаяДата())+1);
	КонецЕсли;
	
	питДокументы.УстановитьИспользованиеПлановойСтоимости(ИспользоватьПлановуюСтоимость, Объект);
	
	ФормироватьДокументыПроизводства22 = Константы.питФормироватьДокументыПроизводства22.Получить();
	РежимПроизводстваРазрешен = питОбщегоНазначения.ПроверитьРежимПроизводстваERP(ФормироватьДокументыПроизводства22);
	Если ФормироватьДокументыПроизводства22 И РежимПроизводстваРазрешен Тогда
		Элементы.ЦеховаяКладовая.Видимость = Истина;
		// Элементы.Подразделение.Видимость = Ложь;
	Иначе
		Элементы.ЦеховаяКладовая.Видимость = Ложь;
		// Элементы.Подразделение.Видимость = Истина;
	КонецЕсли;
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	// Маршрутизация блюд по складам.
	Элементы.Группа4.Видимость = ФормироватьДокументыПроизводства22;
	
	УправлениеФормойТрудозатраты(Объект, Элементы);
	
	ПредыдущийСтатус = Объект.Статус;
	
	УстановитьДоступностьПодразделение();
	
	ЗаполнитьДобавленныеКолонкиТаблицыИнгредиентов();
	
	// +ИзменениеФактаВПроизводстве
	ОбновитьФактЗаменВТаблицеИнгредиентов();
	питИзменениеФактаВПроизводстве.ИнициализироватьИменаКолонокРеквизитов(ЭтаФорма);
	// -ИзменениеФактаВПроизводстве
	
КонецПроцедуры // ПриСозданииНаСервере()

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.питПодборТоваровПоМеню.Форма.Форма" Тогда
		ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ПодборТоваровВДокументПродажи.Форма.Форма" Тогда
		
		// +ИзменениеФактаВПроизводстве
		Если СтрНайти(ИсточникВыбора.Заголовок, "товар") Тогда
			ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение);
		ИначеЕсли СтрНайти(ИсточникВыбора.Заголовок, "ингредиент") Тогда
			ИдентификаторСтрокиБлюда = Элементы.Блюда.ТекущаяСтрока;
			ОбработкаВыбораПодборИнгредиентовНаСервере(ИдентификаторСтрокиБлюда, ВыбранноеЗначение);
		КонецЕсли;
		// -ИзменениеФактаВПроизводстве
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.питФормаПодбораХарактеристик" Тогда
		
		// +АвтовыборНоменклатуры
		ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение);
		УправлениеФормой(ЭтаФорма);
		// -АвтовыборНоменклатуры
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - После записи на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// +ПерепланированиеПроизводства
	РежимПерепланирования = Ложь;
	// -ПерепланированиеПроизводства
	
	НастроитьЗависимыеЭлементыФормы(ЭтаФорма);
	
	// Обновим заголовок, в том числе и чтобы не осталось надписи "(создание)", если это была запись нового документа.
	УстановитьЗаголовокФормы();
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	УправлениеФормойТрудозатраты(Объект, Элементы);
	
	ЗаполнитьДобавленныеКолонкиТаблицыИнгредиентов();
	
	// +ИзменениеФактаВПроизводстве
	ОбновитьФактЗаменВТаблицеИнгредиентов();
	// -ИзменениеФактаВПроизводстве
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

