КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	Если ОписаниеКоманды.Вид = "СозданиеНаОсновании" И ОписаниеКоманды.Представление = "Выпуск блюд" 
		И Объект.Статус <> ПредопределенноеЗначение("Перечисление.питСтатусыПлановМеню.КПроизводству")
		И НЕ Объект.ПометкаУдаления Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьКомандуЗавершение", ЭтотОбъект, Команда);
		ПоказатьВопрос(Оповещение, "Документ не переведен в статус ""К производству"". Выполнить предварительное проведение документа со сменой статуса?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Подбор товары.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПодборТовары(Команда)
	
	ПараметрыПодбора = ПолучитьПараметрыПодбора();
	ОткрытьФорму("Обработка.ПодборТоваровВДокументПродажи.Форма", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

