#Область Трудозатраты

// Процедура обновляет отбор таблицы Трудозатрат на форме по текущему значению идентификатора строки в таблице блюд.
//
&НаКлиенте
Процедура ОбновитьОтборСтрокВТаблицеТрудозатрат()
	
	Перем ТекДанные;
	
	ТекДанные = Элементы.БлюдаТрудозатраты.ТекущиеДанные;
	Если ТекДанные <>  Неопределено Тогда
		Элементы.Трудозатраты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", ТекДанные.ИдентификаторСтроки);
	Иначе
		Элементы.Трудозатраты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", "xxx");/// Скроем
	КонецЕсли;

КонецПроцедуры

//  Процедура - Управление формой трудозатраты.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  Элементы - Произвольный - Элементы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормойТрудозатраты(Объект, Элементы)
	
	Элементы.ИсполнительТрудозатрат.ОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.ИсполнительТрудозатрат) И Объект.Трудозатраты.Количество();

КонецПроцедуры

//  Процедура - Исполнитель получение данных выбора.
//
// Параметры:
//  ДанныеВыбора - Произвольный - Данные выбора.
//  Текст - Произвольный - Текст.
//  Параметры - Произвольный - Параметры.
//
&НаСервереБезКонтекста
Процедура ИсполнительПолучениеДанныхВыбора(ДанныеВыбора, Текст, Параметры)
	
	ДанныеВыбора = Новый СписокЗначений;
	ПроизводствоСервер.ЗаполнитьДанныеВыбораПриВводеИсполнителя(ДанныеВыбора, Текст, Параметры);
	
КонецПроцедуры

#КонецОбласти

#Область ПобочныеИзделия

#Область ПобочныеИзделияОбработчикиСобытий

//  Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаНоменклатураПриИзменении(ИмяТЧ)
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
											
	ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	Если ИмяТЧ = "ВыходныеИзделия"
		ИЛИ ИмяТЧ = "ПобочныеИзделия" Тогда
		
		Если ИмяТЧ = "ВыходныеИзделия" Тогда
			ТекущаяСтрока.Получатель = ПолучательПоУмолчанию(ТекущаяСтрока);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Таблица количество упаковок при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаКоличествоУпаковокПриИзменении(ИмяТЧ)
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;

	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	
	Если ИмяТЧ = "ПобочныеИзделия" Тогда
		СтруктураДействий.Вставить("ПересчитатьСумму");
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

//  Процедура - Таблица упаковка при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//
&НаКлиенте
Процедура ТаблицаУпаковкаПриИзменении(ИмяТЧ)
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий);
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

#КонецОбласти

#Область ПобочныеИзделияСлужебныеФункции

//  Процедура - Добавить в структуру действия при изменении количества упаковок.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчета);
	Если ИмяТЧ = "ПобочныеИзделия" Тогда
		СтруктураДействий.Вставить("ПересчитатьСумму");
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий)

	Объект = Форма.Объект;
	
	Если Не ТекущаяСтрока = Неопределено Тогда
		СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
	Иначе
		СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу");
	КонецЕсли;
	
	Если ИмяТЧ <> "Ингредиенты" И ИмяТЧ <> "Замены" Тогда
		СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул",
		Новый Структура("Номенклатура", "Артикул"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
		Новый Структура("Номенклатура", "ТипНоменклатуры"));
	КонецЕсли;
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		Форма.ИмяФормы, ИмяТЧ));
	
	Если ИмяТЧ = "Замены" Тогда
		Если Форма.Элементы[ИмяТЧ].ТекущийЭлемент = Форма.Элементы.ЗаменыИнгредиентИсходный Тогда
			СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
			Новый Структура("ИнгредиентИсходный", "ХарактеристикиИнгредиентаИсходногоИспользуются"));
		Иначе
			СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
			Новый Структура("ИнгредиентЗамена", "ХарактеристикиИнгредиентаЗаменаИспользуются"));
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяТЧ = "Ингредиенты" Тогда
		СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
		Новый Структура("Ингредиент", "ХарактеристикиИспользуются"));
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Получатель по умолчанию.
//
// Параметры:
//  ТекСтрока - Строка - Тек строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучательПоУмолчанию(ТекСтрока)
	
	СтруктураСтроки = Новый Структура("НаправлениеВыпуска, Получатель");
	ЗаполнитьЗначенияСвойств(СтруктураСтроки, ТекСтрока);
	СтруктураСтроки.НаправлениеВыпуска = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыпускПродукцииНаСклад");
	
	Возврат ПолучательПоУмолчаниюНаСервере(СтруктураСтроки);
	
КонецФункции

//  Функция - Получатель по умолчанию на сервере.
//
// Параметры:
//  ТекСтрока - Строка - Тек строка.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПолучательПоУмолчаниюНаСервере(ТекСтрока)
	
	Если ТекСтрока.НаправлениеВыпуска = Перечисления.ХозяйственныеОперации.ВыпускПродукцииВПодразделение
		И Не ЗначениеЗаполнено(ТекСтрока.Получатель) Тогда
		Возврат Объект.Подразделение;
	ИначеЕсли ТекСтрока.НаправлениеВыпуска = Перечисления.ХозяйственныеОперации.ВыпускПродукцииНаСклад Тогда
		Если ТипЗнч(ТекСтрока.Получатель) = Тип("СправочникСсылка.Склады")
			И Не ТекСтрока.Получатель.Подразделение = Объект.Подразделение Тогда
			ТекСтрока.Получатель = Неопределено;
		КонецЕсли;
		Возврат ЗначениеНастроекПовтИсп.ПолучитьЦеховуюКладовуюПоУмолчанию(Объект.Подразделение, ТекСтрока.Получатель);
	Иначе
		Возврат ТекСтрока.Получатель;
	КонецЕсли;
	
КонецФункции

//  Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.ПобочныеИзделия,	ПараметрыЗаполненияРеквизитов);

											
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
											
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("Блюдо", "ХарактеристикиБлюдаИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Замены,	ПараметрыЗаполненияРеквизитов);
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("ИнгредиентИсходный", "ХарактеристикиИнгредиентаИсходногоИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Замены,	ПараметрыЗаполненияРеквизитов);
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("ИнгредиентЗамена", "ХарактеристикиИнгредиентаЗаменаИспользуются"));
	
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Замены,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Блюда,	ПараметрыЗаполненияРеквизитов);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Ингредиент", "ХарактеристикиИспользуются"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Ингредиенты,	ПараметрыЗаполненияРеквизитов);
	
	// +ИзменениеФактаВПроизводстве
	Для каждого ТекИнгредиент Из Объект.Ингредиенты Цикл
		ТекИнгредиент.КоличествоУпаковокИнгредиентаФактПред = ТекИнгредиент.КоличествоУпаковокИнгредиентаФакт;
		ТекИнгредиент.КоличествоИнгредиентаФактПред = ТекИнгредиент.КоличествоИнгредиентаФакт;
		ТекИнгредиент.РецептураАвтопеределаПред = ТекИнгредиент.РецептураАвтопередела;
	КонецЦикла;
	Для каждого ТекБлюдо Из Объект.Блюда Цикл
		ТекБлюдо.РецептураПред = ТекБлюдо.Рецептура;
	КонецЦикла;
	Для каждого ТекТовар Из Объект.Товары Цикл
		ТекТовар.РецептураПред = ТекТовар.Рецептура;
	КонецЦикла;
	// -ИзменениеФактаВПроизводстве
	
КонецПроцедуры

// Процедура обновляет отбор таблицы Трудозатрат на форме по текущему значению идентификатора строки в таблице блюд.
//
&НаКлиенте
Процедура ОбновитьОтборСтрокВТаблицеПобочныхИзделий()
	
	Перем ТекДанные;
	
	ТекДанные = Элементы.БлюдаПобочныеИзделия.ТекущиеДанные;
	Если ТекДанные <>  Неопределено Тогда
		Элементы.ПобочныеИзделия.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", ТекДанные.ИдентификаторСтроки);
	Иначе
		Элементы.ПобочныеИзделия.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторБлюда", "xxx");/// Скроем
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Назначения

//  Процедура - При чтении создании на сервере.
//
&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	НастроитьЭлементыФормы();
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Настроить элементы формы.
//
&НаСервере
Процедура НастроитьЭлементыФормы()
	
	НастроитьЗависимыеЭлементыФормы(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Настроить зависимые элементы формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СписокРеквизитов - СписокЗначений - Список реквизитов.
//
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЗависимыеЭлементыФормы(Форма, СписокРеквизитов = "")
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Инициализация = ПустаяСтрока(СписокРеквизитов);
	СтруктураРеквизитов = Новый Структура(СписокРеквизитов);
	
КонецПроцедуры

#КонецОбласти

#Область ИзменениеФактаВПроизводстве

#Область ОбработчикиСобытийБлюда

// Серверные вызовы

//  Процедура - Блюда рецептура при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура БлюдаРецептураПриИзмененииНаСервере(ИдентификаторСтроки)
	ТекущееБлюдо = Объект.Блюда.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущееБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущееБлюдо.Автопередел Тогда
		// Получение ингредиентов в ТЧ "Ингредиенты", которые соответствуют текущему блюду.
		ИнгредиентыИзАвтопеределов = питИзменениеФактаВПроизводстве.НайтиИнгредиентыИзАвтопеределовПоБлюду(ЭтаФорма, Объект.Ингредиенты, ТекущееБлюдо);
		Для каждого СтрокаИнгредиент Из ИнгредиентыИзАвтопеределов Цикл
			// Изменяем рецептуру автопередела у найденных ингредиентов
			СтрокаИнгредиент.РецептураАвтопередела = ТекущееБлюдо.Рецептура;
		КонецЦикла;
	Иначе
		// Получение товара, соответствующего текущему блюду.
		НайденныйТовар = питИзменениеФактаВПроизводстве.НайтиТоварПоБлюду(ЭтаФорма, Объект.Товары, ТекущееБлюдо);
		НайденныйТовар.Рецептура = ТекущееБлюдо.Рецептура;
	КонецЕсли;
	
	// Вызываем рекурсивную обработку изменения факта блюда / автопередела.
	питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, Неопределено, ТекущееБлюдо);
	
	// Устанавливаем изменение факта блюда.
	питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, ТекущееБлюдо);
	
	// Устанавливаем предыдущее значение рецептуры на текущее;
	ТекущееБлюдо.РецептураПред = ТекущееБлюдо.Рецептура;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийИнгредиенты

// Серверные вызовы

//  Процедура - Ингредиенты количество упаковок ингредиента факт при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ИнгредиентыКоличествоУпаковокИнгредиентаФактПриИзмененииНаСервере(ИдентификаторСтроки)
	
	СтрокаИнгредиент = Объект.Ингредиенты.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если НЕ СтрокаИнгредиент = Неопределено Тогда
		
		питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, СтрокаИнгредиент, Неопределено);
		
		// Установка флага, что факт строки был изменен.
		СтрокаИнгредиент.ИзмененФакт = Истина;
		
		// Поиск блюда ингредиента
		БлюдоИнгредиента = питИзменениеФактаВПроизводстве.НайтиБлюдоИнгредиента(Объект.Блюда, СтрокаИнгредиент);
		
		// Устанавливаем изменение факта блюда.
		питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, БлюдоИнгредиента);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Обработка выбора подбор ингредиентов на сервере.
//
// Параметры:
//  ИдентификаторСтрокиБлюда - Произвольный - Идентификатор строки блюда.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборИнгредиентовНаСервере(ИдентификаторСтрокиБлюда, ВыбранноеЗначение)
	
	// Получение текущей строки блюда.
	СтрокаБлюдо = Объект.Блюда.НайтиПоИдентификатору(ИдентификаторСтрокиБлюда);
	Если СтрокаБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		// Новая строка не была среди найденных, значит ее не было раньше. Добавляем.
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("ИдентификаторБлюда",					СтрокаБлюдо.ИдентификаторСтроки);
		СтруктураДанных.Вставить("Номенклатура",						СтрокаТовара.Номенклатура);
		СтруктураДанных.Вставить("Характеристика",						СтрокаТовара.Характеристика);
		СтруктураДанных.Вставить("Ингредиент",							СтрокаТовара.Номенклатура);
		СтруктураДанных.Вставить("УпаковкаИнгредиента",					?(ЗначениеЗаполнено(СтрокаТовара.Упаковка), СтрокаТовара.Упаковка, СтрокаТовара.Номенклатура.ЕдиницаИзмерения));
		СтруктураДанных.Вставить("КоличествоУпаковокИнгредиентаНорма",	0);
		СтруктураДанных.Вставить("КоличествоИнгредиентаНорма",			0);
		СтруктураДанных.Вставить("КоличествоУпаковокИнгредиентаФакт",	СтрокаТовара.КоличествоУпаковок);
		СтруктураДанных.Вставить("КоличествоИнгредиентаФакт",			СтрокаТовара.Количество);
		СтруктураДанных.Вставить("ЗапретитьЗамены",						Ложь);
		СтруктураДанных.Вставить("СезонныйПроцент",						0);
		
		// Ищем ингредиент среди уже добавленных.
		ТекущийИнгредиент = питИзменениеФактаВПроизводстве.НайтиИнгредиентПоСтруктуреДанных(Объект.Ингредиенты, СтруктураДанных);
		Если ТекущийИнгредиент = Неопределено Тогда
			// Не нашли ингредиент, добавляем новый.
			ТекущийИнгредиент = питИзменениеФактаВПроизводстве.ДобавитьИнгредиентПоСтруктуреДанных(ЭтаФорма, Объект.Ингредиенты, СтруктураДанных);
		Иначе
			// Нашли ингредиент, обновляем фактическое количество.
			ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт	= ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт + СтруктураДанных.КоличествоУпаковокИнгредиентаФакт;
			ТекущийИнгредиент.КоличествоИнгредиентаФакт			= ТекущийИнгредиент.КоличествоИнгредиентаФакт + СтруктураДанных.КоличествоИнгредиентаФакт;
		КонецЕсли;
		
		Если питИзменениеФактаВПроизводствеКлиентСервер.ТекущийИнгредиентЯвляетсяПолуфабрикатом(ТекущийИнгредиент) Тогда
			// Поиск блюда по добавленному ингредиенту и его добавление, если не найдено.
			питИзменениеФактаВПроизводстве.НайтиДобавитьБлюдоПоИнгредиенту(ЭтаФорма, ТекущийИнгредиент);
			// Обновление порядка в таблице блюд.
			питИзменениеФактаВПроизводстве.ОбновитьПорядокБлюдПоИнгредиенту(ЭтаФорма, ТекущийИнгредиент, СтрокаБлюдо.Порядок);
			// Обрабатываем рекурсивно изменение количества ингредиента, который является полуфабрикатом.
			питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, ТекущийИнгредиент, Неопределено);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТовары

// Серверные вызовы

//  Процедура - Товары рецептура при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ТоварыРецептураПриИзмененииНаСервере(ИдентификаторСтроки)
	
	СтрокаТовар = Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТовар = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Изменен факт для товара.
	СтрокаТовар.ИзмененФактБлюда = Истина;
	
	ТекущееБлюдо = питИзменениеФактаВПроизводстве.НайтиБлюдоПоТовару(ЭтаФорма, Объект.Блюда, СтрокаТовар);
	Если ТекущееБлюдо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущееБлюдо.Рецептура = СтрокаТовар.Рецептура;
	
	// Вызываем рекурсивную обработку изменения факта блюда / автопередела.
	питИзменениеФактаВПроизводстве.ОбработатьИзменениеФактаИнгредиентаИзАвтопеределовБлюда(ЭтаФорма, Неопределено, ТекущееБлюдо);
	
	// Устанавливаем изменение факта блюда.
	питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, ТекущееБлюдо);
	
	// Устанавливаем предыдущее значение рецептуры.
	СтрокаТовар.РецептураПред	= СтрокаТовар.Рецептура;
	ТекущееБлюдо.РецептураПред	= ТекущееБлюдо.Рецептура;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЗамены

// Клиентские вызовы

//  Процедура - Посчитать вединицах хранения замены исходный.
//
&НаКлиенте
Процедура ПосчитатьВединицахХранения_ЗаменыИсходный()
	
	ТекущаяСтрока = Элементы.Замены.ТекущиеДанные;
	// Вспомогательные поля т.к. стандартные обработки ЕРП работают только с одной номенклатурой и упаковкой в строке
	ТекущаяСтрока.Номенклатура = ТекущаяСтрока.ИнгредиентИсходный;
	ТекущаяСтрока.Упаковка     = ТекущаяСтрока.УпаковкаИнгредиентаИсходный;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", "ИнгредиентаИсходный");
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);
	
КонецПроцедуры

// Серверные вызовы

//  Процедура - Замены исходное количество единица при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ЗаменыИсходноеКоличествоЕдиницаПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Замены.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьФактЗаменПоСтрокеЗамены(ТекущаяСтрока);
	
КонецПроцедуры

//  Процедура - Замены ингредиент исходный при изменении на сервере.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ЗаменыИнгредиентИсходныйПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Замены.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем единицу измерения на непустую.
	ТекущаяСтрока.УпаковкаИнгредиентаИсходный = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ИнгредиентИсходный, "ЕдиницаИзмерения");
	
	ОбновитьФактЗаменПоСтрокеЗамены(ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Обновить факт замен в таблице ингредиентов.
//
&НаСервере
Процедура ОбновитьФактЗаменВТаблицеИнгредиентов()
	
	// "Обнуляем" факт замены.
	Для каждого ТекущийИнгредиент Из Объект.Ингредиенты Цикл
		ТекущийИнгредиент.ФактЗамены = 0;
	КонецЦикла;
	
	// Обход замен, поиск соответствующего ингредиента и инкремент "ФактЗамены".
	Для каждого ТекЗамена Из Объект.Замены Цикл
		ОбновитьФактЗаменПоСтрокеЗамены(ТекЗамена);
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Обновить факт замен по строке замены.
//
// Параметры:
//  СтрокаЗамена - Строка - Строка замена.
//
&НаСервере
Процедура ОбновитьФактЗаменПоСтрокеЗамены(СтрокаЗамена)
	
	// Поиск ингредиента, соответствующего текущей замене.
	НайденныйИнгредиент	= питИзменениеФактаВПроизводстве.НайтиИнгредиентПоЗамене(Объект.Ингредиенты, Объект.Блюда, СтрокаЗамена);
	Если НайденныйИнгредиент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Инкремент факта замены.
	НайденныйИнгредиент.ФактЗамены = НайденныйИнгредиент.ФактЗамены + СтрокаЗамена.КоличествоУпаковокИнгредиентаИсходный;
	
	// Установка флага измененности.
	НайденныйИнгредиент.ИзмененФакт = Истина;
	
	// Поиск блюда ингредиента
	БлюдоИнгредиента = питИзменениеФактаВПроизводстве.НайтиБлюдоИнгредиента(Объект.Блюда, НайденныйИнгредиент);
	
	// Устанавливаем изменение факта блюда.
	питИзменениеФактаВПроизводстве.УстановитьИзменениеФактаБлюда(ЭтаФорма, БлюдоИнгредиента);
	
КонецПроцедуры

//  Функция - Упаковать уточнения автовыбора.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция УпаковатьУточненияАвтовыбора()
	Возврат ПоместитьВоВременноеХранилище(Объект.УточненияАвтовыбора.Выгрузить());
КонецФункции

//  Функция - Распаковать уточнения автовыбора.
//
// Параметры:
//  Адрес - Произвольный - Адрес.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция РаспаковатьУточненияАвтовыбора(Адрес)
	Возврат ПолучитьИзВременногоХранилища(Адрес);
КонецФункции

//  Процедура - Обработка выбора подбор характеристик на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборХарактеристикНаСервере(ВыбранноеЗначение)
	
	Объект.УточненияАвтовыбора.Загрузить(РаспаковатьУточненияАвтовыбора(ВыбранноеЗначение));
	НайденыОшибкиАвтовыбора = питУправлениеДаннымиОбИзделиях.ЗаполнитьНайденыОшибкиАвтовыбора(Объект.УточненияАвтовыбора);
	// Если НЕ НайденыОшибкиАвтовыбора Тогда
		ЗаполнитьПоНормативам();
	// КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область питПриоритетыПриготовления

//  Процедура - Товары сортировать по приоритету на сервере.
//
&НаСервере
Процедура ТоварыСортироватьПоПриоритетуНаСервере()
	питПриоритетыПриготовления.СортироватьТабличнуюЧастьОбъектаПоПриоритетуПриготовления(Объект, "Товары", Объект.Склад);
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область КопированиеВставкаСтрок

//  Процедура - Скопировать строки на сервере.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура СкопироватьСтрокиНаСервере(ИмяТаблицы)
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(Объект[ИмяТаблицы], Элементы[ИмяТаблицы].ВыделенныеСтроки);
	
КонецПроцедуры

//  Процедура - Получить строки из буфера обмена.
//
// Параметры:
//  ИмяТаблицы - Произвольный - Имя таблицы.
//
&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена(ИмяТаблицы)
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена();
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТаблицы, СтруктураДействий);
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект[ИмяТаблицы].Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		// Дозаполним еще реквизиты, такие как "Рецептура", "ЭтоБлюдо", "ЭтоТовар" и т.д.
		СписокСвойствСтрокой = "Номенклатура, Характеристика, ЭтоУслуга, ЭтоБлюдо, ПриготовлениеРазрешено, ЭтоТовар, Иконка, Рецептура, ИзмененФактБлюда, РецептураПред";
		ДанныеСтрокаТаблицы = Новый Структура(СписокСвойствСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, ТекущаяСтрока);
		
		СвойстваПараметрыОбъектаСтрокой = "ХозяйственнаяОперация, Организация, Дата, Ссылка, Подразделение, Склад";
		ПараметрыОбъекта = Новый Структура(СвойстваПараметрыОбъектаСтрокой);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
		
		ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеСтрокаТаблицы);
		
	КонецЦикла;
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

//  Функция - Получить имя текущей табличной части.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучитьИмяТекущейТабличнойЧасти()
	
	ИмяТаблицы = "Товары";
	Возврат ИмяТаблицы;
	
КонецФункции

#КонецОбласти

//  Процедура - Установить условное оформление.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// ОбщептЕРП, есть установленные в форме, пока не очищаем.  
	// УсловноеОформление.Элементы.Очистить();
	
	ПараметрыУсловногоОформления = питДлительнаяПоддержка.НовыеПараметрыУсловногоОформленияЕдиницИзмерения();
