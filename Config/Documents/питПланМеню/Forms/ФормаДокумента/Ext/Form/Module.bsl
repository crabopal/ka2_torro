&НаКлиенте
Процедура ТоварыНазначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Атавизм = 2;
КонецПроцедуры

#КонецОбласти

#Область ИзменениеФактаВПроизводстве

#Область ОбработчикиСобытийБлюда

// Обработчики

//  Процедура - Блюда рецептура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура БлюдаРецептураПриИзменении(Элемент)
	ТекущееБлюдо = Элементы.Блюда.ТекущиеДанные;
	Если НЕ ТекущееБлюдо = Неопределено Тогда
		
		Если ТекущееБлюдо.Рецептура = ТекущееБлюдо.РецептураПред Тогда
			Возврат;
		КонецЕсли;
		
		Если ТекущееБлюдо.ИзмененФактБлюда Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ВопросОбИзмененииРецептурыБлюдаЗавершение", ЭтотОбъект, Новый Структура),
				"Существуют измененные ингредиенты/полуфабрикаты для текущего блюда, изменение приведет к их пересчету, продолжить?", 
				РежимДиалогаВопрос.ДаНет);
		Иначе
			БлюдаРецептураПриИзмененииНаСервере(Элементы.Блюда.ТекущаяСтрока);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - Блюда перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура БлюдаПередУдалением(Элемент, Отказ)
	Отказ = Истина; // Блюда запрещено удалять неконтекстно, даже в режиме "По факту".
КонецПроцедуры

//  Процедура - Блюда перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура БлюдаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина; // Блюда запрещено добавлять неконтекстно, даже в режиме "По факту".
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийИнгредиенты

// Обработчики

//  Процедура - Ингредиенты количество упаковок ингредиента факт при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ИнгредиентыКоличествоУпаковокИнгредиентаФактПриИзменении(Элемент)
	
	ПосчитатьВединицахХранения_ИнгредиентИсходныйФакт();
	
	ТекущиеДанные = Элементы.Ингредиенты.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		// Дополнительная серверная обработка строки.
		ТекущаяСтрока = Элементы.Ингредиенты.ТекущаяСтрока;
		
		ИнгредиентыКоличествоУпаковокИнгредиентаФактПриИзмененииНаСервере(ТекущаяСтрока);
		
		ТекущиеДанные.КоличествоУпаковокИнгредиентаФактПред	= ТекущиеДанные.КоличествоУпаковокИнгредиентаФакт;
		ТекущиеДанные.КоличествоИнгредиентаФактПред			= ТекущиеДанные.КоличествоИнгредиентаФакт;
		ТекущиеДанные.РецептураАвтопеределаПред				= ТекущиеДанные.РецептураАвтопеределаПред;
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Ингредиенты перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ИнгредиентыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = ПолучитьПараметрыПодбора("Ингредиенты");
	ОткрытьФорму("Обработка.ПодборТоваровВДокументПродажи.Форма", ПараметрыПодбора, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

//  Процедура - Ингредиенты перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ИнгредиентыПередУдалением(Элемент, Отказ)
	ТекущийИнгредиент = Элементы.Ингредиенты.ТекущиеДанные;
	Если НЕ ТекущийИнгредиент = Неопределено Тогда
		
		// Ингредиенты, которые являются полуфабрикатами не удаляем.
		Отказ = Истина;
		
		// Вместо этого обнуляем их количество факт.
		ТекущийИнгредиент.КоличествоУпаковокИнгредиентаФакт	= 0;
		ТекущийИнгредиент.КоличествоИнгредиентаФакт			= 0;
		
		// Вызываем обработку изменения количества факт.
		ИнгредиентыКоличествоУпаковокИнгредиентаФактПриИзменении(Неопределено);
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТовары

// Обработчики

//  Процедура - Товары рецептура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыРецептураПриИзменении(Элемент)
	ТекущийТовар = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущийТовар = Неопределено Тогда
		
		Если ТекущийТовар.Рецептура = ТекущийТовар.РецептураПред Тогда
			Возврат;
		КонецЕсли;
		
		Если ТекущийТовар.ИзмененФактБлюда Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ТоварыРецептураПриИзмененииЗавершение", ЭтотОбъект, Новый Структура),
				"Существуют измененные ингредиенты/полуфабрикаты для текущего блюда, изменение приведет к их пересчету, продолжить?", 
				РежимДиалогаВопрос.ДаНет);
		Иначе
			ТоварыРецептураПриИзмененииНаСервере(Элементы.Товары.ТекущаяСтрока);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЗамены

// Обработчики

//  Процедура - Замены ингредиент исходный при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗаменыИнгредиентИсходныйПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Замены.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.УпаковкаИнгредиентаИсходный = Неопределено;
	ПосчитатьВединицахХранения_ЗаменыИсходный();
	
	ЗаменыИнгредиентИсходныйПриИзмененииНаСервере(Элементы.Замены.ТекущаяСтрока);
	
	ТаблицаНоменклатураПриИзменении("Замены");
	
КонецПроцедуры

//  Процедура - Замены единица измерения ингредиента исходный при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗаменыЕдиницаИзмеренияИнгредиентаИсходныйПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Замены.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПосчитатьВединицахХранения_ЗаменыИсходный();
	
	ЗаменыИсходноеКоличествоЕдиницаПриИзмененииНаСервере(Элементы.Замены.ТекущаяСтрока);
	
КонецПроцедуры

//  Процедура - Замены количество упаковок ингредиента исходный при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗаменыКоличествоУпаковокИнгредиентаИсходныйПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Замены.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПосчитатьВединицахХранения_ЗаменыИсходный();
	
	ЗаменыИсходноеКоличествоЕдиницаПриИзмененииНаСервере(Элементы.Замены.ТекущаяСтрока);
	
КонецПроцедуры

//  Процедура - Замены перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ЗаменыПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Замены.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.КоличествоУпаковокИнгредиентаИсходный = 0;
	
	ЗаменыИсходноеКоличествоЕдиницаПриИзмененииНаСервере(Элементы.Замены.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

//  Процедура - Товары количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
		// Обработаем событие в контексте сервера
	ПосчитатьКоличестваВединицахХранения();
	ПересчитатьСуммуВТаблицеТоваров();
КонецПроцедуры

//  Процедура - Товары номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
		// Обработаем событие в контексте сервера
	ДанныеСтрокаТаблицы = Новый Структура("Ссылка, Номенклатура, Характеристика, Назначение, НазначениеИнгредиентов, ЭтоУслуга, ЭтоБлюдо, Иконка, Рецептура, ИзмененФактБлюда, РецептураПред");
	ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, Элементы.Товары.ТекущиеДанные);
	
	ПараметрыОбъекта = Новый Структура();
	
	ПараметрыОбъекта = Новый Структура("ХозяйственнаяОперация, Организация, Дата, Ссылка, Подразделение");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, ЭтаФорма);
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
	// ПараметрыОбъекта.Вставить("СпособРасчетаРецептуры", СпособРасчетаРецептуры); /// В плане-меню не надо.
	
	ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
	
	ЗаполнитьЗначенияСвойств(Элементы.Товары.ТекущиеДанные, ДанныеСтрокаТаблицы);
	
	ТаблицаНоменклатураПриИзменении("Товары");
	
КонецПроцедуры

//  Процедура - Товары назначение при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНазначениеПриИзменении(Элемент)
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекДанные.НазначениеИнгредиентов) Тогда
		ТекДанные.НазначениеИнгредиентов = ТекДанные.Назначение;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Товары единица измерения при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыЕдиницаИзмеренияПриИзменении(Элемент)
	
	ПосчитатьКоличестваВединицахХранения();
	
КонецПроцедуры

//  Процедура - Блюда при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура БлюдаПриАктивизацииСтроки(Элемент)
	ОбновитьОтборСтрокВТаблицеИнгредиентов();
КонецПроцедуры

//  Процедура - Выпущенная продукция замены при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ВыпущеннаяПродукцияЗаменыПриАктивизацииСтроки(Элемент)
	
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы=Неопределено Тогда
		Элементы.Замены.ОтборСтрок = Неопределено;
		Возврат;
	КонецЕсли;
	Элементы.Замены.ОтборСтрок = Новый ФиксированнаяСтруктура("Блюдо, ХарактеристикаБлюда, Рецептура, Автопередел",
			СтрокаТаблицы.Номенклатура,СтрокаТаблицы.Характеристика,СтрокаТаблицы.Рецептура, СтрокаТаблицы.Автопередел);
	
	
КонецПроцедуры

//  Процедура - Замены количество упаковок ингредиента замена при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗаменыКоличествоУпаковокИнгредиентаЗаменаПриИзменении(Элемент)
	
	ПосчитатьВединицахХранения_ИнгредиентЗаменаФакт();
	
КонецПроцедуры

//  Процедура - Замены при начале редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  Копирование - Произвольный - Копирование.
//
&НаКлиенте
Процедура ЗаменыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекСтрокаБлюда = Элементы.ВыпущеннаяПродукцияЗамены.текущиеДанные;
		
		НовСтрокаЗамены = Элементы.Замены.ТекущиеДанные;
		НовСтрокаЗамены.Блюдо = ТекСтрокаБлюда.Номенклатура;
		НовСтрокаЗамены.Характеристика = ТекСтрокаБлюда.Характеристика;
		НовСтрокаЗамены.Рецептура = ТекСтрокаБлюда.Рецептура;
		НовСтрокаЗамены.Автопередел = ТекСтрокаБлюда.Автопередел;
	КонецЕсли;
	 
КонецПроцедуры

//  Процедура - Замены перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//  Параметр - Произвольный - Параметр.
//
&НаКлиенте
Процедура ЗаменыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекСтрокаБлюда = Элементы.ВыпущеннаяПродукцияЗамены.текущиеДанные;
	Отказ = ТекСтрокаБлюда = Неопределено;
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

//  Процедура - Подразделение при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	ПодразделениеПриИзмененииНаСервере();
	
	// Побочные изделия
	Для каждого ТекИзделие Из Объект.ПобочныеИзделия Цикл
		ТекИзделие.Подразделение = Объект.Подразделение;
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Тип цен при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТипЦенПриИзменении(Элемент)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаИзменениеТипаЦен", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Пересчитать цены в табличной части ""Товары""?';"
	+ " en = 'Do you want to continue?'"), Режим, 0);
	
КонецПроцедуры

//  Процедура - Тип цен продажи при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТипЦенПродажиПриИзменении(Элемент)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаИзменениеТипаЦенПродажи", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Пересчитать цены в табличной части ""Товары""?';"
	+ " en = 'Do you want to continue?'"), Режим, 0);
	
КонецПроцедуры

//  Процедура - Товары цена при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	ПересчитатьСуммуВТаблицеТоваров();
	ТоварыПересчитатьПлановуюМаржинальностьВТекущейСтроке();
КонецПроцедуры

//  Процедура - Товары цена продажи при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыЦенаПродажиПриИзменении(Элемент)
	ПересчитатьСуммуПродажиВТаблицеТоваров();
	ТоварыПересчитатьПлановуюМаржинальностьВТекущейСтроке();
КонецПроцедуры

//  Процедура - Товары сумма при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	ТоварыПересчитатьЦенуВТекущейСтрокеСуффикс();
	ТоварыПересчитатьПлановуюМаржинальностьВТекущейСтроке();
КонецПроцедуры

//  Процедура - Товары сумма продажи при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыСуммаПродажиПриИзменении(Элемент)
	ТоварыПересчитатьЦенуВТекущейСтрокеСуффикс("Продажи");
	ТоварыПересчитатьПлановуюМаржинальностьВТекущейСтроке();
КонецПроцедуры

//  Процедура - Блюда номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура БлюдаНоменклатураПриИзменении(Элемент)
	ТаблицаНоменклатураПриИзменении("Блюда");
КонецПроцедуры

//  Процедура - Ингредиенты ингредиент при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ИнгредиентыИнгредиентПриИзменении(Элемент)
	ТаблицаНоменклатураПриИзменении("Ингредиенты");
КонецПроцедуры

//  Процедура - Замены ингредиент замена при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗаменыИнгредиентЗаменаПриИзменении(Элемент)
	ТаблицаНоменклатураПриИзменении("Замены");
КонецПроцедуры

//  Процедура - Выпущенная продукция замены выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ВыпущеннаяПродукцияЗаменыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.Блюда1Рецептура Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Рецептура);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Блюда трудозатраты выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура БлюдаТрудозатратыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.БлюдаТрудозатратыРецептура Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Рецептура);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Блюда побочные изделия выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура БлюдаПобочныеИзделияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.БлюдаПобочныеИзделияРецептура Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.Рецептура);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Ингредиенты выбор.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбраннаяСтрока - Строка - Выбранная строка.
//  Поле - Произвольный - Поле.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ИнгредиентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено
		И Элемент.ТекущийЭлемент = Элементы.ИнгредиентыРецептураАвтопередела Тогда
		
		СтандартнаяОбработка = Ложь;
		Попытка
			ПоказатьЗначение(, ТекДанные.РецептураАвтопередела);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Статус при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	Если Объект.Статус <> ПредыдущийСтатус И ЗначениеЗаполнено(Объект.Ссылка) И ЕстьСвязанныеВыпускиБлюд(Объект.Ссылка) Тогда
		Оповещение = Новый ОписаниеОповещения("СтатусПриИзмененииЗавершение", ЭтотОбъект, Новый Структура());
		ПоказатьВопрос(Оповещение, "Для текущего плана-меню уже созданы документы ""Выпуск блюд"", продолжить изменение статуса?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ПредыдущийСтатус = Объект.Статус;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Цеховая кладовая при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЦеховаяКладоваяПриИзменении(Элемент)
	УстановитьДоступностьПодразделение(Истина);
	НастроитьЗависимыеЭлементыФормы(ЭтаФорма);
КонецПроцедуры

//  Процедура - Склад реализации при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СкладРеализацииПриИзменении(Элемент)
	НастроитьЗависимыеЭлементыФормы(ЭтаФорма);
КонецПроцедуры

//  Процедура - Склад компании при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СкладКомпанииПриИзменении(Элемент)
	НастроитьЗависимыеЭлементыФормы(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область ИзменениеФактаВПроизводстве

//  Процедура - Только измененные.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТолькоИзмененные(Команда)
	Элементы.ИнгредиентыТолькоИзмененные.Пометка = НЕ Элементы.ИнгредиентыТолькоИзмененные.Пометка;
	ОбновитьОтборСтрокВТаблицеИнгредиентов();
КонецПроцедуры

//  Процедура - Уточнить характеристики.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура УточнитьХарактеристики(Команда)
	
	Если НЕ НайденыОшибкиАвтовыбора Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения, "Уточнение характеристик не требуется");
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("АдресУточненияАвтовыбора"	, УпаковатьУточненияАвтовыбора());
	СтруктураПараметров.Вставить("Ссылка"					, Объект.Ссылка);
	СтруктураПараметров.Вставить("Организация"				, Объект.Организация);
	СтруктураПараметров.Вставить("Подразделение"			, Объект.Подразделение);
	СтруктураПараметров.Вставить("Дата"						, Объект.Дата);
	СтруктураПараметров.Вставить("ЦеховаяКладовая"			, Объект.ЦеховаяКладовая);
	СтруктураПараметров.Вставить("ВидПроизводства"			, Объект.ВидПроизводства);
	
	ОткрытьФорму("ОбщаяФорма.питФормаПодбораХарактеристик", СтруктураПараметров, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ПерепланированиеПроизводства
// +ПерепланированиеПроизводства

