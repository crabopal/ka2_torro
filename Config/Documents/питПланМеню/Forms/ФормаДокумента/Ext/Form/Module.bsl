//  Процедура - Товары пересчитать цену в текущей строке суффикс.
//
// Параметры:
//  Суффикс - Строка - Суффикс.
//
&НаКлиенте
Процедура ТоварыПересчитатьЦенуВТекущейСтрокеСуффикс(Суффикс = "")
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		ТекДанные["Цена" + Суффикс] = ТекДанные["Сумма" + Суффикс] / ТекДанные.КоличествоУпаковок;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Товары пересчитать плановую маржинальность в текущей строке.
//
&НаКлиенте
Процедура ТоварыПересчитатьПлановуюМаржинальностьВТекущейСтроке()
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		ТекДанные["ПлановаяМаржинальнаяПрибыльУбыток"] = ТекДанные["СуммаПродажи"] - ТекДанные["Сумма"];
	КонецЕсли;
КонецПроцедуры

//  Процедура - Товары пересчитать плановую маржинальность клиент.
//
&НаКлиенте
Процедура ТоварыПересчитатьПлановуюМаржинальностьКлиент()
	Для каждого ТекДанные Из Объект.Товары Цикл
		ТекДанные["ПлановаяМаржинальнаяПрибыльУбыток"] = ТекДанные["СуммаПродажи"] - ТекДанные["Сумма"];
	КонецЦикла;
КонецПроцедуры

//  Процедура - Заполнить представления связанных выпусков блюд.
//
&НаСервере
Процедура ЗаполнитьПредставленияСвязанныхВыпусковБлюд()
	ПредставленияВыпусковБлюд.Очистить();
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		РезультатЗапроса = Документы.питВыпускБлюд.РезультатЗапросаСвязанныеВыпускиБлюд(Объект.Ссылка);
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				НовСтрокаПредставление = ПредставленияВыпусковБлюд.Добавить();
				НовСтрокаПредставление.ВыпускБлюд = ВыборкаДетальныеЗаписи.ВыпускБлюд;
				НовСтрокаПредставление.Представление = ВыборкаДетальныеЗаписи.Представление;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//  Функция - Есть связанные выпуски блюд.
//
// Параметры:
//  ПланМеню - Произвольный - План меню.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ЕстьСвязанныеВыпускиБлюд(ПланМеню)
	
	Возврат НЕ Документы.питВыпускБлюд.РезультатЗапросаСвязанныеВыпускиБлюд(ПланМеню).Пустой();
	
КонецФункции

//  Процедура - Установить доступность подразделение.
//
// Параметры:
//  УстановитьНовоеПодразделение - Произвольный - Установить новое подразделение.
//
&НаСервере
Процедура УстановитьДоступностьПодразделение(УстановитьНовоеПодразделение = Ложь)
	Если ЗначениеЗаполнено(Объект.ЦеховаяКладовая) Тогда
		РеквизитыСклада = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ЦеховаяКладовая, "ЦеховаяКладовая, Подразделение");
		Элементы.Подразделение.Доступность = НЕ РеквизитыСклада.ЦеховаяКладовая;
		Если РеквизитыСклада.ЦеховаяКладовая И УстановитьНовоеПодразделение Тогда
			Объект.Подразделение = РеквизитыСклада.Подразделение;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти



