//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ТоварыСортироватьПоПриоритету(Команда)
	ТоварыСортироватьПоПриоритетуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область КопированиеВставкаСтрок

//  Процедура - Скопировать строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СкопироватьСтроки(Команда)
	
	ИмяТаблицы = ПолучитьИмяТекущейТабличнойЧасти();
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрок = Элементы[ИмяТаблицы].ВыделенныеСтроки.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СкопироватьСтрокиНаСервере(ИмяТаблицы);
	
	РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОКопированииСтрок(КоличествоСтрок);
	
КонецПроцедуры

//  Процедура - Вставить строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВставитьСтроки(Команда)
	
	ИмяТаблицы = ПолучитьИмяТекущейТабличнойЧасти();
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	КоличествоТоваровДоВставки = Объект[ИмяТаблицы].Количество();
	ПолучитьСтрокиИзБуфераОбмена(ИмяТаблицы);
	КоличествоСтрок = Объект.Товары.Количество()-КоличествоТоваровДоВставки;
	РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОВставкеСтрок(КоличествоСтрок);
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Производство заполнить по нормативам.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПроизводствоЗаполнитьПоНормативам(Команда)
	
	// +АвтовыборНоменклатуры
	Объект.УточненияАвтовыбора.Очистить();
	// +АвтовыборНоменклатуры
	
	ЗаполнитьПоНормативам();
	УправлениеФормойТрудозатраты(Объект, Элементы);
	
	// Перезаполнили производство, взводим флаг модифицированности формы.
	Модифицированность = Истина;
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Очистить производство.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ОчиститьПроизводство(Команда)
	
	Объект.Блюда.Очистить();
	Объект.Ингредиенты.Очистить();
	Объект.Замены.Очистить();
	Объект.Трудозатраты.Очистить();
	Объект.ПобочныеИзделия.Очистить();
	// +АвтовыборНоменклатуры
	Объект.УточненияАвтовыбора.Очистить();
	// -АвтовыборНоменклатуры
	Модифицированность = Истина;
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

//  Процедура - Перейти к меню.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПерейтиКМеню(Команда)
	СписокВидовМеню = ПолучитьСписокМенюНаСервере();
	СписокВидовМеню.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ПерейтиКМеню_Завершение", ЭтотОбъект),"Выберите вид меню");
КонецПроцедуры

