//  Функция - Получить параметры подбора.
//
// Параметры:
//  ИмяТаблицы - Строка - Имя таблицы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучитьПараметрыПодбора(ИмяТаблицы = "Товары")
	
	ПараметрыФормы = Новый Структура;
	
	// +ИзменениеФактаВПроизводстве
	Если ИмяТаблицы = "Товары" Тогда
		ПараметрЗаголовок = НСтр("ru = 'Подбор товаров в %Документ%'");
	ИначеЕсли ИмяТаблицы = "Ингредиенты" Тогда
		ПараметрЗаголовок = НСтр("ru = 'Подбор ингредиентов в %Документ%'");
	КонецЕсли;
	// -ИзменениеФактаВПроизводстве
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", Объект.Ссылка);
	Иначе
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", НСтр("ru = 'выпуск блюд'"));
	КонецЕсли;
	
	ОтборТипЦен = ?(ЗначениеЗаполнено(Объект.ТипЦен),Объект.ТипЦен, питОбщегоНазначения.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит"));
	ОтборЦенаВключаетНДС = ?(ЗначениеЗаполнено(Объект.ТипЦен),питОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборТипЦен,"ЦенаВключаетНДС"), Истина);
	
	ПараметрыФормы.Вставить("Заголовок",										ПараметрЗаголовок);
	ПараметрыФормы.Вставить("Дата",												Объект.ДатаПлан);
	ПараметрыФормы.Вставить("Склад",											Объект.Склад);
	ПараметрыФормы.Вставить("Организация",										Объект.Организация);
	ПараметрыФормы.Вставить("Валюта",											?(ЗначениеЗаполнено(Объект.Валюта),Объект.Валюта,питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета()));
	ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти",	Ложь);
	ПараметрыФормы.Вставить("Документ",											Объект.Ссылка);
	ПараметрыФормы.Вставить("ВидЦены",											ОтборТипЦен);
	ПараметрыФормы.Вставить("ЦенаВключаетНДС",									ОтборЦенаВключаетНДС);
	ПараметрыФормы.Вставить("РежимПодбораБезСоглашенийСКлиентами",				Истина);
	
	Возврат ПараметрыФормы;
	
КонецФункции

//  Функция - Заполнить цены по виду цен сервер.
//
// Параметры:
//  ВидЦен - Произвольный - Вид цен.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЗаполнитьЦеныПоВидуЦенСервер(ВидЦен)
	
	ЦеныРассчитаны = Ложь;
	
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат ЦеныРассчитаны;
	КонецЕсли;
	
	Если ИспользоватьПлановуюСтоимость Тогда
		Валюта = Константы.ВалютаПлановойСебестоимостиПродукции.Получить();
	Иначе
		Валюта = Константы.ВалютаУправленческогоУчета.Получить();
	КонецЕсли;
	ЦеныРассчитаны = ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(
		Объект.Товары,
		, // Массив строк или структура отбора
		Новый Структура( // Параметры заполнения
			"Дата, Валюта, ВидЦены",
			Объект.Дата,
			Валюта,
			ВидЦен),
		Новый Структура( // Структура действий с измененными строками
			"ПересчитатьСумму",
			"КоличествоУпаковок"));
	
	Возврат ЦеныРассчитаны;
	
КонецФункции

//  Функция - Заполнить цены продажи сервер.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ЗаполнитьЦеныПродажиСервер()
	
	Для каждого ТекСтрокаТовары Из Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрокаТовары.ИдентификаторСтроки) Тогда
			ТекСтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	ВыгрузкаТовары = Объект.Товары.Выгрузить();
	
	ЦеныРассчитаны = Ложь;
	
	Если ВыгрузкаТовары.Количество() = 0 Тогда
		Возврат ЦеныРассчитаны;
	КонецЕсли;
	
	Если ИспользоватьПлановуюСтоимость Тогда
		Валюта = Константы.ВалютаПлановойСебестоимостиПродукции.Получить();
	Иначе
		Валюта = Константы.ВалютаУправленческогоУчета.Получить();
	КонецЕсли;
	ЦеныРассчитаны = ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(
		ВыгрузкаТовары,
		, // Массив строк или структура отбора
		Новый Структура( // Параметры заполнения
			"Дата, Валюта, ВидЦены",
			Объект.Дата,
			Валюта,
			Объект.ТипЦенПродажи),
		Новый Структура( // Структура действий с измененными строками
			"ПересчитатьСумму",
			"КоличествоУпаковок"));
		
	СП = Новый Структура("ИдентификаторСтроки");
	Для каждого ТекСтрокаВыгрузка Из ВыгрузкаТовары Цикл
		СП.ИдентификаторСтроки = ТекСтрокаВыгрузка.ИдентификаторСтроки;
		НайденныеТовары = Объект.Товары.НайтиСтроки(СП);
		Если НайденныеТовары.Количество() Тогда
			НайденныйТовар = НайденныеТовары[0];
			НайденныйТовар.ЦенаПродажи = ТекСтрокаВыгрузка.Цена;
			НайденныйТовар.СуммаПродажи = ТекСтрокаВыгрузка.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЦеныРассчитаны;
	
КонецФункции

//  Процедура - Пересчитать сумму в таблице товаров.
//
&НаКлиенте
Процедура ПересчитатьСуммуВТаблицеТоваров()
	
	Перем КэшированныеЗначения, СтруктураДействий, ТекущаяСтрока;
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		
		КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		
		ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");
		
	КонецЕсли;
	
КонецПроцедуры

