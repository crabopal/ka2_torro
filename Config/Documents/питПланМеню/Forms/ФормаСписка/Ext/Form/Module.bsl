#Область СлужебныеПроцедурыИФункции

//  Процедура - Список при обновлении состава пользовательских настроек на сервере.
//
// Параметры:
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура СписокПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Элементы.Список.СоздатьЭлементыФормыПользовательскихНастроек(Элементы.ГруппаБыстрыеОтборы,,3);
КонецПроцедуры

//  Процедура - Подключаемый обновить команды.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры

//  Процедура - Заполнить представления связанных выпусков блюд.
//
// Параметры:
//  ВыделенныеСсылки - Произвольный - Выделенные ссылки.
//
&НаСервере
Процедура ЗаполнитьПредставленияСвязанныхВыпусковБлюд(ВыделенныеСсылки)
	ПредставленияВыпусковБлюд.Очистить();
	
	Для каждого ВыделеннаяСсылка Из ВыделенныеСсылки Цикл
		
		Если ЗначениеЗаполнено(ВыделеннаяСсылка) Тогда
		РезультатЗапроса = Документы.питВыпускБлюд.РезультатЗапросаСвязанныеВыпускиБлюд(ВыделеннаяСсылка);
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				НовСтрокаПредставление = ПредставленияВыпусковБлюд.Добавить();
				НовСтрокаПредставление.ВыпускБлюд = ВыборкаДетальныеЗаписи.ВыпускБлюд;
				НовСтрокаПредставление.Представление = ВыборкаДетальныеЗаписи.Представление;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти




