#Область ПрограммныйИнтерфейс

//  Процедура - Подключаемый выполнить команду на сервере.
//
// Параметры:
//  Контекст - Произвольный - Контекст.
//  Результат - Произвольный - Результат.
//
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

//  Процедура - Установить статус к обеспечению завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура УстановитьСтатусКОбеспечениюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ВыделенныеСсылки = ДополнительныеПараметры.ВыделенныеСсылки;
	
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОчиститьСообщения();
	КоличествоОбработанных = ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(ВыделенныеСсылки, "КОбеспечению");
	ОбщегоНазначенияУТКлиент.ОповеститьПользователяОбУстановкеСтатуса(Элементы.Список, КоличествоОбработанных, ВыделенныеСсылки.Количество(), "К обеспечению");
	
	ЗаполнитьПредставленияСвязанныхВыпусковБлюд(ВыделенныеСсылки);
	Для каждого ВыборкаДетальныеЗаписи Из ПредставленияВыпусковБлюд Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Обратите внимание, что после смены статуса
		|необходимо перепровести связанный документ <"+ВыборкаДетальныеЗаписи.Представление+">";
		Сообщение.КлючДанных = ВыборкаДетальныеЗаписи.ВыпускБлюд;
		Сообщение.ИдентификаторНазначения = ЭтаФорма.УникальныйИдентификатор;
		Сообщение.Сообщить();
	КонецЦикла;
	
КонецПроцедуры

