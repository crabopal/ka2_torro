&НаКлиенте
Процедура ЗаменителиПриИзменении(Элемент)
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	НоменклатураПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаменителиНоменклатураПриИзменении(Элемент)
	ТаблицаНоменклатураПриИзменении("Заменители");
КонецПроцедуры

&НаКлиенте
Процедура ЗаменителиПередУдалением(Элемент, Отказ)
	ТекДанные = Элементы.Заменители.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		Если ЗначениеЗаполнено(ТекДанные.ИсточникОбратимости) Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаменителиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено 
		И НЕ Элемент.ТекущийЭлемент = Неопределено Тогда
		
		ДанныеПоказать = "";
		Если Элемент.ТекущийЭлемент = Элементы.ЗаменителиИсточникОбратимости Тогда
			ДанныеПоказать = "ИсточникОбратимости";
		ИначеЕсли Элемент.ТекущийЭлемент = Элементы.ЗаменителиНоменклатура Тогда
			ДанныеПоказать = "Номенклатура";
		ИначеЕсли Элемент.ТекущийЭлемент = Элементы.ЗаменителиХарактеристика Тогда
			ДанныеПоказать = "Характеристика";
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(ДанныеПоказать) Тогда
			СтандартнаяОбработка = Ложь;
			Если ЗначениеЗаполнено(ТекДанные[ДанныеПоказать]) Тогда
				Попытка
					ПоказатьЗначение(, ТекДанные[ДанныеПоказать]);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

