#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Процедура - Заполнить движения
//
// Параметры:
//  ДвиженияЗаменыИнгредиентов - Произвольный - Движения зЗамены ингредиентов.
//
Процедура ЗаполнитьДвижения(ДвиженияЗаменыИнгредиентов) Экспорт
	
	// регистр питЗаменыИнгредиентов
	ДвиженияЗаменыИнгредиентов.Записывать = Истина;
	
	// Получение всех подразделений, включая подчиненные.
	ВсеПодразделения = питПроизводство.НайтиПодразделенияПоРазрешенным(Подразделения.Выгрузить());
	
	// Заполнение коллекции движений.
	Для каждого ТекущееПодразделение Из ВсеПодразделения Цикл
		Для Каждого ТекСтрокаЗаменители Из Заменители Цикл
			Движение = ДвиженияЗаменыИнгредиентов.Добавить();
			Движение.Период							= ДатаНачалаДействия;
			Движение.Подразделение					= ТекущееПодразделение;
			Движение.Заменяемое						= Номенклатура;
			Движение.ЗаменяемоеХарактеристика		= Характеристика;
			Движение.Заменитель						= ТекСтрокаЗаменители.Номенклатура;
			Движение.ЗаменительХарактеристика		= ТекСтрокаЗаменители.Характеристика;
			Движение.Коэффициент					= ТекСтрокаЗаменители.Коэффициент;
			Движение.Приоритет						= ТекСтрокаЗаменители.Приоритет;
			Движение.ДатаОкончания					= ДатаОкончанияДействия;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

//  Процедура - Обработка проведения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Если обмен данными, то ничего не делаем.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДвижения(Движения.питЗаменыИнгредиентов);
	
КонецПроцедуры

//  Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Ссылка.Пустая() ИЛИ НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ПометкаУдаления") Тогда
		ДополнительныеСвойства.Вставить("питРазрешитьЗаписьТиповогоДокумента",Истина);
	КонецЕсли;
	
	Для Каждого ТекСтрокаЗаменитель Из Заменители Цикл
		ТекСтрокаЗаменитель.Приоритет = ТекСтрокаЗаменитель.НомерСтроки;
	КонецЦикла;
	
	Отказ = НЕ Документы.питРегистрацияЗамен.ПроверитьЗаменителиНаДубли(ЭтотОбъект);
	
КонецПроцедуры

//  Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Добавить("Подразделения");
	ПроверяемыеРеквизиты.Добавить("Заменители");
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	// Проверка заполнения характеристик в шапке.
	Если НЕ питОбщегоНазначения.ХарактеристикиИспользуются(Номенклатура) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Характеристика");
	КонецЕсли;
	
	// Проверка заполнения характеристик в таблице заменителей.
	ПараметрыПроверкиХарактеристик = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "Заменители";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

#КонецОбласти
#КонецЕсли


