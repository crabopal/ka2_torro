//  Функция - Проверить заменители на дубли.
//
// Параметры:
//  ДокументОбъект - Произвольный - Документ объект.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПроверитьЗаменителиНаДубли(ДокументОбъект) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДанныеФормыСтруктура") Тогда
		Документ = ДанныеФормыВЗначение(ДокументОбъект, Тип("ДокументОбъект.питРегистрацияЗамен")); // Преобразования данных формы в объект
		УстановитьСоответствиеОбъектаИРеквизитаФормы(Документ, "Объект"); // Установка соответствия
	Иначе
		Документ = ДокументОбъект;
	КонецЕсли;
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питТЧ.НомерСтроки,
	|	питТЧ.Номенклатура,
	|	питТЧ.Характеристика
	|ПОМЕСТИТЬ втТовары
	|ИЗ
	|	&втТовары КАК питТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питТЧ.Номенклатура,
	|	питТЧ.Характеристика,
	|	МИНИМУМ(питТЧ.НомерСтроки) КАК НомерСтроки,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ втРезультат
	|ИЗ
	|	втТовары КАК питТЧ
	|
	|СГРУППИРОВАТЬ ПО
	|	питТЧ.Номенклатура,
	|	питТЧ.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втРезультат.Номенклатура,
	|	втРезультат.Характеристика,
	|	втРезультат.НомерСтроки,
	|	втРезультат.Количество
	|ИЗ
	|	втРезультат КАК втРезультат
	|";
	
	Запрос.УстановитьПараметр("втТовары", ДокументОбъект.Заменители.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.Количество > 1 Тогда
				Результат = Ложь;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Дубли в строке <"+ВыборкаДетальныеЗаписи.НомерСтроки+"> по реквизитам Номенклатура, Характеристика!";
				Сообщение.УстановитьДанные(Документ);
				Сообщение.Поле = "Заменители[" + (ВыборкаДетальныеЗаписи.НомерСтроки - 1) + "].Номенклатура";
				Сообщение.Сообщить();
				Возврат Результат;
			ИначеЕсли ДокументОбъект.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура 
				И ДокументОбъект.Характеристика = ВыборкаДетальныеЗаписи.Характеристика Тогда
				Результат = Ложь;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Номенклатура в строке <"+ВыборкаДетальныеЗаписи.НомерСтроки+"> совпадает с номенклатурой из шапки документа!";
				Сообщение.УстановитьДанные(Документ);
				Сообщение.Поле = "Заменители[" + (ВыборкаДетальныеЗаписи.НомерСтроки - 1) + "].Номенклатура";
				Сообщение.Сообщить();
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти




