#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Функция - Обработать данные штрихкода
//
// Параметры:
//  Форма					 - ФормаКлиентскогоПриложения	 - форма документа
//  ДанныеШтрихкода			 - Структура	- Данные Штрихкода
//  ПараметрыСканирования	 - Структура	- Параметры Сканирования
//  ВложенныеШтрихкоды		 - Структура	- Вложенные Штрихкоды
// 
// Возвращаемое значение:
//  Структура - Обработанные данные штрихкода
//
Функция ОбработатьДанныеШтрихкода(Форма, ДанныеШтрихкода, ПараметрыСканирования, ВложенныеШтрихкоды = Неопределено) Экспорт
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ГосИС") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//Если ШтрихкодированиеИСКлиентСервер.ЭтоУпаковка(ДанныеШтрихкода.ТипУпаковки) Тогда
	//	
	//	Возврат ОбработатьДанныеШтрихкодаУпаковки(Форма, ДанныеШтрихкода, ВложенныеШтрихкоды, ПараметрыСканирования);
	//	
	Если ДанныеШтрихкода.ТипУпаковки = Перечисления.ТипыУпаковок.МаркированныйТовар Тогда
		
		Возврат ОбработатьДанныеШтрихкодаМаркируемойПродукции(Форма, ДанныеШтрихкода, ПараметрыСканирования);
		
	//ИначеЕсли ДанныеШтрихкода.ТипШтрихкода = Перечисления.ТипыШтрихкодов.DataMatrix Тогда
	//	
	//	Возврат ОбработатьДанныеШтрихкодаСНомеромИСерией(Форма, ДанныеШтрихкода, ПараметрыСканирования);
	//
	Иначе
	    Если СтрДлина(ДанныеШтрихкода.Штрихкод)<15 Тогда
			Возврат ОбработатьДанныеШтрихкодаЕАН(Форма, ДанныеШтрихкода, ПараметрыСканирования);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Функция предназначена для обработки считанного штрихкода акцизной марки старого (PDF417) и нового (Data Matrix) образцов
//
// Параметры:
//  Форма					 - ФормаКлиентскогоПриложения	- форма документа
//  ДанныеШтрихкода			 - Структура	- Данные Штрихкода
//  ПараметрыСканирования	 - Структура	- Параметры Сканирования
// 
// Возвращаемое значение:
//  Структура - Обработанные данные штрихкода маркируемой продукции
//
Функция ОбработатьДанныеШтрихкодаМаркируемойПродукции(Форма, ДанныеШтрихкода, ПараметрыСканирования) Экспорт
	
	МодульШтрихкодированиеОбщегоНазначенияИС = ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИС");
	Результат = МодульШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьРезультатОбработкиШтрихкода(ПараметрыСканирования, ДанныеШтрихкода);
	
	МодульАкцизныеМаркиЕГАИС = ОбщегоНазначения.ОбщийМодуль("АкцизныеМаркиЕГАИС");
	ПараметрыЗаполнения = МодульАкцизныеМаркиЕГАИС.ПараметрыЗаполненияТоваровИАкцизныхМарок(Форма, Истина, ПараметрыСканирования);
	Если Форма.Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока <> Неопределено Тогда
		ПараметрыЗаполнения.ТекущаяСтрока = Форма.Объект.ОстаткиПоДаннымЕГАИС.НайтиПоИдентификатору(Форма.Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока);
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Номенклатура",   ДанныеШтрихкода.Номенклатура);
	ПараметрыОтбора.Вставить("АлкогольнаяПродукция",   ДанныеШтрихкода.АлкогольнаяПродукция);
	ПараметрыОтбора.Вставить("Справка2",   ДанныеШтрихкода.Справка2);
	
	МНайдСтрок = Форма.Объект.ОстаткиПоДаннымЕГАИС.НайтиСтроки(ПараметрыОтбора);
	
	Если МНайдСтрок.Количество() = 0 Тогда
		СтрокаТЧ = Форма.Объект.ОстаткиПоДаннымЕГАИС.Добавить();
		СтрокаТЧ.Номенклатура         = ДанныеШтрихкода.Номенклатура;
		
		СтрокаТЧ.АлкогольнаяПродукция = ДанныеШтрихкода.АлкогольнаяПродукция;
		СтрокаТЧ.Справка2             = ДанныеШтрихкода.Справка2;
		СтрокаТЧ.КоличествоФакт		  = 1;
		СтрокаТЧ.ИдентификаторСтроки  = СтрокаТЧ.ПолучитьИдентификатор();
		ПараметрыЗаполнения.ДобавленныеСтроки.Добавить(СтрокаТЧ);
		ИДСтроки = СтрокаТЧ.ИдентификаторСтроки;
	Иначе
		МНайдСтрок[0].КоличествоФакт   = МНайдСтрок[0].КоличествоФакт + 1;	
		ПараметрыЗаполнения.ИзмененныеСтроки.Добавить(МНайдСтрок[0]);
		ИДСтроки = МНайдСтрок[0].ИдентификаторСтроки;
	КонецЕсли;
			
	Результат.ДобавленныеСтроки = ПараметрыЗаполнения.ДобавленныеСтроки;
	Результат.ИзмененныеСтроки  = ПараметрыЗаполнения.ИзмененныеСтроки;
	
	Если СтрДлина(ДанныеШтрихкода.Штрихкод) > 15 Тогда
		Если (Результат.ДобавленныеСтроки.Количество() > 0) ИЛИ (Результат.ИзмененныеСтроки.Количество() > 0) Тогда
			
			НоваяМарка = Форма.Объект.АкцизныеМарки.Добавить();
			НоваяМарка.КодАкцизнойМарки = ДанныеШтрихкода.Штрихкод;
			НоваяМарка.АкцизнаяМарка = ДанныеШтрихкода.ШтрихкодУпаковки;
			НоваяМарка.ШтрихкодУпаковки = ДанныеШтрихкода.ШтрихкодУпаковки;
			НоваяМарка.Справка2 = ДанныеШтрихкода.Справка2;
			НоваяМарка.Количество = ДанныеШтрихкода.Количество;
			НоваяМарка.ИдентификаторСтроки = ИДСтроки;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Обработать данные штрихкода ЕАН
//
// Параметры:
//  Форма					 - ФормаКлиентскогоПриложения	- форма документа
//  ДанныеШтрихкода			 - Структура	- Данные Штрихкода
//  ПараметрыСканирования	 - Структура	- Параметры Сканирования
// 
// Возвращаемое значение:
//  Структура - Обработанные данные штрихкода ЕАН
//
Функция ОбработатьДанныеШтрихкодаЕАН(Форма, ДанныеШтрихкода, ПараметрыСканирования) Экспорт
	
	МодульШтрихкодированиеОбщегоНазначенияИС = ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИС");
	Результат = МодульШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьРезультатОбработкиШтрихкода(ПараметрыСканирования, ДанныеШтрихкода);
	
	МодульАкцизныеМаркиЕГАИС = ОбщегоНазначения.ОбщийМодуль("АкцизныеМаркиЕГАИС");
	ПараметрыЗаполнения = МодульАкцизныеМаркиЕГАИС.ПараметрыЗаполненияТоваровИАкцизныхМарок(Форма, Истина, ПараметрыСканирования);
	Если Форма.Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока <> Неопределено Тогда
		ПараметрыЗаполнения.ТекущаяСтрока = Форма.Объект.ОстаткиПоДаннымЕГАИС.НайтиПоИдентификатору(Форма.Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока);
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Номенклатура",   ДанныеШтрихкода.Номенклатура);
	ПараметрыОтбора.Вставить("АлкогольнаяПродукция",   ДанныеШтрихкода.АлкогольнаяПродукция);
	//ПараметрыОтбора.Вставить("Справка2",   ДанныеШтрихкода.Справка2);
	
	МНайдСтрок = Форма.Объект.ОстаткиПоДаннымЕГАИС.НайтиСтроки(ПараметрыОтбора);
	
	Если МНайдСтрок.Количество() = 0 Тогда
		СтрокаТЧ = Форма.Объект.ОстаткиПоДаннымЕГАИС.Добавить();
		СтрокаТЧ.Номенклатура         = ДанныеШтрихкода.Номенклатура;
		
		СтрокаТЧ.АлкогольнаяПродукция = ДанныеШтрихкода.АлкогольнаяПродукция;
		//СтрокаТЧ.Справка2             = ДанныеШтрихкода.Справка2;
		СтрокаТЧ.КоличествоФакт		  = 1;
		СтрокаТЧ.ИдентификаторСтроки  = СтрокаТЧ.ПолучитьИдентификатор();
	Иначе
		МНайдСтрок[0].КоличествоФакт   = МНайдСтрок[0].КоличествоФакт + 1;	
	КонецЕсли;
			
	Результат.ДобавленныеСтроки = ПараметрыЗаполнения.ДобавленныеСтроки;
	Результат.ИзмененныеСтроки  = ПараметрыЗаполнения.ИзмененныеСтроки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

