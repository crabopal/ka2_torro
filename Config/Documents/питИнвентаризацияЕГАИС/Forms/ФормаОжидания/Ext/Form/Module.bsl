
#Область ПрограммныйИнтерфейс

//  Процедура - Обработчик ожидания.
//
&НаКлиенте 
Процедура ОбработчикОжидания() Экспорт 
	
	ДанныеОВыполнении = ПолучитьИзВременногоХранилища(АдресХр); 
	
	Если ТипЗнч(ДанныеОВыполнении) = Тип("Структура") Тогда 
		
		Если ДанныеОВыполнении.Инд > ДанныеОВыполнении.КоличествоОбходов Тогда
			Закрыть();
		Иначе
			ПодключитьОбработчикОжидания("ОбработчикОжидания",3,Истина);
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДанныеОВыполнении = ПолучитьИзВременногоХранилища(АдресХр); 
	
	ПодключитьОбработчикОжидания("ОбработчикОжидания",3,Истина);

КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АдресХр = Параметры.АдресХранилища;
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "НовыйАдресХрИнвентаризации" Тогда 
		АдресХр = Параметр;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти




