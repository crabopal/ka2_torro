	               |	ВЫБОР
	               |			КОГДА &ТолькоОтклонения
	               |				ТОГДА ИтоговыеДанные.Отклонение > 0
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	
	ТЗАМОтсканированных = Новый ТаблицаЗначений;
	ТЗАМОтсканированных.Колонки.Добавить("АкцизнаяМаркаЗначение", Новый ОписаниеТипов("Строка", ,,,Новый КвалификаторыСтроки(200)));
	Для каждого СтрокаСЗ Из СписокОтсканированных Цикл
		НСтрокаТЗОтск = ТЗАМОтсканированных.Добавить();
		НСтрокаТЗОтск.АкцизнаяМаркаЗначение = СтрокаСЗ.Значение;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ФактМарки", ТЗАМОтсканированных);
	
	Запрос.УстановитьПараметр("ОтчетыЕГАИС", ОтчетыЕГАИССп);
	СЗСтатусыНаличия = Новый СписокЗначений;
	СЗСтатусыНаличия.Добавить(Перечисления.СтатусыАкцизныхМарок.ВНаличии);
	СЗСтатусыНаличия.Добавить(Перечисления.СтатусыАкцизныхМарок.ВРезерве);
	Запрос.УстановитьПараметр("СтатусыНаличия", СЗСтатусыНаличия);
	СЗСтатусыОтсутствия = Новый СписокЗначений;
	СЗСтатусыОтсутствия.Добавить(Перечисления.СтатусыАкцизныхМарок.Реализована);
	СЗСтатусыОтсутствия.Добавить(Перечисления.СтатусыАкцизныхМарок.Отсутствует);
	Запрос.УстановитьПараметр("СтатусыОтсутствия", СЗСтатусыОтсутствия);
	Запрос.УстановитьПараметр("ТолькоОтклонения", Истина);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", Объект.ОрганизацияЕГАИС);
	
	Запрос.УстановитьПараметр("ТаблицаСАпФормы", Объект.ДанныеДляЗапрос.Выгрузить());
	
	ТаблицаОтклоненийМарок = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьТаблицыКСписаниюКПостановке(ТаблицаОтклоненийМарок, СЗСтатусыНаличия, СЗСтатусыОтсутствия, Истина);
	ЗаполнитьТаблицыКСписаниюКПостановке(ТаблицаОтклоненийМарок, СЗСтатусыНаличия, СЗСтатусыОтсутствия, Ложь);
	
	
КонецПроцедуры



//  Процедура - Заполнить таблицы к списанию к постановке.
//
// Параметры:
//  ТаблицаОтклоненийМарок - ТаблицаЗначений - Таблица отклонений марок.
//  СЗСтатусыНаличия - Произвольный - Сз статусы наличия.
//  СЗСтатусыОтсутствия - Произвольный - Сз статусы отсутствия.
//  ПостановкаНаБаланс - Произвольный - Постановка на баланс.
//
&НаСервере
Процедура ЗаполнитьТаблицыКСписаниюКПостановке(ТаблицаОтклоненийМарок, СЗСтатусыНаличия, СЗСтатусыОтсутствия, ПостановкаНаБаланс)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.НомерСтроки КАК НомерСтроки,
	               |	ТЗ.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	               |	ТЗ.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ТЗ.Справка2 КАК Справка2,
	               |	ТЗ.Дельта КАК Количество
	               |ПОМЕСТИТЬ ВТ_ТЗ
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Отклонения.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	               |	Отклонения.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	Отклонения.Справка2 КАК Справка2,
	               |	Отклонения.АкцизнаяМаркаСсылка КАК АкцизнаяМаркаСсылка,
	               |	Отклонения.АкцизнаяМаркаЗначение КАК АкцизнаяМаркаЗначение,
	               |	Отклонения.Отклонение КАК Отклонение,
	               |	Отклонения.СтатусИБ КАК СтатусИБ,
	               |	Отклонения.СтатусЕГАИС КАК СтатусЕГАИС
	               |ПОМЕСТИТЬ ВТ_Отклонений
	               |ИЗ
	               |	&Отклонения КАК Отклонения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТЗ.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТ_ТЗ.Справка2 КАК Справка2,
	               |	ВТ_ТЗ.Количество КАК Количество
	               |ПОМЕСТИТЬ ОтклоненияБезМарок
	               |ИЗ
	               |	ВТ_ТЗ КАК ВТ_ТЗ
	               |ГДЕ
	               |	ВТ_ТЗ.Количество %ЗнакБольшеМеньше% 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Отклонений.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТ_Отклонений.Справка2 КАК Справка2,
	               |	ВТ_Отклонений.АкцизнаяМаркаСсылка КАК АкцизнаяМаркаСсылка,
	               |	ВТ_Отклонений.АкцизнаяМаркаЗначение КАК АкцизнаяМаркаЗначение
	               |ПОМЕСТИТЬ ОтклоненияСМарками
	               |ИЗ
	               |	ВТ_Отклонений КАК ВТ_Отклонений
	               |ГДЕ
	               |	ВТ_Отклонений.СтатусИБ В(&СтатусыНаличия)   %УсловиеПоМассивуОтсканированных%
	               |	И ВТ_Отклонений.СтатусЕГАИС В(&СтатусыОтсутствия)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтклоненияБезМарок.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ОтклоненияБезМарок.Справка2 КАК Справка2,
	               |	ОтклоненияБезМарок.Количество * %Коэф% КАК Количество,
				   |	ЕСТЬNULL(ОтклоненияСМарками.АкцизнаяМаркаСсылка, ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка)) КАК ШКСсылка,
				   |	ЕСТЬNULL(ОтклоненияСМарками.АкцизнаяМаркаЗначение, """") КАК ЗначениеШК
	               |ПОМЕСТИТЬ Итоговая
	               |ИЗ
	               |	ОтклоненияБезМарок КАК ОтклоненияБезМарок
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ОтклоненияСМарками КАК ОтклоненияСМарками
				   |		ПО ОтклоненияБезМарок.АлкогольнаяПродукция = ОтклоненияСМарками.АлкогольнаяПродукция
				   |			И ОтклоненияБезМарок.Справка2 = ОтклоненияСМарками.Справка2
				   |			И НЕ ОтклоненияБезМарок.Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Итоговая.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	Итоговая.Справка2 КАК Справка2,
	               |	Итоговая.Количество КАК Количество,
	               |	Итоговая.ШКСсылка КАК АкцизнаяМарка, 
	               |	Итоговая.ЗначениеШК КАК АкцизнаяМаркаЗначение 
	               |ИЗ
	               |	Итоговая КАК Итоговая
				   // |ИТОГИ ПО
				   // |	АлкогольнаяПродукция,
				   // |	Справка2,
				   // |	Количество
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_Отклонений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ОтклоненияБезМарок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ОтклоненияСМарками
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ Итоговая";
	
	Если ПостановкаНаБаланс Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ЗнакБольшеМеньше%", ">");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Коэф%", "1");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеПоМассивуОтсканированных%", "");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ЗнакБольшеМеньше%", "<");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Коэф%", "-1");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеПоМассивуОтсканированных%", "И НЕ ВТ_Отклонений.АкцизнаяМаркаЗначение В (&МассивОтсканированных)");
		Запрос.УстановитьПараметр("МассивОтсканированных", СписокОтсканированных.ВыгрузитьЗначения()); 
	КонецЕсли;
	
	ЗАпрос.УстановитьПараметр("ТЗ", Объект.ДанныеДляЗапрос.Выгрузить());
	ЗАпрос.УстановитьПараметр("Отклонения", ТаблицаОтклоненийМарок);
	
	Если ПостановкаНаБаланс Тогда
		Запрос.УстановитьПараметр("СтатусыНаличия", СЗСтатусыНаличия);
		Запрос.УстановитьПараметр("СтатусыОтсутствия", СЗСтатусыОтсутствия);
	Иначе
		Запрос.УстановитьПараметр("СтатусыНаличия", СЗСтатусыОтсутствия);
		Запрос.УстановитьПараметр("СтатусыОтсутствия", СЗСтатусыНаличия);
	КонецЕсли;
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	Если ПостановкаНаБаланс Тогда
		Объект.ПозицииКПостановкеНаБаланс.Загрузить(Выгрузка);
		Выгрузка.Свернуть("АлкогольнаяПродукция, Справка2, Количество");
		Объект.ПозицииКПостановкеНаБалансБезМарок.Загрузить(Выгрузка);
	Иначе
		Объект.ПозицииКСписанию.Загрузить(Выгрузка);
		Выгрузка.Свернуть("АлкогольнаяПродукция, Справка2, Количество");
		Объект.ПозицииКСписаниюБезМарок.Загрузить(Выгрузка);
	КонецЕсли;
	
	
КонецПроцедуры

#КонецОбласти

#Область Штрихкоды

// ШтрихкодированиеИС
//
&НаКлиенте
Процедура Подключаемый_ПослеОбработкиШтрихкодов()
	
	Если ДанныеДляОбработки = Неопределено Тогда
		ДанныеДляОбработки = Новый Структура;
		ДанныеДляОбработки.Вставить("МассивСтрокСАкцизнымиМарками", Новый Массив);
	КонецЕсли;
	
	ШтрихкодированиеИСКлиентПереопределяемый.ПослеОбработкиШтрихкодов(
		ЭтотОбъект,
		ДанныеДляОбработки,
		КэшированныеЗначения);
	
КонецПроцедуры

//  Процедура - Обработать строки тч.
//
// Параметры:
//  ДобавленныеСтроки - Произвольный - Добавленные строки.
//  ИзмененныеСтроки - Произвольный - Измененные строки.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//  РезультатОбработкиШтрихкода - Произвольный - Результат обработки штрихкода.
//
&НаСервере
Процедура ОбработатьСтрокиТЧ(РезультатОбработкиШтрихкода, КэшированныеЗначения)
	
	ДобавленныеСтроки = РезультатОбработкиШтрихкода.ДобавленныеСтроки;
	ИзмененныеСтроки  = РезультатОбработкиШтрихкода.ИзмененныеСтроки;
	
	Для Каждого СтрокаТЧ Из ДобавленныеСтроки Цикл
		
		ПараметрыЗаполнения = ИнтеграцияЕГАИСКлиентСервер.ПараметрыЗаполненияТабличнойЧасти();
		ПараметрыЗаполнения.ПересчитатьКоличествоЕдиниц        = Ложь;
		ПараметрыЗаполнения.МаркируемаяПродукцияВТЧ            = Истина;
		ПараметрыЗаполнения.ЗаполнитьАлкогольнуюПродукцию      = Истина;
		ПараметрыЗаполнения.ПроверитьСериюРассчитатьСтатус     = Истина;
		
		ПараметрыЗаполнения.ЗаполнитьАртикул                   = Истина;
		ПараметрыЗаполнения.ЗаполнитьКод                       = Истина;
		ПараметрыЗаполнения.ОбработатьУпаковки                 = Ложь;
		
		СобытияФормЕГАИСПереопределяемый.ПриИзмененииНоменклатуры(
			ЭтотОбъект, СтрокаТЧ, КэшированныеЗначения,
			ПараметрыЗаполнения, ПараметрыУказанияСерий);
		
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из ИзмененныеСтроки Цикл
		
		ПараметрыЗаполнения = ИнтеграцияЕГАИСКлиентСервер.ПараметрыЗаполненияТабличнойЧасти();
		ПараметрыЗаполнения.ПересчитатьКоличествоУпаковок      = Истина;
		
		СобытияФормЕГАИСПереопределяемый.ПриИзмененииКоличестваУпаковок(
			ЭтотОбъект, СтрокаТЧ, КэшированныеЗначения,
			ПараметрыЗаполнения);
		
	КонецЦикла;
	
	Если ДобавленныеСтроки.Количество() > 0 Тогда
		Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока = ДобавленныеСтроки[ДобавленныеСтроки.Количество() - 1].ПолучитьИдентификатор();
	ИначеЕсли ИзмененныеСтроки.Количество() > 0 Тогда
		Элементы.ОстаткиПоДаннымЕГАИС.ТекущаяСтрока = ИзмененныеСтроки[ИзмененныеСтроки.Количество() - 1].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

//  Функция - После обработки штрихкодов.
//
// Параметры:
//  РезультатОбработкиШтрихкода - Произвольный - Результат обработки штрихкода.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПослеОбработкиШтрихкодов(РезультатОбработкиШтрихкода, КэшированныеЗначения)
	
	Если РезультатОбработкиШтрихкода = Неопределено Тогда
		Возврат РезультатОбработкиШтрихкода;
	КонецЕсли;
	
	Если РезультатОбработкиШтрихкода.ТребуетсяОбработкаШтрихкода Тогда
		
		ПараметрыЗаполнения = ИнтеграцияЕГАИСКлиентСервер.ПараметрыЗаполненияТабличнойЧасти();
		ПараметрыЗаполнения.ПересчитатьКоличествоЕдиниц        = Истина;
		ПараметрыЗаполнения.МаркируемаяПродукцияВТЧ            = Истина;
		ПараметрыЗаполнения.ЗаполнитьАлкогольнуюПродукцию      = Истина;
		МассивВидовПрод = Новый Массив;
		МассивВидовПрод.Добавить(Перечисления.ВидыПродукцииИС.Алкогольная);
		ПараметрыЗаполнения.Вставить("ВидыПродукцииИС", МассивВидовПрод);
		
		Если ТипЗнч(РезультатОбработкиШтрихкода.ИсходныеДанные) = Тип("Структура") Тогда
			ДанныеШтрихкодов = Новый Массив;
			ДанныеШтрихкодов.Добавить(РезультатОбработкиШтрихкода.ИсходныеДанные);
		Иначе
			ДанныеШтрихкодов = РезультатОбработкиШтрихкода.ИсходныеДанные;
		КонецЕсли;
		
		// ШтрихкодированиеИС
		ДанныеДляОбработки = Неопределено;
		ШтрихкодированиеИСПереопределяемый.ПодготовитьДанныеДляОбработкиШтрихкодов(
			ЭтотОбъект, ДанныеШтрихкодов, ПараметрыЗаполнения, ДанныеДляОбработки);
		
		// ШтрихкодированиеИС
		ШтрихкодированиеИСПереопределяемый.ОбработатьШтрихкоды(
			ЭтотОбъект, ДанныеДляОбработки, КэшированныеЗначения);
		
		ИнтеграцияИСПереопределяемый.ЗаполнитьСлужебныеРеквизитыВКоллекции(ЭтотОбъект, Объект.Товары);
		ИнтеграцияИСПереопределяемый.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
		
		АкцизныеМаркиЕГАИС.ЗаполнитьСлужебныеРеквизиты(ЭтотОбъект);
		
	Иначе
		
		ОбработатьСтрокиТЧ(РезультатОбработкиШтрихкода, КэшированныеЗначения);
		
	КонецЕсли;
	
	// НастроитьЭлементыФормы(ЭтотОбъект);
	
	Возврат РезультатОбработкиШтрихкода;
	
КонецФункции

#КонецОбласти

#Область питРаботаСТСД

//  Процедура - Сохранить документ на сервере.
//
&НаСервере
Процедура СохранитьДокументНаСервере()
	ЭтотОбъект.Записать();
КонецПроцедуры

//  Процедура - Документ остатки 2рег при изменении на сервере.
//
&НаСервере
Процедура ДокументОстатки2регПриИзмененииНаСервере()
	
	Если Объект.ДокументОстатки2Рег <> ДокОстаткиРег2_Старое Тогда
		ПересчитыватьШаг2 =  Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОстатки2Рег.ОрганизацияЕГАИС) Тогда
		Объект.ОрганизацияЕГАИС = Объект.ДокументОстатки.ОрганизацияЕГАИС;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить документ остатков по 2 регистру!");
	КонецЕсли;
КонецПроцедуры

//  Функция - Адрес данных марок.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция АдресДанныхМарок()
	
	Прочитать();
	РедактируемыйОбъект = РеквизитФормыВЗначение("Объект");
	ДанныеХранилища = РедактируемыйОбъект.КэшМарок.Получить();
	
	Если ДанныеХранилища = Неопределено Тогда
		Возврат Неопределено
	Иначе
		Возврат ПоместитьВоВременноеХранилище(ДанныеХранилища, ЭтотОбъект.УникальныйИдентификатор);
	КонецЕсли;

КонецФункции 

//  Процедура - пит установить отбор строк марок.
//
&НаКлиенте
Процедура питУстановитьОтборСтрокМарок()
	
	текДанные = Элементы.ОстаткиПоДаннымЕГАИС.ТекущиеДанные;
	
	Если текДанные <> Неопределено Тогда
		ОтборМарок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", текДанные.ИдентификаторСтроки);
		Элементы.АкцизныеМарки.ОтборСтрок = ОтборМарок;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Удалить акцизные марки по ид.
//
// Параметры:
//  Данные - Произвольный - Данные.
//
&НаСервере
Процедура УдалитьАкцизныеМаркиПоИД(Данные)
	
	ИдентификаторыСтрок = Данные;
		
	Для Каждого ИдентификаторСтроки Из ИдентификаторыСтрок Цикл
		
		Отбор = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
		НайденныеСтроки = Объект.АкцизныеМарки.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
			Объект.АкцизныеМарки.Удалить(Объект.АкцизныеМарки.Индекс(СтрокаТЧ));
			НайдЗн = СписокОтсканированных.НайтиПоЗначению(СтрокаТЧ.КодАкцизнойМарки);
			Если НЕ НайдЗн = Неопределено Тогда
				СписокОтсканированных.Удалить(НайдЗн);	
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

//  Процедура - Документ остатки при изменении на сервере.
//
&НаСервере
Процедура ДокументОстаткиПриИзмененииНаСервере()
	
	Если Объект.ДокументОстатки <> ДокОстатки_Старое Тогда
		ПересчитыватьШаг2 =  Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОстатки.ОрганизацияЕГАИС) Тогда
		Объект.ОрганизацияЕГАИС = Объект.ДокументОстатки.ОрганизацияЕГАИС;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить документ остатков!");
	КонецЕсли;
КонецПроцедуры

