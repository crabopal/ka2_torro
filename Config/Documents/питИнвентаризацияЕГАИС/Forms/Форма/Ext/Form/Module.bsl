&НаКлиенте
Функция ОписаниеОповещенияОбработкиКодаМаркировки()
	
	Возврат Новый ОписаниеОповещения("ОбработатьКодМаркировки", ЭтотОбъект);
	
КонецФункции

//  Функция - Параметры завершения ввода штрихкода.
//
// Параметры:
//  ИсходныеДанные - Произвольный - Исходные данные.
//  РезультатОбработки - Произвольный - Результат обработки.
//  ПараметрыСканирования - Произвольный - Параметры сканирования.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПараметрыЗавершенияВводаШтрихкода(ИсходныеДанные, РезультатОбработки, ПараметрыСканирования)
	
	ПараметрыЗавершенияВводаШтрихкода = ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыЗавершенияОбработкиШтрихкода(,,"");
	ПараметрыЗавершенияВводаШтрихкода.РезультатОбработкиШтрихкода  = РезультатОбработки;
	ПараметрыЗавершенияВводаШтрихкода.Форма                        = ЭтотОбъект;
	ПараметрыЗавершенияВводаШтрихкода.ПараметрыСканирования        = ПараметрыСканирования;
	ПараметрыЗавершенияВводаШтрихкода.ДанныеШтрихкода              = ИсходныеДанные;
	
	Возврат ПараметрыЗавершенияВводаШтрихкода;
	
КонецФункции

//  Функция - Обработать ввод штрихкода.
//
// Параметры:
//  ШтрихкодКоличество - Произвольный - Штрихкод количество.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//  ПараметрыСканирования - Произвольный - Параметры сканирования.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ОбработатьВводШтрихкода(ШтрихкодКоличество, КэшированныеЗначения, ПараметрыСканирования = Неопределено)
	
	РезультатОбработкиШтрихкода = ШтрихкодированиеОбщегоНазначенияИС.ОбработатьВводШтрихкода(
		ЭтотОбъект, ШтрихкодКоличество, КэшированныеЗначения, ПараметрыСканирования);
		
	ПослеОбработкиШтрихкодовСервер(РезультатОбработкиШтрихкода, КэшированныеЗначения);
	
	Если РезультатОбработкиШтрихкода = Неопределено Тогда
		Возврат РезультатОбработкиШтрихкода;
	КонецЕсли;
	
	РезультатОбработкиШтрихкода.ИзмененныеСтроки  = Новый Массив;
	РезультатОбработкиШтрихкода.ДобавленныеСтроки = Новый Массив;
	
	Возврат РезультатОбработкиШтрихкода;
	
КонецФункции

//  Функция - Обработка кода маркировки выполнить действие сервер.
//
// Параметры:
//  Действие - Произвольный - Действие.
//  РезультатВыбора - Произвольный - Результат выбора.
//  РезультатОбработкиШтрихкода - Произвольный - Результат обработки штрихкода.
//  ПараметрыСканирования - Произвольный - Параметры сканирования.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ОбработкаКодаМаркировкиВыполнитьДействиеСервер(Действие, РезультатВыбора, РезультатОбработкиШтрихкода, ПараметрыСканирования, КэшированныеЗначения)
	
	ПараметрыОбработкиВыбора    = ШтрихкодированиеОбщегоНазначенияИС.ИнициализироватьПараметрыОбработкиВыбора(РезультатВыбора, РезультатОбработкиШтрихкода, КэшированныеЗначения);
	РезультатОбработкиШтрихкода = ШтрихкодированиеИС.ВыполнитьДействие(ЭтотОбъект, Действие, ПараметрыОбработкиВыбора);
	
	ПослеОбработкиШтрихкодовСервер(РезультатОбработкиШтрихкода, КэшированныеЗначения);
	
	РезультатОбработкиШтрихкода.ИзмененныеСтроки  = Новый Массив;
	РезультатОбработкиШтрихкода.ДобавленныеСтроки = Новый Массив;
	
	Возврат РезультатОбработкиШтрихкода;
	
КонецФункции

//  Процедура - После обработки штрихкодов сервер.
//
// Параметры:
//  РезультатОбработкиШтрихкода - Произвольный - Результат обработки штрихкода.
//  КэшированныеЗначения - Произвольный - Кэшированные значения.
//  ПараметрыСканирования - Произвольный - Параметры сканирования.
//
&НаСервере
Процедура ПослеОбработкиШтрихкодовСервер(РезультатОбработкиШтрихкода, КэшированныеЗначения)
	
	Если Не РезультатОбработкиШтрихкода.ТребуетсяОбработкаШтрихкода Тогда
		
		ОбработатьСтрокиТЧ(РезультатОбработкиШтрихкода, КэшированныеЗначения);
		
	КонецЕсли;
	
КонецПроцедуры

// @skip-warning
//
&НаКлиенте
Процедура Подключаемый_ОткрытьФормуУточненияДанных()
	
	ШтрихкодированиеИСКлиент.Подключаемый_ОткрытьФормуУточненияДанных(ЭтотОбъект, ОписаниеОповещенияОбработкиКодаМаркировки());
	
КонецПроцедуры

//  Процедура - Создать акт постановки на сервере.
//
// Параметры:
//  По1Регистру - Произвольный - По 1 регистру.
//
&НаСервере
Процедура СоздатьАктПостановкиНаСервере(По1Регистру)
	
	ДокАктПост = Документы.АктПостановкиНаБалансЕГАИС.СоздатьДокумент();
	ДокАктПост.Дата = ТекущаяДата();
	Если По1Регистру Тогда 
		ДокАктПост.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.АктПостановкиНаБалансВРегистр1;
	Иначе
		ДокАктПост.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.АктПостановкиНаБалансВРегистр2;
	КонецЕсли;
	ДокАктПост.ОрганизацияЕГАИС = Объект.ОрганизацияЕГАИС;
	ДокАктПост.ПричинаПостановкиНаБаланс = Перечисления.ПричиныПостановкиНаБалансЕГАИС.Излишки;
	
	Для каждого АПКПостановке Из Объект.ПозицииКПостановкеНаБаланс Цикл
		
		Если По1Регистру Тогда
			Если НЕ ЗначениеЗаполнено(АПКПостановке.Справка2) Тогда
				Продолжить;
			КонецЕсли;
			ПаармОтбора = Новый Структура("АлкогольнаяПродукция, Справка2", АПКПостановке.АлкогольнаяПродукция, АПКПостановке.Справка2);
			НайдСтрокиТОваров = ДокАктПост.ТОвары.НайтиСтроки(ПаармОтбора);
			Если НайдСтрокиТОваров.Количество() = 0 Тогда
				НСтрокаТоваров = ДокАктПост.ТОвары.Добавить();
				ИдСтроки = Новый УникальныйИдентификатор;
				НСтрокаТоваров.ИдентификаторСтроки = ИдСтроки;
				НСтрокаТоваров.КоличествоУпаковок = АПКПостановке.Количество;
				НСтрокаТоваров.Количество = АПКПостановке.Количество;
				НСтрокаТоваров.Справка2 = АПКПостановке.Справка2;
				НСтрокаТоваров.АлкогольнаяПродукция = АПКПостановке.АлкогольнаяПродукция;
				НСтрокаТоваров.Номенклатура = питЕГАИСОбщегоНазначения.ПолучитьНоменклатуруПоАлкопродукцииИзСоответствия(АПКПостановке.АлкогольнаяПродукция);
			Иначе
				НСтрокаТоваров = НайдСтрокиТОваров[0];
				ИдСтроки = НСтрокаТоваров.ИдентификаторСтроки; 
			КонецЕсли;
			
			// В любом случае если заполнена марка, добавим в ТЧ АМ
			Если ЗначениеЗаполнено(АПКПостановке.АкцизнаяМаркаЗначение) Тогда
				НСтрокаМарок = ДокАктПост.АкцизныеМарки.Добавить();
				НСтрокаМарок.ИдентификаторСтроки = ИдСтроки;
				Если АПКПостановке.АкцизнаяМарка.Пустая() И ЗначениеЗаполнено(АПКПостановке.АкцизнаяМаркаЗначение) Тогда
					АПКПостановке.АкцизнаяМарка = СоздатьСправочникПоАМ(АПКПостановке.АкцизнаяМаркаЗначение, НСтрокаТоваров.Номенклатура);	
				КонецЕсли;
				НСтрокаМарок.АкцизнаяМарка = АПКПостановке.АкцизнаяМарка;
				НСтрокаМарок.Справка2 = АПКПостановке.Справка2;
				НСтрокаМарок.Количество = 1;
				
				//// +заполним у товаров количество марок
				// ПаармОтбораМарок = Новый Структура("ИдентификаторСтроки",ИдСтроки);
				// МассивМарок = ДокАктПост.АкцизныеМарки.НайтиСтроки(ПаармОтбораМарок);
				// НСтрокаТоваров.КоличествоАкцизныхМарок = МассивМарок.Количество();
			КонецЕсли;
			
			
		Иначе
			Если ЗначениеЗаполнено(АПКПостановке.Справка2) Тогда
				Продолжить;
			КонецЕсли;
			ПаармОтбора = Новый Структура("АлкогольнаяПродукция", АПКПостановке.АлкогольнаяПродукция);
			НайдСтрокиТОваров = ДокАктПост.ТОвары.НайтиСтроки(ПаармОтбора);
			Если НайдСтрокиТОваров.Количество() = 0 Тогда
				НСтрокаТоваров = ДокАктПост.ТОвары.Добавить();
				ИдСтроки = Новый УникальныйИдентификатор;
				НСтрокаТоваров.ИдентификаторСтроки = ИдСтроки;
				НСтрокаТоваров.КоличествоУпаковок = АПКПостановке.Количество;
				// НСтрокаТоваров.Справка2 = АПКПостановке.Справка2;
				НСтрокаТоваров.АлкогольнаяПродукция = АПКПостановке.АлкогольнаяПродукция;
				НСтрокаТоваров.Номенклатура = питЕГАИСОбщегоНазначения.ПолучитьНоменклатуруПоАлкопродукцииИзСоответствия(АПКПостановке.АлкогольнаяПродукция);
			Иначе
				ИдСтроки = НайдСтрокиТОваров[0].ИдентификаторСтроки; 
			КонецЕсли;
		КонецЕсли;
				
	Конеццикла;
	
	Если ДокАктПост.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДокАктПост.Записать(РежимЗаписиДокумента.Запись);
	НовСтрокаАкта = Объект.СозданныеАктыПостановки.Добавить();
	НовСтрокаАкта.ДокументАктПостановки = ДокАктПост.Ссылка;
	Если По1Регистру Тогда
		АдресХранилищаАктаПостановки1 = ПоместитьВоВременноеХранилище(ДокАктПост.Ссылка, ЭтотОбъект.УникальныйИдентификатор);
	Иначе
		АдресХранилищаАктаПостановки2 = ПоместитьВоВременноеХранилище(ДокАктПост.Ссылка, ЭтотОбъект.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Создать акт списания на сервере.
//
// Параметры:
//  По1Регистру - Произвольный - По 1 регистру.
//  Маркируемая - Произвольный - Маркируемая.
//
&НаСервере
Процедура СоздатьАктСписанияНаСервере(По1Регистру, Маркируемая = Истина)
	
	ДокАктСписания = Документы.АктСписанияЕГАИС.СоздатьДокумент();
	ДокАктСписания.Дата = ТекущаяДата();
	Если По1Регистру Тогда 
		ДокАктСписания.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.АктСписанияИзРегистра1;
	Иначе
		ДокАктСписания.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.АктСписанияИзРегистра2;
	КонецЕсли;
	ДокАктСписания.ОрганизацияЕГАИС = Объект.ОрганизацияЕГАИС;
	ДокАктСписания.ПричинаСписания = Перечисления.ПричиныСписанийЕГАИС.Недостача;
	
	Для каждого АПКСписанию Из Объект.ПозицииКСписанию Цикл
		
		Если По1Регистру Тогда
			Если НЕ ЗначениеЗаполнено(АПКСписанию.Справка2) Тогда
				Продолжить;
			КонецЕсли;
			
			// определим маркируемая продукция или нет
			НоменклатураПоАП = питЕГАИСОбщегоНазначения.ПолучитьНоменклатуруПоАлкопродукцииИзСоответствия(АПКСписанию.АлкогольнаяПродукция);
			Если ЗначениеЗаполнено(АПКСписанию.АкцизнаяМаркаЗначение) Тогда
				ПродукцияМаркируемая = Истина;
			Иначе
					Если АПКСписанию.Справка2.Поштучная ИЛИ АПКСписанию.АлкогольнаяПродукция.ВидПродукции.Маркируемый Тогда
					ПродукцияМаркируемая = Истина;
				Иначе
					ПродукцияМаркируемая = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ Маркируемая И ПродукцияМаркируемая ИЛИ
				Маркируемая И НЕ ПродукцияМаркируемая Тогда
				Продолжить;
			КонецЕсли;
			
			ПаармОтбора = Новый Структура("АлкогольнаяПродукция, Справка2", АПКСписанию.АлкогольнаяПродукция, АПКСписанию.Справка2);
			НайдСтрокиТОваров = ДокАктСписания.ТОвары.НайтиСтроки(ПаармОтбора);
			Если НайдСтрокиТОваров.Количество() = 0 Тогда
				НСтрокаТоваров = ДокАктСписания.ТОвары.Добавить();
				ИдСтроки = Новый УникальныйИдентификатор;
				НСтрокаТоваров.ИдентификаторСтроки = ИдСтроки;
				НСтрокаТоваров.КоличествоУпаковок = АПКСписанию.Количество;
				НСтрокаТоваров.Количество = АПКСписанию.Количество;
				НСтрокаТоваров.Справка2 = АПКСписанию.Справка2;
				НСтрокаТоваров.АлкогольнаяПродукция = АПКСписанию.АлкогольнаяПродукция;
				НСтрокаТоваров.Номенклатура = НоменклатураПоАП;
			Иначе
				НСтрокаТоваров = НайдСтрокиТОваров[0];
				ИдСтроки = НСтрокаТоваров.ИдентификаторСтроки; 
			КонецЕсли;
			
			// В любом случае если заполнена марка, добавим в ТЧ АМ
			Если ЗначениеЗаполнено(АПКСписанию.АкцизнаяМаркаЗначение) Тогда
				НСтрокаМарок = ДокАктСписания.АкцизныеМарки.Добавить();
				НСтрокаМарок.ИдентификаторСтроки = ИдСтроки;
				Если АПКСписанию.АкцизнаяМарка.Пустая() И ЗначениеЗаполнено(АПКСписанию.АкцизнаяМаркаЗначение) Тогда
					АПКСписанию.АкцизнаяМарка = СоздатьСправочникПоАМ(АПКСписанию.АкцизнаяМаркаЗначение, НСтрокаТоваров.Номенклатура);	
				КонецЕсли;
				НСтрокаМарок.АкцизнаяМарка = АПКСписанию.АкцизнаяМарка;
				НСтрокаМарок.Справка2 = АПКСписанию.Справка2;
				НСтрокаМарок.Количество = 1;
				
				//// +заполним у товаров количество марок
				// ПаармОтбораМарок = Новый Структура("ИдентификаторСтроки",ИдСтроки);
				// МассивМарок = ДокАктСписания.АкцизныеМарки.НайтиСтроки(ПаармОтбораМарок);
				// НСтрокаТоваров.КоличествоАкцизныхМарок = МассивМарок.Количество();
				
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(АПКСписанию.Справка2) Тогда
				Продолжить;
			КонецЕсли;
			ПаармОтбора = Новый Структура("АлкогольнаяПродукция", АПКСписанию.АлкогольнаяПродукция);
			НайдСтрокиТОваров = ДокАктСписания.ТОвары.НайтиСтроки(ПаармОтбора);
			Если НайдСтрокиТОваров.Количество() = 0 Тогда
				НСтрокаТоваров = ДокАктСписания.ТОвары.Добавить();
				ИдСтроки = Новый УникальныйИдентификатор;
				НСтрокаТоваров.ИдентификаторСтроки = ИдСтроки;
				НСтрокаТоваров.КоличествоУпаковок = АПКСписанию.Количество;
				// НСтрокаТоваров.Справка2 = АПКПостановке.Справка2;
				НСтрокаТоваров.АлкогольнаяПродукция = АПКСписанию.АлкогольнаяПродукция;
				НСтрокаТоваров.Номенклатура = питЕГАИСОбщегоНазначения.ПолучитьНоменклатуруПоАлкопродукцииИзСоответствия(АПКСписанию.АлкогольнаяПродукция);
			Иначе
				ИдСтроки = НайдСтрокиТОваров[0].ИдентификаторСтроки; 
			КонецЕсли;
		КонецЕсли;
				
	Конеццикла;
	
	Если ДокАктСписания.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДокАктСписания.Записать(РежимЗаписиДокумента.Запись);
	НовСтрокаАкта = Объект.СозданныеАктыСписания.Добавить();
	НовСтрокаАкта.ДокументАктСписания = ДокАктСписания.Ссылка;
	Если По1Регистру Тогда
		Если Маркируемая Тогда
			АдресХранилищаАктаСписания1 = ПоместитьВоВременноеХранилище(ДокАктСписания.Ссылка, ЭтотОбъект.УникальныйИдентификатор);
		Иначе
			АдресХранилищаАктаСписания1НеМарк = ПоместитьВоВременноеХранилище(ДокАктСписания.Ссылка, ЭтотОбъект.УникальныйИдентификатор);
		КонецЕсли;
	Иначе
		АдресХранилищаАктаСписания2 = ПоместитьВоВременноеХранилище(ДокАктСписания.Ссылка, ЭтотОбъект.УникальныйИдентификатор);
	КонецЕсли;	
КонецПроцедуры

//  Функция - Создать справочник по ам.
//
// Параметры:
//  ЗначениеШК - Произвольный - Значение шк.
//  НоменклатураАП - Произвольный - Номенклатура ап.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция СоздатьСправочникПоАМ(ЗначениеШК, НоменклатураАП)
	
	// Сперва ищем существующий
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |ГДЕ
	               |	НЕ ШтрихкодыУпаковокТоваров.ПометкаУдаления
	               |	И ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода
	               |	И ШтрихкодыУпаковокТоваров.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", ЗначениеШК);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураАП);
	
	ВыборкаРез = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаРез.Следующий() Тогда
		
		Возврат ВыборкаРез.Ссылка;
		
	Иначе
	
		// Если не найден существующий элемент, создадим
		НовыйСпр = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
		НовыйСпр.ЗначениеШтрихкода = ЗначениеШК;
		НовыйСпр.Номенклатура = НоменклатураАП;
		Если СтрДлина(ЗначениеШК) =  68 ТОгда
			НовыйСпр.ТипШтрихкода = Перечисления.ТипыШтрихкодов.PDF417;
		Иначе
			НовыйСпр.ТипШтрихкода = Перечисления.ТипыШтрихкодов.DataMatrix;
		КонецЕсли;
		НовыйСпр.ТипУпаковки = Перечисления.ТипыУпаковок.МаркированныйТовар;
		Попытка
			НовыйСпр.Записать();
			Возврат НовыйСпр.Ссылка;
		Исключение
			Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		КонецПопытки;
		
	КонецЕсли;
	
КонецФункции

//  Процедура - Обновить реквизиты бу сервер.
//
&НаСервере
Процедура ОбновитьРеквизитыБУСервер()
	
	Если НЕ ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		Объект.Организация = Справочники.Организации.ПустаяСсылка();
		Объект.Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
		Объект.Склад = Справочники.Склады.ПустаяСсылка();
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлассификаторОрганизацийЕГАИС.Контрагент КАК Контрагент,
	               |	КлассификаторОрганизацийЕГАИС.ТорговыйОбъект КАК ТорговыйОбъект
	               |ИЗ
	               |	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	               |ГДЕ
	               |	КлассификаторОрганизацийЕГАИС.Ссылка = &Ссылка
	               |	И КлассификаторОрганизацийЕГАИС.СоответствуетОрганизации = ИСТИНА
	               |	И КлассификаторОрганизацийЕГАИС.Сопоставлено = ИСТИНА";
	Запрос.УстановитьПараметр("Ссылка", Объект.ОрганизацияЕГАИС);
	Рез = Запрос.Выполнить();
	Если НЕ Рез.Пустой() ТОгда
		Выборка = Рез.Выбрать();
		Объект.Организация = Выборка.Контрагент;
		Если ТипЗнч(Выборка.ТорговыйОбъект) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
			Объект.Подразделение = Выборка.ТорговыйОбъект;
		Иначе
			Объект.Склад = Выборка.ТорговыйОбъект;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

