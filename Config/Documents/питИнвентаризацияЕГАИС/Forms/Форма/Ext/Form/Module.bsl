//  Процедура - Закрытие инвентаризации.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДопПарам - Произвольный - Доп парам.
//
&НаКлиенте
ПРоцедура ЗакрытиеИнвентаризации(Результат, ДопПарам) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьДокументНаСервере();
	КонецЕсли;
	Объект.НомерШага = 2;
	ЭтотОбъект.Закрыть();
	
КонецПроцедуры

//  Функция - Обработка кода маркировки выполнить действие.
//
// Параметры:
//  ДанныеДляВыполненияДействия - Произвольный - Данные для выполнения действия.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ОбработкаКодаМаркировкиВыполнитьДействие(ДанныеДляВыполненияДействия, ДополнительныеПараметры) Экспорт
	
	РезультатВыбора             = ДанныеДляВыполненияДействия.РезультатВыбора;
	РезультатОбработкиШтрихкода = ДанныеДляВыполненияДействия.РезультатОбработкиШтрихкода;
	КэшированныеЗначения        = ДанныеДляВыполненияДействия.КэшированныеЗначения;
	ПараметрыСканирования       = ДанныеДляВыполненияДействия.ПараметрыСканирования;
	
	Действие = ДанныеДляВыполненияДействия.Действие;
	РезультатОбработкиШтрихкода = ОбработкаКодаМаркировкиВыполнитьДействиеСервер(Действие, РезультатВыбора, РезультатОбработкиШтрихкода, ПараметрыСканирования, КэшированныеЗначения);
	
	ПараметрыЗавершенияВводаШтрихкода = ПараметрыЗавершенияВводаШтрихкода(
		ДанныеДляВыполненияДействия.ИсходныеДанные, РезультатОбработкиШтрихкода, ДанныеДляВыполненияДействия.ПараметрыСканирования);
	ШтрихкодированиеОбщегоНазначенияИСКлиент.ЗавершитьОбработкуШтрихкода(ПараметрыЗавершенияВводаШтрихкода);
	
КонецФункции

//  Процедура - Обработать код маркировки.
//
// Параметры:
//  ИсходныеДанные - Произвольный - Исходные данные.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ОбработатьКодМаркировки(ИсходныеДанные, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ИсходныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСканирования = ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыСканирования(ЭтотОбъект);
	ПараметрыСканирования.ОрганизацияЕГАИС = Объект.ОрганизацияЕГАИС;
	
	Если ИсходныеДанные.Свойство("Штрихкод") Тогда
		Если СтрДлина(ИсходныеДанные.Штрихкод)<15 Тогда
			ПараметрыСканирования.Вставить("РазрешенаОбработкаБезУказанияМарки", Истина);
		КонецЕсли;
	КонецЕсли;
	
	ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ЗакодироватьШтрихкодДанныхBase64(ИсходныеДанные);
	РезультатОбработки = ОбработатьВводШтрихкода(ИсходныеДанные, Неопределено, ПараметрыСканирования);
	
	Если РезультатОбработки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗавершенияВводаШтрихкода = ПараметрыЗавершенияВводаШтрихкода(ИсходныеДанные, РезультатОбработки, ПараметрыСканирования);
	ШтрихкодированиеОбщегоНазначенияИСКлиент.ЗавершитьОбработкуШтрихкода(ПараметрыЗавершенияВводаШтрихкода);
	
	// +данные ШК сохранять в СписокОтсканированных!!!
	Если СтрДлина(РезультатОбработки.Штрихкод) > 15 Тогда
		
		СписокОтсканированных.Добавить(РезультатОбработки.Штрихкод);	
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область РаботаСТСД


//  Процедура - Внешнее событие.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Событие - Произвольный - Событие.
//  Данные - Произвольный - Данные.
//
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	ДанныеСоСканераСтруктура = СобытияФормИСКлиент.ВнешнееСобытиеПреобразоватьДанныеСоСканераВСтруктуру(ЭтотОбъект, Источник, Событие, Данные);
	Если ДанныеСоСканераСтруктура = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьКодМаркировки(ДанныеСоСканераСтруктура);

	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	// Конец ПодключаемоеОборудование
КонецПроцедуры

//  Процедура - При закрытии.
//
// Параметры:
//  ЗавершениеРаботы - Произвольный - Завершение работы.
//
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	// Конец ПодключаемоеОборудование
КонецПроцедуры

//  Процедура - Перед закрытием.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ЗавершениеРаботы - Произвольный - Завершение работы.
//  ТекстПредупреждения - Произвольный - Текст предупреждения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Объект.НомерШага = 0 Тогда
		Отказ = Истина;
		ДопПарам = Новый Структура;
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗакрытиеИнвентаризации", ЭтотОбъект, ДопПарам), "Сохранить текущую инвентаризацию?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ДанныеКэша = ПолучитьИзВременногоХранилища(КэшМаркируемойПродукции);
	// ТекущийОбъект.КэшМарок = ПоместитьВоВременноеХранилище(ДанныеКэша);
	ТекущийОбъект.КэшМарок = Новый ХранилищеЗначения(ДанныеКэша);
	
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИнтеграцияИСКлиент.ЭтоЗагрузкаКодовМаркировки(ИсточникВыбора, ЭтотОбъект) Тогда
		// Формат загрузки из внешнего файла полностью соответствует формату загрузки из ТСД
		Подключаемый_ПолученыДанныеИзТСД(ВыбранноеЗначение, Неопределено);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		ОргЕГАИС_Старое = Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка();
		ДокОстатки_Старое = Документы.ОстаткиЕГАИС.ПустаяСсылка();
		ДокОстаткиРег2_Старое = Документы.ОстаткиЕГАИС.ПустаяСсылка();
		ПересчитыватьШаг2 = Истина;
	Иначе
		ОргЕГАИС_Старое = Объект.ОрганизацияЕГАИС;
		ДокОстатки_Старое = Объект.ДокументОстатки;
		ДокОстаткиРег2_Старое = Объект.ДокументОстатки2Рег;
		ПересчитыватьШаг2 = Ложь;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		Элементы.Шаг1.Доступность = Истина;
		Элементы.Шаг2.Доступность = Ложь;
		Элементы.Шаг3.Доступность = Ложь;
		Элементы.Шаг4.Доступность = Ложь;
		Элементы.ДалееСтр1.Доступность = Ложь;
	Иначе
		Если Объект.НомерШага = 2 Тогда
			Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг2;
		ИначеЕсли Объект.НомерШага = 4 Тогда
			Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг4;
		КонецЕсли;
	КонецЕсли;
	
	ОбщПараметрыСканирования = ШтрихкодированиеОбщегоНазначенияИС.ПараметрыСканирования(ЭтотОбъект, , Перечисления.ВидыПродукцииИС.Алкогольная);
	
	ОбщегоНазначенияСобытияФормИСПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	ОбщегоНазначенияИС.НастроитьПодключаемоеОборудование(ЭтотОбъект, ПоддерживаемыеТипыПодключаемогоОборудования);
	
	ПараметрыУказанияСерий = ИнтеграцияИС.ПараметрыУказанияСерийФормыОбъекта(Объект, Документы.питИнвентаризацияЕГАИС);
	
	Если Не ПодключенаОбработкаКодовМаркировки Тогда
		ПроверкаИПодборПродукцииИС.ПодключитьОбработкуКодовМаркировки(ЭтотОбъект,,
			"Справка2");
		ПодключенаОбработкаКодовМаркировки = Истина;
	КонецЕсли;
	
	АдресМарок = АдресДанныхМарок();
	Если НЕ АдресМарок = Неопределено Тогда
		КэшМаркируемойПродукции = АдресМарок;
	КонецЕсли;
	
	Для каждого АкцМарка Из Объект.АкцизныеМарки Цикл
		СписокОтсканированных.Добавить(АкцМарка.КодАкцизнойМарки);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область РаботаСТСД

//  Процедура - Документ остатки 2 рег при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДокументОстатки2РегПриИзменении(Элемент)
	ДокументОстатки2регПриИзмененииНаСервере();
КонецПроцедуры

//  Процедура - Остатки по данным егаис при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОстаткиПоДаннымЕГАИСПриАктивизацииСтроки(Элемент)
	питУстановитьОтборСтрокМарок();
КонецПроцедуры

//  Процедура - Остатки по данным егаис перед удалением.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ОстаткиПоДаннымЕГАИСПередУдалением(Элемент, Отказ)
	ИдентификаторыСтрок = Новый Массив;
	ВыделенныеСтроки = Элементы.ОстаткиПоДаннымЕГАИС.ВыделенныеСтроки;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		СтрокаТЧ = Объект.ОстаткиПоДаннымЕГАИС.НайтиПоИдентификатору(ВыделеннаяСтрока);
		ИдентификаторыСтрок.Добавить(СтрокаТЧ.ИдентификаторСтроки);
	КонецЦикла;
	
	Если Не Отказ И ИдентификаторыСтрок.Количество() > 0 Тогда
		УдалитьАкцизныеМаркиПоИд(ИдентификаторыСтрок);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

//  Процедура - Документ остатки при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДокументОстаткиПриИзменении(Элемент)
	ДокументОстаткиПриИзмененииНаСервере();
КонецПроцедуры

//  Процедура - Организация егаис при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОрганизацияЕГАИСПриИзменении(Элемент)
	
	Если Объект.ОрганизацияЕГАИС <> ОргЕГАИС_Старое Тогда
		ПересчитыватьШаг2 = Истина;
	КонецЕсли;
	
	// ОбщПараметрыСканирования.ОрганизацияЕГАИС = Объект.ОрганизацияЕГАИС;
	ОбщПараметрыСканирования.Организация = Объект.ОрганизацияЕГАИС;
	
	Если ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		 Элементы.ДокументОстатки.Доступность = Истина;
		 Элементы.ДокументОстатки2Рег.Доступность = Истина;
		 Элементы.ДалееСтр1.Доступность = Истина;
	Иначе
		 Элементы.ДокументОстатки.Доступность = Ложь;
		 Элементы.ДокументОстатки2Рег.Доступность = Ложь;
		 Элементы.ДалееСтр1.Доступность = Ложь;
	КонецЕсли;
	 
	ОбновитьРеквизитыБУСервер(); 
	
	Элементы.ПозицииКПостановкеНаБалансСоздатьАктПостановки.Доступность = Истина;
	Элементы.ПозицииКСписанию1СоздатьАктСписания.Доступность = Истина;
	Объект.СозданныеАктыПостановки.Очистить();
	Объект.СозданныеАктыСписания.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область Шаг3
//  Процедура - Создать и запросить.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СоздатьИЗапросить(Команда)
	
	МассивВходныхПарам = Новый Массив;
	
	Для каждого СтрокаДанных Из Объект.ДанныеДляЗапрос Цикл
		СтрПарам = Новый Структура("ОрганизацияЕГАИС, АлкогольнаяПродукция, Справка2");
		Если НЕ ЗначениеЗаполнено(СтрокаДанных.Справка2) Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрПарам, СтрокаДанных);
		МассивВходныхПарам.Добавить(СтрПарам);
	КонецЦикла;
	
	Прогресс = 0;

	МассивСозданныхДокументов = СформироватьДокументыПоОстаткам(МассивВходныхПарам);
	ОтчетыЕГАИССп.ЗагрузитьЗначения(МассивСозданныхДокументов);
	сч = 0;
	МаксЗначение = МассивВходныхПарам.Количество();
	Если МаксЗначение > 0 Тогда
		Док = МассивСозданныхДокументов[0];
	Иначе 
		Возврат;
	КонецЕсли;
	
	АдресХранилища = ПоместитьВоВременноеХранилище( Новый Структура("Инд,КоличествоОбходов, МассивСозданныхДокументов",0,МаксЗначение+1, МассивСозданныхДокументов),Новый УникальныйИдентификатор); 
	
	СтрПарам = Новый Структура("АдресХранилища", АдресХранилища);
	ОткрытьФорму("Документ.питИнвентаризацияЕГАИС.Форма.ФормаОжидания", СтрПарам, ,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	// Первый раз запускаем сразу, это в последующие разы ждем по 11 минут
	ПодключитьОбработчикОжидания("Подключаемый_ПодготовкаКПередачеВЕГАИС", 2, Истина);  
	
	ПодключитьОбработчикОжидания("ОбработчикОжидания",3,Истина);
	
	// КомандаВыполнитьНажатиеНаСервере(МассивВходныхПарам);
	// ПодключитьОбработчикОжидания("ОбработчикОжидания",5,Истина);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСТСД

//  Процедура - Загрузить данные из тсд.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗагрузитьДанныеИзТСД(Команда)
	
	ОчиститьСообщения();
	
	МенеджерОборудованияКлиент.НачатьЗагрузкуДанныеИзТСД(
		Новый ОписаниеОповещения("ЗагрузитьИзТСДЗавершение", ЭтотОбъект),
		УникальныйИдентификатор);
	
КонецПроцедуры

//  Процедура - Сохранить документ.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СохранитьДокумент(Команда)
		
	Если Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг2 Тогда
		Объект.НомерШага = 2;
	ИначеЕсли Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг4 Тогда
		Объект.НомерШага = 4;
	Иначе
		Объект.НомерШага = 0;
	КонецЕсли;
	
	СохранитьДокументНаСервере();
	
КонецПроцедуры

//  Процедура - Загрузить из внешнего файла.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайла(Команда)
	
	ОчиститьСообщения();
	
	ИнтеграцияИСКлиент.ОткрытьФормуЗагрузкиКодовМаркировки(
		ЭтотОбъект,
		Ложь,
		ИнтеграцияЕГАИСКлиент.ЗаголовокФормыЗагрузкиКодовМаркировки(ЭтотОбъект));
	
КонецПроцедуры

//  Процедура - Сравнять факт с планом.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СравнятьФактСПланом(Команда)
	Для каждого СтрокаОстатки Из Объект.ОстаткиПоДаннымЕГАИС Цикл
		СтрокаОстатки.КоличествоФакт = СтрокаОстатки.Количество;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

//  Процедура - Назад.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Назад(Команда)
	
	Если Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг2 Тогда
		
		Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг1;	
		
		Элементы.Шаг1.Доступность = Истина;
		Элементы.Шаг2.Доступность = Ложь;
		Элементы.Шаг3.Доступность = Ложь;
		Элементы.Шаг4.Доступность = Ложь;		
		
	ИначеЕсли Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг3 Тогда
		
		Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг2;
		
		Элементы.Шаг1.Доступность = Ложь;
		Элементы.Шаг2.Доступность = Истина;
		Элементы.Шаг3.Доступность = Ложь;
		Элементы.Шаг4.Доступность = Ложь;		
		
	ИначеЕсли Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг4 Тогда
		
		Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг3;
		
		Элементы.Шаг1.Доступность = Ложь;
		Элементы.Шаг2.Доступность = Ложь;
		Элементы.Шаг3.Доступность = Истина;
		Элементы.Шаг4.Доступность = Ложь;		
		
	КонецЕсли;
	
КонецПроцедуры


//  Процедура - Ввести шк.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВвестиШК(Команда)
	
	ОчиститьСообщения();
	ШтрихкодированиеОбщегоНазначенияИСКлиент.ПоказатьВводШтрихкода(ОписаниеОповещенияОбработкиКодаМаркировки());
	
КонецПроцедуры


//  Процедура - Далее стр 1.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ДалееСтр1(Команда)
	
	Если Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг1 Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ДокументОстатки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить документ остатков по 1 регистру!");
			Возврат;
		КонецЕсли;
		
		// Если НЕ ЗначениеЗаполнено(Объект.ДокументОстатки2Рег) Тогда
		// 	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить документ остатков по 2 регистру!");
		// 	Возврат;
		// КонецЕсли;
		
		Если ПересчитыватьШаг2 Тогда
			ЗаполнитьСтаницуШаг2();
		КонецЕсли;
		
		Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг2;	
		
		Элементы.Шаг1.Доступность = Ложь;
		Элементы.Шаг2.Доступность = Истина;
		Элементы.Шаг3.Доступность = Ложь;
		Элементы.Шаг4.Доступность = Ложь;		
		
	ИначеЕсли Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг2 Тогда
		
		ЗаполнитьСтаницуШаг3();
		Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг3;
		
		Элементы.Шаг1.Доступность = Ложь;
		Элементы.Шаг2.Доступность = Ложь;
		Элементы.Шаг3.Доступность = Истина;
		Элементы.Шаг4.Доступность = Ложь;		
		
	ИначеЕсли Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг3 Тогда
		
		ЗаполнитьСтаницуШаг4();
		Элементы.ШагиИнвентаризации.ТекущаяСтраница = Элементы.Шаг4;
		
		Элементы.Шаг1.Доступность = Ложь;
		Элементы.Шаг2.Доступность = Ложь;
		Элементы.Шаг3.Доступность = Ложь;
		Элементы.Шаг4.Доступность = Истина;		
		
	КонецЕсли;
КонецПроцедуры

//  Процедура - Создать акт постановки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СоздатьАктПостановки(Команда)
	
	// 1 рег
	СоздатьАктПостановкиНаСервере(Истина);
	Если ЗначениеЗаполнено(АдресХранилищаАктаПостановки1) Тогда
		ДокАктаСсылка1 = ПолучитьИзВременногоХранилища(АдресХранилищаАктаПостановки1);
		ОткрытьФорму("Документ.АктПостановкиНаБалансЕГАИС.ФормаОбъекта", Новый Структура("Ключ", ДокАктаСсылка1));
	КонецЕсли;
	
	// 2 рег
	СоздатьАктПостановкиНаСервере(Ложь);
	Если ЗначениеЗаполнено(АдресХранилищаАктаПостановки2) Тогда
		ДокАктаСсылка2= ПолучитьИзВременногоХранилища(АдресХранилищаАктаПостановки2);
		ОткрытьФорму("Документ.АктПостановкиНаБалансЕГАИС.ФормаОбъекта", Новый Структура("Ключ", ДокАктаСсылка2));
	КонецЕсли;
	
	Элементы.ПозицииКПостановкеНаБалансСоздатьАктПостановки.Доступность = Ложь;
	
КонецПроцедуры

//  Процедура - Создать акт списания.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СоздатьАктСписания(Команда)
	
		// 1 рег
	СоздатьАктСписанияНаСервере(Истина);
	Если ЗначениеЗаполнено(АдресХранилищаАктаСписания1) Тогда
		ДокАктаСсылка1 = ПолучитьИзВременногоХранилища(АдресХранилищаАктаСписания1);
		ОткрытьФорму("Документ.АктСписанияЕГАИС.ФормаОбъекта", Новый Структура("Ключ", ДокАктаСсылка1));
	КонецЕсли;
	
	СоздатьАктСписанияНаСервере(Истина, Ложь);
	Если ЗначениеЗаполнено(АдресХранилищаАктаСписания1НеМарк) Тогда
		ДокАктаСсылка1НеМарк = ПолучитьИзВременногоХранилища(АдресХранилищаАктаСписания1НеМарк);
		ОткрытьФорму("Документ.АктСписанияЕГАИС.ФормаОбъекта", Новый Структура("Ключ", ДокАктаСсылка1НеМарк));
	КонецЕсли;
	
	// 2 рег
	СоздатьАктСписанияНаСервере(Ложь);
	Если ЗначениеЗаполнено(АдресХранилищаАктаСписания2) Тогда
		ДокАктаСсылка2= ПолучитьИзВременногоХранилища(АдресХранилищаАктаСписания2);
		ОткрытьФорму("Документ.АктСписанияЕГАИС.ФормаОбъекта", Новый Структура("Ключ", ДокАктаСсылка2));
	КонецЕсли;

	Элементы.ПозицииКСписанию1СоздатьАктСписания.Доступность = Ложь;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Шаг3

//  Процедура - Подключаемый подготовка к передаче вегаис.
//
&НаКлиенте
Процедура Подключаемый_ПодготовкаКПередачеВЕГАИС()
		
	СтрИзХранилища = ПолучитьИзВременногоХранилища(АдресХранилища);
	МассивСозданныхДокументов = СтрИзХранилища.МассивСозданныхДокументов;
	Инд = СтрИзХранилища.Инд;
	КоличествоОбходов = СтрИзХранилища.КоличествоОбходов;
	
	Если Инд < КоличествоОбходов-1 Тогда
		
		Док = МассивСозданныхДокументов[Инд];
		
		// Прогресс = Инд;
		
		ОбменДаннымиЕГАИСКлиент.ПодготовитьКПередаче(
			Док,
			ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияПоВзаимодействиюЕГАИС.ЗапроситеОтчет"));
			
	КонецЕсли;
	
	Инд = Инд + 1;
	
	АдресХранилища = ПоместитьВоВременноеХранилище( Новый Структура("Инд,КоличествоОбходов, МассивСозданныхДокументов",Инд,КоличествоОбходов, МассивСозданныхДокументов),Новый УникальныйИдентификатор); 
	
	Оповестить("НовыйАдресХрИнвентаризации", АдресХранилища); 

	
	Если Инд < КоличествоОбходов Тогда 
		ПодключитьОбработчикОжидания("Подключаемый_ПодготовкаКПередачеВЕГАИС", 60*32, Истина);  //60*32
	ИначеЕсли Инд = КоличествоОбходов Тогда
		// В заключении нужно обработать ответы от ЕГАИС
		ПодключитьОбработчикОжидания("Подключаемый_ОбработатьОтветыЕГАИС", 60*32, Истина);  //60*32
	КонецЕсли; 
	
КонецПроцедуры

//  Процедура - Подключаемый обработать ответы егаис.
//
&НаКлиенте
Процедура Подключаемый_ОбработатьОтветыЕГАИС()
	
	ОбменДаннымиЕГАИСКлиент.ВыполнитьОбмен(
		Объект.ОрганизацияЕГАИС,,
		УникальныйИдентификатор);
		
	Элементы.ДалееСтр3.Доступность = Истина;
	
	ДанныеОВыполнении = ПолучитьИзВременногоХранилища(АдресХранилища); 
	Инд = ДанныеОВыполнении.Инд +1;	
	АдресХранилища = ПоместитьВоВременноеХранилище( Новый Структура("Инд,КоличествоОбходов, МассивСозданныхДокументов",Инд,ДанныеОВыполнении.КоличествоОбходов, ДанныеОВыполнении.МассивСозданныхДокументов),Новый УникальныйИдентификатор); 
	
	Оповестить("НовыйАдресХрИнвентаризации", АдресХранилища); 
КонецПроцедуры

//  Функция - Сформировать документы по остаткам.
//
// Параметры:
//  МассивАПСправокДляЗапроса - Массив - Массив ап справок для запроса.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция СформироватьДокументыПоОстаткам(МассивАПСправокДляЗапроса)
	
	МассивДокументов = Новый Массив;
	
	Для каждого ЭлМассиваДляЗапроса ИЗ МассивАПСправокДляЗапроса Цикл
		
		АП = ЭлМассиваДляЗапроса.АлкогольнаяПродукция;
		Спр2 = ЭлМассиваДляЗапроса.Справка2;
		ОрганизацияЕГАИС = ЭлМассиваДляЗапроса.ОрганизацияЕГАИС;
		
		ДокОтчет = Документы.ОтчетЕГАИС.СоздатьДокумент();
		ДокОтчет.Дата = ТекущаяДата();
		ДокОтчет.Ответственный = Пользователи.ТекущийПользователь();
		ДокОтчет.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.ЗапросОтчетаОстаткиВРегистре3;
		ДокОтчет.АлкогольнаяПродукция = АП;
		ДокОтчет.ОрганизацияЕГАИС = ОрганизацияЕГАИС;
		ДокОтчет.Справка2 = Спр2;
		ДокОтчет.Записать(РежимЗаписиДокумента.Проведение);
		
		МассивДокументов.Добавить(ДокОтчет.Ссылка);
		
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеТаблицПоШагам
//  Процедура - Заполнить станицу шаг 2.
//
&НаСервере
Процедура ЗаполнитьСтаницуШаг2()
	
	// Чистим отсканированные значения ШК, в случае, если делаем инвентаризацию по новой
	СписокОтсканированных.Очистить();
	
	// Объект.ОстаткиПоДаннымЕГАИС.Загрузить(Объект.ДокументОстатки.ОстаткиПоДаннымЕГАИС.Выгрузить());
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВТ_ВТРег1.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТ_ВТРег1.Количество КАК Количество,
	               |	ВТ_ВТРег1.Справка2 КАК Справка2
	               |ПОМЕСТИТЬ ВТ_ВТРег1
	               |ИЗ
	               |	&ВТРег1 КАК ВТ_ВТРег1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ВтРег2.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТ_ВтРег2.Количество КАК Количество,
	               |	ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка) КАК Поле1
	               |ПОМЕСТИТЬ ВТ_ВтРег2
	               |ИЗ
	               |	&ВтРег2 КАК ВТ_ВтРег2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТРег1.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТРег1.Количество КАК Количество,
	               |	ВТРег1.Справка2 КАК Справка2
	               |ПОМЕСТИТЬ ВТ_ПолныеОстаткиЕГАИС
	               |ИЗ
	               |	ВТ_ВТРег1 КАК ВТРег1
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВтРег2.АлкогольнаяПродукция,
	               |	ВтРег2.Количество,
	               |	ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)
	               |ИЗ
	               |	ВТ_ВтРег2 КАК ВтРег2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ПолныеОстаткиЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТ_ПолныеОстаткиЕГАИС.Количество КАК Количество,
	               |	ВТ_ПолныеОстаткиЕГАИС.Справка2 КАК Справка2,
	               |	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ВТ_ОстаткаЕГАИСсНом
	               |ИЗ
	               |	ВТ_ПолныеОстаткиЕГАИС КАК ВТ_ПолныеОстаткиЕГАИС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	               |		ПО ВТ_ПолныеОстаткиЕГАИС.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
	               |			И (ВЫБОР
	               |				КОГДА ВТ_ПолныеОстаткиЕГАИС.Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ВТ_ПолныеОстаткиЕГАИС.Справка2 = СоответствиеНоменклатурыЕГАИС.Справка2
	               |			КОНЕЦ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОстаткаЕГАИСсНом.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТ_ОстаткаЕГАИСсНом.Количество КАК Количество,
	               |	ВТ_ОстаткаЕГАИСсНом.Справка2 КАК Справка2,
	               |	ВТ_ОстаткаЕГАИСсНом.Номенклатура КАК Номенклатура,
	               |	0 КАК КоличествоБУ
	               |ИЗ
	               |	ВТ_ОстаткаЕГАИСсНом КАК ВТ_ОстаткаЕГАИСсНом
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ОстаткаЕГАИСсНом.Количество,
	               |	ВТ_ОстаткаЕГАИСсНом.Справка2,
	               |	ВТ_ОстаткаЕГАИСсНом.АлкогольнаяПродукция,
	               |	ВТ_ОстаткаЕГАИСсНом.Номенклатура
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	АлкогольнаяПродукция";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("МоментВр", ТекущаяДата());
	Запрос.УстановитьПараметр("ВТРег1", Объект.ДокументОстатки.ОстаткиПоДаннымЕГАИС.Выгрузить());
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОстатки2Рег) Тогда
		Запрос.УстановитьПараметр("ВтРег2", Объект.ДокументОстатки.ОстаткиПоДаннымЕГАИС.Выгрузить(Новый Массив));
	Иначе
		Запрос.УстановитьПараметр("ВтРег2", Объект.ДокументОстатки2Рег.ОстаткиПоДаннымЕГАИС.Выгрузить());
	КонецЕсли;
	
	Выгрузка = Запрос.Выполнить().Выгрузить();//ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Объект.ОстаткиПоДаннымЕГАИС.Загрузить(Выгрузка);//Объект.ДокументОстатки.ОстаткиПоДаннымЕГАИС.Выгрузить());	
	Для каждого СтрокаОст ИЗ Объект.ОстаткиПоДаннымЕГАИС Цикл
		СтрокаОст.ИдентификаторСтроки = СтрокаОст.ПолучитьИдентификатор();	
	КонецЦикла;
	Объект.АкцизныеМарки.Очистить();
	СписокОтсканированных.Очистить();
	
КонецПроцедуры

//  Процедура - Заполнить станицу шаг 3.
//
&НаСервере
Процедура ЗаполнитьСтаницуШаг3()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.НомерСтроки КАК НомерСтроки,
	               |	ТЗ.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ТЗ.Справка2 КАК Справка2,
	               |	ТЗ.КоличествоФакт КАК КоличествоФакт,
	               |	ТЗ.Количество КАК Количество
	               |ПОМЕСТИТЬ ВТ_ТЗ
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	               |	ВТ_ТЗ.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ВТ_ТЗ.Справка2 КАК Справка2,
	               |	ВТ_ТЗ.КоличествоФакт - ВТ_ТЗ.Количество КАК Дельта
	               |ИЗ
	               |	ВТ_ТЗ КАК ВТ_ТЗ
	               |ГДЕ
	               |	ВТ_ТЗ.КоличествоФакт - ВТ_ТЗ.Количество <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ТЗ";
	ЗАпрос.УстановитьПараметр("ТЗ", Объект.ОстаткиПоДаннымЕГАИС.Выгрузить());
	ЗАпрос.УстановитьПараметр("ОрганизацияЕГАИС", Объект.ОрганизацияЕГАИС);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Объект.ДанныеДляЗапрос.Загрузить(Выгрузка);	
	
КонецПроцедуры

//  Процедура - Заполнить станицу шаг 4.
//
&НаСервере
Процедура ЗаполнитьСтаницуШаг4()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФактМарки.АкцизнаяМаркаЗначение КАК АкцизнаяМаркаЗначение
	               |ПОМЕСТИТЬ ВТ_ФактМарки
	               |ИЗ
	               |	&ФактМарки КАК ФактМарки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаСАпФормы.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	               |	ТаблицаСАпФормы.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	ТаблицаСАпФормы.Дельта КАК Дельта,
	               |	ТаблицаСАпФормы.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаСАпФормы.Справка2 КАК Справка2
	               |ПОМЕСТИТЬ ВТ_ТаблицаСАпФормы
	               |ИЗ
	               |	&ТаблицаСАпФормы КАК ТаблицаСАпФормы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтчетЕГАИС.Справка2 КАК Справка2,
	               |	ОтчетЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |	МАКСИМУМ(ОтчетЕГАИС.Дата) КАК Дата,
	               |	ОтчетЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
	               |ПОМЕСТИТЬ ВТ_ДатыОтчетов
	               |ИЗ
	               |	Документ.ОтчетЕГАИС КАК ОтчетЕГАИС
	               |ГДЕ
	               |	(ОтчетЕГАИС.АлкогольнаяПродукция, ОтчетЕГАИС.Справка2, ОтчетЕГАИС.ОрганизацияЕГАИС) В
	               |			(ВЫБРАТЬ
	               |				ВТ_ТаблицаСАпФормы.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	               |				ВТ_ТаблицаСАпФормы.Справка2 КАК Справка2,
	               |				ВТ_ТаблицаСАпФормы.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
	               |			ИЗ
	               |				ВТ_ТаблицаСАпФормы КАК ВТ_ТаблицаСАпФормы)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтчетЕГАИС.ОрганизацияЕГАИС,
	               |	ОтчетЕГАИС.Справка2,
	               |	ОтчетЕГАИС.АлкогольнаяПродукция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтчетЕГАИС.Ссылка КАК Ссылка,
