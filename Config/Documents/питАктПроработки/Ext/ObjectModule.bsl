#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Процедура обработки заполнения.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - Данные заполнения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ДанныеЗаполнения <> Неопределено И ТипДанныхЗаполнения <> Тип("Структура")
		И Метаданные().ВводитсяНаОсновании.Содержит(ДанныеЗаполнения.Метаданные()) Тогда
		
		ЗаполнитьПоДокументуОснованию(ДанныеЗаполнения);
		
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РегламентированныйУчетПодсистемы") Тогда
		МодульЗаполнениеДокументов = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеДокументов");
		МодульЗаполнениеДокументов.Заполнить(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

// Обработчика при копировании.
//
// Параметры:
//  ОбъектКопирования - Произвольный - Объект копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	Дата			= НачалоДня(ОбщегоНазначения.ТекущаяДатаПользователя());
	Ответственный	= Пользователи.ТекущийПользователь();
	
КонецПроцедуры

// Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  РежимЗаписи - Произвольный - Режим записи.
//  РежимПроведения - Произвольный - Режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	// Заполнение наименования.
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = Документы.питРецептура.СформироватьНаименованиеРецептуры(Номенклатура, Характеристика, ДатаНачала, ДатаКонца);
	КонецЕсли;
КонецПроцедуры

// Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	// Проверка заполнения характеристик в шапке.
	Если НЕ питОбщегоНазначения.ХарактеристикиИспользуются(Номенклатура) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Характеристика");
	КонецЕсли;
	
	ПараметрыПроверкиХарактеристик = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверкиХарактеристик.ИмяТЧ = "Ингредиенты";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект, МассивНепроверяемыхРеквизитов, Отказ, ПараметрыПроверкиХарактеристик);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура заполняет документ по документу основанию.
//
// Параметры:
//  Основание - ДокументСсылка.питРецептура - Ссылка на документ основание.
//
Процедура ЗаполнитьПоДокументуОснованию(Основание)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.питРецептура") Тогда
		
		Организация             = Основание.Организация;
		Подразделение           = Основание.Подразделение;
		Наименование            = Основание.Наименование;
		Номенклатура            = Основание.Номенклатура;
		Характеристика          = Основание.Характеристика;
		Количество              = Основание.Количество;
		КоличествоУпаковок      = Основание.КоличествоУпаковок;
		Упаковка                = Основание.Упаковка;
		НомерРецептуры          = Основание.НомерРецептуры;
		Выход                   = Основание.Выход;
		ТехнологияПриготовления = Основание.ТехнологияПриготовления;
		ДатаНачала              = Основание.ДатаНачала;
		ДатаКонца               = Основание.ДатаКонца;
		ДокументОснование       = Основание;
		СкопироватьИнгредиенты(Основание);
		
		// Перезаполним количество случайным образом
		МассивРецептур = Новый Массив();
		МассивРецептур.Добавить(Основание);
		
		КэшированныеЗначенияУпаковок = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		Для Каждого СтрокаТаблицы Из Ингредиенты Цикл
			Документы.питАктПроработки.РассчитатьПроработку(СтрокаТаблицы, МассивРецептур,КэшированныеЗначенияУпаковок);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура копирует табличную часть ингредиентов из документа-основания в текущий документ.
//
// Параметры:
//  Основание - ДокументСсылка.питРецептура - Ссылка на документ основание.
//
Процедура СкопироватьИнгредиенты(Основание)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РецептураИнгредиенты.Номенклатура,
	|	РецептураИнгредиенты.Характеристика,
	|	РецептураИнгредиенты.Упаковка,
	|	РецептураИнгредиенты.КоличествоБрутто,
	|	РецептураИнгредиенты.КоличествоНетто,
	|	РецептураИнгредиенты.КоличествоВыход,
	|	РецептураИнгредиенты.КоличествоБрутто КАК КоличествоБрутто1,
	|	РецептураИнгредиенты.КоличествоНетто КАК КоличествоНетто1,
	|	РецептураИнгредиенты.КоличествоВыход КАК КоличествоВыход1,
	|	РецептураИнгредиенты.КоличествоБрутто КАК КоличествоБрутто2,
	|	РецептураИнгредиенты.КоличествоНетто КАК КоличествоНетто2,
	|	РецептураИнгредиенты.КоличествоВыход КАК КоличествоВыход2,
	|	РецептураИнгредиенты.КоличествоУпаковокБрутто,
	|	РецептураИнгредиенты.КоличествоУпаковокНетто,
	|	РецептураИнгредиенты.КоличествоУпаковокВыход,
	|	РецептураИнгредиенты.КоличествоУпаковокБрутто КАК КоличествоУпаковокБрутто1,
	|	РецептураИнгредиенты.КоличествоУпаковокНетто КАК КоличествоУпаковокНетто1,
	|	РецептураИнгредиенты.КоличествоУпаковокВыход КАК КоличествоУпаковокВыход1,
	|	РецептураИнгредиенты.КоличествоУпаковокБрутто КАК КоличествоУпаковокБрутто2,
	|	РецептураИнгредиенты.КоличествоУпаковокНетто КАК КоличествоУпаковокНетто2,
	|	РецептураИнгредиенты.КоличествоУпаковокВыход КАК КоличествоУпаковокВыход2
	|ИЗ
	|	Документ.питРецептура.Ингредиенты КАК РецептураИнгредиенты
	|ГДЕ
	|	РецептураИнгредиенты.Ссылка = &Ссылка";
	
	Ингредиенты.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли




