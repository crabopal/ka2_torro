#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область Отчеты

// Заполняет список команд отчетов.
//
// Параметры:
//  КомандыОтчетов - ТаблицаЗначений - Состав полей.
//  НастройкиФормы - Произвольный - Настройки формы.
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, НастройкиФормы) Экспорт
	
КонецПроцедуры

#КонецОбласти

#Область Печать

// Заполняет список команд печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - состав полей в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "АктПроработки";
	КомандаПечати.Представление = НСтр("ru = 'Акт проработки'");
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.питРецептура";
	КомандаПечати.Идентификатор = "ТехКарта";
	КомандаПечати.Представление = НСтр("ru = 'Технологическая карта'");
	
КонецПроцедуры

// Процедура - Печать.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ПараметрыПечати - Произвольный - Параметры печати.
//  КоллекцияПечатныхФорм - Произвольный - Коллекция печатных форм.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  ПараметрыВывода - Произвольный - Параметры вывода.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Проверяем, нужно ли для макета "..." формировать табличный документ.
	// А затем формируем табличный документ, и добавляем его в коллекцию печатных форм.
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктПроработки") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "АктПроработки", "Акт проработки",
			ПечатьАктПроработки(МассивОбъектов, ОбъектыПечати),,"Документ.питАктПроработки.ПФ_MXL_АктПроработки");
	КонецЕсли;
	
КонецПроцедуры

// Функция - Получить дополнительные реквизиты для реестра.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьДополнительныеРеквизитыДляРеестра() Экспорт
	
	Результат = Новый Структура("Информация", "Номенклатура");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СозданиеНаОсновании

// Определяет список команд создания на основании.
//
// Параметры:
//  КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании.
//  Параметры - Структура - Вспомогательные параметры. Для чтения.
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.питРецептура.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании, "Записывать");
	
КонецПроцедуры

// Добавляет команду создания документа "Пересчет товаров".
//
// Параметры:
//  КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	Если ПравоДоступа("Добавление", Метаданные.Документы.питАктПроработки) Тогда
		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.питАктПроработки.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = ОбщегоНазначенияУТ.ПредставлениеОбъекта(Метаданные.Документы.питАктПроработки);
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		
		
		
		Возврат КомандаСоздатьНаОсновании;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

#КонецОбласти

// СтандартныеПодсистемы.ВерсионированиеОбъектов

// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
//  Настройки - Структура - настройки подсистемы.
//
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// СтандартныеПодсистемы.УправлениеДоступом

// УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
//
// Параметры:
//  Ограничение - Произвольный - Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Подразделение)";
	
КонецПроцедуры

// Процедура - Заполнить по рецептурам.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  МассивРецептур - Массив - Массив рецептур.
//
Процедура ЗаполнитьПоРецептурам(Объект, МассивРецептур) Экспорт
	
	Объект.Ингредиенты.Очистить();
	
	// Заполним выход и технологию приготовления.
	Объект.Выход					= МассивРецептур[0].Выход;
	Объект.ТехнологияПриготовления	= МассивРецептур[0].ТехнологияПриготовления;
	
	// Сведем табличные части выбранных рецептур в одну таблицу и отсортируем ее.
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питРецептураИнгредиенты.Номенклатура КАК Номенклатура,
	|	питРецептураИнгредиенты.Характеристика КАК Характеристика,
	|	питРецептураИнгредиенты.Упаковка КАК Упаковка,
	|	СУММА(питРецептураИнгредиенты.КоличествоБрутто) КАК КоличествоБрутто,
	|	СУММА(питРецептураИнгредиенты.КоличествоНетто) КАК КоличествоНетто,
	|	СУММА(питРецептураИнгредиенты.КоличествоВыход) КАК КоличествоВыход,
	|	СУММА(питРецептураИнгредиенты.КоличествоУпаковокБрутто) КАК КоличествоУпаковокБрутто,
	|	СУММА(питРецептураИнгредиенты.КоличествоУпаковокНетто) КАК КоличествоУпаковокНетто,
	|	СУММА(питРецептураИнгредиенты.КоличествоУпаковокВыход) КАК КоличествоУпаковокВыход,
	|	питРецептураИнгредиенты.Ссылка,
	|	ВЫБОР
	|		КОГДА питРецептураИнгредиенты.Ссылка = &Ссылка1
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НомерРецептуры1,
	|	ВЫБОР
	|		КОГДА питРецептураИнгредиенты.Ссылка = &Ссылка2
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НомерРецептуры2,
	|	ВЫБОР
	|		КОГДА питРецептураИнгредиенты.Ссылка = &Ссылка3
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НомерРецептуры3
	|ИЗ
	|	Документ.питРецептура.Ингредиенты КАК питРецептураИнгредиенты
	|ГДЕ
	|	питРецептураИнгредиенты.Ссылка В (&Ссылка1, &Ссылка2, &Ссылка3)
	|
	|СГРУППИРОВАТЬ ПО
	|	питРецептураИнгредиенты.Упаковка,
	|	питРецептураИнгредиенты.Номенклатура,
	|	питРецептураИнгредиенты.Характеристика,
	|	питРецептураИнгредиенты.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Упаковка,
	|	питРецептураИнгредиенты.Ссылка";
	
	КоличествоРецептур = МассивРецептур.Количество();
	Запрос.УстановитьПараметр("Ссылка1", МассивРецептур[Мин(0,КоличествоРецептур-1)]);
	Запрос.УстановитьПараметр("Ссылка2", МассивРецептур[Мин(1,КоличествоРецептур-1)]);
	Запрос.УстановитьПараметр("Ссылка3", МассивРецептур[Мин(2,КоличествоРецептур-1)]);
	
	ТаблицаРецептур = Запрос.Выполнить().Выгрузить();
	
	// Идем по сводной таблице и записываем значения в таблицу проработки.
	ПредНоменклатура = "начало.";
	ПредХарактеристика = "начало.";
	ПредУпаковка = "начало.";
	СтрокаАктаПроработки = Неопределено;
	
	Для Каждого СтрокаРецептуры Из ТаблицаРецептур Цикл
		
		// Строки отсортированы по номенклатуре, 
		// для другой номенклатуры делаем новую строку.
		Если ПредНоменклатура <> СтрокаРецептуры.Номенклатура
			ИЛИ ПредХарактеристика <> СтрокаРецептуры.Характеристика
			ИЛИ ПредУпаковка <> СтрокаРецептуры.Упаковка Тогда
			
			СтрокаАктаПроработки = Объект.Ингредиенты.Добавить();
			
			ПредНоменклатура = СтрокаРецептуры.Номенклатура;
			ПредХарактеристика = СтрокаРецептуры.Характеристика;
			ПредУпаковка = СтрокаРецептуры.Упаковка;
			
		ИначеЕсли СтрокаАктаПроработки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаАктаПроработки, СтрокаРецептуры, "Номенклатура,Характеристика,Упаковка");
		
		Если СтрокаРецептуры.НомерРецептуры1 Тогда
			СтрокаАктаПроработки.КоличествоБрутто			= СтрокаРецептуры.КоличествоБрутто;
			СтрокаАктаПроработки.КоличествоНетто			= СтрокаРецептуры.КоличествоНетто;
			СтрокаАктаПроработки.КоличествоВыход			= СтрокаРецептуры.КоличествоВыход;
			СтрокаАктаПроработки.КоличествоУпаковокБрутто	= СтрокаРецептуры.КоличествоУпаковокБрутто;
			СтрокаАктаПроработки.КоличествоУпаковокНетто	= СтрокаРецептуры.КоличествоУпаковокНетто;
			СтрокаАктаПроработки.КоличествоУпаковокВыход	= СтрокаРецептуры.КоличествоУпаковокВыход;
		КонецЕсли;
		Если СтрокаРецептуры.НомерРецептуры2 Тогда
			СтрокаАктаПроработки.КоличествоБрутто1			= СтрокаРецептуры.КоличествоБрутто;
			СтрокаАктаПроработки.КоличествоНетто1			= СтрокаРецептуры.КоличествоНетто;
			СтрокаАктаПроработки.КоличествоВыход1			= СтрокаРецептуры.КоличествоВыход;
			СтрокаАктаПроработки.КоличествоУпаковокБрутто1	= СтрокаРецептуры.КоличествоУпаковокБрутто;
			СтрокаАктаПроработки.КоличествоУпаковокНетто1	= СтрокаРецептуры.КоличествоУпаковокНетто;
			СтрокаАктаПроработки.КоличествоУпаковокВыход1	= СтрокаРецептуры.КоличествоУпаковокВыход;
		КонецЕсли;
		Если СтрокаРецептуры.НомерРецептуры3 Тогда
			СтрокаАктаПроработки.КоличествоБрутто2			= СтрокаРецептуры.КоличествоБрутто;
			СтрокаАктаПроработки.КоличествоНетто2			= СтрокаРецептуры.КоличествоНетто;
			СтрокаАктаПроработки.КоличествоВыход2			= СтрокаРецептуры.КоличествоВыход;
			СтрокаАктаПроработки.КоличествоУпаковокБрутто2	= СтрокаРецептуры.КоличествоУпаковокБрутто;
			СтрокаАктаПроработки.КоличествоУпаковокНетто2	= СтрокаРецептуры.КоличествоУпаковокНетто;
			СтрокаАктаПроработки.КоличествоУпаковокВыход2	= СтрокаРецептуры.КоличествоУпаковокВыход;
		КонецЕсли;
		
	КонецЦикла;
	
	КэшированныеЗначенияУпаковок = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	Для Каждого СтрокаТаблицы Из Объект.Ингредиенты Цикл
		РассчитатьПроработку(СтрокаТаблицы, МассивРецептур,КэшированныеЗначенияУпаковок);
	КонецЦикла;
	
КонецПроцедуры

// Процедура рассчитывает значения экспериментов, которые используются
//  при выполнении проработки по рецептуре.
//  Количества брутто заполняются по генератору случайных чисел,
//  нетто и выход заполняются по процентам потерь холодной и горячей обработки.
//
// Параметры:
//  СтрокаТаблицы - Строка - Строка таблицы.
//  МассивРецептур - Массив - Массив рецептур.
//  КэшированныеЗначенияУпаковок - Произвольный - Кэшированные значения упаковок.
//
Процедура РассчитатьПроработку(СтрокаТаблицы, МассивРецептур=Неопределено, КэшированныеЗначенияУпаковок = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) ИЛИ СтрокаТаблицы.КоличествоУпаковокБрутто=0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(МассивРецептур)<>Тип("Массив") Тогда
		МассивРецептур = Новый Массив();
	КонецЕсли;
	
	ПроцентОтклоненияОтВеличины = питОбщегоНазначенияСервер.ПолучитьЗначениеПоУмолчанию("ОтклонениеОтБазовойВеличиныПриЗаполненииАктаПроработки");
	Если Не ЗначениеЗаполнено(ПроцентОтклоненияОтВеличины) Тогда
		ПроцентОтклоненияОтВеличины	= 10;
	КонецЕсли;
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.Номенклатура,
			"питПроцентПотерьПриХолоднойОбработке, питПроцентПотерьПриГорячейОбработке");
	КоэффициентПотерьПриХО = 1 - РеквизитыНоменклатуры.питПроцентПотерьПриХолоднойОбработке / 100;
	КоэффициентПотерьПриГО = 1 - РеквизитыНоменклатуры.питПроцентПотерьПриГорячейОбработке  / 100;
	
	// По умолчанию для новой строки КоличествоНетто и КоличествоВыход будет равно Количеству.
	Если СтрокаТаблицы.КоличествоУпаковокНетто=0 Тогда
		СтрокаТаблицы.КоличествоУпаковокНетто = СтрокаТаблицы.КоличествоУпаковокБрутто * КоэффициентПотерьПриХО;
	КонецЕсли;
	Если СтрокаТаблицы.КоличествоУпаковокВыход=0 Тогда
		СтрокаТаблицы.КоличествоУпаковокВыход = СтрокаТаблицы.КоличествоУпаковокНетто * КоэффициентПотерьПриГО;
	КонецЕсли;
	
	// Заполним структуру потерь при холодной и горячей обработке значениями из рецептур,
	// переданных в массиве.
	СтруктураПотерь = Новый Структура();
	Для Инд=1 По 3 Цикл
		
		Если МассивРецептур.Количество()>=Инд И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			
			Рецептура = МассивРецептур[Инд-1];
			НайденныеЗначения = Рецептура.Ингредиенты.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",СтрокаТаблицы.Номенклатура,СтрокаТаблицы.Характеристика));
			Если НайденныеЗначения.Количество() Тогда
				НайденноеЗначение = НайденныеЗначения[0];
			Иначе
				НайденноеЗначение = Неопределено;
			КонецЕсли;
			Если НайденноеЗначение<>Неопределено Тогда
				
				// Проценты берем из строки документа.
				// Если это старый документ, в котором явно не прописаны проценты, тогда рассчитываем процент по количествам.
				ПроцентПотерьПриХО = НайденноеЗначение.ПроцентПотерьПриХолоднойОбработке;
				Если ПроцентПотерьПриХО=0 И НЕ НайденноеЗначение.КоличествоУпаковокБрутто=НайденноеЗначение.КоличествоУпаковокНетто И НайденноеЗначение.КоличествоУпаковокБрутто<>0 Тогда
					КоэффициентПотерьПриХО = НайденноеЗначение.КоличествоУпаковокНетто / НайденноеЗначение.КоличествоУпаковокБрутто;
				Иначе
					КоэффициентПотерьПриХО = 1 - ПроцентПотерьПриХО / 100;
				КонецЕсли;
				
				ПроцентПотерьПриГО = НайденноеЗначение.ПроцентПотерьПриГорячейОбработке;
				Если ПроцентПотерьПриГО=0 И НЕ НайденноеЗначение.КоличествоУпаковокНетто=НайденноеЗначение.КоличествоУпаковокВыход И НайденноеЗначение.КоличествоУпаковокНетто<>0 Тогда
					КоэффициентПотерьПриГО = НайденноеЗначение.КоличествоУпаковокВыход / НайденноеЗначение.КоличествоУпаковокНетто;
				Иначе
					КоэффициентПотерьПриГО = 1 - ПроцентПотерьПриГО / 100;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		СтруктураПотерь.Вставить("КоэффициентПотерьПриХО"+Инд, КоэффициентПотерьПриХО);
		СтруктураПотерь.Вставить("КоэффициентПотерьПриГО"+Инд, КоэффициентПотерьПриГО);
		
	КонецЦикла;
	
	// Расчитаем значения опытов
	БазоваяВеличина = СтрокаТаблицы.КоличествоУпаковокБрутто;
	Если ЗначениеЗаполнено(БазоваяВеличина) Тогда
		
		ГСЧ = Новый ГенераторСлучайныхЧисел();
		ПорядокОкругления = 6;
		
		// Разброс значений делаем в пределах 3 десятичных знаков.
		// Случайное число получаем от 0,000 до 1,000. ГСЧ делает целые числа.
		ВерхняяГраница = 1000;
		Отклонение1 = ГСЧ.СлучайноеЧисло(0,ВерхняяГраница) / ВерхняяГраница;
		Отклонение2 = ГСЧ.СлучайноеЧисло(0,ВерхняяГраница) / ВерхняяГраница;
		
		// По условию постановки задания во втором опыте к базовой величине прибавляется новое значение.
		// В третьем эксперименте от базовой величины отнимается новое число.
		// Первый опыт определяется по остатку.
		СтрокаТаблицы.КоличествоУпаковокБрутто1 = Окр(БазоваяВеличина * (1 + Отклонение1 * ПроцентОтклоненияОтВеличины / 100), ПорядокОкругления);
		СтрокаТаблицы.КоличествоУпаковокБрутто2 = Окр(БазоваяВеличина * (1 - Отклонение2 * ПроцентОтклоненияОтВеличины / 100), ПорядокОкругления);
		СтрокаТаблицы.КоличествоУпаковокБрутто  = Окр(3*БазоваяВеличина, ПорядокОкругления) - СтрокаТаблицы.КоличествоУпаковокБрутто1 - СтрокаТаблицы.КоличествоУпаковокБрутто2;
		
		// Заполним нетто и выход на основании соответствующих процентов потерь при холодной и горячей обработках.
		СтрокаТаблицы.КоличествоУпаковокНетто  = СтрокаТаблицы.КоличествоУпаковокБрутто  * СтруктураПотерь.КоэффициентПотерьПриХО1;
		СтрокаТаблицы.КоличествоУпаковокНетто1 = СтрокаТаблицы.КоличествоУпаковокБрутто1 * СтруктураПотерь.КоэффициентПотерьПриХО2;
		СтрокаТаблицы.КоличествоУпаковокНетто2 = СтрокаТаблицы.КоличествоУпаковокБрутто2 * СтруктураПотерь.КоэффициентПотерьПриХО3;
		
		СтрокаТаблицы.КоличествоУпаковокВыход  = СтрокаТаблицы.КоличествоУпаковокНетто  * СтруктураПотерь.КоэффициентПотерьПриГО1;
		СтрокаТаблицы.КоличествоУпаковокВыход1 = СтрокаТаблицы.КоличествоУпаковокНетто1 * СтруктураПотерь.КоэффициентПотерьПриГО2;
		СтрокаТаблицы.КоличествоУпаковокВыход2 = СтрокаТаблицы.КоличествоУпаковокНетто2 * СтруктураПотерь.КоэффициентПотерьПриГО3;
		
		//////////////////////
		// Базовое количество.ъ
		КоэффициентУпаковки = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Упаковка, КэшированныеЗначенияУпаковок);
		СтрокаТаблицы.КоличествоБрутто1	= СтрокаТаблицы.КоличествоУпаковокБрутто1	* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоБрутто2	= СтрокаТаблицы.КоличествоУпаковокБрутто2	* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоБрутто	= СтрокаТаблицы.КоличествоУпаковокБрутто	* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоНетто	= СтрокаТаблицы.КоличествоУпаковокНетто		* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоНетто1	= СтрокаТаблицы.КоличествоУпаковокНетто1	* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоНетто2	= СтрокаТаблицы.КоличествоУпаковокНетто2	* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоВыход	= СтрокаТаблицы.КоличествоУпаковокВыход		* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоВыход1	= СтрокаТаблицы.КоличествоУпаковокВыход1	* КоэффициентУпаковки;
		СтрокаТаблицы.КоличествоВыход2	= СтрокаТаблицы.КоличествоУпаковокВыход2	* КоэффициентУпаковки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Печать

// Функция формирует табличный документ с печатной формой "Акт проработки"
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма акта проработки.
Функция ПечатьАктПроработки(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСлева  = 0;
	ТабличныйДокумент.ПолеСнизу  = 0;
	ТабличныйДокумент.ПолеСправа = 0;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_АктПроработки_Накладная";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.питАктПроработки.ПФ_MXL_АктПроработки");
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = ПолучитьТекстЗапросаДляФормированияПечатнойФормыАктПроработки();
	
	Шапка = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока Шапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		// Выводим шапку накладной
		
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОбластьЗаголовок.Параметры.Заполнить(Шапка);
		СведенияОбОрганизации    = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
		ПредставлениеОрганизации = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,");
		ОбластьЗаголовок.Параметры.Организация = ПредставлениеОрганизации;
		ОбластьЗаголовок.Параметры.ПодразделениеКомпании = Шапка.Подразделение;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		// Вывести табличную часть
		ВыборкаСтрокИнгредиенты = Шапка.Ингредиенты.Выбрать();
		
		ОбластьСтрока       = Макет.ПолучитьОбласть("Строка");
		
		ИтогоВыход = 0;
		
		Пока ВыборкаСтрокИнгредиенты.Следующий() Цикл
			
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтрокИнгредиенты);
			ОбластьСтрока.Параметры.Номенклатура = ВыборкаСтрокИнгредиенты.Товар 
			+ ?(ЗначениеЗаполнено(ВыборкаСтрокИнгредиенты.Характеристика), "; "+ВыборкаСтрокИнгредиенты.ТоварХарактеристика, "");
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			ИтогоВыход = ИтогоВыход + ВыборкаСтрокИнгредиенты.СреднееВыход;
			
		КонецЦикла;
		
		// Выводим подвал документа
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
		// Чтение значения для заведующего производством и руководителя
		Руководители = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(Шапка.Организация, Шапка.Дата);
		Если Руководители.Свойство("питЗаведующийПроизводством") Тогда
			ОбластьПодвал.Параметры.ЗаведующийПроизводством = Руководители.питЗаведующийПроизводствомНаименование;
		КонецЕсли;
		ОбластьПодвал.Параметры.Руководитель = Руководители.РуководительНаименование;
		
		Если Руководители.Свойство("питКалькулятор") Тогда
			ОбластьПодвал.Параметры.Калькулятор = Руководители.питКалькулятор;
		Иначе
			ОбластьПодвал.Параметры.Калькулятор = Шапка.Ответственный;
		КонецЕсли;
		ОбластьПодвал.Параметры.Выход = Шапка.Выход;  // Уточнить какой здесь нужен выход, сумма колонок, или из реквизита?
		ОбластьПодвал.Параметры.ТехнологияПриготовления = Шапка.ТехнологияПриготовления;
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

// Формирует и возвращает текст запроса для выборки данных,
//  необходимых для формирования печатной формы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьТекстЗапросаДляФормированияПечатнойФормыАктПроработки()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	питАктПроработки.Ссылка КАК Ссылка,
	|	питАктПроработки.Номер КАК Номер,
	|	питАктПроработки.Дата КАК Дата,
	|	питАктПроработки.Организация КАК Организация,
	|	питАктПроработки.Подразделение.Представление КАК Подразделение,
	|	питАктПроработки.Ответственный КАК Ответственный,
	|	питАктПроработки.Номенклатура КАК Номенклатура,
	|	питАктПроработки.Характеристика КАК Характеристика,
	|	питАктПроработки.Выход КАК Выход,
	|	питАктПроработки.ТехнологияПриготовления КАК ТехнологияПриготовления,
	|	питАктПроработки.Ингредиенты.(
	|		НомерСтроки КАК НомерСтроки,
	|		Номенклатура КАК Номенклатура,
	|		Характеристика КАК Характеристика,
	|		Номенклатура.НаименованиеПолное КАК Товар,
	|		Характеристика.Представление КАК ТоварХарактеристика,
	|		ВЫБОР
	|			КОГДА питАктПроработки.Ингредиенты.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|				ТОГДА питАктПроработки.Ингредиенты.Номенклатура.ЕдиницаИзмерения.Представление
	|			ИНАЧЕ питАктПроработки.Ингредиенты.Упаковка.Представление
	|		КОНЕЦ КАК ЕдиницаИзмерения,
	|		КоличествоУпаковокБрутто КАК Количество,
	|		КоличествоУпаковокНетто КАК КоличествоНетто,
	|		КоличествоУпаковокВыход КАК КоличествоВыход,
	|		КоличествоУпаковокБрутто1 КАК Количество1,
	|		КоличествоУпаковокНетто1 КАК КоличествоНетто1,
	|		КоличествоУпаковокВыход1 КАК КоличествоВыход1,
	|		КоличествоУпаковокБрутто2 КАК Количество2,
	|		КоличествоУпаковокНетто2 КАК КоличествоНетто2,
	|		КоличествоУпаковокВыход2 КАК КоличествоВыход2,
	|		ВЫРАЗИТЬ((питАктПроработки.Ингредиенты.КоличествоУпаковокБрутто + питАктПроработки.Ингредиенты.КоличествоУпаковокБрутто1 + питАктПроработки.Ингредиенты.КоличествоУпаковокБрутто2) / 3 КАК ЧИСЛО(15, 3)) КАК СреднееКоличество,
	|		ВЫРАЗИТЬ((питАктПроработки.Ингредиенты.КоличествоУпаковокНетто + питАктПроработки.Ингредиенты.КоличествоУпаковокНетто1 + питАктПроработки.Ингредиенты.КоличествоУпаковокНетто2) / 3 КАК ЧИСЛО(15, 3)) КАК СреднееНетто,
	|		ВЫРАЗИТЬ((питАктПроработки.Ингредиенты.КоличествоУпаковокВыход + питАктПроработки.Ингредиенты.КоличествоУпаковокВыход1 + питАктПроработки.Ингредиенты.КоличествоУпаковокВыход2) / 3 КАК ЧИСЛО(15, 3)) КАК СреднееВыход
	|	) КАК Ингредиенты
	|ИЗ
	|	Документ.питАктПроработки КАК питАктПроработки
	|ГДЕ
	|	питАктПроработки.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	питАктПроработки.Дата,
	|	питАктПроработки.Ссылка,
	|	питАктПроработки.Ингредиенты.НомерСтроки";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#КонецЕсли




