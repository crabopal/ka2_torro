//  Процедура - Товары номенклатура при изменении на сервере.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//  ПараметрыОбъекта - Произвольный - Параметры объекта.
//
&НаСервереБезКонтекста
Процедура ТоварыНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, Знач ПараметрыОбъекта)
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТабличнойЧасти.Номенклатура,
			"питВидНоменклатуры, питРецептурнаяУпаковка, питОсновнаяЕдиницаИзмерения, питПроцентПотерьПриХолоднойОбработке, питПроцентПотерьПриГорячейОбработке");
	
	СтрокаТабличнойЧасти.Упаковка = РеквизитыНоменклатуры.питРецептурнаяУпаковка;
	
	СтрокаТабличнойЧасти.ПроцентПотерьПриХолоднойОбработке = РеквизитыНоменклатуры.питПроцентПотерьПриХолоднойОбработке;
	СтрокаТабличнойЧасти.ПроцентПотерьПриГорячейОбработке = РеквизитыНоменклатуры.питПроцентПотерьПриГорячейОбработке;
	
	СтрокаТабличнойЧасти.ЭтоТовар = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Товар);
	СтрокаТабличнойЧасти.ЭтоБлюдо = (РеквизитыНоменклатуры.питВидНоменклатуры = Перечисления.питВидыНоменклатуры.Блюдо);
	СтрокаТабличнойЧасти.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(РеквизитыНоменклатуры.питВидНоменклатуры, Ложь);
	
КонецПроцедуры

//  Процедура - Таблица номенклатура при изменении.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ИсключитьДействия - Произвольный - Исключить действия.
//
&НаКлиенте
Процедура ТаблицаНоменклатураПриИзменении(ИмяТЧ, ИсключитьДействия = Неопределено)
	
	ТекущаяСтрока = Элементы[ИмяТЧ].ТекущиеДанные;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ДанныеОбУпаковке = ДанныеОбУпаковке(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Упаковка, КэшированныеЗначения);
	
	СтруктураДействий = Новый Структура;
	
	ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
	
	// Исключим указанные действия
	Если НЕ ИсключитьДействия = Неопределено И ТипЗнч(ИсключитьДействия) = Тип("Массив") Тогда
		Для каждого ТекИсключение Из ИсключитьДействия Цикл
			Если СтруктураДействий.Свойство(ТекИсключение) Тогда
				СтруктураДействий.Удалить(ТекИсключение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	ПосчитатьКоличестваВединицахХранения(ТекущаяСтрока);
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении номенклатуры.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  ТекущаяСтрока - Строка - Текущая строка.
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры(ИмяТЧ, ТекущаяСтрока, Форма, СтруктураДействий)
	
	Объект = Форма.Объект;
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		Форма.ИмяФормы, ИмяТЧ));
	
КонецПроцедуры

//  Процедура - Добавить в структуру действия при изменении количества упаковок.
//
// Параметры:
//  ИмяТЧ - Произвольный - Имя тч.
//  СтруктураДействий - Структура - Структура действий.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(ИмяТЧ, СтруктураДействий)
	
	ПараметрыПересчета = Новый Структура("НужноОкруглять", Ложь);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц", ПараметрыПересчета);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСБуферомОбмена

//  Процедура - Скопировать строки на сервере.
//
&НаСервере
Процедура СкопироватьСтрокиНаСервере()
	
	РаботаСТабличнымиЧастями.СкопироватьСтрокиВБуферОбмена(Объект.Ингредиенты, Элементы.Товары.ВыделенныеСтроки);
	
КонецПроцедуры

//  Процедура - Получить строки из буфера обмена.
//
&НаСервере
Процедура ПолучитьСтрокиИзБуфераОбмена()
	
	ТаблицаТоваров = РаботаСТабличнымиЧастями.СтрокиИзБуфераОбмена();
	Если Не ЗначениеЗаполнено(ТаблицаТоваров) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Ингредиенты.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		ДобавитьВСтруктуруДействияПриИзмененииНоменклатуры("Ингредиенты", ТекущаяСтрока, ЭтаФорма, СтруктураДействий);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - Пересчитать количество в шапке.
//
&НаКлиенте
Процедура ПересчитатьКоличествоВШапке()
	
	Перем ТекКоэффициент;
	
	ТекКоэффициент = питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Объект.Номенклатура,Объект.Упаковка);
	Объект.Количество = Объект.КоличествоУпаковок * ТекКоэффициент;

КонецПроцедуры

//  Функция - Получить параметры подбора.
//
// Параметры:
//  ИмяТаблицы - Строка - Имя таблицы.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция ПолучитьПараметрыПодбора(ИмяТаблицы = "Товары")
	
	ПараметрыФормы = Новый Структура;
	
	Если ИмяТаблицы = "Товары" Тогда
		
		ПараметрЗаголовок = НСтр("ru = 'Подбор товаров в %Документ%'");
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", Объект.Ссылка);
		Иначе
			ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Документ%", НСтр("ru = 'рецептуру'"));
		КонецЕсли;
		
		ОтборТипЦен = питОбщегоНазначения.ПолучитьЗначениеПоУмолчанию("НормативныйТипЦенОбщепит");
		ОтборЦенаВключаетНДС = питОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборТипЦен,"ЦенаВключаетНДС");
		
		ПараметрыФормы.Вставить("Заголовок",										ПараметрЗаголовок);
		ПараметрыФормы.Вставить("Дата",												Объект.Дата);
		ПараметрыФормы.Вставить("Организация",										Объект.Организация);
		ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти",	Ложь);
		ПараметрыФормы.Вставить("Документ",											Объект.Ссылка);
		ПараметрыФормы.Вставить("ОстаткиПоВсемСкладам",								Истина);
		ПараметрыФормы.Вставить("Валюта",											питПроизводствоПовтИсп.ПолучитьВалютуРегламентированногоУчета());
		ПараметрыФормы.Вставить("ВидЦены",											ОтборТипЦен);
		ПараметрыФормы.Вставить("ЦенаВключаетНДС",									ОтборЦенаВключаетНДС);
		ПараметрыФормы.Вставить("РежимПодбораБезСоглашенийСКлиентами",				Истина);
		
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции

//  Процедура - Обработка выбора подбор товаров клиент.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаКлиенте
Процедура ОбработкаВыбораПодборТоваровКлиент(ВыбранноеЗначение)
	
	ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение);
	ПосчитатьВсеКоличестваВединицахХранения();
	
КонецПроцедуры

//  Процедура - Обработка выбора подбор товаров на сервере.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
&НаСервере
Процедура ОбработкаВыбораПодборТоваровНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		// Произведем проверку, чтобы блюдо не включало в себя это же блюдо
		Если СтрокаТовара.Номенклатура = Объект.Номенклатура Тогда
			ТекстСообщения = "В таблицу товаров нельзя помещать блюдо из шапки документа. Номенклатура """+СтрокаТовара.Номенклатура+""" не добавлена.";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "Ингредиенты", "Объект", );
			// Пропускаем эту строку.
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока = Объект.Ингредиенты.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		Если НЕ ТаблицаТоваров.Колонки.Найти("КоличествоУпаковок") = Неопределено Тогда
			ТекущаяСтрока.КоличествоУпаковокБрутто	= СтрокаТовара.КоличествоУпаковок;
			ТекущаяСтрока.КоличествоУпаковокБрутто1	= СтрокаТовара.КоличествоУпаковок;
			ТекущаяСтрока.КоличествоУпаковокБрутто2	= СтрокаТовара.КоличествоУпаковок;
		КонецЕсли;
		Если НЕ ТаблицаТоваров.Колонки.Найти("Количество") = Неопределено Тогда
			ТекущаяСтрока.КоличествоБрутто			= СтрокаТовара.Количество;
			ТекущаяСтрока.КоличествоБрутто1			= СтрокаТовара.Количество;
			ТекущаяСтрока.КоличествоБрутто2			= СтрокаТовара.Количество;
		КонецЕсли;
		
		ТоварыНоменклатураПриИзмененииНаСервере(ТекущаяСтрока, Неопределено);
		
		Если ТекущаяСтрока.КоличествоУпаковокБрутто <> 0 Тогда
			РассчитатьПроработкуНаСервере(ТекущаяСтрока, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

//  Процедура - Заполнить по рецептурам на сервере.
//
// Параметры:
//  МассивРецептур - Массив - Массив рецептур.
//
&НаСервере
Процедура ЗаполнитьПоРецептурамНаСервере(МассивРецептур)
	
	Документы.питАктПроработки.ЗаполнитьПоРецептурам(Объект, МассивРецептур);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
КонецПроцедуры

/////////////////////////////////////////////////
// Формирование наименования

//  Процедура - Заполнить наименование акта.
//
// Параметры:
//  ПроверятьЗаполненность - Произвольный - Проверять заполненность.
//
&НаСервере
Процедура ЗаполнитьНаименованиеАкта(ПроверятьЗаполненность = Истина)
	
	// Заполнение наименования рецептуры.
	Если (ПроверятьЗаполненность И НЕ ЗначениеЗаполнено(Объект.Наименование)) 
		ИЛИ НЕ ПроверятьЗаполненность Тогда
		Объект.Наименование = Документы.питРецептура.СформироватьНаименованиеРецептуры(Объект.Номенклатура, Объект.Характеристика, Объект.ДатаНачала, Объект.ДатаКонца);
	КонецЕсли;

КонецПроцедуры

/////////////////////////////////////////////////
// Расчет проработки

//  Процедура - Рассчитать проработку.
//
// Параметры:
//  СтрокаТаблицы - Строка - Строка таблицы.
//
&НаКлиенте
Процедура РассчитатьПроработку(СтрокаТаблицы)
	
	ДанныеСтроки = Новый Структура("Номенклатура,Характеристика,КоличествоБрутто,КоличествоНетто,КоличествоВыход,
			|ПроцентПотерьПриХолоднойОбработке, ПроцентПотерьПриГорячейОбработке,
			|КоличествоБрутто1,КоличествоНетто1,КоличествоВыход1,КоличествоБрутто2,КоличествоНетто2,КоличествоВыход2,
			|КоличествоУпаковокБрутто1,КоличествоУпаковокНетто1,КоличествоУпаковокВыход1,КоличествоУпаковокБрутто2,КоличествоУпаковокНетто2,КоличествоУпаковокВыход2,
			|КоличествоУпаковокБрутто,КоличествоУпаковокНетто,КоличествоУпаковокВыход");
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы);
	РассчитатьПроработкуНаСервере(ДанныеСтроки);
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСтроки, "КоличествоБрутто,КоличествоНетто,КоличествоВыход,
			|КоличествоБрутто1,КоличествоНетто1,КоличествоВыход1,КоличествоБрутто2,КоличествоНетто2,КоличествоВыход2,
			|КоличествоУпаковокБрутто1,КоличествоУпаковокНетто1,КоличествоУпаковокВыход1,КоличествоУпаковокБрутто2,КоличествоУпаковокНетто2,КоличествоУпаковокВыход2,
			|КоличествоУпаковокБрутто,КоличествоУпаковокНетто,КоличествоУпаковокВыход");
	
КонецПроцедуры

//  Процедура - Рассчитать проработку на сервере.
//
// Параметры:
//  СтрокаТаблицы - Строка - Строка таблицы.
//  ЭтоПодбор - Произвольный - Это подбор.
//
&НаСервере
Процедура РассчитатьПроработкуНаСервере(СтрокаТаблицы, ЭтоПодбор=Ложь)
	
	ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокНетто, СтрокаТаблицы.КоличествоУпаковокБрутто, Ложь, СтрокаТаблицы);
	ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокВыход, СтрокаТаблицы.КоличествоУпаковокНетто, Истина, СтрокаТаблицы);
	
	Если СтрокаТаблицы.КоличествоУпаковокБрутто1 = 0 ИЛИ ЭтоПодбор Тогда
		СтрокаТаблицы.КоличествоУпаковокБрутто1 = СтрокаТаблицы.КоличествоУпаковокБрутто;
		ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокНетто1, СтрокаТаблицы.КоличествоУпаковокБрутто1, Ложь, СтрокаТаблицы);
		ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокВыход1, СтрокаТаблицы.КоличествоУпаковокНетто1, Истина, СтрокаТаблицы);
	КонецЕсли;
	
	Если СтрокаТаблицы.КоличествоУпаковокБрутто2 = 0 ИЛИ ЭтоПодбор Тогда
		СтрокаТаблицы.КоличествоУпаковокБрутто2 = СтрокаТаблицы.КоличествоУпаковокБрутто;
		ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокНетто2, СтрокаТаблицы.КоличествоУпаковокБрутто2, Ложь, СтрокаТаблицы);
		ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокВыход2, СтрокаТаблицы.КоличествоУпаковокНетто2, Истина, СтрокаТаблицы);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Расчитывает новое количество по проценту потерь.
//
// Параметры:
//  КоличествоРезультат - Произвольный - Количество результат.
//  КоличествоИсходное - Произвольный - Количество исходное.
//  ГорячаяОбработка - Произвольный - Горячая обработка.
//  СтрокаТаблицы - Строка - Строка таблицы.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОпределитьКоличество(КоличествоРезультат, КоличествоИсходное, ГорячаяОбработка=Ложь, СтрокаТаблицы)
	
	ПроцентПотерь = ?(ГорячаяОбработка=Истина, СтрокаТаблицы.ПроцентПотерьПриХолоднойОбработке, СтрокаТаблицы.ПроцентПотерьПриГорячейОбработке);
	ПорядокОкругления = 3;
	
	КоличествоРезультат = КоличествоИсходное * (100 - ПроцентПотерь) / 100;
	КоличествоРезультат = Окр(КоличествоРезультат, ПорядокОкругления);
	
КонецПроцедуры

//  Процедура - Номенклатура при изменении на сервере.
//
&НаСервере
Процедура НоменклатураПриИзмененииНаСервере()
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Объект.Номенклатура, Элементы.Упаковка);
	УстановитьХарактеристикиИспользуютсяВШапке();
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.Характеристика, ХарактеристикиИспользуются);
КонецПроцедуры

// Заполнение дополнительных колонок "Товары.ЭтоБлюдо", "Товары.ЭтоТовар", и др.
//
&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТовары.Номенклатура
	|ПОМЕСТИТЬ ТаблицаТовары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура,
	|	СправочникНоменклатура.питВидНоменклатуры КАК питВидНоменклатуры,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.питВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.питВидыНоменклатуры.Блюдо)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоБлюдо,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.питВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.питВидыНоменклатуры.Товар)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоТовар,
	|	СправочникНоменклатура.питПроцентПотерьПриХолоднойОбработке КАК ПроцентПотерьПриХолоднойОбработке,
	|	СправочникНоменклатура.питПроцентПотерьПриГорячейОбработке КАК ПроцентПотерьПриГорячейОбработке
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО ТаблицаТовары.Номенклатура = СправочникНоменклатура.Ссылка";
	
	ТаблицаТовары = Объект.Ингредиенты.Выгрузить(, "Номенклатура");
	Запрос.УстановитьПараметр("ТаблицаТовары", ТаблицаТовары);
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаТоваров = Результат[1].Выгрузить();
	ТаблицаТоваров.Индексы.Добавить("Номенклатура");
	
	Для Каждого СтрокаТабличнойЧасти Из Объект.Ингредиенты Цикл
		// Заполняем дополнительные колонки
		СтрокаТоваров = ТаблицаТоваров.Найти(СтрокаТабличнойЧасти.Номенклатура, "Номенклатура");
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаТоваров);
		
		СтрокаТабличнойЧасти.Иконка = питДокументы.ОпределитьНомерИконкиНоменклатуры(СтрокаТоваров.питВидНоменклатуры, Ложь);
		
		ЗаполнитьКолонкиСреднееКоличество(СтрокаТабличнойЧасти);
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - Заполнить колонки среднее количество.
//
// Параметры:
//  СтрокаТабличнойЧасти - Строка - Строка табличной части.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКолонкиСреднееКоличество(СтрокаТабличнойЧасти)
	СтрокаТабличнойЧасти.СреднееКоличество      = (СтрокаТабличнойЧасти.КоличествоУпаковокБрутто + СтрокаТабличнойЧасти.КоличествоУпаковокБрутто1 + СтрокаТабличнойЧасти.КоличествоУпаковокБрутто2) / 3;
	СтрокаТабличнойЧасти.СреднееКоличествоНетто = (СтрокаТабличнойЧасти.КоличествоУпаковокНетто + СтрокаТабличнойЧасти.КоличествоУпаковокНетто1 + СтрокаТабличнойЧасти.КоличествоУпаковокНетто2) / 3;
	СтрокаТабличнойЧасти.СреднееКоличествоВыход = (СтрокаТабличнойЧасти.КоличествоУпаковокВыход + СтрокаТабличнойЧасти.КоличествоУпаковокВыход1 + СтрокаТабличнойЧасти.КоличествоУпаковокВыход2) / 3;
КонецПроцедуры

//  Процедура - Посчитать количества вединицах хранения.
//
// Параметры:
//  ТекущаяСтрока - Строка - Текущая строка.
//
&НаКлиенте
Процедура ПосчитатьКоличестваВединицахХранения(ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	КонецЕсли;
	
	КэшированныеЗначения = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ДанныеОбУпаковке = ДанныеОбУпаковке(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Упаковка, КэшированныеЗначения);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс", Новый Структура("Суффикс, НужноОкруглять", "Брутто", Ложь));
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Нетто";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Выход";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Брутто1";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Нетто1";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Выход1";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Брутто2";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Нетто2";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
	СтруктураДействий.ПересчитатьКоличествоЕдиницСуффикс.Суффикс = "Выход2";
	ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры

