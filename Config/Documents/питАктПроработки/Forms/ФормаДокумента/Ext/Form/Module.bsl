//  Процедура - Заполнить служебные реквизиты по номенклатуре.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
											Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
											Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
											Новый Структура("Номенклатура", "ТипНоменклатуры"));
											
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Ингредиенты,	ПараметрыЗаполненияРеквизитов);
	
КонецПроцедуры

//  Функция - Данные об упаковке.
//
// Параметры:
//  ТекНоменклатура - Произвольный - Тек номенклатура.
//  ТекУпаковка - Произвольный - Тек упаковка.
//  ТекКэшированныеЗначения - Произвольный - Тек кэшированные значения.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ДанныеОбУпаковке(ТекНоменклатура, ТекУпаковка, ТекКэшированныеЗначения)
	Возврат ПакетнаяОбработкаТабличнойЧастиСервер.ДанныеОбУпаковке(ТекНоменклатура, ТекУпаковка, ТекКэшированныеЗначения);
КонецФункции

//  Процедура - Установить характеристики используются в шапке.
//
&НаСервере
Процедура УстановитьХарактеристикиИспользуютсяВШапке()
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		ХарактеристикиИспользуются = питОбщегоНазначения.ХарактеристикиИспользуются(Объект.Номенклатура);
	Иначе
		ХарактеристикиИспользуются = Ложь;
	КонецЕсли;

КонецПроцедуры

//  Процедура - Подключаемый выполнить команду на сервере.
//
