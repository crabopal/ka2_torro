// Таблица ингредиентов

//  Процедура - Товары при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Товары при окончании редактирования.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  НоваяСтрока - Строка - Новая строка.
//  ОтменаРедактирования - Произвольный - Отмена редактирования.
//
&НаКлиенте
Процедура ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ЗаполнитьКолонкиСреднееКоличество(Элемент.ТекущиеДанные);
КонецПроцедуры

/////////////////////////////////////////////////
// Ингредиенты.Номенклатура

//  Процедура - Товары номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ДанныеСтрокаТаблицы = Новый Структура("Номенклатура, Характеристика, Количество, КоличествоУпаковок, Упаковка,
			|ПроцентПотерьПриХолоднойОбработке, ПроцентПотерьПриГорячейОбработке, ЭтоТовар, ЭтоБлюдо, Иконка");
	ЗаполнитьЗначенияСвойств(ДанныеСтрокаТаблицы, Элементы.Товары.ТекущиеДанные);
	
	ПараметрыОбъекта = Новый Структура("Организация, Дата, Ссылка");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
	
	ТоварыНоменклатураПриИзмененииНаСервере(ДанныеСтрокаТаблицы, ПараметрыОбъекта);
	
	ЗаполнитьЗначенияСвойств(Элементы.Товары.ТекущиеДанные, ДанныеСтрокаТаблицы);
	
	ТаблицаНоменклатураПриИзменении("Товары");
	
КонецПроцедуры

/////////////////////////////////////////////////
// Ингредиенты.Упаковка

//  Процедура - Товары упаковка при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыУпаковкаПриИзменении(Элемент)
	ПосчитатьКоличестваВединицахХранения();
КонецПроцедуры

/////////////////////////////////////////////////
// Ингредиенты.Количество

//  Процедура - Товары количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	
	// Заполним все количества
	РассчитатьПроработку(СтрокаТаблицы);
	
	ПосчитатьКоличестваВединицахХранения();
	
КонецПроцедуры

//  Процедура - Товары количество 1 при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличество1ПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокНетто1, СтрокаТаблицы.КоличествоУпаковокБрутто1, Ложь, СтрокаТаблицы);
	ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокВыход1, СтрокаТаблицы.КоличествоУпаковокНетто1, Истина, СтрокаТаблицы);
	
	ПосчитатьКоличестваВединицахХранения();
	
КонецПроцедуры

//  Процедура - Товары количество 2 при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличество2ПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокНетто2, СтрокаТаблицы.КоличествоУпаковокБрутто2, Ложь, СтрокаТаблицы);
	ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокВыход2, СтрокаТаблицы.КоличествоУпаковокНетто2, Истина, СтрокаТаблицы);
	
	ПосчитатьКоличестваВединицахХранения();
	
КонецПроцедуры

//  Процедура - Товары количество нетто при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоНеттоПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ОпределитьКоличество(СтрокаТаблицы.КоличествоУпаковокВыход, СтрокаТаблицы.КоличествоУпаковокНетто, Истина, СтрокаТаблицы);
	
	ПосчитатьКоличестваВединицахХранения();
	
КонецПроцедуры

//  Процедура - Товары количество нетто 1 при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ТоварыКоличествоНетто1ПриИзменении(Элемент)
