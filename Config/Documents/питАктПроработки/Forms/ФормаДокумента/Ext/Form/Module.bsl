//  Процедура - Разбить строку.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура РазбитьСтроку(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	
	ТаблицаФормы  = Элементы.Товары;
	ДанныеТаблицы = Объект.Ингредиенты;
	
	Оповещение = Новый ОписаниеОповещения("РазбитьСтрокуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	РаботаСТабличнымиЧастямиКлиент.РазбитьСтроку(ДанныеТаблицы, ТаблицаФормы,
		Оповещение);
	
КонецПроцедуры

//  Процедура - Вставить строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВставитьСтроки(Команда)
	
	КоличествоТоваровДоВставки = Объект.Ингредиенты.Количество();
	
	ПолучитьСтрокиИзБуфераОбмена();
	ПосчитатьВсеКоличестваВединицахХранения();
	КоличествоВставленных = Объект.Ингредиенты.Количество()-КоличествоТоваровДоВставки;
	РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОВставкеСтрок(КоличествоВставленных);
	
КонецПроцедуры

//  Процедура - Скопировать строки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СкопироватьСтроки(Команда)
	
	Для каждого ТекВыделеннаяСтрока Из Элементы.Товары.ВыделенныеСтроки Цикл
		ДанныеСтроки = Объект.Ингредиенты.НайтиПоИдентификатору(ТекВыделеннаяСтрока);
		ДанныеСтроки.Количество			= ДанныеСтроки.КоличествоВыход;
		ДанныеСтроки.КоличествоУпаковок	= ДанныеСтроки.КоличествоУпаковокВыход;
	КонецЦикла;
	
	КоличествоСтрок = Элементы.Товары.ВыделенныеСтроки.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если РаботаСТабличнымиЧастямиКлиент.ВыбранаСтрокаДляВыполненияКоманды(Элементы.Товары) Тогда
		СкопироватьСтрокиНаСервере();
		РаботаСТабличнымиЧастямиКлиент.ОповеститьПользователяОКопированииСтрок(КоличествоСтрок);
	КонецЕсли;

КонецПроцедуры

