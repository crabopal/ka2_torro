//  Процедура - Количество при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	Если Объект.КоличествоУпаковок=0 Тогда
		ПоказатьПредупреждение(,"Количество не может быть нулевым");
		Объект.КоличествоУпаковок = ПредыдущееКоличество;
		
		// Если количество изменили, то предложим пересчитать табличную часть
	ИначеЕсли Объект.КоличествоУпаковок<>ПредыдущееКоличество И ПредыдущееКоличество<>0 Тогда
		
		ПересчитатьКоличествоВШапке();
		
		Если Объект.Ингредиенты.Количество() > 0 Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("КоличествоПриИзменении_Завершение", ЭтотОбъект), "Пересчитать количества в табличной части ?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Дата начала при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ДатаКонца) И Объект.ДатаНачала > Объект.ДатаКонца  Тогда
		ТекстСообщения = "Конечная дата периода действия меньше начальной даты, необходимо исправить.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "ДатаКонца", "Объект", );
	КонецЕсли;
КонецПроцедуры

//  Процедура - Дата конца при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДатаКонцаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ДатаКонца) И Формат(Объект.ДатаКонца,"ДФ=ЧЧммсс; ДП=000000") = "000000" Тогда
		Объект.ДатаКонца = КонецДня(Объект.ДатаКонца);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.ДатаКонца) И Объект.ДатаНачала > Объект.ДатаКонца Тогда
		ТекстСообщения = "Начальная дата периода действия больше конечной даты, необходимо исправить.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "ДатаНачала", "Объект", );
	КонецЕсли;
КонецПроцедуры

