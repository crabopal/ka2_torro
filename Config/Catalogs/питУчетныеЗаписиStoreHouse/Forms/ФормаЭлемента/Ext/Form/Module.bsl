

#Область ПрограммныйИнтерфейс

//  Процедура - Параметры загрузки служебный каталог начало выбора завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	текСтрока = ДополнительныеПараметры.текСтрока;
	Если Результат <> Неопределено Тогда
		текДанные = Объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
		текДанные.СлужебныйКаталог = Результат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	Обработки.питЗагрузкаStoreHouse.ИнициализацияПараметровЗагрузки(Объект.ПараметрыЗагрузки);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

//  Процедура - Параметры загрузки служебный каталог начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	текСтрока = Элементы.ПараметрыЗагрузки.ТекущаяСтрока;
	СтандартнаяОбработка = Ложь;
	ИмяМетаданных = ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока);
	Если ИмяМетаданных = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для данного типа объекта не ведется иерархия");
		Возврат;
	Иначе
		ПараметрыФормы = новый Структура("РежимВыбора",Истина);
		ОткрытьФорму("Справочник."+ИмяМетаданных+".ФормаВыбораГруппы",ПараметрыФормы,,,,, Новый ОписаниеОповещения("ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("текСтрока", текСтрока)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

//  Процедура - Проверка подключения.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПроверкаПодключения(Команда)
	ПроверкаПодключенияНаСервере();
КонецПроцедуры

//  Процедура - Сохранить параметры загрузки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СохранитьПараметрыЗагрузки(Команда)
	СохранитьПараметрыЗагрузкиНаСервере();
КонецПроцедуры

//  Процедура - Обновить параметры загрузки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ОбновитьПараметрыЗагрузки(Команда)
	ОбновитьПараметрыЗагрузкиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - Проверка подключения на сервере.
//
&НаСервере
Процедура ПроверкаПодключенияНаСервере()
	// Выполним подключение к БД
	Обработки.питЗагрузкаStoreHouse.ПодключитьсяКВнешнемуИсточникуДанных(Объект);
	
	Если НЕ Обработки.питЗагрузкаStoreHouse.ПодключениеАктивно(Объект.ФорматОбмена) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подключение не установлено");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подключение установлено");
	КонецЕсли;
КонецПроцедуры

//  Процедура - Сохранить параметры загрузки на сервере.
//
&НаСервере
Процедура СохранитьПараметрыЗагрузкиНаСервере()
	Для Каждого СтрокаТипа Из Объект.ПараметрыЗагрузки Цикл
		ТипОбъектаОбъект = СтрокаТипа.ТипОбъекта.ПолучитьОбъект();
		ТипОбъектаОбъект.Обновлять = СтрокаТипа.Обновлять;
		ТипОбъектаОбъект.Создавать = СтрокаТипа.Создавать;
		ТипОбъектаОбъект.СлужебныйКаталог = СтрокаТипа.СлужебныйКаталог;
		ТипОбъектаОбъект.ОбработкаОшибок = СтрокаТипа.ОбработкаОшибок;
		
		Попытка
			ТипОбъектаОбъект.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

//  Процедура - Обновить параметры загрузки на сервере.
//
&НаСервере
Процедура ОбновитьПараметрыЗагрузкиНаСервере()
	Обработки.питЗагрузкаStoreHouse.ИнициализацияПараметровЗагрузки(Объект.ПараметрыЗагрузки);
КонецПроцедуры

//  Функция - Получить имя метаданных строки параметров.
//
// Параметры:
//  текСтрока - Строка - тек строка.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
Функция ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока)
	текДанные = объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
	
	ЕстьИерархия = Ложь;
	ТипЗначения = текДанные.ТипОбъекта.ТипЗначения;
	Для Каждого Тип Из ТипЗначения.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если НЕ МетаданныеТипа = Неопределено И МетаданныеТипа.Иерархический Тогда
			ЕстьИерархия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьИерархия Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МетаданныеТипа.Имя;
КонецФункции

#КонецОбласти



