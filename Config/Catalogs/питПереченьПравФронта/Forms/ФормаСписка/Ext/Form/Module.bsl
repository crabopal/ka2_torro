Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементов

// Обработчик события списка "При активации строки".
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		Комментарий = ПолучитьКомментарий(ТекущаяСтрока);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция получения комментария права.
//
&НаСервере
Функция ПолучитьКомментарий(Право)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	питПереченьПравФронта.Комментарий
	|ИЗ
	|	Справочник.питПереченьПравФронта КАК питПереченьПравФронта
	|ГДЕ
	|	питПереченьПравФронта.Ссылка = &Право";
	Запрос.УстановитьПараметр("Право", Право);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Комментарий;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

#КонецОбласти
