	РегистрСведений.питАктуальныеРецептуры.СрезПоследних(, (Номенклатура) В (&amp;ТаблицаНоменклатурыНоменклатура) И (Характеристика) В (&amp;ТаблицаНоменклатурыХарактеристика) {(Номенклатура).* КАК НоменклатураРецептур, (Характеристика).* КАК ХарактеристикаРецептур, (Рецептура).* КАК РецептураОтбор, (Подразделение).* КАК ПодразделениеРецептур, (Организация).* КАК ОрганизацияРецептур}) КАК питАктуальныеРецептурыСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втДанные.Номенклатура КАК Номенклатура,
	втДанные.Характеристика КАК Характеристика,
	МАКСИМУМ(втДанные.ДатаРецептуры) КАК ДатаРецептуры
ПОМЕСТИТЬ втНоменклатура
ИЗ
	втДанные КАК втДанные

СГРУППИРОВАТЬ ПО
	втДанные.Номенклатура,
	втДанные.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втНоменклатура.Номенклатура КАК Номенклатура,
	втНоменклатура.Характеристика КАК Характеристика,
	ЕСТЬNULL(втДанные.Рецептура, ЗНАЧЕНИЕ(Документ.питРецептура.ПустаяСсылка)) КАК Рецептура,
	ЕСТЬNULL(втДанные.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
	ЕСТЬNULL(втДанные.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	ЕСТЬNULL(втДанные.Рецептура.Количество, 1) КАК КоличествоВРецептуре,
	1 КАК Коэффициент,
	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	0 КАК Цена
ИЗ
	втНоменклатура КАК втНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ втДанные КАК втДанные
		ПО втНоменклатура.Номенклатура = втДанные.Номенклатура
			И втНоменклатура.Характеристика = втДанные.Характеристика
			И втНоменклатура.ДатаРецептуры = втДанные.ДатаРецептуры</query>
	</dataSet>
