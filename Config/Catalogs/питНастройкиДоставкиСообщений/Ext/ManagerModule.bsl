// Функция - Получить данные предопределенного элемента фастфуд эво.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьДанныеПредопределенногоЭлемента_ФастфудЭво()
	
	// Получим структуру элемента по умолчанию.
	ДанныеЭлемента = ПолучитьСтруктуруПредопределенногоЭлемента();
	
	ДанныеЭлемента.Наименование = НСтр("ru='HTTP сервер 1С-Рарус:Фастфуд.Эво'", "ru");
	ДанныеЭлемента.УникальныйИдентификатор = ПолучитьИДПредопределенногоЭлемента_ФастфудЭво();
	
	ДанныеЭлемента.СпособОбмена = 4;
	ДанныеЭлемента.АдресСервераHTTP = "food.corp.rarus-cloud.ru";
	ДанныеЭлемента.ПортHTTP = 443;
	
	Возврат ДанныеЭлемента;
	
КонецФункции

#КонецОбласти

