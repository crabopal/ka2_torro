// Процедура - Заполнить предопределенные элементы.
//
// Параметры:
//  СсылкаНаПредопределенныйЭлемент - Произвольный - Ссылка на предопределенный элемент.
//
Процедура ЗаполнитьПредопределенныеЭлементы(СсылкаНаПредопределенныйЭлемент = Неопределено) Экспорт
	
	// Получить таблицу всех предопределенных элементов.
	ТЗДанных = ПолучитьДанныеПредопределенныхЭлементов();
	
	Для Каждого Строки Из ТЗДанных Цикл 
		
		// Получим ссылку на объект.
		Ссылка = ПолучитьПредопределенныйЭлемент(Строки.УникальныйИдентификатор);
		Если ЗначениеЗаполнено(СсылкаНаПредопределенныйЭлемент) И НЕ Ссылка = СсылкаНаПредопределенныйЭлемент Тогда
			Продолжить;
		КонецЕсли;
		
		НужноЗаписать = Ложь;
		
		// Получим объект.
		Объект = Неопределено;
		Если ЗначениеЗаполнено(Ссылка) И НЕ ПустаяСтрока(Ссылка.ВерсияДанных) Тогда
			Объект = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если Объект = Неопределено Тогда
			// Создадим новый элемент.
			Если НЕ Строки.ЭтоГруппа Тогда
				Объект = МенеджерОбъектаПредопределенныхДанных().СоздатьЭлемент();
			Иначе
				Объект = МенеджерОбъектаПредопределенныхДанных().СоздатьГруппу();
			КонецЕсли;
			Объект.УстановитьСсылкуНового(Ссылка);
			НужноЗаписать = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Код) Тогда
			// Установим код.
			Объект.УстановитьНовыйКод();
			НужноЗаписать = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
			// Установим наименование.
			Объект.Наименование = Строки.Наименование;
			НужноЗаписать = Истина;
		КонецЕсли;
		
		Если НЕ Строки.ЭтоГруппа Тогда
			Если НЕ ЗначениеЗаполнено(Объект.СпособОбмена) Тогда
				// Установим наименование.
				Объект.СпособОбмена = Строки.СпособОбмена;
				НужноЗаписать = Истина;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Объект.АдресСервераHTTP) 
				И ЗначениеЗаполнено(Строки.АдресСервераHTTP) Тогда
				// Установим наименование.
				Объект.АдресСервераHTTP = Строки.АдресСервераHTTP;
				НужноЗаписать = Истина;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Объект.ПортHTTP)
				И ЗначениеЗаполнено(Строки.ПортHTTP) Тогда
				// Установим наименование.
				Объект.ПортHTTP = Строки.ПортHTTP;
				НужноЗаписать = Истина;
			КонецЕсли;
			
			
		КонецЕсли;
		
		Если НужноЗаписать Тогда
			Попытка
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
				Объект.Записать();
				НужноЗаписать = Ложь;
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);
				ЗаписьЖурналаРегистрации("ОбновлениеИБ.ЗаполнениеПредопределенных", УровеньЖурналаРегистрации.Ошибка, , Объект, ТекстОшибки);
				Прервать;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция - Это предопределенный элемент.
//
// Параметры:
//  ТекЭлемент - Произвольный - Тек элемент.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ЭтоПредопределенныйЭлемент(ТекЭлемент) Экспорт
	Результат = Ложь;
	Если НЕ ЗначениеЗаполнено(ТекЭлемент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекИД = питОбменДанными.ПолучитьИДПоСсылке(ТекЭлемент,Ложь);
	
	ТаблицаДанных = ПолучитьДанныеПредопределенныхЭлементов();
	Для Каждого ТекСтрока Из ТаблицаДанных Цикл
		Если ТекИД = ТекСтрока.УникальныйИдентификатор Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПредопределенныеЭлементы

