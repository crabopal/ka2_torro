// Функция - Менеджер объекта предопределенных данных.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция МенеджерОбъектаПредопределенныхДанных()
	Результат = Справочники.питНастройкиДоставкиСообщений;
	Возврат Результат;
КонецФункции

// Функция - Получить данные предопределенных элементов
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица данных по всем предопределенным элементам.
Функция ПолучитьДанныеПредопределенныхЭлементов()
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Наименование");
	ТаблицаДанных.Колонки.Добавить("УникальныйИдентификатор");
	ТаблицаДанных.Колонки.Добавить("ЭтоГруппа");
	
	// Дополнительные свойства.
	ТаблицаДанных.Колонки.Добавить("СпособОбмена");
	ТаблицаДанных.Колонки.Добавить("АдресСервераHTTP");
	ТаблицаДанных.Колонки.Добавить("ПортHTTP");
	
	
	
	// Зафиксируем.
	НоваяСтрока = ТаблицаДанных.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПолучитьДанныеПредопределенногоЭлемента_ФастфудЭво());
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Функция - Получить структуру предопределенного элемента.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция ПолучитьСтруктуруПредопределенногоЭлемента()
	
	// Получим список свойств.
	ВходныеПараметры = Новый Структура;
	// Свойства по умолчанию.
	ВходныеПараметры.Вставить("Наименование","");
	ВходныеПараметры.Вставить("УникальныйИдентификатор","");
	ВходныеПараметры.Вставить("ЭтоГруппа", Ложь);
	ВходныеПараметры.Вставить("СпособОбмена",0);
	ВходныеПараметры.Вставить("АдресСервераHTTP","");
	ВходныеПараметры.Вставить("ПортHTTP","");
	
	// Дополнительные свойства.
	
	Возврат ВходныеПараметры;
КонецФункции

