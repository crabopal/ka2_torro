
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Стандартный обработчик ПередЗаписью элемента справочника.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = ПолучитьОбязательныеРеквизиты(НЕ ЭтоГруппа);
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект[Реквизит.Ключ]) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен реквизит """ + СокрЛП(Реквизит.Ключ) + """", ЭтотОбъект, Реквизит.Ключ);
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Реквизит.Значение = 2 Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	питНастройкиДоставкиСообщений.Ссылка
			|ИЗ
			|	Справочник.питНастройкиДоставкиСообщений КАК питНастройкиДоставкиСообщений
			|ГДЕ
			|	питНастройкиДоставкиСообщений." + Реквизит.Ключ + " = &ПроверяемыйРеквизит
			|	И питНастройкиДоставкиСообщений.Ссылка <> &Ссылка";
			Запрос.УстановитьПараметр("ПроверяемыйРеквизит", ЭтотОбъект[Реквизит.Ключ]);
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Результат = Запрос.Выполнить();
			Если НЕ Результат.Пустой() Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не уникален реквизит """ + СокрЛП(Реквизит.Ключ) + """", ЭтотОбъект, Реквизит.Ключ);
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает структуру обязательных / уникальных реквизитов элемента.
//  Если ДляЭлемента = Истина, возвращаемая структура содержит реквизиты для проверки элемента.
//  Если ДляГруппы = Истина, аналогично для группы
//  Возвращаемая структура содержит строковые идентификаторы реквизитов или вложенные структуры для табличных частей.
//  Для реквизита значение структуры содержит число 1-Обязательный, 2-Уникальный.
//
// Параметры:
//  ДляЭлемента - Произвольный - Для элемента.
//
// Возвращаемое значение:
//   Структура - Обязательные реквизиты, структура, содержащая реквизиты для проверки элемента или группы элементов.
Функция ПолучитьОбязательныеРеквизиты(ДляЭлемента = Истина)
	
	ОбязательныеРеквизиты = Новый Структура();
	
	Если ДляЭлемента Тогда
		ОбязательныеРеквизиты.Вставить("КаталогОбменов", 1);
		Если СпособОбмена = 1 Тогда
			ОбязательныеРеквизиты.Вставить("АдресЭлектроннойПочты", 1);
		ИначеЕсли СпособОбмена = 2 Тогда
			ОбязательныеРеквизиты.Вставить("АдресЭлектроннойПочты", 1);
			ОбязательныеРеквизиты.Вставить("СерверPOP3", 1);
			ОбязательныеРеквизиты.Вставить("ПортPOP3", 1);
			ОбязательныеРеквизиты.Вставить("ПользовательPOP3", 1);
			ОбязательныеРеквизиты.Вставить("СерверSMTP", 1);
			ОбязательныеРеквизиты.Вставить("ПортSMTP", 1);
			ОбязательныеРеквизиты.Вставить("ПользовательSMTP", 1);
		ИначеЕсли СпособОбмена = 3 Тогда
			ОбязательныеРеквизиты.Вставить("СерверFTP", 1);
			ОбязательныеРеквизиты.Вставить("ПортFTP", 1);
			ОбязательныеРеквизиты.Вставить("ПользовательFTP", 1);
		ИначеЕсли СпособОбмена = 4 Тогда
			ОбязательныеРеквизиты.Вставить("АдресСервераHTTP", 1);
			ОбязательныеРеквизиты.Удалить("КаталогОбменов");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОбязательныеРеквизиты;
КонецФункции

#КонецОбласти

#КонецЕсли




