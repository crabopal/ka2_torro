
#Область ПрограммныйИнтерфейс

//  Процедура - Подключить расширение работы с файлами 1 завершение.
//
// Параметры:
//  Подключено - Произвольный - Подключено.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПодключитьРасширениеРаботыСФайлами_1_Завершение(Подключено, ДополнительныеПараметры) Экспорт
	Если НЕ Подключено Тогда
		// Если не подключились пробуем установить
		НачатьУстановкуРасширенияРаботыСФайлами(Новый ОписаниеОповещения("УстановитьРасширениеРаботыСФайлами_Завершение", ЭтотОбъект));
		Возврат;
	КонецЕсли;
	
	КаталогОбменовНачалоВыбораФрагмент();
КонецПроцедуры

//  Процедура - Установить расширение работы с файлами завершение.
//
// Параметры:
//  ДополнительныеПараметры1 - Произвольный - Дополнительные параметры 1.
//
&НаКлиенте
Процедура УстановитьРасширениеРаботыСФайлами_Завершение(ДополнительныеПараметры1) Экспорт
	// После установки пробуем подключится еще раз
	НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("ПодключитьРасширениеРаботыСФайлами_2_Завершение", ЭтотОбъект));
	
КонецПроцедуры

//  Процедура - Подключить расширение работы с файлами 2 завершение.
//
// Параметры:
//  Подключено - Произвольный - Подключено.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПодключитьРасширениеРаботыСФайлами_2_Завершение(Подключено, ДополнительныеПараметры) Экспорт
	
	Если НЕ Подключено Тогда
		// Это вторая попытка подключения. Уже после установки. Значит ничего не получилось
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Не удалось подключить расширение работы с файлами!
		|Выбор файла аудиторского заключения невозможен.'"));
		Возврат;
	КонецЕсли;
	
	КаталогОбменовНачалоВыбораФрагмент();
	
КонецПроцедуры

//  Процедура - Выбор катаолого диалогом завершение.
//
// Параметры:
//  ВыбранныеФайлы - Произвольный - Выбранные файлы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВыборКатаологоДиалогом_Завершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	Если НЕ (ВыбранныеФайлы <> Неопределено) Тогда
		Возврат;
	КонецЕсли;
	Объект.КаталогОбменов = Диалог.Каталог;
	
	Если Прав(Объект.КаталогОбменов,1) <> "\" И Прав(Объект.КаталогОбменов,1) <> "/" Тогда
		Объект.КаталогОбменов = Объект.КаталогОбменов + Слеш;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Диалог выбора каталога завершение.
//
// Параметры:
//  ВыбранныеФайлы - Произвольный - Выбранные файлы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ДиалогВыбораКаталога_Завершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	Диалог = ДополнительныеПараметры.Диалог;
	Элемент = ДополнительныеПараметры.Элемент;
	
	
	Если НЕ (ВыбранныеФайлы <> Неопределено) Тогда 
		Возврат; 
	КонецЕсли;
	
	
	
	Объект[Элемент.Имя] = Диалог.Каталог;
	
	Объект[Элемент.Имя] = СокрЛП(Объект[Элемент.Имя]);
	Если НЕ ПустаяСтрока(Объект[Элемент.Имя]) И Прав(Объект[Элемент.Имя],1) <> "\" И Прав(Объект[Элемент.Имя],1) <> "/" Тогда
		Объект[Элемент.Имя] = Объект[Элемент.Имя] + Слеш;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Каталог отправленных сообщений подкл расширение завершение.
//
// Параметры:
