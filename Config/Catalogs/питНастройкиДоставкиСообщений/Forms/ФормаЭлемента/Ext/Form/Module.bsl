	Если НЕ ПустаяСтрока(Объект.КаталогОбменаFTP) И Лев(Объект.КаталогОбменаFTP, 1) <> "/" Тогда
		Объект.КаталогОбменаFTP = "/" + Объект.КаталогОбменаFTP;
	КонецЕсли; 
	УстановитьНаименованиеПоУмолчанию();
КонецПроцедуры

