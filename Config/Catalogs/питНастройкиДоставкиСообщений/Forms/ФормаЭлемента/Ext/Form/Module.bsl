	УстановитьДоступностьЭлементовУправления();
КонецПроцедуры

// Обработчик измеения флага "Использовать временный каталог"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ИспользоватьВременныйКаталогПриИзменении(Элемент)
	УстановитьКаталог(Объект.ИспользоватьВременныйКаталог, Объект.КаталогВременныхФайлов, "Temp");
	УстановитьДоступностьЭлементовУправления();
КонецПроцедуры

// Обработчик изменения флага "Единые параметры".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЕдиныеПараметрыПриИзменении(Элемент = Неопределено)
	Если ЕдиныеПараметры Тогда
		Объект.СерверSMTP       = Объект.СерверPOP3;
		Объект.ПользовательSMTP = Объект.ПользовательPOP3;
		Объект.ПарольSMTP       = Объект.ПарольPOP3;
		
	ИначеЕсли Объект.СерверSMTP = Объект.СерверPOP3 И Объект.ПользовательSMTP = Объект.ПользовательPOP3 И Объект.ПарольSMTP = Объект.ПарольPOP3 Тогда
		Если Элемент = Неопределено Тогда
			ЕдиныеПараметры = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.СерверSMTP.Доступность       = НЕ ЕдиныеПараметры;
	Элементы.ПользовательSMTP.Доступность = НЕ ЕдиныеПараметры;
	Элементы.ПарольSMTP.Доступность       = НЕ ЕдиныеПараметры;
КонецПроцедуры

