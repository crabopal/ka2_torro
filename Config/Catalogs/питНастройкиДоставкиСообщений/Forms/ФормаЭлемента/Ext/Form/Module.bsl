//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

// Обработчик события формы "При открытии"
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	
	СпособОбменаПриИзменении(Неопределено);
	УстановитьДоступностьЭлементовУправления();
	ЕдиныеПараметрыПриИзменении(Неопределено);
	Модифицированность = Ложь;
КонецПроцедуры

// Обработчик события формы "Перед записью"
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ПустаяСтрока(Объект.КаталогОбменаFTP) И Лев(Объект.КаталогОбменаFTP, 1) <> "/" Тогда
		Объект.КаталогОбменаFTP = "/" + Объект.КаталогОбменаFTP;
	КонецЕсли;
	
	Если Объект.СохранятьОтправленные И ПустаяСтрока(Объект.КаталогОтправленныхСообщений) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан каталог отправленных сообщений", Объект.Ссылка, "КаталогОтправленныхСообщений");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.СохранятьПолученные И ПустаяСтрока(Объект.КаталогПолученныхСообщений) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан каталог полученных сообщений", Объект.Ссылка, "КаталогОтправленныхСообщений");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.ИспользоватьВременныйКаталог И ПустаяСтрока(Объект.КаталогВременныхФайлов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан каталог временных файлов", Объект.Ссылка, "КаталогОтправленныхСообщений");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
