// Обработчик начала выбора каталога обменов.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура КаталогОбменовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	#Если ВебКлиент Тогда
		// Пробуем подключить расширение 1-ый раз
		НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("ПодключитьРасширениеРаботыСФайлами_1_Завершение", ЭтотОбъект));
		Возврат;
	#КонецЕсли
	
	КаталогОбменовНачалоВыбораФрагмент();
КонецПроцедуры

// Обработчик начала выбора вспомогательного каталога.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, СтандартнаяОбработка = Ложь)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог = Объект[Элемент.Имя];
	Диалог.Заголовок = "Выберите каталог";
	
	Диалог.Показать(Новый ОписаниеОповещения("ДиалогВыбораКаталога_Завершение", ЭтотОбъект, Новый Структура("Диалог, Элемент", Диалог, Элемент)));
	
КонецПроцедуры

// Обработчик события "При начале изменения" вспомогательного каталога.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура КаталогОтправленныхСообщенийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	#Если ВебКлиент Тогда
		НачатьПодключениеРасширенияРаботыСФайлами(Новый ОписаниеОповещения("КаталогОтправленныхСообщенийПодклРасширение_Завершение", ЭтотОбъект, Новый Структура("Элемент", Элемент)));
		Возврат;
	#КонецЕсли
	
	КаталогНачалоВыбора(Элемент);
	
КонецПроцедуры

