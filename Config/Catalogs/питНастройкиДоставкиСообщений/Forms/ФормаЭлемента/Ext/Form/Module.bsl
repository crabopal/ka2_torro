#Область ОбработчикиКомандФормы

// Обработчик команды проверки настройки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Асинх Процедура ПроверитьНастройку(Команда)
	Ошибки = "";
	// Каталог на клиенте. Проверка настройки доставки на клиенте или на сервере
	ДанныеНастройкиОбмена = питОбменДанными.ПолучитьДанныеНастройкиОбмена(Объект.Ссылка);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И ДанныеНастройкиОбмена.СпособОбмена = 0 И ДанныеНастройкиОбмена.КаталогНаКлиенте Тогда
		// Проверка на клиенте.
		Результат = Ждать ПроверитьДоставкуСообщенияНаКлиенте(ДанныеНастройкиОбмена, Ошибки);
		Если Результат Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Проверка настройки доставки прошла успешно";
			Сообщение.Сообщить();
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Проверка настройки доставки закончилась с ошибками:" + Символы.ПС + Ошибки;
			Сообщение.Сообщить();
		КонецЕсли;
	Иначе
		// Проверка на сервере.
		Результат = ПроверитьНастройкуСервер(Ошибки);
		Если Результат Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Проверка настройки доставки прошла успешно";
			Сообщение.Сообщить();
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Проверка настройки доставки закончилась с ошибками:" + Символы.ПС + Ошибки;
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

// Обработчик управления интерфейсом.
//
&НаКлиенте
Процедура УстановитьДоступностьЭлементовУправления()
	Элементы.ПротоколПроксиFTP.Доступность = ИспользоватьПрокси;
	Элементы.СерверПроксиFTP.Доступность = ИспользоватьПрокси;
	Элементы.ПортПроксиFTP.Доступность = ИспользоватьПрокси;
	Элементы.ПользовательПроксиFTP.Доступность = ИспользоватьПрокси;
	Элементы.ПарольПроксиFTP.Доступность = ИспользоватьПрокси;
	
	Элементы.КаталогОтправленныхСообщений.Доступность = Объект.СохранятьОтправленные;
	Элементы.КаталогПолученныхСообщений.Доступность = Объект.СохранятьПолученные;
	Элементы.КаталогВременныхФайлов.Доступность = Объект.ИспользоватьВременныйКаталог;
	
КонецПроцедуры

// Установка вспомогательных каталогов.
//
// Параметры:
//  Использовать - Произвольный - Использовать.
//  Каталог - Произвольный - Каталог.
//  Подкаталог - Произвольный - Подкаталог.
//
&НаКлиенте
Процедура УстановитьКаталог(Использовать, Каталог, Подкаталог)
	
	Если Использовать Тогда
		Если ПустаяСтрока(Каталог) Тогда
			Если ПустаяСтрока(Объект.КаталогОбменов) Тогда
				// Не заполнен каталог обменов, не заполняем каталог.
				Каталог = "";
			Иначе
				// Ставим каталог относительно каталога обменов
				Каталог = Объект.КаталогОбменов + Подкаталог + "\";
			КонецЕсли; 
		КонецЕсли; 
	Иначе
		// Чистим каталог
		Каталог = "";
	КонецЕсли; 
	
КонецПроцедуры

// Формирование наименования.
//
// Параметры:
//  флПерезаписать - Произвольный - фл перезаписать.
//
&НаКлиенте
Процедура УстановитьНаименованиеПоУмолчанию(флПерезаписать = Ложь)
	Если ПустаяСтрока(Объект.Наименование) ИЛИ Объект.Ссылка.Пустая() ИЛИ флПерезаписать Тогда
		// Формируем наименование по способу обмена и адресу / каталогу.
		ПредставлениеСпособаОбмена = Элементы.СпособОбмена.СписокВыбора[Объект.СпособОбмена].Представление;
		// Локальная сеть
		Если Объект.СпособОбмена = 0 Тогда
			КаталогНазначения = Объект.КаталогОбменов;
			// MAPI
		ИначеЕсли Объект.СпособОбмена = 1 Тогда
			КаталогНазначения = Объект.АдресЭлектроннойПочты;
			// SMTP / POP3
		ИначеЕсли Объект.СпособОбмена = 2 Тогда
			КаталогНазначения = Объект.АдресЭлектроннойПочты;
			// FTP
		ИначеЕсли Объект.СпособОбмена = 3 Тогда
			КаталогНазначения = Объект.СерверFTP + Объект.КаталогОбменаFTP;
		ИначеЕсли Объект.СпособОбмена = 4 Тогда
			КаталогНазначения = Объект.АдресСервераHTTP;
		КонецЕсли; 
		НовоеНаименование = ПредставлениеСпособаОбмена + ?(КаталогНазначения = "",""," ( " + КаталогНазначения + " )");
		Если Объект.Наименование <> НовоеНаименование Тогда
			Объект.Наименование = НовоеНаименование;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Выполняется на вебклиенте после успешного подключения расширения работы с файлами
//  в других клиентах - сразу.
//
&НаКлиенте
Процедура КаталогОбменовНачалоВыбораФрагмент()
	
	Перем Диалог;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог = Объект.КаталогОбменов;
	Диалог.Заголовок = "Корневой каталог обменов  ...";
	Диалог.Показать(Новый ОписаниеОповещения("ВыборКатаологоДиалогом_Завершение", ЭтотОбъект, Новый Структура("Диалог", Диалог)));
	
КонецПроцедуры

// Проверяет доставку файла по указанной настройке.
//  Параметры
//
// Параметры:
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  стрОшибки - Произвольный - стр ошибки.
//
// Возвращаемое значение:
//   Булево. Флаг успешной доставки сообщения.
&НаКлиенте
Асинх Функция ПроверитьДоставкуСообщенияНаКлиенте(НастройкаДоставки, стрОшибки = "")
	
	стрОшибки = "";
	ЛокКаталог_ = НастройкаДоставки.КаталогОбменов;
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	
	ИмяТестовогоФайла = "test_exch_" + Формат(ТекущаяДата(), "ДФ = ддММгггг") + ".tmp";
	Если СпособОбмена = 0 Тогда
		
		РезультатПроверки = Ждать ПроверитьДоставкуСообщенияЛокКаталогНаКлиенте(НастройкаДоставки, стрОшибки);
		
		Возврат РезультатПроверки;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

// Функция проверки настройки доставки сообщения через локальный каталог.
//
// Параметры:
//  НастройкаДоставки - Произвольный - Настройка доставки.
//  стрОшибки - Произвольный - стр ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Асинх Функция ПроверитьДоставкуСообщенияЛокКаталогНаКлиенте(НастройкаДоставки, стрОшибки)
	
	стрОшибки = "";
	ЛокКаталог_ = НастройкаДоставки.КаталогОбменов;
	СпособОбмена = НастройкаДоставки.СпособОбмена;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
	ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	ИмяТестовогоФайла = "test_exch_" + Формат(ТекущаяДата(), "ДФ = ддММгггг") + ".tmp";
	
	Попытка
		Если НастройкаДоставки.ИспользоватьВременныйКаталог Тогда
			ТемпКаталог = ?(Прав(ЛокКаталог_,1)="/" ИЛИ Прав(ЛокКаталог_,1)="\",ЛокКаталог_,ЛокКаталог_ + Слеш) + "TEMP\";
			Файлы = Ждать НайтиФайлыАсинх(ТемпКаталог);  
			//Если НайтиФайлы(ТемпКаталог).Количество() = 0 Тогда
			Если Файлы.Количество() = 0 Тогда
				Ждать СоздатьКаталогАсинх(ТемпКаталог);
			КонецЕсли;
		Иначе
			ТемпКаталог = КаталогВременныхФайлов();
		КонецЕсли;
	Исключение
		стрОшибки = стрОшибки + "Ошибка при создании каталога:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	ПолноеИмяТестовогоФайла = ТемпКаталог + ИмяТестовогоФайла;
	
	// Можем проверить только запись в локальный каталог
	ТекстДок = Новый ТекстовыйДокумент;
	Попытка
		ТекстДок.Записать(ПолноеИмяТестовогоФайла);
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
	Исключение
		стрОшибки = стрОшибки + "Ошибка при создании тестового файла:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	// ЛОКАЛЬНЫЙ КАТАЛОГ
	Файлы = Ждать НайтиФайлы(ЛокКаталог_); 
	// Если НайтиФайлы(ЛокКаталог_).Количество() = 0 Тогда
	 Если Файлы.Количество() = 0 Тогда
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
		|Каталог не обнаружен";
		Возврат Ложь;	
	КонецЕсли;
	
	
	ПолноеИмяТестовогоФайлаПриемник = ?(Прав(ЛокКаталог_,1)=Слеш,
	НастройкаДоставки.КаталогОбменов,ЛокКаталог_ + Слеш) + ИмяТестовогоФайла;
	Попытка
		// КопироватьФайл(ПолноеИмяТестовогоФайла, ПолноеИмяТестовогоФайлаПриемник);
		Результат = Ждать КопироватьФайлАсинх(ПолноеИмяТестовогоФайла, ПолноеИмяТестовогоФайлаПриемник);

	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при копировании тестового файла в каталог обмена:
		|" + ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Результат = Ждать КопироватьФайлАсинх(ПолноеИмяТестовогоФайлаПриемник, ПолноеИмяТестовогоФайла);
	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при получении тестового файла из каталога обмена:
		|" + ОписаниеОшибки();
		
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		// УдалитьФайлы(ПолноеИмяТестовогоФайлаПриемник); 
		Ждать УдалитьФайлыАсинх(ПолноеИмяТестовогоФайлаПриемник);
		ОбратныйВызов = Новый ОписаниеОповещения("УдалитьЗавершение", ЭтотОбъект );
		НачатьУдалениеФайлов(ОбратныйВызов, ПолноеИмяТестовогоФайлаПриемник);

	Исключение
		ТекДата = Формат(ТекущаяДата(),"ДФ='HH:mm:ss dd.MM'") + " ";
		стрОшибки = ТекДата + стрОшибки + "Ошибка при удалении тестового файла из каталога обмена:
		|" + ИнформацияОбОшибке().Описание;
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Проверка корректности настройки.
//
// Параметры:
//  Ошибки - Произвольный - Ошибки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПроверитьНастройкуСервер(Ошибки)
	Возврат питОбменДанными.ПроверитьДоставкуСообщения(Объект, Ошибки);
КонецФункции

#КонецОбласти



