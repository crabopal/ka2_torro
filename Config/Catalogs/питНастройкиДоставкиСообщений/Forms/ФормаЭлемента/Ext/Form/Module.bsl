// Обработчик события "При изменении" каталога обменов.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КаталогОбменовПриИзменении(Элемент)
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоLinuxКлиент = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;  
	Слеш = ?(ЭтоLinuxКлиент, "/", "\");
	
	Объект.КаталогОбменов = СокрЛП(Объект.КаталогОбменов);
	Если Прав(Объект.КаталогОбменов,1) <> "\" И Прав(Объект.КаталогОбменов,1) <> "/" Тогда
		Объект.КаталогОбменов = Объект.КаталогОбменов + Слеш;
	КонецЕсли;
	
	// Устанавливаем каталоги
	УстановитьКаталог(Объект.СохранятьОтправленные, Объект.КаталогОтправленныхСообщений, "Sent");
	УстановитьКаталог(Объект.СохранятьПолученные, Объект.КаталогПолученныхСообщений, "Processed");
	УстановитьКаталог(Объект.ИспользоватьВременныйКаталог, Объект.КаталогВременныхФайлов, "Temp");
КонецПроцедуры

// Обработчик изменения способа обмена.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпособОбменаПриИзменении(Элемент)
	Если Объект.СпособОбмена = 0 Тогда
		Элементы.СтраницаПараметрыДоставки.Доступность = Ложь;
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаДополнительно;
	ИначеЕсли Объект.СпособОбмена = 1 Тогда
		Элементы.ПараметрыДоставки.ТекущаяСтраница = Элементы.СтраницаMAPI;
		Элементы.СтраницаПараметрыДоставки.Доступность = Истина;
	ИначеЕсли Объект.СпособОбмена = 2 Тогда
		Если Объект.ПортPOP3 = 0 Тогда
			Объект.ПортPOP3 = 110;
		КонецЕсли;
		Если Объект.ПортSMTP = 0 Тогда
			Объект.ПортSMTP = 25;
		КонецЕсли;
		Элементы.ПараметрыДоставки.ТекущаяСтраница = Элементы.СтраницаSMTPPOP3;
		Элементы.СтраницаПараметрыДоставки.Доступность = Истина;
	ИначеЕсли Объект.СпособОбмена = 3 Тогда
		Если Найти(Объект.КаталогОбменаFTP, ":") > 0 ИЛИ (Найти(Объект.КаталогОбменаFTP, "\") > 0)
			Тогда Объект.КаталогОбменаFTP = "";
		КонецЕсли;		
		Если Объект.ПортFTP = 0 Тогда
			Объект.ПортFTP = 21;
		КонецЕсли;
		Элементы.ПараметрыДоставки.ТекущаяСтраница = Элементы.СтраницаFTP;
		Элементы.СтраницаПараметрыДоставки.Доступность = Истина;
	ИначеЕсли Объект.СпособОбмена = 4 Тогда
		Элементы.ПараметрыДоставки.ТекущаяСтраница = Элементы.СтраницаHTTP;
		Элементы.СтраницаПараметрыДоставки.Доступность = Истина;
	КонецЕсли;
	
	УстановитьНаименованиеПоУмолчанию();
КонецПроцедуры

// Обработчик измеения флага "Сохранять отправленные"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СохранятьОтправленныеПриИзменении(Элемент)
	УстановитьКаталог(Объект.СохранятьОтправленные, Объект.КаталогОтправленныхСообщений, "Sent");
	УстановитьДоступностьЭлементовУправления();
КонецПроцедуры

