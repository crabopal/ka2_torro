#Область ПрограммныйИнтерфейс

// Функция - Места печати по структурной единице.
//
// Параметры:
//  Склад - Произвольный - Склад.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
Функция МестаПечатиПоСтруктурнойЕдинице(Склад) Экспорт
	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДоступныеСклады", Склад);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МестаПечати.Ссылка КАК МестоПечати
	|ИЗ
	|	Справочник.питМестаПечати КАК МестаПечати
	|ГДЕ
	|	МестаПечати.СкладПриготовления В(&ДоступныеСклады)";
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.МестоПечати);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Инициализация
#Область СлужебныеПроцедурыИФункции
#КонецОбласти
#КонецОбласти




