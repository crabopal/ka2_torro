// ПЕРЕМЕННЫЕ ОБЪЕКТА

////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ МЕТОДОВ ОБЪЕКТА

// Возвращает структуру обязательных / уникальных реквизитов элемента.
//  Если ДляЭлемента = Истина, возвращаемая структура содержит реквизиты для проверки элемента.
//  Если ДляГруппы = Истина, аналогично для группы
//  Возвращаемая структура содержит строковые идентификаторы реквизитов или вложенные структуры для табличных частей.
//  Для реквизита значение структуры содержит число 1-Обязательный, 3-Уникальный.
//
// Параметры:
//  ДляЭлемента - Произвольный - Для элемента.
//  ДляГруппы - Произвольный - Для группы.
//
// Возвращаемое значение:
//   Структура - Обязательные реквизиты, структура, содержащая реквизиты для проверки элемента или группы элементов.
Функция ПолучитьОбязательныеРеквизиты(ДляЭлемента = Истина, ДляГруппы = Ложь) Экспорт
	
	ОбязательныеРеквизиты=Новый Структура();
	ОбязательныеРеквизиты.Вставить("Наименование",1);
	
	Если ДляЭлемента Тогда
		ОбязательныеРеквизиты.Вставить("СкладПриготовления",1);
	КонецЕсли;
	
	Возврат ОбязательныеРеквизиты;
	
КонецФункции // ПолучитьОбязательныеРеквизиты()
// Проверяет корректность заполнения объекта.
//  Возвращает Истина, если все заполнено корректно и Ложь иначе.
//  В случае некорректного заполнения формирует строку с описанием возникших ошибок "Ошибки".
//  На вход может быть передана структура ДопРеквизиты с дополнительными реквизитами для проверки.
//  Может управляться флагами выполняемых проверок Заполнение, Уникальность
//  (могут быть и другие необязательные).
//  Обычно выполняется универсальным обработчиком, но могут быть добавлены дополнительные проверки.
//
// Параметры:
//  Ошибки - Произвольный - Ошибки.
//  ДопРеквизиты - Произвольный - Доп реквизиты.
//  Заполнение - Произвольный - Заполнение.
//  Уникальность - Произвольный - Уникальность.
//
// Возвращаемое значение:
//   Булево - Правильность заполнения объекта.
Функция ПроверитьКорректность(Ошибки="", ДопРеквизиты=Неопределено, Заполнение=Истина, Уникальность=Истина) Экспорт
	
	Результат = питОбщегоНазначения.ПроверитьКорректность(ЭтотОбъект, Ошибки, ДопРеквизиты, Заполнение, Уникальность);
	Если НЕ Результат Тогда
		Возврат Результат;
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(Ошибки) Тогда
		Ошибки = СокрЛП(Ошибки);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
	
КонецФункции // ПроверитьКорректность()

#КонецОбласти

#Область ОбработчикиСобытий

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СТАНДАРТНЫХ СОБЫТИЙ ОБЪЕКТА

// Стандартный обработчик ПередЗаписью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидМеста) Тогда
		ВидМеста = Перечисления.питВидыМестПечати.Принтер;
	КонецЕсли;
	
	ДопРеквизиты	= Неопределено;
	Заполнение		= Истина;
	Уникальность	= Истина;
	ПроизошлаОшибка	= Ложь;
	ТекстОшибки		= "";
	
	// Выполним проверку корректности заполнения
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		ПроизошлаОшибка = Не ПроверитьКорректность(ТекстОшибки, ДопРеквизиты, Заполнение, Уникальность);
	КонецЕсли; 
	
	// Индикация ошибок
	Если (ПроизошлаОшибка) И (Не ПустаяСтрока(ТекстОшибки)) Тогда
		ТекстСообщения = "Перед записью элемента - " + Наименование + " обнаружены ошибки :
			|"+ТекстОшибки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	КонецЕсли;
	
КонецПроцедуры
// Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ВидМеста = Перечисления.питВидыМестПечати.Принтер Тогда
		ПроверяемыеРеквизиты.Добавить("СпособПечати");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли



