// Функция - Печать прайс лист.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  ПараметрыПечати - Произвольный - Параметры печати.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПечатьПрайсЛист(МассивОбъектов, ОбъектыПечати,ПараметрыПечати) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ПолеСверху			= 0;
	ТабДокумент.ПолеСлева				= 0;
	ТабДокумент.ПолеСнизу				= 0;
	ТабДокумент.ПолеСправа			= 0;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПрайсЛист";
	
	// Запомним номер строки, с которой начали выводить текущий документ.
	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
	
	// Если не введены параметры - не печатаем.
	Если ПараметрыПечати.Свойство("СтруктураПараметров") Тогда
		СтруктураПараметров = ПараметрыПечати.СтруктураПараметров;
	Иначе
		Возврат ТабДокумент;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		
		Попытка
			ВыбранныйВидМеню			= СтруктураПараметров["ВидМеню"];
			ВыбраннаяОрганизация		= СтруктураПараметров["Организация"];
			ВыбранныйТипЦен				= СтруктураПараметров["ТипЦен"];
			ИспользуетсяИерархия		= СтруктураПараметров["Иерархия"];
			ИспользуетсяРасширенноеМеню	= СтруктураПараметров["РасширенноеМеню"];
			ИспользуетсяСебестоимость	= СтруктураПараметров["Себестоимость"];			
		Исключение
			// Предупреждение("Некорректно указаны параметры печати меню!",3);
			Возврат ТабДокумент;
		КонецПопытки;
		
		// Получим список номенклатуры из элементов справочника ПрайсЛист.
		ЗапросНоменклатуры			= Новый Запрос();
		ЗапросНоменклатуры.УстановитьПараметр("ВидМеню", ВыбранныйВидМеню);
		ЗапросНоменклатуры.Текст	= "ВЫБРАТЬ
		|	ПрайсЛист.Номенклатура КАК Номенклатура,
		|	ПрайсЛист.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ПрайсЛист.Рецептура КАК Рецептура,
		|	0 КАК Цена
		|ИЗ
		|	Справочник.питМеню КАК ПрайсЛист
		|ГДЕ
		|	НЕ ПрайсЛист.ЭтоГруппа
		|	И ПрайсЛист.Владелец = &ВидМеню
		|	И НЕ ПрайсЛист.Выключен";
		РезультатЗапроса	= ЗапросНоменклатуры.Выполнить();
		Если (РезультатЗапроса.Пустой()) Тогда
			// Предупреждение("Отсутствуют номенклатурные позиции
			// |в категории меню <"+ВыбранныйВидМеню+">");
			Возврат ТабДокумент;
		Иначе	
			ТаблицаНоменклатуры	= РезультатЗапроса.Выгрузить();
			ДопПараметры		= Новый Структура();
			
			ДопПараметры.Вставить("ИспользуетсяСебестоимость", ИспользуетсяСебестоимость);			
			ДопПараметры.Вставить("Организация", ВыбраннаяОрганизация);
			ДопПараметры.Вставить("КатегорияМеню", ВыбранныйВидМеню);
			ДопПараметры.Вставить("ТипЦен", ВыбранныйТипЦен);
			
			Если (ИспользуетсяРасширенноеМеню) Тогда
				// Печать расширенного меню (с выводом ХЭХ и групп ХЭХ).
				ТабДокумент	= питДиетпитание.ПечатьРасширенноеМеню(ТаблицаНоменклатуры, ДопПараметры);	
			Иначе
				Если (ИспользуетсяИерархия) Тогда
					// Печать прайс листа с выводом по иерархии номенклатуры.
					ТабДокумент	= питДиетпитание.ПечатьМенюПоИерархии(ТаблицаНоменклатуры, ДопПараметры);	
				Иначе
					// Печать прайс листа.
					ТабДокумент = питДиетпитание.ПечатьМеню(ТаблицаНоменклатуры, ДопПараметры);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	//
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = новый ТабличныйДокумент;
	КонецЕсли;
	 
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
		НомерСтрокиНачало, ОбъектыПечати, Неопределено);
	
	Возврат ТабДокумент;
	
КонецФункции

// Процедура удаляет без суда и следствия все подчиненные элементы из справочника ПрйсЛист
//
// Параметры:
//  ВидМенюСсылка - ссылка на справочник - владелей (ВидыПрайсЛистов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция УдалитьПодчиненные(ВидМенюСсылка) Экспорт

	КолвоУдаленных = 0;
	
	Попытка
		
		Запр = Новый Запрос("ВЫБРАТЬ
		                    |	питМеню.Ссылка КАК Ссылка
		                    |ИЗ
		                    |	Справочник.питМеню КАК питМеню
		                    |ГДЕ
		                    |	питМеню.Владелец = &ВыбВладелец");
							
		Запр.УстановитьПараметр("ВыбВладелец", ВидМенюСсылка);
		РезЗапр = Запр.Выполнить();
		
		Если НЕ РезЗапр.Пустой() Тогда

			НачатьТранзакцию();
			
			Выбка = РезЗапр.Выбрать();
			Пока Выбка.Следующий() Цикл
				
				Объект = Выбка.Ссылка.ПолучитьОбъект();
				
				Если Объект = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Объект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
				Объект.Удалить();
				КолвоУдаленных = КолвоУдаленных + 1;
				
			КонецЦикла;			
			
			ЗафиксироватьТранзакцию();
			
		КонецЕсли;
		
	Исключение
		КолвоУдаленных = -1;
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		Событие = "ОшибкаИсключения.УдалениеПодчиненных";
		ТекстОшибки = "Не удалось удалить подчиненные элементы вида меню <" + ВидМенюСсылка + "> из-за ошибки - " + ТекстОшибки;
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , ВидМенюСсылка, ТекстОшибки);
		Попытка
			ОтменитьТранзакцию();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Возврат КолвоУдаленных;
	
КонецФункции // УдалитьПодчиненные

#Область Печать

// Процедура - Добавить команды печати.
//
// Параметры:
//  КомандыПечати - Произвольный - Команды печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "питМеню";
	// КомандаПечати.Обработчик = "Справочник.питВидыМеню.ПечатьПрайсЛист";
	КомандаПечати.Представление = НСтр("ru = 'Печать меню с параметрами'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.Порядок = 4;
	
КонецПроцедуры

// Процедура - Печать.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ПараметрыПечати - Произвольный - Параметры печати.
//  КоллекцияПечатныхФорм - Произвольный - Коллекция печатных форм.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  ПараметрыВывода - Произвольный - Параметры вывода.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "питМеню") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "питМеню", "Печать меню с параметрами",
			ПечатьПрайсЛист(МассивОбъектов, ОбъектыПечати, ПараметрыПечати),,"ОбщийМакет.ПФ_MXL_питМеню");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли






