
#Область ПрограммныйИнтерфейс

#Область Печать

//  Процедура - Выполнить команду печати завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ВыполнитьКомандуПечатиЗавершение(Результат, Команда) Экспорт
	
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если НЕ ОписаниеКоманды.Свойство("ДополнительныеПараметры") Тогда
		ОписаниеКоманды.Вставить("ДополнительныеПараметры", Новый Структура());
	КонецЕсли;
	
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			"Справочник.питВидыМеню",
			"питМеню",
			питОтчетыКлиент.ОбъектыПечати(Элементы.Список),
			Неопределено,
			Новый Структура(
				"СтруктураПараметров",
				Результат));
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти


#Область ОбработчикиСобытийФормы


//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

//  Процедура - Список при активизации строки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	Если Элементы.Найти("ФормаСправочникпитВидыПрайсЛистовКомандаПечатьМенюСПараметрами") <> Неопределено Тогда
		Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
			Элементы.ФормаСправочникпитВидыПрайсЛистовКомандаПечатьМенюСПараметрами.Доступность = НЕ Элемент.ТекущиеДанные.Этогруппа;
		Иначе
			Элементы.ФормаСправочникпитВидыПрайсЛистовКомандаПечатьМенюСПараметрами.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область Печать

// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	ИдентификаторКоманды = Неопределено;
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, Этаформа.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд);
		ИдентификаторКоманды = ОписаниеКоманды.Идентификатор;
	КонецЕсли;
	
	ИмяФормыПараметровПечати = "";
	
	Если ИдентификаторКоманды ="питМеню" Тогда
		ИмяФормыПараметровПечати = "ОбщаяФорма.питПечатьМеню";
	КонецЕсли;
	
	Если ИмяФормыПараметровПечати <> "" Тогда
		ОбъектыПечати = питОтчетыКлиент.ОбъектыПечати(Элементы.Список);
		ПараметрыФормы = Новый Структура("МассивОбъектов, ВосстанавливатьЗначенияПриОткрытии", ОбъектыПечати, Истина);
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьКомандуПечатиЗавершение", ЭтотОбъект, Команда);
		ОткрытьФорму(ИмяФормыПараметровПечати, ПараметрыФормы,,,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение);
		
	Иначе
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Печать

//  Процедура - Подключаемый выполнить команду на сервере.
//
// Параметры:
//  Контекст - Произвольный - Контекст.
//  Результат - Произвольный - Результат.
//
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

//  Процедура - Подключаемый обновить команды.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры

#КонецОбласти

#КонецОбласти


