// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ


//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	
	Если Объект.Ссылка.Пустая() И Объект.ДниНедели = "       " Тогда
		Объект.ДниНедели = "1111111";
	КонецЕсли;
	
	ПрочитатьДниНедели();
	
	// Проверяем нужно ли спрашивать о копировании меню.
	Если ЗначениеЗаполнено(СсылкаПриКопировании) И НЕ Объект.ЭтоГруппа  Тогда
		Оповещение = Новый ОписаниеОповещения("ОповещениеОКопированииМеню",
		ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
		НСТР("ru = 'Скопировать содержимое меню '; de = 'Stuhl'")+""""+Строка(СсылкаПриКопировании)+""""+НСТР("ru = ' в новое меню?'; de = 'Stuhl'"),
		РежимДиалогаВопрос.ДаНет,
		25, // таймаут в секундах
		КодВозвратаДиалога.Да, 
		"");
	КонецЕсли;
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Если происходит копирование запишем это в реквизит.
	СсылкаПриКопировании = Параметры.ЗначениеКопирования;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновлениеЗначенийСвойств" И Источник = Объект.Ссылка Тогда

	КонецЕсли;
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Возврат;
КонецПроцедуры

//  Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	// Запись дней недели
	ЗаписатьДниНедели(Объект.ДниНедели);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ЗначениеЗаполнено(СсылкаПриКопировании) И НЕ Объект.ЭтоГруппа Тогда
		ТекущийОбъект.КопируемыйОбъект = СсылкаПриКопировании;
		ТекущийОбъект.КопироватьСодержимое = КопироватьМеню;
	КонецЕсли;
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

