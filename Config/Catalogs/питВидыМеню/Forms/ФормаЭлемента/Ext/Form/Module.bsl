//  Процедура - Дата начала действия обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДатаНачалаДействияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Объект.ДатаОкончанияДействия <> Дата("00010101") Тогда
		Если ВыбранноеЗначение > Объект.ДатаОкончанияДействия Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Дата начала периода действия вида меню не должна превышать дату окончания!";
			Сообщение.Сообщить();
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//  Процедура - Дата окончания действия обработка выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ДатаОкончанияДействияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Объект.ДатаНачалаДействия <> Дата("00010101") Тогда
		Если ВыбранноеЗначение < Объект.ДатаНачалаДействия Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Дата начала периода действия вида меню не должна превышать дату окончания!";
			Сообщение.Сообщить();
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

