////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Расчет дней недели
//
&НаКлиенте
Процедура ПрочитатьДниНедели()
	
	Инд = 1;
	Пока Инд <= 7 Цикл
		
		Символ = Сред(Объект.ДниНедели, Инд, 1);
		Если Символ = "1" Тогда
			ДеньЗадан = Истина;
		Иначе
			ДеньЗадан = Ложь;
		КонецЕсли; 
		ЭтаФорма["ФлДень" + Строка(Инд)] = ДеньЗадан;
		
		Инд = Инд + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Запись дней действия в строку.
//
// Параметры:
//  РезультатДниНедели - Произвольный - Результат дни недели.
//
&НаКлиенте
Процедура ЗаписатьДниНедели(РезультатДниНедели)
	
	Инд = 1;
	ТекДниНедели = "";
	Пока Инд <= 7 Цикл
		
		ДеньЗадан = ЭтаФорма["ФлДень" + Строка(Инд)];
		Символ = ?(ДеньЗадан, "1", "0");
		ТекДниНедели = ТекДниНедели + Символ;
		
		Инд = Инд + 1;
		
	КонецЦикла;
	РезультатДниНедели = ТекДниНедели;

КонецПроцедуры

#КонецОбласти



