//  Результат - Булево - Результат.
//  Параметры - Структура - Дополнительные параметры.
//
&НаКлиенте
Процедура ОповещениеОКопированииМеню(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		КопироватьМеню = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти



