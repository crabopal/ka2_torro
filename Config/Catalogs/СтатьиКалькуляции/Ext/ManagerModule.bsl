Процедура ПриНачальномЗаполненииЭлемента(Объект, Данные, ДополнительныеПараметры) Экспорт
	
	
	
КонецПроцедуры

// Получает список партий для списка значений реквизита
// Параметры:
//  Период - Дата
//  ИмяРеквизита - Строка
//  Значения - СписокЗначений из СправочникСсылка
//  ПоИерархии - Булево
// Возвращаемое значение:
//  СписокЗначений из СправочникСсылка.СтатьиКалькуляции
// 
Функция СписокЭлементовПоРеквизиту(Период, ИмяРеквизита, Знач Значения, ПоИерархии = Ложь) Экспорт
	Результат = Новый СписокЗначений;
	
	Если Не ТипЗнч(Значения) = Тип("СписокЗначений") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	СтатьиКалькуляции.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтатьиКалькуляции КАК СтатьиКалькуляции
	|ГДЕ
	|	СтатьиКалькуляции.Ссылка В (&Значения)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтатьиКалькуляции.Ссылка В (&Значения)",
												"СтатьиКалькуляции." + ИмяРеквизита + " В (&Значения)");
	Если ПоИерархии Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, " В (&Значения)", " В ИЕРАРХИИ (&Значения)");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Значения", Значения);

	НайденныеЭлементы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Результат.ЗагрузитьЗначения(НайденныеЭлементы);
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецЕсли

