
#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = Данные.Код + ", " + Данные.Наименование;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Наименование");
	Поля.Добавить("Код");
КонецПроцедуры

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьЭлементыИзКлассификатора() Экспорт
	
	ЭлементыКлассификатора = ЭлементыКлассификатора();
	
	ГруппыЭлементов = Новый Структура;
	
	Для каждого СтрокаТаблицы Из ЭлементыКлассификатора Цикл
		
		СправочникСсылка = НайтиПоКоду(СтрокаТаблицы.Код);
		Если Не ЗначениеЗаполнено(СправочникСсылка) Тогда
			СправочникОбъект = СоздатьЭлемент();
		Иначе
			СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СправочникОбъект, СтрокаТаблицы);
		Если ЗначениеЗаполнено(СтрокаТаблицы.КодРодителя) Тогда
			СправочникОбъект.Родитель = ГруппыЭлементов[СтрокаТаблицы.КодРодителя];
		КонецЕсли;
		СправочникОбъект.Записать();
		
		Если СтрокаТаблицы.ЭтоГруппа Тогда
			ГруппыЭлементов.Вставить(СтрокаТаблицы.Код, СправочникОбъект.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

