
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСписокНаименований(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура АналогиПриИзменении(Элемент)
	ЗаполнитьСписокНаименований(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСписокНаименований(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	МассивНоменклатуры = Новый Массив;
	Для Каждого ТекСтрока Из Объект.Состав Цикл
		МассивНоменклатуры.Добавить(ТекСтрока.Номенклатура);
	КонецЦикла;
	
	ВариантНаименования = СтрСоединить(МассивНоменклатуры, ", ");
	
	ВариантыНаименования = Элементы.Наименование.СписокВыбора;
	ВариантыНаименования.Очистить();
	
	Если ЗначениеЗаполнено(ВариантНаименования) Тогда
		ВариантыНаименования.Добавить(ВариантНаименования);
	КонецЕсли;
	
	ВариантыНаименования.Добавить(СтрШаблон(НСтр("ru='Набор маркированных аналогов из %1'"),
		МассивНоменклатуры.Количество()));
	
	
КонецПроцедуры

#КонецОбласти

