
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Наименование = НСтр("ru='Набор маркированных аналогов'");
		
		МассивНоменклатуры = Новый Массив;
		Для Каждого ТекСтрока Из Состав Цикл
			МассивНоменклатуры.Добавить(ТекСтрока.Номенклатура);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(МассивНоменклатуры) Тогда
			Наименование = СтрСоединить(МассивНоменклатуры, ", ");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

