
#Область ПрограммныйИнтерфейс

// Обработка ответа на запрос записи не записанного элемента если это новый.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СписокГруппыПередНачаломДобавленияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ВыбЭлемент = ДополнительныеПараметры.ВыбЭлемент;
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	Иначе 
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
		
		УстановитьОтборПоГруппеВСпискеХЭХ();
		
	КонецЕсли;
	
	СписокГруппыПередНачаломДобавленияФрагмент(ВыбЭлемент);
	
КонецПроцедуры

//  Процедура - Список группы перед началом добавления фрагмент завершение.
//
// Параметры:
//  Значение - Произвольный - Значение.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СписокГруппыПередНачаломДобавленияФрагментЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	ВыбЭлемент = ?(Значение = Неопределено, ДополнительныеПараметры.ВыбЭлемент, Значение);
	
	Если (Значение <> Неопределено) Тогда // Неопределено - пользователь отказался (нажал крестик).
		ГруппаХЭХ = Неопределено;
		
		Если Не ПринадлежностьХЭХТекущейГруппы(ВыбЭлемент, ГруппаХЭХ) И НЕ ГруппаХЭХ.Пустая()  Тогда
			ТекстВопроса = "Выбранная химикоэнергетическая характеристика " + ВыбЭлемент + " уже входит в группу " + 
			ГруппаХЭХ+". Включить ее в текущую группу ХЭХ?";
			
			ПоказатьВопрос(Новый ОписаниеОповещения("СписокГруппыПередНачаломДобавленияФрагментЗавершениеЗавершение", ЭтотОбъект, Новый Структура("ВыбЭлемент", ВыбЭлемент)), ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
			Возврат;
			
		КонецЕсли;
		СписокГруппыПередНачаломДобавленияФрагментЗавершениеФрагмент(ВыбЭлемент);
		
	КонецЕсли;
	
КонецПроцедуры


// Обработка ответа на вопрос если пользователь пытается добавить ХЭХ который уже входит в другую группу.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры1 - Произвольный - Дополнительные параметры 1.
//
&НаКлиенте
Процедура СписокГруппыПередНачаломДобавленияФрагментЗавершениеЗавершение(РезультатВопроса, ДополнительныеПараметры1) Экспорт
	
	ВыбЭлемент = ДополнительныеПараметры1.ВыбЭлемент;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		СписокГруппыПередНачаломДобавленияФрагментЗавершениеФрагмент(ВыбЭлемент);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

// Модуль формы элемента справочника

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	УстановитьОтборПоГруппеВСпискеХЭХ();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ РАБОТЫ СО СПИСКОМ ГРУППЫ

//  Процедура - Список группы перед началом добавления.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  Отказ - Булево - Отказ.
//  Копирование - Произвольный - Копирование.
//  Родитель - Произвольный - Родитель.
//  Группа - Произвольный - Группа.
//
&НаКлиенте
Процедура СписокГруппыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Перем ВыбЭлемент;
	
	Отказ = Истина;
	
	Если Копирование Тогда
		ПоказатьПредупреждение(Неопределено, "Ввод новой записи копированием запрещен!");
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("СписокГруппыПередНачаломДобавленияЗавершение", ЭтотОбъект, Новый Структура("ВыбЭлемент", ВыбЭлемент)), "Элемент еще не записан. Записать?", РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	СписокГруппыПередНачаломДобавленияФрагмент(ВыбЭлемент);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - Установить отбор по группе в списке хэх.
//
&НаСервере
Процедура УстановитьОтборПоГруппеВСпискеХЭХ()
	
	СписокГруппы.Параметры.УстановитьЗначениеПараметра("ГруппаХЭХ", Объект.Ссылка);

КонецПроцедуры

// Продолжение добавления характеристики.
//
// Параметры:
//  Знач ВыбЭлемент - Произвольный - Знач выб элемент.
//
&НаКлиенте
Процедура СписокГруппыПередНачаломДобавленияФрагмент(Знач ВыбЭлемент)
	
	Перем ГруппаХЭХ;
	// Вводим характеристику из справочника
	ПоказатьВводЗначения(Новый ОписаниеОповещения("СписокГруппыПередНачаломДобавленияФрагментЗавершение", ЭтотОбъект, Новый Структура("ВыбЭлемент", ВыбЭлемент)), ВыбЭлемент,,Тип("СправочникСсылка.питХимикоэнергетическиеХарактеристики"));
	
КонецПроцедуры

// Конец добавления хэх когда пользователь со всем согласился
//
// Параметры:
//  Знач ВыбЭлемент - Произвольный - Знач выб элемент.
//
&НаКлиенте
Процедура СписокГруппыПередНачаломДобавленияФрагментЗавершениеФрагмент(Знач ВыбЭлемент)
	
	ОбновитьГруппуХЭХ(ВыбЭлемент);
	Элементы.СписокГруппы.Обновить();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБЩИЕ ПРОЦЕДУРЫ И ФУНКЦИИ

//  Функция - Принадлежность хэх текущей группы.
//
// Параметры:
//  ХЭХ - Произвольный - Хэх.
//  ГруппаХЭХ - Произвольный - Группа хэх.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ПринадлежностьХЭХТекущейГруппы(ХЭХ, ГруппаХЭХ)
	ГруппаХЭХ = ХЭХ.ГруппаХЭХ;
	Возврат ГруппаХЭХ = Объект.Ссылка
КонецФункции

//  Процедура - Обновить группу хэх.
//
// Параметры:
//  ХЭХ - Произвольный - Хэх.
//
&НаСервере
Процедура ОбновитьГруппуХЭХ(ХЭХ)
	ОбъектХЭХ = ХЭХ.ПолучитьОбъект();
	ОбъектХЭХ.ГруппаХЭХ = Объект.Ссылка;
	Попытка
		ОбъектХЭХ.Записать();
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти



