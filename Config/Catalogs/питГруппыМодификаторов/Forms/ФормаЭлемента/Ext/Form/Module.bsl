
#Область ПрограммныйИнтерфейс

//  Процедура - Записать элемент завершение.
//
// Параметры:
//  Ответ - Произвольный - Ответ.
//  ДопПараметры - Произвольный - Доп параметры.
//
&НаКлиенте
Процедура ЗаписатьЭлементЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Записать();
		Если ДопПараметры.Закрыть Тогда
			Закрыть();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ЦветФонаПоУмолчанию 	= Новый Цвет(176, 196, 222);
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Попытка
			ЗначениеЦветФонаКнопок 	= ЗначениеИзСтрокиВнутр(Объект.ЦветФонаКнопок);
		Исключение КонецПопытки;
	Иначе 
		Если НЕ ЗначениеЗаполнено(Объект.ЦветФонаКнопок) Тогда
			ЗначениеЦветФонаКнопок = ЦветФонаПоУмолчанию;
			Объект.ЦветФонаКнопок 	= ЗначениеВСтрокуВнутр(ЗначениеЦветФонаКнопок);
		КонецЕсли;
	КонецЕсли;
	
	Модифицированность = Ложь;
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	
	УправлениеДоступностью();
КонецПроцедуры

//  Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если НЕ Объект.ОбязательныйВыбор Тогда
		Возврат;
	КонецЕсли;
		
	Если ((Объект.МинимальноеКоличествоМодификаторов + Объект.МаксимальноеКоличествоМодификаторов) = 0) Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, "Установлен режим контроля выбранного количества модификаторов, но не заданы сразу оба контролируемых значения (и ""сверху"" и ""снизу"").
						|Такая комбинация параметров контроля не имеет смысла, операция записи отменена!
						|Необходимо либо выключить режим контроля, либо задать положительное значение хотя бы в одном из условий проверки (ограничение ""сверху"" или ""снизу"")", 15);
		Возврат;
	КонецЕсли;
	
	Если (Объект.МинимальноеКоличествоМодификаторов  > Объект.МаксимальноеКоличествоМодификаторов) И (Объект.МаксимальноеКоличествоМодификаторов > 0) Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, "Минимальное количество для контроля модификаторов не должно превышать максимального количества.
						|Такая комбинация значений не имеет смысла, операция записи отменена!
						|Скорректируйте значения в полях для контролируемых количеств", 15);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

//  Процедура - Обязательный выбор при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ОбязательныйВыборПриИзменении(Элемент)
	УправлениеДоступностью();
КонецПроцедуры

//  Процедура - Значение цвет фона кнопок при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ЗначениеЦветФонаКнопокПриИзменении(Элемент)
	Объект.ЦветФонаКнопок = ЗначениеВСтрокуВнутрСервер(ЗначениеЦветФонаКнопок);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

//  Процедура - Записать элемент.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаписатьЭлемент(Команда)
	ДопПараметры = Новый Структура("Закрыть", Ложь);
	ЗадатьВопросПроМодификаторы(ДопПараметры);
КонецПроцедуры

//  Процедура - Записать и закрыть.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	ДопПараметры = Новый Структура("Закрыть", Истина);
	ЗадатьВопросПроМодификаторы(ДопПараметры);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Функция - Значение в строку внутр сервер.
//
// Параметры:
//  Значение - Произвольный - Значение.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервере
Функция ЗначениеВСтрокуВнутрСервер(Значение)
	Возврат ЗначениеВСтрокуВнутр(Значение);
КонецФункции

//  Процедура - Управление доступностью.
//
&НаКлиенте
Процедура УправлениеДоступностью()
	Элементы.МинимальноеКоличествоМодификаторов.Доступность = Объект.ОбязательныйВыбор;
	Элементы.МаксимальноеКоличествоМодификаторов.Доступность = Объект.ОбязательныйВыбор;
КонецПроцедуры

//  Процедура - Задать вопрос про модификаторы.
//
// Параметры:
//  ДопПараметры - Произвольный - Доп параметры.
//
&НаКлиенте
Процедура ЗадатьВопросПроМодификаторы(ДопПараметры)
	
	Если НЕ Объект.Модификаторы.Количество() Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаписатьЭлементЗавершение", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = НСтр("ru = 'Табличная часть модификаторов не заполнена. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаписатьЭлементЗавершение(КодВозвратаДиалога.Да, ДопПараметры)
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти



