
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ МЕТОДОВ ОБЪЕКТА


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СТАНДАРТНЫХ СОБЫТИЙ ОБЪЕКТА

// Стандартный обработчик ПередЗаписью элемента справочника.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПередЗаписью(Отказ)
	
	Если ДополнительныеСвойства.Свойство("Загрузка") Тогда
		ОбменДанными.Загрузка = ?(ДополнительныеСвойства.Загрузка = Истина, Истина, Ложь);
	КонецЕсли;
	
	ИДСтрокой = "01E00001-0000-0000-0000-000000000000";
	Если ПометкаУдаления И ВРег(XMLСтрока(Ссылка)) = ИДСтрокой Тогда
		ТекстСообщения = "Нельзя пометить на удаление предопределенную роль <" + Строка(Ссылка) + ">!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект);
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
	
	ИДСтрокой = "01E00001-0000-0000-0000-000000000000";
	// Проверим обязательные права роли "Администратора"
	Если ВРег(XMLСтрока(Ссылка)) = ИДСтрокой И Не(ЭтоНовый()) Тогда 
		Справочники.питРолиПользователейФронта.ДобавитьПраваАдминистратору(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Стандартный обработчик ПередУдалением элемента.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПередУдалением(Отказ)
	
	Если Справочники.питРолиПользователейФронта.ЭтоПредопределеннаяРоль(Ссылка) Тогда
		ТекстСообщения = "Нельзя удалять предопределенную роль <" + Строка(Ссылка) + ">!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект);
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли





