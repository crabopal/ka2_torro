// Выполняет проверку на наличие ролей пользователей фронта
//  и создание данных ролей при необходимости.
//
Процедура ПроверитьРолиПользователейФронта() Экспорт
	
	ПолучитьРольПользователяФронтаАдминистратор();
	ПолучитьРольПользователяФронтаКассир();
	ПолучитьРольПользователяФронтаМобильныйОфициант();
	ПолучитьРольПользователяФронтаФастФудБармен();
	ПолучитьРольПользователяФронтаОфициант();
	
КонецПроцедуры // ПроверитьРолиПользователейФронта()
// Возвращает роль пользователя фронта "Администратор"
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта
Функция ПолучитьРольПользователяФронтаАдминистратор() Экспорт
	
	Возврат ПолучитьРольПользователяФронта("Администратор", "01E00001-0000-0000-0000-000000000000");
	
КонецФункции // ПолучитьРольПользователяФронтаАдминистратор()
// Возвращает роль пользователя фронта "Кассир".
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта.
Функция ПолучитьРольПользователяФронтаКассир() Экспорт
	
	Возврат ПолучитьРольПользователяФронта("Кассир", "01E00002-0000-0000-0000-000000000000");
	
КонецФункции // ПолучитьРольПользователяФронтаКассир()
// Возвращает роль пользователя фронта "МобильныйОфициант".
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта.
Функция ПолучитьРольПользователяФронтаМобильныйОфициант() Экспорт
	
	Возврат ПолучитьРольПользователяФронта("МобильныйОфициант", "01E00004-0000-0000-0000-000000000000");
	
КонецФункции // ПолучитьРольПользователяФронтаМобильныйОфициант()

// Возвращает роль пользователя фронта "ФастФудБармен".
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта.
Функция ПолучитьРольПользователяФронтаФастФудБармен() Экспорт
	
	Возврат ПолучитьРольПользователяФронта("ФастФудБармен", "01E00005-0000-0000-0000-000000000000");
	
КонецФункции // ПолучитьРольПользователяФронтаФастФудБармен()

// Возвращает роль пользователя фронта "Официант".
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта.
Функция ПолучитьРольПользователяФронтаОфициант() Экспорт
	
	Возврат ПолучитьРольПользователяФронта("Официант", "01E00003-0000-0000-0000-000000000000");
	
КонецФункции // ПолучитьРольПользователяФронтаОфициант()

// Возвращает стандартные права пользователя фронта "Администратор"
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//
Процедура ДобавитьПраваАдминистратору(ЭтотОбъект) Экспорт
	
	// Поиск обязательный прав
	Право001 = Справочники.питПереченьПравФронта.НайтиПоКоду("00001");
	Право901 = Справочники.питПереченьПравФронта.НайтиПоКоду("00901");
	
	// Если элементов справочника не существует тогда создадим их и запишем
	Если Не ЗначениеЗаполнено(Право001) Тогда
		// Создадим право "001"
		Право001 = Справочники.питПереченьПравФронта.СоздатьЭлемент();
		Право001.Код = "00001";
		Право001.Наименование = "Разрешить работу с АРМами менеджера";
		Право001.ОбменДанными.Загрузка = Истина;
		Право001.Записать();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Право901) Тогда 
		Право901 = Справочники.питПереченьПравФронта.СоздатьЭлемент();
		Право901.Код = "00901";
		Право901.Наименование = "Разрешить изменять состав прав ролей пользователей";
		Право901.ОбменДанными.Загрузка = Истина;
		Право901.Записать();
	КонецЕсли;
	
	// Проверим запись в регистре
	Если Не ПроверитьНаличияПравоУРолиПрользователяФронта(ЭтотОбъект, Право001.Ссылка) Тогда 
		// Создадим запись в регистре
		Рег 						= ЭтотОбъект.Права.Добавить();
		Рег.Право 					= Право001.Ссылка;
	КонецЕсли;
	
	Если Не ПроверитьНаличияПравоУРолиПрользователяФронта(ЭтотОбъект, Право901.Ссылка) Тогда 
		// Создадим запись в регистре
		Рег 						= ЭтотОбъект.Права.Добавить();
		Рег.Право		 			= Право901.Ссылка;
	КонецЕсли;
	
КонецПроцедуры // ДобавитьПраваАдминистратору()
// Проверить наличия права у роли пользователя фронта.
//
// Параметры:
//  ЭтотОбъект - Произвольный - Этот объект.
//  Право - СправочникСсылка.питПереченьПравФронта - Ссылка на проверяемое право.
//
// Возвращаемое значение:
//   Булево.
Функция ПроверитьНаличияПравоУРолиПрользователяФронта(ЭтотОбъект, Право) Экспорт
	
	Если ЭтотОбъект.Права.НайтиСтроки(Новый Структура("Право", Право)).Количество() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ПроверитьНаличияПравоУРолиПрользователяФронта()



// Возвращает в виде строки уникальный идентификатор роли
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьIDРолиАдминистратор() Экспорт
	Возврат "01e00001-0000-0000-0000-000000000000";
КонецФункции

// Возвращает в виде строки уникальный идентификатор роли
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьIDРолиКассир() Экспорт
	Возврат "01e00002-0000-0000-0000-000000000000";
КонецФункции

// Возвращает в виде строки уникальный идентификатор роли
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьIDРолиОфициант() Экспорт
	Возврат "01e00003-0000-0000-0000-000000000000";
КонецФункции

// Возвращает в виде строки уникальный идентификатор роли
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьIDРолиФастФудБармен() Экспорт
	Возврат "01e00005-0000-0000-0000-000000000000";
КонецФункции

// Возвращает в виде строки уникальный идентификатор роли
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьIDРолиМетрдотель() Экспорт
	Возврат "01e00006-0000-0000-0000-000000000000";
КонецФункции

// Возвращает в строке перечень идентификаторов всех "предопределенных" ролей
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьПереченьIDПредопределенныхРолей() Экспорт
	Результат 	= "," + ПолучитьIDРолиАдминистратор()
				+ "," + ПолучитьIDРолиКассир()
				+ "," + ПолучитьIDРолиОфициант()
				+ "," + ПолучитьIDРолиФастФудБармен()
				+ "," + ПолучитьIDРолиМетрдотель() + ",";
	Возврат Результат;
КонецФункции

// Выполняет проверку переданной ссылки на ее принадлежность
//  списку предопределенных ролей
//
// Параметры:
//  РольСсылка - Произвольный - Роль ссылка.
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта
Функция ЭтоПредопределеннаяРоль(РольСсылка) Экспорт
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(РольСсылка) Тогда
		ID = XMLСтрока(РольСсылка);
		Результат = (Найти(ПолучитьПереченьIDПредопределенныхРолей(), ID) > 0);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли

#Область СлужебныеПроцедурыИФункции

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Возвращает роль пользователя фронта.
//
// Параметры:
//  Наименование - Произвольный - Наименование.
//  ИДСтрокой - Произвольный - Ид строкой.
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта.
Функция ПолучитьРольПользователяФронта(Наименование, ИДСтрокой)
	
	МенеджерОбъекта = Справочники.питРолиПользователейФронта;
	СоздаватьОбъект = Истина;
	
	СпрОбъект = питОбменДанными.ПолучитьОбъектПоИД(ИДСтрокой, МенеджерОбъекта, Ложь, СоздаватьОбъект);
	Если СпрОбъект.ЭтоНовый() Тогда
		СпрОбъект.Наименование 	= Наименование;
		СпрОбъект.УстановитьНовыйКод();
		Попытка
			СпрОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
			СпрСсылка = СпрОбъект.Ссылка;
		Исключение
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			СпрСсылка = МенеджерОбъекта.ПустаяСсылка();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка записи роли пользователя фронта <" + СпрОбъект.Наименование + ">: " + ТекстОшибки;
			Сообщение.Сообщить();
		КонецПопытки;
	Иначе
		Возврат СпрОбъект.Ссылка;
	КонецЕсли; 
	
	Возврат СпрСсылка;
	
КонецФункции // ПолучитьРольПользователяФронта()
#КонецЕсли


#КонецОбласти





