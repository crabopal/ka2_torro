
#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

// Обработчик события формы "При создании на сервере"
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ЗаполнитьТаблицуПрав();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	БрякуставимТут = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область УправлениеСвойствами

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

// Обработчик события перед началом добавления таблицы прав.
//
&НаКлиенте
Процедура ТаблицаПравПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
КонецПроцедуры

// Обработчик события перед удалением таблицы прав.
//
&НаКлиенте
Процедура ТаблицаПравПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

// Обработчик изменения пометки.
//
&НаКлиенте
Процедура ТаблицаПравПометкаПриИзменении(Элемент)
	
	Если НЕ ПроверитьНовый() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаПрав.ТекущиеДанные;
	Если ТекущиеДанные.Пометка Тогда
		РольНазначитьПраво(ТекущиеДанные.Право)
	Иначе
		РольУдалитьПраво(ТекущиеДанные.Право)
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТипФронтаПриИзменении(Элемент)
	ЗаполнитьТаблицуПрав();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды "Установить все"
//
&НаКлиенте
Процедура УстановитьВсе(Команда)
	Если НЕ ПроверитьНовый() Тогда
		Возврат;
	КонецЕсли;
	УстановитьВсеСервер();
КонецПроцедуры

// Обработчик команды "Снять все"
//
&НаКлиенте
Процедура СнятьВсе(Команда)
	Если НЕ ПроверитьНовый() Тогда
		Возврат;
	КонецЕсли;
	СнятьВсеСервер();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеСвойствами

&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

// Процедура заполнения таблицы прав.
//
&НаСервере
Процедура ЗаполнитьТаблицуПрав()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СоставПрав.ПравоФронта, 0) = 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Пометка,
	|	ПереченьПравФронта.Код КАК Код,
	|	ПереченьПравФронта.Наименование КАК Наименование,
	|	ПереченьПравФронта.Ссылка КАК Право,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ПереченьПравФронта.Код, 4, 2) = """"
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НовыйКод,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ПереченьПравФронта.Код, 4, 2) = """"
	|			ТОГДА ""0""
	|		ИНАЧЕ ПОДСТРОКА(ПереченьПравФронта.Код, 1, 1)
	|	КОНЕЦ КАК ТипФронта
	|ПОМЕСТИТЬ ВТ_ПереченьПрав
	|ИЗ
	|	Справочник.питПереченьПравФронта КАК ПереченьПравФронта
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СоставПрав.Право КАК ПравоФронта
	|		ИЗ
	|			Справочник.питРолиПользователейФронта.Права КАК СоставПрав
	|		ГДЕ
	|			СоставПрав.Ссылка = &Роль) КАК СоставПрав
	|		ПО ПереченьПравФронта.Ссылка = СоставПрав.ПравоФронта
	|ГДЕ
	|	НЕ ПереченьПравФронта.ПометкаУдаления
	|	И НЕ ПереченьПравФронта.Наименование ПОДОБНО ""%(не используется)%""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПереченьПрав.Пометка КАК Пометка,
	|	ВТ_ПереченьПрав.Код КАК Код,
	|	ВТ_ПереченьПрав.Наименование КАК Наименование,
	|	ВТ_ПереченьПрав.Право КАК Право,
	|	ВТ_ПереченьПрав.НовыйКод КАК НовыйКод,
	|	ВТ_ПереченьПрав.ТипФронта КАК ТипФронта
	|ИЗ
	|	ВТ_ПереченьПрав КАК ВТ_ПереченьПрав
	|ГДЕ
	|	ИСТИНА
	|	%ОтборПоТипуФронта%
	|
	|УПОРЯДОЧИТЬ ПО
	|	НовыйКод,
	|	Код";
	Запрос.УстановитьПараметр("Роль", Объект.Ссылка);
	
	ОтборПоТипуФронта = "";
	// Установим отбор по типу фронта
	Если ТипФронта = 3 Тогда
		ОтборПоТипуФронта = "И ВТ_ПереченьПрав.ТипФронта = ""1""";
	ИначеЕсли ТипФронта = 0 ИЛИ ТипФронта = 4 Тогда
		ОтборПоТипуФронта = "";
	Иначе
		ОтборПоТипуФронта = "И ВТ_ПереченьПрав.ТипФронта = ""0""";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ОтборПоТипуФронта%", ОтборПоТипуФронта);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаПрав.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаПрав.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Процедура назначает право в состав прав текущей роли.
//
&НаСервере
Процедура РольНазначитьПраво(Право)
	
	Рег = Объект.Права.Добавить();
	Рег.Право = Право;
	
КонецПроцедуры

// Процедура удаляет право из состава прав текущей роли.
//
&НаСервере
Процедура РольУдалитьПраво(Право)
	
	СтрокиПраво = Объект.Права.НайтиСтроки(Новый Структура("Право",Право));
	Для каждого ТекПраво Из СтрокиПраво Цикл
		Объект.Права.Удалить(ТекПраво);
	КонецЦикла;
	
КонецПроцедуры

// Процедура установки всех прав.
//
&НаСервере
Процедура УстановитьВсеСервер()
	
	Объект.Права.Очистить();
	
	Для Каждого ТекущаяСтрока Из ТаблицаПрав Цикл
		ТекущаяСтрока.Пометка = Истина;		
		НоваяЗапись = Объект.Права.Добавить();
		НоваяЗапись.Право = ТекущаяСтрока.Право;
	КонецЦикла;
	
КонецПроцедуры

// Процедура снятия всех прав.
//
&НаСервере
Процедура СнятьВсеСервер()
	
	Для Каждого ТекущаяСтрока Из ТаблицаПрав Цикл
		ТекущаяСтрока.Пометка = Ложь;
	КонецЦикла;
	
	Объект.Права.Очистить();
	
КонецПроцедуры

// Функция проверки нового.
//
&НаКлиенте
Функция ПроверитьНовый()
	
	Если Объект.Ссылка.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для назначения прав необходимо записать роль.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

