
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

// Обработчик события активации строки.
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ОбновитьСоставПравКлиент();
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Процедура обновления состава прав.
//
&НаСервере
Процедура ОбновитьСоставПрав(Роль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоставПравВРоляхПользователейФронта.Право.Код КАК Код,
	|	СоставПравВРоляхПользователейФронта.Право КАК Право
	|ИЗ
	|	Справочник.питРолиПользователейФронта.Права КАК СоставПравВРоляхПользователейФронта
	|ГДЕ
	|	СоставПравВРоляхПользователейФронта.Ссылка = &РольПользователяФронта
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("РольПользователяФронта", Роль);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	СоставПрав.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СоставПрав.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновления состава прав.
//
&НаКлиенте
Процедура ОбновитьСоставПравКлиент()	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		ОбновитьСоставПрав(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
