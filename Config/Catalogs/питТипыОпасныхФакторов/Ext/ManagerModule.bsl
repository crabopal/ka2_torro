#Область ПрограммныйИнтерфейс

// Выполняет проверку на наличие предопределенных оценок
//  и создание данных оценок при необходимости.
//
Процедура ПроверитьСоздатьПредопределенныеЭлементы() Экспорт
	
	ИдентификаторыЭлементов = ИдентификаторыЭлементов();
	
	ПолучитьСоздатьПредопределенныйЭлемент("Биологический"	, ИдентификаторыЭлементов.Получить("Биологический"));
	ПолучитьСоздатьПредопределенныйЭлемент("Физический"		, ИдентификаторыЭлементов.Получить("Физический"));
	ПолучитьСоздатьПредопределенныйЭлемент("Химический"		, ИдентификаторыЭлементов.Получить("Химический"));
	
КонецПроцедуры // ПроверитьСоздатьОценкиОрганолептики()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает роль пользователя фронта.
//
// Параметры:
//  Наименование - Произвольный - Наименование.
//  ИДСтрокой - Произвольный - Ид строкой.
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта.
Функция ПолучитьСоздатьПредопределенныйЭлемент(Наименование, ИДСтрокой)
	
	МенеджерОбъекта = Справочники.питТипыОпасныхФакторов;
	СоздаватьОбъект = Истина;
	
	СпрОбъект = питОбщегоНазначенияHACCP.ПолучитьОбъектПоИД(ИДСтрокой, МенеджерОбъекта, Ложь, СоздаватьОбъект);
	Если СпрОбъект.ЭтоНовый() Тогда
		СпрОбъект.Наименование 	= Наименование;
		СпрОбъект.УстановитьНовыйКод();
		Попытка
			СпрОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
			СпрСсылка = СпрОбъект.Ссылка;
		Исключение
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			СпрСсылка = МенеджерОбъекта.ПустаяСсылка();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка записи типа опасных факторов <" + СпрОбъект.Наименование + ">: " + ТекстОшибки;
			Сообщение.Сообщить();
		КонецПопытки;
	Иначе
		Возврат СпрОбъект.Ссылка;
	КонецЕсли; 
	
	Возврат СпрСсылка;
	

КонецФункции

// ПолучитьРольПользователяФронта()
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ИдентификаторыЭлементов()
	
	Результат = Новый Соответствие;
	Результат.Вставить("Биологический"	, "b6495762-c044-11ea-80e2-002590a7fb13");
	Результат.Вставить("Физический"		, "d8572bf5-1532-11eb-80ec-002590a7fb13");
	Результат.Вставить("Химический"		, "d8572bf6-1532-11eb-80ec-002590a7fb13");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли










