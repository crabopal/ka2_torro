
#Область ПрограммныйИнтерфейс

//  Процедура - Установить наименование узла.
//
// Параметры:
//  Объект - Произвольный - Объект.
//  Заменять - Произвольный - Заменять.
//
Процедура УстановитьНаименованиеУзла(Объект, Заменять) Экспорт
	
	Если ЗначениеЗаполнено(Объект.Наименование) И НЕ Заменять Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидУзла = Перечисления.питВидыУзловБлокСхемыХАССП.Номенклатура Тогда
		Объект.Наименование = Строка(Объект.Номенклатура) + ?(ЗначениеЗаполнено(Объект.Характеристика), "; " +  Строка(Объект.Характеристика), "");
	ИначеЕсли Объект.ВидУзла = Перечисления.питВидыУзловБлокСхемыХАССП.Операция Тогда
		Объект.Наименование = Строка(Объект.Операция);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


