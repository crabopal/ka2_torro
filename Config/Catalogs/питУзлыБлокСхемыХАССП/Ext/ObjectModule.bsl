
#Область ОбработчикиСобытий

//  Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПередЗаписью(Отказ)
	Справочники.питУзлыБлокСхемыХАССП.УстановитьНаименованиеУзла(ЭтотОбъект, Ложь);
КонецПроцедуры

//  Процедура - Обработка проверки заполнения.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ДополнительныеСвойства.Свойство("ЗаписыватьВсегда") Тогда
		// Возврат;
	КонецЕсли;
	
	Если ВидУзла = Перечисления.питВидыУзловБлокСхемыХАССП.Номенклатура Тогда
		ПроверяемыеРеквизиты.Добавить("Номенклатура");
	ИначеЕсли ВидУзла = Перечисления.питВидыУзловБлокСхемыХАССП.Операция Тогда
		ПроверяемыеРеквизиты.Добавить("Операция");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти



