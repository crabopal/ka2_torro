
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	//ЗаполнитьВходящиеИсходящиеУзлы();
	
	УстановитьОтборВСпискеУзлов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьОтборСтрокВходящихИсходящих();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ВходящиеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеТекущегоУзла = Элементы.Узлы.ТекущиеДанные;
	Если ДанныеТекущегоУзла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.УзелТекущий = ДанныеТекущегоУзла.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсходящиеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеТекущегоУзла = Элементы.Узлы.ТекущиеДанные;
	Если ДанныеТекущегоУзла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.УзелТекущий = ДанныеТекущегоУзла.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УзлыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Узлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьОтборСтрокВходящихИсходящих(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборВСпискеУзлов()
	
	ЭлементОтбора = Узлы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; // Опционально
	ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокВходящихИсходящих(ТекущийУзел = Неопределено)
	
	Если ТекущийУзел = Неопределено Тогда
		Элементы.Входящие.ОтборСтрок = Новый ФиксированнаяСтруктура("УзелТекущий", ПредопределенноеЗначение("Справочник.питУзлыБлокСхемыХАССП.ПустаяСсылка"));
		Элементы.Исходящие.ОтборСтрок = Новый ФиксированнаяСтруктура("УзелТекущий", ПредопределенноеЗначение("Справочник.питУзлыБлокСхемыХАССП.ПустаяСсылка"));
	Иначе
		Элементы.Входящие.ОтборСтрок = Новый ФиксированнаяСтруктура("УзелТекущий", ТекущийУзел);
		Элементы.Исходящие.ОтборСтрок = Новый ФиксированнаяСтруктура("УзелТекущий", ТекущийУзел);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
