
#Область ПрограммныйИнтерфейс

//  Процедура - Сбросить размеры и положение окна.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаСервереБезКонтекста
Процедура СброситьРазмерыИПоложениеОкна(Форма) Экспорт
	
	ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ХранилищеСистемныхНастроек.Удалить(Форма.ИмяФормы, "", ИмяПользователя);
	КонецЕсли;
	Форма.КлючСохраненияПоложенияОкна = Строка(Новый УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СброситьРазмерыИПоложениеОкна(ЭтаФорма);
	// Получение параметров формы.
	Если Параметры.Свойство("ВидФормы") Тогда
		ВидФормы = Параметры.ВидФормы;
	КонецЕсли;
	Если Параметры.Свойство("БлокСхема") Тогда
		БлокСхема = Параметры.БлокСхема;
	КонецЕсли;
	УстановитьВидимостьЭлементовФормы();
	
	УстановитьХарактеристикиИспользуютсяВШапке();
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.Характеристика, ХарактеристикиИспользуются);
	
	Если ВидФормы = 2 Тогда
		// Если заполняем по рецептуре, то номенклатура только блюдо.
		НовыйПараметр = Новый ПараметрВыбора("Отбор.питВидНоменклатуры", Перечисления.питВидыНоменклатуры.Блюдо);
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НовыйПараметр);
		НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		Элементы.Номенклатура.ПараметрыВыбора = НовыеПараметры;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

//  Процедура - Декорация добавить нажатие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДекорацияДобавитьНажатие(Элемент)
	// Проверка заполненности.
	Если ВидФормы = 0 И НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		СообщитьСостояние("Не заполнена номенклатура", 2);
		Возврат;
	ИначеЕсли ВидФормы = 1 И НЕ ЗначениеЗаполнено(Операция) Тогда
		СообщитьСостояние("Не заполнена операция", 2);
		Возврат;
	ИначеЕсли ВидФормы = 2 И НЕ ЗначениеЗаполнено(Рецептура) Тогда
		СообщитьСостояние("Не заполнена рецептура", 2);
		Возврат;
	КонецЕсли;
	// Серверный вызов.
	ТекстОшибки = ДекорацияДобавитьНажатиеНаСервере();
	Если ПустаяСтрока(ТекстОшибки) Тогда
		СообщитьСостояние("Узел добавлен", 1);
	Иначе
		СообщитьСостояние(ТекстОшибки, 2);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Крестик нажатие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КрестикНажатие(Элемент)
	// Выделяем из имени декорации идентификатор строки.
	ИдентификаторСтроки = Число(СтрЗаменить(Элемент.Имя, "Крестик", ""));
	// Удаляем строку с найденным идентификатором.
	УдалитьДобавляемыйУзелПоИдентификатору(ИдентификаторСтроки);
	// Удаляем элементы, связанные со строкой с найденным идентификатором.
	УдалитьЭлементыПоИдентификаторуСтроки(ИдентификаторСтроки);
	// Сообщаем пользователю
	СообщитьСостояние("Узел удален", 1);
КонецПроцедуры

//  Процедура - Номенклатура при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	НоменклатураПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

//  Процедура - Перенести.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Перенести(Команда)
	
	Если НЕ ДобавляемыеУзлы.Количество() Тогда
		// Если добавляемые узлы отсутствуют
		// пробуем добавить то что введено.
		ДекорацияДобавитьНажатие(Неопределено);
	КонецЕсли;
	
	ОповеститьОВыборе(ПоместитьТаблицуУзлов());
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиСобытийЭлементов

//  Функция - Декорация добавить нажатие на сервере.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ДекорацияДобавитьНажатиеНаСервере()
	
	ТекстОшибки = "";
	
	Если ЗначениеЗаполнено(Рецептура) Тогда
		СоставРецептуры = питПроизводство.ПолучитьИнгредиентыПоРецептуре(Рецептура);
		Для каждого ТекСтрокаСостава Из СоставРецептуры Цикл
			ДобавитьУзелИЭлементы(ТекСтрокаСостава.Номенклатура, ТекСтрокаСостава.Характеристика);
		КонецЦикла;
	Иначе
		НоваяСтрока = ДобавитьУзелИЭлементы(Номенклатура, Характеристика, Операция);
		Если НоваяСтрока = Неопределено Тогда
			ТекстОшибки = "Узел уже существует";
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

//  Функция - Добавить узел и элементы.
//
// Параметры:
//  ДобНоменклатура - Произвольный - Доб номенклатура.
//  ДобХарактеристика - Произвольный - Доб характеристика.
//  ДобОперация - Произвольный - Доб операция.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ДобавитьУзелИЭлементы(ДобНоменклатура, ДобХарактеристика, ДобОперация = Неопределено)
	
	// Добавляем новую строку в таблицу добавленных.
	НоваяСтрока = ДобавитьДобавляемыйУзел(ДобНоменклатура, ДобХарактеристика, ДобОперация);
	Если НЕ НоваяСтрока = Неопределено Тогда
		// Добавляем элементы формы по идентификатору добавленной строки.
		ДобавитьЭлементыПоИдентификаторуСтроки(НоваяСтрока.ПолучитьИдентификатор());
	КонецЕсли;
	Возврат НоваяСтрока;
	
КонецФункции

//  Процедура - Номенклатура при изменении на сервере.
//
&НаСервере
Процедура НоменклатураПриИзмененииНаСервере()
	УстановитьХарактеристикиИспользуютсяВШапке();
	питОбщегоНазначенияКлиентСервер.ОтобразитьИнформациюОХарактеристике(Элементы.Характеристика, ХарактеристикиИспользуются);
КонецПроцедуры

#КонецОбласти

// Процедура - Сообщает состояние выполнения действия пользователю.
//
// Параметры:
//  ТекстСостояния - Строка - Текст, который необходимо вывести.
//  Режим - Число - 0 - информация, 1 - успешное действие, 2 - Ошибка.
//
&НаКлиенте
Процедура СообщитьСостояние(ТекстСостояния, Режим=0)
	
	Элементы.ДекорацияДобавитьПусто.Заголовок = ТекстСостояния;
	Если Режим = 0 Тогда
		Элементы.ДекорацияДобавитьПусто.ЦветТекста = WebЦвета.ГрифельноСиний;
	ИначеЕсли Режим = 1 Тогда
		Элементы.ДекорацияДобавитьПусто.ЦветТекста = WebЦвета.Зеленый;
	ИначеЕсли Режим = 2 Тогда
		Элементы.ДекорацияДобавитьПусто.ЦветТекста = WebЦвета.Красный;
	Иначе
		Элементы.ДекорацияДобавитьПусто.ЦветТекста = WebЦвета.Черный;
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Удаляет добавляемый узел по идентификатору.
//
// Параметры:
//  ИдентификаторСтроки - Число - Идентификатор строки таблицы значений.
//
&НаКлиенте
Процедура УдалитьДобавляемыйУзелПоИдентификатору(ИдентификаторСтроки)
	
	НайденнаяСтрока = ДобавляемыеУзлы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		ДобавляемыеУзлы.Удалить(НайденнаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

//  Функция - Добавить добавляемый узел.
//
// Параметры:
//  ДобНоменклатура - Произвольный - Доб номенклатура.
//  ДобХарактеристика - Произвольный - Доб характеристика.
//  ДобОперация - Произвольный - Доб операция.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ДобавитьДобавляемыйУзел(ДобНоменклатура, ДобХарактеристика, ДобОперация = Неопределено)
	
	Если ДобОперация = Неопределено Тогда
		ДобОперация = Справочники.питОперации.ПустаяСсылка();
	КонецЕсли;
	
	НайденныеСтроки = ДобавляемыеУзлы.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Операция", ДобНоменклатура, ДобХарактеристика, ДобОперация));
	Если НайденныеСтроки.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Добавляем новую строку в таблицу добавленных.
	НоваяСтрока = ДобавляемыеУзлы.Добавить();
	// Генерация наименования узла.
	Если ЗначениеЗаполнено(ДобОперация) Тогда
		НоваяСтрока.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДобОперация, "Наименование");
	ИначеЕсли ЗначениеЗаполнено(ДобХарактеристика) Тогда
		НоваяСтрока.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДобНоменклатура, "НаименованиеПолное")
		+ "; " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДобХарактеристика, "НаименованиеПолное");
	Иначе
		НоваяСтрока.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДобНоменклатура, "НаименованиеПолное");
	КонецЕсли;
	// Заполнение остальных колонок.
	НоваяСтрока.Номенклатура = ДобНоменклатура;
	НоваяСтрока.Характеристика = ДобХарактеристика;
	НоваяСтрока.Операция = ДобОперация;
	
	Возврат НоваяСтрока;
	
КонецФункции

//  Процедура - Добавить элементы по идентификатору строки.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура ДобавитьЭлементыПоИдентификаторуСтроки(ИдентификаторСтроки)
	
	НайденнаяСтрока = ДобавляемыеУзлы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаЭлементов = Элементы.Добавить("ГруппаДобавленный" + Строка(ИдентификаторСтроки), Тип("ГруппаФормы"), Элементы.ГруппаСписокДобавленных);
	ГруппаЭлементов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаЭлементов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаЭлементов.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаЭлементов.ОтображатьЗаголовок = Ложь;
	ГруппаЭлементов.Высота = 0;
	
	Декорация1 = Элементы.Добавить("Наименование" + Строка(ИдентификаторСтроки), Тип("ДекорацияФормы"), ГруппаЭлементов);
	Декорация1.Заголовок = НайденнаяСтрока.Наименование;
	Декорация1.Высота = 0;
	
	Декорация2 = Элементы.Добавить("НаименованиеПусто" + Строка(ИдентификаторСтроки), Тип("ДекорацияФормы"), ГруппаЭлементов);
	Декорация2.РастягиватьПоГоризонтали = Истина;
	Декорация2.Заголовок = "";
	Декорация2.Высота = 0;
	
	Декорация3 = Элементы.Добавить("Крестик" + Строка(ИдентификаторСтроки), Тип("ДекорацияФормы"), ГруппаЭлементов);
	Декорация3.Заголовок = "Х";
	Декорация3.Вид = ВидДекорацииФормы.Картинка;
	Декорация3.Картинка = БиблиотекаКартинок.питКрестик;
	Декорация3.Гиперссылка = Истина;
	Декорация3.УстановитьДействие("Нажатие", "КрестикНажатие");
	Декорация3.Высота = 0;
	
КонецПроцедуры

//  Процедура - Удалить элементы по идентификатору строки.
//
// Параметры:
//  ИдентификаторСтроки - Произвольный - Идентификатор строки.
//
&НаСервере
Процедура УдалитьЭлементыПоИдентификаторуСтроки(ИдентификаторСтроки)
	Элементы.Удалить(Элементы["ГруппаДобавленный" + Строка(ИдентификаторСтроки)]);
КонецПроцедуры

// Процедура устанавдивает видимость элементов формы
//
&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	Элементы.Номенклатура.Видимость = ВидФормы = 0 ИЛИ ВидФормы = 2;
	Элементы.Характеристика.Видимость = ВидФормы = 0 ИЛИ ВидФормы = 2;
	Элементы.Операция.Видимость = ВидФормы = 1;
	Элементы.Рецептура.Видимость = ВидФормы = 2;
	
	// Элементы.ГруппаСписокДобавленных.Высота = 1;
	// Элементы.ГруппаСписокДобавленных.Высота = 0;
	
КонецПроцедуры

// Функция - Помещает таблицу узлов во временное хранилище, возвращает адрес.
//
// Возвращаемое значение:
//  Строка - Адрес таблицы во временном хранилище.
&НаСервере
Функция ПоместитьТаблицуУзлов()
	Для каждого ТекСтрока Из ДобавляемыеУзлы Цикл
		ТекСтрока.ТипСвязи = ?(ВидФормы = 2, "Обратная", "Прямая");
	КонецЦикла;
	Возврат ПоместитьВоВременноеХранилище(ДобавляемыеУзлы.Выгрузить());
КонецФункции

//  Процедура - Установить характеристики используются в шапке.
//
&НаСервере
Процедура УстановитьХарактеристикиИспользуютсяВШапке()
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ХарактеристикиИспользуются = питОбщегоНазначения.ХарактеристикиИспользуются(Номенклатура);
	Иначе
		ХарактеристикиИспользуются = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти









