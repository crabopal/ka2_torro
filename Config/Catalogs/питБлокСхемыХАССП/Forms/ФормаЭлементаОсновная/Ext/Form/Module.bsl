	СтрокаJSДоп = СтрокаJSДоп + """id"": """ + УИД + """,";
	СтрокаJSДоп = СтрокаJSДоп + """name"": """ + ТекУзел.Наименование + """, ";
	СтрокаJSДоп = СтрокаJSДоп + """product"": """ + ТекУзел.Номенклатура + """, ";
	СтрокаJSДоп = СтрокаJSДоп + """characteristic"": """ + ТекУзел.Характеристика + """, ";
	СтрокаJSДоп = СтрокаJSДоп + """operation"": """ + ТекУзел.Операция + """ ";
	СтрокаJSДоп = СтрокаJSДоп + "}";
	Возврат СтрокаJSДоп;
КонецФункции

