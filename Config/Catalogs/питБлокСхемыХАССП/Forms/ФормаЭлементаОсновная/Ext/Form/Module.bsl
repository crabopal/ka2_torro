//  Функция - Доп данные узла по id.
//
// Параметры:
//  ДанныеУзловДоп - Произвольный - Данные узлов доп.
//  IDУзла - Произвольный - Id узла.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ДопДанныеУзлаПоID(ДанныеУзловДоп, IDУзла)
	ДанныеУзлаДоп = Неопределено;
	Для каждого ТекСтрокаДанныеУзловДоп Из ДанныеУзловДоп Цикл
		Если ТекСтрокаДанныеУзловДоп.id = IDУзла Тогда
			ДанныеУзлаДоп = ТекСтрокаДанныеУзловДоп;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ДанныеУзлаДоп;
КонецФункции

//  Функция - Получить создать узел по id.
//
// Параметры:
//  IDУзла - Произвольный - Id узла.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ПолучитьСоздатьУзелПоID(IDУзла)
	СсылкаНаУзел = Справочники.питУзлыБлокСхемыХАССП.ПолучитьСсылку(Новый УникальныйИдентификатор(IDУзла));
	Если ПустаяСтрока(СсылкаНаУзел.ВерсияДанных) Тогда
		ОбъектУзел = Справочники.питУзлыБлокСхемыХАССП.СоздатьЭлемент();
		ОбъектУзел.УстановитьСсылкуНового(СсылкаНаУзел);
	Иначе
		ОбъектУзел = СсылкаНаУзел.ПолучитьОбъект();
	КонецЕсли;
	Возврат ОбъектУзел;
КонецФункции

//  Функция - Создать обновить узлы блок схемы.
//
// Параметры:
//  БлокСхема - Произвольный - Блок схема.
//  ДанныеУзлов - Произвольный - Данные узлов.
//  ДанныеУзловДоп - Произвольный - Данные узлов доп.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция СоздатьОбновитьУзлыБлокСхемы(БлокСхема, ДанныеУзлов, ДанныеУзловДоп)
	// Массив ссылок на узлы блок-схемы.
	СсылкиУзлов = Новый Массив;
	
	Для каждого ДанныеУзла Из ДанныеУзлов Цикл
		
		// Получаем дополнительные данные узла.
		ДанныеУзлаДоп = ДопДанныеУзлаПоID(ДанныеУзловДоп, ДанныеУзла.id);
		
		ОбъектУзел = ПолучитьСоздатьУзелПоID(ДанныеУзла.id);
		
		// Заполнение объекта узла блок-схемы.
		Если НЕ ДанныеУзлаДоп = Неопределено Тогда
			ОбъектУзел.Наименование		= ДанныеУзлаДоп.name;
			ОбъектУзел.Номенклатура		= Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеУзлаДоп.product));
			ОбъектУзел.Характеристика	= Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеУзлаДоп.characteristic));
			ОбъектУзел.Операция			= Справочники.питОперации.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеУзлаДоп.operation));
		Иначе
			ОбъектУзел.Наименование	= ДанныеУзла.label;
		КонецЕсли;
		ОбъектУзел.Владелец		= БлокСхема;
		ОбъектУзел.ВидУзла		= ?(ЗначениеЗаполнено(ОбъектУзел.Операция), Перечисления.питВидыУзловБлокСхемыХАССП.Операция, Перечисления.питВидыУзловБлокСхемыХАССП.Номенклатура);
		ОбъектУзел.КоординатаХ	= ДанныеУзла.x;
		ОбъектУзел.КоординатаУ	= ДанныеУзла.y;
		
		// Запись объекта узла блок-схемы.
		ОбъектУзел.ДополнительныеСвойства.Вставить("ЗаписыватьВсегда");
		ОбъектУзел.Записать();
		
		// Добавление ссылки на узел в массив узлов.
		СсылкиУзлов.Добавить(ОбъектУзел.Ссылка);
		
	КонецЦикла;
	
	// Удаление неактуальных узлов блок-схемы.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питУзлыБлокСхемыХАССП.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.питУзлыБлокСхемыХАССП КАК питУзлыБлокСхемыХАССП
	|ГДЕ
	|	НЕ питУзлыБлокСхемыХАССП.Ссылка В (&СсылкиУзлов)
	|	И питУзлыБлокСхемыХАССП.Владелец = &Владелец";
	Запрос.УстановитьПараметр("СсылкиУзлов"	, СсылкиУзлов);
	Запрос.УстановитьПараметр("Владелец"	, БлокСхема);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		УзелОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		УзелОбъект.Удалить();
	КонецЦикла;
	
	Возврат СсылкиУзлов;
КонецФункции

//  Функция - Обновить регистр связей узлов блок схемы.
//
// Параметры:
//  БлокСхема - Произвольный - Блок схема.
//  ДанныеСвязей - Произвольный - Данные связей.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ОбновитьРегистрСвязейУзловБлокСхемы(БлокСхема, ДанныеСвязей)
	НаборЗаписей = РегистрыСведений.питСвязиУзловХАССП.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Схема.Установить(БлокСхема);
	Для каждого ДанныеСвязи Из ДанныеСвязей Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Схема			= БлокСхема;
		НоваяЗапись.Узел			= Справочники.питУзлыБлокСхемыХАССП.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеСвязи.to));
		НоваяЗапись.УзелРодитель	= Справочники.питУзлыБлокСхемыХАССП.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеСвязи.from));
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
КонецФункции

