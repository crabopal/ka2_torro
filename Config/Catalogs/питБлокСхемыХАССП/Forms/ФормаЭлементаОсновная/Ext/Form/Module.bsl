//  Функция - Форма узла js.
//
// Параметры:
//  ФормаУзла - Произвольный - Форма узла.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ФормаУзлаJS(ФормаУзла)
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.питВидыФормУзловБлокСхемыХАССП.Овал"), "ellipse");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.питВидыФормУзловБлокСхемыХАССП.Круг"), "circle");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.питВидыФормУзловБлокСхемыХАССП.Прямоугольник"), "box");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.питВидыФормУзловБлокСхемыХАССП.Точка"), "dot");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.питВидыФормУзловБлокСхемыХАССП.Звезда"), "star");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.питВидыФормУзловБлокСхемыХАССП.Треугольник"), "triangle");
	Соответствие.Вставить(ПредопределенноеЗначение("Перечисление.питВидыФормУзловБлокСхемыХАССП.Квадрат"), "square");
	Возврат Соответствие.Получить(ФормаУзла);
КонецФункции

