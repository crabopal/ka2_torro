

#Область ПрограммныйИнтерфейс

//  Процедура - Сохранение файла завершение.
//
// Параметры:
//  ВыбранныеФайлы - Произвольный - Выбранные файлы.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СохранениеФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы <> Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];
		ДвоичныеДанные = Base64Значение(ДополнительныеПараметры.КартинкаВBase64);
		ДвоичныеДанные.Записать(ПутьКФайлу);
	КонецЕсли;
КонецПроцедуры

// Процедура - Удалить завершение
//
// Параметры:
//  ДополнительныеПараметры	 - Произвольный	 - Дополнительные параметры. 
//
&НаКлиенте
Процедура УдалитьЗавершение(ДополнительныеПараметры) Экспорт
	Сообщение = Новый СообщениеПользователю();
    Сообщение.Текст = "Удаление успешно завершено";
    Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	УправлениеФормой(ЭтаФорма);
	
	ЗагрузитьНастройкиХАССП();
	
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	ПриЧтенииСозданииНаСервере();
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	ПутьКБиблиотекеОтрисовкиДерева = КаталогВременныхФайлов() + "vis-network.min.js";
	УправлениеФормойНаКлиенте();
	ВыгрузитьБибилиотекуВизуализации();
	// Заполняем HTML и выводим ее.
	ЗаполнитьТекстПоляHTML();
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Обработка выбора.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	ДобавляемыеДанные = ПолучитьДобавляемыеДанные(ВыбранноеЗначение);
	Для каждого ДобавляемаяСтрока Из ДобавляемыеДанные Цикл
		ДобавитьУзел(ДобавляемаяСтрока.Наименование, ДобавляемаяСтрока.Номенклатура, ДобавляемаяСтрока.Характеристика, ДобавляемаяСтрока.Операция, ДобавляемаяСтрока.ТипСвязи);
	КонецЦикла;
КонецПроцедуры

//  Процедура - Перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Получение данных сети из js в сериализованном виде.
	СтрокаДанныеУзлов		= Элементы.Поле1.Документ.DefaultView.getNodesData();
	СтрокаДанныеУзловДоп	= Элементы.Поле1.Документ.DefaultView.getNodesDataExtra();
	СтрокаДанныеСвязей		= Элементы.Поле1.Документ.DefaultView.getEdgesData();
	Объект.КартинкаВBase64	= КартинкаСетиВBase64();
	
	ПараметрыЗаписи.Вставить("СтрокаДанныеУзлов"	, СтрокаДанныеУзлов);
	ПараметрыЗаписи.Вставить("СтрокаДанныеУзловДоп"	, СтрокаДанныеУзловДоп);
	ПараметрыЗаписи.Вставить("СтрокаДанныеСвязей"	, СтрокаДанныеСвязей);
	
КонецПроцедуры

//  Процедура - При записи на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// ИдентификаторСхемы = Элементы.Поле1.Документ.network.getSeed();
	
	// Десериализация данных сети.
	ДанныеУзлов = ДанныеИзJSONСтроки(ПараметрыЗаписи.СтрокаДанныеУзлов);
	ДанныеУзловДоп = ДанныеИзJSONСтроки(ПараметрыЗаписи.СтрокаДанныеУзловДоп);
	ДанныеСвязей = ДанныеИзJSONСтроки(ПараметрыЗаписи.СтрокаДанныеСвязей);
	
	// Обновление узлов блок-схемы и удаление неактуальных.
	СсылкиУзлов = СоздатьОбновитьУзлыБлокСхемы(ТекущийОбъект.Ссылка, ДанныеУзлов, ДанныеУзловДоп);
	
	// Обновление связей узлов блок-схемы.
	ОбновитьРегистрСвязейУзловБлокСхемы(ТекущийОбъект.Ссылка, ДанныеСвязей);
	
КонецПроцедуры

//  Процедура - После записи.
//
// Параметры:
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// Сброс флага модификцированности формы.
	Модифицированность = Ложь;
КонецПроцедуры

//  Процедура - Перед закрытием.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ЗавершениеРаботы - Произвольный - Завершение работы.
//  ТекстПредупреждения - Произвольный - Текст предупреждения.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Попытка
		//УдалитьФайлы(ПутьКБиблиотекеОтрисовкиДерева);
		ОбратныйВызов = Новый ОписаниеОповещения("УдалитьЗавершение", ЭтотОбъект );
		НачатьУдалениеФайлов(ОбратныйВызов, ПутьКБиблиотекеОтрисовкиДерева );

	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось удалить временные файлы библиотеки визуализации");
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

//  Процедура - Поле 1 при нажатии.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеСобытия - Произвольный - Данные события.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Поле1ПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	ОбнулитьТекущиеПеременныеСетиНаКлиенте();
	
	JSНажатогоУзла = Элементы.Поле1.Документ.DefaultView.selectedNodeData();
	Если НЕ ПустаяСтрока(JSНажатогоУзла) Тогда
		ДанныеУзла = ДанныеИзJSONСтроки(JSНажатогоУзла);
		ИдентификаторУзла = ДанныеУзла.id;
		НаименованиеУзла = ДанныеУзла.name;
	КонецЕсли;
	
	УправлениеФормойНаКлиенте();
	
КонецПроцедуры

//  Процедура - Поле 1 при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Поле1ПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Наименование узла при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура НаименованиеУзлаПриИзменении(Элемент)
	
	Если ПустаяСтрока(ИдентификаторУзла)
		ИЛИ ПустаяСтрока(НаименованиеУзла) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОбновить = Новый Структура;
	СтруктураОбновить.Вставить("id", ИдентификаторУзла);
	СтруктураОбновить.Вставить("name", НаименованиеУзла);
	СтруктураОбновить.Вставить("label", ПолучитьПодписьУзлаПоНаименованию(НаименованиеУзла));
	JSСтрока = ДанныеВJSONСтроку(СтруктураОбновить);
	
	Элементы.Поле1.Документ.DefaultView.updateNodeData(JSСтрока);
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

//  Процедура - Начать добавление узла.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура НачатьДобавлениеУзла(Команда)
	ВидФормы = 0; // Добавить номенклатуру.
	Если Команда.Имя = "ДобавитьОперацию" Тогда
		ВидФормы = 1;
	ИначеЕсли Команда.Имя = "ДобавитьИнгредиенты" Тогда
		ВидФормы = 2;
	КонецЕсли;
	ОткрытьФорму("Справочник.питБлокСхемыХАССП.Форма.ФормаДобавленияНоменклатуры", Новый Структура("ВидФормы, БлокСхема", ВидФормы, Объект.Ссылка), ЭтаФорма);
КонецПроцедуры

//  Процедура - Добавить связь.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ДобавитьСвязь(Команда)
	Элементы.Поле1.Документ.network.addEdgeMode();
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Удалить связь.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура УдалитьСвязь(Команда)
	Элементы.Поле1.Документ.network.deleteSelected();
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Уменьшить урвоень.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура УменьшитьУрвоень(Команда)
	Элементы.Поле1.Документ.DefaultView.levelUp();
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Увеличить уровень.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура УвеличитьУровень(Команда)
	Элементы.Поле1.Документ.DefaultView.levelDown();
	Модифицированность = Истина;
КонецПроцедуры

//  Процедура - Сеть запомнить.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СетьЗапомнить(Команда)
	
	КартинкаВBase64 = КартинкаСетиВBase64();
	
//   Открываем стандартный диалог Windows выбора каталога/файла в режиме выбора файла на сохранение - ДиалогВыбораФайла
// 1С.
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Все картинки (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf|" 
		+ "Формат bmp (*.bmp;*.dib;*.rle)|*.bmp;*.dib;*.rle|"
		+ "Формат JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
		+ "Формат TIFF (*.tif)|*.tif|"
		+ "Формат GIF (*.gif)|*.gif|"
		+ "Формат PNG (*.png)|*.png|"
		+ "Формат icon (*.ico)|*.ico|"
		+ "Формат метафайл (*.wmf;*.emf)|*.wmf;*.emf|";// картинки
	ОповещениеЗавершения = Новый ОписаниеОповещения("СохранениеФайлаЗавершение", ЭтотОбъект, Новый Структура("КартинкаВBase64", КартинкаВBase64));
	// Если пользователь не нажал кнопку ОТМЕНА в диалоге
	Диалог.Показать(ОповещениеЗавершения);
	
	// Элементы.Поле1.Документ.network.addEdgeMode();
	// Сообщить(Элементы.Поле1.Документ.network.getSeed());
	// Элементы.Поле1.Документ.window.test();
	// Элементы.Поле1.Документ.network.fit();
	// Элементы.Поле1.Документ.window.save_pic();
	
КонецПроцедуры

//  Процедура - Печать.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Печать(Команда)
	
	КартинкаВBase64 = КартинкаСетиВBase64();
	
	ОткрытьФорму("Справочник.питБлокСхемыХАССП.Форма.ФормаПечати",
		Новый Структура("КартинкаBase64", КартинкаВBase64), ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры


// СтандартныеПодсистемы.ПодключаемыеКоманды
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеТекстаПоляHTML

//  Процедура - Выгрузить бибилиотеку визуализации.
//
&НаКлиенте
Процедура ВыгрузитьБибилиотекуВизуализации()
	Библиотека = ПолучитьИзВременногоХранилища(ВыгрузитьБибилиотекуВизуализацииНаСервере());
	Попытка
		Библиотека.Записать(ПутьКБиблиотекеОтрисовкиДерева);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не загрузить библиотеку визуализации блок-схемы ХАССП");
	КонецПопытки;
КонецПроцедуры

//  Функция - Выгрузить бибилиотеку визуализации на сервере.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ВыгрузитьБибилиотекуВизуализацииНаСервере()
	Возврат ПоместитьВоВременноеХранилище(ПолучитьОбщийМакет("питХАССПБиблиотекаВизуализации"));
КонецФункции

//  Процедура - Заполнить текст поля html.
//
&НаСервере
Процедура ЗаполнитьТекстПоляHTML()
	
	// Собираем настройки ХАССП в структуру.
	СтруктураНастроекХАССП = СтруктураНастроекХАССПНаСервере();
	
	// Получение исходного текста шаблона поля HTML.
	ТекстШаблона = ТекстШаблонаПоляHTML();
	
	// Путь к vis js
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "%ПутьКБиблиотекеВизуализации%", ПутьКБиблиотекеОтрисовкиДерева);
	
	// Получение таблиц узлов и связей по блок-схеме.
	ТаблицаУзлов = ТаблицаУзловБлокСхемы(Объект.Ссылка);
	ТаблицаСвязей = ТаблицаСвязейБлокСхемы(Объект.Ссылка);
	
	// Замена текста шаблона по узлам блок-схемы.
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "%УзлыБлокСхемы%", 
		ТекстШаблонаУзлыБлокСхемы(ТаблицаУзлов, СтруктураНастроекХАССП));
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "%УзлыБлокСхемыДопИнформация%", 
		ТекстШаблонаУзлыБлокСхемыДопИнформация(ТаблицаУзлов));
	
	// Замена текста шаблона по связям блок-схемы.
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "%СвязиУзловБлокСхемы%",
		ТекстШаблонаСвязиУзлов(ТаблицаСвязей, СтруктураНастроекХАССП));
		
	// Свойства связей узлов
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "%СвойстваСвязейУзлов%",
		ТекстШаблонаСвойстваСвязей(СтруктураНастроекХАССП));
	
	// Замена текста шаблона по служебным переменным.
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "%ИдентификаторСхемы%", "undefined");
	ТекстШаблона = СтрЗаменить(ТекстШаблона, "%СлучайныйИдентификатор%", """" + Строка(Новый УникальныйИдентификатор) + """");
	
	// Заполнение результирующего текста поля HTML.
	ТекстПоляHTML = ТекстШаблона;
	
КонецПроцедуры

//  Функция - Текст шаблона поля html.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервере
Функция ТекстШаблонаПоляHTML()
	Макет = Справочники.питБлокСхемыХАССП.ПолучитьМакет("Макет");
	ТекстШаблона = Макет.ПолучитьТекст();
	Возврат ТекстШаблона;
КонецФункции

//  Функция - Таблица узлов блок схемы.
//
// Параметры:
//  БлокСхема - Произвольный - Блок схема.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
&НаСервереБезКонтекста
Функция ТаблицаУзловБлокСхемы(БлокСхема)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питУзлыБлокСхемыХАССП.Ссылка КАК Ссылка,
	|	питУзлыБлокСхемыХАССП.Код КАК Код,
	|	питУзлыБлокСхемыХАССП.Наименование КАК Наименование,
	|	питУзлыБлокСхемыХАССП.ВидУзла КАК ВидУзла,
	|	питУзлыБлокСхемыХАССП.КоординатаХ КАК КоординатаХ,
	|	питУзлыБлокСхемыХАССП.КоординатаУ КАК КоординатаУ,
	|	питУзлыБлокСхемыХАССП.Номенклатура КАК НоменклатураСсылка,
	|	питУзлыБлокСхемыХАССП.Характеристика КАК ХарактеристикаСсылка,
	|	питУзлыБлокСхемыХАССП.Операция КАК ОперацияСсылка
	|ИЗ
	|	Справочник.питУзлыБлокСхемыХАССП КАК питУзлыБлокСхемыХАССП
	|ГДЕ
	|	питУзлыБлокСхемыХАССП.Владелец = &Владелец
	|	И НЕ питУзлыБлокСхемыХАССП.ПометкаУдаления
	|";
	Запрос.УстановитьПараметр("Владелец", БлокСхема);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаУзлов = РезультатЗапроса.Выгрузить();
	
	ТаблицаУзлов.Колонки.Добавить("Номенклатура");
	ТаблицаУзлов.Колонки.Добавить("Характеристика");
	ТаблицаУзлов.Колонки.Добавить("Операция");
	
	Для каждого ТекУзел Из ТаблицаУзлов Цикл
		ТекУзел.Номенклатура = XMLСтрока(ТекУзел.НоменклатураСсылка);
		ТекУзел.Характеристика = XMLСтрока(ТекУзел.ХарактеристикаСсылка);
		ТекУзел.Операция = XMLСтрока(ТекУзел.ОперацияСсылка);
	КонецЦикла;
	
	Возврат ТаблицаУзлов;
КонецФункции

//  Функция - Таблица связей блок схемы.
//
// Параметры:
//  БлокСхема - Произвольный - Блок схема.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат обработки.
//
&НаСервереБезКонтекста
Функция ТаблицаСвязейБлокСхемы(БлокСхема)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питСвязиУзловХАССП.Узел КАК Узел,
	|	питСвязиУзловХАССП.УзелРодитель КАК УзелРодитель,
	|	питСвязиУзловХАССП.Узел.Наименование КАК Наименование,
	|	питСвязиУзловХАССП.УзелРодитель.Наименование КАК НаименованиеРодитель,
	|	питСвязиУзловХАССП.Узел.ВидУзла КАК ВидУзла,
	|	питСвязиУзловХАССП.УзелРодитель.ВидУзла КАК ВидУзлаРодитель
	|ИЗ
	|	РегистрСведений.питСвязиУзловХАССП КАК питСвязиУзловХАССП
	|ГДЕ
	|	питСвязиУзловХАССП.Схема = &Владелец";
	Запрос.УстановитьПараметр("Владелец", БлокСхема);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаСвязей = РезультатЗапроса.Выгрузить();
	Возврат ТаблицаСвязей;
КонецФункции

//  Функция - Текст шаблона узлы блок схемы.
//
// Параметры:
//  ТаблицаУзлов - ТаблицаЗначений - Таблица узлов.
//  СтруктураНастроекХАССП - Структура - Структура настроек хассп.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ТекстШаблонаУзлыБлокСхемы(ТаблицаУзлов, СтруктураНастроекХАССП)
	
	СтрокаJS = "";
	Для Каждого ТекУзел Из ТаблицаУзлов Цикл
		УИД = XMLСтрока(ТекУзел.Ссылка);
		СтрокаJS = СтрокаJS + ТекстШаблонаУзел(УИД, ТекУзел, СтруктураНастроекХАССП) + "," + Символы.ПС;
	КонецЦикла;
	
	Возврат СтрокаJS;
	
КонецФункции

//  Функция - Текст шаблона узлы блок схемы доп информация.
//
// Параметры:
//  ТаблицаУзлов - ТаблицаЗначений - Таблица узлов.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ТекстШаблонаУзлыБлокСхемыДопИнформация(ТаблицаУзлов)
	
	СтрокаJSДоп = "[";
	Для Каждого ТекУзел Из ТаблицаУзлов Цикл
		УИД = XMLСтрока(ТекУзел.Ссылка);
		СтрокаJSДоп = СтрокаJSДоп + ТекстШаблонаУзелДопИнформация(УИД, ТекУзел) + ",";
	КонецЦикла;
	СтрокаJSДоп = СтрокаJSДоп + "]";
	
	Возврат СтрокаJSДоп;
	
КонецФункции

//  Функция - Текст шаблона связи узлов.
//
// Параметры:
//  ТаблицаСвязей - ТаблицаЗначений - Таблица связей.
//  СтруктураНастроекХАССП - Структура - Структура настроек хассп.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ТекстШаблонаСвязиУзлов(ТаблицаСвязей, СтруктураНастроекХАССП)
	
	СтрокаJS = "";
	Для Каждого ТекСвязь Из ТаблицаСвязей Цикл
		Если НЕ ЗначениеЗаполнено(ТекСвязь.Узел) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаJS = СтрокаJS + "{";
		СтрокаJS = СтрокаJS + "from: """ + XMLСтрока(ТекСвязь.УзелРодитель) + """, ";
		СтрокаJS = СтрокаJS + "to: """ + XMLСтрока(ТекСвязь.Узел) + """, ";
		СтрокаJS = СтрокаJS + "arrows: ""to"", ";
		// СтрокаJS = СтрокаJS + "arrowStrikethrough: false, ";
		// СтрокаJS = СтрокаJS + "width: 2, ";
		// СтрокаJS = СтрокаJS + "height: 50, ";
		// СтрокаJS = СтрокаJS + "smooth: {
		// |enabled: true,
		// |type: ""dynamic"",
		// |roundness: 0.5
		// |}, ";
		
		СтрокаJS = СтрокаJS + """color"": {""color"": ""%питХАССПЦветСвязи%"", ""highlight"": ""%питХАССПЦветВыделеннойСвязи%""},";
		СтрокаJS = СтрокаJS + """width"": %питХАССПТолщинаСвязи%, ";
		
		// СтрокаJS = СтрокаJS + """selectionWidth"": ""%питХАССПТолщинаВыделеннойСвязи%"", ";
		// СтрокаJS = СтрокаJS + """label"": ""Опасный фактор 1"", ";
		// СтрокаJS = СтрокаJS + """font"": {""align"": ""bottom"", ""size"": 10},";
		
		СтрокаJS = СтрокаJS + "}," + Символы.ПС;
	КонецЦикла;
	
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветСвязи%"          , СтруктураНастроекХАССП.питХАССПЦветСвязи);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветВыделеннойСвязи%", СтруктураНастроекХАССП.питХАССПЦветВыделеннойСвязи);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПТолщинаСвязи%"       , СтруктураНастроекХАССП.питХАССПТолщинаСвязи);
	
	Возврат СтрокаJS;
	
КонецФункции

//  Функция - Текст шаблона свойства связей.
//
// Параметры:
//  СтруктураНастроекХАССП - Структура - Структура настроек хассп.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ТекстШаблонаСвойстваСвязей(СтруктураНастроекХАССП)
	
	СтрокаJS = "";
	
	СтрокаJS = СтрокаJS + "{";
	
	СтрокаJS = СтрокаJS + """color"": {""color"": ""%питХАССПЦветСвязи%"", ""highlight"": ""%питХАССПЦветВыделеннойСвязи%""},";
	СтрокаJS = СтрокаJS + """width"": %питХАССПТолщинаСвязи%";
	
	СтрокаJS = СтрокаJS + "}" + Символы.ПС;
	
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветСвязи%"          , СтруктураНастроекХАССП.питХАССПЦветСвязи);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветВыделеннойСвязи%", СтруктураНастроекХАССП.питХАССПЦветВыделеннойСвязи);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПТолщинаСвязи%"       , СтруктураНастроекХАССП.питХАССПТолщинаСвязи);
	
	Возврат СтрокаJS;
	
КонецФункции

#КонецОбласти

#Область ДобавлениеУзла

//  Процедура - Добавить узел.
//
// Параметры:
//  Наименование - Произвольный - Наименование.
//  Номенклатура - Произвольный - Номенклатура.
//  Характеристика - Произвольный - Характеристика.
//  Операция - Произвольный - Операция.
//  ТипСвязи - Строка - Тип связи.
//
&НаКлиенте
Процедура ДобавитьУзел(Наименование, Номенклатура, Характеристика, Операция, ТипСвязи = "Прямая")
	
	// Структура данных нового узла.
	УИД = Новый УникальныйИдентификатор();
	ТекУзел = Новый Структура;
	ТекУзел.Вставить("Наименование", Наименование);
	ТекУзел.Вставить("Номенклатура", Номенклатура);
	ТекУзел.Вставить("Характеристика", Характеристика);
	ТекУзел.Вставить("Операция", Операция);
	ТекУзел.Вставить("ВидУзла", ?(ЗначениеЗаполнено(Новый УникальныйИдентификатор(Операция)), 
		ПредопределенноеЗначение("Перечисление.питВидыУзловБлокСхемыХАССП.Операция"), 
		ПредопределенноеЗначение("Перечисление.питВидыУзловБлокСхемыХАССП.Номенклатура")));
	ТекУзел.Вставить("КоординатаХ", Неопределено);
	ТекУзел.Вставить("КоординатаУ", Неопределено);
	
	СтруктураНастроекХАССП = СтруктураНастроекХАССПНаСервере();
	
	// Получение текста шаблона для нового узла.
	СтрокаJS = ТекстШаблонаУзел(УИД, ТекУзел, СтруктураНастроекХАССП);
	СтрокаJSДоп = ТекстШаблонаУзелДопИнформация(УИД, ТекУзел);
	
	// Вызов JS кода.
	Элементы.Поле1.Документ.DefaultView.addNode(СтрокаJS, СтрокаJSДоп, ТипСвязи);
	Элементы.Поле1.Документ.network.storePositions();
	Элементы.Поле1.Документ.network.redraw();
	
	Модифицированность = Истина;
	
КонецПроцедуры

//  Функция - Текст шаблона узел.
//
// Параметры:
//  УИД - Произвольный - Уид.
//  ТекУзел - Произвольный - Тек узел.
//  СтруктураНастроекХАССП - Структура - Структура настроек хассп.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстШаблонаУзел(УИД, ТекУзел, СтруктураНастроекХАССП)
	СтрокаJS = "";
	СтрокаJS = СтрокаJS + "{";
	СтрокаJS = СтрокаJS + """id"": """ + УИД + """, ";
	Наим = ПолучитьПодписьУзлаПоНаименованию(ТекУзел.Наименование, "\n");
	СтрокаJS = СтрокаJS + """label"": """ + Наим + """, ";
	СтрокаJS = СтрокаJS + """fixed"": {
	|""x"": false,
	|""y"": true
	|},";
	Если НЕ ТекУзел.КоординатаХ = Неопределено Тогда
		СтрокаJS = СтрокаJS + """x"": " + ТекУзел.КоординатаХ + ", ";
	КонецЕсли;
	Если НЕ ТекУзел.КоординатаУ = Неопределено Тогда
		СтрокаJS = СтрокаJS + """y"": " + ТекУзел.КоординатаУ + ", ";
	КонецЕсли;
	СтрокаJS = СтрокаJS + """borderWidth"": %питХАССПТолщинаРамкиУзла%,";
	СтрокаJS = СтрокаJS + """font"": {""color"": ""%питХАССПЦветТекста%"", ""size"": %питХАССПРазмерТекста%},";
	
	// СтрокаJS = СтрокаJS + """margin"": {""top"": -20},";
	
	Если ТекУзел.ВидУзла = ПредопределенноеЗначение("Перечисление.питВидыУзловБлокСхемыХАССП.Номенклатура") Тогда
		СтрокаJS = СтрокаJS + """shape"": ""%питХАССПФормаУзлаНоменклатуры%"",";
		СтрокаJS = СтрокаJS + """color"": {""background"": ""%питХАССПЦветУзлаНоменклатуры%"", ""border"": ""%питХАССПЦветРамкиУзлаНоменклатуры%"", ""highlight"": {""background"": ""%питХАССПЦветВыделенногоУзлаНоменклатуры%"", ""border"": ""%питХАССПЦветРамкиВыделенногоУзлаНоменклатуры%""}}";
	Иначе
		СтрокаJS = СтрокаJS + """shape"": ""%питХАССПФормаУзлаОперации%"",";
		СтрокаJS = СтрокаJS + """color"": {""background"": ""%питХАССПЦветУзлаОперации%"", ""border"": ""%питХАССПЦветРамкиУзлаОперации%"", ""highlight"": {""background"": ""%питХАССПЦветВыделенногоУзлаОперации%"", ""border"": ""%питХАССПЦветРамкиВыделенногоУзлаОперации%""}}";
	КонецЕсли;
	СтрокаJS = СтрокаJS + "}";
	
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветУзлаОперации%"                    , СтруктураНастроекХАССП.питХАССПЦветУзлаОперации);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветРамкиУзлаОперации%"               , СтруктураНастроекХАССП.питХАССПЦветРамкиУзлаОперации);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветВыделенногоУзлаОперации%"         , СтруктураНастроекХАССП.питХАССПЦветВыделенногоУзлаОперации);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветРамкиВыделенногоУзлаОперации%"    , СтруктураНастроекХАССП.питХАССПЦветРамкиВыделенногоУзлаОперации);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветУзлаНоменклатуры%"                , СтруктураНастроекХАССП.питХАССПЦветУзлаНоменклатуры);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветРамкиУзлаНоменклатуры%"           , СтруктураНастроекХАССП.питХАССПЦветРамкиУзлаНоменклатуры);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветВыделенногоУзлаНоменклатуры%"     , СтруктураНастроекХАССП.питХАССПЦветВыделенногоУзлаНоменклатуры);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветРамкиВыделенногоУзлаНоменклатуры%", СтруктураНастроекХАССП.питХАССПЦветРамкиВыделенногоУзлаНоменклатуры);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПЦветТекста%"                          , СтруктураНастроекХАССП.питХАССПЦветТекста);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПРазмерТекста%"                        , СтруктураНастроекХАССП.питХАССПРазмерТекста);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПТолщинаРамкиУзла%"                    , СтруктураНастроекХАССП.питХАССПТолщинаРамкиУзла);
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПФормаУзлаОперации%"                   , ФормаУзлаJS(СтруктураНастроекХАССП.питХАССПФормаУзлаОперации));
	СтрокаJS = СтрЗаменить(СтрокаJS, "%питХАССПФормаУзлаНоменклатуры%"               , ФормаУзлаJS(СтруктураНастроекХАССП.питХАССПФормаУзлаНоменклатуры));
	
	Возврат СтрокаJS;
	
КонецФункции

//  Функция - Текст шаблона узел доп информация.
//
