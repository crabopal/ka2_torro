//  Процедура - Загрузить настройки хассп.
//
&НаСервере
Процедура ЗагрузитьНастройкиХАССП()
	
	КонстантыНастройкиХАССП = Новый Массив;
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветВыделенногоУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиВыделенногоУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветВыделенногоУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиВыделенногоУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветСвязи");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветВыделеннойСвязи");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветТекста");
	КонстантыНастройкиХАССП.Добавить("питХАССПРазмерТекста");
	КонстантыНастройкиХАССП.Добавить("питХАССПТолщинаРамкиУзла");
	КонстантыНастройкиХАССП.Добавить("питХАССПТолщинаСвязи");
	КонстантыНастройкиХАССП.Добавить("питХАССПФормаУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПФормаУзлаНоменклатуры");
	Для каждого ТекКонстанта Из КонстантыНастройкиХАССП Цикл
		ЭтаФорма[ТекКонстанта] = Константы[ТекКонстанта].Получить();
	КонецЦикла;
	
КонецПроцедуры

//  Функция - Структура настроек хассп на сервере.
//
// Возвращаемое значение:
//  Структура - Результат обработки.
//
&НаСервере
Функция СтруктураНастроекХАССПНаСервере()
	
	Результат = Новый Структура;
	
	КонстантыНастройкиХАССП = Новый Массив;
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветВыделенногоУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиВыделенногоУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветВыделенногоУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветРамкиВыделенногоУзлаНоменклатуры");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветСвязи");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветВыделеннойСвязи");
	КонстантыНастройкиХАССП.Добавить("питХАССПЦветТекста");
	КонстантыНастройкиХАССП.Добавить("питХАССПРазмерТекста");
	КонстантыНастройкиХАССП.Добавить("питХАССПТолщинаРамкиУзла");
	КонстантыНастройкиХАССП.Добавить("питХАССПТолщинаСвязи");
	КонстантыНастройкиХАССП.Добавить("питХАССПФормаУзлаОперации");
	КонстантыНастройкиХАССП.Добавить("питХАССПФормаУзлаНоменклатуры");
	Для каждого ТекКонстанта Из КонстантыНастройкиХАССП Цикл
		Результат.Вставить(ТекКонстанта, ЭтаФорма[ТекКонстанта]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//  Функция - Получить подпись узла по наименованию.
//
// Параметры:
//  Наименование - Произвольный - Наименование.
//  СимволПереносаСтроки - Произвольный - Символ переноса строки.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПодписьУзлаПоНаименованию(Наименование, СимволПереносаСтроки = Неопределено)
	Если СимволПереносаСтроки = Неопределено Тогда
		СимволПереносаСтроки = Символы.ПС;
	КонецЕсли;
	Если СтрДлина(Наименование) > 25 Тогда
		Наим = Сред(Наименование, 1, 25) + СимволПереносаСтроки + Сред(Наименование, 26, 50);
	Иначе
		Наим = Наименование;
	КонецЕсли;
	Наим = СтрЗаменить(Наим, """","'");
	Возврат Наим;
КонецФункции

//  Функция - Картинка сети в base 6 4.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаКлиенте
Функция КартинкаСетиВBase64()
	
	Элементы.Поле1.Документ.network.redraw();
	Элементы.Поле1.Документ.network.fit();
	Элементы.Поле1.Документ.container.style.height = "5000px";
	Элементы.Поле1.Документ.container.style.width = "5000px";
	Элементы.Поле1.Документ.network.redraw();
	Элементы.Поле1.Документ.network.fit();
	
	КартинкаВBase64 = СтрЗаменить(Элементы.Поле1.Документ.window.picURL, "data:image/png;base64,", "");
	
	Элементы.Поле1.Документ.container.style.height = "100%";
	Элементы.Поле1.Документ.container.style.width = "100%";
	Элементы.Поле1.Документ.network.redraw();
	Элементы.Поле1.Документ.network.fit();
	
	Возврат КартинкаВBase64;
	
КонецФункции

//  Функция - Получить добавляемые данные.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ПолучитьДобавляемыеДанные(ВыбранноеЗначение)
	Результат = Новый Массив;
	ДобавляемыеУзлы = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	Для каждого ДобавляемыйУзел Из ДобавляемыеУзлы Цикл
		Результат.Добавить(Новый Структура("Наименование, Номенклатура, Характеристика, Операция, ТипСвязи", 
			ДобавляемыйУзел.Наименование, 
			XMLСтрока(ДобавляемыйУзел.Номенклатура), 
			XMLСтрока(ДобавляемыйУзел.Характеристика), 
			XMLСтрока(ДобавляемыйУзел.Операция),
			ДобавляемыйУзел.ТипСвязи));
	КонецЦикла;
	Возврат Результат;
КонецФункции

