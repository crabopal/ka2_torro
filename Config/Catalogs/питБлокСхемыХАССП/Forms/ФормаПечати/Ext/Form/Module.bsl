
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("КартинкаBase64", КартинкаBase64);
	
	Макет = Справочники.питБлокСхемыХАССП.ПолучитьМакет("ПечатьБлокСхемы");
	
	Область = Макет.ПолучитьОбласть("Шапка");
	Табдок.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("Данные");
	
	Рисунок = Область.Рисунки.D1;
	Рисунок.Верх = 0;
	Рисунок.Высота = 277;
	Рисунок.Ширина = 190;
	Рисунок.Лево = 0;
	
	ОбъектКартинки = Новый Картинка(Base64Значение(КартинкаBase64));
	Рисунок.Картинка = ОбъектКартинки;
	ТабДок.Вывести(Область);
	
	
КонецПроцедуры

#КонецОбласти
