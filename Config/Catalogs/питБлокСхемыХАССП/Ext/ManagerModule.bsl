#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область Печать

// Заполняет список команд печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечат.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	МожноРедактировать = ПравоДоступа("Редактирование", Метаданные.Справочники.питБлокСхемыХАССП);
	Если НЕ МожноРедактировать Тогда
		Возврат;
	КонецЕсли;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "питПечатьБлокСхемыХАССП";
	КомандаПечати.Представление = НСтр("ru = 'Блок-схема технологического процесса'");
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

//  Процедура - Печать.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ПараметрыПечати - Произвольный - Параметры печати.
//  КоллекцияПечатныхФорм - Произвольный - Коллекция печатных форм.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  ПараметрыВывода - Произвольный - Параметры вывода.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "питПечатьБлокСхемыХАССП") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "питПечатьБлокСхемыХАССП", "Бракеражный журнал",
			ПечатьБлокСхемыХАССП(МассивОбъектов, ОбъектыПечати),,"Справочник.питБлокСхемыХАССП.ПФ_MXL_питПечатьБлокСхемыХАССП");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Печать

// Функция формирует табличный документ с печатной формой "Бракеражный журнал"
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма
Функция ПечатьБлокСхемыХАССП(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.питБлокСхемыХАССП.ПФ_MXL_питПечатьБлокСхемыХАССП");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ПолеСверху			= 0;
	ТабличныйДокумент.ПолеСлева				= 0;
	ТабличныйДокумент.ПолеСнизу				= 0;
	ТабличныйДокумент.ПолеСправа			= 0;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_питБлокСхемыХАССП_питПечатьБлокСхемыХАССП";
	
	СисИнфо = Новый СистемнаяИнформация;
	Если ПустаяСтрока(СисИнфо.ИнформацияПрограммыПросмотра) Тогда 
		ТабличныйДокумент.ПолеСлева          = 0;
	Иначе
		ТабличныйДокумент.ПолеСлева          = 10;
	КонецЕсли;
	
	// Признак того, что документ первый(для последующих документов
	// вставляем горизонтальный разделитель страниц.
	ПервыйДокумент = Истина;
	
	//////////////////////////////////////////////////////////
	// Обход массива объектов.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питБлокСхемыХАССП.Ссылка КАК Ссылка,
	|	питБлокСхемыХАССП.КартинкаВBase64 КАК КартинкаВBase64
	|ИЗ
	|	Справочник.питБлокСхемыХАССП КАК питБлокСхемыХАССП
	|ГДЕ
	|	питБлокСхемыХАССП.Ссылка В(&МассивОбъектов)";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаВерхняя = РезультатЗапроса.Выбрать();
	Пока ВыборкаВерхняя.Следующий() Цикл
		
		////////////////////////////////////////////////////////////
		// Подготовка табличного документа и макета
		// Для не первого документа вставка разделителя страниц.
		Если НЕ ПервыйДокумент Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Область = Макет.ПолучитьОбласть("Шапка");
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Данные");
		
		Рисунок = Область.Рисунки.D1;
		Рисунок.Верх = 0;
		Рисунок.Высота = 277;
		Рисунок.Ширина = 190;
		Рисунок.Лево = 0;
		
		ОбъектКартинки = Новый Картинка(Base64Значение(ВыборкаВерхняя.КартинкаВBase64));
		Рисунок.Картинка = ОбъектКартинки;
		ТабличныйДокумент.Вывести(Область);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

 #КонецЕсли
