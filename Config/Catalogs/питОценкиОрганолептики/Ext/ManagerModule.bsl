#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выполняет проверку на наличие предопределенных оценок
//  и создание данных оценок при необходимости.
//
Процедура ПроверитьСоздатьОценкиОрганолептики() Экспорт
	
	ИдентификаторыОценок = ИдентификаторыОценок();
	
	ПолучитьСоздатьОценку("Хорошо"				, ИдентификаторыОценок.Получить("Хорошо"));
	ПолучитьСоздатьОценку("Отлично"				, ИдентификаторыОценок.Получить("Отлично"));
	ПолучитьСоздатьОценку("Удовлетворительно"	, ИдентификаторыОценок.Получить("Удовлетворительно"));
	ПолучитьСоздатьОценку("Неудовлетворительно"	, ИдентификаторыОценок.Получить("Неудовлетворительно"));
	
КонецПроцедуры // ПроверитьСоздатьОценкиОрганолептики()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает роль пользователя фронта.
//
// Параметры:
//  Наименование - Произвольный - Наименование.
//  ИДСтрокой - Произвольный - Ид строкой.
//
// Возвращаемое значение:
// 	 СправочникСсылка.РольПользователяФронта.
Функция ПолучитьСоздатьОценку(Наименование, ИДСтрокой)
	
	МенеджерОбъекта = Справочники.питОценкиОрганолептики;
	СоздаватьОбъект = Истина;
	
	СпрОбъект = питОбщегоНазначенияHACCP.ПолучитьОбъектПоИД(ИДСтрокой, МенеджерОбъекта, Ложь, СоздаватьОбъект);
	Если СпрОбъект.ЭтоНовый() Тогда
		СпрОбъект.Наименование 	= Наименование;
		СпрОбъект.УстановитьНовыйКод();
		Попытка
			СпрОбъект.ДополнительныеСвойства.Вставить("Загрузка", Истина);
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
			СпрСсылка = СпрОбъект.Ссылка;
		Исключение
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			СпрСсылка = МенеджерОбъекта.ПустаяСсылка();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка записи оценки органолептики <" + СпрОбъект.Наименование + ">: " + ТекстОшибки;
			Сообщение.Сообщить();
		КонецПопытки;
	Иначе
		Возврат СпрОбъект.Ссылка;
	КонецЕсли; 
	
	Возврат СпрСсылка;
	
КонецФункции

// ПолучитьРольПользователяФронта()
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ИдентификаторыОценок()
	
	Результат = Новый Соответствие;
	Результат.Вставить("Хорошо"					, "c55d1456-58bb-4b61-b445-279235ddad71");
	Результат.Вставить("Отлично"				, "6f625f87-2752-471a-8342-618652919d64");
	Результат.Вставить("Удовлетворительно"		, "9d192b47-4790-4cd6-93e2-b09018ed733c");
	Результат.Вставить("Неудовлетворительно"	, "d43574d6-4a54-48b0-abcc-bf35aded5f76");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли










