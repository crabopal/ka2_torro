
#Область ПрограммныйИнтерфейс
// Функция получает строку с представлением карточек, назначеных пользователю.
//
// Параметры:
//  Пользователь - Произвольный - Пользователь.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьПредставлениеКарточекПользователя(Пользователь) Экспорт
	Если Пользователь.Пустая() Тогда
		Возврат "не задана";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Карточки.Ссылка,
	|	Карточки.ДанныеКарты
	|ИЗ
	|	Справочник.питКарточки КАК Карточки
	|ГДЕ
	|	Карточки.Пользователь = &Пользователь
	|	И Карточки.Авторизация";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "не задана";
	Иначе
		СтрокаКарты = "";
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаКарты = ?(ПустаяСтрока(СтрокаКарты), СтрокаКарты, СтрокаКарты + ", ") + Выборка.ДанныеКарты;
		КонецЦикла;
		Возврат СтрокаКарты;
	КонецЕсли;
	
КонецФункции

#КонецОбласти




