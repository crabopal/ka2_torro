#Область ПрограммныйИнтерфейс

// Модуль справочника Карточки

// Проверяет корректность заполнения объекта.
//  Возвращает Истина, если все заполнено корректно и Ложь иначе.
//  В случае некорректного заполнения формирует строку с описанием возникших ошибок "Ошибки".
//  На вход может быть передана структура ДопРеквизиты с дополнительными реквизитами для проверки.
//  Может управляться флагами выполняемых проверок Заполнение, Уникальность
//  (могут быть и другие необязательные).
//  Обычно выполняется универсальным обработчиком, но могут быть добавлены дополнительные проверки.
//
// Параметры:
//  Ошибки - Произвольный - Ошибки.
//  ДопРеквизиты - Произвольный - Доп реквизиты.
//  Заполнение - Произвольный - Заполнение.
//  Уникальность - Произвольный - Уникальность.
//
// Возвращаемое значение:
//   Булево - Правильность заполнения объекта.
Функция ПроверитьКорректность(Ошибки="", ДопРеквизиты=Неопределено, Заполнение=Истина, Уникальность=Истина) Экспорт
	
	Результат = Истина;
	
	Если НЕ ЭтоГруппа Тогда
		Если Платежная Тогда
			
			Если ВидОплаты.Пустая() Тогда
				Ошибки = Ошибки + Символы.ПС + "Не заполнен реквизит ""Вид оплаты"" для платежной карты!";
			ИначеЕсли  ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны И КратностьПлатежа = 0 Тогда
				Ошибки = Ошибки + Символы.ПС + "Не заполнен реквизит ""Кратность платежа"" для платежной карты с типом оплаты ""Талоны и купоны""!";
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питПитаниеСотрудников
			ИЛИ ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны
			ИЛИ ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.ПлатежнаяКарта Тогда
			Если Контрагент.Пустая() И ВидОплаты.Контрагент.Пустая() Тогда
				Ошибки = Ошибки + Символы.ПС + "Не заполнен реквизит ""Контрагент"" для данной карточки или для типа оплаты """ 
					+ Строка(ВидОплаты) + """!";
			КонецЕсли; 
			Если Договор.Пустая() И ВидОплаты.ДоговорКонтрагента.Пустая() Тогда
				Ошибки = Ошибки + Символы.ПС + "Не заполнен реквизит ""Договор"" для данной карточки или для типа оплаты """ 
					+ Строка(ВидОплаты) + """!";
			КонецЕсли;
		КонецЕсли; 
		
		Если Авторизация И Пользователь.Пустая() Тогда
			Ошибки = Ошибки + Символы.ПС + "Не заполнен реквизит ""Пользователь"" для карты авторизации!";
		КонецЕсли;
		
		Если Служебная И ПустаяСтрока(КодСлужебнойОперации) Тогда
			Ошибки = Ошибки + Символы.ПС + "Не заполнен реквизит ""Код служебной операции"" для служебной карточки!";
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ДатаАктивации) И ЗначениеЗаполнено(ДатаПрекращенияДействия)
			И ДатаАктивации > ДатаПрекращенияДействия Тогда
			Ошибки = Ошибки + Символы.ПС + """Дата активации"" позже ""Даты прекращения действия"" карточки!";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаАктивации) И ЗначениеЗаполнено(ДатаПрекращенияДействия)
			И ДатаАктивации = ДатаПрекращенияДействия Тогда
			Ошибки = Ошибки + Символы.ПС + """Дата активации"" равна ""Даты прекращения действия"" карточки!";
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(Ошибки) Тогда
			Ошибки = СокрЛП(Ошибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СТАНДАРТНЫХ СОБЫТИЙ ОБЪЕКТА

// Стандартный обработчик ПередЗаписью
//
// Параметры:
//  Отказ - Булево - Отказ.
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка 
		ИЛИ (ДополнительныеСвойства.Свойство("Загрузка") 
		И ДополнительныеСвойства.Загрузка) Тогда
		Возврат;
	КонецЕсли;
	
	ДопРеквизиты	= Неопределено;
	Заполнение		= Истина;
	Уникальность	= Истина;
	ПроизошлаОшибка	= Ложь;
	ТекстОшибки		= "";
	
	// Выполним проверку корректности заполнения
	Если Не ЭтотОбъект.ПометкаУдаления Тогда
		ПроизошлаОшибка = Не ПроверитьКорректность(ТекстОшибки, ДопРеквизиты, Заполнение, Уникальность);
	КонецЕсли; 
	
	// Индикация ошибок
	Если (ПроизошлаОшибка) И (Не ПустаяСтрока(ТекстОшибки)) Тогда
		ТекстСообщения	= "Перед записью элемента - "+Наименование+" обнаружены ошибки :
		|"+ТекстОшибки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#КонецЕсли




