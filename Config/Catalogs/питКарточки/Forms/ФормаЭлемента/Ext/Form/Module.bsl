
#Область ПрограммныйИнтерфейс

//  Процедура - Установить штрих код завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура УстановитьШтрихКод_Завершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	НовыйШтрихКод = ДополнительныеПараметры.НовыйШтрихКод;
	
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет  Тогда
		Возврат;
	КонецЕсли;
	
	
	УстановитьШтрихКодФрагмент(НовыйШтрихКод);
КонецПроцедуры

//  Процедура - Данные карты при изменении завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ДанныеКартыПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Объект.ДанныеКарты = "";
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - Сформировать штрих код завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура СформироватьШтрихКодЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	
	СформироватьШтрихКодФрагмент();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

// Обработчик события формы "При октрытии".
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	
	УстановитьДоступностьВидаКарточки();
	УстановитьДоступностьЭлементовПоВидуКарточки();
	УстановитьДоступностьЭлементовПоВидуОплаты();
	
	СтараяМастерКарта = Объект.МастерКарта;
	СтарыйВидОплаты = Объект.ВидОплаты;
	
	Модифицированность = Ложь;
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Перед записью на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

// Обработчик внешнего события.
//
// Параметры:
//  Источник - Произвольный - Источник.
//  Событие - Произвольный - Событие.
//  Данные - Произвольный - Данные.
//
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Если Источник = "Сканер" Тогда
		Если НЕ ЭтаФорма.ВводДоступен() Тогда
			Возврат;
		КонецЕсли;
		УстановитьШтрихКод(Данные);	
	КонецЕсли;
КонецПроцедуры

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	УстановитьПараметрыВыбораВидаОплаты();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

// Обработчик изменения реквизита "Мастер-карта"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура МастерКартаПриИзменении(Элемент)
	Если НЕ Объект.Ссылка.Пустая() И НЕ Объект.МастерКарта.Пустая() Тогда
		Если Объект.МастерКарта = Объект.Ссылка Тогда
			ТекстСообщения = "Карточка не может являться мастер-картой для себя самой.";
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
			Объект.МастерКарта = СтараяМастерКарта;
		КонецЕсли;
	Иначе
		СтараяМастерКарта = Объект.МастерКарта;
	КонецЕсли;
КонецПроцедуры

// Обработчик изменения признаков "Платежная", "Авторизация", "Служебная", "Дисконтная".
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура СпособИспользованияПриИзменении(Элемент)
	УстановитьДоступностьВидаКарточки(Элемент.Имя);
	УстановитьДоступностьЭлементовПоВидуКарточки();
КонецПроцедуры

// Обработчик изменения реквизита "Контрагент"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	КонтрагентПриИзмененииСервер();
КонецПроцедуры

// Обработчик изменения реквизита "Договор"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ДоговорПриИзмененииСервер();
КонецПроцедуры

// Обработчик изменения реквизита "Вид оплаты"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ВидОплатыПриИзменении(Элемент)
	Если ВидОплатыПерсонификацияПлатежа() Тогда
		СтарыйВидОплаты = Объект.ВидОплаты;
	Иначе
		Если НЕ Объект.ВидОплаты.Пустая() Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для вида оплаты должен быть установлен признак персонификации платежа!";
			Сообщение.Сообщить();
			Объект.ВидОплаты = СтарыйВидОплаты;
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	УстановитьДоступностьЭлементовПоВидуОплаты(); 
КонецПроцедуры

//  Процедура - Вид оплаты открытие.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ВидОплатыОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыПередачи = Новый Структура;
	
	ДопустимыеТипыОплаты = Новый Массив;
	
	ДопустимыеТипыОплаты.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.ПлатежнаяКарта"));
	ДопустимыеТипыОплаты.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.БанковскийКредит"));
	ДопустимыеТипыОплаты.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питКлубнаяКарта"));
	ДопустимыеТипыОплаты.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питПитаниеСотрудников"));
	ДопустимыеТипыОплаты.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питТалоныИКупоны"));
	
	ПараметрыПередачи.Вставить("ТипОплатыДоступныеЗначения", ДопустимыеТипыОплаты);
	ПараметрыПередачи.Вставить("Ключ", Объект.ВидОплаты);
	
	ОткрытьФорму("Справочник.питВидыОплатОрганизаций.ФормаОбъекта", ПараметрыПередачи, ЭтаФорма);
	
КонецПроцедуры

// Обработчик события изменения реквизита "Данные карты"
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ДанныеКартыПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Объект.ДанныеКарты) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ШтрихКодСвободен() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Указанный штрих-код уже используется";
		Сообщение.Сообщить();
		Объект.ДанныеКарты = "";
		Возврат;
	КонецЕсли; 
	ШК = СокрЛП(Объект.ДанныеКарты);
	
	Если (СтрДлина(ШК) < 13) ИЛИ (EAN13(Лев(ШК,12)) <> ШК) Тогда
		ТекстВопроса = "Внимание! Введенный код не является штрих-кодом стандарта EAN13
			|Вы уверены, что хотите использовать этот нестандартный штрих-код?";
		ПоказатьВопрос(Новый ОписаниеОповещения("ДанныеКартыПриИзмененииЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

//  Процедура - Клиент при изменении.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	КлиентПриИзмененииНаСервере(Объект.Клиент,Объект.Контрагент);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

// Обработчик команды "Сформировать штрих-код"
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СформироватьШтрихКод(Команда)
	Попытка 
		ТекущийКод = Число(Объект.ДанныеКарты); 
	Исключение 
		ТекущийКод = -1; 
	КонецПопытки;
	
	Если ТекущийКод > 0 Тогда
		Если Лев(ТекущийКод, 2) <> Строка(ПолучитьПрефиксШК()) Тогда
			лкСтр="		Текущий штрих-код товара был сформирован в другой информационной базе или продукте!";
		Иначе
			лкСтр="		У текущего товара уже задан штрих-код!";
		КонецЕсли;
		лкСтр=лкСтр+ Символы.ПС+" ВНИМАНИЕ! Изменение кода может привести к неправильной работе процедур обмена данными и поиска товаров!
		| Изменение штрих-кода НЕ РЕКОМЕНДУЕТСЯ!
		| Продолжить формирование нового штрих-кода?";
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СформироватьШтрихКодЗавершение", ЭтотОбъект), лкСтр,РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	СформироватьШтрихКодФрагмент();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

// Установка нового значения штрих-кода
//
// Параметры:
//  Знач НовыйШтрихКод - Произвольный - Знач новый штрих код.
//
&НаКлиенте
Процедура УстановитьШтрихКод(Знач НовыйШтрихКод)
	
	Если ЗначениеЗаполнено(Объект.ДанныеКарты) Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьШтрихКод_Завершение", ЭтотОбъект, Новый Структура("НовыйШтрихКод", НовыйШтрихКод)), "Изменить штрих-код карты?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	УстановитьШтрихКодФрагмент(НовыйШтрихКод);
КонецПроцедуры

//  Процедура - Установить штрих код фрагмент.
//
// Параметры:
//  НовыйШтрихКод - Произвольный - Новый штрих код.
//
&НаКлиенте
Процедура УстановитьШтрихКодФрагмент(Знач НовыйШтрихКод)
	
	Объект.ДанныеКарты = НовыйШтрихКод;
	
КонецПроцедуры

// Устанавливает доступность элементов управления
//  в зависимости от вида карточки.
//
// Параметры:
//  Вид - Произвольный - Вид.
//
&НаКлиенте
Процедура УстановитьДоступностьВидаКарточки(Вид = "")
	
	Если Объект.Служебная Тогда
		Объект.Дисконтная = Ложь;
		Объект.Платежная = Ложь;
		Объект.Авторизация = Ложь;
		
		Элементы.Дисконтная.Доступность= Ложь;
		Элементы.Платежная.Доступность = Ложь;
		Элементы.Авторизация.Доступность = Ложь;
		Элементы.ПанельСпособыИспользования.ТекущаяСтраница = Элементы.СтраницаСлужебная;
		Элементы.СтраницаСлужебная.Доступность = Истина;
		Элементы.СтраницаДисконтная.Доступность = Ложь;
		Элементы.СтраницаПлатежная.Доступность = Ложь;
		Элементы.СтраницаАвторизация.Доступность = Ложь;
		
	Иначе
		Элементы.Дисконтная.Доступность = Истина;
		Элементы.Платежная.Доступность = Истина;
		Элементы.Авторизация.Доступность = Истина;
		Элементы.СтраницаДисконтная.Доступность = Объект.Дисконтная;
		Элементы.СтраницаПлатежная.Доступность = Объект.Платежная;		 
		Элементы.СтраницаАвторизация.Доступность = Объект.Авторизация;				
		Элементы.СтраницаСлужебная.Доступность = Ложь;
		
		Если Объект.Платежная Тогда
			ТекВид = "Платежная";
		ИначеЕсли Объект.Дисконтная Тогда
			ТекВид = "Дисконтная";
		ИначеЕсли Объект.Авторизация Тогда
			ТекВид = "Авторизация"; 
		ИначеЕсли Объект.Служебная Тогда
			ТекВид = "Служебная";
		Иначе
			ТекВид = "Платежная";
		КонецЕсли; 
		
		Если НЕ ПустаяСтрока(Вид) И Объект[Вид] Тогда
			ТекВид = Вид;
		КонецЕсли;
		
		Элементы.ПанельСпособыИспользования.ТекущаяСтраница = Элементы["Страница" + ТекВид];		
	КонецЕсли; 
	
КонецПроцедуры

// Устанавливает доступность элементов управления, связанных
//  с видом карточки.
//
&НаКлиенте
Процедура УстановитьДоступностьЭлементовПоВидуКарточки()
	
	Элементы.СуммаНакопленная.Доступность = Объект.Дисконтная;
	
	Если Объект.Платежная Тогда
		Элементы.КратностьПлатежа.Доступность = Истина;
		Элементы.ВидОплаты.Доступность = Истина;
		Элементы.МастерКарта.Доступность = Истина;
	Иначе
		Элементы.КратностьПлатежа.Доступность = Ложь;
		Элементы.ВидОплаты.Доступность = Ложь;
		Элементы.МастерКарта.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает доступность элементов управления, связанных
//  с типом оплаты.
//
&НаСервере
Процедура УстановитьДоступностьЭлементовПоВидуОплаты()
	
	Элементы.Сотрудник.Доступность = Объект.ВидОплаты.ТипОплаты = ПредопределенноеЗначение("Перечисление.питТипыОплат.питПитаниеСотрудников");
	Элементы.Сотрудник.Доступность = Истина;
КонецПроцедуры

// Обработчик изменения реквизита "Контрагент" (на сервере).
//
&НаСервере
Процедура КонтрагентПриИзмененииСервер()
	Если Объект.Контрагент <> Объект.Договор.Владелец Тогда
		Объект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли; 	
КонецПроцедуры

// Обработчик изменения реквизита "Договор" (сервер)
//
&НаСервере
Процедура ДоговорПриИзмененииСервер()
	Если НЕ Объект.Договор.Пустая() Тогда
		Объект.Контрагент = Объект.Договор.Контрагент;
	КонецЕсли; 
КонецПроцедуры

//  Процедура - Установить параметры выбора вида оплаты.
//
&НаСервере
Процедура УстановитьПараметрыВыбораВидаОплаты()
	
	ТипыОплатБезналичныеОплаты = Новый Массив;
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.ПлатежнаяКарта);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.БанковскийКредит);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питКлубнаяКарта);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питПитаниеСотрудников);
	ТипыОплатБезналичныеОплаты.Добавить(Перечисления.питТипыОплат.питТалоныИКупоны);
	
	ПараметрыБезналичныхОплат = Новый Массив;
	
	ПараметрыБезналичныхОплат.Добавить(Новый ПараметрВыбора("Отбор.ТипОплаты", Новый ФиксированныйМассив(ТипыОплатБезналичныеОплаты)));
	
	Элементы.ВидОплаты.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыБезналичныхОплат);
	
КонецПроцедуры

