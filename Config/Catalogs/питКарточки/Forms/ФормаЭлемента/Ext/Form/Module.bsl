КонецФункции

//  Процедура - Сформировать штрих код фрагмент.
//
&НаКлиенте
Процедура СформироватьШтрихКодФрагмент()
	
	Перем СформированныйКод;
	
	СформированныйКод = СформироватьШтрихКодСервер();
	Если ПустаяСтрока(СформированныйКод) Тогда
		ПоказатьПредупреждение(Неопределено, "Не удалось сформировать еще не занятый штрих-код EAN13 за сто попыток.");
		Возврат;
	КонецЕсли;	
	Объект.ДанныеКарты = СформированныйКод;
	Модифицированность = Истина;
	
КонецПроцедуры

