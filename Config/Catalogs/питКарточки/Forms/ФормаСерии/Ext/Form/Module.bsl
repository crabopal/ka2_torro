
#Область ПрограммныйИнтерфейс

//  Процедура - Вопрос о вводе серии карточек завершение.
//
// Параметры:
//  РезультатВопроса - Произвольный - Результат вопроса.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ВопросОВводеСерииКарточек_Завершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	НачНомер = ДополнительныеПараметры.НачНомер;
	Префикс = ДополнительныеПараметры.Префикс;
	СтрокаНулей = ДополнительныеПараметры.СтрокаНулей;
	ЧислоЦифр = ДополнительныеПараметры.ЧислоЦифр;
	
	СсылкаДанных = Неопределено;
	СоздатьСериюСервер(НачНомер, СтрокаНулей, ЧислоЦифр, Префикс, СсылкаДанных);
	Если НЕ СсылкаДанных = Неопределено Тогда
		ОповеститьОбИзменении(СсылкаДанных);
	КонецЕсли;
	ПоказатьПредупреждение(Неопределено, "Создание новой серии завершено!");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Обработчик события формы "При открытии"
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВидКарточкиПриИзменении(Неопределено);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

// Обработчик изменения вида карточки.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ВидКарточкиПриИзменении(Элемент)
	Элементы.ВидОплаты.Доступность = ВидКарточки = 1;
	Элементы.КратностьПлатежа.Доступность = ВидКарточки = 1;
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды "Сформировать"
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура Сформировать(Команда)
	Если ПустаяСтрока(ШтрихКод) ИЛИ СтрДлина(ШтрихКод) < 4 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Длина штрих-кода должна быть не менее 4 символов.",,"ШтрихКод");
		Возврат;
	КонецЕсли;
	
	Если КоличествоКарточек = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задано количество карточек",,"КоличествоКарточек");
		Возврат;
	КонецЕсли;
	 
	
	// Автоопределение количества цифр в окончании кода.
	ШтрихКод   = СокрЛП(ШтрихКод); 
	ЧислоЦифр  = 0;
	СтрокаЦифр = "0123456789";
	ДлинаШтрихКода = СтрДлина(ШтрихКод);
	Для сч = 1 По ДлинаШтрихКода Цикл
		ОконШтрихКода = Прав(ШтрихКод,сч);
		Симв = Лев(ОконШтрихКода,1);
		Если Найти(СтрокаЦифр,Симв)=0 Тогда 
			Прервать 
		Иначе ЧислоЦифр = ЧислоЦифр + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ЧислоЦифр = ДлинаШтрихКода Тогда  
	ИначеЕсли ЧислоЦифр = 0 ИЛИ (ЧислоЦифр < СтрДлина(КоличествоКарточек)) ИЛИ (СтрДлина(СтрЗаменить(КоличествоКарточек + Прав(ШтрихКод, ЧислоЦифр), Символ(160), "")) > ЧислоЦифр) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Длины цифровой части в окончании кода не хватает для генерации " + Строка(КоличествоКарточек) + " карточек";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если ЧислоЦифр = ДлинаШтрихКода Тогда
		ЧислоЦифр = 4;
		Префикс = Лев(ШтрихКод, ДлинаШтрихКода-4);
	Иначе
		Префикс = Лев(ШтрихКод, ДлинаШтрихКода-ЧислоЦифр);	
	КонецЕсли;
	НачНомер=Число(Прав(ШтрихКод, ЧислоЦифр))+1;	
	СтрокаНулей = "";
	Для сч = 1 По ЧислоЦифр Цикл
		СтрокаНулей = СтрокаНулей + "0";
	КонецЦикла;
	
	КолПересечений=0;
	ТекКарта = Неопределено;
	Для Сч = НачНомер По НачНомер + КоличествоКарточек - 1 Цикл
		ШтрихКод = Префикс + Прав(СтрокаНулей + Формат(Сч, "ЧГ="), ЧислоЦифр);
		Если НЕ питОбщегоНазначения.ШтрихКодУникален(ШтрихКод) Тогда
			КолПересечений = КолПересечений + 1;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Код [" + ШтрихКод + "] уже используется";
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;
	
	Если КолПересечений > 0 Тогда
		ПоказатьПредупреждение(Неопределено, "При проверке номеров новой серии карточек
						|были найдены пересечения с существующими
						|карточками. НОВАЯ СЕРИЯ НЕ СОЗДАНА !");
		Возврат;
	КонецЕсли;
	ТекстВопроса = "Уверены, что хотите ввести серию
					|из " + КоличествоКарточек + " новых карточек с кодами
					|" + Префикс + Прав(СтрокаНулей + Формат(НачНомер, "ЧГ="), ЧислоЦифр) 
					+ "  -  " + Префикс + Прав(СтрокаНулей + Формат(НачНомер + КоличествоКарточек - 1,"ЧГ="),ЧислоЦифр)+" ?";
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ВопросОВводеСерииКарточек_Завершение", ЭтотОбъект, Новый Структура("НачНомер, Префикс, СтрокаНулей, ЧислоЦифр", НачНомер, Префикс, СтрокаНулей, ЧислоЦифр)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура создания серии карточек.
//
// Параметры:
//  НачНомер - Произвольный - Нач номер.
//  СтрокаНулей - Строка - Строка нулей.
//  ЧислоЦифр - Число - Число цифр.
//  Префикс - Произвольный - Префикс.
//  СсылкаДанных - Произвольный - Ссылка данных.
//
&НаСервере
Процедура СоздатьСериюСервер(НачНомер, СтрокаНулей, ЧислоЦифр, Префикс, СсылкаДанных = Неопределено)
	НачатьТранзакцию();
	Для Сч = НачНомер По НачНомер + КоличествоКарточек - 1 Цикл
		ШтрихКод = Префикс + Прав(СтрокаНулей + Формат(Сч, "ЧГ="), ЧислоЦифр);
		Если (Сч - НачНомер) % 50 = 0 Тогда
			ЗафиксироватьТранзакцию();
			НачатьТранзакцию();
		КонецЕсли;
		
		НовыйЭлемент = Справочники.питКарточки.СоздатьЭлемент();
		НовыйЭлемент.УстановитьНовыйКод();
		НовыйЭлемент.Наименование = ШтрихКод;
		НовыйЭлемент.ДанныеКарты = ШтрихКод;
		НовыйЭлемент.Дисконтная = ВидКарточки = 0;
		НовыйЭлемент.Платежная = ВидКарточки = 1;
		Если ВидКарточки = 1 Тогда
			НовыйЭлемент.ВидОплаты = ВидОплаты;
			Если ВидОплаты.ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны Тогда
				НовыйЭлемент.КратностьПлатежа = КратностьПлатежа;
			КонецЕсли;
		КонецЕсли;
		НовыйЭлемент.Родитель = Параметры.Родитель;
		
		Попытка
			НовыйЭлемент.Записать();
			СсылкаДанных = НовыйЭлемент.Ссылка;
		Исключение 
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания карточки: " + Строка(ШтрихКод) + ": " + ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
КонецПроцедуры

#КонецОбласти


