#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область Печать

// Заполняет список команд печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечат.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	МожноРедактировать = ПравоДоступа("Редактирование", Метаданные.Справочники.питКритическиеКонтрольныеТочки);
	Если НЕ МожноРедактировать Тогда
		Возврат;
	КонецЕсли;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "питФормаРабочегоЛистаХАССП";
	КомандаПечати.Представление = НСтр("ru = 'Форма рабочего листа ХАССП'");
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

// Процедура - Печать.
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ПараметрыПечати - Произвольный - Параметры печати.
//  КоллекцияПечатныхФорм - Произвольный - Коллекция печатных форм.
//  ОбъектыПечати - Произвольный - Объекты печати.
//  ПараметрыВывода - Произвольный - Параметры вывода.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "питФормаРабочегоЛистаХАССП") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "питФормаРабочегоЛистаХАССП", "Бракеражный журнал",
			ПечатьРабочийЛистХАССП(МассивОбъектов, ОбъектыПечати),,"Справочник.питКритическиеКонтрольныеТочки.ПФ_MXL_питФормаРабочегоЛистаХАССП");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Печать

// Функция формирует табличный документ с печатной формой "Бракеражный журнал"
//
// Параметры:
//  МассивОбъектов - Массив - Массив объектов.
//  ОбъектыПечати - Произвольный - Объекты печати.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма
Функция ПечатьРабочийЛистХАССП(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.питКритическиеКонтрольныеТочки.ПФ_MXL_питФормаРабочегоЛистаХАССП");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ПолеСверху			= 0;
	ТабличныйДокумент.ПолеСлева				= 0;
	ТабличныйДокумент.ПолеСнизу				= 0;
	ТабличныйДокумент.ПолеСправа			= 0;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_питКритическиеКонтрольныеТочки_питФормаРабочегоЛистаХАССП";
	
	СисИнфо = Новый СистемнаяИнформация;
	Если ПустаяСтрока(СисИнфо.ИнформацияПрограммыПросмотра) Тогда 
		ТабличныйДокумент.ПолеСлева          = 0;
	Иначе
		ТабличныйДокумент.ПолеСлева          = 10;
	КонецЕсли;
	
	// Признак того, что документ первый(для последующих документов
	// вставляем горизонтальный разделитель страниц.
	ПервыйДокумент = Истина;
	
	//////////////////////////////////////////////////////////
	// Обход массива объектов.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питКритическиеКонтрольныеТочки.Наименование КАК Наименование,
	|	питКритическиеКонтрольныеТочки.ОпасныйФактор.Наименование КАК ОпасныйФактор,
	|	питКритическиеКонтрольныеТочки.Код КАК НомерККТ,
	|	питКритическиеКонтрольныеТочкиКонтролируемыеПараметры.Параметр КАК КонтролируемыйПараметр,
	|	питКритическиеКонтрольныеТочкиКонтролируемыеПараметры.ПредельныеЗначения КАК ПредельныеЗначения,
	|	питКритическиеКонтрольныеТочкиКонтролируемыеПараметры.ПроцедураМониторинга КАК ПроцедураМониторинга,
	|	питКритическиеКонтрольныеТочкиКонтролируемыеПараметры.КорректирующиеДействия КАК КорректирующееДействие,
	|	питКритическиеКонтрольныеТочки.Ссылка КАК Ссылка,
	|	"""" КАК НаименованиеТехнологическогоПроцесса,
	|	питКритическиеКонтрольныеТочки.ОпасныйФактор.ТипОпасногоФактора.Наименование КАК ТипОпасногоФактора
	|ИЗ
	|	Справочник.питКритическиеКонтрольныеТочки КАК питКритическиеКонтрольныеТочки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питКритическиеКонтрольныеТочки.КонтролируемыеПараметры КАК питКритическиеКонтрольныеТочкиКонтролируемыеПараметры
	|		ПО (питКритическиеКонтрольныеТочкиКонтролируемыеПараметры.Ссылка = питКритическиеКонтрольныеТочки.Ссылка)
	|ГДЕ
	|	питКритическиеКонтрольныеТочки.Ссылка В(&МассивОбъектов)
	|	И питКритическиеКонтрольныеТочкиКонтролируемыеПараметры.Ссылка В(&МассивОбъектов)
	|ИТОГИ
	|	МАКСИМУМ(НаименованиеТехнологическогоПроцесса)
	|ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питПродукцияККТ.КритическаяКонтрольнаяТочка КАК КритическаяКонтрольнаяТочка,
	|	питПродукцияККТ.Номенклатура КАК Номенклатура,
	|	питПродукцияККТ.Характеристика КАК Характеристика,
	|	питПродукцияККТ.Номенклатура.НаименованиеПолное КАК НоменклатураНаименование,
	|	питПродукцияККТ.Характеристика.НаименованиеПолное КАК ХарактеристикаНаименование
	|ИЗ
	|	РегистрСведений.питПродукцияККТ КАК питПродукцияККТ
	|ГДЕ
	|	питПродукцияККТ.КритическаяКонтрольнаяТочка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	питКритическиеКонтрольныеТочкиДокументы.Ссылка КАК КритическаяКонтрольнаяТочка,
	|	питКритическиеКонтрольныеТочкиДокументы.ВидЖурнала КАК ВидЖурнала,
	|	питКритическиеКонтрольныеТочкиДокументы.ВидЖурнала.Наименование КАК ВидЖурналаНаименование
	|ИЗ
	|	Справочник.питКритическиеКонтрольныеТочки.Документы КАК питКритическиеКонтрольныеТочкиДокументы
	|ГДЕ
	|	питКритическиеКонтрольныеТочкиДокументы.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	питКритическиеКонтрольныеТочкиОперации.Ссылка КАК КритическаяКонтрольнаяТочка,
	|	питКритическиеКонтрольныеТочкиОперации.Операция КАК Операция,
	|	питКритическиеКонтрольныеТочкиОперации.Операция.Наименование КАК ОперацияНаименование
	|ИЗ
	|	Справочник.питКритическиеКонтрольныеТочки.Операции КАК питКритическиеКонтрольныеТочкиОперации
	|ГДЕ
	|	питКритическиеКонтрольныеТочкиОперации.Ссылка В(&МассивОбъектов)";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	
	ТаблицаПродукции = РезультатЗапросаПакет[1].Выгрузить();
	ТаблицаДокументов = РезультатЗапросаПакет[2].Выгрузить();
	ТаблицаОпераций = РезультатЗапросаПакет[3].Выгрузить();
	
	РезультатЗапроса = РезультатЗапросаПакет[0];
	ВыборкаВерхняя = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВерхняя.Следующий() Цикл
		
		////////////////////////////////////////////////////////////
		// Подготовка табличного документа и макета
		// Для не первого документа вставка разделителя страниц.
		Если НЕ ПервыйДокумент Тогда
			
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		
		СтрокаПродукцияВШапке = "";
		ПродукцияВШапке = ТаблицаПродукции.НайтиСтроки(Новый Структура("КритическаяКонтрольнаяТочка", ВыборкаВерхняя.Ссылка));
		Счетчик = 0;
		Для каждого ТекПродукция Из ПродукцияВШапке Цикл
			Разделитель = ?(Счетчик = 0, "", "; ");
			СтрокаПродукцияВШапке = СтрокаПродукцияВШапке + Разделитель + ТекПродукция.НоменклатураНаименование + ?(ЗначениеЗаполнено(ТекПродукция.Характеристика), ", " + ТекПродукция.ХарактеристикаНаименование, "");
			Счетчик = Счетчик + 1;
		КонецЦикла;
		
		ИспользуемыеДокументы = ТаблицаДокументов.НайтиСтроки(Новый Структура("КритическаяКонтрольнаяТочка", ВыборкаВерхняя.Ссылка));
		СтрокаИспользуемыеДокументы = "";
		Счетчик = 0;
		Для каждого ТекДокумент Из ИспользуемыеДокументы Цикл
			Разделитель = ?(Счетчик = 0, "", "; ");
			СтрокаИспользуемыеДокументы = СтрокаИспользуемыеДокументы + Разделитель + ТекДокумент.ВидЖурналаНаименование;
			Счетчик = Счетчик + 1;
		КонецЦикла;
		
		ИспользуемыеОперации = ТаблицаОпераций.НайтиСтроки(Новый Структура("КритическаяКонтрольнаяТочка", ВыборкаВерхняя.Ссылка));
		СтрокаИспользуемыеОперации = "";
		Счетчик = 0;
		Для каждого ТекОперация Из ИспользуемыеОперации Цикл
			Разделитель = ?(Счетчик = 0, "", "; ");
			СтрокаИспользуемыеОперации = СтрокаИспользуемыеОперации + Разделитель + ТекОперация.ОперацияНаименование;
			Счетчик = Счетчик + 1;
		КонецЦикла;
		
		// Вывод шапки печатной формы
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.НаименованиеПродукта					= СтрокаПродукцияВШапке;
		ОбластьМакета.Параметры.НаименованиеТехнологическогоПроцесса	= ВыборкаВерхняя.НаименованиеТехнологическогоПроцесса;
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		// Вывод табличной части.
		ОбластьТовар = Макет.ПолучитьОбласть("Товар");
		ВыборкаСсылка = ВыборкаВерхняя.Выбрать();
		Пока ВыборкаСсылка.Следующий() Цикл
			ОбластьТовар.Параметры.Заполнить(ВыборкаСсылка);
			ОбластьТовар.Параметры.НаименованиеОперации = СтрокаИспользуемыеОперации;
			ОбластьТовар.Параметры.ОпасныйФактор = ВыборкаСсылка.ТипОпасногоФактора + ", " + ВыборкаСсылка.ОпасныйФактор;
			ОбластьТовар.Параметры.Документ = СтрокаИспользуемыеДокументы;
			ОбластьТовар.Параметры.НомерККТ = ВыборкаСсылка.НомерККТ + ", " + ВыборкаСсылка.Наименование;
			
			ТабличныйДокумент.Вывести(ОбластьТовар);
		КонецЦикла;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли




