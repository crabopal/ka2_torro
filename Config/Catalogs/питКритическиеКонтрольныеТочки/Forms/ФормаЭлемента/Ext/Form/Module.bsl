
#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	СформироватьСтраницуКонтролируемыеПараметры();
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	ПриЧтенииСозданииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КонтролируемыеПараметрыПриИзменении(Элемент)
	КонтролируемыеПараметрыПриИзмененииНаСервере(Элемент.Имя);
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьКонтролируемыйПараметр(Команда)
	ДобавитьКонтролируемыйПараметрНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКонтролируемыйПараметр(Команда)
	СчетчикСтроки = Число(СтрЗаменить(Команда.Имя, "УдалитьКонтролируемыйПараметр", ""));
	УдалитьКонтролируемыйПараметрНаСервере(СчетчикСтроки);
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КонтролируемыеПараметры

&НаСервере
Процедура СформироватьСтраницуКонтролируемыеПараметры()
	
	Для Сч=0 По Объект.КонтролируемыеПараметры.Количество()-1 Цикл
		ТекСтрока = Объект.КонтролируемыеПараметры[Сч];
		ТекСтрока.Счетчик = ТекСтрока.ПолучитьИдентификатор();
		СформироватьЭлементыПоТекущемуКонтролируемомуПараметру(Объект.КонтролируемыеПараметры[Сч]);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЭлементыПоТекущемуКонтролируемомуПараметру(ТекущийКонтролируемыйПараметр)
	
	СчетчикСтроки = ТекущийКонтролируемыйПараметр.Счетчик;
	
	ИменаКолонок = ИменаКолонокКонтролируемыхПараметров();
	
	БазовоеИмяЭлементов = "КонтролируемыйПар" + Строка(СчетчикСтроки);
	
	// Добавление реквизитов
	ДобавляемыеРеквизиты = Новый Массив;
	Для каждого ИмяКолонки Из ИменаКолонок Цикл
		ИмяЭлементаРеквизита = БазовоеИмяЭлементов + ИмяКолонки.Имя;
		НовыйРеквизит = Новый РеквизитФормы(ИмяЭлементаРеквизита, Новый ОписаниеТипов("Строка"),,ИмяКолонки.Заголовок);
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Команды формы.
	ИмяКомандыУдалить = "УдалитьКонтролируемыйПараметр" + Строка(СчетчикСтроки);
	Новком = Команды.Добавить(ИмяКомандыУдалить);
	Новком.Действие = "УдалитьКонтролируемыйПараметр";
	
	// Добавление элементов
	РодительЭлементов = Элементы.ГруппаКонтролируемыеПараметры;
	ГруппаСтрокаТаблицы = Элементы.Добавить(БазовоеИмяЭлементов, Тип("ГруппаФормы"), РодительЭлементов);
	ГруппаСтрокаТаблицы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСтрокаТаблицы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаСтрокаТаблицы.ОтображатьЗаголовок = Ложь;
	ГруппаСтрокаТаблицы.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	Для каждого ИмяКолонки Из ИменаКолонок Цикл
		ИмяЭлементаРеквизита = БазовоеИмяЭлементов + ИмяКолонки.Имя;
		НовыйЭлемент = Элементы.Добавить(ИмяЭлементаРеквизита, Тип("ПолеФормы"), ГруппаСтрокаТаблицы);
		НовыйЭлемент.ПутьКДанным = ИмяЭлементаРеквизита;
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
		НовыйЭлемент.МногострочныйРежим = Истина;
		НовыйЭлемент.АвтоМаксимальнаяВысота = Ложь;
		НовыйЭлемент.МаксимальнаяВысота = 4;
		НовыйЭлемент.Высота = 4;
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "КонтролируемыеПараметрыПриИзменении");
	КонецЦикла;
	ГруппаКнопок = Элементы.Добавить(БазовоеИмяЭлементов + "Кнопки", Тип("ГруппаФормы"), ГруппаСтрокаТаблицы);
	ГруппаКнопок.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКнопок.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаКнопок.ОтображатьЗаголовок = Ложь;
	ГруппаКнопок.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаКнопок.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	Декорация = Элементы.Добавить(БазовоеИмяЭлементов + "КнопкиДекорация", Тип("ДекорацияФормы"), ГруппаКнопок);
	Декорация.Заголовок = "";
	Кнопка = Элементы.Добавить(БазовоеИмяЭлементов + "КнопкиУдалить", Тип("КнопкаФормы"), ГруппаКнопок);
	Кнопка.Вид						= ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.Заголовок				="Удалить";
	Кнопка.ИмяКоманды				= ИмяКомандыУдалить;
	Кнопка.Отображение				= ОтображениеКнопки.Картинка;
	Кнопка.Картинка					= БиблиотекаКартинок.Удалить;
	
	// Заполнение значений реквизитов из табличной части
	Для каждого ИмяКолонки Из ИменаКолонок Цикл
		ИмяЭлементаРеквизита = БазовоеИмяЭлементов + ИмяКолонки.Имя;
		ЭтаФорма[ИмяЭлементаРеквизита] = ТекущийКонтролируемыйПараметр[ИмяКолонки.Имя];
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИменаКолонокКонтролируемыхПараметров()
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить(Новый Структура("Имя, Заголовок", "Параметр", "Параметр"));
	ИменаКолонок.Добавить(Новый Структура("Имя, Заголовок", "ПредельныеЗначения", "Предельные значения"));
	ИменаКолонок.Добавить(Новый Структура("Имя, Заголовок", "ПроцедураМониторинга", "Процедура мониторинга"));
	ИменаКолонок.Добавить(Новый Структура("Имя, Заголовок", "КорректирующиеДействия", "Корректирующие действия"));
	Возврат ИменаКолонок;
	
КонецФункции

&НаСервере
Процедура УдалитьКонтролируемыйПараметрНаСервере(СчетчикСтроки)
	
	// Удаление из табличной части
	УдаляемаяСтрока = Объект.КонтролируемыеПараметры.НайтиПоИдентификатору(СчетчикСтроки);
	Если УдаляемаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.КонтролируемыеПараметры.Удалить(УдаляемаяСтрока);
	
	БазовоеИмяЭлементов = "КонтролируемыйПар" + Строка(СчетчикСтроки);
	
	// Удаление реквизитов
	УдаляемыеРеквизиты = Новый Массив;
	ИменаКолонок = ИменаКолонокКонтролируемыхПараметров();
	Для каждого ИмяКолонки Из ИменаКолонок Цикл
		УдаляемыеРеквизиты.Добавить(БазовоеИмяЭлементов + ИмяКолонки.Имя);
	КонецЦикла;
	ИзменитьРеквизиты(,УдаляемыеРеквизиты);
	
	// Удаление элементов
	Элементы.Удалить(Элементы[БазовоеИмяЭлементов]);
	
	// Удаление команд
	Команды.Удалить(Команды["УдалитьКонтролируемыйПараметр" + Строка(СчетчикСтроки)]);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКонтролируемыйПараметрНаСервере()
	НоваяСтрока = Объект.КонтролируемыеПараметры.Добавить();
	НоваяСтрока.Счетчик = НоваяСтрока.ПолучитьИдентификатор();
	СформироватьЭлементыПоТекущемуКонтролируемомуПараметру(НоваяСтрока);
КонецПроцедуры

&НаСервере
Процедура КонтролируемыеПараметрыПриИзмененииНаСервере(ИмяЭлемента)
	
	// Поиск имени текущей колонки ТЧ.
	ТекущееИмяКолонки = "";
	ИменаКолонок = ИменаКолонокКонтролируемыхПараметров();
	Для каждого ИмяКолонки Из ИменаКолонок Цикл
		Если СтрНайти(ИмяЭлемента, ИмяКолонки.Имя) Тогда
			ТекущееИмяКолонки = ИмяКолонки.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ТекущееИмяКолонки) Тогда
		Возврат;
	КонецЕсли;
	
	// Поиск строки таблицы ТЧ
	СчетчикСтроки = Число(СтрЗаменить(СтрЗаменить(ИмяЭлемента, ТекущееИмяКолонки, ""), "КонтролируемыйПар", ""));
	СтрокиТаблицы = Объект.КонтролируемыеПараметры.НайтиСтроки(Новый Структура("Счетчик", СчетчикСтроки));
	Если НЕ СтрокиТаблицы.Количество() Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = СтрокиТаблицы[0];
	
	// Перенос изменений в ТЧ
	СтрокаТаблицы[ТекущееИмяКолонки] = ЭтаФорма[ИмяЭлемента];
	
КонецПроцедуры

#КонецОбласти

