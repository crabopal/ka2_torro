//  Процедура - Управление формой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьКомиссииБанка = Истина;
	ЗаголовокСчетаРасчетов = НСтр("ru = 'Счет расчетов:'");
	
	Если Объект.ТипОплаты = ПредопределенноеЗначение("Перечисление.питТипыОплат.Наличные") Тогда
		Элементы.ГруппаДополнительно.ТекущаяСтраница = Элементы.ГруппаНаличные;
	Иначе
		
		Элементы.ГруппаДополнительно.ТекущаяСтраница = Элементы.ГруппаБезналичнаяОплата;
		
		Если Объект.ТипОплаты = ПредопределенноеЗначение("Перечисление.питТипыОплат.ПлатежнаяКарта") Тогда
			Элементы.Контрагент.ПодсказкаВвода = "Банк-плательщик";
		ИначеЕсли Объект.ТипОплаты = ПредопределенноеЗначение("Перечисление.питТипыОплат.БанковскийКредит") Тогда
			Элементы.Контрагент.ПодсказкаВвода = "Банк-кредитор";
		ИначеЕсли Объект.ТипОплаты = ПредопределенноеЗначение("Перечисление.питТипыОплат.ПодарочныйСертификатСторонний") Тогда
			Элементы.Контрагент.ПодсказкаВвода = "Эмитент подарочных сертификатов";
			ВидимостьКомиссииБанка = Ложь;
		ИначеЕсли Объект.ТипОплаты = ПредопределенноеЗначение("Перечисление.питТипыОплат.ПодарочныйСертификатСобственный") Тогда
			Элементы.Контрагент.ПодсказкаВвода = "Обобщенный покупатель, например: ""Розничный покупатель"" или ""Частное лицо""";
			ВидимостьКомиссииБанка = Ложь;
			ЗаголовокСчетаРасчетов = НСтр("ru = 'Счет авансов:'");
			// +пит
		Иначе
			Элементы.Контрагент.ПодсказкаВвода = "Контрагент";
			ВидимостьКомиссииБанка = Ложь;
			// -пит
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ГруппаБанковскаяКомиссия.Видимость = ВидимостьКомиссииБанка;
	
	Элементы.ДоговорКонтрагента.Доступность     = ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Контрагент);
		
		
	Элементы.питАналитикаРасходов.Видимость			= Объект.питВидОперации = ПредопределенноеЗначение("Перечисление.питВидыОперацийПоЗагрузкеДанныхПродаж.Списание");
	Элементы.питСтатьяДоходовИРасходов.Видимость	= Объект.питВидОперации = ПредопределенноеЗначение("Перечисление.питВидыОперацийПоЗагрузкеДанныхПродаж.Списание");
	
	Элементы.питВидОперации.СписокВыбора.ЗагрузитьЗначения(ВидыОперацийПоСпособуОплаты(Объект.ТипОплаты));
	
КонецПроцедуры

//  Процедура - Подготовить форму на сервере.
//
&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	// +Статья расходов
	АналитикаРасходовОбязательна = Ложь;
	АналитикаРасходовЗаказРеализация = Ложь;
	Если ЗначениеЗаполнено(Объект.питСтатьяДоходовИРасходов) 
		И ТипЗнч(Объект.питСтатьяДоходовИРасходов) = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда 
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.питСтатьяДоходовИРасходов, "КонтролироватьЗаполнениеАналитики, АналитикаРасходовЗаказРеализация"); 
		АналитикаРасходовОбязательна = Реквизиты.КонтролироватьЗаполнениеАналитики;
		АналитикаРасходовЗаказРеализация = Реквизиты.АналитикаРасходовЗаказРеализация;
	КонецЕсли;
	НаСтатьиАктивовПассивов = (ТипЗнч(Объект.питСтатьяДоходовИРасходов) = Тип("ПланВидовХарактеристикСсылка.СтатьиАктивовПассивов"));
	Элементы.питАналитикаРасходов.Видимость         = НЕ НаСтатьиАктивовПассивов;
	Элементы.питАналитикаРасходов.Доступность = ЗначениеЗаполнено(Объект.питСтатьяДоходовИРасходов);
	// -Статья расходов
	
	Если НЕ Параметры.Свойство("ТипОплатыДоступныеЗначения") Тогда
		ТипОплатыДоступныеЗначения = Новый СписокЗначений;
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.ПлатежнаяКарта"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.БанковскийКредит"));
		// +пит
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.Наличные"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питЗаСчетЗаведения"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питКлубнаяКарта"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питПитаниеСотрудников"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питТалоныИКупоны"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питБонусы"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питЗачетАванса"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питДепозитнаяКарта"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.питВстречноеПредоставление"));
		// -пит
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.ПодарочныйСертификатСобственный"));
		ТипОплатыДоступныеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.питТипыОплат.ПодарочныйСертификатСторонний"));
		
	КонецЕсли;
	
	Если Параметры.Свойство("ТипОплатыДоступныеЗначения") Тогда
		Элементы.ТипОплаты.СписокВыбора.ЗагрузитьЗначения(Параметры.ТипОплатыДоступныеЗначения);
	Иначе
		Элементы.ТипОплаты.СписокВыбора.ЗагрузитьЗначения(ТипОплатыДоступныеЗначения.ВыгрузитьЗначения());
	КонецЕсли;
		
	// 	Если ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") Тогда
	//	
