//  Процедура - Записать закрыть.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ЗаписатьЗакрыть(Команда)
	
	Отказ = Ложь;
	
	Если НЕ Объект.Ссылка.Пустая() И питНомерСохраненный <> Объект.питПорядковыйНомер И Объект.питПорядковыйНомер <> 0 Тогда
		
		ТекстВопроса = "Порядковый номер вида оплаты изменен.
		|При необходимости будут упорядочены прочие виды оплаты.
		|Продолжить?";

		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаписатьЗакрыть_Завершение", ЭтотОбъект, Новый Структура("Отказ, Закрыть", Отказ,Команда.Имя = "ЗаписатьИЗакрыть" )), ТекстВопроса, РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет,
				"Изменение порядкового номера", КодВозвратаДиалога.Нет);
		
	Иначе
		
		Если Записать() Тогда
			Если Команда.Имя = "ЗаписатьИЗакрыть" Тогда
				Модифицированность = Ложь;
				Закрыть();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

