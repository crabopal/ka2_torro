//  Функция - Виды операций по способу оплаты.
//
// Параметры:
//  СпособОплаты - Произвольный - Способ оплаты.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
//
&НаСервереБезКонтекста
Функция ВидыОперацийПоСпособуОплаты(СпособОплаты)
	Результат = Новый Массив;
	Если НЕ СпособОплаты = Перечисления.питТипыОплат.питПитаниеСотрудников Тогда
		Результат.Добавить(Перечисления.питВидыОперацийПоЗагрузкеДанныхПродаж.Реализация);
	КонецЕсли;
	Результат.Добавить(Перечисления.питВидыОперацийПоЗагрузкеДанныхПродаж.РеализацияОптовая);
	Результат.Добавить(Перечисления.питВидыОперацийПоЗагрузкеДанныхПродаж.Списание);
	Результат.Добавить(Перечисления.питВидыОперацийПоЗагрузкеДанныхПродаж.НеЗагружать);
	Возврат Результат;
КонецФункции

