// Обработка порядкового номера.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаСервере
Процедура ОбработкаПорядковогоНомера(Отказ)
	
	// Проверка на максимальный номер
	КоличествоНомеров = Справочники.питВидыОплатОрганизаций.ПолучитьКоличествоПорядковыхНомеров();
	Если Объект.питПорядковыйНомер > КоличествоНомеров Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Вид оплаты <" + Объект.Наименование + ">: заданный порядковый номер (" + Строка(Объект.питПорядковыйНомер) + ")"
			+ " превышает общее количество типов оплат (" + Строка(КоличествоНомеров) + ").");
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Перенумерация всех, кроме текущего типа оплаты для исключения дублирования номеров
	Справочники.питВидыОплатОрганизаций.ПеренумероватьЭлементы(Объект.Ссылка, Объект.питПорядковыйНомер);
	
КонецПроцедуры

