	// Наличные
	ЗаполнитьПредопределенныйЭлементНаличными(ЗаполнятьВсе);
    	
	// БезНаличные
	БезНаличныеСсылка = Справочники.питВидыОплатОрганизаций.НайтиПоНаименованию("Плат. картой");
