// Производит уменьшение порядкового номера
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//
Процедура УменьшитьПорядковыйНомер(Ссылка) Экспорт
	
	Если Ссылка.питПорядковыйНомер <=1 Тогда
		Возврат;
	КонецЕсли;
	
	Если Ссылка.питПорядковыйНомер = 0 Тогда
		ТекПорядковыйНомер = 1;
	Иначе
		ТекПорядковыйНомер = Ссылка.питПорядковыйНомер;
	КонецЕсли; 
	ПеренумероватьЭлементы(Ссылка, ТекПорядковыйНомер);

	Если Ссылка.питПорядковыйНомер <> 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	питВидыОплатОрганизаций.Ссылка,
		|	питВидыОплатОрганизаций.питПорядковыйНомер КАК ПорядковыйНомер
		|ИЗ
		|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
		|ГДЕ
		|	питВидыОплатОрганизаций.питПорядковыйНомер < &ПорядковыйНомер
		|   И НЕ питВидыОплатОрганизаций.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ПорядковыйНомер УБЫВ";
		
		Запрос.УстановитьПараметр("ПорядковыйНомер",	ТекПорядковыйНомер);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Инд = 0;
		Пока Выборка.Следующий() Цикл
			
			Если Инд = 0 Тогда
				ПервыйНомер = Выборка.ПорядковыйНомер;
			КонецЕсли;
			
			Если Выборка.ПорядковыйНомер < ПервыйНомер Тогда
				Прервать;
			КонецЕсли;	
			
			ТипОплатыОбъект 					= Выборка.Ссылка.ПолучитьОбъект();
			ТипОплатыОбъект.питПорядковыйНомер 	= ПервыйНомер + 1;
			ТипОплатыОбъект.ДополнительныеСвойства.Вставить("СменаНомера",Истина);
			Попытка
				ТипОплатыОбъект.Записать();
			Исключение 
				ТекстОшибки = ИнформацияОбОшибке().Описание;
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Ошибка при записи типа оплаты <" + Строка(Выборка.Ссылка)+ ">: " + ТекстОшибки;
				Сообщение.Сообщить();
			КонецПопытки;
			
			Инд = Инд + 1;
			
		КонецЦикла;	
	
	КонецЕсли;
	
	питВидыОплатОрганизацийОбъект = Ссылка.ПолучитьОбъект();
	питВидыОплатОрганизацийОбъект.питПорядковыйНомер = ?(питВидыОплатОрганизацийОбъект.питПорядковыйНомер = 0, 0, 
		питВидыОплатОрганизацийОбъект.питПорядковыйНомер - 1);
	питВидыОплатОрганизацийОбъект.ДополнительныеСвойства.Вставить("СменаНомера", Истина);
	Попытка
		питВидыОплатОрганизацийОбъект.Записать();
	Исключение
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Ошибка при записи типа оплаты <" + Строка(Ссылка) + ">:" + ТекстОшибки;
		Сообщение.Сообщить();
				КонецПопытки

КонецПроцедуры // УменьшитьПорядковыйНомер()

// Производит увеличение порядкового номера
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//
Процедура УвеличитьПорядковыйНомер(Ссылка) Экспорт
	
	Если Ссылка.питПорядковыйНомер = ПолучитьКоличествоПорядковыхНомеров() Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Элемент <" + Строка(Ссылка) + "> уже имеет максимальный номер.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Ссылка.питПорядковыйНомер = 0 Тогда
		ТекПорядковыйНомер = 1;
	Иначе
		ТекПорядковыйНомер = Ссылка.питПорядковыйНомер;
	КонецЕсли; 
	
	ПеренумероватьЭлементы(Ссылка, ТекПорядковыйНомер);
	
	Если Ссылка.питПорядковыйНомер <> 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	питВидыОплатОрганизаций.Ссылка,
		|	питВидыОплатОрганизаций.питПорядковыйНомер КАК ПорядковыйНомер
		|ИЗ
		|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
		|ГДЕ
		|	питВидыОплатОрганизаций.питПорядковыйНомер > &ПорядковыйНомер
		|	И НЕ питВидыОплатОрганизаций.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ПорядковыйНомер";

		Запрос.УстановитьПараметр("ПорядковыйНомер",	ТекПорядковыйНомер);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Инд = 0; 
		Пока Выборка.Следующий() Цикл
		
			Если Инд = 0 Тогда
				ПервыйНомер = Выборка.ПорядковыйНомер;
			КонецЕсли;
			
			Если Выборка.ПорядковыйНомер > ПервыйНомер Тогда
				Прервать;
			КонецЕсли;	
			
			питВидыОплатОрганизацийОбъект = Выборка.Ссылка.ПолучитьОбъект();
			питВидыОплатОрганизацийОбъект.питПорядковыйНомер = питВидыОплатОрганизацийОбъект.питПорядковыйНомер - 1;
			питВидыОплатОрганизацийОбъект.ДополнительныеСвойства.Вставить("СменаНомера",Истина);
			Попытка
				питВидыОплатОрганизацийОбъект.Записать();
			Исключение 
				ТекстОшибки = ИнформацияОбОшибке().Описание;
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Ошибка при записи типа оплаты <" + Строка( Выборка.Ссылка)+ ">: " + ТекстОшибки;
				Сообщение.Сообщить();
					
			КонецПопытки;
			Инд= Инд + 1;
			
		КонецЦикла;	

	КонецЕсли; 
		
	Если Инд <> 0 Тогда
		
		питВидыОплатОрганизацийОбъект 				= Ссылка.ПолучитьОбъект();
		питВидыОплатОрганизацийОбъект.питПорядковыйНомер = питВидыОплатОрганизацийОбъект.питПорядковыйНомер + 1;
		питВидыОплатОрганизацийОбъект.ДополнительныеСвойства.Вставить("СменаНомера", Истина);
		Попытка
			питВидыОплатОрганизацийОбъект.Записать();
		Исключение 
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Ошибка при записи типа оплаты <" + Строка(Ссылка) + ">: " + ТекстОшибки;
			Сообщение.Сообщить();
				
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры // УвеличитьПорядковыйНомер()

// Получает максимальный порядковый номер типа оплаты
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьМаксимальныйПорядковыйНомер() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(питВидыОплатОрганизаций.питПорядковыйНомер), 0) КАК ПорядковыйНомер
	|ИЗ
	|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
	|ГДЕ
	|	НЕ питВидыОплатОрганизаций.ПометкаУдаления
	|";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	МаксНомер = 0;
	Если Выборка.Следующий() Тогда
		МаксНомер = Выборка.ПорядковыйНомер;
	КонецЕсли;
	
	Возврат МаксНомер;	
	
КонецФункции // ПолучитьМаксимальныйПорядковыйНомер()

// Получает минимальный порядковый номер типа оплаты
//
