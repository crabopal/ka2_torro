	Запрос.Текст = "ВЫБРАТЬ
	|	ЕСТЬNULL(МИНИМУМ(питВидыОплатОрганизаций.питПорядковыйНомер), 0) КАК ПорядковыйНомер
	|ИЗ
	|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
	|ГДЕ
	|	НЕ питВидыОплатОрганизаций.ПометкаУдаления
	|";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	МинНомер = 0;
	Если Выборка.Следующий() Тогда
		МинНомер = Выборка.ПорядковыйНомер;
