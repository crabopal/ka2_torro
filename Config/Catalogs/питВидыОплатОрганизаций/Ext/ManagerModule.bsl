// Выполняет создание элемента справочника "Наличными"
//
// Параметры:
//  ЗаполнятьВсе - Произвольный - Заполнять все.
//
Процедура ЗаполнитьПредопределенныйЭлементНаличными(ЗаполнятьВсе = Ложь) Экспорт
	
	МенеджерОбъекта = Справочники.питВидыОплатОрганизаций;
	ТекЭтоГруппа = Ложь;
	СоздаватьОбъект = Истина;
	
	// Наличные
	НаличнымиСсылка = Справочники.питВидыОплатОрганизаций.НайтиПоНаименованию("Наличными");
	Если НаличнымиСсылка.Пустая()  Тогда
		ИДСтрокой = "d4dc284d-174f-4d3e-a0f1-01e089ee439a";
		Наличными = питОбменДанными.ПолучитьОбъектПоИД(ИДСтрокой, МенеджерОбъекта, ТекЭтоГруппа, СоздаватьОбъект);
	Иначе
		Наличными = НаличнымиСсылка.ПолучитьОбъект();
	КонецЕсли; 
	
	Если ЗаполнятьВсе ИЛИ Наличными.ЭтоНовый() Тогда
		Наличными.Наименование 		= "Наличными";
		Наличными.ТипОплаты 		= Перечисления.питТипыОплат.Наличные;
		Наличными.питФискальный = Истина;
		Наличными.питВедущий 	= Истина;
	Иначе
		Если НЕ ЗначениеЗаполнено(Наличными.ТипОплаты) Тогда
			Наличными.ТипОплаты 	= Перечисления.питТипыОплат.Наличные;
		КонецЕсли;
	КонецЕсли;
	НовыйЭлемент = Наличными.ЭтоНовый();
	Если НовыйЭлемент Тогда
		Наличными.УстановитьНовыйКод();
	КонецЕсли; 
	Если Наличными.Модифицированность() Тогда
		Попытка
			Наличными.Записать();
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Справочник ""Виды оплат"". "+?(НовыйЭлемент,"Добавлен","Обновлен")+" элемент """+СокрЛП(Наличными.Наименование)+"""";
			Сообщение.Сообщить();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПредопределенныйЭлементНаличными()
 
// Выполняет заполнение элементов справочника
//
// Параметры:
//  ЗаполнятьВсе - Произвольный - Заполнять все.
