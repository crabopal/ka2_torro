	Возврат МинНомер;	
	
КонецФункции // ПолучитьМинимальныйПорядковыйНомер()

// Получает количество порядковых номеров типов оплат
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьКоличествоПорядковыхНомеров() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(питВидыОплатОрганизаций.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
	|ГДЕ
	|	НЕ питВидыОплатОрганизаций.ПометкаУдаления
	|";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Количество = 0;
	Если Выборка.Следующий() Тогда
		Количество = Выборка.Количество;
	КонецЕсли;
	
