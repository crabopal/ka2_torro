		ИДСтрокой = "49093a50-c00d-4fd8-81c6-bd8cfeb1f1b2";
		БезНаличные = питОбменДанными.ПолучитьОбъектПоИД(ИДСтрокой, МенеджерОбъекта, ТекЭтоГруппа, СоздаватьОбъект);
