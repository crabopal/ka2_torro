КонецФункции // ПолучитьКоличествоПорядковыхНомеров()

// Изменение номера элементов
//
// Параметры:
//  Ссылка - Произвольный - Ссылка.
//  ПорядковыйНомер - Произвольный - Порядковый номер.
//
Процедура ПеренумероватьЭлементы(Ссылка = Неопределено, ПорядковыйНомер = 0) Экспорт 
	
	// Виды оплат с нулевым номером должны быть в конце списка
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА питВидыОплатОрганизаций.питПорядковыйНомер = 0
	|			ТОГДА 999
	|		ИНАЧЕ питВидыОплатОрганизаций.питПорядковыйНомер
	|	КОНЕЦ КАК ПорядковыйНомер,
	|	питВидыОплатОрганизаций.Ссылка
	|ИЗ
	|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций";
	Если Ссылка = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|   НЕ питВидыОплатОрганизаций.ПометкаУдаления
		|	И НЕ питВидыОплатОрганизаций.питПорядковыйНомер = 0";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|   НЕ питВидыОплатОрганизаций.Ссылка = &Ссылка
		|	И НЕ питВидыОплатОрганизаций.питПорядковыйНомер = 0
		|	И НЕ питВидыОплатОрганизаций.ПометкаУдаления";
	КонецЕсли; 
	Запрос.Текст = Запрос.Текст + " 
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер";
    	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	ТекНомер = 0;
	Пока Выборка.Следующий() Цикл
	    ТекНомер = ТекНомер + 1;
		// Пропуск зарезервированного номера при необходимости
		Если ТекНомер = ПорядковыйНомер Тогда
			ТекНомер = ТекНомер + 1;
		КонецЕсли; 
		
		питВидыОплатОрганизацийОбъект 							= Выборка.Ссылка.ПолучитьОбъект();
		питВидыОплатОрганизацийОбъект.питПорядковыйНомер 	= ТекНомер;
		питВидыОплатОрганизацийОбъект.ДополнительныеСвойства.Вставить("СменаНомера", Истина);
		
		Попытка
			питВидыОплатОрганизацийОбъект.Записать();
		Исключение 
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Ошибка при записи типа оплаты <" + Строка(Ссылка) + ">: " + ТекстОшибки;

			Сообщение.Сообщить();
						КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры // ПеренумероватьЭлементы()

#КонецОбласти

// Функция - Счет учета расчетов по умолчанию.
//
// Параметры:
//  ТипОплаты - Произвольный - Тип оплаты.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция СчетУчетаРасчетовПоУмолчанию(ТипОплаты) Экспорт
	
	Если питПроизводствоПовтИсп.ПолучитьИмяОсновнойКонфигурации() = "ERPWE" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПустаяСсылка();
	
	Если ТипОплаты = Перечисления.питТипыОплат.ПодарочныйСертификатСобственный Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].РасчетыПоАвансамПолученным;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.ПодарочныйСертификатСторонний Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.ПлатежнаяКарта Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПродажиПоПлатежнымКартам;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.БанковскийКредит Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].РасчетыСПрочимиПокупателямиИЗаказчиками;
		// +пит
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.питЗаСчетЗаведения Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПрочиеРасходы;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.питКлубнаяКарта Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПрочиеРасходы;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.питПитаниеСотрудников Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПродажиПоПлатежнымКартам;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.питТалоныИКупоны Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПродажиПоПлатежнымКартам;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.питЗачетАванса Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].РасчетыПоАвансамПолученным;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.питДепозитнаяКарта Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПрочиеРасходы;
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.питВстречноеПредоставление Тогда
		СчетУчетаРасчетов = ПланыСчетов["Хозрасчетный"].ПрочиеРасходы;

		// -пит
	КонецЕсли;
	
	Возврат СчетУчетаРасчетов;

КонецФункции

// Функция - Вид оплаты наличные.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВидОплатыНаличные() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	питВидыОплатОрганизаций.Ссылка
	|ИЗ
	|	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
	|ГДЕ
	|	питВидыОплатОрганизаций.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.питТипыОплат.Наличные)
	|	И НЕ питВидыОплатОрганизаций.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		
		НовыйЭлемент = Справочники.питВидыОплатОрганизаций.СоздатьЭлемент();
		
		НовыйЭлемент.ТипОплаты    = Перечисления.питТипыОплат.Наличные;
		НовыйЭлемент.Наименование = "Наличные";
		
		НовыйЭлемент.Записать();
		
		Возврат НовыйЭлемент.Ссылка;
		
	КонецЕсли;

КонецФункции

// Функция - Это расчеты с эмитентами подарочных сертификатов.
//
// Параметры:
//  ДоговорКонтрагента - Произвольный - Договор контрагента.
