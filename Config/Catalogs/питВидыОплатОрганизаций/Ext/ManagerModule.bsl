// Возвращает 1-ый найденный тип оплаты "Талоны и купоны"
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПолучитьВидОплатыТалоныИКупоны() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	 "ВЫБРАТЬ ПЕРВЫЕ 1
	 |	питВидыОплатОрганизаций.Ссылка
	 |ИЗ
	 |	Справочник.питВидыОплатОрганизаций КАК питВидыОплатОрганизаций
	 |ГДЕ
	 |	питВидыОплатОрганизаций.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.питТипыОплат.питТалоныИКупоны)";
	 Выборка = Запрос.Выполнить().Выбрать();
	 Если Выборка.Следующий() Тогда
	 	 Возврат Выборка.Ссылка;
	 Иначе
		 Возврат Справочники.питВидыОплатОрганизаций.ПустаяСсылка(); 
	 КонецЕсли; 

 КонецФункции // ПолучитьВидОплатыТалоныИКупоны()
 
