КонецФункции

// Функция - Виды договоров по типу оплаты.
//
// Параметры:
//  ТипОплаты - Произвольный - Тип оплаты.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ВидыДоговоровПоТипуОплаты(ТипОплаты) Экспорт
	
	ВидыДоговоров = Новый Массив;
	
	Если ТипОплаты = Перечисления.питТипыОплат.ПодарочныйСертификатСобственный Тогда
		ВидыДоговоров.Добавить(Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
	ИначеЕсли ТипОплаты = Перечисления.питТипыОплат.ПодарочныйСертификатСторонний Тогда
		ВидыДоговоров.Добавить(Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию);
	Иначе
		// ВидыДоговоров.Добавить(Перечисления.ХозяйственныеОперации.);
	КонецЕсли;
	
	Возврат ВидыДоговоров;
	
КонецФункции

// Функция - Организации для отбора видов оплат.
//
// Параметры:
//  Организация - Произвольный - Организация.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ОрганизацииДляОтбораВидовОплат(Организация) Экспорт
	
	Организации = Новый Массив;
	Организации.Добавить(Организация);
	
	Возврат Организации;
	
КонецФункции

// Функция - Параметры выбора статей и аналитик.
//
// Возвращаемое значение:
//  Произвольный - Результат обработки.
Функция ПараметрыВыбораСтатейИАналитик() Экспорт
	
	МассивПаметровВыбора = Новый Массив;
	
	ПараметрыВыбора = ДоходыИРасходыСервер.ПараметрыВыбораСтатьиИАналитики();
	ПараметрыВыбора.ПутьКДанным = "Объект";
	ПараметрыВыбора.Статья      = "питСтатьяДоходовИРасходов";
	
	ПараметрыВыбора.ВыборСтатьиРасходов = Истина;
	ПараметрыВыбора.АналитикаРасходов   = "питАналитикаРасходов";
	
	ПараметрыВыбора.ЭлементыФормы.Статья.Добавить("питСтатьяДоходовИРасходов");
	ПараметрыВыбора.ЭлементыФормы.АналитикаРасходов.Добавить("питАналитикаРасходов");
	
	МассивПаметровВыбора.Добавить(ПараметрыВыбора);
	
	Возврат МассивПаметровВыбора;
	
КонецФункции

