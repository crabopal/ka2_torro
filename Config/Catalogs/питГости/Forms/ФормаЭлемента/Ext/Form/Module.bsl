&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СформироватьАдрес(ЗначениеРеквизита, Префикс, МассивПолейАдреса)
	
	ЗначениеРеквизита = "";
	
	Для Каждого ИмяПоля Из МассивПолейАдреса Цикл
		
		ЗначениеРеквизита = ЗначениеРеквизита + СтрЗаменить(СокрЛП(ЭтаФорма[Префикс + ИмяПоля]), ",", "") + ",";
		
	КонецЦикла;
	
	ЗначениеРеквизита = Лев(ЗначениеРеквизита, СтрДлина(ЗначениеРеквизита) - 1);
	
КонецПроцедуры

&НаКлиенте
// Процедура раскладывает адрес на составляющие.
//
Процедура РазложитьАдрес(Знач ЗначениеРеквизита, Префикс, МассивПолейАдреса)
	
	СоставляющиеАдреса = СтрЗаменить(ЗначениеРеквизита, ",", Символы.ПС);
	ЧислоСтрок = СтрЧислоСтрок(СоставляющиеАдреса);
	
	Для Сч = 1 По ЧислоСтрок Цикл
		
		Если Сч > МассивПолейАдреса.Количество() Тогда
			Возврат;
		КонецЕсли;
		
		ЭтаФорма[Префикс + МассивПолейАдреса[Сч - 1]] = СокрЛП(СтрПолучитьСтроку(СоставляющиеАдреса, Сч));
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
