
#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

// Обработчик события формы "При открытии".
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	
	ДеньРожденияСтрокой = Формат(Объект.ДатаРождения, "ДФ='d МММ'"); 
	СтараяФамилия = Объект.Фамилия;
	СтароеИмя = Объект.Имя;
	СтароеОтчество = Объект.Отчество;
	
	
	МассивПолейАдреса = Новый Массив;
	МассивПолейАдреса.Добавить("Индекс");
	МассивПолейАдреса.Добавить("Регион");
	МассивПолейАдреса.Добавить("Район");
	МассивПолейАдреса.Добавить("Город");
	МассивПолейАдреса.Добавить("НаселенныйПункт");
	МассивПолейАдреса.Добавить("Улица");
	МассивПолейАдреса.Добавить("Дом");
	МассивПолейАдреса.Добавить("Корпус");
	МассивПолейАдреса.Добавить("Квартира");
	МассивПолейАдреса.Добавить("Подъезд");
	МассивПолейАдреса.Добавить("Этаж");
	МассивПолейАдреса.Добавить("Домофон");
	МассивПолейАдреса.Добавить("Станция");
	МассивПолейАдреса.Добавить("Зона");
	РазложитьАдрес(Объект.ПочтовыйАдрес, "Почтовый",МассивПолейАдреса);
	РазложитьАдрес(Объект.АдресДоставки, "Доставка",МассивПолейАдреса);
	
КонецПроцедуры

// Обработчик события формы "Перед записью".
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Объект.ДеньРождения = Формат(Объект.ДатаРождения, "ДФ=ddMM");
	
	МассивПолейАдреса = Новый Массив;
	МассивПолейАдреса.Добавить("Индекс");
	МассивПолейАдреса.Добавить("Регион");
	МассивПолейАдреса.Добавить("Район");
	МассивПолейАдреса.Добавить("Город");
	МассивПолейАдреса.Добавить("НаселенныйПункт");
	МассивПолейАдреса.Добавить("Улица");
	МассивПолейАдреса.Добавить("Дом");
	МассивПолейАдреса.Добавить("Корпус");
	МассивПолейАдреса.Добавить("Квартира");
	МассивПолейАдреса.Добавить("Подъезд");
	МассивПолейАдреса.Добавить("Этаж");
	МассивПолейАдреса.Добавить("Домофон");
	МассивПолейАдреса.Добавить("Станция");
	МассивПолейАдреса.Добавить("Зона");
	СформироватьАдрес(Объект.ПочтовыйАдрес, "Почтовый", МассивПолейАдреса);
	СформироватьАдрес(Объект.АдресДоставки, "Доставка", МассивПолейАдреса);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

#Область УправлениеСвойствами

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

// Обработчик события "ПриИзменении" для элементов ввода ФИО.
//
&НаКлиенте
Процедура ПриИзмененииФИО(Элемент)
	
	ТекНаименование = Объект.Наименование;
	
	ТекНаименование = СтрЗаменить(ТекНаименование, СтараяФамилия, "");
	ТекНаименование = СтрЗаменить(ТекНаименование, СтароеИмя, "");
	ТекНаименование = СтрЗаменить(ТекНаименование, СтароеОтчество, "");
	
	Если ПустаяСтрока(ТекНаименование) Тогда
		
		Если ПустаяСтрока(Объект.Фамилия) Тогда
			Объект.Наименование = "";
		Иначе
			Объект.Наименование = СокрЛП(Объект.Фамилия);
		КонецЕсли; 
		Если ПустаяСтрока(Объект.Имя) Тогда
			Объект.Наименование = Объект.Наименование + " ";
		Иначе
			Объект.Наименование = Объект.Наименование + " " + СокрЛП(Объект.Имя);
		КонецЕсли; 
		Если ПустаяСтрока(Объект.Отчество) Тогда
			Объект.Наименование = Объект.Наименование + " ";
		Иначе
			Объект.Наименование = Объект.Наименование + " " + СокрЛП(Объект.Отчество);
		КонецЕсли;
		Объект.Наименование = СокрЛП(Объект.Наименование);
		
	Иначе
		
		Объект.Наименование = СтрЗаменить(Объект.Наименование, СтараяФамилия, Объект.Фамилия);
		Объект.Наименование = СтрЗаменить(Объект.Наименование, СтароеИмя, Объект.Имя);
		Объект.Наименование = СтрЗаменить(Объект.Наименование, СтароеОтчество,Объект.Отчество);
		
	КонецЕсли;
	
	СтараяФамилия = Объект.Фамилия;
	СтароеИмя = Объект.Имя;
	СтароеОтчество = Объект.Отчество;
	
КонецПроцедуры

// Обработчик изменения реквизита "Дата рождения".
//
&НаКлиенте
Процедура ДатаРожденияПриИзменении(Элемент)
	ДеньРожденияСтрокой = Формат(Объект.ДатаРождения, "ДФ='d МММ'");
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

