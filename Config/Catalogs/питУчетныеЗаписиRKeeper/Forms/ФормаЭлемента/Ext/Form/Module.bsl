
#Область ПрограммныйИнтерфейс

#Область ФоновыйОбмен

// Обработчик завершения нажатия на гиперссылку расписания регламентного задания.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура РЗРасписаниеНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат = Неопределено Тогда
		РЗРасписание = Результат;
		Элементы.РЗРасписание.Заголовок = Строка(РЗРасписание);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

//  Процедура - Параметры загрузки служебный каталог начало выбора завершение.
//
// Параметры:
//  Результат - Произвольный - Результат.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	текСтрока = ДополнительныеПараметры.текСтрока;
	Если Результат <> Неопределено Тогда
		текДанные = Объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
		текДанные.СлужебныйКаталог = Результат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

#Область ФоновыйОбмен

// Обработчик события формы перед записью.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Проверка заполненности наименования фонового задания, в случае если используется фоновый обмен.
	Если Объект.РЗИспользоватьИндивидуальныеНастройкиОбмена И НЕ ЗначениеЗаполнено(РЗНаименование) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено наименование фонового задания!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события формы перед записью(действия на сервере).
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ТекущийОбъект - Произвольный - Текущий объект.
//  ПараметрыЗаписи - Произвольный - Параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// Если используем фоновый обмен для текущей учетной записи.
	Если ТекущийОбъект.РЗИспользоватьИндивидуальныеНастройкиОбмена Тогда
		
		// Получение объекта регламентного задания или создание нового.
		РегламентноеЗадание = Неопределено;
		Если ЗначениеЗаполнено(ТекущийОбъект.РЗУникальныйИдентификатор) Тогда
			РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ТекущийОбъект.РЗУникальныйИдентификатор));
		КонецЕсли;
		Если РегламентноеЗадание = Неопределено Тогда
			РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.питЗагрузкаRKeeper);
			РегламентноеЗадание.Использование = Истина;
		КонецЕсли;
		
		// Получить ссылку на объект.
		Если ТекущийОбъект.ЭтоНовый() Тогда
			УИДНового = Новый УникальныйИдентификатор;
			ТекСсылкаНаОбъект = Справочники.питУчетныеЗаписиRKeeper.ПолучитьСсылку(УИДНового);
			ТекущийОбъект.УстановитьСсылкуНового(ТекСсылкаНаОбъект);
		Иначе
			ТекСсылкаНаОбъект = ТекущийОбъект.Ссылка;
		КонецЕсли;
		
		// Заполнение полей регламентного задания.
		РегламентноеЗадание.Наименование								= РЗНаименование;
		РегламентноеЗадание.ИмяПользователя								= РЗИмяПользователя;
		РегламентноеЗадание.КоличествоПовторовПриАварийномЗавершении	= РЗКоличествоПовторовПриАварийномЗавершении;
		РегламентноеЗадание.ИнтервалПовтораПриАварийномЗавершении		= РЗИнтервалПовтораПриАварийномЗавершении;
		РегламентноеЗадание.Расписание									= РЗРасписание;
		
		// Установка параметров РЗ.
		УстановитьПараметрыРегламентногоЗадания(РегламентноеЗадание, ТекСсылкаНаОбъект);
		
		// Запись РЗ.
		Попытка
			РегламентноеЗадание.Записать();
			ТекущийОбъект.РЗУникальныйИдентификатор = РегламентноеЗадание.УникальныйИдентификатор;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать регаментное задание по причине:
			|" + ОписаниеОшибки());
		КонецПопытки;
		
	Иначе
		
		// Если флаг фонового обмена не стоит, а РЗ существует, то его необходимо удалить.
		Если ЗначениеЗаполнено(ТекущийОбъект.РЗУникальныйИдентификатор) Тогда
			РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ТекущийОбъект.РЗУникальныйИдентификатор));
		КонецЕсли;
		Если НЕ РегламентноеЗадание = Неопределено Тогда
			Попытка
				РегламентноеЗадание.Удалить();
				ТекущийОбъект.РЗУникальныйИдентификатор = "";
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось удалить регаментное задание по причине:
				|" + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура обрабатывает подбор Касс ККМ.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Выбранное значение.
//  ИсточникВыбора - Произвольный - Источник выбора.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КассыККМ") Тогда
		ТекСтрокиКасс = РЗКассыККМ.НайтиСтроки(Новый Структура("КассаККМ", ВыбранноеЗначение));
		Если ТекСтрокиКасс.Количество() Тогда
			ТекСтрокаКассы = ТекСтрокиКасс[0];
		Иначе
			ТекСтрокаКассы = РЗКассыККМ.Добавить();
		КонецЕсли;
		ТекСтрокаКассы.КассаККМ = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обработка проверки заполнения на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  ПроверяемыеРеквизиты - Произвольный - Проверяемые реквизиты.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

//  Процедура - При создании на сервере.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	Обработки.питЗагрузкаRKeeper7.ИнициализацияПараметровЗагрузки(Объект.ПараметрыЗагрузки);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////
	// Регламентное задание
	
	// Видимость группы настроек фонового обмена.
	Элементы.ГруппаФоновыйОбмен.Видимость = Объект.РЗИспользоватьИндивидуальныеНастройкиОбмена;
	
	// Получаем объект РЗ, если он уже существует для текущей учетной записи.
	РЗОбъект = Неопределено;
	Если ЗначениеЗаполнено(Объект.РЗУникальныйИдентификатор) Тогда
		РЗОбъект										= РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Объект.РЗУникальныйИдентификатор));
	КонецЕсли;
	
	// Если объект есть, то заполняем данные из него, иначе устанавливаем значения по умолчанию.
	Если НЕ РЗОбъект = Неопределено Тогда
		РЗИмяПользователя							= РЗОбъект.ИмяПользователя;
		РЗИнтервалПовтораПриАварийномЗавершении		= РЗОбъект.ИнтервалПовтораПриАварийномЗавершении;
		РЗКоличествоПовторовПриАварийномЗавершении	= РЗОбъект.КоличествоПовторовПриАварийномЗавершении;
		РЗНаименование								= РЗОбъект.Наименование;
		РЗРасписание								= РЗОбъект.Расписание;
		Элементы.РЗРасписание.Заголовок = Строка(РЗРасписание);
	Иначе
		Объект.РЗУникальныйИдентификатор			= "";
		РЗИмяПользователя							= "";
		РЗИнтервалПовтораПриАварийномЗавершении		= 10;
		РЗКоличествоПовторовПриАварийномЗавершении	= 3;
		РЗНаименование								= "Загрузка из R-keeper v.7 " + "(" + Объект.Наименование + ")";
		РЗРасписание								= Новый РасписаниеРегламентногоЗадания;
		Элементы.РЗРасписание.Заголовок = "Расписание";
	КонецЕсли;
	ПрочитатьПараметрыРегламентногоЗадания(РЗОбъект);
	
	// Заполним список пользователей
	УстановитьПривилегированныйРежим(Истина);
	ВсеПользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	УстановитьПривилегированныйРежим(Ложь);
	Элементы.РЗИмяПользователя.СписокВыбора.Очистить();
	Для Каждого ТекПользователь из ВсеПользователи Цикл
		Элементы.РЗИмяПользователя.СписокВыбора.Добавить(ТекПользователь.Имя, ТекПользователь.ПолноеИмя);
	КонецЦикла;
	
КонецПроцедуры

//  Процедура - При открытии.
//
// Параметры:
//  Отказ - Булево - Отказ.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - При чтении на сервере.
//
// Параметры:
//  ТекущийОбъект - Произвольный - Текущий объект.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

//  Процедура - Обработка оповещения.
//
// Параметры:
//  ИмяСобытия - Произвольный - Имя события.
//  Параметр - Произвольный - Параметр.
//  Источник - Произвольный - Источник.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область ФоновыйОбмен

// Обработчик нажатия на гиперссылку расписания регламентного задания.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РЗРасписаниеНажатие(Элемент)
	Если РЗРасписание = Неопределено Тогда
		РЗРасписание = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РЗРасписание);
	Диалог.Показать(Новый ОписаниеОповещения("РЗРасписаниеНажатиеЗавершение", ЭтотОбъект));
КонецПроцедуры

// Обработчик изменения флага использования регламентного задания.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура ИспользоватьВФоновомОбменеПриИзменении(Элемент)
	
	Если Объект.ИспользоватьВФоновомОбмене Тогда
		Элементы.РЗИспользоватьИндивидуальныеНастройкиОбмена.Доступность = Истина;
	Иначе
		Элементы.РЗИспользоватьИндивидуальныеНастройкиОбмена.Доступность = Ложь;
		Объект.РЗИспользоватьИндивидуальныеНастройкиОбмена = Ложь;
		РЗИспользоватьИндивидуальныеНастройкиОбменаПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

// Обрабочик нажатия на картинку регламентного задания(откроется расписание).
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РЗРасписаниеКартинкаНажатие(Элемент)
	РЗРасписаниеНажатие(Элемент);
КонецПроцедуры

// Процедура открывает форму типовой обработки регламентных заданий.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РЗОткрытьСписокРегламентныхЗаданийНажатие(Элемент)
	ОткрытьФорму("Обработка.РегламентныеИФоновыеЗадания.Форма",
	,
	ЭтаФорма,
	,
	);
КонецПроцедуры

// Обработчик изменения флага использования индивидуального регламентного задания.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура РЗИспользоватьИндивидуальныеНастройкиОбменаПриИзменении(Элемент)
	Элементы.ГруппаФоновыйОбмен.Видимость = Объект.РЗИспользоватьИндивидуальныеНастройкиОбмена;
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Подключаемый при изменении дополнительного реквизита.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Подключаемый свойства выполнить команду.
//
// Параметры:
//  ЭлементИлиКоманда - Произвольный - Элемент или команда.
//  НавигационнаяСсылка - Произвольный - Навигационная ссылка.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

//  Процедура - Параметры загрузки служебный каталог начало выбора.
//
// Параметры:
//  Элемент - Произвольный - Элемент.
//  ДанныеВыбора - Произвольный - Данные выбора.
//  СтандартнаяОбработка - Булево - Стандартная обработка.
//
&НаКлиенте
Процедура ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	текСтрока = Элементы.ПараметрыЗагрузки.ТекущаяСтрока;
	СтандартнаяОбработка = Ложь;
	ИмяМетаданных = ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока);
	Если ИмяМетаданных = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для данного типа объекта не ведется иерархия");
		Возврат;
	Иначе
		ПараметрыФормы = новый Структура("РежимВыбора",Истина);
		ОткрытьФорму("Справочник."+ИмяМетаданных+".ФормаВыбораГруппы",ПараметрыФормы,,,,, Новый ОписаниеОповещения("ПараметрыЗагрузкиСлужебныйКаталогНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("текСтрока", текСтрока)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#Область ФоновыйОбмен

// Процедура открывает форму подбора Касс ККМ.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура РЗКассыККМПодбор(Команда)
	ОткрытьФорму("Справочник.КассыККМ.ФормаВыбора", Новый Структура("ЗакрыватьПриВыборе", Ложь), ЭтаФорма, Новый УникальныйИдентификатор, ВариантОткрытияОкна.ОтдельноеОкно);
КонецПроцедуры

#КонецОбласти

//  Процедура - Проверка подключения.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ПроверкаПодключения(Команда)
	ПроверкаПодключенияНаСервере();
КонецПроцедуры

//  Процедура - Обновить параметры загрузки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура ОбновитьПараметрыЗагрузки(Команда)
	ОбновитьПараметрыЗагрузкиНаСервере();
КонецПроцедуры

//  Процедура - Сохранить параметры загрузки.
//
// Параметры:
//  Команда - Произвольный - Команда.
//
&НаКлиенте
Процедура СохранитьПараметрыЗагрузки(Команда)
	СохранитьПараметрыЗагрузкиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ФоновыйОбмен

// Процедура устанавливает параметры регламентного задания.
//
// Параметры:
//  РегламентноеЗадание - Произвольный - Регламентное задание.
//  ТекСсылкаНаОбъект - Произвольный - Тек ссылка на объект.
//
&НаСервере
Процедура УстановитьПараметрыРегламентногоЗадания(РегламентноеЗадание, ТекСсылкаНаОбъект)
	РегламентноеЗадание.Параметры.Очистить();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("КассыККМ", РЗКассыККМ.Выгрузить());
	СтруктураПараметров.Вставить("УчетнаяЗапись", ТекСсылкаНаОбъект);
	
	МсвПараметры = Новый Массив;
	МсвПараметры.Добавить(СтруктураПараметров);
	
	РегламентноеЗадание.Параметры = МсвПараметры;
КонецПроцедуры

// Процедура считывает параметры регламентного задания.
//
// Параметры:
//  РегламентноеЗадание - Произвольный - Регламентное задание.
//
&НаСервере
Процедура ПрочитатьПараметрыРегламентногоЗадания(РегламентноеЗадание)
	
	РЗКассыККМ.Очистить();
	
	Если РегламентноеЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РегламентноеЗадание.Параметры.Количество() 
		И ТипЗнч(РегламентноеЗадание.Параметры[0]) = Тип("Структура") 
		И РегламентноеЗадание.Параметры[0].Свойство("КассыККМ") Тогда
		
		Для каждого ТекСтрока Из РегламентноеЗадание.Параметры[0].КассыККМ Цикл
			НовСтрокаКассы = РЗКассыККМ.Добавить();
			Если ТипЗнч(РегламентноеЗадание.Параметры[0].КассыККМ) = Тип("ТаблицаЗначений") Тогда
				НовСтрокаКассы.КассаККМ = ТекСтрока.КассаККМ;
			Иначе
				НовСтрокаКассы.КассаККМ = ТекСтрока;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

//  Процедура - Обновить зависимости дополнительных реквизитов.
//
&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

//  Процедура - Обновить элементы дополнительных реквизитов.
//
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

//  Процедура - Проверка подключения на сервере.
//
&НаСервере
Процедура ПроверкаПодключенияНаСервере()
	// Выполним подключение к БД
	Обработки.питЗагрузкаRKeeper7.ПодключитьсяКВнешнемуИсточникуДанных(Объект);
	
	Если НЕ Обработки.питЗагрузкаRKeeper7.ПодключениеАктивно() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подключение не установлено");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подключение установлено");
	КонецЕсли;
КонецПроцедуры

//  Процедура - Обновить параметры загрузки на сервере.
//
&НаСервере
Процедура ОбновитьПараметрыЗагрузкиНаСервере()
	Обработки.питЗагрузкаRKeeper7.ИнициализацияПараметровЗагрузки(Объект.ПараметрыЗагрузки);
КонецПроцедуры

//  Процедура - Сохранить параметры загрузки на сервере.
//
&НаСервере
Процедура СохранитьПараметрыЗагрузкиНаСервере()
	Для Каждого СтрокаТипа Из Объект.ПараметрыЗагрузки Цикл
		ТипОбъектаОбъект = СтрокаТипа.ТипОбъекта.ПолучитьОбъект();
		ТипОбъектаОбъект.Обновлять = СтрокаТипа.Обновлять;
		ТипОбъектаОбъект.Создавать = СтрокаТипа.Создавать;
		ТипОбъектаОбъект.СлужебныйКаталог = СтрокаТипа.СлужебныйКаталог;
		ТипОбъектаОбъект.ОбработкаОшибок = СтрокаТипа.ОбработкаОшибок;
		
		Попытка
			ТипОбъектаОбъект.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

//  Функция - Получить имя метаданных строки параметров.
//
// Параметры:
//  текСтрока - Строка - тек строка.
//
// Возвращаемое значение:
//  Строка - Результат обработки.
//
&НаСервере
Функция ПолучитьИмяМетаданныхСтрокиПараметров(текСтрока)
	текДанные = объект.ПараметрыЗагрузки.НайтиПоИдентификатору(текСтрока);
	
	ЕстьИерархия = Ложь;
	ТипЗначения = текДанные.ТипОбъекта.ТипЗначения;
	Для Каждого Тип Из ТипЗначения.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если НЕ МетаданныеТипа = Неопределено И МетаданныеТипа.Иерархический Тогда
			ЕстьИерархия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьИерархия Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МетаданныеТипа.Имя;
КонецФункции

#КонецОбласти




