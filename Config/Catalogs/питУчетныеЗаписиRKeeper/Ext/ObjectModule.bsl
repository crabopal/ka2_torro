
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	
	Если НЕ ЭтоНовый() И ПометкаУдаления И НЕ Ссылка.ПометкаУдаления Тогда
		// Произошла пометка удаления элемента
		
		// Если флаг фонового обмена не стоит, а РЗ существует, то его необходимо удалить.
		Если ЗначениеЗаполнено(РЗУникальныйИдентификатор) Тогда
			РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(РЗУникальныйИдентификатор));
		КонецЕсли;
		Если НЕ РегламентноеЗадание = Неопределено Тогда
			Попытка
				РегламентноеЗадание.Удалить();
				РЗУникальныйИдентификатор = "";
				РЗИспользоватьИндивидуальныеНастройкиОбмена = Ложь;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось удалить регаментное задание по причине:
				|" + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	// При копировании, УИД регламентного задания не копируем, он будет свой.
	РЗУникальныйИдентификатор = Неопределено;
КонецПроцедуры

#КонецОбласти
