
#Область ОбработчикиСобытийФормы

#Область УправлениеСвойствами

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ЗаполнитьГруппыМодификатора();
	
	Если Параметры.Свойство("ГруппаМодификатора") Тогда
		НайденныеСтроки = ГруппыМодификатора.НайтиСтроки(Новый Структура("ГруппаМодификатора", ГруппаМодификатора));
		Если НайденныеСтроки.Количество() Тогда
			НайденныеСтроки[0].Пометка = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Объект.ДопНоменклатура, Элементы.ЕдиницаИзмеренияНоменклатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Для Каждого Строка Из ГруппыМодификатора Цикл
		Если Строка.ПометкаСсылка = Строка.Пометка Тогда
			Продолжить;
		КонецЕсли;
		ГруппаОбъект = Строка.ГруппаМодификатора.ПолучитьОбъект();
		СтрокиМодификатора = ГруппаОбъект.Модификаторы.НайтиСтроки(Новый Структура("Модификатор", ТекущийОбъект.Ссылка));
		ГруппаОбъектБылИзменен = Ложь;
		Если Строка.Пометка Тогда
			Если СтрокиМодификатора.Количество() = 0 Тогда
				НоваяСтрока = ГруппаОбъект.Модификаторы.Добавить();
				НоваяСтрока.Модификатор = ТекущийОбъект.Ссылка;
				ГруппаОбъектБылИзменен = Истина;
			КонецЕсли;
		Иначе
			Для Каждого СтрокаМодификатора Из СтрокиМодификатора Цикл
				ГруппаОбъект.Модификаторы.Удалить(СтрокаМодификатора);
				ГруппаОбъектБылИзменен = Истина;
			КонецЦикла;
		КонецЕсли;
		Если ГруппаОбъектБылИзменен Тогда
			Попытка
				ГруппаОбъект.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

#Область УправлениеСвойствами

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ДопНоменклатураПриИзменении(Элемент)
	
	// Проверим, можно ли использовать номенклатуру.
	СтруктураРеквизитов = Новый Структура("Наименование, ЕдиницаИзмерения");
	СтруктураРеквизитов = ОбщегоНазначенияУТВызовСервера.ЗначенияРеквизитовОбъекта(Объект.ДопНоменклатура,СтруктураРеквизитов);
	
	Объект.Наименование 				= СтруктураРеквизитов.Наименование;
	Объект.ЕдиницаИзмеренияНоменклатуры = СтруктураРеквизитов.ЕдиницаИзмерения;
	ТекКоэффициент = ПолучитьКоэффициентУпаковки(Объект.ДопНоменклатура,Объект.ЕдиницаИзмеренияНоменклатуры);
	Объект.КоличествоНоменклатуры = Объект.КоличествоУпаковокНоменклатуры * ТекКоэффициент;
	
	ДопНоменклатураПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаИзмеренияНоменклатурыПриИзменении(Элемент)
	ТекКоэффициент = ПолучитьКоэффициентУпаковки(Объект.ДопНоменклатура,Объект.ЕдиницаИзмеренияНоменклатуры);
	Объект.КоличествоНоменклатуры = Объект.КоличествоУпаковокНоменклатуры * ТекКоэффициент;
КонецПроцедуры

&НаКлиенте
Процедура КоличествоНоменклатурыПриИзменении(Элемент)
	ТекКоэффициент = ПолучитьКоэффициентУпаковки(Объект.ДопНоменклатура,Объект.ЕдиницаИзмеренияНоменклатуры);
	Объект.КоличествоНоменклатуры = Объект.КоличествоУпаковокНоменклатуры * ТекКоэффициент;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#Область ГруппыМодификаторов

&НаКлиенте
Процедура ОбновитьГруппы(Команда)
	ЗаполнитьГруппыМодификатора();
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьВсеГруппы(Команда)
	Для Каждого Строка Из ГруппыМодификатора Цикл
		Если Строка.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Строка.Пометка = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыделениеВсехГрупп(Команда)
	Для Каждого Строка Из ГруппыМодификатора Цикл
		Если Не Строка.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Строка.Пометка = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ГруппыМодификаторов

&НаСервере
Процедура ЗаполнитьГруппыМодификатора()
	ГруппыМодификатора.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ГруппыМодификаторов.Ссылка КАК ГруппаМодификатора,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ГруппыМодификаторовМодификаторы.Модификатор = &Модификатор
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Пометка
	|ПОМЕСТИТЬ ГруппыМодификаторов
	|ИЗ
	|	Справочник.питГруппыМодификаторов КАК ГруппыМодификаторов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питГруппыМодификаторов.Модификаторы КАК ГруппыМодификаторовМодификаторы
	|		ПО ГруппыМодификаторов.Ссылка = ГруппыМодификаторовМодификаторы.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыМодификаторов.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыМодификаторов.ГруппаМодификатора,
	|	ГруппыМодификаторов.Пометка,
	|	ГруппыМодификаторов.Пометка КАК ПометкаСсылка
	|ИЗ
	|	ГруппыМодификаторов КАК ГруппыМодификаторов";
	Запрос.УстановитьПараметр("Модификатор", Объект.Ссылка);
	ГруппыМодификатора.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

#КонецОбласти

#Область УправлениеСвойствами

&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ДопНоменклатураПриИзмененииНаСервере()
	
	Справочники.УпаковкиЕдиницыИзмерения.ОтобразитьИнформациюОЕдиницеХранения(Объект.ДопНоменклатура, Элементы.ЕдиницаИзмеренияНоменклатуры);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоэффициентУпаковки(Номенклатура, Упаковка)
	
	Возврат питОбщегоНазначения.ПолучитьКоэффициентУпаковки(Номенклатура, Упаковка);
	
КонецФункции

#КонецОбласти
