
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	питИзменениеОтраслевыхФормСервер.ПриСозданииНаСервереВНачале(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	Если ЗначениеЗаполнено(Параметры.НоменклатураДляОтбора) Тогда
		
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
		
		СписМодификаторы = ЗаполнитьМодификаторы(Параметры.НоменклатураДляОтбора);
		ЗаполнитьУнаследованныеМодификаторы(Параметры.НоменклатураДляОтбора, СписМодификаторы);
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ПравоеЗначение = СписМодификаторы;
		ЭлементОтбора.Использование = Истина;
		
		///ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		
		ЭлементОтбора1 = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора1.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора1.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭтоГруппа");
		ЭлементОтбора1.ПравоеЗначение = Ложь;
		ЭлементОтбора1.Использование = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОповеститьОВыборе(Значение);
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции
Процедура ЗаполнитьУнаследованныеМодификаторы(Номенклатура, СписМодификаторов) 
	
	// Получим все группы этой номенклатуры
	МассивГруппНоменклатуры = Новый Массив();
	ТекРодитель = Номенклатура.Родитель;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		МассивГруппНоменклатуры.Добавить(ТекРодитель);
		ТекРодитель = ТекРодитель.Родитель;
	КонецЦикла;
	
	Если МассивГруппНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Соберём таблицу модификаторов
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МодификаторыНоменклатуры.Модификатор КАК Модификатор,
	|	МодификаторыНоменклатуры.ГруппаМодификатора КАК ГруппаМодификаторов,
	|	МодификаторыНоменклатуры.Номенклатура КАК ОтКогоУнаследовали
	|ИЗ
	|	РегистрСведений.питМодификаторыНоменклатуры КАК МодификаторыНоменклатуры
	|ГДЕ
	|	МодификаторыНоменклатуры.Номенклатура В(&МассивГруппНоменклатуры)"
	);
	
	Запрос.УстановитьПараметр("МассивГруппНоменклатуры", МассивГруппНоменклатуры);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Для групп получим элементы
	// Объединим таблицу элементов модификаторов и таблицу элементов групп.
	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РезультатЗапроса.Модификатор КАК Модификатор,
	|	РезультатЗапроса.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|	РезультатЗапроса.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|ПОМЕСТИТЬ ТаблицаЭлементовМодификаторов
	|ИЗ
	|	&РезультатЗапроса КАК РезультатЗапроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМодификаторов.Модификатор КАК Модификатор,
	|	ТаблицаМодификаторов.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|	ТаблицаМодификаторов.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|ИЗ
	|	(ВЫБРАТЬ
	|		Модификаторы.Модификатор КАК Модификатор,
	|		ТаблицаЭлементовМодификаторов.ГруппаМодификаторов КАК ГруппаМодификаторов,
	|		ТаблицаЭлементовМодификаторов.ОтКогоУнаследовали КАК ОтКогоУнаследовали
	|	ИЗ
	|		ТаблицаЭлементовМодификаторов КАК ТаблицаЭлементовМодификаторов
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.питГруппыМодификаторов.Модификаторы КАК Модификаторы
	|			ПО ТаблицаЭлементовМодификаторов.ГруппаМодификаторов = Модификаторы.Ссылка
	|	ГДЕ
	|		ТаблицаЭлементовМодификаторов.Модификатор = ЗНАЧЕНИЕ(Справочник.питМодификаторы.ПустаяСсылка)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТаблицаЭлементовМодификаторов.Модификатор,
	|		ТаблицаЭлементовМодификаторов.ГруппаМодификаторов,
	|		ТаблицаЭлементовМодификаторов.ОтКогоУнаследовали
	|	ИЗ
	|		ТаблицаЭлементовМодификаторов КАК ТаблицаЭлементовМодификаторов
	|	ГДЕ
	|		ТаблицаЭлементовМодификаторов.Модификатор <> ЗНАЧЕНИЕ(Справочник.питМодификаторы.ПустаяСсылка)) КАК ТаблицаМодификаторов
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаМодификаторов.Модификатор,
	|	ТаблицаМодификаторов.ГруппаМодификаторов,
	|	ТаблицаМодификаторов.ОтКогоУнаследовали
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаМодификаторов,
	|	ОтКогоУнаследовали,
	|	Модификатор
	|";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("РезультатЗапроса", РезультатЗапроса);
	
	// Выводим унаследованные модификаторы
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если СписМодификаторов.НайтиПоЗначению(Выборка.Модификатор) = Неопределено Тогда
			СписМодификаторов.Добавить(Выборка.Модификатор);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьУнаследованныеМодификаторы()


&НаСервере
Процедура ЗаполнениеЭлементовГруппыМодификатора(Родитель , СписМодификаторы) 
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Модификаторы.Модификатор КАК Модификатор
	|ИЗ
	|	Справочник.питГруппыМодификаторов.Модификаторы КАК Модификаторы
	|ГДЕ
	|	Модификаторы.Ссылка = &Родитель");
	
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписМодификаторы.добавить(Выборка.Модификатор);
	КонецЦикла;
КонецПроцедуры // ЗаполнениеЭлементовГруппыМодификатора()

&НаСервере
Функция ЗаполнитьМодификаторы(Номенклатура)
	СписМодификаторы = Новый СписокЗначений;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МодификаторыНоменклатуры.Модификатор КАК Модификатор,
	|	МодификаторыНоменклатуры.ГруппаМодификатора
	|ИЗ
	|	РегистрСведений.питМодификаторыНоменклатуры КАК МодификаторыНоменклатуры
	|ГДЕ
	|	МодификаторыНоменклатуры.Номенклатура = &Номенклатура");
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	
	// Заполняем ТЧ модификаторы по Номенклатуре
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ГруппаМодификатора) И НЕ ЗначениеЗаполнено(Выборка.Модификатор) Тогда
			ЗаполнениеЭлементовГруппыМодификатора(Выборка.ГруппаМодификатора, СписМодификаторы);
		Иначе
			СписМодификаторы.Добавить(Выборка.Модификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат СписМодификаторы;
КонецФункции // ЗаполнитьМодификаторы()

#КонецОбласти
