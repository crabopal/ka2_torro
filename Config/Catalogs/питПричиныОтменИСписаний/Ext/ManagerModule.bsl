	ДанныеЭлемента = ПолучитьСтруктуруПредопределенногоЭлемента();
	
	ДанныеЭлемента.Наименование = НСтр("ru='Промывка и санитарно-гигиеническая обработка пивной магистрали'", "ru");
	ДанныеЭлемента.УникальныйИдентификатор = ПолучитьИДПредопределенногоЭлемента_СанитарнаяПромывкаСистемы();
	
	ДанныеЭлемента.СоСписанием = Истина;
	
	Возврат ДанныеЭлемента;
	
КонецФункции

