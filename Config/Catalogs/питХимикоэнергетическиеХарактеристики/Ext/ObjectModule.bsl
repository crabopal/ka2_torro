// Модуль справочника Химикоэнергетические характеристики

////////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ ОБЪЕКТА


////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ МЕТОДОВ ОБЪЕКТА

// Заполняет предопределенные элементы (если они не существуют - создает новые (не предопределенные!)).
//  при обновлении релиза
//
// Параметры:
//  ЗаполнятьВсе - Булево - Признак перезаполнения уже существующих элементов.
//
Процедура ЗаполнитьПредопределенныеЭлементы(ЗаполнятьВсе=Ложь) Экспорт
	
	ЗаполнитьКлассификаторЕдиницИзмеренияДляпита();
	
	// Заполним реквизит ЕдиницаИзмерения в справочнике питХимикоэнергетическиеХарактеристики.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	питХимикоэнергетическиеХарактеристики.Ссылка,
	|	питХимикоэнергетическиеХарактеристики.ЕдиницаИзмерения
	|ИЗ
	|	Справочник.питХимикоэнергетическиеХарактеристики КАК питХимикоэнергетическиеХарактеристики
	|ГДЕ
	|	питХимикоэнергетическиеХарактеристики.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|	И питХимикоэнергетическиеХарактеристики.Предопределенный";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если Выборка.Ссылка=Справочники.питХимикоэнергетическиеХарактеристики.Белки 
			Или Выборка.Ссылка=Справочники.питХимикоэнергетическиеХарактеристики.Углеводы
			Или Выборка.Ссылка=Справочники.питХимикоэнергетическиеХарактеристики.Жиры Тогда
			
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("163");  // граммы
			
		ИначеЕсли Выборка.Ссылка=Справочники.питХимикоэнергетическиеХарактеристики.Калорийность Тогда
			
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("232");  // ккал
			
		ИначеЕсли Выборка.Ссылка=Справочники.питХимикоэнергетическиеХарактеристики.Алкоголь Тогда
			
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("111");  // мл
			
		Иначе
			
			Объект.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("161");  // Миллиграммы
			
		КонецЕсли;
		
		Попытка
			Объект.Записать(); 
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	// Заполнение групп ХЭХ в справочнике питХимикоэнергетическиеХарактеристики.
	СоответствиеГруппХЭХ = Новый Соответствие;
	// элементы соответствия в виде (ИмяЭлементаХЭХ, ИмяГруппыХЭХ)
	СоответствиеГруппХЭХ.Вставить("Белки",        "Основная");
	СоответствиеГруппХЭХ.Вставить("ВитаминА",     "Витаминная");
	СоответствиеГруппХЭХ.Вставить("ВитаминВ1",    "ВитаминыГруппыB");
	СоответствиеГруппХЭХ.Вставить("ВитаминВ12",   "ВитаминыГруппыB");
	СоответствиеГруппХЭХ.Вставить("ВитаминВ2",    "ВитаминыГруппыB");
	СоответствиеГруппХЭХ.Вставить("ВитаминВ6",    "ВитаминыГруппыB");
	СоответствиеГруппХЭХ.Вставить("ВитаминС",     "Витаминная");
	СоответствиеГруппХЭХ.Вставить("Железо",       "Микроэлементы");
	СоответствиеГруппХЭХ.Вставить("Жиры",         "Основная");
	СоответствиеГруппХЭХ.Вставить("Калорийность", "Основная");
	СоответствиеГруппХЭХ.Вставить("Кальций",      "Микроэлементы");
	СоответствиеГруппХЭХ.Вставить("Углеводы",     "Основная");
	СоответствиеГруппХЭХ.Вставить("Алкоголь",     "Основная");
	
	Для Каждого ЭлементХЭХ Из СоответствиеГруппХЭХ Цикл
		Попытка
			Если Справочники.питХимикоэнергетическиеХарактеристики[ЭлементХЭХ.Ключ].ГруппаХЭХ.Пустая() Тогда
				Объект = Справочники.питХимикоэнергетическиеХарактеристики[ЭлементХЭХ.Ключ].ПолучитьОбъект();
				Объект.ГруппаХЭХ = Справочники.питГруппыХЭХ[ЭлементХЭХ.Значение];
				Объект.Записать();
			КонецЕсли;
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка установки группы ХЭХ для предопределенного элемента """
				+ЭлементХЭХ.Ключ+""" в справочнике Химикоэнергетические характеристики.";
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьПредопределенныеЭлементы()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет справочник-классификатор единицами, которые будут использоваться в пите.
//
Процедура ЗаполнитьКлассификаторЕдиницИзмеренияДляпита()
	
	// Для ХЭХ
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("163", "г",    "Грамм");
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("232", "ккал", "Килокалория");
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("111", "мл",   "Миллилитр");
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("161", "мг",   "Миллиграмм");
	
	// В общем для пита
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("166", "кг",   "Килограмм");
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("112", "л",    "Литр");
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("1868", "порц",  "Порция");
	ДобавитьЕдиницуВКлассификаторЕдиницИзмерения("796", "шт",   "Штука");
	
	
КонецПроцедуры

// Добавляет новую единицу, если ее нет, в справочник классификатора единиц.
//
// Параметры:
//  Код - Произвольный - Код.
//  Имя - Произвольный - Имя.
//  ИмяПолное - Произвольный - Имя полное.
//
Процедура ДобавитьЕдиницуВКлассификаторЕдиницИзмерения(Код, Имя, ИмяПолное)
	
	Если Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(Код).Пустая() Тогда
		НоваяЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
		НоваяЕдиницаИзмерения.Наименование       = Имя;
		НоваяЕдиницаИзмерения.НаименованиеПолное = ИмяПолное;
		НоваяЕдиницаИзмерения.Код                = Код;
		НоваяЕдиницаИзмерения.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СТАНДАРТНЫХ СОБЫТИЙ ОБЪЕКТА


#КонецЕсли


