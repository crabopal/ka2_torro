#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Процедура - обработчик события ПередЗаписью набора записей.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  Замещение - Произвольный - Замещение.
//
Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка
		ИЛИ НЕ ДополнительныеСвойства.Свойство("ДляПроведения")
		ИЛИ НЕ ДополнительныеСвойства.ДляПроведения.Свойство("СтруктураВременныеТаблицы") Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВременныеТаблицы = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы;
	
	// Установка исключительной блокировки текущего набора записей регистратора.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.питОстаткиМарокИС.НаборЗаписей");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Регистратор", Отбор.Регистратор.Значение);
	Блокировка.Заблокировать();
	
	Если НЕ СтруктураВременныеТаблицы.Свойство("ДвиженияОстаткиМарокИСИзменение")
			ИЛИ СтруктураВременныеТаблицы.Свойство("ДвиженияОстаткиМарокИСИзменение")
			И НЕ СтруктураВременныеТаблицы.ДвиженияОстаткиМарокИСИзменение Тогда

		// Если временная таблица "ДвиженияОстаткиМарокИСИзменение" не существует или не содержит записей
		// об изменении набора, значит набор записывается первый раз или для набора был выполнен контроль остатков.
		// Текущее состояние набора помещается во временную таблицу "ДвиженияОстаткиМарокИСПередЗаписью",
		// чтобы при записи получить изменение нового набора относительно текущего.
		Запрос = Новый Запрос("ВЫБРАТЬ 
			|	ОстаткиМарокИС.НомерСтроки КАК НомерСтроки,
			|	ОстаткиМарокИС.Организация КАК Организация,
			|	ОстаткиМарокИС.МестоПечати КАК МестоПечати,
			|	ОстаткиМарокИС.Номенклатура КАК Номенклатура,
			|	ОстаткиМарокИС.Штрихкод КАК Штрихкод,
			|	ВЫБОР
			|		КОГДА ОстаткиМарокИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|			ТОГДА ОстаткиМарокИС.Количество
			|		ИНАЧЕ -ОстаткиМарокИС.Количество
			|	КОНЕЦ КАК КоличествоПередЗаписью
			|ПОМЕСТИТЬ ДвиженияОстаткиМарокИСПередЗаписью
			|ИЗ
			|	РегистрНакопления.питОстаткиМарокИС КАК ОстаткиМарокИС
			|ГДЕ
			|	ОстаткиМарокИС.Регистратор = &Регистратор
			|	И &Замещение");

		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		Запрос.УстановитьПараметр("Замещение", Замещение);

		Запрос.МенеджерВременныхТаблиц = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		Запрос.Выполнить();

	Иначе

	// Если временная таблица "ДвиженияОстаткиМарокИСИзменение" существует и содержит записи
	// об изменении набора, значит набор записывается не первый раз и для набора не был выполнен контроль остатков.
//   Текущее состояние набора и текущее состояние изменений помещаются во временную таблицу
// "ДвиженияОстаткиМарокИСПередЗаписью",.
	// чтобы при записи получить изменение нового набора относительно первоначального.
		Запрос = Новый Запрос("ВЫБРАТЬ 
			|	ДвиженияОстаткиМарокИСИзменение.НомерСтроки КАК НомерСтроки,
			|	ДвиженияОстаткиМарокИСИзменение.Организация КАК Организация,
			|	ДвиженияОстаткиМарокИСИзменение.МестоПечати КАК МестоПечати,
			|	ДвиженияОстаткиМарокИСИзменение.Номенклатура КАК Номенклатура,
			|	ДвиженияОстаткиМарокИСИзменение.Штрихкод КАК Штрихкод,
			|	ДвиженияОстаткиМарокИСИзменение.КоличествоПередЗаписью КАК КоличествоПередЗаписью
			|ПОМЕСТИТЬ ДвиженияОстаткиМарокИСПередЗаписью
			|ИЗ
			|	ДвиженияОстаткиМарокИСИзменение КАК ДвиженияОстаткиМарокИСИзменение
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОстаткиМарокИС.НомерСтроки,
			|	ОстаткиМарокИС.Организация КАК Организация,
			|	ОстаткиМарокИС.МестоПечати КАК МестоПечати,
			|	ОстаткиМарокИС.Номенклатура КАК Номенклатура,
			|	ОстаткиМарокИС.Штрихкод КАК Штрихкод,
			|	ВЫБОР
			|		КОГДА ОстаткиМарокИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|			ТОГДА ОстаткиМарокИС.Количество
			|		ИНАЧЕ -ОстаткиМарокИС.Количество
			|	КОНЕЦ
			|ИЗ
			|	РегистрНакопления.питОстаткиМарокИС КАК ОстаткиМарокИС
			|ГДЕ
			|	ОстаткиМарокИС.Регистратор = &Регистратор
			|	И &Замещение");

		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		Запрос.УстановитьПараметр("Замещение", Замещение);

		Запрос.МенеджерВременныхТаблиц = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		Запрос.Выполнить();

	КонецЕсли;

	// Временная таблица "ДвиженияОстаткиМарокИСИзменение" уничтожается
	// Удаляется информация о ее существовании.
	Если СтруктураВременныеТаблицы.Свойство("ДвиженияОстаткиМарокИСИзменение") Тогда

		Запрос = Новый Запрос("УНИЧТОЖИТЬ ДвиженияОстаткиМарокИСИзменение");
		Запрос.МенеджерВременныхТаблиц = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
		Запрос.Выполнить();
		СтруктураВременныеТаблицы.Удалить("ДвиженияОстаткиМарокИСИзменение");

	КонецЕсли;
	
КонецПроцедуры // ПередЗаписью()

// Процедура - обработчик события ПриЗаписи набора записей.
//
// Параметры:
//  Отказ - Булево - Отказ.
//  Замещение - Произвольный - Замещение.
//
Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка
		ИЛИ НЕ ДополнительныеСвойства.Свойство("ДляПроведения")
		ИЛИ НЕ ДополнительныеСвойства.ДляПроведения.Свойство("СтруктураВременныеТаблицы") Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВременныеТаблицы = ДополнительныеСвойства.ДляПроведения.СтруктураВременныеТаблицы;
	
	// Рассчитывается изменение нового набора относительно текущего с учетом накопленных изменений
	// и помещается во временную таблицу "ДвиженияОстаткиМарокИСИзменение".
	
	Запрос = Новый Запрос( 
	"ВЫБРАТЬ
	|	МИНИМУМ(ДвиженияОстаткиМарокИСИзменение.НомерСтроки) КАК НомерСтроки,
	|	ДвиженияОстаткиМарокИСИзменение.Организация КАК Организация,
	|	ДвиженияОстаткиМарокИСИзменение.МестоПечати КАК МестоПечати,
	|	ДвиженияОстаткиМарокИСИзменение.Номенклатура КАК Номенклатура,
	|	ДвиженияОстаткиМарокИСИзменение.Штрихкод КАК Штрихкод,
	|	СУММА(ДвиженияОстаткиМарокИСИзменение.КоличествоПередЗаписью) КАК КоличествоПередЗаписью,
	|	СУММА(ДвиженияОстаткиМарокИСИзменение.КоличествоИзменение) КАК КоличествоИзменение,
	|	СУММА(ДвиженияОстаткиМарокИСИзменение.КоличествоПриЗаписи) КАК КоличествоПриЗаписи
	|ПОМЕСТИТЬ ДвиженияОстаткиМарокИСИзменение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДвиженияОстаткиМарокИСПередЗаписью.НомерСтроки КАК НомерСтроки,
	|		ДвиженияОстаткиМарокИСПередЗаписью.Организация КАК Организация,
	|		ДвиженияОстаткиМарокИСПередЗаписью.МестоПечати КАК МестоПечати,
	|		ДвиженияОстаткиМарокИСПередЗаписью.Номенклатура КАК Номенклатура,
	|		ДвиженияОстаткиМарокИСПередЗаписью.Штрихкод КАК Штрихкод,
	|		ДвиженияОстаткиМарокИСПередЗаписью.КоличествоПередЗаписью КАК КоличествоПередЗаписью,
	|		ДвиженияОстаткиМарокИСПередЗаписью.КоличествоПередЗаписью КАК КоличествоИзменение,
	|		0 КАК КоличествоПриЗаписи
	|	ИЗ
	|		ДвиженияОстаткиМарокИСПередЗаписью КАК ДвиженияОстаткиМарокИСПередЗаписью
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДвиженияОстаткиМарокИСПриЗаписи.НомерСтроки,
	|		ДвиженияОстаткиМарокИСПриЗаписи.Организация,
	|		ДвиженияОстаткиМарокИСПриЗаписи.МестоПечати,
	|		ДвиженияОстаткиМарокИСПриЗаписи.Номенклатура,
	|		ДвиженияОстаткиМарокИСПриЗаписи.Штрихкод,
	|		0,
	|		ВЫБОР
	|			КОГДА ДвиженияОстаткиМарокИСПриЗаписи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА -ДвиженияОстаткиМарокИСПриЗаписи.Количество
	|			ИНАЧЕ ДвиженияОстаткиМарокИСПриЗаписи.Количество
	|		КОНЕЦ,
	|		ДвиженияОстаткиМарокИСПриЗаписи.Количество
	|	ИЗ
	|		РегистрНакопления.питОстаткиМарокИС КАК ДвиженияОстаткиМарокИСПриЗаписи
	|	ГДЕ
	|		ДвиженияОстаткиМарокИСПриЗаписи.Регистратор = &Регистратор) КАК ДвиженияОстаткиМарокИСИзменение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.питПараметрыСкладовОбщепита КАК СтруктурныеЕдиницы
	|		ПО ДвиженияОстаткиМарокИСИзменение.МестоПечати = СтруктурныеЕдиницы.Склад
	|ГДЕ
	|	ЕСТЬNULL(СтруктурныеЕдиницы.КонтролироватьОстаткиМарокИСПриПроведении, ЛОЖЬ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияОстаткиМарокИСИзменение.Организация,
	|	ДвиженияОстаткиМарокИСИзменение.МестоПечати,
	|	ДвиженияОстаткиМарокИСИзменение.Номенклатура,
	|	ДвиженияОстаткиМарокИСИзменение.Штрихкод
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДвиженияОстаткиМарокИСИзменение.КоличествоИзменение) <> 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	МестоПечати,
	|	Номенклатура,
	|	Штрихкод");
	
	Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
	Запрос.МенеджерВременныхТаблиц = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИзРезультатаЗапроса = РезультатЗапроса.Выбрать();
	ВыборкаИзРезультатаЗапроса.Следующий();
	
	// Новые изменения были помещены во временную таблицу "ДвиженияОстаткиМарокИСИзменение".
	// Добавляется информация о ее существовании и наличии в ней записей об изменении.
	СтруктураВременныеТаблицы.Вставить("ДвиженияОстаткиМарокИСИзменение", ВыборкаИзРезультатаЗапроса.Количество > 0);
	
	// Временная таблица "ДвиженияОстаткиМарокИСПередЗаписью" уничтожается
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ДвиженияОстаткиМарокИСПередЗаписью");
	Запрос.МенеджерВременныхТаблиц = СтруктураВременныеТаблицы.МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
КонецПроцедуры // ПриЗаписи()

#КонецОбласти

#КонецЕсли




