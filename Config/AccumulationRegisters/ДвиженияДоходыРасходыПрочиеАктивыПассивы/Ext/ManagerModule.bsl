#Область ОбновлениеИнформационнойБазы

// см. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.Процедура = "РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.Версия = "2.5.26.61";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("bc5ba003-4dfe-45a1-a408-74ea54ea4f13");
	Обработчик.Многопоточный = Истина;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	
	СписокОписаний = Новый Массив;
	СписокОписаний.Добавить(НСтр("ru = 'Обновление регистра ""Движения Доходы/Расходы - Прочие активы/пассивы"":'"));
	СписокОписаний.Добавить(НСтр("ru = '- Заменяет некорректные ссылки на статьи ""Основные средства"" и ""Нематериальные активы""'"));
	
	Обработчик.Комментарий = СтрСоединить(СписокОписаний, Символы.ПС);
	Обработчик.Порядок = Перечисления.ПорядокОбработчиковОбновления.Обычный;
	
	Читаемые = Новый Массив;
	Читаемые.Добавить(Метаданные.РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы.ПолноеИмя());
	Обработчик.ЧитаемыеОбъекты = СтрСоединить(Читаемые, ",");
	
	Изменяемые = Новый Массив;
	Изменяемые.Добавить(Метаданные.РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы.ПолноеИмя());
	Обработчик.ИзменяемыеОбъекты = СтрСоединить(Изменяемые, ",");
	
	Блокируемые = Новый Массив;
	Блокируемые.Добавить(Метаданные.РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы.ПолноеИмя());
	Обработчик.БлокируемыеОбъекты = СтрСоединить(Блокируемые, ",");
	
КонецПроцедуры

// Обработчик регистрации данных для обновления
// 
// Параметры:
// 	Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы;
	ПолноеИмяРегистра = МетаданныеРегистра.ПолноеИмя();
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаРегистров = ПолноеИмяРегистра;
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей.Добавить("Период УБЫВ");
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных.Добавить("Период УБЫВ");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиРегистраторыРегистра();
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Запрос.Параметры.Вставить("МоментВремени", Новый МоментВремени('00010101'));
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор КАК Регистратор,
	|	Движения.МоментВремени КАК МоментВремени
	|ПОМЕСТИТЬ втРегистраторыКОбработке
	|ИЗ
	|	РегистрНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И (
	|		Движения.Статья = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.НематериальныеАктивы)
	|	ИЛИ
	|		Движения.Статья = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ОсновныеСредства)
	|	ИЛИ
	|		Движения.КорСтатья = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.НематериальныеАктивы)
	|	ИЛИ
	|		Движения.КорСтатья = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ОсновныеСредства)
	|	)
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РегистраторыКОбработке.Регистратор КАК Регистратор,
	|	РегистраторыКОбработке.МоментВремени КАК МоментВремени
	|ПОМЕСТИТЬ втРазличныеРегистраторыКОбработке
	|ИЗ
	|	втРегистраторыКОбработке КАК РегистраторыКОбработке
	|ГДЕ
	|	НЕ ИСТИНА В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			втРегистраторыКОбработке КАК РегистраторыДругиеПериоды
	|		ГДЕ
	|			РегистраторыДругиеПериоды.Регистратор = РегистраторыКОбработке.Регистратор
	|			И РегистраторыДругиеПериоды.МоментВремени < РегистраторыКОбработке.МоментВремени
	|		)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ втРегистраторыКОбработке
	|";
	
	Результат = Запрос.Выполнить();
	
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1000
	|	РегистраторыКОбработке.Регистратор КАК Регистратор,
	|	РегистраторыКОбработке.МоментВремени КАК МоментВремени
	|ИЗ
	|	втРазличныеРегистраторыКОбработке КАК РегистраторыКОбработке
	|ГДЕ
	|	РегистраторыКОбработке.МоментВремени > &МоментВремени
	|УПОРЯДОЧИТЬ ПО
	|	РегистраторыКОбработке.МоментВремени
	|";
	
	Результат = Запрос.Выполнить();
	
	Пока НЕ Результат.Пустой() Цикл
		ТаблицаРезультата = Результат.Выгрузить();
		Регистраторы = ТаблицаРезультата.ВыгрузитьКолонку("Регистратор");
		
		ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
		
		КоличествоСтрок = ТаблицаРезультата.Количество();
		Запрос.УстановитьПараметр("МоментВремени", ТаблицаРезультата[КоличествоСтрок - 1]["МоментВремени"]);
		Результат = Запрос.Выполнить();
	КонецЦикла;
	
КонецПроцедуры

// Обработчик обновления
// 
// Параметры:
//  Параметры - Структура - параметры обработчика:
//   * ВерсияПодсистемыНаНачалоОбновления - Строка - версия подсистемы.
//   * ИмяОбработчика - Строка - имя обработчика.
//   * ОбновляемыеДанные - Структура.
//   * ОбработкаЗавершена - Булево, Неопределено - признак завершения обработки.
//   * Очередь - Число - очередь.
//   * ПрогрессВыполнения - Структура:
//     ** ВсегоОбъектов - Число - всего обработано объектов.
//     ** ОбработаноОбъектов - Число - обработано объектов.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы;
	ПолноеИмяРегистра = МетаданныеРегистра.ПолноеИмя();
	
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	Если ОбновляемыеДанные.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяРегистра);
		Возврат;
	КонецЕсли;
	
	МенеджерСтатьиАктивовПассивов = ПланыВидовХарактеристик.СтатьиАктивовПассивов;
	
	Для Каждого СтрокаДанных Из ОбновляемыеДанные Цикл
		Регистратор = СтрокаДанных.Регистратор;
		
		ПричинаИсключения = "";
		Рекомендация = "";
	
		СписокОписаний = Новый Массив;
		СписокОписаний.Добавить(НСтр("ru = 'Не удалось обработать набор записей регистра накопления ""Движения Доходы/Расходы - Прочие активы/пассивы"":'"));
		
		НачатьТранзакцию();
		
		Попытка
			
			ПричинаИсключения = "Блокировка";
			
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы.НаборЗаписей");
			ЭлементБлокировки.УстановитьЗначение("Регистратор", Регистратор);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
				
			ПричинаИсключения = "ПлохиеДанные";
			Рекомендация = НСтр("ru = 'Перепроведите документ вручную.'");
			
			НаборЗаписей = РегистрыНакопления.ДвиженияДоходыРасходыПрочиеАктивыПассивы.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Запись.Статья = МенеджерСтатьиАктивовПассивов.НематериальныеАктивы Тогда
					Запись.Статья = МенеджерСтатьиАктивовПассивов.УпрБалансНематериальныеАктивы;
					СписокОписаний.Добавить(НСтр("ru = '- Не удалось заменить некорректную ссылку на статью ""Нематериальные активы""'"));
				ИначеЕсли Запись.Статья = МенеджерСтатьиАктивовПассивов.ОсновныеСредства Тогда
					Запись.Статья = МенеджерСтатьиАктивовПассивов.УпрБалансОсновныеСредства;
					СписокОписаний.Добавить(НСтр("ru = '- Не удалось заменить некорректную ссылку на статью ""Основные средства""'"));
				КонецЕсли;
				
				Если Запись.КорСтатья = МенеджерСтатьиАктивовПассивов.НематериальныеАктивы Тогда
					Запись.КорСтатья = МенеджерСтатьиАктивовПассивов.УпрБалансНематериальныеАктивы;
					СписокОписаний.Добавить(НСтр("ru = '- Не удалось заменить некорректную ссылку на статью ""Нематериальные активы""'"));
				ИначеЕсли Запись.КорСтатья = МенеджерСтатьиАктивовПассивов.ОсновныеСредства Тогда
					Запись.КорСтатья = МенеджерСтатьиАктивовПассивов.УпрБалансОсновныеСредства;
					СписокОписаний.Добавить(НСтр("ru = '- Не удалось заменить некорректную ссылку на статью ""Основные средства""'"));
				КонецЕсли;
			КонецЦикла;
			
			ПричинаИсключения = "Запись";
			
			Если НаборЗаписей.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(НаборЗаписей);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазыУТ.СообщитьОНеудачнойОбработке(ИнформацияОбОшибке(), Регистратор);
			
			Если ПричинаИсключения = "ПлохиеДанные" Тогда
				
				ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(Регистратор, Рекомендация, Параметры);
				
			ИначеЕсли ПричинаИсключения = "Запись" Тогда
				
				ВызватьИсключение СтрСоединить(СписокОписаний, Символы.ПС);
				
			КонецЕсли;
			
		КонецПопытки;
	
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяРегистра);

КонецПроцедуры

#КонецОбласти

//-- НЕ УТ

#КонецОбласти

#КонецЕсли